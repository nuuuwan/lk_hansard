a\u0dca \u0d85\u0db8\u0dcf\u0dad\u0255\u0dcf\u0d82\u0dc1 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0daf\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0db8\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dd9\u0d9a\u0ddc\u0da0\u0dca\u0da0\u0dbb \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0dc0\u0dd2\u0dba\u0daf\u0db8\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dd9\u0db6\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf.\n\n\u0d9c\u0dbb\u0dd4 \u0dc3\u0dd4\u0dc3\u0db1\u0dca\u0dad \u0db4\u0dd4\u0d82\u0da0\u0dd2\u0db1\u0dd2\u0dbd\u0dd9\u0db8\u0dca \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u1f97\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0bc1\u0b9a\u0ba8\u0bcd\u0ba4 \u1f97\u0b9e\u0bcd\u0b9a\u0bbf\u0ba8\u0bbf\u0bb2\u0bc7\u0bae) (The Hon. Susantha Punchinilame ) \u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0dc0\u0dca\u0daf\u0dd3 \u0db4\u0dc1\u0dca\u0db1\u0dba\u0d9a\u0dca \u0dc0\u0dc1\u0dd9\u0dba\u0db1\u0dca \u0d87\u0dc4\u0dd4\u0dd9\u0dc0\u0ddc\u0dad\u0dca \u0d92\u0d9a\u0da7 \u0d85\u0db4\u0da7 \u0d8b\u0dad\u0dca\u0dad\u0dbb \u0dd9\u0daf\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca.\n\n\u0d9c\u0dbb\u0dd4 \u0da2\u0dba\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dd9\u0da2\u0dca\u0dd9\u0dc3\u0dda\u0d9a\u0dbb \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u1f97\u0bae\u0bbf\u0b95\u0bc1 \u0b9c\u0baf\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0bc7\u0b9c\u0bc7\u0b9a\u0b95\u0bb0) (The Hon. Jayantha Wijesekara) \u0dd9\u0db8\u0dca \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dc1\u0dca\u0db1\u0dba \u0d92\u0d9a\u0da7 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd2. \u0d9c\u0dbb\u0dd4 \u0dc3\u0dd4\u0dc3\u0db1\u0dca\u0dad \u0db4\u0dd4\u0d82\u0da0\u0dd2\u0db1\u0dd2\u0dbd\u0dd9\u0db8\u0dca \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u1f97\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0bc1\u0b9a\u0ba8\u0bcd\u0ba4 \u1f97\u0b9e\u0bcd\u0b9a\u0bbf\u0ba8\u0bbf\u0bb2\u0bc7\u0bae) (The Hon. Susantha Punchinilame ) \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d85\u0db4\u0da7 \u0db8\u0dcf\u0dc3\u0dba\u0d9a\u0dca \u0d9a\u0dbd\u0dca \u0dd9\u0daf\u0db1\u0dca\u0db1. \u0d9c\u0dbb\u0dd4 \u0da2\u0dba\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dd9\u0da2\u0dca\u0dd9\u0dc3\u0dda\u0d9a\u0dbb \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u1f97\u0bae\u0bbf\u0b95\u0bc1 \u0b9c\u0baf\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0bc7\u0b9c\u0bc7\u0b9a\u0b95\u0bb0) (The Hon. Jayantha Wijesekara) \u0dd9\u0db8\u0dca \u0dc0\u0255\u0dd8\u0db4\u0dd8\u0dad\u0dd2\u0dd9\u0dba\u0dca \u0dd9\u0db8\u0dca\u0d9a \u0d9c\u0dd0\u0db1 \u0dad\u0dd2\u0dd9\u0db6\u0db1\u0dc0\u0dcf\u0daf, \u0db1\u0dd0\u0daf\u0dca\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc0\u0dd2\u0dad\u0dbb\u0dba\u0dd2 \u0d85\u0dc4\u0db1\u0dca\u0dd9\u0db1\u0dca. \u0dd9\u0db8\u0dca \u0dc0\u0255\u0dd8\u0db4\u0dd8\u0dad\u0dd2\u0dba\u0da7 \u0dd9\u0dc0\u0db1\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0dd9\u0db6\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dca\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0d92 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba \u0dc4\u0daf\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0db8\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dd9\u0db6\u0db1\u0dc0\u0dcf\u0daf, \u0db1\u0dd0\u0daf\u0dca\u0daf?"
