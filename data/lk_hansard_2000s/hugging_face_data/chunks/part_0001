a\n\n\u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0dd9\u0db4\u0dbb\u0db8\u0dd4\u0dab \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0db1\u0dad\u0dcf \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0dc3\u0db1\u0dca\u0db0\u0dcf\u0db1\u0dba\n\n\u0da0\u0db1\u0dca\u0daf\u0db1 \u0dba\u0dcf\u0db4\u0dcf \u0db8\u0dc4\u0dad\u0dcf \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0db1\u0dad\u0dcf \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0dc3\u0db1\u0dca\u0db0\u0dcf\u0db1\u0dba\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n[\u0d9c\u0dbb\u0dd4 \u0d85\u0db1\u0dd4\u0dbb \u0db4\u0dd2\u0dba\u0daf\u0dbb\u0dca\u0dc1\u0db1 \u0dba\u0dcf\u0db4\u0dcf]"
