    "chunk_text": "\"B.5/2-22, \u0b86\u0ba9\u0ba8\u0bcd\u0ba4\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0b9a\u0bc1\u0bb5\u0bbe\u0bae\u0bbf, \u0ba8\u0bb2\u0ba9\u0bcd\u1f97\u0bbe\u0bbf \u0ba8\u0bbf\u0bc8\u0bb2\u0baf\u0bae\u0bcd, \u0bc6\u0b9a\u0b9f\u0bcd\u1f8a\u0b95\u0bc1\u0bb3\u0bae\u0bcd.\n\n\u0bae\u0b95\u0bc8\u0ba9\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bb5\u0bbf\u0bb2\u0bcd\u0bc8\u0bb2. \"\u0b8e\u0ba9\u1f90 \u0bae\u0b95\u1f94\u0bae\u0bcd \u0ba8\u0bbe\u1f94\u0bae\u0bcd 17.05.2009 \u0b85\u0ba9\u0bcd\u1fa0 \u0bb5\u0b9f\u0bcd\u1f8c\u0bb5\u0bbe\u0b95\u1fa2\u0bb2\u0bcd \u0b87\u1f9e\u0ba8\u0bcd\u0ba4\u0bc6\u0baa\u0bbe\u1fa8\u1f90 \u0b95\u0bbe\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb5\u0bbf\u0b9f\u0bcd\u0bc7\u0b9f\u0bbe\u0bae\u0bcd. \u0baa\u0bbf\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd 18.05.2009 \u0b85\u0ba9\u0bcd\u1fa0 \u0b87\u0bb0\u0bbe\u1f8e\u0bb5 \u0bc8\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0b9a\u0bbe\u0bc8\u0bb2\u0baf\u0bbf\u1fa2\u1f9e\u0ba8\u0bcd\u1f90 \u0b95\u0bbe\u0bc8\u0bb2 7.00\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 1217 1218\n\n\u1f97\u0bbe\u0bbf\u0baf\u0bbe\u1f90. \u0b87\u0bb0\u0bbe\u1f8e\u0bb5\u0b95\u0bcd \u0b95\u0bc2\u0ba3\u0bcd\u1f8c\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0b9a\u0bbf\u0bb1\u0bc6\u0b95\u0bbe\u1f8a\u0ba8\u0bcd\u0ba4 \u0baa\u0bb1\u0bc8\u0bb5\u0baf\u0bbe\u0b95 \u0b87\u1f9e\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b8e\u0bae\u1f90 \u0bc7\u0bb5\u0ba4\u0bc8\u0ba9, \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0ba9\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u1f9e\u0bc8\u0ba3 \u0b87\u1f9e\u0ba8\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd \u1f97\u0bbe\u0bbf\u1f9c\u0bae\u0bcd; \u0b95\u0b9f\u1fab\u1fa6\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd\u0b95\u0bc2\u0b9f \u0b8e\u0bae\u0bcd \u0b95\u0ba4\u0bb1\u0bb2\u0bcd \u0bc7\u0b95\u0b9f\u0bcd\u0b95\u0bb5\u0bbf\u0bb2\u0bcd\u0bc8\u0bb2\u0bc7\u0baf!\" \u0b8e\u0ba9\u0bcd\u1fa0 \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u1f8c, \u0b95\u0bc8\u0b9f\u0b9a\u0bbf\u0baf\u0bbe\u0b95 \u0b87\u0bb5\u0bcd\u0bb5\u0bbe\u1fa0 \u0b95\u0bc2\u1fa0\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bbe\u0bb0\u0bcd: \"\u0b8e\u0bae\u0bcd\u0bc8\u0bae \u0bb5\u0bbf\u1f8c\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0b95\u0bcd\u0bc7\u0b95\u0bbe\u0bbe\u0bbf \u0b90\u0ba8\u0bcd\u0ba4\u0bbe\u0bb5\u1f90 \u0ba4\u0b9f\u0bc8\u0bb5\u0baf\u0bbe\u0b95\u0b95\u0bcd \u0b95\u1f8a\u0ba4\u0bae\u0bcd \u0b8e\u1fa8\u1f90\u0b95\u0bbf\u0ba9\u0bcd\u0bc7\u0bb1\u0ba9\u0bcd. \u0b87\u1f90\u0bc7\u0bb5 \u0b8e\u0ba9\u1f90 \u0b95\u0bc8\u0b9f\u0b9a\u0bbf\u0b95\u0bcd \u0b95\u1f8a\u0ba4\u0bae\u0bcd! \u0b87\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0bbf\u0bb1\u0b95\u0bc1\u0bae\u0bcd \u0b8e\u0bae\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bbf\u1f8c\u0ba4\u0bc8\u0bb2 \u0b87\u0bb2\u0bcd\u0bc8\u0bb2\u0bc6\u0baf\u0ba9\u0bbf\u0bb2\u0bcd, \u0b89\u0ba3\u0bcd\u0ba3\u0bbe\u0bb5\u0bbf\u0bb0\u0ba4\u0bae\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd \u0b87\u1fa0\u0ba4\u0bbf \u1f99\u1f8a\u1fab. \u0b87\u0ba4\u0bc8\u0ba9\u1f9c\u0bae\u0bcd \u0b95\u0bc1\u0baa\u0bcd\u0bc8\u0baa\u0baf\u0bbf\u0bb2\u0bcd \u1faa\u0b9a\u0bbf \u0bb5\u0bbf\u0b9f\u0bbe\u0ba4\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0bae\u0ba9\u0b95\u0bcd\u0b95\u0bc1\u1f99\u0bb1\u1fa4\u0b9f\u0ba9\u0bcd, \u0baa\u0bc0. \u0b9a\u0bbf\u0bb5\u0bbe\u0b9c\u0bbf\u0ba9\u0bbf - '\u0baa\u0bbf' \u1f99\u0b95\u0bbe\u0bae\u0bcd\" \u0baf\u0bbe\u0bb4\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0ba3 \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95 \u0b85\u0ba4\u0bbf\u0baa\u0bb0\u0bcd, \u0bae\u0ba9\u0bbf\u0ba4 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0b95\u0bb3\u0bcd \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bb0\u0bcd, \u0bae\u0bc0\u0bb3\u0bcd \u0b95\u0bc1\u1f8a\u0baf\u0bae\u0bb0\u0bcd\u0ba4\u0bcd\u1f90\u0bc8\u0b95, \u0b85\u0ba9\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4 \u0ba8\u0bbf\u0bb5\u0bbe\u0bb0\u0ba3 \u0bc7\u0b9a\u0bc8\u0bb5\u0b95\u0bb3\u0bcd \u0b85\u0bc8\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd, \u0bb5\u0b9f \u0bae\u0bbe\u0b95\u0bbe\u0ba3 \u0b86\u1fa6\u0ba8\u0bb0\u0bcd, \u0ba8\u0bb2\u0ba9\u0bcd\u0bc7\u0baa\u1f8e\u0bae\u0bcd \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0ba8\u0bbf\u0bc8\u0bb2\u0baf\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bbf\u0b9f\u0bcd\u0b9f \u0baa\u0bb2\u1f9e\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0b95\u0bc8\u0bb3 \u0b85\u1f94\u0baa\u0bcd\u0baa\u0bbf \u0bc8\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u1f9e\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bbe\u0bb0\u0bcd. \u0b87\u0bb5\u0bcd\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0ba8\u0bbf\u0bc8\u0bb2\u0baf\u0bbf\u0bb2\u0bcd \u0b87\u0ba9\u0bcd\u0ba9\u1f99\u0bae\u0bcd \u1f93\u0bb1\u0bcd\u1fa0\u0b95\u0bcd\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0baa\u0bbf\u0bb3\u0bcd\u0bc8\u0bb3\u0b95\u1fa6\u0bae\u0bcd, \u0b9a\u0bbf\u1fa0\u0bb5\u0bb0\u0bcd\u0b95\u1fa6\u0bae\u0bcd \u0b87\u1f9e\u0ba8\u0bcd\u1f90 \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u1f8a\u1f9e\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bc8\u0bb3 \u0bc6\u0bb5\u0bb3\u0bbf\u0baf\u0bbf\u0b9f \u0ba8\u0bbe\u0ba9\u0bcd \u0bb5\u0bbf\u1f9e\u0bae\u0bcd\u0baa\u0bb5\u0bbf\u0bb2\u0bcd\u0bc8\u0bb2. \u0b86\u0ba9\u0bbe\u0bb2\u0bcd, \u0b8e\u0b99\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u1f94\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0b85\u0bc8\u0ba9\u0ba4\u0bcd\u1f90\u0b95\u0bcd \u0b95\u1f8a\u0ba4\u0b99\u0bcd\u0b95\u0bc8\u0bb3\u1f9c\u0bae\u0bcd \u0bc7\u0ba4\u0bc8\u0bb5\u0bc7\u0baf\u0bb1\u0bcd\u0baa\u1f8c\u0bae\u0bbf\u0b9f\u0ba4\u0bcd\u1f90, \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bbf\u1f9e\u0bae\u0bcd\u0baa\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd, \u0b87\u0ba8\u0bcd\u0ba4\u0b9a\u0bcd \u0b9a\u0bc8\u0baa\u0baf\u0bbf\u0bb2\u0bcd \u1f99\u0ba9\u0bcd\u0bc8\u0bb5\u0b95\u0bcd\u0b95 \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0bc6\u0b95\u0bb3\u0bb0\u0bb5 \u0baa\u0bbf\u0bb0\u0ba4\u0bae\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0b9f\u0bae\u0bcd \u0b9a\u0bae\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95 \u0ba8\u0bbe\u0ba9\u0bcd \u0ba4\u0baf\u0bbe\u0bb0\u0bbe\u0b95 \u0b87\u1f9e\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bc7\u0bb1\u0ba9\u0bcd."
  },
