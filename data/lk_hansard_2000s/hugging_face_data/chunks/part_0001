    "chunk_text": "\u0dc3\u0dc4\u0d9a\u0dcf\u0dbb \u0dd9\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca (\u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a) \u0dad\u0db1\u0dad\u0dd4\u0dbb \u0dc3\u0db3\u0dc4\u0dcf\u0dc0\u0dd4 \u0db6\u0db3\u0dc0\u0dcf\u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0da7\u0dd2\u0dba \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0d89\u0dc4\u0dad \u0dad\u0db1\u0dad\u0dd4\u0dbb\u0da7 \u0d85\u0daf\u0dcf\u0dbd\u0dc0 \u0dd9\u0dc1\u0dda\u0dc2\u0dca\u0da8\u0dcf\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dd9\u0dba\u0dc4\u0dd2 \u0dc0\u0dd2\u0db7\u0dcf\u0d9c \u0dc0\u0db1 \u0d85\u0d82\u0d9a 303/2006 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dbd\u0dd2 \u0dc0\u0dbd\u0da7 \u0d85\u0daf\u0dcf\u0dbd \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0dba 2007.05.07 \u0daf\u0dd2\u0db1\u0da7 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dd9\u0dc0\u0db1 \u0db6\u0dc0\u0dad\u0dca \u0d85\u0daf\u0dcf\u0dc5 \u0db6\u0db3\u0dc0\u0dcf\u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0da7\u0dd2\u0dba \u0dd9\u0db1\u0ddc\u0db4\u0db8\u0dcf\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dd9\u0dbd\u0dc3\u0dad\u0dca \u0d9c\u0dbb\u0dd4 \u0db1\u0dd3\u0dad\u0dd2\u0db4\u0dad\u0dd2 2007.02.07 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0dbd\u0dd2\u0db4\u0dd2\u0dd9\u0dba\u0db1\u0dca \u0daf\u0db1\u0dca\u0dc0\u0dcf \u0d87\u0dad.\n\n\u0db4\u0dc0\u0dcf\u0dc4\u0db1 \u0dc4\u0dcf \u0d9c\u0db8\u0db1\u0dcf\u0d9c\u0db8\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0255\u0dcf\u0d82\u0dc1\u0dba. \u0dd9\u0dc1\u0dda\u0dc2\u0dca\u0da8\u0dcf\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0db1\u0da9\u0dd4 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca \u0d85\u0d82\u0d9a : 303/06 \u0d8b\u0d9a\u0dca\u0dad \u0d9a\u0dbb\u0dd4\u0dab\u0da7 \u0d85\u0daf\u0dcf\u0dbd\u0dc0 \u0d94\u0db6\u0da7\u0daf \u0db4\u0dd2\u0da7\u0db4\u0dad\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad\u0dc0 \u0d9c\u0dbb\u0dd4 \u0db1\u0dd3\u0dad\u0dd2\u0db4\u0dad\u0dd2 \u0dc0\u0dd2\u0