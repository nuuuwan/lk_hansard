4\u0dcf\u0dbb \u0db8\u0dd3. 105 \u0dbb\u0dd4. 427000 - \u0d91\u0db8 -\n\n09. \u0db4\u0dd4\u0dc0\u0d9a\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4\u0db0\u0dcf\u0db1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0db8\u0dd3. 71 \u0dbb\u0dd4. 99000 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf \u0dc0\u0dd2\u0db8\u0db0\u0255\u0d9c\u0dad \u0db4\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0db1\n\n10. \u0dbb\u0dcf\u0dc0\u0dab\u0dcf\u0d9c\u0db8 \u0dc3\u0dd2\u0da7 \u0d9c\u0dbd\u0dca\u0dd9\u0daf\u0dc0\u0dbd \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0db8\u0dd3. 71 \u0dbb\u0dd4. 499000 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc3\u0dc0\u0dd2\u0dba \u0d9c\u0db8 \u0db1\u0dd0\u0d9f\u0dd4\u0db8\n\n11. \u0d89\u0dc5\u0dd4\u0d9a\u0dca\u0d9a\u0dd4\u0db9\u0dd4\u0dbb \u0d9c\u0db8\u0dca\u0db8\u0dd0\u0daf \u0db4\u0dcf\u0dbb \u0db8\u0dd3. 117 \u0dbb\u0dd4. 467000 - \u0d91\u0db8 -\n\n12. \u0d9a\u0dbb\u0db3\u0db8\u0dd4\u0dbd\u0dca\u0dbd \u0dc3\u0dd4\u0dc3\u0dcf\u0db1\u0db7\u0dd4\u0db8\u0dd2 \u0db4\u0dcf\u0dbb \u0db8\u0dd3. 108 \u0dbb\u0dd4. 500000 - \u0d91\u0db8 -\n\n13. \u0db8\u0da9\u0dd4\u0db8\u0dcf\u0db1 \u0db4\u0dcf\u0dbb \u0db8\u0dd3. 105 \u0dbb\u0dd4. 497000 - \u0d91\u0db8 -\n\n\u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2, \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0, \u0dbd\u0d9c\u0dca\u0d9c\u0dbd \u0db4\u0dbd\u0dca\u0dd9\u0dbd\u0dca\u0d9c\u0db8.\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 1651 1652\n\n\u0dc0\u0dd2\u0dbd\u0dca\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf \u0db6\u0dbd \u0db4\u0dd9\u0daf\u0dca\u0dc1\u0dba : \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0bb5\u0bbf\u0bb2\u0bcd\u0b95\u1f99\u0b95 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u0b86\u1fa6\u0bc8\u0b95\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a\u0bae\u0bcd: \u1faa\u0ba4\u0bbf\u0b95\u0bb3\u0bcd\n\nVILGAMUWA PRADESHIYA SABHA AREA: ROADS\n\n0422/\u201909 3. \u0d9c\u0dbb\u0dd4 \u0dbb\u0d82\u0da2\u0dd2\u0dad\u0dca \u0d85\u0dbd\u0dd4\u0dc0\u0dd2\u0dc4\u0dcf\u0dd9\u0dbb\u0dca \u0db8\u0dc4\u0dad\u0dcf ( \u0bae\u0bbe\u0ba3\u0bcd\u1f97\u0bae\u0bbf\u0b95\u0bc1 \u0bb0\u0b9e\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd \u0b85\u1fa4\u0bb5\u0bbf\u0bb9\u0bbe\u0bc7\u0bb0) (The Hon. Ranjith Aluvihare) \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0dc4\u0dcf \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf \u0d85\u0db8\u0dcf\u0dad\u0255\u0dad\u0dd4\u0db8\u0dcf\u0dd9\u0d9c\u0db1\u0dca \u0d87\u0dc3\u0dd6 \u0db4\u0dc1\u0dca\u0db1\u0dba - (2) :\n\n(\u0d85) (i) \u0dc0\u0dd2\u0dbd\u0dca\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf \u0db6\u0dbd \u0db4\u0dd9\u0daf\u0dca\u0dc1\u0dba \u0dad\u0dd4\u0dc5 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0dc0 \u0dd9\u0dbb\u0dca\u0daf; (ii) \u0d92\u0dc0\u0dcf\u0dd9\u0dba\u0dca \u0db1\u0db8\u0dca \u0dc3\u0dc4 \u0daf\u0dd4\u0dbb \u0db4\u0db8\u0dcf\u0dab \u0dd9\u0d9a\u0ddc\u0db4\u0db8\u0dab\u0daf; (iii) 2006 \u0dc0\u0dbb\u0dca\u0dc2\u0dd9\u0dba\u0dca \u0dd9\u0db8\u0db8 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0db4\u0dad\u0dca\u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0d89\u0dc4\u0dad\n\n\u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dc0\u0dbd \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0d9a\u0dd3\u0da7\u0dca \u0d85\u0dad\u0dd4\u0dbb\u0dcf \u0dd9\u0dc4\u0ddd \u0dad\u0dcf\u0dbb \u0d85\u0dad\u0dd4\u0dbb\u0dcf \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd6 \u0daf\u0dd4\u0dbb \u0db4\u0db8\u0dcf\u0dab\u0dba \u0dd9\u0d9a\u0ddc\u0db4\u0db8\u0dab\u0daf; (iv) 2006 \u0dc0\u0dbb\u0dca\u0dc2\u0dd9\u0dba\u0dca \u0dd9\u0db8\u0db8 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0db4\u0dad\u0dca\u0dc0\u0dd6\u0dc0\u0dcf\u0da7 \u0db4\u0dc3\u0dd4\u0dc0\n\n2008 \u0dd9\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0d9a\u0dd3 \u0da7\u0dca \u0d85\u0dad\u0dd4\u0dbb\u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0dc3\u0d9a\u0dbb \u0d9a\u0dc5 \u0db4\u0dcf\u0dbb\u0dc0\u0dbd\u0dca \u0d9a\u0dc0 \u0dd9\u0dbb\u0dca\u0daf; (v) \u0d92\u0dc0\u0dcf\u0dd9\u0dba\u0dca \u0daf\u0dd4\u0dbb \u0db4\u0db8\u0dcf\u0dab\u0dba \u0dd9\u0d9a\u0ddc\u0db4\u0db8\u0dab\u0daf; (vi) \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd0\u0dba \u0d9a\u0dc5 \u0db8\u0dd4\u0daf\u0dbd \u0dd9\u0d9a\u0ddc\u0db4\u0db8\u0dab\u0daf; (vii) \u0dd9\u0db8\u0db8 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc0\u0dd0\u0dba \u0d9a \u0dd9\u0dc5\u0dda \u0d9a\u0dc0\u0dbb \u0dc0\u0dd0\u0dba \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dba\u0d9a\u0dd2\u0db1\u0dca\u0daf, \u0dba\u0db1\u0dca\u0db1 \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0dd9\u0db8\u0db8 \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0daf\u0db1\u0dca\u0dc0\u0db1\u0dca\u0dd9\u0db1\u0dc4\u0dd2\u0daf? (\u0d86) \u0dd9\u0db1\u0ddc\u0d91 \u0dd9\u0dc3\u0dda \u0db1\u0db8\u0dca, \u0d92 \u0db8\u0db1\u0dca\u0daf? \u0b89\u0bb3\u0bcd\u1fa7\u0bb0\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf, \u0bae\u0bbe\u0b95\u0bbe\u0ba3 \u0b9a\u0bc8\u0baa\u0b95\u0bb3\u0bcd \u0b85\u0bc8\u0bae\u0b9a\u0bcd\u0b9a\u0bc8\u0bb0\u0b95\u0bcd \u0bc7\u0b95\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0ba9\u0bbe: (\u0b85) (i) \u0bb5\u0bbf\u0bb2\u0bcd\u0b95\u1f99\u0bb5 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u0b86\u1fa6\u0bc8\u0b95\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u1faa\u0ba4\u0bbf\u0b95\u0bb3\u0bcd \u0baf\u0bbe\u0bc8\u0bb5\u0bc6\u0baf\u0ba9\u0bcd\u0baa\u0bc8\u0ba4\u1f9c\u0bae\u0bcd, (ii) \u0b85\u0bb5\u0bb1\u0bcd\u0bb1\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f91\u0bb0\u0bae\u0bcd \u0b8e\u0bb5\u0bcd\u0bb5\u0bb3\u0bc6\u0bb5\u0ba9\u0bcd\u0baa\u0bc8\u0ba4\u1f9c\u0bae\u0bcd, (iii) 2006\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0bb2\u0bcd \u0b87\u0baa\u0bcd\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u0ba8\u0bbf\u0baf\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f"
