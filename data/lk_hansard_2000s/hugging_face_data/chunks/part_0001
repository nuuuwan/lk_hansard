9c\u0dbb\u0dd4 \u0d91\u0db8\u0dca.\u0da7\u0dd3. \u0dc4\u0dc3\u0db1\u0dca \u0d85\u0dbd\u0dd2 \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u1f97\u0bae\u0bbf\u0b95\u0bc1 \u0b8e\u0bae\u0bcd. \u0bbe\u0bbf. \u0bb9\u0b9a\u0ba9\u0bcd \u0b85\u1fa2) ( The Hon. M. T. Hasen Ali) \u0b8e\u0bb2\u0bcd\u0bc7\u0bb2\u0bbe\u0bb0\u0bbe\u1fa4\u0bae\u0bcd \u0bae\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bb5\u1f9e\u0bae\u0bcd \u1f9a\u0ba4\u0bcd\u0ba4 \u0b85\u0bb0\u0b9a\u0bbf\u0baf\u0bb2\u0bcd\u0bb5\u0bbe\u0ba4\u0bbf\u1f9c \u0bae\u0bbe\u0b95\u0bbf\u0baf \u0bc6\u0b95\u0bb3\u0bb0\u0bb5 \u0b9a\u0bae\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0ba9\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u1f99\u0ba9\u0bcd\u0bc8\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0b92\u0ba4\u0bcd\u0ba4\u0bbf\u0bc8\u0bb5\u0baa\u0bcd\u1f97\u0baa\u0bcd \u0baa\u0bbf\u0bc7\u0bb0\u0bb0\u0bc8\u0ba3\u0bc8\u0baf \u0bb5\u0bb4\u0bbf\u0bc6\u0bae\u0bbe\u0bb4\u0bbf\u0bb5\u0ba4\u0bbf\u0bb2\u0bcd \u0ba8\u0bbe\u0ba9\u0bcd \u0b9a\u0ba8\u0bcd\u0bc7\u0ba4\u0bbe\u0b9a\u0baa\u0bcd \u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bc7\u0bb1\u0ba9\u0bcd.\n\n\u0db1\u0dd2\u0dd9\u0dba\u0ddd\u0da2\u0255 \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf (\u0b95\u0bc1\u1fa8\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0ba4\u0bcd \u0ba4\u0bb5\u0bbf\u0b9a\u0bbe\u0bb3\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (Mr. Deputy Chairman of Committees) \u0bc6\u0b95\u0bb3\u0bb0\u0bb5 \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bc7\u0bb3, \u0b89\u0bc8\u0bb0\u0baf\u0bbf\u0bc8\u0ba9\u0b9a\u0bcd \u0b9a\u0bb1\u0bcd\u1fa0 \u0b87\u0bc8\u0b9f \u0ba8\u0bbf\u1fa0\u0ba4\u0bcd\u1f90\u0b99\u0bcd\u0b95\u0bb3\u0bcd."
