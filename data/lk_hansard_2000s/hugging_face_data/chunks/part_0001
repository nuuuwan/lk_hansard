u0dca\u0dd9\u0dc0\u0ddd\u0daf\u0255\u0dcf\u0db1\u0dba\u0da7 \u0daf\u0dd0\u0db1\u0da7 \u0d85\u0dc0\u0dc1\u0255 \u0dd9\u0dc3\u0dda\u0dc0\u0d9a \u0dc3\u0d82\u0d9b\u0255\u0dcf\u0dc0 \u0d85\u0db1\u0dd4 \u0d85\u0d82\u0d9a\u0dba \u0dad\u0db1\u0dad\u0dd4\u0dbb \u0dad\u0db1\u0dad\u0dd4\u0dbb \u0dc3\u0d82\u0d9b\u0255\u0dcf\u0dc0\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 1475 1476\n\n42 \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a 01 43 \u0db4\u0dd2\u0db1\u0dca\u0dad\u0dcf\u0dbb\u0dd4\u0d9a\u0dbb\u0dd4 02 44 \u0da9\u0dd3\u0dc3\u0dbd\u0dca \u0dd9\u0db4\u0ddc\u0db8\u0dca\u0db4 \u0d9a\u0dd2\u0dba\u0dcf\u0d9a\u0dbb\u0dd4 01 45 \u0da2\u0dbd \u0db1\u0dbd \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a 01 46 \u0d9a\u0db1\u0dca\u0d9a\u0dcf\u0db1\u0db8\u0dca 04 47 \u0d8b\u0dba\u0db1\u0dca\u0d9a\u0dbb\u0dd4 11 48 \u0d8b\u0daf\u0255\u0dcf\u0db1 \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 94 49 \u0d85\u0dd9\u0dbd\u0dc0\u0dd2 \u0dc3\u0dc4\u0dcf\u0dba\u0d9a 01 50 \u0d9a\u0dcf. \u0d9a\u0dcf. \u0dc3. 10 51 \u0dbb\u0dd2\u0dba\u0daf\u0dd4\u0dbb\u0dd4 15 52 \u0dd9\u0dbd\u0ddc\u0dbb\u0dd2 \u0dc3\u0dc4\u0dcf\u0dba\u0d9a 02 53 \u0db8\u0dd4\u0dbb\u0d9a\u0dbb\u0dd4 02 54 \u0d85\u0db8\u0daf\u0dd2\u0db1\u0dca\u0db1\u0dcf 03 55 \u0dc3\u0db1\u0dd3\u0db4\u0dcf\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 02 56 \u0d85\u0db1\u0dd2\u0dba\u0db8\u0dca \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 65 \u0dc3\u0dad\u0dca\u0dd9\u0dc0\u0ddd\u0daf\u0255\u0dcf\u0db1\u0dba\u0da7 \u0daf\u0dd0\u0db1\u0da7 \u0d85\u0dad\u0dd2\u0dbb\u0dd2\u0d9a\u0dca\u0dad \u0dd9\u0dc3\u0dda\u0dc0\u0d9a \u0dc3\u0d82\u0d9b\u0255\u0dcf\u0dc0\n\n\u0d85\u0db1\u0dd4 \u0d85\u0d82\u0d9a\u0dba \u0dad\u0db1\u0dad\u0dd4\u0dbb \u0dad\u0db1\u0dad\u0dd4\u0dbb \u0dc3\u0d82\u0d9b\u0255\u0dcf\u0dc0 01 \u0dad\u0dad\u0dca\u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dba \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 73 (\u0d89) \u0dc3\u0dad\u0dca\u0dd9\u0dc0\u0ddd\u0daf\u0255\u0dcf\u0db1\u0dba \u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0db4\u0dd2\u0dba\u0dc0\u0dbb \u0dc3\u0dad\u0dca\u0dd9\u0dc0\u0ddd\u0daf\u0255\u0dcf\u0db1\u0dba \u0dad\u0dd4\u0dc5 \u0dc3\u0dad\u0dca\u0dc0 \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2 350\u0d9a\u0dca \u0db4\u0db8\u0dab \u0dc4\u0dcf \u0dc3\u0dad\u0dca\u0dc0\u0dba\u0dd2\u0db1\u0dca 3,000\u0d9a\u0dca\n\n\u0db4\u0db8\u0dab \u0dc0\u0dcf\u0dc3\u0dba \u0d9a\u0dbb\u0dad\u0dd2. \u0dd9\u0db8\u0dba\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0d87\u0dad\u0dd2 \u0dc3\u0db8\u0db1\u0dbd\u0dd4\u0db1\u0dca, \u0db8\u0dad\u0dca\u0dc3\u0255\u0dba\u0dd2\u0db1\u0dca \u0dc4\u0dcf \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0db4\u0d9a\u0dca\u200d\u0dc2\u0dd2 \u0dc0\u0dbb\u0dca\u0d9c \u0dbb\u0dcf\u0dc1\u0dd2\u0dba \u0d9c\u0dab\u0db1\u0dba \u0d9a\u0dc5 \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a\u0dd2 \u0dad\u0dbb\u0db8\u0dca\u0dba. \u0dc4\u0dd0\u0da7 \u0dc0\u0dc3\u0dbb\u0d9a\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0d94\u0dc0\u0dd4\u0dc4\u0dd4 \u0dd9\u0db8\u0dca \u0d9a\u0dd4\u0da9\u0dcf \u0dbb\u0db8\u0dab\u0dd3\u0dba \u0db7\u0dd6\u0db8\u0dd2 \u0db7\u0dcf\u0d9c\u0dba \u0dad\u0db8 \u0dc0\u0dcf\u0dc3\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0d9a\u0dbb \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0da7\u0dd2\u0dad\u0dd2. \u0dc3\u0dad\u0dca\u0dd9\u0dc0\u0ddd\u0daf\u0255\u0dcf\u0db1\u0dba \u0dad\u0dd4\u0dc5 \u0d87\u0dad\u0dd2 \u0d89\u0da9\u0d9a\u0da9 \u0dc3\u0dd3\u0db8\u0dcf \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd3\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0d91\u0dc4\u0dd2\n\n\u0dd9\u0dad\u0dd9\u0dbb\u0dd9\u0db4\u0db8\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0d85\u0dad\u0dd2\u0dbb\u0dd2\u0d9a\u0dca\u0dad \u0dc3\u0dad\u0dd4\u0db1\u0dca \u0dd9\u0dc0\u0db1\u0dd4\u0dd9\u0dc0\u0db1\u0dca \u0db4\u0dd2\u0db1\u0dca\u0db1\u0dc0\u0dbd \u0db1\u0dc0 \u0dc3\u0dad\u0dca\u0dd9\u0dc0\u0ddd\u0daf\u0255\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0dc4\u0dcf \u0dbb\u0dd2\u0daf\u0dd2\u0dba\u0d9c\u0db8 \u0dc3\u0dc6\u0dcf\u0dbb\u0dd2 \u0d8b\u0dba\u0db1 \u0d89\u0daf\u0dd2 \u0dd9\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd3. \u0dd9\u0db8\u0db8 \u0dc3\u0dad\u0dca\u0dc0 \u0d8b\u0daf\u0255\u0dcf\u0db1 \u0dad\u0dc0\u0dad\u0dca \u0dc0\u0dc3\u0dbb\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dd9\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dcf \u0dd9\u0d9a\u0dd9\u0dbb\u0dca. \u0d91\u0dc0\u0dd2\u0da7, \u0dd9\u0daf\u0dc4\u0dd2\u0dc0\u0dbd \u0dc3\u0dad\u0dca\u0dd9\u0dc0\u0ddd\u0daf\u0255\u0dcf\u0db1\u0dd9\u0dba\u0dca \u0dc3\u0dad\u0dd4\u0db1\u0dca\u0da7 \u0db4\u0dc4\u0dc3\u0dd4 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d91\u0db8 \u0d9a\u0dd6\u0da9\u0dd4\u0dc0\u0dbd \u0dc0\u0dcf\u0dc3\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2 \u0dd9\u0dc0\u0dca. \u0d91\u0dd9\u0dc3\u0dda\u0db8 \u0dc4\u0db8\u0dca\u0db6\u0db1\u0dca\u0dd9\u0dad\u0ddc\u0da7 \u0d85\u0d9a\u0dca\u0d9a\u0dbb 500\u0d9a\u0dd2\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dca \u0db7\u0dd6\u0db8\u0dd2\u0dba\u0d9a \u0dc3\u0dc6\u0dcf\u0dbb\u0dd2 \u0d8b\u0daf\u0255\u0dcf\u0db1\u0dba\u0d9a\u0dca"
