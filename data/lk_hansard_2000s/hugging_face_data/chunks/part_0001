    "chunk_text": "\u0baa\u0bbe\u0bb0\u0bbe\u1fa6\u0bae\u0ba9\u0bcd\u0bb1 \u0bb5\u0bbf\u0bb5\u0bbe\u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bcd\n\n(\u0bb9\u0ba9\u0bcd\u0b9a\u0bbe\u0b9f\u0bcd)\n\n\u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0bc8\u0b95\n\n\u0bc6\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf 185\n\n\u0b87\u0bb2\u0b99\u0bcd\u0bc8\u0b95\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u1f8a\u0baf\u0bb0\u0b9a\u0bbf\u0ba9\u0bcd\n\n\u0b86\u0bb1\u0bbe\u0bb5\u1f90 \u0baa\u0bbe\u0bb0\u0bbe\u1fa6\u0bae\u0ba9\u0bcd\u0bb1\u0bae\u0bcd\n\n\u0ba8\u0bbe\u0ba9\u0bcd\u0b95\u0bbe\u0bb5\u1f90 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0bc6\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\n\n2009\n\n\u0baa\u0bbe\u0bb0\u0bbe\u1fa6\u0bae\u0ba9\u0bcd\u0bb1 \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\n\n[2004, \u0b8f\u0baa\u0bcd\u0baa\u0bbf\u0bb1\u0bb2\u0bcd 2 \u0bc6\u0baa\u0bbe\u1f90\u0ba4\u0bcd \u0bc7\u0ba4\u0bb0\u0bcd\u0ba4\u1fa2\u0bb2\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u1fab \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0bc7\u0b9f\u0bbe\u0bb0\u0bcd]\n\n\u0b85\u1fa4\u0bb5\u0bbf\u0bb9\u0bbe\u0bc7\u0bb0, \u0bb0\u0b9e\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd \u0b9c\u0bbf\u0ba9\u0ba4\u0bbf\u0bb8\u0bcd\u0bb8 (\u0bae\u0bbe\u0ba4\u0bcd\u0ba4\u0bc8\u0bb3) \u0b85\u0bb4\u0bb9\u0b95\u0bcd\u0bc7\u0b95\u0bbe\u0ba9\u0bcd, \u0ba4\u0bbf\u1f9e\u0bae\u0ba4\u0bbf \u0b9a\u0bc1\u0b9c\u0bbe\u0ba4\u0bbe (\u0bae\u0bbe\u0ba4\u0bcd\u0ba4\u0bc8\u0bb3) \u0b85\u1fa6\u0ba4\u0bcd\u0b95\u0bae\u0bc7\u0b95, \u0bae\u0bb9\u0bbf\u0ba8\u0bcd\u0ba4\u0bbe\u0ba9\u0ba8\u0bcd\u0ba4 (\u0b95\u0ba3\u0bcd\u1f8a)\n\n\u0b85\u0ba9\u0bcd\u0bb5\u0bb0\u0bcd \u0b87\u0bb8\u0bcd\u0bae\u0bbe\u0baf\u0bbf\u0bb2\u0bcd, \u1f99\u0bb9\u0bae\u0bcd\u0bae\u0ba4\u0bcd \u0b87\u0bb8\u0bcd\u0bae\u0bbe\u0baf\u0bbf\u0bb2\u0bcd (\u0bc7\u0ba4\u0b9a\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8a\u0baf\u0bb2\u0bcd) [\u0b87\u0bb1\u0baa\u0bcd\u1f97: 2007 \u0bc6\u0b9a\u0baa\u0bcd\u0bc6\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bcd 13] \u0b85\u0ba9\u0bcd\u0b9c\u0bbe\u0ba9\u0bcd \u0b89\u0bae\u0bcd\u0bae\u0bbe, \u0ba4\u0bbf\u1f9e\u0bae\u0ba4\u0bbf \u0b8f.\u0b86\u0bb0\u0bcd (\u0b95\u0bae\u0bcd\u0baa\u0bb9\u0bbe) \u0b85\u0bb7\u0bcd\u0bb0\u0b83\u0baa\u0bcd, \u0ba4\u0bbf\u1f9e\u0bae\u0ba4\u0bbf \u0bc7\u0baa\u0bbe\u0bbf\u0baf\u0bb2\u0bcd \u0b87\u0bb8\u0bcd\u0bae\u0bbe\u0baf\u0bbf\u0bb2\u0bcd (\u0ba4\u0bbf\u0b95\u0bbe\u0bae\u1f8c\u0bb2\u0bcd\u0bb2)\n\n\u0b87\n\n\u0b87\u0bae\u0bbe\u0bae\u0bcd, \u0bb0\u0bb8\u0bc0\u0ba9\u0bcd \u1f99\u0b95\u0bae\u0bcd\u0bae\u1f90 (\u0bc7\u0ba4\u0b9a\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8a\u0baf\u0bb2\u0bcd) [2008 \u0b9a\u0ba9\u0bb5\u0bbe\u0bbf 18 \u0b87\u1fa2\u1f9e\u0ba8\u0bcd\u1f90] \u0b87\u0bb0\u0bb5\u0bbf\u0bb0\u0bbe\u0b9c\u0bcd, \u0ba8\u0b9f\u0bb0\u0bbe\u0b9c\u0bbe (\u0baf\u0bbe\u0bb4\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0ba3\u0bae\u0bcd) [\u0b87\u0bb1\u0baa\u0bcd\u1f97: 2006 \u0ba8\u0bb5\u0bae\u0bcd\u0baa\u0bb0\u0bcd 10]\n\n\u0b87\u0bb0\u0bbe\u0b9a\u0ba8\u0bbe\u0baf\u0b95\u0bae\u0bcd, \u0b95\u0bbf\u0b99\u0bcd\u0bb8\u0bcd\u1fa2 (\u0bae\u0b9f\u0bcd\u0b9f\u0b95\u0bcd\u0b95\u0bb3\u0baa\u0bcd\u1f97) [\u0b87\u0bb0\u0bbe\u0b9c\u0bbf\u0ba9\u0bbe\u0bae\u0bbe : 12 \u0b8f\u0baa\u0bcd\u0baa\u0bbf\u0bb1\u0bb2\u0bcd 2004 ] \u0b87\u0bb0\u0bbe\u0ba4\u0bbe\u0b95\u0bbf\u1f9e\u0bb7\u0bcd\u0ba3\u0ba9\u0bcd, \u0bc6\u0baa\u1f9e\u0bae\u0bbe\u0bb3\u0bcd\u0baa\u0bbf\u0bb3\u0bcd\u0bc8\u0bb3 (\u0bc7\u0ba4\u0b9a\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8a\u0baf\u0bb2\u0bcd)\n\n\u0b87\u0bb8\u0bcd\u0bb8\u0ba4\u0bc0\u0ba9\u0bcd, \u1f99\u0bb9\u0bae\u0bcd\u0bae\u0ba4\u0bcd \u0bb9\u0b9a\u0ba9\u0bcd \u0bc7\u0b9a\u0b95\u0bc1 (\u0bc7\u0ba4\u0b9a\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8a\u0baf\u0bb2\u0bcd)\n\n\u0b88\n\n\u0b88\u0bb4\u0bc7\u0bb5\u0ba8\u0bcd\u0ba4\u0ba9\u0bcd, \u0bae\u0bbe\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bbe\u0b9a\u0b95\u0bb0\u0bcd \u0b95\u0ba9\u0b95\u0b9a\u0baa\u0bbe\u0baa\u0ba4\u0bbf (\u0bc7\u0ba4\u0b9a\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8a\u0baf\u0bb2\u0bcd) [2007 \u0ba8\u0bb5\u0bae\u0bcd\u0baa\u0bb0\u0bcd 20 \u0bb5\u0bc8\u0bb0] (\u0b85\u0bb0\u0b9a\u0bbf\u0baf\u0bb2\u0bc8\u0bae\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bcd 66(\u0b8a)\u0b86\u0bae\u0bcd \u0b89\u1fa0\u0baa\u0bcd\u1f97\u0bc8\u0bb0\u0baf\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd\n\n\u0b86\u0b9a\u0ba9\u0bae\u0bcd \u0bb5\u0bb1\u0bbf\u0ba4\u0bbe\u0ba4\u0bb2\u0bcd)\n\n\u0b8f\n\n\u0b8f\u0b95\u0bcd\u0b95\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95, \u0bb5\u0bbf\u0bc7\u0b9c\u0b9a\u0bc1\u0ba8\u0bcd\u0ba4\u0bb0 \u1f99\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0ba4\u0bbf\u0bb2\u0b95\u0bb0\u0ba4\u0bcd\u0ba9 \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0 ( \u0b95\u0bc1\u1f9e\u0ba8\u0bbe\u0b95\u0bb2\u0bcd) \u0b8f\u0b95\u0bcd\u0b95\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95, \u0bb5\u0bbf\u0bb2\u0bcd\u0baa\u0bbf\u0bb0\u0b9f\u0bcd \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0 (\u0b85\u1f94\u0bb0\u0bbe\u0ba4\u1f97\u0bb0\u0bae\u0bcd) \u0b8f\u0b95\u0bcd\u0b95\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95, \u0b8f\u0b95\u0bcd\u0b95\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u1f99\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0bae\u0bb9\u0bbf\u0ba8\u0bcd\u0ba4 \u0ba8\u0ba8\u0bcd\u0ba4\u0bbf\u0bae\u0bbf\u0ba4\u0bcd\u0bb0 (\u0bae\u0bbe\u0ba4\u0bcd\u0ba4\u0bc8\u0bb3) [2009 \u0bc7\u0bae 27 \u0b87\u1fa2\u1f9e\u0ba8\u0bcd\u1f90]\n\n\u0b95\n\n\u0b95\u0b99\u0bcd\u0b95\u0ba8\u0bcd\u0ba4, \u1f90\u0bc7\u0ba9\u0bb7\u0bcd \u0bb9\u0bb0\u0bcd\u0bb7 (\u0b87\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u1f97\u0bbe\u0bbf) \u0b95\u0ba4\u0bbf\u0bb0\u0bcd\u0b95\u0bbe\u0bae\u0bb0\u0bcd, \u0bb2\u0b95\u0bcd \u0bb7\u0bcd\u0bae\u0ba9\u0bcd (\u0bc7\u0ba4\u0b9a\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8a\u0baf\u0bb2\u0bcd) [\u0b87\u0bb1\u0baa\u0bcd\u1f97: 2005 \u0b93\u0b95\u0bb8\u0bcd\u0b9f\u0bcd 12] \u0b95\u0ba4\u0bbf\u0bb0\u0bcd\u0b95\u0bbe\u0bae\u0ba9\u0bcd, \u0ba4\u0b99\u0bcd\u0bc7\u0b95\u0bb8\u0bcd\u0bb5\u0bbe\u0bbf (\u0bae\u0b9f\u0bcd\u0b9f\u0b95\u0bcd\u0b95\u0bb3\u0baa\u0bcd\u1f97) \u0b95\u0bae\u0bc7\u0b95, \u0b87\u0bb9\u0bb2 \u0bc6\u0bae\u0ba4\u0b95\u0bae \u0baa\u0bbf\u0baf\u0bc7\u0b9a\u0ba9 (\u0b95\u0bbe\u1fa2) \u0b95\u0bae\u0bb0\u0bcd\u0ba4\u0bc0\u0ba9\u0bcd, \u0b85\u0baa\u0bcd\u1f90\u0bb2\u0bcd \u0baa\u0bbe\u0baf\u0bbf\u0bb8\u0bcd (\u0bc7\u0ba4\u0b9a\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8a\u0baf\u0bb2\u0bcd)"
  },
