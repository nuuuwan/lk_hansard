    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dd9\u0dba\u0ddd\u0da2\u0255 \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d85\u0daf \u0dd9\u0db8\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0dd9\u0db6\u0db1 \u0d9a\u0dd0\u0dc5\u0dd1 (\u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0db1) \u0db4\u0db1\u0dad\u0dca \u0dd9\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad \u0d9c\u0dad\u0dca\u0dd9\u0dad\u0ddc\u0dad\u0dca, 1890 \u0daf\u0dd3 \u0dad\u0db8\u0dba\u0dd2 \u0d9a\u0dd0\u0dc5\u0dd1 \u0d86\u0da5\u0dcf\u0db4\u0db1\u0dad \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0dc0\u0dd4\u0dd9\u0dab\u0dca. \u0d89\u0db1\u0dca \u0db4\u0dc3\u0dca\u0dd9\u0dc3\u0dda \u0d92\u0d9a 1907 \u0d85\u0d82\u0d9a 16 \u0dd9\u0dbd\u0dc3 \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dc0 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd9\u0dba\u0db1\u0dca \u0d87\u0dc0\u0dd2\u0dad\u0dca \u0d8a \u0da7 \u0db4\u0dc3\u0dd4\u0dc0 1995 \u0d85\u0d82\u0d9a 23 \u0daf\u0dbb\u0db1 \u0db4\u0db1\u0dad \u0d91\u0db1 \u0d9a\u0dbd\u0dca\u0db8 \u0dd9\u0daf\u0ddc\u0dd9\u0dc5\u0ddc\u0dc3\u0dca \u0dc0\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0db4\u0db8\u0dab \u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0db1\u0dba \u0dd9\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0d87\u0dc0\u0dd2\u0dad\u0dca \u0dad\u0dd2\u0dd9\u0db6\u0db1\u0dc0\u0dcf. 1995\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0 2000 \u0dc0\u0dbb\u0dca\u0dc2\u0dd9\u0dba\u0dca\u0daf\u0dd3 \u0dd9\u0db8\u0dca\u0d9a \u0d85\u0db8\u0dcf\u0dad\u0255 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0dbd\u0dcf 2000.05.26 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0255 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dd9\u0dba\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dad\u0dd2\u0dba \u0dbd\u0db6\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0da7 \u0db4\u0dc3\u0dd4\u0dc0 \u0d85\u0daf\n\n\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dd9\u0dba\u0ddd\u0da2\u0255 \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d92 \u0dc0\u0dcf\u0dd9\u0d9c\u0dca\u0db8 \u0dad\u0dc0\u0dad\u0dca \u0dc0\u0dd0\u0daf\u0d9c\u0dad\u0dca \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0daf\u0dd0\u0dc0 \u0d9c\u0db6\u0da9\u0dcf \u0db4\u0dcf\u0dbd\u0db1\u0dba. \u0dd9\u0db8\u0ddc\u0d9a\u0daf, \u0dd9\u0dc4\u0dda\u0dad\u0dd4\u0dc0? \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2\u0dd9\u0dba\u0db1\u0dca\u0db8 \u0dc3\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0dc0\u0db1\u0dba\u0db1\u0dca \u0d9c\u0dad\u0dca\u0dad\u0dcf\u0db8 \u0d92 \u0dc0\u0dcf\u0dd9\u0d9c\u0dca\u0db8 \u0d92 \u0dc4\u0dcf \u0dc3\u0db8\u0dcf\u0db1 \u0dc0\u0db1\u0dba\u0db1\u0dca \u0d9c\u0dad\u0dca\u0dad\u0dcf\u0db8 \u0d92 \u0dc4\u0dcf \u0d9a\u0dbb\u0db1 \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad \u0dad\u0dd2\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u0dad\u0dd9\u0d9a\u0ddc\u0da7 \u0dd9\u0db8\u0dca \u0daf\u0dd0\u0dc0 \u0d9c\u0db6\u0da9\u0dcf \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd9\u0dba\u0db1\u0dca \u0dba\u0db8\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0d9a\u0dca -\u0d9a\u0db8\u0dd9\u0dc0\u0dca\u0daf\u0dba\u0d9a\u0dca- \u0d85\u0dc0\u0dc1\u0255 \u0dc0\u0db1\u0dc0\u0dcf. \u0daf\u0dd0\u0dc0 \u0d9c\u0db6\u0da9\u0dcf \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd9\u0dba\u0db1\u0dca\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 851 852\n\n[\u0d9c\u0dbb\u0dd4 \u0dbd\u0dbd\u0dd2\u0dad\u0dca \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dad\u0dcf]"
  },
