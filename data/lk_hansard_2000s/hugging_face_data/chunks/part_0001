    "chunk_text": "\u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db4\u0dcf\u0d9a\u0dca\u0dc2\u0dd2\u0d9a\u0dba\u0d9a\u0dd4 \u0dc0\u0dc1\u0dd9\u0dba\u0db1\u0dca 1963 \u0dc0\u0dbb\u0dca\u0dc2\u0dd9\u0dba\u0dca \u0dc3\u0dd2\u0da7\u0db8 \u0d85\u0d9a\u0dca\u0db8\u0dd3\u0db8\u0db1 \u0d86\u0dc3\u0db1\u0dd9\u0dba\u0dca \u0d9a\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0dbb\u0dd3 \u0dd9\u0daf\u0dca\u0dc1\u0db4\u0dcf\u0dbd\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dbd \u0db1\u0dd2\u0dba\u0dd0\u0dbd\u0dd4\u0dab\u0dd4 \u0d91\u0dad\u0dd4\u0db8\u0dcf 1965 \u0dc3\u0dc4 1970 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0dc4 \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dd2\u0dba \u0d86\u0dc3\u0db1\u0dd9\u0dba\u0dca \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d89\u0db8\u0dc4\u0dad\u0dca \u0dd9\u0dc0\u0dd9\u0dc4\u0dc3\u0d9a\u0dca \u0daf\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0d89\u0da7\u0dd4 \u0d9a\u0dd9\u0dc5\u0dda\u0dba. 1968 \u0dc0\u0dbb\u0dca\u0dc2\u0dd9\u0dba\u0dca\u0daf\u0dd3 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dbd\u0dd4\u0dab\u0dd4 \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0dc0\u0dca \u0d85\u0db0\u0255\u0d9a\u0dca\u0dc2\u0dc0\u0dbb\u0dba\u0d9a\u0dd4 \u0dc0\u0dc1\u0dd9\u0dba\u0db1\u0dca \u0daf, 1968 \u0dc3\u0dd2\u0da7 1970 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d85\u0d9a\u0dca\u0db8\u0dd3\u0db8\u0db1 \u0d9c\u0db8\u0dca \u0dc3\u0db7\u0dcf\u0dd9\u0dc0\u0dca \u0dc3\u0dcf\u0db8 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dd9\u0dc0\u0dca \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0dc0\u0dc1\u0dd9\u0dba\u0db1\u0dca \u0daf \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0dbd\u0dd0\u0db6\u0dd2\u0dab\u0dd2.\n\n\u0db1\u0dd2\u0dd9\u0dba\u0ddd\u0da2\u0255 \u0d85\u0db8\u0dcf\u0dad\u0255\u0dc0\u0dbb\u0dba\u0d9a\u0dd4 \u0dd9\u0dbd\u0dc3 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc5 \u0d9a\u0dcf\u0dbd \u0dc3\u0dd3\u0db8\u0dcf\u0dc0 \u0dad\u0dd4\u0dc5 \u0daf\u0dd3 \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0da2\u0dd9\u0dba\u0dca \u0db1\u0dd2\u0dd9\u0dba\u0ddd\u0da2\u0dd2\u0dad\u0dba\u0d9a\u0dd4 \u0dc0\u0dc1\u0dd9\u0dba\u0db1\u0dca \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd3\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dd9\u0dba\u0dca \u0dc3\u0dd0\u0dc3\u0dd2 \u0dc0\u0dcf\u0dbb\u0dba\u0db1\u0dca\u0da7 \u0daf \u0d89\u0db1\u0dca\u0daf\u0dd4\u0db1\u0dd3\u0dc3\u0dd2\u0dba\u0dcf\u0dd9\u0dc0\u0dca \u0dc3\u0dc4 \u0dad\u0dcf\u0dba\u0dd2\u0dbd\u0db1\u0dca\u0dad\u0dd9\u0dba\u0dca \u0d9a\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8\u0dba \u0dc4\u0dcf \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u0dc3\u0db8\u0dd4\u0dc5\u0dd4\u0dc0\u0dbd\u0da7 \u0daf \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0dc3\u0dc4\u0db7\u0dcf\u0d9c\u0dd2 \u0dc0\u0dd2\u0dab\u0dd2. \u0dad\u0dc0\u0daf, \u0db6\u0dd2\u0dad\u0dcf\u0db1\u0255 \u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d86\u0dbb\u0dcf\u0db0\u0db1\u0dba \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0da2\u0dd9\u0dba\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4 \u0db1\u0dd2\u0dd9\u0dba\u0ddd\u0da2\u0dd2\u0dad\u0dba\u0d9a\u0dd4 \u0dd9\u0dbd\u0dc3 \u0d91\u0dc4\u0dd2 \u0da0\u0dcf\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0d9a \u0dd9\u0dba\u0daf\u0dd3\u0dd9\u0db8\u0dca \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0daf \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0dc4\u0dd2\u0db8\u0dd2 \u0dc0\u0dd2\u0dab\u0dd2.\n\n\u0d9a\u0dd8\u0dc2\u0dd2\u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d9a\u0dca\u0dd9\u0dc2\u0dda\u0dad\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0dca \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0db4\u0dd4\u0db1\u0dca\u0dc0 \u0dc3\u0dd2\u0da7\u0dd2 \u0dd9\u0db8\u0db8 \u0dc3\u0dd4\u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2\u0dd3 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dba\u0dcf \u0dc0\u0dc3\u0dbb \u0d9c\u0dab\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0da2\u0db1\u0dad\u0dcf \u0d8b\u0db1\u0dca\u0db1\u0dad\u0dd2\u0dba \u0dd9\u0dc0\u0db1\u0dd4\u0dd9\u0dc0\u0db1\u0dca \u0d9a\u0dcf\u0dbd\u0dba\u0dad\u0dca, \u0dc1\u0db8\u0dba\u0dad\u0dca \u0d9a\u0dd0\u0db4 \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0db8\u0dc4 \u0da2\u0db1 \u0dd9\u0dc3\u0dda\u0dc0\u0dd9\u0dba\u0dca\n\n\u0dd9\u0dba\u0dd9\u0daf\u0db8\u0dd2\u0db1\u0dca \u0dc0\u0dc3\u0dbb 78\u0d9a\u0dca \u0d86\u0dba\u0dd4 \u0dc0\u0dd2\u0db1\u0dca\u0daf\u0db1\u0dba \u0dd9\u0d9a\u0ddc\u0da7 2006 \u0dd9\u0db4\u0db6\u0dbb\u0dc0\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 27 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dd9\u0daf\u0dca \u0d85\u0db1\u0dd2\u0dad\u0255 \u0db6\u0dc0 \u0db4\u0dc3\u0d9a\u0dca \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dc3\u0daf\u0dc4\u0da7\u0db8 \u0dd9\u0daf\u0dd9\u0db1\u0dad\u0dca \u0db4\u0dd2\u0dba\u0dcf \u0d9c\u0dad\u0dca\u0dd9\u0dad\u0dca\u0dba. \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0dc3\u0dca\u0dc0\u0dcf\u0db8\u0dd3\u0db1\u0dca \u0dc0\u0dc4\u0db1\u0dca\u0dc3, \u0dc3\u0db8\u0dc3\u0dca\u0dad \u0dc1\u0dd3 \u0dbd\u0dcf\u0d82\u0d9a\u0dd3\u0dba \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0dd9\u0d9c\u0dca \u0dc4\u0dd2\u0dad \u0dc3\u0dd4\u0dc0 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0d8b\u0daf\u0dcf\u0dbb \u0dd9\u0db8\u0dd9\u0dc4\u0dc0\u0dbb\u0d9a\u0dca \u0d89 \u0da7\u0dd4 \u0d9a\u0dc5 \u0d85\u0db7\u0dcf\u0dc0\u0db4\u0dcf\u0db4\u0dca\u0dad \u0dc0\u0dd6 \u0d85\u0d9a\u0dca\u0db8\u0dd3\u0db8\u0db1 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3 \u0dc3\u0dc4 \u0d9a\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc4\u0dcf \u0db4\u0dbb\u0dca\u0dd9\u0dba\u0dca\u0dc2\u0dab \u0db1\u0dd2\u0dd9\u0dba\u0ddd\u0da2\u0255 \u0d85\u0db8\u0dcf\u0dad\u0255\u0dc0\u0dbb\u0dba\u0d9a\u0dd4 \u0dc0\u0dd6 \u0dc3\u0dd4\u0db8\u0db1\u0daf\u0dcf\u0dc3 \u0d85\u0dd9\u0db6\u0dca\u0dc0\u0dd2\u0d9a\u0db8 \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dca\u0da7 \u0db1\u0dd2\u0dc0\u0db1\u0dca \u0dc3\u0dd4\u0dc0 \u0d85\u0dad\u0dca \u0dd9\u0dc0\u0dca\u0dc0\u0dcf!\u0dba\u0dd2 \u0db4\u0dcf\u0dbb\u0dca\u0dae\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0d85\u0dad\u0dbb, \u0dd9\u0db8\u0db8 \u0d8b\u0dad\u0dca\u0dad\u0dbb\u0dd3\u0dad\u0dbb \u0dc3\u0db7\u0dcf\u0dd9\u0dc0\u0dca \u0dd9\u0dc1\u0ddd\u0d9a\u0dba \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0dab\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0daf\u0dba\u0dcf\u0db6\u0dbb \u0daf\u0dd6 \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dc4 \u0db4\u0dc0\u0dd4\u0dd9\u0dbd\u0dca \u0da5\u0dcf\u0dad\u0dd3\u0db1\u0dca \u0dd9\u0dc0\u0dad \u0daf\u0db1\u0dca\u0dc0\u0dcf \u0dba\u0dc0\u0db1 \u0dd9\u0dbd\u0dc3 \u0dd9\u0dba\u0ddd\u0da2\u0db1\u0dcf \u0d9a\u0dbb \u0dc3\u0dd2\u0da7\u0dd2\u0db8\u0dd2."
  },
