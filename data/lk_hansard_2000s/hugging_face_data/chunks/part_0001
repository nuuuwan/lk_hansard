b95\u0bcd\u0bb8\u0bcd \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe) (The Hon. Felix Perera) \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb \u0dc3\u0db7\u0dcf\u0d9c\u0dad \u0d9a\u0dc5\u0dcf. \u0dc3\u0db7\u0dcf\u0d9c\u0dad \u0d9a\u0dc5\u0dcf\u0da7 \u0db4\u0dc3\u0dca\u0dd9\u0dc3\u0dda \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dc1\u0dca\u0db1 \u0d85\u0dc0\u0dc1\u0255 \u0db1\u0dd0\u0dc4\u0dd0. [\u0db6\u0dcf\u0db0\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dca] \u0d95\u0db1\u0dd1\u0db8 \u0db4\u0dc1\u0dca\u0db1\u0dba\u0d9a\u0da7 \u0d8b\u0dad\u0dca\u0dad\u0dbb \u0dd9\u0daf\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca, \u0db4\u0dc1\u0dca\u0db1\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0d9c\u0dad \u0d9a\u0dbb\u0db1 \u0d91\u0d9a \u0dd9\u0dc4\u0ddc\u0db3\u0dba\u0dd2. \u0d85\u0dad\u0255\u0dc0\u0dc1\u0255 \u0db4\u0dcf\u0dbb\u0dd2\u0dd9\u0db7\u0ddd\u0d9c\u0dd2\u0d9a \u0daf\u0dc0\u0255 \u0d86\u0db1\u0dba\u0db1\u0dba: \u0db6\u0daf\u0dd4 \u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb5\u0b9a\u0bbf\u0baf \u1f92\u0b95\u0bb0\u0bcd\u1fab\u0baa\u0bcd \u0bc6\u0baa\u0bbe\u1f9e\u0b9f\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b87\u0bb1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0ba4\u0bbf : \u0bb5\u0bbe\u0bbf\u0b95\u0bb3\u0bcd\n\nIMPORTATION OF ESSENTIAL CONSUMER GOODS : TAXES"
