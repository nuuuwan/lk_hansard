    "chunk_text": "\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1, \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0ba9 01.10.1833\u0b87\u0bb2\u0bcd \u0bc7\u0b95\u0bbe\u0bb2\u0bcd \u1f97\u1fa1\u0b95\u0bcd, \u0b95\u0bae\u0bb0\u0ba9\u0bcd \u0b9a\u0bc0\u0bb0\u0bcd\u0ba4\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0b89\u1f9e\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0baa\u0bbe\u1fa8\u1f90 \u0b85\u0bc8\u0bb5 \u0bc6\u0bae\u0bbe\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0b95 18,052 \u0b9a\u1f90\u0bb0 \u0b95\u0bbf\u0bc7\u0bb2\u0bbe \u0bae\u0bc0\u0bb1\u0bcd\u0bb1\u0bb0\u0bcd \u0ba8\u0bbf\u0bb2\u0baa\u0bcd\u0baa\u0bb0\u0baa\u0bcd\u0baa\u0bbf\u0bc8\u0ba9\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u1f8a\u1f9e\u0ba8\u0bcd\u0ba4\u0ba9. \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bcd\u0baa\u0bbe\u0bc8\u0bb1 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 4,431.4 \u0b9a\u1f90\u0bb0 \u0b95\u0bbf\u0bc7\u0bb2\u0bbe \u0bae\u0bc0\u0bb1\u0bcd\u0bb1\u0bc8\u0bb0\u1f9c\u0bae\u0bcd, \u0bae\u0b9f\u0bcd\u0b9f\u0b95\u0bcd\u0b95\u0bb3\u0baa\u0bcd\u1f97 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 2,633.1 \u0b9a\u1f90\u0bb0 \u0b95\u0bbf\u0bc7\u0bb2\u0bbe \u0bae\u0bc0\u0bb1\u0bcd\u0bb1\u0bc8\u0bb0\u1f9c\u0bae\u0bcd, \u0ba4\u0bbf\u1f9e\u0bae\u0bc8\u0bb2 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 2,728.8 \u0b9a\u1f90\u0bb0 \u0b95\u0bbf\u0bc7\u0bb2\u0bbe \u0bae\u0bc0\u0bb1\u0bcd\u0bb1\u0bc8\u0bb0\u1f9c\u0bae\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u1f8a\u1f9e\u0ba8\u0bcd\u0ba4\u1f90. \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bc6\u0bae\u0bbe\u0ba4\u0bcd\u0ba4\u0baa\u0bcd \u0baa\u0bb0\u0baa\u0bcd\u0baa\u0bb3\u1fab 9,803.3 \u0b9a\u1f90\u0bb0 \u0b95\u0bbf\u0bc7\u0bb2\u0bbe \u0bae\u0bc0\u0bb1\u0bcd\u0bb1\u0bb0\u0bbe\u0b95\u0bc1\u0bae\u0bcd. \u0baa\u0bbf\u0ba9\u0bcd\u1f97 \u0b95\u0bbe\u0bb2\u0baa\u0bcd\u0bc7\u0baa\u0bbe\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bcd \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0b95\u0bb3\u0bcd, \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0ba9 \u0bc6\u0baa\u1f9e\u0bae\u0bcd\u0baa\u0bbe\u0ba9\u0bcd\u0bc8\u0bae\u0b9a\u0bcd \u0b9a\u1f9a\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bb5\u0b9a\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bb5\u0bbe\u0baf\u0bcd\u0baa\u0bcd\u1f97\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b8f\u0bb1\u0bcd\u0bb1\u0bb5\u0bbe\u1fa0 \u0b89\u1f9e\u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c \u0bb5\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3\u0ba9. 1963\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8c \u0bae\u0b9f\u0bcd\u0b9f\u0b95\u0bcd\u0b95\u0bb3\u0baa\u0bcd\u1f97 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c \u1f97\u0ba4\u0bbf\u0baf \u0b85\u0bae\u0bcd\u0baa\u0bbe\u0bc8\u0bb1 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b89\u1f9e\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0baa\u0bbe\u1fa8\u1f90 \u0b85\u0ba9\u0bcd\u0bb1\u0bbf\u1f9e\u0ba8\u0bcd\u0ba4 \u0bae\u0b9f\u0bcd\u0b9f\u0b95\u0bcd\u0b95\u0bb3\u0baa\u0bcd\u1f97 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0bc6\u0bae\u0bbe\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0b95 5.8 \u0b9a\u0ba4 \u1faa\u0ba4\u0bae\u0bbe\u0ba9 \u0b9a\u0bbf\u0b99\u0bcd\u0b95\u0bb3 \u0b9a\u0bc7\u0b95\u0bbe\u0ba4\u0bb0\u0bb0\u0bcd\u0b95\u0bc7\u0bb3 \u0bb5\u0bbe\u0bb4\u0bcd\u0ba8\u0bcd\u1f90 \u0bb5\u0ba8\u0bcd\u0ba4\u0ba9\u0bb0\u0bcd. \u0b86\u0ba9\u0bbe\u0bb2\u0bcd \u1f97\u0ba4\u0bbf\u0baf \u0b85\u0bae\u0bcd\u0baa\u0bbe\u0bc8\u0bb1 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b89\u1f9e\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0baa\u0bbe\u1fa8\u1f90 \u0b85\u0ba3\u0bcd\u0bc8\u0b9f\u0baf \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb2\u0baa\u0bcd \u0baa\u0bb0\u0baa\u0bcd\u1f97\u0bae\u0bcd \u0b95\u0bc1\u1f8a\u0b9a\u0ba9\u0baa\u0bcd \u0baa\u0bb0\u0bae\u0bcd\u0baa\u1fa4\u0bae\u0bcd \u0bc7\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c \u0bc6\u0bae\u0bbe\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0b95 \u0b85\u0b99\u0bcd\u0b95\u0bc1\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 1047 1048\n\n[\u0d9c\u0dbb\u0dd4 \u0d91\u0db8\u0dca.\u0da7\u0dd3. \u0dc4\u0dc3\u0db1\u0dca \u0d85\u0dbd\u0dd2 \u0db8\u0dc4\u0dad\u0dcf]"
