    "chunk_text": "\u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d87\u0dd9\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0dd9\u0dc0\u0dca\u0dad\u0dca \u0d92 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0d87\u0dad\u0dd2 \u0dd9\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0db4\u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0d92\u0d9a \u0d85\u0db4\u0da7 \u0dd9\u0db4\u0db1\u0dca\u0db1\u0dd4\u0db8\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0dbb\u0da7\u0dc0\u0dbd\u0da7\u0dad\u0dca \u0d92 \u0dc0\u0dcf\u0dd9\u0d9c\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dd9\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dd9\u0dba\u0daf\u0dca\u0daf\u0dd3 -\u0dd9\u0dbd\u0ddd\u0d9a\u0dd9\u0dba\u0dca\u0dad\u0dca \u0d91\u0dc0\u0db1\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dd9\u0dba\u0daf\u0dca\u0daf\u0dd3 - \u0dd9\u0db8\u0dca \u0dc0\u0dcf\u0dd9\u0d9c\u0dca \u0dba\u0dd4\u0daf\u0dca\u0db0\u0dba\u0d9a\u0da7 \u0db8\u0dd4\u0dc4\u0dd4\u0dab \u0daf\u0dd4\u0db1\u0dca \u0dbd\u0d82\u0d9a\u0dcf\u0dc0 \u0dc0\u0dcf\u0dd9\u0d9c\u0dca \u0dbb\u0da7\u0d9a\u0da7 - \u0d85\u0db4\u0da7 - \u0db8\u0dd4\u0dc4\u0dd4\u0dab \u0dd9\u0daf\u0db1\u0dca\u0db1\u0da7 \u0dad\u0dd2\u0dd9\u0db6\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0db1\u0dca \u0dd9\u0db8\u0ddc\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db6\u0dbd\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1.\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 589 590"
  },
