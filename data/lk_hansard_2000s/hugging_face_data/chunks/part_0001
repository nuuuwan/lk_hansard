    "chunk_text": "\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dba \u0dd9\u0dc4\u0ddc\u0db6 \u0dc0\u0db1 \u0d9c\u0dbb\u0dd4\u0dad\u0dbb \u0dc3\u0dca\u0dc0\u0dcf\u0db8\u0dd3\u0db1\u0dca \u0dc0\u0dc4\u0db1\u0dca\u0dc3, \u0dad\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0db8\u0dbd\u0dba, \u0db8\u0da9\u0d9a\u0dc5\u0db4\u0dd4\u0dc0, \u0d91\u0dbb\u0dcf\u0dc0\u0dd4\u0dbb\u0dca, \u0db4\u0dd4\u0db1\u0dca\u0db1\u0d9a\u0dd4\u0da9\u0dcf, \u0dd9\u0db8\u0ddd\u0daf\u0dbb, \u0db8\u0dd3\u0d9c\u0db8\u0dd4\u0dc0 \u0d86\u0daf\u0dd3 \u0db4\u0dd9\u0daf\u0dca\u0dc1\u0dc0\u0dbd \u0db0\u0dd3\u0dc0\u0dbb\u0dba\u0db1\u0dca\u0da7 \u0daf\u0dd0\u0db1\u0dca \u0dad\u0db8\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0db0\u0dd3\u0dc0\u0dbb \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dba \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d9a\u0dbb \u0dd9\u0d9c\u0db1 \u0dba\u0dcf\u0db8\u0da7 \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd \u0daf\u0dd4\u0dc2\u0dca\u0d9a\u0dbb\u0dad\u0dcf\u0dc0\u0db1\u0dca \u0db8\u0dad\u0dd4 \u0dd9\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0dad\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0db8\u0dbd\u0dba, \u0db8\u0da9\u0d9a\u0dc5\u0db4\u0dd4\u0dc0 \u0d9a\u0dd2\u0dba\u0db1 \u0dd9\u0db8\u0dca \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a \u0dd9\u0daf\u0dd9\u0d9a\u0dca \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0dc0\u0dd2\u0dc3\u0dca\u0dc3\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0dca\u0dd9\u0dc3\u0dda \u0dad\u0db8\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dba \u0dc4\u0dbb\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0dbb\u0dc0 \u0d9a\u0dbb \u0dd9\u0d9c\u0db1 \u0dba\u0dcf\u0db8\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0db4\u0dd0\u0dad\u0dca\u0dd9\u0dad\u0db1\u0dca \u0dbd\u0db6\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0dd9\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0."
  },
