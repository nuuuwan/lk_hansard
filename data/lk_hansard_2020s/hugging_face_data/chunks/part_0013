0daf\u0db1 \u0dad \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0dca 442\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dcf \u0dcf\u0db1\u0dba\n\n\u0dc1\u0dc3\u0dae\u0dc0\u0d9a \u0dc3\u0dcf\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0 \u0dba\u0dcf\u0dad\u0da7\u0dc1\u0db8 20( (45)\u0d9a\u0dca \u0db6\u0db3\u0dc0\u0dcf \u0dad\u0d9a\u0db1\u0dd3 \u0da7 \u0d85 \u0db4/23/0822/605/012-III \u0dc4\u0dcf 2023 05 08 \u0daf\u0dd2\u0db1\u0d9a\u0dad\u0dd2\u0dc0 \u0d85 \u0dcf\u0dad\u0dba \u0da9\u0dd4\u0d9a\u0da9\u0dcf)\u0dbd \u0dad\u0dd3\u0dbb\u0dab\u0dba\u0dcf\u0dad \u0d9f\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0dc4 \u0dc0\u0dd2\u0dc1 \u0dae\u0dc2 \u0dc1\u0dc3\u0dae\u0dc0\u0d9a \u0dc3\u0dcf\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0 \u0dba\u0dcf\u0dad\u0da7\u0dc1\u0db8 100(\u0d9a\u0dca (397)\u0d9a\u0dca -\u0d89\u0dad\u0dd2\u0dbb\u0dd2 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dab\u0dba\u0dcf\u0dad- \u0db6\u0db3\u0dc0\u0dcf \u0dad\u0d9a\u0db1\u0dd3 \u0da7 \u0d85\u0dcf\u0d9a: DMS/CM/08/SLEAS \u0dc4\u0dcf 2024 04 19 \u0daf\u0dd2\u0db1\u0d9a\u0dad\u0dd2 \u0dd2\u0db4\u0dd2\u0dba\u0dcf\u0dad \u0d9f\u0dd2\u0db1\u0dca\u0dad \u0d9a \u0db1\u0dcf\u0d9a\u0dbb\u0dab \u0dc1\u0dc3\u0dae\u0dc0\u0dcf \u0dc1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc0\u0dd2\u0dd2 \u0db1\u0dca\u0dad \u0d85\u0db1\u0dd4 \u0d9a\u0dad\u0dd2\u0dba\u0dcf\u0dad \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0d87\u0dad\n\n\u2022 \u0dc0\u0dd2\u0dc0\u0dca\u0dad \u0db4\u0daf\u0db1 \u0dad \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0dca 113\u0d9a\u0dca \u0db6\u0db3\u0dc0\u0dcf \u0dad\u0d9a\u0db1\u0dd3 \u0da7\n\n\u0d85\u0dcf\u0d9a: DMS/CM/08/SLEAS \u0dc4\u0dcf 2024 04 19 \u0daf\u0dd2\u0db1\u0d9a\u0dad\u0dd2 \u0dd2\u0db4\u0dd2\u0dba\u0dcf\u0dad \u0d9f\u0dd2\u0db1\u0dca\u0dad \u0d9a \u0db1\u0dcf\u0d9a\u0dbb\u0dab \u0dc1\u0dc3\u0dae\u0dc0\u0dcf \u0dc1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc0\u0dd2\u0dd2 \u0db1\u0dca\u0dad \u0d85\u0db1\u0dd4 \u0d9a\u0dad\u0dd2\u0dba\u0dcf\u0dad \u0db