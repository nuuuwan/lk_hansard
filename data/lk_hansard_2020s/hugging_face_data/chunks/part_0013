    "chunk_text": "\u0d89\u0dad\u0dd2\u0db1\u0dca\u0dad\u0d8b \u0dc1\u0dda \u0d85\u0dba\u0dcf\u0dad \u0dc0\u0d9a\u0dc1\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0dc1\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0db1 \u0dd4\u0dc0\u0daf\u0dbd \u0d85\u0db4\u0dd2 \u0dba\u0dcf\u0dad \u0dcf\u0dbb\u0dca\u0dbd \u0dba\u0dcf\u0dad\u0d9a\u0dca \u0db6\u0dc0\u0da7 \u0db4\u0db8 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0dc1 \u0dcf\u0d9a\u0daf\u0d8b \u0d9c\u0dd2\u0dba\u0dcf\u0dad \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0dc1\u0dda \u0d85\u0dc1\u0db4\u0dca \u0d85 \u0dcf\u0dad\u0dba\u0dcf\u0dcf \u0dba\u0dcf\u0dad\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dda\u0db0\u0db1 \u0dc0\u0dd2\u0dba\u0dcf\u0dad\u0daf\u0dda \u0dc3\u0db3\u0dc4\u0dcf \u0dc1\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dd4\u0dc0\u0daf\u0dd2\u0db1\u0dca\u0dad \u0dd2 \u0dba\u0dcf\u0dad\u0dba\u0dcf\u0dad\u0da7 50\u0d9a\u0dca \u0dc0\u0dd2\u0dad\u0dbb \u0dad \u0dba\u0dd2 \u0d87\u0db8\u0dad\u0da7 \u0dc0\u0dd2\u0dba\u0dcf\u0dad\u0daf\u0dda \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad\n\n2873 2874\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0dc1\u0d9a\u0dcf\u0da7\u0d8b \u0d85\u0db4\u0dd2 \u0db4\u0dd4\u0db1\u0d9c\u0dd2\u0dba\u0dcf\u0dad \u0dcf\u0dc3 \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dc1\u0dda \u0dc1 \u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dc1 \u0dae \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0db1 \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf\u0dc0\u0db8 \u0dc1\u0dda \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1\u0dda\u0daf\u0dd3 \u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1\u0d8b \u0dad\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dd4 \u0db1\u0dd2 \u0dc1\u0dda \u0dcf\u0dc3 \u0dd4\u0db1 \u0dd4 \u0d85\u0db4\u0dd2 \u0dc0\u0dd2 \u0dcf\u0dbd \u0db4\u0dd2\u0dba\u0dcf\u0dad\u0dc0\u0dbb \u0dad\u0dab\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0d85\u0dbb\u0dc1\u0dad\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0dc1 \u0dcf\u0d9a\u0daf \u0d85\u0db4\u0dd2 \u0dc4\u0d9a\u0