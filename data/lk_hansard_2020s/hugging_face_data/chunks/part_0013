    "chunk_text": "\u0d85\u0db4\u0da7 \u0dad\u0d9a\u0dd2 , \u0da7 \u0da7 \u0d9a\u0dbd\u0dd2\u0db4\u0dad, 2023\u0daf\u0dd3 IMF \u0dc1\u0dba\u0ddd\u0dba\u0db1\u0d9c\u0dc0\u0dbd\u0dd2\u0dba\u0dca\u0dad \u0dc5\u0dd2\u0da7\u0dd2\u0dba\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dc0\u0dd4\u0db8\u0dca \u0dd0\u0d9c\u0dba\u0dd9 \u0dbb\u0daf\u0d9c\u0dba \u0dc0\u0dd2\u0da9\u0dd2 \u0d9a\u0dd0 \u0d9c\u0dd2\u0db1\u0dd3 \u0dcf\u0dc5\u0d9c \u0dda\u0db4\u0dba\u0db1 \u0dc0\u0dd2\u0da7 \u0dc1\u0d9c\u0dc0\u0dd3 \u0dc3 \u0db6\u0daf\u0dd4 \u0d85 \u0d9c\u0db1\u0d9c\u0dd0\u0dab \u0dc1\u0dbd \u0dc0\u0dc1 \u0ddd\u0db1\u0db1\u0dba\u0da7 \u0dbd\u0dca\u0dad \u0dc0\u0dd4\u0db8\u0dca \u0db6\u0dc0. \u0dc5\u0dd0 \u0db4\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4 \u0daf\u0dd2\u0db4\u0dad \u0dc1 \u0dad\u0dd2\u0db1 \u0d9a\u0dcf\u0d9c \u0d9a\u0dd0\u0db1\u0dc0\u0d9c, IMF \u0d91\u0d9a\u0da7 \u0d85\u0daf\u0d9c\u0dcf \u0d85\u0dba \u0dc0\u0dd2\u0dba \u0dc1\u0dba\u0ddd\u0dba\u0db1\u0d9c \u0dad \u0dd2 \u0d85\u0db4\u0dd2 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db4\u0dad\u0dc1\u0db4\u0dad \u0d9a\u0dd2\u0dba\u0dbd\u0d9c. \u0d92\u0d9a\u0da7 \u0dc1\u0dc5\u0ddc\u0dcf \u0dda\u0daf\u0d9c\u0dc5\u0dd0\u0dab\u0dba\u0dca\u0dad \u0dad \u0dd2 , IMF \u200d\u0dbb\u0dd2\u0dba\u0d9c\u0dc0\u0dbd\u0dd2\u0dc1\u0dba\u0db4\u0dad \u0d85\u0dba \u0dc0\u0dd2\u0dba \u0dc1\u0dba\u0ddd\u0dba\u0db1\u0d9c\u0dc0\u0dbd\u0da7 \u0dc1 \u0ddc\u0db1\u0dc0\u0d9c \u0d87 \u0dc3\u0dcf\u0dad\u0dca \u0dc0\u0dd4\u0dab\u0d9c \u0dc0\u0dd4\u0dab\u0dad\u0dca, \u0d92 \u0dc1\u0dba\u0ddd\u0dba\u0db1\u0d9c \u0dc3\u0dc5\u0dd2\u0db4\u0dad \u0d9c \u0d9c\u0db1\u0dd9 \u0dba\u0db1 \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dba\u0da7 \u0d87\u0dad\u0dd2 \u0dc0\u0db1 \u0db6\u0dbd\u0db4\u0dd1 \u0d85\u0dc0 \u0d9a\u0dd0 \u0d9c\u0dd2\u0db1\u0dd3 \u0dcf\u0dc5\u0d9c \u0dd0\u0dba\u0dba \u0db4\u0dd2\u0dad\u0dca\u0dc1\u0dad\u0db4\u0dad \u0dc1\u0d9c\u0dc1\u0db1\u0db1 \u0dc1\u0dba\u0ddd\u0dba\u0db1\u0d9c. 2023 \u0daf\u0dd3 \u0dc1 \u0dc3 \u0dc1\u0dba\u0ddd\u0dba\u0db1\u0d9c \u0d91\u0db1\u0dc1\u0d9a\u0ddc\u0da7, \u0dc1 \u0dc3 \u0dd0\u0dc1\u0da7\u0dca \u0db1\u0dc0\u0daf\u0dd9\u0dc0\u0dbb\u0dd4, \u0d89\u0dc0\u0da2\u0dd2\u0dc1\u0db4\u0dad\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4, \u0d9c\u0dab\u0d9a\u0d9c\u0db0\u0dd2\u0d9a\u0d9c\u0dbb\u0dd2\u0dc0\u0dbb\u0dd4 \u0d87 \u0dc3\u0dc5\u0dd4 \u0dc0\u0dd2\u0dc0\u0dd2\u0db1 \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0dba\u0db4\u0dad \u0d92 \u0d85 \u0d9c\u0db1\u0d9c\u0dd0\u0dab \u0db6\u0daf\u0dca\u0daf\u0da7 \u0d91\u0dc1\u0dd0\u0dd2\u0db4\u0dc0 \u0dc0\u0dd2 \u0d9c\u0dbd \u0dc5\u0dac\u0dca\u0dad \u0db1\u0dd2\u0d9f\u0dd4\u0dc0\u0d9c, \u0d85\u0db4\u0da7 \u0dad\u0d9a\u0dd2 . \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d92 \u0d9a\u0dd2 \u0dad \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0dc1\u0dba\u0dca\u0dad \u0d9a\u0dd2\u0dda\u0dc1\u0dda \u0db1\u0dd2\u0dc5\u0dd2, \u201c\u0d85\u0db4\u0dd2 \u0dbb\u0da9\u0dd4\u0d9a\u0dca\u0dc0\u0da7 \u0db6\u0daf\u0dd4 \u0dc1\u0d9c\u0dc0\u0db4\u0dad\u0db1 \u0dc3\u0dd6\u0daf\u0d9c\u0db1 \u0dc3 \u0db1\u0dd2\u0dc5\u0dd2\u201d \u0d9a\u0dd2\u0dba\u0dbd\u0d9c. \u0d94\u0dc0\u0dd4\u0db4\u0dad \u0d89\u0dbd\u0dca\u0dbd\u0dbb\u0dc0 \u0dc1\u0daf\u0dca \u0dad \u0dd2 , \" \u0d9c\u0db1\u0d9c\u0dd0\u0dab \u0db6\u0daf\u0dca\u0daf\u0dca\u0dad \u0d85\u0dba \u0d9a\u0dd0\u0db4\u0dad\u0db1, \u0d92 \u0dc0\u0d9c\u0dc1\u0dda \u0d85\u0dc1\u0db4\u0dca \u0db6\u0daf\u0dd4 \u0dc0\u0dd2\u0db1\u0dd2\u0dc0\u0dd2\u0daf\u0db7\u0d9c\u0dc0\u0dba\u0d9a\u0dd2\u0db4\u0dad \u0dd4\u0dad \u0dc3\u0dc0 \u0d9a\u0d9c\u0dbb\u0dca\u0dba\u0dca\u0dad\u0dc2\u0dca\u0da8 \u0dc1\u0dbd \u0dc0\u0dd2\u0dba \u0d9a\u0dd0\u0db4\u0dad\u0db1. \u0d92 \u0dc0\u0d9c\u0dc1\u0dda \u0db6\u0daf\u0dd4 \u0dc0 \u0dc1\u0dba\u0db4\u0dad \u0d9c\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc5\u0dba\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0daf\u0dd6\u0dc2\u0dca\u0da8\u0dab\u0dba\u0da7, \u0db1\u0d9c \u0dad\u0dd2\u0dad\u0dd2\u0dba\u0da7 \u0dc5 \u0dc0\u0dc0 \u0d9c\u0dc0\u0dbd\u0da7 \u0dbd\u0dca\u0dad \u0dc1\u0dc0\u0db4\u0dad\u0db1 \u0d89\u0da9 \u0dad\u0dd2\u0dba\u0db4\u0dad\u0db1 \u0d91\u0db4\u0d9c\" \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a. \u0d92 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db4\u0dad \u0d94\u0dc0\u0dd4\u0db4\u0dad \u0dc0\u0dc0\u0dd2\u0db1\u0d9c\u0db1\u0dba \u0dc0\u0dd4\u0dab\u0d9c. \u0da7 \u0dad\u0d9a\u0dd2 , Professionals' Trade Union Alliance \u0d9a\u0dd2\u0dba\u0dbd\u0d9c \u0dc0\u0dc0\u0dd2\u0db1\u0d9c\u0db1\u0dba\u0dca\u0dad \u0dc5\u0daf\u0dbd\u0d9c \u0dd0\u0dba\u0dba\u0dad\u0dca \u0d91\u0dca\u0dad\u0d9a \u0d9c\u0d9a\u0da0\u0dca\u0da1\u0d9c \u0d9a\u0dcf \u0db6\u0dc0. \u0dd0\u0dba\u0dba \u0dc1 \u0ddc\u0d9a\u0dca\u0dad\u0daf \u0d9a\u0dd2\u0dda\u0dc1\u0dda? \u0d85\u0db4\u0dd2\u0dad\u0dca \u0d91\u0dca\u0dad\u0d9a \u0d9c\u0d9a\u0da0\u0dca\u0da1\u0d9c \u0d9a\u0dd0\u0dbd\u0d9c \u0dc0\u0dd2\u0da9\u0dca\u0dad \u0db1\u0dd2\u0dc5\u0dd2, \u0dc1 \u0dc3\u0d9a IMF \u0d91\u0dc1\u0d9a\u0db4\u0dad \u0dc1\u0d9c\u0db1\u0d9c\u0dbb\u0dc0 \u0dc1\u0dba\u0ddd\u0dba\u0db1\u0d9c\u0dc0\u0dca\u0dad. \u0d92 \u0db1\u0dd2 \u0d9c IMF \u0d91\u0d9a\u0dad\u0dca \u0d91\u0dca\u0dad\u0d9a \u0d9c\u0d9a\u0da0\u0dca\u0da1\u0d9c \u0d9a\u0dd0\u0dbd\u0d9c \u0db6\u0daf\u0dd4 \u0d85\u0d9a\u0dca \u0d9a\u0dd0\u0db4\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0d9c \u0d9a\u0dd2\u0dda\u0dc0\u0d9c. \u0d91\u0dad\u0dc1\u0d9a\u0ddc\u0da7, \u0d9c\u0db1\u0d9c\u0dd0\u0dab \u0db6\u0daf\u0dca\u0daf\u0dca\u0dad \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db4\u0dad \u0d9a\u0da7\u0dd4\u0dad \u0dc3 \u0d9a\u0dd0\u0dbb\u0dc0, \u0dc5\u0dac \u0db1\u0d9f\u0dbb\u0dc0\n\n\u0dc1 \u0dd2\u0db4 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d85\u0db1\u0dd4\u0db4\u0d9c\u0dad \u0d9c\u0dd2\u0db1 \u0dc1 \u0dc3 \u0dc1\u0dc0\u0dbd\u0d9c\u0dc1\u0dda \u0d9a\u0dcf\u0d9c \u0d9a\u0dd0\u0db4\u0dad\u0db1\u0da7 \u0db6\u0dbd\u0d9c\u0dc1\u0db4\u0ddc\u0dc1\u0dd0\u0ddc\u0dad\u0dca \u0dc3 \u0dc1\u0dc0\u0db4\u0dad\u0dc1\u0db4\u0dad \u0db1\u0dd2\u0dc5\u0dd2. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0dc1 \u0dc3 \u0dc1\u0dc0\u0db1 \u0dc0\u0dd3 \u0db1\u0dd2 \u0d9c, \u0dc1 \u0dc3 \u0db6\u0daf\u0dd4 \u0dc5\u0db1\u0dba \u0dbd\u0dd2\u0db6\u0dd3 \u0db1\u0dd2 \u0d9c \u0dc5\u0dd0 \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd3\u0db4\u0dad \u0dc3\u0db6\u0db4\u0dad\u0db1\u0dc1\u0dba\u0db4\u0dad \u0dc1 \u0ddc\u0db1 \u0dc0\u0d9c\u0dc1\u0dda \u0dc5\u0db1\u0dba\u0dca\u0dad\u0daf \u0dbd\u0dd2\u0dc1\u0db6\u0db4\u0dad\u0dc1\u0db4\u0dad \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dc0\u0d9b\u0dca\u200d\u0dd9\u0d9c\u0dc1\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1 \u0d9a\u0dd2\u0dd2\u0db4\u0db4\u0dba\u0dca\u0dad \u0db1\u0dca\u0db4\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd0\u0db4\u0dad\u0db1 \u0d9a\u0dd2 \u0dd2\u0dad\u0dd2\u0dd2 . \u0dc1 \u0dc3 \u0d9c\u0dd2\u0db1 \u0d9a\u0dcf\u0d9c \u0d9a\u0dd0\u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0dc1 \u0dc3\u0d9a \u0dc5\u0dd0 \u0d9a\u0da9\u0dd4\u0da9\u0d9c\u0dba \u0dc3\u0dc0\u0dbd \u0dc0\u0dd2\u0dc1\u0dda \u0db1\u0dba\u0da7 \u0dbd\u0dca\u0dad\u0dc1\u0dc0\u0db4\u0dad\u0db1 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0da7 \u0dbb\u0dc0\u0dbb\u0dd4\u0daf\u0dd4 \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0dc1\u0dba\u0db4\u0dad \u0db4\u0da7\u0db4\u0dad \u0d9c\u0db4\u0dad\u0db1 \u0dc3. \u0dc0\u0dd2 \u0dc0\u0dc0\u0dd2\u0daf\u0dd9\u0d9c\u0dbd \u0dbb \u0d9c\u0dbb\u0dca\u0dba\u0dc0\u0dbb\u0dd4\u0db4\u0dad\u0da7 \u0dc1 \u0dc3 \u0db6\u0daf\u0dd4 \u0db6\u0dbd\u0db4\u0d9c\u0db4\u0dad\u0dc1\u0db4\u0dad \u0dc1\u0d9a\u0ddc\u0dc1\u0dc5\u0ddc \u0daf, \u0d92 \u0db6\u0daf\u0dd4\u0dc0\u0dbd\u0dd2\u0db4\u0dad \u0dc5\u0db1\u0dba \u0dbd\u0dd2\u0dc1\u0db6\u0db4\u0dad\u0dc1\u0db4\u0dad \u0dc1\u0d9a\u0ddc\u0dc1\u0dc5\u0ddc \u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0d9c \u0db8\u0dd4\u0dbd\u0dd2\u0db4\u0dad \u0d9a\u0dd2\u0dba\u0db4\u0dad\u0db1 \u0dc3."
