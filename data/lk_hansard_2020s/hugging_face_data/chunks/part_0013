    "chunk_text": "\u0d85\u0daf \u0d9a\u0da7\u0dd4\u0db1\u0dcf\u0dba\u0dcf\u0dad\u0d9a\u0d8b \u0dba \u0dba\u0dcf\u0dad\u0dad \u0d8b \u0dc1\u0d9a\u0dcf\u0d9a\u0dca\u0dad\u0dbd\u0d8b \u0dc3\u0dd3\u0dad\u0dcf\u0dc0\u0d9a \u0d85\u0db4\u0db1\u0dba\u0dcf\u0dad\u0db1 \u0dc3\u0d9a\u0d9a\u0dd4\u0db1\u0dda \u0d9a\u0dbd\u0dcf\u0db4\u0dc0\u0dbd \u0d89\u0da9\u0dcf)\u0dda \u0db1\u0d9a\u0dc4\u0d9a \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dc1\u0dda\u0dc1\u0d9a\u0dca \u0dc0\u0da7\u0dd2\u0db1\u0dcf \u0dc1\u0dda \u0dad \u0dba\u0dd2 \u0d89\u0da9\u0dcf)\u0dda \u0d85\u0dbd\u0dd4\u0db8 \u0dca\u0dc1\u0dba\u0dcf\u0dad\u0ddd\u0da2\u0d9a\u0dc1\u0dba\u0dcf\u0dad\u0d9a\u0dd4\u0da7 \u0d89\u0dad\u0dcf \u0dca\u0d9a\u0dbb\u0dca\u0dbd\u0dc2\u0dab\u0dd3\u0dba\u0dcf\u0dad \u0dc3\u0dae \u0dcf\u0db1\u0dba\u0dcf\u0dad \u0dad \u0dba\u0dd2 \u0dba \u0dcf\u0d9c\u0dd2\u0dbb\u0dd2\u0dba\u0dcf\u0dad \u0d85\u0db4\u0db1\u0dba\u0dcf\u0dad\u0db1 \u0dc3\u0d9a\u0d9a\u0dd4\u0db1\u0dda \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0dcf\u0dad \u0dc1\u0d9a\u0dcf \u0db9 \u0d89\u0db3\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dc1\u0dbd\u0ddd\u0db8\u0dd3\u0da7\u0dbb 80\u0dba\u0dd2\u0d8b \u0d9a\u0da7\u0dd4\u0db1\u0dcf\u0dba\u0dcf\u0dad\u0d9a \u0d89\u0daf\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dc1\u0dbd\u0ddd\u0db8\u0dd3\u0da7\u0dbb 50\u0dba\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dc1\u0dc4\u0dcf\u0db3 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dae\u0dd4\u0db1 \u0dc1\u0dda \u0db4\u0d9a\u0db8\u0dc1\u0db8 \u0d89\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad\u0d8b \u0db4\u0dcf\u0dad\u0dcf\u0dbd\u0dba\u0dcf\u0dad \u0d91\u0dc1\u0dc4 \u0db1\u0d9a\u0dc4\u0d9a \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dae\u0dd4\u0db1\u0db1\u0dca\u0dad\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0d9a\u0da9\u0dcf) \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0d8b \u0dc1\u0dca\u200d\u0dbb \u0dba\u0dcf\u0dad \u0dc1\u0dc3\u0dcf\u0dba\u0dcf\u0dad\u0dcf \u0dad\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0dad