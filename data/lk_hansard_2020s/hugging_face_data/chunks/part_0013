    "chunk_text": "\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dd6\u0db4\u0daa \u0dad\u0dbb\u0dd4 \u0db1\u0dca\u0dad\u0dd3\u0dd4 \u0db1\u0dd2\u0d8b \u0db1\u0dd2\u0dc1\u0dba\u0dcf\u0dad\u0ddd\u0da2\u0db1\u0dba\u0dcf\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dad\u0dcf\u0dca\u0dbd \u0daf\u0dd2\u0dc3\u0dae\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dcf\u0dad \u0dbb\u0db8\u0db1\u0db4\u0dd4\u0dbb\u0d8b \u0d9a\u0dc5\u0dd4\u0dad\u0dbb\u0d8b \u0d9a\u0dd1\u0dad\u0dca\u0dbd \u0dc0\u0dcf\u0dc1\u0dda \u0dbd\u0dcf\u0d9a\u0dcf\u0dc0 \u0db4\u0dd4\u0dbb\u0dcf \u0dad\u0dc0\u0db8 \u0daf\u0dd2\u0dc3\u0dae\u0dd2\u0d9a\u0dca\u0d9a \u0dad\u0dab\u0db1\u0dcf\u0dc0\u0d9a \u0dc1\u0db8 \u0dc0\u0dad\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dd6\u0db4\u0daa \u0dad\u0dbb\u0dd4 \u0db1\u0dca\u0dad\u0dd3\u0dd4 \u0db1\u0dd2\u0d8b \u0d94\u0db6\u0dd4 \u0dcf\u0dc1\u0dda \u0daf\u0dd2\u0dc3\u0dae\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dcf\u0dad\u0db8 \u0dc1\u0db8 \u0db1\u0dd2\u0dc2\u0dae\u0db4\u0dcf\u0daf\u0db1\u0dba\u0dcf\u0dad \u0d85\u0dad\u0dd2\u0db1\u0dca\u0dad \u0dad\u0db8\u0dad\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0daf\u0dd2\u0dc3\u0dae\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dcf\u0dad\u0d9a\u0dca \u0db1\u0dd4\u0dc0\u0db8 \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0dc1\u0db8 \u0d9a\u0dbb\u0dca\u0dbd \u0dcf\u0db1\u0dca\u0dad\u0dad\u0dba\u0dcf\u0dad\u0da7 \u0dc1 \u0dcf\u0d9a\u0d9a\u0dca\u0daf \u0d9a\u0dc1 \u0dae? \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0dc1\u0db8 \u0d9a\u0dbb\u0dca\u0dbd \u0dcf\u0db1\u0dca\u0dad\u0dad\u0dba\u0dcf\u0dad \u0dc0\u0dc3\u0dbb 10\u0d9a\u0dca \u0d87\u0dd4 \u0dad \u0dc1\u0dda\u0dad\u0dc1\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0dba \u0db3 \u0dc0\u0d9a\u0da7\u0dca\u0da7\u0dd4\u0dc0\u0dcf \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf\u0d8b 2012 \u0dc0\u0dcf\u0dc1\u0dda \u0d9a\u0dcf\u0dbd\u0dc1\u0dda \u0d9a\u0dd2\u0dc1\u0dbd\u0ddd \u0db8\u0dd2\u0dd2\u0dba\u0dcf\u0dad\u0db1 310\u0d9a\u0dca \u0d8