    "chunk_text": "\"\u0dc1\u0db1\u0db1 \u0dae\u0dcf\u0dbd\u0dc3\u0dd3\u0db1\u0dcf\u0dc1\u0dc0\u0dca\u0daf\u0dd3 (\u0da2\u0db1\u0dad\u0dcf \u0dc0\u0dd2\u0db8\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc1\u0db4\u0dbb\u0db8\u0dd4\u0dab \u0dc4\u0dd0\u0dbb\u0dd4\u0dab\u0dd4 \u0dc0\u0dd2\u0da7) \u0d85\u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dad\u0dc2 \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1 \u0dae\u0dab\u0dca\u0da9\u0dcf\u0dba\u0dda\u0dc0\u0dbd \u0db4\u0dd4\u0dda\u0d9c\u0dbd\u0dba\u0dd2\u0db1\u0dca\u0dad\u0daf \u0dae\u0da9\u0dcf\u0dae\u0dda\u0db4\u0dbd\u0dca\u0dae\u0dcf\u0dbb\u0dd3\u0db1\u0dca\u0dad \u0db1\u0dbb\u0dca\u0dbd\u0daf\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dda \u0db8\u0dd4\u0dc0\u0dcf\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0dd2\u0dbb\u0d82\u0dc3\u0dcf \u0dd3\u0da9\u0dcf\u0dc0\u0dbd\u0da7 \u0d89\u0dbd\u0d9a\u0dca\u0dad\u0dae \u0dc0\u0db1 \u0db6\u0dc0\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dd2 \u0dbd\u0dd0\u0db6\u0dd3\u0db1 \u0d91\u0db1\u0dca\u0dad\u0da7 \u0d91\u0db1\u0dca\u0dad\u0da7\u0db1 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd2\u0dba. \u0d91\u0db6\u0db3\u0dd4 \u0db4\u0dd0\u0dc4\u0dd0\u0dbb\u0dc1\u0d9c\u0db1 \u0dba\u0dd1\u0dda/\u0d85\u0dd4\u0dbb\u0dd4\u0daf\u0dc4\u0db1\u0dca\u0dad\u0dc0\u0dd3\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc1\u0dba\u0db1\u0dca\u0dad \u0d91\u0dc0\u0dae\u0da7 \u0db4\u0dd0\u0dc0\u0dd2 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dad\u0dc2\u0dc1\u0dda \u0db1\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dbb\u0dd4 \u0dc1\u0db6\u0dcf\u0dc1\u0dc4\u0ddd \u0d85\u0dc0\u0dc3\u0dca\u0dcf\u0dcf\u0dc0\u0dbd\u0daf\u0dd3 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc1\u0dc0\u0dca\u0daf\u0dd3 \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1 \u0dae\u0dc5 \u0db6\u0dc0 \u0dc3\u0dcf\u0d9a\u0dca\u0dad\u0dd2\u0dc0\u0dd2\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0dd0\u0dc0\u0dd2\u0dab. \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0dc1 \u0ddd\u0daf\u0db1\u0dcf\u0dc0 \u0dc0\u0dd6\u0dc1\u0dda \u0dad\u0db1 \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1 \u0dc0\u0dd2\u0dbb\u0dd4\u0dda\u0db0\u0dc0\u0dcf\u0daf\u0dd3\u0db1\u0dca\u0dad\u0dc1\u0d9c\u0db1\u0dca\u0dad '\u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca\u0dc0\u0dd3\u0db1\u0da7' \u0dbb\u0da2\u0dc1\u0dda \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1\u0da5\u0dba\u0dd2\u0db1\u0dca\u0dad \u0dc1\u0db4\u0dcf\u0dd2\u0dc3\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0db4\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0dae\u0dbb\u0db1 \u0db6\u0dc0\u0dba.\u0daf\n\n463 464\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0dc1\u0dda \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dae\u0dbb\u0db4\u0dd4 \u0d85\u0db4\u0dbb\u0dcf\u0db0 \u0dc1\u0dc4\u0dc5\u0dd2\u0daf\u0dbb\u0dc0\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db1 \u0dad\u0db1\u0dba\u0dd2 \u0d85\u0dc1\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db1 \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad. \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0dae\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0dae\u0dd4\u0db1\u0db1\u0dd2, \u0d85\u0db4\u0dd2 \u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0dae\u0dbb\u0db1\u0dc0\u0dcf, \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dc1\u0dda\u0daf\u0dd3 \u0db1\u0dd2\u0dba\u0db1 \u0d85\u0db4\u0dbb\u0dcf\u0db0\u0dae\u0dcf\u0dbb\u0dba\u0dd2\u0db1\u0dca\u0dad \u0dc1\u0dc3\u0dcf\u0dba\u0dbd\u0dcf \u0dba \u0dd2\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dc1\u0dda \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0da7 \u0d85\u0dc0 \u0dba \u0daf\u0dac\u0dd4\u0dc0\u0dda \u0dbd\u0db6\u0dcf \u0dc1\u0daf\u0db1\u0dca\u0dad\u0db1.\n\n\u0db1\u0da7 \u0dc1\u0dda \u0dc0\u0dd2\u0dc0\u0dcf\u0daf\u0dba\u0da7 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc0\u0dd3\u0db1\u0da7 \u0dbd\u0dd0\u0db6\u0dd3\u0db1 \u0dc0\u0daf\u0dc1\u0dc0\u0ddd\u0db4\u0d9c\u0dad \u0dc3\u0dd2\u0dda\u0db0\u0dd2\u0dba\u0d9a\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db1\u0db1 \u0dae\u0dbd\u0dca\u0db4\u0db1\u0dcf \u0dae\u0dbb\u0db1\u0dc0\u0dcf. \u0d92\u0dc1\u0d9c\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0dad \u0dc1\u0dda\u0dc0\u0dcf\u0da7 \u0d9a\u0dd2\u0dc0\u0dca\u0dc1\u0dc0\u0dca \u0daf\u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dd2\u0dc3\u0dc4\u0d9c\u0dad \u0db1\u0dd4\u0dc0\u0dc2\u0dba \u0d9d\u0dcf\u0dad\u0db1\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0da9 \u0dbd\u0dc3\u0dca \u0dd3\u0dbb\u0dd2\u0dc3\u0dca \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc1\u0dba\u0db1\u0dca\u0dad \u0db4\u0dc5\u0dc1\u0dc0\u0dbd\u0dcf \u0dd2\u0dc1\u0db6\u0db1 \u0dc1\u0dae\u0dcf\u0da7\u0dc1\u0dc3\u0dca \u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf, \u0dc1\u0dda\u0dc1\u0d9c\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0dad \u0da9 \u0dbd\u0dc3\u0dca \u0dd3\u0dbb\u0dd2\u0dc3\u0dca\u0dbd\u0dcf \u0dc0\u0dcf\u0dc1 \u0dc1\u0db4\u0dcf\u0dd2\u0dc3\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0db4\u0dad\u0dca \u0dae\u0dc1\u0dc5\u0dca \u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dd2\u0dc3\u0dc4\u0d9c\u0dad \u0db1\u0dd4\u0dc0\u0dc2\u0dba \u0d9d\u0dcf\u0dad\u0db1 \u0dbd\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dd4\u0dc0\u0da7 \u0d87\u0dd4\u0dc5\u0dad\u0dca \u0dae\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d92 \u0dae\u0dcf\u0dbd\u0dc1\u0dda \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0dd2\u0dae \u0dc0\u0dc0\u0daf\u0dba \u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd\u0dba\u0da7 \u0d91\u0dc1\u0dbb\u0dd2\u0dbb\u0dc0 \u0dc0\u0dc0\u0daf\u0dba\u0dc0\u0dbb\u0dd4, \u0dc0\u0dc0\u0daf\u0dba \u0dc1\u0dd2\u0dc2\u0dba\u0dc1\u0dba\u0ddd, \u0dc1\u0dda \u0dbb\u0dc1\u0dda \u0db8\u0dd4\u0dc5\u0dd4 \u0dc1\u0dd2\u0dc2\u0dba \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dc0\u0db1 \u0d8b\u0dda\u0dc1\u0d9d\u0ddd\u0dc2\u0dab\u0dba \u0dae\u0dc5\u0dcf. \u0dbb\u0dcf\u0da2\u0dba \u0dc1\u0dc3\u0dca\u0dc0\u0dae\u0dc1\u0dba\u0d9a\u0dca\u0dad \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0d92 \u0d8b\u0dda\u0dc1\u0d9d\u0ddd\u0dc2\u0dab\u0dba\u0da7 \u0dc3\u0dc4 \u0dcf\u0dd2 \u0dc0\u0dd4\u0dab\u0dd4 \u0db1\u0dcf\u0dc0\u0dad\u0dca \u0d92 \u0d9d\u0dcf\u0dad\u0db1 \u0dbd\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dd4\u0dc0\u0da7 \u0d87\u0dd4\u0dc5\u0dad\u0dca \u0dae\u0dbb\u0dbd\u0dcf \u0dd2\u0db6\u0dd4\u0dab\u0dcf. 1989 \u0d94\u0d9a\u0dca\u0dad\u0dc1\u0dad\u0ddd\u0db6\u0dbb\u0dca\u0dbd \u0db1\u0dcf\u0dc3\u0dc1\u0dda 04\u0dc1\u0dc0\u0db1\u0dd2 \u0daf\u0dcf \u0dbb\u0dcf\u0dd2\u0dc1\u0dda \u0db1\u0db1 \u0dd2\u0dbb\u0da7\u0dd2\u0dc1\u0dda \u0d85\u0dd4\u0dc0\u0dbb\u0dcf\u0db0\u0db4\u0dd4\u0dbb \u0db1\u0dc4 \u0dc1\u0dbb\u0ddd\u0dc4\u0dc1\u0dbd\u0dca \u0d85\u0dc1\u0dda \u0db1\u0dd2\u0dbd \u0db1\u0dd2\u0dc0\u0dcf\u0dc3\u0dba\u0dae."
  },
