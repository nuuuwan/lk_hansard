    "chunk_text": "\"\u0d85\u0db4\u0dd2 \u0d9a\u0dcf\u0da7\u0dc0\u0db8 \u0db6\u0dba\u0dcf\u0dad \u0db1\u0d9a\u0dc4\u0d9a\u0d8b \u0d9a\u0dcf \u0da7\u0dc0\u0db8 \u0db1\u0d9a\u0dc1 \u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad\u0db8 \u0db1\u0d9a\u0dc4\u0d9a\u0d8b \u0d9a\u0dcf\u0dc1\u0dad\u0dc0\u0db8 \u0dc3\u0dcf\u0d9a\u0dca\u0d9a\u0dd4\u0dc0\u0dbd\u0da7 \u0dc0\u0d9a\u0dc1\u0da7\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad\u0db8 \u0db1\u0d9a\u0dc4\u0d9a \u0d85\u0db4\u0da7 \u0db6\u0dbd\u0dba\u0dcf\u0dad \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0d85\u0db4\u0dd2 \u0d92 \u0db6\u0dbd\u0dba\u0dcf\u0dad \u0d85\u0dc0 \u0dba \u0d85\u0dc0\u0dc3\u0dae \u0dcf\u0dc1\u0dda\u0daf\u0dd3 \u0db4\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0dc3\u0dad\u0dd2\u0dba\u0dcf\u0dad\u0d9a\u0dca \u0dc1\u0daf\u0d9a\u0d9a\u0dca \u0d87\u0dd4 \u0dad \u0db6\u0dbd\u0dcf\u0dad\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0d85\u0db4\u0dd2 \u0dc1 \u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0dbd\u0dcf \"\n\n\u0dad\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dd4 \u0db1\u0dd2\u0d8b \u0dc1\u0dda \u0dc0\u0dcf\u0dc1\u0dda \u0d85\u0dc0\u0dc3\u0dae \u0dcf\u0dc0\u0dbd\u0daf\u0dd3 \u0dd2 \u0daf\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dc1 \u0dcf\u0d9a\u0d9a\u0dca\u0daf \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf \u0db4\u0dd4\u0db1\u0d9c\u0dd2\u0dba\u0dcf\u0dad \u0d85\u0dba\u0dcf\u0dad \u0dc0\u0d9a\u0dba\u0dcf\u0dad \u0dc0\u0dd2\u0dc0\u0dcf\u0daf\u0dba\u0dcf\u0dad \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1\u0dda \u0dc1\u0dbb\u0dcf\u0dc2\u0dcf\u0db1\u0dca\u0dad \u0dbb\u0dab\u0dd2 \u0dcf\u0dc4 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf)\u0dcf \u0dca \u0dad\u0dba\u0dd4 \u0dcf\u0da7 \u0d85 \u0dcf\u0dad\u0dba\u0dcf\u0dcf \u0dba\u0dcf\u0dad \u0daf\u0dd3\u0dbd\u0dcf \u0dc1\u0dad\u0daf\u0dbb \u