    "chunk_text": "\u0dd2\u0dbd\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1\u0dba\u0dca 2\u0dd2\u0dca\u0d9c\u0dc2\u0dd2\u0d9a2 \u0dc1\u0db8\u0dca \u0d9a\u0dd2 \u0dc1\u0dda\u0daf\u0dd3 -\u0db8\u0dd2\u0dca\u0d9c\u0dad\u0dd4 \u0db8\u0dd2\u0dc3\u0dc1\u0dda\u0daf\u0dd3- \u0dc1\u0db4\u0ddc\u0daf\u0dd4\u0dc1\u0dda \u0dc1\u0d9c\u0ddc\u0dd2\u0dbd\u0dba\u0dd2\u0da7 \u0d91\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0db1 \u0dc3\u0db3\u0db1\u0dd2 \u0dc0\u0dd6 \u0dc1\u0d9a\u0dd2\u0dad \u0d9a\u0dd2\u0dbd\u0dd3\u0db1 \u0d8b\u0dad\u0dca\u0dad\u0dba \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba [ \u0d9c\u0dc0 \u0db8\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dc1 \u0dc1\u0dba\u0ddd\u0db1\u0db1\u0dd22 \u0dad\u0dd4\u0dc5 \u0dad\u0dd2\u0db6\u0dd4\u0da7\u0dd2. \u0d91\u0d9a [ \u0dad\u0db8\u0dba\u0dd2 \u0db6\u0daf\u0dd4 \u0db4\u0dd0\u0db1\u0dc0\u0dd3\u0db8. \u0dc1 2\u0dd0\u0db1\u0dd2 \u0d9a\u0dd2\u0dba\u0da7\u0dba \u0dad\u0db8\u0dba\u0dd2 \u0db4\u0dd2\u0da7 \u0dba\u0dd2\u0dad\u0dca \u0d85 \u0dc1\u0d9c\u0dca \u0dc0\u0dd3\u0db8 \u0db1\u0dd02\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0db8. \u0dd2\u0dbd\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1\u0dba\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dd2\u0dc1 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0db1\u0dba \u0d87\u0dad\u0dd4\u0dc1\u0dc5\u0dda \u0db1\u0dd42\u0dba\u0d91\u0dc5\u0dd2\u0dba \u0db6\u0daf\u0dd4\u0dca \u0dc3\u0db1 \u0db6\u0dab\u0dca\u0da9\u0dd2\u0dba\u0dc12 \u0dbb\u0dd2\u0dc3\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dd2 [\u0d9a \u0dc3\u0db8\u0dca\u0db6\u0dca \u0db0\u0dc1\u0dba\u0dca 2\u0dd0\u0da9\u0dd2\u0dc1\u0dba\u0dca \u0d9a\u0dc0 \u0dab\u0dd4 \u0db8\u0dad\u0dd4 \u0d9a\u0dba \u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db12\u0dd2. \u0db1\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d9c\u0dc0 \u0db8\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db6\u0db6\u0dad\u0dd4\u0db8\u0dd2 \u0dca \u0db12\u0dd2 \u0d9a\u0dd2\u0dba \u0dd2 \u0db8\u0db8 \u0dca \u0dc1\u0dca \u0db1\u0dd0\u0db1\u0dd0 \u0d8b\u0dad\u0dd4\u0dc0 \u0db4\u0dc5\u0dd2\u0dc1\u0dad\u0dca \u0dba\u0dd2\u0db4\u0db1\u0dba \u0dbb\u0dd2\u0dc3\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dd2 [\u0d9a\u0dc1\u0dda\u0dad\u0dca \u0d85 \u0db1\u0dd2\u0dc2\u0dca\u0da8\u0dcf\u0db4\u0dd2 \u0db1\u0dba \u0dc3\u0db3\u0db1\u0dd2 \u0dc3\u0dd0 \u0d9a\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db8\u0da7\u0dca\u0da7\u0db8\u0d9a\u0dd2\u0dca \u0dc1\u0d9c\u0ddc\u0dd2\u0dbd \u0db1\u0db1\u0dad\u0dd22 \u0db8\u0dd0\u0dbb\u0dd2\u0db1\u0dad\u0dca \u0dc12\u0db1 \u0db62.\n\n\u0d9c\u0dc0 \u0d9a\u0dcf\u0dd2\u0db1\u0dd2\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dd2\u0dbd\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1\u0dba\u0dca \u0db8 \u0db8\u0db8 \u0dc1\u0db8\u0dca \u0dc3\u0db7\u0dd22 \u0dd0\u0db1\u0dd42\u0dad\u0dca \u0d9a\u0dba\u0dca \u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dd2 \u0d85\u0dc1\u0dda \u0dba \u0dc1\u0da7\u0dca \u0dba\u0db8\u0dca \u0dad\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0da7\u0dba [ \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db32. \u0db1\u0db1\u0dc1\u0dca \u0d9b\u0dca\u200d\u0db1 \u0db1\u0dd2 \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dd2\u0dc1\u0dca \u0d9b\u0dca\u200d\u0db1 \u0dc1 \u0db4\u0dd2\u0dca\u0d9c\u0dad\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd4\u0dc1\u0dda \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d82\u0d9a\u0dd2 \u0dc1\u0dca\u0d9c\u0dd4\u0dc0\u0dc1\u0dda \u0dc3\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d82\u0d9a\u0dd2 \u0db8\u0db1 \u0db6\u0dd0\u0d82 \u0db4\u0dc1\u0dda \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dd2\u0dc1\u0dca \u0d9b\u0dca\u200d\u0db1 \u0d85\u0db1\u0dd42 \u0dc1\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0d85 \u0db4\u0db4\u0dad\u0dc1\u0db7\u0ddd\u0db1\u0db1\u0dba \u0dc3\u0db8\u0dca\u0db6\u0dca \u0db02 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dc4\u0dd2\u0d9f\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db32 2\u0dc3\u0dba \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a \u0d9a\u0dc0 \u0dab\u0dd4 \u0db8\u0db8 \u0dc1\u0db8\u0dca \u0dc3\u0db7\u0dd22\u0da7 \u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0db4\u0dad\u0dca \u0d9a\u0dba\u0dca \u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dd2. \u0dc1\u0db4\u0ddc\u0daf\u0dd4\u0dc1\u0dda \u0d9c\u0dad\u0dca\u0dc1\u0d