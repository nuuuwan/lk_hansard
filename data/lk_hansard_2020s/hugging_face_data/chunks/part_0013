    "chunk_text": "\u0d91\u0d9a\u0dad\u0dd4 \u0db8\u0dca\u0da7\u0dd2 \u0db1\u0db8\u0dca \u0d91\u0db8 \u0dd0\u0dba\u0dd2\u0db8\u0dca \u0d9a\u0dd2\u0db8\u0dba\u0dba\u0da7 \u0dba\u0dd2\u0da7\u0dca \u0dd0\u0db6\u0dd4\u0dab\u0dd4 \u0d91\u0d9a \u0dd2\u0dbd\u0dad\u0dba\u0dba\u0dd2 \u0d9c\u0dc0 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2 \u0dd2\u0dc0\u0daf\u0dd4 \u0db8\u0dca\u0dc1\u0dab\u0dca. \u0da7 \u0d85\u0dba \u0dad2\u0db8\u0dad\u0dca \u0db4\u0dd3\u0dca \u0dc1 \u0dca \u0db1\u0dd2\u0dca \u0dc1\u0dca ; \u0db4\u0dd3\u0dca \u0dc1 \u0dca 2\u0dad\u0dd4\u0dba \u0dc1\u0db6\u0ddc\u0dca \u0dc1\u0dca . \u0da7\u0d9a \u0dd0\u0dba\u0dd2\u0dc1\u0db8\u0dca \u0d9a\u0dd2\u0db8\u0dba\u0dba\u0d9a\u0da7 \u0dc1\u0d9a\u0ddc\u0da7\u0dd4 \u0db8\u0dca\u0dab\u0dd4 \u0db4\u0da7\u0dd4\u0db8\u0dca\u0db7\u0dba [. \u0dc0 \u0dc12\u0ddd \u0dad\u0dd4\u0dca \u0db1\u0dad\u0dba\u0dc1 \u0db1\u0dd2 \u0d91 [\u0d9a \u0d91\u0d9a \u0d9a\u0dd2\u0db8\u0dba\u0dba\u0d9a\u0da7 \u0dc1\u0d9a\u0ddc\u0da7\u0dd4 \u0db8\u0dca\u0dab\u0dd4 \u0da2\u0dd3\u0dd2\u0dbd\u0dad\u0dba [ \u0dad\u0db8\u0dba\u0dd2 \u0da7 \u0d85\u0dba \u0d9c\u0dad \u0d9a\u0dba\u0dca \u0dc1\u0dca . \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dd2 2\u0dd0\u0dd2\u0dbd\u0dbd\u0dd2 \u0dc3\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dd2 \u0dba\u0dd2\u0dad\u0dad \u0db4\u0db1\u0dd4\u0d9a\u0d9a\u0db8\u0dca \u0d85\u0db8\u0dd2\u0dad\u0dba\u0dd2\u0d82 \u0dba \u0dad\u0dd4\u0dc5\u0dd2\u0dca \u0db6\u0db6\u0dad\u0dd4\u0db8\u0dca \u0dd2 \u0da7 \u0dd0\u0dba\u0dd2\u0db8\u0dca \u0d9a\u0dd2\u0db8\u0dba\u0dc1\u0dba\u0dca \u0d91\u0db1\u0dd2 \u0d9c\u0dd2\u0dba \u0da2\u0dd3\u0dd2\u0dbd\u0dad\u0dba [ \u0d9a\u0db3\u0dd4\u0d9a\u0dba\u0dc1\u0dda \u0dd2\u0dca \u0db1 \u0d85\u0dc1\u0dda \u0dba\u0da7\u0da7 \u0dc1\u0da9\u0ddc \u0dca\u0d9c \u0dc1\u0d9c\u0dc1\u0db1\u0dca \u0db1 \u0dd2\u0dba\u0d9a 2\u0db1 \u0d85\u0dc1\u0dda \u0d86 \u0dba\u0dab\u0dd3\u0dba \u0db1\u0db1\u0dad\u0dd22\u0da7 \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dba \u0dd2 \u0dc1 \u0dca \u0db1\u0dad\u0d