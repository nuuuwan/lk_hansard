    "chunk_text": "\u0dc0\u0db8 \u0db1\u0dca\u0dad \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dc1\u0dda \u0dad\u0dbb\u0dd4 \u0d85\u0d9c\u0dca\u200d\u0dbb\u0dcf \u0dcf\u0dad\u0dba\u0dd4\u0db8\u0dd2\u0dba\u0dcf\u0dad \u0dc3\u0db4\u0dcf\u0db0\u0dd2\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dad\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb \u0dae\u0db1\u0dba\u0dcf\u0dad\u0da7 \u0dbd\u0db6\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0dd4\u0dbb \u0d85\u0dc4\u0dc1\u0dad\u0db1 \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf\u0dad\u0dcf \u0d92 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf\u0dc0\u0da7 \u0db8 \u0d91\u0d9a \u0dba\u0dd2 \u0dc1 \u0dcf\u0d9a\u0daf\u0d8b \u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0dc3\u0db4\u0dcf\u0db0\u0dd2\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dad\u0da7 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0dcf \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0dc1\u0dda\u0daf\u0dd3 \u0db1\u0dd2\u0dba\u0dcf\u0dad \u200d\u0dbb \u0dba\u0dcf\u0dad\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1 \u0db4\u0dd4\u0db1\u0d9c\u0dd2\u0dba\u0dcf\u0dad \u0d9a\u0dcf\u0dbd\u0dc1\u0dda \u0db6\u0d9a\u0dd2 \u0dca \u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0dc4\u0db8 \u0dba\u0dcf\u0dad\u0dcf \u0dc3\u0db4\u0dcf\u0db0\u0dd2\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dad\u0da7 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0dad\u0db1\u0dcf \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dc1\u0dda\u0dc1\u0dd3\u0dba\u0dcf\u0dad \u0dc1\u0dca\u0d9a\u0dda \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dcf\u0dad\u0dcf\u0dbd\u0dc0\u0dbd \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0dcf\u0dc0\u0da7 \u0d9c\u0dd2\u0dba\u0dcf\u0dad\u0dcf \u0d92 \u0d85\u0dba\u0dcf\u0dad\u0da7 \u0dc0\u0dcf\u0da9\u0dd2 \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0db1\n\n2853 2854\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0d8a \u0da7 \u0dad\u0dbb\u0dd4 \u0d87 \u0dad\u0dd2\u0dd4 \u0dcf\u0dc1\u0dda \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba\u0dcf\u0dad\u0da7 \u0dc1