    "chunk_text": "\u0d8a\u0dcf\u0d9f\u0da7, \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dbb\u0dca\u0dd2\u0d9a\u0d9a \u0dc1 \u0ddc\u0da9\u0dbd\u0dba \u0d9c\u0dd2\u0db1\u0dad\u0dca \u0dc1\u0d9c\u0ddc\u0da9\u0dca\u0dad \u0d85\u0dba \u0d85\u0dc5\u0db1 \u0db1\u0dd2 \u0d9c \u0da7 \u0d92 \u0d9c\u0dd2\u0db1\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0db4\u0dad\u0db1 \u0d85\u0daf\u0dc5 \u0dca\u0dad \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0dc1 \u0dc3 \u0d9a\u0d9c\u0dd0\u0dab\u0d9c \u0dc3\u0db1 \u0d9c\u0dd2\u0db1 \u0dbd\u0d9a\u0d9c \u0db6\u0dbd\u0d9c \u0dad \u0dd2 \u0d85\u0db4\u0dd2 \u0d9a\u0dcf\u0d9c \u0d9a\u0dc1\u0dcf . \u0d92 \u0d9a\u0dd2\u0dba\u0db4\u0dad\u0dc1\u0db4\u0dad, \u0d93\u0dad\u0dd2\u0dc5\u0d9c \u0dad\u0d9a \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba, \u0d92 \u0dc1 \u0ddc\u0dc1\u0dc5\u0ddc\u0dc1\u0dad\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0dc0\u0d9c \u0dad\u0dc0\u0dd2\u0d9a \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0dc5 \u0dc0\u0dd2\u0dd4\u0dad\u0dca\u0dad\u0dad\u0dc0 \u0db1\u0dd2\u0dad\u0dd2\u0dc0 \u0dc0\u0dd4\u0dad\u0dca\u0dad\u0dad\u0dc0 \u0d9a\u0dbb\u0dd4\u0db8\u0dca \u0d85\u0dd0\u0dc1\u0d9c\u0db1 \u0dad \u0dd2 \u0d85\u0db4\u0dd2 \u0d9a\u0dcf\u0d9c \u0d9a\u0dc1\u0dcf . \u0d8a\u0da7 \u0d85 \u0dad\u0dd0\u0dc0 \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dbb\u0dca\u0dd2\u0d9a\u0d9a \u0dc1 \u0ddc\u0da9\u0dbd\u0dba \u0d9c\u0dd2\u0db1 \u0dc1\u0d9a\u0ddc\u0da7 \u0dc3\u0db1\u0d9a\u0dd2\u0db4\u0dad \u0d9a\u0dcf\u0d9c \u0d9a\u0dd0\u0db1\u0dc0\u0d9c. \u0db1\u0dd2\u0dc2\u0dca\u0da8 \u0db4\u0d9c\u0daf\u0db1 \u0dbb\u0dbb\u0dca\u0dd2\u0d9a\u0d9a\u0dba\u0dca\u0dad \u0dc1\u0d9c\u0ddc\u0da9 \u0db1\u0dd2\u0d9f\u0dd3 ,\n\n\u0d9c\u0dbb\u0dd4 \u0db7\u0d9c\u0db4\u0dad\u0dd2 \u0dc3 \u0db1\u0dd2, \u0d92 \u0dc0\u0d9c\u0dc1\u0dda \u0db1\u0dd2\u0dc2\u0dca\u0da8 \u0db4\u0d9c\u0daf\u0db1 \u0dbb\u0dbb\u0dca\u0dd2\u0d9a\u0d9a\u0dba\u0dca\u0dad \u0dc1\u0d9c\u0ddc\u0da9 \u0db1\u0d9f\u0db4\u0dad\u0db1 \u0d85\u0db4\u0dd2 \u0dca\u0dad\u0dc2\u0dd4\u0daf\u0dca\u200d\u0dbb, \u0d9a\u0dd4\u0da9\u0d9c \u0dc5\u0d9c \u0db1\u0dd9 \u0db4\u0dbb\u0dd2 \u0d9c\u0dab \u0dc0\u0dd9\u0d9c\u0db4\u0d9c\u0dd0 \u0d85\u0dc0 \u0dba\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 20,000\u0dca\u0dad \u0dc1\u0dc0\u0db4\u0dad \u0d9a\u0dd0 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0db6\u0dbd \u0dca\u0dad\u0dad\u0dd2 \u0dca\u0dad\u0dc1\u0dc2\u0dca\u0da8 \u0dad\u0dca\u200d\u0dbb\u0dba\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 21,142\u0dca\u0dad \u0dc1\u0dc0\u0db4\u0dad \u0d9a\u0dd0 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d9a\u0dbb\u0dca \u0d9c\u0db4\u0dad\u0dad \u0dc0\u0dc0\u0dbb\u0dca\u0db1\u0db1\u0dba \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db4\u0dad \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 10,955\u0dca\u0dad \u0dc1\u0dc0\u0db4\u0dad \u0d9a\u0dd0 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d85\u0db4\u0dad\u0db1 \u0d91\u0dc1\u0dc5 \u0dad \u0dd2 \u0d85\u0dc1\u0db4\u0dca \u0dc1 \u0dc3 \u0d85\u0dba \u0dc0\u0dd2\u0dba \u0d87 \u0dc3\u0dc1\u0dcf \u0db1\u0dd2\u0dc2\u0dca\u0da8 \u0db4\u0d9c\u0daf\u0db1 \u0dbb\u0dbb\u0dca\u0dd2\u0d9a\u0d9a\u0dba \u0dc1\u0d9c\u0ddc\u0da9 \u0db1\u0d9f\u0db4\u0dad\u0dc1\u0db4\u0dad. \u0d9c\u0dbb\u0dd4 \u0db7\u0d9c\u0db4\u0dad\u0dd2 \u0dc3 \u0db1\u0dd2, \u0dbb\u0dbb\u0dca\u0dd2\u0d9a\u0d9a\u0dba \u0dba\u0db1\u0dad\u0d9c\u0dc0\u0da7 \u0db6\u0daf\u0dca\u0db1 \u0d9a\u0dd0\u0db4\u0dad\u0db1 \u0d85\u0db4\u0dd2 \u0db0\u0dd3\u0dc0\u0dd0 \u0d9a\u0dbb\u0dca \u0d9c\u0db4\u0dad\u0dad\u0dc1\u0d86 \u0dbb\u0dc0\u0db1\u0dbb\u0dca\u0da2\u0dd3\u0dc0\u0db1\u0dba \u0dcf\u0dc5\u0d9c \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 3,000\u0dca\u0dad, \u0dc0\u0dd2\u0dc0\u0dd2\u0dbd\u0dd2 \u0dc0\u0dc0\u0dbb\u0dca\u0db1\u0db1\u0dba\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 9,565\u0dca\u0dad, \u0d85\u0dad\u0dc5\u0dd2\u0dd0 \u0daf\u0d9c\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d9a\u0dbb\u0dca \u0d9c\u0db4\u0dad\u0dad \u0d9c\u0dbd\u0d9c \u0db1\u0dd2\u0dc0\u0dad \u0d85\u0dd0\u0db9\u0db4\u0dad\u0db1 \u0d9a\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca \u0dc0\u0dc0\u0dbb\u0dca\u0db1\u0db1\u0dba\u0da7 \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 113,524\u0dca\u0dad \u0dc1\u0dc0\u0db4\u0dad \u0d9a\u0dd0 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c, \u0d85\u0dc1\u0db4\u0dca \u0dd0\u0dc1\u0da7\u0dca \u0dbb\u0dbb\u0dca\u0dd2\u0d9a\u0d9a\u0dba\u0da7 \u0dba\u0db1\u0dad\u0d9c\u0dc0 \u0db6\u0daf\u0dca\u0db1 \u0d9a\u0dd0 \u0d9c\u0db4\u0dad\u0db1. \u0d91\u0dc1\u0dc5 \u0db1 \u0dc3 \u0d85\u0dc1\u0db4\u0dca \u0dc1 \u0ddc\u0da9\u0dbd\u0dba \u0dc1 \u0ddc\u0d9a\u0dca\u0dad\u0daf? \u0d85\u0dc1\u0db4\u0dca \u0d87 \u0dad\u0dd2 \u0dc3 \u0d9c \u0d9a\u0dd2\u0dda\u0dc0\u0d9c \u0dc0\u0d9c\u0dc1\u0dda \u0d92\u0d9a\u0da7 \u0d95\u0db1\u0dd1 \u0db1 \u0dca\u0dad \u0daf\u0d9c \u0d9c\u0db4\u0dad\u0db1. \u0d85\u0dc1\u0db4\u0dca \u0db8\u0dd6\u0dbd\u0db1\u0dbb\u0dca \u0dba \u0dad \u0dd2 , \u0dc1 \u0dc3 \u0d85\u0dba \u0dc0\u0dd2\u0dba \u0d85\u0db4\u0dd2 \u0db4\u0d9c\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c \u0db1\u0dd2\u0dc2\u0dca\u0da8 \u0db4\u0d9c\u0daf\u0db1 \u0dbb\u0dbb\u0dca\u0dd2\u0d9a\u0d9a\u0dba\u0dca\u0dad \u0dc1\u0d9c\u0ddc\u0da9 \u0db1\u0dd2\u0d9c\u0dd3 \u0d89\u0dbd\u0dca\u0dad\u0d9a \u0d9a\u0dd0\u0dc1\u0d9c\u0db1. \u0d91\u0dc1\u0dc5 \u0db1\u0dd2\u0dad\u0dd2\u0dc0 \u0dc1 \u0dc3 \u200d\u0dbb \u0db1\u0dc1\u0dba\u0db4\u0dad \u0d85\u0db4\u0da7 \u0d9c\u0dd2\u0dbd\u0dc1\u0dc0\u0db4\u0dad\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0dca\u0dad \u0db1\u0dd2\u0dc5\u0dd2. \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dbb\u0dca\u0dd2\u0d9a\u0d9a\u0dba\u0da7 \u0dba\u0db1\u0dad\u0d9c\u0dc0 \u0db6\u0daf\u0dca\u0db1 \u0d9a\u0dd0 \u0d9c\u0db4\u0dad\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0db4\u0dd2 \u0dc1 \u0dc3 \u0d85\u0dba \u0dc0\u0dd2\u0dba \u0d9a \u0d9a\u0dd0 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d85\u0db4\u0dd2 \u0d92 \u0dbb\u0d9a\u0d9c\u0dd0\u0dba\u0da7 \u0dc1 \u0dc3 \u0d85\u0dba \u0dc0\u0dd2\u0dba \u0db4\u0d9c\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0dd0 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c.\n\n\u0d9c\u0dd4 \u0dca\u0db7\u0dcf\u0db4\u0dd2\u0db1\u0dad\u0dd4\u0db8\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0bb5\u0bbf\u0b9a\u0bbe\u0bb3\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Chairman) Hon. Minister, your time is over.\n\n\u0d9c\u0dd4 \u0dc3\u0dd4\u0db1\u0dd2\u0dbd\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0d9c\u0db8\u0d9c\u0dda \u0db8\u0dc4\u0dc3\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0bc1\u0ba9\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0b95\u0bae\u0b9a\u0b95) (The Hon. Sunil Kumara Gamage) \u0da7 \u0dad\u0dc0 \u0dc0\u0dd2\u0db1\u0d9c\u0da9\u0dd2\u0dba\u0dca\u0dad \u0dc1\u0daf\u0db4\u0dad\u0db1, \u0d9c\u0dbb\u0dd4 \u0db7\u0d9c\u0db4\u0dad\u0dd2 \u0dc3 \u0db1\u0dd2.\n\n\u0d92 \u0dc0\u0d9c\u0dc1\u0dda \u0dbb\u0dbb\u0dca\u0dd2\u0d9a\u0d9a\u0dc1\u0d86 \u200d\u0dbb\u0dad\u0dd2\u0dbd\u0d9c\u0db7 \u0dba\u0db1\u0dad\u0d9c\u0dc0\u0da7 \u0d9c\u0db1\u0d9c\u0dd0\u0dab\u0dc0 \u0dc1\u0db6\u0daf\u0dd3 \u0dba\u0db1 \u0d9a\u0dca\u200d\u0dbb \u0dc1\u0dda\u0daf\u0dba\u0dca\u0dad \u0d85\u0db4\u0dd2 \u0dc1 \u0dc3 \u0d85\u0dba \u0dc0\u0dd2\u0dc1\u0d86 \u0dc5\u0daf\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d85\u0dc1\u0db4\u0dca model \u0d91\u0d9a \u0d87 \u0dc3\u0dc1\u0dcf \u0d85\u0dc1\u0db4\u0dca \u0dd0\u0dc1\u0da7\u0dca \u0dbb\u0dbb\u0dca\u0dd2\u0d9a\u0d9a \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf\u0dba\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0dba \u0dc3 \u0dc1\u0dba\u0ddc\u0daf\u0d9c \u0d9c\u0db4\u0dad\u0db1 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad \u0dc0\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0db4\u0dd2 \u0dc1 \u0dc0\u0dd0 \u0d85\u0dba \u0dc0\u0dd2\u0dba \u0d89\u0dad\u0d9c \u0d9c\u0dbb\u0dca\u0dcf\u0d9a\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c \u0d9a\u0dd2\u0dba\u0dbd\u0d9c \u0dc0\u0dd2 \u0dc0\u0d9c \u0d9a\u0dd0\u0db1\u0dc0\u0d9c. \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf \u0d87 \u0dc3\u0dc1\u0dcf \u0dab\u0dd4\u0dbd\u0dd2\u0da0\u0dca , \u0db6\u0dc0\u0dc1\u0d9a\u0ddc\u0dc1\u0dbd\u0ddc\u0dad\u0dca \u0dc1\u0dc0\u0da0\u0dca \u0dd0\u0da7\u0d9a \u0dc1 \u0da0\u0dca \u0dd0 \u0d9c\u0dbb\u0dca\u0dcf\u0d9a \u0d85\u0dba \u0dc0\u0dd2\u0dba\u0dca\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd0\u0db4\u0dad\u0db1\u0da7 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad \u0dc0\u0dd3 \u0d9c\u0dd2\u0db1 \u0d85\u0dad\u0dd2\u0d9c\u0dbb\u0dd4 \u0dba\u0db1\u0d9c\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dc3 \u0d9c\u0da7 - \u0d85\u0dc1\u0db4\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87 \u0dad\u0dd2 \u0dc3 \u0d9c\u0da7 - \u0d85\u0db4\u0dd2 \u0dc3\u0dad\u0dd2\u0dc0\u0db4\u0dad\u0dad \u0dc1\u0dc0\u0db1\u0dc0\u0d9c. \u0d92 \u0dc0\u0d9c\u0dc1\u0dda \u0d85\u0db4\u0dd2 \u0d92 \u0d9c\u0dd2\u0db1 \u0dc3\u0da7\u0dd4 \u0dc1\u0dc0\u0db1 \u0db6\u0dc0\u0dad\u0dca \u200d\u0dbb\u0d9a\u0d9c \u0d9a\u0dd0\u0db8\u0dd2\u0db4\u0dad \u0dc1\u0dda \u0d9a\u0dcf\u0d9c\u0dc0 \u0d85\u0dc0 \u0db4\u0dad \u0d9a\u0dd0\u0db1\u0dc0\u0d9c, \u0d9c\u0dbb\u0dd4 \u0db7\u0d9c\u0db4\u0dad\u0dd2 \u0dc3 \u0db1\u0dd2."
