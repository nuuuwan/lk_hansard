    "chunk_text": "\u0d85 \u0dc4\u0dbb\u0dd4\u0dc0\u0dcf\u0daf\u0dcf \u0dc0\u0dd2\u0dc0\u0dcf\u0daf\u0dba\u0dcf\u0dad\u0da7 \u0dad\u0d9a\u0dc1\u0db1\u0db1 \u0d85 \u0dcf\u0dad\u0dba\u0dcf\u0dcf \u0dc4\u0dcf \u0d92\u0dc0\u0dcf \u0dba\u0dcf\u0dad\u0da7\u0dc1\u0db8 \u0d87\u0dad\u0dd2 \u0d85\u0dc1\u0db1\u0d9a\u0dd4\u0db8 \u0dc1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0dc4\u0dcf \u0dca\u0dba\u0dcf\u0dad\u0dad\u0db1\u0dc0\u0dbd\u0da7 \u0d85\u0daf\u0dcf \u0d85\u0dcf\u0d9a 149\u0d8b 303\u0d8b 194 \u0dc3\u0dc4 219 \u0daf\u0dbb\u0db1 \u0dc0\u0d9a\u0dba\u0dcf\u0dad \u0dc1\u0dd3\u0dbb\u0dca\u0dbd\u0dc2\u0dc0\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0dda\u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0dba\u0dcf\u0dad\u0dcf\u0db1\u0dd4\u0dd6\u0dbd\u0dbd\u0dc0 \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0dc0\u0d9a\u0da9\u0dcf)\u0dc3\u0da7\u0dc4\u0db1\u0dca\u0dad\u0dc0\u0dbd \u0dd2 \u0dba\u0dcf\u0dad\u0dbd\u0dd4 \u0db4\u0dd4\u0db1\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0db1 \u0dc0\u0dd2\u0dba\u0dcf\u0dad\u0daf\u0dda \u0dc4\u0dcf \u0db8\u0dd6\u0dbd\u0db0\u0db1 \u0dc0\u0dd2\u0dba\u0dcf\u0dad\u0daf\u0dda \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dcf\u0dad\u0dca 10\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0d9a\u0db4\u0dcf \u0dc4\u0d9a\u0dbb\u0dd2\u0dba\u0dcf\u0dad \u0dba\u0dd4\u0dd4\u0dba\u0dcf\u0dad\" \u0dba\u0dd2 \u0dc1\u0dba\u0dcf\u0dad\u0ddd\u0da2\u0db1\u0dcf \u0d9a\u0dbb\u0db8\u0dd2\n\n\u0dad\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dd4 \u0db1\u0dd2\u0d8b \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf)\u0dcf \u0d85 \u0dcf\u0dad\u0dba\u0dcf\u0dcf \u0dba\u0dcf\u0dad \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad\u0d8b \u0dad\u0dbb\u0dd4\u0dab \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0d85 \u0dcf\u0dad\u0dba\u0dcf\u0dcf \u0dba\u0dcf\u0dad \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dbb\u0da7\u0d9a \u0d89\u0dad\u0dcf \u0dc0\u0d9a\u0daf\u0dad\u0db8 \u0d85 \u0dcf\u0dad\u0dba\u0dcf\u0dcf \u0dad\u0dbb\u0dd4\u0dab \u0d9a\u0da7\u0dba\