\u0db4\u0dad\u0db4 \u0dc3 \u0dc5 \u0dcf \u0d9c \u0dab\u0dd4\u0db8\u0dca \u0dc3 \u0dcf\u0dc5\u0d9c \u0dd0\u0dcf\u0dc0\u0d9c \u0d9c\u0dd2\u0db1\u0dd3\u0dc1 \u0dc3 \u0db6\u0daf\u0dca\u0daf \u0d85\u0dba \u0d9a\u0dd2\u0dbb\u0dd3 [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 3210]\n\n\u0dc0\u0d9c\u0dbd\u0da0\u0dca\u0dc1\u0da0\u0dca\u0db1 \u0d9a\u0da9\u0daf\u0d9c \u0dad \u0d9a \u0dc3\u0dc5\u0dbd \u0dba\u0dc5\u0dd2 \u0db4\u0dab\u0d9c\u0dd2\u0db4\u0dad\u0dc0\u0dd3 [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 3215]\n\n\u0dc0\u0dd2\u0dca\u0dbb\u0dca\u0da2\u0db1 \u0db4\u0db1\u0dad\u0dca \u0d9c\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad, 2025 \u2013 [\u0dc0\u0dd2\u0dc3\u0dd2\u0db4\u0dca\u0db4\u0dc0\u0db1 \u0d9c\u0dc0\u0dca\u0daf \u0d9a\u0dc5 \u0daf\u0dd2\u0db1\u0dba]:\n\n[\u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dca\u0da8 102, 237-252, 280, 296, 323, 324, 329, 333, 338 (\u0db8\u0dd4\u0daf\u0dbd\u0dca, \u0d9a\u0dca\u200d\u0dbb \u0dc3\u0db4\u0d9c\u0daf\u0db1 \u0dc5 \u0dbb\u0dbb\u0dca\u0dd2\u0d9a\u0d9a \u0dc0\u0dc0\u0dbb\u0dca\u0db1\u0db1]] - \u0d9a\u0d9c\u0dd0\u0d9a \u0db7\u0d9c\u0dc1\u0dda\u0daf\u0dd3 \u0dbd\u0d9a\u0d9c \u0db6\u0dbd\u0db1 \u0dbd\u0daf\u0dd3. - \u0dc0\u0dd2\u0dc0\u0d9c\u0daf\u0dba \u0d9a\u0dbd\u0dca \u0dad\u0db6\u0db1 \u0dbd\u0daf\u0dd3. [\u0dad\u0dd3\u0dbb\u0dd4 3218-3342]\n\n\u0db8\u0dd4\u0dcf\u0dbd\u0dca \u0db4\u0db1\u0dad \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0d9c\u0dba [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 3343]\n\n\u0d9c\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0d86\u0dcf\u0dcf\u0dba\u0db8\u0dca \u0db4\u0db1\u0dad \u0dc1\u0dba\u0ddd\u0dba\u0db1\u0d9c\u0dc0 [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 3343] \u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0dca\u0daf\u0dad \u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0d9c\u0db8\u0dca \u0db4\u0db1\u0dad \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0d9c [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 3343]\n\n\u0d85\u0dca\u0daf\u0dad\u0dbb\u0dca\u0d9c\u0dad \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0d9a\u0dd4\u0dd4\n\n\u0baa\u0bbf\u0bb0\u0ba4\u0bbe\u0ba9 \u0b89\u0bb3\u0bcd\u0bb3\u0b9f\u0b95\u0bcd\u0b95\u0bae\u0bcd\n\n\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbe\u0baf\u0bcd\u0bb5\u0bbe\u0bb3\u0bb0\u0bcd \u0b85\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0ba4\u0bc1 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0b95 [\u0baa: 3189]\n\n\u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95 \u0ba8\u0bbf\u0ba4\u0bbf \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bbf\u0ba9\u0bcd \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0b95 [\u0baa: 3191]\n\n\u0bb5\u0bbf\u0ba9\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bbe\u0baf\u0bcd\u0bae\u0bc2\u0bb2 \u0bb5\u0bbf\u0b95\u0b9f\u0b95\u0bb3\u0bcd [\u0baa: 3196 - 3210]\n\n\u0ba4\u0ba9\u0bbf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bae\u0bc2\u0bb2 \u0bb5\u0bbf\u0ba9\u0bbe:\n\n\u0bae\u0bc2\u0ba4\u0bcd\u0ba4 \u0baa\u0bbf\u0bb0\u0b95\u0bc8\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b95\u0bb5\u0baa\u0bcd\u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0ba4\u0bbe\u0b95\u0b95\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bc1\u0bc8\u0ba8\u0bcd\u0b95\u0ba4\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bb5\u0b99\u0bcd\u0b95\u0bbf\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bb3\u0bcd\u0bae\u0bc0\u0ba4\u0bc1 \u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0b95\u0bb5\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bb5\u0bbe\u0bbf [\u0baa: 3210]\n\n\u0bb5\u0bbe\u0b95\u0bc8\u0b9a\u0bcd\u0b9a\u0b9a\u0b95\u0ba9 \u0b95\u0bbe\u0b95\u0bbf\u0ba4\u0ba4\u0bcd \u0ba4\u0ba4\u0bbe\u0bc8\u0bbf\u0bb1\u0bcd\u0b9a\u0bbe\u0b95\u0bb2\u0b95\u0baf \u0bae\u0bc0\u0bb3 \u0b87\u0baf\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bb2\u0bcd [\u0baa: 3215]\n\n\u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bc2\u0bb2\u0bae\u0bcd, 2025 - [\u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0bb0\u0bc1\u0baa\u0ba4\u0bcd\u0b95\u0ba4\u0ba8\u0bcd\u0ba4\u0bbe\u0bae\u0bcd \u0ba8\u0bbe\u0bb3\u0bcd]:\n\n[\u0ba4\u0b95\u0bb2\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bcd 102, 237-252, 280, 296, 323, 324, 329,\n\n333, 338 (\u0ba8\u0bbf\u0ba4\u0bbf, \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bbf\u0b9f\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0baa\u0bbe\u0bb0\u0bc1\u0bb3\u0bbe\u0ba4\u0bbe\u0bb0 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf)] \u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bbf\u0bb2\u0bcd \u0b86\u0bb0\u0bbe\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1 - \u0bb5\u0bbf\u0bb5\u0bbe\u0ba4\u0bae\u0bcd \u0b92\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. [\u0baa: 3218-3342]\n\n\u0ba8\u0bbf\u0ba4\u0bbf\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd: \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0ba4\u0bbf [\u0baa: 3343]\n\n\u0b89\u0ba3\u0bcd\u0ba3\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0b87\u0b95\u0bb1\u0bb5\u0bbe\u0bbf\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd: \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0ba9\u0bae\u0bcd [\u0baa: 3343]\n\n\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bc1\u0bb1\u0bc1\u0ba4\u0bbf\u0ba4\u0bcd \u0ba4\u0ba4\u0bbe\u0bc8\u0bbf\u0b95\u0bb2 \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd: \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u0bb3\u0bcd [\u0baa: 3343]\n\n\u0d86\u0db1\u0dba\u0db1 \u0dc4\u0dc3\u0dcf \u0d85\u0db4\u0db1\u0dba\u0db1 (\u0db4\u0dcf\u0dbd\u0db1) \u0db4\u0db1\u0dad \u0dc1\u0dd0\u0d9c\u0dd4\u0dbd\u0d9c \u0dad [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 3344] \u0dc3\u0dd4\u0dbb\u0dcf\u0db6\u0daf\u0dd4 \u0d86\u0da5\u0dcf\u0db4\u0db1\u0dad \u0db1\u0dd2\u0dc1\u0dda\u0daf\u0db1\u0dba [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 3345] \u0db1\u0dd2\u0dc2\u0db4\u0db4\u0dcf\u0dcf\u0db1 \u0db6\u0daf\u0dd4 (\u0dc0\u0dd2\u0d9c\u0dc1\u0dca\u0dda\u0dc2 \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1) \u0db4\u0db1\u0dad \u0db1\u0dd2\u0dba \u0dba [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 3345]\n\n\u0dc0\u0dd2\u0d9c\u0dc1\u0dca\u0dda\u0dc2 \u0d9c\u0dc0\u0dc5\u0db3 \u0db7\u0dcf\u0dab\u0dca\u0da9 \u0db6\u0daf\u0dd4 \u0db4\u0db1\u0dad \u0db1\u0dd2\u0dba [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 3345]"
