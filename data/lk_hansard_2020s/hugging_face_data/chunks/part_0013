b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. Question put, and agreed to.\n\n\u0d9a\u0dbd\u0dca\u0dad\u0dd0\u0db6\u0dd3\u0db8 \u0b92\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bb5\u0baa\u0bcd\u0baa\u0bc1 ADJOURNMENT\n\n\u0d9c\u0dd4 \u0dc3\u0dc0\u0dbb\u0ddd\u0da2\u0dcf \u0dc3\u0dcf\u0dd2\u0dbb\u0dad\u0dca\u200d\u0dbb\u0dd2 \u0dc0\u0db4\u0ddd\u0dbd\u0dca\u0dbb\u0dcf\u0dda \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2\u0dba (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 (\u0ba4\u0bbf\u0bb0\u0bc1\u0bae\u0ba4\u0bbf) \u0b9a\u0b9a\u0bb0\u0bbe\u0b9c\u0bbe \u0b9a\u0bbe\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf \u0b9a\u0baa\u0bbe\u0bb2\u0bcd\u0bb0\u0bbe\u0b9c\u0bcd) (The Hon. (Mrs.) Saroja Savithri Paulraj) \u0d9c\u0dc0 \u0d9a\u0dcf\u0dd2\u0db1\u0dd2\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0d91\u0db4\u0dd2\u0dca\u0d9c\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd42 \u0dd0\u0dca \u0d9a\u0dca \u0dad\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0d91 \u0dba\u0dd2 \u0db8\u0dd2 \u0dc1\u0dba\u0ddd\u0db1\u0db1\u0dd2 \u0d9a\u0dba\u0db12\u0dd2.\n\n\u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0db1\u0dba \u0dc3\u0db7\u0dcf\u0dd2\u0db8\u0db8\u0dd4\u0dca\u200d \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3. \u0bb5\u0bbf\u0ba9\u0bbe \u0b8e\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bae\u0bcd\u0baa\u0baa\u0bcd\u0ba4\u0baa\u0bb1\u0bcd\u0bb1\u0ba4\u0bc1. Question proposed.\n\n\u0d9c\u0dd4 \u0d9a\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0baa\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Speaker) \u0dc3\u0db7\u0dd22 \u0d9a\u0dca \u0dad\u0db6\u0db1 \u0d852\u0dc3\u0dcf\u0dcf\u0dd2\u0dc1\u0dda \u0dc1\u0dba\u0ddd\u0db1\u0db1\u0dd22 \u0d9c\u0dc0 \u0da0\u0dd2\u0db8\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dc