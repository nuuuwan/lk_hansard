    "chunk_text": "\u0d92\u0d9a \u200d\u0dbb\u0d9c\u0dc1\u0dba\u0ddd\u0dab\u0dd4\u0d9a\u0dc0 \u0d9a\u0dd2\u0dba\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dc1\u0daf\u0dba\u0dca\u0dad. \u0d92 \u0d9a\u0dd2\u0dba\u0db4\u0dad\u0dc1\u0db4\u0dad \u0dc1 \u0dad\u0dd2\u0db1 \u0d89\u0dbd\u0dca\u0dad\u0d9a \u0dc3 \u0daf \u0db1 \u0d91\u0d9a \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dd2 , \u0dc1\u0d9a\u0ddc\u0dc1\u0dc5\u0ddc \u0daf \u0d85\u0db4\u0dd2 \u0dc1 \u0dc3 \u0dbb\u0daf\u0d9c\u0dba \u0dc1 \u0ddc\u0dba\u0d9c \u0d9c\u0db4\u0dad\u0dc1\u0db4\u0dad \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a. \u0d92 \u0db1\u0dd2 \u0d9c \u0d85\u0db4\u0dd2 \u0db1\u0dd2\u0dbb\u0dca \u0d9c\u0dab\u0dc1\u0dd3\u0dbd\u0dd2 \u0dc0\u0dd2\u0dba \u0dd4\u0dad \u0dc3\u0dd2 , \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0dbb\u0d9a\u0d9c\u0dd0\u0dba\u0d9a\u0da7 \u0dbb\u0daf\u0d9c\u0dba \u0dc3 \u0dc1 \u0ddc\u0dba\u0d9c \u0d9c\u0db4\u0dad\u0dc1\u0db4\u0dad \u0dc1\u0d9a\u0ddc\u0dc1\u0dc5\u0ddc \u0daf, \u0d85\u0dc1\u0db4\u0dca \u0dc0\u0dd2\u0dba\u0daf \u0dc3 \u0db4\u0d9c\u0dbd\u0db1\u0dba \u0d9a\u0dd0 \u0d9c\u0db4\u0dad\u0db1 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad \u0dc1\u0dc0\u0db4\u0dad\u0dc1\u0db4\u0dad \u0dc1\u0d9a\u0ddc\u0dc1\u0dc5\u0ddc \u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dcf\u0dc0. \u0d85\u0db4\u0da7 \u0db4\u0d9c\u0dbd\u0db1\u0dba - control - \u0d9a\u0dd0\u0db4\u0dad\u0db1 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad \u0dc0\u0dd2\u0dba\u0daf \u0dc3 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d92 \u0dc0\u0d9c\u0dc1\u0dda , \u0db4\u0d9c\u0dbd\u0db1\u0dba \u0d9a\u0dd0\u0db4\u0dad\u0db1 \u0db6\u0dd2\u0dbb\u0dd2 \u0dc0\u0dd2\u0dba\u0daf \u0dc3 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d92 \u0dc0\u0d9c\u0dc1\u0dda , input cost \u0d91\u0d9a\u0dca\u0dad \u0dc1\u0dc5\u0ddd cost inflation \u0d91\u0d9a\u0dca\u0dad \u0db4\u0dd2\u0da7 \u0dad\u0dd0\u0dc0 \u0dbb\u0dc1\u0dc0\u0ddc\u0dad\u0dca, \u0d92 \u0d9a\u0dd2\u0dba\u0db4\u0dad\u0dc1\u0db4\u0dad \u0dc1\u0dad\u0dbd\u0dca \u0db8\u0dd2\u0dbd \u0dc0\u0dd2\u0da9\u0dd2 \u0dc0\u0dd4\u0dc1\u0dab\u0ddc\u0dad\u0dca, \u0d85\u0db4\u0dd2 \u0dc1\u0d9a\u0ddc\u0dc1\u0dc5\u0ddc \u0daf \u0d92\u0d9a handle \u0d9a\u0dd0\u0db4\u0dad\u0dc1\u0db4\u0dad. \u0dc1 \u0dc0\u0dd0 \u0dad \u0dd2 \u0dc0\u0dd2\u0da9\u0dd2 \u0dc1\u0db4\u0ddc\u0dbd\u0dd3 \u200d\u0dbb \u0d9c\u0dab\u0dba\u0dca\u0dad, \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0daf\u0d9c\u0dba \u0d91\u0dca\u0dad\u0d9a \u0dc0 \u0db4\u0dad\u0daf\u0db1\u0dba \u0d9a\u0dd0\u0dbd\u0d9c \u0db6\u0dd2\u0dbd\u0dd4\u0dc0\u0d9c , \u0dad\u0dba\u0dba\u0da7 58\u0dca\u0dad, \u0d92 \u0d9a\u0dd2\u0dba\u0db4\u0dad\u0dc1\u0db4\u0dad \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 2,950\u0dca\u0dad \u0dc0\u0db1 \u0dc1\u0db4\u0ddc\u0dbd\u0dd3 \u200d\u0dbb \u0d9c\u0dab\u0dba\u0da7 \u0d85\u0db4\u0dd2 \u0dbb\u0daf\u0d9c\u0dba \u0d87 \u0dad\u0dc1 \u0dc3\u0db4\u0dad \u0dc3 \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db4\u0dad\u0dc1\u0db4\u0dad, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 5,042\u0dd2 . \u0d92 \u0dc3\u0db6\u0db4\u0dad\u0db1\u0dc1\u0dba\u0db4\u0dad \u0da7 \u0d9a\u0dd2\u0dba\u0db4\u0dad\u0db1 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad \u0dc1\u0dc0\u0db4\u0dad\u0dc1\u0db4\u0dad, \u0d85\u0db4\u0dd2 \u0dc1 \u0dc3 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dbb\u0dc0\u0dc1\u0dd0\u0ddd\u0d9a\u0dcf\u0db1 \u200d\u0dbb\u0d9c\u0dc1\u0dba\u0ddd\u0dab\u0dd4\u0d9a\u0dc0 \u0d89\u0dc2\u0dca\u0da8 \u0da7 \u0d9a\u0dd0\u0db4\u0dad\u0db1 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad \u0dc1\u0d9a\u0ddc\u0dd2 \u0dbb\u0d9a\u0d9c\u0dd0\u0dc1\u0dba\u0db4\u0dad\u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dd2 . 2024 \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0dc1\u0d86 \u0dc1\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dbb\u0daf\u0d9c\u0dba \u0dc3 \u0dc1\u0daf\u0db4\u0d9c\u0dbb\u0dca\u0dad\u0dc1 \u0dc3\u0db4\u0dad \u0dc3\u0dc1\u0dc0\u0db4\u0dad \u0dbb\u0daf\u0d9c\u0dba \u0dc3 \u0d87 \u0dad\u0dc1 \u0dc3\u0db4\u0dad \u0dc3\u0dc0 \u0dc1\u0dbd \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1,950\u0dca\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c, \u0dc1 \u0dc0\u0dd0 \u0d91\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 2,250 \u0daf\u0dca\u0dad\u0dc0\u0d9c \u0dc0\u0dd2\u0da9\u0dd2 \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. 2024\u0daf\u0dd3 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dc0\u0d9a\u0d9c \u0dc1\u0dbb\u0dca\u0d9c\u0dd4\u0dc0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1,550\u0dca\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0d9c. \u0dc1 \u0dc0\u0dd0 \u0d92\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 2,070\u0da7 \u0dc0\u0dd2\u0da9\u0dd2 \u0dc1\u0dc0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d92 \u0dc0\u0d9c\u0dc1\u0dda , 2024\u0daf\u0dd3 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dc0\u0d9a\u0d9c \u0dc3\u0dd4\u0dd0\u0d9c\u0db6\u0daf\u0dd4 \u0dc1\u0daf\u0db4\u0d9c\u0dbb\u0dca\u0dad\u0dc1 \u0dc3\u0db4\u0dad \u0dc3\u0dc0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 214\u0dca\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0d9c. \u0d92\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 240\u0da7 \u0dc0\u0dd2\u0da9\u0dd2 \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d92\u0d9a\u0dad\u0dca \u0d91\u0dca\u0dad\u0d9a \u0da7 \u0d9a\u0dd2\u0dba\u0db4\u0dad\u0db1 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad, \u0d9a\u0d9c\u0dbb\u0dca\n\n3279 3280\n\n2025 \u0d9c\u0dbb\u0dca \u0dc3 20\n\n\u0d92 \u0d94\u0dca\u0dad\u0dc1\u0d9a\u0ddc \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dc0 \u0dcf\u0d9c\u0dc1\u0dda\u0daf\u0dd3 debt servicing \u0dcf\u0dc5\u0d9c, \u0d92 \u0d9a\u0dd2\u0dba\u0db4\u0dad\u0dc1\u0db4\u0dad, \u0dab\u0dba \u0dc1\u0db4\u0ddc\u0dbd\u0dd3 \u0dc5 \u200d\u0dbb\u0d9c\u0dda\u0db1\u0db1 \u0dc0\u0dd2\u0dba\u0daf \u0dc3 \u0d91\u0dca\u0dad\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 4,550\u0dca\u0dad \u0dc1 \u0dc3 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0dc1\u0daf\u0dca \u0dc1\u0dc0\u0db4\u0dad \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d85\u0db4\u0dad\u0dad\u0dd2 \u0da7 \u0dc1\u0d9a\u0ddc\u0dc1\u0dc5\u0ddc \u0daf \u0d85\u0db4\u0dd2 \u0dc1 \u0dc3\u0d9a \u0db4\u0dbb\u0dd2\u0db4\u0d9c\u0dbd\u0db1\u0dba \u0d9a\u0dd0\u0db4\u0dad\u0dc1\u0db4\u0dad \u0d9a\u0dd2\u0dba\u0db1 \u200d\u0dbb \u0db1\u0dba \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0da7 \u0da7 \u0dc1\u0db4\u0dd0 \u0db4\u0dd2\u0dc0\u0dd2\u0dad\u0dd2 \u0dc5\u0dd2 \u0dbb\u0da9\u0dd4\u0d9a\u0dca\u0dc0\u0dca\u0dad \u0d94\u0dba \u0dc0\u0d9c\u0dc1\u0dda \u0dc1\u0dc5\u0ddc\u0dcf \u0dad\u0daf\u0dca\u0db1\u0d9c\u0db4\u0dad\u0dad \u0dc3\u0dc5\u0dd2\u0db4\u0dad \u0d85\u0dba \u0dc0\u0dd2\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd0\u0db1\u0dc0\u0d9c. \u0d92 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dcf\u0d9c\u0da7, \u0d85\u0db4\u0dad\u0dad\u0dd2 \u0da7 \u0d92\u0d9a \u200d\u0dbb\u0d9c\u0dc1\u0dba\u0ddd\u0dab\u0dd4\u0d9a\u0dc0 \u200d\u0dbb\u0dd2\u0dba\u0d9c\u0dad\u0dca \u0d9a \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0ddc\u0da7, \u0dc0\u0dd2\u0dba\u0daf \u0dc0\u0dd2\u0da9\u0dd2 \u0dc1\u0dc0\u0dbd\u0d9c, \u0dbb\u0daf\u0d9c\u0dba \u0d85\u0d9a\u0dca \u0dc1\u0dc0\u0dbd\u0d9c, \u0d85\u0dba \u0dc0\u0dd2\u0dba \u0dd2\u0db4\u0d9f\u0dba \u0dc0\u0dd2\u0da9\u0dd2 \u0dc1\u0dc0\u0dbd\u0d9c \u0dba\u0db1 \u0d9c \u0db1\u0dca\u0dad \u0dad \u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db4\u0dad\u0dc1\u0db4\u0dad \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0d85\u0db4\u0da7 \u0dc1\u0db4\u0dc1\u0db1\u0db1\u0dc0\u0d9c. \u0dc1 \u0dc0\u0dd0 \u0db4\u0db1\u0dad\u0dca\u0dad \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db1\u0dd2 \u0d9c\u0dad\u0dca, \u0db4\u0dcf\u0db8\u0dd4\u0dc0\u0db1 \u0dc0\u0dad\u0d9c\u0dc0\u0da7 \u0d92 \u0db4\u0db1\u0dad \u200d\u0dbb\u0dd2\u0dba\u0d9c\u0dad\u0dca \u0d9a \u0d9a\u0dd0\u0db1 \u0db1\u0dd2 \u0d9c\u0dad\u0dca, \u0dc1 \u0dc3\u0d9a \u0dc1\u0d9a\u0ddc\u0dd2 \u0dbb\u0d9a\u0d9c\u0dd0\u0dc1\u0dba\u0db4\u0dad\u0daf \u0d85\u0db4\u0dd2 \u200d\u0dbb\u0dd2\u0dba\u0d9c\u0dad\u0dca \u0d9a \u0d9a\u0dd0\u0db4\u0dad\u0dc1\u0db4\u0dad \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0db6\u0dd2\u0dbd\u0dd2\u0dba \u0dd4\u0dad \u0dc3\u0dd2 ."
