    "chunk_text": "\u0dc1 \u0dd2\u0db4\u0daf\u0dd3 \u0db4\u0dcf\u0db8\u0dd4\u0dc0\u0dd2\u0db1\u0dd2 \u0d9a\u0d9c\u0dd0\u0dab\u0dba \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0db4\u0dd2 \u0daf\u0dd2\u0dca\u0dad\u0d9a\u0d9c, \u0dc1 \u0dc0\u0d9c \u0d85\u0db4\u0db1\u0dba\u0db1\u0d9a\u0dbb\u0dd4\u0dc0\u0db4\u0dad \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db4\u0dad \u0dad\u0dba\u0dba\u0da7 15\u0d9a tax \u0d91\u0d9a\u0dca\u0dad \u0daf\u0d9c\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c \u0d9a\u0dd2\u0dba\u0dbd\u0d9c \u0dc0\u0dd2\u0dbb\u0dd0\u0daf\u0dd2 \u0dad\u0dba\u0dca\u0dad \u0d9c\u0dba\u0d9c\u0dad \u0d9a\u0dd0\u0db4\u0dad\u0db1\u0da7 \u0dc0\u0dd2\u0db4\u0dca\u0dad\u0dc2\u0dca\u0da8\u0dc1\u0d86 \u0d9a\u0dd2\u0dd2\u0db4\u0db4\u0dc1\u0daf\u0dc1\u0db1\u0dca\u0dad \u0dda\u0dad\u0dca \u0d9c\u0dc5 \u0daf\u0dd0\u0db1\u0dc0\u0d9c. \u0d92 \u0dc0\u0d9c\u0dc1\u0dda \u0d92 \u0dc3\u0dc5\u0dd2\u0db4\u0dad \u0dc1 \u0dc0\u0d9c \u0d85\u0db4\u0db1\u0dba\u0db1\u0d9a\u0dbb\u0dd4\u0dc0\u0db4\u0dad\u0da7 \u0d85\u0dc0\u0d9c \u0dad\u0dba\u0dca\u0dad \u0dc1\u0dc0\u0db1\u0dc0\u0d9c \u0d9a\u0dd2\u0dba\u0dbd\u0d9c \u0d9c\u0dba \u0d9c\u0db1\u0dd9 \u0dc3\u0dcf\u0dad\u0dca \u0dc5\u0dd0 \u0d85\u0dba \u0dad\u0dba\u0dca\u0dad \u0dc5\u0daf\u0db4\u0dad\u0db1\u0da7 \u0dda\u0dad\u0dca \u0d9c\u0dc5 \u0d9a\u0dcf\u0d9c. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0d9c\u0dbb\u0dd4 \u0d9a\u0dcf\u0d9c\u0db1\u0d9c\u0dba\u0d9a \u0dc3 \u0db1\u0dd2, \u0d92 \u0dc3\u0db6\u0db4\u0dad\u0db1\u0dc1\u0dba\u0db4\u0dad \u0db1\u0dd2\u0dc0\u0dd2\u0dbb\u0dd0\u0daf\u0dd2 \u0dc0\u0dd2 \u0dad\u0dd0\u0dba \u0dc1 \u0dc3\u0d9a\u0dd2 . \u0db4\u0dc3\u0dd4\u0dab\u0dd4\u0dba \u0dd0\u0dba\u0dba IMF framework \u0d91\u0d9a \u0dc3\u0dcf \u0dad\u0dba\u0dba\u0da7 30\u0d9a \u0db6\u0daf\u0dca\u0daf\u0dca\u0dad \u0d85\u0dba \u0d9a\u0dd0 \u0d9c\u0dd2\u0db1\u0dd3 \u0dcf\u0dc5\u0d9c \u0d91\u0d9a\u0d9f \u0dc1\u0dc0\u0dbd\u0d9c \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0d9c. \u0d92 \u0d9a\u0dd2\u0dba\u0db4\u0dad\u0dc1\u0db4\u0dad, \u0dad\u0dba\u0dbd\u0dd4 \u0dc0\u0dd9\u0d9c\u0db4\u0d9c\u0dbb\u0dd2\u0d9a \u0dbb\u0dba\u0dad\u0db1 \u0dad\u0dba\u0dba\u0da7 30\u0d9a \u0db6\u0daf\u0dca\u0daf\u0da7 \u0dba\u0da7\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0db1 concept \u0d91\u0d9a \u0dba\u0da7\u0dc1\u0dad\u0dca, \u0d91\u0dc1\u0dc5 \u0db1 \u0dc3 service exporters\u0dbd\u0d9c\u0dad\u0dca \u0d92 \u0dad\u0dba\u0dba\u0da7 30\u0d9a \u0db6\u0daf\u0dca\u0daf\u0da7 \u0dba\u0da7\u0dad\u0dca \u0dc0\u0dd2\u0dba \u0dd4\u0dad \u0dc3\u0dd2 . \u0d92 \u0dc0\u0d9c\u0dc1\u0dda , \u0dad\u0dba\u0dbd\u0dd4 \u0dad\u0db1\u0dd2 \u0dbb\u0dc0\u0daf\u0dca\u0d9c\u0dbd\u0dc1\u0dba\u0ddd - individuals\u0dbd\u0d9c - \u0dad\u0dba\u0dba\u0da7 36\u0d9a tax \u0d91\u0d9a\u0d9a\u0da7 \u0dba\u0da7\u0dad\u0dca \u0dc0\u0dd2\u0dba \u0dd4\u0dad \u0dc3\u0dd2 . Sir,\n\n\u0d8a\u0dcf\u0d9f \u0d9a\u0d9c\u0dd0\u0dab\u0dba \u0dc1 \u0dba\u0dd2 . \u0d92 \u0db6\u0daf\u0dca\u0daf \u0d85\u0d9a\u0dca \u0d9a\u0dd0\u0db1\u0dc0\u0d9c \u0dc0\u0dd2\u0dad\u0dd0\u0dca\u0dad \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dd2 , \u0dc1 \u0dc3 service exporters\u0dbd\u0d9c\u0da7 \u0dad\u0dc0 \u0d85 \u0dad\u0dd0 \u0dc0\u0d9c \u0dad \u0d9a\u0dd3\u0db4\u0dba\u0dca\u0dad \u0dbd\u0db6\u0d9c \u0daf\u0dd3 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d89\u0db4\u0dad \u0db4\u0dcf\u0db8\u0dd4\u0dc0\u0db1 \u0dc0\u0d9c \u0dad\u0dba \u0dad \u0dd2 , \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0daf\u0dca\u0dc0\u0dd2\u0dad\u0dca\u0dc0 \u0db6\u0daf\u0dd4 \u0dab\u0dd4\u0dc0\u0dd2\u0dc3\u0dd4 \u0dc3 - double taxation treaties - \u0dad \u0db4\u0dad service \u0d85\u0db4\u0db1\u0dba\u0db1\u0dba \u0d9a\u0dd0\u0db1 \u0dd0\u0da7\u0dad\u0dca \u0d91\u0dca\u0dad\u0d9a \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c \u0db1 \u0dc3, \u0d92 \u0dd0\u0dc1\u0da7\u0dca\u0daf\u0dd3 \u0dba \u0dc3\u0d9a\u0dd2 \u0dad \u0db6\u0daf\u0dca\u0daf\u0dca\u0dad \u0d9c\u0dd2\u0dc4\u0dd4\u0dc0\u0d9c \u0db1\u0dd2\u0dc0\u0dad \u0dc0\u0dad\u0d9c\u0dc0\u0dca\u0dad \u0dbd\u0dc0\u0d9a\u0d9c\u0dc1\u0dda\u0daf\u0dd3 \u0dad \u0db4\u0dad\u0dc1\u0dda \u0db6\u0daf\u0dd4 \u0d9c\u0dab\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1 \u0dc3\u0daf\u0dd3 \u0dc0\u0dd2\u0dc1\u0daf\u0dca \u0dba\u0d9a\u0daf\u0dd3 \u0dc1\u0d9c\u0dc0\u0db1 \u0dbd\u0daf \u0db6\u0daf\u0dca\u0daf \u0d85\u0d9a\u0dca \u0d9a\u0dd0 \u0d9c\u0dd2\u0db1\u0dd3 \u0da7 \u0d85\u0dc0 \u0dcf\u0d9c\u0dc0 \u0dbd\u0dd2\u0db6\u0dd3 . \u0d92 \u0dcf\u0dc5\u0d9c \u0dda\u0daf\u0d9c\u0dc5\u0dd0\u0dab\u0dba\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0db4\u0dad\u0db1 \u0dc3, \u0dc1\u0dad\u0dca\u0dbb\u0dd4 \u0dc3 \u0d9c\u0dd2\u0db1\u0dd3\u0dc1 \u0dc3 \u0db4\u0dc5\u0dc3\u0dd4\u0dc0 \u0dcf\u0dc5\u0d9c. \u0dbd\u0dc0\u0d9a\u0d9c\u0dc1\u0dda IT service exporter \u0dc1\u0d9a\u0dc1\u0db1\u0dca\u0dad \u0dba \u0dc3\u0d9a\u0dd2 \u0dad \u0dd0\u0da7\u0d9a \u0dd0\u0dba\u0dba\u0d9a\u0da7 service \u0d91\u0d9a export \u0d9a\u0dcf\u0d9c \u0d92 \u0dd0\u0dc1\u0da7\u0dca\u0daf\u0dd3 \u0dad\u0dba\u0dba\u0da7 20\u0d9a \u0db6\u0daf\u0dca\u0daf\u0dca\u0dad \u0d9c\u0dc5\u0db1\u0dc0\u0d9c \u0db1 \u0dc3 \u0d94\u0dc4\u0dd4\u0da7 \u0db1\u0dd2\u0dc0\u0dad \u0dbd\u0dc0\u0d9a\u0d9c\u0dc1\u0dda \u0d9a\u0dd2 \u0dad \u0db6\u0daf\u0dca\u0daf\u0dca\u0dad \u0d85\u0dba \u0d9a\u0dd0\u0db4\u0dad\u0dc1\u0db4\u0dad \u0db1\u0dd2\u0dc5\u0dd2. \u0d92\u0d9a \u0dc1 \u0db6\u0daf\u0dd4 \u0d9a\u0dca\u200d\u0dbb \u0dc1\u0d86 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u200d\u0dbb\u0db1\u0d9c\u0db1 \u0dc0\u0d9c \u0dad\u0dba\u0dca\u0dad. \u0d92 \u0dd0\u0dc1\u0da7\u0dca\u0daf\u0dd3 \u0dad\u0dba\u0dba\u0da7 12\u0d9a \u0db6\u0daf\u0dca\u0daf\u0dca\u0dad \u0dad \u0dd2 \u0d9c\u0dd2\u0dc4\u0dd4\u0dc1\u0dda \u0d9a\u0dd2\u0dba\u0dbd\u0d9c \u0d85\u0db4\u0dd2 \u0dda\u0daf\u0d9c\u0dc5\u0dd0\u0dab\u0dba\u0d9a\u0da7 \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0ddc\u0dad\u0dca, \u0d91\u0dc1\u0dc5\u0db1 \u0dc3 \u0dc1 \u0dc3 \u0db4\u0db1\u0dad\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0dbd\u0dc0\u0d9a\u0d9c\u0dc1\u0dda\u0daf\u0dd3 \u0d85\u0dba \u0d9a\u0dd0\u0db4\u0dad\u0dc1\u0db4\u0dad \u0dad\u0dba\u0dba\u0da7 3\u0d9a \u0db6\u0daf\u0dca\u0daf\u0dca\u0dad \u0dc0\u0dd2\u0dad\u0dd0\u0dd2 . \u0dc1 \u0dc3\u0dc0\u0d9c \u0dc3\u0dc5\u0dd2\u0db4\u0dad \u0dad \u0dd2 \u0dc0\u0d9c \u0dad\u0dba \u0dbd\u0db6\u0d9c \u0daf\u0dd3\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db4\u0dad\u0dc1\u0db4\u0dad. \u0dc1 \u0dc3\u0d9a \u0dad \u0dd2 \u0dc1 \u0dc3 service exporters\u0dbd\u0d9c\u0da7 \u0dbd\u0db6\u0d9c \u0daf\u0dd4\u0db4\u0dad \u0dc1\u0daf\u0dc0\u0dd2\u0db1\u0dd2 \u0dc0\u0d9c \u0dad\u0dba."
