    "chunk_text": "\u0dad\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2 \u0dd2\u0dc0\u0dba\u0dba\u0da7 18\u0dba\u0dd2 VAT \u0d91\u0d9a. \u0db8\u0dd2\u0dd2 \u0dc3\u0dc0\u0dd3\u0dc3\u0dd4 \u0db3\u0db1\u0dcf\u0dc1\u0db4\u0dcf\u0dc1\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0dd4\u0dba\u0dcf VAT \u0d91\u0d9a \u0d85\u0dca \u0d9a\u0dbb\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dcf. \u0d91\u0dc1\u0dc4\u0db8 \u0d9a\u0db8\u0dcf \u0db1\u0db8\u0dca \u0dc4\u0dcf\u0dca \u0db8\u0dd2\u0db1 \u0db4\u0dd2\u0dd2\u0dad \u0db8\u0dd2\u0db1 \u0db4\u0dbb\u0dd2\u0db4\u0dca\u0db4\u0dd4 \u0db8\u0dd2\u0db1 \u0d8b\u0db8\u0dca\u0db3\u0db1\u0d9a\u0da9 \u0db8\u0dd2\u0db1 \u0d9a\u0dbb\u0dc0\u0db1 \u0db8\u0dd2\u0db1 \u0dd2\u0dad\u0db1\u0dca \u0db8\u0dcf\u0dd4\u0dc0 \u0db8\u0dd2\u0db1 \u0d85\u0db1 \u0db8\u0dd2\u0db1 \u0d85\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0dc1\u0db8\u0db1\u0dca\u0db1 \u0dc1\u0db8\u0dca \u0db7\u0dcf\u0da9\u0dd4\u0d9a\u0da9 \u0dd2\u0dc0\u0dba\u0dca \u0db1 VAT \u0d91\u0dc1\u0d9a\u0db1\u0dca \u0dd2 \u0daf\u0dc4\u0dc3\u0dc0\u0dd3 \u0d9a\u0db8\u0dcf \u0db1\u0db8\u0dca \u0d92\u0dc0\u0dcf\u0dc1 \u0db8\u0dd2\u0db1 \u0d85\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4\u0dc0\u0dc0\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf.\n\n\u0dba\u0db1\u0dca\u0db1 \u0db8\u0dc1\u0dad \u0dc1\u0daf\u0dba\u0dd2\u0dc1\u0dba\u0ddd! \u0d9a\u0dc1\u0da9\u0dca \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0db1\u0dcf \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dcf\u0daf? \u0d9a\u0dc1\u0da9\u0dca \u0d9c\u0dd2\u0dba\u0dcf\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0dbb\u0dc1\u0dda \u0daf\u0dd0\u0dc1\u0db1\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc4\u0dd0\u0db8 \u0d9a\u0dc1\u0da9\u0dca\u0db8 \u0d91\u0d9a\u0db8 \u0dad\u0dba\u0db1\u0da7 \u0dad\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dcf\u0daf? \u0d91\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0db8 \u0dc1\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d94\u0db3\u0dad\u0dd4\u0db8\u0db1\u0dca\u0db1\u0dcf \u0dc1\u0db4\u0dcf\u0dc1\u0dbb\u0dcf\u0db1\u0dca\u0daf\u0dd4 \u0dc1\u0dc0\u0da0\u0dca\u0da0\u0da0 \u0dc1\u0dda\u0dc0\u0dca . \u0dad\u0dc0\u0dad\u0dca \u0dc1\u0db8\u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0da7\u0dca\u0da7 \u0dad\u0dbb\u0dd4\u0dba \u0dad\u0dbb\u0dd4\u0dab\u0dd2\u0dba\u0db1\u0dca\u0da7 \u0dc1\u0db4\u0dcf\u0dc1\u0dbb\u0dcf\u0db1\u0dca\u0daf\u0dd4 \u0dc0\u0dd4\u0dc1\u0da9\u0dd4\u0d9a? \u0dba\u0db8\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dba\u0dca \u0d9a\u0dbb \u0dad\u0db1\u0dca\u0db1 \u0dca\u0db4\u0d9a\u0dbb\u0dba\u0dca \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0db3\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dca \u0db1\u0db3\u0dcf \u0dc1\u0daf\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0d91\u0dba \u0dc1\u0db8\u0dca \u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf\u0dc0\u0dd2\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dcf. \u0d92\u0d9a \u0d9a\u0dc1\u0db8\u0dcf\u0dad\u0dca \u0dc1\u0dc4\u0dcf\u0db3\u0dba\u0dd2. \u0dc1\u0db8\u0dca \u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf\u0dc0\u0dd2\u0dc1 \u0d92\u0d9a \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dca\u0db4\u0d9a\u0dbb\u0dba\u0dca \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0db3\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0dba\u0dba \u0dc1\u0daf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0d9a\u0dcf\u0dc1\u0dc4\u0dcf\u0db8\u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dc0\u0dd3\u0db1\u0dcf\u0dbb\u0dca\u0dae\u0dae\u0dba \u0d85\u0db4 \u0d89\u0dd2\u0db1\u0dbb\u0dd2\u0dc1 \u0d94\u0db3 \u0d89\u0dd2\u0db1\u0dbb\u0dd2\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dcf. \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0db1\u0db8\u0dca \u0db4\u0dd4\u0dd4\u0dc0\u0dc0\u0db1\u0dca. \u0d95\u0db1\u0dd1 \u0dad\u0dbb\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4\u0dc0\u0dc0\u0db1\u0dca. \u0dc4\u0dd0\u0db3\u0dd0\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0dc0\u0dcf\u0dc1\u0dda \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2 \u0d9a\u0dbb\u0db1\u0dcf \u0dc1\u0db4\u0db1\u0dca\u0db1\u0db1\u0dca\u0db1 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf.\n\n\u0d92 \u0dd2\u0dbd\u0dad\u0dbb\u0dca \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2 \u0dad\u0dc0 \u0dc1\u0daf\u0dba\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dcf. \u0dc1\u0db8\u0dcf\u0d9a\u0dca\u0daf \u0d92? \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0da7\u0dca\u0da7 \u0dc1\u0db8\u0dcf\u0d9a\u0dca\u0daf \u0dc0\u0dd4\u0dc1\u0da9\u0dd4\u0d9a? \u0dca\u0dba\u0dd2 \u0d85\u0dbb\u0dad\u0db8\u0dba\u0dca \u0dca\u0dad\u0dd2 \u0dc0\u0dd4\u0dc1\u0da9\u0dd4\u0d9a? \u0d92 \u0d9a\u0dcf\u0db1\u0dc1 \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0da7\u0dca\u0da7 \u0dc1\u0da9\u0dcf\u0db1\u0dbb\u0dca\u0dae \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dae\u0dba\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0dc4\u0dd2\u0db3\u0dd2\u0db1\u0dcf \u0d9c\u0dd2\u0dba\u0dcf. \u0dc3\u0d82\u0da0\u0dd2\u0dad \u0dad\u0dd2\u0dd4\u0dc1\u0da9\u0dd4\u0d9a \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0dad\u0dca \u0db1\u0dd0\u0dc0 \u0dc1\u0dad\u0db1\u0dca\u0dc0\u0dcf \u0dad\u0db1\u0dca\u0db1 \u0dd2\u0dbd\u0db0\u0dd2\u0dba\u0dca \u0dad\u0dd2\u0dd4\u0dc1\u0da9\u0dd4\u0d9a \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0db4\u0dcf\u0dc1\u0dc4\u0dcf\u0dbb \u0db1\u0dd0\u0dc0 \u0dc1\u0dad\u0db1\u0dca\u0dc0\u0dcf \u0dad\u0db1\u0dca\u0db1 \u0dd2\u0dbd\u0db0\u0dd2\u0dba\u0dca \u0dad\u0dd2\u0dd4\u0dc1\u0da9\u0dd4\u0d9a \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0db3\u0dc1\u0dc4\u0dad\u0dca \u0dd2\u0dad\u0d9a \u0dc1\u0dad\u0db1\u0dca\u0dc0\u0dcf \u0dad\u0db1\u0dca\u0db1 \u0dd2\u0dbd\u0db0\u0dd2\u0dba\u0dca \u0dad\u0dd2\u0dd4\u0dc1\u0da9\u0dd4\u0d9a \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0dd2\u0dd2 \u0dc3\u0dc0\u0dd3\u0dc3\u0dd4 \u0db4\u0dcf\u0dc1\u0dbb\u0dca\u0dae \u0db8\u0dd0\u0dbb\u0dd4\u0dba\u0dcf. \u0dc1\u0da9\u0dcf\u0db1\u0dbb\u0dca\u0dae \u0dc3\u0d82\u0da0\u0dd2\u0dad \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda\u0daf\u0dba \u0dc1\u0db8\u0dcf\u0d9a\u0dca\u0daf? \u0dbb\u0da7\u0dd2\u0dbd\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d91\u0dc0\u0db1 \u0db8\u0dd4\u0daf\u0dca \u0daf? \u0dc1\u0db8\u0dca \u0dbb\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0dc4\u0daf\u0db1\u0dca\u0db1 \u0dd2\u0dbd\u0dc1\u0dda \u0dbb\u0da7\u0dc0\u0db1 \u0d89\u0db1\u0dca\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0db1\u0dcf\u0d82\u0d9a\u0dd2\u0d9a \u0dc1\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a\u0dc1\u0dba\u0ddd \u0dca\u0dd2\u0dbd\u0dca \u0db1\u0dcf \u0da1\u0db1\u0dca\u0daf\u0dba \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf. \u0d92 \u0d85\u0dba \u0dc1\u0da9\u0dcf\u0db1\u0dbb\u0dca\u0dae 500 \u0dad\u0dba\u0dc1\u0db1\u0dca \u0db1\u0d82\u0d9a\u0dcf\u0dc0\u0da7 \u0d91\u0dc0\u0db1\u0dcf \u0d85\u0dc1\u0db4\u0dca \u0dc3\u0d82\u0da0\u0dd2\u0dad \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0d91\u0d9a \u0dc3\u0d82\u0d9c\u0dd3\u0dad\u0dad \u0d9a\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba\u0db8\u0d9a \u0db1\u0dcf\u0dba\u0d9a\u0dc1\u0dba\u0d9a\u0dd4 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0db8\u0db8 \u0daf\u0dd0\u0dca\u0d9a\u0dcf \u0d91\u0dba\u0dcf\u0dc1\u0dda \u0dba\u0dcf\u0dd4\u0dc0\u0dc0\u0db1\u0dca \u0db4\u0dd2\u0da7\u0dbb\u0da7\u0dc0\u0db1 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0d92 \u0dba\u0dcf\u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dcf \u0dc1\u0da9\u0dcf\u0db1\u0dbb\u0dca\u0dae 500 \u0dad\u0dba\u0dc1\u0db1\u0dca \u0d91\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dcf. \u0daf\u0dd0\u0db1\u0dca \u0d92 \u0dc3\u0d82\u0d9c\u0dd3\u0dad\u0dad \u0d9a\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba\u0db8\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0dba\u0dcf\u0dd4\u0dc0\u0dc1\u0dc0\u0ddd\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0dbb\u0db4\u0dd4 \u0dc1\u0da9\u0dcf\u0db1\u0dbb\u0dca\u0dae 500\u0d9a\u0dd4\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0db8 \u0dc1\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d94\u0db3\u0dad\u0dd4\u0db8\u0db1\u0dca\u0db1\u0dcf \u0dc1\u0dda\u0dd2\u0db1\u0d9a\u0dcf\u0dc1\u0dda \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0d92\u0dc0\u0dcf. \u0d91\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0dc1\u0db8\u0dca \u0da9\u0dc0\u0dbb\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0d9a\u0dca\u200d\u0dbb\u0ddd\u0db0\u0db1\u0dc1\u0dba\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2. \u0dc1\u0db8\u0dca \u0d85\u0dba \u0dc0\u0dd0\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0db8\u0dca \u0dc1\u0dda\u0dc0\u0dca \u0dd2\u0dad\u0d9a \u0d89\u0da7\u0dd4 \u0d9a\u0dbb\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dcf \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca\u0da7 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0db3\u0db1\u0dcf\u0dc1\u0db4\u0dcf\u0dc1\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0dd4\u0dba\u0dcf. \u0dc1\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0d9a\u0dcf\u0dbb\u0dba\u0dcf \u0dd2\u0dad\u0d9a \u0d89\u0da7\u0dd4 \u0d9a\u0db8\u0dcf \u0db1\u0db8\u0dca \u0d85\u0db4\u0da7 \u0d85\u0daf \u0dc1\u0dc4\u0dcf\u0db3 \u0db8\u0dcf\u0dc0\u0dad\u0d9a \u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4\u0dc0\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0dc1\u0dad\u0db1\u0dca \u0dca\u0dc1\u0dc4\u0db1 \u0d9a\u0dae\u0dcf\u0dc0 \u0dad\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2 . \u0dc4\u0dd0\u0db3\u0dd0\u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0dc0\u0db1 \u0dd2\u0dbd\u0da7 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0db1\u0dd0\u0dd4\u0dc1\u0da9\u0dd4\u0d9a \u0dc1\u0db8\u0dcf\u0db1\u0dc0\u0dcf\u0daf? \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0d89\u0dca \u0db1\u0db4\u0dd4 \u0dd2\u0dad\u0d9a \u0db8\u0db8 \u0daf\u0dd0\u0db1\u0dca \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0dad\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2 \u0dc1\u0db8\u0dcf\u0db1\u0dc0\u0daf \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0db1\u0dd0\u0dd4\u0dc1\u0da9\u0dd4\u0d9a?"
