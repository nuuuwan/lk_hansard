    "chunk_text": "\u0d94\u0db6\u0dd4 \u0db1\u0dca\u0dad\u0dbd\u0dcf\u0dc1\u0dda \u0d85\u0dba\u0dcf\u0dad \u0dc0\u0d9a\u0dc1\u0dda \u0dc3\u0dcf\u0dbb\u0dcf\u0dcf \u0dc1\u0dda \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0d8b \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba\u0dcf\u0dad\u0d9a\u0db8\u0dc0 \u0dc3\u0dcf\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba\u0dcf\u0dad \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dcf\u0dad\u0dca \u0dba \u0dd2\u0dba\u0dcf\u0dad\u0db1 35\u0d9a \u0db4 \u0dab \u0dd4\u0dc0\u0daf\u0dbd\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0dbd\u0dcf \u0dc4\u0d9a\u0db6\u0d9a\u0dba\u0dd2\u0d8b \u0d85\u0db4\u0dd2 \u0d94\u0d9a\u0dca\u0dc1 \u0d9a\u0dcf \u0daf\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf\u0d8b \u0d9a\u0dad\u0dd2\u0dc0\u0dbb\u0dab\u0dba\u0dcf\u0dad\u0d9a\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dc1\u0dda \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0db8 \u0d9a\u0dbb\u0db1 \u0d85\u0dba\u0dcf\u0dad \u0dc0\u0d9a\u0dba\u0dcf\u0dad\u0d9a\u0dca \u0db1\u0dd2\u0dc3\u0dcf \u0d94\u0db6\u0db8 \u0da2\u0db1\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad \u0dad\u0dd3\u0db1\u0dca\u0dad\u0daf\u0dd4 \u0dc1\u0dad\u0dcf\u0da9\u0dcf)\u0d9a\u0dca \u0d85\u0dbb\u0dc1\u0dad\u0db1 \u0dd4\u0dc0\u0daf\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0db1 \u0d91\u0d9a \u0dc4\u0d9a\u0db6\u0d9a\u0dba\u0dd2\u0d8b \u0d85\u0db4\u0dd2 \u0d94\u0d9a\u0dca\u0dc1\u0d9a\u0dcf \u0daf\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf\u0d8b \u0dc0\u0d9a\u0dc1\u0da7\u0db1\u0dca\u0dad\u0db1 \u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dc0\u0dc1 \u0dae \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0dbd\u0dcf \u0dad\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0dcf\u0dad\u0ddd\u0da2\u0dba \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dd2\u0dba\u0dcf\u0dad\u0db1\u0dd2\u0d8b \u0d85\u0db4\u0da7 \u0d85\u0dc0 \u0dba \u0dc0\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dd2 \u0db4\u0d9a\u0dca\u0dc2 \u0dc1\u0dda\u0daf\u0dba\u0dcf\u0dad\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0dc1\u0dad\u0dcf\u0dbb\u0dc0\u0d8b \u0d9a\u0dd2\u0dd2 \u0dc0\u0dbb\u0dca\u0dbd\u0dab \u0dc1\u0dda\u0daf\u0dba\u0dcf\u0dad\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0dc1\u0dad\u0dcf\u0dbb\u0dc0\u0d8b \u0dc1\u0dda \u0dbb\u0da7\u0da7 \u0db1\u0dd2\u0dbb\u0dca\u0dbd \u0dcf\u0dab\u0dc1\u0dd3\u0dbd\u0dd3 \u0dc0\u0dd2\u0dc3\u0db3\u0dd4 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dc1\u0d9a\u0dcf\u0dc1\u0dc4\u0dae\u0daf \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0dbd\u0dcf \u0dc1\u0dc3\u0dcf\u0dba\u0dcf\u0dad\u0dcf \u0dad\u0d9a\u0db1\u0dd3 \u0dba\u0dd2 \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dad \u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dc1\u0dba\u0dcf\u0dad\u0ddd\u0da2\u0db1\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad\u0d8b \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba\u0dcf\u0dad\u0d9a\u0db8\u0dc0 \u0dbb\u0dcf\u0da2\u0dba\u0dba\u0dcf\u0dad \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0db1 \u0d91\u0d9a \u0dc1\u0dda\u0d9a \u0d89\u0dad\u0dcf \u0dd2 \u0dba\u0dd4\u0dda\u0dc0 \u0dc0\u0da7\u0dc4\u0dcf \u0dad\u0dad \u0dba\u0dd4\u0dd4 \u0dc3\u0dcf\u0d9a\u0dca\u0db4\u0dba\u0dcf\u0dad\u0d9a\u0dca \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba\u0dcf\u0dad\u0d9a\u0db8\u0dc0 \u0dbb\u0dcf\u0da2\u0dba\u0dba\u0dcf\u0dad \u0dba\u0dcf\u0dad\u0db1\u0dd4 \u0dc4\u0dd4\u0daf\u0dd4 \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba\u0dcf\u0dad\u0d9a\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0dba \u0dc4\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3 \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2 \u0dbb\u0dcf\u0da2\u0dba\u0dc1\u0dda \u0db1\u0dc3\u0d8b \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba\u0dcf\u0dad\u0d9a\u0db8\u0dc0 \u0db1\u0dc3\u0d9a\u0dca \u0dc0\u0dd2\u0dba\u0dcf\u0dad \u0dba\u0dd4\u0dd4\u0dba\u0dd2 \u0dc1 \u0dcf\u0d9a\u0d9a\u0dca\u0daf\u0d8b \u0dc1\u0dda \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba\u0dcf\u0dad\u0d9a\u0db8\u0dc0 \u0db1\u0dc3\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad?\n\n\u0db1\u0dd2\u0