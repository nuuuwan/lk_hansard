 \u0dc1\u0d9a\u0dcf\u0da7\u0dc3\u0dca \u0dc4\u0dd0\u0dd2\u0dad\u0dba\u0da7 \u0dad\u0dd2\u0db6\u0dd2 \u0dba \u0dd4\u0d9a\u0dad\u0dd4\u0dba\u0dba\u0dd2 \u0dd2 \u0dc1\u0dba\u0ddd\u0dad \u0d9a\u0dbb\u0db1 \u0db1\u0daf\u0dd3.\n\n01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1.- \u0dc1\u0db8\u0dc1\u0dc4\u0dd4\u0d9a\u0db8\u0dca \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 - \u0db8\u0dd6\u0dbb\u0db1\u0db0\u0db1\u0db1 \u0dd2\u0dbd\u0dba\u0daf\u0db8\n\n\u0dbb\u0dd4. 413 000 000 \"245 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dae\u0dc2\u0dab\u0dc1\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0db8\u0dd6\u0dbb\u0db1\u0db0\u0db1\u0db1 \u0dd2\u0dbd\u0dba\u0daf\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4. 413 000 000\u0d9a \u0db8\u0dd4\u0daf\u0db1 \u0d8b\u0db4\u0dc1\u0dca \u0db1\u0dba\u0da7 \u0dca\u0dad\u0dd4\u0db8\u0dad\u0dca \u0d9a\u0db8 \u0dd4\u0d9a\u0dad\u0dd4\u0dba\" \u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dc0\u0dd3\u0db1\u0dba \u0dd2\u0dbd\u0db8\u0dc3\u0db1 \u0db1\u0dd2\u0db1\u0db1\u0dca \u0dc3\u0db7\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dd2\u0dbd\u0dba.\n\n245 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dae\u0dc2\u0dab\u0dc1\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0db8\u0dd6\u0dbb\u0db1\u0db0\u0db1\u0db1 \u0dd2\u0dbd\u0dba\u0daf\u0db8 \u0d8b\u0db4\u0dc1\u0dca \u0db1\u0dc1\u0dba\u0dc4\u0dd2 \u0dc1\u0d9a\u0dcf\u0da7\u0dc3\u0dca \u0dc4\u0dd0\u0dd2\u0dad\u0dba\u0da7 \u0dad\u0dd2\u0db6\u0dd2 \u0dba \u0dd4\u0d9a\u0dad\u0dd4\u0dba\u0dba\u0dd2 \u0dd2 \u0dc1\u0dba\u0ddd\u0dad \u0d9a\u0dbb\u0db1 \u0db1\u0daf\u0dd3.\n\n246 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dad \u0dba.- \u0dc0\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dca \u0dc0\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dad\u0dc0\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc0\n\n01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1.- \u0dc1\u0db8\u0dc1\u0dc4\u0dd4\u0d9a\u0db8\u0dca \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 - \u0db4\u0dd4\u0d