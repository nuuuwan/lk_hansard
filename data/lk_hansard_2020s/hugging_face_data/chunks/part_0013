0dcf 8\u0dae\u0db8\u0dd2\u0db1\u0dca8\u0d85\u0dca\u200d\u0dcf\u0db3\u0dca8\u0dbb\u0dae\u0dcf\u0dc1\u0dba \u0dc38\u0dae\u0db8\u0db1\u0dca\u0dcf8\u0d9a\u0dd2\u0dd2\u0dc0\u0db18 \u0db8\u0dae\u0db8\u0dcf\u0d9a\u0dd4\u0da78 \u0d85\u0dc0\u0db3\u0dca\u0dcf\u0dcf\u0dc08 \u0dbd\u0dd0\u0db8\u0db6\u0db1\u0dca\u0db8\u0db1\u0dca8 \u0dcf\u0dd0\u0dcf\u0dd0.8 8 \u0db3\u0dcf\u0db8\u0dda\u0d9a\u0dca\u0dba8\u0dc0\u0dc1\u0dba \u0dc3\u0db8 \u0db1\u0dca8\u0d9c\u0dca \u0db1\u0dcf\u0db188\u0d85\u0db4\u0dd28\u0dca\u200d\u0db1\u0dca\u0dcf\u0dc0\u0dcf 8\u0db1\u0dd1\u0db18\u0dae\u0dcf\u0dbd\u0db8 8\u0db8\u0dda8\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc08\u0dad\u0dd4\u0dc58\u0db4\u0d9a\u0dca\u0dba8\u0dd2\u0dbd\u0db4\u0d9a\u0dca\u0dba8\u0dd2\u0dc0 \u0dbd\u0dd4\u0db8\u0dca\u200d\u0dcf\u0dcf8\u0db3\u0db1\u0d9f8\u0daf\u0db1\u0dcf\u0db18\u0db8\u0dcf\u0ddc\u0dc48\u0db3\u0d82\u0dc0\u0dcf\u0dca\u200d\u0dc1\u0dd3\u0dbd\u0dd28 \u0db3\u0dcf\u0dae\u0da0\u0dca\u0da1\u0dcf\u0dc0\u0d9a\u0dca8 \u0dcf\u0dca\u200d\u0db1\u0dca\u0dcf8 \u0d85\u0dc0\u0db3\u0dca\u0dcf\u0dcf\u0dc08 \u0dbd\u0dd0\u0db6\u0dd2\u0dbd\u0dcf8 \u0dd2\u0d9a\u0db8\u0db6\u0dcf8 \u0db6\u0dc0.8\u0dcf\u0dd0\u0db6\u0dd0\u0dba\u0dd2 8 \u0d85\u0db4\u0da78 \u0dae\u0dcf\u0d9c\u0dcf\u0da7\u0dd4\u0dba\u0dd2 8 \u0da7\u0d9a\u0dca\u0db8\u0dae\u0db8\u0dcf\u0d9a\u0dca8 \u0db8\u0dca\u200d\u0db1\u0dca\u0db8\u0dcf\u0d9a\u0dca8 \u0daf\u0db1\u0dca\u0dcf\u0dc0\u0dcf 8\u0db8\u0db1\u0db1\u0dca\u0dcf8 \u0db8\u0dda8 \u0db3\u0dca\u200d\u0dcf\u0da0\u0dcf\u0db88 \u0dc3\u0dd3\u0db1\u0dcf\u0dc08 \u0db8\u0dca \u0dbb\u0dd4\u0dda8 \u0d9c\u0db1\u0dca\u0db8\u0db1\u0dca8 \u0dcf\u0dd0\u0dad\u0dd4\u0dc08 \u0dae\u0da7\u0dba\u0dd4\u0dad\u0dd48\u0dae\u0db8\u0dcf.8 \u0da78 \u0dc0\u0dcf\u0db8\u0d9c\u0dca\u0db0\u0db1\u0db18 \u0da7\u0dad\u0dd4\u0db1\u0db1\u0dca\u0dbd\u0dcf8 \u0db8\u0db1\u0db1\u0dd0\u0dcf\u0da78 \u0db4\u0dca 8 \u0dae\u0db8\u0dbd\u0dcf8 \u0da7\u0dda\u0dc08 \u0da78\u0db1\u0dcf\u0da2\u0dca\u200d\u0dcf\u0db1\u0dcf\u0dc0\u0db8\u0d9c\u0dca\u0db0\u0db18 \u0d85\u0db7\u0dd2\u0dbd\u0dcf\u0dba 8 8 \u0db8\u0dca \u0dbb\u0dd4\u0dda8 \u0d9c\u0db1\u0dca\u0db8\u0db1\u0dca8 \u0dcf\u0dd0\u0dad\u0dd4\u0dc0 8 \u0dae\u0da7\u0dba\u0dd4\u0dad\u0dd48\u0dae\u0db8\u0dcf.8 \u0db1\u0db18 \u0da7\u0db1\u0dd0\u0dcf\u0daf\u0dd38 \u0d87\u0dca \u0db1\u0da7\u0db18 \u0da78 \u0db1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0db8 \u0dcf8 \u0db8\u0dcf\u0ddd8 \u0db8\u0dca\u200d\u0db1\u0dca\u0dcf\u0dcf8\u0db1\u0dd2\u0db8 \u0ddd\u0da2\u0dca\u200d\u0dcf 8 \u0dae\u0db8\u0dcf8 \u0dbb\u0db8\u0daf\u0dca\u0dc1\u0dba \u0dc3\u0db8 8 \u0da2\u0dca\u200d\u0dcf\u0db1\u0dcf\u0dc08 \u0db8\u0dc0\u0dd4\u0dc0\u0db8\u0dc0\u0db1\u0dca8 \u0dae\u0dcf\u0d9c\u0dcf\u0da7\u0dd4\u0dc0\u0da78\u0db4\u0dca 8\u0db8\u0dc0\u0dcf\u0dc0\u0dcf.8\u0db8\u0db1\u0ddc\u0dae\u0dca\u200d 8\u0d85\u0db4\u0dd28\u0dc4\u0dd2\u0db1\u0db1\u0dca\u0db8\u0db1\u0dca8\u0dcf\u0dd0\u0dcf\u0dd0 8\u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd \u0d9a\u0dd48\u0dd2\u0dbd\u0db0\u0dd2 \u0da78\u0da78\u0dae\u0db8\u0dcf8 \u0dae\u0da7\u0dba\u0dd4\u0dad\u0dd48 \u0d9a\u0dd2\u0dd2\u0dc0\u0db8\u0db3\u0dda\u0dca \u0db18 8 \u0da7\u0dad\u0dd4\u0db1\u0db1\u0dca\u0dbd\u0dcf8 \u0db1\u0dd2\u0db8 \u0ddd\u0da2\u0dca\u200d\u0dcf 8 \u0dae\u0db8\u0dcf8\u0db1\u0dcf\u0da2\u0dca\u200d\u0dcf\u0db1\u0dc0\u0db8\u0d9c\u0dca\u0db0\u0db18\u0d85\u0db7\u0dd2\u0dbd\u0dcf\u0dba 8\u0da7\u0dae\u0dba\u0dd28\u0d9a\u0dd2 \u0dbd\u0dcf.\n\n\u0db8\u0db6\u0db8\u0dcf\u0dd2\u0dbd\u0db1\u0dca\u0db18\u0db3\u0dca\u0dad\u0dd4\u0dd2\u0d9a\u0dba\u0dd2. \u0dbb\u0dc0\u0dcf8\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0d85\u0dcf\u0dbb\u0dd6\u0daa8\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0dcf\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0bae\u0bc8\u0bae\u0bae\u0ba4\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0d9c\u0dbb\u0dd48 \u0dd2\u0db4\u0db3\u0dcf\u0da9\u0dca8 \u0db6\u0dd2\u0dbb\u0dba\u0dd4\u0daf\u0dd3\u0db1\u0dca8 \u0db1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db1\u0dcf.8 \u0d94\u0db6\u0dad\u0dd4\u0db1\u0dcf\u0da78 \u0dd2\u0dbd\u0dcf\u0dcf 8 6\u0dae8\u0dae\u0dcf\u0dbd \u0d9a\u0dca8\u0dbd\u0dd0\u0db8\u0db6\u0dcf\u0dc0\u0dcf.\n\n[\u0baa\u0bbf.\u0baa. 4.04]\n\n\u0dbb\u0dc0\u0dcf8\u0dd2\u0dc3\u0dc3\u0dcf\u0da9\u0dca8\u0db6\u0dd2\u0db1\u0dd4\u0dad \u0da2\u0db1\u0dca8\u0dcf\u0dd4\u0dcf\u0dcf8 (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bb1\u0bbf\u0bb8\u0bbe\u0b9f\u0bcd \u0baa\u0ba4\u0bbf\u0baf\u0bc1\u0ba4\u0bc0\u0ba9\u0bcd) (The Hon. Rishad Bathiudeen) \u0baa\u0bbf\u0bb8\u0bcd\u0bae\u0bbf\u0bb2\u0bcd\u0bc8\u0bbe\u0bb9\u0bbf\u0bb0\u0bcd \u0bb0\u0bb9\u0bcd\u0bae\u0bbe\u0ba9\u0bbf\u0bb0\u0bcd \u0bb0\u0bb9\u0bc0\u0bae\u0bcd.\n\n\u0b9a\u0b95\u0bcc\u0bb0\u0bb5 \u0ba4\u0bae\u0bc8\u0bae\u0bae\u0ba4\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0b9a\u0bb3, \u0b87\u0ba9\u0bcd\u0bae\u0bb1\u0baf \u0ba4\u0bbf\u0ba9\u0bae\u0bcd \u0b95\u0bc1\u0bb1\u0bcd\u0bb1\u0b9a\u0bcd \u0b9a\u0bc6\u0baf\u0bb2\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bb5\u0bb0\u0bc1\u0bae\u0bcd\u0baa\u0b9f\u0bbf\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0bae\u0bbe\u0ba9 \u0b92\u0bb0\u0bc1 \u0bc6\u0b9f\u0bcd\u0b9f\u0bae\u0bc2\u0bc8\u0bae\u0bcd \u0b9a\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0ba9 \u0bb5\u0bbf\u0bb5\u0bbe\u0ba4\u0bae\u0bcd \u0ba8\u0bae\u0b9f\u0b9a\u0baa\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd \u0b9a\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0b86\u0ba4\u0bb0\u0bb5\u0bbe\u0ba9\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd; \u0b87\u0ba8\u0bcd\u0ba4\u0b9a\u0bcd \u0bc6\u0b9f\u0bcd\u0b9f\u0bae\u0bc2\u0bc8\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0b9a\u0ba4\u0bae\u0bb5\u0baf\u0bbe\u0ba9\u0ba4\u0bc1; \u0b85\u0ba4\u0bae\u0ba9\u0b95\u0bcd \u0b9a\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0ba8\u0bcd\u0ba4\u0bae\u0bae\u0b95\u0bcd\u0b95\u0bbe\u0b95 \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0ba9\u0bcd\u0bb1\u0bbf \u0b9a\u0bc6\u0bbe\u0bb2\u0bcd\u0bb2\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0b9a\u0bb1\u0bbe\u0bae\u0bcd. \u0b86\u0ba9\u0bbe\u0bb2\u0bcd, \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0b9a\u0bc8\u0baf\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b85\u0ba4\u0bbf\u0b95\u0bae\u0bbe\u0ba9 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b86\u0ba4\u0bb0\u0bae\u0bb5\u0baa\u0bcd \u0b9a\u0baa\u0bb1\u0bcd\u0bb1\u0bc1 \u0bb5\u0ba8\u0bcd\u0ba4 \u0b87\u0ba8\u0bcd\u0ba4 \u0b85\u0bb0\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd - \u0bc6\u0bbf\u0b99\u0bcd\u0b95\u0bb3 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bb2\u0bcd\u0bc8, \u0ba4\u0bae\u0bbf\u0bb4\u0bcd, \u0bae\u0bc1\u0bb8\u0bcd\u0bb2\u0bbf\u0bae\u0bcd, \u0bae\u0bae\u0bc8\u0baf\u0b95 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bae\u0ba9\u0bb5\u0bbe\u0bbf\u0ba9\u0ba4\u0bc1\u0bae\u0bcd\n\n147 148\n\n[\u0d9c\u0dbb\u0dd48\u0d85\u0dd4\u0dc0\u0db88\u0dae\u0dbb\u0dd4\u0dab\u0dcf\u0dd2\u0d9a\u0dbd\u0dae8\u0db1\u0dcf\u0db1\u0dcf8]\n\n2025 \u0d85\u0db8\u0dbb\u0dda\u0dbd\u0dca 08"
