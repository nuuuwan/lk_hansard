dc1\u0dda \u0d8b \u0d85\u0db4\u0dd2 \u0d92 \u0d9a\u0dbb\u0dca\u0dbd \u0dcf\u0db1\u0dca\u0dad\u0dad \u0dc3\u0db3\u0dc4\u0dcf \u0dd2 \u0dba\u0dcf\u0dad\u0dbd\u0dd4 \u0db4\u0dc4\u0dd4\u0db1\u0d9a\u0dda \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0db8\u0dd2\u0d9a \u0da2\u0db1\u0db4\u0daf\u0d8b \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0db8\u0dd2\u0d9a \u0dad\u0dda \u0dcf\u0db1 \u0d87\u0dad\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0dcf\u0dc1\u0dbb\u0dcf\u0db8\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0d92\u0d9a\u0db8 \u0d91\u0d9a \u0dad\u0dda \u0dcf\u0db1\u0dba\u0dcf\u0dad \u0dd4 \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0db1\u0dd2\u0dc2\u0dae\u0db4\u0dcf\u0daf\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0db1 \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2\u0d8b \u0d9a\u0dab\u0dd2\u0d9a\u0dca \u0db1\u0dda\u0d8b \u0d92 \u0d9a\u0dbb\u0dca\u0dbd \u0dcf\u0db1\u0dca\u0dad\u0dad\u0db4\u0dd4\u0dbb\u0dc1\u0dda \u0d9a\u0dab\u0dd2\u0d9a\u0dca \u0dca\u0dca\u200d\u0dbb\u0dd2\u0dad \u0db1\u0dd2\u0dc2\u0dae\u0db4\u0dcf\u0daf\u0db1\u0d8b \u0dc3\u0dda \u0db7\u0dcf\u0da9\u0dd4\u0d9a\u0da9\u0dcf) \u0db1\u0dda\u0d8b \u0d92 \u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0dc1\u0dda \u0db1\u0dd2\u0dc2\u0dae\u0db4\u0dcf\u0daf\u0db1 \u0dad \u0dba\u0dd2 \u0d92 \u0d9a\u0dbb\u0dca\u0dbd \u0dcf\u0db1\u0dca\u0dad\u0dad\u0db4\u0dd4\u0dbb\u0dc1\u0dda \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1 \u0d92 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0dcf\u0dad\u0da7 \u0d92 \u0d92 \u0d9a\u0dbb\u0dca\u0dbd \u0dcf\u0db1\u0dca\u0dad\u0dad\u0dba\u0dcf\u0dad\u0da7 \u0dd4\u0db1\u0dc0\u0dd2\u0dc1 \u0dae\u0dc2\u0dd3 \u0dc0\u0dd6 \u0d9a\u0dbb\u0dca\u0dbd \u0dcf\u0db1\u0dca\u0dad\u0dad\u0db4\u0dd4\u0dbb \u0d85\u0db4\u0dd2 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dc1\u0dda\u0daf\u0dd3 \u0dca\u0dbb\u0dda\u0db7 \u0d9a\u0dd2\u0dbb\u0dd3 \u0dc3\u0db3\u0dc4\u0dcf \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0dc3\u0d9a\u0dbd\u0dd4\u0db1\u0dda \u0d9a\u0dbb\u0db1\u0dc0\u0dcf"
