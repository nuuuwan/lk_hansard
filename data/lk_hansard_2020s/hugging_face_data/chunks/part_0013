4\u0bbf\u0b9f\u0bcd\u0b9f \u0b85\u0bb3\u0bb5\u0bc1 \u0ba4\u0b9a\u0bb2\u0bb5\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\n\n\u0ba4\u0ba4\u0bbe\u0b95\u0b95 (\u0bb0\u0bc2.)\n\n2021 10 11,834,740.48\n\n2024 2 121,147,139.41\n\n\u0ba4\u0bae\u0bbe\u0ba4\u0bcd\u0ba4\u0bae\u0bcd 12 132,981,879.89\n\n(\u0b86) (i) \u0b87\u0ba4\u0bc1 \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0ba8\u0bbf\u0ba4\u0bbf\u0baf\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0baa\u0baf\u0ba9\u0bbe\u0bb3\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b89\u0b95\u0bc8\u0baa\u0bcd\u0b95\u0baa\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0bcd \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0bb5\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0b9a\u0ba4\u0bbf\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bbe\u0b95\u0bc1\u0bae\u0bcd. \u0b87\u0ba8\u0bcd\u0ba4 \u0ba4\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95\u0b9a\u0bcd \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bc0\u0bb0\u0bcd\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bc1\u0b95\u0bb3\u0bbf\u0ba9\u0bcd\u0baa\u0b9f\u0bbf, \u0ba4\u0b9a\u0baa\u0bcd\u0ba4\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bcd 20, 2020 \u0b85\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba8\u0bbf\u0b95\u0bb1\u0bb5\u0b95\u0b9f\u0ba8\u0bcd\u0ba4\u0ba4\u0bc1.\n\n(ii) \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0b9f\u0baf \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0b95\u0b95\u0bb3\u0bbf\u0ba9\u0bcd\u0baa\u0b9f\u0bbf, \u0b87\u0ba8\u0bcd\u0ba4\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95\u0b9a\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0ba4\u0bbe\u0b95\u0b95 \u0bb0\u0bc2. 1,017,677.60 \u0b86\u0b95\u0bc1\u0bae\u0bcd.\n\n\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95\u0b9a\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0ba4\u0bbe\u0b95\u0b95 - \u0bb0\u0bc2. 978,536.15\n\n\u0ba4\u0bae\u0bb2\u0bbe\u0ba3\u0bcd\u0b95\u0bae\u0b9a\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95\u0b9a\u0bcd - \u0bb0\u0bc2. 39,141.45 \u0ba4\u0b9a\u0bb2\u0bb5\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0ba4\u0bbe\u0b95\u0b95 --------------------\n\n\u0ba4\u0bae\u0bbe\u0ba4\u0bcd\u0ba4\u0ba4\u0bcd \u0ba4\u0ba4\u0bbe\u0b95\u0b95 - \u0bb0\u0bc2. 1,017,677.60\n\n=============\n\n(iii) \u0bae\u0bc1\u0bb4\u0bc1\u0ba4\u0bcd \u0ba4\u0ba4\u0bbe\u0b95\u0b95\u0baf\u0bc1\u0bae\u0bcd \u0ba4\u0b9a\u0bb2\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n(\u0b87) \u0b8f\u0bb1\u0bcd\u0baa\u0bc1\u0b95\u0b9f\u0baf\u0ba4\u0ba9\u0bcd\u0bb1\u0bc1.\n\n\u0d9c\u0dbb\u0dd4 \u0d9a\u0dd2\u0da7\u0dca\u0db1\u0db1\u0dca \u0dc0\u0dc3\u0dbd\u0dca\u0dc0\u0dbb\u0dcf\u0da2\u0dca \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b95\u0bbf\u0b9f\u0bcd\u0bc8\u0ba9\u0bcd \u0ba4\u0b9a\u0bb2\u0bcd\u0bb5\u0bb0\u0bbe\u0b9c\u0bcd) (The Hon. Kitnan Selvaraj) \u0ba4\u0b95\u0bcc\u0bb0\u0bb5 \u0baa\u0bbf\u0bb0\u0ba4\u0bbf \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0ba4\u0bb3, \u0b8e\u0ba9\u0ba4\u0bc1 \u0bae\u0bc1\u0ba4\u0bb2\u0bbe\u0bb5\u0ba4\u0bc1 \u0ba4\u0bae\u0bb2\u0ba4\u0bbf\u0b95 \u0bb5\u0bbf\u0ba9\u0bbe\u0b95\u0bb5\u0b95\u0bcd \u0ba4\u0b95\u0b9f\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0ba4\u0bb1\u0ba9\u0bcd."
