    "chunk_size_bytes": 3378,
    "chunk_text": "\u0d8a\u0dcf\u0d9f\u0da7 \u0dc1 \u0dd2\u0db4 \u0dc5\u0dba\u0dc0\u0dd2\u0db1\u0dd2 \u0dc0\u0d9c \u0dad\u0dba \u0dc1 \u0dba\u0dd2 . \u0dad \u0db4\u0dad \u0dc1\u0d9c\u0dc0\u0d9c\u0dc1\u0d9c\u0db1 \u0dab\u0dd4\u0dba \u0db6\u0daf\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dcf\u0dc0 \u0d9c\u0dab\u0db1\u0dba \u0d9a\u0dd0 \u0db6\u0dbd\u0d9c \u0dad\u0dc0 \u0d85 \u0dad\u0dd0 \u200d\u0dbb \u0d9c\u0dab\u0dba\u0dca\u0dad \u0dc1\u0d9c\u0dc0\u0dd2\u0dba \u0dd4\u0dad \u0dc3 \u0db1 \u0dc3 \u0dc0 \u0dd0 \u0d85\u0dc0 \u0d9c\u0db1\u0dc1\u0d86\u0daf\u0dd3 \u0d92 \u0d91\u0d9a \u0dc3\u0dc0 \u0d9c\u0dab\u0db1\u0dba \u0d9a\u0dd0\u0dbd\u0d9c \u0dad \u0dd2 \u0d91\u0dba \u0dc1\u0d9c\u0dc0\u0db4\u0dad\u0db1\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db4\u0dad\u0dc1\u0db4\u0dad. \u0dc1 \u0dc3 \u0dba\u0db1\u0d9c\u0daf\u0dd3 \u0dc5\u0db1 \u0dbb\u0dd0 \u0dca\u0dad \u0d91\u0dca\u0dad\u0d9a \u0dad \u0dd2 \u0dc1 \u0dc3 \u0dc0\u0dd2\u0da9\u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dca\u0dad \u0db4\u0dcf\u0db8\u0dd4\u0dc0\u0dd2\u0db1\u0dd2 \u0dc0\u0dad\u0d9c\u0dc1\u0dda \u200d\u0dbb\u0dd2\u0dba\u0d9c\u0dad\u0dca \u0d9a \u0d9a\u0dd0\u0db4\u0dad\u0db1 \u0dbb\u0dd0 \u0dc3\u0db7 \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db4\u0dad\u0dc1\u0db4\u0dad.\n\n\u0d85\u0db4\u0dd2 \u0daf\u0db4\u0dad\u0db1\u0dc0\u0d9c, \u0dc1 \u0dc3 \u0db6\u0daf\u0dd4 \u0d9a\u0dca\u200d\u0dbb \u0dba \u200d\u0dbb\u0dd2\u0dba\u0d9c\u0dad\u0dca \u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1 \u0dc3\u0daf\u0dd3 \u0d9c\u0db1\u0d9c\u0dd0\u0dab\u0dad\u0dca\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dcf \u0db8\u0dd6\u0dbd\u0db1\u0dbb\u0dca \u0dba \u0d85\u0db4\u0da7 \u0d85\u0db1\u0dd4\u0d9c \u0db1\u0dba \u0d9a\u0dd0\u0db4\u0dad\u0db1\u0da7 \u0dc1\u0dc0\u0db1\u0dc0\u0d9c \u0d9a\u0dd2\u0dba\u0dbd\u0d9c.\n\n\u0d9c\u0dbb\u0dd4 \u0d9a\u0dcf\u0d9c\u0db1\u0d9c\u0dba\u0d9a \u0dc3 \u0db1\u0dd2, \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0dba\u0daf \u0d85\u0d9a\u0dca \u0d9a\u0dd0\u0db1 \u0db6\u0dc0 \u0dbb\u0daf\u0dbb\u0dca \u0dc1\u0dba\u0db4\u0dad \u0dc1\u0db4\u0db4\u0dad\u0dc0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d92 \u0dcf\u0dc5\u0d9c \u0dc0\u0db1 \u0dc0\u0dd2\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dcf \u200d\u0dbb\u0dd2\u0dba\u0d9c\u0dad\u0dca \u0d9a \u0d9a\u0dd0\u0db4\u0dad\u0db1 \u0db4\u0da7\u0db4\u0dad \u0d85\u0dd0\u0dc1\u0d9c\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d92\u0dc0\u0d9c\u0dc1\u0d86 \u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dbd \u0dad \u0dd2 \u0dc1 \u0dc3 Budget \u0d91\u0d9a \u0dc3\u0dc5\u0dd2\u0db4\u0dad \u0dc1\u0db4\u0dc1\u0db1\u0db4\u0dad\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db4\u0dad\u0dc1\u0db4\u0dad. \u0d85\u0dc1\u0db4\u0dca \u0dc0\u0dd2\u0dc1\u0daf\u0dca \u0dab\u0dba\n\n\u0d9c\u0dd2\u0db1\u0dd3 \u0dc3 \u0d85\u0dc0 \u0d9a\u0dd0 \u0d9c\u0db4\u0dad\u0db1\u0da7 \u0dc5\u0dd2\u0d9a\u0dd2\u0dba\u0d9c\u0dc0 \u0dbd\u0dd2\u0db6\u0dd2\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d92 \u0dc0\u0d9c\u0dc1\u0dda \u0dc1\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc0 \u0dc1\u0dba\u0db4\u0dad \u0dab\u0dba \u0d9c\u0dd2\u0db1\u0dd3 \u0dc3 \u0d85\u0dc0 \u0d9a\u0dd0 \u0d9c\u0db4\u0dad\u0db1\u0da7 \u0d85\u0db4\u0da7 \u0dc5\u0dd2\u0d9a\u0dd2\u0dba\u0d9c\u0dc0 \u0dbd\u0dd2\u0db6\u0dd2\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d92 financial discipline \u0d91\u0d9a \u0db1\u0dd2 \u0d9c, \u0db8\u0dd6\u0dbd\u0dd9 \u0d9a\u0dcf \u0db1\u0d9c\u0d9a\u0dd0\u0dab\u0dba \u0db1\u0dd2 \u0d9c. \u0d92\u0d9a \u0dc0 \u0db1\u0dc1\u0dba\u0db4\u0dad \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0d9c\u0da7 \u0dc0\u0da9\u0d9c \u0d85\u0db4\u0da7 \u0dc1\u0db4\u0dc1\u0db1\u0db4\u0dad\u0db1\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0dd0\u0dba\u0dba \u0dad \u0dd2 \u0dc1 \u0dc3\u0dc0\u0dca\u0dad \u0d9a\u0dbd\u0dca \u0dd0\u0dc1\u0da7\u0dca \u0db6\u0dd2\u0dc0\u0d9a\u0dd4 \u0db4\u0daf\u0dca\u0db1\u0dad\u0dd2\u0dc1\u0dba\u0db4\u0dad \u0dc0\u0dd2 \u0d9c\u0dbd \u0dab\u0dba \u0d9c\u0db4\u0dad\u0db1\u0d9c \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dd2\u0db4\u0da7\u0dd2\u0dc1\u0d86. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dc1 \u0dc3 \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0d9a\u0dca\u200d\u0dbb \u0dc1\u0dda\u0daf\u0dba \u0dc3\u0dcf \u0dd0\u0dba\u0dba \u0dc0\u0dd2 \u0dad\u0db4\u0dad \u0dc1\u0dc0\u0dcf\u0dcf\u0dc1\u0db4\u0ddc\u0dc1\u0dcf\u0db4\u0dad \u0d9c\u0db4\u0dad\u0db1 \u0dab\u0dba \u200d\u0dbb \u0d9c\u0dab\u0dba \u0da7\u0dd2\u0dc1\u0d9a\u0db4\u0dad \u0da7\u0dd2\u0d9a \u0d85\u0d9a\u0dca \u0dc1\u0dc0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db1\u0dd2 \u0d9c \u0d85\u0db4\u0da7 \u0dc1\u0db4\u0dc1\u0db1\u0db1\u0dc0\u0d9c, market \u0d91\u0dc1\u0dca\u0dad \u0dad\u0dd2\u0dc1\u0db6\u0db1 interest rate \u0d91\u0d9a \u0d85\u0d9a\u0dca \u0dc1\u0dc0\u0dbd\u0d9c, \u0d85\u0d9a\u0dca \u0dc1\u0dc0\u0dbd\u0d9c \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0d9c, \u0daf\u0dd0\u0d9c \u0d9c\u0db4\u0dad\u0db1 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad \u0da7\u0dca\u0da7 \u0d9a\u0da7 \u0db4\u0dc5\u0dcf\u0da7 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db6\u0dc0. \u0d85\u0db4\u0dd2 \u0dc3\u0da7\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0d9c, \u0dc1 \u0dba \u0da7 \u0da7\u0dad\u0dca \u0dc0\u0da9\u0d9c \u0dad\u0dc0 \u0da7\u0dd2\u0d9a\u0dca\u0dad \u0db4\u0dc5\u0dcf\u0da7 \u0dab\u0dd4\u0dc1\u0dba\u0ddc\u0dad\u0dca. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dc1 \u0dc3 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d85\u0dc0 \u0dcf\u0d9c\u0dc1\u0dda \u0dc5\u0dd2\u0da7\u0dd2\u0dba\u0da7 \u0d92\u0dc1\u0d9a\u0db4\u0dad \u0dc1\u0db4\u0db4\u0dad\u0db1\u0dd4 \u0dc3 \u0d9a\u0dd0\u0db4\u0dad\u0dc1\u0db4\u0dad \u0dc1 \u0dc3 \u0dd0\u0dba\u0dc1\u0d86 \u0db8\u0dd6\u0dbd\u0dd9 \u0d9a\u0dcf \u0db1\u0d9c\u0d9a\u0dd0\u0dab\u0dc1\u0d86 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d9c\u0dbb\u0dca\u0dcf\u0d9a\u0dad\u0dca\u0dc0\u0dba\u0dd2 . \u0dc1 \u0ddc\u0d9a\u0daf, \u0d9c \u0d9a\u0dd2\u0dd2\u0db4\u0db4\u0dba\u0dca\u0dad \u0d87 \u0dc3\u0dcf\u0dad \u0d89\u0dad\u0d9c \u0d9c\u0dbb\u0dca\u0dcf\u0d9a \u0dc1\u0dbd \u0dc1 \u0dc3 \u0dc0\u0dd2\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dcf \u200d\u0dbb\u0dd2\u0dba\u0d9c\u0dad\u0dca \u0d9a \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0dad\u0dc0 \u0d9c \u0db1\u0dca\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0dba\u0db4\u0dad\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0dc1 \u0dc3\u0d9a \u0dad\u0dc0 improve \u0d9a\u0dd0 \u0d9c\u0db4\u0dad\u0db1\u0da7 \u0d85\u0db4\u0da7 \u0d85\u0dc0 \u0dd9 \u0d9a\u0dd0\u0db1\u0dc0\u0d9c. \u0d92, \u0d91\u0d9a \u0dc1\u0d9a\u0ddc\u0da7 \u0dca\u0dad."
  },
