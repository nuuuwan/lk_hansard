    "chunk_text": "1973\u0daf\u0dd3 - \u0dc0\u0dd2\u0dc0\u0dca\u0dad \u0dca\u0dbb\u0dca\u0dbd\u0dd2\u0d9a\u0dba\u0dcf\u0dad\u0da7\u0db8 \u0d9a\u0dd2\u0db1\u0dca\u0dad - \u0dc4\u0daf\u0db4\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf)\u0dcf \u0db4\u0db1\u0dad\u0d9a\u0dca \u0dad \u0dba\u0dd2 \u0d85\u0db4\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dc0\u0dca\u0dad \u0dca\u0dbb\u0dca\u0dbd\u0dd2\u0d9a\u0dba\u0dcf\u0dad\u0da7\u0db8 \u0d9a\u0dd2\u0db1\u0dca\u0dad \u0dc4\u0daf\u0db4\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf)\u0dcf \u0db4\u0db1\u0dad \u0d87\u0dd4\u0dc1 \u0dae \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf)\u0dcf\u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dba\u0dcf\u0dad\u0d9a\u0dc1\u0db4\u0db1\u0dca\u0dad\u0db1\u0db1\u0dca\u0dad\u0dc1\u0dda \u0dc3\u0dcf\u0dad \u0dba\u0dcf\u0dad\u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0dcf\u0dad\u0da7\u0dba\u0dd2 \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0dba\u0dcf\u0dad\u0d9a\u0dc1\u0db4\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1 \u0daf\u0d9a\u0db1\u0dca\u0dad \u0dc1\u0dbd\u0ddd\u0d9a\u0dc1\u0dda \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf)\u0dcf \u0dca\u0dbb\u0dca\u0dbd\u0dd2\u0d9a\u0dba\u0dcf\u0dad \u0dc1\u0da9\u0dcf)\u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0da7\u0dca\u200d\u0dbb\u0dd2\u0dd2\u0dba\u0dcf\u0dad\u0db1 2 3\u0d9a\u0dca \u0dc3\u0dcf\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba\u0dcf\u0dad \u0dc0\u0db1 \u0dbb\u0da7\u0d9a GDP \u0d91\u0dc1\u0d9a\u0db1\u0dca\u0dad \u0dd2 \u0dba\u0dcf\u0dad\u0dba\u0dcf\u0dad\u0da7 2\u0db8\u0d8b 3\u0db8 \u0d85\u0dad\u0dbb \u0dca\u0daf\u0dcf\u0dba\u0dcf\u0dad \u0d9a\u0dca \u0dc3\u0db8\u0db4\u0dcf\u0daf\u0db1\u0dba\u0dcf\u0dad \u0d9a\u0dbb\u0db1 brand \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0dcf\u0dad\u0da7, brand values\u0dc0\u0dd2\u0db1\u0dca\u0dad \u0dc1\u0da9\u0dcf)\u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0dba \u0dd2\u0dba\u0dcf\u0dad\u0db1\u0dba\u0dcf\u0dad \u0d89\u0d9a\u0dca \u0dc0\u0dcf \u0d9c\u0dd2