    "chunk_text": "\u0dc3\u0dcf\u0dba\u0dd4\u0d9a\u0dca\u0dad \u0dc0\u0d9a\u0da9\u0dcf) \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0 \u0d9a\u0da7 \u0d85\u0dc1\u0db4\u0dca \u0dc1\u0dda \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dcf \u0dcf\u0dbb\u0dca\u0dbd\u0dad \u0dc1\u0dba\u0dcf\u0dad\u0dcf\u0dd4\u0dc0 \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0db1 \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0dcf\u0dad \u0dad\u0dba\u0dd2 \u0dc1 \u0dcf\u0d9a\u0daf\u0d8b \u0dc0\u0dd2 \u0dcf\u0dbd \u0dc0\u0dba\u0dcf\u0db4\u0dca\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dab\u0dba\u0dcf\u0dad\u0d9a\u0dca \u0d9c\u0dd2\u0dba\u0dcf\u0dad\u0dcf\u0da7 \u0dc0\u0d9a\u0da9\u0dcf)\u0d9a\u0dca \u0db1\u0d9a\u0dc4\u0d9a\u0d8b \u0dad\u0dcf\u0dbb\u0dd4\u0dab\u0dba\u0dba\u0dcf\u0dad \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0dc1\u0daf\u0db1\u0dca\u0dad \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0daf\u0d8b \u0dcf\u0dc3\u0dc1\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0dcf\u0dc3\u0dba\u0dcf\u0dad \u0dc1\u0d9a\u0dcf\u0dba\u0dd2 \u0daf\u0dd2 \u0dcf\u0dc0\u0da7 \u0daf \u0dc1\u0dad\u0db1\u0dd2\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0db1 \u0d91\u0d9a \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc1\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0dc1\u0dc4\u0dcf\u0daf \u0dbd\u0dba\u0dd2\u0db1\u0dca\u0dad \u0d91\u0d9a\u0d9a\u0dca \u0d85\u0db4\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0db1\u0da7 \u0d95\u0db1\u0dd1 \u0dc0\u0dd2\u0dc1 \u0dae\u0dc2\u0dc1\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dc0\u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0dcf\u0dad\u0da7 \u0d85\u0db4\u0dd2 \u0d92\u0d9a \u0dc0\u0dd2\u0dc1 \u0dae\u0dc2\u0dc1\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0dc3\u0dbd\u0d9a\u0dcf \u0db6\u0dbd\u0db4\u0dd4 \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0dcf\u0dad\u0d9a\u0dca \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0dad\u0dbb\u0dd4\u0dab\u0dba\u0dcf\u0dad\u0dcf\u0da7 \u0db4\u0dca\u200d\u0dbb \u0dae\u0db1 