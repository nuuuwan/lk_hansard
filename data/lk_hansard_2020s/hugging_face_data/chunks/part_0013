    "chunk_text": "\u0dad\u0dc0\u0dad\u0dca \u0d9a\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba\u0db8\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0db8\u0dd0\u0daf \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dc1 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0. \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0dc3\u0dd0\u0d9f\u0dc0\u0dd4\u0dab\u0dd4 \u0daf\u0dd4\u0db4\u0dca\u0db4\u0dad\u0dd4\u0db1\u0dca the \"hidden poor\" \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1\u0db8\u0dcf\u0d9a\u0daf \u0d85\u0dbb\u0dca\u0dae\u0dd4\u0daf\u0dba\u0dad\u0dca \u0d91\u0dca\u0d9a \u0dbb\u0da7 \u0db3\u0d82\u0dc1\u0d9a\u0dcf\u0dc1\u0db1\u0dcf\u0dad\u0dca\u0db7\u0dcf\u0dc0\u0dba\u0da7 \u0db4\u0dad\u0dca \u0dc0\u0dd4\u0dba\u0dcf\u0da7 \u0db4\u0dc3\u0dd4\u0dc0 \u0dd2\u0dbd\u0daf\u0dd4\u0dd2 \u0db6\u0dd2 \u0db1 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd4\u0dba\u0dcf; \u0dad\u0dd1\u0dc3\u0dc0\u0dd3 \u0db8\u0dd2\u0db1 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd4\u0dba\u0dcf; \u0dc1\u0dad\u0dca \u0db8\u0dd2\u0db1 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd4\u0dba\u0dcf; \u0dc1\u0db4\u0dcf\u0dbd\u0dd3 \u0d85\u0db1\u0dd4\u0db4\u0dcf\u0dad\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd4\u0dba\u0dcf; van hire \u0d91\u0d9a\u0da7 \u0dc1\u0dad\u0dc0\u0db1 \u0dad\u0dba\u0db1 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd4\u0dba\u0dcf. \u0dad\u0db8\u0db1\u0dca\u0dc1\u0dda \u0dc3\u0dd3\u0db8\u0dd2\u0dad \u0db4\u0da9\u0dd2\u0dba\u0dad\u0dca \u0d91\u0dca\u0d9a \u0d92 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0d94\u0dc1\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4 \u0dc1\u0daf\u0db1\u0dca\u0db1 \u0db3\u0dd0\u0dbb\u0dd2\u0dc0 \u0dd2\u0dbd \u0dcf\u0db1 \u0db4\u0dd3\u0da9\u0db1\u0dba\u0d9a\u0da7 \u0db1\u0dca \u0dc1\u0dc0\u0da0\u0dca\u0da0\u0da0 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dca \u0dc4\u0dd2\u0dd2\u0dad\u0dba\u0dcf. \u0d92 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3 \u0dad\u0dd4\u0db8 \u0dc4\u0dd2\u0dd2\u0dad\u0dba\u0dcf \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0dc1\u0dc3\u0dc0\u0dd3\u0dc0\u0d9a\u0dba\u0db1\u0dca \u0dc1\u0db4\u0dde\u0dda\u0dad\u0dd2\u0d9a \u0d85\u0d82 \u0dc1 \u0dd2\u0dbd\u0db0\u0db1\u0dcf\u0dba\u0d9a \u0dd2 \u0db1\u0db0\u0db1\u0dcf\u0dbb\u0dd2\u0db1\u0dca \u0dbb\u0daf\u0dd3 \u0dd2\u0dbd\u0dd2\u0dbd\u0db0\u0db1 \u0dca\u0dc1\u0dc2\u0dab\u0dc0\u0dd3\u0dbb \u0dd2 \u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0db4\u0dc4\u0db8 \u0db8\u0dd0\u0daf \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dc1 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0.\n\n\u0dc0\u0dd4\u0dab\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dba\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd4\u0dba\u0dcf. \u0db4\u0dbb\u0dcf\u0dc1\u0da7\u0dca\u0da7 \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dc0\u0dd4\u0dab\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dba\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd4\u0dba\u0dcf. \u0dba\u0dba \u0dc1\u0db4\u0dcf\u0dd2\u0dba \u0dd2\u0dc0\u0dba\u0dba\u0da7 36\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd4\u0dba\u0dcf. \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0dba\u0dba\u0dca \u0dad\u0db1\u0dca\u0db1 \u0db3\u0dd0\u0dbb\u0dd2 \u0dc0\u0dd4\u0dba\u0dcf. \u0d85\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dba\u0dc0\u0db1 \u0db8\u0dd2\u0db1 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd4\u0dba\u0dcf. \u0dc1\u0dc0\u0dc1\u0db8\u0db3 \u0dc1\u0db4\u0dcf\u0db8 \u0db1\u0dd0\u0dad\u0dd2 \u0dc0\u0dd4\u0dba\u0dcf. \u0d92 \u0dad\u0dd4\u0db8 \u0d85\u0dd2\u0dbd\u0db0\u0dd2\u0db8\u0dad\u0dca \u0d85\u0d82 \u0dc1 -\u0dc3\u0dc0\u0dd3\u0dc0\u0dba\u0d82 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0d9a\u0dbb\u0db1 \u0dc1\u0db4\u0dde\u0dda\u0dad\u0dd2\u0d9a \u0d85\u0d82 \u0dc1 \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb\u0db1- \u0dc3\u0db8\u0dc3\u0dc0\u0dd3\u0dad \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0dad\u0dca \u0d9a\u0dd0\u0db4\u0db8\u0db8\u0dca \u0d9a\u0dbb\u0db1\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca\u0da7 \u0dc1\u0db8\u0dca \u0dbb\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0daf\u0dbb\u0dca\u0dae \u0d9a \u0dd2\u0dad\u0d9a \u0db0\u0db1\u0db1 \u0d85\u0dad\u0dba\u0d9a\u0da7 \u0dc1\u0dad\u0db1 \u0d91\u0db1\u0dca\u0db1 \u0d9a\u0da7\u0dd4\u0d9a\u0dad\u0dd4 \u0d9a\u0dc1\u0db8\u0dc0\u0dd3."
  },
