    "chunk_text": "\u0d85\u0d9c\u0dba \u0d9a\u0dd0\u0db1\u0dc0\u0d9c. \u0dad \u0db4\u0dad\u0dc1\u0dda \u0dc0\u0dd2\u0da9\u0dc0\u0dbd\u0da7 \u0d85\u0d9c\u0dba \u0d9a\u0dd2\u0dbb\u0dd3 \u0dca\u0dad \u0dbd\u0dd2\u0db6\u0dd3 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c \u0d9a\u0dd2\u0dba\u0db1 \u0dc0\u0dd2 \u0dc0\u0d9c \u0dba, \u0dad \u0db4\u0dad\u0da7 decent living wage \u0d91\u0d9a\u0dca\u0dad \u0d9a\u0dd0\u0d9c \u0dba\u0db4\u0dad\u0db1 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad \u0d9a\u0dd2\u0dba\u0db1 \u0dc0\u0dd2 \u0dc0\u0d9c \u0dba \u0d92 \u0d85\u0dba \u0dc3\u0dcf \u0d87\u0dad\u0dd2 \u0dc1\u0dc0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0dad \u0db4\u0dad\u0da7 \u0dc1\u0d9c\u0dde\u0dd0\u0dc0\u0db1\u0dd3\u0dba\u0dc0 \u0dbd\u0d9a\u0db1\u0dc0\u0d9c \u0d9a\u0dd2\u0dba\u0d9c, \u0dad \u0db4\u0dad \u0d85\u0d9c\u0dba \u0d9a\u0dd0\u0db1\u0dc0\u0d9c \u0d9a\u0dd2\u0dba\u0d9c, \u0dad \u0db4\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db4\u0dad\u0db1\u0dc0\u0d9c \u0d9a\u0dd2\u0dba\u0d9c, \u0dad \u0dd0\u0d9c\u0dba\u0d9a\u0d9c\u0dbb\u0dd2 \u0dc0\u0dd2\u0da9 \u0dad \u0db4\u0dad\u0da7 \u0d9a\u0dd0\u0db4\u0dad\u0db1 \u0db1\u0dd2\u0daf\u0dc5 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c \u0d9a\u0dd2\u0dba\u0d9c \u0dc3\u0da7\u0dd4 \u0dc0\u0db1 \u0d9a\u0da9\u0dd4\u0da9\u0d9c\u0dba \u0dc3 \u0d89\u0db4\u0dad\u0db1\u0dc0\u0d9c.\n\n\u0db8\u0dd6\u0dbd\u0d9c \u0db1\u0d9c\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db4\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0dc3 \u0db1\u0dd2, \u0d85\u0db4\u0dd2 \u0dc1 \u0dc3 \u0d9c \u0dba \u0dbb\u0dc0\u0dd0\u0d9c \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0d9c \u0dc0\u0dd2\u0dd0\u0dd2\u0db4\u0dad \u0dad\u0dbb\u0dd4\u0dab \u0dad\u0dbb\u0dd4\u0dab\u0dd2\u0dba\u0db4\u0dad \u0d9c\u0dd2\u0db1 \u0dc0\u0dd2 \u0d9c\u0dbd \u0dc0 \u0dc1\u0dba\u0db4\u0dad \u0dc0\u0d9c\u0daf \u0dc0\u0dd2\u0dc0\u0d9c\u0daf \u0d9a\u0dd0\u0db8\u0dd2\u0db4\u0dad \u0dad\u0da7\u0dd2\u0dba\u0d9c. \u0d85\u0db4\u0da7 \u0dc1 \u0ddd\u0daf\u0db1\u0d9c\u0dc0\u0dca\u0dad \u0d91\u0dbd\u0dca\u0dbd \u0d9a\u0dcf\u0d9c, \u0d85\u0dc1\u0db4\u0dca \u0dc1\u0daf\u0dca \u0db4\u0d9c\u0dbd\u0db1\u0dba \u0dc3\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd0\u0dbb\u0dc0 \u0dc1\u0db4\u0ddc\u0dc1\u0dd0\u0ddc\u0db4\u0dad\u0daf\u0dd4 \u0d85\u0db4\u0dd2 \u0d89\u0dc2\u0dca\u0da8 \u0da7 \u0d9a\u0dd0\u0dbd\u0d9c \u0db1\u0dd2\u0dc5\u0dd2 \u0d9a\u0dd2\u0dba\u0d9c. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d87\u0dad\u0dca\u0dad \u0d9a\u0dcf\u0d9c\u0dc0 \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0ddc\u0dad\u0dca, \u0dad\u0daf\u0dca\u0db1 \u0dc1\u0dc0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db4\u0dad\u0dc1\u0db4\u0dad \u0dc1 \u0ddc\u0d9a\u0dca\u0dad\u0daf, \u0db8\u0dd6\u0dbd\u0d9c \u0db1\u0d9c\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db4\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0dc3 \u0db1\u0dd2? \u0d85\u0dc1\u0db4\u0dca \u0dd0\u0dc1\u0da7\u0dca \u0dad\u0dbb\u0dd4\u0dab \u0dad\u0dbb\u0dd4\u0dab\u0dd2\u0dba\u0db4\u0dad\u0da7 \u0db1\u0dd2\u0d9a \u0dc3 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0d9c \u0dc1\u0daf\u0db1\u0dc0\u0d9c \u0dc1\u0dc0\u0db1\u0dd4\u0dc0\u0da7, \u0dc1\u0dbd\u0ddc\u0dad\u0dbb\u0dd0\u0dd2 \u0daf\u0dd2\u0db1\u0dd4 \u0dc3 \u0d85\u0daf\u0dd2\u0db1\u0dc0\u0d9c \u0dc0\u0d9c\u0dc1\u0dda \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0d9c \u0dc1\u0daf\u0db1\u0dc0\u0d9c \u0dc1\u0dc0\u0db1\u0dd4\u0dc0\u0da7, \u0dad \u0db4\u0dad\u0dc1\u0dda \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0dc1\u0dba\u0db4\u0dad, \u0dad \u0db4\u0dad \u0d9a\u0dd0\u0db1 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0d9c\u0dc1\u0dc0\u0db4\u0dad \u0dad\u0dd8\u0db4\u0dca\u0dad\u0dd2 \u0dad\u0dca \u0dc1\u0dc0\u0db4\u0dad\u0db1 \u0db6\u0dd2\u0dbb\u0dd2 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d94\u0dc1\u0dc5 \u0db1\u0dd2\u0d9a \u0dc3 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0d9c \u0dc1\u0daf\u0db1 system \u0d91\u0d9a\u0dca\u0dad \u0dc1\u0dc0\u0db1\u0dd4\u0dc0\u0da7 \u0d92 \u0d85\u0dba\u0da7 \u0dad \u0db4\u0dad\u0dc1\u0dda \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0dba \u0d9c\u0dd2\u0db1 \u0d87\u0dad\u0dca\u0dad \u0dc0 \u0dc1\u0dba\u0db4\u0dad \u0dad\u0dd8\u0db4\u0dca\u0dad\u0dd2 \u0dad\u0dca \u0dc1\u0dc0\u0db4\u0dad\u0db1 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad \u0dc0\u0dd2\u0db0\u0dd2\u0dc1\u0d86, \u0dad \u0db4\u0dad\u0dc1\u0dda qualifications\u0dc0\u0dbd\u0da7 \u0d85\u0d9c\u0dba\u0dca\u0dad \u0dc1\u0daf\u0db1, \u0dc0\u0da7\u0dd2\u0db1\u0d9c\u0d9a \u0dca\u0dad \u0dc1\u0daf\u0db1, \u0daf\u0dd2\u0dd4\u0dad\u0db8\u0dca \u0dc1\u0dc0\u0db4\u0dad\u0db1 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad \u0dc0\u0dd2\u0db0\u0dd2\u0dc1\u0d86, \u0dad \u0db4\u0dad\u0dc1\u0dda \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dba \u0dc1\u0d9c\u0ddc\u0da9\u0db1\u0d9c\u0d9c \u0d9c\u0db4\u0dad\u0db1 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad \u0dc0\u0dd2\u0db0\u0dd2\u0dc1\u0d86 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0d9c \u0dad\u0dbb\u0dd4\u0dab \u0dad\u0dbb\u0dd4\u0dab\u0dd2\u0dba\u0db4\u0dad\u0da7 \u0dbd\u0db6\u0d9c \u0dc1\u0daf\u0db1 \u0d9a\u0dca\u200d\u0dbb \u0dba\u0dca\u0dad \u0d85\u0db4\u0dd2 \u0dc5\u0daf\u0db8\u0dd2\u0db4\u0dad \u0dba\u0db4\u0dad\u0dc1\u0db4\u0dad. \u0d91\u0dc0\u0dd2\u0db1\u0dd2 \u0d9a\u0dca\u200d\u0dbb \u0dba\u0dca\u0dad \u0dc5\u0daf\u0db8\u0dd2\u0db4\u0dad \u0dba\u0db1\u0dc0\u0d9c \u0dc0\u0dd2\u0dad\u0dd0\u0dca\u0dad \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dd2 , \u0d85\u0db4\u0dd2 \u0daf\u0dd2\u0db1\u0da7\u0dad\u0dca \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0d9c \u0d9c\u0dab\u0db1\u0d9c\u0dc0\u0dca\u0dad \u0dc1\u0daf\u0db4\u0dad\u0db1 \u0d85\u0dc0 \u0dd9 \u0d9c\u0dbb\u0dca\u0d9c\u0dba \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dd0\u0dbd\u0d9c\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db4\u0dad\u0dc1\u0db4\u0dad.\n\n\u0d85\u0db4\u0da7 \u0da7 \u0da7\u0dad\u0dca \u0dc0\u0da9\u0d9c \u0dc1\u0dd3\u0d9d\u0dca\u200d\u0dbb\u0dc1\u0dba\u0db4\u0dad \u0d91 \u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dca\u0dad \u0d9a\u0dd0\u0db4\u0dad\u0db1 \u0db6\u0dd2\u0dbb\u0dd2 \u0dc1\u0dc0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db4\u0dad\u0dc1\u0db4\u0dad \u0d87\u0dd2 ? \u0db4\u0dc3\u0dd4\u0dab\u0dd4\u0dba \u0dbb\u0da9\u0dd4\u0d9a\u0dca\u0dc0\u0dbd\u0dd2\u0db4\u0dad \u0dc1\u0d9c\u0db1 \u0dad\u0dd2\u0db6\u0dd4\u0db8\u0dca \u0dad\u0dd3\u0db4\u0dad\u0daf\u0dd4 \u0dad\u0dd3\u0dd0\u0dab \u0db1\u0dd2 \u0d9c \u0d87\u0dad\u0dd2 \u0dc0\u0dd3 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dbb\u0dd0\u0d9c\u0dc0\u0dd4\u0dbd\u0dca \u0dc1\u0dc5 \u0dc3\u0dc1\u0dc0\u0db4\u0dad \u0dc1 \u0dc3 \u0dc0\u0db1 \u0dc1\u0d9a\u0ddc\u0da7\u0dad\u0dca \u0dc5\u0d9c\u0db0\u0dd2\u0d9a\u0dd0\u0dab\u0dc1\u0d86 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d87\u0dad\u0dd2 \u0dc3 \u0db1\u0d9a\u0dca\u0dc0\u0dbd\u0dd2\u0db4\u0dad \u0dba \u0dc3 \u0dba \u0dc3 \u0dc3\u0dd3 \u0d9c \u0db4\u0db1\u0dc0\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d92 \u0db1\u0dd2 \u0d9c\u0dad\u0dca \u0d85\u0db4\u0da7 \u0dc1 \u0dc3 \u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dca\u0dad \u0dc1\u0dd3\u0d9d\u0dca\u200d\u0dbb\u0dc1\u0dba\u0db4\u0dad \u0d9a\u0dd0\u0db4\u0dad\u0db1 \u0db6\u0dd2\u0dbb\u0dd2 \u0dc1\u0dc0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d85\u0db4\u0dd2 \u0dd2\u0db4\u0dad\u0db1\u0dc0\u0d9c, \u0d85\u0dc1\u0db4\u0dca \u0d9a\u0dd2\u0db6\u0dd2\u0db1\u0da7\u0dca \u0da9\u0dd4\u0da9\u0dbd\u0dba \u0d9c\u0dad\u0dca \u0dc3 \u0dad\u0dd3\u0db4\u0dad\u0daf\u0dd4 \u0dad\u0dd3\u0dd0\u0dab \u0d85\u0db0\u0dd2\u0d9a\u0dd0\u0dab\u0dba\u0da7 \u0dc0\u0d9c\u0dbb\u0dca\u0dad\u0d9c \u0d9a\u0dcf\u0d9c\u0da7 \u0db4\u0dc3\u0dd4\u0dc0 \u0d91 \u0d9a\u0da7\u0dd4\u0dad \u0dc3 \u0dad\u0dc0\u0daf\u0dd4\u0dd0\u0da7\u0dad\u0dca \u0dc1\u0db6\u0dca\u0dbb\u0dd4 \u0dc3 \u0d9a\u0dd0 \u0d9c\u0db4\u0dad\u0db1 \u0d85\u0db4\u0da7 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad \u0dc1\u0dc0\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0d9c. \u0dc1 \u0dad\u0dd2\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dc0\u0da7\u0dd2\u0db1\u0d9c \u0dc1\u0daf\u0dca \u0dc1 \u0ddc\u0d9a\u0dca\u0dad\u0daf? \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0d9c\u0dc0\u0d9a \u0dc0\u0da7\u0dd2\u0db1\u0d9c\u0d9a \u0dca\u0dad \u0daf\u0dd2\u0d9a\u0dbd\u0d9c \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0d9c\u0dc0 \u0dc3\u0dc5\u0dd2\u0db4\u0dad \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dd4\u0da7 \u0daf\u0dd2\u0dd4\u0dad\u0db8\u0dca \u0dc1\u0dc0\u0db4\u0dad\u0db1 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad \u0dbb\u0d9a\u0d9c\u0dd0\u0dc1\u0d86 path \u0d91\u0d9a\u0dca\u0dad \u0dc5\u0dd2\u0dc1\u0daf\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7\u0dd2 \u0d85\u0db4 \u0dc0\u0dd2\u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0d9c\u0dc0\u0da7 \u0dc0\u0dd4\u0dab\u0dad\u0dca \u0dc0\u0dd2 \u0db3\u0dd4 \u0dc3 \u0dc1\u0dc5\u0ddc\u0dba\u0db4\u0dad\u0dc1\u0db4\u0dad.\n\n\u0db8\u0dd6\u0dbd\u0d9c \u0db1\u0d9c\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db4\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0dc3 \u0db1\u0dd2, \u0d87\u0dad\u0dca\u0dad\u0da7 \u0db8\u0dd2\u0db1\u0dd2 \u0dc3\u0dd4\u0db4\u0dad\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0daf\u0dd2\u0dc1\u0dc0\u0db1 \u200d\u0dbb \u0db1 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0daf\u0d9c \u0dc1\u0d9c\u0db1 \u0dad \u0db4\u0dad\u0dc1\u0dda \u0dc1\u0daf\u0dca \u0db4\u0d9c\u0dbd\u0db1 \u0dc1\u0dc5\u0ddd \u0dc0\u0dd0\u200d\u0dbb \u0d9c\u0daf \u0dc1\u0dc5\u0ddd bargaining power \u0d91\u0d9a\u0dca\u0dad \u0dc1\u0dc5\u0ddd \u0dbb\u0dd0\u0d9a \u0d9c\u0db4\u0dad\u0db1"
