    "chunk_text": "\u0daf\u0da9\u0dba \u0d9a\u0dd2\u0dba\u0dc1\u0dba\u0ddd \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dd2 \u0dc1\u0db8\u0dca \u0dba \u0dc2\u0dd2\u0dad\u0dc1 \u0db1\u0dd0\u0dc0\u0dd2 \u0dbd\u0dd2 \u0dc0\u0db1\u0dc3\u0dad\u0dd4\u0db1\u0dca \u0db8\u0dba\u0dbd\u0dd2, \u0d92 \u0dc3\u0dad\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0db8\u0dc3\u0dcf \u0dc1\u0dda\u0dc5\u0dd2\u0dc1\u0d9c\u0db1 \u0d85\u0dba\u0dc1\u0d9c\u0db1 \u0dba\u0db1\u0dc0\u0dd2. \u0dc1\u0db8\u0ddc\u0d9a\u0daf \u0dc1\u0db8\u0dca \u0d9a\u0dbd\u0dd2\u0db4\u0dc0\u0dbd\u0da7 \u0d9a\u0dd4\u0db8\u0dbb\u0dd4\u0dc0\u0dad\u0dca \u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0, \u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dd2\u0db4\u0dd2 \u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0d92 \u0dc0\u0dd2\u0dc1\u0dda\u0db8 \u0d85\u0db4\u0da7 \u0db8\u0dd3\u0da7 \u0dc0\u0da9\u0dd2 \u0d86\u0daf\u0dd2\u0dba\u0db8 \u0dbd\u0db6\u0dd2 \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0dc0 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0db8\u0dd2\u0dbb\u0dca\u0d9c \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dd2.\n\n\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dd2\u0db4\u0dd2 \u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d85\u0dc1\u0dda \u0db8\u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dbb\u0dd2\u0dba \u0da2\u0dd2\u0dd2 \u0d9a \u0dc0\u0dc1\u0db1\u0ddd\u0daf\u0dba\u0dd2\u0db1\u0dba \u0d9c\u0dd0\u0db1\u0dad\u0dca \u0db8\u0db8 \u0d9a\u0dcf\u0dd2 \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0db1\u0db1\u0dd1. \u0daf\u0d9a\u0dd4 \u0db4 \u0d86\u0dc3\u0dd2\u0dba\u0dd2\u0dc1\u0dda \u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0d85\u0dbd\u0dd2 \u0d9d\u0db1\u0dad\u0dca\u0dc0\u0dba \u0dd2 \u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db8\u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dbb\u0dd2\u0dba \u0da2\u0dd2\u0dd2 \u0d9a \u0dc0\u0dc1\u0db1\u0ddd\u0daf\u0dba\u0dd2\u0db1\u0dc1 . \u0daf\u0dd0\u0db1\u0dca \u0dc1\u0db8\u0dca \u0db8\u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dbb\u0dd2\u0dba \u0da2\u0dd2\u0dd2 \u0d9a \u0dc0\u0dc1\u0db1\u0ddd\u0daf\u0dba\u0dd2\u0db1\u0dc1 \u0db8\u0dd2\u0dbb\u0dca\u0dc1\u0d9c\u0ddd\u0db4\u0dc1\u0daf\u0dca \u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0db4\u0dc3\u0dcf\u0dc1\u0daf\u0db1\u0dd2\u0dba\u0dd2 \u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1\u0db8\u0dca \u0db4\u0dc3\u0dcf\u0dc1\u0daf\u0db1\u0dd2 \u0da2\u0dd3\u0dda \u0dba\u0dcf 400 , 500 \u0db4\u0dd2\u0dbd\u0db1\u0dba \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0db1\u0db1\u0dd1. \u0dc3\u0db8\u0dc4\u0dba \u0da2\u0dd3\u0dda \u0dba\u0dcf \u0db8\u0dd2\u0dbb\u0dca\u0dc1\u0d9c\u0ddd\u0db4\u0dc1\u0daf\u0dca \u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0db1\u0dd0\u0dd2 \u0dc0 Park \u0d91\u0d9a\u0da7 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dd2. \u0db8\u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dbb\u0dd2\u0dba \u0da2\u0dd2\u0dd2 \u0d9a \u0dc0\u0dc1\u0db1\u0ddd\u0daf\u0dba\u0dd2\u0db1\u0dba 2024 \u0dc0\u0dc3\u0dc1\u0dbb\u0dca\u0daf\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 300\u0d9a \u0d86\u0daf\u0dd2\u0dba\u0db8 \u0dc3\u0db4\u0dba\u0dd2 \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dd2.\n\n\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dd2\u0db4\u0dd2 \u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0db6\u0db6\u0dad\u0dd4\u0db8\u0dd2\u0dad\u0dca \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dd2 \u0d87\u0dd2 , \u0db8\u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dbb\u0dd2\u0dba \u0da2\u0dd2\u0dd2 \u0d9a \u0dc0\u0dc1\u0db1\u0ddd\u0daf\u0dba\u0dd2\u0db1\u0dba \u0d87\u0dad\u0dd4\u0dc1\u0dc5\u0dda \u0dd2\u0dbb\u0dc3\u0dd2\u0db8 \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8 \u0db1\u0dd0\u0dd2 \u0db6\u0dc0. \u0d91\u0db1 \u0dc3\u0d82\u0dad\u0dd2\u0dba\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0da7 \u0dc0\u0dad\u0dd4\u0dba \u0da7\u0dd2\u0d9a \u0dc1\u0db6\u0ddc\u0db1\u0dca\u0db1 \u0dad\u0dd0\u0db1 \u0db1\u0dd0\u0dc4\u0dd0. \u0dc0\u0dd0\u0dc3\u0dd2\u0dd2\u0dbb\u0dc5\u0dd2\u0dba\u0d9a\u0da7 \u0dba\u0db1\u0dca\u0db1 \u0dd2\u0dbb\u0db0\u0dd2\u0dba \u0db1\u0dd0\u0dc4\u0dd0; \u0dc0\u0dd0\u0dc3\u0dd2\u0dd2\u0dbb\u0dc5\u0dd2 \u0db4\u0daf\u0dca\u0db0\u0dd2 \u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0da7\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0dd2\u0dbb\u0db1\u0dd2\n\n\u0dc1\u0dc0\u0dbd\u0dd2 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dd2. Park \u0d91\u0d9a \u0d87\u0dad\u0dd4\u0dc1\u0dc5\u0dda \u0dd2 \u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d91\u0d9a \u0db6\u0d82\u0d9c\u0dbd\u0dd2\u0dc0\u0dba\u0dd2. \u0d92 \u0db6\u0d82\u0d9c\u0dbd\u0dd2\u0dc0 \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1 \u0dd2\u0dbb\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0dd4\u0db8\u0dbb\u0dd4\u0daf\u0dd4 \u0d9c\u0da7\u0db1\u0dd2\u0dc0 \u0dd2 \u0dc3\u0dcf\u0dc1\u0dc3\u0dda \u0db4\u0dd2\u0dd2\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0dc1\u0dc0\u0dbd\u0dd2 \u0db1\u0dd0\u0dc4\u0dd0. \u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dd2\u0db4\u0dd2 \u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0daf\u0d9a\u0dd4 \u0db4 \u0d86\u0dc3\u0dd2\u0dba\u0dd2\u0dc1\u0dda \u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0d85\u0dbd\u0dd2 \u0d9d\u0db1\u0dad\u0dca\u0dc0\u0dba \u0dc3\u0dc4\u0dd2\u0dad Park \u0d91\u0d9a \u0dad\u0db8\u0dba\u0dd2, \u0db8\u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dbb\u0dd2\u0dba \u0da2\u0dd2\u0dd2 \u0d9a \u0dc0 \u0dc1\u0db1\u0ddd\u0daf\u0dba\u0dd2\u0db1\u0dba. \u0dd2\u0dd2 \u0db1\u0dca \u0d87\u0dba\u0dd2, \u0dc1\u0db8\u0dca \u0dc0 \u0dc1\u0db1\u0ddd\u0daf\u0dba\u0dd2\u0db1\u0dba\u0da7 \u0d91\u0dc1\u0dc4\u0db8 \u0dc1\u0dc0\u0dbd\u0dd2 \u0dd2 \u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0d92 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0db4\u0dd2\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc1\u0dda \u0daf\u0dd2\u0d9c\u0dd2\u0db1\u0dca \u0daf\u0dd2\u0d9c\u0da7\u0db8 \u0d9a\u0dcf\u0dd2 \u0d9a\u0dba\u0dbd\u0dd2 \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dd2. \u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dd2\u0db4\u0dd2 \u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0db8\u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dbb\u0dd2\u0dba \u0da2\u0dd2\u0dd2 \u0d9a \u0dc0\u0dc1\u0db1\u0ddd\u0daf\u0dba\u0dd2\u0db1\u0dba \u0dd2\u0dbb\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dd2\u0dbb \u0dd2\u0dbd \u0d86\u0daf\u0dd2\u0dba\u0db8 \u0dbd\u0db6\u0dd2 \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca Park \u0d91\u0d9a . \u0d92 \u0db1\u0dd2\u0dc3\u0dd2 \u0db8\u0db8 \u0dc1\u0dba\u0ddd\u0da2\u0db1\u0dd2 \u0d9a\u0dba\u0db1\u0dc0\u0dd2, \u0d92 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0dd2\u0dbb\u0dc1 \u0dda\u0dc2\u0dca\u0da8 \u0d85\u0dc0\u0db0\u0dd2\u0db1\u0dba \u0dc1\u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0dd2\u0dbb\u0dba\u0dbd\u0dd2. \u0d91\u0dad\u0dd0\u0db1 \u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db8\u0dd2\u0dbb\u0dca\u0dc1\u0d9c\u0ddd\u0db4\u0dc1\u0daf\u0dca \u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0db4\u0dc3\u0dcf\u0dc1\u0daf\u0db1\u0dd2\u0dba\u0dd2. \u0d85\u0da9\u0dd4 \u0d9c\u0da7\u0dc1\u0db1\u0dca \u0db8\u0dd2\u0dbb\u0dca\u0dc1\u0d9c\u0ddd\u0db4\u0dc1\u0daf\u0dca \u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dd2 \u0dc3\u0dcf\u0dc1\u0daf\u0dc1\u0db1 \u0dc0\u0dad\u0dca \u0d91\u0dc4\u0dd2 \u0dd2\u0db1\u0dca\u0db1 \u0db1\u0db1\u0dd1. \u0d91\u0dad\u0dc1\u0d9a\u0ddc\u0da7 \u0d85\u0db4\u0da7 \u0d92 Park \u0d91\u0dc1\u0d9a\u0db1\u0dca \u0daf\u0dd0\u0db1\u0da7 \u0dbd\u0dd0\u0dc1\u0db6\u0db1 \u0d86\u0daf\u0dd2\u0dba\u0db8\u0da7 \u0dc0\u0da9\u0dd2 \u0dc0\u0dd0\u0da9\u0dd2 \u0d86\u0daf\u0dd2\u0dba\u0db8 \u0dbd\u0db6\u0dd2 \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca."
  },
