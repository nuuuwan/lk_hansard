u0db8\u0db18\u0dc0\u0dd0\u0dca\u200d\u0d9c\u0dca 8\u0dc0\u0dcf8\u0db6\u0dd0\u0dd2\u0dbd\u0db1\u0dd2.8\u0db8 \u0ddd\u0da2\u0dd2\u0db18\u0dcf\u0dc08\u0d85\u0db0\u0dba\u0dcf\u0db4\u0dcf8\u0dbb\u0dd2\u0d9a\u0db3\u0d82\u0db3\u0dca\u0dae\u0db8\u0dab8 \u0da7\u0db8\u0dca 8\u0d85\u0db0\u0dba\u0dcf\u0db4\u0dcf 8\u0dc0\u0da9\u0dcf8 \u0dbb\u0dcf\u0db8 \u0ddd\u0d9c\u0dd2\u0dae8 \u0d9a\u0dd2\u0dd3\u0d9a\u0db18 \u0db3\u0dc4\u0dcf\u0dcf8 \u0dcf\u0dd0\u0dd4\u0dbd\u0dbb\u0dd48 \u0dc0\u0dd38 \u0d87\u0dd2\u0d9a8\u0db6\u0dd0\u0dd2\u0dbd\u0db1\u0dca8 \u0dd2\u0dc0\u0dc3\u0dd4\u0db1\u0dca\u0da78 \u0db3\u0dca\u0dc0 \u0d828 \u0d85\u0db0\u0dba \u0dcf8 \u0dae\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dbd\u0da78\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0db8 \u0daf\u0dd38\u0dc0\u0dd0 8\u0d85\u0dc0\u0db3\u0dca\u0dcf\u0dcf\u0dc0\u0d9a\u0dca8\u0db3\u0dd0\u0dbd\u0db8\u0db3\u0dd4\u0dc08\u0d87\u0db1.\n\n(\u0dba) \u0d85\u0dca\u200d\u0dcf\u0dc58\u0db8\u0dcf\u0ddc\u0db8\u0dda.\n\n\u0dbb\u0dc0\u0dcf8\u0db0\u0dbb\u0dca\u0dcf\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba8\u0dd2\u0db1\u0dc3\u0dcf\u0d85\u0dcf\u0dba\u0dae8\u0dcf\u0dd4\u0dcf\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0bb0\u0bcd\u0bae\u0baa\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0baf \u0ba4\u0bbf\u0bc6\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95) (The Hon. Dharmapriya Dissanayake) \u0d9c\u0dbb\u0dd48\u0db1\u0dd2\u0db8 \u0ddd\u0da2\u0dca\u200d\u0dba8\u0dae\u0dcf\u0dcf\u0dcf\u0dcf \u0dae\u0dad\u0dd4\u0db1\u0db1\u0dd2 8\u0db1\u0dcf8\u0d9c\u0dbb\u0dd48\u0d85\u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db1\u0dcf\u0db1\u0dba\u0dad\u0dd4\u0dd2 \u0db8\u0d9c\u0db1\u0dca8 \u0dd2\u0dbd\u0db1\u0db3\u0dcf8 \u0dd2\u0dc0\u0da7\u0dd2\u0dcf8 \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd28 \u0d85\u0dad\u0dd4\u0dbb\u0dd48 \u0dbb\u0dc1\u0dba \u0dc3\u0dca\u0dcf 8\u0db8\u0db1 \u0dba\u0dd2.8\u0db8\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0dae8 \u0d8b\u0db4\u0dae\u0dcf\u0db8\u0dae8\u0db4\u0db1\u0dca\u0dd2\u0d9a8\u0db4\u0dd0\u0dc0\u0dd0\u0dca \u0db8\u0dc0\u0dcf8\u0d85\u0db1\u0db8\u0dad\u0dd4\u0db88\u0da7\u0db18\u0db4\u0db1\u0dca\u0dd2\u0d9a8 \u0db4\u0dc0\u0dca \u0dc0\u0dcf8 \u0dd4\u0dc0\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0db8\u0d9c\u0db1\u0dca8 \u0dca\u200d\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0da78 \u0dd2\u0dbd\u0dc1\u0dba \u0dc3\u0dcf\u0dbd8 \u0db8\u0dbd\u0db38 \u0dbd\u0dd2\u0d82\u0d9c\u0dd2\u0dae8\u0dc4\u0dd2\u0d82\u0db3\u0dcf8\u0db3\u0dcf8\u0db8\u0dc0\u0dcf\u0dca 8\u0d85\u0da9\u0db1\u0dca\u0db8\u0dca \u0dca \u0da7\u0dda8\u0dd2\u0dc0\u0daf\u0dd48\u0dc0\u0dcf8\u0db6\u0dc08\u0dca\u200d\u0dd0\u0dcf8\u0d9c\u0db1\u0dca\u0dcf\u0da78\u0dbd\u0dd0\u0db6\u0dd38\u0dd2\u0d9a\u0db8\u0db6\u0dcf\u0dc0\u0dcf.8 \u0da78 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dc4\u0dc08 \u0dd2\u0dbb\u0dcf\u0db4\u0db1\u0dcf8 \u0dbb\u0dc0\u0dd8\u0dca \u0dd2\u0d9a\u0dc0\u0dbd\u0dd2\u0dd4\u0dc0\u0dca 8 \u0db8\u0dc0\u0dcf\u0dca 8\u0db1\u0dcf\u0db0\u0dba\u0dc0\u0dbd\u0dd2\u0dd4\u0dc0\u0dca 8 \u0d85\u0db4\u0da78 \u0dca\u200d\u0dd0\u0dcf8 \u0d9c\u0db1\u0dca\u0dcf\u0da78 \u0dbd\u0dd0\u0db8\u0db6\u0dcf\u0dc0\u0dcf.8 \u0da78 \u0db1\u0dd2\u0db3\u0dcf8 \u0da78\u0db3\u0dda\u0db6\u0db1\u0dca\u0db0\u0db8 \u0db1\u0dca8 \u0dda\u0d9a\u0dd2\u0dd2\u0dc08\u0db1\u0dd2 \u0dcf\u0db1\u0dcf \u0d9a\u0dca8\u0dae\u0db8\u0dcf\u0dc0\u0dcf8\u0dca\u200d 8\u0d9c\u0dbb\u0dd48\u0d85\u0d9c\u0db1\u0dd0\u0dd2\u0d9a\u0dad\u0dd4\u0dd2 \u0db1\u0dd2?8\n\n\u0da78 \u0dc0\u0dcf\u0db8\u0d9c\u0dca\u0db0\u0db1\u0db1 8 \u0db8\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0dae8 \u0d8b\u0db4\u0dae\u0dcf\u0db8\u0dae8 \u0db4\u0db1\u0dca\u0dd2\u0d9a8 \u0db4\u0dc0\u0dca \u0dc0\u0dcf8 \u0db3\u0db1\u0dcf\u0db88\u0dd4\u0dc0\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0db8\u0d9c\u0dca\u0db0\u0db18 \u0d85\u0db0\u0dba\u0dcf\u0db4\u0dcf8 \u0db1\u0dca \u0da7\u0dda8 \u0db3\u0dda\u0db6\u0db1\u0dca\u0db0\u0db8 \u0db1\u0dca8 \u0dd2\u0dbd\u0db1\u0dc3\u0dd3\u0dda8 \u0dae\u0db88\u0db6\u0dbd\u0daf\u0dca\u0daf\u0dd3 8 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da78 \u0da78 \u0d85\u0dca\u200d\u0dcf\u0dc58 \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0dae\u0dda8 \u0db8\u0dcf\u0ddc\u0db1\u0dd0\u0dd2\u0d9a8 \u0db6\u0dc08 \u0dca\u200d\u0dd0\u0dcf8 \u0d9c\u0db1\u0dca\u0dcf\u0da78\u0dbd\u0dd0\u0db8\u0db6\u0dcf\u0dc0\u0dcf.8 \u0da78 \u0db3\u0dda\u0db6\u0db1\u0dca\u0db0\u0db8 \u0db1\u0dca8 \u0db8\u0da2\u0dca\u200d 8 \u0dd2\u0dbd\u0db0\u0dd2 \u0da78 \u0db1\u0dd0\u0dd2\u0dbb\u0dcf\u0dca 8 \u0dc0\u0dd3\u0db1\u0d9a\u0dca8\u0dae\u0db8\u0dcf\u0dc0\u0dcf8\u0dca\u200d?8"
