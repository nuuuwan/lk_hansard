    "chunk_text": "\u0d92 \u0dc0\u0dcf\u0dc1\u0dda \u0dad \u0dba\u0dd2 \u0dd2 \u0dd4\u0db1 \u0dc1\u0dc4\u0daf \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc0\u0da7 3\u0d8b000\u0d9a\u0dca \u0db6\u0db3\u0dc0\u0dcf \u0dad\u0d9a\u0db1\u0dd3 \u0da7 \u0d85\u0db1\u0dd4 \u0d9a\u0dad\u0dd2\u0dba\u0dcf\u0dad \u0dbd\u0d9a\u0db6\u0dd3 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0db1\u0dd4\u0dc0\u0db8\u0d8b 2\u0d8b183\u0d9a\u0dca \u0dad \u0dba\u0dd2 \u0db6\u0db3\u0dc0\u0dcf \u0dc1\u0dad\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad 817\u0d9a \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0d85\u0daf \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0dcf\u0da7 \u0d92 \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0dca\u0dc0\u0dbd\u0da7 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 25\u0d8b 26\u0d8b 27 \u0dc0\u0dba\u0dcf\u0dad\u0dc3\u0dae\u0dc0\u0dbd \u0dad\u0dbb\u0dd4\u0dab \u0dad\u0dbb\u0dd4\u0dab\u0dd2\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0db6\u0db3\u0dc0\u0dcf \u0dad\u0db1\u0dca\u0dad\u0db1 \u0dc4\u0d9a\u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0dcf\u0dc0 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0db8\u0d8b \u0d92\u0d9a \u0d9a\u0dbb\u0dbd\u0dcf \u0db1\u0d9a\u0dc4\u0d9a \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf\u0d8b \u0dc1\u0dc4\u0daf \u0dd2 \u0dd4\u0db1 \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc0\u0da7 \u0dd2 \u0dba\u0dcf\u0dad\u0dba\u0dcf\u0dad\u0da7 5\u0d9a\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0db8\u0dd2 \u0dad\u0dbb\u0dd4\u0dab\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0db6\u0db3\u0dc0\u0dcf \u0dad\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0db6\u0dc0 \u0dc4\u0dd2\u0dad\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0dcf\u0dad\u0da7 \u0dc1\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0d85 \u0dcf\u0dad\u0dba\u0dc0\u0dbb\u0dba\u0dcf\u0dad\u0dcf \u0dc0\u0dd2\u0dd2 \u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dc1 \u0dae\u0dc2 \u0d85\u0db1\u0dd4 \u0d9a\u0dad\u0dd2\u0dba\u0dcf\u0dad\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0dc1\u0dad\u0db1 \u0dad\