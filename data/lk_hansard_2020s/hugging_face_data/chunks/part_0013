ca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dba\u0dad\u0dca \u0d85\u0db1\u0dd22\u0dd2\u0dca\u0d9c\u0dba\u0dc1\u0dba\u0dca \u0dbb\u0dd0\u0d9a\u0d9c\u0dca \u0db1\u0da7 \u0db1\u0db1,.\n\n2433 2434\n\n\u0db4\u0dd2\u0dca\u0d9c\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd42\n\n\u0da7 2\u0dd2\u0dc1 \u0db8 \u0db4\u0dc0 \u0db3\u0dd4 2\u0d9c\u0dd22 \u0d9c\u0dd0\u0db1\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0dca \u0db1 \u0db1\u0db1,. \u0d85\u0db4\u0dd2 \u0dca \u0db12\u0dd2 \u0db4\u0dc0 \u0db3\u0dd4 \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0ddc\u0dad\u0dca \u0dc1 \u0ddd\u0d9a\u0dc1\u0dda \u0dc1\u0db1\u0ddc\u0db3\u0db8 \u0db4\u0dc0 \u0db3\u0dd4 - cinnamon - \u0dad\u0dd2\u0dc1\u0db6\u0dca \u0dc1\u0dca \u0d82\u0d9a\u0dd2\u0dc1\u0dda \u0db62. \u0dad2 cassia \u0d9a\u0dd2\u0dba\u0dd2 2\u0dca\u0d9c\u0d9c\u0dba [ \u0dad\u0dd2\u0dc1\u0db6\u0db12\u0dd2. Cassia 2\u0dd2\u0dc1 \u0dc1\u0db1\u0ddc\u0dc12\u0dba\u0dd2 cinnamon. \u0d82\u0d9a\u0dd2\u0dc1\u0dda \u0db4\u0dc0 \u0db3\u0dd4 - cinnamon - \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0ddc\u0dad\u0dca \u0da7\u0d9a\u0da7 \u0dd2\u0dad\u0dd2\u0db8 \u0dc1\u0db1\u0ddc\u0db3 \u0db8\u0dd2\u0dca\u0d9c\u0d9a\u0da7\u0dca \u0d91\u0d9a [ \u0dc1 \u0ddd\u0d9a\u0dc1\u0dda \u0dad\u0dd2\u0dc1\u0db6\u0db12\u0dd2. \u0db1\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d852\u0dd2\u0dc3\u0db1\u0dd22\u0d9a\u0da7 2\u0dd2\u0dc1 \u0d85\u0d9c\u0dba \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 - value addition - \u0d85 \u0dd2\u0dc52 \u0db1\u0dd2 \u0dcf\u0da0\u0dd2\u0dad \u0db6\u0dba [ \u0db8 \u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dba\u0dca \u0db1 \u0db4\u0dd4\u0d9a\u0d9c\u0dd2\u0dba \u0d9a\u0dd2 \u0dc1\u0dda \u0d85\u0db4\u0da7 \u0db6\u0dd0\u0db4\u0dad \u0dc12 \u0dd2 \u0dad\u0dd2\u0db6\u0dd4\u0da7\u0dd2. \u0d85\u0db4\u0dd2 \u0dd2\u0dbd \u0dcf2\u0dd2\u0dc3 \u0d9a\u0dba\u0db12\u0dd2 \u0db1\u0dd2\u0dad\u0dd2\u0d9a \u0db1\u0db1 \u0db6 \u0dc1\u0dda\u0d9c\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd4\u0d9b\u0dca\u200d \u0dc1\u0db8\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd42 \u0dc1\u0db8\u0dca \u0dba\u0da7 \u0db4\u0dd2 \u0db1\u0dba \u0d9a\u0dba\u0db1 \u0dc1\u0db8\u0dca \u0d9a\u0dd2 \u0dba \u0dad\u0dd4\u0dc5 \u201cCeylon Cinnamon\u201d \u0d9a\u0dd2\u0dba\u0db1 brand \u0d91\u0d9a \u0dd2\u0dad\u0dd2\u0db8 \u0dc1\u0db1\u0ddc\u0db3 brand \u0d91\u0d9a [ \u0dd2\u0dbd\u0db0\u0dd2\u0dba\u0da7 \u0dc1 \u0ddd\u0d9a\u0dba\u0da7 \u0db1\u0db3\u0dd4\u0dca 2\u0dd2 \u0dc1 \u0dca \u0db1 \u0db4\u0dd4\u0dc5\u0dd42\u0dca \u0dc12\u0dba\u0dd2 \u0d9a\u0dd2\u0dba \u0dd2. \u0da7 \u0dc3\u0db3\u0db1\u0dd2 \u0dc1 \u0ddc \u0db4 \u0db8\u0dd2\u0dca\u0d9c\u0d9a\u0da7\u0dca \u0d91\u0d9a [ \u0dad\u0dd2\u0dc1\u0db6\u0db12\u0dd2. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d85\u0db4\u0da7 \u0dc1 \u0ddc \u0db4 \u0dad\u0dba\u0d9c\u0d9a\u0dd2\u0db4\u0dad\u0dad\u0dca2\u0dba [ \u0db1\u0dd0\u0db1\u0dd0. \u0d9a\u0dba\u0dca \u0db1 \u0db4\u0dd4\u0dc5\u0dd42\u0dca \u0d852\u0db8 \u0dc1\u0daf\u0dca2\u0dca \u0d9a\u0dba\u0db12\u0dd2 \u0db1\u0db8\u0dca \u0da7 \u0dc12\u0dc1\u0dc5\u0db3 \u0dc1\u0db4\u0ddc\u0dc5 \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dba\u0d9c\u0dca \u0db1 \u0d85\u0db4\u0da7 \u0d85\u0db1\u0dd22\u0dd2\u0dca\u0d9c\u0dba\u0dc1\u0dba\u0dca \u0db8 \u0db4\u0dd4\u0dc5\u0dd42\u0dca .\n\n\u0ba4\u0b95\u0bcc\u0bb0\u0bb5 \u0ba4\u0b95\u0bb2\u0b95\u0bae\u0ba4\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0b9a\u0bb3, \u0b87\u0ba9\u0bcd\u0b95\u0bb1\u0baf \u0ba4\u0bbf\u0ba9\u0bae\u0bcd \u0bae\u0bbf\u0b95 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0bae\u0bbe\u0ba9\u0ba4\u0bbe\u0b95\u0bc1\u0bae\u0bcd. \u0ba4\u0baa\u0bb0\u0bc1\u0ba8\u0bcd\u0b9a\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bae\u0bc2\u0b95 \u0b89\u0b9f\u0bcd\u0b95\u0b9f\u0bcd\u0b9f\u0b95\u0bae\u0baa\u0bcd\u0baa\u0bc1 \u0bb5\u0b9a\u0ba4\u0bbf\u0b95\u0bb3\u0bcd \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bbe\u0ba9\u0ba4\u0bc1 \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0b95\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bbe\u0b95\u0b9a\u0bb5\u0bbe, \u0ba4\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0b95\u0b9a\u0bb5\u0bbe, \u0bae\u0b95\u0bb2\u0baf\u0b95 \u0bae\u0bbe\u0b95\u0b9a\u0bb5\u0bbe \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bb2\u0bbe\u0bae\u0bcd, \u0b85\u0b95\u0ba9\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0b9a\u0ba4\u0b9a\u0b99\u0bcd\u0b95\u0b95\u0bb3\u0baf\u0bc1\u0bae\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bbf\u0b95\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b93\u0bb0\u0bcd \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0b95 \u0ba4\u0ba4\u0ba9\u0bcd\u0b95\u0ba9\u0baf\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bb2\u0bbe\u0bae\u0bcd, \u0baa\u0b95\u0ba9\u0baf\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bb2\u0bbe\u0bae\u0bcd, \u0b9a\u0ba4\u0baf\u0bbf\u0b95\u0bb2\u0baf\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bb2\u0bbe\u0bae\u0bcd, \u0b87\u0ba8\u0bcd\u0ba4 \u0b85\u0b95\u0ba9\u0ba4\u0bcd\u0ba4\u0bc1 \u0b89\u0bb1\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0b95\u0bb3\u0baf\u0bc1\u0bae\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bbf\u0b95\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0baf\u0bc8\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bc1 \u0b9a\u0bae\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0bae\u0bbe\u0ba9 \u0bb5\u0bbf\u0bb5\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0b99\u0bcd\u0ba4\u0b95\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0bbf\u0bb2\u0bcd \u0ba8\u0bbe\u0ba9\u0bcd \u0bae\u0bbf\u0b95\u0bc1\u0ba8\u0bcd\u0ba4 \u0bae\u0b95\u0bbf\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0baf\u0b95\u0b9f\u0b95\u0bbf\u0ba9\u0bcd\u0b9a\u0bb1\u0ba9\u0bcd."
