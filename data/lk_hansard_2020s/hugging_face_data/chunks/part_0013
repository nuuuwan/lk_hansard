    "chunk_text": "\u0d85\u0daf \u0dd2\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dd4\u0db8 \u0db4 \u0dca\u200d\u0dbb \u0dcf\u0db1\u0dc0\u0dbd\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0dc1\u0daf\u0db1\u0dca\u0db1\u0da7 \u0dd2\u0dbb \u0dd2\u0dbd \u0d9a\u0dd2\u0dbd\u0dba \u0d9c\u0dad \u0dc0\u0db1\u0dc0\u0dd2. \u0d92 \u0d85\u0dad\u0dba\u0db8 \u0db8\u0da7\u0dad\u0dca \u0d9a\u0dbb\u0dd4\u0da7 \u0dc1\u0daf\u0d9a \u0db8\u0dad\u0dd4 \u0d9a\u0dba\u0db1\u0dca\u0db1\u0da7 \u0dd4\u0db8\u0dc0\u0db8\u0db1\u0dd2\u0dc0\u0d9a\u0dd4\u0dad\u0dca \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dd2. \u0d9c\u0dbb\u0dd4 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d85\u0db8\u0dd2\u0dad\u0dba\u0dad\u0dd4\u0db8\u0dd2 \u0dd2\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0d9a\u0dcf\u0dd2\u0dc1\u0dda \u0d85\u0d82\u0d9a 36 \u0dba\u0da7\u0dc1\u0dad\u0dca, \u0d9a\u0dbd\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dc4 \u0db8\u0dd2\u0db0\u0dba\u0dc1\u0dda\u0daf\u0dd3\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dd2\u0daf\u0dd2\u0dc1\u0d9a\u0dc1\u0dba\u0db1 \u0db1\u0dd2\u0dc0\u0dd2\u0dc3 \u0dc0\u0dba\u0dd2\u0db4\u0dd8\u0dd2 \u0dba\u0d9a\u0da7 \u0dd2\u0dad\u0dd2 \u0dd2\u0dbb \u0dd2\u0dbd \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dca\u200d\u0dbb\u0db8\u0dd2\u0da7\u0dba \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dc5 \u0db6\u0dc0 \u0db6\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dd2\u0da7 \u0db8\u0dad\u0d9a \u0d87\u0dd2 . \u0dc1\u0dc2\u0dca\u0da8\u0db1\u0dca\u0dc1\u0dc4\u0dda\u0dda \u0dd2\u0dbb\u0dba\u0db1 \u0da0\u0dd3\u0db1 \u0dc3\u0dc4\u0dc1\u0dba\u0ddd\u0d9c\u0dd2\u0dad\u0dd2 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0dc3\u0db8\u0dd9 \u0dc1\u0d9a\u0ddc\u0dca)\u0da7\u0dd2\u0dc0 \u0db4\u0dbd\u0dad\u0dd4\u0dbb\u0dd4\u0dc0\u0dad\u0dca\u0dad \u0dca\u200d\u0dbb\u0dc1\u0daf\u0dca \u0dc1 \u0db1\u0dd2\u0dc0\u0dd2\u0dc3 \u0d92\u0d9a\u0d9a 1,996 \u0dd2\u0daf\u0dd2\u0dc1\u0d9a\u0dc1\u0dba\u0db1\u0dc0\u0dd2. \u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dd2\u0dc3 \u0d92\u0d9a\u0d9a 108 \u0d9a\u0dbd\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0da7 \u0dc3\u0dc4 \u0db8\u0dd2\u0db0\u0dba\u0dc1\u0dda\u0daf\u0dd3\u0db1\u0dca\u0da7 \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0dc0\u0db1\u0dca \u0dc1\u0d9a\u0dc1\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0db8\u0dd6\u0dbd\u0dd2\u0dc3\u0db1\u0dd2\u0dbb\u0dd6\u0daa \u0d89 \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2."
  },
