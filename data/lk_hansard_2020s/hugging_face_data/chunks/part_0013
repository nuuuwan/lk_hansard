0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bc6\u0bbe\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bb1)] - \u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bbf\u0bb2\u0bcd \u0b86\u0bb0\u0bc6\u0bbe\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1 [\u0baa: 2491-2626]\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d82\u0d9a\u0dcf \u0dd9\u0dcf\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dc4\u0dcf \u0dc3\u0dc4\u0ddd \u0dbd\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab \u0d86\u0dba\u0dad\u0dca\u0db1\u0dba:\n\n\u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0dc0 (2021) [\u0dad\u0dd3 \u0db8\u0dc0 2626]\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d82\u0d9a\u0dcf \u0dd9\u0dcf\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dd9\u0dcf\u0d82\u0dc0\u0dbb\u0dca\u0dad\u0db0\u0dcf\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba:\n\n\u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0dc0 (2021) [\u0dad\u0dd3 \u0db8\u0dc0 2627]\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d82\u0d9a\u0dcf \u0dd9\u0dcf\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dd9\u0dcf\u0d82\u0dc0\u0dbb\u0dca\u0dad\u0db0\u0dcf\u0db1 \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd:\n\n\u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0dc0 (2021) [\u0dad\u0dd3 \u0db8\u0dc0 2627]\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d82\u0d9a\u0dcf \u0dd9\u0dcf\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0dad\u0db0\u0dcf\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0dad\u0dba\u0dcf\u0dcf\u0d82\u0dc1\u0dba\u0dba:\n\n\u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0dc0 (2021) [\u0dad\u0dd3 \u0db8\u0dc0 2627]\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d82\u0d9a\u0dcf \u0dd9\u0dcf\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0dad\u0db0\u0dcf\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0dad\u0dba\u0dcf\u0dcf\u0d82\u0dc1\u0dba\u0dba:\n\n\u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0dc0 (2022) [\u0dad\u0dd3 \u0db8\u0dc0 2628]\n\n\u0b87\u0bb2\u0b99\u0bcd\u0bae\u0b95 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bc6\u0bbe \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb2\u0bb9\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bb2\u0bcd \u0bae\u0bc1\u0b95\u0bc6\u0bbe\u0bae\u0bae\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\n\n\u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0b95\u0bae\u0bcd:\n\n\u0bb5\u0bb0\u0bc1\u0b9f\u0bc6\u0bbe\u0ba8\u0bcd\u0ba4 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0bae\u0b95 (2021) [\u0baa: 2626] \u0b87\u0bb2\u0b99\u0bcd\u0bae\u0b95 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bc6\u0bbe \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bc6\u0bbe\u0bb0\u0b9a\u0bae\u0baa:\n\n\u0bb5\u0bb0\u0bc1\u0b9f\u0bc6\u0bbe\u0ba8\u0bcd\u0ba4 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0bae\u0b95 (2021) [\u0baa: 2627] \u0b87\u0bb2\u0b99\u0bcd\u0bae\u0b95 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bc6\u0bbe \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0ba8\u0bbf\u0ba4\u0bbf\u0baf\u0bae\u0bcd:\n\n\u0bb5\u0bb0\u0bc1\u0b9f\u0bc6\u0bbe\u0ba8\u0bcd\u0ba4 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0bae\u0b95 (2021) [\u0baa: 2627] \u0b87\u0bb2\u0b99\u0bcd\u0bae\u0b95 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bc6\u0bbe \u0b8a\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0baa\u0bcd \u0baa\u0ba3\u0bbf\u0baf\u0b95\u0bae\u0bcd:\n\n\u0bb5\u0bb0\u0bc1\u0b9f\u0bc6\u0bbe\u0ba8\u0bcd\u0ba4 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0bae\u0b95 (2021) [\u0baa: 2627] \u0b87\u0bb2\u0b99\u0bcd\u0bae\u0b95 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bc6\u0bbe \u0b8a\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0baa\u0bcd \u0baa\u0ba3\u0bbf\u0baf\u0b95\u0bae\u0bcd: \u0bb5\u0bb0\u0bc1\u0b9f\u0bc6\u0bbe\u0ba8\u0bcd\u0ba4 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0bae\u0b95 (2022) [\u0baa: 2628]\n\nSRI LANKA INSTITUTE OF TOURISM AND HOTEL\n\nMANAGEMENT: Annual Report (2021) [Col. 2626]\n\nSRI LANKA TOURISM DEVELOPMENT AUTHORITY:\n\nAnnual Report (2021) [Col. 2627]\n\nSRI LANKA TOURISM DEVELOPMENT FUND:\n\nAnnual Report (2021) [Col. 2627]\n\nSRI LANKA TOURISM PROMOTION BUREAU:\n\nAnnual Report (2021) [Col. 2627]\n\nSRI LANKA TOURISM PROMOTION BUREAU:\n\nAnnual Report (2022) [Col. 2628]\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dd2\u0dc3\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc0\n\n\u0baa\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0bb3\u0bc1\u0bae\u0ba9\u0bcd\u0bb1\u0bae\u0bcd PARLIAMENT \u2014\u2014\u2014\u2014\u2014\u2013\u2014-\n\n2025 \u0db8\u0dcf\u0dbb\u0dca\u0dad\u0dd4 15 \u0dc0\u0db1 \u0dc3\u0dd9\u0db1\u0dc3\u0dd4\u0dbb\u0dcf\u0daf\u0dcf\n\n2025 \u0bae\u0bc6\u0bbe\u0bb0\u0bcd\u0b9a\u0bcd 15, \u0b9a\u0ba9\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bb4\u0bae\u0bae Saturday, 15th March, 2025\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2013\u2014\u2014\n\n\u0db4\u0dd6.\u0db7\u0dcf. 9.30 \u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dd2\u0dc3\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc0 \u0dbb\u0dd0\u0dd9\u0db1 \u0dc0\u0dd2\u0dba. \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0db8\u0dcf [\u0d9c\u0dbb\u0dd4 (\u0dc0\u0dc0\u0daf\u200d) \u0da2\u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dca\u200d\u0dbb\u0db8\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0dcf]\n\n\u0db8\u0dd6\u0dbd\u0dcf\u0dd9\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dc0\u0dd2\u0dba.\n\n\u0baa\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0bb3\u0bc1\u0bae\u0ba9\u0bcd\u0bb1\u0bae\u0bcd \u0bae\u0bc1.\u0baa. 9.30 \u0bae\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bbf\u0baf\u0ba4\u0bc1. \u0b9a\u0baa\u0bc6\u0bbe\u0ba8\u0bc6\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd [\u0bae\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 (\u0bae\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bc6\u0bbe\u0bcd) \u0b9c\u0b95\u0ba4\u0bcd\n\n\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bb0\u0bae\u0bb0\u0ba4\u0bcd\u0ba9] \u0ba4\u0bae\u0bb2\u0bae\u0bae \u0bb5\u0b95\u0bbf\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd."
