    "chunk_text": "\u0db8\u0dd6\u0dbd\u0d9c \u0db1\u0d9c\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db4\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0dc3 \u0db1\u0dd2, \u0d9c \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0dba\u0db1\u0dba \u0d9a\u0dd0\u0db1 \u0d9c\u0dbd\u0dca\u0d9c\u0db8\u0dd4\u0dc0 \u0dbb \u0db1\u0dc1\u0d86 \u0d9c\u0dca\u200d\u0dbb\u0d9c\u0da7 \u0dba \u0d9c\u0dbb\u0dca\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c, \u0d9a\u0dd2\u0dc1\u0dbd\u0ddd\u0da7 \u0da7\u0dd0 1,300\u0d9a\u0da7 \u0dc0\u0dd2\u0da9\u0dd2 \u200d\u0dbb \u0d9c\u0dab\u0dba\u0d9a. \u0db4\u0dc3\u0dd4\u0dab\u0dd4\u0dba \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0dc1\u0daf\u0dca \u0dc1 \u0dc3 \u0d9c\u0dbb\u0dca\u0d9c \u0dc5\u0daf\u0db4\u0dad\u0db1, \u0db4\u0dd2\u0dc5\u0dd2 \u0d9a\u0dd0 \u0d9a\u0dd0\u0db4\u0dad\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0dad\u0dc0\u0dad\u0dca \u0dc0\u0dd2\u0dba\u0daf \u0dc3 \u0d9a\u0dd0\u0dbd\u0d9c \u0db1\u0dd2\u0dc5\u0dd2. \u0d92 \u0d9c\u0dd2\u0db1 \u0da7 \u0d9a\u0dd2\u0dba\u0db4\u0dad\u0db1 \u0d9a\u0db1\u0d9c\u0d9c\u0da7\u0dd4\u0dd2 . \u0d92 \u0d9c\u0dbb\u0dca\u0d9c\u0dc0\u0dbd\u0da7 \u0d91\u0d9a \u0dc1\u0db6\u0ddc\u0dd0\u0dbd\u0dd4 \u0d87\u0da7\u0dba\u0dca\u0dad\u0dc0\u0dad\u0dca \u0daf\u0d9c\u0dbd\u0d9c \u0db1\u0dd2\u0dc5\u0dd2. \u0d92 \u0db1\u0dd2 \u0d9c \u0d92 \u0d9c\u0dbb\u0dca\u0d9c \u0db4\u0daf\u0dca\u0db1\u0dad\u0dd2\u0dba \u0d85\u0db6\u0dbd\u0db4\u0dad \u0dc1\u0dc0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db4\u0dad\u0dc1\u0db4\u0dad; \u0dad \u0d9c\u0dbb\u0dca\u0d9c \u0db4\u0daf\u0dca\u0db1\u0dad\u0dd2\u0dba \u0d85\u0db6\u0dbd\u0db4\u0dad \u0dc1\u0dc0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db4\u0dad\u0dc1\u0db4\u0dad. \u0db4\u0d9c \u0dbd\u0dca \u0dba\u0db1 \u0daf\u0dbb\u0dd4\u0dc1\u0dc0\u0ddd \u0d89\u0dad\u0d9c \u0d85 \u0d9c\u0dbb\u0dd4\u0dc1\u0dc0\u0db4\u0dad \u0db4\u0d9c \u0dbd\u0da7 \u0dba\u0db4\u0dad\u0dc1\u0db4\u0dad. \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0d9c\u0dc0\u0dbd\u0da7 \u0dba\u0db1 \u0d85\u0dba, \u0db6 \u0dbb\u0dae \u0dbb\u0dd2\u0dba\u0dd2\u0daf\u0dd4\u0dd0\u0db4\u0dad \u0dc1 \u0dc3 \u0dad\u0dba\u0dbd\u0dd4 \u0dc1\u0daf\u0db1\u0d9c \u0d85 \u0d9c\u0dbb\u0dd4\u0dc1\u0dc0\u0db4\u0dad \u0dad \u0dd2 \u200d\u0dbb\u0dc0\u0d9c\u0dc5\u0db1 \u0d9a\u0da7\u0dd4\u0dad \u0dc3 \u0d9a\u0dd0\u0db8\u0dd2\u0db4\u0dad \u0dad\u0da7\u0dd2\u0dc1\u0d86. \u0dc5\u0dd2\u0db6\u0dd2\u0dd2 \u0d9c\u0dbb\u0dd4 \u0dba\u0db1\u0d9c\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dc3 \u0d9c, \u200d\u0dbb\u0dc0\u0d9c\u0dc5\u0db1 \u0dc5 \u0dc5\u0d9c \u0d9c\u0dbb\u0dca\u0d9c \u0d87 \u0dad\u0dd2 \u0dc3 \u0d9c \u200d\u0dbb\u0db8\u0dd4\u0d9b\u0dca\u200d \u0d85\u0dc1\u0db4\u0dca \u0dd0\u0dba\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dcf \u0d85\u0dba \u0dc0\u0dd2\u0dba \u0d87 \u0dc3\u0dc1\u0dcf \u0d9c\u0dca\u200d\u0dbb\u0d9c\u0da7 \u0dba \u0d9c\u0dbb\u0dca\u0d9c \u0db1\u0dc0\u0dd3\u0d9a\u0dd0\u0dab\u0dba \u0dcf\u0dc5\u0d9c; \u0d85\u0dbd\u0dd4\u0dad\u0dca\u0dc0\u0dd2\u0da9\u0dd2\u0dba\u0d9c \u0d9a\u0dd2\u0dbb\u0dd3 \u0dcf\u0dc5\u0d9c \u0dc0\u0dd2 \u0d9c\u0dbd \u0db8\u0dd4\u0daf\u0dbd\u0dca\u0dad \u0dc1\u0dc0\u0db4\u0dad \u0d9a\u0dd0 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dba\u0db1 29,680\u0d9a \u200d\u0dbb\u0dad\u0dd2\u0db4\u0d9c\u0daf\u0db1\u0dba\u0dca\u0dad \u0dc1\u0dc0\u0db4\u0dad \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c, \u0d9c\u0dca\u200d\u0dbb\u0d9c\u0da7 \u0dba \u0d9c\u0dbb\u0dca\u0d9c \u0d85\u0dbd\u0dd4\u0dad\u0dca\u0dc0\u0dd2\u0da9\u0dd2\u0dba\u0d9c \u0d9a\u0dd0\u0db4\u0dad\u0db1. \u0d92\u0d9a \u0d85\u0db4\u0dd2\u0da7 \u0d85\u0d9c\u0dba \u0d9a\u0dd0\u0db4\u0dad\u0db1 \u0dbb\u0dc0\u0dc5\u0dd4\u0dc0\u0db4\u0dad, \u0dc1\u0dba\u0ddd\u0dba\u0db1\u0d9c\u0dc0\u0dca\u0dad \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7. \u0d92 \u0dc0\u0d9c\u0dc1\u0dda \u0d9c\u0dca\u200d\u0dbb\u0d9c\u0da7 \u0dba \u0db4\u0d9c\u0dbd \u0dc3 \u0db1\u0dc0\u0dd3\u0d9a\u0dd0\u0dab\u0dba \u0d9a\u0dd0\u0db4\u0dad\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1,000\u0d9a \u0db8\u0dd4\u0daf\u0dbd\u0dca\u0dad \u0dc1\u0dc0\u0db4\u0dad \u0d9a\u0dd0 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d92 \u0dc0\u0d9c\u0dc1\u0dda , \u0d9c\u0dca\u200d\u0dbb\u0d9c\u0da7 \u0dba \u200d\u0dbb\u0dc1\u0daf\u0dca \u0dc0\u0dbd\u0da7 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d9c\u0dbd\u0d9c\u0dba\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d9c\u0dbd\u0dca\u0d94\u0dba, \u0dd0\u0d9c\u0dba\u0d9c\u0dc0\u0d9c\u0db1\u0dba, \u0db8\u0dd2\u0db4\u0dad\u0dc1\u0db4\u0dad\u0dbb\u0dd2\u0dba, \u0dc4\u0dd4\u0dbb\u0dd4\u0dc5\u0dd4\u0dc0\u0dd2\u0dc0 \u0dc1\u0dba\u0ddd\u0dba\u0db1\u0d9c \u0d9a\u0dca\u200d\u0dbb \u0dc0\u0dbd \u0db4\u0dc5\u0dcf \u0dc0\u0dc0\u0dbb\u0dca\u0db1\u0db1 \u0d9a\u0da7\u0dd4\u0dad \u0dc3 \u0d9a\u0dd0\u0db4\u0dad\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 2,000\u0d9a \u0db8\u0dd4\u0daf\u0dbd\u0dca\u0dad \u0dc1\u0dc0\u0db4\u0dad \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d85\u0db4\u0dd2 \u0daf\u0db4\u0dad\u0db1\u0dc0\u0d9c, \u0dd0\u0d9c\u0dba\u0d9c\u0dc0\u0d9c\u0db1\u0dba \u0dba\u0dbd \u0dc0\u0dd9\u0d9c\u0db4\u0d9c\u0dd0\u0dba \u0d87 \u0dc3\u0dc1\u0dcf \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0d9c\u0dab\u0db1\u0d9c\u0dc0\u0d9a\u0dd2\u0db4\u0dad \u0d87\u0dcf \u0dc1\u0dda\u0dbd\u0dd2 \u200d\u0dbb\u0dad\u0dd2 \u0dc0 \u0d9a\u0dd0\u0dab\u0dba \u0dc1\u0dc0\u0dbd\u0d9c \u0db1\u0dd2\u0dc5\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0d9c. \u0dc1 \u0dc3 \u0dc0\u0dd9\u0d9c\u0db4\u0d9c\u0dd0\u0dba \u0dc3\u0dcf \u0db4\u0dc5\u0dcf\u0da7 \u0dba\u0dbd\u0dba \u0dc1\u0d9c\u0db1\u0dd2\u0dba\u0db4\u0dad\u0db1 \u0dc5\u0dd2\u0d9a\u0dd2\u0dba\u0d9c\u0dc0\u0dca\u0dad \u0db1\u0dd2\u0dc5\u0dd2. \u0dc1 \u0dc0\u0dd0 \u0d85\u0dba \u0dc0\u0dd2\u0dc1\u0dba\u0db4\u0dad \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 500\u0d9a\u0da7 \u0d85\u0db0\u0dd2\u0d9a \u0db8\u0dd4\u0daf\u0dbd\u0dca\u0dad \u0dc1\u0dc0\u0db4\u0dad \u0d9a\u0dd0\u0dbd\u0d9c \u0d92 \u0dc1\u0dba\u0ddd\u0dba\u0db1\u0d9c\u0dc0 \u200d\u0dbb\u0dd2\u0dba\u0d9c\u0dad\u0dca \u0d9a \u0d9a\u0dd0\u0db1\u0dc0\u0d9c.\n\n\u0dad\u0dba\u0dbd\u0dca\u0dbd \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0ddc\u0dad\u0dca, \u0dad \u0dc0\u0d9c\u0dbb\u0dd2 \u0d9c\u0dbb\u0dca\u0d9c \u0dca\u0dad\u0dc1\u0dc2\u0dca\u0da8 \u0dad\u0dca\u200d\u0dbb\u0dba \u0dcf\u0dc5\u0d9c \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 78,000\u0d9a \u0daf\u0dd2\u0dc0\u0dd2\u0db4\u0dad\u0dad \u0db8\u0dd4\u0daf\u0dbd\u0dca\u0dad \u0dc1\u0dc0\u0db4\u0dad \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c, \u0d9c\u0dca\u200d\u0dbb\u0d9c\u0da7 \u0dba \u200d\u0dbb\u0dc1\u0daf\u0dca \u0dc0\u0dbd\u0da7 \u0dc0\u0dc0\u0dbb\u0dca\u0db1\u0db1\u0dba \u0dc1\u0dda\u0db4\u0dad\u0db1. \u0d92 \u0dc0\u0d9c\u0dc1\u0dda \u0d85\u0dbd\u0dd2 -\u0db8\u0dd2\u0db1\u0dd2 \u0d9c\u0dd2\u0da7\u0dd4 \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0db4\u0dad\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 640\u0d9a \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dd4\u0dad\u0dca \u0dc1\u0dc0\u0db4\u0dad \u0d9a\u0dd0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d92 \u0db1\u0dd2 \u0d9c \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0dba\u0db4\u0dad\u0db1 \u0dc3\u0da7\u0dd4\u0dd2 , \u0dd1 \u200d\u0dbb\u0dc1\u0daf\u0dca \u0dba\u0d9a\u0da7 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc0 \u0dd0\u0dab\u0dba \u0dc1\u0dc0\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7, \u0dc5\u0dd2 \u200d\u0dbb\u0dc1\u0daf\u0dca \u0dba\u0d9a\u0da7 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d9c\u0dbd\u0d9c \u0dba\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dc1 \u0dc3 \u0d85\u0dba \u0dc0\u0dd2\u0dba \u0dc3\u0dc5\u0dd2\u0db4\u0dad \u0d9a\u0da7\u0dd4\u0dad \u0dc3 \u0d9a\u0dd0 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db6\u0dc0. \u0d92 \u0db4\u0dd2\u0dad\u0dca\u0dc1\u0dad\u0db4\u0dad \u0dc1 \u0dc3 \u0d85\u0dba \u0dc0\u0dd2\u0dba \u0d9c\u0dbb\u0dca\u0dcf\u0d9a\u0dd2 ."
