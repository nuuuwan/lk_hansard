    "chunk_text": "\u0dc1 \u0dcf\u0d9a\u0d9a\u0dca\u0daf \u0dc1\u0dda MMC \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad? MMC \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dba\u0dcf\u0dad \u0dc0\u0dd2\u0db3\u0dd2\u0db1 \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0dad\u0dbb\u0dd4\u0dab \u0db4\u0dbb\u0dda\u0db4\u0dbb\u0dcf\u0dc0 \u0d91\u0d9a\u0dd4 \u0d9a\u0dbb\u0db1 \u0dad\u0d9a\u0db1\u0d9a\u0dca; \u0dd2 \u0db1\u0dca\u0dad\u0daf\u0dd4 \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0db1\u0d8b \u0dd2 \u0db1\u0dca\u0dad\u0daf\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0da0\u0dcf\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0d8b \u0dd2 \u0db1 \u0dcf\u0db4\u0da7 \u0dbb\u0dc3 \u0dc0\u0dd2\u0db1\u0dca\u0dad\u0daf\u0db1\u0dba\u0dcf\u0dad \u0d9a\u0dbb\u0db1 \u0dad\u0d9a\u0db1\u0d9a\u0dca \u0d92 \u0dc0\u0dcf\u0dc1\u0dda \u0d92 \u0db0\u0dba\u0dc3\u0dae \u0dcf\u0db1 \u0dad\u0dcf\u0d9a\u0dca\u0dc2\u0dab\u0dc1\u0dda \u0dc1\u0dad\u0ddd\u0dad\u0d9a\u0db1\u0dca\u0dad\u0db1\u0d9a\u0dca \u0db6\u0dc0\u0da7 \u0db4\u0db8 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1\u0db8 \u0d85\u0db4\u0dd2 \u0dc3\u0dd6\u0daf\u0dcf\u0db1\u0dda \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0d92 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2 \u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dc0\u0d8b \u0db8\u0dd2 \u0dba\u0dcf\u0dc0\u0d8b \u0d92 \u0dc0\u0dcf\u0dc1\u0dda \u0dca\u0daf\u0dbb\u0dba\u0dcf\u0dad\u0d8b \u0d92 \u0dc0\u0dcf\u0dc1\u0dda \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1\u0dba\u0dcf\u0dad\u0d8b \u0d92 \u0dc0\u0dcf\u0dc1\u0dda \u0dca\u0dbb\u0dca\u0dbd\u0dd2\u0d9a\u0dba\u0dcf\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dc3\u0dcf\u0dc0\u0dcf\u0daf \u0d9a\u0dbb\u0db1\u0d8b \u0dad\u0dbb\u0dca\u0dbd\u0d9a \u0d9a\u0dbb\u0db1 \u0dad\u0d9a\u0db1\u0d9a\u0dca \u0db6\u0dc0\u0da7 MMCs \u0db4\u0db8 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d85\u0db4\u0dd2 \u0dc3\u0dd6\u0daf\u0dcf\u0db1\u0dda \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0d92 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0dad \u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dc1\u0dda MMCs \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0db1 \u0db6\u0dc4\u0dd4\u0dc0\u0dd2\u0db0 \u0db0\u0dba\u0dc3\u0dae \u0dcf\u0db1 \u0db1\u0dd2\u0dbb\u0dca\u0dbd \u0dcf\u0dab\u0dba\u0dcf\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db1\u0dd3\u0db1 \u0dad\u0dcf\u0dbb\u0dd4\u0dab\u0dba\u0dc1\u0dda\u0d8b \u0dc3\u0dcf\u0db8\u0dd6\u0dc4\u0dd2\u0d9a\u0db8\u0dc0\u0dc1\u0dda\u0d8b \u0d92 \u0dc0\u0dcf\u0dc1\u0dda \u0dca\u0daf\u0dbb\u0dc1\u0dda \u0dc1\u0dad\u0ddd\u0dad\u0d9a\u0db1\u0dca\u0dad\u0db1\u0d9a\u0dca \u0dc0 \u0dc1\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0dbb\u0da7 \u0db4\u0dd4\u0dbb\u0dcf MMC \u0db0\u0dba\u0dc3\u0dae \u0dcf\u0db1 \u0db1\u0dd2\u0dbb\u0dca\u0dbd \u0dcf\u0dab\u0dba\u0dcf\u0dad \u0d9a\u0dd2\u0dbb\u0dd3 \u0da7 \u0d85\u0db4\u0dd2 \u0dc1\u0dda \u0d85\u0dba\u0dcf\u0dad \u0dc0\u0d9a\u0dc1\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0dd4\u0dc0\u0daf\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf; \u0d92 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0d85\u0db4 \u0d9a\u0daf\u0dd2\u0dc4\u0db8 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf\n\n\u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dc1\u0dda \u0dad\u0dbb\u0dd4\u0dab \u0d9a\u0dcf\u0dbd\u0dba\u0dcf\u0dad\u0db8 \u200d\u0dbb \u0dc1\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0dc1\u0dad\u0dc1\u0dc0\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0db1\u0dd4\u0dc0\u0db8 \u0d85\u0db4\u0dd2 \u0d92 \u0dad\u0dbb\u0dd4\u0dab \u0db4\u0dd2\u0dbb\u0dd2\u0dc3 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0da2\u0dcf\u0dad\u0dba\u0db1\u0dca\u0dad\u0dad\u0dbb \u0dcf\u0db1\u0dc0 \u0dc1\u0dc0\u0dc1 \u0db3 \u0dc1\u0db4\u0dcf\u0dc1 \u0db1\u0dca\u0dad \u0dba\u0dcf\u0dad\u0dda \u0db4\u0dcf\u0d9c\u0dd4\u0dc0\u0d9a\u0dca \u0d85\u0db8\u0db4\u0db8 \u0d9a\u0dbb\u0dad\u0db1\u0dca\u0da