d\u0db1\u0dca\u0dad \u0da9\u0dd2\u0da2\u0dd2\u0da7\u0dca \u0dca\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0d85 \u0dcf\u0dad\u0dba\u0dcf\u0dcf \u0dba\u0dcf\u0dad \u0d91\u0d9a\u0dca\u0d9a\u0db8 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0 \u0dc1\u0dc0\u0dbd\u0dcf youth app \u0d91\u0d9a\u0d9a\u0dca \u0dc3\u0dcf\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba\u0dcf\u0dad \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca\u0dad \u0d89\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf\n\n\u0dad\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0dcf\u0dad\u0ddd\u0da2\u0dba \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dd2\u0dba\u0dcf\u0dad\u0db1\u0dd2\u0d8b \u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dad \u0dd4\u0db1\u0dbb\u0dd0\u0d9a\u0dd3\u0dc1\u0dda \u0db6\u0dbd\u0d9a\u0dcf\u0dba\u0dcf\u0dad\u0da7 \"\u0d9a\u0dca\u0dbd\u0dd3\u0db1\u0dca\u0dad \u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d9a\u0dcf\" \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0d85\u0db4\u0dd2 \u0dba\u0dcf\u0dad\u0dda \u0dd4\u0dc0\u0daf\u0dca \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dab\u0dba\u0dcf\u0dad\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf\n\n\u0d92 \u0dc0\u0dcf\u0dc1\u0dda \u0dad \u0dba\u0dd2\u0d8b \"\u0dc4\u0dc0\u0dc3\u0da7 IT\" \u0dc0\u0d9a\u0da9\u0dcf)\u0dc3\u0da7\u0dc4\u0db1 \u0d92 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0dcf\u0dad\u0da7 \u0d85\u0db4\u0dd2 \u0dc1\u0dda \u0dc0\u0dc3\u0dbb \u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dba\u0dcf\u0dad \u0d85\u0dbb\u0dc1\u0dad\u0db1\u0dba\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dc1 \u0dae\u0dc2\u0dc1\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0dad\u0dbb\u0dd4\u0dab\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0d91\u0d9a\u0dca\u0d9a \u0dc1\u0dc4\u0dcf\u0db3 \u0dc3\u0dcf\u0dc0\u0dcf\u0daf\u0dba\u0dcf\u0dad\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad\u0dc0\u0d8b \u0d92\u0dc1\u0dad\u0dcf\u0dca\u0dbd\u0db1\u0dca\u0dad\u0da7 \u0d95\u0db1\u0dd1 \u0d9a\u0dbb\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0dcf\u0dad\u0da7\u0d8b \u0d91\u0d9a \u0dad\u0dbd\u0dba\u0dcf\u0dad\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0d92\u0dc1\u0dad\u0dcf\u0dca\u0dbd\u0db1\u0dca\u0dad\u0dc1\u0dda \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dba\u0dcf\u0dad \u0dc3\u0dc3\u0dae\u0dc3\u0dbd\u0dcf \u0dad\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0dcf\u0dad\u0da7 social media platform \u0d91\u0d9a\u0d9a\u0dca \u0dc0\u0dcf\u0dc1\u0dda platform \u0d91\u0d9a\u0d9a\u0dca \u0dc4\u0daf\u0db1 \u0d91\u0d9a \u0dc3\u0dc4 \u0dad\u0dc0\u0db8 \u0dc0\u0dd2 \u0dcf\u0dbd \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0dcf \u0dc1\u0dbb\u0dcf\u0db8\u0dd4 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dab\u0dba\u0dcf\u0dad\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0d92 \u0dc0\u0dcf\u0dc1\u0dda \u0d85\u0db4\u0dd2 V4R \u0dc0\u0d9a\u0da9\u0dcf)\u0dc3\u0da7\u0dc4\u0db1\u0db8\u0d8b \u0da9\u0dd2\u0da2\u0dd2\u0da7\u0dca\u0d9a\u0dbb\u0dab\u0dba\u0dcf\u0dad\u0db8 \u0d91\u0d9a\u0dca\u0d9a -"
