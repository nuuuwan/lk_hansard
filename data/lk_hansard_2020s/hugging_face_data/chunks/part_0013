    "chunk_text": "\u0d9c \u0d85\u0dd0 \u0db8\u0dd4\u0dbd\u0dd2\u0db4\u0dad \u0d9a\u0dd2\u0dda\u0dc0\u0d9c \u0dc0\u0d9c\u0dc1\u0dda \u0d85\u0dc1\u0db4\u0dca \u0dd0\u0dc1\u0da7\u0dca \u0db6\u0daf\u0dd4 \u0dc1\u0d9c\u0dc0\u0db1 \u0dba\u0db1\u0dad\u0d9c\u0dc0 \u0d89\u0dbd\u0dca\u0dbd\u0db1 \u0dc1\u0daf\u0dba\u0dca\u0dad \u0dad \u0dd2 , \u0d85\u0db4\u0da7 \u0d9c\u0db1\u0d9c\u0dd0\u0dab \u0db6\u0daf\u0dca\u0daf\u0dca\u0dad \u0dc1\u0daf\u0db4\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a. \u0dc1 \u0dc3 \u0d85\u0db1\u0dd4\u0dc0 \u0d9c\u0db1\u0d9c\u0dd0\u0dab \u0db6\u0daf\u0dd4 \u0d9a\u0dca\u200d\u0dbb \u0dba\u0dca\u0dad \u0dc1\u0dba\u0ddd\u0dba\u0db1\u0d9c \u0dc1\u0dc0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0d92 \u0dc0\u0dd2\u0dad\u0dd0\u0dca\u0dad \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dd2 . \u0d94\u0dc0\u0dd4\u0db4\u0dad \u0d89\u0dbd\u0dca\u0dbd\u0db1 \u0dc1\u0daf\u0dca \u0dad \u0dd2 , \u0d85\u0db4\u0dd2 \u0dc1\u0d9c\u0dc0\u0db1 \u0db6\u0daf\u0dca\u0daf \u0db1\u0d9c \u0dad\u0dd2 \u0d9a\u0dd0\u0db4\u0dad\u0dc1\u0db4\u0dad \u0db1\u0dd2 \u0dc3\u0dc0 \u0d9a\u0dca\u200d\u0dbb \u0dc0\u0dad\u0dca\u0dc0 \u0dd0\u0dc1\u0da7\u0dca \u0daf\u0dd2\u0dd4\u0dad\u0db8\u0dca\u0dc0\u0da7 \u0dc1\u0dba\u0ddc\u0daf\u0dc0\u0db4\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a. \u0d9a\u0dd2 \u0dd2\u0dad\u0dd2\u0dd2 , \u0dc1 \u0dc3 \u0d85\u0dba \u0dc0\u0dd2\u0dc1\u0dba\u0db4\u0dad \u0dc1\u0dba\u0ddd\u0dba\u0db1\u0d9c \u0dc1\u0dc0\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1, \u0d94\u0db6 \u0dc1\u0d9c\u0dc0\u0db1 \u0db6\u0daf\u0dd4 \u0dc1\u0dba\u0daf\u0dc0\u0dd2\u0dbd\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dca\u0dad\u0dc1\u0dc2\u0dca\u0da8 \u0dad\u0dca\u200d\u0dbb \u0d9a\u0dd2\u0dd2\u0db4\u0db4\u0dba\u0dca\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dcf\u0dc0 \u0d9a\u0dbb\u0dd4\u0db8\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd0\u0db4\u0dad\u0db1. \u0d9c\u0dbb\u0dca\u0d9c, \u0db4\u0d9c\u0dbd \u0dc3, \u0daf\u0dd4 \u0dc3\u0dbb\u0dd2\u0dba \u0dc0\u0d9c\u0dc1\u0dda\n\n\u0d92 \u0dc0\u0d9c\u0dc1\u0dda \u0dc1\u0daf\u0dca \u0db4\u0d9c\u0dbd\u0db1 \u0dc0 \u0d9a\u0dd8\u0dad\u0dd2\u0dc1\u0d86 \u0dc1\u0dc0\u0db1 \u0dad\u0dca \u0d94\u0db6 \u0dad\u0dba\u0dbd\u0dd4\u0dc1\u0daf\u0db1\u0d9c \u0dc1 \u0dc3 \u0d85\u0dc0 \u0dcf\u0d9c\u0dc1\u0dda\u0daf\u0dd3 \u0dd2\u0dbd\u0d9a\u0dd2\u0dbd\u0dca\u0dbd\u0da7 \u0d9c\u0db4\u0dad\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0db4\u0dd2 \u0daf\u0db4\u0dad\u0db1\u0dc0\u0d9c, \u0dc0\u0d9c\u0dc5\u0db1 \u0dc1\u0db4\u0dca\u0dc5\u0dd2\u0dc0\u0dbd \u0d9c \u0db4\u0dad \u0d9a\u0dd0\u0db1 \u0d87 \u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db4\u0dad, \u0db4\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0db4\u0dad \u0d85\u0daf \u0daf\u0d9a\u0dd2\u0db4\u0dad\u0db1 \u0db1\u0dd2\u0dc5\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0d9c. \u0dc1\u0db6\u0ddc\u0dc1\u0dc5\u0ddc \u0dd0\u0dbd \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dba\u0dca\u0dad \u0d9c\u0dad \u0d9a\u0dd0\u0db1 \u0dd2\u0dad\u0dd2, \u0d87 \u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db4\u0dad \u0dad \u0dd2 \u0daf\u0dd2\u0db4\u0dad \u0d89\u0db4\u0dad\u0dc1\u0db4\u0dad. \u0dc5\u0dba\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db1\u0d9c \u0dad\u0dd2 \u0d9a\u0dd0\u0db1 \u0d92 \u0dc1\u0daf\u0dca \u0db4\u0d9c\u0dbd\u0db1 \u0dc0 \u0d9a\u0dd8\u0dad\u0dd2\u0dba \u0dc1\u0dc0\u0db1\u0dd4\u0dc0\u0da7 \u0dc5\u0dba\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d85\u0db1\u0dd2 \u0dad \u0dc1\u0dbd \u0db7\u0d9c\u0dc0\u0dd2\u0dad \u0dc1\u0db1\u0ddc\u0d9a\u0dd0\u0db1 \u0dc1\u0daf\u0dca \u0db4\u0d9c\u0dbd\u0db1 \u0dc0 \u0d9a\u0dd8\u0dad\u0dd2\u0dba\u0dca\u0dad \u0d85\u0db4\u0dd2 \u0dc5\u0db3\u0dd4\u0db4\u0dad\u0dc0\u0d9c \u0daf\u0dd3 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0d9c. \u0dc1 \u0db4\u0dad\u0db1 \u0dc1 \u0dc3 \u0d9c\u0db1\u0db1\u0dd3\u0dba \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0dad\u0dca, \u0db1\u0dc0 \u0db4\u0dbb\u0dd2\u0dc0\u0dbb\u0dca\u0dad\u0db1\u0dba\u0dad\u0dca \u0dc1\u0daf \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0db8\u0dd4."
  },
