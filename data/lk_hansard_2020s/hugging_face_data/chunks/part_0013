    "chunk_text": "\u0dd2 \u0dba\u0dcf\u0dad\u0dca\u0dbd \u0dca\u0db1\u0dba\u0dcf\u0dad\u0db1\u0dba\u0dcf\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0dd2 \u0dda\u0db0 \u0dc0\u0dd4\u0dab\u0dcf \u0d91\u0dc1\u0dc3\u0dae \u0dca\u0db1\u0dba\u0dcf\u0dad\u0db1\u0dba\u0dcf\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dda\u0daf\u0dd3\u0d8b \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0db4\u0dcf\u0dbd\u0d9a\u0dc1\u0dba\u0dcf\u0dad\u0ddd \u0db1\u0dd2\u0dc2\u0dae\u0db4\u0dcf\u0daf\u0db1 \u0dca\u0dbb\u0dca\u0dbd\u0dd2\u0d9a\u0dba\u0dcf\u0dad \u0dc1\u0dad\u0dcf\u0da9\u0dcf)\u0db1 \u0db1\u0dc0\u0dcf \u0dc1\u0dc0\u0db1\u0dd4\u0dc0\u0da7 \u0d92 \u0dc1\u0dda\u0dc0\u0dca \u0dca\u0db1\u0dba\u0dcf\u0dad\u0db1\u0dba\u0dcf\u0dad \u0d9a\u0dd2\u0dbb\u0dd3 \u0dc4\u0dbb\u0dc4\u0dcf \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0da7 \u0dc1\u0d9a\u0dcf\u0db8\u0dd2\u0dc3\u0dae \u0d9a\u0dd4\u0da7\u0dca\u0da7\u0dd2 \u0dc1\u0dad\u0dcf\u0da9\u0dcf) \u0dad\u0dc3\u0dcf\u0dad\u0db1\u0dca\u0dad\u0db1 \u0db4\u0da7\u0db1\u0dca\u0dad \u0dad\u0db8\u0dad\u0dcf \u0dca\u0da9\u0dd4\u0d9a\u0dca \u0dcf\u0dbb\u0dd4 \u0dc0\u0dd4\u0dab\u0db8\u0d8b \u0dc1 \u0dcf\u0db1 \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0db6\u0dbd\u0dba\u0dcf\u0dad\u0da7 \u0dca\u0dc0\u0db8 \u0d9a\u0dbb\u0dca\u0dbd \u0dcf\u0db1\u0dca\u0dad\u0dad \u0d85 \u0dcf\u0dad\u0dba\u0dcf\u0dcf \u0dba\u0dcf\u0dad \u0db1\u0dd2\u0dc1\u0dba\u0dcf\u0dad\u0ddd\u0da2\u0db1\u0dba\u0dcf\u0dad \u0d9a\u0dbb\u0db4\u0dd4 \u0dc3 \u0dc4\u0dbb \u0d87 \u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad \u0d91 \u0d85 \u0dcf\u0dad\u0dba\u0dcf\u0dcf \u0dba\u0dcf\u0dad \u0db6\u0dc4\u0dd2\u0dbb\u0dc0\u0dc1\u0dba\u0dcf\u0dad\u0ddd \u0dc0\u0dcf\u0dc1\u0dda \u0d85\u0dca\u0dbd\u0dcf \u0dc1\u0dad\u0db1 \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf\u0dad\u0dcf \u0d92\u0dc0\u0dcf \u0d85\u0dad \u0dc4\u0d9a\u0dbb\u0dd2\u0dc1\u0dda \u0db1\u0d9a\u0dc4\u0d9a \u0db1\u0dd4\u0dc0\u0db8 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dae\u0dd4\u0db1 \u0d92\u0d9a \u0dc1\u0dc0\u0db1\u0dc3\u0dae \u0d9a \u0dcf Ra