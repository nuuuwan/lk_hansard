    "chunk_text": "\u0dd2\u0d82\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0dd2\u0dc0 \u0db1\u0dd2\u0dad\u0dd2\u0d9a \u0dc1\u0dda\u0db8\u0dca\u0dc3\u0dcf \u0dc1\u0da7\u0dca \u0dca\u0d9c 8]67\u0daf\u0dd3 \u0d82\u0d9a\u0dd2\u0dc1\u0dda \u0dbd\u0dd6\u0dca \u0d9a\u0db3\u0dd4\u0dba2\u0dad\u0dca\u0dad\u0da7 \u0db8\u0dd4\u0dca \u0db8 \u0dc1\u0dad\u0dca \u0db4\u0dd0\u0dc5\u0dba \u0d85\u0dba\u0dc1\u0d9c\u0db1 \u0d86\u0dc1\u0dda \u0d85\u0db1\u0db8\u0dca\u0dc1\u0db6\u0dca \u0dc1\u0db1\u0ddc\u0dc12\u0dba\u0dd2. \u0d85\u0dc1\u0dda \u0dba\u0dc1\u0da7\u0dca \u0db1\u0dd0\u0dc1 \u0db1 \u0d9a\u0dc5\u0dd4 \u0dc1\u0dad\u0dca - black tea - \u0dc1 \u0ddd\u0d9a\u0dc1\u0dda \u0dc12\u0db1 \u0dc1\u0d9a\u0ddc\u0dc1\u0db1\u0dda2\u0dad\u0dca \u0dba\u0da7\u0d9a \u0db1\u0dd0\u0dc1 \u0dca \u0dc1\u0dca \u0db1\u0dd0\u0db1\u0dd0. \u0da7\u0d9a \u0db1\u0dd0\u0dc1 \u0dca \u0dc1\u0dca \u0d82\u0d9a\u0dd2\u0dc1\u0dda. \u0d82\u0d9a\u0dd2\u0dc1\u0dda\u0dad\u0dca \u0db1\u0dd0\u0dc1 \u0dca \u0dc1\u0dca \u0db8\u0dd2\u0dad\u0dba \u0dbb\u0dd2\u0dc3\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dd2 [\u0d9a\u0dc1\u0dda \u0dc1\u0dad\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd2\u0dc1\u0d9a\u0ddd\u0da7\u0dba \u0d9a\u0dd2\u0dba \u0dd2 \u0db1\u0db3\u0dd4\u0dca 2\u0db1 \u0dc1 \u0db1\u0dd2\u0dba\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0dc1\u0daf\u0dca \u0dc1\u0dda. \u0dc1 \u0ddd\u0d9a\u0dc1\u0dda \u0dc1\u0d9a\u0ddc\u0dc1\u0db1\u0dda2\u0dad\u0dca \u0dba\u0da7\u0d9a \u0dc3\u0dcf2\u0dd2\u0db7\u0dd2\u0dd2\u0dbd\u0d9a2 \u0d9a\u0dc5\u0dd4 \u0dc1\u0dad\u0dca \u0db1\u0dd0\u0dc1 \u0dca \u0dc1\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0db1\u0dd2\u0dc3\u0dd2 \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0dda\u0db8\u0dca\u0dc3\u0dcf \u0dc1\u0da7\u0dca \u0dca\u0d9c \u0d82\u0d9a\u0dd22\u0da7 \u0da7 \u0dc1\u0dad\u0dca \u0db4\u0dd0\u0dc5\u0dba \u0d85\u0dba\u0dc1\u0d9c\u0db1 \u0d86\u0dc1\u0dda. \u0da7 \u0dc1\u0dad\u0dca \u0db4\u0dd0\u0dc5\u0dba \u0d85\u0dba\u0dc1\u0d9c\u0db1 \u0d87\u0dd2\u0dbd\u0dca \u0dd2 \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0dc1\u0dda \u0dba\u0dc1\u0da7\u0dca \u0dc1\u0dad\u0dca \u