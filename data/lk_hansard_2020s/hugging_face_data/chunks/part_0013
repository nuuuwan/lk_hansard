1\u0dd0. \u0d9c\u0dd2\u0dba\u0dd2 \u0db1\u0db8\u0dca \u0dc3\u0dd3\u0db8\u0dd2\u0dad \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0da7\u0dba\u0d9a\u0da7 \u0dad\u0db8\u0dba\u0dd2 \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0dd2 \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0dab\u0dca. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d91\u0dc1\u0db1\u0db8 \u0db1\u0dd0\u0dad\u0dd42 \u0dd0\u0dca \u0d85\u0db4\u0dd2 \u0da7 \u0dc3\u0db8\u0dca\u0db6\u0dca \u0db0\u0dc1\u0dba\u0dca \u0dd2\u0dad\u0dd2 \u0dc1\u0db1\u0ddc\u0db3\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dba\u0dca \u0db1 \u0db6 \u0dd2\u0dc1\u0db4\u0ddc\u0dc1\u0dba\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0dc12\u0db12\u0dd2. \u0da7\u0d9a\u0da7 \u0d85 \u0dd2\u0dc5 \u0dc1\u0db1\u0ddc\u0db3 \u0dc3\u0dd0 \u0dd4\u0d9a\u0db8 [ \u0d86\u0dab\u0dca\u0da9\u0dd42 [ \u0dd2\u0dbd\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0db4\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db12\u0dd2. \u0da7 [\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dba\u0da7 \u0dc4\u0dd2\u0db8\u0dd2 \u0dad\u0dd0\u0db1 \u0d85\u0db4\u0dd2 \u0d85\u0db1\u0dd22\u0dd2\u0dca\u0d9c\u0dba\u0dc1\u0dba\u0dca \u0db6\u0dd2 \u0dbb\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0da7 [\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dba \u0dd2\u0dad\u0dd2 \u0dc1\u0db1\u0ddc\u0db3\u0da7 \u0dbb\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dba\u0dca \u0db1 \u0db4\u0dd4\u0dc5\u0dd42\u0dca [\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dba [. \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0dad\u0dca \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad2 \u0dc1 \u0ddd\u0d9a \u0dc12\u0dc1\u0dc5\u0db3 \u0dc1\u0db4\u0ddc\u0dc1\u0dc5\u0dda \u0d85\u0db4\u0da7 \u0dc1 \u0ddc \u0db4 \u0dad\u0dba\u0d9c\u0dba [ \u0db1\u0dd0\u0db1\u0dd0. \u0dc1 \u0ddd\u0d9a\u0dc1\u0dda \u0dc1\u0db6\u0ddc\u0dc1\u0db1\u0ddd \u0dba\u0da72 \u0dad\u0dca \u0d9c\u0dc3\u0dcf \u0db1\u0dd0\u0db1\u0dd0. \u0da7 \u0db1\u0dd2\u0dc3\u0dd2 \u0dc1\u0db8\u0dca\u0d9a \u0dc12\u0db1 \u0db8\u0dd2\u0dca\u0d9c\u0d9a\u0da7\u0dca \u0d91\u0d9a [. \u0d85\u0db4\u0da7 \u0dd0\u0dca \u0dc1\u0db1\u0ddc\u0db3 \u0dc3\u0dd0 \u0dd4\u0d9a\u0db8 [ \u0dad\u0dd2\u0dc1\u0db6\u0db12\u0dd2. \u0dd0\u0dca \u0dad\u0dca \u0dc3\u0d822\u0dca\u0d9c\u0db0\u0db1 \u0db8\u0dab\u0dca\u0da9 \u0dba\u0da7 \u0d85\u0db4\u0dd2 \u0dc1\u0db1\u0ddc\u0db3 \u0d9a\u0dab\u0dca\u0da9\u0dd2\u0dba\u0db8 [ \u0db4\u0dad\u0dca \u0d9a\u0dba \u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db12\u0dd2. \u0d9a\u0dbd\u0dd2\u0dca \u0dd2\u0dc0\u0daf\u0dd4 \u0d9a\u0dc5 \u0d86\u0d9a\u0dd2\u0dba\u0dc1\u0dda \u0dc1\u0daf\u0dca \u0db4\u0dd2 \u0db1 \u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0db1\u0ddc2\u0db1 \u0da7 [\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dd0\u0db1\u0dd4\u0db8 [ \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dd2\u0dad\u0dd2 \u0dc1\u0db1\u0ddc\u0db3 \u0d9a\u0dab\u0dca\u0da9\u0dd2\u0dba\u0db8 [ \u0db4\u0dad\u0dca \u0d9a\u0dba \u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db12\u0dd2. \u0da7 \u0db1\u0dd2\u0dc3\u0dd2 \u0d85\u0db4\u0dd2 \u0dd2\u0dbd \u0dcf2\u0dd2\u0dc3 \u0d9a\u0dba\u0db12\u0dd2 \u0da7 [\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dba\u0dad\u0dca \u0d85\u0db4\u0da7 \u0dd2\u0dad\u0dd2 \u0dc1\u0dda\u0d9c\u0dc1\u0dba\u0dca \u0dd2\u0dc3\u0dcf\u0dc3\u0dba\u0db1\u0da7 \u0d85\u0dba\u0dc1\u0d9c\u0db1 \u0dba\u0dca \u0db1 \u0db4\u0dd4\u0dc5\u0dd42\u0dca \u0d9a\u0dd2\u0dba \u0dd2. \u0d85\u0db4\u0da7 \u0dd2\u0dbd\u0dc1\u0daf\u0dca \u0dd2\u0dbd\u0db1\u0dd2\u0db8\u0dba \u0db6\u0dd2 \u0d9c\u0dca \u0db1 \u0db4\u0dd4\u0dc5\u0dd42\u0dca [\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dba [ \u0dd2\u0dbd\u0db0\u0dd2\u0dba\u0da7 \u0da7 [\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dba \u0db4\u0dad\u0dca\u0d9a\u0dba \u0d9c\u0dca \u0db1 \u0db4\u0dd4\u0dc5\u0dd42\u0dca ."
