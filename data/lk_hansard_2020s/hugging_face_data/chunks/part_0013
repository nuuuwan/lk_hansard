ae\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0ba4\u0bcd\u0baf\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9) (The Hon. K.V. Samantha Viddyarathna) \u0d9c\u0dc0 \u0d9a\u0dcf\u0dd2\u0db1\u0dd2\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db8\u0dd2 \u0db4\u0db1\u0dad \u0dc3\u0db3\u0db1\u0dca \u0dc1\u0dba\u0ddd\u0db1\u0db1\u0dd22 \u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0db4\u0dad\u0dca \u0d9a\u0dba\u0db12\u0dd2:\n\n\"1993 \u0d85\u0d82\u0d9a 58 \u0dba\u0db1 \u0dc1\u0dad\u0dca \u0db4\u0dca\u0d9c\u0dc1\u0dda\u0dc2\u0dca\u0da8\u0da7 \u0db8\u0dab\u0dca\u0da9 \u0db4\u0db1\u0dc1\u0dad\u0dca 86 2\u0d9c\u0dca \u0dad\u0dd2\u0dba \u0dba\u0da7\u0dc1\u0dad\u0dca 8084.08.81 \u0dbb\u0dd2\u0db1 \u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0db4\u0dad\u0dca \u0d9a\u0dba\u0db1 8088.88.18 \u0dbb\u0dd2\u0dc1\u0db1\u0dca \u0d852\u0dc3\u0dca \u0dc0\u0dd6 2\u0dca\u0d9c\u0dc2\u0dca\u0da8\u0dba \u0dc3\u0db3\u0db1\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dba\u0dc5 \u0d9a\u0dba\u0db1 \u0dd2\u0dbd\u0d9c\u0da7\u0d9a\u0dd2\u0db0\u0dd2\u0db4\u0dad\u0dd22\u0dba\u0dba\u0dd2\u0dc1 \u0db1\u0dd2\u0dbb\u0dd3 [\u0dc2\u0dca\u0da8\u0da7 \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d82\u0d9a\u0dd2 \u0dc1\u0dad\u0dca \u0db4\u0dca\u0d9c\u0dc1\u0dda\u0dc2\u0dca\u0da8\u0da7 \u0d86\u0dba\u0dad\u0db1\u0dc1\u0dda 8088 2\u0dca\u0d9c\u0dc2\u0dca\u0da8\u0dc1\u0dda 2\u0dd2\u0dca\u0d9c\u0dc2\u0dd2\u0d9a 2\u0dd2\u0dca\u0d9c\u0dad\u0dd22 \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0dba.\n\n(\u0db7\u0dd2\u0dab\u0dca\u0da9 \u0db1\u0dd2 \u0dc1\u0dc3\u0dda2\u0dd2 \u0d85\u0db4\u0db1\u0dba\u0db1 \u0dd2\u0db1\u0dc5 \u0db1\u0dd0\u0d82\u0dc0\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d86\u0d82\u0dc1\u0dd2\u0d9a \u0d85\u0db0\u0dd3 [\u0dc2\u0dca\u0da8\u0da7 \u0d9a\u0dd2\u0dba\u0d9a \u0dc3\u0db7\u0dd22 \u0dd2\u0dbd\u0dd2\u0dc0\u0dca 8084.05.84 \u0dbb\u0dd2\u0db1 \u0dc3 \u0d9a\u0dd2 \u0db6 \u0dd2 \u0d91\u0d9a\u0dd3 \u0d9a\u0dd2\u0dba\u0d9a \u0dc3\u0db7\u0dd2\u0dc1\u0dda 2\u0dd2\u0dca\u0d9c\u0dad\u0dd22 8084.06.80 \u0dbb\u0dd2\u0db1 \u0db4\u0dd2\u0dca\u0d9c\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd42\u0da7 \u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0db4\u0dad\u0dca \u0d9a\u0dba\u0db1 \u0daf\u0dd3.)\u0d91\n\n\u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0db1\u0dba \u0dd2\u0dbb\u0db8\u0dc3\u0db1 \u0dbd\u0daf\u0dd2\u0db1\u0dca, \u0dc3\u0db7\u0dcf \u0dc3\u0dca \u0db8\u0dad \u0dd2\u0dbb\u0dba. \u0bb5\u0bbf\u0ba9\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. Question put, and agreed to.\n\n\u0d9a\u0dd4\u0da9\u0dcf \u0dc0\u0dad\u0dca \u0dc0\u0dad\u0dd4 \u0dc3\u0dcf\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba: \u0dc0\u0dcf\u0dbb\u0dca\u0dc2\u0dd2\u0d9a\n\n\u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0 (2022) \u0b9a\u0bbf\u0bb1\u0bc1 \u0b9a\u0ba4\u0baf\u0bbf\u0b95\u0bb2\u0ba4\u0bcd \u0b9a\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0b9a\u0b95\u0baa: \u0bb5\u0bb0\u0bc1\u0b9f\u0bbe\u0ba8\u0bcd\u0ba4 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0b95 (2022)\n\nTEA SMALL HOLDINGS DEVELOPMENT\n\nAUTHORITY: ANNUAL REPORT (2022)\n\n\u0d9c\u0dd4 \u0dc0\u0d9a\u0dca.\u0dc0\u0dd3. \u0dc3\u0db8\u0db1\u0dca\u0dad \u0dd2\u0dbb\u0daf\u0dba\u0dcf\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0b95.\u0bb5\u0bc0. \u0b9a\u0bae\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0ba4\u0bcd\u0baf\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9) (The Hon. K.V. Samantha Viddyarathna) \u0d9c\u0dc0 \u0d9a\u0dcf\u0dd2\u0db1\u0dd2\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db8\u0dd2 \u0db4\u0db1\u0dad \u0dc3\u0db3\u0db1\u0dca \u0dc1\u0dba\u0ddd\u0db1\u0db1\u0dd22 \u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0db4\u0dad\u0dca \u0d9a\u0dba\u0db12\u0dd2:\n\n\"1975 \u0d85\u0d82\u0d9a 15 \u0dba\u0db1 \u0db4\u0da9\u0dd2 \u0dc1\u0dad\u0dca 2\u0dad\u0dd4 \u0dc3\u0d822\u0dca\u0d9c\u0db0\u0db1 \u0db4\u0db1\u0dad \u0dba\u0da7\u0dc1\u0dad\u0dca 8084.08.0 \u0dbb\u0dd2\u0db1 \u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0db4\u0dad\u0dca \u0d9a\u0dba\u0db1 8088.88.18 \u0dbb\u0dd2\u0dc1\u0db1\u0dca \u0d852\u0dc3\u0dca \u0dc0\u0dd6 2\u0dca\u0d9c\u0dc2\u0dca\u0da8\u0dba \u0dc3\u0db3\u0db1\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dba\u0dc5 \u0d9a\u0dba\u0db1 \u0dd2\u0dbd\u0d9c\u0da7\u0d9a\u0dd2\u0db0\u0dd2\u0db4\u0dad\u0dd22\u0dba\u0dba\u0dd2\u0dc1 \u0db1\u0dd2\u0dbb\u0dd3 [\u0dc2\u0dca\u0da8\u0da7 \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0db4\u0da9\u0dd2 \u0dc1\u0dad\u0dca 2\u0dad\u0dd4 \u0dc3\u0d822\u0dca\u0d9c\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dd2\u0db4\u0dad\u0dc1\u0dda 8088 2\u0dca\u0d9c\u0dc2\u0dca\u0da8\u0dc1\u0dda 2\u0dd2\u0dca\u0d9c\u0dc2\u0dd2\u0d9a 2\u0dd2\u0dca\u0d9c\u0dad\u0dd22 \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0dba.\n\n(\u0db7\u0dd2\u0dab\u0dca\u0da9 \u0db1\u0dd2 \u0dc1\u0dc3\u0dda2\u0dd2 \u0d85\u0db4\u0db1\u0dba\u0db1 \u0dd2\u0db1\u0dc5 \u0db1\u0dd0\u0d82\u0dc0\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d86\u0d82\u0dc1\u0dd2\u0d9a \u0d85\u0db0\u0dd3 [\u0dc2\u0dca\u0da8\u0da7 \u0d9a\u0dd2\u0dba\u0d9a \u0dc3\u0db7\u0dd22 \u0dd2\u0dbd\u0dd2\u0dc0\u0dca 8084.05.84 \u0dbb\u0dd2\u0db1 \u0dc3 \u0d9a\u0dd2 \u0db6 \u0dd2 \u0d91\u0d9a\u0dd3 \u0d9a\u0dd2\u0dba\u0d9a \u0dc3\u0db7\u0dd2\u0dc1\u0dda 2\u0dd2\u0dca\u0d9c\u0dad\u0dd22 8084.06.80 \u0dbb\u0dd2\u0db1 \u0db4\u0dd2\u0dca\u0d9c\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd42\u0da7 \u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0db4\u0dad\u0dca \u0d9a\u0dba\u0db1 \u0daf\u0dd3.)\u0d91 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0db1\u0dba \u0dd2\u0dbb\u0db8\u0dc3\u0db1 \u0dbd\u0daf\u0dd2\u0db1\u0dca, \u0dc3\u0db7\u0dcf \u0dc3\u0dca \u0db8\u0dad \u0dd2\u0dbb\u0dba. \u0bb5\u0bbf\u0ba9\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u