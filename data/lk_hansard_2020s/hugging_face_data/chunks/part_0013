    "chunk_text": "\u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf\u0d8b \u0dad\u0dbb\u0dd4\u0dab \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0dc3\u0dc4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf)\u0dcf \u0d85 \u0dcf\u0dad\u0dba\u0dcf\u0dcf \u0dba\u0dcf\u0dad \u0d87\u0dd4\u0dc1 \u0dae \u0dca\u0dba\u0dcf\u0dad\u0dad\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dab\u0dba\u0dcf\u0dad\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db6\u0dc0 \u0daf\u0dd3\u0dbb\u0dca\u0dbd\u0d9d \u0d9a\u0dcf\u0dbd\u0dba\u0dcf\u0dad\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0dae\u0dc1\u0dc3\u0dae \u0dc1\u0dda\u0dc0\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dcf\u0db8 \u0d9a \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0d8b \u0dbb\u0dc1\u0da7\u0dca \u0dad\u0dbb\u0dd4\u0dab \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dc0 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0d85\u0db4\u0dd2 \u0dc1 \u0dc0\u0dbb \u0d85\u0dba\u0dcf\u0dad \u0dc0\u0d9a\u0dc1\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dad\u0dbb\u0dd4\u0dab \u0dc1\u0dc3\u0dae\u0dc0\u0dcf \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dcf\u0dad\u0dca \u0db8\u0dd2\u0dd2\u0dba\u0dcf\u0dad\u0db1 600\u0d9a\u0dca \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0dc0\u0dba\u0dcf\u0db4\u0dca\u0dad\u0dd2 \u0dc3\u0db3\u0dc4\u0dcf \u0dc1\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0dc0\u0dd2\u0dc1 \u0dae\u0dc2\u0dc1\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dad \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc1\u0dba\u0dcf\u0dad\u0dcf\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0dc1\u0dc3\u0dae\u0db1\u0dcf\u0dcf\u0d9a\u0dba\u0dcf\u0dad\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dcf\u0dad\u0dca \u0db8\u0dd2\u0dd2\u0dba\u0dcf\u0dad\u0db1 500\u0d9a\u0dca \u0dc3\u0dc4 \u0db1\u0dcf\u0dba\u0dcf\u0dad\u0d9a\u0db8\u0dc0 \u0dc3\u0dcf\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db0\u0dba\u0dc3\u0dae \u0dcf\u0db1\u0dba\u0dcf\u0dad\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dcf\u0dad