    "chunk_text": "\u0d9a\u0dca\u0daf\u0dba\u0ddd\u0daf\u0dad\u0ddd \u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8 \u0dba\u0da7\u0daf\u0dad\u0dca \u0dc3\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0da2\u0dcf\u0dad\u0dba\u0db1\u0dca\u0dad\u0dba \u0daf\u0dda\u0dc1\u0d9c\u0dd4\u0dab \u0dd6\u0dbd\u0dbd\u0dba \u0dba\u0dab \u0dba\u0db1\u0dca\u200d\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0daf\u0dd9\u0dd2. \u0d91\u0dba \u200d\u0dbb\u0da2\u0dcf \u200d\u0dbb\u0dad\u0dba\u0dcf\u0dc3\u0dae\u0dd2\u0dad\u0dd2\u0dba 6\u200d\u0dbb \u0dd8\u0dad\u0db1 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dd9 \u0dc1\u0d9a\u0dca\u0dad\u0dd2\u0db8\u0dad\u0dca \u0daf \u0dcf\u0da7 \u0daf\u0dda\u0dc1\u0d9c\u0dd4\u0dab \u0d85\u0dd9\u0daf\u0dcf\u0db1\u0dda \u0d85\u0dd9\u0db8 \u0dba\u0dd4\u0dc0 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0da2\u0dbd \u0db8\u0db1\u0dcf \u0dba\u0dab, \u0dd8\u0dd2 \u0dbb\u0dca\u0dbd\u0db8, \u0daf\u0dd9\u0dba \u0dca\u0dba\u0d9a\u0dca\u0dc2 , \u0dd9\u0dba\u0dc3\u0db1 \u0d85\u0dd9\u0daf\u0dcf\u0db1\u0dda \u0d85\u0dd9\u0db8 \u0dba\u0dab \u0dc3\u0dc4 \u0db4\u0dbb\u0dd2\u0dc3\u0dba \u0db4\u0dda\u0db0\u0db1\u0dad\u0dd2 \u0db4\u0dcf\u0daf \u0dc0\u0dd2\u0dc3\u0db3\u0dd4\u0dda \u0dc3\u0dad\u0dd4\u0dc5\u0dd4 \u200d\u0dbb\u0dad\u0dba\u0d9a\u0dca\u0dc2 \u0d85\u0dd4\u0dc0\u0dd9\u0dbb\u0dca\u0dbd\u0dad\u0db1 \u0dd9\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 \u0dc4\u0dcf \u0dd9\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dba\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc3\u0db4\u0dba\u0dd2. \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf \u0dcf\u0dd9 \u0dba \u0dd9\u0da9\u0dcf\u0dad\u0dca \u0d85\u0dd9\u0daf\u0dcf\u0db1\u0dda \u0db4\u0dcf\u200d\u0dbb \u200d\u0dbb\u0da2\u0dcf\u0dd9\u0db1\u0dca\u0daf\u0dda \u0daf\u0dda\u0dc1\u0d9c\u0dd4\u0dab \u200d\u0dbb\u0dad\u0dba\u0dcf\u0dc3\u0dae\u0dd2\u0dad\u0dd2\u0dba \u0dd9\u0da9\u0dcf \u0dba\u0dc4\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0daf \u0daf\u0dba\u0dc4\u0dd2 \u0db1\u0dcf\u0dd2\u0d9c\u0dad \u0dd6 \u0dd9\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8 \u0dba\u0dd4\u0dc0 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0d85\u0dd4\u0dc0\u0dd9\u0dbb\u0dca\u0dbd\u0dad\u0db1 \u0d85\u0dba\u0db8\u0dd4\u0daf\u0daf\u0dbd\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0daf\u0dd9\u0dad \u0db4\u0dd2\u0dc0\u0dd2\u0dc3\u0dd3 \u0dc3\u0dad.\n\n\u2022 \u0d85\u0dbd\u0dcf\u0db7 \u0dc4\u0dcf\u0db1\u0dd2\u0dd9\u0dbd\u0da7 \u200d\u0dbb\u0dad\u0dd2\u0da0\u0dcf\u0dba \u0daf\u0dd0\u0d9a\u0dca\u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dd6\n\n\u0d85\u0dba\u0db8\u0dd4\u0daf\u0dbd 6FRLD)\n\n\u2022 \u0dc4\u0dbb\u0dd2\u0dcf \u0db8\u0dda\u0dc1\u0d9c\u0dd4\u0dda \u0d85\u0dad\u0db8\u0dd4\u0daf\u0dbd (GCF)\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf \u0dcf\u0dd9 \u0dc4\u0dbb\u0dd2\u0dad \u0daf\u0dda\u0dc1\u0d9c\u0dd4\u0dab \u0d85\u0dba\u0db8\u0dd4\u0daf\u0dbd 6GCF) \u0dc3\u0db8\u0d9f \u0dba \u0db1\u0dd2\u0dba\u0dd0\u0dc5\u0dd3\u0db8 \u0dc4\u0dba\u0dc4\u0dcf \u0da2\u0dcf\u0dad\u0dba\u0db1\u0dca\u0dad\u0dba \u0daf\u0dda\u0dc1\u0d9c\u0dd4\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0dba\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0dcf\u0dbb\u0dd3 \u0daf\u0dbd\u0dc3\u0db8 \u0daf\u0dcf\u0dba \u0dad\u0dca\u0dd9\u0dba \u0dbd\u0dd9\u0dcf \u0daf\u0daf\u0dd2. \u0dc4\u0dbb\u0dd2\u0dad \u0daf\u0dda\u0dc1\u0d9c\u0dd4\u0dab \u0d85\u0dba\u0db8\u0dd4\u0daf\u0dbd 6GCF) \u0daf\u0dd9\u0dad \u0da2\u0dcf\u0dad\u0dd2 \u0db1\u0dcf\u0db8\u0dd2\u0dad \u0dd9\u0dbd\u0db0\u0db1\u0dcf\u0dbb\u0dd2\u0dba\u0dcf \u0dd9\u0dc1\u0daf\u0dba\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf \u0dcf\u0dd9 \u0daf\u0dda\u0dc1\u0d9c\u0dd4\u0dab \u0dc0\u0dd2\u0db4\u0dbb\u0dca\u0dbd\u0dba\u0dcf\u0dc3 \u0dc4\u0dcf\u0db1\u0dd2 \u0d85\u0dd9\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0daf\u0db8\u0db1\u0dca\u0db8\n\n241 242\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9\n\n\u0d85\u0dd4\u0dc0\u0dd9\u0dbb\u0dca\u0dbd\u0dad\u0db1\u0dba \u0db8\u0dad \u0d85\u0dd9\u0db0\u0db1\u0dcf\u0db1\u0dba \u0daf\u0dba\u0dcf\u0db8\u0dd4 \u0dba\u0db1 \u0dd9\u0dc4\u0dd4\u0dc0\u0dd2\u0db0\u0db1 \u0dd9\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dba\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc3\u0dcf\u0dbb\u0dca\u0dbd\u0dd2 \u0daf\u0dbd\u0dc3 \u0dbd\u0dd9\u0dcf \u0daf\u0d9c\u0db1 \u0dc3\u0dad. \u0daf\u0db8\u0dba\u0da7\u0da7 \u0da2\u0dcf\u0dad\u0dd2 \u0dd9\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 2\u0d9a\u0dca, \u0dbd\u0dcf\u0db4\u0dd3\u0dba \u0dd9\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 3\u0d9a\u0dca \u0dc3\u0dc4 \u0dc3\u0dd6\u0daf\u0dcf\u0db1\u0dda\u0db7\u0dcf\u0dd9 \u0dd6\u0dbd\u0dbd \u0dd8\u0dad\u0dba\u0dba\u0db1\u0dca \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dd6\u0dbd\u0dbd\u0dba \u0dca\u0db0\u0db1\u0dcf\u0dba \u0dbd\u0dd0\u0db6\u0dd3 \u0dc3\u0dad\u0dd2 \u0d85\u0dad\u0dba, \u0d91\u0dc4\u0dd2 \u0d91 \u0dad\u0dd4\u0dd9 \u0d9c\u0dad\u0dca \u0d91\u0dba \u0daf\u0dda\u0dc1\u0d9c\u0dd4\u0dab \u200d\u0dbb\u0dad\u0dba\u0dcf\u0dc3\u0dae\u0dd2\u0dad\u0dd2\u0dba \u0dad\u0dd4 \u0dc3\u0dd4\u0dc0\u0dd2\u0daf\u0dc1\u0dae\u0dc2\u0dd3 \u0dca\u0daf\u0dba\u0ddd\u0da2\u0db1\u0dba\u0d9a\u0dca \u0daf\u0dd9\u0dd2. \u0daf\u0db8\u0db8 \u0dd9\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 \u0da2\u0dbd \u0db8\u0db1\u0dcf \u0dba\u0dab\u0dba, \u0dad\u0dd2\u0dba\u0dc3\u0dcf\u0dba \u0dd8\u0dd2 \u0dbb\u0dca\u0dbd\u0db8\u0dba, \u0daf \u0dcf\u0dba\u0dbd\u0dca \u0db4\u0dba \u0dc3\u0dcf\u0dba\u0d9a\u0dca\u0dc2\u0dab\u0dba \u0dc3\u0dc4 \u0dd9\u0dbd\u0dc1\u0d9a\u0dca\u0dad\u0dd2- \u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0d9a\u0dca\u0dc2\u0db8 \u0dbd\u0db1 \u0db4\u0dda\u0db0\u0db1\u0dad\u0dd2 \u0dd9\u0dd0\u0db1\u0dd2 \u0dad\u0dd3\u0dba\u0dab\u0dcf\u0dad\u0dca\u0db8 \u0d9a\u0dca\u0daf\u0dc2\u0dae\u200d\u0dbb \u0dca\u0db8\u0db1\u0dca\u200d\u0dbb\u0dab\u0dba \u0dba\u0db1 \u0d85\u0dad\u0dba, \u0d91\u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dc4\u0dbb\u0dd2\u0dad\u0dcf\u0d9c\u0dcf\u0dba \u0dd9\u0dcf\u0dd4\u0dad \u0dc3\u0dcf\u0daf\u0d9a\u0dca\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dab\u0dba\u0db1\u0dca \u0dc3\u0dae\u0dcf\u0dcf\u0dd2 \u0dba\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0daf\u0dda \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd3\u0db1\u0dca\u0daf\u0dda \u0daf\u0dda\u0dc1\u0d9c\u0dd4\u0dab \u0dc0\u0dd2\u0db4\u0dbb\u0dca\u0dbd\u0dba\u0dcf\u0dc3 \u0db4\u0dd2\u0dc5\u0dd2\u0dd9\u0db3 \u0dba\u0dcf\u0db8\u0dd4 \u0dc3\u0dda\u0db8\u0dd4\u0dad\u0dd2\u0dba UNFCCC\u0dc4\u0dd2 \u0d85\u0dba\u0db8\u0dd4\u0dab \u0daf \u0daf\u0dba\u0dc4\u0dd2 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf \u0dcf\u0daf \u0dc3\u0db4 \u0dd0\u0db4 \u0dc0\u0dd3\u0db8 \u200d\u0dbb\u0daf\u0dbb\u0dca\u0dbd\u0dc1\u0db1\u0dba \u0daf ."
