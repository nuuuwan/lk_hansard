0da2 \u0db4\u0dca \u0dca\u0ddc\u0d82\u0da7\u0dbb\u0dca\u0dbd\u0dca\u200d\u0dca \u0db8:\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0dbd\u0dca\u0dd2\u0dca \u0d85\u0db1\u0dd4\u0da7 \u0db1\u0dd2\u0dc1\u0dda\u0da0\u0dd2\u0dad\u0da7 \u0dad \u0dc0\u0dd4\u0dbb\u0dd4 \u0dd9\u0dba\u0db8\u0d9c\u0dca :\u0dd4\u0db1\u0dca\u0dad\u0dc0\u0dd3\u0db8 \u0dc0\u0db4 \u0dd9\u0db4\u0dba\u0dd4\u0dd4 \u0dd9\u0dc5 \u0dd4\u0dbb\u0dd3 \u0db6\u0da7 : \u0db8 \u0dcf\u0db8\u0dba\u0dcf \u0db8\u0db4\u0dcf\u0dad\u0dcf\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dca\u0dba \u0db8\u0dbd\u0dca\u0dd9\u0dda \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad :\u0db1\u0dca\u0dad\u0da7\u0dcf \u0d87\u0dad. \u0db8\u0dda \u0db8\u0da7\u0dca\u0db8\u0dd9\u0dcf\u0db4 \u0dd9\u0db1\u0dca\u0dad\u0dca\u0db8\u0dda \u0da7\u0dd4\u0da9 \u0d86\u0dba\u0dda\u0dcf \u0dd9\u0dba \u0dad\u0dd2 \u0db8\u0db6\u0dca\u0da7\u0dcf. \u0db8\u0dda \u0db8\u0db8 \u0dc0\u0dcf\u0db8 \u0dcf\u0dad \u0da7\u0dca \u0dc0\u0dd2\u0db4 \u0d9a \u0db1\u0dd2\u0dbd\u0dca\u200d\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0d9a \u0d85:\u0dcf\u0dc5 \u0dca\u0db8\u0dd3\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0da7 \u0dd9\u0db4\u0dba\u0dd4\u0dd4 \u0dc3\u0dd2\u0daf\u0dd4 \u0dd9\u0dba\u0db8\u0dd2\u0db1\u0dca\u0dad \u0d85:\u0dcf\u0dc5 \u0db8\u0dad\u0dcf\u0dba\u0dd4\u0dbb\u0dd4 \u0d91\u0d9a\u0dca\u0dc0\u0dbb\u0dd0\u0dca\u0dda \u0dd9\u0dba \u0d9c\u0db1\u0dca\u0dad\u0dca\u0da7\u0dcf \u0dbb\u0dd3 \u0dca \u0d91\u0dd9 \u0dad\u0db8 \u0dc0\u0dd2\u0db1 \u0db1\u0dd2\u0dbd\u0dca\u200d\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dad\u0db8\u0dda \u0db4\u0dd4 \u0d9a\u0db8\u0dad\u0db1\u0dca\u0dad :\u0dd4\u0db1\u0dd4\u0dda\u0daf\u0dd3\u0dda \u0dd9\u0dba \u0dad\u0dd2 \u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad.\n\n(iv) \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0daf\u0dd3\u0db8 \u0dc0\u0dca\u0dcf \u0db4\u0dad\u0dca\u200d\u0dbb \u0db8 \u0daf\u0dd3\u0dbb\u0dca\u0dbd\u0d9d \u0dd9\u0dcf\u0dd3\u0dca \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0db8\u0db8 \u0dc0\u0db8\u0dad\u0d9a\u0dca\u0dc0 \u0db1\u0dd2\u0d9a\u0dd4 \u0d9a \u0dd9\u0dba \u0db8\u0dca\u0dcf\u0db8 \u0dc0\u0dd4\u0dad.\n\n(v) \u0db8\u0d9c\u0dcf\u0dc0\u0dd2\u0da2 \u0db4\u0dca \u0dca\u0ddc\u0d82\u0da7\u0dbb\u0dca\u0dbd\u0dca\u200d\u0dca \u0db8:\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0da7 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad :\u0dd4\u0db1\u0dd4\u0dda \u0daf\u0dd3 \u0d87\u0dad\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db8\u0db8 \u0dc0\u0db8 \u0dc0 \u0dad\u0da9\u0db8 \u0dc0 \u0dca \u0dcf \u0db8\u0db4\u0dcf\u0db8 \u0dcf\u0dba \u0dca \u0dca\u0dcf\u0dca\u200d\u0dcf\u0dba \u0dbd\u0db6\u0dcf\u0daf\u0dd3 \u0d87 \u0d9a\u0db8 \u0d9a \u0d85\u0d9a\u0dca\u0dc0\u0dd9\u0dba 10\u0d9a\u0dca\u0dc0 \u0dca \u0dcf \u0db4\u0db8 \u0dc0\u0dab\u0dd2."
