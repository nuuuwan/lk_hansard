f\u0daf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8 \u0dba\u0dd4\u0dc0 \u0dbd\u0dd9\u0db1 \u0dd9\u0dd0\u0da9\u0db4\u0dd2\u0dc5\u0dd2\u0daf\u0dd9 \u0dd9\u0daf\u0dbb\u0dca\u0dbd\u0daf;\n\n(ii) \u0dcf\u0dd9\u0db1\u0dca \u0daf\u0dd9 \u0db3\u0daf\u0db4\u0dcf\u0dbd \u200d\u0dbb\u0daf \u0dc1\u0dba 6Carbon Market Access) \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dba\u0da2\u0dba \u0dc0\u0dd2 \u0db1\u0dca \u0d9c\u0dd4\u0dc0 \u0dbd\u0dd9\u0db1 \u0db4\u0dd2\u0dba\u0dd9\u0dba \u0dd9\u0daf\u0dbb\u0dca\u0dbd\u0daf;\n\n\u0dba\u0db1\u0dca\u0db1 \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0daf\u0db8\u0db8 \u0dc3\u0db7\u0dcf\u0dd9\u0da7 \u0daf\u0db1\u0dca\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca\u0daf\n\n(\u0dca \u0daf\u0db1\u0dcf\u0d91\u0daf\u0dc3\u0dae \u0db1\u0dda, \u0d92 \u0db8\u0db1\u0dca\u0daf \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bbe\u0b9f\u0bb2\u0bcd \u0b85\u0bae\u0bae\u0b9a\u0bcd\u0b9a\u0bae\u0bb0\u0b95\u0bcd \u0b9a\u0b95\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0ba9\u0bbe:\n\n( \u0b85) (i) \u0b95\u0bbe\u0bc8\u0ba8\u0bbf\u0bae\u0bc8 \u0b9a\u0b9a\u0bb4\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0bae\u0ba4 (Climate Prosperity Plan) \u0ba8\u0bae\u0b9f\u0bae\u0bc1\u0bae\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0b95 \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0b95\u0bbe\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b87\u0bc8\u0b99\u0bcd\u0bae\u0b95\u0baf\u0bbf\u0bb2\u0bcd \u0ba8\u0bae\u0b9f\u0bae\u0bc1\u0bae\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bb5\u0bc1\u0bb3\u0bcd\u0bb3 \u0b9a\u0bb5\u0bae\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0baf\u0bbe\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n( ii) \u0b95\u0bbe\u0baa\u0ba9\u0bcd \u0b9a\u0ba8\u0bcd\u0bae\u0ba4\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b85\u0ba3\u0bc1\u0b95\u0bae\u0bc8 (Carbon Market\n\nAccess) \u0b89\u0bb1\u0bc1\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0b95 \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0b9a\u0bae\u0bb1\u0bcd\u0b9a\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0bae\u0b95\u0b95\u0bb3\u0bcd \u0baf\u0bbe\u0bae\u0bb5 \u0b8e\u0ba9\u0bcd\u0baa\u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n\u0b85\u0bb5\u0bb0\u0bcd \u0b87\u0b9a\u0bcd\u0b9a\u0bae\u0baa\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0bb0\u0bbe?\n\n( \u0b86) \u0b87\u0ba9\u0bcd\u0b9a\u0bb1\u0bb2\u0bcd, \u0b8f\u0ba9\u0bcd?\n\nasked the Minister of Environment:\n\n(a) Will he inform this House the -\n\n(i) forthcoming arrangement that is in place in Sri Lanka to implement the Climate Prosperity Plan; and\n\n(ii) measures that will be undertaken by the Government to ensure access to the Carbon Market?\n\n(b) If not, why? \u0d9c\u0dbb\u0dd4 (\u0dc0\u0dc0\u0daf\u0dba) \u0daf\u0dda\u0dd2\u0dba\u0d9a \u0db4\u0da7\u0db6\u0dd0\u0dd2 \u0db8\u0dc4\u0dcf\u0dcf (\u0db4\u0dbb\u0dd2\u0dc3\u0dad \u0d85\u0db8\u0dcf\u0dcf\u0dba\u0dd4\u0db8\u0dcf) (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 (\u0bae\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bcd) \u0ba4\u0bae\u0bcd\u0bae\u0bbf\u0b95 \u0baa\u0b9f\u0bcd\u0b9f\u0b9a\u0baa\u0ba8\u0bcd\u0ba4\u0bbf - \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bbe\u0b9f\u0bb2\u0bcd \u0b85\u0bae\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd) (The Hon. (Dr.) Dammika Patabendi - Minister of Environment)"
