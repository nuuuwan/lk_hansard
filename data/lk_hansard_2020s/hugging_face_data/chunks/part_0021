    "chunk_text": "\u0d92 \u0dd9\u0dcf\u0daf\u0dda\u0db8 \u0db8\u0db8 \u0d94\u0dd9\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0daf\u0dda \u0d85\u0dd9\u0db0\u0db1\u0dcf\u0db1\u0dba\u0da7 \u0daf\u0dba\u0dcf\u0db8\u0dd4 \u0dba\u0db1\u0dd9\u0dcf, \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0daf\u0d86 \u0db4 \u0db8\u0dd4 \u0dd9\u0dad\u0dcf\u0dd9\u0da7 \u0daf\u0dda \u0dba\u0daf\u0da7\u0dca \u0dba\u0daf\u0dd2\u0dba, \u0db8\u0dd2\u0dbb\u0dd2\u0daf\u0dd2\u0dba \u0dc4\u0dcf \u0daf\u0daf\u0daf\u0dd2\u0dba \u0db0\u0dd3\u0dd9\u0dba \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dd9\u0dbd \u0daf\u0dba\u0daf\u0daf\u0db1 \u0dbd\u0d9a\u0dca\u0dc2 \u0dc3\u0dcf\u0d9b\u0dba\u0dcf\u0dad \u0db0\u0dd3\u0dd9\u0dba\u0dba\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dc4\u0db1 \u0dc3\u0dbd\u0dc3\u0db1\u0dca\u0db1 \u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0dd9\u0db3\u0dd9. \u0d8d\u0da2\u0dd4\u0dd9 \u0daf\u0dda \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0db1\u0dca\u0dad\u0daf\u0d86 \u0daf\u0dba\u0daf\u0daf\u0db1 \u0db0\u0dd3\u0dd9\u0dba\u0dba\u0db1\u0dca \u0d89\u0db1\u0dca\u0db1\u0dd9\u0dcf, \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba\u0daf\u0dba\u0db1\u0dca \u0dbd\u0d9a\u0dca\u0dc2 \u0daf\u0daf \u0dc4\u0db8\u0dcf\u0dba\u0d9a\u0dca-\u0dad\u0dd4\u0db1\u0d9a\u0dca \u0db4\u0db8\u0dab. \u0d92 \u0dd9\u0dcf\u0daf\u0dda\u0db8 \u0daf\u0dda \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dba \u0dca\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dd9 \u0dba\u0dd0\u0daf\u0db4\u0db1\u0dca\u0db1\u0db1\u0dca \u0d89\u0db1\u0dca\u0db1\u0dd9\u0dcf, \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba\u0daf\u0dba\u0db1\u0dca \u0dbd\u0d9a\u0dca\u0dc2 54 \u0da7 \u0dd9\u0dd0\u0da9\u0dd2\u0dba. \u0d91\u0dad\u0daf \u0dcf\u0da7 \u0d92 \u0dc3\u0db8\u0dc3\u0dae\u0dad \u0da2\u0db1\u0dad\u0dcf\u0dd9\u0daf\u0dda \u0dc3\u0dd4\u0dd9 \u0dda\u0db0\u0dd2\u0dba \u0dad \u0dcf \u0dca\u0dba\u0dda\u0db7 \u0dba \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dd9\u0dd0\u0da7\u0dd4\u0dda \u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7 \u0daf\u0dba\u0ddd\u0da2\u0db1\u0dcf \u200d\u0dbb\u0db8\u0dd9\u0dd2\u0db1\u0dca \u0daf\u0db8\u0daf\u0dad\u0d9a\u0dca \u0dbd\u0dca \u0d92 \u0d85\u0dba\u0da7 \u0dc3\u0dda\u0db4\u0dd6\u0dbb\u0dca\u0dbd\u0dab \u0dca\u0dd9\u0dba\u0dab\u0dba\u0d9a\u0dca \u0dbd\u0dd9\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0daf\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db0\u0dd3\u0dd9\u0dba \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dba \u0db1\u0d9f\u0dcf \u0da7\u0dd4\u0dc0\u0dd3\u0db8\u0da7\u0dad\u0dca, \u0db0\u0dd3\u0dd9\u0dba\u0dba\u0dcf \u0daf\u0db4\u0ddd\u0dc2\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7\u0dad\u0dca, \u0db0\u0dd3\u0dd9\u0dba \u0db4\u0dc0\u0dd4\u0dbd\u0dca\u0dd9\u0dbd\u0da7 \u0dc1\u0d9a\u0dca\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0dbd\u0dd9\u0dcf \u0da2\u0db8\u0da7\u0dad\u0dca \u0d91\u0dba \u0daf\u0db8\u0dcf\u0db1\u0db8 \u0dca \u0dcf\u0dba\u0dba\u0d9a\u0dd2\u0db1\u0dca\u0dd9\u0dad\u0dca \u0dd9\u0dbd\u0daf\u0dcf\u0dd3\u0db8 \u0dc0\u0dd4\u0daf\u0da9\u0dd4\u0d9a \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d92 \u0dba\u0dbd\u0dca\u0dbd \u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dbd\u0dca\u0dbd\u0da7 \u0daf\u0d9c\u0db1 \u0dad\u0db8\u0dd2 \u0daf\u0dda \u0dd9\u0dad\u0dcf\u0daf \u0da2 \u0db0\u0dd3\u0dd9\u0dba, \u0da2\u0dbd\u0da2 \u0dc3\u0dc4 \u0dc3\u0dcf\u0d9c\u0dba \u0dc3\u0dda\u0db4\u0dad\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dcf\u0dc1\u0dba\u0dad\u0dca, \u0dc0\u0dd2\u0daf\u0dc1\u0dae\u0dc2\u0daf\u0dba\u0db1\u0dca\u0db8 NARA \u0d91 \u0dad\u0dca, \u0db0\u0dd3\u0dd9\u0dba \u0dc4\u0dcf \u0da2\u0dbd\u0da2 \u0dc3\u0dda\u0db4\u0dad\u0dca \u0daf\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0dad\u0dca, \u0dd8\u0dd2 \u0dbb\u0dca\u0dbd\u0db8\u0dd2 \u0dc4\u0dcf \u0daf\u0d9c\u0dcf\u0dc0\u0dd2\u0da2\u0db1 \u0dba\u0d9a\u0dca\u0dc2\u0dab \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0dba\u0dad\u0dca \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0daf\u0dd9\u0dbd\u0dcf, \u0d92 \u0dcf\u0dd9\u0dda\u0db0\u0db1 \u0daf\u0dd9\u0dbd\u0dcf, \u0daf\u0dda \u0d89\u0dad\u0dcf\u0db8 \u0dd9\u0da7\u0dd2\u0db1\u0dcf \u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7 \u0dbd\u0dd0\u0daf\u0dd9\u0db1 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dd9\u0dd0\u0da7\u0dd4\u0dda \u200d\u0dbb\u0db8\u0dba \u0daf\u0d9c\u0db1\u0dd0\u0dbd\u0dca\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca.\n\n\u0dc0\u0dd2\u0daf\u0dc1\u0dae\u0dc2\u0daf\u0dba\u0db1\u0dca\u0db8 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dd2 \u0dba\u0dcf\u0daf\u0dda \u0dd9\u0dba\u0dc3 \u0d85\u0dd4\u0dc0\u0dd9 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dd9\u0dd0\u0da7\u0dd4\u0dda \u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7 \u0dd9\u0dd0\u0da9\u0dd2 \u0dd9\u0db1 \u0dca \u0dcf\u0dba\u0dba\u0da7 \u0daf\u0dda \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dd9\u0dd0\u0da7\u0dd4\u0dda \u0daf\u0dba\u0ddd\u0da2\u0db1\u0dcf \u200d\u0dbb\u0db8\u0dba \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0dab\u0dba \u0dba \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf. \u0daf \u0dd9\u0dc1\u0daf\u0dba\u0db1\u0dca \u0d9c\u0dad\u0dca\u0dad\u0dcf\u0db8 \u0daf\u0dcf\u0dba \u0db8\u0dd4\u0daf\u0dbd \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca (0 \u0d89\u0db3\u0dbd\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 24,000 \u0daf\u0d9a\u0dca\u0dd9\u0dcf \u0d95\u0db1\u0dd1\u0db8 \u0daf \u0daf\u0db1\u0d9a\u0dd4\u0da7 \u0dad\u0db8\u0db1\u0dca\u0daf\u0dda \u0daf\u0db4\u0dcf \u0da7\u0dca \u0d91\u0daf\u0d9a\u0dca \u0dad\u0dba\u0db8\u0da7, \u0dad\u0db8\u0db1\u0dca\u0daf\u0dda \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0daf \u0dad\u0dba\u0db8\u0da7 \u0daf\u0dcf\u0dba \u0daf\u0dd9\u0db1\u0dca\u0db1 \u0dd4\u0dc5\u0dd4\u0dd9\u0db1\u0dca. \u0dd9\u0dba\u0dc3 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 58 \u0da7 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 44 \u0d85\u0dad\u0dba \u0da7\u0dd2\u0db1 \u0db0\u0dd3\u0dd9\u0dba\u0dba\u0db1\u0dca \u0daf\u0dda \u0dd9\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0daf\u0dd9 \u0da7 \u0dc3\u0dad\u0dd4 \u0dad\u0dca \u0daf\u0dd9\u0dbd\u0dcf, \u0db1\u0dd2 \u0dd9\u0dba\u0dc3\u0dae \u0dc3\u0dd3\u0db8\u0dcf\u0dd9 \u0dc3\u0dda\u0db4\u0dd6\u0dbb\u0dca\u0dbd\u0dab \u0dc0\u0dd4\u0dab\u0dcf\u0da7 \u0db4\u0dc3\u0dae\u0daf\u0dc3\u0dae \u0d91\u0dc4\u0dd2 \u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7\u0dba \u0dbd\u0dd9\u0dcf\u0daf\u0d9c\u0db1 \u0dc3\u0dcf\u0dbb\u0dca\u0dbd\u0dcf \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dba\u0d9a\u0dca \u0d9c\u0dad \u0dba\u0db1\u0dca\u0db1 \u0dc4\u0dd0\u0d9a\u0dd2 \u0daf\u0dd9\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc0\u0dd2\u0daf\u0dc1\u0dae\u0dc2\u0daf\u0dba\u0db1\u0dca\u0db8 \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0dc1\u0dae\u0dd9\u0dcf\u0dc3 \u0dba\u0db1\u0dd9\u0dcf. \u0daf\u0dda \u0dd9\u0dcf\u0daf\u0dda \u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7 \u0dbd\u0dd0\u0daf\u0dd9\u0db1 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dd9\u0dd0\u0da7\u0dd4\u0dda \u0daf\u0dba\u0ddd\u0da2\u0db1\u0dcf \u200d\u0dbb\u0db8\u0dba\u0d9a\u0dca \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0daf\u0d86 \u0dd9\u0daf\u0dcf\u0dd9\u0dad\u0dca \u0daf\u0d9c\u0db1\u0dd0\u0dbd\u0dca\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0db8 \u0d92\u0dba \u0dba\u0dd2\u0dad\u0dca \u0d85\u0dd9\u0db0\u0db1\u0dcf\u0dba\u0dab\u0dba \u0dba\u0db1\u0dd9\u0dcf."
  },
