    "chunk_text": "\u0baa\u0ba4\u0bbf\u0bb2\u0bcd \u0b89\u0bae\u0bb0\u0b95\u0bb3\u0bcd\u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0bb5\u0bbf\u0bb3\u0b95\u0bcd\u0b95\u0bc8\u0bb3\u0bbf\u0ba4\u0bcd\u0ba4\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd, \u0bae\u0bc1\u0ba9\u0bcd\u0bae\u0ba9\u0baf \u0baa\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0bb3\u0bc1\u0bc8\u0ba9\u0bcd\u0bb1 \u0b85\u0bc8\u0bb0\u0bcd\u0bb5\u0bc1\u0b95\u0bb3\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0bae\u0baa\u0b9a\u0bbf\u0bae\u0ba9\u0bc6\u0bbe\u0bae\u0bcd. \u0b85\u0ba4\u0bc1 \u0b9a\u0bae\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0bc8\u0bc6\u0bbe\u0b95\u0b9a\u0bcd \u0b9a\u0bbf\u0bb2 YouTubers, \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bc6\u0bbe\u0b95 \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0baf\u0bbf\u0ba9\u0bc1\u0bae\u0b9f\u0baf \u0baa\u0ba3\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0b9f\u0bbf\u0bae\u0bc8\u0baf\u0bc6\u0bbe\u0b95\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0b9a\u0bbf\u0bb2 YouTubers \u0b8e\u0ba9\u0bcd \u0bc8\u0bc0\u0ba4\u0bc1\u0bae\u0bcd \u0ba4\u0b95\u0bcc\u0bb0\u0bb5 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0bae\u0bc1\u0bb9\u0bae\u0bcd\u0bc8\u0b9f\u0bcd \u0bae\u0baa\u0b9a\u0bb2\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bc8\u0bc0\u0ba4\u0bc1\u0bae\u0bcd \u0baa\u0bc6\u0bbe\u0bc6\u0bbe\u0bbf\u0baf\u0ba4\u0ba4\u0bc6\u0bbe\u0bb0\u0bc1 \u0b95\u0bc1\u0bb1\u0bcd\u0bb1\u0b9a\u0bcd\u0b9a\u0bc6\u0bbe\u0b9f\u0bcd\u0bae\u0b9f \u0bae\u0bc1\u0ba9\u0bcd\u0bae\u0bb5\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0b85\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bcd\u0bb1\u0b9a\u0bcd\u0b9a\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0b89\u0ba3\u0bcd\u0bae\u0bc8 \u0b87\u0bb2\u0bcd\u0bae\u0bb2 \u0b8e\u0ba9\u0bcd\u0baa\u0bae\u0ba4 \u0ba8\u0bc6\u0bbe\u0ba9\u0bcd \u0b87\u0b99\u0bcd\u0b95\u0bc1 \u0ba4\u0b9a\u0bc6\u0bbe\u0bb2\u0bcd\u0bb2\u0bbf\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3 \u0bae\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd. \u0b85\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd, \u0b89\u0ba3\u0bcd\u0bae\u0bc8\u0baf\u0bbf\u0bae\u0bb2 \u0b8e\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0ba4\u0bb5\u0bbf\u0baf\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0b95 \u0ba8\u0bc6\u0bbe\u0ba9\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0b9a\u0bcd \u0b9a\u0bae\u0baa\u0baf\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0ba4\u0bb5\u0bb3\u0bbf \u0b87\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0ba8\u0ba9\u0bcd\u0bb1\u0bbf \u0ba4\u0b9a\u0bc6\u0bbe\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bae\u0bb1\u0ba9\u0bcd; \u0ba8\u0ba9\u0bcd\u0bb1\u0bbf \u0ba4\u0b9a\u0bc6\u0bbe\u0bb2\u0bcd\u0bb2\u0b95\u0bcd \u0b95\u0b9f\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bae\u0bb1\u0ba9\u0bcd.\n\n\u0da0\u0db8\u0dd2\u0db1\u0dca\u0dad\u0daf\u0dca\u200d\u0dbb\u0dcf\u0dab\u0dd2 \u0dbb\u0dd3\u0dbb\u0dd2\u0d87\u0dbd\u0dca \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dba \u0d9a \u0db1\u0dd4\u0dc0\u0dba \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0d9c\u0dd4\u0db1 \u0dc0\u0dd4\u0dba\u0daf\u0dd2 \u0d9c\u0dad\u0dcf\u0dba\u0dad\u0dd4\u0dbb\u0dd4 \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0d85\u0daf \u0db6\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0dad\u0db1\u0dcf. \u0d85\u0db4\u0dd2 \u0dc3\u0dd2\u0dba\u0dba\u0db4 60\u0d9a\u0db4 \u0dc3\u0dbd\u0dca\u0dd2 \u0da2 \u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf \u0dbb\u0dd3 \u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 50,000, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 25,000 \u0dc3\u0dd2\u0dba\u0dba\u0db4 90\u0d9a\u0dca, 95\u0d9a\u0dca \u0d9c\u0db1\u0dcf\u0d9c\u0dc0\u0dba\u0dd2, \u0db8\u0db8 \u0daf\u0db1\u0dca\u0dad\u0db1\u0dcf \u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0db4 \u0d85\u0daf \u0dc0\u0db1\u0d9c\u0d9a\u0dcf\u0db4 \u0dc3\u0dd2\u0dba\u0dba\u0db4 98\u0d9a\u0db4 \u0dc0\u0dd2\u0dad\u0dba \u0da2 \u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf \u0dbb\u0dd3\u0dba \u0dcf \u0dc0\u0d9c\u0d9a\u0dd3\u0d9c\u0db8\u0db1\u0dca\u0dad \u0dbb\u0dd3\u0dba\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad. \u0d92 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dba \u0d87 \u0d9a\u0dad\u0db4\u0db8 \u0dbb\u0dd3\u0dc3\u0dd2\u0db8 \u0d9c\u0daf\u0dba\u0d9a\u0dca \u0daf\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dd4\u0dad\u0dd4\u0dc0 \u0dad\u0db8\u0dba\u0dd2 \u0d9a\u0dae\u0dcf \u0d9a\u0d9c\u0dc5\u0dda. \u0d91\u0dad\u0dd4\u0db8\u0dd2\u0dba \u0da0\u0dad\u0dd4\u0dba\u0dcf\u0d9c \u0d85\u0d9c\u0db6\u0dca\u0dbd\u0dc3\u0dd2\u0dcf\u0dc4 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dcf\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0d9c\u0dd4\u0db1 \u0d9a \u0dbb\u0dd3 \u0dc0\u0dcf. \u0db4\u0dd4\u0dad\u0dcf \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dcf\u0dba \u0d87\u0db8\u0dad\u0dd2, \u0dad\u0dcf \u0d9a\u0dad\u0dcf \u0d9a\u0dd4\u0db6\u0dd2\u0db1\u0da7\u0dca \u0d87\u0db8\u0dad\u0dd2 \u0dbb\u0dd3\u0dba \u0dcf \u0dbb\u0dd3 \u0dc0\u0dcf. \u0d92\u0d9a\u0dc0 \u0d9a \u0daf\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dd4\u0dad\u0dd2, \u0d9c\u0db8\u0dcf\u0db1\u0dc0 \u0d9a \u0daf\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dd4\u0dad\u0dd2 \u0d9c\u0d9a\u0d9c\u0db1\u0d9a\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d91\u0dad\u0dd4\u0db8\u0dd2\u0dba. \u0d91\u0dad\u0dd4\u0db8\u0dd2\u0dba \u0da2\u0dcf\u0db1\u0dad\u0dcf \u0da1\u0db1\u0dca\u0dad\u0daf\u0d9c\u0dba\u0db1\u0dca\u0dad \u0db4 \u0d9a \u0dc0\u0dd4\u0da7\u0dcf \u0dbb\u0dd3 \u0dc0\u0dcf. \u0d87 \u0d9a\u0dad\u0db4\u0db8, \u0da2\u0dcf\u0db1\u0dad\u0dcf \u0da1\u0db1\u0dca\u0dad\u0daf\u0d9c\u0dba\u0db1\u0dca\u0dad \u0dad\u0db8\u0dba\u0dd2 \u0d91\u0dad\u0dd4\u0db8\u0dd2\u0dba \u0db4 \u0d9a \u0dc0\u0dd4\u0d9c\u0da9\u0dd4\u0d9a. \u0d91\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0d9c\u0dda \u0db8\u0db1\u0dcf\u0db4 \u0d9a\u0dd3\u0dba\u0daf \u0dbb\u0dd3\u0dba \u0dcf \u0d91\u0dc5\u0dd2\u0dba\u0db4 \u0dbb\u0dd3\u0dba\u0dcf\u0d9c\u0db1\u0dca\u0dad\u0db1 \u0db6\u0dd4\u0dc4\u0dd4. \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1 \u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0db4 \u0d9c\u0db8\u0dad\u0dd4\u0db1 \u0dad\u0db1\u0dca\u0dad\u0db1 \u0d85\u0d9c ( 159\u0d9c\u0daf\u0db1\u0dcf\u0db8 \u0d91\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db4 \u0dc0\u0da9\u0dcf \u0daf\u0dc4\u0dc3\u0dda \u0d9c\u0da7\u0db1\u0dca\u0dad \u0da1\u0db1\u0dca\u0dad\u0daf \u0d85\u0dba\u0d9c\u0d9c\u0db1 \u0dad\u0db8\u0dba\u0dd2 \u0db8\u0dc4\u0da2\u0dcf\u0db1 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dd2\u0dad\u0dba\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dc1\u0d9c\u0dba\u0db1\u0dca\u0dad \u0db4 \u0d9a \u0d9c\u0dc0 \u0dcf \u0dad\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad. \u0d92 \u0d85\u0dba \u0da1\u0db1\u0dca\u0dad\u0daf \u0d9c \u0d9a\u0d9c \u0d9a \u0d9c\u0d9a\u0dcf\u0d9c\u0dc4\u0dcf\u0db8\u0daf \u0dbb\u0dd3\u0dba \u0dcf \u0d85\u0db4\u0db4 \u0dc0\u0d9c\u0d9a\u0dd3\u0d9c\u0db8\u0db1\u0dca\u0dad \u0dbb\u0dd3\u0dba\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad."
  },
