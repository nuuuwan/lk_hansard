    "chunk_text": "\u0d9c\u0db8\u0dcf\u0d9a\u0daf, \u0db8\u0db8 \u0da7\u0d9c\u0dda \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dba \u0daf\u0dd2\u0dc3\u0dcf\u0db4\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dcf \u0d9c\u0dba\u0db1\u0dca\u0dad \u0db8\u0dd3\u0db1\u0dca\u0db4 \u0d85\u0daf\u0dcf\u0dc5 \u0daf \u0d9a\u0dad \u0db6\u0dcf \u0d9c \u0d9a\u0dad\u0dcf. \u0d85\u0daf \u0dc0\u0db1\u0d9c\u0d9a\u0dcf\u0db4 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 25,000\u0d9a \u0db8\u0dd4\u0daf \u0db6\u0dcf \u0da2 \u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dba \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0d9c\u0dba\u0db1\u0dca\u0dad \u0dc3\u0dd2\u0dba\u0dba\u0db4 65\u0d9a\u0db4\u0dba\u0dd2. \"\u0daf\u0dd2\u0da7\u0dca\u0dc0\u0dcf\" \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0da7\u0dcf\u0db4\u0dca\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0db6 \u0db4\u0dd1\u0db8\u0db4 \u0d9a\u0dca \u0dc0\u0dd4\u0da7\u0dcf, \u0db4\u0dc0\u0dd4\u0dbd\u0dca 38,889\u0d9a\u0dca. \u0db4\u0dc0\u0dd4\u0dbd\u0dca 20,000\u0d9a\u0db4 \u0d85\u0daf \u0d9c\u0dc0\u0db1\u0d9a\u0dbd\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 25,000 \u0db6\u0dcf \u0da2 \u0dcf \u0db1\u0dd4\u0dc4\u0dd4. \u0da7\u0db4 \u0d85\u0daf\u0dcf\u0dc5 \u0d9c\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1\u0dba \u0db8\u0db8 \u0dc3\u0db7\u0dcf\u0d9c\u0dad \u0d9a\u0dba\u0db1\u0dca\u0dad\u0db1\u0dda, \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dcf\u0dba \u0d9a\u0dcf\u0dba\u0d9a \u0dc3\u0db7\u0dcf \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0d8b\u0da9\u0daf\u0dd4\u0dda\u0db6\u0dba \u200d\u0dbb\u0d9c\u0dda\u0dc1\u0dba \u0d9c \u0d9a\u0d9c\u0dad\u0dcf \u0d9a - \u0db8\u0db4 \u0d9a\u0dd2\u0db1\u0dca\u0dad \u0d9a\u0dae\u0dcf \u0d9a\u0dc5 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dba\u0dba\u0dcf \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dcf\u0db1\u0dba \u0d9a\u0dba\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0d9a \u0d8b\u0da9\u0daf\u0dd4\u0dda\u0db6\u0dba \u200d\u0dbb\u0d9c\u0dda\u0dc1\u0dba - \u0dca\u0db4\u0daf\u0dcf\u0dc0\u0db4 \u0d9a\u0dca \u0dc0\u0dd4\u0dab\u0dd4 (,315\u0db1\u0dca\u0dad 1,6(5\u0d9a\u0db4\u0dba\u0dd2 \u0db8\u0dd6\u0dd2\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 25,000\u0d9a -\u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0dbb\u0dd3\u0db8\u0dda\u0d9c\u0dda \u0da2\u0db8\u0db1\u0dcf\u0dc0- \u0db8\u0dd4\u0daf \u0db6\u0dcf \u0da2 \u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad.\n\n\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dcf\u0dba \u0d9a\u0dcf\u0dba\u0d9a \u0dc3\u0db7\u0dcf \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2, \u0daf\u0dd2\u0dc3\u0dcf\u0db4\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dcf \u0d9c\u0dba\u0db1\u0dca\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dba\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0d9c\u0daf\u0dc3\u0dd4\u0dda\u0db6\u0dbb\u0dca\u0dbd 31\u0dc0\u0dd4\u0db1\u0dd2 \u0daf\u0dcf\u0db4 \u0db4\u0dc3\u0dda\u0d9c\u0dc3\u0dda \u0dbb\u0dd3\u0dc3\u0dd2\u0db8 \u0db8\u0dd4\u0daf \u0d9a\u0dca \u0dd4\u0db6\u0dd3 \u0db1\u0dd4\u0dc4\u0dd4 \u0dbb\u0dd3\u0dba \u0dcf. \u0d85\u0db4\u0dd2 \u0daf\u0dd4\u0d9a\u0dca\u0d9a\u0dcf, \u0d85\u0dba \u0dc0\u0dd4\u0dba \u0dc0\u0dd2\u0dc0\u0dcf\u0daf\u0dba \u0d9a\u0dcf \u0d9c\u0dda \u0da2 \u0dbb\u0dd3 \u0dc0\u0dcf, \u0db7\u0dcf\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0d9c\u0dcf\u0dba\u0dba \u0db4\u0dd2\u0db8\u0dda \u0dad\u0dad\u0dd2\u0db8\u0dda \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf\u0dba \u0dbb\u0dd3\u0dba \u0dcf. \u0db1\u0db8\u0dd4 \u0d9a \u0d85\u0db4\u0db4 \u0dd4\u0db6\u0dd4\u0dab\u0dd4 \u0d9c\u0dad\u0dcf\u0dba\u0dad\u0dd4\u0dbb\u0dd4 \u0d85\u0db1\u0dd4\u0dc0 \u0d9c\u0daf\u0dc3\u0dd4\u0dda\u0db6\u0dbb\u0dca\u0dbd 31\u0dc0\u0dd4\u0db1\u0dd2 \u0daf\u0dcf\u0db4 \u0db4\u0dc3\u0dda\u0d9c\u0dc3\u0dda \u0dbb\u0dd3\u0dc3\u0dd2\u0daf\u0dd4 \u0d9c\u0d9c\u0dd3\u0db8\u0db8\u0d9a\u0dca \u0d9a\u0dba \u0dcf \u0db1\u0dd4\u0dc4\u0dd4. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf\u0dba\u0dd2 \u0db8\u0db8 \u0da7\u0db4 \u0d85\u0daf\u0dcf\u0dc5 \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0dc0 \u0dc3\u0db7\u0dcf\u0d9c\u0dad \u0d9a\u0d9c\u0dc5\u0dda."
