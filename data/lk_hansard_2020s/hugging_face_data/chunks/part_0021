\u0dd9 \u0dd9\u0dcf\u0dc0\u0dad\u0dca\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0d9a\u0dbb \u0d87 . \uf0b7 \u0db1\u0dcf\u0dd9 \u0dd9\u0dd1\u0db8\u0dca \u0d85\u0db0\u0dd2 \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0dca \u0d9a\u0dbd\u0dcf\u0db4\u0dc0\u0dbd \u0db4\u0daf\u0dd2\u0dd2\u0da0\u0dd2 \u0db4\u0dc0\u0dd4\u0dbd\u0dca 5025\u0dc2\u0dcf\n\n\u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dc0 \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0dc3\u0db8\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dca\u0dad\u0dd2\u0dd9\u0dc2\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dd9\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8. \uf0b7 \u0d86\u0db4\u0daf\u0dcf \u0db4\u0dca\u200d\u0dbb \u0dba\u0dd9 \u0dc3\u0dca\u0dad\u0dad\u0dd2\u0d9a \u0dd4\u0dc0\u0dbb\u0dc2\u0dcf\u0dc2\u0dd2 \u0db4\u0dbb\u0dd2\u0dc3\u0dbb\u0dd9\u0dc2\u0dcf \u0d8b\u0dc3\u0daf\u0dc3\u0dcf\n\n\u0dc3\u0db1\u0dcf\u0da9\u0db1\u0dd0\u0d9f\u0dd2\u0dd2 \u0dc3\u0dc2\u0dcf \u0dc3\u0dd2\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dd9\u0dc2\u0dcf - Building Codes - \u0dc3\u0dd0\u0d9a\u0dc3\u0dd3\u0dc3\u0db8\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dbb \u0d87 . \uf0b7 \u0db1\u0dcf\u0dd9 \u0dd9\u0dd1\u0db8\u0dca \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0dca \u0d9a\u0dbd\u0dcf\u0db4\u0dc0\u0dbd \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0da2\u0dcf\u0dad\u0dd2\u0d9a\n\n\u0dc3\u0db1\u0dcf\u0da9\u0db1\u0dd0\u0d9f\u0dd2\u0dd2 \u0db4\u0dbb\u0dca\u0dbd\u0dc3 \u0dc2\u0dab \u0dc3\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dc3 \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0dc3\u0dc1 \u0dbd\u0db6\u0dcf \u0db1\u0dd0\u0db1\u0dd3\u0db8 \u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dd9 \u0d9a\u0dbb \u0d87 . \uf0b7 \u0db1\u0dcf\u0dd9 \u0dd9\u0dd1\u0db8\u0dca \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0dca \u0d9a\u0dbd\u0dcf\u0db4 \u0dc3\u0dd2\u0dad\u0dd2\u0dd9\u0db8\u0dca\u0db1 \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0db8\u0dc4\u0da2\u0db1\n\n\u0daf\u0dd0 \u0dbd\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0d