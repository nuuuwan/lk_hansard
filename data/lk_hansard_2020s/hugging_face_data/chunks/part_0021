    "chunk_text": "\uf0b7 2024 \u0dc0\u0dbb\u0dca\u0dbd\u0dc2\u0dca\u0da8\u0d9c\u0dda \u0da2 \u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dcf\u0dc0 \u0d9c\u0d9a\u0dcf\u0da7\u0dca\u0db0\u0dcf\u0dc3\u0d9c\u0dda \u0d9c\u0db4\u0dcf\u0dd2\u0dc3\u0dda \u0dc3\u0dda\u0dae\u0dcf\u0db1 \u0d9c\u0dc0\u0dad \u0d9c\u0dc0 \u0d9c\u0dc3\u0dcf\u0dba\u0d9a\u0dda 39\u0d9a\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf \u0dd3\u0db8 \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dba, \u0d91\u0db8 \u0d85\u0db4\u0dba\u0dcf\u0db0 \u0d85\u0dad\u0dd4\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0d85\u0db4\u0dba\u0dcf\u0db0 31\u0d9a\u0dca \u0dc0\u0dd2\u0dc3\u0db3\u0dcf, \u0dad\u0db1\u0dca\u0dad \u0d85\u0db4\u0dba\u0dcf\u0db0 30\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dca \u0db4\u0dd4\u0dc0\u0db8\u0dda\u0db8\u0db4 \u0d9a\u0db4\u0dd4\u0dad\u0dad\u0dd4 \u0d9a\u0dba \u0d87\u0dad.\n\n\uf0b7 2025 \u0dc0\u0dbb\u0dca\u0dbd\u0dc2\u0dca\u0da8\u0d9c\u0dda \u0da2 \u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dcf\u0dc0 \u0d9c\u0d9a\u0dcf\u0da7\u0dca\u0db0\u0dcf\u0dc3\u0d9c\u0dda \u0d9c\u0db4\u0dcf\u0dd2\u0dc3\u0dda \u0dc3\u0dda\u0dae\u0dcf\u0db1 \u0d9c\u0dc0\u0dad \u0d9c\u0dc0 \u0d9c\u0dc3\u0dcf\u0dba\u0d9a\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc0 \u0db4\u0dd4\u0db8\u0dd2\u0dab\u0dd2\u0dd2 30\u0d9a\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf \u0dd3\u0db8 \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dba, \u0d91\u0dba\u0dd2\u0db1\u0dca\u0dad 19\u0d9a\u0dca \u0dc0\u0dd2\u0dc3\u0db3\u0dcf, \u0d85\u0db4\u0dba\u0dcf\u0db0 12\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dca \u0db4\u0dd4\u0dc0\u0db8\u0dda\u0db8\u0db4 \u0d9a\u0db4\u0dd4\u0dad\u0dad\u0dd4 \u0d9a\u0dba \u0d87\u0dad.\n\n\uf0b7 2025 \u0dc0\u0dbb\u0dca\u0dbd\u0dc2\u0dca\u0da8\u0d9c\u0dda \u0da2 \u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dcf\u0dc0 \u0d9c\u0d9a\u0dcf\u0da7\u0dca\u0db0\u0dcf\u0dc3\u0d9c\u0dda \u0d9c\u0db4\u0dcf\u0dd2\u0dc3\u0dda \u0dc3\u0dda\u0dae\u0dcf\u0db1 \u0d9c\u0dc0\u0dad \u0d9c\u0dc0\u0db1 \u0d9a \u0dc3 \u0d9a \u0d9a\u0dc0 \u0d9c\u0dc3\u0dcf\u0dba\u0d9a\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc0 \u0db4\u0dd4\u0db8\u0dd2\u0dab\u0dd2\u0dd2 12\u0d9a\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf \u0dd3\u0db8 \u0d87\u0dad. \u0d91\u0dba\u0dd2\u0db1\u0dca\u0dad \u0db4\u0dd4\u0db8\u0dd2\u0dab\u0dd2\u0dd2 9\u0d9a\u0dca \u0dc0\u0dd2\u0dc3\u0db3\u0dcf \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0d85\u0db4\u0dba\u0dcf\u0db0 \u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dca \u0db4\u0dd4\u0dc0\u0db8\u0dda\u0dda \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dba \u0d87\u0dad.\n\n(v) \u0db1\u0dd4\u0dad.\n\n\uf0b7 \u0d9c\u0db4\u0dcf\u0dd2\u0dc3\u0dda \u0dc3\u0dda\u0dae\u0dcf\u0db1 \u0d9c\u0dc0\u0dad \u0d9c\u0dc0 \u0d9c\u0dc3\u0dcf\u0dba\u0d9a\u0dda \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0dc3 \u0d9a \u0d9a\u0dc0 \u0d9c\u0dc3\u0dcf\u0dba\u0d9a\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc0 \u0db4\u0dd4\u0db8\u0dd2\u0dab\u0dd2\u0dd2 \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf \u0dc0\u0dd6 \u0dc0\u0dc4\u0dcf\u0db8 \u0db4\u0dd4\u0db8\u0dd2\u0dab\u0dd2\u0dd2 \u0dc3\u0db4\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dba \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dbd\u0dc1\u0db1\u0dba\u0db1\u0dca\u0dad \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dba \u0dc3\u0dd4\u0d9a\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dc4\u0dcf \u0db1\u0dca \u0db7\u0dcf\u0da9\u0dd4\u0d9a\u0da9 \u0d85 \u0d9a\u0d85\u0da9\u0dcf\u0d9c\u0dd4\u0dc0\u0db4 \u0d9c\u0dd4\u0db1\u0dd3\u0db8\u0db4 \u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dcf\u0dc0 \u0d9c\u0d9a\u0dcf\u0da7\u0dca\u0db0\u0dcf\u0dc3\u0d9c\u0dda \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0d9c\u0db4\u0dcf\u0dd2\u0dc3\u0dda \u0dc3\u0dda\u0dae\u0dcf\u0db1\u0dba\u0db1\u0dca\u0dad\u0dc4\u0dd2 \u0db8\u0dd6 \u0dc3\u0dda\u0dae\u0dcf\u0db1 \u0d9c\u0db4\u0dcf\u0dd2\u0dc3\u0dda \u0db4\u0db8\u0dda\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad \u0dc3\u0dc4 \u0dc3\u0dda\u0dae\u0dcf\u0db1\u0dcf\u0d9a\u0dbb\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0d9a\u0dba \u0d87\u0dad.\n\n\uf0b7 \u0d9c\u0d9a\u0dcf\u0da7\u0dca\u0db0\u0dcf\u0dc3\u0d9c\u0dda \u0d9c\u0dc0 \u0d9c\u0dc3\u0dcf\u0dba\u0d9a\u0dda \u0dc4\u0dcf \u0d9c\u0dc0\u0db1 \u0d9a \u0dc3 \u0d9a \u0d9a\u0dc0 \u0d9c\u0dc3\u0dcf\u0dba\u0d9a\u0dda \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf \u0dd3\u0db8\u0dda \u0d9c\u0db6\u0dcf\u0d9c\u0dc4\u0dcf\u0db8\u0dba\u0d9a\u0dca \u0dba\u0dcf\u0dd3 \u0d9a\u0dcf \u0d9c\u0dda \u0da2 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0db1 \u0db6\u0dd4\u0dc0\u0dd2\u0db1\u0dca\u0dad, \u0d91\u0db8 \u0d85\u0db4\u0dba\u0dcf\u0db0 \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf \u0dc0\u0db1 \u200d\u0dbb\u0d9c\u0dda\u0dc1 \u0dc4\u0dcf \u0d9c\u0dc4\u0ddd\u0dba\u0dcf\u0dc0\u0db1\u0dca\u0dad \u0dc4\u0db3\u0dd4\u0db1\u0dcf\u0d9c\u0d9c\u0db1 \u0d91\u0db8 \u0d85\u0db4\u0dba\u0dcf\u0db0 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0db1 \u0d9c \u0dcf\u0dc0\u0db1\u0dca\u0dad\u0dc0 \u0da2 \u0d91\u0d9a\u0dd3 \u200d\u0dbb\u0d9c\u0dda\u0dc1 \u0dca\u0dc0\u0dba\u0da7\u0dba \u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0dc4\u0dcf \u200d\u0dbb\u0db0\u0dcf\u0db1 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0dca\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dc0 \u0dba\u0dcf\u0dd3 \u0d9a\u0dcf \u0d9c\u0dda \u0da2\u0dcf\u0dcf\u0d9c\u0db8 \u0dc3\u0dcf\u0da0\u0dcf\u0dba, \u0dba\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dd4\u0daf\u0dd2 \u0dc3\u0dcf\u0da0\u0dcf\u0dba \u0dc4\u0dcf \u0d85\u0d9c\u0db1\u0d9a\u0dd4 \u0d9a \u0dc3\u0dcf\u0da0\u0dcf\u0dba\u0dba\u0db1\u0dca\u0dad \u0d9c\u0dba\u0daf\u0dd3\u0db8\u0db8\u0db4 \u0d85\u0dc0\u0dc1\u0dba \u0d8b\u0db4\u0d9c\u0daf\u0dc3\u0dda \u0dc4\u0dcf \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0d9c \u0db8\u0dd6 \u0dc3\u0dda\u0dae\u0dcf\u0db1 \u0d9c\u0db4\u0dcf\u0dd2\u0dc3\u0dda \u0db4\u0db8\u0dda\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad \u0dc3\u0dc4 \u0dc3\u0dda\u0dae\u0dcf\u0db1\u0dcf\u0d9a\u0dbb\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad \u0d9c\u0dc0\u0dad \u0db6\u0dcf \u0da2\u0db8\u0db4 \u0d9a\u0db4\u0dd4\u0dad\u0dad\u0dd4 \u0d9a\u0dba \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dba, \u0d91\u0db8 \u0dc3\u0dcf\u0da0\u0dcf\u0dba\u0dba\u0db1\u0dca\u0dad \u0db1\u0dd2\u0dc3\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0daf \u0dba\u0db1\u0dca\u0dad\u0db1 \u0d85\u0db0\u0dd3\u0db1\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0da7\u0dba \u0dbb\u0dd3\u0db8\u0dda\u0db8\u0db4 \u0d85\u0db0\u0dd3\u0db1\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0da7 \u0db1\u0dd2 \u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0d9c\u0dc0\u0dad \u0d8b\u0db4\u0d9c\u0daf\u0dc3\u0dda \u0db6\u0dcf \u0da2 \u0d87\u0dad.\n\n1009 1010\n\n[\u0d9c\u0dbb\u0dd4 \u0d9c\u0dba\u0db1\u0dca\u0dad\u0dad \u0d9a\u0dbb\u0dd4\u0da7\u0dcf\u0dad\u0dd2 \u0d9a \u0db8\u0dc4\u0dad\u0dcf]\n\n2026 \u0da2\u0dcf\u0db1\u0dc0\u0dcf\u0dbb\u0dd2 21\n\n\uf0b7 \u0d9c\u0db4\u0dcf\u0dd2\u0dc3\u0dda \u0dc3\u0dda\u0dae\u0dcf\u0db1 \u0d9c\u0dc0\u0dad \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf \u0dd3\u0db8 \u0d87\u0dad\u0dd2 \u0d85\u0db4\u0dba\u0dcf\u0db0 \u0d85\u0dad\u0dd4\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0d85\u0db4\u0dba\u0dcf\u0db0 \u0d9c\u0db6\u0dcf\u0d9c\u0dc4\u0dcf\u0db8\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0dc3\u0db3\u0dcf \u0db1\u0dca \u0db4\u0dd4\u0dc0\u0db8\u0dda\u0dda \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dba \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dba, \u0d9c\u0db8\u0d9c\u0dad\u0d9a\u0dca \u0dc0\u0dd2\u0dc3\u0db3\u0dcf \u0d9c\u0db1\u0dcf\u0db8\u0dd4\u0dad\u0dd2 \u0d85\u0db4\u0dba\u0dcf\u0db0 \u0d9a\u0da9\u0dd2\u0db1\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dc3\u0db3\u0dd3\u0db8\u0db4 \u0d9a, \u0d9c\u0dda \u0dc0\u0db1\u0dc0\u0dd2\u0db4 \u0dc0\u0dd2\u0dc3\u0db3\u0dcf \u0d87\u0dad\u0dd2 \u0d85\u0db4\u0dba\u0dcf\u0db0 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc0 \u0d9c\u0db1\u0dcf\u0db4\u0db8\u0dcf\u0dc0 \u0db1\u0dca \u0db4\u0dd4\u0dc0\u0db8\u0dda\u0db8\u0db4 \u0d9a\u0db4\u0dd4\u0dad\u0dad\u0dd4 \u0d9a\u0dba\u0db1 \u0d9c \u0dc3\u0db4 \u0db8\u0dd6 \u0dc3\u0dda\u0dae\u0dcf\u0db1 \u0d9c\u0db4\u0dcf\u0dd2\u0dc3\u0dda \u0db4\u0db8\u0dda\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad \u0dc3\u0dc4 \u0dc3\u0dda\u0dae\u0dcf\u0db1\u0dcf\u0d9a\u0dbb\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad \u0d9c\u0dc0\u0dad \u0d85\u0dc0\u0dc1\u0dba \u0d8b\u0db4\u0d9c\u0daf\u0dc3\u0dda \u0dc4\u0dcf \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0d9c \u0db6\u0dcf \u0da2 \u0d87\u0dad."
