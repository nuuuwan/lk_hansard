    "chunk_text": "\u0dad\u0dd4\u0db1\u0dca\u0dad\u0dc0\u0dd0\u0db1\u0dd2 \u0d91\u0d9a \u0dc0\u0db8\u0dba\u0dd2, \u0db4\u0dd4\u0dab \u0dab\u0dd4 \u200d\u0dbb\u0db8\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0dad \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4 \u0dc4 \u0db3 \u200d\u0dbb\u0db8 \u0db6\u0dbd\u0d9a \u0dba\u0d9a\u0dca\u0d9a\u0dba \u0db8\u0db1\u0dca\u0dad\u0dcf \u0d91\u0d9a. \u0d85 \u0dda \u0dbb \u0da7\u0dca \u0dc4 \u0db3 \u0db8 \u0dcf\u0dc0 \u0dc3\u0dca\u0dad\u0dca\u200d \u0da2\u0db4\u0dc0\u0d9a\u0dca\u0d9a\u0dba \u0dd2 \u0db6\u0dcf\u0dc0 . \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0db4\u0dd4\u0dab \u0dab\u0dd4 \u200d\u0dbb\u0db8\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0dad \u0d85\u0dc0\u0dc1\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8 \u0daf\u0dba\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dcf \u0da2 \u0dbb\u0dad\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0d85\u0dc0\u0dc1\u0dba \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0d9c\u0dcf \u0dba\u0dcf\u0dc0 . \u0d91\u0dc0 \u0d9a \u0da7 \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dcf \u0da2 \u0db1\u0dd2\u0dbb\u0dca\u0daf \u0dba\u0d9a \u0dad\u0dd4\u0dcf\u0dad\u0dca \u0d85\u0dbb \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf\u0dc0\u0dbd\u0da7 \u0d85\u0db8\u0dc0\u0dbb\u0dc0 \u0d86 \u0dba\u0ddd\u0dad\u0dcf \u0d9a \u0dbb\u0dc4\u0dd2 \u0db6\u0dbd\u0db4 \u0dcf\u0dc0 .\n\n\u0d8a\u0da7 \u0d85\u0db8\u0dc0\u0dbb\u0dc0 \u0da2\u0d9a \u0dba\u0da7 \u0dad\u0dca \u0dc0\u0dc0\u0dad\u0dca \u0d91\u0d9a\u0d9a\u0dca\u0d9a\u0dba \u0d91\u0dcf\u0dc0 , APIT \u0d9a\u0dd2\u0dba\u0dbd . \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad, Advanced Personal Income Tax \u0d9a\u0dd2\u0dba\u0dcf \u0d91\u0d9a. \u0dd0\u0dcf\u0da7 \u0dca\u0dba \u0db4\u0daf\u0dd2\u0d82\u0dd2 \u0dc0\u0dbd \u0db8\u0db1\u0dca\u0dad\u0dcf \u0d86 \u0dba\u0ddd\u0dad\u0d9a \u0dba\u0d9a\u0dca\u0d9a\u0dba \u0db8\u0db1\u0dca\u0dad\u0dcf\u0dc0 \u0dcf \u0da2 \u0d92 \u0d86 \u0dba\u0ddd\u0dad\u0d9a\u0dba \u0da7 \u0da2 \u0db4\u0dcf\u0dc0 \u0dc3\u0dca\u0dad\u0dca\u200d \u0da2\u0db8\u0dc0 \u0dc0\u0dbd \u0db8 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dba\u0d9a \u0dc3\u0dd2\u0da7 \u0db4\u0da7\u0db1\u0dca\u0dad \u0d9c\u0dcf \u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb 3\u0d9a \u0d9a \u0dbd\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dba\u0dcf\u0d9a \u0da2 \u0d92 APIT \u0d91\u0d9a \u0d9c\u0dd3\u0db8 \u0db1\u0dd2 \u0dc4\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0dcf\u0dc0 . \u0dcf\u0dc3\u0dca\u0dad\u0dca \u0d85\u0dbd\u0dd4 \u0dc0\u0db1\u0dca\u0dad \u0d86 \u0dba\u0ddd\u0dad\u0d9a \u0dba\u0d9a\u0dca\u0d9a\u0dba \u0d91\u0dcf\u0dc0 \u0dcf \u0da2 \u0d92 \u0d86 \u0dba\u0ddd\u0dad\u0d9a\u0dba \u0dba\u0da7 \u0dad\u0dca \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dba \u0d9a\u0dbb\u0dcf \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0d9a\u0dba\u0db1\u0dca\u0dad APIT \u0d91\u0d9a\u0da7 \u0dba\u0da7\u0dad\u0dca \u0dc0\u0dcf\u0dc0 .\n\n\u0d8a\u0da7 \u0d85\u0db8\u0dc0\u0dbb\u0dc0 \u0da2 \u0d9a\u0db1\u0dca\u0dad \u0dc0\u0dc0\u0dad\u0dca \u0dc0\u0dd2 \u0dc1\u0dbb\u0dc2 \u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dc4\u0db3\u0dd4\u0dcf \u0d9c\u0dcf \u0dd2 \u0db6\u0dcf\u0dc0 . \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \u0dc0 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4 \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0daf\u0dba \u0dc1\u0d9a\u0dca\u0d9a\u0dba\u0dd2\u0db8\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dcf \u0d85\u0dc0\u0dc1\u0dba \u0db4\u0dd2\u0dba\u0dc0\u0dbb \u0d85\u0dbb\u0db1\u0dca\u0dad \u0dd2 \u0db6\u0dcf\u0dc0 . \u0da2 \u0dba\u0da7 \u0dad\u0dca\u0daf\u0dd2 \u0d91\u0dcf \u0d86 \u0dba\u0ddd\u0dad\u0d9a \u0dba\u0d9a\u0dca\u0d9a\u0dba \u0d92 \u0d86 \u0dba\u0ddd\u0dad\u0dcf\u0dba \u0db4\u0da7\u0db1\u0dca\u0dad \u0d9c\u0dad\u0dca\u0dc0 \u0d85\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae \u0dda \u0db8\u0db3\u0db1\u0dca\u0dad\u0db8 \u0dc0\u0db8\u0db1\u0dca\u0dad \u0d86 \u0dba \u0da2 \u0dc0 \u0dbb\u0dca\u0dc0 \u0dda\u0dba\u0dba \u0d86 \u0dba \u0da2 \u0db4 \u0dbb\u0dca\u0dc0 \u0da2\u0db1\u0dca\u0dad\u0dad\u0dd4\u0dc0 \u0dc0\u0dc0 \u0dcf \u0d91\u0d9a \u0d85\u0db1\u0dd2\u0dc0 \u0dbb\u0dca\u0dba \u0d9a\u0dbb\u0dbd \u0dd2 \u0db6\u0dcf\u0dc0 . \u0d85\u0db1\u0dca\u0dad\u0dcf \u0d92 \u0dc0 \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \u0dc0 \u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0dcf\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dcf \u0d85\u0dc0\u0dc1\u0dba \u0db1\u0dd3\u0dd2\u0db8\u0dba \u0dc3\u0dca\u0dad\u0dca\u200d\u0d82 \u0dc1\u0ddd\u0db0\u0dca\u200d\u0dcf \u0da2 \u0db4\u0dcf\u0dad\u0dca \u0d9a\u0da7\u0dd4 \u0da2\u0db4 \u0dad\u0dca \u0db8\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0dd2 \u0db6\u0dcf\u0dc0 .\n\n\u0d8a\u0da7\u0dad\u0dca \u0d85\u0db8\u0dc0\u0dbb\u0dc0 \u0dd2 \u0db6\u0dcf \u0dc0\u0dc0\u0dad\u0dca \u0dc0\u0dd2 \u0dc1\u0dbb\u0dc2 \u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dc0\u0db8\u0dba\u0dd2, \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf\u0dc0\u0dbd\u0da7 \u0dcf \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \u0dc0 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0d9a\u0dba\u0dc2 \u0dc0\u0da7 \u0dbd\u0d9a\u0dca\u0d9a\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dcf, \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \u0dc0 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4 \u0dc0\u0dd2\u0db1\u0dd2\u0dc0\u0dd2 \u0db7 \u0dc0\u0dba \u0dc0\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dcf \u0d85\u0dc0\u0dc1\u0dba \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dca\u200d \u0dcf\n\n\u0da2\u0d9a\u0da7 \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dbb \u0dd2\u0db6\u0dd3\u0db8. \u0d91\u0dc0 \u0d9a \u0da7 \u0dc3\u0dca \u0dca \u0d85\u0db8 \u0dc0\u0dba \u0d82\u0dc1\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0d9a \u0dbb\u0dca\u0dad\u0dd4\u0db8\u0dba \u0db4 \u0dcf\u0db8\u0dd2\u0db1\u0dca\u0dad \u0d87\u0d9c\u0dd0\u0dba \u0db8\u0d9a\u0dca\u0d9a\u0dba \u0dc3\u0dd2\u0d9a\u0dbb \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0\u0da7 \u0d85\u0dc0\u0dc1\u0dba \u0db1\u0dd3\u0dd2\u0db8\u0dba \u0dc3\u0dca\u0dad\u0dca\u200d\u0d82 \u0dc1\u0ddd\u0db0\u0dca\u200d\u0dcf \u0da2 \u0d9a\u0dca\u0d9a\u0dba \u0db8\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dc0\u0dcf\u0dc0 . \u0d8a\u0da7 \u0d85\u0db8\u0dc0\u0dbb\u0dc0 \u0db1\u0dd2\u0dba \u0db8\u0dcf \u0db4\u0dd2\u0dba\u0dc0\u0dbb \u0d85\u0dbb\u0db1\u0dca\u0dad \u0dd2 \u0db6\u0dcf\u0dc0 . \u0db8 \u0dc0\u0d9a\u0dca\u0d9a\u0dba \u0db4\u0dd0\u0dc0\u0dd2 \u0db4\u0dcf \u0dad\u0dca \u0dd2\u0db6\u0dd4\u0daf , \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4\u0dc4\u0dbb\u0dd2 \u0d9a \u0dcf\u0d9a\u0dca\u0d9a\u0dba \u0d87\u0dc0\u0dd2\u0dca \u0dbd \u0da2\u0d9a\u0da7 \u0dca\u0dba \u0db4\u0daf\u0dd2\u0d82\u0dd2 \u0dc0\u0dd4 \u0daf \u0dad\u0dca, \u0d92 \u0dca\u0dba \u0db4\u0daf\u0dd2\u0d82\u0dd2 \u0dc0\u0dcf \u0d9a\u0dcf \u0d85\u0dba\u0d9a\u0dbb \u0da2\u0db4\u0dc0 \u0db8\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0dcf \u0d85\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae \u0dda\u0daf\u0dd3\u0db8 \u0dd6\u0dbd\u0dca\u0d9a \u0dc0\u0dc1 \u0dba\u0db1\u0dca\u0dad \u0db8\u0da9 \u0da2 \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0daf \u0d9c \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dd4 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4 \u0d92 \u0dc4 \u0dc3\u0dca\u0dad\u0dca\u200d \u0da2\u0db6\u0db1\u0dca\u0dad\u0db0\u0dca\u200d \u0dc0\u0dcf\u0dad\u0dca \u0d85\u0dba\u0d9a\u0dd2\u0dbb\u0dd3 \u0da2 \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0dcf \u0d95\u0dcf\u0dd9 \u0d9a\u0dd2\u0dba\u0dbd ."
