d2\u0dc3\u0dd4\u0dbb\u0dd4\u0dd9\u0dba\u0dba\u0d9a\u0dd4 \u0db1\u0dd2\u0dbd \u0db1\u0dd2\u0dd9\u0dcf\u0dc3 \u0da2\u0db8\u0db1\u0dcf\u0dd9 \u0dbd\u0dd9\u0dcf\u0d9c\u0dd4\u0dc0 \u0dbd\u0dd0\u0daf\u0dda \u0daf\u0dda \u0dd9\u0db1 \u0dc0\u0dd2\u0da7 \u0db8\u0daf\u0dc4\u0dc3\u0dae\u200d\u0dbb\u0dcf\u0dad\u0dca\u0dd9\u0dbb\u0dd4\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dda\u0dc0\u0dd2\u0dad\u0dca\u0dd9 \u0dc0\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dbb\u0dd4 \u0db1\u0dd2\u0dbd \u0db1\u0dd2\u0dd9\u0dc3\u0d9a\u0dca \u0d89\u0daf\u0dd2 \u0dba\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dd9\u0dad\u0dd3.\n\n(ii) \u0daf\u0db1\u0dcf\u0daf\u0db1\u0dd3.\n\n\u0db8\u0dd2\u0db1\u0dca \u0daf\u0db4\u0dba \u0dc0\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dbb\u0dd4 \u0db1\u0dd2\u0dbd \u0db1\u0dd2\u0dd9\u0dc3\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0dba\u0db1 \u0dbd\u0daf \u0d8b\u0d9a\u0dca\u0dad \u0d89\u0da9\u0db8 \u0db1\u0d9c\u0dba \u0dc3\u0dcf\u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0db1 \u0dd9\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dcf\u0d9c\u0dbb\u0dd2 \u0dc3\u0dcf\u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0db1 \u0d85\u0db0\u0dd2 \u0dcf\u0dbb\u0dd2\u0dba \u0daf\u0dd9\u0dad \u0dbd\u0dd9\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0daf\u0dba\u0ddd\u0da2\u0dd2\u0dad\u0dd9 \u0dad\u0dd2\u0db6\u0dd6 \u0dd9\u0dd0\u0dc0\u0dd2\u0db1\u0dca \u0d91\u0db8 \u0d89\u0da9\u0db8 \u0daf\u0db8\u0db8 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dcf\u0dc1\u0dba \u0daf\u0dd9\u0dad \u0db4\u0dd9\u0dba\u0dcf \u0da2 \u0daf\u0db1\u0dcf\u0db8\u0dd0\u0dad.\n\n\u0db4\u0dcf\u0db1\u0daf\u0dd4\u0dba \u0db8\u0daf\u0dc4\u0dc3\u0dae\u200d\u0dbb\u0dcf\u0dad\u0dca \u0d85\u0db0\u0dd2 \u0dba\u0dab \u0daf\u0dba\u0da2\u0dd2\u0dc3\u0dae\u0dbb\u0dcf\u0dbb\u0dca\u0dbd \u0daf\u0dd9\u0dad \u0daf\u0dba\u0dcf\u0db8\u0dd4 \u0dba \u0dc3\u0dad\u0dd2 \u0db4\u0dcf\u0db1\u0daf\u0dd4\u0dba \u200d\u0dbb\u0dcf\u0daf\u0dda\u0dba \u0dba \u0daf\u0dbd\u0dca \u0dda\u0daf\u0dda \u0d85\u0dcf PN/L/II/56-2 \u0dc4\u0dcf 2024.08.55 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0dd2\u0db4\u0dd2\u0dba \u0d85\u0dd4\u0dc0\u0dd9 \u0d91\u0db8 \u0daf\u0dda\u0db4 \u0daf\u0dda \u0dd9\u0db1 \u0dc0\u0dd2\u0da7 \u0db1\u0dcf\u0d9c\u0dbb\u0dd2 \u0dc3\u0dcf\u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0db1 \u0d85\u0db0\u0dd2 \u0dcf\u0dbb\u0dd2\u0dba \u0daf\u0dd9\u0dad \u0db4\u0dd9\u0dba\u0dcf \u0dc3\u0dad\u0dd2 \u0daf\u0dda\u0db4 \u0d9a\u0dca \u0dd9\u0dd0\u0dc0\u0dd2\u0db1\u0dca \u0daf\u0db8\u0db8 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dcf\u0dc1\u0dba\u0da7 \u0d91\u0db8 \u0d89\u0da9\u0daf\u0dda \u0dc4\u0dd2\u0db8\u0dd2 \u0db8\u0d9a\u0dca \u0daf\u0db1\u0dcf\u0db8\u0dd0\u0dad. (iii) \u0d85\u0daf\u0dcf \u0daf\u0db1\u0dcf\u0daf .\n\n(\u0dc3 \u0d85\u0daf\u0dcf \u0daf\u0db1\u0dcf\u0daf .\n\n(\u0b85) (i) \u0b86\u0bae\u0bcd. \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 2019\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0b87\u0ba8\u0bcd\u0ba4 \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0baf\u0bbe\u0b95\u0baa\u0bc2\u0bb0\u0bcd\u0bb5 \u0b87\u0bb2\u0bcd\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0ba8\u0bc0\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0b95\u0bb3\u0bcd \u0bb5\u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0bae\u0bae\u0baf\u0bbe\u0bb2\u0bcd, \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0baf\u0bbe\u0b95\u0baa\u0bc2\u0bb0\u0bcd\u0bb5 \u0b87\u0bb2\u0bcd\u0bc8\u0bae\u0bcd \u0ba8\u0bc0\u0ba3\u0bcd\u0b9f \u0b95\u0bbe\u0bc8\u0bae\u0bbe\u0b95 \u0bae\u0bc2\u0b9f\u0bbf\u0bae\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0ba4\u0ba9\u0bcd \u0b95\u0bbe\u0bb0\u0ba3\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0baa\u0bbe\u0bb5\u0bbf\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bbe\u0ba4 \u0ba8\u0bbf\u0bae\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.\n\n(ii) \u0baa\u0bbe\u0ba3\u0ba8\u0bcd\u0ba4\u0bc1\u0bae\u0bb1 \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bbf\u0baf\u0bb2\u0bcd \u0b9a\u0bae\u0ba9\u0bcd\u0bae\u0bc1\u0bae\u0bb1\u0baf\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1 \u0b9a\u0bae\u0bb2\u0bcd\u0ba8\u0bc0\u0ba4\u0bbf\u0bae\u0ba9\u0bcd\u0bb1\u0ba4\u0bcd\u0bae\u0ba4 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0b95 \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4 \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0baf\u0bbe\u0b95\u0baa\u0bc2\u0bb0\u0bcd\u0bb5 \u0b87\u0bb2\u0bcd\u0bc8\u0ba4\u0bcd\u0bae\u0ba4 \u0b89\u0baa\u0b9a\u0baf\u0bbe\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4 \u0bae\u0bc1\u0ba9\u0bcd\u0b9a\u0bae\u0bbe\u0bb4\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd, \u0b85\u0ba4\u0bc1 \u0b9a\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0b95 \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0bae\u0b95 \u0b8e\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0bb5\u0bb0\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b9a\u0bae\u0bb2\u0bc1\u0bae\u0bcd, \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bae\u0bc0\u0ba4\u0bae\u0bc1\u0bb3\u0bcd\u0bb3 \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0ba8\u0bc0\u0ba4\u0bb5\u0bbe\u0ba9\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b87\u0bb0\u0b9f\u0bcd\u0bae\u0b9f \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0baf\u0bbe\u0b95\u0baa\u0bc2\u0bb0\u0bcd\u0bb5 \u0b87\u0bb2\u0bcd\u0bc8\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bcd\u0bae\u0bbe\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0bb0\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1.\n\n(iii) \u0ba8\u0bc0\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0bc1\u0ba4\u0bbf\u0ba4\u0bbe\u0b95 \u0ba8\u0bbf\u0bb0\u0bcd\u0bae\u0bbe\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0bb0\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b87\u0bb0\u0b9f\u0bcd\u0bae\u0b9f \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0baf\u0bbe\u0b95\u0baa\u0bc2\u0bb0\u0bcd\u0bb5 \u0b87\u0bb2\u0bcd\u0bc8\u0bae\u0bbe\u0b95\u0bc1\u0bae\u0bcd. (\u0b95\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b86\u0bb0\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0ba8\u0bbf\u0bc8\u0bb5\u0bbf\u0baf \u0b9a\u0baa\u0bbe\u0bb0\u0bc1\u0bb3\u0bbe\u0ba4\u0bbe\u0bb0 \u0b9a\u0ba8\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0b9f\u0bbf\u0b95\u0bb3\u0bc1\u0b9f\u0ba9\u0bcd \u0ba8\u0bbf\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bbe\u0b95\u0bc1\u0bae\u0bcd. \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0b86\u0bb0\u0bae\u0bcd\u0baa\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0b95 \u0b92\u0baa\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0bae\u0bcd \u0b85\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.)\n\n(iv) \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4 \u0b95\u0b9f\u0bcd\u0b9f\u0b9f\u0ba4\u0bcd\u0bae\u0ba4 \u0ba8\u0bbf\u0bb0\u0bcd\u0bae\u0bbe\u0ba3\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0b95\u0ba4\u0bcd \u0ba4\u0bb1\u0bcd\u0b9a\u0baa\u0bbe\u0ba4\u0bc1 \u0b9a\u0b9a\u0bc8\u0bb5\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b9a\u0ba4\u0bbe\u0bae\u0b95\u0baf\u0bbe\u0ba9\u0ba4\u0bc1 \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 18,045,206.41 \u0b86\u0b95\u0bc1\u0bae\u0bcd.\n\n(\u0b86) (i) \u0ba8\u0bc0\u0ba4\u0bbf\u0bae\u0ba9\u0bcd\u0bb1 \u0ba8\u0bc0\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0baf\u0bbe\u0b95\u0baa\u0bc2\u0bb0\u0bcd\u0bb5 \u0b87\u0bb2\u0bcd\u0bc8\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b9a\u0ba4\u0bae\u0bb5\u0bae\u0baf \u0b85\u0bae\u0b9f\u0baf\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0bb5\u0bbf\u0ba4\u0bae\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bbe\u0bb1\u0bc1 \u0b85\u0bae\u0bae\u0baf\u0bc1\u0bae\u0bcd."
