d\u0dd3\u0dd4\u0db8 \u0dc0\u0db1\u0dd2 \u0db6\u0db6\u0dd4\u0db8 \u0dc0\u0dcf \u0d85 \u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db6\u0dbd\u0dcf\u0db8\u0db4\u0dcf\u0db8\u0dba\u0dcf \u0d9a\u0dd4 \u0dc0\u0dd4\u0dab\u0dd4 \u0db8\u0dd4:\u0dbd \u0dca \u0dbd\u0dd4\u0db6\u0dd4\u0dab\u0dd4 \u0db8\u0dd4:\u0dbd \u0d9c\u0dd4\u0dca \u0db8\u0db1\u0dca\u0dad:?\n\n\u0d9c\u0dbb\u0dd4 \u0dc0\u0dbb\u0ddd\u0dc4\u0dd2\u0dad \u0d85\u0dc0\u0dda\u0d9c\u0dd4\u0da7\u0dc0\u0dbb\u0dca\u0db0\u0dcf\u0db1 \u0dd9\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b95\u0bb0\u0bbe\u0bb9\u0bbf\u0ba4\u0bcd\u0ba4 \u0b85\u0b95\u0baa\u0b95\u0bc1\u0ba3\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9) (The Hon. Rohitha Abeygunawardhana) \u0d85\u0da7\u0dca\u0dcf\u0dca\u0db8\u0dda \u0dbd\u0dd4\u0db6\u0dd4\u0dab\u0dd4 \u0db8\u0dd4\u0dc5\u0dd4 \u0db8\u0dd4:\u0dbd \u0d9c\u0dd4\u0dca. \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dca\u0dcf\u0db1\u0dca\u0dad \u0da2\u0dba\u0dd3\u0db8\u0dbb \u0dd9\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba8\u0bbf\u0b9a\u0bbe\u0ba8\u0bcd\u0ba4 \u0b9c\u0baf\u0bb5\u0bc0\u0bb0) (The Hon. Nishantha Jayaweera) \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0dca 1\u0d9a\u0dca\u0dc0 \u0db6\u0dbd\u0dcf\u0db8\u0db4\u0dcf\u0db8\u0dba\u0dcf \u0d9a\u0dd4 \u0dc0\u0dd4\u0da7\u0dcf. \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0dca 90 \u0d9a\u0dca\u0dc0 \u0dbd\u0dd4\u0db6\u0dd4\u0da7\u0dcf."
