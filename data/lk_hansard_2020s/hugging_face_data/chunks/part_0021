    "chunk_text": "\u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0d9c\u0dc0\u0dba\u0dc5 \u0dad\u0dd3\u0dba\u0d9c\u0dda \u0d9c\u0dc0\u0dba\u0dc5 \u0d9b\u0dca\u200d\u0dcf\u0daf\u0db1\u0dba\u0db1\u0dca\u0dad \u0db1\u0dd2\u0db8\u0dda\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0da7\u0dba \u0d9c\u0dc0 \u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf, \u0dc0\u0dd2\u0d9c\u0dc1\u0dda\u0dc2\u0dca\u0da8\u0d9c\u0dba\u0db1\u0dca\u0dad\u0db8 \u0d9c (\u0daf\u0dd4\u0dbb\u0dd4\u0dad\u0dd4\u0dca\u0dc0, \u0dc0\u0dd2\u0d9a\u0dcf\u0db8\u0dda \u0d8b\u0dad\u0dd4\u0dba, \u0d9a\u0dbd\u0dca\u0db8\u0dd4\u0d9c\u0da9\u0dd4\u0d9a \u0db1\u0dd2\u0db1\u0dca\u0dad\u0daf\u0dc0\u0dd6\u0dbb\u0dca\u0dbd \u0dc3\u0dc4 \u0dbb\u0dd3\u0db1\u0dca\u0dad\u0db1\u0dd2\u0dba\u0dcf \u0dbb\u0dd3\u0dba\u0db1 \u200d\u0dbb\u0d9c\u0dda\u0dc1\u0dc0 . \u0da7\u0dc5\u0d9f\u0db4, \u0db8\u0dd4\u0dad\u0dd4\u0db4\u0db1\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dc3\u0dc4 \u0dca\u0dba\u0da0\u0dca\u0da0\u0dd2\u0d9a\u0da7\u0dca\u0db4\u0dca\u0dc0 \u0dbb\u0dd3\u0dba\u0db1 \u200d\u0dbb\u0d9c\u0dda\u0dc1\u0dc0 \u0d9a\u0dc5\u0db4\u0dd4 \u0dca\u0dca\u200d\u0dbb\u0dd2\u0dad \u0d9a \u0d9c\u0da9\u0dcf \u0dcf\u0db1 \u0db4\u0dbb\u0dd2\u0dc3\u0dba \u0db4\u0dda\u0db0\u0dad\u0dd3\u0db1\u0dca\u0dad\u0db4 \u0dc4\u0dcf\u0db1\u0dd2 \u0db4\u0dd4\u0db8\u0dd2\u0dab\u0dd2 \u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0dad\u0d9a\u0dca\u0db8\u0db1\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0da9\u0dcf \u0d9a \u0dc3\u0dc0\u0dd2\u0dc3\u0dda\u0dad\u0dba \u0dad\u0d9a\u0dca\u0d9c\u0dc3\u0dda\u0dbb\u0dd4\u0dc0\u0d9a\u0dca \u0d9c\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc0 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dba\u0db1\u0dca\u0dad\u0db1\u0db4 \u0d9a, \u0dc4\u0db3\u0dd4\u0db1\u0dcf \u0d9c \u0d9a \u0dc0\u0dd2\u0d9c\u0dc1\u0dda\u0dc2\u0dca\u0da8 \u0dc3\u0dda\u0dae\u0dcf\u0db1 \u0dbb\u0dd3\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0dba\u0dae\u0dcf\u0dc0 \u0d9a \u0dbb\u0dd3\u0db8\u0dda\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d9a\u0da9\u0dd2\u0db1\u0dda \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0d9c\u0db1\u0dca\u0dad\u0db1 \u0d9a \u0d9c\u0dda \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0d9c\u0dda\u0dc1 \u0d9a\u0dba \u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0dd6 \u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2, \u0db8\u0db8 \u0d9c\u0dda \u0d85\u0dc0\u0dc3\u0dda\u0dae\u0dcf\u0d9c \u0d91\u0db8 \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0dc0 \u0dc3\u0db7\u0dcf\u0d9c\u0dad* \u0d9a\u0dba\u0db1\u0dc0\u0dcf.\n\n\u0d85\u0dda\u0db6\u0dd4\u0dbd\u0dd4\u0dc0\u0dcf\u0dc0 \u0dc3\u0dc4 \u0d91\u0db8 \u0d9c\u0d9a\u0dca\u0db6\u0dbd\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dbd \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0d9c\u0dda \u0dc0\u0db1\u0dad\u0dd2\u0d9a \u0dad \u0d9a \u0d9a\u0dc0\u0dba \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0d9c\u0dba\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0d9c\u0da7\u0d9a\u0dcf\u0d9a\u0dbb\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0db6\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0dad \u0db1\u0dd2\u0db8\u0dda\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0da7 \u0d87\u0dad\u0dd4\u0dc5 \u0d9a \u0d9c\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0dcf \u0d91\u0dc4\u0dd2 \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dbb\u0dd3\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0dbb\u0dd3\u0dba\u0db1\u0dca\u0dad\u0db1\u0dda.\n\n\"\u0d9c\u0db8\u0db8 \u0d85\u0dba\u0db8\u0dd4\u0daf\u0d9c\u0dbd\u0dca 202( \u0dc0\u0dc3\u0dba\u0db4 \u0d85\u0daf\u0dcf\u0dc5\u0dc0 \u0dc0\u0dd2\u0d9c\u0da7\u0d9a\u0dcf\u0d9a\u0dbb\u0db4\u0dad\u0dd2 \u0d9c\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0d9c\u0dda\u0db1\u0dca\u0dad\u0dad\u0dd4 \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0d9c \u0db8\u0dad\u0d9c\u0daf\u0daf\u0dba\u0db4 \u0dad\u0dd4\u0dca \u0d9c\u0daf\u0db1 \u0d9c\u0db1\u0dd4\u0d9c\u0daf\u0db1\u0dd4 \u0dba\u0db4\u0d9c \u0d9a \u0d9c\u0db8\u0d9c\u0dc3\u0dda \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dba \u0dad\u0dd2\u0d9c\u0db6\u0dca\u0dbd.\n\n'2023 \u0da2\u0dd4\u0db1\u0dd2 10 \u0daf\u0dd2\u0db1 \u0db4\u0dc0 \u0d9a\u0dc0\u0db1 \u0daf \u0db7\u0dcf\u0dba\u0d9a\u0dcf\u0dba \u0db8\u0da9\u0dd4\u0d9a\u0da9 \u0dbb\u0dd0\u0dc3\u0dda\u0dd3\u0db8\u0d9c\u0dda \u0da2 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 1.2\u0d9a \u0d87\u0dc3\u0dda\u0dad\u0d9c\u0dda\u0db1\u0dca\u0dad\u0dad\u0dd4\u0dc0\u0d9a\u0dca \u0d85\u0db1\u0dd4\u0dc0 \u0d9c\u0d9a\u0dca\u0db6\u0dbd\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dbd \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0dbb\u0dd3\u0db8\u0dda\u0db8\u0db4 \u0d9a, \u0d91\u0dba \u0dad\u0daf\u0dd2\u0d9a\u0dba \u0db4\u0dc0 \u0d9a\u0dc0\u0dcf\u0d9c\u0d9c\u0db1 \u0dba\u0dcf\u0db8\u0db4 \u0d9c\u0dc0\u0db1\u0db8 \u0dc3\u0db8\u0dcf\u0d9c\u0db8\u0d9a\u0db4 \u0db6\u0daf\u0dd4 \u0da2\u0db8\u0db4 \u0d9a, \u0d87\u0dc3\u0dda\u0dad\u0d9c\u0dda\u0db1\u0dca\u0dad\u0dad\u0dd4 \u0db8\u0dd4\u0daf\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0dd2\u0dba\u0dba\u0db4 16\u0d9a\u0dca \u0db7\u0dcf\u0dba\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0daf\u0dd4\u0db8\u0dda\u0db8\u0db4 \u0d9a \u0dad\u0dd3\u0dba\u0da7\u0dba \u0d9a\u0dba \u0dad\u0dd2\u0db6\u0dd6 \u0d85\u0dad\u0dba, \u200d\u0dbb\u0dc3\u0dda\u0db4\u0dcf\u0daf\u0db1 \u0d9a\u0dd4\u0db3\u0dd3\u0db8\u0db8\u0dbb\u0dd3\u0db1\u0dca\u0dad \u0d9c\u0dad\u0dcf\u0dba\u0dc0, \u0db7\u0dcf\u0dba\u0d9a\u0dcf\u0dba \u0db8\u0da9\u0dd4\u0d9a\u0da9 \u0dbb\u0dd0\u0dc3\u0dda\u0dd3\u0db8\u0db8 \u0db4\u0dc0 \u0d9a\u0dc0\u0dcf \u0daf\u0dd2\u0db1 06\u0d9a\u0db4 \u0db4\u0dc3\u0dd4, \u0d91\u0db1\u0dda 2023 \u0da2\u0dd4\u0db1\u0dd2 16 \u0daf\u0dd2\u0db1 \u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0dcf\u0da0\u0dd2 \u0d9a\u0dc5 \u0dc3\u0db8\u0dcf\u0d9c\u0db8\u0d9a\u0dca \u0dc3\u0db8\u0d9f \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0dad\u0db4\u0dca \u0dbb\u0dd3\u0db8\u0dda\u0db8\u0db4 \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0dda\u0d9c\u0dad \u0dd3\u0db8 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd2. \u0d91\u0db8 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0db8\u0dcf\u0d9c \u0ddd\u0da0\u0dd2\u0dad \u0dc0\u0dbb\u0dca\u0dbd\u0dc2\u0dca\u0da8\u0dba \u0dad\u0dd4\u0dc5 \u0da2 \u0dc0\u0dc0\u0dd4\u0da0\u0dbb\u0dca\u0dbd 19\u0d9a\u0dca \u0db8\u0d9f\u0dd2\u0db1\u0dca\u0dad \u0d91\u0d9a\u0dad\u0dd4\u0dc0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dba\u0db1 93.15\u0d9a\u0dca \u0dc0\u0dd4\u0dba \u0d9a\u0dba \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0d85\u0dad\u0dba, \u0d91\u0dba \u0d9a\u0dd4\u0db8\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dba\u0d9a\u0db4\u0daf \u0dba\u0db1\u0dca\u0dad\u0db1 \u0dc3\u0db1\u0dcf\u0dae \u0d9a\u0dba \u0d9c\u0dd4\u0db1\u0dd3\u0db8\u0db4 \u0d9c\u0d9c\u0dd3\u0db8\u0dda \u0dc0\u0dc0\u0dd4\u0da0\u0dba\u0dba \u0dc3\u0db8\u0d9f \u0d8b\u0db4\u0d9c\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1 \u0dc0\u0dd2\u0d9c\u0da7\u0db1\u0dba\u0db4 \u0dad\u0daf\u0dd2\u0dbb\u0dd2\u0db4 \u0d9a \u0d9c\u0db1\u0dcf\u0dd3\u0db8\u0dba. \u0d9c\u0d9a\u0dca\u0db6\u0dbd\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dbd \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0d9c\u0dda \u0dba\u0da7\u0dd2\u0dad \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dda \u0dc3\u0dcf\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba \u0dbb\u0dd3\u0db8\u0dda\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2 \u0dba\u0db1 250.3\u0d9a \u0d87\u0dc3\u0dda\u0dad\u0d9c\u0dda\u0db1\u0dca\u0dad\u0dad\u0dd4\u0dc0\u0d9a\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dba\u0dc5 \u0d9a\u0dba \u0d91\u0dba\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0dd2\u0dba\u0dba\u0db4 37\u0d9a \u0db8\u0dd4\u0daf \u0d9a\u0dca \u0d9c\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0db4 \u0db7\u0dcf\u0dba\u0d9c\u0dba\u0db1\u0dca\u0dad \u0daf\u0dba\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd2.' \"\n\n\u0dc0\u0dd2\u0d9c\u0da7\u0d9a\u0dcf\u0d9a\u0dbb\u0db4\u0dad\u0dd2\u0dc0\u0dba\u0dba\u0dcf\u0d9c\u0dda \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0d9c\u0dda\u0dc1\u0dba \u0dc0\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad, \u0d9c\u0db8\u0db8 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0d9c\u0dba\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0d9a\u0dbb\u0db8 \u0d9a \u0db4\u0db8\u0dda\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0da7\u0dba\u0d9a\u0dca \u0db4\u0dc0 \u0d9a\u0dc0\u0dcf \u0d85\u0dc0\u0dd2\u0d9a\u0dbb\u0db8 \u0d9a \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d9a\u0db4\u0dd4\u0dad\u0dad\u0dd4 \u0d9a\u0dc5 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dc1\u0dda\u0dc0 \u0d9c\u0dc0\u0dad \u0db4\u0dd2\u0dba\u0dc0\u0dba \u0d9c\u0dad \u0dd4\u0dad\u0dad\u0dd4\u0dba \u0dba\u0db1\u0dca\u0dad\u0db1\u0dba\u0dd2.\n\n\u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0dc3\u0dd4\u0d9a \u0dc3\u0dc4\u0dd2\u0dad, \u0d85\u0dc0\u0dd2\u0d9a\u0dbb\u0db8 \u0d9a \u0d9c\u0db1\u0dd4\u0d9c\u0daf\u0db1\u0dd4 \u0dc3\u0dc4\u0dd2\u0dad \u0d85\u0dc0\u0dd2\u0d9a\u0dbb\u0db8 \u0d9a \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0dc4\u0dd4\u0da7\u0dd2\u0dba\u0db4 \u0dad\u0db8\u0dba\u0dd2 \u0d9c\u0db8\u0db8 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0d9c\u0dd4\u0db1 \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0dc0\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad, \u0db8\u0dd6 \u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2. \u0d85\u0dda\u0db6\u0dd4\u0dbd\u0dd4\u0dc0\u0dcf\u0dc0 \u0db7\u0dcf\u0dba\u0d9a\u0dcf\u0dba \u0db8\u0da9\u0dd4\u0d9a\u0da9 \u0dba \u0d9c \u0d9a\u0d9c\u0dad\u0dcf \u0d9a, \u0d92 \u0db7\u0dcf\u0dba\u0d9a\u0dcf\u0dba \u0db8\u0da9\u0dd4\u0d9a\u0da9 \u0d9c\u0dda \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0dad \u0dc4 \u0d9a\u0d9c\u0daf\u0d9c\u0db1\u0d9a\u0dca \u0dad\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf. \u0d92 \u0dc4 \u0d9a\u0d9c\u0daf\u0db1\u0dcf\u0d9c\u0dda \u0db1\u0dda \u0d9c\u0db8\u0db1\u0dca\u0dad\u0db1 \u0d9c\u0db8\u0d9c\u0dc4\u0db8\u0dba\u0dd2 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad."
