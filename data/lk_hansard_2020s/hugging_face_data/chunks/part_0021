b8\u0dca\u0db6 \u0dad\u0db4\u0daf\u0dcf\u0db1\u0dc0\u0db1\u0dca\u0db8 \u0db1\u0db8\u0dca\u0db6 \u0dbb\u0da7 \u0dc0\u0dd2\u0dd9\u0dcf \u0db1\u0dc0\u0db1\u0dca\u0dd9 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0da2\u0dd9\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0d9c\u0dab\u0db1\u0dca \u0d9c\u0db1\u0dca\u0db1\u0db1\u0dca \u0dd9\u0dd0\u0dc4\u0dd0, \u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dbd\u0dca\u0dbd\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0db1\u0dca\u0db1\u0db1\u0dca \u0dd9\u0dd0\u0dc4\u0dd0 \u0d85\u0dd2\u0dc5 \u0d9a\u0dd2\u0d9c\u0dd9 \u0db1\u0daf\u0dca\u0dc0\u0dbd\u0dca\u0dc0\u0dbd\u0da7. \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0d9c, \u0d92 \u0dc0\u0dcf\u0db1 \u0db8 \u0d85\u0db1\u0dd9 \u0db4\u0dca \u0d85\u0d9c \u0d9a\u0dd2\u0d9c\u0dd9 \u0db1\u0daf\u0dca \u0d9c\u0dd0\u0dd9 \u0d9a\u0dd2\u0dc3\u0dd2\u0db8 \u0d85\u0dc0\u0db1\u0db6\u0ddd\u0db0\u0d9c\u0d9a\u0dd2\u0db1\u0dca \u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dbd\u0dd2\u0db8\u0dca \u0db1\u0dc0\u0db1\u0dca\u0db1\u0db1\u0dca \u0dd9\u0dd0\u0dc4\u0dd0. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0dd2\u0dc5 \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0dd9\u0dc0\u0dcf, \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0db1\u0d9c\u0db1\u0dca, \u0da2\u0dd9\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0db1\u0d9c\u0db1\u0dca, \u0dc3\u0dd2\u0d9c\u0dbd\u0dd4\u0db1\u0daf\u0dd9\u0dcf\u0db1\u0d9c\u0db1\u0dca\u0db8, \u0db1\u0db8\u0dca\u0db6 \u0d85\u0dc0\u0dc3\u0dcf\u0d9c\u0dcf\u0db1\u0dda\u0daf\u0dd3 \u0da2\u0dcf\u0dad\u0dba\u0db1\u0dca\u0dad\u0dbb\u0d9c, \u0d92 \u0dc0\u0dcf\u0db1 \u0db8 \u0db1\u0db8\u0dca\u0db6 \u0dbb\u0db1\u0da7\u0dca \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0d9c \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dd4 \u0dc3\u0dd2\u0d9c\u0dbd\u0dd4\u0db1\u0daf\u0dd9\u0dcf\u0db8 \u0d91\u0d9a\u0dad\u0dd4\u0db8 \u0d9a\u0dbb\u0db1\u0d9c\u0dd9 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dbb\u0db1\u0dca\u0dd9 \u0d9a\u0dd2\u0d9c\u0dbd\u0dcf. \u0db8\u0db8 \u0dd9\u0dd0\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0d9c\u0dd9\u0dc0\u0dcf, \u0d85\u0dd2\u0dc5 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0d9c\u0d9a\u0dca \u0db1\u0dbd\u0dc3 \u0d89\u0dad\u0dcf\u0db8 \u0db1\u0dc4\u0dcf\u0db3\u0da7, \u0dc3\u0dd2\u0d9c\u0dbd\u0dd4\u0db1\u0daf\u0dd9\u0dcf\u0db8 \u0d91\u0d9a\u0dad\u0dd4\u0db8 \u0d9a\u0dbb \u0db1\u0d9c\u0dd9 \u0dad\u0dab\u0dca\u0dd4\u0dc0\u0da7 \u0d85\u0dc0 \u0dba \u0dc3\u0dc4\u0db1\u0d9c\u0ddd\u0d9c\u0d9c \u0dbd\u0db6\u0dcf \u0db1\u0dca \u0db6\u0dc0. \u0dd9\u0dd0\u0daf\u0dca\u0daf, \u0dc4\u0dbb\u0dca\u0dc2 \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dcf?\n\n\u0d92 \u0daf\u0dd0\u0dd4\u0dc0\u0dc0\u0dca \u0d9a\u0dd2\u0db8\u0dda\u0db8 \u0dc4\u0dbb\u0dd2\u0d9c\u0da7 \u0dbd\u0db6\u0dcf \u0d9c\u0dca\u0dad\u0dcf \u0dd9\u0db8\u0dca\u0db6, \u0d85\u0db4\u0da7 \u0db1\u0db8\u0dca\u0db6 \u0dc0\u0dba\u0dc3\u0dd9\u0db1\u0d9c\u0db1\u0dca \u0dc3\u0dd2\u0d9c\u0d9c\u0da7 80\u0d9a\u0dca \u0db1\u0dda\u0dbb\u0dcf \u0d9c\u0db1\u0dca\u0dd9 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dbb\u0da7\u0d9a\u0dca \u0dc0 \u0db1\u0d9c\u0db1\u0dca \u0d85\u0db1\u0dda \u0d8b\u0db4\u0dbb\u0dd2\u0db8 \u0dc3\u0dc4\u0db1\u0d9c\u0ddd\u0d9c\u0d9c \u0db1\u0daf\u0db1\u0dca\u0dd9 \u0db1\u0db8\u0dca\u0db6 \u0d85\u0dc0\u0dc3\u0dcf\u0d9c\u0dcf\u0db1\u0dda \u0d85\u0dd2\u0dc5 \u0dd6 \u0daf\u0dcf\u0dd9\u0db8\u0dca\u0db6 \u0d9a\u0dd2\u0d9c\u0dd9 \u0d91\u0d9a \u0dd9\u0dd0\u0dc0\u0dad\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0dd2\u0dba\u0db1\u0dca, \u0db8\u0db1 \u0dc0\u0da0\u0dd9 \u0dc3\u0dcf\u0dc0\u0dbd\u0dca\u0db4\u0d9c \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0dd9\u0dc0\u0dcf. \u0db1\u0db6\u0dcf\u0db1\u0dc4\u0dcf\u0db8 \u0dc3\u0dcf\u0dad\u0dd4\u0db8\u0dad\u0dd2\u0dba\u0dd2.\n\n\u0d9c\u0dd4 \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0db8\u0db1\u0dca\u0dd3\u0dd4\u0dbb\u0db8\u0dd2\u0dba (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba4\u0bae\u0bb2\u0bae\u0bc8\u0ba4\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bc6\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0db8\u0dd3\u0dc5\u0d9f\u0da7, \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2 \u0dcf\u0db1\u0dca\u0dad \u0db1\u0db4\u0db1\u0dbb\u0dca\u0dbb\u0dcf \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dcf. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0da7 \u0dc0\u0dd2\u0dd9\u0dcf\u0da9\u0dd2 5\u0d9a \u0d9a\u0dcf\u0dbd\u0d9c\u0d9a\u0dca \u0dad\u0dd2\u0db1\u0db6\u0dd9\u0dc0\u0dcf.\n\nOrder, please! \u0db1\u0db8\u0dca\u0db6 \u0d85\u0dc0\u0dc3\u0dcf\u0d9c\u0dcf\u0db1\u0dda \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0dd9\u0d9c \u0dc3\u0db3\u0dc4\u0dcf \u0d9c\u0dbb\u0dd4 \u0dc3\u0dcf\u0da2\u0dd3\u0dc0 \u0dbb\u0dab\u0dc3\u0dd2\u0dcf\u0dc4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0db4\u0dd0\u0dd2\u0dba\u0db1\u0dab\u0dd9\u0dc0\u0dcf \u0d87\u0dad\u0dd2.\n\n2821 2822\n\n[\u0d9c\u0dbb\u0dd4 \u0db1\u0dd3\u0dad\u0dd2\u0dcf \u0d85\u0dbb\u0dca\u0da2\u0dd4\u0dd9 \u0dc3\u0dd4\u0da2\u0dd3\u0dc0 \u0db1\u0dc3\u0dcf\u0dd9\u0dc3\u0dd2\u0dcf\u0dc4 \u0db8\u0dc4\u0dad\u0dcf]\n\n2025 \u0db1\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0db6\u0db6\u0dbb\u0dca 05\n\n\u0d85\u0db1\u0dd4\u0dbb\u0dd4\u0dc0 \u0d9c\u0dd4 \u0dc3\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a\u0dcf \u0d85\u0dad\u0dcf\u0dc0\u0dd4\u0dd9 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2\u0dba \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0daf\u0dba\u0db1\u0dca \u0d89\u0dc0\u0dad\u0dca \u0dc0\u0dd6\u0daf\u0dba\u0db1\u0dca, \u0d9c\u0dd4 \u0dc3\u0d82.\u0da9\u0dc0 \u0dbb\u0dab\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dcf \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dc0\u0dd2\u0dba.\n\n\u0b85\u0ba4\u0ba9\u0bcd\u0baa\u0bbf\u0bb1\u0b95\u0bc1,\u200d \u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1\u200d (\u0ba4\u0bbf\u0bb0\u0bc1\u0bc8\u0ba4\u0bbf)\u200d \u0b9a\u0bc6\u0bbe\u0b95\u0bc6\u0bbe\u0bbf\u0b95\u0bc6\u0bbe\u200d \u0b85\u0ba4\u0bc6\u0bbe\u0bb5\u0bc1\u0ba4\u200d \u0b85\u0bc6\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\u200d\u0b85\u0b95\u0bcd\u0b95\u0bbf\u0bb0\u0bc6\u0bbe\u0b9a\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbf\u0ba9\u0bcd\u0bb1\u0bc1\u200d \u0b85\u0b95\u0bb2\u0bb0\u0bc6,\u200d \u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1\u200d \u0b9a\u0b9e\u0bcd\u0b9c\u0bc0\u0bc6\u200d \u0bb0\u0ba3\u0b9a\u0bbf\u0b99\u0bcd\u0bb9\u200d\u0b85\u0bc6\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\u200d\u0ba4\u0bae\u0bb2\u0bae\u0bc8\u200d\u0bc6\u0b95\u0bbf\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd.\n\nWhereupon THE HON. (MRS.) SAGARIKA ATHAUDA left the Chair, and THE HON. SANJEEWA RANASINGHA took the Chair.\n\n[\u0d85.\u0db7\u0dcf. 4.16]\n\n\u0d9c\u0dd4 \u0db1\u0dd2\u0dc1\u0dca\u0dcf\u0db1\u0dca\u0dad \u0daf\u0db4\u0daf\u0dbb\u0dca\u0dbb\u0dcf \u0db8\u0dc4\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0bc6\u0bbf\u0bb7\u0bc6\u0bbe\u0ba8\u0bcd\u0ba4 \u0ba4\u0baa\u0bb0\u0bb0\u0bb0\u0bc6\u0bbe) (The Hon. Nishantha Perera)"
