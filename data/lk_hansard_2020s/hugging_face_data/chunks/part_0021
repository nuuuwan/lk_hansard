    "chunk_text": "201 \u0dca\u0ddc\u0d82\u0d9c\u0da7\u0dca \u0da7\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0da7 \u0db4:\u0dca\u0dda \u0dd9\u0dba \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca\u0dad \u0db8\u0db4\u0dcf\u0dbd\u0dca \u0da7\u0d9c\u0dcf \u0dbb\u0dd3\u0db8\u0dda\u0db8\u0dda \u0db8 \u0dc0\u0dab\u0dca\u0da9\u0da9\u0dbd \u0dcf \u0db8\u0db4\u0dcf\u0dbd\u0dca \u0db4\u0dbb\u0dca\u0dbd\u0db8\u0dda \u0dc2\u0dca\u0da8\u0da7 \u0d86 \u0dad\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0dd2\u0daf\u0dd4 \u0dd9\u0dba\u0dca \u0dbd: \u0d9c\u0da7\u0dca \u0dbb\u0dd3\u0db8\u0dda\u0dda \u0dad\u0db8 \u0dc0\u0dd2\u0db1 \u0db8 \u0dc0\u0db8 \u0dc0 \u0dbb\u0dd3 \u0db8 . (iv) \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0ddc\u0d82\u0dd9\u0dcf\u0db8 \u0db8\u0db4\u0dcf\u0dbd\u0dca \u0d85\u0dca\u0dda\u0da7\u0dd4\u0db1\u0dca\u0dad\u0dca 2030 \u0da7\u0dca\u0dc0\u0dd2\u0db4 \u0db8\u0d9c\u0da9\u0dd2 \u0db8\u0dd2\u0dd2 \u0dca 200\u0d9a\u0dca\u0dc0 \u0db8\u0dbd\u0dca \u0da7\u0dbb\u0dca\u0dbd\u0dca\u200d\u0dca \u0dbb\u0dd3\u0db8\u0dda\u0db8 \u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dca\u200d\u0dcf\u0dca \u0dad\u0dbd\u0d9a\u0dca\u0dc0\u0dd9 \u0dd9\u0dba \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca\u0dad \u0db8\u0db4\u0dcf\u0dbd\u0dca \u0d85\u0dca\u0dda\u0da7\u0dd4\u0db1\u0dca\u0dad\u0dca \u0da7\u0dd4\u0da9\u0dd2 \u0dbb\u0dd3\u0db8\u0dda\u0db8 \u0dc0 \u0dca \u0dcf \u0db8\u0db4\u0dcf\u0dbd\u0dca \u0da7\u0d9c\u0dcf \u0dbb\u0dd3\u0db8\u0dda\u0db8\u0dda \u0db8 \u0dc0\u0dab\u0dca\u0da9\u0da9\u0dbd \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0db8\u0dd9\u0da7\u0dd2\u0dd9\u0dcf\u0dd3\u0dca \u0dca \u0daf\u0dd3\u0dbb\u0dca\u0dbd\u0d9d\u0dd9\u0dcf\u0dd3\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0db8 \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0db8\u0d9c\u0dca \u0d87\u0dad. \u0d9c\u0dbb\u0dd4 \u0db8 \u0dc0\u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db8 \u0dc0\u0db1\u0dd2 \u0d91\u0db8 \u0dc0 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0db8 \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0da7\u0dd2\u0dd9\u0d9a\u0dca\u0dc0 \u0dc0\u0dd2\u0dca\u0dda\u0dad\u0dba\u0dcf \u0d9a\u0db8 \u0dc0\u0dd9\u0da7 \u0dad\u0dd2 \u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad. \u0db8 \u0dc0\u0db8 \u0dc0 \u0db6\u0db6\u0db4 \u0d91\u0dd2\u0db1\u0db1\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0dca\u200d\u0dcf\u0dca \u0dbb\u0dd3\u0dc4\u0dd2\u0db4 \u0d9a\u0dca\u0dc0 \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dca\u0dda.\n\n\u0db8\u0dd9\u0da7\u0dd2\u0dd9\u0dcf\u0dd3\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0db8 \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\n\n\u2022 \u0db8\u0db4\u0dcf\u0dbd\u0dca \u0d85\u0d9a\u0dca\u0dc0\u0dd9\u0dba \u0dbd\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8 3\u0dd9\u0db4 \u0db8\u0db4\u0dcf\u0db8 \u0dcf\u0dba \u0db8 \u0daf\u0dd3\u0db8 \u0dc0\n\n\u2022 \u0db8\u0db4\u0dcf\u0dbd\u0dca \u0d9c\u0dca\u0dda \u0da7\u0dc3\u0dd4\u0db1\u0dca\u0dad \u0dd9\u0dba \u0db8\u0dad\u0dad\u0db8 \u0dc0\u0dca \u0dca\u0ddc\u0d82\u0dba\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0da7\n\n\u0dbb\u0dd3\u0db8\u0dda\u0db8 \u0dc0 \u0db8\u0da7\u0db1\u0dd4\u0db8\u0da7\u0db1\u0dca\u0dad \u0d91\u0d9a\u0dca\u0dc0 \u0d9c\u0dca\u0dd9\u0db4 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 150\u0dd9 \u0dca \u0dca\u0dcf\u0dca\u200d\u0dcf\u0dba \u0d9a\u0dca\u0dc0 \u0dbd\u0db6\u0dcf \u0db8:\u0dca\u0da7\u0dcf. \u2022 \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0db8\u0dca\u0dc1\u0dd2\u0dad \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0db8 : \u0d85\u0db1\u0dd4\u0da7 \u0db8\u0db4\u0dcf\u0dbd\u0dca \u0dad\u0da9\u0dda\u0da7\u0dbd\u0db4\n\n\u0da2 \u0db4\u0dbd \u0dca\u0dda\u0db4\u0dcf:\u0dca \u0dd9\u0dba\u0dca\u0da7\u0dcf \u0dca\u0dda \u0d91\u0db8 \u0dc0 \u0db4\u0dca\u0dca\u200d\u0dad\u0dd2 \u0dad\u0daf\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u0db8 \u0dc0 \u0db8\u0da7\u0db1\u0dd4\u0db8\u0da7\u0db1\u0dca\u0dad \u0d85\u0d9a\u0dca\u0dc0\u0dd9\u0dba \u0dd9\u0db4 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 30 000\u0dd9 \u0dca \u0dca\u0dcf\u0dca\u200d\u0dcf\u0dba \u0d9a\u0dca\u0dc0 \u0dbd\u0db6\u0dcf \u0db8:\u0dca\u0da7\u0dcf. \u2022 \u0d8a\u0db4 \u0d85\u0db8 \u0dc0\u0dad\u0dba\u0da7 \u0db4\u0dd2\u0db6\u0db8\u0db6 \u0dca\u200d \u0db8 \u0dc0\u0dbb\u0dca\u0dbd:\u0dca \u0db4 \u0d85:\u0dcf\u0dc5 \u0da7\u0dd4\u0da9\n\n\u0db4\u0dd2\u0dd2\u0db6\u0db8\u0da7\u0dc5\u0d9a\u0dca\u0dc0 \u0dad\u0dd2 \u0db8\u0db6\u0dca\u0da7\u0dcf. \u2022 \u0d9a \u0da7\u0dcf\u0db8\u0dda\u0db8 \u0dc0 \u0da7\u0dca \u0dca\u0dd4\u0db1\u0dca\u0dad\u0db8\u0d9c\u0db1\u0dca\u0dad \u0da7\u0dca \u0dcf\u0db1\u0dd2\n\n\u0da7\u0dc5\u0d9a\u0dca\u0dc0\u0da7\u0db1\u0dca\u0dad\u0dca \u0d9a \u0d85\u0db4\u0dd2 \u0dd9\u0db4\u0dba\u0dd4\u0dd4 \u0dd9\u0dba\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dad\u0db1\u0dca\u0dad\u0dca\u0da7\u0dcf. \u2022 \u0d9a \u0da7\u0dcf\u0db8\u0dda\u0db8 \u0dc0 \u0db8\u0db4\u0dcf\u0dbd\u0dca \u0dd2\u0db8\u0dd9 \u0da7 -\u0dc0\u0dd2\u0db8\u0dc1\u0dda\u0dc2\u0dca\u0da8\u0db8 \u0db1\u0dca\u0dad\u0db8 \u0dc0"
