    "chunk_text": "\u0dd4\u0dc5\u0dd4\u0dbd\u0dc0\u0db1\u0dca \u0dc3\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc3\u0db6\u0db1\u0dc0\u0dcf, \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0d8b\u0db4\u0dc3\u0dc1 \u0db1 \u0dc3\u0db7\u0dcf\u0dc0 \u0dad\u0dd4\u0db8\u0dc5 \u0dc3\u0db8\u0dc4\u0dbb \u0dc3\u0dc3\u0dca\u0dc0\u0d9a\u0dd9\u0db1\u0dca \u0dc3\u0dc0 \u0dbd\u0dc3\u0dc0\u0db1\u0dca \u0dc0\u0dca\u0dad\u0dca\u0dad\u0dd3\u0dd9 \u0dc3\u0db8\u0dd2\u0dad\u0dd2\u0dc0\u0dd2\u0db1\u0dca \u0dc3\u0db1\u0db1 \u0d91\u0db1 \u0dc3\u0dd9\u0ddd\u0da2\u0db1\u0dcf \u0d85 \u0dbd\u0db8 \u0d9a\u0dbb\u0db1\u0dca\u0db1. \u0dc4\u0dcf\u0db8\u0dca\u0dd4\u0dc5\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dc3\u0dda \u0db4\u0dd0\u0dad\u0dca\u0dc3 \u0db1\u0dca \u0dc3\u0dc4\u0dc0\u0dad\u0dca \u0dc3\u0dc3\u0dca\u0dc0\u0dcf \u0dc3\u0dd9\u0ddd\u0da2\u0d9a\u0dd9\u0db1\u0dca\u0dc3\u0dda \u0db4\u0dd0\u0dad\u0dca\u0dc3 \u0db1\u0dca \u0d92 \u0dc3\u0dc0 \u0dbd\u0dc3\u0dc0\u0db1\u0dca \u0dc3\u0dc4\u0dc3\u0dd9\u0ddd\u0db1\u0dd9 \u0dbd\u0db6\u0dcf \u0dc3\u0daf\u0db1\u0dc0\u0dcf. \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0d89 \u0dcf\u0db8 \u0dc3\u0dc4\u0dcf\u0db3 \u0db1\u0dd0\u0dd4\u0d9a\u0dbb\u0dd4 \u0dcf\u0dc0\u0dc2\u0dcf \u0daf\u0d9a\u0dd2\u0db1\u0dca\u0db1\u0da7 \u0dad\u0dd2\u0dc3\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u0db1\u0db1\u0dca \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dc3\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0d85\u0db1\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0db8\u0dca \u0daf\u0dd2\u0db1\u0dcf \u0db1\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0db1\u0dca, \u0d85\u0dc3\u0db4\u0dca \u0dc0\u0da7\u0dd2\u0db1\u0dcf\u0d9a\u0db8\u0da7 \u0dc0\u0dd0\u0dd2\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dd9\u0dc2\u0dcf \u0db1\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0db1\u0dca, \u0dbb\u0dc3\u0dda \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dc3 \u0dd9\u0dbd\u0daf\u0dcf\u0db1 \u0dcf\u0dc0 \u0d89\u0dc4\u0dc5\u0da7 \u0db1\u0db1\u0dca\u0db1 \u0db1\u0db8\u0dca \u0d85\u0db4\u0dd2 \u0dad\u0dc2\u0dcf\u0dc3\u0d9a\u0ddd\u0db8 \u0d91\u0d9a\u0da7 \u0d91\u0d9a\u0dad\u0dd4\u0db8 \u0dc3\u0dc0\u0dbd\u0dcf \u0dc3\u0db8\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dd9\u0db1 \u0d91\u0d9a\u0db1.\n\n\u0db8\u0dcf \u0d9a\u0dd2\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dc5\u0dcf \u0dc0\u0dcf\u0dc3\u0dda \u0dc3\u0db8\u0dca \u0dbb\u0da2\u0dc3 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d85\u0dbb\u0db8\u0dd4\u0dab\u0dc2\u0dcf \u0dc3\u0dc0\u0da0\u0dca\u0da0 \u200d\u0dbb\u0db8 \u0db6\u0dbd\u0d9a\u0dcf\u0dd9 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0daf\u0dad\u0dca \u0dc0\u0dd2\u0dc3 \u0dca\u0dc2 \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dd9\u0d9a\u0da7 \u0dbd\u0dc2\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0dc3\u0db4\u0dca \u0dbb\u0dc3\u0dda \u0da2\u0db1\u0db1\u0dc4\u0db1\u0dd9 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 2025\u0daf\u0dd3 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0dd4\u0dc5 \u0db1\u0dc0 \u0db8 \u0dc3\u0dd2\u0d9b\u0dba\u0dcf \u0daf\u0dad\u0dca \u0dc3\u0dbd\u0dca\u0d9b\u0db1\u0dd9\u0da7 \u0d85 \u0dbd\u0dc0 \u0da2\u0db1\u0db1\u0dc4\u0db1\u0dd9 \u0db8\u0dd2\u0dd2\u0dd9\u0db1 21.9\u0dc2\u0dcf \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d91\u0db1\u0db1\u0dca \u200d\u0dbb\u0db8 \u0db6\u0dbd\u0d9a\u0dcf\u0dd9\u0da7 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dad\u0dca \u0dc3\u0dc0\u0db1\u0dca\u0dc3\u0db1\u0dca \u0d85\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dd9\u0dc2\u0dcf; \u0db8\u0dd2\u0dd2\u0dd9\u0db1 \u0d85\u0da7\u0db1 \u0daf \u0db8 \u0db1\u0dab\u0db1\u0dc2\u0dcf. \u0d91\u0db1 \u0dbd\u0dad\u0dca \u0d9a\u0dcf\u0db1\u0dca \u0dcf \u200d\u0dbb\u0db8 \u0db6\u0dbd\u0d9a\u0dcf\u0dd9 \u0dad\u0dd2\u0dc3\u0db6\u0db1\u0dca\u0dc3\u0db1\u0dca \u0db8\u0dd2\u0dd2\u0dd9\u0db1 2.6\u0dc2\u0dcf. \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2 \u0dd9\u0dc2\u0dcf \u0dc0 \u0dc3\u0dd9\u0db1\u0dca \u0db1\u0dad\u0dca\u0dc3 \u0dcf\u0dad\u0dca, \u0d9a\u0dcf\u0db1\u0dca \u0dcf \u200d\u0dbb\u0db8 \u0db6\u0dbd\u0d9a\u0dcf\u0dd9 \u0dc3\u0dd2\u0dd9\u0dd9\u0da7 34\u0dc2\u0dcf \u0dc0\u0dcf\u0dc3\u0dda \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dd9\u0dc2\u0dcf \u0dad\u0dd2\u0dc3\u0db6\u0db1\u0dca\u0dc3\u0db1\u0dca. \u0dc3\u0db8\u0dc3\u0dca \u0da2\u0db1\u0db1\u0dc4\u0db1\u0dd9 \u0db1\u0dad\u0dca\u0dc3 \u0dcf\u0dad\u0dca, \u0d9a\u0dcf\u0db1\u0dca \u0dcf \u200d\u0dbb\u0db8 \u0db6\u0dbd\u0d9a\u0dcf\u0dd9 \u0db8\u0dd4\u0dd4\u0dbd \u0da2\u0db1\u0db1\u0dc4\u0db1\u0dc3\u0dd9\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba 12.5\u0dc2\u0dcf \u0dc0\u0dd2 \u0dbb \u0dad\u0dd2\u0dc3\u0db6\u0db1\u0dca\u0dc3\u0db1\u0dca."
  },
