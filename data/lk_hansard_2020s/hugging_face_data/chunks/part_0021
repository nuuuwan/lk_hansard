u0dc3\u0dd3\u0db8\u0dcf\u0dd9 \u0dd9\u0daf\u0dbb\u0dca\u0dbd\u0daf;\n\n\u0dba\u0db1\u0dca\u0db1 \u0d91\u0dad\u0dd4\u0db8\u0dd2\u0dba \u0daf\u0db8\u0db8 \u0dc3\u0db7\u0dcf\u0dd9\u0da7 \u0daf\u0db1\u0dca\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca\u0daf\n\n(\u0dca (i) \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0db1\u0dd2\u0dbd \u0dba\u0dcf\u0dba \u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0dd9 \u0dad\u0dd2\u0db6\u0dd6 \u0db8\u0dcf \u0d89\u0db1\u0dca\u0db0\u0db1\u0db1 \u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0daf\u0dd9\u0db1\u0dca \u0daf\u0dd9\u0db1\u0dca \u0dd9\u0dc1\u0daf\u0dba\u0db1\u0dca \u0daf \u0dcf\u0db4\u0db8\u0dab\u0daf;\n\n(ii) \u0d85\u0daf\u0dcf \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dd9\u0dba\u0dba\u0dcf \u0db1\u0dd2\u0dd4\u0dab\u0dad\u0dcf \u0dc3\u0dcf\u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0db1 \u0dc4\u0dcf \u0dd9\u0dd8\u0dad\u0dca\u0dad\u0dd3\u0dba \u0dd4\u0dc4\u0dd4\u0dab\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dba \u0db0\u0dd4\u0dba\u0dba \u0daf\u0dba\u0db1 \u0dbd\u0daf \u0dcf\u0dbd \u0dc3\u0dd3\u0db8\u0dcf\u0daf \u0da2, \u0d91\u0db8 \u0db1\u0dd2\u0dbd \u0dba\u0dcf \u0daf\u0dd9\u0dd4\u0dc0\u0daf\u0dd9\u0db1\u0dca \u0db8\u0dcf \u0dd9 \u0dd9\u0dd0\u0dba \u0dba\u0db1 \u0dbd\u0daf \u0d89\u0db1\u0dca\u0db0\u0db1\u0db1 \u0dd3\u0da7\u0dbb\u0dca\u0dbd \u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dc4 \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0daf\u0dba\u0db1 \u0dbd\u0daf \u0dc0\u0dd2\u0dba\u0daf\u0db8, \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0db1\u0dd2\u0dbd \u0dba\u0dcf\u0dba \u0d85\u0dd4\u0dc0\u0dd9 \u0daf\u0dd9\u0db1\u0dca \u0daf\u0dd9\u0db1\u0dca \u0dd9\u0dc1\u0daf\u0dba\u0db1\u0dca \u0daf \u0dcf\u0db4\u0db8\u0dab\u0daf;\n\n\u0dba\u0db1\u0dca\u0db1\u0dad\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dd2\u0dba \u0daf\u0db8\u0db8 \u0dc3\u0db7\u0dcf\u0dd9\u0da7 \u0daf\u0db1\u0dca\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca\u0daf\n\n(\u0dc3 \u0daf\u0db1\u0dcf\u0d91\u0daf\u0dc3\u0dae \u0db1\u0dda, \u0d92 \u0db8\u0db1\u0dca\u0daf\n\n\u0baa\u0bbf\u0bb0\u0ba4\u0bae \u0b85\u0bae\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bc1\u0bae\u0bcd \u0b95\u0bb2\u0bcd\u0bb5\u0bbf, \u0b89\u0baf\u0bb0\u0bcd \u0b95\u0bb2\u0bcd\u0bb5\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0ba4\u0bbe\u0bb4\u0bbf\u0bb1\u0bcd\u0b95\u0bb2\u0bcd\u0bb5\u0bbf \u0b85\u0bae\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bc1\u0bae\u0bbe\u0ba9\u0bb5\u0bae\u0bb0\u0b95\u0bcd \u0b9a\u0b95\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0ba9\u0bbe:\n\n( \u0b85) (i ) \u0b8e\u0b9f\u0bcd\u0b9f\u0bbe\u0bb5\u0ba4\u0bc1 \u0baa\u0bbe\u0bb0\u0bbe\u0bb3\u0bc1\u0bae\u0ba9\u0bcd\u0bb1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd 2018 \u0ba8\u0bb5\u0bae\u0bcd\u0baa\u0bb0\u0bcd 01\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0ba8\u0bbf\u0baf\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0bbf\u0bb1\u0ba9\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bbe\u0bb4\u0bcd\u0b95\u0bcd\u0bae\u0b95\u0ba4\u0bcd \u0b9a\u0ba4\u0bbe\u0bb4\u0bbf\u0bb1\u0bcd\u0baa\u0baf\u0bbf\u0bb1\u0bcd\u0b9a\u0bbf \u0b85\u0bae\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1, \u0b85\u0baa\u0bcd\u0b9a\u0baa\u0bbe\u0bae\u0ba4\u0baf \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0baf\u0bbe\u0b95\u0baa\u0bc2\u0bb0\u0bcd\u0bb5 \u0bb5\u0bbe\u0b95\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd\u0bae\u0b95 \u0b8e\u0ba4\u0bcd\u0ba4\u0bae\u0ba9 \u0b8e\u0ba9\u0bcd\u0baa\u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;"
