    "chunk_text": "\u0db8\u0db8 \u0db4\u0dc5\u0dc3\u0dca \u0dc0\u0db1\u0dca\u0dad\u0db8 \u0da2 \u0dbb \u0da7\u0dca \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dcf \u0da7 \u0dc3\u0dd4\u0db6 \u0dcf\u0dc0 \u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dca\u0d9a\u0dba \u0dda\u0dc0 \u0d9a\u0dd2\u0dba\u0dbd \u0db4\u0dca\u200d\u0dbb \u0dbb\u0dca\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dcf \u0d9a\u0dd0\u0db8\u0dd0\u0dd2\u0dba\u0dd2. \u0da2 \u0dc0\u0dd2\u0dc0 \u0dba\u0da7 \u0d85 \u0d8b \u0dda \u0db8\u0db3\u0db1\u0dca\u0dad \u0d87\u0dab \u0da2\u0d9a\u0db1\u0dca\u0dad \u0dcf \u0d9a \u0da7 \u0d85\u0db4\u0da7 \u0dc4\u0dbb\u0dd2 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dad\u0dd4\u0da7\u0d9a\u0dca\u0d9a\u0dba \u0dd0 \u0dcf\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad. \u0db8 \u0d9a , Port City \u0d91\u0d9a \u0db1\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d \u0dc3\u0dd3\u0d9c\u0dd2\u0dbb\u0dd2\u0dba\u0dad\u0dca \u0d9a\u0da9\u0db1\u0dca\u0dad\u0dcf \u0dc0\u0dcf\u0dc0 \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0d85\u0dba, Port City \u0d91 \u0d9a\u0dca\u0d9a\u0dba concessions \u0db4\u0dcf\u0d9a \u0d86 \u0dba\u0ddd\u0dad\u0d9a\u0dba\u0db1\u0dca\u0dad\u0da7 \u0dcf \u0d9a \u0da7 \u0d9c\u0dad \u0db8\u0dd2\u0dad\u0dd4\u0dbb\u0db1\u0dca\u0dad\u0da7 \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf \u0dcf\u0dc0 \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0d85\u0dba \u0d85 \u0d8b \u0dda \u0db8\u0db3\u0db1\u0dca\u0dad Port City \u0d91 \u0d9a\u0dca\u0d9a\u0dba \u0dab \u0daf \u0dc0\u0dba\u0dcf \u0d9a \u0da7, \u0dc0\u0dc0 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0d9a\u0dbb 3\u0d9a\u0da7 \u0d92 \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf extend \u0d9a\u0dc5 \u0d9a\u0dd2\u0dba\u0dcf \u0d9a \u0da7, \u0d85 \u0db1\u0dca\u0dad \u0d92 \u0d9a\u0db4\u0dcf\u0db1\u0dca\u0dad \u0d9a\u0dae \u0d9a\u0dbb\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0dbd \u0d85 \u0d85\u0db4\u0da7 \u0da2 \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0dc0\u0db1\u0dca\u0dad \u0d85\u0dc4\u0db1\u0dca\u0dad\u0dcf \u0dc0\u0dcf\u0dc0 . \u0db8 \u0d9a , \u0dc3\u0dd3\u0d9c\u0dd2\u0dbb\u0dd2\u0dba \u0db4\u0dc0 \u0d9a\u0da9\u0db1\u0dca\u0dad\u0dcf \u0dc0\u0dcf\u0dc0 \u0d9a\u0dd2\u0dda\u0dc0 , Port City \u0d91\u0d9a \u0dc4\u0dd0\u0d9a\u0dbb \u0dc0 \u0dad\u0dca. \u0d92\u0d9a\u0da7 \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf \u0daf\u0dd3\u0dbd \u0d86 \u0dba\u0ddd\u0dad\u0d9a\u0dba\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad\u0dcf \u0dc4\u0dd0\u0d9a\u0dbb\u0dc0 \u0db8 \u0d9a\u0dd2\u0dda\u0dc0 , \u0d92\u0dc0 \u0d9c\u0dad \u0db8\u0dd2\u0dad\u0dd4\u0dbb\u0db1\u0dca\u0dad\u0da7 \u0db1\u0dca\u0dad\u0dcf \u0dba\u0dcf \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf \u0d9a\u0dd2\u0dba\u0dbd . \u0d92 \u0dc0 \u0db8 \u0d9a\u0dd2\u0dda\u0dc0 , \u0d92\u0d9a \u0da0\u0dd3\u0dcf \u0d9a \u0dbd\u0db1\u0dd2\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dc0\u0dcf\u0dc0 \u0d9a\u0dd2\u0dba\u0dbd . \u0d92\u0d9a \u0d87\u0dad\u0dd4\u0dc5\u0da7 \u0dba\u0db1\u0dca\u0dad\u0dcf passport \u0d91\u0d9a\u0d9a\u0dca\u0d9a\u0dba \u0d85\u0dbb\u0d9c\u0db1\u0dca\u0dad\u0dcf \u0dc0\u0dcf\u0dc0 \u0d9a\u0dd2\u0dda\u0dc0 . \u0d92\u0d9a\u0da7 \u0d8b\u0da9\u0dd2\u0db1\u0dca\u0dad \u0d9a \u0d9a\u0dca\u0d9a\u0dba \u0d9a \u0da7 \u0dba\u0db1\u0dca\u0dad\u0dcf\u0dad\u0dca \u0d85\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95\u0dcf\u0dd9 \u0d9a\u0dd2\u0dda\u0dc0 . \u0d91 \u0dc4\u0db8 \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0d85\u0dba Port City \u0d91\u0d9a\u0da7 \u0dcf \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf \u0d9c\u0dd0\u0dcf \u0dab \u0daf \u0dc0\u0dba\u0dcf \u0d9a \u0da7, Port City \u0d91\u0d9a \u0d9c\u0dd0\u0dcf \u0dab \u0daf \u0dc0\u0dba\u0dcf \u0d9a \u0da7 \u0d85\u0db4\u0da7 \u0db8\u0dd2\u0db1\u0dca\u0dad \u0d85\u0dc4 \u0d9c\u0dcf \u0db8\u0db1\u0dca\u0dad\u0dcf \u0db4\u0dcf\u0d9a\u0d9a\u0dca\u0d9a\u0dba \u0dc3\u0dca\u0dad\u0dca\u200d\u0dad\u0dd4\u0da7\u0dd4\u0dba\u0dd2.\n\n\u0db8 \u0d9a\u0d9a\u0dca\u0d9a\u0dba \u0d9a \u0dc5\u0dbb? \u0daf\u0dd2\u0dcf 42 \u0d85\u0da9\u0dd4 \u0d9a\u0dbb\u0dcf\u0dc0 , \u0dc3\u0dca\u0dad\u0dca\u200d\u0dd2 \u0dad\u0dd4\u0dcf\u0da7. \u0daf\u0dd2\u0dcf 21\u0da7 \u0d85\u0da9\u0dd4 \u0d9a\u0dbb\u0dbd \u0da7\u0db1\u0dca\u0dad\u0da9\u0dbb\u0dca \u0d91\u0d9a \u0dcf\u0dc0 . \u0d8a\u0da7 \u0db4\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dd0\u0db4\u0dba\u0dd4 \u0da2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0d85\u0db8 \u0dc0\u0dba \u0d82\u0dc1\u0dba\u0da7 \u0dca\u0d9b\u0dd2\u0dc0\u0dc0 \u0d91\u0dc0\u0dcf\u0dc0 , \u0db4\u0db4\u0d85\u0db4\u0da7 \u0dda\u0dbd \u0dc0 \u0db8\u0daf\u0dd2\u0db4\u0db4 \u0d9a\u0dd2\u0dba\u0dbd . \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d91 \u0dc4\u0db8 \u0dd2 \u0db6\u0dda\u0daf\u0dd3, \u0dc0\u0dc0 \u0d91\u0d9a \u0dc3\u0dca\u0dad\u0dca\u200d\u0dd2\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dc0\u0dd2\u0dc0\u0dbb\u0d9a\u0dca\u0d9a\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb\u0dbd \u0da7\u0db1\u0dca\u0dad\u0da9\u0dbb\u0dba \u0d9a\u0dd0\u0db3\u0dc0\u0dcf\u0dc0 . \u0db4\u0db4\u0db8\u0dc0 \u0db8 \u0dc4\u0daf\u0dd2\u0dc3\u0dd2\u0dba\u0dd2, \u0dc3\u0dca\u0dad\u0dca\u200d\u0dd2 \u0dad\u0dd4\u0dcf\u0dba\u0dd2 \u0db1\u0dca\u0dad \u0db1\u0dca\u0dad\u0db4\u0db4 \u0d9a\u0dd2\u0dba\u0dbd . \u0d91 \u0dc4\u0db8 \u0dc0\u0db8\u0dba\u0dd2 \u0da7\u0db1\u0dca\u0dad\u0da9\u0dbb\u0dba \u0d9a\u0dd0 \u0db3\u0dda \u0dda. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0db8 \u0d9a\u0d9a\u0dca\u0d9a\u0dba \u0dc0\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad? \u0dc3\u0dca\u0dad\u0dca\u200d\u0dd0\u0dda\u0dc0\u0dd0 \u0da2\u0db6\u0dbb\u0dca \u0db8 \u0dc3\u0dca\u0dad\u0dca\u200d \u0db8 \u0dc0\u0dc4\u0db4\u0dd4 \u0da7\u0db1\u0dca\u0dad\u0da9\u0dbb\u0dba\u0da7"
  },
