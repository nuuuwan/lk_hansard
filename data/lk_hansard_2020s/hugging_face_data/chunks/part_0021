    "chunk_text": "\u0b87\u0ba8\u0bcd\u0ba4\u0b9a\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0bc8\u0b9f\u0bcd\u0b9f\u0b95\u0bcd\u0b95\u0bb3\u0baa\u0bcd\u0baa\u0bc1 \u0bc8\u0bc6\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bc6\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0baa\u0bc1\u0bae\u0b95\u0baf\u0bbf\u0bb0\u0ba4\u0baa\u0bcd \u0bb2\u0baa\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1\u0b9a\u0bcd \u0bb2\u0b9a\u0bae\u0bb5 \u0ba4\u0ba4\u0bc6\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bc6\u0bbe\u0b95\u0b9a\u0bcd \u0b9a\u0bbf\u0bb2 \u0bb5\u0bbf\u0b9f\u0baf\u0b99\u0bcd\u0b95\u0bae\u0bb3\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bb2\u0bc6\u0bbe\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba8\u0bbf\u0bae\u0ba9\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb2\u0bb1\u0ba9\u0bcd. \u0bc8\u0b9f\u0bcd\u0b9f\u0b95\u0bcd\u0b95\u0bb3\u0baa\u0bcd\u0baa\u0bbf\u0bb2\u0bcd \u2018\u0baa\u0bc6\u0bbe\u0b9f\u0bc1\u0bae\u0bcd \u0bc8\u0bc0\u0ba9\u0bcd\u2019 \u0b8e\u0ba9\u0bcd\u0bb1 \u0ba4\u0baa\u0baf\u0bc6\u0bbe\u0bbf\u0bb2\u0bcd \u0baa\u0bc1\u0bae\u0b95\u0baf\u0bbf\u0bb0\u0ba4\u0baa\u0bcd \u0bb2\u0baa\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1\u0b9a\u0bcd \u0bb2\u0b9a\u0bae\u0bb5 \u0b95\u0bc6\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. \u0b87\u0ba8\u0bcd\u0ba4\u0baa\u0bcd \u0bb2\u0baa\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1\u0b9a\u0bcd \u0bb2\u0b9a\u0bae\u0bb5\u0baf\u0bbf\u0bb2\u0bcd \u0b86\u0bb0\u0bae\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd 600 \u0baa\u0baf\u0ba3\u0bbf\u0b95\u0bb3\u0bcd \u0baa\u0baf\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0b95\u0bcd\u0b95\u0ba4\u0bc6\u0bbe\u0b95 Romanian \u0bb5\u0bae\u0b95\u0bae\u0baf\u0b9a\u0bcd \u0bb2\u0b9a\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0baa\u0bc1\u0bae\u0b95\u0baf\u0bbf\u0bb0\u0ba4\u0bae\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0ba8\u0bcd\u0ba4\u0ba4\u0bc1. \u0bc8\u0b9f\u0bcd\u0b9f\u0b95\u0bcd\u0b95\u0bb3\u0baa\u0bcd\u0baa\u0bc1 \u0baa\u0bc1\u0bae\u0b95\u0baf\u0bbf\u0bb0\u0ba4 \u0ba8\u0bbf\u0bae\u0bb2\u0baf\u0bae\u0bcd \u0ba4\u0bbf\u0ba9\u0bae\u0bc1\u0bae\u0bcd \u0b95\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f 1,000,000 - \u0b92\u0bb0\u0bc1 \u0bc8\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd - \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0bae\u0baf \u0b88\u0b9f\u0bcd\u0b9f\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0bb5\u0bbf\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0ba8\u0bcd\u0ba4\u0b9a\u0bcd \u0bb2\u0b9a\u0bae\u0bb5 \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0ba4\u0bc1. \u0b85\u0ba4\u0ba9\u0bcd\u0baa\u0bbf\u0bb1\u0b95\u0bc1, \u0baa\u0bc1\u0bae\u0b95\u0baf\u0bbf\u0bb0\u0ba4\u0baa\u0bcd \u0bb2\u0baa\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1\u0b9a\u0bcd \u0bb2\u0b9a\u0bae\u0bb5\u0baf\u0bbf\u0bb2\u0bcd \u0bc8\u0bc6\u0bbe\u0bb1\u0bcd\u0bb1\u0ba4\u0bcd\u0bae\u0ba4 \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf, \u0b87\u0baa\u0bcd\u0bb2\u0baa\u0bc6\u0bbe\u0ba4\u0bc1 powerset \u0bb0\u0b95 \u0baa\u0bc1\u0bae\u0b95\u0baf\u0bbf\u0bb0\u0ba4 \u0bb2\u0b9a\u0bae\u0bb5 \u0ba8\u0bae\u0b9f\u0ba4\u0baa\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd \u0ba4\u0b95\u0bc6\u0bbe\u0ba3\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b87\u0ba8\u0bcd\u0ba4\u0baa\u0bcd \u0baa\u0bc1\u0bae\u0b95\u0baf\u0bbf\u0bb0\u0ba4\u0baa\u0bcd \u0bb2\u0baa\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1\u0b9a\u0bcd \u0bb2\u0b9a\u0bae\u0bb5\u0baf\u0bbf\u0bb2\u0bcd \u0baa\u0baf\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd\u0bae\u0b95 \u0b87\u0baa\u0bcd\u0bb2\u0baa\u0bc6\u0bbe\u0ba4\u0bc1 \u0b95\u0bc1\u0bae\u0bb1\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. \u0b8f\u0ba4\u0ba9\u0ba9\u0bcd\u0bb1\u0bc6\u0bbe\u0bb2\u0bcd, \u0ba8\u0bc6\u0bbe\u0ba9\u0bcd \u0b86\u0bb0\u0bae\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0ba4\u0b9a\u0bc6\u0bbe\u0ba9\u0bcd\u0ba9 Romanian \u0bb5\u0bae\u0b95 \u0baa\u0bc1\u0bae\u0b95\u0baf\u0bbf\u0bb0\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd 10 \u0ba4\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0b95\u0bb3\u0bcd \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bae\u0bc8\u0baf\u0bc6\u0bbe\u0bb2\u0bcd 600 \u0baa\u0baf\u0ba3\u0bbf\u0b95\u0bb3\u0bcd \u0baa\u0baf\u0ba3\u0bbf\u0ba4\u0bcd\u0ba4\u0ba9\u0bb0\u0bcd. \u0baa\u0bc1\u0bae\u0b95\u0baf\u0bbf\u0bb0\u0ba4 \u0ba8\u0bbf\u0bae\u0bb2\u0baf \u0b86\u0b9a\u0ba9 \u0bae\u0bc1\u0ba9\u0bcd\u0baa\u0ba4\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd\u0bae\u0bc2\u0bb2\u0bc8\u0bc6\u0bbe\u0b95 \u0b92\u0bb0\u0bc1 \u0ba8\u0bc6\u0bbe\u0bae\u0bb3\u0b95\u0bcd\u0b95\u0bc1 500,000 \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd \u0bb5\u0bae\u0bb0 \u0bb5\u0bb0\u0bc1\u0bb5\u0bc6\u0bbe\u0baf\u0bcd \u0b88\u0b9f\u0bcd\u0b9f\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0ba8\u0bbf\u0bae\u0bb2 \u0b95\u0bc6\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. \u0b85\u0ba4\u0bc1 \u0bc8\u0b9f\u0bcd\u0b9f\u0bc1\u0bc8\u0bb2\u0bcd\u0bb2\u0bc6\u0bbe\u0bc8\u0bb2\u0bcd, \u0b9a\u0bbf\u0bb1\u0bcd\u0bb1\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf\u0b9a\u0bcd\u0b9a\u0bc6\u0bbe\u0bae\u0bb2 \u0bb5\u0b9a\u0ba4\u0bbf \u0b85\u0bb2\u0ba4\u0bb2\u0baa\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba4\u0baa\u0bc6\u0bbe\u0ba4\u0bbf\u0b95\u0bae\u0bb3\u0b95\u0bcd \u0ba4\u0b95\u0bc6\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0b9a\u0bb2\u0bcd\u0bb2\u0bc1\u0bae\u0bcd \u0bb2\u0b9a\u0bae\u0bb5, \u0ba4\u0baa\u0bc6\u0bbe\u0bb2\u0bcd \u0bb2\u0b9a\u0bae\u0bb5 \u0b8e\u0ba9\u0bcd\u0baa\u0ba9\u0bb5\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bc6\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n513 514\n\n[\u0dd0\u0dbb\u0dd4 \u0dc3\u0dd4\u0dd2\u0dba\u0dbd\u0dca \u0dab\u0dad\u0dd3\u0dba\u0db1\u0dc3\u0dd2\u0dd2\u0db4 \u0dad\u0db3\u0dca\u200d\u0dcf]\n\n2026 \u0dca\u200d\u0db1\u0dc0\u0dcf\u0dd2\u0db4 08\n\n\u0b87\u0ba4\u0bbf\u0bb2\u0bcd \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0ba4\u0bc8\u0bc6\u0bbe\u0bb0\u0bc1 \u0baa\u0bbf\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0bae\u0ba9 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b85\u0ba4\u0bc6\u0bbe\u0bb5\u0ba4\u0bc1, \u0b87\u0baa\u0bcd\u0ba4\u0baa\u0bc6\u0bbe\u0bb4\u0bc1\u0ba4\u0bc1 \u0bc8\u0b9f\u0bcd\u0b9f\u0b95\u0bcd\u0b95\u0bb3\u0baa\u0bcd\u0baa\u0bc1 - \u0ba4\u0b95\u0bc6\u0bbe\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1 \u0baa\u0bc1\u0bae\u0b95\u0baf\u0bbf\u0bb0\u0ba4 \u0bb2\u0b9a\u0bae\u0bb5\u0baf\u0bc6\u0bbe\u0ba9\u0ba4\u0bc1 \u0bb2\u0ba8\u0bb0\u0b9f\u0bbf\u0baf\u0bc6\u0bbe\u0b95 \u0b87\u0bb2\u0bcd\u0bb2\u0bc6\u0bbe\u0bc8\u0bb2\u0bcd, \u0ba4\u0bbf\u0bb0\u0bc1\u0bb2\u0b95\u0bc6\u0bbe\u0ba3\u0bc8\u0bae\u0bb2\u0b95\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0ba4\u0b9a\u0ba9\u0bcd\u0bb1\u0bc1 \u0b85\u0b99\u0bcd\u0b95\u0bc1 \u0bc8\u0bc6\u0bbe\u0bb1\u0bcd\u0bb1\u0bc0\u0b9f\u0bc1 \u0ba4\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bc1 \u0baa\u0bc1\u0bae\u0b95\u0baf\u0bbf\u0bb0\u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bc6\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0baf\u0ba3\u0bae\u0bcd \u0ba4\u0b9a\u0baf\u0bcd\u0baf \u0bb2\u0bb5\u0ba3\u0bcd\u0b9f\u0bbf\u0baf \u0b95\u0bc6\u0bbe\u0bb0\u0ba3\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb2\u0bcd, 350 \u0bb2\u0baa\u0bb0\u0bcd \u0baa\u0baf\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0baa\u0bc1\u0bae\u0b95\u0baf\u0bbf\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bc8\u0bbf\u0b95\u0b95\u0bcd \u0b95\u0bc1\u0bae\u0bb1\u0bb5\u0bc6\u0bbe\u0ba9 \u0baa\u0baf\u0ba3\u0bbf\u0b95\u0bb2\u0bb3 \u0baa\u0baf\u0ba3\u0bae\u0bcd \u0ba4\u0b9a\u0baf\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0ba8\u0bbf\u0bae\u0bb2 \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0ba8\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0bb5\u0bb0\u0bc1\u0bb5\u0bc6\u0bbe\u0bae\u0baf \u0b85\u0ba4\u0bbf\u0b95\u0bc6\u0bbe\u0bbf\u0b95\u0bcd\u0b95 \u0bb2\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bc8\u0ba9 \u0ba8\u0bbf\u0bae\u0ba9\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b87\u0ba8\u0bcd\u0ba4 \u0b85\u0bb0\u0b9a\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd, \u0ba8\u0bbf\u0b9a\u0bcd\u0b9a\u0baf\u0bc8\u0bc6\u0bbe\u0b95 \u0b8f\u0bb1\u0bcd\u0ba4\u0b95\u0ba9\u0bb2\u0bb5 \u0bb2\u0b9a\u0bae\u0bb5\u0baf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4 \u0baa\u0bc1\u0bae\u0b95\u0baf\u0bbf\u0bb0\u0ba4 \u0bb2\u0b9a\u0bae\u0bb5\u0bae\u0baf\u0b95\u0bcd \u0ba4\u0b95\u0bc6\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0 \u0bb2\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd."
  },
