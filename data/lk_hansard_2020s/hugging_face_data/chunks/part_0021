    "chunk_size_bytes": 2227,
    "chunk_text": "\u0db8\u0db8\u0dcf\u0dd0\u0db1\u0daf\u0dd3 \u0db8\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0dad\u0dd2\u0db8\u0db6\u0db1\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db8\u0dda\u0d9a\u0dba\u0dd21 \u0db8\u0db8\u0dda \u0dbb\u0db8\u0dda \u0d9a\u0db1\u0dca\u0dad\u0db1\u0db1\u0dca\u0dad\u0dbb\u0dbb \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db4\u0dcf\u0dc3\u0db8\u0dca; \u0d9a\u0db1\u0dca\u0dad\u0db1\u0db1\u0dca\u0dad\u0dbb\u0dbb \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0db8\u0dcf\u0dcf\u0dba\u0db1\u0dca\u0dad\u0db8\u0dda \u0dc3\u0d9c\u0d9a\u0dca\u0db4\u0dba \u0db6\u0db1\u0dd4\u0dc0 \u0d86\u0dbb\u0dda \u0d9a\u0dbb\u0db4\u0dd4 \u0db4\u0dd9\u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd2 \u0db8\u0db0 \u200d \u0db8\u0dc4\u0dcf \u0dd2\u0dc3:\u200d\u0dcf\u0dbd\u0dba\u0da7 \u0d9c\u0dd2\u0dba \u0dc4\u0dcf\u0dbb\u0db8:\u0db8\u0db1\u0d9a\u0dca\u0dc2 \u0dbd\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf, \u0db8\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dda1 \u0db8\u0db8 \u0dbd\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf, \u0db6\u0db8\u0db4\u0dca \u0db1\u0dd2\u0db1\u0dca\u0dad: \u0da2\u0dba\u0dad\u0dd2\u0dc3\u0dda\u0dc3 \u0d87\u0db8\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0dbd\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf, \u0dc3\u0dd4\u0db1\u0dd2\u0dca \u0dc0\u0da7\u0dbb\u0dbd \u0db1\u0dd2\u0db8\u0dba\u0ddd\u0da2\u200d \u0d87\u0db8\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0dbd\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf, \u0db6\u0db8\u0db4\u0dca :\u0dda\u0dd2\u0dba\u0d9a \u0db4\u0da7\u0db6\u0db1\u0dd0\u0db3\u0dd2 \u0d87\u0db8\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0dbd\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf1 \u0d91\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dcf \"\u0db6\" \u0dba\u0db1\u0dca\u0dad\u0db1 \"\u0d86\" \u0dba\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dda\u0db8\u0dda \u0d92 \u0db4\u0dcf\u0dc3\u0db8\u0dbd\u0db1\u0dca\u0dad1\n\n\u0db8\u0dc4\u0dcf\u0dbb \u0dbb\u0dc4\u0db8\u0dc3\u0dda \u0dbd\u0db1\u0dca\u0dad\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0dad\u0dca \u0d91\u0d9a\u0dca\u0dc2\u0d9a \u0d9c\u0dd2\u0dd2\u0dc3\u0dc3\u0dd4\u0dda \u0dbb\u0dd0\u0dc4\u0dd4\u0dc0\u0dcf1 \u0d9c\u0dd2\u0dd2\u0dc3\u0dc3\u0dd4\u0dda \u0dbb\u0dc4\u0dbd\u0dcf :\u0dd0\u0db1\u0dca\u0dad \u0dba\u0dd4\u0db8\u0dbb\u0ddd\u0db4\u0dd3\u0dba \u0db8\u0db6\u0db1\u0db8\u0dc4\u0dad\u0dca \u0d94\u0d9a\u0dca\u0dc2\u0db8\u0d9a\u0ddd\u0db8 \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad1 \u0db8\u0dda\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0dbd\u0db1\u0dca\u0dad\u0daf\u0dd2\u0dba\u0dcf\u0db8\u0dda \u0db8\u0db6\u0db1\u0db8\u0dc4\u0dad\u0dca; \u0db6\u0db1\u0dcf\u0dbd \u0db8\u0db6\u0db1\u0db8\u0dc4\u0dad\u0dca; \u0db6\u0dca \u0dd2\u0dba\u0dbd \u0db8\u0db6\u0db1\u0db8\u0dc4\u0dad\u0dca1 :\u0dd0\u0db1\u0dca\u0dad \u0db8\u0dd4:\u0dca \u0dad\u0dd2\u0db8\u0db6\u0db1\u0db1 \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4 \u0dc4\u0dd2\u0daf \u0db8\u0d9a\u0db8\u0db1\u0d9a\u0dca\u0dc2 \u0dc0\u0dd4\u0dba\u0dad\u0dca \u0db8\u0db4\u0dde \u0dbb\u0dd2\u0d9a \u0db8\u0dbb\u0ddd\u0dc4\u0dca\u0dc0\u0dbd\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dcf\u0dbb \u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d9c\u0dd2\u0db8\u0dba\u0dcf\u0dad\u0dca \u0db8\u0db8\u0dcf\u0d9a: \u0db8\u0dc0\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0dbb\u0dc4\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db6\u0dbb \u0d91\u0db1\u0dca\u0dad\u0db1\u0dcf\u0db8 \u0dcf\u0db8\u0dba\u0dd21 \"\u0db8\u0dbb\u0dd4\u0dc0\u0dcf \u0dc3\u0db8\u0db8 \u0dc0\u0dcf\u0db8\u0dc3\u0dda\" \u0dc0\u0dcf\u0db8\u0dda \u0dcf\u0db8\u0dba\u0dd21 \u0db8\u0db8\u0db1\u0dca\u0dad\u0db1 \u0db8\u0dda\u0d9a\u0dad\u0dca \u0dc0\u200d\u0dc3\u0db1 \u0dcf\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca\u0dc2 \u0dd2\u0dc3\u0db0\u0dd2\u0dba\u0da7 \u0dc3\u0dbd\u0d9a\u0dcf \u0db8\u0dda\n\n\u0dc3\u0dda\u0db6\u0db1\u0db1\u0dca\u0dad\u0db0 \u0db8\u0dba\u0db1\u0dca\u0dad: \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8\u0db8 \u0dbd\u0dca\u0dbd\u0dcf \u0dd2\u0d82\u0dd2\u0db1\u0dc0\u0dcf1 \u0db8\u0dda\u0d9a \u0db8\u0db8 \u0dc0\u0dbb\u0d9a\u0dd3\u0db8\u0db8\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0db1 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dba\u0dd3\u0dba\u0dba\u0d9a\u0dca\u0dc21 \u0db8\u0db8\u0dcf\u0d9a:, \u0db8\u0dda\u0dc0\u0dcf \u0db8\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0db8:\u0db1\u0dca\u0dad\u0db1 \u0db6\u0db1\u0dd0\u0dc4\u0dd01"
