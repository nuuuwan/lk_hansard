    "chunk_text": "\u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0d9c\u0dc1\u0dda\u0dc2\u0dca\u0da8\u0d9c\u0dba\u0db1\u0dca\u0dad\u0db8 \u0db8\u0dad\u0d9a \u0dad\u0db6\u0dcf \u0d9c\u0dad \u0dd4\u0dad\u0dad\u0dd4 \u0d9a\u0dcf\u0dba\u0da7\u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0dad\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0db4 \u0d9a \u0dba\u0db4\u0db4 \u0d9c\u0dda \u0dc0\u0dcf\u0d9c\u0dda \u0dc0\u0dba\u0dc3\u0db1\u0dba\u0d9a\u0dca \u0dca\u0d9c\u0dc0\u0dcf \u0d9a \u0d9c\u0db8\u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dba\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0dbb\u0dd3\u0dba \u0dcf \u0dc3\u0dd4 \u0dd4\u0dc3\u0dda\u0db8\u0d9a\u0dca \u0dc4\u0daf \u0dcf, \u0d92 \u0dc3\u0dd4 \u0dd4\u0dc3\u0dda\u0db8 \u0dad\u0daf\u0dd2\u0dbb\u0dd2\u0db4 \u0d9a \u0d9a\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d9c\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9c\u0dda\u0db1\u0dca\u0dad\u0dad\u0dd4\u0dc0\u0db4. \u0d92\u0d9a\u0dba\u0dd2 \u0dad\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dad \u0dcf\u0d9c\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8. \u0dc4\u0dd4\u0db6\u0dd4\u0dba\u0dd2, \u0d92 \u0d9c\u0dc0\u0db1\u0dd4\u0dc0\u0db4 \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0 \u0dc4\u0dd1\u0dbd\u0dca\u0dbd\u0dd4 \u0d9a\u0dba\u0db1\u0dc0\u0dcf. \u0da7\u0dc5\u0d9f\u0db4, \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dbb\u0dd4 \u0dc4\u0dd1\u0dbd\u0dca\u0dbd\u0dd4 \u0d9a\u0dba\u0db1\u0dc0\u0dcf. \u0dc3\u0db8\u0dc4\u0dba \u0d9c\u0dc0 \u0dcf\u0dc0\u0db4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad\u0d9c\u0dda \u0d9c\u0db4 \u0dda\u0d9c\u0dd2\u0d9a \u0d9c\u0dda\u0dc0\u0dbd\u0dca \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0db1\u0dc0\u0dcf. \u0d92\u0d9a\u0daf \u0dad\u0db8\u0dd4\u0db1\u0dca\u0dad\u0db1\u0dcf\u0db1\u0dca\u0dad\u0d9c\u0dc3\u0dda \u0dcf\u0d9c\u0dda \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba? \u0d92\u0d9a \u0d9c\u0db1\u0dcf\u0d9c\u0dc0\u0dba\u0dd2 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0dad\u0db1\u0dcf\u0db1\u0dca\u0dad\u0d9c\u0dc3\u0dda \u0dcf \u0db8\u0dad\u0d9a \u0dad\u0dd2\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0dad\u0db1, \u0d9c\u0dda \u0dc0\u0dcf\u0d9c\u0dda \u0dca\u0db4\u0daf\u0dcf\u0dc0 \u0da2 \u0d85\u0db4\u0dd2 \u0d95\u0db1\u0dd1 \u0d9c\u0dc0 \u0dcf\u0dc0\u0d9a\n\n1147 1148\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9c\u0dda\u0db1\u0dca\u0dad\u0dad\u0dd4\u0dc0\n\n\u0daf\u0dd4\u0db1\u0dca\u0dad \u0db6 \u0db1\u0dca\u0dad\u0db1, \u0db4\u0dcf\u0dc3\u0dda\u0d9a\u0dd4 \u0dad\u0dbb\u0dd4 \u0daf\u0dd2\u0db1 \u200d\u0dbb\u0dc4\u0dcf\u0dba\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0daf \u0d9a\u0dcf\u0dba\u0da7\u0dba. \u0dc3\u0dcf\u0dba\u0dcf \u0da2\u0dcf\u0dc3\u0dda\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dad\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf \u0dbb\u0dd3 \u0dc0\u0dcf. \u0daf\u0dd4\u0db1\u0dca\u0dad \u0dc3\u0dcf\u0dba\u0dcf \u0da2\u0dcf\u0dc3\u0dda\u0db8\u0dd2\u0db1\u0dca\u0dad \u0d85\u0dbd\u0dca \u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dd4\u0dda\u0daf? \u0db8\u0dc4 \u0d9c\u0db8\u0dcf\u0dc5\u0d9a\u0dbb\u0dd4 \u0d85\u0dbd\u0dca \u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dd4\u0dda\u0daf? \u0d92 \u0db8\u0dc4 \u0d9c\u0db8\u0dcf\u0dc5\u0d9a\u0dbb\u0dd4 \u0d85\u0dbd\u0dca \u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dd4\u0dc4\u0dd4. \u0da7\u0db4 \u0db4\u0dc3\u0dda\u0d9c\u0dc3\u0dda \u0d9a\u0db1\u0dca\u0dad\u0d9c\u0da7\u0dca\u0db1\u0dbb\u0dca\u0dbd 323\u0d9a \u200d\u0dbb\u0dc1\u0dda\u0db1\u0dba\u0d9a\u0dca \u0dca\u0dc0\u0dcf. \u0d92\u0d9c\u0d9a\u0dca \u0db8\u0dc4 \u0d9c\u0db8\u0dcf\u0dc5\u0d9a\u0dcf\u0dba\u0dba\u0dcf \u0d9c\u0d9a\u0ddd? \u0dad\u0dc0\u0db8 \u0d9c\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9c\u0dda\u0db1\u0dca\u0dad\u0dad\u0dd4\u0dc0\u0db4 \u0d92 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dad\u0daf\u0dd2\u0dbb\u0dd2\u0db4 \u0d9a \u0d9a\u0dc5\u0dcf\u0daf? \u0d92 \u0d9c\u0dd4\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf\u0daf? \u0daf\u0dd4\u0db1\u0dca\u0dad \u0d92\u0dc0\u0dcf \u0dad\u0d9a\u0dca\u0d9c\u0d9a\u0ddd\u0db8 \u0dc4\u0dcf\u0d9c\u0dcf\u0d9c\u0d9c\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0db1\u0dc0\u0dcf.\n\n\u0d92 \u0dc0\u0dd2\u0dad\u0dba\u0d9a\u0dca \u0d9c\u0db1\u0dcf\u0d9c\u0dc0\u0dba\u0dd2, \u0d9c\u0db6\u0d9c\u0dc4 \u0d9a \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0 \u0d9a\u0dcf\u0dba\u0da7\u0dba \u0db6 \u0db1\u0dca\u0dad\u0db1. \u0d85\u0db4\u0dd2 \u0daf\u0dd2\u0d9c\u0dd2\u0db1\u0dca\u0dad \u0daf\u0dd2\u0d9c\u0db4\u0db8 \u0dbb\u0dd3 \u0dc0\u0dcf, \u0dad\u0db1\u0dca\u0dad\u0daf\u0dd2\u0dba\u0dcf\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0db6\u0dcf \u0d9c\u0db6\u0d9c\u0dc4 \u0d9a \u0d9c\u0d9c\u0db1\u0dd4\u0dbd\u0dca \u0dcf \u0db8\u0db1\u0dca\u0dad\u0db1\u0dcf\u0dba\u0d9c\u0db8\u0db1\u0dca\u0dad, \u0d9a\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0d9c\u0dba\u0db1\u0dca\u0dad \u0db6\u0dcf\u0db1\u0dc0\u0dcf \u0dbb\u0dd3\u0dba \u0dcf. \u0d92 \u0dc0\u0dd2\u0dad\u0dba\u0d9a\u0dca \u0d9c\u0db1\u0dcf\u0d9c\u0dc0\u0dba\u0dd2. Airport \u0d91\u0d9c\u0d9a\u0db1\u0dd4 \u0d9a \u0d9c\u0d9c\u0d9c\u0db1\u0db1\u0dc0\u0dcf \u0dc3\u0db8\u0dc4\u0dba \u0d9c\u0db6\u0d9c\u0dc4 \u0d9a. NMRA \u0d91\u0d9c\u0d9a\u0dca \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dba\u0dba\u0dcf\u0daf \u0daf\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dd4\u0dc4\u0dd4 \u0d92\u0d9c\u0d9a\u0dca \u0db8\u0dc4 \u0d9c\u0db8\u0dcf\u0dc5\u0d9a\u0dbb\u0dd4 \u0dc4\u0dd4\u0da7\u0dd2\u0dba\u0db4 \u0dad\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0dbb\u0dd3\u0dba \u0dcf \u0d85\u0db4\u0db4 \u200d\u0dbb\u0dc1\u0dda\u0db1\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0dc4\u0dd4\u0db6\u0dd4\u0dba\u0dd2 \u0d85\u0daf\u0db4 \u0d9a \u0d92\u0dc0\u0dcf \u0db1\u0dad\u0dba \u0d9a\u0dba \u0dcf \u0db1\u0dd4\u0dc4\u0dd4. \u0db1\u0dad\u0dba \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dd4 \u0d9a\u0d9c \u0d9a \u0d87\u0dba\u0dd2? \u0db1\u0dad\u0dba \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dd4 \u0d9a\u0d9c \u0d9a, \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0d9c \u0dc3\u0dc4\u0d9c\u0dba\u0ddd\u0d9c\u0dba \u0db1\u0dd2\u0dc3\u0dcf. \u0db8\u0dad\u0d9a \u0dad\u0dd2\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0dad\u0db1, \u0d9c\u0dda \u0dba\u0d9c\u0da7\u0dca \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0 \u0db8\u0dd4\u0d9c\u0dba\u0db1\u0dc0\u0dcf \u0d9c\u0dba\u0ddd\u0dc4\u0dbd\u0dca\u0dc0\u0dd2\u0db1\u0dca\u0dad \u0d9c\u0db6\u0d9c\u0dc4 \u0d9a \u0d9c\u0db1\u0dca\u0dad\u0db1 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca \u0dcf. \u0d9c\u0db6\u0d9c\u0dc4 \u0d9a\u0dc0 \u0dc4\u0dd2\u0d9f\u0dba \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0dd4\u0d9c\u0dba\u0db1 \u0d85\u0dba \u0dad\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf. \u0d92\u0dc0\u0dcf \u0daf\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dd4\u0dc4\u0dd4 \u0d9c\u0dda \u0dc3\u0db8\u0dc4\u0dba \u0d85\u0dba. \u0d92\u0dc0\u0dcf \u0d91\u0dc5\u0dd2\u0dba\u0db4 \u0d91\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dd4\u0dc4\u0dd4. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dad\u0dc3\u0dda\u0dc3\u0dba \u0d9c\u0dc0 \u0dcf \u0d92\u0dc0\u0dcf \u0d9c\u0db6\u0dca\u0dbd\u0dba \u0dcf \u0dad\u0db1\u0dca\u0dad\u0db1.\n\n\u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0d85\u0db4\u0dd2 \u0d85\u0dc4\u0db1\u0dc0\u0dcf, 6 \u0d9c\u0dc1\u0dca\u200d\u0dbb\u0dda\u0dab\u0dd2\u0d9c\u0dda \u0d9c\u0db8\u0dcf\u0da9\u0dd2\u0dd4\u0dad \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc0. \u0d92\u0d9c\u0d9a\u0dca \u0db8\u0dc4 \u0d9c\u0db8\u0dcf\u0dc5\u0d9a\u0dcf\u0dba\u0dba\u0dcf \u0d9a\u0dc0\u0dd4\u0daf? \u0d85\u0db4\u0dd2 \u0db1\u0dda \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4\u0dc0 \u0d9a \u0d85\u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0dbb\u0dd2\u0dba\u0db4 \u0d85\u0db4\u0dc4\u0dcf\u0dc3 \u0d9a\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d9c\u0dd2\u0d9c\u0dda \u0db1\u0dd4\u0dc4\u0dd4; \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4\u0dc0 \u0d9a \u0d85\u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0dbb\u0dd2\u0dba\u0db4 \u0d85\u0db4\u0dc4\u0dcf\u0dc3 \u0d9a\u0d9c\u0dc5\u0dda \u0db1\u0dd4\u0dc4\u0dd4. \u0dc4\u0dd4\u0db6\u0dd4\u0dba\u0dd2 \u0db8\u0dad\u0d9a \u0dad\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0dad\u0db1, \u0d85\u0db4\u0dc4\u0dcf\u0dc3 \u0d9a\u0dba\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad\u0db8, \u0d91\u0db8 \u0dc0\u0dd4\u0da9\u0dc3\u0db4\u0dc4\u0db1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad\u0db8 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0dad\u0db1\u0dcf\u0db1\u0dca\u0dad\u0d9c\u0dc3\u0dda \u0dcf\u0d9c\u0dda \u0db4\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dba \u0d87\u0dad\u0dd4\u0d9c\u0dc5\u0dda \u0db6\u0dc0. \u0d91\u0dba \u0d9c\u0d9a\u0d9c\u0dba\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad\u0db8 JVP \u0d91\u0d9a \u0d87\u0dad\u0dd4\u0d9c\u0dc5\u0db1\u0dca\u0dad. \u0dad\u0db8\u0dd4\u0db1\u0dca\u0dad\u0db1\u0dcf\u0db1\u0dca\u0dad\u0d9c\u0dc3\u0dda \u0dcf\u0d9c\u0dda \u0dc3\u0db8\u0dc4\u0dba \u0d9c\u0dca\u0dda\u0dc3\u0dda\u0db6\u0dd4\u0d9a\u0dca \u0d9a\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba\u0dda \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad social media \u0dc4\u0dba\u0dc4\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0d92 \u0d85\u0db4\u0dc4\u0dcf\u0dc3\u0dba \u0d9a\u0dba\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad. \u0d92\u0d9a \u0db4\u0dd4 \u0dc0 \u0d9a\u0d9c\u0dad\u0db1\u0dca\u0dad \u0dc3\u0dd2\u0dda\u0db0 \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad. \u0d92\u0d9a \u0dc4\u0dcf\u0d9c\u0db1\u0dca\u0dad\u0db1 \u0dd6\u0daf\u0dcf\u0db1\u0dda \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0d91\u0db4\u0dcf. \u0d92\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0d87 \u0d9a\u0dad \u0d9a\u0dae\u0dcf\u0dc0. \u0dc4\u0dd4\u0db6\u0dd4\u0dba\u0dd2, \u0d91\u0d9c\u0dc4\u0db8 \u0d9c\u0dc0\u0dda\u0daf\u0dd2 \u0d85\u0d9c\u0db1\u0d9a\u0dca \u0d85\u0dba\u0db4 \u0d87\u0d9f\u0dd2\u0dbd\u0dca \u0daf\u0dd2\u0d9c\u0dd4 \u0d9a\u0dba\u0db1\u0dca\u0dad\u0db1, \u0db8\u0da9 \u0d9c\u0dc4\u0db1\u0dca\u0dad\u0db1 \u0dd6\u0daf\u0dcf\u0db1\u0dda \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0d91\u0db4\u0dcf."
