    "chunk_text": "\u0dda\u0db8\u0dca \u0daf\u0dca\u200d\u0d9a\u0dca\u0dc0\u0dcf \u0db8\u0dd0\u0dd2\u0dc0\u0dba\u0da7 \u0dda\u0d9a\u0dcf\u0da7\u0dca\u0db0\u0dcf\u0dca \u0dc3\u0dd3\u0db8\u0dcf \u0db1\u0dd2\u0dbb\u0dca\u0da7\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0dda\u0db8\u0dca \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d85\u0dc0\u0dca\u0db1\u0dca\u0dc0 \u0dda\u0db1\u0dcf\u0db8\u0dd0\u0dd2 \u0db6\u0db1\u0dd0\u0dc0\u0dd2\u0db1\u0dca 2017 \u0d85\u0d82\u0d9a 17 \u0daf\u0dca\u200d\u0dba\u0db1 \u0dc5 \u0dcf\u0dad\u0dca\u0dad \u0dca\u0db7\u0dcf \u0da1\u0db1\u0dca\u0daf\u0dca\u200d \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca 1\u0dca\u0d82\u0dda\u0dba\u0ddd\u0dca\u200d\u0db1 \u0dc5\u0db1\u0dda\u0dad\u0dca\u0dad \u0dc0\u0dd2\u0d9a\u0dbb\u0dc0\u0dd2\u0dca\u200d\u0dcf\u0db1 \u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dba\u0dc0 \u0dc5 \u0dcf\u0dad\u0dca\u0dad \u0dca\u0db7\u0dcf \u0da1\u0db1\u0dca\u0daf\u0dca\u200d \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8 \u0dc5\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dad\u0dc0\u0dd3\u0db8\u0db4 \u0dda\u0db1\u0dcf\u0dc4\u0dd0\u0d9a\u0dd2 \u0dc0\u0dd3 \u0d87\u0dad. \u0d85\u0db1\u0dd4\u0dc0 \u0dc5 \u0dcf\u0dad\u0dca\u0dad \u0dca\u0db7\u0dcf \u0db8\u0dd0\u0dd2\u0dc0\u0dba\u0da7\u0dba\u0d8b \u0db8\u0dd0\u0dd2\u0dc0\u0dba\u0da7 \u0dda\u0d9a\u0dcf\u0da7\u0dca\u0db0\u0dcf\u0dca \u0dc3\u0dd3\u0db8\u0dcf \u0db1\u0dd2\u0dbb\u0dca\u0da7\u0dba \u0d85\u0dc0\u0dca\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dda\u0db8\u0db1\u0dca \u0dc5\u0dc3\u0dd4 2017 \u0d85\u0d82\u0d9a 17 \u0daf\u0dca\u200d\u0dba\u0db1 \u0dc5 \u0dcf\u0dad\u0dca\u0dad \u0dca\u0db7\u0dcf \u0da1\u0db1\u0dca\u0daf\u0dca\u200d \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca 1\u0dca\u0d82 \u0dda\u0dba\u0ddd\u0dca\u200d\u0db1 \u0dc5\u0db1\u0dda\u0dad\u0dc4\u0dd2 \u0dc0\u0dd2\u0d9a\u0dbb\u0dc0\u0dd2\u0dca\u200d\u0dcf\u0db1 \u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dba\u0dc0 \u0dc5\u0dc0\u0dad\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dda\u0db1\u0dca \u0daf\u0dca\u200d\u0d8b \u0d91\u0dda\u0dca\u0dda \u0db1\u0dd0\u0dad\u0dda\u0dc4\u0dcf\u0dad\u0dca\u0dad \u0dda\u0db8\u0db8 \u0dc5\u0db1\u0dda\u0dad\u0dca\u0dad \u0dd2\u0dc4\u0dad \u0dc0\u0dd2\u0d9a\u0dbb\u0dc0\u0dd2\u0dca\u200d\u0dcf\u0db1\u0dba\u0db4 \u0dca\u0d82\u0dda\u0dba\u0ddd\u0dca\u200d\u0db1\u0dba\u0d9a\u0dca \u0dda\u0d9c\u0db1 \u0d91\u0dd2\u0dba\u0db1\u0dca \u0dc5\u0dd0\u0dba\u0dab\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba\u0db4 \u0dc5 \u0dcf\u0dad\u0dca\u0dad \u0dca\u0db7\u0dcf \u0db8\u0dd0\u0dd2\u0dc0\u0dba\u0da7\u0dba \u0dc5\u0dc0\u0dad\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dda\u0db1\u0dca \u0daf\u0dca\u200d \u0dba\u0db1\u0dca\u0db1 \u0dca\u0db8\u0dca\u0db6\u0db1\u0db1\u0dca\u0dca\u200d\u0dda\u0dba\u0db1\u0dca \u0dda\u0db8\u0dca \u0dc0\u0db1 \u0dc0\u0dd2\u0db4 \u0daf\u0dd3\u0dbb\u0dca\u0d9d \u0dc0\u0dba\u0dda\u0dba\u0db1\u0dca \u0d9a\u0dbb\u0dd4\u0dd4 \u0dca\u0dbd\u0d9a\u0dcf \u0db6\u0db1\u0dbd\u0dd2\u0dba\u0db1\u0dca \u0dc3\u0da7\u0dd2\u0db1 \u0d85\u0dad\u0dba\u0d8b \u0d91\u0db8 \u0d85\u0dca\u200d\u0dba\u0dba\u0db1\u0dda\u0dba\u0db1\u0dca \u0d85\u0db1\u0dad\u0dd4\u0db8\u0dbb\u0dd4\u0dc0 \u0d85\u0dc0\u0dca\u0db1\u0dca \u0dad\u0dd3\u0dba\u0da7\u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0db4 \u0db1\u0dd2\u0dba\u0dd2\u0dba\u0dad\u0dba. \u0dda\u0d9a\u0dda\u0dca\u0dda \u0dc0\u0dd4\u0dc0\u0daf\u0dca\u200d\u0d8b \u0dda\u0db8\u0db8 \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d85\u0dc0\u0dca\u0dcf\u0db1\u0dda\u0dda \u0dc5 \u0dcf\u0dad\u0dca\u0dad \u0dca\u0db7\u0dcf \u0db8\u0dd0\u0dd2\u0dc0\u0dba\u0da7\u0dba \u0dc5\u0dc0\u0dad\u0dca\u0dad\u0dc0\u0db1\u0dd4 \u0d87\u0dad.\n\n2026 \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0dad\u0dd4\u0db8 \u0dc5 \u0dcf\u0dad\u0dca\u0dad \u0dca\u0db7\u0dcf \u0db8\u0dd0\u0dd2\u0dc0\u0dba\u0da7\u0dba \u0dc5\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dad\u0dc0\u0dd3\u0db8\u0db4 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd\u0dca \u0dda\u0dc0\u0db1\u0dca \u0d9a\u0dba \u0d87\u0dad.\n\n\u0dc0\u0dba\u0dc0\u0dca\u0dda\u0dae\u0dca\u200d\u0dcf\u0dc0\u0d9a\u0dca \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0da7\u0dba \u0dda\u0dc0\u0db1\u0dc0\u0dcf\u0dba \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dd2\u0dc5\u0dd2\u0dad\u0db6\u0db1\u0db3\u0dc0 \u0d85\u0dd2\u0dc5 \u0dca\u0dda\u0dad\u0dd4\u0db8\u0dd2\u0dc0\u0db1\u0dca\u0dad \u0dc0\u0db1\u0dc0\u0dcf. \u0dc0\u0dd2\u0dda\u0dba\u0dda\u0dc2\u0dca\u0da8\u0dda\u0dba\u0db1\u0dca\u0db8 \u0db8\u0db8 \u0dba\u0db8\u0dca \u0dc5\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2 \u0d9a\u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0d9a\u0dca \u0d9a\u0dba \u0d9c\u0db1\u0dca\u0db1\u0db4 \u0d9a\u0dd0\u0db8\u0dd0\u0dd2\u0dd2..\n\n\u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dba\u0dc0\u0dca\u0dda\u0dae\u0dca\u200d\u0dcf\u0dc0 \u0dca\u0d82\u0dda\u0dba\u0ddd\u0dca\u200d\u0db1\u0dba \u0dc0\u0db1\u0dda\u0d9a\u0dcf\u0db4 \u0d87\u0dad\u0dca\u0dad\u0dad\u0dc0\u0dba\u0dda\u0dba\u0db1\u0dca\u0db8 \u0d85\u0dda\u0dda \u0dba\u0dda\u0da7\u0dca \u0db8\u0dd6\u0dd2\u0d9a \u0d85\u0dd2.\u0dd2\u0dc0\u0dcf\u0dc3\u0d9a\u0db8\u0dca \u0dca\u0db8\u0dca\u0db6\u0db1\u0db1\u0dca\u0dca\u200d\u0dda\u0dba\u0db1\u0dca \u0dc0\u0dd2\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dba \u0dd2\u0dda\u0db6\u0db1\u0db1\u0dca\u0dda\u0db1\u0dca\u0d8b \u0dda\u0db4\u0dba\u0dc5\u0dcf\u0dbd\u0db1 \u0dca\u0dc4 \u0dc3\u0dc0\u0dd2\u0dbd\u0dca \u0d85\u0dd2.\u0dd2\u0dc0\u0dcf\u0dc3\u0d9a\u0db8\u0dca \u0dd2\u0dc5\u0dd2\u0dad\u0db6\u0db1\u0db3\u0dc0\u0dd2.. \u0db1\u0db8\u0dd4\u0dad\u0dca\u0dad \u0d85\u0dd2\u0dc5 \u0dc0\u0dd2\u0dba\u0dda\u0dc0\u0dcf\u0dca \u0d9a\u0dba\u0db1\u0dc0\u0dcf\u0d8b \u0db8\u0dd6\u0dd2\u0d9a \u0d85\u0dd2.\u0dd2\u0dc0\u0dcf\u0dc3\u0d9a\u0db8 \u0dca\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0d91\u0db8 \u0db1\u0dd2\u0dbb\u0dca\u0dc0\u0da0\u0db1\u0dba \u0dc0\u0da9\u0dcf\u0dad\u0dca\u0dad \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0dca \u0dda\u0dc0\u0db1\u0dca\u0db1\u0db4 \u0d95\u0db1\u0dd1\u0dba \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc0\u0dcf\u0dda\u0dda\u0db8 \u0db1\u0dd2\u0daf\u0dca\u200d\u0dc4\u0dca\u0dda \u0dda\u0dca\u0dde\u0d9b\u0dba \u0dca\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0d85\u0dd2.\u0dd2\u0dba\u0d8b \u0db1\u0dd2\u0daf\u0dca\u200d\u0dc4\u0dca\u0dda \u0d85\u0dca\u200d\u0dba\u0dcf\u0dc5\u0db1\u0dba \u0dca\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0d85\u0dd2.\u0dd2\u0dba\u0d8b \u0dca\u0d82\u0dca\u0dda\u0d9a\u0dd8\u0dd2\u0d9a\u0db8\u0dba \u0d85\u0dd2.\u0dad\u0dd3\u0db1\u0dca\u0d8b \u0d86\u0d9c\u0dd2\u0dba\u0d9a \u0d85\u0dd2.\u0dad\u0dd3\u0db1\u0dca \u0dba\u0db1\u0dcf\u0daf\u0dd3 \u0dc0\u0dba\u0dda\u0dba\u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0dca \u0db1\u0dd2\u0dbb\u0dca\u0dc0\u0da0\u0db1\u0dba\u0d9a\u0dca \u0dca\u0dc4\u0dd2\u0dad\u0dc0 \u0db8\u0dd6\u0dd2\u0d9a \u0d85\u0dd2.\u0dd2\u0dc0\u0dcf\u0dc3\u0d9a\u0db8\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0dad\u0db8\u0d9a \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dd2. \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0dd2\u0dc5 \u0dc0\u0dd2\u0dba\u0dda\u0dc0\u0dcf\u0dca \u0d9a\u0dba\u0db1\u0dc0\u0dcf. \u0d9a \u0db8\u0db8 \u0dda\u0db8\u0dca \u0d85\u0dc0\u0dca\u0dda\u0dae\u0dca\u200d\u0dcf\u0dda\u0dda \u0dd2\u0dad\u0dcf\u0db8 \u0dc5\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dc0 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0db8\u0db8 \u0d94\u0db6\u0db1\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0dba\u0db4 \u0d91\u0dc4\u0dd2 \u0d87\u0dd2 \u0dc0\u0dd0\u0daf\u0dca\u200d\u0d9c\u0dad\u0dca\u0dad\u0d9a\u0db8 \u0d85\u0dc0\u0dca\u200d\u0dcf\u0dba\u0da7\u0dba \u0d9a\u0dba\u0db1\u0dca\u0db1\u0db4 \u0d9a\u0dd0\u0db8\u0dd0\u0dd2\u0dd2.."
