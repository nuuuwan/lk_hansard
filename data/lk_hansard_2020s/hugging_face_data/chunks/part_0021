    "chunk_text": "(\u0db1\u0db8\u0db8 \u0dc3\u0dcf\u0db1 \u0ddd\u0db0\u0dd9\u0db1\u0dda \u0d85\u0db7\u0dd2\u0db4\u0dca\u200d\u0dbb\u0dcf\u0d9c \u0dc0\u0dd4\u0dc0\u0db1\u0dda \u0dc0\u0dd0\u0d9c \u0dc1\u0dd3\u0dbb\u0dca\u0dc2 \u0d85\u0dcf\u0d9a 240 - \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d85\u0d9c\u0dc0\u0dd0\u0d9c \u0db1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0db1\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dcf\u0dc0\u0dbb\u0dca\u0db0\u0dd9 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0dd9 \u0d9c\u0da7\u0db1\u0dca \u0db1\u0dc0\u0db1\u0dca\u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0dd9\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0d85\u0dcf\u0d9a 01, 02, 04, 05, 06, 12, 13, 15, 16, 18, 31, 42, 43, 45, 48, 50, 54, 55, 58, 61 \u0d9c\u0dd9 \u0d85\u0d9c\u0dc0\u0dd0\u0d9c \u0db1\u0d9c\u0ddd\u0da2\u0dd9\u0dcf \u0dc4\u0dd0\u0dbb \u0d85\u0db1\u0dd9 \u0db4\u0dca \u0d85\u0d9c\u0dc0\u0dd0\u0d9c \u0db1\u0d9c\u0ddd\u0da2\u0dd9\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d9c\u0dcf\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd2\u0db8 \u0dd2\u0dc5\u0dab\u0dd2\u0dc3 \u0db1\u0dc0\u0db1\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0dd9, \u0d91\u0db8 \u0db1\u0d9c\u0ddd\u0da2\u0dd9\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d9c\u0dcf\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0db8\u0dda\u0db8\u0da7 \u0db1\u0dd2\u0d9c\u0dd2\u0dba\u0dad \u0dad\u0d9c\u0dad\u0dd9 \u0db1\u0dc0\u0dad \u0db8\u0dcf\u0dbb\u0dd4 \u0d9a\u0dd2\u0db8\u0dda\u0db8 \u0dc3\u0dc4 2025.10.18 \u0daf\u0dd2\u0dd9\u0dd0\u0dad\u0dd2 \u0d85\u0dcf\u0d9a 2458/65 \u0daf\u0dbb\u0dd9 \u0d85\u0dad\u0dd2\u0dc0\u0dd2\u0db1 \u0dcf\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0db1\u0dda\u0daf\u0dd9\u0d9c\u0da7 \u0dad\u0dd4\u0dc0\u0dc2\u0dcf\u0dd2\u0dc0\u0d9a\u0dc0 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dcf \u0dc0\u0dbd \u0dc0\u0dd2\u0dc2\u0d9c\u0d9c\u0db1\u0dca \u0dc4\u0dcf \u0d9a\u0dcf\u0dbb\u0dca\u0d9c\u0d9c\u0db1\u0dca \u0db1\u0dc0\u0dd9\u0dc3