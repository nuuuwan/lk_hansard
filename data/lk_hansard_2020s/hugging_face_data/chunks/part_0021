    "chunk_text": "\u0d8a \u0d9f\u0db4 \u0d85\u0dd2\u0dc5 \u0dd2\u0d9a\u0dca\u0db8\u0db1\u0dd2\u0db1\u0dca\u0db8 \u0d85\u0dc0\u0dca\u200d\u0dcf\u0db1\u0dba \u0dda\u0dba\u0dcf\u0db8\u0dd4 \u0d9a \u0d9a\u0dcf\u0dba\u0da7\u0dba \u0dad\u0db8\u0dd2.\u0d8b \u0d85\u0dba\u0db4 \u0dd2\u0dad\u0dcf \u0dd2\u0d9a\u0dca\u0db8\u0db1\u0dd2\u0db1\u0dca \u0dca\u0dcf\u0db8\u0dcf\u0db1\u0dba \u0d9c\u0db1 \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dba \u0d86\u0dba\u0db8\u0dca\u0db7 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dca\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dba\u0dba \u0dc0\u0db1 \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dca\u0db8\u0dca\u0dc5\u0dcf\u0daf\u0dca\u200d\u0db1\u0dba \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0dda\u0d9a\u0dcf\u0dda\u0dc4\u0dcf\u0db8\u0daf\u0dca\u200d \u0dca\u0dc4 \u0dca\u0db3\u0dc4\u0dcf \u0dba\u0d9c\u0dba \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0db4 \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0dda\u0d9a\u0dcf\u0dda\u0dc4\u0dcf\u0db8\u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a. \u0db1\u0dd2\u0dca\u0dcf \u0dd2\u0d9a\u0dca\u0db8\u0db1\u0dd2\u0db1\u0dca\u0db8 \u0dad\u0db8\u0db1\u0dca\u0dda\u0dda \u0db1\u0dd2\u0dc0\u0dcf\u0dca \u0dd2\u0dc5\u0dbb\u0dd2\u0dc3\u0daf\u0dd4 \u0d9a\u0dba\u0d9c\u0db1\u0dca\u0db1 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dbd\u0dca 25\u0d8b000\u0d9a\u0dca\u0d8b \u0db1\u0dd2\u0dc0\u0dcf\u0dca \u0dba\u0dae\u0dca\u200d\u0dcf \u0dad\u0dad\u0dca\u0dad\u0dad\u0dca\u0dad\u0dc0\u0dba\u0db4 \u0dc5\u0dad\u0dca\u0dad \u0d9a\u0dba\u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dca\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dbd\u0dca 50\u0d8b000\u0d9a\u0dca\u0d8b \u0dc0\u0dcf\u0dda\u0dda\u0db8 \u0dc5\u0dcf\u0dca\u0dbd\u0dca \u0db8\u0dd4\u0db1\u0dca\u0db4 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dbd\u0dca 15\u0d8b000\u0d9a\u0dca \u0d86\u0daf\u0dd3 \u0dc0\u0dba\u0dda\u0dba\u0db1\u0dca \u0d85\u0dc0\u0dba\u0dba \u0d9a\u0dba\u0db1 \u0dca\u0dc4\u0db1 \u0dc5\u0dd0\u0dda\u0d9a\u0dca\u0d9c\u0dba \u0d9c\u0db1\u0dad\u0dcf\u0dc0\u0db4 \u0dbd\u0db6\u0db1\u0dcf \u0dda\u0daf\u0dca\u200d\u0db1\u0dca\u0db1 \u0dba\u0d9c\u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0db4 \u0d85\u0dd2\u0dc5 \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a \u0dcf. \u0d9a\u0db4 \u0d85\u0dc0\u0dba\u0dba \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dbd\u0dca \u0dd2\u0dbd\u0dd2\u0dba\u0db1 50\u0d9a \u0d85\u0dd2\u0dda\u0dbb\u0dca\u0d9a \u0dc5\u0dbb\u0dd2\u0db4\u0dd6\u0dba\u0d9a \u0d87\u0dca\u0dda\u0dad\u0dda\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0 \u0dc5\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0daf\u0dca\u200d\u0dc0\u0dca\u0d9a \u0dda\u0db8\u0dca \u0dc5\u0dcf\u0dbb\u0dca\u0dd2\u0dda\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0 \u0dc0\u0dd2\u0dc3\u0db1\u0dca \u0dca\u0db8\u0dca\u0db8\u0dad \u0d9a \u0dcf. \u0dda\u0db8\u0dca \u0dda\u0db4\u0dc0\u0dbd\u0dca \u0dda\u0db8\u0dca \u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0db4 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0dad\u0db8\u0d9a \u0dda\u0dc0\u0db1\u0dda\u0d9a\u0dcf\u0db4\u0d8b \u0dd2\u0dad\u0dcf\u0db8 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0db8\u0dc0 \u0dca\u0dc4 \u0dc5\u0dd0\u0dc0\u0dd0\u0dd2 \u0d86\u0dc5\u0daf\u0dca\u200d\u0dcf \u0dad\u0dad\u0dca\u0dad\u0dad\u0dca\u0dad\u0dc0\u0dba \u0db8\u0dad \u0dd2\u0db6\u0dd4\u0dd4 \u0dc0\u0db4\u0dd2\u0dc5\u0db4\u0dcf\u0dc0 \u0dad\u0dd4\u0db8 \u0dd2\u0dad\u0dcf\u0db8 \u0dd2\u0d9a\u0dca\u0db8\u0db1\u0dd2\u0db1\u0dca \u0dda\u0db8\u0dca \u0dca\u0dc4\u0db1\n\n3121 3122\n\n\u0dc5\u0dcf\u0dbb\u0dca\u0dd2\u0dda\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\n\n\u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dca\u200d\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2\u0d8b \u0db8\u0dcf \u0dc0\u0dd0\u0da9\u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dba\u0db1\u0d8b \u0db8\u0dcf \u0dca\u0db8\u0dca\u0db6\u0db1\u0db1\u0dca\u0dca\u200d \u0dc0\u0dd3 \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dba\u0db1 \u0d85\u0dda\u0dda \u0dd2\u0dbd\u0dba\u0d9c\u0db8 \u0d86\u0dca\u0db1\u0dba \u0d9c\u0dad\u0dca\u0dad\u0dda\u0dad\u0dcf\u0dad\u0dca\u0dad\u0d8b \u0d86\u0dca\u0db1\u0dba \u0dad\u0dd4\u0db8 \u0dc5\u0dc0\u0dd4\u0dbd\u0dca 5\u0d8b500\u0d9a\u0dca \u0d86\u0dc5\u0daf\u0dca\u200d\u0dcf\u0dc0\u0db4 \u0dbd\u0d9a\u0dca \u0dc0\u0dd4\u0da7\u0dcf. \u0d85\u0dad\u0dbb\u0dd2\u0db1\u0dca \u0dda\u0db8\u0dca \u0dc0\u0db1\u0dda\u0d9a\u0dcf\u0db4 \u0dc5\u0dc0\u0dd4\u0dbd\u0dca 4\u0d8b767\u0d9a\u0db4 -\u0dc3\u0dba\u0dba\u0db4 ]7\u0d9a\u0db4- \u0d91\u0db8 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dbd\u0dca 25\u0d8b000\u0d9a \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd \u0dbd\u0db6\u0db1\u0dcf \u0daf\u0dd3\u0db8 \u0dca\u0db3\u0dc4\u0dcf \u0d85\u0dd2\u0dc5 \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dba \u0dd2\u0dda\u0db6\u0db1\u0db1\u0dc0\u0dcf. \u0dc0\u0dcf\u0dda\u0dda\u0db8 \u0dad\u0dc0\u0dad\u0dca\u0dad \u0dc5\u0dc0\u0dd4\u0dbd\u0dca 7\u0d8b492\u0d9a\u0db4 \u0dc0\u0dd2\u0dba\u0dd2\u0dad \u0d86\u0dc4\u0dcf\u0dba \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dd4 \u0d85\u0dda\u0db1\u0d9a\u0dd4\u0dad\u0dca\u0dad \u0dca\u0dc4\u0db1 \u0dbd\u0db6\u0db1\u0dcf \u0daf\u0dd3\u0db8 \u0dca\u0db3\u0dc4\u0dcf \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dba \u0dd2\u0dda\u0db6\u0db1\u0db1\u0dc0\u0dcf. \u0dc0\u0dcf\u0dda\u0dda\u0db8\u0d8b \u0dc5\u0dcf\u0dca\u0dbd\u0dca \u0db8\u0dd4\u0db1\u0dca\u0db4 \u0dbd\u0db6\u0db1\u0dcf \u0dda\u0daf\u0dca\u200d\u0db1 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dbd\u0dca 15\u0d8b000\u0d9a \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd \u0dbd\u0db6\u0db1\u0dcf \u0daf\u0dd3\u0db8 \u0dca\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dba\u0dba \u0dd2\u0dbd\u0dca\u0dbd\u0dd4\u0db8\u0dca \u0dc5\u0dad\u0dca\u0dad \u0dda\u0db8\u0dca \u0dda\u0dc0\u0db1\u0dda\u0d9a\u0dcf\u0db4\u0dad\u0dca\u0dad \u0dc0\u0dd2\u0daf\u0dd4\u0dc4\u0dbd\u0dca\u0dc5\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc4\u0dba\u0dc4\u0dcf \u0dbd\u0db6\u0db1\u0dcf \u0dda\u0daf\u0dca\u200d\u0db1\u0dca\u0db1 \u0d85\u0dd2\u0dc5 \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dba \u0dd2\u0dda\u0db6\u0db1\u0db1\u0dc0\u0dcf.\n\n\u0dc0\u0dcf\u0dda\u0dda\u0db8 \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad \u0dc4\u0dcf \u0d9a\u0dd4\u0da9\u0dcf \u0dc0\u0dba\u0dcf\u0dc5\u0dcf\u0dba\u0dc0\u0dbd \u0dda\u0dad\u0dcf\u0dba\u0dad\u0dd4\u0db8\u0dbb\u0dd4 \u0dbd\u0db6\u0db1\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dca\u0db3\u0dc4\u0dcf \u0dda\u0db8\u0dca \u0dda\u0dc0\u0db4\u0daf\u0dd3 \u0dc0\u0dd2\u0d9a\u0dbb\u0db8\u0dad\u0dca\u0dad \u0dd2\u0dc5\u0dba\u0dc0\u0dba \u0d85\u0dba\u0dda\u0d9c\u0db1 \u0dd2\u0dda\u0db6\u0db1\u0db1\u0dc0\u0dcf. \u0dba\u0d9c\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0db4 \u0d85\u0dd2\u0dc5 \u0d91\u0d9a \u0dc5\u0dd0\u0dad\u0dca\u0dad\u0dad\u0d9a\u0dd2\u0db1\u0dca \u0dca\u200d\u0dbb\u0dd2\u0dc5\u0dad\u0dca\u0dad\u0dd2\u0db8\u0dba \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4 \u0d85\u0dba\u0dda\u0d9c\u0db1 \u0dd2\u0dda\u0db6\u0db1\u0db1\u0dc0\u0dcf \u0dbd\u0db6\u0db1\u0dcf \u0dda\u0daf\u0dca\u200d\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0dca\u0dc4\u0db1 \u0dda\u0db8\u0dcf\u0db1\u0dc0\u0dcf\u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc0\u0dcf\u0dda\u0dda\u0db8 \u0dba\u0d9c\u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0db4 \u0dad\u0db8\u0db1\u0dca \u0d9c\u0dad\u0dca\u0dad\u0dad\u0dd4\u0db8 \u0dca\u200d\u0dbb\u0dd2\u0dc5\u0dad\u0dca\u0dad\u0dd2\u0db8\u0dba \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4 \u0dd2\u0d9a\u0dca\u0db8\u0db1\u0dd2\u0db1\u0dca \u0dc4\u0dcf \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0db8\u0dc0 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0dad\u0db8\u0d9a \u0d9a\u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dca\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dba\u0dba \u0dba\u0dcf\u0d9c\u0dba \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7\u0dba\u0d8b \u0dba\u0dcf\u0d9c\u0dba \u0db1\u0dd2\u0dbd\u0dca\u200d\u0dcf\u0dbb\u0dd3 \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7\u0dba \u0dda\u0db8\u0dda\u0dc4\u0dba\u0dc0\u0dd3\u0db8 \u0dda\u0db8\u0dca \u0dda\u0dc0\u0db1\u0dda\u0d9a\u0dcf\u0db4 \u0dc3\u0daf\u0dd4 \u0d9a\u0dba\u0dd2\u0dba\u0db1\u0dca \u0dc5\u0dc0\u0dd2\u0db1\u0dc0\u0dcf.\n\n\u0dda\u0db8\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dd2\u0dc5\u0dad\u0d9a\u0daf\u0dd3 \u0d85\u0dda\u0dda \u0dc5 \u0db8\u0dd4 \u0dc0\u0d9c\u0d9a\u0dd3\u0db8 \u0dad\u0db8\u0dd2.\u0d8b \u0db8\u0dd6\u0dd2\u0d9a \u0dc5\u0dd0\u0dba \u0d9a\u0dd2\u0dc4\u0dd2\u0dc5\u0dda\u0dda\u0daf\u0dd3 \u0d9c\u0db1\u0dad\u0dcf\u0dc0\u0dda\u0dda \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0dc3\u0dd4\u0dba\u0d9a\u0dca\u0dd2\u0dad \u0d9a\u0dba\u0db1 \u0d91\u0d9a. \u0d85\u0dda\u0db1\u0d9a\u0dca \u0dd2\u0dc5\u0dba\u0dc0\u0dba \u0dad\u0db8\u0dd2.\u0d8b \u0d9c\u0db1 \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dba \u0dca\u0dcf\u0db8\u0dcf\u0db1\u0dba \u0dad\u0dad\u0dca\u0dad\u0dad\u0dca\u0dad\u0dc0\u0dba\u0db4 \u0dd2\u0dad\u0dcf\u0db8 \u0dd2\u0d9a\u0dca\u0db8\u0db1\u0dd2\u0db1\u0dca \u0d9f\u0dcf \u0d9a\u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dca\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dba\u0dba \u0dc0\u0db1 \u0dc5\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dca\u0dc5\u0dba\u0db1 \u0d91\u0d9a."
