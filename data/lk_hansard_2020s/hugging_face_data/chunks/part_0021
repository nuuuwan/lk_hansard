    "chunk_text": "\u0d92 \u0db6\u0dba\u0db8\u0dda \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dc2\u0d9a\u0dc0\u0dbd \u0dad\u0dd2\u0db8\u0db6\u0db1\u0db1 \u0dbb\u0dd0\u0da7\u0dbd\u0dd4 \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2 \u0d9a\u0dbb \u0daf\u0dd4\u0db1\u0dca\u0dad\u0db1\u0dcf1 27\u0dc0\u0dd0\u0db1\u0dd2 :\u0dcf \u0db8\u0dda \u0dc3\u0dda\u0db6\u0db1\u0db1\u0dca\u0dad\u0db0 \u0dc0 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dcf\u0dc0 \u0db6\u0db4\u0dd2 :\u0dd0\u0db1\u0dd4\u0dc0\u0dad\u0dca \u0d9a\u0dd9\u0dcf1 \u0db8\u0dda \u0db8\u0dc0\u0db1\u0db8\u0d9a\u0dcf\u0da7 \u0db8\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0dad\u0dd2\u0db8\u0db6\u0db1\u0db1 \u0db8 \u0db8\u0dc0\u0dbd\u0dcf \u0dbd\u0dc0\u0dbb\u0dba\u0dd21 28\u0dc0\u0dd0\u0db1\u0dd2 :\u0dcf \u0db8\u0dc0\u0db1\u0db8\u0d9a\u0dcf\u0da7 \u0dbb\u0db8\u0da7\u0db1\u0dca\u0dad \u0dcf\u0dbb\u0dba\u0d9a\u0dca\u0dc2 \u0db8\u0dda \u0dc0\u200d\u0dc3\u0db1\u0dba\u0da7 \u0dbd\u0d9a\u0dca\u0dc2 \u0dc0\u0dd4\u0dba\u0dcf1\n\n\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dbb\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db8\u0db1\u0dd2, \u0dc3\u0db8\u0dc4\u0dbb \u0d9a\u0dd4\u0db9\u0dd4\u0dbb\u0dd4 \u0d9a\u0db1\u0dca\u0dad\u0db1 \u0dc4\u0dcf\u0dbb\u0d9a\u0dd2\u0db1\u0dca\u0dad\u0dc0\u0dad\u0dca \u0db6\u0db4\u0da7 \u0db8\u0dbb\u0dcf\u0da9 :\u0db8\u0dcf \u0dbb\u0db1\u0dca\u0dad\u0db1 \u0db6\u0db1\u0dd0\u0dc4\u0dd01 \u0db8\u0db4\u0dcf\u0db8\u0dd9\u0dcf\u0db1\u0dca\u0dad\u0db1\u0dbb\u0dd4\u0dc0 \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dc2\u0d9a\u0dba \u0dbb\u0dad\u0dca\u0db8\u0dcf\u0dcf\u0dad\u0dca, \u0dc0\u0dd0\u0dd2\u0dc0\u0dd2\u0db1\u0dca\u0dad \u0db4\u0dd2\u0dbb\u0dd4\u0dd4 \u0d9a\u0dd4\u0db9\u0dd4\u0dbb\u0dd4 \u0dad\u0dd2\u0db8\u0db6\u0db1\u0db1\u0dc0\u0dcf1 \u0d92 \u0dc0\u0dcf\u0db8\u0dda\u0db8 \u0dc3\u0dda\u0db4\u0dd6\u0dbb\u0dbb\u0dca\u0dbd\u0dba\u0db8\u0dba\u0db1\u0dca\u0dad\u0db8 \u0dbb\u0dbd\u0da7 \u0db8\u0dc0\u0db1\u0d9a\u0dca \u0dc4\u0db8\u0dbb\u0dd4\u0dd4 \u0d9a\u0dd4\u0db9\u0dd4\u0dbb\u0dd4 \u0dad\u0dd2\u0db8\u0db6\u0db1\u0db1\u0dc0\u0dcf1 \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0dda\u0dc0\u0dcf \u0dbb\u0dd0\u0db1 \u0dd2\u0dc3\u0db8\u0dc1\u0dba\u0dd3\u0dba\u0dda\u0dc2 \u0db6\u0dc0\u0db0 \u0dcf\u0db1\u0dba\u0d9a\u0dca\u0dc2 \u0db8\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0dbd\u0dcf \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dcf \u0db8\u0db8 \u0db8\u0dda \u0dbb\u0dbb\u0dd4 \u0dc3 \u0dcf\u0dc0\u0da7 \u0d9a\u0dd2\u0dba\u0dcf \u0dd2\u0d82\u0dd2\u0db1\u0dc0\u0dcf1\n\n\u0d8a\u0dd9\u0db8\u0da7, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 2.,222 \u0dbd\u0db6\u0db1\u0dcf \u0daf\u0dd3\u0db8 \u0dc3\u0db8\u0dc4\u0dbb\u0d9a\u0dca\u0dc2 \u0dcf\u0dd0\u0db1\u0dca\u0dad\u0dc0\u0dbd \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0db8\u0dc0\u0dd2\u0dba\u0db1\u0dca\u0dad \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dc0\u0dcf1 \u0db8\u0dcf \u0db1\u0dd2\u0db8\u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0db8\u0db4\u0dcf\u0db8\u0dd9\u0dcf\u0db1\u0dca\u0dad\u0db1\u0dbb\u0dd4\u0dc0 \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dc2\u0d9a\u0dba \u0dbb\u0dad\u0dca\u0db8\u0dcf\u0dcf\u0dad\u0dca, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 2.,222 \u0dbd\u0db6\u0db1\u0dcf \u0dbb\u0db1\u0dca\u0dad\u0db1 \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4 \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 02,922\u0d9a\u0dca\u0dc2 \u0db8\u0dda \u0dc0\u0db1\u0db8\u0d9a\u0dcf\u0da7 \u0dad\u0dd2\u0db8\u0db6\u0db1\u0db1\u0dc0\u0dcf1 \u0d92 02,922\u0db1\u0dca\u0dad \u0db8\u0dd4:\u0dca \u0db8\u0dc0\u0db1\u0dca\u0dad \u0db8\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad 02,037\u0d9a\u0da7 \u0db4\u0db8\u0dba\u0dba\u0dd21 \u0d91\u0dcf\u0db8\u0d9a\u0dcf\u0da7 \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 78.\u0d9a\u0da7 \u0db8\u0dd4:\u0dca \u0db8\u0dc0\u0db1\u0dca\u0dad \u0db8\u0dc0\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd01 \u0d8a\u0db8\u0d86 \u0daf\u0dd2\u0db1\u0dba \u0dc0\u0db1\u0db8\u0d9a\u0dcf\u0da7 \u0db8\u0dda 02,037\u0db1\u0dca\u0dad \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 1,232\u0d9a\u0da7 \u0dcf\u0db8\u0dba\u0dd2 \u0db8\u0dd4:\u0dca \u0dbd\u0db6\u0db1\u0dcf \u0daf\u0dd3\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad1 \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db8\u0dda \u0db8\u0dd4:\u0dca \u0dbd\u0d9a\u0dca\u0dc2\u0db8\u0db1\u0dd2\u0db1\u0dca\u0dad\u0db8 \u0db8\u0dbb\u0db1\u0dca\u0dad\u0dc0\u0dcf \u0db8\u0dbb\u0db1 \u0d9a\u0da9\u0dd2\u0db1\u0dd2\u0dba\u0db1\u0dca\u0dad \u0da2\u0db1\u0dcf\u0dcf\u0dc0\u0da7 \u0dbd\u0db6\u0db1\u0dcf \u0db8:\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0dba\u0dd21 \u0db8\u0dda \u0db4\u0dd9\u0db8\u0dd4\u0db8\u0dc0\u0db1\u0dd2 \u0dc0\u0da7\u0db8\u0d86 \u0dbd\u0db6\u0db1\u0dcf \u0db8:\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 2.,2221 \u0db8\u0db4\u0dcf\u0db8\u0dd9\u0dcf\u0db1\u0dca\u0dad\u0db1\u0dbb\u0dd4\u0dc0 \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dc2\u0d9a\u0db8\u0d86 \u0dd2\u0dc3\u0dcf\u0dbb\u0d9a\u0dca\u0dc2 \u0db8\u0dda \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 2.,222 \u0dbd\u0db6\u0db1\u0dcf \u0db8:\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0db8 \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0dcf\u0dc0 3,927\u0d9a\u0dca\u0dc2 \u0dad\u0dd2\u0db8\u0db6\u0db1\u0db1\u0dc0\u0dcf1 \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0dda \u0dc3\u0dda\u0db6\u0db1\u0db1\u0dca\u0dad\u0db0 \u0dc0 \u0dd2\u0dc3\u0db8\u0dc1\u0dba\u0dd3\u0dba\u0dda\u0dc2 \u0db6\u0dc0\u0db0 \u0dcf\u0db1\u0dba\u0d9a\u0dca\u0dc2 \u0db8\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0dbd\u0dcf \u0db4\u0dd9\u0db8\u0dd4\u0db8\u0dc0\u0db1\u0dd2 \u0dc0\u0da7\u0db8\u0d86 \u0dbd\u0db6\u0db1\u0dcf \u0db8:\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 2.,222 \u0dbd\u0db6\u0db1\u0dcf \u0db8:\u0db1\u0dca\u0dad\u0db11\n\n\u0d92 \u0dc0\u0dcf\u0db8\u0dda\u0db8 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dba\u0dd3\u0dba \u0d9a\u0dd9\u0dcf, \u0db8\u0dda \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 2.,222\u0dad\u0dca \u0d91\u0d9a\u0dca\u0dc2\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca .2,222\u0d9a\u0dca\u0dc2, \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 7.,222\u0d9a\u0dca\u0dc2 \u0dbd\u0db6\u0db1\u0dcf \u0db8:\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0db8 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf1 \u0dc4\u0dd0\u0db6\u0db1\u0dd0\u0dba\u0dd2, \u0db6\u0dbd\u0dd4\u0dad\u0dd2\u0db1\u0dca\u0dad \u0dcf\u0dc0 \u0dad\u200d\u0dbb\u0db8\u0dca \u0dba\u0d9a\u0dca\u0dc2 \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0db8\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0db1\u0dc0\u0dcf, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca .2,222\u0d9a \u0db8\u0dd4:\u0dbd \u0db8:\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db8\u0dbb\u0dc0\u0dca\u0dc0\u0dbd \u0dad\u0dd2\u0db8\u0db6\u0db1\u0db1 \u0dcf\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0db6\u0db1\u0dbd\u0dbd\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf1 \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dba\u0dd3\u0dba \u0d9a\u0db8\u0dd9\u0dda \u0d91\u0db8\u0dc4\u0db8 \u0db8\u0db1\u0dcf\u0db8\u0dc0\u0dba\u0dd21 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 7.,222\u0d9a\u0dca\u0dc2\u0db8 \u0dbd\u0db6\u0db1\u0dcf \u0db8:\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0dbb\u0db8\u0dda \u0da2\u0db1\u0dcf\u0dcf\u0dc0 \u0db6\u0db8\u0dcf\u0dbd\u0dcf \u0db8\u0dcf\u0db0 \u200d\u0dba\u0da7 \u0d87\u0dd2\u0dc3\u0dca\u0dbd\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf1"
