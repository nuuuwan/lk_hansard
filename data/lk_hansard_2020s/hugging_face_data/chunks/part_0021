u0dd2\u0dc3\u0db8\u0dda\u0dd2\u0d82\u0d9c\u0dc4 \u0db8\u0dc4\u0dcf\u0dcf \u0dbb\u0dbb\u0dd4 \u0db6\u0dd2\u0d82\u0dcf \u0db1\u0dd2\u0db8\u0dbb\u0ddd\u0dc2\u0dba \u0d91\u0db8\u0dbb\u0dcf\u0da9 \u0dd2\u0dc3\u0dcf\u0dcf\u0db1 \u0db8\u0dc4\u0dcf\u0dcf \u0dbb\u0dbb\u0dd4 \u0dc6\u0dc3\u0dda\u0dd2\u0dba\u0db1\u0dca\u0dad \u0dc2\u0dbb\u0dd3 \u0dc6\u0dda \u0db8\u0dc4\u0dcf\u0dcf \u0dbb\u0dbb\u0dd4 \u0dc1\u0dba\u0dd3\u0dba\u0dcf\u0db1\u0dca\u0dad\u0dcf \u0db4 \u0db8 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0dc3\u0dd4\u0db6\u0db1\u0dd2\u0d82\u0d9c\u0dc4 \u0db8\u0dc4\u0dcf\u0dcf 1. \u0baa\u0baa\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1, \u0ba4\u0ba8\u0b9f\u0bc1\u0b9e\u0bcd\u0b9a\u0bbe\u0b95\u0bb2\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0b95\u0bb0 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bc1\u0b9a\u0bbe\u0bb0\u0bcd \u0b86\u0baa\u0bb2\u0bbe\u0b9a\u0b95\u0ba9\u0b95\u0bcd \u0b95\u0bc1\u0bb4\u0bc1\n\n\u0bae\u0ba4\u0bc1\u0bb0\u0b99\u0bcd\u0b95 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 (\u0b95\u0bb2\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf) \u0ba8\u0ba8\u0bcd\u0ba4\u0ba9 \u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0b95\u0bb2 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0ba9\u0bc1\u0bb7\u0bcd\u0b95 \u0bb0\u0b99\u0bcd\u0b95\u0ba8\u0bbe\u0ba4\u0bcd \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0bc1\u0ba9\u0bbf\u0bb2\u0bcd \u0bb0\u0ba4\u0bcd\u0ba9\u0b9a\u0bbf\u0bb1\u0bbf \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9c\u0b95\u0ba4\u0bcd \u0bb5\u0bbf\u0ba4\u0bbe\u0ba9 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 (\u0b95\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bb0\u0bcd) \u0ba8\u0bbf\u0bb7\u0bbe\u0ba8\u0bcd\u0ba4 \u0b9a\u0bae\u0bb0\u0bb5\u0bc0\u0bb0 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0baa\u0ba4\u0bb5\u0bbe\u0ba9\u0ba8\u0bcd\u0ba4 \u0b9a\u0bc1\u0bb0\u0bb5\u0bc0\u0bb0 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 (\u0b95\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bb0\u0bcd) \u0b9c\u0ba9\u0b95 \u0baa\u0b9a\u0ba9\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bb0\u0ba3\u0bbf (\u0ba4\u0b9a\u0bb2\u0bcd\u0bb5\u0bbf) \u0bb2\u0b95\u0bcd\u0bae\u0bbe\u0bb2\u0bbf \u0baa\u0bb9\u0bae\u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0bbf\u0baa\u0ba9\u0bb7\u0bcd \u0baa\u0bb9\u0bae\u0ba8\u0bcd\u0ba4 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bae\u0bc1\u0bb9\u0bae\u0bcd\u0bae\u0b9f\u0bcd \u0b95\u0baa\u0b9a\u0bb2\u0bcd \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0ba9\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bb0\u0ba3\u0bbf \u0b8e\u0bae\u0bcd. \u0ba8\u0bbf\u0b9a\u0bbe\u0bae\u0bcd \u0b95\u0bbe\u0bbe\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0bb0\u0bcd\n\n2949 2950\n\n[\u0dbb\u0dbb\u0dd4 \u0dbb\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0db8\u0dcf]\n\n2025 \u0db8:\u0dc3\u0dd0\u0dda\u0db6\u0db1\u0dbb\u0dca\u0dbd 08\n\n2. \u0ba4\u0bc1\u0b95\u0bb1\u0bae\u0bc1\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0bb5\u0bbf\u0bae\u0bbe\u0ba9 \u0baa\u0b9a\u0b95\u0bb5\u0b95\u0bb3\u0bcd \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bc1\u0b9a\u0bbe\u0bb0\u0bcd \u0b86\u0baa\u0bb2\u0bbe\u0b9a\u0b95\u0ba9\u0b95\u0bcd \u0b95\u0bc1\u0bb4\u0bc1"
