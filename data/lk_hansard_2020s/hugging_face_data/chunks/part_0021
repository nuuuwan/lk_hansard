    "chunk_text": "\u0d92 \u0dc0\u0dcf\u0db8\u0dda\u0db8 \u0db6\u0db4\u0dd2 :\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf, \u0db8\u0dda \u0dc0\u0db1\u0db8\u0d9a\u0dcf\u0da7 \u0db8\u0dda \u0dbb\u0da7 \u0db1\u0dd0\u0dc0\u0dcf \u0db8\u0dbb\u0dcf\u0da9\u0db1\u0dd0\u0dd3\u0db8\u0db8 \u0db8\u0dc0\u0db1\u0dd4\u0db8\u0dc0\u0db1\u0dca\u0dad \u0dc3\u0dc4 \u0dcf\u0d9c\u0dd2 \u0db8\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dc4\u0dd0\u0db8\u0db8:\u0db1\u0dcf\u0db8 \u0dc3\u0dc4 \u0dcf\u0d9c\u0dd2 \u0dc0\u0dd4\u0dd4 \u0db6\u0db1\u0dc01 \u0db8\u0dda \u0db6\u0dc0\u0dc3\u0dda\u0dae\u0dcf\u0db8\u0dda\u0daf\u0dd3 \u0db6\u0db4\u0dd2 \u0dd2\u0d82\u0dc4\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0db8, \u0dd2\u0d82\u0dba\u0dbd\u0dd4 \u0dc3\u0dda\u0db6\u0db1\u0db1\u0dca\u0dad\u0db0\u0dd3\u0d9a\u0dbb\u0dba \u0db8\u0dcf\u0db0 \u200d \u0db6\u0dd2\u0db3 \u0dc0\u0dd0\u0dd3 \u0dad\u0dd2\u0db6\u0dd2\u0dba\u0daf\u0dd3, \u0dd2\u0d82\u0dba\u0dbd\u0dd4 \u0dbb\u0dcf\u0da2\u200d \u0d86\u0dba\u0dcf\u0db1\u0dc0\u0dbd\u0da7 \u0dc3\u0dd3\u0db4 \u0db8\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0dc3\u0dc4 \u0d8a\u0da7 \u0dc3\u0dda\u0db6\u0db1\u0db1\u0dca\u0dad\u0db0\n\n2025 \u0db8:\u0dc3\u0dd0\u0dda\u0db6\u0db1\u0dbb\u0dca\u0dbd 08\n\n\u0db8\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0dad\u0dd2\u0db8\u0db6\u0db1\u0db1 \u0dd2\u0d82\u0dba\u0dbd\u0dd4 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0dbb \u0db6\u0dc4\u0dd2\u0dd2\u0dba \u0db8\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd2\u0dba\u0daf\u0dd3, \u0dbb\u0da2\u0db8\u0d86 \u0db1\u0dd2\u0dbd\u0db0 \u0dcf\u0dd2\u0daf\u0db1\u0dca\u0dad \u0db8\u0dbd\u0dc3\u0dad\u0dca, \u0dcf\u0db1\u0dd2 \u0dcf\u0db1\u0dd2 \u0db4\u0dd4 \u0dbb\u0dbd\u0dba\u0db1\u0dca\u0dad \u0db8\u0dbd\u0dc3\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dda\u0db4\u0dd2\u0daf\u0db8 \u0db8 \u0d9a\u0dbb\u0dd2\u0dba\u0db1\u0dca\u0dad, \u0db6\u0dd2\u0dda \u0db8\u0dda\u0da7\u0dd2\u0dba\u0db1\u0dca\u0dad \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0d9a\u0dbb\u0db1 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0 \u0dcf\u0dd2\u0daf \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dba\u0dcf :\u0d9a\u0dca\u0dc2\u0dc0\u0dcf\u0db8, \u0db1\u0dd0\u0dc0\u0dcf \u0dd2\u0d82\u0dba\u0dbd\u0dd4 \u0dbb\u0dcf\u0da2\u200d \u0d86\u0dba\u0dcf\u0db1 \u0dc3\u0dda\u0db6\u0db1\u0db1\u0dca\u0dad\u0db0\u0dd3\u0d9a\u0dbb\u0dba\u0dba \u0d9a\u0dbb \u0dbb\u0dd0\u0db1\u0dd3\u0db8 \u0dbd\u0dcf\u0dcf \u0db8\u0d9a\u0dd2 \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0d9a\u0dbb \u0dbb\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dc0\u0dd4\u0dd4 \u0db6\u0db1\u0dc01 \u0dd2\u0dc3\u0db8\u0dc1\u0dba\u0dd3\u0dba\u0dda\u0dc2\u0db8\u0dba\u0db1\u0dca\u0dad\u0db8 \u0db8\u0db8 \u0d92 \u0dc3\u0dda\u0db6\u0db1\u0db1\u0dca\u0dad\u0db0 \u0db8\u0dba\u0db1\u0dca\u0dad \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0da7 \u0dc3\u0dda\u0dd4\u0dad\u0dd2\u0dc0\u0db1\u0dca\u0dad\u0dcf \u0db8\u0dc0\u0db1\u0dc0\u0dcf1\n\n\u0db8\u0dda \u0dc0\u200d\u0dc3\u0db1\u0db8\u0dba\u0db1\u0dca\u0dad \u0dc0\u0dd0\u0da9\u0dd2\u0db8\u0dba\u0db1\u0dca\u0dad\u0db8 \u0db4\u0dd3\u0da9\u0dcf\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0db8\u0dc0\u0da0\u0dca\u0da0\u0dad \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dc2\u0d9a \u0db6\u0dd4\u0dd2\u0daf\u0db1\u0dca\u0dad \u0d91\u0d9a\u0d9a\u0dca\u0dc2 \u0dcf\u0db8\u0dba\u0dd2, \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dc2\u0d9a\u0dba1 \u0db8\u0dda \u0dc0\u200d\u0dc3\u0db1\u0dba \u0db1\u0dd2\u0dc3\u0dcf \u0db6\u0db4\u0da7 \u0dba\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dcf\u0dbb\u0d9a\u0dca\u0dc2 \u0db1\u0dd0\u0dad\u0dd2 \u0dc0\u0dd4\u0dba\u0dcf; \u0db8\u0dbb\u0ddd\u0dc4\u0dca \u0dd2\u0d9a \u0d9a\u0da9\u0dcf\u0db8\u0dbb\u0db1 \u0dc0\u0dd0\u0da7\u0dd4\u0dba\u0dcf; \u0dc3\u0dd4\u0dbb\u0d9a\u0dca\u0dc2\u0dc2\u0dcf \u0db8\u0db0 \u200d\u0dc3\u0dda\u0dae\u0dcf\u0db1 \u0dd2\u0dc3\u0dc1\u0dba\u0dd3\u0dba\u0dcf\u0dbd \u0dc0\u0dc1\u0dba\u0dd3\u0dba\u0db8\u0dba\u0db1\u0dca\u0dad \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dcf \u0dbb\u0db1\u0dca\u0dad\u0db1 \u0dd2\u0d82 \u0db0 \u0dc0\u0dd4\u0dba\u0dcf; \u0d9a\u0db3\u0dd4 \u0db4\u0dd2\u0dd2\u0db1\u0dca\u0dad \u0db1\u0dcf\u0dba \u0d9c\u0dd2\u0dba\u0dcf1 \u0db8\u0db8\u0db1\u0dca\u0dad\u0db1 \u0db8\u0dda \u0dc4\u0daf\u0dd2\u0dd2\u0d82 \u0dcf\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0dd4\u0dd9 \u0db4\u0dc0\u0dcf \u0dd2\u0dc3\u0dc1\u0dba\u0dd3\u0dba\u0dcf\u0dbd \u0dc1\u0dca\u200d\u0dbb\u0db8 \u0db8\u0db8\u0db8\u0dc4\u0dba\u0dd4\u0dda \u0d86\u0dbb\u0dda \u0d9a\u0dd9\u0dcf1 \u0db6\u0db4\u0dd2 :\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf, \u0d9a\u0dc5\u0dd4\u0dcf\u0dd2\u0daf\u0db1\u0dca\u0dad \u0dd2\u0dc3\u0dc1\u0dba\u0dd3\u0dba\u0dcf\u0dbd \u0dc1\u0dca\u200d\u0dbb\u0db8 \u0db8\u0db8\u0db8\u0dc4\u0dba\u0dd4\u0db8\u0d9a\u0dca\u0dc2 \u0d86\u0dbb\u0dda \u0d9a\u0dd9 \u0db6\u0db1\u0dc01 \u0dcf\u0db8\u0db1\u0dca\u0dad\u0db8\u0dda \u0db6\u0dcf\u0da7 \u0dc4\u0dc3\u0dd4 \u0db8\u0dc0\u0da0\u0dca\u0da0\u0dad \u0dc4\u0dcf\u0dca \u0d9a\u0dd2\u0db8\u0dbd\u0ddd\u0dc0, \u0db8\u0db4\u0dcf\u0dca \u0db8\u0dbb\u0da9\u0dd2\u0dba, \u0dc0\u0dd4\u0dbb \u0db8\u0db6\u0db1\u0ddd\u0dcf\u0dbd\u0dba \u0dc3\u0dc4 \u0db8\u0dda \u0dc0\u200d\u0dc3\u0db1\u0db8\u0dba\u0db1\u0dca\u0dad \u0da2\u0db1\u0dcf\u0dcf\u0dc0 \u0db8\u0dbb\u0dcf\u0da9\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0db6\u0dc0\u0dc1\u0dba\u0dd3\u0dba\u200d machine \u0db4\u0dc0\u0dcf \u0d91\u0d9a\u0dd4 \u0d9a\u0dbb\u0db8\u0dbb\u0db1 :\u0dd0\u0dc0\u0dd0\u0db1\u0dca\u0dad\u0dcf \u0db4\u0dd2\u0dd2\u0daf\u0dc3\u0d9a\u0dca\u0dc2 \u0db6\u0db8\u0db4\u0dca \u0db8\u0dda \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dc1\u0dba\u0dd3\u0dba\u0dc0\u0dbd\u0da7 \u0d86\u0dc0\u0dcf1 \u0d92 \u0db6\u0dcf\u0db8\u0dbb\u0dca\u0dbd \u0dd2\u0dc3\u0db8\u0dc1\u0dba\u0dd3\u0dba\u0dda\u0dc2\u0db8\u0dba\u0db1\u0dca\u0dad\u0db8 \u0daf\u0dd2\u0dc3\u0dcf\u0db4\u0dad\u0dd2\u0dd4\u0dd2\u0dba\u0dba, \u0db1\u0dd2\u0db8\u0dba\u0ddd\u0da2\u200d \u0db8\u0db4\u0dcf\u0dd2\u0dc3\u0dda\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dcf, \u0db8\u0da2\u200d\u0dc2\u0dda\u0da8 \u0db8\u0db4\u0dcf\u0dd2\u0dc3\u0dda \u0db6\u0db0\u0dd2\u0d9a\u0dcf\u0dd2\u0daf\u0dc0\u0dbb\u0dd4, \u0dad\u0dca\u200d\u0dbb\u0dd2\u0dd2\u0dc3\u0db0 \u0dc4\u0db8\u0dd4:\u0dcf\u0dc0 \u0d87\u0dd4\u0dc5\u0dd4 \u0dbb\u0dcf\u0da2\u200d \u0d86\u0dba\u0dcf\u0db1\u0dc0\u0dbd \u0db1\u0dd2\u0dbd\u0db0 \u0dcf\u0dd2\u0daf\u0db1\u0dca\u0dad \u0dd2\u0d82\u0dba\u0dca\u0dbd \u0dd3 \u0db8\u0dd0\u0dd2\u0d82 \u0d9a\u0dd0\u0dbd\u0d9a\u0dca\u0dc2 \u0dc0\u0dcf\u0db8\u0dda \u0d91\u0d9a\u0da7 \u0d91\u0d9a\u0dd4 \u0db8\u0dc0\u0dbd\u0dcf \u0db8\u0dda \u0db8\u0db8\u0db8\u0dc4\u0dba\u0dd4\u0db8\u0da7 :\u0dcf\u0dba\u0d9a \u0dc0\u0dd4\u0dba\u0dcf1 \u0dd2\u0dc3\u0db8\u0dc1\u0dba\u0dd3\u0dba\u0dda\u0dc2\u0db8\u0dba\u0db1\u0dca\u0dad\u0db8 \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dc2\u0d9a\u0db8\u0d86 \u0dc3\u0db8\u0dc3\u0dda\u0dcf \u0dbb\u0dcf\u0da2\u200d \u0db8\u0dc3\u0dda\u0dc0\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0dad\u0da7 \u0db8\u0db8\u0dda \u0dc4: \u0db4\u0dd2\u0dd2\u0daf \u0db4\u0dca\u200d\u0dbb\u0dba\u0dcf\u0db8\u0dba \u0db8\u0dda \u0db6\u0dc0\u0dc3\u0dda\u0dae\u0dcf\u0db8\u0dda\u0daf\u0dd3 \u0db4\u0dd9 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd0\u0db8\u0dad\u0dd2\u0dba\u0dd2, \u0db8\u0db8\u0dc0\u0db1\u0dca\u0dad \u0dc0\u200d\u0dc3\u0db1\u0dba\u0d9a\u0daf\u0dd3 \u0dc0\u0dc4\u0dcf\u0db8 \u0d91\u0d9a\u0dd4 \u0db8\u0dc0\u0dbd\u0dcf \u0db4\u0dd3\u0da9\u0dcf\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0db8\u0dc0\u0da0\u0dca\u0da0\u0dad \u0da2\u0db1\u0dcf\u0dcf\u0dc0 \u0dba\u0dae\u0dcf \u0dcf\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0dcf\u0db8\u0db1\u0dca\u0dad\u0db8\u0dda \u0da2\u0dd3\u0dd2\u0dc3\u0dcf \u0d9a\u0dd0\u0db4 \u0d9a\u0dbb\u0dd2\u0dba\u0db1\u0dca\u0dad \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dda\u0db6\u0db1\u0db1\u0dca\u0dad\u0db0 \u0db8\u0dba\u0db1\u0dca\u0dad1"
  },
