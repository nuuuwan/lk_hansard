    "chunk_text": "\u0d87\u0dad\u0dca\u0dc0 \u0dc0\u0dc1 \u0dba\u0db1\u0dca\u0dad\u0db8 \u0d85\u0db4\u0da7 donations \u0d91\u0dcf\u0d9a \u0da2 \u0db6\u0dbd \u0d9c\u0dcf \u0db8\u0db1\u0dca\u0dad\u0dcf \u0dc4\u0dd0\u0d9a\u0dd2\u0dba \u0dc0\u0d9a\u0dca\u0d9a\u0dba \u0dcf\u0dd0\u0dc4\u0dd0. \u0db8 \u0d9a , \u0dbd\u0ddd\u0d9a \u0db6\u0dd0\u0d82 \u0dc0 \u0d9a\u0dd2\u0dba \u0dd2 \u0db6\u0dcf\u0dc0 , \"\u0daf\u0dd2\u0da7\u0dca\u0dc0 \" \u0dc3\u0dd4\u0dc5\u0dd2 \u0daf \u0da7\u0dd4 \u0dda damage \u0d91\u0d9a \u0dc5 \u0dda\u0dba\u0dba \u0db1\u0dd2\u0dc2\u0dbb\u0db4 \u0dcf \u0dba\u0db1\u0dca\u0dad \u0dc3\u0dd2\u0dba\u0dba\u0da7 4 \u0db8\u0d9a\u0dca\u0d9a\u0dba\u0db8\u0dc0 \u0dba\u0dcf\u0dc0 \u0d9a\u0dd2\u0dba\u0dbd . \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad \u0d87 \u0db8\u0dbb\u0dd2\u0d9a \u0db1\u0dd4 \u0da9 \u0dbd\u0dbb\u0dca \u0db6\u0dd2\u0dca\u0dba\u0dcf 4\u0d9a \u0dc0\u0dd2\u0dc0\u0dbb, \u0d91 \u0dc4\u0db8\u0dad\u0dca \u0dcf\u0dd0\u0dad\u0dca\u0dcf \u0da2 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db6\u0dd2\u0dca\u0dba\u0dcf 1,200\u0d9a \u0dc0\u0dd2\u0dc0\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8 \u0daf\u0dba\u0d9a\u0dca\u0d9a\u0dba; \u0dc0\u0dd2\u0dc1 \u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8 \u0daf\u0dba\u0d9a\u0dca\u0d9a\u0dba. \u0db8\u0db8 \u0d85\u0dc4 \u0d9c\u0dcf \u0dad\u0dcf \u0db0\u0dd2\u0db4\u0dd2\u0dad\u0dd4\u0db8 \u0dad\u0dca \u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0d85\u0db4\u0dd2 \u0d86\u0db0\u0dca\u200d \u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc3\u0dca\u0dc5\u0dd4\u0dc0\u0d9a\u0dca\u0d9a\u0dba \u0d9a\u0dd0\u0db3\u0dc0\u0db1\u0dca\u0dad\u0dcf \u0d95\u0dcf\u0dd9, \u0d92 \u0d86\u0db0\u0dca\u200d \u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc3\u0dca\u0dc5\u0dd4 \u0dc0\u0db1\u0dca\u0dad \u0d85\u0db4\u0dd2 \u0dbb\u0da7\u0dc0\u0dca\u0db1\u0dca\u0dad \u0d86\u0db0\u0dca\u200d \u0dbb \u0dbd\u0db6 \u0d9c\u0db1\u0dca\u0dad\u0dcf \u0d95\u0dcf\u0dd9 \u0d9a\u0dd2\u0dba\u0dbd . \u0d8a\u0da7 \u0db4\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0d92 \u0d9c\u0dd0\u0dcf \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4\u0dad\u0dca \u0d9a\u0dae \u0d9a \u0dc5\u0dbb \u0dcf\u0dd0\u0dc4\u0dd0. \u0d85\u0db4\u0dd2 \u0dd0\u0dcf\u0d9c\u0db1\u0dca\u0dad\u0dcf \u0d9a\u0dd0\u0db8\u0dd0\u0dd2\u0dba\u0dd2, \u0d92 \u0d86\u0db0\u0dca\u200d \u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc3\u0dca\u0dc5\u0dd4\u0dc0 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dc0 \u0d9a\u0dd2\u0dba\u0dbd . \u0d92 \u0d86\u0db0\u0dca\u200d \u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc3\u0dca\u0dc5\u0dd4 \u0dc0\u0db1\u0dca\u0dad \u0d85\u0db4\u0da7 \u0db7 \u0dab\u0dca\u0da9\u0db8\u0dba \u0dbb\u0dc0\u0dba \u0dbd\u0dc3\u0dca\u0dad\u0dca\u200d \u0d86\u0db0\u0dca\u200d \u0dbb \u0dbd\u0dd0 \u0db6\u0dcf\u0dc0 \u0dcf \u0da2 \u0d92 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3\u0dc4 \u0da2 \u0db4\u0dcf\u0dc0 \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dbb\u0d9c\u0db1\u0dca\u0dad\u0dcf \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad.\n\n\u0d92 \u0dc0\u0db8\u0dba\u0dd2, \u0da2 \u0d85\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae \u0dda\u0daf\u0dd3 \u0db1\u0dd2\u0d9a \u0da2 \u0dbd\u0dd0 \u0db6\u0dcf \u0d92\u0dc0 \u0da7 \u0dc0\u0dd2\u0dc0\u0dbb\u0d9a\u0dca\u0d9a\u0dba \u0dcf \u0dc0\u0dba\u0dd2, \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0dc3\u0dca\u0dad\u0dca\u200d\u0dca \u0dca \u0d9c\u0dc0\u0dbd \u0dcf\u0dd0\u0dc0\u0dc0 \u0d9c\u0db1\u0dca\u0dad\u0dc0\u0dcf, \u0d92 \u0dc0\u0dd2\u0dcf \u0dc1 \u0dd6 \u0dba\u0db1\u0dca\u0dad \u0dad\u0dca\u200d\u0dbb\u0ddd\u0db4\u0d9a\u0dbb\u0daf\u0dc0\u0dbd\u0da7\u0dad\u0dca VAT \u0d91\u0d9a \u0d85\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dcf \u0d91\u0db4 \u0d9a\u0dd2\u0dba\u0dbd . \u0db8\u0db8 \u0dc4\u0dd2\u0dc0\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7, \u0d92\u0d9a \u0dc3\u0dca\u0dad\u0dca\u200d \u0db0\u0dca\u200d \u0dbb\u0daf \u0db8\u0dca \u0dd3\u0dc3\u0db8\u0d9a\u0dca\u0d9a\u0dba. \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad \u0d92 \u0dba\u0ddd\u0dad\u0dcf \u0dc0\u0da7 \u0d91\u0d9a\u0d9f \u0dc0\u0dd4\u0daf . \u0d92 \u0db1\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d \u0d85\u0db4\u0dd2 \u0da2 \u0d85\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae \u0dda\u0daf\u0dd3 \u0dc3\u0dca \u0dca \u0d85\u0db8 \u0dc0\u0dba \u0d82\u0dc1\u0dba\u0da7 \u0dcf\u0dd0\u0dc0\u0dc0\u0dad\u0dca \u0d85\u0dc0\u0db0\u0dca\u200d \u0dbb\u0daf\u0dba \u0d9a\u0dbb\u0dcf\u0dc0 , \u0d86\u0db0\u0dca\u200d \u0dbb\u0dc0\u0dbd\u0da7 \u0dc0\u0dd2\u0dc0\u0dbb\u0d9a\u0dca\u0d9a\u0dba \u0dcf \u0dc0\u0dba\u0dd2, \u0da2 \u0dc3\u0dd4\u0dc0\u0dd2 \u0dc1\u0dbb\u0dc2 \u0d85\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae \u0dda\u0daf\u0dd3 \u0dc0\u0dba \u0db4 \u0dbb\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0dad \u0dc3\u0dca \u0dca \u0daf\u0dd3\u0dbd \u0d86\u0dcf\u0dba\u0dcf\u0dba \u0d9a\u0dbb\u0dcf \u0db7 \u0dab\u0dca\u0da9\u0dc0\u0dbd\u0da7 VAT \u0d91\u0d9a \u0d85\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dcf \u0d91\u0db4 \u0d9a\u0dd2\u0dba\u0dbd . \u0d91\u0dc0\u0dd0\u0dcf\u0daf\u0dd3 \u0dba \u0da2 \u0d9a\u0dd2\u0dc3\u0dd2 administrative regulations \u0dd2 \u0db6\u0db1\u0dca\u0dad\u0dcf \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad, \u0dba \u0da2 \u0d9a\u0dd2\u0dc3\u0dd2 \u0db7 \u0dab\u0dca\u0da9\u0dba\u0d9a\u0da7 \u0d9a \u0da0\u0dca\u0da0\u0da0\u0dbb \u0dc3\u0dca \u0dbd\u0d9a\u0dca\u0d9a\u0dba \u0dc0\u0dd2\u0dba \u0da2 \u0dc0\u0dcf\u0dc0 \u0d9a\u0dd2\u0dba\u0dcf \u0d91\u0d9a \u0dad\u0dd3\u0dbb\u0daf\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad \u0d9a\u0dc0\u0dd4 \u0d9a\u0dd2\u0dba\u0dcf \u0d91\u0d9a \u0dc0 . \u0d9c\u0dbb\u0dd4 \u0da0\u0dad\u0dd4\u0dbb\u0d82\u0d9c \u0d85 .\u0dc3\u0dd2\u0d82\u0dc4 \u0db1\u0dd2 \u0dba\u0ddd\u0dad\u0dba \u0d87\u0db8\u0dd2\u0dad\u0dd4\u0db8 \u0d92 \u0d85\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae \u0dda\u0daf\u0dd3 \u0d9a\u0dd2\u0dda\u0dc0 , \u0d9a\u0dbb\u0dca\u0db8 \u0db1\u0dca\u0dad\u0dc0 \u0d85\u0db8 \u0dc0\u0dba \u0d82\u0dc1\u0dba \u0dc4\u0dbb\u0dc4 \u0dad\u0dca \u0d92\u0d9a \u0dad\u0dd3\u0dbb\u0daf\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dcf \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0dbd . \u0d91 \u0dc4\u0db8\u0dad\u0dca \u0dcf\u0dd0\u0dad\u0dca\u0dcf \u0da2 \u0d85\u0db4\u0da7 \u0d92\u0d9a decentralize \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dcf \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad. \u0d85\u0db4\u0dd2 \u0dc4\u0dd2\u0dc0\u0dc3\u0dca, \u0db4 \u0dc5 \u0db1\u0dca\u0dad\u0dcf\u0dbb\u0dd4 \u0dc0\u0db1\u0dca\u0dad \u0dcf \u0da2 \u0d92\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad, \u0db4 \u0dc5 \u0db1\u0dca\u0dad\u0dcf\u0dbb\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb \u0dda\u0dba\u0dba \u0dca \u0d9a \u0da2 \u0d9a \u0dbb\u0dca\u0dba \u0dbd\u0dba\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad experts\u0dbd \u0dba \u0d9c\u0dcf \u0d92 \u0d9c\u0dd0\u0dcf \u0dc3\u0dca\u0dad\u0dca\u200d \u0dba \u0db6\u0dbd \u0d92\u0d9a \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0dd0\u0daf\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8 \u0daf\u0dba \u0d9a\u0dd2\u0dba\u0dbd \u0dad\u0dd3\u0dbb\u0daf\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dcf. \u0d91 \u0dc4\u0db8 \u0dcf\u0dd0\u0dad\u0dd4\u0dc0 insurance \u0dbd\u0dd0 \u0db6\u0dcf\u0dc0 \u0dcf \u0da2, \" \u0db8\u0db1\u0dca\u0dad\u0dcf \u0da2 \u0d9c\u0daf\u0dcf \u0dc0\u0db8\u0dba\u0dd2 \u0da2\u0d9a\u0da7 \u0dc0\u0dd2\u0dba \u0da2 \u0dc0\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad\" \u0d9a\u0dd2\u0dba\u0dbd \u0d92 insurance \u0d91 \u0d9a\u0dca\u0d9a\u0dba condition \u0d91\u0d9a\u0d9a\u0dca\u0d9a\u0dba \u0dcf\u0dc0 . \u0db8\u0db8 \u0dc4\u0dd2\u0dc0\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d92 \u0dba\u0ddd\u0dad\u0dcf \u0dc0\u0da7 \u0da2 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad 225 \u0dcf \u0db8 \u0d91\u0d9a\u0d9f \u0dc0\u0dba\u0dd2. \u0da2 \u0d85\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae \u0dda\u0daf\u0dd3 \u0d92 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf\u0dba \u0dc0\u0dba \u0db4 \u0dbb \u0d9a\u0dbb\u0dcf \u0d85\u0dba\u0da7 \u0dbd\u0db6 \u0db1\u0dca\u0dad\u0dcf \u0d9a\u0dd2\u0dba\u0dbd \u0d85\u0db4\u0dd2 \u0db8\u0dc0 \u0d95\u0dcf\u0dd9\u0d9a\u0db8\u0dd2\u0db1\u0dca\u0dad \u0db8\u0dca \u0dbd \u0dc3\u0dd2\u0db4\u0dcf\u0dcf\u0dc0 . \u0d92\u0d9a \u0dc0\u0db8\u0dba\u0dd2 \u0db4\u0dc5\u0dc3\u0dca\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a \u0dbb\u0daf\u0dba."
