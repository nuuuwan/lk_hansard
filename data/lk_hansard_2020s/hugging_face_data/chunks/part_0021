    "chunk_text": "Colombo Port City Economic Commission Act \u0d91 \u0d9a\u0dca\u0d9a\u0dba 5243 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7 \u0dad\u0dca \u0da2 \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf \u0dbd\u0db6 \u0daf\u0dd3 \u0da2 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba \u0dc0 \u0dd2\u0db6\u0dd4\u0daf . \u0d91\u0dc0 \u0d9a \u0da7 \u0da2 \u0db4\u0dcf\u0dc0\u0da7 \u0d9c\u0dcf \u0d91\u0dcf \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0dc3\u0dca\u0dad\u0dca\u200d\u0d82 \u0dc1\u0ddd\u0db0\u0dca\u200d\u0dcf\u0dba \u0dba\u0da7 \u0dad\u0dca \u0dc0\u0dd2 \u0dc1\u0dbb\u0dc2 \u0dba\u0db1\u0dca\u0dad\u0db8 \u0dc3\u0dd2\u0dda\u0db0\u0dca\u200d \u0d9a\u0dbb\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad \u0da2 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba \u0dc0 \u0dc0\u0dc0\u0d9a\u0dbb\u0dbb\u0da7\u0dad\u0dca \u0dab \u0daf \u0dad\u0dca\u0db8\u0d9a \u0dc0\u0dc1 \u0dba\u0db1\u0dca\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dba\u0dd2. \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf \u0dbd\u0db6 \u0daf\u0dd3 \u0da2 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba \u0dc0 \u0db8\u0dc0\u0dad\u0dca \u0d9a\u0dbb\u0dbd \u0dcf\u0dd0\u0dc4\u0dd0. \u0dc3\u0dca \u0dca \u0d85\u0db8 \u0dc0\u0dba \u0d82\u0dc1\u0dba \u0db8\u0d9f\u0dd2\u0db1\u0dca\u0dad \u0db8\u0dc4\u0dd2\u0daf\u0dd3 \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf \u0dbd\u0db6 \u0daf\u0dd3 \u0da2 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba \u0dc0 \u0d9a \u0db8\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0db8\u0da7 \u0dbd\u0db6 \u0daf\u0dd3 \u0dd2 \u0db6\u0dcf\u0dc0 . \u0dcf\u0dc3\u0dca\u0dad\u0dca, \u0d92 \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf \u0dbd\u0db6 \u0daf\u0dd3 \u0da2 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba \u0dc0\u0da7 \u0dba \u0da2 \u0dba \u0da2 \u0dbb\u0dab \u0dbd \u0dc3\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8 \u0daf\u0dba\u0d9a\u0dca\u0d9a\u0dba, \u0dba \u0da2 \u0dba \u0da2 \u0dc3\u0dd3\u0db8 \u0dc0\u0db1\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0db8 \u0daf\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dbb \u0dd2 \u0db6\u0dcf\u0dc0 . \u0db8 \u0d9a , \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf \u0dbd\u0db6 \u0d9c\u0dcf \u0dbd\u0d82\u0d9a \u0dc0\u0da7 \u0d86 \u0dba\u0ddd\u0dad\u0dcf \u0d9c\u0dcf \u0dc0 \u0da7, \u0d92 \u0d86 \u0dba\u0ddd\u0dad\u0dcf\u0dc0\u0dca\u0db1\u0dca\u0dad \u0daf\u0dd3\u0dbb\u0dca\u0db1 \u0d9a \u0dd3\u0dc3\u0dcf\u0dc0 \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba\u0da7 \u0dbd\u0dd0 \u0db6\u0dcf \u0dc0 \u0dc3\u0dd2\u0dba \u0db8\u0d9a\u0dca\u0d9a\u0dba \u0d9a\u0dd2\u0dba\u0dcf \u0d91\u0d9a \u0db1\u0dd2\u0dc1\u0dbb\u0da0\u0dba \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0dad\u0dcf \u0d85\u0db8 \u0dbb\u0dd4\u0dba\u0dd2. \u0db8 \u0d9a , \u0db6\u0dda \u0d9a\u0dca\u0d9a\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad \u0dbb \u0da7\u0dca \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba\u0da7 \u0d91\u0d9a\u0dad\u0dd4 \u0dc0\u0dcf \u0d86 \u0dba\u0db8\u0d9a\u0dca\u0d9a\u0dba. \u0d92\u0d9a \u0dbb\u0dad \u0db8 \u0d86 \u0dba \u0da2 \u0d9a \u0da7\u0dc3\u0dca\u0dad\u0dca\u200d\u0d9a\u0dca\u0d9a\u0dba. \u0dbb\u0dad \u0db8 \u0d86 \u0dba \u0da2 \u0d9a \u0da7\u0dc3\u0dca\u0dad\u0dca\u200d\u0d9a\u0dca\u0d9a\u0dba \u0d85\u0db4\u0dd2 \u0d86 \u0dba\u0ddd\u0dad\u0dcf\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dc0\u0db1\u0dd4 \u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dd0\u0db4 \u0d9a\u0dbb\u0dcf\u0dc0 \u0dcf \u0da2, \u0d92 \u0dc3\u0dca\u0dad\u0dca\u200d \u0da2\u0db6\u0db1\u0dca\u0dad\u0db0\u0dca\u200d \u0dba\u0db1\u0dca\u0dad \u0d85\u0db4\u0da7 \u0dba \u0da2\u0d9a\u0dd2\u0dc3\u0dd2 \u0db1\u0dd2\u0dc1\u0dbb\u0dd2\u0dc0 \u0db1\u0dd2\u0dbb\u0dca\u0daf \u0dba\u0d9a \u0dd2 \u0db6\u0db1\u0dca\u0dad\u0dcf\u0da7 \u0d85\u0dc0\u0dc1\u0dba\u0dba\u0dd2, \u0d92\u0d9a \u0dc3\u0dd2\u0dda\u0db0\u0dca\u200d \u0d9a\u0dbb\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad \u0db8 \u0dcf \u0db4 \u0dcf \u0db8\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0dbd . \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0dc0\u0db8\u0dba\u0dd2 \u0da2 5243 \u0d9a\u0dd2\u0dba\u0dcf \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc0\u0dc0\u0dad\u0dca qualify \u0d9a\u0dbb\u0dbd \u0da2 \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf \u0dbd\u0db6 \u0daf\u0dd3 \u0da2\u0daf\u0dd3 \u0dc3\u0dca \u0dca \u0d85\u0db8 \u0dc0\u0dba \u0d82\u0dc1 \u0db8 \u0dc0 \u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dab\u0dd2\u0d9a \u0dc0\u0dd2\u0dc1\u0dbb \u0dca \u0dc2\u0daf\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d85\u0db1\u0dd2\u0dc0 \u0dbb\u0dca\u0dba \u0d9a\u0dbb\u0dbd \u0dd2 \u0db6\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad. \u0d92 \u0dc0 \u0db8 \u0dba \u0da2\u0d9a\u0dd2\u0dc3\u0dd2 \u0d8b\u0db4 \u0dba \u0db8 \u0dbb\u0dca\u0d9c\u0dd2\u0d9a \u0d86 \u0dba\u0ddd\u0dad\u0dcf\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dbb\u0da7 \u0dad\u0dd4\u0dc5\u0da7 \u0d91\u0dcf\u0dc0 \u0dcf \u0da2 \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0d85\u0dc0\u0db8 \u0d86 \u0dba\u0ddd\u0dad\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db8 \u0daf\u0dba\u0d9a\u0dca\u0d9a\u0dba, \u0d85\u0dc0\u0db8 \u0d86 \u0dba\u0ddd\u0dad\u0dcf \u0db8\u0da7\u0dca\u0da7\u0db8\u0d9a\u0dca\u0d9a\u0dba, \u0d92 \u0dc0 \u0db8 \u0d85\u0dc0\u0db8 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba \u0db1\u0dd2\u0dbb\u0dca\u0db8 \u0daf\u0dba \u0d9a\u0dd2\u0dbb\u0dd3 \u0da2 \u0db8\u0da7\u0dca\u0da7\u0db8\u0d9a\u0dca\u0d9a\u0dba \u0dc0\u0dd0\u0db1\u0dd2 \u0db1\u0dd2\u0dbb\u0dca\u0daf \u0dba\u0d9a \u0dba\u0da7 \u0dad\u0dca \u0da2 \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf \u0dbd\u0db6 \u0daf\u0dd3 \u0da2 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba \u0dc0 \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0dc3\u0dca\u0dad\u0dca\u200d\u0d82 \u0dc1\u0ddd\u0db0\u0dca\u200d\u0dcf \u0dba\u0da7 \u0dad\u0dca \u0d87\u0dd2 \u0d9a\u0dbb \u0dd2 \u0db6\u0dcf\u0dc0 . \u0d91\u0dc0 \u0d9a \u0da7 blanket, \u0d91 \u0dc4\u0db8 \u0dcf\u0dd0\u0dad\u0dca\u0dcf \u0da2 \u0d9a\u0dd2\u0dc3\u0dd2\u0d9a\u0dbb \u0d9a \u0db1\u0dca\u0dad \u0dda\u0dc3\u0dd2\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dbb\u0dc4\u0dd2\u0dc0\u0dc0, \u0d9a\u0dd2\u0dc3\u0dd2\u0d9a\u0dbb \u0db1\u0dd2\u0dbb\u0dca\u0daf \u0dba\u0d9a\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dbb\u0dc4\u0dd2\u0dc0\u0dc0 \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf \u0dbd\u0db6 \u0daf\u0dd3 \u0da2 \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dda \u0dba \u0dc0\u0db1\u0dd4\u0dc0\u0da7 \u0dba \u0da2\u0d9a\u0dd2\u0dc3\u0dd2 \u0db1\u0dd2\u0dc1\u0dbb\u0dd2\u0dc0 \u0db1\u0dd2\u0dbb\u0dca\u0daf \u0dba\u0d9a \u0dba\u0da7 \u0dad\u0dca, \u0db1\u0dd2\u0dc1\u0dbb\u0dd2\u0dc0 \u0d86 \u0dba\u0ddd\u0dad\u0dcf \u0db8\u0da7\u0dca\u0da7 \u0da2 \u0dba\u0da7 \u0dad\u0dca, \u0db1\u0dd2\u0dc1\u0dbb\u0dd2\u0dc0 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba \u0db1\u0dd2\u0dbb\u0dca\u0db8 \u0daf\u0dba \u0d9a\u0dd2\u0dbb\u0dd3 \u0da2 \u0db4 \u0dcf \u0da2 \u0dba\u0da7 \u0dad\u0dca \u0db6\u0d9a\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dcf \u0dbd\u0db6 \u0daf\u0dd3 \u0da2 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba \u0dc0\u0d9a\u0dca\u0d9a\u0dba \u0d87\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0db8\u0dba\u0dd2 \u0da2 \u0dc3\u0dca\u0dad\u0dca\u200d\u0d82 \u0dc1\u0ddd\u0db0\u0dca\u200d\u0dcf \u0dba\u0db1\u0dca\u0dad \u0dd6\u0dbd\u0dca\u0d9a \u0dc0\u0dc1 \u0dba\u0db1\u0dca\u0dad\u0db8 \u0dc3\u0dd2\u0dda\u0db0\u0dca\u200d \u0d9a\u0dbb\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad.\n\n\u0d92\u0d9a \u0db1\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d \u0dc0\u0dbb \u0dba \u0dcf\u0d9c\u0dbb\u0dba\u0da7 - Colombo Port City \u0d91\u0d9a\u0da7 - \u0d86 \u0dba\u0ddd\u0dad\u0dcf \u0d9c\u0dcf \u0d92\u0db8 \u0d85\u0dc0\u0db0\u0dca\u200d\u0dbb\u0dca\u0dba\u0dc0\u0dad\u0dca - discourage - \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dca\u0d9a\u0dba \u0dc4\u0ddd \u0dc3\u0dd3\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dca\u0d9a\u0dba \u0dc0\u0db1\u0dd4\u0dc0\u0da7 \u0d87\u0dad\u0dca\u0dc0\u0da7\u0db8 \u0d92 \u0d86 \u0dba\u0ddd\u0dad\u0dcf \u0dbd\u0dbd \u0dba \u0dc0 \u0dbb \u0da7\u0dca \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba\u0da7 \u0dc3\u0dca\u0dad\u0dca\u200d \u0da2\u0db6\u0db1\u0dca\u0dad\u0db0\u0dca\u200d \u0d9a\u0dbb\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad \u0d9a \u0dc4 \u0db8 \u0d9a\u0dd2\u0dba\u0dcf \u0d91\u0d9a \u0d9c\u0dd0\u0dcf \u0dc4 \u0db3 \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dda \u0dba\u0d9a\u0dca\u0d9a\u0dba - scheme \u0d91\u0d9a\u0d9a\u0dca\u0d9a\u0dba - \u0dc3\u0dca\u0dad\u0dca\u200d\u0d9a\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3\u0dc4 \u0dc0\u0db8\u0dba\u0dd2 \u0da2 \u0db4\u0dcf\u0dad\u0dca \u0d9a\u0da7\u0dd4 \u0da2\u0db4\u0dc0 \u0db8\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0dd2 \u0db6\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad."
