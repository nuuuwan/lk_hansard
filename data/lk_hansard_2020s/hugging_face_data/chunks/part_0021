    "chunk_text": "\u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0d9c\u0dda \u0d85\u0dba \u0d85\u0daf \u0d9c\u0dda \u0dc0\u0db1\u0dca\u0dad\u0daf\u0dd2 \u0d9c\u0d9c\u0dd3\u0db8\u0d9c\u0dda \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dd2\u0dba \u0d9c\u0dd4\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0db1\u0dc0\u0dcf; \u200d\u0dbb\u0dc1\u0dda\u0db1 \u0d9a\u0dba\u0db1\u0dc0\u0dcf. \u0d92\u0d9c\u0d9c\u0dcf\u0dbd\u0dca \u0db1\u0dca\u0dad \u0d92 \u0d9a\u0dcf \u0d9c\u0dda \u0d9c\u0d9c\u0dc0\u0db4\u0dd4 \u0dc0\u0dd2\u0d9a\u0dbb\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2 \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0 \u0daf\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf. \u0db8\u0dcf\u0dad\u0d9c\u0dbd\u0dca \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0d9c\u0dda \u0dad\u0db8\u0dba\u0dd2 \u0dcf\u0d9a\u0dcf\u0d9c \u0dc0\u0dd4\u0da9\u0dd2\u0d9c\u0dba\u0db1\u0dca\u0dad\u0db8 \u0d9c \u0dcf\u0d9a\u0dd4 \u0dbd\u0dd6\u0db1\u0dd4 \u0db1\u0dd2\u0dc2\u0dca\u0da8\u0dda\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dba\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad. \u0db8\u0dcf\u0dad\u0d9c\u0dbd\u0dca \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0db4\u0dd4 \u0d9a\u0d9c \u0d9a \u0d9c\u0d9a\u0d9c\u0db1\u0d9a\u0dd4\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0daf \u0dc3\u0db7\u0dcf\u0dc0 \u0d9a\u0dbd\u0dca \u0dad\u0db6\u0db1 \u0d85\u0dc0\u0dc3\u0dda\u0dae\u0dcf\u0d9c \u0d9c\u0dba\u0ddd\u0da2\u0dcf\u0db1\u0dcf\u0dc0 \u0d9c\u0d9c\u0db1\u0dcf\u0d9c . \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0db8 \u0d91\u0dad\u0dd4\u0db1\u0dd2\u0db1\u0dca\u0dad\u0db8 \u0db8\u0dad\u0d9a\u0dca \u0d9a\u0dba\u0db1\u0dca\u0dad\u0db1\u0dda. \u0d9c \u0dcf\u0d9a\u0dd4 \u0dbd\u0dd6\u0db1\u0dd4 \u0db6\u0dd3\u0da2\u0dcf \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2\u0dba\u0dcf\u0d9c\u0dda \u0d9c \u0dcf\u0d9a\u0dd4 \u0dbd\u0dd6\u0db1\u0dd4 \u0db6\u0dd3\u0da2\u0dcf \u0d91\u0daf\u0dcf \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0d9c \u0d9a\u0dad\u0dcf, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 9,000 \u0d9c\u0da7\u0d9c\u0db1\u0dca\u0dad \u0d9c\u0d9c\u0dc0\u0db1\u0dc0\u0dcf \u0dbb\u0dd3\u0dba \u0dcf. \u0db1\u0db8\u0dd4 \u0d9a, \u0dc3\u0dad \u0db4\u0dc4\u0d9a\u0dca \u0d9c\u0d9c \u0d9c \u0db1\u0dd4\u0dc4\u0dd4, \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dcf\u0dba \u0d9a\u0dcf\u0dba\u0d9a \u0dc3\u0db7\u0dcf\n\n\u0d92 \u0dc0\u0dd2\u0dad\u0dba\u0d9a\u0dca \u0d9c\u0db1\u0dcf\u0d9c\u0dc0\u0dba\u0dd2, \u0dc0\u0dd4\u0dd2\u0db8\u0da9, \u0dd4\u0dc0\u0db4\u0dba\u0da7\u0d9c\u0db8, \u0d9c\u0db6\u0dcf\u0dba \u0db1\u0dca\u0dad\u0daf, \u0d9c\u0db6\u0dcf\u0dba\u0d9c\u0dc3\u0dda\u0dc0\u0dd4\u0dc0 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0dc3\u0dda\u0dae\u0dcf\u0db1 \u0dc4\u0dba\u0d9a \u0da2 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2 \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0\u0d9c\u0dda \u0d85\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0db4\u0dbd\u0dca \u0d9c \u0d9a\u0dad\u0dcf. \u0d85 \u0dbb\u0dd3\u0d9c \u0ddd 2,0((,000\u0d9a\u0dca \u0d9c \u0d9a\u0dad\u0dcf. \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 95 \u0d9c\u0da7\u0d9c\u0db1\u0dca\u0dad \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2\u0dba\u0dcf\u0db4 \u0d9c\u0d9c\u0dc0\u0db1\u0dc0\u0dcf \u0dbb\u0dd3 \u0dc0\u0dcf. \u0d9c\u0db8\u0dcf\u0d9a\u0daf \u0d9a\u0d9c\u0dc5\u0dda? \u0dc3\u0dad \u0db4\u0dc4\u0d9a\u0dca \u0d9c\u0d9c \u0d9c \u0db1\u0dd4\u0dc4\u0dd4. \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2\u0dba\u0dcf\u0db4 \u0d9c\u0db4\u0dcf\u0dbd\u0dd4 \u0dad\u0dd2\u0db6\u0dca\u0dbd\u0db6\u0dcf. \u0d85\u0db1\u0dca\u0dad\u0dad\u0dd2\u0db8\u0db4 \u0d85\u0db4\u0db4 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd4\u0da7\u0dcf, \u0d8b\u0dda\u0d9c\u0d9d\u0ddd\u0dc2\u0dca\u0da8\u0da7 \u0d9a\u0dba\u0db1\u0dca\u0dad\u0db1; \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dcf\u0dc1\u0dba \u0dc0\u0db4 \u0db1\u0dca\u0dad\u0db1. \u0d85\u0d9c ( \u0db1\u0dcf\u0dba\u0d9a \u0d9a\u0dc0\u0d9c\u0dba\u0db1\u0dca\u0dad \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca \u0dcf \u0d92 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dcf\u0dc1\u0dba \u0dc0\u0dd4\u0db4\u0dbd\u0dd4\u0dc0\u0dcf. \u0d87\u0db8\u0dad\u0dd2 \u0db4\u0dd4\u0db1\u0dca\u0dad\u0db1\u0dcf. \u0dc4\u0dd4\u0db6\u0dd4\u0dba\u0dd2, \u0db4\u0dd4\u0db1\u0db4\u0dd4 \u0d87\u0db8\u0dad\u0dd2 \u0d85\u0db4\u0dd2 \u0db1\u0dd4\u0dc0\u0dad \u0dc0\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0d9c\u0d9c\u0db1\u0dca\u0dad\u0dc0\u0dcf \u0d9c \u0d9a\u0dad\u0dcf. \u0d9c\u0d9c\u0db1\u0dca\u0dad\u0dc0\u0dcf \u0d9c\u0d9c\u0db1 \u0d92 \u0db8\u0dd4\u0daf\u0dbd\u0dca\u0dc0\u0dd2\u0db1\u0dca\u0dad \u0d9c\u0d9a\u0dcf\u0db4\u0dc3\u0d9a\u0dca \u0d9c \u0d9a\u0dad\u0dcf. \u0dc4\u0dd4\u0db6\u0dd4\u0dba\u0dd2, \u0dad\u0dc0\u0db8 \u0d9a \u0d92 \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2 \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0\u0db4 \u0d9c\u0db4\u0dcf\u0dbd\u0dd4 \u0dad\u0dd2\u0dba\u0db4\u0dd4\u0dc0\u0dcf \u0d91\u0d9c\u0dc4\u0db8\u0db8\u0dba\u0dd2. \u0dad\u0dc0\u0db8 \u0d9a \u0d9c\u0d9a\u0ddd\u0da7\u0dd2 \u0dad\u0dd4\u0db1, \u0dc4\u0dad\u0dba\u0d9a\u0dca \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2 \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0\u0db4 \u0d9c\u0d9c\u0dc0 \u0dcf \u0db1\u0dd4\u0dc4\u0dd4. \u0d9c\u0dda\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0dad \u0d9a \u0d9a\u0dc0\u0dba. \u0d85\u0db1\u0dca\u0dad\u0db1 \u0d91\u0d9c\u0dc4\u0db8\u0dba\u0dd2 \u0d9c\u0dda\u0d9c\u0d9c\u0dcf\u0dbd\u0dca \u0db1\u0dca\u0dad \u0d9c\u0db4\u0dcf\u0dbd\u0dd4 \u0dad\u0dd2\u0db6\u0dca\u0dbd\u0d9c\u0db6\u0dca\u0dbd. \u0d9c\u0dda\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0d92\u0d9c\u0d9c\u0dcf\u0dbd\u0dca \u0db1\u0dca\u0dad\u0d9c\u0dda \u0dad\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dba.\n\n\u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0d9c\u0db8\u0dcf\u0db1\u0dba\u0dcf\u0d9c \u0db6\u0da9\u0dad\u0dbb\u0dd2\u0d9f\u0dd4 \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2\u0dba\u0dcf\u0db4 \u0d9c\u0db4\u0dcf\u0dbd\u0dd4 \u0dad\u0dd2\u0db6\u0dca\u0dbd\u0db6\u0dcf, \u0d9c\u0d9a\u0ddd\u0da7\u0dd2 16\u0d9a\u0dca. \u0d85\u0dda\u0db4\u0dcf\u0d9c\u0dbb\u0dca\u0dbd \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2\u0dba\u0dcf\u0db4 \u0d9c\u0d9a\u0ddd\u0da7\u0dd2 32\u0d9a\u0dca \u0d9c\u0db4\u0dcf\u0dbd\u0dd4 \u0dad\u0dd2\u0db6\u0dca\u0dbd\u0db6\u0dcf. \u0d9c\u0d9c \u0d9c \u0db1\u0dd4\u0dc4\u0dd4. \u0d85\u0dda\u0db4\u0dcf\u0dba \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0d9c\u0dbd\u0dca\u0d9a\u0dda \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dcf \u0dba\u0db4 \u0d85\u0db4\u0dd2 \u0d9c\u0d9a\u0dcf\u0da0\u0dca\u0da0\u0dba \u0d9c\u0dd2\u0dba\u0dcf\u0daf? \u0d85\u0db4\u0dd2 \u0d9c\u0d9a\u0dcf\u0da0\u0dca\u0da0\u0dba \u0d9c\u0db4\u0dc5\u0db4\u0dcf\u0dc5\u0dd2 \u0d9c\u0dd2\u0dba\u0dcf\u0daf? \u0d8b\u0dda\u0d9c\u0d9d\u0ddd\u0dc2\u0dca\u0da8\u0da7 \u0d9c\u0d9a\u0dbb\u0dd4\u0dc0\u0dcf\u0daf? \u0d91\u0daf\u0dcf \u0d85\u0dda\u0db4\u0dcf\u0d9c\u0dbb\u0dca\u0dbd \u0dc4\u0dd2\u0db4\u0db4\u0dd4 \u0db8\u0dc4 \u0daf\u0dd2\u0dc3\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0d9c \u0dcf\u0d9a\u0dd4 \u0db8\u0dd4\u0daf\u0dd2\u0dc4 \u0d9a\u0dd3\u0db8\u0db8\u0d9a\u0dca \u0d9c\u0d9a\u0dbb\u0dd4\u0dc0\u0dcf, \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2 \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0\u0db4 \u0d9c\u0dda \u0dc0\u0db1\u0dca\u0dad\u0daf\u0dd2 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0da7\u0dd2\u0d9a \u0d85\u0dba\u0d9c\u0d9c\u0db1 \u0d9c\u0daf\u0db1\u0dca\u0dad\u0db1. \u0dc4\u0dd4\u0db6\u0dd4\u0dba\u0dd2, \u0dc3\u0dcf\u0dbb\u0dca\u0dbd\u0dae\u0d9a \u0dc0\u0dd4\u0d9c\u0da9\u0dd4\u0d9a \u0db1\u0dd4\u0dc4\u0dd4. \u0d91\u0daf\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dca\u0da9\u0dd4\u0d9a\u0dca, \u0d85\u0daf \u0d9c\u0db8\u0dad\u0dd4\u0db1 \u0dad\u0db3\u0db1\u0dca\u0dad \u0dbb\u0dd3\u0db9\u0dd4\u0dbd\u0dca \u0d9a\u0db3\u0dd4\u0dc5\u0dd4 \u0d9c\u0dc4\u0dc5\u0db1 \u0dc4\u0dd2\u0db4\u0db4\u0dd4 \u0db8\u0dd4\u0dad\u0dd2 \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad\u0d9c\u0dda \u0dca\u0da9\u0dd4\u0d9a\u0dca \u0d91\u0daf\u0dcf \u0d9a\u0db4\u0dd4\u0dad\u0dad\u0dd4 \u0d9c\u0d9a\u0dbb\u0dd4\u0d9c \u0dad\u0db1\u0dca\u0dad\u0db1 \u0dad\u0dba \u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0db4\u0dba\u0dd2.\n\n\u0d9c\u0d9c\u0dcf\u0dc0\u0dd2\u0dba\u0dcf\u0db4 \u0dc3\u0dd4 \u0d9a\u0dd4\u0d9c \u0dad\u0db1\u0dca\u0dad\u0db1 \u0dad\u0dba \u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0db4. \u0d92\u0d9c\u0d9c\u0dcf\u0dbd\u0dca\u0d9c \u0ddd \u0d85\u0daf \u0d9c\u0db8\u0dad\u0dd4\u0db1\u0db4 \u0d87\u0dc0\u0dd2\u0dbd\u0dca \u0dcf \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4 \u0d9c\u0dd4\u0db1, \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2 \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0 \u0d9c\u0dd4\u0db1 \u0db4\u0dd4\u0daf\u0dd4\u0db8 \u0d85\u0db1\u0dd4\u0d9a\u0dda\u0db4\u0dcf\u0dc0\u0dbb\u0dd3\u0db1\u0dca\u0dad \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0db1\u0dc0\u0dcf. \u0d9c\u0dda\u0dc0\u0dcf \u0d85\u0dc4\u0db1 \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2 \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0\u0db4 \u0d9c\u0db8\u0dcf\u0db1 \u0db4\u0dd4 \u0d9a\u0d9c\u0dad\u0db1\u0dca\u0dad \u0dc4\u0dd2\u0db1\u0dcf \u0dba\u0db1\u0dc0\u0dcf\u0daf \u0daf\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dd4\u0dc4\u0dd4."
