    "chunk_text": "\u0db8 \u0dc3\u0dca\u0dca\u0db1\u0dca\u0dad \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dc5 \u0dc0 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dbb\u0dad\u0dba\u0db1\u0dca\u0dad \u0dba\u0da7 \u0dad\u0dca \u0dc0\u0dba \u0db4\u0dd8\u0dd2 \u0d86\u0dc0 \u0db8 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0d9a\u0dbb 20\u0d9a, 30\u0d9a tax holidays \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dcf . \u0d91\u0dc0\u0dd2\u0da7 \u0db6\u0d9a\u0dbb \u0d86 \u0dba \u0da2 \u0dc0\u0dd2\u0dc1 \u0dbd \u0dc0\u0dc1 \u0dba\u0db1\u0dca\u0dad \u0d85\u0db4\u0da7 \u0d85\u0dc4\u0dd2\u0db8\u0dd2 \u0dc0\u0dd4\u0daf . \u0d85\u0db4\u0dd2 \u0dad \u0dc0\u0dba\u0db1\u0dca\u0dad\u0dc0\u0dbb \u0dd6\u0dbd\u0dbd\u0dba \u0d85\u0dbb\u0dc3\u0dca \u0dbd\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0dba\u0d9a \u0dba \u0da2 \u0dc0\u0dd0\u0da9\u0dc3\u0dca\u0dad\u0dca\u200d\u0da7\u0dc4\u0dcf\u0d9a \u0db8\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad. \u0da2 \u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d \u0dbb\u0dca \u0d85 \u0dda \u0d85\u0dba \u0dc0\u0dd0\u0dba\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0dba\u0d9a, \u0d85\u0db4 \u0db8\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db4\u0dd4 \u0db6\u0d9a\u0dbb \u0d85\u0dc4\u0dd2\u0db8\u0dd2 \u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0db4\u0dca\u200d\u0dbb\u0d9a \u0dc1\u0dba \u0dc0\u0db8\u0dba\u0dd2 \u0db8 \u0d85 \u0dad\u0dca \u0da2 \u0dd2 \u0db6\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad. 2022/2023 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda \u0dda \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db6\u0dd2\u0dca\u0dba\u0dcf 978\u0d9a\u0dca\u0d9a\u0dba \u0d85 \u0dda \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba\u0da7 \u0db6\u0d9a\u0dbb \u0dc0\u0dc1 \u0dba\u0db1\u0dca\u0dad \u0d85\u0dc4\u0dd2\u0db8\u0dd2 \u0dc0\u0dbd \u0dd2 \u0db6\u0dcf\u0dc0 . 2023/2024 \u0d9c\u0dad\u0dca \u0dc0 \u0dad\u0dca, \u0d92\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db6\u0dd2\u0dca\u0dba\u0dcf 900\u0d9a\u0dca\u0d9a\u0dba \u0dc0\u0dd2\u0dc0\u0dbb \u0dc0\u0dcf\u0dc0 . 2025 \u0d9c\u0dad\u0dca \u0dc0 \u0dad\u0dca, \u0d92\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0da7\u0dca\u200d\u0dbb\u0dd2\u0dca\u0dba\u0dcf\u0dba -\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db6\u0dd2\u0dca\u0dba\u0dcf 1,000- \u0db8\u0d9a\u0dca\u0d9a\u0dba\u0db8\u0dc0\u0dcf\u0dc0 . \u0db8\u0dc0\u0dd0\u0db1\u0dd2 \u0dd0\u0dc0\u0dd0\u0db1\u0dca\u0dad\u0dc0 \u0db6\u0d9a\u0dbb \u0d86 \u0dba\u0db8\u0d9a\u0dca\u0d9a\u0dba \u0d85 \u0dda \u0dbb\u0da7\u0da7 \u0d85\u0dc4\u0dd2\u0db8\u0dd2 \u0dc0\u0dbd \u0dba\u0dcf\u0dc0 , \u0d85\u0db1\u0dca\u0dad\u0dcf \u0d92 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7, \u0dc0\u0dd2\u0da0\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0daf\u0dba\u0dca - prudent - \u0dcf \u0dc0\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d92 \u0d86 \u0dba\u0ddd\u0dad\u0dcf\u0dc0\u0dbd\u0da7 \u0dba \u0da2 \u0dba \u0da2 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbd \u0db7 \u0dbd\u0db6 \u0db1\u0dca\u0dad\u0dcf \u0d8b\u0dad\u0dca\u0dc3\u0dca\u0dad\u0dca\u200d \u0dc4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db1\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d .\n\n\u0d85 \u0dda \u0dbb\u0da7\u0da7 \u0d86 \u0dba\u0ddd\u0dad\u0dcf \u0d85\u0dc0\u0dc1\u0dba\u0dba\u0dd2. \u0d92 \u0dc0 \u0db8, \u0dad \u0dd2\u0d9a \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba\u0da7, \u0dbb\u0da7\u0da7 \u0d92 \u0d86 \u0dba\u0ddd\u0dad\u0dcf\u0dc0\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbd \u0db7 \u0d85\u0dc0\u0dc1\u0dba\u0dba\u0dd2. \u0d92 \u0db1\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d \u0dc0\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dba\u0ddd\u0dad\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad, \u0dd0\u0dcf\u0da7 \u0dd2 \u0db6\u0dcf \u0d9a \u0dc5\u0db9 \u0dc0\u0dbb \u0dba \u0dcf\u0d9c\u0dbb\u0dba \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0d9a \u0db8\u0dd2\u0dc2\u0db1\u0dca\u0dad \u0dc3\u0dca\u0dad\u0dca\u200d\u0db7 \u0dc0 \u0db4\u0dcf\u0dc0 \u0dc3\u0dca\u0dad\u0dca\u200d\u0d82 \u0dc1\u0ddd\u0db0\u0dca\u200d\u0dcf\u0dba \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd . \u0d92 \u0dc0 \u0db8, \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0d9c\u0db8\u0dcf\u0dba\u0da7 \u0da2 \u0d9a\u0dd2\u0dba\u0dcf \u0dc0\u0dba \u0db4\u0dd8\u0dd2\u0dc0\u0dbd \u0dba\u0d9a\u0dad\u0dca\u0dc0\u0dba \u0d85\u0dc0\u0dc1\u0dba\u0dba\u0dd2. \u0d92 \u0dba\u0d9a\u0dad\u0dca\u0dc0\u0dba \u0dbd\u0db6 \u0d9c\u0db1\u0dca\u0dad\u0dcf \u0d85\u0db4\u0dd2 \u0dba \u0da2 \u0dba \u0da2 \u0dba\u0ddd\u0dad\u0dcf \u0d9a\u0dd3\u0db4\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0d9a\u0dbb\u0dcf\u0dc0 . \u0dc0\u0dd2 \u0dc1\u0dbb\u0dc2 \u0dba\u0db1\u0dca\u0dad \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0d9a\u0dbb 20\u0d9a, 30\u0d9a \u0db4\u0db8\u0daf tax holidays \u0daf\u0dd3\u0dbd \u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dc0\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0d9a\u0dbb 8\u0d9a\u0da7, 15\u0d9a\u0da7 \u0dc0 \u0dc0\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0da7 \u0d9c\u0dcf \u0d91\u0db1\u0dca\u0dad\u0dcf \u0dba\u0ddd\u0dad\u0dcf \u0d9a\u0dbb\u0dcf\u0dc0 . \u0d91\u0dc0 \u0d9a \u0da7 \u0d85 \u0dda \u0dbb \u0da7\u0dca \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba\u0da7 \u0daf\u0dd3\u0dbb\u0dca\u0db1 \u0d9a \u0dd3\u0dc3\u0dcf \u0dc3\u0dd2\u0d9a\u0dbb \u0dc0\u0dcf \u0db6\u0d9a\u0dbb \u0d86 \u0dba \u0da2 \u0d85\u0dc4\u0dd2\u0db8\u0dd2 \u0dd3\u0db8 \u0d85\u0dc0\u0db8 \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0dad\u0dcf \u0d85\u0db4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dc0\u0dcf\u0dc0 .\n\n\u0d92 \u0dc0 \u0db8 \u0dc0\u0db8\u0dba\u0dd2, \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0db1\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0d9a\u0dba\u0dd2 \u0d86 \u0dba \u0da2 \u0db6\u0d9a\u0dbb. \u0db8 \u0dc3\u0dca\u0dca\u0db1\u0dd4\u0dad\u0dca \u0da2 \u0d9c\u0dd0\u0dcf \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dc5 . \u0d9a\u0dca\u0db1\u0dca\u0dad \u0d9a\u0dae \u0d9a\u0dbb\u0db4\u0dd4 \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8 \u0dad\u0dca \u0d92 \u0d9c\u0dd0\u0dcf \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dc5 . \u0dc0\u0dbb \u0dba \u0dcf\u0d9c\u0dbb\u0dba \u0d9c\u0dad\u0dca \u0dc0 \u0dad\u0dca, \u0d91\u0dc4\u0dd2 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0d9a\u0dba\u0db1\u0dca\u0dad \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0db1\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0d9a\u0dba\u0dd2 \u0d86 \u0dba\u0db8 \u0db8\u0dc0 \u0dc0\u0dcf \u0db6\u0d9a\u0dbb\u0dc0\u0dca\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dc1 \u0dbd \u0dc0\u0dc1 \u0dba\u0db1\u0dca\u0dad \u0db1\u0dd2 \u0dc4\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dbb \u0dd2 \u0db6\u0dcf\u0dc0 . \u0dcf\u0dc3\u0dca\u0dad\u0dca, \u0d9a \u0dc5\u0db9 \u0dcf\u0d9c\u0dbb \u0db8 \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb\u0dcf \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0d9a \u0dba \u0d9c\u0dad\u0dca \u0dc0 \u0dad\u0dca, \u0d94\u0dab \u0d86 \u0dba \u0da2 \u0db6\u0d9a\u0dbb \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0dcf \u0d85\u0dc0\u0dc1\u0dba\u0dba\u0dd2, \u0d94\u0dab \u0d86 \u0dba \u0da2\u0dc0\u0dbd\u0da7; \u0d94\u0dab \u0dc0\u0dd0\u0da7\u0dd4\u0dda\u0dc0\u0dbd\u0da7 \u0d85 \u0dc5\u0dc0. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d8a\u0da7 \u0d91\u0dc4 \u0db4\u0dd0\u0dad\u0dca \u0dad\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0db4\u0dcf \u0d9a \u0dc5\u0db9 \u0dc0\u0dbb \u0dba \u0dcf\u0d9c\u0dbb \u0db8 \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb\u0dcf \u0d9a\u0dcf \u0d92 \u0d9a\u0db1\u0dca\u0dad \u0dc3\u0dca\u0dad\u0dca\u200d \u0da2\u0db4\u0dd6\u0dbb\u0dbb\u0dca\u0daf \u0dba\u0db1\u0dca\u0dad\u0db8 \u0db1\u0dd2 \u0dc4\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dbb\u0dbd \u0dd2 \u0db6\u0dcf\u0dc0 . \u0d85\u0db4\u0dd2 \u0dba\u0ddd\u0dad\u0dcf \u0d9a\u0dbb\u0dcf\u0dc0 \u0db8\u0db1\u0dca\u0dad\u0dcf \u0da2\u0dc0 \u0dad\u0dca amend \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd ."
