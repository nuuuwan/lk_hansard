    "chunk_text": "\u0dba\u0db8\u0dca \u0d85\u0da9\u0dd4\u0dc0\u0dd3\u0db8\u0da7 \u0dba\u0dc4\u0dca\u0dad\u0dd4\u0dbb\u0dc0 \u0db8\u0dcf \u0d9a\u0dd2\u0dba\u0dda\u0db1\u0db8\u0dca\u0db4 \u0dba\u0db8\u0dca \u0db4\u0db1\u0dad\u0dca\u200d \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca\u0daf\u0dd3 \u0dc3\u0dc4 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0dc4\u0dbb\u0db8\u0dca\u0db7\u0dba\u0dda \u0dc3\u0dd2\u0da7 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf \u0dba\u0daf\u0d9a\u0d9a\u0daf\u0dd3 \u0db1\u0dd0\u0dc0\u0dad\u0dca\u200d \u0dc3\u0db8 \u0d9a\u0dca\u0dad\u0dc2\u0dab\u0dba\u0d9a\u0dca\u0dad \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 [\u0db6\u0dcf\u0db0\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dca\u0dad] \u0db8\u0db8 \u0db8\u0dd4\u0dd2\u0dda\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dbb \u0dbd\u0db6\u0dcf \u0dba\u0daf\u0dda\u0db1\u0db8\u0dca\u0db4 \u0d91\u0da7 \u0db4\u0dc3\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1 \u0d85\u0dc4\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda\u0db4 \u0db4 \u0db8\u0dd4\u0dc0\u0dd0\u0dd2\u0dba \u0d85\u0daf\u0dd2\u0dba\u0dba \u0daf\u0dd3 \u0dc3\u0dc4 \u0dba\u0daf\u0dc0\u0dd0\u0dd2\u0dba \u0d85\u0daf\u0dd2\u0dba\u0dba \u0daf\u0dd3 \u0dbd\u0dd0\u0dd4\u0dab\u0dab\u0dd4 \u0d85\u0dba\u0dbb\u0da7\u0db8\u0dca \u0db4\u0dbb\u0dc0\u0dd2\u0dda \u0dba\u0db8\u0dca \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0db4 \u0db8\u0dd4\u0dc0\u0dd0\u0dd2\u0dba \u0d85\u0daf\u0dd2\u0dba\u0dba \u0db1\u0dd0\u0dc0\u0dad\u0dca\u200d \u0dc3\u0dc4\u0dd2\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dd2\u0dc1\u0db0 \u0d9a\u0dbb\u0db8\u0dd2\u0dda \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0d91\u0dba \u0dc3\u0dd0\u0dca \u0dad\u0dca\u200d\u0dd0\u0db8\u0dca\u0db6 \u0db8\u0dcf\u0dc3\u0dba \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dba\u0dda \u0d85\u0dc0\u0dc3\u0dda \u0d9a\u0dbb\u0dda\u0db1 \u0db6\u0dbd\u0dcf\u0dba\u0db4\u0dcf\u0dba\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4\u0dbb \u0dba\u0dc0\u0db1\u0dc0\u0dcf\u0db4 \u0daf\u0dd0\u0db1\u