\u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0dc3\u0dc4 \u0d85\u0dad\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba \u0dc0\u0dd2\u0da7\u0d9a\u0daf\u0dd3 \u0db1\u0dd2\u0dbb\u0dca\u0daf\u0dda\u0dc1\u0dd2\u0dad \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0db1\u0dd2\u0dbb\u0dca\u0d9c\u0db8\u0db1 \u0dc0\u0dbd\u0dca\u0db1\u0dcf\u0dc1\u0d9a \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8..\n\n2026/2027 \u0db8\u0dc4 \u0d9a\u0db1\u0dca\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0ddc\u0dc4\u0ddc\u0dbb \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba\u0dad\u0dcf\u0dc0\n\n* \u0d85\u0db4\u0dda\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0dc3\u0db8\u0dc3\u0dca\u0dad \u0db4\u0ddc\u0dc4\u0ddc\u0dbb \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba\u0dad\u0dcf\u0dc0:\n\no \u0dba\u0dd6\u0dbb\u0dd2\u0dba\u0dcf - \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca 180,1\u0db1\u0dca 180,159.92 o TSP/SSP - \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca 25,65\u0db1\u0dca 25,657.01 o MOP - \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca 57,99\u0db1\u0dca 57,994.92\n\n* \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dc5 \u0dc4\u0dd0\u0d9a\u0dd2 \u0db4\u0ddc\u0dc4\u0ddc\u0dbb \u0dad\u0ddc\u0d9c\u0dba\u0d9c\u0dba: o \u0dba\u0dd6\u0dbb\u0dd2\u0dba\u0dcf - \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca 201,2\u0db1\u0dca 201,204.62 o TSP - \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca 20,49\u0db1\u0dca 20,493.91 o SSP - \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca 14,70\u0db1\u0dca 14,700.00 o MOP - \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca 52,82\u0db1\u0dca 52,821.82\n\n* 2026 \u0dc3\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca 28 \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 : \u0dbb\u0da7 \u0dad\u0dd4\u0dc5 \u0dba\u0dd6\u0dbb\u0dd2\u0dba\u0dcf \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca \u0db1\u0dca 56,612.62, TSP \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca 20,49\u0db1\u0dca 20,493.91, SSP \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca \u0db1\u0dca 8,200 \u0dc3\u0dc4 MOP \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca 24,111.82 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2 \u0d85\u0dad\u0dbb, \u0db1\u0dca 24,111.82 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2 \u0d85\u0dad\u0dbb, MOP \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca 26,710\u0d9a\u0dca \u0dc0\u0dbb\u0dcf\u0dba\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd2. \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd2.\n\n* \u0d94\u0d9a\u0dca\u0dad\u0ddd\u0db6\u0dbb\u0dca \u0db8\u0dcf\u0dc3\u0dba\u0dda: \u0dda: \u0dba\u0dd6\u0dbb\u0dd2\u0dba\u0dcf \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca 67,15\u0db1\u0dca 67,150, SSP \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca 3,500 \u0dc3\u0dc4 \u0db1\u0dca 3,500 \u0dc3\u0dc4 MOP \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca 2 ,000\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd3\u0db8\u0da7 \u0da7 \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad \u0d85\u0dad\u0dbb, \u0dad\u0dc0\u0dad\u0dca \u0dba\u0dd6\u0dbb\u0dd2\u0dba\u0dcf \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7\u0ddc\u0db1\u0dca 77,442\u0d9a\u0dca \