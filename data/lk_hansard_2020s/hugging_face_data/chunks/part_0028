    "chunk_text": "\u0b87\u0ba8\u0bcd\u0ba8\u0bbf\u0bae\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b8e\u0baa\u0bcd\u0baa\u0b9f\u0bbf \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u0b87\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0bae\u0b9f\u0baf\u0bbf\u0bb2\u0bcd \u0bc6\u0bae\u0bbe\u0ba4\u0bbe\u0ba9\u0ba4\u0bcd\u0bae\u0ba4 \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bae\u0bcd? \u0baf\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0baa\u0bc1\u0bbe\u0bbf\u0baf\u0bbe\u0ba4, \u0bc6\u0bae\u0bbe\u0ba4\u0bbe\u0ba9\u0bae\u0bcd \u0bb0\u0baa\u0bc6\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0bbe\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0ba4\u0bbf\u0bb2\u0bc0\u0baa\u0ba9\u0bcd \u0b89\u0ba3\u0bcd\u0ba3\u0bbe \u0bb0\u0ba8\u0bbe\u0ba9\u0bcd\u0baa\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0b87\u0bb1\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bbe\u0bb0\u0bcd. \u0b89\u0bc8\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bae\u0b95\u0bbe\u0ba4\u0bcd\u0bae\u0bbe \u0b95\u0bbe\u0ba8\u0bcd\u0ba4\u0bbf, \u0b85\u0ba9\u0bcd\u0bae\u0ba9 \u0baa\u0bc2\u0baa\u0ba4\u0bbf, \u0ba4\u0bbf\u0bb2\u0bc0\u0baa\u0ba9\u0bcd, \u0b89\u0ba3\u0bcd\u0ba3\u0bbe\u0bb5\u0bbf\u0bb0\u0ba4\u0bae\u0bcd \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0b87\u0bb1\u0ba8\u0bcd\u0ba4 \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0baa\u0bc8\u0bb0\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf \u0bb0\u0baa\u0bc6\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b85\u0bb5\u0bcd\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0ba4\u0bbf\u0bb2\u0bc0\u0baa\u0ba9\u0bc1\u0bae\u0b9f\u0baf \u0b89\u0bb0\u0bc1\u0bb5\u0b9a\u0bcd \u0bc6\u0bbf\u0bae\u0bc8\u0bae\u0baf \u0baa\u0bc8\u0bbe\u0ba4\u0bcd\u0b95\u0bbe\u0bb0\u0bae\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0b9a\u0bcd \u0b9a\u0bc6\u0ba9\u0bcd\u0bb1 \u0b9a\u0baa\u0bbe\u0bb2\u0bbf\u0bb8\u0bcd \u0b85\u0bb0\u0bbe\u0b9c\u0b95\u0ba4\u0bcd\u0bae\u0ba4 \u0b87\u0ba9\u0bcd\u0bb1\u0bc1 \u0bc6\u0bb0\u0bcd\u0bb5\u0bb0\u0ba4\u0bc6 \u0bc6\u0bae\u0bc2\u0b95\u0bae\u0bc1\u0bae\u0bcd \u0ba4\u0bae\u0bbf\u0bb4\u0bcd \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0bae\u0bbf\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0b89\u0ba9\u0bcd\u0ba9\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b9a\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0ba4\u0bbf\u0bb2\u0bc0\u0baa\u0ba9\u0bc1\u0bae\u0b9f\u0baf \u0b85\u0ba8\u0bcd\u0ba4 \u0b89\u0bb0\u0bc1\u0bb5\u0b9a\u0bcd \u0bc6\u0bbf\u0bae\u0bc8 \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0bc6\u0bae\u0bbe\u0ba4\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b8e\u0ba9\u0bcd\u0ba9 \u0b95\u0bc1\u0bae\u0bc8\u0bae\u0bb5 \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0ba4\u0bc1?\n\n\u0b87\u0baa\u0bcd\u0b9a\u0baa\u0bbe\u0bb4\u0bc1\u0ba4\u0bc1\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0bb5\u0bbf\u0b9f\u0bc1\u0ba4\u0bae\u0bc8\u0baa\u0bcd \u0baa\u0bc1\u0bb2\u0bbf\u0b95\u0bb3\u0bcd \u0bae\u0bc0\u0ba4\u0bbe\u0ba9 \u0ba4\u0bae\u0b9f \u0b89\u0ba3\u0bcd\u0b9f\u0bc1. \u0baf\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0bae\u0bc1\u0b9f\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1 17 \u0bb5\u0bb0\u0bc1\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbe\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b87\u0b99\u0bcd\u0b95\u0bc1 \u0b92\u0bb0\u0bc1 \u0b95\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b9a\u0bcd \u0bc6\u0ba4\u0bcd\u0ba4\u0bae\u0bc1\u0bae\u0bcd \u0bb0\u0b95\u0b9f\u0bcd\u0b95\u0bb5\u0bbf\u0bb2\u0bcd\u0bae\u0bc8. \u0b8e\u0ba8\u0bcd\u0ba4\u0b9a\u0bb5\u0bbe\u0bb0\u0bc1 \u0ba4\u0bae\u0bbf\u0bb4\u0bcd \u0b87\u0bae\u0bb3\u0b9e\u0ba9\u0bc1\u0bae\u0bcd \u0bc6\u0bbf\u0b99\u0bcd\u0b95\u0bb3 \u0b87\u0bb0\u0bbe\u0ba3\u0bc1\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8e\u0ba4\u0bbf\u0bb0\u0bbe\u0b95\u0bb0\u0bb5\u0bbe, \u0baa\u0bae\u0b9f\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8e\u0ba4\u0bbf\u0bb0\u0bbe\u0b95\u0bb0\u0bb5\u0bbe, \u0bc6\u0bbf\u0b99\u0bcd\u0b95\u0bb3 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8e\u0ba4\u0bbf\u0bb0\u0bbe\u0b95\u0bb0\u0bb5\u0bbe \u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0b95\u0bcd\u0b95\u0bbf\u0b95\u0bae\u0bb3\u0ba4\u0bcd \u0ba4\u0bc2\u0b95\u0bcd\u0b95\u0bb5\u0bbf\u0bb2\u0bcd\u0bae\u0bc8. \u0b85\u0baa\u0bcd\u0baa\u0b9f\u0bbf\u0b9a\u0baf\u0ba9\u0bcd\u0bb1\u0bbe\u0bb2\u0bcd, \u0b8f\u0ba9\u0bcd \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0b85\u0ba8\u0bcd\u0ba4\u0ba4\u0bcd \u0ba4\u0bae\u0b9f\u0bae\u0baf \u0bae\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bcd? \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0bbf\u0baf\u0bbe\u0baf\u0bae\u0bbe\u0ba9 \u0b93\u0bb0\u0bcd \u0b85\u0bb0\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd, \u0b87\u0ba8\u0bcd\u0ba4 \u0b85\u0bb0\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0ba8\u0bc0\u0ba4\u0bbf\u0baf\u0bbe\u0ba9 \u0ba4\u0ba9\u0bcd\u0bae\u0bae\u0bae\u0baf \u0b9a\u0bb5\u0bb3\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4 \u0bae\u0bc1\u0bae\u0ba9\u0ba8\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd, \u0bae\u0bc1\u0ba4\u0bb2\u0bbf\u0bb2\u0bcd \u0ba4\u0bae\u0bbf\u0bb4\u0bc0\u0bb4 \u0bb5\u0bbf\u0b9f\u0bc1\u0ba4\u0bae\u0bc8\u0baa\u0bcd \u0baa\u0bc1\u0bb2\u0bbf\u0b95\u0bb3\u0bcd \u0bae\u0bc0\u0ba4\u0bbe\u0ba9 \u0ba4\u0bae\u0b9f\u0bae\u0baf \u0ba8\u0bc0\u0b95\u0bcd\u0b95\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd; \u0bc6\u0bae\u0bbe\u0ba4\u0bbe\u0ba9\u0ba4\u0bcd\u0bae\u0ba4 \u0b89\u0bb0\u0bc1\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd; \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0b9f\u0bae\u0bcd \u0ba8\u0bb2\u0bcd\u0b9a\u0bc8\u0ba3\u0bcd\u0ba3\u0b99\u0bcd\u0b95\u0bae\u0bb3 \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd! \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bae\u0bcd\n\n147 148\n\n[\u0d9c\u0dbb\u0dd4 \u0dc3\u0dd2\u0dd9\u0da5\u0dcf\u0db1\u0dda \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dbb\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dcf]\n\n2026 \u0d94\u0d9a\u0daf\u0dad\u0ddd\u0dd9\u0dbb\u0dca\u0dbd 06\n\n\u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 \u0b85\u0ba4\u0bc1\u0ba4\u0bbe\u0ba9\u0bcd. \u0ba4\u0bae\u0bbf\u0bb4\u0bcd \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1, \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\u0bae\u0bc0\u0ba4\u0bc1 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1, \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95\u0baa\u0bcd \u0bb0\u0baa\u0bbe\u0bb0\u0bbe\u0b9f\u0bbf\u0baf\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\u0bae\u0bc0\u0ba4\u0bc1 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0ba4\u0bae\u0b9f\u0b95\u0bae\u0bb3 \u0ba8\u0bc0\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bc1\u0ba4\u0bbe\u0ba9\u0bcd. \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bbe\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf\u0bae\u0b95\u0baa\u0bcd \u0baa\u0bc2\u0bae\u0bb5 \u0bae\u0b95\u0baf\u0bbf\u0bb2\u0bcd \u0bae\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bbe\u0ba4\u0bc1. \u0b85\u0bb5\u0bcd\u0bb5\u0bbe\u0bb1\u0bc1 \u0bae\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b8e\u0ba4\u0bbf\u0bb0\u0bbe\u0b95 \u0baa\u0baf\u0b99\u0bcd\u0b95\u0bb0\u0bb5\u0bbe\u0ba4\u0ba4\u0bcd \u0ba4\u0bae\u0b9f\u0b9a\u0bcd \u0bc6\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0baa\u0bbe\u0baf\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b85\u0bb0\u0ba4\u0bb0\u0baa\u0bbe\u0bb2\u0bcd, \u0baa\u0bc1\u0bb2\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b89\u0bb0\u0bc1\u0bb5\u0ba4\u0bcd\u0bae\u0ba4 \u0ba4\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0b9f\u0baf \u0bae\u0b95\u0baf\u0bbf\u0bb2\u0bcd \u0b95\u0bc0\u0bb1 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bbe\u0ba4\u0bc1; \u0b85\u0ba4\u0ba9\u0bcd \u0baa\u0b9f\u0ba4\u0bcd\u0bae\u0ba4 \u0bae\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bbe\u0ba4\u0bc1. \u0b85\u0bb5\u0bcd\u0bb5\u0bbe\u0bb1\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b8e\u0ba4\u0bbf\u0bb0\u0bbe\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0baa\u0baf\u0b99\u0bcd\u0b95\u0bb0\u0bb5\u0bbe\u0ba4\u0ba4\u0bcd \u0ba4\u0bae\u0b9f\u0b9a\u0bcd \u0bc6\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0baa\u0bbe\u0baf\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1, \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0ba4\u0bae\u0bbf\u0bb4\u0bcd\u0b9a\u0bcd \u0bc6\u0b99\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b9a\u0b95\u0bbe\u0b9f\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbf\u0bb2\u0bcd\u0bb2\u0bc1, \u0b85\u0bae\u0bcd\u0baa\u0bc1, \u0bae\u0bc0\u0ba9\u0bcd, \u0baa\u0bc1\u0bb2\u0bbf \u0b8e\u0ba9\u0bcd\u0baa\u0ba9 \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0ba9. \u0b87\u0bae\u0bb5 \u0ba4\u0bae\u0bbf\u0bb4\u0bcd\u0b9a\u0bcd \u0bc6\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bc6\u0bbf\u0ba9\u0bcd\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd! \u0b85\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0b9a\u0b95\u0bbe\u0b9f\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0baa\u0bc1\u0bb2\u0bbf \u0bc6\u0bbf\u0ba9\u0bcd\u0ba9\u0ba4\u0bcd\u0bae\u0ba4 \u0baa\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b8e\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0b85\u0ba8\u0bcd\u0ba4\u0bb3\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb0\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b85\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd; \u0b87\u0bb0\u0bbe\u0ba3\u0bc1\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bb0\u0b95\u0bb3\u0bcd\u0bb5\u0bbf\u0b95\u0bb3\u0bcd!"
  },
