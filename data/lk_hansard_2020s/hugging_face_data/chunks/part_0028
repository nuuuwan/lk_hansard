    "chunk_text": "(\u0dad) (i) \u0daf\u0dd2\u0dcf\u0dba\u0dd2\u0dad\u0dbb\u0db4\u0dd4\u0dcf\u0daf\u0dbb\u0dd9\u0dc0\u0daf\u0dcf\u0dad\u0dd4\u0dc0 \u0dbb\u0dc0\u0daf\u0dca\u0dc2\u0da7\u0dbb\u0dc4\u0daf\u0dbb\u0daf\u0dd6\u0dcf\u0dc3\u0dca\u0dad\u0dcf\u0dbb\u0dad\u0dc0\u0dba\u0daf\u0db1\u0dad\u0dbb\u0dd9\u0dca\u0dca \u0daf\u0dca\u200d\u0dbb\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0dad\u0dbb-\u0dbbITDLHs - 10]\u0dca\u0dbb\u0dad\u0dc0\u0dba\u0daf\u0db1\u0dad,\u0dbb\u0db4\u0dc3\u0dca\u0dc3\u0dca\u0dad\u0dbb\u0dad\u0dc0\u0dba\u0daf\u0db1\u0dad\u0dbb\u0dc3\u0dca\u0dc4\u0dbb\u0dcf\u0dd8\u0dca \u0dbb\u0dd4\u0db1\u0dbb\u0dad\u0dc0\u0dba\u0daf\u0db1\u0dad\u0dbb\u0dad\u0dca\u0daf\u0dc0\u0dba\u0daf\u0d82\u0dba\u0dd9\u0dcf\u0dbb\u0daf\u0dd6\u0dcf\u0dc3\u0dca\u0dad\u0dcf\u0dbb\u0dad\u0dc0\u0dba\u0daf\u0db1\u0dad\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dcf\u0d9a\u0dc0\u0dad\u0dbb\u0dba\u0daf\u0d9b\u0dca\u200d\u0daf\u0dcf\u0dbb\u0db1\u0db4\u0dd9\u0dca \u0dbb\u200d\u0dbb\u0dd2\u0db1\u0daf\u0dca \u0dca\u0da7\u0dbb\u0dcf\u0dad\u0dbb\u0dad\u0dc0\u0dcf,\u0dbb\u0dd9\u0da7\u0daf\u0da7\u0dca\u0db0\u0daf\u0dc3\u0dca\u0dbb\u0dca\u0da7\u0dca\u0db4\u0db8\u0dd2\u0dca \u0dbb\u0dd9\u0dad\u0daf\u0dcf\u0dbb\u0dad\u0dc0\u0dba\u0daf\u0db1\u0dad\u0dbb\u0da7\u0dbd\u0daf\u0db1\u0dbb\u0dca\u0da7\u0dca\u0db4\u0db8\u0dd2\u0dca \u0dbb\u0d92\u0dcf\u0daf\u0dbb\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0db4\u0dd2\u0dc0\u0dbb\u0da7\u0dcf\u0dbb\u0dbd\u0dc0.\n\n\u0dcf\u0d9a\u0dc0\u0dca\u0daf\u0dad\u0dd9\u0dcf\u0dbbITDLH \u0dd9\u0dbd\u0dc3\u0dca\u0dbb\u0dc4\u0db1\u0dd2 \u0dca \u0dd9\u0dcf\u0dad\u0dbb\u0dd9\u0dca\u0dca\u0dbb\u0dca\u0dc0\u0dba\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0dad\u0dbb\u0d91\u0dcf\u0da7\u0db4\u0dbb\u0db1\u0dbb\u0dd2\u0dd0\u0da7\u0da7\u0dbb\u0dc3\u0dca \u0db1\u0dca \u0dbb\u0dca\u0dc0\u0dba\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0dad\u0dbb- CRC - \u0dad\u0db8\u0dd2\u0dca \u0dbb\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0db4\u0dd2\u0dc0\u0dbb\u0da7\u0dcf\u0dbb\u0dbd\u0dd2\u0dbb\u0dbb\u0dad\u0dc0\u0dcf,\u0dbb\u0d91\u0dca\u0dbb\u0dca\u0dc0\u0dba\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0dad\u0dbb\u0db4\u0dd2\u0dc4\u0dd2\u0dd4\u0db8\u0dc0\u0dd3\u0dd9 \u0dbb\u0dad\u0dcf\u0db8\u0dd4\u0dab\u0dd4\u0dbb\u0db1\u0dc4\u0dc0\u0dbb\u0db1\u0dbb\u0dd2\u0daf\u0dd2\u0dbb\u0dd9\u0dc1.\u0dbb\u0dbb\n\n\u2022 \u0dad.\u0dd9\u0db1\u0daf.\u0dc3\u0dca.\u0dbb(\u0dc3\u0dca\u0daf/\u0dd9\u0db1\u0dd9)\u0dbb\u0dc3\u0dca\u0dc4\u0dbb\u0dad.\u0dd9\u0db1\u0daf.\u0dc3\u0dca.\u0dbb(\u0db4/\u0dd9\u0db1\u0dd9)\u0dbb \u0dc0\u0dd2\u0dcf\u0daf\u0dd0\u0dcf\u0dd2\u0dca \u0dbb\u0db1\u0dc3\u0dd4\u0dbb\u0d9a \u0dc3\u0dd4\u0dca \u0db4\u0dbb\u0db1\u0dbb\u0dd2\u0dd0\u0da7\u0da7\u0dbb\u0dc4\u0daf\u0dbb \u0dd9\u0dc0\u0daf\u0dcf\u0dad\u0dd4\u0dc0 \u0dbb\u0dc0\u0daf\u0dca\u0dc2\u0da7\u0dbb\u0dad\u0dc0\u0dba\u0daf\u0db1\u0dad\u0db1\u0dbb\u0dc3\u0dca\u0dc4\u0dbb\u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dcf\u0dbb \u0dbd\u0db6\u0daf\u0dbb\u0daf\u0dd3\u0dca.\n\n\u2022 \u0db1\u0dbb\u0dd2\u0dd0\u0da7\u0da7\u0dbb\u0dc3\u0dca\u0dc4\u0dbb\u0dd6\u0dbd\u0dd2\u0da7\u0dbb\u0dd9\u0db1\u0dba\u0dc0\u0dd4 \u0dbb\u0dca\u0dd8\u0daf\u0dd4\u0da7\u0daf\u0d82\u0dd0\u0dbb\u0dcf\u0daf\u0dc0\u0dd2\u0dc0\u0db1\u0dbb \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dcf\u0dbb\u0d9a \u0dc3\u0dd4\u0dca \u0dd9 \u0dbb\u0db4\u0dca\u200d\u0dbb\u0daf\u0dd9\u0db1 \u0d9c\u0dd2\u0da7\u0dbb\u0d9a\u0dd4\u0dc3\u0dca\u0dbd\u0dc0\u0daf\u0dbb \u0dcf\u0d9a\u0dc0\u0dad\u0db1\u0dbb\u0dd2\u0dbb\u0dd3\u0db8\u0dca.\n\n\u2022 \u0d89\u0dd0\u0db1\u0dca \u0dc0\u0dd3 \u0dbb\u0dc4\u0daf\u0dbb\u0d89\u0dd9\u0dd0\u0dd4\u0dc0 \u0dbb\u200d\u0dbb\u0dd2\u0db1\u0daf\u0dcf\u0dd2\u0db1\u0dbb\u0dc3\u0dca\u0db3\u0dc4\u0daf\u0dbb \u0db1\u0dbb\u0dd2\u0dd0\u0da7\u0da7\u0dbb\u0dcf\u0daf\u0dc0\u0dd2\u0dc0\u0db1\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dcf\u0d9a\u0dc0\u0dad\u0db1\u0dbb\u0dd2\u0dbb\u0dd3\u0db8\u0dca.\n\n\u2022 \u0db1\u0daf\u0dc3\u0dca\u0dbd\u0dca\u0dbb\u0dad\u0dc0\u0dcf\u0dbb\u0db1\u0dcf\u0dd2\u0dbb\u0dad\u0dbbICT \u0dc3\u0dca \u0db1\u0dca \u0dbb\u0db4\u0db1\u0dbb\u0dd2\u0dca\u0dbb\u0dc4\u0daf\u0dbb \u0da7\u0daf\u0d9a\u0db1\u0dca\u0dc2\u0dca\u0dbb\u0dd9\u0dbd\u0dc3\u0dca\u0dbb\u0dcf\u0daf\u0dc0\u0dd2\u0dc0\u0dbb\u0dd2\u0dbb\u0dd3\u0db8\u0dca\u0dbb\u0dc3\u0dca\u0dc4\u0dbb\u0dd9\u0db6\u0dba\u0daf\u0dc4\u0dba\u0daf\u0dbb \u0dd0\u0db1\u0dd3\u0db8\u0dca.\n\n\u2022 \u0dd9\u0dc0\u0daf\u0dcf\u0dad\u0dd4\u0dc0 \u0dbb\u0dc0\u0daf\u0dca\u0dc2\u0da7\u0dbb\u0dca\u0dd9\u0dc2\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd9\u0dcf\u0dbb\u0dcf\u0db1\u0da2\u0dd2\u0daf\u0dd4\u0dcf\u0dbb \u0dad\u0dc0\u0dba\u0daf\u0db1\u0dad\u0db1,\u0dbb\u0dcf\u0dd8\u0dca \u0dbb\u0dd4\u0db1\u0dbb\u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dcf\u0dbb\u0dc3\u0dca\u0dc4\u0dbb\u0dbb\u0dd0\u0dd2\u0dbb\u0db1\u0daf\u0dbb \u0dad\u0dcf\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0dbb\u0dc3\u0dca\u0db3\u0dc4\u0daf\u0dbb\u0dad\u0dcf\u0dba\u0dba\u0dbb\u0dd6\u0dbd\u0dd2\u0da7\u0dbb\u0db1\u0dba\u0dad\u0dca\u0dbb\u0dc3\u0dca\u0da7\u0dc3\u0dca\u0dad\u0dbb\u0dd2\u0dbb\u0dd3\u0db8\u0dca.\n\n\u2022 \u0dd9\u0dc1\u0dd0\u0dd9\u0db1\u0dca \u0dbb\u0dd9\u0dcf\u0dad\u0dc3\u0dca\u0dad\u0dbb\u0dcf\u0dad\u0dbb\u0dc0\u0daf\u0dca\u0dc2\u0dd2\u0dba\u0da7\u0dbb\u0db1\u0dbb\u0dd2\u0dc3\u0dca\u0dcf\u0db1\u0db4\u0dbb \u0dad\u0dd4\u0dc0\u0dcf\u0d9a\u0dc0\u0dad\u0db1\u0dbb\u0dc0\u0dd3\u0dca\u0db4\u0dbb\u0dad\u0dcf\u0dba\u0dba\u0dbb\u0dba\u0db1\u0dd4\u0dc0\u0dca\u0dbb\u0dc4\u0daf\u0dbb\u0d9a\u0dd4\u0dc3\u0dca\u0dbd\u0dc0\u0daf\u0dbb \u0d9a \u0dc3\u0dd4\u0dca \u0dbb\u0dad\u0dd4\u0dd9\u0dbb\u0dcf\u0d9a\u0dc0\u0dad\u0db1\u0dbb\u0dd2\u0dbb\u0dd3\u0db8\u0dca.\n\n\u0dcf\u0d9a\u0dc0\u0dca\u0daf\u0dad\u0dd9\u0dcf\u0dbb\u0dd9\u0dca\u0dca\u0dbb\u0dca\u0dc0\u0dba\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0dad\u0dbb\u0dca\u0d9f\u0dd2\u0dca \u0dbb\u0db1\u0dc4\u0dc0\u0dbb\u0da7\u0daf\u0d9a\u0db1\u0db1\u0dca \u0dbb\u0d89\u0dd4\u0db8\u0dbb\u0da7\u0dcf\u0dd4\u0dc0\u0dbb\u0dbd\u0db6\u0dba\u0dd2. \u2022 \u0db1\u0daf\u0dc3\u0dca\u0dbd\u0dca\u0dbb\u0d9a \u0dc3\u0dd4\u0dca ,\u0dbb\u0dad.\u0dd9\u0db1\u0daf.\u0dc3\u0dca.\u0dbb(\u0dc3\u0dca\u0daf.\u0dd9\u0db1\u0dd9)\u0dbb\u0dc3\u0dca\u0dc4\u0dbb \u0dad.\u0dd9\u0db1\u0daf.\u0dc3\u0dca.\u0dbb (\u0db4.\u0dd9\u0db1\u0dd9)\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0dbd\u0dbd\u0dbb\u0dad\u0dd9\u0dda\u0dca\u0dc2\u0dd2\u0dad\u0dc0\u0dbb\u0d9a \u0dc3\u0dd4\u0dca \u0dbb \u0dc3\u0dca\u0db3\u0dc4\u0daf\u0dbb\u0dd9\u0da7 \u0d9a\u0dbb\u0dbb\u0da7\u0daf\u0dbd\u0dd3\u0dad\u0dbb\u0dbb\u0dd9\u0dc0\u0daf\u0dcf\u0dad\u0dd4\u0dc0 \u0dbb \u0dc0\u0daf\u0dca\u0dc2\u0da7\u0dbb \u0db1\u0daf\u0db0\u0dca\u0daf\u0dbd\u0daf\u0dbb \u0db1\u0db1\u0dcf\u0db1\u0dca \u0dc0\u0dd3\u0dca. \u2022 \u0db1\u0daf\u0dc3\u0dca\u0dbd\u0dca\u0dbb\u0dc4\u0db1\u0dcf\u0dbb\u0d9c\u0dd2\u0db1\u0dbb\u0d9a \u0dc3\u0dd4\u0dca \u0dbb\u0dbb\u0dd0\u0dd2\u0dbb\u0db1\u0daf\u0dbb\u0dd9\u0dcf\u0dd9\u0dd9\u0db3\u0dbb\u0dd9\u0db1\u0daf\u0dd9\u0db4\u0dbb \u0dd9\u0db1\u0daf\u0db8\u0dd4\u0dbb\u0dd2\u0dbb\u0dd3\u0db8\u0dca\u0dbb\u0dad\u0dcf\u0db8\u0dd4\u0dab\u0dd4\u0dbb\u0da7\u0dcf\u0dd0\u0dca \u0dbb\u0db1\u0daf\u0db0\u0dca\u0daf\u0dbd\u0daf\u0dbb \u0db1\u0db1\u0dcf\u0db1\u0dca \u0dc0\u0dd3\u0dca.\u0dbb(\u0db4\u0dba\u0daf \u0dbbNVQ \u0db1\u0daf\u0db0\u0dca\u0daf\u0dbd\u0daf)\n\n\u2022 \u0dad\u0dc0\u0dba\u0daf\u0db1\u0dad\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0dc3\u0dca\u0d82\u0dc3\u0dca\u0dad\u0da7\u0dcf\u0da7\u0dcf\u0dbd\u0db4\u0dbb\u0dad\u0dba\u0daf\u0dd9\u0dbb \u0dc0 \u0dbb \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dbb\u0da7\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0dbb\u0dc3\u0dca\u0db3\u0dc4\u0daf\u0dbb\u0db1\u0dc4\u0dc3\u0dd4\u0da7 \u0dbb\u0dc3\u0dca\u0db1\u0db1\u0dba\u0dd3\u0dca.\n\n\u2022 \u0dc0\u0dd2\u0daf\u0dd4\u0dc4\u0dbd\u0dca\u0db1\u0dd2\u0dbb\u0dcf\u0dc0 \u0dca ,\u0dbb \u0dc0 \u0dcf\u0dcf\u0dad\u0dd4\u0dca ,\u0dbb\u0dd9\u0dcf\u0dad\u0dca \u0dbb\u0dcf\u0dca\u200d\u0dd9\u0dcf\u0dbb \u0dd9\u0dc3\u0dca\u0dad\u0dcf\u0da7\u0dba\u0dd2\u0dca \u0dbb\u0dd9\u0dca\u0dca \u0dca\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dca\u200d\u0daf\u0dcf\u0dbb\u0dc3\u0dca\u0db3\u0dc4\u0daf\u0dbb\u0dba\u0dbb\u0dd9\u0dc0\u0daf\u0dcf\u0dad\u0dd4\u0dc0 \u0dbb \u0dc0\u0daf\u0dca\u0dc2\u0da7\u0dbb\u0d9a\u0dd4\u0dc3\u0dca\u0dbd\u0dc0\u0daf\u0dbb\u0dc3\u0dca\u0d82\u0dcf\u0d9a\u0dc0\u0dad\u0db1\u0dbb\u0dd2\u0dbb\u0dd3\u0db8\u0dca\u0dbb\u0dad\u0dcf\u0db8\u0dd4\u0dab\u0dd4\u0dbb \u0da7\u0dcf\u0dd0\u0db1\u0dd2\u0db8\u0dd2\u0dca \u0dbb\u0dc0\u0dd2\u0dc0\u0dd2\u0dc0\u0dbb\u0dcf\u0db1 \u0dc3\u0dca\u0db4\u0dc4\u0dca \u0dbb \u0db1\u0db1\u0dcf\u0db1\u0dca \u0dc0\u0dd3\u0dca.\n\n\u2022 \u0dca\u0daf\u0d9a\u0dd0\u0dd0\u0dc0\u0dcf\u0dbb\u0dc0\u0dd2\u0dcf\u0daf\u0dd0\u0dbb\u0db1\u0db1\u0dcf\u0db1\u0dca \u0dc0\u0dd3\u0dca\u0dbb\u0dc3\u0dca\u0db3\u0dc4\u0daf\u0dbb\u0db1\u0dc4\u0dc3\u0dd4\u0da7 \u0dbb \u0dc3\u0dca\u0db1\u0db1\u0dba\u0dd3\u0dca.\n\n\u2022 \u0dc0\u0dd2\u0dba\u0dad\u0dcf\u0dc0\u0dd2\u0dba\u0dba\u0daf\u0dbd\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dd9\u0dc1\u0dba\u0db1\u0dbb\u0dc3\u0dca\u0db3\u0dc4\u0daf\u0dbb\u0dca\u0daf\u0d9a\u0dd0\u0dd0\u0dc0\u0dcf\u0dbb\u0dad\u0db1\u0daf\u0dd4 \u0dbb \u0dd2\u0dbb\u0dd3\u0db8\u0dca\u0db4\u0dbb\u0db1\u0dc4\u0dc3\u0dd4\u0da7 \u0dbb\u0dc3\u0dca\u0db1\u0db1\u0dba\u0dd3\u0dca.\n\n(ii) \u0d94\u0dc1.\u0dbb\n\n(iii) \u0db4\u0dad\u0dd4\u0dc0 \u0dbb\u0dc3\u0dca\u0dc4\u0dbb\u0dad\u0db1\u0dbb\u0dd9 \u0dad\u0dc4\u0dd2\u0dcf\u0dbb\u0db1\u0dd9\u0daf\u0dca \u0dcf\u0dbd\u0db4\u0dbb\u0dad\u0db1\u0dca \u0dbb\u0db1\u0dc4\u0dc0\u0dbb \u0dc3\u0dca\u0db3\u0dc4\u0dca \u0dbb\u0da7\u0dbd\u0daf\u0db1\u0dcf\u0dbd\u0dbbITDLH \u0dca\u0dc0\u0dba\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0dad\u0dbb\u0dba\u0db1\u0dad\u0db4\u0dbb (2026)\u0dbb\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0db4\u0dd2\u0dc0\u0dbb\u0da7\u0dcf\u0dbb\u0dd9\u0dad\u0daf\u0dca\u0db1\u0dc0.\u0dbb\n\n(\u0d89\u0dc4\u0dc0\u0dbb\u0dc3\u0dca\u0db3\u0dc4\u0dca \u0dbb\u0db4\u0dad\u0dd4\u0dc0 \u0dbb\u0dc3\u0dca\u0dc4\u0dbb\u0dad\u0db1\u0dbb\u0dd9 \u0dad\u0dc4\u0dd2\u0dcf\u0dbb\u0db1\u0dd9\u0daf\u0dca \u0dcf\u0dbd\u0dbbITDLH \u0dca\u0dc0\u0dba\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0dad\u0dbb0\u0dbb\u0dbd\u0dad\u0dd4\u0dc5\u0dd4\u0dcf\u0dbb\u0daf\u0dd2\u0dcf\u0dba\u0dd2\u0dad\u0dbb\u0db4\u0dd4\u0dcf\u0daf\u0dbbITDLH \u0dca\u0dc0\u0dba\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0dad\u0dbb\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0db4\u