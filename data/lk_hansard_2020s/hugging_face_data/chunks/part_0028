    "chunk_text": "2026 \u0d85\u0d82\u0d9a 2 \u0dbb\u0db1 \u0dc0\u0dd2\u0daf\u0dda\u0dc1 \u0dc0\u0dd2\u0db1\u0dd2\u0db8\u0dba \u0daf\u0dbb\u0dab\u0dc0\u0dbd\u0dcf\u0dc3\u0dd2 \u0dba\u0da7\u0daf\u0dad\u0dca \u0d87\u0dad\u0dd4.\u0dad\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca, \u0dc0\u0dd2\u0daf\u0dc1\u0db1 \u0daf\u0dba\u0db1\u0dca\u0db8 \u0dbd\u0dcf\u0d82\u0d9a\u0dd2\u0d9a\u0daf\u0dba\u0d9a \u0daf\u0dd9\u0db1\u0dad\u0dca \u0dbb\u0da7\u0d9a \u0daf\u0db1\u0dca\u0dd9\u0dcf\u0dc3\u0dd2\u0d9a\u0dad\u0dca\u0dd9\u0dba \u0dbd\u0dd9\u0dcf\u0daf\u0d9c\u0db1 \u0dc0\u0dd2\u0d9c\u0dcf\u0db8\u0dd2\u0d9a\u0daf\u0dba\u0d9a\u0dd4 \u0dd9\u0dd9\u0da7 \u0db4\u0dad\u0dca \u0dc0\u0dd4\u0dab\u0dcf\u0db8 \u0daf\u0dda \u0dbb\u0daf\u0dda \u0d87\u0dad\u0dd2 \u0dad\u0db8\u0db1\u0dca\u0daf\u0dda \u0dd9\u0dad\u0dca\u0d9a\u0dda \u0d92 \u0dbb\u0da7\u0da7 \u0dbb\u0dd0\u0daf\u0d9c\u0db1 \u0dba\u0dd1\u0daf\u0dda\u0daf\u0dd3 \u0dbd\u0dd9\u0dcf \u0daf \u0db1 \u0dc3\u0dcf\u0d82\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dab\u0dd2\u0d9a \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dd9 \u0dc5\u0dd2\u0db6\u0db3\u0dd9\u0db3\u0dd9\u0dba\u0dd2. \u0d85\u0daf\u0dda \u0dbb\u0daf\u0dda \u0da2\u0dd3\u0dd9\u0dad\u0dca \u0dc0\u0dd6 \u0d89\u0dda\u0d9c\u0dbd\u0daf\u0dba\u0d9a\u0dd4 \u0dc0\u0dd2\u0d9c\u0dcf\u0db8\u0dd2\u0d9a\u0daf\u0dba\u0d9a\u0dd4 \u0dd9\u0dd9\u0da7 \u0db4\u0dad\u0dca \u0daf\u0dd9\u0dbd\u0dcf \u0dad\u0db8\u0db1\u0dca\u0daf\u0dda \u0dd9\u0dad\u0dca\u0d9a\u0dda \u0dbb\u0dd0\u0daf\u0d9c\u0db1 \u0dba\u0db1\u0daf\u0d9a\u0dcf\u0da7, \u0db4.\u0dd4\u0daf\u0dd9\u0dd0\u0db1\u0dd2 \u0dd9\u0dad\u0dcf\u0dd9\u0da7 \u0d8b\u0db4\u0dad\u0dca\u0db8 \u0dd9\u0dc1\u0daf\u0dba\u0db1\u0dca \u0d87\u0daf\u0db8\u0dad\u0dca\u0d9a\u0dcf\u0db1\u0dd4 \u0daf \u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0dbd\u0d9a \u0dba\u0d9a \u0dc3\u0dc4 \u0dd2\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dd9 \u0d91.\u0daf\u0db9\u0db1 \u0dc3\u0dd1\u0db8 \u0dd9\u0dbb\u0dca\u0dbd \u0dba\u0d9a\u0daf\u0dd3\u0db8 \u0d87\u0daf\u0db8\u0dad\u0dca\u0d9a\u0dcf\u0db1\u0dd4 \u0daf \u0dcf\u0dbd\u0dbb\u0dca\u0dbd 30,000\u0d9a \u0dd9\u0dd0\u0d9c\u0dd2\u0db1\u0dca \u0dbb\u0dd0\u0daf\u0d9c\u0db1 \u0dba\u0dd1\u0daf\u0dda \u0d85\u0dd9\u0dc3\u0db1\u0dae\u0dcf\u0dd9 \u0daf\u0dda \u0dad\u0dd4\u0db6\u0db3\u0db1\u0dca \u0d85\u0dc5\u0dd2 \u0dbd\u0dd9\u0dcf \u0daf\u0dd3\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf. \u0d8a\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dd9 \u0dc0\u0dd2\u0daf\u0dda\u0dc1 \u0dc0\u0dd2\u0db1\u0dd2\u0db8\u0dba \u0db4\u0db1\u0daf\u0dad\u0dca 22\u0dd9\u0db1 \u0dd9\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0daf\u0dad\u0dca \u0dd9\u0db1 \u0db1\u0dd2\u0daf\u0dba\u0ddd\u0d9c\u0dba \u0db8\u0dd2\u0db1\u0db1\u0dca \u0daf\u0dda \u0dbb\u0daf\u0dda \u0db4\u0dd9\u0dad\u0dd2\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dd9\u0dba \u0dc3\u0dbd\u0d9a\u0dcf \u0dd9\u0dbd\u0dcf, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db8\u0dc4 \u0dd9\u0dd0\u0d82\u0d9a\u0dd4\u0daf \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0daf\u0dda\u0dc1\u0dba\u0db1\u0dca\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dd9 \u0d85\u0daf\u0dda \u0dc0\u0dd2\u0daf\u0dda\u0dc1 \u0dc0\u0dd2\u0db1\u0dd2\u0db8\u0dba \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d85\u0dd9\u0dc1\u0dba \u0db1\u0dd3\u0dad\u0dd2 \u0dc4\u0dcf \u0daf\u0dbb\u0dab\u0dc0\u0dbd\u0dcf\u0dc3\u0dd2 \u0daf\u0dda \u0dba\u0da7\u0daf\u0dad\u0dca \u0d9a\u0dd9\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf.\n\n\u0d8a\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dd9 \u0d9a\u0dd8\u0dd2\u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0db8\u0dd2\u0d9a \u0d85\u0d9c\u0dba \u0dcf\u0db8 \u0db8\u0dd6\u0dbd\u0dba\u0d9a\u0dbb\u0dab \u0dc4\u0dcf \u0dd9\u0dcf\u0dab\u0dd2\u0da2\u0d9a\u0dbb\u0dab \u0d9a\u0daf \u0db1\u0dad\u0dca\u200d\u0dbb \u0dc3\u0d82\u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0dba\u0db1 \u0dd9\u0dd0 \u0dc3\u0da7\u0dc4\u0db1 \u0dba\u0da7\u0daf\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0db0\u0dba\u0dcf\u0db1 \u0dd9\u0dc1\u0daf\u0dba\u0db1\u0dca \u0dd9\u0dbd\u0dcf\u0daf\u0db4\u0dcf\u0daf\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4 \u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0d9a\u0dd8\u0dd2\u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0db8\u0dd2\u0d9a \u0db1\u0dd2 \u0db1\u0db4\u0dcf \u0db1\u0dba, \u0d9c\u0dd9 \u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0d85\u0d9c\u0dba \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0d85\u0daf.\u0dc0\u0dd2\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0dc3\u0db8\u0dc3\u0db1\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0dcf\u0db8\u0dba\u0da7 \u0dc3\u0dc4\u0db1 \u0dcf\u0dd3 \u0db8\u0dd6\u0dbd\u0dba \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dda \u0dc3\u0dd0\u0db4\u0dd3\u0db8\u0dba\u0dd2. \u0daf\u0dda \u0dd9\u0dd0 \u0dc3\u0da7\u0dc4\u0db1 \u0dba\u0da7\u0daf\u0dad\u0dca \u0d87\u0daf\u0db8\u0dad\u0dca\u0d9a\u0dcf\u0db1\u0dd4 \u0daf \u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0db8\u0dd2\u0dd2\u0dba\u0db1 30\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0db4\u0dcf \u0d9a \u0dab\u0dba\u0d9a \u0dc3\u0dc4 \u0d87\u0daf\u0db8\u0dad\u0dca\u0d9a\u0dcf\u0db1\u0dd4 \u0daf \u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0db8\u0dd2\u0dd2\u0dba\u0db1 90\u0d9a \u0db8\u0dd6\u0dbd\u0dba \u0d85\u0dad\u0dbb\u0db8\u0dd0\u0dbb\u0dd2 \u0dab\u0dba\u0d9a \u0dd9\u0dc1\u0daf\u0dba\u0db1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0da7 \u0d91\u0db8 \u0db8\u0dd6\u0dbd\u0dba \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dda \u0dbd\u0dd0\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca.\n\n\u0daf\u0db8 \u0daf\u0daf\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dba\u0dcf\u0db1 \u0dd9\u0dc1\u0daf\u0dba\u0db1\u0dca\u0db8 \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0dda \u0dbd\u0dd9\u0db1 \u0d85\u0d82\u0dc1 \u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0dbb\u0dd9\u0dbb\u0dca\u0dbd, \u0daf\u0dad\u0dca, \u0d9a\u0dd4\u0dc5\u0dd4 \u0dd9\u0dd4, \u0daf\u0db4\u0dcf\u0dbd\u0dd3\u0db8, \u0d8b \u0dba\u0dcf\u0db1 \u0dd9\u0d9c\u0dcf\u0dd9, \u0da2\u0dbd\u0da2\u0dd3\u0dc0\u0dd3 \u0dd9\u0d9c\u0dcf\u0dd9, \u0db8\u0dad\u0dca\u0dc3\u0dba \u0dc3\u0dd0\u0d9a\u0dc3\u0dd4\u0dda, \u0d9a\u0dd2\u0dad\u0dca \u0dc3\u0dc4 \u0dc3\u0dad\u0dca\u0dd9 \u0d86\u0dc4\u0dcf\u0dbb \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0daf \u0db1\u0dad\u0dca\u200d\u0dbb\u0dba\u0dd2. \u0d92 \u0d9a\u0daf \u0db1\u0dad\u0dca\u200d\u0dbb\u0dd9\u0dbd\u0da7 \u0dad\u0db8\u0dba\u0dd2 \u0daf\u0db8 \u0daf\u0daf\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dba\u0dcf\u0db1\u0dad\u0dca\u0dd9\u0dba \u0dbd\u0dd9\u0dcf \u0daf \u0db1\u0dca\u0daf\u0db1\u0dca. \u0daf\u0dda \u0dd9\u0dd0 \u0dc3\u0da7\u0dc4\u0db1\u0dad\u0dca 2026 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0daf\u0dda \u0dd2\u0db3\u0dbd\u0dcf 2028 \u0d9a\u0dd9\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dd9\u0db1\u0dd9\u0dcf. \u0d91\u0d9a \u0dd9\u0dba\u0dd9\u0dc3\u0dcf\u0dba\u0d9a\u0daf\u0dba\u0d9a\u0dd4\u0da7 \u0d8b\u0db4\u0dad\u0dca\u0db8 \u0dd9\u0dc1\u0daf\u0dba\u0db1\u0dca \u0dbb\u0dd4\u0dc5\u0dd2\u0dba\u0dbd\u0dd3\u0db8 \u0db8\u0dd2\u0dd2\u0dba\u0db1 95\u0d9a \u0d9a\u0dd9\u0dcf \u0dab\u0dba \u0dd4\u0daf \u0dbd\u0d9a \u0dbd\u0dd9\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0daf\u0db8 \u0daf\u0daf\u0dd3 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dd9 \u0dbd\u0dd0\u0daf\u0dd9\u0db1\u0dd9\u0dcf. \u0d92 \u0dab\u0dba \u0d86\u0db4\u0dc3\u0dd4 \u0daf\u0d9c\u0dd9\u0db1\u0dca\u0db1 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 10\u0d9a \u0d9a\u0dcf\u0dbd \u0dd3\u0db8\u0dcf\u0dd9\u0d9a \u0dc3\u0dc4 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 2\u0d9a \u0d85\u0db8\u0dad\u0dbb \u0dc3\u0dc4\u0db1 \u0d9a\u0dcf\u0dbd\u0dba\u0d9a \u0dbd\u0dd0\u0daf\u0dd9\u0db1\u0dd9\u0dcf. 2026 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0dc5\u0dd2\u0dba\u0dbd\u0dd3\u0db8 \u0db6\u0dd2\u0dd2\u0dba\u0db1 6.2\u0d9a -\u0dbb\u0dd4\u0dc5\u0dd2\u0dba\u0dbd\u0dd3\u0db8 \u0db8\u0dd2\u0dd2\u0dba\u0db1 6,200\u0d9a - \u0daf\u0dda \u0daf\u0dd9\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dca \u0daf\u0dd9\u0db1\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf.\n\n165 166\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9"
