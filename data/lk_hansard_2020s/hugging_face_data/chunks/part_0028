    "chunk_text": "\u0d9c\u0dad\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0dbb\u0db8\u0dd2\u0dba, \u0dba\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8\u0db8 \u0d89\u0dc0\u0dbb \u0d9a\u0dbb\u0db1\u0dc0\u0dcf, \u0dc3\u0db8\u0dcf\u0dba\u0dc0\u0dda\u0db1\u0db4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0dad\u0dd4\u0dbb\u0db8\u0dcf \u0dba\u0db8\u0dca \u0db8\u0dcf\u0dc3\u0dba\u0dda \u0d85\u0d9c\u0dad \u0dba\u0db8\u0dba\u0dbb \u0db6\u0dc3\u0dca \u0dba\u0dc3\u0dca\u0dc0\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc0\u0dd8\u0dad\u0dca\u200d \u0d9a \u0dcf\u0db8 \u0d91\u0dca\u0d9a\u0dbd \u0daf\u0d9a\u0dca\u0dad\u0dc0\u0dcf \u0d92 \u0db6\u0dc3\u0dca \u0dba\u0db1\u0dc0\u0dcf, \u0dba\u0db8\u0dcf\u0dbb\u0dd4\u0db4\u0dc0 \u0daf\u0d9a\u0dca\u0dad\u0dc0\u0dcf \u0dba\u0db1\u0dc0\u0dcf\u0db4 \u0d92 \u0dc0\u0dcf\u0dba \u0db8 \u0d9c\u0dad\u0dcf\u0dbd\u0dca\u0dbd\u0da7, \u0db1\u0dd4\u0dc0\u0dbb\u0da7, \u0dba\u0dcf\u0db4\u0db1\u0dba\u0da7 \u0dba\u0db1\u0dc0\u0dcf\u0db4 \u0d91\u0dad\u0dca\u200d\u0dba\u0d9a\u0dcf\u0da7 \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dc1\u0dba\u0dc0\u0dbd \u0d89\u0dda\u0db1 \u0dd4\u0d9a\u0dca\u0dad\u0dba\u0d9a \u0db8 \u0db0\u0db1\u0dc0\u0dad\u0dd4\u0dbb\u0dda\u0daf? \u0dba\u0db8\u0dcf\u0db1\u0dc0\u0dcf \u0dc4\u0dbb\u0dd2 \u0dc0\u0dd2\u0dba\u0dda\u0da0\u0db1\u0dba\u0d9a\u0dca\u0dad \u0d9a\u0dbb\u0dda\u0db1 \u0d95\u0db1 \u0db1\u0db8\u0dca \u0d9a\u0dbb\u0dda\u0db1\u0db4 \u0db8\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba\u0d9a\u0dca\u0dad \u0db1\u0dd0\u0dc4\u0dd0, \u0dd4\u0db6\u0dad\u0dd4\u0dbb\u0db8\u0dcf \u0dc0\u0dd2\u0dba\u0dda\u0da0\u0db1\u0dba \u0d9a \u0dcf\u0da7\u0db4 \u0d91\u0da7 \u0db4\u0dc3\u0dca\u0dba\u0dc3\u0dca \u0dd4\u0db6\u0dad\u0dd4\u0dbb\u0db8\u0dcf \u0dad\u0dca\u200d\u0dc0\u0dad\u0dca \u0dc3\u0db8\u0dcf\u0d9c\u0dad\u0db8\u0d9a \u0db6\u0dc3\u0dca \u0d9c\u0dad\u0dd0\u0db1 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf\u0db4 \u0d95\u0db1 \u0db8 \u0dc3\u0db8\u0dcf\u0d9c\u0dad\u0db8\u0d9a\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dba\u0dc0\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda\u0d9a\u0db8 \u0dd2\u0dd4\u0dab\u0dab\u0dcf\u0db4 \u0d91\u0dba\u0dc4\u0db8 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0dba\u0dad\u0dca\u200d \u0dbb\u0dcf \u0d9c\u0dad\u0dda\u0db1 \u0dd2\u0dba\u0db6\u0dda\u0dba \u0dda\u0db4 \u0dba\u0db8\u0dcf\u0d9a\u0daf, \u0d85\u0db4\u0da7 \u0d95\u0db1 \u0d9a\u0db8 \u0dd2\u0dba\u0db6\u0dda\u0dba\u0dda \u0dbd\u0d82\u0d9a\u0dcf\u0dba\u0dc0\u0dda \u0dc4\u0dbb\u0dd2 \u0dba\u0dc0\u0db1 \u0dbb\u0da7\u0d9a\u0dd2\u0dda \u0dc4\u0dbb\u0dd2 \u0dba\u0db8\u0dca \u0db6\u0dc3\u0dca \u0dba\u0d9c\u0dad\u0dda\u0dc0\u0dcf \u0d9c\u0dad\u0dda\u0db1\u0dba\u0dd2\u0db4 \u0db8\u0db8 \u0d92\u0d9a\u0dba\u0dd2 \u0d9a\u0dd2\u0dda\u0dba\u0dda, \u0dba\u0db8\u0dca\u0d9a \u0d85\u0dd2\u0dba\u0dc0\u0dcf \u0dba\u0dba\u0dba\u0dda\u0db8 \u0dba\u0db4\u0dde\u0dc1\u0d9c\u0dad\u0dd2\u0d9a \u0d85\u0d82\u0dba\u0dba\u0da7 \u0dc0\u0dd2\u0dc0\u0dd8\u0dad\u0dca\u200d \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0db4 \u0dba\u0db8\u0dcf\u0d9a\u0daf, \u0dc4\u0dab\u0dca\u0da9\u0dd4\u0dba\u0dc0\u0dda\u0db8 \u0db6\u0dc3\u0dca \u0dba\u0d9c\u0dad\u0dba\u0db1\u0dda\u0db1 \u0d95\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dba\u0daf\u0dba\u0d9a\u0dca\u0dad \u0db1\u0dd0\u0dc4\u0dd0\u0db4 \u0d92 \u0dc0\u0dcf\u0dba \u0db8 \u0d91\u0d9a \u0dbb\u0da7\u0d9a\u0dd2\u0dda\u0db8 \u0db6\u0dc3\u0dca \u0d9c\u0dad\u0dda\u0db1 \u0d95\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d91\u0d9a\u0d9a\u0dd4\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0\u0db4\n\n\u0d89\u0dda\u0daf\u0dd2\u0dba\u0dcf\u0dba\u0dda\u0dad\u0dca \u0d9a\u0db3\u0dd4 \u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0dca\u200d\u0db1\u0dc0\u0dcf, \u0d89\u0dda\u0daf\u0dd2\u0dba\u0dcf\u0dba\u0dda \u0dd2\u0dba\u0db6\u0db1 \u0dc3\u0db8\u0dc4\u0dbb \u0db6\u0dc3\u0dca\u0dc0\u0dbd\u0da7 \u0d92 \u0d9a\u0db3\u0dd4\u0dc0\u0dbd\u0da7 \u0dba\u0dda\u0db1 \u0db6\u0dd0\u0dbb\u0dd2\u0dc0 \u0d87\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0db4 \u0dd4\u0db6\u0dad\u0dd4\u0dbb\u0db8\u0dcf \u0db1\u0db8\u0dd4\u0dab\u0dd4\u0d9a\u0dd4\u0dbd \u0d9c\u0dad\u0dd0\u0db1\u0dad\u0dca \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0dba\u0dda\u0db4 \u0db1\u0db8\u0dd4\u0dab\u0dd4\u0d9a\u0dd4\u0dbd\u0da7\u0dad\u0dca \u0dba\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7, \u0dc3\u0dd4\u0da2\u0dd2\u0dad\u0dca \u0db8\u0dda\u0dd3\u0dad\u0dd4\u0dbb\u0db8\u0dcf\u0dba \u0dc4\u0dc3\u0db1\u0dba \u0dc0\u0dcf\u0dba \u0dad\u0dca\u200d\u0dd0\u0dda\u0dc0\u0dbd\u0da7\u0dad\u0dca \u0dba\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 . \u0da7 22 \u0d9a\u0dd4\u0da9\u0dcf \u0db6\u0dc3\u0dca \u0dbd\u0d82\u0d9c\u0dad\u0db8\u0dba\u0da7 \u0dba\u0d9c\u0dad\u0dda\u0dc0\u0db1\u0dc0\u0dcf\u0db4 \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0dc3\u0dd2\u0db8 \u0dba\u0d9a\u0dba\u0db1\u0d9a\u0dca\u0dad \u0d85\u0dad\u0dca\u0dc4\u0dbb\u0dd2\u0dda\u0dba\u0dda \u0db1\u0dd0\u0dc4\u0dd0\u0db4\n\n\u0dd4\u0db6\u0dad\u0dd4\u0dbb\u0db8\u0dcf \u0d9a\u0dd2\u0dda\u0dc0 \u0dba\u0dc1\u0dc0\u0dbd\u0dca \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dc0\u0dba\u0dba\u0dba\u0dda \u0dc0\u0dd0\u0dbb\u0daf\u0dd2\u0dba\u0dd2\u0db4 \u0d92 agreement \u0d91\u0d9a \u0d85\u0db1\u0dd4\u0dc0, \u0dc4\u0db1\u0dba\u0db1\u0dba \u0d9a\u0dbb\u0db1 company \u0d91\u0d9a \u0dba\u0db8\u0dca \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca\u0dad \u0dc0\u0d9c\u0dad\u0d9a\u0dd3\u0db8 \u0d9c\u0dad\u0dda\u0db1 \u0d95\u0db1 , \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc0\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0db1\u0da9\u0dad\u0dca\u0dad\u0dd4\u0dbb \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dbb \u0dc3\u0db8\u0dca\u0db6\u0dda\u0db0\u0dba\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba\u0d9a\u0dca\u0dad \u0dc4\u0dba\u0dc0\u0dcf\u0dad\u0dca\u0db4 \u0dd4\u0dc0\u0dd4\u0dda \u0d92 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca\u0dad\u0dca\u200d \u0dba\u0db1\u0dcf\u0d9a\u0dba \u0dcf\u0dad\u0dca \u0d91\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0db4\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dbb \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0db4 \u0d92\u0d9a \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0db8\u0da7 \u0d92 \u0dc3\u0db8\u0dca\u0db6\u0dda\u0db0\u0dba\u0dba\u0dda \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2 \u0d9a\u0dbb\u0dda\u0db1 \u0dd2\u0dba\u0db6\u0dda\u0dba\u0dda\u0db4\n\n\u0d9c\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0dbb\u0dd9\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0bc6\u0baa\u0bc6\u0bbe\u0ba8\u0bc6\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bc6\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Speaker) \u0d9c\u0dad\u0dbb\u0dd4 \u0db8\u0dda\u0dd3\u0dad\u0dd4\u0dbb\u0db8\u0dd2\u0dba, \u0dba\u0daf\u0dc0\u0dd0\u0dd2\u0dba \u0d85\u0dad\u0dd4\u0dbb\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba \u0d85\u0dc4\u0dda\u0db1\u0db4"
  },
