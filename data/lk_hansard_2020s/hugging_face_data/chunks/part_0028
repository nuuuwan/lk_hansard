    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0d9f\u0dda \u0dc3\u0dda\u0dc0\u0dcf\u0db0\u0dd3\u0db1\u0dad\u0dca\u0dc0\u0dba \u0d9c\u0dd0\u0db1 \u0d9f\u0dca \u0db4\u0db1\u0dad\u0dca \u0d9f\u0d9a\u0da7\u0dd4\u0dca \u0db4\u0dad\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 Judgment \u0d91\u0d9f\u0d9a\u0dca \u0dc0\u0dd2 \u0dcf\u0dbd \u0dc0 \u0d9f\u0dba\u0db1\u0dca\u0dc4 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0d9f\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0dcf \u0dc4\u0dd2\u0dad\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7, \u0d91\u0db8 \u0dad\u0dd3\u0dbb\u0dab\u0d9f\u0dda 91\u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dd2\u0da7\u0dd4\u0d9f\u0dda \u0d89\u0dad\u0dcf \u0dc0\u0dd0\u0daf\u0d9c\u0dad\u0dca \u0d9f\u0daf\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0d9f\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba \u0dc3\u0dda\u0dc0\u0dcf\u0db0\u0dd3\u0db1 \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dca\u0d9f\u0dad\u0dca \u0d9a\u0dd4\u0db8\u0d9a\u0dd2\u0db1\u0dca\u0dc4\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf 91\u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dd2\u0da7\u0dd4\u0d9f\u0dda \u0d9f\u0db8\u0d9f\u0dc4\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf:\n\n\u0d9f\u0db8\u0db1\u0dca\u0dc4\u0db1 \u0d9f\u0dca \u0d9a \u0d85\u0dad\u0dd2 \u0dba \u0dc0\u0dd0\u0daf\u0d9c\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0dba\u0dd2 \u0db8\u0dcf \u0dc4\u0dd2\u0dad\u0db1\u0dca\u0dc4\u0d9f\u0db1\u0dca\u0dc4. \u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0db8\u0db8 \u0d92\u0d9a\u0dba\u0dd2 \u0d85\u0d9f\u0db4\u0dca \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0d9a\u0dca\u0d9f\u0dc2\u0dab\u0dda\u0dbb\u0dba \u0d9c\u0dd0\u0db1 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dab \u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0d9a\u0dd2\u0dda\u0d9f\u0dda, \u0d85\u0dbb \u0d8b\u0daf\u0dcf\u0dc4\u0dbb\u0dab\u0d9f\u0dba\u0db1\u0dca\u0dc4 \u0daf\u0d9a\u0dca\u0dc0\u0db4\u0dd4 counterstory \u0d91\u0d9f\u0d9a\u0db1\u0dca\u0dc4, Omelas \u0d9a\u0dd2\u0dba\u0db1 \u0db1\u0d9c\u0dbb\u0d9f\u0dda \u0d9a\u0dae\u0dcf\u0d9f\u0dc0\u0db1\u0dca\u0dc4. \u0d92 \u0d9a\u0dae\u0dcf\u0d9f\u0dda \u0dc0\u0dcf\u0d9f\u0dda\u0db8 \u0d9f\u0db8\u0dad\u0dd0\u0db1\u0dad\u0dca \u0daf\u0dd0\u0d9a\u0dca\u0d9f\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0dc0\u0dcf\u0d9f\u0dda \u0dc0\u0dc4\u0d9f\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0dc4\u0db1 \u0d91\u0d9a\u0d9a\u0dca \u0dad\u0dd2\u0d9f\u0db6\u0db1\u0dc0\u0dcf. 2015-2020 \u0d9a\u0dcf\u0dbd\u0d9f\u0dda \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0d9f\u0dda \u0d85\u0dc4\u0db1\u0dca\u0dc4\u0db1 \u0daf\u0dcf\u0db4\u0dd4, \u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2\u0dab\u0dbd\u0dcf\u0d9f\u0dda \u0db1\u0da9\u0dd4 \u0d85\u0dad\u0dd2\u0dc0\u0dd2 \u0dcf\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0d9f\u0db6\u0db1\u0dc0\u0dcf. \u0d92\u0dc0\u0dcf \u0db4\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0dc4\u0db1 \u0daf\u0dcf\u0db4\u0dd4 \u0d92\u0dc0\u0dcf \u0d9f\u0db1\u0dcf\u0d9f\u0dc0\u0dba\u0dd2. \u0d9c\u0dbb\u0dd4 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dab \u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0dba\u0dc4\u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0d9a\u0dcf\u0dbd\u0d9f\u0dda \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dc4\u0dbd\u0dcf \u0d92 \u0db1\u0da9\u0dd4 \u0daf\u0dd0\u0dca \u0d9f\u0dca \u0db4\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0dc4\u0db1 \u0d9f\u0db1\u0dcf\u0d9f\u0dc0\u0dba\u0dd2, \u0d85\u0db4\u0dd2 \u0d92 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0d9a\u0dbb\u0d9f\u0d9c\u0db1 \u0dba\u0db1\u0dca\u0dc4\u0d9f\u0db1\u0dca\u0dc4\u0dad\u0dca \u0db4\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0dc4\u0db1 \u0d9f\u0db1\u0dcf\u0d9f\u0dc0\u0dba\u0dd2. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d92\u0dc0\u0dcf\u0da7 \u0d9f\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0daf \u0dc0\u0dd4\u0d9f\u0dab\u0dca 2019\u0db1\u0dca\u0dc4, 2020\u0db1\u0dca\u0dc4 \u0db4\u0dc3\u0dda\u0d9f\u0dc3\u0dda? \u0dc3\u0dca \u0db4\u0dd6\u0dbb\u0dbb\u0dca\u0dab\u0d9f\u0dba\u0db1\u0dca\u0dc4 \u0db1\u0dd3\u0dad\u0dd2\u0db4\u0dad\u0dd2 \u0d9f\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0d9f\u0dca \u0db1\u0dca\u0dc4\u0dad\u0dd4\u0dc0 \u0d9f\u0dba\u0dcf\u0daf\u0dcf \u0d9f\u0d9c\u0db1 \u0d92 \u0db1\u0da9\u0dd4 \u0d94\u0d9a\u0dca\u0d9f\u0d9a\u0dcf\u0db8 \u0dc3\u0d9a\u0dd2\u0dc5\u0dd4\u0d9f\u0dda \u0db1\u0dd0\u0daf\u0dca\u0daf? \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0d9f\u0dda\u0dad\u0dca \u0dc3\u0db8\u0dc4\u0dbb \u0d85\u0dba \u0d91\u0dba\u0da7 \u0dc3\u0dca \u0db6\u0db1\u0dca\u0dc4\u0dca\u200d \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0dc4\u0db1 \u0dc3\u0dad\u0dd2. \u0d91\u0daf\u0dcf \u0db1\u0da9\u0dd4 \u0dc0\u0dd2 \u0dcf\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0dc3\u0d9a\u0dd2\u0dc5\u0dd4\u0dc0\u0dcf \u0d85\u0dba\u0dd2\u0db1\u0dca\u0dc4 \u0d9a\u0dbb \u0d9c\u0dad\u0dca\u0dad\u0dcf. \u0db8\u0da7 \u0db8\u0dad\u0d9a \u0dc4\u0dd0\u0dd2\u0dad\u0dba\u0da7 \u0d85\u0dda\u0dbd\u0dc3\u0dda \u0d9f\u0d9a\u0dcf\u0db8\u0dd2\u0dc3\u0d9f\u0db8\u0db1\u0dca\u0dc4 \u0daf\u0dcf\u0db4\u0dd4 \u0db1\u0da9\u0dd4 42\u0d9a\u0dca\u0daf \u0d9f\u0d9a\u0dcf\u0d9f\u0dc4\u0dda\u0d9f\u0daf\u0ddd \u0d85\u0dba\u0dd2\u0db1\u0dca\u0dc4 \u0d9a\u0dbb \u0d9c\u0dad\u0dca\u0dad\u0dcf, \u0d9f\u0d9a\u0dcf\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dda\u0dc0\u0dbb\u0dd2\u0dba\u0d9f\u0dda \u0d85\u0dad\u0dca\u0dc3\u0db1\u0d9a\u0dca \u0db8\u0daf\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d95\u0db1\u0dd1 \u0db1\u0dca \u0d8a\u0da7 \u0db4\u0dc3\u0dda\u0d9f\u0dc3\u0dda \u0d85\u0dad\u0dca\u0dc3\u0db1 \u0d9c\u0dc4\u0dbd\u0dcf \u0d86\u0d9f\u0dba\u0dad\u0dca \u0daf\u0db8\u0db1\u0dca\u0dc4\u0db1 \u0dad\u0dd2\u0dd4\u0dab\u0dcf \u0d9f\u0db1\u0dca\u0dc4. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0daf\u0dd0\u0dca \u0d9f\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d9f\u0dca \u0d9a \u0daf\u0dd0\u0d9a\u0dca\u0d9f\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0dc0\u0dcf\u0d9f\u0dda \u0dad\u0db8\u0dba\u0dd2, Bar Association \u0dc3\u0dc4 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dc4\u0dbd\u0dcf \u0dc3\u0dad\u0dd4\u0dc5\u0dd4\u0dc0 \u0d85\u0dbb\u0d9f\u0d9c\u0dcf\u0dda\u0d9f\u0dbd\u0ddd, \u0d9f\u0dca \u0d9f\u0d9c\u0dcf\u0dda\u0d9f\u0dbd\u0ddd \u0d9f\u0dca \u0d9c\u0dd0\u0db1 \u0dc0\u0dd2 \u0dcf\u0dbd \u0d8b\u0db1\u0db1\u0dca\u0dc4\u0dd4\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0d9f\u0db6\u0db1 \u0d85\u0dba \u0dc4\u0dd2\u0dd2\u0dad\u0d9f\u0dda. \u0db8\u0db8 \u0dc3\u0da2\u0db6\u0dba\u0da7 \u0db4\u0db8\u0dab\u0d9a\u0dca \u0d9f\u0db1\u0dcf\u0d9f\u0dc0\u0dba\u0dd2 \u0d9f\u0dca \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0dc4\u0d9f\u0db1\u0dca\u0dc4.\n\n\u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba \u0dc3\u0dda\u0dc0\u0dcf\u0db0\u0dd3\u0db1 - independent - \u0d9f\u0dc0\u0db1\u0dca\u0dc4\u0db1 \u0d95\u0db1\u0dd1\u0d9a\u0db8 \u0dad\u0dd2\u0d9f\u0db6\u0db1\u0dca\u0dc4\u0d9f\u0db1\u0dca\u0dc4, \u0dc4\u0dd4\u0dd4 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9f\u0dc0\u0db1\u0dca\u0dc4 \u0db4\u0db8\u0dab\u0d9a\u0dca \u0d9f\u0db1\u0dcf\u0d9f\u0dc0\u0dba\u0dd2 pressure groups\u0dc0\u0dd2\u0db1\u0dca\u0dc4, \u0dad\u0dd2\u0d9f\u0db6\u0db1 status quo \u0d91\u0d9f\u0d9a\u0db1\u0dca\u0dc4, \u0dba\u0dcf\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dc4\u0d9f\u0d9c\u0db1\u0dca\u0dc4, social media\u0dc0\u0dd2\u0db1\u0dca\u0dc4, \u0d92 \u0d94\u0d9a\u0dca\u0d9f\u0d9a\u0dcf\u0d9f\u0d9c\u0db1\u0dca\u0dc4\u0db8 \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dda \u0d9f\u0dc0\u0db1\u0dca\u0dc4\u0db1 \u0d95\u0db1\u0dd1. \u0d9f\u0dca Judgment \u0d91\u0d9f\u0d9a\u0db1\u0dca\u0dc4\u0db8 \u0d92 \u0d9c\u0dd0\u0db1 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dc4\u0dbd\u0dcf \u0daf\u0db1\u0dca\u0dc4\u0db1\u0dc0\u0dcf \u0d8b\u0dc3\u0dcf\u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0daf\u0dd2\u0dbd\u0dcf \u0dad\u0dd2\u0d9f\u0db6\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0d9f\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc3\u0db4 \u0d9c\u0db1\u0dca\u0dc4\u0db1 \u0db1\u0dca \u0d85\u0dda\u0dbd\u0db1\u0dca\u0dc4\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc0\u0dd2\u0d9f \u0dda\u0dc2\u0dab \u0db1\u0dd3\u0dad\u0dd2\u0db4\u0d9f\u0dba\u0ddd \u0d9f\u0daf\u0d9f\u0daf\u0d9f\u0db1\u0d9a\u0dca \u0dad\u0dd4\u0db1\u0dca\u0dc4\u0d9f\u0daf\u0d9f\u0db1\u0d9a\u0dca \u0dc4\u0dd0\u0daf\u0dd2\u0dbd\u0dcf \u0d89\u0db1\u0dca\u0dc4\u0db1\u0dc0\u0dcf, \"\u0d9f\u0dca \u0d9a\u0da7 \u0db1\u0dca \u0d9f\u0dca \u0d85\u0dba\" \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc4\u0d9f\u0db1\u0dca\u0dc4, \u0daf\u0d9a\u0dca\u0dc2\u0dab\u0dad\u0dcf\u0d9f\u0dc0\u0db1\u0dca\u0dc4 \u0d92 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0dc4\u0db1\u0dcf \u0d91\u0d9a \u0d9c\u0dd0\u0db1 \u0d9f\u0db1\u0dcf\u0d9f\u0dc0\u0dba\u0dd2. \u0d92 \u0d9c\u0dd0\u0db1 \u0d85\u0db4\u0da7 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0d8a\u0da7 \u0dc0\u0da9\u0dcf \u0d9f\u0daf\u0dba\u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0dc4\u0db1\u0dc0\u0dcf.\n\n\u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba \u0dc3\u0dda\u0dc0\u0dcf\u0db0\u0dd3\u0db1 \u0d9f\u0dc0\u0db1\u0dca\u0dc4\u0db1 \u0d95\u0db1\u0dd1\u0d9a\u0db8 \u0dad\u0dd2\u0d9f\u0db6\u0db1\u0dca\u0dc4\u0d9f\u0db1\u0dca\u0dc4, \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9f\u0dc0\u0db1\u0dca\u0dc4 \u0db4\u0db8\u0dab\u0d9a\u0dca \u0d9f\u0db1\u0dcf\u0d9f\u0dc0\u0dba\u0dd2. \u0d9f\u0dca \u0dbb\u0d9f\u0dda \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0da7"
  },
