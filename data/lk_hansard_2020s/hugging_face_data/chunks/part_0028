    "chunk_text": "\u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf \u0db8\u0dd9\u0dad\u0dd0\u0db1 \u0dc0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0d9a\u0dcf\u0dbb \u0daf\u0dda\u0dc0\u0dbd\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d85\u0db4\u0dd2 \u0dd2 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0db4\u0dda \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dd2\u0d9a\u0dca\u0d9a\u0dc0\u0dbd \u0d89\u0db1\u0dca\u0db1 \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d85\u0daf \u0d9a\u0ddc\u0dc5\u0db9\u0da7 \u0dc5\u0db9\u0da7 \u0d9c\u0dd9\u0db1\u0dd0\u0dbd\u0dca\u0dbd\u0dcf \u0db8\u0dda \u0dc3\u0d82\u0dc1\u0ddd\u0db0\u0db1\u0dba\u0da7 \u0d85\u0db4\u0dda \u0dc0\u0dd2\u0dbb\u0ddd\u0db0\u0dad\u0dcf\u0dc0 \u0db4\u0dd9\u0db1\u0dca\u0db1\u0dd4\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0dd2 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0db1\u0ddc\u0dc0\u0dd9\u0dba\u0dd2, \u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0d85\u0db4\u0dda \u0dbb\u0da7\u0dda \u0db1\u0dd3\u0dad\u0dd2\u0da5 \u0dc3\u0d82\u0d9c\u0db8\u0dba\u0dad\u0dca \u0db8\u0dda \u0dc3\u0d82\u0dc1\u0ddd\u0db0\u0db1\u0dba\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0\u0dba\u0dd2. \u0db1\u0dd3\u0dad\u0dd2\u0da5 \u0dc3\u0d82\u0d9c\u0db8\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dda, \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d9a\u0dcf\u0dbd\u0dba\u0dda \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf \u0db6\u0dbd\u0dba\u0da7 \u0d9c\u0dd9\u0db1\u0dd9\u0db1\u0dca\u0db1 \u0db1\u0dca\u0db1 \u0dc0\u0dda\u0daf\u0dd2\u0d9a\u0dcf\u0dc0\u0dbd \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db4\u0dd4 \u0d8b\u0daf\u0dc0\u0dd2\u0dba. \u0db4\u0ddc\u0dc5\u0ddc\u0db1\u0dca\u0db1\u0dbb\u0dd4\u0dc0\u0dda\u0dad\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0da5\u0dc0\u0dbb\u0dd4 \u0dc0\u0dbb\u0dd4 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0d85\u0db4\u0dc0 \u0dc4\u0db8\u0dd4 \u0dc0\u0dd4\u0dab\u0dcf. \u0d92, \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0da7 \u0dc3\u0dc4\u0dcf\u0dba \u0daf\u0dd4\u0db1\u0dca \u0d8b\u0daf\u0dc0\u0dd2\u0dba. \u0d92 . \u0d92 \u0d85\u0dba \u0d85\u0daf \u0db8\u0dda \u0dc3\u0d82\u0dc1\u0ddd\u0db0\u0db1\u0dba\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0\u0dba\u0dd2. \u0db1\u0dd3\u0dad\u0dd2\u0da5 \u0dc3\u0d82\u0d9c\u0db8\u0dba\u0dad\u0dca \u0db8\u0dda\u0d9a\u0da7 \u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0\u0dba\u0dd2. \u0dbb\u0da7\u0dda \u0db6\u0dc4\u0dd4\u0dad\u0dbb\u0dba\u0d9a\u0dca \u0db8\u0dda\u0d9a\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0\u0dba\u0dd2. \u0dba\u0dd2."
  },
