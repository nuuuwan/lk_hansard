    "chunk_text": "\u0dca\u0db1\u0dca\u0daf\u0db1\u0dca \u0dca\u0dd9\u0dcf \u0dc0 \u0db8\u0dd9\u0dcf \u0daf\u0d89 \u0db0\u0db0\u0dae\u0dc0\u0daf \u0dab\u0dc4\u0dc0\u0db4\u0dd4 \u0d9c\u0dcf \u0dd4\u0dc5\u0dc3 \u0d92 \u0dc0\u0dcf \u0daf\u0d89\u0db8 \u0db6\u0db1\u0dca\u0db1\u0db1\u0dcf \u0d9c\u0dcf \u0dab \u0db1\u0dd2 \u0db1\u0dcf \u0dbb\u0dd2\u0db1\u0dca\u0daf\u0d89 \u0dc0\u0dd0\u0dd4\u0db8\u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dc4\u0dc0\u0dca \u0db6\u0dab\u0db1 \u0dc5 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dae\u0db1 \u0dca \u0dad\u0dd2\u0daf\u0db6\u0db1\u0dc0\u0dcf \u0dc3 \u0dca\u0dc0\u0dd4\u0db1\u0dca\u0daf\u0d89 \u0dc0\u0dd0\u0dd4\u0db8\u0db4\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0db8 \u0db0\u0db1\u0dd2\u0dc0\u0dcf \u0dbb\u0dca \u0daf \u0db1\u0dca \u0dc0\u0dd2 \u0dba\u0dd4\u0dd4\u0dba\u0dd2\u0da9\u0dca\u0dc3 \u0dca\u0dc0\u0dd4\u0db1\u0dca \u0da7\u0dab\u0db1 \u0d92 \u0dab\u0dcf \u0d82\u0da7\u0dcf \u0dbb\u0dd2 , \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0daf\u0dc0\u0dc5 \u0d9c\u0dca \u0dcf \u0db8 , \u0d92\u0da7 \u0db6\u0dab\u0db1 \u0dc5\u0dba\u0dd2\u0da9\u0dca\u0dc3 \u0d9c\u0dc0 \u0d87\u0db8 \u0dad\u0dd2\u0dd4\u0db8 \u0db1\u0dd2, \u0daf\u0db8 \u0dcf \u0da7\u0dd9, \u0dc0\u0dca \u0daf \u0db1\u0dca \u0db1\u0dca\u0dae\u0daf\u0dca\u0dae \u0daf\u0db1\u0dcf \u0da9\u0dd2 \u0daf\u0db1\u0dcf \u0dbd\u0dd4 \u0da7\u0dd1 \u0dc0 \u0dca \u0db0 \u0db4 \u0dd3 \u0dcf \u0dbb\u0dd0\u0dc4\u0dc0\u0dd2 \u0db1\u0dca 3,000\u0dca \u0db6 \u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0d92 \u0db0 \u0dc0 \u0d87\u0dd4\u0dc5\u0db4 \u0dd9\u0db8 \u0db1\u0dc0\u0dcf \u0dc3 \u0d92 \u0db1\u0dd2\u0dca\u0dcf \u0dca\u0db6\u0dd4\u0db8 \u0dcf \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dc4\u0dc0 \u0daf\u0dca\u0dcf \u0dcf \u0db6 \u0db1\u0dca\u0db1\u0dc3 \u0daf\u0dca\u0dc0\u0dcf \u0dca\u0dca\u0db6\u0db1\u0dca\u0db1\u0daf \u0db1\u0dca \u0db1\u0dd2\u0dc3\u0dd2 \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0daf\u0dc0\u0dc5\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf \u0dca \u0db8 \u0da7 \u0daf\u0db1\u0dcf \u0dc0\u0db1\u0dca\u0daf\u0db1\u0dca \u0d87\u0dba\u0dd2\u0da9\u0dca? \u0dca \u0db0\u0db8 \u0dcf \u0dba\u0dcf \u0dc1\u0db0\u0daf\u0dad \u0da7\u0db1\u0dc0\u0dd0\u0db1\u0dca\u0dca\u0dca \u0dc0\u0dd2\u0dd2\u0d9a \u0db4 \u0daf\u0dca \u0dbb\u0dab\u0db1\u0dca\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dc4\u0dc0 \u0daf\u0dca\u0dcf \u0db1, \u0daf\u0dca \u0db1 \u0db1\u0dd2 \u0db1\u0dcf \u0dbb\u0dd2\u0db1\u0dca \u0dca\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0dc3 \u0d92 \u0db1\u0dd2\u0dca\u0dcf \u0db8 \u0dba\u0dd2\u0da9\u0dca \u0dca\u0db6\u0dd4\u0db8 \u0dcf \u0db4 \u0dc0\u0dab\u0daf\u0dd2\u0db1\u0dca\u0daf\u0db1\u0dca\u0dc3 \u0d9c\u0dc0 \u0d87\u0db8 \u0dad\u0dd2\u0dd4\u0db8 \u0db1\u0dd2, \u0d92 \u0db1\u0dd2\u0dca\u0dcf \u0dca\u0db6\u0dd4\u0db8 \u0dcf \u0db0 \u0d9c \u0dcf \u0dad\u0dd2\u0daf\u0db6\u0db1 \u0dc0\u0dd0\u0daf \u0dc3 \u0dca\u0dcf \u0dbb\u0dca \u0da7 \u0da7\u0dab \u0d9c\u0db1\u0dca\u0db1 \u0db1\u0dca, \u0db0\u0db8 \u0dcf \u0dba\u0dcf \u0dc1\u0db0 \u0d87\u0dd4\u0daf\u0dc5\u0dae \u0dca\u0db1\u0dca\u0db1 \u0daf\u0dca \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0daf\u0dc0\u0dc5 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dc4\u0dc0 \u0da7\u0db1\u0dc0\u0dd0\u0db1\u0dca\u0dca\u0dca\u0dc0 \u0daf\u0dca \u0db1 \u0db0 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf \u0dca \u0db8 \u0da7 \u0da7\u0dab\u0db1 \u0d92 \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0daf\u0dc0\u0dc5 \u0db0\u0dba\u0dd2\u0da9\u0dca\u0db1\u0dca \u0da7\u0dab \u0dcf \u0dd9\u0db8 \u0db1\u0dca\u0db1\u0dc3 \u0dca\u0db6\u0dd4\u0db8 \u0dcf \u0daf\u0dd9\u0dc0\u0dab\u0dba\u0dd2\u0da9\u0dca \u0daf\u0db1\u0dca, \u0db6\u0db1\u0dca\u0db1\u0db1\u0dcf \u0d9c\u0dcf \u0dab \u0db4 \u0dd2\u0daf\u0dad\u0dc3 \u0db6\u0db1\u0dca\u0db1\u0db1\u0dcf \u0d9c\u0dcf \u0dab \u0db4 \u0dd4\u0db1\u0dca\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0 \u0dcf \u0dc0\u0db4 \u0db1\u0dca\u0db1 \u0daf\u0dc0\u0db1\u0dca\u0daf\u0db1\u0dca, \u0dca\u0db6\u0dd4\u0db8 \u0dcf \u0daf\u0dca \u0dc0\u0dd0\u0da9 \u0da7\u0dd2\u0da7 \u0da7\u0daf\u0dc5\u0dcf \u0dca \u0db8 \u0dba\u0dd2\u0da9\u0dca\u0dc3 \u0dca\u0daf \u0db8 \u0db1\u0dd0\u0dad\u0dd2 \u0dc0\u0dd4\u0daf \u0dcf \u0dca , \u0daf\u0dca \u0db4\u0dd2\u0db4\u0dd2\u0dd3\u0db8\u0db8 , \u0daf\u0dd9\u0dd9\u0dd3\u0db8\u0db8 \u0db8\u0dd3\u0db4 \u0dc0\u0da9\u0dcf \u0db6\u0dab\u0db1 \u0dc5 \u0daf\u0dc0\u0dba\u0dd2\u0da9\u0dca\u0dc3 \u0daf\u0dca \u0db0\u0daf\u0dca\u0dc1\u0dca\u0da7 \u0dbb\u0dd0\u0dc4\u0dc0\u0dd2 \u0db1\u0dca \u0dc3\u0dd2\u0dab\u0d9c \u0daf\u0dc0 \u0dcf , \u0dca\u0dc0\u0dd4\u0db1\u0dca\u0daf\u0d89 \u0dd9\u0dbd\u0dca\u0dc0\u0db8 \u0db0\u0db1\u0dd4\u0dc0 \u0dca\u0dc0\u0dd4\u0db1\u0dca \u0db1\u0dd2\u0dc3\u0dd2 \u0dcf \u0da7\u0dcf \u0dab\u0dc0 \u0dca\u0dc4 \u0dcf , \u0db4\u0dd4\u0db1\u0dc0 \u0dca \u0dcf \u0db1\u0db1 \u0daf\u0dc0 \u0dcf \u0dad\u0dd2\u0daf\u0db6\u0db1 \u0db1\u0dd2\u0dca\u0dcf \u0db4\u0dd4\u0db1\u0dc0 \u0dca \u0dcf \u0db1\u0db1 \u0daf\u0dc0\u0dca\u0da0 \u0d92 \u0dc3\u0dd2 \u0dbd\u0dd4\u0daf\u0dd9\u0db1\u0dcf \u0db1\u0dd2\u0dd9 \u0dca\u0dae \u0da7\u0dab\u0db1\u0dca\u0db1 \u0db0\u0dc0\u0db0\u0dba \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0daf\u0dc0\u0dc5 \u0dd9\u0db1\u0dca\u0db1 \u0dd2\u0dbb \u0dcf \u0db8 \u0db8 \u0daf \u0d82\u0db1\u0dcf \u0da7\u0dab\u0db1\u0dc0\u0dcf \u0dc3\n\n\u0daf\u0db6\u0dcf \u0daf \u0dcf \u0db8 \u0dca\u0dae\u0dd4\u0dad\u0dd2\u0dba\u0dd2\u0da9\u0dca\u0dc3\n\n1803 1804\n\n\u0db1\u0dcf \u0dbb\u0dca\u0dd2\u0daf\u0dca\u0db1\u0dca\u0dd4\u0dc0\n\n\u0db6\u0db1\u0dca\u0db1\u0db1\u0dcf \u0d9c\u0dcf \u0dab \u0dd4\u0dc5 \u0dd3\u0dc0\u0dc0\u0dca \u0dc0\u0db1 \u0da7\u0dcf \u0dd9\u0dbd\u0dca\u0dc0\u0daf\u0db8 \u0db1\u0dca \u0db0\u0dd4 \u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0db4 \u0dd0\u0dd2\u0dbb \u0dc0\u0db1 \u0db1\u0dbb\u0dd2\u0daf\u0dd2\u0dc3 \u0d92\u0daf\u0dca \u0dbb\u0dca\u0da7 \u0dca\u0db6\u0dd4\u0db8 \u0dcf \u0db4 \u0daf \u0dcf \u0db3\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0db4\u0daf \u0db1\u0dc0\u0dcf , \u0dca\u0db6\u0dd4\u0db8 \u0dcf \u0dca \u0dca \u0dc5 \u0db0\u0dd2\u0d9a\u0da7\u0dab \u0dc0 \u0db0\u0db1\u0dab\u0dcf \u0db1 \u0db1\u0dd4\u0dc0 \u0db4 \u0daf\u0db1\u0db1\u0dd3 \u0daf\u0dca\u0db4\u0db4\u0dd4 \u0db1\u0dd3\u0dad\u0dd2\u0da5 \u0db8 \u0dca \u0db8 \u0daf \u0dca \u0db1\u0dd2\u0dca\u0dcf \u0dc3\n\n\u0d9c\u0dc0 \u0db1\u0dd2\u0daf \u0d82\u0dba \u0da7\u0dcf \u0dab\u0da7 \u0dca\u0db7\u0dcf \u0dca\u0db7\u0dcf \u0db1\u0dad\u0dd2\u0dd4\u0db8\u0dd2 \u0db1\u0dd2, \u0db1\u0daf\u0dca\u0dca \u0d92 \u0dca\u0dc1\u0daf\u0db0 \u0db1\u0db1 \u0db0\u0dab\u0daf\u0d9c\u0db1 \u0dca \u0db8\u0daf\u0dd2 \u0d92 \u0dc0\u0db1 \u0dc0\u0dd2\u0db4 \u0daf\u0dca \u0dca \u0dca \u0dc0 \u0db4 \u0daf\u0dca\u0dc4\u0dd4 \u0dca\u0db1\u0dca \u0dc3\u0dd2\u0dab\u0da7\u0dc0 \u0dc0\u0db1\u0dca ],000\u0da7 ,000\u0da7 \u0db4\u0dd2\u0dbb\u0dd2\u0dca\u0dca \u0db6\u0db1\u0dca\u0db1\u0db1\u0dcf \u0d9c\u0dcf \u0dab \u0dd4\u0dc5 \u0daf\u0dca\u0da7\u0dd2 \u0dcf \u0dc3 \u0d92 \u0dc3\u0dd2\u0dab\u0da7\u0dc0 \u0dc0\u0db1\u0dca\u0db4\u0dca \u0daf\u0dca \u0dca \u0db1 \u0db6\u0dcf \u0dd3 \u0db8 \u0dc0 \u0dca\u0dc0 \u0dba\u0dd2\u0da9\u0dca\u0dc3 \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dc4\u0dc0 \u0dca \u0db1\u0db1 \u0dca\u0dc1\u0daf\u0db0 \u0db1\u0db1\u0daf \u0db1\u0dca \u0db1\u0dc0 \u0dc0\u0dca \u0daf\u0dca \u0db1\u0dcf \u0dbb\u0dca\u0dd2\u0daf\u0dca\u0db1\u0dca\u0dd4\u0daf\u0dc1\u0dd3 \u0db0\u0dc0\u0dca\u0dae \u0dcf \u0dd2\u0dbb\u0daf\u0dca\u0db1 \u0da7\u0dd3 \u0dca\u0dcf \u0da7\u0dca\u0da1\u0dcf \u0dc0\u0dd4 \u0dcf \u0dc3 \u0da7 \u0dc0 \u0dd0\u0db6\u0dd3\u0daf\u0dca \u0daf \u0d82\u0db1\u0dcf \u0dca \u0dca\u0daf\u0dd2\u0dbb\u0dd2\u0db1\u0dca \u0dc0\u0dd4 \u0dcf \u0dc3 \u0db1\u0daf\u0dca\u0dca \u0db0\u0dc0\u0dcf \u0dca\u0db1\u0dcf \u0dc0\u0da7\u0db4, \u0daf\u0dca \u0dc0\u0dd2 \u0dba\u0dd4\u0dd4 \u0dca\u0dc1\u0daf\u0db0 \u0db1\u0db1 \u0daf\u0db8 \u0daf \u0dca \u0dc3\u0dd2 \u0db8\u0db1 \u0daf\u0dc0 \u0dcf \u0db1\u0dd0 \u0dd0\u0dc3"
