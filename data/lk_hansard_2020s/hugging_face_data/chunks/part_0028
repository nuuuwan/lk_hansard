    "chunk_text": "1950\u0db4 \u0d9a\u0dd2\u0dca \u0d85\u0d9c\u0dda \u0dc3\u0dc4\u0dda \u0d85\u0dc0\u0dc1\u0dca\u0dba\u0dc0\u0dcf\u0d9c\u0dc0\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0db4 35\u0dca 40\u0dca \u0dc3\u0dd4\u0dbb\u0dcf\u0dcf \u0d9c\u0dca \u0dc0 \u0d85\u0db4\u0dd2 \u0d92 \u0db1\u0dc0 \u0db4\u0dd2 \u0db8\u0dca \u0d91\u0dca\u0d9a \u0d85\u0dba \u0dc0\u0db1\u0d9c\u0d9a\u0dcf\u0db4 \u0d85\u0db1\u0db4 \u0d85\u0dc0\u0dc1\u0dca\u0dba \u0dc3 \u0dd6\u0dbb\u0dca\u0da7 \u0dd3\u0da9 \u0db1\u0dd2\u0dc2\u0dad\u0db1\u0dcf\u0dba\u0db1\u0dba \u0d9a\u0dcf \u0d9c\u0dca \u0db1 \u0dd4\u0dbb \u0dc0\u0dca \u0db8 \u0db4\u0db8\u0db4 \u0dc3\u0dc4\u0dda \u0db1\u0dd2\u0dc2\u0dad\u0db1\u0dcf\u0dba\u0db1\u0dba \u0d9a\u0dcf \u0d9c\u0dca \u0db1 \u0dd4\u0dbb \u0dc0\u0dca \u0db8 \u0db4\u0db8\u0db4 \u0d87\u0dc0\u0dd2\u0dda\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0dc0\u0d9c\u0dcf \u0d9a \u0d9c\u0dc4\u0dca\u0d9c\u0db4\u0dba\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0da7\u0dba \u0d9c\u0dca \u0d9c\u0dc0\u0dcf\u0dca 2023\u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0d9c\u0dc4\u0dca\u0d9c\u0db4\u0dba\u0dcf\u0dcf 317 000\u0dca\u0dba 2024\u0daf\u0dd3 \u0d9c\u0dc4\u0dca\u0d9c\u0db4\u0dba\u0dcf\u0dcf 1 287 000\u0dca\u0dba 2025\u0daf\u0dd3 \u0d9c\u0dc4\u0dca\u0d9c\u0db4\u0dba\u0dcf\u0dcf 1 341 000\u0dca\u0dba \u0dc0\u0d9c\u0dcf \u0d9a\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d9c\u0dc4\u0dca\u0d9c\u0db4\u0dba\u0dcf\u0dcf 1 300 000\u0d9a\u0db4 \u0dc0\u0dd0\u0dd2\u0dba \u0dd3\u0da9 \u0dc0\u0d9c\u0dcf\u0dc0\u0dca \u0d9a\u0dcf\u0db8\u0dd2\u0dca \u0dbb\u0dc3\u0dca \u0db1 \u0dc0\u0dc1\u0dca\u0d9c\u0dba\u0dca \u0d9c\u0db8\u0da7\u0dca\u200d\u0dbb\u0dd2\u0dca \u0d9c\u0db4\u0dcf\u0dca \u0dbd\u0dca\u0dc2 50 \u0d89\u0dca\u0db8 \u0dc0\u0dd6 \u0d85\u0dc3\u0dad\u0dc0\u0dd0\u0dca \u0db1\u0dca 2026 \u0dba\u0dbd \u0d9a\u0dca \u0db1\u0dba \u0dc0\u0db1\u0d9c\u0d9a\u0dcf\u0db4 \u0d85\u0db4\u0dd2 \u0dbd\u0db6\u0dcf \u0d9c\u0dca \u0db1\u0dc0\u0dcf.\n\n\u0d85\u0d9c\u0dda \u0dcf\u0d9c \u0dba\u0dd0\u0dca \u0dad\u0dd2\u0d9c\u0db6\u0dca \u0d9c\u0dca \u0d9c\u0dc0\u0d9c \u0db3 \u0d9c\u0db1\u0dcf \u0dbb\u0dbb\u0dca\u0dd2\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba. \u0d85\u0db4\u0dd2 \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0dc0\u0dd4\u0da7\u0dca \u0d85\u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0dc0\u0dd4\u0da7\u0dca \u0d92 \u0dba\u0db4\u0d9c\u0dca \u0dc0\u0db8\u0dba\u0dd2 \u0d85\u0d9c\u0dda \u0dcf\u0d9c \u0dbb\u0dbb\u0dca\u0dd2\u0d9a\u0dba \u0db1\u0dcf\u0dbd\u0db1\u0dba \u0dc0\u0dca \u0d9c\u0dca . \u0d89\u0dda\u0dbd\u0dd4\u0db8\u0db4 \u0d85\u0dd4\u0dc0\u0dc0 \u0dc3\u0dd0\u0db1\u0dba\u0dd4\u0db8 \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0dc3\u0dd0\u0db1\u0dba\u0dd4\u0db8 \u0dc0\u0dd0\u0dd2\u0dba \u0db1 \u0db8\u0dd2\u0dbd \u0d85\u0dd4 \u0d9c\u0dc0\u0db1\u0dc0\u0dcf. \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0dba\u0dd0\u0dca \u0dd3\u0da9 \u0dc0\u0d9c\u0dcf\u0dc0 \u0d9a \u0db8\u0db1\u0dcf\u0d9a\u0dcf\u0da7\u0dba \u0d9a\u0dcf \u0d9c\u0dca \u0db1 \u0dc0\u0dd0\u0db1\u0db4 \u0d91\u0dca \u0db1 \u0db1\u0db1.. \u0dd3\u0da9 \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2\u0dc0\u0dd0\u0d9c\u0dca \u0d9c\u0dba\u0d9c\u0dba\u0db1 \u0d9c\u0d9a\u0dcf\u0db4\u0dc3\u0dad \u0d9c\u0dba\u0d9a\u0dca \u0d89\u0dca \u0db1\u0dc0\u0dcf. \u0d91\u0d9a \u0d9c\u0d9a\u0dcf\u0db4\u0dc3\u0dca \u0dc0\u0db8\u0dba\u0dd2 \u0dc0\u0dcf\u0dab\u0dd2\u0dca\u200d \u0d85\u0dcf\u0db8\u0dd4\u0dab\u0dd2\u0dca \u0d85\u0d9c\u0dda \u0dcf\u0d9c \u0dd3\u0da9 \u0dc0\u0d9c\u0dcf\u0dc0 \u0d9a\u0dcf\u0db1 \u0d85\u0dba. \u0d92\u0d9c\u0d9c\u0dcf\u0dda\u0dbd\u0dca \u0dc0\u0db8\u0dba\u0dd2 \u0d85\u0d9c\u0dda \u0dcf\u0db4\u0db4 \u0dc0\u0dd0\u0dd2\u0dba\u0db8 \u0dd3\u0da9 \u0d85\u0dc3\u0dad\u0dc0\u0dd0\u0dca \u0db1\u0dca \u0dbd\u0db6\u0dcf \u0d9c\u0dba\u0dca \u0d9c\u0dca . \u0d85\u0db1\u0dd2\u0dca \u0d9c\u0d9a\u0dcf\u0db4\u0dc3 \u0dc0\u0db8\u0dba\u0dd2 \u0da2\u0dd3\u0dc0\u0d9c\u0db1\u0ddd\u0db1\u0dcf\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd2\u0d9a\u0dda\u0db1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0d9c\u0dcf\u0da9\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0db1\u0dd2\u0dc3\u0dcf \u0dd3\u0da9 \u0dc0\u0d9c\u0dcf\u0dc0\u0db4 - \u0d9a\u0dc2\u0dd2\u0d9a \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0dca \u0dc0\u0dba\u0db4 - \u0d9c\u0db1\u0dbd\u0db9\u0dd2\u0dbd\u0dcf \u0dc0\u0d9c\u0dcf \u0d9a\u0dcf\u0d9c\u0d9c\u0db1 \u0dba\u0db1 \u0dca\u200d\u0dcf\u0db8\u0dd3\u0dba\u0dc0 \u0d9c\u0dc0\u0d9c\u0dc3\u0db1 \u0dca\u200d\u0db1\u0dc0\u0dcf\u0dc0. \u0d92 \u0d85\u0dd4\u0dc0\u0dc0 \u0d9a\u0dd4\u0da9\u0dcf \u0d9a\u0dd4\u0da9\u0dcf \u0d89\u0da9 \u0d9c\u0d9a\u0dcf\u0db4\u0dc3\u0dad \u0d9c\u0dba\u0dcf\u0dba\u0dcf \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0dca \u0db1\u0dc4\u0dc3\u0dd4\u0d9a \u0d85\u0dd4\u0d9c\u0dc0\u0dca \u0d85\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dcf \u0dda\u0db0\u0db1\u0dba\u0dca \u0dc3\u0dc4\u0dd2\u0dc0\u0dc0 \u0d85\u0dd4 \u0dba\u0dd0\u0dd4\u0dc0\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dc0\u0dc0 \u0d91\u0d9a\u0dad\u0dd4 \u0d9c\u0dc0\u0dbd\u0dcf \u0d9a\u0dc2\u0dd2\u0d9a \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0dca \u0dc0\u0d9c\u0dda \u0d9c\u0dba\u0d9c\u0dba\u0db1 \u0d9c\u0d9a\u0dcf\u0db4\u0dc3\u0d9a\u0dd4\u0dca \u0dc0\u0dcf\u0dab\u0dd2\u0dca\u200d \u0d85\u0dcf\u0db8\u0dd4\u0dab\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd0\u0dd2\u0dba \u0d89\u0da9 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0da7\u0dba\u0d9a - \u0dc0\u0db1\u0dc3\u0dbb\u0dd2\u0dba\u0d9a - \u0dc0\u0d9c\u0dcf \u0d9a\u0dcf\u0db8\u0dd2\u0dca \u0d85\u0d9c\u0dda \u0dcf\u0db4\u0db4 \u0db6\u0dc0 \u0dc3\u0db1\u0dba\u0db1 \u0d9c\u0d9a\u0dcf\u0db4\u0dc3\u0d9a\u0dd4\u0dca \u0d89\u0dca \u0db1\u0dc0\u0dcf. \u0d9c \u0d9c\u0d9a\u0dcf\u0db4\u0dc3\u0dad \u0d9c\u0dba\u0d9a \u0dc4\u0dbb\u0dd2\u0dba\u0db4 \u0d9a \u0db8\u0db1\u0dcf\u0d9a\u0dcf\u0da7\u0dba \u0d9a\u0dcf\u0d9c\u0d9c\u0db1 \u0d85\u0d9c\u0dda \u0d89\u0dbd\u0dca\u0d9a\u0dba\u0db4 \u0d85\u0db4\u0dd2 \u0d9c \u0d9a \u0d85\u0dcf\u0d9c\u0d9c\u0db1 \u0d91\u0dca \u0db1 \u0db1\u0db1.. \u0d91\u0d9c\u0dc4\u0db8 \u0dc0\u0dd4\u0d9c\u0da7\u0dcf\u0dca \u0dc0\u0db8\u0dba\u0dd2 \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2 \u0dca\u200d\u0db1\u0dc0\u0dcf\u0dc0\u0d9c\u0dda \u0d85\u0dc0\u0dc1\u0dca\u0dba\u0dc0\u0dcf\u0dc0 \u0dc3\u0dd4\u0dbb\u0dcf\u0db1 \u0dc0\u0dd2\u0d9a\u0dbb\u0d9c\u0dda \u0db8\u0dd4\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0da7\u0dba\u0dca \u0d94\u0dc0\u0dd4\u0dca \u0d9c\u0dda \u0d85\u0dc0\u0db4 \u0d9c\u0dba\u0dca \u0db1 \u0d85\u0db1\u0db4 \u0dd4\u0dbb \u0dc0\u0dca \u0dc0\u0dca \u0d9c\u0dca . \u0d92 \u0dd2\u0dbb\u0dba\u0dca \u0d9c\u0dca \u0dbb\u0dbb\u0dca\u0dd2\u0d9a \u0dc0\u0dc1\u0dca\u0d9c\u0dba\u0dca \u0dbd\u0dcf\u0db7\u0dba\u0dcf\u0dba\u0dd3 \u0d9c\u0dba\u0dba\u0dca \u0db6\u0dc0\u0db4 \u0d9c\u0db8\u0dba \u0db1\u0dca \u0d9a\u0dcf\u0dca \u0db1 \u0dd4\u0dbb \u0dc0\u0dca \u0d9c\u0dc0\u0dca \u0d9c\u0dca . \u0db1\u0dd0\u0dc0\u0dad\u0dd4\u0dab\u0dd4 \u0dcf\u0dca\u200d\u0dba\u0dca \u0d9c \u0dc0\u0dca \u0dca \u0dc0\u0dba \u0d9c\u0dca \u0dbb\u0dd4 \u0d85\u0dcf\u0d9c\u0d9c\u0db1 \u0d9c \u0dc0\u0dca \u0dca \u0dc0\u0dba \u0d9a\u0dd2\u0dca \u0dba\u0dd0\u0db1\u0d9c\u0d9c\u0db1 \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2 \u0dca\u200d\u0db1\u0dc0\u0dcf\u0dc0\n\n357 358\n\n2026 \u0d94\u0dca\u0d9c\u0dc0\u0ddd\u0db6\u0dbb\u0dca 07\n\n\u0d9c\u0dc0\u0dc0 \u0db6\u0dd3\u0dca\u200d \u0dd2\u0dad\u0d9a \u0d9c\u0db1\u0dcf\u0d9c\u0dc4\u0dcf\u0dcf \u0dd2\u0dad\u0d9a \u0dca\u200d\u0dbd\u0dba \u0dc0\u0dcf\u0dca\u0dc2\u0da7\u0dba \u0dad\u0db1\u0d9a\u0dcf\u0da7 \u0dc3\u0dc4 \u0dd0\u0d9a\u0d9a\u0dc0\u0dcf\u0da7\u0dba \u0dbd\u0db6\u0dcf \u0daf\u0dd4\u0dca \u0d9c\u0dca \u0d9c\u0d9a\u0dcf\u0dba\u0dd2 \u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0db4\u0dba \u0dd2\u0dbb\u0dba\u0db1 \u0d9a\u0dcf\u0dcf\u0da7\u0dba \u0d9c \u0dc3\u0db7\u0dcf\u0d9c\u0dda \u0d9c\u0db6\u0dcf\u0d9c\u0dc4\u0ddd \u0d9c\u0dba\u0d9c\u0db1\u0d9a\u0dd4\u0d9c\u0d9c\u0dca \u0dd2\u0dbb\u0dba\u0dd0\u0dc0\u0dd4\u0da7\u0dcf. \u0d92 \u0dd2\u0dad\u0d9a \u0db1\u0dd2\u0dc3\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dc0 \u0db4 \u0dc0\u0dd4\u0da7\u0dcf \u0db1 \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2 \u0dca\u200d\u0db1\u0dc0\u0dcf\u0dc0 \u0d85\u0dba \u0d89\u0dca \u0db1 \u0dc0\u0dca \u0dca \u0dc0\u0dba\u0db4 \u0db1\u0dca \u0d9c\u0dc0\u0dca \u0d9c\u0dca \u0db1\u0dd0\u0dc4\u0dd0."
