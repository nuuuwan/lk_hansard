    "description": "Hansard of 2026-10-08",
    "url_metadata": "https://www.parliament.lk/en/business-of-parliament/hansards",
    "lang": "si-ta-en",
    "url_pdf": "https://www.parliament.lk/uploads/businessdocs/english/24467_english_2026-10-08.pdf",
