    "chunk_text": "\u0dd4\u0d9a\u0dca\u0dad\u0dba\u0dad\u0dca\u200d \u0db6 \u0dc3\u0dd2\u0da7 \u0db8\u0dcf \u0dad\u0dd4\u0dbb \u0daf\u0d9a\u0dca\u0dad\u0dc0\u0dcf \u0daf\u0dd2\u0dba\u0dc0\u0db1 \u0d91 \u0dba\u0db9\u0db1 \u0db8\u0dc4 \u0d9a\u0dda\u0db1\u0dba \u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dbd\u0dca\u0dbd\u0da7 \u0d9c\u0dad\u0dad\u0dca \u0d9a\u0dbd, \u0dd4\u0d9a\u0dca\u0dad\u0dba\u0dad\u0dca\u200d \u0db6 \u0dc3\u0dd2\u0da7 \u0dba\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0db6 \u0db8\u0dd4\u0dbd\u0dca \u0dc3\u0dd2 \u0dad\u0dd4\u0dbb\u0db1 \u0daf\u0d9a\u0dca\u0dad\u0dc0\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba\u0dba\u0dda \u0dc0 \u0dc2\u0dcf\u0db4\u0dad\u0dca\u200d\u0db1\u0dba\u0dda \u0dc0\u0dd0\u0dd2 \u0dc0\u0dd3\u0db8\u0d9a\u0dca\u0dad, \u0db4\u0dc0\u0dad\u0dca\u0db1\u0dcf \u0dc0 \u0dc2\u0dcf\u0db4\u0dad\u0dca\u200d\u0db1\u0dba\u0da7 \u0dc0\u0da9\u0dcf \u0dc0\u0dd0\u0dd2 \u0dc0\u0dd3\u0db8\u0d9a\u0dca\u0dad \u0d85\u0dba\u0dca \u0d9a\u0dca\u0dad\u0dc2\u0dcf \u0d9a\u0dbb\u0db1 \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0dba\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0db6 \u0d85\u0dc0\u0dc3\u0dda \u0dc3\u0dd2\u0dba\u0dda \u0dc3\u0dd2\u0da7 \u0d89\u0dda \u0db4\u0dc3\u0dd4\u0dc0 \u0d91 \u0dba\u0db9\u0db1 2027 \u0dc0 \u0dc2\u0dba\u0dda \u0d85\u0dba\u0dda\u0dbd\u0dca \u0db8\u0dcf\u0dc3\u0dba \u0daf\u0d9a\u0dca\u0dad\u0dc0\u0dcf \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dc1\u0dba\u0dc0\u0dbd\u0da7 \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba\u0dba\u0dba\u0dda \u0dbd\u0dd0\u0dba\u0db6\u0db1 \u0dc0 \u0dc2\u0dcf\u0db4\u0dad\u0dca\u200d\u0db1\u0dba\u0da7 \u0dc0\u0da9\u0dcf \u0d85\u0da9\u0dd4 \u0dc0 \u0dc2\u0dcf\u0db4\u0dad\u0dca\u200d\u0db1\u0dba\u0d9a\u0dca\u0dad \u0d85\u0dba\u0dca \u0d9a\u0dca\u0dad\u0dc2\u0dcf \u0d9a\u0dbb\u0dba\u0dd2\u0db4\n\n\u0d91\u0db8 \u0db8\u0dcf \u0dba\u0d9c\u0dad \u0db4\u0dba\u0dc1\u0dba\u0dba\u0dda \u0daf\u0dd0\u0d9a\u0dca\u0dad\u0dba\u0dc0\u0db1 \u0dd2\u0dba \u0dba\u0dc1\u0dba \u0dba\u0db8\u0dba\u0dc3\u0dca\u0dba\u0dd2:\n\n2026/27 \u0db8\u0dc4 \u0d9a\u0dda\u0db1\u0dba\u0dda\u0daf\u0dd3 \u0dc0\u0dd3 \u0dc0\u0d9c\u0dad\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dba\u0db6 \u0d9c\u0dad \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0db4\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dd4\u0d9a\u0dca\u0dad\u0dba\u0dad\u0dca\u200d \u0db6 15 \u0daf\u0dd2\u0db1\u0da7 \u0dba\u0db4\u0dbb \u0dc3\u0dd2\u0dbb\u0da7 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dd2\u0dba \u0dba\u0dc1\u0dba \u0d9a\u0dbb\u0dba\u0dd2\u0db4 \u0d92 \u0d9a\u0dd2\u0dba\u0dda\u0dba\u0dda, \u0dd4\u0d9a\u0dca\u0dad\u0dba\u0dad\u0dca\u200d \u0db6 15\u0da7 \u0d9a\u0dd2\u0dda \u0dc0\u0d9c\u0dad\u0dcf \u0d9a\u0dbb\u0dda\u0db1 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dc3\u0db8\u0dca\u0dbb\u0dca \u0dab\u0dba\u0dba\u0dda \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0db8 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb \u0dd2\u0dba\u0db6\u0dda\u0dba\u0dda\u0db4 \u0dba\u0db8\u0dca \u0db8\u0d9f\u0dd2\u0dda \u0d85\u0db0\u0dd2\u0d9a \u0dc0 \u0dc2\u0dcf\u0dc0\u0d9a\u0dca\u0dad \u0dbd\u0dd0\u0dba\u0db6\u0db1 \u0dba\u0db1\u0dcf\u0dc0\u0dd0\u0db8\u0dca\u0db6 \u0db8\u0dcf\u0dc3\u0dba\u0dda\u0daf\u0dd3 \u0db8\u0dcf\u0dc3\u0dba\u0d9a\u0dca\u0dad \u0db4\u0db8\u0dab \u0dc0\u0dba\u0dc3\u0dd0\u0dd2 \u0daf\u0dd2\u0dbb\u0dd2\u0dba \u0dc3\u0dc4\u0dd2\u0dad\u0dca\u200d \u0dba\u0d9c\u0dad\u0dcf\u0dba\u0db8 \u0db4\u0dd0 \u0d9a\u0dca\u0dad\u0dba\u0dc2\u0dca\u0dbb\u0dba\u0dda \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0db4\u0db1\u0dba \u0dc0\u0dd3 \u0db4\u0dc0\u0dad\u0dd3\u0db4 \u0d85\u0db4\u0dd2\n\n\u0d9a\u0dd2\u0dda \u0dba\u0db8\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dbb \u0db4\u0da7\u0dda \u0d9c\u0dad\u0dad\u0dca\u0dba\u0dad\u0dca\u200d\u0dcf\u0dad\u0dca, \u0d9c\u0dad\u0d82\u0dc0\u0dad\u0dd4\u0dbb\u0dbb \u0dad\u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0dda, \u0dc0 \u0dc2\u0dcf\u0db4\u0dad\u0dca\u200d\u0db1 \u0dad\u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0dda \u0d91\u0db1\u0dba\u0d9a\u0dcf\u0da7 \u0dba\u0d9a\u0dca\u0dad\u0dd2\u0db8\u0dad\u0dca \u0db4\u0dd0 \u0dba\u0d9a\u0dca\u0dad \u0d85\u0db4\u0da7 \u0dc4\u0daf\u0dcf\u0d9c\u0dad\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dba\u0dd2 \u0dba\u0db8\u0dca\u0dba\u0d9a\u0dca\u0dad \u0d85\u0daf\u0dc4\u0dc3\u0db4 \u0d91\u0dad\u0dca\u200d\u0dba\u0d9a\u0dcf\u0da7 \u0dba\u0db8\u0dca \u0dd4\u0dba\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4\u0dbb \u0daf\u0dd3\u0db8\u0d9a\u0dca\u0dad \u0d9a\u0dbb \u0d9c\u0dad\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dda\u0db4 \u0dad\u0dca\u200d\u0dc0\u0daf, \u0dba\u0db8\u0dca \u0dd2\u0dba\u0dc3\u0dcf \u0db8\u0dc4 \u0d9a\u0dda\u0db1\u0dba \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dba \u0dc0\u0db1 \u0dba\u0db4\u0db6\u0dbb\u0dc0\u0dcf\u0dbb\u0dd2, \u0db8\u0dcf \u0dad\u0dd4\u0dbb \u0db8\u0dcf\u0dc3\u0dba\u0dda\u0dc4\u0dd2 \u0db4\u0dc0\u0dd2\u0db1 \u0dd2\u0dba\u0dba\u0d82 \u0dad\u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0dba\u0db4\u0dbb \u0d85\u0dc3\u0dca\u0dc0\u0db1\u0dd4 \u0dba\u0db1 \u0dcf\u0d9c\u0dad\u0dad\u0dca\u200d \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dda\u0db4\n\n2026/27 \u0db8\u0dc4 \u0d9a\u0dda\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dba\u0dc4\u0d9a\u0dca\u0dad\u0dba\u0da7\u0dba\u0dcf\u0dbb 830,000\u0d9a \u0dc0\u0dd3 \u0dc0\u0d9c\u0dad\u0dcf \u0d89\u0dbd\u0d9a\u0dca\u0dad\u0d9a\u0dba\u0d9a\u0dca\u0dad \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0d87\u0dad\u0dca\u200d\u0db4 \u0dba\u0db8\u0dc4\u0dd2\u0daf\u0dd3 \u0db4 \u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf \u0dba\u0da7\u0dba\u0dad\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 69\u0db437\u0d9a\u0dca\u0dad, \u0d92 \u0d9a\u0dd2\u0dba\u0dda\u0dba\u0dda \u0dba\u0dc4\u0d9a\u0dca\u0dad\u0dba\u0da7\u0dba\u0dcf\u0dbb 575,717\u0d9a\u0dca\u0dad \u0dc0\u0d9c\u0dad\u0dcf \u0d9a\u0dbb\u0db1 \u0d85\u0dad\u0dca\u200d\u0dbb, \u0d89\u0dda \u0db8\u0dc4\u0dcf \u0dc0\u0dcf\u0dbb\u0dd2 \u0dc4\u0dcf \u0db8\u0db0\u0dba \u0dc0\u0dcf\u0dbb\u0dd2 \u0dba\u0da7\u0dba\u0dad\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 63\u0db46\u0d9a\u0dca\u0dad, \u0d92 \u0d9a\u0dd2\u0dba\u0dda\u0dba\u0dda \u0dba\u0dc4\u0d9a\u0dca\u0dad\u0dba\u0da7\u0dba\u0dcf\u0dbb 366,190\u0d9a\u0dca\u0dad\u0daf, \u0dc0 \u0dc2\u0dcf\u0dba\u0db4 \u0dc2\u0dd2\u0dad\u0dca\u200d \u0dba\u0dbd\u0dc3 \u0dc3\u0dd2\u0dba\u0dba\u0da7 36\u0db44\u0d9a\u0dca\u0dad, \u0d92 \u0d9a\u0dd2\u0dba\u0dda\u0dba\u0dda \u0dba\u0dc4\u0d9a\u0dca\u0dad\u0dba\u0da7\u0dba\u0dcf\u0dbb 209,560\u0d9a\u0dca\u0dad \u0daf \u0dc3\u0dd2\u0dbb\u0da7 \u0d9a\u0dbb\u0dba\u0dd2\u0db4\n\n\u0dad\u0dca\u200d\u0dc0\u0daf, \u0d85\u0dda\u0dad\u0dca\u200d \u0db4 \u0dcf\u0dad\u0dca \u0d9a\u0dbd\u0dcf\u0db4\u0dc0\u0dbd \u0dc3\u0dd2\u0dba\u0dba\u0da7 19\u0db427\u0d9a - \u0dba\u0dc4\u0d9a\u0dca\u0dad\u0dba\u0da7\u0dba\u0dcf\u0dbb 159,941\u0d9a - \u0dc0\u0d9c\u0dad\u0dcf\u0dc0\u0d9a\u0dca\u0dad \u0dc3\u0dd2\u0dbb\u0da7 \u0d9a\u0dbb\u0db1 \u0d85\u0dad\u0dca\u200d\u0dbb, \u0db8\u0dc4\u0dc0\u0dd0\u0dd2 \u0dc3\u0d82\u0dc0 \u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dba\u0da7\u0dba\u0dad\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 11\u0db436\u0d9a - \u0dba\u0dc4\u0d9a\u0dca\u0dad\u0dba\u0da7\u0dba\u0dcf\u0dbb 94,288\u0d9a - \u0dc0\u0d9c\u0dad\u0dcf \u0dc0\u0db4\u0dc3\u0dbb\u0dd2\u0dba\u0d9a\u0dca\u0dad \u0d89\u0dbd\u0d9a\u0dca\u0dad\u0d9a \u0d9a\u0dbb \u0d87\u0dad\u0dca\u200d\u0db4 \u0dba\u0db7 \u0d9c\u0dad \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0db4\u0db1\u0dba\u0dda\u0daf\u0dd3 \u0db8\u0dcf\u0dc3 \u0dad\u0dd4\u0dbb\u0db1\u0dc4\u0db8\u0dcf\u0dbb \u0dc0\u0dba\u0dc3\u0dca \u0d9a\u0dcf\u0dab\u0dca\u0da9\u0dba\u0dda \u0dc0\u0dd3 - Bg 94/1, At 362, Bg 360, Bg 357, Bg 366, At 378, Bg 352 - \u0dc0\u0d9c\u0dad\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dd2\u0dba \u0dba\u0dc1\u0dba \u0d9a\u0dbb\u0dba\u0dd2\u0db4"
