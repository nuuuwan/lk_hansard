dd2\u0daf\u0dd2 4]7 \u0db0\u0dc1\u0da7 4 \u0dd9\u0dab\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dc1\u0da7\u0dcf \u0db1\u0dd9\u0db1\u0dca \u0db1\u0db1 \u0dca\u0dc1\u0daf\u0db0 \u0db1\u0db1 \u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dc4\u0dc0 \u0dca \u0da7\u0dcf \u0db6 \u0db8\u0dd2\u0db1\u0dca \u0db1\u0dc0\u0dbb\u0dab\u0dc3\n\n(iv) \u0dca \u0dc3iii) \u0db1\u0dbb\u0dd2\u0daf\u0dd2 \u0daf\u0dc1\u0dc3\n\n(\u0d86 \u0db0\u0dd9\u0dcf \u0dc5 \u0daf\u0db1\u0dcf \u0daf\u0dc1\u0dc3\n\n\u0d9c\u0dbb\u0dd4 \u0db8\u0dd4\u0da2\u0dd2\u0dd4\u0dbb\u0dca \u0dbb\u0dc4\u0dd4\u0db8\u0dcf\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dcf (\u0bc8\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0bae\u0bc1\u0b9c\u0bbf\u0baa\u0bc1\u0bb0\u0bcd \u0bb0\u0bb9\u0bc1\u0bc8\u0bbe\u0ba9\u0bcd) (The Hon. Mujibur Rahuman) \u0d9c\u0dc0 \u0da7 \u0dcf \u0db1\u0dcf \u0da7\u0dd4\u0db8 \u0db1\u0dd2, \u0db8 \u0daf\u0d89 \u0db1\u0dc5\u0daf\u0dca\u0dc0\u0dd0\u0db1\u0dd2 \u0db0\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dae\u0db1 \u0daf\u0db8 \u0dba\u0dd2\u0da9\u0dca\u0dc3\n\n\u0d9c\u0dbb\u0dd4 \u0d82\u0d86\u0da0\u0dcf\u0dbb\u0dca\u0dba\u0db4 \u0dc0\u0d9a\u0dde\u0dc2\u0dbd\u200d\u0dcf \u0d86\u0dbb\u0dd2\u0dba\u0dbb\u0dad\u0dca\u0dad\u0db1 \u0dc0\u0db8\u0dc0\u0db1\u0dc0\u0dd2\u0dba (\u0bc8\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 (\u0b95\u0bb2\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf) (\u0ba4\u0b9a\u0bb2\u0bcd\u0bb5\u0bbf) \u0ba4\u0b95\u0bcc\u0bb7\u0bb2\u0bcd\u0baf\u0bbe \u0b86\u0bbe\u0bbf\u0baf\u0bb0\u0ba4\u0bcd\u0ba9) (The Hon. (Dr.) (Ms.) Kaushalya Ariyarathne) \u0d9c\u0dc0 \u0da7 \u0dcf \u0db1\u0dcf \u0da7\u0dd4\u0db8 \u0db1\u0dd2, \u0d87\u0dca \u0db4\u0db8 \u0dca\u0dd4\u0db8 \u0dcf \u0dd2\u0dbb\u0dc1\u0dc0 \u0da7\u0dcf \u0dab \u0db4 \u0db8 \u0db8 \u0dca \u0dca\u0da7\u0d9f \u0daf\u0dc0\u0db1\u0dc0\u0dcf \u0dc3 \u0dca\u0da7 \u0db1\u0dd0\u0dca \u0dd2\u0dbb\u0db1\u0dca \u0db0\u0db1\u0db4 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0daf\u0dd2\u0d9c\u0dd4\u0da7\u0dcf \u0dbd\u0dd3\u0db1 \u0dc0\u0dd2\u0daf\u0dc1\u0da0\u0db1 \u0dca \u0db8 \u0dba\u0dd2\u0da9\u0dca, \u0db1\u0dd9\u0db1\u0dca \u0d86 \u0db1\u0daf\u0dad \u0db0\u0dab\u0daf\u0dca \u0db4 \u0d87\u0dca \u0db4\u0db8 \u0dca\u0db8 \u0d86 \u0db1 \u0da7\u0dab\u0daf\u0d9c\u0db1 \u0db1 \u0dc0\u0dd0\u0da9\u0da7\u0db4\u0dba\u0dd4\u0dd4 \u0dbb\u0dd2 \u0db4\u0db8 \u0d9c\u0dd0\u0dc5\u0daf\u0db1\u0db1\u0dc0\u0dcf \u0dd9 \u0dd2\u0dbb \u0db1 \u0dca\u0da7\u0dc3 \u0d9c\u0dc0 \u0db8 \u0db1\u0dca\u0dd3\u0dd4\u0db8 \u0dcf \u0dd9\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0dd9 \u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0db1\u0dd0 \u0dd0, \u0d92 \u0db1\u0dd2\u0dca\u0dcf \u0db8 \u0db0\u0db4\u0dd2 \u0db8 \u0dd1 \u0da7\u0dd3 \u0dca\u0db8 \u0d86 \u0db1 \u0db4 \u0db1\u0dc0 \u0dca\u0db7\u0dcf \u0db1\u0dad\u0dd2\u0dc0\u0dab\u0daf \u0dca \u0dca \u0db0\u0db1\u0dba\u0dca\u0dc2\u0dca\u0da8 \u0db8 \u0dab\u0dca\u0da9\u0da9 \u0dca \u0db1\u0dca \u0da7\u0dc5\u0dcf \u0dc3 \u0db0\u0db4\u0dd2 \u0db6 \u0dcf \u0daf\u0db1\u0dcf \u0daf\u0dab\u0dcf \u0dca \u0dd4 \u0daf\u0dc0\u0db1\u0dc0\u0dcf , \u0dca\u0daf\u0dca \u0dad\u0dd2\u0daf\u0db6\u0db1 \u0db1\u0dcf \u0db0\u0db8 \u0dcf \u0dcf \u0dc3\u0dd2 \u0dc0 \u0db8 \u0db1\u0dd0\u0dc0 assess \u0da7\u0dab \u0dcf , \u0d92 \u0dd2\u0dbb \u0db1\u0dca\u0daf\u0db1\u0dca \u0dca\u0daf\u0dca\u0dae\u0dc0 \u0dc0\u0dca \u0da7\u0dab \u0dcf \u0daf\u0dca \u0db0\u0dab\u0daf\u0dca \u0db4 \u0db0\u0dc0\u0db0\u0dba \u0dc0\u0dd2\u0dd2\u0d9a\u0daf\u0dad \u0dd2\u0dbb\u0dc3\u0dd2 \u0dca \u0dca\u0dc1\u0daf\u0db0 \u0db1\u0db1 \u0dca \u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0db4\u0dc3 \u0d92 \u0dca\u0dc4 \u0dcf \u0dd9\u0dd0\u0db1\u0db4 \u0da7\u0db8\u0dd2\u0dd4\u0db8\u0dc0\u0dca \u0db1\u0dca \u0da7\u0dab \u0dcf \u0dad\u0dd2\u0daf\u0db6\u0db1\u0dc0\u0dcf \u0dc3\n\n\u0daf\u0dca \u0dc0\u0db1\u0dc0\u0dd2\u0db4 \u0db0\u0daf\u0db1\u0d9a\u0dd4\u0dca \u0dab\u0dcf \u0d82\u0dba \u0d86 \u0db1\u0dc0 \u0db1\u0dd2 \u0db1\u0dcf \u0dbb\u0dd2\u0db1\u0dca \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4 \u0dd2\u0dbb\u0dd3\u0db8\u0daf\u0dca \u0d86 \u0db1 \u0dd2\u0dbb\u0daf\u0dca\u0db1 \u0dca\u0db8 \u0dad\u0dd2\u0daf\u0db6\u0db1\u0dc0\u0dcf \u0dc3 \u0dca\u0db8 \u0dab \u0daf\u0dc0 \u0dcf \u0dc0\u0db4 \u0dca\u0da7\u0db8 \u0da7\u0db4\u0dba\u0dd4\u0dca \u0dca\u0dc0\u0dd0\u0db1\u0dd2 \u0d86 \u0db1 \u0dd2\u0dbb\u0daf\u0dca\u0db1 \u0dd2\u0dbb\u0db1\u0dca\u0db8 \u0da7\u0dab\u0db1 \u0db6\u0dc0 \u0db0\u0db4\u0dd2 \u0db3\u0dd4\u0db1\u0dcf \u0daf\u0d9c\u0db1 \u0dad\u0dd2\u0daf\u0db6\u0db1\u0dc0\u0dcf \u0dc3 \u0dca\u0dba\u0dd2\u0da9\u0dca\u0db1\u0dca \u0dca\u0da7 \u0d86 \u0db1 \u0dca \u0db8 \u0dba\u0dd2\u0da9\u0dca, \u0db1\u0dd9\u0db1\u0dca \u0d86 \u0db1 \u0dc3 \u0d92 \u0d86 \u0db1 \u0dca\u0dca\u0daf\u0da7\u0dcf \u0db8 \u0dca\u0da7\u0dd4 \u0da7\u0dab \u0dcf , \u0dca\u0dc1\u0dc0\u0dd2\u0dd2\u0d9a \u0dc0\u0dd2\u0dd2\u0d9a \u0db4 \u0dab\u0dcf \u0d82\u0dba \u0db1\u0dd2 \u0db1\u0dcf \u0dbb\u0dd2\u0db1\u0dca\u0db4, \u0db1\u0dc5\u0dcf \u0dca \u0db1\u0dcf \u0db1 \u0d86 \u0db1\u0dc0 \u0db1\u0dd2 \u0db1\u0dcf \u0dbb\u0dd2\u0db1\u0dca\u0db4 \u0dca \u0db0\u0daf\u0db1\u0d9a\u0dd4\u0dca \u0d86 \u0db1\u0dc0 \u0db1\u0dd2 \u0db1\u0dcf \u0dbb\u0dd2\u0db1\u0dca\u0db4 \u0db0\u0dd9\u0dcf \u0dc5 \u0dab\u0dcf \u0d82\u0dba \u0db1\u0dbb\u0dd2\u0db1\u0dcf \u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dc4 \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4 \u0dd2\u0dbb\u0dd3\u0db8\u0daf\u0dca \u0db1\u0dcf \u0db0\u0db8 \u0dcf \u0dcf \u0db3\u0dd4\u0db1\u0dca\u0dc0\u0dcf \u0daf\u0dd9\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1\u0da7\u0db8 \u0dad\u0dd2\u0daf\u0db6\u0db1\u0dc0\u0dcf \u0dc3 \u0dd0\u0db8 \u0dd0\u0db1\u0dd2\u0db1\u0dca\u0db8 \u0dca\u0da7 \u0dca\u0da7 \u0d92\u0dc0\u0dcf \u0da7\u0dab\u0db1\u0dc0\u0dcf \u0daf\u0dc0\u0db1\u0dd4\u0dc0\u0db4\n\n1661 1662\n\n[\u0d9c\u0dc0 \u0dc3\u0d86\u0da0\u0dcf \u0dbb\u0dca \u0daf\u0da7\u0dde\u0dc2\u0dca\u0da8 \u0dba\u0dcf \u0d86\u0dbb\u0dd2 \u0dab\u0dca \u0db1 \u0daf\u0db8 \u0daf\u0db1\u0dc0\u0dd2 ]\n\n2026 \u0dca\u0dd0\u0db4\u0dca \u0dd0\u0dca\u0db6\u0dbb\u0dca ]]\n\n\u0dca\u0dc1\u0dc0\u0dd2\u0dd2\u0d9a \u0dca\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dca \u0db3\u0dd4\u0db1\u0dca\u0dc0