\u0db8 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dda. \u0d91\u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db8\u0dc4\u0dc0\u0dd0\u0dbd\u0dd2 \u0d91\u0dbd\u0dca \u0dd2 \u0d91\u0dbd\u0dca \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0dda \u0dc0\u0dbb\u0dca\u0dc2\u0dcf\u0dc0 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0dc0\u0dd3\u0db8\u0dad\u0dca \u0dc3\u0db8\u0d9f \u0dc0\u0dd3 \u0dc0\u0d9c\u0dcf\u0dc0 \u0dc3\u0dca\u0dae\u0dcf\u0db4\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd4\u0db8\u0dca \u0da7 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd4\u0db8\u0dca \u0d9a\u0dbb \u0d87\u0dad. \u0da2\u0dbd \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0d9a\u0dca\u0dc2\u0db8\u0dad\u0dcf\u0dc0 \u0d89\u0dc4\u0dc5 \u0db1\u0dd0\u0d82\u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0dda \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0dc0\u0dbb\u0dca\u0dc2\u0dcf\u0db4\u0dad\u0db1\u0dba \u0dbd\u0dd0\u0db6\u0dd9\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db1 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dc0\u0dbd \u0d91\u0db8 \u0da2\u0dbd\u0dba \u0d8b\u0db4\u0dba\u0ddd\u0d9c\u0dd2 \u0d9a\u0dbb \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0db6\u0dd2\u0db8\u0dca \u0db8\u0dca \u0dc3\u0dd0\u0d9a\u0dc3\u0dd3\u0db8 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dbb \u0d87\u0dad. \u0d9a\u0dbb \u0d87\u0dad.\n\n\u0db8\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc0\u0dcf\u0dbb\u0dd2 \u0dc0\u0dca\u200d\u0dba\u0dcf\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dba\u0db1\u0dca\u0dc4\u0dd2 2026/27 \u0db8\u0dc4 \u0d9a\u0db1\u0dca\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc4 \u0d9a\u0db1\u0dca\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0da2\u0dbd\u0dba \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dbb \u0d87\u0dad. \u0d9a\u0dbb \u0d87\u0dad. i. \u0dc4\u0db3\u0db4\u0dcf\u0db1\u0dcf\u0d9c\u0dbd vi. \u0dc4\u0dd4\u0dbb\u0dd4\u0dc5\u0dd4\u0dc0\u0dd0\u0dc0 ii. \u0db1\u0dd4\u0dc0\u0dbb\u0dc0\u0d