    "chunk_text": "\u0d8a\u0dc5\u0d9f \u0da7\u0dc0 \u0daf\u0db8 \u0dba\u0dd2\u0da9\u0dca\u0dc3 \u0dd9\u0dd0\u0db1\u0db4 \u0db0\u0db1\u0dcf \u0dbb\u0dca\u0dd2\u0da7 \u0dd0\u0db8 \u0db8 \u0dcf \u0dbb\u0dca\u0d9c \u0da7\u0db8 \u0dab\u0dcf \u0dad\u0dca\u200d\u0dbb\u0dd2\u0daf\u0dad \u0d92 \u0daf\u0dca\u0dae\u0dc0 \u0dca\u0db1 \u0db1\u0dca\u0daf\u0db1\u0dca SLTB \u0dca\u0da7\u0dc3 \u0daf\u0db1\u0dde \u0db8\u0d9c\u0dd2\u0da7 \u0db0\u0dc1\u0db0\u0daf \u0db1\u0dca \u0d92\u0da7 \u0da7\u0dab\u0db1\u0dc0\u0dcf \u0dca \u0dcf \u0db8 \u0db0\u0dd4\u0dba\u0dd2\u0da9\u0dca\u0dc3 \u0d9c\u0dc0 \u0db8 \u0db1\u0dca\u0dd3\u0dd4\u0db8 \u0db1\u0dd2, \u0d92 \u0db1\u0dd2\u0dca\u0dcf SLTB \u0dca\u0da7 \u0dca\u0dc1\u0dc0\u0dbb\u0dca\u0db1\u0db1 \u0da7\u0dab \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dcf \u0db4 \u0db8 \u0dba\u0dd2\u0da9\u0dca \u0dca\u0db6\u0dd4\u0db8 \u0dcf \u0dca \u0dd2\u0dbb \u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0dc0 \u0db8 \u0da7\u0dca\u0db4\u0db8 \u0db4 \u0daf\u0db8 \u0db8 \u0daf\u0dca\u0dae\u0dc0\u0dcf \u0dc0 \u0db1\u0dca\u0daf\u0db1\u0dca\u0dc3 \u0d92 \u0dc0\u0dcf \u0daf\u0d89\u0db8 \u0db0\u0db4\u0dd2 \u0daf\u0dca \u0db1\u0dc0\u0dcf , \u0db0\u0dab \u0dca\u0db6\u0dd4\u0db8 \u0dcf \u0da7\u0dd2\u0db1\u0dca \u0dd2\u0dbb \u0db4\u0dd4 \u0d92\u0da7\u0dcf \u0db6 \u0db8\u0db1 \u0da7\u0dcf \u0dca\u0db4 \u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf \u0dca \u0db8 \u0da7 \u0da7\u0dc5\u0dcf \u0db8 , \u0d92 \u0dc0\u0dcf \u0daf\u0d89\u0db8 \u0dca\u0dd1\u0db8 \u0db6\u0dca\u0dae \u0dca\u0da7\u0da7\u0db4\u0db8 GPS \u0d8b\u0db1\u0da7\u0dab \u0dca\u0dc0\u0dd2 \u0da7\u0dab \u0dcf \u0db0\u0db4\u0dd2 \u0d92\u0daf\u0d9c\u0dcf \u0dc0 \u0db1\u0dca\u0dc0 monitor \u0da7\u0dab\u0db1\u0dca\u0db1 \u0db1\u0db4\u0db1\u0dca \u0d9c\u0dca \u0dcf \u0db4 \u0db1\u0dca\u0dae\u0daf\u0dca\u0dae \u0dbb\u0dd1 44\u0dc300\u0db4 \u0db1 \u0db6\u0dca\u0dae \u0dca\u0da7 private \u0dc0\u0dd4 \u0dca \u0db1\u0dcf \u0dd4 \u0db1\u0dca, \u0db0\u0db4\u0dd2 \u0da7\u0dab\u0db1\u0dca\u0db1 \u0db1 \u0dca cluster bus company \u0dd2\u0dbb \u0db1 \u0dc0\u0dd0\u0da9\u0dca\u0db4 \u0db1 \u0d87\u0dd4\u0daf\u0dc5\u0dae \u0d92 \u0db6\u0dca\u0dae \u0dab\n\n1651 1652\n\n\u0db1\u0dcf \u0dbb\u0dca\u0dd2\u0daf\u0dca\u0db1\u0dca\u0dd4\u0dc0\n\n\u0d9c\u0dc0 \u0da7 \u0dcf \u0db1\u0dcf \u0da7\u0dd4\u0db8 \u0db1\u0dd2, \u0db8 \u0db1\u0dca\u0dd3\u0dd4\u0db8 \u0dcf \u0daf\u0d89 \u0daf\u0dd9\u0dc0\u0db1 \u0db0\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dae\u0db1 \u0db4 \u0dca\u0dcf \u0db1\u0dcf \u0dab \u0db4\u0dd2\u0dc5\u0dd2\u0dd4\u0dab\u0dca \u0dca\u0db1\u0dca\u0db1\u0dcf \u0dd2\u0dbb \u0dcf \u0db8 \u0dcf \u0daf\u0dca \u0db1\u0dc0\u0dcf \u0dc3 \u0d92 \u0dc0\u0dcf \u0daf\u0d89\u0db8 \u0db8 \u0dcf \u0dc0 \u0dc0\u0dd2\u0db1\u0dcf \u0da9\u0dd2 \u0dca \u0dca \u0dc0 \u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dcf , \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf \u0db1 \u0dca\u0dca\u0db6\u0db1\u0dca\u0db1\u0dc0 \u0daf\u0dc0\u0db1\u0dca \u0da7\u0dc0 \u0dca \u0dd2\u0dbb \u0db1\u0dca\u0db1, \u0dc0\u0dd2\u0daf\u0db0\u0dae\u0dc2\u0dca\u0da8\u0daf \u0db1\u0dca\u0db8 \u0dc0\u0dcf \u0db1\u0dc0 seat belts \u0dca\u0dca\u0db6\u0db1\u0dca\u0db1\u0dc0\u0dc3 Seat belts \u0dca\u0dc0\u0dd2 \u0daf\u0db1\u0dcf \u0da7\u0dab \u0d86\u0db4\u0dd4 \u0dc0\u0dcf \u0db1\u0dc0 \u0db4 \u0d92\u0da7 \u0db0\u0db1\u0dd2\u0dc0\u0dcf \u0dbb\u0dca \u0dc0\u0dd4 \u0dcf , \u0db1\u0dd3\u0dad\u0dd2 \u0daf\u0d9c\u0db1\u0dd0 \u0dc0 \u0dcf \u0db0\u0dc0\u0dd4\u0dc0 \u0db8\u0dd9\u0da7\u0db4 \u0db1\u0dca\u0dae\u0daf\u0dca\u0dae\u0dc3 \u0d92, \u0db1\u0dc0 \u0dd2 \u0dca\u0dd0\u0db4\u0dca \u0dd0\u0dca\u0db6\u0dbb\u0dca 4]\u0dc0\u0db1 \u0dd9\u0dcf \u0dc3\u0dd2\u0db4\u0dc3 \u0d92\u0daf\u0dca \u0dad\u0dd2\u0daf\u0db6\u0db1 \u0db4\u0dca\u200d\u0dbb\u0daf \u0d82\u0db1 \u0dd9\u0dc0\u0dca\u0dae \u0daf\u0dd9\u0da7\u0da7\u0db4 \u0da7\u0dd2\u0db1\u0dca \u0da7\u0db1\u0d9c\u0dcf \u0dd4\u0db8\u0dd9\u0dcf \u0da7 \u0dc3\u0dd2 \u0db8\u0dd2\u0d9a \u0dd2\u0dbb\u0db1\u0dca \u0db0\u0db1\u0db4 \u0dca\u0db4\u0dca\u0db4\u0dd4 \u0dc0\u0dd4 \u0dcf , Southern Expressway \u0dca\u0daf\u0dca \u0dc0\u0dcf \u0db1 44\u0dca accident \u0d85 \u0db0\u0dc0\u0dca\u0dae \u0dcf \u0daf\u0dc1\u0dd3 \u0dc3 \u0dca\u0db8 \u0db0\u0dc0\u0dca\u0dae \u0dcf \u0daf\u0dc1 \u0db0\u0db1\u0dd4\u0dab\u0db4 \u0dca \u0d85 \u0dc0\u0dcf \u0db1 \u0da7 \u0db1\u0dcf \u0dca \u0dc0 \u0dd9\u0dc0 \u0dc0\u0db1\u0dd4\u0dca \u0dc0\u0dd2\u0db0\u0dcf \u0db4\u0dd2\u0dbb\u0dd2\u0dca\u0dca \u0dc3\u0dd2\u0da7\u0dd2 \u0dcf \u0dc3 \u0dd0\u0db6\u0dd0\u0dba\u0dd2\u0da9\u0dca, \u0db6\u0dca\u0dae \u0dca\u0daf\u0dca \u0dc3\u0dd2 \u0dbd\u0dd4\u0daf\u0dd9\u0db1\u0dcf \u0db8 seat belts \u0dd9\u0dcf \u0daf\u0d9c\u0db1 \u0daf\u0dca\u0db4\u0db4\u0dd4 \u0db1\u0dd2\u0dca\u0dcf \u0d92\u0daf\u0d9c\u0dcf \u0dc0 \u0db1\u0dca\u0db4 \u0daf\u0dc0\u0dca\u0da0 \u0db0\u0db1\u0dd4\u0dc0 \u0db0\u0dd4 \u0dc0\u0dd4 \u0dcf \u0dc3 \u0dca\u0db8 \u0dab \u0daf \u0db8\u0dc0 \u0dc0\u0dc0 \u0db4 \u0dd0\u0da9 \u0d9c\u0dd0\u0daf \u0db1\u0dca\u0db1 \u0dad\u0dd2\u0daf\u0db6\u0db1 \u0dca\u0dc2\u0dca\u0da8\u0dae\u0da7\u0dab \u0dcf \u0dc0 \u0db8 \u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0dc3 \u0d92 \u0db1\u0dd2\u0dca\u0dcf \u0db8 \u0dba\u0dd2\u0da9\u0dca \u0db0\u0db4\u0dd2 \u0db0\u0dc0\u0dd4\u0dc0 \u0db8\u0dd9\u0da7 \u0da7\u0dcf \u0dca \u0dca\u0db1\u0dca\u0daf\u0db1\u0dca\u0dc3 \u0db0\u0db4\u0dd2 \u0da7\u0dc0\u0dd4\u0dc0 \u0dca \u0da7\u0dd0\u0db8 \u0dd0\u0dad\u0dd2\u0dba\u0dd2\u0da9\u0dca, \u0db0\u0dab \u0daf\u0d9c\u0dd9\u0dab \u0dca\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0dd2\u0d9a \u0db4 \u0dd0\u0db8 \u0dd0\u0db1\u0da7\u0db8 \u0dca\u0db1\u0dca\u0db1\u0dc3 \u0db1\u0daf\u0dca\u0dca \u0dca\u0daf \u0db8 \u0daf\u0db1\u0dcf \u0daf\u0dc0\u0dba\u0dd2\u0da9\u0dca, \u0d86\u0dab\u0dca\u0dc2\u0dca\u0da8\u0dcf \u0dc0 \u0db1\u0dd0\u0dca \u0dca \u0db6 \u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1\u0dc3 \u0dd0\u0db6\u0dd0\u0dba\u0dd2\u0da9\u0dca, \u0daf\u0db8 \u0dd0\u0db1\u0daf\u0dd2 \u0dc0\u0dd2\u0daf\u0db0\u0dae\u0dc2\u0dca\u0da8 \u0daf\u0dd9 \u0dca \u0dd2\u0dbb \u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1\u0dc3 \u0db0\u0db4\u0dd2 \u0db1\u0dd3\u0dad\u0dd2 \u0dca\u0dca\u0db1\u0dcf \u0dd9\u0db1 \u0da7\u0dab \u0dcf \u0dad\u0dd2\u0daf\u0db6\u0db1\u0dca\u0daf\u0db1\u0dca \u0daf\u0db8 \u0db1\u0dca\u0db1 \u0daf\u0dca \u0dc0\u0dd2\u0dd2\u0d9a \u0db4\u0dc3 \u0dca \u0dc0\u0dcf \u0db1 \u0dca seat belts \u0dca\u0dca\u0da7\u0db8 \u0d87\u0dc0\u0dd2 \u0dc0 \u0dcf \u0dad\u0dd2\u0daf\u0db6\u0db1\u0dc0\u0dcf \u0db1\u0dca, \u0d92\u0dc0\u0dcf \u0dd9\u0dcf \u0daf\u0d9c\u0db1 \u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1\u0dc3 \u0dca\u0daf \u0db8 seat belts \u0d87\u0dc0\u0dd2 \u0dc0 \u0dcf \u0db1\u0dd0\u0dca \u0db1\u0dca, \u0d92\u0dc0\u0dcf \u0dca\u0dc0\u0dd2 \u0da7\u0dab \u0d9c\u0dca \u0dcf \u0db8 \u0db0\u0dd2\u0d9a\u0daf\u0dc1\u0dd3 \u0db8 \u0dcf \u0dbb\u0dca\u0d9c\u0daf\u0dad \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dc3"
