\u0dd2 , \u0da7\u0dd3.\u0d91\u0da0\u0dca\u0da0.\u0d91\u0dc3\u0dcf\u0dca.\u0dba\u0dd6. \u0dad\u0dd2\u0dbb\u0dd2\u0db8\u0dc1\u0db1\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dc1 (\u0dc3\u0dcf\u0dc4\u0d9a\u0dc1\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db0\u0dc1\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dc1\u0dbb\u0dd2\u0dc4\u0dd4)\n\n\u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0d82\u0dc1\u0dba II - \u0db4\u0d9a\u0dca.\u0db4\u0dd3. \u0da0\u0db1\u0dca\u0daf\u0db1 \u0db8\u0dc4\u0dad\u0dc1 (\u0dc3\u0dcf\u0dc4\u0d9a\u0dc1\u0dbb \u0d85\u0db0\u0dba\u0d9a\u0dca\u0dc2 - \u0dd9\u0dbb\u0dd2\u0dd9\u0dc1\u0dbd\u0db1) \u0da9\u0dd3. \u0d91\u0db8\u0dca. \u0da9\u0dd3. \u0d85\u0dbd\u0dc4\u0db4\u0d9a\u0ddd\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2 (\u0db4\u0dca\u200d\u0dbb\u0db0\u0dc1\u0db1\n\n\u0db1\u0dd2\u0dbd\u0db0\u0dc1\u0dbb\u0dd2) \u0d86\u0dda.\u0d91\u0db8\u0dca.\u0d91\u0dc3\u0dcf\u0dca. \u0dc3\u0dcf\u0db8\u0db1\u0dca\u0da2\u0dd2\u0d9a\u0dc1 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2 (\u0db1\u0dd2\u0db4 \u0ddd\u0da2\u0dba \u0db4\u0dca\u200d\u0dbb\u0db0\u0dc1\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dc1\u0dbb\u0dd2) \u0da9\u0dda\u0dd2 \u0dda.\u0db4\u0d9a\u0dca.\u0d92.\u0d91\u0db8\u0dca.\u0d91\u0db8\u0dca.\u0d91\u0db8\u0dca. \u0d85\u0dda\u0dae\u0db1\u0dc1 \u0d9a \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2 , \u0d91\u0db8\u0dca. \u0d92. \u0da9\u0dd3. \u0d91\u0dc3\u0dcf\u0dca. \u0da7\u0dd3. \u0db1\u0dca\u0dbb\u0db4\u0dc3\u0dcf\u0dca\u0d9a\u0dbb \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2 (\u0dd9\u0dc1\u0dda\u0dd2 \u0db4\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4 \u0db1\u0dd2\u0dbd\u0db0\u0dc1\u0dbb\u0dd2\u0dc4\u0dd4)\n\n\u0dbb\u0da2\u0dca\u0dda \u0d9c\u0dd2\u0dd4\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc4\u0dcf \u0dca\u0db4\u0dcf\u0daf\u0dd4 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0d82\u0dc1\u0dba - \u0d91\u0da0\u0dca\u0da0. \u0d92. \u0da7\u0dd3. \u0da9\u0dd3. \u0db4\u0dc4\u0d