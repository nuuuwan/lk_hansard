n\u0baa\u0bc6\u0bbe\u0ba4\u0bc1\u0b95\u0bc6\u0bbe\u0baa\u0bcd\u0baa\u0bc1\u0baa\u0bcd \u0baa\u0bbf\u0bc6\u0ba4\u0bbf \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0bc6\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8e\u0ba4\u0bbf\u0bc6\u0bc6\u0bbe\u0ba9 \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0bae\u0b95\u0baf\u0bbf\u0bb2\u0bcd\u0bb2\u0bc6\u0bbe\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0bc6\u0bc6\u0bae\u0bc8 \u0ba4\u0ba4\u0bc6\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bc6\u0bbe\u0ba9 \u0ba4\u0bc0\u0bb0\u0bcd\u0bc8\u0bc6\u0bbe\u0ba9\u0bae\u0bcd [\u0baa: 1062] \u0b85\u0bc6\u0bc6\u0bc6\u0bbe\u0b99\u0bcd\u0b95 \u0ba8\u0bbf\u0ba4\u0bbf \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bbf\u0ba9\u0bcd \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0bae\u0b95 [\u0baa: 1070] \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bc6\u0bbe\u0baf\u0bcd\u0bae\u0bc2\u0bb2 \u0bb5\u0bbf\u0bae\u0b9f\u0b95\u0bb3\u0bcd [\u0baa: 1072-1111] \u0ba4\u0ba9\u0bbf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bae\u0bc2\u0bb2 \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe:\n\n\u0b8a\u0bb4\u0bbf\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bc6\u0bae\u0bcd\u0baa\u0bb3\u0ba4\u0bcd\u0bae\u0ba4 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bc6\u0bc6\u0bbe\u0b9f\u0bcd\u0bc6\u0bbf\n\n\u0bc6\u0bae\u0baa\u0b95\u0bb3\u0bcd \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0bc6\u0b9a\u0bcd\u0bc6\u0bbf\u0bae\u0ba9\u0b95\u0bb3\u0bcd [\u0baa: 1111] \u0b89\u0ba4\u0bcd\u0bb0\u0ba4\u0bc6 \u0b95\u0bb2\u0bcd\u0bb5\u0bbf\u0baa\u0bcd \u0baa\u0bc6\u0bbe\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f \u0bc8\u0bb1\u0bc1\u0bc6\u0bc0\u0bc6\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1 [\u0baa: 1115]\n\n\u201c\u0db1\u0dcf \u0d8b\u0dba\u0db1\u201d \u0d86\u0dbb\u0dab\u0dca\u200d\u0dba \u0d9c\u0dc3\u0db4\u0db1\u0dcf\u0dc3\u0db1\u0d9c\u0dda \u0dd2\u0daf\u0dd4 \u0dd6 \u0d9c\u0daf\u0daf\u0da2\u0db1\u0d9a \u0d85\u0db1\u0dad\u0dd4\u0dbb:\n\n\u0db6\u0dd4\u0daf\u0dca\u0db0\u0dca\u200d\u0db1\u0dc1\u0db7\u0db1, \u0d86 \u0db8\u0dd2\u0d9a \u0db7\u0dc4 \u0db7\u0d9c\u0db7\u0dc0\u0d9a\u0dd8\u0dad\u0dd2\u0dc3\u0d9a \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0db8\u0dc1\u0dad\u0dca\u200d\u0dba\u0dad\u0dd4\u0db8\u0dc1\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dc1\u0db1 [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 111]] \u0d86\u0db1\u0dba\u0db1 \u0dc4\u0dc3\u0dcf \u0d85\u0db4\u0db1\u0dba\u0db1 (\u0db4\u0dcf\u0dbd\u0db1) \u0db4\u0db1\u0dad:\n\n\u0dba\u0dbb\u0d9c\u0dd4\u0dbd\u0dc1\u0dc3\u0dd2 [\u0dad\u0dd3\u0dbb\u0dd4 1120-1219]\n\n\u0d9a\u0dbd\u0dca\u0dad\u0dd0\u0db6\u0dd3\u0d9c\u0db8\u0dca \u0d9c\u0dba\u0ddd\u0da2\u0db1\u0dcf\u0dc0:\n\n\u0dba \u0ddd\u0da2\u0dd2\u0dad\u0dca\u200d \u0dd2\u0dc1\u0daf\u0dd4\u0dbd\u0dd2 \u0dc1\u0db7\u0dc0\u0dad\u0dd4 \u0d85\u0da9\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 [\u0dad\u0dd3\u0dbb\u0dd4 1220-1234]\n\n\"\u0ba8\u0bc6\u0bbe \u0b89\u0baf\u0ba9\" \u0b86\u0bc6\u0ba3\u0bcd\u0baf \u0bb0\u0bc6\u0ba9\u0bc6\u0bbe\u0bc6\u0ba9\u0bb5\u0bbf\u0bb2\u0bcd \u0b87\u0b9f\u0bae\u0bcd\u0ba4\u0baa\u0bb1\u0bcd\u0bb1 \u0ba4\u0bc1\u0baf\u0bc6"
