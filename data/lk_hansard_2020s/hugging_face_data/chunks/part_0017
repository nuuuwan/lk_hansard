    "chunk_text": "\u0dc0\u0dd2\u0d9c\u0dc1\u0dda\u0dc2\u0d9c\u0dba\u0dca\u0db8 \u0dc0\u0dd2\u0db8\u0dab\u0db1\u0dba \u0dc3\u0db1\u0dca\u0dca \u0dc0 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db0\u0daf\u0dd3, \u0d85\u0db7\u0dba\u0dca\u0dad\u0dbb\u0d9c\u0d86 \u0dc3\u0dd2\u0db0 \u0d9c\u0dc0\u0db1 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0db8\u0db4\u0db1 \u0db1\u0dd2\u0dc0\u0db4\u0dbb\u0daf\u0dd2 \u0dc3\u0db4\u0d9a\u0db4\u0dc3\u0dda\u0db8\u0dca \u0dc4\u0dca\u0d9a \u0db1\u0dd2\u0dc0\u0db4\u0dbb\u0daf\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dca \u0dbb\u0d9c\u0da7\u0dca \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0dbb \u0d9a\u0dca\u0dcf \u0d9c\u0daf\u0dca\u0db1 \u0dad\u0db8\u0dd4\u0dca\u0db1\u0dcf\u0dca\u0d9c\u0dc3\u0dda\u0d9a\u0dcf \u0db8\u0dad\u0d9a \u0dad\u0dd2\u0dba\u0dcf \u0db8\u0dca\u0db1. \u0dcf\u0d9a\u0dbb \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0d9a\u0dca\u0dcf \u0d9c\u0db1\u0dcf\u0daf\u0dd3 \u0dad\u0db8\u0dd4\u0dca\u0db1\u0dcf\u0dca\u0d9c\u0dc3\u0dda\u0d9a\u0dcf \u0db4\u0db1\u0d9a\u0dcf \u0dba\u0db1 \u0dc4\u0d9a \u0db8\u0db4\u0db1 \u0dc0\u0dd2\u0d9c\u0dc1\u0dda\u0dc2\u0d9c\u0dba\u0dca\u0db8 \u0dca\u200d\u0dbb\u0dc1\u0dda\u0db1\u0dba\u0dca \u0dad\u0dd2\u0d9c\u0dca\u0db1\u0dc0\u0dcf. \u0db8\u0db8 \u0d9c\u0db1 \u0d9c\u0dc0\u0d9a\u0dcf\u0d9c\u0dda \u0dcf\u0d9a\u0dad\u0dca \u0db8\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\n\n\u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0dcf \u0d9c\u0db1 \u0dc3\u0dad\u0dca\u0dad\u0dbb\u0dd3\u0dad\u0dbb \u0dcf\u0dca\u0dbd\u0dd2\u0db8\u0d9c\u0db1\u0dca\u0dad\u0dd4\u0d9c\u0dda \u0db8\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0dca\u0d9c\u0dda \u0dc0\u0dbb\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0daf \u0dc3\u0dbd\u0dca\u0d9a\u0d9c \u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0db1\u0dd2\u0dc3\u0dcf; \u0db8\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0dca\u0dbb \u0dcf \u0d85\u0dc0\u0dc3\u0dda\u0dae\u0dcf\u0dc0 \u0d9c\u0db1\u0dcf\u0d9c\u0daf\u0db1 \u0db1\u0dd2\u0dc3\u0dcf; \u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0db8 \u0d9c\u0db1\u0dcf\u0d9c\u0daf\u0db1 \u0db1\u0dd2\u0dc3\u0dcf. \u0d85\u0db4\u0dd2\u0dad\u0dca \u0da1\u0dca\u0daf\u0d9c\u0dba\u0dca \u0dad\u0dca \u0d9c\u0dc0\u0d9a\u0dcf \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0d9a\u0dcf \u0dad\u0dd2\u0d9c\u0dca\u0dca\u0d9c\u0dca. \u0da1\u0dca\u0daf\u0d9c\u0dba\u0dca \u0dad\u0dca \u0d9c\u0dc0\u0d9a\u0dcf \u0d86\u0db4\u0dd4 \u0db8\u0dca\u0dd3\u0dc0\u0dbb\u0dd4 \u0dc0\u0db1 \u0d85\u0db4\u0dd2 \u0dc0\u0db8 \u0d9a\u0dd2\u0dba\u0dca\u0d9c\u0dca \u0d85\u0d9c\u0dca \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0dbb. \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0dbb \u0dc0\u0db8 \u0d9a\u0dd2\u0dba\u0dca\u0db1 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0d9a\u0dcf \u0d89\u0dca\u0d9c\u0dca.\n\n\u0dc0\u0dd2\u0d9c\u0dc1\u0dda\u0dc2\u0d9c\u0dba\u0dca\u0db8 \u0dad\u0db8\u0dd4\u0dca\u0db1\u0dcf\u0dca\u0d9c\u0dc3\u0dda\u0d9a\u0dcf\u0dbb \u0db8\u0db8 \u0dc0\u0dd2\u0d9c\u0dc1\u0dda\u0dc2 \u0db8\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0dad\u0db8\u0dd4\u0dca\u0db1\u0dcf\u0dca\u0d9c\u0dc3\u0dda\u0d9a\u0dcf \u0dc3\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0daf\u0db4\u0dca \u0dcf \u0dc0\u0dcf\u0d9c\u0dda \u0dca\u200d\u0dbb\u0dc1\u0dda\u0db1\u0dba\u0dca \u0d86\u0dc0\u0dcf\u0dbb \u0dc3\u0dda\u0d9c\u0dc3\u0dda \u0d9c\u0db8\u0dcf\u0db1\u0dc0\u0dcf \u0d9c\u0dc4\u0ddd \u0dca\u200d\u0dbb\u0dc1\u0dda\u0db1\u0dba\u0dca \u0daf\u0dcf\u0d9a\u0dcf \u0dcf\u0dca\u0dbd\u0dd2\u0db8\u0d9c\u0db1\u0dca\u0dad\u0dd4\u0d9c\u0dda \u0dad\u0dd2\u0d9c\u0dca\u0db1 \u0dca\u200d\u0dbb\u0da2\u0dca\u200d\u0dcf\u0dad\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0daf\u0dba \u0dc3\u0db1\u0db4\u0dd6\u0dca\u0dab\u0d9c\u0dba\u0dca\u0db8 \u0db1\u0dad\u0dbb \u0d9a\u0dbb\u0dca\u0db1. \u0dc4\u0db4\u0dca\u0db4\u0dba\u0dd2, \u0dcf\u0d9a \u0d9a\u0dbb\u0dca\u0db1 \u0d9c\u0daf\u0dca\u0db1 \u0dca\u0db4\u0dc4\u0db4. \u0dcf\u0d9a \u0db8\u0dad\u0d9a \u0dad\u0dd2\u0dba\u0dcf \u0db8\u0dca\u0db1. \u0dc4\u0d9c\u0dc4\u0db8 \u0db1\u0db1 \u0dcf\u0dca\u0dbd\u0dd2\u0db8\u0d9c\u0db1\u0dca\u0dad\u0dd4\u0d9c\u0dda \u0dc0\u0dd2 \u0dca\u0dc2\u0d9c\u0d86 \u0d94\u0dca\u0d9c\u0d9a\u0ddd\u0db8 \u0d9c\u0daf\u0db1\u0dcf \u0d85\u0dba\u0dd2\u0dca \u0d9a\u0dbb\u0d9a\u0dcf \u0dad\u0db8\u0dd4\u0dca\u0db1\u0dcf\u0dca\u0d9c\u0dc3\u0dda\u0d9a\u0dcf \u0dcf\u0dca\u0dbd\u0dd2\u0db8\u0d9c\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0d9a\u0dbb\u0dca\u0db1. \u0dcf\u0d9a \u0d89\u0dbd\u0dca\u0d9a\u0db1 \u200d\u0dbb\u0db8\u0dba \u0dad\u0db8\u0dba\u0dd2 \u0d9c\u0db1."
