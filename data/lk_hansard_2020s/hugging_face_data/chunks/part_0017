    "chunk_text": "\u0daf\u0db1\u0db4\u0dca2\u0dbb\u0db1\u0da7\u0dca2\u0dcf\u0dc0 \u0dca 2\u0dcf\u0dbd\u0daf\u0d9c\u0dcf2\u0dba\u0dd4\u0dad\u0dd4\u0db82\u0dad\u0dbb\u0dc5 \u0d8b2\u0dd2\u0db1\u0dd2\u0db6\u0db3\u0dd42\u0da2 2\u0db1\u0dba\u0ddc\u0da7\u0dc3\u0dcf\u0d9a\u0dca \u0db82\u0daf\u0db1\u0dca \u0dc0\u0daf02\u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da72\u0d9a\u0dda2\u0dc3\u0dcf\u0dbb \u0daf\u0dca\u200d\u0daf\u0dbb2\u0daf\u0dc0\u0dba\u0dba\u0dba\u0dd202\u0daf\u0dd2\u0dc52\u0dcf\u0dbd\u0d9a\u0da72\u0dad\u0dca 2\u0dc0\u0dd4\u0dab\u0daf\u0da72\u0dad\u0dc3\u0dcf\u0dca\u0db1\u0dc3\u0dcf\u0d9c2\u0dd2\u0db1\u0dd2\u0db6\u0db3\u0dd4 2\u0da2 2\u0db1\u0dba\u0ddc\u0da7\u0dc3\u0dcf\u0dca\u0dc0\u0dbd\u0da72\u0daf\u0dc0\u0dba\u0dba2\u0dc3\u0dcf\u0dbb \u0daf\u0dca\u200d\u0daf\u0dbb2\u0dbd\u0dcf\u0daf2\u0daf\u0dd4\u0db1\u0dca \u0daf02\u0dc0\u0dd2\u0db1\u0dba\u0d9c\u0dc2\u0db1\u0d9a\u0db1\u0dca 2 \u0daf\u0db1\u0db4\u0dca2 \u0dbb\u0db1\u0da7\u0dca2 :\u0dc3\u0dcf\u0dbd\u0d9a\u0dca \u0db8\u0dc2\u0d9a\u0dba\u0da72 \u0d86\u0dc3\u0dcf\u0db1\u0dca 2 \u0dc0\u0dd0\u0da9\u0dd2\u0dc4\u0dd2\u0da7\u0dd2\u0d9a\u0db1\u0dca2\u0db4\u0dca\u200d\u0dbb \u0daf\u0dab\u0d9a\u0dba\u0da72 \u0d9a2 \u0db1\u0dc0 \u0db1\u0dba\u0ddc\u0da7\u0dca 2 \u0daf\u0dd3\u0dd4\u0dc02 \u0dd4\u0dc0\u0dd2\u0dc5\u0d9a\u0db12 3\u0d8b222\u0dba2 \u0daf\u0dd3 \u0daf\u0dc02 \u0daf\u0dd2\u0dc52\u0dd4\u0dc0\u0dd2\u0dc5\u0d9a\u0db12.\u0d8b2222:\u0d9a\u0dca \u0db8\u0dc0\u0daf2\u0dc0\u0dd0\u0da9\u0dd22\u0dba\u0dbb2\u0daf\u0dd4\u0db1\u0dca \u0daf02\u0d9a2\u0dc0\u0daf\u0db1 2\u0dcf \u0dba\u0dd22\u0daf\u0dc3\u0dcf\u0dca\u0dc0\u0dd0\u0dc3\u0dd4 2\u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0daf\u0dcf\u0d9a02\u0daf\u0dd2\u0dc52\u0d9a\u0dd2 \u0db1 \u0d8b2\u0daf\u0dc0 \u0d9a2\u0dd4\u0dc0\u0dd2\u0dc5\u0d9a\u0db1272\u0d8b222\u0d9a\u0dca \u0db82\u0db1: \u0dc0\u0daf2\u0d9a\u0dd2\u0d9a\u0dbd\u0daf02 \u0db8\u0dd4\u0dca \u0d8b2 \u0daf:2 \u0db1\u0dc0 \u0db1\u0dba\u0ddc\u0da72 \u0daf\u0dd2\u0dc52 \u0dba\u0daf\u0dca\u0da9\u0da92 \u0dc0\u0dba\u0db1\u0d9a\u0db1\u0d