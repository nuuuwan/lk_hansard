af\u0db1\u0dca\u0dba2 \u0daf\u0db1\u0dca\u0dca\u200d 2\u0daf\u0dd3 \u0daf\u0dc02\u0d91\u0d9a\u0dca \u0db82\u0d91\u0d9a\u0dca \u0db82\u0daf \u0daf\u0dcf2\u0dba\u0daf\u0dd2\u0d82\u0dba\u0d9a2\u0daf\u0db1\u0dd4\u0dc02\u0db1\u0dc0\u0db1\u0dca2\u0db1\u0dc0\u0db1\u0dca2\u0dc0\u0dba\u0db1\u0d9a\u0db1\u0dca2\u0dba\u0dc0\u0db1\u0dca\u0dad:;\n\n\u0d9a\u0db1\u0dca 2\u0d91\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0d9a2\u0db1 2\u0dc3\u0dcf\u0dcf\u0daf\u0dc0\u0da72:\u0db1\u0dca\u0dc0\u0db1\u0db1\u0dca2\u0db1\u0dca:?\n\n(\u0d86) \u0db1 \u0ddc\u0d91\u0db1\u0dc3\u0dcf\u0d9c2 \u0dda\u0d8b2\u0d9a2 \u0db1\u0dca:?22 \u0baa\u0bbf\u0bb0\u0ba4\u0bae \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bc1\u0bae\u0bcd \u0b95\u0bb2\u0bcd\u0bb5\u0bbf, \u0b89\u0baf\u0bb0\u0bcd \u0b95\u0bb2\u0bcd\u0bb5\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0ba4\u0bbe\u0bb4\u0bbf\u0bb1\u0bcd\u0b95\u0bb2\u0bcd\u0bb5\u0bbf \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bc1\u0bae\u0bbe\u0ba9\u0bb5\u0b95\u0bb0\u0b95\u0bcd \u0bb0\u0b95\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0ba9\u0bbe:\n\n(\u0b85) (i) \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0b95\u0bb5 \u0b85\u0ba8\u0bcd\u0ba4\u0bb8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b92\u0bb0\u0bc1\u0bb5\u0bbe\u0bbf\u0ba9\u0bcd \u0ba4\u0ba9\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0ba3\u0bbf\u0baf\u0bbe\u0b9f\u0bcd\u0ba4\u0b9f\u0bbe\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0b95 \u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0b95 \u0baf\u0bbe\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0b95\u0ba4\u0baf\u0bc1\u0bae\u0bcd;"
