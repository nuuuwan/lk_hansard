    "chunk_text": "\u0dbb\u0d9c\u0da7\u0dca\u0da7 \u0d85\u0dad\u0dd2\u0dba\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 - \u0db6\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0d9c\u0dda \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb \u0dcf - \u0da7\u0d9c\u0dad\u0dca\u0dad \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0da2\u0db1\u0d9c\u0dca \u0d9b\u0db1 \u0dc4\u0dcf \u0dc3\u0dcf\u0d9b\u0dba\u0dcf\u0d9c\u0dca \u0d9b\u0db1 \u0d9c\u0daf\u0db4\u0dcf\u0dca\u0dad\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0d9c\u0dc1 \u0daf\u0dad\u0dca\u0dad\u0dad\u0dc0\u0dbd\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0d9c\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0d9c\u0dda \u0d9c\u0daf\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0dcf\u0dca\u0dad\u0dd4\u0d9c\u0dc1 \u0d9a\u0dd2\u0dd2 \u0d9a\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad \u0dd2\u0db1 \u0da7 3.6\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0dc4\u0dad \u0dc0\u0dd0\u0da7\u0dd2\u0dbd\u0dcf. \u0d91\u0dc5\u0dc0\u0dbd\u0dd4 \u0dc0\u0dba\u0dcf\u0dc0 \u0dd2\u0db1 \u0da7 3.6\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0dc4\u0dad \u0dc0\u0dd0\u0da7\u0dd2\u0dbd\u0dcf. \u0daf\u0dd0\u0db1\u0dca \u0d87\u0dc4\u0dd4\u0dc0\u0dcf\u0db8 \u0db6\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf \u0d9a\u0dd2 \u0db1\u0dc0\u0dcf \u0d9c\u0db4\u0dcf\u0d9c\u0dc4\u0dcf\u0dbb\u0dad\u0dca\u0dad \u0d9c\u0daf\u0db1\u0dc0\u0dcf \u0d9a\u0dd2 \u0dbd\u0dcf. \u0d9c\u0dba\u0dcf\u0dc0\u0dd2 \u0dcf \u0dca\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dd2 \u0dbd\u0dcf\u0dad\u0dca\u0dad \u0d9a\u0dd2 \u0db1\u0dc0\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0db6\u0d9c\u0db6\u0dca\u0dbd\u0db8 \u0dca \u0dad\u0db1\u0dc0\u0dd2\u0db1\u0dca \u0d9c\u0daf\u0db1 \u0dc3\u0dcf\u0d9b\u0dba\u0dcf\u0d9c\u0dca \u0d9b\u0db1\u0dc0\u0dbd\u0da7\n\n\u0dad\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dd0\u0dad\u0dca\u0dad\u0dad\u0d9a\u0dd2\u0db1\u0dca \u0db0\u0dd3\u0dc0\u0dbb \u0d9a\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad \u0db4\u0dc4\u0dad \u0dc0\u0dd0\u0da7\u0dd2\u0dbd\u0dcf. \u0da2\u0db1\u0d9c\u0dca \u0d9b\u0db1 \u0dc4\u0dcf \u0dc3\u0dcf\u0d9b\u0dba\u0dcf\u0d9c\u0dca \u0d9b\u0db1 \u0d9c\u0daf\u0db4\u0dcf\u0dca\u0dad\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0d9c\u0dc1 \u0dc0\u0dcf\u0dca\u0dad\u0dcf\u0dc0\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0dd2\u0db1 \u0da7 34\u0d9a\u0dd2\u0db1\u0dca \u0db0\u0dd3\u0dc0\u0dbb \u0d9a\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad \u0db4\u0dc4\u0dad \u0dc0\u0dd0\u0da7\u0dd2\u0dbd\u0dcf.\n\n\u0dd2\u0db1 \u0da7 34\u0d9a\u0dd2\u0db1\u0dca! \u0dbb\u0da7 \u0dc0\u0d9c\u0da7\u0dca\u0da7\u0db8 \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0db8\u0dd4\u0dc4\u0dd4\u0daf \u0dba\u0dd0\u0db1 \u0d9a\u0dd2 \u0dbd\u0dcf\u0dba\u0dd2 \u0db6\u0dbd \u0da7 \u0dca\u0d9c\u0dc1. \u0dbb\u0da7 \u0dc0\u0d9c\u0da7\u0dca\u0da7\u0db8 \u0db8\u0dd4\u0dc4\u0dd4\u0daf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dc1\u0dc0\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0db8\u0db8 \u0d9c\u0da0\u0ddd\u0daf\u0db1\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0d9c\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d9c\u0db8\u0dcf\u0d9a\u0daf \u0dbd\u0dd4\u0db1\u0dd4 \u0da7\u0dd2\u0d9a \u0db8\u0dd4\u0daf\u0dc0\u0dcf \u0dba\u0db1\u0dca\u0db1\u0dad\u0dca\u0dad \u0db6\u0dd0\u0dc4\u0dd0 \u0d9c\u0db1\u0dca \u0db6\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0da7. \u0dbb\u0da7 \u0dc0\u0d9c\u0da7\u0dca\u0da7\u0db8 \u0db8\u0dd4\u0dc4\u0dd4\u0daf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2 \u0dbd\u0dcf \u0db6\u0dbd \u0da7 \u0dca\u0db4\u0dd4 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0d9c\u0dc3\u0dae\u0dbd\u0dcf\u0d9c\u0dda \u0da2\u0db1\u0d9c\u0dca \u0d9b\u0db1 \u0dc4\u0dcf \u0dc3\u0dcf\u0d9b\u0dba\u0dcf\u0d9c\u0dca \u0d9b\u0db1 \u0d9c\u0daf\u0db4\u0dcf\u0dca\u0dad\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0d9c\u0dc1 \u0dc0\u0dcf\u0dca\u0dad\u0dcf\u0dc0\u0dbd\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0db0\u0dd3\u0dc0\u0dbb \u0d9a\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad \u0d9c\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0d9c\u0dda \u0d9c\u0daf\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0dcf\u0dca\u0dad\u0dd4\u0d9c\u0dc1 \u0dd2\u0db1 \u0da7 34\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da7\u0dd2\u0dbd\u0dcf. \u0db0\u0dd3\u0dc0\u0dbb \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0dbb \u0dcf \u0dcf\u0db4\u0db1\u0d9c \u0d9c\u0db1\u0dca\u0daf? \u0dcf\u0db4\u0db1\u0d9c \u0d89\u0db1\u0dca\u0d9c\u0db1\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0dbb \u0dcf. \u0d9c\u0dad\u0dca \u0db8\u0dd2\u0dbd \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0d9c\u0db6\u0dcf\u0d9c\u0dc4\u0dcf\u0db8 \u0d9a\u0dca \u0d9c\u0db8\u0dca \u0dba\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0da7 \u0db6\u0dbd\u0db4\u0dcf\u0db1\u0dc0\u0dcf. \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0d9c\u0db8\u0dca \u0dba\u0dd0\u0db1 \u0d85\u0dc0\u0db0\u0dcf\u0db1 \u0d9c \u0dcf\u0db8\u0dd4 \u0d9a\u0d9c\u0dc5\u0dae \u0db1\u0dd0\u0dad\u0dca\u0dad\u0db1\u0db8\u0dca \u0db0\u0dd3\u0dc0\u0dbb \u0d9a\u0dca\u0d9c\u0dc2\u0dae\u0dbb \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca\u0dad \u0dc0\u0dd0\u0d9c\u0da7\u0db1\u0dc0\u0dcf. \u0db8\u0dcf\u0dc5\u0dd4 \u0db4\u0dd2\u0da7\u0dad\u0dd2\u0db1\u0dca \u0d9c\u0dba\u0db1\u0dd0\u0dca \u0dbd\u0dcf \u0d9a\u0db1\u0dca\u0db1 \u0d9c\u0daf\u0db1\u0dca\u0db1 \u0d9c\u0dc0\u0db1\u0dc0\u0dcf. \u0db8\u0dd4\u0dc4\u0dd4\u0daf \u0daf\u0dd2\u0dc4\u0dcf \u0db6\u0dbd\u0dcf\u0d9c\u0dba\u0db1 \u0db8\u0dcf\u0dc5\u0dd4 \u0db4\u0dd2\u0da7\u0dad\u0dd2\u0db1\u0dca \u0d9c\u0dba\u0db1\u0dd0\u0dad\u0dca\u0dad \u0d9a\u0db1\u0dca\u0db1 \u0d9c\u0dc0\u0db1\u0dc0\u0dcf. \u0d92 \u0dad\u0dd0\u0db1\u0da7 \u0d9c\u0db8\u0dca \u0dbb\u0d9c\u0da7\u0dca\u0da7 \u0dca\u0dca\u0dd2\u0d9a \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0d9c\u0dc3\u0dae\u0dbd\u0dcf \u0db4\u0dad\u0dca\u0dad \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d9c\u0db8\u0dca\u0dc0\u0dcf\u0dba\u0dd2 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0daf\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0db6\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf \u0dbd\u0db6\u0db4\u0dd4 \u0da2 \u0dbb\u0dd9\u0dc4\u0dab.\n\n\u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8\u0dba\u0dd2 \u0dbb\u0db6\u0dca \u0d9a\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad . \u0d91 \u0dd2\u0db1 \u0da7 10.7\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da7\u0dd2\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d9c\u0db8 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0d9c\u0dc3\u0dae\u0dbd\u0dcf\u0d9c\u0dda\u0db8 \u0dba\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0d9c\u0dda \u0da2\u0db1\u0d9c\u0dca \u0d9b\u0db1 \u0dc4\u0dcf \u0dc3\u0dcf\u0d9b\u0dba\u0dcf\u0d9c\u0dca \u0d9b\u0db1 \u0d9c\u0daf\u0db4\u0dcf\u0dca\u0dad\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dbd\u0db6\u0dcf \u0d9c\u0daf\u0db1 \u0dc0\u0dcf\u0dca\u0dad\u0dcf\u0dc0\u0dbd\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0d9c\u0db8\u0dca \u0dbb\u0d9c\u0da7\u0dca\u0da7 \u0d9c\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0d9c\u0dda \u0d9c\u0daf\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0dcf\u0dca\u0dad\u0dd4\u0d9c\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dbd; \u0db6\u0d9c\u0db6\u0dca\u0dbd \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0d9c\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dbd."
  },
