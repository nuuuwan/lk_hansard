    "chunk_text": "\u0db8\u0dd4\u0dad\u0dca \u0daf\u0daf\u0dd0\u0db1\u0dca\u0daf\u0dc0\u0dd3\u0daf\u0d9a\u0dd2\u0d9a\u0dbd\u0ddd\u0dc0\u0dcf \u0daf\u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca\u0daf150\u0d9a\u0dca\u0daf\u0d89\u0dbd\u0dca\u0dbd \u0dc0\u0dcf\u0dc3\u0daf\u0dbb\u0dad\u0dca\u0d9a\u0dcf\u0dca \u0daf\u0dc1\u0dcf\u0dbb\u0dd2\u0d9a \u0ddd\u0d9c\u0dd2\u0dcf\u0db4\u0dcf\u0daf\u0d9a\u0dcf\u0dca\u0d9a\u0dc4\u0dca\u0db8\u0daf\u0daf \u0db1\u0dca\u0d9a\u0db1\u0dca \u0daf\u0d92\u0daf\u0db1\u0dd2:\u0dcf\u0daf\u0d85\u0db4\u0dd2\u0daf\u0d9a \u0daf\u0dc3\u0d9a\u0da8\u0dcf\u0daf\u0d9a \u0dca\u0dd2\u0dc1\u0db4\u0dcf\u0daf\u0dc3\u0d9a\u0dd2\u0db1\u0dca \u0daf\u0dc0\u0dd3\u0dc0\u0dbd \u0daf\u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca\u0daf120\u0dcf\u0daf\u0db8\u0dd2\u0dbd\u0d9a\u0dca\u0daf\u0dbd\u0dca\u0db1\u0dca \u0dcf\u0dc3\u0daf\u0dc1\u0dcf\u0dbb\u0dd2\u0d9a \u0ddd\u0d9c\u0dd2\u0dcf\u0db4\u0dcf\u0daf\u0dc3\u0d9a\u0dd2\u0db1\u0dca \u0daf:\u0dc4\u0dbd\u0dca\u0dc0\u0dbd \u0daf\u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca\u0daf230\u0dcf\u0daf\u0db8\u0dd2\u0dbd\u0d9a\u0dca\u0daf\u0daf\u0dd0 \u0db8\u0dcf\u0dc3\u0daf\u0dc0\u0dd3\u0daf\u0d85\u0d9a\u0dbd\u0dd2\u0dc1\u0daf\u0db8\u0dab\u0dca\u0da9\u0dbd\u0db4\u0dad\u0dca \u0daf:\u0d9a\u0dad\u0dca\u0dca:\u0dad\u0dca\u0daf\u0dbb\u0dcf \u0daf\u0dbb\u0dcf\u0dad\u0dd4\u0daf\u0d9a\u0dc0\u0dbd\u0dcf\u0daf\u0d92\u0daf\u0d9a\u0daf\u0dcf\u0db8\u0daf\u0dcf\u0dc5\u0db8 \u0dcf\u0dcf\u0dc3\u0dab\u0db4\u0daf\u0dcf\u0dc3\u0db1\u0dca \u0daf\u0dc0\u0dd0\u0da9\u0daf\u0dcf\u0dc3\u0dbd\u0dcf\u0daf\u0dad\u0dd2\u0d9a\u0db6 \u0dc0\u0dcf \u0daf\u0dc1\u0dcf\u0dbb\u0dd2\u0d9a \u0ddd\u0d9c\u0dd2\u0dcf\u0db4\u0dcf \u0daf\u0d85\u0da9\u0dd4\u0dc0\u0d9a\u0dca\u0daf \u0dd0\u0dad\u0dd4\u0dc0\u0daf:\u0dc4\u0dbd\u0dca\u0daf\u0da7\u0dd2\u0dcf\u0daf\u0d9a\u0dc0\u0d9a\u0dc5\u0db3\u0daf\u0daf\u0d9a\u0dc1\u0dca\u0dc5 \u0daf\u0d9a\u0daf\u0db1\u0dca \u0dc3\u0daf\n\n\u0d9a\u0dd2\u0db4\u0db1\u0dca \u0daf\u0dc4\u0daf \u0dc0\u0dcf\u0dc3\u0daf\u0d9a\u0db6\u0dca\u0dbb\u0dd4\u0dc0\u0daf\u