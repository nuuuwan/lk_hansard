a9 - \u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d87 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0dd2.\u0db8\u0dd2. 2.8 \u0d9a\u0dd2\u0dbb\u0dbd\u0d9a\u0dd0\u0d9c\u0dca - \u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d87 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0dd2.\u0db8\u0dd2. 47.2 \u0d9c\u0dd9\u0dbb\u0dd2\u0dba\u0d9c\u0dbd - \u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d87 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0dd2.\u0db8\u0dd2. 2.4 \u0dbb\u0dd2\u0dba\u0dbd\u0d9c\u0dbd\u0dcf - \u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d87 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0dd2.\u0db8\u0dd2. 3.2 \u0dc4\u0db8\u0dbb\u0d9c\u0d9c\u0dcf\u0da9 - \u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d87 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0dd2.\u0db8\u0dd2. 4 - \u0d9c\u0db6\u0daf\u0dd4\u0dda \u0d87 \u0d9a\u0dd2.\u0db8\u0dd2. 2.1\n\n\u0d85\u0dbd\u0dc0\u0dad\u0dd4\u0d9c\u0d9c\u0dcf\u0da9 - \u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d87 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0dd2.\u0db8\u0dd2. 3.2 - \u0d9c\u0db6\u0daf\u0dd4\u0dda \u0d87 \u0d9a\u0dd2.\u0db8\u0dd2. 3.2\n\n(\u0d87 \u0d89\u0dc4\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0dd9\u0dcf \u0d9c\u0db1\u0dcf\u0d9c .\n\n1425 1426\n\n[\u0d9c\u0dbb\u0dd4 \u0dc3\u0dd4\u0dc3\u0dd2\u0dca \u0dbb\u0dab\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dcf]\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 * \u0db4\u0dd4\u0dc3\u0db1\u0dad\u0d9a\u0dcf\u0dbd\u0dca \u0dad\u0db6\u0dcf \u0d87\u0dad. * \u0ba8\u0bc2\u0ba9\u0bbf\u0bae\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bae\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. * Placed in the Library.\n\n2025 \u0d94\u0d9a\u0dca\u0d9c\u0dad\u0ddd\u0db6\u0dbb\u0dca 07\n\n\u0d9c\u0dbb\u0dd4 \u0d85\u0da2\u0db1\u0dca\u0dad \u0d9c\u0db8\u0dca\u0dd9\u0dd0\u0daf\u0dca\u0dca\u0daf\u0dca\u0dda \u0dd9\u0dc4\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b85\u0b9c\u0ba8\u0bcd\u0ba4 \u0b95\u0bae\u0bcd\u0ba4\u0bc8\u0ba4\u0bcd\u0ba4\u0ba4\u0bb0\u0b95) (The Hon. Ajantha Gammeddage) \u0d9c\u0dbb\u0dd4 \u0d9a \u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0db8\u0db8 \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0d9c\u0d9c\u0db1\u0dca \u0d85\u0dc4\u0db1 \u0db4 \u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0dca\u200d\u0dbb\u0dba\u0dae\u0db1\u0dba \u0d9c\u0db8\u0dba\u0dd2. \u0db1\u0dd2\u0dca \u0dc0\u0dbd\u0dcf \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dbd\u0dd9 \u0d89\u0da9\u0dda \u0d9c\u0dd0\u0db1 \u0dc0\u0dd2\u0d9c\u0dba\u0dae\u0dc2\u0d9c\u0dba\u0db1\u0dca\u0db8 \u0db4\u0dad\u0dca \u0d89\u0dbb\u0dd4\u0dc0\u0dbd \u0dc3\u0da7\u0dc4\u0db1\u0dca \u0d9c\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd2\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0dca\u200d\u0dbb\u0d9c \u0dba\u0d9c\u0d86 \u0db8\u0dd4\u0dca \u0d85\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d92 \u0d89\u0da9\u0dda \u0db1\u0dd0\u0dc0\u0dad \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0db1\u0dd0\u0dc0\u0dad \u0dc0\u0dd2\u0d9a\u0dd2\u0dab\u0dd4\u0dc0\u0dcf\u0da7 \u0db4\u0dc3\u0dae\u0d9c\u0dc3\u0dae \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0d85\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 22\u0d9a\u0dca, 30\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0dae\u0d9c\u0dc3\u0dae \u0d9c\u0dc0\u0db1\u0dad\u0dca \u0d85\u0dba \u0dad\u0db8\u0dd2 \u0d92 \u0d89\u0da9\u0dda \u0db4\u0dcf\u0dc0\u0dd2\u0da0\u0da0\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0d9c\u0db1\u0dca. \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d9c\u0d9c\u0dc0\u0dca \u0d9c\u0dd9\u0dcf\u0dbb\u0dc0\u0dca \u0dc4\u0dd9\u0dcf\u0d9c\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0dd9\u0dd0\u0db1\u0da7 \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0dca\u200d\u0dbb\u0dba\u0dae\u0db1\u0dba \u0d9c\u0dda\u0d9a\u0dd2. \u0dc0\u0dcf\u0db4\u0dad\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd9\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0d9c\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0d92 \u0d85\u0dba\u0da7 \u0d92 \u0d89\u0da9\u0dda\u0dc0\u0dd2\u0db1\u0dca \u0d89\u0dc0\u0dad\u0dca \u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d9a\u0dcf\u0dbd\u0dcf\u0db1\u0dca\u0dad\u0dbb\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0dae\u0d9c\u0dc3\u0dae \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d92 \u0d89\u0da9\u0dda \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0db4\u0dd2\u0db4\u0dad\u0dc3\u0da7 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0d89\u0dc2\u0dae\u0da7 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0dd9 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dd2 \u0db8\u0dcf \u0d85\u0dc4\u0db1\u0dca\u0d9c\u0db1\u0dca, \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2."
