    "chunk_text": "\u0dba\u0dda \u0dad\u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0dba\u0dad\u0dca \u0da2\u0dc1\u0dad\u0dd2\u0dc3\u0d9a \u0da2\u0db1 \u0db6\u0dbd\u0dba\u0dda \u0dbb\u0da2 \u0db7\u0d9c\u0da0\u0dc1\u0dbb\u0d9a \u0d9a\u0dca\u0dba\u0dc2\u0dc0\u0dad\u0dca\u200d\u0dbb \u0dba\u0dda \u0db1\u0dc0 \u0dd4 \u0db1\u0dbb\u0dca\u0dbd\u0da2\u0dd3\u0dc0\u0db1 \u0d9a\u0dca \u0d87\u0dad\u0dd2\u0dc3 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db7\u0db3\u0dc4\u0dc1 \u0db7\u0dd0\u0dbd\u0dc3\u0dd4\u0dda \u0db7\u0d9a\u0db7\u0dc0 \u0d9a\u0dc5\u0dc1. \u0db7\u0dd0\u0dbd\u0dc3\u0dd4\u0dda \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0dc1\u0dba\u0db4\u0dc1\u0dba\u0dbb\u0dc1\u0dad\u0dca\u0dad\u0dd4 \u0dd4\u0dab\u0dab\u0dc1, \u0dba\u0dda \u0dc0\u0db7\u0dba\u0dbb\u0dca\u0dbd\u0daf\u0dd3 \u0dbd\u0d9a\u0dca\u0dc2 25\u0d9a, \u0dbd\u0d9a\u0dca\u0dc2 30\u0d9a \u0db7\u0d9c\u0da0\u0dc1\u0dbb\u0d9a \u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dab \u0d9a\u0dca \u0d85\u0dba\u0db4\u0dca \u0dbb \u0d9a\u0dd0\u0db3\u0dc0\u0dc1 \u0dba \u0db1 \u0dbb\u0db1\u0dca\u0db1 . 2030 \u0dc0\u0db7\u0dbb \u0dc0\u0db1\u0dba\u0d9a\u0dc1 \u0db8\u0dd2\u0dbd\u0dd2 \u0db1 4\u0d9a \u0db7\u0d9c\u0da0\u0dc1\u0dbb\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dab \u0d9a\u0dca \u0d85\u0dba\u0db4\u0dca \u0dbb \u0d9a\u0dd0\u0db3\u0dc0\u0dc1\u0dba \u0db1 \u0d87\u0dd2\u0dc1\u0dbd\u0dca\u0dbd\u0dbd\u0dc1, \u0d94\u0db7\u0dc0\u0dba\u0db7\u0dc0 \u0d85\u0dba\u0db4\u0dca \u0dbb\u0dba\u0da7\u0dca\u0da7 \u0d86\u0dbb\u0dca\u0dbd\u0dae\u0dd2\u0d9a\u0d9a \u0dd2\u0dc1\u0db1\u0dc1\u0dbd \u0dd9\u0dc1 \u0d9a\u0dad\u0dca\u0dc0 \u0d9a\u0dca \u0dbd\u0db6\u0dc1 \u0daf\u0dd3\u0db8 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d85\u0dba\u0db4\u0dca \u0d85\u0dbb\u0db8\u0dd4\u0dab \u0dba\u0dc0\u0db1\u0dca\u0dba\u0db1\u0dca. \u0dba\u0dda \u0d94\u0db7\u0dc0\u0dba\u0db7\u0dc0 \u0d85\u0db4\u0dd2 \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0dba \u0db1 \u0db1\u0dba\u0d9a\u0dc1 \u0dd2\u0dc1\u0db4\u0d9a\u0dca\u0dc2 \u0dba\u0dda \u0d87\u0dad\u0dca\u200d\u0dd0\u0dda \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0d85\u0dd9\u0dc4\u0db7\u0dc0 \u0dd9\u0d9a\u0dca\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0d9a\u0dd2\u0dda\u0dc0\u0dc1, \u0d86\u0dbb\u0dca\u0dbd\u0dae\u0dd2\u0d9a\u0d9a \u0dd2\u0dbd\u0db3 \u0dc0\u0da7\u0dca\u0da7 \u0dd4 \u0dbb\u0d9a \u0dd0\u0db1 \u0d85\u0db4 \u0d9a\u0dae\u0dc1 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dbb\u0db4\u0dc1 \u0d9a\u0dd2 \u0dbd\u0dc1. \u0dbb\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dc1 \u0d9a\u0dd2\u0dda\u0dc0\u0dc1, \u0dba\u0dda \u0d86\u0dbb\u0dca\u0dbd\u0dae\u0dd2\u0d9a\u0d9a \u0dd2\u0dbd\u0db3 \u0dc0\u0dd0\u0da7\u0dd4\u0dab\u0dc1 \u0d9a\u0dd2 \u0dbd\u0dc1.\n\n\u0dba\u0dda\u0dba \u0dc1\u0dbd\u0dca\u0dbd\u0dbd\u0db1\u0dca \u0dad\u0dca\u200d\u0da7\u0dca\u0da7\u0da7\u0dd4 \u0db8\u0dc1\u0dbb\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dba\u0daf\u0dca\u0db1\u0db4\u0dc1\u0dbd\u0db1 \u0d9a\u0dbb\u0dbd\u0dc1, 2015\u0daf\u0dd3 \u0dba\u0dda \u0dba\u0dd9\u0dba \u0dc1\u0dbd\u0dca\u0dbd\u0dbd\u0db1\u0dca\u0db8 \u0dbb\u0d9a\u0dad\u0dd4 \u0dba\u0dc0\u0dbd\u0dc1 \u0d86 \u0da9\u0dd4\u0dc0\u0d9a\u0dca \u0db4\u0dd2\u0dd2 \u0dba \u0dda\u0dc0\u0dc1. \u0dba\u0dd9\u0dba \u0dc1\u0dbd\u0dca\u0dbd\u0dbd\u0db1\u0dca\u0db8 \u0dbb\u0d9a\u0dad\u0dd4 \u0dba\u0dc0\u0dbd\u0dc1 \u0db4\u0dd2\u0dd2 \u0dc0\u0dd4 \u0d86 \u0da9\u0dd4\u0dba\u0dc0\u0db1\u0dca \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2, \u0d87\u0dba\u0db8\u0dbb\u0dd2\u0d9a\u0dc1\u0db1\u0dd4 \u0dbb\u0d9a\u0dca\u0db7\u0dad\u0dca \u0da2\u0db1\u0db4\u0dd9 \u0dba\u0da9\u0dc1\u0dbd\u0dbb\u0dca\u0dbd \u0dd2\u0dbd\u0dbd\u0dd2 \u0db1 12.5\u0d9a ISBs \u0dad\u0dca\u0dba\u0dad\u0dca. 2007\u0daf\u0dd3 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d85\u0dba\u0db4\u0dca \u0dbb ISBs \u0db1\u0dca\u0db1 \u0db4 \u0db1\u0dca \u0dad\u0dca\u0dba\u0dad\u0dca. \u0d85\u0db4\u0dd2 \u0db7\u0dda\u0db4\u0dd6\u0dbb\u0dca\u0dbd\u0dab\u0dba \u0db1\u0dca\u0db8 \u0d85\u0dbb\u0dba \u0db1 \u0dad\u0dd2\u0dc3\u0dba\u0db6\u0db1\u0dca\u0dba\u0db1\u0dca \u0dba\u0da9\u0dc1\u0dbd\u0dbb\u0dca\u0dbd \u0dd2\u0dbd\u0dbd\u0dd2 \u0db1 15\u0dba\u0dd2. \u0dba\u0da9\u0dc1\u0dbd\u0dbb\u0dca\u0dbd \u0dd2\u0dbd\u0dbd\u0dd2 \u0db1 15\u0db1\u0dca \u0dba\u0da9\u0dc1\u0dbd\u0dbb\u0dca\u0dbd \u0dd2\u0dbd\u0dbd\u0dd2 \u0db1 12.5\u0d9a\u0dca \u0dad\u0dca\u0dba\u0dad\u0dca \u0dba\u0dda\u0dba \u0dc1\u0dbd\u0dca\u0dbd\u0dbd\u0db1\u0dca. \u0dbb\u0dad\u0dca\u200d\u0dd0\u0db1\u0dd2\u0db1\u0dca \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d85\u0dbb\u0dca\u0dbd\u0db6\u0dd4\u0dd9 \u0db4\u0dad\u0dca\u0db7\u0db1\u0dca\u0db1 \u0dd4\u0dab\u0dba . \u0dba\u0dda \u0dab \u0dba \u0dc0\u0dc1 \u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0dd4\u0dab\u0dab\u0dd4 \u0dbb \u0dba\u0d9a\u0dca \u0dbb\u0d9a \u0db4\u0dca\u200d\u0dbb\u0db0\u0dca\u200d\u0dc1\u0db1\u0db8 \u0db7\u0db1\u0dca\u0db0\u0dd2\u0db7\u0dc0\u0dae\u0dc1\u0db1 \u0d9a\u0dca \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d9a. \u0dbb\u0dba\u0dc4\u0db8 \u0dab \u0d85\u0dbb\u0dba \u0db1 \u0d86\u0dbb\u0dca\u0dbd\u0dae\u0dd2\u0d9a\u0d9a \u0dc4\u0dd0\u0daf\u0dd4\u0dc0\u0dc1\u0dd9? 2015\u0daf\u0dd3 \u0d86\u0dbb\u0dca\u0dbd\u0dae\u0dd2\u0d9a\u0d9a \u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0dca\u200d\u0db1 \u0dc3\u0dd2 5 \u0dad\u0dd2\u0dc3\u0db6\u0dd4\u0dab\u0dc1. 2019 \u0dc0\u0db1\u0dba\u0d9a\u0dc1 \u0d86\u0dbb\u0dca\u0dbd\u0dae\u0dd2\u0d9a\u0d9a \u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0dca\u200d\u0db1 \u0d8d\u0dab \u0d85 \u0d9a\u0dca \u0dad\u0dca\u0dad\u0dca\u200d\u0dc1. \u0dab \u0d85\u0dbb\u0dba \u0db1 \u0d86\u0dbb\u0dca\u0dbd\u0dae\u0dd2\u0d9a\u0d9a \u0dc4\u0dd9\u0db1\u0dca\u0db1\u0dad\u0dca \u0db6\u0dd0\u0dbb\u0dd2 \u0dd4\u0dab\u0dab\u0dc1. \u0dbb\u0dba\u0dc4\u0db8 \u0d9a\u0dbb\u0dbd\u0dc1 \u0d85\u0dd9 \u0d9a\u0dd2 \u0db1\u0dc0\u0dc1, \u0d86\u0dbb\u0dca\u0dbd\u0dae\u0dd2\u0d9a\u0d9a \u0dc0\u0dd0\u0da7\u0dca\u0da7\u0da7\u0dd4\u0dba\u0dda \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2 \u0dbd\u0dc1. \u0d86\u0dbb\u0dca\u0dbd\u0dae\u0dd2\u0d9a\u0d9a \u0dba\u0dda \u0dad\u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0dd2\u0dbd\u0db3 \u0dc0\u0dd0\u0da7\u0dca\u0da7 \u0dc0\u0dd3\u0db8 \u0dc0 \u0d9a\u0dd2\u0dc0 \u0dba\u0dd4\u0dad\u0dd4 \u0d85 \u0d85\u0dd9 \u0db1\u0dd2\u0d9a\u0dda \u0dc3\u0dd4\u0dd9\u0dba\u0db1\u0ddd \u0dba \u0dc1\u0dba \u0dba\u0dc0\u0dbd\u0dc1 \u0da2\u0dc1\u0dad\u0dd2\u0dc3\u0d9a \u0da2\u0db1 \u0db6\u0dbd\u0dba\u0dda \u0db4\u0dd0\u0dad\u0dca\u0dad\u0dca\u200d \u0dba\u0dda \u0dd2\u0dc1\u0db0\u0dd2 \u0d87\u0d9f\u0dd2\u0dbd\u0dca\u0dbd\u0dbd \u0dd2\u0db1\u0d9c\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0, \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dd2\u0dc1\u0dba\u0dda\u0da0\u0db1 \u0d89\u0dd2\u0db1\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d85\u0db4\u0dd2 \u0d9a\u0db1 \u0dc1\u0da7\u0dd4 \u0dba\u0dc0\u0db1\u0dc0\u0dc1, \u0db8\u0dd6\u0dbd\u0dc1\u0db7\u0db1\u0dc1\u0dbb\u0dd6\u0daa \u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2.\n\n\u0d85\u0dba\u0db4\u0dca \u0da2\u0dc1\u0dad\u0dd2\u0dc3\u0d9a \u0da2\u0db1 \u0db6\u0dbd\u0dba\u0dda \u0dbb\u0da2\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0db0\u0dca\u200d\u0dc1\u0db1\u0dad\u0dca\u200d\u0db8 \u0d9a\u0dc1\u0dbb\u0dca\u0dbd \u0d82\u0dc1\u0dbb \u0dd4\u0dab\u0dba \u0d86\u0dbb\u0dca\u0dbd\u0dae\u0dd2\u0d9a\u0d9a \u0db7\u0dc0\u0dae\u0dc1\u0dc0\u0dbb \u0d9a\u0dbb \u0dd0\u0db1\u0dd3\u0db8. \u0db7\u0db3\u0dc4\u0dc1 \u0dba\u0dda \u0dc0\u0db1 \u0dd2\u0dc1 \u0da2\u0dc1\u0dad\u0dd2\u0dc3\u0d9a \u0da2\u0db1 \u0db6\u0dbd\u0dba\u0dda \u0d86 \u0da9\u0dd4\u0dc0 \u0dd2\u0dc1\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd6 \u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0db8\u0dc1\u0dbb\u0dca\u0dbd \u0d94\u0db7\u0dc0\u0dba\u0db7\u0dc0 \u0dda\n\n1217 1218\n\n\u0db4\u0dc1\u0dbb\u0dca\u0dbd\u0dbd\u0dd2\u0dba\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0"
