    "chunk_text": "\u0dad\u0dd2\u0db6\u0dd2\u0dba\u0daf\u0dd3 \u0dbb\u0da7 \u0db7\u0dcf\u0dbb\u0d9c\u0dad\u0dca \u0dc0\u0dad\u0dca\u0db8\u0db1\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0d91\u0dba \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dd2\u0dad \u0db8\u0dcf\u0dc0\u0dad\u0d9a\u0da7 \u0dc4\u0dbb\u0dc0\u0dcf\u0dc0\u0dd2 \u0dba\u0dd0\u0dd2 \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0db6\u0dbd\u0dcf\u0d9c\u0db4\u0dcf\u0d9c\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0dd4\u0dab\u0dcf. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0db1\u0dc0 \u0dbb\u0da2\u0dba\u0da7 \u0dc0\u0dc3\u0dbb\u0d9a\u0dca \u0d89\u0d9a\u0dca\u0db8 \u0d9c\u0d9c\u0dcf\u0dc3\u0dae \u0d87\u0dad\u0dd2 \u0d9c\u0dda \u0d85\u0dc0\u0dc3\u0dae \u0dcf\u0d9c \u0dbb\u0d9c\u0da7\u0dca \u0d89\u0dbb\u0dd2\u0db4\u0dad \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dd2\u0dad \u0d89\u0dbd\u0d9a\u0dca\u0d9a \u0dc4\u0dcf \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0d9c\u0d86 \u0dc3\u0dd6\u0dd9\u0dcf\u0db1\u0db8 \u0dd9\u0dd0\u0db1\u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0db8 \u0d9c\u0dda \u0dca\u200d\u0dbb\u0dba\u0dae\u0db1 \u0d89\u0dbb\u0dd2\u0db4\u0dad\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\n\n\u0db8\u0db8 \u0d9c\u0dda \u0dca\u200d\u0dbb\u0dba\u0dae\u0db1\u0dba \u0dc0\u0dd2\u0d9c\u0dba\u0dae\u0dc2\u0d9c\u0dba\u0db1\u0dca\u0db8 \u0d85\u0dc4\u0db1\u0dca\u0d9c\u0db1\u0dca, 2028 \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0d9c\u0da9\u0dcf\u0dbd\u0dbb\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 12\u0d9a \u0dc3\u0d82\u0da0\u0dd2\u0dad \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dca \u0dc3\u0db4\u0dd4\u0dbb\u0dcf\u0dbd\u0db1\u0dca\u0db1\u0da7 \u0dbb\u0da2\u0dba \u0dc3\u0dd0\u0dbd\u0dc3\u0dd4\u0dda \u0d9a\u0dbb \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0db1\u0dd2\u0dc3\u0dcf\u0dd2.\n\n2. \u0d9c\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0dbb\u0d9c\u0da7\u0dca \u0dc3\u0db8\u0dc3\u0dae\u0dad \u0dab\u0dba \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0d9c\u0d9a\u0dcf\u0db4\u0db8\u0dab\u0dd9? \u0d91\u0db8 \u0dab\u0dba \u0dad\u0dd4 \u0d9c \u0dc1\u0dd3\u0dba \u0dab\u0dba \u0dc3\u0dc4 \u0dc0\u0dd2\u0d9c \u0dc1\u0dd3\u0dba \u0dab\u0dba \u0d9c\u0d9a\u0dcf\u0db4\u0db8\u0dab\u0dd9 \u0dba\u0db1\u0dca\u0db1 \u0d9c\u0dc0\u0db1\u0dca \u0d9c\u0dc0\u0db1\u0dca\u0dc0 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a \u0dc4\u0dd0\u0d9a\u0dd2\u0dd9? \u0d91\u0dd2\u0db1\u0dca \u0dc0\u0dad\u0dca\u0db8\u0db1\u0dca \u0dbb\u0da2\u0dba \u0db6\u0dbd\u0dba\u0da7 \u0db4\u0dad\u0dca\u0dd3\u0d9c\u0db8\u0db1\u0dca \u0db4\u0dc3\u0dd4 \u0dbd\u0db6\u0dcf \u0d9c\u0d9c\u0db1 \u0d87\u0dad\u0dd2 \u0dab\u0dba \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab 6\u0d9c \u0dc1\u0dd3\u0dba \u0dc4\u0dcf \u0dc0\u0dd2\u0d9c \u0dc1\u0dd3\u0dba \u0d9a\u0dc0\u0d9c\u0dbb\u0dca\u0dd9? \u0dc0\u0dd2\u0d9c \u0dba \u0dab\u0dba \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0\u0d9c\u0dba\u0db1\u0dca \u0d9c\u0dad\u0dca \u0d9a \u0d91\u0dba \u0dd3\u0db4\u0dcf\u0dbb\u0dca\u0dba\u0dae\u0dd3\u0dba, \u0db6\u0dc4\u0dd4\u0db4\u0dcf\u0dbb\u0dca\u0dba\u0dae\u0dd3\u0dba \u0dc3\u0dc4 \u0dc3\u0dae\u0dc0\u0dc0\u0dbb\u0dd3 \u0db6\u0dd0\u0db3\u0dd4\u0dda\u0d9a\u0dbb \u0d9c\u0dbd\u0dc3 \u0d9c\u0dc0\u0db1\u0dca \u0d9c\u0dc0\u0db1\u0dca \u0dc0\u0dba\u0d9c\u0dba\u0db1\u0dca \u0d9c\u0dad\u0dcf\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0d89\u0dbb\u0dd2\u0db4\u0dad\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0d9c\u0db1\u0dca\u0dd9?\n\n3. \u0d9c\u0db8\u0db8 \u0dc0\u0dc3\u0dbb \u0dad\u0dd4 \u0dab\u0dba \u0dc0\u0dcf\u0db4\u0dad\u0d9a \u0dc3\u0dc4 \u0d9c\u0db4\u0dcf\u0dbd\u0dd3 \u0dc0\u0dba\u0d9c\u0dba\u0db1\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0dd9 \u0d9c\u0d9c\u0dd3\u0dda \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0d9c\u0d9a\u0dcf\u0db4\u0db8\u0dab\u0dd9? \u0d91\u0dba \u0d89\u0dbb\u0dd2\u0db4\u0dad \u0dc0\u0dc3\u0dbb 2 \u0dc3\u0db3\u0dc4\u0dcf \u0d9c\u0dc0\u0db1\u0dc3\u0dae \u0dc0\u0db1 \u0d86\u0d9a\u0dcf\u0dbb\u0dba \u0dc0\u0dcf\u0dbb\u0dca\u0d9a \u0d9a\u0d9a\u0dc0 \u0d9c\u0dc0\u0db1\u0dca \u0d9c\u0dc0\u0db1\u0dca\u0dc0 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0d9c\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0d89\u0dbb\u0dd2\u0db4\u0dad\u0db4\u0dad\u0dca \u0d9a \u0dc4\u0dd0\u0d9a\u0dd2\u0dd9?\n\n\u0dc0\u0dd2\u0d9c\u0dba\u0dae\u0dc2\u0d9c\u0dba\u0db1\u0dca\u0db8 IMF \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dd6 \u0db4\u0dc3\u0dd4 \u0d85\u0db4\u0da7 \u0dab\u0dba \u0d9c\u0dc3\u0dae\u0dc0\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0db8 \u0dc0\u0dba\u0d9c\u0dba\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 30\u0da7\u0dad\u0dca \u0dc0\u0da9\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca - \u0dad\u0dd4\u0d9c\u0db1\u0db1\u0dca \u0d9c\u0dd9\u0d9a\u0d9a\u0da7 \u0d86\u0dc3\u0db1\u0dca\u0db1 \u0db8\u0dd4\u0dd9\u0dbd\u0d9a\u0dca - \u0dbb\u0dcf\u0da2\u0dba \u0d86\u0dd9\u0dcf\u0dba\u0d9c\u0db8\u0db1\u0dca \u0d9c\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0dc3\u0dd2 \u0db0 \u0d9c\u0dc0\u0db1\u0dc0\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d9c\u0dda \u0dd9\u0dad\u0dca\u0dad \u0dbb\u0d9c\u0da7\u0dca \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0dad\u0dca, \u0d85\u0db4\u0dd2\u0dad\u0dca \u0dd9\u0dd0\u0db1\u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0d89\u0dad\u0dcf\u0db8 \u0dc0\u0dd0\u0dd9\u0d9c\u0dad\u0dca \u0d9c\u0dc0\u0db1\u0dc0\u0dcf.\n\n4. \u0d89\u0dbb\u0dd2\u0db4\u0dad \u0dc0\u0dc3\u0dbb 2 \u0dad\u0dd4 \u0dab\u0dba \u0d9c\u0d9c\u0dd3\u0d9c\u0dda \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dd2\u0dba \u0dad\u0dd2\u0dbb\u0dc3\u0dbb\u0dc0 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0da2\u0d9c\u0d86 \u0d87\u0dc3\u0dae\u0dad\u0d9c\u0dda\u0db1\u0dca\u0dad\u0dd4\u0d9c\u0dad \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9c \u0d9c\u0dba \u0d9c\u0d9a\u0dcf\u0db4\u0db8\u0dab\u0dd9? \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9c\u0db1\u0dca 2028 \u0dab\u0dba \u0d9c\u0d9c\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0db4\u0dd2 2022, 2026, 2027 \u0db1\u0da9\u0dad\u0dca\u0dad\u0dd4 \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9c \u0d9c\u0dba\u0db1\u0dca \u0d9c\u0d9a\u0dcf\u0db4\u0db8\u0dab\u0dd9? \u0d9c\u0dda \u0dc0\u0dc3\u0d9c\u0dbb\u0dca \u0d91\u0db8 \u0d89\u0dbd\u0d9a\u0dca\u0d9a \u0d9c\u0d9a\u0dcf\u0db4\u0db8\u0dab \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0dc3\u0db4\u0dd4\u0dbb\u0dcf \u0d9c\u0d9c\u0db1 \u0dad\u0dd2\u0d9c\u0dda\u0dd9? \u0d8a \u0d9f \u0dc0\u0dc3\u0dbb 2 \u0dad\u0dd4 \u0d91\u0dba \u0d9c\u0d9a\u0d9c\u0dc3\u0dae \u0db4\u0dd4\u0d9c\u0dbb\u0ddd\u0d9a \u0db1\u0dba \u0d9a\u0dbb \u0dad\u0dd2\u0d9c\u0dda\u0dd9?\n\n5. \u0dc3\u0dcf\u0db0\u0db1\u0dd3\u0dba \u0d9c\u0dbd\u0dc3 \u0dab\u0dba \u0d9c\u0d9c\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dcf\u0dbb\u0dca\u0d9a \u0d9a\u0d9a\u0dc0 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0d9c\u0d9c\u0db1 \u0dba\u0dcf \u0dba\u0dd4\u0dad\u0dd4 \u0dba\u0dd0\u0dd2 \u0d87\u0dc3\u0dae\u0dad\u0d9c\u0dda\u0db1\u0dca\u0dad\u0dd4\u0d9c\u0dad \u0d9a\u0dbb \u0d87\u0dad\u0dd2, \u0d91\u0d9c\u0dc4\u0db8\u0dad\u0dca \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda \u0d85\u0d9c\u0dbd\u0dcf\u0d9a\u0dca\u0d9a \u0d9a\u0dad \u0d85\u0dc0\u0db8 \u0d85\u0db4\u0db1\u0dba\u0db1 \u0d86\u0dd9\u0dcf\u0dba\u0dda \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dc4 \u0dc0\u0dd2\u0d9c \u0dba \u0d9c\u0dda\u0dc2\u0dab \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0db1\u0dca \u0d9c\u0d9a\u0dcf\u0db4\u0db8\u0dab \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dd9? \u0d9c\u0dc0\u0db1\u0dad\u0dca \u0dc0\u0d9a\u0db1\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0db1\u0dda 2028\u0daf\u0dd3 \u0dab\u0dba \u0d9c\u0d9c\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0db4\u0dd2 \u0d9c\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0dc0\u0dcf\u0dbb\u0dca\u0d9a \u0d9a\u0d9a\u0dc0 \u0db1\u0da9\u0dad\u0dca\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0da7 \u0d95\u0db1\u0dd1 \u0d85\u0db4\u0db1\u0dba\u0db1 \u0d86\u0dd9\u0dcf\u0dba\u0db8 \u0dc3\u0dc4 \u0d9c\u0dda\u0dc2\u0dab \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0d9c\u0d9a\u0dcf\u0db4\u0db8\u0dab \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dd9? \u0d92\u0d9a \u0d89\u0dad\u0dcf\u0db8 \u0dc0\u0dd0\u0dd9\u0d9c\u0dad\u0dca \u0dca\u200d\u0dbb\u0dba\u0dae\u0db1\u0dba\u0d9a\u0dca. \u0d92 \u0dc3\u0db3\u0dc4\u0dcf - \u0d92 \u0d89\u0dbd\u0d9a\u0dca\u0d9a \u0d9a\u0dbb\u0dcf \u0dba\u0dd1\u0db8 \u0dc3\u0db3\u0dc4\u0dcf - \u0d9c\u0d9c\u0dc0\u0dd4\u0dab\u0dd4 \u0dc0\u0dc3\u0dbb \u0dad\u0dd4 \u0dbb\u0da2\u0dba \u0dc3\u0d9a\u0dc3\u0dae \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dc0 \u0d9a\u0dd4\u0db8\u0d9a\u0dca\u0dd9? \u0d91\u0db8 \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dc0 \u0dad\u0dd4 \u0dbb\u0da2\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0dcf\u0dbb\u0dca \u0d9a \u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0d89\u0dbd\u0d9a\u0dca\u0d9a \u0d9a\u0dc0\u0d9c\u0dbb\u0dca\u0dd9?"
