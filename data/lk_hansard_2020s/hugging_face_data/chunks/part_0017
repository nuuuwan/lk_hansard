0db4\u0dc4\n\n\uf0b7 \u0d9a\u0dca\u0d9c\u0dc2\u0dae\u0dbb \u0dbb\u0dcf\u0da2\u0d9a\u0dcf\u0dbb\u0dd3 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\n\n\u0dc3\u0dcf\u0d9b\u0dba\u0dcf\u0dc0 26\u0dba\u0dd2.\n\n\u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dad\u0dca\u0dad\u0db8\u0d9a \u0d9a\u0dbb\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1\u0dca \u0dba\u0dd0\u0db1 \u0db6\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0d85\u0dc3\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d92\u0d9a\u0da7 \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0daf\u0dd3\u0dca\u0d9d \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0d9c\u0db1\u0dca. \u0db8\u0db8 \u0d9a\u0dd3\u0db4 \u0d9a\u0dca \u0d9a\u0dd2 \u0db1\u0dca\u0db1\u0db8\u0dca.\n\n\uf0b7 \u0dc3\u0dd4\u0dc5\u0dd4 \u0dc4\u0dcf \u0db8\u0db0\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0dab \u0d9a\u0dd4\u0dbb\u0dd4\u0db3\u0dd4 \u0dc0\u0dba\u0dc0\u0dc3\u0dcf \u0d9a \u0db1\u0dca\u0dc4\u0da7 \u0db1\u0dc0 \u0d85\u0db4\u0db1 \u0db1 \u0d9c\u0dc0\u0d9c\u0dc5\u0db3 \u0d9c\u0db4\u0dcf\u0dc5 \u0dc0\u0dd2\u0dc0\u0dd2\u0dad \u0d9a\u0dbb \u0daf\u0dd3\u0db8 \u0dc4\u0dcf \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0db1\u0dba \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0dd0\u0dbd\u0dc3\u0dd3\u0db8.\n\n\uf0b7 \u0dc3\u0dd4\u0dc5\u0dd4 \u0dc4\u0dcf \u0db8\u0db0\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0dab \u0d9a\u0dd4\u0dbb\u0dd4\u0db3\u0dd4 \u0dc0\u0dba\u0dc0\u0dc3\u0dcf \u0d9a \u0db1\u0dca\u0dc4\u0da7 \u0da2\u0dcf\u0dad\u0dba\u0db1\u0dca\u0dad\u0dbb \u0db4\u0dca\u200d\u0dbb\u0daf\u0dca\u0db1\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dc4\u0dcf\u0dcf\u0d9c\u0dd2 \u0d9a\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dc0\u0db1\u0dba \u0dc3\u0dc4\u0dcf \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0d9a\u0dd4\u0dbb\u0dd4\u0db3\u0dd4 \u0d85\u0db4\u0db1 \u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca\u0db0\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8.\n\n\uf0b7 \u0dc0\u0dba\u0dc0\u0dc