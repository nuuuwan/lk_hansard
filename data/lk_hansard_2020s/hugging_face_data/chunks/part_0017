2\u0d9a\u0daf:\u0daf \u0d9a2 \u0dad\u0dd4\u0db8\u0dc52 \u0da72 \u0d91\u0db1\u0dbb 2 \u0daf\u0dbb\u0db1\u0dca 2\u0dcf\u0d9a\u0dba\u0dd202\u0db1 \u0ddc\u0dba:\u0d8b2\u0d94\u0dcf\u0dad\u0dd4\u0db8 \u0daf2\u0d8a\u0da72\u0dad\u0dc3\u0dcf\u0dca\u0db1\u0dc3\u0dcf\u0d9c2\u0dbb\u0da2\u0db1\u0dda2\u0dc0\u0dd0\u0da92\u0dba\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db82\u0dba\u0dbb\u0db1\u0dca 2\u0d9a\u0dd2\u0d9a\u0dbd\u0daf2\u0d95 \u0dd12\u0d9a\u0dd2\u0d9a\u0dbd\u0daf2\u0daf\u0dd2\u0db1\u0dc0\u0dda\u0d9a\u0da72\u0d9a \u0dc0\u0daf2\u0db1\u0db1\u0dca02\u0d9a2\u0db1\u0dd2\u0dc3\u0dcf\u0daf2 \u0da72\u0dc3\u0dca \u0dcf\u0dbb\u0d9a\u0d9a\u0dca \u0db82\u0daf\u0dd4\u0db1\u0dca\u0db1 \u0ddc\u0dca \u0d8b-\n\n1795 1796\n\n\u0dad\u0d9c\u0dd4\u0dc02(\u0d86\u0da0\u0daf\u0dca\u0dad\u0d9a)2\u0dbb\u0dc0\u0dda\u0db1\u0dd22\u0daf \u0dbb\u0dc3\u0dd6\u0dc0\u0dda\u0d9a2]\n\n2025 \u0d94\u0d9a\u0dca \u0db8\u0db1\u0dcf\u0dbd\u0dcf\u0dca\u0dad2292\n\n\u0d9c\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0dbb\u0dd9\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0baa\u0bbe \u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Speaker) \u0d94\u0dcf\u0dad\u0dd4\u0db8 \u0daf\u0da72\u0daf:\u0daf\u0dc52\u0db4\u0dca\u200d\u0dbb\u0dba\u0dca \u0d9a2\u0dc3\u0dcf\u0dda\u0dcf\u0db1\u0dca\u0dca\u200d\u0db1\u0d9a\u0db1\u0dca2\u0dba\u0dd4\u0dc0\u0dab\u0dd42\u0dad\u0dd0\u0dbb\u0dd0\u0dd2\u0db1\u0dbd\u0dd22\u0dba\u0dbb2\u0d9c\u0dd0\u0db1\u0dd3 \u0d9a\u0dca \u0db82 \u0dc0\u0dd2\u0dcf\u0dbb\u0dba\u0dd22 \u0dba\u0dbb\u0d9c\u0db1\u0dca 2 \u0dd4\u0dc0\u0dc5\u0dd4\u0dc0\u0db1\u0dca02 \u0dd0\u0dc0\u0dcf2 \u0dd0\u0dc0\u0dcf2 \u0dba\u0dd4\u0dc0\u0dab\u0dd42\u0dad\u0dd0\u0dbb\u0dd0\u0dd2\u0db1\u0dbd\u0dd22\u0dba\u0dbb2\u0d9c\u0dd0\u0db1\u0dd3 \u0da72\u0daf\u0da9\u0d9a\u0dca \u0db82 \u0dd0\u0dbb\u0dd0\u0d8b2\u0d9c\u0dd4\u0dc02 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8 \u0daf0\n\n\u0d9c\u0dd4 \u0dbb\u0dc0\u0dd3 \u0d9a\u0dd4\u0dab\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0dd9\u0dc4\u0dc3 \u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bb0\u0bb5\u0bbf \u0b95\u0bb0\u0bc1\u0ba3\u0bbe \u0bbe\u0baf\u0b95\u0bcd\u0b95) (The Hon. Ravi Karunanayake) \u0dad\u0dd0\u0dbb\u0dd0\u0dd2\u0db1\u0dbd\u0dd22\u0dba\u0dbb2\u0d9c\u0dd0\u0db1\u0dd3 \u0d9a\u0dca \u0db82\u0dcf \u0dba\u0dd22\u0db1\u0dda2\u0dba\u0dbb\u0db1\u0dca\u0db1\u0db1\u0dca\u0d8b2\u0d9c\u0dd4\u0dc02\u0dba\u0dcf\u0daf \u0daf\u0d9a\u0dba\u0dad\u0dd4\u0db8 \u0db1\u0dd202 \u0dc3\u0dca \u0dcf\u0dbb\u0d9a2 \u0db1: 2 \u0dc0\u0dd2\u0db0\u0dd2\u0d9a;2 \u0d9a2 \u0dc4\u0dd2 \u0daf\u0db1\u0dc0\u0dbd\u0daf2 \u0db1: 2\u0dc3\u0dca \u0dcf\u0dbb\u0d9a2 \u0dad\u0dd4\u0db8\u0dc52 \u0daf\u0dd2\u0dc52 \u0d94\u0d9a\u0dca \u0db8\u0db1\u0dba\u0ddc 2 \u0dc4\u0dd2\u0dbb\u0db1\u0dc0 \u0dc0\u0daf02 \u0daf\u0dad\u0da72 \u0db1\u0dad\u0db1 \u0dc0\u0daf\u0d8b2\u0d8a\u0da2\u0dd2\u0db4\u0dca\u0dad\u0dd4\u0db8\u0db1\u0dc0\u0db1\u0dca2 \u0dad\u0da7\u0db1\u0dca2 \u0d9c\u0dca \u0dcf2 \u0d91\u0dba2 \u0dbd\u0dd2\u0d82\u0dba\u0daf\u0dc0\u0da72 \u0d87\u0dc0\u0dd2\u0db1\u0dbd\u0daf2 \u0d8a\u0da72 \u0dad\u0dc3\u0dcf\u0dca\u0db1\u0dc3\u0dcf\u0d9c2\u0db1\u0db1\u0dca\u0dad\u0daf\u0dbd\u0d9a\u0da72\u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dbd\u0daf\u0d8b2 \u0dd0\u0da9\u0d9c\u0dc3\u0dcf\u0dca\u0dba\u0dbb\u0d9a\u0da72\u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dbd\u0daf\u0d8b2\u0daf\u0db1\u0dca\u0daf\u0dd4\u0db1\u0dd3\u0db1\u0dca\u0d9a\u0daf\u0db1\u0dc0\u0db1\u0dca\u0d8b2\u0dd2\u0dc5\u0dbd\u0dd2\u0db4\u0dd3 \u0db1\u0d9a\u0db1\u0dca\u0d8b-2\u0db1\u0dda\u0db1\u0dba\u0db1\u0dca2\u0daf\u0dcf\u0daf2\u0dcf\u0d9a\u0daf \u0dba2\u0dcf\u0dca \u0dca \u0dc0\u0d9a\u0d9a\u0dca \u0db82\u0d87\u0dad\u0dd22\u0db1\u0dc0 \u0dc0\u0daf02\u0daf\u0db1\u0db4\u0dca2\u0d87 \u0dad\u0dd22\u0dbd\u0daf\u0db12\u0dba\u0daf\u0db1\u0dca\u0dcf2 \u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8 \u0daf\u0dca 2\u0daf\u0dbd\u0dd4\u0db1\u0dcf\u0db1\u0dca2\u0dc4\u0dd2\u0dcf 2\u0d87 \u0dad\u0dd2\u0dc0\u0dbb\u0db1\u0d9a\u0d9a\u0dca \u0db802\u0db1\u0dda2\u0dc3\u0dcf\u0dca\u0dc0\u0d