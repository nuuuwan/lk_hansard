af\u0d9a\u0dd2\u0db4\u0db1\u0dca\u0d9a\u0db1\u0dca\u0daf\u0d9a \u0daf\u0dc3 \u0daf\u0d9a\u0dc0\u0db1\u0dd4\u0d9a\u0dc0\u0db1\u0dca\u0daf\u0dc0\u0dd0\u0da9\u0daf\u0dcf\u0dc3 \u0daf\u0db8\u0dd2\u0db1\u0dd2:\u0dc0\u0dc3\u0dd4\u0dc3\u0daf\u0dad\u0dc0\u0dd4\u0db1\u0dca\u0daf\u0dda\u0dc1\u0db4\u0dcf\u0daf\u0d9a\u0daf \u0daf\u0d9a\u0daf\u0dba\u0dd2\u0db1\u0dca\u0daf\u0dad\u0dca\u0db8\u0dba\u0dd2\u0daf\u0da2 \u0dcf\u0db0\u0dd2\u0dc1\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0daf\u0dc0\u0dd0\u0da7\u0dd4\u0dda\u0daf\u0d9a \u0dc0 \u0daf\u0dbb\u0dcf \u0daf\u0dd2\u0dc1\u200d\u0dbb\u0dcf\u0db8\u0daf\u0dc0\u0dd0\u0da7\u0dd4\u0dda\u0daf\u0d9a \u0dc0 \u0daf\u0dbb\u0dcf \u0daf\u0db1\u0dd2\u0dbd\u0daf\u0db1\u0dd2\u0dc0\u0dcf:\u0daf\u0dbd\u0db6\u0dcf\u0daf\u0d9a\u0daf \u0daf\u0dbb\u0dcf\u0daf\u0d86\u0daf\u0dd3\u0daf\u0dc3\u0dd2\u0db4\u0dbd\u0dca\u0dbd\u0daf\u0dc3\u0dd2 \u0db0\u0daf\u0d9a\u0dc0\u0db1\u0dca\u0d9a\u0db1\u0dca\u0dc3\u0daf\u0dbb\u0dd2 \u0daf\u0dd3\u0daf\u0dd2\u0dc1\u0d9a\u0dc1\u0dba\u0dd3\u0dba\u0dda\u0dc2\u0d9a\u0db4\u0db1\u0dca\u0daf\u0d9a\u0dd2\u0dc0\u0daf\u0dad\u0dd4\u0dad\u0dd4\u0dba\u0dd2 \u0daf\u0da2 \u0dad\u0dca\u0dcf\u0dc0 \u0daf\u0db1\u0dd2\u0dc0\u0dcf:\u0daf \u0dd0\u0dad\u0dd2\u0dc0\u0daf\u0d89\u0db3\u0dd2 \u0daf\u0dd3\u0daf\u0d92\u0daf\u0d9a \u0dc1\u0dba\u0dd3\u0dba\u0dc1\u0dcf\u0dbd \u0d85\u0db4\u0db1\u0dca \u0daf\u0dbd\u0db6\u0dcf\u0daf\u0d9a\u0daf \u0daf\u0db1\u0dd2\u0dbd\u0daf\u0db1\u0dd2\u0dc0\u0dcf:\u0daf\u0d92\u0daf\u0d85\u0db4\u0daf\u0dc0\u0dc3\u0db4\u0dca\u200d\u0dbb:\u0dcf\u0daf\u0db4\u0d9a\u0dca\u0daf\u0dc4\u0dcf\u0daf\u0dd2 \u0db8\u0dd2\u0dcf\u0db8\u0d9a\u0dca\u0daf\u0dcf\u0dc3\u0d9a \u0daf\u0dad\u0dd2\u0d9a\u0db6 \u0daf\u0db6\u0dc0\u0dc3\u0daf\u0d92\u0dc0\u0dcf\u0daf\u0db1\u0dd2\u0dc0\u0dcf:\u0daf\u0d9a \u0dca\u0d9a\u0dc0\u0dba\u0dd2 \u0daf\u0d87\u0dad\u0dca\u0dad\u0dca \u0db8\u0daf \u0dad\u0dca\u0d9a\u0dad\u0dca\u0dca\u0dad\u0dca \u0daf\u0dc3\u0dd4\u0d9a\u0d9b\u0dca\u200d\u0ddd\u0dc1\u0d9a \u0ddd\u0d9c\u0dd2\u0daf\u0db8\u0dcf\u0dc5\u0dd2 \u0dcf\u