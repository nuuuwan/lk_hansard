    "chunk_text": "\u0d85\u0daf \u0dc3\u0dba\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0db1\u0dd4 \u0dba\u0da9\u0dcf\u0dbd\u0dbb\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 500\u0d9a\u0da7 \u0d86\u0db1\u0dba\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc4\u0dd2\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dad\u0dca \u0dba\u0db8\u0dca \u0dba\u0db8\u0dcf\u0dba\u0dc4\u0dcf\u0dba\u0dad\u0dca \u0daf\u0dd4\u0db9\u0dd4\u0dbb\u0dd4 \u0dc3\u0dd3\u0db1\u0dd2 \u0db1\u0dd2\u0dc2 \u0db4\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1 - \u0db4\u0dd2\u0dca \u0dc0\u0dad\u0dca\u0dad \u0dc4\u0dd2\u0d9f\u0dd4\u0dbb\u0dcf\u0db1 \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dba\u0dcf\u0dbd\u0dcf\u0dc0\u0dbd\u0da7 - \u0dc3\u0dba\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0db1\u0dd4 \u0dba\u0da9\u0dcf\u0dbd\u0dbb\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 600\u0dca \u0dd2\u0dbd\u0dad\u0dbb \u0dd2\u0dbd\u0dba\u0daf\u0db8\u0dca \u0dba\u0dc0\u0db1\u0dc0\u0dcf.\n\n3. \u0d85\u0daf \u0d94\u0dba. \u0db8\u0dad\u0dba \u0dc3\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dab\u0dba\u0dba\u0db1\u0dca \u0dba\u0dc0\u0db1\u0dc3 \u0dc0\u0dd3 \u0dc3\u0dad. \u0dba\u0db8\u0dba \u0dd2\u0dc0\u0daf\u0dd4 \u0dc0\u0dd3\u0db8\u0da7 \u0dba\u0dc4 \u0dd4 \u0dc0\u0dd6 \u0db1\u0dc0 \u0dc3\u0dcf\u0db0\u0d9a \u0dba\u0db8\u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0dc3\u0dc4 \u0dba\u0db8\u0dc0\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0dba\u0dc0\u0db1\u0dc3 \u0d9a\u0db8\u0dca \u0dd2\u0dbd\u0dba \u0dc0\u0dcf\u0dc3\u0dba \u0dc4\u0dcf \u0d86\u0dba\u0dba\u0ddd\u0da2\u0dcf\u0db1 \u0d85\u0dc0\u0dba\u0dba\u0dad\u0dcf\u0dc0 \u0d85\u0dca \u0d9a\u0dbb\u0db1 \u0dc0 \u0d94 \u0dc5\u0dd2\u0db6\u0db3\u0d9c,\u0db1\u0dd2\u0dad\u0dca\u0daf?\n\n5. \u0dbb\u0da2\u0dcf\u0dba \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0dc3\u0dd3\u0db1\u0dd2 \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dba\u0dcf\u0dbd\u0dcf \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0dba\u0db1\u0dcf\u0d9a\u0dbb\u0db1\u0dca\u0dba\u0db1\u0dca \u0db1\u0db8\u0dca \u0d92\u0dc0\u0dcf \u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0dc0 \u0dba\u0d9c,\u0db1 \u0dc3\u0dad\u0dd2 \u0dc5\u0dd2\u0dba\u0dc0\u0dbb \u0dba\u0db8\u0dcf\u0db1\u0dc0\u0dcf\u0daf? \u0dba\u0db4\u0dde\u0daf\u0dca\u0d9c,\u0dbd\u0dd3\u0d9a\u0dbb\u0dab\u0dba\u0daf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf \u0dba\u0db4\u0dde\u0daf\u0dca\u0d9c,\u0dbd\u0dd2\u0d9a \u0dc4\u0dc0\u0dd4\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0daf \u0db1\u0dd2\u0dad\u0dd2\u0db1\u0db8\u0dca \u0dc0\u0dc3\u0dcf \u0daf\u0dd2\u0db8\u0dd3\u0db8\u0daf? \u0d91\u0dba \u0dd2\u0dbd\u0dc0\u0dd8\u0dad \u0dc4\u0dcf \u0db4\u0dca\u0dc2\u0db4\u0dcf\u0dad\u0dd3 \u0dba\u0db1\u0dcf\u0dc0\u0db1 \u200d\u0dbb\u0db8\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dd2\u0dc0\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dc0\u0da7 \u0dc3\u0dc4\u0dad\u0dd2\u0d9a \u0d9a\u0dd2\u0dd3\u0d9a\u0db8\u0dca \u0dbd \u0dcf \u0dba\u0daf\u0db1\u0dc0\u0dcf\u0daf?\n\n6. \u0dba\u0dca \u0dba\u0d9c,\u0dcf\u0dc0\u0dd3\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dba\u0d9c,\u0dc0\u0dd3\u0db8\u0dca \u0d85\u0dca \u0db8\u0dd2\u0dbd \u0dc3\u0dc4 \u0d89\u0dc4\u0dc5 \u0dd2\u0dbd\u0dba\u0daf\u0db8\u0dca \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0dc3\u0dbb\u0dab \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0db4\u0dad\u0dca \u0dba\u0dc0\u0dad\u0dd2. \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0db8\u0dd2\u0dbd\u0dca \u0dc3\u0dc4 \u0d9a\u0dcf\u0dba\u0dbd\u0ddd\u0da0\u0dd2\u0dad \u0dba\u0d9c,\u0dc0\u0dd3\u0db8\u0dca \u0dc3\u0dc4\u0dad\u0dd2\u0d9a \u0d9a\u0dd2\u0dd3\u0d9a\u0db8\u0da7 \u0dbb\u0da2\u0dcf\u0dba\u0da7 \u0dc5\u0dd2\u0db6\u0db3\u0d9c,\u0dad\u0dca \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad \u0dba\u0db1\u0dca\u0dca\u200d\u0dbb\u0dab\u0dba\u0dca \u0dad\u0dd2\u0dba \u0db1\u0dc0\u0dcf\u0daf?\n\n7. \u0dba\u0daf\u0dca\u0dd3\u0d9d\u0dba \u0db1\u0dd2\u0dc2 \u0db4\u0dcf\u0daf\u0db1\u0dba\u0da7 \u0dbb\u0db4\u0dad\u0dc5 \u0dcf\u0db0\u0dcf \u0dc3\u0dbd\u0dc3\u0db8\u0dd2\u0db1\u0dca \u0d86\u0db1\u0dba\u0db1\u0dba\u0da7 \u0dc0\u0dcf\u0dd2\u0dc0 \u0dbd \u0dcf \u0dba\u0daf\u0db1 \u0daf\u0dd4 \u0dc3\u0dc4 \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0dba\u0dc0\u0db1\u0dc3 \u0d9a\u0dd2\u0dd3\u0d9a\u0db8\u0da7 \u0dbb\u0da2\u0dcf\u0dba \u0dc3\u0dd2\u0dbd\u0dc3\u0dd4\u0db8\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0dba.\u0daf? \u0d91\u0dba\u0dc3 \u0db1\u0db8\u0dca \u0d91\u0db8 \u0dc3\u0d82\u0dba\u0dba\u0ddd\u0db0\u0db1 \u0dba\u0db8\u0dcf\u0db1\u0dc0\u0dcf\u0daf?\n\n8. \u0dc3\u0dd3\u0db1\u0dd2 \u0dba\u0db1\u0dd4 \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad\u0db8\u0dba \u0d9a\u0dbb\u0dd4\u0dab\u0dca \u0db4\u0db8\u0dab\u0dca \u0dba\u0db1\u0dcf\u0dc0 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d86\u0dc4\u0dcf\u0dbb \u0d86\u0dbb\u0dca\u0dc2\u0dcf\u0dc0 \u0dc3\u0dc4 \u0db4\u0dcf\u0dbb\u0dd2\u0dba\u0db7\u0ddd\u0d9c\u0dd2\u0d9a \u0db8\u0dd2\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dba\u0dbb\u0ddd\u0db0\u0dba \u0dc3\u0db8\u0dca \u0db1\u0dca\u0db0 \u0d9a\u0dbb\u0dd4\u0dab\u0d9a\u0dd2. \u0dba\u0daf\u0dca\u0dd3\u0d9d\u0dba \u0d85\u0dc0\u0dba\u0dba\u0dad\u0dcf\u0dc0\u0dba\u0dda \u0dd2\u0dc0\u0dba\u0dba\u0da7 85\u0d9a\u0da7 \u0dc0\u0dd2\u0da9\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dca \u0d86\u0db1\u0dba\u0db1\u0dba \u0db8\u0dad \u0dbb\u0d9a\u0dcf \u0db4\u0dc0\u0dad\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0dba\u0db4\u0dcf\u0dba\u0dc4\u0dcf\u0dc3\u0dad\u0dca \u0dc0\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0daf\u0dd3 \u0dba\u0d9c,\u0dcf\u0dc0\u0dd3\u0db1\u0dca\u0da7 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dca \u0dc3\u0dc4 \u0db4\u0dcf\u0dbb\u0dd2\u0dba\u0db7\u0ddd\u0d9c\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0da7 \u0d9c,\u0dad \u0dc4\u0dd2\u0d9a\u0dd2 \u0db8\u0dd2\u0dbd\u0dca \u0d85\u0dad\u0dbb \u0dc3\u0db8\u0dd4\u0dbd\u0dd2\u0dad\u0dad\u0dcf\u0dc0 \u0dbb\u0da2\u0dcf\u0dba \u0dbb\u0d9a\u0dc0\u0dcf \u0d9c,\u0db1\u0dca\u0dba\u0db1\u0dca \u0dba\u0d9a\u0dba\u0dc3 \u0daf?\n\n9. \u0d85\u0daf \u0dc0\u0db1 \u0dd2\u0dbd\u0da7 \u0d86\u0db1\u0dba\u0db1\u0dd2\u0d9a \u0dc3\u0dd3\u0db1\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0ddd\u0d9c\u0dca\u200d\u0dbb\u0dd1\u0db8\u0dba\u0dca \u0db8\u0dad \u0d85\u0dba \u0d9a\u0dbb\u0db1 \u0dd2\u0dc0\u0dba\u0dbd\u0dd4 \u0daf\u0dd4 \u0dc3\u0dc4 \u0dba\u0daf\u0dca\u0dd3\u0d9d\u0dba\u0dc0 \u0db1\u0dd2\u0dc2 \u0db4\u0dcf\u0daf\u0dd2\u0dad \u0dc3\u0dd3\u0db1\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0ddd\u0d9c\u0dca\u200d\u0dbb\u0dd1\u0db8\u0dba\u0dca \u0db8\u0dad \u0d85\u0dba \u0d9a\u0dbb\u0db1 \u0dc3\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dab \u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0db4\u0dd2\u0dc4\u0dd2\u0daf\u0dd2\u0dbd\u0dd2 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0daf?\n\n10. \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dba\u0dda \u0d9c,\u0dbb\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dd4\u0db8\u0dcf \u0dc3\u0dd3\u0db1\u0dd2 \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dba \u0dc5\u0dd2\u0db6\u0db3 \u0d9a \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dd2\u0dad \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0\u0dca - white paper \u0d91\u0d9a\u0dca - \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dc0\u0da7 \u0dc3\u0dc4\u0dad\u0dd2\u0d9a \u0dba\u0daf\u0db1\u0dc0\u0dcf\u0daf? \u0d92 \u0dd4\u0dc5 \u0db1\u0dd2\u0dc2 \u0db4\u0dcf\u0daf\u0db1 \u0d89\u0dbd\u0dca\u0d9a \u0d86\u0db1\u0dba\u0db1 \u0d85\u0dc0\u0dba\u0dba\u0dad\u0dcf \u0dc3 \u0dc0\u0dba\u0d82\u0dd6\u0dbb\u0dca\u0dab\u0dad\u0dcf \u0d89\u0dbd\u0dca\u0d9a \u0dba\u0db4\u0dde\u0daf\u0dca\u0d9c,\u0dbd\u0dd2\u0d9a \u0d86\u0dba\u0dba\u0ddd\u0da2\u0dcf\u0db1 \u0db7\u0dd6\u0db8\u0dd2\u0d9a\u0dcf\u0dc0 \u0daf\u0dd4 \u0dc3\u0d82\u0dba\u0dba\u0ddd\u0db0\u0db1 \u0dc3\u0dc4 NPP \u0d86\u0da9\u0dd4\u0d9a\u0dca\u0dba\u0dc3 \u0db1\u0dd2\u0dbd \u0db8\u0dad\u0dba \u0db4\u0dd2\u0dc4\u0dd2\u0daf\u0dd2\u0dbd\u0dd2\u0dc0 \u0dc3\u0d9a\u0dc4\u0db1\u0dca \u0dd2\u0dbd\u0dba \u0dba\u0dd4\u0dd4\u0dba."
