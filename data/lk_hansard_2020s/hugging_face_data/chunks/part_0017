u0d8b2\u0db1\u0dda2\u0dbb\u0db1\u0da7\u0dca2\u0dc3\u0dcf\u0dd2\u0d82\u0dc0\u0dca\u0dad\u0dca\u200d \u0d9a2\n\n1879 1880\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 * \u0dd4\u0dc0\u0dca\u0db4 \u0d9a\u0dcf\u0dbd\u0dad\u0dda \u0db6\u0dcf \u0d87 . * \u0ba8\u0bc2\u0ba9\u0bbf\u0b95\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. * Placed in the Library.\n\n2025 \u0d94\u0d9a\u0dca \u0db8\u0db1\u0dcf\u0dbd\u0dcf\u0dca\u0dad2292\n\n\u0dc0\u0dd2 \u0daf\u0dba2\u0dba\u0db1\u0dc5\u0d9c02\u0db1\u0dda2\u0dbb\u0db1\u0da7\u0dca2\u0db1\u0dca\u0d9a\u0db1\u0dbd2\u0dc0\u0dd2 \u0daf\u0dba2\u0dba\u0dbb\u0dd4\u0dc02\u0daf\u0d9a2\u0dc0\u0dd3\u0dbb\u0db1\u0d9a\u0dbd2\u0dc0\u0daf\u0db1 2\u0d9a\u0dd2\u0d9a \u0dc0\u0daf\u0d8b2\u0daf:2\u0daf\u0dd2\u0dc52\u0da2\u0daf\u0dcf\u0dba\u0db1\u0dca\u0dcf\u0dbb\u0d9a2\u0daf\u0dd2\u0db1\u0dc0\u0dda2\u0db1\u0dda2\u0db1\u0dba\u0ddc\u0db1\u0dca2\u0db1\u0dc0\u0dbd\u0daf2\u0dbd\u0dd402 \u0db8\u0dd4\u0dca \u0d8b2\u0daf:2\u0dc0 \u0db1\u0dba\u0ddc\u0da72\u0da2\u0daf\u0dcf\u0dba\u0db1\u0dca\u0dcf\u0dbb\u0d9a2\u0dad\u0dd4\u0db8\u0dc52\u0daf\u0dd2\u0dc52\u0d9c\u0dd0 \u0dc0\u0dd2\u0dba\u0daf\u0dbd2\u0dad\u0dd0\u0dbb\u0dd0\u0daf\u0dd3 \u0d9a\u0dca \u0db82\u0d87\u0dad\u0dd22\u0db1\u0dc0\u0dbd\u0daf2\u0dad\u0dd2\u0db1\u0dcf \u0dc0\u0daf02\u0da2\u0daf\u0dcf\u0dba\u0db1\u0dca\u0dcf\u0dbb\u0d9a2\u0dad\u0dd4\u0db8\u0dd2\u0db6\u0db1\u0dca2\u0daf\u0dad\u0da72\u0dc3\u0dcf\u0dca\u0dc0\u0dca\u0dad\u0dab \u0d9a2\u0dad\u0dab\u0dd2\u0dc0\u0dd4\u0da9\u0d9a\u0d9a\u0dca \u0db82 \u0dbd\u0dd0\u0db6\u0dd32 \u0dad\u0dd2\u0db1\u0dcf \u0dc0\u0daf02 \u0d9a2 \u0dcf \u0dba\u0dd2\u0d8b2 \u0da2\u0daf\u0dd3\u0dbb\u0db1\u0dca2 \u0daf\u0dcf\u0dbb2 \u0dc0\u0dd62 \u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0daf\u0dc3\u0dcf\u0d9a2 \u0dd0\u0dc0\u0dcf2 \u0db1\u0d9c\u0ddc\u0da92 \u0d9f\u0db1\u0dca 2 \u0dd4\u0dc0\u0dc5\u0dd4\u0dc0\u0db1\u0dca2 \u0db1\u0dbb\u0ddc 2 \u0d86\u0dca\u0da9\u0da9\u0dd4\u0dc02 \u0db6\u0dd2\u0dc4\u0dd22 \u0db1\u0dc0\u0dbd\u0daf2\u0dad\u0dd2\u0db1\u0dcf 2\u0dcf\u0dc0\u0da72\u0dc0\u0dd62\u0dad\u0dab\u0dd2\u0dc0\u0dd4\u0da9\u0d9a02\n\n\u0db1\u0dda\u0db1\u0d9c\u0ddc\u0db1\u0dbd\u0db1\u0dca2 \u0dd0\u0dc0\u0dcf2 \u0dd0\u0dc0\u0dcf\u0dca \u0da2 \u0dcf\u0daf\u0dc0\u0db1\u0d9c\u0db1\u0dca2\u0dcf \u0db1\u0dca\u0da72\u0da1\u0db1\u0dca:\u0d9a2\u0dbd\u0dcf\u0daf2\u0d9c\u0db1\u0dca 2 \u0dc3\u0dca \u0dc3\u0dcf\u0daf\u0dbb2\u0dba\u0dbb\u0db1\u0dca\u0db1\u0db1\u0dca2 \u0db6\u0dd2\u0d9a2\u0da2\u0db1\u0dd2\u0dcf2\u0d9a\u0dd2\u0dbb\u0dd3\u0db1 \u0db1\u0dca02 2\u0dc4\u0dd2\u0dcf 2\u0dc0\u0dd2\u0db0\u0dd2\u0d9a\u0da72\u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0daf\u0d9a\u0dba\u0dca \u0dc0\u0db1\u0d9a\u0db1\u0dca2\u0dbb\u0da72\u0db1\u0d9c\u0ddc\u0da92 \u0d9f\u0db1\u0dca 2 \u0dda\u0d8b2\u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc3\u0dcf\u0db1\u0dd3\u0d9a\u0dca \u0dc0\u0d9a2 \u0db8\u0dd4\u0dbd\u0dd2\u0db1\u0dca 2 \u0dbb\u0da72 \u0dad\u0dd4\u0db8\u0dc52 \u0db1\u0d9c\u0ddc\u0da92 \u0d9f\u0db1\u0dca 2 \u0d95 \u0dd102\u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc3\u0dcf\u0db1\u0dd3\u0d9a\u0dca \u0dc0\u0d9a2 \u0db1\u0d9c\u0ddc\u0da92 \u0d9f\u0db1\u0dca\u0db1\u0db1\u0dca2 \u0dd0\u0dad\u0dd2\u0dc02 \u0daf\u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0daf\u0dc3\u0dcf\u0d9a2 \u0db1\u0d9c\u0ddc\u0da92 \u0d9f\u0dbd\u0daf2\u0db1\u0dda2\u0dbb\u0da72\u0dba\u0dc0:\u0daf\u0dc0\u0dca 2\u0d9a\u0dbb\u0dad\u0dca 2\u0dcf\u0dd0 \u0dba\u0da72\u0dad\u0dca 2\u0dba\u0dbb\u0db1\u0dca 2\u0daf\u0dad\u0da72\u0dcf\u0dd0\u0dc0\u0dda2\u0db1\u0dc0 \u0dc0\u0daf02222\u0daf\u0dd2\u0dc52222\u0dcf\u0dbd\u0d9a2222\u0dbd\u0dcf\u0daf\u0db1\u0d9c 2222:\u0dd0 \u0da7222\u0daf\u0dc0\u0dd4\u0dd4\u0dc0\u0dda:\u0d9a\u0dca \u0db822\u0db1\u0dc0 \u0dc0\u0daf02 \u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0ba4\u0bcd\u0b95\u0ba4\u0baa\u0bcd \u0ba4\u0baa\u0bb1\u0bcd\u0bb1\u0bc1 \u0b92\u0bb0\u0bc1 \u0bb5\u0bb0\u0bc1\u0b9f\u0bae\u0bbe\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0b95\u0ba4\u0baa\u0bcd \u0ba4\u0baa\u0bbe\u0bb1\u0bc1\u0baa\u0bcd\u0ba4\u0baa\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bb0\u0baa\u0bbe\u0ba4\u0bc1, \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0ba4\u0b95\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bbe\u0b9f\u0bbe\u0b95\u0bb5\u0bb2\u0bcd\u0bb2, \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0bae\u0bc1\u0b9f\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b92\u0bb0\u0bc1 \u0bbe\u0b9f\u0bbe\u0b95\u0bb0\u0bb5 \u0b87\u0ba8\u0bcd\u0ba4 \u0bbe\u0b9f\u0bc1 \u0b95\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0ba4\u0ba4\u0bbe\u0bbf\u0baf\u0bc1\u0bae\u0bcd. 2015\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0baa\u0bc1 \u0b87\u0ba8\u0bcd\u0ba4 \u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0baa\u0bbe\u0bbe\u0bbf\u0baf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba4\u0bc1\u0bb5\u0bc1\u0bae\u0bcd \u0bb0\u0bae\u0bb1\u0bcd\u0ba4\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bbe\u0ba4 \u0bbf\u0b95\u0bb2 \u0b95\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. \u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0bbf\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0bae\u0bc1\u0b9f\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4 \u0baa\u0bb2\u0bcd\u0bb0\u0bb5\u0bb1\u0bc1 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0b95\u0bb3 \u0b95\u0bc1\u0bb1\u0bc1\u0b95\u0bbf\u0baf \u0b95\u0bbe\u0bb2\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0b86\u0bb0\u0bae\u0bcd\u0baa\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb0\u0bb1\u0bbe\u0bae\u0bcd."
