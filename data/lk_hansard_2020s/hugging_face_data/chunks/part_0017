    "chunk_text": "2029 \u0d85\u0dba\u0dd2\u0db7\u0dc0\u0dbd\u0db1\u0dca\u0dad\u0dca\u200d\u0dba\u0dda \u0d9a\u0dd4\u0db8\u0dc1\u0dbb \u0dc1 \u0d85\u0db4\u0dd2 \u0d9a\u0dd2 \u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1, \u0d94\u0db6 2029\u0daf\u0dd3 \u0dba\u0dda \u0dbb \u0dc4\u0dd9\u0db1\u0dca\u0db1 \u0dd2 \u0da7\u0dd2 \u0dc1 \u0db1\u0dda \u0d94\u0db6 \u0dc4\u0dd9\u0db1\u0dca\u0db1 \u0dba\u0dc0\u0db1\u0dca\u0dba\u0db1\u0dca \u0dba\u0db7\u0dc1\u0dda\u0dd2\u0dbd \u0dbb \u0d9a\u0dca \u0db6\u0dc0. \u0d85\u0dba\u0dd2\u0db7\u0dc0 \u0dc4\u0dbd\u0dc1, \u0db4\u0dd0\u0dad\u0dca\u0dad\u0dca\u200d \u0dc0\u0dd0\u0da7\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0da2\u0db1\u0dad\u0dca\u200d\u0dc1\u0dc0\u0dba \u0db1\u0dca \u0dba\u0dd4\u0dad\u0dca \u0dba\u0db7\u0dc1\u0dda\u0dd2\u0dbd \u0dbb \u0d9a\u0dca \u0dd2\u0dbd\u0dd2 \u0dba\u0dc0\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0dc3\u0db6\u0dd4\u0dab\u0dd4 \u0dbb\u0d9a \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d85\u0dd9 \u0dc0\u0db1\u0dd2\u0dc1 \u0da2\u0dc1\u0dad\u0dd2\u0dc3\u0dba\u0dda \u0dc0\u0dc1\u0db7\u0db1\u0dc1\u0dc0 \u0dba\u0dc0\u0db1\u0db7\u0dc0 \u0dba\u0dc0\u0dbd\u0dc1 \u0dad\u0dd2\u0dc3\u0dba\u0db6\u0db1\u0dca\u0dba\u0db1\u0dca, \u0dba\u0daf\u0dca\u0db1\u0db4\u0dc1\u0dbd\u0db1\u0dba\u0dda \u0dba\u0dc0\u0db1\u0db7\u0dc0\u0dc0\u0dd3\u0db8\u0dad\u0dca \u0dbb\u0d9a\u0dca\u0d9a. \u0d85\u0db4\u0dd2 \u0d9a\u0dc0\u0dd9\u0dc1\u0dc0\u0dad\u0dca \u0dd2 \u0dad\u0dd4\u0dba\u0dda \u0db1\u0dd0\u0dc4\u0dd0, \u0dba\u0dda\u0dba \u0dc1\u0dbd\u0dca\u0dbd\u0dbd\u0db1\u0dca \u0dba\u0dda \u0dbd\u0d9c\u0d9a\u0dc1\u0dc0 \u0d87\u0dad\u0dd4\u0dba\u0dc5\u0dc0 \u0d85\u0dba\u0dd2\u0db7\u0dc0 \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0db1\u0dd2\u0dc2\u0dc0\u0db4\u0dc1\u0dd9\u0db1 \u0d9a\u0dbb\u0db1\u0dc0\u0dc1 \u0d9a\u0dd2 \u0dbd\u0dc1. \u0d85\u0db4\u0dd2 \u0d9a\u0dc0\u0dd9\u0dc1\u0dc0\u0dad\u0dca \u0dd2 \u0dad\u0dd4\u0dba\u0dda \u0db1\u0dd0\u0dc4\u0dd0, \u0d9a\u0db1\u0dca\u0dba\u0da7\u0dca\u0da7\u0db1\u0dbb\u0dca\u0dbd \u0dab\u0db1\u0dca \u0dba\u0dda \u0dbb \u0d85\u0dba\u0dd2\u0db7\u0dc0 \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0dba \u0dba\u0db1\u0db1\u0dc0\u0dc1 \u0d9a\u0dd2 \u0dbd\u0dc1. \u0d85\u0dd9 \u0dba\u0dda\u0dc0\u0dc1 \u0dd0\u0db1 \u0dba\u0dad\u0dca\u200d\u0dc1\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dbb\u0dc5\u0dd2 \u0dbb\u0db1\u0dc0\u0dc1. \u0dba \u0dc1\u0dbd\u0dca\u0dbd\u0dbd\u0db1\u0dca \u0db6\u0dbd\u0dc1\u0dba\u0db4\u0dc1\u0dba\u0dbb\u0dc1\u0dad\u0dca\u0dad\u0dd4 \u0dd4\u0dab\u0dba \u0dba\u0db8\u0dc1\u0d9a\u0d9a\u0dca\u0dd9? \u0dba\u0dda \u0dbb\u0dba\u0da7\u0dca\u0da7 \u0dad\u0dca\u200d\u0dbb\u0dd4\u0dab \u0db1\u0dca \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0dba\u0db4\u0dc1\u0dc0\u0dc1, \u0dd2 \u0dad\u0dca\u200d\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0dd2\u0dc1\u0db0\u0dd2 \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba\u0dc0\u0dbd \u0dba \u0dc1\u0db8\u0dd4 \u0dd4\u0dab\u0dab\u0dd4 \u0daf\u0dd4\u0db6\u0dbd \u0db1\u0dca \u0db6\u0dc0 \u0dbb\u0dba\u0da7\u0dca\u0da7 \u0dad\u0dca\u200d\u0dbb\u0dd4\u0dab \u0db4\u0dca\u200d\u0dbb\u0da2\u0dc1\u0dc0 \u0db4\u0dbb\u0dd2\u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0dca\u200d\u0db1 \u0d9a\u0dbb\u0dbd\u0dc1 \u0dba \u0dc1\u0dbd\u0dca\u0dbd\u0dbd\u0db1\u0dca\u0dba \u0db8\u0da2\u0dbb \u0dba\u0daf\u0dca\u0db1\u0db4\u0dc1\u0dbd\u0db1 \u0db7\u0d9c\u0db7\u0dc0\u0d9a\u0dd8\u0dad\u0dd2\u0dc3 \u0d89\u0db7\u0dc0\u0db7\u0dbb\u0dc4 \u0dba \u0db1 \u0db1\u0dca\u0db1 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0dba \u0dc1\u0dbd\u0dca\u0dbd\u0dbd\u0db1\u0dca \u0dc0\u0dd0\u0da9 \u0d9a\u0dba\u0dc5\u0dc0, \u0dbb\u0dd4 \u0db1\u0dd2\u0dba \u0ddd\u0da2\u0dba \u0d9a\u0dc1\u0dbb\u0d9a \u0db7\u0d82\u0dc1 \u0db7\u0d82\u0dc1\u0db4\u0dad\u0dd2\u0dc3\u0dad\u0dd4\u0db8\u0dd2 \u0db1\u0dd2. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dd9\u0dd0\u0db1\u0dca \u0db7\u0d9c\u0db7\u0dc0\u0d9a\u0dd8\u0dad\u0dd2\u0dc3 \u0d85\u0dc0\u0db7\u0db1\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0dc3\u0dba\u0db6\u0db1\u0dc0\u0dc1.\n\n\u0dbb\u0db8 \u0db1\u0dd2\u0db7\u0dc1 \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0dc4\u0dc1 \u0db7\u0dda\u0db6\u0db1\u0dca\u0db0\u0dca\u200d \u0dc0\u0dd0\u0dbb\u0dd0\u0dd2\u0db1\u0dc0\u0dbd \u0db8\u0dd4\u0dc0\u0dc1 \u0dba\u0dc0\u0dbd\u0dc1, \u0dba\u0da0\u0ddd\u0dd9\u0db1\u0dc1\u0dc0\u0dbd \u0dbd\u0d9a\u0dca \u0dba\u0dc0\u0dbd\u0dc1 \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dba\u0dda \u0dba\u0daf\u0dca\u0db1\u0db4\u0dc1\u0dbd\u0db1\u0da5 \u0db1\u0dca \u0d85\u0db4\u0dd2 \u0d89\u0dad\u0dca\u200d\u0dc1 \u0d95\u0db1\u0dd1\u0d9a\u0db8\u0dd2\u0db1\u0dca \u0d9a\u0dd2 \u0db1\u0dc0\u0dc1, \u0dad\u0dca\u200d\u0dc0\u0daf\u0dd4\u0dbb \u0dad\u0dca \u0da2\u0db1\u0dad\u0dca\u200d\u0dc1\u0dc0 \u0dba\u0dda \u0dba\u0db6\u0dc1\u0dbb\u0dd4\u0dc0 \u0d9a\u0dbb\u0dba \u0db1 \u0db1\u0dca\u0db1 \u0d94\u0db6 \u0d85\u0db4\u0dd2 \u0d89\u0da9 \u0dba\u0dd9\u0db1\u0dca\u0dba\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd2\u0dc3 \u0db6\u0dc0. \u0db8\u0dc4 \u0dbb\u0dda\u0da2\u0dd4\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0dca \u0d85\u0db4\u0dd2 \u0d9a \u0d9a\u0dd2 \u0db1\u0dc0\u0dc1. 2029 \u0d85\u0dba\u0dd2\u0db7\u0dc0\u0dbd\u0db1\u0dca\u0dad\u0dca\u200d\u0dba\u0dda \u0dc3\u0dd2\u0dd2 \u0db1 \u0d9a\u0dd4\u0db8\u0dc1\u0dbb \u0dc1 \u0dad\u0dca \u0d85\u0db4\u0dd2 \u0d9a \u0d9a\u0dd2 \u0db1\u0dc0\u0dc1. \u0dc0\u0dc1\u0dba \u0db8 \u0dc0\u0dd0\u0da9\u0db6\u0dbd\u0db1 \u0db8\u0dc4 \u0dbb\u0da2\u0dc0\u0dbb\u0dd4\u0dad\u0dca \u0dd9\u0dd0\u0db1\u0dca \u0dbb\u0dc5\u0dd2 \u0d87\u0dd2\u0dc1\u0dad\u0dca \u0dad\u0dd2\u0dc3\u0dba\u0db6\u0db1\u0dc0\u0dc1. \u0dba \u0dc1\u0dbd\u0dca\u0dbd\u0dbd\u0db1\u0dca \u0dad\u0dca \u0d85\u0db4\u0dd2 \u0d9a\u0dd2 \u0db1\u0dc0\u0dc1, \u0d94 \u0dba \u0dc1\u0dbd\u0dca\u0dbd\u0dbd\u0db1\u0dca\u0dba \u0dba\u0daf\u0dca\u0db1\u0db4\u0dc1\u0dbd\u0db1 \u0d89\u0dc0\u0dbb\u0dba\u0dd2, \u0dba\u0daf\u0dca\u0db1\u0db4\u0dc1\u0dbd\u0db1 \u0db1\u0dd0\u0dc0\u0dad\u0dca\u200d \u0dba\u0dda \u0dbb\u0dba\u0da7\u0dca\u0da7 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0d89\u0da9 \u0dba\u0dd9\u0db1\u0dca\u0dba\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2 \u0dbd\u0dc1.\n\n\u0d85\u0db4\u0dd2 \u0dba\u0dda \u0dbb\u0dba\u0da7\u0dca\u0da7 \u0dad\u0dca\u200d\u0dbb\u0dd4\u0dab \u0db1\u0dca\u0dba \u0da2\u0dd3\u0dd2\u0dc1\u0dad\u0dca\u200d \u0dbd\u0dc0\u0dc1 \u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0dba\u0db4\u0dca \u0dbb\u0dba\u0da7\u0dca\u0da7 \u0d85\u0dda\u0db8\u0dbd\u0dc1- \u0dad\u0dca\u200d\u0dc1\u0dad\u0dca\u0dad\u0dca\u200d\u0dbd\u0dc1 \u0daf\u0dd4\u0d9a\u0dca \u0dd2\u0dc1\u0db3\u0dd2\u0db1\u0dc0\u0dc1, \u0dba\u0dda \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba\u0dc0\u0dbd \u0dd9\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d87\u0db6\u0dca\u0dbd\u0db6\u0dd0\u0dd2 \u0dc0\u0dd3\u0db8 \u0db1\u0dd2\u0db7\u0dc1. \u0d87\u0db7\u0dc0\u0dc0\u0dbd \u0dbb\u0db1 \u0d9a\u0db3\u0dd4\u0dc5\u0dd4\u0dc0\u0dbd \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2\u0dc3 \u0dba\u0daf\u0dca\u0db1\u0db4\u0dc1\u0dbd\u0db1 \u0dc0 \u0d9a\u0dd2 \u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0db1\u0dca\u0db1 \u0d9a \u0dbb\u0dba\u0dbb\u0dd2 \u0dc0 \u0db8\u0dc4\u0da2\u0db1\u0dad\u0dca\u200d\u0dc1\u0dc0 \u0dd2\u0dc1\u0db0\u0dd2 \u0d85\u0db4\u0dd2 \u0dba\u0db4\u0dc5 \u0dd0\u0dba\u0db7\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1; \u0db8\u0dc4\u0da2\u0db1\u0dad\u0dca\u200d\u0dc1\u0dc0 \u0dd2\u0dc1\u0db0\u0dd2 \u0d85\u0db4\u0dd2 \u0dbb\u0d9a\u0dad\u0dd4 \u0dba\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1; \u0db8\u0dc4\u0da2\u0db1\u0dad\u0dca\u200d\u0dc1\u0dc0 \u0dd2\u0dc1\u0db0\u0dd2 \u0d85\u0db4\u0dd2 \u0dc0\u0dd0\u0da9\n\n1189 1190\n\n\u0db4\u0dc1\u0dbb\u0dca\u0dbd\u0dbd\u0dd2\u0dba\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0"
