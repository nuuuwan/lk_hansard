    "chunk_text": "\u0dad\u0dca\u0dbb\u0dca\u0da2 \u0db4\u0d9a\u0dca\u0dc3\u0daf\u0d9a\u0db8\u0dca\u0dcf\u0daf \u0daf\u0d9a \u0d9a \u0dca\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0d9a\u0d9a\u0daf\u0dc1\u0d9a\u0dca\u0dc2\u0dc0\u0dbd\u0daf:\u0dcf\u0db8\u0dcf\u0dba\u0d9a\u0dcf\u0db4\u0db1\u0dca\u0d9a\u0d9a\u0daf\u0d89\u0da9 \u0dc0\u0dbd\u0dd2\u0db1\u0dca\u0daf\u0db8\u0dad\u0dd4\u0daf\u0dc0 \u0daf\u0d9a \u0dc0\u0dbd\u0dca\u0daf\u0dbb\u0d9a\u0dca\u0dcf\u0daf\u0db6\u0dd0\u0dbd\u0dd4\u0dc0\u0dcf\u0db8\u0daf\u0dbb\u0db4\u0daf\u0db6\u0dc3\u0dc1\u0dad\u0dca\u0dc5\u0daf\u0dad\u0dca\u0dbb\u0dca\u0da2 \u0db4\u0d9a\u0dca\u0dc3\u0daf \u0db8\u0dd4\u0dad\u0dca\u0daf\u0d85\u0dc1 \u0daf\u0dd2\u0dc1\u0dc1\u0dba\u0dd3\u0dba\u0dc0\u0dc0\u0dcf:\u0dba\u0dd2 \u0daf\u0da2 \u0dad\u0dca\u0dcf\u0dc0\u0d9a\u0d9a\u0daf\u0d86\u0daf\u0dc3\u0db4\u0daf\u0daf \u0dcf \u0dad\u0dca\u0daf\u0da2 \u0dcf\u0db0\u0dd2\u0dc1\u0dad\u0dd2\u0dc0\u0dc3\u0d9a\u0db4\u0d9a\u0dca\u0daf\u0d85\u0dc1 \u0daf\u0dc3\u0dd2\u0da7\u0dd2 \u0dc0\u0dcf\u0daf\u0d9a\u0dd2\u0db4\u0dbd\u0dcf\u0dc3 \u0d9a \u0d9a \u0dca\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0d9a\u0d9a\u0daf\u0d86\u0dc3\u0d9a\u0dca\u0dc2\u0dcf\u0dc0\u0daf\u0d85\u0dc1 \u0daf\u0dc0\u0dd0\u0da9\u0d9a\u0dca\u0daf \u0dd0\u0dc4\u0dd0\u0dc3\u0daf\n\n\u0dbb\u0dd4\u0daf\u0db1\u0dd2\u0d9a\u0db4\u0ddd\u0da2\u200d\u0daf\u0dcf\u0dcf\u0dc3\u0dcf\u0daf: \u0dcf\u0daf: \u0dcf\u0dc1\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0db4\u0db1\u0dd2 \u0daf\u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2\u0daf\u0d85\u0db4\u0dd2\u0daf\u0d9a\u0dad\u0dca\u0dbb\u0dd4 \u0daf \u0db1\u0dca \u0daf\u0d95 \u0dd1 \u0daf\u0d9a \u0daf\u0d85\u0dc0:\u0dc0\u0dae\u0dcf\u0d9a\u0dda\u0daf\u0d9a \u0daf\u0dc0\u0dcf\u0d9a\u0d9a\u0daf\u0dc1 \u0dad\u0dca\u0d9a\u0dca\u0daf\u0dbd\u0dcf\u0d82\u0dcf\u0dcf\u0dc0 \u0daf\u0d85\u0dc0\u0dc1\u0dba\u0dd3\u0dba\u200d\u0daf\u0d9a\u0dc0\u0db1\u0dca\u0d9a\u0db1\u0dca\u0daf\u0d87\u0dba\u0dd2 \u0daf\u0dd2 \u0db4\u0dd4\u0daf\u0da2 \u0dcf\u0db0\u0dd2\u0dc1\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0d9a\u0d9a\u0daf\u0dc0\u0dc3\u0db4\u0dca\u200d\u0dbb:\u0dcf\u0daf\u0daf\u0dcf\u0dda\u0dc1\u0dcf\u0dbd\u0dca\u0daf\u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0daf\u0daf\u0d85\u0dc0\u0dc1\u0dba\u0dd3\u0dba\u200d\u0daf\u0d9a\u0dc0\u0db1\u0dca\u0d9a\u0db1\u0dca\u0daf\u0d87\u0dba\u0dd2\u0daf\u0d9a\u0dd2\u0db4 \u0daf\u0dbb\u0dcf\u0dc3\u0daf\n\n\u0d9a\u0daf\u0dc0\u0dd0\u0db1\u0dd2\u0daf\u0dcf\u0dcf\u0dc3\u0dab\u0db4\u0daf\u0dad\u0dca\u0db8\u0dba\u0dd2 \u0daf\u0d9a \u0daf\u0dc3\u0d9a\u0da8\u0dcf\u0daf\u0da2 \u0dcf\u0db0\u0dd2\u0dc1\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0daf\u0dc4\u0dd0\u0dc3\u0dd2\u0dbb\u0dd2\u0dbd\u0dcf\u0daf\u0dad\u0dd2\u0d9a\u0db6 \u0daf\u0d86\u0dcf\u0dcf\u0dc3\u0db4\u0daf\u0dc4\u0dcf\u0daf\u0dad\u0dc0\u0dd4\u0db1\u0dca\u0d9a\u0d9a\u0daf\u0db1\u0dd2\u0dbd\u0daf\u0db6\u0dbd\u0dad\u0dca\u0dbd\u0daf\u0dc1\u0dcf\u0dd2\u0dc1\u0da0\u0dca\u0da0\u0dd2\u0daf\u0dcf\u0dc5\u0daf\u0d86\u0dcf\u0dcf\u0dc3\u0db4\u0dc3\u0daf\u0da2 \u0dcf\u0db0\u0dd2\u0dc1\u0dad\u0dd2\u0dc0\u0dc3\u0db4\u0dcf\u0daf\u0dad\u0dca\u0db8\u0dba\u0dd2\u0daf\u0dcf\u0dd0\u0db6\u0dd2 \u0da8\u0dcf\u0daf\u0db8\u0dab\u0dca\u0da9\u0dbd\u0d9a\u0d85\u0daf\u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0dd2\u0db4\u0dcf\u0daf\u0d9a\u0dc0\u0db1\u0dca\u0d9a\u0db1\u0dca;\u0dafCabinet \u0dbb\u0dcf\u0dafhead \u0dcf\u0dc3\u0db1\u0dca\u0d9a\u0db1\u0dca\u0daf\u0da2 \u0dcf\u0db0\u0dd2\u0dc1\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dc3\u0daf\u0d85\u0d9a\u0dda\u0daf\u0dc3\u0d9a\u0da8\u0dcf\u0daf\u0d89\u0dad\u0dd2\u0dc4\u0dcf:\u0d9a\u0d85\u0daf\u0d85\u0dc0:\u0dc0\u0dae\u0dcf\u0daf\u0d9a\u0daf\u0dcf\u0dcf\u0daf\u0dd3\u0daf\u0d9a\u200d\u0dbb\u0dda\u0dc2\u0dc0\u0dc3\u0dcf\u0db0\u0dd2\u0dcf\u0dc3\u0dab\u0db4\u0daf\u0dd2\u0dc1\u0dc3\u0dd2\u0db1\u0dca\u0daf \u0da9\u0dd4\u0daf\u0dad\u0dd3\u0db1\u0dca\u0dbd\u0dca\u0daf\u0d9a\u0daf\u0dcf\u0d9a\u0dca\u0daf\u0dbd\u0db6\u0dcf\u0daf\u0daf\u0dd3\u0daf\u0dad\u0dd2\u0d9a\u0db6 \u0dc0\u0dcf \u0daf\u0da2 \u0dcf\u0db0\u0dd2\u0dc1\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0d9a\u0d9a\u0daf\u0db6\u0dbd\u0db4\u0daf\u0dc1\u0dcf\u0dd2\u0dc1\u0da0\u0dca\u0da0\u0dd2\u0daf\u0dcf\u0dc3\u0db8\u0dd2\u0db1\u0dca\u0daf\u0dad\u0dca\u0db8\u0db1\u0dca \u0db8\u0daf\u0dc0\u0dcf\u0dc3\u0dd2:\u0dc4 \u0dad\u0dca\u0daf\u0dc0 \u0daf\u0d86\u0dcf\u0dcf\u0dc3\u0d9a\u0d85\u0daf\u0dad\u0dd3\u0dc3\u0dab\u0daf\u0dbd\u0db6\u0dcf\u0daf \u0dd0\u0dad\u0dd2\u0db8\u0daf: \u0db6\u0db1\u0dca\u0db0\u0dc0\u0dc3\u0daf\u0dd2\u0dc1\u0d9a\u0dc1\u0dba\u0dd3\u0dba\u0dda\u0dc2\u0d9a\u0db4\u0db1\u0dca\u0db8\u0daf\u0dd2\u0dc1\u200d\u0dbb\u0dcf\u0db8\u0daf\u0db4\u0dd1\u0d9a\u0db8\u0db1\u0dca\u0daf\u0dc1\u0dc3\u0dd4\u0daf\u0db1\u0dd2\u0dbd\u0daf\u0db1\u0dd2\u0dc0\u0dcf:\u0daf\u0dbd\u0db6\u0dcf\u0daf \u0dd0\u0dad\u0dd2\u0db8\u0daf: \u0db6\u0db1\u0dca\u0db0\u0d9a\u0db4\u0db1\u0dca\u0daf\u0dad\u0dc0\u0dd4\u0db1\u0dca\u0daf \u0db1\u0dca \u0dcf\u0daf\u0dad\u0dd3\u0dc3\u0dab\u0daf: \u0db6\u0db1\u0dca\u0db0\u0dc0\u0daf\u0d85\u0dc0:\u0dc0\u0dae\u0dcf\u0daf\u0d9a\u0daf\u0dcf\u0dcf\u0daf\u0dd3\u0daf\u0d9a\u200d\u0dbb\u0dda\u0dc2\u0dc0\u0dc3\u0dcf\u0db0\u0dd2\u0dcf\u0dc3\u0dab\u0db4\u0daf\u0dd2\u0dc1\u0dc3\u0dd2\u0db1\u0dca\u0daf\u0dad\u0dd3\u0db1\u0dca\u0dbd\u0dca\u0daf\u0dbd\u0db6\u0dcf\u0daf\u0daf\u0dd3\u0daf\u0dad\u0dd2\u0d9a\u0db6 \u0dc0\u0dcf\u0dc3\u0daf\u0dbb\u0dcf\u0daf\u0dad\u0dd3\u0db1\u0dca\u0dbd\u0dca\u0dc0\u0d9a\u0dca\u0daf\u0db8\u0dd1\u0dad\u0dca\u0daf\u0dcf\u0dcf\u0dbd\u0d9a\u0d85\u0daf\u0dd3\u0dad\u0dca\u0daf\u0dbd\u0db6\u0dcf\u0daf\u0dbd\u0dca\u0db1\u0dca \u0dcf\u0dc3\u0daf\u0d92\u0daf\u0dad\u0dca\u0db8\u0dba\u0dd2 \u0daf\u0db1\u0db8\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc1\u0dcf\u0dbd\u0daf\u0dc3\u0dd2\u0dbb\u0dd2\u0d9a:\u0dda \u0daf\u0dd2 \u0db4\u0dd4\u0daf\u0da2 \u0dcf\u0db0\u0dd2\u0dc1\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0daf\u0dd2\u0dc1\u0dc3\u0dd2\u0db1\u0dca\u0daf\u0d9a\u0dc0\u0db1\u0dca\u0daf\u0dcf\u0dc3\u0daf \u0dad\u0dca\u0daf\u0db1\u0dd2\u0dbd\u0daf\u0db1\u0dd2\u0dc0\u0dcf:\u0db4\u0d9a\u0dca\u0daf: \u0db6\u0db1\u0dca\u0db0\u0daf\u0daf\u0dbd\u0db6\u0dcf\u0daf\u0dbd\u0dca\u0db1\u0dca\u0daf\u0dad\u0dd3\u0db1\u0dca\u0dbd\u0dca\u0dc0\u0dc3\u0daf\u0d9a\u0db6\u0dca\u0d9a\u0dc4\u0dca\u0db8\u0daf\u0dc1\u0dd0\u0dc4\u0dd0\u0daf\u0dbd\u0dd2\u0dc0\u0daf\u0d9a\u200d\u0dbb\u0dda\u0dc2\u0dc0\u0dc3\u0dcf\u0db0\u0dd2\u0dcf\u0dc3\u0dab\u0db4\u0daf\u0dd2\u0dc1\u0dc3\u0dd2\u0db1\u0dca\u0daf\u0d9a \u0daf\u0dcf\u0dcf\u0dc3\u0dab\u0db4\u0daf\u0dd2\u0dc1\u0db8:\u0dcf\u0daf\u0db6\u0dbd\u0dcf\u0daf\u0dad\u0dca\u0db8\u0dba\u0dd2\u0daf\u0d92\u0daf\u0dad\u0dd3\u0db1\u0dca\u0dbd\u0dca\u0dc0\u0daf\u0dbd\u0db6\u0dcf\u0daf\u0dbd\u0dca\u0db1\u0dca\u0d9a\u0db1\u0dca\u0dc3\u0daf\u0da2 \u0dcf\u0db0\u0dd2\u0dc1\u0dad\u0dd2\u0dc0\u0dc3\u0d9a\u0db4\u0db1\u0db8 \u0daf\u0dbd\u0dd0\u0db6\u0dd2\u0db4\u0daf\u0dad\u0dd4\u0dad\u0dd4\u0daf\u0db1\u0dd2\u0dc0:\u0daf\u0d9a\u0db8\u0dca \u0daf\u0dc0\u0dcf\u0d9a\u0d9a\u0daf\u0dbb\u0dcf\u0d9a\u0dca\u0daf\u0dd2\u0dc1\u0db4\u0daf\u0dad\u0dd4\u0dad\u0dd4\u0daf \u0daf\u0d92\u0dcf \u0daf\u0db4 \u0d9a\u0dd2\u0dc3\u0dd2\u0daf:\u0dcf\u0db0\u0dcf\u0dc3\u0dab\u0dad\u0dca\u0dc0\u0db4\u0d9a\u0dca\u0daf\u0dad\u0dd2\u0db6\u0dd2\u0db4\u0daf\u0dad\u0dd4\u0dad\u0dd4\u0dba\u0dd2 \u0daf\u0d92\u0dcf\u0dafreasonable \u0d9a\u0dc0\u0db1\u0dca \u0daf\u0d95 \u0dd1\u0daf\u0db4 \u0dcf\u0daf\u0dd3\u0daf\u0dc0\u0dc1\u0dba\u0dd3\u0dba\u0d9a\u0db4\u0db1\u0dca\u0daf\u0dbb\u0db8\u0daf\u0dad\u0dd3\u0db1\u0dca\u0dbd\u0dca\u0d9a\u0dda\u0daf:\u0db3\u0dc4\u0db1\u0dca\u0daf\u0dc0 \u0dc0\u0dcf\u0dc3\u0daf\u0d92\u0daf\u0db1\u0dd2:\u0dcf\u0daf\u0dad\u0dca\u0db8\u0db1\u0dca \u0daf\u0dd2 \u0dad\u0dd4\u0dab\u0dd4\u0daf\u0dd2 \u0dad\u0dd4\u0dab\u0dd4\u0daf\u0dd2\u0dc1\u0db0\u0dd2\u0db4 \u0daf\u0dad\u0dd3\u0dc3\u0dab\u0daf\u0d85\u0dc3\u0d9a \u0daf\u0db1\u0dd2\u0dbd\u0daf\u0db1\u0dd2\u0dc0\u0dcf:\u0daf\u0d9a\u0dc0\u0db1\u0dca\u0dcf\u0dc3\u0daf \u0dd0\u0dad\u0dd2\u0db8 \u0daf\u0dc4\u0dd0\u0d9a\u0dd2\u0db4\u0dcf\u0dc0\u0d9a\u0dca\u0daf \u0dd0\u0dc4\u0dd0\u0dc3\u0daf\u0d92\u0d9a\u0dcf\u0daf\u0daf\u0dd2\u0dc1\u0d9a\u0dc1\u0dba\u0dd3\u0dba\u0dda\u0dc2\u0d9a\u0db4\u0db1\u0dca\u0db8\u0daf\u0d9a:\u0dca\u0db4\u0dcf\u0daf\u0db6\u0dbd \u0daf\u0d9a\u0daf\u0db4\u0d9a\u0dca\u0daf\u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf\u0dc3\u0daf"
