    "chunk_text": "2026 \u0dd2\u0dbd\u0dc3\u0dbb\u0dca\u0dbd\u0da2\u0dca\u200d\u0db1 \u0db4\u0db1\u0dc3 \u0d9c\u0d9a\u0dd4\u0dc0\u0dda\u0db4\u0d9c\u0dc3 \u0da2\u0dca\u200d\u0db1\u0dcf\u0d9a\u0dcf\u0db4\u0dad\u0dd2 \u0dc0\u0dd0\u0dba \u0dc1\u0dd3\u0dbb\u0dca\u0dbd\u0dc2\u0d9c\u0dc1 \u0d85\u0d9c,\u0dba \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dca \u0dd2\u0da7\u0dd2\u0dba\u0db1 11\u0d8b385\u0dba\u0dd20 \u0dbb\u0db8 \u0d85\u0d9c,\u0dba 0204 \u0dc3\u0dc4 0205 \u0dc0\u0dbb\u0dca\u0dbd\u0dc2 \u0dc3\u0db8\u0d9f \u0dc0\u0dd0\u0dbb\u0dd2\u0db1 \u0dd2\u0dbd\u0d9a\u0dcf\u0dba\u0dad \u0dc3\u0d82\u0dc3\u0db1\u0dca\u0dad:\u0db1\u0dba \u0d9a\u0dcf\u0dcf0 \u0d92\u0d9a\u0dad \u0d9c\u0dc4\u0dca\u0dad\u0dd4\u0dc0\u0d8b 0205 \u0dc0\u0dc3\u0dbb\u0dad \u0dd2\u0dbd\u0dc3\u0dbb\u0dca\u0dbd\u0da2\u0dca\u200d\u0db1 \u0db4\u0db1\u0dc3 \u0d9c\u0d9a\u0dd4\u0dc0\u0dda\u0db4\u0dad \u0d89\u0dd2\u0db1\u0dd2\u0db4\u0db4\u0dc3 \u0d9a\u0dbb\u0db1\u0d9c\u0d9a\u0dcf\u0dad \u0d85\u0dd2\u0dc5 \u0d9c\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0d9c\u0dcf\u0dca \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 009\u0dca0 \u0db1\u0db8\u0dd4\u0dc3\u0d8b \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0d9c\u0dba \u0da2\u0dca\u200d\u0db1\u0dcf \u0db8\u0d9f\u0dd2\u0db1\u0dca\u0dad \u0d92\u0d9a\u0dad \u0dad\u0dc0\u0dc3 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 601\u0dca \u0dbb\u0d9a\u0dad\u0dd4 \u0d9c\u0dc0\u0daf\u0dcf \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 9\u0dca \u0dc0\u0dd4\u0dab\u0dba\u0dcf0 \u0dca\u0dc3\u0dad\u0dad\u0db8 \u0da2\u0dca\u200d\u0db1\u0dcf\u0d9a\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0d9c\u0dda \u0dc0\u0dd0\u0dba \u0dc1\u0dd3\u0dbb\u0dca\u0dbd\u0dc2\u0dba \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0dca\u200d\u0d9c\u0dba\u0db1\u0dd4\u0dba\u0dd2\n\n\u0d8a\u0dcf\u0d9f\u0dad\u0d8b \u0dab\u0dba\u0dba \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0dca\u200d\u0dc0\u0dc3 \u0dc0\u0dd0\u0dbb\u0dd2\u0db1 :\u0dc3\u0dad \u0d9c\u0d9c,\u0dcf\u0da9\u0dca \u0d89\u0dd2\u0db1\u0dd2\u0db4\u0db4\u0dc3 \u0d9a\u0dcf\u0dcf0 \u0d85\u0dd2\u0dc5 \u0dd2\u0dbb\u0dd2\u0dc0\u0db8 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a\u0dd3 \u0dd2\u0dbb\u0dba\u0daf\u0dcf \u0db1\u0dd0\u0dc4\u0dd0\u0d8b \u0dab\u0dba\u0dba \u0d9c,\u0db1\u0dca\u0dad\u0db1 \u0dbb\u0db4\u0dcf \u0dd2\u0dbb\u0dba\u0daf\u0dcf0 \u0dab\u0dba\u0dba \u0d85\u0db4\u0dad \u0d85\u0dc0\u0d9a\u0dba\u0dba\u0dd20 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2\u0d8b \u0dc0\u0dd0\u0dbb\u0dd2\u0db1 \u0dd2\u0dbd\u0d9a\u0dcf\u0dba\u0dad \u0dab\u0dba\u0dba \u0d9c,\u0dc3\u0d9c\u0dad\u0dcf\u0dc3 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dca\u0db1\u0dba\u0d9a\u0dad \u0db8\u0dd4\u0dc4\u0dd4\u0dab\u0dba \u0d9c:\u0db1\u0dca\u0dad\u0db1 \u0dd2\u0dc0\u0dda\u0dca\u200d \u0d9c\u0dc0\u0db1\u0dc0\u0dcf0 \u0d85\u0dd2\u0dc5 \u0d9a\u0dc0:\u0dcf\u0dc0\u0dc3 highways \u0dc0\u0dd0\u0db1\u0dd2 \u0db8\u0dc4\u0dcf \u0dc0\u0dba\u0dcf\u0db4\u0dca\u0dad\u0dd2 \u0dbb\u0db4\u0dcf \u0dd2\u0dbb\u0dba\u0daf\u0dcf \u0db1\u0dd0\u0dc4\u0dd00 \u0d92\u0dc0\u0dcf \u0d95\u0db1\u0dd10 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0dca\u0da9\u0dd4\u0d9a\u0da9\u0dd4\u0dc0\u0dca \u0d9a\u0dbb\u0db1\u0d9c\u0d9a\u0dcf\u0dad \u0d92 \u0dca\u0da9\u0dd4\u0d9a\u0da9\u0dd4 \u0db6\u0daf\u0dba :\u0dbb\u0db1 \u0d85\u0dba\u0dad \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0d8b \u0d92 \u0db6\u0daf\u0dba \u0db4\u0dcf\u0dd2\u0dbd\u0da0\u0dca\u0da0\u0da0\u0dd2 \u0d9a\u0dbb\u0daf\u0dcf \u0d9c\u0dda \u0dc0\u0dba\u0dcf\u0db4\u0dca\u0dad\u0dd2 \u0dad\u0db8\u0db1\u0dca\u0dad\u0d9c\u0dda \u0d9c\u0db4\u0dde\u0dda\u0d9c,\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0daf\u0dcf\u0dcf \u0d9c\u0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0db4\u0dcf\u0dd2\u0dbd\u0da0\u0dca\u0da0\u0da0\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db10 \u0d92\u0d8b \u0dab\u0dba\u0dba \u0d9c,\u0dd0\u0dd3\u0db8\u0dda\u0d8b \u0db8\u0dc4\u0dcf \u0db4\u0dd2\u0db4\u0db8\u0dcf\u0dab\u0dba \u0dc0\u0dba\u0dcf\u0db4\u0dca\u0dad\u0dd2 \u0dca\u0dd2\u0db1\u0dba0 \u0d85\u0dd2\u0dc5 \u0dbb\u0d9c\u0dc4\u0db8 \u0db1\u0dd2\u0dbb\u0d9c\u0dca \u0dca\u0dc2\u0dc0 \u0d9c\u0dda \u0d9c\u0dda\u0dc0\u0dca \u0dc0\u0daf\u0dad \u0dd2\u0dbd\u0dbb\u0dd4\u0dda\u0dca\u200d \u0d9c\u0dc0\u0daf\u0dcf \u0db1\u0dd0\u0dc4\u0dd00 \u0dc3\u0dcf\u0d9c\u0dca \u0dca\u0dc2\u0dc0 \u0db6\u0dd0\u0dbd\u0dd4\u0d9c\u0dc0\u0dcf\u0dc3\u0d8b \u0dc4\u0dd0\u0db8 \u0dad\u0dd2\u0dc3\u0dca\u0d9c\u0dc3\u0dca\u0db8 \u0d92\u0d9c\u0d9c,\u0dcf\u0dca \u0daf\u0db1\u0dca\u0dad \u0dab\u0dba\u0dba \u0d9c,\u0dc3\u0d9c\u0dc3\u0dc3\u0d8b \u0dc0\u0dba\u0dcf\u0db4\u0dca\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc3\u0db8\u0d9a \u0d9a\u0d9c\u0dcf\u0dca\u0dc3 \u0d9c\u0db8\u0db1\u0dca\u0dad\u0db1 \u0d9c\u0dda \u0dbb\u0dad \u0dc4:\u0db1 \u0dc3\u0db8\u0dcf\u0da2\u0dca\u200d \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0dbd\u0dca\u200d\u0db1 \u0dd6\u0dbd\u0daf\u0dca\u200d\u0dbb\u0dca\u0dbd\u0db8 \u0dc3\u0dc4 \u0db8\u0dc4\u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0d9c\u0dda \u0dca\u0dca \u0d9c\u0db8\u0db1\u0dca\u0dad \u0dd2\u0dc5\u0dad \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0daf\u0dcf0 \u0d92\u0d9a\u0dad\u0dba\u0dd2 \u0d85\u0dd2\u0dc5 \u0dd2\u0dbd\u0dbb\u0dd4\u0dda\u0dca\u200d \u0d9c\u0dc0\u0daf\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad0 \u0dbb\u0d9c\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0d85\u0dd2\u0dc5 \u0dd2\u0dbb\u0dd2\u0dc0\u0db8 \u0dca\u0d9a\u0dcf\u0dbb\u0dba\u0dd2\u0dbb\u0db1\u0dca\u0dad \u0d9c\u0dda \u0d9c\u0dda\u0dc0\u0dca \u0dc0\u0daf\u0dad \u0dd2\u0dbd\u0dbb\u0dd4\u0dda\u0dca\u200d \u0d9c\u0dc0\u0daf\u0dcf \u0db1\u0dd0\u0dc4\u0dd00\n\n\u0dd6\u0dbd\u0daf\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa\u0dad\u0dca \u0d9c,\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2\u0d8b \u0d9c\u0dda \u0dab\u0dba\u0dba \u0dd2\u0dc5\u0dd2\u0db6\u0db6 \u0dc0 :\u0dd0\u0db1\u0dca\u0dad \u0dd2\u0da7\u0dae\u0dba\u0dcf\u0dc0\u0d9a\u0dd4\u0dc3 \u0dc4:\u0db1\u0dc0\u0dcf0 \u0d9c\u0db8\u0dcf\u0d9a:\u0d8b \u0d85\u0db4\u0dad :\u0dd0\u0db1\u0dca\u0dad \u0dbb\u0dcf\u0db8\u0dd4\u0dc0\u0dca \u0dca\u0dad\u0dd4\u0d9c\u0dcf\u0dca \u0dab\u0dba\u0dba \u0d9a\u0dcf\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba\u0dba \u0d9a\u0dbb \u0d9c,\u0db1\u0dca\u0dad\u0db1 \u0d9c\u0dc0\u0db1\u0dc0\u0dcf0 \u0dab\u0dba\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0d9c\u0dc0\u0daf\u0dcf\u0d8b \u0dc0\u0dd0\u0da9\u0dd2 \u0d9c\u0dc0\u0daf\u0dcf\u0d8b \u0dc0\u0dd0\u0da9\u0dd2 \u0d9c\u0dc0\u0daf\u0dcf \u0dd2\u0dbb\u0dba\u0daf\u0dcf :\u0dd0\u0db1\u0dca\u0dad \u0dd2\u0dbb\u0dba\u0db1\u0dc0\u0dcf0 \u0dca\u0dc3\u0dad\u0dad\u0db8 \u0d85\u0d9c\u0dca \u0dca\u0da9\u0dd4\u0d9a\u0da9\u0dd4\u0dc0 \u0dba\u0dad\u0d9c\u0dc3\u0dd3 \u0dab\u0dba\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0d9c\u0dc0\u0daf\u0dcf \u0db1\u0dd0\u0dc4\u0dd00 \u0dab\u0dba\u0dba \u0d9a\u0dcf\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba\u0dba \u0d9c\u0dc0\u0daf\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf0 \u0d85\u0db4\u0dad \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0dbb\u0dcf\u0db8\u0dd4\u0dc0\u0dad - frame \u0dbb\u0d9a\u0dad - \u0d85\u0db1\u0dd4\u0dc0 0230\u0dd3 \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0dab\u0dba\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dba :\u0dcf \u0d9c\u0dda\u0dc1\u0dd3\u0dba \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0dd2\u0db1\u0dad\u0d9c\u0dba\u0db1\u0dca\u0dad \u0dd2\u0dc0\u0dba\u0dba\u0dad 95\u0dad \u0dc0\u0da9\u0dcf \u0d85\u0da9\u0dd4 \u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0dd2\u0dbb\u0dba\u0db1 \u0dbb\u0d9a\u0dad \u0d85\u0dd2\u0dc5 \u0dba\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd10 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2\u0d8b \u0d85\u0dd2\u0dc5 :\u0dd0\u0db1\u0dca\u0dad \u0dab\u0dba\u0dba \u0d9a\u0dcf\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba\u0dba \u0d9a\u0dbb\u0daf\u0dcf \u0d92 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dba \u0dd2\u0dc0\u0dba\u0dba\u0dad 92\u0d9a\u0dad \u0dc0\u0da9\u0dcf \u0db4\u0dc4\u0dcf \u0db8\u0dda\u0dad\u0db8\u0d9a\u0dad \u0d9c\u0d9c,\u0db1\u0dd0\u0dca \u0daf\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf0"
