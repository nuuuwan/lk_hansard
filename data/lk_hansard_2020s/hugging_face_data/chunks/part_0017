\u0d82\u0d9a\u0dd3\u0dbb\u0dca\u0dab\u0db4\u0d9a\u0dca\u0daf:\u0dd2 \u0dad\u0dca\u0daf:\u0dc0\u0dae\u0dcf \u0db4\u0d9a\u0dd2\u0dc3\u0daf\u0d9a\u0db8\u0db8\u0daf\u0d89\u0da9\u0db8\u0daf\u0dc3\u0da2\u0db4\u0daf:\u0dad\u0dd4\u0d9a\u0dda\u0dc3\n\n\u0dda\u0dad\u0dd4\u0dbb\u0dd4\u0daf\u0dc1\u0dc5\u0dcf\u0d9a\u0dad\u0dca \u0daf\u0db8\u0dd4\u0dbd\u0dad\u0dd2\u0dda\u0daf\u0daf:\u0dc0\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dcf\u0d9a\u0d85 \u0daf\u0db8\u0dd4\u0dc4\u0dd4\u0dbd\u0dca\u0db6\u0da9\u0dc1\u0dad\u0dca\u0dad\u0dd4\u0daf\n\n\u0dbb\u0dd4\u0daf\u0dcf\u0dae\u0dcf \u0dcf\u0db4\u0dcf\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0daf\u0daf\u0dc5\u0daf\u0dc0\u0dc1\u0dba\u0dd3\u0dba\u0d9a\u0db4\u0db1\u0dca\u0daf\u0d9a\u0dd2\u0dda\u0d9a\u0dc0\u0dca\u0dad\u0dca \u0daf\n\n\u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0db4\u0dcf\u0dc0\u0daf\u0daf:\u0dc0\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dcf\u0d9a\u0d85\u0daf\u0d9a\u0dc4\u0d9a\u0dca\u0d9a \u0db4\u0dcf\u0dc3\u0daf10\u0dc379\u0dcf\u0daf\u0db4\u0dca\u200d\u0dbb\u0d9a \u0dc1\u0dba\u0dd3\u0dba\u0db4\u0d9a\u0dca \u0daf\u0db8\u0dd4\u0dbd\u0dad\u0dd2\u0dda\u0daf\u0daf:\u0dc0\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0daf\u0dcf\u0d9a\u0d85\u0daf\u0d9a\u0dc4\u0d9a\u0dca\u0d9a \u0db4\u0dcf\u0dc3\u0daf11\u0dc385\u0dcf\u0daf\u0db4\u0dca\u200d\u0dbb\u0d9a \u0dc1\u0dba\u0dd3\u0dba\u0db4\u0d9a\u0dca\u0daf:\u0dc4\u0daf\u0db8\u0dd4\u0dbd\u0dad\u0dd2\u0dda\u0daf\u0daf:\u0dc0\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dcf\u0d9a\u0d85\u0daf\u0d9a\u0dc4\u0d9a\u0dca\u0d9a \u0db4\u0dcf\u0dc3\u0daf14\u0dc397\u0dcf\u0daf\u0db4\u0dca\u200d\u0dbb\u0d9a \u0dc1\u0dba\u0dd3\u0dba\u0daf\u0d9a\u0daf\u0dcf\u0d9a\u0dca\u0daf\u0db4\u0dd4\u0dc3\u0dcf\u0dd2\u0dc1\u0daf\u200d\u0dcf\u0daf\u0d9a\u0daf\u0dc1\u0dcf\u0dbb\u0dca\u0dad\u0dca\u0d9a \u0db1\u0dca\u0dad\u0dd4\u0dc0\u0daf\u0db8\u0d9f\u0dd2\u0db1\u0dca\u0daf\u0db4\u0dd4\u0dc3\u0dcf\u0dd2\u0dc1\u0daf\u200d\u0dcf\u0daf\u0db4\u0dca\u200d\u0dbb\u0d9a \u0dc1\u0dba\u0dd3\u0dba\u0daf\u0d9a\u0dbd:\u0daf\u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dc1\u0dba\u0dd3\