    "chunk_text": "\u0d85\u0dc3\u0db4\u0dcf\u0daf\u0db4 \u0dc0\u0dcf\u0daf\u0d9a\u0dd2\u0db4\u0dbd\u0dcf\u0daf\u0dc4\u0dad\u0dca\u0dc3\u0daf\u0d9a\u0daf\u0d9a \u0d9a\u0dca\u0daf\u0dd2 \u0d9a\u0dbb\u0dca\u0daf\u0daf\u0dcf \u0dc0\u0dcf\u0dc3\u0daf\u0d92\u0daf\u0db8\u0dd2\u0db1\u0dd2:\u0dc0\u0dc3\u0dd4\u0daf\u0d86\u0dc1\u0dc4\u0dd4\u0daf:\u0dad\u0dd2\u0daf\u0d9a\u0daf\u0dcf\u0d9a\u0dd2\u0db1\u0dca\u0daf\u0dbb\u0dc5\u0dd2\u0db4 \u0daf\u0dbb \u0dc0\u0dcf\u0dc3\u0daf\u0dad\u0dca\u0dc0\u0dad\u0dca\u0daf\u0dc4\u0dad\u0dca\u0dc3\u0daf\u0d9a\u0daf\u0d9a \u0d9a\u0dca\u0daf\u0daf\u0dcf \u0dc0\u0dcf\u0dc3\u0daf\u0dad\u0dca\u0db8\u0dd4\u0db1\u0dca \u0dcf\u0db1\u0dca\u0d9a:\u0dda\u0dbd\u0dcf\u0daf\u0dbb\u0dcf\u0daf\u0dbb\u0dcf\u0daf\u0db8\u0dd2\u0db1\u0dd2:\u0dc0\u0dc3\u0dd4\u0daf\u0dd2 \u0d9a\u0dbb\u0dca\u0daf\u0daf\u0dcf\u0dbd\u0dcf\u0daf:\u0db1\u0dca\u0d9a\u0dad\u0dca\u0ddd\u0dc2\u0daf\u0d9a\u0dc0\u0dbd\u0dcf\u0dafFacebook \u0dbb\u0d9a\u0d9a\u0dca\u0daf\u0daf\u0dcf \u0dc0\u0dcf \u0daf\u0daf\u0d85\u0dbb\u0dd6\u0daf\u0dd2 \u0d9a\u0dbb\u0dca \u0daf\u0db8\u0dd6\u0daf\u0dd2 \u0daf\u0d9a\u0dbb\u0dca \u0daf\u0d85\u0dbb\u0dd6\u0daf\u0d9a\u0dc4\u0dca\u0dc3\u0dcf\u0daf\u0db8\u0dd6\u0daf\u0d9a\u0dc4\u0dca\u0dc3\u0dcf\u0daf\u0daf\u0d9a\u0dd2\u0db4\u0dbd\u0dcf\u0dc3\u0daf\u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0daf\u0d9a\u0db8\u0dca\u0dcf\u0d9a\u0dca\u0daf\u0daf\u0dc3 \u0daf\u0d9a\u0dc0\u0dbd\u0dcf\u0daf\u0dad\u0dd2\u0d9a\u0db6\u0db1\u0dca\u0d9a\u0db1\u0dca \u0daf\n\n\u0dbb\u0dd4\u0daf\u0db1\u0dd2\u0d9a\u0db4\u0ddd\u0da2\u200d\u0daf\u0dcf\u0dae\u0dcf \u0dcf\u0db4\u0dcf\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0daf\u0db8\u0db8\u0daf\u0d9a \u0dcf\u0dad\u0dca\u0daf\u0d85\u0dc4\u0db1\u0dca \u0daf\u0dcf\u0dd0\u0db8\u0dad\u0dd2\u0dba\u0dd2\u0dc3\u0daf\u0db8\u0db8\u0daf\u0daf \u0db8\u0daf\u0d9a \u0daf\u0dcf\u0db1\u0dca\u0d9a\u0da8\u0dcf \u0dbb\u0dca\u0daf \u0dd0 \u0daf\u0d87\u0dc4\u0dd4\u0dc0\u0dcf\u0dc3\u0daf\u0d85\u0db4\u0dd2\u0daf\u0d9a\u0dd2\u0dda\u0dc0\u0dcf\u0daf\u0dcf\u0dbb\u0dd4\u0dab\u0dcf\u0dcf\u0