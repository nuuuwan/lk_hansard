    "chunk_text": "\u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2 \u0daf\u0dd2\u0dc3\u0dae\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0d9c \u0d9c\u0db8\u0dca \u0db1\u0dcf \u0dcf\u0db8\u0dca\u0dc0\u0dbd\u0da7 \u0dbd\u0d9a\u0dca \u0d9c\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0d9c\u0db1\u0dca \u0dad\u0db1\u0dd2 \u0dad\u0db1\u0dd2 \u0db4\u0dc0\u0dd4\u0dca \u0d9c\u0db1\u0dcf\u0d9c\u0dc0\u0dba\u0dd2 \u0dba\u0db8\u0dca\u0db8\u0dcf\u0db1 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7\u0dba\u0dd2. \u0d91\u0d9a\u0dca\u0d9c\u0d9a\u0ddd \u0dbd\u0dba\u0dd2\u0db1\u0dca \u0d9a\u0dcf\u0db8\u0dbb \u0dc0\u0dd2\u0db0\u0dd2 \u0da7\u0dba\u0dd2. \u0d91\u0d9a \u0dbd\u0dba\u0dd2\u0db1\u0dca \u0d9a\u0dcf\u0db8\u0dbb \u0d9c\u0dca\u0dc5\u0dd2 \u0d9a \u0db4\u0dc0\u0dd4\u0dca 50\u0d9a\u0dca 60\u0d9a\u0dca \u0da2\u0dd3\u0dc0\u0dad\u0dca\u0dad \u0d9c\u0dc0\u0db1\u0dc0\u0dcf. \u0d91\u0dad\u0d9c\u0d9a\u0dcf\u0da7 \u0d91 \u0dc3\u0dcf\u0d9b\u0dba\u0dcf\u0dc0 \u0d85\u0dad\u0dd2\u0db1\u0dca \u0d9a\u0dd4\u0da9\u0dcf \u0dc0\u0dd4\u0dab\u0dcf\u0da7 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab \u0d85\u0dad\u0dd2\u0db1\u0dca \u0d85\u0dad\u0dd2\u0dc0\u0dd2\u0db1\u0dcf\u0dbd\u0dba\u0dd2. \u0dc0\u0dd2\u0db1\u0dcf\u0dbd \u0db4\u0dbb\u0dcf\u0dc3 \u0d9a\u0dca \u0dad\u0dd4\u0dc5 \u0d9c\u0db8\u0dca \u0dc0\u0dd2\u0db1\u0dcf\u0db1 \u0db4\u0dd0\u0dad\u0dd2\u0d9c\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0d91\u0d9a \u0db4\u0dd0\u0dad\u0dca\u0dad\u0dad\u0d9a\u0dd2\u0db1\u0dca \u0d85\u0daf \u0dc3\u0dad\u0dd4\u0da7\u0dd4 \u0d9c\u0dc0\u0db1\u0dc0\u0dcf \u0d9c\u0db8\u0dca \u0dca \u0dad\u0db1 \u0db4\u0db1\u0dad\u0d9a\u0dca \u0dc4\u0dbb\u0dc4\u0dcf \u0dc3\u0dae\u0dae\u0dcf\u0db4\u0dd2\u0dad \u0d9a\u0dbb\u0dbd\u0dcf \u0dc3\u0dae\u0dae\u0dcf\u0dc0\u0dbb \u0d9a\u0dbb\u0dbd\u0dcf \u0dbb\u0d9c\u0da7\u0dca\u0da7 \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0db6\u0dd2\u0d9c \u0db1\u0dca \u0dc3\u0dd0\u0d9a\u0d9c \u0db1\u0dca \u0d9c\u0dad\u0dcf\u0dbb \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0d9c\u0daf\u0db1\u0dca\u0db1 \u0d85\u0daf\u0dcf\u0dc5 \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca\u0dad\u0dd3\u0db8 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9c\u0db8\u0dca \u0dca \u0dad\u0db1 \u0da7 \u0db1\u0d9a\u0dca\u0dad\u0dd2 \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0d9c \u0db1\u0dca.\n\n\u0db6\u0db6\u0da7 \u0db8\u0dad\u0d9a \u0db1\u0db8\u0dca \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0d9c \u0d9c\u0d9a\u0db3\u0dd2\u0dbb\u0dd2\u0dba\u0dcf\u0db1 \u0d9c\u0db8\u0dca \u0dc3\u0db8\u0dc4\u0dbb \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0d9c\u0dd2 \u0daf\u0dc0\u0dc3\u0dae\u0dc0\u0dbd \u0d9c\u0d9a\u0db3\u0dd2\u0dbb\u0dd2 \u0dba\u0dba\u0dcf \u0d85\u0dac\u0db1\u0dca\u0db1 \u0d91\u0d9a\u0dca \u0d9c\u0dc4\u0dae\u0dad\u0dd4\u0dc0\u0d9a\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb \u0db1\u0dca\u0d9c\u0dda \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca (\u0d89\u0dc0\u0dad\u0dca\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0d9c\u0db8\u0dca) \u0db4\u0db1\u0dad\u0dca\u0dad\n\n\u0d9c\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad \u0d9c\u0db8\u0dca \u0db4\u0dcf\u0dca\u0dd2\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0d9c\u0dc1 \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8. \u0d85\u0db4\u0dd2 \u0d9c\u0db8\u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0d9c\u0dc5\u0dae \u0d9a\u0dd2 \u0dbd\u0dcf \u0d85\u0dc4\u0db1\u0dc0\u0dcf \u0d9c\u0db1\u0dca. \u0db6\u0db1\u0dca\u0db1 \u0d9a\u0dbb\u0db4\u0dd4 \u0d92\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0dc3\u0dd6\u0daf\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0db1\u0dd2 \u0dcf\u0db8\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2 \u0db4\u0db1\u0dad\u0dca\u0dad \u0d9c\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad \u0d9c\u0dba\u0db1\u0dcf\u0dc0\u0dcf; \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dc5\u0dcf. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0db1 \u0d91\u0db1 \u0db8\u0dcf \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0d89\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2 \u0d9c\u0db8\u0dca \u0d9c\u0db8\u0dcf\u0d9c\u0dc4\u0dcf\u0d9c\u0dad\u0dca\u0dad\u0dad\u0dca\u0dad \u0d91\u0dca \u0d9c\u0dbd\u0db1\u0dca\u0db1 \u0dc4\u0daf\u0db1 \u0db6\u0dd2\u0dca \u0d9c\u0dbd\u0ddd \u0db8\u0dc0\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d9a\u0dcf \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db6\u0dbd (\u0dc3\u0dcf\u0d9c\u0db1\u0ddd\u0db0\u0db1) \u0db4\u0db1\u0dad \u0d9c\u0dba\u0db1\u0dcf\u0dc0\u0dcf. \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db6\u0dbd \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd \u0d9a\u0dd0\u0db6\u0dd0\u0dd2 \u0d9a\u0dbb\u0dbd\u0dcf \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0db1\u0dca\u0db1 \u0dc4\u0daf\u0db4\u0dd4 23 000\u0d9a\u0dca \u0d9c\u0dc3\u0dae\u0dc0\u0d9a \u0db1\u0dca\u0d9c\u0dba\u0db1\u0dca 11 000\u0d9a\u0dca \u0d91\u0dc5\u0dd2 \u0da7 \u0daf\u0dcf\u0db1\u0dca\u0db1 \u0dc4\u0daf\u0db4\u0dd4 \u0db4\u0db1\u0dad \u0d85\u0d9c\u0dc4\u0ddd\u0dd2\u0db1 \u0d9a\u0dbb\u0dbd\u0dcf \u0dc3\u0dcf\u0d9c\u0db1\u0ddd\u0db0\u0db1 21\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad\u0dc0 \u0db4\u0db1\u0dad \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dbb\u0dbd\u0dcf \u0d9c\u0dc3\u0dae\u0dc0\u0d9a \u0db1\u0dca\u0da7\u0dad\u0dca\u0dad \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0da7\u0dad\u0dca\u0dad \u0dc4\u0dd2\u0dad\u0d9a\u0dbb \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0dbb\u0d9c\u0da7\u0dca\u0da7 \u0db6\u0dbd\u0db1\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0daf\u0dd4\u0dd2 \u0db6\u0dbd \u0dd2\u0db1 \u0da7 100\u0d9a\u0dca \u0dbb\u0da2 \u0dc3\u0dad\u0dd4\u0dc0 \u0dcf\u0dcf\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba\u0dcf\u0dbb \u0dc3\u0dad\u0dd4\u0dc0 \u0dad\u0dd2 \u0dcf\u0d9c\u0dba\u0db1 \u0dc3\u0db8\u0dcf\u0dba\u0db8\u0dca \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca\u0dad \u0d9a\u0dbb\u0dbd\u0dcf \u0d92 \u0dca \u0dad\u0db1 \u0dbb\u0dd0\u0d9a \u0dba\u0db1\u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d9a\u0dcf\u0da0\u0db1\u0dbd\u0dcf\u0d9c\u0dda \u0d92 \u0dbd\u0dc0\u0da7 \u0d8b\u0db4\u200d\u0dbb\u0db8\u0dc0\u0dd2\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0d92 \u0dca \u0dad\u0db1 \u0d9c\u0db6\u0dca\u0dbd\u0dbb\u0dcf\u0d9c\u0dba\u0db1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0d85\u0db4\u0dd2 \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dc5\u0dcf 2025 \u0d85\u0dcf\u0d9a 15 \u0daf\u0dbb\u0db1 \u0dc3\u0db8\u0dd2\u0dda\u0db0\u0dd2 (\u0dc3\u0dcf\u0d9c\u0db1\u0ddd\u0db0\u0db1) \u0db4\u0db1\u0dad 2025 \u0d85\u0dcf\u0d9a 13 \u0daf\u0dbb\u0db1 \u0dc0\u0dd2\u0db1\u0dd2\u0db8 \u0db4\u0dbb (\u0dc3\u0dcf\u0d9c\u0db1\u0ddd\u0db0\u0db1) \u0db4\u0db1\u0dad 2025 \u0d85\u0dcf\u0d9a 12 \u0daf\u0dbb\u0db1 \u0dc3\u0db8\u0dcf\u0dba\u0db8\u0dca (\u0dc3\u0dcf\u0d9c\u0db1\u0ddd\u0db0\u0db1) \u0db4\u0db1\u0dad 2025 \u0d85\u0dcf\u0d9a 11 \u0daf\u0dbb\u0db1 \u0d9c\u0dc3\u0dae\u0dc0\u0d9a \u0db1\u0dca\u0d9c\u0dda \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d85\u0dc0\u0db8 \u0d9c\u0dc1\u0dad\u0db1 (\u0dc3\u0dcf\u0d9c\u0db1\u0ddd\u0db0\u0db1) \u0db4\u0db1\u0dad 2025 \u0d85\u0dcf\u0d9a 7 \u0daf\u0dbb\u0db1 \u0d85\u0db4\u0dbb\u0dcf\u0db0 \u0db1\u0dca \u0dc0\u0dd2\u0db0\u0dcf\u0db1 \u0dc3\u0dcf\u0dbb\u0dd9\u0dc4 (\u0dc3\u0dcf\u0d9c\u0db1\u0ddd\u0db0\u0db1) \u0db4\u0db1\u0dad 2025 \u0d85\u0dcf\u0d9a 5 \u0daf\u0dbb\u0db1 \u0d85\u0db4\u0dbb\u0dcf\u0db0 \u0d9a\u0dd2\u0db1\u0dca \u0d8b\u0dad\u0dca\u0dad\u0db4\u0dcf\u0daf\u0dd2\u0dad \u0d9c\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0db4\u0db1\u0dad \u0dca\u0daf\u0dd2 . \u0d92 \u0db4\u0db1\u0dad \u0d9c\u0db8\u0dca \u0d9c\u0dc0\u0dbd\u0dcf\u0d9c\u0dc1 \u0d9c\u0dba\u0dcf\u0da9\u0d9a\u0dca \u0d9c\u0dda\u0dc0\u0dca \u0db8\u0dad\u0dd4 \u0d9a\u0dbb \u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0db4\u0db1\u0dad\u0d9a\u0dca. \u0d9c\u0db8\u0dca \u0dc0\u0dcf\u0d9c\u0dda \u0db4\u0db1\u0dad\u0dca\u0dad \u0dc0\u0dd2\u0db1\u0dcf\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab \u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dbb\u0d9c\u0dba\u0db1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0db6\u0d9a\u0dca\u0d9c\u0d9a\u0ddd\u0db8 \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d9c\u0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0db1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d9a\u0d9c\u0dc5\u0dae."
