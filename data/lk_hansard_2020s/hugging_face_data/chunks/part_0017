dcf \u0dc0\u0daf02\n\n\u0d91 2\u0db1\u0dd2\u0dc3\u0dcf\u0daf2\u0daf\u0dd2\u0dc52\u0db1\u0dda2\u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc02\u0dc3\u0dcf\u0dda\u0dcf\u0db1\u0dca\u0dca\u200d\u0db1\u0d9a\u0db1\u0dca2\u0daf\u0da9\u0dda2\u0db1\u0dba\u0ddc \u0dc3\u0dcf\u0daf\u0dc0\u0dda\u0dc3\u0dcf\u0dca2\u0da2 \u0dbb\u0daf\u0db12\u0dba\u0daf\u0dca\u0dad\u0d9a\u0daf\u0dbd\u0db1\u0dda\u0daf\u0dd3\u0dca 2\u0daf\u0dd3\u0dca\u0dad\u0d9d2\u0dc0\u0dba\u0db1\u0d9a\u0db1\u0dca2\u0dc3\u0dcf\u0daf\u0dba\u0da0\u0dca\u0da1\u0daf2\u0dba\u0dbb2\u0dad\u0dd2\u0db1\u0dcf \u0dc0\u0daf02\u0db4\u0dca\u200d\u0dbb\u0daf\u0db1\u0dda\u0dba \u0d9a2 \u0db1\u0db1\u0dba\u0dda\u0dad\u0dd4\u0db8 \u0db1\u0dca\u0dbd\u0daf2 \u0db1\u0dda2 \u0dc3\u0dcf\u0dda\u0dcf\u0db1\u0dca\u0dca\u200d\u0db1\u0d9a\u0db1\u0dca2 \u0daf\u0dad\u0da72 \u0dba\u0dd4\u0dc0\u0dab\u0dd42\u0dc0\u0daf\u0dca\u0dad\u0dcf\u0daf2 2 \u0dba\u0dbb2 \u0dad\u0dd2\u0db1\u0dcf \u0dc0\u0daf;2 \u0d9c\u0dd0\u0da7\u0dbd\u0dd42 \u0daf\u0dd2\u0db1\u0dc0\u0dda\u0dad\u0dca 2 \u0dba\u0dbb2 \u0dad\u0dd2\u0db1\u0dcf \u0dc0\u0daf02 \u0db1\u0dda\u0dba2\u0dc0\u0dd2\u0db0\u0dd2 \u0dca 2 \u0dba\u0dbb\u0db1\u0dca 2 \u0d95 \u0dd102 \u0d9a2 \u0dc3\u0dcf\u0dda\u0dcf\u0db1\u0dca\u0dca\u200d2 \u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dc0\u0dbd\u0dd2\u0d9a2 \u0daf\u0dd2\u0dc52 :\u0dd0\u0db1\u0dca2 \u0d86\u0dbb\u0dda\u0dcf2\u0dba\u0dbb2\u0dad\u0dd2\u0db1\u0dcf \u0dc0\u0daf02\u0db1\u0dda\u0dba2\u0dc1\u0dca\u200d\u0dbb\u0dd32\u0dbd\u0dd2\u0d82\u0dba\u0daf2 \u0dbb\u0dc0\u0dd0\u0dbd\u0dd22\u0daf\u0db0\u0dd2\u0dba\u0daf\u0dc0\u0dda\u0d9a\u0da72\u0dc0\u0dd2\u0dcf\u0dbb\u0d9a\u0dca \u0db82\u0dc3\u0dd3 \u0daf2\u0db1\u0dc0\u0da0\u0dca\u0da02\u0db4\u0dca\u200d\u0dbb\u0dba\u0dca \u0d9a\u0d9a\u0dca \u0db82\u0db1 \u0ddc\u0db1\u0dc0\u0dba\u0dd202\u0dbb\u0da72\u0dd4\u0dc0\u0dbb\u0daf2\u0dad\u0dd2\u0db1\u0dcf 2\u0daf\u0dd4\u0dbb\u0dba\u0dcf 2\u0d9a\u0dd4\u0dab\u0dcf\u0dbd\u0dd4\u0db1\u0dd42\u0daf\u0dd2\u0db12\u0dba\u0dbb\u0dd4\u0dc02\u0daf\u0da9\u0dda2\u0dc3\u0dcf \u0dbb\u0daf2\u0dcf\u0daf\u0dd42\u0db8\u0dd4:\u0db12\u0daf\u0d9a2\u0dba\u0dbb2\u0d9c\u0dd0\u0db1\u0dd3\u0db1\u0dda2\u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0d9a\u0dca \u0db82\u0dad\u0dd2\u0db1\u0dcf \u0dc0\u0daf\u0d8b2\u0d9c\u0dd4\u0dc02 \u0dba\u0dcf\u0daf \u0daf\u0d9a\u0dba\u0dad\u0dd4\u0db8 \u0db1\u0dd202 \u0daf\u0dd2\u0dc52 \u0d9a2 \u0dc3\u0dcf\u0dda\u0dcf\u0db1\u0dca\u0dca\u200d\u0db1\u0d9a\u0db1\u0dca2 \u0dba\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db82 \u0dba\u0dbb\u0dd2\u0dba\u0db1\u0dca2\u0daf\u0db1\u0dca \u0dc0\u0daf022\n\n\u0d9c\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0dbb\u0dd9\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0baa\u0bbe \u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Speaker) \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca 2\u0daf\u0dd2\u0d82\u0dba2722-7307/020.-2(7)\u0d8b2\u0d9c\u0dd4\u0dc02\u0dc3\u0dd4\u0d9c\u0dca 2\u0dc0\u0dc3\u0dcf\u0db1\u0dca\u0dcf2:2\u0db1\u0dca\u0db1\u0dc0\u0daf2 \u0dbb\u0dcf\u0daf2-2\u0dad\u0dc3\u0dcf\u0dcf\u0daf2\u0d9c\u0dca\u0dad\u0dcf\u0d9a2\u0dad\u0dd4\u0db8\u0dc52 \u0dd0\u0dcf0\n\n\u0db1:\u0dc0 2\u0dc0\u0da7\u0d9a0\n\n\u0d86\u0db6\u0dcf\u0db0\u0dd2 \u0dc3\u0dd2\u0dd4\u0dc3\u0dca\u0daf \u0dca\u0db3\u0dc4\u0dc3\u0dcf \u0d87\u0dd2\u0db1 \u0dc0\u0dd2\u0dad\u0dc1\u0dca\u0dda\u0dc2 \u0db4\u0dcf\u0dca\u0dbd\u0dca \u0dca\u0dc4\u0dc3\n\n\u0d92\u0d9a\u0d9a: \u0dc0\u0dd2\u0dca\u0db4 \u0dbb \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0ba9\u0bbe\u0bb3\u0bbf \u0bae\u0bbe\u0ba3\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0bb5\u0bbf\u0bb0\u0b9a\u0b9f\n\n\u0baa\u0bbe\u0b9f\u0b9a\u0bbe\u0b95\u0bb2\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bb2\u0b95\u0bc1\u0b95\u0bb3\u0bcd: \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd\n\nSPECIAL SCHOOLS AND UNITS FOR DISABLED\n\nSTUDENTS: DETAILS\n\n1321/2025\n\n10.\u0d9c\u0dd4 \u0d9c\u0dba\u0dcf\u0dca\u0daf \u0da2\u0db1\u0d9a \u0dd9\u0dc4\u0dc3 \u0dcf (\u0d9c\u0dd4 \u0dd4\u0dc3\u0d9c\u0dad\u0dca \u0dc0\u0dca\u0dca\u0daf \u0dcf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf\n\n\u0dd9\u0dc4\u0dc3 \u0dcf \u0dad\u0dc0\u0db1\u0dd4\u0dc0 ) (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b95\u0baf\u0bbe\u0ba9\u0bcd \u0b9c\u0ba9\u0b95 - \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0bc1\u0b95\u0ba4\u0bcd \u0bb5\u0b9a\u0ba8\u0bcd\u0ba4 \u0ba4 \u0b9a\u0bbf\u0bb2\u0bcd\u0bb5\u0bbe \u0b9a\u0bbe\u0bb0\u0bcd\u0baa\u0bbe\u0b95) (The Hon. Gayan Janaka on behalf of the Hon. Sugath Wasantha de Silva) \u0daf\u0d9c\u0dca\u200d\u0dbb\u0daf \u0daf\u0dcf\u0dba2 \u0dc3\u0dcf\u0dbb2 \u0daf\u0dca\u200d\u0dba\u0daf\u0dad \u0d8b2 \u0dc3\u0dc3\u0dcf\u0dc3\u0dcf\u0dca2 \u0daf\u0dca\u200d\u0dba\u0daf\u0dad 2 \u0dc3\u0dcf\u0dbb2 \u0dc0\u0dca\u0dca \u0dd3\u0dbb\u0d9a2\u0daf\u0dca\u200d\u0dba\u0daf\u0dad 2\u0daf \u0daf\u0dcf\u0dba\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0d9a\u0db1\u0d9c\u0db1\u0dca2\u0d87\u0dc3\u0dd62\u0db4\u0dca\u200d\u0dbb\u0dba\u0dca \u0d9a2-2(7)\n\n(\u0daf) (i) \u0d86\u0dcf\u0daf\u0dca\u200d2 \u0dc3\u0dcf\u0dc4\u0dd2\u0dcf2 \u0db1\u0dca\u0dc3\u0dd4\u0db1\u0dca2 \u0daf\u0db1\u0d9c\u0db1\u0dd4 2 \u0dbd\u0dcf 2 \u0dc0\u0dd2\u0db1\u0dba\u0d9c\u0dc22\u0dad\u0daf\u0dc3\u0dcf\u0dd0\u0db12\u0dc3\u0dcf\u0dd2\u0d82\u0d9b\u0dba\u0daf\u0dc0;\n\n(ii) \u0d9a\u0dc0\u0daf\u0db1\u0dda2 \u0daf\u0db1\u0d9c\u0db1\u0dd4 2 \u0dbd\u0dcf 2 \u0dc1\u0dd2\u0dc2\u0dba\u0d9a\u0db1\u0dca2 \u0dbb\u0daf2 \u0dc1\u0dd2\u0dc2\u0dba\u0daf\u0dc0\u0db1\u0dca2\u0dc3\u0dcf\u0dd2\u0d82\u0d9b\u0dba\u0daf\u0dc02 \u0d86\u0dcf\u0daf\u0db0\u0dd2\u0dcf\u0dcf\u0daf\u0dc0\u0d9a2 \u0daf\u0db1\u0dd4\u0dc02 \u0db1\u0dc0\u0db1\u0dca2 \u0db1\u0dc0\u0db1\u0dca2\u0dc0\u0dba\u0db1\u0d9a\u0db1\u0dca;\n\n(iii) \u0d91 2 \u0dc0\u0dd2\u0db1\u0dba\u0d9c\u0dc22 \u0dad\u0daf\u0dc3\u0dcf\u0dd0\u0db1\u0dc0\u0dbd2 \u0db1\u0dc3\u0dcf\u0d9c\u0dc0\u0d9a2 \u0dba\u0dbb 2 \u0dc0\u0db1\u0dd4\u0dc0\u0dc0\u0dd4\u0dc0\u0db1\u0dca2\u0dc3\u0dcf\u0dd2\u0d82\u0d9b\u0dba\u0daf\u0dc0;\n\n(iv) \u0d9a\u0dc0\u0daf\u0db1\u0dda2\u0dad\u0dc0\u0dad