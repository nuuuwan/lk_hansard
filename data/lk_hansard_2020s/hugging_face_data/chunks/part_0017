    "chunk_text": "Statement \u0dbb\u0d9a\u0dca \u0d9a\u0dcf\u0dcf0 \u0dbb\u0dc4\u0dd2\u0dd3 \u0d85\u0dd2\u0dc5 \u0d9c\u0db4\u0db1\u0dca\u0dad\u0dc0\u0dcf \u0dd4\u0dbb\u0db1\u0dca\u0dad\u0db1\u0dcf\u0d8b \u0db8\u0dca\u200d\u0dba\u0db8 \u0d85\u0d9a\u0dcf\u0d9c\u0daf\u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c,\u0dba 0215\u0dd3 \u0db4\u0dad\u0db1\u0dca\u0dad \u0d9c,\u0dc3\u0dad\u0dcf\u0dad\u0d8b \u0dbb\u0dc4\u0dd2 loan agreement \u0dbb\u0d9a \u0d85\u0dc3\u0dc3\u0db1\u0dca\u0dad \u0d9a\u0d9c\u0dcf\u0dca 0219\u0dd3 \u0dd2\u0dbb\u0dba\u0db1 \u0dbb\u0d9a0 \u0d92\u0d9a \u0dca\u0d9c\u0db8\u0dd2\u0db4\u0d9a\u0dcf\u0db1\u0dd4 \u0d9c\u0da9\u0dcf\u0daf\u0dbb\u0dca\u0dbd \u0dd2\u0da7\u0dd2\u0dba\u0db1 922 \u0d9c,\u0dab\u0dba\u0db1\u0d9a loan \u0dbb\u0d9a\u0dca0 0215\u0dd3 \u0d92 loan \u0dbb\u0d9c\u0d9a\u0db1\u0dca\u0dad \u0dd2\u0dc0\u0dba\u0dba\u0dad 62\u0dca \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dca \u0dc0\u0dd2\u0db1\u0dd4\u0dc3\u0d8b \u0dd2\u0dc0\u0dba\u0dba\u0dad 42\u0dca \u0d9c\u0da9\u0dcf\u0daf\u0dbb\u0dca\u0dbd\u0dc0\u0dd2\u0db1\u0dd4\u0dc3 \u0d9c\u0d9c,\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0dad\u0db8\u0dba\u0dd2 \u0dbb\u0d9a\u0d9f \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad0 0215\u0dd3 \u0d9c\u0dda \u0dbb\u0d9a\u0d9f\u0dad\u0dcf\u0dc0\u0dad \u0dca\u0dc0\u0dcf\u0dad\u0d8b 0219\u0dd3 \u0dad\u0db8\u0dba\u0dd2 \u0d9c\u0dd2\u0dd2\u0dbd\u0dc3\u0dd4\u0db8 \u0d85\u0dc3\u0dc3\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad0 0219\u0dd3 \u0d9c\u0dd2\u0dd2\u0dbd\u0dc3\u0dd4\u0db8 \u0d85\u0dc3\u0dc3\u0db1\u0dca\u0dad \u0d9a\u0dbb \u0db1\u0d9c\u0d9a\u0dcf\u0dad\u0d8b 0215\u0dd3 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 dollar rate \u0dbb\u0d9a\u0dad \u0dad\u0db8\u0dba\u0dd2 \u0d92 \u0db4\u0dcf\u0daf\u0d9a\u0d9c\u0dba \u0d9c\u0dd2\u0dd2\u0dbd\u0dc3\u0dd4\u0db8 \u0d85\u0dc3\u0dc3\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0daf\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad0 \u0d92 \u0d9a\u0dcf\u0daf\u0d9c\u0dc1\u0d8b 0215\u0dd3 dollar rate \u0dbb\u0d9a \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dca 135\u0dba\u0dd20\n\n\u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0dc3\u0dd0\u0dca \u0dad\u0dd0\u0dda\u0db6\u0dbb\u0dca\u0dbd 32\u0dc0\u0dd0\u0db1\u0dd2 :\u0dcf\u0dad \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0d9a\u0d9c\u0dc1 \u0dd6\u0dbd\u0daf\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9c,\u0dad\u0dd2\u0dba \u0d9c,\u0dc3\u0d9c\u0dad\u0dcf\u0dc3 \u0d9c,\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2\u0d8b \u0d9c\u0dda\u0dc1\u0dd3\u0dba \u0dd6\u0dbd\u0daf\u0dcf\u0dbb\u0dc0\u0dd2\u0db1\u0dca\u0dad \u0d85\u0dd2\u0dc5 :\u0dd0\u0db1\u0dad \u0dd2\u0dc0\u0dba\u0dba\u0dad 56076\u0d9a\u0dad \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0daf\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf0 \u0db8\u0dca\u200d\u0dba\u0db8 \u0d85\u0d9a\u0dcf\u0d9c\u0daf\u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c,\u0d9c\u0dc1 \u0dc0\u0dd0\u0da9 \u0db4\u0dad\u0db1\u0dca\u0dad \u0d9c,\u0dd0\u0dd3\u0db8\u0db8\u0dc3 \u0dbb\u0dca\u0d9a \u0d85\u0dd2\u0dc5 \u0dc4\u0dd2\u0dad\u0db1\u0dc0\u0dcf\u0d8b \u0d85\u0db4\u0dad \u0dd2\u0dc0\u0dba\u0dba\u0dad 92\u0dad \u0dbb\u0dc4\u0dcf\u0dad \u0dba\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0d9c\u0dc0\u0dba\u0dd2 \u0dd2\u0dbb\u0dba\u0daf\u0dcf0 Foreign loans\u0dc0\u0daf \u0dad\u0db8\u0dba\u0dd2 delay \u0dbb\u0d9a \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad0 \u0dd2\u0dc0\u0dba\u0dba\u0dad 01075\u0dba\u0dd2 :\u0dd0\u0db1\u0dad \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad0 \u0d85\u0dd2\u0dc5 \u0dc4\u0dd2\u0dad\u0db1 \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0dad \u0db8\u0dca\u200d\u0dba\u0db8 \u0d85\u0d9a\u0dcf\u0d9c\u0daf\u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c, \u0dc0\u0dba\u0dcf\u0db4\u0dca\u0dad\u0dd2\u0dba\u0dc3 \u0dbb\u0dca\u0d9a \u0d92\u0d9a\u0dc3 \u0dad\u0dbb\u0db8\u0dca \u0d9c\u0dc0\u0db1\u0dc3\u0dca \u0d9c\u0dc0\u0dba\u0dd20 :\u0dd0\u0db1\u0dad \u0dd2\u0dc0\u0dba\u0dba\u0dad 52\u0d9a \u0dd6\u0dbd\u0daf\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9c,\u0dad\u0dd2\u0dba\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dad \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad\u0d8b \u0d9c,\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd20 \u0db8\u0db8 \u0d92 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4\u0dc3 \u0d89\u0dd2\u0db1\u0dd2\u0db4\u0db4\u0dc3 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0dc4\u0dd2\u0dad\u0dd4\u0dc0\u0dcf0 \u0dd2\u0dbd\u0d9c\u0dda\u0dc1\u0dd3\u0dba \u0dab\u0dba\u0dba \u0db4\u0dd0\u0dc3\u0d9c\u0dad\u0db1\u0dca\u0dad \u0dad\u0db8\u0dba\u0dd2 \u0d9c\u0daf\u0dcf\u0d9a\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dba\u0dca \u0dca\u0dd2\u0dbd\u0dca \u0daf\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad0\n\n\u0d85\u0dc0\u0dc3\u0dcf\u0db1 \u0dc0\u0d9a\u0d9c\u0dba\u0db1\u0dca\u0dad \u0db8\u0db8 \u0d89\u0dad\u0dcf\u0db8 \u0d89\u0dca\u0db8\u0db1\u0dd2\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0da7\u0dd2\u0d9a\u0dca \u0dd2\u0dbb\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dd20 \u0d85: \u0d9c\u0dda \u0dd2\u0dbd\u0dc0\u0dcf:\u0d9c\u0dc1\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0d9a\u0dba \u0dd2\u0dc5\u0dd2\u0db6\u0db6 \u0dc0\u0dc3 \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da0\u0da1\u0dcf \u0dc0\u0dd4\u0dab\u0dba\u0dc3\u0d8b \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 AWPLR \u0d9c,\u0dd0\u0db1 \u0dca\u0db1\u0db1\u0dca\u0dad\u0dd4\u0dbb \u0d9c\u0db1\u0dcf\u0dc0\u0db1 \u0db6\u0dc0\u0dad \u0db8\u0dad \u0d9c\u0dc4\u0dcf \u0dad\u0db8 \u0dd2\u0dbd\u0d9a\u0dca\u0dc0\u0dcf\u0dc3\u0dba\u0dca \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf0 \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0d9c\u0dda \u0dca\u0da9\u0dd4\u0d9a\u0da9\u0dd4\u0dc0 \u0dd2\u0dbd\u0d9a\u0dca\u0dc0\u0dcf\u0dc3 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0d8b \u0d9c\u0dc4\u0dcf\u0dbb\u0d9a\u0dda \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dd0\u0dad\u0dd2 \u0dca\u0da9\u0dd4\u0d9a\u0da9\u0dd4\u0dc0\u0dca \u0dd2\u0dbd\u0d9a\u0dcf\u0dba\u0dad0 \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0dd4\u0dc0\u0dcf\u0d8b \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0dad \u0dc0\u0dd0:\u0d9c,\u0dc3 \u0dc0\u0db1 \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0dcf \u0d9c:\u0d9a \u0dad\u0dd4\u0db1\u0d9a\u0dd4\u0dc3 \u0dd2\u0dbb\u0dba\u0db1\u0dca\u0dad\u0db10 \u0db8\u0db8 \u0d89\u0dad\u0dcf\u0db8 \u0d89\u0dca\u0db8\u0db1\u0dd2\u0db1\u0dca\u0dad \u0d92 \u0da7\u0dd2\u0d9a \u0dd2\u0dbb\u0dba\u0db1\u0dca\u0dad\u0db1\u0dda\u0d8b \u0d9c,\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd20"
