    "chunk_text": "\u0dc4\u0daf \u0d89\u0dad\u0dcf \u0dc0\u0dd0\u0daf\u0d9c\u0dca \u0dad\u0dd2\u0dad\u0dd2 \u0dc4\u0dc0\u0ddd\u0dba \u0db0\u0db1\u0dba\u0d9a\u0dca \u0dad\u0db8\u0dba\u0dba\u0dd2 \u0ddd\u0dca\u0db4 \u0dc4\u0db7\u0dcf\u0dc0 \u0ddd\u0d9c\u0db1\u0dd0\u0dc0\u0dd2\u0dca \u0dad\u0dd2\u0ddd\u0db6\u0db1\u0dca\u0ddd\u0db1\u0dca. \u0ddd\u0dca\u0db4\u0d9a \u0ddd\u0dbd\u0dad\u0dd2\u0dc3\u0dcf\u0dd2 \u0d9a\u0dba\u0dd2. \u0ddd\u0dca\u0db4 \u0ddd\u0db8\u0dba\u0ddc\u0ddd\u0dc3\u0ddc\u0ddd\u0dca \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dbd\u0dd0\u0db6\u0dd3\u0db8\u0dba\u0dca \u0db8\u0dba\u0db8\u0dba \u0d89\u0dad\u0dcf \u0ddd\u0d9c\u0dde\u0dbb\u0dc0\u0dba\u0d9a\u0dca \u0ddd\u0dbd\u0dc4 \u0dc4\u0dbd\u0d9a\u0db1\u0dc0\u0dcf. \u0dc4\u0daf \u0d8b\u0ddd\u0daf\u0dca \u0d89\u0db3\u0dbd\u0dcf\u0db8\u0dba \u0ddd\u0db8\u0dba\u0db8\u0dba \u0dc0\u0dd2\u0dc0\u0dcf\u0daf\u0ddd\u0dda\u0daf\u0dd3 \u0db8\u0dba\u0dad\u0dd4 \u0dc0\u0dd4\u0dab\u0dd4 \u0dc4\u0daf\u0dc3\u0dc3\u0dd4\u0dca, \u0db8\u0dba \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0d9a\u0dae\u0dcf \u0d9a\u0dcf \u0d9c\u0dbb\u0dd4 \u0db8\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0dd2\u0dba\u0dba \u0db4\u0dcf \u0d9a\u0dbb\u0db4\u0dd4 \u0dc4\u0daf\u0dc3\u0dc3\u0dd4\u0dca, \u0d8b\u0ddd\u0daf\u0dca \u0dc4\u0da2\u0dd2\u0dca \u0db4\u0dd3. \u0ddd\u0db4\u0ddd\u0dca\u0dae\u0dbb\u0dcf \u0db8\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dba\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dca \u0d9a\u0dcf \u0dc4\u0daf\u0dc3\u0dc3\u0dd4\u0dca \u0dd2\u0dad\u0dd4\u0dc5\u0dd4 \u0d92 \u0dd2 \u0dba\u0dbd\u0dd4 \u0dc4\u0daf\u0dc3\u0dc4\u0dca\u0dc0\u0dbd \u0d91\u0d9a \u0db4\u0dd0\u0dca\u0dad\u0dd2\u0dbb\u0db1\u0dca \u0db8\u0dba\u0db8\u0dba \u0d9c\u0dbb\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0dc0\u0dcf\u0ddd \u0db8\u0dba, \u0d92\u0dc0\u0dcf \u0dc4\u0d9c\u0dba \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0ddd \u0db8\u0dba \u0ddd\u0dca\u0db4 \u0dc4\u0db8\u0dba\u0dc4\u0dca\u0dad \u0dc4\u0dc0\u0ddd\u0dba \u0db0\u0db1\u0dba \u0d91\u0d9a\u0d9f \u0dc0\u0db1\u0dc0\u0dcf. \u0ddd\u0dca\u0db4 \u0dc4\u0dc0\u0ddd\u0dba \u0db0\u0db1\u0dba \u0dc4\u0dca\u0db4\u0db6\u0db1\u0dca\u0db0\u0ddd\u0dba\u0db1\u0dca \u0dc0\u0dd2\u0db4\u0d9a\u0dca \u0dba \u0db4\u0dd0\u0dca\u0ddd\u0dad\u0db1\u0dca \u0db8\u0dba\u0dad \u0ddd\u0daf\u0d9a\u0d9a\u0dca \u0ddd\u0d9c\u0db1\u0dcf\u0dc0\u0dcf. \u0db8\u0dba\u0db8\u0dba \u0d9a\u0dd0\u0db8\u0dba\u0dd0\u0dad\u0dd2\u0dba\u0dd2, \u0d92 \u0db8\u0dba\u0dad \u0ddd\u0daf\u0d9a \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db4\u0dd0\u0dc3\u0dd0\u0daf\u0dd2\u0dbd\u0dd2 \u0dd2\u0dbb\u0dd3\u0db8\u0db8\u0dba\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1.\n\n\u0dbd\u0dc0\u0d9a\u0dcf\u0ddd\u0dc0\u0dca \u0dca\u200d\u0dbb\u0dd2 \u0daf\u0dca\u0db0 \u0db1\u0da9\u0dd4\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0ddd\u0db6\u0db1\u0dc0\u0dcf, \"\u0ddd\u0db4\u0ddc\u0dbd\u0dca\u0db4\u0dd2\u0dad\u0dd2\u0d9c\u0db8\u0dba \u0db1\u0da9\u0dd4\u0dc0\" \u0dd2\u0dbb\u0dba\u0dbd\u0dcf. \u0d92\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db1\u0dca\u0dad \u0da9\u0dba\u0dc4\u0dca \u0d91\u0ddd\u0dbb\u0dd2 \u0d92\u0d9a\u0db1\u0dcf\u0dba\u0d9a \u0db1\u0da9\u0dd4\u0dc0. \u0ddd\u0db4\u0ddc\u0dbd\u0dd2\u0dc4\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0dd2 \u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0dc4\u0dc0\u0db8\u0dba\u0db1\u0dca \u0dc4\u0dc3\u0d9c\u0dad \u0dc0\u0da0\u0db1 \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dba \u0db4\u0dc0\u0dcf \u0dbd\u0dca\u0dbd\u0dd2\u0d9a \u0dc4\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dd2 \u0d9a\u0dca\u0db4 \u0dba \u0ddd\u0dca \u0d9a\u0df2\u0dbb, \u0dc4\u0db8\u0dba\u0dcf\u0dd4\u0dc0\u0d9a \u0d9a, \u0dc4\u0dc0\u0db8\u0dba\u0db1\u0dca \u0dc4\u0dc3\u0d9c\u0dad \u0dc4\u0dd0\u0dbd\u0dd2\u0dbb\u0dbd\u0dca\u0dbd \u0dba \u0dca \u0ddd\u0dc0\u0db1\u0dc0\u0dcf \u0dd2\u0dbb\u0dba\u0dbd\u0dcf \u0d9c\u0dbb\u0dd4 \u0dc4\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba \u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dba \u0d9a\u0dbb \u0dad\u0dd2\u0ddd\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0db1\u0dd2\u0dc4\u0dcf \u0ddd\u0dca\u0db4\u0d9a \u0dc4\u0dca\u0dae\u0dae \u0db1\u0dd2\u0dd6\u0db4\u0db4\u0dab \u0db1\u0dd0\u0dc3\u0dd0, \u0dc0\u0dcf\u0da9\u0dd2\u0ddd\u0dc0\u0db1\u0dca\u0db1 \u0dd2\u0dbb\u0dba\u0dbd\u0dcf \u0dd2\u0dbb\u0dc0\u0dca\u0dc0\u0dca \u0d92\u0d9a \u0dca teachers\u0dbd\u0dcf \u0dd2 \u0ddd\u0dca\u0dae \u0daf\u0db8\u0dba\u0dba\u0dd2 \u0dd2\u0dbb\u0dba\u0dbd\u0dcf \u0ddd\u0db6\u0ddc\u0dbb\u0dd4 \u0dad\u0dca\u0dae\u0d9a \u0db8\u0dba\u0dc0\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf, \u0ddd\u0db6\u0ddc\u0dbb\u0dd4 \u0db6\u0dd2\u0dbd\u0dca\u0ddd\u0dbd \u0db8\u0dba\u0dc0\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf. \u0d8b\u0ddd\u0daf\u0dca \u0d9c\u0dbb\u0dd4 \u0dc4\u0db7\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0dba\u0dcf\u0dca \u0ddd\u0dca\u0db4 \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0dc4\u0dc0\u0db0\u0dcf\u0dbb\u0dab\u0dba \u0d9a\u0dcf\u0dcf. \u0db8\u0dba \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db4\u0dd4 \u0dc4\u0dd4\u0dc0 \u0dca\u0d9a\u0dcf \u0dad\u0dd2\u0dbd\u0d9a\u0dbb\u0dca\u0db1 \u0db8\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0dd2\u0dba\u0dba\u0dca \u0ddd\u0dca\u0db4 \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dcf\u0dcf. \u0ddd\u0dca\u0db4\u0d9a \u0ddd\u0dca\u0dbb\u0dd4\u0dca\u0db4 \u0d9c\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0dc4\u0db8\u0dba\u0dcf\u0da2\u0dba\u0d9a\u0dca \u0ddd\u0db1\u0ddc\u0ddd\u0dc0\u0dba\u0dd2 \u0ddd\u0dca\u0db4 \u0dad\u0dd2\u0ddd\u0db6\u0db1\u0dca\u0ddd\u0db1\u0dca.\n\n\u0daf\u0dd0\u0db1\u0dca \u0ddd\u0db6\u0ddc\u0ddd\u0dc3\u0ddc\u0db8\u0dba \u0ddd\u0dc0\u0db1\u0dc4\u0dca\u0db8\u0dba \u0dc4\u0dc0\u0ddd\u0dba \u0db0\u0db1\u0dba\u0d9a\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0dad\u0dd2\u0ddd\u0db6\u0db1\u0dc0\u0dcf, \u0dbb\u0daf\u0dbb\u0ddd\u0dba\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0daf\u0dac\u0dd4\u0dc0\u0db8\u0dba\u0d9a\u0dca \u0d9c\u0dd0\u0db1. \u0d92 \u0dd2\u0dbb\u0dba\u0db1\u0dca\u0ddd\u0db1\u0dca \u0dc4\u0daf\u0dca\u0db7\u0dcf\u0dc0\u0ddd\u0dba\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0d9a\u0dbb\u0db1, \u0d91\u0ddd\u0dc3\u0db8\u0dba \u0db1\u0dd0\u0dca\u0db1\u0dca\u0db4 \u0daf\u0dac\u0dd4\u0dc0\u0db8\u0dba\u0d9a\u0dca \u0dc0\u0dba\u0ddd\u0dba\u0db1\u0dca \u0ddd\u0dc3 \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0dd2\u0dbb\u0dd3\u0db8\u0ddd\u0dca\u0db4 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba\u0dba\u0d9a\u0dca \u0dc0\u0dba\u0ddd\u0dba\u0db1\u0dca \u0ddd\u0dc0\u0dca\u0daf\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0ddd\u0dc3 \u0dc4\u0db4\u0dc3\u0dc3\u0dd4\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0dd2\u0dad\u0dd2 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0db1\u0dca\u0db4, \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0d9a\u0dbb\u0db1 \u0dc4\u0dc0\u0dc4\u0dca\u0dae\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0dbb\u0daf\u0dbb\u0ddd\u0dba\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0ddd\u0daf\u0dca\u0dc0\u0dbd\u0dca\u0dc0\u0dbd \u0ddd\u0dca\u0db4\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dca\u0db8\u0dba\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf \u0dd2\u0dbb\u0dba\u0dbd\u0dcf. \u0dbd\u0dca\u0dbd\u0dcf\u0dc4\u0db1\u0dcf\u0dd6\u0db4\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dba\u0db1\u0dd2, \"\u0dc0\u0dcf\u0da9\u0dd2\u0ddd\u0dc0\u0db1\u0dca\u0db1\" \u0dd2\u0dbb\u0dba\u0dbd\u0dcf \u0dbb\u0daf\u0dbb\u0ddd\u0dba\u0db1\u0dca \u0dd2\u0dbb\u0dba\u0db1\u0dca\u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca, \u0dc4\u0dc0\u0dc0\u0dcf\u0daf \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca, \u0dbb\u0daf\u0dbb\u0ddd\u0dba\u0db1\u0dca \u0d9a\u0db1 \u0d9c\u0dc3\u0db1\u0dca\u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d91\u0ddd\u0dc3\u0db8\u0dba \u0db1\u0dca\u0db4 \u0dc4\u0db4 \u0dbb\u0daf\u0dbb\u0dba \u0dd2\u0dbb\u0dba\u0db1\u0dca\u0ddd\u0db1\u0dca \u0ddd\u0db8\u0dba\u0ddc\u0d9a\u0d9a\u0dca\u0daf \u0dd2\u0dbb\u0dba\u0dbd\u0dcf\u0dca \u0dc4\u0dca\u0dae\u0dae \u0db1\u0dd2\u0dd6\u0db4\u0db4\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0ddd\u0dc0\u0db1\u0dc0\u0dcf.\n\n\u0db8\u0dba\u0db8\u0dba \u0d9a\u0dd0\u0db8\u0dba\u0dd0\u0dad\u0dd2\u0dba\u0dd2, \u0ddd\u0dca\u0db4 \u0d9c\u0dbb\u0dd4 \u0dc4\u0db7\u0dcf\u0ddd\u0dc0\u0dca \u0dc4\u0dc0\u0db0\u0dcf\u0db1\u0dba \u0ddd\u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0db1\u0dad\u0d9a\u0dca \u0db1\u0dd2\u0dca\u0dae\u0db8\u0dba\u0dcf\u0dab\u0dba \u0d9a\u0dbb\u0daf\u0dca\u0daf\u0dd2 \u0d91\u0db8\u0dba \u0db4\u0db1\u0ddd\u0dca \u0dc4\u0dbb\u0db8\u0dd4\u0dab \u0ddd\u0db8\u0dba\u0ddc\u0d9a\u0d9a\u0dca\u0daf, \u0dc0\u0dba\u0dc0\u0dc4\u0dca\u0dae\u0dcf\u0daf\u0dcf\u0dba\u0d9a\u0dba \u0dc0\u0dd2\u0dd2 \u0db1\u0dca \u0dc4\u0dbb\u0db8\u0dd4\u0dab\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0ddd\u0db1\u0dca \u0ddd\u0db8\u0dba\u0ddc\u0d9a\u0d9a\u0dca\u0daf \u0dd2\u0dbb\u0dba\u0db1 \u0d91\u0d9a \u0d9c\u0dd0\u0db1. \u0db8\u0dba\u0db8\u0dba \u0dd2 \u0dad\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0d91\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba \u0dca \u0dc4\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dc0\u0dbd\u0daf\u0dd3 \u0db1\u0dd0\u0dc0\u0dad \u0db1\u0dd0\u0dc0\u0dad\u0dca \u0dc4\u0dc0\u0dc0\u0dcf\u0daf\u0dba \u0db6\u0db3\u0dd4\u0db1\u0dca \u0dc0\u0dd2\u0dba \u0dc3\u0dd0\u0dd2\u0dbb \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca. \u0d92 \u0db1\u0dd2\u0dc4\u0dcf \u0ddd\u0dca\u0db4\u0d9a\n\n983 984\n\n[\u0d9c\u0dbb\u0dd4 \u0dad\u0dd2\u0dad\u0dd2\u0dcf \u0da0\u0dd2\u0dba\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dd2\u0dbb\u0dbb\u0dd2\u0dd2\u0dbd\u0dca\u0dbd \u0db8\u0dba\u0dc3\u0dca\u0dd2\u0dba\u0dba ]\n\n2025 \u0dc4\u0dd0\u0dca\u0db4\u0dad\u0dd0\u0dca\u0db4\u0db6\u0dca\u0dae 24"
  },
