dad\u0dd2\u0db8 \u0daf\u0d9a \u0dcf\u0daf\u0d85\u0dba\u0dd2\u0db1\u0dca\u0daf\u0dcf\u0dc5\u0dcf\u0dc3\n\n\u0dcf\u0db8\u0dbd\u0dca\u0dc0\u0dafarrest \u0dcf\u0dc3 \u0daf\u0dbb\u0dcf\u0dad\u0dca\u0daf\u0d9a\u0dc4\u0dca\u0db3\u0dba\u0dd2\u0dc3\u0daf \u0dcf\u0db8\u0dbd\u0dca\u0dc0\u0dafarrest \u0dcf\u0dc3 \u0dc0\u0dcf\u0daf \u0daf\u0d92\u0daf\u0dd2\u0dc1\u0db0\u0dd2\u0db4 -\u0daf[\u0db6\u0dcf\u0db0\u0dcf\u0daf\u0d9a\u0dd2\u0dbb\u0dd3 ]\u0daf\u0dad\u0d9a\u0dc4\u0dca\u0db8\u0daf\u0d89\u0db1\u0dca \u0d9a\u0dcf\u0ddd\u0dc3\u0daf\u0d92\u0daf\u0dd2\u0dc1\u0db0\u0dd2\u0db4 -\u0daf[\u0db6\u0dcf\u0db0\u0dcf\u0daf\u0d9a\u0dd2\u0dbb\u0dd3 ]\u0daf\u0daf\u0dcf\u0dd1\u0daf \u0dc4\u0db1\u0dca \u0daf\u0dbb\u0dc1\u0dcf\u0dc3\u0daf\u0dcf\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dc4\u0dbb\u0dd2\u0daf\u0d92\u0daf\u0db6\u0db6\u0dcf \u0dafmilk bottle \u0dbb\u0dcf\u0d9a\u0dca\u0daf\u0d9a\u0daf\u0db1\u0dca \u0dc3\u0daf\u0dad\u0dca\u0db1\u0dd2\u0dcf\u0dc3\u0daf\u0d9a\u0daf\u0db8\u0d9a\u0dc5\u0db1\u0dca\u0daf\u0dcf\u0dae\u0dcf\u0daf\u0dcf\u0dc3\u0db1\u0dca \u0dad\u0dca\u0daf\u0db6\u0dd0\u0dc4\u0dd0\u0dc3\u0daf\u0dc3\u0dd2\u0dcf\u0d82\u0dc4\u0d9a\u0dbd\u0db1\u0dca\u0daf\u0dcf\u0dae\u0dcf\u0daf\u0dcf\u0dc3\u0db1\u0dca \u0dad\u0dca\u0daf\u0db6\u0dd0\u0dc4\u0dd0\u0dc3\u0daf\u0d9a\u0dd2\u0db4\u0dbd\u0dcf\u0daf\u0dc0\u0dd0\u0da9\u0d9a\u0dca\u0daf \u0dd0\u0dc4\u0dd0\u0dc3\u0daf\u0dcf\u0dc3\u0daf\u0dc3\u0daf\u0dcf\u0dc3\u0db1\u0dca \u0daf\u0dbb\u0dc1\u0dcf\u0dc3\u0daf\u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0daf\u0d9a \u0daf\u0dc0\u0dcf\u0d9a\u0d9a\u0daf\u0d85\u0db4\u0daf\u0dad\u0dca\u0db8\u0dba\u0dd2\u0daf\u0d85\u0daf\u0daf\u0dc1\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0daf\u0d87\u0dd2\u0dc1\u0dad\u0dca\u0daf\u0d89\u0db1\u0dca\u0d9a\u0db1\u0dca\u0dc3\u0daf\u0d87\u0dad\u0dca\u0dad\u0dca \u0db8\u0daf\u0d9a \u0d9a\u0d9a\u0dca\u0daf\u0d89\u0db1\u0dca \u0daf\u0d9a \u0dca\u0da9\u0d9a\u0dca\u0daf\u0d85\u0dba\u0dd2\u0db4\u0dbd\u0dcf\u0dc0\u0daf\u0db8\u0db8\u0daf\u0d9a\u0dc1\u0dde \u0dbd\u0dd2\