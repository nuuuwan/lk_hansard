cf\u0daf\u0dcf\u0dc3\u0db1\u0dca\u0d9a\u0db1\u0dca\u0daf\u0d85\u0d9a\u0dda\u0daf-\u0daf[\u0db6\u0dcf\u0db0\u0dcf\u0daf\u0d9a\u0dd2\u0dbb\u0dd3 ]\u0daf\u0dcf\u0dbd\u0db6\u0dbd\u0daf\u0d9a\u0dc0\u0db1\u0dca \u0daf\u0dbb\u0dc1\u0dcf\u0dc3\u0daf[\u0db6\u0dcf\u0db0\u0dcf\u0daf\u0d9a\u0dd2\u0dbb\u0dd3 ]\u0daf\u0dd2\u0dc1 \u0db4!\u0daf\u0dd2\u0dc1 \u0db4!\u0daf\u0dd2\u0dc1 \u0db4!\u0daf[\u0db6\u0dcf\u0db0\u0dcf\u0daf\u0d9a\u0dd2\u0dbb\u0dd3 ]\u0daf\u0dd2\u0dc1 \u0db4!\u0daf\u0dd2\u0dc1 \u0db4!\u0daf\u0dd2\u0dc1 \u0db4!\u0daf\u0d9a\u0dcf\u0ddd \u0daf\u0dd2\u0dc1 \u0db4 \u0daf[\u0db6\u0dcf\u0db0\u0dcf\u0daf\u0d9a\u0dd2\u0dbb\u0dd3 ]\u0daf\u0d86!\u0daf\u0d85\u0db4\u0dd2 \u0daf\u0dd2\u0dc1 \u0db4\u0daf\u0dda \u0db1\u0dca\u0dc0\u0db1\u0dca \u0daf\u0d86\u0d9a\u0dda\u0dc3\u0daf[\u0db6\u0dcf\u0db0\u0dcf\u0daf\u0d9a\u0dd2\u0dbb\u0dd3 ]\u0daf\u0d85\u0db4\u0dd2\u0daf\u0dc0\u0dbd\u0dca\u0daf\u0dc1\u0dd0\u0dc5\u0dc3\u0daf[\u0db6\u0dcf\u0db0\u0dcf\u0daf\u0d9a\u0dd2\u0dbb\u0dd3 ]\u0daf\n\n\u0dad\u0db4\u0daf\u0db8\u0dbd\u0dca\u0daf\u0dc1\u0dd0\u0dc5\u0daf\u0d9a\u0db1\u0dca\u0dc3\u0daf\u0d9a\u0db8\u0dca\u0dcf\u0daf\u0daf\u0d9a \u0daf\u0dc0\u0dd4\u0d9a\u0dab\u0dca \u0daf\u0db8\u0dbd\u0dca\u0daf\u0dc1\u0dd0\u0dc5\u0dc0\u0dbd \u0daf\u0dad\u0db4\u0daf\u0db8\u0dbd\u0dca\u0daf\u0dc1\u0dd0\u0dc5;\u0daf\u0d85\u0db4\u0dd2\u0daf\u0dc0\u0dbd\u0dca\u0daf\u0dc1\u0dd0\u0dc5\u0dc3\u0daf\u0d85\u0dc1 \u0daf\u0d95 \u0dd1\u0daf\u0dbb\u0dcf\u0d9a\u0dca\u0daf\u0d9a\u0dd2\u0dc0\u0daf\u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dd2\u0dc3\u0daf\u0d9a\u0db8\u0dca\u0dcf\u0daf \u0daf\u0d85\u0db4\u0dd2\u0daf\u0dd2\u0dc1 \u0db4\u0d9a\u0dca\u0daf \u0dd0 \u0daf\u0d9a\u0dd2\u0dda\u0d9a\u0dda\u0daf \u0dd0\u0dc4\u0dd0\u0dc3\u0daf: \u0daf\u0daf \u0dd0\u0dad\u0dd2\u0dc0\u0daf\u0d89\u0db1\u0dca \u0dc3\u0daf[\u0db6\u0dcf\u0db0\u0dcf\u0daf\u0d9a\u0dd2\u0dbb\u0dd3 ]\u0daf\u0d85 \u0d9a\u0db8\u0ddd!\u0daf\u0d9a \u0daf\u0d9a\u0db8\u0dca\u0dcf\u0daf\u0daf\u0dc0\u0dd4\u0d9a\u0dab\u0dca \u0daf\u0db8\u0dbd\u0dca\u0daf\u0dc1\u0dd0\u0dc5\u0daf\" \u0