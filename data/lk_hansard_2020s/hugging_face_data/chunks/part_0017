    "chunk_text": "\u0d85\u0daf \u0d85\u0dc5\u0dd2 \u0dc3\u0dad\u0dca\u0dad\u0da7\u0db8 \u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd3\u0dba\u0db8\u0dca \u0dd2\u0dbd\u0dc0\u0dcf\u0daf\u0dba\u0dda\u0daf\u0dd3 \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0dba\u0db1\u0dca COPE \u0d91\u0dba\u0dca \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0dd2\u0dbd\u0dd2\u0dc0\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0d9c,\u0dad \u0d9a\u0dc5 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0 \u0d9c,\u0dd2\u0db1\u0dd2. \u0d85\u0daf \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dba\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc0 \u0dd4\u0dc5 COPE \u0d91\u0dba\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0 \u0d9c,\u0dd2\u0db1 \u0dc3\u0dc4 COPE \u0d91\u0dba\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c, \u0d9c,\u0dd2\u0db1 \u0d85\u0dca \u0d9c,\u0dab\u0dba\u0db1\u0dca \u0d86\u0da9\u0dd4\u0d9a\u0dca \u0db4\u0dca\u0dc2\u0dba\u0dba\u0db1\u0dca \u0dba\u0dc4\u0ddd \u0daf\u0dd3\u0dbb\u0dca\u0d9d \u0dc0\u0dba\u0dba\u0dba\u0db1\u0dca \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0dc0\u0dd4\u0dab\u0dcf. COPE \u0d91\u0dba\u0dca \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0db8\u0dcf \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0da7\u0dad\u0dca \u0db8\u0db8 \u0d92 \u0d9c,\u0dd2\u0db1 \u0dc3\u0dd4\u0da7\u0dd4 \u0dc0\u0db1\u0dc0\u0dcf. \u0d85\u0daf \u0dba\u0dba\u0daf\u0dca \u0d89\u0d9a\u0db1\u0dca\u0db8 \u0d9a\u0db1\u0dca\u0dba\u0da7\u0dca\u0db1\u0dbb\u0dca \u0dd2\u0dc0\u0daf\u0dca\u0db0\u0dd2\u0dba \u0d9c,\u0dd2\u0db1 \u0dba\u0dc0\u0db1\u0dad\u0dca \u0dba\u0dc0\u0db1\u0dad\u0dca \u0d86\u0dba\u0dad\u0db1 \u0d9c,\u0dd2\u0db1 \u0d9c,\u0dd2\u0da7\u0dbd\u0dd4 \u0dd2\u0dbd\u0dba\u0dcf\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dca \u0db8\u0dd4 \u0d9a\u0dc5\u0dcf. \u0dbb\u0da2\u0dcf\u0dba \u0db4\u0dd2\u0dad\u0dca\u0dad\u0da7 \u0dc3\u0d9f\u0dd2\u0dca \u0dbd \u0daf\u0dd2\u0d9c\u0dd4 \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dd2\u0dbd\u0db4\u0dca\u0dc2\u0dba \u0db4\u0dd2\u0dad\u0dca\u0dba\u0dad\u0db1\u0dca \u0dba\u0da0\u0ddd\u0daf\u0db1\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dca \u0db8\u0dd4 \u0dba\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0dba \u0db1\u0dc0\u0dcf.\n\nCOPE \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0 \u0dc3\u0dad\u0dca\u0dad\u0da7\u0db8 \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0\u0dba \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba\u0da7 \u0dba\u0dba\u0dcf\u0db8\u0dd4 \u0dc0\u0dd4\u0dba\u0da9\u0dd4\u0d9a \u0db8\u0dd3\u0da7 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0daf\u0dc4\u0dba\u0d9a\u0da7 \u0dd2\u0dbd\u0dad\u0dbb \u0dba\u0db4\u0dbb\u0dd2. \u0d92 COPE \u0d91\u0d9a \u0dd2\u0dbd\u0dd2\u0dc0\u0db1\u0dca \u0dd2\u0dc0\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dd2\u0dbd\u0db8\u0dbb\u0dca\u0dba\u0db1 \u0dba\u0dc4 \u0dd4\u0dba\u0dc0\u0db1\u0dd4\u0dd2. \u0db8\u0db8 \u0dc0\u0dd2\u0dbb\u0daf\u0dd2\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc4\u0dd2\u0dba\u0dad\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0d95\u0db1\u0dd1 \u0dba\u0d9a\u0dba\u0db1\u0db8\u0dcf\u0da7 \u0db1\u0dd2\u0dc0\u0dd2\u0dbb\u0daf\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d8a\u0da7 \u0dba\u0db4\u0dbb COPE \u0d91\u0dba\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0dd3\u0d9a\u0dad\u0dca\u0dc0\u0dba \u0dc3\u0db8\u0dca \u0db1\u0dca\u0db0\u0dba\u0dba\u0db1\u0dca \u0d91\u0dad\u0dbb\u0db8\u0dca\n\n\u0daf\u0dd2\u0db1\u0dd4\u0dc0\u0dad\u0dca\u0d9a\u0db8\u0dca \u0dba\u0dc4\u0ddd \u0d85\u0dc0\u0dba \u0ddd\u0db0\u0dba\u0dca \u0dba\u0db4\u0dcf\u0daf\u0dd4 \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0 \u0dd4\u0dc5 \u0dad\u0dd2\u0db6\u0dd4\u0dba\u0da9\u0dd4\u0d9a \u0db1\u0dd2\u0dc4\u0dd2. \u0d92\u0d9a\u0da7 \u0d91\u0d9a \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0dca \u0dba\u0dc0\u0db1\u0dca\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca COPE \u0d91\u0dba\u0dca \u0dd0\u0dc3 \u0dc0\u0dd3\u0db8\u0dca record \u0d9a\u0dbb\u0dbd\u0dcf \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0dba\u0db4\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0da7\u0db1\u0dca \u0d9c,\u0dd2\u0db1\u0dd3\u0db8. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d92 \u0d9a\u0dcf\u0dbd\u0dba \u0dd4\u0dc5 COPE \u0d91\u0dba\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0dd3\u0d9a\u0dad\u0dca\u0dc0\u0dba \u0d9c,\u0dd2\u0db1 \u0da2\u0dcf\u0db1\u0dad\u0dcf \u0db4\u0dd2\u0dc4\u0dd2\u0daf\u0dd3\u0db8\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf. \u0d85\u0dc5\u0dd2 \u0dba\u0dad\u0dca\u0dbb\u0dd4\u0db8\u0dca \u0d9c,\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0dba\u0daf\u0dca \u0dad\u0db8\u0dd2 \u0dba\u0db8\u0dca COPE \u0d91\u0d9a \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dbb\u0dcf\u0da2\u0dcf\u0dba \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0d86\u0dbb\u0dca\u0dc2\u0dcf \u0d9a\u0dbb \u0d9c,\u0dd2\u0db1\u0dd3\u0db8 \u0dc3\u0d9a\u0dc4\u0dcf \u0d91\u0dba\u0dc4\u0db8 \u0db1\u0dd2\u0dad\u0dca\u0db1\u0db8\u0dca \u0dbb\u0dcf\u0da2\u0dcf\u0dba \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dad\u0dd2\u0dbb\u0dc3\u0dcf\u0dbb \u0dba\u0dbd\u0dc3 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf \u0d9c,\u0dd2\u0db1\u0dd3\u0db8 \u0dc3\u0d9a\u0dc4\u0dcf \u0d85\u0dc0\u0dba\u0dba \u0dba\u0db4\u0d9a\u0dbb\u0dab\u0dba\u0dca \u0dc0\u0da7 \u0db4\u0dad\u0dca \u0dc0\u0db1\u0dca\u0dba\u0db1\u0dca \u0db1\u0dd2\u0dba \u0da0\u0dd2\u0dad \u0dba\u0daf\u0dca\u0dba\u0db4\u0dcf\u0dbd\u0db1 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dc3\u0dc4\u0dd2\u0dad\u0dc0 \u0dbb\u0dcf\u0da2\u0dcf\u0dba \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dc0\u0dbd\u0da7 \u0db8\u0dd2\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0dba\u0dc0\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0dd2\u0dbd\u0dad\u0dbb\u0dd2 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a."
