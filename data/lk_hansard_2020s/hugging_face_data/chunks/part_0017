0daf\u0db0\u0dd2\u0db1 \u0d9c\u0dd32 \u0daf\u0dca\u0dad\u0d9c\u0db1\u0dda2\u0dc0\u0dd0\u0da902\u0d9a\u0dba2 \u0dc0\u0dcf\u0daf2: \u0daf2\u0dad\u0dd2\u0dd6 2\u0dc0\u0dba\u0daf\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0d9a\u0dca \u0db802\u0d9a2 \u0dba\u0da9\u0dc0\u0dcf2 -2 \u0db8\u0dd3\u0dba \u0dc0\u0dda\u0d9c 2 \u0db1\u0dba\u0ddc\u0da7\u0dc3\u0dcf02 \u0d91\u0dc4\u0dd22 \u0db4\u0dca\u200d\u0dbb\u0dca\u200d\u0daf 2 \u0db1\u0dba\u0ddc\u0da7\u0dc3\u0dcf\u0dca2 \u0db1:\u0dba\u0d9a\u0dca \u0db82\u0dad\u0dd2\u0db1\u0dcf \u0dc0\u0daf02\u0db1 \u0dc4\u0dd2\u0daf\u0dd32\u0dc0\u0dd2\u0dad\u0d9a\u0dca \u0db8\u0dc2\u0d9a2\u0dc0\u0dd0\u0dbb\u0dd2\u0db12\u0db1\u0dcf\u0ddc\u0dbb\u0dad\u0dd4\u0db8\u0dd4\u0dc02\u0dc3\u0dcf \u0daf\u0da2\u0d9c\u0dcf2\u0dba\u0dbb \u0dc0\u0daf02\u0d91\u0dcf\u0dd0 \u0daf\u0dd32 \u0daf\u0dad\u0da72 \u0db1\u0dca\u0dda\u0dca\u200d2 \u0dc0\u0dd4\u0dab\u0daf2 \u0db1\u0dba\u0ddc\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0daf\u0dca \u0dba\u0dd4\u0dc0\u0dc0\u0db1\u0dca2 \u0d91\u0d9a\u0dca \u0db8\u0dba2 \u0dc0\u0dd2\u0dba\u0daf\u0dbd2negotiation \u0d91\u0dba\u0dba\u0da72\u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca2 \u0dd0\u0dc0\u0dcf2\u0d9a2\u0db1\u0dba\u0ddc\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0daf\u0dca \u0dad\u0dd4\u0db8\u0dc02\u0dad\u0dc0\u0dca \u0dc0\u0daf\u0db1\u0d9c 2 \u0d9a\u0dd1\u0db1\u0dda2 \u0dba\u0daf\u0dca\u0dad\u0d9a\u0d9a\u0da72 \u0d91\u0db1\u0dca 02 \u0d94\u0dc0\u0dd4\u0db1\u0dca2 \u0db1\u0dba\u0ddc\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0daf\u0dca \u0dad\u0dd4\u0db8\u0dc02\u0daf\u0dca \u0dc3\u0dcf\u0db1\u0dca2 \u0dba\u0dbb\u0dbd\u0daf2 \u0daf\u0dc0\u0dd4\u0dd4\u0dc0\u0daf\u0dd42 \u0dad\u0dbb\u0dba\u0da72 \u0d86\u0dc3\u0dcf\u0db1\u0dca 2 \u0dba\u0daf\u0dbd\u0d9a\u0d9a\u0dca \u0db82 \u0db8\u0dd4:\u0db12 \u0db1\u0dbb\u0ddc\u0d9a\u0daf2\u0d9c\u0db1\u0dca\u0db1\u0db1\u0dca2 \u0dd0\u0dad\u0dd4\u0db8\u0dc022\u0d9a2\u0db1\u0dba\u0ddc\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0daf\u0dca \u0dad\u0dd4\u0db8\u0dc02\u0dc0\u0dc3\u0dcf\u0db1\u0dbb\u0db1\u0dca2\u0dc0\u0dc3\u0dcf\u0dbb2\u0daf\u0dd3\u0dca\u0dad\u0d9d2\u0dba\u0dbb\u0db1\u0d9c 2\u0d87\u0dc0\u0dd2\u0db1\u0dbd\u0daf2 \u0dad\u0dd2\u0db1\u0dcf \u0dc0\u0daf2 \u0d91\u0dba2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0d9a\u0d9a\u0dca \u0db8\u0dc0\u0dca 2 \u0db1\u0dc0 \u0dc3\u0dcf\u0dca2 \u0dba\u0dbb\u0db1\u0dca\u0db1\u0db1\u0dca2 \u0dd0\u0dad\u0dd4\u0db8\u0dc002 \u0d91 2 \u0db1\u0dd2\u0dc3\u0dcf\u0daf2 \u0daf\u0dad\u0da72 \u0dc3\u0dcf\u0dd0\u0dba\u0d9a\u0d9a\u0dca \u0db82 \u0dad\u0dd2\u0db1\u0dcf \u0dc0\u0daf\u0d8b2 \u0dc0\u0dd2\u0d82\u0da0\u0daf\u0dc0\u0d9a\u0dca \u0db82 \u0db1\u0dbb\u0dbd2\u0daf\u0dd6\u0dc2\u0dab\u0d9a\u0d9a\u0dca \u0db82 \u0dba\u0dc5\u0daf:2 \u0d9a\u0dd2\u0d9a\u0dbd\u0daf02 \u0db1\u0da9\u0ddc\u0dbd\u0dca\u0dad\u0dc0\u0dbd\u0dd2\u0db1\u0dca2 \u0dc0\u0dd2\u0d9a:\u0dda2 \u0dba\u0dbb 2 \u0d9a\u0dc0\u0daf2 \u0daf\u0dd4\u0dc02\u0d9a\u0dd2\u0dbb\u0dd3 2 \u0dad\u0dd0\u0dbb\u0dab\u0dd22 \u0daf\u0db1\u0dd4\u0dad\u0daf\u0dcf\u0d9a\u0da7\u0d8b2 \u0d9a2 \u0d9a\u0dd2\u0d9a\u0db1\u0dca\u0db1\u0db1\u0dca2 \u0dd4\u0dc0\u0dd2\u0dc5\u0d9a\u0db12 73.\u0da72 \u0db1\u0d9a\u0ddc:\u0dbd\u0daf2\u0dad\u0dd2\u0db6\u0dd4\u0dab\u0daf02 \u0d9a2 \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4 2 \u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dca \u0dba2 \u0db1\u0dc0\u0dd2\u0dba\u0db1\u0dca2 \u0dad\u0dd2\u0db6\u0dd4\u0db1\u0dca\u0da902 \u0db8\u0dd4\u0dca \u0d8b2 \u0daf\u0db1\u0db4\u0dca2\u0d86\u0dca\u0da9\u0da9\u0dd4\u0dc02 \u0d86\u0dc0\u0daf 2 \u0daf\u0dd2\u0dc52 \u0d9a\u0dba2 \u0daf\u0db1\u0dbb\u0dbd\u0db1\u0dca2 \u0dba\u0dc5\u0daf2 \u0dda2 \u0da9\u0dd42 \u0dba\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc0\u0dbd\u0da72\u0d9a\u0db1\u0dca 2\u0db1\u0dca\u0daf\u0dd42\u0dc0 \u0dc0\u0daf02\u0d9a2\u0dc3\u0dcf \u0dbb\u0daf2\u0dcf\u0dc0\u0dca 2\u0daf\u0dd3\u0dca\u0dad\u0d9d2\u0dba\u0daf\u0dbd\u0d9a\u0d9a\u0dca \u0db82\u0d9a 2\u0db1\u0dd2\u0dc3\u0dcf\u0daf\u0d8b2\u0d91\u0dd4\u0dca2\u0dad\u0daf\u0da9\u0dd4\u0dc0\u0dca 2 :\u0dbb\u0dd2\u0dba\u0db1\u0dca2 \u0daf\u0dd2\u0dc52 \u0daf\u0dd2\u0db1\u0dc0\u0dda\u0d9a\u0da72 \u0d9c\u0dd2\u0d9a\u0daf02 \u0d9a2 \u0daf\u0db1\u0dd4\u0dc02 \u0daf\u0dca\u0dad\u0d9c\u0db1\u0dda2 \u0dad\u0dc5\u0db8\u0dd42\u0db1\u0dba\u0ddc\u0da7\u0dc3\u0dcf\u0dca 2\u0daf\u0dd2\u0dc52\u0db1\u0db6\u0dca\u0dbb\u0daf2\u0d9c\u0dca \u0dcf\u0daf022\u0dbb\u0dd0\u0dcf\u0dd0\u0dba\u0dd2\u0d8b2\u0d9a\u0dda2\u0dad\u0daf\u0da9\u0dd4\u0dc0\u0d9a\u0dca \u0db82:\u0dbb\u0db1\u0dca 2\u0db1\u0dca\u0dda\u0dca\u200d2\u0dc0\u0dd4\u0dab\u0daf02\n\n\u0d9a\u0dca 2 :\u0dd0\u0db1\u0dca2 \u0daf\u0dd2\u0dc52 \u0d91\u0dba\u0d9f2 \u0db1\u0dc0\u0dbd\u0daf2 \u0dad\u0dd2\u0db1\u0dcf \u0dc0\u0daf\u0d8b2 \u0d9a2 \u0db1: 2 \u0db1\u0dad\u0ddc\u0dbd\u0dd32\u0daf\u0db1\u0dd4\u0dad\u0daf\u0dcf\u0db1\u0d9a\u0db1\u0dca2 \u0daf\u0dad\u0da72 :\u0dba 2 \u0dba2 \u0dc0\u0da7\u0dca\u0da7 \u0d9a\u0dca \u0db82 - discount \u0d91\u0dba\u0d9a\u0dca \u0db82-2\u0dbd\u0dcf\u0daf2\u0d9c\u0db1\u0dca 02:\u0dd0 \u0da72\u0da0\u0dd3 \u0db1\u0dda2\u0db1\u0dda2\u0db1\u0dad\u0ddc\u0dbd\u0dd32\u0daf\u0db1\u0dd4\u0dad\u0daf\u0dcf\u0d9a2\u0db1\u0dca\u0d9a\u0d9a\u0da7230.\u0d9a\u0dca \u0db82\u0dc0\u0daf\u0db1 2\u0d9c\u0dab \u0dba2\u0dad\u0dd2\u0db1\u0dcf\u0db1\u0dca\u0db1\u0db1\u0dca02\u0d91\u0dba\u0dd2\u0db1\u0dca2:\u0dba 2 \u0d9a\u0dca \u0db82\u0daf\u0da9\u0dd42\u0dba\u0dc5\u0daf \u0d8b2\u0db1\u0dca\u0d9a\u0d9a\u0da72004\u0dba\u0dd202\n\n\u0d9c\u0dd4 \u0db8\u0dd6\u0dbd\u0dcf\u0dca\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dd9\u0dca\u0daf\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dd4\u0dbb\u0dd9\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0b95\u0bb2\u0b95\u0bae\u0ba4\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0d94\u0dcf\u0dad\u0dd4\u0db8 \u0daf\u0da72\u0db1\u0dd2\u0d9a\u0dd2\u0dba\u0dcf2\u0dba\u0daf\u0dbd\u0d9a2\u0daf\u0dc0\u0dc3\u0dcf\u0daf \u0dba\u0dd2\u0d8b2\u0d9c\u0dd4\u0dc02\u0daf \u0daf\u0dcf\u0dba\u0dad\u0dd4\u0db8 \u0db1\u0dd20\n\n\u0d9c\u0dd4 (\u0d86 \u0dcf\u0dbb\u0dca\u0dba) \u0d85\u0db1\u0dd2\u0dbd\u0dca \u0da2\u0dba\u0dca\u0daf \u0dd9\u0dc4\u0dc3 \u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 (\u0b95\u0bb2\u0bbe \u0bbf\u0ba4\u0bbf) \u0b85\u0ba9\u0bbf\u0bb2\u0bcd \u0b9c\u0baf\u0ba8\u0bcd\u0ba4) (The Hon. (Dr.) Anil Jayantha) \u0da72 \u0dcf\u0dc02 \u0dcf\u0dca \u0dad\u0dbb2 \u0d9a\u0dd2\u0dc4\u0dd2\u0dad\u0d9a\u0d9a\u0dca \u0db82 \u0db1:\u0db1\u0dca \u0d8b2 \u0dc4\u0dd2\u0dbd\u0daf\u0dc3\u0dcf \u0daf\u0dd6\u0daa\u0dad\u0dca2 \u0d9c\u0dd4\u0dc02 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8 \u0db1\u0dd202"
