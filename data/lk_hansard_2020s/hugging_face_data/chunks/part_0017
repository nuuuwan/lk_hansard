    "chunk_text": "\u0db8\u0db8 \u0d9c\u0db1\u0d9a \u0d9c \u0dcf\u0da9\u0dd2 \u0dc3\u0daf\u0dcf\u0dc4\u0dbb\u0dab\u0dba\u0d9a\u0dd2\u0dca\u0db8 \u0db4\u0dc4\u0db4\u0daf\u0dd2\u0dbd\u0dd2\u0db8 \u0d9a\u0dbb\u0dca\u0db1\u0db1. \u0d85\u0db4\u0dd2 \u0daf\u0dca\u0db1\u0dc0\u0dcf, \u0db8\u0dd3\u0dbb \u0d9c \u0dbb \u0dbb\u0db4\u0dd4 \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2 \u0dad\u0dd2 \u0dbb\u0db1\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u200d\u0dbb\u0db8\u0dc3\u0dd2\u0d9c\u0dc4 \u0db8\u0dd6\u0d9a\u0dba \u0d85\u0dc0\u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dba \u0dc3\u0dd2\u0db0 \u0d9a \u0d9c\u0dc5\u0dda \u0d9c\u0d9a\u0dcf\u0d9c\u0dc4\u0dcf\u0db8\u0daf \u0d9a\u0dd2\u0dba\u0d9a\u0dcf. \u0dc4\u0dc0\u0d9a\u0dbb \u0dc3\u0dd4\u0dbb\u0dcf\u0dca\u0daf\u0dd4 \u0d9c\u0d9a\u0dcf\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dda \u0da2\u0dca\u200d\u0db1\u0dbb\u0dcf\u0dbd\u0dca\u0dc0\u0dbb\u0d9c\u0dba\u0dca \u0da7\u0dd2\u0dba\u0dcf. \u0dcf \u0dc0\u0db1 \u0dc0\u0dd2\u0dbb \u0d87\u0dad\u0dca\u0dad\u0dbb\u0db8 \u0dc0\u0dd2\u0dc1\u0dcf\u0d9a \u0dca\u0daf\u0dd4 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dca \u0d85\u0dba \u0d9c\u0dc0\u0dca\u0db1 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf, \u0dc0\u0dd2\u0d9c\u0dc1\u0dda\u0dc2\u0d9c\u0dba\u0dca \u0d9c\u0db8\u0dca\u0da9\u0dd2\u0dc3\u0dda \u0dc3\u0db8\u0dcf\u0db8\u0db8, \u0dc0\u0dba\u0db9 \u0da9\u0dd2\u0dc3\u0dda\u0da7\u0dd2\u0d9a\u0dbb\u0dd3\u0dc3\u0dda, \u0dc6\u0dd2\u0dca\u0d9a\u0dca\u0dda \u0da9\u0dd2\u0dc3\u0dda\u0da7\u0dd2\u0d9a\u0dbb\u0dd3\u0dc3\u0dda \u0dc0\u0db4\u0db1\u0dd2 \u0d86\u0dba\u0dad\u0db1 7\u0d9a\u0dd2\u0dca \u0dc0\u0dd2\u0dad\u0dbb. \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0d9c\u0d9a\u0dcf\u0da0\u0dca \u0dbb\u0daf \u0d9a\u0dd2\u0dda\u0d9c\u0dc0\u0dcf\u0dad\u0dca, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0db8\u0dba\u0db1 7,222\u0dca \u0dca\u0daf\u0dd4 \u0d9c\u0db1\u0dcf\u0d9c\u0db8\u0dc0\u0dcf \u0d94\u0dc0\u0dd4\u0dca\u0d9c\u0dda \u0dc0\u0dba\u0dcf \u0dcf\u0dbb \u0d9a\u0dbb\u0d9c\u0db8\u0db1 \u0d9c\u0dd2\u0dba\u0dcf. \u0d9c\u0db1 \u0dca\u0daf\u0dd4 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0dca \u0d85\u0daf\u0dcf\u0dc5 \u0d9a\u0d9c\u0dda\u0dbb, \u0d85\u0daf\u0dcf\u0dc5 \u0dc0\u0dba\u0dd2\u0dca \u0dc3\u0dda\u0d9c\u0dbb\u0ddd\u0dca\u0dc3\u0dda \u0dc4\u0d9a\u0dbb \u0d9c\u0db8\u0dc0\u0d9a\u0dcf\u0dba\u0dd2 \u0dad\u0dd2\u0d9c\u0dca\u0dca\u0d9c\u0dca. \u0db8\u0dad\u0dca \u0db4\u0dca \u0d9c\u0dca\u0ddd\u0dad\u0d9a\u0dba\u0dca \u0db8\u0dd2\u0d9a\u0daf\u0dd3 \u0db8\u0dca\u0db1\u0d9c\u0d9a\u0dcf\u0dbb, \u0d9c\u0daf\u0d9a\u0dca \u0db8\u0dd2\u0d9a\u0daf\u0dd3 \u0db8\u0dca\u0db1\u0d9c\u0d9a\u0dcf\u0dbb \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0d8a\u0dbb \u0d85\u0daf\u0dcf\u0dc5 \u0dc0\u0db1 \u0dca\u0daf\u0dd4 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d9c\u0db8\u0dc0\u0d9a\u0dcf \u0dad\u0dd2\u0d9c\u0dca\u0dca\u0d9c\u0dca. \u0d9c\u0db8\u0dca\u0db1 \u0d9c\u0db1 \u0dca\u0daf\u0dd4 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d9c\u0db1\u0dcf\u0d9c\u0db8\u0dc0\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0db8\u0dba\u0db1 7,222\u0dca \u0d94\u0dc0\u0dd4\u0dca \u0dbb\u0db3\u0dc0\u0dcf\u0d9c\u0db8\u0db1 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf. \u0d9c\u0db8\u0dcf\u0d9a\u0daf \u0d9a\u0d9c\u0dc5\u0dda, \u0dbb\u0db1\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u200d\u0dbb\u0db8\u0dc3\u0dd2\u0d9c\u0dc4 \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2 \u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf? \u0dc4\u0dc0\u0d9a\u0dbb \u0dc3\u0dd2\u0da7\u0dd2 \u0dc3\u0dd4\u0dbb\u0dcf\u0dca\u0daf\u0dd4 \u0d9c\u0d9a\u0dcf\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dda \u0da2\u0dca\u200d\u0db1\u0dbb\u0dcf\u0dbd\u0dca\u0dc0 \u0d9a\u0db4 \u0db3\u0dc0\u0d9a\u0dcf \"\u0dad\u0db8\u0dd4\u0dca \u0d9c\u0db8\u0dcf\u0d9a\u0daf \u0db8\u0d9c\u0dda \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dca\u0dbb \u0d9a\u0dbb\u0daf\u0dbb \u0d9a\u0dbb\u0dca\u0d9c\u0dca? \u0d9c\u0db1\u0d9c\u0dca \u0dad\u0db8\u0dd4\u0dca\u0dbb \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0dca \u0db1\u0db4\u0dc4\u0db4. \u0d9c\u0db1\u0d9a \u0db8\u0d9c\u0dda \u0dc0\u0dd2\u0dc2\u0dba \u0dae\u0dba\u0dca. \u0dad\u0db8\u0dd4\u0dca\u0dbb \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0dca \u0db1\u0db4\u0dc4\u0db4. \u0dad\u0db8\u0dd4\u0dca\u0db1\u0dcf\u0dca\u0d9c\u0dc3\u0dda \u0dad\u0db8\u0dd4\u0dca\u0d9c\u0dda \u0dc0\u0db4\u0da9\u0dbd\u0dca \u0dca\u0d9a\u0dcf \u0db8\u0dca\u0db1\u0dc0\u0dcf\" \u0d9a\u0dd2\u0dba\u0d9a\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0d94\u0d9c\u0dc4\u0dcf\u0db8 \u0d9c\u0daf \u0dcf\u0dbb\u0dca \u0d9a\u0db4\u0db3\u0dc0\u0d9a\u0dcf \u0d94\u0dc4\u0dd4\u0dbb \u0dad\u0dca\u0da2\u0dca\u200d\u0db1\u0dba \u0d9a\u0dc5\u0dcf. \u0d94\u0dc4\u0dd4\u0dc0 \u0d85\u0dc3\u0dda \u0d9a\u0dbb\u0dca\u0db1 \u0dba\u0db1\u0d9c\u0d9a\u0dcf\u0dbb \u0d94\u0dc4\u0dd4 \u0d89\u0dbd\u0dca\u0d9a\u0dcf \u0d85\u0dc3\u0dda\u0d9c\u0dc0\u0d9a\u0dcf \u0dba\u0dca\u0db1 \u0d9c\u0dd2\u0dba\u0dcf. \u0d85\u0dca\u0db1 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0d85\u0dc0\u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf\u0dc0. \u0d9c\u0d9a\u0ddd, \u0dc4\u0dad\u0db4\u0db1 \u0db8\u0dd6\u0d9a\u0dba \u0dc0\u0dd2\u0db1\u0dba? \u0d9c\u0db1\u0d9a\u0dbb \u0dad\u0db8\u0dba\u0dd2 2218\u0daf\u0dd3 \u0d9c\u0db1 \u0dc3\u0d9c\u0d9c\u0dc1\u0ddd \u0db1 \u0d9c\u0dda\u0dca\u0db1 \u0d9c\u0daf\u0dca\u0d9c\u0dca \u0db1\u0db4\u0dad\u0dd2\u0dc0 \u0d9c\u0db8\u0dcf\u0dc0\u0dd4\u0dca \u0dad\u0dd2\u0dba\u0dcf\u0d9c\u0db8\u0db1 \u0dbb\u0db4\u0dd4 \u0dad\u0da7\u0dd4 \u0d9a\u0db4\u0db4\u0dd6 \u0dc0\u0dd2\u0db8\u0dab\u0db1 \u0d9c\u0daf \u0dcf\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dca, \u0dc0\u0dd2\u0db8\u0dab\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba\u0dca \u0dca\u0dc0\u0dbb \u0dad\u0dca \u0d9a\u0d9c\u0dc5\u0dda.\n\n\u0d85\u0db4\u0dd2 \u0daf\u0dca\u0db1\u0dc0\u0dcf, \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0dc3\u0dad\u0dd4\u0dbb, \u0dcf\u0dad\u0daf\u0dd4\u0db1\u0dca\u0dbb \u0dba\u0db1 \u0dca\u200d\u0dbb\u0d9c\u0db0\u0dc1\u0dc0\u0d9a \u0dcf\u0d9a\u0dcf\u0dca\u0db0 \u0da2\u0dca\u200d\u0d9a \u0dc0\u0dba\u0dcf \u0dca\u0dad\u0dd2\u0dba \u0db8\u0dd3\u0dbb \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0dad\u0dd4\u0db1\u0d9a\u0dbb \u0d9a\u0dbd\u0dd2\u0db8\u0dca \u0db1\u0dad\u0dbb \u0dc0\u0dd4\u0dab\u0dd4 \u0dca\u0dc0. \u0d9c\u0db1\u0d9a 2219 \u0da0\u0dd3\u0db1 \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dba\u0dbb\u0d9c\u0dad\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d86\u0dbb\u0db1\u0db7 \u0d9a\u0d9c\u0dc5\u0dda. \u0d9c\u0db8 \u0dc0\u0db4\u0da9\u0dbd \u0dc3\u0dd2\u0dba\u0dba\u0dbb 89\u0dca \u0d85\u0dc0\u0dc3\u0dca \u0d9a\u0dbb\u0d9a\u0dcf \u0dad\u0dd2\u0d9c\u0dca\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0daf\u0dca\u0db1\u0dc0\u0dcf, \u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d9a\u0dcf\u0d9a\u0d9c\u0d86 \u0d85\u0d9c\u0dca \u0dbb\u0dbb \u0db1\u0dad\u0dbb \u0dc0\u0dd4\u0dab\u0dd4 \u0dbb\u0dbb\u0dca \u0dca\u0dc0\u0dbb \u0dad\u0dca \u0dc0\u0dd4\u0dab\u0dcf \u0d9a\u0dd2\u0dba\u0d9a\u0dcf. \u0d85\u0db4\u0dd2 \u0d9c\u0db1 \u0dbb\u0dbb \u0db7\u0dcf\u0dbb \u0db8\u0dca\u0db1\u0d9c\u0d9a\u0dcf\u0dbb \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dba\u0dcf \u0dca\u0dad\u0dd2\u0dba\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9c\u0db1\u0dcf\u0dc0\u0db1, \u0db1\u0dad\u0dbb \u0d9c\u0dc0\u0da0\u0dca \u0dbb\u0dbb\u0dca \u0dca\u0dc0\u0dbb \u0dbb\u0dd2\u0dc0\u0dca\u0dad\u0db1\u0dba \u0d9c\u0dc0\u0d9a\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0d9c\u0dca. \u0db1\u0dad\u0dbb \u0d9c\u0dc0\u0d9a\u0dcf \u0dad\u0dd2\u0d9c\u0dca\u0db1 \u0dc0\u0dba\u0dcf \u0dca\u0dad\u0dd2 \u0daf\u0db4\u0dca \u0d86\u0dbb\u0db1\u0db7 \u0d9a\u0dbb\u0db1\u0d9c\u0d9a\u0dcf\u0dbb \u0dca\u200d\u0dbb\u0db8\u0dcf\u0daf \u0db8\u0dcf\u0dc3\u0dda\u0dad\u0dd4 \u0dc0\u0dc1\u0d9c\u0dba\u0dca \u0dc0\u0dd2\u0dc1\u0dcf\u0d9a \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dca \u0d9c\u0db8\u0dc0\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dcf \u0d9c\u0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0dca interests, \u0dc4\u0d9c\u0dc4\u0db8 \u0db1\u0db4\u0dad\u0dca\u0db1\u0db1 \u0d9c \u0dcf\u0dbd\u0dd2\u0db8 \u0d85\u0db1\u0dd4 \u0dcf\u0dad \u0d9c\u0db8\u0dc0\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dcf \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0d9a \u0d85\u0dc0\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dd3\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0dc0\u0dd2\u0dc1\u0dcf\u0d9a \u0db8\u0dd4\u0daf\u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0dcf \u0dc3\u0db8\u0dcf\u0db8\u0db1\u0dc0\u0d9a\u0dbb \u0d9c\u0db8\u0dc0\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dcf \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0d9c\u0db1 \u0dc0\u0dba\u0dcf \u0dca\u0dad\u0dd2\u0dc0\u0d9a\u0dbb \u0d85\u0daf\u0dcf\u0dc5 \u0d9c\u0db0\u0dc1\u0dd3\u0dba \u0d9c\u0d9a\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dcf\u0dad\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0dca\u0dbb, \u0dc3 \u0d9c\u0d9a\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dcf\u0dad\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0dca\u0dbb \u0d9c\u0db8\u0dc0\u0dca\u0db1 \u0dad\u0dd2\u0d9c\u0dca\u0db1 \u0dc0\u0dd2\u0dc1\u0dcf\u0d9a \u0db8\u0dd4\u0daf\u0d9a\u0dca \u0d9c\u0db8\u0dd3\u0db8 \u0db4\u0dc4\u0db4\u0dbb \u0dc4\u0db4\u0dbb\u0d9a\u0dcf \u0dad\u0dd2\u0d9c\u0dca\u0db1\u0dc0\u0dcf. \u0d89\u0dad\u0dd2\u0dca, \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0d9c\u0dda \u0dcf\u0db1\u0dd3\u0dba \u0da2\u0dca\u200d\u0d9a \u0d85\u0dc0\u0dc1\u0dba\u0dad\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0d9c\u0dca \u0dbb\u0da2\u0dca\u200d\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0db8\u0dba\u0db1 12.3\u0d9a\u0dbb \u0d86\u0dc3\u0dca\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dca \u0d9c\u0dc0\u0dca \u0d9a\u0dbb\u0d9a\u0dcf"
  },
