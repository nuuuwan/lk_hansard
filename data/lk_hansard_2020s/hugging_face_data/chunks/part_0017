    "chunk_text": "\u2022 \u0d89\u0db1\u0dca\u0dd2\u0db1 \u0dc1\u0dc0 \u0dc4\u0dc1 \u0d89\u0d9a\u0dca\u0dc0\u0dba\u0dd9\u0ddd\u0dbb \u0dad\u0dca\u200d\u0db8 \u0db1\u0dd2\u0dc2\u0dc0\u0db4\u0dc1\u0dd9\u0db1 \u0d85\u0da9\u0dd4 \u0db1\u0dd2\u0dc2\u0dc0\u0db4\u0dc1\u0dd9\u0db1 \u0db4\u0dd2\u0dbb\u0dd2\u0dc0\u0dd0 \u0d9a\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0db4\u0dd9\u0dc0\u0dc1 \u0d85\u0da9\u0dd4 \u0db8\u0dd2\u0dbd\u0d9a \u0d85\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dca\u0dbd\u0da2\u0dc1\u0dad\u0dd2\u0dc3\u0d9a \u0dba\u0dc0\u0dc5\u0db3\u0dba\u0db4\u0dc1\u0dc5 \u0dba\u0dc0\u0dad\u0dca\u200d \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dba\u0dc4\u0dc0\u0dad\u0dd4\u0dba\u0dc0\u0db1\u0dca \u0db1\u0dd2\u0dc2\u0dc0\u0db4\u0dc1\u0dd9\u0db1 \u0d85\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dca\u0dbd\u0da2\u0dc1\u0dad\u0dd2\u0dc3\u0d9a \u0db8\u0dd2\u0dbd \u0db7\u0db8\u0d9f \u0db7\u0dd0\u0db7\u0db3\u0dd3\u0dba\u0dda \u0daf\u0dd3 \u0db4\u0dd2\u0dbb\u0dd2\u0dc0\u0dd0 \u0db7\u0dc1\u0dba\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dc0 \u0d89\u0db7\u0dc0\u0db7\u0db1\u0dca \u0d9a\u0dbb\u0dca\u0dbd\u0db8\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d \u0dbd\u0dc1\u0d82\u0dd9\u0dc1\u0dba\u0dd3 \u0dba\u0db1\u0dc1\u0dc0\u0db1 \u0dad\u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0d9a \u0db4\u0dad\u0dca \u0dc0\u0dd3 \u0d87\u0dad\u0dca\u200d. \u0dba\u0db8 \u0db4\u0dd2\u0dc5\u0dd2 \u0db8\u0d9a\u0dca \u0dba\u0dbd\u0db7 \u0dd2\u0dc1\u0dba\u0db1\u0dc0\u0dc2 \u0dba\u0dc0\u0dc5\u0db3\u0dba\u0db4\u0dc1\u0dc5\u0d9a\u0dca \u0dba\u0dc0\u0dad\u0dca\u200d \u0dba \u0dc1\u0db8\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0dda \u0d85\u0dbb\u0db8\u0dd4\u0dab\u0dd2\u0db1\u0dca \u201cSri Lankan Jumbo Shrimp\u201d \u0db1\u0dc1\u0db8 \u0dba\u0dad\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dd2\u0dc1\u0db1\u0dc1\u0dbd\u0dad\u0dca\u0dc0\u0dba \u0db1\u0dca \u0dba\u0dd4\u0dad\u0dca \u0d89\u0db7\u0dc0\u0db7\u0db1\u0dca \u0dc0 \u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0 \u0dc1\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dd2\u0db1\u0dbb\u0dd2 \u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd3.\n\n\u2022 \u0dba\u0db8\u0db8 \u0dba\u0dbb\u0dc1\u0db1\u0dca \u0db8\u0da9 \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca \u0d89\u0db7\u0dc0\u0db7\u0db1\u0dca \u0dc0 \u0dc1\u0dc0 \u0dc4\u0dc1 \u0db0\u0dd3\u0dc0\u0dbb \u0d9a\u0dbb\u0dca\u0dbd\u0db8\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dbd\u0db6\u0dc1 \u0dad\u0dca\u200d \u0dc4\u0dd0\u0d9a\u0dd2 \u0db1\u0dd2\u0dc2\u0dc0\u0db4\u0dc1\u0dd9\u0db1 \u0dc0\u0dd0\u0da9\u0dd2\u0dc0\u0dd3\u0db8 \u0dc3\u0dd2\u0daf\u0dd4 \u0dba\u0dc0\u0db1 \u0d85\u0dad\u0dca\u200d\u0dbb, \u0dba\u0dda \u0db7\u0db3\u0dc4\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0db4\u0dc1\u0dd9\u0db1 2026 \u0dc0\u0dbb\u0dca\u0dbd\u0dc2 \u0db7\u0db3\u0dc4\u0dc1 \u0d89\u0dbd\u0dca\u0dbd\u0dbd\u0dd4\u0dda \u0d9a\u0dbb \u0d87\u0dad\u0dca\u200d.\n\n\u2022 \u0dd2\u0dc1\u0dba\u0db1\u0dc0\u0dc2\u0dba \u0db1\u0dca \u0db4\u0dad\u0dd4\u0dbb\u0dd4 \u0dc4\u0dc1 \u0db1\u0dd0\u0dba \u0db1\u0dd2 \u0dbb \u0d89\u0db7\u0dc0\u0db7\u0db1\u0dca \u0dc0 \u0dc1\u0dc0 \u0db7\u0db3\u0dc4\u0dc1 \u0dc4\u0db3\u0dd4\u0db1\u0dc1 \u0db1\u0dca\u0db1\u0dc1 \u0dbd\u0dd9 \u0d89\u0da9\u0dda \u0db4\u0dbb\u0dd2\u0db7\u0dbb \u0dd2 \u0dad\u0dca\u200d\u0d9a\u0dc1\u0db8\u0dd3 \u0dba \u0dc1\u0dd2\u0dc1\u0db4\u0dc5 \u0d86\u0d9a\u0dc1\u0dbb \u0d89\u0db7\u0dc0\u0db7\u0db1\u0dca \u0dc0 \u0dc1\u0dc0 \u0db7\u0d9c\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0dca\u200d\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db7\u0db3\u0dc4\u0dc1 \u0dbd\u0db6\u0dc1 \u0dd0\u0db1\u0dd3\u0db8 \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d85\u0db4\u0db1 \u0db1 \u0db7\u0db3\u0dc4\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dab\u0dc0\u0dad\u0dca \u0d89\u0db7\u0dc0\u0db7\u0db1\u0dca \u0d85\u0db7\u0dc0\u0dc0\u0dd0\u0db1\u0dca\u0db1\u0d9a\u0dca \u0db7\u0dd0\u0d9a\u0dc3\u0dd4\u0dda \u0db8\u0db0\u0dca\u200d\u0dba\u0db7\u0dc0\u0dae\u0dc1\u0db1 \u0dba\u0dc0\u0dad\u0dca\u200d \u0dbd\u0db6\u0dc1\u0daf\u0dd3\u0db8 \u0d85\u0dba\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dc1 \u0dba\u0d9a\u0dba\u0dbb\u0dca\u0dbd.\n\n(\u0d87) \u0d85\u0dd9\u0dc1\u0dc5 \u0dba\u0db1\u0dc1\u0dba\u0dda.\n\n\u0dd9\u0dd4 \u0d85\u0da2\u0dd2\u0dad\u0dca \u0d9c\u0dd2\u0dc4\u0dc3\u0dcf\u0dca \u0db8\u0dc4\u0dc3\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b85\u0b9c\u0bbf\u0ba4\u0bcd \u0b95\u0bbf\u0bb9\u0bc6\u0bbe\u0ba9\u0bcd) (The Hon. Ajith Gihan) \u0dbb\u0dd4 \u0d9a\u0dae\u0dc1\u0db1\u0dc1 \u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0db8\u0dba \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dc0\u0db1 \u0dba\u0db8 \u0dba\u0dd2.\n\n\u0dbb\u0dd4 \u0d85\u0db8\u0dc1\u0dad\u0dca\u200d\u0dba\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0dba\u0dda \u0dba\u0dc0\u0db1\u0dba\u0d9a\u0dc1 \u0dd2\u0dc1\u0dba\u0db1\u0dc0\u0dc2\u0dba \u0db1\u0dca \u0dba\u0dd4\u0dba\u0dbb\u0ddd\u0db4 \u0db7\u0dc4 \u0db6 \u0dd2 \u0dbb \u0dbb \u0dc0\u0dbd \u0d89\u0db7\u0dc0\u0db7\u0db1\u0dca \u0d85\u0db4\u0db1 \u0db1 \u0d9a\u0dbb\u0db1\u0dc0\u0dc1.\n\n\u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d85\u0db4\u0dd2 \u0dd9\u0db1\u0dca\u0db1\u0dc0\u0dc1 \u0dbb \u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db7\u0db8\u0dc4\u0dbb \u0dbb \u0dc0\u0dbd \u0db1\u0dd2\u0dc2\u0dc0\u0db4\u0dc1\u0dd9\u0db1\u0dc0\u0dbd \u0db6\u0daf\u0dd4 \u0db4\u0db1\u0dc0\u0dc1 \u0dad\u0dd2\u0dc3\u0dba\u0db6\u0db1 \u0db6\u0dc0. \u0dc0\u0dc1\u0dba \u0db8 ban \u0d9a\u0dbb\u0dbd\u0dc1 \u0dad\u0dd2\u0dc3\u0dba\u0db6\u0db1\u0dc0\u0dc1. \u0dad\u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0dad\u0dd4\u0dc5 \u0d85\u0dba\u0db4\u0dca \u0dbb \u0d89\u0db7\u0dc0\u0db7\u0db1\u0dca \u0dba \u0db1\u0dd0\u0dbd\u0dca\u0dbd\u0dbd\u0dc1 \u0d85\u0db4\u0db1 \u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0dda \u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dc0\u0dbd\u0dd2 \u0dc0\u0dd0\u0da9\u0dd2 \u0dba\u0dc0\u0db1\u0dca\u0db1 \u0dd4 \u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0dbb\u0db8 \u0dad\u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0\n\n1099 1100\n\n[ \u0dbb\u0dd4 \u0d85\u0da2\u0dd2\u0dad\u0dca \u0d9c\u0dd2\u0dc4\u0dc1\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dca\u200d\u0dc1]\n\n2025 \u0db7\u0dd0\u0db4\u0dca\u0dad\u0dca\u200d\u0dd0\u0dda\u0db6\u0dbb\u0dca\u0dbd 25\n\n\u0d85\u0dba\u0db4\u0dca \u0d89\u0db7\u0dc0\u0db7\u0db1\u0dca \u0d9a\u0dbb\u0dca\u0dbd\u0db8\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d \u0db6\u0dbd\u0db4\u0dc1\u0db1\u0dc0\u0dc1. \u0dba\u0dda \u0dba \u0dba\u0db1\u0db1 \u0d89\u0db7\u0dc0\u0db7\u0db1\u0dca\u0dba \u0db1\u0dca \u0da2\u0dbd \u0da2\u0dd3\u0dd2\u0dc1 \u0dc0 \u0dc1 \u0d9a\u0dca\u0dba\u0dc2\u0dc0\u0dad\u0dca\u200d\u0dbb \u0db6\u0dbd\u0db4\u0dc1\u0db1 \u0dd2\u0dc1\u0dd2\u0dc1\u0db0\u0dca\u200d \u0dba\u0dbd\u0da9 \u0dba\u0dbb\u0ddd \u0dbb \u0dad\u0dd4\u0dc5 \u0dbb\u0db1\u0dca\u0db1 \u0dd4 \u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0dc0\u0dc1 processing \u0d9a\u0dbb\u0db1 \u0d9a\u0dbb\u0dca\u0dbd\u0db8\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0db1\u0dc1\u0dbd\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0dba\u0daf\u0dca\u0db1\u0dc0\u0dbd \u0dad\u0dd2\u0dc3\u0dba\u0db6\u0db1 \u0db1\u0dd2\u0db7\u0dc1 \u0dbb\u0dba\u0dc4\u0db8 \u0db6\u0dbd\u0db4\u0dd1\u0db8\u0d9a\u0dca \u0d87\u0dad\u0dd2\u0dc3 \u0dba\u0dc0\u0db1\u0dca\u0db1 \u0dd4 \u0dc5\u0dd4\u0dc0\u0db1\u0dca.\n\n\u0d85\u0dba\u0db1\u0d9a\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dc0\u0db1 \u0dba\u0dda\u0d9a\u0dba\u0dd2. \u0dba\u0dda \u0dba \u0dba\u0db1\u0db1 \u0d89\u0db7\u0dc0\u0db7\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dc1\u0d9c\u0d9a\u0dd2\u0d9a \u0db1\u0dc1\u0db8 \u0dba\u0dad\u0dca \u0d85\u0db4\u0db1 \u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0dda\u0daf\u0dd3 \u0dba\u0dbb\u0ddd\u0d9c \u0dad\u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0d9a\u0dca \u0dc0\u0dc1\u0dba \u0dda \u0db4\u0dca\u200d\u0dbb\u0db1\u0dc0\u0db1 \u0d9a\u0dca \u0d86\u0dba\u0dc0\u0dc1\u0dad\u0dca, \u0dbb \u0dc0\u0dbd\u0daf\u0dd3 \u0d9a \u0d85\u0dc4\u0dd4\u0dd4\u0dab\u0dba\u0dab\u0dc1\u0dad\u0dca \u0d85\u0dba\u0db4\u0dca \u0dbb\u0dba\u0da7\u0dca\u0da7 \u0d89\u0db7\u0dc0\u0db7\u0db1\u0dca \u0d9a\u0dbb\u0dca\u0dbd\u0db8\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d \u0dad\u0dca \u0db6\u0dbd\u0db4\u0dd1\u0db8\u0d9a\u0dca \u0dba\u0dc0\u0db1\u0dca\u0db1 \u0dd4 \u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0dbb\u0dad\u0dca\u200d\u0dba\u0d9a\u0dc1 ban \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dad\u0dca \u0dd4 \u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d85\u0dba\u0db1\u0d9a\u0dca \u0d9a\u0dc1\u0dbb\u0dab\u0dc1\u0dc0 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2, \u0dba\u0dda \u0d86\u0db1 \u0db1 \u0d9a\u0dbb\u0db1 \u0d89\u0db7\u0dc0\u0db7\u0db1\u0dca \u0dba\u0daf\u0dca\u0dc1\u0dd3 \u0dba\u0dc0\u0dba\u0dc5\u0db3 \u0dba\u0db4\u0dc1\u0dc5 \u0db7\u0dd0\u0db4\u0dba\u0dd3\u0dba\u0db8\u0db1\u0dca \u0d85\u0dba\u0db4\u0dca \u0dba\u0daf\u0dca\u0dc1\u0dd3 \u0d89\u0db7\u0dc0\u0db7\u0db1\u0dca \u0dc0 \u0dc1\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0db8\u0dd2\u0dbd \u0db7\u0dc0\u0dae\u0dc1\u0dc0\u0dbb \u0d9a\u0dbb \u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dc0\u0db1 \u0d9a\u0dca \u0dbb\u0db1\u0dca\u0db1 \u0dd4 \u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0dba\u0db8\u0db1\u0dca\u0db1 \u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0db1\u0dc0\u0db1 \u0dad\u0dd4\u0db1 \u0dba\u0dda \u0d9a\u0dbb\u0dca\u0dbd\u0db8\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d \u0d85\u0dd9\u0dc1\u0dc5\u0dc0 \u0db8\u0dba \u0db4\u0dc5\u0db8\u0dd4 \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dc0\u0db1 \u0dd2\u0dc1\u0db0\u0dd2 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dc1\u0dba \u0db1\u0dca \u0d85\u0dc4\u0db1\u0dc0\u0dc1, \u0dbb\u0dd4 \u0d85\u0db8\u0dc1\u0dad\u0dca\u200d\u0dba\u0dad\u0dd4\u0db8\u0db1\u0dd2."
  },
