    "chunk_text": "\u0dd6\u0dbd\u0daf\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa\u0dad\u0dca \u0d9c,\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2\u0d8b \u0dd2\u0da7\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4 \u0db4\u0dbb\u0dda\u0db4\u0dbb\u0dcf \u0d9c:\u0d9a\u0dca \u0dad\u0dd4\u0db1\u0dca \u0dad\u0dd2\u0dc3\u0dca\u0d9c\u0dc3\u0dca \u0d92 \u0d89\u0da9\u0dda \u0da2\u0dd3\u0dd2\u0dbd\u0dad \u0db7\u0dd4\u0dca\u0dad\u0dd2\u0dba\u0dad \u0d85\u0dbb\u0d9c\u0d9c,\u0db1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf0 :\u0dd0\u0db1\u0dca\u0dad \u0d9c\u0dbb\u0dcf\u0dc2\u0dcf\u0db1\u0dca\u0dad \u0d85\u0dca\u0db8\u0dd3\u0db8\u0db1 \u0db8\u0db1\u0dca\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf \u0dd2\u0dbb\u0daf\u0dc0\u0dcf \u0d92\u0dc0\u0dcf\u0d9c\u0dc1 \u0dca\u0da9\u0dd4\u0d9a\u0da9\u0dd4\u0d9c\u0daf \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dcf\u0daf \u0db4\u0dc0\u0dcf \u0d9c\u0d9c,\u0dcf\u0da9 \u0db1\u0d9f\u0daf\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf \u0dd2\u0dbb\u0dba\u0daf\u0dcf0 \u0d9c\u0dda \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dca\u0db1\u0dba \u0d85\u0dd2\u0dc5 \u0dca\u0da9\u0dd4\u0d9a\u0da9\u0dd4\u0dc0 \u0d9c,\u0dc3\u0dad\u0dcf\u0dad \u0db4\u0dc3\u0dca\u0d9c\u0dc3\u0dca :\u0dd0\u0db1 \u0d9c,\u0dc3\u0dad \u0dbb\u0d9a\u0dca \u0d9c\u0db1\u0dcf\u0d9c\u0dc0\u0dba\u0dd20 \u0da1\u0db1\u0dca\u0dad:\u0d9c\u0dc1\u0dd3 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0d85\u0db4\u0dad \u0da1\u0db1\u0dca\u0dad:\u0dba \u0dd3 \u0db4\u0dd4 \u0d9c\u0dc4\u0dca\u0dad\u0dd4 \u0dbb\u0d9a \u0dbb\u0d9a \u0d92\u0dc0\u0dcf \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad0 \u0d9c\u0dda\u0d9a\u0dc3 \u0dbb\u0dc0\u0dd0\u0db1\u0dd2 \u0dbb\u0d9a \u0d9c\u0dc4\u0dca\u0dad\u0dd4\u0dc0\u0dca \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad0 \u0db1\u0db8\u0dd4\u0dc3 \u0dad\u0dc0 \u0d9c\u0d9c,\u0dcf\u0da9\u0dca \u0d9c\u0dc4\u0dca\u0dad\u0dd4 \u0db1\u0dd2\u0dc3\u0dcf \u0dd2\u0da7\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4 \u0da1\u0db1\u0dca\u0dad:\u0dba \u0dd3 \u0daf\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf0 \u0d9c\u0db8\u0dcf\u0d9a:\u0d8b \u0d92 \u0d85\u0dba \u0d9c\u0db6\u0dcf\u0dbb\u0dd4\u0dc0\u0daf\u0dad \u0dbb\u0dd0\u0dc0\u0da7\u0dd2\u0daf\u0dcf\u0db8 \u0dbb\u0db4\u0dcf \u0d9c\u0dc0\u0daf\u0dcf0 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d85\u0dd2\u0dc5 \u0db4\u0dca\u0dc2\u0dba\u0dca \u0d9c\u0daf\u0dc3 \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dba\u0dcf\u0db8\u0daf \u0dc0\u0dbb\u0dcf\u0dba \u0dd2\u0db1\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0dd2\u0dbb\u0dba\u0db1 \u0dbb\u0d9a \u0d9c,\u0dd0\u0db1\u0dc3\u0d8b \u0d92 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0d9c\u0dda \u0d89\u0da9\u0dda \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0daf\u0db6\u0dcf \u0dd2\u0db1\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2 \u0dd2\u0dbb\u0dba\u0db1 \u0dbb\u0d9a \u0d9c,\u0dd0\u0db1\u0dc3 \u0d9a\u0dc0:\u0dcf\u0dc0\u0dc3 \u0da2\u0dca\u200d\u0dcf\u0dad\u0dd2\u0d8b \u0dca\u0d9c,\u0dda\u0d8b \u0d9a\u0dd4\u0daf \u0d9c\u0dda:\u0d9c\u0dba\u0db1\u0dca\u0dad \u0db6\u0daf\u0daf\u0dcf \u0db1\u0dd0\u0dc4\u0dd00 \u0d85\u0dd2\u0dc5 \u0dd2\u0dc5\u0dd2\u0db6\u0d9c,\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf \u0d92\u0dc0\u0dcf \u0d9c:\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1 \u0dd2\u0dbb\u0dba\u0daf\u0dcf\u0d8b \u0dd2\u0db1\u0dba \u0dc4\u0dd0\u0dd2\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9c\u0dba\u0db1\u0dca\u0dad0\n\n\u0dd6\u0dbd\u0daf\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa\u0dad\u0dca \u0d9c,\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2\u0d8b \u0d85\u0d9c\u0dca \u0dca\u0da9\u0dd4\u0d9a\u0da9\u0dd4\u0dc0\u0dad \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda:\u0dba\u0dd2 \u0dd2\u0dbb\u0dba\u0daf\u0dcf \u0dc0 \u0db1\u0dc0\u0dd2\u0db1\u0dca\u0dad \u0dd2\u0dbb\u0daf\u0dc0\u0dcf\u0dad\u0d8b \u0dca\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dd4 \u0dd2\u0db1\u0dc0\u0dd4\u0dbb\u0dd4\u0dda \u0dd3 \u0daf\u0dcf \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda:\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0dd2\u0dbb\u0dba\u0db1 \u0dbb\u0d9a \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf\u0dc3 :\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf0 \u0d9c\u0db1\u0dcf\u0dc0\u0dd0\u0dda\u0db6\u0dbb\u0dca\u0dbd 02 \u0dad\u0db8\u0dba\u0dd2 \u0db8\u0db8 \u0dca\u0db8\u0dad\u0dd2\u0d9a\u0db8 \u0d9c,\u0dc3\u0d9c\u0dc30 \u0dad\u0dc0\u0db8 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda:\u0dca \u0dd2\u0dc5\u0dd2\u0db4\u0daf\u0dcf \u0db1\u0dd0\u0dc4\u0dd00 \u0d85\u0d9c\u0db1\u0dca \u0dbb\u0d9a\u0d8b \u0dca\u0db8\u0dad\u0dd2\u0d9a\u0dda \u0d9a\u0dbb\u0db4\u0dd4 \u0dd2\u0dbd\u0db4\u0dca\u0dc2\u0d9c\u0dc1 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dad\u0daf\u0dcf \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4\u0dc3 :\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf\u0d8b \u0dca\u0db8\u0dad\u0dd2\u0d9a\u0db8\u0dad \u0d85:\u0dcf\u0dcf \u0d9a\u0dbb\u0db1 \u0d9c\u0dda\u0dc0\u0dca \u0d9a\u0dcf\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba\u0dba \u0d9a\u0dbb \u0d9c,\u0db1\u0dca\u0dad\u0db1 \u0dad\u0dc0 \u0d9c\u0d9a\u0dcf\u0da0\u0dca\u0da0 \u0dbb preparatory period \u0dbb\u0d9a\u0dca \u0d95\u0db1\u0dd1: \u0dd2\u0dbb\u0dba\u0daf\u0dcf0 \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0d85\u0dd2\u0dc5 \u0d85\u0dba \u0dc0\u0dd0\u0dba\u0dca \u0dc3\u0dda\u0db8\u0dad \u0d9a\u0d9c\u0dcf\u0dca 0205 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dd4 01\u0dc0\u0dd0\u0db1\u0dd2:\u0dcf0 \u0d8a\u0dad \u0db4\u0dc3\u0dca\u0d9c\u0dc3\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf\u0d9c\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0dcf\u0dcf \u0da1\u0db1\u0dca\u0dad:\u0dba \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0dd0\u0dba\u0dd2 6 \u0d9c\u0dc0\u0db1\u0d9a\u0dca \u0dc3\u0db8\u0dc4\u0dbb \u0d9c\u0dda\u0dc0\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0db6\u0dd0\u0dc4\u0dd00 \u0d89\u0da9\u0dda \u0d9c:\u0db1\u0dca\u0dad\u0db1 \u0d85\u0dc0\u0d9a\u0dba \u0dc0\u0dd4\u0dab\u0dba\u0dc3 \u0d9c:\u0db1\u0dca\u0dad\u0db1 \u0db6\u0dd0\u0dc4\u0dd00\n\n\u0d9c\u0dda \u0daf\u0d82\u0d9a\u0dcf\u0d9c\u0daf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0d85\u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dca\u0dc2\u0db8 \u0dc3\u0dc4 \u0daf\u0dd6\u0dd2\u0dad\u0db8 \u0dca\u0da9\u0dd4\u0d9a\u0da9\u0dd4 \u0d9a\u0dbb\u0db4\u0dd4 \u0d9a\u0dda\u0da7\u0dd2\u0dba \u0d85: \u0dc4\u0dd3\u0d9c\u0db1\u0db1\u0dca\u0dad \u0db1\u0dd0\u0d9f\u0dd2\u0dad\u0daf\u0dcf \u0dc0\u0d9c\u0dda \u0dca\u0dd2\u0dbd\u0dca \u0daf\u0dcf \u0d85\u0dbb\u0d9a \u0d9a\u0dcf\u0dcf\u0d8b \u0d9c\u0dda\u0d9a \u0d9a\u0dcf\u0dcf\u0d8b \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0dad \u0db4\u0dc4\u0dbb \u0dd4\u0dbb\u0db1\u0dca\u0dad\u0db1\u0dcf \u0dd2\u0dbb\u0dba\u0daf\u0dcf \u0dd2\u0dbb\u0dba\u0db1\u0dc0\u0dcf0 \u0d92\u0dc0\u0dcf \u0d94\u0dca\u0d9c\u0d9a \u0db8 \u0d9c\u0dda\u0d9a\u0db4\u0dcf\u0daf\u0db1 \u0d9c\u0db4\u0dca\u200d\u0dbb\u0dcf\u0d9c\u0da2\u0dca\u200d\u0dca\u0dda0 \u0dca\u0dc3\u0dad\u0dad\u0db8 \u0d85\u0dd2\u0dc5 \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb\u0db1 \u0dd2\u0dbd\u0d9a\u0dcf\u0dba\u0dca \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf0 \u0d85\u0dd2\u0dc5 \u0d9c\u0dc2 \u0dbb\u0d9a :\u0db8\u0db1 \u0dca\u0da9\u0dd4\u0d9a\u0da9\u0dd4\u0dc0\u0dca \u0d9c\u0db1\u0dcf\u0d9c\u0dc0\u0dba\u0dd20 \u0d9c\u0db8\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dad\u0daf\u0dcf :\u0dd0\u0db1\u0dca\u0dad \u0d9a\u0dd1 \u0d9c,\u0dc4\u0db1 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0dd2\u0dc5 \u0d89\u0da9\u0dda \u0d9c:\u0db1\u0dc0\u0dcf:? \u0db1\u0dd0\u0dc4\u0dd00 \u0dbb\u0d9c\u0dc4\u0db8 \u0d9a\u0dd1 \u0d9c,\u0dc4\u0daf\u0dcf \u0db6\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d9c\u0d9a 0 \u0d85\u0dd2\u0dc5 \u200d\u0dbb\u0dd3 \u0daf\u0d82\u0d9c,\u0db8\u0d9c\u0dc1 \u0d92\u0d9a\u0dcf\u0db6\u0dda\u0dca\u200d \u0dc0\u0dd0\u0da9 \u0dc3\u0dad\u0dc4\u0db1\u0dca\u0dad\u0dc0\u0daf\u0dad \u0d9c\u0dd2\u0dba\u0dcf0 \u0d8a\u0dad \u0dd2\u0dbd\u0dbb\u0dd4\u0dda\u0dca\u200d\u0dc0 \u0dc4\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0dbd\u0dd4\u0dc3 \u0d9a\u0dcf\u0dcf0 \u0db1\u0db8\u0dd4\u0dc3 \u0d85\u0dd2\u0dc5 \u0db1\u0dad\u0dbb \u0d9a\u0d9c\u0dcf\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0d9c\u0db1\u0dca\u0dad0\n\n\u0d9c\u0d9a\u0dcf\u0d9c\u0dc4\u0dcf\u0db8 \u0dc0\u0dd4\u0dab\u0dba\u0dc3 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0dad \u0d9c,\u0dd0\u0dad\u0dbd\u0dd4\u0dc0\u0dca \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf\u0d8b \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0d89\u0da9\u0dda \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0d89\u0dca \u0daf\u0db1\u0dc0\u0dcf0 1985 \u0dd3 \u0d9c,\u0dd0\u0dc3\u0dda \u0d9a\u0dbb\u0daf\u0dcf \u0dad\u0dd2\u0db6\u0dd2\u0dba\u0dd3 \u0dc3 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4\u0dbb 42\u0dca\u0db8 \u0d89\u0da9\u0dda \u0d94\u0dca \u0db4\u0dd4 \u0dd4\u0dbb\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dd0\u0dc3\u0d9c\u0dc3 \u0dca\u0dba\u0dd2? \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0db8 \u0d9c\u0db8\u0dba \u0d9c\u0d9a\u0da7\u0dd2\u0d9c\u0dba\u0db1\u0dca\u0dad \u0dd2\u0dbb\u0dba\u0db1\u0dca\u0dad\u0db1\u0dda0 \u0dd6\u0dbd\u0daf\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa\u0dad\u0dca \u0d9c,\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2\u0d8b \u0d9c,\u0dbb\u0dd4"
  },
