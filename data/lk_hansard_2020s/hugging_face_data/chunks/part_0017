    "chunk_text": "\u0db8\u0dd4\u0dad\u0dca \u0daf\u0db4 \u0daf\u0db1\u0dd2\u0dbd\u0daf\u0db1\u0dd2\u0dc0\u0dcf:\u0daf\u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0db4\u0d9a\u0dca\u0daf\u0da2 \u0dcf\u0db0\u0dd2\u0dc1\u0dad\u0dd2\u0dc0\u0dc3\u0d9a\u0db4\u0db1\u0db8 \u0daf\u0dad\u0dd2\u0db6\u0dd2\u0db4\u0daf\u0dad\u0dd4\u0dad\u0dd4\u0dba\u0dd2\u0daf\u0d9a\u0dd2\u0db4\u0dbd\u0dcf\u0daf\u0d85\u0db4\u0dd2\u0daf\u0dd2\u0dc1\u0dc1\u0dba\u0dd3\u0dba\u0dc0\u0dc0\u0dcf:\u0daf\u0dcf\u0dc3 \u0dc0\u0dcf\u0dc3\u0daf\u0d92\u0daf\u0db1\u0dd2:\u0dcf\u0daf\u0dad\u0dca\u0db8\u0dd4\u0db1\u0dca \u0dcf\u0db1\u0dca\u0d9a:\u0dda\u0dbd\u0dcf\u0daf\u0d9a \u0dc0\u0dcf\u0daf\u0db4\u0dca\u200d\u0dbb\u0dc3\u0dd2 \u0db0\u0dd2\u0db4 \u0daf\u0dbb\u0dcf\u0daf\u0dbb\u0dcf\u0daf\u0d85\u0db4\u0daf\u0dd6\u0daf\u0db1\u0dca\u0daf\u0dcf\u0dc3\u0db1\u0dca \u0daf\u0dcf\u0dc5\u0dcf \u0daf\u0d9a \u0daf \u0dd0 \u0daf\u0d9a\u0daf\u0dc0\u0dad\u0dca\u0dcf\u0dc0\u0d9a\u0dca\u0daf\u0dd2 \u0dad\u0dca\u0db1\u0dca \u0daf\u0d95 \u0dd1\u0daf\u0d9a\u0dd2\u0db4\u0dbd\u0dcf\u0daf\u0db8\u0db8\u0daf\u0dd2\u0dc1\u0dc1\u0dba\u0dd3\u0dba\u0dc0\u0dc0\u0dcf:\u0daf\u0dcf\u0dc3 \u0dc0\u0dcf\u0dc3\u0daf\n\n\u0dd2\u0dc1\u0dbd\u0dca\u0dbd\u0dd2\u0daf\u0db6\u0dd2\u0dbd\u0daf\u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dcf\u0dc3\u0db1\u0dca \u0daf\u0db4 \u0dc0\u0dcf\u0daf\u0dd2\u0dc1\u0dad\u0dca\u0dc3\u0d9a\u0dca\u0daf\u0d9a \u0dca\u0d9a\u0dc0\u0dba\u0dd2 \u0daf\u0daf\u0dd0\u0db1\u0dca\u0daf\u0dad\u0dca\u0db8\u0dd4\u0db1\u0dca \u0dcf\u0db1\u0dca\u0d9a:\u0dda\u0dbd\u0dcf\u0daf\u0dc1\u0dcf\u0dad\u0dca\u0dcf\u0dbd\u0db4\u0daf \u0dd0 \u0daf\u0dcf\u0dae\u0dcf\u0daf\u0dcf\u0dc3 \u0dc0\u0dcf\u0dc3\u0daf\u0daf\u0dd0\u0db1\u0dca\u0daf\u0dc1\u0dcf\u0dad\u0dca\u0dcf\u0dbd\u0db4\u0daf\u0db8\u0dbb\u0dca\u0daf \u0db4\u0daf\u0dcf\u0dc3 \u0dc0\u0dcf\u0daf\u0d9a\u0dd2\u0db4 \u0dc0\u0dcf\u0dc3\u0daf\u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0daf\u0dc4\u0dd0\u0db8\u0daf\u0daf\u0dcf\u0db8\u0daf\u0d85\u0dc1 \u0dafnews alerts \u0dbb \u0dc0\u0dcf \u0daf\u0d9a\u0db8\u0db1\u0dca