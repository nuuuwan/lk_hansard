u0dca \u0dc1\u0d9a\u0dc3 \u0d9a\u0dca\u200d\u0dbb\u0dd2[\u0dc1 \u0d9a\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dad\u0dd3\u0dbb\u0dd4\u0dc0 6765\n\n\u0d96\u0dc2\u0db0 \u0dc4\u0dd2\u0d9f\u0dba \u0db1\u0dd0\u0dad\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0da2\u0d9c\u0dda \u0dc0\u0dd0\u0da9 \u0dd2\u0dc5\u0dd2\u0dad\u0d9c\u0dc0\u0dc5:\n\n\u0dc1\u0dc3\u0dde\u0d9b\u0dca\u200d\u200d \u0dc3\u0dc4 \u0da2\u0db1\u0db8\u0dc1)\u200d \u0d85\u0db8\u0dc1\u0dad\u200d\u0dad\u0dd4\u0db8\u0dc1\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dc1 [ \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\n\n1723]\n\n\u0d85\u0dbd\u0dd2\u0db8\u0d82\u0d9a\u0da9 \u0dbd\u0dd4\u0dab\u0dd4 \u0d9c\u0dda\u0dc0\u0dcf\u0d9c\u0dda \u0dd9\u0dd0 \u0dbd\u0dd4:\n\n\u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad \u0dc4\u0dc1 \u200d \u0dc3\u0dc1[\u0d9a \u0d9a \u0dc3\u0dcf \u0dba\u0db7)\u0db1 \u0d85\u0db8\u0dc1\u0dad\u200d\u0dad\u0dd4\u0db8\u0dc1\u0dc1\u0dda\n\n\u0db4\u0dca\u200d\u0dbb\u0d9a\u0dc1 [ \u0dad\u0dd3\u0dbb\u0dd4\u0dc0 6734\n\n\u0d85\u0db1\u0dca\u0dad\u0dbb\u0dca\u0dd9\u0dad \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4\n\n\u0baa\u0bbf\u0bb0\u0ba4\u0bc6\u0bbe\u0ba9 \u0b89\u0bb3\u0bcd\u0bb3\u0b9f\u0b95\u0bcd\u0b95\u0bae\u0bcd\n\n\u0bc6\u0ba9\u0bc6\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0baf\u0bbf\u0b9f\u0bc8\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0ba8\u0bcd\u0ba4 \u0ba4\u0bc6\u0baf\u0bcd\u0ba4\u0bbf:\n\n\u0ba4\u0baa\u0bc6\u0bbe\u0ba4\u0bc1\u0bc6\u0ba9\u0baa\u0bcd \u0baa\u0bc6\u0bbe\u0ba4\u0bc1\u0b95\u0bc6\u0bbe\u0baa\u0bcd\u0baa\u0bc1\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u0bae\u0bcd [\u0baa: 1651]\n\n\u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd:\n\n\u0bc6\u0baa\u0bc6\u0bbe\u0ba8\u0bc6\u0bbe\u0baf\u0b95\u0bb0\u0ba4\u0bc1 \u0bc6\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1\u0bae\u0bb0 [\u0baa: 1652] \u0b87\u0bb2\u0b99\u0bcd\u0bae\u0b95 \u0bc8\u0bbf\u0ba9\u0bcd\u0bc6\u0bc6\u0bbe\u0bb0\u0bae\u0bcd (\u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd) \u0bc6\u0b9f\u0bcd\u0b9f\u0bae\u0bc2\u0bb2\u0bae\u0bcd: \u0b89\u0baf\u0bb0\u0bcd \u0ba8\u0bc0\u0ba4\u0bbf\u0bc8\u0ba9\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bc8\u0ba9\u0bc1 [\u0baa: 1652] \u0ba4\u0bb5\u0bb3\u0bbf\u0ba8\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bb2\u0bc1\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd, \u0ba4\u0bb5\u0bb3\u0bbf\u0ba8\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0bb5\u0bae\u0bb2\u0bb5\u0bc6\u0bbe\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bc1 \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bc6\u0bbe \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0bc6\u0bbf\u0ba9\u0ba4\u0bc1\u0bae\u0bcd \u0b87\u0bb2\u0b99\u0bcd\u0bae\u0b95\u0ba4\u0bcd \u0ba4\u0bc2\u0ba4\u0bb0\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0ba4\u0bc1\u0bae\u0bcd \u0bb5\u0b95\u0bbf\u0baa\u0bc6\u0bbe\u0b95\u0bae\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bc6\u0bbe\u0ba9 \u0bb5\u0bbf\u0bb4\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0ba3\u0bb0\u0bcd\u0bb5\u0bc1\u0b9a\u0bcd \u0ba4\u0bc6\u0baf\u0bb2\u0bc8\u0bb0\u0bcd\u0bb5\u0bc1 [\u0baa: 1653] \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0baf\u0bcd\u0bb5\u0bc6\u0bbe\u0bb3\u0bb0\u0bcd \u0b85\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0ba4\u0bc1 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0bae\u0b95 [\u0baa: 1653]\n\n\u0ba4\u0bc1\u0bae\u0bb1\u0bc6\u0bc6\u0bbe\u0bb0\u0bcd \u0bb5\u0bc8\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0bb0\u0bcd\u0bae\u0bb5\u0b95\u0bcd \u0b95\u0bc1\u0bb4\u0bc1 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0bae\u0b95\u0b95\u0bb3\u0bcd [\u0baa: 1656]\n\n\u0bb5\u0bbf\u0ba9\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bc6\u0bbe\u0baf\u0bcd\u0bae\u0bc2\u0bb2 \u0bb5\u0bbf\u0bae\u0b9f\u0b95\u0bb3\u0bcd [\u0baa: 1657- 1705]\n\n\u0ba4\u0ba9\u0bbf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bae\u0bc2\u0bb2 \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe:\n\n\u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0bcd \u0bc6\u0bc0\u0ba9\u0bbf \u0b89\u0bb1\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0ba9\u0bcd \u0ba4\u0bc1\u0bae\u0ba3\u0ba4\u0bcd \u0ba4\u0baf\u0bc6\u0bbe\u0bc6\u0bbe\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd '\u0bb5\u0bb1\u0bcd' \u0bb5\u0bc6\u0bbe\u0bbf [\u0baa: 1706] \u0b95\u0bbf\u0bb3\u0bbf\u0ba4\u0ba8\u0bc6\u0bbe\u0b9a\u0bcd\u0bc6\u0bbf\u0baf\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0b87\u0bb2\u0b99\u0bcd\u0bae\u0b95-\u0bb5\u0bc7\u0bb0\u0bcd\u0bc8\u0ba9\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd\u0ba8\u0bc1\u0b9f\u0bcd\u0baa\u0baa\u0bcd\n\n\u0baa\u0baf\u0bbf\u0bb1\u0bcd\u0bc6\u0bbf \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0ba4\u0bcd\u0bae\u0ba4\u0b9a\u0bcd \u0b9a\u0bc1\u0baf\u0bc6\u0bbe\u0ba4\u0bc0\u0ba9 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0bc8\u0bc6\u0bbe\u0b95 \u0b87\u0baf\u0b99\u0bcd\u0b95\u0b9a\u0bcd\u0ba4\u0bc6\u0baf\u0bcd\u0ba4\u0bb2\u0bcd [\u0baa: 1716]"
