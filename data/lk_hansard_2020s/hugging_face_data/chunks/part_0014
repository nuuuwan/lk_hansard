    "chunk_text": "\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db1\u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db1\u0db1\u0dd2, \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db1\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dc1\u0dda\u0dae\u0dba\u0dd2. \u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dd2\u0dba \u0d89\u0dc0 \u0dae\u0dbb \u0d9c\u0dd0\u0dba \u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0dba \u0da2\u0db1\u0dad\u0dcf \u0dc0\u0dd2\u0db8\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc1\u0db4\u0dbb\u0db8\u0dd4\u0dc1\u0dab\u0dca \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0dba\u0d9a\u0dca\u0dad \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca\u0dad \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2. \u0d85\u0db4\u0dd2 \u0d87\u0dd2 \u0dad\u0dbb\u0dda \u0dc1\u0dda\u0dae \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc1\u0dda \u0d91\u0d9a\u0dca\u0dad\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dd2\u0dae \u0db4\u0d9a\u0dca\u0dad\u0dc2\u0dc1\u0dda \u0dad\u0d9a\u0dca\u0dad\u0dae\u0da9\u0dd2, \u0db8\u0dd2\u0dba \u0db1\u0dbb\u0dd4 \u0db1\u0dcf\u0dba\u0dae\u0dba\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0dc4\u0daf\u0db4\u0dd4 \u0db1\u0dc4\u0dcf \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1 \u0dc3\u0dd4\u0dc5\u0dd2\u0dba \u0d87\u0dd4\u0dc1\u0dc5\u0dca \u0db1\u0dc4\u0dcf \u0daf\u0dd0\u0dc0\u0dd0\u0db1\u0dca\u0dad\u0dad \u0dc3\u0da7\u0db1\u0d9a\u0dca\u0dad \u0db4\u0da7\u0db1\u0dca\u0dad \u0d9c\u0dad\u0dca\u0dad\u0dcf. \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf, \u0d92 \u0dc3\u0da7\u0db1 \u0dd4\u0dc5\u0dd2\u0db1\u0dca\u0dad \u0d91\u0d9a\u0dca\u0dad\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dd2\u0dae \u0db4\u0d9a\u0dca\u0dad\u0dc2\u0dc1\u0dda, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0dae\u0dcf \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0db4\u0d9a\u0dca\u0dad\u0dc2\u0dc1\u0dda, \u0da2\u0db1\u0dad\u0dcf \u0dc0\u0dd2\u0db8\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc1\u0db4\u0dbb\u0db8\u0dd4\u0dc1\u0dab\u0dca \u0db4\u0db1\u0dab\u0d9a\u0dca\u0dad \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2, \u0d9a\u0dd2\u0dc3\u0dd2\u0db1 \u0db4\u0d9a\u0dca\u0dad\u0dc2\u0dba\u0d9a\u0dca\u0dad \u0db1\u0dd0\u0dd2 \u0dc3\u0dcf\u0db1\u0dcf\u0db1\u0dba \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4\u0dad\u0dca \u0d92 \u0dc3\u0dd4\u0dc5\u0dd2\u0dba\u0da7 \u0dc4\u0dc3\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf \u0dc0\u0dd2\u0db1\u0dcf \u0dc0\u0dd4\u0dab\u0dcf. \u0d85\u0db4\u0da7 \u0d92 \u0d9c\u0dd0\u0db1 \u0d87\u0dad\u0dca\u0dad \u0dae\u0dda\u0db4\u0db1\u0dba\u0d9a\u0dca\u0dad \u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf, \u0d85\u0daf \u0d85\u0db4\u0dd2 blessed \u0db4\u0d9a\u0dca\u0dad\u0dc2\u0dba\u0d9a\u0dca\u0dad. \u0d85\u0daf \u0d85\u0dc1\u0dda \u0db4\u0d9a\u0dca\u0dad\u0dc2\u0dc1\u0dda \u0dae\u0dc0\u0dd4\u0daf \u0d89\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad? \u0dc1\u0db1\u0dad\u0dd0\u0db1 \u0d89\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf, \u0dad\u0dbb\u0dd4\u0dab \u0db1\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dbb\u0dd4. \u0d92\u0dc1\u0d9c\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0dad\u0dc1 \u0dad\u0dcf\u0dad\u0dca\u0dad\u0dbd\u0dcf \u0d91\u0d9a\u0dca\u0dad\u0dc3\u0dad\u0dca\n\n549 550\n\n[\u0d9c\u0dbb\u0dd4 \u0db6\u0dd2\u0db1\u0dbd\u0dca \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0dae \u0db1\u0dc4\u0dad\u0dcf]\n\n2025 \u0d85\u0dc1\u0dda\u0dbd\u0dca 10\n\n\u0d92 \u0dc0\u0dcf\u0dc1 \u0db1 \u0dd2\u0dc3\u0dca\u0db4\u0dc3\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0daf\u0d9a\u0dca\u0dad \u0d87\u0dd4\u0dc1\u0dc5\u0dca \u0d85\u0db4\u0dd2 \u0dae\u0dd0\u0da7\u0dc1\u0db4\u0ddd\u0dbd\u0dba\u0d9a\u0dca\u0dad\u0dc0\u0dad\u0dca \u0d85\u0dd2\u0db1\u0dca\u0dad \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0. 1994\u0db1\u0dca\u0dad \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dca \u0d85\u0dc1\u0dda \u0dc3\u0dc1\u0dc4\u0ddd\u0daf\u0dbb\u0dc0\u0dbb\u0dd4 8 \u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dca\u0dad \u0db1\u0dbb\u0dbd\u0dcf \u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf, \u0da1\u0db1\u0dca\u0dad\u0daf\u0dba \u0d89\u0dbd\u0dca\u0dbd\u0dda\u0daf\u0dd3. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d85\u0db4\u0dd2 \u0dae\u0dd0\u0da7\u0dc1\u0db4\u0ddd\u0dbd\u0dba\u0d9a\u0dca\u0dad\u0dc0\u0dad\u0dca \u0d85\u0dad\u0da7 \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0dba \u0db1\u0dd2\u0dc3\u0dcf \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2. \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf, \u0d86\u0dba\u0dd4\u0db0\u0dc0\u0dbd \u0dd2\u0dc1\u0db6\u0db1 \u0db6\u0dbd\u0dba. \u0d92\u0dc0\u0dcf \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dcf\u0dad\u0dca \u0d86\u0db4\u0dd4\u0daf \u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0db6\u0dd0\u0dc4\u0dd0. \u0d92\u0dc0\u0dcf \u0dd2\u0da7\u0dcf\u0dbb\u0dca\u0dbd \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2. \u0d91\u0dc1\u0dc4\u0db1 \u0db1\u0dd0\u0dd4\u0dc0 \u0d85\u0db4\u0da7 \u0dc1\u0dc0\u0dca\u0daf\u0db1\u0dcf \u0db1\u0dd0\u0dd2 \u0db1\u0dd2\u0dc3\u0dcf \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2. \u0db1\u0dcf \u0d89\u0dc3\u0dca\u0dc3\u0dbb\u0dc4 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4 \u0db1\u0dd0\u0dbb\u0dd4\u0dc1\u0dc0\u0dca \u0dc4\u0db4\u0dd4\u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0dd2\u0dba\u0db1 \u0db8\u0dd2\u0dba \u0db1\u0dbb\u0dd4\u0dc0\u0dcf, \u0dc1\u0db4\u0dcf\u0dbd\u0dd3\u0dc3\u0dd2\u0dc1\u0dda. \u0d94\u0dba \u0db1\u0dcf\u0dad\u0dc1\u0dbd\u0dca \u0db8\u0dd2\u0dba \u0db1\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d8b\u0daf\u0dc0\u0dd4 \u0dae\u0dbb\u0db4\u0dd4 \u0db8\u0dd2\u0dba \u0db1\u0dbb\u0dd4\u0dc1\u0dc0\u0d9a\u0dca\u0dad. \u0d8a\u0da7 \u0dae\u0dd2\u0db1\u0dca\u0dad \u0db1\u0dcf\u0dbb\u0dda\u0db1\u0dbd \u0dc3\u0dd2\u0dda\u0db0\u0dd2\u0dba. \u0d94\u0dba \u0daf\u0dd0\u0db1\u0dca\u0dad \u0dae\u0dcf\u0dcf\n\n\u0dae\u0dbb\u0db4\u0dd4 \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1 \u0dc1\u0dc3\u0dc0\u0dbd\u0dae\u0dda \u0dae\u0dbb\u0db1 \u0db4\u0dd4\u0dda\u0d9c\u0dbd\u0dba\u0dcf \u0dc1\u0dda\u0dc0\u0dcf \u0daf\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf. \u0db1\u0dcf\u0dbb\u0dda\u0db1\u0dbd\u0daf\u0dd3 \u0dc1\u0dae\u0dcf\u0dc1\u0dc4\u0dcf\u0db1\u0daf \u0db8\u0dd2\u0dba \u0db1\u0dd0\u0dbb\u0dd4\u0dc1\u0dc0\u0dca? \u0dc3\u0db1\u0dc4\u0dbb \u0dc1\u0db4\u0dcf\u0da9\u0dd2 \u0dc4\u0dcf\u0db8\u0dd4\u0daf\u0dd4 \u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad\u0dc1 \u0d94\u0dc5\u0dd4\u0dc0\u0da7 \u0d9c\u0dbd\u0dca \u0d85\u0dad\u0dc4\u0dd0\u0dbb\u0dbd\u0dcf \u0db1\u0dbb\u0db4\u0dd4 \u0db8\u0dd2\u0dba \u0db1\u0dbb\u0dd4\u0dc1\u0dc0\u0d9a\u0dca\u0dad \u0dad\u0db1\u0dba\u0dd2 \u0dc4\u0db4\u0dd4\u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad. \u0d85\u0dc1\u0dda \u0dc3\u0dd2\u0dbb\u0dd2\u0dc1\u0dda\u0dc0 \u0dc3\u0dc1\u0dc4\u0ddd\u0daf\u0dbb\u0dba\u0dcf \u0db1\u0dc4 \u0daf\u0dc0\u0dbd\u0dca \u0dc1\u0dc0\u0da9\u0dd2 \u0dd2\u0dba\u0dbd\u0dcf \u0db1\u0dd0\u0dbb\u0dd4\u0dc0\u0dcf, 1999\u0daf\u0dd3 \u0db1\u0dcf\u0dad\u0dca \u0d91\u0d9a\u0dca\u0dad\u0dae \u0d89\u0db1\u0dca\u0dad\u0db1\u0dc1\u0dae\u0dcf\u0da7. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf \u0d92\u0dc0\u0dcf\u0dc1\u0dda \u0dc1\u0dc0\u0dca\u0daf\u0db1\u0dcf\u0dc0. \u0d85\u0db4\u0dd2 \u0d92\u0dc0\u0dcf\u0da7 \u0dbb\u0dd2\u0db1\u0dcf\u0db1\u0dca\u0dad\u0da9\u0dca \u0dc1\u0dc0\u0dbd\u0dcf\u0dad\u0dca \u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1 \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dca\u0dd2\u0dba\u0d9a\u0dd2\u0db1\u0dca\u0dad, \u0dc3\u0db1\u0dcf\u0da2\u0dba \u0d9c\u0dd0\u0db1 \u0dd2\u0dc1\u0db6\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0dca \u0d85\u0daf\u0dc4\u0dc3\u0d9a\u0dd2\u0db1\u0dca\u0dad, \u0dc3\u0db1\u0dcf\u0da2 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dad\u0dca\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc4\u0dd0\u0d9f\u0dd3\u0db1\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0dc4 \u0dc1\u0dda \u0db1\u0dc4\u0dcf \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1 \u0dc3\u0dd4\u0dc5\u0dd2 \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0db1\u0dcf\u0dab\u0dba \u0dc0\u0dd4\u0dc1\u0dab\u0dca \u0dc1\u0dae\u0dcf\u0dc1\u0dc4\u0dcf\u0db1\u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0dae \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dba\u0dda\u0d9a\u0dd2\u0dc3\u0dd2 \u0dd2\u0dd2\u0dc4\u0dcf\u0dc3\u0dd2\u0dae \u0dc1 \u0dde\u0dd2\u0dae\u0dc0\u0dcf\u0daf\u0dd3 \u0d9a\u0dd2\u0dba\u0dd0\u0dc0\u0dd3\u0db1\u0d9a\u0dca\u0dad \u0d87\u0dd4\u0dc1\u0dc5\u0dca \u0dad\u0db1\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dc1\u0dda \u0db4\u0dd4\u0dda\u0d9c\u0dbd\u0dc1\u0dba\u0ddd \u0daf\u0dd2\u0dc4\u0dcf \u0db6\u0dbd\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad. \u0db1\u0db1 \u0d92\u0dae\u0dba\u0dd2 \u0d9a\u0dd2\u0dc0\u0dca\u0dc1\u0dc0\u0dca, \u0d85\u0db4\u0dd2 \u0dae\u0dbd\u0dca\u0db4\u0db1\u0dcf \u0dae\u0dbb\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dd2\u0dbb\u0da7\u0dd2\u0dc1\u0dda \u0dc1\u0dda\u0dae \u0dc3\u0d82\u0dd2\u0dbb\u0db3\u0dd2\u0dba\u0dcf\u0dc0 \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0db1\u0dca\u0dad \u0d9c\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dc1\u0dae\u0dcf\u0dc1\u0dc4\u0dcf\u0db1\u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0dae \u0d9c\u0dd0\u0db1\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf."
