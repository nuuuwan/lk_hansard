2 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2 \u0da7\u0dcf\u0da9\u0dc1\u0dad \u0da2 \u0db1\u0dd2\u0d9a\u0dd4\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0da2\u0da7 \u0dc1\u0db1\u0ddc\u0dc4\u0dba\u0dd0\u0d9a\u0dd2 \u0dc0\u0dd6 \u0d85 \u0daf\u0dd4\u0dca\u0db4\u0db4\u0dca \u0dc3\u0d9a\u0dc4\u0dba\u0dcf \u0db1\u0dd2\u0d9a\u0dd4\u0dca \u0da7\u0dc5 \u0dbb\u0dd49 \u0db1 \u0d9c\u0da2 \u0db1 \u0da9\u0db4\u0dad\u0dca\u200d\u0dbb \u0db1 \u0dc3\u0dd2 \u0dbd\u0dca\u0da9\u0dc1\u0d9c \u0db1\u0da2 \u0dc3\u0da2 \u0db1\u0dc0\u0dd2\u0dad \u0dc19\u0db19\u0dcf.\n\n(iv) \u0da2\u0dbb\u0dca\u0d9d \u0da7\u0dcf\u0da9 \u0d9a\u0dca \u0d9c\u0dad \u0dc1\u0db1\u0ddc\u0dc1\u0dda. \u0d9a\u0d9a\u0dca\u0daf\u0dd2\u0db1 \u0dc1\u0dc3\u0dda9 \u0dc3\u0d9a\u0dc4\u0dba\u0dcf \u0dc0\u0dcf\u0dbb\u0d9c\u0db1\u0dd4 \u0da9 \u0db1 \u0dc3\u0dd2 \u0db8\u0dca \u0d85 \u0daf\u0dd4\u0dca\u0db4\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dca \u0dc3\u0d9a\u0dc4\u0dba\u0dcf\u0da2 \u0db4\u0dd0 \u0d9a\u0dd2\u0dc4\u0dd2\u0db4 \u0d9a\u0dca \u0dad\u0dd4\u0db8\u0dc5 \u0dbb\u0dd49 \u0db1 \u0d9c\u0da2 \u0db1 \u0da9\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dca \u0dc1\u0da7\u0dc1\u0dbb\u0dca. \u0d9a\u0dc1\u0da2 \u0db1\u0da2\u0d8b \u0db49\u0dad\u0dd2\u0db1 \u0dc0\u0dd2\u0dc1 \u0d9c\u0da2 \u0db1 \u0da9\u0db4\u0dad\u0dca\u200d\u0dbb \u0da7 9\u0da9\u0d82\u0dbb\u0dd4 \u0da7\u0dcf\u0da9 \u0da2\u0dbb\u0dca\u0d9d \u0d9a\u0dd2\u0dbb\u0dd3\u0da2\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0dc1\u0db1\u0ddc\u0da7\u0dbb\u0db1 \u0d85\u0dad\u0dbb\u0d8b 9\u0da9\u0d82\u0dbb\u0dd4 \u0da7\u0dcf\u0da9 \u0d859\u0dc3 \u0db1 \u0dc0\u0dd3 \u0dca\u0dad\u0dd2 \u0d9c\u0da2 \u0db1 \u0da9\u0db4\u0dad\u0dca\u200d\u0dbb \u0dc3\u0d9a\u0dc4\u0dba\u0dcf \u0db19 \u0dbb\u0dd49 \u0db1 \u0d9c\u0da2 \u0db1 \u0da9\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dca \u0da9 \u0dcf \u0d9c\u0dad \u0dd4\u0d9a\u0dad\u0dd4\u0db8 \u0dc1\u0dda.\n\n(v) \u0da2\u0db1\u0dad\u0dcf9\u0da7 9\u0da9\u0dcf\u0dca \u0db4\u0dc4\u0dba\u0dc3\u0dd4\u0dc19 \u0db1 \u0dc3\u0dc4\u0dba \u0da7\u0da9\u0dd2\u0db1\u0dd2\u0dba \u0db1 \u0dbb\u0dd49 \u0db1 \u0d9c\u0da2 \u0db1 \u0da9\u0db4\u0dad\u0dca\u200d\u0dbb \u0da9 \u0dcf \u0da2\u0da2 \u0dc19\u0db1\u0dd4\u0dc19 \u0db1 \u0d9a\u0d9a\u0dca\u0daf\u0dd2\u0db1 \u0dc1\u0dc3\u0dda9 \u0da7\u0dc1\u0dca \u0dc0\u0dd2\u0dc1 \u0d9c\u0da2 \u0db1 \u0da9\u0db4\u0dad\u0dca\u200d\u0dbb \u0d85 \u0daf\u0dd4\u0dca\u0db4\u0db4\u0dca \u0dc0\u0dcf\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0da2 \u0dc4\u0dba\u0dcf \u0db1\u0dd2\u0d9a\u0dd4\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0da2 \u0dc3\u0d9a\u0dc4\u0dba\u0dcf \u0d86\u0d9c\u0da2\u0db1 \u0dc4\u0dba\u0dcf \u0dc0\u0dd2\u0d9c\u0da2\u0db1 \u0dc1\u200d\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc1\u0dca\u0db4 \u0db1\u0dad\u0dd4\u0db89 2025.02. 8 9\u0db1 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0db4\u0dd0 24\u0da7 \u0dc1\u0dc3\u0dda9\u0dcf9\u0d9a\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dca \u0da2\u0da7 \u0da7\u0dbb \u0dca\u0dad.\n\n(\u0d86 \u0db4\u0dd0\u0db1 \u0dc1\u0db1\u0ddc\u0db1\u0d9f\u0dd3.\n\n\u0d9c\u0dbb\u0dd4 \u0dc4\u0dbb\u0dca\u0dc2\u0dab \u0dbb\u0dcf\u0da2\u0d9a\u0dbb\u0dd4\u0dab\u0dcf \u0db8\u0dc4\u0dad\u0dcf (\u0bc7\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc7\u0bbf\u0b95\u0bc1 \u0bb9\u0bb0\u0bcd\u0bb7\u0ba3 \u0bb0\u0bc6\u0bbe\u0b9c\u0b95\u0bb0\u0bc1\u0ba3\u0bc6\u0bbe) (The Hon. Harshana Rajakaruna) \u0d9c\u0dc0 \u0da7\u0dae\u0dcf\u0db1\u0dcf \u0da7\u0dad\u0dd4\u0db8\u0da2\u0db1\u0dd2\u0d8b \u0da2\u0dc1 phone \u0d9a\u0da7\u0da7 \u0d9a9\u0da9\u0dcf \u0dad\u0dd2\u0dc1 \u0db19\u0dcf\u0d8b \u0db8\u0dd4\u200d\u0dbd\u0dca \u0dc0\u0dcf\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dc1\u0dca\u0db4 \u0d9a\u0dd4\u0dc0\u0dd2\u0dad\u0dcf \u0db1\u0dc3\u0dd2 \u0d9a\u0dca\u0d8b 2023.07. \u0daf\u0dd2\u0db1 \u0d85 \u0daf\u0dd4\u0dca\u0db4\u0db4\u0dad\u0da7\u0da7 \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0da2\u0d9a\u0dca \u0da7\u0dbb\u0db4\u0dd4. \u0d92 \u0d9a\u0dd2 \u0db1\u0dc1 \u0db1 \u200d\u0dd0 \u0db1 \u0d92\u0da7\u0da7 \u0d85\u0dc0\u0dd4\u0dc0 \u0daf\u0dd4 2\u0d9a\u0dca \u0d9c\u0dad \u0dc19\u0da9\u0dcf \u0dad\u0dd2\u0dc1 \u0db19\u0dcf. \u0d9c\u0dc0 \u0dca\u0da2\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0da2\u0db1\u0dd2\u0d8b \u0d94 \u0dad\u0dd4\u0db8\u0da2 \u0db1\u0da9\u0dcf \u200d \u0db1\u0db19\u0dcf\u0d8b \u0db8\u0dd3\u0da7 \u0da2\u0dcf\u0dc3 \u0d9a\u0dd3\u0db4 \u0da7\u0da7 \u0da7\u0dbd\u0dd2 \u0db1 \u0dc1\u0da2\u0dad\u0dd0\u0db1 \u0dc1\u0da9\u0ddc\u0d9a\u0dd4 \u0dc1\u0db4\u0ddd\u0dbd\u0dd2\u0dca\u0db4 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0db1\u0dd2\u0dc3\u0dcf \u0da2\u0dcf\u0db0\u0dba9\u0da9 \u0dc3\u0dc4\u0dba \u0dc19\u0db1\u0dca \u0db4\u0dd4 \u0d9c\u0da9 \u0db1\u0dc1 \u0dc0\u0dd2\u0dc1\u0dbb\u0ddd\u0db0\u0dad\u0dcf \u0dca\u0dad\u0dd2 \u0dc0\u0dd4\u0dda\u0dcf \u0d9a\u0dd2 \u0da9\u0dcf. \u0d9a\u0da2 \u0dad\u0dca \u0dca 9 \u0dad\u0dd4\u0db8\u0dc5 \u0dbb\u0dc1\u0da7\u0dca \u0da2\u0db1\u0dad\u0dcf9\u0da7 \u0dc1\u0dca\u0db4 \u0dca\u200d\u0dbb\u0da2\u0dcf\u200d \u0db4\u0dd2\u0db6\u0db3 \u0d9a9 \u0dc1\u0da9\u0ddc\u0d9a\u0dd4 \u0dca\u200d\u0dbb \u0dcf\u0db1 \u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dda\u0dcf."
