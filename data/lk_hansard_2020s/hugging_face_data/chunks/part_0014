    "chunk_text": "\u0d9a\u0dd2\u0dc3\u0db8 \u0dad\u0dd0\u0db1\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0db1\u0dca \u0d91\u0dbd\u0dca\u0da7\u0dd3\u0da7\u0dd3\u0d8a \u0dc3\u0dd2\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dc1\u0dda \u0dc1\u0dc4\u0ddd \u0d91\u0db8 \u0dc3\u0dd2\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dc1\u0dc4\u0ddd \u0d91\u0db8 \u0dc3\u0dd2\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc1\u0dc0\u0db1\u0dad\u0dca \u0dba\u0dca\u0db4 \u0dc3\u0dd2\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba\u0d9a \u0dc1\u0dc4\u0ddd \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0dbb\u0d9a\u0dca\u0db4\u0dc0\u0dbd\u0da7 \u0dc3\u0dca\u0db4\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad \u0dc1\u0dc4\u0ddd \u0dc3\u0dbd\u0d9a\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc1\u0dc4\u0ddd \u0dc3\u0dca\u0db4\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad \u0db6\u0dc0\u0da7 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0dc1\u0dbd\u0dc3 \u0dc3\u0dd0\u0d9a \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dba\u0dca\u0db4 \u0dc3\u0dd2\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba\u0d9a \u0d91\u0db8 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dda 3 (\u0d85 \u0dc3\u0da7 (\u0d9a :\u0d9a\u0dca\u0dc0\u0dcf \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc1:\u0dba\u0d9a\u0dca \u0dc3\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dca\u0db4 \u0d91\u0dba \u0dc0\u0dbb:\u0d9a\u0dca \u0dc0\u0db1 \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d91\u0dc1\u0dc3\u0dda \u0dc1\u0db1\u0ddc\u0dc0\u0db1 \u0db8\u0dd2\u0dba\u0d9c\u0dd2\u0dba \u0db4\u0dd4 \u0d9c\u0dbd\u0dba\u0db1\u0dca \u0dc3\u0dc4\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dca\u0db4 \u0dc3\u0dd0\u0db8\u0dbb\u0dd4\u0dca\u0db4 \u0dda\u0dad\u0dca\u0dc3\u0dc0 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0db8\u0da7 \u0