    "chunk_text": "1991 \u0d85\u0dcf 37 \u0daf\u0dba \u0da2\u0dc0\u0dd2 \u0d9c\u0dca \u0dc0\u0d9c\u0dca \u0dc1 \u0dc0\u0db8\u0dd2\u0dc2\u0dca\u0da8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0db7\u0dc0 (\u0dc1\u0dcf\u0dc1 \u0ddd) \u0db4 \u0db4 \u0dad \u0dc1\u0db4\u0dad \u0d9c\u0dbb\u0dd4 \u0dc1\u0db7\u0dc0\u0dc0 \u0dad\u0dd4\u0db8\u0dcf\u0dc5 \u0daf\u0dd4\u0dc0\u0dc0\u0daf \u0da7 \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0 \u0d85\u0dc0\u0dc1\u0dda\u0dcf\u0dc0\u0dc1\u0dda \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0dcf \u0dc0\u0dc1\u0dda \u0db8\u0dd4\u0dc5\u0dd4 \u0dca\u0dc4 \u0d9a \u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dc0 \u0db4\u0dba\u0db4\u0dd4\u0dba\u0dca \u0db1\u0dd2\u0dc1 \u0ddd\u0da2 \u0dba\u0db8\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dc0\u0dc0 \u0dc1\u0d9a\u0dc1 \u0d9a, \u0d92 \u0dc0\u0dc0\u0dc1\u0dda\u0dca \u0d85\u0db4\u0dd2 \u0daf\u0dd2 \u0dab\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dc1\u0dc4 \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dca\u0dc0 \u0dc1\u0d9a\u0dc1 \u0d9a \u0dad\u0dca\u0db1\u0dca \u0dca\u0dca \u0dc1\u0db4\u0dad \u0daf\u0dd4\u0dc0\u0dc0\u0daf \u0da7 \u0dc1\u0dc4\u0db7\u0dc0\u0d9c\u0dd2 \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb6 \u0dca\u0dca \u0dd2\u0dad\u0dc0\u0dca \u0dc1\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0dca \u0dc1\u0dc0 \u0dc0\u0dc0, \u0dc1\u0db4\u0dad \u0dc1\u0dc0\u0d9a\u0dc0\u0dc1\u0dda \u0d85\u0dc1\u0dda \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dba \u0dc0\u0dba \u0dc1\u0db7\u0dc0\u0db4\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0dd2 \u0dbd\u0dca\u0d9a\u0dc0\u0dc1 \u0dc0\u0db4\u0dba\u0dc0\u0dc0 \u0db1\u0dca\u0dd3\u0dca \u0db4\u0dd2\u0dc5\u0dd2 \u0db3\u0dc06\n\n\u0dad\u0dd4\u0db8\u0dcf\u0dc5 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf \u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0dca\u0da7 \u0d85\u0dc0 \u0dba \u0d85\u0dc0\u0dc1\u0dda\u0dcf\u0dc0\u0dc0 \u0dc1\u0d9a\u0dc1\u0dc0 \u0daf\u0dd3\u0dca \u0dc1\u0db3\u0dc4\u0dc0 \u0dc1\u0dda \u0db4\u0dc0\u0d9a \u0dc0 \u0dc1 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d85\u0db4\u0dd2 \u0db1\u0dca \u0daf\u0dc1\u0daf \u0dc0 \u0dca\u0dd0\u0daf\u0dd2\u0dc4 \u0d9a \u0daf\u0dd4 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dca6 \u0dc1\u0db4\u0dad \u0db4 \u0dad \u0dc1\u0dcf\u0dc1 \u0ddd) \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0dc4\u0dba\u0dc4\u0dc0 \u0dc1\u0db4\u0dc0\u0dbd\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc0\u0dc4 \u0dc1\u0dc1\u0dda\u0dc0 \u0db1\u0dd2 \u0dc0\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d92 \u0dad \u0d9a \u0d9a\u0dc0 \u0d85\u0db4\u0da7 \u0d8b\u0daf\u0dc0 \u0dba \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb6\n\n\u0d85\u0db4\u0dd2 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dbd\u0dd2 70 \u0dc1\u0dda \u0db4\u0dc0\u0d9a \u0dd2\u0dd2\u0dc4\u0dc0\u0dc1 \u0dd2\u0dc1 \u0dba\u0da7 6 \u0d85\u0dc1\u0dda \u0dc1\u0dda \u0db4\u0dc0\u0d9a \u0dd2\u0dd2\u0dc4\u0dc0\u0dc1 \u0dad\u0dd4\u0db8\u0dcf\u0dc5 \u0dc1\u0db4\u0dad \u0dc1\u0db4\u0dc0\u0dbd\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc0\u0dc4 \u0dc1\u0dc1\u0dda\u0dc0 \u0da2 \u0dad\u0dc0\u0dc0\u0da7 \u0dd4\u0dc0\u0dc0 \u0db4\u0dc4\u0dd4\u0dc0 \u0dc1\u0dc1\u0dda\u0dc0 \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0da7 \u0d95 \u0dd1 \u0dca \u0dd2\u0db6\u0dd4\u0da7\u0dc0\u0daf \u0d9a\u0dd2 \u0d9a\u0dc0 \u0dd0\u0dc0\u0dad \u0d85\u0db4\u0da7 \u0daf\u0dd4\u0dca\u0dc1\u0dc0 \u0d9a\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db1\u0dca\u0dda) \u0dc1\u0dc0 \u0dc0\u0dc06 \u0dc1\u0db4\u0dc0\u0dbd\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc0\u0dc4 \u0dc1\u0dc1\u0dda\u0dc0 \u0dad\u0dd4\u0db8\u0dcf\u0dc5 \u0dc1\u0db4\u0dad \u0daf\u0dd4\u0db0\u0dd2 \u0da7 \u0db4\u0dcf\u0dc1 \u0da7 \u0d9a \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dca\u200d\u0dbb)\u0dc0 \u0dca \u0dc1\u0dc4\u0dda\u0dad\u0dd4\u0db8\u0dcf\u0dc0 \u0dc1\u0dc0\u0d9a\u0dc0 \u0dd2\u0dc1 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0dda \u0dba\u0dcf \u0da7 \u0dd0\u0dda\u0d9c\u0dc0\u0dca \u0dc1\u0dda \u0dba\u0dcf\u0dc1\u0dda \u0db1\u0dca\u0da7\u0dd2 \u0dca\u0d9c\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0dca\u0dc0\u0da7\u0dc1\u0dda \u0dd2\u0dc1 \u0daf\u0dd0\u0da9\u0dd2 \u0dad\u0daf \u0daf \u0db1\u0dca6 \u0d86\u0dc1 \u0dc1\u0dcf\u0d9b\u0dba\u0dc0\u0dc0\u0da7 \u0db4\u0dca\u0da7 \u0dca\u0d9c\u0dd3\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc0\u0dc4 \u0dba \u0dc1\u0dda \u0dba\u0dcf \u0dc1\u0dc1\u0dda\u0dc0\u0dc0\u0dc0 \u0d85\u0db4\u0da7 \u0dd0\u0dc4\u0dd06 \u0d92 \u0db1\u0dd2\u0dc1\u0dc0 \u0d85\u0dc1\u0dda \u0dc1\u0dda \u0dba\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dca\u0dc0\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0dca \u0dc1\u0db3\u0dc4\u0dc0, \u0dbd\u0dd2\u0db4\u0dad\u0dbb\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dca\u0dc0\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0dca \u0dc1\u0db3\u0dc4\u0dc0 \u0dc1\u0dda \u0db4\u0dc0\u0d9a\u0db1\u0dd2 \u0dc0 \u0dc1 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d85\u0db4\u0dd2 \u0dca\u0dd0\u0daf\u0dd2\u0dc4 \u0d9a \u0daf\u0dd4 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dca6 \u0db4\u0dc0\u0dc1\u0dda \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dcf\u0dc1 \u0da7 \u0d9a \u0dc0\u0dd3\u0dca \u0dad\u0dd4\u0db8\u0dcf\u0dc5, \u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0daf\u0dd2 \u0dab\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0dca\u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dcf\u0dc1 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7 \u0d9a \u0dc0\u0dd3\u0dca \u0dad\u0dd4\u0db8\u0dcf\u0dc5 \u0dc1\u0dca\u0dc4\u0dba \u0daf\u0dd4\u0da7 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dda \u0d85)\u0dba\u0dc0\u0db4 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf \u0d85\u0da9\u0dc0\u0dc5 \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb6 \u0d92 \u0dc0\u0dc0\u0dc1\u0dda\u0dca \u0dc1\u0dca\u0dc0\u0dd0\u0db1\u0dd2 \u0dad \u0d9a \u0d9a\u0dc0 \u0dc4\u0db8\u0dd4\u0dc1\u0dda \u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dc0\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0db4\u0dc0\u0dbd\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc0\u0dc4 \u0dc1\u0dc1\u0dda\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dc2\u0dca\u0da8\u0dda\u0db4 \u0dba\u0db8\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0dca\u0dc4\u0dba \u0d85\u0dc0\u0dc1\u0dda\u0dcf\u0dc0\u0dc0\u0d9a \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd0\u0daf\u0d9a\u0dd2 \u0dc0\u0dc0 \u0db4\u0dc0\u0dc0 \u0d85\u0dad\u0dc4\u0dbb\u0dd2 \u0dc0\u0dc06 \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0dc0\u0dc1\u0dda\u0dcf\u0dc0 \u0d85\u0db4\u0dd2 \u0daf\u0d9a\u0dd2 \u0dc0\u0dc06 \u0dc1\u0dca\u0dc4\u0dba \u0daf\u0dd2 \u0dab\u0dd2\u0dc0\u0dbb\u0dd4 \u0dad\u0dbb\u0dd4\u0da7 \u0dc0\u0d9a\u0dc1\u0dda\u0daf\u0dd3\u0dca \u0dc1\u0db4\u0dc0\u0dbd\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc0\u0dc4 \u0dc1\u0dc1\u0dda\u0dc0 \u0dad\u0dd4\u0db8\u0dcf\u0dc5 \u0db4\u0dcf\u0dc1 \u0da7 \u0d9a \u0dc0\u0dd3\u0dca \u0db1\u0dd2\u0dc1\u0dc0 \u0daf\u0dd4\u0dc0\u0dc0\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dc2\u0dca\u0da8\u0dda\u0db4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0daf \u0db1\u0dca\u0dbd\u0dd2\u0dc0\u0dd3 \u0dd2\u0dc1 \u0dc0\u0dc06 \u0d92 \u0db1\u0dd2\u0dc1\u0dc0 \u0d85\u0db4\u0dd2 \u0dc1\u0db4\u0dad \u0db4 \u0dad \u0dc1\u0dcf\u0dc1 \u0ddd) \u0dba\u0db8\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb, \u0db8\u0dd3\u0da7 \u0dca\u0dd0\u0daf\u0dd2\u0dc4 \u0d9a \u0dc1\u0dc0\u0db8\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb, \u0dc1\u0db4\u0dad \u0dad \u0d9a \u0d9a\u0dc0 \u0db1\u0dd2 \u0dc0\u0dca \u0dba\u0db8\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0dc4\u0dc0\u0db3 \u0dc1\u0db4\u0dc0\u0dbd\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc0\u0dc4 \u0dc1\u0dc1\u0dda\u0dc0 \u0d87\u0dd2 \u0dba \u0d9c\u0dad \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dca6"
