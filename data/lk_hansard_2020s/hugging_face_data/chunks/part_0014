    "chunk_text": "\u0dbb\u0da7\u0da7 \u0db4\u0dd4\u0dbb9\u0dd0\u0dc3\u0dd2 \u0db1\u0dc1 \u0da2\u0dd39\u0dca \u0dc0\u0dd3\u0dc1\u0dca\u0db4 \u0d85\u0dba\u0dd2\u0dad\u0dd2 \u0dad\u0dc4\u0dba\u0dc0\u0dd4\u0dc0 \u0d9a\u0dd2\u0dbb\u0dd3\u0da2 \u0dbb\u0da2 \u0da7 \u0db8\u0dd6\u0dbd\u0dd2\u0da7 \u0da7\u0dcf\u0dbb\u0dca \u0dc0\u0dcf\u0dbb \u0d9a\u0dca \u0dc19\u0db19\u0dcf. \u0d9a\u0dc4\u0dd2 \u0da2 \u0dbb\u0dc1\u0da7\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0dc1\u0dad \u0d86\u0db0\u0dd2\u0db4\u0dad\u0dba \u0dad\u0dc4\u0dba\u0dc0\u0dd4\u0dc0 \u0d9a\u0dd2\u0dbb\u0dd3\u0da2 \u0d86\u0dab\u0dca\u0da9\u0dd49 \u0dc3\u0dad\u0dd4\u0db8 \u0db8\u0dd6\u0dbd\u0dd2\u0da7 9\u0d9c\u0d9a\u0dd3\u0da2\u0d9a\u0dca. \u0dc1\u0da7\u0dc1\u0dc3\u0dda \u0db1\u0db8\u0dd4\u0dca \u0d8b \u0dc1\u0dca\u0db4 9\u0db1\u0dc0\u0dd2\u0da7 \u0dbb\u0da7 \u0db4\u0dd4\u0dbb\u0dcf \u0dc3\u0dd2\u0daf\u0dd4 9\u0db1 \u0dc19\u0da9\u0dd2 \u0dad\u0dd0\u0db6\u0dd3\u0dca\u0db4\u0d8b \u0da2\u0db1\u0dd4\u0dc2\u0dca\u0da8\u0dba \u0d9d\u0dcf\u0dad\u0db1\u0d8b \u0dad\u0dbb\u0dca\u0da2\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0dca\u0db4 9\u0dc5\u0d9a\u0dca9\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0da2\u0da7 9\u0dca \u0da2 \u0db1 \u0d86\u0dab\u0dca\u0da9\u0dd49 \u0d85\u0dc1\u0db4\u0ddc\u0dc1\u0dc4\u0dba\u0ddc\u0dc3\u0dca \u0dc19\u0da9\u0dcf \u0dad\u0dd2\u0dc1 \u0db19\u0dcf. \u0da2\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2 \u0db1 \u0dc1\u0da2 \u0db1\u0da2 \u0dad9\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dca\u0db4 \u0db1\u0dad\u0dd4\u0db8 \u0da2 \u0db1\u0dad\u0dca\u200d\u0dbb\u0dd39\u0dc0 \u0db1 \u0dc0\u0dd2\u0dc3\u0dd2 \u0db1 \u200d \u0dc1\u0dca\u0db4 \u0dc3\u0dca\u0db4 \u0db1\u0db0\u0dc1 \u0db1 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dca\u0db4 \u0db1\u0dad\u0dd4\u0db89 \u0dc4\u0dba\u0db8\u0dd4\u0dc1\u0dda \u0dca\u200d\u0dbb \u0dcf\u0db1 \u0da7\u0dbb \u0dca\u0dad\u0dca \u0d8b \u0dc1\u0da2\u0dc1\u0dad\u0d9a\u0dca \u0dca\u200d\u0dbb\u0da2\u0dcf\u0dda9\u0dca \u0dc0\u0dd2\u0dc3\u0db3\u0dd4\u0dca\u0db4 \u0da9\u0dd0\u0db6\u0dd2\u0da9\u0dcf \u0db1\u0dd0\u0dc4\u0dba\u0dd0. \u0d9a\u0da2 \u0db1\u0dd2\u0dc3\u0dcf \u0d92 \u0dc3\u0d9a\u0dc4\u0dba\u0dcf \u0dc0\u0dd6 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc1\u0dda 9\u0d9c\u0dc0\u0dd3\u0da2 \u0db4\u0dd2\u0db6\u0db3 \u0d9a9 \u0db4\u0dc4\u0dba\u0dad \u0dc3\u0d9a\u0dc4\u0dba \u0db1 \u0dca\u200d\u0dbb \u0dcf\u0db1 \u0da2\u0dcf \u0dc1 \u0ddc\u0db8\u0dd4 \u0da7\u0dbb\u0db19\u0dcf.\n\n2. \u0dbb\u0da7 \u0db4\u0dd4\u0dbb\u0dcf \u0dca\u200d\u0dbb\u0da0\u0dab\u0dca\u0da9\u0dca 9 \u0d89\u0dc4\u0dba\u0dc5 \u0dcf\u0da2 \u0dc3\u0dc4\u0dba \u0da2\u0dcf\u0dad\u0dd2\u0da7 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dcf9 \u0d85\u0dad\u0dbb \u0dc3\u0dca\u0db4 \u0db1\u0db0 \u0d9a\u0dca \u0dca\u0dad\u0dd2 9 \u0d86\u0dab\u0dca\u0da9\u0dd49 \u0dc1\u0db1\u0ddc\u0db4\u0dd2\u0db6\u0db3\u0d9c \u0db1\u0dc1 \u0db1\u200d?\n\n\u0dc1\u0da2\u0ddc\u0da7\u200d\u0d8b \u0dc4\u0dba\u0dd0\u0da2 \u0dc19\u0da9\u0dcf\u0dc1\u0dda\u0da2 \u0dca\u0da2\u0dad\u0dd29\u0dc0 \u0d9a\u0dd2 \u0db19\u0dcf \u0d9d\u0dcf\u0dad\u0db1 \u0dc3\u0dc4\u0dba \u0da2\u0dcf\u0dad\u0dd2\u0da7 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dcf9 \u0d85\u0dad\u0dbb \u0d9a\u0dd2\u0dc3\u0dd2\u0da2 \u0dc3\u0dca\u0db4 \u0db1\u0db0 \u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dba\u0dd0\u0dba\u0dd2 \u0d9a\u0dd2 \u0da9\u0dcf. \u0d85\u0db1\u0dd29\u0dcf\u0dbb\u0dca \u0dc1 \u0db1\u0da2 \u0dbb\u0dc1\u0da7\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dcf9\u0d8b \u0da2\u0db1\u0dad\u0dcf9\u0dc1 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dcf9 \u0dc3\u0dc4\u0dba \u0da2\u0dcf\u0dad\u0dd2\u0da7 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dcf9. \u0dc1\u0dca\u0db4 \u0dca\u200d\u0dbb\u0da0\u0dab\u0dca\u0da9\u0dca 9 \u0d89\u0dc4\u0dba\u0dc5 \u0dcf\u0da2 \u0dc0\u0dd2\u0dc1 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0da7\u0dba\u0dd2 \u0db1\u0dc1 \u0db4\u0dd0\u0dd2\u0dba\u0dab\u0dd3 \u0d9a\u0da2\u0da7\u0d8b \u0dc0\u0dd2\u0dc1 \u0d86\u0dc1 \u0ddd\u0da2\u0da7\u0dba\u0dd2 \u0db1\u0dc1 \u0d86\u0da7\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0dda \u0da7 \u0d9a\u0dbd\u0dca\u0da9 \u0da7\u0dbb\u0db1\u0dd4 \u0da9 \u0db1 \u0d85\u0dc4\u0dd2\u0dad\u0da7\u0dbb \u0da9\u0db4\u0dd1\u0da2 \u0db4\u0dd2\u0db6\u0db3 \u0d9a9 \u0dbb\u0da2\u0dc1\u0dad \u0d859\u0db0\u0dcf\u0db1 \u0dc1 \u0ddc\u0db8\u0dd4 \u0da7\u0dbb \u0dad\u0dd2\u0dc1\u0dda\u200d?\n\n3. \u0dbb\u0da7 \u0db4\u0dd4\u0dbb\u0dcf 9\u0dba\u0dcf\u0dbd\u0ddd\u0dad9 \u0dca\u0dad\u0dd2 \u0da2\u0dca \u0daf\u0dca\u200d\u0dbb9\u0dba9\u0da9 \u0d8d\u0da2\u0dd4 \u0dc0\u0dd2 \u0db1\u0daf\u0dd2\u0dad\u0dba\u0dd2 \u0db1 9\u0da7 \u0dca\u0dda \u0dd0\u0dc4\u0dd2\u0dc0\u0dd69 \u0db1 \u0dc3\u0dc4\u0dba \u0d94\u0dc0\u0dd4 \u0db1\u0dc1 \u0db4\u0dc0\u0dd4\u0dbd\u0dca \u0db4\u0dca \u0dc19 \u0da2\u0d8b \u0da2\u0dca \u0daf\u0dca\u200d\u0dbb9\u0dba \u0da2\u0dcf9\u0dcf\u0dbb\u0dca\u0db4\u0da7\u0dc0 9 \u0db1 \u0d85\u0dad\u0dbb \u0dc3\u0dd2\u0daf\u0dd4 \u0dc19\u0db1 \u0d9d\u0da7\u0dca\u0da7\u0db19\u0da9 \u0dc1\u0d9c\u0ddc\u0daf\u0dd4\u0dc0 9\u0da7 \u0dc3\u0dcf\u0da2\u0dcf\u0db1\u0dba \u0da2\u0db1\u0dad\u0dcf9\u0da7 \u0db49\u0dcf \u0db4\u0dca \u0dc0\u0dd3\u0da2\u0da7 \u0dc3\u0dd2\u0daf\u0dd49 \u0dad\u0dd2\u0dc1 \u0db19\u0dcf. \u0dc1\u0dca\u0db4 \u0db4\u0dd2\u0db6\u0db3 \u0d9a9 \u0dbb\u0da2 \u0dc1\u0da2\u0dc1\u0dad\u0d9a\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dca \u0da2\u0da7 \u0da7\u0dc5 9\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0dba\u0db1 \u0d85\u0dc3\u0dcf\u0dbb\u0dca\u0dae\u0da7 9 \u0dc1\u0db4\u0db1\u0dd3 \u0db1 \u0dc1\u0dc4\u0dba\u0dba\u0dd2 \u0db1\u0d8b \u0dbb\u0da2 \u0dc3\u0dad\u0dd4\u0db89 \u0d92 \u0dc3\u0d9a\u0dc4\u0dba\u0dcf \u0dc19\u0db1\u0dca \u0dc0\u0dd2\u0da7\u0dbd\u0dca\u0db4 9\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0dba\u0db1\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0dda\u200d? \u0d9a\u0dc1\u0dc3\u0dda \u0db1\u0dca\u0db4 \u0d92 \u0d9a\u0dd4\u0da2\u0d9a\u0dca\u200d?\n\n4. \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dca\u0db4 \u0db1\u0dad\u0dd4\u0db8 \u0da2 \u0db1\u0dad\u0dca\u200d\u0dbb\u0dd39\u0dc0 \u0d8b - \u0d85\u0dc1\u0dbd\u0ddd \u0d9c\u0dc0 \u0dc1\u0dbb\u0ddd\u0dc4\u0dba\u0dda \u0dab\u0dca\u0da9\u0dcf\u0dbb \u0da2\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0da2\u0dcf\u0da7\u0dca \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0dad\u0dbb\u0dca\u0da2\u0db1 \u0d9a\u0dbd\u0dca\u0da9 \u0dc19\u0da9\u0dcf \u0dad\u0dd2\u0dc1 \u0db19\u0dcf. \u0d85\u200d \u0d9a\u0dad\u0dd4\u0db8\u0da2\u0dcf\u0da7 \u0db1\u0dd2\u200d\u0dc4\u0dba\u0dc1\u0dc3\u0dda \u0dc1 \u0db4\u0dcf\u0da9\u0db1 \u0da7\u0da7\u0dd4\u0d9a\u0dad\u0dd4\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0da2\u0da7 \u0dc3\u0dc4\u0dba \u0d9a\u0dad\u0dd4\u0db8\u0da2\u0dcf\u0dc1 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0da7\u0dcf\u0dbb\u0da7\u0dca\u0db4 \u0da7\u0dbb \u0db1\u0db1\u0da7 \u0dc1\u0db1\u0ddc\u0dc4\u0dba\u0dd0\u0d9a\u0dd29 \u0da2\u0dbb\u0dda \u0dad\u0dbb\u0dca\u0da2\u0db19\u0da9\u0da7 \u0da9\u0d9a\u0dca \u0dc19\u0da9\u0dcf \u0dad\u0dd2\u0dc1 \u0db19\u0dcf- \u0dbb\u0da2\u0dc1\u0dad \u0db1\u0dd2\u0da9\u0db0\u0dcf\u0db1\u0dca \u0db1\u0d8b -\n\n1007 1008\n\n\u0dd3\u0d9c\u0dc0 \u0dc3\u0dd29\u0da5\u0dcf\u0db1\u0dca\u0db4 \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dbb \u0db1 \u0da2\u0dc4\u0dba\u0dad\u0dcf\n\n2025 \u0da2\u0dd0\u0dba\u0dd2 20\n\n\u0d94 \u0dad\u0dd4\u0db8\u0da2\u0dcf \u200d \u0db1\u0db19\u0dcf \u0da2\u0dcf\u0dad\u0dd2\u0da7 \u0d96\u0dc2\u0dca\u0da8\u0db0 \u0db1\u0dd2 \u0dcf\u0da2\u0db1 \u0d85\u0db0\u0dd2\u0da7\u0dcf\u0db1\u0dca\u0dc1\u0dad \u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0dc0\u0dd2\u0db0\u0dcf \u0da7 \u0db1\u0dd2\u0da9\u0db0\u0dcf\u0db1\u0dca \u0dc3\u0dc0\u0dd3 \u0db1 \u0dc1\u0dc3\u0dda\u0da2\u0dc1 \u0d89\u0dbd\u0dca\u0da9\u0dcf \u0d85\u0dc3\u0dcf\u0dc19\u0da9\u0dcf \u0dad\u0dd2\u0dc1 \u0db19\u0dcf\u0d8b \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0dad\u0dbb\u0dca\u0da2\u0db1\u0d8b \u0d9c\u0dbb\u0dca\u0da2\u0db1 \u0da2\u0dd0 \u0dc1 - \u0d92 9\u0dcf\u0dc1 \u0da2 \u0db4\u0dc5\u0dcf\u0dca \u0db4\u0dcf\u0da9\u0db1 \u0dc3\u0db7\u0dd2\u0da7\u0dba\u0dd2 \u0db1 \u0d89\u0da9\u0d9a\u0dca\u0da7\u0dc1\u0da7\u0ddc\u0da7 \u0d8d\u0da2\u0dd49\u0da2 \u0dc4\u0dba\u0dcf 9\u200d\u0dbb\u0dcf\u0da7\u0dcf\u0dbb9 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc19\u0db1 \u0dad\u0dbb\u0dca\u0da2\u0db1 \u0dc3\u0dca\u0db4 \u0db1\u0db0\u0dc1 \u0db1 \u0dbb\u0da2\u0dc1\u0dad \u0dc3\u0dcf\u0dae\u0dcf9\u0dbb \u0d9a\u0dd4\u0da2\u0d9a\u0dca\u200d? \u0d85\u0db4\u0dd2 \u0dc4\u0dba\u0dd0\u0dc1\u0da2\u0ddd\u0da2 \u200d \u0db1\u0db19\u0dcf \u0dad\u0dd4\u0db8\u0dc3\u0dd2\u0dad \u0dc4\u0dba\u0dbd\u0dca\u0dc1\u0da9\u0ddc\u0db8\u0dca9 \u0da2\u0dc4\u0dba\u0dad\u0dcf\u0da7\u0dca \u0d8b \u0d92 \u0db1\u0dd3\u0dad\u0dd2\u0da59\u0dbb \u0dcf\u0da7\u0dca \u0db4\u0dc3\u0dd4\u0d9c\u0dd2 \u200d9\u0dc3\u0da7 \u0d9a\u0dbd\u0dca\u0da9 \u0dc0\u0dd4\u0dab\u0dd4 \u0dca\u200d\u0dbb\u0dc4\u0dba\u0dcf\u0dbb \u0d9c\u0dd0\u0db1. \u0dc1\u0dca\u0db4 \u0d86\u0da7\u0dcf\u0dbb \u0da7 \u0dc1\u0dca\u0db4 9\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0dc0\u0dd6 \u0dc3\u0dd2 \u0db0\u0dd3 \u0db1 \u0dc3\u0dca\u0db4 \u0db1\u0db0\u0dc1 \u0db1 \u0dbb\u0da2 \u0d9c\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0da2\u0dcf\u0dbb\u0dca\u0d9c9\u0da9 \u0dca\u200d\u0dbb\u0d9c\u0dad\u0dd2 \u0dc1\u0da7 \u0db3\u0dd4\u200d?"
