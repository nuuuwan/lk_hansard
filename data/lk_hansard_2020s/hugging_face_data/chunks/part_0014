    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0dcf\u0dc0 \u0dc0 \u0dad\u0dd4\u0db8\u0dcf\u0dca\u0db1\u0dd2, \u0dc1\u0db4\u0dad \u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dc1\u0d9a\u0dc0\u0da7 \u0db4\u0dca\u200d\u0dbb \u0dda \u0dd2\u0dc1 \u0dc0\u0dc06 \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0db6\u0dbd \u0dc1\u0dda \u0dba\u0dcf \u0db4\u0db8\u0dd2 \u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dc0 \u0dc1\u0dca\u0dad\u0dd0 \u0d9a \u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0dc06 \u0db4\u0dca\u200d\u0dbb)\u0dc0 \u0dc1\u0db4\u0dc1\u0dc5\u0dda \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dba\u0dc0\u0db4\u0dc0\u0dbb\u0dd2 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0dca\u0dad\u0dd0 \u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0dc06 \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dc0 \u0d92 \u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0dc06 \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0db6\u0dbd \u0dc1\u0dda \u0dba\u0dcf \u0da7 permit \u0d91 \u0d9a\u0dd0\u0db6\u0dd4\u0da7\u0dc0\u0dca \u0d92 \u0dc1\u0dc0 \u0dc1 \u0dc1 \u0da7 \u0da7 \u0daf\u0dd4\u0da7 \u0da7 \u0d91 \u0d85\u0dca\u0dc0\u0dbb\u0dd4\u0db1\u0dca6 \u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0dca\u0dc0\u0dc1\u0dda \u0d8b\u0dad\u0dd4\u0db8\u0dcf\u0dbb\u0dd4 \u0dca\u0dd0\u0daf \u0db4\u0dc5\u0dc0\u0dc1 \u0d9a \u0dd2\u0db3\u0d9a\u0dc0 \u0dc1 \u0dc0\u0dc5\u0db9\u0da7 \u0d91 \u0dc1\u0dda \u0d91 \u0d92 route permit \u0d91\u0dc1 \u0d85\u0db1\u0dca\u0dd2 \u0dd2\u0dc1 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0db4\u0dc0\u0dc1\u0dc5\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbb\u0dd4\u0dc1\u0dda \u0dc0\u0dba\u0dc0\u0db4\u0dc0\u0dbb\u0dd2 \u0dca\u0dc4 \u0d9a\u0dca\u0dc1 \u0da7 \u0da7 \u0db4\u0dad, \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0dca\u0dc0 \u0d92 \u0dc1\u0dda \u0d91 \u0daf\u0dd4\u0da7 \u0dab\u0dd4\u0dc0\u0dc0\u0da7 \u0d92 route permit \u0d91 \u0dc1\u0dc0 \u0dc1 \u0dc1 \u