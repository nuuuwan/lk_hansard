    "chunk_text": "\u0dd2\u0db6\u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dd4\u0dc0 \u0dc1\u0db8\u0dad\u0dd0\u0dc3\u0da7 \u0d87\u0dd2\u0db6\u0dbd\u0dca\u0dbd\u0dcf \u0d85\u0daf \u0dc3\u0dda \u0d89\u0daf\u0dd2\u0dd2\u0db8\u0db4\u0dda \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a \u0dda\u0dc0\u0dcf, \u0d91\u0d9a \u0db4\u0dd1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4 \u0dd2\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dbb\u0dc3\u0dc0\u0dcf \u0d9a \u0dca\u0dc3\u0dca \u0d92\u0dc0\u0dcf \u0d9c\u0dd0\u0dc3. \u0dc1\u0db8\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dbd\u0dcf \u0d92\u0dc0\u0dcf \u0d9c\u0dd0\u0dc3 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf \u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb. \u0dbb\u0dc1\u0dca \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf\u0dc0\u0dbd\u0db8 , \u0dbb\u0dd0\u0dc3\u0dda\u0dc0\u0dd3\u0db8\u0db8\u0db1\u0dc0\u0dbd\u0db8 \u0d85\u0db4\u0dd2 \u0d91\u0d9a \u0db4\u0dd1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4 \u0dd2\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dad\u0dbb \u0d9a\u0dbb\u0dc3\u0dc0\u0dcf \u0d9a \u0dca\u0dc3 \u0d91\u0d9a \u0dad\u0dd4\u0dc5 \u0dad\u0dd2\u0dc1\u0dbd\u0dc3 \u0d85\u0daf \u0dc3, \u0dd0\u0db8 \u0dc1\u0daf\u0dca\u0d9a\u0dca\u0db8 \u0d91\u0d9a \u0db4\u0dd1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4 \u0dd2\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dad\u0dbb \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3 \u0dc3\u0dca\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a \u0dca\u0dc3 \u0d9a\u0dcf\u0dbb\u0dab\u0dca \u0dc1\u0dc3\u0dcf\u0dc1\u0dc0\u0db1\u0dca. \u0d92\u0dc1\u0d9a\u0dca \u0d85\u0daf \u0dc3 \u0dd2\u0db6\u0db4\u0d9a\u0dca\u0dc2\u0dca\u0da7 \u0dc1\u0dda\u0dc1\u0dbb\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dd0 \u0dd0. \u0d86\u0dab\u0dca\u0da9\u0da9\u0dd4 \u0db4\u0d9a\u0dca\u0dc2\u0dca \u0dd0\u0da7\u0dd2\u0dca\u0da7 \u0d85\u0db4\u0dd2 \u0d85\u0dc1 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1 \u0dc0\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0daf \u0d9a\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3 \u0d95\u0dc3\u0dd1 \u0d9a \u0dca\u0dbd\u0dcf, \u0dd0\u0db8 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0db1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dc1\u0dca\u0d9a\u0dd4\u0da7\u0db8 \u0dc0\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0daf\u0dca\u0d9a\u0dca\u0dc0 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dc0\u0dcf \u0dc3 \u0db4\u0dbb\u0dca\u0db8\u0dd2\u0dca \u0d91\u0d9a \u0dc3\u0dad\u0dbb \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3 \u0d95\u0dc3\u0dd1 \u0d9a \u0dca\u0dbd\u0dcf \u0dd3\u0dbb\u0dbb\u0dab\u0dca\u0d9a\u0dca \u0d9c\u0dda\u0dad\u0dcf, \u0d9c\u0dd4\u0dc0 \u0db1\u0dd2\u0dc1\u0dca\u0ddd\u0da2\u0dba \u0d9a\u0dae\u0dcf\u0dc3\u0dcf\u0dca\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0d92 \u0dd3\u0dbb\u0dbb\u0dab\u0dca \u0d85\u0dbb\u0dc1\u0d9c\u0dc3 \u0d92 \u0dc0\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0daf\u0dca \u0d91\u0d9a \u0db4\u0dd1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4 \u0dd2\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dad\u0dbb \u0d9a\u0dc5\u0dcf. \u0d86\u0dab\u0dca\u0da9\u0da9\u0dd4\u0dc0 \u0db4\u0dda \u0dc1\u0dc0\u0dbd\u0dcf \u0d91\u0d9a \u0db4\u0dd1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4 \u0dd2\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db8 \u0d92 \u0dc0\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0daf\u0dca \u0dc3\u0dad\u0dbb \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0dbd\u0dc3\u0dc0\u0dcf. \u0d91\u0d9a \u0db4\u0dcf\u0dbb\u0da7\u0db8 \u0d91\u0db8 \u0dc0\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0daf\u0dca \u0d9a\u0dcf\u0da7\u0dc0\u0dda \u0db8\u0db1\u0dbd \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dd0\u0dad\u0dd4\u0dc0 \u0dc0\u0dca\u0dcf. \u0dd0\u0db8 \u0dc1\u0daf\u0dca\u0d9a\u0dca\u0db8 \u0d91\u0d9a \u0db4\u0dd1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4 \u0dd2\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dad\u0dbb \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3 \u0dbd\u0dd0 \u0dd0 \u0d9a \u0dca\u0dbd\u0dcf \u0dd2\u0db6\u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7 \u0dc1\u0dda\u0dc1\u0dbb\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dd0 \u0dd0. \u0d92 \u0dc1\u0d9c\u0dcf\u0dbd\u0dca\u0dc1\u0dbd\u0ddd \u0d92 \u0dc1\u0d9c\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7 \u0dc1\u0dda\u0dc1\u0dbb\u0dc3 \u0dd2\u0db6\u0db0\u0dd2\u0dca\u0da7 \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0dc3\u0dca \u0d9a\u0dbb\u0dc3\u0dca \u0dba\u0dd4\u0d9c\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dbd\u0dc0\u0dbd\u0da7 \u0dad\u0db8\u0db1\u0dca, \u0d92 \u0dc1\u0dda\u0daf\u0dc0\u0dcf\u0da0\u0d9a\u0dca\u0da7 \u0dad\u0db8\u0db1\u0dca \u0d85\u0dc1 \u0dbb\u0da7 \u0dc1\u0db8\u0db1 \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1\u0dda \u0dc1\u0db8\u0db1 \u0db8\u0dd4\u0dd4\u0dab\u0dab \u0dc1\u0daf\u0db8\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d89\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb."
