    "chunk_text": "\u0db4\u0dc3\u0dd4\u0d9c\u0dd2 \u0da2\u0dd0\u0dad\u0dd29\u0dbb\u0dda \u0dc3\u0da2\u0dc1\u0dad \u0dc3\u0dc4\u0dba \u0d92 \u0d86\u0dc3 \u0db1\u0db1 \u0da7\u0dcf\u0da9\u0dc1\u0dad\u0dca \u0d8b \u0d8a\u0da7\u0dca \u0da7\u0dbd\u0dd2 \u0db1 \u0d89\u0d9a\u0da9\u0dcf\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0da2 \u0dca\u200d\u0dbb \u0dcf\u0db1 \u0d9a\u0dca \u0dad\u0da2\u0dba\u0dd2\u0d8b 9\u0db1 \u0dc3\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dda \u0dc1\u200d\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc1\u0dca\u0db4 \u0db1\u0dad\u0dd4\u0db89 \u0dc3\u0dc4\u0dba 9\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0dc3\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dda \u0dc1\u200d\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc1\u0dca\u0db4 \u0db1\u0dad\u0dd4\u0db89 \u0dda\u0dad\u0dd4\u0db8\u0dc1\u0dbb\u0dca \u0da2\u0dd39\u0dca 9\u0db1 \u0da2\u0db1\u0dad\u0dcf9\u0dc1 \u0d89\u0da9\u0dca\u0db4 \u0d92 \u0d86 \u0dad\u0db19\u0da9 \u0d89\u0da9\u0dca\u0db4 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0da9\u0d9a\u0dd4\u0dab\u0dd4 \u0da7\u0dbb \u0dad\u0dd2\u0dc1 \u0db19\u0dcf \u0d9a\u0dd2 \u0db1 \u0d9a\u0da7. \u0d9a\u0da7 \u0dca\u200d\u0dbb \u0dcf\u0db1 \u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0d85\u0db4\u0da7 \u0d92\n\n\u0d92 9\u0dcf\u0dc1 \u0da2 \u0dc1\u0dca\u0db4 \u0dc3\u0dca\u0db4 \u0db1\u0db09 \u0db1\u0dd2\u0d9a\u0dd4\u0dca \u0da7\u0dc5 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb \u0d85\u0db1\u0dd49 \u0dc1\u0da2\u0dad\u0dd0\u0db1 \u0daf\u0dd2\u0dc3\u0dcf\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7 4\u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db19\u0dcf. \u0d9a\u0da2 \u0daf\u0dd2\u0dc3\u0dcf\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0da7 4\u0da7 \u0dca\u200d\u0dbb\u0dcf\u0dc1 \u0dd3\u0dba \u0dc1\u0dbd\u0dca\u0da7\u0dca\u0db4 \u0dc1\u0da7\u0ddc\u0da7\u0dca\u0db0\u0dcf\u0dc3 4\u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db19\u0dcf. \u0dc3\u0da2\u0dc4\u0dba\u0dbb \u0dc19\u0da9\u0dcf9\u0da7 \u0d89\u0dad\u0dd2\u0dc4\u0dba\u0dcf\u0dc3\u0dc1\u0dad \u0dad\u0dd2\u0dc1 \u0db1 \u0d85\u0dca \u200d\u0dd0\u0d9a\u0dd3\u0dca\u0db4 \u0db1\u0dd2\u0dc3\u0dcf \u0dc1\u0dca\u0db4 \u0dc3\u0dca\u0db4 \u0db1\u0db0\u0dc1 \u0db1 \u0d92 \u0da2\u0db1\u0dad\u0dcf9\u0da7 \u0dca\u0db4\u0d9a\u0dd2\u0dc3\u0dd2 \u0dc3\u0dd0\u0da7 \u0d9a\u0dca \u0dca\u0dad\u0dd2\u0dc19\u0da9\u0dcf \u0dca\u0dad\u0dd2. \u0d92 \u0dc3\u0dd0\u0da7 \u0db1 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dda\u0dca \u0dca\u0dad\u0dd2. \u0da2\u0da2 \u0d9a\u0dd2 \u0db1\u0dc1 \u0db1 \u0db1\u0dd0\u0dc4\u0dba\u0dd0\u0d8b \u0d9a9\u0dd0\u0db1\u0dd2 \u0dc3\u0dd0\u0da7 \u0db1 \u0dca\u0dad\u0dd2\u0dc0\u0dd3\u0da2 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dda \u0db1\u0dd0\u0dc4\u0dba\u0dd0 \u0d9a\u0dd2 \u0da9\u0dcf. \u0dc4\u0dba\u0dd0 \u0dd0\u0dba\u0dd2 \u0da2\u0db1\u0dad\u0dcf9\u0dc1\u0d9c\u0db1\u0dd4\u0dca \u0dc1\u0da9\u0ddc\u0d9a\u0dd4 \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0da2\u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db19\u0dcf\u0d8b \u200d\u0dd0\u0db1\u0da7 \u0dad\u0dc4\u0dba\u0dc0\u0dd4\u0dc0 \u0da7\u0dbb \u0db1\u0db1 \u0db4\u0dd4\u0dc5\u0dd49 \u0db1 \u0d89\u0da9\u0dca\u0db4 \u0da7\u0dd2\u0da7 \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0da7\u0dbb \u0dc1\u200d \u0db1\u0db1 \u0d9a\u0dd2 \u0da9\u0dcf. \u0dad\u0dc4\u0dba\u0dc0\u0dd4\u0dc0 \u0da7\u0dbb \u0d9c \u0db1\u0db1 \u0db4\u0dd4\u0dc5\u0dd49 \u0db1 \u0d89\u0da9\u0dca\u0db4 \u0dca\u200d\u0dbb\u0da2\u0dcf\u0dda \u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db19\u0dcf \u0dc1 \u0db1. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dc1\u0dca\u0db4 \u0dad\u0dc4\u0dba\u0dc0\u0dd4\u0dc0 \u0da7\u0dbb\u0d9c \u0db1\u0db1 \u0db4\u0dd4\u0dc5\u0dd49 \u0db1 \u0d89\u0da9\u0dca\u0db4 \u0da7\u0dd2\u0da7 \u0d85\u0db4\u0dd2 \u0d89\u0d9a\u0dca\u0da2\u0db1\u0dd2 \u0db1\u0da2 \u0d94\u0dc0\u0dd4 \u0db1\u0da7 \u0da9 \u0dcf \u0dc1\u200d\u0db8\u0dd4.\n\n\u0d8a\u0dc5\u0d9f\u0da7 \u0d85\u0dc1\u0dbd\u0ddd \u0da7\u0dd0\u0db6\u0dd2\u0db1\u0da7\u0dca \u0da2\u0dab\u0dca\u0da9\u0da9 \u0dbb\u0dab\u0dbb\u0dda \u0d9a\u0dca \u0d9c\u0dca \u0dad\u0dcf\u0d8b \u0d85\u0dc1\u0dbd\u0ddd \u0d9c\u0dc0 \u0d85\u0d9c\u0da2\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba \u0dc1 \u0db8\u0dd6\u0dbd\u0dd2\u0da7\u0dca 9\u0dc1 \u0db1 \u0db1\u0dd3\u0dad\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0da2\u0dcf\u0dca \u0da7\u0dd0\u0d9a9\u0dcf\u0d8b \u0dda\u0dad\u0dd4\u0db8\u0dc0 \u0d8b \u0db1\u0dd0 \u0dc1\u0d9f\u0db1\u0dc4\u0dd2\u0dbb \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0db1 \u0da7\u0dbb\u0db1 \u0dc3\u0dd2 \u0db8\u0dca\u0da2 \u0da2 \u0db1\u0dad\u0dca\u200d\u0dbb\u0dd39\u0dc0 \u0db1\u0dd4\u0dca \u0da7\u0dd0\u0d9a9\u0dcf\u0d8b \u0d85\u200d\u0dcf\u0dc5 \u0dbb\u0dcf\u0da2\u0dba \u0db1\u0dd2\u0da9\u0db0\u0dcf\u0db1\u0dca\u0db1\u0dd4\u0dca \u0da7\u0dd0\u0d9a9\u0dcf \u0dc1\u0dca\u0db4 \u0db4\u0dd2\u0db6\u0db3 \u0d9a9 \u0dc3\u0dcf\u0da7\u0da0\u0dca\u0dda\u0dcf \u0da7\u0dbb\u0da9\u0dcf \u0d9a\u0dad\u0dd0\u0db1 \u0da2 \u0dbb\u0dab\u0dbb\u0dda \u0d9a\u0dca \u0d9c\u0db1\u0dd2\u0db8\u0dd4 \u0d9a\u0dd2 \u0da9\u0dcf. \u0da2\u0da2 \u0dc4\u0dd2\u0dad\u0db1 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 239\u0dd0\u0db1\u0dd2 \u200d\u0dcf \u0dda\u0dc1 .00\u0da7 \u0dc1\u0dca\u0db4 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dca\u0db4 \u0db1\u0dad\u0dd4\u0db8\u0dc1\u0dda \u0da2\u0da2 \u0dda\u0dad\u0dd4\u0db8\u0dc0 \u0db4\u0dc5\u0dcf\u0dad \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0db1 \u0da7\u0dbb\u0db1 \u0da2 \u0db1\u0dad\u0dca\u200d\u0dbb\u0dd39\u0dc0 \u0db1 \u0dc3\u0dd2 \u0db8\u0dca\u0dc1\u200d\u0db1\u0dcf\u0dca \u0d8b \u0db1\u0dd0 \u0dc1\u0d9f\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dad \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0db1 \u0da7\u0dbb\u0db1 \u0da2 \u0db1\u0dad\u0dca\u200d\u0dbb\u0dd39\u0dc0 \u0db1 \u0dc3\u0dd2 \u0db8\u0dca\u0dc1\u200d\u0db1\u0dcf\u0dca \u0d8b \u0d85\u200d\u0dcf\u0dc5 \u0dbb\u0dcf\u0da2\u0dba \u0db1\u0dd2\u0da9\u0db0\u0dcf\u0db1\u0dca\u0db1\u0dd4\u0dca \u0d8b \u0db1\u0dd3\u0dad\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0da2\u0dcf\u0dca \u0dc3\u0dca\u0db4 \u0db1\u0db0 \u0dc19\u0da9\u0dcf \u0dc1\u0dca\u0db4 \u0db4\u0dd2\u0db6\u0db3 \u0d9a9 \u0dc3\u0dcf\u0da7\u0da0\u0dca\u0dda\u0dcf \u0da7\u0dbb\u0db19\u0dcf. \u0d92 \u0dc3\u0dcf\u0da7\u0da0\u0dca\u0dda\u0dcf\u0dc1\u0dda \u0da2 \u0dc1\u0dca\u0db4 \u0dc3\u0dca\u0db4 \u0db1\u0db09 \u0d859\u0dc3\u0dcf\u0db1 \u0dbb\u0dab\u0dbb\u0dda \u0d85\u0db4\u0dd2 \u0d9c\u0db1\u0dd2\u0db8\u0dd4.\n\n\u0da2\u0db1\u0dad\u0dcf9\u0da7 \u0d89\u0d9a\u0dca\u0da2\u0db1\u0dd2 \u0db1 \u0d89\u0da9\u0dca\u0db4 \u0da9 \u0dcf \u0da2\u0dc1\u0dca\u0db4 \u0dc0\u0dd49\u0da2\u0db1\u0dcf9\u0d9a\u0dd4\u0dca \u0d85\u0db4\u0da7 \u0dad\u0dd2\u0dc1 \u0db19\u0dcf. \u0d92 \u0dc3\u0dca\u0db4 \u0db1\u0db09 \u0da2\u0db1\u0dad\u0dcf9\u0dc1 \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0da2\u0d9a\u0dd4\u0dca \u0dad\u0dd2\u0dc1 \u0db19\u0dcf. \u0da2\u0db1\u0dad\u0dcf9\u0da7 \u0d9a\u0dd2\u0dc3\u0dd2\u0da2 \u0d86\u0da7\u0dcf\u0dbb \u0da7 \u0dca\u200d\u0dbb \u0dcf\u0db1 \u0d9a\u0dca\u0d8b \u0d9c\u0dd0\u0da7\u0db8\u0dca9\u0d9a\u0dca \u0dca\u0dad\u0dd2 \u0dc1\u0db1\u0ddc9\u0db1 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0d94 \u0dad\u0dd4\u0db8\u0da2 \u0db1\u0da9\u0dcf\u0dc1 \u0d85\u200d\u0dc4\u0dba\u0dc3\u0dcf9\u0da9\u0da7\u0dca \u0dca\u0dc4\u0dd4\u0dca\u0db4\u0da7 \u0db1 \u0da2\u0da9\u0dcf \u0db1\u0dd3\u0dad\u0dd2 \u0db4\u0dd0\u0dca \u0dad\u0dca \u0da9\u0dcf \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dda \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0d89\u0da9\u0dca\u0db4 \u0d85\u0dba\u0dd2\u0dad\u0dd2 \u0dad\u0dc4\u0dba\u0dc0\u0dd4\u0dc0 \u0da7\u0dbb \u0db1\u0db1 \u0db4\u0dd4\u0dc5\u0dd49 \u0db1 \u0d85 \u0da7 \u0d89\u0da9\u0dca\u0db4 \u0da9 \u0dcf \u0da2\u0da2\u0da7 \u0da7\u0da9\u0dd2\u0db1\u0dd2\u0dba \u0db1 \u0db4\u0dd2 9\u0dbb \u0d9c\u0db1\u0dd2\u0db8\u0dd4. \u0d92 \u0d89\u0da9\u0dca\u0db4 \u0d9a\u0dd2\u0dc3\u0dd2\u0dc1\u0dc3\u0dda\u0dca \u0da2 \u0dbb\u0da2 \u0da7 \u0db49\u0dbb\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0da2\u0da7 \u0da9\u0dcf\u0dc1\u0db4\u0ddc\u0dc1\u0dbb\u0ddc\u0dca \u0dad\u0dd4\u0db89\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dba\u0dd0. \u0da2\u0da2 \u0dc4\u0dd2\u0dad\u0db1 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7\u0d8b \u0d92 \u0dda\u0dca \u0dad\u0dbb \u0dca\u200d\u0dbb\u0da2\u0dcf\u0dda9\u0dca ."
