    "chunk_text": "\u0d86\u0dab\u0dca\u0da9\u0da9\u0dd4\u0dc1\u0dda \u0dbd\u0dd4\u0dab\u0dad\u0dbb\u0dca\u0d9a\u0dca \u0dd0\u0dd2\u0db8\u0da0\u0dca\u0da0, \u0dd0\u0dd2\u0db8\u0da0\u0dca\u0da0 \u0db4\u0dd0\u0dda\u0dad\u0da7 \u0dc1\u0dbd\u0dcf\u0dd4\u0dc0 \u0d9a \u0dca\u0dc3\u0dc0\u0dcf. \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dbd\u0dcf\u0dc1\u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbd\u0dd4\u0dab\u0dad\u0dbb\u0dca\u0d9a\u0dc1 \u0daf\u0dd2\u0dc0 \u0dd0\u0dd2\u0db8\u0da0\u0dca\u0da0 \u0dd0\u0dd2\u0db8\u0da0\u0dca\u0da0 \u0db4\u0dd0\u0dda\u0dad\u0da7 \u0dc1\u0dbd\u0dcf\u0dd4\u0dc0 \u0d9a \u0dca\u0dc3\u0dc0\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dbd\u0dcf\u0da7 \u0dbd\u0dd4\u0dab\u0dd4 \u0d85\u0dc0 \u0dba \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dd0 \u0dd0. \u0dd0\u0dbd\u0dd0\u0db1\u0dca, \u0dc1\u0db8\u0db1 \u0dbb\u0dc1\u0dca \u0da2\u0dc3\u0dad\u0dcf\u0dc0\u0da7 \u0dbd\u0dd4\u0dab\u0dd4 \u0da7\u0dd2\u0d9a \u0d9a\u0dd1\u0db8\u0da7 \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3 \u0d85\u0dc0 \u0dba \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5 \u0daf\u0dbd\u0dcf \u0dc1\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3. \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dbd\u0dcf\u0dc1 \u0dc1\u0dc3\u0dcf \u0dd0\u0d9a \u0dca\u0dcf\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3. \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dbd\u0dcf\u0da7 \u0dc1\u0db8\u0db1 \u0dc0\u0dd0\u0dc1\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3 \u0dbd\u0dd0 \u0dd0. \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dbd\u0dcf\u0da7 \u0dc1\u0db8\u0db1 \u0dc0\u0dd0\u0dc1\u0dcf \u0dbd\u0dd0\u0dd2\u0db8 \u0dc0\u0dd4\u0dab\u0dcf\u0da7 \u0dbb\u0dc1\u0dca \u0da2\u0dc3\u0dad\u0dcf\u0dc0\u0da7 \u0daf\u0dc0\u0dc3\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0daf\u0dc0\u0dc3 \u0dc1\u0dbd\u0dcf\u0dd4\u0dc0\u0dc0 \u0dc1\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dbd\u0dcf \u0d85\u0dbb \u0dc3\u0dd4\u0dc3\u0dca\u0dd4\u0dc0\u0daf\u0dd4 \u0dc1 \u0dcf\u0dbb\u0d9a\u0db8 \u0d9a\u0dbb\u0dc3 \u0d91\u0d9a \u0dad\u0db8\u0db1\u0dca \u0dd2\u0db6\u0dc5\u0dd2\u0dbd\u0dda\u0da2\u0dcf \u0dc3\u0dd0\u0dad\u0dd2 \u0dc0\u0dd0\u0dc1\u0dcf.\n\n\u0d85\u0daf \u0d91\u0dc5\u0dd2\u0dc1\u0dda \u0d89\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dc0\u0dcf \u0db4\u0dcf\u0dad\u0dcf\u0dbd\u0dca. \u0dc1\u0db8\u0db1 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0db1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dd4\u0dc1\u0dda \u0d89\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dc0\u0dcf, \u0dbd\u0dd4\u0dab\u0dd4 \u0db4\u0dcf\u0dad\u0dcf\u0dbd\u0dca, \u0d9a\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dca\u0dc3\u0dbb\u0dca \u0db4\u0dcf\u0dad\u0dcf\u0dbd\u0dca, \u0dad\u0dc0\u0dda \u0db4\u0dd0\u0dda\u0dad\u0d9a \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d89\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dc0\u0dcf\n\n1439 1440\n\n\u0dad\u0d9c\u0dd4\u0dc0 \u0da0\u0db8\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0daf \u0dd2\u0db6\u0dc1\u0dda\u0dc3\u0dd2\u0dd2\u0db8 \u0db8 \u0dad\u0dcf\n\n2025 \u0db8\u0dd0\u0db1\u0dca 11"
  },
