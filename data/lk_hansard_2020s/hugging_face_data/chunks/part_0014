    "chunk_text": "\u0d85\u0db4\u0dd2 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d85\u0db8\u0ddc\u0dad\u0dba\u0ddc\u0dcf \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0dc1\u0dc0\u0dbd\u0ddc, \u0d9a\u0dbb\u0dca\u0db8\u0ddc\u0db1\u0dca\u0dad\u0dad \u0d85\u0db8\u0ddc\u0dad\u0dba\u0ddc\u0dcf \u0dad\u0dca \u0dc0\u0dd2\u0dc1 \u0dca\u0dc2 \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0d9a\u0dbb\u0dd3\u0db8\u0d9a\u0dca \u0d9a\u0dbb\u0dbd\u0ddc \u0d92 \u0d85\u0dc0 \u0dba \u0dad\u0db4\u0dc1\u0daf\u0dc3\u0dca \u0dbd\u0db6\u0ddc\u0dc1\u0d9c\u0db1 \u0daf\u0dd0\u0db1\u0da7\u0db8\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0db8\u0dc4 \u0db6\u0dd0\u0dcf\u0d9a\u0dd4\u0dc0\u0da7 \u0dda \u0d9a\u0dc3\u0dd2 \u0dc1\u0daf\u0dca\u0dc0\u0dbd\u0dca \u0dbd\u0dd2\u0dd2\u0dad\u0dc0 \u0daf\u0dd0\u0db1\u0dd4\u0dda \u0daf\u0dd3\u0dbd\u0ddc \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0ddc, \u0dd4\u0dbd\u0dca\u0dd3\u0dda \u0d9a\u0dbb\u0dbd\u0ddc \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0ddc \u0d85\u0dc0 \u0dba \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0db1 \u0dc1\u0dbd\u0dc3, \u0db6\u0dd0\u0dcf\u0d9a\u0dd4 \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2 \u0da7 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0 \u0dc0\u0dd4\u0dab\u0dd4 \u0db4\u0dd2\u0dd2\u0db4\u0dc3 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc0 \u0d9a\u0dbd\u0dd2\u0db1\u0dca\u0dad \u0db8\u0dc4 \u0db6\u0dd0\u0dcf\u0d9a\u0dd4\u0dc1\u0dc0\u0db1\u0dca\u0dad issue \u0d9a\u0dc4 circular \u0dc4\u0dc1\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0ddc \u0db8\u0ddc\u0dbb\u0dca\u0dad\u0dd4 31 \u0d9a\u0dbd\u0dd2\u0db1\u0dca\u0dad \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0ddc \u0dc3\u0ddc\u0d9a\u0da0\u0dca\u0da1\u0ddc \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d9a \u0dbd\u0ddc \u0dc4\u0dc1\u0dc3\u0dca \u0dc3\u0ddc\u0d9a\u0da0\u0dca\u0da1\u0ddc \u0d9a\u0dc4 \u0db4\u0dd2\u0dd2\u0db4\u0dc3\u0da7 \u0d85\u0dc0 \u0dba \u0dad\u0dc0\u0dad\u0dca \u0dc3\u0dc4\u0db1 \u0dbd\u0db6\u0ddc \u0dc1\u0daf\u0db1\u0dca\u0dad\u0db1\u0da7 \u0d85\u0db4\u0dd2 \u0dad\u0dad\u0dca\u0dc3\u0ddc\u0dc4 \u0d9a\u0dbb\u0db1\u0dc0\u0ddc \u0d92 \u0dc0\u0ddc\u0dc1\u0db8\u0db8 \u0dc1\u0db8\u0ddc\u0d9a\u0daf\u0dca\u0daf \u0d92 \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc4 \u0d9a \u0dbd\u0ddc \u0d9a \u0db1\u0dca\u0dad\u0db1\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0ddc\u0dc1\u0db4\u0ddc\u0dc1\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc, \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0dd2 \u0db1\u0dd2\n\n\u0dc0\u0dba\u0ddc\u0db4\u0ddc\u0dd2\u0db4\u0d9a \u0db1\u0dca\u0dad\u0da7 \u0dbd\u0db6\u0ddc \u0dc1\u0daf\u0db1\u0dca\u0dad\u0db1\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dad\u0db4\u0dd2\u0db4\u0db8 \u0dc3\u0dc4\u0db1 \u0dc1\u0dda \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca\u0dad \u0dbd\u0db6\u0ddc \u0dc1\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d85\u0db4\u0da7 \u0dc1\u0dda\u0db1\u0dc0\u0ddc \u0dad\u0dd0\u0db1 \u0dad\u0dd0\u0db1 \u0dc4\u0d9a \u0dc4\u0d9a \u0dc1\u0daf\u0dca \u0db4\u0ddc\u0db1 \u0db1\u0dba\u0ddc \u0db4\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dbd\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0dc3\u0ddc\u0d9a\u0da0\u0dca\u0da1\u0ddc \u0dad\u0dd2 \u0db8\u0dd2\u0db1\u0dca\u0dad, press conferences \u0dad\u0dd2 \u0db8\u0dd2\u0db1\u0dca\u0dad \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0d85\u0db4\u0dd3\u0dbb\u0dca\u0dad\u0dd2 \u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1\u0da7 \u0dc0\u0dd2\u0dc5\u0dd4\u0dad\u0dbb \u0d9a\u0dca \u0dad\u0dad\u0dca\u0dc3\u0ddc\u0dc4 \u0d9a\u0dbb\u0db1\u0dc0\u0ddc \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d85\u0dad\u0dd2 \u0db6\u0dc4\u0dd4\u0dad\u0dbb \u0d9a\u0dca \u0db4\u0dd2\u0dd2\u0db4\u0dc3 \u0dc1\u0dda \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0d85\u0db1\u0dd4\u0d9c\u0db8\u0db1 \u0d9a\u0dbb\u0dbd\u0ddc \u0db6\u0dd0\u0dcf\u0d9a\u0dd4 \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc1\u0dc0\u0dbd\u0ddc, \u0dc0\u0dd2\u0dc1 \u0dca\u0dc2\u0dc1 \u0db1\u0dca\u0dad\u0db8 \u0d9a\u0dbb\u0dca\u0db8\u0ddc\u0db1\u0dca\u0dad\u0dad \u0d85\u0db8\u0ddc\u0dad\u0dba\u0ddc\u0dcf \u0da7 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0 \u0dc1\u0dc0\u0dbd\u0ddc \u0d92 \u0dc1\u0d9c\u0ddc\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0dad\u0dc1\u0d9c\u0db1\u0dca\u0dad \u0d85\u0dc0 \u0dba recommendations \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0db6\u0dd0\u0dcf\u0d9a\u0dd4 \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2 \u0dad\u0dca \u0dc4\u0d9a\u0dca\u0d9a \u0d9c\u0db8\u0db1 \u0db1\u0dca\u0dad\u0db1\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0dbd\u0ddc \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0ddc \u0d85\u0db4\u0dd2 \u0dbb\u0da2 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0d92\u0d9a\u0da7 \u0d85\u0dc0 \u0dba \u0dad\u0db4\u0dd2\u0db4\u0db8 \u0dc3\u0dc4\u0ddc \u0dc3\u0dc4 \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0dbd\u0db6\u0ddc \u0dc1\u0daf\u0db1\u0dca\u0dad\u0db1\u0da7 \u0db6\u0dbd\u0ddc\u0dc1\u0db4\u0ddc\u0dc1\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc"
