    "chunk_text": "\u0b95\u0b9f\u0ba8\u0bcd\u0ba4 \u0b9a\u0ba9\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0ba4\u0bcd \u0bae\u0ba4\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0b9a\u0bcd\u0b9a\u0bbe\u0bb0 \u0bae\u0bae\u0b95\u0b9f\u0b95\u0bb3\u0bbf\u0bb2\u0bcd\u0b95\u0bc2\u0b9f, \u0bae\u0ba4\u0b9a\u0bbf\u0baf \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0b95\u0bcd\u0ba4\u0bbf \u0b86\u0b9f\u0bcd\u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bb0\u0bc1\u0bae\u0bbe\u0b95\u0bb5\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0b9f\u0bc1 \u0b87\u0bb0\u0ba4\u0bcd\u0ba4 \u0b86\u0bb1\u0bbe\u0b95 \u0bae\u0bbe\u0bb1\u0bc1\u0ba4\u0bae\u0ba9\u0b9a\u0bcd \u0ba4\u0b9a\u0bbe\u0ba9\u0bcd\u0ba9\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bc2\u0ba9\u0bcd\u0bb1\u0bc1 \u0bae\u0ba4\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0b95\u0bb3\u0b9a\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1, \u0b85\u0ba8\u0bcd\u0ba4 \u0bae\u0bc2\u0ba9\u0bcd\u0bb1\u0bc1 \u0bae\u0ba4\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0ba4\u0bb5\u0bb1\u0bcd\u0bb1\u0bbf\u0baf\u0b95\u0b9f\u0ba8\u0bcd\u0ba4\u0bc1 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bae\u0bb1\u0bbe\u0bae\u0bcd. \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0b9a\u0bc1\u0ba4\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd \u0bae\u0bc1\u0ba4\u0bb2\u0bcd \u0ba4\u0b9f\u0b95\u0bb5\u0baf\u0bbe\u0b95 \u0b8e\u0ba8\u0bcd\u0ba4\u0bb5\u0bbf\u0ba4\u0bae\u0bbe\u0ba9 \u0bb5\u0ba9\u0bcd\u0bae\u0bc1\u0b95\u0bb1\u0b9a\u0bcd \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0b87\u0bb2\u0bcd\u0bb2\u0bbe\u0bae\u0bb2\u0bcd \u0bae\u0ba4\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd \u0ba4\u0bb5\u0bb1\u0bcd\u0bb1\u0bbf\u0b95\u0baf\u0b95\u0bcd \u0ba4\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bbe\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b92\u0bb0\u0bc1 \u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0b95\u0bb2\u0bbe\u0b9a\u0bbe\u0bb0\u0ba4\u0bcd\u0b95\u0ba4 \u0bae\u0ba4\u0b9a\u0bbf\u0baf \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0b95\u0bcd\u0ba4\u0bbf \u0b89\u0bb0\u0bc1\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bbf \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1.\n\n\u0db8\u0dd6\u0dbd\u0dcf \u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0db8\u0db8 \u0dc1\u0db8\u0dad\u0dd0\u0db1\u0daf\u0dd3 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dc1\u0dba\u0db1\u0dca \u0db8\u0dad\u0d9a\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0db4\u0daf\u0dbb\u0d9c\u0dd2\u0dba \u0daf\u0dc0 \u0dca\u0dc0\u0dbd \u0d91\u0d9a\u0dca\u0dad\u0dbb\u0dcf \u0dca\u0dc0\u0dcf\u0dd3\u0dc0\u0db1\u0dca \u0dc0\u0dc4\u0db1\u0dca\u0dc1 \u0dda \u0db1\u0db8\u0d9a\u0dca \u0db8\u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0db7\u0dd6\u0dad \u0dc1\u0da0\u0ddd\u0daf\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0db1\u0d9c\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf; \u0db4\u0da7\u0dca\u0da7\u0db4\u0dbd\u0dca \u0dc1\u0db6\u0ddc\u0dbb\u0dd4\u0dc0\u0d9a\u0dca \u0db8\u0dcf\u0da2\u0dba\u0da7 \u0d9a\u0dd2\u0dba\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf. \u0d85\u0db4\u0dd2 \u0dcf\u0db8\u0dcf\u0db1\u0dba\u0dc1\u0dba\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dc1\u0daf\u0dba\u0d9a\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d91\u0d9a\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0dc0\u0dcf\u0daf\u0dd3 \u0d9a\u0db3\u0dbb\u0dd4\u0dbb\u0d9a\u0dca \u0dad\u0dc0\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0dc0\u0dcf\u0daf\u0dd3 \u0d9a\u0db3\u0dbb\u0dd4\u0dbb\u0d9a\u0dca \u0dc1\u0db4\u0ddd\u0dc2\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a.\n\n\u0db8\u0dd6\u0dbd\u0dcf \u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d92 \u0dc1\u0da0\u0ddd\u0daf\u0db1\u0dcf\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0d91\u0d9a\u0dd2\u0db1\u0dca \u0d91\u0d9a\u0da7 \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dbd\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u0db8\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0db4\u0dc5\u0db8\u0dd4\u0dc1\u0dc0\u0db1\u0dd2 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf\u0dc0, \u0dad\u0dd2\u0dc4\u0dcf\u0dbb\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dc1\u0dda \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d91\u0d9a\u0dca\u0dad\u0dbb\u0dcf \u0d85\u0dd9\u0dba\u0dcf\u0db4\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a \u0db7\u0dcf\u0dbb\u0d9a\u0dbb\u0dd4\u0dc0\u0d9a\u0dd4 \u0dc1\u0dbd \u0db8\u0db8 \u0d85\u0daf\u0da7\u0dad\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0dc1\u0da0\u0ddd\u0daf\u0db1\u0dcf\u0dc0. \u0dd3\u0dc0\u0da7 \u0d85\u0dbb\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 10\u0d9a\u0da7 \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0db8\u0db8 \u0dad\u0dd2\u0dc4\u0dcf\u0dbb\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dba\u0da7 \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2\u0dba\u0da7 \u0d91\u0db1\u0dca\u0db1 \u0dc1\u0db4\u0dbb \u0dc3\u0dd2\u0da7\u0db8 \u0d91\u0db8 \u0d86\u0dba\u0dad\u0db1\u0dba \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0dba\u0dd2 \u0db8\u0dcf \u0dc4\u0dd2\u0dad\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d91\u0db8 \u0d86\u0dba\u0dad\u0db1\u0dc1\u0dda \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0d85\u0dd9\u0dba\u0d9a\u0dca\u0dc2\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc1\u0dc4\u0ddd \u0d91\u0dc4\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0d85\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d85\u0daf \u0dc0\u0db1\u0d9a\u0dbd\u0dca \u0db8\u0dcf \u0daf\u0dd0\u0db1\u0dd4\u0dc0\u0dad\u0dca\u0dc0 \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1\u0dc0\u0dcf, \u0d8b\u0db1\u0dca\u0dc0\u0dc4\u0db1\u0dca\u0dc1 \u0dda\u0da7 \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dbd\u0db6\u0dcf \u0dc1\u0daf\u0db1 \u0d85\u0dba \u0dbd\u0db6\u0dcf \u0dc1\u0daf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc0\u0dd0\u0dbb\u0dd0\u0daf\u0dd2 \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc0\u0dd0\u0dbb\u0dd0\u0daf\u0dd2 \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dc4\u0dbb\u0dc4\u0dcf \u0db4\u0da7\u0dca\u0da7\u0db4\u0dbd\u0dca \u0dc1\u0db6\u0ddc\u0dbb\u0dd4 \u0db8\u0dcf\u0da2\u0d9c\u0dad \u0d9a\u0dbb\u0dbd\u0dcf \u0d92 \u0dc4\u0dbb\u0dc4\u0dcf \u0d95\u0db1\u0dd1\u0db8 \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dd4\u0da7 \u0d95\u0db1\u0dd1\u0db8 \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dd4 \u0db1\u0dd0\u0dc0\u0dad \u0db1\u0dd0\u0dc0\u0dad\u0dad\u0dca \u0dad\u0dd4\u0dc0\u0dcf\u0dbd \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0daf\u0dca\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dca \u0daf\u0dbb\u0dc0\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0daf\u0dca\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0dc4\u0ddc\u0db3 \u0dc4\u0dd8\u0daf\u0dba \u0dcf\u0d9a\u0dca\u0dc2\u0dd2\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1, \u0dc1\u0dc4\u0ddc\u0db3 \u0dc4\u0daf\u0dc0\u0dad\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1, \u0dbb\u0da7\u0da7 \u0d86\u0daf\u0dbb\u0dba \u0d9a\u0dbb\u0db1, \u0da2\u0db1 \u0db8\u0dcf\u0da2\u0dba\u0da7 \u0d86\u0daf\u0dbb\u0dba \u0d9a\u0dbb\u0db1 \u0d85\u0dba\u0da7 \u0db4\u0db8\u0dab\u0dba\u0dd2. \u0dc1\u0dda \u0dbb\u0da7 \u0d85\u0dbb\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 30\u0d9a\u0dca \u0dad\u0dd2 \u0dca\u0dc1 \u0dda \u0dc1\u0dbd\u0dca \u0dc0\u0dd2\u0dbd\u0d9a\u0dca \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf. \u0d92\u0dc1\u0d9a\u0db1\u0dca \u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0daf\u0dd4\u0d9a\u0dca \u0dc0\u0dd2\u0db1\u0dca\u0daf\u0dcf; \u0db4\u0dd3\u0da9\u0dcf \u0dc0\u0dd2\u0db1\u0dca\u0daf\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dad\u0dc0 \u0dad\u0dc0\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0dc0\u0dcf\u0daf\u0dba \u0db8\u0dad\u0dca\u0dc1\u0dad\u0db1\u0dca\u0db8 \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db3\u0dc4\u0dcf \u0dc1\u0d9a\u0ddc\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dcf\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0db4\u0dd2\u0dbb\u0dd2 \u0da7 \u0db1\u0dda \u0d95\u0db1\u0dd1 \u0dad\u0dbb\u0dda \u0dad\u0dd4\u0dc0\u0dcf\u0dbd \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dc5 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dd2. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dad\u0dd4\u0dc0\u0dcf\u0dbd \u0daf\u0dbb\u0dc0\u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0dc4\u0dd0\u0d9a\u0dca\u0dc1\u0d9a\u0dca \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7 \u0db8\u0dd2\u0db1\u0dd2 \u0dca\u0daf\u0dbb\u0db1\u0dca\u0da7\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1 \u0db4\u0dab\u0dd2\u0dbb\u0dd4\u0da9\u0dba \u0db8\u0dcf \u0dbd\u0db6\u0dcf \u0dc1\u0daf\u0db1\u0dca\u0db1 \u0d9a\u0dd0\u0db8\u0dad\u0dd2\u0dba\u0dd2."
