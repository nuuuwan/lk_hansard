\u0dc1[\u0dc1\u0db8\u0dd4 \u0d9a\u0dbb\u0d9a\u0dc1, \u0dc1\u0db4\u0dad \u0daf\u0dd4\u0dc1 \u0dda\u0dc2 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1[ \u0d89\u0daf\u0dd2\u0db4\u0dad\u0db4 \u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9c\u0dd0\u0db1 \u0db8\u0db8 \u0d91\u0dad\u0dd4\u0db8\u0dc1\u0da7 \u0dc3\u0dda\u0dad\u0dd4\u0dad\u0dd2 \u0db0\u0dba\u0dad \u0dc1 \u0db1 \u0dc1. \u0d9c\u0dd4\u0dc0 \u0daf\u0dd4\u0db4\u0d9a\u0dca\u0dc2 \u0db1\u0dc1[\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d92 \u0db1\u0dd2\u0dc3\u0dc1 \u0db8\u0da7 \u0d85 \u0dc3\u0dda\u0dae\u0dc1 \u0d9a\u0dca \u0d9a\u0dd0\u0db6\u0dd3 \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1, \u0dc1\u0db4\u0dad \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1 \u0d9a\u0da7 \u0d85\u0daf\u0dc1\u0dc5 \u0dc0 \u0dad\u0dd4\u0db8\u0dc1\u0da7 \u0dc1\u0dc1\u0dda\u0db8 \u0db4\u0dc1\u0dba\u0db7\u0db6\u0dbd\u0dc1\u0db4\u0dad\u0db0\u0dba\u0dad\u0dd4 \u0da7 \u0d9a \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0db6\u0dbd \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dca \u0d9a\u0dbb\u0db0\u0dba\u0db1. \u0d9c\u0dd4\u0dc0 \u0d9a\u0dae\u0dc1\u0db1\u0dc1[\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d9c\u0dd4\u0dc0 \u0daf\u0dd4\u0db4\u0d9a\u0dca\u0dc2 \u0db1\u0dc1[\u0d9a\u0dad\u0dd4\u0db8\u0dc1 \u0d87\u0dd6 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1 \u0d9a\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dd4\u0dc0 \u0dc1\u0db8\u0dc1\u0dc3\u0dda\u0dd2 .\n\n1. \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad \u0dc1\u0d9a\u0dc1 2\u0d9a\u0dd2. \u0d92, \u0db4\u0dd0\u0dbd\u0dca \u0d9a\u0dad \u0d92\u0d9a\u0d9a[ \u0dc4\u0dc1 \u0dc1\u0dc3 \u0db1\u0d9c\u0d9a \u0d92\u0d9a\u0d9a[\u0dd2 . \u0d8a\u0da7 \u0d85\u0db8\u0dad\u0dbb \u0d87\u0dad\u0dd2\u0db8\u0dc1\u0dbd\u0dca \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0db6\u0dbd\u0d9a \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad \u0dc1\u0d9a\u0dc1 \u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1. \u0d9c\u0dbd\u0dca\u0dc0[ \u0dbb\u0da2[\u0da7 \u0dc3\u0dd2[[\u0da7 16\u0d9a \u0dc3\u0dc4 \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0db6\u0dbd\u0d9a \u0d85\u0dcf [\u0da7 \u0dc3\u0dd2[[\u0da7 4 \u0d9a \u0