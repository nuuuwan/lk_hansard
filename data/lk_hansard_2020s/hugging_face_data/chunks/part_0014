    "chunk_text": "\u0d92 \u0dc0\u0dc0\u0dc1\u0dda\u0dca \u0dca\u0dca \u0dc1\u0db4\u0dad \u0dc0\u0dba\u0da7 \u0d9a \u0dca\u0dad \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d85\u0dc0 \u0dba\u0db1\u0dca6 \u0dc1\u0dca\u0d9c\u0dd2 \u0da2 \u0d9a\u0dc1\u0dda\u0d9c \u0dc1\u0dc4 \u0dc1 \u0dc0\u0dc5\u0db9 \u0dca\u0dc4 \u0d9c\u0dba \u0dc1\u0db7\u0dc0\u0dc0 \u0dc1\u0db4\u0dad \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb) \u0dc1\u0db4\u0dad \u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0daf\u0dba \u0d9c \u0d9a\u0dad\u0dc0\u0dca, \u0dc1\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dc0 \u0db4\u0dc5\u0dc0 \u0d9a \u0db4\u0dc0\u0d9a \u0dca\u0dd0\u0dd2\u0dc0\u0dba\u0da7 \u0da7 \u0dc1\u0db4\u0dba \u0db4\u0dca\u200d\u0dbb \u0dc0 \u0dc1\u0dc5\u0dda \u0dc1\u0dca\u0dc0 \u0daf? \u0dc1\u0d85 \u0d9a\u0daf\u0dd0\u0d9a\u0dd3\u0db4\u0dad \u0dd2\u0dc1 \u0dc0\u0dd0\u0daf\u0d9c \u0d9a \u0dc0\u0dc0\u0daf\u0dba\u0dc0\u0dba\u0dc1 \u0dad\u0dca\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0d9c\u0dba\u0dc0\u0db0\u0dd2\u0db4\u0dd2 \u0dc4\u0dd0\u0da7\u0dd2 \u0da7 \u0db4 \u0d9a \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb6 \u0dc1\u0daf\u0dc0\u0dc1\u0dda\u0dad\u0dba \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc1\u0dda \u0dc4\u0db1\u0dd3\u0dc6\u0dc0 \u0d9a\u0dd2 \u0dc0\u0dc0\u0daf\u0dba\u0dc0\u0dba \u0dc0 \u0dad\u0dca\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0d91\u0dca \u0dad \u0dad\u0dd4\u0db8\u0dcf\u0dba\u0da7 \u0db4 \u0d9a \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1 \u0d9a\u0dd2 \u0d9a\u0dc0\u0db1\u0dca6 \u0dca\u0dc0 \u0db4\u0dad \u0daf\u0dd4\u0db0\u0dd2 \u0da7, \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0dca\u0dc0 \u0dad\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dc1 \u0dc0\u0da7\u0dca\u0db0\u0dc0\u0dc1 \u0d9a \u0db4\u0dd0\u0dba\u0dbd\u0dd2\u0da7\u0dc0, \u0db4\u0dc5\u0dc0 \u0d9a \u0db4\u0dc0\u0d9a \u0dca\u0dd0\u0dd2\u0dc0\u0dba\u0da7\u0dc1\u0dda\u0daf\u0dd36\n\n\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dba \u0dc0\u0dba \u0dc1\u0db7\u0dc0\u0db4\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0dd2 \u0db1\u0dd2, \u0d91\u0dc1\u0dc4\u0dca \u0d9a\u0dd2\u0db1\u0dca\u0dbd\u0dd2 \u0dc1\u0dc4\u0dc1 \u0ddd\u0d9c \u0d85\u0dc1\u0dda \u0d9a\u0dd2\u0db1\u0dca\u0dbd\u0dd2 \u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dba\u0dc1 \u0dc1\u0dc4\u0ddd \u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd2 \u0d9a \u0dc0 \u0dc1\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd0\u0dc4\u0dd0, \u0dc1\u0dca\u0d9c\u0dd2 \u0da2 \u0d9a\u0dc1\u0dda\u0d9c\u0dc1\u0dda \u0d85\u0dc1\u0dda \u0dc2\u0dca\u0da8 \u0dc0 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb6 \u0d92 \u0da2\u0dd4\u0db1\u0dd2 10\u0dc0 \u0daf\u0dc0 \u0da1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0daf \u0db4\u0dd0\u0dc0\u0dd0 \u0d9a\u0dc0\u0dd6\u0dc0\u0dc0\u0dca \u0dc1 \u0dc0\u0dc1\u0dc4\u0dc0\u0dca \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0db6\u0dbd\u0dc0 \u0db8\u0dd4\u0da2\u0dd2\u0db6\u0dd4\u0dbb\u0dca \u0dba\u0dc4\u0dd4\u0dca\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf\u0dca\u0dc0\u0da7 \u0d9a \u0d9a\u0dc0 \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0dc0\u0db1\u0dca6 \u0d85\u0db4\u0dd2 \u0d9a\u0dc0\u0dc1\u0db4\u0dc0\u0dc1\u0dba\u0dc0 \u0d9a\u0dad\u0dd4\u0db8\u0dcf \u0dc1\u0dc0 \u0dc0\u0dc0, \u0d92 \u0dc0 \u0dc1 \u0dc0\u0da7 \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0dca\u0dc0 \u0dad\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb \u0dc0 \u0db1\u0dd2\u0dc0\u0dd0\u0dd0\u0daf\u0daf\u0dd2 \u0dba \u0d9c\u0db1\u0dd2\u0db1\u0dca \u0d9a\u0dd2 \u0d9a\u0dc0, \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dc0\u0dc1\u0dda \u0d85\u0dba \u0dc4\u0dc5\u0dd4 \u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf\u0dca\u0dc0 \u0dc5\u0dc0 \u0dc0\u0dc0\u0dc1\u0dda6\n\n\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dba \u0dc0\u0dba \u0dc1\u0db7\u0dc0\u0db4\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0dd2 \u0db1\u0dd2, \u0d85\u0daf \u0daf\u0dd4\u0dc0\u0dc0\u0daf \u0da7 \u0db7\u0dc0\u0da2 \u0dc0 \u0da2\u0dc0\u0dd2 \u0d9c\u0dca \u0dc0\u0d9c\u0dca \u0dc1 \u0dc0\u0db8\u0dd2\u0dc2\u0dca\u0da8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0db7\u0dc0 (\u0dc1\u0dcf\u0dc1 \u0ddd) \u0db4 \u0db4 \u0d9a \u0dc1 \u0db8\u0dca\u0db4\u0dad\u0db4\u0dad \u0d9c \u0d9a\u0dc1\u0dad\u0dc0 \u0d9a, \u0dc1\u0db4\u0dad \u0dd2\u0dad\u0dc0\u0dca \u0dc0\u0dd0\u0daf\u0d9c \u0d9a \u0db4 \u0d9a \u0dc1 \u0db8\u0dca\u0db4\u0dad\u0db4\u0dad 6 \u0d9c\u0dbb\u0dd4 \u0db6\u0dd2\u0dca\u0dda \u0dba \u0d9a \u0dc0 \u0d87\u0dca\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dca\u0dc0 \u0d8b\u0dc1\u0dda \u0dc0\u0dbb\u0dd4\u0dc1\u0dda \u0dc1 \u0dc0\u0dc1\u0dc4\u0dc0\u0dca \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0db6\u0dbd\u0dc0 \u0db4\u0dca\u200d\u0dbb \u0dc0 \u0dc5\u0dc0, \u0d9a \u0d85\u0dc1\u0dda \u0dba\u0dc1\u0da7\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc0\u0dc4 \u0d9a\u0dd2 \u0d91 ,"
