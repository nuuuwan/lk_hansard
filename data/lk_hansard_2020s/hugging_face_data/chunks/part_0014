    "chunk_text": "\u0dca\u0dca \u0db1\u0dca\u0dcf\u0dc4\u0dc1\u0d9a\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dd2\u0dda\u0dc1\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0dca \u0db7\u0dc0\u0dba \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0dc0 \u0d9a\u0dd2 \u0d9a\u0dc06 \u0db1\u0dca\u0dcf\u0dc4\u0d9a \u0dc1 \u0d9a\u0dc1\u0dba \u0dc0\u0dc0 \u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb6 \u0d92\u0dc0\u0dc0 \u0daf\u0dd0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dd2\u0dda\u0dc0\u0dc0 \u0d9a\u0dd2 \u0d9a\u0dc0, \u0dca\u0dca \u0db4\u0dc0\u0dbb\u0dca\u0db6\u0dbd\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dd4\u0db8\u0dcf \u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0dc1\u0dca\u0db1\u0dd4 \u0d9a \u0d85\u0db1\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dd2 \u0d9a\u0dc0 \u0d94 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd4\u0dc0 \u0daf\u0dc0\u0d9a\u0dc0 \u0dd2\u0dc1 \u0dc0\u0dc06 \u0dca\u0dca \u0dc1\u0db4\u0dad \u0d9a\u0dd2\u0dda\u0dc0\u0dc0 \u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb6 \u0dbd\u0dd2\u0db1\u0dd2 20\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dc0 \u0dca\u0dc1\u0dda \u0dd4\u0dc0 \u0dd2\u0dc1 \u0dc0\u0dc06 \u0dca\u0dca \u0dad\u0dc0 \u0d91 \u0d9a\u0dd2 \u0d9a\u0dc0 \u0dc1\u0db4\u0dad \u0db4\u0dc0\u0dbb\u0dca\u0db6\u0dbd\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd2\u0dc0 \u0d9a \u0dc1\u0dc0\u0d9a\u0dc0 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dad6 \u0d92 \u0d85\u0dc4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb 6 \u0dc1\u0dd0\u0dda\u0dad\u0dd0\u0db4\u0dad \u0dbb\u0dca \u0dca\u0dc0\u0dc1\u0dc1\u0dda 20\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dc0 Ministry \u0d91\u0dc1 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dca\u0dc0\u0dc0 \u0d85\u0db1\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dba\u0d9a\u0dc0 \u0db6\u0dbd\u0dba\u0dd4\u0dca \u0d9c\u0dc4\u0d9a\u0dc0 \u0dd2\u0db6\u0dd4\u0da7\u0dc0 \u0db4\u0dc0\u0db6\u0dbd\u0dad \u0dca\u0dc4\u0dd3\u0db4\u0dc0\u0d9a \u0d9a\u0dd2 \u0db6\u0dbd\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0da7\u0db4\u0dd4 \u0dc1\u0dda \u0db4\u0dad\u0dad\u0dd4\u0db8\u0dcf\u0dca\u0dc06 \u0dc4\u0dd0 \u0dd0\u0db1\u0dca, \u0d8a\u0da7\u0db4\u0dc1\u0dda\u0dc1\u0dc1\u0dda \u0dc1\u0db4\u0dad NPP \u0d91 \u0dca \u0d9c\u0dd2 \u0db4\u0dda\u0d9a\u0dc0 \u0dd4\u0dc0 \u0daf\u0dd0\u0db4\u0dad\u0dca\u0dc0 \u0dca\u0dca doctor \u0dc1\u0dc0\u0d9a\u0dc0 \u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1 \u0dc0\u0da7 nomination \u0dbd\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0 \u0d9a\u0dd2 \u0d9a\u0dc06 \u0d92 \u0dd4\u0dc0 \u0daf\u0dd0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb Court of Appeal \u0db4 \u0dc0\u0dc06 \u0daf\u0dd0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dca\u0dca \u0dc1\u0db4\u0dad\n\n2137 2138\n\n\u0db4\u0dc0\u0dbb\u0dca\u0db6\u0dbd\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dd4\u0db8\u0dcf\u0dc0\n\n\u0dca\u0dca \u0dc0\u0daf\u0dc0\u0dc0 \u0d9a \u0dc1\u0db4\u0dad \u0dba\u0dc1\u0da7\u0dca politics \u0dba\u0d9a\u0dc0 \u0dd0\u0dc4\u0dd06 \u0dca\u0dca \u0dc1\u0db4\u0dad \u0dba\u0dc1\u0da7\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dbd\u0dd2 39 vote \u0dba\u0d9a\u0dc0 \u0dd0\u0dc4\u0dd06 \u0dca\u0da7 \u0daf\u0dd4 \u0dda\u0dc0\u0dc0\u0dc1 \u0dd0\u0dd2\u0dc0 \u0d9c\u0dd2 \u0dc06 2009\u0daf\u0dd3 \u0d94 \u0dc1 \u0ddd\u0dca \u0dd2\u0dc0\u0dba \u0dc0\u0dd4\u0da7\u0dc0\u0da7 \u0db4\u0dc1\u0dda\u0dc1\u0dc1\u0dda \u0dca\u0dc1\u0dda \u0dad\u0dc0 \u0d9a\u0dad\u0dc0 \u0d91 \u0dc1\u0d9c \u0d9c\u0dd2 \u0db4\u0dda\u0d9a\u0dc0 \u0dd1\u0db6\u0dbd \u0dd1\u0db6\u0dbd \u0dd0\u0db4\u0dd4\u0dc0\u0dc0\u0da7 \u0db4\u0dc1\u0dda\u0dc1\u0dc1\u0dda \u0dca\u0dca hospital \u0d91 \u0da7 \u0d9c\u0dd2 \u0db4\u0dda\u0d9a\u0dc0 \u0dca\u0dc1\u0dda \u0dad\u0dc0 \u0d9a\u0dad\u0dc0\u0dc1\u0dda BHT \u0d91 \u0d85\u0dba\u0dc1\u0d9c \u0dd0 \u0daf\u0dc0\u0dc06 \u0dca\u0dca doctor \u0dc1 \u0dc1 6 \u0dca\u0dca \u0d9c\u0dd2 \u0db4\u0dda\u0d9a\u0dc0 \u0dca\u0dc1\u0dda \u0dad\u0dc0 \u0d9a\u0dad\u0dc0\u0dc1\u0dda BHT \u0d91 \u0d85\u0dba\u0dc1\u0d9c \u0dd0 \u0daf\u0dc0\u0dc06 \u0dad\u0dc0 \u0d9a\u0dad\u0dc0\u0dc1\u0dda \u0da9 \u0dad\u0dd4\u0db8\u0dcf\u0dc0\u0dc0\u0d9a \u0dc1\u0dc0\u0d9a\u0dc0 \u0dd2\u0dc1 \u0dc0\u0dc0, \u0d8a\u0da7 \u0db4\u0dc1\u0dda\u0dc1\u0dc1\u0dda BHT \u0d91\u0dc1 \u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0daf \u0dd0\u0dc4\u0dd06 \u0d91\u0dad\u0dc1 \u0dc0\u0da7 \u0dad\u0dc0 \u0d9a\u0dad\u0dc0\u0dc1\u0dda \u0da9 \u0dad\u0dd4\u0db8\u0dcf\u0dc0\u0dc0\u0d9a \u0dc1\u0dc0\u0d9a\u0dc0 \u0dd2\u0dc1 \u0dc0\u0dc0, \u0da7 \u0d9a amputate \u0dba\u0d9a\u0dc0 \u0dd2\u0dc1 \u0dc0\u0dc0; \u0dca\u0dc1\u0dda \u0dad\u0dc0 \u0d9a\u0dad\u0dc0 \u0dd0\u0dc4\u0dd06 \u0d91\u0dad\u0dc1 \u0dc0\u0da7 \u0dca\u0dc1\u0dda \u0db4\u0db4\u0dd4\u0dc0 \u0dc1 \u0dc0\u0da0\u0dca \u0dba \u0dbb\u0dd2\u0dc1\u0daf \u0dc0\u0dc0\u0daf \u0d9a\u0dd2 \u0d9a\u0dc0 \u0db4\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1 \u0ddd6 \u0d92 \u0db1\u0dd2\u0dc1\u0dc0 \u0dad\u0dca\u0db1\u0dca \u0dc1\u0db4\u0dad \u0db4\u0dc0\u0dbb\u0dca\u0db6\u0dbd\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dd4\u0db8\u0dcf\u0dc0\u0da7 \u0d87\u0daf\u0dd4\u0dda\u0d9a\u0dc0 \u0d85\u0db4\u0dd2 \u0dc1\u0db4\u0dad\u0dc0\u0dc0 \u0d9a\u0dd2 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb6\n\n\u0dc1\u0db4\u0dad \u0db1\u0dca \u0dc1\u0dc0\u0d9a\u0dc0 \u0dd2\u0dc1 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb6 \u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dc0\u0dc1\u0dda \u0da2 \u0dc0\u0db0\u0dd2\u0db4\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dca\u0dc0 \u0dc0\u0dc0, \u0da2\u0dbb\u0dca\u0dca\u0db1\u0dd2 \u0da76 \u0d95 \u0dd1 \u0db4\u0dad \u0db4\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd6\u0db1\u0dba \u0db4\u0dc0\u0dc0 \u0dc1\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dca\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb6 \u0dca\u0da7 \u0dd4\u0dc0 \u0daf\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb 6 \u0dca\u0da7 \u0dc1\u0dda\u0dc1\u0db4\u0dc2\u0dca\u0da8\u0dda \u0dc1\u0dca\u0dc0\u0da7 \u0d9a \u0d91\u0db4\u0dc0, \u0dd4\u0dc0 \u0daf\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb 6 \u0dca\u0dca \u0dd4\u0dc1\u0dda\u0daf\u0dd3 \u0dc1\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dad6 \u0dc1 \u0dc0\u0da7\u0dd2 \u0d91 , \u0da2\u0dbb\u0dca\u0dca\u0db1\u0dd2\u0dc1\u0dda \u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0da9 \u0dc1\u0dda\u0dc1\u0db4\u0ddd\u0dba\u0dc0\u0dc1\u0dda \u0dc1\u0d9a\u0dc0 \u0dc0 \u0dca\u0da7 \u0d9a\u0dd2\u0dda\u0dc0\u0dc0, \u201c\u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dc0\u0dc1\u0dda"
