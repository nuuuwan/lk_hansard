\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4 \u0db0\u0dc0 ]979 \u0d85\u0dd2\u0d82\u0d9a 48 :\u0dbb\u0db1 \u0dad\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0dad\u0dc0\u0dcf:\u0dba \u0dc0\u0dd0\u0dc5\u0dd0\u0d9a\u0dca\u0dc0\u0dd3\u0dc1\u0dca\u0db4 (\u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0dbd\u0dd2\u0d9a \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1 \u0db4\u0db1\u0dc1\u0dad\u0dca 27 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0dc4\u0dcf 20]].08.29 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0dd2\u0d82\u0d9a ]72]/2 :\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2 03 (\u0d87 \u0dc3\u0dc4 03() \u0dba\u0da7\u0dc1\u0dad\u0dca \u0d85\u0dad\u0dca\u0d85\u0da9\u0dd2\u0d82\u0d9c\u0dd4\u0dc0\u0da7 \u0dc1\u0d9c\u0db1 \u0d9c\u0dbb\u0dd4 \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dc1\u0dbd\u0dc3\u0da7 \u0db1\u0dd0 \u0dc1\u0dd9\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dc1\u0dad\u0dca \u0dc3\u0dba\u0dbd\u0dd4\u0db8 \u0dc1\u0db4\u0ddc\u0dbd\u0dd2\u0dc3\u0dcf \u0dc3\u0dcf\u0dae\u0dcf\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca :\u0dd0\u0db1\u0dd4\u0dc0\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3.\n\n(vii) \u0dad\u0dc4\u0db1\u0dca\u0db4 \u0dc3\u0dd2\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba\u0d9a \u0db1\u0dd3\u0dad\u0dd2\u0dc0\u0dd2\u0dc1\u0dbb\u0ddd\u0db0\u0dd3 \u0dc3\u0dd0\u0db8\u0dbb\u0dd4\u0dca\u0db4 \u0dda\u0dad\u0dca\u0dc3\u0dc0\n\n\u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0dc3\u0dca\u0db4\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dd2\u0d82\u0d9a\u0dcf \u0dc1\u0db4\u0ddc\u0dbd\u0dd3\u0dc3\u0dba \u0dc0\u0dd2\u0dc3\u0db1\u0dca \u0dc0\u0dd2\u0db8\u0dbb\u0dca \u0db1 \u0dc3\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0d85\u0db1\u0dcf\u0dc0\u0dbb\u0dab\u0dba \u0dc0\u0db1 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0db8\u0dad \u0dc0\u0db1\u0dad\u0dd2\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0dba\u0dd2.\n\n(\u0d86 \u0db4\u0dd0\u0db1 \u0dc1\u0db1\u0ddc\u0db1\u0d9f\u0dd3.\n\n\u0dd9\u0dd4 \u0dbb\u0dd3\u0db8 \u0d9a\u0dd4\u0dab\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dc3\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bb0\u0bb5\u0bbf \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95) (The Hon. Ravi Karunanayake) Sir, I rise to a point of Order. \u0dd9\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0baa\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Speaker) \u0d9c\u0dbb\u0dd4 \u0dbb\u0dc0\u0dd2 \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf \u0dc1\u0db8\u0ddc\u0d9a\u0d9a\u0dca: point of Order \u0d91\u0d9a?\n\n\u0dd9\u0dd4 \u0dbb\u0dd3\u0db8 \u0d9a\u0dd4\u0dab\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dc3\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bb0\u0bb5\u0bbf \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95) (The Hon. Ravi Karunanayake) \u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dc1\u0db8\u0dc1\u0dad\u0d9a\u0dca \u0d9a\u0dbd\u0dca \u0dc3\u0dca\u0db4\u0db4\u0dca\u200d\u0dbb:\u0dcf\u0dba \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0da9\u0dd4 -\n\n\u0dd9\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0baa\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Speaker) \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0db1\u0dba \u0dc3\u0dca\u0db4\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0dc0\u0dd6 \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0d9c\u0dd0\u0db1: \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca?"
