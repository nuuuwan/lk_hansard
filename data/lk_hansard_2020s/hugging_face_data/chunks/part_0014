    "chunk_text": "\u0dd6\u0dbd\u0da7\u0dcf\u0dc3\u0db1\u0dcf\u0dd6\u0da9\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dba, \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0dba\u0dc0\u0dbb\u0dab\u0dc1\u0dda\u0daf\u0dd3 \u0dc0\u0dbd\u0dd2\u0db8\u0dad\u0db8\u0dcf\u0db1 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0dba\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0d9c\u0dab\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0db8\u0dad\u0dd4 \u0d9a\u0dc0\u0dcf. \u0dc0\u0dd2\u0dc1 \u0db1\u0dc2\u0dc1 \u0db1\u0dca\u0db8 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2 \u0dc4\u0dca\u0dd4\u0dc0 \u0d9a\u0dcf\u0da7\u0dc1\u0dda \u0db4\u0dcf\u0dbb\u0dc0\u0dbd\u0dca \u0daf\u0dd2\u0dc1 \u0dc1\u0dc0\u0dd2 \u0dad \u0db1\u0dc0\u0dcf, \u0dc1\u0d9c\u0dc0\u0dbd\u0dca\u0dc0\u0da7\u0da7 \u0db4\u0dd0\u0db1\u0da7\u0dcf \u0dc1\u0dc0\u0dd2 \u0dad \u0db1\u0dc0\u0dcf, \u0dc3\u0db1\u0dc0\u0da7\u0da7 \u0db4\u0dd0\u0db1\u0da7\u0dcf \u0dc1\u0dc0\u0dd2 \u0dad \u0db1\u0dc0\u0dcf, \u0dc1\u0db8\u0dc1\u0dc4\u0db8 \u0dbb\u0da7\u0dc0\u0dbd\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dcf, \u0d92 \u0dd2\u0dba\u0dc3\u0dcf \u0da2\u0dcf\u0dd2\u0dba\u0d9a \u0da2\u0db1 \u0da7\u0dc1\u0dda\u0d9c \u0dc4\u0dca\u0dd4\u0dc0\u0d9a\u0dca \u0da7\u0dc1\u0dad\u0dca\u0dc4 \u0db1\u0dd3\u0dd2\u0dba\u0dc1\u0dda \u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dc1\u0dda \u0dc4\u0db0\u0dd2\u0db4\u0dad\u0dba \u0dc3\u0db1 \u0dcf\u0db4\u0dd2\u0dad \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dd2\u0dad, \u0d85\u0db4\u0dd2 \u0dc4\u0dd0\u0dda\u0db4\u0dd2\u0da7\u0dcf \u0da7\u0db8\u0dd4 \u0d9a\u0dd2 \u0da7\u0dcf\u0dad\u0dca\u0dc4 \u0db8\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf.\n\n\u0db8\u0db8 \u0d92 \u0d9a\u0dcf\u0dbb\u0dab \u0dad\u0dca\u0dc4 \u0d9a\u0dd2 \u0da7\u0dcf \u0dc4\u0db1\u0dca\u0db1 . \u0db4\u0dc0\u0db8\u0dd4\u0dc0\u0dd0\u0dd2\u0dba \u0dc0\u0dad\u0dcf\u0dc0\u0da7 \u0dad\u0dd4\u0dc0\u0d9a\u0dca \u0dc0 \u0db4\u0dcf\u0dad\u0dcf\u0da7 \u0da7 \u0d9c\u0dd2\u0dc1\u0dda; \u0dc1\u0db1\u0dcf\u0dc1 \u0dbd\u0dca \u0d85\u0db8\u0dbb\u0dc3\u0dd2\u0d82\u0dc4\u0da7 \u0d9c\u0dd2\u0dc1\u0dda \u0da2\u0db1\u0dad\u0dcf \u0dc0\u0dd2\u0db8\u0dd4\u0d9a\u0dca\u0dd2\u0dba \u0dc1\u0db4\u0dbb\u0db8\u0dd4\u0dab \u0db4\u0dbd\u0dca\u0dc1\u0dbd\u0dca\u0d9a\u0dd0\u0dc1\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb \u0d9a\u0dc0\u0dcf\u0da7 \u0db4\u0dc3\u0dd4\u0dc0\u0dd2\u0dad. \u0dc1\u0db8\u0dcf\u0d9a\u0dcf, \u0db8\u0db8 \u0d92 \u0dc3\u0dd2\u0dd4\u0dc3 \u0db8 \u0db4\u0dd2\u0dc5\u0dd2 \u0db3\u0dc0 \u0dc1\u0dad\u0dcf\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1 \u0db1 \u0dc1\u0db4\u0dcf\u0dad \u0dc1\u0d9c\u0db1\u0dd0\u0dbd\u0dca\u0da7\u0dcf \u0dd2\u0dba\u0dc1 \u0db1\u0dc0\u0dcf. \u0d95\u0db1 \u0db1 \u0d92 \u0dc1\u0db4\u0dcf\u0dc1\u0dad\u0dca\u0dc4 \u0dd2\u0dba\u0dc1 \u0db1 \u0dc1\u0dda\u0dc0\u0dbd\u0dca \u0d9a\u0dd2 \u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0dc1\u0db1\u0dcf\u0dc1 \u0dbd\u0dca \u0d85\u0db8\u0dbb\u0dc3\u0dd2\u0d82\u0dc4\u0da7, \u0dc1\u0dc3\u0dcf\u0dad\u0dca\u0dc4\u0dd2\u0dba \u0d8b\u0db4\u0dcf\u0dda\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0dda\u0db0\u0dc0 \u0db4\u0dcf\u0dad\u0dcf\u0da7\u0dc1\u0dda \u0dc1\u0dcf\u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0dca \u0dc4\u0dd0\u0dda\u0dc1\u0db4\u0db1\u0dc1\u0d9a\u0dcf\u0da7 \u0dc1\u0db1\u0dcf\u0dc1 \u0dbd\u0dca \u0d85\u0db8\u0dbb\u0dc3\u0dd2\u0d82\u0dc4\u0da7 \u0db4\u0dc0\u0db8\u0dd4\u0dc0\u0dd0\u0dd2\u0dba \u0dad\u0dd4\u0dc0\u0d9a\u0dca \u0dc0 \u0dc1\u0dad\u0dcf\u0d9c \u0dc4\u0dc1\u0dda \u0db4\u0dbd\u0dca\u0dc1\u0dbd\u0dca\u0d9a\u0dd0\u0dc1\u0dbd\u0dca \u0d9a\u0db3\u0dbd\u0d9a\u0dbb\u0da7 \u0d9c\u0dc4\u0db4\u0dd4 \u0d85\u0dc0\u0dd2 \u0dc4\u0dba\u0dd4\u0db0\u0dc0\u0dda\u0db1\u0dca. \u0dc1 \u0db4\u0dcf\u0dad\u0dcf\u0da7 \u0dbb\u0dd0\u0d9a\u0dca\u0dc1\u0d9a\u0dca \u0dc4\u0dca\u0dd4\u0dcf, \u0db1\u0dd0\u0dda\u0dcf \u0d9a\u0dd2 \u0db1 \u0db8\u0d9a \u0db8\u0da7\u0dad\u0dca\u0dc4 \u0d85\u0dcf\u0dcf\u0dc0 \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0db8\u0dcf\u0d9a\u0dcf, \u0d85\u0db4\u0dd2 \u0db4\u0dcf\u0dad\u0dcf\u0da7 \u0dbb\u0dd0\u0d9a\u0da7\u0dcf\u0dad\u0dca\u0dc4 \u0db1\u0dd0\u0dc4\u0dd0; \u0db4\u0dcf\u0dad\u0dcf\u0da7 \u0dc4\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb\u0da7\u0dcf\u0dad\u0dca\u0dc4 \u0db1\u0dd0\u0dc4\u0dd0. \u0dc0\u0dd4\u0d9a\u0dcf\u0dbb\u0dc1 \u0ddd \u0dbb\u0dd0\u0d9a\u0da7\u0dcf\u0dad\u0dca\u0dc4 \u0db1\u0dd0\u0dc4\u0dd0; \u0dbb\u0d9a\u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dad\u0dca\u0dc4 \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0dd2\u0dba\u0dc3\u0dcf \u0dc1 \u0ddd\u0dcf\u0db1\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0da7 \u0dc0\u0da9\u0dcf \u0db8\u0db8 \u0dc0\u0dd2\u0dc1 \u0db1\u0dc2\u0dc1 \u0db1\u0dca\u0db8 \u0d9a\u0dd2 \u0db1\u0dca\u0db1 \u0d9a\u0dd0\u0db8\u0dd2\u0dba\u0dd2\u0dad, \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0d9a\u0dbb\u0da7\u0dcf \u0d85\u0db4\u0dd2 \u0d94\u0d9a\u0dca\u0dc1\u0d9a\u0dcf\u0db8 \u0db8\u0d9a\u0dad\u0dd4 \u0dc1\u0dc0\u0da7\u0dcf \u0dc1 \u0d9a\u0da7 \u0dc0\u0dd2\u0dc3\u0db3\u0dd4\u0db8\u0d9a\u0dca \u0da7 \u0dcf \u0dc1\u0dcf\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dc1\u0dda \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc0\u0d9a\u0dca \u0dc3\u0d9a\u0dc3\u0db1 \u0d9a\u0dbb\u0db8\u0dd4 \u0d9a\u0dd2 \u0da7\u0dcf. \u0dc4\u0dd0 \u0dd0\u0dd2\u0dad, \u0db8\u0dc1\u0dc4\u0db8 \u0dc1\u0dcf \u0d9a\u0dca \u0dc3\u0dd2\u0dda\u0db0 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0.\n\n\u0dc1\u0db8\u0da0\u0dca \u0dbb \u0d9a\u0dbd\u0dca \u0d85\u0db4\u0dd2 \u0dcf\u0dd0\u0d9a\u0db4\u0dd4 \u0d9a\u0dcf\u0dbb\u0dab \u0d9a\u0dca \u0dad\u0db8\u0dd2\u0dad, \u0dc1 \u0dc0\u0dcf\u0da7 \u0dc1\u0db4\u0dcf\u0dbd\u0dd3\u0db8\u0dc3\u0dd2\u0dc1\u0dda \u0dc3\u0dad\u0dd0 \u0d85 \u0dc3 \u0db1\u0dca\u0db0\u0dd2\u0dad \u0d9a\u0dd2 \u0db1 \u0db8\u0d9a. \u0dc1\u0db4\u0dcf\u0dbd\u0dd3\u0db8\u0dc3\u0dd2\u0dc1\u0dda \u0d85 \u0dc1 \u0dc0\u0dcf\u0da7 \u0d94\u0dad\u0dca\u0dc4\u0dad\u0dd4 \u0dc1\u0dcf\u0db8\u0dd2\u0db1\u0dca \u0dc4\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0db4\u0dcf\u0dad\u0dcf\u0da7 \u0dc3 \u0dd6\u0dbd\u0dd2\u0db8\u0dab\u0dc1 \u0db1\u0dca\u0db8 \u0dc4\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0dc0\u0dd4 \u0da2\u0dcf\u0dc0\u0dcf\u0dbb \u0d9a\u0dcf\u0dbb\u0dd2\u0dad\u0db1\u0dca\u0dc0 \u0dc4\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d94\u0dbd\u0d9a\u0db1\u0dca\u0dc1\u0d9c\u0db1\u0dca \u0db8\u0dd4\u0dcf\u0dbd\u0dca \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0db8\u0db8 \u0dc1 \u0d9a\u0dd2 \u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc3\u0db8\u0dc4\u0dbb \u0d85 \u0d9c\u0dd0\u0db1\u0dd2\u0dad.\n\n949 950\n\n\u0db4\u0dcf\u0dbd\u0dd2\u0db8\u0dda\u0dc1 \u0db1\u0dca\u0dad\u0dd4\u0dc0"
  },
