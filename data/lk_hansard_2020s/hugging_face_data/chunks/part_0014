    "chunk_text": "\u0dbd\u0dd2\u0dbd\u0ddc\u0dc3\u0db1\u0ddc\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0dd3\u0da7\u0da7 \u0dc1\u0db8\u0ddc\u0dc1\u0dc4\u0ddc\u0dad\u0d9a\u0da7 \u0d9a\u0dbd\u0dd2\u0db1\u0dca\u0dad \u0d9a\u0dae\u0ddc \u0d9a\u0dbb\u0db4\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0ddc \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0ddc\u0dc0 \u0d9c\u0dd0\u0db1 \u0d9a\u0dda\u0dc0\u0ddc \u0d85\u0dc1\u0dda \u0db1\u0dd2\u0dc4\u0ddc\u0dbd\u0dca \u0d9c\u0dbd\u0dda\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0dc3\u0dc1\u0dc4\u0ddd\u0daf\u0dbb \u0ddc \u0dc1\u0dda \u0dc1\u0dc0\u0dbd\u0ddc\u0dc1\u0dda \u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0ddc\u0dc1\u0dda \u0dd4\u0db1\u0dca\u0dad\u0db1\u0dc0\u0ddc \u0dc4\u0dad\u0dd4\u0db8\u0ddc \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 24\u0d9a\u0dca \u0db4\u0ddc\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dad\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dbb\u0dc1 \u0d9a\u0dca \u0dc4\u0dad\u0dd4\u0db8\u0ddc \u0dc4\u0d9a\u0daf\u0dd4 \u0daf\u0dc0\u0dc3\u0d9a\u0dca\u0dc0\u0dad\u0dca \u0dc1\u0db4\u0ddc\u0dbd\u0dd2\u0dc3\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0ddc\u0dc0 \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0db1\u0dd0\u0dc4\u0dd0 \u0d92, \u0d87\u0dba\u0dd2? \u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0da2\u0db1\u0dad\u0ddc\u0dc0\u0dc1\u0db8 \u0db8\u0dc4\u0da2\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc1\u0dc4\u0ddc\u0dbb\u0ddc \u0d9a\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0db1\u0dd0\u0dad\u0dd2, \u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0da2\u0db1\u0dad\u0ddc\u0dc0\u0dc1\u0db8 \u0db6\u0daf\u0dd4 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc0\u0dcf\u0da0\u0ddc \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0db1\u0dd0\u0dad\u0dd2, \u0d85\u0dc0\u0db7\u0ddc\u0dc0\u0dd2\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0db4\u0dd2 \u0d9a\u0ddc\u0da7\u0dc0\u0dad\u0dca \u0daf \u0db8 \u0d9a \u0dad\u0dbb\u0dda\u0dc0\u0dad\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0ddc\u0dc0\u0d9a\u0dca \u0d95\u0db1\u0dd1 \u0db1\u0dd0\u0dc4\u0dd0 \u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0da2\u0db1\u0dad\u0ddc\u0dc0 \u0d85\u0db4 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0ddc \u0d9a\u0dbb\u0db1\u0dc0\u0ddc \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda \u0dc3\u0dd2\u0dd2 \u0daf\u0dd3\u0dad\u0dca \u0dc4\u0dc1\u0dc4\u0db8\u0dba\u0dd2 \u0d85\u0dc1\u0dda \u0d85\u0db1\u0dd4\u0dbb \u0daf\u0dd2\u0dc3\u0ddc\u0db1\u0ddc \u0d9a \u0da2\u0db1\u0ddc\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0ddc \u0db4\u0dc0\u0dd2\u0dd2\u0db1 \u0dc0\u0dc3\u0dc1\u0dbb\u0dca \u0dc3\u0dd0\u0dda\u0dad\u0dd0\u0dda\u0db6\u0dbb\u0dca 21\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0ddc \u0dc1\u0dc0\u0db1\u0d9a\u0dda \u0dc1\u0dda \u0db4\u0ddc\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dad\u0dd4\u0dc1\u0dda \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 24\u0d9a\u0dca \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dbb\u0dc1 \u0d9a\u0dd4 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc4\u0ddc \u0d85\u0dc1\u0dda \u0dc3\u0dc1\u0dc4\u0ddd\u0daf\u0dbb \u0dc0\u0dd2\u0da2\u0dd2\u0dad \u0dc1\u0dc4\u0dca\u0dbb\u0dad\u0dca \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0ddc \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 24\u0d9a\u0dca \u0dc1\u0dda \u0db4\u0ddc\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dad\u0dd4\u0dc1\u0dda \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dbb\u0dc1 \u0d9a\u0dd4 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc4\u0ddc \u0d92 \u0d9a\u0dc3\u0dd2\u0dc1\u0dc0\u0d9a\u0dca \u0dc1\u0db4\u0ddc\u0dbd\u0dd2\u0dc3\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0ddc\u0dc0 \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d92 \u0d9a\u0dc3\u0dd2\u0dc1\u0dc0\u0d9a\u0dd4\u0da7 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0ddc\u0dc0 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0 \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1 \u0d9a\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0dc1\u0d9a\u0ddc\u0dad\u0dd0