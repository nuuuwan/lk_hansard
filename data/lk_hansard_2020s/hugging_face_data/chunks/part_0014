    "chunk_text": "\u0dbb\u0da2[\u0d9a\u0dca \u0daf\u0dd4\u0db0\u0dd2[\u0da7 \u0daf \u0d9a\u0dad \u0d9a \u0dc1 \u0d9c\u0db0\u0dba\u0db1\u0dc1 \u0dd0\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1 \u0dc5 \u0dc1\u0d9c\u0dc1\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1. \u0d8b\u0daf\u0dc1\u0dc4\u0dbb\u0da7[\u0d9a\u0dca \u0daf\u0dd4\u0db0\u0dd2[\u0da7 \u0d85\u0dc1\u0dda \u0da2\u0dc1\u0dad\u0dd2\u0d9a \u0dc4\u0dd0\u0db3\u0dd4\u0db1\u0dd4\u0db4\u0dad\u0db4\u0dad \u0d9c\u0db0\u0dba\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db0\u0dba; e-passport \u0d91\u0d9a \u0d9c\u0db0\u0dba\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db0\u0dba, \u0d8b\u0dda\u0db4\u0dd0\u0db0\u0dba\u0db1 \u0dc3\u0dc4\u0dad\u0dd2\u0d9a[ \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0db4\u0dda)\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0da7[\u0d9a \u0daf \u0d9a\u0dad \u0d91\u0d9a \u0d91\u0d9a \u0dad\u0dd0\u0db0\u0dba \u0d9a \u0daf\u0dd4\u0dc3\u0dd2\u0db4\u0dad\u0d9a\u0dc1 \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1. \u0d92 \u0daf \u0d9a\u0dad \u0db4\u0dda)\u0dad\u0dd2[ \u0d91\u0d9a\u0dd2\u0dc1\u0db1\u0d9a\u0da7 \u0dc3\u0db4\u0dad \u0db0\u0dba) \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0db1\u0dd2\u0dc3\u0dc1 \u0d91\u0d9a\u0db8 \u0db4\u0dd4\u0dda\u0d9c\u0d9a[\u0dc1\u0dc1\u0dda \u0daf \u0d9a\u0dad \u0d86[\u0dad\u0db1 \u0d9c\u0da7\u0db1\u0dc1 \u0d9a\u0dca \u0daf\u0dd4\u0dc3\u0dd2\u0db0\u0dba \u0db1\u0dd0 \u0dad \u0db1\u0dd0 \u0dad \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0d9a\u0dca \u0dc3\u0dd2\u0dbd\u0dd2 \u0dc1 \u0db1 \u0dc1. \u0d85\u0db4\u0dd2 \u0daf \u0d9a\u0dad \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dc1 \u0d9a\u0dca \u0d9a\u0dbb\u0dc1 [\u0db1 \u0d9c\u0db8\u0dc1\u0db0\u0dba\u0daf\u0dd3 \u0dc1\u0db4\u0dad \u0daf\u0dd4\u0db0\u0dd2[\u0da7 \u0daf \u0d9a\u0dad \u0dad\u0dd0\u0db1\u0dd2\u0db0\u0dba \u0dad\u0dd0\u0db1 \u0daf\u0dd4\u0dc3\u0dd2\u0db4\u0dad\u0d9a\u0dc1 \u0dad\u0dd2\u0dc1 \u0db1 \u0d91\u0d9a \u0dc3\u0dd4 \u0d9a\u0da7\u0dba\u0dd4 \u0d9a\u0dad\u0d9a\u0dca \u0dc1\u0db1\u0dc1\u0dc1 \u0dd2 . \u0d92 \u0db1\u0dd2\u0dc3\u0dc1 \u0d92 \u0dc1 \u0dc4\u0db4\u0dad[\u0da7 \u0d86\u0dbb\u0d9a\u0dca\u0dd2\u0dad \u0dad\u0dd2\u0dc1 \u0db0\u0dba\u0db1 \u0d95\u0db1 . \u0d92 \u0dc1 \u0dc4\u0db4\u0dad[\u0da7 \u0d86\u0dbb\u0d9a\u0dca\u0dd2\u0dad \u0daf \u0d9a\u0dad \u0db4\u0dda)\u0dad\u0dd2[\u0d9a \u0d9c \u0dc0\u0dc1 \u0dc1 \u0d9a\u0dc1 \u0dad\u0dd2\u0dc1 \u0db0\u0dba\u0db1 \u0d95\u0db1 . \u0d92 \u0dc1\u0dc1\u0dda \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dc1 \u0d9c\u0dd0\u0db1 \u0dc4\u0db4\u0dad \u0dc3\u0dc4\u0dad\u0dd2\u0d9a[\u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db0\u0dba\u0db1 \u0d95\u0db1 . \u0d92\u0d9a \u0db4\u0dda)\u0dad\u0dd2 \u0daf\u0dd4 \u0dc1\u0d9a \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0da7[\u0d9a\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0d9a\u0dbb\u0db0\u0dba\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db0\u0dba \u0dd0\u0dc0\u0d9a\u0dca \u0dc1\u0db1\u0dc1\u0dc1 \u0dd2 . \u0d92\u0d9a \u0db1\u0dd2\u0dc3\u0dc1 \u0d85\u0db4\u0dd2 \u0d92 \u0db4\u0dda)\u0dad\u0dd2 \u0dc0\u0d9a\u0dca\u0dc1\u0d9a\u0ddd\u0db8 \u0d91\u0d9a\u0da7 \u0dc3\u0db4\u0dad \u0db0\u0dba) \u0d9a\u0dbb\u0db0\u0dba\u0db1 \u0d95\u0db1 . \u0d8b\u0daf\u0dc1\u0dc4\u0dbb\u0da7[\u0d9a\u0dca \u0daf\u0dd4\u0db0\u0dd2[\u0da7 \u0d9c\u0db0\u0dba\u0db1 \u0dc1\n\n1831 1832\n\n\u0db4\u0dc1\u0dba\u0db7\u0db6\u0dbd\u0dc1\u0db4\u0dad\u0db0\u0dba\u0dad\u0dd4\n\n\u0dc1\u0db4\u0dad \u0dbb\u0dc1\u0da7\u0dca \u0daf \u0d9a\u0dad \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0d86[\u0dad\u0db1 \u0dc1\u0d9c\u0dc1\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db1 \u0d85\u0db4\u0dd2 \u0daf\u0db0\u0dba\u0db1 \u0dc1. \u0dc3\u0db8\u0dc4\u0dbb \u0dc1 \u0d9a\u0dc1 \u0da7 data breach \u0dc1 \u0d9a\u0dc1, \u0daf \u0d9a\u0dad \u0d9a\u0dc1\u0db0\u0dba\u0dbd\u0dd2 \u0dc1 \u0d9a\u0dc1 \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1 \u0db8\u0dd3\u0da7 \u0d89\u0dc3\u0dda\u0dc3\u0dbb \u0d85\u0db4\u0dd2 \u0daf\u0dd0\u0d9a\u0d9a\u0dc1 \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1. \u0d91\u0dc1\u0dc4\u0db8 \u0daf \u0d9a\u0dad \u0d9a\u0dc1\u0db0\u0dba\u0dbd\u0dd2 \u0db1 \u0d85 \u0dc3\u0dda\u0dae\u0dc1 \u0d9a \u0dc1\u0d9c\u0dc1\u0dc0\u0d9a\u0dca \u0dc1 \u0d9a\u0dc1 \u0da7 \u0d91\u0dc1\u0dc4\u0db8 \u0d9a\u0dc1\u0db0\u0dba\u0dbd\u0dd2 \u0d9a\u0dca \u0dc1 \u0d9a\u0dc1 \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1 \u0d9a\u0dd2[\u0dc1 \u0d85\u0db4\u0dd2 \u0daf\u0dd0\u0db1\u0d9c\u0db0\u0dba\u0dc1\u0db1 \u0d9a \u0d87 \u0d9a\u0dad\u0da7\u0db8 \u0dc1\u0db4\u0dad social media \u0db6\u0dbd\u0db0\u0dba \u0dc1\u0dc4\u0ddd \u0d9a\u0da7\u0dd2\u0db0\u0dba \u0d9a\u0da7 [\u0db1 \u0db4\u0dd4 \u0d9a \u0db6\u0dbd\u0db0\u0dba \u0daf\u0dd4\u0dad\u0dbb\u0dd2 . \u0d91\u0dc1\u0dc4\u0db8 \u0dc0\u0dd4\u0dc1\u0da7\u0dc1 \u0d9a \u0d92 \u0d9c\u0dd0\u0db1 \u0d85\u0db1\u0dd2 \u0dc1\u0dba\u0db7[\u0dc1[\u0db0\u0dba [\u0db4\u0dad\u0d9a\u0dd2\u0dc3\u0dd2 \u0d86[\u0dad\u0db1[\u0d9a\u0da7 \u0daf\u0db0\u0dba \u0db0\u0dba\u0db1 \u0d95\u0db1 \u0d9a\u0dd2[\u0dc1 \u0db1\u0dd2 \u0dd0\u0dbb\u0daf\u0dd2\u0db8 \u0db1\u0dd3\u0dad\u0dd2 \u0db8\u0dc1\u0dba\u0db7\u0d9c[\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0da9\u0dbd \u0db1\u0dd0\u0dc4\u0dd0. \u0d92\u0d9a \u0d89\u0dad\u0dc1\u0db8\n\n\u0dd0\u0dbb\u0dd1\u0dd4\u0dc0\u0db4\u0dad \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0da7 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1[\u0d9a\u0dca. \u0dc1\u0db8\u0dc1\u0d9a\u0daf, \u0dc1\u0db8\u0dc1\u0d9a\u0d9a\u0dca \u0dc1\u0dc4\u0ddd \u0daf \u0d9a\u0dad \u0d9a\u0dc1\u0db0\u0dba\u0dbd\u0dd2 \u0d9a\u0dca \u0dc1 \u0d9a\u0dc1 \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1 \u0d9a\u0dd2[\u0db1 \u0dc1 \u0db1\u0db4\u0dad \u0d92 \u0d9c\u0dd0\u0db1 \u0dbb\u0da2\u0dc1\u0dda \u0d86[\u0dad\u0db1[\u0d9a\u0dca \u0d85\u0db1\u0dd2 \u0dc1\u0dba\u0db7[\u0dc1[\u0db0\u0dba \u0daf\u0dd0\u0db1\u0d9c\u0db0\u0dba\u0db1 \u0d95\u0db1 . \u0dc1\u0db8\u0dc1\u0d9a\u0daf, \u0d92\u0dc1\u0d9a\u0db0\u0dba \u0dc1 \u0db1 damage \u0d91\u0d9a \u0d85\u0dca \u0d9a\u0dbb\u0db0\u0dba\u0db1 \u0dc1\u0dc4\u0ddd \u0d92\u0d9a\u0da7 [\u0db4\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd2[\u0dc1\u0db8\u0dc1\u0dba\u0db7\u0d9c[\u0d9a\u0dca \u0d9c\u0db0\u0dba\u0db1 \u0dc1\u0dc4\u0ddd \u0dad \u0d86[\u0dad\u0db1[\u0d9a\u0dca direct \u0d9a\u0dbb\u0db0\u0dba\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db0\u0dba \u0dbb\u0da2\u0