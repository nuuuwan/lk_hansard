    "chunk_size_bytes": 4265,
    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0d87\u0dca\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dca\u0db1\u0dd2, \u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dca \u0d85\u0dc1\u0dda \u0dba\u0dc1\u0da7\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0dc1\u0dda\u0dc0 \u0d9c\u0dd0 \u0d9a \u0dca\u0dc0 \u0d9a\u0dd2 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd16 \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0dc1\u0dda\u0dc0 \u0d9c\u0dd0 \u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0dca\u0dc0 \u0d9a \u0d9a\u0dd2\u0dda\u0dc0\u0dc06 \u0d8a\u0dc1\u0dda \u0daf\u0dc0\u0dc1\u0dc1\u0dda \u0d85\u0db4\u0dd2 \u0db1\u0dca \u0daf\u0dc1\u0daf \u0dc0\u0dca \u0daf\u0dd0 \u0dc0, \u0dc1 \u0dc0\u0dc1\u0dc4\u0dc0\u0dca \u0dc5\u0d9f\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb Airbus \u0d91 \u0d9c\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dba \u0dc0\u0dc06 \u0d85\u0db4\u0dd2 \u0d92 \u0d9c\u0dd0 \u0dc1 \u0dc0\u0dc1\u0dc4\u0dc0\u0dca \u0dc1\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0dca \u0dc0\u0dd4\u0da7\u0dc06 \u0dca\u0dca \u0d85\u0dc1\u0dda \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0dad\u0dc0\u0db8\u0dca\u0dc1\u0db4\u0dc0\u0dc1\u0dc5\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d91 \u0dca\u0d9c\u0dd3\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9c\u0dd0 \u0d9a \u0d9a\u0dd2 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd16 \u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dca \u0d85\u0dc1\u0dda \u0dba\u0dc1\u0da7\u0dca \u0db1\u0dca\u0da7 \u0daf\u0dd4\u0dc1\u0dda \u0dba\u0da7 \u0dd0\u0daf\u0d9a\u0dd2 \u0dc0\u0dc0 \u0da7 \u0dbb\u0db8\u0dd2 \u0db1\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dba\u0dc1\u0da7\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d91\u0dc5\u0dd2 \u0da7 \u0dc1 \u0dc0\u0da7 \u0dc1 \u0dba \u0d9c\u0dc4\u0d9a\u0dc0 \u0dc1 \u0dc0\u0dc1\u0dc4\u0dc0\u0dca \u0d9a\u0dc1\u0dda\u0dc1 \u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0d9c \u0dad\u0dca\u0db1\u0dca \u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb6 \u0dc1\u0dca\u0dc4\u0dba \u0dc1\u0dc0\u0d9a\u0dc0\u0dc0\u0da7 \u0dca\u0dda \u0dca\u0dc0\u0d9a\u0dc0 \u0d9a \u0daf\u0dc0\u0d9a\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0dc06 \u0d92 \u0daf\u0dd4\u0db0\u0dd2 \u0da7 \u0dad\u0dca\u0db1\u0dca \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0db4\u0dad \u0dba\u0da7\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dd2\u0da7 \u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb6 \u0dc4\u0dd0 \u0dd0\u0db1\u0dca, \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9c\u0dd2 \u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dbd\u0dd2 \u0da7, 5 \u0da7 \u0db4\u0dc1\u0dda\u0dc1\u0dc1\u0dda \u0d85\u0dc1\u0dda \u0dba\u0da7\u0da7 \u0d91 \u0dc1 \u0dc0\u0da7 \u0dc1\u0dad \u0db4\u0dc4 \u0da7 \u0d9c\u0da7\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd0\u0dc4\u0dd06 \u0d9c\u0da7\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd1 \u0dd0\u0dc4\u0dd0, \u0d85\u0dd4\u0dca \u0d9c\u0dc0\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0dc4\u0dc0\u0db3 \u0dc1\u0dc1\u0dda\u0dc0\u0dc0\u0dc0 \u0dc1\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb 6 \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dba\n\n2107 2108\n\n[\u0d9c\u0dbb\u0dd4 \u0db8\u0dd4\u0dc4\u0db4\u0dad\u0dca\u0dda \u0dc6\u0db1\u0dca\u0dc1\u0dc0\u0dda \u0dca\u0dc4\u0dad\u0dc0]\n\n2025 \u0da2\u0dd4\u0db1\u0dd2 05\n\n\u0d9c\u0dbb\u0dd4 \u0d87\u0dca\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dca\u0db1\u0dd2, \u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0dca\u0dc0 \u0d9a\u0dd2\u0dda\u0dc0\u0dc0 \u0d85\u0dc1\u0dda \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0dc1\u0dda\u0dc0 \u0da7 \u0d85 \u0daf \u0d9a plane \u0d91 \u0d91 \u0dad\u0dd4\u0db8\u0dcf \u0dc0\u0dd4\u0da7\u0dc0 \u0d9a\u0dd2 \u0d9a\u0dc06 \u0dc1 \u0dc0\u0dc1\u0dc4\u0dc0\u0dca \u0dc1\u0dc4\u0dc0\u0db3\u0db1\u0dca6 \u0d92 \u0da7 \u0dc1\u0da9\u0dc0\u0d9a\u0dbb\u0dca \u0db8\u0dd2\u0db6\u0dbd 275 \u0dca\u0dc0\u0dc1 \u0da7 \u0dc1\u0d9c\u0dc0 \u0dc0\u0dc06 [ \u0dc0)\u0dc0 \u0d9a\u0dd2\u0dbb\u0dd3\u0dca ] \u0dc1\u0dca\u0dc0\u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb , \u0dc1\u0da9\u0dc0\u0d9a\u0dbb\u0dca 275,000 \u0dc1\u0d9c\u0dc0 \u0dc0\u0dc06 \u0dc4\u0dd0 \u0dd0\u0db1\u0dca \u0dc1\u0db4\u0dad \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0 \u0dc1 \u0dc0\u0da0\u0dca \u0dba \u0db4\u0dba\u0da7\u0daf? \u0db4\u0dd4\u0dc0\u0d9c\u0dd2 \u0dc0\u0d9a\u0dc1\u0dda \u0d9a \u0d85\u0dc1\u0dda \u0dba\u0da7\u0da7 \u0dc1\u0db4\u0dad \u0dc0\u0dc0\u0dc1\u0dda \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0 \u0dc0 \u0dc1\u0d9c \u0dc0\u0dc0\u0dc06 \u0dc1\u0dca\u0dc4\u0dba \u0dc1\u0dc0\u0d9a\u0dc0\u0dc0\u0da7 brand new \u0d92\u0dc0\u0dc0 \u0dc1\u0d9c \u0dc0\u0dc0\u0dc06 \u0dd2\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0dc0 \u0dc0\u0dc0 \u0dc1\u0db4\u0dad\u0dc0\u0dc0 \u0dc1 \u0dc0\u0da0\u0dca \u0dba \u0db4\u0dba\u0da7\u0daf, \u0d87\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0dc5\u0dda Business Class seats \u0dc1 \u0dc0\u0db4\u0dca\u0da7 \u0dd2\u0dc1 \u0dc0\u0dc0\u0daf, Economy Class \u0d91\u0dc1 seats \u0dc1 \u0dc0\u0dc1\u0dc4\u0dc0\u0dca\u0daf \u0dd2\u0dc1 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dd2 \u0d9a\u0dc06 Economy Comfort \u0d9a\u0dd2 \u0d9a\u0dc0 \u0d9a \u0dd2\u0dc1 \u0dc0\u0dc06 \u0dc1\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0db4\u0dad \u0db4\u0dc4\u0dd4\u0dc0 \u0db4\u0dad \u0dd2\u0dc1 \u0dc0\u0dc0\u0daf \u0d9a\u0dd2 \u0d9a\u0dc0 \u0d9a\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd16 \u0dc1\u0dca\u0dc4\u0dba \u0dc1\u0dc0\u0d9a\u0dc0\u0dc0\u0da7 \u0d85\u0db4\u0da7 \u0db8\u0dd3\u0da7 \u0dc0\u0da9\u0dc0 \u0d85\u0dd4\u0dc0\u0da7 \u0d9a \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0 \u0dc0 \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb6 \u0dc4\u0dd0 \u0dd0\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0dc1\u0db4\u0dad \u0dc1\u0d9c\u0dc0 \u0db8\u0dd4\u0daf\u0d9a\u0da7 \u0d92\u0dc0\u0dc0 \u0dc0\u0da7\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd16 \u0db4\u0dd4\u0dc0\u0d9c\u0dd2 \u0dc0\u0d9a\u0dc1\u0dda \u0dc1\u0dca\u0dc1\u0dc4\u0dca \u0dc0\u0dd4\u0da7\u0dc0, \u0dc1\u0dca\u0dc1\u0dc4\u0dca \u0dc0\u0dd4\u0da7\u0dc0 \u0d9a\u0dd2 \u0d9a\u0dc0 \u0dc1\u0db4\u0dad \u0dc0\u0d9a\u0dc1\u0dda \u0d9a \u0d91\u0dc1\u0dc4\u0dca \u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf \u0dd0\u0dc4\u0dd06 \u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dc0 \u0dc4\u0dbb\u0dd2 \u0dc1\u0dda \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc4\u0daf \u0dc0\u0dc0 \u0d87\u0dd26 \u0dc4\u0dd0 \u0dd0\u0db1\u0dca, \u0dc1\u0dca\u0dc4\u0dba \u0dc1\u0dc0\u0d9a\u0dc0\u0dc0\u0da7 \u0db4\u0dd4\u0dc0\u0d9c\u0dd2 \u0dc0\u0d9a \u0da7 \u0d9a \u0dc0\u0da9\u0dc0 \u0d85\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad \u0dc1\u0dda\u0dc0\u0dda \u0dc1\u0db4\u0dad \u0dc0\u0d9a\u0dc1\u0dda \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd2\u0da9 \u0dd2\u0dc1 \u0dc0\u0dc06 \u0d92 \u0d85\u0dc0\u0dca \u0dba \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb - \u0dc0 \u0d9a\u0dc0\u0dc0 \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb - \u0dad\u0dca\u0db1\u0dca \u0daf\u0dd4\u0db4 \u0dc2\u0dca\u0da8 \u0daf\u0dd4\u0db0\u0dd2 \u0da7 \u0dc1\u0db4\u0dad\u0dc0\u0dc0 \u0dc1\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dc0 \u0dc1\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb, \u0d9c\u0dbb\u0dd4 \u0d87\u0dca\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dca\u0db1\u0dd26 \u0d91\u0dca \u0db1\u0dd2\u0dc1\u0dc0 \u0dc1\u0db4\u0dad \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0 \u0dc1 \u0dc0\u0da0\u0dca \u0dba \u0db4\u0dba\u0da7\u0daf \u0d9a\u0dd2 \u0d91 \u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0dca\u0dc0 \u0d9a\u0dd2\u0dda\u0dc1\u0dc0\u0dc0 \u0d9a \u0dc1\u0dc4\u0dc0\u0db3\u0db1\u0dca6"
