    "chunk_text": "\u0db8\u0dad\u0dca\u0dad\u0dbd \u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0dad\u0ddc \u0d9a\u0dc1\u0db4\u0ddc\u0dc4 2013 \u0dc0\u0dbb\u0dca\u0dc2\u0dc1\u0dda\u0daf\u0dd3 \u0dc4\u0daf\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dc1\u0da9\u0ddc\u0dbd\u0dbb\u0dca \u0db8\u0dd2\u0dbd\u0dd2 \u0db1 250\u0d9a \u0dc0\u0dd2 \u0daf\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca\u0dc0\u0dbd\u0dd2\u0db1\u0dca\u0dad \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0ddc\u0dad\u0dca \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2 \u0db1 75\u0d9a \u0dc0\u0ddc \u0dc1\u0db8 \u0dc0\u0dd2 \u0daf\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dc1\u0dda \u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0dad\u0ddc \u0d9a\u0dc1\u0db4\u0ddc\u0dc4 \u0dc4\u0daf\u0db1\u0dca\u0dad\u0db1 loan \u0dc4\u0d9a\u0d9a\u0dca \u0dc4\u0dda\u0db6 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc, \u0dc1\u0da9\u0ddc\u0dbd\u0dbb\u0dca \u0db8\u0dd2\u0dbd\u0dd2 \u0db1 190\u0d9a 2013 \u0dc0\u0dbb\u0dca\u0dc2\u0dc1\u0dda \u0dd4\u0db3\u0db1\u0dca\u0dad \u0dc1\u0dda \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0db8\u0dad\u0dca\u0dad\u0dbd \u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0dad\u0ddc \u0d9a\u0dc1\u0db4\u0ddc\u0dc4 \u0dbd\u0db6\u0db4\u0dd4 \u0dc3\u0dda\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0ddc\u0dd4\u0dc0 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2 \u0db1 60\u0dba\u0dd2 \u0d92 \u0d9a \u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad, \u0d85\u0db4\u0dd2 \u0dad\u0dc0 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2 \u0db1 15 \u0d9a\u0db1\u0dca\u0dad \u0db8\u0dad\u0dca\u0dad\u0dbd \u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0dad\u0ddc \u0d9a\u0dc1\u0db4\u0ddc\u0dc4 \u0dc4\u0daf\u0db1\u0dca\u0dad\u0db1 \u0dc0\u0dd0 \u0d9a\u0dbb\u0db4\u0dd4 \u0db8\u0dd4\u0daf\u0dbd \u0dc3\u0db8\u0ddc\u0db1 \u0d9a\u0dbb\u0db1\u0dc0\u0ddc \u0d85\u0db4\u0dd2 \u0db4\u0dc0\u0dd2\u0dd2\u0db1 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 13 \u0d87\u0dad\u0dd4\u0dc4\u0dad \u0d92 \u0dc3\u0db3\u0dc4\u0ddc \u0dc0\u0dd2\u0daf\u0dd4\u0dc0\u0dd2 \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc4\u0d9a\u0dca \u0dc4\u0daf\u0dbd\u0ddc \u0db1\u0dd0\u0dc4\u0dd0 \u0d85\u0dc1\u0dda \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dbb\u0dc1 \u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dc4\u0ddc, \u0db4\u0dbb\u0dab \u0d92\u0dc0\u0ddc \u0d9a - \u0d9a \u0ddc \u0dd4\u0db1\u0dca\u0dad\u0db1 \u0dc4\u0db4\u0ddc, \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d9a \u0dbd\u0ddc \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d85\u0db4\u0da7 \u0db4\u0dbb\u0dab \u0dc1\u0daf\u0dca\u0dc0\u0dbd\u0dca \u0d9c\u0dd0\u0db1 \u0d85\u0daf\u0dc4\u0dc3\u0d9a\u0dca \u0dbd\u0db6\u0ddc \u0d9c\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0dc1\u0daf\u0dca\u0dc0\u0dbd\u0dca \u0dc4\u0daf\u0ddc \u0d9c\u0db1\u0dca\u0dad\u0db1 \u0d85\u0db8\u0ddc\u0dbb\u0dd4\u0dba\u0dd2 \u0d92\u0d9a \u0db1\u0dd2\u0dc3\u0ddc \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dc1\u0dda \u0d9a\u0ddc\u0dbb\u0dab \u0db8\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d85\u0db4\u0da7 \u0dc4\u0dd0 \u0d9a \u0ddc\u0dc0 \u0dbd\u0dd0\u0db6\u0dd2\u0dbd\u0ddc \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0ddc, \u0db4\u0dc0\u0dd2\u0dd2\u0db1 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf \u0dc3\u0dc4 \u0dc1\u0dda \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf \u0d87\u0dad\u0dd4\u0dc4\u0dad passengers\u0dbd\u0ddc \u0db4\u0dca\u200d\u0dbb\u0db8\u0ddc\u0dab \u0dc0\u0dd0\u0dd2\u0db1 \u0d9a\u0dbb\u0d9c\u0db1\u0dca\u0dad\u0db1\n\n\u0d92 \u0db1\u0dd2\u0dc3\u0ddc \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0ddc\u0dc1\u0db4\u0ddc\u0dc1\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc, \u0dc1\u0db8\u0db1\u0dca\u0dad\u0db1 \u0dc1\u0dda \u0d9a\u0dca\u0dc1\u0dc2\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc4\u0dad \u0dc4\u0dbb\u0dc4\u0ddc \u0db8\u0dad\u0dca\u0dad\u0dbd \u0dd4\u0dc0\u0dc0\u0db1\u0d