    "chunk_text": "\u0dc1\u0d9a\u0ddd\u0dc3\u0dbd \u0db1\u0dd4\u0dc0\u0db1\u0dca \u0da2 \u0dc0\u0dd3\u0dba \u0dc3\u0dc1\u0dc4\u0ddd\u0daf\u0dba \u0dcf \u0d92 \u0d86\u0d9a\u0dcf\u0dba \u0da7 \u0dc3\u0db8\u0dcf\u0da2 \u0d9a\u0dcf\u0dbb\u0dca \u0db7\u0dcf\u0dba \u0dd2\u0da7\u0dd4 \u0d9a\u0dba\u0dda\u0daf\u0dd2 \u0dad\u0db8\u0db1\u0dca\u0dc1\u0dda \u0db4\u0dc6\u0dca\u0dc1\u0dbd \u0d85 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dd4\u0dad\u0dca \u0d92 \u0d85\u0dc0 \u0dba \u0dc1\u0dc3\u0dcf \u0dcf \u0db6\u0dd0\u0dd3\u0db8\u0dca \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0dc3\u0db8\u0dad\u0dca \u0dc6\u0dca\u0da7\u0dcf. \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0dda \u0db4\u0dd2 \u0dcf, \u0db8\u0dc0 \u0dc3\u0dc4 \u0db8\u0dbd \u0db4\u0dc0\u0db1\u0dca \u0dc1\u0daf\u0db4\u0dc5 \u0d9c\u0dd0\u0db1 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0d94\u0dc6\u0dca\u0db1\u0dca\u0dc1\u0dda \u0dc3\u0dd2 \u0dbd\u0dd4 \u0d85\u0dc0 \u0dba\u0dad\u0dcf \u0d9c\u0dd0\u0db1 \u0dc1\u0dc3\u0dcf \u0dcf \u0db6\u0dbd\u0db8\u0dd2\u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc5\u0dcf. \u0d94\u0dc6\u0dca\u0db1\u0dca\u0da7 \u0d85\u0dc0 \u0dba \u0db8\u0d9f \u0dc1\u0db4\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0dbd\u0db6\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d85\u0dad\u0dba \u0da2\u0db1\u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dc6\u0dca\u0da7\u0dcf. \u0d92"
  },
