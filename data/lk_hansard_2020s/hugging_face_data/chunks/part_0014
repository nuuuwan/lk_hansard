    "chunk_text": "\u0d92 \u0dc1\u0dc1\u0dda\u0db8 \u0dc1\u0db4\u0dad \u0daf \u0d9a\u0dad \u0dc3\u0db4\u0dad \u0db0\u0dba)\u0dc1[\u0db0\u0dba \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0dc1\u0d9a\u0dc1\u0da7 \u0dad\u0dd2\u0dc1 \u0db1 \u0da2\u0dc1\u0dad\u200d\u0db0\u0dba\u0dad\u0dbb \u0db4\u0dca\u200d\u0dbb \u0da7\u0dad\u0dc1 \u0d9c\u0dd0\u0db1 \u0d9a\u0dd2 \u0dc1 \u0dc1 \u0d9a, \u0dc1\u0db4\u0dad \u0dc3\u0db4\u0dad \u0db0\u0dba)\u0dc1[\u0db0\u0dba \u0dad\u0dd2\u0dc1 \u0db1 regulations \u0dc1\u0db8\u0dc1\u0db1 \u0dc1\u0daf, \u0d92 \u0dc3\u0db4\u0dad \u0db0\u0dba)\u0dc1[\u0db0\u0dba \u0dad\u0dd2\u0dc1 \u0db1 \u0d86[\u0dad\u0db1 \u0db4\u0dd2\u0dc5\u0dd2 \u0db3 \u0d92 \u0d9c\u0dad \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd2[\u0dc1\u0db8\u0dc1\u0dba\u0db7\u0d9c \u0dc1\u0db8\u0dc1\u0db1 \u0dc1\u0daf, \u0db4\u0dd0\u0db1\u0daf\u0dd4[ \u0dba\u0dd4\u0dad\u0dd4 \u0db1\u0dd3\u0dad\u0dd2 \u0dc1\u0db8\u0dc1\u0db1 \u0dc1\u0daf, \u0dc1\u0db4\u0dad \u0dc1 \u0db1\u0dd2[\u0dc1\u0db8\u0db1[ \u0d9a\u0dc5 \u0dba\u0dd4 \u0d9a\u0dc1 \u0d9a \u0dc1\u0db8\u0dc1\u0db1 \u0d86[\u0dad\u0db1 \u0db8\u0db1\u0dca\u0db0\u0dba\u0daf \u0d9a\u0dd2[\u0db1 \u0d9a\u0dd4\u0dc0\u0dab\u0dd4 \u0dc3\u0db4\u0dad \u0db0\u0dba)\u0dc1[\u0db0\u0dba \u0daf\u0dd3\u0dba\u0db7\u0d9d \u0dc3\u0dc1\u0d9a\u0da0\u0dca\u0da0\u0da1\u0dc1 \u0d9a\u0dd2\u0db0\u0dba \u0db4\u0dc3\u0dda\u0dc1\u0dc3\u0dda \u0dad\u0db8\u0dd2 \u0d85\u0daf\u0dc1\u0dc5 \u0d85\u0da7\u0db4\u0db1 \u0d9a \u0dc3\u0dc4 \u0d92 \u0d85\u0db0\u0dd2\u0d9a\u0dc1\u0db4\u0dad\u0db0\u0dba \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db0\u0dba\u0db1 \u0d9a\u0dc1\u0dc1\u0db4\u0dc1\u0dc1\u0dbb\u0dc1 \u0d9a\u0dad\u0dd4 \u0dc1 \u0db0\u0dba\u0dc1\u0db0\u0dba. \u0d8b\u0daf\u0dc1\u0dc4\u0dbb\u0da7[\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2[\u0da7 \u0db8\u0db8 \u0d9a\u0dd2 \u0dc1, 2023\u0daf\u0dd3 \u0d89\u0db0\u0dba\u0daf\u0dd2[\u0dc1 DPDP \u0d9a\u0dd2[\u0db1 \u0db4\u0db1\u0dad \u0db8\u0db1\u0dca\u0db0\u0dba \u0dad\u0db8\u0dd2 \u0daf \u0d9a\u0dad \u0dc3\u0db4\u0dad \u0db0\u0dba) \u0db4\u0db1\u0dad \u0d87\u0dad\u0dd4\u0dc5 \u0d9a \u0d9a\u0dbb\u0d9a\u0dc1 \u0dad\u0dd2\u0dc1 \u0db0\u0dba\u0dc1\u0db0\u0dba \u0d9a\u0dd2[\u0d9a\u0dc1.\n\n1747 1748\n\n\u0db4\u0dc1\u0dba\u0db7\u0db6\u0dbd\u0dc1\u0db4\u0dad\u0db0\u0dba\u0dad\u0dd4\n\n\u0db1\u0db8\u0dd4 \u0d9a \u0d92 \u0db1\u0dd2[\u0dc1\u0db8\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dc1\u0db4\u0dad\u0db0\u0dba \u0dc3\u0dc4 implementation part \u0d91\u0d9a \u0dc3\u0db4\u0dad \u0db0\u0dba)\u0dc1[\u0db0\u0dba \u0dad \u0db8 \u0d9a \u0dc3\u0dc1\u0d9a\u0da0\u0dca\u0da0\u0da1\u0dc1 \u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1. \u0d92 \u0dc1 \u0dc3\u0db4\u0dad\u0db4\u0dd6\u0dba\u0db7\u0da7 \u0d9a\u0dbb\u0db0\u0dba\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0d9a\u0dc1 \u0db1\u0dd0\u0dc4\u0dd0.\n\n\u0d92 \u0dc1\u0dc1\u0dda\u0db8 \u0d86[\u0dad\u0db1\u0dd2\u0d9a \u0dc1[\u0db0\u0dba \u0d9c \u0d9a\u0dc1\u0dad\u0dc1 \u0d9a, \u0d9a\u0dcf\u0d9a\u0dc1\u0dc1 \u0dc1\u0dc1\u0dda Data Protection Authority \u0d91\u0d9a\u0d9a\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0db8\u0dca \u0d9a\u0dc1 \u0d92 \u0db1\u0dd3\u0dad\u0dd2 \u0dc4\u0db4\u0dad[\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2[\u0dc1 \u0d9a\u0db8\u0d9a \u0dc1 \u0db1 \u0dc1\u0daf \u0d9a\u0dd2[\u0db1 \u0d91\u0d9a \u0dc3\u0db4\u0dad \u0db0\u0dba)\u0dc1[\u0db0\u0dba \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db0\u0dba\u0db1 \u0db1\u0dd3\u0dad\u0dd2\u0db8[ \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0da7[ \u0dc3\u0dd2\u0dbd\u0dd2 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dd2 . \u0d92 \u0dc1\u0dc1\u0dda\u0db8 \u0daf \u0d9a\u0dad\u0daf\u0dc1[\u0d9a[\u0db0\u0dba\u0da7 \u0daf\u0dd0\u0db1\u0dd4\u0db4\u0dad \u0daf\u0dd3\u0db4\u0dad, \u0dc0\u0dc0\u0dd4\u0db0\u0dba\u0dc1\u0dda \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db4\u0dad \u0db4\u0dd2\u0dc5\u0dd2 \u0db3 \u0dc3\u0db8\u0dc1\u0da2 \u0db8\u0da7\u0dca\u0da7\u0dc1\u0db4\u0dad \u0daf\u0dd0\u0db1\u0dd4 \u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db4\u0dad \u0dc3\u0db3\u0dc4\u0dc1 \u0d86[\u0dad\u0db1\u0dd2\u0d9a \u0dc1[\u0db0\u0dba \u0d9c\u0dad \u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0dd2[ \u0dbb \u0dc3\u0db4\u0dad \u0db0\u0dba)\u0dc1[\u0db1\u0dd4 \u0d9a \u0dc3\u0db8\u0dc1\u0da2[ \u0dad\u0dd4\u0dc5 \u0dc3\u0dc1\u0d9a\u0da0\u0dca\u0da0\u0da1\u0dc1 \u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1. \u0d92 \u0dc1\u0dc1\u0dda\u0db8 \u0dad\u0dc1\u0d9a\u0dca\u0dc2\u0dab\u0dd2\u0d9a \u0dc1[\u0db0\u0dba \u0daf \u0d9a\u0dad \u0dc3\u0dcf\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0da7[ \u0d9a\u0dd2\u0dbb\u0dd3 \u0dc1\u0db4\u0dad\u0daf\u0dd3, end-to-end encryption \u0d9c\u0dd0\u0db1, \u0d92 \u0d9a\u0dd2[\u0db0\u0dba\u0dc1\u0db0\u0dba \u0daf \u0d9a\u0dad\u0daf\u0dc1[\u0d9a[\u0dc1\u0da7 \u0dc3\u0dc4 \u0daf \u0d9a\u0dad \u0db4\u0db4\u0dad\u0dc1\u0dd3\u0d9a\u0d9a[\u0dc1\u0da7 \u0db4\u0db8\u0da7\u0d9a\u0dca \u0dc1\u0dad\u0dc1\u0dbb\u0dad\u0dd4\u0dd4\u0dc0 \u0d9a \u0dc1 \u0d9c\u0db0\u0dba\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db0\u0dba \u0db1 \u0daf\u0dd4\u0db0\u0dd2[\u0da7 \u0dc1\u0db4\u0dad \u0daf \u0d9a\u0dad \u0dc4\u0dd4 \u0db8\u0dc1\u0dd4\u0dc0 \u0dc3\u0dd2\u0dbd\u0dd2\u0dc1 \u0db0\u0dba\u0db1 \u0d95\u0db1 .\n\n\u0d92 \u0dc1\u0dc1\u0dda\u0db8, \u0d92 \u0daf \u0d9a\u0dad \u0dc3\u0db3\u0dc4\u0dc1 \u0dad\u0dd2\u0dc1 \u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc1 [\u0da7 \u0d85\u0daf\u0dc1\u0dc5 control \u0d91\u0d9a\u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db0\u0dba\u0db1 \u0d95\u0db1 . \u0d85\u0db0\u0dba\u0db1 \u0d92 \u0dc1\u0dc1\u0dda \u0dad\u0dc1\u0d9a\u0dca\u0dc2\u0dab\u0dd2\u0d9a \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc4\u0db3\u0dd4\u0db0\u0dba \u0dc1 \u0daf\u0dd2[ \u0dba\u0dd4\u0dad\u0dd4\u0dd2 \u0d9a\u0dd2[\u0db1 \u0d91\u0d9a \u0d85\u0daf \u0db1 \u0dc1\u0d9a\u0dc1\u0da7 \u0dc1\u0d9a\u0ddd\u0d9a\u0dc1\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0d9c \u0d9a \u0dc3\u0dcf\u0d9a\u0dbd\u0dca\u0db4[\u0d9a\u0dca.\n\n\u0dad \u0d9a \u0d91\u0d9a\u0d9a\u0dca \u0dad\u0db8\u0dd2 , Privacy by Design \u0d9a\u0dd2[\u0db1 \u0dc3\u0dcf\u0d9a\u0dbd\u0dca\u0db4[. \u0dc1\u0dad\u0dc1\u0dbb\u0dad\u0dd4\u0dd4\u0dc0 \u0db4\u0dda)\u0dad\u0dd2\u0dc1\u0dda \u0db1\u0dd2\u0dba\u0db7\u0db8\u0dc1\u0da7[ \u0d86\u0dbb\u0db4\u0dad\u0dbb\u0dc1\u0dda \u0dc3\u0dd2\u0da7\u0db8 \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0db6\u0dbd\u0d9a \u0d9a [ \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dc1 \u0d9a\u0dbb\u0db1 \u0daf\u0dd4\u0db0\u0dd2[\u0da7 \u0dc3\u0dd0\u0d9a\u0dc3\u0dd4\u0db4\u0dad \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dd2 \u0d9a\u0dd2[\u0db1 \u0dc3\u0dcf\u0d9a\u0dbd\u0dca\u0db4[ \u0d9a \u0dc1\u0db4\u0dad\u0d9a \u0d9a \u0d91\u0d9a\u0dca\u0d9a \u0dc3\u0dc1\u0d9a\u0da0\u0dca\u0da0\u0da1\u0dc1 \u0da7 \u0d87\u0daf\u0dd4\u0dbd\u0dca\u0d9a\u0dc1 \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1.\n\n\u0db4\u0dc1\u0dba\u0db7\u0db6\u0dbd\u0dc1\u0db4\u0dad\u0db0\u0dba\u0dad\u0dd4\u0dc1 \u0d85\u0daf \u0dc3\u0dc1\u0d9a\u0da0\u0dca\u0da0\u0da1\u0dc1 \u0db1 \u0dc1\u0db4\u0dad \u0db4\u0db1 \u0d9a \u0dc1\u0d9a\u0db8\u0dca\u0db4\u0dad\u0db4\u0dad \u0db4\u0dd2\u0dc5\u0dd2 \u0db3 \u0d85 )\u0dc1\u0db1[ \u0dc1[\u0dc1\u0db8\u0dd4 \u0d9a\u0dc1\u0dc5\u0dc1 \u0d9a, \u0db8\u0dc1 \u0d9a\u0db6\u0dbd\u0db0\u0dba \u0dc3\u0db3\u0dc4\u0db0\u0dba \u0d9a\u0dc5\u0dc1 \u0dc1\u0dc1\u0dda 2022 \u0dba\u0db7\u0dc2\u0dc1\u0dda\u0daf\u0dd3 \u0dad\u0db8\u0dd2 \u0dc1\u0db8\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb)\u0dc1\u0db1 \u0db4\u0db1\u0dad \u0db4\u0db1 \u0d9a \u0dc1\u0d9a\u0db8\u0dca\u0db4\u0dad\u0db4\u0dad\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2[\u0da7 \u0db4\u0dc1\u0dba\u0db7\u0db6\u0dbd\u0dc1\u0db4\u0dad\u0db0\u0dba\u0dad\u0dd4 \u0da7 \u0d89\u0daf\u0dd2\u0db4\u0dad\u0db4 \u0d9a \u0dc1\u0d9a\u0dd4\u0dc0\u0dc1\u0da9\u0dbd. \u0d92 \u0d85\u0db1\u0dd4 \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0db6\u0dbd\u0d9a \u0daf \u0d9a\u0dad \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0da7 \u0db4\u0db1\u0dad 2021 \u0db8\u0dc1\u0dba\u0db7\u0dad\u0dd4 68 \u0db1 \u0daf\u0dc1 \u0daf\u0dd4\u0da7 \u0dc3\u0db4\u0dad\u0db4\u0dd6\u0dba\u0db7\u0da7\u0dc1[\u0db0\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2[\u0dc1 \u0d9a\u0db8\u0d9a \u0daf\u0dd4[ \u0dba\u0dd4\u0dad\u0dd4\u0dd2 \u0d9a\u0dd2[\u0db1 \u0d85\u0daf\u0dc4\u0dc1\u0dc3\u0dda \u0dad\u0db8\u0dd2 \u0d