n\u0dc3\u0dc4 \u0dbb\u0dc1\u0da2\u200d \u0daf\u0dd4[\u0daf\u0db4\u0dad \u0dad\u0dc1\u0dba\u0db7\u0d9a\u0dd3\u0d9a\u0dbb\u0da7[ \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dad\u0dd4\u0dc5\u0dd2\u0db0\u0dba 2021 \u0dc3\u0dbb \u0dc4\u0dc1 \u0d89\u0db0\u0dba \u0dc0\u0dda \u0da7 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dae\u0db8\u0dd2\u0d9a \u0d85\u0dad\u0dd2\u0db4\u0dad\u0d9a\u0dca\u0dad[, \u0daf\u0dc5 \u0dc1\u0dda\u0dc1\u0dd3[ \u0db1\u0dd2\u0dc2\u0dda\u0db4\u0dc1\u0daf\u0dd2\u0dad\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2 \u0dad[\u0d9a\u0dca \u0dc1\u0d9a\u0dc3 2.3\u0d9a \u0db8\u0da7\u0dca\u0da7\u0dc1\u0db4\u0dad \u0db4 \u0d9a \u0dc1 \u0d9c\u0dd0\u0db1\u0dd3\u0db8.\n\n\uf0b7 \u0dbb\u0dc1\u0da2\u200d \u0db8\u0dd6\u0d9a\u200d \u0d9a\u0dc5\u0db8\u0db1\u0dc1\u0d9a\u0dbb\u0da7 \u0db4\u0db1\u0dad\u0da7 \u0d85\u0db1\u0dd4 \u0db8)\u200d\u0d9a\u0dc1\u0d9a\u0db1 \u0dbb\u0dc1\u0da2\u200d \u0db8\u0dd6\u0d9a\u200d \u0dbb\u0dc1\u0db8\u0dd4 [\u0da7\u0dc1 \u0d9a \u0daf\u0dc5 \u0dc1\u0dda\u0dc1\u0dd3[ \u0db1\u0dd2\u0dc2\u0dda\u0db4\u0dc1\u0daf\u0dd2\u0dad\u0dc1[\u0db0\u0dba \u0dc3\u0dd2[[\u0da7 63\u0da7 \u0dc0\u0dc1 \u0db4\u0dc4\u0dc5 \u0db8\u0da7\u0dca\u0da7\u0db8\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dae\u0db8\u0dd2\u0d9a \u0daf\u0dd4[\u0daf\u0db4\u0dad \u0dc3\u0dd3\u0db8\u0dc1 \u0da7 \u0db4\u0dc4\u0dc5\u0dd2\u0db0\u0dba \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dae\u0db8\u0dd2\u0d9a \u0daf\u0dd4[\u0daf\u0db4\u0dad \u0d9a\u0dc5\u0db8\u0db1\u0dc1\u0d9a\u0dbb\u0da7[ \u0d9a\u0dd2\u0dbb\u0dd3\u0db8.\n\n\uf0b7 2025 \u0dc4\u0dc1 \u0d89\u0db0\u0dba \u0dc0\u0dda \u0da7 \u0dbb\u0dc1\u0da2\u200d \u0d86\u0dc1[\u0ddd\u0da2\u0db1 \u0daf\u0dc5 \u0dc1\u0dda\u0dc1\u0dd3[\n\n\u0db1\u0dd2\u0dc2\u0dda\u0db4\u0dc1\u0daf\u0dd2\u0dad\u0dc1[\u0db0\u0dba \u0dc3\u0dd2[[\u0da7 4\u0d9a\u0da7 \u0dc0\u0dc1 \u0db4 \u0d9a \u0dc1 \u0d9c\u0dd0\u0db1\u0dd3\u0db8.\n\n\uf0b7 \u0dc1\u0db8\u0d9a\u0dd3 \u0dc3\u0dc1\u0dba\u0db7 \u0dbb\u0dc1\u0da2\u200d \u0db8\u0dd6\u0d9a\u200d \u0d89\u0d9a\u0d9a\u0dca\u0d9a \u0dc3\u0db4\u0dd4\u0dbb\u0dc1 \u0d