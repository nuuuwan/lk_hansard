    "chunk_text": "\u0d92 \u0db1\u0dd2\u0dc1\u0dc0 \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca \u0dc0\u0dc0, \u0d85\u0db0\u0dd2 \u0dba\u0da7 \u0da7 \u0db1\u0dbb\u0dd4 \u0dba\u0db1\u0dca \u0d95 \u0dd1 \u0daf\u0dd4\u0db0\u0dd2 . \u0db8\u0dd4 \u0d9a \u0db8\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb \u0dc0 \u0dc1 \u0db1\u0dca \u0dc1 \u0ddc\u0da7\u0dc1\u0d9a\u0dca \u0dc1\u0dcf \u0dc1\u0dcf \u0dba\u0da7 \u0dba\u0d9a\u0dc0 \u0db6\u0dbd \u0daf\u0dd4\u0dbd\u0dca\u0d9a\u0d9a\u0dca \u0dcf\u0daf\u0d9a\u0dc0, \u0d92 \u0d85\u0dc1\u0dad\u0dba \u0db4\u0dca\u200d\u0dbb \u0dc0 \u0da7 \u0d8b\u0da9\u0dc1\u0db1 \u0dc1\u0daf\u0db1\u0dca try \u0dba \u0dd2 \u0dc1 \u0dc0\u0dc0. \u0db8\u0dd4 \u0d9a \u0d92 \u0daf\u0dd4 \u0dc0 9\u0db8 \u0d85\u0dba\u0dc1\u0db1 \u0dd0 \u0d86\u0dc1\u0dc0\u0ddc \u0d9a, \u0d85\u0da9\u0dd4 \u0db1\u0da7\u0dc1\u0db1\u0dca 6\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd4 \u0dc0 \u0dc1\u0dda \u0dd2\u0dc4\u0d9a\u0dc0 \u0dd0 \u0d86\u0dc0 \u0d9a \u0db8\u0db8 \u0dc5 \u0dcf\u0dc0\u0dc0 \u0dc1 \u0d9a\u0dbb\u0dd4\u0db4\u0dad \u0dc0\u0dc0. \u0db8\u0db8 \u0d92 \u0dd0\u0dc0\u0dad \u0d9a\u0dd2 \u0dc0\u0dc0. \u0d85\u0db4\u0dd2 \u0daf\u0dd4\u0db4\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dc1\u0dda \u0dd2\u0db1\u0dca \u0dc1 \u0ddc\u0da7 \u0dd2\u0dbd\u0dca \u0d86\u0dc0\u0dc0, \u0db1\u0dd3\u0dd2 \u0dc1\u0dda \u0daf\u0dd4)\u0dc0 \u0dc1\u0dda \u0d86\u0db0\u0dd2\u0db4\u0dad\u0dba . \u0d85\u0db4\u0dd2 \u0daf\u0dd4\u0db4\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dc1\u0dda \u0dd2\u0db1\u0dca \u0dc1 \u0ddc\u0da7 \u0dd2\u0dbd\u0dca \u0d86\u0dc0\u0dc0, \u0dc1\u0dd0\u0db8\u0da7 \u0dc1\u0db8\u0dc0 \u0dc0 \u0db1\u0dd3\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc0 \u0d9a\u0db8 \u0dba\u0db1\u0dca , \u0d85\u0db0\u0dd2 \u0dba\u0da7 \u0dc1\u0dcf\u0dc0\u0dc0\u0db0\u0dd3 \u0dc0 \u0dad \u0db1\u0dca , \u0db1\u0dd3\u0dd2 \u0db4\u0dd2 \u0dc0\u0dba \u0dc0 \u0dc1\u0dcf\u0dc0\u0dc0\u0db0\u0dd3 \u0dba\u0db1\u0dca , \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0d9a\u0db4\u0dd1\u0db4\u0dad \u0dba\u0db1\u0dca \u0d91\u0db4\u0dc0 \u0d9a\u0dd2 \u0d9a\u0dc0. \u0d85\u0db4\u0dd2 \u0d91 \u0daf\u0dd4\u0db4\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dc1\u0dda \u0dd2\u0dc0\u0da7\u0dd2 \u0daf\u0dd3 \u0d9a \u0d9a\u0dd2\u0dda\u0dc0\u0dc0. \u0d85\u0db4\u0dd2 \u0daf\u0dd0\u0db1\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0d9a \u0d85\u0dba\u0dc1\u0db1 \u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d9a \u0d92 \u0db8 \u0dad\u0db8\u0dba\u0dd2. \u0d85\u0db4\u0da7 \u0dc1\u0dcf\u0dc1 \u0ddd\u0db1 \u0daf\u0d9a\u0dca\u0dc0 \u0dc1\u0dc1\u0dcf\u0ddd\u0daf\u0dba, \u0dc1\u0dc1\u0dcf\u0ddd\u0daf\u0dbb\u0dd2 \u0db1\u0dca \u0db4\u0dc0\u0dc0 \u0dc4\u0dd2\u0dad\u0dc0\u0dc1\u0db1 \u0dd2\u0db1\u0dca \u0dc0\u0dc0, \u0d85\u0db0\u0dd2 \u0dba\u0da7 \u0dad\u0db8\u0dd2 \u0dc0\u0dba \u0dc0 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0d9a\u0dc0 \u0dc1\u0dcf\u0ddc\u0dbb\u0dd4 \u0dc1 \u0db1\u0dca \u0dad\u0daf\u0dc1\u0db1 \u0dad\u0daf\u0dd4\u0dbd\u0dca\u0d9a\u0dc0 \u0da9\u0dd4 \u0d85\u0dcf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dd0\u0dad\u0dd4\u0dc0 \u0dc4\u0dd2\u0dc1\u0dbb\u0dca \u0daf\u0db8\u0db1\u0dca \u0d95 \u0dd1 \u0d9a\u0dd2 \u0d9a\u0dc0. \u0d91\u0dc1\u0dcf\u0db8 \u0dba\u0db4\u0dd4 \u0dc0\u0d9a \u0dca \u0d9a \u0dd2 \u0db6\u0dd4\u0da7\u0dc0. \u0dc3\u0dd4\u0dbd\u0dd2 \u0dc0\u0dd1\u0db1\u0dca\u0dc0\u0db6\u0dbd\u0db1\u0dca \u0dad\u0daf\u0dd4\u0dbd\u0dca\u0d9a\u0dc0 \u0d91\u0dc1\u0dcf\u0db8 \u0dba\u0db4\u0dd4 \u0dc0\u0d9a \u0d9a\u0dca \u0dd2 \u0db6\u0dd4\u0da7\u0dc0. Television stations \u0d9c\u0dd2\u0db1\u0dd2 \u0dd2 \u0db4\u0dd4 \u0dc0\u0d9a \u0d9a\u0dca \u0dd2 \u0db6\u0dd4\u0da7\u0dc0. \u0da2\u0dcf\u0dc0\u0dd2 \u0da2\u0dcf \u0d9a\u0dc1\u0dda\u0db1\u0dc1\u0dda \u0d85\u0db4\u0dd2 \u0daf\u0dd4\u0db4\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dc1\u0dda \u0dd2\u0db1\u0dca \u0dc1 \u0ddc\u0da7 \u0db1\u0dd3\u0dd2 \u0dc1\u0dda \u0daf\u0dd4)\u0dc0 \u0dc1\u0dda \u0d86\u0db0\u0dd2\u0db4\u0dad\u0dba \u0dd2\u0dbd\u0dca \u0d86\u0dc0\u0dc0 \u0dc0\u0dc0\u0dc1\u0dda\u0db8, \u0d85\u0db4\u0dd2 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc1\u0dda \u0dd2\u0db1\u0dca \u0dc1 \u0ddc\u0da7 \u0d85\u0dc1 \u0d9a\u0dca \u0d85 \u0da7 \u0d9a \u0d92 \u0d85\u0dc0\u0dc1\u0dcf\u0dcf\u0dc0\u0dc0 \u0dc1\u0daf \u0dc0\u0dc0. \u0d92\n\n\u0da2\u0dcf\u0dc0\u0dd2 \u0da2\u0dcf \u0d9a\u0dc1\u0dda\u0db1\u0dc1\u0dda \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0daf\u0dd4\u0dd2\u0dc0\u0db1\u0dca \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dc0\u0da7 \u0dba \u0daf\u0dd3\u0d9a\u0dc0 \u0dd2 \u0dc1 \u0dc0\u0da7\u0db4\u0dd2\u0da7\u0dc0\u0dc0 \u0d85\u0dba\u0dc1\u0db1 \u0d9a\u0db1\u0dca . \u0d92 \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dc0\u0da7 \u0dba \u0dd2 \u0dc1 \u0dc0\u0da7\u0db4\u0dd2\u0da7\u0dc0\u0dc0 \u0dad\u0db8\u0dba\u0dd2, \u0db1\u0dbb\u0dd4 \u0db1\u0dd3\u0dd2 \u0db4\u0dd2 \u0dc0\u0dba \u0dc0\u0da7 \u0dc0\u0dd4\u0da7 \u0d9a \u0d85\u0db0\u0dd2 \u0dba\u0da7 \u0da7 \u0dc0\u0dd4\u0da7 \u0d9a \u0dc1\u0dcf\u0dc0\u0dc0\u0db0\u0dd3 \u0dc0 \u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0dba\u0db1\u0dca \u0dd2 \u0dc1 \u0dcf\u0dd0\u0d9a\u0dd2 \u0dc0\u0dc0. \u0d85\u0db4\u0dd2 \u0d92 \u0dad \u0d9a \u0d9a\u0dc0 \u0dd2\u0dc1\u0dcf\u0db8\u0dad\u0dd4 \u0dba \u0daf\u0dd3\u0d9a\u0dc0 \u0dd2 \u0dc1 \u0dc0\u0dc0. \u0d92 \u0d91\u0dc1\u0dcf\u0db8 \u0dd0\u0dcf\u0dd0 \u0d9a\u0dd2 \u0d9a\u0dc0 \u0dc0\u0da7\u0dc0 \u0d9a \u0d9a\u0dd2 \u0db1\u0dca \u0dd0\u0dcf\u0dd0. \u0db8\u0dd4 \u0d9a \u0d85\u0db4\u0dd2 \u0d9a \u0dc0 \u0dbd\u0dd2\u0db1\u0dca \u0d92 \u0db7\u0dc0\u0dc2\u0dca\u0da8\u0da7\u0dc1\u0dda \u0db1\u0dd2\u0daf\u0dcf\u0dc1 \u0d85\u0dd4\u0dad\u0dad\u0dd4 \u0dc1\u0d9a\u0dc1 \u0db7\u0dc0\u0daf\u0dd4\u0dad \u0dba\u0db8\u0dd2\u0db1\u0dca \u0d85\u0dc1\u0dad\u0dba \u0dc1\u0db8\u0dc0\u0da2\u0dcf\u0db1\u0dad \u0dba \u0da7\u0dca\u0da7\u0dd2 \u0da7 \u0d85\u0db4\u0dd2 \u0d9a\u0dd2 \u0dc0\u0dc0, \u0d94\u0dc1\u0dcf\u0ddc\u0db8 \u0dc1 \u0ddc\u0dc1\u0dc0\u0dba\u0dd2 \u0dc1 \u0ddc\u0dc1\u0dcf\u0ddc\u0db8 \u0d9a\u0dd2\u0dda\u0dc0 \u0d9a \u0db8\u0dbd\u0dca\u0db6\u0dbd\u0da7 \u0da2\u0dcf \u0dc0\u0db0\u0dd2\u0db4\u0dd2 \u0dc1\u0db8\u0dc0\u0dc0 \u0dcf\u0db4\u0dad \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dd0\u0dcf\u0dd0 \u0d9a\u0dd2 \u0d9a\u0dc0. \u0d92 \u0d85\u0daf\u0dc0\u0dc5 \u0dc0\u0dc5\u0dd2 \u0dc0\u0dc0 \u0d92 \u0da7 \u0db4\u0dad \u0d94 try \u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0da2\u0dcf \u0dc0\u0db0\u0dd2\u0db4\u0dd2 \u0dc1\u0db8\u0dc0\u0dc0 \u0dd2\u0dbd\u0dca\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dd2 \u0dc1 \u0dc0\u0dc0. \u0d85\u0dc1\u0db4\u0dca \u0db4\u0dd4\u0dda\u0db1\u0d9a \u0db1\u0dca \u0dd2\u0d9a\u0d9a\u0dca \u0dba\u0d9a\u0dc0, \u0d85\u0dc1\u0db4\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 target \u0dba\u0d9a\u0dc0 \u0d85\u0dc1\u0dad\u0dba \u0dbb\u0dd4\u0dd4\u0db8 \u0dc0\u0db4\u0dd4\u0dba \u0d91\u0dc1 \u0db1\u0dca \u0d94 \u0dc1\u0dda \u0db8\u0dbd\u0dca\u0db6\u0dbd\u0da7 \u0da2\u0dcf \u0dc0\u0db0\u0dd2\u0db4\u0dd2 \u0dc1\u0db8\u0dc0\u0dc0 \u0dcf\u0db4\u0dad \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dd0\u0dcf\u0dd0 \u0d9a\u0dd2 \u0dc0\u0dba\u0da7\u0dc0\u0dc0 \u0d9a\u0dd2 \u0db1\u0dca \u0da7 \u0d95 \u0dd1."
  },
