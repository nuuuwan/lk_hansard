    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dba \u0dc0\u0dba \u0dc1\u0db7\u0dc0\u0db4\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0dd2 \u0db1\u0dd2, \u0dc1\u0db4\u0dad \u0db4 \u0d9a \u0dc1 \u0db8\u0dca\u0db4\u0dad\u0db4\u0dad \u0dca\u0d9f\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0da2 \u0dad\u0dc0\u0dc0\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc0\u0dc4 \u0dc1\u0dc1\u0dda\u0dc0 \u0dc1\u0db4\u0dad\u0db4\u0dc0\u0daf \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0d9c\u0dd0 \u0dc0\u0dc0\u0dc1\u0dda\u0dca, \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc0\u0dc4 \u0dc1\u0dc1\u0dda\u0dc0\u0dc0\u0dc0 \u0db7\u0dc0\u0daf\u0dd4\u0dad \u0dba \u0da2 \u0dad\u0dc0\u0dc0\u0dc1\u0dda \u0d86\u0dba \u0dc2\u0dca\u0da8\u0dc0\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2 \u0db3\u0dc0 \u0d9a \u0dc0\u0dd0\u0da9\u0dd2 \u0d85\u0dc0)\u0dc0 \u0dc1 \u0dc0\u0db8\u0dd4 \u0dba\u0d9a\u0dc0 \u0dd2\u0dc1 \u0dc0\u0dc06 \u0dc1\u0db4\u0dad \u0dc0\u0dba\u0da7 \u0dc0\u0dc1\u0dba 30 \u0da7 \u0db6\u0dbd\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dd0\u0dc0\u0dad\u0dd4\u0db8\u0dcf\u0dab\u0dd4 \u0db4 \u0dc1 \u0d9a \u0dc1\u0db3\u0dc4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1 \u0dc0\u0dc0\u0dd4\u0da7 \u0d9a, \u0dc1\u0db4\u0dad \u0db4 \u0d9a \u0dc1 \u0db8\u0dca\u0db4\u0dad\u0db4\u0dad\u0da7 \u0d87\u0dad\u0dd4\u0db8\u0dcf\u0dc5 \u0d9a \u0dba\u0d9a\u0dc0 \u0dd2\u0dc1 \u0dc0\u0dc06 \u0dca\u0dc4 \u0da2 \u0dad\u0dc0\u0dc0\u0da7 \u0dc0\u0da9\u0dc0 \u0dd4\u0dc0\u0dba \u0dd2\u0dad \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc0\u0dc4 \u0dc1\u0dc1\u0dda\u0dc0 \u0d8b\u0daf\u0dc0 \u0dba\u0daf\u0dd3\u0dca \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0db4\u0dad \u0db4 \u0d9a \u0dc1 \u0db8\u0dca\u0db4\u0dad\u0db4\u0dad\u0da7 \u0d85 \u0daf \u0d9a \u0dc1 \u0ddd\u0da2 \u0dc0 \u0d9a\u0dd2 \u0db4\u0db4 \u0dca \u0d87\u0dad\u0dd4\u0db8\u0dcf\u0dc5 \u0d9a \u0dba\u0d9a\u0dc0 \u0dd2\u0dc1 \u0dc0\u0dc06 \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0dca\u0dc4\u0da2 \u0d86\u0dba \u0dc2\u0dca\u0da8\u0dc0\u0dc0 \u0dc1\u0dc4 \u0db4\u0dc4\u0dd4\u0dc0\u0dc0 \u0dd4\u0dc0\u0dba \u0dd2\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0dc1\u0db3\u0dc4\u0dc0 \u0dc1 \u0dc0\u0db8\u0dd2\u0dc2\u0dca\u0da8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0db7\u0dc0\u0dc1\u0dda \u0daf\u0dd4\u0db0\u0dd2\u0daf\u0dd4)\u0dc0 \u0dc0\u0d9a\u0da7 \u0d85\u0db1\u0dd4\u0dbd\u0dc0\u0d9a\u0dc0 \u0db4\u0dc0 \u0d9a\u0dc0\u0dc0\u0dc1\u0d9c \u0dc0 \u0dc4\u0dd0\u0d9a\u0dd2 \u0d85\u0dc0\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dd2\u0dc0\u0d9a\u0da7 \u0d85\u0db1\u0dd4\u0dbd\u0dc0\u0d9a\u0dc0\u0dd3\u0dca \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0daf\u0dd4\u0db0\u0dd2\u0daf\u0dd4)\u0dc0 \u0dc1\u0d9a\u0dc1\u0dda\u0dc0\u0dc0 \u0daf\u0dd3\u0d9a\u0dc0 \u0dd2\u0dc1 \u0dc0\u0dc06\n\n\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dba \u0dc0\u0dba \u0dc1\u0db7\u0dc0\u0db4\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0dd2 \u0db1\u0dd2, \u0daf\u0dac\u0dd4\u0dc0\u0dca \u0dc1\u0dc4 \u0d85\u0db7\u0dd2 \u0dc0 \u0dc0 \u0d9a\u0dd2\u0dbb\u0dd3\u0dca\u0da7 \u0d85\u0daf\u0dc0\u0dc5\u0dc0 \u0d9a \u0dc1\u0db4\u0dad \u0db4 \u0d9a \u0dc1 \u0db8\u0dca\u0db4\u0dad\u0db4\u0dc1 \u0d9a \u0dd4\u0dc0\u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8 \u0d85\u0dc0\u0dc1\u0dda\u0dcf\u0dc0 \u0dc1\u0db4\u0dad\u0db4\u0dc0\u0daf \u0dba\u0d9a\u0dc0 \u0dd2\u0dc1 \u0dc0\u0dc06 \u0dc1\u0dca \u0db4 \u0dd2\u0dc1 \u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8 \u0d9a\u0dc0 \u0dc1\u0db4\u0dad \u0db1\u0dca6 \u0db4\u0dad \u0dc0\u0dba\u0daf \u0dc1\u0db3\u0dc4\u0dc0 \u0dc0 \u0d85\u0dc0\u0dca \u0daf\u0da9 \u0db8\u0dd4\u0daf\u0d9a \u0dbb\u0dd4\u0db4\u0dd2 \u0dda 250,000 \u0daf \u0dc0\u0dc0 \u0dc0\u0dd0\u0da9\u0dd2 \u0dba \u0d87\u0dd2 \u0d85\u0dad\u0dba, \u0d8b\u0db4\u0dbb\u0dd2\u0dca \u0daf\u0da9 \u0dbb\u0dd4\u0db4\u0dd2 \u0dda 500,000 \u0dc0 \u0dc0\u0dc06 \u0d92 \u0dc0\u0dc0\u0dc1\u0dda\u0dca \u0dc0\u0dc1\u0dba 5 \u0da7 \u0dc1 \u0dc0\u0dc0\u0dd0\u0da9\u0dd2 \u0db1\u0dca\u0dba \u0daf\u0dac\u0dd4\u0dc0\u0dca \u0dc1\u0dc4\u0ddd \u0dc1\u0db4\u0dad \u0dc1\u0daf \u0dca \u0db4\u0dd0 \u0daf\u0dd4 \u0dc4\u0dd0\u0d9a\u0dd2 \u0dc1\u0d9a\u0dc1 \u0dc1\u0dca \u0dc1\u0dcf\u0dc1 \u0ddd) \u0dba \u0dd2\u0dc1 \u0dc0\u0dc06\n\n\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dba \u0dc0\u0dba \u0dc1\u0db7\u0dc0\u0db4\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0dd2 \u0db1\u0dd2, \u0d85\u0db4\u0dd2 \u0dc1\u0db4\u0dad \u0db1\u0dd3\u0dd2 \u0dc1\u0db4\u0dad\u0db4\u0dc0\u0daf \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d85\u0dc1\u0dda \u0dc2\u0dca\u0da8\u0dc0 \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0da2 \u0dad\u0dc0\u0dc0\u0da7 \u0dd4\u0dc0\u0dba \u0dd2\u0dad \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc0\u0dc4 \u0dc1\u0dc1\u0dda\u0dc0 \u0dc4\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dca\u0dd0\u0daf\u0dd2\u0dc4 \u0d9a \u0dc1\u0dc0\u0db8\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dad\u0dc0\u0dbd\u0dd2\u0dba\u0da7 \u0d9a \u0d92 \u0dc1\u0dc1\u0dda\u0dc0\u0dc0\u0dc0\n\n2085 2086\n\n\u0db4\u0dc0\u0dbb\u0dca\u0db6\u0dbd\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dd4\u0db8\u0dcf\u0dc0"
