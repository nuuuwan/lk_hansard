    "chunk_text": "\u0d91\u0daf\u0dcf \u0db6\u0dd2\u0dba\u0d9c\u0db1 \u0d86\u0dc3\u0db1 \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0dba\u0dae\u0dc0\u0dbb\u0dba\u0dcf \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7, \u0dd0\u0daf\u0d9a\u0dd3\u0dbb\u0d9a\u0dca\u0dad\u0dc2\u0dcf \u0dae\u0da7\u0dba\u0dd4\u0dd4 \u0d85\u0db1\u0dcf\u0dad\u0dba\u0dc0\u0dbb\u0dba\u0dcf \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dae\u0da7\u0dba\u0dd4\u0dd4 \u0dae\u0dc5 \u0dbb\u0db1\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db1\u0dc3\u0dd2\u0d82\u0dc4 \u0db6\u0dd2\u0dba\u0d9c\u0db1 \u0d86\u0dc3\u0db1\u0dc1\u0dda \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dc1\u0d9c\u0db1 \u0dd2\u0dba \u0dc3\u0db4\u0dd4\u0d9c\u0dc3\u0dca\u0dae\u0db1\u0dca\u0dad\u0dc1\u0dda \u0db6\u0da7\u0dbd\u0db1\u0dca\u0dad\u0daf \u0dc0\u0db0\u0dae\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\u0da7 \u0db1\u0dcf\u0dba\u0dae\u0dad\u0dca\u0dc0\u0dba \u0daf\u0dd4 \u0db1\u0dca\u0dad\u0db1\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1 \u0db1 \u0d85\u0dc1\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0daf\u0dd2\u0dc3\u0dca\u0dd2\u0d9a\u0dca\u0dad\u0dae\u0dc0\u0dbd \u0dd2\u0dbb\u0da7\u0db4\u0dd4 \u0d9c\u0dc4\u0dc5\u0dba\u0db1\u0dca\u0dad \u0d92 \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1\u0dc0\u0dca \u0d92 \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dc0\u0dbd \u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dc0\u0db0\u0dae\u0dcf\u0d9c\u0dcf\u0dbb\u0dc0\u0dbd\u0da7 \u0db1\u0dcf\u0dba\u0dae\u0dad\u0dca\u0dc0\u0dba \u0daf\u0dd4 \u0db1\u0dca\u0dad\u0db1\u0dcf. \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0dad\u0db1\u0dba\u0dd2 \u0d92\u0dc0\u0dcf\u0da7 \u0d85\u0dc0 \u0dba \u0db1\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0dc0\u0dd3\u0db1 \u0dae\u0dc1\u0dc5\u0dca. \u0d91\u0dc1\u0dc4\u0db1 \u0dc0\u0db0\u0dae\u0dcf\u0d9c\u0dcf\u0dbb \u0dae\u0db3\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9c\u0dab\u0db1\u0dcf\u0dc0\u0d9a\u0dca\u0dad \u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0db1\u0dcf\u0dad\u0dbb \u0d91\u0dc5\u0dd2\u0dba\u0dae\u0db1\u0dca\u0dad\u0dc1\u0dda \u0d91\u0dc1\u0dc4\u0db1 \u0d91\u0dae\u0d9a\u0dca\u0dad, \u0db4\u0dd0\u0dbd\u0dc0\u0dad\u0dca\u0dc1\u0dad\u0dca \u0d91\u0dc1\u0dc4\u0db1 \u0d91\u0dae\u0d9a\u0dca\u0dad, \u0d87\u0db9\u0dd2\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dc1\u0dda \u0da2\u0dcf\u0dd2\u0dae \u0db4\u0dcf\u0dc3\u0dbd \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da7 \u0db1\u0dc4\u0dc0\u0dd0\u0dd2 \u0db1\u0dd2\u0dbd \u0db1\u0dd2\u0dc0\u0dcf\u0dc3\u0dc1\u0dda"
  },
