    "chunk_text": "\u0dc4\u0dba\u0dd0\u0db1\u0dca\u0dc3\u0dcf\u0da9\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0dc0\u0d9a\u0ddc\u0dc5\u0db9 5 \u0dc0\u0db4\u0ddc\u0dbd\u0dca\u0dc0\u0dc4\u0dba\u0dda\u0db1\u0dca\u0dc0\u0d9c\u0ddc\u0da9 \u0d9a\u0dd2\u0dd4\u0dc5\u0db4\u0db1 \u0db4\u0dcf\u0dbb \u0d85\u0dcf\u0d9a 163 \u0daf\u0dbb\u0db1 \u0dc3\u0db1\u0dae\u0dcf\u0db1\u0dc0\u0dba\u0dc4\u0dd2 \u0db4\u0dd2\u0dc4\u0dd2\u0dd2\u0dad\n\n\u0dbb\u0da2\u0dc0\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca \u0d9a\u0dad\u0dd2 \u0dc0\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc0\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dbb\u0dc0\u0dda \u0db4\u0dd2\u0dc4\u0dd2\u0dd2\u0dad \u0dbb\u0da2\u0dc0\u0dda \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dca\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dc1\u0dca\u0dc0\u0dba\u0db1\u0dca\n\n\u0db8\u0dd2\u0dbd \u0daf\u0dd3 \u0d9c\u0dad \u0dc4\u0dba\u0dd0\u0d9a.\n\n\u0dc0\u0db8\u0db8 \u0dc4\u0dba\u0dd0\u0db1\u0dca\u0dc3\u0dcf\u0da9\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0 www.parliament.lk \u0dc0\u0dc0\u0dda \u0d85\u0da9\u0daf\u0dd4\u0dc0\u0dba\u0db1\u0dca\n\n\u0db6\u0dcf\u0d9c\u0dad \u0dc4\u0dba\u0dd0\u0d9a.\n\n\u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95 \u0ba4\u0b95\u0bb5\u0bb2\u0bcd \u0ba4\u0bbf\u0b95\u0bc8\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95 \u0ba4\u0bb5\u0bb3\u0bbf\u0baf\u0bc0\u0b9f\u0bc1\u0b95\u0bb3\u0bcd \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd\n\n\u0baa\u0bc8\u0bae\u0bcd \u0ba4\u0b9a\u0bb2\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0baa\u0bcd \u0ba4\u0baa\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0bb2\u0bbe\u0bae\u0bcd.\n\n\u0b87\u0ba8\u0bcd\u0ba4 \u0bb9\u0ba9\u0bcd\u0b9a\u0bbe\u0b9f\u0bcd \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0b95\u0b95\u0baf www.parliament.lk \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0b87\u0b95\u0bc8\u0baf\u0ba4\u0bcd\u0ba4\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1\n\n\u0baa\u0ba4\u0bbf\u0