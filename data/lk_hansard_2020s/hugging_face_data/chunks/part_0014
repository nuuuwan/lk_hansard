    "chunk_text": "\u0d92 \u0dc0\u0dc0\u0dc1\u0dda\u0dca \u0dca\u0dca \u0d85\u0dba \u0d9a\u0dd2\u0dda\u0dc0\u0dc0 \u0dc0\u0dc0\u0dc1\u0dda \u0dc1\u0db4\u0dad \u0db4 \u0d9a \u0dc1 \u0db8\u0dca\u0db4\u0dad\u0db4\u0dc1 \u0d9a , 5, 10, 12, 38 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2 \u0dc4\u0dba\u0dc4\u0dc0 \u0db1\u0dd2 \u0dc0\u0dca \u0dc0\u0dbb\u0dca \u0dd2\u0dc2\u0dca\u0da8\u0dda\u0da7 \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0dc1\u0db3\u0dc4\u0dc0 \u0dc1\u0db4\u0dad \u0dc1 \u0dc0\u0db8\u0dd2\u0dc1\u0dca\u0da7 \u0d9a \u0d9a \u0dc0 \u0dc1\u0daf \u0dc0\u0dc06 \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0da2\u0dc0\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0db4 \u0d9a\u0dd2 \u0dc1\u0dd0 \u0dc3\u0dd3\u0dca\u0da7, directives \u0d9a \u0dc0 \u0daf\u0dd3\u0dca\u0da7, \u0dc1\u0dba\u0d9c\u0dd4\u0d9a\u0dc0\u0db1\u0dca \u0dc1 \u0dc1\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0dca\u0da7, \u0dad\u0dc0 \u0dc2\u0dca\u0da8\u0da7 \u0dca\u0d9f\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb apps \u0dc0\u0dd0\u0db1\u0dd2 \u0dc1\u0dda\u0dc0\u0dda \u0dc4\u0dba\u0dc4\u0dc0 \u0db1\u0dca\u0dda) \u0dc1\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc0\u0dc4 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca) \u0da7 \u0dc0\u0dc0\u0dc1\u0dda\u0dca \u0db1\u0dd2 \u0dc0\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dca\u0da7, \u0dc1\u0dda \u0dba\u0dcf \u0d87\u0dad\u0dd4\u0db8\u0dcf\u0dc5\u0dd4 \u0dc1\u0db4\u0dc0\u0dbd\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc0\u0dc4 \u0dc1\u0dda \u0dc1 \u0dc1\u0daf \u0d85\u0dc1 \u0da7 \u0d9a \u0dba\u0dcf\u0dc0\u0d9a \u0db8\u0dd2\u0d9a \u0d9c\u0da7\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb - fees - \u0db1\u0dd2 \u0dc0\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dca\u0da7, permits \u0d9a \u0dc0 \u0daf\u0dd3\u0dc1\u0db4\u0dad\u0daf\u0dd3 \u0db4\u0dad \u0d9a\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dbb\u0dca\u0da7\u0dc0 \u0dc1\u0d9a \u0dc0 \u0d9a\u0dc0 \u0d9a \u0dc0 \u0daf\u0dd3\u0dca\u0da7 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf \u0dd6 \u0daf\u0dc0 \u0db4\u0dad \u0dba\u0d9a\u