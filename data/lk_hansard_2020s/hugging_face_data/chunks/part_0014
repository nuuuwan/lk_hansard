    "chunk_text": "\u0d92 \u0dc1\u0dc0\u0db1\u0dd4\u0dc0\u0da7 \u0dc1\u0db8\u0dcf\u0d9a\u0daf \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb? \u0dc1 \u0ddd\u0daf \u0dc1 \u0ddd\u0daf\u0dcf \u0db8\u0dc1\u0dcf \u0daf\u0db8\u0dc3\u0dc0\u0dcf \u0dc0\u0dcf\u0dc1 \u0d91\u0d9a\u0db8 \u0db8\u0da9 \u0da7\u0dd2\u0d9a \u0d9c \u0dc3\u0dc0\u0dcf, \u0dc1\u0db8\u0db1 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0db1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dd4\u0dc0 \u0d87\u0dad\u0dd4\u0dc1\u0dc5\u0dda. \u0dc1\u0db8\u0db1 \u0da2\u0dc3\u0dad\u0dcf\u0dc0\u0dc1 \u0d9a\u0dcf\u0dbd\u0dca. \u0dc1\u0db8\u0db1 \u0da2\u0dc3\u0dad\u0dcf\u0dc0\u0dc1 \u0d85\u0dc0 \u0dba\u0dad\u0dcf\u0dc0. \u0d85\u0dbb \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dca\u0d9a \u0db8 \u0dda\u0dad\u0dca\u0dcf \u0dbb \u0dc1\u0dca \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dca \u0d9c\u0dd0\u0dc3 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0dc3\u0dc0\u0dcf, \u0d9a\u0dcf\u0dbd\u0dca \u0d9c\u0dd0\u0dc3 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0dc3\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0d9a \u0dca\u0dc3\u0dc0\u0dcf, \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0dcf \u0dc1\u0db8\u0db1 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0db1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dd4\u0dc0 \u0d87\u0dad\u0dd4\u0dc1\u0dc5\u0dda \u0d85\u0daf\u0dcf\u0dc5 \u0db8\u0dcf\u0dad\u0dd8\u0d9a\u0dcf\u0dc0 \u0d9c\u0dd0\u0dc3 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0dc3\u0dca \u0d91\u0d9a \u0daf\u0dc0\u0dc3\u0d9a\u0dca \u0d9a \u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3. \u0d85\u0daf\u0dcf\u0dc5 \u0db8\u0dcf\u0dad\u0dd8\u0d9a\u0dcf\u0dc0 \u0d9c\u0dd0\u0dc3 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0dbd\u0dcf \u0dc3\u0dd0 \u0dd0, \u0d91\u0d9a \u0daf\u0dc0\u0dc3\u0d9a\u0dca\u0dc0\u0dda \u0d91\u0d9a \u0daf\u0dc0\u0dc3\u0d9a\u0dca \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0dbd\u0dcf \u0dc3\u0dd0 \u0dd0. \u0dc1\u0db8\u0db1 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0db1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dd4\u0dc1\u0dda \u0d9a\u0dcf\u0dbd\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0d95\u0dc3\u0dd1 \u0dd2\u0db6\u0db0\u0dd2\u0dca\u0da7 \u0d85\u0dc3\u0dc0 \u0dba \u0dd2\u0db6\u0db0\u0dd2\u0dca\u0da7 \u0dc3\u0dcf\u0dc3\u0dda\u0dad\u0dd2 \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0dbd\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb. \u0d91\u0dc1 \u0db8 \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dca\u0d9a \u0dbb\u0dcf\u0da2\u0dba \u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3 \u0dbd\u0dd0 \u0dd0 \u0db8 \u0dda\u0dad\u0dc1\u0dca\u0ddd. \u0d94\u0dc1 \u0dcf\u0db8 \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dca\u0d9a \u0dbb\u0dcf\u0da2\u0dba \u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3 \u0dbd\u0dd0 \u0dd0. \u0d92\u0dc0\u0dcf \u0dc4\u0dd3\u0dc3 \u0dd2\u0db6\u0dad\u0dbb\u0db1\u0dca. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dbd\u0dcf\u0dc1 \u0d94\u0dca \u0dc5\u0daf\u0dd4\u0dc0 \u0db8\u0dcf\u0dc3\u0dc3\u0dd2\u0d9a\u0dda\u0dc0\u0dca \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dca\u0dcf\u0dc1\u0d9c\u0dc3 \u0d89\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3 \u0d9a \u0dca\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dbd\u0dcf\u0da7 \u0d9a \u0dca\u0dc3\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0d85\u0dc1 \u0d9c\u0db8\u0dc3 \u0dca\u0dc3\u0dc0\u0dcf. \u0d85\u0dc1 \u0d9c\u0db8\u0dc3 \u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3 \u0d85\u0db4\u0dd2 \u0dd6 \u0daf\u0dcf\u0dc3\u0db8\u0db1. \u0d92\u0d9a\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5 \u0daf\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0dbd\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb.\n\n1425 1426\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0db1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dd4\u0dc0"
  },
