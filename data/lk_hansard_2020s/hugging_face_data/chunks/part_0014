    "chunk_text": "1978\u0daf\u0dd3 \u0dc4\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0dbb\u0ddc\u0da2\u0db0\u0ddc\u0db1\u0dd2\u0dc1\u0dda \u0d86\u0dc1 \u0ddd\u0da2\u0d9a\u0dc1 \u0d9a\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0d86\u0dbb\u0dda\u0db7 \u0d9a\u0dbb\u0db4\u0dd4 \u0d9a\u0dbb\u0dca\u0db8\u0ddc\u0db1\u0dca\u0dad\u0dad \u0ddc\u0dbd\u0ddc\u0dc0\u0d9a\u0dca \u0d85\u0daf \u0db8\u0dd4\u0dc5\u0dd4\u0db8\u0db1\u0dd2\u0db1\u0dca\u0dad\u0db8 \u0dc0\u0dd0\u0dc4\u0dd2\u0dbd\u0ddc 2,000\u0d9a \u0db4\u0dd2\u0dd2\u0db4\u0dc3\u0d9a\u0dca \u0db8\u0dc4 \u0db4\u0ddc\u0dc1\u0dbb\u0dca \u0db8\u0db8 \u0dc1\u0db4\u0db1\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0dc4\u0daf\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dc1\u0dda\u0d9a\u0dba\u0dd2 2028\u0daf\u0dd3 \u0dab \u0d86\u0db4\u0dc0\u0dd2 \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0d85\u0db4\u0dd2 \u0db6\u0dd0\u0db3\u0dd2\u0dbd\u0ddc \u0dd4\u0db1\u0dca\u0dad\u0db1\u0dc0\u0ddc \u0d92 \u0dc3\u0db3\u0dc4\u0ddc \u0dc3\u0dd2 \u0da7 5\u0d9a \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc1\u0dda\u0d9c \u0d9a\u0dca \u0db1\u0da9\u0dad\u0dca\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0ddc \u0d92\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0daf, \u0d9a\u0dbb\u0dca\u0db8\u0ddc\u0db1\u0dca\u0dad\u0dad \u0ddc\u0dbd\u0ddc \u0dc0\u0dd0\u0dc1\u0dc4\u0db1\u0dc1\u0d9a\u0ddc\u0da7? NEXT \u0d9a \u0db1 \u0d9a\u0dbb\u0dca\u0db8\u0ddc\u0db1\u0dca\u0dad\u0dad \u0ddc\u0dbd\u0ddc\u0dc0 \u0dc0\u0dd0\u0dc4\u0dd2\u0dbd\u0ddc \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0ddc 2,000\u0d9a \u0db4\u0dd2\u0dd2\u0db4\u0dc3\u0d9a\u0dca \u0db8\u0dc4 \u0db4\u0ddc\u0dc1\u0dbb\u0dca \u0dc4\u0daf\u0ddc \u0d87\u0d9f\u0dbd\u0dd4\u0dda \u0d9a\u0dda\u0dc4\u0dbd\u0dca 200 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0d86\u0dbb\u0dda\u0db7 \u0d9a\u0dbb\u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0d92\u0dc0\u0ddc \u0d86\u0dbb\u0dda\u0db7 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \