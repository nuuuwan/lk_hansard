    "chunk_text": "\u0d8a\u0dc5 \u0da7, \u0da2\u0dc0\u0dd2\u0dc1\u0db4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0d9d\u0dcf\u0dad\u0db1\u0dba \u0dae\u0dbb\u0db1 \u0dbd\u0daf \u0dbd\u0d82\u0dae\u0dcf \u0dc3\u0db1\u0dc3\u0db1\u0dcf\u0da2 (\u0dbd\u0dc3\u0dc3\u0db4) \u0db4\u0d9a\u0dca\u0dad\u0dc2\u0dc1\u0dda \u0dc3\u0dcf\u0db1\u0dcf\u0da2\u0dd2\u0dae \u0dbd\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dd4\u0dc0 \u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc3\u0db1\u0dc3\u0db1\u0dcf\u0da2 \u0db4\u0d9a\u0dca\u0dad\u0dc2\u0dc1\u0dda \u0dc3\u0dcf\u0db1\u0dcf\u0da2\u0dd2\u0dae\u0dba\u0db1\u0dca\u0dad 22\u0d9a\u0dca\u0dad \u0d9d\u0dcf\u0dad\u0db1\u0dba \u0dc1\u0dc0\u0db1\u0dc0\u0dcf.\n\n\u0d8a\u0dc5 \u0dbd\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dd4\u0dc0, \u0dad\u0db1\u0dba\u0dd2 \u0da2\u0dc0\u0dd2\u0dc1\u0db4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0d9d\u0dcf\u0dad\u0db1\u0dba \u0dae\u0dbb\u0db1 \u0dbd\u0daf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0dae\u0dcf \u0db1\u0dc4\u0da2\u0db1 \u0db4\u0d9a\u0dca\u0dad\u0dc2 \u0dc3\u0dcf\u0db1\u0dcf\u0da2\u0dd2\u0dae\u0dba\u0dd2\u0db1\u0dca\u0dad\u0dc1 \u0dbd\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dd4\u0dc0. \u0db1\u0dc4\u0da2\u0db1 \u0db4\u0d9a\u0dca\u0dad\u0dc2\u0dc1\u0dda \u0dc3\u0dcf\u0db1\u0dcf\u0da2\u0dd2\u0dae\u0dba\u0dd2\u0db1\u0dca\u0dad 141 \u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dd4 \u0d9d\u0dcf\u0dad\u0db1\u0dba \u0dc0\u0db1\u0dc0\u0dcf. \u0d92 \u0dc1\u0dad\u0dcf\u0dbb\u0dd4\u0dbb\u0dd4 \u0d87\u0dd4\u0dc5\u0dad\u0dca \u0dbd\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dd4\u0dc0\u0d9a\u0dd4\u0dad\u0dca \u0dc1\u0db1\u0dad\u0dd0\u0db1 \u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf.\n\n\u0d92 \u0dc0\u0dcf\u0dc1 \u0db1, \u0da2\u0dc0\u0dd2\u0dc1\u0db4 \u0d85\u0dd2\u0db1\u0dca\u0dad \u0d9d\u0dcf\u0dad\u0db1\u0dba \u0dc0\u0dd6 \u0db7\u0dd2\u0d9a\u0dca\u0dad\u0dd6\u0db1\u0dca\u0dad \u0dc0\u0dc4\u0db1\u0dca\u0dad\u0dc1\u0dc3\u0dca\u0dbd\u0dcf \u0dc0\u0dd2 \u0dcf\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dab\u0dba\u0dae\u0dc1 \u0dbd\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dd4\u0dc0\u0d9a\u0dd4\u0dad\u0dca \u0dc1\u0db1\u0dad\u0dd0\u0db1 \u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0db1\u0dcf \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0dae\u0dc5 \u0d92 \u0dbd\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dd4 \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db1 1 \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dc1\u0dda \u0d85\u0dc0\u0dc3\u0dca\u0dcf\u0dcf\u0dc1\u0dc0\u0dca\u0daf\u0dd3 \u0dca\u0db7\u0dcf\u0d9c\u0dad* \u0dae\u0dbb\u0db1\u0dc0\u0dcf.\n\n\u0db8\u0dd2\u0dba \u0dd2\u0dba \u0d85\u0dba\u0dc1 \u0db1\u0dda \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca\u0dad \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2, \u0dc1\u0db6\u0ddd\u0dda\u0db6 \u0d91\u0dbd\u0dca\u0dbd \u0dae\u0dbb\u0db4\u0dd4 \u0dad\u0dd0\u0db1\u0dca\u0dad \u0d9c\u0dd0\u0db1 \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0dc1\u0dbd\u0dca\u200d\u0db1\u0dad\u0dca \u0d85\u0dc1\u0dda \u0d9c\u0dbb\u0dd4 \u0db1\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dbb\u0dd4 \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0d85\u0dc0\u0dc3\u0dca\u0dcf\u0dcf\u0dc0\u0dbd\u0daf\u0dd3 \u0dc3 \u0dcf\u0d9c\u0dad \u0dae\u0dbb\u0db1\u0dc0\u0dcf.\n\n\u0d92 \u0dc0\u0dcf\u0dc1 \u0db1, \u0db1\u0dcf\u0dad\u0dc1\u0dbd\u0dca \u0daf\u0dd2\u0dc3\u0dca\u0dd2\u0d9a\u0dca\u0dad\u0dae\u0dc1\u0dda \u0d9d\u0dcf\u0dad\u0db1\u0dba \u0dc1\u0dc0\u0da0\u0dca 420\u0dc1\u0daf\u0db1\u0dcf\u0dc1\u0d9c\u0db1\u0dca\u0dad 171\u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dd4\u0dc1 \u0dc3\u0dc4 \u0db1\u0dc1 \u0d86\u0dc3\u0db1\u0dc1\u0dda \u0d9d\u0dcf\u0dad\u0db1\u0dba \u0dc1\u0dc0\u0da0\u0dca 98\u0dc1\u0daf\u0db1\u0dcf\u0dc1\u0d9c\u0db1\u0dca\u0dad 83\u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dd4\u0dc1 \u0db1\u0dda \u0daf \u0db1\u0db1 \u0d85\u0daf \u0dc3 \u0dcf\u0d9c\u0dad \u0dae\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0dcf\u0dc1\u0dbb\u0dcf\u0dad\u0dca\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf.\n\n\u0dc1\u0db1\u0dc1\u0dc4\u0db1 \u0d9d\u0dcf\u0dad\u0db1\u0dba \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0db1\u0da7 \u0dc1\u0dda \u0dc1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd \u0dca\u0dc0\u0dba\u0db1 \u0dae\u0dbb\u0db4\u0dd4 \u0dc0\u0dd0\u0dd0\u0daf\u0dda\u0daf \u0dc1\u0db1\u0dcf\u0dae\u0d9a\u0dca\u0dad\u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0dae \u0d85\u0daf \u0d85\u0db4\u0dd2 \u0db1\u0dd0\u0daf \u0d89\u0db3\u0dbd\u0dcf \u0dd2\u0dbb\u0dad\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1. \u0d91\u0dc1\u0dc4\u0db1 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda, \u0d91\u0dc4\u0dcf \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca \u0d89\u0db3\u0dbd\u0dcf \u0dc1\u0dda \u0db4\u0dd0\u0dad\u0dca\u0dad\u0da7 \u0d9c\u0dbd\u0dca \u0d9c\u0dd0\u0dc3\u0dd3\u0db1\u0dad\u0dca, \u0dc1\u0dda \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca \u0d89\u0db3\u0dbd\u0dcf \u0d91\u0dc4\u0dcf \u0db4\u0dd0\u0dad\u0dca\u0dad\u0da7 \u0d9c\u0dbd\u0dca \u0d9c\u0dd0\u0dc3\u0dd3\u0db1\u0dad\u0dca \u0dd4\u0dc5 \u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0dba \u0dc0\u0dd2\u0dc3\u0db3\u0dcf \u0d9c\u0db1\u0dca\u0dad\u0db1 \u0d85\u0db4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0dc0\u0db1\u0dc0\u0dcf\u0daf? \u0d92 \u0dae\u0dcf\u0dbb\u0dab\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d85\u0db4\u0dd2 \u0db1\u0dd0\u0daf \u0d89\u0db3\u0dbd\u0dcf \u0db6\u0dbd\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1. \u0db1\u0dd0\u0dc0\u0dad \u0dc0\u0dad\u0dcf\u0dc0\u0d9a\u0dca\u0dad \u0dc1\u0db1\u0dc0\u0dd0\u0db1\u0dd2 \u0dc1\u0dda\u0dc0\u0dbd\u0dca \u0dc1\u0db1\u0dcf\u0dc0\u0db1\u0dca\u0dad\u0db1\u0da7 \u0d85\u0dc0 \u0dba \u0dc1\u0dda\u0dc0\u0dbd\u0dca \u0dad\u0db1\u0dba\u0dd2 \u0d85\u0db4 \u0dae\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1.\n\n\u0d87\u0dad\u0dca\u0dad\u0da7\u0db1 \u0db1\u0db1 \u0dc1\u0dda \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0d85\u0dba \u0d9d\u0dcf\u0dad\u0db1\u0dba \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0db1\u0da7 \u0d91\u0dae\u0db1 \u0dc1\u0dc4\u0dca\u0dd4\u0dc0 \u0dc0\u0dd4\u0dc1\u0dab\u0dca \u0d89\u0db1\u0dca\u0dad\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dad \u0dbb\u0da2\u0dba \u0dc3\u0db1 \u0dae\u0da7\u0dba\u0dd4\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db1, \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0dc3 \u0dcf \u0d9a\u0dca\u200d\u0dbb\u0db1\u0dba \u0dc0\u0dd2 \u0dca\u0dc0\u0dcf\u0dc3 \u0d9a\u0dd2\u0dbb\u0dd3\u0db1, \u0db6\u0dbd\u0dba \u0dc1\u0db6\u0daf\u0dd3\u0db1 \u0dc0\u0dd2 \u0dca\u0dc0\u0dcf\u0dc3 \u0d9a\u0dd2\u0dbb\u0dd3\u0db1, \u0d91\u0dc1\u0dc4\u0db1 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda \u0db6\u0dbd\u0dc1\u0dda \u0dd2\u0dbb\u0da7\u0db4\u0dd4 \u0d91\u0d9a\u0dca\u0dad\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dd2\u0dae \u0db4\u0d9a\u0dca\u0dad\u0dc2\u0dc1\u0dda\u0dad\u0dca, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0dae\u0dcf \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0db4\u0d9a\u0dca\u0dad\u0dc2\u0dc1\u0dda\u0dad\u0dca \u0d86\u0dab\u0dca\u0dd4\u0db1\u0dc0\u0dbd\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0dda\u0db0\u0dc0 \u0dc0\u0dcf\u0db1\u0dcf\u0d82\u0dc1\u0dd2\u0dae \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1 \u0db6\u0dbd\u0dc1\u0dc0\u0dca\u0d9c\u0dba\u0d9a\u0dca\u0dad \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db1 \u0d9a\u0dd2\u0dba\u0db1 \u0dae\u0dcf\u0dbb\u0dab\u0dba\u0dba\u0dd2. \u0d9a\u0dd4\u0db1\u0db1 \u0db4\u0d9a\u0dca\u0dad\u0dc2\u0dba\u0d9a\u0dca\u0dad \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0db1\u0dba \u0dae\u0dc5\u0dad\u0dca, \u0d9a\u0dd4\u0db1\u0db1 \u0db1\u0dad\u0dba\u0d9a\u0dca\u0dad \u0daf\u0dd0\u0dbb\u0dd4\u0dc0\u0dad\u0dca \u0dc1\u0dda \u0d9d\u0dcf\u0dad\u0db1 \u0dc1\u0dda \u0dbb\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dad\u0db1\u0dca\u0dad\u200d\u0dbb\u0dc0\u0dcf\u0daf\u0dd3 \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1 \u0d85\u0dba\u0dd2\u0dd2\u0dba \u0dc1\u0dc0\u0dd4\u0dc0\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0db4\u0dba \u0dc3\u0dd2\u0da7\u0dd2 \u0db1\u0dd2\u0dc3\u0dcf \u0dc3\u0dd2\u0dda\u0db0 \u0dc0\u0dd4\u0dab\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0dae \u0dad\u0db1\u0dba\u0dd2 \u0db1\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dc1\u0dda \u0d9d\u0dcf\u0dad\u0db1 \u0dae\u0dc0\u0dd4\u0dbb\u0dd4 \u0d85\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dd4\u0dab\u0dad\u0dca \u0dc1\u0dda \u0dc1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd \u0dca\u0dc0\u0dc1\u0dba\u0db1\u0dca\u0dad\u0db1 \u0dbd\u0d82\u0dae\u0dcf\u0dc1\u0dc0\u0dca \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca\u0dad \u0dc3\u0dc4 \u0d89\u0db1\u0dca\u0dad\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dad \u0dc3\u0dcf\u0db1 \u0dc4\u0db8\u0dd4\u0daf\u0dcf\u0dc1\u0dc0\u0dca \u0dc1\u0dc3\u0dcf\u0dbd\u0dca\u0daf\u0dcf\u0daf\u0dd4 \u0dc0\u0db1\u0dca\u0dad \u0d9d\u0dcf\u0dad\u0db1\u0dba \u0dc0\u0dd4\u0dab\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0dae \u0db1\u0db1 \u0dc1\u0dda \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1\u0dc0\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1."
