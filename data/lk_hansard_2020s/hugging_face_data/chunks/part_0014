\u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad \u0dc3\u0dc4 \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad\u0db4\u0dd4\u0dbb \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1. \u0db1\u0db8\u0dd4 \u0d9a [\u0dc1\u0db4\u0dc4\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dc1\u0dda \u0d89\u0daf\u0dd2\u0d9a\u0dbb\u0db0\u0dba\u0db1 \u0dc4\u0daf\u0db1 \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad\u0db4\u0dd4\u0dbb[ \u0dc4\u0dd0\u0dc1\u0dbb\u0db0\u0dba\u0db1\u0da7 \u0dc1 \u0db1 \u0d9a \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda \u0d9a - \u0db1\u0dd2\u0d9a \u0dd0\u0dbb\u0da7\u0dd2[, [\u0dc1\u0dc4\u0db4\u0dc4\u0dd4 , \u0d9c\u0dbd\u0dca\u0d9c\u0db8\u0dd4 , \u0dc1\u0db4\u0dad[\u0dc1\u0db4\u0dc1\u0dc5 \u0dc1\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda \u0d9a - \u0db8\u0dc4\u0dc1 \u0db4\u0db4\u0dad\u0db8\u0dc1\u0da7 \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad \u0dc1\u0dc4\u0ddd \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad\u0db4\u0dd4\u0dbb \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0db1\u0dd2\u0dc3\u0dc1 \u0db8\u0db8 \u0d85\u0dc1\u0dda \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad \u0d85\u0db8\u0dc1\u0dad\u200d\u0dad\u0dd4\u0db8\u0dc1\u0dc1\u0d9c\u0db0\u0dba \u0d85\u0dc4\u0db1 \u0dc1, \u0d92 \u0d86\u0dbb\u0db4\u0dad\u0dbb \u0d9a\u0dbb\u0db0\u0dba\u0db1 [\u0db1 \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad[ \u0dad\u0db1\u0dd2 \u200d \u0dc3\u0dc1[\u0d9a\u0dc1[ \u0dc3\u0dc1\u0dda \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad[\u0d9a\u0dca\u0daf, \u0dc1\u0db1\u0dc1\u0d91\u0dc1\u0dc3\u0dda \u0db1\u0db4\u0dad \u200d \u0dc3\u0dc1[\u0d9a[\u0db0\u0dba \u0dc3\u0db8\u0dd6\u0dc4[\u0d9a\u0dca \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dbb \u0d9c \u0d9a\u0dad \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad[\u0d9a\u0dca\u0daf \u0d9a\u0dd2[\u0d9a\u0dc1.\n\n\u0dd9\u0dbb\u0dd4 \u0dc3\u0dd4\u0db1\u0dd2\u0dda \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0d9c\u0db1\u0dad\u0dca\u0dad\u0dd2 \u0db8\u0dc4\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b9a\u0bc1\u0ba9\u0bbf\u0bb2\u0bcd \u0bb9\u0ba8\u0bcd\u0ba4\u0bc1\u0ba9\u0bcd\u0ba4\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf) (The Hon. Sunil Handunnetti) \u0daf\u0dd0\u0db1\u0da7 \u0d92 \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad\u0db4\u0dd4\u0dbb[ \u0dc1[\u0ddd\u0da7\u0dbd\u0dad \u0dc1 \u0d9a\u0dc1 \u0dad\u0dd2\u0dc1 \u0db0\u0dba\u0dc1\u0db0\u0dba \u0d91\u0d9a \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad\u0d9a\u0dd4\u0dc0 \u0dc1\u0da7\u0dd2 . \u0d92 \u200d\u0dc1\u0db4\u0dca\u0dad\u0dd2[ \u0d89\u0dbd\u0dca\u0daf\u0dd9\u0db4\u0dad \u0d9a\u0dbb\u0d9a\u0dc1 \u0dad\u0dd2\u0dc1 \u0db0\u0dba\u0dc1\u0db0\u0dba \u0d91\u0d9a \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad\u0d9a\u0dd4\u0dc0 \u0dc1\u0dd2 . \u0d87 \u0d9a\u0dad\u0da7\u0db8 \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda \u0d9a \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1\u0d9a\u0dc1 \u0dc3\u0db8 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1[ \u0dad\u0db8\u0dd2 \u0dc1\u0dc3\u0dda \u0d9a[\u0db0\u0dba \u0db3 \u0dc1 \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0dc4 \u0db4\u0dca\u200d\u0dbb \u0dc1\u0dc4\u0db1[. \u0d92 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1 \u0db1\u0dd2\u0dc3\u0dc1 \u0db8\u0dc4\u0dc1 \u0db4\u0db4\u0dad\u0db8\u0dc1\u0da7 \u0db8\u0da7\u0dca\u0da7\u0dc1\u0db8\u0db0\u0dba \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad \u0dc3\u0db3\u0dc4\u0dc1 \u0d86\u0dc1[\u0ddd\u0da2\u0db1[ \u0d9a\u0dbb\u0db0\u0dba\u0db1 \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad\u0d9a\u0dd4\u0dc0 \u0db0\u0dba \u0d89\u0daf\u0dd2\u0db4\u0dad\u0db4 \u0d9a \u0dc1 \u0db0\u0dba\u0dc1\u0db0\u0dba \u0db1\u0dd0\u0dc4\u0dd0, \u0d9c\u0dd4\u0dc0 \u0d9a\u0dae\u0dc1\u0db1\u0dc1[\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0d92 \u0db1\u0dd2\u0dc3\u0dc1 \u0d85\u0db4\u0dd2 \u0daf\u0dd0\u0db0\u0dba \u0dad \u0d9a \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad\u0d9a\u0dd4\u0dc0 \u0db0\u0dba \u0d92 \u0dc3\u0db3\u0dc4\u0dc1 \u0d9a\u0dd0\u0db3 \u0dc1 \u0d9c\u0db0\u0dba\u0db1 \u0d85\u0dc1\u0db1 \u0dc3 \u0d9a chambers \u0d91\u0d9a\u0dca\u0d9a \u0d9a\u0dae\u0dc1 \u0d9a\u0dbb\u0db8\u0dd2\u0db0\u0dba \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dc1. \u0daf\u0dd0\u0db1\u0da7 \u0dc1[\u0ddd\u0da7\u0dbd\u0dad \u0d91\u0dc1\u0d9a\u0dca \u0d9a \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1 \u0daf\u0dd4 \u0dc1\u0d9a \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0da7[\u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1. \u0db1\u0db8\u0dd4 \u0d9a \u0d91\u0d9a \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad\u0d9a\u0dd4\u0dc0 \u0dc1\u0dd2 \u0daf\u0dd0\u0db1\u0da7 \u0d89\u0daf\u0dd2\u0db4\u0dad\u0db4 \u0d9a \u0dc1 \u0d9a\u0dc1 \u0dad\u0dd2\u0dc1 \u0db0\u0dba\u0dc1\u0db0\u0dba. \u0d9c\u0dd4\u0dc0 \u0db8\u0db0\u0dba\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0dc0 \u0dad\u0dd4\u0db8\u0db0\u0dba\u0d9a\u0dc1 \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad \u0db4\u0dca\u200d\u0dbb \u0dba\u0db7)\u0db1 \u0dc3\u0dbb\u0dc1 \u0db4\u0dd2\u0dc4\u0dd2\u0db8\u0dca \u0dc1, \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a \u0db8\u0da7\u0dca\u0da7\u0dc1\u0db8\u0db0\u0dba \u0d86\u0dc1[\u0ddd\u0da2\u0db1[ \u0d9a\u0dbb\u0db0\u0dba\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db0\u0dba \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad\u0d9a\u0dd4\u0dc0 \u0db0\u0dba \u0dc4\u0db3\u0dd4\u0db0\u0dba \u0dc1 \u0dc1\u0daf\u0db1 \u0dc1 \u0db1\u0db4\u0dad \u0d85\u0db4\u0da7 \u0d92 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1[ \u0db1\u0dd2\u0dbb\u0dc1\u0d9a\u0dbb\u0da7[ \u0d9a\u0dbb \u0d9c\u0db0\u0dba\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db0\u0dba. \u0daf\u0dd0\u0db1\u0da7 \u0dc4\u0daf\u0db0\u0dba\u0db1 [\u0db1 \u0d91\u0d9a \u0da7 \u0dc1[\u0ddd\u0da2\u0db1\u0dc1 \u0dc1 \u0d9a\u0dc1 \u0dad\u0dd2\u0dc1 \u0db0\u0dba\u0dc1\u0db0\u0dba \u0d91\u0d9a \u0d9a\u0dba\u0db7\u0db8\u0dc1\u0db0\u0dba\u0dad\u0d9a\u0dd4\u0dc0 \u0dc1\u0dd2 ."
