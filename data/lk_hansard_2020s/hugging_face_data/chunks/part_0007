dbb \u0dda\u0db1\u0dba \u0dba\u0da7\u0dc1\u0dad\u0dca \u0db8\u0db8 \u0d85\u0dc4\u0db1\u0dca\u0db8\u0dc1\u0db1\u0dca\u0db8 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0da0\u0d9a\u0dcf \u0dc1\u0dad\u0dca \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0dba \u0db4\u0dd2\u0dd2\u0d9c\u0db6\u0db3\u0dc0\u0dd2,. \u0d9c\u0dbb\u0dd4 \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0d9a\u0dca\u0d9a\u0dcf 2023 \u0dc0\u0dc3\u0dc1\u0dbb\u0dca\u0daf\u0dd3\u0dad\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0da0\u0d9a\u0dcf \u0dc1\u0dad\u0dca \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc5 \u0db6\u0dc0. \u0dc1\u0db8\u0dca \u0d85\u0dd4\u0dab\u0dbb\u0dd4\u0dda\u0dc1\u0dda\u0dad\u0dca \u0d92 \u0dc4\u0dcf \u0dc3\u0db8\u0dcf\u0db1\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0daf \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd2\u0dba\u0daf\u0db8\u0dca \u0d9a\u0dbb\u0db1 \u0dd4\u0daf\u0dbd \u0dc1\u0d9a\u0dcf\u0db4\u0db8\u0da7\u0daf?"
