    "chunk_text": "\u0dcf\u0dd0\u0db1\u0da7\u0db8\u0dad\u0dca \u0dc1\u0dad\u0dca \u0d9a\u0d9a\u0db8\u0dcf\u0dca \u0dad\u0dba \u0dca\u200d\u0dbb\u0db4\u0dcf\u0dad\u0dba\u0da7 \u0dd2\u0dc4\u0dc4\u0dd2\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db6\u0dc0 \u0d85\u0db4\u0dd2 \u0dcf\u0dca \u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0dcf\u0dca \u0db1\u0dcf \u0dad \u0db1\u0dca\u0dca \u0d91\u0dcf\u0dcf \u0dbd\u0dd0\u0dd4\u0dab\u0dd4 \u0dc1\u0dad\u0dca \u0db1\u0dd2\u0dc2\u0dca\u0da8\u0dae\u0db4\u0dcf\u0dcf\u0db1\u0dba \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dd2 \u0d85\u0dcf \u0dbd\u0dd0\u0dc1\u0db6\u0dca \u0dc1\u0dca . \u0dda\u0dc1\u0d86 \u0dc1\u0db4\u0dc1\u0d9a\u0dcf\u0dcf \u0db8\u0dcf\u0db0\u0dba \u0db8\u0d9f\u0dd2\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0d85\u0db4\u0dd2 \u0dcf\u0dd0\u0d9a\u0dca\u0d9a\u0dcf \u0dc1\u0dad\u0dca \u0d85\u0db4\u0db1\u0dba\u0db1\u0dba \u0d9a\u0dd2\u0dc1\u0dbd\u0ddd\u0d9c\u0dca\u200d\u0dbb\u0dd1 \u0dc3 \u0db1\u0dca\u0dbd\u0dd2\u0dba\u0db1 5 000\u0d9a\u0dca \u0d85\u0da9\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d85\u0db4\u0dd2 \u0d9a\u0dbd\u0dca\u0db4\u0db1\u0dcf \u0d9a \u0dbd\u0dcf \u0db6\u0dd0\u0dbd\u0dd4\u0dc1\u0dc0\u0ddc\u0dad\u0dca \u0dc1 \u0dc3\u0d9a \u0dc0\u0dd2\u0dc1\u0dda \u0dc0\u0dd2\u0db1\u0dd2\u0db8\u0dba \u0d85\u0dc0 \u0dba \u0dc1\u0dc0\u0dbd\u0dcf\u0dc0\u0d9a\u0dca; \u0dc1\u0dca\u0ddc\u0dbd\u0d9a \u0d85\u0dc0 \u0dba \u0dc1\u0dc0\u0dbd\u0dcf\u0dc0\u0d9a\u0dca. \u0d85\u0db4\u0da7 \u0dc1\u0dca\u0ddc\u0dbd\u0d9a \u0d85\u0dc0 \u0dba \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d85\u0dc0\u0dc3\u0dae\u0dae\u0dcf\u0dc0\u0d9a \u0dc1\u0dad\u0dca \u0d9a\u0d9a\u0db8\u0dcf\u0dca \u0dad\u0dba \u0dc1\u0db8\u0dc1\u0dc4\u0db8 \u0dca\u200d\u0dbb\u0db4\u0dcf\u0dad\u0dba\u0da7 \u0dba\u0dca \u0db1 \u0dd2\u0dc4\u0dc1\u0dba\u0ddc\u0dad\u0dca \u0dc1\u0db8\u0ddc\u0d9a\u0dcf \u0dc1\u0dc0\u0dca \u0dc1\u0dca ? \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dcf\u0dbb\u0dd2\u0dad\u0dca\u0dc0\u0dba\u0dd2 \u0dc0\u0dd2\u0dad\u0dca\u0dad\u0dd3\u0dba \u0dc3\u0db1\u0dca\u0dad\u0dd2\u0dd2 \u0d85\u0dad \u0dc1\u0db1\u0ddc\u0dc3\u0dca \u0dc3\u0dd4\u0dca \u0d9a\u0dcf\u0dbb\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dc0\u0dd4\u0dc1 \u0ddc\u0dad\u0dca \u0d9a\u0dad\u0dca \u0dc1\u0dad\u0dca \u0d9a\u0d9a\u0db8\u0dcf\u0dca \u0dad\u0dba\u0da7 \u0dc4\u0dd2\u0dad\u0d9a \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dd2 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0dca \u0db1\u0da7 \u0d95\u0db1\u0dd1.\n\n\u0d85\u0db4\u0dd2 \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0d9a\u0dca \u0d9a \u0dca \u0db1 \u0d9a\u0dd0\u0db8\u0dad\u0dd2\u0dd2 . \u0dcf\u0dd0\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0dc1\u0dca \u0dc0\u0dad\u0dd4 \u0db4\u0dc0 \u0dcf \u0d9c\u0dca \u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d9c\u0dbb\u0dd4 \u0d85\u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dcf\u0dad\u0dba\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dcf\u0da2\u0dba \u0dc0\u0dd0\u0dc0\u0dd2\u0dbd\u0dd2 \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dae\u0d9a \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0 \u0dba\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0dc1\u0dda \u0d82\u0dd2\u0d9a\u0dad\u0dca \u0dc3\u0dd2\u0dba\u0db9\u0dbd\u0dcf\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dba\u0da7\u0dc1\u0dad\u0dca \u0dc0\u0dd0\u0dc0\u0dd2\u0dbd\u0dd2 \u0dc3\u0db8\u0dcf\u0d9c \u0dc3 5\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dad\u0db8\u0dd2 \u0da2\u0db1\u0dad\u0dcf \u0dc0\u0dad\u0dd4 \u0dc3\u0d82\u0dc0\u0d9a\u0db0\u0db1 \u0db8\u0da9\u0dd4\u0dca\u0dbd\u0dba \u0da2\u0dba \u0dc0\u0dd0\u0dc0\u0dd2\u0dbd\u0dd2 \u0dc3\u0d82\u0dc3\u0dae\u0dae\u0dcf\u0dc0 \u0d87\u0dbd\u0dca\u0d9a\u0da9\u0dd4\u0dc0 \u0dc0\u0dd0\u0dc0\u0dd2\u0dbd\u0dd2 \u0dc3\u0db8\u0dcf\u0d9c\u0db8 \u0dc4\u0dbd\u0dcf\u0dc0\u0dad \u0dc0\u0dd0\u0dc0\u0dd2\u0dbd\u0dd2 \u0dc3\u0db8\u0dcf\u0d9c\u0db8 \u0d9a\u0dd4\u0dbb\u0dd4 \u0dd1\u0d9c\u0dbd \u0dc0\u0dd0\u0dc0\u0dd2\u0dbd\u0dd2 \u0dc3\u0db8\u0dcf\u0d9c\u0db8.\n\n\u0d89\u0dad\u0dd2\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0dc1\u0dca \u0d85\u0dc1\u0db1\u0d9a\u0dca \u0dc0\u0dd0\u0dc0\u0dd2\u0dbd\u0dd2 \u0dc3\u0db8\u0dcf\u0d9c \u0dc3\u0dc0\u0dbd\u0da7 \u0dca\u0dcf\u0d9a \u0dba\u0d9a\u0dca \u0dc1\u0dcf\u0dca \u0db1. \u0d85\u0db4\u0dd2 \u0dc1 \u0dc3 \u0dc3\u0db8\u0dcf\u0d9c \u0dc3 \u0db4\u0dc4 \u0dba\u0da7\u0dc1\u0dad\u0dca \u0dc0\u0dd0\u0dca \u0d9a \u0db1 \u0d9a \u0dc3\u0d9a\u0dbb\u0dd4\u0dc0\u0dca \u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 1 700\u0d9a \u0dc0\u0dd0\u0dd4\u0db8\u0dda \u0dc0\u0dd0\u0db1\u0db8 \u0dc0\u0dd3\u0db8\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0dc1\u0dcf\u0db1\u0dc0\u0dcf \u0db1\u0dd2\u0dc3\u0dcf \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dca \u0dbd\u0dcf\u0dad\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d9a \u0dca \u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d9a\u0dd2\u0dba\u0dca \u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0dc1\u0dca . \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dca \u0dbd\u0dcf\u0da7 \u0d91\u0dc1\u0dc4\u0db8 \u0d9a \u0dca \u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0d9a\u0db8\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0db8\u0ddc\u0d9a\u0dcf \u0dc0\u0dad\u0dd4 \u0dc3\u0db8\u0dcf\u0d9c \u0dc3 \u0d94\u0d9a\u0dca\u0dc1\u0d9a\u0ddd\u0db8 \u0db4\u0dcf\u0da9\u0dd4\u0dc0\u0da7 \u0dba\u0dca \u0dc1\u0dca . \u0dcf\u0dd0\u0dca \u0db8\u0db8 \u0dcf\u0dca \u0db1\u0dcf \u0dad \u0db1\u0dca\u0dca Elkaduwa Plantations Limited \u0dc0\u0dd2\u0dad \u0d9a\u0dca \u0dc1 \u0dc3 \u0dc0\u0dd0\u0dd4\u0db8\u0dda \u0dc0\u0dd0\u0db1\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9a \u0dca \u0db1 \u0d91\u0d9a\u0dd9 \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. Elkaduwa Plantations Limited \u0dc1 \u0dc3 \u0dc0\u0dd0\u0dd4\u0db8\u0dda \u0dc0\u0dd0\u0db1\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9a\u0dc5\u0dcf\u0db8 \u0dc1\u0dc0\u0dca \u0dc1\u0dca \u0dc1\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0dcf? \u0dc1 \u0dc3 \u0dc0\u0dad\u0dd4 \u0dc3\u0db8\u0dcf\u0d9c\u0db8 \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba \u0dbd\u0dcf\u0dcf\u0dba\u0d9a\u0dca \u0dba\u0da7\u0dc1\u0dad\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc1\u0dc0\u0db1 \u0d91\u0d9a\u0dad\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0dc1\u0dc0\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0dad\u0db8\u0dd2 \u0dc1 \u0dc3 \u0dad\u0dd4\u0dc5\u0dd2\u0dca \u0d85\u0db4\u0da7 \u0dc1\u0db4\u0dc1\u0db1\u0dca \u0dc1\u0dca . \u0dc1\u0db8\u0ddc\u0d9a\u0dcf \u0d85\u0db4\u0dd2 \u0dcf\u0dca \u0db1\u0dcf \u0dad \u0db1\u0dca\u0dca \u0d85\u0dba\u0dc1\u0dda ETF, EPF \u0d94\u0d9a\u0dca\u0dc1\u0d9a\u0ddd\u0db8 \u0da2\u0dc1\u0dba\u0dca \u0dc1\u0d9c\u0dc0\u0dca \u0dc1\u0dca . \u0dc1 \u0dc3 \u0d85\u0dba \u0dbd\u0dcf\u0dcf \u0dc1\u0db4\u0dca \u0dc0\u0db1\u0dc0\u0dcf. \u0dbd\u0dcf\u0dcf \u0dc1\u0db4\u0dca \u0dc0\u0dd6\u0dc0\u0dcf\u0da7 ETF, EPF \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dc1\u0dc5\u0ddc\u0dad\u0dca \u0d91\u0dc1\u0dc4\u0db8 \u0da7\u0dd2\u0d9a \u0dc1\u0d9c\u0dc0\u0dca \u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db8\u0dd4\u0dcf\u0dbd \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0ddc\u0dad\u0dca \u0d91\u0dc1\u0dc4\u0db8 \u0dbd\u0dcf\u0dcf\u0dcf\u0dcf\u0dba\u0dd3 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0dca\u0dba\u0dad\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc1\u0dc0\u0db1 \u0d91\u0d9a \u0db1\u0dd0\u0dad\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0d91\u0dc1\u0dc4\u0db8 \u0dc0\u0dd4\u0dc1 \u0ddc\u0dad\u0dca \u0dc0\u0dad\u0dd4 \u0da7\u0dd2\u0d9a\u0dad\u0dca \u0dc0\u0dd2\u0d9a\u0dd4 \u0dca \u0db1\u0dd2 \u0dc3\u0dd2\u0dda\u0db0 \u0dc1\u0dc0\u0dca \u0dc1\u0dca ."
  },
