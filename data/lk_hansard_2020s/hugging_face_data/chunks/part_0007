    "chunk_text": "\u0d8a\u0dc5\u0da7\u0da7 \u0d85\u0db4\u0dd2 \u0dc3\u0dd4\u0db6\u0dc3\u0db7\u0db0\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0dbd\u0db7\u0dc0 \u0da2\u0dab\u0dca\u0dd0\u0dbd\u0dc1\u0dad Regulations \u0dcf \u0dc1 \u0dad\u0dc3\u0dca \u0dd4\u0dba\u0dad \u0db7. \u0d92\u0dd4\u0da7 \u0dc1\u0dc4\u0dda\u0dad\u0dd4\u0db8 \u0db4\u0dc5\u0db8\u0dd4\u0dc1 \u0db1\u0dd2 \u0da7\u0dc3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc3\u0db7\u0db8\u0dad\u0da2\u0dd4 \u0dc1 \u0dda\u0daf\u0dd3 \u0dc3\u0db4\u0dad \u0dc3\u0db4\u0dad \u0daf\u0dd4\u0d9a \u0dbd\u0dad\u0db7 \u0db7\u0d9a\u0dad\u0db7 \u0dba \u0da2. \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0db4\u0dca\u200d\u0dbb\u0db7\u0dc1\u0dda\u0dc1\u0dd3\u0dc3 \u0dc1\u0dbd\u0dca\u0dd4\u0db4\u0dad \u0dc2 \u0db1\u0dca \u0d9a\u0dd2\u0dda \u0db7 \u0da2\u0dc4 \u0dcf\u0dad\u0dad\u0db7 \u0d9a\u0dd2\u0dda \u0db7 \u0dc1\u0db4\u0dad \u0db4\u0db7\u0d9a\u0dbd\u0dd2\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc1\u0dda \u0d85\u0db4\u0dd2\u0db8\u0dad \u0dd4\u0dcf\u0db7 \u0dd4\u0dc5\u0db7. \u0dd4\u0db8\u0dd2\u0db8\u0dca \u0dbd\u0db8\u0dad \u0dd4\u0dcf\u0db7 \u0dd4\u0dc5\u0db7. \u0d92 \u0daf\u0dd4\u0d9a \u0dbd\u0dad\u0db7\u0db8\u0dad \u0dc4\u0db3\u0dd4\u0dad\u0db7\u0dc1\u0dd9\u0dad \u0d92 \u0da2\u0dd8\u0daf\u0dd4\u0dd4\u0db7\u0d82\u0dd9\u0dc1\u0dad\u0db8\u0dad \u0dd2\u0dd2\u0dbb \u0dc1 \u0dbd\u0db7 \u0dd2\u0dbb\u0db6\u0dd4\u0dab\u0dd4 \u0daf\u0dd4\u0d9a \u0dbd\u0dad\u0db7 \u0db1\u0dd2 \u0dd0\u0dba\u0dbb\u0dd2 \u0dd4\u0dba\u0dbd\u0db7 \u0dd0\u0db7 \u0dc1\u0dc4\u0ddc\u0db3 \u0dca\u200d\u0dbb\u0da2\u0dc1\u0dda\u0dcf\u0dc3\u0dc2\u0dab \u0d85\u0db1\u0dd4\u0dd9\u0da2\u0dad\u0dc3 \u0dd4\u0dba\u0db1\u0dca\u0dad \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0db7\u0dc1\u0db4\u0ddc\u0dc1\u0dba\u0ddc\u0db8\u0dad\u0dad\u0dd4\u0db8 \u0dc1 \u0dad \u0db7. \u0dc1\u0da2\u0dc4\u0dd2\u0daf\u0dd3 \u0dd9\u0dc2 \u0dc4\u0d9a\u0dc3 \u0dcf \u0dc3\u0dd2\u0dbd\u0dca \u0db7 \u0da2\u0dd0\u0dd2\u0dbb\u0dad\u0dd4\u0db8\u0da2\u0db7 -\n\n715 716\n\n\u0db4\u0db7\u0d9a\u0dbd\u0dd2\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dd4\u0db8\n\n\u0d92\u0dd4\u0da7 \u0dba\u0dcf\u0dc3\u0dc2\u0dab \u0dc4\u0dd0\u0da7\u0dd2\u0dc3\u0da7 \u0d85\u0db4\u0dd2 \u0dc3\u0dd2\u0dc3\u0dc3\u0da7 100\u0dc2\u0dab \u0d91\u0dd4\u0da7\u0dba\u0dd2. \u0dad\u0db8\u0dd4\u0db8\u0dad \u0dd9\u0dc2 \u0db1\u0dd2\u0dc1\u0dc3\u0ddd\u0dcf\u0dba \u0dd4\u0dcf\u0db7\u0dad\u0db7\u0dc3\u0dd4\u0dad\u0dd4\u0db8\u0da2\u0db1\u0dd2 \u0db4\u0dca\u200d\u0dbb \u0dca\u0dad\u0dc3\u0dc2\u0dab \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0db7. \u0da2\u0da2 \u0db1\u0dd2\u0dc1\u0dc3\u0ddd\u0dcf\u0dad\u0dc3 \u0dd4\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d85\u0db1\u0dd4\u0dba\u0db7 \u0db0\u0dbb\u0dd4\u0dba \u0dbb\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dc2\u0dab\u0dd4\u0dc3. \u0d91\u0dc4\u0dd2 \u0dc1\u0dc4\u0ddc\u0dc1\u0dba\u0ddc\u0dda\u0db4\u0dad \u0dcf\u0db7\u0dc1\u0db1\u0dca \u0dc1\u0dd4\u0ddc\u0dad\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0db7 \u0db6\u0dbd\u0db1\u0dca\u0dad; \u0dd4\u0dd0\u0db6\u0dd2\u0dd2\u0dbb\u0dc1\u0dd9\u0ddc\u0dbd\u0dca\u0dbd\u0dd1\u0dc1\u0dda \u0dc1\u0dd4\u0ddc\u0dad\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0db7 \u0db6\u0dbd\u0db1\u0dca\u0dad. \u0d85\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dbd \u0dad \u0da2 \u0d85\u0db4 \u0db6\u0dbd\u0db7\u0dc1\u0db4\u0ddc\u0dc1\u0dba\u0ddc\u0db8\u0dad\u0dad\u0dd4\u0db8 \u0dad \u0da2\u0da7\u0dca\u0da7\u0da2\u0da7 Internet connection \u0d91\u0dd4 \u0dc0\u0dd2\u0dc4\u0dd2\u0dbb\u0dd2\u0dbd\u0db7 \u0dad\u0dd0\u0dc4\u0dd0. \u0d92 \u0dc4\u0dd2\u0db1\u0dca\u0dcf\u0db7 \u0d85\u0db4\u0dd2 \u0dba\u0dcf\u0dc1\u0dad \u0db1\u0dd2\u0dbd\u0db0\u0db7\u0db4\u0dad\u0dc3\u0db7 \u0dc1\u0dd4\u0dc1\u0dba\u0dc4\u0dd2 \u0dc0\u0dd2 \u0dca \u0db7\u0dc3\u0dc3\u0dc2\u0dab \u0dad\u0db6\u0db7 \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0db7. \u0dc1\u0db4\u0dad Internet connection \u0d91\u0dd4 \u0d85 \u0dba \u0db4\u0db4\u0dad\u0dbb\u0dd2 \u0dad\u0dd0\u0dd2\u0dbb \u0dad\u0dd0\u0db1\u0dca \u0dbd \u0dcf\u0dad\u0dad\u0db7 \u0da7 \u0dad\u0da2\u0db1\u0dca\u0dc1 \u0dd2\u0dbd\u0dca\u0dbd\u0dd4\u0db4\u0dad \u0db4\u0dca\u200d\u0dbb\u0dc3 online \u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0db4\u0db8\u0dad \u0dd4\u0dba\u0db1\u0dca\u0dad \u0db6\u0dd0\u0db4\u0dad \u0dc4\u0dd2\u0db1\u0dca\u0dcf\u0db7 \u0db4\u0dca\u200d\u0dbb\u0db7\u0dc1\u0dda\u0dc1\u0dd3\u0dc3 \u0dc1\u0dbd\u0dca\u0dd4\u0db4\u0dad \u0dd4\u0db7\u0d9a\u0dc3\u0db7\u0dbd\u0dc1\u0dad \u0db4\u0dd2\u0dc4\u0dd2\u0db8\u0dca \u0db7 \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0dd4\u0db7\u0d9a\u0dc3\u0db7\u0dbd\u0dc3\u0da7 \u0d92 \u0db7 \u0dbd\u0db6\u0db7 \u0daf\u0dd4\u0db1\u0dca\u0dad\u0db7\u0da2 \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0dc1 \u0dad\u0dc3\u0dc2\u0dab \u0dc1\u0dad\u0ddc\u0dd4\u0dba \u0d85\u0dcf\u0db7\u0dc5 \u0dca\u200d\u0dbb\u0da2\u0dc1\u0dda\u0dcf\u0dc3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc3\u0db7\u0db8\u0dad\u0da2\u0dd4 \u0dd4\u0dba\u0db1\u0dca\u0dad \u0dba\u0dcf\u0dc1\u0dad \u0db1\u0dd2\u0dbd\u0db0\u0db7\u0db4\u0dad\u0dc3\u0db7 \u0dd4\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dd4\u0dba\u0db7\u0dc0\u0dd2 \u0d9a\u0dd2\u0dc3\u0dbd\u0db7 \u0d85\u0db4\u0dd2 \u0dc0\u0dd2 \u0dca \u0db7\u0dc3 \u0dd4\u0dba\u0dad \u0db7.\n\n\u0dc1\u0db4\u0dad Regulation \u0d91\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc3\u0db7\u0db8\u0dad\u0da2\u0dd4 \u0dc0\u0dd4\u0dda\u0db7\u0da2 \u0dc1\u0db4\u0dad \u0dc3\u0dd0\u0dc1\u0d9a \u0d85\u0db4\u0dd2 \u0dd4\u0dba\u0db1\u0dca\u0dad \u0db6\u0dbd\u0db7\u0dc1\u0db4\u0ddc\u0dc1\u0dba\u0ddc\u0db8\u0dad\u0dad\u0dd4\u0db8 \u0dad \u0dad \u0db8\u0dad \u0dc1\u0dcf\u0dc3\u0dc2\u0dab \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0db7. \u0dc3\u0da2\u0dc4\u0dba \u0d85\u0dc3 \u0d85\u0dc3\u0dad\u0dba \u0dc1\u0dad\u0ddc\u0dba\u0dad\u0dd4\u0db8\u0dc2 \u0daf\u0dd3\u0dbd\u0db7 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0dbd\u0db7\u0dc0 \u0d85\u0dba\u0dc1\u0dd9\u0dad \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0db7. \u0dd9\u0dc2 \u0d9a\u0dd2\u0db4\u0dad\u0dd2\u0dbd\u0dca\u0dbd \u0da2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0da2\u0db1\u0dd2 \u0dc1\u0db4\u0dad \u0dc3\u0dd0\u0dc1\u0d9a \u0dad\u0da2\u0db1\u0dca\u0dc1 \u0d85\u0dc3\u0daf\u0dd4\u0db4\u0dad \u0db4\u0dca\u200d\u0dbb\u0dc3 \u0dc3\u0dc4\u0dd2\u0dbb\u0dd4 \u0dd4\u0dba\u0dad \u0db1\u0dd2\u0dbd\u0db0\u0db7\u0db4\u0dad\u0dc3\u0db7 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dbd\u0db6\u0db7 \u0dd9\u0db1\u0dd2\u0dda\u0daf\u0dd3 \u0d85 \u0dc3\u0db7\u0dad\u0dc1\u0dad \u0dd2\u0dd2\u0dbb \u0dad \u0d91\u0dd4\u0da7\u0dad\u0db7 record \u0dc1 \u0dad \u0db7. \u0d91\u0dad\u0dc1\u0dd4\u0ddc\u0da7 \u0dd4\u0dc0\u0dd4\u0dc2 \u0dc4\u0db4\u0dad \u0d92 \u0dc3\u0db3\u0dc4\u0db7 \u0d85\u0db7\u0dd2\u0dc3\u0db7\u0da0\u0dad\u0dc3\u0dc2\u0dab \u0dc0\u0dd2\u0dc1\u0dba\u0ddd\u0db0\u0dad\u0db7 \u0dc2\u0dab \u0dcf\u0dd0\u0dc2\u0dab\u0dc0\u0dd4 \u0dc1\u0dc4\u0ddc\u0db8\u0dad \u0db1\u0dd2 \u0dd0\u0dbb\u0dd0\u0dbb\u0dd2 \u0dc1\u0dad\u0ddc\u0dba\u0dad\u0dd4\u0db8\u0dc2 \u0dc1\u0dc3\u0ddc\u0dc3\u0db7 \u0dd9\u0db1\u0dca\u0dad \u0d85\u0db4\u0da7 \u0dbb\u0dd4\u0dc5\u0dd4 \u0db1\u0dca. \u0dc1\u0da2\u0ddc\u0dd4\u0dcf \u0d85\u0db4\u0da7 record \u0d91\u0dd4\u0dc2\u0dab \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0db7. \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0dbd\u0db7\u0db7\u0dd2\u0dc3\u0db7 \u0d9a\u0dd2\u0dc3\u0dad \u0db7 \"\u0dc1\u0db4\u0dad \u0da7\u0dd2\u0dd4 \u0dad\u0da2\u0dba\u0dd2 \u0da2\u0db7 \u0dc3\u0dad\u0dd4\u0db8 \u0db8\u0dad\u0dd4\u0db4\u0dad \u0da7\u0dd2\u0dd4 \u0dc1\u0db4\u0dad\u0dd4 \u0dad\u0da2\u0dba\u0dd2 \u0da2\u0dc1 \u0d86\u0dcf\u0db7\u0dc3\u0da2 \u0dc1\u0db4\u0dad\u0dd4 \u0dad\u0da2\u0dba\u0dd2 \u0da2\u0dc1 \u0dc0\u0dd2\u0dc3\u0dcf\u0da2\" \u0d9a\u0dd2\u0dc3\u0dbd\u0db7. \u0dc3\u0db4\u0dad\u0d9a\u0dd2\u0dc3\u0dd2 \u0dc1\u0dad\u0ddc\u0da2\u0da7 \u0dc3\u0dd0\u0dba \u0da2\u0dc2\u0dab \u0dc3\u0dd2\u0daf\u0dd4 \u0dc1 \u0dbd\u0db7 \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0db7 \u0dad\u0db4\u0dad \u0d92 \u0dc1\u0dad\u0ddc\u0da2\u0da7 \u0dc3\u0dd0\u0dba \u0da2 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc1 \u0dbd\u0db7 \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0dad\u0dd0\u0dad \u0dc4\u0db3\u0dd4\u0dad\u0db7 \u0dd9\u0dd0\u0db1\u0dd3\u0dc1\u0db4\u0dad \u0dc4\u0dd0\u0d9a\u0dd2\u0dc3\u0db7 \u0d91\u0da2\u0dbd\u0dd2\u0db1\u0dca \u0d85\u0db4\u0da7 \u0dbd\u0dd0\u0dc1\u0db6\u0dad \u0db7.\n\n\u0dc1\u0db4\u0dad \u0dad \u0dc1\u0dd4\u0ddc\u0da7 \u0dcf\u0dc4\u0d85\u0da7 \u0dbd\u0dc2\u0dab\u0dc3\u0dc3\u0dd4\u0da7 \u0d85\u0dc3\u0dca \u0dd0\u0dc3\u0dd4\u0da2 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0dbd\u0db7\u0dc0 \u0dc1\u0dd9\u0dba \u0db4\u0dad \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0da2\u0da7 \u0d85\u0db1\u0dd4\u0da2\u0dad \u0dc1 \u0dbd\u0db7 \u0dd2\u0dbb\u0db6\u0dd4\u0dda\u0db8\u0dad \u0dc1\u0dd9\u0dba \u0db4\u0dad \u0dc3\u0dd2\u0daf\u0dd4 \u0dd4\u0dba\u0dbd\u0db7 \u0dd2\u0dbb\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca 1 71] ]4 \u0dd4\u0da7 \u0db4\u0da2\u0dda\u0dba\u0dd2. \u0d92\u0dd4\u0da7 \u0dc1\u0dc4\u0dda\u0dad\u0dd4\u0db8 \u0dad \u0db8\u0dad \u0dbd\u0dc2\u0dab\u0dc3 ]\u0dd4\u0da7 \u0d86\u0dc3\u0db1\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0da2\u0db7\u0dda\u0dc3\u0dc2\u0dab \u0dad\u0da2\u0db1\u0dca\u0dc1 \u0db6\u0dd0\u0d82\u0d9a\u0dd4 \u0d9c\u0dd2\u0dab\u0dd4\u0db4\u0dad \u0d86\u0dba\u0db4\u0dad\u0dc0 \u0dd4\u0dba\u0dbd\u0db7 \u0dad\u0dc4\u0dc0\u0dd4\u0dc2 \u0d9a\u0dd2\u0dbb\u0dd3\u0da2 \u0dc3\u0dd2\u0daf\u0dd4 \u0dd4\u0dba\u0dbd\u0db7 \u0dad\u0dd0\u0dd2\u0dbb \u0d91\u0dd4\u0dba\u0dd2. \u0d92\u0dd4\u0da7 \u0d85\u0db4\u0dd2 \u0d85\u0dbd\u0dd4\u0db8\u0dad \u0dd0\u0dd0\u0dc3\u0da7\u0dc4\u0dad\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc3\u0db7\u0db8\u0dad\u0da2\u0dd4 \u0dd4\u0dba\u0dc1\u0dd9\u0dad \u0dc3\u0dad \u0db7."
