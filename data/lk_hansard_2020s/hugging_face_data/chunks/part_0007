    "chunk_size_bytes": 3796,
    "chunk_text": "\u0dc4\u0dd0\u0db6\u0dd0\u0db1\u0dca, \u0d92 \u0dca\u200d\u0dbb \u0dae\u0db1 \u0da7 \u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0db8\u0dbb\u0d9a\u0dca \u0d85\u0db4\u0da7 \u0dbd\u0dd0\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dba\u0dc1 \u0ddd\u0da2\u0db1 \u0db4\u0dbb\u0dd2\u0dc3\u0dbb \u0dc1\u0dc4\u0dad\u0db3 \u0dad \u0db8 \u0db8\u0dc0\u0dc1\u0dda \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0db1\u0dda \u0db4\u0db8\u0dab\u0db1\u0dca. \u0dc3\u0dc4\u0db1\u0db8 \u0dc1\u0db1\u0dad\u0dc1\u0dc0\u0db1\u0dca, \u0dba\u0dc1 \u0ddd\u0da2\u0db1 \u0d9a\u0dd2 \u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dad\u0dc6\u0dae\u0d9c\u0db1\u0dd2\u0dc3\u0dae\u0dcf\u0dcf\u0db1\u0dc1\u0dda \u0dc4\u0dd0\u0db8 \u0dc3\u0dc4\u0db1 \u0db8 \u0dc1\u0daf\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dda\u0dc0 \u0db4\u0dbd\u0dd2 \u0da7 \u0d85\u0db4\u0dd2 \u0dd2\u0dc4\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0d92 \u0dbb\u0dc1\u0dda \u0dba\u0dc1 \u0ddd\u0da2\u0db1 \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0dc1\u0db1\u0dca. \u0dc1\u0dc0\u0db1 \u0db8 \u0dad\u0dd0\u0db1\u0d9a \u0dc3\u0dc4\u0db1 \u0dc1\u0daf\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf\u0da7 \u0dba\u0dc1 \u0ddd\u0da2\u0d9a\u0dc1 \u0dc0\u0dda \u0dd2\u0dc4\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf, \u0d92\u0dc0\u0dcf\u0dc1\u0dda \u0dba\u0dc1 \u0ddd\u0da2\u0db1 \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0dc1\u0db1\u0dca. \u0db4\u0dc3\u0dd4\u0dd2\u0dc4 \u0d9a\u0dcf\u0dbd\u0dc1\u0dda \u0dbb\u0db1\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0dc3\u0dc4 \u0dbb\u0da2 \u0d85\u0db8\u0dca\u0d9c\u0db8\u0db1 \u0d9a\u0dbb\u0db4\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dad \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0daf \u0dba\u0dc1 \u0ddd\u0da2\u0d9a \u0db1\u0dca \u0dc1\u0dbb\u0dad\u0dab\u0dd2\u0dba\u0dda\u0d9c\u0dad \u0d9a\u0dbb\u0db1 \u0dba \u0dad\u0db1\u0dc0\u0dbd \u0dc1\u0dbb\u0dad\u0dab\u0dd2\u0dba\u0dda\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dda\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0d89\u0dc4\u0dc5\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc0\u0dd2\u0dc1 \u0dad\u0dc2\u0dc1 \u0db1\u0dca \u0dc3\u0d82 \u0dcf\u0dbb\u0d9a \u0d9a\u0dca\u0dc1\u0dc2\u0dad\u200d\u0dbb \u0d9c \u0db8\u0dad\u0dcf\u0db8 \u0d92 \u0d85 \u0dc1 \u0dc1\u0dbb\u0dad\u0dab\u0dd2\u0dba\u0dda\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dda\u0dc0\u0dbd \u0dc1\u0dc4\u0dad\u0db3\u0db8 destination \u0d91\u0d9a\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2 \u0da7 \u0d85\u0dc1\u0dda \u0dbb\u0da7 \u0dc3\u0da7\u0dc4\u0db1\u0dca \u0dc0\u0dd4\u0dab\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1 \u0db8 \u0dba\u0dc1 \u0ddd\u0da2\u0db1 \u0dc1\u0dbb\u0dad\u0dab\u0dd2\u0dba\u0dda\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dda \u0dba \u0dad\u0db1 \u0d9c \u0db8\u0dc1\u0dad\u0dad \u0db8, \u0d92 \u0dc1\u0dbb\u0dad\u0dab\u0dd2\u0dba\u0dda\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dda\u0dc0\u0dbd\u0dd2\u0db8\u0dca \u0db8 \u0d85\u0daf \u0dc0\u0db1\u0dc1\u0d9a\u0dad\u0da7 \u0d85\u0db4\u0dd2 \u0d89\u0dc4\u0dc5\u0da7 \u0dad\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf.\n\n\u0d8a\u0dc1\u0dda \u0daf\u0dd2\u0db1\u0dc1\u0dda\u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0dc1 \u0dad\u0dc2 \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf\u0dc0\u0d9a\u0dca \u0db4\u0dd0\u0dc0\u0dd0 \u0db8\u0dc0\u0dd6\u0dc0\u0dcf, \u0dc1\u0db4\u0dad\u0dbd\u0dd3\u0dc3\u0dd2 \u0db8 \u0d91\u0d9a\u0dca\u0d9a. \u0dba\u0dc1 \u0ddd\u0da2\u0d9a \u0db1\u0dca \u0dba\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 - investor protection - \u0dc3\u0db3\u0dc4\u0dcf \u0dc1\u0dc0\u0db1\u0db8 \u0dc1\u0d9a\u0dad\u0dda\u0da8\u0dcf\u0dc3 \u0d9a\u0dca \u0dc1\u0db4\u0dad\u0dbd\u0dd3\u0dc3\u0dd2\u0dc1\u0dda \u0dc3\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0d9a\u0dad\u0dc1\u0dc4\u0dad\u0db8\u0daf \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d85\u0db4\u0dd2 \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0d9a\u0dc5\u0dcf. \u0dc1\u0db8\u0dad\u0d9a\u0daf, \u0dc1\u0db4\u0dc1\u0dbb\u0dca\u0daf\u0dcf \u0dc1\u0dc0\u0da0\u0dca \u0dc3\u0dd2\u0dda\u0db0\u0dd2 \u0dc0\u0dcf\u0dc1 \u0d92\u0dc0\u0dcf \u0daf\u0dd2\u0dc4\u0dcf \u0db6\u0dd0\u0daf\u0dd9\u0dc0\u0dcf\u0db8 investor protection \u0dc1\u0d9a\u0dc1\u0dc3\u0dad \u0dc1\u0dc0\u0dad \u0db8 \u0d85\u0dc1\u0db1\u0d9a\u0dca \u0d85 \u0dc1 protection\n\n\u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db8 \u0dca\u200d\u0dbb \u0dae\u0db1 \u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc1\u0dda \u0dc0\u0dcf\u0dc1 \u0dc3\u0dd2\u0dda\u0db0\u0dd3\u0db1\u0dca \u0daf\u0dd0\u0d9a\u0dca\u0d9a\u0dcf\u0db8 \u0d92\u0dc0\u0dcf\u0dc1 \u0db1\u0dca \u0d85\u0db4\u0da7 \u0dc1\u0dda\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d91\u0d9a \u0dc1\u0daf \u0db1\u0dca. \u0dba\u0dc1 \u0ddd\u0da2\u0d9a \u0db1\u0dca\u0da7 \u0d8d\u0da2\u0dd4\u0dc0\u0db8 \u0dbb\u0dc1\u0dda \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dba\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0dad \u0db8 \u0db8\u0dc0 \u0db6\u0dbd\u0db4\u0dcf\u0db1\u0dc0\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u0db1\u0dca, \u0dc1\u0dda \u0d9a\u0dcf\u0dbb\u0dab \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db4\u0dd4 \u0dc4\u0dd0\u0da7\u0dd2\u0dc1\u0dda\u0db8 \u0da7\u0dd2\u0dbb\u0dcf\u0db1\u0dca \u0d85\u0dbd\u0dc3\u0dae \u0dad\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0db8, \u0dc1\u0db4\u0dad\u0dbd\u0dd2\u0dc3\u0dae\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0db8 \u0dc1\u0dc4\u0dad\u0db3 \u0dc1 \u0ddd\u0da2\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0dc1\u0d9c\u0db1\u0dcf\u0dc0\u0dcf, \u0dba\u0dc1 \u0ddd\u0da2\u0d9a \u0db1\u0dca\u0dc1 \u0dba\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dc0 \u0dc1\u0dc0\u0db8\u0dca\u0dc1\u0dc0\u0db1\u0dca \u0dc0\u0dcf\u0dc1 \u0db8 \u0d92 \u0d85 \u0dc1 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dba\u0dda\u0dbd\u0dd2 \u0dc0\u0dd2\u0db7\u0dcf\u0d9c \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0d94 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db8\u0dcf\u0dc6\u0dd2 \u0dcf \u0d9a\u0dbd\u0dca\u0dbd\u0dd2 \u0d91\u0d9a\u0dca\u0d9a \u0d9c\u0db8\u0dca\u0dc1\u0daf\u0db8\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0d9a\u0dda\u0db4\u0dda, \u0d85\u0dbd\u0dca\u0dbd\u0dc3 \u0dc3\u0dc4 \u0daf\u0dd6\u0dc2\u0dab \u0dc3\u0db8\u0d9f \u0d9c\u0db8\u0dca\u0dc1\u0daf\u0db8\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0dc1 \u0dad\u0dc2 \u0dc1\u0db4\u0dad\u0dbd\u0dd2\u0dc3\u0dae \u0dc1\u0d9a\u0dad\u0dda\u0da8\u0dcf\u0dc3 \u0d9a\u0dca - investor protection division \u0d91\u0d9a\u0d9a\u0dca - \u0dc3\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2 \u0dbd\u0dcf. \u0d92 \u0dc1 \u0ddd\u0da2\u0db1\u0dcf\u0dc0 \u0dba\u0dc1 \u0ddd\u0da2\u0db1 \u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dbb\u0dcf\u0da2\u0dba \u0dad\u0db8\u0dad\u0dd2\u0dc0\u0dbb \u0dcf \u0dc4\u0dd0\u0da7\u0dd2 \u0da7 \u0db8\u0dcf \u0d89\u0dc4\u0dc5\u0dd2\u0db1\u0dca\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0d9a\u0dd2 \u0db1 \u0d9a\u0dcf\u0dbb\u0dab \u0db8 \u0dc1\u0dda \u0d85\u0dc0\u0dc3\u0dae\u0dcf\u0dcf\u0dc1\u0dda\u0daf\u0dd3 \u0db8\u0dad\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf."
  },
