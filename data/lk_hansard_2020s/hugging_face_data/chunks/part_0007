cf\u0dc0 14\n\n\u0dc1\u0db8\u0ddc\u0dc1\u0dbd\u0dca \u0dca\u0ddd\u0dc0\u0dcf 17 \u0db8\u0dd4\u0dc5\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba 663\n\n(iii) 289 187\u0d9a\u0dca \u0dc1 .\n\n(iv) 2023 \u0dc0\u0d9a\u0dc2\u0dca\u0da8\u0dc1\u0d86\u0daf\u0dd3 \u0dc0\u0dd2\u0dc1\u0dda \u0d9c\u0dad \u0dbb\u0db1\u0dca\u0d9a \u0dc1\u0dca\u200d\u0dbb\u0dda\u0dc2\u0dca\u0da8 \u0dc1\u0dbd\u0dc3 \u0d87\u0dc1\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0db1\u0dd4 \u0dc1\u0dca\u0ddc\u0dbd\u0d9a \u0db1\u0dca\u0dbd\u0dd2\u0dba\u0db1 5 970\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd3 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d9a\u0dd2\u0dba\u0dca \u0dc1\u0dca US Dollars 5.9 billion. \u0d91\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1 951\u0d9a\u0dca \u0dc0 \u0dc1\u0dba\u0dca \u0dc3\u0db3\u0dc4\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf.\n\n\u0dda\u0da7 \u0d85\u0db8\u0dad \u0dc0 \u0db8\u0db8 \u0dc1 \u0dc3 \u0d85\u0dc0\u0dc3\u0dae\u0dae\u0dcf\u0dc1 \u0daf\u0dd3 \u0dc3\u0db3\u0dc4\u0dca \u0d9a \u0dca \u0db1 \u0d95\u0db1\u0dd1 \u0db4\u0dc3\u0dd4\u0dd2\u0dc4\u0dba \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0dc1\u0dda \u0db8\u0db8 \u0dc1 \u0dc3 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba \u0dcf\u0dcf \u0d9c\u0dad\u0dca\u0dad \u0dcf\u0dc0\u0dc1\u0dc3\u0dda \u0d89\u0db3\u0dbd\u0dcf \u0dc1 \u0dc3 \u0dc1\u0dc0\u0db1\u0d9a\u0dbd\u0dca -\u0db4\u0dc3\u0dd4\u0dd2\u0dc4\u0dba \u0db8\u0dcf\u0dc3\u0dba \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0ddc\u0da7- \u0d87\u0dc1\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0db1\u0dd4 \u0dc1\u0dca\u0ddc\u0dbd\u0d9a \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 11.3\u0d9a \u0db8\u0dd4\u0dcf\u0dbd\u0d9a\u0dca \u0dc0\u0dd2\u0dc1\u0dda \u0d9c\u0dad \u0dbb\u0db1\u0dca\u0d9a\u0dba\u0dca \u0d85\u0db4\u0da7 \u0d91\u0dc0\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db6\u0dc0. \u0dc1 \u0dc3 \u0da7 \u0d85\u0db8\u0dcf\u0dbb\u0dd4\u0dc1 \u0dc0\u0dd0\u0dd4\u0db8\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1 \u0dc1\u0d9c\u0ddc\u0dca\u0d9a\u0dca \u0d85\u0dba \u0dc3\u0dbd\u0dca\u0dbd\u0dd2 \u0d91\u0dc0\u0dca \u0db1 \u0d91\u0db4\u0dcf \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1 -\u0dc3\u0dbd\u0dca\u0dbd\u0dd2 \u0d91\u0dc0\u0dca \u0db1 \u0d91\u0db4\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf campaign \u0d9a \u0db4\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1 - \u0dc1 \u0dc3 \u0dc1\u0da7\u0dca \u0db1\u0dca\u0db1\u0dd2\u0dc3\u0dd4\u0dca \u0dc1\u0dda \u0daf\u0dd4\u0d9a \u0db6\u0dbd\u0dbd\u0dcf \u0dc0\u0dd2\u0dc1\u0dda \u0d9c\u0dad \u0dbb\u0db1\u0dca\u0d9a\u0dba\u0dca \u0db1\u0dd2\u0dc0\u0dd0 \u0daf\u0dd2 \u0db8\u0dcf \u0d9a\u0d9c\u0dc1\u0dba\u0dca \u0d91\u0dc0\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0d87\u0dc1\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0db1\u0dd4 \u0dc1\u0dca\u0ddc\u0dbd\u0d9a \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 11.3\u0d9a \u0db8\u0dd4\u0dcf\u0dbd\u0d9a\u0dca.\n\n(v) \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d82\u0d9a\u0dd2\u0d9a \u0dbb\u0db1\u0dca\u0d9a\u0dba\u0dca \u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0dc0 \u0dc1\u0dba\u0dca \u0d9c\u0dd2\u0dc4\u0dc3\u0dae\u0dae \u0dc3\u0dc4 \u0d9c\u0dd2\u0dc4\u0dc3\u0dae\u0dae \u0dc1\u0db1\u0ddc\u0dc0\u0db1 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd2\u0dc1\u0dda \u0d9c\u0dad \u0dc1 .\n\n\u0d9c\u0dd2\u0dc4\u0dc3\u0dae\u0dae \u0dc1\u0db1\u0ddc\u0dc0\u0db1 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u0dc1\u0d9a\u0ddc\u0dbb\u0dd2\u0dba\u0dcf\u0dc0 \u0da2\u0db4\u0dcf\u0db1\u0dba \u0dda\u0dbb\u0dcf\u0dba\u0dbd\u0dba \u0dc3\u0dd2\u0d82\u0d9c\u0dda\u0db4\u0dd6\u0dbb\u0dd4\u0dc0 \u0db8\u0dbd\u0dba\u0dcf\u0dc3\u0dd2\u0dba\u0dcf\u0dc0 \u0db8\u0dcf\u0dbd\u0daf\u0dd2\u0dc0\u0dd2 \u0db1 \u0dc3\u0dc4 \u0db8\u0dd0\u0dcf \u0dc1\u0db4 \u0daf\u0dd2\u0d9c \u0d9a\u0dbd\u0dcf\u0db4\u0dc1\u0d86 \u0da7\u0dc0\u0dbd\u0da7 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d82\u0d9a\u0dd2\u0d9a\u0dba\u0dca \u0db4\u0dd2\u0da7\u0dad\u0dca\u0dc0 \u0dba\u0db1 \u0d85\u0dad \u0dca\u200d\u0dbb\u0dae\u0db8 \u0dc0\u0dad\u0dcf\u0dc0\u0da7 \u0d91\u0db8 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u0dba\u0db1 \u0d85\u0dba\u0dc4\u0da7 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0dca \u0db4\u0dd4\u0dc4\u0dd4\u0dd4 \u0db4\u0dcf\u0db0\u0db8\u0dcf\u0dbd\u0dcf \u0db8\u0d9f\u0dd2\u0dca \u0db4\u0dd4\u0dc4\u0dd4\u0dd4 \u0dc0\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0dc1\u0dda.\n\n01. \u0dc1\u0d9a\u0ddc\u0dbb\u0dd2\u0dba\u0dcf\u0db1\u0dd4 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u0dcf\u0dcf\u0dc2\u0dca\u0da8\u0dcf \u0db4\u0dd4\u0dc4\u0dd4\u0dd4 \u0dc0"
