u0dda\u0dc2\u0dd3 8\u0dd0\u0da9\u0db4\u0dd2\u0dd2\u0db6\u0dc18\u0dc5 \u0dc1\u0db4\u0dad \u0dba\u0da7 \u0dad\u0dd4\u0dc5 \u0d9a\u0dca\u200d\u0dbb\u0dd2[\u0dc0 \u0d9a\u0db8 \u0dba \u0d86 \u0dc0\u0dba[.\n\n\u0d92 8\u0dc0\u0dc1\u0dda\u0db8 \u0dc3\u0dd4\u0daf\u0dd4 \u0dc0\u0d9a \u0d85\u0dcf \u0d9c\u0dda \u0dc08\u0dca \u0db8\u0dc0\u0dad\u0dc1\u0dca \u0daf\u0dd2\u0daf\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dca [ \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad8 \u0dc1\u0db4\u0db1\u0dca8\u0dc0 \u0daf\u0dd2[ \u0dc4\u0dd0\u0dd2\u0dbb\u0dba\u0dd2. \u0db8\u0dc0 :\u0dd2\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd6\u0dad \u0dc1\u0d9a\u0ddd [ \u0dad\u0dd4\u0dc5 \u0db1\u0dd6\u0dad \u0d86\u0dbb\u0dca\u0dbd\u0dd2 \u0dc1\u0db8\u0dc0\u0da9\u0d9a[ \u0dad\u0dd4\u0dc5 \u0dc1\u0db88\u0dd0\u0db1\u0dd2 \u0daf\u0db4\u0dad\u0db4 \u0d9a \u0daf \u0dc4\u0dc0 \u0dad\u0dd2\u0d9a \u0dc5 \u0dc1 \u0dc0\u0dc4\u0dd0\u0dd2\u0dbb 8\u0da7\u0dd2 \u0dc0 \u0db8\u0dca \u0daf\u0dcf\u0dbb\u0dc0\u0dba \u0dca\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dbb[ \u0dad\u0dd4\u0dd2\u0db6\u0db1\u0dca \u0d9a\u0db3\u0dc0\u0daf\u0dd2[ \u0dc4\u0dd0\u0dd2\u0dbb \u0db38\u0dba\u0dd2. \u0dc1\u0d9a\u0ddd \u0dc1\u0dad 8\u0da7\u0dd2 \u0dc0 \u0dc1\u0dc4\u0dc0 \u0db8 \u0db8\u0dd0\u0dab\u0dd2\u0dca blue sapphire, yellow sapphire \u0db8\u0dc0\u0dad\u0dc1\u0dca \u0daf\u0dd2\u0daf\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dca \u0dc1[\u0db1\u0dca \u0d85\u0db4\u0da7 \u0d9c\u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd48\u0db1\u0dca, \u0dba \u0d9a \u0db4\u0dd4\u0dba\u0dc1[\u0db1\u0dca \u0d85\u0db4\u0da7 \u0d9c\u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd48\u0db1\u0dca. \u0d92 8\u0dc0\u0dc1\u0dda\u0db8 \u0d9c\u0dca\u200d\u0dbb\u0dd0\u0dc6\u0dba\u0dd2\u0da7\u0dca, \u0d9c\u0dca\u200d\u0dbb\u0dd0 \u0dba\u0dd2\u0da7\u0dca, \u0d89\u0dca \u0db8 \u0dba\u0dd2\u0da7\u0dca, \u0dc1\u0da9\u0dc0\u0d9a\u0db8\u0dba\u0dd2\u0da7\u0dca, \u0dc1\u0dc6\u0dca \u0da9\u0dca\u0daf\u0dda\u0db4\u0dc0\u0dbb\u0dca\u0dbd, \u0daf\u0dbb\u0dca\u0dbd\u0dc1 \u0ddd\u0db1\u0dca 8\u0dd0\u0db1\u0dd2 \u0d9b\u0dca\u200