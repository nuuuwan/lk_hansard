u0da2\u0dca\u200d\u0dcf\u0dad\u0dcf4 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d85 \u0db1\u0dd0\u0dd2 \u0db1\u0db4\u0dcf \u0d9a\u0dd2 \u0dcf, \u0dc5\u0dd0\u0db6\u0dd2\u0dcf\u0da7\u0dca \u0db1\u0dab\u0dca\u0da9\u0db1\u0dca\u200d \u0db1\u0db4\u0dcf \u0d9a\u0dd2 \u0dcf \u0d9a \u0d85 \u0dc1 \u0dd9\u0dbb \u0dd0\u0dbd4\u0dcf. \u0dbb\u0dc1\u0da7\u0dca \u0da2\u0dca\u200d\u0dcf\u0dad\u0dcf4 \u0dc1\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0db4\u0dcf\u0dca\u200d\u0dcf \u0dc14\u0dcf\u0d9a\u0dda \u0dc5\u0db8\u0dcf. \u0d8a\u0db8\u0dd9\u0da7 \u0d85\u0db4\u0dd2 \u0d8a\u0db8\u0dd9 \u0db4\u0dcf\u0dca\u200d\u0dcf \u0d9a\u0db3\u0dc4\u0dcf \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db1 4\u0dba4\u0d9a\u0dda\u0dcf\u0dcf4\u0da7 \u0d85\u0db1\u0dd44 \u0d85\u0db1\u0dd4\u0dca\u200d\u0dbb\u0dcf\u0db4\u0dca\u0dd2 \u0dc5 \u0da2\u0dca\u200d\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dd2 4\u0dbb\u0dc1 [ \u0db4\u0dca \u0dc5\u0db8\u0dcf; succeeding Government \u0db1\u0dc5 [ \u0dc4\u0dd0\u0dd4\u0dc04\u0dcf. \u0d9a\u0dc5 \u0dc4\u0dbb\u0dd2. \u0db1\u0dc1\u0dda \u0db8\u0dd2\u0dad\u0dca\u200d\u0dbb \u0db1\u0dca \u0db1\u0dc4\u0dd2 \u0dc0 \u0d87\u0db1\u0dd2 \u0dad\u0dd4\u0db1\u0db1\u0dca\u0dca\u200d\u0dcf \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0dc5\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc5\u0dbb\u0dcf \u0db1\u0dc5 \u0dc4\u0dbb\u0dd2. \u0db1\u0db1 succeeding environment \u0db1\u0dc5 \u0d87\u0dad\u0dd4\u0dc1\u0db8\u0dda \u0dc1\u0dca\u0dc5 \u0dc5\u0dbb\u0db1\u0dca\u0dcf \u0db4\u0dd4\u0dd4 4\u0db1\u0dca\u0dd9? \u0dad\u0db1\u0db1\u0dca \u0dc5\u0dd0\u0db1\u0dd2 \u0db1\u0dd2\u0d9a\u0dcf, \u0dad\u0db1\u0db1\u0dca\u0dc1\u0dda \u0db8\u0dd2\u0dad\u0dca\u200d\u0dbb \u0db1\u0dca\u0da7 \u0db1\u0dcf. \u0db1\u0dd2\u0d9a\u0dcf, \u0dc1\u0dc5\u0dcf\u0dca\u0db4\u0dd0\u0db1\u0dd2\u0dc5\u0dcf\u0dbb \u0db1\u0dca \u0d9a\u0dd2 \u0dcf \u0db1\u0dd2\u0d9a\u0dcf, \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db1\u0dba\u0dbd\u0d82\u0dc4 \u0dc5\u0dd0\u0db1\u0dd0\u0dd2 \u0db1\u0dd2\u0d9a\u0dcf, \u0dc0\u0dd2\u0dc1\u0da2\u0dca\u0dc1\u0d9a\u0dda\u0dc5\u0dbb \u0dc5\u0dd0\