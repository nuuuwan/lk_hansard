    "chunk_text": "(\u0d86) (i) \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0db4\u0dd6 \u0dd3\u0db8\u0dba \u0db1\u0d9c\u0dbb\u0dba \u0dc1\u0dbd\u0ddd\u0d9a \u0d8b\u0dbb\u0dd4\u0db8\u0dba\u0d9a\u0dca \u0dc1\u0dbd\u0dc3 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf \u0dba\u0da7 \u0db4\u0dad\u0dca \u0dd2\u0dbb\u0dd3\u0db8\u0dc1\u0db8\u0dca\u0daf\u0dd3 \u0d85\u0daf\u0dcf\u0dc5 \u0db1\u0dd2\u0dbb\u0dca\u0da7\u0dcf\u0dba\u0d9a \u0d85\u0db1\u0dd4\u0dc0 \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0db4\u0dd6 \u0dd3\u0db8\u0dba \u0db1\u0d9c\u0dbb\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0da7\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0d91\u0da7\u0dd2 \u0d87\u0dad\u0dd2 \u0db4\u0dd6 \u0dd3\u0db8\u0dba \u0dc3\u0dda\u0dae\u0dcf\u0db1 \u0dd3\u0dd2 \u0d8b\u0daf\u0dba\u0dcf\u0db1 \u0dbd\u0dcf \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0dd2\u0dba\u0d9a \u0dc1\u0d9c\u0dcf\u0da9\u0db1\u0db1\u0d9c\u0dd2\u0dd2\u0dba \u0d86\u0daf\u0dd3 \u0dc1\u0db4\u0dde\u0dbb\u0dcf\u0dab\u0dd2\u0d9a \u0dc4\u0dcf \u0db4\u0dd6 \u0dd3\u0db8\u0dba \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0da7 \u0d87\u0dad\u0dd2 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dc1\u0dda \u0d91\u0da7\u0dd2 \u0d9a\u0db1\u0db4\u0dd3 \u0dc1\u0db4\u0dc1\u0db1\u0db1\u0dc3\u0dd4\u0dbd\u0dd4 \u0dc0\u0dd2 \u0dda\u0dd3\u0dba \u0d8b\u0dbb\u0dd4\u0db8\u0dba \u0dad\u0dd3\u0dc0\u0dca\u200d\u0dbb \u0dd2\u0dbb\u0dd3\u0db8\u0dc1\u0db8\u0dca \u0d85\u0da0\u0d9c\u0dba\u0db1\u0dca\u0db8 \u0dc1\u0dbd\u0dc3 \u0dc4\u0db3\u0dd4\u0db1\u0dcf\u0dc1\u0d9c\u0db1 \u0d87\u0dad. \u0dc1\u0db8\u0dca \u0d85\u0dad\u0dbb\u0dd2\u0db1\u0dca\u0db8 \u0db4\u0dd6 \u0dd3\u0db8\u0dba \u0dc1\u0d9c\u0dcf\u0da9\u0db1\u0db1\u0d9c\u0dd2\u0dd2\u0dba 17\u0d9a\u0dca \u0dbb\u0dcf \u0dba \u0d86\u0dba\u0dad\u0db1 30\u0d9a\u0dca \u0dc4\u0dcf \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0dd2\u0dba\u0d9a \u0dc1\u0d9c\u0dcf\u0da9\u0db1\u0db1\u0d9c\u0dd2\u0dd2\u0dba 471\u0d9a\u0dca \u0db4\u0dd4\u0dbb\u0dcf\u0dc0\u0dd2\u0daf\u0dba\u0dcf \u0dc1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc1\u0db8\u0dca\u0db1\u0dca\u0db8\u0dad\u0dd4\u0dc0 \u0db8\u0dd2\u0d