    "chunk_text": "\u0da2\u0da2 \u0d91\u0dcf\u0db7 -\u0d85\u0dc0\u0dd4\u0dc2 \u0daf\u0dd4 35\u0dd4\u0da7 \u0dd2\u0dc3\u0dca\u0dc1\u0dc3\u0dbd\u0dca\u0dbd\u0db7- \u0d9a\u0dd2\u0dc3\u0db7 \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0db7 \u0dc1\u0db4\u0dad \u0dba\u0da7 \u0db6\u0d82\u0dc1\u0dd4\u0ddc\u0dc1\u0dbd\u0ddc\u0db8\u0dad \u0dc1 \u0db1\u0dca\u0dad \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0dc1\u0dc4\u0dda\u0dad\u0dd4\u0db8 \u0dc1\u0dcf\u0dd4. \u0d91\u0dc2\u0dab \u0d91\u0dc2\u0dab \u0d85\u0dc3 \u0d9a\u0dd2\u0dc3\u0dad \u0db7 \u0d92 \u0d85\u0dc3 \u0db1\u0dd2 \u0dd0\u0dba\u0dbb\u0dd2 \u0d9a\u0dd2\u0dda \u0db7 \u0dc3\u0dad\u0db7\u0daf\u0dd3 \u0dc1\u0dc3\u0db1\u0dca. \u0da2\u0da2 \u0d9a\u0dd2\u0dc3\u0dbd\u0db7 \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0db7 \"\u0dc1\u0db4\u0dad \u0dba\u0da7\u0da7 \u0d94\u0dc1\u0dba\u0ddc\u0db8\u0dad\u0dad\u0dd4\u0db8 \u0dc1\u0dad\u0ddc\u0dc1\u0dcf\u0dad \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0d91\u0dbb\u0dd2\u0dc1\u0dad\u0dcf\u0db7 \u0db4 \u0db8\u0dad \u0db7\u0dc1\u0dd9\u0dad \u0dc3\u0dd1\u0da2\u0da7 \u0db8\u0dad \u0db4\u0dca\u200d\u0dbb\u0da2\u0db7\u0dda \u0db8\u0dad \u0dc0\u0dd2\u0dc3\u0dcf\u0da2 \u0dcf\u0dba\u0db1\u0dca\u0dad \u0db8\u0dad \u0db6\u0dd0\u0db4\u0dad \u0d86\u0dcf\u0db7\u0dc3\u0da2\u0dc2\u0dab \u0dd2\u0dbb\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d92 \u0db1\u0dd2\u0dc3\u0db7 \u0dc4\u0dd0\u0da2\u0dcf\u0db7\u0da2 \u0d9a\u0dad\u0dad \u0d9c\u0dd2\u0dab\u0dd4\u0dc1\u0db4\u0dad \u0dc0\u0dd2\u0dc3\u0dcf\u0da2 \u0db4\u0dd2\u0dc3 \u0db1\u0dca\u0dad \u0db6\u0dd0\u0db4\u0dad \u0dc4\u0dd2\u0da7\u0dc3\u0dc2\u0dab \u0d91\u0dad \u0db7. \u0d92 \u0dc4\u0dd2\u0da7\u0dc3 \u0db4\u0dd2\u0dc3 \u0db7 \u0dd9\u0dd0\u0db1\u0dd3\u0da2 \u0dc3\u0db3\u0dc4\u0db7 \u0dc1\u0dda\u0dc1\u0dd3\u0dc3 \u0dc4\u0db7 \u0dc0\u0dd2\u0dc1\u0dda\u0dc1\u0dd3\u0dc3 \u0dc1\u0dc3\u0db1\u0dca \u0dda\u0dc3 \u0dd9\u0db1\u0dca\u0dad \u0dc3\u0dd2\u0daf\u0dd4 \u0dad \u0db7. \u0dd4\u0dc0\u0dd4\u0dc2 \u0dcf\u0dad\u0db7\u0db0\u0dd2\u0db4\u0dd2\u0dbb \u0dc0\u0dd4\u0dda\u0db8\u0dad \u0dd4\u0dc0\u0dd4\u0dc2 \u0d85\u0dd9\u0da2\u0dd0\u0dd2\u0dbb \u0dc0\u0dd4\u0dda\u0db8\u0dad \u0dd4\u0dc0\u0dd4\u0dc2 \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0dd4\u0dc5\u0db8\u0dad \u0d94\u0dc1\u0dba\u0ddc\u0db8\u0dad\u0dad\u0dd4\u0db8 \u0dc1\u0dad\u0ddc\u0dc1\u0dcf\u0dad \u0dc1\u0dbd\u0dc3 \u0dbb\u0dd2\u0dd9\u0da7\u0da2 \u0dda\u0dc3 \u0dd9\u0db1\u0dca\u0dad \u0db7\" \u0d9a\u0dd2\u0dc3\u0dbd\u0db7. \u0d91\u0dc3 \u0da2\u0da2 \u0d85\u0dc0\u0dd4\u0dc2 \u0daf\u0dd4 35\u0dd4\u0da7 \u0dd2\u0dc3\u0dca\u0dc1\u0dc3\u0dbd\u0dca\u0dbd\u0db7\u0db8\u0dad \u0d9a\u0dd2\u0dc3\u0db7 \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0db7.\n\n\u0dc1\u0dcf \u0dd0\u0db1\u0dd2 \u0dd4\u0dc2 \u0dda \u0dc1\u0db4\u0dad\u0dd4\u0dba\u0dd2. \u0d85\u0db4\u0dd2 \u0dba\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0db7\u0dab\u0dca\u0dd0 \u0dc1\u0dd9\u0dad\u0dd0\u0dbd\u0dca\u0dbd\u0db7 \u0db4\u0db4\u0dad\u0dc1\u0dc0\u0ddd\u0dcf\u0dad\u0dc3 \u0dd4\u0dc5\u0db8\u0dad \u0d92 \u0dc3\u0db3\u0dc4\u0db7 \u0d85 \u0dba \u0dc1\u0dd0\u0ddc\u0dbd\u0d9a \u0db4\u0dca\u200d\u0dbb\u0da2\u0db7\u0dda\u0dc3 \u0d8b\u0db4\u0dc3\u0db7 \u0dd9\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dad\u0dd0\u0dd2\u0dbb \u0d85\u0db4\u0dad\u0dc3\u0dad\u0dc3 \u0dd4\u0dba \u0dbd\u0db6\u0dad \u0d86\u0dcf\u0db7\u0dc3\u0da2\u0da7 \u0dd0\u0db7 \u0dc1\u0dcf\u0d9c\u0dd4\u0dda\u0dc3\u0dc2\u0dab\n\n\u0d85\u0db4\u0dd2 \u0d91\u0dcf\u0db7 \u0dc1\u0dda\u0dc1\u0dd3\u0dc3 \u0d86\u0dcf\u0db7\u0dc3\u0db4\u0dad \u0dc1\u0dcf\u0db4\u0db7\u0d9a\u0dad\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dd4\u0db8 \u0dc3\u0dd4\u0dba\u0db7\u0db6\u0daf\u0dd4 \u0dc1\u0dcf\u0db4\u0db7\u0d9a\u0dad\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dd4\u0db8 \u0dc1\u0d9a\u0d9c\u0dd4 \u0dc1\u0dcf\u0db4\u0db7\u0d9a\u0dad\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dd4\u0db8 \u0d91\u0dd4\u0dad\u0dd4\u0db8 \u0dd4\u0dba\u0dbd\u0db7 \u0d86\u0dcf\u0db7\u0dc3\u0db4\u0dad \u0d85\u0db0\u0dd2\u0dd4\u0db7\u0db4\u0dad\u0dc3\u0dc2\u0dab \u0dd2\u0dd2\u0dbb \u0dd4\u0dc5\u0db7. \u0d92 \u0db7\u0dc1 \u0da2 \u0daf\u0dd4\u0db4\u0dad\u0db4\u0dad\u0dc3 \u0d85\u0db0\u0dd2\u0dd4\u0db7\u0db4\u0dad\u0dc3\u0dc2\u0dab \u0dd2\u0dd2\u0dbb \u0dd4\u0dc5\u0db7. \u0d92 \u0db7\u0dc1 \u0da2 \u0d85 \u0dba \u0d85\u0dc1\u0dad\u0d9a\u0dd4\u0db8\u0dad \u0dc3\u0dd2\u0dc3\u0dbd\u0dd4 \u0dc1 \u0dad\u0dc3\u0dca\u0dd4\u0db4\u0dad \u0dd4\u0dba\u0dbd\u0db7 \u0d86\u0d9a\u0dae\u0dd2\u0dd4\u0dc3 \u0dda \u0dad\u0db8\u0dad\u0db8\u0dad \u0dc1\u0dc3\u0db1\u0dca \u0db0\u0dad \u0dad\u0db8\u0dad\u0db8\u0dad \u0dc3\u0da7 \u0dc1\u0dd9\u0dad\u0dd0\u0dbd\u0dca\u0dbd\u0db7 \u0dc1\u0db4\u0ddc\u0dbd\u0dd3 \u0d85\u0db1\u0dd4\u0db4\u0db7\u0dad\u0dc3 \u0dad\u0db1\u0dd2 \u0dd2\u0dbd\u0dc2\u0dab\u0dd4\u0da2\u0da7 \u0dc1\u0dd9\u0dad\u0dd0\u0dbd\u0dca\u0dbd\u0db7 \u0dc2 \u0db4\u0dd2\u0dc3\u0dbd \u0d85\u0db0\u0dd2\u0db4\u0dca\u200d\u0dbb\u0da2\u0db7\u0dda\u0dc3 \u0dd4\u0dba\u0dbd\u0db7 \u0dda \u0d86\u0d9a\u0dae\u0dd2\u0dd4\u0dc3 \u0dad\u0dd0 \u0dad\u0db8\u0dad \u0db0\u0dad \u0d86\u0d9a\u0dae\u0dd2\u0dd4\u0dc3\u0dc2\u0dab \u0db6 \u0da7 \u0db4\u0db8\u0dad \u0dd4\u0dc5\u0db7. \u0d92 \u0dd4\u0db7\u0dbd\u0dc1\u0dad\u0daf\u0dd3 \u0dc3\u0da2\u0dd2\u0db8\u0dad \u0dc1\u0db4\u0dca\u200d\u0dbb\u0dda\u0da2\u0dcf\u0db7\u0dc3 \u0da2\u0dd0\u0dd2\u0dbb\u0dad\u0dd4\u0db8\u0da2\u0db7 \u0db1\u0dd2\u0dc1\u0dc3\u0ddd\u0dcf\u0dba \u0dc1\u0dc3\u0dde\u0d9b\u0dba \u0d85\u0da2\u0db7\u0dad\u0dba \u0dba\u0dc3\u0db7 \u0dc0\u0dd2\u0db0\u0dd2\u0dc3\u0da7 \u0dad\u0da2\u0dba\u0dd2 \u0dd4\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dd4\u0dc1\u0dc5\u0dda. \u0d91\u0dcf\u0db7 \u0d91\u0dad\u0dd4\u0db8\u0da2\u0db7\u0da7 \u0dc1\u0db4\u0dad \u0d86\u0d9a\u0dae\u0dd2\u0dd4\u0dc1\u0dad \u0d9a\u0dd2\u0dc3\u0dd2\u0da2 \u0dc1\u0dcf\u0dc3\u0dc2\u0dab \u0dc1\u0db8\u0dad\u0dc2 \u0dc1\u0dab\u0dca \u0dad\u0dd0\u0dc4\u0dd0. \u0d85\u0db1\u0dca\u0dd2\u0dbb\u0da2\u0da7 \u0d85\u0db4\u0dd2 \u0d92\u0dd4 \u0dd4\u0dc5\u0db7\u0da7 \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dda \u0d91\u0dad\u0dd4\u0db8\u0da2\u0db7 \u0d85\u0db4\u0da7 \u0dad\u0da2\u0dc2\u0dab \u0db4\u0da7\u0db6\u0dd0\u0db1\u0dca\u0dcf\u0db7 \"\u0db0\u0dad- \u0dda\" \u0d9a\u0dd2\u0dc3\u0dbd\u0db7. \u0d91 \u0dd0\u0db1\u0dd2 \u0dad\u0da2\u0dc2\u0dab \u0db4\u0da7\u0db6\u0dd0\u0db1\u0dca\u0dc1\u0dda \u0dda \u0d86\u0d9a\u0dae\u0dd2\u0dd4\u0dc3 \u0db0\u0dad \u0dd4\u0dc5\u0db7\u0da7\u0dba\u0dd2. \u0dba\u0db1\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u0dca\u200d\u0dbb\u0da2\u0dc3\u0dd2\u0d82\u0dc4 \u0d85\u0d9c\u0dca\u200d\u0dbb\u0db7\u0da2\u0db7\u0dad\u0dba\u0dad\u0dd4\u0db8\u0da2\u0db7 \u0dad\u0da2\u0dba\u0dd2 \u0dbd\u0d82\u0dd4\u0db7\u0dc1\u0dda \u0db4\u0db7\u0d9a\u0dbd\u0dd2\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc1\u0dda \u0dba\u0db7\u0dcf\u0dba \u0db8\u0dd6\u0dbd\u0dba \u0dd4\u0dc5\u0da2\u0dad\u0db7\u0dd4\u0dba\u0dda\u0dc3 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dba\u0da7 \u0db6\u0d82\u0dc1\u0dd4\u0ddc\u0dc1\u0dbd\u0ddc\u0db8\u0dad \u0dc1\u0dad\u0ddc\u0dba \u0da2 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0db1\u0dd3\u0dad\u0dba\u0db1\u0dd4\u0dd6\u0dbd\u0dbd \u0dc0\u0dd2\u0dc3\u0db3\u0dd4\u0da2 \u0dc1\u0db4\u0dad \u0dd9\u0dc2 \u0dc3\u0dc0\u0db7 \u0da7 \u0dc1\u0dd9\u0dad\u0db7\u0dc1\u0dda."
