    "date_str": "2024-07-11",
    "description": "Hansard of July 11, 2024",
    "url_metadata": "https://www.parliament.lk/en/business-of-parliament/hansards",
    "lang": "si-ta-en",
    "url_pdf": "https://www.parliament.lk/uploads/documents/hansard/1721730339072055.pdf",
