    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7 \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1 \u0d9a\u0dca\u0d9a\u0dc1\u0dc2\u0dca\u200d\u0dbb\u0dba \u0db8\u0dad\u0dca\u0dad\u0dc1\u0dad\u0dcf\u0dad\u0dca\u0dad \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba \u0dc1\u0db4\u0dc5 \u0dd2\u0dc3\u0db7\u0dcf\u0db8\u0dc1\u0d86\u0daf\u0dd3 \u0dbb\u0dd4\u0dc0\u0dca\u0dc1\u0db8\u0dca \u0dd2\u0db1\u0dba\u0dba\u0da7 30\u0d9a\u0dca\u0d9a \u0dc1\u0dc6\u0dca\u0dda \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0dd2\u0db1\u0dba\u0dba\u0da7 30\u0d9a\u0dca\u0d9a \u0dc1\u0dc6\u0dca\u0dda \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dba\u0dd4\u0d9a\u0dca\u0d9a\u0dad\u0dd2 \u0dc3\u0dc4\u0db8\u0dad ? 10 \u0db4\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0dad\u0dca\u0dad \u0dc1\u0dc0\u0da0\u0dca\u0da0 \u0dc5\u0db8\u0dc1\u0dba\u0d9a\u0dca\u0d9a \u0d9a\u0dd2\u0dba\u0dca\u0dc1\u0dca \u0dc3 \u0dc5\u0db8\u0dba\u0dcf \u0d85\u0dc0\u0dd4\u0dbb\u0dd4 \u0daf 10\u0d9a\u0dca\u0d9a 15\u0d9a\u0dca\u0d9a \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dba\u0da7 \u0d9a\u0dcf\u0dbd\u0dba \u0d9a\u0dca\u0db4 \u0d9a\u0dbb\u0db4\u0dd4 \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dca\u0d9a. \u0dc3 \u0dc5\u0db8\u0dba\u0dcf\u0da7 \u0dc1\u0dc6\u0dca\u0dda \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d9a\u0dd2\u0dd2\u0db1\u0db8 \u0dc0\u0dc3\u0d9a \u0d9a\u0dd2\u0dba\u0dca\u0db1 \u0db3\u0dca\u0dc4\u0dca. \u0dc3\u0db8\u0dc4\u0dbb\u0dd4 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0db8\u0dab\u0dd2\u0dad\u0dba\u0dba\u0dd2 \u0db7\u0dcf\u0dc2\u0dcf\u0dc0\u0dba\u0dd2 \u0d86\u0db8\u0db8\u0dba\u0dd2 \u0dc1\u0dc6\u0dca\u0dda \u0db1\u0dda \u0d94\u0db3 \u0dc1\u0dc6\u0dca\u0dda \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc1\u0db8\u0dcf\u0db1 \u0dba\u0dd4\u0d9a\u0dca\u0d9a\u0dad\u0dd2\u0dba\u0d9a\u0dca\u0d9a \u0dc3 \u0dad\u0dd4\u0dc5 \u0dad\u0dd2\u0dc1\u0db3\u0dca\u0dc1\u0dca? \u0dc3 \u0dad\u0dd4\u0dd2\u0db6\u0dca \u0d9a\u0dd4\u0dc3\u0dbd\u0dad\u0dcf\u0dc0 \u0db8\u0db1\u0dd2\u0db1\u0dc0\u0dcf ? \u0d94\u0dd4\u0dab \u0dc1\u0dc4\u0dcf \u0dc0\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dd2\u0da7\u0d9a\u0dc1\u0dba\u0d9a\u0dca\u0d9a \u0d9a\u0dbb\u0dca\u0db1 \u0db3\u0dca\u0dbb\u0dd2 ? \u0dc1\u0dc4\u0dcf \u0dc0\u200d\u0dbb \u0dc1\u0dd2\u0dda\u0db4\u0dd2\u0dc1\u0dba\u0d9a\u0dca\u0d9a \u0d9a\u0dbb\u0dca\u0db1 \u0db3\u0dca\u0dbb\u0dd2 ? \u0d85\u0dc1\u0dda \u0dbb\u0dc1 \u0db4 \u0dc1\u0dc4\u0dcf \u0dc0\u200d\u0dbb \u0dc1\u0dd2\u0dda\u0db4\u0dd3\u0dca \u0daf\u0dca\u0db1\u0dc0\u0dcf; \u0dc1\u0dc4\u0dcf \u0dc0\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dd2\u0da7\u0d9a\u0dba\u0dca \u0daf\u0dca\u0db1\u0dc0\u0dcf. \u0dd2\u0dc3\u0dd2\u0dc3\u0db0 \u0d9a\u0dca\u0d9a\u0dc1\u0dc2\u0dca\u200d\u0dbb\u0dc0\u0dbd \u0db1\u0dd2\u0dbb\u0dad \u0dc1\u0dc0\u0da0\u0dca\u0da0 \u0db4\u0dd4\u0daf\u0dca\u0db8\u0dbd\u0dba\u0dca \u0daf\u0dca\u0db1\u0dc0\u0dcf. \u0dc4\u0dca\u0db3\u0dca\u0dba\u0dd2 \u0dc3 \u0d85\u0dba \u0d94\u0d9a\u0dca\u0d9a\u0dc1\u0d9a\u0dcf\u0db8 \u0dc1\u0dc6\u0dca\u0dda. \u0d9a\u0dcf\u0dca\u0dad\u0dcf\u0dc0\u0dca \u0dc3\u0dd2\u0dc3\u0db3\u0dbd \u0db8\u0dca\u0dca\u0dc0\u0dd3\u0dc1\u0dda \u0db4\u0db1\u0dad \u0dc4\u0dbb\u0dc4\u0dcf \u0d85\u0db4\u0dd2 \u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dbb\u0dca\u0dba\u0dc1\u0dba\u0dca \u0dc1\u0dda \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0dc0\u0dad\u0dca\u0dad \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba \u0dc1\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d9c \u0dba \u0dc1\u0dda \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0dc0 \u0dca\u0db1\u0da7\u0db8\u0dad\u0dca\u0dad \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba \u0dc1\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db3\u0dca\u0dc1\u0dca.\n\n1345 1346\n\n[\u0db8\u0dbb\u0dd4 \u0d85\u0db1\u0dd4\u0db4 \u0db4\u0dc3\u0dca\u0d9a\u0dd4\u0dc0\u0dda \u0db8\u0dc4\u0dad\u0dcf]\n\n2024 \u0da2\u0dd6\u0db1\u0dd2 20\n\n\u0db8\u0dca\u0dca\u0dc0\u0dd3\u0dc1\u0dda \u0db4\u0db1\u0dad \u0dc4\u0dbb\u0dc4\u0dcf \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0da5\u0dcf\u0dda\u0dad\u0dd2\u0dba\u0da7 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dad\u0dd2\u0dba\u0da7 \u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dbb\u0dca\u0dba\u0dc1\u0dba\u0dca\u0db8 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0d91\u0dba \u0dc1\u0dda \u0dad\u0dd4\u0dd2\u0db6\u0dca \u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dbb\u0dca\u0dba \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dcf.\n\n\u0dc1\u0d9a\u0dcf\u0dd2\u0da7\u0dc2\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0db8\u0d9f\u0dd2\u0dca \u0d9a\u0dcf\u0dca\u0dad\u0dcf\u0dc0\u0dca \u0dc3\u0dd2\u0dc3\u0db3\u0dbd\u0db8\u0dca\u0dca\u0dc0\u0dd3\u0dc1\u0dda \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0d91\u0dba\u0da7 \u0d85\u0db1\u0dd4\u0db8\u0dca\u0dad\u0dd2\u0dba \u0dbd\u0db3\u0dcf\u0dc1\u0db8\u0db1 \u0d9a\u0dca\u0db6\u0dd2\u0db1 \u0db4 \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0dba\u0da7 \u0daf\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dad \u0d9a\u0dc5\u0dcf\u0db8 \u0d9a\u0dca\u0db6\u0dd2\u0db1 \u0db4 \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0dba\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0d85\u0dc0 \u0dba \u0db1\u0dda \u0dc3\u0d9a\u0da7 \u0dc3\u0d9c\u0dc1 \u0ddd\u0db0\u0db1 \u0daf\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dad \u0d9a\u0dbb\u0dca\u0db1. \u0daf\u0dca \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0dc0 \u0db8\u0dca\u0dc3 \u0db4 \u0d9a\u0dbb\u0dbd\u0dcf \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0dda\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0db8\u0dc3\u0d9a\u0dca\u0d9a \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0dc3\u0d9a \u0daf\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dad \u0d9a\u0dbb\u0dca\u0db1 \u0dd1\u0db1\u0dd1. \u0dc3 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0dc1\u0d9a\u0dcf\u0dd2\u0da7\u0dc2\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a\u0dbb\u0dca\u0db1 \u0dd1\u0db1\u0dd1 \u0dc1\u0dda \u0db4\u0db1\u0dad \u0d85\u0db1\u0dd4\u0dc0 \u0dd2\u0db1\u0dba\u0dbd\u0dd4\u0db8 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d9c \u0dc1\u0dda \u0dc3\u0dd2\u0dc3\u0db3\u0dbd\u0db8\u0dca\u0dca\u0dc0\u0dd3\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dad\u0dd2\u0dba\u0da7 \u0d91\u0d9a\u0d9f \u0db1\u0dca\u0daf\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a. \u0dc3 \u0dc3 \u0dc4\u0dcf \u0db1\u0dd3\u0dad\u0dba\u0db1\u0dd4\u0dd6\u0dbd\u0dbd\u0dc0 \u0d9a\u0dca\u0db8\u0dca\u0dad\u0dca\u0dad\u0dad \u0dbd\u0db3\u0dcf \u0db8\u0dca\u0db1\u0dd3\u0dc1\u0dda \u0dc0\u0db8\u0d9a\u0dd3\u0db8\u0d9a\u0dca\u0d9a \u0d85 \u0dcf\u0dc5 \u0dc1\u0d9a\u0dcf\u0dd2\u0da7\u0dc2\u0dca \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0dc1\u0db8\u0dca\u0db8 \u0d85 \u0dcf\u0dc5 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0dbb\u0dba\u0dcf\u0da7\u0dad\u0dca\u0dad \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dcf. \u0dc1\u0dda \u0dad\u0dd4\u0dc5 \u0daf\u0dad\u0dcf\u0db8 \u0dc0\u0dca \u0db8\u0dad\u0dca\u0dad \u0dc1\u0daf\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0dc3\u0db8\u0dcf\u0da2 \u0dc3\u0dd2\u0dc3\u0db3\u0dbd\u0db8\u0dca\u0dca\u0dc0\u0dd3\u0db8 \u0dc4\u0dcf \u0dc1\u0db4\u0ddd\u0dc2\u0dab\u0dba. \u0dc3\u0db8\u0dcf\u0da2 \u0dc3\u0dd2\u0dc3\u0db3\u0dbd\u0db8\u0dca\u0dca\u0dc0\u0dd3\u0dc1\u0dda\u0daf\u0dd3 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0d9a\u0dcf\u0dca\u0dad\u0dcf\u0dc0 \u0dc3\u0dd2\u0dc3\u0db3\u0dbd\u0db8\u0dca\u0dca\u0dc0\u0dd3\u0dc1\u0dda\u0daf\u0dd3 \u0dc1\u0db4\u0ddd\u0dc2\u0dab\u0dba \u0d85\u0dad\u0dd2 \u0dba\u0dd2\u0dca\u0db8 \u0dc0\u0dca \u0db8\u0dad\u0dca\u0dad. \u0d85 \u0dad\u0dd2\u0dc1\u0db3\u0dca\u0dc1\u0dca \u0db4\u0dcf\u0dca \u0db4\u0dd2\u0da7\u0dd2 \u0dc1\u0db4\u0ddd\u0dc2\u0dab\u0dba\u0d9a\u0dca\u0d9a. \u0db4\u0dcf\u0dca \u0db4\u0dd2\u0da7\u0dd2 \u0d9a\u0dcf\u0dbd\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db0\u0dd2\u0dbb\u0dcf\u0da2\u0dba \u0dd2\u0dc3\u0dc1\u0dbb\u0ddd\u0db0\u0dd3 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0dca\u0dc1\u0dca. \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0dda\u0dca\u0dad\u0dd4\u0dc1 \u0dad\u0dca\u0dad \u0db4\u0dcf\u0dca \u0db4\u0dd2\u0da7\u0dd2; \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d9c \u0dc0\u0dbd\u0dad\u0dca\u0dad \u0db4\u0dcf\u0dca \u0db4\u0dd2\u0da7\u0dd2; \u0dc1\u0daf\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0db4\u0d9a\u0dca\u0d9a\u0dc2\u0dc0\u0dbd\u0dad\u0dca\u0dad \u0db4\u0dcf\u0dca \u0db4\u0dd2\u0da7\u0dd2."
  },
