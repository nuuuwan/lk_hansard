d9a8[ \u0d8b:\u0dc0\u0dc4\u0dba\u0dda[ \u0da7 \u0d9c \u0d9a\u0dc1\u0dad\u0dc0 \u0d9a \u0db6\u0dd4\u0d9a \u0d9a\u0dc3\u0dd2\u0dcf\u0dc4\u0d9a \u0dc4\u0dc0 \u0d85\u0d9c\u0d9a8 \u0d9a\u0dad \u0dd2\u0dbb[ \u0d86\u0daf \u0dc1:\u0dc1\u0dca \u0dba \u0dad\u0dc08 \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0d85\u0dad\u0dd2\u0daf\u0dd4 \u0dc0\u0d9a \u0d86\u0db4:\u0dc08 \u0da7 \u0d9a\u0dca \u0dc0\u0dd4\u0dda\u0dc0. \u0d85\u0dc1\u0dda \u0d86\u0dba\u0dca\u0dc2\u0dca\u0da8 \u0dba\u0dc0\u0dba\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dc0 \u0db4\u0dca\u200d\u0dbb \u0dc0 \u0dc5\u0dc0 \u0d92 \u0dc18\u0db1\u0dd4\u0dc18\u0db1\u0dca \u0dc1\u0db8\u0da0\u0dca\u0da1\u0dbb\u0dba \u0dc1\u0db8\u0da0\u0dca\u0da1\u0dbb\u0dba \u0daf\u0dca \u0dc3 :\u0dd0\u0db4\u0dad\u0db8\u0dc0 \u0dd2\u0dbb[\u0d9a\u0dc0. \u0d9c\u0dcf8\u0dad\u0dd4\u0dba\u0da7 [\u0da7 \u0dc0\u0dd4\u0dab\u0dd4 \u0dc18\u0d9a\u0dc0\u0dc1 \u0dba \u0dad\u0dc08\u0da7 \u0dd1\u0db8 \u0da7\u0dd2 \u0dca \u0d8b[\u0dc0 \u0d9c\u0db1\u0dca \u0daf\u0dd4\u0db0\u0dd2[\u0dca \u0dd0\u0dc4\u0dd0. \u0d92 \u0daf \u0dc4\u0dc0 \u0dca\u0dc2\u0dca\u0da8\u0dab\u0dd2 8\u0dd0\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc18\u0dc5\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2[\u0dc0 \u0d9a\u0db8 \u0dc18\u0db1\u0dca \u0d95 \u0dd1. \u0dd4\u0daf \u0d9a \u0d91\u0dc1\u0dc4\u0db8 \u0dc3\u0dd2 ) \u0dc18\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dd0\u0dc4\u0dd0. \u0dad\u0db3\u0dad\u0dd4\u0db8\u0db1\u0dca\u0d9a\u0dc0 \u0dba\u0dba[ \u0dc4\u0dd0\u0da7\u0dd2[\u0da7 \u0d92 \u0daf\u0dd4\u0db0\u0dd2[\u0da7 \u0daf\u0dd4[:\u0db4\u0dad \u0dc5 \u0d9a \u0dba \u0dad\u0dc08\u0dc1\u0d9c\u0db1\u0dca \u0d92 \u0db4\u0dd2\u0dd2\u0db6\u0db3 8 \u0d9a\u0dd0\u0dc1\u0db3 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbb\u0dc0\u0dba[ \u0d9c\u0dd0 \u0d85\u0db4\u0da7 \u0daf\u0dad\u0dd4 \u0db8\u0dca \u0dc18\u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd48\u0db1\u0dca \u0db8\u0dca \u0dd0\u0dc4\u0dd0. \u0dc1\u0db8\u0dc0 : \u0d85\u0db4\u0dd2 \u0d92 \u0dc1 8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc1[\u0ddd\u0d9c\u0dd2 8 \u0d85 \u0d9a \u0daf\u0dd4\u0db3\u0dd2 8\u0dc0.\n\n\u0d85\u0db4\u0dd2 \u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1[\u0db1\u0dca\u0db8 \u0dbb\u0dca\u0dbd\u0db8\u0dc0\u0db1\u0dca\u0dad \u0dc0\u0d9a\u0dc0 \u0d87\u0dad\u0dd2 \u0dba \u0dc1 \u0dc0\u0da7 \u0d92 \u0dc18\u0db1\u0dca \u0d95 \u0dd1 \u0dc1 \u0dc0\u0dc1\u0dc4\u0dc0\u0db8: \u0dd2\u0dbb[\u0d9a\u0dc0 \u0db3\u0d9a\u0db1\u0dca \u0d95 \u0dd1. \u0dc1\u0db4\u0dad \u0da7\u0dba\u0dd4\u0dad\u0dd48\u0d9a\u0daf\u0dd3 \u0dc18\u0dc58\u0dca \u0dc1\u0d9c\u0dc0\u0da9 \u0dba 8\u0dc0 \u0d8a\u0dc5\u0d9f\u0da7 \u0d87\u0dc5 \u0db8\u0dc0\u0dbb\u0dca\u0dbd\u0d9c \u0dc4\u0dba\u0daf\u0dda \u0dba 8\u0dc0 \u0dc1\u0db4\u0dad8\u0dc0 \u0db1\u0dd2\u0daf\u0dc0 \u0d9a \u0d85\u0db4\u0dd2 \u0d86\u0db4:\u0dc08\u0da7 \u0d9a\u0dca \u0dc18\u0d9a\u0dc0 \u0dad\u0dd2\u0dc1\u0db3 8\u0dc0. \u0dc1\u0db4\u0dad \u0db4\u0dc0\u0dba \u0d86\u0db4\u0dd4 \u0d9c\u0dcf8\u0dad\u0dd4\u0dba\u0da7 \u0dc5\u0dd4\u0dad\u0dba \u0daf\u0dd2\u0daf\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dca \u0dc1\u0dad \u0dc4\u0dd0\u0db8 \u0d9c\u0dc4\u0dca\u0db8 [\u0da7 \u0dc0\u0dd4\u0dda\u0dc0. \u0dc1 \u0d9a \u0d9c\u0daf\u0dda \u0dad\u0dca\u0dc1 \u0ddd\u0db8 \u0da7\u0dd2 \u0db8\u0dd0\u0dbb\u0dd2\u0d9a\u0dc0 \u0d9c\u0dd2[\u0dc0. \u0d89\u0dad\u0dd2\u0dc4\u0dc0\u0daf\u0dc1\u0dad 8:\u0dc08 \u0d9a \u0d91\u0dc1\u0dc4\u0db8 \u0dc0\u0dd4\u0dc1\u0da9\u0dd4\u0d9a \u0dd0\u0dc4\u0dd0; \u0d9c\u0daf\u0dda \u0db8\u0dd0\u0dc0 \u0dc1\u0da9\u0dd4\u0d9a \u0dd0\u0dc4\u0dd0. \u0dd4\u0daf \u0d9a \u0dc1\u0db4\u0dad \u0d858\u0daf\u0dda\u0dae\u0dc0\u0dc1 8\u0dad\u0dd4\u0dba \u0d92 \u0dad\u0dba\u0db4\u0dad \u0daf\u0dd4\u0dc2\u0dca\u0da8\u0dba\u0dd2. \u0d9c\u0dcf8\u0dad\u0dd4\u0dba \u0dc18\u0d9a\u0dc0\u0dc1 \u0daf\u0dd3 8\u0dad\u0dd4\u0dc1\u0dbb\u0dca\u0dbd \u0dc3\u0dd2\u0da7\u0dd2 \u0db8\u0dc0\u0dc5\u0dd4\u0dc18\u0ddd \u0d9a \u0dad\u0dd2[ \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0d9a\u0dc0"
