a\u0dad\u0dd2\u0dc1[\u0db1\u0dca \u0d85\u0dba\u0dd2\u0db1\u0dca \u0dc0\u0dd4\u0dda\u0dc0. \u0d91\u0db8 \u0db1\u0dd2\u0daf\u0dc0 \u0d92 \u0dc1\u0d9c\u0dc0\u0db8\u0db1\u0dca \u0dc4 8\u0d9c\u0dc08\u0da7 \u0daf\u0dc4 \u0dc18 \u0d9a 8\u0d9c\u0dc08\u0d9a\u0da7 \u0dc1[\u0dc0\u0dd4\u0daf \u0dc0\u0dd4\u0dc1\u0da9\u0dd4\u0d9a \u0dd0\u0dc4\u0dd0. \u0d92 \u0db4\u0dd2\u0dd2\u0db6\u0db3 8 \u0d858)\u0dc0 [ \u0dc1[\u0dc0\u0dd4\u0daf \u0dba\u0d9a\u0dc0 \u0d92 \u0d85[\u0da7 \u0dd4\u0daf:\u0dca \u0d9a\u0db3\u0dc0 \u0dc1:\u0db1\u0dca \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dba\u0db1\u0dca \u0dd2\u0dbb[\u0dc0 \u0db8\u0dc0 \u0d89\u0dca \u0d9a 8\u0dc0. \u0d92 \u0daf \u0dc4\u0dc0 \u0dad\u0db3\u0dad\u0dd4\u0db8\u0dc0\u0dc1\u0dda \u0daf\u0dc4 \u0dca\u0dc2\u0dd2 \u0dbb\u0dca\u0dbd\u0db8 \u0d85\u0db8\u0dc0\u0dad\u0dba\u0dc0\u0dcf \u0dc1\u0dad \u0db8\u0dd0\u0daf\u0dd2\u0dc4 \u0d9a\u0db8\u0db8 \u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2 \u0dd2\u0dbb[ \u0dc0\u0dba\u0dda[ \u0db8\u0db8 \u0dc1\u0db4\u0dad \u0d858\u0daf\u0dda\u0dae\u0dc0\u0dc1 \u0daf\u0dd3 \u0db8\u0dad\u0dca \u0dba 8\u0dc0."
