    "chunk_text": "\u0d85\u0db4\u0dd2 \u0dc0\u0dd0\u0dd4\u0db4\u0dda \u0dc0\u0dd2\u0dc2\u0db8\u0dad\u0dcf \u0dca\u200d\u0dbb \u0dae\u0db1 \u0db8, \u0dc0\u0dd2\u0dd4\u0dc4\u0dc4\u0dbd\u0dca\u0db4\u0dad\u0dd2 \u0daf\u0dd3\u0db8\u0db1\u0dcf \u0dca\u200d\u0dbb \u0dae\u0db1 \u0db8, \u0dc3\u0db1\u0dca\u0db1\u0dd2\u0dc1\u0dda\u0daf\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf \u0dca\u200d\u0dbb \u0dae\u0db1 \u0db8, \u0d9c\u0db8\u0db1\u0dca \u0dc0\u0dd2 \u0daf\u0dda \u0dca\u200d\u0dbb \u0dae\u0db1 \u0db8 \u0d9c\u0dd0\u0db1 \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0d9a\u0dbb\u0db8\u0dd4. \u0d92 \u0dc0\u0dcf\u0dc1 \u0db8 \u0d85\u0dbb, \u0dc1\u0dbb\u0dad\u0dab\u0dd2\u0dba\u0dda -\u0dc1\u0dda\u0d9a \u0db8 \u0dc4\u0dbb\u0dd2 \u0dc0\u0dd2\u0dc4\u0dd2\u0dd4\u0dc0 \u0dc3\u0dc4\u0d9c\u0dad \u0d9a\u0dcf\u0dbb\u0dab \u0d9a\u0dca \u0dc1\u0db1\u0dca, \u0d9c\u0dbb\u0dd4 \u0dad\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2. \u0dba\u0dab\u0dca\u0dd4 \u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda \u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf \u0d9a\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2, II \u0dc1\u0dbb\u0dad\u0dab\u0dd2\u0dba\u0dda\u0dc1\u0dda \u0dc3\u0dd2\u0da7 I \u0dc1\u0dbb\u0dad\u0dab\u0dd2\u0dba\u0dda \u0da7 \u0d9a\u0dc3\u0dc3\u0dae \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0dad\u0da7 \u0db8\u0dd6\u0dbd\u0dd2\u0d9a \u0db4\u0da9\u0dd2 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 3000 \u0db8, 6000 \u0db8 \u0d85\u0dad\u0dbb \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab \u0d9a\u0dd2\u0db1\u0dca \u0d85\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf- \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dca\u200d\u0dbb \u0dae\u0db1 \u0db8 \u0dc0\u0dd2\u0dc3\u0db3\u0db1\u0dca\u0db1 \u0db6\u0dbd\u0db8\u0dd4.\n\n\u0d9c\u0dbb\u0dd4 \u0d9a\u0dcf\u0dcf\u0db1\u0dcf \u0d9a\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2, \u0db8\u0da7 \u0dad\u0dc0 \u0d91\u0d9a \u0dc1\u0daf \u0d9a\u0dca \u0d9a\u0dd2 \u0db1\u0dca\u0db1 \u0d85\u0dc0\u0dc3\u0dae\u0dcf\u0dcf\u0dc0 \u0dc1\u0daf\u0db1\u0dca\u0db1. \u0d9c\u0dbb\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2, \u0db8\u0dd2 \u0db1\u0dca\u0db8\u0dcf\u0dbb \u0da7 \u0dd2\u0dc4\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0d85\u0db1\u0dcf\u0dcf \u0dc0\u0dd4\u0dab\u0dd4 \u0daf\u0dbb\u0dd4\u0dc1\u0dc0\u0ddd \u0dc1\u0dc0\u0db8\u0dca\u0dc1\u0dc0\u0db8\u0dca \u0db8 \u0dc1\u0db4\u0dad\u0dbd\u0dca\u0daf\u0dd6\u0dc0 \u0dc4\u0db1\u0dca\u0daf\u0dd2\u0dc1\u0dda\u0db8 \u0dc1\u0dbd\u0dad\u0dc0\u0dda \u0d9a\u0dda\u0dc1\u0d9d\u0ddd\u0dc2\u0dab \u0d9a\u0dca \u0dc1\u0dda \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1\u0dda \u0db4\u0dd0\u0dc0\u0dd0 \u0db8\u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0dc1\u0dda \u0d9a\u0dbb\u0dd4\u0dab \u0db8 \u0db8\u0db8 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dc1 \u0d85\u0dc0\u0db0\u0dcf\u0db1 \u0da7 \u0dc1 \u0dad\u0db8\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0db1\u0dca. \u0dad \u0db8\u0dad\n\n1783 1784\n\n[\u0d9c\u0dbb\u0dd4 \u0dca\u200d\u0dbb\u0dc3\u0db1\u0dca\u0db1 \u0dbb\u0dab\u0dad\u0dd4\u0db8\u0d82\u0d9c \u0db8\u0dc4\u0dad\u0dcf]\n\n2024 \u0da2\u0dd6\u0dbd\u0dd2 10\n\n\u0dc0 \u0dc1 \u0db1\u0dca\u0db8 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda \u0d85\u0db4\u0dd2, \u0dc3\u0db8\u0dd2\u0dc4 \u0da2\u0db1 \u0db6\u0dbd\u0dc1\u0dda\u0d9c\u0dc1\u0dda, \u0dc3\u0db8\u0dd2\u0dc4 \u0da2\u0db1 \u0dc3\u0db1\u0dca\u0db0\u0dcf\u0db1\u0dc1\u0dda \u0d9c\u0dbb\u0dd4 \u0dc0\u0dc3\u0db1\u0dca\u0dad \u0dcf\u0db4\u0dcf\u0db6\u0dab\u0dca\u0da9\u0dcf\u0dbb \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0db8, \u0d9c\u0dbb\u0dd4 \u0dc3\u0dd4\u0da2\u0dd2 \u0db8 \u0dc3\u0d82\u0da2 \u0dc1\u0db4\u0dc1\u0dbb\u0dca\u0dbb\u0dcf \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0db8, \u0d9c\u0dbb\u0dd4 \u0dc1\u0dda.\u0dc3\u0dd3. \u0d85\u0dbd\u0dc0\u0dad\u0dd4\u0db8\u0dc0\u0dbd \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0db8,- [\u0db6\u0dcf\u0db0\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0dda] \u0dc1\u0dda \u0d9a\u0dcf\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db8\u0dd2 \u0db1\u0dca\u0db8\u0dcf\u0dbb\u0dc1\u0dda \u0d85\u0db1\u0dcf\u0dcf \u0dc0\u0dd4\u0dab\u0dd4 \u0daf\u0dbb\u0dd4\u0dc1\u0dc0\u0ddd \u0d9c\u0dd0\u0db1. \u0d92 \u0dc1\u0dc0\u0db8\u0dca\u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dcf\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db8\u0da7 \u0dc0\u0dd2\u0db1\u0dcf\u0da9\u0dd2 \u0d9a\u0dca \u0dc1\u0daf\u0db1\u0dca\u0db1, disturb \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf.\n\n\u0d9c\u0dbb\u0dd4 \u0dad\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2, \u0dc1\u0dda\u0d9a\u0db1\u0dca \u0dca\u200d\u0dbb \u0dae\u0db1 . \u0db8\u0dd2 \u0db1\u0dca\u0db8\u0dcf\u0dbb\u0dc1\u0dda \u200d\u0dbb\u0dc3\u0dae\u0dad \u0d9a\u0db3\u0dc0\u0dd4\u0dbb\u0dd4 \u0dc1\u0daf\u0d9a\u0d9a \u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0dda \u0dc3\u0dc4 \u0d89\u0dad\u0dd2\u0dc1 \u0ddd\u0db4\u0dd2 \u0dcf\u0dc1\u0dda \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0daf\u0dd0\u0db1\u0da7 \u0dbb\u0db3\u0dc0\u0dcf\u0dc1\u0d9c\u0db1 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dcf. \u0db8\u0db8 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0da7 \u0d9a\u0dd2 \u0db1\u0dca\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0db1\u0dca, \u0daf\u0dd0\u0db1\u0dca \u0daf\u0dd2\u0db1 252\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0dae\u0dc1\u0dc3\u0dad \u0dc1\u0dda \u0d85 \u0dbb\u0db3\u0dc0\u0dcf\u0dc1\u0d9c\u0db1 \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0db6\u0dc0. \u0d89\u0db1\u0dca\u0daf\u0dd2 \u0dcf\u0dc0, \u0dc1\u0db1\u0dca\u0db4\u0dcf\u0dbd , \u0d9a\u0d9c\u0db1\u0dca\u0da9\u0dcf\u0dc0 \u0dc3\u0dc4 \u0dc1\u0db8\u0dad\u0dc1\u0dbb\u0dad\u0d9a\u0dca\u0dc1\u0d9a\u0ddd\u0dc0 \u0d9a\u0dd2 \u0db1 \u0dbb\u0da7\u0dc0\u0dbd\u0dca \u0dc1\u0d9a\u0dad\u0dc1\u0dc4\u0dad\u0db8 \u0dc4\u0dbb\u0dd2 \u0dbb\u0dcf\u0da2\u0dba \u0dad\u0dcf\u0db1\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0\u0d9a\u0dda \u0dc4\u0dbb\u0dc4\u0dcf \u0d92 \u0dbb\u0da7\u0dc0\u0dbd \u0daf\u0dbb\u0dd4\u0dc1\u0dc0\u0ddd \u0da7\u0dd2\u0d9a \u0dc1\u0dda \u200d\u0dbb\u0dc3\u0dae\u0dad \u0d9a\u0db3\u0dc0\u0dd4\u0dbb\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dcf\u0dc1\u0d9c\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0db8 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dc1\u0d9c\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf, \u0dc1\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0\u0dc1 \u0db1\u0dca \u0dc1\u0dc3\u0dad \u0dcf \u0db6\u0dbd\u0db1\u0dca\u0db1 \u0d9a\u0dd2 \u0dbd\u0dcf."
  },
