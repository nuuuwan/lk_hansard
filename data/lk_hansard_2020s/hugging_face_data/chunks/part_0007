    "chunk_text": "\u0dbd\u0db6\u0db7 \u0dc1\u0dcf\u0db1\u0dca\u0dad \u0dd9\u0dc2 \u0dd4\u0dcf\u0db7\u0dad\u0db7\u0dc3\u0dd4\u0dad\u0dd4\u0db8\u0da2\u0db7 \u0dd4\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dd4\u0dba\u0dba\u0dd2 \u0d9a\u0dd2\u0dc3\u0dbd\u0db7 \u0d85\u0db4\u0dd2 \u0dc0\u0dd2 \u0dca \u0db7\u0dc3 \u0dd4\u0dba\u0dad \u0db7. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0da2\u0da7 \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0db4\u0dca\u200d\u0dbb \u0dca\u0dad\u0dc3 \u0dc1\u0da2\u0dc3\u0dba\u0dd2. \u0dd9\u0dc2 \u0da2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0da2\u0db1\u0dd2 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0da2\u0db7 \u0db4\u0db4\u0dad\u0dc3\u0dca\u0dc3\u0db4\u0dad \u0dc1 \u0db1\u0dca\u0dad \u0d95\u0dad\u0dd1 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0da2\u0db7\u0dc1 \u0da2 \u0dd4\u0db3\u0dc0\u0dd4\u0dc1\u0dba\u0db1\u0dca. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0da2\u0db7 \u0d9a\u0dd2\u0dc3\u0dbb\u0dd4 news reports \u0dd9\u0dd0\u0dad \u0da2\u0da2\u0db8\u0dad \u0dc1\u0db4\u0ddc\u0da9\u0dca\u0dd0\u0dc2\u0dab \u0db6\u0dd0\u0dbd\u0dd4 \u0db7. \u0da2\u0da7 \u0dcf\u0dd0\u0dc1\u0dad\u0dad \u0d86\u0dd4\u0db7\u0dba\u0dc3\u0da7 \u0d92 \u0dc1\u0db6\u0ddc\u0dc1\u0dc4\u0ddd \u0dc1\u0dda \u0dbd\u0dca \u0dc3\u0da2\u0d9c\u0dd2 \u0dcf\u0dad \u0db6\u0dbd\u0dc1\u0dda\u0dd9\u0dc3\u0da7 \u0dc3\u0db4\u0dad\u0db6\u0db1\u0dca\u0db0 \u0db4\u0db7\u0d9a \u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0da2\u0db7\u0dcf \u0da2\u0db7\u0db0\u0dba \u0dad\u0dd4\u0db8\u0dc5 \u0db4\u0dc5 \u0dd4\u0dba\u0dad \u0dbd\u0dcf \u0dc1\u0dad\u0ddc\u0dba\u0dad\u0dd4\u0db8\u0dc2 . \u0dc3\u0da2\u0dc4\u0dba \u0dc0\u0dd2\u0da7 \u0d92 \u0d85\u0dc3 \u0dc4\u0dd2\u0dad\u0dad \u0db7 \u0dd2\u0dd2\u0dbb, \u0dc4\u0d9a\u0dc3 \u0da2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0da2\u0db7 \u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dc1\u0dad\u0daf\u0dd3 \u0dcf\u0dad\u0db7\u0db0\u0dd2\u0db4\u0dd2\u0dbb\u0dad\u0dd4\u0db8\u0da2\u0db7 \u0d91\u0dc2\u0dab\u0dd4 \u0d91\u0dd4\u0dad\u0dd4\u0db8 \u0dc1 \u0dba\u0dd2 \u0d9a\u0dd2\u0dc3\u0dbd\u0db7. \u0d92 \u0dc3\u0dd0\u0dd4\u0dc3 \u0dad\u0dd4\u0db8\u0dc5 \u0d91\u0dad\u0dd4\u0db8\u0da2\u0db7\u0da7 \u0dc1\u0db4\u0dad \u0d86\u0dd4\u0db7\u0dba\u0dc3\u0da7 \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0dd2\u0dad\u0dd4\u0db8\u0dc5\u0dd4 \u0dc1 \u0dad\u0db8\u0dad \u0db4\u0db7\u0d9a \u0dca \u0dad\u0d9a\u0dcf\u0dad\u0dc3 \u0dd4\u0dba\u0dad \u0db7 \u0d9a\u0dd2\u0dc3\u0dbd\u0db7 \u0dd2\u0dbd\u0dd2 \u0dd4\u0dba\u0db1\u0dca\u0dad \u0d8b\u0db8\u0dad\u0dc3\u0db7\u0dc4 \u0dd4\u0dba\u0dad \u0db7 \u0dd2\u0dd2\u0dbb.\n\n\u0d85\u0dc1\u0dad\u0dd4, \u0d85\u0db4\u0dd2 \u0dba\u0da7\u0dc2\u0dab \u0dc4\u0dd0\u0da7\u0dd2\u0dc3\u0da7 \u0dc3\u0dad \u0dd9\u0da2\u0db1\u0dca \u0da2\u0da7 \u0dc3\u0db4\u0dad\u0db4\u0dd6\u0d9a\u0dda\u0dc1\u0dc3\u0db1\u0dca\u0da2 \u0dc1 \u0dad\u0dc3\u0dca. \u0dd2\u0dc3\u0dca\u0dc3\u0dba \u0dc3\u0db4\u0dad \u0dc3\u0db4\u0dad \u0dc1\u0dda \u0dbd\u0dca \u0dc0\u0dd2\u0db1\u0dd2\u0dc0\u0dd2\u0dcf\u0dc0\u0db7 \u0dc1\u0dc3\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc1\u0dad\u0ddc\u0dc1 \u0db1\u0dca\u0dad \u0dd2\u0dd2\u0dbb. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d9a\u0dad\u0da2\u0db7\u0dad\u0dc1\u0dad \u0dc3\u0dd2\u0dc3\u0dbd\u0dd4\u0da2 \u0dd4\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dc0\u0dd2\u0db1\u0dd2\u0dc0\u0dd2\u0dcf\u0dc0\u0db7 \u0dc1\u0dc3\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc1 \u0dad \u0db7. \u0d92\u0dd4\u0da7 \u0dc1\u0dc4\u0dda\u0dad\u0dd4\u0db8 , \u0dc1\u0db4\u0dad \u0dba\u0dc1\u0da7\u0dca \u0d86\u0d9a\u0dae\u0dd2\u0dd4\u0dc3 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0db6\u0dba\u0db4\u0dad\u0dc5 \u0dd9\u0dd3\u0db4\u0da2\u0dc2\u0dab \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0da7 \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0db1\u0dd2\u0dc3\u0db7. \u0d85\u0db4\u0dd2 1 \u0dad\u0db7 \u0dc2\u0dab IMF \u0d91\u0dd4\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0db7 \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0db7. \u0d85\u0db4\u0dd2 1 \u0dad\u0db7 \u0dc2\u0dab IMF \u0d91\u0dd4\u0da7 \u0d9c\u0dd2 \u0dc1\u0dad \u0dd2\u0dba\u0dd2? \u0d85\u0db4\u0dd2 17 \u0dad\u0db7 \u0dc2\u0dab \u0dd4\u0dba\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0dc3\u0d82\u0dc3\u0dca\u0dd4\u0dba\u0dda \u0db1\u0dd2 \u0dd0\u0dba\u0dbb\u0dd2 \u0db1\u0dd2\u0dc3\u0dd2 \u0d86\u0dd4\u0db7\u0dba\u0dc3\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc3\u0db7\u0db8\u0dad\u0da2\u0dd4 \u0dc1\u0dad\u0ddc\u0dd4\u0dba\u0dbb\u0dd4 \u0db1\u0dd2\u0dc3\u0db7\u0dba\u0dd2. \u0d85\u0db4\u0dd2 \u0da7\u0dd2\u0dd4 \u0dd4\u0db7\u0dbd\u0dc3\u0dc2\u0dab \u0dc3\u0dad \u0db7 \u0d94\u0dc5\u0dd4 \u0d8b\u0dc3\u0dca\u0dc3\u0dad \u0db7 \u0d86\u0db4\u0dc4\u0dd4 \u0d92 \u0d94\u0dc2\u0dab\u0dc1\u0dd4\u0ddd\u0da7\u0da2 \u0db4\u0dba\u0dd2\u0db1\u0dca \u0dd9\u0dc4\u0dbd\u0db7 \u0db4\u0dd0\u0db8\u0dad\u0dad\u0dd4\u0da7 \u0dcf\u0da2\u0dad \u0db7 \u0d91\u0dc1\u0dc4\u0da2 \u0dad\u0dd0\u0db8\u0dad\u0dad\u0db4\u0dad \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0dc1 \u0dad\u0dc3\u0dca \u0dc1 \u0dad \u0db7 \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0dd2\u0dad\u0dd4\u0db8\u0dc1\u0dc5\u0dda \u0dc3\u0db4\u0dad \u0dc3\u0db4\u0dad \u0db4\u0db7\u0d9a \u0dca \u0dbd \u0dd4\u0db7\u0dba\u0dda\u0db7 \u0db1\u0dd2\u0dc3\u0db7 \u0dcf\u0db7\u0dad\u0dba\u0db1\u0dca\u0dad\u0dba\u0dc3\u0db8\u0dad \u0d91\u0dc2\u0dab\u0dd4 \u0d91\u0dd4\u0da7 \u0dc3\u0db1\u0dca\u0dad \u0d95\u0dad\u0dd1 \u0d9a\u0dd2\u0dc3\u0dad \u0da2\u0dad\u0dc3\u0da7 \u0d85\u0db4\u0da7 \u0d91\u0dd4\u0da7 \u0dc1 \u0db1\u0dca\u0dad \u0db6\u0dd0\u0dc4\u0dd0 \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0dc1\u0dda \u0db4\u0db7\u0dbd\u0dad \u0db6\u0dbd\u0db4\u0dd1\u0db4\u0dad \u0d91\u0dad \u0db7. \u0d8a\u0da7 \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dda \u0dd2 \u0db8\u0dad \u0dd4\u0dba \u0dd9\u0dd0\u0db1\u0dd3\u0da2 \u0dc3\u0dd2\u0daf\u0dd4 \u0dd4\u0dba\u0dad \u0db7. \u0dba\u0db7\u0dcf\u0dba \u0dda\u0dc3 \u0dd4\u0dc5\u0da2\u0dad\u0db7\u0dd4\u0dba\u0dda \u0db4\u0dad\u0db8\u0dad \u0dc1\u0dd4\u0db8\u0dca\u0db4\u0dad\u0db4\u0dad \u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0db1\u0dca \u0d9a\u0dad\u0da2\u0db7\u0dad\u0dc1\u0dad \u0d85\u0db4 \u0db8\u0dd4\u0dc4\u0dd4\u0dda \u0dc1\u0dcf\u0dad \u0dd9\u0dd0\u0da7\u0dbd\u0dd4 \u0dba\u0db7\u0dc1\u0dd2\u0dc3\u0da7 \u0d85\u0dad\u0db7\u0dd9\u0dad\u0dc1\u0dad \u0db8\u0dd4\u0dc4\u0dd4\u0dda \u0dc1\u0dad\u0ddc\u0dc1\u0dcf\u0dad \u0da2\u0d82\u0dc1\u0db4\u0dad\u0dc2\u0dab \u0dc0\u0dd2 \u0dd8\u0dad \u0dc1 \u0dad \u0db7. \u0d92 \u0dc4\u0dd2\u0db1\u0dca\u0dcf\u0db7 \u0da2\u0db7 \u0dc4\u0dd2\u0dad\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dad\u0dd0\u0dc4\u0dd0 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0da2\u0db1\u0dca\u0dbd\u0db7 \u0dd4\u0dc0\u0dd4\u0dc2 \u0db8\u0dad \u0dc1\u0db4\u0dad\u0dd4\u0da7 \u0dc0\u0dd2\u0dc2 \u0dda\u0db0 \u0dd4\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dd4\u0dba\u0dba\u0dd2 \u0d9a\u0dd2\u0dc3\u0dbd\u0db7."
