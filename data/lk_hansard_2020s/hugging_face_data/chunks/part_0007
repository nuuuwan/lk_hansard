    "chunk_text": "\u0b8f\u0bb1\u0bcd\u0ba4\u0b95\u0ba9\u0bae\u0bb5, \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bc6\u0bbe\u0b9f\u0bc1 \u0ba4\u0baa\u0bc6\u0bbe\u0bb0\u0bc1\u0bb3\u0bc6\u0bbe\u0ba4\u0bc6\u0bbe\u0bb0 \u0bc6\u0bbe\u0bc0\u0ba4\u0bbf\u0baf\u0bc6\u0bbe\u0b95 \u0bb5\u0bc0\u0bb4\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1 \u0bae\u0baa\u0bc6\u0bbe\u0baf\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0ba8\u0bbf\u0bb2\u0bb2\u0baf\u0bbf\u0bb2\u0bcd, \u0b95\u0bb2\u0bcd\u0bb5\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0b95\u0bcd\u0b95\u0bb2\u0bb1\u0baf\u0bbf\u0bb2\u0bcd\u0bb2\u0bc6\u0bbe\u0bc8\u0bb2\u0bcd \u0ba8\u0bc6\u0bbe\u0b9f\u0bcd\u0bb2\u0b9f\u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bc1 \u0ba4\u0bb5\u0bb3\u0bbf\u0bae\u0baf\u0bb1 \u0bae\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bc8\u0ba9 \u0b87\u0bb2\u0bb3\u0b9e\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bbf\u0ba8\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0ba3\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b9a\u0bc2\u0bb4\u0bb2\u0bbf\u0bae\u0bb2, \u0bc8\u0ba4\u0bc1\u0baa\u0bc6\u0bbe\u0ba9\u0b9a\u0bc6\u0bbe\u0bb2\u0bb2\u0b95\u0bb3\u0bcd \u0ba4\u0bbf\u0bb1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc6\u0bbe\u0ba9\u0ba4\u0bc1, \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b87\u0bb3\u0bae\u0bcd \u0b9a\u0bae\u0bc1\u0ba4\u0bc6\u0bbe\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bb2\u0bb0\u0baf\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0bb1\u0bcd\u0bb1\u0bc6\u0bbe\u0b95 \u0b85\u0bb4\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bc6\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0ba9\u0bcd \u0b85\u0bb2\u0bc8\u0baf\u0bc1\u0bae\u0bcd. \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb2\u0bb3 \u0bc8\u0ba4\u0bc1\u0baa\u0bc6\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0b9f\u0bbf\u0bb2\u0bc8\u0baf\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b92\u0bb0\u0bc1 \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bcd\u0bb2\u0b9f \u0bae\u0ba8\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0ba4\u0bc6\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0ba9\u0bcd \u0b87\u0ba4\u0bc1 \u0b85\u0bb2\u0bc8\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0bb2\u0b95\u0ba4\u0bcd\u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bb1 \u0b9a\u0bc6\u0bbe\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bb2\u0bb3 \u0bae\u0bc8\u0bb1\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb5\u0bb2\u0ba4 \u0bb5\u0bbf\u0b9f, \u0bc8\u0ba4\u0bc1\u0baa\u0bc6\u0bbe\u0ba9\u0b9a\u0bc6\u0bbe\u0bb2\u0bb2\u0b95\u0bb2\u0bb3\u0ba4\u0bcd \u0ba4\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0ba4\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0bc8\u0bc6\u0bbe\u0b95 \u0bb5\u0bb0\u0bc1\u0bc8\u0bc6\u0bbe\u0ba9\u0ba4\u0bcd\u0bb2\u0ba4 \u0b88\u0b9f\u0bcd\u0b9f\u0bbf\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0bb2\u0bc6\u0bbe\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bb2\u0b9f \u0baf\u0bbf\u0bb2\u0bc1\u0bae\u0bcd, \u0baa\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0bb3\u0bc1\u0bc8\u0ba9\u0bcd\u0bb1 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bc8\u0ba4\u0bc1\u0baa\u0bc6\u0bbe\u0ba9\u0b9a\u0bc6\u0bbe\u0bb2\u0bb2 \u0b85\u0ba9\u0bc1\u0bc8\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0bb2\u0bb3 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0ba9\u0bcd\u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bb2\u0b9f\u0baf \u0b86\u0ba4\u0bb0\u0bb2\u0bb5\u0baa\u0bcd \u0ba4\u0baa\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0bb2\u0bc6\u0bbe\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bb2\u0b9f \u0baf\u0bbf\u0bb2\u0bc1\u0bae\u0bc8 \u0b85\u0bb0\u0b9a\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b9a\u0bbf\u0bb2 \u0b85\u0bb0\u0b9a\u0bbf\u0baf\u0bb2\u0bcd\u0bb5\u0bc6\u0bbe\u0ba4\u0bbf\u0b95\u0bb3\u0bcd \u0bc8\u0ba4\u0bc1\u0baa\u0bc6\u0bbe\u0ba9\u0b9a\u0bc6\u0bbe\u0bb2\u0bb2 \u0b85\u0ba9\u0bc1\u0bc8\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0bb2\u0bb3\n\n1927 1928\n\n[\u0d9c\u0dbb\u0dd4 \u0d91\u0dc3\u0dae. \u0dc0\u0dd2 \u0dcf\u0dc1\u0dbd\u0dca\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dcf ]\n\n2024 \u0da2\u0dd6\u0dbd\u0dd2 10\n\n\u0b95\u0b9f\u0ba8\u0bcd\u0ba4 08\u0b86\u0bae\u0bcd, 09\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0bb5\u0b9f \u0bc8\u0bc6\u0bbe\u0b95\u0bc6\u0bbe\u0ba3\u0bae\u0bcd \u0b89\u0b9f\u0bcd\u0baa\u0b9f \u0ba8\u0bc6\u0bbe\u0b9f\u0bc1\u0baa\u0bc2\u0bb0\u0bc6\u0bbe\u0bb5\u0bc1\u0bae\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb1\u0bcd\u0b9a\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bb0\u0bcd \u0bae\u0baa\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0ba4\u0b9a\u0baf\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd \u0ba4\u0bc6\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bc6\u0bbe\u0b95, \u0bb5\u0b9f \u0bc8\u0bc6\u0bbe\u0b95\u0bc6\u0bbe\u0ba3 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bae\u0baf\u0bc6\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd \u0b9a\u0b99\u0bcd\u0b95\u0bae\u0bcd, \u0b85\u0b95\u0bbf\u0bb2 \u0b87\u0bb2\u0b99\u0bcd\u0bb2\u0b95 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bae\u0baf\u0bc6\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd \u0b9a\u0b99\u0bcd\u0b95\u0bae\u0bcd, \u0ba4\u0baa\u0bc6\u0bbe\u0ba4\u0bc1 \u0bae\u0bc1\u0b95\u0bc6\u0bbe\u0bb2\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5 \u0b89\u0ba4\u0bb5\u0bbf\u0baf\u0bc6\u0bbe\u0bb3\u0bb0\u0bcd \u0bae\u0b9a\u0bb2\u0bb5\u0b9a\u0bcd \u0b9a\u0b99\u0bcd\u0b95\u0bae\u0bcd, \u0b85\u0b95\u0bbf\u0bb2 \u0b87\u0bb2\u0b99\u0bcd\u0bb2\u0b95 \u0ba4\u0bc8\u0bbf\u0bb4\u0bcd \u0bae\u0baa\u0b9a\u0bc1\u0bae\u0bcd \u0ba4\u0baa\u0bc6\u0bbe\u0bb2\u0bcd \u0b8a\u0bb4\u0bbf\u0baf\u0bb0\u0bcd \u0b9a\u0b99\u0bcd\u0b95\u0bae\u0bcd, \u0bb8\u0bcd\u0bb0\u0bc0 \u0bb2\u0b99\u0bcd\u0b95\u0bc6\u0bbe \u0ba4\u0baa\u0bc6\u0bbe\u0bb2\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0bb2\u0bb2\u0ba4\u0bcd\u0ba4\u0ba4\u0bc6\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bc1 \u0bae\u0b9a\u0bb2\u0bb5 \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bae\u0baf\u0bc6\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd \u0b9a\u0b99\u0bcd\u0b95\u0bae\u0bcd, \u0b85\u0b95\u0bbf\u0bb2 \u0b87\u0bb2\u0b99\u0bcd\u0bb2\u0b95 \u0b89\u0baa \u0ba4\u0baa\u0bc6\u0bbe\u0bb2\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0b9f\u0bcd\u0b9a\u0b95\u0bb0\u0bcd \u0b9a\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0bae\u0baa\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1 \u0b9a\u0b99\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb1\u0bcd\u0b9a\u0b99\u0bcd\u0b95 \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0bb2\u0b95\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b88\u0b9f\u0bc1\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0ba9. \u0b85\u0ba9\u0bcd\u0bb2\u0bb1\u0baf \u0ba4\u0bbf\u0ba9\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0b85\u0bb0\u0b9a\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bc1\u0bb2\u0b9f\u0baf \u0b85\u0b9a\u0bcd\u0b9a\u0bc1\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b95\u0bc6\u0bbe\u0bb0\u0ba3\u0bc8\u0bc6\u0bbe\u0b95 \u0bae\u0bb5\u0bb2\u0bb2\u0b95\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0ba4\u0b9a\u0ba9\u0bcd\u0bb1 \u0b85\u0bb0\u0b9a \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bae\u0baf\u0bc6\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bbf\u0bae\u0b9a\u0b9f \u0b9a\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd \u0b92\u0ba9\u0bcd\u0bb2\u0bb1\u0baf\u0bc1\u0bae\u0bcd, \u0bb5\u0bbf\u0bae\u0b9a\u0b9f \u0b9a\u0bae\u0bcd\u0baa\u0bb3 \u0b89\u0baf\u0bb0\u0bcd\u0bb2\u0bb5\u0baf\u0bc1\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b9c\u0ba9\u0bc6\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf \u0bb0\u0ba3\u0bbf\u0bb2\u0bcd \u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bb0\u0bc8\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0bc6\u0bbe\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1\u0bb2\u0bb0\u0baf\u0bbf\u0ba9\u0bcd \u0bae\u0baa\u0bc6\u0bbe\u0bbf\u0bb2\u0bcd \u0bae\u0ba8\u0bb1\u0bcd\u0bb2\u0bb1\u0baf \u0ba4\u0bbf\u0ba9\u0bae\u0bcd \u0b85\u0bb2\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bb2\u0bb5\u0baf\u0bbf\u0bb2\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0bc8\u0bc6\u0bbe\u0ba9\u0ba4\u0bc8\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1 \u0bae\u0bc8\u0bb1\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0bc6\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0baf\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0ba4\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b87\u0ba4\u0bc1 \u0bae\u0ba8\u0bb0\u0bcd\u0bb2\u0bc8\u0baf\u0bb1\u0bcd\u0bb1 \u0b93\u0bb0\u0bcd \u0b85\u0ba3\u0bc1\u0b95\u0bc1 \u0bae\u0bc1\u0bb2\u0bb1\u0baf\u0bc6\u0bbe\u0b95\u0bc1\u0bae\u0bcd."
  },
