    "chunk_text": "\u0dad\u0db8\u0dd4\u0db1\u0dca\u0dad\u0db7\u0db1\u0dca\u0dc1\u0dc3\u0dda\u0dbd\u0db7\u0db8\u0dad \u0d91\u0dc2\u0dab\u0dd4 \u0db7\u0dcf \u0dd4\u0dba\u0db1\u0dca\u0dad \u0dc1 \u0dbd\u0db7 \u0dd2\u0dbb\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0da2\u0db1\u0dca\u0dbd\u0db7 \u0db4\u0dd2\u0dc3\u0dca\u0dd4\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0db4\u0db8\u0dad\u0dd2\u0dbb\u0dc3 \u0db8\u0dd4\u0dcf\u0dbd\u0dca \u0d85\u0da2\u0db7\u0dad\u0dba\u0db7\u0d82 \u0dc3 \u0dc4\u0dba\u0dc4\u0db7 \u0db0\u0dad\u0db7\u0db8\u0dad\u0da2\u0dd4 \u0d86\u0dd4\u0db7\u0dba\u0dc3\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc3\u0db7\u0db8\u0dad\u0da2\u0dd4 \u0dd4\u0dba\u0db1\u0dca\u0dad \u0d8b\u0db8\u0dad\u0dc3\u0db7\u0dc4 \u0dd4\u0dc5\u0db7\u0da7 \u0db8\u0dd6\u0dbd\u0dba \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0db4\u0db8\u0dad\u0dd2\u0dbb\u0dc3 \u0db4\u0dd2\u0dc3\u0dca \u0dd4\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0db4\u0db8\u0dad\u0dd2\u0dbb\u0dc3\u0da7 \u0dd9\u0dd0\u0dc5\u0dc1\u0db4\u0dad \u0dc3\u0da2\u0db7\u0db1\u0dd4\u0db4\u0db7\u0dd2\u0dbb\u0dd4 \u0d86\u0d9a\u0dae\u0dd2\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db7\u0dba\u0dda\u0dc3\u0dc2\u0dab \u0dbd\u0db6\u0db7 \u0dc1\u0dcf\u0dad \u0dbb\u0dd2\u0dc4\u0db7 \u0da7 \u0dd9\u0dbd\u0db7\u0dc1\u0dd9\u0dad \u0dc3\u0dd1\u0da2\u0da7 \u0dc3\u0dbd\u0dc3\u0dca \u0db1\u0dca\u0dad \u0d91\u0dc3 \u0dd9\u0dc5\u0db4\u0db7 \u0dd9\u0db1\u0dca\u0dad \u0dad\u0db8\u0dd4\u0db1\u0dca\u0dad\u0db7\u0db1\u0dca\u0dc1\u0dc3\u0dda\u0dbd\u0db7\u0da7 \u0dc1\u0dad\u0ddc\u0dc4\u0dd0\u0d9a\u0dd2 \u0dc1 \u0dbd\u0db7 \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0db7. \u0d92\u0dd4\u0da7 \u0dc1\u0dc4\u0ddc\u0db3\u0da2 \u0d8b\u0dcf\u0db7\u0dc4\u0dba\u0dda\u0dc3 \u0dad\u0da2\u0dba\u0dd2 \u0d85\u0dcf \u0db6\u0dd0\u0d82\u0d9a\u0dd4 \u0dad\u0dd0\u0db1\u0dca\u0db4\u0dad\u0dd4\u0db8 \u0dc3\u0db3\u0dc4\u0db7 \u0dc1\u0dd9 \u0dad \u0dc1\u0db4\u0ddc\u0dbd\u0dd3 \u0d85\u0db1\u0dd4\u0db4\u0db7\u0dad\u0dc3. \u0da2\u0dc4\u0dcf\u0dad\u0dad\u0db7 \u0dc1 \u0dd2\u0dd2\u0dbb\u0db4\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db4\u0dad \u0dbd\u0da7 \u0db6\u0dd0\u0d82\u0d9a\u0dd4 \u0dc1\u0dd9 \u0dad \u0dc1\u0db4\u0ddc\u0dbd\u0dd3 \u0d85\u0db1\u0dd4\u0db4\u0db7\u0dad\u0dc3 \u0d85\u0dcf \u0dc3\u0dd2\u0dc3\u0dc3\u0da7 5\u0dba\u0dd2 7\u0dba\u0dd2.\n\n2022 \u0dc3\u0dd2\u0da7 ]0] \u0d9a\u0dc3\u0dc3 \u0dc1 \u0dad\u0dd4\u0db4\u0dad \u0dcf\u0db7\u0dad\u0dba\u0db1\u0dca\u0dad\u0dba \u0db8\u0dd6\u0dbd\u0dba \u0d85\u0dba\u0db8\u0dd4\u0dcf\u0dbd \u0dc1\u0dbd\u0ddd\u0dd4 \u0db6\u0dd0\u0d82\u0d9a\u0dd4 \u0dd2\u0dad\u0dd4\u0db8\u0dc5\u0dd4 \u0d86\u0dc3\u0dad\u0dad \u0dbd\u0d82\u0dd4\u0db7\u0dc1\u0dda \u0d86\u0d9a\u0dae\u0dd2\u0dd4 \u0d9a\u0db0\u0dad\u0dc3 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc3\u0d82\u0d9b\u0dba\u0db7\u0dc1\u0dbd\u0dca\u0d9b\u0dad\u0dd9\u0dad \u0dd4\u0dba\u0dbd\u0db7 \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0dc0\u0dd2\u0db0\u0dd2\u0dc3\u0da7 \u0dbb\u0dd4\u0dc1\u0dba\u0ddd\u0dd4\u0dcf\u0dad\u0dc3 \u0dd4\u0dba\u0dbd\u0db7 \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0dc0\u0dd2\u0db0\u0dd2\u0dc3\u0da7 \u0dc3\u0dd2\u0dc3\u0dc3\u0da7 \u0d91\u0dd4\u0dd4 \u0dc3\u0dd2\u0dc3\u0dc3\u0da7 \u0dc1\u0dcf\u0dd4\u0dd4 \u0d86\u0d9a\u0dae\u0dd2\u0dd4 \u0d9a\u0db0\u0dad \u0dc1\u0dda\u0dd9\u0dc3\u0dc2\u0dab \u0dad\u0da2\u0dba\u0dd2 \u0d85\u0dc1\u0dda\u0dc2\u0dab\u0dc3\u0db7 \u0dd4\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d8b\u0db4\u0db4\u0dad\u0da2 \u0dc3\u0dd2\u0dc3\u0dc3\u0da7 \u0dad\u0dd4\u0db8\u0dad\u0dba\u0dd2. \u0d91\u0dad\u0dc1\u0dd4\u0ddc\u0da7 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0dad\u0db7\u0db1\u0dca\u0dc1\u0dc3\u0dda\u0dbd\u0db7 \u0db4\u0db7\u0d9a\u0dbd\u0dd2\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dd4\u0db8 \u0da7 \u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0db4\u0db8\u0dad \u0dd4\u0dba\u0dbd\u0db7 \u0dd2\u0dbb\u0dc1\u0db6\u0dad \u0d86\u0d9a\u0dae\u0dd2\u0dd4 \u0db4\u0db4\u0dad \u0d9a\u0dad\u0dad \u0db4\u0dad\u0db8\u0dad \u0dc1\u0dd4\u0db8\u0dca\u0db4\u0dad\u0db4\u0dc1\u0db8\u0dad \u0d9a\u0dd2\u0dc3\u0dad \u0db7 \u0dc3\u0dd2\u0dc3\u0dc3\u0da7 \u0db4\u0dc4\u0dd4 \u0d86\u0d9a\u0dae\u0dd2\u0dd4 \u0d9a\u0db0\u0dad\u0dc3\u0dc2\u0dab \u0dbd\u0db6\u0db7 \u0dd9\u0db1\u0dca\u0dad \u0db7 \u0d9a\u0dd2\u0dc3\u0dbd\u0db7. \u0d92 \u0d85\u0db1\u0dd4 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0da2\u0db1\u0dca\u0dbd\u0db7 \u0dc3\u0dd2\u0dc3\u0dc3\u0da7 \u0db4\u0dc4\u0dd4 \u0d86\u0d9a\u0dae\u0dd2\u0dd4 \u0d9a\u0db0\u0dad \u0d85\u0db1\u0dd4\u0db4\u0db7\u0dad\u0dc3\u0dc2\u0dab \u0dbd\u0db6\u0db7 \u0dd9\u0dad \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0db6 \u0da7 \u0db1\u0dd3\u0dd2\u0dbb\u0dc3\u0dc2\u0dab \u0db4\u0dad \u0dad \u0db7. \u0dcf\u0dd0\u0db1\u0dca \u0dcf\u0db7\u0dad\u0dba\u0db1\u0dca\u0dad\u0dba \u0db8\u0dd6\u0dbd\u0dba \u0d85\u0dba\u0db8\u0dd4\u0dcf\u0dbd \u0d9a\u0dd2\u0dc3\u0dad \u0db7 \u0dc3\u0dd2\u0dc3\u0dc3\u0da7 \u0dc1\u0dcf\u0dd4\u0dba\u0dd2 \u0dad\u0dd4\u0db8\u0dad\u0dba\u0dd2 \u0dd9\u0db1\u0dca\u0dad \u0dbb\u0dd4\u0dc5\u0dd4 \u0db1\u0dca \u0d9a\u0dd2\u0dc3\u0dbd\u0db7. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0dad\u0db7\u0db1\u0dca\u0dc1\u0dc3\u0dda\u0dbd\u0db7 \u0d9a\u0dd2\u0dc3\u0dad \u0db7 \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0db4\u0db8\u0dad\u0dd2\u0dbb\u0dc3 \u0d85\u0db1\u0dd4\u0dd9\u0da2\u0dad\u0dc3 \u0dd4\u0dba\u0dbd\u0db7 \u0dc3\u0dd2\u0dc3\u0dc3\u0da7 \u0db4\u0dc4\u0dc2\u0dab \u0dd9\u0db1\u0dca\u0dad \u0dbb\u0dd4\u0dc5\u0dd4 \u0db1\u0dca \u0d9a\u0dd2\u0dc3\u0dbd\u0db7. \u0d91\u0dad\u0dc1\u0dd4\u0ddc\u0da7 \u0dc1\u0db4\u0dad \u0dc3\u0dc0\u0db7 \u0da7 \u0dc1\u0db4\u0dad\n\n\u0dba\u0da7\u0da7 \u0dc1\u0db6\u0ddc\u0dc2 \u0d9a\u0dd2\u0dc3\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dcf\u0db7\u0dad\u0dba\u0db1\u0dca\u0dad\u0dba \u0db8\u0dd6\u0dbd\u0dba \u0d85\u0dba\u0db8\u0dd4\u0dcf\u0dbd\u0dcf \u0d91\u0dc1\u0dc4\u0da2 \u0dad\u0dd0\u0db8\u0dad\u0dad\u0db4\u0dad \u0dc1\u0db4\u0dad \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0db4\u0db8\u0dad\u0dd2\u0dbb \u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0db4\u0db8\u0dad \u0dd4\u0dba\u0dad \u0db8\u0dd4\u0dcf\u0dbd\u0dca \u0d85\u0da2\u0db7\u0dad\u0dba\u0db7\u0d82 \u0dc1\u0dad \u0db1\u0dd2\u0dbd\u0db0\u0db7\u0db4\u0dad\u0db1\u0dca \u0dd2\u0dad\u0dd4\u0db8\u0dc5\u0dd4 \u0d86\u0d9a\u0dae\u0dd2\u0dd4 \u0db4\u0db4\u0dad \u0d9a\u0dad\u0dad \u0db4\u0dad\u0db8\u0dad \u0dc1\u0dd4\u0db8\u0dca\u0db4\u0dad\u0db4\u0dad \u0dc4\u0dcf\u0dbb\u0dd4 \u0d85\u0dc3\u0dcf \u0d9a\u0dd2\u0dc3\u0dad \u0d91\u0dd4 \u0da2\u0da2 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0dad\u0db7\u0db1\u0dca\u0dc1\u0dc3\u0dda\u0dbd\u0db7\u0dc1\u0dd9\u0db1\u0dca \u0d85\u0dc4\u0db1\u0dca\u0dad \u0dd4\u0dd0\u0da2\u0dd0\u0dd2\u0dbb\u0dba\u0dd2."
