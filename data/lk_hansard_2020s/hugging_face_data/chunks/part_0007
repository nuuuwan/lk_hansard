u0db6\u0dd0\u0dc0\u0dd2\u0db1\u0dca \u0d85\u0dc0 \u0dba \u0d85\u0d85\u0d82\u0dc1\u0dbb\u0dca\u0d9a \u0db6\u0da9\u0d89\u0dd2\u0db4\u0d9f\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dcf\u0dab\u0dba \u0d86\u0db1\u0dba\u0db1\u0dba \u0d9a\u0dbb \u0dd0\u0dd2 \u0dad \u0dc3\u0db3\u0dc4\u0dcf \u0d8a\u0da7 \u0d85\u0dd9\u0dcf\u0dc5 \u0dc1\u0dd9\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc1\u0dda\u0db1\u0dca\u0dd4\u0db1 \u0dc3\u0dad\u0d9f \u0d9a\u0da7\u0dba\u0dd4\u0dd4\u0db1 \u0d9a\u0dbb \u0d87\u0dad.\n\n\u0dad\u0dc0\u0dd9 \u0dc3 \u0dc0 \u0d86\u0dc4\u0dcf\u0dbb \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0dd9\u0db1\u0dba\u0da7 \u0d85\u0dd9\u0dcf\u0dc5 \u0d85\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dba \u0dc3\u0dc4 \u0d9a\u0dd4\u0d9a\u0dd4\u0dc5\u0dd4 \u0d9a\u0dbb\u0dca\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dba\u0da7 \u0d85\u0dc0 \u0dba \u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0d86\u0db1\u0dba\u0db1\u0dc1\u0dd2\u0daf\u0dd3 \u0dad\u0dd3\u0dbb\u0dd4\u0db6\u0daf\u0dd4 \u0dc3\u0dc4\u0db1 \u0dbd\u0db6\u0dcf \u0dd0\u0dd2 \u0dad \u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dd2\u0dbb\u0dca\u0dc1\u0dda \u0dbd\u0dd2\u0db4\u0dd2 \u0db1\u0dd2\u0d9a\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dad \u0d9a\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0dad \u0dc4\u0dcf \u0dc0\u0dd0\u0dc0\u0dd2\u0dbd\u0dd2 \u0d9a\u0dbb\u0dca\u0dad\u0dcf\u0db1\u0dca\u0dad \u0d85\u0dad\u0dcf\u0dad\u0dba\u0dcf\u0dcf\u0d82 \u0dba \u0dad\u0d9f\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0dc1\u0d9a\u0dc1\u0dbb\u0dca.\n\n(\u0d87) \u0d85\u0dd9\u0dcf\u0dc5 \u0dc1\u0db1\u0ddc\u0dc1\u0dda.\n\n\u0dc3\u0dd3\u0db8\u0dcf\u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf \u0dba\u0dc3\u0dda\u0dc0\u0dcf \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u0db8\u0dd2\u0dad\u0dd2\n\n\u0d9a\u0dd4\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0daf\u0dd2\u0dc3\u0db1\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0bb5/\u0baa \u0baa\u0bb2\u0bcd\u0bae\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bc1\u0bb1\u0bb5\u0bc1\u0b9a\u0bcd \u0b9a\u0b99\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd:\n\n\u0b95\u0bc1\u0bb0\u0bc1\u0ba8\u0bbe\u0b95\u0bb2\u0bcd \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd MULTIPURPOSE CO-OPERATIVE SOCIETIES:\n\nKURUNEGALA DISTRICT 1093/2024\n\n4. \u0d9c\u0dd4 \u0db6\u0dd4\u0daf\u0dca\u0db0\u0dd2\u0d9a \u0db4\u0dad\u0dd2\u0dbb\u0dab \u0db8\u0dc4\u0dad\u0dcf \u0db1\u0d9c\u0dd4 \u0dc3\u0db8\u0db1\u0dca\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba \u0dba\u0dc4\u0dda\u0dbb\u0dad\u0dca \u0db8\u0dc4\u0dad\u0dcf\n\n\u0dba\u0dc0\u0db1\u0dd4\u0dc0 ) (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b95 \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0ba3 - \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0bae\u0ba9\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0baf \u0bae\u0bb9\u0bb0\u0ba4\u0bcd \u0b9a\u0bbe\u0bb0\u0bcd\u0baa\u0bbe\u0b95) (The Hon. Buddhika Pathirana on behalf of the Hon. Samanpriya Herath) \u0dc1\u0dc0\u0dc5\u0db3, \u0dc0\u0dcf\u0dd2\u0d9a\u0da2\u0dca\u200d \u0dc4\u0dcf \u0d86\u0dc4\u0dcf\u0dbb \u0dc3\u0dd4\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dad\u0dcf \u0d85\u0dad\u0dcf\u0dad\u0dba\u0dd4\u0db1\u0dad\u0dcf\u0dc1 \u0db1\u0dca \u0d87\u0dd6 \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0dba - (1):\n\n(\u0d85) (i) \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0da7 \u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dc1\u0dd2 \u0d87\u0d85\u0d82 \u0dc3\u0dd3\u0dad\u0dcf\u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd2\u0dc0\u0dd2\u0db0\n\n\u0dc1\u0dc3 \u0dc0\u0dcf \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u0db8\u0dd2\u0d85\u0d82 \u0dc3\u0dcf\u0d82\u0db1\u0dba\u0dcf\u0dc0 \u0dc1\u0d9a\u0ddc\u0db4\u0dad\u0dab\u0dd9;\n\n(ii) \u0d92\u0dc0\u0dcf\u0dc1\u0dd2 \u0dc1\u0dc3 \u0dc0\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc1\u0dc3 \u0dc0\u0d9a\u0dba\u0db1\u0dca \u0dc3\u0dcf\u0d82\u0db1\u0dba\u0dcf\u0dc0\n\n\u0dc1\u0d9a\u0ddc\u0db4\u0dad\u0dab\u0dd9;\n\n(iii) \u0d91\u0dad \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u0db8\u0dd2\u0d85\u0d82 \u0dad\u0d9f\u0dd2\u0db1\u0dca \u0dc3\u0db4\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc1\u0dc3 \u0dc0\u0dcf\n\n\u0d9a\u0dc0\u0dc1\u0dbb\u0dca\u0dd9;\n\n(iv) \u0d91\u0dad \u0dc3\u0db8\u0dd2\u0d85\u0d82 \u0dad\u0d9f\u0dd2\u0db1\u0dca \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dc1\u0dda\u0dba\u0dba \u0d85\u0dc1\u0dbd\u0dc0\u0dd2\u0dc3\u0dbd\u0dca \u0dc3\u0dcf\u0d82\u0db1\u0dba\u0dcf\u0dc0 \u0dc1\u0d9a\u0ddc\u0db4\u0dad\u0dab\u0dd9;\n\n(v) \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0da7 \u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dc1\u0dd2 \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dbb \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dba \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dad \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0db1\u0dd4 \u0dad\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dad\u0dba \u0d9a\u0dc0\u0dc1\u0dbb\u0dca\u0dd9;\n\n\u0dba\u0db1\u0dca\u0db1 \u0d91\u0dd4\u0db1\u0dad\u0dcf \u0dc1\u0dad\u0dad \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0dd9\u0db1\u0dca\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dd9?\n\n(\u0d86) \u0dc1\u0db1\u0ddc\u0d91\u0dc1\u0dc3 \u0db1\u0dda, \u0d92 \u0dad\u0db1\u0dca\u0dd9?\n\n\u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0b95, \u0bb5\u0bbe\u0ba3\u0bbf\u0baa \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b89\u0ba3\u0bb5\u0bc1\u0baa\u0bcd \u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bc1 \u0b85\u0b95\u0bae\u0b9a\u0bcd \u0b9a\u0b95\u0bb0\u0b95\u0bcd \u0bae\u0b95\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0ba9\u0bbe:\n\n(\u0b85) (i) \u0b95\u0bc1\u0bb0\u0bc1\u0ba8\u0bbe\u0b95\u0bb2\u0bcd \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0b95\u0bae\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0bb5\u0b95\u0bb0 \u0baf\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0bb2\u0bcd\u0bae\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bc1\u0bb1\u0bb5\u0bc1\u0b9a\u0bcd \u0b9a\u0b99\u0bcd\u0b95\u0b99\u0bcd \u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0b95 \u0baf\u0bbe\u0ba4\u0bc1;\n\n(ii) \u0b85\u0bb5\u0bb1\u0bcd\u0bb1\u0bbf\u0bb2\u0bcd \u0baa\u0ba3\u0bbf\u0baf\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b8a\u0bc8\u0bbf\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0b95 \u0baf\u0bbe\u0ba4\u0bc1;\n\n(iii) \u0bae\u0bae\u0bb1\u0bcd\u0baa\u0b9f\u0bbf \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bc1\u0bb1\u0bb5\u0bc1\u0b9a\u0bcd \u0b9a\u0b99\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0bb5\u0bc8\u0b99\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0bae\u0b9a\u0b95\u0bb5\u0b95\u0bb3\u0bcd \u0baf\u0bbe\u0b95\u0bb5;"
