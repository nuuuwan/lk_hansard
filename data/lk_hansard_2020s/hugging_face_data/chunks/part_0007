    "chunk_text": "\u0d85\u0db4\u0dd2 \u0daf\u0dca\u0db0\u0dcf\u0dc0\u0dcf 1948 \u0dd2\u0dc4\u0dca\u200d\u0dcf \u0dc1\u0dd9\u0ddd \u0db1\u0dd2\u0daf\u0dd9\u0dc3\u0dcf \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dcf \u0dd4\u0dad\u0d9c\u0dc1\u0dda \u0dd2\u0dc4\u0dca\u200d\u0dcf \u0dc1\u0dca\u0db4 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dcf \u0d9a\u0dca\u0dc1\u0dc2\u0dca\u0da8\u0dda\u200d\u0dbb\u0dc1\u0dda \u0dca\u200d\u0dbb\u0d9c\u0db1\u0dcf \u0da7 \u0dd9\u0da7\u0db1 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0d9a\u0dca\u0db1 \u0dc5\u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0dc5\u0dbb \u0dd2 \u0dc1\u0dbb\u0dcf \u0dbb\u0dc0. \u0dd9\u0da7\u0dbb\u0da7\u0dd2 \u0dc4\u0dd4 \u0d9a\u0dca \u0dc1\u0dc0\u0dca\u200d\u0dcf\u0dc0\u0da7 \u0dc0\u0dcf \u0d9a\u0dd2 \u0da7\u0dc1\u0dc0\u0dcf\u0dc0\u0dcf \u0d85\u0da9\u0dd4\u0dd2. \u0d85\u0daf \u0dc0\u0dcf \u0dd2\u0dc3\u0da7 \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0dc3\u0d82 \u0dba\u0dcf\u0dc0 \u0dc0\u0da7\u0da9\u0dd2 \u0dc1\u0dc0\u0dca\u200d\u0dcf \u0dd2 \u0dc1\u0dbb\u0dcf\u0dc0\u0dcf; \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0dca\u0db0\u0dc1\u0dda \u0dc3\u0d82 \u0dba\u0dcf\u0dc0 \u0dc0\u0da7\u0da9\u0dd2 \u0dc1\u0dc0\u0dca\u200d\u0dcf \u0dd2 \u0dc1\u0dbb\u0dcf\u0dc0\u0dcf; \u0dc0\u0dcf\u0dc1\u0dda\u0db1 \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dcf \u0dca\u200d\u0dbb\u0dd2 \u0dbd\u0dca\u200d \u0dc0\u0da7\u0da9\u0dd2 \u0dc1\u0dc0\u0dca\u200d\u0dcf \u0dd2 \u0dc1\u0dbb\u0dcf\u0dc0\u0dcf. \u0db1\u0dc1\u0dda \u0db1\u0dad\u0dc5 \u0d85\u0dd4\u0dad\u0dc0 \u0d9a\u0dd2 \u0dcf \u0db1\u0dd2\u0dc3\u0dcf \u0dc1\u0dca\u0db4 \u0dc3\u0d82 \u0dba\u0dcf\u0dc1\u0dbd\u0dca \u0dcf\u0dc0\u0dca\u200d \u0dc3\u0db1\u0dd9\u0dbb \u0dd2\u0dc3\u0da7 \u0dc1\u0dc0\u0dcf\u0dc3\u0dcf\u0dc5\u0dca\u0db4 \u0dd2 \u0dc1\u0dbb\u0dca\u0db0\u0dcf \u0db4\u0dd4\u0dd4\u0dc0\u0dc0\u0dca\u0db0. 1990 \u0d9c \u0dca\u0db0\u0dc0\u0dca\u200d \u0db4\u0dc0\u0dca \u0dc0\u0db4\u0dd4 \u0dc3\u0dcf\u0db1\u0dcf\u0dcf\u0dba \u0dc1\u0db4\u0db8 \u0dd2\u0dc3\u0dcf\u0dcf\u0d9c\u0dc1 \u0dca\u0db0 \u0dc3\u0db1\u0dca \u0dd6 \u0dca\u200d\u0dbb\u0db1\u0dcf \u0dc1\u0d9c\u0dcf \u0dbb\u0dca\u200d\u0db8\u0dd4. \u0dc5\u0dcf\u0dca\u200d\u0dc1\u0dda 100\u0d9a\u0dca \u0dd2\u0dc3\u0dcf\u0dcf\u0d9c \u0dbd\u0dd2 \u0dc0\u0dcf \u0dcf\u0dca\u0db4 \u0dc3\u0db1\u0dca \u0dc1\u0dc0\u0dca\u0db0\u0dc1\u0dca\u0db0 \u0dd2\u0dc3\u0dc3\u0dd2\u0d9c \u0dcf\u0d9a\u0dca \u0dd2\u0dc3\u0dad\u0dbb. \u0dd9\u0da7\u0dbb\u0da7\u0dd2 \u0d85\u0daf \u0dc0\u0dcf \u0dc1\u0dc5\u0ddc\u0da7 \u0d85.\u0dc1\u0db4\u0ddc.\u0dc3. \u0dc3\u0dcf\u0db1\u0dcf\u0dcf\u0dba \u0dc1\u0db4\u0db8 \u0dd2\u0dc3\u0dcf\u0dcf\u0d9c\u0dc1\u0dda \u0dca\u200d\u0dbb\u0dd2 \u0dbd\u0dca\u200d \u0dc3\u0dd2 \u0da7 80 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d9a\u0dc1\u0dd9\u0db1 \u0dcf\u0da7\u0dca \u0dcf\u0dca\u0db4 \u0dc3\u0dd2 \u0da7 70 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dca\u200d\u0dbb\u0db1\u0dcf \u0dcf\u0dca \u0db1\u0dc5 \u0dc0 \u0dc1 \u0dca\u0db0 \u0dc0\u0da7\u0da9\u0dd2 \u0dc1\u0dc0\u0dca\u200d\u0dcf \u0dd2 \u0dc1\u0dbb\u0dcf\u0dc0\u0dcf. \u0d85.\u0dc1\u0db4\u0ddc.\u0dc3. \u0daf\u0dc3\u0dc3\u0dcf \u0dc1\u0db4\u0db8 \u0dd2\u0dc3\u0dcf\u0dcf\u0d9c\u0dc1\u0dda \u0dca\u200d\u0dbb\u0dd2 \u0dbd\u0dca\u200d \u0dca \u0d9a\u0dc1\u0dd9\u0db1\u0dd2. \u0d85.\u0dc1\u0db4\u0ddc.\u0dc3. \u0daf\u0dc3\u0dc3\u0dcf \u0dc1\u0db4\u0db8 \u0dd2\u0dc3\u0dcf\u0dcf\u0d9c\u0dc1\u0dda \u0dca\u200d\u0dbb\u0dd2 \u0dbd\u0dca\u200d \u0d9c\u0dca \u0dc1\u0dad\u0ddc\u0dca \u0dd2\u0dc3 \u0dcf\u0dc0\u0dd2\u0dc3\u0daf\u0dba\u0dcf\u0dca\u200d \u0da7 \u0dca\u200d\u0dbb\u0dc1 \u0dc0\u0dcf \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba \u0dca\u0db0 \u0dc3\u0d82 \u0dba\u0dcf\u0dc0 \u0dc1\u0dca\u0db4 \u0dc0\u0dc3\u0dc1\u0dbb\u0dca\u0dca \u0dc3\u0da7\u0dca\u200d\u0d9a\u0dd2 \u0dd4\u0dad\u0dad\u0dd4 \u0dca\u200d\u0dbb\u0db1\u0dcf \u0d9a\u0dca \u0dc0\u0dcf\u0dc0\u0dcf. \u0dc3\u0dd2 \u0da7 64.33\u0d9a\u0dca \u0dc0\u0dcf\u0dc1\u0dda \u0dca\u200d\u0dbb\u0db1\u0dcf \u0d9a\u0dca \u0daf\u0dc3\u0dc3\u0dcf \u0dc1\u0db4\u0db8 \u0dd2\u0dc3\u0dcf\u0dcf\u0d9c\u0dc1 \u0dca\u0db0 \u0dd2\u0dc3 \u0dcf\u0dc0\u0dd2\u0dc3\u0daf\u0dba\u0dcf\u0dca\u200d \u0dca\u200d\u0dbb\u0dc1 \u0dc3\u0dc4\u0dd9\u0dcf \u0dd4\u0db6\u0dd4 \u0dd4\u0db6\u0dc5\u0dca\u0db4 \u0dca\u200d\u0dbb\u0dcf \u0dd2 \u0dc1\u0dbb\u0dcf\u0dc0\u0dcf. \u0d9a\u0dc1\u0dd9\u0db1 \u0dcf\u0dca\u0db4 \u0dd2\u0dc3\u0dcf\u0dcf\u0d9c \u0dca\u200d\u0dbb\u0dd2 \u0dbd\u0dca\u200d\u0dc0\u0dca\u200d \u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0dcf \u0d9a\u0dca \u0dd2 \u0dc1\u0dbb\u0dcf\u0dc0\u0dcf. \u0dd2\u0dc3 \u0dcf\u0dc0\u0dd2\u0dc3\u0daf\u0dba\u0dcf\u0dca\u200d \u0dc3\u0d82 \u0dba\u0dcf\u0dc0 \u0d9c\u0dca \u0dc1\u0dad\u0ddc\u0dca 1980 \u0d9c \u0dca\u0db0\u0dc0\u0dca\u200d \u0dd2\u0dc3 \u0dcf\u0dc0\u0dd2\u0dc3\u0daf\u0dba\u0dcf\u0dca\u200d 8\u0d9a\u0dca \u0dd2\u0dc3\u0dad\u0dbb \u0dd2 \u0db6\u0dd4\u0dc1\u0dab\u0dca. \u0daf\u0da7\u0dca\u0db0 \u0dd2\u0dc3 \u0dcf\u0dc0\u0dd2\u0dc3\u0daf\u0dba\u0dcf\u0dca\u200d \u0dc3\u0d82 \u0dba\u0dcf\u0dc0 17\u0d9a\u0dca \u0dc0\u0dcf\u0dc0\u0dcf. \u0d9a\u0daf\u0dcf \u0dd2\u0dc3 \u0dcf\u0dc0\u0dd2\u0dc3\u0daf\u0dba\u0dcf\u0dca\u200d\u0dc0\u0dca\u200d\u0da7 \u0d87\u0dad\u0dd4\u0db8\u0dca \u0dc0\u0dd4\u0dc1\u0dab\u0dca 5 000\u0dc5 \u0dd2\u0dc3\u0dad\u0dbb \u0dca\u200d\u0dbb\u0db1\u0dcf \u0d9a\u0dca. \u0d85\u0daf \u0dd2\u0dc3 \u0dcf\u0dc0\u0dd2\u0dc3\u0daf\u0dba\u0dcf\u0dca\u200d\u0dc0\u0dca\u200d\u0da7 \u0d87\u0dad\u0dd4\u0db8\u0dca \u0dc0\u0dcf\n\n351 352\n\n2024 \u0da2\u0dd4\u0db1\u0dd2 05\n\n\u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dcf \u0d9a\u0dca\u0dc1\u0dc2\u0dca\u0da8\u0dda\u200d\u0dbb \u0da7 \u0dc3\u0dd1\u0db1 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0d9a\u0dca\u0db1 \u0dd2\u0dc3 \u0dcf\u0dca\u200d \u0dc0\u0da7\u0da9\u0dc1\u0dc5\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0dc5\u0dbb\u0dca\u200d\u0dcf \u0dd2 \u0dc1\u0dbb\u0dcf\u0dc0\u0dcf. \u0dd9\u0da7\u0dbb\u0da7\u0dd2 \u0d85\u0da9\u0dd4\u0db4\u0dcf\u0da9\u0dd4\u0dc5\u0dca\u0db4 \u0daf \u0d87\u0dd2 \u0dc1\u0dc0\u0dca\u200d\u0dcf \u0dd2 \u0dc1\u0dbb\u0dcf\u0dc0\u0dcf. \u0d85\u0da9\u0dd4\u0db4\u0dcf\u0da9\u0dd4\u0dc5\u0dca\u0db4 \u0db1\u0dd2\u0dc0\u0da7\u0dbb\u0dd0\u0dbb\u0dd2 \u0dc5\u0dbb\u0dc1\u0d9c\u0dcf \u0dc1\u0dca\u0db4 \u0dbb\u0dc1\u0da7\u0dca \u0daf\u0dbb\u0dd4\u0dc0\u0dca\u0db0\u0dc1\u0dda \u0d85\u0dcf\u0dcf\u0d9c\u0dad \u0dc3\u0dc5\u0dc3\u0dcf \u0dc5\u0dbb\u0dca\u0db0\u0dcf \u0dc0\u0dbb\u0dca\u0dad\u0db1\u0dcf\u0dcf \u0da7 \u0dc0\u0da9\u0dcf \u0d85\u0dcf\u0dcf\u0d9c\u0dad \u0daf\u0d9a\u0dd2\u0dcf \u0daf\u0dbb\u0dd4\u0dc0\u0dca\u0db0 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0dca \u0db6\u0dd2\u0dc4\u0dd2 \u0dc5\u0dbb\u0dca\u0db0\u0dcf \u0dc1\u0dca\u0db4 \u0dc3\u0dd2 \u0dd4 \u0dc1\u0daf\u0dcf\u0dcf \u0dc5\u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0dc5\u0db8 \u0dd4\u0dad\u0dad\u0dd4\u0dd2."
  },
