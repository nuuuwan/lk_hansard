    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dda\u0dc5\u0dd9 \u0d9a\u0dcf \u0dba \u0dc1\u0db8\u0dba\u0dd2 . \u0dc1\u0d9a\u0ddc\u0dc5\u0db9 \u0db8\u0dc1\u0dc4\u0dc3\u0dae\u0dad\u0dca\u200d\u0dbb\u0dcf\u0dad\u0dca \u0d85\u0db0\u0dd2\u0d9a \u0dc1\u0d86 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dc0\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dbb\u0dd4\u0dc0 \u0dba\u0dcf\u0dc1\u0dda \u0d9a\u0dcf\u0dbd\u0dc1\u0d86 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dc1\u0d9a\u0ddd\u0da7\u0dd2 20\u0d9a\u0dca \u0dc0\u0da7\u0dd2\u0db1\u0dcf \u0dc0\u0dd2\u0dc3\u0dae\u0d9a\u0dd2 \u0dc1\u0dad\u0ddc\u0d9c\u0dba\u0d9a\u0dca \u0d85\u0dad\u0dd4\u0dbb\u0dd4\u0dcf\u0dc4\u0dca \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u0dad\u0dc1\u0d9a\u0ddc\u0da7 \u0db4\u0dd0\u0db1\u0dca\u0dab\u0dd2\u0dbd\u0dd2 \u0d9a \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0dc1 \u0dc3\u0dc0\u0dcf \u0dc1\u0dc4\u0ddc\u0dbb\u0dd4 \u0dc1\u0d9c\u0db1\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf; \u0d9c\u0db6\u0dca\u0dcf \u0d9a\u0dca\u0dbd\u0dcf \u0dc1\u0d9c\u0db1\u0dd2\u0dba\u0dbd\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc1 \u0dc3 \u0dc3 \u0dc3\u0db6\u0dca \u0db0\u0dc0 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dca\u0da8 \u0d9a \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc1 \u0dc3 \u0dc1\u0dbd\u0dca\u0d9b\u0db1\u0dc1\u0d86 \u0dc3\u0db3\u0dc4\u0dca \u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \"\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dc1\u0d9a\u0ddd\u0da7\u0dd2 20\u0d9a\u0dca \u0db4\u0db8 \u0dc0\u0da7\u0dd2\u0db1\u0dcf \u0dc0\u0dd2\u0dc3\u0dae\u0d9a\u0dd2 \u0dc1\u0dad\u0ddc\u0d9c\u0dba\u0d9a\u0dca\" \u0d9a\u0dd2\u0dba\u0dbd\u0dcf.\n\n\u0dc0\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dbb\u0dd4\u0dad\u0dd4\u0dc1\u0db8\u0d9a\u0dca \u0dca\u0dc0\u0dcf\u0db8 \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0dc1 \u0dc3\u0d9a \u0dc1\u0dad\u0dca\u0dbb\u0dd4 \u0dcf. \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0db6\u0dd0 \u0dbd\u0dcf \u0dc1 \u0dc3 \u0d9c\u0dd0\u0db1 \u0dc1\u0dc4\u0ddc\u0dba\u0dbd\u0dcf \u0db6\u0dd0\u0dbd\u0dd4\u0dc0\u0dcf. \u0d91\u0dc1\u0dc3\u0dda \u0dc1\u0dc3\u0ddc\u0dba\u0dcf \u0db6\u0dbd\u0dcf \u0dca\u200d\u0dbb \u0dae\u0db1 \u0d9a \u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0d9a\u0dd2\u0dba\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0dca \u0dc1\u0dca \u0dc1\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0dcf? \"\u0db1\u0dd0\u0dc4\u0dd0 \u0d91\u0dc1\u0dc4\u0db8 \u0dad\u0db8\u0dd2 . \u0db8\u0dd3\u0da7 \u0dc1\u0db4 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dc0\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dbb\u0dd4\u0dad\u0dd4\u0db8\u0dcf \u0d9c\u0dd0\u0db1 \u0dcf\u0dca \u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0dc4\u0dd0\u0db8 \u0dcf\u0dcf\u0db8 \u0dc1 \u0dc3\u0d9a \u0dad\u0db8\u0dd2 \u0d9a \u0dca \u0dc1\u0dca \" \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc1 \u0dc3\u0d9a \u0dad\u0db8\u0dd2 \u0d8b\u0dad\u0dca\u0dad \u0dba. \u0d89\u0dad\u0dd2\u0dca \u0da2\u0dc1\u0d86 \u0dc1\u0dc3\u0dda\u0dc0\u0dc1\u0d86 \u0dc4\u0dd0\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dc1\u0dba\u0d9a\u0dd4\u0db8 \u0db4\u0dd0\u0dba \u0dcf\u0dcf\u0d9c\u0dba\u0d9a\u0dca \u0dc1\u0db8\u0dc1\u0dc4\u0db8 \u0db4 \u0d9a\u0dca\u0d9a\u0dd4 \u0dc0\u0dd4 \u0dcf\u0db8 \u0dc1\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0dcf \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba? \u0dc1 \u0dc3 \u0d85\u0db0\u0dd2\u0d9a \u0d9a\u0dca\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dba. \u0dc1 \u0dc3 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0dc1\u0dcf\u0dba\u0da7\u0db8 \u0db6\u0dd0\u0dd4 \u0dc3 \u0d85\u0dc4\u0dca \u0db1 \u0d95\u0db1\u0dd1 \u0d85\u0db0\u0dd2\u0d9a \u0d87\u0db8\u0dad\u0dd2\u0dd2 \u0dca\u0da9\u0dd4\u0da9\u0dd4\u0dc0\u0dd2 \u0dcf? \u0dc1\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0dcf \u0d9c\u0dad\u0dca\u0dad \u0db4\u0dd2\u0dba\u0dc0 ?\n\n\u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dc0\u0dcf\u0dc1\u0dda \u0db1\u0da9\u0dd4 \u0dc0\u0dd2 \u0dcf\u0dbd \u0dc3\u0d82\u0d9b\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0dba \u0dc1\u0dc4\u0ddc\u0dc1 \u0dca \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3 \u0dc3\u0db6\u0dca \u0db0\u0dc1\u0dba\u0dca \u0db1\u0da9\u0dd4 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d9c\u0d82\u0da2\u0dcf \u0dc1\u0dc4\u0dc1 \u0ddc\u0dd2 \u0dca \u0db1\u0da9\u0dd4 \u0dc3 \u0dc3\u0db6\u0dca \u0db0\u0dc1\u0dba\u0dca \u0dc3\u0dbd\u0d9a\u0db1 \u0dc4\u0dd0\u0da7\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc1 \u0dc3 \u0dc1\u0dbd\u0dca\u0d9b\u0db1 \u0db8\u0da7 \u0db1\u0dd2 \u0dca \u0dad \u0dc1\u0dba\u0dca \u0dbd\u0dd0\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dda\u0da7 \u0d85\u0dcf\u0dcf\u0dc5 \u0dc1\u0dbd\u0dca\u0d9b\u0db1\u0dad\u0dca \u0db8\u0db8 \u0dc3\u0dcf\u0dcf\u0d9c\u0dad \u0d9a\u0dc5\u0dcf \u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2."
  },
