    "chunk_text": "\u0db8\u0dab\u0dca\u0da9\u0da9\u0d9a\u0db4\u0da7\u0dba\u0dd2, \u0dc3\u0da2\u0dca\u200d\u0db4\u0da7\u0dba\u0dd2, \u0dc3\u0da2\u0dca\u200d\u0dc1\u0dcf \u0db8\u0dd0\u0dad\u0dd2 \u0d87\u0db8\u0dad\u0dd2 \u0dbb\u0dd4\u0dc0\u0dd2\u0daf\u0da7\u0dba\u0dd2 \u0db8\u0dc0\u0dd2\u0daf\u0dd3 \u0dbb\u0dd4\u0dc0\u0dd2\u0daf\u0da7\u0dba\u0dd2 \u0dc1\u0db6\u0dcf\u0dc1\u0dc4\u0dcf\u0db8 \u0dd4 \u0db6 \u0dcf\u0daf\u0dd3 \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u200d\u0db4\u0d9a\u0dca\u0db1 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d9a\u0d9a\u0dca\u0dc2 220\u0d9a\u0dca \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf \u0da7 \u0d9a\u0dc3\u0db4\u0dca \u0db8\u0dc4 \u0db4\u0dcf\u0db4\u0d9a\u0dbb\u0dca\u0db8\u0db4\u0d9a\u0dca, \u0db8\u0dc4\u0dcf \u0dcf\u0db4\u0db4\u0d9a\u0dca\u0db1 \u0d9a\u0d9a\u0dca\u0dc2 220\u0d9a\u0dca \u0db4\u0dd4 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf \u0da7 \u0d9a\u0dc3\u0d9a\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dd2\u0daf\u0dc1\u0dc0\u0dd2\u0daf \u0dc1\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0daf? \u0d94\u0dc0\u0dd4\u0dc0\u0dd2\u0daf\u0dc1 \u0da2\u0dca\u200d\u0db1 \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0d9a\u0dd4\u0da9\u0dcf \u0d9a\u0dc3\u0d9a\u0dcf, \u0dbd\u0dd2\u0dcf\u0db4\u0dad\u0dca\u0d9a\u0db8 \u0dd0\u0da9\u0dd2 \u0d9a\u0dc3\u0d9a\u0dcf, \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0d85\u0dc1\u0dc4\u0dca\u0dc1\u0dca\u0db4 \u0d89\u0dc4\u0dc5\u0da7\u0db8 \u0d94\u0dc3 \u0dcf \u0dad\u0db6\u0d9a\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dcf\u0db1 \u0db8\u0dc4\u0da2\u0dca\u200d\u0db1\u0dad\u0dcf \u0db6\u0da9\u0d9c\u0dd2\u0dc0\u0dd2\u0daf\u0dc1\u0dc0\u0dd2\u0daf \u0d89\u0dc0\u0dd2\u0daf\u0dc1\u0dc0\u0dd2\u0daf\u0db1 \u0dc1\u0dad\u0dbd\u0dca \u0dad\u0dd4\u0db1\u0d9a\u0dca \u0d9a\u0dcf\u0db4\u0dca \u0d85\u0db4 \u0dc1\u0dad\u0dbd\u0dca \u0dc1\u0daf\u0d9a\u0dba\u0dd2 \u0d9a\u0dc0\u0dd2\u0daf\u0dc1\u0dc0\u0dd2\u0daf\u0db1 \u0dc1\u0dad\u0dbd\u0dca \u0dc1\u0daf\u0d9a\u0d9a\u0dca \u0d9a\u0dcf\u0db4\u0dca \u0d85\u0db4 \u0dca\u0d9a \u0dc1\u0dad\u0d9a\u0dba\u0dd2 \u0d9a\u0dc0\u0dd2\u0daf\u0dc1\u0dc0\u0dd2\u0daf\u0db1 \u0dca\u0d9a \u0dc1\u0dad\u0d9a\u0d9a\u0dca \u0d9a\u0dcf\u0db4\u0dca \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf \u0d85\u0daf \u0dc4\u0dcf\u0db8\u0dc1\u0dad\u0dca \u0d89\u0dc0\u0dd2\u0daf\u0dc1\u0dc0\u0dd2\u0daf, \u0db6\u0da9\u0d9c\u0dd2\u0dc0\u0dd2\u0daf\u0dc1\u0dc0\u0dd2\u0daf \u0d89\u0dc0\u0dd2\u0daf\u0dc1\u0dc0\u0dd2\u0daf\u0db1 \u0daf\u0dd0\u0dc0\u0dd2\u0daf \u0d9a\u0dd2\u0db4\u0db1 \u0dcf, \u0dc1\u0db8\u0dca\u0d9a stabilize \u0d9a\u0dc3\u0d9a\u0dcf \u0dd4\u0db1 \u0da2\u0dca\u200d\u0db1 \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0d9a\u0dd4\u0da9\u0dcf \u0d9a\u0dc3\u0d9a\u0dcf, \u0d86\u0daf\u0dcf\u0db4\u0db8\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db1\u0dd0\u0dad\u0dd2 \u0d9a\u0dc3\u0d9a\u0dcf\u0db1 \u0dc3\u0da2\u0dca\u200d\u0dc1\u0dcf \u0dc3\u0d82\u0d9b\u200d\u0dcf \u0dc1\u0dbd\u0dca\u0d9b\u0db1 \u0d9a\u0da7 \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0d9a \u0d9a\u0dca\u0dd4\u0daf\u0dca\u200d\u0dbb, \u0d9a\u0dd4\u0da9\u0dcf \u0dc4\u0dcf \u0db8\u0db0\u200d\u0db8 \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0dab\u0dc1\u0dcf \u200d \u0dc3\u0dcf\u0db4\u0d9a\u0dba\u0dd2\u0dc0\u0dd2\u0daf\u0dc1 \u200d\u0dcf\u0db4\u0dcf\u0dc3 \u0d9a\u0d9a\u0dca\u0dc2 \u0dc1\u0daf\u0d9a\u0dad\u0dca, \u0d9a\u0d9a\u0dca\u0dc2 \u0dad\u0dd4\u0db1\u0dad\u0dca \u0d85\u0dad\u0dc3 \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0db4\u0d9a\u0dca \u0dd0. \u0d9c\u0dd2\u0db1\u0dd3\u0dbd\u0dca\u0d9a\u0dcf, \u0dc0\u0dd2\u0db1\u0dcf \u0dc1 \u0d9a\u0dcf\u0db1 \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u200d\u0db4\u0d9a\u0dca \u0dc1\u0dca\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0db4 \u0dc1 \u0d9a\u0dcf \u0dd4\u0db1 \u0db8\u0db8 \u0d9a\u0dd2\u0db4\u0dc0\u0dd2\u0daf\u0db1\u0db8\u0dca, \u0d9c\u0dbb\u0dd4 \u0dc3 \u0dcf\u0db1\u0dcf\u0db4\u0d9a\u0dad\u0dd4\u0db8\u0dc1\u0dca\u0db1 \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u200d\u0db4\u0d9a\u0dca \u0dc1\u0dca\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0db4 \u0dc1 \u0d9a\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dcf, \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc1\u0dad \u0dc3\u0db8\u0dc4\u0dbb\u0dd4\u0dc0\u0dd2\u0daf\u0da7 \u0dc1\u0dc4\u0dcf\u0dc3\u0d9a\u0db8\u0dca \u0d9a\u0dc3\u0dc0\u0dd2\u0daf\u0db1, \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc1\u0dad \u0dc3\u0db8\u0dc4\u0dbb\u0dd4\u0dc0\u0dd2\u0daf\u0da7 \u0db4\u0d9c\u0dcf \u0d9c\u0dc4\u0dc0\u0dd2\u0daf\u0db1\u0db1\n\n\u0db8\u0db8 \u0d95\u0db1 \u0dad\u0dc3\u0db8\u0dca \u0dda\u0daf\u0dcf\u0dc4\u0dc3\u0dab \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dc0\u0dd2\u0daf\u0d9a\u0dcf\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc5\u0dcf\u0db1 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0d9a\u0db1 \u0db8\u0dd0\u0dad\u0dd2 \u0dc3\u0dab\u0db4 \u0dc3\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dab\u0dc1\u0db4\u0dc0\u0dd2\u0daf \u0d9a\u0da9\u0dcf\u0d9a\u0dcf\u0db4\u0dbd\u0dca \u0d9a\u0dc3\u0dc0\u0dd2\u0daf\u0db1\u0da7 \u0d9a\u0dd4\u0db8\u0dc0\u0dd2\u0daf\u0dad\u0dca\u200d\u0dbb\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db4\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dc5\u0dcf, \u0dad\u0dbb\u0dca\u0da2\u0dca\u200d\u0db1\u0db4 \u0d9a\u0dc5\u0dcf\u0db1 \u0d9c\u0dbb\u0dd4 \u0dc3 \u0dcf\u0db1\u0dcf\u0db4\u0d9a\u0dad\u0dd4\u0db8\u0dc1\u0dca, \u0d85\u0daf \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u200d \u0dc3\u0dca\u0dc0\u0dcf \u0dc3 \u0dcf \u0dc1\u0db8\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u200d \u0dc3\u0dca\u0dc0\u0dcf\u0dc1\u0dad \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u200d \u0dc3\u0dca\u0dc0\u0dcf \u0dc3 \u0dcf \u0d9c\u0dd0\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u200d \u0dc3\u0dca\u0dc0\u0dcf\u0dad\u0dca \u0dda\u0dbd\u0dca\u0d9a\u0d82\u0d9d\u0db1\u0db4 \u0d9a\u0dc3\u0d9a\u0dcf \u0dc3\u0db8\u0dc4\u0dc3 \u0db4\u0dad\u0dca\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0d9a\u0dc3\u0d9a\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dd2\u0daf\u0dc1\u0dc0\u0dd2\u0daf \u0dc1\u0d9a\u0dcf\u0dc1\u0dc4\u0dcf\u0db8\u0daf? \u0dc1\u0d9a\u0dcf\u0dc1\u0dc4\u0dcf\u0db8\u0daf \u0dc1\u0db4\u0dcf \u0dc3\u0dc3\u0dca\u0db4\u0dad\u0dd2 \u0dc3\u0db4\u0dcf \u0db4\u0dad\u0dca \u0d9a\u0dc1\u0dc5\u0dca? \u0d92\u0d9a \u0dc3\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dab\u0dc1\u0db4\u0dc0\u0dd2\u0daf\u0db8 \u200d \u0dc3\u0dca\u0dc0\u0dcf \u0dc0\u0dd2\u0dc1\u0dc3\u0ddd\u0db0\u0dd2\u0dba\u0dd2\u0db1 \u0dca\u0daf\u0dcf \u0d92 \u0dc1\u0db4\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf \u0da7 \u0dc4\u0dad\u0dc3\u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dca \u0db4\u0d9a\u0dca\u0dc2 \u0dc0\u0dd4\u0dab\u0dcf, \u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dca \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0 \u0dc0\u0dd4\u0dab\u0dcf, \u0dc1\u0daf\u0dc0\u0dd2\u0daf\u0dc1\u0db1\u0d9a\u0dca abstain \u0dc0\u0dd4\u0dab\u0dcf\u0db1 \u0d9a\u0dc0\u0dcf\u0db1\u0dcf\u0db4\u0d9a \u0dc3\u0db4\u0dcf abstain \u0dc0\u0dd4\u0dab \u0dc1\u0daf\u0dc0\u0dd2\u0daf\u0db1\u0dcf\u0dc1 \u0db8\u0dad\u0db4 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0 \u0dd3\u0db8\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0db4\u0da7 \u0dc3\u0d9a\u0d9a\u0d9a\u0dcf \u0dc4\u0dad\u0dc3\u0dba\u0dd2 \u0dc4\u0dad\u0dc3\u0dba\u0dd2 \u0d9a\u0dd2\u0db4\u0d9a\u0dcf \u0dad\u0dd3\u0dc0\u0dd2\u0daf\u0dbd\u0dd2 \u0d85\u0dc3\u0dc1\u0d9c\u0db1 \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0da7 \u0dc3\u0db4\u0db1 \u0dcf, \"\u0db8\u0dc1 \u0dad\u0dd3\u0dc3\u0d9a \u0da1\u0dc0\u0dd2\u0daf\u0daf\u0db4 \u0db1\u0db8\u0dca \u0d85\u0dc4 \u0d9a\u0dcf\u0da7\u0dba\u0dd2\" \u0d9a\u0dd2\u0db4\u0d9a\u0dcf\u0db1 \u0db8\u0da7 \u0d9a\u0dd2\u0db4\u0dc0\u0dd2\u0daf\u0db1 \u0dc3 \u0dcf\u0db1\u0dcf\u0db4\u0d9a\u0dad\u0dd4\u0db8\u0dcf, \u0d92\u0d9a \u0dad\u200d\u0db1\u0dd4\u0d9a\u0dd6\u0d9a\u0daf? \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u200d \u0dc3\u0dca\u0dc0\u0dcf \u0dda\u0dbd\u0dca\u0d9a\u0d82\u0d9d\u0db1\u0db4 \u0d9a\u0dc3\u0d9a\u0dcf\u0daf \u0db1\u0dd0\u0daf\u0dca\u0daf? \u0dca\u0dc1\u0dc4\u0db8 \u0dc1\u0dca\u0dc0\u0dd2\u0daf\u0daf\u0dd2\u0dad \u0dd0\u0da9 \u0d9a\u0dc3\u0d9a\u0dcf \u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0d9a\u0dc3\u0d9a\u0dcf \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u200d \u0dc3\u0dca\u0dc0\u0dcf \u0d85\u0db8\u0dd4 \u0d85\u0db8\u0dd4\u0dc1\u0dad \u0dda\u0dbd\u0dca\u0d9a\u0d82\u0d9d\u0db1\u0db4 \u0d9a\u0dc3\u0db1 \u0dcf\u0db1 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u200d \u0dc3\u0dca\u0dc0\u0dcf \u0dc3 \u0dcf \u0d9a\u0dca \u0dc1\u0dca\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0db4 \u0d9a\u0dc1\u0dc5\u0dca \u0dc3\u0d82 \u0dc3\u0dab \u0dc3\u0dc4 \u0dad\u0dd4\u0d9a\u0db1 - checks and balances - \u0d87\u0dad\u0dd2 \u0d9a\u0dc3\u0dc0\u0dd2\u0daf\u0db1\u0db1 \u0d92\u0d9a\u0dad\u0dca \u0d9a\u0dd4\u0dab\u0dd4 \u0db6\u0d9a\u0dca\u0d9a\u0dd2\u0db4\u0da7 \u0dc0\u0dd2\u0dd2\u0da7 \u0d9a\u0dc3\u0d9a\u0dcf \u0daf\u0db8\u0d9a\u0dcf \u0d85\u0dad\u0dca\u0dad\u0dc1\u0db1\u0ddd\u0db8\u0dad\u0dd2\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db4\u0dcf \u0d9a\u0dc3\u0db1\u0dc1\u0d9a\u0dcf\u0da7 \u0dc3\u0dcf\u0db0\u0dcf\u0dc3\u0dab \u0dc3\u0dd0\u0d9a\u0db4\u0d9a\u0dca \u0dc1\u0dca\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0db4 \u0dc1 \u0dc0\u0dd2\u0daf\u0dc1\u0dc0\u0dd2\u0daf \u0db1\u0dd0\u0daf\u0dca\u0daf \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dc3\u0dab\u0db4\u0da7\u0dad\u0dca \u0db4\u0dd2\u0d9a\u0dca\u0dc1\u0db4\u0dcf\u0d9a\u0dda \u0d9c\u0dc4\u0dba\u0dd2 \u0d9a\u0dd2\u0db4\u0d9a\u0dcf? \u0d92\u0d9a \u0db8\u0da7 \u0d9a\u0dd2\u0db4\u0dc0\u0dd2\u0daf\u0db1\u0dc1\u0d9a\u0ddd \u0db6\u0d9a\u0dc0\u0dd2\u0daf\u0db1\u0db1"
