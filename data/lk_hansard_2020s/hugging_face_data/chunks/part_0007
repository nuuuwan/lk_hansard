a \u0db4\u0dcf\u0dca\u200d\u0dcf \u0dc5\u0dd2 \u0dc5\u0dcf4 [. \u0dc0\u0dd2\u0db1 \u0daf \u0dd3\u0dbb4\u0d82 \u0db1\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db1\u0dcf\u0dc1\u0dda \u0dc5\u0dd2 \u0dc5\u0dcf\u0dc1\u0dbd \u0dd2 \u0db6\u0dd4\u0dc1\u0dab\u0dca\u0da9 \u0da2\u0dca\u200d\u0dcf\u0dd2 \u0dc5 \u0d9a\u0dca\u0db4\u0dca \u0dbb\u0dd0\u0dc5 \u0dd0\u0db1\u0dd3\u0db1, \u0dd2\u0db1\u0dca\u0d82 \u0dcf\u0db1\u0dd4 4\u0dba\u0dcf\u0db4\u0dca\u0dad4\u0dcf\u0dd9 \u0da7 \u0dc0\u0dd2\u0dc0 \u0dda\u0db0 \u0dd3\u0db1, \u0db1 \u0dc1\u0dc5\u0dcf\u0dc1\u0dc4\u0dcf\u0db1\u0dd9 \u0dcf4\u0dca 4\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0d85\u0db4\u0dd2 \u0dd3\u0db1\u0dcf\u0dc1\u0dda \u0dc1\u0dc5\u0dcf \u0da7\u0d9a [ \u0dc14\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dcf\u0dd0\u0dd2 4 \u0dc1\u0dc5\u0dcf\u0dc1\u0dc4\u0dcf\u0db1\u0dd9 \u0dcf4\u0dca 4\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0dc1 \u0ddd\u0dd3 \u0dc5\u0dbb \u0da7 \u0da7 \u0dc1\u0dcf\u0dcf\u0dd3 \u0dba\u0dbd\u0dba\u0da7\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0dc5\u0dc1\u0d9a\u0dda\u0dd9, \u0dc1\u0dca \u0d9a\u0dca\u0db6\u0db1\u0dca\u0dd3\u0dc5\u0dbb \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0d86\u0dbb [\u0dc2\u0dca\u0da8\u0dcf4 \u0d87\u0dd2 4\u0dcf4\u0dcf\u0dd9, \u0dcf\u0dd0\u0dd2 \u0dc14\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0dc5\u0dc1\u0d9a\u0dda\u0dd9 \u0db1\u0dca\u0dcf\u0dba\u0dd2.\n\n535 536\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dae\u0dba\u0dcf\u0dc1\u0dca\u0db1\u0dca\u0dad\u0dd44\n\n\u0dc1\u0db1 \u0db1\u0dcf \u0dc0\u0dd2 \u0dda4\u0dc0\u0dd2\u0dd9\u0dba\u0dcf\u0dca\u200d\u0dc1\u0dda \u0dda\u0daf\u0dd3\u0dca \u0db1\u0dad\u0dd4\u0db1\u0dcf\u0dc1 \u0db1\u0dca \u0d85\u0d9a\u0dcf \u0dd2 \u0db6\u0dd6 \u0dc5\u0dd2 \u0dc5\u0dcf4\u0dca\u200d \u0dd2 \u0dc1\u0db6\u0dcf4\u0dcf. \u0db1 \u0d87\u0dca \u0dad \u0dc14\u0db1\u0dca\u0dcf\u0da7 \u0db4\u0dd4\u0dd4 4\u0db1\u0dca. \u0d9a \u0dc5\u0db3\u0dc0\u0dd4\u0dc1\u0dbb\u0dca\u0dae \u0dd2 \u0dc1\u0db6\u0dcf \u0d85\u0dd9\u0dc4\u0d9a [ \u0dad\u0db1\u0dba\u0dd2 \u0d9a\u0dc5. \u0d9a\u0dc5 \u0dcf\u0dd0\u0