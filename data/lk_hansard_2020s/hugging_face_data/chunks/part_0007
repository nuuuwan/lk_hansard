\u0bc8\u0baa\u0bcd\u0baa\u0bc1 \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0bc6\u0bae\u0bb0\u0b95\u0bcd \u0b95\u0b95\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe:\n\n(\u0b85) (i) \u0b87\u0bb2\u0b99\u0bcd\u0bae\u0b95\u0baf\u0bbf\u0bb2\u0bcd 1948.02.04\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd, \u0bc8\u0bb0\u0ba3 \u0ba4\u0ba3\u0bcd\u0b9f\u0bae\u0ba9 \u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bae\u0ba4 \u0baf\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0ba4\u0bc2\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd \u0ba4\u0b95\u0bc6\u0bbe\u0bb2\u0bcd\u0bb2\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b86\u0b9f\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd\u0bae\u0b95 \u0baf\u0bc6\u0bbe\u0ba4\u0ba4\u0ba9\u0bcd\u0baa\u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n(ii) \u0ba4\u0bc2\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd \u0ba4\u0b95\u0bc6\u0bbe\u0bb2\u0bcd\u0bb2\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b86\u0b9f\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bc8\u0bb0\u0ba3\u0b9a\u0bcd \u0bc6\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd\u0b95\u0bae\u0bb3 \u0b89\u0bb1\u0bb5\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0b9f\u0bae\u0bcd \u0bae\u0b95\u0baf\u0bb3\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0bae\u0b95 \u0b8e\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bc8\u0bc6\u0bbe \u0b8e\u0ba9\u0bcd\u0baa\u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n(iii) \u0b86\u0ba4\u0bc8\u0ba9\u0bbf\u0bb2\u0bcd, \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b8e\u0bb5\u0bcd\u0bb5\u0bb3\u0bb5\u0bc1 \u0b95\u0bc6\u0bbe\u0bb2\u0bae\u0bcd \u0b8e\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n\u0b85\u0bb5\u0bb0\u0bcd \u0b87\u0b9a\u0bcd\u0bc6\u0bae\u0baa\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe?\n\n(\u0b86) (i) \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bc6\u0bbe\u0bb3\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bc8 \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0bc6\u0bb0\u0bcd \u0ba4\u0b95\u0bcc\u0bb0\u0bb5 \u0b8e\u0bb8\u0bcd. \u0b9f\u0baa\u0bcd\u0bb3\u0bbf\u0baf\u0bc2. \u0b86\u0bb0\u0bcd. \u0b9f\u0bbf. \u0baa\u0ba3\u0bcd\u0b9f\u0bc6\u0bbe\u0bb0\u0ba8\u0bc6\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bae\u0bb3\u0baa\u0bcd \u0baa\u0b9f\u0bc1\u0ba4\u0b95\u0bc6\u0bbe\u0bae\u0bb2 \u0ba4\u0bc6\u0baf\u0bcd\u0ba4\u0bae\u0bc8 \u0ba4\u0ba4\u0bc6\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bcd\u0bb1\u0bb5\u0bc6\u0bbe\u0bb3\u0bbf \u0baf\u0bc6\u0bbe\u0b95\u0ba4\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0bb2\u0bcd\u0ba4\u0bc1\u0b95\u0bb5 \u0b95\u0bc6\u0bc6\u0bbe\u0bc8\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0bc8\n\n903 904\n\n\u0dd3\u0d9c\u0dc0 \u0dd3\u0dad\u0dad\u0dd2\u0db1 8\u0daf\u0db1\u0dca\u0dad [\u0dc0\u0db4\u0dc0\u0db3\u0da9\u0dd4\u0d9a\u0da9\u0dc0\u0dba \u0db8\u0dc4\u0dad\u0dc0\n\n2024 \u0da2\u0dd6\u0db1\u0dd2 13\n\n\u0b95\u0ba4\u0bb0\u0bc6\u0bbe\u0bbf\u0ba9\u0bcd \u0bc8\u0bb0\u0ba3\u0b9a\u0bcd \u0bc6\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd \u0b87\u0ba4\u0bc1\u0bb5\u0bae\u0bb0\u0baf\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bb5\u0bbf\u0bb2\u0bcd\u0bae\u0bb2 \u0b8e\u0ba9\u0bcd\u0baa\u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n(ii) 1962.07.06\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0ba4\u0bb2\u0bcd\u0ba4\u0bc1\u0b95\u0bb5 \u0b95\u0bc6\u0bc6\u0bbe\u0bc8\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0bc8 \u0b95\u0ba4\u0bb0\u0bb0\u0bcd \u0ba4\u0bc2\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd \u0ba4\u0b95\u0bc6\u0bbe\u0bb2\u0bcd\u0bb2\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc6\u0bbe\u0b95\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd \u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0bbe\u0bb2\u0bc1\u0bae\u0bcd, \u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0baa\u0bcd\u0ba4\u0baa\u0baf\u0bc6\u0bbe\u0bbf\u0bb2\u0bcd \u0bc8\u0bb0\u0ba3\u0ba4\u0bc8\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1 \u0baa\u0ba4\u0bbf\u0bb5\u0bc1 \u0ba4\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bb5\u0bbf\u0bb2\u0bcd\u0bae\u0bb2 \u0b8e\u0ba9\u0bcd\u0baa \u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n\u0b85\u0bb5\u0bb0\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe?\n\n(\u0b87) (i) \u0ba4\u0bb2\u0bcd\u0ba4\u0bc1\u0b95\u0bb5 \u0b95\u0bc6\u0bc6\u0bbe\u0bc8\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0bc8 \u0b95\u0ba4\u0bb0\u0bc6\u0bbe\u0bbf\u0ba9\u0bcd \u0bc8\u0bb0\u0ba3\u0b9a\u0bcd \u0bc6\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc6\u0bbe\u0bae\u0bc8 \u0ba4\u0ba4\u0bc6\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bc6\u0bbe\u0b95 \u0bb5\u0bbf\u0bc6\u0bc6\u0bbe\u0bb0\u0bae\u0ba3 \u0b95\u0bc8\u0bb1\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc6\u0bbe \u0b8e\u0ba9\u0bcd\u0baa\u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n(ii) \u0b86\u0ba4\u0bc8\u0ba9\u0bbf\u0bb2\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0bc8\u0bc6\u0bbe\u0ba9\u0bae\u0bcd \u0baf\u0bc6\u0bbe\u0ba4\u0ba4\u0ba9\u0bcd\u0baa\u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n(iii) \u0b87\u0ba9\u0bcd\u0b95\u0bb1\u0bb2\u0bcd, \u0bb5\u0bbf\u0bc6\u0bc6\u0bbe\u0bb0\u0bae\u0ba3\u0ba4\u0baf\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1 \u0b95\u0bc8\u0bb1\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd \u0baa\u0b9f\u0bc1\u0bc8\u0bc6\u0bbe \u0b8e\u0ba9\u0bcd\u0baa\u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n(iv) \u0bc8\u0bb0\u0ba3 \u0ba4\u0ba3\u0bcd\u0b9f\u0bae\u0ba9 \u0ba8\u0bbf\u0bae\u0bb1\u0b95\u0bb5\u0bb1\u0bcd\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0ba9\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd \u0bc8\u0bb0\u0ba3\u0b9a\u0bcd \u0bc6\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc6\u0bbe\u0ba4 \u0b95\u0bb5\u0bb1\u0bc1 \u0ba8\u0baa\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba9\u0bb0\u0bc6\u0bbe \u0b8e\u0ba9\u0bcd\u0baa\u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n\u0b85\u0bb5\u0bb0\u0bcd \u0b87\u0b9a\u0bcd\u0bc6\u0bae\u0baa\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe?\n\n(\u0b88) \u0b87\u0ba9\u0bcd\u0b95\u0bb1\u0bb2\u0bcd, \u0b8f\u0ba9\u0bcd?\n\nasked the Minister of Justice, Prison Affairs and Constitutional Reforms:"
