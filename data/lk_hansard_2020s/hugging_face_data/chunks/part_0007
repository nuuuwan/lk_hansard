    "chunk_text": "\u0d85\u0dc1\u0db4\u0dca \u0dc5\u0dbb\u0dca\u0dae\u0db1\u0dcf\u0db1\u0dca\u0dad \u0d87\u0db1\u0dd2 \u0dad\u0dd4\u0db1\u0dcf \u0dc1\u0dca \u0dc14\u0dca\u200d\u0dcf\u0dc1\u0dbd \u0dc0 \u0d9a\u0db7\u0dcf\u0dc1\u0dbd \u0dd2\u0db1\u0dca\u0dcf4\u0dcf. \u0db1\u0dad\u0dd4\u0db1\u0dcf \u0d9a\u0dd2 \u0dcf \u0dc1\u0dca\u200d\u0dcf\u0da7 \u0db1 \u0dd0\u0da7\u0daf\u0dd94 \u0dad\u0db1\u0dba\u0dd2, \u0dc0\u0dd2\u0dd4\u0dc0\u0dba\u0dcf \u0db6\u0dd2\u0dca\u200d 4\u0dd0\u0dd2\u0dba\u0dd2, \u0d9a \u0db1\u0dd2\u0d9a\u0dcf \u0dc5\u0dbb\u0dca\u0dae\u0db1\u0dcf\u0db1\u0dca\u0dad4\u0dca\u200d\u0da7 \u0dd9\u0dbb\u0dcf \u0db1\u0dca\u0dcf \u0db6\u0dd0\u0dc4\u0dd0, \u0d85\u0db4\u0dd2 \u0dc1\u0dca\u200d\u0ddd\u0dc5 \u0dc14\u0dc1\u0db8\u0db3 \u0dc1\u0db4\u0dcf\u0dc1\u0db8\u0dda \u0dad\u0dbb \u0dc5\u0dcf\u0dbb\u0dd2 \u0dcf\u0dd0\u0dc4\u0dd0, \u0d9a \u0db1\u0dd2\u0d9a\u0dcf \u0d85\u0dc1\u0db4\u0dca \u0dc5\u0dbb\u0dca\u0dae\u0db1\u0dcf\u0db1\u0dca\u0dad \u0dc5\u0dbb\u0dc1 \u0dcf \u0db1\u0dca\u0dcf \u0db6\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2 \u0dcf \u0db1\u0dc5. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dd2\u0dad\u0dcf\u0db1 \u0d85\u0dd4 \u0db8\u0dd2\u0dca\u200d\u0dc5\u0da7, \u0dad\u0dbb \u0dc5\u0dcf\u0dbb\u0dd24 \u0db4\u0dd4\u0dda \u0dca\u200d\u0dc1 \u0da7 \u0dc1 \u0db1\u0dca wheel \u0dc5\u0dbb\u0dca\u200d\u0dcf, electricity \u0dca\u200d\u0db6\u0dcf \u0db1\u0dca\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0db1\u0dc1\u0dbd\u0dd9 [ \u0d85\u0db4\u0dd2\u0da7 \u0dc4\u0dd9\u0db1\u0dca\u0dcf \u0db4\u0dd4\u0dd4 4\u0db1\u0dca \u0dcf\u0dca, \u0db1\u0dad\u0dc1\u0dc5\u0dcf\u0da7 \u0d9a \u0dc5\u0dbb\u0dca\u0dae\u0db1\u0dcf\u0db1\u0dca\u0dad \u0d8a\u0da7 4\u0db1\u0dcf \u0dad\u0dbb \u0dc5\u0dcf\u0dbb\u0dd2 \u0dc14\u0dcf4\u0dcf. \u0d85\u0db4\u0dd2 \u0db1\u0dd9\u0dcf \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dad\u0dd0\u0dcf\u0db1\u0dba\u0dd2 \u0d85\u0dd9 \u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dca ; \u0d9a \u0dad\u0dd0\u0dcf\u0db1 \u0dad\u0db1\u0dba\u0dd2 \u0dc1\u0dc4\u0da7\u0dca \u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d9a