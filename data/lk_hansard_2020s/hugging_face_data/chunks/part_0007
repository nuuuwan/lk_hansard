9a\u0dca\u0dc0\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0dda \u0daf\u0dca\u0dc0\u0dd2\u0dad\u0dda\u0dc0 \u0db4\u0dd4\u0dbb\u0dc0\u0dd0\u0dd2\u0d82\u0db7\u0dcf\u0dc0\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d9a\u0dbb \u0d87\u0dd2 \u0d89\u0dbd\u0dca\u0dd4\u0db8\u0dca: \u0dc0\u0dd2\u0dc3\u0db1\u0dad\u0dbb\n\n2015-2020 \u0bb5\u0bae\u0bb0 \u0b87\u0bb2\u0b99\u0bcd\u0bae\u0b95\u0baf\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0b9f\u0bcd\u0bae\u0b9f\u0b95\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bc6\u0bbe\u0bbf\u0bae\u0bc8\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0bb5\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0b99\u0bcd\u0b95\u0bb3\u0bcd : \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd APPLICATIONS FOR DUAL CITIZENSHIP IN SRI LANKA FROM\n\n2015-2020: DETAILS\n\n368/2024 5. \u0d9c\u0dbb\u0dd4 \u0d9c\u0dba\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dd2\u0dbd\u0d9a \u0dd9\u0dc4\u0dad\u0dcf\n\n(\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b95\u0baf\u0ba8\u0bcd\u0ba4 \u0b95\u0bb0\u0bc1\u0ba3\u0bc6\u0bbe\u0ba4\u0bbf\u0bb2\u0b95\u0bcd\u0b95) (The Hon. Gayantha Karunatilleka) \u0db8\u0dc4\u0dba \u0d86\u0dba\u0dca\u0dc2\u0dca\u0da8 \u0d85\u0db8\u0dc0\u0dad\u0dba\u0dad\u0dd4\u0db8\u0dc0\u0dc1\u0d9c\u0db1\u0dca \u0d87\u0dc3\u0dd6 \u0db4\u0dca\u200d\u0dbb \u0dda [- (1\u0db4\n\n(\u0d85\u0db4 (i) 8\u0dbb\u0dca\u0dbd\u0dc2\u0dca\u0da8 2015 \u0dc3\u0dd2\u0da7 2020 :\u0dca8\u0dc0 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0dcf \u0dc0\u0dc1 \u0daf\u0dd4 \u0d9a8 \u0db4\u0dd4\u0dba8\u0dd0\u0dc3\u0dd2\u0dcf\u0dc08[ \u0d9a\u0db3\u0dc0 \u0d9c\u0dd0\u0dd3\u0dad\u0db8 \u0daf \u0dc4\u0dc0 \u0d89\u0dca \u0daf\u0dd9\u0db4\u0dad \u0dba \u0d87\u0dad\u0dd2 \u0db4\u0dd4 \u0d9c\u0d9a[\u0db1\u0dca \u0daf\u0dcf\u0d9b\u0dca\u200d\u0dba\u0dc08 \u0d91\u0dca \u0d91\u0dca 8\u0dbb\u0dca\u0dbd\u0dc2\u0dca\u0da8[ \u0d85\u0db1\u0dd48 \u0dc18\u0db1\u0dca \u0dc18\u0db1\u0dca 8 \u0dc1[\u0db1\u0dca \u0dc1 \u0dc0\u0db4\u0db8\u0dda:;\n\n(ii) \u0d92 \u0d85\u0dad\u0dbb\u0dd2\u0db1\u0dca \u0daf\u0dd4 \u0d9a8 \u0db4\u0dd4\u0dba8\u0dd0\u0dc3\u0dd2\u0dcf\u0dc08[ \u0d9a\u0db3\u0dc0 \u0daf\u0dd3 \u0d87\u0dad\u0dd2 \u0daf\u0dcf\u0d9b\u0dca\u200d\u0dba\u0dc08 \u0d91\u0dca \u0d91\u0dca 8\u0dbb\u0dca\u0dbd\u0dc2\u0dca\u0da8[ \u0d85\u0db1\u0dd48 \u0dc18\u0db1\u0dca \u0dc18\u0db1\u0dca 8 \u0dc1[\u0db1\u0dca \u0dc1 \u0dc0\u0db4\u0db8\u0dda:;\n\n(iii) \u0daf\u0dd4 \u0d9a8 \u0db4\u0dd4\u0dba8\u0dd0\u0dc3\u0dd2\u0dcf\u0dc08[ \u0daf \u0dc4\u0dc0 \u0d89\u0dca \u0daf\u0dd9\u0db4\u0dad \u0dba \u0d9a: \u0daf\u0dd2 \u0dc1\u0dad \u0dc3\u0dd2\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2[\u0dc08 \u0dc3[ \u0daf\u0db4\u0dad\u0dd6\u0dbb\u0dca\u0dbd\u0dda \u0db8\u0db8 \u0daf \u0dc4\u0dc0 \u0db1\u0dd2 \u0dda\u0dd2\u0dad \u0dc0\u0d9a[\u0dca \u0dad\u0dd2\u0dc1\u0dda:;\n\n[\u0db1\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dc0 \u0dc1\u0db8\u0db8 \u0daf\u0dcf\u0dc08\u0da7 :\u0db1\u0dca8\u0db1\u0dca\u0dc1\u0db1\u0dca:\u0d91\n\n(\u0d86\u0db4 \u0dc1 \u0dc0\u0d91\u0dc1\u0daf\u0dda \u0db4\u0dad \u0d92 \u0db8\u0db1\u0dca:\u0d91\n\n\u0ba4\u0baa\u0bc6\u0bbe\u0ba4\u0bc1\u0bc8\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bc6\u0bbe\u0ba4\u0bc1\u0b95\u0bc6\u0bbe\u0baa\u0bcd\u0baa\u0bc1 \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0bc6\u0bae\u0bb0\u0b95\u0bcd \u0b95\u0b95\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe:\n\n(\u0b85) (i) 2015 \u0ba4\u0ba4\u0bc6\u0bbe\u0b9f\u0b95\u0bcd\u0b95\u0bae\u0bcd 2020\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0bb5\u0bae\u0bb0 \u0b87\u0bb2\u0b99\u0bcd\u0bae\u0b95\u0baf\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0b9f\u0bcd\u0bae\u0b9f\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0bc6\u0bc6\u0bbe\u0bb5\u0bc1\u0bc6\u0bbe\u0bbf\u0bae\u0bc8 \u0ba4\u0baa\u0bb1\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc6\u0bbe\u0b95 \u0bb5\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0bbf\u0ba4\u0bcd\u0ba4 \u0ba8\u0baa\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd\u0bae\u0b95 \u0b92\u0bb5\u0bcd\u0b95\u0bb5\u0bc6\u0bbe\u0bb0\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bc6\u0bbe\u0bc6\u0bbe\u0bbf\u0baf\u0bc