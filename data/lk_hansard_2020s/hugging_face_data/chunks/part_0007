    "chunk_text": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0d82\u0d9a\u0dcf \u0dc0\u0db1 \u0dc0\u0dd2\u0daf\u0dc0\u0dd2\u0dbd\u0dd2 \u0dc3 \u0dc3\u0d82\u0dc3\u0dca\u0dc0\u0dcf \u0dc3\u0dc4 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0d82\u0d9a\u0dcf \u0db4\u0dc0\u0db4 \u0dcf\u0db1\u0dd3 \u0dc3\u0d82\u0dc3\u0dca\u0dc0\u0dcf \u0dc1\u0db4 \u0daf\u0dca\u0d9c\u0dd3\u0d9a\u0d9a\u0dc3\u0dab\u0db4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0dc1\u0db4\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf \u0d9a\u0dca \u0dc1\u0dc4\u0dca\u0dad\u0dd4\u0dc1 \u0dc0\u0dd2\u0daf \u0dc1\u0db8\u0db8 \u0d86\u0db4\u0dad\u0db1 \u0daf\u0dca\u0dc0\u0dd2\u0dad\u0dca \u0dc1\u0dcf \u0d9a\u0dcf\u0dbb\u0dca\u0db4\u0db8\u0dab\u0dca\u0da9\u0da9\u0d9a \u0d85\u0dad\u0dc3 \u0dc3\u0dc4 \u0dc1\u0db4\u0dcf\u0dbd\u0dd2 \u0db8\u0dc4\u0da2\u0dca\u200d\u0db1\u0dad\u0dcf \u0d85\u0dad\u0dc3 \u0dbb\u0dca\u0db0\u0db1\u0db4 \u0dd3 \u0d87\u0dad\u0dd2 \u0dc1\u0db1\u0dcf\u0dc3\u0dc0\u0dd2\u0daf\u0dd4 \u0dc0\u0dd2\u0daf\u0dad\u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc1\u0db8\u0db8 \u0dc3 \u0dcf\u0dc1\u0dad \u0d85 \u0db0\u0dcf\u0db1\u0db4 \u0dc1\u0db4\u0dcf\u0db8\u0dd4 \u0d9a\u0dc3 \u0db1\u0dd4 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0db8\u0dd2\u0db1\n\n\u0dca\u0dc1\u0dc3\u0dca\u0db8 \u0daf\u0dd0\u0db1\u0da7 \u0dc1\u0d9a\u0ddd\u0d9a\u0dc1\u0dcf \u0dc3\u0d82 \u0dbb\u0dca\u0db0\u0dd2\u0dad \u0dc3\u0da7 \u0dbd\u0dca \u0d9c\u0dab\u0db1\u0dcf \u0d9a \u0dc3\u0da2\u0dca\u200d\u0db4 \u0dc3\u0dad\u0dd4 \u0db8\u0dcf\u0db0\u200d \u0dca\u0d9a\u0db8 \u0d86\u0db4\u0dad\u0db1\u0db4\u0d9a\u0dca \u0db4\u0da7\u0dc1\u0dad\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db4\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0db1 \u0db6 \u0da7 \u0dc1\u0db8\u0db8 \u0db4\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dcf \u0d9a\u0dd2\u0db4\u0dcf \u0dd2\u0da7\u0da7\u0dd2\u0db4\u0dad\u0dca \u0dc1\u0db8 \u0dd0\u0dc1\u0dca \u0dc1\u0db4 \u0daf\u0dca\u0d9c \u0dc3\u0d9a \u0d85\u0d82 \u0db4\u0da7 \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0dcf \u0daf\u0db8\u0db1 \u0d9a\u0daf \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dc3\u0dab \u0dd4\u0dc4\u0db4\u0d9a\u0dca \u0d9a\u0dd2\u0dd2\u0da7\u0dbd\u0dd2 \u0dc3\u0da7\u0d9a \u0dc1\u0db1\u0dcf\u0db8\u0dd0\u0dad\u0dd2 \u0db6 \u0da7 \u0dc1\u0dc3\u0dca \u0d9a\u0dba\u0dd2\u0dc0\u0dd2\u0daf \u0dc1\u0d9a\u0ddd\u0daf\u0db1\u0dcf \u0db1\u0dcf\u0db1 \u0dcf\u0db1 \u0dc0\u0dd2\u0dc1 \u0dca\u0dc2\u0dc1\u0db4\u0dc0\u0dd2\u0daf \u0d9a\u0dd0\u0dd2\u0dba\u0db1\u0dda \u0db4\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dcf\u0dc1\u0dad \u0dc1\u0dca\u0daf\u0dd4 \u0dc0\u0dd2\u0daf \u0dc1\u0d9a\u0dc3 \u0daf\u0d9a\u0dca \u0db1 \u0da2\u0dca\u200d\u0db4\u0dcf\u0db1\u0dc1\u0dcf NHK \u0d86\u0db4\u0dad\u0db1\u0dc1\u0dcf \u0dc1\u0dc4\u0ddd \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0dc1\u0d9a\u0dcf\u0dbb\u0dd2\u0db4\u0dcf\u0dc1\u0dad KBS \u0d86\u0db4\u0dad\u0db1\u0dc1\u0dcf \u0dca \u0dd0\u0dc1\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca \u0db4\u0d9a\u0dca \u0dc1\u0db1\u0dcf\u0db8\u0dd0\u0dad\u0dd2 \u0db6 \u0dad\u0dca, \u0dc1\u0db8\u0db4 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0db8\u0dd4\u0dc5\u0dd4\u0db8\u0dc1\u0dca\u0dc0\u0dd2\u0daf\u0db8 \u0dc0\u0dd2\u0d9a\u0dd8\u0dad\u0dd2 \u0d9a\u0dc3 \u0da2\u0dca\u200d\u0dcf\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0dcf \u0daf\u0dd0 \u0dc3\u0db8 \u0d89\u0d9a\u0d9a\u0dca\u0d9a \u0d9a\u0dc3\u0dc1\u0d9c\u0db1\u0db8 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dc3\u0db1 \u0d9a\u0daf\u0dca\u0daf\u0d9a\u0dca \u0db6 \u0d94\u0dc0\u0dd4\u0dc0\u0dd2\u0daf \u0db4 \u0dc3\u0db1 \u0dcf\u0db1 \u0dc0\u0dd2\u0dc1 \u0dca\u0dc2\u0dc1\u0db4\u0dc0\u0dd2\u0daf \u0da2\u0dca\u200d\u0db4\u0dcf\u0db1\u0db4, \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0dc1\u0d9a\u0dcf\u0dbb\u0dd2\u0db4\u0dcf \u0dd0\u0dc1\u0dca \u0dad\u0dd0\u0db1\u0d9a \u0dc3\u0dcf\u0da2\u0dca\u200d\u200d \u0db8\u0dcf\u0db0\u200d \u0db8\u0dc4\u0da2\u0dca\u200d\u0db1 \u0dc1\u0dc3\u0dca \u0dcf \u0dc3\u0d82\u0d9a\u0dbd\u0dca\u0db4\u0db4 \u0dad\u0daf\u0dd2\u0dc0\u0dd2\u0daf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db4\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dc3\u0db1 \u0dcf\u0db1 \u0dc1\u0d9a\u0ddd\u0d9a\u0dc1\u0dcf \u0d9a\u0dd2\u0dd2\u0da7\u0dbd\u0dd2 \u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0dc3\u0da7\u0d9a \u0da2\u0dca\u200d\u0dcf\u0dad\u0dd2\u0d9a \u0db8\u0dcf\u0db0\u200d \u0d86\u0db4\u0dad\u0db1 \u0dc1\u0d9a\u0dcf\u0da7\u0dc3\u0dca \u0dc1 \u0dc1\u0dc5\u0db3 \u0dc1\u0db4\u0dcf\u0dc5 \u0dad\u0dd4\u0dc5 \u0d9a\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dad\u0dd4\u0d9c\u0dad \u0d9a\u0dc3 \u0db1\u0dd0\u0dc4\u0dd0\u0db1 \u0dc1\u0db4 \u0daf\u0dca\u0d9c \u0dc3\u0d9a \u0dc3\u0db8\u0dcf\u0d9c\u0db8\u0dca \u0dad\u0dd2\u0dd2\u0dba\u0db4 \u0dc4\u0dd0\u0d9a\u0dd2 \u0dc0\u0dd4 \u0dad\u0dca \u0da2\u0dca\u200d\u0dcf\u0dad\u0dd2\u0d9a \u0db8\u0dcf\u0db0\u200d \u0d86\u0db4\u0dad\u0db1 \u0db4 \u0dad\u0dd2\u0dc0\u0dd2\u0daf\u0dc1\u0dc0\u0dd2\u0daf \u0dc3\u0da2\u0dca\u200d\u0db4 \u0dc3\u0dad\u0dd4 \u0dba\u0dd2\u0db1 \u0d95\u0dc3\u0dca\u0dc1\u0dda \u0dc3\u0db4\u0dcf\u0dc1\u0dad ABC, \u0d87\u0dc1\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0dc1\u0dad \u0dc1 \u0dcf\u0dba\u0dd2\u0dc3\u0dca \u0d94 \u0dca \u0d87\u0dc1\u0db8\u0dbb\u0dd2\u0d9a\u0dcf, \u0db6\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dcf\u0db1\u200d\u0dc1\u0dcf \u0db6\u0dd3\u0db6\u0dd3. , \u0d89\u0dc0\u0dd2\u0daf\u0daf\u0dd2\u0db4\u0dcf\u0dc1\u0dad \u0daf\u0dd6\u0dc3\u0daf\u0dbb\u0dca \u0dc0\u0dd2\u0daf, \u0dc3\u0db8\u0dc3\u0dca\u0dad \u0d89\u0dc0\u0dd2\u0daf\u0daf\u0dd3\u0db4 \u0dc0\u0db1 \u0dc0\u0dd2\u0daf\u0dc0\u0dd2\u0dbd\u0dd2 \u0dc3\u0db4 \u0dc3\u0da2\u0dca\u200d\u0db4 \u0dc3\u0dad\u0dd4 \u0dc0\u0db1 \u0dc0\u0dd2\u0daf\u0dc0\u0dd2\u0dbd\u0dd2 \u0dc3 \u0dc4\u0dcf \u0db4\u0dc0\u0db4 \u0dcf\u0db1\u0dd3 \u0dc3\u0db3\u0dc4\u0dcf \u0dc1\u0dc4\u0dcf\u0db3\u0db8 \u0dda\u0daf\u0dcf\u0dc4\u0dc3\u0dab\u0db4\u0dba\u0dd2\u0db1 \u0d85\u0dd4 \u0dd0\u0da9\u0dd2 \u0dc1\u0db4\u0dc0\u0dd2\u0daf \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0d9c\u0dd0\u0da7\u0dd4 \u0db4\u0dd0 \u0dad\u0dd2\u0db4\u0dad\u0dca \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0d86\u0dd2\u0da7\u0db4\u0dcf\u0dc1\u0dad \u0dc3 \u0db8 \u0dc3\u0da7\u0d9a\u0db8 \u0db4\u0dcf\u0dc1\u0dc4\u0dca \u0dc3\u0da2\u0dca\u200d\u0db4 \u0dc3\u0dad\u0dd4 \u0db8\u0dcf\u0db0\u200d \u0db4 \u0dad\u0dd2\u0db1 \u0dcf\u0db1\n\n\u0dca\u0dc1\u0db8\u0dc0\u0dd2\u0daf\u0db8 \u0da2\u0dca\u200d\u0db1\u0db8\u0dcf\u0db0\u200d \u0d9a\u0dca\u0dc1\u0dc2\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dcf \u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd3\u0dc0\u0dd2\u0daf\u0da7 \u0dd6\u0dbb\u0dca \u0dcf\u0daf\u0dbb\u0dca \u0dc3\u0dd0\u0db4\u0dba\u0dd4\u0dc1\u0dad \u0dc3\u0dc4 \u0d86\u0dc3\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dc1\u0dc5\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0d82\u0d9a\u0dcf \u0dc0\u0db1 \u0dc0\u0dd2\u0daf\u0dc0\u0dd2\u0dbd\u0dd2 \u0dc3 \u0dc3\u0d82\u0dc3\u0dca\u0dc0\u0dcf \u0dc3\u0dc4 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0d82\u0d9a\u0dcf \u0db4\u0dc0\u0db4 \u0dcf\u0db1\u0dd3 \u0dc3\u0d82\u0dc3\u0dca\u0dc0\u0dcf \u0dba\u0dd2\u0db1 \u0db4\u0dd4 \u0d9a\u0dcf\u0dd3\u0d9a\u0db1 \u0dc1\u0db8\u0db8 \u0d86\u0db4\u0dad\u0db1 \u0db4\u0dcf\u0d9a\u0db1\u0db4\u0da7 \u0dc1\u0daf\u0dca \u0db4\u0dcf\u0d9a\u0dc1\u0dca\u0d9a \u0db4\u0dad\u0dca \u0db4\u0dd4 \u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd2\u0db4\u0d9a\u0dca \u0dc1\u0db1\u0dcf\u0db8\u0dd0\u0dad\u0dd2 \u0db4\u0dca\u0daf\u0dca\u0d9c\u0d9a\u0dba\u0dd2\u0dc0\u0dd2\u0daf \u0d92 \u0dcf \u0dd2\u0dba\u0db3 \u0daf\u0dd0\u0db8\u0dd6 \u0daf \u0d89\u0dc0\u0dd2\u0daf \u0dca\u0db8 \u0d86\u0db4\u0dad\u0db1\u0db4\u0dc0\u0dd2\u0daf\u0db1\u0dd3 \u0d9a\u0dcf\u0dbb\u0dca\u0db4 \u0dcf\u0dc3\u0db4 \u0d85 \u0dad\u0d9a\u0dca\u0dc1\u0dc3\u0dca\u0dbb\u0dd4 \u0dc0\u0dd2\u0daf\u0dc1\u0dc0\u0dd2\u0daf \u0db1\u0dd0\u0dc4\u0dd0\u0db1"
