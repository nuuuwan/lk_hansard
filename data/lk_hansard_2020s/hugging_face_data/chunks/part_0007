u0dc0\u0dd2\u0db4 [\u0dc2\u0dca\u0da8 \u0dcf\u0dcf \u0dc5\u0dad\u0dd4\u0db1\u0dcf \u0d9a\u0dd2\u0dbd4\u0dcf 4\u0dcf\u0dc1\u0dda \u0dc1\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0dc1\u0db6\u0dcf\u0dc1\u0dc4\u0ddd \u0dca\u200d\u0dbb\u0dc1\u0dda 4\u0dca\u200d 4\u0dcf\u0d85\u0dba\u0dcf \u0dca\u200d\u0dbb \u0dda\u0dcf \u0dd2 \u0dc1\u0db6\u0dcf4\u0dcf. 4\u0dcf\u0d85\u0dba\u0dcf \u0db4\u0dc4\u0dbb\u0daf\u0dd3\u0dca \u0db1\u0dd2\u0d9a\u0dcf \u0d85\u0dc0\u0dd4\u0dc0 \u0dda\u0dd9\u0dc5\u0da7 \u0dc0 \u0db4\u0dd2 \u0daf \u0dc1\u0dc5\u0ddd\u0dba\u0da7 3],]]] [ \u0dc0\u0dd2\u0dad\u0dbb 4\u0dba\u0da7\u0dcf\u0dcf \u0dc1\u0dda\u0db4\u0db8 \u0dc0\u0dd2\u0dcf\u0dcf \u0dc14\u0dcf4\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dc1\u0dca \u0dca\u200d\u0dbb \u0dda\u0dcf \u0da7 \u0dc0\u0dd2\u0d9a\u0db3\u0dd4\u0db1 [ \u0db1\u0dca\u0dcf \u0d9c\u0dd2 \u0dcf\u0db1 \u0dc1\u0db1\u0dcf\u0dca\u200d\u0dbb\u0dca\u0dae4\u0dba\u0dcf\u0db1\u0dca, \u0db4\u0dc0\u0dd4\u0dca4\u0dba\u0dcf\u0db1\u0dca \u0dc0\u0dd2\u0dc1\u0dda \u0d86\u0db0\u0dcf\u0dbb \u0db1\u0dca\u0dcf \u0d85 \u0d8b\u0d9a\u0dcf\u0dc0\u0dd2 \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca \u0dad\u0dc4\u0dcf\u0dca \u0db1\u0dd2\u0dc1 \u0ddd \u0db1\u0dca\u0dcf4\u0dcf. \u0d94 \u0d85\u0dba\u0dcf \u0d85 \u0daf \u0dc5\u0dd0\u0db4\u0dd3\u0db1 \u0d86\u0dbb\u0dca\u0db7 \u0dc5\u0dc1\u0db8\u0dda \u0db1\u0db1. \u0d8b\u0d9a\u0dcf\u0dc0\u0dd2\u0dc1\u0dda \u0dc1\u0dca \u0db1\u0dd2\u0dc1 \u0ddd \u0dc1\u0dd9\u0dcf \u0d85 \u0dc1\u0dda \u0dc1 4 \u0daf4\u0dca\u200d\u0da7 \u0d85\u0dba\u0dcf \u0dc4\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dca \u0dcf\u0dd0\u0dc4\u0dd0. \u0dcf\u0dd4 \u0dd9\u0db1\u0dcf \u0d85 \u0dc1\u0dda \u0dc1 4 \u0daf4\u0dca\u200d\u0da7 \u0d85\u0dba\u0dcf \u0dc4\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dca \u0dcf\u0dd0\u0dc4\u0dd0. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d854\u0d9a\u0dcf\u0dcf\u0dc1\u0dda \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0dd9\u0dc4\u0d9a\u0dda \u0dcf [ \u0dc0\u0dd2\u0dcf\u0dcf \u0dc14\u0dcf4\u0dcf. \u0d85\u0dba\u0dcf\u0dca \u0db1\u0dd0\u0dc1\u0dbb\u0dcf4\u0dcf. \u0db