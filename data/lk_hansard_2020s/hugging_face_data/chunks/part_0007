a \u0dc4\u0dd2\u0dbb \u0dc5\u0dbb \u0dd2 \u0db6\u0dd4 \u0dcf.\n\n\u0dc0 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dca\u200d\u0dba \u0dc5\u0dcf\u0dbb\u0dc5 \u0d9a\u0db7\u0dcf\u0db4\u0dd2 \u0dad\u0dd4\u0db1\u0db1\u0dd2, \u0d9a\u0db1\u0dc4\u0dbb \u0dc5\u0dcf\u0dca\u200d4\u0dca\u200d\u0daf\u0dd3 \u0d9a\u0db1\u0dc4\u0dbb \u0da2\u0dca\u200d\u0dca\u200d\u0dcf 4\u0dca\u200d \u0da2\u0dca\u200d\u0dca\u200d \u0dc0\u0dd2\u0dd4\u0dc0\u0dba\u0dcf \u0d8b\u0dca \u0db4\u0dcf\u0dd9\u0dcf \u0da7 \u0dc1 \u0dcf\u0dd9\u0dcf \u0dc1\u0dcf\u0dcf\u0dc1 \u0dcf\u0db1 \u0d85 \u0db4\u0dc1\u0dca \u0dcf4\u0dcf. \u0d8a\u0da7 \u0db4\u0dc3\u0dd44 \u0dbb\u0da7\u0da7 \u0dc0\u0dd2\u0dd4\u0dc0\u0dba\u0dcf \u0dcf\u0dd0\u0dc4\u0dd0. \u0dc0\u0dd2\u0dd4\u0dc0\u0dba\u0dcf \u0d9a \u0daf\u0dba\u0dcf4\u0dca\u200d\u0da7 \u0db1\u0dca\u0dcf4\u0dcf. \u0dc0\u0dd2\u0dd4\u0dc0\u0dba\u0dcf\u0db6\u0dca\u200d \u0db1\u0dab\u0dca\u0da9\u0db1\u0dca\u200d \u0da7 \u0d9a \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0dc0\u0dd2\u0dd4\u0dc0\u0dba\u0dcf \u0dc0\u0dd2\u0d9a\u0dd2\u0dab\u0dd3\u0db1\u0da7 \u0dc0\u0dd2\u0dd4\u0dc0\u0dba\u0dcf \u0d8b\u0dca \u0db4\u0dcf\u0dd9\u0dcf \u0dc5\u0dbb\u0dcf \u0d9a \u0dc0\u0dd2\u0dd4\u0dc0\u0dba\u0dcf \u0da2\u0dca\u200d\u0dcf\u0dc5 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb4\u0dca\u200d \u0d85\u0dba\u0dd2\u0dd2 \u0dc5\u0dc0 \u0dc14\u0ddd \u0dc5\u0dc0\u0dd4\u0dd9? \u0dc1\u0db6\u0dcf\u0dc1\u0dc4\u0ddd \u0d85\u0dba\u0dd2\u0dd2 \u0dc5\u0dc0 \u0dc14\u0ddd \u0dc0\u0dd2\u0dd4\u0dc0\u0dba\u0dcf\u0db6\u0dca\u200d \u0db1\u0dab\u0dca\u0da9\u0db1\u0dca\u200d\u0dc1\u0dda\u0db1 \u0dd2\u0db1\u0dca\u0dcf \u0dc1\u0da2\u0dca\u200d\u0dba\u0dc2\u0dca\u0da8\u0dda\u0db0 \u0db1\u0dd2\u0dca\u200d\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca. \u0dc0 \u0db4\u0dd2 \u0daf \u0dc1\u0dc5\u0ddd\u0dba\u0da7-\u0dca\u200d\u0dbb\u0dc1\u0dc5\u0ddd\u0dba\u0da7 \u0dcf [ \u0db4\u0dcf\u0dd4 \u0dca\u200d\u0db6\u0db8\u0dd2\u0db1\u0dca, \u0d85\u0dc0\u0dd4\u0dc0 \u0dda\u0dd9\u0dc5\u0da7 \u0dc1\u0dd9\u0dad\u0dd4\u0db1\u0dca 4\u0dad\u0dcf4 [ \u0dc1\u0db6\u0ddd\u0dcf\u0d9a\u0d