    "chunk_text": "\u0dc1\u0dca\u0dc5 \u0dc1\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0dc5\u0dc1\u0dda \u0dc4\u0dd0\u0dbb\u0dc0\u0dd4\u0dca \u0dca\u200d [\u0dc2\u0dca\u0da8\u0dba [ \u0db1\u0dd2\u0dbb\u0dca\u0dae\u0db1\u0dcf \u0dc5\u0dbb\u0dcf \u0db4\u0dcf\u0dad [. \u0d87\u0dba\u0dd2 \u0db1\u0db1 \u0db1\u0dc1\u0dc4\u0db1 \u0d9a\u0dd2 \u0db1\u0dca\u0dc1\u0db1\u0dca? \u0d85\u0db4\u0dd2 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2 \u0d85\u0dc0\u0dd4\u0dc0 \u0dd4\u0dc0 \u0dc1\u0dd9\u0dc5 \u0dad\u0dd4\u0db8 \u0dcf4 \u0db1\u0dd3\u0dd2 8] [ \u0db4\u0db1 \u0dc1\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dae\u0dba\u0dcf\u0dc1\u0dca\u0db1\u0dca\u0dad\u0dd44 \u0dad\u0dd4\u0db8 \u0d9a\u0dca\u0db1\u0dad \u0dc5\u0db8\u0dcf. \u0db1\u0dad\u0dc1\u0dc5\u0dcf\u0da7 \u0d85\u0dc4\u0dcf4\u0dcf, \u0db4\u0dcf\u0dca \u0dc1 \u0dcf\u0dd0 \u0daf\u0dca\u200d\u0dcf, \u0db1\u0dd3\u0dd2 \u0dc1 \u0dcf\u0dd0 \u0daf\u0dca\u200d\u0dcf \u0dc5\u0db1\u0dca\u0dcf\u0dd9, \u0d9a\u0dc1 [ \u0dca\u200d\u0dbb\u0dd2 \u0dbd\u0dca\u200d \u0dc1\u0db1\u0dcf\u0dc5 [\u0dd9 \u0d9a\u0dd2 \u0dca\u200d\u0dcf. \u0dc1\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0dc5 \u0dc4\u0dd9\u0db1\u0dca\u0dcf, \u0dc1\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0dc5 \u0d9a\u0d824\u0dbb\u0dca\u0dae\u0db0\u0dcf 4\u0dd0\u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0dc14\u0db8 [ \u0dc1 \u0db1\u0dd2 \u0db1\u0dca\u0dcf, \u0dc1\u0dca \u0dc5\u0db1\u0dcf 4\u0dd0\u0dd4\u0db8\u0dab\u0dd4 \u0dbb\u0da7 \u0dcf\u0dd04\u0dad \u0dc1 \u0dcf\u0db1\u0dcf\u0dd9\u0dcf \u0d854 \u0dba \u0dc5\u0dbb\u0dcf 4\u0dd0\u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0dc14\u0db8\u0da7 \u0db1\u0dcf. \u0dc5\u0dbb\u0dcf \u0d85\u0daf\u0dd9\u0dca \u0db1\u0dd3\u0dd2 , \u0db1\u0dc1\u0dc4\u0db1 \u0dcf\u0dd0\u0dca \u0dcf\u0dca \u0dc1\u0dc5\u0dd4\u0db8\u0dca\u0db4\u0dca \u0dad\u0db1\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dc4\u0dd0\u0dd4\u0dc0\u0dc1\u0dbd.\n\n\u0d9a \u0d87\u0dba\u0dd2? \u0dc0\u0dd2\u0dd4\u0dc0\u0dba\u0dcf\u0db6\u0dca\u200d \u0db1\u0dab\u0dca\u0da9\u0db1\u0dca\u20