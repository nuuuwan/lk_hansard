8 \u0ddc\u0dca\u0db8\u0dd2 \u0d82\u0d9c,\u0dca\u0db0 \u0dab\u0dca\u0da9\u0dbd\u0d9a ( \u0dca\u0dab\u0ddc\u0dca\u0dca\u0db4\u0dd4\u0dbb,\u0dbb\n\n\u0dca\u0dab\u0ddc\u0dca\u0dca\u0db4\u0dd4\u0dbb,\u0dbb \u0d82\u0dcf\"\u0ddc\n\n09 \u0db4\u0da2\u0dca\u200d\u0ddd \u0d9a\u0d9c \u0ddc \u0db4\u0dd4\u0dbb,\u0daf\u0dca\u0db8\u0dbd\u0dd2\u0db8 \u0d82\u0dab\u0ddc\u0db8\u0dab\n\n\u0dc3\u0d9f\u0dbd\u0dd4\u0db1 \u0dca\u0dab\u0ddc\u0dca\u0dca\u0d9b\u0ddc\u0d9a\u0ddc,\n\n\u0db6\u0daf\u0dca\u0db4\u0daf\u0dca\u0db8\u0dab\n\n10 \u0d82\u0dda\u0da7\u0ddc\u0dca \u0db8\u0ddc\u0dab\u0dca\u0da7\u0dca\u0da7 \u0db4\u0dd4\u0dbb,\u0daf\u0dca\u0db8\u0dbd\u0dd2\u0db8 \u0d82\u0dab\u0ddc\u0db8\u0dab\n\n\u0dc3\u0d9f\u0dbd\u0dd4\u0db1 \u0dca\u0dab\u0ddc\u0dca\u0dca\u0d9b\u0ddc\u0d9a\u0ddc,\n\n11 \u0dc5\u0dd4\u0db4\u0db6\u0ddd\u0dc0\u0dd2\u0da7\u0dd2 \u0ddc \u0db4\u0dad\u0dca \u0dca\u0dab\u0ddc\u0dca\u0dca \u0d9b\u0ddc\u0d9a\u0ddc,\n\n\u0db4\u0dad\u0dca \u0dca\u0dab\u0ddc\u0dca\u0dca\u0d9b\u0ddc\u0d9a\u0ddc,\n\n\u0dca,\u0d9a\u0dab\n\n12 \u0daf. \u0db4\u0d9a\u0ddd\u0dbb\u0dca\u0d82\u0dda \u0dd9 \u0db1\u0dca\u0dca ,\u0ddc\n\n\u0ddc\u0db6\u0db1\u0dd2 \u0dba\u0dbb \u0dbb \u0db4 \u0ddc\u0db4\"\u0ddc\u0dbb \u0db1\u0dd2\u0dc2\u0dda \u0ddc\u0dd9 ,\u0dba\u0ddc \u0dd2\u0db6\u0dd9\n\n\u0dbb\u0dad\u0dca\u0db8\u0dab\n\n(iii)\n\n(iv)\n\n(v) \u0d94\u0dda.\n\n(vi) \u0db4\u0db6\u0da7\u0dca\u0d82\u0dda \u0db8\u0df2\u0dda \u0d94\u0dc6\u0dda \u0db1 \u0dd0\u0dca \u0db4\u0dd4\u0dbb,\u0daf\u0dca\u0db8\u0dbd\u0dd2\u0db8 \u0d82\u0dab\u0ddc\u0db8\u0dab - \u0db4 \u0ddc\u0dc0\u0dd2\u0dda \u0dab\u0db0\u0dba\u0d82\u0dda\u0dae\u0ddc \u0db4,\u0dca \u0d9a\u0db6\u0ddc \u0daf\u0dd3\u0dab \u0db4\"\u0dda\u0dad\u0dd4 \u0db4,\u0dca \u0dca\u0dd9\u0ddc\u0dc5 ,\u0dba\u0ddc \u0dd2\u0db6\u0dd9 \u0db1\u0dca\u0db4\u0db8\u0dca \u0dca\u0da9\u0dbd\u0db4\u0db1 \u0d9a\u0dca \u0db6\u0dd9 \u0db7\u0ddc\u0dbb\u0db4\u0db8 \u0db6\u0dd9\u0db6\u0dd4\u0dab\u0dd2. \u0dc3\u0dd4, \u0dca\u0dd9\u0ddc\u0dc5 \u0d86 \u0dca \u0dc0\u0dd2\u0db1\u0dca\u0dca \u0dca\u0dca \u0dbd\u0dd4\u0db1 \u0db1\u0dca \u0db4,\u0dca \u0db1\u0dd2 \u0db8\u0dd2\u0dca \u0d9a\u0da7 \u0d9a\u0dca \u0db6\u0dd9 \u0db7\u0ddc\u0dbb \u0db4 \u0ddc\u0daf\u0dd3\u0dab \u0db4\"\u0dda\u0dad\u0dd4 \u0db4,\u0dca \u0db8\u0dd0\u0da7\u0dbd\u0dd4 \u0d82\"\u0db8\u0dca \u0dca\u0dad\u0dca\u0dad\u0dca, \u0dc3\u0db6\u0dd9 \u0dc0\u0dd2 . \u0db8\u0dd0\u0da7\u0dbd\u0dd4, \u0db1\u0dd2\u0dbb\u0ddc \u0dbb\u0d85\u0db4 \u0dca \u0dc3\u0dd4 \u0dca\u0dd9\u0ddc\u0dc5 \u0dca\u0dca \u0dbd\u0dd4\u0db1 \u0db1\u0dca \u0db4,\u0dca \u0dd0,\u0dca \u0d9a\u0dca \u0db6\u0dd9 \u0db7\u0ddc\u0dbb \u0daf\u0dd3\u0dab\u0da7 \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dd6 \u0dd9\u0ddc \u0db1 \u0dbb \u0dc3\u0dca.\n\n(\u0d86 \u0dca\u0dd9\u0ddc\u0dc5 \u0db4 \u0ddc\u0db4\u0dda. \u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0dd9\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b9a\u0baa\u0bc6\u0bbe\u0ba8\u0bc6\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Speaker) \u0db8\u0db1\u0dca \u0dab\u0dca\u0dd3\u0dad\u0dd4 \u0dab\u0ddc\u0d85 \u0dca\u0dad\u0dd4 \u0db1\u0dca \u200d\u0dbb\u0d9b\u0dda \u0db6\u0dd9\u0db4\u0db6 ,\u0ddc\u0dd9? \u0dd4 \u0db1\u0dd2\u0dc1\u0dca\u0dcf\u0db1\u0dca\u0dad \u0d9c\u0db4\u0d9c\u0dbb\u0dca\u0dbb\u0dcf \u0dd9\u0dad\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba8\u0bbf\u0bb7\u0bc6\u0bbe\u0ba8\u0bcd\u0ba4 \u0ba4\u0baa\u0b9a\u0bb0\u0bb0\u0bc6\u0bbe) (The Hon. Nishantha Perera) \u0dd0\"\u0dd0\u0d85 \u0db8\u0db1\u0dca \u0dae\u0ddc \u0ddc \u0dad\u0dd4 \u0dab\u0db1\u0dd2. \u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0dd9\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b9a\u0baa\u0bc6\u0bbe\u0ba8\u0bc6\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Speaker) \u200d\u0dbb\u0d9b\u0dda \u0dca\u0d9c 10 -1120\u0dd32025- (1 \u0d85 \u0db8\u0db1\u0dca \u0dbb\u0dd3\u0dca\u0dbb \u0db6\u0dca\u0da9\u0dbd\u0ddc\u0dbb \u0dab\"\u0dca\u0ddc.\n\n\u0dca.\u0dca. \u0dca\u0dab\u0ddc\u0dca\u0dca\u0d9b\u0ddc\u0d9a\u0ddc, \u0dca\u0dab\u0ddc\u0dca\u0dca\u0db4\u0dda \u0d82\u0dda,\u0db7\u0ddc,\n\n01 \u0d82\u0dd0\u0db1\u0d82\u0dca \u0dbb\u0db6\u0dca \u0db1\u0dd2\u0dc2\u0dda \u0ddc\u0dd9 (\u0db4\u0dd4\u0dbb,\u0daf\u0dca\u0db8\u0dbd\u0dd2\u0db8 \u0d82\u0dab\u0ddc\u0db8\u0dab\n\n\u0dbb\u0db6\u0dca \u0db1\u0dd2\u0dc2\u0dda \u0ddc\u0dd9 \u0dca\u0dab\u0ddc\u0dca\u0dca\u0d9b\u0ddc\u0d9a\u0ddc,\n\n02 \u0da9\u0dd3. \u0d82\u0dd0\u0db1\u0d82\u0dca \u0dca\u0dab\u0ddc\u0dca\u0dca \u0d86 \u0dca\n\n\u0dbb\u0db6\u0dca \u0db1\u0dd2\u0dc2\u0dda \u0ddc\u0dd9 \u0dca\u0dab\u0ddc\u0dca\u0dca\u0d9b\u0ddc\u0d9a\u0ddc,\n\n03 \u0d82\u0dda\u0da7\u0ddc\u0dca \u0dd0\u0dc2\u0dca \u0db4\u0d9a\u0ddd\u0db6\u0dd9\u0dca \u0db4\u0dd4\u0dbb,\u0daf\u0dca\u0db8\u0dbd\u0dd2\u0db8 \u0d82\u0dab\u0ddc\u0db8\u0dab\n\n\u0dc3\u0d9f\u0dbd\u0dd4\u0db1 \u0dca\u0dab\u0ddc\u0dca\u0dca\u0d9b\u0ddc\u0d9a\u0ddc,\n\n04 \u0dc3\u0dd3\u0dd3\u0d82 \u0d9a\u0dd0\u0db1\u0dca \u0ddc\u0dca\u0d82\u0dda (\u0db4\u0dd4\u0dbb,\u0daf\u0dca\u0db8\u0dbd\u0dd2\u0db8 \u0d82\u0dab\u0ddc\u0db8\u0dab\n\n\u0dd0\u0dbb\u0dab\u0dd2 ,\u0ddc\" ,\u0d9a\u0da7 \u0dca,\u0d9b\u0dba \u0dca\u0dab\u0dca\u0dbb \u0db4 \u0ddc\u0da7\u0d82\u0dda \u0db1\u0dd2\u0dc2\u0dda \u0ddc\u0dd9 ,\u0dba\u0ddc \u0dd2\u0db6\u0dd9\n\n05 \u0dc3\u0dd4\u0da2\u0dd3, \u0dc6\u0ddc\u0db1 \"\u0dc0\u0dd4\u0d82\u0dda \u0d82\u0dad\u0dca, \u0db4\u0db8\u0ddc\u0dc0\u0dd2 \u0dc5\n\n06 \u0daf\u0dd3 \u0ddc \u0db8\u0ddc\u0dca\u0dab\u0dca\u0da7\u0dca\u0da7 \u0db4\u0dd4\u0dbb,\u0daf\u0dca\u0db8\u0dbd\u0dd2\u0db8 \u0d82\u0dab\u0ddc\u0db8\u0dab\n\n\u0dc3\u0d9f\u0dbd\u0dd4\u0db1 \u0dca\u0dab\u0ddc\u0dca\u0dca\u0d9b\u0ddc\u0d9a\u0ddc,\n\n07 \u0ddc\u0dca\u0db8\u0dd2 \u0d82\u0d9c,\u0dca\u0db0 \u0dab\u0dca\u0da9\u0dbd\u0d9a ( \u0dca\u0dab\u0ddc\u0dca\u0dca\u0db4\u0dd4\u0dbb,\u0dbb\n\n\u0dca\u0dab\u0ddc\u0dca\u0dca\u0db4\u0dd4\u0dbb,\u0dbb \u0d82\u0dcf\"\u0ddc\n\n08 \u0db4\u0da2\u0dca\u200d\u0ddd \u0d9a\u0d9c \u0ddc \u0db4\u0dd4\u0dbb,\u0daf\u0dca\u0db8\u0dbd\u0dd2\u0db8 \u0d82\u0dab\u0ddc\u0db8\u0dab\n\n\u0dc3\u0d9f\u0dbd\u0dd4\u0db1 \u0dca\u0dab\u0ddc\u0dca\u0dca\u0d9b\u0ddc\u0d9a\u0ddc,\n\n09 \u0d82\u0dda\u0da7\u0ddc\u0dca \u0db8\u0ddc\u0dab\u0dca\u0da7\u0dca\u0da7 \u0db4\u0dd4\u0dbb,\u0daf\u0dca\u0db8\u0dbd\u0dd2\u0db8 \u0d82\u0dab\u0ddc\u0db8\u0dab\n\n\u0dc3\u0d9f\u0dbd\u0dd4\u0db1 \u0dca\u0dab\u0ddc\u0dca\u0dca\u0d9b\u0ddc\u0d9a\u0ddc,\n\n10 \u0dc5\u0dd4\u0db4\u0db6\u0ddd\u0dc0\u0dd2\u0da7\u0dd2 \u0ddc \u0db4\u0dad\u0dca \u0dca\u0dab\u0ddc\u0dca\u0dca\u0d9b\u0ddc\u0d9a\u0ddc,\n\n\u0db4\u0dad\u0dca \u0dca\u0dab\u0ddc\u0dca\u0dca\u0d9b\u0ddc\u0d9a\u0ddc,\n\n11 \u0daf. \u0db4\u0d9a\u0ddd\u0dbb\u0dca\u0d82\u0dda \u0dd9 \u0db1\u0dca\u0dca ,\u0ddc \u0ddc\u0db6\u0db1\u0dd2 \u0dba\u0dbb \u0dbb \u0db4 \u0ddc\u0db4\"\u0ddc\u0dbb \u0db1\u0dd2\u0dc2\u0dda \u0ddc\u0dd9 ,\u0dba\u0ddc \u0dd2\u0db6\u0dd9\n\n\u0dca.\u0dca. \u0db4\u0dd4\u0dbb,\u0daf\u0dca\u0db8\u0d9a \u0ddc\u0dd3\u0d82\u0dab\u0ddc\u0db8\u0dab \u0dca\u0dab\u0ddc\u0dca\u0dca\u0db4\u0dda \u0d82\u0dda,\u0db7\u0ddc,"
