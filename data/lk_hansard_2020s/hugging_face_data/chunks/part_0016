    "chunk_text": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dd9\u0d82\u0d9a\u0dcf \u0dca\u200d\u0dbb\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0d9c\u0dad \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0d9c\u0dad \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dd9\u0dd9 \u0dcf\u0d82\u0d9a 2382 \u0dc4\u0dcf 2024.04.26 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab \u0d9c\u0dc3\u0dda\u0dc0\u0dcf \u0db1\u0dd2\u0dd9\u0db1\u0dcf\u0db4\u0dad \u0d9c\u0dc3\u0dda\u0dc0\u0d9c\u0dad III \u0d9c\u0dbb\u0dda\u0dab\u0dd2\u0dba\u0db4 \u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0dad\u0dd2\u0d9c\u0db8\u0dca \u0dc3\u0dd3\u0db8\u0dd2\u0dad \u0dad\u0dbb\u0d9c \u0dc0\u0dd2\u0db7\u0dcf\u0d9c\u0dba 2024\u0dc4\u0dd2 \u0dc0\u0dd2\u0db7\u0dcf\u0d9c \u0db1\u0dd2\u0d9c \u0dd9\u0db1\u0dba \u0dcf\u0db1\u0dd4\u0dc0 2024.08.18 \u0daf\u0dd2\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dd9\u0d82\u0d9a\u0dcf \u0dc0\u0dd2\u0db7\u0dcf\u0d9c \u0d9c\u0dd9\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf \u0d87\u0dad.\n\n(\u0dc0\u0dd2\u0db7\u0dcf\u0d9c \u0db1\u0dd2\u0d9c \u0dd9\u0db1\u0d9c\u0dad 13.0\u0dc4\u0dd2 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc0\u0dd2\u0db7\u0dcf\u0d9c \u0db4\u0da7\u0dd2\u0db4\u0dcf\u0da7\u0dd2\u0dba \u0dcf\u0db1\u0dd4\u0dc0 \u0dc0\u0dd2\u0db7\u0dcf\u0d9c\u0dba \u0dc3\u0db8\u0dad\u0dca\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd2\u0db7\u0dcf\u0d9c\u0d9c\u0dad \u0d91 \u0dbd \u0dc0\u0dd2\u0dc2\u0dca\u0da8\u0dba \u0dbd \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0db8\u0dad\u0dca \u0dd9\u0d9c\u0dda\u0dab\u0dd4 \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba 40 \u0dbd \u0dd9 \u0dc0\u0dd2\u0db7\u0dcf\u0d9c\u0d9c\u0dad \u0db8\u0dd4 \u0dc0 \u0dd9\u0d9c\u0dda\u0dab\u0dd4 \u0d9c\u0dab\u0db1\u0dd2\u0db1\u0dca \u0dba\u0db4\u0dad\u0dca \u0db4\u0dd2\u0db4\u0dad\u0d9c\u0dc3\u0dba\u0dd2\u0db1\u0dca \u0