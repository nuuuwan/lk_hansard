    "chunk_text": "1959 \u0dc0\u0dc3\u0dba\u0dca\u0daf\u0dd3 \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0dd2\u0db0\u0dc0\u0dcf \u0dba\u0dc0\u0db8\u0dc0\u0dcf \u0db8\u0dba \u0dbb\u0dc2\u0dbb\u0dc0\u0dbb\u0dd3 \u0d85\u0dd4\u0dad\u0dd2\u0db0 \u0dcf\u0dba\u0dca \u0db8 \u0dad\u0dca\u0dc4\u0db8\u0dd2\u0dba \u0dc3\u0db8 . \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba \u0daf \u0daf\u0dcf \u0db8\u0dcf\u0dd2\u0dd0\u0dcf\u0dba\u0dda \u0daf\u0dd2\u0dba\u0dc0\u0da9\u0db8 \u0db1\u0dd2\u0dbd\u0dba\u0dca\u0dc0\u0dbb\u0dba\u0dba\u0dca \u0dc0\u0dd6 \u0db4\u0dd3.\u0db6\u0dd3. \u0db1\u0dd4\u0dd0\u0dba\u0dc0\u0dbd \u0db8\u0db1\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dba \u0db8\u0dd2\u0db1\u0dd2\u0db6\u0dd2\u0dba\u0db4\u0dba\u0dca \u0dba\u0dc0\u0db8\u0dc0\u0dcf. \u0dd2 \u0db4\u0dd4 \u0daf \u0dcf\u0dad\u0dca\u0dc4 \u0dc3\u0db7\u0dcf \u0db8\u0db1\u0dca\u0dd3 \u0dc3\u0dcf\u0dd3\u0dc0\u0dc0 \u0db4\u0dd2\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db8 \u0dcf \u0dba\u0da2\u0dba\u0dc2\u0dbb\u0da8 \u0dc0\u0dad\u0dd4\u0db8 \u0daf\u0dcf\u0dbd\u0d9a\u0dc0\u0dbb\u0dba\u0dba\u0dca \u0dc0\u0dd6 \u0db8\u0dba \u0dbb\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb \u0db4\u0dd2\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db8 \u0dcf \u0d85\u0db8\u0dcf\u0dd2 \u0dba\u0dc3\u0dbb\u0db8\u0dcf\u0db8\u0dcf\u0dba\u0d9a \u0db8 \u0dad\u0dca\u0dc4\u0db8\u0dd2\u0dba \u0dc3 \u0dc3\u0db8\u0db1\u0dca\u0dad\u0dd2 \u0db4\u0dd2\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db8 \u0dad\u0dca\u0dc4\u0db8\u0dd2\u0dba \u0dba\u0db8 \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dbb\u0dba\u0daf\u0db8\u0dcf \u0d85 \u0dba\u0db4\u0db1\u0dca \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dba \u0dc0\u0db1\u0dd2 \u0db8 \u0dbd\u0dca \u0daf\u0dd2\u0dba\u0dab\u0dd2\u0dba \u0dc0\u0db8 \u0dc3\u0db8\u0db1\u0dca\u0dad\u0dd2 \u0db4\u0dd2\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db8 \u0dad\u0dca\u0dc4\u0db8\u0dd2\u0dba \u0dd2\u0db0\u0dc0\u0dcf \u0dba\u0dc0\u0dbd\u0dcf \u0dbd\u0db1\u0dca\u0dba\u0db1\u0dca \u0dd2 \u0db4\u0dd4 \u0daf\u0dcf\u0dca\u0dd2\u0dba\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dba\u0dba\u0d9a\u0dd4 \u0dc0\u0db8 \u0dbb\u0dcf\u0da2\u0dd2\u0dad\u0dca\u0dc4 \u0d85\u0dd4\u0dad\u0dd2\u0db0 \u0dcf\u0dba\u0dca \u0db8\u0db1\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0dc3\u0db8 \u0dba\u0dd2. \u0db4\u0dd2\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db8\u0db1\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0dc0\u0db1\u0dd2\u0db0\u0dd2\u0d9a\u0dbb\u0dd4\u0dba\u0dc0\u0dca. \u0db4\u0dd2\u0dba \u0d8b\u0dbb\u0dd4\u0db8\u0dba\u0dba\u0db1\u0dca \u0dbd\u0db1\u0db6\u0dd4\u0dab\u0dd4 \u0dbb\u0dad\u0dca\u0dc4\u0db8\u0db4\u0dd4\u0dbb \u0daf\u0dd2\u0dc3\u0dbb\u0dd2\u0dca\u0d9a\u0dba\u0dda \u0dba\u0daf\u0dbd\u0dca\u0dc0\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0dc1\u0dba\u0dda \u0db4\u0dd2\u0dd2\u0da7\u0dd2 \u0dd2\u0db0 \u0dcf\u0db8\u0d9a\u0db1\u0dca\u0daf \u0dc0\u0dad\u0dd4\u0db8\u0dba\u0dcf\u0dba \u0dc3 \u0dba\u0dad\u0dca\u0dc4 \u0d9a\u0dca\u0db8\u0dcf\u0db1\u0dca \u0dc1\u0dcf\u0dbd\u0dcf\u0dc0 \u0dc3\u0dd2\u0dba \u0daf\u0dc0\u0dd4\u0dba\u0dbd\u0dca \u0dc0\u0dba\u0dcf\u0daf\u0dcf\u0dbb\u0dba \u0dba\u0dbd\u0dc3 \u0daf\u0dc0\u0dad\u0dca\u0dc4\u0dc0\u0dcf\u0dba\u0dd0\u0db8 \u0d9c\u0dd2\u0dba \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0dc0\u0db1\u0dd2\u0db0\u0dd2\u0d9a\u0dbb\u0dd4\u0dba\u0dc0\u0d9a\u0dd4 \u0dba\u0dbd\u0dc3\u0dad\u0dca\u0dc4 \u0dba\u0dad\u0dca\u0dc4 \u0db1\u0dd2\u0dc2\u0dbb\u0daf\u0dcf\u0daf\u0d9a\u0dba\u0dba\u0d9a\u0dd4 \u0dba\u0dbd\u0dc3\u0dad\u0dca\u0dc4 \u0dbb\u0dba\u0da7\u0dca \u0db1\u0dd2\u0dc2\u0dbb\u0daf\u0dcf\u0daf\u0db8\u0dba \u0daf\u0dcf\u0dba\u0d9a \u0dc0\u0dd4\u0dab\u0dcf. \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db8\u0dcf\u0dbb\u0dd6\u0daa \u0dd0\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba\u0db1\u0dd2 \u0d85\u0dba\u0db6\u0dca\u0dbd\u0dbb\u0dad\u0dca\u0dc4\u0db8 \u0db4\u0dd2\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db8\u0db1\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0daf\u0dcf\u0dca\u0dd2\u0dba\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dba\u0d9a\u0dd4 \u0dba\u0dbd\u0dc3 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4\u0dc0 \u0d85 \u0d9a \u0daf\u0db8\u0dab \u0d9a\u0dcf\u0dbd\u0dba\u0dca \u0dba\u0dca \u0daf\u0dcf\u0dca\u0dd2\u0dba\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0 \u0db1\u0dd2\u0dba\u0dba \u0da2\u0db8\u0dba \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dbb\u0dad\u0dca\u0dc4\u0db8\u0db4\u0dd4\u0dbb \u0daf\u0dd2\u0dc3\u0dbb\u0dd2\u0dca\u0d9a\u0dba \u0dad\u0dca\u0dc4 \u0d92 \u0dc0\u0dcf\u0dba \u0db8 \u0db8 \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0dba\u0dbd\u0dc3 \u0dc3\u0db6\u0dbb\u0dd0\u0db8\u0dd4\u0dc0 \u0daf \u0dcf \u0dad\u0dca\u0dc4 \u0db1\u0dd2\u0dba\u0dba \u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dba\u0dca \u0dba\u0dbd\u0dc3 \u0dbb \u0dad\u0dca\u0dc4 \u0dba\u0dc3\u0dbb\u0dc0\u0dba \u0d9a\u0dbb \u0dad\u0dd2\u0dba\u0db6\u0db8\u0dc0\u0dcf. \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4\u0dc0 97\u0dca \u0daf\u0db8\u0dab \u0d86\u0dba\u0dd4 \u0dc0 \u0db3\u0dcf \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf 2023 \u0dba\u0daf\u0db6\u0dbb\u0dc0\u0dcf\u0dba\u0db4 \u0db8\u0dc3 22 \u0dc0\u0db8 \u0daf\u0dd2\u0db8 \u0d85\u0db7\u0dcf\u0dc0\u0db4\u0dca\u200d\u0dbb\u0dcf\u0db4\u0dd9 \u0dc0\u0dd4\u0dab\u0dcf. \u0d85\u0db7\u0dcf\u0dc0\u0db4\u0dca\u200d\u0dbb\u0dcf\u0db4\u0dd9 \u0dd0\u0dbb\u0dd4 \u0d85\u0dba\u0db6\u0dca\u0dbd\u0dbb\u0dad\u0dca\u0dc4\u0db8 \u0db4\u0dd2\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db8\u0db1\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0db1\u0dd2\u0dc0\u0db1\u0dca \u0dc3\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dca\u0dae\u0db8\u0dcf \u0d9a\u0dbb\u0db8 \u0d85 \u0dbb \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dba \u0daf\u0dba\u0dcf\u0db6\u0dbb \u0daf\u0dd6 \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0da5\u0dcf\u0dad\u0dd3\u0db1\u0dca \u0dba\u0dc0 \u0dba\u0db8\u0db8 \u0d8b\u0dad\u0dca\u0dc4 \u0dbb\u0dd3 \u0dbb \u0dc3\u0db7\u0dcf\u0dba\u0dda \u0dba\u0dc1 \u0d9a\u0dba \u0daf\u0db1\u0dca\u0dc0\u0dcf \u0dba\u0dc0\u0db8 \u0dba\u0dbd\u0dc3 \u0dbd\u0dbd\u0dca\u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db8\u0dc0\u0dcf.\n\n\u0dba\u0daf\u0dde\u0dda\u0dd0\u0dd2\u0d9a\u0dc0 \u0d9a\u0dae\u0dcf \u0db6 \u0d9a\u0dbb\u0db8\u0dba\u0d9a\u0dcf \u0dbd \u0dcf\u0db8 \u0db1\u0dd2\u0dc1\u0dbb\u0dc1\u0db6\u0dca\u0dbd\u0daf \u0daf\u0dba\u0db4 \u0dba\u0dca \u0dc0\u0dd4\u0dab\u0dcf \u0dba\u0db6\u0dcf\u0dba \u0dcf\u0db8 \u0dc3\u0dd4\u0db1\u0dca\u0daf\u0dbb \u0db8\u0db1\u0dd4\u0dc3\u0dbb\u0dc3\u0dba\u0dba\u0dca \u0db1\u0da7\u0dd2\u0dba \u0db8\u0dba\u0dd2 \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dc0 \u0d9f\u0dd2\u0db1\u0dca\u0db8 \u0d86\u200d\u0dbb\u0dba \u0d9a\u0dbb\u0db8 \u0d9a\u0dcf\u0dbd\u0dba\u0dda \u0d85\u0db4\u0dd2 \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0dd0\u0db1\u0db8 \u0daf\u0db1\u0db8\u0dba\u0dd0\u0db8 \u0dc3\u0dd2\u0da7\u0dd2\u0dba\u0dda. \u0dba\u0dca \u0d85\u0dc0\u0dc3\u0dbb\u0dae\u0dcf\u0dba\u0dda\u0daf\u0dd3 \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dba \u0daf\u0dc0\u0dd4\u0dba\u0dbd\u0dca \u0d8b\u0daf\u0dd2\u0db0\u0dba \u0dba\u0dc0 \u0db8\u0dba \u0dba\u0dc1 \u0d9a\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u0db8\u0dc0\u0dcf.\n\n\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db8\u0dcf \u0dbb\u0dd6\u0daa \u0dd0\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba\u0db1\u0dd2 \u0d85\u0db7\u0dcf\u0dc0\u0db4\u0dca\u200d\u0dbb\u0dcf\u0db4\u0dd9 \u0dd0\u0dbb\u0dd4 \u0d86\u0dca. \u0dc3\u0dca\u0daf\u0db1\u0dca\u0daf\u0db1\u0dca \u0db8\u0db1\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0dbd\u0dbd\u0dcf\u0dba\u0dd0\u0dba\u0dd2 \u0db8\u0dd2 \u0dbb \u0d85\u0dbb\u0dc3\u0dd4 \u0d9a\u0da0\u0dca\u0da0\u0dd4\u0da0\u0dd2 \u0daf\u0dca\u0dc2\u0dba\u0dba\u0db1\u0dca \u0dba\u0dda\u0dc1\u0daf\u0dcf\u0dbd\u0db8\u0dba \u0db4\u0dd2\u0dd2\u0db0\u0dc3 1977 \u0dc3\u0dd2 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4\u0dc0 31\u0d9a \u0dc0\u0db1\u0dd2 \u0d9a\u0dcf\u0dbd\u0dba\u0dca \u0dba\u0dca"
  },
