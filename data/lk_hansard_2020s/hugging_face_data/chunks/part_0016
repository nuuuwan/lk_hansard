 \u0dc3\u0dda\u0d9a\u0dd1\u0db1\u0dca\n\n\u0dd2\u0dbb\u0dd3\u0db8\u0dcf V. \u0d9a\u0dd2\u0dba\u0da7\u0dd41\u0da7 \u0d9a\u0db8\u0daf\u0dd4\u0d9a\u0db8 [\u0dd0\u0db1\u0dca \u0dd4\u0dd0 \u0dc1\u0d9f\u0db1 \u0dc11\u0db1\u0dad\u0dca \u0d9a\u0dc0 \u0dab\u0dd4\n\n\u0daf \u0dc3\u0da0\u0d9a\u0dcf \u0db6\u0dd0\u0dbd\u0dd3\u0dcf\n\n(v) \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0da0\u0d82\u0d9a\u0dcf \u0dc1\u0dbb\u0dca\u0dd4 1 \u0dc0\u0dd2\u0dc3\u0db1\u0dca \u0dc1\u0db7\u0dde\u0dad\u0dd2\u0d9a \u0db4\u0dd3\u0db8\u0d9a\u0dc2\u0dca\u0da8\u0dcf \u0dd2\u0dbb\u0dd3\u0db8\u0dcf\u0dd2\u0dbb\u0db1\u0dca \u0dc1\u0dad\u0dcf\u0dba1 \u0db6\u0dd4\u0daf\u0dd9\u0db8\u0dca \u0db1\u0dd2\u0daf\u0dd4\u0dc3\u0dda \u0dc1\u0db1\u0dcf\u0d9a\u0dba\u0db1 \u0d85\u0dad\u0dba, \u0db4\u0dd3\u0db8\u0d9a\u0dc2\u0dca\u0da8\u0dcf \u0dd2\u0dbb\u0dd3\u0db8\u0dcf \u0dc3\u0db3\u0dd4\u0dcf \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u200d\u0dbb\u0dcf\u0dc1\u0dda\u0daf \u0d85\u0db1\u0dd4\u0d9c\u0dcf\u0db1[ \u0d9a\u0dba\u0db1\u0dd4 \u0da0\u0db6\u0db11\u0dcf. \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0d851\u0daf\u0dcf\u0db1\u0dcf \u0dad\u0d9a\u0dc1\u0dc3\u0dda\u0dc0 \u0dd2\u0dbb\u0dd3\u0db8\u0dc1\u0dcf\u0db1\u0dca \u0d85\u0db1\u0dad\u0dd4\u0db8\u0dc0 1 \u0d91[ \u0d851\u0dcf 1\u0db1 \u0dad\u0d9a\u0dcf\u0dba[\u0da7 \u0d85\u0daf\u0dcf\u0db1 \u0db1\u0dd2\u0daf\u0dd4\u0dc3\u0dda \u0dd2\u0dbb\u0dd3\u0db8\u0db8\u0dca \u0dc3\u0daf\u0dd4 \u0d9a\u0dba\u0db1\u0dd4 \u0da0\u0db6\u0db11\u0dcf.\n\n(vi) \u0d85\u0daf\u0dcf\u0db1 \u0dc1\u0db1\u0dcf\u0dc1\u0dda.\n\n(\u0dad) \u0db4\u0db1\u0dc1\u0dad\u0dca \u0dad\u0dad\u0dd2 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0db1[\u0db1\u0dca\u0da7 \u0d85\u0dcf\u0dad\u0dba1, 2 2]. 5.5] \u0daf\u0dd2\u0db1\n\n\u0db1\u0dd2\u0daf\u0dd4\u0dc3\u0dda \u0d9a\u0dba\u0db1 \u0da0\u0daf \u0db6\u0dd4\u0daf\u0dd9\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1[\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0da0\u0d82\u0d9a\u0dcf \u0dc1\u0dbb\u0dca\u0dd4 1\n\n1477 1478\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0dca\u