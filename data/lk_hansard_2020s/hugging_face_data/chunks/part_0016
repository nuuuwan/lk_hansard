    "chunk_text": "\u0dd2\u0db1\u0dca\u0db4\u0dc3\u0dd4\u0dc0 \u0dc3\u0dd2\u0dd3\u0dcf \u0d9c\u0dc0\u0db1 \u0d9c\u0dd3 \u0dad\u0db8\u0dba\u0dd2 \u0db8\u0d9a\u0dbb\u0d9a\u0dbb\u0dab \u0db1\u0dd2\u0d9c \u0ddd\u0d9c \u0d9a\u0dca \u0dc4\u0dbb\u0dc4\u0dc1 \u0d9c\u0dd3\u0db1\u0db6\u0db1\u0dca\u0daf\u0dd4 \u0d9c\u0dad\u0db1\u0dca\u0db1\u0d9c\u0d9a\u0ddd\u0db1\u0dca\u0d9c\u0dda \u0dc0\u0dd0\u0da9 \u0dad\u0dc1\u0dc0\u0d9a\u0dc1\u0dd2\u0db1\u0d9a\u0dc0 \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd3\u0db8 \u0dad\u0dc4\u0dd4\u0d9c\u0dda \u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db8\u0db4 \u0d91\u0d9c\u0dbb\u0dc4\u0dd2\u0dc0 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 FR \u0d91\u0d9a \u0db1\u0dd2\u0dc3\u0dc10 \u0db8\u0db4\u0dd2 \u0d9c\u0db8\u0dad\u0dd0\u0db1\u0daf\u0dd3 \u0d92 \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0d9c \u0ddd\u0daf\u0db1\u0dc1 \u0d91\u0d9a\u0d9a\u0dca\u0dc0\u0dad\u0dca \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dc1 \u0d9a\u0d9c\u0dd9\u0dda \u0db1\u0dd0\u0dc4\u0dd0 \u0db8\u0dc0\u0db1\u0dba \u0d9c\u0dd3\u0dc0\u0dbd\u0dca \u0dd2\u0dbb\u0dda\u0d9c\u0dda \u0db1\u0dd0\u0dc4\u0dd0 \u0db1\u0dc1\u0daf\u0dd3 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0d9c \u0db1\u0dca \u0dd2\u0dbb\u0dda\u0dc0\u0dc10 \u0d91\u0db8 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0d9c\u0dda \u0dc0\u0dc1\u0dda\u0dad\u0dc1\u0dc0 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dc10 \u0d91\u0db8 \u0dc0\u0dc1\u0dda\u0dad\u0dc1\u0dc0 \u0dc3 \u0dc1\u0d9c\u0dad \u0d9c\u0dc0\u0dbd\u0dc1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0d9c\u0db1\u0dca \u0dc4\u0dd0\u0db8 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb \u0dc1\u0db4\u0db8 \u0db6\u0dbd\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dd2\u0d9a\u0dbb \u0db40 \u0d92\u0d9c\u0d9a\u0dca \u0db4\u0dd2\u0da7\u0dd4 \u0dc4\u0dad\u0dca-\u0db8\u0db4\u0dc3\u0dd2 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dc10\n\n1339 1340\n\n[\u0d9c\u0dbb\u0dd4 \u0db1\u0dd3\u0dad\u0dd2\u0da5 \u0dc4\u0dda\u0dc2\u0dab \u0db1\u0