    "chunk_text": "\u0baa\u0bbe\u0bb0\u0bbe\u0bb3\u0bc1\u0bae\u0ba9\u0bcd\u0bb1 \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bae \u0b89\u0b95\u0bb0\u0ba4\u0baa\u0baf\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bcd - \u0b9c\u0ba9\u0bbe\u0baa\u0bcd \u0b8f.\u0b9c\u0bbf. \u0ba4\u0bae\u0bbe\u0bb9\u0bae\u0b9f\u0bcd \u0baa\u0bbf\u0b95\u0bcd\u0bbe\u0bbf, \u0ba4\u0bbf\u0bb0\u0bc1. \u0bb2\u0b95.\u0b9f\u0bbf.\u0b86\u0bb0\u0bcd. \u0baa\u0ba4\u0bcd\u0bae\u0b9a\u0bbf\u0bb1\u0bbf, \u0ba4\u0bbf\u0bb0\u0bc1. \u0b8f. \u0b9a\u0bb0\u0bb5\u0ba3\u0baa\u0bb5\u0bbe\u0ba9\u0ba8\u0bcd\u0ba4\u0ba9\u0bcd\n\n\u0b9a\u0bbf\u0bb2\u0bb0\u0bb7\u0bcd\u0b9f \u0baa\u0bbe\u0bb0\u0bbe\u0bb3\u0bc1\u0bae\u0ba9\u0bcd\u0bb1 \u0b89\u0b95\u0bb0\u0ba4\u0baa\u0baf\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bcd - \u0ba4\u0bbf\u0bb0\u0bc1. \u0b9c\u0bbf.\u0b8e\u0baa\u0bcd.\u0baa\u0bbf. \u0b9a\u0bc1\u0bb2\u0bb0\u0bb7\u0bcd\u0bb5\u0bb0\u0ba9\u0bcd, \u0ba4\u0bbf\u0bb0\u0bc1\u0bae\u0ba4\u0bbf \u0b8e\u0ba9\u0bcd.\u0baa\u0bbf.\u0b9a\u0bbf.\u0bb2\u0b9c. \u0ba8\u0bbf\u0b9a\u0b99\u0bcd\u0b95\u0bbe, \u0ba4\u0bbf\u0bb0\u0bc1. \u0baa\u0bc0.\u0b8e\u0bb2\u0bcd.\u0baa\u0bc0.\u0b8e\u0bb2\u0bcd.\n\n\u0baa\u0bbe\u0bb0\u0bbe\u0bb3\u0bc1\u0bae\u0ba9\u0bcd\u0bb1 \u0b89\u0b95\u0bb0\u0ba4\u0baa\u0baf\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bcd - \u0b9c\u0ba9\u0bbe\u0baa\u0bcd \u0b8e\u0bae\u0bcd.\u0b90.\u0b8e\u0bae\u0bcd. \u0baa\u0bbe\u0bb8\u0bbf, \u0ba4\u0bbf\u0bb0\u0bc1. \u0b9a\u0bbf. \u0bae\u0ba3\u0bbf\u0bae\u0bbe\u0bb1\u0ba9\u0bcd, \u0b9c\u0ba9\u0bbe\u0baa\u0bcd \u0baa\u0bbf.\u0b8e\u0bae\u0bcd.\u0b8f. \u0bb9\u0bc1\u0b95\u0bb8\u0ba9\u0bcd,\n\n\u0b9c\u0ba9\u0bbe\u0baa\u0bcd \u0baa\u0bbf.\u0b8e\u0bae\u0bcd. \u0bb0\u0bb8\u0bc0\u0bb2\u0bcd, \u0ba4\u0bbf\u0bb0\u0bc1. \u0b8e\u0bb8\u0bcd. \u0baa\u0bbf\u0bb0\u0ba4\u0bc0\u0baa\u0bcd, \u0b9c\u0ba9\u0bbe\u0baa\u0bcd \u0b8e\u0bae\u0bcd. \u0b8e\u0bae\u0bcd. \u0ba8\u0b9c\u0bbf\u0bae\u0bc1\u0b9f\u0bc0\u0ba9\u0bcd, \u0ba4\u0bbf\u0bb0\u0bc1\u0bae\u0ba4\u0bbf \u0bb2\u0b95.\u0b9f\u0bbf.\u0b8e\u0bae\u0bcd. \u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0bb2\u0b95\n\n\u0b9a\u0bbf\u0bb2\u0bb0\u0bb7\u0bcd\u0b9f \u0ba4\u0bae\u0bbe\u0bb4\u0bbf\u0ba4\u0baa\u0baf\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bcd - \u0ba4\u0bbf\u0bb0\u0bc1\u0bae\u0ba4\u0bbf \u0b8f. \u0bb0\u0bc1\u0b95\u0bcd\u0bae\u0ba3\u0bbf\u0bb2\u0ba4\u0bb5\u0bbf, \u0b9c\u0ba9\u0bbe\u0baa\u0bcd \u0b8e\u0bb8\u0bcd.\u0b8e\u0bae\u0bcd. \u0ba8\u0bb8\u0bc0\u0bb0\u0bcd, \u0b9c\u0ba9\u0bbe\u0baa\u0bcd \u0b8e\u0bae\u0bcd.\u0b8e\u0bae\u0bcd. \u0bb9\u0bb2\u0bc0\u0bae\u0bcd\u0b9f\u0bc0\u0ba9\u0bcd\n\n\u0ba4\u0b95\u0bb5\u0bb2\u0bcd \u0bae\u0bc1\u0b95\u0bb1\u0b95\u0bae \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0b95\u0bbe\u0b95\u0bae\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bcd \u0ba4\u0bbf\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd\n\n\u0baa\u0ba3\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0bb3\u0bb0\u0bcd (\u0ba4\u0b95\u0bb5\u0bb2\u0bcd \u0bae\u0bc1\u0b95\u0bb1\u0b95\u0bae \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0b95\u0bbe\u0b95\u0bae\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bcd) - \u0ba4\u0bbf\u0bb0\u0bc1. \u0b8e\u0ba9\u0bcd.\u0baa\u0bbf.\u0baf\u0bc1. \u0ba8\u0bb5\u0b95\u0bae\u0bc1\u0bb5\n\n\u0bae\u0bc1\u0b95\u0bb1\u0b95\u0bae\u0baa\u0bcd \u0ba4\u0baa\u0bbe\u0bb1\u0bbf\u0baf\u0bbf\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd - \u0ba4\u0bbf\u0bb0\u0bc1. \u0b9a\u0bbf.\u0bb2\u0b9c. \u0bb5\u0bbf\u0bb2\u0bcd\u0bb2\u0bb2\u0bbe\u0bb0\u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\n\n\u0bae\u0bc1\u0b95\u0bb1\u0b95\u0bae\u0baa\u0bcd \u0baa\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0baf\u0bcd\u0bb5\u0bbe\u0bb3\u0bb0\u0bcd - \u0ba4\u0bbf\u0bb0\u0bc1. \u0b8e\u0bae\u0bcd.\u0b8e\u0ba9\u0bcd.\u0b9a\u0bc0. \u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bb0\u0bae\u0b9a\u0bbf\u0b99\u0bcd\u0b95\n\n\u0ba4\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0b9f\u0bb2\u0bcd / \u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bc1 \u0ba4\u0baa\u0bb