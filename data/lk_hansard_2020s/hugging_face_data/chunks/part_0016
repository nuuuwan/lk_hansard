    "chunk_text": "\u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc2\u0dba\u0dba\u0db1\u0dca \u0dba\u0db8\u0dca \u0d85\u0dc0\u0dc3\u0dc0\u0dae\u0dcf\u0dc0 \u0dc3\u0db4\u0dba\u0dba\u0ddd\u0dd3 \u0d9a\u0dbb\u0dba\u0d9c\u0db1 \u0d85\u0dba\u0db4\u0dca \u0dbb\u0da7 \u0db8\u0dd4\u0dd4 \u0dab \u0dba\u0daf\u0dca\u200d\u0dba\u0db1 \u0db6\u0dbb\u0db4 \u0dc5 \u0d85\u0db7\u0dd2\u0dba\u0dba\u0ddd\u0d9c \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db8\u0db8 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dd28 \u0d85\u0dba\u0db4\u0dca \u0dbb\u0da7\u0da7 \u0d85\u0db7\u0dd2\u0dba\u0dba\u0ddd\u0d9c \u0dbb\u0dd0\u0dc3\u0d9a\u0dca \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0d85\u0dba\u0db4\u0dca \u0dbb\u0da7\u0da7 \u0dba\u0dda\u0d9c\u0dc0\u0dad\u0dca \u0dc0 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc0\u0dbb\u0dca\u0dae\u0dca\u200d\u0db1\u0dba\u0d9a\u0dca \u0d95\u0db1\u0dd18 \u0d85\u0dba\u0db4\u0dca \u0dbb\u0da7\u0da7 \u0dba\u0dda\u0d9c\u0dc0\u0dad\u0dca \u0dc0 \u0d85\u0db4\u0db1\u0dba\u0db1 \u0dc0\u0dbb\u0dca\u0dae\u0dca\u200d\u0db1\u0dba\u0d9a\u0dca \u0d95\u0db1\u0dd18 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0d85\u0dba\u0db4\u0dcf\u0dba\u0dc4\u0dcf\u0dc3\u0dad\u0dca \u0dc0 \u0dc0\u0dd4\u0dab\u0dcf\u0d8b \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc0\u0dbb\u0dca\u0dae\u0dca\u200d\u0db1 \u0dba\u0dda\u0d9c\u0dba \u0dca\u0dc4\u0dc5 \u0db1\u0d82\u0dc0\u0db1\u0dca\u0dba\u0db1\u0dca \u0dba\u0d9a\u0dba\u0dc3\u0dc0\u0daf\u0dca\u200d\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0d9c\u0dd0\u0db1 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dca\u0db1 \u0daf\u0dd2\u0db4\u0dad\u0dca \u0dc0 \u0d9a\u0dbb\u0db1\u0dca\u0db1; \u0d85\u0db4\u0db1\u0dba\u0db1\u0dba \u0dc0\u0dbb\u0dca\u0dae\u0dca\u200d\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dba\u0dda\u0d9c\u0dba \u0d9c\u0dd0\u0db1 \u0d92 \u0d9a\u0dca\u200d\u0dbb\u0dba\u0db8\u0ddd\u0db4\u0dcf\u0dba\u0dd2\u0d9a \u0dc3\u0dd0\u0dbd\u0dba\u0dda\u0dd0\u0dc3\u0dc0\u0db8 \u0dba\u0db8\u0dca \u0dc3\u0db7\u0dcf\u0d