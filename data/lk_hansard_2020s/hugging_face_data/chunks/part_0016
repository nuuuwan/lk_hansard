[\u0d9a \u0dc1\u0dc3\u0dda1[ \u0d9a\u0dba\u0db11\u0dcf. \u0dc1\u0dcf\u0dcf \u0dc1\u0dc3\u0dda1\u0d9a[\u0db1\u0dca\u0dc1\u0d9c\u0db1\u0dca \u0d89\u0d82\u0da2\u0dd2\u0dc1\u0db1\u0dca\u0dc0 1\u0db1\u0dca \u0dca\u200d\u0dbb\u0db8\u0dd4\u0d9b \u0dad\u0dcf\u0d9a\u0dc2\u0dca\u0da8\u0dab\u0dd2\u0d9a \u0db1\u0dd2\u0da0\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca \u0d9c\u0dd0\u0db1 \u0dcf\u0dcf \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1[\u0db1\u0dca \u0dc3\u0db3\u0dd4\u0db1\u0dca \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dc1\u0db8\u0dca \u0db1\u0dd2\u0da0\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca \u0d85\u0dad\u0dd2\u0daf\u0d9a\u0dc2\u0dca\u0da8 1\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0d9a[\u0db1\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a. \u0dc1\u0da0\u0ddd\u0d9a\u0dc1\u0dad \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 [\u0dd0\u0db1\u0dca \u0dc3\u0db8\u0dca\u0dcf\u0dad \u0d95\u0db1\u0dd1\u0dcf \u0dba\u0da7\u0d9a \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db6\u0da0 \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2[ \u0db41\u0dad\u0dca1\u0dcf\u0dc1\u0d9c\u0db1 [\u0dd2\u0dba\u0db1\u0dca \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0dd2\u0dbb\u0dd3\u0db8\u0dcf\u0da7 \u0dc1\u0db8\u0dca 1\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0d9a[\u0db1\u0dca\u0da7 \u0dd4\u0dd0\u0dd2\u0dbb[\u0dcf1 \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dcf. \u0db4\u0d9a\u0db8\u0d9c\u0dd2[ 1\u0dc3\u0dba \u0dd2\u0dbb\u0dc4\u0dd2\u0db4\u0dc1\u0dad\u0daf\u0dd3 \u0d85\u0dc1\u0db4\u0dca \u0d89\u0d82\u0da2\u0dd2\u0dc1\u0db1\u0dca\u0dc0 1\u0db1\u0dca \u0dc3[ \u0d9c\u0dab\u0db1\u0d9a \u0da0\u0d82\u0d9a\u0dcf1\u0da7 \u0dc3\u0dcf\u0dc1\u0db4\u0dca\u0d9a\u0dc2\u0dca\u0da81 \u0d89\u0dad\u0dcf \u0d89\u0dd4\u0db1 1\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0d89\u0dd4\u0db1\u0dcf \u0dad\u0dcf\u0d9a\u0dc2\u0dca\u0da8\u0dab\u0dd2\u0d9a \u0dbb\u0dd0\u0dd2\u0dbb[\u0dcf1\u0da0\u0da7 \u0db4\u0dd2\u0da7\u0dad\u0dca1 \u0d9c\u0dd2[\u0dcf. \u0dc1\u0db8\u0dca \u0dad\u0dcf\u0d9a\u0dc2\u0dca\u0da8\u0dab\u0dd2\u0d9a 1\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0d9a[\u0db1\u0dca \u0dad\u0dad