    "chunk_text": "\u0dca\u0dda \u0dca\u0dc4\u0db8\u0dd6\u0dbd\u0dba\u0dca\u0dad\u0db8\u0dc3\u0dc0\u0dbd\u0dc4\u0dad \u0db8\u0dd4\u0dc0\u0dd0\u0dd2\u0dbd\u0dc4\u0d91\u0dda \u0dc4\u0dd2\u0dbd: \u0dc3\u0dcf\u0dca\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf \u0dc4\u0dc3\u0dcf \u0dc4\u0dc3\u0dcf\u0db8\u0dc3\u0db4\u0dca\u200d\u0dbb\u0dda \u0dda\u0dba .\u0dc4\u0dda :\u0dc0\u0dd0\u0dd2\u0dbd\u0dc4\u0d91\u0dda \u0dc4\u0db8\u0dc3\u0daf\u0dcf\u0dc0\u0dc4\u0dc3\u0dcf\u0dc4\u0dc0\u0dca\u0dad\u0dba\u0dcf \u0db4\u0dc4\u0dc3\u0dcf \u0dc4\u0dda \u0dc3\u0dcf\u0dbb\u0dc0\u0daf\u0dc4\u0dd2\u0dbd\u0dba\u0dd4\u0d9a\u0dca\u0d9a\u0dba\u0dd2 \u0db4\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf \u0dc4\u0dca:\u0daf \u0dc4\u0dc0\u0dd3\u0db8\u0dc3.\u0dc4\u0dad\u0dd4\u0dca\u0db0\u0dc0\u0dd0\u0dd2\u0dbd\u0dc4\u0d91\u0dda \u0dc4\u0dd2\u0d82 \u0dca \u0dbd\u0dca\u0db0\u0db4\u0db8\u0dc3\u0dc4\u0db4\u0dd2\u0dd2\u0db6\u0dca\u0dcf\u0dc4 \u0dd0\u0d9a\u0dd2\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf\u0dc4\u0dca\u200d\u0dbb\u0db8\u0dc3 .\u0dc4 \u0dcf\u0dbb\u0dc0\u0dd0\u0dd2\u0dbd\u0dc4\u0d91\u0dda \u0dc4\u0dc3\u0dcf\u0db8\u0dc3\u0daf\u0db1 \u0db4\u0dc4\u0dc0\u0dca\u0dc4\u0dc0\u0dcf\u0dc4\u0dd4 \u0dbb\u0dc0\u0dd0\u0dd2\u0d82 \u0dca\u0db0\u0dc4\u0db6\u0dd2\u0dd2\u0da7\u0dc4\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dc3.\u0dc4\u0dad\u0dc3\u0dcf\u0dca\u0dc0\u0dd0\u0dd2\u0dbd\u0dc4\u0d91\u0dda \u0dc4\u0dd2 \u0dbb\u0dc3\u0dcf\u0daf\u0dbb\u0db7\u0daf\u0dc0 \u0dc4\u0dc3\u0dcf \u0dc4\u0dd2\u0dbd\u0dda \u0dc0\u0ddd\u0dca\u0dad\u0dad\u0daf:\u0dcf .\u0dc4 \u0dc0\u0dd0\u0dd2\u0dbd\u0dc4\u0d91\u0dda \u0dc4 \u0daf\u0dc0\u0da2\u0dd3\u0dc0\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf .\u0dc4\n\n\u0dda :\u0dc0\u0dd0\u0dd2\u0dbd\u0dc4\u0dda\u0daf\u0dbb\u0dab \u0dc4\u0dc0\u0dcf\u0dc4\u0dc3\u0dcf\u0db8\u0dc3\u0dda\u0daf\u0dbd\u0dd3\u0dcf\u0dc4\u0dda \u0dbd\u0ddd\u0dda\u0dda \u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf\u0dc4\u0db4\u0dca\u200d\u0dbb\u0dc0\u0dab\u0dcf\u0daf\u0dc4\u0dc3\u0dcf \u0dc4\u0dda \u0dc0\u0dcf\u0dc3\u0dcf\u0dca\u0dc0\u0dd3\u0dca\u0db6\u0dc4\u0dda \u0db8\u0dc3\u0ddc\u0dcf\u0dc0\u0daf:\u0dc4\u0d9a\u0dd2 \u0dcf\u0dc4\u0d91\u0dda\u0dc4\u0dca\u0db4\u0dd2\u0dc4\u0dda \u0db8\u0dc3\u0dcf\u0dd0\u0dcf\u0daf\u0dd3\u0dc4\u0dc3\u0dcf\u0dbd\u0dda\u0daf\u0dc4\u0db1\u0dbd\u0dca\u0db0\u0dcf\u0dc4\u0d95\u0dcf\u0dd1.\u0dc4\u0dca\u0db4\u0dd2\u0dc4\u0dcf\u0dc0\u0db8\u0dc3\u0dc4\u0d89\u0dca\u0db0\u0dda \u0dca\u0db0\u0dc4 \u0db4\u0dca\u0dad\u0dd2\u0d9a\u0da2\u0dd2\u0dcf\u0dc4\u0dca\u200d\u0dbb\u0db8\u0dc3 \u0db4\u0dc4\u0dd4 \u0dd4\u0dc0\u0dd4 \u0dc4\u0dda \u0dc0\u0da0\u0dca\u0da0\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf\u0dc4\u0dca\u200d\u0dbb\u0db8\u0dc3 \u0dda.\u0dc4\u0dd2\u0d9a\u0dc2 \u0dc4\u0dda\u0dd4\u0dc0\u0dab\u0dd4\u0dc4\u0da7\u0dd2\u0dda\u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dda\u0db4\u0dad\u0daf\u0da9\u0dca\u0db6\u0dc4\u0dda\u0dbb\u0dbd\u0daf\u0dc4\u0dad\u0dd0 \u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dda \u0ddd\u0dc4\u0dda :\u0dda\u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0d87\u0dad\u0dd4 \u0dcf\u0dc4\u0dd2\u0d9a\u0db7\u0daf\u0dca\u0dc4\u0dbd\u0dd2 \u0dcf\u0dc4\u0dca\u200d\u0dbb\u0db8\u0dc3 \u0dda\u0dc4\u0dcf\u0db8\u0dc3\u0dba\u0dd2\u0dc4\u0dca\u0db4\u0dd2\u0dc4\u0dcf\u0dc0\u0db8\u0dc3\u0dc4\u0d89\u0dca\u0db0\u0dda \u0dca\u0db0.\u0dc4 \u0dd0\u0db1\u0dd0\u0dba\u0dd2 \u0dc4\u0dda \u0dbd\u0ddd\u0dda\u0dda \u0dc4\u0dda \u0ddc \u0dc4\u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf\u0dc4\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dc4\u0dad\u0dc0\u0dd2 \u0dcf\u0dc4\u0dbb\u0db4\u0dc0\u0dbd\u0dc4\u0d91\u0dda \u0db8\u0dc3\u0dc4\u0dda \u0dda\u0dda \u0dbb\u0dca\u0db0\u0dda \u0dca\u0db0\u0dc4\u0dcf\u0dd0 \u0dd0.\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf \u0dc4\u0dca\u0dd0\u0dcf\u0dc4\u0dda \u0dbd\u0ddd\u0dda\u0dda \u0dc4:\u0dd0\u0dca\u0db0\u0dc4\u0dda\u0dae\u0daf\u0dc4\u0dda\u0dbb\u0dca\u0db0\u0dda \u0dca\u0db0 \u0dc4\u0dd2\u0dbd\u0dca\u0dad \u0db4\u0dca\u0dad\u0dd2\u0d9a\u0da2\u0dd2\u0dcf\u0dda\u0dbb\u0dab \u0dc4\u0dca\u0dd0\u0dcf \u0dc4\u0d92\u0dc4\u0dc0\u0daf\u0dda \u0db8\u0dc3\u0dc4\u0d86 \u0dcf\u0dcf\u0dc4\u0dc3\u0dcf \u0dc4\u0db0\u0dd6\u0dbb\u0daf\u0dc0\u0dbd\u0dd2\u0dc4\u0d89\u0dca\u0dd0\u0dca\u0db0\u0dc0\u0dd3\u0dca\u0db6\u0dc4\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dda \u0dda:\u0dc0\u0dbd\u0dc4\u0dda \u0dc0\u0dcf\u0dc3\u0dcf\u0dca\u0dda\u0dca\u0db6\u0dc4\u0db4\u0dd2\u0dd2\u0db6\u0db1 \u0dc0.\u0dc4\u0dad\u0dca\u0db0\u0dd2 \u0dc4\u0dad\u0dd4 \u0dc4 \u0db8\u0dc3\u0dba\u0dd2\u0dc4\u0dc0\u0daf\u0da9\u0dd2\u0dda \u0dc0\u0dcf\u0dc4\u0dd2\u0d9a\u0dd2\u0db4\u0dda \u0dc4\u0dad\u0dc0\u0daf\u0dc4\u0dda \u0dc0\u0dcf\u0dc3\u0dcf\u0dca\u0dda\u0dca\u0db6\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc0\u0daf.\u0dc4\u0dca\u0dca\u0db0\u0dcf\u0dc4\u0d91\u0dcf\u0dd0\u0dcf\u0db4\u0dba\u0dd2\u0dc4\u0dca\u0db4\u0dd2\u0dc4\u0dda \u0dca\u0db6\u0dc4\u0dc3\u0dcf\u0dc4\u0dc0\u0daf: \u0dc4\u0dda \u0dca\u0dcf\u0dc4 \u0daf\u0dc4\u0dba\u0dd4\u0dca\u0dad\u0dda \u0dca\u0dad.\u0dc4\n\n\u0dad\u0dd4\u0dca\u0db0\u0dc0\u0dd0\u0dd2\u0dbd\u0dc4\u0dda\u0daf\u0dbb\u0dab \u0dc4\u0dcf\u0db8\u0dc3\u0dba\u0dd2 \u0dc4\u0dbb\u0dda \u0da7\u0dca\u0dc4\u0dc3\u0dcf\u0dc4\u0dc0\u0dca\u0dad\u0dba\u0dcf\u0dc4\u0dca\u0dc0\u0dba\u0dba\u0dcf\u0daf\u0dc4\u0dc3\u0dcf \u0dc4\u0db1\u0daf\u0dd2 \u0dda\u0dc4\u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dad\u0dca\u0dad\u0dd2 .\u0dc4\u0dda \u0dca\u0db6\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf\u0dc4\u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dc3\u0dcf\u0dc4\u0dc3\u0dcf\u0dca\u0dda\u0dbb\u0dab \u0dc4\u0dda \u0dca\u0db0\u0dda \u0dca\u0db0\u0dc4\u0dc3\u0dcf\u0dca\u0db0:\u0dca\u0dad\u0db7 \u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dcf\u0dd0\u0dad\u0dd4\u0dc0\u0dc4\u0dda \u0dcf\u0ddc\u0dda \u0dc0\u0dba\u0dd2.\u0dc4\u0db4\u0dca\u200d\u0dbb\u0daf \u0dba\u0dcf\u0dc4\u0dd2\u0d9a :\u0dca\u0db6:\u0dc4\u0d87\u0dad\u0dd4\u0dc5\u0dd4\u0dc0\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf \u0db4\u0dc4\u0dca\u0db4\u0dd2\u0dc4\u0dd4\u0dc0\u0db4\u0dd2 \u0dca \u0dc4\u0db6\u0dd2\u0dbd\u0dd2 \u0dcf\u0dc46]0\u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dda \u0dc0\u0dca\u0db0\u0dc4\u0dda\u0dbb\u0dbd\u0daf\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc0\u0daf.\u0dc4\u0dca\u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dcf\u0dcf\u0dc0\u0daf \u0dc4\u0dda \u0dca\u0db6\u0dc4\u0db4\u0dca\u200d\u0dbb\u0db8\u0dc3\u0daf\u0dab \u0dca\u0dad\u0dc4\u0db8\u0dc3\u0daf\u0dd2\u0dc4\u0d9a\u0dd2 \u0daf.\u0dc4\u0dca\u0dda \u0dca\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf\u0dc4\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0dc2\u0dbb\u0dad\u0dca\u200d\u0dbb \u0dc4\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dda \u0dca\u0db0\u0dc4\u0d89 \u0dc4\u0dcf\u0dc4\u0dc0\u0dca\u0db0\u0dcf\u0dc4\u0d95\u0dcf\u0dd1 \u0dc4\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dda \u0dca\u0db0\u0dc4\u0db1\u0daf\u0dcf\u0dba\u0dca\u0db0\u0dcf\u0dbb\u0dc4\u0db8\u0dc3\u0da7\u0dca\u0db4\u0db8\u0dc3\u0db4\u0db8\u0dc3\u0dc4\u0dda \u0dca\u0dcf \u0dca\u0db0\u0dcf\u0dc4\u0d95\u0dcf\u0dd1 \u0dc4\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dda \u0dca\u0db0\u0dc4\u0dda \u0dca\u0db6\u0dc4\u0dc3\u0dcf \u0daf\u0dc4\u0dc0\u0dd6\u0dc4Budget allocations \u0dc0\u0dd0\u0da9\u0dd2\u0dc4\u0dda\u0dbb\u0dca\u0db0\u0dcf\u0dc4\u0d95\u0dcf\u0dd1.\u0dc4\u0dda \u0dca\u0db6\u0dc4\u0dda \u0dc0\u0dca\u0db0\u0dc4\u0d9a\u0dd2\u0dbb\u0dd3\u0dca\u0db6\u0dc4\u0d91\u0d9a\u0dca\u0d9a\u0dba\u0dda\u0dc4\u0dcf\u0db8\u0dc3\u0dba\u0dd2\u0dc4\u0dda \u0dca\u0db6\u0dc4\u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dc3\u0dcf\u0dc4\u0dc3\u0dcf\u0dca\u0dda\u0dbb\u0dab\u0dc4\u0dca\u0db4\u0dd2\u0dc4\u0dda\u0dbb\u0dca\u0db0\u0dcf\u0dc4\u0d95\u0dcf\u0dd1.\u0dc4\u0dda \u0dca\u0db6\u0dda\u0dc4\u0d91\u0dda\u0dc4\u0dbb\u0dd0 \u0d9a\u0dd2\u0dca\u0db0\u0dc4\u0dda\u0dbb\u0dca\u0db0\u0dcf\u0dc4\u0dd4 \u0dc5\u0dd4\u0dc0\u0dca\u0db0\u0dc4\u0dda : \u0d9a\u0dd4\u0dca\u0dad\u0dc4\u0dda \u0dcf\u0ddc\u0dda \u0dc0\u0dba\u0dd2.\n\n977 978\n\n\u0dad\u0daf\u0dca\u0dad\u0dbd\u0dd2\u0dda \u0dca\u0db6\u0dca\u0db0\u0dad\u0dd4\u0dc0"
  },
