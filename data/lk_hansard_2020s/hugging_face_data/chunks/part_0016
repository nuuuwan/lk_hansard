    "chunk_text": "\u0d92\u0daf\u0dc0\u0dcf\u0d9a\u0d9a\u0db8\u0daf\u0d9a\u0dad\u0dca\u0daf\u0d9a\u0dc1\u0dca\u0d9a\u0dc4\u0dca\u0dc3\u0daf:\u0dc4 \u0dcf\u0db0\u0dcf\u0dc3\u0db4\u0dad\u0dca\u0daf\u0d85\u0db4\u0dd2\u0daf\u0dbd\u0db6\u0dcf\u0daf\u0d9a\u0daf \u0dc0\u0dcf\u0dc3\u0daf\u0d9a\u0dc0\u0d9a\u0dc5\u0db3\u0daf\u0d9a\u0dc1\u0dca\u0d9a\u0dc5\u0dda\u0daf\u0d9a\u0dad\u0dca\u0daf\u0d9a\u0dc1\u0dca\u0d9a\u0dc4\u0dca\u0dc3\u0daf\u0d9a\u0dd2\u0d9a\u0dbd\u0ddd\u0d9c\u0dca\u200d\u0dbb\u0dd1 \u0daf50\u0dcf\u0daf\u0db8\u0dd2\u0da7\u0dd2\u0db4\u0d9a\u0dca\u0daf\u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca\u0daf9 000\u0d9a\u0dca\u0daf\u0dc0\u0dcf\u0d9a\u0d9a\u0daf\u0d9a\u0dc0 \u0dc0\u0dcf\u0dc3\u0daf\u0d85\u0db4\u0dd2\u0daf\u0d92\u0daf\u0d9a\u0dc0\u0db1\u0dd4\u0d9a\u0dc0\u0db1\u0dca\u0daf\u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca\u0daf4 000\u0dcf\u0daf:\u0dc4 \u0dcf\u0db0\u0dcf\u0dc3\u0db4\u0d9a\u0dca\u0daf\u0dbd\u0db6\u0dcf\u0daf\u0d9a\u0daf \u0dc0\u0dcf\u0dc3\u0daf2025\u0daf\u0d85\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a \u0daf\u0d85\u0db4\u0dd2\u0daf\u0d92\u0daf:\u0db3\u0dc4\u0dcf\u0daf\u0d9a\u0dc0\u0db1\u0dca\u0daf\u0dcf\u0dc5\u0daf\u0db8\u0dd4\u0daf\u0dbd\u0daf\u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca\u0daf\u0db8\u0dd2\u0dbd\u0dd2\u0db4 \u0daf2 800\u0dba\u0dd2\u0dc3\n\n\u0d92\u0daf\u0dc0\u0dcf\u0d9a\u0d9a\u0db8\u0daf\u0d85\u0db4\u0dd2\u0daf\u0d86\u0db4\u0dad\u0dca \u0d9a\u0d85\u0daf\u0d9a\u0dc1\u0dde \u0dbd\u0dd2\u0dcf\u0daf\u0dc0\u0dcf\u0dab\u0dd2\u0da2\u0daf\u0dc1\u0dd0\u0dc5\u0daf\u0dad\u0dca\u0dc0\u0dcf\u0db1\u0dca\u0daf\u0dc1\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0d9a \u0daf\u0db4 \u0dc0\u0dcf\u0dc3\u0daf\u0d92\u0dc0\u0dcf\u0daf\u0db1\u0dd2\u0db4\u0dcf\u0db8 \u0db4\u0daf\u0dcf\u0dc3 \u0dc0\u0dcf\u0dc3\u0daf\u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd2\u0d9a\u0db4\u0db1\u0dca\u0daf\u0dad\u0dd4\u0d9a\u0dca\u0dad\u0dca\u0daf\u0dc1\u0dd0\u0dc5\u0daf\u0dbd\u0db6\u0dcf\u0daf\u0daf\u0dd3 \u0daf\u0d86\u0daf\u0db4\u0daf\u0dcf\u0dc3 \u0dc0\u0dcf\u0dc3\u0daf\n\n* \u0dc3\u0db7\u0dcf\u0dc0\u0d