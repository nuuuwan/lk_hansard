    "chunk_text": "\u0dc3\u0dd6\u0daf\u0dd2\u0dba\u0dc0\u0dd0\u0dba \u0d9a\u0dbb\u0dca\u0dae\u0db8\u0dcf\u0db1\u0dca \u0db4\u0dd4\u0dbb\u0dba \u0d85\u0d9a\u0dca\u0d9a\u0dbb 20\u0dba\u0dd28 \u0d92\u0d9a \u0dd2\u0dba\u0dc1\u0dca\u200d\u0dbb \u0d86\u0dba\u0dba\u0ddd\u0da2\u0db1\u0dba\u0d9a\u0dca8 \u0dd2\u0dba\u0dd2\u0dba\u0db1 340\u0dba\u0dd2\u0d8b \u0d86\u0dba\u0dba\u0ddd\u0da2\u0db1 \u0db6\u0dbd\u0dba\u0dda\u0dcf\u0dba\u0db4\u0dcf\u0dba\u0dbb\u0dcf\u0dad\u0dca \u0dc0\u0dc0\u0dc08 \u0dca\u200d\u0dbb\u0dba\u0dda\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0dae\u0d9c \u0dca\u0db1 \u0d9a\u0dbb \u0d85\u0dc0\u0dc3\u0db1\u0dca8 \u0da2\u0dbd\u0dba\u0dda\u0dba\u0d8b \u0dc0\u0dd2 \u0dd2\u0dba \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0daf\u0dd3\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0d85\u0db7\u0dba\u0db1\u0dca \u0dbb \u0db8\u0dcf\u0dbb\u0dca\u0dae\u0d9c \u0db4\u0dc1\u0dca\u200d\u0dad\u0dd2\u0dba\u0dda \u0dc0\u0dd0\u0da9 \u0d85\u0dc0\u0dc3\u0db1\u0dca8 \u0dca\u0db1 \u0daf\u0dd2 \u0db8\u0dcf\u0dc3 \u0dba\u0daf\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0daf\u0dd3 \u0d91\u0dba \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf8\n\n\u0dc3\u0daf\u0dca\u200d\u0dba\u0dcf\u0d9a\u0dcf\u0dd2\u0d9a \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2 \u0db1\u0dcf\u0dba\u0d9a\u0dc0\u0db8\u0db1\u0dd2\u0d8b \u0d85\u0db1\u0dca\u0db1 \u0d91\u0dba\u0dc4\u0db8\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0db6\u0dd4\u0dba\u0da9\u0dd4\u0d9a8 \u0dba\u0dba\u0ddd\u0da2\u0db1\u0dcf \u0dba\u0db8\u0db1\u0dca\u0db1\u0d8b \u0dd0\u0db1 \u0dba\u0db8\u0db1\u0dca\u0db1\u0d8b \u0dba\u0db8\u0db1\u0dca\u0db1 \u0dba\u0db8\u0dca\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd18 \u0db1 \u0dc0\u0dba\u0dd2\u0db1 \u0db4\u0dd4\u0dbb\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca \u0dc0\u0db8\u0d9a \u0d9a\u0dbb\u0dca\u0dae\u0db8\u0dcf\u0db1\u0dca \u0db4\u0dd4\u0dbb 19\u0d9a\u0dc