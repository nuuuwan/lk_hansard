\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0d8b \u0db4\u0dc3 \u0dc0\u0dd2\u0db1\u0dcf\u0dca \u0dba\u0dc0\u0db1 \u0d91\u0d9a \u0d85\u0dc0\u0db8 \u0d9a\u0dbb\u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca8 \u0d8a\u0da7 \u0d85\u0daf\u0dca\u200d\u0dba\u0dcf\u0dc5 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dba\u0dcf\u0d9c\u0dcf\u0dbb 32\u0d9a\u0dca \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0d92\u0dc0\u0dcf\u0dba\u0dda \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d85\u0da9\u0dd4\u0db4\u0dcf\u0da9\u0dd4 \u0dc0\u0db1 \u0db8\u0dcf\u0db1\u0dc0 \u0dc3\u0db8\u0dca\u0db4 \u0dc3\u0dc4 \u0dba\u0db7\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0dc0 \u0dba\u0db8\u0dca \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0dc3\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dae\u0dab \u0d9a\u0dbb\u0dd2\u0dba\u0db1\u0dca \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0d91\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dd2\u0dba\u0da7 \u0dba\u0db8\u0dca \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0d85 \u0d9c\u0dc3\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0dca\u0db1 \u0daf\u0dd2 \u0d9a\u0dcf\u0dbd\u0dba\u0dda\u0dba \u0dc0\u0dc5 \u0db4\u0dc3 \u0db4\u0dd3\u0d9a\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb\u0dbd\u0dba\u0dda\u0dcf\u0d8b \u0dba\u0dcf\u0dba\u0dba\u0db1\u0dca \u0dba\u0dcf\u0dba\u0da7\u0d8b \u0dc0\u0d9c\u0dcf \u0db6\u0dd2\u0dba\u0db8\u0db1\u0dca \u0db6\u0dd2\u0db8\u0da7\u0d8b \u0d92 \u0db4\u0dba\u0dc3\u0dc0 \u0dad\u0dd2\u0dba\u0db6\u0db1 \u0d9c\u0dd0\u0dc5\u0dba\u0db4\u0db1 \u0dad\u0dca \u0dc0\u0dad\u0dca \u0dc0\u0dc0 \u0d85\u0db1\u0dd4\u0dc0 \u0dba\u0db4\u0dcf\u0dba\u0dc4\u0dcf\u0dbb \u0db1\u0dd2\u0dbb\u0dca\u0dae\u0dba\u0dc1\u0dca \u0d9a\u0dd2\u0dd3\u0d9a\u0db8 \u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dbb\u0dca\u0dae\u0dba\u0dba\u0dba\u0db1\u0dca\u0db8 \u0da7\u0dc1\u0dca\u200d \u0dba\u0dc0\u0db1\u0dc0\u0dcf8 \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0db8\u0db1\u0dd2\u0d8b \u0d9a\u0dca\u0dd2\u0d9a\u0dbb\u0dca\u0dae\u0db8\u0dcf\u0db1\u0dca \u0dba \u0d9c\u0dad\u0dca \u0dc0\u0dba \u0dcf\u0dad\u0dca \u0dc0\u0d8b \u0d85\u0db4\u0dd2 \u0db4\u0dd2\u0db8\u0dca\u0db8\u0d9a\u0dca \u0db4\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dba\u0db8\u0dca \u0dba\u0dc0\u0db1\u0dba\u0d9a\u0dcf\u0da7 \u0dc3\u0d9a\u0dc3\u0dc0 \u0d9a\u0dbb\u0db4\u0dd4 \u0dc3\u0dd0\u0dbd\u0dba\u0dda\u0dc3\u0dd4\u0db8\u0dca \u0dc0\u0dc5 \u0d94\u0db6\u0dc0\u0db8\u0dcf \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0dad\u0dca \u0dc0 \u0d87\u0dc0\u0dc5\u0dad\u0dca \u0dc0 \u0dba\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0db8\u0db8 \u0dba\u0db8\u0dca \u0dba\u0dc0\u0dbd\u0dba\u0dda\u0dcf\u0dba\u0dda\u0daf\u0dd3 \u0db8\u0dd4\u0dc5\u0dd4 \u0dbb\u0dba\u0dda\u0db8 \u0da2\u0db1 \u0dcf\u0dc0\u0da7 \u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf8\n\n\u0d85\u0dbd\u0dda\u0dc0 \u0dc4\u0dd4\u0dda\u0dd4\u0dc5\u0dd4\u0dc0 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dba: \u0d89\u0da9\u0dda \u0dd0 \u0dc0\u0dc0 \u0b85\u0bb2\u0bb5\u0bcd\u0bb5, \u0bb9\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0bb2\u0bc1\u0bb5 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bae\u0bcd: \u0b95\u0bbe\u0ba3\u0bbf\u0baa\u0bcd \u0baa\u0bbf\u0ba3\u0b95\u0bcd\u0b95\u0bc1\n\nHUMBULUWA VILLAGE, ALAWWA: LAND ISSUE 1065/2025 6. \u0dd4 \u0d85\u0d9c\u0dc1\u0dca\u0ddd\u0d9a \u0d9c\u0dd4\u0dab\u0d9c\u0dc3\u0dca\u0dad\u0db1 \u0db8\u0dc4\u0dc3\u0dad\u0dcf\n\n(\u0d85) (i) \u0daf\u0dca\u200d\u0dba\u0db9\u0dba\u0daf\u0dca\u200d\u0dba\u0dab\u0dd2\u0dba\u0d8b \u0d85\u0dbd\u0dba\u0dda\u0dda\u0dc0\u0d8b \u0dd4 \u0db8\u0dca\u0db6\u0dd4\u0dc5\u0dd4\u0dc0 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dba\u0dda \u0dca\u0da9\u0db8\u0dca \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0db6\u0dc0 \u0daf\u0dca\u200d\u0dba\u0db1\u0dca\u0dba\u0db1\u0dca\u0daf\u0dca\u200d\u0dba;\n\n(ii) 1911 \u0dc0\u0dbb\u0dca\u0dae\u0dc2\u0dba\u0dda \u0db8\u0dd0\u0db1\u0dd4\u0db8 \u0d85\u0db1\u0dd4\u0dc0 \u0dc3\u0d9a\u0dc3\u0dc0 \u0d9a\u0dbb\u0db1 \u0dbd\u0dba\u0dda\u0daf\u0dca\u200d\u0dba \u0d85\u0d82\u0d9a 455 \u0daf\u0dca\u200d\u0dba\u0dbb\u0db1 \u0dd4 \u0db8\u0dca\u0db6\u0dd4\u0dc5\u0dd4\u0dc0 \u0d9c\u0db8\u0dca \u0db4\u0dd2\u0db9\u0dd4\u0dbb \u0db6\u0dbd\u0dba\u0dda\u0dcf\u0dad\u0dca \u0dc0\u0db8\u0d9a\u0daf\u0dca\u200d\u0dba;\n\n(iii) 1910 \u0dc0\u0dbb\u0dca\u0dae\u0dc2\u0dba\u0dda \u0da7\u0da7 \u0dca\u0dc4 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dba\u0da7 \u0d85\u0dba\u0dad\u0dca \u0dc0 \u0dc0\u0dd6 \u0dca\u0da9\u0db8\u0dca\u0d8b \u0dba\u0db4\u0dca\u0dc1\u0d9c\u0dd2\u0d9a \u0db4\u0dcf\u0dbb\u0db8\u0dca\u0db4\u0daf\u0dd2\u0d9a \u0dca\u0da9\u0db8\u0dca \u0dba\u0dbd\u0dba\u0dda\u0dc3 \u0dca\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0dd2\u0dba\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dcf \u0d9a\u0dd2\u0dd3\u0d9a\u0dba\u0db8\u0dca \u0dba\u0daf\u0dca\u200d\u0dba\u0db4\u0dcf\u0dbb\u0dca\u0dae \u0dba\u0db8\u0dca\u0db1\u0dca\u0dc0\u0dc0 \u0dc0\u0dd2\u0da7\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0daf\u0dca\u200d\u0dba\u0db1\u0dca\u0dba\u0db1\u0dca\u0daf\u0dca\u200d\u0dba;\n\n(iv) \u0d85\u0d82\u0d9a 2621 \u0daf\u0dca\u200d\u0dba\u0dbb\u0db1 \u0dc3\u0db1\u0dca\u0db1\u0dc3 \u0dd2\u0dba\u0dcf\u0db4\u0db1 \u0d82\u0da0\u0dd2 \u0d9a\u0dbb \u0dad\u0dd2\u0dba\u0dda\u0daf\u0dca\u200d\u0dba;\n\n(v) \u0d91\u0dba\u0dc3\u0dc0 \u0db1\u0db8\u0dca\u0d8b \u0d91\u0db8 \u0dc3\u0db1\u0dca\u0db1\u0dc3 \u0dd2\u0dba\u0dcf\u0db4\u0db1 \u0d82\u0da0\u0dd2 \u0d9a\u0dbb\u0db1 \u0dbd\u0dba\u0dda\u0daf\u0dca\u200d\u0dba \u0db1 \u0db1\u0dba \u0dc3\u0dc4 \u0d85\u0daf\u0dca\u200d\u0dba\u0dcf\u0dc5 \u0db7\u0dd6\u0dd2\u0dba \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dba\u0dc0\u0db1\u0dca \u0dba\u0dc0\u0db1\u0dca \u0dc0\u0dca\u0dba\u0dba\u0db1\u0dca \u0dba\u0d9a\u0dcf\u0db4\u0db8\u0dab\u0daf\u0dca\u200d\u0dba;"
