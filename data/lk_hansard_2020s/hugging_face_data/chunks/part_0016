    "chunk_text": "1984 \u0dca\u0dcf\u0d9a\u0ddc 2005 ,\u0ddc\u0db4\u0dc3 \u0ddc\u0d9a \u0dd9 ,\u0ddc \u0dd0,\u0dca ,\u0db8\u0ddc,\u0d85 \u0dca\u0dbd\u0dd4\u0dad\u0dca ,\u0db8\u0ddc, \u0dca\u0dca\u0ddc\u0dab \u0dca\u0da9\u0dd4\u0db4,\u0dca \u0dca\u0dab\u0dba\u0dd2 \u0db1\u0dca\u0daf\u0dca\u0db0 \u0db4,\u0d9a\u0ddc \u0db6\u0dd9\u0db4\u0db6\u0dca\u0db4\u0dca. \u0dc3\u0dd4\u0d9c\u0dd2 \u0dbb\u0da2\u0dca\u200d \u0dc0\u0dd2\u0db1\u0dca\u0dca \u0db1\u0dca\u0daf\u0dd4 \u0dbb\u0db4\u0dd4\u0dbb, \u0dca\u0dbb \u0dca\u0dab\u0db4 \u0ddd\u0d86 \u0dbb\u0d82\u0ddc \u0db1\u0dd2 \u0db4 \u0ddc\u0db4\"\u0ddc\u0dbb \u0dca\" \u0dab\u0d85 \u0d92 \u0db8\u0dad\u0dca\u0dca \u0dca\u0daf\u0dd6\u0dbb\u0dd9\u0dca\u0dba \u0dad\u0dd3\u0dca\u0daf\u0dd4, \u0db1\u0dd2\u0d82\u0ddc \u0dca\u0dd9\u0da7\u0dad\u0dca \u0db4\u0dad\u0dca \u0dca\u0dab\u0ddc\u0dca\u0dca \u0da7 \u0db6\u0dbb \u0dca\u0dc5 \u0db8\u0dd0\u0da7\u0dbd\u0dd4 \u0dab\u0dad\u0dd4 \u0db4,\u0d9a\u0ddc \u0db6\u0dd9\u0db4\u0db6 ,\u0ddc. \u0d92 \u0db4\u0dad\u0dca \u0dca\u0dab\u0ddc\u0dca\u0dca \u0da7 \u0dd9\u0dbb\u0ddc\u0db8\u0dca \u0db6\u0dd0\u0dbb\u0dd2 \u0dca\u0dad\u0dca\u0dad\u0dca, \u0da7 \u0dca\u0dd9 \u0dad\u0dca\u0db4,\u0d9a\u0ddc \u0db6\u0dd9\u0db4\u0db6 ,\u0ddc. \u0dd9\u0dbd\u0dd4 \u0dc4\u0dd2\u0d9f \u0da7\u0dad\u0dca\u0d85 \u0dd9\u0dbd\u0dd4,\u0d9a \u200d\u0dbb\u0db8\u0dd2\u0db6\u0dd9\u0db4\u0dda \u0dc0 \u0d85\u0ddc\u0dad\u0dca\u0dab \u0db7\u0ddc, \u0da7\u0dad\u0dca \u0db4\u0db1 \u0db4 \u0ddc\u0db4\"\u0ddc\u0dbb \u200d\u0dbb\u0d9b\u0dda \u0db6\u0d9a \u0ddc \u0db6\u0dd9\u0db4\u0db6 ,\u0ddc. \u0db8\u0db1\u0dca \u0db1\u0dd2\u0db4 \u0ddd\u0da2\u0dca\u200d\u0dba \u0ddc\u0dbb \u0d82\u0db7\u0ddc \u0db6\u0dd9\u0dad\u0dd4 \u0db8\u0dd2 \u0db1\u0dd2\u0d85 ,\u0dca\u0dca\u0dab\u0ddc \u0dbb\u0da2\u0dca\u200d\u0db4\u0dda\u0dad\u0dca \u0dca\u0d9a \u0d9a\u0dd2\u0dc4\u0dd2 \u0db6\u0dd9\u0db4\u0db6 ,\u0ddc\u0d85 \u0db1\u0dd2\u0db8\u0dd2 \u0db4\u0dad\u0dca \u0db4\u0dab\u0da0\u0dca\u0da0 \u0dbb \u200d\u0dbb\u0dab\u0ddc\u0d85 \u0dca\",\u0dca ,\u0d82\u0dbb \u0db4, \u0db4 \u0ddc\u0da7 \u0dca\u0db4\u0dd2 \u0d9a\u0db6\u0ddc \u0db8\u0dca ,\u0ddc\u0d85 \u0dca\u0db4\u0dd2 \u0db4\u0db1 \u0dca\u0d9a \u0da7 ,\u0ddc \u0d9a\u0dd2 \u0d9a\u0ddc. \u0d92 \u0db4\"\u0ddc\u0dcf\u0dba\u0dd2. 2013-2014 ,\u0d82\u0dbb,\u0d9a ,\u0ddc\u0dca\u0d9a \u0d9a \u0db1\u0dd2\u0db8\u0dd2 \u0db4\u0dad\u0dca \u0db1\u0dd2\u0dc2\u0dda \u0ddc\u0dd9 \u0db6\u0dd9\u0db6\u0dd4\u0db4\u0dca \u0db4\u0dab\u0da7\u0dca\u200d\u0dbb\u0dd2 \u0db4\u0da7\u0ddc\u0dca 340 \u0dc0\u0dd2\u0dca\u0dbb\u0dba\u0dd2. 2022\u0daf\u0dd3 \u0dbb\u0d82\u0ddc \u0db1\u0dd2 \u0db4 \u0ddc\u0db4\"\u0ddc\u0dbb \u0dca\" \u0dab\u0dad\u0dca \u0d91 \u0db4\u0db1 \u200d\u0dbb\u0dab\u0ddc\u0d85 \u0d82\u0dd1\u0db4\"\u0dca \u0dca\u0da9\u0dd4 \u0dc0\u0dd4\u0d85\u0ddc. \u0db1\u0dd2\u0dc2\u0dda \u0ddc\u0dd9 ,\u0dd0\u0da2\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db4\u0db1 \u0dca\u0d9a ,\u0d9a\u0da7 \u0dca \u0db1 \u0db4 \u0ddc\u0db4\"\u0ddc\u0dbb \u0d9a\u0db6\u0ddc \u0daf\u0dd3\u0dab\u0dba\u0dd2\u0d85 \u0dd0,\u0dca ,\u0db8\u0ddc,\u0da7 \u0db4\u0dd9 \u0d82\" \u0ddc\u0db0\u0ddc\u0dbb\u0dba\u0dd2 \u0dc3\u0dad\u0dca\u0dca ,\u0d9b\u0db4 \u0dca\u0dab ,\u0dd0\u0da2\u0dd2 \u0dc5 \u0dba\u0dd4\u0dad\u0dd4 , \u0db6\u0dd9\u0db4\u0db6 ,\u0ddc. \u0dab\u0dab \u0d9a\u0dd2 \u0dca \u0dd0\u0dab\u0dd0\u0db6\u0dd9\u0dba\u0dd2\u0d85 \u0dca\u0da9\u0dd4 \u0db8\u0ddc\u0db4\u0dca \u0dca \u0dbb \u0db4\u0dd9 \u0da7 \u0dca\u0da9\u0dd4 \u0d8b\u0dd9\u0dc0\u0dd2\n\n2139 2140\n\n\u0ddc\u0dca\u0dbd\u0dd2\u0db8\u0db4\u0db1\u0dca\u0dad\u0dd4 ,\n\n\u0dca,\u0d82\u0ddc \u0dc0\u0dd2 \u0ddc\u0da2\u0dd2\u0db4\u0dda\u0daf\u0dd3 \u0d9a\u0dd4\u0db1\u0dca\u0db3\u0dd4 ,\u0db8\u0ddc, \u0db8\u0dd0 \u0dad\u0dca \u0dae\u0ddc \u0dbb\u0dca \u0dab\u0dab \u0dd0\u0dab\u0dd0\u0db6\u0dd9\u0dba\u0dd2. \u0db4\u0dab\u0ddc \u0dd9\u0d85 \u0db8\u0ddc\u0dbd\u0dd4 \u0dba\u0dbb\u0d82\u0dda\u0dd2 \u0dca\u0dab\u0dba\u0dd2 \u0d9a\u0d9c \u0ddc\u0db4\u0dda ,\u0dd0\u0da2\u0dd2\u0db4 \u0dca\u0dab \u0d9a\u0dd4\u0db1\u0dca\u0db3\u0dd4 \u0dca\u0dab\u0ddc\u0dca\u0dca \u0d82\" \u0d9a\u0dd4\u0db1\u0dca\u0db3\u0dd4 ,\u0db8\u0ddc, ,\u0dd0\u0da2\u0dd2\u0db4 \u0dca\u0dab \u0db6\u0dd9\u0db4\u0db6 \u0dba\u0dbb\u0d82\u0dda\u0dd2 \u0d85 \u0db8\u0db1\u0dca \u0db1\u0dd2\u0db4 \u0ddd\u0da2\u0dca\u200d\u0dba \u0ddc\u0dbb \u0d82\u0db7\u0ddc \u0db6\u0dd9\u0dad\u0dd4 \u0db8\u0dd2 \u0db1\u0dd2. \u0dca\u0db4\u0dda \u0dba\u0dbb\u0d82\u0dda\u0dd2 \u0db4\u0dda \u0db8\u0dd3\u0da7\u0dd2 \u0ddc\u0db4\u0db8\u0ddc\u0da9\u0dbd\u0d85 \u0db6\u0da7\u0db4 \u0ddc\u0d9a\u0d85 \u0dca\u0db1\u0db6\u0d9a\u0dca\u0db4\u0db8\u0ddc\u0da9\u0dbd\u0d85 \u0db6\u0d9a\u0db4\u0dd2\u0da7\u0dd2 \u0d85 \u0dbb\u0dca\u0db4\u0dd9\u0dab\u0dd2 \u0d85 \u0db4 \u0ddc\u0d82\u0dda\u0db4\u0db8\u0ddc\u0da9\u0dbd\u0d85 \u0dca\u0dc4\u0dd4\u0dca\u0db8\u0dca \u0d9a\u0d85 \u0dc3\u0dca \u0db4\u0dd2\u0da7\u0dd2 \u0d9a\u0dd2 \u0db4\u0db1 \"\u0dd0\u0dab \u0dca\u0dd0 \u0dab \u0d9a\u0dd4\u0db1\u0dca\u0db3\u0dd4 ,\u0db8\u0ddc, \u0db4\u0db6\u0ddc\u0db4\"\u0ddc\u0dab \u0d82\u0ddc\u0dca\u0dae , \u0db1\u0dca\u0daf\u0dca\u0db0 \u0db4, ,\u0ddc. \u0db8\u0dd4\u0dad\u0dca\u0d85 \u0dca\u0dd9 \u0d92 \u0dca \u0db4\u0dc3 \u0db1\u0dd2\u0dc2\u0dda \u0ddc\u0dd9 ,\u0d9a\u0da7 \u0db8\u0dd2\u0d9a \u0dd0\u0db6\u0dd9 \u0dd3\u0dab \u0dad\u0dd4 \u0dc5 \u200d\u0dbb\u0d9b\u0dda \u0dab\u0dad\u0dd4 \u0db4,\u0d9a\u0ddc \u0db6\u0dd9\u0db4\u0db6 ,\u0ddc. \u0dbb\u0db1\u0dd2\u0dca \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0dab\u0db1\u0dca\u0d9c\" \u0dc4\u0dd2\u0da7\u0db4\u0dd4\u0dbb, \u0da2\u0dca\u200d \u0ddc\u0db0\u0dd2 \u0db6\u0dd9\u0dad\u0dd4 \u0dab\u0ddc\u0db4\u0dc3 \u0ddc\u0d9a\u0db4\u0dda\u0d85 \u0d9a\u0dd4\u0db1\u0dca\u0db3\u0dd4,\u0d9a\u0da7 \u0dca\u0dd0 \u0db4\u0dd9\u0dca \u0d95 \u0dd1 \u0d9a\u0dd2 \u0d9a\u0ddc \u0dca\u0db4\u0dda \u0dba\u0dbb\u0d82\u0dda\u0dd2 \u0db4\u0dda \u0dbb\u0dca\u0db4\u0dd9\u0dab\u0dd2 \u200d\u0dbb\u0db4\u0daf\u0dca\u0d9b\u0db4\u0dda \u0d9a\u0dd4\u0db1\u0dca\u0db3\u0dd4 \u0d82\u0db1\u0db6\u0dca\u0db0\u0db4 \u0dca \u0db4\u0dd9 \u0ddc\u0dca\u0dca\u0db4\u0db1\u0dca\u0dad\u0dd4 , \u0da7\u0dca \u0db8\u0dad\u0dca\u0dca\u0ddc. \u0db4\u0db1 , \u0dc0\u0dd2\u0da7 \u0d9a\u0dd4\u0db1\u0dca\u0db3\u0dd4 ,\u0db8\u0ddc \u0db1\u0dca,\u0dca\u0db4\u0dc3 \u0db1\u0dd2\u0dc2\u0dda \u0ddc\u0dd9 \u0dc0\u0dd2 \u0dd9\u0dab \u0dca\"\u0dc5 \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0d9a\u0ddc \u0db6\u0dd9\u0db4\u0db6 ,\u0ddc. \u0dca\u0d82\u0dda\u0d82\u0dbb \u0d9a\u0dd4\u0db1\u0dca\u0db3\u0dd4 \u0d9a\u0dd2\u0db4\u0d9a\u0ddd, \u0da7 \u0db1\u0dca\u0db4\u0dd2 \u0dca 4\u0d85500 \u0dc0\u0dd2\u0dca\u0dbb \u0d9a\u0dd0\u0db6\u0dd4\u0dab\u0dd4 \u0d91 \u0dd9\u0dd0\u0dca \u0db1\u0dca\u0db4\u0dd2 \u0dca 3\u0d85500 \u0dd9 ,\u0ddc \u0db8\u0dd2\u0d9a \"\u0dc5 \u0db6\u0dd0\"\u0dd0\u0d9a\u0ddc \u0db6\u0dd9\u0db4\u0db6 ,\u0ddc. \u0d92 ,\u0ddc\u0db4\u0dc3\u0dab \u0db1\u0dca\u0db4\u0dd2 \u0dca 1\u0d85500 \u0da7 \u0db8\u0dad\u0dca \u0db4 \u0ddc\u0db4\"\u0ddc\u0dbb \u0db8\u0dd2\u0da7\u0dd2 \u0da7 \u0dd9\u0dd0\u0dca \u0db1\u0dca\u0db4\u0dd2 \u0dca 6\u0d85500 \u0dc0\u0dd2\u0dca\u0dbb \u0db4\u0db8,\u0dca \u0db4,\u0d9a\u0ddc \u0db6\u0dd9\u0db4\u0db6 ,\u0ddc. \u0db4\u0db1 \u0db1\u0dd2\u0dc2\u0dda \u0ddc\u0dd9 \u0dc0\u0dd2 \u0dd9\u0dab ,\u0dd0\u0da2\u0dd2 \u0dd3\u0dab \u0db8\u0dd0 \u0dca, \u0d91 \u0db1\u0dca\u0d85 \u0d9a\u0dd2 \u0d9a\u0ddc \u0dab\u0dab ,\u0db6\u0dd9\u0dca \u0db1. \u0d92 \u0dd9,\u0d82\u0dda,\u0d9a \u0db1\u0dca\u0db4\u0dd2 \u0dca 20\u0d85000\u0d9a\u0dd2\u0dca \u0dc0\u0dd2\u0dca\u0dbb \u0d9a\u0dd4\u0db1\u0dca\u0db3\u0dd4 \u0dca \u0dbb \u0db4 \u0dc5\u0dca \u0db4\u0dd4\u0dbb,\u0dc5\u0dd4,\u0dca \u0dc0\u0dd4\u0d85\u0dad\u0dca \u0dca\u0dd9 \u0db1\u0dca\u0db4\u0dd2 \u0dca 50\u0d85000 \u0da7,\u0dad\u0dca \u0db6\u0dd0\u0dbb\u0dd2 \u0db4,\u0d9a\u0ddc \u0db6\u0dd9\u0db4\u0db6 ,\u0ddc. \u0db4\u0db1 \u0db8\u0dd2\u0d9a \"\u0dca ,\u0dd0\u0dc3\u0dca\u0dab \u0d9a\u0dd4\u0db1\u0dca\u0db3\u0dd4 ,\u0db8\u0ddc \u0db1\u0dca,\u0dca\u0da7 ,\u0ddc\u0db4\u0dc3\u0dab \u0d9a\u0dd4\u0db1\u0dca\u0db3\u0dd4 \u0dca\u0dc5 \u0dc0\u0dd2\u0d9b\u0ddc\u0d9a \u0db4\u0dd2\u0dbb\u0dd2\u0d82 \u0da7\u0dad\u0dca \u0dca\u0dd9 \u0db6\u0d9a \u0ddc \u0db6\u0dd9\u0db4\u0db6 ,\u0ddc. \u0d92 \u0dca \u0db4\u0dc3\u0dad\u0dca \u0d86\u0dd9\u0ddc \u0dab \"\u0dc5 \u0db6\u0dd0\"\u0dd0\u0d9a\u0ddc \u0db6\u0dd9\u0db4\u0db6 ,\u0ddc."
