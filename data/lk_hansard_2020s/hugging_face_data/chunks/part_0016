    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0db8\u0db1\u0dd2\u0d8b \u0d94\u0db6\u0dc0\u0db8\u0dcf \u0d85\u0dc4\u0db4\u0dd4 \u0dba\u0daf\u0dca\u200d\u0dba\u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0dc0\u0dbb\u0dd4 \u0dca\u200d\u0dbb\u0dca\u0dc0\u0db1\u0dba \u0dc0\u0dc5\u0dd2\u0db1\u0dca \u0db8\u0dc0 \u0d9a\u0dba\u0dc5\u0dc0 \u0dca \u0dcf \u0dc0\u0dd0\u0daf\u0dca\u200d\u0dba\u0d9c\u0dad\u0dca \u0dc0 \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca8 \u0d87\u0dad\u0dca \u0dc0 \u0da7\u0db8 \u0d85\u0dba\u0db4\u0dca \u0dba\u0d9c\u0dcf\u0dc0\u0dd2 \u0da2\u0db1 \u0dcf\u0dc0 \u0dba\u0db4\u0dcf\u0dba\u0dc4\u0dcf\u0dbb \u0db7\u0dcf\u0dc0\u0dd2 \u0d9a\u0dd2\u0dd3\u0d9a\u0dba\u0db8\u0dca\u0daf\u0dd3 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dba\u0dcf\u0dad\u0dca \u0dc0\u0db8\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba\u0dda\u0daf\u0dca\u200d\u0dba\u0dba\u0d9a\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0dba\u0db1\u0dcf\u0dba\u0dc0\u0dba\u0dd2\u0d8b \u0dba\u0db4\u0dcf\u0dba\u0dc4\u0dcf\u0dbb \u0db7\u0dcf\u0dc0\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0dba\u0db1\u0dca8 \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dba\u0db8\u0dca \u0dba\u0dc0\u0db1\u0dba\u0d9a\u0dcf\u0da7 \u0d85\u0dba\u0db4\u0dca \u0d9a\u0dca\u0dd2\u0d9a\u0dbb\u0dca\u0dae\u0db8 \u0dba\u0daf\u0dca\u200d\u0dba\u0db4\u0dcf\u0dbb\u0dca\u0dae \u0dba\u0db8\u0dca\u0db1\u0dca\u0dc0\u0dc0 \u0d8a\u0da7 \u0d85\u0daf\u0dca\u200d\u0dba\u0dcf\u0dc5 \u0dc3\u0dd0\u0dbd\u0dba\u0dda\u0dd0\u0dc3\u0dc0\u0db8\u0d9a\u0dca \u0dc4\u0daf\u0dca\u200d\u0dba\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc2\u0dba\u0dba\u0db1\u0dca\u0db8 \u0d85\u0db4\u0dd2 \u0dca\u0dbd\u0dba\u0dda\u0d9a\u0dca\u0d9a \u0d9a\u0dbb \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0d8b \u0d9a\u0db1\u0dca\u0db1 4\u0d9a\u0dca \u0d87\u0dc0\u0dc5 \u0dd3 \u0dc0\u0d9c\u0dcf\u0dc0\u0da7 \u0d85\u0daf\u0dca\u200d\u0dba\u0dcf\u0dc5\u0dc0 \u0db4\u0dc3 \u0db4\u0dd3\u0d9a\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb\u0dbd\u0dba\u0dda\u0dcf \u0d92 \u0db4\u0dc3 \u0dc0\u0dc5 \u0dad