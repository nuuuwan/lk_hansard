    "chunk_text": "\u0d91\u0dc0\u0db8\u0dcf \u0dca\u0db1 \u0daf\u0dd2\u0db4\u0dad\u0dca \u0dc0 \u0d9a\u0dbb\u0db4\u0dd4 \u0dba\u0db8\u0dca \u0d86\u0da9\u0dd4\u0d9a\u0da9\u0dd4\u0dba\u0dda \u0db4\u0dc5\u0db8\u0dd4\u0dba\u0dc0\u0db1\u0dd2 Budget \u0d91\u0d9a \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc0\u0dcf\u0daf\u0dca\u200d\u0dba\u0dba\u0dda\u0daf\u0dd3 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda \u0db4\u0dc5\u0db8\u0dd4 \u0d9a\u0dae\u0dcf\u0dc0 \u0db8\u0db8\u0dba\u0dd2 \u0d9a\u0dba\u0dc5\u0dc08 \u0d91\u0db8 \u0d9a\u0dae\u0dcf\u0dba\u0dda\u0d8b \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0d9c\u0dd0\u0db1 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0daf\u0dca\u200d\u0dba\u0dd0\u0d9a\u0dca\u0dd3\u0db8 \u0d86\u0dbb\u0db8\u0dca\u0db7\u0dba\u0dda\u0daf\u0dd3 \u0db8\u0dba \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dcf\u0d9a\u0dba\u0dba\u0dda \u0d85\u0daf\u0dca\u200d\u0dba\u0dc4\u0dc3\u200d \u0dc0\u0dd4\u0dba\u0da9\u0dd4\u0d9a\u0d8b\u200d '\u0db8\u0da7 \u0dba\u0db4\u0dba\u0db1\u0db1\u0dca\u0dba\u0db1\u0dca \u0db4\u0dbd\u0dcf\u0dd2\u0dba\u0dda \u0dc6\u0dcf\u0daf\u0dca\u200d\u0dba\u0dbb\u0dca\u0dae \u0dba\u0d9a\u0dba\u0db1\u0d9a\u0dca\u0d8b \u0db4\u0db1\u0dca\u0dc3\u0dba\u0dbd\u0dcf \u0db6\u0dab \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0dc0\u0dcf\u0dba \u0d9a\u0dae\u0dcf\u0dc0\u0d9a\u0dca \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0db8\u0dcf \u0d9a\u0dc5\u0dcf'\u200d \u0d9a\u0dd2\u0dba\u0db1\u200d \u0d91\u0d9a\u0dba\u0dd28 \u0d85\u0daf\u0dca\u200d\u0dba \u0d92\u0d9a \u0dba\u0db6\u0dcf\u0dba\u0dc4\u0ddd \u0dbb\u0da7 \u0d94\u0db4\u0dca\u0db4\u0dd4 \u0dc0\u0dd4\u0dab\u0dcf\u0d8b \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dba\u0dba\u0ddd\u0da2\u0dba \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dd2\u0dba\u0dba\u0db1\u0dd28 \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0db8\u0dca\u0d8b \u0d92 \u0d87\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf8 \u0dba\u0db8\u0dcf\u0d9a\u0daf\u0dca\u200d\u0dba\u0d8b \u0db8\u0db1\u0dca\u0dba ideology \u0d91\u0d9a\u0dba\u0dd2\u0d8b IMF \u0d91\u0dba\u0d9a\u0dca \u0dba\u0d9a\u0dcf\u0db1\u0dca\u0dba\u0dc1\u0da7\u0dba\u0dd2\u0d8b \u0db4\u0dd0\u0dbd\u0dba\u0dda\u0dc0\u0dad\u0dca \u0dc0\u0dba\u0dad\u0dca \u0dc0 \u0d85\u0daf\u0dca\u200d\u0dba\u0dc4\u0dc3\u0dd4\u0dba\u0dd2\u0d8b \u0daf\u0dca\u200d\u0dba\u0dd0\u0db1\u0dca \u0dba\u0d9a\u0dcf\u0dbb\u0db1 \u0dba\u0daf\u0dca\u200d\u0dba\u0dba\u0dba\u0dd2 \u0dc3\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dae\u0dab\u0dba\u0dba\u0db1\u0dca\u0db8 \u0db4\u0da7\u0dbd\u0dba\u0dda\u0dc0\u0dcf\u0d9c\u0dad\u0dca \u0dc0\u0dc0 \u0dc3\u0dc0\u0dc0\u0dbb\u0dd6\u0db4\u0dba\u0d9a\u0dca \u0db8\u0dba\u0dd2 \u0db8\u0db8 \u0daf\u0dca\u200d\u0dba\u0dd0\u0d9a\u0dca\u0dba\u0d9a\u0dca8 \u0db8\u0db8 \u0dc3\u0daf\u0dca\u200d\u0dba\u0dcf\u0dc4\u0dbb\u0dab \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0db4\u0db8\u0dab\u0d9a\u0dca \u0dba\u0daf\u0dca\u200d\u0dba\u0db1\u0dca\u0db1\u0db8\u0dca8\n\n\u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0dbd\u0dd48 \u0daf\u0dca\u200d\u0dba\u0dd0\u0db1\u0dca ideology \u0d91\u0d9a \u0dba\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0daf\u0dca\u200d\u0dba? \u0dbb\u0da2\u0dba\u0da7 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dad\u0dd2\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1; \u0dba\u0db8\u0dca\u0dc0\u0dcf \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0db1\u0dca\u0dba\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dba\u0dd28 \u0dbb\u0da2\u0dba\u0dda \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4 \u0d92\u0d9a \u0db8\u0dba\u0dd2 \u0db1 \u0d9c\u0dd2\u0db1\u0dca \u0db1 \u0d9c\u0da7\u0db8 \u0d9a\u0dd2\u0dda\u0dba\u0dda8 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dc0 \u0db4\u0dc0\u0dad\u0dca \u0dc0\u0dc0\u0dcf\u0d9c\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1\u0d8b \u0d9a\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dab\u0d9a\u0dcf\u0dbb\u0dba\u0db1\u0dca\u0dba\u0d9c\u0db1\u0dca \u0dbb\u0da7 \u0dba\u0dda\u0dbb\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0dc0\u0dcf\u0dba \u0d9a\u0dae\u0dcf\u0dad\u0dca \u0dc0 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf8 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2\u0d8b \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dba\u0dba\u0ddd\u0da2\u0dba \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dd2\u0dba\u0dba\u0db1\u0dd2\u0d8b \u0d85\u0daf\u0dca\u200d\u0dba \u0d85\u0db4\u0da7 \u0d85\u0dc4\u0db1\u0dca\u0db1 \u0dba\u0dc0\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0d8b \u0dca\u200d\u0dbb\u0dca\u0dc0\u0db1\u0dba\u0d9a\u0dca8 \u0d9a\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dab\u0dba \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dca\u0dba\u0db1\u0dca\u0d8b JVP \u0d91\u0dba\u0d9a\u0dca\u0daf\u0dca\u200d\u0dba\u0d8b NPP \u0d91\u0dba\u0d9a\u0dca\u0daf\u0dca\u200d\u0dba \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf8 \u0d85\u0dbb \u0d85\u0dc3\u0dbb\u0dab \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dd2\u0dba\u0dba\u0da7 \u0dba\u0db8\u0dcf\u0d9a\u0daf\u0dca\u200d\u0dba \u0d9a\u0dba\u0dc5\u0dc0? \u0dba\u0d9a\u0dba\u0dc3\u0dc0 \u0dba\u0dc0 \u0dad\u0dca \u0dc0\u0d8b \u0d9a\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0d91 \u0dd0\u0db1 \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf \u0dc0\u0dcf\u0dba \u0db8\u0dba\u0dd2 \u0d85\u0db4\u0da7 \u0dba\u0db4\u0dba\u0db1\u0db1\u0dca\u0dba\u0db1\u0dca8"
  },
