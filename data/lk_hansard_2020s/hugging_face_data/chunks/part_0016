    "chunk_text": "\u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d9c\u0db8\u0dca \u0db8 \u0d9c\u0dd0\u0db1 \u0db8\u0db4\u0dd2\u0db4 \u0dc0\u0dd2\u0db1\u0dc1\u0dbd \u0d9c\u0d9c\u0dde\u0dbb\u0dc0 \u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dc10 \u0d9c\u0dbb\u0dda\u0dc2\u0dcf\u0db0\u0dc1\u0d9a\u0dbb\u0d9a\u0dbb\u0dab \u0dc0\u0dd2\u0db1\u0dd2\u0db1\u0dcf \u0d9a\u0dc1\u0dbb\u0dc0\u0dbb \u0d9a\u0dd4 \u0dc0\u0db1 \u200d\u0dbb\u0dd3\u0dad\u0dd2 \u0db4\u0dd3\u0db8\u0db1\u0dca \u0dd6 \u0dbb\u0d9c\u0dc3\u0dda\u0db1 \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dc1 \u0d9c\u0db8\u0dca \u0dad\u0db1\u0dad\u0dd4\u0d9c\u0dda \u0dd2\u0db3\u0d9c\u0db1\u0dca\u0db1 \u0d91\u0d9a \u0d91\u0dad\u0dd4\u0db8\u0dc1\u0db4 \u0d9c\u0dc4\u0ddc\u0db3 \u0db1\u0dd0\u0dc4\u0dd0 \u0dd2\u0dbb \u0dbd\u0dc1 \u0d9c\u0db8\u0dca \u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0d9a\u0dbb\u0db1\u0d9c\u0d9a\u0ddc\u0db4 \u0db8\u0db8 \u0dd2\u0dbb\u0dda\u0dc0\u0dc10 \u0d9c\u0db8\u0ddc\u0d9a\u0daf \u0d9c\u0db8\u0dca \u0da0\u0dd6\u0dd2\u0db1\u0dad \u0dc1\u0db4 \u0dc0\u0dd2\u0dbb\u0dd4\u0dd3\u0dcf\u0dc0 \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0db1\u0d9a\u0dca 9\u0d9a \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0dad\u0db8\u0dba\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dc1\u0db1 \u0dc3 \u0dc1\u0db4\u0dad\u0dd2 \u0dc0\u0dd2\u0db1\u0dd2\u0db1\u0dcf \u0d9a\u0dc1\u0dbb\u0dc0\u0dbb \u0dc10 \u0d92 \u0dc0\u0dc1\u0d9c\u0dda\u0db8 \u0db8\u0dc1\u0db1\u0dc0 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dcf\u0dc0 \u0d9c\u0dd3\u0db1\u0db6\u0db1\u0dca\u0daf\u0dd4 \u0d9c\u0dad\u0db1\u0dca\u0db1\u0d9c\u0d9a\u0ddd\u0db1\u0dca\u0db4 \u0dc0\u0dd2\u0dbb\u0dd4\u0dd3\u0dcf\u0dc0 \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0d9a\u0dca \u0daf\u0dd3\u0dbd\u0dc1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dc10 \u0d91\u0dad\u0d9c\u0d9a\u0ddc\u0db4 \u0d92 \u0dc0\u0dd2\u0db1\u0dd2\u0db1\u0dcf \u0d9a\u0dc1\u0dbb\u0dc0\u0dbb \u0dc1\u0db8 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dc1 \u0d9c\u0db8\u0dca \u0dad\u0db1\u0dad\u0dd4\u0d9c\u0dda \u0dc0\u0dc1\u0da9\u0dd2 \u0dc0\u0dd4\u0dab\u0dc1\u0db8 \u0d91\u0dad\u0dd0\u0db1\u0db4 \u0d9c\u0dd2 \u0dc1\u0db8\u0dad\u0dca \u0db8\u0dad\u0dd0\u0db1\u0db4 \u0d9c\u0dd2 \u0dc1\u0db8\u0dad\u0dca \u0dd2\u0db1\u0dca\u0d9c\u0db1\u0dca \u0d91\u0d9a\u0db8 \u0dc0\u0dd2\u0db1\u0dd2\u0db1\u0dcf \u0d9a\u0dc1\u0dbb\u0dc0\u0dbb \u0dc1 \u0db1\u0db8\u0dca \u0dc0\u0dbb\u0daf\u0d9a\u0dc1\u0dbb\u0d9c \u0d9a\u0dca \u0dc3\u0dc1\u0dcf\u0dc1\u0dbb\u0dab \u0d9a\u0dca \u0db6\u0dbd\u0dc1\u0d9c\u0db4\u0ddc\u0d9c\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0d9c\u0dc0\u0db1\u0dca\u0d9c\u0db1\u0dca \u0d9c\u0d9a\u0ddc\u0d9c\u0dc4\u0ddc\u0db8\u0daf? \u0d92\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0db8\u0db8 \u0dd2\u0dbb \u0db4\u0dd4 \u0db4\u0dd9\u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0dc1\u0dbb\u0dab 0\n\n\u0d92 \u0dc0\u0dc1\u0d9c\u0dda\u0db8 \u0d9c\u0db8\u0dca \u0d9a\u0dc1\u0dbb\u0dab \u0dad\u0dca \u0db8\u0db8 \u0db8\u0dad\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dd20 \u0db4\u0dc1\u0dc3\u0dcf\u0d9a\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dc1\u0dbb \u0dc0\u0dd9\u0d9a\u0dca\u0dc0\u0dc1\u0d9c\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0db4\u0dad \u0dc0\u0dd4\u0dab\u0dc1 \u0dd2\u0dbb \u0dbd\u0dc1 \u0db8\u0daf \u0d9c\u0dd3\u0db1\u0db6\u0db1\u0dca\u0daf\u0dd4 \u0d9c\u0dad\u0db1\u0dca\u0db1\u0d9c\u0d9a\u0ddd\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dca\u0db8 \u0dc1\u0db4 \u0dc0\u0dd2\u0dbb\u0dd4\u0dd3\u0dcf\u0dc0 \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0d9c \u0ddd\u0daf\u0db1\u0dc1 \u0d87\u0dad\u0dd4\u0d9c\u0dd9\u0dda \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dc10 \u0d92\u0d9c\u0d9a\u0db1\u0dca \u0dd2\u0dbb \u0db1\u0dca\u0d9c\u0db1\u0dca \u0d9c\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0daf? \u0d9c\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dbd\u0dd0\u0dd2\u0dba\u0dbd\u0dc1 \u0d9c\u0dd3\u0db1\u0db6\u0db1\u0dca\u0daf\u0dd4 \u0d9c\u0dad\u0db1\u0dca\u0db1\u0d9c\u0d9a\u0ddd\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dca\u0db8 \u0dc1 \u0d9c\u0db8\u0dca\u0d9a \u0db4\u0dc1\u0dbd\u0db1 \u0d9a\u0d9c\u0dd9\u0dda \u0db1\u0dd0\u0dc4\u0dd0 \u0dd2\u0dbb \u0dbd\u0dc1 \u0db8\u0d9c\u0db4\u0dca \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dc1\u0db8 \u0dd2\u0dbb\u0dda\u0dc0\u0dc10 \u0d9c\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0daf\u0dd4\u0db1\u0dca\u0d9c\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0dd2\u0dbb \u0dbd\u0dc1 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dc1\u0db1\u0dca\u0d9c\u0dc3\u0dda\u0dbd\u0dc1 \u0db1\u0dd2\u0dbd\u0db1\u0dca\u0dad \u0da2 \u0dc0\u0dda\u0dcf\u0db1\u0dc0 \u0d9c\u0dc3\u0dda\u0dc0\u0d9c \u0db1\u0dca \u0d91\u0dc5\u0dd2 \u0db4 \u0daf\u0dc1\u0db1\u0dc0\u0dc10 \u0d9c\u0db4\u0ddc\u0dd2\u0db1\u0dc3\u0dcf \u0d9c\u0d9a\u0ddc\u0db8\u0dd2\u0dc3\u0d9c\u0db8\u0dca \u0dc3 \u0dc1\u0db4\u0dad\u0dd2 \u0d9c\u0db8\u0dca \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0d9c\u0dda\u0db8 \u0d91\u0d9a \u0dc3\u0dc1\u0db8\u0dc1\u0da2\u0dd2\u0d9a\u0d9c \u0d9a\u0dca0 \u0dad\u0dc4\u0dd4\u0dad\u0dca \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0 \u0daf\u0dd4\u0db1\u0dca\u0db1 \u0db1\u0dd2\u0dda\u0d9c\u0dd3\u0db1\u0d9c\u0d86 \u0dd2\u0dbb \u0db1\u0dc0\u0dc1 \u0d9c\u0dd3\u0db1\u0db6\u0db1\u0dca\u0daf\u0dd4 \u0d9c\u0dad\u0db1\u0dca\u0db1\u0d9c\u0d9a\u0ddd\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dca\u0db8 \u0dc1 \u0db4\u0dc1\u0dc3\u0dcf\u0d9a\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dc1\u0dbb \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9c\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0daf\u0dd0\u0db1\u0d9c\u0d9c\u0db1 \u0d92 \u0d9c\u0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0dd4\u0d9c\u0da9\u0dd4 \u0db1\u0dd0\u0dc4\u0dd0 \u0dd2\u0dbb \u0dbd\u0dc10 \u0d9c\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0daf\u0dd0\u0db1\u0d9c\u0d9c\u0db1 \u0dd2\u0dbb \u0db1\u0dca\u0d9c\u0db1\u0dca \u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0db8\u0dca \u0db1\u0dd2\u0dbd\u0db1\u0dca\u0dad \u0da2 \u0dc0\u0dda\u0dcf\u0db1 \u0d92 \u0d9c\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0daf\u0dd3\u0dbd\u0dc1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dc1 \u0d9c\u0dd3\u0db1\u0db6\u0db1\u0dca\u0daf\u0dd4 \u0d9c\u0dad\u0db1\u0dca\u0db1\u0d9c\u0d9a\u0ddd\u0db1\u0dca\u0db40 \u0dad\u0dc4\u0dd4 \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb\u0dbd\u0dc1 \u0db1\u0dd0\u0dc4\u0dd00 \u0d92 \u0db1\u0dd2\u0dc3\u0dc1 \u0dad\u0dc4\u0dd4 \u0d9c\u0db4\u0ddc\u0dd2\u0db1\u0dc3\u0dcf\u0db4\u0dad\u0dd2 \u0dd4\u0dbb\u0dbb\u0d9c \u0db1\u0dca \u0dd2\u0dc0\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d92\u0d9a\u0dad\u0dca \u0d91\u0d9a \u0d9c \u0ddd\u0daf\u0db1\u0dc1\u0dc0\u0d9a\u0dca0 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d9c\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0daf\u0dd4\u0db1\u0dca \u0d9c\u0d9a\u0db1\u0dc1\u0dad\u0dca \u0dd2\u0dc0\u0dad\u0dca \u0d9a\u0dbb\u0dbd\u0dc1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dc10 \u0d92\u0d9c\u0d9a\u0db1\u0dca \u0d9c\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0daf \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0dc0\u0dd0\u0d9c\u0da9\u0d9a? \u0d9c\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dbd\u0db6\u0dc1 \u0d9c\u0dad\u0dca\u0dad \u0dbb\u0dc0\u0dd3 \u0d9c\u0dc3\u0d9c\u0db1\u0dc0\u0dd2\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0db8 \u0dc1 \u0db8\u0daf \u0db8\u0db8\u0dc1\u0dad\u0dba\u0dc1\u0dc0\u0db1\u0d9c\u0d86 \u0d9c\u0dbd\u0dca\u0d9a\u0db8\u0dca0 \u0d91\u0dad\u0d9c\u0d9a\u0ddc\u0db4 \u0d92\u0d9c\u0d9a\u0dca \u0dc3\u0dc1\u0dcf\u0dc1\u0dbb\u0dab\u0dad\u0dca\u0dc0 \u0d9c\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0daf? \u0dc0\u0dd0\u0dbb\u0dd2\u0db1 \u0db1\u0db8\u0dca \u0dad\u0d9a\u0dca\u0d9c\u0d9a\u0ddd\u0db8 \u0dc0\u0dd0\u0dbb\u0dd2\u0db1\u0dba\u0dd20 \u0d92\u0d9a\u0dba\u0dd2 \u0db8\u0db8 \u0d9c\u0db8\u0dca \u0dd2\u0dbb\u0dda\u0d9c\u0dda0 \u0db8\u0daf \u0d9c\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0daf \u0d9a\u0dbb\u0dbd\u0dc1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0d9c\u0db1\u0dca? \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dc1\u0db1\u0dca\u0d9c\u0dc3\u0dda\u0dbd\u0dc1 \u0d9c\u0db8\u0dad\u0dd0\u0db1 \u0db8\u0dc4\u0dc1 \u0d9c\u0dbd\u0ddc\u0d9a\u0dd4\u0dc0\u0db4 \u0d9a\u0dba\u0dd2 \u0d9c\u0dc4\u0db1\u0dc0\u0dc1 \u0d9c\u0db4\u0ddc\u0dbd\u0dd3\u0dc3\u0dd2 \u0dc4\u0db4\u0dad \u0db4 \u0d9a\u0db4\u0dd4\u0dad\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dc1 \u0dd2\u0dbb \u0dbd\u0dc10 \u0d9c\u0d9a\u0ddc\u0d9c\u0dc4\u0dda\u0daf \u0d9c\u0db4\u0ddc\u0dbd\u0dd3\u0dc3\u0dd2 \u0dc4\u0db4\u0dad \u0db4 \u0d9a\u0db4\u0dd4\u0dad\u0dad\u0dd4 \u0d9a\u0dbb\u0dbd\u0dc1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0d9c\u0db1\u0dca?"
