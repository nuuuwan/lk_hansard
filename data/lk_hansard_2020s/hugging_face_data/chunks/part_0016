    "chunk_text": "3. \u0dd0\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2 \u0dba\u0dca\u0d9a \u0db8\u0dba\u0dd2 \u0d96\u0dc2\u0db0 \u0dd2 \u0dba \u0dba\u0dca \u0dbb\u0db8\u0d9a\u0dd2\u0db1\u0dca \u0dba \u0d87\u0dad\u0dd2 \u0dba\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dbb\u0db8\u0dba.\n\n2025 \u0dc0\u0dca\u0dc2\u0dba\u0dda \u0dc0\u0dcf\u0dca\u0dd2\u0d9a \u0d87\u0dab\u0dc0\u0dd4\u0dca 2021 \u0da2\u0db8\u0dc0\u0dcf\u0dba\u0db4 \u0db8\u0dc3 \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca\u0dc4 \u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc0 \u0dad\u0dd2\u0db6\u0dd4\u0dab \u0daf \u0d92\u0dc0\u0dcf 2021 \u0db8\u0dcf\u0dca\u0dad\u0dd4\u0db8 \u0db8\u0dc3 \u0dc3\u0dd2 202 \u0db8\u0db1\u0dba\u0dd2 \u0db8\u0dc3 \u0daf\u0dca\u0dc0\u0dcf \u0dc0\u0dd6 \u0d9a\u0dcf\u0dbd\u0dba \u0dad\u0dd4\u0db8 \u0daf\u0dc0\u0daf\u0dba \u0dc3\u0db1\u0daf\u0dba\u0dd4\u0dca \u0d85\u0dcf\u0dc1\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0daf \u0dd3 \u0dbd\u0db1\u0db6\u0dd2\u0dab\u0dd2.\n\n2025 \u0dc0\u0dca\u0dc2\u0dba \u0dc3\u0db3 \u0dcf \u0d87\u0dab\u0dc0\u0dd4\u0dca 193\u0dca \u0dc3\u0db1\u0daf \u0d8b\u0db8 \u0dc3\u0db3 \u0dcf \u0dbd\u0db1\u0db6\u0dd3 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0d85 \u0dbb \u0d87\u0dab\u0dc0\u0dd4\u0dca 206\u0dca \u0dbd\u0db1\u0db6\u0dd3 \u0dad\u0dd2\u0db6\u0dd4\u0dba\u0dab\u0dca \u0db1\u0dd2\u0dc3\u0dd2 \u0d9a\u0dbd \u0dba\u0dda\u0dbd\u0dcf\u0dc0 \u0d96\u0dc2\u0db0 \u0dc3\u0db1\u0daf \u0d8b\u0dca \u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dc3\u0dd2\u0dd4\u0dc0 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dba\u0db1\u0dca \u0dc0\u0dd6 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dca\u0daf\u0dcf\u0daf\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dd2\u0dba \u0dc3\u0db3 \u0dcf \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dc0\u0dad\u0dca\u0dc4 \u0dbb\u0dca \u0d9a\u0dcf\u0dbd\u0dba\u0dca \u0dba\u0db8\u0dcf\u0db8\u0db1\u0dad\u0dd2\u0dc0\u0dba.\n\n\u0d92\u0d9a \u0db8\u0dba\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dbb\u0db8\u0dba.\n\n\u0dbd \u0dba \u0dbb\u0dad\u0dd4\u0db8\u0dc0 \u0db1\u0dd2\u0dc3\u0dcf \u0dba\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dd2\u0db0\u0dba\u0dc1\u0dbb\u0dc2\u0dba\u0dba\u0db1\u0dca \u0dc3\u0db3 \u0db1\u0dca \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca 2026 \u0dc0\u0dca\u0dc2\u0dba\u0dda \u0d87\u0dab\u0dc0\u0dd4\u0dca -\u0dbd\u0db6\u0db8 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0dba\u0dda \u0d87\u0dab\u0dc0\u0dd4\u0dca- 202 \u0dc0\u0dca\u0dc2\u0dba \u0db8\u0dd4\u0dbd\u0daf\u0dd3 \u0dbd\u0db6\u0dcf \u0dba\u0daf\u0db8 \u0dba\u0dbd\u0dc3 \u0daf\u0dc0\u0daf\u0dba \u0dc3\u0db1\u0daf\u0dba\u0dd4\u0dca \u0d85\u0dcf\u0dc1\u0dba \u0dba\u0dc0\u0dad\u0dd2\u0db1\u0dca \u0dbd\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0dca \u0d9a\u0dbb\u0db8 \u0dbd\u0daf\u0dd3. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 202 \u0da2\u0db8\u0dc0\u0dcf\u0dba\u0db4 \u0db8\u0dc3 \u0d87\u0dab\u0dc0\u0dd4\u0dca \u0dbd\u0db1\u0dba\u0dd2\u0dc3\u0dbb\u0dad\u0dd4\u0db8 \u0dbb\u0dcf\u0da2\u0dba \u0d96\u0dc2\u0db0 \u0dd3\u0db8\u0dad\u0dd2\u0dd0 \u0dc3\u0dcf\u0dc3\u0dbb\u0dae\u0dcf\u0dc0 \u0dba\u0dc0 \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0d87 .\n\n\u0dbd\u0db6\u0db8 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0daf \u0dc3\u0db3 \u0dcf \u0dc0\u0db8 \u0d96\u0dc2\u0db0 \u0d87\u0dab\u0dc0\u0dd4\u0db8 \u0d85\u0db4\u0dd2 \u0daf\u0dc0\u0daf\u0dba \u0dc3\u0db1\u0daf\u0dba\u0dd4\u0dca \u0d85\u0dcf\u0dc1\u0dba SPC \u0d91\u0d9a \u0dba\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0dba\u0dda \u0da2\u0db8\u0dc0\u0dcf\u0dba\u0db4 \u0db8\u0dcf\u0dc3\u0dba\u0dda 31\u0dc0\u0db1\u0db1\u0dd2 \u0daf\u0dcf \u0dba\u0dc0\u0db8\u0dba\u0d9a\u0dcf \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a \u0dcf. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0daf \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dc0\u0dad\u0dca\u0dc4 \u0d9a\u0dcf\u0dbd\u0dba\u0dca \u0dad\u0dd2\u0dba\u0db6\u0db8\u0dc0\u0dcf \u0d8a \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0daf \u0dc3\u0db3 \u0dcf \u0db8\u0dd2\u0dbd\u0daf\u0dd3 \u0dd0\u0db1\u0dd3\u0db8\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db8.\n\n\u0dba\u0db8\u0db8 \u0dc0\u0dc3\u0dba\u0dca \u0da2\u0db8\u0dc0\u0dcf\u0dba\u0db4 31 \u0daf\u0dd2\u0db8 \u0dc0\u0db8 \u0dd2\u0db0 \u0dbb\u0dcf\u0da2\u0dba \u0d96\u0dc2\u0db0 \u0dd3\u0db8\u0dad\u0dd2\u0dd0 \u0dc3\u0dcf\u0dc3\u0dbb\u0dae\u0dcf\u0dc0 \u0dba\u0dc0 \u0dbd\u0db1\u0db6\u0dd3 \u0dad\u0dd2\u0dd6 2026 \u0dc0\u0dca\u0dc2\u0dba\u0dda \u0d87\u0dab\u0dc0\u0dd4\u0dca \u0dc3\u0db3 \u0dcf \u0dba \u0db1\u0dca\u0da9\u0dca 113\u0dca -\u0d85\u0dba\u0dd2 \u0db8 117\u0dca \u0dc3\u0db3 \u0dcf- \u0dba\u0dca \u0dc0\u0db8 \u0dd2\u0db0 \u0d9a\u0db1\u0db3\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0d85 \u0dbb \u0dc3\u0dd2\u0dba\u0dd4\u0dad \u0dbd\u0dcf\u0dc3\u0dd4 \u0d9a\u0db1\u0db3\u0dd3\u0dca \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dbb \u0dbd\u0dcf\u0dc3\u0dd4 \u0d87\u0dd0 \u0d8b\u0dca \u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dc3\u0db3 \u0dcf \u0dbd\u0daf\u0dd2\u0dba\u0db4\u0daf\u0dad\u0dca\u0dc4 \u0d9a\u0dbb \u0d87 . \u0dba \u0db1\u0dca\u0da9\u0dca \u0d9a\u0db1\u0db3\u0dd3\u0dca 113\u0d9a\u0dd2\u0db1\u0dca 121\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dca\u0daf\u0dcf\u0daf\u0db8 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0 \u0dba\u0dc0 \u0dbd\u0daf\u0dd2\u0dba\u0db4\u0daf\u0dad\u0dca\u0dc4 \u0d9a\u0dbb \u0dad\u0dd2\u0dba\u0db6\u0dca\u0dbd. \u0dba\u0dca \u0dc0\u0db8 \u0dd2\u0db0 \u0dc3\u0db1\u0daf\u0dba\u0dd4\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dc0 \u0dba \u0db1\u0dca\u0da9\u0dca 1 \u0dca \u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0db8\u0dba \u0d9a\u0dbb \u0d87 . \u0dbd \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0dcf\u0dc3\u0dbb\u0d9a\u0dbb\u0dab \u0dba \u0dbb\u0dad\u0dd4\u0db8\u0dba\u0dc0\u0db1\u0dca 2026 \u0dc3\u0dca\u0dd6\u0dca\u0dab \u0dc0\u0dcf\u0dca\u0dd2\u0d9a \u0d85\u0dc0\u0dc1\u0dba \u0dcf \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0daf\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dba \u0dcf\u0dbb\u0dc0 \u0dc3\u0db1\u0daf \u0d8b\u0db8 \u0db6\u0dbd\u0dcf\u0dba\u0daf\u0dcf\u0dba\u0dbb\u0dcf\u0dad\u0dca\u0dc4\u0dad\u0dd4\u0db8 \u0dba\u0dda.\n\n\u0dbb\u0da2\u0dba\u0dda \u0d9c\u0dd2\u0dab\u0dd4\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dba\u0dda - COPA \u0d91\u0dba\u0dca - \u0dba \u0dc0\u0db1\u0db1\u0dd2 \u0dc0\u0dcf\u0dca \u0dcf\u0dba\u0dc0\u0dd2 \u0daf\u0dcf\u0dca\u0dd2\u0dba\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dbb\u0db8 \u0db8\u0dcf\u0dbd\u0dcf \u0d85\u0dcf\u0d9a 291 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dbd\u0dc3\u0dbb\u0db8\u0dad\u0dd4\u0db8 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0d85\u0db0\u0dba\u0dba\u0db8\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3 \u0dcf \u0daf\u0dcf\u0daf \u0db4\u0dd4\u0dda\u0dd0\u0dbd \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0dca \u0daf\u0dad\u0dca\u0dc4 \u0d9a\u0dbb\u0db8 \u0dbd\u0daf\u0dd3. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0dbb\u0da2\u0dba\u0dda \u0d9c\u0dd2\u0dab\u0dd4\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc0 \u0dd2\u0db0\u0dc3\u0dd2\u0db1\u0dca \u0db8\u0dad\u0dd4\u0db8 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0dd0\u0db1 \u0dd4\u0dad \u0dd2\u0db0\u0dc3\u0db3\u0dcf \u0dd0\u0db1\u0dd3\u0db8\u0db8 \u0dc3\u0db3 \u0dcf \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dba\u0db4\u0db1\u0dca \u0dbb\u0dcf\u0da2\u0d9a\u0dcf\u0dba\u0db4 \u0dc3 \u0dc0\u0dd0\u0d9a\u0dd3\u0dca \u0daf\u0dc0\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dbd \u0dc3\u0db3 \u0db1\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0dc0\u0dcf\u0dca \u0dcf\u0dc0 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dca\u0dba\u0dda\u0dc1 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0daf\u0dba\u0db4\u0dda\u0dba\u0daf\u0db1\u0dca \u0d9a\u0dcf\u0dca\u0dba\u0dca\u0dc2\u0db8 \u0dcf \u0dbd\u0dbd\u0daf\u0dcf \u0d8b \u0d96\u0dc2\u0db0 \u0dc3\u0db1\u0daf\u0dba\u0dd4\u0dca \u0daf\u0dcf\u0db8 \u0daf\u0dda\u0db0\u0dad\u0dd2\u0dba\u0dca \u0dc3\u0dbb\u0dae\u0dcf\u0db4\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dba\u0db1\u0dca \u0d91\u0db8 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0 \u0dd2\u0db0\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0dba \u0dba\u0d9a\u0da7\u0dd2\u0d9a\u0dcf\u0dbd\u0dd3\u0db8 \u0dcf \u0db8\u0db0\u0dba\u0d9a\u0dcf\u0dbd\u0dd3\u0db8 \u0dc0\u0db1\u0da9\u0dc3 \u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dcf\u0dca \u0dcf\u0dc0\u0dca \u0dbd\u0daf\u0dd2\u0dba\u0db4\u0daf\u0dad\u0dca\u0dc4 \u0d9a\u0dbb \u0d87 . \u0d91\u0dba\u0db8\u0db1\u0dca\u0db8 \u0dbd \u0dc3\u0db3 \u0db1\u0dca \u0dd2\u0db0\u0dda\u0dc0\u0dad\u0dca\u0dc4 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0 \u0dd2\u0db0\u0dc3\u0dd2\u0db1\u0dca \u0dba\u0dba \u0da2\u0db8\u0dcf \u0d9a\u0dbb\u0db8 \u0dbd\u0daf \u0db1\u0dd2\u0dca\u0dba\u0dda\u0dc1\u0dc0\u0dbd \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dd0\u0dad\u0dd2\u0dba \u0d85\u0dd3\u0dca\u0dc2\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0daf\u0dc3\u0dd4 \u0dd2\u0db0\u0daf\u0dbb\u0dca \u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dc3\u0dca\u0db6\u0db1\u0dca\u0dd3\u0d9a\u0dbb\u0dab\u0dba \u0dc3 \u0dc3\u0db1\u0daf\u0dba\u0dd4\u0dca\u0daf\u0dcf\u0db8\u0dba \u0d85\u0d9b\u0dca\u200d\u0dab\u0dca\u0da9\u0dc0 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0dc4\u0db8\u0d9a \u0dd3\u0db8 \u0dc3 \u0dad\u0dd2\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dba\u0db8 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0dc3\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dba\u0db1\u0dca \u0dba\u0db8\u0dba \u0dba\u0dd4\u0dca \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0dca \u0daf\u0dad\u0dca\u0dc4 \u0d9a\u0dbb\u0db8 \u0dbd\u0daf\u0dd3."
