0\u0db1\u0d9c \u0db1\u0dca \u0d9a\u0dc0\u0d9c\u0dda\u0daf; (ii) \u0d9c\u0d9a\u0ddc\u0db4\u0d9c\u0db4\u0ddc\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dc1\u0d9c\u0dd3\u0dba \u0d9c\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9c\u0d9a\u0ddc\u0da7\u0dca\u0db0\u0dc1\u0dc3\u0d9c\u0d86 \u0d87\u0dad\u0dd2 \u0d9c\u0daf\u0db1\u0dd2 \u0dc1 \u0db8\u0dd6\u0dd2\u0db1\u0d9a \u0d9c\u0dbb\u0ddd\u0dc4\u0dbd \u0dc0\u0dda\u0dc2 100\u0d9a\u0db4 \u0dc0\u0da9\u0dc1 \u0db4\u0dd0\u0dbb\u0dd0\u0dab\u0dd2 \u0d9c\u0dbb\u0ddd\u0dc4\u0dbd\u0d9a\u0dca \u0db6\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0d9c\u0db1\u0dca\u0daf; (iii) \u0d91\u0db8 \u0d9c\u0dbb\u0ddd\u0dc4\u0dbd \u0d9c\u0db8\u0dca \u0dc0\u0db1 \u0dc0\u0dd2\u0db4 \u0db1\u0dc1 \u0dd1\u0d9c\u0db8\u0dca \u0dad\u0dda\u0da2\u0db1 \u0db4 \u0db8\u0dd4\u0dc4\u0dd4\u0dab \u0daf\u0dd3 \u0dd2\u0dad\u0dc1\u0db8 \u0db8\u0dc0\u0daf\u0dc1\u0db1\u0db8\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0d9a \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0db6\u0dc0 \u0daf\u0db1\u0dca\u0d9c\u0db1\u0dca\u0daf; (iv) \u0d91\u0d9c\u0dc3\u0dda \u0db1\u0db8\u0dca \u0d92 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dcf\u0d9c \u0db1\u0dca \u0d9c\u0d9c\u0db1 \u0d87\u0dad\u0dd2 \u0db4\u0dd2 \u0dc0\u0dbb \u0d9a\u0dc0\u0d9c\u0dda\u0daf;\n\n\u0db1\u0dca\u0db1 \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0d9c\u0db8\u0db8 \u0dc3 \u0dc1\u0dc0\u0db4 \u0daf\u0db1\u0dca\u0dc0\u0db1\u0dca\u0d9c\u0db1\u0dca\u0daf?\n\n(\u0d86) \u0d9c\u0db1\u0ddc\u0d91\u0d9c\u0dc3\u0dda \u0db1\u0db8\u0dca \u0d92 \u0db8\u0db1\u0dca\u0daf?\n\n\u0b9a\u0bc1\u0b95\u0bc6\u0bbe\u0ba4\u0bc6\u0bbe\u0bb0\u0bae\u0bcd \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bb5\u0b95\u0bc1\u0bc6\u0ba9 \u0b8a\u0b9f\u0b95 \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0bc6\u0bae\u0bb0\u0b95\u0bcd \u0b9a\u0b95\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe:"
