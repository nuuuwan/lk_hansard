    "chunk_text": "\u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba\u0d9a\u0dca \u0dba\u0dc4\u0dcf\u0db3\u0daf\u0dca\u200d\u0dba\u0d8b \u0db1\u0dbb\u0d9a\u0daf\u0dca\u200d\u0dba \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf \u0db8\u0db1\u0dd2\u0db1 \u0db1\u0dd2\u0dbb\u0dca\u0dae\u0dab\u0dcf\u0dba\u0d9a \u0d9c\u0dd0\u0db1 \u0d85\u0db4\u0dd2 \u0d9a\u0dbd\u0dcf\u0db4\u0db1\u0dcf \u0d9a\u0dbb\u0dbd\u0dba\u0dda\u0dcf \u0db6\u0dd0\u0dbd\u0dd4\u0dba\u0dc0\u0dcf\u0dad\u0dca \u0dc0\u0d8b \u0dba\u0db8\u0dca \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba \u0dca \u0dcf\u0db8 \u0dca\u0d9a\u0dca\u0dad\u0dd2\u0db8\u0dad\u0dca \u0dc0 \u0dc3\u0dc0\u0dae\u0dcf\u0dc0\u0dbb\u0dba\u0d9a\u0da7 \u0dba\u0d9c\u0db1 \u0d91\u0db1\u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0dc3\u0db8\u0dad\u0dca \u0dc0 \u0dba\u0dc0\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1 \u0db6\u0dc0 \u0db8\u0db8 \u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0dba\u0dc3\u0dc0\u0dbd\u0dba\u0dda\u0dcf\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dd28 \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba\u0dda \u0db6\u0dd2\u0db3 \u0dc0\u0dd0\u0da7\u0dd3\u0db8\u0d9a\u0dca \u0dc4\u0dbb\u0dc4\u0dcf \u0dba\u0db8\u0dca \u0dbb\u0da7 \u0dc0\u0dd0\u0dba\u0dda\u0dc0\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf \u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0dba\u0dc3\u0dc0\u0dbd\u0dba\u0dda\u0dcf \u0d9a\u0dbd\u0dcf\u0db4\u0db1\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca\u0d8b \u0d92\u0d9a \u0da7\u0dc1\u0dca\u200d \u0dba\u0dc0\u0db1\u0dca\u0dba\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd08 \u0d91\u0dba\u0dc4\u0db8 \u0dba\u0daf\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca \u0dba\u0dc0\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0d92\u0d9a \u0dba\u0dc0\u0db1\u0dca\u0dba \u0db1\u0dca \u0dba\u0d9a\u0dcf\u0dba\u0dc4\u0dcf\u0db8\u0daf\u0dca\u200d\u0dba? \u0d91\u0d9a\u0dca\u0dba\u0d9a\u0ddd\u0d8b \u0dba\u0dc1\u0dca\u0db4\u0dcf\u0dbd\u0dba\u0dda\u0db1 \u0d85\u0dc3\u0dc0\u0dae\u0dcf\u0dc0\u0dbb\u0db7\u0dcf\u0dc0\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dba\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd18 \u0d85\u0db4\u0dd2 \u0daf\u0dca\u200d\u0dba\u0dd0\u0d9a\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0d8b \u0d86\u0da9\u0dd4\u0d9a\u0da9\u0dd4 \u0dc0\u0dd0\u0dd2\u0dca\u0da0 \u0d86\u0d9a\u0dcf\u0dbb\u0dba8 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba\u0dda \u0d87\u0dad\u0dd2 \u0dc0\u0db1 \u0db4\u0dd3\u0da9\u0db1\u0dba \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0dd1 \u0d9a\u0dcf\u0dbd\u0dba\u0dda\u0dba\u0dda\u0daf\u0dd3 \u0d86\u0da9\u0dd4\u0d9a\u0da9\u0dd4 \u0dc0\u0dd0\u0da7\u0dd4\u0dab\u0dcf8 \u0d8a\u0dc5 \u0da7\u0d8b \u0dba\u0dc1\u0dca\u0db4\u0dcf\u0dbd\u0dba\u0dda\u0db1 \u0d85\u0dbb\u0dca\u0dae\u0db6\u0dd4\u0daf\u0dca\u200d\u0dba \u0db1\u0dd2\u0dc3\u0dcf \u0d86\u0da9\u0dd4\u0d9a\u0da9\u0dd4 \u0dc0\u0dd0\u0da7\u0dd4\u0dab\u0dcf8 \u0db8 \u0d9a \u0d87\u0dad\u0dd2\u0d8b 2001\u0daf\u0dd3 \u0d91\u0dc3\u0dc08\u0db6\u0dd38 \u0db1 \u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0d8b \u0da2\u0dd38\u0d91\u0dbd\u0dcf8 \u0db4\u0dd3\u0daf\u0dd2\u0dc3\u0dc0 \u0d87\u0dc0\u0dc5\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca 11\u0dba\u0daf\u0dca\u200d\u0dba\u0dba\u0db1\u0d9a\u0dca \u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0dba\u0dc3\u0dc0\u0dbd\u0dba\u0dda\u0dcf\u0dba \u0db4\u0dd0\u0dad\u0dca \u0dc0 \u0da7 \u0d86\u0db4\u0dd4 \u0db1\u0dd2\u0dc3\u0dcf \u0d91\u0dc0\u0d9a\u0da7 \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u0d86\u0da9\u0dd4\u0d9a\u0da9\u0dd4\u0dc0 \u0dc0\u0dd0\u0da7\u0dd4\u0dab\u0dd4 \u0db6\u0dc08 [\u0db6\u0dcf\u0dca\u200d\u0dcf \u0d9a\u0dd2\u0dd3\u0d9a\u0db8\u0d9a\u0dca] \u0d94\u0dda\u0d8b \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca 16\u0d9a\u0dca8 \u0db8\u0dd4\u0dd2\u0db1\u0dca\u0db8 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca 11\u0dba\u0daf\u0dca\u200d\u0dba\u0dba\u0db1\u0d9a\u0dca\n\n1741 1742\n\n[\u0d9c\u0dbb\u0dd4 \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0db1 \u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4 \u0dcf]\n\n2025 \u0d85\u0dba\u0d9c\u0ddd\u0dc3\u0dc0\u0dc0 07\n\n\u0dd4 \u0db8\u0dca\u0dd3\u0dc0\u0dbb\u0d9c\u0dba\u0d9a\u0dca (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b92\u0bb0\u0bc1\u0bb5\u0bb0\u0bcd) (An Hon. Member) \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0dba\u0db1\u0dca\u0d8b \u0dc0\u0dd0\u0dba\u0da7\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf8\n\n\u0dd4 \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dc3\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b85\u0ba8\u0bc1\u0bb0 \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0ba4\u0bbf\u0bb8\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95) (The Hon. Anura Kumara Dissanayaka) \u0db1\u0dd0\u0dc4\u0dd0\u0d8b \u0db1\u0dd0\u0dc4\u0dd08 \u0d9a\u0dc0\u0dd4\u0daf\u0dca\u200d\u0dba \u0daf\u0dca\u200d\u0dba\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0daf\u0dca\u200d\u0dba \u0dba\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dba\u0db1\u0dca? \u0d91\u0dba\u0dc4\u0db8 \u0db1\u0db8\u0dca \u0dba\u0daf\u0dca\u200d\u0dba\u0dc3\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca\u0dae\u0dc0\u0dbd\u0dba\u0dda \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dba\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dba\u0db1\u0dca \u0dba\u0d9a\u0dcf\u0dba\u0dc4\u0dcf\u0db8\u0daf\u0dca\u200d\u0dba? \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dba\u0db1\u0dca \u0dba\u0dc0\u0db1 \u0d86\u0da9\u0dd4\u0d9a\u0da9\u0dd4\u0dc0\u0d9a\u0dca \u0dc4\u0daf\u0dca\u200d\u0dba\u0dcf\u0dba\u0d9c\u0db1 \u0daf\u0dca\u200d\u0dba? [\u0db6\u0dcf\u0dca\u200d\u0dcf \u0d9a\u0dd2\u0dd3\u0d9a\u0db8\u0d9a\u0dca] \u0db1\u0dd0\u0dc4\u0dd0\u0d8b \u0db1\u0dd0\u0dc4\u0dd0\u0d8b \u0db8\u0db8 \u0dba\u0db8\u0dca \u0d85\u0dc4\u0db1\u0dca\u0dba\u0db1\u0dca \u0d91 \u0dba\u0d9a\u0dcf\u0da7 \u0dba\u0daf\u0dca\u200d\u0dba\u0dc3\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca\u0dae\u0dc0\u0dbd\u0dba\u0dda \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dba\u0dc0\u0db1\u0dca\u0dba\u0db1\u0dca \u0dba\u0dc0\u0db1 \u0d86\u0da9\u0dd4\u0d9a\u0da9\u0dd4\u0dc0\u0d9a \u0dba\u0d9a\u0dba\u0db1\u0d9a\u0dca\u0daf\u0dca\u200d\u0dba? [\u0db6\u0dcf\u0dca\u200d\u0dcf \u0d9a\u0dd2\u0dd3\u0d9a\u0db8\u0d9a\u0dca]"
  },
