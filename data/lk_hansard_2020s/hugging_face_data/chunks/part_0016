dd2 \u0dc4\u0dba\u0dd4\u0dad\u0dd4\u0dc4\u0db4\u0dca\u200d\u0dbb\u0db8\u0dc3\u0daf\u0dab \u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0d91 \u0dc4\u0dca\u0dca\u0dad \u0dd0\u0dbb\u0dc4 \u0dcf\u0dc0\u0daf.\u0dc4\u0d87\u0dba\u0dd2?\u0dc4\u0d91 \u0daf\u0db4\u0dc4:\u0dd0\u0dda \u0dcf\u0dcf\u0dc0\u0daf\u0dc4\u0dc3\u0dcf\u0db8\u0dc3\u0daf\u0db1\u0dc4\u0dd2\u0d9a\u0dc2\u0db8\u0dc3\u0dcf\u0daf\u0dc0\u0d9a\u0dca\u0d9a\u0dba.\u0dc4\u0dda \u0dad\u0dde\u0daf\u0dca\u0dca\u0dbd\u0dd2\u0dda\u0dc4\u0dca\u0dc4\u0dba\u0dda \u0dc4 \u0dd0\u0dd4 \u0dab\u0dd4\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf\u0dc4\u0d86 \u0dcf\u0dcf\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc0\u0daf.\u0dc4\u0d92\u0dc4\u0d86 \u0dcf\u0dcf\u0dc4\u0d91\u0d9a\u0dca\u0d9a\u0dba\u0dda\u0dc4\u0d91 \u0daf\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf \u0dc4\u0dbd\u0db1\u0dcf\u0dc4\u0d86 \u0dcf\u0dcf \u0dc4\u0dc3\u0dcf\u0dc4\u0dc3\u0dcf\u0dca\u0db0:\u0dcf \u0db4\u0dc4\u0dbd\u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dda \u0dc0\u0dcf\u0dc0\u0daf.\u0dc4\u0dcf\u0db8\u0dc3\u0dca\u0db0\u0dc4\u0d91\u0d9a\u0dca\u0d9a\u0dba\u0dda\u0db8\u0dc3\u0dc4\u0d91\u0dda\u0db4\u0dc4\u0dc4\u0d89\u0dda \u0dca\u0dcf\u0dc4\u0dca\u0dca\u0dad\u0dc4:\u0dd4\u0dc0\u0dc0\u0dca\u0db0\u0dc4\u0d89\u0dca\u0db0\u0dcf\u0dc0\u0daf\u0dc4\u0dd2\u0d9a\u0dba\u0dca\u0dc0\u0dd2\u0d9a:\u0dba\u0daf\u0dbd\u0dda .\u0dc4\u0d92\u0dc4\u0dca \u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf \u0dc4 :\u0daf\u0dbb\u0dcf\u0dc4\u0dad\u0dbb\u0dd2\u0dc3\u0dcf\u0dbb \u0dba\u0dd2 \u0dc4\u0dda \u0db8\u0dc3\u0ddc\u0dd4\u0d9f\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf \u0dc4 :\u0daf\u0dbb\u0dcf\u0dc4\u0dad\u0dbb\u0dd2\u0dc3\u0dcf\u0dbb \u0dba\u0dd2\u0dc4\u0dc3\u0dcf\u0dc4\u0dc3\u0dcf\u0dca\u0db0:\u0dcf \u0db4\u0dc4\u0db7\u0daf\u0db1\u0dcf\u0dc4\u0dda \u0dc0\u0dcf\u0dc0\u0daf.\u0dc4\u0d91\u0dcf\u0dda \u0dda\u0ddc\u0db4\u0dc4\u0dda \u0db8\u0dc3 \u0daf\u0db4\u0dc4:\u0dd0\u0dda \u0dcf\u0dcf\u0dc0\u0daf\u0dc4\u0db8\u0dc3\u0db8\u0dc3\u0dc4\u0dc3\u0dd6\u0db4\u0dd2\u0dca\u0db0 \u0dc4\u0db8\u0dc3\u0db8\u0dc3\u0dc4\u0dda \u0dca\u0dad\u0dd4\u0dc0\u0dab\u0dd4\u0dc4\u0dda \u0dda\u0dda \u0dcf\u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0d9a\u0dd2 \u0dbd\u0daf.\u0dc4\u0dc0\u0dad\u0dca\u0dad\u0dd3\u0dbb \u0dc4\u0dd4 \u0dd4\u0d9f\u0dab\u0dd4\u0dc4\u0db8\u0dc3\u0dba\u0dba\u0dc3\u0dcf\u0dca\u0dae\u0daf\u0dcf\u0dc4\u0d9a\u0dd2 \u0dca\u0db0\u0dda \u0dca\u0db0\u0dc4\u0dda \u0dca\u0dad\u0dd4\u0dc0\u0dab\u0dd4\u0dc4\u0dc4\u0dca \u0db4\u0dc4-\u0dc4\u0dca\u0dbb\u0dc4\u0dc3\u0dd6\u0db4\u0dd2\u0dca\u0db0\u0dc4\u0dda \u0dbd\u0dc3\u0dcf\u0dc4\u0dda \u0dcf\u0ddd\u0dbb\u0daf\u0dc4\u0dca\u0dba\u0dd2\u0dca\u0db0\u0dc4\u0dda\u0dbb\u0dcf\u0dc4\u0dca \u0db4\u0dc4-\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc4\u0db8\u0dc3\u0dba\u0dba\u0dc3\u0dcf\u0dca\u0dae\u0daf\u0dcf\u0dc4\u0dda \u0dcf\u0ddc\u0dda \u0dc0\u0dba\u0dd2.\u0dc4\u0dca:\u0dc4\u0dd2\u0d82\u0daf\u0dca\u0dba\u0dc4\u0dda \u0dc0\u0dbd\u0daf\u0dc4\u0dd2 \u0dda \u0db1\u0dca\u0db0\u0dda \u0dca\u0db0\u0dc4\u0dda \u0db8\u0dc3\u0ddc\u0dda\u0d9a\u0dca\u0d9a\u0dba:?\u0dc4\u0dca:\u0dc4\u0dda \u0dca\u0db6\u0dc4\u0dc0\u0dad\u0dca\u0dad\u0dd3\u0dbb \u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf\u0dc4\u0db8\u0dc3\u0dba\u0dba\u0dc3\u0dcf\u0dca\u0dae\u0daf\u0dcf\u0dc4\u0d9a\u0dd2 \u0dcf\u0dc4\u0d92\u0dc0\u0daf\u0dc4 \u0dd0\u0dbd\u0dd2\u0da0\u0dca\u0da0\u0dc4\u0dca \u0db4\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc4\u0dcf\u0dd0\u0dcf\u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dda \u0dc0\u0dbd\u0daf.\u0dc4Medical faculty \u0dca\u0db0\u0dcf\u0dc4\u0db1\u0dd0\u0dbb\u0dd2\u0dc4\u0dc0\u0dd4\u0dab\u0daf \u0dc4engineering faculty \u0dca\u0db0\u0dcf\u0dc4\u0db1\u0dd0\u0dbb\u0dd2\u0dc4\u0dc0\u0dd4\u0dab\u0daf \u0dc4\u0db4\u0dd2\u0db4\u0dc4\u0dbb\u0db4\u0dc4 \u0dca\u0db0\u0dcf\u0dc4\u0db1\u0dd0\u0dbb\u0dd2\u0dc4\u0dc0\u0dd4\u0dab\u0daf \u0dc4\u0dda \u0dad\u0dde\u0daf\u0dca\u0dca\u0dbd\u0dd2\u0dda\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf \u0db4\u0dc4 \u0dca\u0db0\u0dcf\u0dc4\u0db1\u0dd0\u0dbb\u0dd2\u0dc4\u0dc0\u0dd4\u0dab\u0daf \u0dc4\u0d89\u0dd2 \u0dca\u0db0\u0dc4Technical College \u0d91\u0dda\u0dda\u0db4\u0dc0\u0dca\u0dad\u0dc4\u0d9c\u0dd2\u0dd2\u0da7\u0dca\u0db0\u0dc4\u0db1\u0dbd\u0db8\u0dd4\u0dc4\u0d9a\u0dd2 \u0dbd\u0daf\u0dc4\u0dd2\u0da7\u0dcf\u0dcf\u0dc0\u0daf.\u0dc4\u0d92\u0dda\u0dc4 \u0dd0\u0dbd\u0dd2\u0da0\u0dca\u0da0\u0dc4\u0dca \u0db4\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf \u0d9a\u0dca\u0d9a\u0dba.\u0dc4\u0dca\u0dda \u0dca\u0dc4\u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dad\u0dca\u0dad\u0dd2 \u0dc4\u0dca\u0db1\u0dd4\u0dc0\u0dc4\u0d92\u0dda\u0dc4\u0dda \u0dca\u0dad\u0dd4\u0dc0\u0dab\u0dd4\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf \u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dda \u0dcf\u0ddc\u0dda \u0dc0\u0dba\u0dd2 \u0dc4\u0d92\u0dda\u0dc4\u0db8\u0dd6\u0dbd\u0dd2\u0dda\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf \u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dd2\u0d9a \u0dc4\u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2.\u0dc4\u0dda \u0dca\u0db6\u0dc4\u0dad\u0daf\u0dda \u0dca\u0dad\u0db8\u0dc3\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc4\u0dc3\u0dcf\u0dca\u0db0\u0dd2\u0db4\u0dc3\u0dcf\u0dca\u0dae\u0daf\u0dcf \u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dcf\u0db8\u0dc3\u0dba\u0dd2\u0dc4\u0dc0\u0dad\u0dca\u0dad\u0dd3\u0dbb\u0db8\u0dc3 \u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf\u0dc4\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0dc2\u0dbb\u0dad\u0dca\u200d\u0dbb .\u0dc4\u0dc4\u0dc4\u0dc4\u0dc4\u0dc4\u0dc4\u0dc4\u0dc4\u0dc4\u0dc4"
  },
