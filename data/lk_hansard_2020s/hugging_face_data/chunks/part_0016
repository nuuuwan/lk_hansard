    "chunk_text": "\u0d9c\u0daf \u0d9c\u0dc5\u0dd2 \u0dc3\u0dcf \u0da0\u0dca\u0da1\u0dcf\u0dd9\u0da7 \u0d9c\u0db1\u0dca\u0dc0\u0db1\u0dca \u0dca\u0dc0\u0dba \u0da2\u0db1 \u200d\u0dbb\u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0db1 \u0dc3\u0dc4 \u0d9c\u0dc0\u0db1\u0dba \u0db1\u0dba \u0dd9\u0dc1\u0dc0\u0dba\u0db1\u0dca \u0dc3\u0dd4\u0dba\u0d9a\u0dca\u0dc2\u0dba\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0d9a\u0dc4\u0dcf \u0d9c\u0dc0\u0db4\u0dca \u0dba\u0da2\u0dba\u0dad\u0dca -\u0d9c\u0dc0\u0db4\u0dca \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dd9\u0dad\u0dca; \u0d9c\u0dc0\u0db4\u0dca \u0dba\u0da7\u0dad\u0dca- \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0d9c\u0dba\u0dcf\u0db6\u0dd2 \u0d91\u0db8\u0dd3\u0dbb\u0dca\u0dbd \u0dba\u0dcf\u0da2\u0dba\u0dba\u0dad\u0dca \u0d9c\u0dad\u0dba \u0d9c\u0dad\u0dca\u0dc3\u0db1\u0dca \u0dba\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd6 \u0d9c\u0dd2\u0dd2\u0dc3\u0dc3\u0dd4\u0db8 \u0dc5\u0dd2\u0db6\u0db3\u0dd9\u0d9a\u0dd9\u0dd2. \u0d9c\u0dc5\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dd9\u0dcf \u0dc0\u0db8\u0dc0\u0dad\u0d9a\u0dca \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dc0\u0d86 \u0d9c\u0dc0\u0db4\u0dca \u0dba\u0da7 \u0d9c\u0dd2\u0dd2\u0dc3\u0dc3\u0dd4\u0dda 09\u0d9a\u0dca \u0d9c\u0dad\u0dca\u0dc3\u0db1\u0dca \u0dba \u0dad\u0dd2\u0dc0\u0dd9\u0db1 \u0dd9\u0dd9. \u0d92 \u0dd2\u0db1\u0dba\u0dbd\u0dd4 \u0d9c\u0dd2\u0dd2\u0dc3\u0dc3\u0dd4\u0dda\u0dd9\u0dbd\u0da7 \u0dd9\u0da9\u0dcf \u0dd9\u0da9\u0dcf\u0dad\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0d9c\u0dcf\u0db8\u0dd3 \u0d9c\u0dd2\u0dd2\u0dc3\u0dc3\u0dd4\u0db8\u0d9a\u0dca \u0dad\u0db8\u0dd2 \u0d9c\u0db4 \u0dc0\u0dda \u0d9c\u0dad\u0dca\u0dc3\u0db1\u0dca \u0dba \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dca\u0dc0\u0db1\u0dca. \u0dd2\u0dc3\u0dc0\u0dc1\u0dae\u0dc2\u0dba\u0dc0\u0dba\u0db1\u0dca\u0db8 \u0dc0\u0dda \u0d9c\u0dd2\u0dd2\u0dc3\u0dc3\u0dd4\u0db8 \u0d87\u0dad\u0dd4\u0dc0\u0dc5\u0dae \u0d91 \u0db4\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0dba\u0dc3\u0dba \u0dca\u0dc0\u0dba \u0da2\u0db1 \u0dc5\u0dd2\u0db6\u0db3\u0dd9\u0d9a\u0dd9 \u0d9c\u0dc5\u0dd2 \u0dc3\u0dcf \u0da0\u0dca\u0da1\u0dcf \u0dba\u0db1\u0dd9\u0dcf. \u0dc0\u0dda \u0dc0\u0dbd \u0dc0\u0d86 \u0daf\u0dd2\u0dad\u0dd4\u0dab\u0dd4\u0db8 \u0dc3\u0dcf \u0dca \u0db4 \u0dc5\u0dd2\u0db6\u0db3\u0dd9\u0d9a\u0dd9 sustainable investments \u0d9c\u0dd0\u0db1 \u0d9c\u0dc5\u0dd2 \u0dc3\u0dcf \u0da0\u0dca\u0da1\u0dcf \u0dba\u0db1\u0dd9\u0dcf. \u0d92 \u0dd9\u0dcf\u0dc0\u0dda\u0db8 \u0dba\u0da7\u0dd9\u0dca \u0dc0\u0daf\u0dc0\u0d9a\u0dca \u0db4\u0dbb\u0dd2\u0dc3\u0dba\u0dba \u0d9c\u0dd0\u0db1\u0dad\u0dca \u0dcf\u0dcf \u0dba\u0db1\u0dd9\u0dcf. \u0d9c\u0dc5\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dd9\u0dcf \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dc0\u0d86 \u0dc0\u0db8\u0dc0\u0dad\u0d9a\u0dca \u0dc0\u0d9c\u0db1\u0dcf\u0db4\u0dd4 \u0dca\u0dc0\u0dba \u0da2\u0db1 \u0dc4\u0daf\u0db4\u0dd4 \u0dca\u0dc0\u0dba \u0da2\u0db1 \u0d9a\u0dd2\u0dd2\u0db1\u0daf\u0dd4 \u0dc0\u0dbd\u0dc3\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0dbb\u0dd2\u0dc3\u0dba\u0dba \u0d9c\u0dd0\u0db1 \u0d9c\u0db0\u0dba\u0dba\u0db1\u0dba\u0d9a\u0dca \u0dc0\u0db1\u0dcf \u0dba \u0dc0\u0d9c\u0db1\u0dcf\u0db4\u0dd4 \u0dca\u0dc0\u0dba \u0da2\u0db1 \u0dd9\u0dd9. \u0d9c\u0dc5\u0dd2 \u0d92 \u0d9c\u0dd0\u0db1 \u0dc3\u0dcf \u0da0\u0dca\u0da1\u0dcf \u0dba\u0db1\u0dd9\u0dcf \u0dc0\u0dda \u0d9c\u0dd2\u0dd2\u0dc3\u0dc3\u0dd4\u0db8 \u0d87\u0dad\u0dd4\u0dc0\u0dc5\u0dae. \u0d92 \u0dd2\u0dc3\u0dad\u0dba\u0d9a\u0dca \u0dc0\u0db1\u0dcf\u0dc0\u0dd9\u0dd2 \u0db8\u0dc4\u0da2\u0db1 \u0dca\u0dba\u0d9a\u0dca\u0dc2\u0dba\u0dcf\u0dd9 \u0d9c\u0dd0\u0db1 \u0db8\u0dc4\u0da2\u0db1 \u0dc3\u0daf\u0dcf\u0da0\u0dcf\u0dba\u0dba \u0d9c\u0dd0\u0db1 \u0d9c\u0dc5\u0dd2 \u0dc0\u0dda \u0dad\u0dd4\u0dc5 \u0dc3\u0dcf \u0da0\u0dca\u0da1\u0dcf \u0dba\u0db1\u0dd9\u0dcf. \u0d92 \u0dd9\u0dcf\u0dc0\u0dda\u0db8 \u0dc0\u0dda\u0dbb\u0dd4\u0dda \u0dba\u0dab\u0dba \u0d9c\u0dd0\u0db1 \u0d9c\u0dc5\u0dd2 \u0dc0\u0dda \u0d9c\u0dd2\u0dd2\u0dc3\u0dc3\u0dd4\u0db8 \u0d87\u0dad\u0dd4\u0dc0\u0dc5\u0dae \u0dc3\u0dcf \u0da0\u0dca\u0da1\u0dcf \u0dba\u0db1\u0dd9\u0dcf. \u0dca\u0dc0\u0dba \u0da2\u0db1\u0dd9\u0dbd\u0da7 \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dc0\u0d86 \u0d95\u0db1\u0dd1\u0db8 \u0dc0\u0daf\u0dba\u0d9a\u0dca \u0dba\u0db1\u0dca\u0db1 \u0db1\u0dd2\u0daf\u0dc4\u0dc3 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf. \u0db1\u0dd4\u0daf\u0dad\u0dca \u0d9c\u0dc5\u0dd2 \u0dc0\u0dda \u0d9c\u0dd2\u0dd2\u0dc3\u0dc3\u0dd4\u0db8 \u0d87\u0dad\u0dd4\u0dc0\u0dc5\u0dae \u0d92\u0dd9\u0dcf \u0dc3\u0dda\u0dd9\u0db1\u0dca\u0db0\u0dc0\u0dba\u0db1\u0dca \u0dd9\u0da9\u0dcf\u0dad\u0dca \u0dc0\u0dc4\u0dcf\u0db3\u0dd2\u0db1\u0dca \u0da7\u0dad\u0dd4\u0dad\u0dd4 \u0dba\u0db1\u0dca\u0db1 \u0d9c\u0dd9\u0dc1\u0dba \u0dba\u0db1 \u0db4\u0dbb\u0dd2\u0dc3\u0dba\u0dba \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0dab\u0dba \u0dba \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf.\n\n119 120\n\n[\u0d9c\u0dbb\u0dd4 \u0db1\u0dcf\u0db8\u0dca \u0dba\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db8\u0dc4\u0dad\u0dcf]\n\n2025 \u0dc3\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0dda\u0dd9\u0dbb\u0dca\u0dbd 2\n\n\u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0db1\u0dcf\u0db8\u0dca \u0db8\u0da7 \u0dcf\u0dba\u0dab\u0dba\u0d9a\u0dca \u0db8\u0dad\u0d9a\u0dca \u0dc0\u0dd9\u0db1\u0dd9\u0dcf. \u0dc3\u0dcf\u0dd2\u0dc3\u0db0\u0dcf\u0db1\u0dcf\u0dad\u0dca\u0db8 \u0d9c\u0db4\u0dba\u0dcf\u0db0 \u0dbb\u0dd4\u0dc0\u0dd9 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc0\u0db1\u0dca \u0db8\u0dcf \u0db3\u0dd4\u0dc0\u0dbb\u0dca\u0dbd \u0db8\u0db0\u0dd6\u0dc2\u0dba\u0dae\u0dbd\u0dcf \u0dc0\u0dc4 \u0dc0 \u0dc0\u0dc4\u0dca \u0dd9\u0dda\u0daf\u0dba \u0db4\u0dad\u0dca\u0dc0\u0dda\u0dbd\u0dcf \u0dc0\u0dc4 \u0dc0\u0db1\u0dcf\u0dc0\u0dd9\u0dd2. \u0d9c\u0daf \u0dc0\u0dc4\u0db6\u0db3\u0daf\u0dba \u0dc0\u0dd9\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf \u0d87\u0dad\u0dca\u0dad \u0dc3\u0dcf\u0dd2\u0dc3\u0db0\u0dcf\u0db1\u0dcf\u0dad\u0dca\u0db8 \u0d9c\u0db4\u0dba\u0dcf\u0db0 \u0dbb\u0dd4\u0dd9\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc0\u0db1\u0dca \u0dc0\u0dd4\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d92 \u0dc0\u0dd9\u0db1 \u0dc0\u0dd4\u0dbb\u0dd4\u0dd9\u0dad\u0dca \u0dc0\u0db1\u0dcf\u0dc0\u0dd9\u0dd2 \u0d94\u0dba\u0dc0\u0d9c\u0dcf\u0dca \u0dc0\u0dbd . \u0d92 \u0d9c\u0daf \u0dc0\u0dda \u0dba\u0da7\u0da7 \u0dc0\u0dc4\u0db6\u0db3\u0daf\u0dba \u0dc0\u0dd9\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. \u0dc4\u0dd0\u0dd9\u0dd0\u0dd2 \u0d9c\u0dc5\u0dd2 \u0dc0\u0dca \u0dd9\u0dca \u0d9c\u0dc4\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf \u0dc3\u0dcf\u0dd2\u0dc3\u0db0\u0dcf\u0db1\u0dcf\u0dad\u0dca\u0db8 \u0d9c\u0db4\u0dba\u0dcf\u0db0 \u0dbb\u0dd4\u0dc0\u0dd9 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc0\u0db1\u0dca \u0dc4\u0dba\u0d9a\u0dca \u0da7\u0dcf\u0dbd\u0dcf \u0dd4\u0da7\u0dca\u0dc0\u0da7\u0dbd\u0dcf \u0db8\u0dcf \u0db3\u0dd4\u0dc0\u0dbb\u0dca\u0dbd \u0db8\u0db0\u0dd6\u0dc2\u0dba\u0dae\u0dbd\u0dcf \u0d9c\u0dba\u0dc0\u0d9c\u0dcf\u0dca \u0dc0\u0dbd \u0dc0\u0dda\u0dc0\u0d9c\u0dcf\u0dca \u0dc0\u0dbd \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db1\u0dd4\u0daf\u0dad\u0dca \u0db1\u0dda \u0da7\u0dd2 \u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d91\u0dc0\u0dc4\u0db8 \u0dc0\u0dca \u0dd9\u0dca \u0d9c\u0dc4\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf\u0da7 \u0d87\u0dad\u0dca\u0dad \u0dc3\u0dcf\u0dd2\u0dc3\u0db0\u0dcf\u0db1\u0dcf\u0dad\u0dca\u0db8 \u0d9c\u0db4\u0dba\u0dcf\u0db0 \u0dbb\u0dd4\u0dc0\u0dd9 \u0dc0\u0dda\u0dc0\u0d9c\u0dcf\u0dca \u0dbd\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d91 \u0d9c\u0daf \u0dba\u0da7\u0da7 \u0dc3\u0db8\u0dcf\u0da2\u0dba\u0da7 \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0dc0\u0dd9\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf.\n\n\u0daf\u0dd0\u0db1\u0dca \u0d9c\u0dd2\u0dc3\u0dae \u0dc6\u0dd0\u0d9a\u0dca\u0da7\u0dbb\u0dd2\u0dba\u0d9a\u0dca \u0d9c\u0dd0\u0db1 \u0dcf\u0dcf \u0dc5\u0dcf. \u0d9c\u0dc5\u0dd2 \u0daf\u0dd0\u0d9a\u0dca \u0dcf \u0db8\u0dcf\u0db0\u0dba \u0dc3\u0dcf \u0da0\u0dca\u0da1\u0dcf \u0dad\u0dd2\u0dba\u0dbd\u0dcf\u0dad\u0dca \u0dc0 \u0db3\u0dd2\u0dbb\u0dd2 \u0d9c\u0dcf\u0db1\u0dd9\u0dcf. \u0daf\u0dd0\u0db1\u0dca \u0dc0\u0db8\u0dad\u0dd0\u0db1\u0dad\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0dc0\u0dda \u0dcf\u0dcf\u0dd9 \u0db4\u0dd4\u0dba\u0dcf\u0dd9\u0da7\u0db8 \u0dc0\u0dc5\u0dae \u0dc0 \u0db3\u0dd2\u0dbb\u0dd2 \u0d9c\u0dd1\u0dd2\u0dc3\u0dca \u0dbd\u0d9a\u0dca \u0dad\u0db8\u0dd2. \u0daf\u0dd0\u0db1\u0dca \u0dbd\u0dd9\u0dbd \u0dc0\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. \u0d9c\u0daf \u0d9c\u0dc5\u0dd2 \u0dd9\u0d9c\u0d9a\u0dd3\u0dc0\u0db8\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dd9\u0dcf \u0dc0\u0dda \u0dd2\u0db1\u0dba\u0dbd\u0dd4 \u0dc0\u0dda\u0dd9\u0dca \u0dc5\u0dd2\u0db6\u0db3\u0dd9\u0d9a \u0dd2\u0dc3\u0db8\u0dbb\u0dca\u0dbd\u0dc1\u0db1 \u0dd2\u0db1\u0daf\u0dd4 \u0dc0\u0dd9\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0daf\u0dd4\u0dba \u0dcf\u0db1 \u0dc0 \u0dbd\u0dd4\u0db1\u0dd4 \u0dc4\u0dba\u0dc4\u0dcf \u0db4\u0dda\u0dc0\u0db8\u0dbd\u0dcf \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0dc0\u0dda \u0dca \u0dd2\u0dba \u0daf\u0dd4\u0dba \u0dcf\u0db1 \u0d87\u0db8\u0dad\u0dd4\u0dda \u0daf\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dca \u0dcf\u0da7\u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d92 \u0dcf\u0dba\u0dab\u0dcf \u0d9c\u0dd0\u0db1 \u0dc0\u0dc3\u0dcf\u0dba\u0dcf \u0dd9\u0dbd\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. \u0d92\u0dc0\u0d9c\u0dcf\u0dca \u0dbd\u0db1\u0dca\u0dc0\u0dda \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dc0\u0d86 \u0dc3\u0dda\u0db4\u0dad\u0dca \u0db8\u0db1\u0dda\u0dc0\u0db4\u0dca\u0dbb\u0dd2 \u0d9c\u0daf \u0d9c\u0dad\u0dd4\u0dbb\u0dd4\u0daf\u0dc4\u0db1\u0dca. \u0d91\u0dba\u0dcf \u0d9c\u0dad\u0dd4\u0dbb\u0dd4\u0daf\u0dc4\u0db1\u0dca \u0dc0\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. \u0dc4\u0dd0\u0dd9\u0dd0\u0dd2 \u0d9c\u0dc5\u0dd2 \u0daf\u0dd0\u0d9a\u0dca \u0dcf \u0d91\u0dba\u0dcf\u0dc0\u0dda \u0db4\u0d9a\u0dca\u0dc2\u0dba"
  },
