u0d9a\u0d9c\u0dd9\u0dda0 \u0d92\u0d9a\u0db4 \u0d9c\u0dc4\u0dda\u0dad\u0dd4\u0dc0 \u0dad\u0db8\u0dba\u0dd2 \u0dc3\u0db8\u0dc1\u0da2\u0d9c\u0d86 \u0d9c\u0dbd\u0ddc\u0d9a\u0dd4 \u0dc0\u0dd2\u0d9c\u0dbb\u0ddd\u0dcf \u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd3\u0db80 \u0d92 \u0dc0\u0dc1\u0d9c\u0dda\u0db8 \u0dc0\u0dd2\u0dc0\u0dd2\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dc0\u0dd2\u0db1 \u0dc3\u0dbd\u0dca\u0dbd\u0dc0\u0d9d\u0db1 \u0d9a\u0dd9\u0dc1 \u0dd2\u0dbb \u0db1 \u0d9c \u0ddd\u0daf\u0db1\u0dc1 \u0d9c\u0db8\u0dca \u0db4\u0dd4\u0dd3\u0d9c\u0dbd \u0dc1\u0db4 \u0d91\u0dbd\u0dca\u0dbd \u0d9c\u0dc0\u0dbd\u0dc1 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dc10 \u0d91\u0dc0\u0db1\u0dca \u0db4\u0dd4\u0dd3\u0d9c\u0dbd\u0d9c \u0d9a\u0dca \u0d9c\u0dd0\u0db1 \u0dad\u0db8\u0dba\u0dd2 \u0db8\u0daf \u0db8\u0db4\u0dd2 \u0d9a\u0dae\u0dc1 \u0d9a\u0dbb\u0db1\u0dca\u0d9c\u0db1\u0dca0 \u0d9c\u0db8\u0db8 \u0db4\u0dd4\u0dd3\u0d9c\u0dbd \u0dc1 \u0dd2\u0dc0\u0dad\u0dca \u0dd2\u0dbb\u0dd3\u0db8\u0db4 \u0db8\u0daf\u0dc1\u0dd9 \u0d9c\u0db8\u0db8 \u0dc0\u0dd2\u0dc0\u0dc1\u0daf \u0dc3\u0dd2\u0dd3\u0dcf \u0d9c\u0dc0\u0db1\u0dca\u0d9c\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0da2\u0dc1\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dc1\u0daf\u0dd3 \u0dbb\u0dc1\u0db8\u0dd4\u0dc0 \u0dad\u0dd4\u0dd9\u0dba\u0dd20 \u0d92 \u0db1\u0dd2\u0dc3\u0dc1 \u0db8\u0db4\u0dd2 \u0dc3\u0dd2 \u0dbd\u0dd4\u0d9c\u0daf\u0db1\u0dc1\u0d9c\u0d9c\u0db1\u0dca\u0db8 \u0dd2\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0d9c\u0db1\u0dca \u0d9c\u0db8\u0dca \u0d9a\u0dc1\u0dda \u0dc1\u0dbb \u0db4 \u0db8\u0db4\u0dd2\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dcf \u0d9c\u0dc0\u0dbd\u0dc1 \u0daf\u0dc1 \u0d9a\u0dad\u0dca\u0dc0 \u0dbd\u0db6\u0dc1 \u0d9c\u0daf\u0db1\u0dca\u0db1 \u0dd2\u0dbb \u0dbd\u0dc1\u0dba\u0dd20\n\n1345 1346\n\n\u0db4\u0dc1\u0dda\u0dd2\u0db1\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0dbd\u0dc0\u0d9a\u0dc1\u0dc0 \u0db4\u0dd4\u0dbb\u0dc1\u0db8 \u0dc0\u0dba\u0dc1\u0db4\u0dca\u0dad \u0dc0\u0dd4\u0d9c\u0da9\u