    "chunk_text": "\u0d8a\u0dc5 \u0da7 \u0dca\u200d\u0dbb\u0dca\u200d\u0dcf\u0db1 \u0dc0\u0dca\u0dba\u0dba\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dba \u0dcf\u0dad\u0dca \u0dc0\u0d8b \u0dba\u0db8\u0dca \u0dc4\u0dcf \u0dc3\u0db8\u0dcf\u0db1\u0dc0\u0db8 \u0d85\u0db4\u0dd2 \u0d86\u0dba\u0dba\u0ddd\u0da2\u0db1 \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0dba\u0dda\u0dba \u0dc4\u0dbb\u0dc4\u0dcf \u0dba\u0dc1\u0dd3\u0dba\u0dba \u0d86\u0dba\u0dba\u0ddd\u0da2\u0db1\u0dad\u0dca \u0dc0 \u0dc0\u0dd0\u0da9\u0dd2\u0d9a\u0dbb\u0dba\u0d9c\u0db1 \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba\u0dba\u0dba\u0db1\u0dca \u0d9c\u0dd2\u0dba \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0daf\u0dca\u200d\u0dba\u0da7 \u0dc3\u0dcf\u0dba\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dc0 \u0dba\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0dba\u0dc1 \u0da7\u0dba\u0dba\u0da7 18\u0d9a \u0dba\u0dc1\u0dd3\u0dba\u0dba \u0d86\u0dba\u0dba\u0ddd\u0da2\u0db1 \u0dc0\u0dd0\u0da9\u0dd2 \u0dba\u0dc0\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0d8b \u0d86 \u0dba\u0dba\u0ddd\u0da2\u0db1 \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0dba\u0dda\u0dba - BoI - \u0dc4\u0dbb\u0dc4\u0dcf8 \u0d91 \u0dba\u0d9a\u0dcf\u0da7 \u0d86\u0dba\u0dba\u0ddd\u0da2\u0db1 \u0dc0\u0dd0\u0da9\u0dd2 \u0dba\u0dc0\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0d92\u0dba\u0d9a\u0db1\u0dca \u0db8\u0dba\u0dd2 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0db1\u0dd2\u0dbb\u0dca\u0dae\u0db8\u0dcf\u0dab\u0dba \u0dba\u0dc0\u0db1\u0dca\u0dba\u0db1\u0dca\u0d8b \u0d92\u0dba\u0d9a\u0db1\u0dca \u0db8\u0dba\u0dd2 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba\u0dda \u0dc0\u0dbb\u0dca\u0dae\u0dca\u200d\u0db1\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dba\u0dc0\u0db1\u0dca\u0dba\u0db1\u0dca8 \u0d85\u0dba\u0db4\u0dca \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba\u0dda \u0dba\u0da9\u0dcf\u0dbd\u0dba\u0dda\u0dbb\u0dca\u0dae\u0d8b \u0dc0\u0dd2\u0dba\u0dc1\u0dca \u0dc0\u0dd2\u0db1\u0dd2\u0db8\u0dba\u0d8b \u0d8d \u0dc0 \u0dc0\u0dd2\u0dba\u0dc1\u0dca \u0d86\u0dba\u0dba\u0ddd\u0da2\u0db1\u0d8b \u0dc3\u0d82\u0d9a\u0dca\u200d\u0dbb\u0dcf\u0db8\u0d8b \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0d9a\u0dbb\u0dca\u0dae\u0db8\u0dcf\u0db1\u0dca \u0dba\u0d8b \u0d85\u0db4\u0db1\u0dba\u0db1 \u0d86\u0daf\u0dca\u200d\u0dba\u0dcf\u0dba\u0db8 \u0d9a\u0dd2\u0dba\u0db1 \u0dba\u0db8\u0dca\n\n\u0da7\u0dba\u0dbd\u0dcf\u0dbd\u0dba\u0dda\u0dba\u0d9c\u0db1\u0dca\u0db8 \u0dbd\u0dba\u0dda\u0d82\u0d9a\u0dcf\u0dba\u0dda \u0dba\u0dc4\u0dcf\u0db3\u0db8 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0daf\u0dca\u200d\u0dba \u0db6\u0dc0\u0da7 \u0dba\u0db8\u0dba \u0db4\u0dad\u0dca \u0dc0 \u0dba\u0dc0\u0db1 \u0db6\u0dc0\u0da7 \u0dba\u0db8\u0dca \u0db8\u0dcf\u0dc3 \u0dc4\u0dba \u0dc3\u0d82\u0da5\u0dcf \u0daf\u0dd3\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0dba\u0db8\u0dca\u0d9a \u0dc0\u0dad\u0dca \u0dc0 \u0dc0\u0dbb\u0dca\u0dae\u0dca\u200d\u0db1\u0dba \u0dba\u0dc0\u0db1\u0dba\u0d9a\u0dcf\u0da7 \u0d86\u0db4\u0dc3\u0dc0\u0dc3\u0da7 \u0dba\u0db1\u0dca\u0dba\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0db6\u0dc0\u0d9a\u0dca \u0db8\u0db8 \u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0dba\u0dc3\u0dc0\u0dbd\u0dba\u0dda\u0dcf\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dd28\n\n\u0db8\u0dd1 \u0d9a\u0dcf\u0dbd\u0dba\u0dda\u0dba\u0dda \u0dbd\u0dba\u0dda\u0d82\u0d9a\u0dcf\u0dba\u0dda \u0db6 \u0dba\u0d9c\u0dd3\u0db8\u0dca \u0db8\u0d9c \u0dc4\u0dd0\u0dbb\u0db4\u0dd4 \u0dca\u200d\u0dbb\u0dca\u200d\u0dcf\u0db1\u0db8 \u0dba\u0daf\u0dca\u200d\u0dba\u0dc3\u0dd3\u0dba\u0dba\u0daf\u0dca\u200d\u0dba\u0db1\u0dcf\u0dba \u0dba\u0dbd\u0dcf\u0d9b\u0dca\u200d\u0db1\u0dba \u0db8\u0dcf \u0dc5 \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0db7\u0dba \u0dba\u0dc0\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf\u0d8b \u0d94\u0db6\u0dc0\u0db8\u0db1\u0dca\u0dbd\u0dba\u0dda\u0dcf\u0dba \u0dba\u0db8\u0dca \u0db8\u0dd4\u0dd4 \u0dab\u0dd4\u0dc0\u0dd2\u0db1\u0dca \u0d91\u0d9a \u0db1\u0db8\u0d9a\u0dca\u0dc0\u0dad\u0dca \u0dc0 \u0dba\u0db8\u0dca\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd08 \u0dba\u0dc0\u0db1 \u0db8\u0dd4\u0dd4 \u0dab\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf \u0db1\u0db8\u0dca \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf8 200 \u0d9c\u0dcf\u0dab\u0d9a\u0dca \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0d91\u0dc4\u0dd2 \u0dc3\u0db8\u0dc3\u0dc0 \u0dc0\u0dd2\u0db1\u0dcf\u0d9a\u0db8 \u0db6\u0dd2\u0dd2\u0dba\u0db1 100\u0d9a\u0da7\u0d8b 150\u0d9a\u0da7 \u0d86\u0dc3\u0db1\u0dca\u0db1 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dba\u0dbd\u0dba\u0dda\u0d9a\u0dca8 \u0d85\u0db4\u0dd2 \u0d92\u0d9a \u0d85\u0dba \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd18 \u0d92\u0d9a \u0dc0\u0dd0\u0dbb\u0db1 \u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4\u0dc0\u0dad\u0dca \u0dc0 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf\u0daf\u0dca\u200d\u0dba?"
