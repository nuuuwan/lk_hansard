    "chunk_text": "\u0dca\u0dd4\u0dc0\u0dc4\u0da0\u0daf\u0dcf\u0dda\u0dc4\u0db8\u0dc3\u0daf\u0dd4 \u0dda \u0dca\u0ddc\u0da9\u0dc4\u0db8\u0dc3\u0dca\u0db0\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dc3\u0daf\u0dc4\u0d9a\u0dd2\u0dda\u0dc0\u0daf \u0dc4Credits \u0dca\u0dd0\u0dcf.\u0dc4\u0dda \u0db8\u0dc3\u0dd2\u0da7\u0dc4\u0db4\u0dca\u200d\u0dbb\u0dba\u0daf\u0dcf\u0dc4\u0dd2\u0d9a\u0dc2 \u0dca\u0db0\u0dc45\u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc0\u0daf.\u0dc4\u0d92\u0dc4\u0db4\u0dca\u200d\u0dbb\u0dba\u0daf\u0dcf\u0dc4\u0dd2\u0d9a\u0dc2 \u0dca\u0db0\u0dc45\u0dca\u0db0\u0dc4\u0dca\u0dab\u0dd2\u0dcf \u0dc4\u0dd2\u0d82\u0dc4 \u0dbd\u0dc4\u0db7\u0daf\u0dc2\u0daf\u0dc0\u0dc4\u0dc3\u0dcf \u0dc4\u0d89\u0dc4\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0dd2\u0d82\u0dc0\u0dbd\u0db4\u0dc4Credits 3\u0dba\u0dd2.\u0dc4\u0d86\u0dca\u0db8\u0dc3\u0dc4\u0dc3\u0dcf \u0dc4\u0dc3\u0dcf\u0daf\u0dbb\u0dba\u0dca\u0dad\u0db8\u0dc3\u0dc4\u0dca\u0dba\u0dba\u0daf\u0dad\u0dcf \u0db4\u0dc4Credits 2\u0dba\u0dd2.\u0dc4\u0d89\u0dd2 \u0daf\u0dc3\u0dcf \u0dc4\u0dc3\u0dcf \u0dc4\u0dda \u0dc3\u0dcf\u0dde\u0dca\u0db0:\u0dca\u0dad \u0dc4\u0dd2\u0d9a\u0dc2 \u0dca\u0db0\u0dc0\u0dbd\u0db4\u0dca\u0dad\u0dc4Credits 2\u0dc4\u0db1\u0dd0\u0d9c\u0dd2\u0dca\u0db0.\u0dc4\u0d89\u0dd2 \u0dca\u0db0\u0dc4\u0dda \u0dca\u0db6\u0dda \u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dda \u0dc0\u0dcf\u0dc3\u0dcf\u0dc4\u0dda \u0db8\u0dc3\u0ddc\u0dda\u0d9a\u0dca\u0d9a\u0dba:?\u0dc4\u0dca:\u0dca\u0dad\u0dc4\u0d91\u0dda \u0db8\u0dc3\u0dba\u0dd2.\u0dc4\u0dc4\u0dc0\u0dd0\u0dc3\u0dcf\u0dca\u0dc3\u0dcf\u0dda\u0db4\u0dc4\u0dda \u0ddd\u0dc4\u0dad\u0daf\u0dc3\u0dcf\u0dbd\u0db4\u0dc4\u0d9c\u0dd2 \u0dc4\u0d95\u0dcf\u0dd1\u0db8\u0dc3\u0dc4\u0dda \u0dda\u0dda \u0dcf\u0d9a\u0dca\u0d9a\u0dba\u0dc4:\u0dca\u0db0\u0dcf\u0dc0\u0daf\u0dc4\u0dca:\u0db4\u0dca\u0dad\u0dc4\u0dad\u0daf\u0dc3\u0dcf\u0dca \u0dc0\u0dbd\u0dc4timetables :\u0daf\u0dca\u0daf\u0dd3\u0dc4\u0d92\u0dc4\u0d92\u0dc4\u0dd2\u0d9a\u0dc2 \u0dca\u0db0\u0db4\u0dc4\u0dda \u0dc0\u0dca\u0db0\u0dc4\u0dda\u0dbb\u0dcf\u0dc4\u0dda\u0daf\u0dbd\u0da0\u0dca\u0dda \u0dda:\u0dc4\u0db4\u0dca\u200d\u0dbb\u0db8\u0dc3\u0daf\u0dab \u0dc4\u0dda \u0dc0\u0dcf\u0dc3\u0dcf\u0dca\u0dc4\u0dda \u0dc0\u0dcf\u0dc0\u0daf\u0dc4\u0d9a\u0dd2 \u0dbd\u0daf.\u0dc4\u0d92\u0dc4\u0dc0\u0daf\u0dda \u0db8\u0dc3\u0dc4\u0dcf\u0db8\u0dc3\u0dba\u0dd2\u0dc4\u0dda \u0dca\u0db6\u0dda \u0dda\u0dca\u0dad.\u0dc4\u0d92\u0dc4\u0d92\u0dc4\u0dd2\u0d9a\u0dc2 \u0dca\u0db0\u0dc4\u0dca\u0db1\u0dd4\u0dc0\u0dc4\u0db1\u0dbb\u0dc4\u0dcf\u0db1\u0dcf\u0dc4\u0db4\u0dca\u200d\u0dbb\u0db8\u0dc3\u0daf\u0dab \u0dca\u0db0\u0dc4\u0dda \u0dc0\u0dcf\u0dc3\u0dcf\u0dca\u0dc4\u0dda\u0dbb\u0dbd\u0daf\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc0\u0daf.\u0dc4\n\n\u0d92\u0dc4\u0dd2\u0d9a\u0dcf\u0dbb\u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dda \u0dcf\u0ddc\u0dda \u0dc0\u0dba\u0dd2 \u0dc4:\u0dd0\u0dca\u0db0\u0dc4\u0dba\u0dc0\u0dbd\u0dc4\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dda\u0daf\u0dc0\u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dca\u0dd0\u0dcf\u0dc4\u0d9a\u0dd2 \u0dcf\u0dc0\u0daf.\u0dc4\u0db8\u0dc3\u0db8\u0dc3\u0dc4:\u0dd0\u0d9a\u0dca\u0d9a\u0dba\u0dda\u0daf\u0dc4\u0dca\u0dda \u0dca\u0dc4\u0dd2\u0d9a\u0dad\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dc4\u0dcf\u0daf \u0dda\u0dad\u0dd4\u0db8\u0dc3\u0daf\u0dc4\u0d8a\u0dda \u0dc4\u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0dcf \u0d9a\u0dd4\u0dca\u0dad\u0dc4\u0d87\u0dd4\u0d9f\u0dc0\u0daf\u0dc4\u0dba\u0dc0\u0dbd\u0dc4\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dda\u0daf\u0dc0\u0dc4\u0dc4\u0dca\u0dd0\u0dcf.\u0dc4\u0db8\u0dc3\u0db8\u0dc3\u0dc4\u0dd2\u0da7\u0dcf\u0dcf\u0dc4\u0dd2\u0d9a\u0dd2\u0db4 \u0db4 \u0dc4\u0dca\u0dd4\u0dc0\u0dc4\u0db6\u0dd2\u0db8\u0dc3\u0dca \u0dc4\u0dbb\u0dca\u0dad\u0dcf\u0daf \u0dda\u0dc4\u0db8\u0dc3\u0dd0\u0dd2 \u0dad\u0dd4\u0db8\u0dc3\u0daf\u0dc4\u0dda \u0dca\u0db6\u0dc4\u0dba\u0dc0\u0dbd\u0dc4\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dda\u0daf\u0dc0\u0dc4\u0dca\u0dd0\u0dcf\u0dc4\u0d89\u0dd2 \u0daf\u0dc3\u0dcf \u0dca\u0dad\u0dc4\u0d91\u0d9a\u0dca\u0d9a\u0dba\u0dda\u0dc4\u0d89\u0dcf\u0daf\u0dc4\u0dad\u0dd0 \u0dd0\u0daf\u0dd2\u0dbd\u0dd2\u0dc0\u0dc4\u0d8a\u0dda \u0dc4\u0d9a\u0dd2 \u0dbd\u0daf\u0dc4\u0dd4 \u0dca\u0db0\u0dcf\u0daf.\u0dc4\u0dcf\u0db8\u0dd4\u0dca\u0dad\u0dc4\u0dcf\u0dc0\u0db8\u0dc3\u0dca\u0dad\u0dc4\u0d92\u0dc4\u0dda\u0daf\u0dbb\u0dab\u0dda \u0db8\u0dc3\u0dc4\u0d91\u0dca \u0dbd\u0dd2\u0dc4\u0d91\u0dca \u0dbd\u0dd3\u0dc4 \u0dcf\u0dc0\u0daf.\u0dc4\u0db8\u0dc3\u0db8\u0dc3\u0dc4\u0d86\u0dda \u0dca\u0dad\u0dc4\u0d9a\u0dd2 \u0dca\u0db0\u0dda \u0dca\u0db0\u0dc4\u0dda \u0dca\u0db6\u0dc4\u0db4\u0dd6\u0dca\u0dad\u0dc0\u0dc4\u0dc3\u0dcf\u0daf\u0dda\u0da0\u0dca\u0da1\u0daf\u0dc0\u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0d9a\u0dd2 \u0dcf\u0dc4\u0d91\u0dda\u0dba\u0dd2.\u0dc4\u0dda \u0dca\u0db6\u0dda \u0dda\u0dca\u0db0\u0dc4\u0dca\u0dcf\u0dad\u0dd4\u0dd4\u0dc0\u0dc0\u0dc4\u0dca\u0dad\u0db4\u0dc4\u0dc3\u0dcf\u0dc4\u0dda\u0dca \u0dad\u0dc4\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dda\u0daf\u0dc0\u0d9a\u0dca\u0d9a\u0dba\u0dc4-\u0dc4\u0d92\u0dda\u0dc4\u0dba\u0dc0\u0dbd\u0dc4: \u0dc4\u0dda\u0dc5\u0dd4\u0dc4: \u0dc4\u0dbb\u0dad\u0dd4\u0dc4: \u0dc4\u0dda \u0db8\u0dc3\u0ddc\u0dcf\u0dc4\u0dad\u0daf\u0db4\u0dc4:\u0dc4\u0d9a\u0dd2 \u0dbd\u0daf\u0dc4\u0dca\u0dad\u0db4\u0dc4\u0dad\u0daf\u0db4\u0d9a\u0dca\u0d9a\u0dba\u0dc4:\u0db8\u0dc3\u0daf\u0dca\u0dca\u0db0\u0dcf\u0dc4\u0dd4 \u0dc5\u0dd4\u0dc0\u0dca\u0db0-\u0dc4\u0dc4\u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dda \u0daf\u0dd3\u0dc4\u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dad\u0dca\u0dad\u0dc4\u0dda \u0dc0\u0dcf\u0dc0\u0daf.\u0dc4:\u0dd0\u0dcf\u0db4\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc4\u0dc3\u0dcf\u0dc4\u0dda\u0dca \u0dad \u0dc4\u0dca\u0db4\u0dd2\u0dc4\u0d89\u0dcf\u0daf\u0db8\u0dc3\u0dc4\u0dad\u0dd0 \u0dd0\u0daf\u0dd2\u0dbd\u0dd2\u0dc0\u0dc4\u0dc4PDF \u0d91\u0dda\u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0db8\u0dc3\u0d9f\u0dd2\u0dca\u0db0\u0dc4\u0dc3\u0dcf \u0dc4\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dd2\u0dcf\u0dc4\u0db4\u0dca\u200d\u0dbb\u0dda\u0daf\u0dba \u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0db8\u0dc3\u0d9f\u0dd2\u0dca\u0db0\u0dc4\u0dc4\u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dad\u0dca\u0dad\u0dc4\u0dda\u0dbb\u0dbd\u0daf\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc0\u0daf.\u0dc4\n\n\u0dca\u0dda \u0dcf\u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dda\u0daf\u0dbb\u0dab \u0dc4\u0dda \u0dca\u0db6\u0dda\u0dba\u0dd2.\u0dc4:\u0dd0\u0dca\u0db0\u0dc4full option :\u0dd4\u0dc0\u0dda \u0dc0\u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dcf\u0db8\u0dc3\u0dba\u0dd2\u0dc4 :\u0dca\u0db0\u0dda \u0dca\u0db0.\u0dc4\u0d92\u0dda\u0db4\u0dc4\u0dcf\u0db8\u0dc3\u0dba\u0dd2\u0dc4\u0dda \u0dca\u0db6\u0dc4\u0d8b\u0dca\u0dad\u0dc3\u0dcf\u0daf \u0dc4:\u0dbb\u0dca\u0db0\u0dda \u0dca\u0db0.\u0dc4\u0d92\u0dda\u0dc4\u0dda \u0dca\u0dad\u0dba \u0dc4\u0dad\u0daf\u0dbb\u0dda\u0dc4"
  },
