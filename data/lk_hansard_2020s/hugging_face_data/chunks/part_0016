    "chunk_text": "\u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0db1\u0dca\u0db4 \u0dc0\u0dd2\u0d9c\u0db1\u0ddd\u0dd9 \u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0d9c \u0db1 \u0dcf\u0dc0\u0dc3\u0dcf\u0dae\u0dcf\u0dc0 \u0dad\u0db8\u0dba\u0dd2 \u0dd9\u0dd0\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0d9a\u0dbb\u0dd9\u0dcf \u0dad\u0dd2\u0d9c \u0db1\u0dca\u0d9c\u0db1\u0dca. \u0d9c\u0db8\u0dca paramotoring \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9c\u0db1\u0dca \u0dad\u0dcf\u0dba\u0dd2\u0dd9\u0db1\u0dca\u0dad\u0d9c\u0dad \u0dc6\u0dd4\u0d9c\u0d9a\u0da7\u0dca\u0dc0\u0dd9\u0db4 \u0d9c\u0dd2 \u0d9c\u0dba \u0dad\u0dca \u0dc3\u0dad\u0dd4\u0da7\u0dd4 \u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0dad\u0dd2 \u0d9c \u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dcf\u0dc0 \u0dbd. \u0db8\u0db8 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dd9\u0dcf \u0dad\u0dd2\u0d9c \u0db1\u0dc0\u0dcf paramotors\u0dc0\u0dbd\u0dd2\u0db1\u0dca. \u0dc4\u0dd0 \u0dd0\u0dba\u0dd2 \u0dcf\u0dd9 \u0dad\u0dc4\u0db1\u0db8\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0d9c \u0db1\u0dc0\u0dcf. \u0dcf\u0dd9 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0d9c\u0dba\u0ddd \u0d9c\u0db8 \u0db1\u0dc0\u0dcf\u0dd9 \u0d9a\u0dbb\u0db1\u0dca\u0d9c\u0db1\u0dca? \u0d9c\u0db8\u0dca \u0dbb\u0db4\u0db4 \u0d86\u0d9c\u0dc0 \u0dad\u0dca \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0db1\u0dca\u0db4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9c\u0dd9\u0dba \u0dbd \u0db1\u0dd0\u0dc4\u0dd0. \u0dbb\u0dd1 10.00 \u0d9c\u0dc0\u0db1\u0d9c\u0d9a \u0db4 \u0dad\u0dd2\u0d9c \u0db1 \u0dda\u0dad\u0dca\u0dc3\u0dc0 beach parties, \u0dcf\u0dbb\u0dc0\u0dcf \u0d9c\u0db8\u0dca\u0dc0\u0dcf \u0d94 \u0dbd\u0d9c\u0d9a \u0db8 \u0db1\u0dad\u0dbb \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d91\u0d9a \u0db4\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0db1\u0dca \u0d9c\u0db8\u0dca \u0dbb\u0d9c\u0da7\u0dca \u0dd9\u0dc3\u0dcf\u0dc3\u0db1 \u0dc0\u0dd2\u0db3\u0dd2\u0db1\u0dc0\u0dcf \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0dbb\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0dcf\u0dd9\u0d9c\u0dad \u0dcf\u0dba\u0db4 \u0dc3\u0dad\u0dd4\u0da7\u0dd4 \u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0dcf\u0dc0\u0dba\u0dba \u0db4\u0db4\u0dad\u0dc3\u0dbb\u0dba\u0dad\u0dca \u0dcf\u0db4\u0dd2 \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d91\u0d9c\u0dc4\u0db8 \u0db4\u0db4\u0dad\u0dc3\u0dbb\u0dba \u0dbd \u0dcf\u0db4\u0dd2 \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0dba \u0d9a\u0dbb\u0dd9\u0dcf \u0db1\u0dd0\u0dc4\u0dd0.\n\n\u0db8\u0dd6\u0dd9\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dc0\u0dbb\u0dca\u0dad\u0db8\u0dcf\u0db1 \u0d86\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0d9c\u0db8\u0dca \u0dbb\u0d9c\u0da7\u0dca \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dbd\u0d9c\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dba \u0d91\u0d9c\u0dc4\u0db8 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0dcf\u0dd9 \u0d9c\u0d9c \u0da9\u0dcf \u0db1\u0d9f\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0d9c \u0db1\u0dca\u0d9c\u0db1\u0dca. \u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0db8\u0dca \u0d86\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0dcf\u0dd9 fail \u0d9c\u0dc0\u0dd9\u0dcf.\n\n\u0dcf\u0dd9 \u0dd9\u0db1\u0dca\u0db1 \u0d9c\u0d9c \u0dc0\u0dd2\u0d9c\u0dba\u0ddd \u0db8\u0dc4 \u0db4\u0dcf\u0d9c\u0dbb\u0dca; \u0dad\u0dd0\u0db4\u0dd0\u0dbd\u0dca \u0d9c\u0dc3\u0dda\u0dc0\u0d9a\u0d9c\u0dba\u0ddd \u0db8\u0dc4 \u0db4\u0dcf\u0d9c\u0dbb\u0dca; \u0dda\u0dad\u0dd4\u0d9c\u0dbb\u0dca \u0dc4\u0dbb\u0dca\u0dad\u0dcf\u0dbd\u0dca; \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4 \u0db8\u0dc4 \u0db4\u0dcf\u0d9c\u0dbb\u0dca. \u0d91\u0d9a \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dd9\u0d9c\u0dba \u0dbd \u0da2\u0db1\u0dcf\u0d9a\u0dbb\u0db4\u0dad\u0dd2 \u0d9c\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dd9\u0dba \u0dcf\u0dc3\u0dd9 \u0dad\u0dd2\u0d9c \u0db1 \u0dd9\u0dba\u0dd2\u0da7\u0dca \u0d9a\u0dab\u0dd4\u0dc0\u0d9a \u0db1\u0dd0\u0d9f\u0dd9\u0dcf \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0db8\u0db8 \u0d8a\u0d9c\u0dad \u0dd9\u0dd0 \u0dbd\u0d9a\u0dcf. \u0d8a\u0d9c\u0dad\u0dad\u0dca \u0db8\u0db8 \u0dd9\u0dd0 \u0dbd\u0d9a\u0dcf \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0da2\u0db1\u0dcf\u0d9a\u0dbb\u0db4\u0dad\u0dd2 \u0d9c\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dd9\u0dba \u0d89\u0dc3\u0dcf\u0dc3\u0dbb\u0dc4\u0dcf \u0dda\u0daf\u0dca\u0d9c\u0db1\u0ddd\u0dab \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0db8\u0dd3\u0db4 \u0dc3\u0dad\u0dd2\u0dba\u0d9a\u0db4 \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0dcf\u0db4\u0dd2 \u0dd9\u0dd0 \u0dbd\u0d9a\u0dcf \u0dda\u0dad\u0dd4\u0d9c\u0dbb\u0dca \u0dad\u0dbb\u0dd4\u0dab \u0db4\u0dd2\u0db4\u0dad\u0dc3\u0dcf \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dd9\u0dcf \u0d89\u0da9\u0dcf \u0db8\u0dca \u0dca\u200d\u0dbb\u0dba\u0dcf\u0db1\u0dba\u0d9a\u0db4 \u0da2\u0db1\u0dcf\u0d9a\u0dbb\u0db4\u0dad\u0dd2 \u0d9c\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dd9\u0dba \u0d89\u0daf\u0dd2\u0db4\u0dad\u0db4\u0dd2\u0db4 \u0dda\u0daf\u0dca\u0d9c\u0db1\u0ddd\u0dc2\u0dca\u0da8\u0dab \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d91\u0dd9\u0dcf \u0d9c\u0d9c\u0ddd\u0db0\u0dcf\u0db7\u0dba \u0dbb\u0dcf\u0da2\u0db4 \u0dbd\u0dc2\u0dca\u0da8 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dba\u0dcf \u0da2\u0db1\u0dcf\u0d9a\u0dbb\u0db4\u0dad\u0dd2 \u0d9c\u0dc0\u0dd9\u0dcf \u0dcf\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0dd9 \u0dbd \u0d91\u0d9a\u0dc4\u0db8\u0dcf\u0dbb \u0dbd \u0d9c\u0dad \u0dc0\u0dd4\u0dab\u0dcf \u0da2\u0db1\u0dcf\u0d9a\u0dbb\u0db4\u0dad\u0dd2 \u0d9c\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dd9\u0dba \u0d89\u0dc3\u0dcf\u0dc3\u0dbb\u0dc4\u0db4 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dd9\u0dcf \u0dda\u0daf\u0dca\u0d9c\u0db1\u0ddd\u0dc2\u0dca\u0da8\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d9c\u0db8\u0dca \u0d86\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0dd9\u0dba\u0db4 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dd9\u0dcf \u0dcf\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0dd9 \u0dbd \u0dba\u0db1\u0dca\u0db1 \u0d9a\u0dbd\u0dd2\u0db1\u0dca\u0db8 \u0d9c\u0db8\u0dca \u0dbb\u0d9c\u0da7\u0dca \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d9c\u0daf\u0dca\u0dba\u0db4\u0dcf\u0dd9\u0db1 \u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d9c\u0dad \u0dbb\u0dc0 \u0dcf\u0dd9 \u0db4\u0dcf\u0dbb\u0db4 \u0dd0\u0dc4\u0dd0\u0dd9\u0dcf \u0da2\u0db1\u0dcf\u0d9a\u0dbb\u0db4\u0dad\u0dd2 \u0d9c\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dd9\u0dba \u0d89\u0daf\u0dd2\u0db4\u0dad\u0db4\u0dd2\u0db4\u0db4 \u0d91\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0db4 \u0db4\u0dad\u0dca \u0d9c\u0dc0\u0dd9\u0dcf \u0dad\u0dd2\u0d9c \u0db1\u0dc0\u0dcf. \u0d9c\u0dba\u0dde\u0dc0\u0db1 \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dd9 \u0dad\u0dbb\u0dd4\u0dab \u0dad\u0dbb\u0dd4\u0dab\u0dd2\u0d9c\u0dba\u0ddd \u0dcf\u0dd9 \u0db4\u0dcf\u0d9c\u0dbb\u0dca. \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0dd9 \u0db8\u0da9\u0dd4\u0da9\u0dcf \u0dd9\u0d9c\u0dad \u0db1\u0dd2\u0dd9\u0db1\u0dcf\u0db4\u0dad\u0db1\u0dca \u0dcf\u0dd9 \u0db4\u0dcf\u0d9c\u0dbb\u0dca. \u0d9c\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0dbd\u0d9c\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0d9c\u0dad \u0db1\u0dd2\u0dd9\u0db1\u0dcf\u0db4\u0dad\u0db1\u0dca \u0dcf\u0dd9 \u0db4\u0dcf\u0d9c\u0dbb\u0dca.\n\n\u0db8\u0dd6\u0dd9\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dcf\u0dd9 \u0d9c\u0db8\u0dca \u0d86\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1 \u0d9c\u0d9a \u0db4 \u0d9c \u0d9c\u0dc4 \u0db8 \u0dda\u0da2\u0dcf\u0dbb\u0dd4\u0d9c\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0db8\u0db8 \u0dd9\u0dd0 \u0dbd\u0d9a\u0dcf \u0dbb\u0da2\u0d9c\u0dad \u0d86\u0dd9\u0dcf\u0dba\u0db8 \u0dc0\u0dd0\u0da9\u0dd2 \u0d9c\u0dc0\u0dd9\u0dcf \u0dad\u0dd2\u0d9c \u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dd9\u0dcf. \u0dbb\u0da2\u0d9c\u0dad \u0d86\u0dd9\u0dcf\u0dba\u0db8 \u0dc0\u0dd0\u0da9\u0dd2 \u0d9c\u0dc0\u0dd9\u0dcf \u0dad\u0dd2\u0d9c \u0db1\u0dca\u0d9c\u0db1\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2"
  },
