    "chunk_text": "\u0d91\u0dae \u0dd9\u0dcf\u0dc0\u0dda\u0db8 \u0dc0\u0dda\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf \u0dc0\u0dda\u0dba \u0dba \u0dca\u0dc0\u0dba \u0da2 \u0dba\u0dc0 \u0dc3\u0dc4 \u0dd2\u0dc3\u0dc0\u0dda\u0dba \u0dba \u0dca\u0dc0\u0dba \u0da2 \u0dba\u0dc0 \u0dc3\u0db8 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dd9\u0dc0\u0d86\u0dbd\u0dcf \u0dc3\u0dbd \u0db1\u0dd9\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc0\u0db8\u0dad\u0dd0\u0db1 \u0da2 \u0dad\u0dbb\u0dca\u0dbd \u0dba\u0d9a\u0dca \u0dc0\u0d9c\u0dc0\u0db1\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dd9\u0db1\u0dca \u0dd2\u0dc3\u0dc0\u0dda\u0dba \u0dba \u0dca\u0dc0\u0dba \u0da2 \u0dc0\u0dba\u0dc0 \u0dc0\u0dda \u0dad\u0dd2\u0dc0\u0dd9\u0db1 capacity \u0d91 \u0d91\u0dc0\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dd9 \u0d9c\u0dad\u0dca\u0dad\u0dcf\u0db8 \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0dd2\u0dc3\u0dc0\u0dda\u0dba \u0dba \u0dca\u0dc0\u0dba \u0da2 \u0dc0\u0dba\u0dc0 \u0dc0\u0dda\u0dba \u0dba \u0dca\u0dc0\u0dba \u0da2 \u0dc0\u0dba\u0dc0 \u0dc4\u0dcf \u0dc3\u0db8 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dd9\u0dc0\u0dba\u0dc4\u0dd2\u0dbd\u0dcf \u0dc3\u0dbd \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dd9\u0db1\u0dca\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db1\u0dd4\u0daf\u0dad\u0dca \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dd9\u0db8 \u0dc0\u0dda\u0dc0\u0d9a\u0dca \u0d92 \u0da7 \u0dd2\u0dc3 \u0dca \u0db4\u0dba\u0d9a\u0dca \u0daf\u0dcf\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. \u0dc3\u0db8\u0dcf\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dd9\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0d91 \u0dd3\u0dbb\u0dba\u0dab\u0dba \u0dba\u0dda \u0da2 \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0dca\u0dc0\u0dba \u0da2 \u0dba\u0dcf \u0d89\u0db1\u0dca\u0dc0\u0db1\u0dca \u0dc0 \u0dcf\u0dc0\u0dc4\u0dae\u0daf \u0dca\u0dc0\u0dba \u0da2 \u0dba\u0dcf\u0dc0\u0dda \u0dc5\u0dd2\u0dc4\u0dd2\u0da7\u0dd3\u0db8 \u0dc0 \u0dcf\u0dad\u0dd0\u0db1\u0daf \u0d9c\u0dba\u0dd4\u0daf\u0dab \u0dc0\u0db8\u0dcf \u0d9a\u0dca\u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0dcf\u0dba\u0dab\u0dcf \u0dc3\u0dbd \u0dcf \u0dad\u0db8\u0dd2 \u0dc3\u0db8\u0dcf\u0db1\u0dd2 \u0d9a\u0dd2\u0dba\u0db1 \u0dc0 \u0dcf\u0db1\u0dca\u0dc0\u0dda\u0dd2\u0db1\u0dba \u0d9c\u0db4\u0da7 \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dd9\u0db1\u0dca \u0dc0\u0dd9\u0db1\u0dca\u0dc0\u0db1\u0dca.\n\n\u0d92 \u0dd2\u0dc3\u0dad\u0dba\u0d9a\u0dca \u0dc0\u0db1\u0dcf\u0dc0\u0dd9\u0dd2. \u0d9c\u0dbb\u0dca\u0dbd\u0dcf \u0db1\u0dd2\u0dbb\u0dd6\u0db4\u0dab \u0dd3\u0dbb\u0dba\u0dab \u0d9c\u0db1\u0dd2\u0dda \u0da2 \u0dba\u0da2\u0dba\u0da7 \u0d92 \u0dc3\u0dad\u0dca \u0dcf\u0dba \u0dba\u0dcf\u0da2\u0dba\u0dba \u0dc3\u0dc4 investor \u0d9a\u0dd2\u0dba\u0db1 \u0dc0\u0daf\u0db1\u0dca\u0db1\u0dcf\u0da7\u0db8 \u0d91 \u0dad\u0dd4 \u0dc0\u0dd9\u0dbd\u0dcf \u0d92 \u0dcf\u0dd9\u0dda\u0db0 \u0d9c\u0dbb\u0dca\u0dbd\u0dcf \u0db1\u0dd2\u0dbb\u0dd6\u0db4\u0dab\u0dd9\u0dbd\u0da7 - joint interpretations\u0dd9\u0dbd\u0da7 - \u0dba\u0db1\u0dca\u0db1 \u0d89\u0da9 \u0da2\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. \u0dc0\u0dda\u0dc0 \u0db1\u0dd4\u0dad\u0dca \u0d9c\u0dc0\u0db4\u0dca \u0dba\u0dc0\u0da7\u0dca \u0da2\u0db1\u0dad\u0dcf\u0dd9\u0dc0\u0dda \u0dc3\u0dd4\u0dd9\u0dd2\u0db1\u0dda\u0db0\u0dd2\u0dba \u0dc3\u0dc4 \u0dba\u0dc4\u0db4\u0dad \u0d9a\u0dd2\u0dba\u0db1 \u0d91 compromise \u0dba\u0db1\u0dca\u0db1 \u0dba\u0da2\u0dba\u0da7 \u0dd9\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0dc0\u0db1\u0dcf \u0dba \u0dca\u0dc0\u0dba \u0da2\u0db1 \u0daf\u0dd2\u0dbb\u0dd2\u0d9c\u0dd0\u0db1\u0dca\u0dd3\u0db8 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\n\n89 90\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc0\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9\n\n\u0dc3\u0d9a\u0dc4\u0db1\u0dca \u0dba \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. 02.) \u0da2 \u0dca\u0da0\u0dcf\u0dbb\u0dca\u0dbd\u0dba \u0daf\u0dd2\u0dd2\u0db1\u0dd2 \u0db4\u0dad\u0dd2\u0dba\u0dab \u0dc0\u0dda investment \u0d9c\u0dd0\u0db1 \u0dcf\u0dcf \u0dba\u0dda \u0da2 \u0dd2\u0dba\u0db1\u0dd9\u0dcf \u0d9c\u0dc5\u0dd2 \u0dc4\u0dd0\u0db8\u0daf\u0dcf\u0db8 \u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dca\u0dc0\u0db1\u0dca wait and see, \u0dc0\u0db8\u0dcf \u0d9a\u0dca\u0daf \u0dc0\u0dd9\u0db1\u0dca\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d8b\u0da9 \u0dd9\u0dbd\u0dcf\u0dc0\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0db1 \u0d91 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc4\u0dd0\u0dd9\u0dd0\u0dd2 02.) \u0da2 \u0d92 \u0dd2\u0dba\u0db4\u0dd4 \u0d91 \u0d9c\u0dc5\u0dd2 \u0daf\u0dd0\u0db1\u0dca \u0d89\u0dd9\u0dba \u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf \u0d89\u0dd9\u0dba \u0dba\u0db1\u0dca\u0db1 \u0db4\u0da7\u0db1\u0dca \u0d9c\u0dba\u0dc0\u0d9c\u0db1 \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. \u0dc0\u0db8\u0dcf \u0daf \u0d9c\u0dc5\u0dd2 \u0dc4\u0dd0\u0db8 \u0dad\u0dd2\u0dc3\u0dae\u0dc0\u0dc3\u0dae\u0db8 \u0dca\u0dc0\u0dba \u0da2 \u0dc0\u0dba \u0dca\u0dba\u0d9a\u0dca\u0dc2\u0dba\u0dcf \u0dba\u0db1 \u0d9c\u0db8\u0db1\u0dca\u0db8 \u0dba\u0da2\u0dc0\u0d86 \u0dc3\u0dcf\u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0db1 \u0d8b\u0db4\u0dcf\u0dba \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0d9c\u0dba\u0dd4\u0daf\u0dab\u0dd4 \u0dc3\u0dc4 \u0da2\u0db1\u0dad\u0dcf \u0dc3\u0dd4\u0dd9\u0dd2\u0db1\u0dda\u0db0\u0dd2\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0d91 balance \u0dba\u0db1\u0dca\u0db1 \u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0dba\u0db8\u0dd2\u0db1\u0dca \u0db1\u0dd0\u0dd9\u0dad\u0dad\u0dca \u0dc0\u0d9c \u0dbd\u0dd3\u0dba \u0d8b\u0dad\u0dd4\u0dba\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dd9\u0dcf \u0d9c\u0dc0\u0db4\u0dca \u0dba\u0dc0\u0da7\u0dca \u0dca\u0dc0\u0dba \u0da2\u0db1 \u0dba\u0db1\u0dca\u0db1 \u0dc4\u0dd0\u0dd9\u0dd0\u0dd2 \u0da2\u0db1\u0dad\u0dcf\u0dd9\u0dc0\u0dda \u0dc3\u0dd4\u0dd9\u0dd2\u0db1\u0dda\u0db0\u0dd2\u0dba compromise \u0dba\u0db1\u0dca\u0dc0\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd4\u0dd9 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db1 \u0db1\u0dba \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dd9 \u0dd9\u0dcf\u0dc0\u0dda \u0dba\u0da7\u0dd9\u0dca \u0d9c\u0dad\u0dca\u0dc0\u0dad\u0dcf\u0dad\u0dca \u0dd2\u0dc3\u0dc1\u0dcf\u0dbd \u0dd9\u0dc1\u0dc0\u0dba\u0db1\u0dca \u0dc0\u0dda \u0dd9\u0dcf\u0dc0\u0dda \u0d9c\u0dd2\u0dd2\u0dc3\u0dc3\u0dd4\u0dda\u0dd9\u0dbd\u0da7 \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0dc0\u0dd9\u0dbd\u0dcf \u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0dc0 \u0dbd\u0dd9\u0dcf \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d9c\u0dc0\u0db4\u0dca \u0dba\u0da7 \u0dd9\u0dcf\u0dc0\u0dda \u0dc0\u0db4\u0dcf\u0da9\u0dd2 \u0dba\u0da7 \u0da7 \u0dc0\u0d9a\u0dca\u0dd9\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dc0\u0dda \u0d91\u0dc0\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda bargaining power \u0d91 \u0d9c\u0dca \u0dba\u0da7\u0dd9\u0dbd\u0da7 \u0dca\u0dc0\u0dba \u0da2\u0db1 \u0dbb\u0dd0 \u0dc0\u0d9c\u0db1 \u0d92\u0db8 \u0d9c\u0dc5\u0dd2 \u0daf\u0dd2\u0dbb\u0dd2\u0db8\u0dad\u0dca \u0dba\u0db1\u0dd9\u0dcf \u0dc0\u0dda \u0dd9\u0dcf\u0dc0\u0dda \u0dd9\u0d9c\u0db1\u0dca\u0dad\u0dd2 \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc4\u0dba\u0dc4\u0dcf. \u0d92 \u0dd9\u0dcf\u0dc0\u0dda\u0db8 \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0dba\u0da7\u0dad\u0dca\u0dd2\u0dc3\u0da2\u0dd2\u0dad \u0dba\u0dab\u0dba \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0dc3\u0dc4 \u0dc3\u0dda\u0db4\u0dd6\u0dbb\u0dca\u0dbd\u0dab \u200d\u0dbb\u0dcf\u0dda\u0db0\u0db1\u0dba \u0d9c\u0dbd\u0dcf \u0d92\u0db8 \u0d9a\u0dd2\u0dba\u0db1 \u0dc0\u0d9c \u0dbd\u0dd3\u0dba \u0d9c\u0dbd\u0dcf \u0d92\u0dda\u0dd9\u0dbd \u0da2 \u0d91\u0dba \u0d9c\u0dc0\u0db4\u0dca \u0dba\u0da7\u0dd9\u0dca \u0dd2\u0dc3\u0db1\u0dcf\u0dc1 \u0dba\u0db8\u0dd2\u0db1\u0dca \u0d9c\u0dbd\u0dcf \u0d91\u0db1\u0dca\u0dc0\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd4\u0dd9 \u0dc0\u0dda \u0da7\u0dad\u0dd4\u0dad\u0dca\u0dad \u0daf\u0dd2\u0dbb\u0dd2\u0db8\u0dad\u0dca \u0dba\u0db1 \u0d9c\u0db8\u0db1\u0dca\u0db8 \u0d9c\u0dc0\u0db4\u0dca \u0dba\u0dc0\u0da7\u0dca \u0da2\u0db1\u0dad\u0dcf\u0dd9\u0dc0\u0dda \u0dc3\u0dd4\u0dd9\u0dd2\u0db1\u0dda\u0db0\u0dd2\u0dba \u0dca\u0dba\u0d9a\u0dca\u0dc2\u0dba\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dc0\u0dda \u0d9c\u0dd2\u0dd2\u0dc3\u0dc3\u0dd4\u0db8 \u0d9c\u0db4\u0da7 \u0d89\u0dad\u0dcf\u0db8 \u0dd9\u0dd0\u0daf\u0d9c\u0dad\u0dca \u0d9c\u0dd2\u0dd2\u0dc3\u0dc3\u0dd4\u0db8\u0d9a\u0dca \u0dd9\u0dd9 \u0db8\u0dcf \u0dc3\u0d9a\u0dc4\u0db1\u0dca \u0dba\u0db1\u0dca\u0db1 \u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dd2."
