    "chunk_text": "\u0bc8\u0b95\u0bcd\u0b95\u0bb3\u0bcd. \u0d91\u0dad\u0d9c\u0d9a\u0ddc\u0db4 \u0d92 \u0dc3\u0dad\u0dd4\u0d9c\u0dda \u0da2\u0db1\u0dad\u0dc1\u0dc0\u0dad\u0dca \u0db8\u0d9c\u0db4\u0dca \u0da2\u0db1\u0dad\u0dc1\u0dc00 \u0d92 \u0dad\u0d9a\u0dca\u0d9c\u0d9a\u0ddd\u0db8 \u0da2\u0db1\u0dad\u0dc1\u0dc0 \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dc1 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d92 \u0d9a\u0dda\u0db8\u0dc1\u0db1\u0dca\u0dad \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dc1 \u0d9a\u0dbb\u0db1\u0dca\u0db10 \u0d9c\u0db8\u0dca \u0db1\u0dd2\u0d9c \u0ddd\u0d9c\u0dc0\u0dd2\u0db1\u0db1\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dc1\u0dc0 \u0d9c\u0daf\u0db1\u0dca\u0d9c\u0db1\u0dca \u0daf\u0d9a\u0dd4\u0dab\u0db4 \u0daf\u0d9a\u0dd4\u0d9c\u0da9\u0dd4 \u0da2\u0db1\u0dad\u0dc1\u0dc0\u0db4 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0d9c\u0db1\u0ddc\u0d9c\u0dc0\u0dba\u0dd2 \u0d9c\u0dd3\u0dba \u0db8\u0d9a\u0dca\u0d9a\u0dbd\u0dca; \u0db8\u0dd4\u0dc5\u0dd4 \u0dbb\u0d9c\u0da7\u0dca\u0db8 \u0da2\u0db1\u0dad\u0dc1\u0dc0\u0db40 \u0d91\u0dbd\u0dca\u0dbd\u0dc1\u0db8\u0dca0 \u0d8a\u0dd9\u0dc1\u0db8\u0dca \u0d9c\u0db1\u0ddc\u0d9c\u0dc0\u0dba\u0dd20 \u0dc4\u0db4\u0dad\u0daf? \u0d92\u0d9a \u0dc4\u0dd2\u0db1\u0dca\u0daf\u0dc1 \u0d92 \u0d9c\u0dd0\u0db1 \u0d9c\u0db4\u0ddc\u0da9\u0d9a\u0da9\u0d9a\u0dca \u0d9a\u0dbd\u0dca\u0db4\u0db1\u0dc1 \u0d9a\u0dbb\u0db1\u0dca\u0db10\n\n\u0db8\u0d9c\u0db4\u0dca \u0dc3\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0d9a\u0dda\u0db8\u0dc1\u0db1\u0dca\u0dad \u0d9c\u0dad\u0dca\u0d9c\u0dad\u0ddc\u0dad\u0dca \u0db4\u0dd2\u0db4 \u0dbb\u0db4 \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0db8\u0da7\u0dca\u0db4\u0db8\u0db4 \u0dc0\u0da9\u0dc1 \u0dd2\u0dc4\u0dd9 \u0db8\u0da7\u0dca\u0db4\u0d9c\u0db8\u0dca \u0dc3\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0dc3\u0db8\u0dc4\u0dbb \u0dad\u0dd0\u0db1\u0dca\u0dc0\u0dbd \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dc10 \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0db8\u0d9c\u0db4\u0dca \u0d9c\u0dd3\u0dba \u0db1\u0dd2\u0dc2\u0dcf\u0db4\u0dc1\u0daf\u0db1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dc10 \u0db8\