\u0daf\u0dd2 \u0dc3\u0db8\u0dcf\u0dba\u0dbd\u0dba\u0dda\u0ddd\u0da0\u0db1\u0dba\u0d9a\u0dca \u0d9a\u0dbb\u0dbd\u0dba\u0dda\u0dcf \u0d94\u0db6\u0dc0\u0db8\u0dcf \u0d85\u0dc4\u0db1 \u0dca\u200d\u0dbb\u0dca\u0dc0\u0db1\u0dba\u0da7 \u0dca\u0db1 \u0daf\u0dd2\u0dba\u0dda\u0daf\u0dd3 \u0dad\u0dd3\u0db1\u0dca \u0d9c\u0db1\u0dca\u0db1 \u0dc3\u0dd6\u0daf\u0dca\u200d\u0dba\u0dcf\u0db1\u0db8\u0dca \u0d9a\u0dbb\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 (vi) \u0d94\u0dda8 \u0d91\u0db8 \u0dc0\u0dd0\u0dc0\u0dd2\u0dd2 \u0dc3\u0db8\u0dcf\u0d9c\u0db8\u0dca \u0dc0\u0dd2\u0da7\u0db1\u0dca \u0db1\u0dd2\u0dba\u0dd2\u0dba \u0d9a\u0dcf\u0dbd\u0dba\u0dda \u0db4\u0daf\u0dd2\u0dca\u0dba\u0dda\u0daf\u0dca\u200d\u0dba\u0dba\u0da7 \u0d85\u0daf\u0dca\u200d\u0dba\u0dcf\u0dc5 \u0db6 \u0d9a\u0dd4\u0dd2\u0dba \u0dc3\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dae\u0dab\u0dba\u0dba\u0db1\u0dca \u0dba\u0d9c\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0d85 \u0dbb\u0d8b 2025 \u0dc0\u0dbb\u0dca\u0dae\u0dc2\u0dba\u0dda \u0db4\u0dc5\u0db8\u0dd4 \u0dc4\u0dcf \u0dba\u0daf\u0dca\u200d\u0dba\u0dc0\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0dae\u0dc0\u0dba\u0dda \u0db6 \u0d9a\u0dd4\u0dd2\u0dba \u0daf\u0dca\u200d\u0dba \u0db4\u0dc4 \u0db4\u0daf\u0dd2\u0db1 \u0dba\u0d9c\u0dc0\u0dcf \u0d87 8 1. \u0db8\u0dc0\u0dbb\u0da7 \u0dc0\u0dd0\u0dc0\u0dd2\u0dd2 \u0dc3\u0db8\u0dcf\u0d9c\u0db8 - \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dcf 13,456,555.00 2. \u0db1\u0db8\u0dd4\u0dab\u0dd4\u0d9a\u0dd4\u0dbd\u0dba\u0dda \u0dc0\u0dd0\u0dc0\u0dd2\u0dd2 \u0dc3\u0db8\u0dcf\u0d9c\u0db8 - \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dcf 56,635,182.00 3. \u0dbd\u0dba\u0dda\u0dc0\u0dcf\u0d9a\u0dd0\u0dba\u0dbd\u0dcf \u0dc0\u0dd0\u0dc0\u0dd2\u0dd2 \u0dc3\u0db8\u0dcf\u0d9c\u0db8 - \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dcf\n\n34,914,861.00\n\n(\u0d86) \u0d85\u0daf\u0dca\u200d\u0dba\u0dcf\u0dc5 \u0dba\u0db1\u0dcf\u0dba\u0dda8\n\n\u0dd4 \u0d85\u0da2\u0dca\u0dad \u0dda\u0db8\u0dd0\u0daf\u0dca\u0d9c\u0daf\u0d9c\u0dda \u0db8\u0dc4\u0dc3\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b85\u0b9c\u0ba8\u0bcd\u0ba4 \u0b95\u0bae\u0bcd\u0ba4\u0bae\u0ba4\u0bcd\u0ba4\u0ba4\u0ba4\u0b95) (The Hon. Ajantha Gammeddage) \u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dc0\u0db8\u0db1\u0dd2\u0d8b \u0db8\u0db8 \u0d9c\u0dbb\u0dd4 \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0db8\u0dcf\u0dba\u0d9c\u0db1\u0dca \u0d85\u0dc3\u0db1 \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0dc0\u0dbb\u0dd4 \u0dca\u200d\u0dbb\u0dca\u0dc0\u0db1\u0dba \u0dba\u0db8\u0dba\u0dba\u0dd28\n\n\u0dd4 \u0d9c\u0d9a\u0dca.\u0dd3. \u0dc3\u0dca\u0db8\u0dca\u0dad \u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dc3\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0b95.\u0bb5\u0bc0. \u0b9a\u0bae\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0ba4\u0bcd\u0baf\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9) (The Hon. K.V. Samantha Viddyarathna) \u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dc0\u0db8\u0db1\u0dd2\u0d8b \u0db8\u0db8 \u0d85\u0dbb \u0db8\u0dd4\u0dd2\u0db1\u0dca \u0db4\u0dd0\u0dc4\u0dd0\u0db1 \u0dd2 \u0d9a\u0dc5\u0dcf \u0dc0\u0dcf\u0dba \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8\u0dca \u0dc0\u0dbb\u0dca\u0dae\u0d9c \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0d92 \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8\u0dca \u0d85\u0db1\u0dd4\u0dc0 \u0d9a\u0da7\u0dba\u0dd4\u0dc0 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf8 \u0dba\u0d9a\u0dcf\u0dba\u0dc4\u0dcf\u0db8 \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dc0\u0d8b \u0d85\u0db8\u0dcf \u0dba\u0dcf\u0d82\u0dca\u0dba \u0db4\u0dd0\u0dad\u0dca \u0dc0\u0dba \u0db1\u0dca \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dca\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dba\u0dda \u0dc0\u0dc5 \u0dba\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d8d \u0dc0 \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0dba\u0d9a\u0dca \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0db1 \u0dba\u0dbd\u0dba\u0dda\u0dc3\u0db8 \u0dc0\u0dd4\u0dab\u0dcf \u0d9a\u0dd2\u0dba\u0dcf \u0db8\