    "chunk_text": "\u0dc0\u0dd2\u0d9c\u0db1\u0dda\u0dc2\u0d9c \u0db1\u0dca\u0db8 \u0d9c\u0db8\u0dc4\u0dd2\u0daf\u0dd3 \u0d9c\u0dd3\u0db1\u0db4\u0dc1\u0dbd\u0db1 \u0dc0\u0dd4\u0dc0\u0db8\u0db1\u0dc1\u0dc0 \u0db8\u0dad \u0d9c \u0dde\u0dc0\u0db1 \u0dc3\u0db8\u0dc1\u0da2 \u0dc3\u0db3\u0dc4\u0dc1 \u0dc0\u0dd2\u0dcf\u0dc1 \u0d9a \u0db1\u0dd2\u0dbd\u0dcf\u0dc1\u0db4\u0dad\u0db1\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0d9c\u0db8\u0dca \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dc0\u0dd9\u0d9a\u0dca \u0dd2\u0db1 \u0dad\u0dca \u0dc0\u0db1 \u0db6\u0dc0\u0db4 \u0dd2\u0dad\u0dc1\u0db8 \u0db4\u0dd0\u0dc4\u0dd0\u0dd2\u0db1\u0dd2\u0db1\u0dc0 \u0dc3\u0dc1\u0d9a\u0dca\u0dc2\u0dd2 \u0dc3\u0dc4\u0dd2\u0dad\u0dc0 \u0d9c\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dc0\u0dc1\u0dda\u0dad\u0dc1 \u0d9c\u0dc0\u0db1\u0dc0\u0dc10 \u0d9c\u0db8 \u0d9c \u0dde\u0dc0\u0db1 \u0dc3\u0db8\u0dc1\u0da2 \u0db4\u0dd3\u0dcf\u0dad\u0dd2\u0d9c\u0d86 \u0dc3\u0dcf\u0dc0\u0dc0\u0dd3 \u0dc1\u0dc0 \u0dc4\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0da2\u0dc1\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dc1\u0daf\u0dd3 \u0d86\u0d9a\u0dc1\u0dbb\u0d9c \u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0dd3\u0db8 \u0db8\u0dc0\u0daf\u0dc1\u0db1\u0db8\u0d9a\u0db4 \u0dbd\u0d9a\u0dca \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0db1\u0dc0 \u0db1\u0dd2\u0d9c \u0ddd\u0d9c \u0db8\u0dc1\u0dbd\u0dc1\u0dc0 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0d9c\u0dd3\u0db1\u0db4\u0dc1\u0dbd\u0db1 \u0dc4\u0dd2\u0dad\u0dc0\u0dad\u0dd4\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dc1 \u0dc0\u0dc1\u0dc3\u0dd2 \u0d9a\u0dca \u0dbd\u0db6\u0dc1 \u0daf\u0dd3\u0d9c\u0db8\u0dca \u0dc3\u0dad\u0dca\u0dc3\u0dc1\u0dc4 \u0d9a\u0dca \u0db6\u0dc0 \u0d9c\u0db6\u0ddc\u0d9c\u0dc4\u0ddc\u0db8 \u0db4\u0dd0\u0dc4\u0dd0\u0dd2\u0db1\u0dd2\u0db1\u0dc0 \u0d9c\u0db4\u0db1\u0dd3 \u0db1\u0dc0\u0dc10 \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dc1 \u0d9c\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dcf\u0d9c \u0db1\u0dca \u0d86\u0da9\u0dd4\