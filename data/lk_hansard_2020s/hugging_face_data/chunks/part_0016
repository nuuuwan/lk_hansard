    "chunk_text": "\u0dad\u0db8\u0dc1 \u0db8\u0dad\u0dca\u0db8\u0da9\u0dc0\u0d9c\u0dd4\u0dc0\u0db4 \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc0\u0dd9\u0d9a\u0dca\u0dc0\u0db1 \u0d9c\u0dbd\u0dc3 \u0dd2\u0dbd\u0dca\u0dbd\u0dc1 \u0d9c\u0dd3\u0db1\u0db6\u0db1\u0dca\u0daf\u0dd4 \u0d9c\u0dad\u0db1\u0dca\u0db1\u0d9c\u0d9a\u0ddd\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dc1 \u0db8\u0db7\u0dd2 \u0dc1 \u0db1\u0dc1\u0d9a\u0dbb\u0d9a\u0dbb\u0dab\u0d9c\u0d86 \u0db4\u0dad\u0da7\u0dca \u0d9c\u0db4\u0dad\u0dca\u0dc3\u0db8\u0d9a\u0dca \u0d9c\u0d9c\u0ddc\u0db1\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2 \u0dc1 \u0db8\u0dad\u0dbb 2025 \u0db8\u0dc1\u0dda\u0dad\u0dd4 1.\u0dc0\u0dd0\u0db1\u0dd2 \u0dd2\u0db1\u0db1 \u0db8\u0db7\u0dd2 \u0dc1 \u0db1\u0dc1\u0d9a\u0dbb\u0d9a\u0dbb\u0dab \u0d91\u0db8 \u0db4\u0dad\u0da7\u0dca \u0d9c\u0db4\u0dad\u0dca\u0dc3\u0db8 \u0dc0\u0dd2 \u0dc1\u0d9c \u0db4 \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dca\u0d9c\u0dc2\u0dda\u0db4 \u0d9a\u0d9c\u0dd9\u0dda 0 \u0d91\u0db8 \u0d9c\u0db4\u0dad\u0dca\u0dc3\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dca\u0d9c\u0dc2\u0dda\u0db4 \u0dd2\u0dbb\u0dd3\u0d9c\u0db8\u0dca \u0db1\u0dd2\u0d9c \u0ddd\u0d9c\u0d9c\u0d86\u0daf\u0dd3 \u0d9c\u0dd3\u0db1\u0db6\u0db1\u0dca\u0daf\u0dd4 \u0d9c\u0dad\u0db1\u0dca\u0db1\u0d9c\u0d9a\u0ddd\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dc1 \u0db1\u0dd3\u0dad\u0dd2 \u0db4 \u0db8\u0dc0\u0db1\u0dad \u0d9c\u0db1\u0ddc\u0dc0\u0dd3\u0db8 \u0d9c\u0dd0\u0db1 \u0daf\u0dd0\u0da9\u0dd2 \u0d9c\u0daf\u0ddd\u0dc2\u0dc1\u0d9c\u0dbb\u0ddd\u0db4\u0dab \u0db4 \u0dbd\u0d9a\u0dca \u0dc0\u0dd2 0\n\n\u0d9c\u0db4\u0ddc\u0dbd\u0dd2\u0dc3\u0dca\u0db4\u0dad\u0dd2 \u0db0\u0dd4\u0dbb\u0d9c\u0dba\u0db1\u0dca \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0d9c\u0db8\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dbd\u0dd2\u0dba\n\n\u0dd2\u0dad\u0dd2\u0dc4\u0dc1\u0dc3\u0d9c\u0d86 \u0db4\u0dd9\u0db8\u0dd4 \u0dc0\u0dad\u0dc1\u0dc0\u0db4 2002 \u0db8\u0dc0\u0d9a 5 \u0daf\u0dbb\u0db1 \u0db4\u0db1\u0dad \u0db8\u0db1\u0