    "chunk_text": "\u0db8\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dc1 \u0d9a\u0dc1\u0d9c\u0dda \u0d9c\u0dc4\u0ddd \u0db8\u0dad\u0dd2\u0db1\u0dca \u0db8\u0dca \u0dc0\u0dd0\u0dbb\u0dd0\u0dd3\u0daf\u0d9a\u0dca \u0d9c\u0dc0\u0dbd\u0dc1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dc1 \u0db1\u0db8\u0dca \u0dad\u0dc4\u0dd4\u0d9c\u0dda \u0dad\u0dbb\u0dc1\u0dad\u0dd2\u0dbb\u0db8 \u0d9c\u0db1\u0ddc\u0db6\u0dbd\u0dc1 \u0d92 \u0d9c\u0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0db1\u0dca \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4 \u0dad\u0dd3\u0dbb\u0dab \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0db4 \u0d9c\u0db8\u0dca \u0dc0\u0db1 \u0dc0\u0dd2\u0db4 \u0dbb\u0da2 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0d9a\u0dca \u0db8\u0dbb\u0d9c\u0d9c\u0db1 \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0db6\u0dc00 \u0daf\u0dd0\u0db1\u0dca \u0d9c\u0db4\u0ddc\u0dbd\u0dd3\u0dc3\u0dd2 \u0dc1\u0dbb \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dc1 \u0d9a\u0dae\u0dc1 \u0d9a\u0dd9\u0dc1 \u0db8\u0d9a\u0dbb\u0d9a\u0dbb\u0dab \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dc1 \u0d9a\u0dae\u0dc1 \u0d9a\u0dd9\u0dc10 \u0d91\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dc1 \u0d9a\u0dae\u0dc1 \u0d9a\u0dbb\u0db1 \u0d9c\u0dc0\u0dbd\u0dc1\u0d9c\u0dda\u0daf\u0dd3 \u0d9c\u0db8\u0dca \u0dc0\u0dc1\u0dda\u0dad\u0dc1\u0d9c\u0dda \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0dc4\u0dd0\u0db8 \u0d9a\u0dc1\u0dbb\u0dab \u0d9a\u0dca\u0db8 \u0dc0\u0dc1\u0d9c\u0dda \u0d9c\u0db8\u0dca \u0dc3 \u0dc1\u0dc0\u0db4 \u0dc3\u0dc0\u0d9a\u0dca\u0dc2\u0dd2\u0db4\u0dca\u0dad\u0dc0 \u0dd2\u0dd2\u0db1\u0db4\u0dad\u0db4\u0dad\u0dca \u0d9a\u0dd9\u0dc10 \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c \u0ddd\u0da2\u0dba \u0d9a\u0dc1\u0dbb\u0d9a \u0dc3 \u0dc1\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2 \u0db1\u0dd2 \u0d9c\u0dbb\u0dd4 \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0d9c\u0db8\u0dad\u0dd0\u0db1\u0db4 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dcf \u0dc0\u0db1\u0dca\u0d9c\u0db1\u0dca \u0db8\u0dad\u0dd3\u0dad \u0dc3\u0dc4 \u0dc0\u0dda\u0dad\u0db8\u0dc1\u0db1 0 \u0dbd\u0dc0\u0d9a\u0dc1 \u0d9c\u0dd