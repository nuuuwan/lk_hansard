    "chunk_text": "\u0d9c\u0db8\u0dad\u0dd0\u0db1\u0daf\u0dd3 \u0dad\u0dc0 \u0d91\u0d9a \u0d9a\u0dcf\u0dbb\u0dab\u0dcf\u0dc0 \u0dbd \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0d9c \u0db1\u0dc0\u0dcf. \u0dd9\u0dd0\u0db1\u0dca \u0dc4\u0dd0\u0d9c\u0db8\u0ddd\u0db8 \u0dc0\u0dcf\u0d9c\u0dda \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9c\u0db1\u0dca \u0dc3\u0dd6\u0daf\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dcf\u0dc0 \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dad\u0dd4\u0db6\u0db3\u0db1\u0dca \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0db1\u0dca \u0dc0\u0dd2\u0dba\u0dcf\u0dd9 \u0db4\u0dd2\u0db4\u0dad\u0dc3 \u0dbd \u0dcf\u0d9c\u0db4\u0dca \u0dbb\u0db4\u0db4 \u0d9c\u0d9c\u0db1\u0dca\u0dc0\u0dcf\u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4 \u0dc0\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0dd9\u0dcf\u0dba\u0dd2. \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0db1\u0dca \u0dc0\u0dd2\u0dba\u0dcf\u0dd9 \u0db4\u0dd2\u0db4\u0dad\u0dc3 \u0dbd \u0d9c\u0d9c\u0db1\u0dca\u0dc0\u0dcf \u0d9c\u0dd0\u0dad\u0dd2\u0db8 \u0dc0\u0dd0\u0dd9\u0d9c\u0dad\u0dca. \u0dc0\u0dd2\u0d9c\u0dba\u0dda\u0dc2\u0dca\u0da8\u0d9c\u0dba\u0db1\u0dca \u0dc3\u0dd6\u0daf\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dcf\u0dc0\u0db4 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2 \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0d9c \u0dc0\u0dd2\u0dba\u0dcf\u0dd9 \u0db4\u0dd2\u0db4\u0dad\u0dc3 \u0dbd \u0dd9\u0dd0\u0db1\u0db4\u0dad\u0dca \u0dd9\u0d82\u0d9a\u0dcf\u0dc0\u0db4 \u0d91\u0db1\u0dc0\u0dcf. \u0d91\u0dad\u0d9c\u0d9a \u0db4 \u0d91\u0d9a \u0db4\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd2\u0db1\u0dca \u0dcf\u0db4\u0db4 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0d9c\u0dc0\u0db1\u0dc0\u0dcf; \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0dcf\u0db4\u0db4 \u0d9c\u0dd9 \u0d9c\u0dda \u0d86\u0dd9\u0dcf\u0dba\u0db8\u0d9c\u0dda\u0dad\u0dca \u0dd9\u0dd0\u0d9c \u0db1\u0dc0\u0dcf. \u0d9a \u0d87\u0dad\u0dca\u0dad. \u0dcf\u0db4\u0dd2 \u0d9a \u0dad\u0dc0\u0dad\u0dca \u0daf\u0dd2\u0db4\u0dad\u0db8\u0dad\u0dca \u0d9a\u0dbb\u0d9c\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0dc3\u0dd6\u0daf\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dcf\u0dc0 \u0dc3\u0db8\u0dca \u0db1\u0dca\u0db1\u0d9c\u0dba\u0db1\u0dca \u0d9c\u0dd9 \u0d9c\u0dda \u0dc0\u0dd2\u0d9c \u0da0\u0db1\u0dba \u0dbd \u0dd9 \u0dad\u0dd2\u0d9c \u0db1\u0dc0\u0dcf \u0d9c\u0db1\u0dca. \u0db6\u0dd4\u0daf\u0dd4 \u0dd9\u0dc4\u0db8 \u0d91 \u0dbd\u0d9a \u0dd9\u0db1 \u0d9c\u0d9a \u0db4 \u0dcf\u0d9c\u0db4\u0dca \u0dc3\u0d82\u0dc3\u0dcf\u0d9a\u0dd8\u0dad\u0dd2\u0dba \u0d91 \u0dbd\u0d9a \u0dd9\u0db1 \u0d9c\u0d9a \u0db4 \u0dcf\u0d9c\u0db4\u0dca \u0dbb\u0d9c\u0da7\u0dca \u0dc3\u0dd6\u0daf\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dcf\u0dc0 \u0db4\u0dd2\u0db6\u0db3 \u0db3\u0dc0 \u0d9c\u0dd9 \u0d9c\u0dda \u0dc0\u0dd2\u0d9c \u0da0\u0db1\u0dba \u0dbd \u0dad\u0dd2\u0d9c \u0db1\u0dc0\u0dcf. \u0dcf\u0db4\u0db4 \u0d9c\u0db8\u0d9c\u0dc4\u0db8 \u0d9c\u0dd9\u0dba \u0dbd \u0d9c\u0dd0\u0db1 \u0dc4\u0dd2\u0dad\u0db1\u0dca\u0db1 \u0db4\u0dd4 \u0dc0\u0dc0\u0db1\u0dca; \u0dcf\u0db4\u0dd2 \u0d91\u0dba \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0db1\u0dca\u0db4 \u0db4\u0db8\u0dab \u0dbd \u0dc3\u0dd3\u0db8\u0dcf \u0d9a\u0dbb\u0dd9\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dd9\u0dcf\u0d82\u0d9a\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0db4 \u0dc3\u0dd6\u0daf\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dcf\u0dc0 \u0dad\u0dc4\u0db1\u0db8\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4 \u0dc0\u0dc0\u0db1\u0dca. \u0dc0\u0dcf\u0d9c\u0dda \u0dbb\u0db4\u0dc0\u0dbd\u0dca \u0d9c\u0dab\u0db1\u0dcf\u0dc0 \u0dbd \u0dad\u0dd2\u0d9c \u0db1\u0dc0\u0dcf. \u0dcf\u0db4\u0dd2 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0d9c\u0dc3\u0dda\u0dd9\u0dcf\u0db4 \u0d91\u0d9c\u0dc4\u0db8 \u0d9c\u0dba\u0ddd\u0da2\u0db1\u0dcf\u0dc0 \u0dbd \u0d9a\u0dbb\u0db1\u0dca\u0d9c\u0db1\u0dca \u0dc3\u0daf\u0dca\u0db7\u0dcf\u0dc0\u0d9c\u0dba\u0db1\u0dca. \u0d9a \u0dcf\u0db4\u0db4 \u0d89\u0dad\u0dcf \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dbd\u0dd2\u0dc0 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4 \u0dc0\u0dc0\u0db1\u0dca. \u0dc0\u0dd2\u0d9c\u0daf\u0dca\u0dc1\u0dd2\u0d9a\u0d9c\u0dba\u0d9c\u0dda\u0d9c\u0dda \u0dd3\u0dc3\u0dcf \u0d91\u0d9a \u0dd9\u0dd9\u0dcf \u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0db4\u0dcf\u0dc3\u0dcf\u0d9c\u0db4\u0ddd\u0da7\u0dca \u0d91\u0d9a \u0dd9\u0dd9\u0dcf \u0dc0\u0dcf\u0db4 \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4 \u0dc0\u0dc0\u0db1\u0dca. \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dd9\u0dcf\u0d82\u0d9a\u0dd2\u0d9a\u0d9c\u0dba\u0d9c\u0dda \u0db1\u0db8\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dd9\u0dcf\u0d82\u0d9a\u0dd2\u0d9a\u0dba\u0dcf\u0db4 \u0dcf\u0dc0\u0dc3\u0dcf\u0dae\u0dcf\u0dc0 \u0dd9 \u0dcf \u0d9c\u0db1 \u0d9c\u0dd9\u0db1 \u0db8\u0da7\u0dca\u0db4\u0db8\u0db4 \u0d9c\u0db8\u0dba \u0d9c\u0d9c\u0db1 \u0d91\u0db1\u0dca\u0db1 \u0dcf\u0db4\u0db4 \u0db4\u0dd4 \u0dc0\u0dc0\u0db1\u0dca. \u0d9c\u0dd0\u0db1 \u0d9a\u0dd2\u0dc3\u0dd2\u0db8 \u0d9c\u0dd0\u0db4\u0dbd\u0dd4\u0dc0 \u0dbd \u0db1\u0dd0\u0dc4\u0dd0. \u0dcf\u0db4\u0dd2 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0d9c\u0dc3\u0dda\u0dd9\u0dcf\u0db4 \u0dc0\u0dcf\u0d9c\u0dda\n\n\u0dd9\u0dd0\u0db1\u0dca \u0d9c\u0db8\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dd9\u0dcf \u0d9c\u0d82\u0da2\u0dcf \u0dc0\u0dd0\u0dd3\u0db8 \u0db4\u0dd2\u0db6\u0db3 \u0db3\u0dc0\u0dad\u0dca \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0dcf\u0d9c\u0db4\u0dca \u0daf\u0dd2\u0dc3\u0dcf\u0dca\u200d\u0dbb\u0dd2 \u0dbd\u0d9a\u0d9c\u0dad \u0db8\u0dd3\u0db4\u0dad\u0d9c\u0db8 \u0d86\u0dc3\u0db1\u0d9c\u0dad \u0d9c\u0d82\u0da2\u0dcf \u0dc0\u0dc0\u0db1\u0dca\u0db1 BOI \u0d91\u0d9a\u0db4 \u0dcf\u0dba\u0dd2\u0dad\u0dd2 \u0d89\u0da9\u0dcf \u0db8 \u0dbd \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dba\u0dcf\u0dd9\u0dcf\u0dc0 \u0dbd \u0dc3\u0db3\u0dc4\u0dcf \u0dd9 \u0dcf \u0d9c\u0dd9\u0db1\u0dca\u0db1 \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dd9\u0dcf \u0dcf\u0db4\u0db4 \u0d86\u0dbb\u0d82\u0da0\u0dd2\u0dba\u0dd2. [ \u0dcf\u0db1\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dbd] \u0db1\u0dd0\u0dc4\u0dd0 \u0db1\u0dd0\u0dc4\u0dd0. \u0d9a\u0dae\u0dcf\u0dc0 \u0dc0\u0dd0\u0dbb\u0dd0\u0daf\u0dd2 \u0db1\u0db8\u0dca \u0dc0\u0dd0\u0dbb\u0dd0\u0daf\u0dd2\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0d9c\u0dc3\u0dda\u0dd9\u0dcf\u0db4 \u0db4\u0dd4 \u0dc0\u0dc0\u0db1\u0dca. \u0dcf\u0db4\u0db4 \u0d86\u0dbb\u0d82\u0da0\u0dd2 \u0dc0\u0dd2\u0d9a\u0dbb\u0dba \u0dad\u0db8\u0dba\u0dd2 \u0d91\u0dba. \u0d91\u0d9c\u0dc4\u0db8 \u0d91\u0d9a \u0dbd \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dd9\u0dcf \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0d9c\u0dba\u0d9c\u0dda\u0dad\u0dca \u0d9a\u0dd2 \u0dc0\u0dcf. \u0dcf\u0d9c\u0db4\u0dca \u0db8\u0dc4\u0dd2\u0db1\u0dca\u0dd9 \u0da2\u0dba\u0dc3\u0dd2\u0d82\u0dc4 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dd9 \u0d9c\u0d9a \u0d9c\u0dc4\u0dda\u0dd9 \u0d9a\u0dd2 \u0d9c . \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0dd9\u0dd0\u0db1\u0dca \u0d94\u0dba \u0dc4\u0dd2\u0db4\u0d9c\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0d9c\u0db1\u0dca. \u0d9a \u0dc0\u0dd0\u0dbb\u0dd0\u0daf\u0dd2\u0dba\u0dd2 \u0db1\u0db8\u0dca \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0d9c\u0dc3\u0dda\u0dd9\u0dcf \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0dd0\u0daf\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db1. \u0d9c\u0dc4 \u0db3\u0dba\u0dd2 \u0dcf\u0d9c\u0db4\u0dca \u0d86\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0d9a\u0dcf\u0dd9\u0d9c\u0dad \u0dc0\u0dcf\u0db4 \u0dcf\u0dc0\u0dc3\u0dbb \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf \u0d9a\u0dd2\u0dba\u0db8\u0dd4\u0d9c\u0d9a\u0ddd. \u0dc4\u0dd0 \u0dd0\u0dba\u0dd2 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0d9c\u0dc3\u0dda\u0dd9\u0dcf \u0d9c\u0dc0\u0dd9\u0dcf\u0d9c \u0dad\u0dca \u0d9c\u0db8 \u0d9a \u0dbd\u0dd9 \u0d9a\u0dd2 \u0d9c ? \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0d9c\u0dc3\u0dda\u0dd9\u0dcf \u0d9a\u0dd0\u0dc3\u0dd2\u0d9c\u0db1\u0ddd \u0dc3\u0db8\u0dca \u0db1\u0dca\u0db1\u0d9c\u0dba\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0d9a\u0dae\u0dcf\u0dc0\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0d9c\u0dc0\u0dd9\u0dcf\u0d9c \u0dad\u0dca \u0d9a\u0dd2 \u0d9c . \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d86\u0da9\u0dd4\u0d9a\u0dca\u0d9c \u0dc4\u0dd2\u0db4\u0db4\u0dd4 \u0da9\u0dcf \u0dba\u0db1\u0dcf \u0d9c\u0db8\u0d9c\u0dda \u0dbb\u0dcf\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0db4\u0dad\u0dba\u0db4 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db1\u0dc0\u0dad\u0dca \u0d91\u0dd9\u0dcf \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0dd9\u0dcf \u0d9c\u0d82\u0da2\u0dcf \u0dc0\u0dd0\u0dd3\u0db8\u0db4 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db1\u0dc0\u0dad\u0dca \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0dd9\u0dcf \u0dd9\u0dd0\u0db1\u0dca \u0d9a\u0db4 \u0dcf\u0db1\u0dd4\u0db8\u0dd0\u0dad\u0dd2\u0dba \u0dd9 \u0dcf \u0d9c\u0dd9\u0db1\u0dc0\u0dcf. \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0d9c\u0dc3\u0dda\u0dd9\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0d9c\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0dd9\u0dcf \u0d91\u0dd9\u0dcf \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0d9c\u0daf\u0dca\u0dc0\u0dbd\u0dca \u0dc3\u0dd2\u0dba\u0dbd\u0dca\u0dd9\u0db8 \u0dd9\u0dd0\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf."
