    "chunk_text": "\u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc2\u0dba\u0dba\u0db1\u0dca\u0db8 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d9a\u0dcf\u0dbd\u0dba\u0dda\u0dba\u0dda \u0d85\u0dba\u0db4\u0dca \u0dbb\u0da7\u0da7 \u0dc0\u0dcf\u0dc4\u0db1\u0dba\u0d9a\u0dca\u0dc0\u0dad\u0dca \u0dc0 \u0dba\u0d9c\u0db1\u0dca\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0daf\u0dd2 \u0dd0\u0db1\u0d9a\u0da7 \u0d85\u0dba\u0db4\u0dca \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba \u0db6\u0d82\u0dba\u0d9a\u0dcf\u0dba\u0dbd\u0dba\u0dda\u0dcf\u0dad\u0dca \u0dc0 \u0dba\u0dc0\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dba\u0da9\u0dd4\u0d9a8 \u0d92 \u0dad\u0dca \u0dc0\u0dad\u0dca \u0dc0\u0dc0\u0dba \u0dba\u0dc0\u0db1\u0dc3\u0dc0 \u0d9a\u0dbb\u0dbd\u0dba\u0dda\u0dcf \u0dbb\u0dba\u0dda \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba \u0da2\u0db1 \u0da2\u0dd3\u0dc0\u0dd2 \u0dba\u0da7 \u0d85\u0dc0\u0dca\u0dba \u0dba\u0dcf\u0db1 \u0dc0\u0dcf\u0dc4\u0db1 \u0dba\u0d9c\u0db1\u0dca\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0dba\u0db4\u0dca \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba \u0dba\u0db8\u0dca\u0d9a\u0dd2\u0da7 \u0dd0\u0db1\u0d9a\u0da7 \u0dba \u0db1\u0dca\u0db1\u0dad\u0dca \u0dc0 \u0daf\u0dca\u200d\u0dba\u0dd0\u0db1\u0dca \u0d85\u0db4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dc0\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 2024 \u0da2\u0dd6\u0db1\u0dd2 \u0daf\u0dca\u200d\u0dba\u0d9a\u0dca\u0dc0\u0dcf \u0db6\u0dd0\u0dbd\u0dd4\u0dc0\u0dcf\u0db8\u0d8b \u0d87\u0dba\u0db8\u0daf\u0dd2\u0d9a\u0dcf\u0db1\u0dd4 \u0dba\u0da9\u0dcf\u0dbd\u0dba\u0dda\u0dbb\u0dca\u0dae \u0db6\u0dd2\u0dd2\u0dba\u0db1 681\u0d9a \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0d85\u0db4\u0db1\u0dba\u0db1\u0dba 685\u0d9a\u0dca \u0daf\u0dca\u200d\u0dba\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0dbb\u0dca\u0dae\u0dca\u200d\u0db1\u0dba \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1 \u0d85\u0db4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dc0\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0dbb\u0dba\u0dda \u0d86\u0db1\u0dba\u0db1 \u0d85\u0db4\u0db1\u0dba\u0db1 \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dba\u0d9a\u0dcf\u0da7 \u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc2\u0dba\u0dba\u0db1\u0dca\u0db8 \u0dba\u0dc3\u0dc0\u0dc0\u0dcf \u0d85\u0d82\u0dca\u0dba\u0dda \u0dc1\u0dd4\u0dc1\u0dca\u200d \u0dbd\u0dba\u0dda\u0dd0\u0db6\u0dd3\u0db8\u0dca \u0daf\u0dca\u200d\u0dba \u0dc0\u0dbb\u0dca\u0dae\u0dca\u200d\u0db1\u0dba \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1 \u0d85\u0db4\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0dbd\u0dba\u0dda\u0dd0\u0db6\u0dd2\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 2024\u0da7 \u0dc3\u0dcf\u0dba\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dc0 \u0db6\u0dd0\u0dbd\u0dd4\u0dc0\u0dcf\u0db8 \u0d87\u0dba\u0db8\u0daf\u0dd2\u0d9a\u0dcf\u0db1\u0dd4 \u0dba\u0da9\u0dcf\u0dbd\u0dba\u0dda\u0dbb\u0dca\u0dae \u0db6\u0dd2\u0dd2\u0dba\u0db1 189\u0d9a\u0dca \u0dc0\u0dd4\u0dab\u0dd4 \u0d91\u0d9a 281 \u0daf\u0dca\u200d\u0dba\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0dbb\u0dca\u0dae\u0dca\u200d\u0db1\u0dba \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1 \u0d85\u0db4\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0dbd\u0dba\u0dda\u0dd0\u0db6\u0dd2\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc2\u0dba\u0dba\u0db1\u0dca \u0dc0\u0dd2\u0dba\u0dc1\u0dd3\u0dba\u0dba \u0dba\u0dc3\u0dc0\u0dc0\u0dcf \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0dc1\u0db1 \u0d8b \u0db8\u0dd4\u0dd4 \u0dc3\u0dc4 \u0dab\u0dbb\u0dc0\u0db1\u0dca \u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0dba\u0dc3\u0dc0\u0dc0\u0dcf \u0d86\u0dca\u200d\u0dbb\u0dd2 \u0d85\u0d82\u0dca\u0dad\u0dca \u0dc0 \u0db1 \u0dba\u0dd4\u0dab\u0dd4 \u0dba\u0dc0\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0d92 \u0dc0\u0dcf\u0dba \u0db8 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dca\u0db4\u0dd0\u0dba\u0dd3\u0db8\u0dca \u0d85\u0d82\u0dca\u0dad\u0dca \u0dc0 \u0db1 \u0dba\u0dd4\u0dab\u0dd4 \u0dba\u0dc0\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0dba\u0dc3\u0dc0\u0dc0\u0dcf \u0d85\u0db4\u0db1\u0dba\u0db1\u0dba\u0da7 \u0d85\u0daf\u0dca\u200d\u0dba\u0dcf\u0dc5\u0dc0 \u0dba \u0dcf\u0dbb\u0dc0\u0dbb\u0dd4 \u0dcf\u0d9a\u0dca\u0dc2\u0dab\u0dba \u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0d82\u0dca\u0dad\u0dca \u0dc0 \u0daf\u0dca\u200d\u0dba\u0dd0\u0db1\u0dca \u0db1 \u0dba\u0dd4\u0dab\u0dd4 \u0dba\u0dc0\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8\n\n\u0dba\u0db8\u0dca \u0d85\u0dc0\u0dc3\u0dc0\u0dae\u0dcf\u0dba\u0dda\u0daf\u0dd3 \u0db8\u0db8 \u0dc0\u0dd2\u0db1\u0dd2\u0db8\u0dba \u0d85\u0db1\u0dd4\u0db4\u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0\u0dad\u0dca \u0dc0 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd18 2023-2024 \u0d9a\u0dcf\u0dbd\u0dba\u0dda\u0dba \u0d9c\u0dad\u0dca \u0dc0\u0dba \u0dcf\u0dad\u0dca \u0dc0\u0d8b \u0dba\u0da9\u0dcf\u0dbd\u0dba\u0dda\u0dbb\u0dba\u0dda \u0d85\u0d9c\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dcf 327 \u0da7\u0d8b \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dcf 328\u0da7 \u0d9c\u0dd2\u0dba \u0d9a\u0dcf\u0dbd\u0dba\u0dda\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf8 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2\u0d8b \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0dba\u0dda\u0dba\u0da7 \u0d91\u0db1\u0dca\u0db1\u0da7 \u0d9a\u0dd2\u0db1\u0dca \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0dbb\u0da7 \u0d87\u0dc0\u0dba\u0dc5\u0dc0 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca \u0dc0\u0db8\u0d9a \u0dba\u0dc0\u0dc1\u0db1 \u0d8b \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0d8b \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda \u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dca \u0dc0\u0dc0\u0dba \u0d87\u0dc0\u0dc5\u0dd4 \u0d92 \u0db4\u0dd2\u0daf\u0dd2\u0dc3 \u0dba\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0daf\u0dca\u200d\u0dba \u0d9a\u0dd2\u0dda\u0dba\u0dda? \u0dba\u0da9\u0dcf\u0dbd\u0dba\u0dda\u0dbb\u0dba\u0dda \u0d85\u0d9c\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dcf 400\u0da7 \u0dba\u0dba\u0dd2 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf8 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2\u0d8b \u0d85\u0daf\u0dca\u200d\u0dba \u0d85\u0db4\u0dd2 \u0dba\u0da9\u0dcf\u0dbd\u0dba\u0dda\u0dbb\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dcf 300\u0d9a\u0da7 \u0d86\u0dc3\u0db1\u0dca\u0db1 \u0d85\u0d9c\u0dba\u0d9a \u0dbb\u0db3\u0dc0\u0dcf \u0d9c\u0db1\u0dd2\u0dd2\u0dba\u0db1\u0dca \u0dca \u0dcf\u0db8 \u0dba\u0dc4\u0dcf\u0db3 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba\u0d9a\u0da7 \u0dbd\u0dba\u0dda\u0d9a\u0dca \u0d9a\u0dbb\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8\n\n\u0d8a\u0da7 \u0d85\u0db8 \u0dbb\u0dc0 \u0d85\u0db4\u0db1\u0dba\u0db1 \u0d9a\u0dca\u0dba\u0dc2\u0dc0\u0dad\u0dca\u200d\u0dbb\u0dba\u0da7 \u0d85\u0daf\u0dca\u200d\u0dba\u0dcf\u0dc5\u0dc0 \u0d9c\u0dad\u0dca \u0dc0 \u0dcf\u0db8\u0d8b \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d9a\u0dcf\u0dbd\u0dba\u0dda\u0dba\u0dda \u0dbb\u0da7 \u0db8\u0dd4\u0dd4 \u0dab \u0db1\u0dca \u0dca\u200d\u0dbb\u0dca\u0dc0\u0db1 \u0dd2\u0d9a \u0daf\u0dca\u200d\u0dba\u0dd0\u0db1\u0dca \u0d85\u0db4\u0da7 \u0dba\u0dc4\u0dcf\u0db3\u0dd2\u0db1\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0dbd\u0dba\u0dda\u0dd0\u0db6\u0dd2\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf8 \u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dc0\u0db8\u0db1\u0dd2\u0d8b \u0d87\u0dba\u0db8\u0daf\u0dd2\u0d9a\u0dcf\u0dba\u0dc0\u0db1\u0dca \u0db4\u0db1\u0dc0\u0db4\u0dd4 \u0dad\u0dd3\u0dbb\u0dd4\u0db6 \u0da7\u0dba\u0dba\u0da7 44 \u0da7\u0da7 \u0da7\u0dba\u0dba\u0da7 20 \u0daf\u0dca\u200d\u0dba\u0d9a\u0dca\u0dc0\u0dcf \u0d85\u0da9\u0dd4 \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dad\u0dca \u0dc0 \u0d85\u0db4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0