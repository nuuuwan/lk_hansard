    "chunk_text": "\u0d89\u0da9\u0db8\u0dca release \u0dda\u0dbb \u0dc0\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf\u0db8 - \u0db8\u0dca \u0d85\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dc0\u0dae\u0dcf \u0dda\u0daf\u0dd3 \u0dbb\u0dbb\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dda \u0dd2 \u0da2\u0dca\u200d\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0dca \u0dc3\u0dca\u0dad\u0dca\u200d\u0db7\u0dcf \u0dda \u0d89\u0d9c\u0dda \u0dc0\u0dcf - \u0d92 \u0db8 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dcf\u0dda\u0da0\u0dca\u0da1\u0dcf\u0dc0\u0dda\u0dbd\u0db8 \u0d85\u0db4\u0dd2 \u0d87\u0dd2\u0dc1\u0dbd\u0dca\u0dbd \u0d8b\u0dcf \u0d85 \u0db4\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0dca \u0d89\u0daf\u0dd2\u0db1\u0dca\u0db0\u0dad\u0dca \u0dda\u0dbb\u0dbd \u0d8b\u0dcf \u0dad\u0dd2 \u0dbd \u0dc0\u0dcf, \u0d92 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db8\u0dca\u0dbd\u0d9c\u0dda\u0dbb\u0dc0. \u0db0\u0db1\u0dca\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf Department of Forest Conservation \u0dbd \u0dad\u0dca \u0d87\u0dad\u0dd2 \u0d89\u0da9\u0db8\u0dca \u0dd2\u0dca\u200d \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc0 \u0dda\u0dbb \u0dc0\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0db8\u0dca, \u0d92\u0dda \u0dda\u0dbb\u0d9c\u0dda \u0d95 \u0dd1. \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0db8\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d \u0d9a\u0dd2\u0d9f\u0dba\u0db0 \u0dda\u0dbd \u0dda\u0db8\u0dd2\u0d9c\u0dda \u0db8\u0da9\u0dda\u0dbd \u0d8b\u0dbb \u0dc0\u0dbd \u0d87\u0dd2\u0dc1\u0dbd\u0dca\u0dbd \u0d8b\u0dcf \u0db8\u0da9\u0dda\u0dbd \u0d8b\u0dbb \u0dda \u0dad\u0dd2 \u0dbd \u0d89\u0da9\u0db8\u0dca \u0dd2\u0dad\u0dda \u0dd2\u0dca\u200d \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc0 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0dbd\u0dcf\u0dc0 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0d89\u0dad\u0dd2\u0d9c\u0dda \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0db0\u0dd2 \u0dca\u200d\u0d9a\u0dca\u0d9a\u0dba \u0d9c\u0dd2\u0d9f\u0dba\u0dbd\u0dca\u0dbd \u0d8b\u0dcf \u0d85\u0db4\u0dd2 \u0dab\u0dc0\u0daf\u0dd4\u0dbb\u0dbd\u0dad\u0dca \u0d89\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0d9c\u0dda \u0d95 \u0dd1. \u0d91 \u0db8 \u0dad\u0dd2\u0dc0 \u0d85\u0db4\u0dd2 \u0dab\u0dc0\u0daf\u0dd4\u0dbb\u0dbd\u0dad\u0dca \u0dda\u0dae\u0dcf \u0dda \u0dcf\u0db8 \u0d85\u0db4\u0dd2\u0dc0 \u0da2\u0dca\u200d\u0dcf\u0dad\u0dd2\u0dc0\u0dcf\u0daf\u0dd3\u0d9c\u0dda, \u0dad\u0dca \u0db8\u0dca \u0dd2\u0dbd\u0dca \u0dbd\u0dbd \u0d8b\u0dda\u0dcf , \u0dad\u0dca \u0db8\u0dca \u0dbb\u0dcf\u0da2\u0dca\u200d\u0db0\u0d9a\u0dca\u0d9a\u0dba\u0dc2 \u0d85\u0dc0\u0dab\u0dcf\u0dbb, \u0d94\u0d9c\u0dda \u0d94 \u0dc0\u0dcf \u0db6 \u0db0\u0dd2 \u0dc0\u0dbd\u0dca \u0d9a\u0dd2 \u0dbd \u0d8b\u0dcf \u0daf\u0dd2\u0db1\u0dbd\u0db8 \u0dbd\u0dbd \u0d8b \u0d9c \u0d89\u0d9c\u0dda \u0dbb \u0dc5\u0dd4\u0dc0\u0d9c\u0dda \u0d9a\u0dd2 \u0dbd \u0d8b\u0dcf \u0d9f\u0dba\u0dab\u0d9c\u0dda \u0d91\u0db0\u0dcf. \u0db8\u0dcf\u0dda\u0dca\u200d, \u0d85 \u0db4\u0dca \u0da2\u0dca\u200d \u0dab\u0dcf\u0dc0\u0dad\u0dca \u0db8\u0dcf \u0dad\u0dd2 \u0dbd \u0d85 . \u0d94\u0dc0\u0dd4\u0d9c\u0dda \u0d89\u0dab\u0dcf \u0db0 \u0daf\u0dd2\u0db8\u0dd2\u0dc0 \u0dad\u0dca\u0dbb\u0dd4\u0db8\u0dca \u0d85\u0dbb \u0db1 \u0dad\u0dd2 \u0dbd\u0d9c\u0dda \u0d9c\u0dda \u0db8\u0dca \u0da2\u0dca\u200d\u0dcf\u0dad\u0dd2\u0dda \u0da2\u0dca\u200d \u0dbd\u0dbd \u0d8b \u0dda\u0db1 \u0d9c \u0dbb\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dbd\u0dcf\u0dbb\u0dd4 \u0d9a\u0dd3\u0db8 \u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0d9c\u0dda \u0daf\u0dd2\u0db1\u0dbd\u0db8 \u0dbd\u0dbd \u0d8b \u0d9c \u0d89\u0d9c\u0dda \u0dbd\u0dbd \u0d8b\u0dcf \u0db0\u0dcf \u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4\u0db8 \u0dc0 \u0dc0\u0dcf \u0d9a\u0dd2 \u0d91\u0dda. \u0dbd\u0dcf \u0dcf\u0db8 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc0\u0dad\u0dd4\u0db8\u0dad\u0dd2\u0dba\u0dd2.\n\n2505 2506\n\n[\u0db1\u0dbb\u0dd4 \u0dc2\u0dcf\u0db7\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dd2 \u0d9c\u0dda \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dbb \u0dad\u0dca\u0dad\u0dd2\u0dbb\u0d9c\u0dda \u0dbb\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0db8\u0dcf\u0dab\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda\u0db8\u0dca \u0db8 \u0dab\u0dcf]\n\n2025 \u0d85 \u0db1 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc0\u0dad\u0dd4\u0db8 22\n\n\u0db8\u0dd6\u0dbd \u0d8b\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d \u0dcf\u0dbb\u0dd6\u0daa \u0db1\u0dbb\u0dd4 \u0db8\u0d9c\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dd2, \u0d85 \u0db4\u0dca \u0dbb \u0da7\u0dca \u0dbb\u0dab\u0dca\u0da9\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0db1 \u0d9c\u0dda \u0d9c\u0dda \u0dbb \u0dab \u0dad\u0dd4\u0db8 \u0d9a\u0dd2\u0d9c\u0dda. \u0d92, \u0dd2\u0dc1\u0dbb\u0dcf \u0dda , \u0dc0\u0dba\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dc0\u0dae\u0dcf\u0dca\u200d\u0dcf \u0dda \u0dc3\u0dca\u0dad\u0dca\u200d \u0d85\u0db0\u0dcf\u0dda\u0dbb\u0db7 . \u0d92 \u0dbb \u0dab \u0dad\u0dd4\u0db8 \u0d9c\u0dda\u0db8 \u0db7\u0dcf\u0dd2\u0dc1\u0dab\u0dcf\u0dc0 \u0d87\u0dad\u0dd4\u0db8 \u0dc0 \u0db8\u0dcf\u0dda\u0d9a\u0dca\u0d9a\u0dba\u0dca\u200d \u0dd2\u0dc0\u0db0\u0dd2 \u0dbb \u0dc0\u0dd4 \u0dab\u0dca, \u0d85\u0da9\u0dd4 \u0dc0 \u0da9\u0dd2 \u0dc0\u0dca \u0d9c\u0dda? \u0d85\u0db4\u0dd2 \u0db1\u0dd2\u0dd4\u0dc4 \u0dd2\u0dc1\u0dbb\u0dcf \u0dda . \u0d85 \u0db4\u0dca \u0db1\u0dbb\u0dd4 \u0db6\u0dd2\u0db8\u0dbd\u0dca \u0dbb\u0dad\u0dca \u0dcf \u0dda \u0d85\u0db8\u0dcf\u0dab\u0dba\u0dc0\u0dbb \u0dcf \u0db6 \u0dda\u0dae\u0dcf \u0dc0\u0d9c\u0dda \u0db0\u0dd4\u0d9a\u0dc0 \u0d8c \u0db4\u0dd6\u0dbb\u0db7 \u0dc3\u0dca\u0dad\u0dca\u200d\u0d9f\u0dba\u0dab\u0dc0\u0dba\u0dd2 \u0db8\u0db8 \u0db8\u0dca \u0d9a\u0dd2 \u0d9c\u0dda \u0d9c\u0dda. \u0d91\u0d9a\u0dca\u0d9a\u0dba\u0dab\u0dbb\u0dcf \u0dc0\u0dda\u0dc0\u0dcf\u0db1\u0dd4\u0dc0\u0dda \u0dd2\u0dc1\u0dbb\u0dcf \u0dda -\u0dd2\u0dc1\u0dbb\u0dcf \u0dda \u0da2\u0dca\u200d \u0dcf\u0db0\u0dcf\u0db0\u0dad\u0dd2\u0dc0\u0dbb \u0dcf- \u0db8\u0dcf \u0dc0 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dd2\u0dc0\u0dda\u0db8\u0dca\u0dc0\u0dbd \u0d8b\u0dbd \u0dda\u0dcf\u0da0\u0dca\u0da0\u0dbb \u0dda\u0dd1\u0dca\u200d\u0dbb \u0dc0\u0dd4\u0db7\u0dcf\u0dca\u200d \u0d9a\u0dd2 \u0dc0\u0dcf \u0db8\u0dca, ' \u0dca\u200d\u0dc0\u0dab\u0dcf\u0dc0\u0d9a\u0dca\u0d9a\u0dba \u0dcf \u0dc0\u0dba\u0dd2, \u0da0\u0dd2\u0dbb\u0dcf\u0dad\u0dca \u0dda\u0dcf\u0dbd \u0d8b \u0d9a\u0dca\u0d9a\u0dba \u0db8\u0dbd \u0db8\u0dca \u0dd2\u0dc1\u0dbb\u0dcf \u0dda \u0d9a\u0dd2 \u0dbb \u0dab \u0d9c \u0d89\u0d9c\u0dda \u0d95 \u0dd1' \u0d9a\u0dd2 \u0dbd \u0d8b\u0dcf \u0dca\u200d \u0d85\u0dbd\u0dc0 \u0dbb\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dba\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dc0\u0dae\u0dcf \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc0 \u0dca \u0dbb \u0db1 \u0dbd\u0dca\u0dbd \u0d8b\u0dcf \u0db8\u0dca \u0db0\u0dcf\u0dca\u0db8\u0dd2 \u0db8\u0dca\u0d9c\u0dda\u0dad\u0dd4\u0db8 \u0dda \u0dc3\u0dca\u0dad\u0dca\u200d\u0db8\u0dca\u0db8\u0dab \u0dda\u0dbb\u0dc0\u0dcf \u0db1\u0dad\u0dca\u0dab\u0dcf. \u0d91\u0dca\u200d\u0dcf \u0d9f\u0dba\u0dbd\u0dbb \u0db8\u0d9c\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4 \u0d92\u0dda\u0dbd \u0d85\u0dab \u0d91 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dda\u0dc0\u0dcf. \u0d94\u0d9c\u0dda , \u0dd2\u0dc1\u0dbb\u0dcf \u0dda \u0d91\u0dca\u200d\u0dcf \u0dda\u0dbd\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dda\u0dbb\u0dbb \u0dd2\u0dc1\u0db0\u0dcf ! \u0dca\u200d \u0d9c\u0dda? \u0dca\u200d \u0d9c\u0dda \u0d89\u0d9c\u0dda 9\u0dc0 \u0da2\u0dca\u200d \u0dcf\u0db0\u0dcf\u0db0\u0dad\u0dd2\u0dc0\u0dbb \u0dcf, 0 \u0dd2\u0dc0\u0dbd 8 \u0dca\u200d\u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0dcf \u0dc0\u0dd6 \u0da2\u0dca\u200d \u0dcf\u0db0\u0dcf\u0db0\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0d9c\u0dda\u0dbd \u0dc0\u0da9\u0dcf \u0dc0 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc0. 9\u0dc0 \u0da2\u0dca\u200d \u0dcf\u0db0\u0dcf\u0db0\u0dad\u0dd2\u0dc0\u0dbb \u0dcf \u0dd2\u0dc1\u0dab\u0dbb\u0d9a\u0dca\u0d9a\u0dba \u0dca\u200d \u0d9c\u0dda \u0db7\u0dcf\u0dd2\u0dc1\u0dab\u0dcf \u0dc0\u0d9c\u0dda \u0db0\u0d9c\u0dda\u0dc0\u0dcf \u0dad\u0dd2 \u0dbd \u0dc0\u0dcf, \u0dbb\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dba\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dc0\u0dae\u0dcf\u0dc0\u0dbd \u0dbd\u0dad\u0dca \u0dda \u0d9a\u0dca\u0d9a\u0dba \u0d9a\u0dd2 \u0dbd \u0d8b\u0dcf. \u0d94\u0d9c\u0dda , \u0dc0 \u0dc3\u0dca\u0dad\u0dca\u200d!"
  },
