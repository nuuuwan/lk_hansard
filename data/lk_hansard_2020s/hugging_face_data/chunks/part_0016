    "chunk_text": "\u0dc0 \u0dc0\u0dc0\u0dd3\u0daf\u0dc3\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dca\u0daf\u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dc1\u0dba\u0dd3\u0dba\u0daf\u0dcf\u0dc3\u0daf\u0d9a \u0dca\u0db8\u0dd0\u0dad\u0dca\n\n\u0d89\u0dbd\u0dca\u0dbd\u0dd4 \u0dcf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0daf\u0dd2\u0dc1\u0dc3\u0dd2\u0db1\u0dca\u0daf\u0dad\u0dd2\u0dad\u0dca\u200d\u0db1\u0dd4\u0dd6\u0dbd\u0dbd\u0daf\u0dd2 \u0db8\u0dd2\u0dcf \u0daf\u0dad\u0dca\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dcf\u0dc3\u0daf\u0d9a \u0dca\u0db8\u0dd0\u0dad\u0dd2\u0daf\u0db6\u0dd0\u0dd2\u0dc1\u0db1\u0dca\u0daf: \u0db4\u0dd6\u0dbb\u0dca\u0dab\u0daf\u0d9a\u0dc1\u0dde \u0dbd\u0dd2\u0dcf\u0daf\u0d89\u0da9 \u0daf\u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0db4\u0daf\u0db1\u0dd2\u0dc1\u0dba\u0dd3\u0dba\u0dc0\u0da0\u0dd2\u0dad\u0dca\u0daf\u0dc0\u0dc1\u0dba\u0dd3\u0dba\u0d9a\u0db4\u0db1\u0dca\u0daf\u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dc1\u0dba\u0dd3\u0dba\u0daf\u0dcf\u0dc3\u0db1\u0dca \u0daf\u0db6\u0dd0\u0dc4\u0dd0\u0dc3\u0daf\n\n\uf0b7\uf020 \u0dc0 \u0daf:\u0dcf\u0d82\u0dc3\u0d9a\u0dca\u0dc2\u0dab\u0daf\u0d9a\u0daf\u0dc1\u0dcf\u0dbb\u0dca\u0dad\u0dca\u0d9a \u0db1\u0dca\u0dad\u0dd4\u0dc0\u0daf\n\n\u0dbb\u0dd4\u0daf\u0dcf\u0dae\u0dcf \u0dcf\u0db4\u0dcf\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0daf\u0d9a \u0daf: \u0db6\u0db1\u0dca\u0db0\u0dc0\u0daf\u0db8\u0db8\u0daf\u0daf\u0dc5\u0daf\u0d85\u0daf\u0dc4:\u0d9a\u0dca\u0daf\u0d89\u0daf\u0dbb\u0dd2\u0dc1\u0dad\u0dca\u0daf\u0dcf\u0dc3\u0db1\u0dca \u0dc3\u0daf\u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0db4\u0dcf\u0dc0\u0daf\u0daf:\u0dc0\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dcf\u0d9a\u0d85\u0daf\u0dc3\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dca\u0daf\u0d9a\u0dbd:\u0daf \u0dd0:\u0da8\u0dcf\u0daf\u0dcf\u0dc3\u0dbd\u0dcf\u0daf\u0dad\u0dd2\u0d9a\u0db6 \u0dc0\u0dcf \u0daf\u0d9a\u0dc4\u0d9a\u0dca\u0d9a \u0db4\u0dcf\u0dc3\u0daf41 049\u0dc345\u0d9a\u0dca\u0dc3\u0daf\u0db8\u0db1\u0dca \u0dcf\u0dc3\u0db8\u0daf\u0daf:\u0dc0\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dcf\u0d9