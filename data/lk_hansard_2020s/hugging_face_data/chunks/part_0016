    "chunk_text": "\u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc2\u0dba\u0dba\u0db1\u0dca \u0db8\u0db8 \u0dba\u0db8\u0dca \u0d85\u0dc0\u0dc3\u0dc0\u0dae\u0dcf\u0dba\u0dda\u0daf\u0dd3 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0db4\u0dd0\u0dc4\u0dd0\u0db1 \u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dd2\u0d8b \u0d87\u0dba\u0db8\u0daf\u0dd2\u0d9a\u0dcf \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0dc0 \u0da2\u0db1\u0db4\u0daf\u0dca\u200d\u0dba\u0dba \u0dc0\u0dd2\u0da7\u0db1\u0dca \u0d85\u0db4\u0da7 \u0db4\u0db1\u0dc0\u0db1 \u0dbd\u0dba\u0dda\u0daf\u0dca\u200d\u0dba \u0dad\u0dd3\u0dbb\u0dd4 \u0db6 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dca\u200d\u0dbb\u0dca\u0dc0\u0db1\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dca\u200d\u0dc08 \u0d85\u0dba\u0dda\u0dbd\u0dcf \u0db8\u0dcf\u0dc3\u0dba\u0dda 2\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dca\u200d\u0dba\u0dcf \u0d91\u0dba \u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dca\u0dba\u0da7 \u0db4\u0dad\u0dca \u0dc0 \u0d9a\u0dbb\u0dbd\u0dba\u0dda\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf\u0d8b \u0d85\u0dba\u0dda\u0dbd\u0dcf \u0db8\u0dcf\u0dc3\u0dba\u0dda 9\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dca\u200d\u0dba\u0dcf \u0da7\u0da7 \u0dba\u0db8\u0dca\u0d9a \u0db6\u0dbd\u0dba\u0dda\u0db4\u0dc0\u0dad\u0dca \u0dc0\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf8 \u0d87\u0dba\u0db8\u0daf\u0dd2\u0d9a\u0dcf \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0dc0 \u0da2\u0db1\u0db4\u0daf\u0dca\u200d\u0dba\u0dba \u0d85\u0dba\u0db4\u0dca \u0dbb\u0da7\u0da7 \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0db6 \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0db4\u0db1\u0dc0\u0db1\u0dba\u0d9a\u0dcf\u0da7 \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d91\u0dba \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db4\u0dd4 \u0db8\u0dd6\u0dbd\u0dba\u0dda\u0dca\u200d\u0dbb\u0dca\u0dae\u0db8\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf8 \u0d92 \u0db8\u0dd6\u0dbd\u0dba\u0dda\u0dca\u200d\u0dbb\u0dca\u0dae\u0db8\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0dbb\u0da7\u0dc0\u0dbd\u0dcf \u0dba\