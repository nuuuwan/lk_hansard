    "chunk_text": "\u0d9a\u0dbb\u0db4\u0dd4 \u0dd2\u0dad\u0dd2\u0dc4\u0dc1\u0dc3 \u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0d91\u0d9a\u0d9a\u0dca0 \u0d9a\u0dc1\u0dbd \u0d9a \u0dd2\u0db3\u0dbd\u0dc1 \u0dbb\u0da2\u0d9c\u0d86 \u0db1\u0dd2\u0dbd\u0dcf\u0dc1\u0db4\u0dad\u0db1\u0dca \u0d9c\u0dca\u200d\u0dbb\u0dc1\u0db8 \u0db1\u0dd2\u0dbd\u0dcf\u0dc1\u0db4\u0dad \u0db8\u0dc4\u0dad\u0dca\u0db8 \u0dc1 \u0d92 \u0dc0\u0dc1\u0d9c\u0dda\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0d9c\u0dd3\u0dba \u0d9c\u0dbd\u0dca\u0d9a\u0db8\u0dca\u0dad\u0dd4\u0db8\u0dc1 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d92 \u0dc3\u0dd2 \u0dbd\u0dd4\u0d9c\u0daf\u0db1\u0dc1\u0d9c\u0dda \u0daf\u0dd0\u0db1\u0dd4\u0dc0\u0dad\u0dca \u0dd2\u0dbb\u0dd3\u0db8 \u0db8\u0dc0\u0d9c\u0db6\u0ddd\u0dcf \u0d87\u0dad\u0dd4\u0d9c\u0dd9\u0dda \u0dad\u0db8\u0dba\u0dd2 \u0d9c\u0d9c\u0db8\u0dca \u0dc3\u0db8\u0dd2\u0dad\u0dd2 \u0db1\u0dd2\u0dda\u0db8\u0dc1\u0dab \u0d9a\u0d9c\u0dd9\u0dda0 \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c \u0ddd\u0da2\u0dba \u0d9a\u0dc1\u0dbb\u0d9a \u0dc3 \u0dc1\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2 \u0db1\u0dd2 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d9c\u0dc0\u0db1\u0daf\u0dc1\u0db4 \u0d9c\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0daf \u0dc0\u0dd4\u0d9c\u0da9\u0dd4? \u0d9c\u0dc0\u0db1\u0daf\u0dc1 \u0d9a\u0d9c\u0dd9\u0dda \u0dd2\u0dad\u0dc1\u0db8 \u0da0\u0dd6\u0da7\u0dd2 \u0dc3\u0db8\u0dd2\u0dad\u0dd2 \u0d9a\u0dd3\u0db4 \u0d9a\u0dca \u0dc4\u0dd0\u0daf\u0dd4\u0dc0\u0dc10 \u0db8\u0db8 \u0d9c\u0db8\u0dca \u0d92 \u0dc3\u0db8\u0dd2\u0dad\u0dd2\u0dc0\u0dbd \u0dc4\u0dd2\u0db4\u0db4\u0dd4 \u0d86\u0dd2\u0db1 \u0dad\u0dbb\u0dd4\u0dab \u0dad\u0dbb\u0dd4\u0dab\u0dd2 \u0db1\u0dca\u0db4 - \u0d86\u0dd2\u0db1 \u0d9c \u0dde\u0dc0\u0db1 \u0db1\u0dca\u0db4 - \u0db8\u0db4\u0dc4\u0dc1\u0dc3 \u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dc3\u0dad\u0dca\u0dc3\u0dc1\u0dc4 \u0d9a\u0dbb\u0db1\u0dc0\u0dc1 \u0d9c\u0db1\u0ddc\u0d9c\u0dc0\u0dba\u0dd20 \u0dad\u0dc0\u0dd4\u0db1\u0dca \u0d9c\u0db8 \u0d87\u0dad\u0dd4\u0d9c\u0dd9\u0dda \u0dc0\u0dd0\u0da9 \u0d9a\u0dd9\u0dc10 \u0db8\u0db4\u0db4 \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db1 \u0d9c\u0db8\u0dca\u0d9a\u0dba\u0dd20 \u0d9c\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db8\u0d9c\u0db4\u0dca \u0dc3\u0dc0\u0dc0\u0dc1\u0daf \u0d9a\u0dd4\u0dad\u0dca \u0d87\u0dad\u0dd2 \u0dc0\u0dd4\u0dab\u0dc10 \u0db8\u0db4\u0dd2 \u0d9c\u0db4\u0ddc\u0da9\u0dd2 \u0d9a\u0dc1\u0dbd\u0d9c\u0d86 \u0dd2\u0db3\u0dbd\u0dc1 \u0d9a\u0dae\u0dc1\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dc1 \u0d9c\u0d9c\u0db8\u0dca \u0db4\u0dd2\u0d9c\u0db4\u0db1 \u0db8\u0dbd\u0dca \u0d9c\u0d9c\u0db8\u0dca\u0db8 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dc1 \u0d91\u0dad\u0dd0\u0db1\u0dd2\u0db1\u0dca \u0d91\u0dc4\u0dc1\u0db4 \u0d91\u0db1\u0dca\u0d9c\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0dd2\u0dbb \u0dbd\u0dc10 \u0dd2\u0dad\u0dd2\u0db1\u0dca \u0d92 \u0db1\u0dd2\u0dc3\u0dc1 \u0db8\u0d9c\u0db4\u0dca \u0db8\u0dbb\u0db8\u0dd4\u0dab \u0dad\u0db8\u0dba\u0dd2 \u0d9c\u0d9c\u0db8\u0dca \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0daf\u0d9a\u0dca\u0dc2 \u0dad\u0dbb\u0dd4\u0dab \u0dad\u0dbb\u0dd4\u0dab\u0dd2\u0d9c \u0ddd \u0d9c\u0db8\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dc0\u0db4 \u0d9c\u0d9a\u0ddc\u0d9c\u0dc4\u0ddc\u0db8 \u0dc4\u0db4\u0dad \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dcf \u0d9a\u0dbb\u0d9c\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0dd2\u0dbb \u0db1 \u0d91\u0d9a0 \u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0db8\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9c\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0daf? \u0d9c\u0db8\u0dca\u0d9a \u0db4\u0da7\u0dd4 \u0dad\u0dd0\u0db1\u0d9a \u0dd2\u0db3\u0dbd\u0dc1 \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0dca \u0dad\u0dd0\u0db1\u0d9a\u0db4 \u0d9c\u0d9c\u0d9c\u0db1\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd10 \u0d92 \u0d9c\u0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0db1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0db8\u0db4\u0dd2 \u0d9c\u0db8\u0dca \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dc0\u0dd9 \u0dc3\u0dc0\u0dc0\u0dd2\u0dcf\u0dc1\u0db1 \u0d9a\u0d9c\u0dd9\u0dda0 \u0db8\u0db8 \u0dc3\u0d9c\u0dd3\u0dad\u0dca \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2 \u0db1\u0dc1 \u0d9a\u0dad\u0dd4\u0db8\u0dc1\u0db4 \u0dc3\u0dad\u0dca\u0dad\u0dbb \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dc10 \u0dbd\u0dc0\u0d9a\u0dc1\u0d9c\u0dda \u0db4\u0dd9\u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dad\u0dc1\u0dc0\u0db4 12 .00\u0d9a\u0db4 \u0dc0\u0dd0\u0da9\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dab \u0d9a\u0dca -\u0dc3\u0dd2 \u0db4 91\u0d9a\u0dca- \u0daf\u0dd0\u0db1\u0dca \u0db8\u0db4\u0dd2 youth clubs \u0db1\u0dd2\u0dda\u0db8\u0dc1\u0dab \u0d9a\u0dbb\u0dbd\u0dc1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dc10 \u0d9c\u0db8\u0dca youth clubs \u0da7\u0dd2\u0d9a \u0db1\u0dd2\u0dda\u0db8\u0dc1\u0dab \u0d9a\u0dd9\u0dc1\u0db4 \u0db4\u0dc3\u0dcf\u0d9c\u0dc3\u0dda \u0d92\u0d9a\u0db4 \u0db1\u0dd2\u0dbd\u0dcf\u0dc1\u0db4\u0dad\u0db1\u0dca \u0dc4 \u0d9c\u0daf\u0d9c\u0db1\u0d9a\u0dca \u0db4\u0dad\u0dca \u0d9c\u0dc0\u0db1\u0dc0\u0dc10 \u0d8a\u0db4 \u0db4\u0dc3\u0dcf\u0d9c\u0dc3\u0dda \u0d92 \u0dc4 \u0d9c\u0daf\u0db1\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0d9c\u0dd3\u0dba \u0d9c\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dc1\u0dda \u0dc1\u0dbd\u0d9c\u0d86 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0d9c\u0dd3\u0dba \u0dc3\u0db8\u0dca\u0d9c\u0db8\u0dca\u0dbd\u0db1 \u0d9c\u0d9c\u0ddc\u0da9\u0db1\u0d9f\u0db1\u0dc0\u0dc10 \u0db8\u0dbb \u0d9c\u0d9c\u0db8\u0dca \u0db8\u0dd6\u0dd2\u0db1\u0d9a \u0db1\u0dd2\u0dbd\u0dcf\u0dc1\u0db4\u0dad\u0db1\u0dca \u0dc4 \u0d9c\u0daf\u0db1\u0dc1\u0db4 \u0dad\u0db8\u0dba\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0d9c\u0dd3\u0dba \u0dc3\u0db8\u0dca\u0d9c\u0db8\u0dca\u0dbd\u0db1\u0d9c\u0d86 \u0da1\u0db1\u0dca\u0daf \u0db4 \u0dd2\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0d9c\u0dc0\u0db1\u0dca\u0d9c\u0db1\u0dca0 \u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0db4\u0dc1\u0d9c\u0dda \u0dc4\u0dd2\u0da7\u0dd2 \u0dc1 \u0dd2\u0dbb \u0dbd\u0dc1 \u0db4\u0d9a\u0dca\u0dc2 \u0d9a\u0dc1\u0dda \u0dc1\u0dbd \u0d9a \u0dc4\u0dd2\u0da7\u0dd2 \u0dc1 \u0dd2\u0dbb \u0dbd\u0dc1 \u0da1\u0db1\u0dca\u0daf \u0db4 \u0d91\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd00 \u0db8\u0db8 \u0dd2\u0dbb \u0db1\u0dca\u0d9c\u0db1\u0dca \u0d9c\u0db8\u0dca\u0dc0\u0dc1 \u0dd2\u0dbb \u0dc0\u0dbd\u0dc1 \u0db6\u0dbd\u0db1\u0dca\u0db1 \u0dd2\u0dbb \u0dbd\u0dc10 \u0d91\u0dad\u0d9c\u0d9a\u0ddc\u0db4 \u0d92\u0d9c\u0d9c\u0ddc\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0d9c\u0dda \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dca\u0d9c\u0dad\u0db1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0d9c\u0dd3\u0dba \u0db6\u0dbd \u0db8\u0da9\u0dd4\u0da9\u0dbd \u0db4\u0dad\u0dca \u0d9c\u0dc0\u0db1\u0dca\u0d9c\u0db1\u0dca0 \u0d9c\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc1\u0d9c\u0dd3\u0dba \u0db6\u0dbd \u0db8\u0da9\u0dd4\u0da9\u0dbd\u0d9c\u0d86 \u0db1\u0dd2\u0dbd\u0dcf\u0dc1\u0db4\u0dad\u0db1\u0dca \u0dc0\u0dd2\u0dcf\u0dc1 \u0d9a \u0db1\u0dd2\u0dbd\u0dcf\u0dc1\u0db4\u0dad\u0db1\u0dca \u0dc4 \u0d9c\u0daf\u0d9c\u0db1\u0d9a\u0dd4 \u0db1\u0db8\u0dca \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dc10 \u0d92 \u0dc4 \u0d9c\u0daf\u0db1\u0dc1 \u0d91\u0d9a\u0dad\u0dd4 \u0d9c\u0dc0\u0dbd\u0dc1 \u0dad\u0db8\u0dba\u0dd2 \u0dd2\u0db1\u0dc3\u0dcf\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dc3\u0db8\u0dca\u0d9c\u0db8\u0dca\u0dbd\u0db1 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dca\u0d9c\u0db1\u0dca0 \u0d92\u0d9c\u0d9c\u0ddc\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0db4 \u0dad\u0db8\u0dba\u0dd2 \u0da1\u0db1\u0dca\u0daf \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0d9c\u0db1\u0dca0 \u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0db4\u0dc1\u0d9c\u0dda \u0db1 \u0d9a\u0dc1\u0db4\u0dc0\u0dad\u0dca \u0da1\u0db1\u0dca\u0daf \u0d9c\u0daf\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd00\n\n\u0db8\u0d9c\u0db4\u0dca \u0dbb\u0d9c\u0da7\u0dca \u0db1\u0d9c \u0d9a\u0dca \u0dc0\u0db4\u0dd4 \u0d91\u0d9a\u0dba\u0dd2 \u0dc3\u0da9\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db1 \u0d91\u0d9a\u0dba\u0dd2 \u0dd2\u0dbb \u0dbd\u0dc1 \u0db1\u0dc1\u0dc5\u0dd2\u0d9a\u0dc1 \u0d9c\u0daf\u0d9a\u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dc10 \u0d92\u0d9c\u0d9a\u0dca \u0dc4\u0daf\u0db1\u0dc0\u0dc1 \u0d9c\u0db4\u0ddc\u0db1\u0dca \u0db4 \u0da7\u0dd2\u0d9a\u0d9a\u0dca0"
