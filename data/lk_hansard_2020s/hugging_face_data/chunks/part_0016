    "chunk_text": "\u0dba\u0db8\u0dca \u0db8\u0dcf\u0dc3 10\u0d9a \u0db4\u0db8\u0dab \u0d9a\u0dcf\u0dbd\u0dba\u0dda\u0dba \u0dc0\u0dc5 \u0db8\u0da7 \u0d87\u0dc4\u0dd2\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0d8b \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db4\u0dd4 \u0dc0\u0dd2\u0db0\u0dd2\u0dba8 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4 76\u0d9a \u0dca\u0dcf\u0db4\u0dba\u0d9a\u0dca \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf8 \u0dc0\u0dbb\u0daf\u0dca\u200d\u0dba\u0dcf\u0db1 \u0d9c\u0dad\u0dca \u0dc0 \u0dcf\u0d8b \u0dc0\u0dbb\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0daf\u0dca\u200d\u0dba \u0dbd\u0dba\u0dda\u0dd0\u0db6\u0dd4\u0dab\u0dcf\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf8 \u0dba\u0db8\u0dca\u0d9a \u0d9a\u0dd4\u0dc4\u0d9a \u0dba\u0dc1\u0dca\u0db4\u0dcf\u0dbd\u0dba\u0dda\u0db1\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf8 \u0d92 \u0dc0\u0dcf\u0dba \u0db8 \u0db8\u0dd1 \u0d9a \u0dca\u0db3\u0db1\u0dca \u0db4\u0da7\u0db1\u0dca \u0d9c\u0dad\u0dca \u0dc0\u0dba\u0dad\u0dca \u0dc0 \u0db8\u0da2\u0dbb \u0dba\u0dc1\u0dca\u0db4\u0dcf\u0dbd\u0dba\u0dda\u0db1\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf8 \u0dba\u0db8\u0dca \u0d94\u0d9a\u0dca\u0dba\u0d9a\u0ddd\u0db8 \u0d9a\u0dae\u0dcf \u0d9c\u0dad\u0dca \u0dc0 \u0dcf\u0db8 \u0db4\u0dcf\u0dbb\u0dca\u0dae\u0dd2\u0dba\u0db8\u0dca\u0db1\u0dca\u0dc0\u0dc0 \u0dc0\u0dc5 \u0d85\u0db4\u0da7 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d85\u0dc0\u0dca\u0dba \u0dc0\u0dd4\u0dba\u0da9\u0dd4\u0d9a\u0d8b \u0dba\u0db8\u0dca \u0dad\u0dd2\u0dba\u0db6\u0db1 \u0db6\u0dd0\u0dbb\u0dd1\u0dbb\u0dd4\u0db8\u0dca \u0dad\u0dca \u0dc0\u0dad\u0dca \u0dc0\u0dc0\u0dba \u0db8 \u0da2\u0db1 \u0dcf\u0dc0\u0da7 \u0d85\u0daf\u0dca\u200d\u0dba\u0da7 \u0dc0\u0da9\u0dcf \u0dba\u0dc4\u0da7 \u0dba\u0dc4\u0dcf\u0db3 \u0da2\u0dd3\u0dc0\u0dd2 \u0dba\u0d9a\u0dca \u0d9c \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0d9c\u0db8\u0db1\u0d9a\u0dca \u0dc4\