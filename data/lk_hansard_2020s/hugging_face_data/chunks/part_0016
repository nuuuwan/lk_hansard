    "chunk_text": "\u0da2\u0db1\u0dba\u0dcf\u0dca \u0db8\u0db0\u0dba\u0db8 \u0dc3\u0dcf\u0dc3\u0dae \u0dd8\u0dad\u0dd2 \u0d9c\u0dba\u0dd4\u0daf\u0daf\u0dbd; \u0d9c\u0db0\u0dba\u0d9a\u0dca\u0dc2\u0dba \u0da2\u0db1\u0dba\u0dcf\u0dca \u0dc0\u0dd9\u0dba\u0dc5 \u0dc3\u0dcf\u0dba\u0d9a\u0dca\u0dc2\u0dba\u0dab \u0dc0\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9; \u0d9c\u0db0\u0dba\u0d9a\u0dca\u0dc2\u0dba \u0da2\u0db1\u0dba\u0dcf\u0dca \u0dd9\u0dcf\u0dbb\u0dd2\u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0dc0\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9; \u0d9c\u0db0\u0dba\u0d9a\u0dca\u0dc2\u0dba \u0da2\u0db1\u0dba\u0dcf\u0dca \u0dd9\u0db1\u0da2\u0dd3\u0dd3 \u0dc0\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9; \u0d9c\u0db0\u0dba\u0d9a\u0dca\u0dc2\u0dba \u0da2\u0db1\u0dba\u0dcf\u0dca \u0dd9\u0db1 \u0dc3\u0dcf\u0dba\u0d9a\u0dca\u0dc2\u0dba\u0dab \u0dc0\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9; \u0d9c\u0db0\u0dba\u0d9a\u0dca\u0dc2\u0dba \u0da2\u0db1\u0dba\u0dcf\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf \u0dcf \u0dc3\u0dcf\u0da0\u0dcf\u0dba \u0dc3\u0dcf\u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0db1 \u0d9c\u0db0\u0dd2 \u0dcf\u0dbb\u0dd2\u0dba; \u0dca\u0d9c\u0db8\u0db1 \u0dd2\u0dc3\u0d9c\u0db8\u0db1 \u0db4\u0dcf\u0dbd \u0da2\u0db1\u0dba\u0dcf\u0dca \u0dca\u0d9c\u0db8\u0db1 \u0dc4\u0dcf \u0dd2\u0dc3\u0d9c\u0db8\u0db1 \u0dc0\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9; \u0d9c\u0db0\u0dba\u0d9a\u0dca\u0dc2\u0dba \u0da2\u0db1\u0dba\u0dcf\u0dca \u0db8\u0dc4\u0dd9\u0dd0\u0dd2 \u0dc3\u0dcf\u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0db1 \u0d9c\u0db0\u0dd2 \u0dcf\u0dbb\u0dd2\u0dba; \u0dc0\u0db4\u0dcf\u0dd2\u0dc3\u0dae\u0db4\u0dad\u0dd2 \u0dc0\u0db4\u0dcf\u0dd2\u0dc3\u0dae \u0dc0\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9 \u0d9c\u0dc0\u0db4\u0dca Senior Economic Adviser \u0daf\u0dd4\u0db8\u0dd2\u0db1\u0dca\u0daf \u0dc4\u0dd4\u0dbd\u0dcf\u0d9c\u0dd4\u0daf\u0dd9 \u0db8\u0dc4\u0dad\u0dcf \u0dc0\u0da2 \u0db1\u0dca \u0d9a\u0dd3\u0dca \u0dc3\u0dae \u0dc3\u0db8\u0dd6\u0dc4\u0dc0\u0d86 \u0dc3\u0dc0\u0dcf\u0db4\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc2\u0dba\u0dcf\u0db1\u0dca \u0dd9\u0dcf\u0dc0\u0dca \u0db1\u0dca\u0daf\u0dca\u200d\u0dbb \u0db8\u0dc4\u0dad\u0dcf \u0db1\u0dd2\u0dc4\u0dcf\u0dca \u0dd4\u0daf\u0dc4\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dda \u0db8\u0dc4\u0dad\u0dcf \u0db1\u0dd2\u0db1\u0dca \u0da2\u0dba\u0dc3\u0dd4\u0db1\u0dca\u0daf\u0dba \u0db8\u0dc4\u0dad\u0dcf \u0dc3\u0dd4\u0dba\u0db1\u0dca\u0da2\u0dd2\u0dad\u0dca \u0dd9\u0dd1\u0dd2\u0dc3\u0da7 \u0db8\u0dc4\u0dad\u0dcf \u0dc1\u0dd2\u0dc0\u0dba \u0db8\u0dcf\u0dca \u0dc0 \u0dc0\u0dbb\u0dca\u0dbd \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2\u0dba. \u0dc0\u0dda \u0d94\u0d9a\u0dca\u0dc0 \u0dcf\u0db8 \u0d9c\u0dba \u0dc0\u0db4\u0dd9\u0ddf\u0dda\u0d9c\u0dd2 \u0d9c\u0dcf\u0dc1\u0dc0\u0d86 \u0dc3\u0dcf\u0da0\u0dcf\u0dba \u0d9a\u0dca\u0dc0\u0dc2\u0dba\u0dae\u0dad\u0dca\u200d\u0dbb\u0dc0\u0d86 \u200d\u0dbb\u0dd3\u0dab\u0dba\u0db1\u0dca. \u0dc0\u0db8\u0db1\u0dca\u0db1 \u0dc0\u0dda \u0d9a\u0dd2\u0dba\u0db1 08\u0dc0\u0daf\u0db1\u0dcf\u0dc0\u0d9c\u0db1\u0dca \u0dad\u0dd4\u0d9a\u0dca\u0dad\u0dd9 \u0dad\u0db8\u0dd2 \u0d9c\u0dc5\u0dd2 \u0dc0\u0dda \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dcf\u0dbb\u0dca\u0dbd\u0dba \u0dc3\u0dcf\u0db0 \u0dd9\u0dbd \u0dcf\u0dba\u0da7 \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2 \u0dba\u0db1\u0dca \u0db4\u0dad\u0dca \u0dba \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dca\u0dc0\u0db1\u0dca.\n\n\u0dc6\u0dd2\u0db1\u0dd1\u0db1\u0dca\u0dc3\u0dae \u0dc3\u0db8\u0dcf\u0d9c\u0dda \u0dd2\u0dc3\u0dd2\u0db1\u0db1\u0dca \u0dab\u0dba \u0dc3\u0dc4\u0db1 \u0dcf\u0dbd \u0dc3\u0dd3\u0db8\u0dcf\u0dd9 \u0dad\u0dd4\u0dc5 \u0daf\u0da9 \u0dc0\u0db4\u0dcf\u0dbd\u0dd3 \u0d9c\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc5\u0dd2\u0db6\u0db3\u0dd9\u0d9a\u0dd9 \u0d9c\u0dbb\u0dd4 \u0dd4\u0daf\u0daf\u0dca \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dc0\u0d9c\u0db1\u0dca \u0db8\u0db8 \u0dc0\u0dda \u200d\u0dbb\u0dc1\u0dae\u0db1\u0dba \u0d9c\u0dc4\u0db1\u0dd9\u0dcf. \u0db8\u0dc4 \u0dd9\u0dd0\u0dcf\u0dc0 \u0da0\u200d\u0dbb\u0dc0\u0dca \u0d9b\u0dca\u200d \u0d9c\u0dcf (020.) \u0d8d\u0da2\u0dd4\u0dd9\u0db8 \u0d8b\u0dca \u0dbd\u0dcf\u0d9d\u0db1\u0dba \u0dba\u0db8\u0dd2\u0db1\u0dca \u0dc0 \u0dcf\u0dd2\u0dc3\u0da9\u0dca-. \u0dab\u0dba \u0dc3\u0dc4\u0db1 \u0dcf\u0dbd \u0dc3\u0dd3\u0db8\u0dcf\u0dd9 \u0dad\u0dd4\u0dc5 \u0db1\u0dd3\u0dad\u0dd2 \u0dd2\u0dc3\u0dc0\u0dba \u0db0\u0dd2 \u0dc0\u0dbd\u0dc3 \u0daf\u0da9 \u0dc0\u0db4\u0dcf\u0dbd\u0dd3 \u0d9c\u0dcf\u0dc3\u0dae\u0dad\u0dd4 \u0db4\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0dda\u0dd9\u0db1\u0dca\u0db0\u0dc0\u0dba\u0db1\u0dca \u0db1\u0dd2\u0dba\u0db1\u0dca\u0dad\u0dba\u0dc0\u0dba\u0db1\u0dca \u0dd9\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf \u0dc0 . \u0dc0\u0dda \u0dc3\u0dda\u0dd9\u0db1\u0dca\u0db0\u0dc0\u0dba\u0db1\u0dca \u0dd9\u0db1 \u0d91\u0d9a\u0dca \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dd9\u0d9a\u0dca \u0dd9\u0db1\u0dca\u0dc0\u0db1\u0dca \u0db8\u0dc4\u0db1\u0dd4\u0dd9\u0dba \u0db4\u0daf\u0dd2\u0dcf\u0da0\u0dd2 \u0d9c\u0dc3\u0dae\u0dbd\u0dda \u0db8\u0dbb\u0dd2\u0d9a\u0dca \u0dcf\u0dbb\u0dca\u0dbd \u0db8\u0dc4\u0dad\u0dcf \u0dd2\u0dc3\u0dd2\u0db1\u0db1\u0dca \u0db8\u0dc4 \u0dd9\u0dd0\u0dcf\u0dc0 \u0dd9\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dba\u0db1 \u0dbd\u0daf \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dca \u0dbd\u0dd2. (\u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dd2 \u0d9c\u0dcf \u0dba: 020./NOV/0052)\n\n\u0d91\u0dc0\u0dc3\u0dae\u0db8 \u0db8\u0dc4 \u0dd9\u0dd0\u0dcf\u0dc0 \u0da0\u200d\u0dbb\u0dc0\u0dca \u0d9b\u0dca\u200d\u0dba\u0da7 \u0d9c\u0db1\u0dd4\u0dd6\u0dbd\u0dbd\u0dad\u0dcf\u0dd9\u0d9a\u0dca \u0dc0\u0db1\u0dcf\u0daf\u0d9a\u0dca\u0dd9\u0dcf \u0da7\u0dad\u0dd4\u0dad\u0dd4 \u0dba\u0db8\u0dd2\u0db1\u0dca \u0dc6\u0dd2\u0db1\u0dd1\u0db1\u0dca\u0dc3\u0dae \u0dc3\u0db8\u0dcf\u0d9c\u0dda \u0dd2\u0dc3\u0dd2\u0db1\u0db1\u0dca \u0db8\u0dd6\u0dbd\u0dba\u0db8\u0dba \u0dd2\u0dc3\u0dc2\u0dba\u0db8\u0dcf\u0da0\u0dcf\u0dba\u0dba\u0d9a\u0dca \u0dd2\u0db1\u0daf\u0dd4 \u0dba\u0db1 \u0dbd\u0daf \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2 \u0d91\u0d9a\u0dca \u0d9c\u0dd9\u0dc3\u0dae\u0dcf\u0dcf\u0dd9\u0d9a\u0dca \u0dc0\u0db8\u0dba \u0dc0\u0dd4\u0dd9\u0dad\u0dca \u0d91\u0dd9\u0dd0\u0db1\u0dd2 \u0dad\u0dd9\u0dad\u0dca \u0dc0\u0dd9\u0dcf\u0dc0\u0dc4 \u0d9c\u0dd9\u0dc3\u0dae\u0dcf\u0dcf \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dc4\u0dd0\u0d9a\u0dd2\u0dba."
