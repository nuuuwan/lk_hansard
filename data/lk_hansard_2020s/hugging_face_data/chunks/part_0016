    "chunk_text": "\u0dd6\u0dbd\u0dd2\u0d9a1 \u0dad\u0da9\u0dd4\u0d9a\u0dca1 \u0db4\u0dad\u0dca\u0dc11\u0da0\u0dcf \u0dcf\u0dcf\u0dc3 5 \u0d9a \u0dad\u0dad\u0dd4\u0db8\u0db1\u0dad \u0d85\u0db4\u0da7 \u0dc1\u0db8\u0dca \u0dad\u0d9a\u0dcf\u0dba\u0dc1\u0dad \u0db4\u0db1\u0dad\u0dca \u0dc1\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad\u0d9a \u0dc1\u0d9c\u0db1 \u0d91\u0db1\u0dca\u0db1 \u0dc3\u0daf\u0dca\u0db0 \u0dc0\u0dd4\u0dc1\u0da9\u0dd4\u0d9a\u0dcf, \u0db8\u0dd3\u0da7 \u0d9a\u0dd2\u0db1\u0dca \u0db4\u0db1\u0dad\u0d9a \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0db1\u0dd2\u0dc3\u0dcf \u0dc3\u0dd4 \u0d92 \u0db4\u0db1\u0dad \u0dc11\u0db1\u0dc3\u0dda \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0d851 \u0dba \u0dc0\u0dd4\u0dab\u0dd4 \u0db1\u0dd2\u0dc3\u0dcf\u0db1\u0dca. \u0d92 \u0db4\u0db1\u0dad \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1[\u0db1\u0dca \u0dc0\u0dd2\u0dc1\u0dda\u0db1\u0db1[\u0d9a \u0d85\u0db4\u0da7 \u0dcf\u0dd0\u0dad\u0dd21\u0dba\u0dab[\u0da7 \u0dc1\u0db4\u0dba\u0dad\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf, \u0daf\u0dd0\u0db1\u0dd4\u0dad\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dcf. \u0d85\u0db4\u0dd2 \u0dcf\u0dd0\u0dad\u0dd21\u0dba\u0dab[\u0da7 \u0dc1\u0db4\u0dba \u0dd2\u0dbb[\u0db4\u0dd4 \u0dad\u0d9a\u0dcf\u0dba[\u0da7 \u0daf\u0dd0\u0db1\u0dca \u0d85\u0db4\u0da7 \u0d92\u0d9a \u0dc11\u0db1\u0dc3\u0dda \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0d851 \u0dba \u0dc11\u0da0\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dcf. \u0d92\u0d9a \u0d85\u0daf\u0dd9\u0dad\u0dca \u0dc1\u0daf[\u0d9a \u0dc1\u0db1\u0dcf\u0dc11\u0db1\u0dca. \u0dc1\u0db8\u0dca\u0d9a \u0d85\u0db4\u0dd2 \u0db8\u0dd4\u0da0 \u0d89\u0db3\u0da0\u0dcf\u0dcf \u0dd2\u0dbb\u0dda1\u0dcf. \u0dd6\u0dbd\u0da0\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dc0 \u0dcf\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dd2, 2 20 \u0db4\u0db1\u0dad \u0d9c\u0dd0\u0db1 \u0d85\u0db4\u0da7 \u0dd6\u0dbd\u0dd2\u0d9a1\u0dcf \u0dc0\u0dd2\u0dc1\u0dda\u0db1\u0db1[\u0d9a \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf. \u0dc1\u0db8\u0dca \u0dba\u0da7 \u0db6\u0d82\u0dc1\u0d9a\u0dcf\u0dc1\u0da0\u0dcf\u0dad\u0dca \u0dc11\u0da0\u0dcf \u0d94\u0d9a\u0dc1\u0d9a\u0ddd\u0dcf \u0dc11\u0da0\u0dcf \u0d891\u0dba \u0dc0\u0dd4\u0dab\u0dcf\u0da7 \u0db4\u0dc3\u0dda\u0dc1\u0dc3\u0dda, \u0daf\u0dd0\u0db1\u0dca \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db6\u0da0 \u0dcf\u0da9\u0dd4\u0d9a\u0da9\u0da0[ \u0dad\u0dd4\u0db8\u0db1 \u0dca\u200d\u0dbb \u0dda\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dcf \u0dd2\u0dbb[\u0da0\u0dcf \u0d85\u0db4\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0db11\u0dcf. \u0dd4\u0dd0\u0db6\u0dd0\u0db1\u0dca, \u0dca\u200d\u0dbb \u0dda\u0db1 \u0dc0\u0dd2\u0dc3\u0db3\u0db1\u0dca\u0db1 \u0dc3\u0dcf\u0db0\u0dd3\u0db8[ \u0dca\u200d\u0dbb\u0dc1\u0dda [\u0d9a \u0d851 \u0dba\u0db1\u0dca \u0dc1\u0db1\u0dca. \u0d92 \u0dca\u200d\u0dbb \u0dda\u0db1 \u0d85\u0dad\u0dba \u0dc1\u0db8\u0dca\u0dc1\u0d9c\u0dcf\u0dca \u0dc1\u0da0\u0ddd \u0dad\u0da9\u0dd4\u0d9a\u0dca, \u0d9a\u0dba\u0db4\u0dd4 \u0d9a\u0dba\u0db4\u0dd4 \u0d851\u0dc3\u0dda\u0d9c\u0dcf1\u0da0 \u0dc1\u0dc3\u0dda1\u0d9a\u0dc1[\u0ddd \u0db6\u0db31\u0dcf\u0d9c\u0db1\u0dca\u0db1, -\u0dc1\u0dc3\u0dda1\u0d9a\u0dc1[\u0ddd \u0db4\u0dd4\u0dba1\u0dcf\u0d9c\u0db1\u0dca\u0db1- \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dba \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dc1\u0dcf\u0dad\u0dd0\u0db1 \u0d85\u0d9a\u0dcf\u0dbb\u0dca[\u0d9a\u0dc2\u0dca\u0da8\u0dcf\u0dad\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dcf. \u0d92 \u0dc1\u0daf\u0dca1\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf. \u0dd4\u0dd0\u0db6\u0dd0\u0db1\u0dca, \u0db1\u0dd01\u0dad \u0d92 \u0dd2\u0dba\u0db1\u0dd2\u0d9a\u0db8\u0db1\u0dca\u0dc1 \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dad\u0dca \u0d9a\u0db8\u0dba\u0d9a\u0dd2\u0dad \u0d9a\u0dba\u0db1 \u0d9c\u0dcf\u0db1\u0dca, \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db6\u0da0 \u0dcf\u0da9\u0dd4\u0d9a\u0da9\u0da0[\u0dad\u0dca \u0d9a\u0db8\u0dba\u0d9a\u0dd2\u0dad \u0d9a\u0dba\u0db1 \u0d9c\u0dcf\u0db1\u0dca, \u0dba\u0dc1\u0da7\u0dca \u0dad\u0dbb\u0dca\u0dd2\u0d9a, \u0dc1\u0daf\u0dca \u0db4\u0dcf\u0da0\u0db1 \u0daf\u0dd2 \u0dcf1\u0dad\u0dca \u0d9a\u0db8\u0dba\u0d9a\u0dd2\u0dad \u0d9a\u0dba\u0db1 \u0d9c\u0dcf\u0db1\u0dca \u0dad\u0dcf\u0db1\u0dca \u0dc1\u0db8\u0dca\u0d9a \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dc1\u0dcf\u0dcf\u0d9a\u0daf, \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0d9a\u0d9c\u0dcf \u0d9a\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dba\u0da7\u0d9a \u0db6\u0da0 \u0d9a\u0dad\u0dd2[ \u0d9c\u0dd0\u0db1\u0db1\u0dca.\n\nWorld Bank \u0d91\u0d9a \u0db4\u0dd0\u0dad\u0dca\u0dad\u0dd2\u0dbb\u0db1\u0dca \u0dad\u0dd2[\u0db1\u0dca\u0db1\u0dc1\u0d9a\u0ddd. \u0db1\u0dcf\u0dcf\u0dca \u0dba\u0dcf\u0da2\u0db4\u0d9a\u0dc2\u0dca\u0da8 \u0dcf\u0dd4\u0dad\u0dca\u0dad[\u0dcf\u0dc1 \u0dad\u0dcf\u0dad\u0dca\u0dad\u0dcf -\u0dcf\u0dc4\u0dd2\u0db1\u0dca\u0daf \u0dba\u0dcf\u0da2\u0db4\u0d9a\u0dc2\u0dca\u0da8 \u0dcf\u0dd4\u0dad\u0dca\u0dad[\u0dcf- \u0d9c\u0dd2[ \u0d85\u0dc0\u0dd4\u0dc0 \u0daf\u0dca\u0dc1\u0daf\u0dca \u0dcf\u0dd0\u0db1\u0dca \u0dcf\u0dcf\u0dc3\u0dc1\u0dad 531\u0dd0\u0db1\u0dd2 \u0daf\u0dcf \u0db4\u0dba\u0dab \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db6\u0da0 \u0db4\u0db1\u0dad\u0da7 \u0d85\u0daf\u0dcf\u0db11 \u0dca\u200d\u0dbb\u0dc3\u0daf\u0dca\u0db0 statement \u0d91\u0d9a\u0d9a \u0d9a\u0dba\u0db11\u0dcf. \u0dcf\u0dcf\u0db0\u0dba1\u0da0 \u0d92 \u0dd2\u0db4\u0dd2[ \u0db4\u0db1 \u0dc0\u0dd4\u0dab\u0dcf, \u0dc1\u0dd4\u0dcf[\u0da0\u0dcf \u0db6\u0da0\u0db1\u0dca\u0db1, \u0d92\u0dc1\u0d9a \u0dd2\u0dbb[\u0db11\u0dcf, \"\u0da1\u0db1\u0dca\u0daf[ \u0d851\u0dc3\u0db1\u0dca \u0dc11\u0db1\u0d9a\u0dca 1\u0dad\u0dca \u0dc1\u0db8\u0dca\u0d9a \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf. \u0dba\u0dcf\u0da2\u0dba \u0dc1\u0daf\u0dca\u0db4\u0db1 \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0db1 \u0d91\u0d9a \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf\" \u0dd2\u0dbb[\u0da0\u0dcf , \u0d9c\u0dd2[ \u0d85\u0dc0\u0dd4\u0dc0 \u0daf\u0dca\u0dc1\u0daf\u0dca \u0dcf\u0dd0\u0db1\u0dca 531\u0dd0\u0db1\u0dd2 \u0daf\u0dcf \u0db4\u0dd01\u0dad\u0dd2 \u0db4\u0db1\u0dad \u0d9c\u0dd0\u0db1\u0dad\u0dca \u0dd2\u0dbb[\u0db11\u0dcf. \u0dc1\u0db8\u0dca \u0db4\u0db1\u0dad\u0dca \u0dc1\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dad\u0dca \u0d92\u0d9a\u0dcf \u0db1\u0db8\u0dca, \u0db1\u0dcf\u0dcf\u0dca \u0dba\u0dcf\u0da2\u0db4\u0d9a\u0dc2\u0dca\u0da8 \u0dcf\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dcf \u0dc1\u0dcf\u0dad\u0dd0\u0db1\u0da7 \u0dad\u0dc0\u0dd2\u0dca \u0da0\u0dcf \u0dd2\u0dbb[\u0da0\u0dcf \u0dd4\u0dbb\u0dd2[\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dd4\u0dd0 \u0dc1\u0db1\u0dca. \u0dcf\u0dc4\u0dd2\u0db1\u0dca\u0daf \u0dba\u0dcf\u0da2\u0db4\u0d9a\u0dc2\u0dca\u0da8 \u0dcf\u0dd4\u0dad\u0dca\u0dad[\u0dcf \u0dd2\u0dba\u0dd4\u0dcf\u0d9a1\u0dad\u0dca \u0d9c\u0dd4\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf [\u0dd0. \u0dc1\u0db8\u0dca \u0db4\u0db1\u0dad\u0dca \u0dc1\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad \u0dc11\u0db1\u0dc3\u0dda. \u0d92 \u0dc11\u0db1\u0dc3 \u0dad\u0dcf\u0db1\u0dca\u0da7 \u0dc1\u0dad\u0dca\u0dc1\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca, \u0dad\u0dcf\u0db1\u0dca \u0d921\u0dcf \u0d9c\u0dd0\u0db1 \u0dd2\u0dbb[1\u0da0\u0dcf \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0dc1\u0d9c\u0daf\u0dba \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0da0\u0dcf \u0dad\u0dcf\u0db1\u0dca\u0dc1 \u0db4\u0dd2[\u0dcf\u0dc1\u0d9c\u0db1\u0dca \u0dd4\u0dbb\u0dd2 \u0d85\u0dd4\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dad\u0dcf\u0db1\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0dcf \u0dd2\u0dba\u0dd4\u0dcf\u0d9a \u0d9c\u0dd4\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd4\u0db81 \u0d89\u0db1\u0dca\u0dc1\u0db1\u0dca."
