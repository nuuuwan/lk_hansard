    "chunk_text": "\u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0dc3\u0db8\u0dc4\u0dbb \u0db1\u0dd2\u0dc2\u0dcf\u0db4\u0dc1\u0daf\u0db1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dc1 \u0db8\u0db4\u0dd2\u0dad\u0dca \u0dc3\u0dd4\u0dc5\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dab\u0dc0\u0dd2\u0db1\u0db1\u0dca \u0db1\u0dd2\u0dc2\u0dcf\u0db4\u0dc1\u0daf\u0db1 \u0d9a\u0dbb\u0db10 \u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0dd2\u0dc2\u0dcf\u0db4\u0dc1\u0daf\u0db1 \u0d9a\u0dd9\u0dad\u0dca \u0db8\u0d9c\u0db4\u0dca \u0dbb\u0d9c\u0da7\u0dca \u0dc3\u0db8\u0dc3\u0dcf\u0dad \u0db4\u0db4\u0dad\u0d9c \u0ddd\u0da2\u0db1\u0d9c \u0db1\u0dca \u0dbb\u0d9c\u0da7\u0dca \u0db8\u0dc0\u0db1\u0dba\u0dad\u0dc1\u0d9c\u0dc0\u0db1\u0dca \u0dc3\u0dd2 \u0db4 10\u0d9a\u0db4\u0dad\u0dca \u0db8\u0d9a\u0dca\u0d9c\u0dc0\u0db1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d91\u0db8 \u0d9c\u0dd3\u0dba \u0db1\u0dd2\u0dc2\u0dcf\u0db4\u0dc1\u0daf\u0db1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0d9c\u0db1\u0dca0 \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0db8\u0dc0\u0dc3\u0dcf\u0dae\u0dc1\u0dc0\u0d9a \u0db6\u0dd3\u0daf\u0d9a\u0dca \u0db4\u0dd0\u0db1\u0dc0\u0dd3\u0d9c\u0db8\u0db1\u0dca \u0dc3\u0dd2 \u0db4 90\u0d9a\u0dca \u0d9c\u0dc0\u0dca\u0da0 \u0db8\u0d9c\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0db4\u0dc1\u0db4\u0dad\u0d9c \u0ddd\u0d9c\u0dd2\u0d9a \u0db1\u0dca\u0db4 \u0d92\u0d9c\u0d9a\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dd1\u0db8\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0d9c\u0dc0\u0db1\u0dc0\u0dc10 \u0d92 \u0db1\u0dd2\u0dc3\u0dc1 \u0d9c\u0db8\u0dca \u0dc3\u0dd2 \u0dbd\u0dd4 \u0db4\u0dd0\u0dad\u0dd2 \u0d9c\u0dd0\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db8\u0db8\u0dc1\u0dad\u0dba\u0dc1\u0dc0\u0db1\u0d9c\u0d86 \u0d9c\u0dbd\u0dca\u0d9a\u0db8\u0dca\u0dc0\u0dbb \u0dc1\u0dad\u0dca \u0d9a\u0dbd\u0dca\u0db4\u0db1\u0dc1 \u0d9a\u0dbb\u0db1\u0dc0\u0dc10 \u0db8\u0db4\u0db4 \u0dbd\u0dd0\u0d9c\u0db6\u0db1 \u0d9c\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0d92 \u0dc4\u0dbb\u0dc4\u0dc1 \u0d9a\u0dbb\u0db1 \u0db4\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0d92 \u0d9c\u0db8\u0d9c\u0dc4\u0dd4\u0dad\u0db8\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dc0\u0dd2\u0db1 \u0dd2\u0dad\u0dc1 \u0d9c\u0dc4\u0ddc\u0db3 \u0db8\u0dc0 \u0d9c\u0db6\u0ddd\u0dcf \u0d9a\u0dca \u0db4\u0d9c\u0dad\u0dca \u0dd2\u0dbb\u0dd3\u0d9c\u0db8\u0db1\u0dca \u0db4\u0dc3\u0dd4 \u0dc0\u0dc1\u0dab\u0dd2\u0da2 \u0db8\u0dcf\u0dba\u0d9a\u0dca\u0dc2\u0dc0\u0dbb \u0dc1 \u0d92\u0d9a \u0db8\u0db1\u0dca\u0dad\u0dda \u0db8\u0db8\u0dc1\u0dad\u0dba \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0d9a\u0db4 - Inter-Ministerial Committee \u0d91\u0d9a\u0d9a\u0db4 - \u0dc0\u0db1\u0dc0\u0dc10 \u0dd2\u0db1\u0dca \u0db4\u0dc3\u0dd4 \u0d92 \u0db8\u0db1\u0dca\u0dad\u0dda \u0db8\u0db8\u0dc1\u0dad\u0dba \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0 \u0dc4\u0dbb\u0dc4\u0dc1 \u0d9c\u0db1\u0dca\u0db1\u0dc1 \u0dad\u0dd3\u0dbb\u0dab \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db8\u0db8\u0dc1\u0dad\u0dba\u0dc1\u0dc0\u0db1 \u0db4 \u0dbd\u0db6\u0dc1 \u0d9c\u0daf\u0db1\u0dc0\u0dc10 \u0dd2\u0db1\u0dca \u0db4\u0dc3\u0dd4 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db8\u0db8\u0dc1\u0dad\u0dba\u0dc1\u0dc0\u0db1 \u0dc4\u0dbb\u0dc4\u0dc1 \u0d9c\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dad\u0dca\u0db8\u0d9a \u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dad\u0dd3\u0dbb\u0dab \u0db8\u0db4\u0dd2 \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dc10 \u0d92 \u0db1\u0dd2\u0dc3\u0dc1 \u0db8\u0db4\u0db4 \u0d9c\u0db8\u0dca \u0dc4\u0dbb\u0dc4\u0dc1 \u0dc3\u0dd2\u0dd3\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0d9a\u0db8 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0d9c\u0db1\u0dca \u0d9c\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0daf? \u0d9c\u0db8\u0dca\u0d9a \u0dc3\u0daf\u0dc1\u0d9a\u0dc1\u0dd2\u0db1\u0d9a \u0db6\u0dd3\u0daf\u0d9a\u0dca \u0d9c\u0dbd\u0dc3 \u0db4\u0dd0\u0db1\u0dc0\u0dd2\u0dbd\u0dc1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0d9c\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd00 \u0d9c\u0db8\u0dc4\u0dd2\u0daf\u0dd3 \u0d9c\u0dd3\u0dba \u0d9a\u0dda\u0db8\u0dc1\u0db1\u0dca\u0dad\u0d9a\u0dbb\u0dd4\u0dc0\u0dc1\u0db4\u0dad\u0dca \u0db8\u0dca \u0d9a\u0dc1\u0d