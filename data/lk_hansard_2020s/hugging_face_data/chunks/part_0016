    "chunk_text": "\u0daf\u0dca\u200d\u0dba\u0dd0\u0db1\u0dca \u0d85\u0dba\u0d9c\u0ddd\u0dc3\u0dc0\u0dc0 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0db4\u0dcf\u0dbb\u0dca\u0dae\u0dd2\u0dba\u0db8\u0dca\u0db1\u0dca\u0dc0\u0dba\u0dda\u0dad\u0dca \u0dc0 \u0db1\u0dd0\u0dc4\u0dd08 \u0dc4\u0dd2\u0dd2\u0dba\u0dcf \u0dba\u0db1\u0dca\u0daf\u0dca\u200d\u0dba\u0d8b \u0d85\u0dba\u0d9c\u0ddd\u0dc3\u0dc0\u0dc0 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dba\u0d9a\u0dba\u0db1\u0d9a\u0dca? \u0d85\u0da9\u0dd4\u0db8 \u0dbb\u0dba\u0db8\u0dca\u200d \u0d91\u0dc0\u0db8\u0dcf \u0db4\u0dcf\u0dbb\u0dca\u0dae\u0dd2\u0dba\u0db8\u0dca\u0db1\u0dca\u0dc0\u0dba\u0dda\u0dad\u0dca \u0dc0 \u0db1\u0dd0\u0dc4\u0dd08 \u0d9a\u0db6\u0dd3\u0dbb\u0dca\u0dae \u0dc4\u0dc2\u0dd3\u0db8\u0dca \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0db8\u0db1\u0dd2\u0d8b \u0d91 \u0dba\u0d9a\u0dcf\u0da7 \u0dba\u0daf\u0dca\u200d\u0dba\u0dc3\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca\u0dae \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2? \u0dba\u0daf\u0dca\u200d\u0dba\u0dc3\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca\u0dae \u0db8\u0dcf\u0dc3\u0dba\u0dda \u0db4\u0dd4\u0da7\u0dd4\u0dba\u0dda \u0dc0\u0dcf\u0da9\u0dd2 \u0d9a\u0dbb\u0dc0\u0db1\u0dca\u0db1 \u0dc3\u0dd0\u0dbd\u0dba\u0dda\u0dc3\u0dd4\u0db8\u0dca \u0dc4\u0daf\u0dca\u200d\u0dba\u0dbd\u0dba\u0dda\u0dcf \u0d94\u0d9a\u0dca\u0dba\u0d9a\u0ddd\u0db8 \u0d9a\u0dbb\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dca\u0dba\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0dba\u0db1\u0dca\u0daf\u0dca\u200d\u0dba? \u0dba\u0d9a\u0dcf\u0dba\u0dc4\u0dcf\u0db8\u0daf\u0dca\u200d\u0dba? \u0dba\u0daf\u0dca\u200d\u0dba\u0dc3\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca\u0dae\u0dc0\u0dbd\u0dba\u0dda\u0da7 \u0dc0 \u0db8\u0dcf\u0dc3 \u0dc0\u0db1\u0dba\u0dd2 \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dca\u0dba\u0db1\u0dca8\n\n1725 1726\n\n[\u0d9c\u0dbb\u0dd4 \u0da0\u0dd2\u0dba\u0db1\u0dca\u0daf\u0dca\u200d\u0dba \u0dc0\u0dd2 \u0dba\u0dda\u0da7\u0daf\u0dd2 \u0db8\u0dc4 \u0dcf]\n\n2025 \u0d85\u0dba\u0d9c\u0ddd\u0dc3\u0dc0\u0dc0 07\n\n\u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc2\u0dba\u0dba\u0db1\u0dca \u0db8\u0db8 \u0dba\u0db8\u0dca \u0d85\u0dc0\u0dc3\u0dc0\u0dae\u0dcf\u0dba\u0dda\u0daf\u0dd3 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0db4\u0dd0\u0dc4\u0dd0\u0db1 \u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dd2\u0d8b \u0d87\u0dba\u0db8\u0daf\u0dd2\u0d9a\u0dcf \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0dc0 \u0da2\u0db1\u0db4\u0daf\u0dca\u200d\u0dba\u0dba \u0dc0\u0dd2\u0da7\u0db1\u0dca \u0d85\u0db4\u0da7 \u0db4\u0db1\u0dc0\u0db1 \u0dbd\u0dba\u0dda\u0daf\u0dca\u200d\u0dba \u0dad\u0dd3\u0dbb\u0dd4 \u0db6 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dca\u200d\u0dbb\u0dca\u0dc0\u0db1\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dca\u200d\u0dc08 \u0d85\u0dba\u0dda\u0dbd\u0dcf \u0db8\u0dcf\u0dc3\u0dba\u0dda 2\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dca\u200d\u0dba\u0dcf \u0d91\u0dba \u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dca\u0dba\u0da7 \u0db4\u0dad\u0dca \u0dc0 \u0d9a\u0dbb\u0dbd\u0dba\u0dda\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf\u0d8b \u0d85\u0dba\u0dda\u0dbd\u0dcf \u0db8\u0dcf\u0dc3\u0dba\u0dda 9\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dca\u200d\u0dba\u0dcf \u0da7\u0da7 \u0dba\u0db8\u0dca\u0d9a \u0db6\u0dbd\u0dba\u0dda\u0db4\u0dc0\u0dad\u0dca \u0dc0\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf8 \u0d87\u0dba\u0db8\u0daf\u0dd2\u0d9a\u0dcf \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0dc0 \u0da2\u0db1\u0db4\u0daf\u0dca\u200d\u0dba\u0dba \u0d85\u0dba\u0db4\u0dca \u0dbb\u0da7\u0da7 \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0db6 \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0db4\u0db1\u0dc0\u0db1\u0dba\u0d9a\u0dcf\u0da7 \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d91\u0dba \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db4\u0dd4 \u0db8\u0dd6\u0dbd\u0dba\u0dda\u0dca\u200d\u0dbb\u0dca\u0dae\u0db8\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf8 \u0d92 \u0db8\u0dd6\u0dbd\u0dba\u0dda\u0dca\u200d\u0dbb\u0dca\u0dae\u0db8\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0dbb\u0da7\u0dc0\u0dbd\u0dcf \u0dba\u0daf\u0dca\u200d\u0dba\u0d9a \u0d85 \u0dbb \u0dad\u0dd2\u0dba\u0db6\u0db1 \u0dba\u0dc0\u0dc5\u0db3 \u0db4\u0dbb \u0dbb\u0dba\u0dda \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dca \u0dba\u0dba\u0db1\u0dca \u0dc4\u0daf\u0dd2 \u0d85\u0da9\u0d9a\u0dca \u0db8\u0dba\u0dd2 \u0d85\u0dba\u0db4\u0dca \u0db6 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca \u0dc0\u0dad\u0dd2\u0dba \u0dc4\u0dd0\u0dd2\u0dba\u0da7 \u0db1\u0db8\u0dca \u0d9a\u0dba\u0dc5\u0dc08 \u0d92\u0d9a \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc0\u0dca\u0dba\u0dba\u0db1\u0dca \u0dba\u0dc4\u0dcf\u0db3 \u0daf\u0dca\u200d\u0dba\u0d8b \u0db1\u0dbb\u0d9a\u0daf\u0dca\u200d\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dc0\u0dd2\u0dc0\u0dcf\u0daf\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca8 \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dc0\u0d8b \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0db4\u0daf\u0dca\u200d\u0dba\u0db1\u0db8\u0dca \u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0dc0\u0dba\u0dad\u0dca \u0dc0 \u0d87\u0dba\u0db8\u0daf\u0dd2\u0d9a\u0dcf \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0dc0 \u0da2\u0db1\u0db4\u0daf\u0dca\u200d\u0dba\u0dba \u0dc4\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dba\u0dda\u0d82\u0d9a\u0dcf\u0dc0 \u0d85 \u0dbb \u0dba\u0dc0\u0dc5\u0db3 \u0db4\u0dbb \u0dbb\u0dba \u0da7\u0dba\u0dba\u0da7 88\u0d9a\u0dca \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0d8b \u0d92\u0dba\u0d9a\u0db1\u0dca \u0da7\u0dba\u0dba\u0da7 50\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dba\u0dd28 \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dba\u0db1\u0dca \u0da7\u0dba\u0dba\u0da7 44\u0dba\u0dd28 \u0dc4\u0dd0\u0db8 \u0dbb\u0da7\u0d9a\u0da7\u0db8\u0d8b \u0d92 \u0d92 \u0dbb\u0da7\u0dc0\u0dbd\u0dcf \u0d85 \u0dbb \u0dad\u0dd2\u0dba\u0db6\u0db1 \u0dba\u0dc0\u0dc5\u0db3 \u0db4\u0dbb \u0dbb\u0dba\u0dda \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dca \u0dba\u0dba\u0db1\u0dca \u0da7\u0dba\u0dba\u0da7 50\u0d9a\u0dca \u0db8\u0dba\u0dd2 \u0db6 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dca \u0dba \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf \u0db1\u0db8\u0dca \u0d9a\u0dba\u0dc5\u0dc08 \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0db8\u0dba\u0dd2 \u0d85\u0db4\u0da7 \u0da7\u0dba\u0dba\u0da7 44\u0d9a\u0dca \u0d86\u0dba\u0dda8 \u0d92 \u0dba\u0dc0\u0dbd\u0dba\u0dda\u0dcf\u0dba\u0dda\u0dad\u0dca \u0dc0 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0db8\u0db8 \u0daf\u0dca\u200d\u0dba\u0dd0\u0d9a\u0dca\u0d9a\u0dcf\u0d8b \u0d85\u0dbb \u0dbb\u0da7\u0dc0\u0dbd\u0dba\u0dda\u0da7 \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0daf\u0dca\u200d\u0dba\u0db8\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd2\u0db6\u0dd2\u0dba\u0daf\u0dd3 \u0dbd\u0dba\u0dda\u0d82\u0d9a\u0dcf\u0dc0\u0da7 \u0da7\u0dba\u0dba\u0da7 44\u0d9a\u0dca \u0db4\u0dd0\u0db1\u0dc0\u0dd6\u0dba\u0dda \u0d86\u0da9\u0dd4\u0d9a\u0da9\u0dd4\u0dba\u0dda \u0d85\u0dc3\u0dcf\u0dbb\u0dca\u0dae\u0dae\u0d9a \u0db6\u0dc0 \u0db1\u0dd2\u0dc3\u0dcf\u0dba \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf8 \u0db1\u0dd0\u0dc4\u0dd0\u0d8b \u0d86\u0da9\u0dd4\u0d9a\u0da9\u0dd4\u0dba\u0dda \u0d85\u0dc3\u0dcf\u0dbb\u0dca\u0dae\u0dae\u0d9a\u0db7\u0dcf\u0dc0\u0dba\u0d9a\u0dca \u0dba\u0db1\u0dcf\u0dba\u0dc0\u0dba\u0dd28 \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d92 \u0db6 \u0db4\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0d9a\u0dc3\u0dc0 \u0d9a\u0dbb\u0d9c\u0dad\u0dca \u0dc0\u0dc0 \u0db8\u0dd6\u0dbd\u0dba\u0dda\u0dca\u200d\u0dbb\u0dca\u0dae\u0db8\u0dba \u0db8\u0dba\u0dd2\u0d8b \u0dba\u0dc0\u0dc5\u0db3 \u0db4\u0dbb \u0dbb\u0dba \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dca \u0dcf\u0dad\u0dca \u0dc0\u0db8\u0d9a\u0dc0 \u0d9c\u0dad\u0dca \u0dc0 \u0dcf\u0db8 \u0d91\u0dba\u0dd2\u0db1\u0dca \u0dc4\u0daf\u0dd2 \u0d85\u0da9\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a8 \u0dba\u0db8\u0dca \u0dbb\u0da7\u0d9a\u0da7 \u0da7\u0dba\u0dba\u0da7 25\u0d9a\u0dca \u0d86\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0d92 \u0dbb\u0da7\u0dc0\u0dbd\u0dcf \u0dba\u0daf\u0dca\u200d\u0dba\u0d9a \u0d85 \u0dbb \u0dad\u0dd2\u0dba\u0db6\u0db1 \u0dba\u0dc0\u0dc5\u0db3 \u0db4\u0dbb \u0dbb\u0dba \u0da7\u0dba\u0dba\u0da7 50\u0dba\u0dd28 \u0dba\u0dc0\u0dba\u0dc5\u0db3 \u0db4\u0dbb \u0dbb\u0dba \u0da7\u0dba\u0dba\u0da7 50\u0d9a\u0dca \u0db1\u0db8\u0dca \u0d92 \u0db6 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dca \u0dba \u0da7\u0dba\u0dba\u0da7 25\u0d9a\u0dca \u0dba\u0dc0\u0db1\u0dc0\u0dcf8 \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0db4\u0da7 \u0da7\u0dba\u0dba\u0da7 44\u0d9a\u0dca \u0d86\u0dc0\u0dcf8 \u0d91 \u0dba\u0d9a\u0dcf\u0da7 \u0d85\u0db4\u0da7 \u0d92 \u0da7\u0dba\u0dba\u0da7 44\u0d9a \u0d85\u0d9c\u0dba \u0db1\u0dd2\u0dbb\u0dca\u0dae\u0db8\u0dcf\u0dab\u0dba \u0dba\u0dc0\u0db1\u0dca\u0dba\u0db1\u0dca \u0d85\u0dba\u0db4\u0dca \u0dbb\u0dba\u0dda \u0d85\u0db7\u0dba\u0db1\u0dca \u0dbb \u0dca\u200d\u0dbb\u0dca\u0dc0\u0db1\u0dba\u0d9a\u0dca \u0db8 \u0dba\u0db1\u0dcf\u0dba\u0dc0\u0dba\u0dd2\u0d8b \u0d87\u0dba\u0db8\u0daf\u0dd2\u0d9a\u0dcf \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0dc0 \u0da2\u0db1\u0db4\u0daf\u0dca\u200d\u0dba\u0dba \u0dc3\u0dc4 \u0d85\u0db4 \u0d85 \u0dbb \u0dad\u0dd2\u0dba\u0db6\u0db1 \u0dba\u0dc0\u0dc5\u0db3 \u0db4\u0dbb \u0dbb \u0dba\u0dda \u0dc3\u0dc0\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0db8 8 \u0d92\u0d9a \u0dc4\u0daf\u0dd2 \u0db4\u0dd0\u0dc4\u0dd0\u0db1 \u0dd2\u0dba\u0dd28"
