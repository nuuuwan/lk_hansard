    "chunk_text": "\u0dd2\u0dc3\u0dc0\u0dc1\u0dae\u0dc2\u0dba\u0dc0\u0dba\u0db1\u0dca\u0db8 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dcf\u0dc0\u0dda \u200d\u0dbb\u0dc1\u0dae\u0db1\u0dba\u0da7 \u0dc5\u0dd2\u0db6\u0db3\u0dad\u0dd4\u0dbb\u0dd4 \u0dbd\u0dd9\u0dcf \u0da2\u0db8\u0da7 \u0dc0\u0db4\u0dba \u0db8\u0db8 \u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dd2 \u0dba\u0dda \u0dcf\u0dba\u0dab\u0dcf\u0dd9\u0d9a\u0dca \u0dc3\u0d9a\u0dc4\u0db1\u0dca \u0dba\u0db1\u0dca\u0db1. \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dc3\u0dad\u0dd2\u0dc0\u0d86 \u0d89\u0dad\u0dcf\u0db8 \u0dc0\u0dda\u0daf\u0da2\u0db1 \u0dd2\u0db1\u0dda\u0db0\u0dd2\u0dba\u0d9a\u0dca - \u0d9c\u0db1\u0dad\u0dd4\u0dba\u0d9a\u0dca - \u0d87\u0dca \u0dbd \u0dc3\u0dcf\u0da0\u0dcf\u0dba \u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dc0\u0d86 \u0da2 \u0dd2\u0db1\u0daf\u0dd4 \u0dc0\u0dd4\u0dab\u0dcf. \u0dd2\u0db1\u0dd4\u0dad\u0dca \u0dc3\u0dc0\u0dcf\u0dc0 \u0db8\u0db1\u0dca\u0dd3\u0dd9\u0dba\u0dc0\u0dba\u0dc0 \u0dc3\u0d9a\u0dc4\u0db1\u0dca \u0dc5 \u0db4\u0dbb\u0dd2\u0daf\u0dd2\u0db8 \u0d92 \u0d9c\u0dd9\u0dc3\u0dae\u0dcf\u0dcf\u0dc0 \u0dd9\u0daf\u0dd4\u0dca \u0dbd \u0dc1\u0dd2\u0d9a\u0dca\u0dc2\u0dba\u0dab \u0dc0\u0dba \u0dc4\u0dc0\u0dca \u0dcf\u0dbb\u0dca\u0dbd\u0dba \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0dba \u0dd9\u0daf\u0dd4\u0dca \u0dbd \u0d9c\u0dd2\u0db1\u0dd2 \u0db1\u0dd2\u0dd9\u0db1 \u0d92 \u0dba \u0daf\u0dd2\u0dba\u0dad\u0dbd\u0dcf\u0dd9 \u0dad\u0dd4\u0daf \u0dc4\u0dd4\u0daf\u0daf\u0dcf \u0d9c\u0db1\u0dd4\u0d9b\u0dca\u200d\u0da9\u0dd4\u0d9a\u0da9\u0dba \u0dd9\u0dd0\u0dca \u0dbd\u0dd9\u0dcf\u0dba \u0dad\u0dd4\u0daf \u0dc4\u0dd4\u0daf\u0daf\u0dcf \u0d9c\u0db1\u0dd4\u0d9b\u0dca\u200d\u0da9\u0dd4\u0d9a\u0da9\u0dba \u0d87\u0dca \u0dbd \u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dc0\u0d86 \u0dd9\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2 \u200d\u0dbb\u0da2\u0dcf\u0dd9 \u0dad\u0dca\u200d\u0dbb\u0dd2\u0dc0\u0dba \u0daf \u0dba\u0dcf \u200d\u0dbb\u0da2\u0dcf\u0dd9 \u0dc0\u0dd9\u0dc0\u0dc5\u0d9a \u0dc3\u0dcf\u0d9c\u0db8\u0dba \u0dc3\u0dc4 \u0d92 \u200d\u0dbb\u0d