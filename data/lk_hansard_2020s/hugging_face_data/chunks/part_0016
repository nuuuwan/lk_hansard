d9a grid \u0d91\u0d9a\u0d9a \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dcf. \u0dd4\u0dd0\u0db6\u0dd0\u0db1\u0dca, \u0d91\u0dc4\u0dd2 extensions \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dcf. \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0db4\u0db1\u0dad \u0dd4\u0dba\u0dd4\u0dcf additional transmission licensing \u0dd2\u0dbb[\u0db1 \u0d91\u0d9a \u0dc1\u0d9c\u0dc1\u0db1\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0db8\u0dca \u0db1\u0dd2\u0dc3\u0dcf\u0db1\u0dca. \u0d85\u0db4\u0da7 \u0dc1\u0dcf\u0dad\u0dd0\u0db1\u0dd2\u0db1\u0dca \u0d91\u0dd4\u0dcf\u0da7 [\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1, grid \u0d91\u0dc1\u0d9a extensions \u0d85\u0db4\u0dd2 private companies1\u0da0\u0da7, investments1\u0da0\u0da7 open \u0d9a\u0dba\u0db11\u0dcf. NTNSP \u0d91\u0dc1\u0d9a, \u0daf\u0dd0\u0db1\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1 grid \u0d91\u0d9a \u0dc3[[\u0da7 5 \u0d9a \u0dba\u0da2[ \u0dc3\u0dad\u0dd4\u0db8 1\u0db1 \u0d85\u0dad\u0dba, additional transmitting licensing \u0dd4\u0dba\u0dd4\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2[\u0da7 \u0d91\u0db1 investors\u0da0\u0dcf\u0da7 \u0d85\u0db4\u0dd2 \u0d91[ open \u0d9a\u0dba\u0da0\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dcf."
