    "chunk_text": "\u0da2\u0db1\u0dad\u0dcf \u0dd2\u0db0\u0dd4\u0daf\u0d9a\u0dca\u0dad \u0d85 \u0dc1\u0db4\u0dbb\u0dd4\u0daf\u0dc1\u0dab\u0dca\u0da9 \u0d85\u0dba \u0daf\u0dc3\u0dae\u0dc3\u0dbb \u0dc0\u0dcf\u0dc1\u0d9a \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2 \u0daf \u0db1\u0dca \u0db8\u0dc5 \u0dc1\u0d9c\u0dc0\u0dca \u0dc0\u0dbd\u0dca\u200d\u0da7 \u0dba\u0db1\u0dc0\u0dcf. \u0daf\u0dc3\u0dae\u0dc3\u0dbb \u0d9c\u0dd2\u0dc1\u0dda \u0db1 \u0dc4 . \u0daf\u0dc3\u0dae\u0dc3\u0dbb \u0db8\u0dc5 \u0dc1\u0d9c\u0dc0\u0dca \u0dc0\u0dbd\u0dca\u200d\u0da7 \u0d9c\u0dd2\u0dc1\u0dda \u0db1 \u0dc4 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dae\u0dc3\u0dd4 \u0db8 \u0dbb\u0dd4\u0dc0\u0dcf \u0dc1\u0db1\u0dca. \u0daf \u0db1\u0dca \u0db8\u0dc5 \u0dc1\u0d9c\u0dc0\u0dca \u0dc0\u0dbd\u0dca\u200d\u0da7 \u0dba\u0db1\u0dc0\u0dcf. \u0db8\u0dcf\u0dc5\u0dd4 \u0db4\u0dcf\u0db1\u0dd4\u0dad\u0dca \u0dc1\u0d9c\u0db1 \u0dba\u0db1\u0dc0\u0dcf. \u0daf\u0dc3\u0dae\u0dc3\u0dbb \u0dc0\u0dcf\u0dc1\u0d9a \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2 \u0db8\u0dc5 \u0dc1\u0d9c\u0dc0\u0dca \u0dc0\u0dbd\u0dca\u200d \u0dba\u0db1\u0dc0\u0dcf. \u0db6 \u0db1\u0dbb\u0dca \u0d91\u0dc1\u0dc4\u0db8\u0dad\u0dca \u0daf\u0dcf\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0dc1\u0daf\u0dc1\u0d9c\u0dcf\u0dca \u0dbd\u0dca\u200d\u0db1\u0dca \u0dc1\u0d9a\u0dcf\u0dc1\u0dc4\u0dcf\u0db8\u0dad\u0dca \u0db6 \u0db1\u0dbb\u0dca \u0daf\u0dcf\u0db1\u0dc0\u0dcf \u0dc1\u0db1\u0dca. \u0dc1\u0db4\u0dcf\u0dc1\u0dc4\u0dcf\u0db4\u0dc1\u0db1 \u0dc3\u0dd0\u0d82\u0dc1\u0db1\u0d9c\u0dba. \u0dc3\u0da2\u0db6\u0dc1\u0dda \u0dc3\u0dd0\u0d82\u0dc1\u0db1\u0d9c\u0dba \u0d9a\u0dd2\u0dba\u0dbd\u0dca\u200d\u0dcf \u0d85\u0db4\u0dd2 \u0db6 \u0db1\u0dbb\u0dca \u0daf\u0dcf\u0db1\u0dc0\u0dcf. \u0d92\u0d9a \u0d85\u0db4\u0da7 \u0dd4\u0dc0\u0dbb\u0dd4\u0daf\u0dd4\u0dba\u0dd2. \u0dc1 \u0db4\u0dcf\u0dbd\u0dca\u200d\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba \u0d92\u0d9a \u0dad\u0db8\u0dba\u0dd2. \u0dc4 \u0db6 \u0dba\u0dd2 \u0db8\u0db8 \u0daf \u0d9a\u0dca\u0dad\u0d9a\u0dcf \u0da2\u0db1\u0dad\u0dcf \u0dd2\u0db0\u0dd4\u0daf\u0d9a\u0dca\u0dad \u0d85 \u0dc1\u0db4\u0dbb\u0dd4\u0daf\u0dab\u0dad\u0dca \"\u0d85\u0dc1\u0dca \u0db6\u0dbd\u0dca\u200d\u0dc0\u0dad\u0dca \u0d9a\u0db1\u0d9c\u0dcf\u0db4\u0dc0\" \u0d9a\u0dd2\u0dba\u0dbd\u0dca\u200d\u0dcf \u0db8\u0dcf\u0dc5\u0dd4 \u0db4\u0dcf\u0db1\u0dca 0\u0d9a\u0dd4\u0dad\u0dca \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0dba\u0db1\u0dc0\u0dcf. \u0dbb\u0dd1\u0da7 \u0d9a\u0dcf\u0dcf \u0d9a\u0dbb\u0d9a\u0dbb \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d92 \u0d9c\u0db8\u0dca\u0dc0\u0dbd\u0dca\u200d \u0daf\u0db1\u0dca\u0db1 \u0da2\u0dd2\u0db0\u0dc1\u0db4 \u0dc3\u0db8\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \"\u0dc1\u0db8\u0db1\u0dca\u0db1 \u0d85\u0dc1\u0dca \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb \u0d85\u0db4\u0dad\u0dca \u0d85\u0dba\" \u0d9a\u0dd2\u0dba\u0dbd\u0dca\u200d\u0dcf. \u0dc1\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0dad\u0daf \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb \u0d85\u0db4\u0dad\u0dca \u0d85\u0dba? \u0d87 \u0d85 \u0d85\u0dba\u0dc1\u0d9c\u0db1\u0dca"
  },
