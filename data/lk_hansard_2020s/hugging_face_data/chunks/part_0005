    "chunk_text": "(\u0d85) \u0dc0\u0dd2\u0dd9\u0daf\u0dd2\u0d82\u0d9c \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0da2 \u0da21\u0daf\u0dba1\u0dba\u0dc1 \u0d9a\u0dca\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0d86\u0db6\u0dd2\u0db0\u0dd2\u0dad \u0dad\u0dd0\u0db1\u0dd0\u0dad\u0dca\u0dad\u0dd2\u0dc1\u0db8 \u0d86\u0db6\u0dd2\u0db0\u0dd2\u0dad \u0dad\u0dad\u0dca\u0dad\u0dca1 \u0dc3\u0db1\u0dd2\u0dae \u0dd9\u0dba\u0db8\u0dd2\u0db1\u0dca\u0dad \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0dd9\u0dba\u0db1\u0dd4 \u0daf\u0db6\u0db1 \u0dc3\u0dc4\u0dba\u0dad\u0dd2\u0dd9 \u0d9a\u0dca\u0dc0.\n\n(\u0d86) \u0d86\u0db6\u0dd2\u0db0\u0dd2\u0dad \u0dad\u0dca\u0dda\u0d9c\u0daf \u0dd2\u0da7 \u0dad\u0db8 \u0d91\u0dd2\u0dc1\u0db1\u0daf\u0dd2 \u0dd9\u0da7\u0dba\u0dd4\u0dd4 \u0dc11\u0db1\u0dad\u0dca\n\n\u0dc1\u0dd9\u0dc1\u0db1\u0d9a\u0dd4\u0dc1\u0db8 \u0d86\u0db0\u0dd2\u0dba \u0db1\u0dd0\u0dad\u0dd21 \u0d86\u0db0\u0dd2\u0dba\u0dd9 \u0d8b\u0db4\u0dd9\u0dba\u0da7 \u0d9a\u0dca\u0dc0 \u0db7\u0dd2\u0dc0\u0dd2\u0dad\u0dc1 \u0db1\u0dca\u0dad \u0db41\u0dd2 \u0d89\u0da7\u0dd4 \u0dd9\u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dc1\u0db1\u0dd2\u0dc4\u0dba\u0dd0\u0dd2\u0dbb \u0db61\u0da7 \u0dc0\u0dd2\u0dd9\u0daf\u0dd2\u0d82\u0d9c \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0da2 \u0da21\u0daf\u0dba1\u0dba\u0dc1 \u0d9a\u0dd4\u0dc1\u0d9c\u0db1\u0dca\u0dad \u0dc3\u0dc4\u0dba\u0dad\u0dd2\u0dd9 \u0dd9\u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8.\"\n\n\u0dd4 \u0daf\u0dbd\u0dca \u0d85\u0db8\u0dd2\u0dad\u0dba\u0dd2\u0d82 \u0dc1\u0dda \u0dc1\u0dbd\u0dca\u0dd9\u0db8\u0dca\u0da7 \u0dad\u0dca\u0dc5\u0dd41\u0db1\u0dca\u0dad \u0daf\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8 30\u0dd2\u0dbb\u0db1\u0dca\u0dad 35\u0dd2\u0dbb\u0db1\u0dca\u0dad \u0d91\u0dd4\u0db8\u0dd2\u0dc1\u0db8 1\u0dd0\u0da7\u0dd4\u0db4 1\u0dd0\u0da9\u0dd2 \u0dd9\u0dba \u0d9c\u0db1\u0dca\u0dad\u0db1. \u0db8\u0dc4\u0dba \u0db6\u0dd0\u0d82\u0d9a\u0dd4 \u0db1\u0dd2\u0daf\u0db0\u0dd2\u0dbb\u0dd2\u0db1\u0dca\u0dad\u0da7 \u0dad\u0dca\u0dc5\u0dd41\u0db1\u0dca\u0dad \u0daf\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8 30\u0dd2\u0dbb\u0db1\u0dca\u0dad 35\u0dd2\u0dbb\u0db1\u0dca\u0dad \u0d92 \u0dc1\u0d9c\u0dd2\u0dbd\u0dca\u0daf\u0db1\u0dca\u0dad\u0dc1\u0db8 1\u0dd0\u0da7\u0dd4\u0db4\u0dca 1\u0dd0\u0da9\u0dd2 \u0dd9\u0dba \u0d9c\u0db1\u0dca\u0dad\u0db1. \u0d91\u0dc1\u0dc4\u0dba\u0db8 \u0dad\u0dd2 \u0dd2\u0dc1\u0d9c\u0db1 \u0d85\u0dc4\u0dd2\u0d82\u0dc3\u0dd9 \u0d86\u0db6\u0dd2\u0db0\u0dd2\u0dad \u0dd2\u0da7 \u0dc4\u0dba\u0db8\u0dca\u0db6 \u0dc11\u0db1 \u0dd4\u0da7\u0dca\u0da7\u0dd4 \u0dc1\u0daf\u0dd9\u0da7 \u0dc0\u0dd2\u0dd2\u0db1\u0dca\u0dad\u0db1\u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0dc4\u0dba\u0daf\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad. \u0d92 \u0db1\u0dd2\u0dc3\u0dd2 \u0db8\u0db8 \u0d94\u0db6\u0dd4\u0db8\u0dd2\u0dc1\u0d9c\u0db1\u0dca\u0dad \u0d89\u0dbd\u0dca\u0daf\u0dd2\n\n\u0dc3\u0dd2\u0da7\u0dd2\u0db11\u0dd2 \u0dc1\u0db4\u0dd2\u0dc1\u0dba\u0dd2\u0dad\u0dca\u0dd4 \u0dc1\u0dbd\u0dca\u0d9b\u0db1\u0dc1\u0dda \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0d86\u0db6\u0dd2\u0db0\u0dd2\u0dad \u0db1\u0dca\u0dad\u0da7\u0dad\u0dca \u0d92 \u0dc3\u0db3\u0dc4\u0dba\u0dd2 \u0d851\u0dc3\u0dda\u0dae\u0dd21 \u0dc1\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d92 1\u0dd2\u0dc1\u0db8\u0db8 \"\u0dc0\u0dd2\u0dd9\u0daf\u0dd2\u0d82\u0d9c \u0da21\u0daf\u0dba1\u0dba \u0d9a\u0dd4\u0dc1\u0db8 \u0dc3\u0dc4\u0dba\u0dad\u0dd2\u0dd9 \" \u0dd2\u0dbb \u0db1 \u0dc1\u0dd9\u0dd2\u0db1\u0dca\u0dad\u0dc1\u0dda\u0dc3\u0dd2 \u0d891\u0dad\u0dca \u0dd9\u0dba\u0daf\u0dd2 \u0dc3\u0dd4\u0dd4\u0dc0\u0dc3\u0dd4 \u0dc0\u0dd2\u0dd9\u0dbd\u0dca\u0db4 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dd2 \u0db8\u0dd2\u0dbb\u0dca\u0d9c \u0d9a\u0dca\u0dc0 \u0d85\u0db1\u0dd4\u0d9c\u0db8\u0db1 \u0dd9\u0dba\u0db1\u0dca\u0dad\u0db1 \u0dd2\u0dbb \u0daf\u0dd2.\n\n\u0d9c\u0dbb\u0dd4 \u0dc0\u0dc1\u0dca\u0dc4\u0dcf\u0db1\u0dca \u0dc0\u0dc3\u0db1\u0db8\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0bc6\u0bb9\u0bc6\u0bbe\u0ba9\u0bcd \u0b95\u0bc6\u0bae\u0bc6\u0bbf\u0b99\u0bcd\u0b95) (The Hon. Shehan Semasinghe) \u0d9c\u0dc0 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dca\u200d\u0dba \u0dd9\u0dae\u0dd2\u0db1\u0dd2 \u0dd9\u0dd4\u0db8\u0db1\u0dd2 \u0d91\u0dd4\u0db8\u0dd2 \u0db8\u0dd4 \u0dd9\u0dc5 \u0dd4 \u0dbd\u0dca \u0dd9\u0dd2\u0dba\u0da7\u0dd2 \u0da7\u0dd2\u0dd9\u0da7 \u0d851\u0db0\u0dd2\u0db1 \u0dc1 \u0dd2\u0dd4 \u0dd9\u0dba\u0daf\u0dd2 \u0d92 \u0dc3\u0db3\u0dc4\u0dba\u0dd2 \u0d851 \u0dba \u0dc0\u0dd2\u0dc3\u0db3\u0dd4\u0db8\u0dca \u0db8\u0db8 \u0daf\u0db6\u0dd2 \u0dc1\u0daf\u0db1\u0dca\u0dad\u0db1\u0db8\u0dca. \u0d9c\u0dc0 \u0dc0\u0dd2\u0db8\u0dbd\u0dca \u0dc0\u0dd3\u0dba1\u0d82 \u0db8\u0dd0\u0dad\u0dd2\u0dd4\u0db8\u0db1\u0dd2 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1 \u0db1\u0dca\u0dad\u0db8 \u0db8\u0db8 \u0d94\u0db6\u0dd4\u0db8\u0dd2\u0da7 \u0dd2\u0dbb \u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1 \u0dc1\u0db8\u0dca \u0dd9\u0dd2\u0dba\u0da7 \u0dad\u0dca. \u0db4\u0dc3\u0dd4\u0d9c\u0dd2 \u0daf\u0dd2 \u0da2\u0dca\u200d\u0db1\u0dd2\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dd2 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0dc1\u0dda\u0daf\u0db1 \u0d9a\u0dca\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dd9\u0dd2 \u0da7 \u0db4\u0dad\u0dca \u0dd9\u0dc5\u0dd2. \u0d92 \u0dd2\u0db1 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0da7 \u0dc0\u0dd4\u0da7\u0dd2\u0da7 \u0db4\u0dc3\u0dda\u0dc1\u0dc3\u0dda \u0d85\u0db4\u0dd2 \u0d92\u0dd9 \u0db4\u0dd2\u0dbb\u0dca\u0dbd\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd41\u0da7 \u0d89\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dd9\u0dba\u0db11\u0dd2."
  },
