    "chunk_text": "\u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0db4\u0dd4\u0dad\u0dca\u0dad\u0dbd\u0dc1\u0db8\u0db1\u0dca \u0db6\u0dd2\u0dc4\u0dd2 \u0dc0\u0dd4\u0dab\u0dd4 \u0db1\u0dcf\u0dba\u0d9a\u0dc1\u0dba\u0d9a\u0dca \u0dc1\u0dc4\u0dcf\u0db3 \u0db8\u0dc0\u0dd9\u0dc3\u0dda\u0dc3\u0dc1\u0dba\u0d9a\u0dca \u0d91\u0da9\u0dd2\u0dad\u0dbb \u0dc3\u0dc1\u0dc4\u0ddd \u0dbb\u0dc1\u0dba\u0d9a\u0dca. \u0d85\u0db4\u0dd2 \u0d92\u0d9a \u0db1\u0d9a\u0dca\u0d9a\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dc1 \u0d85\u0db7\u0dcf\u0dc0\u0dba \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd4\u0dab\u0dd4 \u0dc1\u0db8\u0dcf\u0dc1\u0dc4\u0dcf\u0dc1\u0dad\u0dca \u0d87\u0dad\u0db1\u0db8\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dda \u0dc4\u0db1\u0dc3\u0dd2\u0dbb\u0dd4\u0dab\u0dd4 \u0d86\u0d9a\u0dcf\u0dbb\u0dba \u0db1\u0d9a\u0dca\u0d9a\u0dcf\u0db8 \u0db8\u0da7 \u0db1\u0db8\u0dca \u0d91\u0db4\u0dcf \u0dc0\u0dd4\u0dab\u0dcf. \u0dc3\u0db8\u0dcf\u0da2\u0dc1\u0dda \u0dc1\u0db8\u0dc1\u0dc4\u0db8 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4 \u0dc1\u0dc0\u0dc0\u0dd9\u0dc1\u0dc0\u0db1\u0dca \u0dc0\u0db1\u0da9\u0dcf \u0d9a\u0dbb\u0db1 \u0d91\u0dc1\u0d9a\u0dca \u0dbd\u0dbd\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8\u0da7 \u0dc4\u0dd2\u0dad\u0dd4\u0db8\u0dab\u0dcf. \u0db8\u0dc0\u0dd9\u0dc3\u0dda\u0dc3\u0d9a\u0db8\u0d9a\u0dca \u0db1\u0db1\u0dad\u0dd2 \u0dc4 \u0dc0\u0dad\u0d9a\u0dca \u0db1\u0db1\u0dad\u0dd2 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4 \u0dad\u0db8\u0dba\u0dd2 \u0d91 \u0dcf \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dc1 \u0dc1 \u0dc4\u0dba \u0d89\u0dc3\u0dda\u0db4\u0dd2\u0dbb\u0dd2\u0dad\u0dcf\u0dc1\u0db1 \u0dad\u0dd2\u0db6\u0dd2\u0dba\u0daf\u0dd3 \u0db4\u0dc0\u0dcf -\u0d92 \u0d85\u0dc0\u0dc3\u0dda\u0db1\u0dcf\u0dc1\u0dda \u0dc3\u0dd2\u0da7\u0db8- \u0dc3\u0db8\u0dcf\u0da2 \u0db8\u0dcf\u0db0\u0dba\u0dc0\u0dd2\u0db1\u0dca \u0dc1\u0db1\u0dcf\u0dc1\u0dba\u0d9a\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf \u0db1\u0dd2 \u0dc3\u0dad\u0dca \u0d9a\u0dc1\u0dc5\u0dda. \u0d89\u0dc3\u0dda\u0dc1\u0dc3\u0db1\u0dbd\u0dcf \u0d9a\u0db1\u0dcf \u0d9a\u0dc5 \u0d85\u0dc1\u0dca \u0dc3\u0dc1\u0dc4\u0ddd \u0dbb \u0dbb\u0dcf\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0dc0\u0dcf\u0dc1 \u0d86\u0d9c\u0db8\u0d9a\u0dca- \u0dc4\u0db8\u0d9a\u0dca \u0db8\u0dc0\u0dd9\u0dc3\u0dda\u0dc3\u0d9a\u0db8\u0d9a\u0dca \u0dc4 \u0dc0\u0dad\u0d9a\u0dca \u0db1\u0db1\u0dad\u0dd2 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4 \u0dad\u0db8\u0dba\u0dd2 \u0d92 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d9a\u0db1\u0dcf\u0db3\u0dc4 \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dc1 \u0dba\u0db1\u0dcf \u0dc3\u0dda\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0d9c\u0db1\u0db1 \u0d9a\u0dd2\u0dc3\u0dd2 \u0dc1 \u0dba\u0d9a\u0dca \u0dc1\u0db1\u0dcf \u0db1\u0db1 \u0dad\u0db8\u0dba\u0dd2 \u0d92 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0dc0\u0dbd\u0dcf \u0d85\u0db4\u0dc4\u0dcf\u0dc3 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0dc0\u0dd9 \u0dbd\u0db1\u0db6\u0dd4\u0dc1\u0dda. \u0db8\u0db8 \u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dc3\u0dda\u0db1\u0dcf\u0dc1\u0dda \u0dc1\u0db3\u0dc1\u0dc4\u0dc0\u0dd2\u0db1\u0dca \u0dc3\u0dda\u0dad\u0dd4\u0db8\u0dad\u0dd2\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dc1 \u0db6\u0dd2\u0dbb\u0dd2\u0db3\u0da7. \u0dc1\u0db8\u0dcf\u0d9a \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba \u0d92 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0d85\u0db4\u0dc4\u0dcf\u0dc3 \u0dbb\u0dcf \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0d9a\u0dca\u0dad\u0dd2\u0db8\u0dad\u0dca\u0dc0 \u0dc3\u0dd2\u0da7\u0dd2 \u0db1\u0dd2\u0dc3\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0dc3\u0db1\u0dad\u0dca \u0db1\u0dd2 \u0dcf\u0db1\u0dca\u0dad \u0db8\u0db1\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dc1 \u0dc1 \u0dc4\u0dba \u0dc3\u0db8\u0dca\u0db3\u0db1\u0dca\u0db0 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dc3\u0dcf\u0dbb\u0dca\u0db1\u0d9a\u0dc0 \u0db1\u0dd2\u0db8 \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0da7 \u0dc4\u0db1\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0d85\u0dc0\u0dc3\u0dda\u0db1\u0dcf\u0dc0 \u0dbd\u0db1\u0db6\u0dd4\u0dc1\u0dab\u0dca\u0da9.\n\n\u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4\u0db1\u0dca\u0da7 \u0d95\u0db1\u0dd1 \u0dad\u0dbb\u0db8\u0dca \u0d85\u0dc0\u0dbd\u0dcf \u0d85\u0db4\u0dc4\u0dcf\u0dc3 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d85 \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dc1 \u0db4\u0dd4\u0dad\u0dcf\u0da7\u0dad\u0dca \u0daf\u0dd2\u0dba\u0dab\u0dd2\u0dba\u0db1\u0dca \u0dad\u0dd2\u0dc1 \u0db1\u0dcf\u0da7\u0dad\u0dca \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dc1 \u0dba\u0dcf\u0db3\u0dbb \u0db6\u0dd2\u0dbb\u0dd2\u0db3 \u0dc0\u0db1 \u0da0\u0db8\u0dbb\u0dd2 \u0dd2\u0dba\u0dcf\u0d82\u0d9a\u0dcf \u0db1\u0db1\u0d9f\u0dab\u0dd2\u0dba\u0da7\u0dad\u0dca \u0d89\u0db1\u0dca\u0db1 \u0dc1\u0d9a\u0dcf\u0dc5\u0db9 \u0dc1\u0d9c\u0dba\u0d9a\u0dca \u0db1\u0db1\u0dc4\u0db1. \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0dc4\u0db8\u0dca\u0db3 \u0d9a\u0dbb\u0db4\u0dd4 \u0dc1 \u0dba\u0d9a\u0dca \u0db1\u0db1\u0dc4\u0db1. \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0dc1\u0dc0\u0db1\u0db8 \u0dc1\u0d9c\u0dc0\u0db1-\u0dc1 \u0dcf\u0dbb\u0dc0\u0db1 \u0dc4 \u0dcf\u0dc1\u0d9c\u0db1 \u0db1\u0db1\u0dc4\u0db1. \u0db4\u0dd4\u0dad\u0dca\u0dad\u0dbd\u0dc1\u0db8\u0dca \u0dc1\u0d9c \u0dbb \u0dc0\u0dd4\u0dab\u0dad\u0dca \u0dc1\u0db3\u0dcf\u0dc1\u0dc4\u0dcf\u0db8 \u0dc3\u0dd4\u0dc5\u0dd4\u0dc0\u0da7 \u0dad\u0db8\u0dba\u0dd2 \u0dc4 \u0dcf \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d92\u0dc0\u0dcf\u0dad\u0dca \u0dc4 \u0dcf\u0dc1\u0d9c\u0db1 \u0db1\u0db1\u0dc4\u0db1. \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0d9a\u0dbb\u0db4\u0dd4 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dc0\u0dbd \u0dc3\u0db1\u0dd2 \u0db4\u0dc0\u0dcf \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0dc1\u0dc0\u0dc0\u0dd9\u0dc1\u0dc0\u0db1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0dc0\u0dd2 \u0dcf\u0dbd \u0dc1\u0dbd\u0dc3 \u0dc0\u0dd2\u0dba \u0db8\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0dc1\u0dc0\u0dc0\u0dd9\u0dc1\u0dc0\u0db1\u0dca \u0dc3\u0dc4 \u0db4\u0d9a\u0dca \u0dba \u0dc1\u0dc0\u0dc0\u0dd9\u0dc1\u0dc0\u0db1\u0dca \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0d9a\u0db8\u0dca \u0d89\u0da7\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dcf. \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4\u0db1\u0dca\u0da7 \u0d95\u0db1\u0dd1\n\n879 880\n\n[\u0d9c\u0dbb\u0dd4 \u0dc0\u0dd2\u0da2\u0dd2\u0dad \u0dc1\u0dda\u0dbb\u0dd4\u0dc1\u0d9c\u0dcf\u0da9\u0dcf \u0db8\u0dc4\u0dad\u0dcf]\n\n2024 \u0dc1\u0db4\u0db3\u0dbb\u0dc0\u0dcf\u0dbb\u0dd2 22\n\n\u0dad\u0dbb\u0db8\u0dca \u0d85\u0dc0\u0dbd\u0dcf \u0d85\u0db4\u0dc4\u0dcf\u0dc3 \u0dda\u0db4\u0dc4\u0dcf\u0dc3 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d91\u0dc1\u0dc3\u0dda \u0d85\u0dc0\u0dbd\u0dcf \u0d85\u0db4\u0dc4\u0dcf\u0dc3 \u0db1\u0d9c \u0daf\u0dd3 \u0d91\u0dc1\u0dc3\u0dda \u0d85\u0dc0\u0dbd\u0dcf \u0dba\u0da7 \u0d85\u0db4\u0dc4\u0dcf\u0dc3\u0dba\u0da7 \u0dbd\u0d9a\u0dca \u0d9a\u0dbb\u0db1 \u0db4\u0dd4 \u0d9c\u0dbd\u0dba\u0dcf\u0dc1 \u0dba\u0db1\u0dcf \u0dc3\u0dda\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0dc1\u0dad\u0dca\u0dbb\u0dd4\u0db8\u0dca \u0dc1\u0d9c\u0db1 \u0dc4\u0dbb\u0dd2 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0dc0\u0dc1\u0db3\u0ddd\u0db0 \u0d9a\u0dbb\u0dc1\u0d9c\u0db1 \u0d92 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf \u0db1\u0dd2 \u0dc3\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dc1\u0db8\u0dca \u0dc3\u0db8\u0dcf\u0da2\u0dc1\u0dda \u0d89\u0db1\u0dca\u0db1\u0dcf \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4\u0db1\u0dca\u0da7 \u0db8\u0db8 \u0dc1\u0db3\u0dcf\u0dc1\u0dc4\u0dcf\u0db8 \u0db4\u0db1\u0dc4\u0db1\u0daf\u0dd2\u0dd2\u0dc0 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1."
