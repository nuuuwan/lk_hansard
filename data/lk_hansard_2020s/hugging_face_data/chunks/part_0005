db1\u0dd2 \u0d9c\u0dc0 \u0da7\u0dd2\u0dc2\u0dd2\u0da7\u0dbb\u0dca\u0dca \u0d87\u0dca\u0dad\u0dd2\u0dd4,\u0dca\u0dd2\u0dc1\u0d9c\u0db1\u0dca \u0dca\u0da7 \u0db4\u0dca\u200d\u0dbb \u0dcf) [ \u0d85\u0dc4\u0dba\u0db1\u0dca) \u0dad\u0dd2\u0dc1\u0db6)1\u0dd2. \u0d92 \u0dc3\u0db3\u0dc4\u0dba\u0dd2 \u0dc1\u0db4\u0ddc\u0dd2 \u0dc1\u0dda\u0db1\u0dd21 [ \u0db1\u0db6\u0dd2 \u0dc1\u0daf\u0db1\u0dca).\n\n\u0d9c\u0dc0 \u0d87\u0dca\u0dad\u0dd2\u0dd4,\u0dca\u0db1\u0dd2 \u0dba\u0da2\u0dca\u200d \u0dd2\u0db0\u0dc3\u0dd2\u0db1\u0dca \u0dc1\u0dca1\u0dba \u0dca\u0dc4\u0dba \u0da7\u0db1\u0dca)\u0dc1\u0dda \u0dc0\u0dd31\u0db1\u0da7 \u0db8\u0dd2\u0db1 [ \u0db1\u0dd2 \u0dca \u0da7\u0dba\u0db1\u0dd2 )\u0dd0\u0dc4\u0dba\u0dd0. \u0dc3\u0dd2\u0dca\u0dd2)\u0dba\u0dc1 \u0db1\u0dca \u0dc4\u0dba\u0dd0\u0dca \u0da7\u0db1\u0dca) \u0da7\u0dd3\u0dca \u0dba\u0da2\u0dca\u200d \u0dd2\u0db0\u0dc3\u0dd2\u0db1\u0dca \u0dc0\u0dd31\u0db1\u0da7 \u0db8\u0dd2\u0db1 [ \u0db1\u0dd2 \u0dca \u0da7\u0dba)1\u0dd2. )\u0db8\u0dd4\u0dca \u0dc1\u0dca1\u0dba \u0dca\u0dc4\u0dba \u0da7\u0db1\u0dca) \u0dc1\u0dda\u0dd3 \u0dba\u0da2\u0dca\u200d \u0dd2\u0db0\u0dc3\u0dd2\u0db1\u0dca \u0dc0\u0dd31\u0db1\u0da7 \u0d9a\u0dd2\u0dc3\u0dd2\u0dca \u0db8\u0dd2\u0db1 [ \u0db1\u0dd2 \u0dca \u0da7\u0dc1\u0dcf\u0dda )\u0dd0\u0dc4\u0dba\u0dd0. \u0d92 \u0db1\u0dd2\u0dc3\u0dd2 \u0dba\u0dc1\u0da7\u0dca \u0d89\u0db1\u0dca) \u0dc1\u0dca\u0ddd\u0dbd\u0dca \u0db8\u0dd4\u0daf\u0db1\u0dd2\u0dbd\u0dd2\u0db1\u0dd2 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0dc4\u0dd2\u0dc1\u0dad) \u0d9c\u0da7\u0db1\u0dca1\u0db1\u0da7 \u0dc0\u0dd3 \u0db8\u0dd2\u0db1\u0dd3 \u0d9c\u0dd0\u0db1\u0dd3\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0da7\u0dba)1\u0dd2.\n\n\u0d92 \u0dc3\u0dca\u0db4\u0db6\u0db1\u0dca\u0db11 \u0da7\u0dd2\u0dc2\u0dd2\u0da7\u0dbb\u0dca\u0dca \u0d85\u0dca\u0dd2\u0dad\u0dba\u0dd2\u0d82 \u0db4\u0dd0\u0dca \u0dc1\u0dad\u0db1\u0dca \u0d94\u0db6\u0dd4,\u0dca\u0dd2 \u0dca\u0db4 \u0dca\u0dd0\u0daf\u0dd2\u0dc4\u0dba\u0dca \u0dc0\u0dd3\u0dca [ \u0dc3\u0dd2\u0daf\u0dd4 \u0da7\u0dba)1\u0dd2 \u0daf? \u0d85\u0da9\u0dd4\u0dca \u0d9c\u0da7\u0dc1\u0db1\u0dca \u0db1 \u0da7\u0db1\u0dca)\u0dc1\u0dda1\u0dca \u0dc0\u0dd31\u0db1\u0da7 \u0dc3\u0dc4\u0dba\u0dad\u0dd2\u0da7 \u0db8\u0dd2\u0db1 [ \u0db1\u0dd2 \u0dca \u0da7\u0dba)1\u0dd2\u0daf?\n\n\u0d9c\u0dd4\u0dab \u0db8\u0dc4\u0dd2\u0db1\u0dca\u0daf \u0d85\u0db8\u0dbb\u0dc0\u0dd3\u0dbb \u0db8\u0dc3\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bae\u0bb9\u0bbf\u0ba8\u0bcd\u0ba4 \u0b85\u0bae\u0bb0\u0bb5\u0bc0\u0bb0) (The Hon. Mahinda Amaraweera) \u0d9c\u0dc0 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dca\u200d\u0dba \u0da7\u0dcf\u0dd2)\u0dd2 \u0da7\u0dd4,\u0dca\u0db1\u0dd2 \u0dc1\u0dca\u0db4 \u0dc3\u0dca\u0db4\u0db6\u0db1\u0dca\u0db1\u0dc1 \u0db1\u0dca \u0dd2\u0db01\u0dd2\u0daf \u0db1\u0dca \u0dc3\u0dd2 \u0db1\u0dba\u0dd2\u0daf\u0dd2 \u0daf\u0dd2)\u0dc1\u0dda \u0db41\u0dca 1\u0db1\u0dca) \u0dd2\u0db0\u0db4 [\u0dc2\u0dca\u0da8\u0dc1 \u0db1\u0dca \u0d89\u0dbd\u0dca \u0da0\u0dca [ \u0da7\u0dba \u0dad\u0dd2\u0dc1\u0db6)1\u0dd2. \u0d85\u0db4\u0dd2 \u0d91\u0dc4\u0dd2\u0dd3 \u0dd3\u0dbb\u0dca\u0d9d1 \u0db4\u0dd2\u0dc5\u0dd2\u0dd4,\u0dc0 \u0dc1\u0daf\u0db1\u0dca)\u0dca\u0db4. \u0d85\u0db4\u0dd2 \u0dc1\u0dca\u0db4 1\u0dad\u0dd2\u0dc1\u0dda\n\n\u0dc0\u0dd31\u0db1\u0da7 \u0db8\u0dd2\u0db1 [ \u0db1\u0dd2 \u0dca \u0da7\u0dcf\u0dd2. \u0d9c\u0dd2 1\u0dad\u0dd2\u0dc1\u0dda )\u0dd2\u0da9\u0dd4 \u0dc0\u0dd3 \u0d9a\u0dd2\u0dc1\u0db1\u0ddd1 \u0d85\u0db4\u0dd2 \u0d9c\u0dca \u0dc1\u0dca \u0dc0 \u0db4\u0dd2 \u0dbd\u0dca ]1\u0da7. \u0dc1\u0dca\u0db4 1\u0dad\u0dd2\u0dc1\u0dda \u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc0 \u0db4\u0dd2 \u0dbd\u0dca 901\u0da7. \u0d92 1\u0dd2\u0dc1 \u0dca \u0dc3\u0dca\u0db4\u0db6\u0dd2 \u0dc0\u0dd3 \u0d9a\u0dd2\u0dc1\u0db1\u0ddd1 \u0dc0 \u0db4\u0dd2 \u0dbd\u0dca 920 [ \u0dc3\u0dc4\u0dba \u0d9a\u0dd3\u0dd2\u0db4 \u0dc3\u0dca\u0db4\u0db6\u0dd2 \u0dc0\u0dd3 \u0d9a\u0dd2\u0dc1\u0db1\u0ddd1 \u0dc0 \u0db4\u0dd2 \u0dbd\u0dca 930\u0dba\u0dd2 \u0d9a\u0dd2 \u0db1\u0dd2 \u0db8\u0dd2\u0db1 \u0db1\u0dd2 \u0dca \u0da7\u0dba\u0db1\u0dd2 \u0dad\u0dd2\u0dc1\u0db6)1\u0dd2. \u0d92 \u0db1\u0dd2 \u0dca \u0da7\u0dcf \u0db8\u0dd2\u0db1\u0da7 \u0dc0\u0dd3 \u0d9c\u0db1\u0dca) \u0d85\u0db4\u0dd2 \u0dc3\u0dd6\u0daf\u0dd2)\u0db8\u0dd2\u0db1\u0dd4\u0dca \u0d89\u0db1\u0dca)1\u0dd2. \u0daf\u0dd0)\u0da7\u0dca\u0dca \u0dc0\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0dca\u0dd2\u0da7 [ \u0d85\u0db4 \u0dc11\u0dad \u0db1\u0dd0\u0db6\u0dd2\u0db1\u0dd2 \u0dad\u0dd2\u0dc1\u0db6)1\u0dd2. \u0dc1\u0db4\u0dde\u0dc1\u0d9c\u0dbd\u0dd2\u0da7 \u0d85\u0d82 \u0dc1 \u0db1\u0dca \u0d8a\u0da7 1\u0da9\u0dd2 1\u0dd0\u0dd2 \u0db8\u0dd2\u0db1\u0da7\u0da7 \u0dc0\u0dd3 \u0db8\u0dd2\u0db1\u0dd3 \u0d9c\u0dd0\u0db1\u0dd3\u0dca \u0dc3\u0dd2\u0daf\u0dd4 1)1\u0dd2."
