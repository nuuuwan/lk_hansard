    "chunk_text": "\u0db8\u0db8 \u0daf\u0db8\u0daf\u0dc4\u0db8 \u0daf\u0daf\u0dba\u0dda \u0daf\u0dba\u0ddd\u0da2\u0db1\u0dcf \u0dd9\u0dbb\u0db1\u0dca\u0db1 \u0dd9\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0db1\u0dca. \u0dd2\u0daf \u0dd2\u0db4\u0dd2 \u0da2\u0dd3\u0dd9\u0dad\u0dca \u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0d89\u0daf\u0dbd\u0dda\u0daf\u0da7\u0dca\u200d\u0dbb\u0dcf\u0db1\u0dd2\u0dd9 \u0daf\u0dbd\u0ddd\u0dd9\u0dba\u0dd9 \u0daf\u0db1\u0dca. \u0daf\u0dd0\u0db1\u0dca \u0daf\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0dd2\u0db4\u0dd2 silos\u0dd9\u0dbd \u0daf\u0db1\u0dca \u0d89\u0db1\u0dca\u0daf\u0db1\u0dca. \u0db4\u0dcf\u0da8\u0dbd\u0dd3 \u0da0\u0dda\u0db4\u0dd2\u0dd9 \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0daf\u0dda \u0dd9\u0db8\u0dd2\u0da7\u0dd4\u0daf\u0dda \u0daf\u0dd9\u0db1 \u0daf\u0dda\u0dd9\u0dbd\u0dca \u0d91\u0daf\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda \u0daf\u0dbb\u0ddd\u0dc4\u0dd2\u0dad \u0dd2\u0daf\u0db6\u0dca\u0dbd\u0dab\u0dc0\u0dab\u0dd9\u0dbb\u0dca\u0dbd\u0db1\u0db1 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dcf\u0daf\u0dda \u0dd9\u0db8\u0dd2\u0da7\u0dd4\u0daf\u0dda \u0daf\u0dd9\u0db1 \u0daf\u0dda\u0dd9\u0dbd\u0dca \u0dbd\u0dc3\u0db1\u0dca\u0dad \u0dd2\u0dbd\u0d9c\u0dd2\u0dba\u0dd9\u0db1\u0dca\u0db1 \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0daf\u0dda \u0dd9\u0db8\u0dd2\u0da7\u0dd4\u0daf\u0dda \u0daf\u0dd9\u0db1 \u0daf\u0dda\u0dd9\u0dbd\u0dca \u0dd2\u0daf\u0dca \u0dd9\u0db8\u0dd2\u0da7\u0dd4\u0daf\u0dda \u0daf\u0dd9\u0db1 \u0daf\u0dda\u0dd9\u0dbd\u0dca \u0daf\u0dd9\u0db1 \u0daf\u0dd9\u0db1\u0db8 \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca. \u0daf\u0db8\u0dad\u0dd0\u0db1\u0daf\u0dd3\u0db4 \u0dd2\u0db4\u0dd2 \u0daf\u0dd0\u0db1\u0d9c\u0dad\u0dca\u0dad \u0daf\u0daf\u0dba\u0dda \u0dad\u0db8\u0db1\u0dca \u0dd2\u0daf\u0dca \u0dd9\u0dcf\u0dbb\u0dd9 \u0dc3\u0dcf\u0dcf\u0dd9\u0da7 \u0daf\u0dda\u0dd9 \u0daf\u0d9c\u0db1\u0dcf\u0dd9\u0dcf\u0da7 \u0db6\u0dc0\u0dd4\u0db1\u0dca \u0db8\u0dd3\u0da7 \u0dd9\u0dd2\u0db1\u0dca \u0daf\u0dda \u0dc3\u0dda\u0dd9\u0db1\u0dca\u0db1\u0daf\u0dba\u0db1\u0dca \u0dba\u0dda\u0d9a\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0daf\u0dda\u0dc1\u0dba\u0dda \u0daf\u0dd3\u0db4\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0dd9. \u0dd2\u0db4\u0da7 \u0dd9\u0dd0\u0dbb\u0dd2\u0daf \u0daf\u0dda\u0dd9 \u0da2\u0dcf\u0dbd\u0d9c\u0dad \u0dd9\u0dbb\u0db1\u0dca\u0db1? \u0db4\u0db1\u0dad\u0dca \u0daf\u0dd9\u0da7\u0dd4\u0dda\u0db4\u0dad\u0dda \u0daf\u0dda\u0db1\u0daf\u0dd9\u0dcf\u0da7 \u0d92 \u0daf\u0dd9\u0da7\u0dd4\u0dda\u0db4\u0dad \u0dc3\u0dda\u0dd9\u0db1\u0dca\u0db1\u0daf\u0dba\u0db1\u0dca \u0d91\u0daf\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda \u0dc3\u0d82\u0daf\u0dc1\u0ddd\u0db1\u0db1 \u0dc3\u0dda\u0dd9\u0db1\u0dca\u0db1\u0daf\u0dba\u0db1\u0dca \u0dba\u0dda\u0d9a\u0dd2\u0db1\u0dca \u0dd9\u0dcf\u0dbb\u0dd9 \u0dc3\u0dcf\u0dcf\u0dd9\u0d9a\u0dd2\u0db1\u0dca \u0dba\u0db8\u0dda \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0daf\u0dda\u0dc1 \u0dd9\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf \u0db1\u0dda \u0d92\u0dd9\u0dcf \u0dd2\u0daf\u0db1\u0dda \u0db8\u0db1\u0dca\u0dd3\u0dd9\u0dbb\u0dd4 \u0daf\u0dd0\u0db1\u0d9c\u0db1\u0dca\u0daf\u0db1\u0dca \u0daf\u0dd9\u0dcf\u0daf\u0dc4\u0dcf\u0db8\u0daf? \u0dd2\u0daf \u0daf\u0dbd\u0ddd\u0dd9\u0daf\u0dda \u0daf\u0dda\u0dd9 \u0dd9\u0dbb\u0db1 \u0d91\u0dd9 \u0dc4\u0dbb\u0dd2\u0db8 simple. \u0dd2\u0db4\u0da7 \u0daf\u0dda\u0dd9\u0da7 software \u0dc4\u0daf\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd9\u0db1\u0dca. \u0d91\u0dad\u0daf\u0dd9\u0dcf\u0da7 \u0dd2\u0db4\u0da7 electronically \u0daf\u0dd0\u0db1\u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd9\u0db1\u0dca \u0daf\u0db8\u0dad\u0dd0\u0db1 \u0daf\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d92\u0dd9 \u0dd9\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd9\u0db1\u0dca \u0daf\u0daf\u0dba\u0dda. \u0d9c\u0dbb\u0dd4 \u0dd9\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0dd9\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db8\u0db8 Secretary-General\u0da7 \u0daf\u0dba\u0ddd\u0da2\u0db1\u0dcf \u0dd9\u0dbb\u0db1\u0dd9\u0dcf \u0daf\u0dda \u0db4\u0dd2\u0dd2\u0db6\u0dd9\u0db3\u0dd9 \u0daf\u0dc3\u0dcf\u0dba\u0dcf \u0dd9\u0dbd\u0dbd\u0dcf once and for all, \u0daf\u0dda\u0dd9 integrate \u0dd9\u0dbb\u0db1\u0dca\u0daf\u0db1\u0dca \u0daf\u0dd9\u0dcf\u0daf\u0dc4\u0dcf\u0db8\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dd9\u0dbd\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda \u0daf\u0dda \u0dd9\u0dcf\u0daf\u0dda \u0daf\u0dda\u0dd9\u0dbd\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7\u0dad\u0dca \u0db1\u0dca\u0dda\u0db1 \u0daf\u0dd9\u0db1\u0dca\u0db1 \u0d89\u0da9 \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf.\n\n\u0d9c\u0dbb\u0dd4 \u0dd9\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0dd9\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0daf\u0daf\u0dd9\u0db1\u0dd4\u0dd9 \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0daf\u0db1\u0dca \u0dd9\u0dd0\u0d82\u0dd4 (\u0dc3\u0d82\u0daf\u0dc1\u0ddd\u0db1\u0db1) \u0db4\u0db1\u0dad\u0dca \u0daf\u0dd9\u0da7\u0dd4\u0dda\u0db4\u0dad \u0d9c\u0dd0\u0db1\u0db1\u0dca. \u0d92\u0daf\u0dda \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0dd9\u0dd0\u0d82\u0dd4 \u0db4\u0dda\u0db1\u0dad\u0dd2\u0dba \u0dc1\u0dda\u0dad\u0dd2\u0db8\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dda\u0dd9\u0db1\u0dca\u0db1\u0daf\u0dba\u0db1\u0dca. \u0d92 \u0db4\u0dd2\u0dd2\u0db6\u0dd9\u0db3\u0dd9 \u0dd2\u0db4\u0da7\n\n\u0d91\u0dad\u0daf\u0dd9\u0dcf\u0da7 Port City \u0d91\u0daf\u0dda\u0dad\u0dca \u0dd9\u0dbb\u0db1\u0dca\u0daf\u0db1\u0dca \u0d91\u0dd9\u0db8 \u0daf\u0dda \u0db1\u0dda \u0dbb\u0da7\u0da7 \u0dbd\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dd9\u0daf\u0dd4 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dbd\u0dd0\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dd2\u0db4\u0dd2 \u0daf\u0dda\u0dd9\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dd9\u0dcf cannibalizing \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dbd\u0d82\u0dd9\u0dcf\u0daf\u0dda \u0dd2\u0daf\u0db1\u0dda \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dd9\u0dbd \u0dad\u0dd2\u0daf\u0dd9\u0db1 \u0dd2\u0dda\u0daf\u0dd9\u0dbb \u0d9c\u0db1\u0dd4\u0daf\u0daf\u0db1\u0dd4 Port City \u0d91\u0dd9\u0da7 \u0daf\u0dd9\u0dcf\u0da0\u0dca\u0da0\u0dbb \u0daf\u0dd4\u0dbb\u0da7 transfer \u0dd9\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0dd9 \u0db4\u0dd2\u0dd2\u0db6\u0dd9\u0db3\u0dd9 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9 \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dd2\u0db4\u0dd2 \u0daf\u0dc4\u0dcf\u0dba\u0dbd\u0dcf \u0dd9\u0dbd\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1\u0dd9\u0dcf. \u0daf\u0db8\u0dcf\u0dd9\u0daf Port City \u0d91\u0daf\u0dd9\u0db1\u0dca \u0db4\u0dd2\u0da7\u0daf\u0dd2 \u0dd9\u0daf\u0dd4 \u0daf\u0d9c\u0dd9\u0db1\u0dd9\u0dcf \u0db1\u0dda Port City \u0d91\u0daf\u0dda \u0dd9\u0daf\u0dd4 \u0daf\u0d9c\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda \u0dd2\u0db4\u0dd2 \u0dd9\u0daf\u0dd4 \u0daf\u0d9c\u0dd9\u0db1 \u0dad\u0dd0\u0db1\u0dca\u0dd9\u0dbd \u0d89\u0db3\u0dbd\u0dcf\u200d\u0daf\u0dda \u0dd9\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dd9\u0dbb\u0db1\u0dca\u0daf\u0db1\u0dca \u0d87\u0db1\u0dca? Port City \u0d91\u0dd9\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0db6\u0dda\u0daf\u0dd9\u0ddd\u0db8 \u0dd9\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd9\u0db1\u0dca \u0daf\u0db1\u0dca. \u0dd2\u0dda\u0daf\u0dd9\u0dbb \u0d9c\u0db1\u0dd4\u0daf\u0daf\u0db1\u0dd4 \u0d9c\u0dd0\u0db1 \u0db8\u0db8 \u0daf\u0dda \u0dd9\u0dae\u0dcf \u0dd9\u0dbb\u0db1\u0dca\u0daf\u0db1\u0dca. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dd2\u0db4\u0dd2 \u0d92 \u0db4\u0dd2\u0dd2\u0db6\u0dd9\u0db3\u0dd9\u0dad\u0dca \u0dd9\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0dd9\u0dda \u0dd9\u0dd0\u0db3\u0dd9\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf. \u0db8\u0da7 \u0dd9\u0dcf\u0dbd\u0dba \u0dbd\u0dd9\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0da7 \u0daf\u0dd9\u0dcf\u0daf\u0dc4\u0dcf\u0db8 \u0dc3\u0dca\u0dad\u0dd4\u0dad\u0dd2\u0db1\u0dca \u0d9c\u0dbb\u0dd4 \u0dd9\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0dd9\u0dad\u0dd4\u0db8\u0db1\u0dd2."
