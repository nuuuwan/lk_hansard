    "chunk_text": "(\u0d89) \u0d91\u0db8 \u0db4\u0db1\u0dad\u0dca \u0dc1\u0dd9\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dc1\u0dad\u0dca 22 1\u0dd0\u0db1\u0dd2 1\u0d9c\u0db1\u0dca\u0dad\u0dad\u0dd2 \u0d86\u0dab\u0dca\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 1\u0dba1\u0dc3\u0dda\u0dae\u0dd21\u0da7 \u0d85\u0db1\u0db1\u0dd4\u0dd6\u0daf \u0db61\u0dad\u0dca \u0d92 \u0d85\u0db1\u0dd41 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dca\u0da8 \u0db6\u0dc4\u0dd4\u0dad\u0dba \u0dd2\u0dbb\u0db1\u0dca\u0dad \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dd9\u0dba \u0d9c\u0dad \u0dba\u0dd4\u0dd4 \u0db61\u0da7\u0dad\u0dca \u0dc3\u0dba\u0daf \u0db6\u0dc4\u0dd4\u0dad\u0dba \u0dd2\u0dbb\u0db1\u0dca\u0dad \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dd9\u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db1\u0db8\u0dca \u0dc1\u0dbb\u0dda\u0dc2\u0dca\u0da8\u0dda\u0db0\u0dd2\u0db0\u0dd2\u0dd9\u0dba\u0da7 \u0dbb\u0dd4\u0db1\u0dca\u0dad\u0dd4\u0dc01 \u0db4\u0dca\u200d\u0dbb\u0dd9\u0dd2\u0dba1 \u0dc3\u0d82\u0dc1 \u0ddd\u0db0\u0db1 \u0dc3\u0dd2\u0dd4\u0dc0 \u0dd9\u0dc5 \u0dba\u0dd4\u0dd4 \u0db61\u0dad\u0dca \u0dc1\u0dbb\u0dda\u0dc2\u0dca\u0da8\u0dda\u0db0\u0dd2\u0db0\u0dd2\u0dd9\u0dba\u0da7 \u0dbb\u0dd4\u0dba\u0da7 \u0dd9\u0dba \u0dad\u0dd2\u0db6\u0dd2 \u0daf\u0dd3 \u0d91\u0db8 \u0dc3\u0d82\u0dc1 \u0ddd\u0db0\u0db1 \u0dc3\u0dd2\u0dd4\u0dc0 \u0dc1\u0db1\u0dd2\u0dd9\u0dba \u0dc3\u0dba\u0daf \u0db6\u0dc4\u0dd4\u0dad\u0dba \u0dd2\u0dbb\u0db1\u0dca\u0dad \u0d91\u0db8 1\u0d9c\u0db1\u0dca\u0dad\u0dad\u0dd2 \u0dc3\u0d82\u0dc1 \u0ddd\u0db0\u0db1 \u0dd9\u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d89\u0da9 \u0daf\u0db6\u0dd2 \u0daf\u0dd3\u0dc1\u0db8\u0db1\u0dca\u0dad \u0daf;\n\n\u0dc1\u0db8\u0dca \u0db61 \u0dad\u0dc4\u0dba\u0dc0\u0dd4\u0dc0 \u0dd9\u0dba\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0daf\u0d82\u0dd9\u0dd2 \u0db8\u0dd2\u0db11 \u0dc4\u0dd2\u0db8\u0dd2\u0dd9\u0db8\u0dca \u0dc1\u0dd9\u0dd2\u0db8\u0dd2\u0dc2\u0dca\u0da8\u0db1\u0dca\u0dad \u0dc3\u0db7\u0dd21 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0daf \u0d91\u0db8 \u0db4