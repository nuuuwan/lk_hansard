d0\u0db1\u0dca\u0dd3\u0dbb\u0db8 \u0bc6\u0bae\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd\n\nPAPERS PRESENTED\n\n\u0d9c\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db1\u0dca\u0db1 \u0dbb\u0dab\u0dd4\u0d82\u0d9c \u0db8\u0dc4\u0dad\u0dcf (\u0db1\u0dcf\u0d9c\u0dd2\u0daf\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0dad\u0db0\u0dcf\u0db1 \u0dc4\u0dcf \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0d85\u0db8\u0dcf\u0dad\u0dba \u0dc3\u0dc4 \u0dbb\u0dab\u0dca\u0da9\u0dd4 \u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc1\u0dca\u0db1\u0dc0\u0dc0\u0dda \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0dba\u0d9a\u0dd4\u0db8\u0dcf) (\u0bae\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0baa\u0bbf\u0bb0\u0bc6\u0ba9\u0bcd\u0ba9 \u0bb0\u0ba3\u0ba4\u0bc1\u0b99\u0bcd\u0b95 - \u0ba8\u0b95\u0bb0 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bc0\u0b9f\u0bae\u0bae\u0baa\u0bcd\u0baa\u0bc1 \u0b85\u0bae\u0bae\u0b9a\u0bcd\u0bc6\u0bb0\u0bc1\u0bae\u0bcd \u0b85\u0bb0\u0bc6\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0bc6\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bae\u0bc1\u0ba4\u0bb1\u0bcd\u0b95\u0b95\u0bc6\u0bbe\u0bb2\u0bc6\u0bbe\u0bc6\u0bc6\u0bbe\u0ba9\u0bc1\u0bae\u0bcd) (The Hon. Prasanna Ranatunga - Minister of Urban Development and Housing and Chief Government Whip) \u0d9c\u0dc0 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dca\u200d\u0dba \u0dd9\u0dae\u0dd2\u0db1\u0dd2 \u0dd9\u0dd4\u0db8\u0db1\u0dd2 \u0d85\u0d9c\u0dca\u200d\u0dbb\u0dd2\u0db8\u0dd2\u0dad\u0dba \u0dc3\u0dc4\u0dba \u0dba\u0dd2\u0da2\u0dca\u200d\u0dba \u0db4\u0dbb\u0dd2\u0db4\u0dd2\u0daf\u0db1 \u0dc3\u0dda1\u0dc1\u0dda \u0dd9\u0da7\u0dba\u0dd4\u0dd4 \u0db4\u0dc5\u0dd2\u0dad\u0dca \u0dc3\u0db7\u0dd2 \u0dc4\u0dba\u0dd2 \u0db4\u0dc5\u0dd2\u0dad\u0dca \u0db4\u0dd2\u0daf\u0db1 \u0d85\u0db8\u0dd2\u0dad\u0dba\u0dd4\u0db8\u0dd2 \u0dc11\u0db1\u0dd4\u0dc11\u0db1\u0dca\u0dad \u0db8\u0db8 \u0db4\u0dc4\u0dba\u0dad \u0dc3\u0db3\u0dc4\u0dba\u0db1\u0dca\u0dad 1\u0dd2\u0dbb\u0dca\u0dad\u0dd2 \u0d89\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dd9\u0dba\u0db8\u0dd2.\n\n(i) 2022 1\u0dbb\u0dca\u0dc2\u0dca\u0da8 \u0dc3\u0db3\u0dc4\u0dba\u0dd2 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0daf\u0d82\u0dd9\u0dd2 \u0d86\u0dc1 \u0ddd\u0da2\u0dca\u200d\u0db1 \u0db8\u0dab\u0dca\u0da9\u0daf\u0dc1\u0dda 1\u0dd2\u0dbb\u0dca\u0dd2\u0dd9 1\u0dd2\u0dbb\u0dca\u0dad\u0dd21; \u0dc3\u0dc4\u0dba\n\n(ii) 2022 1\u0dbb\u0dca\u0dc2\u0dca\u0da8 \u0dc3\u0db3\u0dc4\u0dba\u0dd2 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0daf\u0d82\u0dd9\u0dd2 \u0d9c\u0dd2\u0dd4 \u0db8\u0dca \u0dc4\u0dba\u0dd2 \u0dc0\u0dd2\u0d9c\u0da7\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd2 \u0dc3\u0db8\u0dd3\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0da7 \u0db8\u0dab\u0dca\u0da9\u0daf\u0dc1\u0dda 1\u0dd2\u0dbb\u0dca\u0dd2\u0dd9 1\u0dd2\u0dbb\u0dca\u0dad\u0dd21.\n\n\u0dc1\u0db8\u0db8 1\u0dd2\u0dbb\u0dca\u0dad\u0dd2 \u0da2\u0dca\u200d\u0dd2\u0dad\u0dd2\u0dd9 \u0d86\u0dbb\u0dca\u0dd2\u0dd9 \u0dc4\u0dba\u0dd2 \u0dc1\u0db7\u0dde\u0dad\u0dd2\u0dd9 \u0dc3\u0dd0\u0daf\u0dc3\u0dd4\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d86\u0d82\u0dc1\u0dd2\u0dd9 \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0da7 \u0dd9\u0dd2\u0dba\u0dd9 \u0dc3\u0db7\u0dd21 \u0dc11\u0dad \u0dc1 \u0dd2\u0dd4 \u0dd9\u0dc5 \u0dba\u0dd4\u0dd4 \u0dd0\u0dba\u0dd2 \u0db8\u0db8 \u0dc1 \u0ddd\u0da2\u0dca\u200d\u0db1\u0dd2 \u0dd9\u0dba\u0db8\u0dd2.\n\n\u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0db1\u0dba \u0dc0\u0dd2\u0db8\u0dc3\u0db1 \u0dbd\u0daf\u0dd2\u0db8\u0db1\u0dca \u0dc3\u0db7\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dc0\u0dd2\u0dba. \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. Question put, and agreed to."
