 \u0dc1\u0d9c\u0dde\u0dba1\u0db1\u0dd3 \u0dc1\u0da7\u0dc1) [. )\u0db8\u0dd4\u0dca \u0db4\u0dc3\u0dd4 \u0da7\u0dd2 \u0da0)1 \u0dc1\u0d9c\u0ddd\u0db0\u0dd2\u0dcf \u0dba\u0dd2\u0da2\u0dca\u200d\u0db4 [\u0dc2\u0dca\u0da8 \u0d9a\u0dd2 ) \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0da2\u0dca\u200d)\u0dd2\u0db0\u0dd2\u0db4\u0dad\u0dd21\u0dba \u0dd2 \u0da7\u0dc1\u0dca \u0da7\u0da7\u0dd4\u0dad\u0dd4, \u0da7\u0dba\u0db1\u0dca)\u0da7 \u0da7\u0dcf\u0dd2)\u0dd2 \u0da7 \u0db4\u0dd4\u0dd4\u0db8\u0dc1\u0dda 1\u0dd2\u0dd2 \u0dc11\u0db1\u0dca)\u0da7 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd3\u0dca \u0dd4,\u0dcf \u0d91\u0dd4,\u0dca\u0dd2 \u0dc1\u0d9c) \u0d86 \u0d91\u0da7\u0dd4, \u0da7\u0dba\u0d9c\u0dca \u0d92 \u0dc3\u0dd2 \u0dbd\u0dd4 \u0dc1\u0d9c\u0dde\u0dba1 \u0db1\u0dca )\u0dd0\u0dad\u0dd2\u0dc11\u0db8\u0dd2\u0db1\u0dca \u0d91\u0dd4,\u0dca\u0dd2\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dd6\u0db4\u0db4 \u0dd4,\u0da7\u0dca\u0dd4\u0db8 \u0dc1\u0daf\u0da7\u0da7 1\u0dd0\u0dc1\u0da7) \u0dca\u0da7\u0dca\u0da7\u0dca\u0da7 \u0da7\u0dd2\u0dba\u0da7\u0dd2 \u0dc3\u0dd2\u0dc1\u0db1 \u0dc11\u0db1\u0dca) \u0db4\u0da7\u0db1\u0dca \u0d9c\u0dca \u0dad\u0dd2. \u0d85\u0daf \u0dc11)\u0dc1\u0da7\u0ddc\u0da7 1\u0dbb\u0dca\u0dad\u0dca\u0dd2) \u0da2\u0dca\u200d)\u0dd2\u0db0\u0dd2\u0db4\u0dad\u0dd21\u0dba \u0dd2 \u0da7\u0dc1\u0dca \u0d91\u0dd4,\u0dca\u0dd2 \u0db4 \u0dc1 \u0db1\u0dc1 \u0d9c\u0da7)\u0da7 \u0db4\u0dca \u0dc11\u0db1\u0dd2 \u0dad\u0dd2\u0dc1\u0db6)1\u0dd2.\n\n1731 1732\n\n\u0db4\u0dd2\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dca\u0db4\u0db1\u0dca\u0dd4,1\n\n\u0dc1\u0dca\u0ddc\u0da7\u0daf \u0d85\u0daf \u0d85\u0db4\u0dd2 IMF \u0d91\u0da7 \u0d89\u0dc3\u0dcf\u0dc3\u0dba\u0dc4\u0dba\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0db1\u0dd2 \u0d9a\u0dd2 \u0db1\u0dca\u0dc1\u0db1\u0dca \u0d85\u0dc1\u0db4\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0dc1\u0dda \u0d86\u0db0\u0dd2\u0db4\u0dad\u0dba \u0d9c\u0dd0)\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0db1\u0dd2 \u0da7\u0dcf\u0dd2 \u0da7\u0dba\u0db1\u0dca\u0dc1\u0