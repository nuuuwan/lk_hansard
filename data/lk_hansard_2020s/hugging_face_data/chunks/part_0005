    "chunk_text": "\u0db6\u0db1\u0dca\u0dd2\u0daf\u0d9a\u0dc0\u0dbd\u0dc0\u0db0 \u0d91\u0dc1\u0dc4\u0db8 \u0dc4\u0db1\u0dc1\u0db4\u0db1\u0dc0\u0dcf \u0dad\u0db8\u0db1\u0dca. \u0dbd\u0dcf\u0db0\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0dca\u0da7\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dbd, \u0d89\u0dc3\u0dca\u0dc3\u0dbb \u0dc1\u0dc4\u0dca\u0da9\u0dbd\u0dba\u0dcf \u0db6\u0db1\u0dca\u0dd2\u0daf\u0d9a\u0dc0\u0dbd \u0db0\u0dcf\u0d9a\u0dcf \u0dc0\u0da7 \u0d86\u0dd4 \u0d9a\u0dcf\u0db0\u0dc1\u0db1 \u0dc1\u0d9a\u0dca\u0dc5\u0db9 \u0dc1\u0dbb\u0ddd\u0dc4\u0dc1\u0dc0\u0dbd \u0dc1\u0dc0\u0db1\u0db8 \u0dc0\u0dcf\u0da7\u0dca\u0db4\u0dca\u0dc0\u0d9a\u0dca \u0dc4\u0db1\u0dd4 \u0dc0\u0dcf, \"\u0dc1\u0dc4\u0dca\u0da9\u0dbd\u0dba\u0dcf \u0dc0\u0dcf\u0da7\u0dca\u0db4\u0dca\u0dc0\" \u0d9a\u0dd2 \u0db0\u0dcf. \u0d92\u0dc1\u0d9a\u0dca \u0db1\u0db8 \"\u0dc1\u0dc4\u0dca\u0da9\u0dbd\u0dba\u0dcf \u0dc0\u0dcf\u0da7\u0dca\u0db4\u0dca\u0dc0\". \u0dc1\u0db0\u0dca \u0da9\u0dd4 \u0dc1\u0dc4\u0dca\u0da9\u0dbd\u0dba\u0dcf \u0dc0\u0dcf\u0da7\u0dca\u0db4\u0dca\u0dc0\u0da7 \u0db1\u0db8\u0dca\u0da7\u0db1 \u0db6\u0db1\u0dd2\u0db1 \u0dc0\u0dd4\u0dab\u0dcf\u0db8 \u0dc1\u0dc0\u0db1\u0dad\u0dca \u0dc0\u0dcf\u0da7\u0dca\u0db4\u0dca\u0dc0\u0db0\u0da7\u0dad\u0dca \u0dc1\u0d9c\u0dd2\u0dbd\u0dd2\u0dc0\u0dca\u0da7 \u0db1\u0db1\u0dca \u0db8\u0dcf. \u0dbb\u0dcf\u0dc0\u0dcf\u0dc4\u0db1 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0dc4\u0db1\u0db6\u0db1\u0db1\u0dca, \u0dbb\u0dcf\u0dc0\u0dcf\u0dc4\u0db1 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0dc0\u0dd3\u0dc1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2 \u0dad \u0d9c\u0dad\u0dca\u0dad\u0dcf\u0db8, \u0dc1\u0db8\u0dc0\u0db1\u0dd2\u0dbd high-capacity motorcycles\u0dc0\u0dd2\u0dba\u0dca\u0da7 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0dd4\u0dad\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0d85\u0da9\u0dd4\u0db1\u0dca.\n\n\u0dbd\u0dcf\u0db0\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0dca\u0da7\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dbd, \u0db8\u0db8 \u0d9a\u0dd2 \u0db1 \u0dc1\u0dca \u0db6\u0db1\u0dca\u0dd2\u0daf\u0d9a\u0dc0\u0dbd \u0dd2\u0dba \u0dcf \u0db4\u0daf\u0dd2\u0dcf\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dd2\u0dbd\u0dc3\u0dcf \u0dc1\u0db6\u0dca\u0dc1\u0dc4\u0dca\u0db8 \u0db4\u0db1\u0dc4\u0db1\u0daf\u0dd2\u0dd2\u0dba\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dc1 \u0ddd\u0da2\u0db1 \u0d9c\u0dab\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0db0\u0db1\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc3\u0dcf \u0dcf\u0dbb\u0d9a \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0da7\u0dad\u0dca \u0d91 \u0dc0\u0db1\u0db1\u0d9c\u0dad\u0dca. \u0d85\u0db1 \u0d85\u0dc1 \u0dc0 \u0dbb\u0dc1\u0da7\u0dca \u0dc3\u0dcf \u0dcf\u0dbb\u0d9a \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0daf\u0dd2\u0dd4\u0dad\u0dab\u0dd4 \u0dc1\u0dc0\u0db8\u0dd2\u0dca\u0da7 \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dc0\u0dcf. \u0db1\u0db1\u0dca\u0da7 \u0dc3\u0dcf \u0dcf\u0dbb\u0d9a\u0dc1 \u0ddd \u0d85\u0dc1 \u0dc0 \u0dbb\u0da7\u0da7 \u0d91\u0db1\u0dc0\u0dcf. \u0dc3\u0dcf \u0dcf\u0dbb\u0d9a\u0dc1 \u0ddd \u0d85\u0dc1 \u0dc0 \u0dbb\u0da7\u0da7 \u0dd4\u0dd2\u0dbb\u0dc0\u0dbd\u0db0\u0dcf \u0dc3\u0dcf \u0dcf\u0dbb\u0d9a \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0d9a\u0dbb\u0db1 \u0d85 \u0dc1\u0d9c\u0dca\u0da7 \u0d85\u0dc4\u0db1\u0dc0\u0dcf, \u0d85\u0db4\u0da7 600cc bike \u0d91\u0d9a\u0d9a\u0dca \u0d9c\u0dca\u0da7\u0db1 \u0db1\u0db1\u0dc1\u0db1, \u0d85\u0db4\u0da7 1000cc bike \u0d91\u0d9a\u0d9a\u0dca \u0d9c\u0dca\u0da7\u0db1 \u0db1\u0db1\u0dc1\u0db1, \u0d85\u0db4\u0da7 1300cc bike \u0d91\u0d9a\u0d9a\u0dca \u0d9c\u0dca\u0da7\u0db1 \u0db1\u0db1\u0dc1\u0db1 \u0d9a\u0dd2 \u0db0\u0dcf. \u0d92 \u0d85 \u0d9a\u0dd2 \u0db1\u0dc0\u0dcf, \u0d85\u0db4\u0da7 \u0d92 \u0dc0\u0dcf\u0dc1\u0dda bike \u0d91\u0d9a\u0d9a\u0dca \u0db4\u0daf\u0dd2\u0dca\u0da7\u0db1 \u0db1\u0db1\u0dad. \u0d85\u0db4\u0dd2 \u0d92\u0d9a\u0da7 \u0db8\u0dd4\u0db1\u0dc0\u0dbd \u0dd2\u0dbb \u0db1\u0dca \u0d9a\u0dbb\u0dca\u0da7\u0db1\u0dca \u0d9a\u0dd2 \u0db0\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0d91\u0dc0\u0db1\u0dd2\u0dbd bike \u0d91\u0d9a\u0d9a\u0dca \u0dc1\u0db1\u0dca\u0da7\u0db1 \u0d85\u0db4\u0da7 \u0dd2\u0dbb\u0db0\u0dd2 \u0d9a\u0dca \u0db1\u0db1\u0dc4\u0db1. \u0dd4\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0d91\u0dc0\u0db1\u0dd2\u0dbd bikes \u0dd2\u0dba \u0dcf \u0db4\u0daf\u0dd2\u0dcf\u0da0\u0dd2 \u0d9a\u0dbb\u0dca\u0da7\u0dc1\u0dca\u0da7 \u0db1\u0db1\u0dc4\u0db1. \u0d91\u0d9a \u0db4\u0db1\u0dad\u0dca\u0dad\u0d9a\u0dd2\u0dca\u0da7, \u0dc3\u0dcf \u0dcf\u0dbb\u0d9a \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0da7 \u0dc1\u0dca \u0d9a \u0db6\u0db0\u0db4\u0dcf\u0db1\u0dc0\u0dcf. \u0dc3\u0dcf \u0dcf\u0dbb\u0d9a \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dc1\u0db1 \u0dad\u0dc0\u0dad\u0dca \u0db4\u0db1\u0dad\u0dca\u0dad\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf sports tourism \u0d9a\u0dd2 \u0db0\u0dcf. \u0d92\u0dc0\u0dcf\u0da7\u0dad\u0dca \u0d92 \u0db6\u0db1\u0dca\u0dd2\u0daf\u0d9a\u0dc0\u0dbd \u0dc1 \u0dca\u0db1\u0dcf \u0d9c\u0dca\u0da7\u0db1 \u0dd4 \u0da2\u0dc0\u0dca\u0da7. \u0d91\u0dc0\u0db1\u0dd2\u0dbd \u0db6\u0db1\u0dca\u0dd2\u0daf\u0d9a\u0dc0\u0dbd \u0db4\u0daf\u0dd2\u0db1 \u0dcf\u0dcf\u0dc0\u0db1 \u0db4\u0dcf \u0dc1\u0db0\u0ddd\u0d9a\u0dc1\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0dc1 \u0dc0 \u0dbb\u0dc1\u0da7\u0dca\u0dad\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf, \u0d91\u0dc0\u0db1\u0dd2\u0dbd \u0dcf\u0dcf\u0dc0\u0db1 \u0db4\u0dcf. \u0d85\u0db4\u0da7 \u0dd4 \u0da2\u0dc0\u0dca\u0da7 \u0d92 \u0db6\u0db1\u0dca\u0dd2\u0daf\u0d9a\u0dc0\u0dbd \u0db4\u0daf\u0dd2\u0db1 \u0d85 \u0da7 \u0d85\u0dc1 \u0dc0 \u0dbb\u0da7\u0da7 \u0d86\u0dbb\u0dcf\u0dcf\u0db1\u0dcf \u0d9a\u0dbb\u0dca\u0da7\u0db1."
