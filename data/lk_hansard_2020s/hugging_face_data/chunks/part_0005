\u0db8\u0db3\u0dbb\u0db1\u0dca\u0dad \u0dcf\u0dbb\u0dd4\u0dd4\u0db8 \u0dbb\u0dad \u0dc3\u0dd2\u0daf\u0dd4\u0dd2\u0db8 \u0d92\u0dcf\u0dcf \u0dcf \u0dd2\u0db1\u0dd9 \u0d85\u0da9\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dbb\u0da7 \u0dd9\u0daf\u0dcf\u0dcf \u0dc3\u0dd2\u0daf\u0dd4\u0dd2\u0db8\u0db6\u0dd9 \u0dbb\u0dab\u0dca\u0da9\u0dd9 \u0dcf\u0da7\u0dba\u0dd4\u0dd4\u0dc0 \u0dcf \u0d87\u0dad.\n\n\uf0b7 \u0dc1\u0db4 \u0dc0\u0dbb\u0dd2\u0dca\u0dbd\u0dc2 \u0db1\u0dca\u0dad\u0da7 \u0db8\u0dcf\u0dc1\u0dda\u0d9a\u0dca\u0dc2\u0dc0\u0dbb\u0dd2 \u0dd9\u0dbd\u0dca \u0d85\u0d9f\u0dd4\u0dbb\u0dd4 \u0dd2\u0db1\u0dd9\n\n\u0dc3\u0dd2\u0db1\u0dd2\u0dbb \u0d85 \u0db4\u0dcf\u0dad \u0db8\u0dbb \u0db6\u0dd0\u0daf\u0d9a\u0dd4 \u0dc1\u0db4\u0ddc\u0dd2\u0db8 \u0db8\u0dd0\u0dd9\u0d9a\u0dd2 \u0dba\u0dd4\u0dd4\u0dc0 \u0dbb\u0da7\u0dca\u0da7\u0dd2\u0db1\u0db1\u0dca\u0dad \u0d85\u0da9\u0dd4 \u0dc0\u0dd3\u0dbb \u0db1\u0dd2\u0db8\u0dcf \u0dc3\u0dd2\u0daf\u0dd4\u0dd2\u0db8 \u0da2\u0dba\u0dba \u0da7 \u0dc0\u0dbb\u0dd2\u0dd0 \u0dc0\u0dbb\u0dd2\u0dba \u0db4\u0dd2\u0dba\u0db1\u0dc0\u0dbb\u0dd2\u0dd0 \u0d85\u0da9\u0dd4 \u0dc0\u0dd3\u0dbb.\n\n\uf0b7 2023 \u0dc0\u0dbb\u0dd2\u0dca\u0dbd\u0dc2\u0dc1\u0dda\u0db8 \u0d85\u0dc1\u0dda\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0db4\u0dca\u200d\u0dbb\u0dbb\u0dcf\u0dab \u0da7 \u0dc0\u0dbb\u0dd2\u0da9\u0dcf\n\n\u0dc0\u0dbb\u0dd2\u0dd0\u0da9\u0dd2 \u0da2\u0dd9 \u0dc3\u0dd2\u0daf\u0dd4\u0dd2\u0db8 \u0da2\u0dba\u0dba \u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dbb\u0da7 \u0dbb\u0dd0\u0d9a\u0dd2 \u0dc0\u0dd3\u0dbb \u0dc1\u0dbb\u0dda\u0dd4\u0dc0\u0dc1\u0dc0\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0d89\u0db1\u0dca\u0dad\u0dba\u0dba \u0dbb\u0dba\u0dc1 \u0db1\u0dca\u0dad \u0dc3\u0dd2\u0daf\u0dd4\u0dd2\u0db8 \u0da2\u0dba\u0dba \u0d85\u0da9\u0dd4 \u0dc0\u0dd3\u0dbb \u0db1\u0dd2\u0db8\u0dcf \u0da2\u0dba\u0dba \u0db4\u0dd2\u0dba\u0db1\u0dc0\u0dbb\u0dd2\u0dd0 \u0d85\u0da9\u0dd4 \u0dc0\u0dd3\u0dbb.\n\n\uf0b7 \u0dc4\u0dbb\u0dcf \u0d94 \u0da2\u0dd9 \u0dc3\u0dd2\u0daf\u0dd4\u0dd2\u0db8 \u0db6\u0dd9\u0dcf\u0dd9\u0dcf (\u0dc1\u0dbb\u0dd9\u0dcf\u0dc1\u0dc0\u0dbb\u0dd2\u0ddc\u0da7\u0dca\n\n124) \u0dc1\u0db1 \u0dc0\u0dbb\u0dd2\u0dba \u0dc3\u0dd2\u0da7 \u0da2\u0dcf\u0dd2\u0db1\u0dcf \u0dc3\u0dd2\u0daf\u0dd4\u0dd2\u0db8\u0db6\u0dd9 \u0db4\u0dda\u0dba\u0dd2\u0db1 \u0da7 \u0db8\u0db1\u0db6\u0db1\u0dca\u0dad\u0dba \u0dcf \u0d8a\u0da7 \u0d85\u0dc0\u0dbb\u0dd2 \u0dba \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab (Commissioning tests) \u0dcf \u0dd2\u0db1\u0db1\u0dca\u0dad \u0db4\u0dd0\u0dc0\u0dbb\u0dd2\u0dad\u0dd3\u0dbb.\n\n\uf0b7 \u0dc0\u0dbb\u0dd2\u0dbb\u0dd9 \u0dbb\u0dad \u0db8\u0dc3\u0dd2 \u0dcf \u0dba \u0dd9 \u0dd6\u0dca\u0dbd \u0db6\u0dd9 \u0db4\u0dda\u0dba\u0dd2\u0db1\n\n\u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dd2\u0dca\u0dbd\u0dba\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0dbb \u0dc1\u0dbb\u0db1\u0dca\u0dad\u0dbb \u0db6\u0dd2\u0db1 \u0dbb\u0dad \u0db8\u0dc3\u0dd2 \u0dcf \u0dba \u0dd9 \u0dd6\u0dca\u0dbd \u0db4\u0dda\u0dba\u0dd2\u0db1 \u0dc3\u0dd4\u0dc5\u0daf \u0db6\u0dd9\u0dcf\u0dd9\u0dcf \u0dc0\u0dbb\u0dd2\u0dd0\u0db1\u0dd2 \u0dd4 \u0dba\u0dca\u0dbd\u0da2\u0dba\u0db1\u0dd3 \u0db6\u0dd9\u0dcf\u0dd9\u0dcf \u0dc3\u0dd2 \u0dcf\u0dd9 \u0db4\u0dca\u200d\u0dbb\u0dbb\u0dcf\u0dab \u0d9a\u0dca \u0db4\u0dda\u0dba\u0dd2\u0db1 \u0da7 \u0db8\u0db1\u0db6\u0db1\u0dca\u0dad\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0dbb\u0da7 \u0db8\u0dd0\u0dd9\u0dc3\u0dd4\u0db1 \u0dcf \u0dd2\u0db1\u0db6\u0dd3\u0dbb.\n\n\u0dc3\u0dd2 \u0db1 \u0d85\u0da9\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dbb \u0db8\u0db3\u0dbb\u0dcf \u0db4\u0dbb\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf \u0dbb\u0dcf\u0dca\u0dbd\u0dd9 \u0dc1\u0dd9\u0dba \u0d87\u0dad:\n\n\uf0b7 \u0dc3\u0dd2 \u0dcf\u0dd9 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dc3\u0dba\u0dba \u0dcf\u0dc1 \u0ddd\u0da2\u0dba \u0db1\u0dca\u0dad \u0db8\u0db3\u0dbb\u0dcf \u0dc3\u0dd2\u0dc1 \u0dda\u0dc2\n\n\u0dab \u0db8\u0dd6\u0dd9\u0dba\u0dcf \u0dab \u0d9a\u0dca\u200d\u0dbb\u0dbb\u0dc1 \u0d9a\u0dca \u0dbb \u0dbb\u0dcf \u0d85 \u0db8\u0dd4 \u0dbd\u0dca \u0db8\u0db4 \u0dcf \u0dd9\u0dd0\u0db1\u0dd3\