    "chunk_text": "\u0d85\u0db4\u0dd2 \u0db1\u0db1\u0dc0\u0dad \u0dc0\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0dc1\u0dca \u0db8\u0dcf\u0dc3\u0dc1\u0db1 11\u0dc1\u0dc0\u0dd2\u0dbd \u0db1\u0dcf \u0d8b\u0dc1\u0dc1 10.00\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dca, \u0d85\u0dc1 \u0dc0 \u0d9c\u0dbb\u0dd4 \u0da7\u0dd2\u0dbb\u0dcf\u0dca\u0da7 \u0d85\u0db0\u0dc3\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dca, \u0db8\u0db8\u0dad\u0dca, \u0dc1\u0db8\u0ddd\u0da7\u0dbb\u0dca \u0dbb\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0dc1\u0db1\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc1\u0dca \u0dca\u0da7\u0dad\u0dd4\u0dc1\u0d9a \u0dc1\u0d9a\u0dca\u0db8\u0dc3\u0dcf\u0dd2\u0db1\u0dc3\u0dca\u0dad\u0dd4\u0db8\u0dcf \u0dd4\u0dad\u0dd4 \u0da2 \u0d85\u0dc1\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dd2\u0db1\u0dd4\u0dc0\u0dad\u0dca \u0dc4\u0db8\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0dc0, \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0dd2\u0dbb\u0dc2 \u0db7\u0dcf\u0dbb \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dca, \u0dc1\u0db4\u0dca\u0dbd\u0dd3\u0dd2\u0daf \u0db7\u0dcf\u0dbb \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dca \u0dc3\u0db8\u0d87 \u0d91\u0d9a\u0dad\u0dd4 \u0dc1\u0dc0\u0db0\u0dcf \u0d92\u0d9a\u0dcf\u0db6\u0dc1\u0dcf \u0d9a\u0db1\u0db6\u0dd2\u0db1\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0d9a\u0dca \u0d89\u0daf\u0dd2\u0dd2\u0db1\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0dca\u0da7\u0db1 \u0db6\u0db0\u0dcf\u0dc1\u0db4\u0dca\u0dc1\u0dbb\u0dca\u0dad\u0dca\u0dad\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0dbd\u0dcf\u0db0\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0dca\u0da7\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dbd, \u0dc0\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0dd2\u0dbd\u0dc1 \u0ddd\u0da2\u0db1 \u0d9a\u0dbb\u0db1 \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dad\u0d9c\u0db0 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dc1\u0db1\u0dad\u0dca \u0dc1\u0dca \u0db6\u0db1\u0dca\u0dd2\u0daf\u0d9a\u0dc0\u0dbd \u0db4\u0daf\u0dd2\u0db1, \u0d92\u0dc0\u0dcf\u0da7 \u0d86 \u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dad\u0dbb\u0dd4\u0dab \u0db1\u0dbb\u0dd4\u0dc0\u0dca\u0da7 \u0d89\u0dca\u0da7\u0db1\u0dc0\u0dcf. \u0d92 \u0d85 \u0db0\u0dad\u0dc3\u0dca\u0dad\u0dd2\u0db1\u0dca \u0d92\u0dc0\u0dcf \u0dd2\u0dba \u0dcf\u0db4\u0daf\u0dd2\u0dcf\u0da0\u0dd2 \u0d9a\u0dbb\u0dca\u0da7\u0db1. \u0d85\u0db4\u0dd2 \u0dc1\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dca \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dd3 \u0db4 \u0d9a\u0dca \u0d9a\u0dd2\u0d9a\u0dc0\u0dcf.\n\n\u0d92 \u0db6\u0db1\u0dca\u0dd2\u0daf\u0d9a\u0db0 \u0d9a \u0db8\u0dd2\u0db0 \u0dbb\u0dd4\u0db4\u0dd2 \u0dc0\u0dbd \u0db0\u0d9a\u0dca\u0dc2 50\u0dca\u0da7 \u0db4\u0da7\u0dca\u0da7 \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0db0\u0d9a\u0dca\u0dc2 200 \u0db1\u0d9a\u0dca\u0dc0\u0dcf \u0db1\u0dc0\u0dcf. \u0d92 \u0db6\u0db1\u0dca\u0dd2\u0daf\u0d9a\u0db0 \u0d9a\u0dca \u0dc1\u0dda\u0dca\u0da7\u0dc1\u0dca\u0da7 \u0dc1\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0d92 \u0dc4\u0db1\u0d9a\u0dd2 \u0dcf\u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db1\u0dbb\u0dd4\u0dc1\u0dc0\u0d9a\u0dca. \u0d91\u0dc1\u0dc4\u0db8 \u0dc1\u0d9c\u0dca\u0da7\u0dc0\u0dca\u0da7\u0db1 \u0dc4\u0db1\u0d9a\u0dd2 \u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db4\u0dc0\u0dd4\u0db0\u0d9a \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dca \u0dad\u0db8\u0db1\u0dca \u0d92 \u0db6\u0db1\u0dca\u0dd2\u0daf\u0d9a\u0db0 \u0d9a\u0dca \u0dc1\u0d9c\u0dca\u0da7\u0dc0\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0dca\u0da7\u0dc1\u0dca\u0da7. \u0d92 \u0db6\u0db1\u0dca\u0dd2\u0daf\u0d9a\u0dc0\u0dbd \u0dc1\u0d9c\u0db1\u0dcf\u0dc0\u0dad\u0dca \u0d85\u0dc1 \u0dc0 \u0dad\u0dbb\u0dd4\u0dab \u0db1\u0dbb\u0dd4\u0dc0\u0dca\u0da7\u0da7 \u0d92\u0dc0\u0dcf \u0db4\u0daf\u0dd2\u0dca\u0da7\u0db1 \u0dd2\u0dba \u0dcf \u0db4\u0daf\u0dd2\u0dcf\u0da0\u0dd2 \u0dc1\u0db1\u0dca\u0da7\u0dc1\u0dca\u0da7 \u0db1\u0db1\u0dc4\u0db1. \u0d85\u0dc1 \u0dc0 \u0dbb\u0dc1\u0da7\u0dca \u0dad\u0dbb\u0dd4\u0dab \u0dca\u0da7\u0da7 \u0dc1\u0d9c\u0db1\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1 TV \u0d91\u0dc1\u0d9a\u0dca\u0da7 sports channels \u0db6\u0db0\u0dca\u0da7\u0db1 \u0dc4\u0db1\u0d9a\u0dd2 \u0dcf\u0dc0\n\n\u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dc1\u0d9c\u0dca\u0dc0\u0dbd\u0db0\u0dca\u0da7 \u0d92\u0dc0\u0dcf \u0db6\u0db0\u0db1\u0dc0\u0dcf. \u0d85\u0dc1 \u0dc0 \u0d85\u0dc3\u0dc0\u0dbd\u0dc0\u0db1\u0dd2\u0daf \u0db8\u0dcf\u0db0\u0daf\u0dd2\u0dc0\u0db1\u0dca\u0db1 \u0daf\u0dd6\u0db4\u0dad\u0d9a\u0dca. \u0d91\u0dd2\u0dc0 \u0dc1\u0db4\u0dca \u0d89\u0dba\u0d9a\u0dca, \u0dc1\u0db4\u0dca \u0db4\u0dcf\u0dbb\u0dc0\u0dc0\u0dbd \u0dad\u0dd2\u0dc1\u0db6\u0dca\u0da7\u0dc1\u0dca\u0da7. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d92 \u0db6\u0db1\u0dca\u0dd2\u0daf\u0d9a\u0dc0\u0dbd \u0db8\u0dcf\u0db0\u0daf\u0dd2\u0dc0\u0db1\u0dca\u0dc1\u0dca\u0da7\u0dad\u0dca \u0dd2\u0dba \u0dcf \u0db4\u0daf\u0dd2\u0dcf\u0da0\u0dd2 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\n\n\u0d85\u0dc1 \u0dc0 \u0d9c\u0dbb\u0dd4 \u0da7\u0dd2\u0dbb\u0dcf\u0dca\u0da7 \u0d85\u0db0\u0dc3\u0dca \u0dd4\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf, \u0db1\u0dc0 \u0dc1\u0db4\u0dca\u0dd2\u0dba\u0dc3\u0dca\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dd4\u0dad\u0dd4 \u0da2 \u0dc3\u0db8\u0dc3\u0dca\u0dad \u0da7 \u0db8\u0db8 \u0dc3\u0dca\u0dad\u0dd4\u0dad\u0dd2\u0dc0\u0dca\u0da7\u0dad \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0dc1\u0db4\u0dca\u0dbd\u0dd3\u0dd2\u0daf\u0dc1\u0db1 \u0d91\u0d9a \u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dd2\u0db1\u0dc1 \u0d9a\u0dca \u0dc1\u0dca \u0d9c\u0db1\u0db1 \u0dad\u0dbb\u0dca\u0d9a \u0d9a\u0dca \u0dc1\u0d9c\u0db1\u0dcf\u0dc0\u0dcf. \u0d92\u0dad\u0dca \u0d91\u0d9a \u0dc1\u0db4\u0dca\u0dd2\u0dba\u0dc3\u0dca \u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dd2\u0db1\u0dc1 \u0d9a\u0dd4\u0da7 -\u0dbb\u0dcf\u0dc0\u0dcf\u0dc4\u0db1 \u0db7\u0dcf\u0dbb\u0dc0 \u0d89\u0dca\u0da7\u0db1 \u0dd2\u0dbd\u0dc1 \u0ddd\u0da2\u0dba \u0dc1\u0db4\u0dca\u0dd2\u0dba\u0dc3\u0dca\u0db4\u0dad\u0dd2\u0dc0\u0dbb \u0dcf\u0da7- \u0dc1\u0dca \u0d9a \u0dc1 \u0dc0\u0dca\u0da7\u0dc1\u0dca\u0da7 \"\u0db1 \u0dcf\u0da7 \u0d85\u0db3\u0dd4\u0dc1\u0d9a\u0dca\u0dc5\" \u0dc0\u0dcf \u0dc1\u0dda. \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0dad\u0dcf\u0dbb\u0dd4\u0dab\u0dba\u0dc1\u0db1 \u0d89\u0db3\u0db0\u0dcf \u0db1\u0db1\u0dc4\u0db1; \u0db6\u0db1\u0dca\u0dd2\u0daf\u0d9a\u0dc0\u0dbd \u0db4\u0db1\u0db1\u0db0\u0dcf \u0db1\u0db1\u0dc4\u0db1. \u0d92\u0d9a\u0db1\u0dca \u0dc1\u0dca \u0dc1\u0dc0\u0db0\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0dca\u0da7\u0dc1\u0dca\u0da7. \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0db1\u0db1\u0d9a\u0db0\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dd2\u0dbb\u0db0\u0dd2 \u0dc1\u0dc0\u0db1\u0db1\u0dca. \u0dc1\u0db8\u0dca\u0d9a\u0d9a\u0dca\u0db1 \u0dc1\u0dca \u0d9a\u0da7 \u0dc1\u0dc4\u0dda\u0dad\u0dd4\u0dc0"
  },
