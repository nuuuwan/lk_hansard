    "chunk_text": "\u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dc5\u0dcf\u0dc1\u0dad\u0dca\u0da7 \u0d86\u0dd4 \u0dd4\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dc1 \u0d9a\u0dca \u0dd2\u0dbd\u0dc3\u0dcf, \u0d85\u0db1 \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0dca\u0da7 \u0da2\u0dcf\u0dad\u0dd2\u0dc0\u0dcf \u0d87 \u0dd2\u0dbb\u0db0\u0dd2 \u0da7 \u0d92 \u0db0\u0dd3\u0dc0\u0dbb \u0dca\u0da7\u0da7 \u0db0\u0dd3\u0dc0\u0dbb \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0dca\u0da7\u0dad \u0da7 \u0d91\u0dca\u0da7\u0db1 \u0dc1\u0db1\u0dca \u0d87 \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dc1\u0d9c\u0db1 \u0dd2\u0daf\u0da7\u0dd2\u0db1\u0dc0\u0dcf. \u0d92\u0d9a \u0dd2\u0dbb \u0dcf\u0db0 \u0dc0\u0db1\u0dbb\u0dd0\u0dc1\u0db1\u0d9a\u0dca \u0db6\u0dc0 \u0dc0\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0db8\u0dad\u0d9a \u0dad\u0db6\u0dcf \u0d9c\u0dca\u0da7\u0db1. \u0db8\u0dd3\u0da7 \u0dc1\u0db4\u0dbb \u0d92 \u0d85 \u0dc1\u0dc4\u0dca\u0db3 \u0dc3\u0dcf\u0dd2\u0dc0\u0dd2\u0db1 \u0dcf\u0dc1\u0dc0\u0dca\u0da7, \u0d91\u0d9a\u0da7 \u0d91\u0d9a\u0dad\u0dd4 \u0dc1\u0dc0\u0db0\u0dcf \u0dad\u0db8\u0db1\u0dca \u0dc0\u0db1\u0dba \u0d9a\u0dc1\u0dc5\u0dda. \u0d92\u0d9a\u0da7 \u0d85\u0db1 \u0dad\u0dd2\u0dad\u0d9a\u0dca \u0dad\u0dd2 \u0db0\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dd2\u0dbb\u0dad\u0dbb\u0d9a\u0dca \u0dc1\u0db1\u0dca\u0dc1\u0dc0\u0db1\u0dca, \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dc1 \u0dc1\u0db1 \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0dca\u0da7\u0dad \u0d9a\u0dbb\u0db1 \u0db0\u0dd3\u0dc0\u0dbb \u0dca\u0da7 \u0d85\u0dc1 \u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dc1 \u0dc1\u0db1 \u0d9a\u0dbb\u0db1 \u0dc3\u0db8\u0dc4\u0dbb \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0dca\u0da7\u0dad \u0dd2\u0dc0\u0dad\u0dcf\u0db8\u0dad\u0dcf\u0db8 \u0db1\u0dad\u0dbb \u0d9a\u0dbb\u0db0\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dd2\u0db1\u0dd4\u0dc0\u0dad\u0dca \u0dc3\u0dca \u0db6\u0dca\u0da7\u0dcf \u0d9a\u0dbb\u0dc1\u0d9c\u0db1 \u0d92\u0dc0\u0dcf \u0dad\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db0\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dd2\u0dbd\u0dc3\u0dcf \u0db8\u0dad\u0d9a \u0dad\u0db6\u0dcf \u0d9c\u0dca\u0da7\u0db1, \u0d92 \u0dd2\u0daf \u0dbd\u0dd4 \u0dc1\u0dc1\u0dc0\u0dc0\u0dbd \u0dc1\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0db1\u0db1\u0dad\u0dd2 \u0dc1\u0dc0\u0dca\u0da7\u0db1 \u0db1\u0db1\u0dad \u0db6\u0dc0. \u0dc1\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0da2\u0dcf\u0dad\u0dd3\u0dca\u0da7 \u0d85\u0dad\u0dbb, \u0d86\u0d9c\u0dca \u0d85\u0dad\u0dbb \u0dc3\u0dcf\u0dd2\u0dc0\u0dd2\u0db1 \u0dcf\u0dc0 \u0dd4\u0dad\u0dd2 \u0dc1\u0dc0\u0dca\u0da7\u0db1 \u0db1\u0db1\u0dad. \u0dd2\u0daf \u0dbd\u0dd4\u0dc1\u0db1\u0db1\u0dcf \u0d91\u0d9a\u0da7 \u0d91\u0d9a\u0dad\u0dd4 \u0dc1\u0dc0\u0dca\u0da7\u0db1 \u0db1\u0db1\u0dad. \u0d92 \u0dd2\u0dbb\u0dad\u0dbb\u0d9a\u0dca \u0dc1\u0db1\u0dca\u0dc1\u0dc0\u0db1\u0dca. \u0dbb\u0dc1\u0da7\u0dca \u0d85\u0dc1\u0db1\u0dba\u0ddd\u0db1\u0dba \u0dd2\u0dc0\u0dad\u0dc0\u0dad\u0dca\u0d9a\u0dca \u0db4\u0dc0\u0dcf \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dca\u0da7\u0db1 \u0db1\u0db1\u0dad. \u0d92 \u0d86\u0d9a\u0dcf\u0dbb\u0dc1 \u0dca\u0da7 \u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0d9a\u0dbb\u0dca\u0da7\u0dc1\u0dca\u0da7 \u0db1\u0db1\u0dad\u0dd4\u0dc0 \u0dbb\u0da7\u0d9a\u0dca \u0d89\u0dc3\u0dca\u0dc3\u0dbb\u0dc4\u0da7 \u0dc1\u0d9c\u0db1 \u0dca\u0da7\u0db1 \u0db6\u0db1\u0dc4\u0db1. \u0d89\u0dc3\u0dca\u0dc1\u0dc3\u0dc0\u0dbd\u0db0\u0dcf\u0db8 \u0dad\u0db8\u0dd4\u0dca\u0da7\u0db1\u0dcf\u0dca\u0da7\u0dc1\u0dc3\u0dda\u0db0\u0dcf \u0d9a\u0dbb\u0dd4 \u0dc0\u0db1\u0dbb\u0dd0\u0daf\u0dd2 \u0dc4\u0dd2\u0db1 \u0da7 \u0dc4\u0db3\u0dd4\u0db1\u0dcf\u0dc1\u0d9c\u0db1, \u0d92 \u0d9a\u0dbb\u0dd4 \u0dc0\u0db1\u0dbb\u0dd0\u0daf\u0dd2 \u0dd2\u0dbd\u0dc0\u0db1\u0dbb\u0dd0\u0daf\u0dd2 \u0d9a\u0dbb\u0dca\u0da7\u0db1 \u0d85\u0dc0 \u0dba \u0d9a\u0dbb\u0db1 \u0dc3\u0db1\u0db0\u0db1\u0dc3\u0dca\u0db8 \u0dbb\u0da7\u0da7 \u0dc1\u0db4\u0dca\u0da7\u0dc0\u0db0\u0dcf \u0d89\u0dca\u0da7\u0db1. \u0d8a\u0da7 \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dda \u0dad\u0db8\u0db1\u0dca, \u0dbb\u0da7 \u0d89\u0dc3\u0dca\u0dc3\u0dbb\u0dc4\u0da7 \u0dc1\u0d9c\u0dd2\u0dbd \u0dca\u0da7\u0db1 \u0dd4 \u0da2\u0dc0\u0dca\u0da7 \u0dc1\u0dc0\u0dca\u0da7\u0dc1\u0dca\u0da7, \u0dbb\u0dc1\u0da7\u0dca \u0d85\u0db1\u0dcf\u0d9c\u0dad \u0dc3\u0db1\u0db0\u0dd4\u0daf\u0dca \u0dc4\u0db1\u0dca\u0da7\u0db1 \u0dd4 \u0da2\u0dc0\u0dca\u0da7 \u0dc1\u0dc0\u0dca\u0da7\u0dc1\u0dca\u0da7 \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a \u0dd2\u0dbb\u0dc1 \u0dda\u0dc2\u0dc1 \u0dca\u0da7\u0db8 \u0db8\u0dad\u0d9a \u0dad\u0db6\u0dcf \u0d9c\u0dca\u0da7\u0db1. \u0db8\u0da7 \u0dc1\u0dca \u0d85\u0dc0\u0dc3\u0dca\u0dcf\u0dcf\u0dc0 \u0db0\u0db6\u0dcf \u0dd4 \u0dca\u0da7\u0db1\u0dcf\u0da7 \u0dc0\u0db6\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0dc1\u0db6\u0dca\u0dc1\u0dc4\u0dca\u0db8 \u0dc3\u0dca\u0dad\u0dd4\u0dad\u0dd2\u0db1\u0dca, \u0d9c\u0dbb\u0dd4 \u0dd2\u0dbd\u0dc1 \u0ddd\u0da2\u0dba \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dbd.\n\n[\u0d85.\u0db7\u0dcf. 12.54]"
  },
