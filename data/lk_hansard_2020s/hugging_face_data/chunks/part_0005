    "chunk_text": "TikTok \u0d86 \u0dad\u0db1 algorithm \u0d91\u0dd9 \u0dc11\u0db1\u0dc3\u0dda \u0dd9\u0dba\u0daf\u0dd2 \u0d92 \u0daf\u0dc0 1\u0db1\u0dca\u0dad\u0da7 \u0d9c\u0dab\u0dd2\u0dad 1\u0dd2\u0dc1\u0db8\u0db8 \u0dc0\u0dd2\u0db7\u0dd2\u0d9c \u0db4\u0dd2\u0dc3\u0dda \u0dc11\u0db1 \u0d86\u0dd9\u0dd2\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db31 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0d8b\u0db1\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dd9\u0dba1\u0db1 \u0dc1\u0dda1\u0dbd\u0dca \u0dc1\u0db4\u0db1\u0dca\u0dad1\u0db11\u0dd2 \u0dd2\u0dbb \u0db1 \u0d91\u0dd9. \u0d85\u0daf \u0dc11\u0db1\u0dc1\u0dd9\u0dd2\u0da7 \u0d85\u0db4\u0dd2 \u0d85\u0dc0\u0dd21\u0dd2\u0daf\u0dc1 \u0db1\u0dca\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1 \u0dc1\u0db81\u0dd0\u0db1\u0dd2 Online Safety Bill \u0d91\u0dd9\u0d9a\u0dca\u0dc0 \u0dba\u0da7\u0da7 \u0d851 \u0dba\u0dba\u0dd2 \u0dd2\u0dbb \u0db1 \u0d91\u0dd9.\n\n\u0dd6\u0dbd\u0daf\u0dd2\u0dc3\u0db1\u0dd2\u0dd6\u0db4\u0daa \u0d9c\u0dc0 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db8\u0db1\u0dd2 \u0dc1\u0db8\u0dca \u0dc0\u0dd2 \u0dda1\u0dd2\u0dc3 \u0db7\u0d82\u0d9c \u0dc1 \u0ddd\u0da2\u0dca\u200d\u0db1\u0dd21 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc1 \u0db1\u0dca\u0dad \u0dd6 \u0dc0\u0dd21\u0dd2\u0daf \u0db8\u0dca\u0dd2\u0dbb\u0dc3\u0dd2 \u0dc0\u0dd2\u0db0\u0dd2 \u0dd9\u0da7 \u0dc1\u0dda \u0db4\u0dd2\u0daf\u0db1 1 \u0dc1 \u0db1\u0dca\u0dad 1\u0dd2\u0dc3\u0dd2 \u0d9a\u0dca\u0dc0 \u0d9c\u0db1\u0dca\u0dad\u0db1 \u0dc1\u0d9c\u0db1\u0dd2\u0dad\u0dca \u0dc0\u0dd21\u0dd2\u0daf \u0d9a\u0dca\u0dc0 \u0db1\u0db8\u0dca \u0db8\u0db8 \u0d92 \u0d9c\u0dd0\u0db1 \u0dd9\u0db1\u0d9c\u0dd2\u0da7\u0dd4 \u0dc11\u0db11\u0dd2. \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8 \u0daf1\u0dc3\u0dda \u0dd4\u0db1\u0d9a\u0dca\u0dc0 1\u0dd2\u0dc1\u0db8 \u0dd9\u0dd2\u0daf \u0d9a\u0dca\u0dc0 \u0dc1\u0db8\u0db8 \u0dc0\u0dd2 \u0dda1\u0dd2\u0dc3 \u0db7\u0d82\u0d9c \u0dc1 \u0ddd\u0da2\u0dca\u200d\u0db1\u0dd21 \u0d9c\u0dd0\u0db1 \u0dc3\u0dd2\u0dd9