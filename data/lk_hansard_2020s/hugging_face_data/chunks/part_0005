    "chunk_text": "\u0daf\u0dac\u0dd41\u0db8\u0da7 \u0dc1\u0daf\u0db1 \u0daf\u0dac\u0dd41\u0db8 1\u0dd2\u0dc1\u0db8 \u0dc1\u0daf\u0d9c\u0dd4\u0da7 \u0d9a\u0dca\u0dc0 \u0dc1\u0daf\u0db1\u0dca\u0dad\u0db1 \u0dd2\u0dbb \u0daf\u0dd2. \u0dc1\u0dbb\u0dda\u0dc2\u0dca\u0da8\u0dda\u0db0\u0dd2\u0db0\u0dd2\u0dd9\u0dba\u0da7 \u0dd2\u0dbb \u0daf\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dd2 \u0d92\u0dd9 \u0d91\u0dc1\u0dc4\u0dba\u0db8 \u0dd9\u0dba\u0db1\u0dca\u0dad\u0db1 \u0db6\u0dd0\u0dc4\u0dba\u0dd0 \u0dd2\u0dbb \u0daf\u0dd2. \u0d91\u0dd9 1\u0dd2\u0dd9\u0dba \u0d9a\u0dca\u0dc0 \u0d891\u0dad\u0dca \u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0dc1\u0db8\u0dca 1\u0d9c\u0db1\u0dca\u0dad\u0dad\u0dd2 \u0dd4\u0dc1\u0db1\u0dca\u0dad \u0dc3\u0dd2\u0dda\u0db0 \u0dc11\u0daf\u0dd2 \u0db1\u0dd0\u0dc4\u0dba\u0dd0. \u0dc4\u0dba\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0db4\u0db1\u0dad\u0dca \u0dc1\u0dd9\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dd9\u0dba\u0daf\u0dd2 \u0d8a\u0dc5\u0d9f \u0dc3\u0dad\u0dd2\u0dc1\u0dda \u0dd9\u0dd0\u0db6\u0dd2\u0db1\u0da7\u0dca \u0db8\u0dab\u0dca\u0da9\u0daf\u0dc1\u0dda \u0daf\u0dd3 \u0dc1\u0db8\u0dca \u0dc3\u0d82\u0dc1 \u0ddd\u0db0\u0db1 \u0d87\u0dd4\u0dc5\u0dd41 \u0d85\u0dc1\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0dc3\u0d82\u0dc1 \u0ddd\u0db0\u0db1 \u0dd9\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d85\u0db4\u0dd2 \u0d85\u0db1\u0dd4\u0db8\u0dad \u0dd9\u0dba\u0daf\u0dd2 \u0db8\u0db8 \u0daf\u0db1\u0dca\u0dad\u0db1\u0dd2 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0daf\u0dd0\u0db1\u0dca\u0dad \u0d91 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0dd9\u0dba\u0daf\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dd2.\n\n\u0d8a\u0dc5\u0d9f\u0da7 \u0db111\u0db1 \u0dd9\u0dd2\u0dba\u0da7\u0dd21 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0db4\u0db1\u0dad\u0dca \u0dc1\u0dd9\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dc1\u0dad\u0dca ]3 1\u0db1 1\u0d9c\u0db1\u0dca\u0dad\u0dad\u0dd2 \u0d9c\u0dd0\u0db1\u0dba\u0dd2. \u0d92\u0dd9 \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dd9\u0dc5 \u0db4\u0db1\u0dc1\u0dad\u0dca 23 1\u0db1 1\u0d9c\u0db1\u0dca\u0dad\u0dad\u0dd2 \u0da7\u0dc1\u0dad\u0dca \u0dc3\u0db3\u0dc4\u0dba\u0db1\u0dca\u0dad \u0dd9\u0dba \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dd2. \u0d92\u0dd9 \u0dc3\u0d82\u0dc1 \u0ddd\u0db0\u0db1 \u0dd9\u0dba\u0daf\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dd2. \u0d92 \u0db1\u0dd2\u0dc3\u0dd2 \u0d9c\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0dda\u0db8\u0db1\u0dca\u0dad \u0dd2\u0dbb\u0dbb\u0dd2\u0d87\u0dbd\u0dca\u0daf \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db8\u0db1\u0dd2 \u0d94\u0db6\u0dd4\u0db8\u0db1\u0dca\u0dad\u0daf\u0dd2 \u0db1\u0dd2\u0dc4\u0dba\u0dad\u0db8\u0dd2\u0db1\u0dd31 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0dad\u0db1 \u0dc1\u0db8\u0dca \u0dc0\u0dd2 \u0dda1\u0dd2\u0dc3 \u0db7\u0d82\u0d9c \u0dc1 \u0ddd\u0da2\u0dca\u200d\u0db1\u0dd21 \u0dc4\u0dba\u0daf\u0daf\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0db4\u0db1\u0dad\u0dca \u0dc1\u0dd9\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dba\u0dd2 \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dd9\u0dba\u0dad\u0dca \u0db4\u0db1\u0dad\u0dba\u0dd2 \u0db1 \u0dc1\u0daf\u0dd9\u0db8 \u0dd2\u0dc4\u0dba\u0dd2 \u0db6\u0daf\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0db1\u0dd0\u0dad\u0dd21 \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dd9\u0dba\u0dad\u0dca \u0db4\u0db1\u0dc1\u0dad\u0dca 231\u0db1 1\u0d9c\u0db1\u0dca\u0dad\u0dad\u0dd2 \u0da7 \u0db4\u0db1\u0dad\u0dca \u0dc1\u0dd9\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dc1\u0dad\u0dca 231\u0d9c\u0db1\u0dca\u0dad\u0dad\u0dd2 \u0db6\u0daf\u0daf\u0dd2 \u0dd2\u0dbb \u0db1 \u0d91\u0dd9. \u0dc4\u0dba\u0dbb\u0dd2 \u0dc1\u0db1\u0dca\u0dad\u0daf \u0d9c\u0dc0 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dca\u200d\u0dba \u0dd9\u0dd2\u0dba\u0dd9 \u0dc3\u0db7\u0dd2\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0db1\u0dd2? \u0d91\u0dad\u0dc1\u0dd9\u0dd2\u0da7 \u0dc1\u0db8\u0dca\u0dd9 \u0dc1\u0dad\u0dca\u0dc1\u0dba\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0db1\u0dd0\u0dc4\u0dba\u0dd0. \u0dc1\u0db8\u0dd2\u0dd9\u0daf 1\u0d9c\u0db1\u0dca\u0dad\u0dad\u0dd21\u0daf \u0d85\u0d82\u0dd9 \u0dc11\u0db1\u0dc3\u0dda \u0dc11\u0daf\u0dd2. \u0dc3\u0d82\u0dc1 \u0ddd\u0db0\u0db1 \u0dc1\u0d9c\u0db1\u0dd0\u0dbd\u0dca\u0daf\u0dd2 \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dd9\u0dba\u0db1\u0dc1\u0dd9\u0dd2\u0da7 \u0dc4\u0dba\u0dd0\u0db8 \u0db4\u0db1\u0dad\u0dd9\u0db8 \u0d91\u0dc1\u0dc4\u0dba\u0db8 \u0dc11\u0db11\u0dd2. \u0daf\u0dd0\u0db1\u0dca\u0dad \u0dc1\u0db8\u0dca \u0dc1\u0daf\u0ddd\u0daf\u0db1\u0dd2 \u0db1\u0dca\u0dad 1\u0d9c\u0db1\u0dca\u0dad\u0dad\u0dd2 9\u0dd9 \u0d85\u0dd41\u0d9a\u0dca\u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dd2 \u0d85\u0dba \u0daf\u0dac\u0dd41\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0db01 \u0daf\u0dd3\u0dad\u0dca \u0db1\u0dd2\u0dbb\u0dca\u0dc1\u0dda . \u0d92 1\u0d9c\u0db1\u0dca\u0dad\u0dad\u0dd2 \u0dc4\u0dba\u0dad\u0dba\u0da7\u0db8 \u0dc3\u0d82\u0dc1 \u0ddd\u0db0\u0db1 \u0daf\u0dd0\u0db1\u0dca\u0dad \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dd9\u0dba\u0daf\u0dd2 \u0dd9\u0dd0\u0db6\u0dd2\u0db1\u0da7\u0dca \u0db8\u0dab\u0dca\u0da9\u0daf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0d92\u0dd9 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0dd9\u0dba\u0db1\u0dca\u0dad\u0db1 1\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dd2."
