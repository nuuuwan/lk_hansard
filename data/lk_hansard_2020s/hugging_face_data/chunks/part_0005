95\u0bcd\u0b95\u0bb5\u0bbf\u0baf\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1\u0bbe\u0bbf\u0b95\u0bae\u0b95\u0bb3\u0bcd\n\n\u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bbf\u0ba9\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0ba9\u0bae\u0bcd \u0ba4\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbf\u0bb2\u0bcd \"\u0bb8\u0ba4\u0bbf \u0b85\u0b95\n\n\u0b85\u0bb0\u0bc1\u0ba3\" \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0b95\u0b95\u0b95\u0bcd\u0b95\u0bc1 \u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bc1 \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bbf\u0ba9\u0bcd\n\n\u0b9a\u0baa\u0b9a\u0bcd\u0b9a\u0bbe\u0bb3\u0bb0\u0bcd \u0b8e\u0bb4\u0bc1\u0ba4\u0bbf\u0baf \u0b95\u0b9f\u0bbf\u0ba4\u0bae\u0bcd PRIVILEGE: DEFENCE MINISTRY SPOKESMAN'S LETTER TO\n\n\"SATHI AGA ARUNA\" NEWSPAPER ON DECISION OF\n\nCOMMITTEE ON ETHICS AND PRIVILEGES \u0d9c\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0dbb\u0db8\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0baa\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Speaker) \u0db4\u0dcf\u0d9a\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0db1\u0dca\u0dd3 \u0d9c\u0dbb\u0dd4 \u0da0\u0db1\u0dca\u0daf\u0dd2\u0db8 \u0dc0\u0dd3\u0dbb\u0d9a\u0dca\u0dc2\u0dc1\u0d9a\u0dcf\u0da9\u0dd2 \u0db8\u0dc4\u0dad\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca 2020 \u0db8\u0dcf\u0d9a\u0dad\u0dd4 06 \u0daf\u0dd2\u0db1 \u0dc0\u0dbb\u0db4\u0dca\u200d\u0dbb \u0dcf\u0daf \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1 \u0dba\u0da7\u0dc1\u0dad\u0dca \u0db4\u0dcf\u0d9a\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc1 \u0daf\u0dd3 \u0db8\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0daf \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0d86\u0da0\u0dcf\u0dbb \u0db0\u0d9a\u0db8 \u0dc4 \u0dc0\u0dbb\u0db4\u0dca\u200d\u0dbb \u0dcf\u0daf \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0dcf\u0dbb\u0d9a \u0db7\u0dcf\u0dc0\u0da7 \u0dc1\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dd0\u0dc1\u0dda.\n\nX\n\n\u0dc0\u0dbb\u0db4\u0dca\u200d\u0dbb \u0dcf\u0daf \u0dc00\u0dc0\u0db1.0\u0dc0.\u0dc0 \u0dc0\u0db1 \u0dd2\u0db1\u0db1 \u0dc3\u0db4\u0dca\u200d\u0dbb\u0dbd\u0dd2\u0d9b \u0dd2\u0da7\u0dbb\u0dbb\u0dca\u0dc3 \u0dc4\u0dba\n\n\u0dc3\u0dc3\u0dd2\u0db4\u0dca\u200d\u0dbb\u0dbd \u0db1\u0dca \u0dc0\u0dba\u0dbb\u0dca \u0db1\u0dd2\u0dda \u0db1\u0dc3 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dad\u0dca \u0dad\u0dd2\u0da5 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0b9a\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1\u0bbe\u0bbf\u0b95\u0bae: 2024.02.28\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf \"\u0ba4\u0b9f\u0baf\u0bcd\u0bb2\u0bbf \u0bae\u0bbf\u0bb0\u0bb0\u0bcd\" \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \"\u0b9a\u0bbf\u0b9a\u0bb2\u0bbe\u0ba9\u0bcd \u0bb5\u0baf\u0bb0\u0bcd \u0ba8\u0bbf\u0bb5\u0bcd\u0bb8\u0bcd\" \u0ba4\u0b9a\u0baf\u0bcd\u0ba4\u0bbf \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0b95\u0b95\u0bb3\u0bcd\n\nPRIVILEGE: NEWS REPORTS IN \"DAILY MIRROR\" AND\n\n\u201cCEYLON WIRE NEWS\u201d ON 28.02.2024\n\n\u0d9c\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0dbb\u0db8\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0baa\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Speaker) \u0db4\u0dcf\u0d9a\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0db1\u0dca\u0dd3 \u0d9c\u0dbb\u0dd4 \u0da0\u0dd2\u0db1\u0dca\u0dad\u0d9a \u0d85\u0db8\u0dbd\u0dca \u0db8\u0dcf\u0dba\u0dcf\u0daf\u0dd4 \u0db1\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca 2020 \u0db8\u0dcf\u0d9a\u0dad\u0dd4 06 \u0daf\u0dd2\u0db1 \u0dc0\u0dbb\u0db4\u0dca\u200d\u0dbb \u0dcf\u0daf \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1 \u0dba\u0da7\u0dc1\u0dad\u0dca \u0db4\u0dcf\u0d9a\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc1 \u0daf\u0dd3 \u0db8\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0daf \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0d86\u0da0\u0dcf\u0dbb \u0db0\u0d9a\u0