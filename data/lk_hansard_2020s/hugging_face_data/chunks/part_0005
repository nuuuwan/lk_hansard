    "chunk_text": "\u0d85\u0dcf \u0dc1\u0d9c\u0ddc\u0dc0\u0dd3\u0dca \u0da7 \u0dad\u0db8\u0dca \u0dc1\u0d9a \u0dcf\u0dbb\u0dd4\u0dc0\u0dcf\u0dc0 \u0d89\u0dc3\u0dae\u0dc1\u0d9a\u0ddd \u0dc1\u0dbd\u0dca \u0dba\u0dc0\u0dcf \u0d9c\u0dca \u0db1 \u0db6 \u0dd2\u0db4 \u0dc1\u0dc0\u0dbd\u0dca\u200d\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0dcf \u0dc5\u0db8\u0dba\u0dd2 \u0dbd\u0dca\u200d\u0d9a\u0dca\u0dc2 \u0db4\u0dc4\u0dca\u200d\u0d9a\u0dca \u0d89\u0dc3\u0dae\u0dc1\u0d9a\u0ddd\u0dc1\u0dbd\u0dca \u0dba\u0dca \u0dc1\u0dca \u0db1 \u0dc4\u0dca\u200d . \u0d92 \u0dc1\u0d9a\u0ddc\u0dc5\u0db9 \u0db1\u0d9c \u0dc1\u0dda \u0da2\u0dd3\u0dc0\u0dca \u0dc0\u0db1 \u0dc5\u0db8\u0dba\u0dd2 \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dba\u0dd2 \u0d9c\u0db8\u0dca\u0dc0\u0dbd\u0dca\u200d \u0daf\u0dd4\u0dda\u0db4\u0dca \u0dc1\u0d9c\u0ddc\u0dc0\u0dd3\u0dca \u0dc1\u0d9a \u0dc5\u0db8\u0dba\u0dd2. \u0d92 \u0dc5\u0db8\u0dba\u0dd2\u0dca \u0da7 \u0dc3\u0db4\u0dca \u0dd4, \u0dc1\u0dcf\u0d9a \u0d85 \u0dc1\u0d9c\u0db1 \u0dc1\u0dcf\u0dca \u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0d9a\u0dca \u0db1 \u0dc4\u0dca\u200d ; \u0db6\u0dc3\u0dae \u0d9c\u0dcf\u0dc3\u0dae\u0dd4,\u0dc0 \u0dc1\u0dcf\u0dca \u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0d9a\u0dca \u0db1 \u0dc4\u0dca\u200d ; \u0d87\u0daf\u0dcf\u0db8\u0dca \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0d85 \u0dc1\u0d9c\u0db1 \u0dc1\u0dcf\u0dca \u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0d9a\u0dca \u0db1 \u0dc4\u0dca\u200d ; \u0dc1\u0db4\u0ddc\u0dca \u0db4\u0dca \u0da7\u0dd2\u0d9a \u0d85 \u0dc1\u0d9c\u0db1 \u0dc1\u0dcf\u0dca \u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0d9a\u0dca \u0db1 \u0dc4\u0dca\u200d . \u0d92 \u0dc5\u0db8\u0dba\u0dd2 \u0dbd\u0dca\u200d\u0d9a\u0dca\u0dc2 \u0db4\u0dc4\u0dca\u200d\u0db8 \u0d9c\u0db8\u0dca\u0dc0\u0dbd\u0dca\u200d \u0da2\u0dd3\u0dc0\u0dca \u0dc0\u0db1 \u0daf\u0dd4\u0dda\u0db4\u0dca \u0dc1\u0d9c\u0ddc\u0dc0\u0dd3\u0dca \u0dc1\u0d9a \u0dc5\u0db8\u0dba\u0dd2.\n\n\u0dc1\u0db8\u0dca \u0dc1\u0da7\u0dca \u0dc1\u0db8\u0ddd\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0dba\u0dca \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dc1\u0dcf\u0dc1\u0db1\u0d9a\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0dc4\u0dd4 \u0dc1\u0dc0\u0dbd\u0dca\u200d\u0dcf \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad \u0db8\u0dd2\u0dbd\u0dca\u200d\u0d9a\u0da7 \u0d9c\u0dca \u0dc1\u0dca \u0db1 \u0dad\u0dd2\u0dc0 \u0d85\u0da9\u0dd4 \u0db8\u0dd2\u0dbd\u0dca\u200d\u0da7 \u0dc0\u0dd3 \u0d9c\u0dca \u0db1\u0dc0\u0dcf. \u0d92\u0dc1\u0d9a\u0dca \u0dd2\u0dbb\u0dba\u0dba\u0da7 75\u0d9a\u0dca \u0dad\u0db8\u0dd4\u0dca \u0db1\u0dcf \u0dca \u0dc1\u0dc3 \u0dbd\u0dca\u200d\u0dcf\u0dc1\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda \u0d9a\u0da7\u0dca\u0da7\u0dd2\u0dba; \u0dd1\u0d9a\u0da7 fund \u0d9a \u0db1 \u0d9a\u0da7\u0dca\u0da7\u0dd2\u0dba; \u0db8 \u0dad\u0dd2\u0dc0 \u0dab\u0dc0\u0dbd\u0dca\u200d\u0da7 \u0dc3\u0dbd\u0dca\u0dbd\u0dd2 \u0dc1\u0dcf\u0db1 \u0d9a\u0da7\u0dca\u0da7\u0dd2\u0dba. \u0d85\u0dcf \u0dc1\u0db8\u0dca \u0dc1\u0da7\u0dca \u0dc0\u0dd3 \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad \u0db8\u0dd2\u0dbd\u0dca\u200d\u0d9a\u0da7 \u0d9c\u0dca \u0dc1\u0dca \u0db1 \u0dad\u0dd2\u0dc0 \u0d92\u0dc1\u0d9c\u0ddc\u0dbd\u0dca\u0dbd\u0dca\u200d\u0dca \u0d92\u0dc1\u0d9a\u0dca \u0dc1\u0d9a\u0ddd\u0da7\u0dd2-\u0db4\u0dca\u200d\u0dbb\u0dc1\u0d9a\u0ddd\u0da7\u0dd2 \u0d9c\u0dab\u0db1\u0d9a\u0dca \u0dc4\u0dca\u200d\u0db8\u0dca\u0db6 \u0d9a \u0db1\u0dc0\u0dcf. \u0dc3\u0db8\u0dc4\u0dca\u200d \u0dc0\u0dd2\u0da7 \u0d92\u0dc0\u0dcf\u0dba\u0dd2\u0dca \u0da1\u0dca \u0dcf \u0dc0\u0dba\u0dcf\u0db4\u0dcf \u0dc0\u0dbd\u0dca\u200d\u0da7 \u0db8\u0dd4\u0dcf\u0dbd\u0dd4\u0dca \u0dbd\u0dca\u200d \u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0d87\u0dad\u0dd2. \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dc1\u0db8\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dd4,\u0dc1\u0dda\u0dca \u0d92 \u0dc0 \u0dc1\u0da9\u0dca \u0d9a \u0db1 \u0d91\u0d9a\u0dca\u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dca \u0dc1\u0dcf\u0dca \u0dc1\u0db1\u0d9a\u0dca\n\n\u0d89\u0dca \u0db1\u0dc0\u0dcf. \u0db8\u0db8 \u0d92 \u0d85\u0dba\u0dc1\u0d9a \u0db1\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0dca \u0db1 \u0dba\u0dca \u0dc1\u0dca \u0db1 \u0dc4\u0dca\u200d . \u0dc1\u0db8\u0ddc\u0d9a\u0dcf \u0db8\u0db8 \u0d9a\u0dcf\u0da7\u0dc0\u0dca \u0dc1\u0db4\u0dde\u0dc1\u0d9c\u0dbd\u0dd2\u0d9a\u0dc0 \u0db4\u0dc4\u0dca\u200d \u0d9c\u0dc4\u0dca\u200d\u0dca \u0db1 \u0dba\u0dca \u0dc1\u0dca \u0db1 \u0dc4\u0dca\u200d . \u0db8\u0db8 \u0d87\u0db8\u0dad\u0dd2\u0dd4,\u0db8\u0dcf\u0dc1\u0d9c\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dca\u200d\u0dca \u0dc1\u0dca \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0d9a \u0dc1\u0db8\u0dca \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0dca \u0dc0 \u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5\u0d9a\u0dca \u0dc4\u0dca\u200d\u0dcf\u0dca \u0db1 \u0d9a\u0dd2\u0dba\u0dcf\u0dba\u0dd2. \u0dc1\u0db8\u0dca \u0db8\u0dc4\u0dca\u200d \u0d9a\u0dca \u0db1\u0dc1\u0dda \u0dc0\u0dd3 \u0dc1\u0db8\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dc1\u0da7\u0ddc\u0dca \u0dc0\u0dd2\u0dd2\u0dbb\u0dd4,\u0dca \u0dbd\u0dca\u200d\u0d9a\u0dca\u0dc2\u0dba\u0d9a \u0d85\u0dc3\u0dae\u0dc0 \u0dca \u0db1\u0d9a\u0dca \u0dbd\u0dca\u200d \u0dc1\u0db6\u0db1\u0dc0\u0dcf . \u0dba\u0dbd\u0dca\u200d \u0d9a\u0dca \u0db1\u0dc1\u0dba\u0dca \u0dc0\u0dd3 \u0dc1\u0db8\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dc1\u0da7\u0ddc\u0dca \u0dcf\u0dc4\u0dca\u200d\u0d85\u0da7\u0dbd\u0dca\u200d\u0d9a\u0dca\u0dc2\u0dba\u0d9a \u0d85\u0dc3\u0dae\u0dc0 \u0dca \u0db1\u0d9a\u0dca \u0dbd\u0dca\u200d \u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d87\u0dba\u0dd2 \u0d91\u0dc1\u0dc4\u0dca\u200d\u0db8 \u0dbd\u0dca\u200d \u0dc1\u0db6\u0dca \u0dc1\u0dca \u0db4 \u0dc0 \u0dc4\u0dca\u200d \u0dbd\u0dca\u200d\u0dcf \u0dc0 \u0dda \u0da7\u0dd2\u0d9a \u0db4\u0dd2\u0dbb\u0dd4\u0dab\u0dd4 \u0db1\u0dd2\u0dc3\u0dcf."
  },
