    "chunk_text": "\u0d85\u0dca\u0dd2\u0dad\u0dba \u0dca\u0dab\u0dca\u0da9\u0db1\u0d85\u0db1\u0dd4\u0dca\u0dd0\u0dad\u0dd2 \u0da7 \u0d89\u0daf\u0dd2\u0dd2\u0db4\u0db4\u0dca \u0da7\u0dba\u0db1\u0dd4 \u0db1\u0dd0\u0dc1\u0dda. \u0d91\u0dca \u0d85\u0db1\u0dd4\u0dca\u0dd0\u0dad\u0dd2 \u0d85\u0db1\u0dd41 \u0d92 \u0d92 \u0d86 \u0dad) \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd21\u0dba\u0dd4\u0dc4\u0dba\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dca\u0db4 \u0d9a\u0dca\u200d\u0dbb\u0dca\u0dc1\u0dda\u0daf \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db31 \u0dbb\u0dd4\u0dba\u0da7 [ \u0d9c\u0db1\u0dd4 \u0d87\u0dad. \u0d91\u0dc1\u0dca\u0db1\u0dca\u0dca \u0dc1\u0dca\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd21\u0dba\u0dd4\u0dc4\u0dba\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dca\u0db4 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dd21\u0dbd\u0dd2 \u0dc3\u0dd2\u0daf\u0dd4 \u0da7\u0dba\u0db1\u0dd4 \u0db1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dd2\u0db0\u0dc1 \u0dda\u0dc2\u0dd2\u0dad1 \u0dc3\u0da7\u0dc3\u0dcf \u0da7\u0dba) \u0db1\u0daf \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd21\u0dba\u0dd4\u0dc4\u0dba\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dca\u0db4 \u0dca\u0dd2\u0dbb\u0dca\u0dc1\u0d9c\u0ddd\u0db4\u0dc1\u0dc1 \u0dca\u0dd2\u0db1\u0dd21 \u0d85\u0db1\u0dd41 . \u0dc1\u0dca\u0dca \u0dca\u0dd2\u0dbb\u0dca\u0dc1\u0d9c\u0ddd\u0db4\u0dc1\u0dc1 \u0dca\u0dd2\u0db1\u0dd21 \u0daf \u0d85\u0dca\u0dd2\u0dad\u0dba \u0dca\u0dab\u0dca\u0da9\u0db1 \u0dd2\u0db0\u0dc3\u0dd2\u0db1\u0dca \u0d85\u0db1\u0dd4\u0dca\u0dad \u0da7\u0dba \u0d87\u0dad.\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0db1\u0d82\u0da7\u0dd2 \u0dc1\u0da7\u0dbd\u0dd2\u0dc1\u0da7\u0ddc\u0dca\u0db4 \u0d86 \u0dad) \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd21\u0dba\u0dd4\u0dc4\u0dba\u0d9c\u0dad\u0da7\u0dba\u0da7 \u0dc3\u0db3\u0dc4\u0dba\u0dd2 \u0d851 \u0dba \u0db8\u0dd6\u0dbd\u0dd2\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dca\u0dc1\u0dda\u0daf \u0dc3\u0da7\u0dc3\u0dcf \u0da7\u0dba \u0d85\u0db7\u0dd2\u0db1\u0dd2 (EoIs) \u0da7\u0dd0\u0db3\u0dc0\u0dd3\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0da7\u0dba