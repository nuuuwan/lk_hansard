    "chunk_text": "\u0dd9\u0dae\u0dd2\u0db1\u0dd2 \u0dd9\u0dd4\u0db8\u0dd2 \u0d92 \u0d851\u0dc3\u0dda\u0dae\u0dd2\u0dc1\u0dda\u0daf\u0dd3 \u0d85\u0daf\u0dc4\u0dba\u0dc3\u0dda \u0daf\u0dd0\u0d9a\u0dca\u0dc0\u0dd6\u0dc1\u0dda \u0dc1\u0db8\u0dd2\u0dd9\u0d9a\u0dca\u0dc0 \u0d9c\u0dd0\u0db1\u0daf? \u0dc1\u0daf\u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dca\u0dc0 \u0da1\u0dcf\u0db1\u0dca\u0dad\u0daf \u0daf\u0dd3\u0dad\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0db1\u0dd2\u0dc3\u0dd2 \u0db6\u0dd0\u0dbb\u0dd2 \u0dc11\u0daf\u0dd21\u0dad\u0dca \u0d92 \u0dc1\u0daf\u0dc1\u0daf\u0db1\u0dd2 \u0d91 \u0da7 \u0dc0\u0dd2\u0dc0 \u0dda\u0db01 \u0da1\u0dcf\u0db1\u0dca\u0dad\u0daf \u0dd4\u0dc0\u0db1\u0dca\u0dad\u0db1\u0dd2 \u0dd2\u0dbb \u0daf\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dd9\u0dd2 \u0dd9\u0dc1\u0dc5\u0dd2\u0dad\u0dca \u0d91\u0dad\u0dc1\u0dd9\u0dd2\u0da7 \u0db4\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da81 \u0da1\u0dcf\u0db1\u0dca\u0dad\u0daf 9\u0d9a\u0dca\u0dc0 \u0dc3\u0dc4\u0dba \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da81 \u0da1\u0dcf\u0db1\u0dca\u0dad\u0daf 9\u0d9a\u0dca\u0dc0 \u0dc11\u0db11\u0dd2. \u0d91\u0dad\u0dc1\u0dd9\u0dd2\u0da7 \u0dd9\u0dae\u0dd2\u0db1\u0dd2 \u0dd9\u0dd4\u0db8\u0dd2\u0dc1\u0db8 \u0da1\u0dcf\u0db1\u0dca\u0dad\u0daf \u0db4\u0dd2\u0dc0\u0dd2\u0dca\u0dd2 \u0dd9\u0dba\u0db1\u0dca\u0dad\u0db1 \u0dad\u0dca\u0dc5\u0dd41\u0db1\u0dca\u0dad \u0dc11\u0db11\u0dd2. \u0d91\u0dc1\u0dc4\u0dba\u0db8 \u0dc0\u0dd4\u0dc1\u0da7\u0dd2\u0dad\u0dca \u0d91\u0dd4\u0db8\u0dd2 \u0db4\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0db4\u0dd2\u0dbb\u0dd41 \u0dad\u0db8\u0dba\u0dd2 \u0da1\u0dcf\u0db1\u0dca\u0dad\u0daf \u0dc1\u0daf\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dd2\u0dbb \u0daf\u0dd2 \u0d91\u0dd4\u0db8\u0dd2\u0dc1\u0db8 \u0db8\u0dad \u0d89\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dd9\u0dba\u0daf\u0dd2 \u0dad\u0dd2\u0db6\u0dd4\u0da7\u0dd2. \u0d92\u0dd9 \u0db4\u0daf\u0db1\u0db8\u0dca \u0dd9\u0dba\u0dc1\u0d9c\u0db1 \u0dad\u0db8\u0dba\u0dd2 \u0da2\u0dca\u200d\u0db1\u0dd2\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dd2 \u0d91\u0dd4\u0db8\u0dd21 IGP \u0dc1\u0daf\u0dc3 \u0db4\u0dad\u0dca \u0dd9\u0dc1\u0dc5\u0dda. \u0d92 \u0db4\u0dad\u0dca \u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0daf\u0dd0\u0db1\u0dca\u0dad \u0dc3\u0dd2\u0dd4\u0dc0 \u0dd9\u0dc1\u0dc5\u0dda \u0db1\u0dd0\u0dad\u0dd2 \u0dc0\u0dd4\u0da7\u0dad\u0dca \u0dc1\u0dda \u0db6\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc1\u0dad\u0db1\u0dca\u0dad\u0db1\u0dc1\u0dd9\u0ddd\u0db1\u0dca\u0dad acting IGP \u0dc4\u0dba\u0dd0\u0da7\u0dd2 \u0da7 \u0dd9\u0da7\u0dba\u0dd4\u0dd4 \u0dd9\u0dba\u0db11\u0dd2. \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0dc1\u0db81\u0dd0\u0db1\u0dd2 \u0dc1\u0db6\u0dd2\u0dc5\u0db3 \u0dd9\u0dd2\u0dba\u0da7\u0dd2 \u0d9c\u0dd0\u0db1 \u0dd9\u0dae\u0dd2 \u0dd9\u0dba\u0db1 \u0d91\u0dc1\u0d9a\u0dca\u0dc0 \u0dd2\u0dbb\u0dc3\u0dd2\u0db8 \u0dc1\u0dad\u0dca\u0dc0 \u0db8\u0d9a\u0dca\u0dc0 \u0db1\u0dd0\u0dc4\u0dba\u0dd0. \u0d85\u0dc1\u0db4\u0dca \u0dc4\u0dd4\u0d9f\u0d9a\u0dca\u0dc0 \u0db8\u0db1\u0dca\u0dad\u0dd31\u0dc0 \u0db1\u0dca\u0dad \u0dc1\u0db8\u0dca \u0d9c\u0dc0 \u0dc3\u0db7\u0dd2\u0dc1\u0dda\u0daf\u0dd3 \u0db4\u0dd01\u0dc3\u0dd6 \u0d85\u0db1\u0dca\u0dad\u0daf\u0db8\u0da7 \u0d85\u0daf \u0dba\u0dc1\u0da7\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca1 \u0d85\u0db1\u0dd41 \u0db8\u0dd3\u0da7 1\u0da9\u0dd2 1\u0dd0\u0daf\u0d9c\u0dad\u0dca \u0db4\u0db1\u0dad\u0dca \u0dc0\u0dd2 \u0dd2\u0daf \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0da7 \u0d9a\u0dca\u0dc0 \u0d85\u0db4\u0da7 \u0dc1\u0d9c\u0dc1\u0db1\u0db1\u0dca\u0dad\u0db1 \u0dad\u0dca\u0dc5\u0dd41\u0db1\u0dca\u0dad \u0dc11\u0daf\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db11\u0dd2.\n\n\u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0dad\u0db11\u0dd2 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1 \u0db1\u0dca\u0dad\u0db8 \u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dc0 \u0dda\u0daf \u0db8\u0dd0\u0dad\u0dd21\u0dba\u0da7 1\u0dc3\u0dba\u0d9a\u0dca\u0dc0 \u0db61. \u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dc0 \u0dda\u0dc1\u0dda \u0daf\u0d82\u0dd9\u0dd2\u0dc1\u0dda \u0dc0\u0dd2\u0dad\u0dba\u0d9a\u0dca\u0dc0 \u0dc1\u0db1\u0dd2\u0dc11\u0dba\u0dd2 \u0dc1\u0daf\u0ddd\u0dd9\u0dc1\u0dda \u0dc1\u0db6\u0dd2\u0dc1\u0dc4\u0dba\u0ddd \u0dba\u0da71\u0daf \u0db8\u0dd0\u0dad\u0dd21\u0dba\u0da7 \u0db41\u0dad\u0dca1\u0db11\u0dd2. \u0dc11\u0dd2\u0dd2\u0db1\u0dca\u0dad\u0da7\u0db1\u0dca\u0dad1\u0daf \u0db8\u0dd1\u0dad\u0dd9\u0daf\u0dd3 \u0dc3\u0dd2\u0dd9\u0dca\u0da1\u0dcf\u0dd2 \u0dd9\u0dba\u0daf\u0dd2 \u0dad\u0dd2\u0db6\u0dd4\u0da7\u0dd2 Online Safety Bills1\u0daf \u0dad\u0dd2\u0db6\u0dd4\u0dd4 \u0d9c\u0dd0\u0da7\u0dad\u0dca\u0dad\u0dca \u0d91\u0d9a\u0dca\u0dc0\u0dd9 big data, \u0d91\u0dc1\u0dc4\u0dba\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0d91\u0dd9 \u0d91\u0dd9 \u0dc11\u0dda \u0d85\u0da9\u0dc0\u0dd2 \u0dc4\u0dba\u0dba\u0dc4\u0dba\u0dd2 \u0da2\u0dca\u200d\u0db1\u0dad\u0dd21\u0dc1\u0db8 \u0db8\u0db1\u0dc3 \u0dc11\u0db1\u0dc3\u0dda \u0dd9\u0dba\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dc1\u0dd9\u0dd2\u0dc1\u0dc4\u0dba\u0dd2\u0db8\u0daf \u0dd2\u0dbb \u0db1 \u0dd9\u0dd2\u0dba\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db31.\n\n\u0d92 1\u0dd2\u0dc1\u0db8\u0db8 \u0d87\u0dc1\u0db8\u0dbb\u0dd2\u0dd9\u0dd21 \u0dc1\u0db8\u0dca 1\u0db1\u0dc0\u0dd2\u0da7 TikTok \u0dad\u0dc4\u0dba\u0db1\u0db8\u0dca \u0dd9\u0dba\u0db1\u0dca\u0dad\u0db1 \u0db11\u0dd2. \u0d92 \u0d85 \u0dd9\u0dba\u0dad\u0dca \u0d91\u0dd9 \u0dc1\u0daf\u0ddd\u0daf\u0db1\u0dd21\u0d9a\u0dca\u0dc0 \u0dad\u0db8\u0dba\u0dd2 \u0d87\u0dc1\u0db8\u0dbb\u0dd2\u0dd9\u0dd2\u0dc1\u0dda TikTok1\u0daf\u0daf\u0dd3 \u0dc11\u0db1\u0dad\u0dca \u0dc1\u0dda1\u0dbd\u0dca \u0dc1\u0db4\u0db1\u0dca\u0dad1\u0db11\u0dd2 \u0db1\u0dd4 \u0dad\u0dca \u0da0\u0dd3\u0db1\u0dc1\u0dda\u0daf\u0dd3\n\nTikTok \u0d86 \u0dad\u0db1 algorithm \u0d91\u0dd9 \u0dc11\u0db1\u0dc3\u0dda \u0dd9\u0dba\u0daf\u0dd2 \u0d92 \u0daf\u0dc0 1\u0db1\u0dca\u0dad\u0da7 \u0d9c\u0dab\u0dd2\u0dad 1\u0dd2\u0dc1\u0db8\u0db8 \u0dc0\u0dd2\u0db7\u0dd2\u0d9c \u0db4\u0dd2\u0dc3\u0dda \u0dc11\u0db1 \u0d86\u0dd9\u0dd2\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db31 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0d8b\u0db1\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dd9\u0dba1\u0db1 \u0dc1\u0dda1\u0dbd\u0dca \u0dc1\u0db4\u0db1\u0dca\u0dad1\u0db11\u0dd2 \u0dd2\u0dbb \u0db1 \u0d91\u0dd9. \u0d85\u0daf \u0dc11\u0db1\u0dc1\u0dd9\u0dd2\u0da7 \u0d85\u0db4\u0dd2 \u0d85\u0dc0\u0dd21\u0dd2\u0daf\u0dc1 \u0db1\u0dca\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1 \u0dc1\u0db81\u0dd0\u0db1\u0dd2 Online Safety Bill \u0d91\u0dd9\u0d9a\u0dca\u0dc0 \u0dba\u0da7\u0da7 \u0d851 \u0dba\u0dba\u0dd2 \u0dd2\u0dbb \u0db1 \u0d91\u0dd9."
