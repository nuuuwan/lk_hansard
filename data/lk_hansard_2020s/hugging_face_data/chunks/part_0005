dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 (\u0dc3\u0dd2\u0dd2\u0db0\u0dbd\u0dca 0) - \u0d91\u0da0\u0dca\u0da0.\u0da9\u0dd3. \u0da2 \u0dc1\u0d9a\u0dc1\u0da9\u0dd2 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2 , \u0db4\u0dd3. \u0d86\u0d9a. \u0dd2\u0db0\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0db8\u0dc4\u0dad\u0dc1\n\n\u0dd4 \u0d9a\u0dcf\u0dc3 \u0db4\u0dcf\u0dcf \u0dbd\u0dd2\u0db4\u0dca\u200d\u0dbb\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd3 - \u0db6\u0dd3.\u0dc1\u0d9a\u0dca. \u0dc1\u0db1\u0d9a \u0db8\u0dc4\u0dad\u0dc1\n\n\u0d86 \u0dcf\u0dc3\u0db4\u0dcf\u0db1 \u0dd4 \u0dd9\u0dd8 \u0db4\u0dcf\u0dbd\u0db1 \u0db4\u0dca\u200d\u0dbb \u0db4\u0dcf\u0dcf \u0dad\u0dca\u0db4\u0dca\u200d\u0dbb\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0d85\u0db0\u0dcf\u200d\u0d9a\u0dca\u200d\u0dc2 (\u0d86 \u0dcf\u0dc3\u0db4\u0dcf\u0db1 \u0dd4 \u0dd9\u0dd8 \u0db4\u0dcf\u0dbd\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dd4\u0db1\u0dc0\u0dcf) - \u0d86\u0d9a. \u0d91\u0da0\u0dca\u0da0. \u0d91\u0daf\u0dd2\u0db4\u0dad\u0dc3\u0dd2\u0dcf\u0dc4 \u0db8\u0dc4\u0dad\u0dc1\n\n\u0dd2\u0db0\u0db0\u0dcf\u0dcf\u0dba\u0d9a \u0dc3\u0dd6\u0db4\u0db4\u0dca\u200d\u0dbb\u0dda\u0daf\u0dd3 - \u0d91\u0dbd\u0dca.\u0dc1\u0d9a\u0dca.\u0dad\u0dcf.\u0d91\u0dca\u0dae. \u0d9c\u0da2\u0db1\u0dc1 \u0d9a \u0db8\u0dc4\u0dad\u0dc1\n\n\u0dd2\u0db0\u0db0\u0dcf\u0dcf\u0dba\u0d9a \u0dd9\u0dd8 \u0db4\u0dcf\u0dbd\u0d9a - \u0da9\u0dd3.\u0da9\u0dd3.\u0d85\u0dba\u0dd2. \u0dad\u0dd4\u0dc2\u0dc1\u0dbb \u0db8\u0dc4\u0dad\u0dc1\n\n\u0d86 \u0dcf\u0dc3\u0db4\u0dcf\u0db1 \u0d9a\u0dc3\u0db8\u0db1\u0dcf\u0d9a\u0dd4\u0dab - \u0dc1\u0d9a\u0dca.\u0d91\u0dca\u0dae. \u0dc3\u0dd4\u0db8\u0db1\u0dc0\u0dd3\u0dbb \u0db8\u0dc4\u0dad\u0dc1\n\n\u0db1\u0dd2\u0db4\u0dca\u200d\u0dbb\u0dba\u0ddd\u0da2\u200d \u0d86 \u0dcf\u0dc3\u0db4\u0dcf\u0db1 \u0d9a\u0dc3\u0db8\u0db1\u0dcf\u0d9a\u0dd4\u0dab - \u0dc1\u0d9a\u0dca.\u0d92.\u0da9\u0dd3.\u0d92. \u0dd2\u0db0\u0dc1\u0da2\u0dca\u0dc3\u0dd2\u0db4\u0dad \u0db8\u0dc4\u0dad\u0dc1\n\n\u0dd4 \u0d9a\u0dcf\u0dc3 \u0dd2\u0db0\u0db0\u0dcf\u0dcf\u0dba\u0d9a \u0dc3\u0dd6\u0db4\u0db4\u0dca\u200d\u0dbb\u0dda\u0daf\u0dd3 - \u0da9\u0dd3.\u0d91\u0dca .\u0d91\u0dca .\u0d91\u0dca .\u0db6\u0dd3. \u0d8b\u0dd9\u0db4\u0dc1\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dc1\n\n\u0dd4 \u0d9a\u0dcf\u0dc3 \u0dd9\u0dd8 \u0db4\u0dcf\u0dbd\u0d9a - \u0dc1\u0d9a\u0dca. \u0d91\u0db1\u0dca. \u0db3\u0dca\u0dae\u0db1\u0dc1 \u0d9a \u0db8\u0dc4\u0dad\u0dc1\n\n\u0d86\u0db4\u0db1\u0dc1\u0dcf\u0dbd\u0dcf \u0d9a\u0dc3\u0db8\u0db1\u0dcf\u0d9a\u0dd4\u0dab\u0db4\u0dca\u200d\u0dbb\u0dc0\u0ddd - \u0da2\u0dd3.\u0da9\u0dd3. \u0d85\u0db1\u0dd2\u0dbd\u0dca \u0db8\u0dc4\u0dad\u0dc1, \u0ddb\u0db6\u0dca\u0dd2\u0dda.\u0d91\u0db1\u0dca.\u0d86\u0d9a. \u0dd2\u0db0\u0dc1\u0da2\u0dca\u0dc0\u0d9a\u0db0\u0dca\u200d\u0db1 \u0db8\u0dc4\u0dad\u0dc1, \u0da9\u0dd3.\u0d91\u0da0\u0dca\u0da0.\u0db6\u0dd3.\u0db6\u0dd3. \u0db4\u0dad\u0dca\u0db8\u0dc3\u0dd2\u0db4\u0dad \u0db8\u0dc4\u0dad\u0dc1, \u0d91\u0da0\u0dca\u0da0.\u0da9\u0dd3.\u0da7\u0dd3.\n\n\u0db4\u0dca\u200d\u0dbb\u0dd2 \u0db1\u0dca\u0dad \u0db8\u0dc4\u0dad\u0dc1, \u0dc1\u0da2\u0dca.\u0d92.\u0d91\u0dca\u0dae.\u0dc1\u0d9a\u0dca. \u0da2 \u0dc1\u0d9a\u0dc1\u0da9\u0dd2 \u0db8\u0dc4\u0dad\u0dc1, \u0da9\u0dd3. \u0d91\u0dca\u0dae. \u0dc1\u0dbb\u0ddd\u0dc4\u0da7 \u0db8\u0dc4\u0dad\u0dc1, \u0ddb\u0db6\u0dca\u0dd2\u0dda.\u0da9\u0dd3.\u0d91\u0dca\u0dae.\u0d86\u0d9a. \u0dd4 \u0db8\u0dc1\u0dbb \u0db8\u0dc4\u0dad\u0dc1"
