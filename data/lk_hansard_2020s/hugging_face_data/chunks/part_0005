dd2\u0db6\u0d9a\u0dcf\u0dc1\u0dda \"\u0db3\u0dbd\u0dba\" \u0dc0\u0db1\u0da9\u0dcf \u0dc3\u0da7\u0dc4\u0db1 \u0dc1 \u0dbb\u0dab \u0db1\u0dcf\u0dd2\u0db6\u0d9a\u0dcf\u0dc1\u0dda \"\u0dc0\u0dcf \u0db4\u0dd2\u0da7\u0dd2\u0dba\" \u0dc0\u0db1\u0da9\u0dcf \u0dc3\u0da7\u0dc4\u0db1 \u0dc3\u0dda\u0dc0\u0dbb\u0dca\u0dab\u0dc0\u0dcf\u0dc4\u0dd2\u0db1\u0dd2\u0dc1\u0dda \"\u0dbb\u0dad\u0dd4\u0db8 \u0d89\u0dbb\" \u0dc0\u0db1\u0da9\u0dcf \u0dc3\u0da7\u0dc4\u0db1 \u0d86\u0daf\u0dd3 \u0dc0\u0db1\u0da9\u0dcf \u0dc3\u0da7\u0dc4\u0db1\u0dca \u0d9c\u0dab\u0db1\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0dc0\u0dc3\u0dbb \u0d9c\u0dab\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0db4\u0dd4\u0dbb\u0dcf \u0db8\u0dd4\u0dab \u0d9c\u0db1\u0dc4\u0dd4\u0dab\u0dcf \u0db8\u0da7 \u0db8\u0dad\u0d9a\u0dba\u0dd2."
