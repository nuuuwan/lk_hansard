u0dbb\u0dca\u0dc1\u0dda\u0daf [ \u0dc4\u0dba\u0dba\u0dc4\u0dba\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dd2\u0dca \u0dca\u0da7 \u0da7\u0dcf\u0dd2 )\u0dca\u0db4 1\u0da9\u0dd2\u0dca \u0dc1 \u0ddd\u0d9c\u0dba\u0dba\u0dd2 \u0d9a\u0dd2 ) \u0d91\u0da7. \u0d92 1\u0dd2\u0dc1 \u0dca \u0daf\u0dd0\u0db1\u0dca \u0da7\u0dba\u0db1\u0dd2 \u0dad\u0dd2\u0dc1\u0db6)1\u0dd2 \u0d9a\u0dd2 ) EIA \u0d91\u0da7 \u0dc1\u0daf\u0ddd\u0dc2\u0dca\u0da8 \u0dc3\u0dc4\u0dd2\u0dad\u0dba\u0dd2 \u0d9a\u0dd2 \u0db1\u0dd2 \u0d85\u0db4\u0dd2 \u0dc4\u0dd2\u0dad)1\u0dd2. \u0d92\u0dc1\u0da7\u0db1\u0dca\u0dca \u0d9a\u0dd2 )1\u0dd2 \u0dc1\u0dc4\u0dba\u0ddc\u0db3\u0dca \u0dc3\u0dcf\u0dcf\u0dd2) \u0d9c\u0dd0) \u0dc1\u0dc3\u0ddc \u0dd2 \u0db6\u0dd0\u0dbd\u0dd4\u0dc11\u0ddc\u0dca \u0dad1\u0dca \u0dc3\u0dcf\u0dcf\u0dd2) \u0dd4,)\u0da7\u0da7 \u0db4\u0dc4\u0dba\u0dc5\u0dd2\u0db1\u0dca \u0dad\u0dca\u0dba\u0dd2 \u0dc1\u0dca\u0db4 \u0dca\u0db1\u0dca)\u0dd2\u0dba\u0dca \u0db4\u0dad\u0db4\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d9a\u0dd2 ) \u0d91\u0da7. \u0d92 \u0d9a\u0dd2 \u0db1\u0dca\u0dc1\u0db1\u0dca Kalpitiya Peninsula, Ambewela Cattle Farm, Southeast Coast \u0d9a\u0dd2 ) \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dc1 \u0db8\u0dd3\u0da7 1\u0dd0\u0dd2 \u0dc1 \u0ddd\u0d9c\u0dba \u0dc3\u0dcf\u0dcf\u0dd2) \u0d9a\u0dd2 \u0db1\u0dd2\u0dca \u0dc3\u0db3\u0dc4\u0dba\u0db1\u0dca \u0dc11)1\u0dd2. \u0d921\u0dd2 \u0d9c\u0dd0)\u0dca \u0dca\u0dca \u0d94\u0db6\u0dd4,\u0dca\u0dd2\u0dc1\u0d9c\u0db1\u0dca \u0dc1\u0db6\u0ddc\u0dc1\u0dc4\u0dba\u0ddc\u0dca \u0d851\u0d82\u0da7 \u0db4\u0dd0\u0dc4\u0dba\u0dd0\u0daf\u0dd2\u0dbd\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dca [ \u0db6\u0db1\u0dd2\u0dc1\u0db4\u0ddc\u0dc1\u0dba\u0ddc\u0dca \u0dd4, \u0dc11)1\u0dd2. \u0d92 1\u0dd2\u0dc1 \u0dca \u0dc1\u0dca\u0db4 \u0dc3\u0db3\u0dc4\u0dba\u0dd2 \u0dc0 \u0db4\u0dd2 \u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2 ) \u0d9c\u0da7)\u0da7 \u0d86\u0dc1 \u0ddd\u0da2\u0dca\u200d) [ \u0da7\u0dba)1\u0dd2 \u0d9a\u0dd2\u0dda1\u0dd2\u0dca \u0d87\u0dca \u0dad 1 \u0dc1 \u0db1\u0dca\u0dca \u0dc3\u0dad\u0dba \u0da7\u0dd2\u0dba\u0da7\u0dd21 \u0d91\n\n\u0dc1)\u0ddc\u0dc11\u0dba\u0dd2 \u0d9a\u0dd2 ) \u0d91\u0da7\u0dca \u0dca\u0dca \u0dc1\u0dca\u0db4 \u0d851\u0dc3\u0dcf\u0dcf\u0dd2\u0dc1\u0dda\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0da7\u0dd2 \u0da7\u0dba\u0db1\u0dca) \u0da7\u0dd0\u0dca\u0dd0\u0dad\u0dd2\u0dba\u0dd2.\n\n\u0dc1\u0dca\u0db4 \u0da7\u0dc0 \u0dab\u0dd4-\u0da7\u0dd2\u0dba\u0da7\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db31 \u0dca\u0dca \u0d94\u0db6\u0dd4,\u0dca\u0dd2\u0dc1\u0d9c\u0db1\u0dca \u0db4\u0dd0\u0dc4\u0dba\u0dd0\u0daf\u0dd2\u0dbd\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0dd4,\u0dba [ \u0db6\u0db1\u0dd2\u0dc1\u0db4\u0ddc\u0dc1\u0dba\u0ddc\u0dca \u0dd4, \u0dc11)1\u0dd2. \u0dc3\u0dcf\u0dd4,\u0dad\u0dd2\u0dba\u0dd2.\n\n\u0d9c\u0dd4\u0dab \u0d9a\u0d82\u0da0\u0db1 \u0dc0\u0dd2\u0dc0\u0dda\u0dc0\u0dc3\u0dda\u0d9a\u0dbb \u0db8\u0dc3\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b95\u0b9e\u0bcd\u0b9a\u0ba9 \u0bb5\u0bbf\u0b95\u0b9c\u0b95\u0b9a\u0b95\u0bb0) (The Hon. Kanchana Wijesekera) \u0d9c\u0dc0 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dca\u200d\u0dba \u0da7\u0dcf\u0dd2)\u0dd2 \u0da7\u0dd4,\u0dca\u0db1\u0dd2 \u0dd2\u0db0\u0db4 [\u0dc2\u0dca\u0da8 )\u0dd2 \u0da7\u0dd4,\u0dca\u0dd2 \u0dd2\u0db0\u0dc3\u0dd2\u0db1\u0dca \u0d85\u0dc3) \u0db1\u0daf \u0dc3\u0dcf\u0dcf\u0dd21\u0dba \u0db1\u0dd2\u0dc1 \u0ddd\u0d9c 27 (2 \u0da7\u0dc1\u0dca \u0db4\u0dca\u200d\u0dbb \u0dcf) \u0d8a\u0dc1\u0dda \u0dc31\u0dc3 2.00\u0da7 \u0dad\u0dca\u0dba\u0dd2 \u0d85\u0db4\u0dd2\u0da7 \u0dc1 \u0ddc\u0db8\u0dd4 \u0da7\u0dc1\u0dcf\u0dda. \u0dc1\u0da7\u0dc1\u0dc3\u0dda )\u0db8\u0dd4\u0dca \u0d85\u0db4\u0dd2 \u0d92\u0da7\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0dd4,\u0dc0 \u0db1\u0db6\u0dd2 \u0dc1\u0daf)1\u0dd2. \u0d92\u0da7 \u0dc3\u0dd2\u0db0\u0dc3\u0dcf\u0dad\u0dba\u0dd2\u0dca \u0dca\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0dd4,\u0dba [. \u0d92 1\u0dd2\u0dc1 \u0dca \u0dca\u0dca \u0dd2\u0db0\u0db4 [\u0dc2\u0dca\u0da8 )\u0dd2 \u0da7\u0dd4,\u0dca\u0dd2\u0da7 \u0dc3\u0dcf\u0dd4,\u0dad\u0dd21\u0db1\u0dca\u0dad \u0dc11)1\u0dd2 \u0dc1\u0dca\u0db4 \u0db4\u0dca\u200d\u0dbb \u0dcf) \u0dca\u0dd4, \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0dc3\u0dca\u0db4\u0db6\u0db1\u0dca\u0db1\u0dc1 \u0db1\u0dca. \u0dc1\u0dca\u0ddc\u0da7\u0daf \u0d85\u0db4\u0dd2\u0da7\u0dca \u0dc1\u0dca\u0db4\u0da7\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0dd4,\u0dc0 \u0db1\u0db6\u0dd2 \u0dc1\u0daf\u0db1\u0dca) \u0d851\u0dc3\u0dcf\u0dcf\u0dd21 [ \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0dab\u0dca )\u0dd0\u0dc4\u0dba\u0dd0. \u0d92 1\u0dd2\u0dc1 \u0dca \u0dc1\u0dca\u0db4 \u0db4\u0dca\u200d\u0dbb \u0dcf)\u0dc1\u0dda 1\u0dd0\u0dba\u0daf\u0dd2 \u0da7\u0dd2\u0dba\u0da7\u0dd2 \u0d9c\u0da7)\u0dd21 [ \u0dad\u0dd2\u0db6\u0dd4\u0da7\u0dd2. \u0dc1\u0da7\u0dc1\u0dc3\u0dda )\u0db8\u0dd4\u0dca \u0d921\u0dd2\u0dca \u0db1\u0dd21\u0dd0\u0dba\u0daf\u0dd2 \u0da7\u0dba\u0dc1\u0d9c) \u0dca\u0dca \u0dda\u0dca \u0dad\u0dba \u0da7\u0dd2\u0da7 \u0db1\u0db6\u0dd2\u0dc1\u0daf\u0db1\u0dca) \u0da7\u0da7\u0dd4\u0dad\u0dd4, \u0da7\u0dba)1\u0dd2.\n\n\u0d9c\u0dc0 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dca\u200d\u0dba \u0da7\u0dcf\u0dd2)\u0dd2 \u0da7\u0dd4,\u0dca\u0db1\u0dd2 \u0dca\u0db1\u0dca)\u0dd2\u0dba\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dc1 \u0dc1\u0dda \u0dc3\u0dd4\u0dcf\u0d82 \u0db6\u0db1\u0dd2\u0d9c\u0dd2\u0dba \u0d91\u0da7 [ \u0dc1)\u0ddc\u0dc11\u0dba\u0dd2 \u0dc3\u0dd4\u0dcf\u0d82 \u0db6\u0db1\u0dd2\u0d9c\u0dd2\u0dba \u0d9a\u0dd3\u0db4 [ \u0dc1\u0dca\u0db4 1)\u0dd2\u0db0\u0da7\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dd2\u0dca \u0dca\u0da7 \u0dc11)1\u0dd2. \u0d921\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dd2\u0dca \u0dca\u0da7 \u0dc11)1\u0dd2 1\u0dd2\u0dc1 \u0dca \u0db6\u0db1\u0dd2\u0d9c\u0dd2\u0dba \u0d9a\u0dd3\u0db4 [ \u0dc11\u0db1\u0dd4\u0dc11\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dca\u0db4\u0db4\u0dd2\u0daf) \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dd21\u0dbd\u0dd2 \u0dd4,\u0dcf \u0da7\u0da7\u0dd4\u0dad\u0dd4, \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dd2\u0dca \u0dca\u0da7 \u0dc11\u0db8\u0dd2\u0db1\u0dca \u0db41\u0dad\u0dd2)1\u0d