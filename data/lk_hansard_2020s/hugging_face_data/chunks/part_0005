\u0dd2 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0dca 1\u0dba1\u0dc3\u0dcf\u0dcf\u0dd2 \u0dc3\u0dcf\u0dd21\u0da7 \u0d911\u0db1\u0dca) \u0d95)\u0dd1. \u0d91 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0dca 1\u0dba1\u0dc3\u0dcf\u0dcf\u0dd2 \u0dc3\u0dcf\u0dd21\u0da7 \u0d92 \u0dd2\u0db0\u0db0\u0dd2 \u0da7 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2 [\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0db4 \u0da7\u0dba\u0db1\u0dca) \u0db4\u0dd4\u0dc5\u0dd41\u0db1\u0dca\u0daf? \u0d85\u0dc1)\u0da7 \u0db6\u0dc4\u0dd4\u0dad\u0dba \u0da7\u0dc1 \u0d85\u0db1\u0dd4\u0dca\u0dd0\u0dad\u0dd2 \u0d91 \u0da7 \u0dad\u0dd2\u0dc1\u0db6)1\u0dd2.\n\n\u0db8\u0dd6\u0db1\u0dd2\u0dc3)\u0dd2\u0dd6\u0db4\u0daa \u0d9c\u0dc0 \u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dd4,\u0dca\u0db1\u0dd2 \u0dca\u0dca \u0dd3\u0dbb\u0dca\u0d9d1 \u0da7\u0dcf\u0dd2 \u0da7\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca )\u0dd0\u0dc4\u0dba\u0dd0. \u0dca\u0dca \u0dd2\u0db0\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1 \u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dba\u0db1\u0dca \u0da7\u0dba)1\u0dd2 \u0dc1\u0dca\u0db4 \u0dd2\u0db0 \u0dcf1\u0dd2\u0dc3 \u0dcf\u0d82\u0d9c \u0dc1 \u0ddd\u0da2\u0dca\u200d)\u0dd21 \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0db4\u0daf)\u0dca\u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0dad\u0ddc\u0dba1 \u0d89\u0daf\u0dd2\u0dd2\u0db4\u0db4\u0dca \u0dc11\u0da0\u0dca\u0dca \u0d91\u0da7 [ \u0db61.\n\n\u0d85\u0dc1\u0db4\u0dca \u0d9c\u0dc0 \u0da7\u0dcf\u0dd2)\u0dd2 \u0da7\u0dd4,\u0dca\u0dd2 \u0dc1\u0dca\u0db4 \u0dba\u0dc1\u0da7\u0dca \u0dd3\u0dbb\u0dca\u0d9d \u0dc1\u0dc1 \u0db4\u0dd2\u0db1) \u0d9c\u0dca) [ \u0d86\u0db4\u0dd4 \u0db4\u0dd4\u0dc1\u0d9c\u0db1\u0dc1 [ \u0db8\u0dd2\u0dc3 \u0d85\u0dca \u0dc4\u0dba\u0daf\u0dd2 \u0db6\u0db1\u0db1\u0dca) \u0db4\u0dca \u0da7\u0dba\u0db4\u0dd4 \u0da7\u0dcf\u0dd2)\u0dd2 \u0da71\u0dba\u0dc1 [ \u0dc1)\u0ddc\u0dc11\u0dba\u0dd2. \u0d91\u0dd4,\u0dca\u0dd2 \u0dc1\u0dca\u0db4 \u0db4\u0dd2\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dca\u0db4\u0db1\u0dca\u0dd4,\u0dc1\u0dda\n\n\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd31\u0dba\u0dc1 \u0db1 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dca\u200d\u0dba \u0d87\u0dca\u0dad\u0dd21\u0dba\u0dc1 \u0db1 \u0d87\u0dca\u0dad\u0dd21\u0dba\u0dc1 \u0db1 \u0dc4\u0dba\u0dd0\u0da7\u0dd2 \u0da7 \u0d89\u0db3\u0db1\u0dd2 \u0dd3\u0dbb\u0dca\u0d9d \u0da7\u0dd2 \u0da0) \u0dc1\u0dc1 \u0db4\u0dd2\u0db1) \u0d9c\u0dca) [ \u0d86\u0db4\u0dd4 \u0db4\u0dd4\u0dc1\u0d9c\u0db1\u0dc1 [. \u0d85\u0db4\u0da7 \u0dc4\u0dd2\u0dc3\u0dba\u0daf [ 1) \u0dad\u0dba\u0dca\u0da7 \u0dc1\u0dca\u0db4 \u0dba\u0dc1\u0da7\u0dca \u0db4\u0dca\u200d\u0dbb\u0da2\u0dca\u200d\u0dd2\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb1\u0dd2\u0daf \u0d86\u0dba [\u0dc2\u0dca\u0da8\u0dd2 \u0da7\u0dcf \u0da7\u0dcf\u0dd2)\u0dd2 \u0da71\u0dba\u0dc1 \u0db1 \u0dc4\u0dba\u0dd0\u0da7\u0dd2 \u0da7 \u0d91\u0dd4,\u0dca\u0dd2 \u0daf\u0dd2)1\u0db1\u0dca) \u0d85\u0db4 \u0dc3\u0dd2 \u0dbd\u0dd4\u0dc1\u0daf)\u0dd2 \u0da7\u0da7\u0dd4\u0dad\u0dd4, \u0da7\u0dba)1\u0dd2 \u0d9a\u0dd2 \u0dd2 \u0dc3\u0db3\u0dc4\u0dba\u0db1\u0dca \u0da7\u0dba\u0db8\u0dd2\u0db1\u0dca \u0dca\u0dca \u0db1\u0dd2\u0dc4\u0dba\u0dac \u0dc11)1\u0dd2. \u0dc1\u0db6\u0ddc\u0dc1\u0dc4\u0dba\u0ddc\u0dca \u0dc3\u0dcf\u0dd4,\u0dad\u0dd2\u0dba\u0dd2.\n\n\u0d9c\u0dd4\u0dab \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0b95\u0bb2\u0b95\u0bae\u0ba4\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0db8\u0dd3\u0dcf\u0d9f\u0da7 \u0d9c\u0dc0 1\u0dd2 \u0dc1\u0dda\u0dbd\u0dca \u0dc3\u0dd4\u0dc1\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0dcf \u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dd4,\u0dca\u0dd2. \u0d94\u0db6\u0dd4,\u0dca\u0dd2\u0da7 \u0db8\u0dd2\u0db1\u0dd2\u0dca \u0dd4, ]\u0da7 \u0da7\u0dd2\u0db1 [ \u0dad\u0dd2\u0dc1\u0db6)1\u0dd2.\n\n[\u0baa\u0bbf.\u0baa. 5.11] \u0d9c\u0dd4\u0dab \u0dc0\u0da9\u0dd2\u0dc0\u0dda\u0dbd\u0dca \u0dc3\u0dd4\u0dc0\u0dbb\u0dca\u0dc2\u0db1 \u0db8\u0dc3\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bb5\u0b9f\u0bbf\u0b95\u0bb5\u0bb2\u0bcd \u0b9a\u0bc1\u0b95\u0bb0\u0bb7\u0bcd) (The Hon. Vadivel Suresh) \u0ba4\u0b95\u0bcc\u0bb0\u0bb5 \u0ba4\u0b95\u0bb2\u0b95\u0bae\u0ba4\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0b95\u0bb3, \u0b87\u0ba9\u0bcd\u0b95\u0bb1\u0baf\u0ba4\u0bbf\u0ba9\u0bae\u0bcd \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bbe\u0bb5\u0ba4\u0bc1 \u0ba8\u0bbe\u0bb3\u0bbe\u0b95 \u0ba8\u0b95\u0b9f\u0ba4\u0baa\u0bb1\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0baa\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8e\u0ba4\u0bbf\u0bb0\u0bbe\u0ba9 \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0b95 \u0baf\u0bbf\u0bb2\u0bcd\u0bb2\u0bbe\u0baa\u0bcd \u0baa\u0bbf\u0b95\u0bb0\u0bb0\u0b95\u0ba3 \u0bae\u0bc0\u0ba4\u0bbe\u0ba9 \u0bb5\u0bbf\u0bb5\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bb2\u0ba8\u0bcd\u0ba4\u0bc1\u0ba4\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1, \u0b95\u0ba4\u0b9a\u0bbf\u0baf \u0b85\u0bb0\u0b9a\u0bbf\u0baf\u0b95\u0bb2\u0baa\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baa\u0bcd \u0b95\u0baa\u0b9a\u0bc1\u0bb5\u0b95\u0ba4\u0bb5\u0bbf\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1, \u0bae\u0bbe\u0bb1\u0bc1\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0ba4\u0b95\u0bb5\u0b95\u0bb3\u0bc1\u0b95\u0b9f\u0baf, \u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0b9a\u0bae\u0bbe\u0ba9 \u0baa\u0bbf\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0ba9\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0b95\u0b99\u0bcd \u0ba4\u0b95\u0bbe\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0b95\u0b9f\u0baf \u0ba4\u0ba4\u0bbe\u0baa\u0bcd\u0baa\u0bc1\u0bb3\u0bcd \u0ba4\u0b95\u0bbe\u0b9f\u0bbf \u0b89\u0bb1\u0bb5\u0bc1\u0b95\u0bb3\u0bbe\u0ba9 \u0bae\u0b95\u0bb2\u0baf\u0b95 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bbe\u0bb0\u0bcd\u0baa\u0bbe\u0b95 \u0b92\u0bb0\u0bc1\u0b9a\u0bbf\u0bb2 \u0b95\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0b95\u0bb3 \u0bae\u0bc1\u0ba9\u0bcd\u0b95\u0bb5\u0b95\u0bcd\u0b95\u0bb2\u0bbe\u0ba4\u0bae\u0ba9 \u0ba8\u0bbf\u0b95\u0ba9\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0b95\u0bb1\u0ba9\u0bcd."
