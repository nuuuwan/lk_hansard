    "chunk_text": "2004 2,591\n\n2005 2,515\n\n2006 2,785\n\n2007 2,869\n\n2008 2,909\n\n2009 2,762\n\n2010 2,317\n\n2011 2,808\n\n2012 2,940\n\n2013 2,513\n\n2014 2,870\n\n2015 3,056\n\n2016 3,011\n\n2017 2,450\n\n2018 2,623\n\n2019 3,086\n\n2020 2,792\n\n2024 \u0db8\u0dcf\u0dbb\u0dca\u0dad\u0dd4 05\n\n* \u0d9c\u0db4\u0ddc\u0dbd\u0dca \u0dc0\u0dd9\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0d9c\u0db8\u0dca \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\n\n\uf0b7 \u0db4\u0dc0\u0dad\u0dca\u0db1\u0dcf \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0d9c\u0dc3\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab \u0d89\u0dc4\u0dc5 \u0db1\u0db1\u0dcf\u0dc0\u0dd3\u0db8\n\n\u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dc0/ \u0db1\u0db1\u0dc0\u0dad/ \u0da7\u0dd2 \u0dc0\u0d9c\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0db8\u0dd2\u0db1\u0dca\u0da7 \u0d9c\u0dd4\u0dab\u0dad\u0dca\u0dc0\u0dc1 \u0dca\u0da7 \u0dd4\u0dad\u0dad\u0dd4 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0db4\u0db1\u0dc5 \u0dd2\u0daf\u0db4\u0dca\u0dc0\u0dd3\u0dc1\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 .\n\n\uf0b7 \u0dc1\u0d9c\u0dc0\u0dad\u0dd4 \u0dc0\u0d9c\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0 \u0dba \u0d9a\u0dbb\u0db1 \u0d89\u0dc4\u0dc5\n\n\u0d9c\u0dd4\u0dab\u0dad\u0dca\u0dc0\u0dc1 \u0dca\u0da7 \u0dd4\u0dad\u0dad\u0dd4 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0db4\u0db1\u0dc5 \u0db0\u0db6\u0dcf \u0d87\u0dc1\u0dca \u0dc0\u0db1\u0dba\u0dc3\u0da7\u0dc4\u0db1.\n\n\uf0b7 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0d89\u0dba\u0dca \u0dc0\u0db0 \u0db5\u0db0\u0db1\u0dcf\u0dba\u0dd3\u0dad\u0dcf\u0dc0 \u0d89\u0dc4\u0dc5 \u0db1\u0db1\u0dcf\u0dc0\u0dd3\u0db8\n\n\u0dc3\u0db3\u0dc4\u0dcf \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0d89\u0dba\u0dca \u0dd4 \u0db1\u0dbb\u0dd4\u0dad\u0dca\u0dcf\u0dcf\u0db4\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dca \u0dc0\u0db1\u0dba\u0dc3\u0da7\u0dc4\u0dca\u0da7 \u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8.\n\n\uf0b7 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0dc0\u0d9c\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0 \u0dba \u0d9a\u0dbb\u0db1 \u0dc1\u0db4\u0dca\u0dc1\u0dc4\u0dca\u0dbb\n\n\u0dc1 \u0d87\u0db8 \u0daf\u0dd2\u0dd2\u0db1\u0d9c\u0dca\u0da7\u0dc0\u0dd4\u0dc0 \u0dc0\u0dc3\u0dca \"\u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0d89\u0dba\u0db8\u0da7 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0dc1\u0db4\u0dca\u0dc1\u0dc4\u0dca\u0dbb\" \u0dc1 \u0d87\u0dc1\u0dca \u0dc3\u0dc4\u0db1\u0dcf\u0dcf\u0dcf\u0dbb \u0dc0\u0db1\u0dba\u0dc3\u0da7\u0dc4\u0dca\u0da7 \u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8.\n\n\uf0b7 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0dc0\u0d9c\u0dcf\u0dc0 \u0dc3\u0db8\u0d87 \u0d9c\u0dc0 \u0db4\u0dcf\u0db0\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dd2\u0dba\u0dad\n\n\u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dca \u0d85\u0dbb\u0db8\u0dd4\u0dab\u0dd2\u0dca\u0da7 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0d89\u0dba\u0dc1\u0dca \u0d9c\u0dc0 \u0d9c\u0dcf\u0dc0\u0dbd \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dca \u0dc0\u0db1\u0dba\u0dc3\u0da7\u0dc4\u0db1 \u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8.\n\n\uf0b7 \u0db4\u0dc0\u0dad\u0dca\u0db1\u0dcf \u0dc1\u0dc1 \u0d9c\u0dd4\u0dab\u0dd2\u0d9a \u0dd2\u0dbb\u0db4\u0dbb\u0dca \u0dcf\u0dc3 \u0dc4\u0db8\u0dd4\u0dc1\u0d9a \u0db4\u0dcf\u0dcf\u0dc1\u0dd4\n\n\u0da2\u0db0 \u0dc3\u0dcf\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dca \u0d85\u0dbb\u0db8\u0dd4\u0dab \u0dc1\u0db4\u0dbb\u0db1\u0db1\u0dd2\u0db1 \u0d9a\u0dbb\u0dc1\u0d9c\u0db1 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0d89\u0dba\u0dc1\u0dca \u0dc0\u0db1\u0dd2\u0daf \u0da2\u0db0 \u0dc3\u0dcf\u0dbb\u0d9a\u0dca\u0dc2\u0dab / \u0dc1\u0dad\u0dad\u0db8\u0db1 \u0dc3\u0dcf\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0dc0\u0db1\u0dba\u0dc3\u0da7\u0dc4\u0db1/ \u0da2\u0db0 \u0dc3\u0dca \u0db4\u0dcf\u0db1\u0db1 \u0dc0\u0db1\u0dba\u0dc3\u0da7\u0dc4\u0dca\u0da7 \u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8.\n\n\uf0b7 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0dc0\u0d9c\u0dcf\u0dc0\u0da7 \u0dc4\u0dcf\u0dd2\u0dbd \u0d9a\u0dbb\u0dd4\u0dc0 \u0db0\u0db6\u0db1 \u0d9a\u0dd8\u0db8\u0dd2\n\n\u0db4\u0dc5\u0dd2\u0dc1\u0db6\u0ddd\u0dcf\u0d9a \u0dca\u0da7 \u0db4\u0dcf\u0db0\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0d89\u0dba\u0dca \u0dc0\u0db0 \u0d9a\u0dd8\u0db8\u0dd2 \u0db4\u0dc5\u0dd2\u0dc1\u0db6\u0ddd\u0dcf \u0db8\u0dbb\u0dca\u0db1\u0db1 \u0dc0\u0db1\u0dba\u0dc3\u0da7\u0dc4\u0db1 \u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8.\n\n\uf0b7 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0dc0\u0d9c\u0dcf \u0db7\u0dd6\u0db8\u0dd2\u0dc1 \u0dca\u0da7 \u0d8b\u0db4\u0dd2\u0db1\u0db8 \u0dc0\u0d9c\u0dcf \u0db5\u0db0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dcf\u0dc0 \u0d9a\u0dca \u0db0\u0db6\u0dcf \u0d9c\u0db1\u0dd3\u0db8\u0db8\u0da7\u0dad\u0dca, \u0db4\u0dc3\u0da7 \u0db1\u0db1\u0dca\u0dbb\u0da2\u0dca\u0da7 \u0db0\u0db6\u0dcf \u0d87\u0dc1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db7\u0dc0 \u0d9a\u0dca \u0dc1\u0db0\u0dc3\u0dad\u0dca \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0d89\u0dba\u0dc1\u0dca \u0dda\u0dd2\u0dba\u0dd2\u0db1\u0dc3\u0dd3 \u0dcf \u0dc0\u0d9c\u0dcf \u0dc3\u0dc4\u0db1\u0dcf\u0dcf\u0dcf\u0dbb \u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8.\n\n* \u0d9a\u0db4\u0dca\u0dbb\u0dd4\u0d9a \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd \u0dc1\u0db8\u0db8\u0dd2\u0db1\u0dca\u0da7 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0dca\u0da7\u0dad\u0dc1\u0db1 \u0dc3\u0dc4 \u0dc0\u0d9c\u0dcf \u0d89\u0dba\u0dca \u0dc0\u0db0 \u0db5\u0db0\u0db1\u0dcf\u0dba\u0dd3\u0dad\u0dcf\u0dc0 \u0dc0\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d9a\u0dca\u0dc2\u0dd4\u0daf\u0dca\u200d\u0dbb \u0dbd\u0dcf\u0db0\u0dba \u0dab \u0db4\u0dc4\u0dd4\u0daf\u0d9a\u0dca \u0dc3\u0db4 \u0dd4\u0dc0 \u0db0\u0db6\u0db1\u0dca.\n\n* \u0d9c\u0db4\u0ddc\u0dbd\u0dca \u0db4\u0dbb\u0dca\u0d9c\u0dda\u0dc2 \u0d86\u0dba\u0dad\u0db1\u0dba\n\n\uf0b7 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0d9a\u0dca\u0dc1\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb \u0da7 \u0d85\u0db1\u0dcf\u0dc5\u0dc0, \u0dc1\u0dbb\u0ddd\u0d9c/ \u0db4\u0dc5\u0dd2\u0dc1\u0db6\u0ddd\u0dcf\n\n\u0db4\u0dcf\u0db0\u0db1 , \u0db1\u0dc0 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dc1\u0daf\u0db1 \u0dc4\u0db3\u0dd4\u0dca\u0da7\u0dc0\u0dcf \u0d87\u0db8, \u0db4\u0da7\u0d9a \u0dc1\u0dbb\u0ddd\u0db4\u0dd2\u0dad \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0db4\u0db1\u0dc5 \u0dd2\u0dbd\u0db4\u0db1\u0dc0\u0dd3\u0db8, \u0d9a\u0dcf\u0db0\u0d9c\u0dd4\u0dab\u0dd2\u0d9a \u0dd2\u0dbb\u0db4\u0dbb\u0dca \u0dcf\u0dc3\u0dc0\u0db0\u0da7 \u0dc0\u0dc1\u0dbb\u0dca\u0dad\u0dca\u0dad\u0dd4 \u0d87\u0db8\u0da7 \u0daf\u0dcf\u0db1\u0dcf\u0db1\u0dca \u0dc0\u0dd3\u0db8, \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0d86\u0dca\u200d\u0dbb\u0dd2\u0dad \u0d85\u0d9c \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dc5 \u0dd2\u0dbd\u0dc2\u0dca\u0db4\u0dcf\u0db1\u0db1 \u0d86 \u0d87 \u0dd2\u0dbb\u0dc2 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dc0\u0dc3\u0dca\u0dc1\u0dc3\u0dda \u0db4\u0dbb\u0dca\u0dc1\u0db1\u0dc2\u0dab \u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8.\n\n\uf0b7 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0d9a\u0dca\u0dc1\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb \u0da7 \u0d85\u0db1\u0dcf\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0dc3\u0dca \u0db4\u0dcf\u0db1\u0db1\n\n\u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dca \u0d87 \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0 \u0dba \u0dc0\u0db1 \u0dd2\u0dbd\u0dbb\u0dca\u0dc1\u0dc1 \u0dc4\u0dcf \u0dd2\u0dbb\u0dc1 \u0dda\u0dc2\u0da5 \u0db1\u0db1\u0dd4\u0dc0\u0db8 \u0db0\u0db6\u0dcf \u0d87\u0db8.\n\n\uf0b7 \u0d8b\u0dc3\u0dc3\u0dca \u0d9c\u0dd4\u0dab\u0dcf\u0dad\u0dca\u0db8\u0dc1 \u0dca\u0da7 \u0dd4\u0dad\u0dad\u0dd4 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0db4\u0db1\u0dc5\n\n\u0dc0\u0d9c\u0dcf\u0d9a\u0dbb\u0dd4\u0dc0\u0dcf \u0dc1\u0dc0\u0dad \u0db0\u0db6\u0dcf \u0d87\u0dc1\u0dca \u0d85\u0dbb\u0db8\u0dd4\u0dab\u0dd2\u0dca\u0da7 \u0db1\u0dc0\n\n\u0db6\u0dd3\u0da2 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0d8b \u0dca\u0da7 \u0dd4\u0dad\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0db6\u0dd3\u0da2 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0db4\u0db1\u0dc5 \u0dc3\u0dc4\u0dad\u0dd2\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0db1\u0dd2\u0dbd \u0dc3\u0dcf\u0dc0\u0dbb\u0dca\u0dcf\u0db1 \u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8.\n\n\uf0b7 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0dc0\u0d9c\u0dcf\u0dc0 \u0dc3\u0dc4 \u0db5\u0db0\u0db1\u0dcf\u0dc0 \u0dc3\u0dca \u0db6\u0dca\u0da7\u0dcf \u0dd2\u0dbb \u0dca\u0dc1\u0dc0\u0dbd\u0dc2\u0dab \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf, \u0dd4 \u0dc4\u0dd4\u0dab\u0dd4 \u0dc0\u0db1\u0dba\u0dc3\u0da7\u0dc4\u0dca\u0da7 \u0db4\u0db1\u0dc0\u0db1\u0dad\u0dca\u0dc0\u0dd3\u0db8.\n\n\uf0b7 \u0dc1\u0db4\u0dca\u0dc0\u0dbd \u0dc0\u0d9c\u0dcf\u0dc0 \u0dc4\u0dcf \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0dca\u0da7\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db1\u0dc0 \u0db1\u0dc0"
  },
