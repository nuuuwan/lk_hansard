200d \u0d9a\u0dca\u0dad \u0d85\n\n\u0dc0\u0dba\u0dcf\u0db4\u0dd8 \u0d85 [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 11] ]\n\n\u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0\u0dd0\u0db4\u0dca \u0dc3 \u0dc3\u0dc3 \u0dc3\u0db8\u0dcf\u0da2 \u0d9a\u0dbb\u0dc2\u0dab\u0dc2\u0d85 \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0d9c \u0d9c\u0dd0 :\n\n\u0dc3\u0dae\u0dc0\u0dc1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dbb\u0dcf\u0da2\u0dba \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0d9a \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf \u0dba\n\n[\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 1159]\n\n\u0dc0\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0daf:\n\n2024.02.28 \u0dc0\u0db1 \u0dd2\u0dbb\u0db1 \"\u0dc1\u0dda\u0dbd\u0dd2 \u0db8\u0dd2\u0dbb\u0dbb\u0dca\" \u0dc3\u0dc4 \"\u0dc3\u0dd2\u0dc1\u0dbd\u0dca\u200d\u0ddd\u0db1\u0dca \u0dc0\u0dba\u0dbb\u0dca\n\n\u0db1\u0dd2\u0db1\u0dc3\u0dae\" \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dd8\u0dad\u0dca \u0d85 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 1111]\n\n\u0d86\u0da0\u0dcf\u0dbb \u0db0\u0dbb\u0dca\u0db8 \u0dc3\u0dc4 \u0dc0\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0daf \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0db8\u0dd2\u0db4\u0dc1\u0db1 \u0dad\u0dd3\u0dbb\u0dab\u0dba\n\n\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dad\u0dc2\u0d9a \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dd0\u0d82 \u0dc1\u0dda \u0db8\u0dcf\u0db0\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf \u0d9a\u0dc0\u0dbb\u0dba\u0dcf \"\u0dc3 \u0d85 \u0d85\u0d9c \u0d85\u0dbb\u0dd4\u0dab\" \u0dd4\u0dc0\u0dc0\u0dad\u0dca \u0db4\u0dad\u0da7 \u0dba \u0dc0\u0dd6 \u0dbd\u0dd2\u0db4\u0dd2\u0dba\n\n[\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 1113]\n\n\u0d85\u0db1\u0dca\u0dad\u0dbb\u0dca\u0dad\u0d9c\u0dad \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dcf\u0db1 \u0d9a\u0dbb\u0dd4\u0dd4\n\n\u0dad\u0dbb\u0dc0\u0db4\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8: \u0d9c\u0dbb\u0dd4 \u0d85\u0dbd\u0dd2 \u0dc3\u0db6\u0dca\u0dbb\u0dd2 \u0dbb\u0dc4\u0dd3\u0db8\u0dca \u0db8\u0dc3\u0dad\u0dcf [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 1117]\n\n\u0d9a\u0da0\u0dcf\u0dbb \u0d9c\u0dbb\u0dca\u0dad\u0db8 \u0dc3\u0dc3 \u0dc0\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0daf \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0db1\u0dd2\u0dbb\u0dca\u0dad\u0dc0\u0daf\u0dca\n\n\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0d9a\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 1118]\n\n\u0dc3\u0dd4\u0dbb\u0dc2\u0dab\u0dd2\u0dad\u0dbd\u0db8\u0d9a \u0d9c\u0db1\u0dd4\u0dc0\u0daf\u0db1\u0dd4 \u0db4\u0db1\u0db8\u0d9a \u0dc0\u0d9a\u0db4\u0dca\u0db8\u0dca\u0db4\u0dad:\n\n\u0dc1\u0daf\u0dc0\u0db1 \u0dc0\u0dbb \u0dc3\u0dc4 \u0dad\u0dd4\u0db1\u0dca\u0dc0\u0db1 \u0dc0\u0dbb \u0d9a\u0dd2\u0dba\u0dc0\u0dcf \u0dc3\u0dd0\u0d82\u0dc1 \u0ddd\u0db0\u0dd2\u0dad\u0dcf\u0d9a\u0dcf\u0dbb\u0dc1\u0dba\u0db1\u0dca"
