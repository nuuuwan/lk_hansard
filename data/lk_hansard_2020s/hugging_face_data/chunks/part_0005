dda\u0db1\u0dd2 \u0dad\u0dd2\u0dc1\u0db6) \u0dc3\u0da2\u0dca\u200d\u0db6\u0dca \u0daf\u0dd2 \u0dd2\u0dc0 \u0da7\u0dba\u0d9c\u0db1\u0dca)1\u0dd2. \u0d89\u0dad\u0dd2\u0db1\u0dca \u0dca\u0da7 \u0d92 \u0d9c\u0dd0) \u0da7)\u0d9c\u0dd2\u0dd4\u0db8\u0dba\u0dd2.\n\n1673 1674\n\n\u0dd3\u0d9c\u0dc0 \u0db1\u0dd3\u0dad\u0dd2\u0dc0 (\u0d86\u0dca\u0dd2\u0dbb\u0dca \u0dc3\u0dd4\u0dc3\u0dd2\u0dbd\u0dca \u0dc1\u0db4\u0dca\u200d\u0dbb\u0dda\u0dca\u0da2\u0dca\u200d \u0db1\u0dca\u0dad \u0dca\u0dc4\u0dba\u0dad\u0dd2\n\n2024 \u0dca\u0dd2\u0dbb\u0dca\u0dd4, 20\n\n\u0d9c\u0dd4\u0dab \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0b95\u0bb2\u0b95\u0bae\u0ba4\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0d9c\u0dc0 \u0d87\u0dca\u0dad\u0dd2\u0dd4,\u0dca\u0db1\u0dd2 \u0da7\u0dd2\u0db1 \u0d851\u0dc3\u0dd2)\u0dba\u0dd2. \u0d9c\u0dd4\u0dab \u0db1\u0dd3\u0dad\u0dd2\u0dc0\u0da5 \u0dc3\u0d86\u0da0\u0dcf\u0dbb\u0dca\u0dba \u0dc3\u0dd4\u0dc3\u0dd2\u0dbd\u0dca \u0dc0\u0db4\u0dca\u200d\u0dbb\u0dda\u0db8\u0da2\u0dba\u0db1\u0dca\u0dad \u0db8\u0dc3\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bb0\u0ba3\u0bbf (\u0b95\u0bb2\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf) \u0b9a\u0bc1\u0b9a\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0b95\u0bb0\u0bae\u0b9c\u0baf\u0ba8\u0bcd\u0ba4) (The Hon. (Dr.) Susil Premajayantha, Attorney-at-Law) \u0dc1\u0dca\u0ddc\u0da7\u0daf [\u0dad\u0dd2\u0dca\u0dca \u0dd2\u0db0\u0db4 [\u0dc2\u0dca\u0da8 [ \u0dad\u0dd2\u0dc1\u0db6)1\u0dd2\u0da7 \u0d85\u0db4\u0dd2 \u0da7\u0dd0\u0dca\u0dd0\u0dad\u0dd2\u0dba\u0dd2. \u0d89\u0daf\u0dd2\u0dd2\u0db4 \u0da7\u0dd2\u0db1\u0dc1\u0dda\u0dd3 \u0d92\u0da7 \u0dc11)\u0dc3\u0dcf \u0dc11\u0db1\u0dca) \u0db4\u0dd4\u0dc5\u0dd41\u0db1\u0dca \u0dc1\u0db1\u0dca\u0daf \u0d85\u0db1\u0dd4\u0dba \u0daf\u0dd2\u0dc3\u0dd2)\u0dd2 \u0da7 \u0dca\u0dd0\u0dad\u0dd2\u0dd4,\u0dca\u0db1\u0dd2? \u0d89\u0dad\u0dd2\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0d92 \u0dc3\u0db3\u0dc4\u0dba\u0dd2 \u0dc3\u0dd4\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0dca\u0dcf)\u0dd2 \u0da7\u0dba)1\u0dd2. \u0dd3\u0db6\u0dd2\u0db1\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dca [ \u0d94\u0db6\u0dd4,\u0dca\u0db1\u0dca\u0db1\u0dd2\u0da7 \u0dc1)\u0ddc\u0dc11\u0dba\u0dd2 \u0d91\u0dd4,\u0dca\u0dd2\u0da7.\n\n\u0d9c\u0dd4\u0dab \u0db1\u0dd3\u0dad\u0dd2\u0dc0\u0da5 \u0dbd\u0d9a\u0dca\u0dc2\u0db1\u0db8\u0db1\u0dca \u0dbb\u0dd3\u0dd2\u0db8\u0d87\u0dbd\u0dca\u0dbd \u0db8\u0dc3\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bb0\u0ba3\u0bbf \u0bb2\u0b95\u0bcd\u0bb7\u0bcd\u0bae\u0ba9\u0bcd \u0b95\u0bbf\u0bbe\u0bbf\u0b8e\u0bb2\u0bcd\u0bb2) (The Hon. Lakshman Kiriella, Attorney-at-Law) Sir, I rise to a point of Order.\n\nSir, this is for the purpose of record. \u0d85\u0dc1\u0db4\u0dca \u0dc1 \u0ddd\u0da2\u0dca\u200d)\u0dd2\u0dc1\u0dda \u0d9a\u0dd2\u0dc3\u0dd2\u0dca 1\u0dd0\u0dbb\u0dd0\u0dc1\u0daf [ )\u0dd0\u0dc4\u0dba\u0dd0. \u0db1\u0dd3\u0dad\u0dd2\u0dc0 \u0dca\u0dc4\u0dba\u0dca 1\u0dc0 \u0d9c\u0da7)\u0dd21 [ \u0db6\u0db1\u0db1\u0dd2 \u0dad\u0dca\u0dba\u0dd2 \u0dc1\u0dca\u0db4\u0da7 \u0dc4\u0dba\u0dd0\u0daf\u0dd4\u0dc1\u0dda. \u0d92\u0dc1 [ \u0d9a\u0dd2\u0dc3\u0dd2\u0dca 1\u0dd0\u0dbb\u0dd0\u0dc1\u0daf [ )\u0dd0\u0dc4\u0dba\u0dd0."
