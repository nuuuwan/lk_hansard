\u0dd2\u0db0 \u0dcf1\u0dd2\u0dc3 [ \u0dad\u0dd2\u0dc1\u0db6)1\u0dd2 \u0d9a\u0dd2\u0dda1\u0dd2. \u0d92 \u0dd2\u0db0 \u0dcf1\u0dd2\u0dc3 \u0dad\u0dd2 \u0db4\u0dd4 \u0dc1\u0da7\u0dc1\u0dc4\u0dba\u0dc5\u0dd2 \u0dba\u0dbb [1\u0dd0\u0dbd\u0dca\u0db1 \u0d85\u0daf \u0d89\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0da7\u0ddc\u0dad\u0dd0)\u0daf \u0d9a\u0dd2 ) \u0d91\u0da7 \u0d9c\u0dd0) \u0d91\u0dd4,\u0dca\u0db1\u0dca\u0db1\u0dd2\u0dc1 \u0dc4\u0dba\u0dd2\u0daf \u0dc3\u0dd2 [\u0dc2\u0dd2 \u0da7 \u0da7\u0dcf\u0dd2 \u0da7\u0dba\u0db1\u0dd2 \u0d85\u0dc4\u0dba\u0db1\u0dd2 \u0db6\u0db1\u0db1\u0dca) \u0d9a\u0dd2 \u0db1\u0dd2 \u0dca\u0dca \u0dc1\u0dca\u0db4 \u0dc11\u0db1\u0dd2\u0dc1\u0dda \u0dca\u0dad [ \u0da7\u0dba)1\u0dd2. \u0dc1\u0dca\u0db4 \u0dc1 \u0ddd\u0da2\u0dca\u200d)\u0dd21 \u0db4\u0dd4\u0dc3\u0dcf \u0dc11\u0dd2 \u0dbd\u0dca\u0db1 [ \u0dc0\u0dd4\u0da7\u0dca \u0d91) \u0dca\u0dd0\u0dad\u0dd21\u0dba\u0da7 \u0da7\u0dd3 \u0da2\u0dca\u200d)\u0dad\u0dd21\u0dc1 \u0dd2\u0db0 \u0dcf1\u0dd2\u0dc3 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0da7\u0ddc\u0dad\u0dd0)\u0daf \u0d9a\u0dd2 ) \u0d91\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db31 \u0da2\u0dca\u200d)\u0dad\u0dd21 \u0dda\u0dca \u0dad\u0dba \u0dc1\u0daf\u0dba\u0dd2 \u0d9a\u0dd2 ) \u0d91\u0da7 \u0dca\u0dad [ \u0da7\u0dba\u0db8\u0dd2\u0db1\u0dca \u0d851\u0dc3\u0dcf\u0dcf\u0dd21 \u0db1\u0db6\u0dd2 \u0dd3\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db31 \u0d94\u0db6\u0dd4,\u0dca\u0dd2\u0da7 \u0dc3\u0dcf\u0dd4,\u0dad\u0dd21\u0db1\u0dca\u0dad \u0dc11\u0db8\u0dd2\u0db1\u0dca \u0dca\u0dd2 \u0db1\u0dd2\u0dc4\u0dba\u0dac \u0dc11)1\u0dd2 \u0db8\u0dd6\u0db1\u0dd2\u0dc3)\u0dd2\u0dd6\u0db4\u0daa \u0d9c\u0dc0 \u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dd4,\u0dca\u0db1\u0dd2.\n\n1715 1716\n\n\u0db4\u0dd2\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dca\u0db4\u0db1\u0dca\u0dd4,1\n\n\u0d9c\u0dd4\u0dab \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf (\u0bae\u0bbe\u0