    "chunk_text": "\u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 33\u0d9a \u0d9a\u0dcf\u0dbd\u0dca\u200d\u0dba \u0dd2\u0dbb\u0dc4\u0dcf \u0db6 \u0dbd\u0dd4\u0dc0\u0dcf\u0db8 \u0d85\u0db4\u0da7 \u0dc1\u0db4\u0dc1\u0db1\u0db1\u0dc0\u0dcf \u0daf\u0db1\u0dca\u0dd2\u0dbb\u0dba\u0dcf\u0dc0 \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0daf \u0db1\u0dc0\u0dd3\u0db1 \u0dc1\u0dbd\u0dca\u200d\u0ddd\u0d9a\u0dc1\u0dda \u0dc1\u0db1\u0d9c\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0dd2\u0dbb\u0dba\u0dd4\u0dab\u0dd4 \u0dc0\u0db1 \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dca\u200d\u0dcf. \u0d92 \u0dba\u0db1 \u0dc1\u0db1\u0d9c\u0dba\u0da7 \u0d9c\u0dd2\u0dc1\u0dba\u0dcf\u0dad\u0dca \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1 \u0dd2\u0db0\u0db0\u0dd2\u0dba\u0da7 0 9 \u0dc0\u0dbb\u0dca\u0dc2\u0dba \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0dcf\u0da7 \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dc1\u0dbd\u0dca\u200d\u0ddd\u0d9a\u0dc1\u0dda \u0dad\u0dd4\u0db1\u0dca\u0dc0\u0db1 \u0dd2\u0db0 \u0dcf\u0dbd\u0dca\u200d \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0dc1\u0dc0\u0dba\u0dd2 0]0 \u0dc0\u0dbb\u0dca\u0dc2\u0dba \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0dcf\u0da7 \u0d87\u0dc1\u0db8\u0dd2\u0db4\u0d9a\u0dcf\u0dc0\u0dad\u0dca \u0d85\u0db7\u0dd2\u0db7\u0dc0\u0dcf \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0dbd\u0dca\u200d\u0dcf \u0dc1\u0dbd\u0dca\u200d\u0ddd\u0d9a\u0dc1\u0dda \u0dc1\u0daf\u0dc0 \u0db1\u0dd2 \u0dd2\u0db0 \u0dcf\u0dbd\u0dca\u200d \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0dc1\u0dc0\u0dba\u0dd2. \u0d92\u0d9a\u0da7 \u0db6\u0dbd\u0dca\u200d\u0db4\u0dcf \u0d85\u0dc1\u0db6\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0db8 \u0dc1\u0dc4\u0dae\u0dad\u0dd4\u0dc0 \u0dc1\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0dad\u0daf? \u0d91\u0daf\u0dcf \u0dc3\u0dd2\u0da7 -1991\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0- \u0d92 \u0dbb\u0da7 \u0d91\u0d9a\u0dd2\u0dc1\u0db1\u0d9a\u0da7 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dc3\u0dae \u0db4\u0dca\u200d\u0dbb \u0d85\u0db4\u0dad\u0dca \u0d85 \u0db8\u0dad \u0db4\u0daf\u0db1\u0db8\u0dca \u0dc0\u0dd4\u0dab\u0dd4 \u0db4\u0d9a\u0dca\u0dad\u0dc2 \u0dd2\u0db0\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dcf\u0dbd\u0dca\u200d\u0db1\u0dba \u0d9a\u0dc5\u0dcf. \u0dc1\u0d9a\u0dcf\u0dd0\u0d82\u0d9c\u0dca\u200d\u0dbb\u0dc3\u0dae \u0db4\u0d9a\u0dca\u0dad\u0dc2\u0dba \u0db4\u0dcf\u0dbd\u0dca\u200d\u0db1\u0dba \u0d9a\u0dc5\u0dcf \u0dc3\u0db8\u0dc4\u0dbb \u0d85\u0dc0\u0dc3\u0dae\u0dcf\u0dcf\u0dc0\u0dbd\u0dca\u200d\u0daf\u0dd3 \u0dc0\u0dcf\u0db8\u0dcf\u0dd0\u0d82\u0dc1\u0dd2\u0d9a \u0db4\u0d9a\u0dca\u0dad\u0dc2 -\u0dc1 \u0db1 \u0d9c\u0dc0\u0dd4\u0da9\u0dcf \u0dc0 \u0db1\u0dd2 \u0d85\u0dba \u0dc0\u0dd3.\u0db4\u0dd3. \u0dc3\u0dd2\u0dd0\u0d82 \u0dc0 \u0db1\u0dd2 \u0d85\u0dba- \u0d91\u0d9a\u0dad\u0dd4 \u0dc1\u0dc0\u0dbd\u0dca\u200d\u0dcf \u0db4\u0dcf\u0dbd\u0dca\u200d\u0db1\u0dba \u0d9a\u0dc5\u0dcf. \u0dad\u0dc0\u0dad\u0dca \u0d85\u0dc0\u0dc3\u0dae\u0dcf\u0dcf\u0dc0\u0dbd\u0dca\u200d\u0daf\u0dd3 BJP \u0d91\u0d9a \u0db4\u0dcf\u0dbd\u0dca\u200d\u0db1\u0dba \u0d9a\u0dc5\u0dcf. \u0d92 \u0d85\u0dba\u0dc1\u0d9a \u0db4\u0dcf\u0dbd\u0dca\u200d\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dbd\u0dca\u200d \u0dc4\u0dd4\u0dd9\u0d9a\u0dca\u0dad \u0dc1\u0dc0\u0db1\u0dc3\u0dae\u0d9a\u0db8\u0dca \u0d85\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0db1\u0dd4\u0daf\u0dad\u0dca \u0d92 \u0dc4 \u0dc1\u0db8\u0ddd\u0db8 \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb \u0d85\u0db4\u0dad\u0dca \u0d85\u0dc0\u0dbd\u0dca\u200d \u0dc1\u0dc0\u0db1\u0dc3\u0dae\u0d9a\u0db8\u0dca \u0db1 \u0d85\u0dc0 \u0dc1\u0db4\u0dcf\u0daf\u0dd4\u0dc1\u0db1 \u0d91\u0d9a\u0db8 \u0db4\u0dca\u200d\u0dbb \u0d85\u0db4\u0dad\u0dca \u0d85 \u0daf\u0dd3\u0dbb\u0dca\u0d9d \u0d9a\u0dcf\u0dbd\u0dd3\u0db1\u0dc0 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf \u0dc1\u0d9c\u0db1 \u0d9c\u0dd2\u0dba\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0daf \u0dc0\u0db1 \u0dd2\u0db0\u0da7 \u0daf\u0db1\u0dca\u0dd2\u0dbb\u0dba\u0dcf\u0dc0\u0da7 \u0dc1\u0db8\u0dca \u0dd2\u0dbb\u0dba\u0dd4\u0dab\u0dd4\u0dc0 \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1 \u0dc4 \u0d9a\u0dd2 \u0dc1\u0dc0\u0dbd\u0dca\u200d\u0dcf \u0d85\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca.\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dca\u200d\u0dd0\u0d82\u0d9a\u0dcf\u0dc1\u0db1 \u0dc3\u0dd2\u0dd0\u0d82\u0dc4\u0dbd\u0dca\u200d \u0dc1\u0daf\u0db8\u0dc5 \u0dc3\u0dc4 \u0dd4\u0daf\u0dc3\u0dae\u0dbd\u0dd2\u0db8\u0dca \u0da2\u0dcf\u0dad\u0dd3\u0db1\u0dca\u0da7 \u0d85\u0dba\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0d91\u0d9a\u0db8 \u0dbb\u0da7\u0d9a \u0dc0 \u0dc3\u0dd2\u0dc1\u0dba\u0ddd. \u0daf \u0d85\u0db1\u0dca \u0db4\u0dbb\u0dab \u0dc1\u0d9a\u0ddd\u0db1\u0dca\u0dad\u0dbb \u0d85\u0db8\u0dad\u0d9a \u0d9a\u0dbb\u0dbd\u0dca\u200d\u0dcf \u0d91\u0d9a\u0db8 \u0dbb\u0da7\u0d9a \u0dc0 \u0dc3\u0dd2\u0dba\u0db1\u0dca \u0dc4 \u0da7\u0dd2\u0dba\u0da7 \u0d85\u0db4\u0da7\u0dad\u0dca \u0d91\u0d9a\u0da7 \u0da2\u0dd3\u0dc0\u0dad\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0db6 \u0dd2\u0db4 \u0d87\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dae\u0db1\u0dba \u0dc1\u0db8\u0dad \u0db1\u0daf\u0dd3 \u0dd2\u0dbb\u0d9c\u0dd2\u0db1\u0dca \u0dd2\u0dbb\u0d9c\u0da7\u0db8 \u0d85\u0dc1\u0dca \u0dc4\u0dd2\u0dad\u0dca\u0dc0\u0dbd\u0dca\u200d \u0db8\u0dad\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0dc4 \u0db6 \u0dba\u0dd2 \u0d91\u0dc1\u0dc4\u0db8 \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0da7 \u0db1\u0db8\u0dca \u0d85\u0db4 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0dc1\u0daf\u0db1\u0dcf\u0db8 \u0d85\u0dbb \u0dc2\u0dba\u0dd2\u0dc1\u0dbd\u0dca\u200d\u0dcf\u0d9a\u0dca\u0dad \u0dc0\u0dcf\u0dc1\u0d9a \u0db8\u0dc3\u0dae \u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dbd\u0dca\u200d\u0db8 \u0daf\u0dca \u0dbd\u0dca\u200d\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1 \u0dad\u0dd4\u0dc0 \u0dba\u0db8\u0dca \u0dba\u0db8\u0dca \u0dc1 \u0dc0\u0dca \u0d85\u0dad \u0dc4\u0dd2\u0db4\u0db1\u0dca\u0db1\u0dad\u0dca \u0dc3\u0dc4\u0d9a\u0db8\u0dca\u0db4\u0dd2\u0dad\u0dc0 \u0d85\u0db1\u0dd4\u0db1\u0dca \u0d9c \u0db1 \u0d9a\u0dca \u0db4\u0db1\u0dcf \u0d9a\u0dbb \u0db6\u0dbd\u0dca\u200d\u0db1\u0dca\u0db1\u0dad\u0dca \u0dad\u0db8\u0db1\u0dca\u0dc1\u0d9a \u0dc1\u0d9a\u0ddd\u0dab\u0dc1\u0dba\u0db1\u0dca \u0dd2\u0db0\u0dad\u0dbb\u0d9a\u0dca\u0dad \u0db6\u0dbd\u0dca\u200d\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1 \u0dad\u0dd4\u0dc0 \u0daf\u0db1\u0dca\u0db1\u0dad\u0dca \u0d95\u0db1\u0dd1. \u0d92\u0d9a \u0daf\u0dad\u0dcf\u0db8 \u0dc0 \u0daf\u0d9c\u0dad\u0dca. \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1 \u0dd2\u0db0\u0db0\u0dd2\u0dba\u0da7 \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca\u0da7 \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0dc1\u0d9c\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 90\u0d9a\u0dca\u0dad \u0dd2\u0db0\u0dad\u0dbb \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0d9a \u0db4 \u0dc1\u0dc0\u0dbd\u0dca\u200d\u0dcf \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf.\n\n\u0db8\u0db8 \u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dc3\u0dae\u0dcf\u0dcf\u0dc1\u0db1\u0daf\u0dd3 \u0dc1\u0daf\u0db8\u0dc5 \u0db4\u0d9a\u0dca\u0dad\u0dc2\u0dc0\u0dbd\u0dca\u200d \u0db1\u0dcf\u0dba\u0d9a\u0dba\u0db1\u0dca\u0da7 -\u0d85\u0dc1\u0dca \u0dc1\u0dc0\u0db1\u0dc3\u0dae\u0d9a\u0db8\u0dca \u0d85\u0db6\u0dd4\u0dab\u0dad\u0dca- \u0d87\u0dad\u0dca\u0dad \u0dc0 \u0dc1\u0dba\u0db1\u0dca\u0db8 \u0dc3\u0dd4\u0db6 \u0db4\u0dad\u0db1\u0dca\u0db1\u0da7 \u0d95\u0db1\u0dd1. \u0d9c\u0dd2\u0dba\n\n1225 1226\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0"
