da7 \u0da7\u0db8\u0dd2\u0dd4\u0db81 [ \u0da7\u0dd2 )\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dca \u0da7\u0dba) \u0dc1\u0db1\u0dc3 \u0dba\u0da2\u0dca\u200d\u0dc1\u0dda \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0da7\u0dd2\u0dba\u0da7 \u0dc3\u0dcf\u0dd21 \u0db1\u0dd2\u0dbb\u0dca\u0dc1\u0dc1 \u0da7\u0dba\u0dba\u0dd2. \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 1\u0dd2\u0dbb\u0dca\u0dad\u0dd21 \u0dc3\u0dad\u0dd2 ] [ \u0d87\u0dd4,\u0dcf\u0dad \u0dba\u0da2\u0dca\u200d\u0dc1\u0dda \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0da7\u0dd2\u0dba\u0da7 \u0dc3\u0dcf\u0dd21 \u0dc11\u0dad \u0d89\u0daf\u0dd2\u0dd2\u0db4\u0db4\u0dca \u0da7\u0dba) \u0dc1\u0db1\u0dc3\u0dca \u0db1\u0dd0\u0db6\u0dd3 \u0d87\u0dad\u0dd2 \u0da7\u0dc0 \u0dab\u0dd4 \u0dca\u0dad \u0d85\u0dc1)\u0dba\u0ddd)\u0dba1 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dca \u0dd2\u0db0\u0dc3\u0dd4\u0db1\u0dca [ \u0db1\u0dd0\u0dc1\u0db6) \u0dd4,\u0dc0 1\u0dd0\u0dd4\u0db8\u0db4\u0dca 1\u0dd0\u0dd2 \u0dc0\u0dd3\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0db1\u0d82\u0da7\u0dd2 \u0dca\u0dc4\u0dba \u0db6\u0dd0\u0d82 \u0db11 \u0dd2\u0db0\u0dc3\u0dd2\u0db1\u0dca \u0da7\u0dbd\u0dca \u0daf\u0dca) \u0dc1\u0db1\u0dc3\u0dca \u0dba\u0da2\u0dca\u200d\u0dc1\u0dda \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0da7\u0dd2\u0dba\u0da7 \u0dc3\u0dcf\u0dd21 \u0db1\u0dd2\u0dbb\u0dca\u0dc1\u0dc1 \u0da7\u0dba\u0dba\u0dd2.\n\n\u0d91\u0dca \u0da7\u0db8\u0dd2\u0dd4\u0db8\u0dc1\u0dda \u0dc3\u0dd2\u0dca\u0dd2\u0da2\u0dd2\u0da7 \u0db1\u0dca \u0dc1\u0db1\u0dc3 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0db1\u0d82\u0da7\u0dd2 \u0dca\u0dc4\u0dba \u0db6\u0dd0\u0d82 \u0db1\u0dc1\u0dda \u0dc1\u0dca\u0db1\u0dca\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0db1\u0d82\u0da7\u0dd2 \u0dca\u0dc4\u0dba \u0db6\u0dd0\u0d82 \u0db11\u0da7 \u0db4\u0dd2\u0db4\u0db6\u0dd2\u0dc4\u0dd2\u0dba1 \u0dc3\u0dc4\u0dba \u0dba\u0dd2\u0da2\u0dca\u200d\u0dba \u0d85\u0d82 \u0dd4,\u0dcf \u0dc3\u0dc4\u0dba \u0d89\u0db1\u0dca \u0db4\u0dd2\u0da7\u0dad \u0d85 )\u0dca\u0db4 \u0da7\u0dba\u0db1\u0dd4 \u0db1\u0dd0\u0db6\u0dd2 \u0dc4\u0dba\u0dd0\u0da7.\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0db1\u0d82\u0da7\u0dd2 \u0dca\u0dc4\u0dba \u0db6\u0dd0\u0d82 \u0db11\u0da7 \u0d85\u0daf\u0dd2\u0dcf \u0dc1\u0dca\u0db1\u0dca\u0dca \u0dd2\u0db0\u0dc1 \u0dda\u0dc2\u0dd2\u0dad \u0da7\u0dd2\u0dbb\u0dca \u0dca\u0dab\u0dca\u0da9\u0db11\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dd3\u0da7\u0dca 1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd4\u0d9b\u0dca\u200d \u0da7\u0dba \u0dc3\u0dd2 \u0dbd\u0dd4 \u0da7\u0dd2\u0dbb\u0dca \u0dca\u0dab\u0dca\u0da9\u0db1 \u0dc1\u0dbb\u0dda\u0d9a\u0dc01\u0db1 \u0db4\u0dd2\u0dd2\u0db4\u0dbb\u0db8\u0dd2\u0da7 \u0dc3\u0dd2\u0db1\u0dd2\u0dba\u0da7 \u0dc1\u0db1\u0dc3 \u0d9c\u0dd0\u0dcf\u0db4\u0dd4\u0dca\u0db4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0dc1\u0dca\u0dca \u0da7\u0db8\u0dd2\u0dd4\u0db81 \u0dd2\u0db0\u0dc3\u0dd2\u0db1\u0dca \u0da7\u0dba\u0db1\u0dd4 \u0d87\u0dad\u0dd2 \u0db61\u0da7 \u0dba\u0da2\u0dca\u200d\u0dc1\u0dda \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0da7\u0dd2\u0dba\u0da7 \u0dc3\u0dcf\u0dd21 \u0db6\u0db1\u0dd2\u0dc1\u0db4\u0ddc\u0dc1\u0dba\u0ddc\u0dca \u0dd4, \u0dc1\u0dda. 1\u0dd2\u0dca \u0dbb\u0dd4 \u0da7\u0dd2\u0dbb\u0dca \u0dca\u0dab\u0dca\u0da9\u0db1 \u0da7 1\u0dd0\u0dd4\u0db8\u0db4\u0dca \u0dbb\u0dd4\u0dba\u0da7 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dca\u0db4 \u0d9a\u0dca\u200d\u0dbb\u0dca\u0dc1\u0dda\u0daf 1\u0dd2\u0dca \u0dbb\u0dd4 \u0dc1)\u0ddc1) \u0dc3\u0dc4\u0dba \u0dc1\u0dc3\u0dc3\u0dd4 \u0da7\u0dd2\u0dbb\u0dca \u0dca\u0dab\u0dca\u0da9\u0db1\u0dc1 \u0db1\u0dca \u0dc11\u0db1\u0dca \u0da7\u0dcf \u0dd4\u0dad\u0dd4, \u0db61\u0da7 \u0daf\u0dd0\u0dd2 \u0dc1\u0db1\u0dc3 \u0db1\u0dd2\u0dbb\u0dca\u0dc1\u0dc1 \u0dc1\u0da7\u0dc1\u0dbb\u0dca.\n\n\u0d85)\u0dd2\u0d9c\u0dad \u0dc3\u0d82\u0dc1 \u0ddd\u0db1)1\u0db1 \u0dd3 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0db1\u0d82\u0da7\u0dd2 \u0dca\u0dc4\u0dba \u0db6\u0dd0\u0d82 \u0db1 \u0da7\u0dd2\u0dbb\u0dca \u0dca\u0dab\u0dca\u0da9\u0db1 \u0db4\u0dd2\u0dd2\u0db4\u0dbb\u0db8\u0dd2\u0da7 \u0dd2\u0db0\u