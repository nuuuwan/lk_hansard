    "chunk_text": "\u0db8\u0da7 \u0dc1\u0dc4\u0dca\u200d\u0ddc\u0db3\u0da7 \u0db8\u0dad\u0d9a\u0dba\u0dd2 1994\u0daf\u0dd3 \u0db4 \u0dc0\u0dad\u0dd2 \u0db8 \u0dad\u0dd2\u0dc0 \u0dab\u0dc1\u0dba\u0dca - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dca\u200d\u0dd0\u0d82\u0d9a\u0dcf \u0db1\u0dd2\u0dcf\u0dc4\u0dca\u200d\u0dc3\u0dae \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0d85\u0db4\u0dd2 \u0dc0 \u0da9 \u0d9a \u0db4\u0dd4 \u0d9a\u0dcf\u0dbd\u0dca\u200d\u0dc1\u0dda - \u0dad\u0db8\u0dba\u0dd2 \u0d91\u0dd4,\u0db8\u0dcf \u0db4\u0dc5\u0db8\u0dd4\u0dc0 \u0db1\u0dd2 \u0dc0\u0dad\u0dcf\u0dc0\u0da7 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dd4,\u0dc0\u0da7 \u0d86\u0dc1\u0dda. \u0d92 \u0db8 \u0dad\u0dd2\u0dc0 \u0dab\u0dc1\u0dda\u0daf\u0dd3 \u0db8\u0db8 \u0d91\u0dd4,\u0db8\u0dcf\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0d85\u0dc1\u0dda \u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dae\u0db1\u0dd4\u0dc0 \u0d86\u0dc3\u0db1\u0dc1\u0dda \u0dbb\u0dd0\u0dc3\u0dae\u0dc0\u0dd3\u0db8\u0dca \u0d9c\u0dab\u0db1\u0dcf\u0dc0\u0d9a\u0da7 \u0dc3\u0db8\u0dca\u0db6\u0dca \u0db0 \u0dc0\u0dd4\u0dab\u0dcf. \u0db4\u0dac\u0dd4\u0dc0\u0dc3\u0dae\u0db1\u0dd4\u0dc0 \u0d86\u0dc3\u0db1\u0dc1\u0dda \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab\u0dc1\u0dba\u0dca \u0dbb\u0dd0\u0dc3\u0dae\u0dc0\u0dd3\u0db8\u0dca 30\u0d9a\u0da7 \u0d85\u0db0\u0dd2\u0d9a \u0dc3\u0dd0\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0db4 \u0dc0 \u0dca \u0dc0\u0dd6\u0dc0\u0dcf. \u0d91\u0dd4,\u0db8\u0dcf\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0dcf\u0dc0\u0dc3\u0dae \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0d92 \u0dbb\u0dd0\u0dc3\u0dae\u0dc0\u0dd3\u0db8\u0dca\u0dc0\u0dbd\u0dca\u200d\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dca\u200d\u0dcf \u0db8\u0dd4\u0dc5\u0dd4 \u0dcf\u0da0\u0dc3\u0db8 \u0dbb\u0dd0\u0db3\u0dd3 \u0dd2\u0dbb\u0da7\u0dd2\u0db8\u0dd2\u0dca \u0d91\u0dd4,\u0db8\u0dcf\u0da7 \u0d85\u0dc0 \u0dba \u0d9a \u0db1 \u0d9a\u0dca\u0dad\u0dd2\u0dba \u0d85\u0db4\u0dd2 \u0dbd\u0dca\u200d\u0db6\u0dcf \u0daf\u0dd4\u0dca \u0db1\u0dcf. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 1994\u0daf\u0dd3 \u0d91\u0dd4,\u0db8\u0dcf \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dd4,\u0dc0\u0da7 \u0db4 \u0db8\u0dd2\u0dab\u0dd2\u0dba\u0dcf. \u0d91\u0dad \u0db1\u0dd2\u0dca \u0db4\u0dc3\u0dae\u0dc1\u0dc3 \u0db1 \u0dc0\u0dad 2004 \u0d89\u0db3\u0dbd\u0dca\u200d\u0dcf 2010 \u0dc1\u0dc0\u0db1\u0d9a\u0db8\u0dca \u0d91\u0dd4,\u0db8\u0dcf \u0db4\u0dd2\u0db4\u0dc3 \u0dc4\u0dca\u200d\u0dcf \u0dc3\u0dae\u0dc0\u0dcf\u0db7\u0dcf\u0dc0\u0dd2\u0d9a \u0dc3\u0db8\u0dca\u0db4\u0dca \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dc0 \u0dba\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7\u0dca \u0dc0\u0dcf\u0dd2\u0db4\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dc0 \u0dba\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7\u0dca \u0dc3\u0dca \u0dc1\u0dc0\u0ddd\u0dcf\u0dba\u0dcf\u0db1 \u0dc4\u0dca\u200d\u0dcf \u0dda\u0dc1\u0daf \u0dcf \u0dda\u0dcf\u0dba\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d87\u0db8\u0dad\u0dd2\u0dc0 \u0dba\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7\u0dca \u0d9a \u0dd2\u0dba\u0db1\u0da7\u0dca \u0dc1\u0db1\u0ddc\u0dc0\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0 \u0dba\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7\u0dca \u0dc0\u0dd2 \u0dcf\u0dbd\u0dca\u200d \u0dc1\u0dc3 \u0dc0\u0dba\u0d9a\u0dca \u0dd2\u0dbb\u0daf\u0dd4 \u0d9a\u0dc5\u0dcf.\n\n\u0db8\u0dd6\u0dbd\u0dca\u200d\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dd4,\u0db8\u0db1\u0dd2 \u0db8\u0da7 \u0dc1\u0dc4\u0dca\u200d\u0ddc\u0db3\u0da7 \u0db8\u0dad\u0d9a\u0dba\u0dd2 1994\u0daf\u0dd3 \u0da2\u0dd3.\u0d91\u0dbd\u0dca. \u0dd3.\u0dd2\u0db4\u0dc3\u0dae \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d87\u0db8\u0dad\u0dd2\u0dd4,\u0db8\u0dcf\u0dc1\u0d9a \u0dc3\u0db8\u0dca\u0db6\u0dca \u0db0\u0dd3\u0d9a \u0dab \u0dc1\u0dbd\u0dca\u0d9a\u0db8\u0dca\u0dc0 \u0dba\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0db8\u0db8 \u0d91\u0dd4,\u0db8\u0dcf\u0dc1\u0d9a \u0d9a\u0dcf\u0db8 \u0dc1\u0dda \u0d89\u0dca \u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0db6\u0dca \u0daf\u0dd4\u0dbd\u0dca\u200d \u0db6\u0dc3\u0dae\u0db1\u0dcf\u0dba\u0d9a \u0db8 \u0dad\u0dd2\u0dd4,\u0db8\u0dcf CR \u0dc1\u0db4\u0ddc\u0dad\u0d9a\u0dca \u0d85 \u0dc1\u0d9c\u0db1 \u0d91\u0db1 \u0dc4\u0dca\u200d \u0da7\u0dd2. \u0d91\u0dd4,\u0db8\u0dcf\u0da7 \u0dda\u0dcf\u0dc0\u0dd4 \u0d9a \u0db4\u0dd4 \u0d85\u0dba\u0da7 \u0dc3\u0dae\u0dc3\u0dcf \u0dc0\u0dd4\u0dc0\u0db8\u0db1\u0dcf \u0db1\u0db8\u0dca \u0d92 CR \u0dc1\u0db4\u0ddc\u0dc1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d91\u0dd4,\u0db8\u0dcf \u0dbd\u0dd2\u0dba\u0dcf\u0dc1\u0d9c\u0db1 \u0d91\u0dca \u0dc1\u0dca . \u0d92 \u0d9a\u0dcf\u0dbd\u0dca\u200d\u0dc1\u0dda \u0d91\u0dc1\u0dc4\u0dca\u200d\u0db8\u0dba\u0dd2 \u0dc0 \u0da9 \u0d9a\u0dc1\u0dc5 .\n\n\u0dc1\u0dcf\u0dc1\u0dcf\u0dc1\u0db1\u0d9a\u0dd4\u0dc1\u0d9a \u0dd4,\u0dca \u0dc1\u0dcf\u0dc1\u0db1\u0d9a\u0dd4\u0dc1\u0d9a \u0dc0\u0dd2\u0dc3\u0dae\u0dad \u0d85\u0db4\u0dd2 \u0d89\u0dbd\u0dca\u0dbd\u0dd4\u0dc0\u0dcf\u0db8 \u0d85 CR \u0dc1\u0db4\u0ddc\u0dc1\u0dca \u0dc1\u0d9a\u0ddc\u0dc1\u0dc5 \u0d9a\u0da9\u0dbd\u0dca\u200d\u0dcf \u0dc1\u0db4\u0ddc\u0da9\u0dd2 \u0d85\u0dca \u0dc3\u0db1\u0d9a\u0dd4\u0dca \u0d9c\u0dc4\u0dca\u200d\u0dbd\u0dca\u200d\u0dcf \u0d85\u0db4\u0da7 \u0dbd\u0dd2\u0dba\u0dcf \u0dc1\u0dcf\u0db1\u0dc0\u0dcf \u0dc1\u0db8\u0dca\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0db8\u0dc1\u0d9a \u0dc1\u0dba\u0ddd\u0da2\u0db1\u0dcf\u0dc0 \u0d9a\u0dd2\u0dba\u0dbd\u0dca\u200d\u0dcf. \u0d92 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dad\u0db8\u0dba\u0dd2 \u0d91\u0dd4,\u0db8\u0dcf \u0dc0 \u0da9 \u0d9a \u0dc1\u0dc5 . \u0d91\u0dd4,\u0db8\u0dcf \u0dc5\u0d9f CR \u0dc1\u0db4\u0ddc\u0dad\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf. \u0d92 \u0dc1\u0db4\u0ddc\u0dc1\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0dc1\u0d9c\u0db1 \u0d86\u0dc0\u0dcf \u0d91\u0dd4,\u0db8\u0dcf\u0da7 \u0dda\u0dcf\u0dc0\u0dd4 \u0d9a\u0dc5 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0dbd\u0dca\u200d\u0db6\u0dcf \u0daf\u0dd2\u0dba \u0dd4\u0dad\u0dd4, \u0dd2\u0dbb\u0dba\u0dbd\u0dd4\u0dc1\u0dcf\u0db1\u0dcf\u0dc1\u0d9a\u0db8 \u0dc0\u0dd2\u0dc3\u0dae\u0dad \u0da7\u0dd2\u0d9a. \u0d92 \u0d9a\u0dcf\u0dbd\u0dca\u200d\u0dc1\u0dda \u0dc3\u0db8\u0dcf\u0dcf\u0dcf\u0db1 \u0dc0\u0dd2\u0db1\u0dd2 \u0dae\u0da0\u0dba\u0d9a\u0dcf \u0dad\u0db1\u0dd4,\u0dbb\u0dd4 \u0d85\u0db4\u0dd2 \u0db4\u0dd2\u0dd2\u0db4\u0db1 \u0db8\u0dd4\u0dc0\u0dcf. \u0d92 \u0dc4\u0dca\u200d \u0db8 \u0dc1\u0dcf\u0dba\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0dca \u0db8 \u0dda\u0dc1\u0dc1 \u0d89\u0db3\u0dca \u0dc4\u0dca\u200d\u0dc0\u0dc3\u0dae \u0dc1\u0dc0\u0db1\u0d9a\u0dbd\u0dca\u0db8 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dd0\u0d82 \u0dc0\u0dbd\u0dca\u200d\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dca\u200d\u0dcf \u0d9a\u0da7\u0dd4\u0dad\u0dd4, \u0d9a \u0db8\u0dd2\u0dca \u0dad\u0db8\u0dca \u0dc1\u0d9a \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0dca \u0dc0\u0dd2 \u0dcf\u0dbd\u0dca\u200d \u0d9a \u0db4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dca \u0d9a \u0db4\u0dd4 \u0db1\u0dcf\u0dba\u0d9a\u0dc1\u0dba\u0d9a\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0db6\u0dca \u0daf\u0dd4\u0dbd\u0dca\u200d \u0db6\u0dc3\u0dae\u0db1\u0dcf\u0dba\u0d9a \u0db8 \u0dad\u0dd2\u0dd4,\u0db8\u0dcf.\n\n\u0dc0\u0dd2\u0dc1 \u0dc2\u0dc1\u0dba\u0dca \u0db8 \u0db8\u0db8 \u0dc0\u0dba\u0db9 \u0db4\u0dc5\u0dcf\u0dc1\u0dca \u0db8\u0dc4\u0dca\u200d \u0d87\u0db8\u0dad\u0dd2\u0dc0 \u0dba\u0dcf \u0dc4\u0dca\u200d \u0da7\u0dd2\u0dba\u0da7 \u0d9a\u0da7\u0dd4\u0dad\u0dd4, \u0d9a\u0dc5 \u0d9a\u0dcf\u0dbd\u0dca\u200d\u0dc1\u0dda \u0d91\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dc1 \u0dc1\u0dda \u0db4\u0dcf \u0dc0\u0dbd\u0dca \u0dc3\u0dd0\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca\u0daf\u0dd3 \u0d91\u0dd4,\u0db8\u0dcf \u0db8\u0da7 \u0dc0\u0dd2 \u0dcf\u0dbd\u0dca\u200d \u0dc4\u0dca\u200d\u0dba\u0dd2\u0dba\u0d9a\u0dca - \u0d9a\u0dca\u0dad\u0dd2\u0dba\u0d9a\u0dca- \u0dbd\u0dca\u200d\u0db6\u0dcf \u0daf\u0dd4\u0dca \u0db1\u0dcf. \u0dad\u0dcf \u0dcf\u0db1\u0dcf\u0dca \u0db6\u0dc3\u0dae\u0db1\u0dcf\u0dba\u0d9a \u0db8 \u0dad\u0dd2\u0dd4,\u0db8\u0dcf\u0dca \u0d91\u0dd4,\u0db8\u0dcf\u0dc1\u0d9a \u0d86\u0dcf \u0dab\u0dd3\u0dba \u0db4\u0dd4\u0dad\u0dca\u200d\u0dbb \u0dca \u0db1\u0dba\u0d9a\u0dca. \u0d92 \u0dc0\u0dcf\u0dc1\u0d9a\u0db8 \u0d85\u0da0\u0dbd\u0dca\u200d \u0db8\u0dbd\u0dca\u0dbd\u0dd2 \u0d87\u0dd4,\u0dc5\u0dd4 \u0d92 \u0dd2\u0dbb\u0dba\u0dbd\u0dd4\u0dc1\u0dcf\u0db1\u0dcf\u0db8 \u0db8\u0da7 \u0dc0\u0dd2 \u0dcf\u0dbd\u0dca\u200d \u0d9a\u0dca\u0dad\u0dd2\u0dba\u0d9a\u0dca"
  },
