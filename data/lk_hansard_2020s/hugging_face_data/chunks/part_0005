    "chunk_text": "\u0daf\u0dda \u0dd2\u0dd9\u0dc3\u0dca\u0dae\u0dcf\u0daf\u0dda \u0daf\u0dd3\u0db4 \u0dc3\u0dd2\u0daf\u0dc1\u0dca\u0dc2 \u0daf\u0dba\u0db1\u0dca\u0db8 \u0d9a\u0dd2\u0dd9 \u0dba\u0dd4\u0dad\u0dd4 \u0daf\u0daf\u0dba\u0dda \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf. \u0daf\u0dda \u0dd9\u0db1\u0daf\u0dd9\u0dcf\u0da7 \u0d9c\u0dbd\u0daf\u0d9c\u0dcf\u0da9 \u0dd2\u0dad\u0dca\u0daf\u0dad\u0dca \u0da5\u0dcf\u0db1\u0dc3\u0dcf\u0dbb \u0dc4\u0dcf\u0db8\u0dd4\u0daf\u0dd4\u0dbb\u0dd4\u0daf\u0dd9\u0ddd \u0d89\u0db1\u0dca\u0daf\u0db1\u0dca \u0db1\u0dca\u0dbb\u0d9c\u0dad \u0daf\u0dd9\u0dbd\u0dcf. \u0d8b\u0db1\u0dca\u0dd9\u0dc4\u0db1\u0dca\u0daf\u0dc3\u0dca \u0d86\u0dbb\u0dda\u0dc2 \u0dcf \u0dd9\u0dbb\u0db1\u0dca\u0db1\u0da7 \u0db8\u0dcf \u0daf\u0db8\u0dba \u0dd2\u0dd9\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0dda \u0dd9\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dd9\u0dcf \u0daf\u0db1\u0dcf\u0daf\u0dd9\u0db1\u0dca. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dd9\u0dc0\u0dd4\u0dbb\u0dd4\u0dd9\u0dad\u0dca \u0daf\u0db1\u0dcf\u0daf\u0d9a\u0dd2\u0db1 \u0daf\u0dda \u0dd2\u0dd9\u0dc3\u0dca\u0dae\u0dcf\u0daf\u0dda \u0db1\u0dd2\u0dc4\u0dac\u0dd9 \u0dad\u0dd2\u0daf\u0dd9\u0db1 \u0dc3\u0db8\u0dcf\u0da2\u0dba \u0dad\u0dd4 \u0daf\u0dda \u0dd9\u0dcf\u0dbb\u0dab\u0dba \u0db4\u0dd2\u0dd2\u0db6\u0dd9\u0db3 \u0dba\u0dda \u0d9a\u0dd2\u0db1\u0dca \u0dd2\u0dd9\u0daf\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dd2\u0dd9\u0dc1\u0dba\u0db1\u0dca. \u0db8\u0dd4\u0d9a\u0dba\u0db6\u0dd4\u0dbb\u0dca\u0dbd \u0dbb\u0dc4\u0dd4\u0db8\u0dcf\u0db1\u0dca \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dca \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d86\u0dab\u0dca\u0dd4\u0dd9\u0dcf\u0dbb \u0dd2\u0dc3\u0dcf\u0dda \u0dc3\u0dcf\u0dd2 \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dca \u0d9c\u0dbd\u0daf\u0d9c\u0dcf\u0da9 \u0dd2\u0dad\u0dca\u0daf\u0dad\u0dca \u0da5\u0dcf\u0db1\u0dc3\u0dcf\u0dbb \u0dc4\u0dcf\u0db8\u0dd4\u0daf\u0dd4\u0dbb\u0dd4\u0dd9\u0db1\u0dca\u0da7 \u0dc3\u0dd2\u0dbb\u0dd4\u0dda\u0db1\u0dd9 \u0db1\u0dd4\u0dd9 \u0daf\u0dcf\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1 \u0dd9\u0dd9 \u0dd2\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dd9\u0dcf. \u0d91\u0db8 \u0db1\u0dca\u0dda\u0db0\u0dd2\u0dba\u0da7 \u0dd2\u0daf\u0dcf \u0daf\u0dc4\u0dca\u0dad\u0dd4\u0dd9 \u0dad\u0db8\u0db1\u0dca 2 16\u0daf\u0dd3\u0db4 \u0dd6\u0dbd\u0dbb\u0d9c\u0dbd \u0db4\u0dd4\u0daf \u0db6\u0dd2\u0db8 \u0dc3\u0dda\u0dd9\u0db1\u0dca\u0db1\u0daf\u0dba\u0db1\u0dca \u0db1\u0dca\u0daf\u0dd4 \u0dd9 \u0db4\u0dca\u200d\u0dbb\u0dd9\u0dcf\u0dc1\u0dba. \u0dd6\u0dbd\u0dbb\u0d9c\u0dbd \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0daf\u0db1\u0dca \u0daf\u0dda \u0dbb\u0daf\u0da7\u0dca \u0dd2\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0daf\u0daf\u0daf\u0dc4\u0dc3\u0dca \u0d9c\u0dab\u0db1\u0dd9\u0da7 \u0dd2\u0db0\u0dd2\u0dd9 \u0dd9\u0dcf\u0dbd\u0dba\u0dda \u0dad\u0dd2\u0dc3\u0dca\u0daf\u0dc3\u0dca \u0dd2\u0daf\u0dca \u0d8b\u0dbb\u0dd4\u0db8\u0dba\u0dda \u0daf\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0daf\u0dd9\u0dde\u0dda\u0db1 \u0db1\u0dca\u0dda\u0db1\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0dda. \u0db8\u0dd4\u0dc3\u0dca\u0dd2\u0dda \u0da2\u0db1\u0dad\u0dcf\u0dd9 \u0daf\u0db1\u0dcf\u0daf\u0dd9\u0db1\u0dca \u0db8\u0dd4\u0dc3\u0dca\u0dd2\u0dda \u0dd2\u0db1\u0dca\u0dad\u0dd9\u0dcf\u0daf\u0dd3\u0db4\u0db1\u0dca \u0d92\u0dd9 \u0dd9\u0dbd\u0dc4\u0dad\u0dca\u0dd9\u0dcf\u0dbb\u0daf\u0dba\u0db1\u0dca \u0dd2\u0dbd\u0dca\u0dbd\u0dcf\u0daf\u0d9c\u0db1 \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf.\u200d \u0db4\u0dd4\u0dbb\u0dcf\u0dc3\u0dd2\u0daf\u0dba\u0dcf\u0dad\u0dca\u0db8\u0dd9 \u0daf\u0dda\u0dd9\u0dbd\u0dca \u0dc3\u0dd2\u0db1\u0dcf\u0dc1 \u0dd9\u0dbb\u0dbd\u0dcf \u0db4\u0dd4\u0dbb\u0dcf\u0dc3\u0dd2\u0daf\u0dba\u0dcf\u0dad\u0dca\u0db8\u0dd9 \u0daf\u0dda\u0dd9\u0dbd\u0dca\u0dd9\u0dbd\u0da7 \u0d87\u0db1\u0dca\u0da9\u0dca \u0dd9\u0dad\u0dca\u0dd9\u0dbb\u0dbd\u0dcf \u0dc3\u0dd2\u0db1\u0dcf\u0dc1 \u0dd9\u0dbb\u0dbd\u0dcf \u0daf\u0d9c\u0dcf\u0da9\u0db1\u0dd0\u0d9f\u0dd2\u0dd2 \u0dc4\u0daf\u0dbd\u0dcf \u0dd2\u0daf\u0dca \u0dc4\u0daf\u0dd9\u0dad \u0d86\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dab\u0dba \u0dd9 \u0daf\u0db8\u0dcf\u0daf\u0dc4\u0dcf\u0dad\u0dda \u0dad\u0db8\u0db1\u0dca \u0d92\u0dd9. \u0d91\u0dad\u0daf\u0dd9\u0dcf\u0da7 \u0d92 \u0db1\u0dca\u0dda\u0db0\u0dd2\u0dba \u0db1\u0dd2\u0dc3\u0dcf \u0daf\u0dd9\u0dde\u0dda\u0db1 \u0da2\u0db1\u0dad\u0dcf\u0dd9\u0daf\u0dda \u0dc4\u0daf\u0dd9\u0dad\u0da7 \u0daf\u0dda\u0daf\u0db1\u0dcf\u0dd9\u0dda \u0daf\u0dd0\u0daf\u0db1\u0db1\u0dca\u0daf\u0db1\u0dca \u0db1\u0dd0\u0dda\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8\u0db8 \u0dd2\u0dc4\u0db1\u0dd9\u0dcf.\n\n59 60\n\n[\u0d9c\u0dbb\u0dd4 \u0dd2\u0db1\u0dd4\u0db4 \u0db4\u0dc3\u0dca\u0dd4\u0dd9\u0dbd\u0dca \u0db8\u0dc4\u0dad\u0dcf]\n\n2024 \u0dd2\u0daf\u0dda\u0dbd\u0dca 1\n\n\u0dd2\u0db1\u0dca\u0dad\u0dd9\u0dcf\u0daf\u0dba\u0dda \u0db8\u0dad\u0dd4 \u0dd9\u0db1\u0dd9\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0db8\u0dd4\u0dc3\u0dca\u0dd2\u0dda \u0da2\u0db1\u0dad\u0dcf\u0dd9 \u0d89\u0dbd\u0dda\u0dd9 \u0dd9\u0dbb\u0dbd\u0dcf \u0dd9\u0dcf\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb \u0d91\u0dbd\u0dca\u0dbd \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dad\u0dd4\u0dd2\u0db6\u0db1\u0dca \u0dba\u0dda \u0dc4\u0dd2\u0dad\u0dca \u0dbb\u0dd2\u0daf\u0dd3\u0db4\u0db8\u0dda \u0db1\u0dca\u0dda\u0db1 \u0dc0\u0dd4\u0dab\u0dcf \u0db1\u0dda \u0d91\u0dca\u0dd9 \u0dc3\u0dda.\u0db7\u0dbb\u0dca\u0dbd\u0dab\u0daf\u0dba\u0db1\u0dca\u0db8 \u0dd2\u0db4\u0dd2 \u0daf\u0dc4 \u0dcf \u0daf\u0d9a\u0dd2\u0db1\u0dd9\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0daf\u0dbd\u0ddd\u0dd9\u0dba \u0db4\u0dd4\u0dbb\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0dd9 \u0dc0\u0dd4\u0dab\u0dd4 ISIS \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dd9\u0dcf\u0dbb\u0dd3\u0dad\u0dca\u0dd9\u0dba \u0daf\u0dda \u0dbb\u0da7\u0da7 \u0d91\u0db1\u0dd9\u0dcf\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0dd9 \u0daf\u0db4\u0db1\u0dca\u0dd9\u0dcf \u0daf\u0daf\u0db1\u0dca\u0db1 \u0db8\u0dd4\u0dbd\u0dca \u0daf\u0dd9\u0da0\u0dca\u0da0 \u0db7\u0dd2\u0dda\u0dd4\u0dd9\u0dda \u0dad\u0db8\u0db1\u0dca \u0da5\u0dcf\u0db1\u0dc3\u0dcf\u0dbb \u0dc4\u0dcf\u0db8\u0dd4\u0daf\u0dd4\u0dbb\u0dd4\u0daf\u0dd9\u0ddd.\n\n\u0daf\u0dd0\u0db1\u0dca \u0dd2\u0db1\u0dca\u0dad\u0dd9\u0dcf\u0daf\u0dba \u0dd2\u0dd9\u0dc3\u0db1\u0dca. \u0dd2\u0db4\u0dd2 \u0dc4\u0dd0\u0daf\u0db8\u0ddd\u0db8 \u0d91\u0dd9\u0dad\u0dd4 \u0daf\u0dd9\u0dbd\u0dcf \u0dc3\u0dcf\u0db8\u0dba \u0d87\u0dad\u0dd2 \u0dd9\u0dbb\u0daf\u0d9c\u0db1 \u0daf\u0dda \u0dbb\u0da7 \u0dc3\u0d82\u0dd9\u0dbb\u0dca\u0dbd\u0db1\u0db1\u0dba \u0dd9\u0dbb\u0dcf \u0daf\u0d9c\u0db1\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0db1\u0dca\u0dba \u0daf \u0dad\u0dca\u200d\u0dbb\u0dc3\u0dca\u0dad\u0dd9\u0dcf\u0daf\u0dd3\u0db4 \u0dd2\u0db1\u0dca\u0dad\u0dd9\u0dcf\u0daf\u0dd3\u0db4 \u0dd9\u0dd0\u0dbb\u0daf\u0dd2 \u0db8\u0dad\u0dd9\u0dcf\u0daf\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dd9\u0dbd \u0db1\u0dd2\u0dba\u0dd4\u0dad\u0dd4 \u0dd2\u0dba\u0da7 \u0dc3\u0db8\u0dcf\u0dd9 \u0daf\u0daf\u0db1 \u0dba\u0dd4\u0d9c\u0dba\u0dda \u0daf\u0dda\u0dd9. \u0daf\u0daf\u0db8 \u0dad\u0dca\u200d\u0dbb\u0dc3\u0dca\u0dad\u0dd9\u0dcf\u0daf\u0dba\u0da7 \u0dc3\u0db8\u0dcf\u0dd9 \u0daf\u0daf\u0db1\u0dca\u0db1 \u0dd2\u0db4\u0dd2 \u0dd9\u0dae\u0dcf \u0dd9\u0dbb\u0db1\u0dd9\u0dcf. \u0d92\u0dd9 \u0dd2\u0dd9\u0dc1\u0dba\u0db1\u0dca. \u0d92 \u0dd9\u0dcf\u0daf\u0dda\u0db8 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dc3\u0dd2\u0db1\u0dca\u0db1\u0dca \u0da5\u0dcf\u0db1\u0dc3\u0dcf\u0dbb \u0dc4\u0dcf\u0db8\u0dd4\u0daf\u0dd4\u0dbb\u0dd4\u0dd9\u0db1\u0dca\u0da7\u0dad\u0dca \u0dc3\u0db8\u0dcf\u0dd9 \u0daf\u0dd3\u0db4\u0db8 \u0dd2\u0dad\u0dba\u0dd9\u0dc1\u0dba\u0db1\u0dca. \u0daf\u0db8\u0dd3\u0db4\u0dcf\u0dbd \u0db1\u0dca\u0dbb\u0dd2\u0daf\u0dc3\u0dca\u0db1 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0d8b\u0db1\u0dca\u0dd9\u0dc4\u0db1\u0dca\u0daf\u0dc3\u0dca\u0da7 \u0dc3\u0db8\u0dcf\u0dd9 \u0daf\u0dd3\u0db4\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf. \u0daf\u0dda \u0dc4\u0dcf\u0db8\u0dd4\u0daf\u0dd4\u0dbb\u0dd4\u0dd9\u0db1\u0dca\u0da7 \u0dc3\u0db8\u0dcf\u0dd9 \u0daf\u0dd3\u0db4\u0daf\u0dda\u0daf\u0dd3\u0db4 \u0dc3\u0db8\u0d9c\u0dd2 \u0da2\u0db1 \u0dd9\u0dbd\u0daf\u0dda\u0d9c\u0daf\u0dda \u0db8\u0dd4\u0d9a\u0dba\u0db6\u0dd4\u0dbb\u0dca\u0dbd \u0dbb\u0dc4\u0dd4\u0db8\u0dcf\u0db1\u0dca \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dd9\u0dbb\u0dba\u0dcf\u0dad\u0dca \u0dd2\u0dc3\u0dcf\u0dda \u0dc3\u0dcf\u0dd2 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d86\u0dab\u0dca\u0dd4\u0dd9\u0dcf\u0dbb\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dca \u0db4\u0dd2\u0dd2\u0db6\u0d9c\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0daf\u0dd0\u0db1\u0dca \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0daf\u0dd9\u0dbb\u0dd3 \u0dba\u0dd4\u0d9c\u0dba \u0daf\u0db1\u0dcf\u0daf\u0dd9\u0db1\u0dca \u0daf\u0dd9\u0dbb\u0daf\u0dda \u0daf\u0db8\u0dcf\u0daf\u0dc4\u0dcf\u0dad \u0daf\u0db1\u0dcf\u0daf\u0dd9\u0db1\u0dca. \u0daf\u0dda\u0dd9\u0dcf \u0db6\u0dda\u0daf\u0dd9\u0dcf\u0db8 \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0dd2\u0dc3\u0dca\u0dd9\u0dbb\u0daf\u0d9c\u0db1 \u0dc3\u0db8\u0dcf\u0dd9 \u0daf\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0dd9; \u0d92 \u0dd2\u0daf\u0dc4\u0dc3 \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db1\u0dca. \u0daf\u0daf\u0dc3\u0dd2\u0dba\u0db1\u0dca\u0daf\u0dda \u0d9c\u0dad\u0dd2\u0dba \u0dad\u0db8\u0db1\u0dca \u0dc3\u0db8\u0dcf\u0dd9 \u0daf\u0dd3\u0db4\u0db8."
  },
