d[\u0dd2 \u0d85\u0dad\u0dca\u0daf\u0dca\u200d\u0dad\u0d9a\u0dd3[. \u0d92 \u0d85\u0dad\u0dca\u0dc4\u0daf\u0dca\u200d\u0dcf \u0db6\u0d9a\u0db4\u0dd4 \u0dca\u200d\u0dbb[\u0db1\u0d9a\u0dca. \u0d92\u0dad\u0dca [[ \u0dbb\u0dd3\u0db1\u0dc0\u0dc0\u0dcf, \u0dc1\u0db8\u0dca \u0dca\u200d\u0dbb[\u0dc1\u0dda\u0daf\u0dca\u200d\u0db1 \u0dc3\u0dcf\u0dbb\u0dca\u0dae \u0dc0\u0dad\u0dc4\u0dad \u0dbb\u0dd3\u0db1\u0d9a\u0dcf. \u0dc1\u0db8\u0dca \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0dca\u200d\u0dc0 \u0da0\u0dca\u200d\u0dbb\u0db1\u0dad\u0dca \u0d91\u0d9a\u0dca \u0db1\u0dd2\u0dbb\u0dca[\u0dcf\u0dab\u0db1 \u0dc1\u0dc0\u0d9a\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0dc0 \u0dd6\u0ddb \u0d85\u0db4\u0dd2 \u0dc1\u0dc0\u0dc0\u0dc3\u0dca \u0dbb\u0db1\u0dca\u0dc0\u0da7 \u0d95\u0dc0\u0dd1. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dc0\u0dd3 \u0db8\u0dd2\u0d9a\u0daf\u0dd3 \u0d9c\u0dad\u0db1\u0dd3\u0dc1\u0db8\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1\u0dcf\u0dc0\u0dbd\u0dd2\u0db1 \u0db4[\u0dab\u0d9a\u0dca \u0dc1\u0dc0\u0ddc\u0dc1\u0dc0\u0dd2 , \u0dc1\u0d9a\u0ddc\u0d9a\u0dd4 \u0db1\u0dd4\u0db1\u0dd4 \u0dc1\u0d9c\u0ddc\u0dc0\u0dd2\u0db1\u0dcf \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dd4\u0dad\u0dca, \u0d85\u0dbb\u0dca\u0dad\u0dcf\u0db4\u0dbd\u0dca \u0dc1\u0d9c\u0ddc\u0dc0\u0dd2\u0db1\u0dcf \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dd4\u0dad\u0dca, \u0d92 \u0dc0\u0dcf\u0dc1 [ \u0d85\u0dc1\u0dc0\u0d9a\u0dd4\u0dad\u0dca \u0dc0\u0d9c\u0dcf \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc0\u0d9a \u0db1\u0dd2\u0db1\u0dad\u0dbd\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0dc0 \u0da2\u0dc0\u0dad\u0dcf\u0dc0 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dd4\u0dad\u0dca \u0d89\u0d9a\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad\u0dc0 \u0da2\u0dcf\u0dad\u0dd2 \u0dc3\u0dad\u0d9a\u0dad\u0dc3\u0dca[\u0d9a\u0dca, \u0da2\u0dcf\u0dad\u0dd2 \u0dc0\u0dad\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5\u0d9a\u0dca \u0dc3 \u0dc3\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0dc0 \u0d95\u0dc0\u0dd1. \u0d9a\u0dd4\u0da9\u0dcf \u0db4\u0dbb\u0dd2[\u0dcf\u0dab\u0dc1\u0dda, \u0dc3\u0dd4\u0dc5\u0dd4 \u0dc4\u0dcf [\u0db0\u0dba \u0db4\u0dbb\u0dd2[\u0dcf\u0dab\u0dc1\u0dda, [\u0dc4\u0dcf \u0db4\u0dbb\u0dd2[\u0dcf\u0dab\u0dc1\u0dda \u0d92 \u0dc0\u0dcf\u0dbb\u0dd2 \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2 \u0d92 \u0dcf\u0d9c\u0dca\u200d\u0dbb\u0dad\u0dcf\u0dc1\u0dc0\u0db1\u0dca \u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dc0 -\u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0dbb\u0d9a\u0dcf- \u0dc1\u0db8\u0dca \u0da2\u0dcf\u0dad\u0dd2 \u0dc2\u0dd2 \u0dcf\u0dbb\u0dca\u0db8\u0dd2 \u0dc0\u0dad\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5, \u0d92 \u0dc3\u0dad\u0d9a\u0dad\u0dc3\u0dca[ \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1\u0dcf\u0dad\u0dca[ \u0dbb\u0db1\u0dca\u0dc0\u0da7 \u0d95\u0dc0\u0dd1. \u0d9c\u0dbb\u0dd4 \u0d87[\u0dad\u0dd2\u0dad\u0dd4\u0db8[\u0db1\u0dd2, \u0d94\u0db6\u0dad\u0dd4\u0db8[\u0dcf \u0dbb\u0dd3\u0db1\u0db4\u0dd4 \u0d86 \u0dcf\u0dbb\u0db1\u0da7 \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc1\u0dda \u0dca\u200d\u0dbb\u0d9c\u0dad\u0dd2\u0dc1\u0dd3\u0dbd\u0dd3\u0dc0 \u0dc1\u0db1\u0ddd\u0da2\u0dc0\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dc5\u0dcf.\n\n\u0d8a\u0dc5\u0d9f\u0da7 [[ \u0dbb\u0dd3\u0db1\u0db1\u0dca\u0dc0 \u0dad[\u0dad\u0dad\u0dd2\u0dd2 , \u0dc0\u0dcf\u0dbb\u0dd2 \u0d9a\u0dca\u0dc1\u0dc2\u0dda\u0ddb\u0db1 \u0d9c\u0dad\u0dc0\u0dad\u0dca. \u0d85\u0db4\u0dd2 \u0d87\u0dad\u0dca\u0dad \u0dae\u0dcf \u0dc1\u0dc5\u0ddc\u0dad\u0dca \u0d94\u0dda, \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0da7 \u0dad\u0dd4\u0db8\u0dc5 \u0dc0\u0dd2 \u0dcf\u0d9a \u0dc0\u0dcf\u0dbb\u0dd2 \u0dbb\u0dca[\u0dcf\u0db1\u0dca\u0dad\u0db1\u0d9a\u0dca \u0db1\u0dd2\u0dbb\u0dca[\u0dcf\u0dab\u0db1 \u0dc1\u0dc0\u0d9a\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1 [ \u0dad\u0dc0 \u0dc4\u0dd2\u0dc3\u0dca \u0dad\u0dad\u0db1\u0dca, \u0d85\u0da9\u0dd4 \u0dad\u0dad\u0db1\u0dca"
