    "chunk_text": "\u0d9c\u0dcf\u0db8\u0dab\u0dd3 \u0dcf\u0dba\u0dc3\u0dd6\u0dbb\u0dd2\u0dba, \u0db6\u0daf\u0dd2\u0dba\u0dd4\u0daf\u0dd3\u0db1\u0dca\u0dad \u0db8 \u0db8\u0dd4 , \u0db1\u0dd2 \u0dda \u0d82\u0d9a \u0dc0\u0dd2\u0dc1\u0da2\u0dca\u0dca\u0db8\u0d9a , \u0dca\u0db1\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u200d\u0dbb\u0db8\u0dc3\u0dd2\u0d82 , \u0dbd\u0dd2\u0db8\u0d9a \u0d87\u0dd4\u0dbd\u0db8\u0d9a\u0db8\u0dd4\u0daf\u0dd2, \u0dbb\u0dd2\u0da0\u0dbb\u0dca\u0dae\u0da9\u0dca\u0dc4 \u0db4\u0dad\u0dd2\u0dca\u0dba, \u0da2\u0dd3.\u0d9a\u0dbd\u0dca. \u0db4\u0dd3\u0dbb\u0dd2\u0dc4\u0dda \u0dc4 \u0dad\u0dc0\u0db8\u0d9a \u0d85\u0dba \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4 \u0d85\u0db8\u0dcf\u0dad\u0dba \u0db0\u0dd4\u0dca\u0dba \u0daf\u0dd0\u0dbb\u0dd4\u0dc0\u0dcf. \u0d9a\u0dc0\u0dd0\u0db1\u0dd2 \u0dc3\u0dd4\u0dc0\u0dd2\u0dc1 \u0dda \u0dcf\u0dba\u0d9a\u0dba\u0db1\u0dca\u0dad \u0dad\u0dca\u0dda\u0db8 \u0dbb\u0dd2\u0db1\u0dd2 \u0d87\u0db8\u0dad\u0dd2\u0dd4\u0db8\u0dd2\u0dba\u0db8\u0d9a \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4 \u0dc1\u0dc0 \u0dc1\u0dc0 \u0dc4\u0dda\u0d9a\u0db8\u0dc2\u0dab, \u0dc1\u0dc0 \u0dc4\u0d9a \u0dc0\u0db8\u0dd2 \u0dcf\u0d9a\u0db8\u0dc2\u0dab \u0dc1 \u0dcf\u0db3\u0dd2\u0db1\u0dca\u0dad \u0dc1\u0db8\u0d9a\u0dbb\u0dd4\u0dda \u0d9c\u0db1\u0dca\u0dad \u0dc0\u0dad\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0d9a\u0dc1 \u0dc2\u0dab \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0db8\u0dcf \u0daf\u0d9a\u0dd2 \u0dc0\u0dcf. \u0d92 \u0db1\u0dd2\u0dc4\u0dcf \u0d85\u0daf \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4 \u0dc1\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0db8\u0d9a\u0dad\u0dd2\u0dc0\u0dbd\u0da7 \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6 \u0d85\u0dc0\u0dd4\u0dbd \u0dc1\u0db8\u0dcf\u0d9a\u0dc2\u0dab\u0daf \u0d9a\u0dd2\u0dba \u0d9a\u0d9a \u0d9c\u0dd0 \u0d9a\u0dbb\u0dd4\u0db8\u0dca \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0dc2\u0dab \u0db8\u0db8 \u0d85\u0daf \u0d94\u0db6 \u0dca\u0daf\u0dd2\u0dbb\u0dd2\u0dc1\u0dc0 \u0daf\u0dc2\u0dab\u0dc0\u0db1\u0dca\u0dad \u0da7 \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0dcf\u0dc1\u0dca\u0dcf\u0db8\u0d9a\u0dd4 \u0dc1\u0dc0 \u0dc0\u0dcf.\n\n1978\u0daf\u0dd3 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dc5 \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc4\u0d82\u0dc4\u0dda\u0d9a\u0dca\u0dba \u0d9c\u0db8\u0d9a\u0dad\u0dcf\u0db8, 1978\u0daf\u0dd3 \u0dc0\u0dd2 \u0dda\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd \u0db4 \u0dad \u0dc4\u0dda\u0db8\u0dad \u0d9a\u0dca \u0d9c\u0db1\u0dca\u0dad \u0da7 \u0d9a\u0dc0\u0d9a\u0da7 \u0dad\u0dd2\u0db6\u0dd4\u0db8\u0dca \u0d9a\u0dc2\u0dab\u0dc4\u0db8\u0d9a \u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0db4\u0dc2\u0dab\u0dc2 \u0dca\u0dcf\u0dba\u0da7 \u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0dbd\u0dd0\u0db6\u0dd4\u0dba\u0dcf. \u0d9a\u0daf\u0dcf \u0d92\u0d9a\u0da7 \u0dcf \u0dad\u0dcf \u0dc0\u0dd2\u0db8\u0dd4\u0dc2\u0dab\u0dad\u0dd2 \u0dc1\u0db4\u0dca\u0db8\u0dd4\u0dc1\u0da9\u0dbd \u0dc4 \u0dc1\u0dba\u0ddd\u0d9c\u0dba \u0dbd\u0dd0\u0db6\u0dd4\u0db8\u0dca \u0db1\u0dd2\u0dc4\u0dcf \u0d92 \u0d86\u0da9\u0dbd\u0da9\u0dd4\u0dc0 \u0db6\u0dbd\u0dba\u0da7 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0dc1\u0d9a\u0db8\u0dd2 \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0d92 \u0db4 \u0dad \u0dc4\u0dda\u0db8\u0dad \u0d9a\u0dca\u0d9c\u0db1\u0dca\u0dad \u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0dbd\u0dd0\u0db6\u0dd4\u0dba\u0dcf.\n\n1981\u0daf\u0dd3 \u0dca\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0db8\u0d9a \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4 \u0db0\u0dca\u200d\u0dc0\u0dbd \u0db4\u0dd2\u0d9a\u0dcf\u0dc0 \u0d8a\u0da7 \u0dc0\u0da9\u0dcf \u0dc1\u0dc0 \u0dc4\u0dda. \u0d9a\u0db8\u0d9f\u0dd2\u0db1\u0dca\u0dad \u0dc1\u0dba\u0ddd\u0dcf \u0dcf \u0d9a\u0dca\u0dc0\u0dad \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc4\u0d82\u0dc4\u0dda\u0d9a\u0dca\u0dba \u0dc1\u0dc0 \u0dc4\u0dda \u0d9a\u0dca\u0d9c\u0db1\u0dca\u0dad \u0d85\u0db4\u0da7 \u0d87\u0db8\u0d9a\u0dad\u0da7\u0db8 \u0db6\u0dd0\u0dbb\u0dd2 \u0dc0\u0dd4\u0dba\u0dcf. \u0d92 \u0d9a\u0dcf\u0dbd\u0dc1\u0dc0 \u0d85\u0db4\u0dd2 \u0dda \u0dc1\u0db6\u0dcf\u0dc1 \u0dcf\u0db8 \u0dc0\u0dad\u0d82\u0da0\u0dd2\u0dba\u0dd2, \u0d94\u0db6\u0dd4\u0db8\u0dd2\u0dba \u0dc4 \u0db8\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dae\u0db8\u0dd2\u0d9a \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4 \u0dc1\u0dc0 \u0dc1\u0dba\u0daf\u0dd4\u0db8\u0dca \u0d9a\u0dcf\u0dbd\u0dba. \u0dd0\u0db6\u0dd0\u0dba\u0dd2,\n\n\u0dc1\u0dda \u0dc4\u0db7\u0dcf\u0dc1\u0dda \u0dca\u0db1\u0dca\u0dad \u0dc4\u0db8 \u0dca \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dcf\u0da7 \u0dad\u0db8\u0db1\u0dca\u0dad\u0dc1\u0dda \u0daf\u0dc0\u0dad\u0da7 \u0dad\u0dda\u0da7\u0dd4 \u0d9a\u0dca\u0dbd\u0dcf \u0d85 \u0dbd\u0dcf \u0db6\u0dbd\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8\u0db8 \u0d9a\u0dd2\u0dba \u0dc0\u0dcf. \u0dbd\u0d82\u0d9a\u0dcf \u0dca\u0dad\u0dd2 \u0dcf\u0dc4\u0dc1\u0dc0 \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4 \u0dba \u0dc4\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dca\u200d\u0dc1\u0dba\u0db1\u0dca\u0dad \u0dc1\u0dc0\u0da0\u0dca\u0da0 \u0dc1\u0dbd\u0dcf\u0d9a\u0dd4\u0db8 \u0dc0\u0dd0\u0dca\u0dc0 \u0daf \u0dad\u0db8\u0dba\u0dd2 \u0d9a\u0daf\u0dcf \u0d92\u0d9a\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4 \u0db0\u0dca\u200d \u0daf\u0dc1\u0db8\u0db1\u0dca\u0dad \u0dc3\u0dd2 \u0db0\u0dca\u200d \u0dc0\u0dd4\u0dc1\u0da9\u0dbd. \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 44\u0d9a\u0da7 \u0db4\u0dc4\u0dda\u0dc1\u0dc4\u0dda \u0d85\u0daf\u0db8\u0d9a \u0d9a\u0daf\u0dcf -1981\u0daf\u0dd3- \u0dc1\u0dba\u0ddd\u0dcf \u0dcf \u0d9a\u0dca\u0dc0\u0dad \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc4\u0d82\u0dc4\u0dda\u0d9a\u0dca\u0dba \u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0d9a\u0db8\u0d9a \u0d9a\u0dca\u0db1\u0dca\u0dad \u0d85\u0db4\u0da7 \u0dc3\u0dd2 \u0db0\u0dca\u200d \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6 \u0dc0\u0dcf, \u0d92\u0dc0\u0dcf\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc4\u0d82\u0dc4\u0dda\u0d9a\u0dca\u0dba \u0dc1\u0d9c\u0dc1 \u0db1\u0dca\u0dad \u0dc3\u0dd2 \u0db0\u0dca\u200d \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6 \u0dc0\u0dcf. \u0d92 \u0d85\u0dad\u0dca, \u0d9a\u0daf\u0dcf \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4 \u0db0\u0dca\u200d\u0dc0\u0dbd \u0db4\u0dd2\u0d9a\u0dcf\u0dc0\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4 \u0db0\u0dca\u200d \u0dc1\u0dc0\u0da0\u0dca\u0da0 \u0d85\u0dba\u0dc1\u0dda \u0daf\u0dbb\u0dd4\u0dc1\u0dc0\u0ddd, \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dc1\u0dda \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dc1\u0dda \u0daf\u0dbb\u0dd4\u0dc1\u0dc0\u0ddd \u0d85\u0daf \u0dc1\u0dc0 \u0dc1\u0d9a\u0dcf\u0da7 \u0dcf\u0dcf\u0dad\u0dba\u0db1\u0dca\u0dad\u0dad\u0dca \u0db4\u0dcf\u0dc4\u0dbd\u0dca\u0dc0\u0dbd, \u0d9a\u0dc1 \u0db8 \u0dd0\u0db8\u0d9a \u0dda \u0dc0\u0dd2\u0dc1 \u0dca\u0da7\u0dc0\u0dbd \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4 \u0dba \u0dbd\u0db6 \u0dc0\u0dcf. \u0d9a\u0daf\u0dcf \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0d92\u0d9a\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4 \u0db0\u0dca\u200d \u0dc0\u0dd4\u0dba\u0dcf. \u0d92 \u0daf\u0dbb\u0dd4\u0dc1\u0dc0\u0ddd \u0d92 \u0dad\u0dd0\u0db1\u0dca\u0dad\u0dc0\u0dbd \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4 \u0dba \u0dbd\u0db6 \u0dc0\u0dcf\u0da7 \u0db8\u0db8 \u0dc0\u0dd2\u0dbb\u0dd4 \u0db0\u0dca\u200d \u0dd0 \u0dd0. \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0dcf\u0dba \u0dc4\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2, \u0dc1\u0db8\u0dcf\u0d9a\u0daf, \u0dc4\u0dd1\u0db8 \u0daf\u0dbb\u0dd4\u0dc1\u0dc0\u0d9a\u0dd4\u0da7\u0db8 \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4 \u0dc1\u0dc0 \u0db1\u0dd2\u0daf \u0dc4 \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dd4\u0dba\u0dd2. \u0d92\u0d9a \u0db1\u0dd2\u0daf \u0dc4\u0dda \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4 \u0dba\u0da7 \u0d9a \u0dcf \u0d9c\u0dd2\u0dba \u0dc0\u0dad\u0dc5\u0dd4\u0dbd\u0dca \u0db8\u0dcf\u0dad\u0dca\u0d9a\u0dcf\u0dc0\u0dc2\u0dab. \u0dd0\u0dc1\u0db8\u0ddd\u0da7\u0db8 \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4 \u0dc1\u0dc0 \u0db1\u0dd2\u0daf \u0dc4 \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dd4\u0dba\u0dd2."
