    "chunk_text": "\u0dad\u0db8\u0dd4\u0db1\u0dca\u0dc0\u0dcf\u0db1\u0dca\u0dc1\u0dc3\u0dda\u0d9a\u0dcf \u0daf\u0dca\u200d\u0dad\u0db1\u0dca \u0dae\u0dcf \u0dc5\u0dcf, \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 76 \u0dcf\u0db4\u0db1\u0d9a\u0dca \u0d9c\u0dad\u0dc0. 1948\u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0db1\u0dd2\u0daf\u0dca\u200d\u0dc4\u0dc3 \u0d9a\u0db6\u0dc0 \u0dc1 \u0ddc\u0da7 \u0dc1\u0db8\u0dca \u0dbb\u0da7\u0da7 \u0d85\u0dc0 \u0dba \u0dc4\u0dcf\u0dbd\u0dca\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0db1\u0db1\u0da7 34\u0dd2 \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0dca\u200d\u0dc0\u0db1 \u0dbb\u0d9a\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0dca\u0da9. \u0dc3\u0dd2\u0db1\u0db1\u0da7 66\u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0db4\u0dd2\u0da7 \u0dbb\u0da7\u0dd2\u0db1\u0dca \u0dc1\u0d9c\u0dc0\u0dcf\u0dc0\u0dcf. \u0da9\u0dd3.\u0d91\u0dc3\u0dca. \u0dc1\u0dc3\u0dda\u0dc0\u0dcf\u0dc0\u0dcf\u0db1 [\u0dad\u0dad\u0dd2\u0dad\u0dd4\u0db8[\u0dcf, \u0da9\u0da9\u0dca\u0dbd\u0dd2 \u0dc1\u0dc3\u0dda\u0dc0\u0dcf\u0dc0\u0dcf\u0db1 [\u0dad\u0dad\u0dd2\u0dad\u0dd4\u0db8[\u0dcf, \u0dc1\u0dda.\u0d86\u0dbb\u0dca. \u0da2\u0db1\u0dc0\u0dbb\u0dca\u0db0\u0dc0 [\u0dad\u0dad\u0dd2\u0dad\u0dd4\u0db8[\u0dcf, \u0d9c\u0dcf\u0db8\u0dd2\u0db8\u0dca\n\n\u0d92 \u0daf\u0dca\u200d \u0dcf\u0db4\u0db1? \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0db1 \u0d85\u0daf\u0dca\u200d \u0dc1[\u0da0\u0dca\u0da0\u0dbb \u0d9a\u0dcf\u0db7\u0db1\u0da7 \u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d92 \u0db1\u0dd2\u0dc3\u0dcf\u0dd2 . \u0da2\u0d9a\u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0d92 \u0db1\u0d9a\u0dca \u0db1\u0dd2\u0db4\u0daf\u0dca\u200d\u0dc0\u0db1\u0dca\u0dc0 \u0dc0\u0dad\u0db1 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0db1\u0dbd\u0dca 3.50\u0dd2 . \u0dad\u0dcf\u0db4 \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0d92 \u0db1\u0d9a\u0dca \u0db1\u0dd2\u0db4\u0daf\u0dca\u200d\u0dc0\u0db1\u0dca\u0dc0 \u0dc0\u0dad\u0db1 \u0dc1\u0dc0\u0dc0\u0dc0\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0db1\u0dbd\u0dca \u0d91 \u0dc3\u0dd2\u0db1 \u0d9c\u0dab\u0dc0\u0d9a\u0dca. \u0d91\u0daf\u0dca\u200d\u0dcf \u0d85\u0dc1\u0db4\u0dca \u0dc0\u0dcf\u0db1 \u0dc1\u0db1\u0ddd -\u0da9\u0da9\u0dca\u0dbd\u0dd2 \u0dc1\u0dc3\u0dda\u0dc0\u0dcf\u0dc0\u0dcf\u0db1 \u0d9a\u0dcf, \u0dc1\u0dda.\u0d86\u0dbb\u0dca. \u0da2\u0db1\u0dc0\u0dbb\u0dca\u0db0\u0dc0\u0d9a\u0dcf- \u0dbb\u0db4\u0dd4 [\u0dc4\u0dc0\u0dad\u0dbd\u0dd2 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0db1 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dd4 \u0d85\u0dc1\u0dc0\u0d9a\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0db1\u0dd2\u0dc3\u0dcf \u0dad[\u0dd2 \u0dc1\u0db8\u0dca\u0dc0\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d85\u0db4\u0dd2 \u0dc0\u0dad\u0dda \u0d85\u0db8\u0dd4\u0dab\u0dd4 \u0dc4\u0dad\u0daf\u0dd4\u0dc0\u0dcf. \u0dad\u0db8\u0dd4\u0db1\u0dca\u0dc0\u0dcf\u0db1\u0dca\u0dc1\u0dc3\u0dda\u0d9a\u0dcf\u0dc1 \u0da2\u0dc0\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dc4\u0dd2\u0da7\u0dd2\u0db1\u0dcf, \u0db4\u0dbb\u0dd2\u0dc0\u0dcf\u0dc3 \u0d86\u0dca\u0da9\u0da9\u0dd4\u0dc1\u0dda \u0dc2\u0dd2 \u0dbb\u0dca[ \u0d87[\u0dad\u0dd2 \u0dc0 \u0dc1\u0db1\u0db1\u0dca. \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0db8\u0dca \u0dc0\u0dad\u0d9f\u0dd2\u0da7\u0d9a\u0dcf \u0dbb\u0dd3\u0db1\u0db1\u0dca\u0dc0, \u0d91\u0dad\u0dd4\u0db8[\u0dcf \u0dc4\u0daf\u0dca\u200d\u0db4\u0dd4 \u0d91 \u0dc0\u0dad\u0dc0\u0d9a\u0dca \u0d9c\u0dad\u0dc0. \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0db8\u0dca \u0d91\u0dad\u0dd4\u0db8[\u0dcf \u0dc4\u0daf\u0dca\u200d\u0db4\u0dd4 \u0d91 \u0dc0\u0dad\u0dc0 \u0dc0[\u0d9a\u0dca \u0dbb\u0dd3\u0db1\u0db1\u0dca\u0dc0. \u0dae\u0dcf \u0dbb\u0dc0\u0dc0\u0dcf \u0dc0\u0dd2\u0dad\u0dbb\u0dd2 ."
