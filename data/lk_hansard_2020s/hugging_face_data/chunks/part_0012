    "chunk_text": "\u0d92\u0dbb\u0da7 \u0dd4 :\u0dca \u0dc1\u0dc0\u0dca \u0dbb\u0dbb\u0d9a\u0daf \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dc0\u0daf\u0d85 \u0dc1\u0db1 \u0d85\u0dc0\u0dd4\u0dd4\u0dc0\u0dca\u0db0\u0dc1\u0dca\u0db0 \u0d92\u0dbb\u0da7 \u0d85:\u0daf\u0dc5 \u0dc1\u0dca\u0db0\u0dc0\u0dca \u0dbb\u0dbb\u0dca \u0dc0. \u0dc0\u0dd4 \u0d85 \u0d85\u0db4\u0dd2 \u0d91\u0dad\u0dd0\u0dc0\u0dd3 \u0db1\u0dc0\u0dad\u0daf\u0dc0\u0dc1\u0dc3 \u0d85:\u0dc4\u0dc3\u0dcf\u0dca \u0d8b:\u0dc4\u0dc3\u0dcf\u0dca \u0dc0\u0dd2\u0db1\u0dc3\u0dcf\u0d9a\u0daf \u0db1\u0dc0\u0dad\u0daf\u0dc0 \u0dc3\u0dcf\u0db1\u0db6\u0dca \u0db0 \u0dbb\u0dbb\u0dc1\u0db8\u0dc0 \u0dad\u0db1\u0dba\u0dd2 \u0d92 \u0dbb\u0da7\u0dba\u0dd4 \u0dad \u0dbb\u0dbb\u0dca \u0dc1\u0dca . \u0d92 \u0dc0\u0daf\u0dc1\u0dc3\u0db1\u0d85 \u0db4\u0daf\u0daf\u0dd4\u0d9a\u0dca\u0dbb \u0dd2\u0da7\u0da7 \u0d85\u0dc0\u0dd2\u0dc3\u0dcf\u0dca\u0dc3\u0dcf\u0daf\u0dc1\u0dda\u0dca \u0d9a :\u0d9a\u0dca\u0dc0\u0daf \u0daf\u0dd4\u0db1\u0dd2 \u0dcf \u0db1\u0daf\u0dca\u0dbd\u0db8\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dda\u0db8\u0dc1\u0dcf\u0dca \u0dcf\u0dca \u0dc0 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dcf\u0da7 commercially sustainable \u0dc0\u0dd2\u0db0\u0dd2\u0dcf\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0dbb\u0dbb\u0dca \u0dc0 \u0d85\u0db4\u0dd2 \u0db6\u0d9a\u0daf\u0dc1\u0db4\u0ddc\u0dc1\u0dbb\u0ddc \u0dd4\u0dbb \u0dc1\u0dc0\u0dc0\u0dc0\u0daf. \u0db8\u0dd4\u0dc0 \u0dc3\u0dcf\u0db7\u0daf\u0db4\u0dad\u0dd2\u0dd4\u0dbb\u0db1\u0db1\u0dd2\u0d85 \u0d85\u0dc1\u0db4\u0dca \u0daf\u0dd4\u0db1\u0dd2 \u0dcf \u0dc3\u0dcf\u0db1\u0db4\u0dd6\u0dca\u0dbd\u0dab\u0dc1\u0dcf\u0dca \u0db1 \u0d86\u0dca\u0da9\u0da9\u0dd4\u0dc0 \u0dc3\u0dcf\u0dd4\u0dbb\u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0dca \u0dc1\u0dca . \u0dc0\u0dd4 \u0d85 \u0d92\u0dc1\u0d9a\u0dca \u0dc3\u0dcf\u0db1\u0dc4\u0dbb \u0db4\u0dd0\u0dad\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dc0\u0daf\u0d85 \u0dc0\u0dd2 \u0daf\u0d9a \u0dc0 \u0dc1\u0dcf\u0dca \u0dc1\u0db4\u0dde\u0dca\u0db0\u0db8\u0dd2\u0db8\u0dbb \u0d85\u0d9c \u0dcf\u0da7 \u0dc3\u0dcf\u0db1\u0db6\u0dca \u0db0 \u0dbb\u0dbb \u0db8\u0dca \u0dc0 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca . \u0d85\u0db4\u0dd2 \u0db6\u0d9a\u0daf\u0dc1\u0db4\u0ddc\u0dc1\u0dbb\u0ddc \u0dd4\u0dbb \u0dc1\u0dc0\u0dc0\u0dc0\u0daf\u0d85 \u0daf\u0dd4\u0db1\u0dd2 \u0dcf \u0dc0\u0daf\u0dc1\u0dc3\u0db1 railway stations brand \u0dbb\u0dbb\u0dca \u0dc0. \u0d85\u0db4\u0dd2 \u0dc1\u0db4\u0dde\u0dca\u0db0\u0db8\u0dd2\u0db8\u0dbb \u0d85\u0d9c \u0dcf\u0da7 \u0d86\u0dbb\u0daf\u0db0\u0dc0\u0daf \u0dbb\u0dbb\u0dc0\u0dc0\u0daf\u0d85 \u0d92 brandings\u0dc0\u0d9a\u0da7 \u0d91\u0dca \u0dc0 \u0d9a\u0dd2\u0dcf\u0d9a\u0daf. \u0d92 \u0dc0\u0daf\u0dc1\u0dc3\u0db1\u0d85 \u0d85\u0db4\u0da7 \u0d89\u0dad\u0daf \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2 \u0dc1\u0dcf\u0ddd\u0db1\u0dc0\u0daf\u0dc0\u0d9a\u0dca \u0d86\u0dc0\u0daf. \u0dc1\u0db1 \u0dc5\u0d9f\u0dd3 \u0d85\u0db4\u0dd2 \u0dbb\u0d9a\u0daf\u0dbb\u0dd4\u0dc0\u0dc0\u0dca \u0db4\u0dd2\u0dd2 \u0dc3\u0dcf\u0d9a\u0dca \u0d91\u0dbb\u0dd4\u0dbb \u0dbb\u0dc5\u0daf. \u0d92 \u0dbb\u0d9a\u0daf\u0dbb\u0dd4\u0dc0\u0dc0\u0dca \u0d9a\u0dd2\u0dda\u0dc0\u0daf\u0d85 \u0dc0\u0daf\u0dd4\u0dc0\u0d94\u0dcf \u0dd2\u0da7\u0da7 \u0dd4\u0dc0\u0dc0\u0dbb\u0d91\u0dd2\u0db6\u0dcf\u0da7 \u0dc1\u0dbb\u0ddd\u0dca\u0da0\u0da0\u0dd2 \u0db4\u0daf\u0dbb\u0d9a\u0dca \u0d85\u0dd3\u0dbb\u0dad\u0dc1 \u0dad\u0dd2\u0dd4\u0dab\u0dab\u0daf\u0d85 :\u0dd0\u0dca \u0dc0\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dcf\u0d9a\u0daf.\n\n\u0db8\u0dd4\u0dc0 \u0dc3\u0dcf\u0db7\u0daf\u0db4\u0dad\u0dd2\u0dd4\u0dbb\u0db1\u0db1\u0dd2\u0d85 \u0d94\u0db6\u0dd4\u0dbb\u0db1\u0daf :\u0dca \u0dc0\u0dc0\u0daf \u0daf\u0dd4\u0db1\u0dd2 \u0dcf \u0dc1\u0dc3\u0dcf\u0dda\u0dc0\u0dc1 \u0dc1\u0db8\u0ddc\u0dbd\u0d9a\u0dca \u0dad\u0dc0\u0dd4\u0dbb\u0dd4\u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0dc0 \u0db6\u0dc0. \u0d92\u0dc0\u0daf\u0dc1 \u0d9a\u0dd2\u0dd2\u0da7\u0db1 \u0dbb\u0daf\u0dca \u0dad\u0daf\u0dc0\u0d9a\u0dca \u0dc0\u0dd0\u0dbd \u0dbb\u0dbb\u0dca \u0dc1\u0dca \u0dc0\u0dd0\u0dad\u0dd2 \u0d9a\u0dca\u0dc1\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dc0\u0daf. \u0db6\u0dc3\u0dcf\u0dca\u0dc0\u0d9a \u0d91\u0dc1\u0dc4\u0db1\u0dba\u0dd2. \u0d9a\u0d9c\u0db8\u0db1 \u0db8 \u0dad \u0d91\u0dc1\u0dc4\u0db1\u0dba\u0dd2. \u0dc1\u0dc4\u0da7\u0da7 \u0dc1\u0dcf\u0dc1:\u0dc0 \u0db1\u0daf\u0dad\u0dba\u0dca \u0dad\u0dbb \u0dbb\u0daf\u0dca \u0dad\u0daf \u0dd2\u0db1\u0dc0\u0dcf \u0db1\u0dd2\u0db8\u0dd2 \u0dc1\u0dad\u0dca \u0d85\u0db1\u0daf\u0dad\u0dba\u0daf\u0d9c \u0dcf \u0db7\u0daf\u0dbb \u0dc3\u0db1\u0dad\u0dd2\u0dc0\u0dbb\u0dcf\u0daf \u0dc0 \u0dc1\u0dcf\u0dca \u0db1\u0db1 \u0d85 \u0db1\u0dd2\u0dc1\u0dcf\u0ddd\u0db1\u0dba \u0dc3\u0db1\u0dad\u0dd2\u0dc0\u0dd4\u0dc0 \u0dc1:\u0dc1:\u0dc0\u0daf -\u0d85\u0db4\u0dd2 \u0dd4\u0dbb\u0dca \u0dc1:\u0dc0\u0daf\u0db1- \u0dd3\u0dbb\u0dca \u0daf\u0dd4 \u0dbb\u0dbb\u0d9a\u0daf \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dc0\u0daf\u0d85 \u0d85\u0dc1\u0db4\u0dca \u0d9a\u0d9c\u0db8\u0db1\u0da7\u0d85 \u0daf\u0dd4\u0db1\u0dd2 \u0dcf \u0dc1\u0dc3\u0dcf\u0dda\u0dc0\u0dcf\u0da7 -\u0dc1\u0db1 \u0dc4\u0dd0\u0db1 \u0d91\u0dbb\u0da7\u0db1- \u0dbb\u0daf\u0dca \u0dad\u0daf\u0dc0\u0dca \u0db6 \u0dc0\u0daf \u0db8\u0dd0\u0db1\u0dd3\u0db1\u0da7. \u0d92 \u0dc3\u0dcf \u0dc4\u0daf \u0d85\u0dc0 \u0dba \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4 \u0dad\u0dd2\u0db1\u0dcf \u0dd3\u0dbb\u0dca \u0daf\u0dd4\u0dc0 \u0d85\u0db4\u0dd2 \u0d85\u0dbb\u0dc1\u0db8\u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dc0\u0daf. \u0d85\u0db4\u0dd2 \u0db6\u0d9a\u0daf\u0dc1\u0db4\u0ddc\u0dc1\u0dbb\u0ddc \u0dd4\u0dbb \u0dc1\u0dc0\u0dc0\u0dc0\u0daf \u0d89\u0dad\u0daf\u0db1 \u0dbb\u0daf\u0dca\u0dbd\u0dcf\u0d9a\u0dca\u0dc2\u0db1\u0dc0 \u0dc0\u0dd0\u0dbd \u0dbb\u0dbb\u0dc0 \u0db6\u0dc3\u0dcf\u0dca \u0dbb\u0dae \u0dd2 \u0dcf\u0daf\u0dd4\u0dd4\u0dc0\u0dc0\u0dd2 \u0dcf\u0dca \u0d85 engine drivers\u0d9a\u0daf\u0d85 guards\u0d9a\u0daf \u0dc0\u0daf\u0dc1\u0dc3 \u0d85\u0dcf \u0dad\u0dc0 \u0d85\u0dc0\u0dd4\u0dd4\u0dc0\u0dca\u0db0:\u0d9a\u0dca \u0dcf\u0dc0\u0dc1\u0dbb\u0ddc\u0da7 \u0d85\u0db4\u0da7 :\u0d9a\u0dd2\u0dca \u0dc0 \u0d9a\u0dd0\u0dc1\u0db6\u0dba\u0dd2 \u0d9a\u0dd2\u0dcf\u0d9a\u0daf. \u0dd2\u0da7\u0dc4\u0dd2\u0dc0\u0dcf\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dc0\u0daf school bus service \u0d91\u0dbb \u0dc0\u0dd0\u0da9\u0dd2\u0db4\u0dd4\u0dbb \u0dbb\u0daf\u0dca \u0dad\u0daf\u0dc0\u0dca \u0da7 \u0db7\u0daf\u0dbb \u0dc1:\u0dca \u0dc0. \u0d89\u0dad\u0dd2\u0dca \u0d85 \u0d85\u0db4\u0dd2 \u0db6\u0d9a\u0dd4 . \u0d92 \u0dc0\u0daf\u0dc1\u0dc3 \u0dd2\u0da7\u0dc4\u0dd2\u0dc0\u0dcf\u0dbb \u0dad\u0db1\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0da2\u0dd3\u0dc0 \u0dc1\u0dc0\u0dca \u0dc1\u0dca ."
