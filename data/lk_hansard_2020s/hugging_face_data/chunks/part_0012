    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0db1\u0dd2, \u0dc3\u0db8\u0dcf\u0dad \u0dbb \u0dc1\u0daf\u0dca \u0dca \u0d9c\u0dd0\u0db1 \u0dc0\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad , \u0dad\u0db1\u0dd2 \u0d9a\u0dcf\u0dcf\u0dcf \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0db1 \u0db6\u0dd0 \u0dd0. \u0dc1\u0db8\u0dca\u0db8 \u0d85\u0d9c \u0dd0\u0d9c \u0dc1\u0dca\u0d9b\u0dca\u200d\u0db1\u0dc1\u0dda \u0d85\u0db8\u0dcf\u0dad\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0d9c\u0dab\u0db1\u0dcf \u0d9a\u0dca \u0dc3\u0dc4 \u0dcf \u0dd4\u0daf\u0dca \u0dc1 \u0db1\u0dca \u0d9a\u0dcf\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dcf. \u0d85\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1\u0d9c\u0da7, \u0dc1\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba\u0d9c\u0da7, \u0dca\u200d\u0dbb \u0dcf \u0db1\u0d9c\u0da7, \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad \u0dbd\u0da7 \u0d9c\u0db1\u0dcf\u0daf\u0dd3 \u0dc1\u0d9c\u0db1\u0dca \u0dc1\u0db8\u0dca\u0db8 \u0dd0\u0db8\u0dcf\u0dad \u0d85\u0db8\u0dcf\u0dad\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0d9c\u0d9a\u0dcf\u0da7\u0db8\u0dcf\u0dad \u0dc1 \u0db1\u0dca \u0d9a\u0dcf\u0dbb\u0db1 \u0dbd\u0daf \u0dd4\u0daf\u0dca \u0dd2\u0db1\u0dca \u0dc1\u0d9a\u0dcf\u0dc1\u0dbb\u0db1, \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0dcf\u0dc1\u0dbb\u0dcf\u0dad\u0dca\u0dc3\u0dad\u0dd4\u0db8 \u0db1 \u0dc3\u0dd4\u0db6\u0dc3\u0dcf\u0dca\u200d\u0db1 \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0db1\u0dca \u0d9a\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dcf \u0da7 \u0dc3 \u0dc5\u0db8\u0dcf\u0dad\u0d9c\u0dcf\u0da7 \u0dbd\u0dd0\u0dc1\u0db6\u0db1 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab\u0d9c \u0dc3 \u0d9a\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dcf \u0dc1 \u0dc3 \u0dc5\u0db8\u0dcf\u0dad\u0d9c\u0dcf\u0dc1 \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0dc3\u0dd4 \u0db4\u0dad\u0dca\u0dc3 \u0d9a\u0dcf\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dcf\u0dad \u0dc1 \u0db1\u0dd4\u0dc1 \u0db1\u0dca \u0dbd\u0dd0\u0dc1\u0db6\u0db1 \u0dc1\u0daf\u0dca \u0dca \u0d9c\u0dd0\u0db1 \u0d85\u0db4\u0da7 \u0d9a\u0dcf\u0dcf\u0dcf \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0db1 \u0dc3\u0dd2\u0daf\u0dca\u0dca\u200d \u0dc1 \u0db1 \u0dcf. \u0dc1\u0db8\u0dca\u0db8 \u0dd0\u0db8\u0dcf\u0dad \u0d91\u0d9a\u0dcf\u0d9a\u0dca\u0db8\u0dcf\u0dad \u0d91\u0d9a\u0dd2\u0dc1\u0db1\u0d9a\u0dcf\u0da7 \u0db6\u0dd0\u0db3\u0dd2\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca; \u0dc1\u0db8\u0dca\u0db8 \u0dd0\u0db8\u0dcf\u0dad \u0d9a\u0dcf\u0dcf\u0dbb\u0dab\u0d9c\u0d9a\u0dca\u0db8\u0dcf\u0dad \u0d91\u0d9a\u0dd2\u0dc1\u0db1\u0d9a\u0dcf\u0da7 \u0dc3\u0db8\u0dcf\u0dad\u0d9c\u0dcf\u0db8\u0dd3 \u0db6\u0dd0\u0db3\u0dd2\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca.\n\n1641 1642\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0dca\u0db8\u0db1\u0dca\u0dad\u0dd4\u0db8\n\n\u0dc3\u0dd2\u0d9c\u0dca\u0dbd \u0d85\u0db4\u0da7 \u0d91\u0d9a\u0dcf \u0db4\u0dcf\u0dbb \u0dc0\u0dd2\u0dc3\u0dc4\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0dc1 \u0dba\u0dd2. \u0dc1\u0db8\u0dca\u0db8 \u0dc3\u0dd2\u0d9c\u0dbd\u0dd4 \u0dca\u200d\u0dbb \u0dc3\u0db1 \u0dbd\u0da7 \u0d85\u0db4\u0da7 \u0d91\u0d9a\u0dcf \u0dad\u0dcf \u0d9a\u0dcf\u0daf\u0dd3 \u0d8b\u0dad\u0dca\u0dc3\u0dad\u0dbb \u0dc1\u0daf\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0dc1 \u0dba\u0dd2. \u0db1\u0dd4\u0dad\u0dca\u0dc3, \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dca\u0db8 \u0dad\u0dd0\u0db6\u0dd4\u0dc1\u0dda \u0d85\u0dc1\u0db4\u0dca \u0db4\u0dc5\u0dd4 \u0dd0\u0db1\u0dd2 \u0db4\u0dd2\u0d9c \u0dbb; \u0db4\u0dc5\u0dd4 \u0dd0\u0db1\u0dd2 \u0d85\u0dd2\u0d9c. \u0dc1\u0db8\u0dca\u0db8 \u0d85\u0db8\u0dcf\u0dad\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dbd\u0da7 \u0d85\u0db4\u0dd2 \u0dc1 \u0db1\u0dca \u0d9a\u0dcf\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dd4\u0daf\u0dca \u0d9c\u0dd0\u0db1 \u0dc1\u0d9a\u0dcf\u0dc1\u0db1\u0d9a\u0dd4\u0da7 \u0dc0\u0dd2\u0dc1\u0dda\u0da0\u0db1\u0d9c\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0db1\u0dca; \u0dc1 \u0db1\u0dc3 \u0d85\u0daf \u0dc3\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0db1\u0dca. \u0dc1\u0db8\u0dca\u0db8\u0d9a\u0dcf \u0dc1 \u0dcf\u0daf\u0db8\u0dcf\u0dad \u0d85\u0d9c \u0dd0\u0d9c \u0dc1\u0db1\u0dcf\u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0db1\u0dca; \u0dc1\u0db8\u0dca\u0db8\u0d9a\u0dcf \u0d85\u0db4\u0dd2 \u0dbd\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dc3 \u0d9a\u0dcf\u0dbb\u0db4\u0dd4 \u0dc1 \u0dcf\u0daf\u0db8\u0dcf\u0dad \u0dc1\u0daf\u0dca \u0dc1\u0db1\u0dcf\u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0db1\u0dca. \u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dc1\u0db8\u0dca\u0db8\u0d9a\u0dcf \u0dc1 \u0dcf\u0dc4\u0db8\u0dcf\u0dad \u0dc1\u0daf\u0dca \u0dc1 \u0db1\u0dd4\u0dc1 \u0db1\u0dca \u0d85\u0db4\u0dd2 \u0dad\u0dd2\u0d9c\u0db4\u0dd4 \u0db4\u0dc5\u0dd4 \u0dd0\u0db1\u0dd2 \u0db4\u0dd2\u0d9c \u0dbb."
  },
