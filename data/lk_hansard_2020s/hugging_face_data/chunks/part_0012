    "chunk_text": "\u0d85\u0dc1\u0db4\u0dca \u0d86\u0dca\u0da9\u0da9\u0dd4\u0dc0 \u0dbb\u0dc1\u0d9c\u0dc0 \u0db1\u0daf\u0dca\u0daf\u0dd3, \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda \u0d94\u0db6\u0dad\u0dd4\u0db8[\u0db1\u0dca\u0d9a\u0dcf\u0dc1\u0d9c\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0db6\u0d9a\u0dcf\u0dc1\u0db4\u0ddc\u0dc1\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4\u0db8 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0d94\u0db6\u0dad\u0dd4\u0db8[\u0db1\u0dca\u0d9a\u0dcf\u0dc1 \u0dc3\u0dc4\u0dc1\u0db1\u0ddd\u0d9c\u0db1 \u0d87\u0dad\u0dd2\u0dc0 \u0dc1\u0db8\u0dca \u0dbb\u0da7 \u0dc1\u0d9c\u0ddc\u0da9\u0dc0\u0d9c\u0dcf \u0d9c\u0dad\u0db1\u0dd3[\u0da7 \u0dc4\u0dad\u0dbb\u0dd3\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dc0\u0dcf\u0daf\u0dca\u200d \u0dbb\u0dd3\u0db1\u0dc0 \u0d91 \u0dd2 . \u0d89\u0dad\u0dd2\u0db1\u0dca \u0daf\u0dca\u200d\u0dc0\u0dc3\u0dd2\u0db1\u0dca \u0daf\u0dca\u200d\u0dc0\u0dc3 \u0db1\u0dc0\u0dc1 \u0ddc\u0da7 \u0d85\u0db4\u0da7 \u0daf\u0dca\u200d\u0dad\u0dc1\u0dc0\u0dc0 \u0dc1\u0daf\u0dca \u0dad[\u0dd2 \u0d94\u0db6\u0dad\u0dd4\u0db8[\u0db1\u0dca\u0d9a\u0dcf \u0dc4\u0dbb\u0dd2[ \u0dc3\u0dcf\u0db8\u0dca\u0dca\u200d\u0dbb\u0daf\u0dca\u200d\u0dcf\u0dd2 , \u0d85\u0dad\u0dd3\u0dad \u0dcf[\u0dc1\u0db1\u0db1\u0dca \u0da2\u0dd3\u0dc0\u0dad\u0dca \u0dc1\u0dc0\u0dc0 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4 \u0db6\u0dc0\u0da7 \u0d94\u0db4\u0dca\u0db4\u0dd4 \u0dbb\u0db8\u0dd2\u0db1\u0dca \u0d89\u0db1\u0dca\u0dc0\u0dc0\u0dcf\u0db1 \u0dbb\u0dd3\u0db1\u0dc0 \u0d91 . \u0d89\u0dad\u0dd2\u0db1\u0dca, \u0d92 \u0d9c\u0dad\u0dc0 \u0dc0\u0d9c\u0dcf\u0da7\u0dd4\u0dc0 \u0dc4\u0dad\u0dbb, \u0d85\u0db1\u0dd4 \u0db8\u0dca\u0db4\u0dcf\u0dc0 \u0dc4\u0dad\u0dbb \u0dc1\u0dc0\u0dc0 \u0dbb\u0dd3\u0db1\u0db1\u0dca\u0dc0 \u0dc1\u0daf\u0dca\u200d\u0db1\u0d9a\u0dca \u0d87\u0dad\u0dca\u0dc1\u0dad\u0dca \u0dc0\u0dad\u0dc4\u0dad.\n\n\u0dd6\u0dbd\u0d9a\u0dcf\u0dc3\u0dc0\u0dcf\u0db4\u0dd3\u0daa \u0d9c\u0dbb\u0dd4 [\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0d