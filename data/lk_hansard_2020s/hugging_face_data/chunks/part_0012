    "chunk_text": "\u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0d9c\u0dd2\u0dba \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0dc1\u0daf\u0dca \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0d85\u0db4\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 36\u0d9a \u0db4\u0dcf\u0dd4\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0dc1\u0daf\u0dca doctor\u0dbd\u0dcf ,000\u0d9a\u0dca \u0dba\u0db1\u0dca\u0db1 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0daf\u0dca\u200d \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2 \u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0d91\u0dc1\u0dc4\u0db8 doctor\u0dbd\u0dcf ,000\u0d9a\u0dca \u0d9c\u0dd2\u0dc1\u0dba\u0dcf\u0dca \u0d85\u0db4\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 7 \u0d9a \u0db4\u0dcf\u0dd4\u0dc0\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf\n\n\u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf \u0dc1\u0dc4\u0dcf\u0db3\u0da7\u0db8 \u0daf\u0dca\u200d\u0db1\u0dca\u0db1\u0dc0\u0dcf, \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba\u0dc1\u0dba\u0db1\u0dca postgraduate trainee \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0d92\u0dc1\u0d9c\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca MBBS \u0dc3\u0db8\u0dca\u0dc1\u0dc0\u0dbd\u0dcf \u0d8a\u0da7 \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4\u0dc0 \u0db4\u0dc4\u0d9a\u0dca, \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4\u0dc0 \u0dc4\u0dba\u0d9a\u0dca, \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4\u0dc0 \u0dc4\u0dad\u0d9a\u0dca \u0daf\u0dd2\u0d9c\u0da7\u0db8 \u0d89\u0dc1\u0d9c\u0db1 \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0d91\u0dad\u0dc1\u0d9a\u0dcf\u0da7 \u0d92\u0dc1\u0d9c\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0da7 OT \u0db1\u0dd0\u0dc4\u0dd0 \u0d92\u0dc1\u0d9c\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0da7 overtime payments \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\