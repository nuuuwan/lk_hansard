    "chunk_text": "2024\u0da7 \u0dc3\u0dcf\u0dc1\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dc0 \u0d9c\u0dca\u0dc1\u0dad\u0dcf\u0dca, 2024\u0daf\u0dd3 \u0dc1\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc0\u0dc0\u0daf\u0dca\u200d\u0dba \u0d85\u0dcf \u0dba \u0dad\u0dad\u0dd4\u0dc5\u0dd4 \u0dc3\u0db8\u0dc3\u0dca\u0dad \u0dc1\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0d85\u0dcf \u0dba \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0dd4\u0dab\u0dc1\u0dab\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 3 2\u0d9a\u0dca \u0db4\u0db8 \u0dba\u0dd2 \u0dc1\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba\u0dba \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 3 2\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0dd4\u0dab\u0dd4 \u0dbb\u0da7\u0d9a\u0da7, \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dc1\u0dba\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 604\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0dc1\u0db8\u0dca \u0dd2\u0daf\u0dba\u0dd4 \u0dd4\u0dc4\u0daf\u0dca\u200d\u0dbd\u0dca \u0d89\u0dad\u0dcf\u0db8 \u0db5\u0dbd\u0daf\u0dca\u200d\u0dcf\u0dba\u0dd3 \u0dc3\u0dc4 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0d9a\u0dca\u0dc2\u0db8 \u0dc1\u0dbd\u0dc3 \u0db8\u0dc4\u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dc1\u0dba\u0dcf\u0daf\u0dca\u200d\u0dc0\u0db1\u0dca\u0db1 \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0dcf\u0dc1\u0dbb\u0dcf\u0dca\u0dad\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf\n\n\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dae.\u0d9a \u0dc1\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0db4\u0daf\u0dca\u0dca\u200d\u0dad\u0dd2\u0dba \u0dc3\u0dcf\u0dc0\u0dbb\u0dca\u0dca\u200d\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d85\u0dad\u0dba\u0dc0 \u0dba \u0d9a\u0da7\u0dba\u0dd4\u0dca\u0dad\u0d9a\u0dca \u0dc1\u0db8\u0dcf\u0d9a\u0daf\u0dca\u200d, \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0da7\u0dca\u0da7 \u0da2\u0db1\u0d9c\u0dc4\u0db1\u0dba .\u0dbd\u0dd2\u0dba\u0db1 22\u0d9a\u0dca \u0dc0\u0dd4 \u0dcf\u0da7 \u0dc0\u0dc3\u0dbb\u0d9a\u0da7 \u0dbb\u0da2\u0dc1\u0dc0 \u0dc1\u0dbb\u0ddd\u0dc4\u0dbd\u0dca\u0dc0\u0dbd \u0db6\u0dcf\u0dc4\u0dd2\u0dbb \u0dc1\u0dbb\u0ddd\u0d9c\u0dd3 \u0d85\u0dcf \u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dcf\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf \u0dba .\u0dbd\u0dd2\u0dba\u0db1 90\u0d9a\u0dca, 100\u0d9a\u0dca \u0db4\u0db8 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0dc1\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc1\u0dbb\u0ddd\u0dc4\u0dbd\u0dca\u0dc0\u0dbd \u0db6\u0dcf\u0dc4\u0dd2\u0dbb \u0dc1\u0dbb\u0ddd\u0d9c\u0dd3 \u0d85\u0dcf \u0dc0\u0dbd\u0dd2\u0db1\u0dd4\u0dca \u0db8\u0dd3\u0da7 \u0d86\u0dc3\u0db1\u0dca\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf \u0dba\u0d9a\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dcf\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0d86\u0dba\u0dd4\u0dbb\u0dca\u0dc1\u0dda\u0daf\u0dca\u200d \u0d85\u0dcf \u0dc1\u0dba\u0db1\u0dd4\u0dca .\u0dbd\u0dd2\u0dba\u0db1 6\u0d9a\u0dca \u0db4\u0db8 \u0dc0\u0dcf\u0dbb\u0dca \u0d9a\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dcf\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0d91\u0dc1\u0dc4\u0db8 \u0d9c\u0dca\u0dc1\u0dad\u0dcf\u0dca, \u0daf\u0dca\u200d\u0dc5 \u0dc0 \u0dc1\u0dba\u0db1\u0dca .\u0dbd\u0dd2\u0dba\u0db1 200\u0d9a\u0dca, 210\u0d9a\u0dca \u0d85\u0dad\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf \u0dba\u0d9a \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0dc0\u0dcf\u0dbb\u0dca \u0d9a\u0dc0 clinics\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc3\u0dc4 OPDs\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db6\u0dcf\u0dc4\u0dd2\u0dbb \u0dc1\u0dbb\u0ddd\u0d9c\u0dd3\u0db1\u0dca \u0dc4\u0dd0\u0dd2\u0dba\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dcf\u0dbb \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d91\u0d9a \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dc1\u0dba\u0d9a\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf\u0dca\u200d\u0d9a\u0da7 10 \u0dc0\u0dad\u0dcf\u0dc0\u0d9a\u0dca, 11 \u0dc0\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0db4\u0db8 \u0db6\u0dcf\u0dc4\u0dd2\u0dbb \u0dc1\u0dbb\u0ddd\u0d9c\u0dd3 \u0d85\u0dcf \u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dcf\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0dc1\u0db8\u0dca\u0d9a \u0dc0\u0dd2\u0dc3\u0dd2\u0dba\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dbb\u0db4\u0dad\u0dc5 \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0dba\u0d9a\u0dca\n\n\u0dc1\u0daf\u0dca\u200d\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0dcf\u0dbb \u0dba \u0dad\u0db8\u0dba\u0dd2, \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0da7\u0dca\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dc1\u0db6\u0ddd \u0dc1\u0db1\u0dcf\u0dc0\u0db1 \u0dc1\u0dbb\u0ddd\u0d9c \u0dc0\u0dba\u0dcf\u0db4\u0dca\u0dad\u0dd2\u0dba \u0d85\u0dd4\u0dca \u0dc3\u0dcf\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc1\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1 \u0d85\u0db1\u0dd4\u0dc0 \u0d9c\u0dca\u0dc1\u0dad\u0dcf\u0dca, \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba\u0dc1\u0dba\u0db1\u0dca \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0da7\u0dca\u0da7 \u0da2\u0db1\u0d9c\u0dc4\u0db1\u0dc1\u0dba\u0db1\u0dca \u0dd2\u0daf\u0dba\u0dba\u0da7 14\u0d9a\u0dca \u0daf\u0dd2\u0dba\u0dc0\u0dd0\u0dd2 \u0dba\u0dcf\u0dc1\u0dc0\u0db1\u0dca \u0dc1\u0db4\u0dc1\u0dc5\u0db1\u0dc0\u0dcf \u0dd2\u0daf\u0dba\u0dba\u0da7 34\u0d9a\u0dca \u0db4\u0db8 \u0d85\u0db0\u0dd2\u0d9a \u0dbb\u0dd4\u0db0\u0dd2\u0dbb \u0db4\u0dd3\u0da9\u0db1\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0db4\u0dc1\u0dc5\u0db1\u0dc0\u0dcf \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0da7\u0dca\u0da7 \u0dd2\u0daf\u0dd4\u0dc0 \u0dc0\u0db1 \u0db8\u0dbb \u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dd2\u0daf\u0dba\u0dba\u0da7 70\u0d9a\u0da7 \u0dc1\u0dc4\u0dca\u0dad\u0dd4\u0dc0 \u0dc1\u0db6\u0ddd \u0dc1\u0db1\u0dcf\u0dc0\u0db1 \u0dc1\u0dbb\u0ddd\u0d9c \u0d9