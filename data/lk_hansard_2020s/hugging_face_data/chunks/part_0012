d\u0b95\u0bc6\u0bbe\u0ba9 \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 2,008,000,000 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0bb1\u0bcd \u0bb2\u0bc6\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0b9f\u0bc1\u0bae\u0bc6\u0bbe\u0b95\u201d \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 263, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0bc6\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0ba4\u0bc6\u0bb2\u0bb5\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bb3\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0bc6\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01.- \u0ba4\u0bc6\u0baf\u0bb2\u0bcd\u0bae\u0bc1\u0bae\u0bb1\u0b9a\u0bcd \u0ba4\u0bc6\u0baf\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd - \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd\n\n\u0ba4\u0bc6\u0bb2\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 578,000,000\n\n\u201c\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 263, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0bc6\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd \u0ba4\u0bc6\u0bb2\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 578,000,000 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0bb1\u0bcd \u0bb2\u0bc6\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bc6\u0bbe\u0b95\u201d \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 263, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0bc6\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd \u0ba4\u0bc6\u0bb2\u0bb5\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bb3\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 264.- \u0bae\u0bc6\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0b9a\u0bcd \u0ba4\u0bc6\u0baf\u0bb2\u0b95\u0bae\u0bcd / \u0b95\u0b9a\u0bcd\u0bb2\u0bc6\u0bc6\u0bbe\u0bbf - \u0baf\u0bc6\u0bbe\u0bb4\u0bcd\u0baa\u0bcd\u0baa\u0bc6\u0bbe\u0ba3\u0bae\u0bcd\n\n\u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0bc6\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01.- \u0ba4\u0bc6\u0baf\u0bb2\u0bcd\u0bae\u0bc1\u0bae\u0bb1\u0b9a\u0bcd \u0ba4\u0bc6\u0baf\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd -\n\n\u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0ba4\u0bc6\u0bb2\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 2,303,000,000\n\n\u201c\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 264, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0bc6\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0ba4\u0bc6\u0bb2\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 2,303,000,000 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0bb1\u0bcd \u0bb2\u0bc6\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0b9f\u0bc1\u0bae\u0bc6\u0bbe\u0b95\u201d \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 264, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0bc6\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0ba4\u0bc6\u0bb2\u0bb5\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bb3\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0bc6\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01.- \u0ba4\u0bc6\u0baf\u0bb2\u0bcd\u0bae\u0bc1\u0bae\u0bb1\u0b9a\u0bcd \u0ba4\u0bc6\u0baf\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd - \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd\n\n\u0ba4\u0bc6\u0bb2\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 187,000,000\n\n\u201c\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 264, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0bc6\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd \u0ba4\u0bc6\u0bb2\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 187,000,000 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0bb1\u0bcd \u0bb2\u0bc6\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bc6\u0bbe\u0b95\u201d \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 264, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0bc6\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd \u0ba4\u0bc6\u0bb2\u0bb5\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bb3\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 265.- \u0bae\u0bc6\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0b9a\u0bcd \u0ba4\u0bc6\u0baf\u0bb2\u0b95\u0bae\u0bcd / \u0b95\u0b9a\u0bcd\u0bb2\u0bc6\u0bc6\u0bbe\u0bbf - \u0bae\u0ba9\u0bcd\u0ba9\u0bc6\u0bbe\u0bb0\u0bcd\n\n\u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0bc6\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01.- \u0ba4\u0bc6\u0baf\u0bb2\u0bcd\u0bae\u0bc1\u0bae\u0bb1\u0b9a\u0bcd \u0ba4\u0bc6\u0baf\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd -\n\n\u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0ba4\u0bc6\u0bb2\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 596,000,000"
