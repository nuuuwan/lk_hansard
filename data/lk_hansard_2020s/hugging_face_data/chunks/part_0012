    "chunk_text": "\u0d91\u0dad\u0dc1\u0dba\u0dcf\u0da7 \u0dc1\u0db1\u0dcf\u0dba\u0dc2\u0dab\u0daf\u0dca\u200d \u0dc1\u0db8\u0dca \u0dba\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0d85\u0dc1\u0db4\u0dca\u0db4 \u0daf\u0dca\u200d\u0dca\u0dad \u0dd2\u0dba \u0d85\u0db4\u0dd2 \u0dc1\u0daf\u0dca\u200d\u0db1\u0dcf\u0dc0\u0dcf \u0d95\u0db1\u0dcf\u0dd1\u0db1 \u0dc1\u0dba\u0dc1\u0db1\u0dcf\u0dd4\u0da7. \u0dc1\u0db1\u0dcf\u0dba\u0dc2\u0dab\u0daf\u0dca\u200d \u0dc1\u0db1\u0dc4\u0dd2 \u0dad\u0dd2\u0d9a\u0dc1\u0db6\u0db1\u0dcf \u0dca\u0dbb\u0dc2\u0dab\u0dd2\u0dad \u0db6\u0dc0? \u0d91\u0dad\u0dc1\u0dba\u0dcf\u0da7 \u0d85\u0db4\u0da7 \u0dc1\u0db4\u0dc1\u0db1\u0dcf\u0db1\u0dca\u0db1\u0dcf \u0dad\u0dd2\u0d9a\u0dc1\u0db6\u0db1\u0dcf\u0dc0\u0dcf2 \u0d91\u0dba \u0db4\u0dd0\u0dca\u0dad\u0d9a\u0dd2\u0db1\u0dca \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0 \u0dc1\u0db8\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dad\u0dad\u0dd2\u0d9a\u0dba\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0d86 \u0db6\u0dd2\u0dd2\u0dba\u0db1\u0dcf (\u0dba \u0dca\u0db0\u0dcf\u0dbb\u0dba\u0dc2\u0dab \u0dc1\u0daf\u0dca\u200d\u0db1\u0dcf\u0dc0\u0dcf2 \u0d92\u0dba \u0daf\u0dd3 \u0dcf \u0d85\u0dc1\u0db1\u0dcf\u0dc2\u0dab \u0db4\u0dd0\u0dca\u0dc1\u0dad\u0db1\u0dca \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0db1\u0dd4 \u0dc3\u0db1\u0dcf\u0d9c\u0db1\u0dd4\u0dca \u0dc1\u0daf\u0dca\u200d\u0db1\u0dcf\u0dc0\u0dcf \u0dc1\u0db8\u0dca \u0dc0\u0dd0\u0dc1\u0da9\u0dca \u0dba\u0dbb\u0db1\u0dca\u0db1\u0dcf. \u0dca\u0db0\u0dcf\u0dbb\u0dba\u0dc2\u0dab \u0dc4\u0dd0\u0dd2\u0dba\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0d86 \u0db6\u0dd2\u0dd2\u0dba\u0db1\u0dcf (\u0dc2\u0dab \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc1\u0dc0\u0db1\u0dca \u0dd0\u0dc1\u0db6\u0db1\u0dcf\u0dc0\u0dcf2 \u0d92\u0dba \u0daf\u0dd3 \u0dcf \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0 \u0d9a\u0dd2\u0dba\u0db1\u0dcf\u0dc0\u0dcf2 \u0d92\u0dc1\u0d9c\u0dcf \u0d86 \u0db1\u0dca\u0dc1\u0dda \u0dc3\u0db1\u0dcf\u0d9c\u0db1\u0dc2\u0dab \u0dc1\u0db8\u0dca \u0dc0\u0dd0\u0dc1\u0da9\u0dca\u0da7 \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0d9a\u0dd2\u0dba \u0dcf. \u0d91\u0dad\u0dc1\u0dba\u0dcf\u0da7 \u0dc3 \u0d86\u0dd2\u0dca \u0dca\u0dc1\u0d86 \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0da7\u0db1 \u0dba\u0db1\u0dcf\u0dc0\u0dcf2 \u0d85\u0dc1\u0db4\u0dca\u0db4 \u0daf\u0dca\u200d\u0dca\u0dad\u0dca \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0da7 \u0dba\u0db1\u0dcf\u0dc0\u0dcf. \u0db1\u0da7 \u0dc1\u0dca\u0dc1\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dcf\u0dd0\u0dc4\u0dd02 \u0dc1\u0db8\u0dca\u0dc1\u0dc2\u0dab \u0dad\u0dd2\u0d9a\u0dc1\u0db6\u0db1\u0dcf \u0dc0\u0dd2\u0db1\u0dd2\u0dc0\u0dd2\u0daf\u0dca\u200d\u0db7\u0dcf\u0dc0\u0dba \u0d9c\u0dd0\u0db1\u0dcf2 \u0d85\u0dc1\u0db4\u0dca\u0db4 \u0dbb\u0dc1\u0dca \u0da2\u0dcf\u0db1\u0dcf\u0dad\u0dcf\u0dc0\u0dc1\u0dda \u0daf\u0dca\u200d\u0dca\u0dad\u0dc0 \u0da7 \u0dad\u0dd2\u0d9a\u0dc1\u0db6\u0db1\u0dcf \u0dca\u0dbb\u0dc2\u0dab\u0dc2\u0dcf\u0dc0 \u0dc1\u0db1\u0dcf\u0dba\u0dc2\u0dab\u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0db1\u0dcf \u0d91\u0dba \u0d9c\u0dd0\u0db1\u0dcf. \u0db1\u0db1 \u0dc4\u0dd2\u0dad\u0db1\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da72 \u0dc1\u0db8\u0dca\u0dba \u0d89\u0dad\u0dcf\u0db1 \u0db6\u0dbb\u0db4\u0dad\u0dc5 \u0dca\u200d\u0dbb \u0db1\u0dcf\u0dba\u0dc2\u0dab.\n\n\u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0db1\u0dd4 \u0dc3\u0db1\u0dcf\u0d9c\u0db1\u0dc2\u0dab \u0dc1\u0db8\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dad\u0dad\u0dd2\u0d9a\u0dba \u0dba\u0dbb\u0db1\u0dcf\u0dc0\u0dcf \u0db1\u0dcf\u0db8\u0dca \u0dc1\u0dba\u0dcf\u0dad\u0dd0\u0db1\u0dcf\u0da7 \u0dc1\u0dc0\u0db1\u0dcf\u0dba\u0db8\u0dca\u0daf\u0dca\u200d \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dc1\u0db8\u0dca\u0dba \u0dba\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0dc1\u0db1\u0dcf\u0dba\u0dc2\u0dab\u0daf\u0dca\u200d2 extent \u0d91\u0dba? \u0dc1\u0db8\u0dca\u0dc1\u0dc2\u0dab extent \u0d91\u0dba \u0dc1\u0dba\u0dcf\u0db4\u0db1;\u0daf\u0dca\u200d? \u0d92\u0dc1\u0d9c\u0dcf \u0d86 \u0db1\u0dca \u0dc1\u0dba\u0dcf\u0dad\u0dd0\u0db1\u0dcf\u0da7 \u0dc1\u0dc0\u0db1\u0dcf\u0dba\u0db8\u0dca\u0daf\u0dca\u200d2 \u0dc1\u0db8\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dad\u0dad\u0dd2\u0d9a\u0dba \u0dba\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca?\n\n\u0da2\u0dcf\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0d9a\u0dd4\u0dc0\u0db1\u0dcf \u0d85\u0dbb \u0dc1\u0db4 \u0dc1\u0d9c\u0dd2\u0dba \u0dbb\u0dd6\u0db4\u0dc0\u0dcf\u0dc4\u0dd2\u0db1\u0dd3 \u0db1\u0dcf\u0dcf\u0dc5\u0dd2\u0dba\u0dcf\u0dc1\u0dda \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2\u0d9a \u0dc3\u0dcf\u0dba\u0dca\u0da1\u0dcf\u0dc1\u0dda\u0daf\u0dd3 \u0d9a\u0dd2\u0dba\u0db1\u0dcf\u0dc0\u0dcf \u0db1\u0db1 \u0d85\u0dc4\u0dc1\u0d9c\u0db1\u0dcf \u0dc4\u0dd2\u0dd2\u0dba\u0dcf2 \u0d91\u0dd4\u0dc0\u0db1\u0dcf \u0dc0\u0dd2 \u0dc0\u0dcf\u0dc3 \u0dba\u0dbb\u0db1\u0dca\u0db1\u0dcf \u0d9a\u0dd2\u0dba \u0dcf. \u0d91\u0dd4\u0dc0\u0db1\u0dcf \u0dc0\u0dd2 \u0dc0\u0dcf\u0dc3 \u0dba\u0dbb \u0dc1\u0daf\u0dca\u200d\u0db1\u0dca\u0db1\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db1 \u0d91\u0dd4\u0dc0\u0db1\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf2 \u0dc1\u0db8\u0dca project \u0d91\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc02 \u0da2\u0dd2\u0da7\u0dbd\u0da7 \u0d86\u0dba\u0dbb;\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0dc0\u0dd2\u0dc2\u0dba\u0dcf\u0db1\u0dd4\u0db6\u0dc1\u0db0 \u0daf\u0dca\u200d\u0dd0\u0db1\u0dd4\u0db1\u0dc2\u0dab \u0dad\u0dd2\u0d9a\u0dc1\u0db6\u0db1\u0dcf \u0dc4\u0dcf\u0db1\u0dca\u0dc3 \u0dc0\u0dd2\u0da2\u0dcf\u0dba\u0dd6 \u0dbb\u0dd2\u0dba \u0db1\u0dc4\u0dca\u0db1\u0dba\u0dcf\u0dc0 \u0dc0\u0dd2 \u0dc0\u0dcf\u0dc3 \u0dba\u0dbb\u0db1\u0dca\u0db1\u0dcf \u0d9a\u0dd2\u0dba \u0dcf. \u0da2\u0dcf\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0d9a\u0dd4\u0dc0\u0db1\u0dcf \u0dc1\u0dba\u0dcf\u0dc1\u0dc4\u0dcf\u0db1\u0daf\u0dca\u200d2 \u0dc4\u0dcf\u0db1\u0dca\u0dc3 \u0dc0\u0dd2\u0da2\u0dcf\u0dba\u0dd6 \u0dbb\u0dd2\u0dba \u0d9c\u0dd0\u0db1\u0dcf \u0dcf\u0dbb\u0dd2\u0dad \u0dc3\u0dc4\u0dad\u0dd2\u0d9a\u0dba \u0dc1\u0daf\u0dca\u200d\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0d91\u0dc1\u0dc4\u0db1 \u0dcf\u0dbb\u0dd2\u0dad \u0dc3\u0dc4\u0dad\u0dd2\u0d9a\u0dba \u0dc1\u0daf\u0dca\u200d\u0db1\u0dca\u0db1\u0dcf \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0daf\u0dca\u200d? \u0da2\u0dcf\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0d9a\u0dd4\u0dc0\u0db1\u0dcf \u0dc0\u0dd2 \u0dc0\u0dcf\u0dc3 \u0dba\u0dbb\u0db1\u0dca\u0db1\u0dcf \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0dc1\u0db1\u0dcf\u0dba\u0daf\u0dca\u200d2 \u0da2\u0dcf\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0d9a\u0dd4\u0dc0\u0db1\u0dcf\u0da7 \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0dca \u0da2\u0dcf\u0db1\u0dcf\u0dad\u0dcf\u0dc0 \u0da1\u0db1\u0dca\u0daf\u0dca\u200d\u0dba \u0daf\u0dd3 \u0dcf \u0dad\u0dd2\u0d9a\u0dc1\u0db6\u0db1\u0dcf\u0dc0\u0dcf. \u0d92\u0dba \u0dc4\u0dbb\u0dd2. \u0d91\u0dd4\u0dc0\u0db1\u0dcf \u0dba\u0db8\u0dca \u0da2\u0dcf\u0db1\u0dcf\u0dad\u0dcf \u0dc0\u0dd2 \u0dc0\u0dcf\u0dc3\u0dba\u0dc2\u0dab \u0db1\u0dad \u0db6 \u0dba\u0da7\n\n2021 2022\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc0\u0dc0"
  },
