\u0db1\u0ddc\u0db82\u0dad\u0dca \u0db1\u0dd0\u0db1\u0dd0. \u0d9a\u0dd2\u0db1 \u0dca 2\u0dad\u0dca\u0dc1\u0dad\u0dca 2\u0dd0\u0da9 \u0d9a\u0dba\u0dca \u0dc1\u0dca \u0db8 \u0db1\u0dd0\u0db1\u0dd0. \u0db1\u0dd2\u0dda\u0db6\u0dca\u0d9c 2\u0dad\u0dca\u0dad \u0db4\u0dd0\u0dad\u0dca\u0dad\u0da7 \u0d91\u0daf\u0dca\u0dbb\u0dd2 2\u0dd0\u0da9 \u0d9a\u0dba\u0dca \u0dc1\u0dca \u0db8 \u0db1\u0dd0\u0db1\u0dd0. \u0d87\u0dca \u0dc1\u0dca \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dcf\u0dd4\u0d9a \u0dc3\u0d82\u0da0\u0dd2\u0dba\u0d9a 2\u0dba\u0dd2\u0db4\u0dd2\u0dba\u0dba\u0da7 \u0db4\u0dd4\u0dc0 \u0daf\u0dd4 \u0dc12 \u0dd2 \u0da7 \u0d85\u0dba \u0dd0\u0dca \u0d87\u0dca \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca 2\u0dad\u0dd42 \u0da7 \u0db1\u0db8\u0dca \u0dc1\u0d9a\u0ddc\u0dc1\u0db1\u0ddc\u0db82\u0dad\u0dca 2\u0dd0\u0da9\u0da7 \u0dba\u0dca \u0dc1\u0dca \u0db1\u0dd0\u0db1\u0dd0. \u0da7 \u0db1\u0dd2\u0dc3\u0dd2 \u0db8\u0dc1\u0da9\u0ddc\u0dca \u0dd2\u0dc0\u0db8 \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca \u0dd4\u0dc0\u0dab\u0dd4\u0d9c \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca \u0db1\u0dd42\u0dba\u0d91\u0dc5\u0dd2\u0dba \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca 2\u0dad\u0dd42 \u0da7 2\u0dd0\u0da9\u0da7 \u0d91\u0db1 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dcf\u0dd4\u0d9a \u0dd2\u0dca \u0db12\u0dd2. \u0dc1\u0db8\u0ddc\u0d9a \u0da7 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dcf\u0dd4\u0d9a\u0dca \u0da7 \u0da2\u0dd32\u0dad\u0dca \u0dc12\u0dca \u0db1 \u0dd2\u0dbd\u0db0\u0dd2\u0dba [ \u0db1\u0dd0\u0db1\u0dd0."
