    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0dc3\u0db8\u0dcf\u0dad\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0d9c\u0db1\u0dd2, \u0d85\u0db4\u0dd2 \u0d85\u0daf \u0dc1\u0db8\u0dca\u0db8 \u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf \u0dad\u0dd4\u0db8\u0dc5 \u0dc0\u0dd2\u0dc1 \u0dc3\u0dc2\u0dc1\u0d9c\u0db1\u0dca\u0db8\u0dcf\u0dad \u0d9a\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dcf \u0d9c\u0dd0\u0db1 \u0d9a\u0dcf\u0dcf\u0dcf \u0d9a\u0dcf\u0dbb\u0db1 \u0dcf. \u0dc1\u0dbd\u0ddd\u0d9a\u0dcf\u0dc1\u0dda \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d85\u0dc1\u0db1\u0d9a\u0dca \u0dc1\u0daf\u0dca \u0dca \u0d91\u0d9a\u0dca\u0d9a\u0dcf \u0db6\u0dbd\u0db1\u0dc1\u0d9a\u0dcf\u0dcf\u0da7, \u0dbb\u0db8\u0dcf\u0dad \u0daf\u0dcf\u0d9c\u0d9a\u0dcf\u0dad\u0dca\u0dc3 \u0d9c \u0dc3\u0dd0\u0db4\u0dba\u0dd3\u0dc1\u0db8\u0dca\u0db8 \u0daf\u0dd3 \u0d85\u0dc1\u0db4\u0dca \u0d9a\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dad\u0dd0\u0db1 \u0d9c\u0dd0\u0db1 \u0d85\u0db4\u0da7 \u0dc3\u0dd1\u0dc4\u0dd3\u0db8\u0dcf\u0dad\u0d9a\u0dcf\u0da7 \u0db4\u0dad\u0dca\u0dc3 \u0dc1 \u0db1\u0dca\u0db1\u0da7 \u0db6\u0dd0 \u0dd0. \u0d9c\u0dbb\u0dd4 \u0dc3\u0db8\u0dcf\u0dad\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0d9c\u0db1\u0dd2, \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0d9c\u0dad\u0dca\u0dc3 \u0d92 \u0d9c\u0dd0\u0db1 \u0daf\u0db1\u0dca\u0db1 \u0dcf. \u0d92\u0d9a\u0dcf\u0da7 \u0d91\u0d9a\u0dca \u0dc1 \u0dc3\u0dad\u0dd4\u0db8 \u0d9a\u0dca \u0dad\u0db8\u0dcf\u0dad\u0dba\u0dd2 \u0dd0\u0da9 \u0db6\u0dd2\u0dc1\u0db8\u0dca\u0db8 \u0dc3\u0dd2\u0daf\u0dd4 \u0db1 \u0dc4\u0dd2\u0d82\u0dc3\u0db1\u0d9c. \u0d91\u0d9c \u0d9a\u0dcf\u0dcf\u0dba\u0dd2\u0d9a\u0dcf \u0dc4\u0dd2\u0d82\u0dc3\u0db1\u0d9c\u0d9a\u0dca \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0db1\u0dca, \u0dcf\u0da0\u0dd2\u0d9a\u0dcf \u0dc4\u0dd2\u0d82\u0dc3\u0db1\u0d9c\u0d9a\u0dca \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0db1\u0dca, \u0db8\u0dcf\u0dad\u0dcf\u0db1\u0dc3\u0dd2\u0d9a\u0dcf \u0dc4\u0dd2\u0d82\u0dc3\u0db1\u0d9c\u0d9a\u0dca \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0db1\u0dca, \u0dd2\u0d82\u0d9c\u0dd2\u0d9a\u0dcf \u0dc4\u0dd2\u0d82\u0dc3\u0db1\u0d9c\u0d9a\u0dca \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0db1\u0dca. \u0d85\u0db4\u0da7 \u0dc3\u0db8\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0dd2\u0db1\u0dca \u0dc1\u0db4\u0dc1\u0db1\u0db1 \u0dcf, \u0dbb\u0dd0\u0d9a\u0dd2\u0d9c\u0dcf \u0dd0\u0dbb \u0d9c\u0dd2\u0d9c \u0d9a\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dcf \u0db1\u0dca\u0dc1\u0d9c\u0db1\u0dca \u0dc3\u0dd2\u0d9c\u0d9c\u0da7 40\u0d9a\u0dca \u0db1\u0dd0 \u0dad \u0dc1\u0dc3 \u0d9c\u0da7 \u0d91\u0db1\u0dca\u0db1 \u0d9a\u0dcf\u0dd0\u0db8\u0dcf\u0dad\u0dad\u0dd2\u0dba\u0dd2, \u0d92 \u0d85\u0d9c\u0da7 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc1 \u0db1 \u0dc1\u0db8\u0dca\u0db8 \u0dcf\u0da0\u0dd2\u0d9a\u0dcf \u0dc4\u0dd2\u0d82\u0dc3\u0db1\u0d9c \u0db1\u0dad\u0dbb \u0dc1 \u0db1 \u0dcf \u0db1\u0db8\u0dca\u0db8. \u0d91\u0dc1 \u0db8\u0dcf\u0dad \u0db1\u0db8\u0dca\u0db8, \u0dc1\u0db8\u0dca\u0db8 \u0dbb\u0dc1\u0da7\u0dca \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dcf\u0d9c\u0da7 \u0d91\u0d9c \u0dc1\u0d9a\u0dcf\u0dcf\u0dba\u0dd2 \u0d86\u0d9a\u0dcf\u0dcf\u0dbb\u0dc1\u0d9c\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dcf\u0daf \u0d9a\u0dd2\u0d9c\u0db1 \u0d91\u0d9a\u0dcf \u0d94\u0db6\u0da7 \u0db4\u0dd0 \u0dd0\u0daf\u0dd2\u0dd2 \u0dc1 \u0db1 \u0dcf \u0dc3\u0dad\u0dd2 \u0d9a\u0dd2\u0d9c\u0dbd\u0dcf \u0db8\u0dcf\u0dad\u0db8\u0dcf\u0dad \u0dc4\u0dd2\u0dad\u0db1 \u0dcf. \u0dbb\u0da2\u0dc1\u0dda \u0dc1\u0dc3\u0dc0\u0dd2\u0d9a\u0dcf\u0dcf \u0d9a\u0dca \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0db1\u0dca, \u0dc1\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dd2\u0d9a\u0dcf \u0d85\u0d82 \u0dc1\u0dda \u0dc1\u0dc3\u0dc0\u0dd2\u0d9a\u0dcf\u0dcf \u0d9a\u0dca \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0db1\u0dca, \u0d91\u0dc1 \u0db8\u0dcf\u0dad \u0db1\u0dd0\u0dad\u0dca\u0dc3\u0db1\u0db8\u0dca\u0db8 \u0d9c\u0dca \u0dc1\u0dc3 \u0dc1\u0dda \u0dc1\u0d9c\u0dc1\u0daf\u0db1\u0dca\u0db1\u0dd2\u0d9c\u0d9a\u0dca \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0db1\u0dca, \u0dc3\u0d9c \u0dbb\u0dd0\u0d9a\u0dd2\u0d9c\u0dcf \u0dc3\u0dc4 \u0dcf \u0db1\u0dd2 \u0dc3\u0dd2\u0db1\u0dca \u0d91\u0dc5\u0dd2\u0d9c\u0da7 \u0d85\u0dd2\u0d9c \u0dad\u0dd2\u0dda\u0db6 \u0dad\u0dd0\u0db1 \u0dc3\u0dd2\u0da7 \u0d91\u0d9c \u0dd0\u0da9 \u0dc1\u0dbd\u0ddd\u0d9a\u0dcf\u0d9c \u0dd0\u0da7\u0dd2\u0d9c\u0da7\n\n1719 1720\n\n\u0dc3\u0dd0\u0dbd\u0dc1\u0d9a\u0dcf\u0db1 \u0dcf. \u0d92\u0d9a\u0dcf \u0db8\u0dcf\u0dad \u0db4\u0dcf\u0dbb \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0db1\u0dca, \u0db6\u0dc3 \u0dbb\u0dcf\u0d9c \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0db1\u0dca, \u0d91\u0dc1 \u0db8\u0dcf\u0dad \u0db1\u0dd0\u0dad\u0dca\u0dc3\u0db1\u0db8\u0dca\u0db8 \u0dc3\u0d9c\u0dc1 \u0dc1\u0dc3 \u0dcf \u0dc3\u0dcf\u0dcf\u0db1\u0d9c \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0db1\u0dca. \u0d9a\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dcf \u0db1\u0dca\u0da7 \u0d91\u0dc1\u0dbb\u0dc4\u0dd2 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc1 \u0db1 \u0dc3\u0dd2\u0d9c\u0dbd\u0dd4 \u0d86\u0d9a\u0dcf\u0dcf\u0dbb\u0dc1\u0dda \u0dc4\u0dd2\u0d82\u0dc3\u0db1\u0d9c \u0dc3 \u0dca\u200d\u0dbb\u0da0\u0dca\u0da9\u0dad\u0dca\u0dc3 \u0d9c \u0dc1\u0db8\u0dca\u0db8 \u0d9a\u0dd2\u0d9c\u0db1 \u0dd0\u0da9\u0db6\u0dd2\u0dc1\u0db8\u0dca\u0db8 \u0daf\u0dd3 \u0d85\u0dba\u0dd2\u0db1\u0dca \u0d9a\u0dcf\u0dbb \u0daf\u0db8\u0dcf\u0dad\u0dcf \u0dc3\u0d9c\u0da7 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0d9a\u0dcf\u0dcf\u0dbb\u0dd3 \u0dc1\u0dbd\u0dc3 \u0dd0\u0da9 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dcf\u0dad\u0da7 \u0db4 \u0dc3\u0dd4 \u0da7\u0db4\u0dd2\u0da7\u0dcf \u0d9a\u0dca \u0daf\u0dcf \u0daf\u0dd3\u0dc1\u0db8\u0dca\u0db8 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dbd\u0d9c \u0db1\u0dd0 \u0dad \u0dbd\u0dd0\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0db8\u0dca\u0db8 \u0dbb\u0dc1\u0da7\u0dca \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dcf\u0d9c\u0da7 \u0d9a\u0dd2\u0d9c\u0db1 \u0d91\u0d9a\u0dcf \u0db8\u0dcf\u0dad\u0dad\u0d9a\u0dca \u0d9a\u0dcf\u0dbb\u0dd2\u0dba\u0db1\u0dca, 190\u0dc1 \u0db1\u0dd2 \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0dad\u0dd2\u0d9c -Convention No. 190 - \u0db6\u0dbd\u0dcf\u0dad\u0dca\u0dc3\u0db8\u0dcf\u0dad\u0d9a\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dcf\u0dad \u0dc3\u0dc4 \u0dcf \u0dc1\u0db8\u0dcf\u0dad\u0db8\u0dcf\u0dad \u0dc1\u0d9c\u0ddd\u0da2\u0db1\u0dcf \u0db8\u0dcf\u0dad\u0dcf \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0dca\u0db8\u0db1\u0dca\u0dad\u0dd4\u0db8 \u0da7 \u0dbd\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dc3 \u0d9a\u0dcf\u0dbb\u0db1 \u0dcf.\n\n\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0dcf\u0dad\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0db1\u0dd2, \u0d92 \u0d85\u0db1\u0dd4 \u0d85\u0daf \u0daf\u0dd2\u0db1 \u0dc3\u0db7\u0dcf \u0d9a\u0dcf\u0dca \u0dad\u0db6\u0db1 \u0d85 \u0dc3\u0dcf\u0dcf\u0dc1\u0dda \u0db8\u0dcf\u0dad\u0dcf \u0db4 \u0dad \u0dc3\u0dc4 \u0db1\u0dca \u0dc1\u0d9c\u0ddd\u0da2\u0db1\u0dcf \u0dbd\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dc3 \u0d9a\u0dcf\u0dbb\u0db1 \u0dcf:\n\n\u0db4\u0dc3\u0dd3 \u0db4\u0dd4\u0dbb\u0dd4\u0dc2 \u0dc3\u0db8\u0dcf\u0dad\u0dcf\u0da2\u0db7\u0dcf \u0d9c \u0db8\u0dcf\u0dad\u0dad \u0db4\u0daf\u0db1\u0db8\u0dca\u0db8 \u0dc0\u0dd6 \u0dca\u200d\u0dbb\u0da0\u0dca\u0da9\u0dad\u0dca\u0dc3 \u0dc1\u0d9c\u0db1\u0dca \u0dcf \u0dc4\u0dd2\u0d82\u0dc3\u0db1\u0dc1\u0d9c\u0db1\u0dca \u0dc1\u0dad\u0dcf\u0dbb \u0dd0\u0da9 \u0dc1\u0dbd\u0ddd\u0d9a\u0dcf\u0d9c\u0d9a\u0dcf\u0da7 \u0dc3\u0dd0\u0db8\u0dcf\u0dad\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9c \u0db3\u0dd4\u0db1\u0dcf \u0d9c\u0db1\u0dd2\u0dd2\u0dba\u0db1\u0dca 2019 \u0da2\u0dd6\u0db1\u0dd2 21 \u0daf\u0dd2\u0db1 \u0dc3\u0dc0\u0dd2\u0dc3\u0da7\u0dbb\u0dca\u0dbd\u0db1\u0dca\u0dad\u0dc1\u0dda \u0da2\u0dd2\u0db1\u0dd3 \u0dcf\u0dc4\u0dd3\u0daf\u0dd3, \u0da2\u0dcf\u0dad\u0dba\u0db1\u0dca\u0dad\u0dbb \u0d9a\u0dcf\u0db8\u0dca\u0db8\u0d9a\u0dcf\u0dbb\u0dd4 \u0dc3\u0db8\u0dca\u0db8\u0dc1\u0db8\u0dca\u0db8\u0dbd\u0db1\u0dc1\u0dda 108 \u0dc1 \u0db1\u0dd2 \u0dc3\u0dd0\u0dc3\u0dd2\u0dc1\u0dda \u0daf\u0dd3 \u0dd0\u0da9 \u0dc1\u0dbd\u0ddd\u0d9a\u0dcf\u0dc1\u0dda \u0dca\u200d\u0dbb\u0da0\u0dca\u0da9\u0dad\u0dca\u0dc3 \u0d9c \u0dc3 \u0dc4\u0dd2\u0d82\u0dc3\u0db1\u0d9c \u0dd4\u0dd2\u0db1\u0dd4\u0db4\u0dd4\u0da7\u0dcf \u0daf\u0dd0\u0db8\u0dd3\u0db8\u0dcf\u0dad \u0dcf \u0dc3\u0db8\u0dca\u0db8\u0db6\u0db1\u0dca\u0dca\u200d \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0dad\u0dd2\u0d9c C 190 \u0dc3\u0db8\u0dca\u0db8\u0db8\u0dcf\u0dad\u0dad \u0d9a\u0dcf\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dbd\u0daf\u0dd2."
