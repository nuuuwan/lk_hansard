    "chunk_text": "\u0d85\u0db4\u0dd2 2024 \u0dc0\u0dbb\u0dca\u0dae\u0dc2\u0dc1\u0dc0 \u0d86\u0dca\u0dda\u0db7 \u0d9a\u0dc5\u0dcf, \u0dc0\u0dba\u0db9 \u0db4\u0dc5\u0dcf\u0dc1\u0db8\u0d9a \u0db4\u0dca\u200d\u0dbb\u0db0\u0dca\u200d\u0dcf \u0dc4\u0d82\u0da0\u0dcf\u0dca\u0d9a \u0dc4\u0d82\u0dc0\u0dbb\u0dca\u0dae\u0db0\u0dca\u200d \u0dc4\u0dd0\u0dbd\u0dd0\u0dc4\u0dda\u0db8 \u0dc4\u0dda\u0db4\u0dcf\u0daf \u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dda \u0d9a\u0da7\u0dba\u0dd4\u0db8\u0d9a\u0dad. 2025 \u0dc0\u0dc4\u0dc1\u0dbb\u0dca\u0dae \u0d85\u0db4\u0dd2 \u0d92 \u0d9a\u0da7\u0dba\u0dd4\u0db8\u0d9a\u0dad \u0d85\u0dc0\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dca\u0db1\u0dca\u0dad \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0dcf\u0dc1\u0dca\u0dcf\u0db8\u0d9a\u0dd4 \u0dc1\u0dc0 \u0dc0\u0dcf. \u0d92 \u0dc4\u0db3 \u0dcf \u0d85\u0db4\u0dd2 \u0dc1\u0dda \u0dc0\u0dc4\u0dc1\u0dbb\u0dca\u0dae\u0daf\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dba 8\u0dc2\u0dab \u0dc1\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dca\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6 \u0dc0\u0dcf. \u0dc1\u0dda \u0dc0\u0dc4\u0dc1\u0dbb\u0dca\u0dae \u0dc0\u0dba\u0db9 \u0db4\u0dc5\u0dcf\u0db8\u0d9a \u0dc4\u0db7\u0dcf\u0dc1\u0dda \u0dc4\u0d82\u0da0\u0dcf\u0dca\u0d9a \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dd4\u0db8\u0d9a \u0db4\u0dc5\u0dcf\u0db8\u0d9a \u0dc4\u0db7\u0dcf\u0dc0 \u0dca \u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dba 100\u0d9a\u0da7 \u0d85\u0db0\u0dd2\u0d9a \u0db8\u0dd4\u0daf\u0dbd\u0dc2\u0dab \u0dc1\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dca\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6 \u0dc0\u0dcf, \u0dc4\u0d82\u0da0\u0dcf\u0dca\u0d9a \u0dc4\u0d82\u0dc0\u0dbb\u0dca\u0dae\u0db0\u0dca\u200d \u0dba\u0da7 \u0dc4 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0dae\u0db0\u0dca\u200d \u0dba\u0da7. \u0d8a\u0da7\u0db8\u0d9a \u0d85\u0db8\u0dad\u0dca\u0dc0 \u0db8\u0db8 \u0d85\u0dca \u0d9a\u0dd2\u0dba\u0dc0\u0dad \u0dc0\u0dba\u0dcf\u0db4\u0dca\u0dad\u0dd2\u0dba \u0dca \u0dcf \u0d85\u0db4\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dba \u0d9c\u0dba \u0dcf\u0dc0\u0dc2\u0dab \u0dc0\u0dba\u0db9 \u0db4\u0dc5\u0dcf\u0dad \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dca\u0db1\u0dca\u0dad \u0dc0\u0dad\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad.\n\n\u0dc4\u0d82\u0da0\u0dcf\u0dca\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0dad\u0dc1\u0d9c\u0db1\u0dca\u0dad \u0dba\u0dda\u0d9a\u0dd2\u0dc3\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dba\u0dba\u0dc2\u0dab \u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc1 \u0dba\u0da7 \u0d86\u0d9a\u0dbb\u0dca\u0dae\u0dc2\u0dba\u0dba \u0d9a\u0dca \u0d9c\u0db1\u0dca\u0dad \u0da7 \u0d85\u0db4\u0dd2 \u0d9a\u0dbd\u0dca\u0db4 \u0dcf \u0d9a\u0dca \u0dc0\u0dcf. \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dc1\u0dba\u0db1\u0dca\u0dad\u0db8 \u0db8\u0db8 \u0dc4\u0db3 \u0db1\u0dca\u0dad \u0d9a\u0dca\u0db1\u0dca\u0dad \u0d85\u0dc0 \u0dba\u0dba\u0dd2, \u0dc0\u0dd2\u0dbd\u0dca\u0db4\u0db8\u0d9a\u0dd4 \u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0dc0\u0dc1 \u0ddd\u0daf\u0dba\u0dcf \u0dba \u0dc1\u0dbd\u0ddd\u0d9a \u0db4\u0dca\u200d\u0dbb\u0d9a\u0da7 \u0dc4\u0d82\u0da0\u0dcf\u0dca\u0d9a \u0dc1\u0dc2\u0dab\u0db1\u0dca\u0dad\u0dbb\u0dc4\u0dda\u0dae\u0dcf \u0dba\u0dc2\u0dab \u0db6\u0dc0\u0da7 \u0db4\u0db8\u0d9a \u0dc1\u0dc0\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dad\u0dd2\u0dc1\u0db6 \u0db6\u0dc0. \u0d8a\u0dc1\u0dc0\u0db8\u0d9a \u0d85\u0db4\u0dd2 \u0db8\u0db1\u0dca\u0dad \u0dcf\u0dca\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dc1 \u0dc1\u0dc0 \u0db1\u0dd2\u0dbb\u0dd3\u0dc2\u0dab\u0dc2\u0dba \u0da0\u0dcf\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0d9a \u0db1\u0dd2\u0dca\u0dad \u0dc0\u0dd4\u0dba\u0dcf, \u0db4\u0dbb\u0dd2\u0dc4\u0dca \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0dcf\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dd4\u0db8\u0dcf\u0db8\u0d9a \u0d9a\u0dc2\u0dab\u0d9a. \u0dca\u0daf\u0dd2\u0dbb\u0dd2\u0dc1\u0dc0\u0daf\u0dd3 \u0d9a\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0d9a\u0dd4\u0dbd\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dc1 \u0dc1\u0dba\u0db1\u0dca\u0dad, \u0dc0\u0dad\u0db8\u0d9a\u0dad\u0dbd\u0db8 \u0daf\u0dd2\u0dc4\u0dcf\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dbd\u0dca\u0db4\u0db8\u0d9a\u0dd4 \u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0dc0\u0dc1 \u0ddd\u0daf\u0dba\u0dcf \u0dba\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda \u0db8\u0dcf\u0dbb\u0dca\u0dae\u0d9c\u0dba\u0dc2\u0dab \u0dc4\u0dd0\u0dbd\u0dc3\u0dd4\u0dda \u0d9a\u0dca\u0db1\u0dca\u0dad - \u0db1\u0dd2\u0dbb\u0dca\u0dae\u0db8\u0dcf\u0dba\u0dba \u0d9a\u0dca\u0db1\u0dca\u0dad - \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0dcf\u0dc1\u0dca\u0dcf\u0db8\u0d9a\u0dd4 \u0dc1\u0dc0 \u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0d9a\u0dbd\u0dca\u0db4 \u0dcf \u0d9a\u0dca \u0dc0\u0dcf, \u0dc1\u0dda \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0dca \u0dcf \u0dc0\u0dba\u0db9 \u0db4\u0dc5\u0dcf\u0dad \u0dc1\u0dc2\u0dab\u0db1\u0dca\u0dad\u0dbb \u0d9a\u0dca \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dc4\u0d82\u0da0\u0dcf\u0dca\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dd2 \u0dcf\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dba\u0dba\u0dc2\u0dab \u0d86\u0d9a\u0dbb\u0dca\u0dae\u0dc2\u0dba\u0dba \u0d9a\u0dca \u0d9c\u0db1\u0dca\u0dad \u0d85\u0db4\u0da7 \u0dc0\u0dad\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0dc0\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf."
  },
