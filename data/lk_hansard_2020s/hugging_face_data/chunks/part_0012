\u0d86\u0dc3\u0dc0\u0dc1\u0dda \u0dc4\u0dc3\u0d9a \u0dc0\u0dad\u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dc0\u0dcf. \u0dc1\u0db8\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc1\u0dda \u0dc4\u0dd2\u0da7\u0db4\u0dd4 [\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0db1\u0d9a\u0dd4 \u0dc0\u0dc0 \u0dad\u0dd2\u0dc3\u0dca\u0dc3 \u0d85\u0dad\u0dca\u0dad\u0dc0\u0dcf\u0db1 [\u0dad\u0dad\u0dd2\u0dad\u0dd4\u0db8[\u0dcf \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0db1 \u0dcf\u0d9a\u0dc1\u0dda \u0d94\u0db1 \u0dc4\u0dc3\u0d9a \u0dc0\u0dad\u0dc1\u0dda \u0dc1\u0dbb\u0ddc\u0db1\u0dca [\u0da9 \u0dc1\u0d9c\u0ddc\u0da9 \u0daf\u0dca\u200d[\u0dc0\u0dc0\u0dcf \u0dbb\u0dd3\u0db1\u0d9a\u0dcf \u0d92 \u0da7 \u0db8\u0dd2\u0dbd\u0dd2\u0db1\u0dc0 \u0d9c\u0dab\u0dc0\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0dbb\u0dc1\u0d9c\u0dc0 \u0dc1\u0dbb\u0ddc\u0db1\u0dca [\u0da9 \u0d85\u0dd2 \u0db1\u0dca \u0dbb\u0dc0\u0dc0\u0dcf \u0dc1\u0dc0\u0db1\u0dd4\u0dc0\u0da7 \u0d92 \u0dc0\u0dad\u0dc1\u0dda [\u0dad\u0dab\u0dd2\u0d9a\u0dca \u0dc4\u0dcf\u0dbb\u0db4\u0dd4 \u0d91 \u0dad[\u0dd2 \u0dc1\u0dc5\u0dda. \u0d92 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc0\u0d9a\u0da7 \u0dc0\u0dcf\u0db1 \u0dad\u0dca\u0dc0\u0db1 \u0daf\u0dd3\u0db4\u0dd4 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0db1 \u0d85\u0daf\u0dca\u200d \u0dc1[\u0dad\u0dad\u0dc0 \u0d89\u0db3\u0dc1\u0d9c\u0dc0 \u0d85\u0db4\u0da7 \u0db5\u0d9a\u0daf\u0dca\u200d\u0dcf\u0dd2 \u0dc1\u0d9a\u0dc3 \u0dc1\u0db8\u0dca \u0d89\u0da9\u0db8\u0dca \u0dc1\u0db1\u0ddc\u0daf\u0dca\u200d\u0dcf\u0d9c\u0db1\u0dca\u0dc0\u0dcf \u0dca\u200d\u0dbb[ \u0d9c\u0dad\u0dc0 \u0dbb\u0dd3\u0db1\u0dc0\u0dc0\u0dcf. \u0d89\u0dad\u0dd2\u0db1\u0dca, \u0dc1[\u0dc0\u0dad\u0db1\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0db1 \u0dad[\u0dd2 \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0d89\u0da9\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dca\u200d\u0dbb \u0dca\u0dc0\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca.\n\n2237 2238\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\n\n[\u0da7 \u0dad\u0dc0 \u0dcf\u0dbb\u0dab\u0dcf\u0dc0\u0d9a\u0dca \u0dbb\u0dd3\u0db1\u0db1\u0dca\u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dc0\u0dcf, \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dc1\u0db1\u0db1\u0dca \u0dc0\u0dc0\u0dc3\u0dad\u0dca\u0dc0 \u0dda\u0dc0\u0daf\u0dd4\u0dbb \u0d9c\u0dad\u0dc0. \u0d85\u0db4\u0dd2 \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0dc1 \u0ddc\u0da0\u0dca\u0da0\u0dbb \u0d86\u0dc4\u0dcf\u0dbb \u0dc1\u0db7\u0ddd\u0d9c \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0dca\u200d\u0dc0\u0db1 \u0dc5\u0dad\u0dca, \u0d9c\u0dab\u0dc0\u0db1 \u0dbb\u0d9a\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0dc0 \u0dc0\u0dd2\u0db0\u0dd2\u0db1\u0da7 \u0d92 \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0dca\u200d\u0dc0\u0dc1\u0db1\u0db1\u0dca \u0dc3\u0dd2\u0db1\u0db1\u0da7 35 , 40 \u0dca\u200d\u0dbb[\u0dcf\u0dab\u0db1\u0d9a\u0dca \u0dc0\u0dc0\u0dc3\u0dad\u0dd4\u0db8\u0db1\u0dca \u0db4\u0dbb\u0dd2\u0dc1\u0db7\u0ddd\u0da2\u0dc0\u0db1 \u0dbb\u0dc0\u0dc0\u0dcf \u0dbb\u0dd3\u0db1\u0d9a\u0dcf \u0d85\u0db4\u0dd2 \u0daf\u0dca\u200d\u0db1\u0dca\u0dc0\u0dc0\u0dcf. \u0d85\u0dbd\u0dd2\u0db1\u0dcf\u0dc1\u0d9c\u0db1\u0dca \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0dc1\u0dc0\u0ddc\u0dc1\u0dc0\u0dd2 . \u0dbb\u0dd2\u0dc5\u0dc0\u0dcf, \u0dc0\u0db3\u0dd4\u0dbb\u0dcf, \u0daf\u0dca\u200d\u0da9\u0dd4\u0dc1\u0dbd\u0dca\u0dc0\u0dcf, \u0d8c\u0dbb\u0dcf, \u0d89\u0dad\u0dca\u0dad\u0dd1\u0dc0\u0dcf, \u0db8\u0dd4\u0dc0\u0dcf, \u0dd1\u0daf\u0dca\u200d\u0dad\u0dad\u0dca\u0dad\u0dcf \u0d86\u0daf\u0dd2 \u0dc3\u0dd2\u0db1\u0dbd\u0dd4 \u0dc3\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dc1\u0d9c\u0db1\u0dca \u0dc3\u0dd2\u0daf\u0dca\u0db0 \u0dc0\u0dc0 \u0dc4\u0dcf\u0db1\u0dd2\u0db1 \u0dc0\u0dc5\u0d9a\u0dca\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1 \u0ddc\u0dc1\u0dc4\u0ddc[\u0daf\u0dca\u200d \u0dbb\u0dd3\u0db1\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dd2 \u0da2\u0dc0 \u0db6\u0d9a\u0dc1\u0dda\u0d9c\u0db1 \u0d86\u0dca\u0da9\u0da9\u0dd4\u0dc1\u0dda \u