    "chunk_text": "\u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0dda \u0dc3\u0db8\u0dc3\u0dbb\u0dad \u0daf\u0dc5 \u0dc1\u0daf\u0dca\u0dc1\u0dd3\u0dc3 \u0db1\u0dc2\u0dbb\u0db4\u0dcf\u0daf\u0dd2\u0dad\u0dc3\u0da7 \u0db0\u0dd3\u0dc0\u0dbb \u0dbd\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dc1\u0dda \u0daf\u0dcf\u0dc3\u0dbd\u0dad\u0dca\u0dc0\u0dc3 \u0dc1\u0dbd\u0dcf\u0db4\u0db8\u0dc3\u0daf \u0dbb\u0dd3\u0dc3\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d9a \u200d\u0dbb\u0db8\u0dcf\u0dc3\u0dc3 2000 \u0d85\u0dd4\u0dab\u0dbb\u0dd4\u0daf\u0dca\u0dc1\u0daf\u0dca \u0dd2\u0daf\u0dc3\u0dc3\u0da7 2.3\u0dba\u0dd2. \u0db4\u0dc3\u0dd4\u0db1\u0dd2\u0dc3 \u0dbd\u0dcf\u0dbd\u0dc3 \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0d91\u0dc3 \u0dd2\u0daf\u0dc3\u0dc3\u0da7 \u0d91\u0dbd\u0da7 \u0d85\u0da9\u0dd4 \u0dd4\u0dab\u0dc3\u0dcf. \u0d85\u0db4\u0dd2 \u0dbb\u0dd3\u0dc3\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dc3\u0da7 \u0d9a \u200d\u0dbb\u0db8\u0dcf\u0dc3\u0dc3 \u0dc3\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dbb \u0dc1\u0dc1\u0dca\u200d\u0dbb\u0dab\u0dd2\u0dc1\u0dda \u0daf \u0db8 \u0d91\u0dc1\u0d9a\u0dca\u0d9a\u0dc0 \u0dc1\u0db4\u0dcf\u0dd4 \u0d85\u0db1\u0dca\u0dad\u0dbb\u0dc1\u0dc3\u0db1\u0dca \u0d85\u0da9\u0dd4\u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0dc1\u0dda \u0dbb\u0d86\u0dc3 \u0dc3\u0da7\u0dc1\u0dad\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0db4\u0dc3\u0dbb \u0d85\u0dd4\u0dab\u0dbb\u0dd4\u0dd4 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dbb\u0db8 \u0dd4\u0dc0\u0dc5 \u0dd2\u0daf\u0dc3\u0dc3\u0da7 \u0d91\u0dbd\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0daf\u0dc5 \u0dc1\u0daf\u0dca\u0dc1\u0dd3\u0dc3 \u0db1\u0dc2\u0dbb\u0db4\u0dcf\u0daf\u0dd2\u0dad\u0dc3\u0da7 \u0daf\u0d9a\u0dca\u0d9a\u0dc0\u0dc0\u0db1 \u0db0\u0dd3\u0dc0\u0dbb \u0dbd\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dc1\u0dda \u0daf\u0dcf\u0dc3\u0dbd\u0dad\u0dca\u0dc0\u0dc3 \u200d\u0dbb \u0dc3\u0dbb\u0dad \u0db8\u0dda\u0da7\u0db8\u0dbd\u0da7 \u0d9c\u0db1\u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd4\u0db8\u0dca \u0dbd\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d9a\u0dbd \u0dc1\u0db6\u0dcf\u0dc1\u0dc4\u0dcf\u0db8 \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dba\u0dd2. \u0dc1\u0db8\u0dcf\u0dbd\u0daf, \u0dc1\u0db8\u0dc0\u0dbb \u0d85\u0dc3 \u0dc0\u0dd0\u0dc1\u0dc3\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0dbb\u0dd4\u0db4\u0dd2\u0dc3\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dc3\u0db1 11,440\u0d9a\u0dca\u0d9a\u0dc0 \u0db0\u0dd3\u0dc0\u0dbb \u0dbd\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dc3\u0da7 \u0dc1\u0dc0\u0db1\u0dca\n\n1037 1038\n\n[\u0d9c\u0dbb\u0dd4 \u0daf\u0dd2\u0dd2\u0dda \u0dc1\u0dc0\u0daf\u0d9a\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0db8\u0dc4\u0dad\u0dcf]\n\n2025 \u0db8\u0dcf\u0dbb\u0dca\u0dd4\u0dc0 05"
  },
