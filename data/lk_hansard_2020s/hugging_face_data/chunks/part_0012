    "chunk_text": "\u0d9c\u0dc0 \u0dc3\u0db7\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db1\u0db4\u0dad \u0db1\u0db8\u0dca \u0dc1\u0db1\u0da7 \u0d85\u0db4\u0da7 \u0db4\u0dd2\u0dca\u0d9c\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd42 \u0db1\u0dd22\u0dd2\u0da9\u0dd4 \u0dc1 \u0dca \u0db1 \u0db1\u0db1,. \u0dc1\u0db8\u0ddc\u0d9a \u0dc1\u0db1\u0da7 \u0d8b\u0dc1\u0daf\u0dca ].00 \u0dd2\u0db3\u0dca ].05 2\u0db1\u0d9a\u0dca \u0dc3\u0d82\u0d9c\u0da7\u0db1\u0dba \u0dad\u0dd2\u0dc1\u0db6\u0db12\u0dd2. \u0db4\u0dad\u0dc5\u0dd2 2\u0db3\u0dd4\u0dc0 \u0dc3\u0d82\u0d9c\u0da7\u0db1\u0dba\u0da7 \u0d85\u0db4\u0dd2\u0dad\u0dca \u0dba\u0dca \u0db1 \u0db1\u0db1,. \u0d91\u0dc1\u0db1\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0d85\u0db4 885\u0dc1 \u0db1\u0dd2\u0dad\u0dca \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dba \u0dd2 \u0db8\u0dba\u0dd2 \u0da7 \u0d9c\u0da7\u0db1\u0da7. \u0dc1\u0db8\u0dca 885\u0dad\u0dca \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dba\u0dca \u0db1 \u0d9a\u0dd2\u0dba\u0dd2\u0dd2\u0dbd \u0da7 \u0d9c\u0da7\u0db1\u0da7. \u0dc1\u0db8\u0dca \u0dba\u0dc1\u0da7\u0dca \u0dd2\u0dbd \u0dd2 \u0dd2\u0dbd\u0dba \u0db8 [ \u0d9a\u0dba \u0dd2 \u0dc3\u0d82\u0d9c\u0da7\u0db1\u0dba [ \u0d9a\u0dba\u0db1 \u0dc1\u0d9a\u0ddc\u0da7 \u0d85\u0dc1\u0dda 2\u0dad\u0dd42 \u0d85\u0dc1\u0dda \u0dd2\u0da9\u0db8\u0dca2 \u0d85\u0dc1\u0dda \u0dc1\u0d9c2\u0dad\u0dca\u0dc1\u0dad\u0dca \u0da72\u0dd2 \u0d9a\u0db8\u0dca \u0d9c\u0da7\u0dca \u0d9a\u0dba\u0dca \u0dc1\u0dca ; \u0d85\u0db4\u0dd2 885\u0dc1 \u0db1\u0dd2\u0dc1 \u0dd2\u0da9\u0db8\u0dca2 \u0da72\u0dd2 \u0d9a\u0db8\u0dca \u0d9c\u0da7\u0dca \u0d9a\u0dba\u0dca \u0dc1\u0dca ? \u0da7 \u0db1\u0dd2\u0dc3\u0dd2 \u0d85\u0db4\u0da7\u0dad\u0dca \u0dc1\u0db1\u0da7 \u0db4\u0dd2\u0dca\u0d9c\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd42 \u0db1\u0dd22\u0dd2\u0da9\u0dd4 \u0dc1 \u0dca \u0db1 \u0db1\u0db1,.\n\n\u0d9c\u0dc0 \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dc1\u0db8\u0dca \u0d85\u0db8\u0dd2\u0dad\u0dba\u0dd2\u0d82 \u0dba \u0dc1\u0db1\u0dd