    "chunk_text": "\u0d85\u0db4\u0dd2 \u0d91\u0dad\u0dd0\u0db1\u0dd2\u0dca \u0d91\u0dc4\u0dcf\u0da7 \u0dba\u0db8\u0dd4. \u0d8a \u0d9f \u0d91\u0d9a \u0dad \u0dd2, \u0db4\u0dd4\u0db1\u0dbb\u0dca\u0da2\u0db1\u0db1\u0dd3\u0dba \u0db6\u0dbd \u0d9a\u0dca\u0dad\u0dad\u0dd2\u0dba. \u0d85\u0db4\u0dd2 \u0db4\u0dd4\u0db1\u0dbb\u0dca\u0da2\u0db1\u0db1\u0dd3\u0dba \u0db6\u0dbd \u0d9a\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9c\u0dd0\u0db1 \u0d9a\u0dcf\u0dcf \u0d9a\u0dbb\u0db1 \u0dc1\u0d9a\u0dcf\u0da7 \u0dd2\u0dbb\u0dba\u0dca\u0db1 \u0d95\u0db1\u0dd1, \u0d85\u0dc1\u0db4\u0dca\u0db4 \u0dbb\u0da7 \u0d9a\u0dd4\u0da9\u0dcf \u0dbb\u0da7\u0d9a\u0dca\u0dad, \u0d85\u0db4\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d89\u0da9\u0db8\u0dca \u0dc3\u0dd3\u0db8\u0dd2\u0dad\u0dd2 \u0dd2\u0dbb\u0dba\u0db1 \u0d91\u0d9a. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d92 \u0d89\u0da9\u0db8\u0dca \u0d9a \u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0dd2\u0dbb\u0dba\u0db1 \u0d91\u0d9a \u0d85\u0dad\u0dba\u0dc0 \u0dba\u0dd2. \u0d85\u0db4\u0dd2 \u0d89\u0da9\u0db8\u0dca \u0d9a \u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0dd2\u0dbb\u0dba\u0db1 \u0d91\u0d9a \u0dad \u0db4\u0daf\u0db1\u0db8\u0dca \u0dc1\u0dc0\u0dbd\u0dcf, \u0d9a\u0dd8\u0dd2\u0d9a\u0dbb\u0dca \u0dba\u0da7 \u0dc0\u0da9\u0dcf \u0dba\u0dc4\u0db4\u0dad\u0dca \u0d89\u0da9\u0db8\u0dca \u0dc1 \u0dcf\u0db1\u0dc0\u0dcf\u0daf, \u0d9a\u0dbb\u0dca \u0dcf\u0dca\u0dad\u0dc0\u0dbd\u0da7 \u0dc1\u0daf\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d89\u0da9\u0db8\u0dca \u0dc1 \u0dcf\u0db1\u0dc0\u0dcf\u0daf, \u0da2\u0db1\u0dcf\u0dc0\u0dcf\u0dc3 \u0d87\u0dad\u0dd2 \u0d9a\u0dbb\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d89\u0da9\u0db8\u0dca \u0dc1 \u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0dd2\u0dbb\u0dba\u0db1 \u0d91\u0d9a \u0d9c\u0dd0\u0db1 \u0db8\u0dd6\u0dbd\u0dd2\u0d9a \u0d85\u0dcf\u0dba\u0dba\u0db1\u0dba\u0d9a\u0dca\u0dad \u0d9a\u0dbb\u0dbd\u0dcf, \u0d85\u0db4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db1 \u0d9a\u0dbd\u0dcf\u0db4 \u0dad\u0dd4\u0db1\u0d9a\u0da7 \u0dbd\u0dc0\u0d9a\u0dcf\u0dc0 \u0dc1\u0db6\u0daf\u0dcf \u0dc1\u0dc0\u0dca \u0d9a\u0dbb\u0dc1\u0d9c\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0db4 \u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0dbd\u0dcf\u0db4\u0dba \u0dad \u0dd2, \u0db4\u0dd4\u0dad\u0dca\u0dad\u0dbd\u0dc1\u0db8\u0dca \u0dc3\u0dd2\u0da7 \u0dba\u0dcf\u0db4\u0db1\u0dba\u0da7. \u0d92 \u0db4 \u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd2 belt \u0d91\u0d9a \u0dad\u0dd4 \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4 \u0dc1 \u0dc1 \u0d9c\u0dcf\u0dc1\u0dc0\u0dcf\u0da8\u0dcf 1,000\u0d9a\u0dca\u0dad \u0db1\u0dd2\u0db4\u0daf\u0dc0\u0dca\u0db1 \u0dc4\u0db3\u0dd4\u0db1\u0dcf \u0dc1\u0d9c\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda , \u0db1\u0dd0 \u0dc1\u0d9f\u0db1\u0dc4\u0dd2\u0dbb \u0dc4\u0dcf \u0dda\u0dad\u0dd4\u0dbb\u0dd4 \u0db4 \u0dcf\u0dad\u0dca\u0dc0\u0dbd \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0db4\u0dc4 \u0d87\u0dad\u0dd4 \u0dad \u0dc1 \u0d9c\u0dcf\u0dc1\u0dc0\u0dcf\u0da8\u0dcf 2,000\u0d9a \u0dc0\u0dc4\u0dbd \u0dad \u0dc3\u0dd6\u0dbb\u0dca\u0dba \u0db6\u0dbd\u0dcf\u0d9c\u0dcf\u0dbb \u0d85\u0db4\u0dd2 \u0d89\u0daf\u0dd2 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda , \u0dc1 \u0dcf\u0db1\u0dbb\u0dcf\u0d9c\u0dbd \u0dc4\u0dcf \u0dc4\u0db8\u0dca\u0db6\u0dca\u0dc1\u0dad\u0dcf\u0da7 \u0dc1\u0d9a\u0dca\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb \u0dc1\u0d9a\u0dcf\u0da7\u0dc1\u0d9c\u0db1 \u0dc3\u0dd6\u0dbb\u0dca\u0dba \u0dc3\u0dc4 \u0dc3\u0dd4 \u0dc0 \u0dca\u0dcf\u0dcf\u0dbb\u0dc1\u0dba\u0dca \u0d85\u0db4\u0dd2 \u0dc4\u0dd2\u0dbb\u0da2\u0dca \u0dc3\u0dc4\n\n737 738\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0dca\u0dad\u0dd4\u0dc0\n\n\u0d87\u0dc1 \u0ddd\u0db1\u0dd2\u0dba\u0dcf \u0db1\u0dd2\u0dc2\u0dda\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d85\u0dca\u0db1, \u0d92\u0d9a \u0d85\u0db4\u0dd2 \u0dd2\u0db0\u0daf\u0dd4\u0dbd\u0dd2\u0dba \u0dd2\u0db0\u0d9a\u0dd4\u0dab\u0db1 \u200d\u0dbb \u0dba\u0d9a\u0dca\u0dad. \u0d92\u0d9a\u0da7 cable \u0d91\u0d9a\u0d9a\u0dca\u0dad \u0d91 \u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0db1\u0dd0\u0dc4\u0dd0. \u0d92\u0d9a \u0dad \u0dd2 \u0d85\u0db4\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0dc0\u0dc3\u0dbb \u0db4\u0dc4 \u0dc3\u0dc4 \u0d91\u0dad\u0dd0\u0db1\u0dd2\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd4 ."
