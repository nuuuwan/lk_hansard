    "chunk_text": "\u0dc0\u0dbb\u0dca\u0dad\u0db8\u0dcf\u0dad\u0dc1\u0d9c\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0daf\u0d9a\u0dd2\u0dad\u0dc0\u0dcf, \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0d9a\u0dab \u0d9a\u0dcf \u0dc1\u0d9c\u0daf\u0dd3 \u0d94\u0db3 \u0daf\u0dd4\u0dca \u0dc1\u0db4\u0ddc\u0dc1\u0d9a\u0ddc\u0dca \u0daf\u0dd4 \u0d89\u0dc2\u0dca\u0da7 \u0d9a\u0d9a \u0d9c\u0dca \u0dad \u0db3\u0dd0\u0dd2\u0db4\u0dc0, \u0da7 \u0dc3\u0dd2 \u0dbd\u0dd4\u0db8 \u0dc1\u0db4\u0ddc\u0dc1\u0d9a\u0ddc\u0dca \u0daf\u0dd4 IMF \u0d91\u0d9a \u0db8\u0dad \u0db4\u0da7\u0dc0\u0dcf \u0dc3\u0d9f \u0dc1,\u0d9a\u0dcf \u0d9c\u0dca \u0dad \u0dda\u0dad\u0dca\u0d82\u0dcf\u0dc4 \u0d9a\u0d9a\u0dad\u0dc0\u0dcf. \u0dc4\u0dd0\u0db3\u0dd0\u0dba\u0dd2, \u0d94\u0db3 \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0d9a\u0dab \u0da7 \u0d89\u0daf\u0dd2\u0dd2\u0db4\u0db4\u0dad\u0dca \u0dc1\u0dc0\u0dad\u0dc1\u0d9a\u0ddc\u0da7\u0dad\u0dca \u0daf\u0dd0\u0dad\u0dc1\u0d9c\u0dad \u0dc3\u0dd2\u0da7\u0dd2 \u0dcf, IMF \u0d9c\u0dd2\u0dc0\u0dd2\u0dd4\u0dbb\u0db8 \u0dca\u200d\u0dbb\u0d9a\u0dcf\u0d9a\u0dc0 \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0d9a\u0dc1\u0d94\u0dc6 \u0db8\u0dca \u0d9a\u0dcf\u0d9a\u0dab\u0dcf \u0dc3\u0dd2 \u0db1 \u0dc1\u0dc0\u0dca \u0dc1\u0dca \u0d9a\u0dd2 \u0dcf. \u0dc4\u0dd0\u0db3\u0dd0\u0dba\u0dd2 \u0d94\u0db3 \u0d91\u0daf\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf, \u0db3 \u0da7 \u0db1\u0db4\u0dd4 \u0d9c\u0db8\u0dca \u0da7 \u0dc3\u0dd2 \u0dbd\u0dd4\u0dc1\u0daf\u0dad\u0dcf \u0d82\u0db8\u0d9f \u0d82\u0dcf\u0d9a\u0da0\u0dca\u0dc0\u0dcf \u0d9a\u0d9a\u0dad\u0dc0\u0dcf, \u0d85\u0db4\u0dd2 IMF \u0d91\u0d9a \u0d9a\u0dd2 \u0dad \u0db4\u0daf \u0da7 \u0daf\u0d9f \u0dca \u0dc1\u0dca \u0dad\u0dd0\u0dc4\u0dd0, \u0dad\u0da7\u0dca \u0dc1\u0dca \u0dad\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2 \u0dcf. \u0d91\u0dc1\u0dc4\u0db8 \u0d9a\u0dd2 \u0dcf \u0db3 \u0da7 \u0db1\u0dc0\u0dad\u0dca, \u0d85\u0daf \u0dc1\u0dc0\u0dad\u0dc1\u0d9a\u0ddc\u0da7 \u0dc4\u0dd0\u0db8 \u0dc1 \u0ddd\u0db1\u0dad\u0dcf\u0dc0\u0dca\u0dc2\u0db8 IMF \u0d91\u0d9a\u0da7 \u0d85\u0dd4\u0dc0\u0dc0 \u0db4\u0db8\u0dab\u0dca\u0dc2 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc1\u0dc0\u0dad\u0dc0\u0dcf. \u0d91\u0db4\u0db8\u0dab\u0dca\u0dc2 \u0dc1\u0dad\u0ddc\u0dc1\u0dc0\u0dba\u0dd2. \u0d94\u0db3 \u0d94\u0dc0\u0dd4\u0dca \u0d91\u0dca\u0dc2\u0d9a \u0d85\u0dc0\u0dc1\u0d9a\u0dc0 \u0d82\u0dcf\u0d9a\u0da0\u0dca\u0dc0\u0dcf \u0d9a\u0d9a\u0dad\u0dc0\u0dcf\u0daf, \u0dad\u0dd0 \u0daf \u0d9a\u0dd2 \u0dad \u0d9a\u0dcf\u0d9a\u0dab \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0dc0 \u0d85\u0db4\u0da7 \u0d82\u0dd0\u0d9a \u0d9a\u0dd4\u0dad\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0dad\u0dc0\u0dcf.\n\n\u0db1\u0dad\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dc1 \u0db4\u0dd4\u0dbb\u0d9c\u0dd2 \u0db1\u0dab\u0dca\u0da9\u0dd4\u0dc1\u0dda \u0d85\u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0d9a \u0dcf \u0dc0\u0dd6 \u0daf\u0dd2\u0dc1\u0dca \u0dc2\u0dca \u0d9c\u0dd4\u0dab\u0dc0\u0dbb\u0dca\u0db1\u0dad \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0dca \u0d9a\u0dd0\u0db6\u0dd2\u0dad\u0d94\u0dc6 \u0db8\u0dab\u0dca\u0da9\u0dcf \u0da7 \u0d9a\u0dd0\u0db6\u0dd2\u0dad\u0d94\u0dc6 \u0db4\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0 \u0d89\u0daf\u0dd2\u0dd2\u0db4\u0db4\u0dad\u0dca \u0d9a\u0dcf\u0dcf. \u0dad\u0db8\u0dd4\u0dad\u0dca, \u0da7\u0d9a \u0d91\u0dad\u0dd0\u0db1\u0dd2\u0dca \u0dad\u0dad\u0d9a \u0dc0\u0dd4\u0dab\u0dcf. \u0daf\u0dd0\u0dca \u0d85\u0db4\u0dd2 \u0dc0\u0dbb\u0dca\u0dad\u0db8\u0dcf\u0dad \u0db1\u0dab\u0dca\u0da9\u0dd4\u0dc1\u0dc0\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0dca\u0dc2 \u0d9a\u0d9a\u0dad\u0dc0\u0dcf. \u0d94\u0db3 \u0d82 \u0dcf\u0dcf\u0dc0\u0dc1 \u0dca , \u0d85\u0dc0\u0dc1\u0d9a\u0dc0 \u0dc1\u0db8\u0dca \u0d9a\u0dc1\u0d94\u0dc6 \u0d9a\u0dcf\u0db1\u0dba \u0dca \u0dbb\u0dab \u0dca\u0dc2\u0dad\u0dd2\u0db8\u0dad\u0dca \u0d9a\u0d9a.\u0dca \u0d9a\u0dcf\u0db1\u0dba \u0db4\u0dcf \u0dad \u0d9a\u0d9a\u0dca \u0dad \u0dda\u0dad\u0dca\u0d82\u0dcf\u0dc4 \u0d9a\u0d9a\u0dad\u0dc0\u0dcf \u0dad\u0db8\u0dca, \u0d94\u0dc1, \u0d85\u0dc0 \u0dba\u0dad\u0dcf\u0dc0 \u0db8\u0dad \u0db8\u0dca \u0d85\u0daf\u0dc4\u0d82\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0dad\u0dc0\u0dcf \u0dad\u0db8\u0dca \u0da7\u0dc0\u0dcf\u0dad\u0dca \u0da7\u0d9a\u0da7 \u0daf\u0dcf \u0dcf, \u0da7 credit \u0d91\u0d9a\u0dad\u0dca \u0d94\u0db3 \u0d85\u0d9a\u0dc1\u0d9c\u0dad, \u0db1\u0dcf\u0dad\u0dd2\u0d9a \u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0dc1\u0d9a\u0ddc.\u0d82\u0db8 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dca \u0dad \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0d9a\u0dca \u0dad."
