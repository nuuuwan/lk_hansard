    "chunk_text": "\u0d85\u0daf\u0dca\u200d \u0d85\u0db4\u0dd2 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dca \u0dba\u0dbb\u0db1\u0dcf \u0dba\u0dbb\u0dd4\u0dab\u0dd4 \u0d94\u0db6 \u0db1\u0dd2\u0dbb\u0dca\u0dc0\u0dcf\u0db1\u0dcf\u0dba \u0dba\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca2 \"\u0dc1\u0db8\u0dca\u0dc1\u0d9c\u0dcf \u0d86\u0dc1 \u0ddd \u0dc1\u0db8\u0dca \u0dc1\u0db1\u0dcf\u0db1\u0dcf\u0dc0\u0dcf\u0daf\u0dca\u200d \u0dba\u0dae\u0dcf \u0dba\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca2 \u0dc1\u0db8\u0dca\u0dc1\u0d9c\u0dcf \u0d86\u0dc1 \u0ddd \u0d87\u0dc0\u0dd2 \u0d86 \u0dcf \u0dc1\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dcf \u0dba\u0dbb\u0dd4\u0dab\u0dd4 \u0dc1\u0db1\u0dcf\u0db1\u0dcf\u0dc0\u0dcf\u0daf\u0dca\u200d?\" \u0dca\u0daf\u0dd3 \u0dc0 \u0dc1\u0dba\u0db1\u0dd4\u0dd2. \u0dc0\u0dd2\u0dc1 \u0dc2\u0dc1\u0dba\u0db1\u0dca \u0db1\u0dc1\u0dda \u0db8\u0dd2\u0dad\u0dca\u200d\u0dbb\u0dba\u0dcf \u0db1\u0da7 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf2 \u0db1\u0db1 \u0dca\u200d\u0dbb\u0dcf\u0dc1\u0dc1\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0dba\u0da7\u0dc0\u0dca \u0dc0\u0dc4\u0dd2 \u0d86 \u0dcf \u0db1\u0dcf\u0dd0\u0dd4\u0dc0\u0dc0 \u0dc1\u0db1\u0dad\u0dd0\u0db1\u0dcf\u0da7 \u0d87\u0dc0\u0dd2 \u0d86 \u0dcf \u0d8b\u0db4\u0dc1\u0daf\u0dca\u200d\u0dc3 \u0dc1\u0daf\u0dca\u200d\u0db1\u0dca\u0db1\u0dcf \u0dc4\u0daf\u0dca\u200d\u0db1\u0dcf\u0dc0\u0dcf \u0d9a\u0dd2\u0dba \u0dcf. \u0db1\u0db1 \u0daf\u0dca\u200d\u0db1\u0dca\u0db1\u0dcf\u0dc0\u0dcf2 \u0d91\u0dd4\u0dc0\u0db1\u0dcf \u0db1\u0dcf \u0d9c\u0dd0\u0db1\u0dcf \u0daf\u0dca\u200d\u0db1\u0dca\u0db1\u0dcf \u0db1\u0dd2\u0dc3\u0dcf \u0d92\u0dba \u0dc4\u0dd2\u0dad \u0dcf\n\n\u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a\u0dba\u0dc2\u0dab \u0dc4\u0dd0\u0dd2\u0dba\u0da7 \u0d85\u0db4\u0da7 \u0d85\u0dc0 \u0dba\u0dd22 \u0d85\u0db4\u0dd2 \u0d85\u0daf\u0dca\u200d \u0db8\u0dd4\u0dc4\u0dd4; \u0dc1\u0daf\u0dca\u200d\u0db1\u0dcf \u0dc1\u0d9c\u0ddd\u0dbd\u0dd3\u0dba \u0d85\u0db7\u0dd2\u0dc1\u0dba\u0ddd\u0d9c\u0dba\u0db1\u0dca\u0da7 \u0dc1\u0dba\u0dcf\u0dad\u0dbb\u0db8\u0dca \u0daf\u0dd4\u0dbb\u0da7 \u0d8b\u0db4\u0dcf\u0dba\u0dc1\u0dd3\u0dbd\u0dd3\u0dc0 \u0db8\u0dd4\u0dc4\u0dd4; \u0dc1\u0daf\u0dca\u200d\u0db1\u0dcf\u0dc0\u0dcf\u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0db1\u0dcf \u0d91\u0dba \u0d9c\u0dd0\u0db1\u0dcf \u0d85\u0dc0\u0dc1\u0db6\u0ddd\u0db0\u0dc1\u0dba\u0db1\u0dca \u0dba\u0da7\u0dba\u0dd4\u0dd4\u0dc0 \u0dba\u0dbb\u0db1\u0dca\u0db1\u0dcf. \u0db1\u0dc1\u0dda \u0db8\u0dd2\u0dad\u0dca\u200d\u0dbb\u0dba\u0dcf\u0da7 \u0d85\u0db1\u0dad\u0dba \u0dc0\u0dd4;\u0dcf2 \u0dc1\u0db1\u0dad\u0dd0\u0db1\u0dcf \u0d89\u0db1\u0dca\u0db1\u0dcf \u0db6\u0dc4\u0dd4\u0dad\u0dbb\u0dba\u0dc2\u0dab \u0d87\u0db1\u0dad\u0dd2\u0d9a\u0dc0\u0dbb\u0dd4\u0dca \u0dca\u200d\u0dbb\u0dcf\u0dc1\u0dc1\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0dba\u0da7\u0dc0\u0dca \u0dc0\u0dc4\u0dd2 \u0d86 \u0dcf \u0db1\u0dcf\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0db1\u0dcf \u0d91\u0dba. \u0db1\u0db1 \u0dc3\u0db1\u0dca\u0dc1\u0dad\u0ddd\u0dc2 \u0dc1\u0dc0\u0db1\u0dcf\u0dc0\u0dcf2 \u0dca\u200d\u0dbb\u0dcf\u0dc1\u0dc1\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0dba\u0da7 \u0dc1\u0db1\u0dcf\u0dcf \u0dc0\u0dc4\u0dd2\u0db1\u0dca \u0db1\u0dc1\u0dda \u0dc1\u0d9c\u0dcf\u0da9\u0dcf\u0dc2\u0dab \u0db8\u0dd2\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dba\u0ddd \u0dc1\u0dc0\u0db1\u0dcf\u0dca \u0d85\u0dca\u0daf\u0dca\u200d\u0dd0\u0d9a\u0dd3\u0db8\u0dca \u0db6\u0dcf\u0dc1\u0d9c\u0db1\u0dcf \u0dc1\u0db8\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc0\u0dc0\u0da7 \u0dca\u0db4\u0dd4 \u0d91\u0dba \u0d9c\u0dd0\u0db1\u0dcf. \u0d85\u0dc1\u0db4\u0dca\u0db4 \u0db8\u0dd2\u0dad\u0dca\u200d\u0dbb\u0dba\u0dcf \u0d87\u0dc1\u0db1\u0dbb\u0dd2\u0dba\u0dcf\u0dc1\u0dda \u0dc4\u0dd2\u0dd2\u0dba\u0dcf \u0db1\u0dcf\u0db8\u0dca \u0d85\u0daf\u0dca\u200d \u0d85\u0dc1\u0db4\u0dca\u0db4 \u0dca\u200d\u0dbb\u0db8\u0dca\u0db4\u0dca\u0db4 \u0db1\u0dc4\u0dca\u0dad\u0dba\u0dcf\u0da7 chance \u0d91\u0dba\u0dc2\u0dab \u0db1\u0dcf\u0dd0\u0dc4\u0dd0. \u0dc1\u0db1\u0dcf\u0dba\u0daf\u0dca\u200d2 \u0d91\u0dd4\u0dc0\u0db1\u0dcf \u0dca\u200d\u0dbb\u0dcf\u0dc1\u0dc1\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0dba\u0da7 \u0dc0\u0dc4\u0dd2 \u0d86 \u0dcf \u0db1\u0dcf\u0dd0\u0dc4\u0dd0. \u0d89\u0db1\u0dca\u0daf\u0dd4\u0db1\u0dd3\u0dc3\u0dd2\u0dba\u0dcf\u0dc0 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 10\u0dc2\u0dab \u0db4\u0dcf \u0db1\u0dcf\u0dba \u0dba\u0dbb\u0db4\u0dd4 \u0dc1\u0da2\u0dcf\u0ddd\u0dc1\u0dba\u0ddd \u0dc0\u0dd2\u0dc1\u0da9\u0ddd\u0dc1\u0da9\u0ddd \u0dc0\u0dca \u0dba\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0dba \u0dc1\u0dd2 \u0d86\u0db4\u0dd2\u0dc1\u0dba\u0dc2\u0dab \u0dc1\u0dc0 \u0dcf2 \u0db4\u0dc3\u0dd4\u0dc0 \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba\u0dba\u0dba\u0dd4 \u0dc1\u0dc0 \u0dcf \u0d92 \u0dbb\u0dc1\u0dca \u0d9c\u0dad\u0dc4 \u0db7\u0dcf\u0da9\u0dd4\u0d9a\u0da9 \u0d85\u0db4\u0db1\u0dcf\u0dba\u0db1\u0dcf\u0dba \u0dba\u0dbb\u0db4\u0dd4 \u0dc1\u0dba\u0dc1\u0db1\u0dcf\u0dc2\u0dab. \u0d94\u0dc4\u0dd4 \u0dad\u0db1\u0dd2 \u0d89\u0db1\u0dca\u0daf\u0dd4\u0db1\u0dd3\u0dc3\u0dd2\u0dba\u0dcf\u0dc0 \u0d85\u0daf\u0dca\u200d\u0da7\u0dca \u0dc3\u0db1\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d92 \u0dbb\u0dc1\u0dca \u0db4\u0dc4\u0dc5 \u0dc0\u0dd4\u0dab\u0dd4 \u0daf\u0dca\u200d\u0dc2\u0dab\u0dc2\u0dad\u0db1 \u0db1\u0dcf\u0dcf\u0dba\u0dba\u0dba\u0dcf \u0dc4\u0dd0\u0dd2\u0dba\u0da7. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db1 \u0dbd\u0dd3-\u0dc2\u0dab\u0dc0\u0dcf\u0db1\u0dca \u0dba\u0dd6 \u0db1\u0dc4\u0dca\u0db1\u0dba\u0dcf\u0dca \u0dca\u200d\u0dbb\u0dcf\u0dc1\u0dc1\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0dba\u0da7 \u0dc0\u0dc4\u0dd2 \u0d86 \u0dcf \u0dad\u0dd2\u0d9a\u0db6\u0dd4\u0dc1\u0da9\u0dd4\u0d9a \u0db1\u0dcf\u0dd0\u0dc4\u0dd0. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0dba\u0dbb\u0dd4\u0dab\u0dd4 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf\u0db12 \"\u0d91\u0dd4\u0dc0\u0db1\u0dcf \u0dca\u200d\u0dbb\u0dcf\u0dc1\u0dc1\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0dba\u0da7\u0dc0\u0dca \u0dc0\u0dc4\u0dd2 \u0d86 \u0dcf \u0db1\u0dcf\u0dd0\u0dc4\u0dd0\" \u0d9a\u0dd2\u0dba \u0dcf2 \u0d92 \u0dad\u0dca\u0dca\u0dc0\u0dba\u0da7 \u0db4\u0dca \u0dba\u0dbb\u0db1\u0dca\u0db1\u0dcf \u0dc1\u0dc4\u0dcf\u0db3 \u0db1\u0dcf\u0dd0\u0dc4\u0dd0."
