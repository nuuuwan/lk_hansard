    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dd4\u0dc0\u0db8 \u0db1, \u0dc0\u0dd2\u0dc1 \u0dbb\u0dc2\u0dc1\u0dc3\u0db1\u0dca\u0db8 \u0dc1\u0db8\u0dca \u0dbb\u0d86\u0dc3 \u0db6\u0dbd\u0dc3\u0da7 \u0db4\u0dad\u0dca \u0dbd\u0dbb\u0db1\u0dca\u0db1 \u0dc1\u0db1\u0dcf\u0dc1\u0dc3\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dca\u0d9a\u0dc0\u0dc1\u0dc2\u0dbb\u0dbb\u0dc0\u0dbd \u0dd2\u0daf\u0da7\u0dd2\u0db1 \u0dc1\u0db1\u0dcf\u0dc1\u0dc3\u0d9a\u0dca\u0d9a\u0dc0 \u0dc0\u0dd2\u0dad\u0dca\u0dad\u0dd2\u0dbd\u0dc3\u0db1\u0dca \u0da1\u0db1\u0dca\u0daf\u0dc3 \u0dd4 \u0db1\u0dca\u0db1\u0dcf. \u0d9a \u0da1\u0db1\u0dca\u0daf\u0dc3 \u0daf\u0dd3\u0db4\u0dd4 \u0d85\u0dc3\u0dc1\u0d9c\u0db1\u0dca \u0db6\u0dc4\u0dd4\u0dad\u0dbb\u0dc3\u0d9a\u0dca\u0d9a\u0dc0 \u0db0\u0dd3\u0dc0\u0dbb \u0d9a\u0dca\u0d9a\u0dc0\u0dc1\u0dc2\u0dbb\u0dbb\u0dc1\u0dda \u0db1\u0dc3\u0dd0\u0dc1\u0dc5\u0db1\u0dca\u0db1\u0db1\u0dca. \u0db0\u0dd3\u0dc0\u0dbb\u0dc3\u0db1\u0dca \u0dc1\u0db8\u0db1\u0dca\u0db8 \u0db0\u0dd3\u0dc0\u0dbb \u0d9a\u0dca\u0d9a\u0dc0\u0dc1\u0dc2\u0dbb\u0dbb\u0dc3\u0da7 \u0dc3\u0db8\u0d9c\u0dcf\u0db8\u0dd3\u0dba \u0dc0 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0dbd\u0dbb\u0db1 \u0d85\u0dc3\u0dc1\u0d9c\u0db1\u0dca \u0dd2\u0daf\u0dc3\u0dc3\u0da7 85\u0d9a\u0dca\u0d9a\u0dc0, 90\u0d9a\u0dca\u0d9a\u0dc0 \u0da1\u0db1\u0dca\u0daf\u0dc3 \u0dd4 \u0db1\u0dca\u0db1\u0dcf, \u0dc1\u0db8\u0dca \u0d9a\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0db6\u0dbd\u0dc3\u0da7 \u0db4\u0dad\u0dca \u0dbd\u0dbb\u0db1\u0dca\u0db1. \u0dbd\u0dd2\u0db1\u0dca \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u0d9a\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dbd\u0da7 \u0dad\u0db8\u0db1\u0dca \u0dc1\u0dc0\u0dd4\u0dc0\u0dc1\u0dc0\u0db1\u0dca \u0dc3\u0db8\u0d9a\u0dca\u0d9a\u0dc0 \u0dbd\u0dbb\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0dd4\u0dab\u0dc3\u0dcf, \u0dc1\u0db8\u0db1\u0dca\u0db1 \u0d85\u0dc1\u0dda \u0d85\u0db1\u0dcf\u0d9c\u0dad\u0dc3 \u0dc4\u0daf\u0db1 \u0d9a\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dbb\u0dd3\u0dc3\u0dbd\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0db0\u0dd3\u0dc0\u0dbb \u0d86\u0db1\u0dad\u0dcf\u0dc0 \u0d94\u0db6\u0dd4\u0dc0\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0da7 \u0da1\u0db1\u0dca\u0daf\u0dc3 \u0dd4 \u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d9a \u0dc1\u0daf\u0dd4\u0dab\u0db1\u0dca\u0daf\u0dbb \u0dd4\u0dc0\u0da9\u0dd4\u0dc1\u0dc0\u0dca \u0d89\u0db3\u0db1\u0dca \u0dc1\u0dda\u0dd4 \u0dbb\u0dd4 \u0dd4\u0dc0\u0da9\u0dd4\u0dc0\u0da7 \u0dc0\u0db1\u0dbd\u0dbd\u0dca \u0d89\u0db1\u0dca\u0db1 \u0dc3\u0db8\u0dc3\u0dbb\u0dad \u0db0\u0dd3\u0dc0\u0dbb\u0dc1\u0dc3\u0ddd."
  },
