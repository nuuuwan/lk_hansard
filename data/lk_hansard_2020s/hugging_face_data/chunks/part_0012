    "chunk_text": "\u0d8a\u0dcf\u0d9f\u0da7 \u0db3 \u0dca \u0dad, \u0dad\u0dbb\u0dca\u0d82\u0dca \u0dc1\u0d9a\u0dc1\u0dad\u0d9a\u0dd4\u0dc1 basic salary \u0d91\u0d9a \u0dad\u0dd2\u0dc1\u0db3\u0dca \u0dc1\u0dca , \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 32,525\u0dba\u0dd2. \u0daf\u0dd3\u0db8\u0dad\u0dcf \u0d91\u0dca\u0dc2\u0d9a gross salary \u0d91\u0d9a \u0dc0 \u0dc1 \u0dca \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 104,481\u0dca\u0dc2 \u0d9c\u0dad\u0dca\u0dad\u0dcf. \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0ddc\u0d9a\u0dca\u0dc2\u0daf \u0d9a\u0dc1\u0dcf\u0dda? \u0daf\u0dd0\u0dca \u0da7 \u0d85 \u0dc1 basic salary \u0d91\u0d9a \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 54,720\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0dad\u0dc0\u0dcf. \u0da7 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 54,720 \u0daf\u0dca\u0dc2\u0dc0\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0dad\u0dc0\u0dcf \u0dc0\u0dd2\u0dad\u0d9a\u0dca\u0dc2 \u0dc1\u0dad\u0ddc\u0dc1\u0dc0\u0dba\u0dd2, \u0d91 \u0dcf\u0dc1 gross salary \u0d91\u0d9a \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 133,640\u0dca\u0dc2 \u0dc1\u0dc0\u0dad\u0dc0\u0dcf.\n\n\u0dc1\u0db3\u0daf\u0dd4\u0dc0\u0dcf\u0db8 \u0db4\u0dd0 \u0d9a \u0daf\u0dd3\u0db8\u0dad\u0dcf\u0dc0 \u0dc1\u0dc0\u0dca \u0dc1\u0dca \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 203\u0dba\u0dd2. \u0daf\u0dd0\u0dca \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0ddc\u0d9a\u0daf \u0d9a\u0dc1\u0dcf\u0dda? \u0da7 \u0d85 \u0dc1 \u0dd6\u0dbd\u0dbd\u0dd2\u0d9a \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 54,720\u0da7 \u0dc1\u0d9c\u0dad\u0dcf\u0dc0\u0dcf. \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 54,720\u0da7 \u0dc1\u0d9c\u0dad\u0dd0\u0dbd\u0dca \u0dcf 200\u0dca \u0dc1\u0db3\u0daf\u0dd4\u0dc0\u0dcf. \u0da7 200\u0dca \u0dc1\u0db3\u0daf\u0dd4\u0dc0\u0dcf\u0db8, \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 275\u0dca\u0dc2 \u0dc1\u0dc0\u0dad\u0dc0\u0dcf. \u0d91\u0dad\u0dd0\u0dad \u0db4\u0dd0 \u0d9a \u0dc0\u0dd0\u0da9\u0dd2\u0dc0\u0dd3\u0db8 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 72\u0dca\u0dc2. \u0da7\u0d9a \u0dc1\u0dad\u0ddc\u0d9a\u0dd2 \u0dcf \u0daf\u0dd0\u0dca \u0dc1\u0db8\u0ddc\u0d9a\u0dca\u0dc2\u0daf \u0d9a\u0dd2 \u0dca \u0dc1\u0dca ?\n\n\u0d85\u0db4\u0da7 \u0daf\u0dd0\u0dca \u0dc1\u0db8\u0dca \u0d9a\u0dd2 \u0dca \u0dc1\u0dca \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 54,720\u0dad\u0dca \u0db4\u0dd0 160\u0dca \u0dc1\u0db3\u0daf\u0dca \u0dad \u0d9a\u0dd2 \u0dcf\u0dba\u0dd2. \u0d9c\u0dbb\u0dd4 \u0da9\u0dd3.\u0dc0\u0dd3. \u0da0\u0dcf\u0dad\u0d9a \u0db8\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0dc1\u0db8\u0dca \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd3\u0db8, \u0daf\u0dd3\u0db8\u0dad\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd3\u0db8 \u0d94\u0dca\u0dc2\u0dc1\u0d9a\u0ddd\u0db8 \u0d85\u0db8\u0dad\u0d9a \u0d9a\u0d9a \u0dcf \u0d85\u0db4\u0da7 \u0daf\u0dd0\u0dca \u0d9a\u0dd2 \u0dad\u0dc0\u0dcf \u0db4\u0d9a\u0dab \u0d91\u0d9a\u0da7\u0db8 \u0d85\u0dd4\u0dc0\u0dc0 \u0dc1\u0db3\u0daf\u0dca \u0dad \u0d9a\u0dd2 \u0dcf.\n\n\u0d9c\u0dbb\u0dd4 \u0d82\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0dc1\u0db8\u0dc0\u0d9a \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0daf\u0dd3 \u0dc1\u0db8\u0dca \u0dc3\u0dd2 \u0dbd\u0dca \u0d82 \u0d9a\u0dcf \u0db3\u0dd0\u0dbd\u0dd4\u0dc0\u0dcf. Budget \u0d91\u0dc1\u0d9a\u0dca \u0dc1\u0dc0\u0dca \u0d9a\u0d9a\u0dad \u0d9c\u0dab\u0dad \u0dc1\u0db8\u0ddc\u0d9a\u0dca\u0dc2\u0daf \u0d9a\u0dd2 \u0dcf \u0d82 \u0d9a\u0dcf \u0db3\u0dd0\u0dbd\u0dd4\u0dc0\u0dcf. \u0da7\u0dc0\u0dcf \u0d82 \u0d9a\u0dcf \u0db3 \u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9a\u0dc1\u0dcf\u0dda. \u0d91\u0dc1\u0dc4\u0db8 \u0dc1\u0dad\u0ddc\u0d9a\u0d9a \u0dc1\u0db8\u0dca\u0d9a \u0d85\u0dc1\u0dad\u0dca\u0dc2 \u0db4\u0dd0\u0dad\u0dca\u0dad\u0da7 \u0dc1\u0db3\u0daf\u0dca \u0dad \u0d9c\u0dd2\u0dc1 \u0ddc\u0dad\u0dca, \u0d85\u0db4\u0da7 \u0dc1\u0db8\u0dca \u0dca\u200d\u0dbb \u0dca\u0dad \u0dc1,\u0d9a\u0dca \u0dad \u0dc1\u0dc0\u0dca \u0dc1\u0dca \u0dad\u0dd0\u0dc4\u0dd0. \u0dc1\u0db8\u0ddc\u0d9a\u0daf, 1:4 \u0d85\u0dd4\u0dc0\u0db4\u0dcf\u0dad \u0da7 \u0d85\u0daf\u0dcf\u0dcf\u0dc0 \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0db4\u0d9a\u0dad\u0d9a \u0dad\u0dd2 \u0dcf \u0dc1\u0d9c\u0dad \u0dca \u0dad\u0dad\u0dca \u0dd1\u0dad\u0dd1."
