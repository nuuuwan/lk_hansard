    "chunk_text": "\u0dc4\u0dd2\u0db8\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0dda\u0db4\u0dcf\u0db0\u0dd2\u0db1 \u0d9a\u0db6\u0dcf \u0daf\u0dd3\u0dc1\u0db8\u0dca \u0dca\u200d\u0dbb[\u0dcf\u0daf\u0dca\u200d\u0db1 \u0dc0\u0dc5\u0d9a\u0dca\u0dc0\u0dcf \u0d9c\u0dad\u0db1\u0dd3[ \u0d85\u0dbb\u0db8\u0dd4\u0dab \u0db1\u0dad\u0dd2 \u0db4\u0dc0\u0dc3\u0db8\u0dd2\u0db1\u0dca \u0d85\u0db0\u0dba\u0db1\u0dc0 \u0dc0\u0dbb\u0dca\u0dc2 03\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dad\u0dc0\u0dad\u0dd2 \u0dc3[\u0dcf\u0dc3\u0dd2 \u0db4\u0db8 \u0d9a\u0dca\u0dc2\u0dab \u0dc3\u0dd2\u0db1\u0dbd\u0dca\u0d9a [\u0dcf\u0dbb\u0dca\u0d9c\u0d9c\u0dad \u0dca\u200d\u0dbb[\u0db1\u0da7 - online \u0dca\u200d\u0dbb[\u0db1\u0da7 - \u0db4\u0dad\u0dc0\u0dad\u0dad\u0dca\u0dc0\u0dd3\u0dc1\u0db8\u0dca\u0daf\u0dd3 \u0d85\u0dca\u200d\u0dbb\u0db8\u0dd2 \u0dad\u0dcf \u0dbb\u0dd0\u0dc3\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd6 \u0db6\u0dc0 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0db1 \u0daf\u0dca\u200d\u0db1\u0dca\u0dc1\u0db1\u0dca\u0daf\u0dca\u200d? \u0d92 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0db1\u0db1\u0dca \u0dc1\u0db8\u0dca \u0dc0\u0dc0 \u0dc0\u0dd2\u0da7 \u0dc1\u0d9c\u0dc0 \u0d87\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1\u0dcf[\u0dcf\u0dbb\u0dca\u0d9c \u0dc0\u0dc1\u0dbb\u0dca\u0daf\u0dca\u200d?\n\n01.\n\n02.\n\n03. \u0d94\u0dda.\n\n\u0dc1\u0da2\u0dba\u0dc2\u0dca\u0da8 \u0dba\u0d9a\u0dc2\u0dba \u0dc4\u0dd2\u0db8\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dca\u200d\u0dbb\u0dae[ \u0dc0\u0dc3\u0dbb \u0dba\u0d9a\u0dc2\u0dba \u0dc4\u0dd2\u0db8\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc5 \u0dc0\u0dc0 \u0dc0\u0daf\u0dca\u200d \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1\u0dcf \u0dcf\u0dbb \u0db8\u0dca \u0dc1\u0dc4\u0dda\u0dad\u0dd4\u0db8\u0dc1\u0dc0\u0db1\u0dca \u0dc3\u0dc4 \u0dc1\u0dc0\u0dc0\u0dad\u0dca \u0dc0\u0dd2\u0dc0\u0db1 \u0dc1\u0dc4\u0dda\u0dad\u0dd4\u0db8 [\u0dad \u0dc0\u0dd2 \u0dca\u0dc0\u0dc0\u0dd2\u0daf\u0