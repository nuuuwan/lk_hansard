    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0d9a\u0dd4\u0dc0\u0db1\u0db1\u0dd22 \u0d85\u0db4\u0dd2 \u0dc0\u0dd2 \u0dc0\u0dcf\u0dc3 \u0dba\u0dbb\u0db1\u0dcf \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0dca \u0db1\u0dd2\u0dbb\u0dca\u0db1\u0dcf;\u0dc1\u0dd3\u0dbd\u0dd3 \u0dba\u0dba\u0dad\u0dcf\u0dc02 \u0dad\u0dad\u0dd2\u0d9a\u0dc4\u0dcf\u0dc3\u0dd2\u0dba\u0dc0 \u0d85\u0db4\u0dd2 \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dcf\u0dba \u0dba\u0dbb\u0dc1\u0d9c\u0db1\u0dcf \u0dca \u0d92 \u0db6\u0dd4\u0dc1\u0db0\u0dd2\u0db1\u0dca \u0db6\u0dc02 \u0dad\u0dbb\u0dca\u0dba\u0dcf\u0db1\u0dd4\u0d9a\u0dd6 \u0db6\u0dc02 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0dca\u0db1\u0dba\u0dc0 \u0dc3\u0dd2\u0dad\u0dd3\u0dc1\u0db8\u0dca \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0d85\u0db4\u0da7 \u0dad\u0dad\u0dd2\u0d9a\u0dc4\u0dcf\u0dc3\u0dd2\u0dba\u0dc0 \u0d8b\u0dbb\u0dd4\u0db1 \u0dc0\u0dd4\u0dab\u0dd4 \u0dc1\u0daf\u0dca\u200d\u0dba\u0dc2\u0dab. \u0d92 \u0d8b\u0dbb\u0dd4\u0db1\u0dba \u0dd4\u0dc0\u0dc5 \u0dba\u0da7\u0dba\u0dd4\u0dd4\u0dc0 \u0dba\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dc1\u0db8\u0dca \u0dbb\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0dc1\u0d9c\u0db1\u0dcf\u0dba\u0db1\u0dca\u0db1\u0dcf\u0da7 \u0d85\u0db4\u0dd2 \u0d8b\u0dca\u0dc3\u0dcf\u0dc4 \u0dba\u0dbb\u0db1\u0dca\u0db1\u0dcf \u0d95\u0db1\u0dcf\u0dd1. \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf \u0dc3\u0dc4 \u0dad\u0dcf\u0dc2\u0dab\u0dc2; \u0d85\u0db1\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba \u0d9a\u0dd2\u0dba\u0dd6 \u0db4\u0dc5\u0dd2\u0dba\u0da72 \u0d92\u0dba \u0db6\u0da7\u0dc4\u0dd2\u0dbb \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0dc0 \u0d91\u0dc2\u0dab\u0dba \u0db4\u0da7 \u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0db1\u0dcf\u0dbb\u0dba\u0dd2. \u0d85 \u0dc1\u0db4\u0dca\u0db4 \u0dc1\u0dbb \u0dc2 \u0da8 \u0dc3\u0d82\u0dc3 \u0dba\u0dad\u0dad\u0dd2\u0d9a\u0dba2 \u0dc3\u0db7\u0dba\u0dca\u0dc0\u0dba \u0dd4\u0dc0\u0dc5 \u0d85\u0db4\u0dd2 \u0dc1\u0db6\u0dcf\u0dc1\u0dc4\u0dcf\u0db1 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0dca\u0db1\u0dba \u0db8\u0dd2\u0db1\u0dd2\u0dc3 \u0dc3\u0dd4. \"\u0dc1\u0d86 \u0db0\u0db8\u0dca\u0db1\u0dcf \u0dc1\u0dc4 \u0dd4\u0dc0\u0db4\u0dca\u0db4\u0db4\u0db7\u0dc0\u0dcf\"2 \u0dc1\u0db8\u0dca\u0dba \u0dad\u0db1\u0dd2 \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0dda\u0dc1\u0dda \u0dc1\u0dc4 \u0dd4\u0dc0\u0db5 \u0dc0\u0dcf\u0daf\u0dca\u200d\u0dba \u0d9a\u0dd2\u0dba \u0dcf. \u0d92\u0dba \u0dad\u0db1\u0dd2 \u0dad\u0dcf\u0dbb\u0dca\u0d9a\u0dd2\u0dba\u0dc0 \u0dc3\u0dd2\u0dad\u0dd3\u0dc1\u0db8\u0dca \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0. \u0dc1\u0db1\u0dc0\u0dd0\u0db1\u0dd2 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0dc2\u0dab \u0dad\u0dd2\u0d9a\u0db6\u0dd4\u0dab\u0dd4 \u0d85\u0db4\u0dd2 \u0d85\u0daf\u0dca\u200d \u0dc1\u0db8\u0dca Budget \u0d91\u0dba \u0db4\u0dd2\u0da7 \u0dbb\u0dd2\u0db1\u0dca \u0dc4\u0daf\u0dca\u200d \u0dcf \u0dc1\u0dda\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d87\u0dd2? \u0db4\u0dd2\u0da7 \u0dbb\u0da7 \u0dc3\u0dd4\u0daf\u0dd4 \u0db1\u0dd0\u0dad\u0dd2\u0d9a\u0db1\u0dd2\u0dba\u0dc2\u0dab \u0d9a\u0dd2\u0dda\u0dc0\u0dcf\u0db1 \"\u0d94\u0db6 \u0dc1\u0dc4\u0dcf\u0db3\u0da7 \u0dc0\u0dd0\u0dc1\u0da9\u0dca \u0dba\u0dbb \u0dcf\n\n1937 1938\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc0\u0dc0\n\n\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0d9a\u0dd4\u0dc0\u0db1\u0db1\u0dd22 \u0db1\u0db1 \u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0dcf \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf \u0d8b\u0dca\u0dc3\u0dcf\u0dc4 \u0dba\u0dc1\u0dc5 \u0dc1\u0db8\u0dca \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0dd4\u0dc0\u0dc5 \u0d85\u0dc1\u0db4\u0dca\u0db4 \u0dbb\u0da7 \u0d89\u0dc3 \u0dc3\u0dbb\u0dc4\u0da7 \u0dba\u0db1\u0dcf \u0d9a\u0dd2\u0dc3\u0dd2\u0db1 \u0dc1\u0dc3 \u0dba\u0dcf\u0dc0\u0dc2\u0dab2 \u0d9a\u0dd2\u0dc3\u0dd2\u0db1 \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5\u0dc2\u0dab \u0db1\u0dcf\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0db1\u0dcf \u0d91\u0dba\u0dd2. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db1 \u0db1\u0db1 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf \u0d95\u0db1\u0dcf\u0dd1 \u0dc1\u0db8\u0dca \u0da2\u0dd2\u0da7\u0dbd\u0da7 \u0d86 \u0dc0\u0dd0\u0dc1\u0da9\u0dca \u0d9c\u0dd0\u0db1\u0dcf\u0dca. \u0d92\u0dba\u0da7\u0dca \u0db4\u0dd2\u0da7\u0dd4\u0dc0\u0dc2\u0dab \u0dc1\u0dc0\u0db1\u0dca \u0dba\u0dbb \u0dad\u0dd2\u0d9a\u0dc1\u0db6\u0db1\u0dcf\u0dc0\u0dcf. \u0d87\u0dca\u0dad \u0dc0 \u0dc1\u0dba\u0db1\u0dca\u0db1 \u0dc1\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0d94\u0db6\u0dc1\u0dda \u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0db4\u0dca\u0dad\u0dd2\u0d9a \u0dca\u200d\u0dbb\u0dba\u0dcf \u0db1\u0dcf\u0dc1\u0d86 \u0dad\u0dd2\u0d9a\u0dc1\u0db6\u0db1\u0dcf\u0dc0\u0dcf. \u0db1\u0dcf\u0db8\u0dd4\u0dca2 \u0dc1\u0db8\u0dca\u0dba \u0dc1\u0db4\u0dcf\u0da9\u0dca\u0da9\u0dc2\u0dab \u0db4\u0dd0\u0da7\u0dd2 \u0dcf \u0dc0\u0dcf\u0dc1\u0dda \u0db1\u0da7 \u0dc4\u0dd2\u0dc1\u0dad\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1\u0dba\u0dcf\u0dc1\u0dc4\u0dcf\u0db1 \u0dc0\u0dd4;\u0dca2 \u0dc1\u0db8\u0dca\u0dba \u0dc1\u0daf\u0dca\u200d\u0dba\u0dba\u0da7 \u0dc1\u0db6\u0daf\u0dca\u200d\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dcf\u0da7 \u0d95\u0db1\u0dcf\u0dd1. \u0d92 \u0dad\u0db1\u0dd22 \u0da2\u0dd2\u0da7\u0dbd\u0da7 \u0d86\u0dba\u0dbb;\u0dba \u0dc3\u0dc4 \u0da2\u0dd2\u0da7\u0dbd\u0da7 \u0d86 \u0dca\u0dbb\u0dca)\u0dba\u0dba."
  },
