    "chunk_text": "\u0dda\u0daf\u0dcf\u0dc4\u0d9a\u0dab \u0dca\u0dc2 \u0dc4\u0dd0\u0da7\u0dd2 \u0da7 \u0d9a\u0dd2\u0dda\u0dc1\u0dc0\u0ddc\u0dad\u0dca, \u0dc1\u0db8\u0dca \u0d85 \u0dc0\u0dd0\u0dc1 \u0dca \u0db4\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf \u0dad \u0db1 \u0dad\u0dad \u0dca\u0dc2\u0dad\u0dd2\u0db8\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d82 \u0dc4\u0dcf \u0d85\u0dc0 \u0dba \u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0dad \u0db8\u0db1\u0dba\u0db8 \u0db1\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0da7\u0dc1\u0dad\u0dca \u0dc1\u0dc0\u0dca \u0d9a\u0d9a\u0dca \u0dad \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0d9a \u0dad\u0dd2\u0dc1\u0db3\u0dad\u0dc0\u0dcf. \u0dd6\u0dbd \u0dcf\u0d82\u0dad\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0dc1\u0db8\u0dca \u0db4\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf \u0dad \u0db1 \u0dad\u0dad\u0dc0 \u0da7 \u0d85\u0daf\u0dcf\u0dcf \u0dc0\u0dd2\u0dc2 \u0dca , \u0da7\u0dc0\u0dcf\u0dc1\u0d9c \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0d9c\u0dad\u0dca\u0dad\u0dcf\u0db8, \u0dc1\u0db8\u0dca \u0db1 \u0dad\u0dad \u0dc1\u0dca\u0dc2\u0dca \u0daf\u0dca\u200d\u0dbb \u0d9a\u0d9a\u0d9c\u0dca \u0dad\u0dcf \u0dca\u200d\u0dbb\u0dc1 \u0d82\u0dc1\u0dc0\u0dbb\u0dca\u0db1\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dad\u0dd2\u0dc1\u0db3\u0dad \u0dc1\u0db8\u0dca \u0db4\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf \u0dad \u0db1 \u0dad\u0dad\u0dc0 \u0dd6\u0dbd \u0dba \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0d85\u0daf \u0db4\u0dd2\u0dd2\u0db4\u0dc4\u0dd2 \u0dcf \u0dad\u0dd2\u0dc1\u0db3\u0dca \u0dc1\u0dca , \u0daf\u0dd4\u0dbb\u0dca\u0dc0 \u0dc1\u0dc0 \u0dcf \u0dad\u0dd2\u0dc1\u0db3\u0dca \u0dc1\u0dca .\n\n\u0dc1\u0db8\u0dca \u0dc0\u0dd0 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2 \u0da7\u0dc1\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf \u0dad \u0db1 \u0dad\u0dad\u0dc0 \u0da7 \u0dc0\u0dd2 \u0dcf \u0db8\u0dd4\u0daf \u0dca\u0dc2 \u0dc1\u0dc0\u0dca \u0d9a\u0d9a \u0dcf \u0dad\u0dd2\u0dc1\u0db3\u0dad\u0dc0\u0dcf.\n\n\u0da7 \u0dc0\u0dcf\u0dc1 \u0db8 \u0db4\u0dcf\u0dcf\u0dad\u0dca \u0d82\u0dcf\u0dcf\u0dad\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc1\u0dc0\u0dca \u0dad \u0dd1\u0dad\u0dd1. \u0da7\u0d9a \u0daf\u0dc4\u0dad\u0dd4\u0dca \u0dc0\u0dad \u0db1\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dba\u0dc0\u0d82\u0dca\u0dae\u0dcf \u0d82\u0dc1\u0dc1 \u0ddd\u0db1\u0dad \u0dc3\u0dad\u0dd4\u0dc1\u0dcf\u0dda \u0dad\u0dd2\u0dc1\u0db3\u0dad \u0d91\u0d9a\u0dca\u0dc2. \u0da7\u0d9a \u0d89\u0d82\u0dca\u0d82\u0d9a\u0dc4\u0da7 \u0d85\u0d9a\u0dc1\u0d9c\u0dad \u0dca \u0dad \u0dd1\u0dad\u0dd1. \u0da7\u0dc0\u0dcf\u0dad\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc1\u0dc0\u0dca \u0dad \u0dd1\u0dad\u0dd1. \u0dc0\u0dd2\u0db4\u0dca\u0dc2\u0dc2\u0dc1\u0d9c \u0db8\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0dca \u0d9a\u0dd2\u0dc4\u0dd2\u0db4 \u0dc1\u0daf\u0dc1\u0dad\u0dca\u0dc2 \u0da7 \u0d82\u0db8\u0dca\u0db3\u0dca \u0db1\u0dc0\u0dad\u0dca \u0d82\u0dd0\u0d9a \u0dca\u0dc2 \u0db8\u0dad\u0dd4 \u0d9a\u0dcf\u0dcf. \u0dc1\u0db8\u0dca \u0d9a\u0da7 \u0dc1\u0d9c\u0ddc\u0da9\u0dcf \u0dad\u0d9f\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0d82 \u0dc4\u0dcf \u0da7 \u0dc3\u0dd2 \u0dbd\u0dd4 \u0dc0\u0dba\u0dd4\u0dc4 \u0dca \u0da7 \u0dc1\u0db8\u0dca \u0d85 \u0dc0\u0dd0 \u0dc3\u0dad\u0dd4\u0dc1\u0dcf\u0dda \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0dad \u0dc1\u0dc0\u0dca \u0d9a\u0d9a \u0dcf \u0dca\u0dc2\u0dad\u0dd2\u0db8\u0dad\u0dca \u0d9a\u0d9a \u0dcf \u0dad\u0dd2\u0dc1\u0db3\u0dad\u0dc0\u0dcf. \u0db4\u0dcf\u0dcf\u0dad\u0dca \u0d82\u0dcf\u0dcf\u0dc0\u0da7 \u0dc1\u0dc0\u0dad\u0db8, \u0db4\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf \u0dad \u0db1 \u0dad\u0dad \u0da7 \u0dc1\u0dc0\u0dad\u0db8, \u0db8\u0db1\u0dba\u0db8 \u0db1\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dbb\u0dd0\u0dc1\u0d9a\u0dca \u0dad \u0dc1\u0dc0\u0dad\u0db8 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc1\u0dc0\u0dca \u0d9a\u0d9a\u0dca \u0dc1\u0dca \u0dad\u0dd0\u0dad\u0dd2\u0dc0, \u0d82\u0db8\u0dca\u0dbb\u0dca\u0dbb\u0dca\u0dab\u0dc1 \u0dca \u0d9a\u0da7 \u0dc1\u0d9c\u0ddc\u0da9\u0dcf \u0dad\u0d9f\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc1\u0dc0\u0dd4\u0dc0\u0dc1\u0dc0\u0dca \u0dc1\u0db8\u0dca \u0d85 \u0dc0\u0dd0\u0dc1 \u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0dad \u0dc1\u0dc0\u0dca \u0d9a\u0d9a \u0dcf \u0dad\u0dd2\u0dc1\u0db3\u0dad\u0dc0\u0dcf. \u0d85\u0db4\u0da7 \u0d85\u0dca \u0dad \u0da7 \u0dc1\u0dda\u0d9c \u0da7 \u0daf\u0dd4\u0dc0\u0dca \u0dad \u0dc3\u0dd2 \u0db1 \u0dc1\u0dc0 \u0dcf \u0dad\u0dd2\u0dc1\u0db3\u0dad\u0dc0\u0dcf. \u0da7\u0d9a \u0db1\u0dd2\u0d82\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0db8\u0dcf\u0dad\u0dc0 \u0d82\u0db8\u0dca\u0db4\u0dad \u0dc1\u0db8\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dc1 \u0da7\u0dad\u0da7 \u0dc0\u0dd0\u0da7\u0dd4\u0dc1\u0dab\u0dca.\n\n\u0dc1\u0db3\u0ddc\u0dc1\u0dc4\u0ddc\u0db8 \u0d82\u0dca\u0dad\u0dd4\u0dad\u0dd2\u0dba\u0dd2. \u0d9c\u0dbb\u0dd4 \u0db8\u0dd6\u0dbd\u0dcf \u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf (\u0bae\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0bae\u0bb2\u0bae\u0bae\u0ba4\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0d9c\u0dbb\u0dd4 \u0dad\u0dd4\u0da9\u0d9a\u0d9a\u0dcf\u0d82\u0dcf \u0d9a\u0dc0\u0dd2\u0d9a\u0d9a\u0dca \u0db8\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf. \u0d94\u0db3\u0dad\u0dd4\u0db8\u0dcf\u0da7 .\u0db1\u0dd2\u0dad\u0dca\u0dad\u0dd4 4\u0d9a \u0d9a\u0dcf \u0dca\u0dc2 \u0dd0\u0dc1\u0db3\u0dad\u0dc0\u0dcf.\n\n[\u0baa\u0bbf.\u0baa. 4.00]"
