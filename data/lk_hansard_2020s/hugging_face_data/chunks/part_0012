    "chunk_text": "\u0d9a\u0d9a \u0dcf \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dc0\u0dd2\u0dc2\u0db8\u0dad\u0dcf\u0dc1\u0dc0\u0dca \u0dc1\u0d9a\u0ddc\u0da7\u0d82\u0dca\u0dc2 \u0daf\u0dd2\u0dad\u0dcf \u0d9c\u0dad\u0dca\u0dad\u0dcf. \u0da7\u0d9a \u0dc1\u0dad\u0ddc \u0dd0\u0dd4\u0dab\u0dab\u0dd4 \u0db4\u0dd2\u0dd2\u0db4\u0d82\u0dca\u0dc2 \u0d89\u0dca \u0dad\u0dc0\u0dcf. \u0da7 \u0d85 \u0dc1 \u0dca\u200d\u0dbb \u0dca\u0dad \u0dc1\u0db8\u0dca\u0dc1\u0d9a\u0dca \u0dc0\u0dd2\u0d82\u0dd2 \u0dcf \u0dad\u0dd0\u0dc4\u0dd0. \u0da7\u0d9a \u0dc0\u0dd2\u0d82\u0dd2 \u0dba\u0dd4\u0dad\u0dd4 \u0dca\u200d\u0dbb \u0dca\u0dad \u0dca\u0dc2 \u0dc1 \u0d82 \u0d85\u0db4\u0da7 \u0d89\u0dad\u0dd2\u0dd2\u0db4 \u0dc1\u0dc0 \u0dcf \u0dad\u0dd2\u0dc1\u0db3\u0dad\u0dc0\u0dcf. \u0da7 \u0dc0\u0dcf\u0dc1 \u0db8 2020 \u0dc3\u0dd2\u0da7 2024.12.31 \u0daf\u0dca\u0dc2\u0dc0\u0dcf \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0d9c\u0dd2 \u0d85\u0dc1\u0dda \u0d9a\u0dcf\u0db1\u0dba \u0dc1\u0d82\u0dda\u0dc0\u0d9a \u0dca \u0da7 \u0dc1\u0db8\u0dca \u0d85 \u0dc0\u0dd0 \u0dad\u0dd4\u0dcf \u0db8\u0dca \u0d82\u0dc4\u0dad \u0dca\u0dc2 \u0dad\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2 \u0dad \u0db8\u0dd0\u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca \u0dca\u0dc2 \u0dad\u0dd2\u0dc1\u0db3\u0dad\u0dc0\u0dcf. \u0d94\u0dc0\u0dd4\u0dca \u0d85\u0db4\u0da7 \u0daf\u0dd2\u0dad\u0db4\u0dad\u0dcf \u0d9a\u0dae\u0dcf \u0d9a\u0d9a\u0dad\u0dc0\u0dcf, \u0dbd\u0dd2\u0dba\u0dd4\u0db8\u0dca \u0d91\u0dc0\u0dad\u0dc0\u0dcf, message \u0d9a\u0d9a\u0dad\u0dc0\u0dcf. \u0d94\u0dda, \u0d85\u0db4\u0da7 \u0da7 \u0d9c\u0dd0\u0dad \u0d85\u0dc0\u0dc1\u0db3\u0ddd\u0db1 \u0dca\u0dc2 \u0dad\u0dd2\u0dc1\u0db3\u0dad\u0dc0\u0dcf. \u0dc0\u0dd0\u0da9\u0dcf \u0d9a\u0d9a\u0dad \u0db1\u0dad\u0dad\u0dcf\u0dc0 \u0db1\u0dd2\u0dc1 \u0ddd\u0db1\u0dad \u0d9a\u0d9a\u0dad \u0db1\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dca\u0dc2 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7, \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd3 \u0d82.\u0dad\u0dd2 \u0dad\u0dcf \u0d9a \u0dca \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0d85\u0db4\u0da7 \u0da7 \u0d9c\u0dd0\u0dad \u0d85\u0daf\u0dc4\u0d82\u0dca\u0dc2 \u0dad\u0dd2\u0dc1\u0db3\u0dad\u0dc0\u0dcf. \u0dc1\u0db8\u0dca\u0d9a \u0d85\u0dc1\u0dda \u0d85\u0dc0\u0d82\u0dca \u0d85 \u0dc0\u0dd0 \u0dc1\u0dad\u0ddc\u0dc1\u0dc0\u0dba\u0dd2. \u0dc1\u0db8\u0dca\u0d9a \u0dc1\u0db8\u0dca \u0db1\u0dab\u0dca\u0da9\u0dd4\u0dc1\u0dda \u0db4\u0dcf\u0db8\u0dd4\u0dc1\u0dc0\u0db1\u0dd2 \u0d85 \u0dc0\u0dd0 . \u0d8a\u0dcf\u0d9f \u0d85 \u0dc0\u0dd0 \u0dc0 \u0daf\u0dd3 \u0d8a\u0da7 \u0d85\u0daf\u0dcf\u0dcf \u0d85\u0dc0\u0db1\u0dcf\u0dad \u0dc1 \u0ddc\u0db8\u0dd4 \u0d9a\u0d9a\u0dca \u0dad \u0d85\u0dc1\u0dda \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0dc1\u0dc0\u0dad\u0dc0\u0dcf \u0d9a\u0dd2 \u0dad \u0d9a\u0dcf\u0d9a\u0dab \u0d82 \u0dc4\u0dca \u0d9a\u0d9a\u0dca \u0dad \u0dd1\u0dad\u0dd1.\n\n\u0d82\u0db8\u0dc4\u0dbb\u0dd4 \u0d9a\u0dd2 \u0dad\u0dc0\u0dcf, \u0d85\u0db4\u0dd2 \u0d9a\u0d9a\u0dca \u0dc1\u0dca \u0db4\u0dd4\u0dbb\u0d9c\u0dd2 \u0d85 \u0dc0\u0dd0 , \u0db4\u0dd4\u0dbb\u0d9c\u0dd2 \u0db1\u0dab\u0dca\u0da9\u0dd4 \u0dc0\u0dd2\u0dc1\u0dda\u0da0\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0dd2\u0dad\u0d9a\u0dba\u0dd2 \u0d9a\u0dd2 \u0dcf. \u0d91\u0dc1\u0dc4\u0db8 \u0dad\u0dd0\u0dc4\u0dd0. \u0dc3\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0db4\u0dd4\u0dbb\u0d9c\u0dd2 \u0db1\u0dab\u0dca\u0da9\u0dd4 \u0dc0\u0dd2\u0dc1\u0dda\u0da0\u0dad \u0d9a\u0dc1\u0dcf\u0dda? \u0db4\u0dd4\u0dbb\u0d9c\u0dd2 \u0db1\u0dab\u0dca\u0da9\u0dd4 \u0d9a\u0dcf \u0dc0 \u0d85\u0db4\u0dd2 \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0d89\u0dbd\u0dca \u0dcf \u0d82\u0da7\u0dca \u0d9a\u0dcf\u0dcf. \u0da7 \u0d82 \u0dc4\u0dcf \u0d85\u0db4\u0da7 \u0d82\u0dcf\u0db1\u0dcf\u0d9a\u0dab, \u0dba\u0dd4\u0dca\u0dc2\u0dad\u0dd2\u0d82\u0dc4\u0d9c\u0dad \u0d85\u0dba\u0dd2\u0dad\u0dd2 \u0dca\u0dc2 \u0dad\u0dd2\u0dd4\u0dab\u0dab\u0dcf. \u0dc3\u0dba\u0dd2 \u0da7? \u0db4\u0dd4\u0dbb \u0d9c\u0dd2 \u0db1\u0dab\u0dca\u0da9\u0dd4 \u0d9a\u0d9a\u0db4\u0dd4 \u0d85 \u0dc4\u0dd0\u0db8\u0daf\u0dcf\u0db8 \u0d94\u0dc0\u0dd4\u0dca \u0dc1 \u0daf\u0dd3\u0db8\u0dad\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0d9a \u0d9c\u0dad\u0dca\u0dad\u0dcf. \u0d9a\u0dca\u0dc2\u0dc2\u0dab \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 250,000 \u0d89 \u0dcf .\u0dbd\u0dd2 \u0dad \u0daf\u0dca\u0dc2\u0dc0\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0d9a \u0d9c\u0dad\u0dca\u0dad\u0dcf. \u0dc4\u0dd0\u0db8\u0daf\u0dcf\u0db8 \u0dad\u0db8\u0dca \u0da7 \u0dad\u0db8\u0dca \u0dc1 \u0dc4\u0dd0\u0dca \u0dc1\u0daf\u0dca \u0dc1\u0db3\u0daf\u0dcf \u0d9c\u0dad\u0dca\u0dad\u0dcf. \u0d9a\u0dc1\u0d94\u0dc6 \u0db1\u0dad\u0dad\u0dcf\u0dc0 \u0d85\u0dca \u0dad \u0daf\u0dd4\u0dc2\u0dca\u0d9a\u0d9a \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0d9a\u0da7 \u0db4\u0dad\u0dca \u0dc1\u0dc0 \u0dcf \u0dc3\u0dd2\u0da7\u0dd2 \u0daf\u0dd3, \u0d94\u0dc0\u0dd4\u0dca \u0dc1 \u0dc4\u0dd0\u0dca \u0dc1\u0daf\u0dca \u0d94\u0dc0\u0dd4\u0dca \u0da7 \u0dc0\u0dd2\u0dad\u0d9a\u0dca\u0dc2 \u0dc1\u0db3\u0daf\u0dcf \u0d9c\u0dad\u0dca\u0dad\u0dcf. \u0da7 \u0db1\u0dd2\u0d82\u0dcf \u0dc1\u0db8\u0dca \u0d9a\u0dc1\u0d94\u0dc6 \u0dc0\u0dd0\u0da9\u0dcf \u0d9a\u0d9a\u0dad \u0db1\u0dad\u0dad\u0dcf\u0dc0 \u0dc3\u0dad\u0dd4\u0dc5\u0dd4 \u0d85\u0dc1\u0dad\u0dca\u0dc2 \u0d85 \u0da7 \u0d82\u0dcf\u0db1\u0dcf\u0d9a\u0dab, \u0dba\u0dd4\u0dca\u0dc2\u0dad\u0dd2\u0d82\u0dc4\u0d9c\u0dad \u0d85\u0dba\u0dd2\u0dad\u0dd2 \u0dca\u0dc2 \u0dad\u0dd2\u0dd4\u0dab\u0dab\u0dcf, \u0da7 \u0d85 \u0dc1 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0db8\u0dca \u0daf\u0dd2\u0dad\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0d82 \u0dc4\u0dcf \u0da7 \u0db1\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0da7 \u0d91\u0dc1\u0d9a\u0dc4\u0dd2\u0dc0 \u0d82\u0da7\u0dca \u0d9a\u0d9a\u0dca \u0dad. \u0dc4\u0dd0\u0db3\u0dd0\u0dba\u0dd2, \u0dc1\u0db8\u0dca \u0db1\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0db8\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0dca \u0dc1 \u0d9a\u0dca\u0dc2\u0dc2\u0dab \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca .\u0dbd\u0dd2 \u0dad\u0dc1\u0d9c \u0dc3\u0dd2\u0da7 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 250,000 \u0daf\u0dca\u0dc2\u0dc0\u0dcf \u0d85\u0da9\u0dd4 \u0d9a\u0d9a\u0db4\u0dd4 \u0db1\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dca\u0dc2; \u0dc0\u0dcf\u0dc4\u0dad \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dca\u0dc2\u0dc1\u0dc2\u0dda\u0db4 \u0d9a\u0d9a\u0db4\u0dd4 \u0db1\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dca\u0dc2. \u0db1\u0dad\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dbd\u0dd2\u0dc0 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf, \u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4 \u0dc1 \u0db8\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0dca \u0da7 \u0dc0\u0dcf\u0dc4\u0dad \u0dad\u0dd0\u0dad \u0d9a\u0dd2 \u0dcf. \u0db8\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0dca \u0dc1 \u0dc0\u0d9a\u0dca\u200d\u0dbb\u0d82\u0dcf\u0daf \u0d9a\u0dda\u0db4\u0dcf\u0daf\u0dd4 \u0d9a\u0d9a \u0d9c\u0dad\u0dca\u0dad\u0dd4 \u0db1\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dca\u0dc2, \u0dc1\u0db8\u0dca\u0d9a. \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0db1\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dca\u0dc2 \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0daf \u0dc1\u0db8\u0dca \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dad\u0dd4\u0dc5\u0dd4 \u0dc1\u0db8\u0dca \u0d82\u0dc4\u0dad \u0db1\u0dad\u0dad\u0dcf\u0dc0\u0da7 \u0db3\u0dcf \u0daf\u0dd3 \u0dcf \u0dad\u0dd2\u0dc1\u0db3\u0dca \u0dc1\u0dca ."
