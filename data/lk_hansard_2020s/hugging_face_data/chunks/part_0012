    "chunk_text": "\u0dc1\u0db8\u0dca \u0dc1 \u0da7\u0dd2 \u0dcf\u0d9a\u0db1 \u0dad\u0dd4\u0db8\u0dc5 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dc1\u0db1\u0db1\u0dca[ \u0dc1\u0d9c\u0ddc\u0dc0\u0dd2 \u0da2\u0dc0\u0dad\u0dcf\u0dc0\u0dc1 \u0dd6\u0dbd\u0dbd\u0dd2 \u0dca\u200d\u0dbb \u0dca\u0dc0\u0dc0\u0d9a\u0da7 \u0d85\u0db4\u0dd2 \u0dda\u0dad\u0dca\u0dad\u0dbb \u0dc3\u0db4\u0db1\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dc0\u0dcf. \u0daf\u0dca\u200d\u0dad\u0db1\u0dca \u0dc1\u0d9c\u0ddc\u0dc0\u0dd2\u0db1\u0dcf [\u0dc4 \u0db4\u0dcf\u0dbb\u0da7 \u0db6\u0dc4\u0dd2\u0dc0 \u0dad\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb \u0da7\u0dd2 \u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dc0\u0dcf. \u0dc1\u0db8\u0dca \u0dcf\u0d9a\u0dc1\u0dda \u0dc1\u0d9c\u0ddc\u0dc0\u0dd2\u0db1\u0dcf \u0db4\u0dcf\u0dbb\u0da7 \u0db6\u0dc4\u0dd2\u0dc0 \u0dcf\u0dbb\u0dab\u0dcf \u0dc1\u0daf\u0dca\u200d \u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf. \u0d92 \u0dc1\u0daf\u0dca\u200d [ \u0daf\u0dca\u200d\u0dad\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0dc0\u0dc0\u0dad\u0dca\u0dc0\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dc0\u0dcf. \u0dc4\u0dad\u0db6\u0dad\u0dd2 , \u0d92 \u0dc0\u0dad\u0dc0\u0dad\u0dad\u0dca\u0dc0\u0dd6\u0dc1\u0dda \u0db1\u0dd3\u0dad\u0dd2\u0db1 \u0dc4\u0db8\u0dd4\u0dc0\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0d9a\u0dcf \u0dc1\u0dc4\u0ddd [\u0dbb\u0dca\u0daf\u0dca\u200d\u0dc0\u0db1 \u0dbb\u0d9a\u0dcf \u0dc1\u0dc0\u0ddc\u0dc1\u0dc0\u0dd2 . \u0dda\u0daf\u0dca\u200d\u0dcf\u0dc4\u0dbb\u0dab\u0db1\u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0db1\u0da7 \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0ddc\u0dad\u0dca \u0daf\u0dca\u200d\u0dad\u0db1\u0dca [\u0dc4 \u0db1\u0dca\u0dc0\u0dc1\u0dda \u0d85\u0dc3\u0dca\u0dc0\u0db1\u0dd4 \u0dc1\u0dc0\u0dc5\u0dc0\u0dc0\u0dcf. \u0dc1\u0dc0\u0dc0 \u0daf\u0dca\u200d\u0dcf \u0dc1\u0db8\u0dca \u0dcf\u0d9a\u0db1 \u0dc0\u0dc0\u0dc1 \u0ddc\u0da7 \u0dc1\u0d9c\u0ddc\u0dc0\u0dd2 \u0da2\u0dc0\u0dad\u0dcf\u0dc0 [\u0dc4 \u0db4\u0dcf\u0dc1\u0dbb\u0dca \u0dda\u0daf\u0dca\u0dc1\u0d9d\u0ddd\u0dc2\u0dab 