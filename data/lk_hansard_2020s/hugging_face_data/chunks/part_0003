    "chunk_text": "\u0db8\u0db8 \u0d89\u0dd2\u0db1\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0dd4\u0dc5 \u0dc1\u0daf\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0dc1\u0db8\u0dca\u0d9a\u0dd2, \u0dbb\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dd4\u0db8\u0db1\u0dd20 \u0dbb\u0dd4 \u0dbb\u0dcf\u0da2\u0dcf\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0db1\u0daf\u0dcf \u0db1\u0dba\u0da7 \u0d8b\u0dad\u0dca\u0dad\u0dbb\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0dd4\u0dc0\u0db1\u0dca\u0dad\u0db1\u0dcf0 \u0db8\u0dd0\u0dc1\u0dca \u0dc3\u0dd2\u0dba\u0dcf\u0dc0\u0da7 visit visa \u0dba\u0da7\u0dc1\u0dad\u0dca \u0d9c\u0dd2\u0dba \u0d9a\u0dd2\u0dc4\u0dd2\u0db4 \u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dd4\u0da7 \u0db8\u0dcf\u0dbb\u0dcf\u0db1\u0dca\u0dad\u0dad\u0dd2\u0d9a \u200d\u0dbb\u0dc4\u0dcf\u0dbb \u0db1\u0dca \u0dbd \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf0 \u0d92 \u0d85\u0dba \u0d9a\u0dd0\u0dc1\u0dca \u0db4\u0dd0\u0db1\u0dd4\u0dc5 \u0d9a\u0dae\u0dcf\u0dc0\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad0 \u0db8\u0da7 \u0db1\u0dba \u0dc0 \u0d9a\u0dd3\u0dc1\u0db8\u0db1\u0dca\u0dad \u0daf\u0dd0 \u0d9a\u0db8\u0dca \u0dd4\u0dc0\u0db1\u0dca\u0dad\u0db1\u0dcf0 \u0dbb\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dd4\u0db8\u0dcf \u0db8\u0da7 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0db0\u0dd3\u0d9a\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0dc4\u0daf\u0dbd\u0dcf \u0dd4\u0dc0\u0db1\u0dca\u0dad\u0db1\u0dcf0 \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dad\u0dc0\u0db8 \u0db1\u0dba\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0dd4\u0dbb\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0db1\u0dca\u0dad\u0db1 \u0d85\u0db4\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd4\u0dc1\u0da9\u0dd4\u0d9a \u0db1\u0dd0\u0dc4\u0dd00 \u0d92 \u0dd0\u0db1 \u0dba\u0db8\u0dca\u0d9a\u0dd2\u0dc3\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0dd4\u0dbb\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0dc1\u0daf\u0db1\u0dca\u0dad\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0dad \u0db1\u0db8\u0dca \u0dc1\u0dc4\u0dcf\u0db3\u0dd20 Dubai \u0dc0\u0dbd taxi company \u0db1\u0d9a\u0da7 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0dcf \u200d\u0dbb \u0dca\u0db1\u0dba \u0d85\u0dc1\u0dda \u0d9a\u0dd0\u0db6\u0dd2\u0db1\u0da7\u0dca \u0d87\u0db8\u0dad\u0dd2\u0dd4\u0db8\u0dcf\u0da7\u0dd2 \u0db8\u0db8 \u0dc1\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dc1\u0dc5\u0dca0 \u0dbb\u0dd4 \u0dbb\u0dcf\u0da2\u0dcf\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0db8\u0da7 \u0db1\u0daf\u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0dd4\u0dbb\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0dd4\u0dc0\u0db1\u0dca\u0dad\u0db1\u0dcf0 \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d85\u0dbb \u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0dba\u0da7 \u0dbd\u0d9a\u0dca \u0dc1\u0dc0\u0da0\u0dca\u0da0\u0da0 \u0d85\u0dba \u0dd0\u0db1 \u0dad\u0dc0\u0db8 \u0dc1\u0dad\u0dcf\u0dbb\u0dd4\u0dbb\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd4\u0dc1\u0da9\u0dd4\u0d9a \u0db1\u0dd0\u0dc4\u0dd00\n\n\u0d8a\u0dc5\u0d9f \u0db1\u0d9a, \u0dca\u0db6\u0dcf\u0dd2 \u0da7\u0dd0\u0d9a\u0dca\u0dc3\u0dd2 \u0dbb\u0dae \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0dcf\u0dc1\u0dba\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0dd4\u0dc5 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf\u0dc00 \u0d92 \u0dbb\u0da7\u0da7 \u0d85\u0dc0 \u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dcf \u0d89\u0dca \u0dbd\u0dd4\u0dc5 \u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0da7 \u0dd3 \u0dad\u0dba \u0d9a\u0dd6\u0dbd\u0dbd \u200d\u0dbb\u0db8\u0dba\u0da7 \u0dad\u0db8\u0dd2 \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad0 \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0d92 \u0dbb\u0da7\u0da7 \u0d9c\u0dd2\u0dba\u0dcf\u0dd2\u0db1\u0dca\u0dad \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dca \u0d85\u0dc0 \u0dba \u0dd4\u0dc5\u0dc4\u0dd4\u0dab\u0dd4\u0dc0 \u0dbd\u0db6\u0dcf\u0dc1 \u0db1 \u0d92 licence \u0db1\u0d9a \u0db1\u0dca\u0dad\u0db1 \u0da7\u0dd2\u0d9a \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dad \u0dc1\u0dc0\u0db1\u0dc0\u0dcf0 \u0d92 \u0d9a\u0dcf\u0dbd\u0dba \u0dad\u0db8\u0dd2 \u0dad \u0dc0\u0dd4\u0dc1\u0da9\u0dd4\u0d9a0 \u0daf\u0dd0\u0db1\u0dca\u0dad \u0dc1\u0db6\u0dcf\u0dc1\u0dc4\u0ddd \u0d85\u0dba\u0da7 licence \u0db1\u0d9a \u0dbd\u0dd0\u0db6\u0dd2\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf0 \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0d92 \u0d85\u0dba exam \u0db1\u0d9a \u0db4\u0dcf\u0dc3\u0dca \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf0 \u0db1\u0dc1\u0dc4\u0dca driving licence \u0db1\u0d9a \u0d92 \u0d85\u0dba\u0da7 \u0dbd\u0dd0\u0db6\u0dd2\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf0 \u0dc3\u0db8\u0dc4\u0dbb \u0d85\u0dba licence \u0db1\u0d9a \u0dbd\u0dd0\u0db6\u0dd4\u0dab\u0dad\u0dca, \u0db1\u0dd0\u0dc0\u0dad \u0dc1 \u0db1\u0dca\u0dad\u0dc0\u0dcf \u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dcf \u0d89\u0dca \u0dbd\u0dd3\u0db8\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf0 \u0d89\u0dad\u0dd2\u0db1\u0dca\u0dad, \u0d92 \u0d85\u0dba\u0da7 \u0d92 \u0d85\u0dc0\u0d9a\u0dcf \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf0 \u0dc3\u0db8\u0dc4\u0dbb \u0d85\u0dba\u0da7 \u0d92 \u0dc0\u0dd2\u0db7\u0dcf \u0dba \u0db4\u0dcf\u0dc3\u0dca \u0d9a\u0dbb \u0db1\u0dca\u0dad\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf0 \u0db1\u0dc1\u0dc4\u0dca\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0dbd\u0dcf \u0dad\u0db8\u0dd2 \u0dc0\u0dd2\u0db7\u0dcf \u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad0 \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad, \u0dbb\u0dd2\u0dba\u0dd0\u0dd4\u0dc0\u0dbb\u0db1\u0dca\u0dad\u0db8 \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dd2 taxi drivers\u0dbd\u0dcf \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad0 \u0d92 \u0dc3\u0db8\u0dc4\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dbb\u0dd2\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7\u0dd2 \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad0 \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad interview \u0db1\u0dc1\u0d9a\u0dca\u0daf\u0dd3 \u0dc1\u0d9a\u0dcf\u0dc1\u0dc4\u0dcf\u0db8 \u0dc4\u0dbb\u0dd2 \u0dc0\u0dcf\u0dc4\u0db1\u0dba \u0db4\u0daf\u0dc0\u0dcf \u0dc1\u0db4\u0db1\u0dca\u0dad\u0dc0\u0dbd\u0dcf \u0db1\u0dd2\u0dc3\u0dd2 \u0dd4\u0dc5\u0dc4\u0dd4\u0dab\u0dd4\u0dc0 \u0dc1\u0db1\u0dcf\u0dbd\u0db6\u0dcf \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca\u0dad \u0d92 \u0dbb\u0dc1\u0da7\u0dca\u0daf\u0dd3 \u0d92 \u0dc3\u0dc4\u0dad\u0dd2\u0d9a\u0dba \u0db1\u0dca\u0dad\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf0 \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dad\u0db8\u0dd2 \u0d92 \u0d85\u0dba \u0db1\u0dd0\u0dc0\u0dad \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0da7 \u0dc1 \u0db1\u0dca\u0dad\u0dc0\u0dcf \u0dd0\u0dd3 \u0db8\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad0 \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0dba\u0db8\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0dca \u0d89\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf \u0dc0\u0dd2\u0db7\u0dcf \u0dba \u0db4\u0dcf\u0dc3\u0dca \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dad\u0dca, \u0d85\u0db4\u0da7 \u0daf\u0dd0\u0db1\u0dca\u0dad \u0db1\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d9a\u0dd2\u0dba\u0db10 \u0d85\u0db4\u0dd2 \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0dbd\u0dc3\u0db1\u0dc0\u0dcf \u0d92 \u0d85\u0dba \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0da7 \u0dc1 \u0db1 \u0db1\u0db1\u0dca\u0dad\u0db1\u0da70"
