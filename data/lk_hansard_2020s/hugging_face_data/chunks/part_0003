    "chunk_text": "\u0da9\u0dd2\u0da2\u0dd2\u0da7\u0dca \u0d9a\u0dbb\u0dab\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0\u0dad\u0dca \u0db8\u0db8 \u0db8\u0dad\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd10 \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dc1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0da9\u0dd2\u0da2\u0dd2\u0da7\u0dca \u0d9a\u0dbb\u0dab\u0dba \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dad\u0dc0\u0dcf \u0dc1\u0daf\u0db1\u0dc0\u0dcf0 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0d86\u0dba\u0dad\u0db1 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0dcf \u0d9a\u0dbb\u0dc1 \u0db1 \u0d85\u0db4\u0dd2 \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dad\u0dc0\u0dcf \u0dc1\u0daf\u0db1 National Labour Market Information System - NLMIS - \u0db1\u0d9a \u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0daf \u0dd4\u0dc5\u0daf\u0dd3 \u0d85\u0db4\u0da7 \u0db4\u0da7\u0db1\u0dca\u0dad \u0db1\u0dca\u0dad\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0dad0 \u0daf\u0dd0\u0db1\u0dca\u0dad \u0d92\u0dc1\u0d9a\u0dca \u0dc1\u0da7\u0db1\u0dca\u0dad\u0da9\u0dbb\u0dca\u0dbd \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0dad\u0db8\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad0 \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0d9a\u0dd0\u0db6\u0dd2\u0db1\u0da7\u0dca \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0dc1\u0d86 \u0db8\u0dd6\u0dd2\u0d9a \u0d85 \u0d9a\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dad\u0dca \u0d85\u0db4\u0da7 \u0dbd\u0dd0\u0db6\u0dd3 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf0\n\n\u0dbb\u0dc1\u0da7\u0dca \u0dc3\u0db8\u0dcf\u0da2\u0dcf \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab\u0dba \u0dd0\u0db1\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd10 \u0dc3\u0db8\u0dcf\u0da2\u0dcf \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u200d\u0dbb\u0db8\u0dba \u0dba\u0da7\u0dc1\u0dad\u0dca, \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0d85\u0dc4\u0dd2\u0db8\u0dd2 \u0dd3\u0dc1\u0db8\u0dca\u0daf\u0dd3 \u0dbb\u0d9a\u0dca\u0dc2\u0dab\u0dba\u0d9a\u0dca -unemployment insurance - \u0d85\u0dc1\u0dda \u0dc1\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0dad\u0da7 \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d9a\u0dd0\u0db6\u0dd2\u0db1\u0da7\u0dca \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0dc1\u0d86 \u0d85 \u0d9a\u0db8\u0dd0\u0dad\u0dd2\u0dba \u0d87\u0dad\u0dd2\u0dc0 \u0da2\u0dcf\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0d9a\u0db8\u0dd2\u0dd4\u0dc0\u0dc0\u0d9a\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0dbd\u0dcf, \u0db8\u0dcf\u0dc3 3\u0d9a\u0dca \u0d87\u0dd4\u0dc5\u0dad \u0d85\u0dc0 \u0dba \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb \u0dc1\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0db4\u0da7 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf0 \u0d92 \u0d85 \u0d9a\u0dc0, \u0db8\u0dd4\u0dd4\u0dc0 \u0dbb\u0dc1\u0da7\u0dca \u0d89\u0db1\u0dca\u0dad\u0db1 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dc1\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0dad\u0dc1\u0dda \u0dc3\u0db8\u0dcf\u0da2\u0dcf \u0dc3\u0dd4\u0db6\u0dc3\u0dcf\u0dcf\u0db1\u0dba, \u0dc3\u0db8\u0dcf\u0da2\u0dcf \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dc0 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0dcf\u0dc1\u0dba\u0db1\u0dca\u0dad \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5\u0d9a\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc1\u0dc0\u0db1\u0dc0\u0dcf0 \u0db1\u0dad\u0dd0\u0db1\u0daf\u0dd3 \u0db8\u0dcf\u0dad\u0dd2 \u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7, \u0dc0\u0db1\u0dca\u0dad\u0dd2\u0db1 \u0dc1 \u0dd3\u0db8\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf0 \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 unemployment insurance \u0db1\u0d9a \u0dc1\u0db8\u0dca \u0dc4\u0dbb\u0dc4\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc1\u0dc0\u0db1\u0dc0\u0dcf0 \u0d92\u0dad\u0dca \u0db1\u0d9a\u0dca\u0d9a\u0db8 dignity of labour \u0d9a\u0dd2\u0dba\u0db1 concept \u0db1\u0d9a \u0dba\u0da7\u0dc1\u0dad\u0dca \u0dc1\u0db8\u0dca \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5\u0dad\u0dca \u0db1\u0d9a\u0dca\u0d9a \u0dc1\u0dca\u200d\u0dbb\u0db8\u0dba\u0da7 \u0d85\u0db7\u0dd2\u0db8\u0dcf\u0db1\u0dba\u0d9a\u0dd4\u0dad\u0dca \u0d87\u0dd4\u0dd4\u0dc0 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0dcf\u0dc1\u0dbb\u0dcf\u0dad\u0dca\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf0\n\n\u0d85\u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0d85\u0d82 \u0dc1\u0d86 \u0dc1\u0dc3\u0dca\u0dc0\u0d9a\u0dba\u0db1\u0dca\u0dad\u0da7 \u0dbb\u0dd4\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca, \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dc0\u0d9a\u0dca \u0dbd\u0db6\u0dcf\u0dc1\u0daf\u0db1 \" \u0dbb\u0dd4 \u0dc3\u0dbb\u0dd4\" \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db8\u0db8 \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dc5\u0dcf0 \u0db1\u0dad\u0dd0\u0db1\u0daf\u0dd3 \u0db4\u0dc0\u0dd2\u0dad\u0dca\u200d\u0dbb\u0dad\u0dcf \u0d85\u0d82 \u0dc1\u0d86 \u0d89\u0db3\u0dbd\u0dcf \u0dc4\u0dd0\u0db8 \u0dd4\u0dc5\u0d82\u0dd2 \u0db8 \u0d9a\u0dc2\u0dba\u0dc1\u0dba\u0d9a\u0dd4\u0da7\u0db8 \u0dbb\u0dd4\u0dad\u0dca\u0dc0\u0dba \u0dbd\u0db6\u0dcf\u0daf\u0dd3\u0dc1\u0db8\u0dca \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5\u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf0"
