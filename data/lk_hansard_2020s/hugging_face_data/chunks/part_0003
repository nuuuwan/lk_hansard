    "chunk_text": "\u0dd4\u0dc5\u0dc4\u0dd4\u0dab\u0dd4 \u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0d89\u0dd2\u0db1\u0dbb\u0dd2 \u0d9a\u0dcf\u0dbd\u0dc1\u0d86\u0daf\u0dd3 \u0d85\u0dc1\u0dda \u0dc0\u0dd2\u0dc1\u0daf\u0dc3\u0dca \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dc4 \u0dc1\u0dca\u200d\u0dbb\u0db8\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d86\u0d82\u0dc1\u0dd2\u0d9a \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0dc4\u0daf\u0db1\u0dca\u0dad\u0db1 \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0dcf\u0dc1\u0dbb\u0dcf\u0dad\u0dca\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf0 \u0d92\u0d9a \u0dbb\u0da7\u0da7 \u0d85\u0dad\u0dba\u0dc0 \u0dba\u0dd20 \u0d92 \u0dd4\u0dc5\u0dc4\u0dd4\u0dab\u0dd4 \u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2\u0dba \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0dad\u0dcf\u0d9a\u0dca \u0d9a\u0dca \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0db1\u0d9a \u0db1\u0d9a\u0dca\u0dc1\u0d9a\u0db1\u0dcf\u0da7 \u0d95\u0db1\u0dd1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7, \u0d95\u0db1\u0dd1 \u0d9a\u0dbb\u0db1 \u0dc0\u0dd0\u0da9 \u0dc1\u0d9a\u0dcf\u0da7\u0dc3 \u0d9a\u0dbb \u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf0 \u0dc0\u0dd2\u0dc1 \u0dca\u0dc2\u0dc1\u0dba\u0db1\u0dca\u0dad \u0db8\u0db8 \u0db8\u0dad\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf, \u0d89\u0dd2\u0db1\u0dbb\u0dd2 \u0d9a\u0dcf\u0dbd\u0dc1\u0d86\u0daf\u0dd3 \u0d92\u0dc0\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d94\u0db6\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dcf\u0dad\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0dcf \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf0 \u0dc0\u0dd2 \u0dc1 \u0dca\u0dc2\u0dc1\u0dba\u0db1\u0dca\u0dad\u0db8 \u0dc0\u0dd2\u0dc1\u0dda \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0dbd \u0db1\u0dd2\u0dbb\u0dad \u0dc1\u0dc0\u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0d85\u0dba \u0dc1\u0dc0 \u0d9a\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0\u0dd0\u0dd4\u0dc0\u0db4\u0d9a\u0dca, insurance \u0db1\u0d9a\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0dc1\u0daf\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dc1\u0d86 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1\u0d9a\u0dca \u0dc4\u0daf\u0db1\u0dca\u0dad\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0dad0 \u0d92\u0dc1\u0d9a \u0d9a\u0dad\u0dca \u0dc0\u0dd2 \u0dcf\u0dbd \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0d85\u0db4\u0da7 \u0d92\u0d9a\u0dbb\u0dcf\u0dc1\u0dd3 \u0d9a\u0dbb \u0db1\u0dca\u0dad\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0dad0 \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0d92 \u0d85\u0dba \u0dc1\u0dc0 \u0d9a\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0dc3\u0dd4\u0db6\u0dc3\u0dcf\u0dcf\u0db1 \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0dad0 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0 \u0db1\u0d9a\u0dca\u0d9a \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0db0\u0dd3\u0d9a\u0dbb\u0dab\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0dad0 \u0d92 \u0dc0\u0dd0\u0da9 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca\u0dad\u0da7\u0dad\u0dca \u0d94\u0db6\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dcf \u0dd6 \u0daf\u0dcf\u0db1\u0db8\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc0\u0dd2\u0dc1 \u0dca\u0dc2\u0dc1\u0dba\u0db1\u0dca\u0dad \u0db8\u0dcf \u0d89\u0dca \u0dbd\u0dd3\u0db8\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf0\n\n\u0dc0\u0dd2\u0dc1 \u0dca\u0dc2\u0dc1\u0dba\u0db1\u0dca\u0dad\u0db8 \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba \u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5 \u0dba\u0dd4\u0dd4\u0dd20 \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0dc0\u0dd0\u0dd4\u0dc0\u0dda \u0dbd\u0db6\u0dcf \u0db1\u0dca\u0dad\u0db1\u0dcf \u0db4\u0dd2\u0dbb\u0dd2\u0dc3 \u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dc0\u0dd0\u0dd4\u0dc0\u0dda \u0dbd\u0db6\u0db1 \u0d85\u0dba \u0dc3\u0dc4 \u0d85\u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dc0\u0dd0\u0dd4\u0dc0\u0dda \u0dbd\u0db6\u0db1 \u0d85\u0dba \u0dba \u0d9a\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0db6\u0daf\u0dcf \u0d85\u0db4\u0dd2 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf0 \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 40\u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dc0\u0dd0\u0dd4\u0dc0\u0dda \u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf0 \u0dc3\u0dd2\u0dba\u0dba\u0da7 60\u0d9a\u0dca \u0d85\u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dc0\u0dd0\u0dd4\u0dc0\u0dda \u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf0 \u0db1\u0dad\u0dc1\u0d9a\u0dcf\u0da7 \u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca\u0dc0 \u0dc0\u0dd0\u0dd4\u0dc0\u0dda \u0db1\u0dca\u0dad\u0db1\u0dcf \u0dc3\u0dd2\u0dba\u0dba\u0da7 40 \u0d9a\u0dad\u0dca \u0d85\u0dca \u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0dad\u0db8\u0dd2 \u0dc1\u0dc3\u0dca\u0dc0\u0d9a \u0d85\u0dbb\u0dca\u0dbd\u0dae \u0dc3\u0dcf\u0dcf\u0d9a \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd\u0da7 -Employees\u2019 Provident Fund - \u0db1\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca EPF \u0db1\u0d9a\u0da7 \u0daf\u0dcf\u0dba\u0d9a \u0dd3 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad0 \u0d92 \u0dc0\u0dd2 \u0dcf\u0dbd \u0dc3\u0d82\u0d9b\u0dba\u0dcf\u0dc0\u0d9a\u0dc1\u0dda \u0daf\u0dcf\u0dba\u0d9a\u0dad\u0dca\u0dc0\u0dba \u0d85\u0dbb\u0dc1 \u0db1 \u0db1\u0dd0\u0dc4\u0dd00 \u0d85\u0db4\u0dd2 \u0d86\u0db4\u0dc3\u0dca\u0dc3\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca\u0dad \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad0 \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba \u0dc1\u0db8\u0da0\u0dca\u0da0\u0da0\u0dbb \u0d9a\u0dca \u0d9a\u0dbb\u0dd4\u0dc5 \u0dc0\u0dd0\u0da9 \u0da7\u0dd2\u0d9a \u0d85\u0dbb\u0dc1 \u0db1 \u0db6\u0dd0\u0dbd\u0dd4\u0dc0\u0dcf\u0db8, \u0dad\u0dc0\u0dd4\u0dc0\u0dbb\u0da7\u0dad\u0dca \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0d85\u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dc0\u0dd0\u0dd4\u0dc0\u0dda \u0dbd\u0db6\u0db1 \u0dc1\u0d9a\u0dcf\u0da7\u0dc3\u0d9a\u0dca \u0d89\u0db1\u0dca\u0dad\u0db1 \u0db6\u0dd0\u0dc4\u0dd00 \u0d92 \u0d94\u0d9a\u0dca\u0dc1\u0d9a\u0ddd\u0db8 \u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0d9a\u0dbb\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0dad, \u200d\u0dbb\u0db8\u0dba\u0d9a\u0dca \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0dbd\u0dcf0 \u0dc4\u0dd0\u0db6\u0dd0\u0dd2, \u0d92 \u200d\u0dbb\u0db8\u0dba \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd00 \u0d85\u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0dc3\u0dc4 \u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0dba \u0d9a\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0d9a\u0dcf\u0da7\u0dc3\u0dca \u0dc1\u0daf\u0d9a\u0d9a\u0dca \u0dad\u0db6\u0dcf\u0dc1 \u0db1, \u0d85\u0dca \u0dab\u0dc1\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0dc3\u0dd2\u0dba\u0dba\u0da7 40\u0dc0\u0dad\u0dca \u0d92\u0d9a\u0dbb\u0dcf\u0dc1\u0dd3 \u0d9a\u0dbb\u0dc1 \u0db1 \u0db1\u0dd0\u0dc4\u0dd0, \u0dc4\u0dbb\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0dbb \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5\u0d9a\u0da70"
  },
