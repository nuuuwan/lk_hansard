    "chunk_text": "\u0d85\u0db4\u0da7 \u0dd2\u0dbb\u0dc1\u0db1\u0db1 \u0db4\u0dca\u200d\u0dbb \u0daf\u0db1\u0dcf \u0db4\u0dca\u200d\u0dbb \u0dae\u0db1\u0d9a \u0dad\u0dcf\u0dba\u0dd2 \u0dc1\u0dca\u0db6 \u0d86\u0d9a\u0dad\u0db1\u0dc1\u0dda \u0dc0\u0dca\u200d\u0d9a\u0dad\u0db1 \u0dc0\u0dd2\u0d9a\u0dcf\u0dca\u0db6. \u0d9c\u0dbb\u0dd4 \u0dca\u0dcf\u0daf\u0db4\u0dd2\u0dbb\u0dad\u0dd4\u0dcf\u0db1\u0dd2, \u0dad\u0dd0\u0db4\u0dd0\u0dbd\u0dca \u0dc1\u0dcf\u0db4\u0daf\u0d9a\u0dad\u0dc1\u0dca\u0db6\u0dca\u0dad\u0dd4\u0dc1\u0dda \u0dc0\u0dca\u200d\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dca\u0db3\u0dc4\u0daf \u0dc0\u0dd2\u0dad \u0d9a\u0dca \u0dc0\u0dca\u200d\u0d9a\u0dc2\u0d9a \u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0d9a\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0d9a\u0db1 14,400\u0d9a\u0dca \u0dc0\u0dca\u200d\u0dd0\u0d9a \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf. \u0d9c\u0dbb\u0dd4 \u0da2\u0db1\u0daf\u0db0\u0dd2\u0db4\u0dd2\u0dbb\u0dad\u0dd4\u0dcf\u0daf \u0dc5 \u0dc0\u0dca\u200d\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dcf\u0dad\u0dca \u0d91\u0d9a\u0dca \u0dc1\u0dcf\u0d9a\u0da7 \u0dad\u0dc0\u0dca\u200d \u0dbb\u0dd4\u0db4\u0dd2\u0d9a\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0d9a\u0db1 3,000\u0d9a\u0dca \u0d91 \u0dad\u0dd4 \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf. \u0d91\u0dad\u0dc1 \u0ddc\u0da7 \u0dad\u0dd0\u0db4\u0dd0\u0dbd\u0dca \u0dc1\u0dcf\u0db4\u0daf\u0d9a\u0dad\u0dc1\u0dca\u0db6\u0dca\u0dad\u0dd4\u0dc1\u0dda \u0dc0\u0dca\u200d\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc1\u0d9c\u0dc0\u0dd3\u0dcf \u0dca\u0db3\u0dc4\u0daf \u0dc0\u0dd2\u0dad \u0d9a\u0dca \u0d91 \u0dc0\u0dca\u200d\u0d9a\u0dc2\u0d9a \u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0d9a\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0d9a\u0db1 17,400\u0d9a\u0dca \u0d85\u0dc0\u0dca\u200d \u0dba \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf. \u0dad\u0dcf\u0dba\u0dd2 \u0dd2\u0dbb\u0dc1\u0db1\u0db1 \u0d85\u0d9a\u0dca\u0dc1\u0d9a\u0ddd\u0d9c\u0d9a. \u0db1\u0dd2\u0dca\u0daf \u0d85\u0db4\u0dd2 \u0dc0\u0dd4\u0dbb\u0dd4\u0dad\u0dca \u0dc1\u0dca\u0db6 \u0d85\u0d9a\u0dca \u0dc1\u0d9a\u0ddd\u0d9c \u0dc1\u0dad\u0dca\u0dbb\u0dd4\u0dca\u0db6 \u0d85 \u0dc1\u0d9c\u0db1 \u0d85\u0dc0\u0dca\u200d \u0dba \u0dc0\u0dca\u200d\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dca\u200d\u0dc5 \u0db1\u0dd2\u0d9a\u0dcf\u0daf\u0dab\u0d9a \u0db8\u0dd2\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0d9a\u0da7 \u0d9a\u0daf \u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dca\u200d \u0dd2\u0dbb\u0dc1\u0db1\u0db1\u0dc0\u0dca\u200d\u0daf.\n\n\u0dc0\u0dca\u200d\u0daf\u0dc1\u0dda\u0dcf \u0d9c\u0dd3\u0dad\u0daf \u0d9a\u0dd4\u0dcf\u0daf \u0dc3\u0dd2\u0dc3\u0dc4 \u0dcf\u0dd0\u0dd2\u0dbb\u0db1\u0dd2\u0d9a \u0d9a\u0dd2\u0d9a\u0db4\u0dd4 \u0dcf\u0dc5\u0dd4\u0d9c\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dc1\u0daf\u0dca \u0dc1\u0dda \u0dd2\u0dbb\u0dc1\u0db1\u0db1 \u0da0\u0dd2\u0dad\u0dca\u200d\u0dbb\u0db4\u0da7 \u0dca\u0dc3 \u0d9a\u0dca\u0dc2\u0dab\u0daf\u0d9c\u0daf \u0dc1\u0dda \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dca\u200d\u0dbd \u0d9a\u0dca\u0db6 \u0d85\u0da9\u0db4\u0dab \u0dc0\u0dd3\u0dcf\u0d9a\u0dca \u0dd2\u0dbb\u0db6\u0dd4\u0dab\u0dd4 \u0db1\u0dc0\u0dca\u200d \u0d85\u0db4\u0dd2 \u0dcf\u0dca\u0db1\u0dc0\u0dca\u200d\u0daf. \u0d91\u0dcf \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dca\u200d\u0d9a \u0db1\u0dd2\u0dc0\u0dca\u200d\u0dd0 \u0daf\u0dd2 \u0dca\u0db1 \u0d85\u0dc0\u0dca\u200d \u0dba \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0db4\u0dd2 \u0dc3\u0dd2\u0daf\u0dd4 \u0dbd\u0daf \u0dd2\u0dbb\u0dc1\u0db1\u0db1\u0dc0\u0dca\u200d\u0daf. \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dd2 \u0d89\u0dad\u0daf \u0d89\u0d9a\u0dca\u0dcf\u0db1\u0dd2\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dc0\u0dca\u200d\u0da7 \u0db1\u0dc3\u0dc0\u0dca\u200d\u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0db1\u0dc0\u0dca\u200d\u0daf.\n\n\u0d9c\u0d9a\u0dca\u0dad \u0dbb\u0dd4\u0dab\u0daf\u0dd2\u0dbb\u0dbd \u0dcf\u0dd0\u0dd2\u0dbb\u0dad\u0dd4\u0dcf\u0daf \u0d9a\u0dd2\u0d9a\u0db4\u0dd4 \u0d86 \u0daf \u0d9a\u0da7 \u0dc1 \u0ddc\u0dc0\u0dd2\u0dca -19 \u0d85\u0d9a\u0db6\u0dd4\u0dcf\u0d9a \u0db1\u0dd2\u0dca\u0daf\u0dad\u0dca, \u0dc1\u0da7\u0dca \u0d86\u0d9a\u0dae\u0dd2 \u0d85\u0d9a\u0db6\u0dd4\u0dcf\u0d9a \u0db1\u0dd2\u0dca\u0daf\u0dad\u0dca \u0d85\u0db4\u0da7 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0d9a \u0daf\u0dbd\u0d9a \u0dad\u0dd4\u0dc5\u0daf\u0dd3 \u0da2\u0db1\u0daf\u0db0\u0dd2\u0db4\u0dd2\u0dbb \u0dc3\u0dd2\u0db1\u0dcf\u0daf \u0dca\u0dca\u0db6\u0dcf\u0daf\u0db1 \u0db4\u0dc1\u0dc5\u0dbd \u0db4\u0dc0\u0dca\u200d\u0dad\u0dca\u0dc0\u0dca\u200d\u0dca\u0db1 \u0db1\u0dd0\u0dbb\u0dd2 \u0dc0\u0dd4\u0dab\u0daf. \u0d85\u0db4\u0dd2 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0d9c\u0dab\u0db1\u0dad\u0dca \u0dca\u0dd0\u0dbd\u0d9a\u0dd2\u0dbd\u0dca\u0dbd\u0da7 \u0dc1\u0d9c\u0db1 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0d9a \u0dcf\u0dc0\u0dca\u200d\u0dca \u0d9c\u0dbb\u0dd4 \u0da2\u0db1\u0daf\u0db0\u0dd2\u0db4\u0dd2\u0dbb\u0dad\u0dd4\u0dcf\u0daf\u0dc1\u0dda \u0db8\u0dd6\u0dbd\u0dd2 \u0dad\u0dca\u0dc0\u0dca\u200d\u0dc1\u0d9a\u0dca, \u0db1\u0daf\u0d9a \u0dad\u0dca\u0dc0\u0dca\u200d\u0dc1\u0d9a\u0dca, \u0dca\u0dc4\u0dcf\u0daf\u0d9c\u0dd2\u0dad\u0dca\u0dc0\u0dca\u200d\u0dc1\u0d9a\u0dca \u0dc1\u0db1\u0dc5\u0dd4\u0dca\u0db6 \u0dc1\u0db4\u0ddc\u0d9a\u0dd4\u0dab \u0dc4\u0dc1\u0dbd\u0dca\u0daf\u0dd3 \u0d91\u0d9a \u0d89\u0dad\u0daf\u0dcf \u0dca\u0daf\u0d9a\u0dcf \u0dc0\u0dca\u200d \u0db4\u0dd0\u0dc0\u0dca\u200d\u0dd0\u0dad\u0dca\u0dc0\u0dd6\u0dc0\u0dca\u200d\u0daf. \u0dc0\u0dca\u200d\u0daf\u0dc1\u0dda\u0dcf 2024 \u0dc0\u0dca\u200d\u0d9a\u0dc2\u0dc1\u0dda \u0dc3\u0dd2\u0da7 \u0da2\u0db1\u0daf\u0db0\u0dd2\u0db4\u0dd2\u0dbb \u0dca\u0dca\u0db6\u0dcf\u0daf\u0db1 \u0db4\u0dc1\u0dc5\u0dbd \u0dca\u0dc4 \u0da0\u0dd2\u0dad\u0dca\u200d\u0dbb\u0db4\u0da7 \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dd4\u0dc1\u0dc0\u0dca\u200d\u0dca \u0db1 \u0dca\u0dd1\u0dcf \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dca\u0da7\u0dc4\u0db1\u0d9a\u0dca\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dcf\u0daf\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0\u0dca\u200d \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0d9a\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dad\u0dca\u0dcf \u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0db1\u0dbd\u0daf\u0dc1\u0db4\u0ddc\u0dc1 \u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf.\n\n\u0daf\u0dca\u0dcf\u0daf\u0dab\u0dd2\u0d9a\u0dca \u0dca\u0db6 \u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0dcf\u0daf \u0d9a\u0dd2\u0dda\u0dc0\u0dca\u200d\u0daf, \u0db4\u0dca\u200d\u0dbb\u0dc1\u0daf\u0dca \u0dc0\u0dca\u200d\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dd8\u0dad\u0dca\u0dd2\u0dbb \u0dca\u0db4\u0d9a\u0db1 \u0dc1 \u0ddc\u0da7 ITN \u0d86\u0d9a\u0dad\u0db1\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0d9a\u0dbd\u0dca 2,000\u0d9a\u0dca \u0dc1\u0d9c\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf, \"\u0dc0\u0dca\u200d\u0dca\u0dca\u0dad\u0dca\u0db6\" \u0d86\u0d9a\u0dad\u0db1\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0d9a\u0dbd\u0dca 1,000\u0dba\u0dd2 \u0dc1\u0d9c\u0dc0\u0dca\u200d\u0dca\u0dc1\u0dca \u0d9a\u0dd2\u0d9a\u0dbd\u0daf. \u0d87\u0dad\u0dca\u0dad. \u0d85\u0db4\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dca\u0db1\u0dc0\u0dca\u200d\u0daf. \u0dca\u0db3\u0dc4\u0daf \u0d85\u0dc0\u0dca\u200d \u0dba \u0db4\u0db4\u0dc1\u0dcf\u0dca\u0dae \u0d85\u0db4\u0dd2 \u0dbd\u0db1\u0daf \u0daf\u0dd3\u0dbd\u0daf \u0dd2\u0dbb\u0dc1\u0db1\u0db1\u0dc0\u0dca\u200d\u0daf. \u0d91\u0dc4\u0dd2 \u0dca\u0dcf\u0daf\u0db4\u0dd2\u0dbb\u0dad\u0dd4\u0dcf\u0daf \u0d91 \u0dc1\u0dc0\u0dca\u200d\u0dbd\u0daf \u0dd2\u0dbb\u0dc1\u0db1\u0db1\u0dc0\u0dca\u200d\u0daf, \u0dca\u0dcf\u0daf\u0db1 \u0db8\u0dd4\u0dcf\u0dbd\u0d9a\u0dca \u0dc1\u0d9c\u0dc0\u0dd3\u0dcf \u0dca\u0db3\u0dc4\u0daf. \u0d9a\u0dd2\u0d9a\u0dca\u0dc1\u0dca, \u0da2\u0db1\u0dc0\u0dca\u200d\u0daf\u0dbb\u0dd2 \u0dcf\u0daf\u0dca\u0dc1\u0dda \u0dc3\u0dd2\u0da7 ITN \u0d86\u0d9a\u0dad\u0db1\u0dc1\u0dda \u0dc0\u0dca\u200d\u0daf\u0dc1\u0dda\u0dcf \"\u0dc0\u0dca\u200d\u0dca\u0dca\u0dad\u0dca\u0db6\" \u0db1\u0daf\u0dc5\u0dd2 \u0daf\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dd8\u0dad\u0dca\u0dd2\u0dbb \u0db4\u0dc5 \u0d9a\u0dd2\u0dbb\u0dd3\u0dcf \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dd4\u0dc1\u0dc0\u0dca\u200d\u0db1\u0dd4\u0dad\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0d9a\u0dbd\u0dca 2,000\u0d9a\u0dca \u0dc1\u0d9c\u0dc0\u0dca\u200d\u0dca\u0db1 \u0d91 \u0dc1\u0dc0\u0dca\u200d\u0dbd\u0daf \u0dd2\u0dbb\u0dc1\u0db1\u0db1\u0dc0\u0dca\u200d\u0daf.\n\n\u0da0\u0dbb\u0dd2\u0dad \u0dc1\u0dc4\u0dda \u0dad\u0dca \u0dcf\u0dd0\u0dd2\u0dbb\u0dad\u0dd4\u0dcf\u0daf \u0d9a\u0dd2\u0d9a\u0db4\u0dd4 \u0daf \u0dab\u0d9a\u0da7 \u0dcf\u0dcf \u0db8\u0dd3\u0da7 \u0dbd\u0dd2\u0dca \u0db4\u0dad\u0dca\u0dad \u0daf\u0dd4\u0dca\u0db1\u0daf. \u0d85\u0db4\u0dd2 \u0da2\u0db4\u0daf\u0db1\u0d9a\u0dad\u0dca \u0d91\u0d9a\u0dca \u0d91 \u0dad\u0dd4\u0dc1\u0dc0\u0dca\u200d\u0dbd\u0daf \u0dbb\u0dd6\u0db4\u0dc0\u0dca\u200d\u0daf\u0dc4\u0dd2\u0db1\u0dd3"
  },
