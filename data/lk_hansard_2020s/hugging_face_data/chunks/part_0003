    "chunk_text": "\u0d92 \u0dc0\u0dca\u200d\u0daf\u0dc1\u0dda\u0db8 \u0d85\u0db4\u0dd2 \u0dcf\u0daf \u0dd4\u0dbd \u0daf \u0dab\u0daf \u0dc1\u0d9c\u0ddc\u0da9\u0d9a\u0dca \u0dd2\u0dbb\u0dc1\u0db6\u0db1\u0dc0\u0dca\u200d\u0daf1 \u0d85\u0db4\u0dd2 VAT \u0d91\u0dc1\u0d9a\u0dca \u0dd3\u0db8\u0db8\u0daf\u0dc0\u0dca\u200d \u0db8\u0dd2\u0dbd\u0dd2\u0d9a\u0db1 83 \u0db1\u0dca\u0da7 \u0db8\u0dd2\u0dbd\u0dd2\u0d9a\u0db1 63\u0da7 \u0dc1\u0dda\u0db1\u0dc0\u0dca\u200d\u0daf1 \u0d92 \u0d85\u0dcf \u0dcf\u0daf \u0db1 \u0daf \u0dab\u0daf\u0dc0\u0dca\u200d\u0d9a\u0dca \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dca\u200d\u0dba\u0dd21 \u0d92 \u0dad\u0dca \u0d91\u0db1 \u0db1\u0dd2\u0dca\u0daf\u0dba\u0dd2 \u0db8\u0db8 \u0d9a\u0dd2\u0dda\u0dc1\u0dda1 \u0d92 \u0db4\u0dd2\u0db1\u0dca\u0db6\u0db3\u0dc0\u0dca\u200d \u0d85\u0dc1\u0dca\u0db4 \u0dc1\u0d9a\u0ddd\u0da2\u0db1\u0daf\u0dc0\u0dca\u200d\u0dbd \u0dd2\u0dbb\u0dc1\u0db6\u0db1\u0dc0\u0dca\u200d\u0daf1 \u0d85\u0dcf \u0d92 \u0dc1\u0d9a\u0ddd\u0da2\u0db1\u0daf\u0dc0\u0dca\u200d \u0dc1\u0dda\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd01 \u0d92 \u0dc0\u0dca\u200d\u0daf\u0dc1\u0dda\u0db8 \u0db1\u0dca\u0d9a\u0d9a\u0da7 15 \u0da7 \u0dd2\u0dbb\u0db6\u0dd2\u0da0\u0dca\u0da0 VAT \u0d91 \u0db1\u0dca\u0d9a\u0d9a\u0da7 18 \u0d9a\u0dca \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf1 \u0dc1\u0dda \u0daf \u0dab\u0daf 3\u0db8 \u0db6\u0dbd\u0dd4\u0dbd\u0dc0\u0dca\u200d\u0daf\u0db8 \u0dc3\u0dd2\u0dc1 \u0dc1\u0d9a\u0db1\u0dca\u0db8 \u0db8\u0dd2\u0dbd\u0dd2\u0d9a\u0db1 83 \u0dd3\u0db8\u0db8\u0daf\u0dc0\u0dca\u200d \u0db8\u0dd2\u0dbd\u0dd2\u0d9a\u0db1 63 \u0dcf\u0d9a\u0dca\u0dc0\u0dca\u200d\u0daf \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dca\u0dae \u0d9a\u0dd2\u0dd3\u0db8 \u0dad\u0dd4\u0db8\u0dcf\u0dc5 \u0dcf\u0dc5 \u0dc1\u0daf\u0dca\u0dc1\u0dd3\u0d9a \u0db1\u0dd2 \u0dae\u0db4\u0daf\u0daf\u0dd2\u0dad\u0dc1\u0d9a\u0db1\u0dca \u0db1\u0dca\u0d9a\u0d9a\u0da7 \u0dcf \u0db8 \u0d91 \u0dba\u0dd2 \u0db4\u0dc4 \u0d86\u0dcf\u0daf\u0d9a\u0db8 \u0dc0\u0dca\u200d\u0dd0\u0da9\u