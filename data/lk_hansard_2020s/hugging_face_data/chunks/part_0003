9a\u0dca \u0db8\u0daf\u0dca\u0d9a \u0da7 \u0dc0\u0dca\u200d\u0da9\u0daf \u0dd2\u0dbb\u0d9a\u0daf \u0d9c\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd01\n\n\u0d91\u0dad\u0dd0\u0db1\u0dd2\u0db1\u0dca \u0d91\u0dc4\u0daf\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0daf \u0d85\u0db4\u0dd2 \u0dcf\u0dd0\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0d9a\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0d9a\u0db1 11 253\u0d9a\u0dca \u0dbd\u0db6\u0db1 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0dc1\u0daf\u0dca \u0dc1\u0dda \u0dc1\u0dda \u0dca\u0db8\u0dca\u0dae\u0dad \u0dc3\u0dd2\u0db8\u0dc0\u0dba\u0d9c\u0dad \u0dca\u0dcf\u0dc0\u0dca\u200d\u0d9a\u0dc0\u0db1 \u0dc1\u0d9a\u0ddd\u0da2\u0db1\u0daf \u0dca\u0db3\u0dc4\u0daf \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dca \u0dd2\u0dbb\u0dc1\u0db6\u0db1\u0dc0\u0dca\u200d\u0daf1 \u0dc1\u0dda \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dca \u0d9c\u0db1\u0dca\u0db1 \u0d85\u0db4\u0da7 \u0daf\u0da2\u0dba \u0d86\u0dcf\u0daf\u0d9a\u0db8 \u0dc0\u0dca\u200d\u0d9a\u0dc0\u0db1\u0d9a \u0d9c\u0db1\u0dca\u0db1 \u0d85\u0dc0\u0dca\u200d \u0dba\u0dba\u0dd2 \u0d9c\u0dbb\u0dd4 \u0dcf\u0daf\u0db1\u0daf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0db8\u0db1\u0dd21 \u0d85\u0db4\u0dd2 \u0dad\u0dc0\u0dca\u200d\u0db8\u0dad\u0dca \u0dc1\u0dc4\u0ddc\u0d9a\u0db1\u0dca\u0db1 \u0d8b\u0dad\u0dca\u0dca\u0daf\u0dc4 \u0db1\u0dca\u0dc1\u0db1\u0dca \u0db4\u0dd0\u0dbd\u0dd0\u0dca\u0dae\u0dad \u0dc3\u0dd2\u0dca\u0db3\u0dd4\u0dda1 \u0dc1\u0dda \u0dcf\u0daf\u0dda\u0da9 97 \u0d85 \u0dc1\u0d9c\u0db1 \u0d85\u0db4\u0dd2 \u0dcf\u0daf \u0db1\u0dc0\u0dca\u200d\u0daf; \u0dc1\u0dda \u0dcf\u0daf\u0db1\u0dca\u0db1 \u0d91\u0db4\u0daf \u0d85 \u0d85\u0da9\u0dd4 \u0db1\u0dca\u0db1 \u0d85\u0dc1\u0dca\u0db4 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0daf\u0dca \u0d9a\u0da7 \u0db6\u0dbd\u0db4\u0daf\u0db1 \u0d91 \u0d85\u0da9\u0dd4 \u0db1\u0dca\u0db1 \u0d85\u0dc1\u0dca\u0db4 \u0d9a\u0dca\u0dc1 \u0dad\u0dca\u200d\u0dbb\u0d9a\u0da7 \u0db6\u0dbd\u0db4\u0daf\u0db1 \u0d91 \u0d85\u0da9\u0dd4 \u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0d9a\u0dbd\u0daf1 \u0d85\u0db4\u0d