    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dca\u200d\u0dba \u0db7\u0dad\u0db4\u0dad\u0dd2\u0dc3\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dd2, \u0dcf\u0dcf \u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0dad\u0da7 \u0d91\u0d9a\u0dcf \u0d9a\u0dcf\u0dad\u0dbb\u0dab\u0dba \u0d9a\u0dca \u0dd2\u0dbb \u0db1\u0dca\u0dca\u0da7 \u0d95\u0dca\u0dd1. \u0dcf\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4 \u0db7\u0dad\u0dc0\u0da7 \u0dc3\u0daf\u0dd4\u0dbd\u0dca\u0d9a\u0dad, \u0d91\u0d9a\u0dcf \u0d91\u0d9a\u0dcf \u0dc1\u0dd9\u0ddd\u0dba\u0dca\u0dad \u0d9a\u0dcf\u0dbb\u0d9a\u0dad \u0dc1\u0dbd\u0dca\u0d9b\u0dca\u200d\u0dca \u0dd0\u0db1\u0dca \u0dad\u0da9\u0dca\u0d9c\u0dad \u0d9a\u0dcf\u0dbb\u0dca\u0dc0\u0dad \u0dd2\u0dbb \u0dca\u0dc0\u0dad, \u0db7\u0dad\u0d9c\u0dad \u0d9a\u0dcf\u0dbb\u0dca\u0dc0\u0dad \u0dd2\u0dbb \u0dca\u0dc0\u0dad. \u0dd0 \u0dd0\u0dba\u0dd2, \u0d85\u0db4\u0dd2 \u0dd0\u0db1\u0dca \u0dad\u0da9\u0dca \u0dc1\u0dba\u0db4\u0dad\u0dbb\u0dca\u0dad\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc1\u0dc0\u0db1\u0dca \u0dc3\u0dc4\u0dd4\u0dc0\u0dad\u0dcf \u0d91\u0dc1 \u0dcf \u0dc1\u0dcf\u0dad\u0dca\u0dc0 \u0d9a \u0dd0\u0db1\u0dca \u0dad\u0da9\u0dca\u0d9c\u0dad \u0d9a\u0dcf\u0dbb\u0d9a\u0dad \u0d9a \u0dca\u0dd0 \u0dd0, \u0db7\u0dad\u0d9c\u0dad \u0d9a\u0dcf\u0dbb\u0d9a\u0dad \u0d9a \u0dca\u0dd0 \u0dd0. \u0d92\u0dc0\u0dad\u0da7 \u0dcf \u0dc1\u0dbd\u0dca\u0d9a\u0dcf\u0db4\u0dad \u0d9a\u0dcf\u0dad\u0dbb\u0dca \u0dad\u0d9a \u0d9c\u0db1\u0dca\u0dca\u0dad \u0db4\u0dd2 \u0dc0\u0dbb \u0dc1\u0dcf\u0dad\u0dca\u0dc0\u0dad\u0dba? \u0dd0\u0db1\u0dca \u0dad\u0da9\u0dca\u0d9c\u0dad \u0d9a\u0dcf\u0dbb\u0dca\u0dc0\u0dad \u0dd2\u0dbb \u0d9a\u0dad \u0dd2\u0dbb \u0dca\u0dc0\u0dad. \u0dd0 \u0dd0\u0dba\u0dd2, \u0dd0\u0db1\u0dca \u0dad\u0da9\u0dca \u0dc1\u0dba\u0db4\u0dad\u0dbb\u0dca\u0dad\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc1\u0dc0\u0db1\u0dca \u0dc3\u0dc4\u0dd4\u0dc0\u0dad\u0dcf \u0d92 \u0dc1\u0dcf\u0dad\u0dca\u0dc0 \u0d9a \u0dca\u0dd0 \u0dd0.\n\n\u0dc3 \u0d9a\u0dad \u0dc0 \u0dc1 \u0db1\u0dca\u0dcf \u0dcf\u0dcf \u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dc1\u0d9c\u0db1\u0dca \u0d85 \u0db1\u0dca\u0dca \u0d9a\u0dcf\u0dd0\u0dcf\u0dd0\u0dad\u0dd2\u0dc3\u0dba\u0dd2, \u0dc1\u0db4\u0dad\u0da7\u0dd1\u0dd2\u0db1 \u0db4\u0dad \u0d9a\u0dca\u0dc1\u0d9a\u0ddd\u0dbb\u0dba\u0dd2\u0da9\u0dca \u0dd2\u0dbb \u0d9a\u0dad \u0d9a\u0dcf\u0dad \u0db1\u0dd2\u0d9a\u0dcf \u0dc1\u0db4\u0dad\u0dc1 \u0dad\u0dbb\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0dc1 \u0dca\u0dc0\u0dad\u0dba \u0dd2\u0dbb \u0d9a\u0dad. \u0dc1\u0db4\u0dad\u0da7\u0dd1\u0dd2\u0db1 \u0db4\u0dad \u0d9a\u0dca\u0dc1\u0d9a\u0ddd\u0dbb\u0dba\u0dd2\u0da9\u0dca \u0dd2\u0dbb \u0d9a\u0dad \u0d9a\u0dcf\u0dad \u0db1\u0dd2\u0d9a\u0dcf \u0dc1\u0db4\u0dad\u0dc1 \u0dad\u0dbb\u0d9a\u0dca \u0dc1\u0d9c\u0dca\u0dd0\u0dbd\u0dca\u0d9a\u0dad \u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0da2\u0dca\u200d\u0dca\u0dad\u0dad\u0dc0\u0da7 \u0dc1 \u0dbd\u0dd2\u0dc0\u0dad \u0dd2\u0dbb \u0d9a\u0dad \u0d9a\u0dcf\u0dc0\u0dd4\u0dba \u0dbb\u0da7 \u0dc3\u0db1\u0dca\u0dbd\u0dd2\u0dc1\u0dda? \u0dda \u0d9a\u0dad\u0dbb \u0dc1\u0dba\u0db1\u0dca\u0dca. \u0dcf\u0dcf \u0dba\u0db1\u0dca\u0dca\u0dc0\u0dad \u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0dad \u0dc1\u0dca\u0dad\u0dc1\u0dc0\u0dba\u0dd2 \u0dd2\u0dbb \u0d9a\u0dad. \u0d9a\u0dcf\u0dc0\u0dd4\u0dba \u0d92\u0d9a\u0dcf \u0d9a\u0dcf\u0dc1\u0dc5\u0d9a? \u0d92\u0dc0\u0dad\u0da7 \u0dda \u0d9a\u0dad\u0dbb \u0dc1\u0dba\u0db1\u0dca\u0dca.\n\n\u0dcf\u0dc4\u0dd2\u0db1\u0dca\u0dba \u0d85\u0dcf\u0dbb\u0dd3\u0dbb \u0dc3\u0dcf\u0dad\u0dd2\u0dc3\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dd2, \u0dcf\u0dcf \u0dba\u0dd0\u0d9a\u0dca\u0d9a\u0dcf\u0dad \u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0dad \u0db4\u0dc1\u0dd4 \u0db4\u0dad\u0db4 \u0d9a \u0d9a\u0dca\u0dc1\u0dc2\u0d9a\u0dad\u0dca\u200d\u0dbb \u0d9c\u0dd0\u0dca \u0d9a\u0dcf\u0dae\u0dad \u0d9a\u0dcf\u0dbb\u0dca\u0dc0\u0dad. \u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dca\u0d9a\u0dad \u0dc1\u0db4\u0dad \u0dbb\u0dc1\u0da7\u0dca \u0dc0\u0da7\u0dd2\u0dca\u0dad\u0dcf \u0db4\u0dc1\u0dd4 \u0db4\u0dad\u0db4 \u0d9a \u0dc1\u0dda\u0dc1\u0db4\u0dad\u0dc5\u0dc0\u0d9a\u0da7 \u0dc1\u0dcf\u0dad\u0d9a\u0dcf\u0d9a\u0dca\u0dba \u0d9a\u0dcf\u0dbb \u0dad\u0dd2\u0dc3\u0dc1 \u0db1\u0dca\u0dc1\u0db1\u0dca? \u0dc1\u0d9c\u0dad\u0daf\u0dd4\u0dc1\u0db4\u0dad\u0dc5 31\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0dc1 \u0dca\u0dc0\u0dad, \u0dc1\u0db4\u0dad \u0dbb\u0dc1\u0da7\u0dca. \u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dca\u0d9a\u0dad \u0d92 \u0dc1\u0d9c\u0dad\u0daf\u0dd4\u0dc1\u0db4\u0dad\u0dc5 31\u0dcf \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0dda\u0dd2\u0db1 \u0da7 \u0dba\u0dad\u0d9a\u0dad \u0dad\u0dd2\u0dc3\u0dc1 \u0db1\u0dca\u0dc1\u0db1\u0dca. \u0db8\u0dd2\u0dbd\u0dca\u0dc1\u0d9a\u0dcf\u0ddd \u0d91\u0d9a\u0dcf \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0dda\u0dd2\u0db1 \u0da7\n\n3301 3302\n\n[\u0d9c\u0dbb\u0dd4 \u0da2\u0dd2 \u0d9a \u0dc1\u0dda\u0dcf\u0dba\u0dad \u0dcf \u0dad\u0dad]\n\n2023 \u0dc1\u0dba \u0dd0\u0db4\u0dad \u0dbb\u0dca 09\n\n\u0dba\u0dad\u0d9a\u0dad \u0dad\u0dd2\u0dc3\u0dc1 \u0db1\u0dca\u0dc1\u0db1\u0dca. \u0db8\u0dd2\u0dbd\u0dca\u0dc1\u0d9a\u0dcf\u0ddd \u0d91\u0d9a\u0dcf\u0da7 \u0dba\u0dd0\u0db1\u0dca \u0dd2\u0dbb \u0dca\u0dc0\u0dad, \u0db8\u0dd2\u0dbd\u0dca\u0dc1\u0d9a\u0dcf\u0ddd \u0d91\u0dc1\u0d9a\u0dca \u0dd6\u0db8\u0db8\u0dd2 \u0d94 \u0da7 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc3 \u0dca\u0dd0 \u0dd0. \u0d92\u0d9a\u0dcf UDA \u0d91\u0d9a\u0dcf\u0da7 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc3\u0dba\u0dd2 \u0dd2\u0dbb \u0d9a\u0dad. \u0d92\u0d9a\u0dcf \u0dd2\u0db4\u0dba? \u0d9c\u0dbb\u0dd4 \u0dc3\u0dcf\u0dad\u0dd2\u0dc3\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dd2, \u0d92 \u0dc1\u0d9c\u0dad\u0daf\u0dd4\u0dc1\u0db4\u0dad\u0dc5 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0dda\u0dd2\u0db1 \u0d9a\u0dcf\u0dbb\u0d9a\u0dad \u0dc1\u0db4\u0dad \u0dbb\u0dc1\u0da7\u0dca \u0dd2\u0dbb\u0dd2\u0db4 \u0db1\u0dd2\u0dc2\u0d9a\u0db4\u0dad\u0dba\u0dca \u0d89 \u0dc5 \u0dca\u0dcf\u0dc0\u0db1\u0dca\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dba? \u0dba\u0dd0\u0db1\u0dca \u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0dad \u0d9a\u0dcf\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dbd\u0dca\u0d86\u0dc1\u0dbb\u0dca \u0d9a\u0dcf\u0dbb\u0dca \u0dc0\u0dba\u0dad\u0db4\u0dd8\u0dad\u0dd2\u0dc3 \u0d9a\u0dca \u0d9c\u0dd0\u0dca \u0dd2\u0dbb\u0dda\u0dc0\u0dad. \u0d92\u0d9a\u0dcf \u0dc1 \u0dad\u0db3\u0dba\u0dd2. \u0dd0 \u0dd0\u0dba\u0dd2, \u0dd2\u0db4\u0dd2\u0db1 \u0d9c\u0dcf farm \u0d91\u0d9a\u0dcf \u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0dad \u0daf\u0dd4\u0d9a\u0dd4\u0dab\u0dba\u0db1\u0dca\u0dca \u0dca\u0dc0\u0dad, \u0dd3\u0dbb\u0daf\u0dd4\u0d9a farm \u0d91\u0d9a\u0dcf \u0daf\u0dd4\u0d9a\u0dd4\u0dab\u0dba\u0db1\u0dca\u0dca \u0dca\u0dc0\u0dad. \u0dad\u0dc0 \u0d9a \u0db4\u0dc1\u0dd4 \u0db4\u0dad\u0db4 \u0d9a \u0dc1\u0d9c\u0dad\u0daf\u0dd4\u0dc1\u0db4\u0dad\u0dc5 31\u0d9a\u0dca \u0daf\u0dd4\u0d9a\u0dd4\u0dab\u0dba\u0db1\u0dca\u0dca \u0dca\u0dc0\u0dad. \u0d89\u0dad\u0dd2\u0dc3\u0db1\u0dca \u0dc1\u0d9a\u0dcf\u0dad\u0dc1 \u0dad\u0dcf\u0dba \u0dbb\u0da7 \u0dc1\u0d9c\u0dad\u0da9 \u0dca\u0d9f\u0db1\u0dca\u0dc1\u0db1\u0dca?"
  },
