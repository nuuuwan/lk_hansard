a \u0d85\u0db1\u0dd4\u0dd9 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8 \u0daf\u0dd9\u0db8\u0dd2\u0db1\u0dca \u0daf\u0dd2\u0dc3\u0dae\u0dca\u200d\u0dbb\u0dd2\u0dca \u0db8\u0da7\u0dca\u0da7\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dbb\u0dd3\u0dca \u0dc2\u0dab \u0db8\u0da9\u0dd4\u0da9\u0dbd \u0db4\u0dad\u0dca \u0dd2 \u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dd9\u0dc1\u0dba \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc3 \u0dc3\u0db1 \u0dbd \u0da2.\n\n(\u0dca \u0d85\u0dc3\u0dcf\u0dc5 \u0daf\u0db1\u0ddc\u0daf .\n\n\u0db8\u0db8 \u0da7\u0dbb\u0dca \u0dbb\u0dae \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0db8\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0: \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4\n\n\u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0baa\u0bae\u0bbe\u0b9f\u0bcd\u0b9f\u0bbe\u0bb0\u0bcd \u0baa\u0baa\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bae\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd:\n\n\u0bb5\u0bbf\u0baa\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bb3\u0bcd \u0b9a\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0ba9 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0bae\u0b95\u0b95\u0bb3\u0bcd DEPARTMENT OF MOTOR TRAFFIC : REPORTS ON\n\nACCIDENTS\n\n1645/2023 6. \u0d9c\u0dbb\u0dd4 \u0db8\u0dd2\u0dbd\u0dcf\u0db1\u0dca \u0da2\u0dba\u0dad\u0dd2\u0dbd\u0d9a \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bae\u0bbf\u0bc8\u0bbe\u0ba9\u0bcd \u0bc7\u0baf\u0ba4\u0bbf\u0bc8\u0b95\u0bcd\u0b95) (The Hon. Milan Jayathilake)\n\n\u200d\u0dbb\u0dd9\u0dcf\u0dc4\u0db1 \u0dc4\u0dcf \u0db8\u0dc4\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dad\u0dd4\u0db8\u0dcf\u0daf\u0d9c\u0db1\u0dca \u0d87\u0dc3\u0dd6 \u200d\u0dbb\u0dc1\u0dae\u0db1\u0dba - (1 :\n\n(\u0d85 (i) \u0daf\u0db8\u0ddd\u0da7\u0dbb\u0dca \u0dba\u0dcf \u200d\u0dbb\u0dd9\u0dcf\u0dc4\u0db1 \u0daf\u0dc3\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0daf \u0daf\u0dc3\u0dba\u0dd9\u0dba\n\n\u0dba\u0db1\u0dd4 \u0dbd\u0dd9\u0db1 \u0daf\u0db8\u0ddd\u0da7\u0dbb\u0dca \u0dba\u0dcf \u0db4\u0dbb\u0dd3\u0dca \u0dc2 \u0dd9\u0dbb\u0dd4\u0db1\u0dca \u0dc3\u0dcf\u0d9b\u0dba\u0dcf\u0dd9 \u0daf \u0ddc\u0db4\u0db8\u0dab\u0dc3\n\n(ii) \u0dd9\u0dbb\u0dca\u0dc2 0215 \u0dd2\u0db1\u0da7 \u0daf\u0dda \u0dc3\u0dca \u0dd9\u0dcf \u0d94\u0dd4\u0db1\u0db1\u0dca \u0dd2\u0dc3\u0dd2\u0db1\u0db1\u0dca\n\n\u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0dd9\u0dbd\u0da7 \u0dbd\u0dca \u0dd6 \u0dd9\u0dcf\u0dc4\u0db1 \u0db4\u0dbb\u0dd3\u0dca \u0dc2\u0dcf \u0dba \u0dbd\u0dd9\u0dcf \u0da2 \u0d87\u0dad\u0dd2 \u0dd9\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0dc3\u0dcf\u0d9b\u0dba\u0dcf\u0dd9 \u0daf \u0ddc\u0db4\u0db8\u0dab\u0dc3\n\n(iii) \u0dd9\u0dc4\u0dd4\u0dbd \u0dd9\u0dc1\u0daf\u0dba\u0db1\u0dca \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0dd2\u0db1\u0daf\u0dd4 \u0dc0\u0dd3\u0db8\u0da7 \u0db8\u0dd6\u0dbd\u0dd2 \u0daf\u0dc4\u0dba\u0dad\u0dd6\u0db1\u0dca \u0dc4 \u0db1\u0dcf\u0daf\u0d9c\u0db1 \u0d92 \u0dc3\u0dda\u0dd9\u0db1\u0dca\u0db0\u0daf\u0dba\u0db1\u0dca \u0dd9\u0db1 \u0dd2\u0d9a\u0dbb\u0dca\u0daf\u0dda\u0dc1 \u0d91\u0db8 \u0db4\u0dbb\u0dd3\u0dca \u0dc2\u0dab \u0dd9\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dd9\u0dbd \u0d89\u0daf\u0dd2\u0dd2\u0db8\u0db4\u0dad\u0dca \u0dba \u0dad\u0dd2\u0daf\u0db6\u0dca\u0dc3\n\n(iv) \u0d91\u0daf\u0dc3\u0dba \u0db1\u0dda \u0d91\u0db8 \u0dd2\u0d9a\u0dbb\u0dca\u0daf\u0dda\u0dc1 \u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2\u0dba\u0dca \u0daf\u0dbd\u0dc3 \u0dc3\u0dda\u0db4\u0dcf\u0dc3\u0db1\u0dba \u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8 \u0dd2 \u0dbb\u0dd3\u0db8\u0da7 \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dba\u0db1\u0dca\u0daf\u0db1\u0dca\u0dc3\n\n\u0dba\u0db1\u0dca\u0db1 \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0daf\u0db8\u0db8 \u0dc3\u0dcf\u0dcf\u0dd9\u0da7 \u0dc3\u0db1\u0dca\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca\u0dc3?\n\n(\u0dca \u0daf\u0db1\u0ddc\u0d91\u0daf\u0dc3\u0dba \u0db1\u0dda \u0d92 \u0db8\u0db1\u0dca\u0dc3?\n\n\u0baa\u0baa\u0bbe\u0b95\u