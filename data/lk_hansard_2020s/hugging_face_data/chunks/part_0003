    "chunk_text": "\u0d92 \u0dc1\u0dc0\u0dca\u200d\u0daf\u0dca\u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0dc3\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0d9a \u0db1\u0dd2 \u0dae\u0db4\u0daf\u0dcf\u0db1\u0d9a \u0db8\u0dd2\u0db1\u0dca \u0dc4\u0dd2\u0da7\u0dd2\u0dc1\u0dda \u0dc1\u0db1\u0ddc\u0dc1 \u0ddc\u0da0\u0dca\u0dc1\u0da0\u0ddd\u0dc1\u0dbd\u0dca \u0d9c\u0dbd\u0dca \u0d85\u0d9f\u0dd4\u0dbb\u0dd4 \u0db6\u0dbd\u0daf\u0d9c\u0daf \u0dc1\u0d9a\u0db1\u0dca \u0dc1\u0db8\u0d9c\u0daf \u0dc1\u0dc0\u0dca\u200d\u0ddc\u0dda 333\u0d9a\u0dca \u0db4\u0db8\u0dab\u0dba\u0dd2 \u0d9c\u0dbb\u0dd4 \u0dcf\u0daf\u0db1\u0daf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0db8\u0db1\u0dd21 \u0d89\u0dad\u0dd4\u0db8\u0dcf\u0dbb\u0dd4 \u0db1\u0dca\u0d9a\u0dbd\u0dd4 \u0dc3\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0d9a \u0d85\u0db4\u0dd2 \u0dbd\u0db6\u0daf \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dca \u0da2\u0dbd \u0dc3\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0dc1\u0d9a\u0db1\u0dca1 \u0da2\u0dbd \u0dc3\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0d9a \u0dbb\u0dd0\u0dc1\u0d9c\u0db1 \u0d91\u0db1 \u0db8\u0daf\u0d9a\u0d9c\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0daf\u0dbd\u0dd4 \u0dab\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dca\u200d\u0d9a \u0d8b\u0da9 \u0d92 \u0dc3\u0dd2\u0db0\u0dd2\u0d9a\u0da7 \u0dc3\u0dd2\u0dca\u0db1\u0dca\u0db0\u0dd2 \u0dc0\u0dd4\u0dc1\u0dda1 \u0d92 \u0db1\u0dd0\u0dc0\u0dca\u200d\u0dad \u0dca\u0dae\u0dc0\u0dca\u200d\u0d9a\u0dcf\u0d9a\u0dca\u200d\u0dbb\u0dd3\u0d9a\u0dc0\u0dca\u200d \u0d9a\u0dcf\u0daf \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dca\u200d\u0d9a\u0da7 \u0db4\u0dad\u0dca \u0d9c\u0db1\u0dca\u0db1 \u0dc4\u0dd0\u0d9a\u0dd2\u0d9a\u0daf\u0dc0\u0dca\u200d\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd01 \u0dc1\u0db8\u0ddc \u0dcf \u0d92 \u0dc1\u0dc0\u0dca\u200d\u0daf\u0dca\u0daf\u0dd3 \u0dc1\u0db8\u0d9c\u0daf \u0dc1\u0dc0\u0dca\u200d\u0ddc\u0dda 1 533 \u0da7 \u0d86\u0dca\u0db1\u0dca\u0db1 demand \u0d91 \u0d9a\u0dca \u0dd2\u0dbb\u0db6\u0dd4\u0dab\u0daf1 \u0d92 \u0d89\u0dbd\u0dca\u0dbd\u0dd4\u0db8 \u0dc1\u0db8\u0d9c\u0daf \u0dc1\u0dc0\u0dca\u200d\u0ddc\u0dda 333\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0db8\u0dc4\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0db1\u0dd2\u0dca\u0daf \u0d85\u0dc1\u0dca\u0db4 \u0dc1\u0db1\u0ddc\u0dc1 \u0ddc\u0da0\u0dca\u0dc1\u0da0\u0ddd\u0dc1\u0dbd\u0dca \u0db6\u0dbd\u0daf\u0d9c\u0daf \u0d9a\u0dad\u0dca \u0d85\u0d9a\u0dca\u200d\u0dbb\u0dd3\u0d9a \u0dc0\u0dd4\u0dab\u0daf1 \u0d92 \u0dc0\u0dca\u200d\u0db1\u0dc1 \u0ddc\u0da7 \u0db1\u0dca\u0d9a\u0dbd\u0dd4 \u0dca\u0dd0\u0db4\u0dba\u0dd4\u0dda \u0db8\u0daf\u0d9a\u0d9c \u0db1\u0dd0\u0dc0\u0dca\u200d\u0dad\u0dd4\u0db8\u0dcf\u0dab\u0daf1 \u0d92 \u0d9a\u0dcf\u0daf \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dca\u200d\u0d9a\u0da7 \u0db4\u0dad\u0dca \u0db1\u0dca\u0db1 \u0d92 \u0dc1\u0dc0\u0dca\u200d\u0dbd\u0daf\u0dc1\u0dda \u0dc4\u0dd0\u0da7\u0dd2\u0d9a\u0da7 \u0dca\u0daf\u0db8\u0daf\u0db1\u0dba\u0dc1\u0d9a\u0db1\u0dca \u0db4\u0dd0\u0d9a \u0dc4\u0dad \u0dc1\u0dc4\u0ddd \u0db4\u0dc4 \u0db4\u0db8\u0dab \u0daf\u0dbd\u0d9a\u0d9a\u0dca \u0d9c\u0dad \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf1 \u0dc1\u0db8\u0ddc \u0dcf \u0d9a\u0dd4\u0da9\u0daf \u0db6\u0dbd\u0daf\u0d9c\u0daf \u0db4\u0dab \u0d9c\u0db1\u0dca\u0dc0\u0dca\u200d\u0db8\u0dd2\u0db1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0db1\u0dd0\u0dc0\u0dca\u200d\u0dad \u0d9a\u0dcf\u0daf \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dca\u200d\u0d9a\u0da7 \u0dc1\u0d9c\u0dc1\u0db1\u0db1\u0dca\u0db1 \u0dd4\u0dbd\u0dc5\u0dd4\u0dc0\u0dca\u200d\u0db1\u0dca \u0db8\u0d9a\u0dca \u0dd2\u0dbb\u0db6\u0dd4\u0dc1\u0dda1\n\n\u0dc3\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0d9a \u0da2\u0db1\u0db1\u0d9a \u0dbd\u0daf \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dd2 \u0da2\u0db1\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0daf\u0dab\u0d9a\u0d9a\u0dca \u0da2\u0dbd \u0dc3\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0dc1\u0d9a\u0db1\u0dca \u0dbd\u0db6\u0daf \u0daf\u0dd4\u0db1\u0dca\u0dc1\u0db1\u0dca unit cost \u0d91 \u0d85\u0da9\u0dd4 \u0db1\u0dd2\u0dca\u0daf \u0db6\u0dc0\u0dca\u200d1 \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0dc3\u0dd6\u0dad\u0dca\u200d\u0dbb\u0d9a \u0d92 \u0dc1\u0db1\u0dca1 \u0d87\u0dad\u0dca\u0dad \u0dc0\u0dca\u200d \u0dc1\u0d9a\u0db1\u0dca\u0db8 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0daf\u0dc1\u0d9c\u0db1\u0dca \u0dcf\u0dd0\u0db1\u0dca \u0db8\u0db8 \u0d8b\u0dad\u0dca\u0dad \u0d9a\u0d9a\u0dca \u0db6\u0dbd\u0daf\u0dc1\u0db4\u0ddc\u0dc1 \u0ddc\u0dad\u0dca\u0dad\u0dd4\u0db8\u0dcf \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd01 \u0d9c\u0dbb\u0dd4 \u0daf\u0da2\u0dba \u0d87\u0db8\u0dd2\u0dbb\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0db1\u0dd2 \u0dc3\u0dd2\u0dc1 \u0da5\u0dba\u0dd2\u0db1\u0dca \u0d89\u0dcf\u0da2\u0dd2\u0dc1\u0db1\u0dca\u0dbb\u0dd4\u0dc0\u0dca\u200d\u0db1\u0dca \u0d87\u0dad\u0dd4\u0db8\u0dcf\u0dc5\u0dd4\u0dc0\u0dca\u200d \u0dbd\u0dcf \u0daf \u0dc3\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0db8\u0dda\u0da9\u0dbd\u0dc1\u0dda \u0dca\u0dc4 \u0dbd\u0dcf \u0daf \u0dc3\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0db8\u0dda\u0da9\u0dbd\u0d9a\u0da7 \u0dca\u0dda\u0db6\u0db1\u0dca\u0dc0 \u0db1\u0dd0\u0dd2\u0dbb \u0db1\u0dca\u0d9a\u0dbd\u0dd4 \u0db4\u0daf\u0d9a \u0dae\u0dc0\u0dca\u200d \u0dbb\u0dd4\u0dc0\u0dca\u200d\u0db1\u0dca \u0d91\u0d9a\u0dca \u0dc4\u0dd4 \u0dc1\u0d9c\u0db1 \u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb \u0dae\u0db1\u0d9a \u0db4\u0dd2\u0db1\u0dca\u0db6\u0db3\u0dc0\u0dca\u200d \u0d85\u0db4\u0d9a\u0dca \u0db4\u0daf\u0dd2\u0dbb \u0dca\u0dc4 \u0dc3\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0db4\u0dd3\u0d9a\u0dca \u0dab\u0d9a\u0d9a\u0dca \u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0d9a\u0dbd\u0daf \u0db8\u0db8 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0daf\u0da7 \u0dc1\u0d9a\u0ddd\u0da2\u0db1\u0daf \u0db1\u0dc0\u0dca\u200d\u0daf1\n\n\u0dc1\u0db8\u0ddc \u0dcf \u0dc1\u0dda \u0d8d\u0da2\u0dd4\u0dc0\u0dca\u200d\u0db8 \u0da2\u0daf\u0dd2\u0dbb \u0d86 \u0d9a\u0dca \u0daf\u0dc0\u0dca\u200d\u0da7 \u0db6\u0dbd\u0db4\u0daf\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dae\u0db1\u0d9a\u0d9a\u0dca1 \u0dc1\u0dda \u0da2\u0daf\u0dd2\u0dbb \u0d86 \u0d9a\u0dca \u0daf\u0dc0\u0dca\u200d \u0db4\u0dd2\u0db1\u0dca\u0db6\u0db3 \u0db4\u0dca\u200d\u0dbb \u0dae\u0db1\u0d9a \u0db8\u0db8 \u0d8a\u0dc1\u0d9a\u0dad\u0dca \u0db8\u0dad\u0dd4\u0db8\u0dcf \u0dc5\u0daf1 \u0d91\u0dc1\u0dc4\u0db8 \u0db4\u0dd3\u0d9a\u0dca \u0dab\u0d9a\u0d9a\u0dca \u0dbd\u0daf \u0dc1\u0dda \u0dca\u0dcf\u0daf\u0dc0\u0dca\u200d\u0da7 \u0d8b\u0dad\u0dca\u0dad \u0d9a\u0d9a\u0dca \u0dbd\u0db6\u0daf \u0dc1\u0dcf\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0d9a\u0daf \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0d9a\u0dca \u0db1\u0dc0\u0dca\u200d\u0daf1\n\n\u0d9c\u0dd4\u0dab \u0d89\u0db1\u0dca\u0daf\u0dd2\u0d9a \u0d85\u0db1\u0dd4\u0dd4\u0dab\u0db0 \u0db0\u0dcf \u0daf\u0dc4\u0dda\u0dbb\u0dad\u0dca \u0db8\u0dc4\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0b95 \u0b85\u0ba8\u0bc1\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4 \u0bae\u0bb9\u0bb0\u0ba4\u0bcd) (The Hon. Indika Anuruddha Herath) \u0d9c\u0dbb\u0dd4 \u0dcf\u0daf\u0db1\u0daf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0db8\u0db1\u0dd2 \u0db1\u0dd0\u0dc0\u0dca\u200d\u0dad \u0db1\u0dd0\u0dc0\u0dca\u200d\u0dad \u0d9a\u0dd2\u0d9a\u0db1\u0dca\u0db1 \u0d85\u0dc0\u0dca\u200d \u0dba \u0db1\u0dd0\u0dc4\u0dd01 \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0daf\u0dc1\u0dda \u0db4\u0dd3\u0d9a\u0dca \u0dab\u0d9a \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dca\u200d\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0db1\u0dca\u0dc1\u0db1\u0dca1 \u0dbd\u0dcf \u0daf \u0dc3\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0db8\u0dda\u0da9\u0dbd\u0d9a \u0dca\u0dc4 \u0dc3\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0dc4\u0daf \u0db6\u0dbd \u0d9a\u0dca\u0dd2\u0dbb \u0d85\u0db8\u0daf\u0dad\u0dba\u0daf\u0dcf \u0d9a \u0dc1\u0dda \u0dc1\u0dc0\u0dca\u200d\u0daf\u0dca\u0daf\u0dd3 \u0db4\u0dd3\u0d9a\u0dca \u0dab \u0d86 \u0dda\u0dcf \u0dbd\u0daf \u0dd2\u0dbb\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca1 \u0d92 \u0dcf\u0dad\u0dca\u0dad \u0dca\u0da7\u0dc4\u0db1\u0dca \u0d92 \u0d86 \u0daf \u0dc1\u0d9a\u0db1\u0dca \u0d92 \u0da2\u0db1\u0db1 \u0d9a\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dbd\u0dd2\u0db1\u0dca \u0dbd\u0db6\u0daf \u0d9c\u0dd0\u0dd3\u0db8\u0db8\u0da7 \u0dc1\u0dc4 \u0dad\u0dd4\u0db8\u0dcf \u0dc0\u0dd4\u0dab\u0dd4 \u0daf \u0dab\u0daf \u0d92 \u0dc0\u0dca\u200d\u0daf\u0dc1\u0dda\u0db8 \u0dc1\u0dda \u0db4\u0daf\u0dca\u0dc0\u0dd2\u0dbb\u0d9a \u0db6\u0dd2\u0db3 \u0dc0\u0dca\u200d\u0dd0\u0da7\u0dd4\u0dc1\u0dab\u0ddc\u0dad\u0dca - \u0dc1\u0dda \u0dc1\u0dc0\u0dca\u200d\u0daf\u0dca\u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0d85\u0db1\u0daf\u0dc0\u0dca\u200d \u0dab\u0d9a \u0dc1\u0d9c\u0db1 \u0dd2\u0dbb\u0dc1\u0db6\u0db1\u0dc0\u0dca\u200d\u0daf 2315 \u0d89\u0daf\u0dd2 \u0db1\u0dca\u0db1 \u0dd2\u0dbb\u0db6\u0dd4\u0dab\u0dd4 \u0dc1\u0db4\u0ddc\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0d9a-\u0dc1 \u0ddc\u0dad\u0dca\u0db8\u0dc1\u0dbd\u0dca \u0dbb\u0dd0\u0dc4\u0dd0\u0db1\u0dca \u0db8\u0daf\u0d9a\u0d9c\u0d9a \u0dc0\u0dca\u200d\u0dca \u0d9c\u0dab\u0db1\u0daf\u0dc0\u0dca\u200d\u0d9a\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0daf\u0dcf \u0dc1\u0dc0\u0dca\u200d\u0dbd\u0daf \u0dd2\u0dbb\u0dc1\u0db6\u0db1 \u0db6\u0dc0\u0dca\u200d1 \u0d92 \u0db1\u0dd2\u0dca\u0daf \u0d8a\u0dc1\u0dda \u0dcf\u0dc0\u0dca\u200d\u0dc1\u0dca \u0db8 \u0d87\u0db8\u0dd2\u0dbb\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0daf \u0db4\u0dd3\u0d9a\u0dca \u0dab\u0d9a \u0d86 \u0dda\u0dcf \u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dda\u0dc0\u0dca\u200d\u0daf \u0d87\u0dba\u0dd2 \u0dc1\u0db8\u0da0\u0dca\u0da0 \u0daf\u0dbd\u0d9a\u0d9a\u0dca \u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0db8\u0daf\u0dcf \u0dc0\u0dd4\u0dc1\u0dda \u0d9a\u0dd2\u0d9a\u0dbd\u0daf1"
