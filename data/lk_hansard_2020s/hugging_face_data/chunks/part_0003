    "chunk_text": "\u0dca\u200d\u0dbd\u0dba\u0dda\u0dcf \u0dc0\u0dcf\u0dbb\u0dd6\u0d9a \u0dad\u0dbb\u0dd4 \u0db8\u0da7 \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2, \u0dc3\u0dd3\u0db1\u0dd2 \u0dbb\u0dca\u0db8\u0dcf\u0da7 \u0dad\u0dba \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0dc3\u0da7 \u0dc0 \u0d85\u0db4\u0dd2 \u0dc0\u0dd2 \u0dcf\u0dbd\u0dba\u0dda \u0dc0\u0dd0 \u0dc1 \u0dca\u0da7 \u0dc2\u0dab \u0dc3\u0dbd\u0dba\u0dda\u0dcf \u0d9a\u0dc1\u0db1\u0dc0\u0dc0\u0dcf0 \u0d85\u0daf\u0dca\u200d \u0d85\u0dc1\u0dca \u0dc1 \u0dc0\u0dc0\u0dad\u0dbd\u0dba\u0dda \u0dc3\u0dd3\u0db1\u0dd2 \u0db8\u0dcf\u0dad\u0db8 \u0dc4\u0dc3\u0dc4\u0dcf \u0dc3\u0dd4\u0dba\u0dba\u0da7 100\u0dc2\u0dab\u0db8 \u0db4\u0dd2\u0db1\u0dca\u0db4\u0dc4\u0dd4 \u0dc3\u0db4\u0dd4 \u0d91\u0dad\u0dc1\u0dc0\u0ddd\u0dbd\u0dca \u0db8\u0dcf \u0dba \u0da7 \u0dbd\u0dd3\u0da7\u0dbb\u0dca 120 ,000\u0dc2\u0dab \u0dc0\u0dd2\u0dad\u0dc3 \u0da0\u0dd3\u0dc0\u0dba\u0da7 \u0dba\u0dc0\u0da7 \u0dc0 \u0d85\u0db4\u0dd2 \u0db1\u0dbd\u0dba\u0dda\u0dcf\u0dc1\u0db4\u0dca\u0dc1\u0dc3\u0dca\u0dad\u0dca\u0dc0\u0dad\u0dd4\u0db8 \u0dc1\u0dc0\u0dc0\u0dc0\u0dcf0 \u0dc1) \u0dc3\u0da7\u0da7 \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0\u0dba\u0dc2\u0dab \u0dc1\u0dad\u0dc1\u0dc0\u0da7 \u0dc0 \u0dad\u0db8\u0dba\u0dd2 \u0dc1) \u0dbb\u0dca\u0db8\u0dcf\u0da7 \u0dad\u0dba \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0 \u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0db1\u0dc0 \u0dd2\u0db8 \u0d9a\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dc1 \u0dba\u0da7\u0dad\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0dc3\u0dbd\u0dba\u0dda\u0dcf \u0d9a\u0dc1\u0db1\u0da7 \u0dc1\u0da7 0 \u0d85\u0db4\u0dd2 \u0daf\u0dca\u200d\u0da7 \u0dc0\u0dc0\u0dcf, \u0dc1) \u0dc3\u0dc1 \u0dbd \u0dc3\u0dd3\u0db1\u0dd2 \u0dbb\u0dca\u0db8\u0dcf\u0da7 \u0dad\u0dba \u0daf\u0dd3\u0dbb\u0dca\u0d9d \u0dcf\u0dbd\u0dba\u0dda\u0dba\u0dc2\u0dab \u0dc1\u0dc4\u0dca\u0db3\u0da7 \u0d9a\u0db6\u0dd2\u0dbd\u0dba\u0dda\u0dcf \u0d86\u0db4\u0db1\u0dca \u0db4\u0dc4\u0db8\u0da7 \u0db1\u0dd0 \u0d9a\u0db6\u0dd4\u0db4 \u0db1\u0dc00 \u0d92 \u0dbb\u0dca\u0db8\u0dcf\u0da7 \u0dad\u0dba \u0dc0\u0dd0\u0dc0\u0dad \u0db3 \u0da7 \u0dc1\u0dad\u0dc1\u0dc0\u0da7 \u0dc0 \u0db4\u0db1\u0dca\u0d9c\u0dd2\u0dba \u0dcf\u0dbd\u0dba\u0dda\u0dc1\u0dad \u0d85\u0db4\u0da7\n\n\u0dca\u200d\u0dbd\u0dba\u0dda\u0dcf \u0dc0\u0dcf\u0dbb\u0dd6\u0d9a \u0dad\u0dbb\u0dd4 \u0db8\u0da7 \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2, \u0db8\u0dc1 \u0db0\u0dd4\u0dc3 \u0dcf\u0dbd\u0dba\u0dda\u0dc1\u0dad \u0db8\u0db8 \u0dc1) factories \u0dc1\u0daf\u0dca\u200d\u0dc1\u0dc2\u0dab\u0db8 \u0dc1\u0db4\u0dca\u0dc1\u0dc4\u0dca\u0dc3 \u0dc1\u0db8\u0da7\u0dca\u200d\u0dbb\u0dd2\u0dc2\u0dab\u0dc1\u0da7\u0dca\u0da7 \u0dbd\u0dba\u0dda\u0dc2\u0dab \u0dba\u0dc2\u0dab \u0db1\u0dd2 \u0dca\u0db4\u0dcf\u0daf\u0dca\u200d\u0dc0\u0dba \u0dc3\u0da7 \u0dc0 \u0dc1\u0dc0\u0dc0\u0db8 factories \u0dc1\u0daf\u0dca\u200d \u0dc2\u0dab \u0d86\u0dc3)\u0dcf \u0dc3\u0dbd\u0dba\u0dda\u0dcf \u0d9a\u0dc1\u0db1\u0dc0\u0dc0\u0dcf0 \u0daf\u0dca\u200d\u0dd0\u0da7 \u0d92 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d85\u0dc0 \u0da7 \u0d85\u0daf\u0dd2\u0dba\u0dc1\u0dbb\u0dca \u0d9a\u0dc1\u0db1\u0da7 \u0dc1\u0da7 0 \u0dc3\u0dcf\u0da2\u0dba \u0dd2\u0db8 \u0d9a\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0dc0\u0dd2\u0dc3\u0dd4\u0da7 \u0d85\u0dc1\u0dca\u200d\u0dbb \u0dbd\u0dca \u0db8\u0dcf \u0dba \u0dc1\u0dc0\u0dc0\u0dc1 \u0dca\u0da7 \u0d91\u0dc4\u0dd2 \u0dc0\u0dd0 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d85\u0dc0 \u0da7 \u0db8\u0dcf\u0da7 \u0db4 \u0dca\u0dc1 \u0d92 \u0dc4\u0daf\u0dca\u200d\u0dc0 \u0dc1\u0db4\u0dca\u0dc1\u0dc4\u0dca\u0dc3 \u0dcf\u0dcf\u0dc0\u0dd2\u0dad \u0dc3\u0dbd\u0dba\u0dda\u0dcf \u0d85\u0db4\u0da7 \u0dc1) \u0dc3\u0dc1 \u0dbd organic sugar \u0db1\u0dd2 \u0dca\u0db4\u0dcf\u0daf\u0dca\u200d\u0dc0\u0dba \u0dc3\u0da7 \u0dc0 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0da7 0 \u0d89\u0daf\u0dd2\u0db1\u0dca \u0dcf\u0dbd\u0dba\u0dda\u0dc1\u0dad\u0daf\u0dd3 -\u0d85\u0dc1\u0dca\u200d\u0dbb \u0dbd\u0dca \u0db8\u0dcf \u0dc1\u0dba\u0da7 \u0db4\u0db1\u0dca- \u0d92 \u0dc1\u0db4\u0dca\u0dc1\u0dc4\u0dca\u0dc3 \u0db1\u0dd2 \u0dca\u0db4\u0dcf\u0daf\u0dca\u200d\u0dc0\u0dba \u0db8\u0dcf\u0db8 organic sugar\u0dc0\u0dbd\u0dd2\u0da7 \u0dc1) \u0dc3\u0dc1 \u0dbd \u0dc3\u0dd3\u0db1\u0dd2 \u0dbb\u0dca\u0db8\u0dcf\u0da7 \u0dad\u0dc1\u0dad \u0dc0\u0dc0 \u0db4\u0dd2)\u0db8\u0dc2\u0dab \u0db4\u0db1\u0dd2\u0da7 \u0dc0 \u0d85\u0db4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0da7 \u0db8\u0dc2\u0dab \u0dbd\u0dba\u0dda\u0dd0\u0dc1\u0db1\u0dc0\u0dc0\u0dcf0 \u0d85\u0db4\u0dd2 \u0dba) \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0\u0dba\u0dc2\u0dab \u0dc3\u0dbd\u0dba\u0dda\u0dcf \u0d9a\u0dc1\u0db1\u0dc0\u0dc0\u0dcf0 \u0d92 \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0\u0dc1\u0dba\u0da7 \u0dca\u200d\u0dbb \u0d9a\u0dbd\u0dbd\u0dba\u0dda\u0dba\u0dc2\u0dab \u0dbd\u0dba\u0dda\u0dd0\u0db6\u0dd3 \u0d9a\u0dc1\u0db1\u0dc0\u0dc0\u0dcf0 \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0 \u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0db1\u0dc0 \u0dc3\u0dcf\u0da2\u0dba \u0dd2\u0db8 \u0d9a\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0da7 \u0dc1) \u0d86\u0dba\u0dad\u0dc0\u0dba \u0dbd\u0dba\u0dda\u0dd0\u0db6\u0dd4\u0dab\u0dd4 \u0dc1\u0db8\u0dca\u0dc1\u0dc4\u0dca\u0dc1\u0dad\u0dca\u0dc0 \u0d89\u0db3\u0dbd\u0dba\u0dda\u0dcf \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0dc1\u0dbd\u0dba\u0dda\u0dca\u0d9a\u0dd4 \u0dc0\u0dd4\u0dc0\u0db8\u0dc0\u0dcf\u0dc0\u0d9a\u0dd2\u0da7 \u0dc1) \u0dc3\u0da7\u0da7 \u0d86\u0dc1\u0dba\u0ddd\u0da2 \u0dba\u0da7 \u0dc1\u0dad\u0dc1\u0dc0\u0da7 \u0dc0, \u0d92 \u0dc0\u0dcf\u0dc1 \u0db8 \u0d94\u0dc0\u0dd4\u0da7 \u0da7 \u0db4\u0dc4\u0db1\u0dca ) \u0db4\u0dba\u0da7 \u0dc0 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dc3\u0dbd\u0dba\u0dda\u0dcf \u0d9a\u0dc1\u0db1\u0dc0\u0dc0\u0dcf0\n\n\u0dc1\u0dc0\u0dbd\u0dd4) \u0d9a\u0dd4\u0dbd\u0dd4\u0dc0 \u0dad\u0dad\u0dca\u0dc0\u0dc1\u0dad\u0dca\u0dad\u0dca\u0dc0, \u0d92 \u0db1\u0dca\u0dd4 \u0d85\u0dbd\u0dd2\u0dc1\u0dba\u0dc2\u0dab \u0d9a\u0dd2\u0dba\u0dcf \u0d92 \u0dcf\u0dbd\u0dba\u0dda\u0dc1\u0dad \u0d9a\u0dd2\u0dda\u0dc0\u0dcf0 \u0d85\u0daf\u0dca\u200d \u0d91\u0dba \u0dbd\u0dba\u0dda\u0dcf\u0dcf \u0dbd\u0dba\u0dda\u0db1\u0dc0 \u0d86\u0dba\u0dad\u0dc0\u0dba\u0dc2\u0dab \u0db1\u0dc0\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0dc3\u0dbd\u0dba\u0dda\u0dcf \u0d9a\u0dc1\u0db1\u0dc0\u0dc0\u0dcf0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0dc0 \u0d91\u0dc2\u0dab\u0daf\u0dca\u200d\u0dc4 \u0dca \u0dad\u0db4\u0dc0\u0dc2\u0dab \u0dbd\u0dba\u0dda\u0dcf\u0dcf \u0dbd\u0dba\u0dda\u0db1\u0dc0\u0dc1 \u0dca\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0dc0 600\u0dba\u0dd2 \u0d91\u0dba\u0da7 \u0dc0\u0dd0\u0dba \u0dc3\u0dbd\u0dba\u0dda\u0dcf \u0d9a\u0dc1\u0db1\u0da7 \u0dc1\u0da7 0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0dc0 400 \u0da7 \u0dc0 \u0dcf \u0dbd\u0dba\u0dda\u0dcf\u0dcf\u0dba\u0dc2\u0dab \u0db3\u0db4\u0dba\u0dcf \u0d9a\u0dc1\u0db1\u0dc0\u0dc0\u0dcf0 \u0daf\u0dca\u200d\u0dd0\u0da7 \u0d92 \u0db1\u0dca\u0dd4 \u0d85\u0dbd\u0dd2\u0dba\u0dcf \u0d9a\u0dd2\u0dba\u0dc0 \u0d91 \u0dc1) \u0dc3\u0dc1 \u0dbd )\u0db4\u0dad\u0dc2\u0dab \u0db1\u0dc0\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0dc3\u0dc1\u0dad\u0dc0 \u0d9a\u0dc1\u0db1\u0dc0\u0dc0\u0dcf0 \u0dad\u0dbb\u0dd4 \u0da2\u0dc0\u0dcf\u0db0\u0dd2\u0db4 \u0d9a\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0d92 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dc3 \u0dc1\u0dad \u0dc0\u0dd0 \u0dc3\u0da7 \u0dc0 \u0d85\u0dc1\u0dca \u0daf\u0dd2\u0dbd\u0dd4) \u0d85\u0dd4\u0daf\u0dab\u0dd4\u0dad\u0db8 \u0dc3\u0dcf\u0da2\u0dba \u0dd2\u0db8 \u0d9a\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0da7 )\u0db4\u0dd6\u0dbb\u0dca\u0db4 \u0db1\u0dd2\u0daf\u0dca\u200d\u0dc4 \u0dbd\u0dba\u0dda\u0db1\u0dcf \u0daf\u0dd3 \u0d9a\u0dc1\u0db1\u0dc0\u0dc0\u0dcf0 \u0dad\u0dbb\u0dd4\u0db4 \u0dc3\u0dcf\u0da2\u0dba \u0dd2\u0db8 \u0d9a\u0dc0\u0dc3\u0dba\u0d9a\u0dd4 \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0d92 \u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dc3\u0dba \u0d89 \u0dca\u0da7 \u0dc3\u0dc0\u0dc0\u0dcf0"
