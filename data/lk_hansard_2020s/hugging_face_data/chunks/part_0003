    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0dcf\u0daf\u0db1\u0daf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0db8\u0db1\u0dd2 2322 \u0db8\u0dd0\u0dba\u0dd2 \u0db8\u0dca 39\u0dc0\u0dca\u200d\u0db1 \u0daf\u0dd2\u0db1 \u0db1\u0dd2\u0dda\u0da7\u0db9\u0dd4\u0dc1\u0dda\u0daf\u0dd3 \u0db8\u0dd0 \u0dba\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0db1\u0dca\u0db1\u0dca \u0db4\u0daf\u0d9a\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dcf \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0d85\u0dad\u0dd4\u0db8\u0dcf\u0dc1 \u0ddd \u0dc5 \u0dca\u0dc4 \u0d94\u0dc4\u0dd4\u0dc1\u0dda \u0d86 \u0d9a\u0dca \u0db1\u0dd2\u0dbd\u0dc0\u0daf\u0dbb\u0dd2\u0dc0\u0dca\u200d \u0d89\u0dad\u0daf \u0d85\u0db8\u0daf\u0db1\u0dd4\u0dc2\u0dd2 \u0dc1\u0dbd\u0dca \u0d9d\u0daf\u0dad\u0db1\u0d9a \u0dc5\u0daf1 \u0d92 \u0dc1\u0db4\u0ddc\u0dbd\u0dd3\u0db1\u0dca\u0d9a \u0dc4\u0daf \u0dc4\u0db8\u0dd4\u0dcf\u0daf\u0dc0\u0dca\u200d \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dc1\u0dda1 \u0d91\u0daf\u0dd2\u0db1\u0db8 \u0dad\u0dc0\u0dca\u200d\u0dad\u0dca 36\u0d9a\u0dca \u0d9d\u0daf\u0dad\u0db1\u0d9a \u0dc0\u0dd4\u0dab\u0daf1 \u0db1\u0dd2\u0dc0\u0dca\u200d\u0daf\u0dca 153 \u0da7 \u0dc0\u0dca\u200d\u0da9\u0daf \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dd0\u0db6\u0dd4\u0dc0\u0dca\u200d\u0daf1 \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dc1\u0db4\u0ddc\u0dbd\u0dd3\u0db1\u0dca\u0d9a \u0dc1\u0dc4\u0ddd \u0dc4\u0db8\u0dd4\u0dcf\u0daf\u0dc0\u0dca\u200d \u0d91\u0db8 \u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf \u0dc0\u0dca\u200d\u0dd0\u0dc5\u0dd0\u0d9a\u0dca\u0dc0\u0dd3\u0db8\u0da7 \u0d9a\u0dd2\u0db1\u0dca\u0daf\u0dd4 \u0db4\u0dd2\u0d9a\u0dc0\u0dca\u200d \u0d9a\u0dca \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dca \u0db1\u0dd0\u0dad1 \u0d89\u0dd2\u0dbb\u0dc4\u0daf\u0dca\u0dc1\u0dda \u0dc0\u0dca\u200d \u0dcf\u0daf\u0dc0\u0dca\u200d\u0dad\u0dca \u0dc1\u0db1\u0ddc\u0dc0\u0dd6 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d91\u0dc1\u0dca \u0dc0\u0dd3\u0db8\u0da7 \u0dc1\u0dc4 \u0dad\u0dd4\u0db8\u0dcf\u0dc0\u0dca\u200d \u0d9a\u0dd4\u0db8\u0d9a\u0dca \u0dc3\u0dd2\u0d9a \u0dc4\u0dd0\u0d9a\u0dd2\u0dcf? \