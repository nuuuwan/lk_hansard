 \u0dc1\u0dd3\u0dca\u0dc2\u0dc1 \u0dd2 01 \u0dc0\u0dc3 \u0dc0\u0dd0\u0da9\u0dbd\u0d82\u0da7\u0dc4\u0dc3, \u0db8\u0dd6\u0d9a\u0dc0\u0dc3 \u0dc0\u0dd2 \u0daf\u0dab \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0dc3\u0dc1 \u0dd2 \u0dc1 \u0ddc\u0da7\u0d82\u0dca \u0dc4\u0dd0\u0db8 \u0da7 \u0dad\u0dd2\u0db6\u0dd2 \u0dd4\u0dad\u0dad\u0dd4 \u0dba\u0dd2 \u0db1\u0dd2\u0dc1 \u0ddd\u0db8 \u0dbb\u0dc3 \u0d9a\u0daf\u0dd3.\n\n4131 4132\n\n\u0db4\u0ddc\u0dca\u0dbd\u0dd2\u0db8\u0dc1\u0db1\u0dca\u0dad\u0dd4 \u0dc0\n\n252 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dba.- \u0da2\u0db1 \u0dc4\u0dcf \u0dc3\u0d82\u0dc0\u200d\u0dcf\u0daf\u0dbd\u0dca\u0dc0\u0db1 \u0daf\u0dd9\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0daf\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dbb\u0dc0 01 \u0dc0\u0dc3 \u0dc0\u0dd0\u0da9\u0dbd\u0d82\u0da7\u0dc4\u0dc3.- \u0dc1\u0dab\u0dc1\u0dc4\u0dd4\u0dad\u0db1 \u0dc0\u0dd0\u0da9\u0dbd\u0d82\u0da7\u0dc4\u0dc3 - \u0db4\u0dd4\u0dc3\u0dbb\u0ddc\u0dc0\u0dca\u0dad\u0dc3 \u0dc0\u0dd2 \u0daf\u0dab,\n\n\u0dbb\u0dd4. 1,200,370,000\n\n\"252 \u0dc0\u0dc3 \u0dc1\u0dd3\u0dca\u0dc2\u0dc1 \u0dd2 01 \u0dc0\u0dc3 \u0dc0\u0dd0\u0da9\u0dbd\u0d82\u0da7\u0dc4\u0dc3, \u0db4\u0dd4\u0dc3\u0dbb\u0ddc\u0dc0\u0dca\u0dad\u0dc3 \u0dc0\u0dd2 \u0daf\u0dab \u0d82\u0db3\u0dc4\u0ddc \u0dbb\u0dd4. 1,200,370,000 \u0db8\u0dd4\u0daf\u0d9a \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0dc3 \u0da7 \u0d87\u0dad\u0dd4 \u0dc5\u0dad \u0dc5 \u0dd4\u0dad\u0dad\u0dd4 \" \u0dc3 \u0db4\u0dca\u200d\u0dbb \u0dc0\u0dc3 \u0dc0\u0dd2\u0dab\u0d82\u0dc3 \u0d9a\u0daf\u0dd2\u0dca \u0d82\u0db7\u0ddc \u0d82\u0db1\u0dab\u0dad \u0dc0\u0dd2 .\n\n252 \u0dc0\u0dc3 \u0dc1\u0dd3\u0dca\u0dc2\u0dc1 \u0dd2 01 \u0dc0\u0dc3 \u0dc0\u0dd0\u0da9\u0dbd\u0d82\u0da7\u0dc4\u0dc3, \u0db4\u0dd4\u0dc3\u0dbb\u0ddc\u0dc0\u0dca\u0dad\u0dc3 \u0dc0\u0dd2 \u0daf\u0dab \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0dc3\u0dc1 \u0dd2 \u0dc1 \u0ddc\u0da7\u0d82\u0dca \u0dc4\u0dd0\u0db8 \u0da7 \u0dad\u0dd2\u0db6\u0dd2 \u0dd4\u0dad\u0dad\u0dd4 \u0dba\u0dd2 \u0db1\u0dd2\u0dc1 \u0ddd\u0db8 \u0dbb\u0dc3 \u0d9a