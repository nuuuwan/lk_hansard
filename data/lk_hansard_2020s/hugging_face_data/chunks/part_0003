0db1\u0dca\u0dad0 EPF \u0d85\u0dba\u0dd4\u0dc0\u0db8\u0dca\u0db4\u0dad\u0dca\u200d\u0dbb \u0db7\u0dcf\u0dbb \u0dd0\u0dd3 \u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0db1\u0dca\u0dad\u0dad\u0dbb\u0dca\u0dbd\u0da2\u0dcf\u0dcf\u0dbd\u0dba \u0d94\u0dc3\u0dca\u0dc1\u0dc3\u0dca \u0dc1\u0dda\u0dbd\u0dcf\u0dc0 \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0d9a\u0dbb \u0dd0\u0dd3 \u0dc1\u0db8\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0dbd \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dad\u0dc0\u0dcf \u0daf\u0dd3\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf0 \u0dc1\u0dc0\u0db1 \u0daf\u0dcf \u0dc0\u0dd2\u0dc1\u0dda \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba \u0d89\u0dc3\u0dca\u0dc3\u0dbb\u0dc4, \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dc1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0d89\u0dc3\u0dca\u0dc3\u0dbb\u0dc4 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dc1\u0db4\u0ddd\u0dd2\u0db8 \u0d85\u0daf \u0db1\u0dd0\u0dad\u0dd2 \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf0 Online system \u0db1\u0d9a \u0dc4\u0daf\u0dbd\u0dcf system \u0db1\u0d9a \u0dc1\u0dc0\u0db1\u0dc3\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf, \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0db4\u0dc4\u0dc3\u0dd4\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb \u0db1\u0dca\u0dad\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0dad\u0d9a\u0db8 \u0dbd\u0db6\u0dcf \u0dc1\u0daf\u0db1\u0dca\u0dad\u0db10\n\n\u0dc1\u0dc3\u0dca\u0dc0\u0d9a \u0d85\u0dbb\u0dca\u0dbd\u0dae\u0dc3\u0dcf\u0dcf\u0d9a \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0dd2\u0dba\u0dba\u0da7 30\u0d9a \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0db1\u0dca\u0dad\u0db1 \u0daf\u0dd0\u0db1\u0da7 \u0dd4\u0dc5\u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0dad\u0d9a\u0db8 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf0 \u0d92\u0d9a \u0dbd\u0db6\u0dcf \u0db1\u0dca\u0dad\u0db1 \u0d89\u0dad\u0dd2\u0db1\u0dca\u0dad \u0d89\u0