    "chunk_text": "\u0db8\u0db8 \u0db1\u0dda \u0dc1\u0db8\u0da0\u0dca\u0da0 \u0daf\u0dbd\u0d9a\u0d9a\u0dca \u0dc4\u0dd2\u0dad\u0daf\u0dc1\u0d9c\u0db1 \u0dc4\u0dd2\u0da7\u0dd2\u0dc1\u0dda \u0da7 \u0dc0\u0dca\u200d\u0dd0\u0dc1\u0da7\u0db1\u0dc0\u0dca\u200d\u0daf\u0da7 \u0dd0\u0db8\u0dd0\u0dd2\u0dbb JVP \u0d91 \u0d9a\u0dd2\u0d9a\u0dbd\u0daf\u0dba\u0dd21 \u0db6\u0dbd\u0daf\u0dc1\u0d9c\u0db1 \u0d9c\u0dd2\u0d9a\u0daf\u0db8 \u0da7 \u0dc0\u0dca\u200d\u0dd0\u0dc1\u0da7\u0db1 \u0d91 \u0da7 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0daf\u0db1 \u0dc3\u0dd2\u0db4\u0d9a\u0dca \u0d9a\u0dad\u0dca \u0dd0\u0db8\u0dd0\u0dd2\u0dbb\u0dba\u0dd2\u0dc1\u0db1\u0dca1 \u0d9a\u0dd4\u0db8\u0d9a\u0dca \u0dc1\u0dc4\u0ddd \u0dca\u0dae\u0dc0\u0dca\u200d\u0daf\u0dcf\u0daf\u0dc3\u0dd2 \u0dc1\u0dc4 \u0dad\u0dd4\u0db8\u0dcf\u0dc0\u0dca\u200d\u0d9a\u0dca \u0d8b\u0da9 \u0dc3\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0d9a \u0dc3\u0dd2\u0dca\u0db1\u0dca\u0db0\u0dd2 \u0dc0\u0dd4\u0dab\u0daf\u0db8 \u0d92 \u0dad\u0dca \u0d86\u0dda\u0da9\u0dd4\u0dc0\u0dca\u200d \u0db4\u0dd0\u0dad\u0dca\u0dad\u0da7 \u0dcf\u0daf\u0db1\u0dca\u0db1 \u0dc4\u0dcf\u0db1\u0dc0\u0dca\u200d\u0daf1 \u0d91\u0db8 \u0db1\u0dd2\u0dca\u0daf \u0db8\u0db8 \u0d89\u0dad\u0daf\u0db8 \u0dbb\u0dd4\u0dab\u0daf\u0dc1\u0dc0\u0dca\u200d\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0db1\u0dc0\u0dca\u200d\u0daf \u0db6\u0daf\u0dbd \u0dc1\u0daf\u0dca \u0db4\u0daf\u0dbd\u0db1\u0d9a \u0db1\u0dca\u0db1 \u0d91\u0db4\u0daf1 \u0dc1\u0dda \u0da7 \u0dc0\u0dca\u200d\u0dd0\u0da7\u0dd2\u0dbd\u0daf \u0dd2\u0dbb\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca1 \u0dc0\u0dca\u200d\u0dd0\u0da7\u0dd2\u0dbd\u0daf \u0dd2\u0dbb\u0dc1\u0db6\u0db1 \u0da7 \u0dc1\u0d9c\u0ddc\u0da9\u0d9c\u0db1\u0dca\u0db1 \u0d8b\u0dad\u0dca\u0dca\u0daf\u0dc4 \u0daf\u0dca\u0daf\u0dd3 \u0db1\u0dca\u0d9a\u0dbd\u0dd4\u0dc1\u0dcf\u0db1\u0daf\u0db8 \u0d91 \u0dad\u0dd4\u0db8\u0dcf \u0dc1\u0dc0\u0dca\u200d\u0dbd\u0daf \u0d92 \u0da7 \u0dca\u0dc4\u0dc1\u0d9a\u0ddd\u0d9c\u0d9a \u0dc1\u0dcf\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0d9a\u0dbd\u0daf \u0d