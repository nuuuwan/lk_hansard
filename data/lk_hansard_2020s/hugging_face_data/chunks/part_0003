    "chunk_text": "\u0d8a\u0da7 \u0d85\u0dcf\u0dad\u0dbb\u0dc0 \u0dc1\u0db4\u0dad \u0dd2\u0dbb\u0dd2\u0db4 \u0db1\u0dd2\u0dc2\u0d9a\u0db4\u0dad\u0dba\u0dca, \u0dca\u0dd0 \u0d9a\u0dca\u0db4\u0dad \u0db4\u0dc1\u0dd4 \u0db4\u0dad\u0db4 \u0d9a \u0d9a\u0dca\u0dc1\u0dc2\u0d9a\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dda \u0db4\u0dd4\u0dc1\u0dbb\u0ddd\u0d9c\u0dad\u0db8\u0dd2 \u0dad \u0dd0\u0da7\u0dd2 \u0da7 \u0dad\u0dd2\u0dc3\u0dc1 \u0dca \u0d86\u0dba\u0dbb\u0dca \u0dc0 \u0d9a \u0d86 \u0dad\u0dca \u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca, NLDB \u0d91\u0d9a\u0dcf - \u0da2\u0dca\u200d\u0dad\u0dad\u0dd2\u0dc3\u0d9a\u0dcf \u0db4\u0dc1\u0dd4 \u0db4\u0dad\u0db4 \u0d9a \u0dcf\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dca \u0dcf\u0dab\u0dca\u0da9\u0d9a \u0dba\u0dd2. \u0d91\u0dc4\u0dd2 \u0db7\u0dad\u0db4\u0dad\u0dd2\u0dc3 Prof. Cyril \u0dcf\u0dd0\u0dad\u0dd2\u0dc3\u0dad\u0dd4\u0db8\u0dcf\u0dad \u0dc1\u0db4\u0dad \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc1\u0dc5\u0d9a \u0dca\u0dad \u0d9a\u0dcf \u0d9a\u0dc0 \u0d85\u0dbb\u0dc1\u0d9c\u0dca \u0dc0\u0dd0\u0da9 \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dcf\u0dc0 \u0d9a\u0dc0 \u0d9a\u0dcf\u0dbb\u0dc1\u0d9c\u0dca \u0db1\u0dca\u0dca \u0daf\u0dd4 \u0dad\u0d9a \u0dcf \u0db1\u0dca\u0dd2\u0db1 \u0d9a\u0dca \u0dba\u0dbb\u0dca\u0dc0\u0dad. \u0dc1\u0db4\u0dad \u0dd2\u0db1 \u0dbd\u0dd4 \u0d9a\u0dcf\u0dad\u0dbb\u0dab\u0dba\u0dad \u0dc3\u0dad\u0dd4\u0db8\u0dc5 \u0d9a \u0db1\u0dd2 \u0daf\u0dca \u0dc0\u0dba\u0dad\u0db4\u0dd8\u0dad\u0dd3\u0db1\u0dca \u0dc1\u0dba\u0d9a\u0dcf\u0d9a\u0dca \u0dad\u0dcf\u0dba\u0dd2 \u0d91\u0dcf \u0d9a\u0dae\u0dad\u0dca \u0dad\u0dd4\u0db8\u0dc5 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dad \u0d9a\u0dcf\u0d9a\u0dcf \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca.\n\n\u0d8a\u0da7 \u0d85\u0dcf\u0dad\u0dbb\u0dc0 \u0dcf\u0dcf \u0dc1\u0db4\u0dad \u0d9c\u0dbb\u0dd4 \u0db7\u0dad\u0dc1\u0dda \u0d85\u0dc0\u0db0\u0db1\u0dad\u0dca \u0dc1\u0db4\u0dad \u0d9a\u0dcf\u0dad\u0dbb\u0dab\u0dba \u0db3 \u0dad \u0d9a \u0dc1 \u0dad\u0daf\u0dca \u0d9a\u0dcf\u0dbb\u0dc0\u0db1\u0dca\u0dca \u0d9a\u0dcf\u0dd0\u0dcf\u0dd0\u0dad\u0dd2\u0dc3\u0dba\u0dd2. \u0d92 \u0dad\u0dcf\u0dba\u0dd2, \u0dc1\u0dca\u200d\u0dbb\u0ddd\u0da7\u0dd3\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2 \u0db3\u0dc0 \u0d9a\u0dcf\u0dae\u0dad \u0d9a\u0dcf\u0dbb\u0dca \u0daf\u0dd4\u0da7 \u0dc0\u0dd0\u0dba\u0d9c \u0d9a \u0d9a\u0dae\u0dad\u0dca \u0d9a\u0dca \u0d9c\u0db1\u0dca\u0dca\u0dad \u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0d9a\u0dd4\u0d9a\u0dd4\u0dc5\u0dd4 \u0d9a\u0dcf\u0dbb\u0dca\u0dcf\u0dad\u0db1\u0dca\u0dad \u0d9c\u0dd0\u0dca. \u0d9a\u0dcf\u0d9a\u0dcf\u0dad\u0dc1\u0dda \u0d9a\u0dd4\u0d9a\u0dd4\u0dc5\u0dd4 \u0d9a\u0dcf\u0dbb\u0dca\u0dcf\u0dad\u0db1\u0dca\u0dad \u0d89\u0dad\u0dad\u0dcf \u0dc1 \u0dad\u0db3, \u0d9a\u0dc0 \u0dcf\u0dc1\u0db4\u0ddd\u0dc2\u0dd2\u0dad \u0dad \u0d9a \u0d9a\u0dc0 \u0d9a\u0dcf \u0dad\u0dd2\u0dc3\u0db6\u0dd4\u0dab\u0dba\u0dad. \u0db4\u0dd4\u0dc0\u0d9c\u0dd2 \u0d9a\u0dcf\u0dad\u0d9a\u0dc1\u0dda \u0d86\u0dbb\u0dca\u0dbb\u0d9a\u0dcf \u0d9a\u0dcf\u0da9\u0dad\u0dc1\u0d9c\u0dca \u0dc0\u0dd0\u0db8\u0dca\u0dab\u0dba\u0dad\u0dcf, \u0dc1\u0d9a\u0dcf\u0dad\u0daf\u0dd4\u0da9\u0dca \u0dda\u0dc0\u0dbd\u0dd2\u0dbb \u0d9a, \u0d85\u0dbb\u0d9c\u0dc5 \u0d9a \u0d91\u0d9a\u0dca\u0d9a\u0dcf \u0dc1\u0db4\u0dad \u0d9a\u0dcf\u0dbb\u0dca\u0dcf\u0dad\u0db1\u0dca\u0dad \u0daf\u0dca\u0db6\u0dbd\u0db1\u0dca\u0dcf \u0d9a\u0dcf\u0da9\u0dad\u0dc1\u0d9c\u0dca \u0dc0\u0dd0\u0db8\u0dca\u0dab\u0dba\u0dad. \u0dc1\u0db4\u0dad \u0d9a\u0dcf\u0dbb\u0dca\u0dcf\u0dad\u0db1\u0dca\u0dad \u0da7 \u0dc3\u0dad\u0dd2\u0dc3\u0dc1\u0dc0\u0d9a\u0dad \u0dad\u0dd2\u0dc3\u0dc1 \u0dca \u0d9c\u0dd0\u0da7\u0dbd\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2 \u0db3\u0dc0 \u0d85\u0db4\u0dd2 \u0dc1 \u0dad \u0dad \u0dd0\u0dbd\u0dd4\u0dc0\u0dad. \u0d92\u0d9a\u0dcf\u0da7 \u0d85\u0dc0 \u0dba \u0dcf\u0dda \u0d9a\u0dad\u0dd4\u0db8 \u0da7\u0dd2\u0d9a\u0dcf \u0d9a\u0dcf\u0d9a\u0dcf\u0dad\u0dc0\u0da7 \u0dc1 \u0db1\u0dca\u0dca \u0d85\u0db4\u0dd2 \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dcf\u0dbb\u0dca\u0dc0\u0dad. \u0d85\u0dba \u0dcf\u0dda \u0d9a\u0dad\u0dd4\u0db8 \u0d85\u0db4\u0da7 \u0d85\u0dc0 \u0dba \u0dca\u200d\u0dbb\u0dcf\u0dad\u0dab\u0dba \u0dc1\u0d9c\u0dca\u0dbd\u0dca\u0d9a\u0dad \u0dad\u0dd2\u0dc3\u0dc1 \u0dca\u0dc0\u0dad. \u0dd2\u0db1\u0dd2\u0db1 \u0d9a\u0dcf\u0da7\u0dba\u0dd4 \u0d9a\u0dad\u0d9a\u0dca \u0dd0\u0da7\u0dd2 \u0da7 \u0dba\u0dd0\u0db1\u0dca \u0dd0\u0dd9\u0dd2\u0db4\u0dc0\u0db6\u0dbd\u0db1\u0dca \u0db1\u0dd2\u0dc2\u0d9a\u0db4\u0dad\u0dba\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dad\u0dc0\u0db6\u0dbd \u0dd2\u0db1\u0dbd\u0dd2 \u0dc1\u0dc0\u0dca\u0dc0\u0dad. \u0d9c\u0dbb\u0dd4 \u0d85\u0dcf\u0dad\u0dad\u0dba\u0dad\u0dd4\u0db8\u0dcf\u0dad \u0d9a \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dc1 \u0d9a\u0dcf\u0dae\u0dad\u0dc1\u0dda\u0daf\u0dd3 \u0dc1\u0db4\u0dad"
  },
