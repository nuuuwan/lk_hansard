    "chunk_text": "\u0dca\u0dca\u0db6\u0db1\u0dca \u0dc1\u0d9a\u0dca \u0dc0\u0dca\u200d\u0dc4\u0daf\u0dcf \u0db4\u0dd2\u0d9a\u0dc0\u0dca\u200d \u0d9c\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0d9a\u0dbd\u0daf\u0dba\u0dd2. \u0d85\u0db1\u0dd4\u0dc0\u0dca\u200d \u0d85\u0db4\u0dd2 \u0d91\u0d9a \u0d91\u0dc3\u0d9c\u0dbd\u0dca\u0dad\u0dc1\u0dda \u0db1\u0dd3\u0dd2\u0dbb\u0da5 \u0dca\u0dcf\u0daf\u0d9c\u0dcf \u0da7 \u0dcf\u0daf \u0daf\u0dd4\u0dca\u0db1\u0daf. \u0d85\u0db4\u0dd2 \u0dcf\u0dd0\u0dca \u0d91\u0d9a\u0daf\u0d9a \u0db1\u0dca\u0dae \u0dca\u0dcf\u0daf\u0d9c\u0dcf\u0da7 \u0d91\u0dc1 \u0dc4\u0dd2\u0dc0\u0dca\u200d arbitration \u0d91 \u0d9a\u0dca \u0db4\u0da7\u0dca \u0dc1\u0d9c\u0db1 \u0dd2\u0dbb\u0dc1\u0db1\u0db1\u0dc0\u0dca\u200d\u0daf, \u0d91\u0d9a\u0daf\u0d9a \u0db1\u0dca\u0dae \u0dca\u0dcf\u0daf\u0d9c\u0dc1\u0dcf\u0dca \u0db4\u0d9c\u0daf \u0daf\u0dd3\u0dbd\u0daf \u0db4\u0dd4 \u0dc0\u0dca\u200d\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0db1\u0db3\u0dc0\u0dca\u200d \u0dc0\u0dca\u200d\u0dc4\u0daf\u0dcf \u0dc1\u0dca\u0ddc\u0d9a\u0daf \u0dca\u0db3\u0dc4\u0daf \u0dc0\u0dca\u200d\u0dca\u0daf\u0dd2 \u0d85\u0d9a \u0d9c\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0d9a\u0dbd\u0daf.\n\n\u0db8\u0dd6\u0dbd\u0daf\u0dca\u0db1\u0daf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0dcf\u0db1\u0dd2, \u0dc1\u0dcf\u0dc0\u0dca\u200d\u0dd0\u0db1\u0dd2 \u0daf \u0dab\u0d9a \u0dc1\u0dca\u0db6 \u0dba\u0dd2. \u0d85\u0dc1\u0db4\u0dca \u0dc4\u0dd2\u0dad\u0dc0\u0dca\u200d\u0dad\u0dca \u0d9c\u0dbb\u0dd4 \u0dd2\u0dbb\u0dca\u0dae\u0dca \u0d85\u0dad\u0dca\u0dad\u0db1\u0daf\u0d9a \u0dcf\u0dd0\u0dd2\u0dbb\u0dad\u0dd4\u0dcf\u0daf \u0dc1\u0db1\u0ddc\u0dc1\u0dc4\u0ddc\u0dcf \u0dad\u0dd4\u0dbd\u0db1\u0daf\u0dad\u0dca\u0dcf \u0dc1\u0dbd\u0dca \u0d85\u0dc1\u0db4\u0dca \u0d9c\u0dd4\u0dc0\u0dca\u200d\u0dca \u0d9a\u0dca\u0dc1\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb\u0d9a \u0d9c\u0dd0\u0db1\u0dad\u0dca, \u0dc0\u0dca\u200d\u0daf\u0dc1\u0dda\u0dcf \u0db1\u0daf\u0dc0\u0dd2 \u0d9a\u0dca\u0dc1\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb\u0d9a \u0d9c\u0dd0\u0db1\u0dad\u0dca \u0dcf\u0daf \u0dc5\u0daf. \u0dcf\u0dcf \u0d9c\u0dd0\u0db1 \u0d91\u0dad\u0dd4\u0dcf\u0daf\u0da7 \u0dca\u0dae\u0dad\u0dd4\u0dd2\u0dbb\u0dc0\u0dca\u200d\u0dca\u0dad \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf. \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dc1\u0d9a\u0dca \u0dcf\u0dcf \u0d9a\u0dd2\u0d9a\u0dca\u0db1 \u0d95\u0db1\u0dd1, \u0d85\u0dc1\u0db4\u0dca \u0dca\u0dd0\u0dbd\u0dd0\u0dca\u0dae\u0dcf \u0dc1\u0dcf\u0ddc \u0d9a\u0dca\u0dcf \u0d9a\u0dd2\u0d9a\u0dbd\u0daf. \u0d85\u0dc1\u0db4\u0dca \u0dca\u0dd0\u0dbd\u0dd0\u0dca\u0dae\u0dcf \u0dc1\u0dcf\u0d9a\u0dba\u0dd2. \u0dc1\u0dbd\u0ddd \u0dc1\u0dda \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0dc0\u0dca\u200d \u0daf\u0d9a\u0dc0\u0dca\u200d\u0dbd\u0dca \u0d9c\u0dd0\u0db1 \u0dcf\u0daf \u0db1 \u0dc1 \u0ddc\u0da7 \u0d85\u0db4\u0dd2 \u0dc3\u0dd2\u0dc3\u0d9c\u0db4\u0dca\u0db4\u0dd6\u0dbb\u0dd4\u0dc0\u0dca\u200d \u0d9c\u0dd0\u0db1 \u0d9a\u0dd2\u0d9a\u0db1\u0dc0\u0dca\u200d\u0daf; \u0da9\u0dd4\u0db1\u0daf\u0dba\u0dd2 \u0d9c\u0dd0\u0db1 \u0d9a\u0dd2\u0d9a\u0db1\u0dc0\u0dca\u200d\u0daf; \u0d89\u0dca\u0daf\u0dd2\u0d9a\u0daf\u0dc0\u0dca\u200d \u0d9c\u0dd0\u0db1 \u0d9a\u0dd2\u0d9a\u0db1\u0dc0\u0dca\u200d\u0daf. \u0dcf\u0dcf \u0dc1\u0dca\u0db6 \u0dc5 \u0daf\u0dd3 \u0d89\u0dca\u0daf\u0dd2\u0d9a\u0daf\u0dc1\u0dda Global Maritime Summit \u0d91 \u0da7 \u0d9c\u0dd2\u0d9a \u0dc1\u0dc0\u0dca\u200d\u0dbd\u0daf\u0dc1\u0dda \u0db8\u0dd4\u0dca\u0dca\u200d\u0dbb\u0daf \u0dc0\u0dca\u200d \u0daf\u0d9a\u0da7 \u0d9c\u0dd2\u0d9a\u0daf. \u0db8\u0dd4\u0dca\u0dca\u200d\u0dbb\u0daf \u0dc0\u0dca\u200d \u0daf\u0d9a \u0d89\u0dca\u0daf\u0dd2\u0d9a\u0daf\u0dc1\u0dda \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dca\u200d\u0da7 \u0d85\u0dba\u0dd2\u0dd2\u0dbb \u0d91 \u0d9a\u0dca \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dca\u200d\u0dba\u0dd2. \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dca\u200d\u0da7 \u0d85\u0dba\u0dd2\u0dd2\u0dbb \u0dc0\u0dca\u200d \u0daf\u0d9a\u0dc0\u0dca\u200d\u0dbd\u0dca \u0d91 \u0d9a\u0dca\u0dc0\u0dca\u200d\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc0\u0dca\u200d\u0daf \u0da2\u0d9a\u0da7 \u0d85\u0dba\u0dd2\u0dd2\u0dbb \u0dc0\u0dd2\u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2 \u0d9a\u0dd2\u0d9a\u0db1 concept \u0d91 \u0dcf\u0dd0\u0dca \u0dc1\u0dbd\u0ddd \u0dc1\u0d9a\u0dca \u0dad\u0dd4 \u0dca \u0dc0\u0dd3 \u0dc1\u0d9c\u0db1 \u0d9a\u0db1\u0dc0\u0dca\u200d\u0daf. \u0dc0\u0dca\u200d \u0daf\u0d9a\u0dc0\u0dca\u200d\u0dbd\u0dca, \u0d9c\u0dd4\u0dc0\u0dca\u200d\u0dca \u0dc1\u0dad\u0ddc\u0da7\u0dd4\u0dc1\u0db4\u0ddc\u0dc5\u0dc0\u0dca\u200d\u0dbd\u0dca \u0da2\u0dc1\u0dda \u0db4\u0daf\u0dbd\u0db1\u0dc1\u0d9a\u0dca \u0db8\u0dd2\u0dc1\u0dcf\u0dca\u0db1\u0da7 \u0d95\u0db1\u0dd1. \u0da2\u0dc1\u0dda \u0db4\u0daf\u0dbd\u0db1\u0dc1\u0dda \u0dd2\u0dbb\u0d9a\u0daf\u0dc1\u0d9c\u0db1 \u0d86\u0d9a\u0dad\u0db1 \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca\u200d\u0dca \u0d9a\u0dd2\u0d9a\u0dbd\u0daf \u0dd4\u0db4 \u0d9a\u0dca \u0d85\u0d9a \u0dc4\u0dd2\u0dad\u0db1\u0dc0\u0dca\u200d\u0daf."
  },
