    "chunk_text": "\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dcf\u0dba \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0db1\u0dd2, \u0d94\u0db6\u0dd4\u0db8\u0dcf\u0da7 \u0dc3\u0dca\u0dd4\u0dad\u0dd2\u0dc0\u0db1\u0dca\u0dad\u0dad \u0dc1\u0dc0\u0db1\u0dc0\u0dcf0 \u0dbb\u0da7\u0da7 \u0d89\u0dad\u0dcf\u0db8 \u0dc0\u0dd0\u0daf \u0dad\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dc1\u0daf\u0d9a\u0d9a\u0dca \u0dc0\u0db1 \u0dc0\u0dd2\u0dc1\u0dda \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dc1\u0d86 \u0dc3\u0dc4 \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dc4\u0dcf \u0dc0\u0dd2\u0dc1\u0dda \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dc1\u0d86 \u0dc0\u0dd0\u0dba \u0dc1\u0dd3\u0dbb\u0dca\u0dbd\u0dc2 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0\u0dd2 \u0d85\u0daf \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad0 \u0dc0\u0dd0\u0daf \u0dad\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dd4\u0dad\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0dcf \u0dc0\u0db1 \u0db1\u0db8 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dbd\u0dd0\u0db6\u0dd3\u0db8 \u0dd0\u0db1 \u0db8\u0db8 \u0dc3\u0dd4\u0da7\u0da7 \u0db4\u0dad\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf0 \u0dc1\u0db8\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dc1\u0daf\u0d9a \u0dc0\u0dd2\u0dc1\u0dda \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0dbd \u0db1\u0dd2\u0dba\u0dd4\u0dd4 \u0d85\u0dba\u0da7 \u0d89\u0dad\u0dcf\u0db8 \u0dc1\u0dc5\u0db1\u0dca\u0dad \u0dd4 \u0db1\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0dc5\u0d9f\u0dd2\u0db1\u0dca\u0dad \u0db8 \u0d89\u0db1\u0dca\u0dad\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dc1\u0daf\u0d9a\u0d9a\u0dca \u0db6\u0dc0 \u0db4\u0dc5\u0db8\u0dd4\u0dc1\u0dc0\u0db1\u0dca\u0dad\u0db8 \u0d9a\u0dd2\u0