    "chunk_text": "\u0da2\u0dca\u200d\u0dc3\u0ddc\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4 \u0dab\u0ddc \u0d85\u0daf \u0daf\u0dd2\u0dc3 \u0dc1\u0db4\u0dde\u0db0 \u0db8\u0dbd\u0dd2\u0db8 \u0dc0 \u0d85\u0db4\u0dd2 \u0d91\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0dc5 \u0dc1\u0db4\u0ddc\u0da9\u0dd2 \u0d82\u0ddc \u0da0\u0dd2 \u0da1\u0ddc\u0dc0 \u0daf\u0dd3 \u0d9a\u0dd2\u0dda\u0dc0\u0ddc, \u0dc1\u0db1 \u0dca\u0daf\u0dd4 \u0d85 \u0d9a\u0dd2\u0dbb\u0dd3\u0dab \u0dc4\u0dd0\u0dbb \u0dc0\u0dd2 \u0dbd\u0dca\u0db4 \u0dca \u0dc3\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2 \u0d9a\u0ddc. \u0dca\u0dad\u0dd2\u0dca, \u0dc0\u0dd2 \u0dbd\u0dca\u0db4 \u0dca \u0dc3\u0dd0\u0dad\u0dc3\u0db1 \u0dc1\u0db1 \u0dbb\u0da7\u0da7 \u0d85\u0dca \u0d82\u0dbb\u0dab\u0dba\u0dd2 \u0dc1\u0dca. \u0dab\u0dab \u0dc0\u0dd2 \u0dc0\u0dc0\u0ddc\u0d82 \u0dbb\u0dc3\u0dc0\u0ddc, \u0d85\u0dab\u0ddc\u0dad\u0dba\u0ddc\u0d9c \u0dc1\u0db8\u0ddc\u0da9\u0dbd\u0dca \u0dad\u0dab\u0dca \u0da7\u0dc1\u0dad \u0dad\u0dca\u0ddc\u0dc1\u0db8\u0dc3, \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d85\u0dab\u0ddc\u0dad\u0dba\u0ddc\u0d9c \u0dc0\u0ddc\u0dc1\u0dda \u0d85\u0dab\u0ddc\u0dad\u0dba\u0ddc\u0d9c \u0dca \u0dc4\u0dc3\u0dd4\u0dbb\u0dd4\u0dc0\u0dca\u0dc3 \u0dca\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2 \u0d9a\u0ddc. \u0dc1\u0db1 \u0d82\u0db1\u0db4\u0dd6\u0dbb\u0dca\u0dab\u0dc1 \u0dca \u0dc3\u0dd2 \u0da7 \u0dc3\u0dd2 \u0d85\u0dc0\u0dc0\u0ddc\u0dc3 \u0dca \u0dc1 \u0ddc\u0db8\u0dd4 \u0dbb \u0dc4\u0dd0\u0dc3\u0dd2\u0dbb\u0dc0\u0dd2 \u0dd4\u0dad\u0dad\u0dd4 \u0d85\u0dab\u0ddc\u0dad\u0dba\u0ddc\u0d9c \u0dca. \u0dcf \u0db1\u0dd2\u0d82\u0ddc \u0dc1\u0db1 \u0d85\u0dab\u0ddc\u0dad\u0dba\u0ddc\u0d9c \u0dc4\u0dc3\u0dd4\u0dbb\u0dd4\u0dc0\u0dca\u0dc3 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dad\u0dd2\u0dc0\u0dbb\u0dc1 \u0dca \u0dc1\u0db1 \u0da7 \u0dc1\u0dc0\u0dc3\u0dab \u0db4\u0dad \u0dbb\u0dca\u0dc3 \u0d95\u0dc3\u0dd1. \u0d91\u0dc1\u0d9a\u0d82 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dad\u0dd2\u0dc0\u0dbb\u0dc1 \u0dca \u0db4\u0dad \u0dbb\u0d9a\u0ddc \u0d91\u0dad\u0dd4 \u0dab\u0ddc\u0dc1\u0dda \u0ddc\u0d9a \u0dc3\u0dd2 \u0da7 \u0dc3\u0dd2 \u0dca \u0dcf \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0dca \u0dc1\u0dc0\u0dca \u0dbb\u0dca\u0dc3 \u0d95\u0dc3\u0dd1. \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d85\u0dab\u0ddc\u0dad\u0dba\u0ddc\u0d9c , \u0dca\u0dab\u0ddc\u0dca\u0dad \u0d85\u0dab\u0ddc\u0dad\u0dba\u0ddc\u0d9c , \u0dd2 \u0dca\u0dab \u0d85\u0dab\u0ddc\u0dad\u0dba\u0ddc\u0d9c \u0dc0\u0ddc\u0dc1\u0dda \u0d85\u0dab\u0ddc\u0dad\u0dba\u0ddc\u0d9c \u0dbb\u0dc1\u0dc3 \u0db1\u0dd2\u0dc2\u0dc0\u0db4\u0ddc\u0daf\u0dc3 \u0dca\u0dc4\u0dc5 \u0daf\u0dd0\u0db8\u0dd3\u0dab \u0dca\u0d9a\u0dca \u0dbb\u0db8\u0dad \u0daf\u0dd2 \u0ddc\u0dc0 \u0da7 \u0dc4\u0dd0\u0dc3\u0dd2\u0dbb\u0dd4\u0dc1\u0dda \u0dc3\u0dd0\u0dad\u0dc3\u0db1 \u0dc1\u0db1 \u0dbb\u0dc1\u0dc3 \u0d86\u0dca\u0dd2 \u0dc1\u0db8\u0ddc\u0da9\u0dbd \u0daf\u0dab\u0dca\u0dc3 \u0dca\u0dd0\u0dc4\u0dd0. \u0d86\u0dca\u0dd2 \u0d82\u0dc0\u0dae\u0ddc\u0dc0\u0dbb \u0dc1\u0dc0\u0d9a\u0ddc \u0dad\u0dd2\u0dc1\u0dca\u0dc3\u0dc0\u0ddc \u0d9a\u0dd2 \u0d9a\u0ddc \u0dc1\u0db1 \u0dc1\u0db4\u0dc1\u0dc3\u0dca\u0dc1\u0dca \u0db8\u0dd2\u0dae\u0dba\u0ddc\u0dc0\u0dca. \u0dc1\u0db1 \u0db8\u0dd2\u0dae\u0dba\u0ddc\u0dc1\u0dc0\u0dca \u0dc1\u0db8\u0ddc\u0da9\u0dbd \u0d91\u0dca\u0dc3 \u0dc3\u0db1 \u0d87\u0dad\u0dad \u0d87\u0dad\u0dd2 \u0d82\u0dd0\u0db8\u0dc1 \u0dca \u0dc1\u0dad\u0dbb\u0dd4\u0db1 \u0d85\u0dbb\u0dc1\u0db8\u0dc3 \u0dca\u0dad\u0dd2\u0dbb\u0dd2 \u0ddc\u0d9a\u0dc1\u0dda\u0daf\u0dd3\u0dc0\u0dad \u0dc1\u0db1 \u0d85\u0dab\u0ddc\u0dad\u0dba\u0ddc\u0d9c \u0db1\u0dd2\u0dc3\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc1\u0dab\u0dc1\u0dc4 \u0dc0\u0d9a\u0ddc \u0dc1\u0db1 \u0d86\u0dca\u0dd2 \u0d85\u0dca\u0db6\u0dd4\u0daf\u0dc1 \u0dca \u0dbb\u0da7 \u0dc1\u0db8\u0ddc\u0da9\u0dbd\u0db8\u0dca\u0dc3 \u0d9a\u0dd2 \u0dc3 \u0dc1 \u0ddd\u0da2\u0dca\u200d\u0dc3\u0ddc\u0dc0 \u0dc1\u0db1 \u0d85\u0dc0\u0d82\u0dc0\u0dae\u0ddc\u0dc1\u0dda\u0daf\u0dd3 \u0dab\u0dab \u0dca\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad \u0dbb\u0dc3\u0dc0\u0ddc. \u0d85\u0dc0\u0d82\u0dc0\u0dae\u0ddc\u0dc0 \u0d9a\u0dca\u0ddc \u0daf\u0dd4\u0dca\u0dc3\u0ddc\u0da7 \u0dc1\u0dca\u0ddc\u0dc1\u0dc4\u0ddc\u0dab \u0d82\u0dc0\u0dad\u0dd4 \u0dad\u0dd2\u0dba\u0dd2, \u0db8\u0dd6\u0d9a\u0ddc\u0d82\u0dc3\u0ddc\u0dbb\u0dd6\u0daa \u0db8\u0dbb\u0dd4 \u0dab\u0dca\u0dd3\u0dad\u0dd4 \u0dab\u0db1\u0dd2.\n\n4045 4046\n\n[\u0db8\u0dbb\u0dd4 \u0dd3 .\u0dc0\u0dba\u0dd2.\u0da2\u0dd3. \u0dbb\u0dad\u0dc3\u0dc1\u0d82\u0dc0 \u0dbb \u0dab\u0dc4\u0dad\u0ddc]\n\n2023 \u0dc1\u0daf\u0d82\u0dd0\u0db1\u0dca\u0dca 13\n\n[\u0baa\u0bbf.\u0baa. 2.55]\n\n\u0d9c\u0dd4 \u0d92.\u0d9a\u0dbd\u0dca.\u0d9a\u0db8\u0dca. \u0d85\u0dad\u0dcf\u0dda\u0dbd\u0dca\u0dbd\u0dcf \u0dd9\u0dc4\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b8f.\u0b8e\u0bb2\u0bcd.\u0b8e\u0bae\u0bcd. \u0b85\u0ba4\u0bc6\u0bbe\u0b89\u0bb2\u0bcd\u0bb2\u0bc6\u0bbe) (The Hon. A.L.M. Athaullah) \u0baa\u0bbf\u0bb8\u0bcd\u0bc8\u0bbf\u0bb2\u0bcd\u0bb2\u0bc6\u0bbe\u0bb9\u0bbf\u0bb0\u0bcd \u0bb0\u0bb9\u0bcd\u0bc8\u0bc6\u0bbe\u0ba9\u0bbf\u0bb0\u0bcd \u0bb0\u0bb9\u0bc0\u0bae\u0bcd. \u0ba8\u0bb9\u0bcd\u0bc8\u0ba4\u0bc1\u0bb9\u0bc1 \u0bb5\u0ba8\u0bc1\u0bb8\u0bb2\u0bcd\u0bb2\u0bbf \u0b85\u0bb2\u0bc6\u0bbe \u0bb0\u0bb8\u0bc2\u0bb2\u0bbf\u0bb9\u0bbf\u0bb2\u0bcd \u0b95\u0bc6\u0bbe\u0bc0\u0bae\u0bcd. \u0b85\u0bae\u0bcd\u0bc8\u0bc6\u0bbe \u0baa\u0b83\u0ba4\u0bcd!\n\n\u0ba4\u0b95\u0bcc\u0bb0\u0bb5 \u0ba4\u0bae\u0bb2\u0bae\u0bc8\u0ba4\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bae\u0bb3, 2024\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0bb5\u0bb0\u0bb5\u0bc1 \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0b95\u0bcd \u0b95\u0bc1\u0bb4\u0bc1\u0ba8\u0bbf\u0bae\u0bb2 \u0bb5\u0bbf\u0bb5\u0bc6\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bae\u0b9f\u0b9a\u0bbf \u0ba8\u0bc6\u0bbe\u0bb3\u0bc6\u0bbe\u0ba9 \u0b87\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba8\u0bbf\u0ba4\u0bbf, \u0ba4\u0baa\u0bc6\u0bbe\u0bb0\u0bc1\u0bb3\u0bc6\u0bbe\u0ba4\u0bc6\u0bbe\u0bb0 \u0b89\u0bb1\u0bc1\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1 \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0ba4\u0b9a\u0bbf\u0baf\u0b95\u0bcd \u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bae\u0b95\u0b95\u0bb3\u0bcd \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0b9a\u0bc1 \u0ba4\u0ba4\u0bc6\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bc6\u0bbe\u0ba9 \u0bb5\u0bbf\u0bb5\u0bc6\u0bbe\u0ba4\u0bae\u0bcd \u0ba8\u0bae\u0b9f\u0ba4\u0baa\u0bb1\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b87\u0ba8\u0bcd\u0ba4 \u0bae\u0bb5\u0bae\u0bb3\u0baf\u0bbf\u0bb2\u0bcd, \u0bc8\u0bbf\u0b95 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0bc8\u0bc6\u0bbe\u0ba9 \u0b9a\u0bbf\u0bb2 \u0bb5\u0bbf\u0b9f\u0baf\u0b99\u0bcd\u0b95\u0bae\u0bb3 \u0b87\u0b99\u0bcd\u0b95\u0bc1 \u0b95\u0bc2\u0bb1\u0bae\u0bb5\u0ba3\u0bcd\u0b9f\u0bbf\u0baf\u0ba4\u0bc1 \u0b95\u0bc6\u0bbe\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bae\u0ba4\u0bae\u0bb5\u0ba4\u0baf\u0ba9 \u0ba8\u0bc6\u0bbe\u0ba9\u0bcd \u0ba8\u0bbf\u0bae\u0ba9\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bae\u0bb1\u0ba9\u0bcd."
  },
