    "chunk_text": "\u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 02.- \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0bcd \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd - \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd\n\n\u0ba4\u0b9a\u0bb2\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 3,186,000,000\n\n\u201c\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 285, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 02, \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 3,186,000,000 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0bb1\u0bcd \u0bb2\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bc8\u0bc6\u0bbe\u0b95\u201d \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 292.- \u0b95\u0bc6\u0bbe\u0bb2\u0bcd\u0ba8\u0bae\u0b9f \u0b89\u0bb1\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bc1\u0b95\u0bc6\u0bbe\u0ba4\u0bc6\u0bbe\u0bb0\u0ba4\u0bcd\n\n\u0ba4\u0bbf\u0bae\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd\n\n\u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01.- \u0ba4\u0b9a\u0baf\u0bb2\u0bcd\u0bae\u0bc1\u0bae\u0bb1\u0b9a\u0bcd \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd - \u0bc8\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd\n\n\u0ba4\u0b9a\u0bb2\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 841,150,000\n\n\u201c\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 292, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bc8\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1\u0b95\u0bcd \u0b95\u0bc6\u0bbe\u0ba9 \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 841,150,000 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0bb1\u0bcd \u0bb2\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bc8\u0bc6\u0bbe\u0b95\u201d \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 292, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bc8\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bb3\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01.- \u0ba4\u0b9a\u0baf\u0bb2\u0bcd\u0bae\u0bc1\u0bae\u0bb1\u0b9a\u0bcd \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd - \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd\n\n\u0ba4\u0b9a\u0bb2\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 73,000,000\n\n\u201c\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 292, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 73,000,000 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0bb1\u0bcd \u0bb2\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bc8\u0bc6\u0bbe\u0b95\u201d \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 292, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bb3\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 02.- \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0bcd \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd - \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd\n\n\u0ba4\u0b9a\u0bb2\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 586,000,000\n\n\u201c\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 292, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 02, \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 586,000,000 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0bb1\u0bcd \u0bb2\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bc8\u0bc6\u0bbe\u0b95\u201d \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe \u0bb5\u0bbf\u0b9f