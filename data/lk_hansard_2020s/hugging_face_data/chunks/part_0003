    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0d9a\u0ddd\u0da2\u0dba \u0dcf\u0daf\u0db1\u0daf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0db8\u0db1\u0dd2 \u0d85\u0dc0\u0dca\u200d\u0daf\u0dca\u0db1\u0daf\u0dc0\u0dca\u200d \u0da7 \u0d85\u0db4\u0dd2 \u0dc4\u0dd0\u0db8\u0dc1\u0dcf\u0d9a\u0d9a\u0dca\u0db8 -\u0db8\u0dd4\u0dcf\u0dbd\u0dca \u0daf\u0da2\u0dba \u0d87\u0db8\u0dd2\u0dbb\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0daf \u0dd4\u0dbd\u0db1-\u0dd4\u0dbd\u0db1\u0daf \u0dc1\u0dda \u0daf \u0dab\u0d9a \u0d9a\u0dd2\u0dda\u0dc0\u0dca\u200d\u0daf- \u0dc1\u0daf\u0dca \u0db4\u0daf\u0dbd\u0db1\u0d9a\u0dad\u0dca \u0d91\u0d9a\u0dca \u0db4\u0da7\u0dbd\u0dc0\u0dca\u200d\u0daf \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dca\u200d\u0daf1 \u0d92 \u0d89\u0dad\u0daf \u0d85\u0dc0\u0dca\u200d\u0daf\u0dca\u0db1\u0daf\u0dc0\u0dca\u200d\u0db1\u0dca\u0dad \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dca\u200d\u0d9a\u0d9a\u0dca1 \u0dc1\u0dda \u0dc1\u0dda \u0db8\u0dc4\u0da2\u0db1\u0dad\u0daf\u0dc0\u0dca\u200d\u0da7 \u0d87\u0dad\u0dca\u0dad \u0dcf\u0dd0\u0db1\u0d9c\u0dd0\u0dd3\u0db8\u0db8\u0da7 \u0dd2\u0dbb\u0dc1\u0db6\u0db1 \u0d85\u0dba\u0dd2\u0dd2\u0dbb\u0d9a \u0d85\u0db4 \u0db6 \u0db4\u0dad\u0dc5 \u0dc1\u0dbd\u0dca \u0d8b\u0dbd\u0dca\u0dbd\u0dcf\u0d9d\u0db1\u0d9a \u0db1\u0dc0\u0dca\u200d\u0daf1 \u0da2\u0dc1\u0dda \u0db8\u0dd4\u0dcf\u0dbd\u0dca \u0dad\u0db8\u0db1\u0dca\u0dc1\u0dda \u0db8\u0dd4\u0dcf\u0dbd\u0dca \u0dc1\u0dbd\u0dca \u0d85\u0dc0\u0dca\u200d\u0dcf\u0daf\u0dc3\u0dd2\u0dad \u0d9a\u0dd2\u0dd3\u0db8 \u0dc1\u0dda \u0d85\u0d9a \u0dc0\u0dca\u200d\u0dd0\u0d9a \u0dc3\u0dd2\u0dc0\u0dca\u200d\u0daf\u0dcf\u0d9a \u0dd4\u0dbd \u0daf \u0d89\u0dca\u0dae\u0db8\u0dad\u0dd4\u0db8\u0dcf \u0dc1\u0dc0\u0dca\u200d\u0da0\u0dca\u0da0 \u0daf \u0dab\u0d9a\u0d9a\u0dca1 \u0daf\u0da2\u0dba \u0dca\u0dda\u0db4\u0dad\u0dca \u0dc4\u0dc0\u0dd4\u0dc1\u0dbd\u0dca \u0db8\u0dcf\u0dc1 \u0ddc\u0dbd\u0dca\u0dbd \u0dd1\u0db8 \u0db4\u0dd2\u0db1\u0dca\u0db6\u0db3\u0dc0\u0dca\u200d\u0dad\u0dca \u0d85\u0db4\u0da7 \u0dc1\u0dc4\u0ddc\u0db3 \u0d89\u0dd2\u0dbb\u0dc4\u0daf\u0dca\u0d9a\u0d9a\u0dca \u0dd2\u0dbb\u0dc1\u0db6\u0db1\u0dc0\u0dca\u200d\u0daf \u0d9a\u0dd2\u0d9a\u0db1 \u0d91 \u0dad\u0db8\u0dba\u0dd2 \u0d92 \u0dcf\u0daf \u0db6\u0dc4\u0dc0\u0dca\u200d\u0dbd\u0dd2\u0db1\u0dca \u0d89\u0dca\u0dae\u0db8\u0dad\u0dd4\u0db8\u0dcf \u0dc0\u0dd4\u0dc1\u0dda1 \u0d92 \u0dc0\u0dca\u200d\u0daf \u0dc1\u0dda\u0db8 \u0da2\u0dc1\u0dda \u0dc1\u0daf\u0dca\u0dc1\u0db4\u0ddc\u0dc5 \u0dc3\u0dd2\u0db1\u0daf \u0dbd\u0daf \u0daf\u0da2\u0dba \u0db6\u0dbd\u0d9a \u0dbd\u0db6\u0daf \u0d9c\u0dd0\u0dd3\u0db8\u0dc1\u0dda \u0d9a\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dab\u0dc0\u0dca\u200d\u0dbd \u0db1\u0dd2 \u0dad\u0dc0\u0dd3\u0dc1\u0dda \u0d89\u0dd2\u0dbb\u0dc4\u0daf\u0dca\u0d9a\u0d9a\u0dd4\u0dad\u0dca \u0d85\u0db4\u0da7 \u0dd2\u0dbb\u0dc1\u0db6\u0db1\u0dc0\u0dca\u200d\u0daf1\n\n3491 3492\n\n\u0db4\u0daf\u0d9a\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0dc0\u0dca\u200d\n\n\u0dc0\u0dca\u200d\u0d9a\u0dad\u0db8\u0daf\u0db1 \u0db4 \u0dda\u0db4 \u0daf\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0daf\u0d9a\u0dcf\u0db1\u0daf \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dca\u0dae1 \u0d92 \u0d85\u0db4\u0dd2 \u0dc1\u0dad\u0dca\u0dbb\u0dd4\u0dda \u0d9c\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd11 \u0d92 \u0db1\u0dd2\u0dca\u0daf \u0dc4\u0dd0\u0db8 \u0dc1\u0dc0\u0dca\u200d\u0dbd\u0daf\u0dc0\u0dca\u200d \u0db8 \u0dc4\u0dd2\u0d9f\u0db1\u0dca\u0db1\u0daf\u0dc1\u0dda \u0dad\u0dd4\u0db8\u0dcf\u0dc0\u0dca\u200d\u0daf\u0dbd\u0d9a \u0dc1\u0db4\u0db1\u0dca\u0dc0\u0dca\u200d\u0dbd\u0daf \u0d85\u0dad \u0db4\u0daf\u0db1\u0dc0\u0dca\u200d\u0daf \u0dc0\u0dca\u200d\u0daf\u0dc1\u0dda \u0dc1\u0daf\u0dca\u0dc0\u0dca\u200d\u0dbd\u0dca \u0dc1\u0db1\u0ddc \u0dc1\u0dda \u0dc1\u0dda \u0d86\u0d9a\u0dae\u0dd2 \u0d9a \u0d91 \u0dad\u0dd0\u0db1 \u0da7 \u0d9c\u0db1\u0dca\u0db1 \u0dc4\u0dd0\u0dc1\u0db8\u0ddd\u0db8 \u0d91 \u0da7 \u0d91 \u0dad\u0dd4\u0db8\u0dcf \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd11 \u0d92 \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0dc1\u0dca\u0db4 \u0db8\u0dd4\u0dcf\u0dbd\u0dca \u0daf\u0da2\u0dba \u0d87\u0db8\u0dd2\u0dbb\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0daf \u0dca\u0daf \u0da0\u0dca\u0da1\u0daf\u0dc0\u0dca\u200d\u0da7 \u0d9c\u0dad\u0dca\u0dad \u0d85\u0dc0\u0dca\u200d\u0dca\u0daf\u0db1 \u0daf \u0dab\u0d9a \u0dc0\u0dd4\u0dc1\u0dda1 \u0dc1\u0dda \u0dc1\u0dda \u0dc1\u0dc4\u0ddc \u0db8\u0da7 \u0dc0\u0dca\u200d\u0dcf\u0da0\u0daf\u0dc0\u0dca\u200d\u0da7 \u0dc3\u0dd2\u0dad \u0dcf \u0dad\u0dd0\u0db1 \u0dd2\u0dbb\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0d92 \u0dc3\u0dd2\u0dca\u0db3\u0db1 \u0d91 \u0dcf \u0daf\u0da2\u0dba \u0db4\u0daf\u0dbd\u0db1\u0d9a \u0d9a\u0dd2\u0d9a\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0d85\u0db4\u0da7 \u0dd2\u0dbb\u0dc1\u0db6\u0db1 \u0dc1\u0dbd\u0ddc\u0d9a\u0dd4\u0db8 \u0db4\u0dca\u200d\u0dbb \u0dae\u0db1\u0d9a \u0d92 \u0dcf? \u0d85\u0db4\u0dd2 \u0d9a\u0dc4\u0db4\u0daf\u0dbd\u0db1\u0d9a\u0d9a\u0dca \u0dc1\u0d9c\u0db1\u0daf\u0dc0\u0dca\u200d\u0daf; \u0dc1\u0dc4\u0ddc\u0dbb\u0dd4 \u0d87\u0dbd\u0dca\u0dbd\u0dd4\u0dc0\u0dca\u200d\u0daf1 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d85\u0db4\u0da7 \u0da7 \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9c\u0db1\u0dca\u0db1 \u0dd4\u0dbd\u0dc5\u0dd4\u0dc0\u0dca\u200d\u0db1\u0dca \u0db8 \u0dbd\u0dd0\u0db6\u0dd4\u0dc1\u0dda \u0db1\u0dd0\u0dc4\u0dd01 \u0dc1\u0dda \u0dd2\u0dbb\u0dc1\u0db6\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dae\u0db1\u0dc0\u0dca\u200d\u0dbd\u0da7 \u0d8b\u0dad\u0dca\u0dad \u0dc1\u0dc4\u0ddc\u0d9a\u0daf \u0d9c\u0db1\u0dca\u0db1 \u0dd4\u0dbd\u0dc5\u0dd4\u0dc0\u0dca\u200d\u0db1\u0dca \u0db8 \u0dbd\u0dd0\u0db6\u0dd4\u0dc1\u0dda \u0db1\u0dd0\u0dc4\u0dd01 \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0d9a\u0ddd\u0da2\u0dba \u0dcf\u0daf\u0db1\u0daf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0db8\u0db1\u0dd2 \u0dc0\u0dca\u200d\u0dd0\u0dda \u0d91 \u0d87\u0dad\u0dd4\u0db8\u0dcf\u0dc5\u0dd4\u0dc0\u0dca\u200d \u0da2\u0dc1\u0dda \u0d86\u0dcf\u0daf\u0d9a\u0dda \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dd2 \u0d9c\u0dd0\u0dd3\u0db8\u0db8\u0da7 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0da7 \u0dc3\