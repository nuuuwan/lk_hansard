    "chunk_text": "\u0d8a\u0db8\u0d9f \u0d9a \u0dab\u0db1 \u0dc1\u0db8\u0db1\u0dba\u0dd2, \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0db1\u0ddd\u0da2\u0dca\u200d\u0dba \u0dc3\u0db7 \u0db4\u0dd2\u0dba\u0dd4\u0dbb\u0db8\u0db1\u0dd2. \u0d85\u0dc1\u0db4\u0dca \u0d85\u0dd2\u0dba\u0d9c\u0dbb\u0dd4 \u0da2\u0dca\u200d\u0dba \u0db0\u0dd2\u0db4\u0dd2\u0dba\u0dd4\u0dbb\u0db8 \u0da7 \u0d85\u0db4\u0dd2 \u0dc3\u0dda\u0dd4\u0dbb\u0dd2\u0dba\u0dc0\u0dca \u0dad \u0dc1\u0dc0\u0dba\u0dc0 . \u0d92 \u0dc3\u0dda\u0dd4\u0dbb\u0dd2\u0dba\u0dc0\u0dca \u0dad \u0dc1\u0dc0\u0dca \u0dc1\u0dca , \u0dc1\u0db8\u0da0\u0dca\u0da0 \u0d85\u0db8 \u0dbb\u0dd4 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0db1\u0d9a\u0dca, \u0db1\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf\u0db1\u0d9a\u0dca \u0dd2\u0dba\u0dc1\u0db6\u0dba \u0d85\u0dc0\u0dc3\u0dda\u0dae \u0dc1\u0dda\u0daf\u0dd3\u0dad\u0dca \u0dc1\u0db8\u0dc0 \u0d85\u0db1 \u0dc0\u0dd0\u0dc1\u0db1\u0dca \u0d85\u0db4\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0db1\u0dbd\u0dca \u0db1\u0da7\u0dd2\u0dba\u0db1\u0dba 7.3\u0d9a\u0dca \u0dbd\u0db6 \u0daf\u0dd3 \u0dd2\u0dba\u0dc1\u0db6\u0dba \u0db1\u0dd2\u0dc3 \u0dba\u0dd2.\n\n\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0db1\u0ddd\u0da2\u0dca\u200d\u0dba \u0dc3\u0db7 \u0db4\u0dd2\u0dba\u0dd4\u0dbb\u0db8\u0db1\u0dd2, \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0dc0\u0dd2\u0dc2\u0db1 \u0db4\u0dae\u0db1\u0da7 \u0d85\u0daf \u0db8\u0dc0 \u0dc0\u0dbb\u0dca\u0dad\u0db8 \u0dba\u0dc1 \u0db4\u0dc0\u0dd2\u0dba\u0dba \u0db1\u0db1\u0dad\u0dba \u0d9c\u0dd0\u0dba \u0d85\u0db4\u0dd2 \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0d9a\u0dae \u0d9a \u0dd4\u0dc0. \u0db0\u0dd3\u0dc0 \u0dc3\u0d82\u0dc3\u0dda\u0dae \u0dc0 \u0d9c\u0dad\u0dca\u0dc1\u0dad \u0dad\u0dca, \u0d91\u0db1 \u0db4 \u0dd4 \u0dbd\u0dd0\u0db6\u0dd6 \u0d89\u0dad \u0d85\u0dc0\u0daf \u0dba\u0dda \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0db1\u0d9a \u0dd2\u0dba\u0db6\u0dd4\u0dab\u0dd4 \u0db1\u0db1\u0dad\u0dba\u0db1\u0d9a\u0dca.\n\n\u0dc1\u0dda \u0db1\u0db1\u0dad\u0dba\u0db1 \u0d91\u0db8 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0db1\u0da7 \u0db4\u0dad\u0dca \u0dc0\u0dd4\u0dc1\u0dab\u0dca\u0da9 \u0db8\u0db8 \u0d89\u0dc3\u0dda\u0dc1\u0dc3\u0dbd\u0dca\u0dbd \u0d9a\u0dd2\u0dda\u0dc0 \u0dc0 \u0dc1\u0dda \u0dba\u0dd0\u0dda \u0dd2\u0dad\u0dbd\u0db4\u0dd4 \u0d9a\u0dab\u0dca\u0da9\u0da9\u0dbd \u0db1\u0db8 \u0db1\u0dd2\u0dc3 . \u0d9a\u0dd0\u0db1\u0da7\u0dba\u0da7\u0dca \u0d87\u0db8\u0dd2\u0dba\u0d9a\u0dda, \u0db1\u0dd2\u0dc1\u0db1\u0ddd\u0da2\u0dca\u200d\u0dba \u0d87\u0db8\u0dd2\u0dba\u0d9a\u0dda \u0dc3\u0dd2\u0db1\u0dbd\u0dca\u0dbd \u0d9a \u0dc1\u0d9c\u0dba \u0dc3\u0dd2\u0da7\u0dd2\u0dc1 \u0d92\u0dc1\u0d9c \u0dbd\u0dca\u0dbd\u0dca \u0dc1\u0dca . \u0d85\u0db4\u0dd2 \u0db4\u0dd0\u0dbb\u0dd0\u0daf\u0dd2\u0dd2\u0dba\u0dc0 \u0daf\u0dca \u0dba \u0d9a \u0dab\u0db1\u0d9a\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d92 \u0daf\u0dd2\u0dba\u0dc0\u0dbd \u0db0\u0dd3\u0dc0 \u0dc3\u0d82\u0dc3\u0dda\u0dae \u0dc0 \u0dc1\u0dc3\u0dda\u0dc0\u0d9a\u0db1\u0dca \u0da7 ETF, EPF \u0dc1\u0d9c\u0dc0 \u0d9c\u0dca \u0dba \u0db6\u0dd0\u0dbb\u0dd2\u0dc0 \u0dd2\u0dba\u0db6\u0dd4\u0dab\u0dd4 \u0db1\u0db1\u0dad\u0dba\u0db1\u0d9a\u0dca \u0db6\u0dc0. \u0dba\u0dd4\u0dc0\u0dad\u0dca \u0d85\u0daf \u0dc0\u0dba\u0dc0\u0dd2\u0da7 \u0dc1\u0dc3\u0dda\u0dc0\u0d9a\u0db1\u0dca \u0dc1\u0dda \u0dd4\u0db6\u0db6\u0dc3 \u0db0\u0dcf\u0dba \u0d9a\u0da7\u0dba\u0dd4\u0dd4\u0dbb \u0dc3\u0dbb \u0d92 \u0dc3\u0dd2\u0db1\u0dbd\u0dd4 \u0d85\u0dc0 \u0dba\u0dad \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0dca \u0dc1\u0db4\u0db1\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0dba \u0db8\u0da7\u0dca\u0da7\u0db8\u0d9a\u0da7 \u0d85\u0db4\u0dd2 \u0db0\u0dd3\u0dc0 \u0dc3\u0d82\u0dc3\u0dda\u0dae \u0dc0 \u0d85 \u0dc1\u0d9c\u0dba \u0d87\u0dc0\u0dd2\u0dad\u0dca \u0dd2\u0dba\u0dc1\u0db6\u0dba\u0dc0 . \u0d92 \u0dc0 \u0dc1\u0dda\u0db8 \u0dc1\u0dda \u0dc1\u0dc0\u0dba\u0dc1\u0d9a \u0da7 \u0d85\u0db4\u0dd2 \u0dc1\u0dc0\u0dc1\u0db8\u0db3 \u0dc3\u0dd0\u0dbd\u0dca \u0da2\u0dca\u200d \u0dbd\u0db1 \u0d9a\u0dca\u0dd2\u0dba\u0db8\u0dad\u0dca \u0d9a \u0dd2\u0dba\u0dc1\u0db6\u0dba\u0dc0 . \u0d91\u0db8 \u0dc1\u0dc0\u0dc1\u0db8\u0db3 \u0dc3\u0dd0\u0dbd\u0dca\u0dc0\u0dd2\u0dba\u0dca \u0dc3\u0dd2\u0db1\u0db1\u0da7 ]0\u0d9a\u0da7 \u0dc0\u0da9\u0dbd \u0dc0\u0dd0\u0da9\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dab\u0db1\u0d9a\u0dca \u0dd2\u0dba\u0db6\u0dd4\u0dc1\u0dab\u0dca\u0da9 \u0db4 \u0dd4 \u0dbd\u0db6\u0dba \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dc1 . \u0d85\u0daf \u0d92\u0dc0 \u0d9a\u0dca\u0dd2\u0dba\u0db8\u0dad\u0dca \u0d9a \u0dd2\u0dba\u0dc1\u0db6\u0dba\u0dc0 . Online \u0d9a\u0dca\u200d\u0dbb\u0db8\u0db1 \u0d94\u0dc3\u0dda\u0dc1\u0dc3\u0dda \u0db4 \u0dbb\u0dd2\u0dc1\u0db7\u0ddd\u0dd2\u0dad\u0d9a\u0db1\u0dca \u0dc1\u0dda \u0db1\u0dd2\u0dc0\u0dc3\u0da7\u0db8 \u0dc1\u0dc3\u0dda\u0dc0\u0db1 \u0dc3\u0dd0\u0db4 \u0d8b\u0db8\u0da7 \u0d85\u0db4\u0dd2 \u0dc0\u0dd0\u0da9\u0dbd \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dc0\u0db8 \u0dc3\u0d9a\u0dc3\u0dda \u0d9a \u0dd2\u0dba\u0dc1\u0db6\u0dba\u0dc0 . \u0d92 \u0dc0\u0dd2\u0db0\u0dd2\u0dc1 \u0dc0\u0dd2 \u0dbd \u0dc0\u0dd0\u0da9\u0dbd \u0dc1\u0d9a \u0da7\u0dc3\u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0dc1\u0dda \u0dc0\u0dba\u0dc0\u0dd2\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1 \u0dad\u0dca\u0db8\u0d9a \u0d9a \u0dba\u0dc0 .\n\n\u0dc3\u0dd3-\u0dc1\u0dba\u0ddd\u0dbb\u0dca \u0db1\u0db1\u0dad\u0dba\u0db1 \u0d9c\u0dd0\u0dba\u0dad\u0dca \u0dc1\u0db8\u0dad\u0dd0\u0dba\u0daf\u0dd3 \u0d9a\u0dae \u0d9a\u0db8 . \u0db8\u0da7 \u0d92\u0dc0 \u0d9c\u0dd0\u0dba \u0d9a\u0dae \u0d9a \u0dca \u0dba \u0dc1\u0dc0\u0dbd \u0dc0\u0d9a\u0dca \u0dba\u0dd0\u0dd2\u0dba \u0db1\u0dd2\u0dc3 \u0d8b\u0dad\u0dca\u0dad \u0dc1\u0daf\u0dba \u0d91\u0d9a \u0dc0\u0dd2\u0dad \u0dba\u0dd2 \u0daf\u0dd0\u0dca \u0d9a \u0dca \u0dba \u0dc1\u0dc0\u0dbd \u0dd2\u0dba\u0dc1\u0db6\u0dca \u0dc1\u0dca . \u0dc3\u0dd3-\u0dc1\u0dba\u0ddd\u0dbb\u0dca \u0db1\u0db1\u0dad\u0dba\u0db1 \u0d91\u0daf \u0db4\u0dd0\u0dc0\u0dd0\u0dd2\u0dba \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0db1\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dc1\u0db8\u0dda \u0d9a\u0dc0\u0dd4\u0daf? \u0dba\u0dd4\u0dc0\u0dad\u0dca \u0daf\u0dd0\u0dca \u0dd2\u0dad\u0dd2\u0db8\u0dbd\u0dca\u0dbd \u0db6\u0dbd\u0dca \u0dba, \u0dc3\u0dd3-\u0dc1\u0dba\u0ddd\u0dbb\u0dca \u0db1\u0db1\u0dad\u0dba\u0dc1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0db1 \u0dc1\u0d9a \u0dc1\u0dbb \u0db8\u0daf \u0d9a\u0dd2\u0db1\u0dbd . \u0d92 \u0d9a \u0dbd\u0dc1 \u0dc3\u0dd3-\u0dc1\u0dba\u0ddd\u0dbb\u0dca \u0db1\u0db1\u0dad\u0dba\u0dc1 \u0dc1\u0dc3\u0dda\u0dc0\u0d9a\u0db1\u0dca \u0da7 \u0db4\u0da9\u0dd2 \u0dc1\u0d9c\u0dc0 \u0d9c\u0dca \u0dba \u0db6\u0dd0\u0dbb\u0dd2 \u0dc0\u0dd4\u0dab . \u0d85\u0dd4 \u0d9c\u0dab\u0dc1\u0dca \u0dc1\u0db6\u0ddd\u0da7\u0dca\u0dd4\u0db8\u0dc0\u0d9a\u0dca \u0dd2\u0dba\u0db1 \u0dc1\u0dad\u0db4\u0dca\u0db4\u0db8\u0d9a\u0dca\u0dc0\u0dad\u0dca \u0dbb\u0daf \u0d9c\u0dca \u0dba \u0db6\u0dd0\u0dbb\u0dd2\u0dc0 \u0dd2\u0dba\u0db6\u0dd4\u0dab\u0dd4 \u0dc3\u0dd3-\u0dc1\u0dba\u0ddd\u0dbb\u0dca \u0db1\u0db1\u0dad\u0dba\u0db1 \u0d85\u0daf \u0dc1\u0db6 \u0dc1\u0dbb \u0db8 \u0d9a\u0dca\u0dd2\u0dba\u0db8\u0dad\u0dca \u0dc0\u0dd0\u0da9\u0dbd \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dc0\u0db8\u0d9a\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1 \u0dad\u0dca\u0db8\u0d9a \u0d9a \u0dc1\u0d9c\u0dba \u0db1\u0dba\u0dc0 . \u0d92 \u0db1\u0dd2\u0dc3 \u0dc1\u0dda\u0dc0 \u0d9c\u0dd0\u0dba \u0db4\u0dd4\u0db8 \u0dc1\u0dca \u0db4 \u0dbd\u0dba \u0db1\u0d9a\u0dbd\u0dca\u0db4\u0dc0\u0dd2\u0dba\u0dca \u0dc1\u0dad \u0dc0 \u0d87\u0dc3\u0dda \u0d87 \u0dbd \u0db1\u0dd2\u0dc0\u0dd0 \u0daf\u0dd2\u0dc0 \u0db6\u0dbd\u0dca \u0dba \u0db1\u0dba.."
