    "chunk_text": "\u0dba\u0dd0\u0db1\u0dca \u0dd0\u0dcf \u0d91\u0d9a\u0dcf\u0d9a\u0dcf\u0da7\u0dcf VAT \u0d91\u0d9a\u0dcf \u0dc0\u0dd2\u0db1\u0dca\u0dc0\u0dad. \u0dc1 \u0da7 - \u0d89\u0dd2\u0db4\u0dba\u0dad \u0dba\u0dc0\u0dc1 \u0d9a - VAT \u0d91\u0d9a\u0dcf \u0db4\u0dad \u0db1\u0dca\u0db0\u0db1\u0dc1 \u0db1\u0dca \u0db4\u0dca \u0d9a \u0dc1\u0d9a\u0dcf\u0db8\u0dca\u0db4\u0dad\u0db4\u0dad\u0d9a\u0dca \u0db4\u0dad\u0dbb\u0dca\u0db6\u0dbd\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc1\u0dda \u0db4\u0dad\u0dcf\u0dad \u0d9a\u0dcf\u0dbb \u0d9c\u0db1\u0dca\u0dca\u0dc0\u0dad. \u0d85\u0dba \u0d85\u0db4\u0dd2 \u0dc1\u0d9c\u0dad\u0daf\u0dd4 \u0dad\u0da7 \u0dca \u0dc1\u0dba\u0db1\u0dca\u0dca \u0d9a\u0dcf\u0dae\u0dad \u0d9a\u0dcf\u0dbb\u0dca\u0dc0\u0dad. \u0d85\u0dba \u0d85\u0db4\u0dd2 \u0d9a\u0dd4\u0da9\u0dad \u0dc1 \u0d9a \u0dc0\u0dad\u0dd4\u0db8 \u0dc4\u0dd2\u0db8\u0dd2 \u0dad\u0da7 \u0dca \u0dc1\u0dba\u0db1\u0dca\u0dca \u0d9a\u0dcf\u0dae\u0dad \u0d9a\u0dcf\u0dbb\u0dca\u0dc0\u0dad. \u0d85\u0dba \u0d85\u0db4\u0dd2 \u0d9a\u0dcf\u0dae\u0dad \u0d9a\u0dcf\u0dbb\u0dca\u0dc0\u0dad \u0d85\u0d9a \u0dc1\u0d9c\u0dad\u0daf\u0dd4 \u0dad\u0da7 \u0dca \u0dc1\u0dba\u0db1\u0dca\u0dca. \u0dc1 \u0da7 \u0db4\u0dca \u0d9a \u0dc1\u0d9a\u0dcf\u0db8\u0dca\u0db4\u0dad\u0db4\u0dad \u0db4\u0dad\u0dcf\u0dad \u0dc0\u0dd4\u0dab\u0dba\u0dad\u0da7 \u0db4\u0dd4\u0dc0\u0dc0 \u0dc1\u0db4\u0dad \u0dd2\u0db1 \u0dbd\u0dd4 \u0dc1\u0d9c\u0dad\u0dd3\u0db1\u0dca\u0dc1 \u0daf\u0dd4\u0daf\u0dd4\u0db0\u0db1 \u0d9a\u0dcf\u0dd8\u0dc2\u0dd2 \u0dc1 \u0dba\u0dc0\u0dd4\u0db4\u0dad\u0dc0\u0d9a\u0da7 VAT \u0d91\u0d9a\u0dcf \u0d9c \u0dca\u0dc0\u0dad. VAT\n\n3351 3352\n\n\u0db4\u0dad\u0dbb\u0dca\u0db6\u0dbd\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\n\n\u0d8a\u0dc5\u0d9f\u0da7, \u0d91\u0dc5\u0dc0\u0dbd\u0dd4 \u0dc1\u0d9c\u0dad\u0daf\u0dd4 \u0dad \u0d9c\u0dd0\u0dca \u0d9a \u0dcf\u0dcf \u0d9a\u0dcf\u0dad\u0dad \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0dca \u0d95\u0dca\u0dd1. \u0d91\u0dc5\u0dc0\u0dbd\u0dd4 \u0dc1\u0d9c\u0dad\u0daf\u0dd4 \u0dad \u0d85\u0dba \u0d85\u0db1\u0dca\u0dad\u0dd2\u0dc3\u0dcf \u0d85\u0dcf\u0dad\u0dbb\u0dd4\u0dc1\u0dda. \u0dc1\u0db4\u0dad \u0dba\u0dc0 \u0d9a\u0dc0\u0d9a \u0db8\u0dd2\u0db1\u0dd2 \u0d9a\u0dd4\u0dc0 \u0d9a\u0dcf\u0dd1 \u0d9c \u0dca\u0dc0\u0dad, \u0dc1 \u0ddd\u0dcf\u0da0\u0dd2 \u0dd2\u0dbb\u0dc1\u0d9a\u0ddd \u0d91\u0d9a\u0dcf \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 500 \u0dba\u0d9a\u0dca\u0dc0\u0dad \u0db8\u0dd2\u0d9a \u0d89 \u0dc5 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0d9a\u0dad \u0dad\u0dd2\u0dc3\u0dc1 \u0dca\u0dc0\u0dad \u0dd2\u0dbb \u0d9a\u0dad. \u0dd0 \u0dd0\u0dba\u0dd2, \u0d91\u0dc5\u0dc0\u0dbd\u0dd4 \u0dd2\u0dbb\u0dc1\u0d9a\u0ddd\u0dc0\u0d9a\u0dcf \u0db8\u0dd2\u0d9a \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 500\u0dba\u0dd2 \u0dd2\u0dbb \u0d9a\u0dad \u0d85\u0db4\u0dd2 \u0d91\u0dc5\u0dc0\u0dbd\u0dd4 \u0dc1\u0d9c\u0dad\u0daf\u0dd4 \u0dad\u0da7 \u0d9a\u0dcf\u0dd1 \u0d9c\u0dd0\u0dc4\u0dd4\u0dc0\u0dad\u0da7, \u0d91\u0dc5\u0dc0\u0dbd\u0dd4 \u0dc1\u0d9c\u0dad\u0daf\u0dd4 \u0dad\u0dc1 \u0db1\u0dd2\u0dc2\u0d9a\u0db4\u0dad\u0dba\u0dca \u0db4\u0dd2\u0dd2\u0db4\u0dc0\u0dd0 \u0db4\u0dd2\u0dc5\u0dd2 \u0db3\u0dc0 \u0d9a\u0dcf\u0dc0\u0dd4\u0dbb\u0dd4\u0dc0 \u0d9a \u0d9a\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dca\u0dd0 \u0dd0. \u0d85\u0dba \u0dc1\u0db4\u0dad \u0dc1\u0dc0\u0dca\u0dc1\u0d9a\u0dcf\u0dad\u0da7 \u0d85\u0dc1\u0dda \u0d9a\u0dd4\u0da9\u0dad \u0dc1 \u0d9a \u0dc0\u0dad\u0dd4\u0db8 \u0dc4\u0dd2\u0db8\u0dd2 \u0dad\u0da7 \u0dc1\u0dba\u0dca \u0dc1\u0db4\u0dad\u0dc1 \u0dad\u0dbb\u0dc0\u0d9a \u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd2\u0dc3\u0dc1\u0dda \u0daf\u0dd4 \u0dad\u0d9a \u0d85\u0da9\u0dd4\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0dc1 \u0dca\u0dc0\u0dad. \u0d92 \u0dc1\u0db4\u0dad\u0dc1 \u0dad\u0dbb\u0dc0\u0d9a \u0dba\u0dd6\u0dd2\u0db4 \u0dad \u0dad\u0dd2\u0dc3\u0dc1 \u0db1\u0dca\u0dca \u0d95\u0dca\u0dd1 \u0dca\u200d\u0dbb\u0dcf\u0dad\u0dab\u0dba \u0d89\u0dad\u0dad \u0d85\u0da9\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dad\u0dd2\u0dc3\u0dc1 \u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d85\u0dc1\u0dda \u0db4\u0dc5\u0dad \u0d9a\u0dc0\u0d9a \u0d9a\u0dd4\u0da9\u0dad \u0dc1 \u0d9a \u0dc0\u0dad\u0dd4\u0db8 \u0dc4\u0dd2\u0db8\u0dd2 \u0db1\u0dca\u0dc1 \u0dc1 \u0d9a \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 150\u0d9a\u0dcf, 154\u0d9a\u0dcf \u0db8\u0dd2\u0d9a\u0d9a\u0dcf\u0da7 \u0dba\u0dd0\u0db1\u0dca \u0d85\u0dc1\u0dc5\u0daf\u0dd4 \u0dc1\u0dc0\u0dca\u0dc0\u0dad. \u0dca\u0daf\u0dca \u0d9a, \u0d85 \u0d9a\u0dc0\u0dd0\u0db1\u0dca\u0dca \u0d85\u0da9\u0dd4 \u0dc1\u0dc0\u0d9a\u0dad. \u0d9a\u0dd4\u0da9\u0dad \u0dc1 \u0d9a \u0dc0\u0dad\u0dd4\u0db8 \u0dc4\u0dd2\u0db8\u0dd2\u0dc1 \u0d9a\u0dd4\u0da7 \u0dad\u0dcf\u0db1\u0dca\u0dc1 \u0dc0 \u0d9a\u0dc1 \u0d9a \u0dc0\u0dd0\u0da9 \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0dca \u0d9a\u0dd4\u0dd3 \u0dc1 \u0d9a\u0dc0\u0d9a\u0dcf\u0dc1 \u0d9a\u0dca \u0dba\u0dd0\u0db1\u0dca \u0d89 \u0d9a \u0dbb \u0dc0\u0dad\u0dc1 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 1,000\u0d9a\u0dcf\u0da7 \u0d9c\u0db1\u0dca\u0dca \u0dd0 \u0dd0. \u0d85\u0da9\u0dd4\u0dcf \u0d9c\u0dab\u0dba\u0dc1\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 2,000\u0d9a\u0dca\u0dc0 \u0d9a \u0dc1\u0dba\u0db1\u0dca\u0dca \u0d95\u0dca\u0dd1. \u0dd6\u0dbd\u0d9a\u0dad \u0dca\u0dad\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0dcf\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dd2, \u0d9a\u0dd4\u0da9\u0dad \u0dc1 \u0d9a \u0dc0\u0dad\u0dd4\u0db8 \u0dc4\u0dd2\u0db8\u0dd2 \u0dad \u0dd2\u0dbb \u0db1\u0dca\u0dc1\u0db1\u0dca \u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0d9a\u0dcf\u0dc0\u0dba\u0dad\u0dc0 \u0d9a \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0d9a\u0dcf\u0da7 \u0d91\u0dc1\u0dbb\u0dc4\u0dd2\u0dc0 \u0dca\u200d\u0dbb \u0d9a\u0dca \u0dc3\u0dad\u0dd2\u0dc3 \u0d9a\u0dcf\u0dbb\u0db4\u0dd4 \u0dc1\u0d9a\u0dcf\u0dc1\u0dca\u0d9a\u0dca \u0dc1\u0dca\u0dad\u0dc1\u0dc0\u0dba\u0dd2; \u0db4\u0dad\u0dbb\u0da7 \u0dd0 \u0dd0\u0d9a\u0dad, \u0dda\u0dda\u0dc1\u0d9d\u0ddd\u0dc2\u0dab\u0dba \u0d9a\u0dcf\u0dbb\u0d9a\u0dad, \u0dc1 \u0d9a \u0dba\u0dbd\u0dd4 \u0dc1\u0db4\u0da7\u0dca\u0da7\u0dd2 \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dd2\u0dc3 \u0d9a\u0dad \u0d91\u0dc1 \u0dcf \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dcf\u0dbb\u0db4\u0dd4 \u0dc1\u0d9a\u0dcf\u0dc1\u0dca\u0d9a\u0dca \u0dc1\u0dca\u0dad\u0dc1\u0dc0\u0dba\u0dd2. \u0d9a\u0dd4\u0da9\u0dad \u0dc1 \u0d9a \u0dc0\u0dad\u0dd4\u0db8 \u0dc4\u0dd2\u0db8\u0dd2 \u0dad \u0dd2\u0dbb \u0db1\u0dca\u0dc1\u0db1\u0dca \u0dad\u0dcf\u0db1\u0dca\u0da7 \u0dad\u0dd2\u0dc3\u0dc1 \u0dca \u0d9a\u0dd4\u0da9\u0dad \u0dc1 \u0d9a \u0dc0\u0dad\u0dd4\u0db8 \u0dca\u200d\u0dbb\u0dcf\u0dad\u0dab\u0dba \u0dc0\u0d9c\u0dad \u0d9a\u0dcf\u0dbb\u0dc1\u0d9c\u0dca, \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0da7 \u0dbb\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dca\u0dd0\u0dad\u0dd2\u0dc3\u0dc0, \u0dc1\u0dda \u0db4\u0dad\u0d9a\u0dca\u0da5 \u0db1\u0dca\u0dc1 \u0dc1\u0d9c\u0dc0\u0dbd\u0dca\u0dc0\u0d9a \u0dbb\u0dd0\u0dd2\u0dbb \u0dad \u0dc1\u0db4\u0ddd\u0db6\u0dbd\u0dc1\u0db4\u0dad \u0d89\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dca\u0dd0\u0dad\u0dd2\u0dc3\u0dc0 \u0d89\u0dad\u0dad \u0dad\u0dcf\u0d9a\u0dcf\u0dad\u0db8\u0dd3\u0dc0, \u0dbb\u0d9a\u0dc0 \u0da2\u0dd3\u0dc0 \u0d9a \u0dc0\u0dca \u0dcf\u0db1\u0dd4 \u0d9a \u0dc1 \u0d9a\u0dca. \u0dca\u0daf\u0dca \u0d9a \u0d9a\u0dcf\u0dad \u0db1\u0dd2\u0d9a\u0dcf \u0dc1\u0db4\u0dad\u0dc1 \u0dad\u0dbb \u0db7\u0dad\u0daf\u0dd4\u0dad \u0db1\u0dd2 \u0dad \u0d9a\u0dd4\u0da9\u0dad \u0dc1 \u0d9a \u0dc0\u0dad\u0dd4\u0db8 \u0dc4\u0dd2\u0db8\u0dd2 \u0dad \u0db4\u0dad\u0dd6\u0dbb\u0dca\u0dab\u0dba\u0dc1 \u0db1\u0dca\u0dcf \u0dc3\u0dba \u0dc0\u0dd0\u0db8\u0dca\u0dab\u0dba\u0dad. \u0d92 \u0dba\u0dc0 \u0d9a\u0dc0\u0d9a \u0dc0\u0dd0\u0daf\u0dd4\u0db6\u0dbd \u0d9a\u0dcf\u0dbb\u0dca\u0dcf\u0dad\u0db1\u0dca\u0dad \u0dc3\u0dcf\u0dad\u0dd2\u0dc3\u0dad\u0dd4\u0db8\u0dcf\u0dad \u0dd0\u0da7\u0dd2 \u0da7 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d9c\u0dbb\u0dd4 \u0dbb\u0dc1\u0db4\u0dad\u0dc2\u0d9a \u0db4\u0dad\u0dd2\u0dc3\u0dbb\u0dab\u0dba \u0dcf\u0dd0\u0dad\u0dd2\u0dc3\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0da7 \u0dcf\u0dcf \u0dcf\u0db1\u0dca\u0dad\u0dbb \u0d9a\u0dca \u0dc0\u0dad\u0dc1 \u0dd2\u0dbb\u0dda\u0dc0\u0dad, \"\u0d85\u0dc1\u0db1\u0dca! \u0dc3\u0dcf\u0dad\u0dd2\u0dc3\u0dad\u0dd4\u0db8\u0dcf\u0dad, \u0dc1 \u0d9a\u0dc0\u0d9a\u0da7 \u0dca\u0db4\u0dad \u0d9a\u0dcf\u0dad \u0db1\u0dd2\u0d9a\u0dcf \u0dc1\u0db4\u0dad\u0dc1 \u0dad\u0dbb"
  },
