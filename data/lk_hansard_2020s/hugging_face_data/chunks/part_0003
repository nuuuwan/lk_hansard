a\u0db1\u0d9a\u0da7 \u0d85\u0dcf\u0daf\u0dc5 \u0dc1\u0dad\u0ddc \u0dad\u0dd4\u0dbb\u0dd4 \u0dca\u0dbd \u0daf \u0d87\u0dad.\n\n(\u0d87) 1. 2023/24 \u0dca\u0db1\u0dc1\u0dda\u0daf\u0dd3 \u0dc0\u0dd3 \u0dc1\u0d9c\u0ddc\u0dc0\u0dd2\u0d9a\u0daf\u0da7 \u0dc4\u0dd2\u0db8\u0dd2, \u0daf\u0dd2\u0dc0\u0dca\u200d\u0dba\u0dd2\u0dc1\u0dca \u0dc0\u0dca\u200d \u0dc1\u0dc4\u0ddd \u0db4\u0dca\u200d\u0dbb\u0dc1\u0daf\u0dca \u0d9a \u0db4\u0dd2\u0dc4\u0dd2\u0dd2 \u0dc0\u0dd3 \u0dc0\u0dca\u200d\u0d9c\u0daf \u0db1 \u0d9a\u0dd4\u0dd4\u0dbb\u0dbb\u0dd4 \u0dc1\u0dc4\u0d9a\u0dca\u0dc1\u0da7\u0d9a\u0daf \u0d9a\u0d9a\u0dca \u0dca\u0db3\u0dc4\u0daf \u0dbb\u0dd4\u0db4\u0dd2\u0d9a\u0dbd\u0dca 15,000 \u0db1\u0dd0\u0d9c\u0dd2\u0dca \u0dc4\u0daf \u0dc1\u0dc4\u0d9a\u0dca\u0dc1\u0da7\u0d9a\u0daf 02\u0d9a\u0dca \u0dcf\u0d9a\u0dca\u0dc0\u0dca\u200d\u0daf \u0dbb\u0dd4\u0db4\u0dd2\u0d9a\u0dbd\u0dca 30,000 \u0db4\u0db4\u0dbb\u0dd2\u0dcf \u0db8\u0dd4\u0dcf\u0dbd\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0dc1\u0d9c\u0ddc\u0dc0\u0dd2\u0dc1\u0d9a\u0d9a\u0dd4\u0da7 \u0dc1\u0db4\u0ddc\u0dc1\u0dc4\u0ddc \u0dbd\u0db1\u0daf \u0d9c\u0dd0\u0db1\u0dd3\u0dcf \u0dca\u0db3\u0dc4\u0daf \u0db8\u0dd6\u0dbd\u0dba \u0dca\u0dc4\u0db1\u0daf \u0daf \u0d9a\u0d9a\u0dca \u0dc1\u0dbd\u0dca \u0dc1\u0d9c\u0ddc\u0dc0\u0dd3\u0dca\u0dc1\u0dda \u0db1\u0dd0\u0dc3\u0d9a\u0dd4 \u0d9c\u0dd2\u0dab\u0dd4\u0dca\u0db6 \u0dc1\u0dc0\u0dca\u200d\u0dad \u0db1\u0dd0 \u0d9a\u0dd2\u0dbb\u0dd3\u0dcf\u0da7 \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0db8\u0dd2\u0dca \u0dc3\u0dd2\u0dd3..\n\n2. 2023/2024 \u0dcf\u0dc4 \u0dca\u0db1\u0d9a \u0dca\u0db3\u0dc4\u0daf \u0db4\u0dd0 \u0dc2\u0dd4\u0da7\u0dca \u0dad\u0dd0\u0dd2 \u0dc1\u0db1\u0dcf\u0daf \u0dc4\u0dd0\u0dbb\u0dd3\u0dc1\u0dca\u0db6 \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dca\u0da7\u0dc4\u0db1 \u0dc1\u0dca\u0db6 \u0dc0\u0dca\u200d\u0db1 \u0dc0\u0dd2\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dad\u0dca\u0dcf \u0dba\u0dd2. \u0db4\u0dd0 \u0dc2\u0dd4\u0da7\u0dca \u0dad\u0dd0\u0dd2 \u0dbd\u0d9a\u0dca\u0dc2 32\u0d9a\u0dca \u0dc1\u0dca\u0db6 \u0dc0\u0dca\u200d\u0db1 \u0dc0\u0dd2\u0da7 \u0dc1\u0db1\u0dcf\u0daf \u0dc4\u0dbb\u0dd2\u0db8\u0dd2\u0dca \u0dc3\u0dd2\u0dd2\u0db1\u0dc0\u0dca\u200d\u0daf.\n\n3. \u0d85\u0dca\u0dae\u0dc0\u0dca\u200d\u0db1\u0dd4 \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dcf \u0dca\u0db3\u0dc4\u0daf \u0dcf\u0dd0\u0db1\u0da7 \u0db4\u0dc0\u0dca\u200d\u0dd2\u0dbb\u0db1 \u0dc3\u0dd4\u0dc5\u0dd4 \u0dc0\u0dca\u200d\u0daf\u0dbb\u0dd2\u0dcf\u0daf\u0d9a\u0d9c \u0db4\u0daf\u0dca \u0dd2\u0dbb, \u0d91\u0db1\u0dca\u0db6 \u0dc0\u0dca\u200d\u0dd0\u0dda \u0dc4\u0daf \u0d87\u0dc5 \u0dcf\u0daf\u0d9a\u0d9c, \u0dd8\u0dc2\u0dd2 \u0dcf\u0daf\u0d9a\u0d9c 3,049 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dab\u0d9a\u0d9a\u0dca \u0d85\u0dbd\u0dd4\u0dad\u0dca\u0dc0\u0dca\u200d\u0dd0\u0da9\u0dd2\u0d9a\u0daf \u0d9a\u0dd2\u0dbb\u0dd3\u0dcf.\n\n4. 2022 \u0d9a\u0dbd \u0dca\u0db1\u0d9a \u0dca\u0db3\u0dc4\u0daf \u0d9a\u0dd2\u0dc1\u0dbd\u0ddd\u0dca\u200d\u0dd1\u0dca\u0db6 50 \u0dba\u0dd6\u0dbb\u0dd2\u0d9a\u0daf \u0db8\u0dd2\u0dd2\u0d9a\u0d9a\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0d9a\u0dbd\u0dca 10,000 \u0dca\u0dc4\u0db1\u0daf \u0daf \u0db8\u0dd2\u0dbd\u0d9a\u0dca \u0d9a\u0da7\u0dc1\u0dad\u0dca \u0dc0\u0dd3 \u0dc1\u0d9c\u0ddc\u0dc0\u0dd3\u0dca \u0dc1\u0dc0\u0dca\u200d\u0dad \u0dc1\u0db1\u0dcf\u0daf\u0dc4\u0dd0\u0dbb\u0dd3\u0dcf \u0dc3\u0dd2\u0daf\u0dd4 \u0db1 \u0dbd\u0daf\u0dd3."
