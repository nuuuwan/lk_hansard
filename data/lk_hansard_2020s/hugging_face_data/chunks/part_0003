82\u0dc0\u0dbb\u0dca\u0db0\u0dcf\u0db1 \u0dc0\u0dd0\u0da9\u0dc3 \u0dc4\u0db1 - \u0db4\u0dd4\u0db1\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dad\u0db1\n\n\u0dc0\u0dd2\u0dba\u0dd9\u0dd9, \u0dd4 . 200,000,000,000; \u0db8\u0dd6\u0dbd\u0db0\u0dcf\u0db1 \u0dc0\u0dd2\u0dba\u0dd9\u0dd9,\n\n\u0dd4 . 100,000,000,000 \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 02.- \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0bcd \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd - \u0bc8\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 200,000,000,000; \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd\n\n\u0ba4\u0b9a\u0bb2\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 100,000,000,000\n\nProgramme 02.- Development Activities - Recurrent Expenditure, Rs. 200,000,000,000; Capital Expenditure,\n\nRs. 100,000,000,000 \u0d9c\u0dd4 \u0db1\u0dd3\u0dad\u0dd2\u0da5 (\u0d86 \u0dcf\u0dbb\u0dca\u0dba) \u0dc3\u0dd4\u0dc3\u0dd2\u0dbd\u0dca \u0daf\u0dda\u0dd9\u0da2\u0dba\u0db1\u0dca\u0dad \u0dd9\u0dc4\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bb0\u0bc8\u0bbf (\u0b95\u0bb2\u0bc6\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf) \u0b9a\u0bc1\u0b9a\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bae\u0bb0\u0bc8\u0b9c\u0baf\u0ba8\u0bcd\u0ba4) (The Hon. (Dr.) Susil Premajayantha, Attorney-at-Law) \u0db8\u0dbb\u0dd4 \u0d82\u0db7\u0ddc\u0db4\u0dad\u0dd2\u0dad\u0dd4 \u0dab\u0db1\u0dd2, \u0dc0\u0dd2\u0d82\u0dca\u0da2\u0dca\u200d\u0dc3 \u0db4\u0dc3\u0dad \u0dc1 \u0da7\u0dd4\u0db1\u0db4\u0dad, 2024 \u0ddc\u0dbb \u0d82\u0db7\u0ddc \u0d85\u0dc0\u0d82\u0dc0\u0dae\u0ddc\u0dc1\u0dda\u0daf\u0dd3, 240 \u0dc0\u0dc3 \u0dc0\u0dd0 \u0dc1\u0dd3\u0dca\u0dc2\u0dc1\u0dda 02 \u0dc0\u0dc3 \u0dc0\u0dd0\u0da9\u0dbd\u0d82\u0da7\u0dc4\u0dc3 \u0d82\u0db3\u0dc4\u0ddc \u0dab\u0ddc \u0d82\u0d9c\u0dc1 \u0ddd\u0dc0\u0dc3 \u0dca\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad \u0dbb\u0dc3\u0dc0\u0ddc.\n\n\u0d9c\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dd4\u0dbb\u0dd9\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba4\u0bb5\u0bbf\u0b9a\u0bc6\u0bbe\u0bb3\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Chairman) \u0ddc\u0dbb \u0d82\u0db7\u0ddc\u0dc0 \u0d91 \u0daf? \u0d9c\u0dd4 \u0dd9\u0db1\u0dca\u0dd3\u0dc0\u0dd4 (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (Hon. Members) Aye. \u0dd9\u0dd4\u0dbb \u0db4\u0dc5 \u0dc0\u0db1 \u0daf\u0dba\u0ddd\u0da2\u0db1\u0dcf\u0dc0 \u0dc3\u0db7\u0dcf \u0dc3\u0db8\u0dca\u0dd9\u0dad \u0dc0\u0dd2\u0dba: \u0ba4\u0bc0\u0bb0\u0bcd\u0bc8\u0bc6\u0bbe\u0ba9\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1: Resolved: \"11 \u0dc0\u0dc3 \u0db4\u0dd2\u0da7\u0dd4\u0dc1\u0dda, 22 \u0dc0\u0dc3 \u0dc1\u0da7\u0dd2\u0dc3\u0dc5\u0dd2 \u0dca\u0dc0\u0dad \u0dbb \u0dcf \u0dc1\u0dc0\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0d82\u0db3\u0dc4\u0dca \u0d85\u0dba\u0dd2\u0dad\u0dab \u0d86\u0dc1\u0db0 \u0dc5 \u0dd4\u0dad\u0dad\u0dd4 :\n\n'\u0dc0\u0dd0\u0da9\u0dbd\u0d82\u0da7\u0dc4\u0dc3 02\n\n\u0d82\u0d9c\u0dc0\u0dca\u0dc0\u0dc3 \u0dc0\u0dd0\u0da9\u0dbd\u0d82\u0da7\u0dc4\u0dc3 \u0dbb\u0dd4. 138,900,000,000 \u0dbb\u0dd4. 81,390,000,000\u0db1 \"\n\n[\u0db8\u0dbb\u0dd4 \u0dc3\u0dd4\u0dc3\u0dd2\u0dbd\u0dca \u0dc1\u0dda\u0dab\u0da2\u0dca\u200d \u0dca\u0dad \u0dab\u0dc4\u0dad\u0ddc]\n\n(\u0dc1\u0dab\u0dab \u0d82\u0d9c\u0dc1 \u0ddd\u0dc0\u0dc3\u0dc1\u0dda \u0d85\u0db7\u0dd2\u0db4\u0dca\u200d\u0dbb\u0ddc \u0dc0\u0db1\u0dd4\u0dc1\u0dda \u0d85 \u0dc0\u0dd0 \u0dc1 \u0ddd\u0da2\u0dca\u200d\u0dc3\u0ddc \u0d82\u0db3\u0dc4\u0ddc \u0dc1\u0dc0\u0dca \u0dc1 \u0ddc\u0da7 \u0d87\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0ddc\u0daf\u0dc3 \u0d85\u0daf\u0ddc\u0dc5 \u0dc0\u0dd0 \u0dc1\u0dd3\u0dca\u0dc2 \u0dca \u0dc1\u0dc0\u0dad \u0dab\u0ddc\u0dbb\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dab \u0d82\u0db3\u0dc4\u0ddc \u0dc0\u0dd0\n\n\u0db4\u0ddc\u0dca\u0dbd\u0dd2\u0db8\u0dc1\u0db1\u0dca\u0dad\u0dd4 \u0dc0"
