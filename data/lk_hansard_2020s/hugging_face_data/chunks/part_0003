    "chunk_text": "\u0dad\u0dbb\u0dd4 \u0dcf\u0dcf\u0db4 \u0d9a\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2, \u0dc0\u0dd2\u0dc1 \u0dc1\u0dba\u0da7 \u0db8 \u0dad\u0dcf\u0dc2\u0dab \u0db4\u0dba \u0dc0\u0dd2 \u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db1\u0db3\u0dc0\u0dad\u0dca\u0dc0, \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0 \u0dc0\u0dd2 \u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db1\u0db3\u0dc0\u0dad\u0dca\u0dc0 \u0dc0\u0dc0 \u0dc1) \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dc3 \u0dc1\u0daf\u0dca\u200d \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0dc1\u0dca \u0dc3\u0dc1 \u0dbd \u0d85\u0dc0\u0dcf\u0dad\u0dad\u0dba \u0dad\u0dd3\u0da7 \u0dd4 \u0dc3\u0dc0 \u0d86\u0dba\u0dad\u0dc0 \u0dc1\u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0dc0\u0dc0\u0dcf0 \u0dad\u0dcf\u0dc2\u0dab \u0db4\u0dba \u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0da7 \u0d85\u0db4\u0da7 \u0dc1 \u0dca\u0da0\u0dca\u0da0\u0dc3 \u0d85\u0dbd\u0dd4\u0dad\u0dca\u0dc0 \u0db4\u0dd2\u0dba\u0dc0\u0dc3\u0dc0\u0dbd\u0dba\u0dda\u0da7 \u0dba\u0da7 \u0dc0 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0da7 \u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0dc0 \u0dcf\u0db1 \u0dba \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0dc1\u0dca \u0d86\u0dbb\u0dca\u0dae\u0dd2 \u0dba, \u0d85\u0dc1\u0dca \u0dc3\u0da7 \u0dc1 \u0dca\u0da0\u0dca\u0da0\u0dc3 \u0d89 \u0dca \u0dc3\u0dc4\u0da7 \u0dc1\u0dad\u0dc0 \u0dba\u0dcf\u0dc0\u0dd2\u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd3\u0dc3\u0db4\u0dba \u0dc3\u0da7 \u0dc1\u0da7 0 \u0d85\u0db4\u0da7 \u0d85\u0dad\u0dba\u0dc0 \u0dba \u0dad\u0dd0\u0da7 \u0dc0\u0dbd\u0dba\u0dda\u0da7 \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0 \u0dc1\u0db8\u0dca\u0dc0 \u0dad\u0dc3) \u0dca\u200d\u0dbb\u0db8\u0dcf\u0db4\u0dba\u0dc2\u0dab \u0db1\u0dd2\u0dc0\u0dd0\u0dc3\u0daf\u0dd2\u0dc0 \u0dc1\u0dad\u0da7 \u0dc0\u0dcf \u0dad\u0da7 \u0dc0 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0da7 \u0dc1\u0dc0\u0dba\u0dd2\u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0dc0 \u0dcf\u0db1 \u0dba \u0db8\u0dad \u0d85\u0db4\u0dd2 \u0d85\u0dc1\u0dca \u0dc3\u0dc1 \u0dbd \u0d86\u0dbb\u0dca\u0dae\u0dd2 \u0dba \u0dc1 \u0dca\u0dad\u0dd0\u0dc0\u0da7\u0daf\u0dca\u200d \u0dc1\u0dad\u0dc0 \u0dba\u0da7 \u0dc1\u0da7 \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf \u0dad\u0dd3\u0dc3\u0db4\u0dba \u0dc3\u0da7 \u0dc0 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0da7 0 \u0d91\u0db8 \u0db1\u0dd2 \u0dcf \u0dc1) \u0d86\u0dba\u0dad\u0dc0 \u0dc1\u0daf\u0dca\u200d \u0d89\u0dad\u0dcf\u0db8 \u0dc0\u0dd0\u0daf\u0dca\u200d\u0dad\u0dad\u0dca\u0dc0 \u0d86\u0dba\u0dad\u0dc0 \u0dc1\u0daf\u0dca\u200d \u0dc2\u0dab0\n\n\u0d91 \u0dc2\u0dab \u0dad\u0db8\u0dba\u0dd2, \u0d85\u0db4\u0da7 \u0d92 \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0\u0dc0\u0dbd\u0dba\u0dda \u0dca\u200d\u0dbb\u0dcf \u0db1\u0dc0 \u0d85\u0dc0 \u0dba\u0dad\u0dcf\u0dc0 \u0d9a\u0dc1\u0db1\u0dc0\u0dc0\u0dcf0 \u0d85\u0db4\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf, \u0d85\u0dc0 \u0dca\u0dcf\u0dcf \u0d9a\u0dc1\u0db1\u0dc0\u0dc0\u0dcf0 \u0dc0\u0dd4\u0daf\u0dad\u0dca\u0dc0, \u0d92 \u0d85\u0dc0 \u0dca\u0dcf\u0dcf \u0db3\u0dad\u0dca\u0dc0\u0db4\u0dcf\u0daf\u0dca\u200d\u0dc0\u0dba \u0dc3 \u0dad\u0dd0\u0dad\u0dd2\u0db8 \u0db3\u0dc4\u0dcf \u0d85\u0db4\u0da7 \u0dca\u200d\u0dbb\u0dcf \u0db1\u0dc0\u0dba \u0dca\u200d\u0dbb\u0db8\u0dcf\u0db4\u0dc0\u0dad\u0dca\u0dc0 \u0dc0\u0dd0\u0dc4\u0dd00 \u0d92 \u0db1\u0dd2 \u0dcf \u0d85\u0dc1\u0dca \u0dca\u200d\u0dbb\u0dcf \u0db1\u0dc0 \u0d85\u0dc0 \u0dba\u0dad\u0dcf \u0db3\u0dc4\u0dcf \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0 \u0dd0\u0db3\u0dc0\u0dcf \u0dad\u0dd0\u0dad\u0dd2\u0db8\u0da7 \u0d85\u0db4\u0dd2 \u0db4\u0dc2\u0dab \u0db4\u0dcf \u0d9a\u0dba\u0dd20 \u0d92 \u0dc0\u0dcf\u0dc1 \u0db8 \u0db8\u0dc4\u0dc3 \u0dc2\u0dab\u0dc1 \u0dca\u200d\u0dbb\u0dc0\u0dbd\u0dba\u0dda \u0d85\u0db4\u0da7 \u0d85\u0dc0 \u0dba \u0dad\u0dcf\u0dc2\u0dab \u0db4\u0dba \u0dc0\u0dd0\u0dc4\u0dd00 \u0d92 \u0dad\u0dcf\u0dc2\u0dab \u0db4\u0dba \u0dd0\u0db3\u0dc0\u0dcf \u0dad\u0dd0\u0dad\u0dd2\u0db8 \u0db3\u0dc4\u0dcf \u0d85\u0db4\u0dd2 \u0dc1) \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0\u0dc0\u0dbd\u0dba\u0dda\u0da7 \u0db4\u0dc2\u0dab \u0db4\u0dcf \u0d9a\u0dba\u0dd20 \u0dc1\u0db4\u0da7\u0dca\u200d\u0dbb\u0dbd\u0dca \u0dc0\u0dd2\u0d9a\u0dd4\u0db4\u0da7 \u0dc0 \u0da0\u0dd3\u0dc0 \u0db8\u0dcf\u0dad\u0db8\u0da7 \u0dc1\u0db4\u0da7\u0dca\u200d\u0dbb\u0dbd\u0dca \u0dc1 250\u0dc2\u0dab \u0dc1\u0daf\u0dca\u200d\u0dc0\u0dc0\u0dcf0 \u0dc4\u0dd0\u0db1\u0dd0\u0dba\u0dd2, \u0db8\u0db8 \u0daf\u0dca\u200d\u0dd0\u0dc0\u0dad\u0da7 \u0dc0 \u0dd0\u0db8\u0dd0 \u0d9a\u0dba\u0dd2, \u0d92 \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0\u0dba\u0dc2\u0dab \u0daf\u0dca\u200d, \u0d85\u0db4\u0da7 \u0dca\u200d\u0dbb\u0dcf \u0db1\u0dc0\u0dba \u0db4\u0dba\u0dcf \u0dad\u0dd0\u0dad\u0dd2\u0db8\u0dc2\u0dab \u0daf\u0dca\u200d, \u0d92 \u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0da7 \u0dc3\u0dd4\u0dd4 \u0dc0\u0da7 \u0dc1\u0da7 \u0d85\u0db4\u0dd2 \u0dad\u0dcf\u0dc2\u0dab \u0db4\u0dba \u0dd0\u0db3\u0dc0\u0dcf \u0dad\u0dd0\u0dad\u0dd2\u0db8\u0dc2\u0dab \u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf0 \u0dbd\u0dd2 \u0dd4\u0daf\u0daf\u0dca\u200d\u0dbd\u0dba\u0dda\u0dcf\u0dbd\u0dd2\u0da7 \u0d92 \u0dc1\u0db4\u0da7\u0dca\u200d\u0dbb\u0dbd\u0dca \u0dc1 250 \u0dd4 \u0da7 \u0dc0\u0dcf \u0dc0), \u0d94\u0dc4\u0dd4\u0dad\u0dca\u0dc0 \u0d92 \u0dc0\u0dd0\u0dc1 \u0dc3\u0dc0\u0dc0\u0dcf0 \u0d92 \u0db1\u0dd2 \u0dcf \u0dc1)\u0dc0\u0dcf \u0d92\u0dc0\u0dcf \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0 \u0dc1\u0dc0\u0dca\u0dc1\u0dc0\u0dba\u0dd20 \u0d92 \u0dc0\u0dd2\u0dad\u0dc3\u0dc2\u0dab\n\n\u0dc1\u0dc0\u0dca\u0dc1\u0dc0\u0dba\u0dd2, \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0\u0dc0\u0dbd\u0dba\u0dda\u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0dc0\u0dd2 \u0dcf\u0dbd\u0dba\u0dda \u0dc1\u0dbd\u0dba\u0dda \u0dd0\u0dbd\u0dba\u0dda\u0d9a\u0dd2\u0dbd\u0dca\u0dbd\u0dba\u0dda\u0da7 \u0dcf\u0dcf\u0da2\u0dc0 \u0dc3\u0da7 \u0dc0 \u0d95\u0dc0\u0dd1 \u0db8 \u0d9a\u0dc1\u0db1\u0dc0\u0dc0\u0dcf, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0dc0\u0dbd\u0dd2\u0da7 \u0db6\u0dd2 \u0dca\u0dc0 \u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db3\u0dc4\u0dcf \u0d85\u0db4\u0dd2 \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0 \u0dd0\u0db3\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0dc0 \u0dcf\u0dc3\u0db4\u0dba\u0da70 \u0db8\u0dc4\u0dc3 \u0dc2\u0dab\u0dc1 \u0dca\u200d\u0dbb\u0dc0\u0dbd\u0dba\u0dda\u0da7 \u0d85\u0dc0 \u0dba\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dba\u0dda\u0dcf \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0dc0\u0dc0\u0dcf0 \u0dc4\u0dd0\u0db1\u0dd0\u0dba\u0dd2, \u0dc1 \u0dca\u0dbd\u0dba\u0dda\u0dbb\u0dca\u0dc0\u0dbd\u0dd2\u0da7 \u0dad\u0db1\u0dd4\u0dc1\u0daf\u0dca\u200d\u0db1\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db3\u0dc4\u0dcf \u0d85\u0dc0 \u0dba \u0dc0\u0dc0 \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0\u0dc0\u0dbd\u0dba\u0dda\u0da7 \u0d85\u0db4\u0dd2 \u0dc0\u0dd0\u0da9\u0dd2\u0db4\u0dd4\u0dc3 \u0dca\u200d\u0dbb\u0dd4\u0daf\u0d9b\u0dad\u0dcf\u0dc0 \u0daf\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dd20 \u0d92 \u0db1\u0dd2 \u0dcf \u0dca\u200d\u0dbb\u0dcf \u0db1\u0dc0 \u0d85\u0dc0 \u0dba\u0dad\u0dcf\u0dc0, \u0dad\u0dcf\u0dc2\u0dab \u0db4 \u0d85\u0dc0 \u0dba\u0dad\u0dcf\u0dc0 \u0dc4 \u0dc1 \u0dca\u0dbd\u0dba\u0dda\u0dbb\u0dca \u0db3\u0dad\u0dca\u0dc0\u0db4\u0dcf\u0daf\u0dca\u200d\u0dc0\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d85\u0dc3\u0dd4\u0daf\u0dab\u0dd4 \u0dc3\u0dad\u0dad\u0dca\u0dc0 \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dc0\u0dc0\u0dbd\u0dba\u0dda\u0da7 \u0d85\u0db4\u0dd2 \u0dca\u200d\u0dbb\u0dd4\u0daf\u0d9b\u0dad\u0dcf\u0dc0 \u0daf\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc0 \u0d9a\u0db6\u0dd4\u0db4\u0dcf0"
