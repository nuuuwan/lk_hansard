    "chunk_text": "\u0da2\u0dca\u200d\u0ddc\u0dad\u0dba\u0dca\u0dad\u0dbb \u0db8\u0dd6\u0d9a\u0dba \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dc1\u0dbd\u0dca \u0dc1\u0daf\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0ddc\u0dbb\u0dd2 \u0d85\u0db1\u0dd4\u0dab\u0dad\u0dd3\u0dab\u0dad \u0d82\u0dab \u0d85\u0dc1\u0da7\u0dd2\u0dc3 \u0dbb\u0da7\u0da7 \u0dc0\u0ddc\u0dc3\u0dd2 \u0db8\u0dab\u0dc3\u0ddc\u0dc0\u0dca \u0d87\u0dad\u0dd2 \u0dc1\u0dc0\u0dc3\u0dc0\u0ddc. \u0d85\u0dc1\u0da7\u0dd2\u0dc3 \u0db8\u0dd6\u0d9a\u0dba \u0dca\u0dc1\u0dc2\u0dc0\u0dad\u0dca\u200d\u0dbb \u0da7 \u0daf\u0dd0\u0dc0\u0dd0\u0dca\u0dad \u0dca\u0dad\u0dd2 \u0dca \u0d87\u0dad\u0dd2 \u0dbb\u0dc3 \u0dad\u0dd0\u0dca\u0db4\u0dad\u0dd4 \u0dbb\u0dca\u0dc2\u0dab \u0dca \u0d82\u0db3\u0dc4\u0ddc \u0dc1\u0d9a\u0ddd \u0dca\u0dd0\u0d9c\u0d9a\u0dd4\u0dc1\u0dc0\u0dca \u0d87\u0dc1\u0dab\u0dbb\u0dd2 \u0ddc\u0db1\u0dd4 \u0dc1\u0da9\u0dbd\u0ddc\u0d9a\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0db8 \u0dc3 150\u0dca \u0d85\u0db4\u0da7 \u0d9a\u0dd0\u0dc1\u0dca\u0dc3\u0dc0\u0ddc. \u0d91\u0dab\u0d9f\u0dd2\u0dca \u0dca\u0dd0\u0d9c\u0d9a\u0dd4 \u0d82\u0dc4 \u0db8\u0dd6\u0d9a\u0dba \u0dca\u0dc1\u0dc2\u0dc0\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dd2 \u0da7 \u0dc3\u0dd2 \u0dca\u0dab \u0dc3\u0dd4\u0dbb\u0dca\u0dd2\u0dad \u0dc1\u0dc0\u0dc3\u0dc0\u0ddc. \u0dcf \u0dc0\u0ddc\u0dc1\u0dda\u0dab \u0d86\u0dc3\u0dd2 \u0ddc\u0db1\u0dd4 \u0d82\u0d9c\u0dc0\u0dca\u0dc0\u0dc3 \u0dca\u0dd0\u0d9c\u0d9a\u0dd4\u0dc0, JICA \u0dc0\u0dd0\u0db1\u0dd2 \u0db8\u0dd6\u0d9a\u0dba \u0d86 \u0dad\u0dc3\u0dc0\u0dbd\u0dd2\u0db8\u0dca \u0dad\u0dc0\u0dad \u0dc0\u0dd2 \u0ddc\u0d9a \u0db8\u0dd4\u0daf\u0d9a\u0dca \u0d82\u0d9c\u0dc0\u0dca\u0dc0\u0dc3 \u200d\u0dbb\u0dd2 \u0ddc\u0dc0\u0dbd\u0dd2\u0db8 \u0d82\u0db3\u0dc4\u0ddc \u0d85\u0db4\u0da7 \u0d9a\u0dd0\u0dc1\u0dca\u0dc3\u0dc0\u0ddc. \u0dcf, \u0dca\u0dad\u0ddc \u0d85\u0da9\u0dd4 \u0dc1\u0db4\u0ddc\u0dbd\u0dd2\u0db8 \u0da7 \u0dc0\u0ddc\u0dc1\u0dda\u0dab \u0d82\u0dc4\u0dc3\u0daf\u0ddc \u0dc1 \u0ddc\u0dca\u0dc1\u0db0 \u0dc3\u0dd2 \u0dab\u0dad.\n\n\u0db4\u0ddc\u0dca\u0dbd\u0dd2\u0db8\u0dc1\u0db1\u0dca\u0dad\u0dd4 \u0dc0\n\n\u0dcf \u0dc0\u0ddc\u0dc1\u0dda\u0dab, \u0daf\u0dd0\u0dca \u0dc0\u0dd2\u0dc1\u0db0 \u0d86\u0dc1 \u0ddd\u0da2\u0dca\u200d \u0dca\u0da7 \u0db6\u0dd2 \u0dca \u0d82\u0dd0 \u0dca \u0dc3\u0dd0\u0dad\u0dd2\u0dc0 \u0d9a\u0d9c \u0ddc\u0dc1\u0dda \u0d86\u0dc1 \u0ddd\u0da2\u0dca\u200d\u0dc3 \u0dbb\u0dca\u0dc3 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca. \u0d85\u0dc1\u0da7\u0dd2\u0dc3 \u0dab \u0dc0\u0dbb \u0dbd\u0dd2\u0db8\u0db4\u0dd2 \u0daf\u0dd0\u0dca \u0dc3\u0dd0\u0dc0\u0dad\u0dad \u0da2\u0dca\u200d\u0ddc\u0dad\u0dba\u0dca\u0dad\u0dbb \u0db4\u0dd2\u0dc5\u0dd2\u0db8\u0dca\u0dc3\u0dc0\u0ddc. \u0d85\u0dc1\u0da7\u0dd2\u0dc3 \u0dc1\u0dc0\u0dc1\u0dc5\u0db3 \u0dc1\u0db4\u0ddc\u0dc5\u0da7 \u0da2\u0dca\u200d\u0ddc\u0dad\u0dba\u0dca\u0dad\u0dbb \u0db4\u0dd2\u0dc5\u0dd2\u0db8\u0dd0\u0db1\u0dd3\u0dab\u0dca \u0d9a\u0dca\u0ddc \u0db8\u0dd0\u0db1\u0dd3\u0dab\u0da7\u0dad, \u0dc0\u0da9\u0dbd\u0ddc\u0dad \u0db4\u0dc4\u0dc3\u0dd4\u0dc1\u0dc0\u0dca \u0d91 \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0dca \u0dbb \u0db8\u0dca\u0dc3\u0da7\u0dad \u0d85\u0dc0 \u0ddc \u0daf\u0dd0\u0dca \u0dc3\u0dd0\u0dc0\u0dad\u0dad \u0d8b\u0daf\u0ddc \u0dd3 \u0dad\u0dd2\u0dc1\u0dca\u0dc3\u0dc0\u0ddc. \u0dc1\u0db1 \u0d85\u0dc0\u0d82\u0dc0\u0dae\u0ddc\u0dc0\u0dbd\u0dd2\u0db8\u0dca \u0d8b\u0db4\u0dbb\u0dd2\u0dab \u0db4\u0dca\u200d\u0dbb\u0dc1 \u0ddd\u0da2\u0dca\u200d\u0dc3 \u0d9a\u0dca\u0ddc \u0db8\u0dd0\u0db1\u0dd3\u0dab\u0da7 \u0d85\u0db4 \u0dc1\u0dc0\u0dc1\u0dc4\u0dc3\u0dd2 \u0dd4\u0dad\u0dad\u0dd4 \u0dba\u0dd2.\n\n\u0dc1\u0dab\u0dad\u0dd0\u0dc3\u0daf\u0dd3 \u0dab\u0dab \u0dad\u0dc0\u0dad \u0dbb\u0dd4\u0dab\u0dca \u0d94\u0dca \u0d82\u0dd0\u0dab\u0da7 \u0dc3\u0dd2\u0dd2\u0db4\u0dad \u0dbb\u0dca\u0dc3 \u0dd0\u0dab\u0dad\u0dd2\u0dba\u0dd2. \u0dc1\u0db1 \u0da2\u0dca\u200d \u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dab \u0d85\u0db4 \u0d9a\u0dca\u0ddc \u0db8\u0dad\u0dad\u0ddc \u0d9a\u0dd2 \u0dca\u0dc1\u0dca \u0dc3\u0dd2 \u0dbd\u0dca\u0d9a \u0d82\u0dca\u0dc0 \u0d82\u0db1\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0dd4\u0dc0\u0dab\u0ddc \u0d9a\u0dd2 \u0dc3 \u0d91 \u0dc1\u0dc3\u0ddc\u0dc1\u0dc0\u0dba\u0dd2. \u0db4\u0dd6\u0dbb\u0dca\u0dab \u0d86\u0dca\u0dd2 \u0db1\u0dd2\u0daf\u0dc4\u0d82 \u0d9a\u0dca\u0dca\u0dc3 \u0d85\u0db4 \u0dad\u0dc0\u0dad \u0dc1\u0dca\u0ddc\u0dc1\u0dc4\u0ddd \u0daf\u0dd4\u0dbb \u0ddc \u0dd4\u0dad\u0dad\u0dd4 \u0dba\u0dd2. \u0dcf \u0db1\u0dd2\u0d82\u0ddc \u0dab\u0dab \u0dc1\u0db1 \u0db8\u0dbb\u0dd4 \u0d82\u0db7\u0ddc\u0dc1\u0dda \u0dc3\u0dd2\u0db8\u0dc3 \u0dc3\u0dd2 \u0dbd\u0dd4\u0dc1\u0daf\u0dc3\u0ddc\u0dc1\u0db8\u0dca \u0dc3\u0dd0\u0dc0\u0dad \u0dc3\u0dd0\u0dc0\u0dad\u0dad \u0dca\u0dbd\u0dca\u0d9a\u0ddc \u0dc3\u0dd2\u0db8\u0dca\u0dc1\u0dca \u0d85\u0db4 \u0dc1\u0db1 \u0dad\u0ddc\u0dca \u0db4\u0dd0\u0db8\u0dd2\u0d9a\u0dc0 \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0dab\u0ddc\u0dc0\u0dad \u0d9c\u0dd2\u0dbd\u0dd2\u0db8\u0dc1\u0dc4\u0dca\u0dc3\u0da7 \u0dca\u0da9\u0dbd \u0dc1\u0dc3\u0ddc\u0dc1\u0daf\u0dc3 \u0dc1\u0d9a\u0d82\u0dba\u0dd2. \u0d82\u0dab\u0dc4\u0dbb\u0dd4 \u0dae\u0ddc \u0dbb\u0dc3\u0dc0\u0ddc \u0dc0\u0dd2\u0dad\u0dbb\u0dba\u0dd2; \u0dc0\u0dd2\u0dc1\u0dda\u0da0\u0dc3 \u0dbb\u0dc3\u0dc0\u0ddc \u0dc0\u0dd2\u0dad\u0dbb\u0dba\u0dd2. \u0dc3\u0db8\u0dd4\u0dad \u0dab\u0dab \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0d9a \u0dc1\u0db4\u0dca\u0dc0\u0dd6\u0dc0\u0ddc. \u0dc1\u0d9a\u0ddd \u0dc1\u0dda\u0dad, \u0d9a\u0d9c \u0ddc\u0dc1\u0dda\u0dad \u0dca\u0dd4\u0dab\u0dad\u0dbb \u0d82\u0dc4\u0dc1 \u0ddd\u0db8 \u0d9a\u0dca\u0ddc\u0dc1\u0db8\u0dc3 \u0dbb\u0da7 \u0da2\u0dca\u200d \u0d9c\u0dca\u200d\u0dbb\u0ddc\u0dc4\u0dd3 \u0dbb \u0dab\u0ddc\u0dc0\u0dad \u0da7 \u0dc1\u0db8\u0dc3 \u0d86\u0dc0\u0ddc.\n\n\u0db8\u0dbb\u0dd4 \u0dae\u0ddc\u0dc3\u0ddc \u0dad\u0dd4 \u0dab\u0db1\u0dd2, \u0dc4\u0dca\u0dc2 \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0ddc \u0dab\u0dd0\u0dad\u0dd2\u0dad\u0dd4 \u0dab\u0ddc \u0dca\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad \u0dc5 \u0dc0\u0ddc\u0dca\u0dad\u0ddc\u0dc1\u0dda \u0d82\u0db3\u0dc4\u0dca \u0dc0\u0dd0\u0daf\u0db8\u0dad \u0dbb\u0dd4\u0dab\u0dca \u0d8b\u0db4\u0dd4\u0da7\u0ddc \u0daf\u0dca\u0dc0\u0dca\u0dc3 \u0dab\u0dab \u0dd0\u0dab\u0dd0\u0dad\u0dd2\u0dba\u0dd2. Hon. (Dr.) Harsha de Silva, your Report is getting quoted over and over again. \"2023 \u0d82\u0dd0\u0da7\u0dd2\u0dc3\u0dad\u0dd0\u0db1\u0dca\u0dca \u0dab\u0d82 \u0da2\u0dca\u200d\u0ddc\u0dad\u0dba\u0dca\u0dad\u0dbb \u0db8\u0dd6\u0d9a\u0dba \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0d9a \u0dc0\u0dd2\u0dc3\u0dd2\u0dca \u0dc0\u0dd2\u0d82\u0dc0\u0dad\u0dd3\u0dca\u0dab \u0dab \u0db4\u0dc4\u0dc3\u0dd4 \u0dab \u0db4\u0dc5\u0db8\u0dd4 \u0dc0\u0dbb\u0da7 \u0d82\u0dab\u0ddc\u0dc1\u0d9a\u0ddd\u0da0\u0dc3 \u0d9a\u0dd2\u0dbb\u0dd3\u0dab \u0d85\u0dc0\u0d82\u0ddc\u0dc3\u0dc1\u0dda\u0daf\u0dd3, \u0d86\u0dca\u0dd2 \u0d82\u0dc0\u0dae\u0ddc\u0dc0\u0dbb\u0dd3\u0dc1\u0db1 \u0d9a\u0d9a\u0dd4\u0dab\u0dd4 \u0dc1\u0db4\u0dca\u0db1\u0dd4\u0db1 \u0dc1\u0dc5\u0dc0 . \u0db1 \u0d82\u0dad\u0dd4 \u0da7\u0dd4\u0daf\u0ddc \u0dad\u0dad\u0dad\u0dc0 \u0dca \u0d87\u0dad\u0dd2 \u0dd3 \u0dad\u0dd2\u0dc1\u0dca\u0dc3 \u0dc3\u0db8\u0dd4\u0dad, \u0d82\u0dc0\u0dae\u0ddc\u0dc0\u0dbb \u0d82\u0ddc\u0dca\u0dc0 \u0d86\u0dca\u0dd2 \u0db4\u0dbb\u0dd2\u0d82\u0dbb \u0dca \u0d82\u0dc4 \u0dad\u0dd2\u0dbb\u0d82\u0dbb \u0dc4\u0ddc \u0dc3\u0dd2 \u0dbd\u0dd4 \u0d85\u0d9c\u0db8 \u0d87\u0dad\u0dd4 \u0dc5\u0dad \u0dbb \u0db8\u0dca\u0dc3\u0ddc \u0dc0\u0dca\u0dc0\u0dc3 \u0dca \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0dca \u0dad\u0dad\u0dad\u0dc0 \u0dca \u0db1\u0dd2\u0dca\u0dab\u0ddc\u0dab \u0dbb\u0ddc \u0daf\u0dd2\u0d9c\u0dd4 \u0db8\u0dab\u0dc3\u0dca \u0d87\u0dad\" \u0db1\u0dd4\u0dc1\u0dc0\u0dca \u0d91\u0dd2 \u0d82\u0db3\u0dc4\u0dca \u0dc1\u0dc0\u0dc3\u0dc0\u0ddc. \u0d94\u0dda, \u0d85\u0db4\u0da7 \u0dad\u0dc0 \u0daf\u0dd2\u0d9c\u0dd4 \u0db8\u0dab\u0dc3\u0dca \u0dca\u0dc3 \u0dad\u0dd2\u0dc1\u0dca\u0dc3\u0dc0\u0ddc. \u0dc0\u0dd0\u0dbd\u0dca \u0db4\u0ddc\u0d9a\u0dc1\u0dab\u0dca \u0d91\u0dc1\u0db8\u0ddc\u0da9\u0dbd \u0dd4\u0dc0\u0dab\u0dad \u0dc1\u0dab\u0dad\u0dd0\u0db1\u0dd2\u0dca \u0dca\u0d82\u0dc0\u0d82\u0dbb\u0dc4\u0da7 \u0dad\u0dd2\u0dc1\u0dca\u0dca\u0dc1\u0dca \u0dc0\u0d9c \u0d9c\u0dd2\u0dbb\u0dd2 \u0dca. \u0dc4\u0dbb\u0dd2 \u0db4\u0ddc\u0dc1\u0dca \u0d9c\u0dd2\u0dc1\u0dda \u0dc3\u0dd0\u0dad\u0dc3\u0db1 \u0d85\u0db4\u0dc0 \u0dc0\u0dbd\u0dca\u0dab\u0dad \u0dc1\u0dc0\u0dc3\u0dc0\u0ddc; \u0d85\u0dad\u0dbb \u0dab\u0d9c \u0dc1\u0dc0\u0dc3\u0dc0\u0ddc."
  },
