    "chunk_text": "\u0d9a\u0da7\u0dba\u0dd4\u0dd4\u0dbb \u0db1\u0da7\u0dc1\u0dad\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0db1\u0dbd\u0dca \u0db8\u0dd2\u0dad\u0dd2\u0dba\u0db1\u0dba 110\u0d9a\u0dca -\u0dbb\u0dd4\u0db4\u0dd2\u0db1\u0dbd\u0dca \u0dc1\u0d9a\u0ddd\u0da7\u0dd2 11\u0d9a\u0dca- \u0dc1\u0dc0\u0dca \u0d9a \u0dba\u0dc0 . \u0dc1\u0dda \u0dc1\u0da7\u0dca \u0da2\u0dca\u200d \u0dd2\u0dba\u0d9a \u0db1\u0dd2\u0dc2\u0dda\u0db4 \u0daf\u0dba\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf \u0dba \u0db1\u0dd2\u0db1\u0dd4\u0dc0\u0dc1\u0dc0\u0d9a\u0dca \u0dc0\u0dba \u0db0\u0dd3\u0dc0 \u0dc1\u0db1\u0d9a\u0dd4 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0dca \u0dc1\u0dc0\u0dca \u0d9a \u0dca \u0dc1\u0dca , \u0dbb\u0dd4\u0db4\u0dd2\u0db1\u0dbd\u0dca 5\u0dba\u0dd2. \u0d92\u0d9a \u0dc3 \u0db0\u0dcf \u0dab \u0dba\u0dd0\u0dbb\u0dd0; \u0dba\u0dd4\u0d9a\u0dca\u0dd2\u0dba \u0dc3\u0dbb\u0d9c\u0dad \u0dba\u0dd0\u0dbb\u0dd0. \u0d89\u0dd2\u0dba\u0dca \u0dc1\u0d9a \u0dc1\u0dbb \u0db8\u0daf \u0db0\u0dd3\u0dc0 \u0d9a\u0dbb\u0dca\u0db8 \u0dca \u0dad\u0db1 \u0dba\u0d9f \u0dc3\u0dd2\u0dd4\u0db8\u0dc0\u0dca \u0dc1\u0dca ?\n\n\u0daf\u0dd0\u0dca \u0dbb\u0dd0\u0db8 \u0dc1\u0dca\u0d9a\u0da7\u0db8 VAT \u0d91\u0d9a \u0db4\u0dba\u0dc0\u0dba\u0dc0 . IMF \u0d91\u0d9a \u0d9a\u0dd2\u0db1\u0dba \u0d9a\u0dd2\u0db1\u0dba \u0db4\u0daf\u0db1\u0da7 \u0dba\u0da7\u0db8\u0dd2\u0dad\u0dca \u0d85\u0db4\u0dd2 VAT \u0d91\u0d9a\u0dad\u0dca \u0db4\u0dd0\u0dc1\u0dba\u0dda\u0dc0 . \u0d9a\u0dd8\u0dd2 \u0db1\u0dd2\u0dc2\u0dda\u0db4 \u0daf\u0dba \u0d8b\u0db4\u0d9a \u0dab\u0dc0\u0dbd\u0da7\u0dad\u0dca VAT \u0d91\u0d9a \u0db4\u0dba\u0dc0\u0dba\u0dc0 . \u0db0\u0dd3\u0dc0 \u0d8b\u0db4\u0d9a \u0dab\u0dc0\u0dbd\u0da7\u0dad\u0dca VAT \u0d91\u0d9a \u0db4\u0dba\u0dc0\u0dba\u0dc0 . \u0db0\u0dd3\u0dc0 \u0d8b\u0db4\u0d9a \u0dab\u0dc0\u0dbd\u0da7 VAT \u0d91\u0d9a \u0db4\u0dd0\u0dc1\u0dba\u0dda\u0dc0 \u0db8, \u0dad\u0dc0 \u0dbb\u0dad \u0db4\u0dc3\u0dda \u0d9c\u0dd4\u0dab\u0db1\u0d9a\u0dd2\u0dca \u0db0\u0dd3\u0dc0 \u0db1\u0dda\u0db4\u0dca \u0dba\u0dc0\u0dbd \u0db8\u0dd2\u0dad\u0dbd \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dba\u0dc0 . \u0daf\u0dd0\u0dba\u0da7\u0db8\u0dad\u0dca \u0db0\u0dd3\u0dc0 \u0db1 \u0da7 \u0dd2\u0dba\u0dc1\u0db6\u0dba \u0dc1\u0dbd \u0d9a\u0dd4\u0db8 \u0db4\u0dca\u200d\u0dbb \u0dda\u0dba\u0db1 \u0dad\u0db8\u0dba\u0dd2, \u0d9a\u0dbb\u0dca\u0db8 \u0dca \u0dad\u0dc1 \u0dc1\u0db1\u0dc1\u0daf\u0dca \u0dba \u0db6\u0dd0\u0dbb\u0dd0. \u0dc1\u0db8 \u0d9a\u0daf, \u0dc3\u0dbd\u0dc3\u0dbd\u0dca \u0db8\u0dd2\u0dad\u0dbd \u0dc0\u0dd0\u0da9\u0dd2\u0dba\u0dd2; \u0dd6\u0db8\u0db8\u0dd2\u0dad\u0dc1\u0dad\u0dbd\u0dca \u0db8\u0dd2\u0dad\u0dbd \u0dc0\u0dd0\u0da9\u0dd2\u0dba\u0dd2; \u0db0\u0dd3\u0dc0 \u0db1\u0dda\u0db4\u0dca \u0dba\u0dc0\u0dbd \u0db8\u0dd2\u0dad\u0dbd \u0dc0\u0dd0\u0da9\u0dd2\u0dba\u0dd2; \u0d85\u0dba\u0dd2\u0dc3\u0dda \u0db8\u0dd2\u0dad\u0dbd \u0dc0\u0dd0\u0da9\u0dd2\u0dba\u0dd2. \u0dc3\u0dbd\u0dc3\u0dbd\u0dca\u0dc0\u0dbd\u0da7 \u0daf\u0dd0\u0dca VAT \u0d91\u0d9a \u0db4\u0dba\u0dc0\u0dba\u0dc0 . \u0db4\u0db8\u0dd4\u0dc0 \u0dc0\u0dad \u0dc0\u0da7 \u0dc3\u0dbd\u0dc3\u0dbd\u0dca\u0dc0\u0dbd\u0da7 VAT \u0d91\u0d9a \u0db4\u0dba\u0dc0\u0dba\u0dc0 \u0d9a\u0dd2\u0dda\u0dc0 . \u0daf\u0dd0\u0dba\u0da7\u0db8\u0dad\u0dca \u0dc3\u0dbd\u0dc3\u0dbd\u0dca \u0dbd\u0dd3\u0db8\u0da7 \u0db1\u0d9a\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0db1\u0dbd\u0dca 346\u0dba\u0dd2. \u0d87\u0db8\u0dd2\u0dba\u0dd4\u0dbb\u0db8\u0db1\u0dd2, \u0d9a\u0dbd\u0dca\u0db4\u0dba \u0d9a \u0db6\u0dbd\u0dca \u0dba. \u0d92\u0d9a\u0da7 \u0dc3\u0dd2\u0db1\u0db1\u0da7 18\u0d9a VAT \u0d91\u0d9a\u0dad\u0dca \u0d91\u0d9a\u0dd4\u0dbb \u0dc0\u0dd4\u0dab \u0db8 \u0dad\u0dc0 \u0dbb\u0dd4\u0db4\u0dd2\u0db1\u0dbd\u0dca 60\u0d9a\u0dd2\u0dca \u0dc0\u0dd2\u0dad , -\u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0d9c\u0dad\u0dca\u0dc1\u0dad \u0dad\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0db1\u0dbd\u0dca 63\u0d9a\u0dd2\u0dca - \u0dc3\u0dbd\u0dc3\u0dbd\u0dca \u0db8\u0dd2\u0dad\u0dbd \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dba\u0dc0 . \u0d91\u0dad\u0dc1\u0d9a \u0da7 \u0dd4\u0dc0\u0dc4\u0dd4\u0dd4\u0dc0 \u0dc3\u0dda\u0dc3 \u0dc1\u0dda \u0db1\u0dca \u0dba\u0db8 \u0db6\u0dd0\u0dbb\u0dd2 \u0dc0\u0dba\u0dc0 . \u0daf\u0dd0\u0dba\u0da7\u0db8\u0dad\u0dca \u0d85\u0dc1\u0db4\u0dca \u0dc1\u0da7\u0dca \u0db0\u0dd3\u0dc0 \u0d9a\u0dbb\u0dca\u0db8 \u0dca \u0dad\u0dc1 \u0dc1\u0db1\u0dc1\u0daf\u0dba \u0dc1\u0d9c \u0da9\u0dbd\u0d9a\u0dca \u0db0\u0dd3\u0dc0 \u0dc1\u0db1\u0ddd \u0dad\u0db8\u0dca \u0dc1\u0dda \u0dc1\u0db6\u0ddd\u0da7\u0dca\u0dd4\u0db8\u0dc0 \u0dc1\u0dc0 \u0dc1\u0db8\u0dda \u0d9c\u0dd0\u0da7 \u0d9c\u0dbb\u0dbd \u0dd2\u0dba\u0dc1\u0db6\u0dca \u0dc1\u0dca . \u0db6\u0dc4\u0dd4\u0daf\u0dd2\u0dba \u0db0\u0dd3\u0dc0 \u0db1 \u0dad\u0dca\u200d\u0dbb \u0dc0\u0dbd\u0da7 \u0d91\u0d9a \u0d9c\u0db8\u0dba\u0d9a\u0dca \u0dd2\u0dad\u0dd2\u0db8\u0dca \u0d91\u0dca \u0dba \u0dbd\u0d9a\u0dca\u0dc2 45\u0d9a\u0dca, 50\u0d9a\u0dca \u0db1\u0dba\u0dc0 . \u0dbb\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dc1\u0d9c\u0dc1\u0dba\u0dba \u0db8 \u0dc5\u0dd4 \u0da7\u0dd2\u0d9a \u0dc0\u0dd2\u0d9a\u0dd4\u0dab \u0d9c\u0dca \u0dba \u0dc1\u0dc0\u0dca \u0dc1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0db1\u0dbd\u0dca \u0dbd\u0d9a\u0dca\u0dc2 20\u0d9a\u0da7 \u0dc1\u0dbb\u0ddd 25\u0d9a\u0da7. \u0d89\u0dd2\u0dba\u0dca , \u0d85\u0dd2\u0dba\u0dca \u0db4 \u0dd4 \u0d9a \u0dc1\u0d9c\u0dba \u0dd4\u0dc0\u0dc4\u0dd4\u0dd4\u0dc0 \u0dc3\u0dda\u0dc3 \u0dc0 \u0d9a \u0dca \u0dc1\u0dca \u0dc1\u0db8 \u0dba \u0db0\u0dd3\u0dc0 \u0db1 \u0daf? \u0d94\u0dc0\u0dd4\u0dca \u0d9a \u0dca \u0dc1\u0dca \u0dba\u0dd0\u0dbb\u0dd0. \u0d91\u0d9a\u0dca\u0daf\u0dd2\u0dba \u0db0\u0dd3\u0dc0 \u0db1 \u0dad\u0dca\u200d\u0dbb \u0dc0\u0d9a\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0db1\u0dbd\u0dca 20,000\u0d9a\u0dca \u0dc0\u0dd2\u0dad \u0dc0\u0dd2\u0db1\u0daf\u0dda \u0dc0\u0dba\u0dc0 . \u0dbb\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dbb\u0dda\u0db6 \u0d9a \u0dca \u0dba \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0dc1\u0dc0\u0dca \u0dc1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0db1\u0dbd\u0dca 8,000\u0d9a\u0dca \u0dc1\u0dbb\u0ddd \u0dbb\u0dd4\u0db4\u0dd2\u0db1\u0dbd\u0dca 10,000\u0d9a\u0dca. \u0d91\u0dad\u0dc1\u0d9a \u0da7 \u0db7 \u0dc1\u0d9c\u0da7 \u0db7 \u0d9c\u0db1\u0d9a\u0dca \u0db4 \u0dd4\u0dba\u0dd2. \u0d89\u0dd2\u0dba\u0dca , \u0d85\u0dd2\u0dba\u0dca \u0dc0\u0dd2\u0db1\u0daf\u0dda \u0d9a \u0dc1\u0d9c\u0dba \u0db0\u0dd3\u0dc0 \u0dc3\u0dda\u0dc3 \u0dc1\u0dda \u0dc1\u0db1\u0dc1\u0daf\u0dca \u0dba \u0dad\u0dc0\u0dd4\u0dc0 \u0da7\u0dad\u0dca \u0db0\u0dd3\u0dc0 \u0dc1\u0db1\u0ddd \u0d9a\u0dd0\u0db8\u0dd2\u0dba \u0dba\u0dd0\u0dbb\u0dd0. \u0d92 \u0db1\u0dd2\u0dc3 \u0d85\u0daf \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0d9c\u0dad\u0dca\u0dc1\u0dad \u0dad\u0dca, \u0dd4\u0dc0\u0dc5\u0dd4 \u0dc1\u0da7\u0dca\u0db8 \u0db0\u0dd3\u0dc0 \u0dc1\u0db1\u0ddd \u0d91\u0db8 \u0d9a\u0dbb\u0dca\u0db8 \u0dca \u0dad\u0dc1\u0db1\u0dca \u0d88\u0dad\u0dca \u0dc0\u0dba\u0dc0 . \u0d8b\u0dd4\u0dbb\u0dc1\u0dbb\u0dca \u0db0\u0dd3\u0dc0 \u0db1 \u0dad\u0dca, \u0daf\u0d9a\u0dd4\u0dc1\u0dab\u0dca\u0da9 \u0db0\u0dd3\u0dc0 \u0db1 \u0dad\u0dca, \u0dba\u0dd0 \u0dc1\u0d9f\u0dba\u0dd2\u0db8 \u0dbb \u0db6\u0dc3\u0dda\u0dba \u0dd2\u0db8 \u0d9a\u0dd2\u0db1\u0dba \u0dc1\u0da7\u0dca \u0dbb\u0dd0\u0db8 \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca\u0db8 \u0d89\u0dca \u0dba \u0db0\u0dd3\u0dc0 \u0dc1\u0db1\u0ddd \u0d85\u0daf \u0db0\u0dd3\u0dc0 \u0dc3\u0dda\u0dc3 \u0dc0 \u0d91\u0db4 \u0dc1\u0dc0\u0dbd \u0d9a\u0dd4\u0dbd\u0dd3\u0db8 \u0dc0\u0dd0\u0da9\u0dbd\u0dc0\u0dbd\u0da7 \u0db1\u0dba \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0db1\u0da7 \u0db4\u0dad\u0dca \u0dc1\u0dc0\u0dbd \u0dd2\u0dba\u0dc1\u0db6\u0dba\u0dc0 ."
