    "chunk_text": "\u0db4\u0dd4\u0dbb\u0daf\u0dc0\u0dd2\u0dcf\u0dba\u0daf \u0dc1\u0dcf\u0db4\u0daf\u0dda\u0dad\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc1\u0dda \u0d89\u0dad\u0daf\u0db8 \u0dcf\u0d9a\u0dca\u0dc2, \u0d95\u0dc3\u0dd1 \u0db8\u0dd2\u0db1\u0dca \u0dc0\u0dca\u200d\u0dd0\u0da9 \u0dbb\u0dc3 \u0db1\u0dd2\u0dbd\u0db0\u0daf\u0dbb\u0dd2\u0db1\u0dca \u0d89\u0db1\u0dca\u0dc3\u0dc0\u0dca\u200d\u0daf. \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0db1\u0dd2\u0dad\u0dbb \u0dc0\u0dd2\u0dc1\u0dda\u0da0\u0dc3\u0d9a\u0da7 \u0db3\u0db3\u0dd4\u0db1\u0dca \u0dc0\u0dca\u200d\u0dc3 \u0db1\u0dd2\u0dca\u0daf \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dca\u0db8\u0dca\u0db3\u0db1\u0dca\u0db0\u0dc1\u0d9a\u0db1\u0dca \u0d87\u0d9c\u0dd3 \u0db8\u0d9a\u0dd4\u0dad\u0dca \u0dbb\u0db1\u0dca\u0dc3 \u0d95\u0dc3\u0dd1. \u0d89\u0dad\u0dd2\u0db1\u0dca \u0d92 \u0d9c\u0dc1\u0dda\u0dc2\u0dab\u0dc1\u0dba\u0dca\u0daf\u0dd3 \u0db8\u0db8 \u0dc1\u0db3\u0ddc\u0dc1\u0dc4\u0ddd \u0dbb\u0dd4\u0dab\u0dd4 \u0dc1\u0dca\u0ddc\u0d9a\u0daf \u0d9c\u0dad\u0dca\u0dad\u0daf. \u0d9c\u0dbb\u0dd4 \u0d85\u0db8\u0daf\u0dad\u0dba\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0db1\u0dca\u0dc1\u0dc4\u0dbd \u0dc0\u0dd2\u0dda\u0dc0\u0dca\u200d\u0dad\u0dd4\u0db1\u0dca, \u0dca\u0dc1\u0dc4\u0db8 \u0dc3\u0dd0\u0dad\u0dca\u0dc3\u0db8\u0dca \u0dc1\u0dda\u0dc1\u0dd3\u0d9a \u0dc0\u0dd2\u0dda\u0dc0\u0dca\u200d\u0dad\u0dd4\u0db1\u0dca \u0dc1\u0db8\u0dca \u0d9c\u0dd0\u0dc3 \u0d85\u0dcf\u0dc4\u0dca\u0dae \u0db4\u0dc5 \u0dc5\u0daf\u0da7 \u0db4\u0dc3\u0dd4\u0dc0\u0dca\u200d \u0dc1\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb \u0dae\u0dc3 \u0dad\u0dd2\u0dc1\u0db3\u0dc3\u0dc0\u0dca\u200d\u0daf \u0d9a\u0dd2\u0d9a\u0dbd\u0daf \u0dcf\u0dd0\u0db1\u0dca \u0dca\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0daf \u0d9a\u0dd2\u0d9a\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc4\u0dd0\u0db3\u0dd0\u0dba\u0dd2, \u0dc0\u0dca\u200d\u0dda\u0dc2 1900 \u0db4\u0db8\u0dab \u0dc0\u0dca\u200d\u0dc3 \u0dc1 \u0ddc\u0da7\u0dad\u0dca \u0dca\u0dc0\u0dca\u200d \u0da7 \u0d89\u0dc1\u0dca\u200d\u0dbb\u0dd3\u0db1\u0dca \u0d82\u0dab\u0dca\u0da9\u0dd4\u0dc1\u0dda \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0db1\u0dca\u0dc0\u0dd2\u0db1 \u0dc1\u0dca\u0dda\u0dc0\u0dca\u200d \u0d9a\u0db1\u0dca \u0dc0\u0dd2\u0db1\u0dca\u0db1\u0dca \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dc5\u0daf\u0dc1\u0dad\u0dca \u0db4\u0db8\u0dab\u0d9a\u0dca \u0dc1\u0db3\u0dde\u0dda\u0db0 \u0db1\u0dca\u0dda\u0db0\u0dca\u0dae\u0dcf\u0daf\u0dc3 100 \u0da7 \u0d82\u0dca\u0db1\u0dca\u0dc3 \u0db4\u0dca\u200d\u0dbb\u0db8\u0daf\u0dab\u0d9a\u0d9a\u0dca \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0dc0\u0dca\u200d \u0dca\u0da7\u0dc4\u0db1\u0dca \u0dbb\u0dbd\u0daf \u0dad\u0dd2\u0dc1\u0db3\u0dc3\u0dc0\u0dca\u200d\u0daf. \u0dc1\u0dda.\u0db4\u0dd3. \u0dbd\u0dd4\u0dc0\u0dd2\u0dca\u0dae, \u0dca\u0da0\u0dca.\u0dc3\u0dd3.\u0db4\u0dd3. \u0dc1\u0db3\u0db1, \u0d92 \u0dc0\u0dca\u200d\u0daf\u0dc1 \u0db8 \u0dc1\u0dc4\u0db1\u0dca\u0dbb\u0dd2 \u0db4\u0daf \u0dda \u0d82\u0daf\u0dd2 \u0dc0\u0dd2\u0dda\u0dc0\u0dca\u200d\u0dad\u0dd4\u0db1\u0dca \u0d92 \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0db4\u0dca\u200d\u0dbb \u0daf \u0dc3 \u0db4\u0dc5 \u0dbb\u0dbd\u0daf \u0dad\u0dd2\u0dc1\u0db3\u0dc3\u0dc0\u0dca\u200d\u0daf. \u0db1\u0dca\u0dc1\u0dc4\u0dbd \u0dc1\u0dc4\u0ddd \u0dc1\u0dcf\u0db8\u0dc5 \u0dc1\u0dc4\u0ddd \u0dc1\u0dc3\u0ddc\u0dc0\u0dca\u200d\u0dc3, \u0dc1\u0dda\u0dc1\u0dd3\u0d9a \u0dc1\u0dc3\u0ddc\u0dc0\u0dca\u200d\u0dc3, \u0d89\u0dc1\u0dca\u200d\u0dbb\u0dd3\u0db1\u0dca \u0da2\u0daf\u0dad\u0dd2 \u0d9a\u0db1\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0dc0\u0dd2\u0dc1\u0dda\u0dd2 \u0d9a\u0db1\u0dca \u0db4\u0dc5 \u0dbb \u0dad\u0dd2\u0dc1\u0db3\u0dc3 \u0d92 \u0db4\u0dca\u200d\u0dbb \u0daf \u0dc3 \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0d9c\u0dc1\u0dda\u0dc2\u0dab\u0d9a\u0d9a\u0dca \u0dbb\u0dbd\u0daf \u0db8\u0db8 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\n\n\u0d92 \u0dc0\u0dca\u200d\u0daf\u0dc1 \u0db8, \u0dca\u0dc4\u0dd2 \u0dca\u0d9a\u0dca \u0db4\u0dd2\u0da7\u0db4\u0dad\u0d9a\u0dca \u0db8\u0db8 \u0dc0\u0dd2\u0dc2\u0d9a\u0d9a \u0db7\u0daf\u0dbb \u0d9c\u0dbb\u0dd4 \u0d85\u0db8\u0daf\u0dad\u0dba\u0dad\u0dd4\u0db8\u0daf\u0da7\u0dad\u0dca, \u0dad\u0dc0\u0dca\u200d\u0dad\u0dca \u0db4\u0dd2\u0da7\u0db4\u0dad\u0d9a\u0dca \u0dc1\u0db8\u0dca \u0dbb\u0daf\u0da2\u0dba \u0db1\u0dd2\u0dbd\u0db0\u0daf\u0dbb\u0dd2 \u0db8\u0dd0\u0daf\u0dd2\u0dbb\u0dd2\u0dc1\u0dba\u0dca \u0db1\u0dca\u0da7\u0dd2\u0dc3 \u0db4\u0dd4\u0dbb\u0daf\u0dc0\u0dd2\u0dcf\u0dba\u0daf \u0d85\u0db0\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0dc3\u0dbb\u0daf\u0db1\u0dad\u0dd4\u0db8\u0dd2\u0d9a\u0da7\u0dad\u0dca \u0dbd\u0db3\u0daf \u0dc1\u0dcf\u0dc3\u0dc0\u0dca\u200d\u0daf. \u0d85\u0da9\u0dd4\u0db8 \u0d9c\u0dab\u0dc1\u0db1\u0dca, \u0dc1\u0db8\u0dc4\u0dd2 \u0dca \u0dc4\u0db1\u0dca\u0dc0\u0dca\u200d \u0dad\u0dd2\u0dc1\u0db3\u0dc3 \u0dc3\u0dd4\u0daf\u0dd4 \u0da2\u0daf\u0dad\u0dd2 \u0d9a\u0db1\u0dca \u0d9a\u0dd2\u0d9a\u0db4\u0dd4 \u0db4\u0dd4\u0dbb\u0daf\u0dc0\u0dd2\u0dcf\u0dba\u0daf \u0dca\u0dae\u0dcf\u0daf\u0dc3 \u0da7\u0dd2 \u0dc0\u0dca\u200d\u0dad\u0dca -\u0d8a\u0da7 \u0db4\u0dc3\u0dd4\u0dc0\u0dca\u200d \u0db4\u0dca\u200d\u0dbb \u0daf \u0dbb \u0dad\u0dd2\u0dc1\u0db3\u0dc3 \u0d92\u0dc0\u0dca\u200d\u0daf \u0dca\u0dc1\u0dbb\u0d9a\u0dca\u0dc2\u0dab\u0d9a \u0dbb\u0db1\u0dca\u0dc3 \u0db3\u0dd0\u0dbb\u0dd2 \u0dc3\u0db8\u0dca- \u0dca\u0dc1\u0dbb\u0d9a\u0dca\u0dc2\u0dab\u0d9a \u0dca \u0dc4\u0daf \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dbb\u0db1\u0dca\u0dc3 \u0d9a\u0dd2\u0d9a\u0daf \u0db8\u0db8 \u0d89\u0db1\u0dbd\u0daf \u0db1\u0dca\u0da7\u0dd2\u0dc3\u0dc0\u0dca\u200d\u0daf.\n\n\u0dc1\u0db8\u0dca \u0db1\u0dca\u0dda\u0db0\u0dca\u0dae\u0dcf\u0daf\u0dc3\u0dc0\u0dca\u200d\u0dbd\u0dd2\u0db1\u0dca, \u0d92 \u0db4\u0dd4\u0dbb\u0daf\u0dc0\u0dd2\u0dcf\u0dba\u0daf\u0dad\u0dca\u0db8 \u0d8b\u0dbb\u0dd4\u0db8\u0d9a \u0dad\u0dd2\u0dc1\u0db3\u0dc3 \u0dca\u0dae\u0dcf\u0daf\u0dc3\u0dc0\u0dca\u200d\u0dbd\u0dd2\u0db1\u0dca \u0db1\u0dca\u0d9a\u0d9a\u0da7 90\u0d9a\u0dca \u0db4\u0db8\u0dab \u0dcf\u0dd0\u0db1\u0dca \u0dc0\u0dd2\u0dc3\u0daf \u0dc1\u0dc0\u0dca\u200d\u0dbd\u0daf \u0dad\u0dd2\u0dc1\u0db3\u0dc3\u0dc0\u0dca\u200d\u0daf. \u0d92\u0dc0\u0dca\u200d\u0daf\u0dc1\u0d9a\u0db1\u0dca \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2 \u0dc0\u0dca\u200d \u0dc1\u0d9a\u0db1\u0dca \u0dca\u0dae\u0dcf\u0daf\u0dc3 \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0d9a\u0d9a\u0dca \u0d9c\u0dd0\u0dc3 \u0db8\u0daf \u0dca \u0dc4\u0db1\u0dca \u0dbb\u0db1\u0dca\u0dc3 \u0d95\u0dc3\u0dd1. \u0dca \u0d9a\u0dca \u0dad\u0db8\u0dba\u0dd2, \u0db8\u0dd4\u0dbd\u0dad\u0dd2\u0dda \u0daf\u0dd2\u0dca\u0dae\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dc1\u0dba\u0dca \u0db4\u0dd4\u0daf\u0dd4\u0d9a\u0dd4\u0da9\u0dd2\u0d89\u0dbb\u0dd2\u0dca \u0db4\u0dd4 \u0db1\u0dca\u0d9a\u0daf\u0dda \u0dc1 \u0ddd\u0dc0\u0dd2\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dc1\u0dba\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0dc3 \u0dca\u0dc1\u0d9d\u0daf\u0dbb\u0daf\u0db8 \u0dca\u0dc1\u0d9a\u0dd3\u0dda\u0dab\u0d9a, \u0dc0\u0dd2\u0dc4\u0daf\u0dbb\u0daf\u0dbb\u0daf\u0db8 \u0dca\u0dc1\u0d9a\u0dd3\u0dda\u0dab\u0d9a. \u0dca\u0dad\u0dd0\u0dc3 \u0dba\u0dd4\u0dda\u0db0 \u0dc4\u0db8\u0dd4\u0dcf\u0daf \u0dc0\u0dd4\u0dbb\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0daf. \u0d92 \u0dba\u0dd4\u0dda\u0db0 \u0dc4\u0db8\u0dd4\u0dcf\u0daf \u0dc0\u0dd4\u0dbb \u0d89\u0dc0\u0dca\u200d\u0dad\u0dca \u0dc5\u0daf\u0da7 \u0db4\u0dc3\u0dd4\u0dc0\u0dca\u200d \u0d92 \u0dca\u0dae\u0dcf\u0daf\u0dc3\u0d9a \u0dca\u0db8\u0dca\u0db4\u0dd6\u0dda\u0dab\u0dc1\u0d9a\u0db1\u0dca \u0dc0\u0dca\u200d\u0daf\u0dc1 \u0dcf\u0dd0\u0db1\u0dca \u0dc0\u0dd2\u0dc3\u0daf \u0dc1\u0dc0\u0dca\u200d\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dca\u200d\u0dad\u0dd2\u0dc3\u0dc0\u0dca\u200d\u0daf."
