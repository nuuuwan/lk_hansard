    "chunk_text": "\u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0d9a\u0db1\u0dc0\u0dca\u200d\u0daf \u0d85\u0db4\u0dd2\u0da7 \u0db6\u0daf\u0dd4 \u0d89\u0dbd\u0d9a\u0dca \u0dc0\u0dca\u200d\u0dbd\u0da7 \u0d9a\u0db1\u0dca\u0db1 \u0d85\u0db8\u0daf\u0dbb\u0dd4\u0dba\u0dd2 \u0d9a\u0dd2\u0d9a\u0dbd\u0daf1 \u0d94\u0dda \u0dc1\u0dda \u0dc0\u0dca\u200d\u0d9a \u0dc1\u0dda \u0d85\u0db4\u0dd2\u0da7 \u0db6\u0daf\u0dd4 \u0d89\u0dbd\u0d9a\u0dca \u0dc0\u0dca\u200d\u0dbd\u0da7 \u0d9a\u0db1\u0dca\u0db1 \u0d85\u0db8\u0daf\u0dbb\u0dd4\u0dba\u0dd21 \u0d85\u0db4\u0dd2 \u0dc1\u0d9a\u0dd4 \u0dc0\u0dca\u200d\u0da7 \u0d89\u0dbd\u0d9a\u0dca \u0d9a\u0d9a\u0dca \u0daf\u0dd4\u0db1\u0dca\u0db1\u0daf \u0dc1\u0db8\u0da0\u0dca\u0da0 \u0db6\u0daf\u0dd4 \u0d86\u0dcf\u0daf\u0d9a\u0db8\u0d9a\u0dca \u0dc1\u0dc4\u0ddc\u0d9a\u0dbd\u0daf \u0dc1\u0dcf\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0d9a\u0dbd\u0daf1 \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0dc1\u0dda \u0dc0\u0dca\u200d\u0d9a \u0dc1\u0dda \u0db8\u0dd0\u0dcf\u0d9a\u0dca \u0dc1\u0dc0\u0dca\u200d\u0db1 \u0dda \u0dcf\u0daf\u0dda\u0da9 1 533\u0d9a\u0dca \u0d86\u0db1\u0d9a\u0db1\u0d9a \u0d9a\u0dd2\u0dd3\u0db8 \u0db1\u0dc0\u0dca\u200d\u0dad\u0dca\u0dc0\u0dca\u200d\u0daf \u0dd2\u0dbb\u0dc1\u0db6\u0db1\u0dc0\u0dca\u200d\u0daf1 \u0dc1\u0d9a\u0dd4 \u0dc1\u0dda \u0d86\u0dcf\u0daf\u0d9a\u0db8 \u0dc1\u0db8\u0ddc \u0d9a\u0dca\u0dcf? \u0dca\u0dda\u0db4\u0dd6\u0d9a\u0dab\u0dc1\u0dda \u0dc1\u0d9a\u0dd4 \u0dc1\u0dda \u0d86\u0dcf\u0daf\u0d9a\u0db8 \u0dc4\u0dd0\u0dc1\u0dcf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d86\u0db1\u0d9a\u0db1\u0d9a \u0db1 \u0dcf\u0daf\u0dda\u0da9\u0dc0\u0dca\u200d\u0dbd\u0da7 \u0d85\u0dcf\u0daf\u0dc5 \u0db6\u0daf\u0dd4\u0dc0\u0dca\u200d\u0dbd\u0dd2\u0db1\u0dca1 \u0d85\u0db4\u0dd2 \u0dcf\u0daf\u0dda\u0da9 1 533\u0d9a\u0dca \u0d86\u0db1\u0d9a\u0db1\u0d9a \u0d9a\u0dd2\u0dd3\u0db8 \u0db1\u0dc0\u0dca\u200d\u0dad\u0dca\u0dc0\u0dca\u200d\u0dbd\u0daf \u0dc1\u0d9a\u0dd4 \u0dc0\u0dca\u200d\u0da7 \u0d9a\u0dd2\u0d9a\u0db1\u0dc0\u0dca\u200d\u0daf \u0dc1\u0db8\u0da0\u0dca\u0da0