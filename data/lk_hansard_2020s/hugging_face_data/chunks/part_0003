    "chunk_text": "\u0db6\u0dd4\u0dda\u0db0 \u0daf\u0dca\u0dc3, \u0d82\u0d9c\u0db8\u0dd2 \u0dca\u0dc4 \u0dca\u0dc1\u0dca\u0dae \u0dd8\u0dad\u0dd2 \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0db8\u0daf\u0dad\u0dba\u0daf\u0dc1 \u0dc1\u0dba\u0dca\u0dad\u0dca, \u0dca\u0dc1\u0da0\u0daf\u0dbb \u0dc4\u0daf \u0d89\u0da9\u0db8\u0dca \u0d85\u0db8\u0daf\u0dad\u0dba\u0daf\u0dc1 \u0dc1\u0dba\u0dca\u0dad\u0dca \u0dc0\u0dca\u200d\u0dd0\u0d9a \u0dc1\u0dd3\u0dda\u0dc2 \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0dc0\u0dca\u200d \u0dca \u0dcf\u0dc0\u0dca\u200d\u0dc1\u0dca\u0dda \u0dc0\u0dd2\u0dc0\u0dca\u200d\u0daf\u0dcf\u0d9a\u0da7 \u0dbd\u0d9a\u0dca\u0dc0\u0dca\u200d\u0dc3 \u0d85\u0dc0\u0dca\u200d\u0dca\u0dae\u0dcf\u0daf\u0dc1\u0dda\u0daf\u0dd3 \u0db8\u0db8 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dc1\u0d9a\u0db1\u0dca \u0dc1\u0d9a\u0ddd\u0da2\u0dc3\u0daf\u0dc0\u0dca\u200d\u0d9a\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dbb\u0db1\u0dca\u0dc3 \u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dd2. \u0db4\u0dca\u200d\u0dbb\u0db0\u0daf\u0dc3 \u0dc0\u0dca\u200d \u0dc1\u0d9a\u0db1\u0dca \u0d82\u0db1\u0dca\u0d9a\u0daf\u0dc1\u0dda \u0db0\u0dc3\u0dc0\u0dca\u200d\u0dad\u0dca\u0db8 \u0dca\u0dc1\u0da0\u0daf\u0dbb \u0dba\u0dd2\u0db1\u0dca \u0db1\u0dca\u0da7\u0dd2\u0dc3 \u0dc1\u0db3\u0dde\u0dda\u0db0 \u0dbb\u0da7\u0dc0\u0dca\u200d\u0db1\n\n2705 2706\n\n2023 \u0dc1\u0dcf\u0dca\u0dd0\u0db8\u0dca\u0db3\u0dda 06\n\n\u0dad\u0dd2\u0dc1\u0db3\u0dc3\u0dc0\u0dca\u200d\u0daf. \u0d85\u0dc1\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0dca\u0dc1\u0da0\u0daf\u0dbb \u0dc0\u0dca\u200d\u0dba\u0daf\u0db4\u0daf\u0dbb\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dda\u0db0\u0dc3\u0d9a \u0dbb\u0db1\u0dca\u0dc3 \u0dc3\u0db8\u0dca, Buddhist trail \u0dca \u0d9a\u0dca \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0dc0\u0dca\u200d \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dd2 \u0d85\u0dc0\u0dca\u200d\u0db0\u0daf\u0dc3\u0d9a\u0d9a\u0dca \u0dc1\u0d9a\u0ddc\u0db8\u0dd4 \u0dbb\u0db1\u0dca\u0dc3 \u0d95\u0dc3\u0dd1. \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dc1\u0d9a\u0db1\u0dca\u0db8 \u0dc1 \u0ddc\u0dbb\u0dd2\u0d9a\u0daf\u0dc0\u0dca\u200d, \u0da2\u0db4\u0daf\u0dc3\u0d9a, \u0dad\u0daf\u0dba\u0dd2\u0dbd\u0db1\u0dca\u0dad\u0d9a \u0dc0\u0dca\u200d\u0daf\u0dc1 \u0dc1\u0db3\u0dde\u0dda\u0db0 \u0dbb\u0da7\u0dc0\u0dca\u200d\u0dbd\u0dd2\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dc1 \u0daf\u0dc0\u0dca\u200d\u0da7 \u0dca\u0dc1\u0da0\u0daf\u0dbb \u0dba\u0dd2\u0db1\u0dca \u0dc1\u0d9c\u0db1\u0dca\u0dc0\u0dca\u200d\u0daf \u0d9c\u0db1\u0dca\u0dc3, \u0d92 \u0dc0\u0dca\u200d\u0daf\u0dc1 \u0db8 \u0dc1\u0db3\u0dde\u0dda\u0db0 \u0db1\u0dca\u0dda\u0db0\u0dca\u0dae\u0dcf\u0daf\u0dc3 \u0dc3\u0dd0\u0dbb\u0db9\u0dd3\u0db8\u0da7 Buddhist trail \u0dca \u0d9a\u0dca \u0dc4\u0dcf\u0db1\u0dca\u0dc3 \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc1\u0dc5\u0ddc\u0dad\u0dca \u0dc0\u0dca\u200d\u0da9\u0daf \u0dc0\u0dca\u200d\u0dd0\u0dcf\u0d9c\u0dad\u0dca \u0dc1\u0dc0\u0dca\u200d\u0dc3\u0dc0\u0dca\u200d\u0daf. \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dc1\u0d9a\u0db1\u0dca\u0db8 \u0d85\u0dc1\u0dca \u0d82\u0db1\u0dca\u0d9a\u0daf\u0db1\u0dd4 \u0dbd\u0daf\u0db4\u0dc1\u0dba\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0dc3 \u0dc1 \u0ddc\u0dbb\u0dd2\u0d9a\u0daf\u0dc0\u0dca\u200d \u0d9c\u0dc1\u0dad\u0dca \u0dad\u0ddc\u0dad\u0dca, \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dcf\u0dd0\u0dc0\u0dca\u200d\u0dd0\u0db1\u0dca\u0dad \u0db8\u0dd4\u0dcf\u0dbd\u0d9a\u0dca \u0db1\u0dd2\u0dc0\u0dca\u200d\u0daf\u0da9\u0dd4 \u0dca \u0dc4\u0daf \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dca \u0dbb\u0dbd\u0daf \u0dbb\u0da7\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0da7 \u0d9a\u0dc3\u0dc0\u0dca\u200d\u0daf. \u0dca\u0dad\u0dc1 \u0ddc\u0da7 \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dc1\u0db3\u0ddc\u0dc1\u0dc4\u0ddd\u0daf\u0dd4\u0dbb\u0da7 \u0d9a\u0dc1\u0db1\u0dca \u0db1\u0dca \u0dad\u0daf\u0dba\u0dd2\u0dbd\u0db1\u0dca\u0dad\u0d9a \u0dc0\u0dca\u200d\u0daf\u0dc1 \u0dbb\u0da7\u0dc0\u0dca\u200d\u0dbd\u0da7. \u0dbd\u0dc1 \u0daf\u0dc0\u0dca\u200d\u0da7 \u0dca\u0dc3 \u0dca\u0dc1\u0d9b\u0dca\u200d\u0dba\u0daf\u0dc0\u0dca\u200d \u0dc1\u0d9c\u0ddc\u0da9\u0d9a\u0dca \u0d85\u0da9\u0dd4\u0dba\u0dd2. \u0d92 \u0db1\u0dd2\u0dca\u0daf \u0d92 \u0d9c\u0dd0\u0dc3 \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dd2 \u0d85\u0dc0\u0dca\u200d\u0db0\u0daf\u0dc3\u0d9a\u0d9a\u0dca \u0dc1\u0d9a\u0ddc\u0db8\u0dd4 \u0dbb\u0db1\u0dca\u0dc3 \u0d95\u0dc3\u0dd1. \u0d92 \u0dca \u0dc4\u0daf \u0d85\u0db4\u0dd2 \u0dca\u0dc1\u0da0\u0daf\u0dbb \u0dc0\u0dca\u200d\u0dba\u0daf\u0db4\u0daf\u0dbb\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dda\u0db0\u0dc3\u0d9a \u0dbb\u0db1\u0dca\u0dc3 \u0d95\u0dc3\u0dd1. \u0d92 \u0dca \u0dc4\u0daf \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dc1\u0d9a\u0db1\u0dca\u0db8 \u0dc1\u0db3\u0dde\u0dda\u0db0 \u0dca\u0dc1\u0dca\u0dae \u0dd8\u0dad\u0dd2\u0d9a \u0db8\u0dd4\u0db1 \u0dbb\u0dc1\u0d9c\u0dc3 campaign \u0dca \u0d9a\u0dca \u0dbb\u0db1\u0dca\u0dc3 \u0d95\u0dc3\u0dd1.\n\n\u0dca\u0db8\u0dca\u0dae\u0dad\u0d9a\u0d9a\u0dca \u0dc0\u0dca\u200d \u0dc1\u0d9a\u0db1\u0dca, \u0d85\u0dc1\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0dca\u0dc1\u0da0\u0daf\u0dbb \u0dc0\u0dca\u200d\u0dba\u0daf\u0db4\u0daf\u0dbb\u0d9a \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0dbb\u0db1\u0dca\u0dc3 \u0dcf\u0dd0\u0dc0\u0dca\u200d\u0dd0\u0db1\u0dca\u0dad campaign \u0dca \u0d9a\u0dca \u0d85\u0dad\u0dba\u0dc0\u0dca\u200d \u0dba\u0dba\u0dd2. \u0d9c\u0dbb\u0dd4 \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d94\u0db3\u0dad\u0dd4\u0db8\u0daf \u0dca\u0d9a \u0d82\u0dbb\u0db8\u0dca\u0db7 \u0dbb\u0dbd\u0daf \u0dad\u0dd2\u0dc1\u0db3\u0dc3\u0dc0\u0dca\u200d\u0daf. \u0d92 \u0dad\u0dc0\u0dca\u200d\u0dad\u0dca \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0dbb\u0db1\u0dca\u0dc3 \u0d94\u0db3\u0dad\u0dd4\u0db8\u0daf\u0dc1 \u0d85\u0dc0\u0dca\u200d\u0db0\u0daf\u0dc3\u0d9a \u0dc1\u0d9a\u0ddc\u0db8\u0dd4 \u0dbb\u0db1\u0dca\u0dc3. \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dc1\u0d9a\u0db1\u0dca\u0db8 \u0d85\u0db4\u0da7 \u0dad\u0dd2\u0dc1\u0db3\u0dc3 \u0dad\u0dbb\u0d9c \u0daf\u0dbb\u0dd3 \u0dbb\u0da7\u0dc0\u0dca\u200d\u0db1 \u0dc0\u0dca\u200d\u0dc3 \u0db8\u0dbd\u0d9a\u0daf\u0db1\u0dca\u0d9a\u0daf\u0dc0\u0dca\u200d, \u0d89\u0db1\u0dca\u0daf\u0dd2\u0d9a\u0daf\u0dc0\u0dca\u200d, \u0dc0\u0dd2\u0d9a\u0da7\u0dca\u0dc3\u0daf\u0db8\u0d9a \u0dc0\u0dca\u200d\u0daf\u0dc1 \u0dbb\u0da7\u0dc0\u0dca\u200d\u0db1 \u0dca\u0d9a\u0dca \u0dad\u0dbb\u0d9c \u0dbb\u0db1\u0dca\u0dc3 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca\u200d\u0db1\u0dca, destination \u0dca \u0d9a\u0dca \u0dbb \u0d9c\u0db1\u0dca\u0dc3, \u0d92 campaign \u0dca \u0db1\u0dca\u0daf\u0dd4 \u0dbb\u0db1\u0dca\u0dc3 \u0d9a\u0dd2\u0d9a\u0daf \u0d89\u0db1\u0dbd\u0daf \u0db1\u0dca\u0da7\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0db8\u0db8 \u0db1\u0dd2\u0dc4\u0dac \u0dc1\u0dc0\u0dca\u200d\u0dc3\u0dc0\u0dca\u200d\u0daf."
  },
