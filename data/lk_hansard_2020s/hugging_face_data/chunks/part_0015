\u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0d9c\u0dc0\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca\u0daf \u0d9c\u0dc0\u0db1\u0db8 \u0db4\u0db1\u0dad\u0d9a\u0dd2\u0db1\u0dca\u0daf.\n\n2 \u0dc3\u0dc4 3 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0dbd\u0db6\u0dcf \u0dd3 \u0db8\u0db4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9c\u0dad\u0dcf\u0dba\u0dad\u0dd4\u0dbb\u0dd4 \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0daf\u0db1 \u0d85\u0dc0 \u0dba \u0d9c\u0dc0\u0db1\u0dc0\u0dcf, \u0d86\u0dba\u0dad\u0db1 \u0d9c\u0daf\u0d9a [ \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0daf\u0db0\u0d9c\u0dba\u0db1\u0dd4\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1\u0dba \u0d9c\u0d9c\u0dcf\u0db1\u0dd4 \u0d9a\u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0db1\u0dd2\u0dc3\u0dcf. \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dc0\u0dad\u0dca \u0d9a\u0dcf\u0dbd\u0dba [ \u0dbd\u0db6\u0dcf\u0d9c\u0d9c\u0db1 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0d9c \u0dd3 \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0daf\u0dd3\u0dad\u0dd4\u0db8\u0dcf\u0db4 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0dbd\u0db6\u0dcf \u0dd3 \u0db8\u0db4 \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dba\u0db1\u0dc0\u0dcf."
