0dbd\u0dd2\n\n\u0db4\u0dbb\u0dd2\u0db8\u0db7\u0ddd\u0da2\u0db1\u0dba\n\n4. \u0dc0\u0dad\u0dca\u0d9a\u0dda i. \u0dc0\u0dcf\u0dc3\u0dba \u0d9a\u0dd4\u0db1 \u0dc3\u0dd2\u0dc0\u0dcf\u0dc3 \u0dc4\u0dcf \u0d89\u0db3\u0db8 \u0db4\u0dc0\u0dd4\u0db8\u0dbd\u0dca\n\n\u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a\u0db8\u0dba\u0dbb\u0dd4\u0da7 \u0dc4\u0dd2\u0db8\u0dd2 \u0dc0\u0dd3 \u0db8\u0db1\u0ddc\u0dad\u0dd2\u0db6\u0dd3\u0db8\n\nii. \u0db4\u0dc0\u0dd4\u0db8\u0dbd\u0dca \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a\u0db8\u0dba\u0dbb\u0dd4\u0da7 \u0db8\u0dc0\u0db1\u0dad\u0dca \u0dc3\u0dd2\u0dc0\u0dc3\u0d9a \u0db8\u0dc4\u0ddd \u0db8\u0d9c\u0ddc\u0db3\u0db1\u0dd0\u0d9c\u0dd2\u0dbd\u0dca\u0dbd\u0d9a \u0dc3\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0dc2\u0dab \u0dad\u0dd2\u0db6\u0dd3\u0db8\n\niii. \u0db4\u0dc0\u0dd4\u0dbd\u0da7 \u0dc3\u0dc0\u0db8 \u0dc0\u0dba\u0db8\u0dba\u0db1\u0dca \u0dc3\u0dc2\u0dab\u0d9a\u0dd4 0.5\u0d9a\n\n\u0dc0\u0d9c\u0dcf \u0d9a\u0dc5 \u0dc4\u0dd0\u0d9a\u0dd2 \u0db8\u0d9c\u0ddc\u0db3 \u0d89\u0db3\u0db8\u0dc2\u0dab \u0db8\u0db1\u0ddc\u0dad\u0dd2\u0db6\u0dd3\u0db8\n\niv. \u0db4\u0dc0\u0dd4\u0dbd\u0da7 \u0dc3\u0dc0\u0db8 \u0dc0\u0dba\u0db8\u0dba\u0db1\u0dca \u0dc3\u0dc2\u0dab\u0d9a\u0dd4 1\u0d9a\n\n\u0dc0\u0d9c\u0dcf \u0d9a\u0dc5 \u0dc4\u0dd0\u0d9a\u0dd2 \u0dbb\u0dd4\u0dd4\u0d9a\u0dbb\u0dd4 \u0d89\u0db3\u0db8\u0dc2\u0dab \u0db8\u0db1\u0ddc\u0dad\u0dd2\u0db6\u0dd3\u0db8\n\nv. \u0d9c\u0db8\u0db1\u0dcf\u0d9c\u0db8\u0db1\u0dba\u0da7 \u0dc3\u0daf\u0dcf\u0dc5 \u0d91\u0dc2\u0dab \u0dc0\u0dad\u0dca\u0d9a\u0db8\u0dc2\u0dab\u0dc0\u0dad\u0dca \u0db8\u0db1\u0ddc\u0dad\u0dd2\u0db6\u0dd3\u0db8 (\u0db8\u0db8\u0ddd \u0da7\u0dbb\u0dca \u0dc3\u0dba\u0dd2\u0d9a\u0dbd\u0dca cc 125, \u0dad\u0dca\u200d\u0dbb\u0dd2\u0db8\u0dd4\u0ddd\u0daf \u0dd4\u0dae\u0dba\u0dc2\u0dab \u0db8\u0db8\u0ddd\u0da7\u0dbb\u0dca \u0dd4\u0dae\u0dba\u0dc2\u0dab \u0dc0\u0dd1\u0db1\u0dca \u0dd4\u0dae\u0dba\u0dc2\u0dab \u0da2\u0dd3\u0dda \u0dd4\u0dae\u0dba\u0dc2\u0dab \u0db6\u0dc3\u0dba\u0dc2\u0dab \u0db8\u0dbd\u0ddc\u0dbb\u0dd2 \