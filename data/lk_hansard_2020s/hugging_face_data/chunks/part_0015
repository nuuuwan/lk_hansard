bb5\u0bbf\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd \u0ba8\u0bbf\u0bb0\u0bae\u0bcd\u0baa\u0bbf\n\n\u0bb5\u0bb4\u0bbf\u0baf\u0bc1\u0bae\u0bcd\u0b95\u0baa\u0bc6\u0bbe\u0ba4\u0bc1 \u0bb5\u0bc6\u0bbe\u0bb5\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0bc6\u0bbe\u0ba4\u0bc1\u0b95\u0bc6\u0bbe\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0b95\u0ba4\u0bb5\u0bc1\u0b95\u0bb3\u0bcd \u0ba4\u0bbf\u0bb1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9. \u0b87\u0ba4\u0ba9\u0bcd\u0b95\u0baa\u0bc6\u0bbe\u0ba4\u0bc1 \u0bc8\u0ba4\u0b95\u0bc1\u0b95\u0bb3\u0bcd \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0ba4\u0bb5\u0bc1\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bb5\u0bb4\u0bbf\u0baf\u0bc6\u0bbe\u0b95 \u0ba4\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0baf\u0bc6\u0bbe\u0b9f\u0bc1\u0bae\u0bcd \u0bc8\u0bc0\u0ba9\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0bb2\u0b95 40% \u0b8e\u0ba9 \u0bc8\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. \u0b87\u0bb5\u0bcd\u0bb5\u0bc6\u0bbe\u0bb1\u0bc1 \u0ba4\u0bb5\u0bb3\u0bbf\u0b95\u0baf\u0bb1\u0bc1\u0bb5\u0bb2\u0ba4\u0ba4\u0bcd \u0ba4\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bb5\u0bc6\u0bbe\u0ba9\u0bcd\u0b95\u0ba4\u0bb5\u0bc1\u0b95\u0bb3\u0bcd \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bc8\u0ba4\u0b95\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb0\u0bc1\u0b95\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0bb5\u0bc6\u0bbe\u0bb5\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bc0\u0bb0\u0bcd \u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0bb5\u0bb4\u0bbf\u0ba4\u0bcd\u0ba4\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0ba4\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bc1 \u0bb5\u0bb2\u0bb2\u0b95\u0bb2\u0bb3\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0baa\u0bc6\u0bbe\u0ba4\u0bc1\u0b95\u0bc6\u0bbe\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bc8\u0bbf\u0b9f\u0baa\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. (\u0b87\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b92\u0bb0\u0bc1 \u0bb5\u0bc6\u0bbe\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0ba3\u0bcd\u0ba3\u0bb3\u0bb5\u0bc6\u0bbe\u0b95 700,000 \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd \u0bb5\u0bb2\u0bb0 \u0ba4\u0b9a\u0bb2\u0bb5\u0bc6\u0bbe\u0b95\u0bc1\u0ba4\u0bc8\u0ba9 \u0bc8\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. \u0b87\u0ba8\u0bcd\u0ba4\u0ba4\u0bcd \u0ba4\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bc1 \u0bb5\u0bb2\u0bb2\u0b95\u0bb2\u0bb3 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0bc1\u0bb5\u0ba4\u0ba9\u0bcd\u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0b87\u0bb4\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0bc8\u0bc0\u0ba9\u0bcd \u0b85\u0bb1\u0bc1\u0bb5\u0bb2\u0b9f\u0baf\u0bbf\u0bb2\u0bcd \u0b95\u0ba3\u0bbf\u0b9a\u0bc8\u0bc6\u0bbe\u0ba9 \u0b85\u0bb3\u0bb2\u0bb5\u0b9a\u0bcd \u0b95\u0b9a\u0bc8\u0bbf\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bae\u0bcd)\n\n\u0d9c\u0dbb\u0dd4 \u0dc0\u0dad\u0d9a\u0dca \u0dbb\u0dca \u0d85\u0db4\u0dca\u0db4\u0dd4\u0dad\u0dcf\u0dd2\u0dba \u0db8\u0dcf\u0dad\u0dad\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba4\u0bb9\u0b95\u0bcd\u0b9f\u0bb0\u0bcd \u0b85\u0baa\u0bcd\u0baa\u0bc1\u0bb9\u0bc6\u0bbe\u0bc8\u0bbf) (The Hon. Hector Appuhamy) \u0d9c\u0dbb\u0dd4 \u0d87\u0db8\u0dad\u0dd2\u0db4\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dc4\u0dca \u0d89\u0dad\u0dd2\u0db4\u0dbb\u0dd2 \u0dc4\u0dda\u0ddc\u0dd4\u0dc3 \u0dc3\u0dcf\u0ddc\u0d9c\u0dad \u0dda\u0dbb\u0db1\u0dca\u0db1. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0ddc \u0db8\u0db8 \u0d85\u0dd9\u0dbd\u0ddc \u0db1\u0dd0\u0dad\u0dd2\u0db4 \u0dc4\u0d9c\u0ddc\u0da9\u0d9a\u0dca\u0d9a\u0dba \u0dda\u0ddc\u0dbb\u0daf\u0ddc \u0d9c\u0dd0\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0ddc\u0dc4\u0d9c\u0db1 \u0dba\u0db1\u0dc0\u0ddc. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0ddc \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dc4\u0dca \u0d89\u0dad\u0dd2\u0db4\u0dbb\u0dd2 \u0dc4\u0dda\u0ddc\u0dd4\u0dc3 \u0dc3\u0dcf\u0ddc\u0d9c\u0dad \u0dda\u0dbb\u0db1\u0dca\u0db1 \u0db8\u0db8 \u0d92\u0dda \u0d85\u0db0\u0dba\u0dba\u0db1\u0dba \u0dda\u0dbb\u0db1\u0dca\u0db1\u0db8\u0dca.\n\n\u0d9c\u0dbb\u0dd4 \u0dbb\u0dcf\u0db8\u0dcf\u0dad\u0dbd\u0dd2\u0d82\u0d9c\u0db8\u0dca \u0da0\u0db1\u0dca\u0dbb\u0dc0\u0dc3\u0dca\u0d9a\u0dbb\u0dca \u0db8\u0dcf\u0dad\u0dad\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0bb0\u0bc6\u0bbe\u0bc8\u0bb2\u0bbf\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0b95\u0b9a\u0b95\u0bb0\u0bcd) (The Hon. Ramalingam Chandrasekar) \u0d9c\u0dbb\u0dd4 \u0dda \u0ddc\u0db1\u0ddc\u0dba\u0dda\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dc4\u0dca \u0d89\u0dad\u0dd2\u0db4\u0dbb\u0dd2 \u0dc4\u0dda\u0ddc\u0dd4\u0dc3 \u0db8\u0db8 \u0dc3\u0db7\u0dcf\u0d9c\u0dad* \u0dda\u0dbb\u0db1\u0dc0\u0ddc.\n\n* \u0dc3\u0db7\u0dcf\u0dc0\u0db8\u0dca\u0dc3\u0dba \u0db8\u0dcf\u0dad\u0dad \u0dad\u0db6\u0db1 \u0dbd\u0daf \u0dd2\u0dc5\u0dd2\u0dad\u0dad\u0dd4\u0db8\u0dc0\u0dbb\u0dca \u0db1\u0dad\u0dd2\u0da5\u0dbb\u0dd2 \u0dc0\u0d9a\u0dcf \u0dc3 * \u0b9a\u0baa\u0bc6\u0bbe\u0baa\u0bc0\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bb2\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0bb2\u0b9f\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf: * Rest of the Answer tabled:\n\n\uf0b7 \u0bb5\u0bc6\u0bbe\u0bb5\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bc8\u0bc0\u0ba9\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0bb2\u0b95\u0bb2\u0baf \u0b85\u0ba4\u0bbf\u0b95\u0bc6\u0bbe\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bc8\u0bc0\u0ba9\u0bcd"
