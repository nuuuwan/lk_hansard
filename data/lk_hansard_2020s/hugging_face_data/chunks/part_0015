u0b95\u0bc1\u0bae\u0bcd \u0b95\u0ba8\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0b9f\u0ba9\u0bcd, 2021, 2022, 2023 \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 2024\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0b95\u0bb1\u0bcd\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0ba9\u0bcd\u0ba9\u0bc6\u0bbe\u0bb3\u0bcd \u0bc8\u0bc0\u0ba9\u0bcd\u0baa\u0bbf\u0b9f\u0bbf\u0baa\u0bcd \u0baa\u0b9f\u0b95\u0bc1\u0b95\u0bb3\u0bcd, \u0b95\u0baa\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0b85\u0b9f\u0bbf\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bb3\u0bcd \u0b95\u0baa\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1 \u0bc8\u0bc0\u0ba9\u0bcd\u0b95\u0bb2\u0bb3 \u0b92\u0ba9\u0bcd\u0bb1\u0bc1\u0b95\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0ba4\u0baa\u0bc6\u0bbe\u0bb1\u0bbf\u0b95\u0bb3\u0bcd \u0ba4\u0baa\u0bb0\u0bc1\u0bc8\u0bb3\u0bb5\u0bc1 \u0b9a\u0bc2\u0bb4\u0bb2\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0bc6\u0bbe\u0ba4\u0bbf\u0baa\u0bcd\u0bb2\u0baa \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd \u0ba4\u0bc6\u0bbe\u0ba4\u0bc1 \u0b95\u0ba4\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0ba4\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0bb2\u0b95 \u0b85\u0b9f\u0bbf\u0bae\u0bc2\u0bb2\u0b95\u0bcd\u0b95\u0bc2\u0bb1\u0bc1\u0b95\u0bb3\u0bc6\u0bbe\u0b95\u0ba4\u0bcd \u0ba4\u0bc6\u0bbe\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba9. \u0b87\u0ba8\u0bcd\u0ba4 \u0bb5\u0bb0\u0bc1\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0ba4\u0b95\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bb2, \u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0b95\u0bc6\u0bbe\u0ba3\u0bc8\u0bb2\u0bb2, \u0ba4\u0b95\u0bc6\u0bbe\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1 \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1 \u0b86\u0b95\u0bbf\u0baf \u0bc8\u0bc6\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b95\u0ba4\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0ba4\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0bbf\u0bb0\u0b95\u0ba4\u0b9a\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0b9a\u0bcd \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0bb2\u0b95 \u0b85\u0b9f\u0bbf\u0bae\u0bc2\u0bb2\u0b95\u0bcd\u0b95\u0bc2\u0bb1\u0bc1\u0b95\u0bb2\u0bb3 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0bb2\u0b95\u0b95\u0bb3\u0bcd \u0b95\u0bc8\u0bb1\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0bb0\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9.\n\n\uf0b7 \u0b86\u0bb4\u0bcd\u0b95\u0b9f\u0bb2\u0bbf\u0bb2\u0bcd \u0bc8\u0bbf\u0b95 \u0b86\u0bb4\u0bc8\u0bc6\u0bbe\u0ba9 \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0ba8\u0bc0\u0bb3\u0bcd\u0ba4\u0bc2\u0ba3\u0bcd\u0b9f\u0bb2\u0bcd \u0bae\u0bc1\u0bb2\u0bb1\u0bb2\u0baf\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf, \uf091\u0b85\u0bb8\u0bcd\u0ba4\u0b95\u0b9f\u0bbf \u0ba4\u0b95\u0bb2\u0bb5\u0bb2\u0bcd\u0bb2\u0ba9\u0bcd\uf091 \u0bc8\u0bc0\u0ba9\u0bcd \u0b85\u0bb1\u0bc1\u0bb5\u0bb2\u0b9f\u0b95\u0bcd \u0b95\u0bc6\u0bbe\u0ba9 \u0bae\u0bc1\u0ba9\u0bcd\u0b95\u0ba9\u0bc6\u0bbe\u0b9f\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b89\u0bb2\u0b95 \u0b89\u0ba3\u0bb5\u0bc1 \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0bb5\u0b9a\u0bc6\u0bbe\u0baf \u0b85\u0bb2\u0bc8\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd\u0ba8\u0bc1\u0b9f\u0bcd\u0baa \u0b89\u0ba4\u0bb5\u0bbf\u0baf\u0bc1\u0b9f\u0ba9\u0bcd \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0bb0\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b87\u0ba8\u0bcd\u0ba4 \u0bb5\u0bb0\u0bc1\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0bae\u0bc1\u0ba9\u0bcd\u0b95\u0ba9\u0bc6\u0bbe\u0b9f\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.\n\n\uf0b7 \u0b87\u0bb2\u0b99\u0bcd\u0bb2\u0b95\u0baf\u0bbf\u0bb2\u0bcd \u0b95\u0b9f\u0ba9\u0bc0\u0b95\u0bb0\u0bc6\u0bbe\u0bbf\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0bc8\u0bc0\u0ba9\u0bcd \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd\n\n\u0b87\u0bb1\u0bc6\u0bbe\u0bb2\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0ba4\u0bcd\u0ba4\u0ba4\u0bc6\u0bbe\u0bb2\u0b95\u0bb2\u0baf \u0b85\u0ba4\u0bbf\u0b95\u0bc6\u0bbe\u0bbf\u0baa\u0bcd \u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b95\u0ba4\u0b9a\u0bbf\u0baf \u0ba8\u0bc0\u0bb0\u0bcd\u0bb5\u0bc6\u0bbe\u0bb4\u0bcd \u0b89\u0baf\u0bbf\u0bc6\u0bbe\u0bbf\u0ba9 \u0bb5\u0bb3\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bc1 \u0b85\u0ba4\u0bbf\u0b95\u0bc6\u0bbe\u0bb0\u0b9a\u0bb2\u0baa\u0baf\u0bc1\u0bae\u0bcd \u0b95\u0ba4\u0b9a\u0bbf\u0baf \u0ba8\u0bc0\u0bb0\u0bcd\u0bb5\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b86\u0baf\u0bcd\u0bb5\u0bc1 \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0bae\u0bc1\u0b95\u0bb5\u0bb0\u0bc6\u0bbe\u0ba3\u0bcd\u0bb2\u0bc8\n\n\u0bb5\u0bb0\u0bc1\u0b9f\u0bae\u0bcd \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd \u0bc8\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd\n\n\u0b85\u0ba4\u0bc8. \u0ba4\u0b9f\u0bc6\u0bbe\u0bb2\u0bb0\u0bcd \u0bc8\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd\n\n2015 30,729.0 226.1\n\n2016 35,172.0 241.6\n\n2017 33,969.0 222.8\n\n2018 32,726.4 201.3\n\n2019 38,952.4 217.9\n\n2020 35,504.3 191.4\n\n2021 25,080.0 126.1\n\n2022 21,664.2 70.3\n\n2023 26,733.7 82.2\n\n2024 36,671.7 121.6\n\n2025 \u0b9a\u0ba9\u0bb5\u0bc6\u0bbe\u0bbf - \u0bc8\u0bc6\u0bbe\u0bb0\u0bcd\u0b9a\u0bcd\n\n8