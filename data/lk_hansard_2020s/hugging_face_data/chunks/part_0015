    "chunk_text": "2025 \u0da2\u0dd6\u0dd2 09\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dcf \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0dcf\u0da7 \u0d9a\u0dd0\u0db1\u0da9\u0dcf\u0dc0\u0dc0 \u0dc1\u0db8 [\u0dc3\u0dd2\u0dc1\u0d9a\u0ddd\u0dc0\u0dc0 \u0da0\u0dd3\u0db1\u0dba \u0dc3\u0dc4 \u0d87\u0dc1\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0dc1 \u0dc1\u0da9\u0dcf\u0db1\u0dbd\u0dca\u0dca \u0da7\u0dca\u200d\u0dbb\u0db8\u0dca\u0dda \u0d85\u0dad\u0dba \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1 \u0d85\u0dad\u0dbb\u0dd2\u0db1\u0dca \u0dba\u0da7\u0dc0\u0dbd\u0dca \u0dc1\u0daf\u0d9a\u0d9a \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1 \u0dd2\u0db0\u0dc3 \u0dc1\u0db3\u0db1\u0dc0\u0dcf. \u0d92 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1 \u0daf\u0dd0\u0db1\u0dca \u0db6\u0dd2\u0db8\u0dca \u0dc1\u0db6\u0ddd\u0db8\u0dca\u0db6\u0dba [ \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0d85\u0db4\u0da7 \u0dad\u0db8\u0dba\u0dd2 \u0d87\u0dd2\u0db0\u0dbd\u0dca\u0dcf\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1\u0db8\u0dca \u0dc1\u0d9a\u0da7\u0dd2 \u0d9a\u0dcf\u0dcf\u0dba \u0dad\u0dd4 \u0d85\u0db4\u0dd2 \u0d9c\u0dd2\u0dd2\u0db0\u0dc3\u0dd4\u0db8\u0dca\u0d9c\u0dad \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba [ \u0d87\u0dad\u0dd2 \u0d9a\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0d9a\u0dcf\u0dc1\u0dc4\u0dcf\u0db8\u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dc4\u0dd0\u0db8\u0dc1\u0daf\u0db1\u0dcf\u0dc1\u0dda\u0db8 \u0db8\u0db1\u0dc1\u0dc3\u0dda \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d92\u0d9a\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dba\u0db1\u0dc0\u0dcf \u0dc0\u0dcf\u0dc1\u0dda\u0db8\u0dc0 \u0d85\u0db4\u0dd2 \u0dc1\u0d9a\u0dcf\u0dc1\u0dc4\u0dcf\u0db8\u0daf \u0d85\u0dc1\u0dda \u0dba\u0dc1\u0da7\u0dca\u0da7 \u0d85\u0db4\u0db1\u0dba\u0db1\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dba\u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0