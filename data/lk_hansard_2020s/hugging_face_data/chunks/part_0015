9a\u0dd4/ \u0dca\u0dc1\u0dba\u0ddd\u0db1\u0d9a\u0dc1\u0dba\u0d9a\u0dd4 \u0dc1\u0dc3\u0dcf\u0dba\u0dcf \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0dcf\u0d82\u0d9a\u0dcf \u0dca\u200d\u0db1\u0dd2\u0db1 \u0dc1\u0dad\u0dbd\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0d9c\u0dad \u0dc3\u0d82\u0dc3\u0dda\u0dae\u0dcf\u0dc0 \u0dba\u0da7\u0dc1\u0dad\u0dca \u0d91\u0db8 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dad\u0dd2\u0dba \u0da2 \u0d87\u0dad. \u0d92 \u0d85\u0db1\u0dd4\u0dc0\u0dc0 202].02.09 \u0daf\u0dd2\u0db1 \u0dda [\u0dad \u0d9a\u0dbb\u0dd4\u0dd4 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dcf \u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dad\u0dd2\u0dba \u0dcf\u0db6\u0dcf \u0da2 \u0d87\u0dad. \u0d91\u0db8 \u0d85\u0db8\u0dcf\u0dad\u0dba \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dcf \u0dad\u0dd3\u0dba\u0da7\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0dc3\u0db4\u0dd4\u0d9c\u0dc3\u0dda\u0d9a\u0db1\u0dca\u0daf \u0dc1\u0dad\u0dbd\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0db4\u0dc4\u0daf\u0dd4\u0dc0 \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0db7\u0dd2\u0dcf\u0dcf\u0dc2\u0dca\u0da8 \u0d9a\u0dd0\u0db3\u0dc0\u0dd3\u0dc1\u0db8\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc1\u0db8\u0dca \u0dc0\u0db1 \u0dd2\u0db0\u0da7 \u0dcf\u0d82\u0d9a\u0dcf \u0dca\u200d\u0db1\u0dd2\u0db1 \u0dc1\u0dad\u0dbd\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0d9c\u0dad \u0dc3\u0d82\u0dc3\u0dda\u0dae\u0dcf\u0dc0 \u0db8\u0dd2\u0db1\u0db1\u0dca \u0dca\u0dba\u0db8\u0dca \u0d9a\u0dba \u0d87\u0dad. \u0d8a\u0da7 \u0d85\u0daf\u0dcf \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0 - PC - \u0dc4\u0dcf \u0d85\u0db8\u0dcf\u0dad\u0dba \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba \u0dd2\u0db0\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dba\u0db1\u0dd4 \u0dcf\u0db6\u0db1 \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da0\u0da1\u0dcf \u0dc3\u0db8\u0dca\u0dd4\u0dab\u0dad\u0dd2 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0 - CANC - \u0daf\u0dd0\u0db1\u0da7\u0db8\u0dad\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dba \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dba\u0dc0 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0dd2\u0daf\u0dd2\u0dbb\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc1\u0d9a\u0dc1\u0dba\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd3. \u0dc1\u0db8\u0dca \u0db8\u0dc3 \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dba \u0dc0\u0db1 \u0dd2\u0db0\u0da7 \u0d91\u0dba \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dd2\u0db0\u0dd2\u0db8\u0db0 \u0d9a\u0dba \u0d85\u0dc0 \u0dba \u0dc1\u0dba\u0ddd\u0db1\u0db1\u0dcf \u0dcf\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad\u0dba\u0dd2.\n\n(\u0d87) \u0d85\u0daf\u0dcf \u0dc1\u0db1\u0dcf\u0dc1 .\n\n\u0d9c\u0dd4 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0da2\u0dba\u0dc0\u0d9a\u0dcf\u0da9\u0dd2 \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0b9c\u0baf\u0ba4\u0b95\u0bbe\u0b9f\u0bbf) (The Hon. Kumara Jayakody) \u0d92\u0d9a \u0db1\u0db8\u0dca \u0dc1\u0dc0\u0db1\u0db8 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1\u0dba [ \u0dd2\u0db0\u0db0\u0dd2\u0dba\u0da7 \u0d87\u0dc4\u0dd4\u0dc1\u0dc0\u0dcf\u0dad\u0dca \u0dc1\u0dc4\u0dcf\u0db3\u0dba\u0dd2. \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2 \u0dad \u0dd2\u0db0\u0db0\u0dd2\u0dba\u0da7 \u0d9c\u0dad\u0dca\u0dad\u0dcf\u0db8 \u0d91\u0dad\u0dd0\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dd2\u0dcf [\u0d9a\u0db8\u0dca \u0daf\u0dad\u0dca\u0dad. \u0d91\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2 \u0dad \u0db1\u0dd2\u0dc0\u0dd0\u0dba\u0daf\u0dd2\u0dc0 \u0db8\u0da7 \u0daf\u0dd0\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0. \u0d92 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0db8 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1\u0dba [ \u0dc1\u0dba\u0dcf\u0dd4\u0dab \u0d9a\u0dc1 \u0dcf\u0dad\u0dca \u0dda\u0dad\u0dca\u0dad\u0dba \u0dcf\u0db6\u0dcf \u0dc1\u0daf\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca.\n\n\u0d9c\u0dd4 \u0dd2\u0dbb\u0dcf\u0d82 \u0db1 \u0dc0\u0db1\u0dbd\u0dca \u0db1\u0dca \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b95\u0bbf\u0b99\u0bcd\u0bb8\u0bcd \u0ba4\u0ba8\u0bb2\u0bcd\u0b9a\u0ba9\u0bcd) (The Hon. Kins Nelson) \u0d9a\u0db8 [ \u0db1\u0dd0\u0dc4\u0dd0. \u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2\u0dc0 \u0db8\u0dc1\u0dda \u0dc1\u0daf\u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1\u0dba \u0dc1\u0db8\u0dba\u0dba\u0dd2."
