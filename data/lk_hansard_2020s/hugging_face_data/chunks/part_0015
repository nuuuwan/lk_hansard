ca? \u0d91\u0dad\u0dc1\u0d9a\u0dcf\u0da7 \u0d92\u0d9a \u0dc1\u0d9a\u0dcf\u0dc1\u0dc4\u0dcf\u0db8\u0daf \u0dc0\u0dd0\u0dbb\u0dd0\u0db0\u0dd2\u0db8\u0daf [ \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0dc3 \u0dcf \u0dc4\u0daf\u0db1\u0dca\u0db1 \u0d85\u0db4\u0da7 \u0db8\u0db1\u0dca\u0dd3 \u0dd4\u0dbb\u0dba \u0dc1\u0d9c\u0daf\u0dbb\u0dd2\u0db1\u0dca \u0dc1\u0dda\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0 \u0dc1\u0db1\u0dca. \u0d91\u0dad\u0dc1\u0d9a\u0dcf\u0da7 \u0dc1\u0db8\u0dca \u0dd2\u0db1\u0dca\u0db1 \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4 \u0dc4\u0dbb\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a \u0db8\u0db1\u0dca\u0dd3 \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dd4\u0dc1\u0dda; \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dba\u0dcf\u0dcf \u0d91\u0dc0\u0db4\u0dd4 \u0dc3\u0db7\u0dd2\u0d9a \u0db8\u0db1\u0dca\u0dd3 \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dd4\u0dc1\u0dda \u0dc3\u0dc4\u0dc1\u0dba\u0ddd\u0d9c\u0dba \u0d85\u0dba\u0dc1\u0d9c\u0db1 \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0d92 \u0dc3 \u0dcf \u0dc4\u0daf\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dc0 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf\u0dc0 \u0d85\u0db4\u0dd2 \u0db4 [\u0dc2\u0dca\u0da8\u0dad\u0dca \u0d91 [\u0d9a \u0da9\u0dd3\u0dbd\u0dca\u0dc0\u0dcf\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dcf\u0dcf \u0db1\u0dd0\u0dad\u0dd2 \u0db6\u0dc0. \u0d91\u0dc1\u0dc4\u0db8 \u0d9c\u0dd2\u0dba\u0dcf \u0db1\u0db8\u0dca \u0d85\u0db4\u0da7 \u0d9a\u0dd1 \u0d9c\u0dc4\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0db1\u0dd0\u0dc4\u0dd0 \u0dc1\u0db1\u0dca. \u0d92 \u0dc3 \u0dcf\u0dc0\u0dcf \u0dd2\u0db1\u0dca\u0db1 \u0dad\u0db1\u0dd2 \u0dad\u0db1\u0dd2 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0dad\u0dca \u0d91 [\u0d9a \u0d85\u0db4\u0dd2 \u0d91\u0d9a\u0d9f\u0dad\u0dcf \u0dc4\u0daf\u0dcf\u0dc1\u0d9c\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0dc0 \u0d85\u0db4\u0dd2 \u0daf\u0dd2\u0db1\u0db4\u0dd4 \u0dc3 \u0dcf \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0db1\u0dca\u0db1. \u0d92\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0db8\u0dca\u0dc1 [ \u0db4\u0daf\u0db1\u0db8."
