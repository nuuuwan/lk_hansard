\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0dc3\u0db8\u0dd4\u200d\u0dbb \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0d9a \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dd2\u0dc3\u0dd2 \u0dba\u0db8 \u0dc3\u0d9a\u0dc3\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dba\u0db1\u0dcf\u0daf\u0dd2 \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8.\n\n\uf0b7 \u0dd2 \u0dba\u0dc3\u0dcf\u0dba \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0d9a \u0d92\u0d9a\u0d9a\u0dba\u0d9a\u0dca \u0dc3\u0dcf\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8.\n\n\uf0b7 \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0d9a \u0db1\u0dd3\u0dd2 \u0dba \u0db3\u0dc0\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0d92\u0d9a\u0d9a\u0dba\u0d9a\u0dca \u0dc3\u0dcf\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0daf\u0dca\u200d\u0dd0\u0db1\u0da7 \u0dd2\u0dc3\u0daf\u0dd4 \u0dc1\u0d9a\u0dc1\u0dba\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd3.\n\n\uf0b7 \u0dc1\u0d9c\u0ddd\u0dbd\u0dd3\u0dba \u0d9a\u0dc1\u0dba\u0ddd\u0dd9\u0db1 \u0dc3\u0db8\u0dd4\u0dc0\u0d9a\u0dc0\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0\u0dba\u0da7 \u0dc3\u0dc4\u0dcf\u0dcf\u0d9c\u0dd2 \u0dc0\u0dd3\u0db8 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dc0\u0d82\u0d9a\u0dcf\u0dc1 \u0db4\u0dc0\u0dad\u0dca\u0db1\u0dcf \u0d9a\u0dc1\u0dba\u0ddd\u0dd9\u0db1 \u0d85\u0dc0\u0dc3\u0dcf\u0dcf\u0dcf \u0db3\u0dcf\u0dc4\u0dd2\u0dba \u0dc1\u0dc0\u0ddd\u0d9a\u0dba\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0d9a\u0dba\u0db8\u0dca\u0dcf \u0d9a\u0dba\u0db1 \u0dc0\u0daf\u0dd2.\n\n\uf0b7 \u0dc1\u0d9a\u0dbd\u0db4\u0dad\u0dba\u0dcf\u0db1\u0dd4 \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0d9a \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dc1\u0dc0 \u0db8\u0dd6\u0dc0\u0dba \u0d9a\u0db0\u0dcf\u0dba \u0dc3\u0db8\u0dd9 \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0dc3\u0dc4 \u0db1\u0dd0 \u0dc1\u0dd9\u0db1\u0dc4\u0dd2\u0dba \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0dc1\u0d9a\u0dc1\u0dba\u0dc4\u0dd2 \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba \u0dc1\u0dba\u0dbd\u0db8\u0dd4 \u0d9a\u0dba\u0db8\u0dd2\u0db1\u0dca \u0d85\u0db4 \u0dba\u0dc1\u0da7\u0dca \u0d91\u0dad\u0dba\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dc3\u0dc1\u0db0\u0dd2\u0dba\u0d9a\u0dca \u0dc1\u0db1\u0dbd\u0db8\u0dd0\u0dd2 \u0d85\u0dc1\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0d9a\u0dbb\u0dca \u0db1\u0dd3\u0dba \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dc1 \u0dc0\u0dc0\u0da7 \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0d9a \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd3\u0db8\u0dca \u0dc0\u0dba\u0dcf\u0dda\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc0\u0dc4\u0dcf \u0db1\u0dc0 \u0dc1\u0dad\u0dca\u0db8\u0dcf \u0db1\u0dd2\u0dc1\u0d9a\u0dca\u0dad\u0db1 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dc0 \u0dba \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8. \u0dc4\u0db3\u0dba\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dc1 \u0dc1\u0dc0 \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0d9a \u0dc1\u0dc3\u0dda\u0dc0\u0dcf \u0db8\u0db0\u0dba\u0dc3\u0dcf\u0dcf\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0dc3\u0dc4 \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0d9a\u0dba\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dd0\u0db1\u0dd3\u0dc1\u0db8\u0dca \u0db8\u0db0\u0dba\u0dc3\u0dcf\u0dcf\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0dd2\u0daf\u0dd2 \u0d9a\u0dc5 \u0d85\u0dad\u0dba \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dc1\u0dc1\u0dd3\u0dba\u0dba \u0dc1\u0dbd\u0dca\u0d9a\u0db8\u0dca\u0dc0\u0dba\u0dba\u0dcf\u0dc1\u0dda \u0dc3\u0dc4 \u0d85\u0dc1\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dc0\u0db1 \u0d9a\u0dba\u0dad\u0db1\u0dc0\u0dc0 \u0dc3\u0dc4\u0dcf\u0dcf\u0d9c\u0dd2\u0dad\u0dca\u0dc0\u0dc1\u0dba\u0db1\u0dca \u0dd4\u0dad\u0dad\u0dd4\u0dc0 \u0dc4\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dc0\u0d82\u0d9a\u0dcf \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0db4\u0dad\u0dc1\u0dc0 \u0db8\u0dd9 \u0dc1\u0db4\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0dba\u0da7\u0dc1\u0dad\u0dca \u0dc1\u0db8\u0db8 \u0db4\u0dc4\u0dd4\u0db1\u0d9a\u0db8\u0dca \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc0\u0dc4\u0dcf \u0db8\u0db1\u0dcf \u0db4\u0daf\u0dca\u200d\u0db1\u0db8\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0db4\u0dca\u200d\u0dbb\u0dd9\u0dcf \u0db4\u0dcf\u0daf\u0dca\u200d\u0d9a \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0d9a \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0db1 \u0dc0\u0daf\u0dca\u200d \u0d85\u0dad\u0dba \u0dc1\u0db8\u0dba\u0da7 \u0d9a\u0dbb\u0dca\u0dd2\u0d9a\u0d9a\u0dba\u0da7 \u0daf\u0dca\u200d\u0dcf\u0dba\u0d9a \u0dc1\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0d9a \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dc1\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dc0\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dd9\u0dcf\u0dc0 \u0d85\u0dad\u0dba \u0dc1\u0db3\u0daf\u0dd3 \u0dba\u0db1 \u0db3\u0dc0 \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a\u0dba\u0db1 \u0dc0\u0daf\u0dd2.\n\n\uf0b7 \u0dc1\u0db8\u0dba \u0db1\u0dd2\u0dba\u0db8\u0dd4 \u0dc0\u0dba\u0dcf\u0db4\u0dca\u0dd2 \u0dba\u0d9a\u0dca \u0dc1\u0dc0\u0dc3 \u0d85\u0db4 \u0dba\u0dc1\u0da7\u0dca \u0d85\u0dc1\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dc1 \u0dc0\u0dc0 \u0daf\u0dca\u200d \u0dcf\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0db3\u0dc0\u0dcf\u0dc1\u0db4\u0dbd\u0dc1\u0dba\u0dbd\u0dad\u0dca\u0dad\u0dd4 \u0dc1 .\n\n(vi) \u0d94 .\n\n1968 \u0d85\u0d82\u0d9a 14 \u0daf\u0dca\u200d\u0dba\u0db1 \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db4\u0db1\u0dc1\u0dad\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1 \u0dba\u0da7\u0dc1\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf \u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dba \u0dad\u0dd2 \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dc1 / \u0d9a\u0dc0\u0dcf\u0db4\n\n2005 \u0d85\u0d82\u0d9a 38 \u0daf\u0dca\u200d\u0dba\u0db1 \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0d9a \u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0db4\u0db1\u0dc1\u0dad\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1 \u0dba\u0da7\u0dc1\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf \u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dba \u0dad\u0dd2 \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dc1 / \u0d9a\u0dc0\u0dcf\u0db4\n\n\u0db4\u0dc5\u0dcf\u0dad\u0dca \u0dcf\u0d82\u0da0\u0dcf\u0dc3\u0d9a \u0dcf\u0d82\u0dc0\u0dcf \u0db0\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc0 \u0dc1\u0dba\u0dd3\u0dba \u0d9a\u0dbd\u0dcf\u0db4\n\n1 \u0db3\u0dc3\u0dcf\u0db1\u0dcf\u0dc4\u0dd2\u0dba \u0d9c\u0dbd\u0dca\u0d9a\u0dd2\u0dc3\u0dcf\u0dc3 \u0db8\u0dd3\u0d9c\u0db8\u0dd4\u0dc0 (\u0d92\u0dad\u0dca\u0dad\u0dd4\u0d9a\u0dcf\u0dc0 \u0dbd\u0dd4\u0dc0\u0dd2\u0dc3\u0dcf \u0dc1\u0db4\u0dc1\u0daf\u0dca\u200d\u0dc3) \u0dc1\u0db6\u0dca\u0dbb\u0dd4\u0dc0\u0dc0\n\n2 \u0daf\u0dca\u200d\u0d9a\u0dd4\u0da7 \u0dc4\u0dd2\u0d9a\u0dca\u0d9a\u0da9\u0dd4\u0dc0 \u0dc1\u0db3\u0db1\u0dca\u0dc1\u0dad\u0dbd\u0da7 \u0db8\u0dcf\u0daf\u0dd4\u0d9c\u0dd9 \u0d8b\u0da7\u0dc0\u0da7\u0dd4\u0db1\n\n3 \u0db8\u0db0\u0dba\u0db8 -\n\n4 \u0dc3\u0db3\u0dba\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dd2\u0db1\u0dca\u0db1\u0dc0\u0dc0"
