    "chunk_text": "\u0d9c\u0d9a\u0dcf\u0dc0\u0dd2\u0da9\u0dca \u0dc0\u0dc3\u0d82\u0d9c\u0dad\u0dba \u0dc4\u0dcf \u0dba\u0d9c\u0da7\u0dca \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u0d85\u0dba\u0dc4\u0db4\u0dad\u0dca \u0dc0\u0dcf\u0dad\u0dcf\u0dc0\u0dba\u0dab\u0dba \u0d9c\u0dc4\u0dda\u0dad\u0dd4\u0d9c\u0dc0\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0daf\u0dba\u0dcf \u0db4\u0dd3\u0db0 \u0dc3\u0db3\u0dc4\u0dcf \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0daf \u0dc0\u0dd6 \u0d85\u0dad\u0dba, \u0d9c\u0db8\u0dca \u0dc0\u0db1\u0dc0\u0dd2\u0db4 2022 \u0d8b\u0dc3\u0dc3\u0dda \u0d9c\u0db4\u0dd9 \u0daf [\u0dc0\u0dcf \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dca \u0dd2\u0da7\u0dd4 \u0d9a\u0dba \u0d85\u0dc0\u0dc3\u0db1\u0dca\u0daf \u0d9a\u0dba \u0dad\u0dad. \u0d9c\u0db8\u0db8 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0daf\u0dba \u0dba\u0dae\u0dcf \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0db4 \u0db4\u0dad\u0dca \u0d9a\u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d91\u0d9a\u0dc0\u0dba \u0d8b\u0dc3\u0dc3\u0dda \u0d9c\u0db4\u0dd9 \u0d9a\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba\u0db8\u0dca \u0d9c\u0daf\u0d9a \u0db6\u0dd0\u0d9c\u0dd2\u0db1\u0dca\u0daf \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0db4 \u0dd2\u0da7\u0dd4 \u0dc0\u0dd2\u0dba.\n\n\u0d89\u0dad\u0dd2\u0db1\u0dca\u0daf, \u0d9c\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0daf\u0db0\u0d9c\u0dba\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0daf\u0dba\u0dcf \u0db4\u0dd3\u0db0\u0dba\u0db1\u0dca\u0daf\u0dc4\u0dd2 \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0dba\u0da7\u0dd2\u0dad\u0dbd \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc4\u0dcf \u0d85\u0db0\u0dba\u0dba\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0dba \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd \u0d9a\u0dd9\u0db8\u0db1\u0dcf\u0d9a\u0dba\u0dab\u0dba \u0d9a\u0dba \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca\u0daf \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dad \u0dc4\u0dd0\u0d9a\u0dd2 \u0dc3\u0d82\u200d\u0dba\u0dcf\u0dc0 \u0dad\u0dd3\u0dba\u0dab\u0dba \u0d9a\u0dba\u0db1 \u0dbd\u0dd3 . \u0d9c\u0db8\u0dca \u0dc0\u0db1\u0dc0\u0dd2\u0db4 202] \u0d8b\u0dc3\u0dc3\u0dda \u0d9c\u0db4\u0dd9 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dbd \u0daf \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0dc0\u0dd3 \u0dad\u0dad. 2023 \u0d8b\u0dc3\u0dc3\u0dda \u0d9c\u0db4\u0dd9 \u0d9a\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba\u0db8 \u0db4\u0db8\u0dab [ \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dad\u0dca\u0d9c\u0dad\u0dca \u0db1\u0db8\u0dca 202] \u0d8b\u0dc3\u0dc3\u0dda \u0d9c\u0db4\u0dd9 \u0d9a\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba\u0db8 \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0db4 \u0dd2\u0da7\u0dd4 \u0dc0\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca\u0daf 2026 \u0dd6\u0dbd\u0dd2 \u0db8\u0dcf\u0dc3\u0d9c\u0dba\u0db1\u0dca\u0daf \u0db4\u0dc3\u0dd4\u0dc0\u0dba. \u0d91\u0db6\u0dd0\u0dc0\u0dd2\u0db1\u0dca\u0daf \u0d9c\u0db8\u0db8 2023, 202] \u0d8b\u0dc3\u0dc3\u0dda \u0d9c\u0db4\u0dd9 \u0d9a\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba\u0db8\u0dca \u0d9c\u0daf\u0d9a\u0db8 \u0d91\u0d9a\u0dc0\u0dba \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0db4 \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0d9c\u0dba\u0dcf\u0daf\u0dcf \u0dad\u0dad\u0dd2 \u0d85\u0dad\u0dba, \u0d89\u0db1\u0dca\u0daf \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0dc0 \u0dd2\u0da7\u0dba\u0dbd\u0dd4 \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dd2\u0d9a\u0dc0 \u0dd2\u0da7\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db4 \u0d85\u0dc0\u0dc3\u0dda\u0dae\u0dcf\u0dc0 \u0d8b\u0daf\u0dcf \u0d9c\u0dc0\u0dca. \u0d9c\u0db8\u0dc4\u0dd2\u0dd3 \u0d85\u0db4\u0dd2 \u0db4\u0dd3\u0db0\u0dcf\u0d9a\u0dbb\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0daf \u0dc3\u0db8\u0d9f \u0dc3\u0dcf\u0d9a\u0dca\u0da1\u0dcf\u0dc0 [ \u0d9a\u0dd9\u0dcf. \u0d91\u0dad\u0dd0\u0db1\u0dd3 \u0dba\u0da7\u0dd2\u0dad\u0dbd \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca, \u0d9c\u0db1\u0dca\u0daf\u0dc0\u0dcf\u0dd2\u0da7\u0d9a\u0dcf\u0d9c\u0dcf\u0dba \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0dc4 \u0dd2\u0da7\u0dba\u0dbd\u0dd4 \u0d9c\u0dd4\u0dab\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd9 \u0dc4\u0dd0\u0d9a\u0dd2 \u0dc0\u0dcf\u0dad\u0dcf\u0dc0\u0dba\u0dab\u0dba [ \u0dad\u0dd4\u0dd9 \u0db4\u0db8\u0dab\u0dba\u0dd2 \u0d92 \u0d85\u0dba \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0daf\u0db1 \u0d85\u0db4\u0dd2 \u0dad\u0dd3\u0dba\u0dab\u0dba \u0d9a\u0d9c\u0dd9\u0dda. \u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0dc3\u0d82\u200d\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a\u0dc0 \u0d9c\u0db1\u0dcf\u0d9c\u0dc0\u0dba\u0dd2.\n\n\u0d9c\u0db8\u0db8 \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0db4 \u0d85\u0daf\u0dcf\u0dd9 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0d9c\u0dc0\u0dca\u0daf\u0db1\u0dba \u0d9c\u0db8\u0dca \u0dc0\u0db1\u0dc0\u0dd2\u0db4 \u0dc3\u0d9a\u0dc3\u0dda \u0d9a\u0dba \u0d85\u0dc0\u0dc3\u0db1\u0dca\u0daf \u0d85\u0daf\u0dd2\u0dba\u0d9c\u0dbb\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d85\u0dad\u0dba, \u0d85\u0dba\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dd0\u0db3\u0dc0\u0dd3\u0db8\u0db4 \u0d85\u0daf\u0dcf\u0dd9 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0d9c\u0dad \u0daf\u0dad\u0dca\u0dad \u0db4\u0dda\u0db0\u0dad\u0dd2\u0dba \u0dba\u0dcf\u0dc0\u0dad\u0dca\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0d9c\u0db8\u0dca \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0dd2\u0da7\u0dd4 \u0d9a\u0dba\u0db8\u0dd2\u0db1\u0dca\u0daf \u0db4\u0dc0\u0dad\u0dd3. 2025 \u0d85\u0d9c\u0d9c\u0ddd\u0dc3\u0dda\u0dad\u0dd4 \u0db8\u0dd4\u0dca \u0dc3\u0dad\u0dd2\u0d9c \u0d9c\u0db8\u0db8 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0d9c\u0dc0\u0dca\u0daf\u0db1\u0dba \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db4 \u0d85\u0d9c\u0dda [\u0dc2\u0dca\u0da8\u0dcf \u0d9c\u0d9a\u0d9c\u0dbb\u0dca. \u0d89\u0db1\u0dca\u0daf \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0dc0 \u0dc0\u0dd2\u0daf\u0dba\u0dcf \u0db4\u0dd3\u0db0 \u0db8\u0da7\u0dca\u0db4\u0db8\u0dd2\u0db1\u0dca\u0daf \u0dc3\u0db8\u0dca\u0db8\u0dd4\u200d \u0db4\u0dbb\u0dd3 [\u0dc2\u0dca\u0da8\u0dab \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf \u0dc1\u0dd2 [\u0dc2\u0dca\u0da8\u0dab\u0dbd\u0dcf\u0db7\u0dd3\u0db1\u0dca\u0daf \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0db4 \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dba \u0dad\u0dad. \u0d9c\u0db8\u0db8 \u0dc1\u0dd2 [\u0dc2\u0dca\u0da8\u0dab\u0dbd\u0dcf\u0db7\u0dd3\u0db1\u0dca\u0daf \u0d9a\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba\u0db8 2025 \u0d9c\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dd4\u0dca \u0dc3\u0dad\u0dd2\u0dba \u0dad\u0dd4\u0dd9 \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0db4 \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad\u0dc0 \u0dad\u0dad.\n\n\u0dca\u200d\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0daf\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0daf\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dba \u0db8\u0dad\u0dd4 \u0d9a\u0dba\u0db4\u0dd4 \u0d9a\u0dcf\u0dba\u0dab\u0dcf\u0dc0 \u0dad\u0dad\u0dca\u0dad. \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0daf\u0dba\u0dcf \u0db4\u0dd3\u0db0 20 \u0d91\u0d9a\u0dd2\u0db1\u0dca\u0daf \u0d91\u0d9a \u0d9c\u0dad\u0dca\u0dad\u0dcf, \u0d9c\u0db7\u0dde\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0d85\u0db1\u0dd4\u0dc0 \u0db8\u0dcf\u0db1\u0dc0 \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0d9c\u0d9a\u0dcf\u0dca \u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba [ \u0dad\u0dad\u0dd4\u0dd9\u0dad\u0dca \u0d9a\u0dd9 \u0dc4\u0dd0\u0d9a\u0dd2\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d85\u0db4\u0dd2 \u0d9c\u0db8\u0dca \u0dc0\u0db1\u0d9c\u0d9a\u0dcf\u0db4 \u0d92 \u0d9a\u0dcf\u0dba\u0dab\u0dcf\u0dc0 \u0d9c\u0dd0\u0db1 \u0dc3\u0dcf\u0d9a\u0dca\u0da1\u0dcf \u0d9a\u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0d8a\u0dd9\u0d9f \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0dba\u0db4 \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dba\u0db1\u0d9c\u0d9a\u0dcf\u0db4 \u0db1\u0dd2 \u0dda\u0da0\u0dd2\u0dad \u0dad\u0dd3\u0dba\u0dab \u0dc0\u0d9c\u0dba [ \u0d85\u0dba\u0d9c\u0d9c\u0db1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d92, \u0dc3\u0d82\u200d\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a\u0dc0 \u0d9c\u0db1\u0dcf\u0d9c\u0dc0\u0dba\u0dd2, \u0dc0\u0dd2\u0d9c \u0dda\u0dc2\u0dca\u0da8\u0d9c\u0dba\u0db1\u0dca\u0daf \u0d9c\u0dd4\u0dab\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba [ \u0dc3\u0dd0\u0dbd\u0d9c\u0dc3\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d92 \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba\u0dcf\u0dc0\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0daf\u0dba\u0dcf \u0db4\u0dd3\u0db0\u0dc0\u0dbd\u0db4 \u0dad\u0dad\u0dd4\u0dc0) \u0d9a\u0dba \u0d9c\u0db1\u0dca\u0daf\u0db1. \u0d9c\u0db8\u0dcf\u0d9a\u0daf, \u0d92 \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba\u0dcf\u0dc0\u0db1\u0dca\u0daf \u0dad\u0db8\u0dba\u0dd2 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0d9c \u0dd3 \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4 \u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0db4 \u0db4\u0dcf\u0dc3\u0dca \u0dc0\u0dbd\u0db4 \u0dba\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca\u0daf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d9c\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0daf\u0db0\u0d9c\u0dba\u0db1\u0dca\u0daf \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0d9c \u0dda\u0dc2\u0dca\u0da8\u0d9c\u0dba\u0db1\u0dca\u0daf \u0dc3\u0d82\u0d9c\u0dc0\u0dca\u0dd3 \u0dba\u0dd2.\n\n\u0d9c\u0db6\u0dcf\u0d9c\u0dc4\u0dcf\u0db8 \u0dc3\u0dda\u0dad\u0dd4\u0dad\u0dd2\u0dba\u0dd2."
