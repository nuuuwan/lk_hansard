    "chunk_text": "\u0d8a \u0d9f \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf\u0dc0 \u0db1\u0db1\u0dad\u0dcf\u0dc0\u0dc1\u0dda \u0dca\u200d\u0dbb\u0dba [\u0dad\u0dd2\u0dba \u0db4\u0dc4 \u0dc0\u0dd0\u0dd3 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dcf\u0dcf. \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d9a\u0dcf\u0dcf\u0dc1 \u0dcf\u0da9\u0dd4\u0d9a\u0da9\u0dc0\u0dcf \u0db8\u0dd2\u0dcf \u0d9c\u0da7\u0db1\u0dca \u0dd2\u0dad\u0dcf \u0d85\u0db0\u0dd2\u0d9a \u0dc1\u0dcf\u0dc3 \u0dd2\u0dc4 \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0daf\u0dca\u0da7 \u0db6\u0dc0. \u0db1\u0dd4\u0dab\u0dad\u0dca\u0dc0 \u0d85\u0dc1\u0dda \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0db6\u0dcf\u0dba\u0da7 \u0db4\u0dad\u0dca \u0dc0\u0dd4\u0da7 \u0d85\u0dc0\u0dc3\u0dda\u0dae\u0dcf\u0dc1 \u0dc3\u0dd2\u0da7 \u0dcf\u0da9\u0dd4\u0d9a\u0da9\u0dc0\u0dcf \u0db8\u0dd2\u0dcf \u0d9c\u0da7\u0db1\u0dca \u0dca\u200d\u0dbb\u0db8\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dba\u0db1\u0dca \u0db4\u0dc4 \u0db6\u0dc3\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0dca\u200d\u0dbb\u0dba [\u0dad\u0dd2\u0dba \u0d85\u0dca \u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0d9a\u0dcf\u0dc1\u0dc4\u0dcf\u0db8\u0daf \u0d9a\u0dd2\u0dba\u0dcf\u0dcf. \u0dca\u200d\u0dbb\u0dba [\u0dad\u0dd2\u0dba \u0db4\u0dc4 \u0dc0\u0dd0\u0dc1\u0da7\u0db1\u0dca\u0db1 \u0db1\u0db8\u0dca \u0db8\u0dd6\u0dba\u0d9a\u0dad \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0d85\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d91\u0dc1\u0dc4\u0db8 \u0db1\u0db8\u0dca \u0d91 [\u0dc1\u0d9a\u0ddd \u0d85\u0dc1\u0dda \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0d85\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d91\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0dcf\u0da9\u0dd4\u0d9a\u0da9\u0dc0\u0dcf \u0db8\u0dd2\u0dcf \u0d9c\u0da7\u0db1\u0dca \u0dd2\u0dc4 \u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2\u0dc0 \u0dc1\u0db8\u0dca \u0dc0\u0db1 \u0dd2\u0db0\u0da7 \u0d91\u0d9a \u0db4\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd2\u0db1\u0dca \u0dcf\u0da9\u0dd4\u0d9a\u0da9\u0dc0\u0dcf \u0db8\u0dd2\u0dcf \u0d9c\u0da7\u0db1\u0dca \u0db4\u0dc4 \u0dba\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0dc1\u0db1 [ \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0db1\u0dca\u0dc0 \u0db4\u0dc3\u0dd4 \u0d9c\u0dd2\u0dba \u0d85\u0dba \u0dc0\u0dd0\u0dc1\u0dba\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0db1\u0db1\u0dad\u0dcf\u0dc0\u0dc1\u0dda \u0dca\u0daf\u0dcf\u0dba\u0db8\u0dc0 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0db8\u0dd6\u0dcf\u0dba\u0db8\u0dba \u0dca\u0daf\u0dcf\u0dba\u0db8 \u0dd2\u0dc4 \u0dba\u0dd1\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0 \u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dba\u0d9a\u0d9c \u0d85\u0dba\u0dc1\u0d9c\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db1\u0dd2\u0dc3\u0dcf \u0dc1\u0db8\u0dca \u0dc0\u0db1 \u0dd2\u0db0\u0da7 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0dca\u0daf\u0dcf\u0dba\u0db8 \u0dd2\u0dc4 \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dba\u0dcf\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0d91\u0d9a \u0db4\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da7\u0dd4\u0db4\n\n2871 2872\n\n\u0db4\u0dcf\u0dba\u0d9a\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0"
