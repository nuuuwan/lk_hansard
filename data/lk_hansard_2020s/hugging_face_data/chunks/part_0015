ad\u0dbd\u0dd2\u0dda \u0dca\u0db6\u0dca\u0db0\u0dad\u0dd4\u0dc0\n\n(iv) \u0dda \u0db8\u0dc3\u0db8\u0dc3\u0dc4\u0db1\u0dbd\u0daf\u0dba\u0dc4\u0dc0\u0dba\u0daf\u0dad\u0dad\u0dd2 \u0dda \u0dca\u0db0\u0dc4\u0dda \u0dca\u0ddc\u0dd2\u0d9a\u0dc4\u0dad\u0dc0\u0dd4\u0dca \u0dc40 211\u0dda\u0db4\u0dc4\u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dbd\u0daf\u0db7\u0dc4\u0dd2\u0da7\u0db8\u0dd2\u0dc4\u0dc0\u0dcf\u0dc4\u0db1\u0dc0\u0db4\u0dc4\u0dca\u0dab\u0dca\u0db0\u0dc4 :\u0daf\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc0\u0daf.\n\n(v) \u0dd2\u0d9a\u0dda\u0dca \u0dad\u0dc4\u0d89\u0da9\u0dca\u0db6\u0dc4\u0dbd\u0db1\u0daf\u0dc4\u0daf\u0dd3\u0db8\u0dc3\u0db4\u0dc4\u0dda\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0dc4\u0dda\u0dbb\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc0\u0daf.\u0dc4\u0d91\u0dd2\u0da7\u0dc4\u0dcf\u0dd0\u0dc0\u0dcf\u0dc4\u0dad\u0daf\u0dd2\u0dc4\u0da0\u0dd2\u0dc4\u0d9a\u0dd2\u0dbb\u0dd3\u0dda \u0dca\u0db6\u0dc4\u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0daf\u0dda\u0daf\u0dbb\u0dd3\u0dc4\u0dc3\u0dcf\u0dd0\u0dbd\u0dd0\u0dc3\u0dcf\u0dca\u0db8\u0dc3\u0dc4\u0dc3\u0dcf\u0dda\u0dc3\u0dcf\u0dca\u0dc4\u0dda\u0dbb\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc0\u0daf.\u0dc4\u0d89\u0da9\u0dca\u0db6\u0dc4\u0dca\u0dd2\u0da7\u0db8\u0dd2\u0dc4\u0dda \u0dc0\u0dcf\u0dc4\u0dca \u0db4\u0dc4\u0d89\u0da9\u0dca\u0db6\u0dc4\u0dbd\u0db1\u0daf\u0dc4\u0daf\u0dd3\u0db8\u0dc3\u0dc4\u0dc3\u0dcf \u0daf\u0dc4\u0dda \u0d9a\u0dca\u0d9a\u0dba\u0dda \u0db4 \u0daf\u0dbb\u0dc4218.44\u0d9a\u0dca\u0d9a\u0dba\u0dc4 \u0db3\u0dd4\u0dcf\u0daf\u0dc4\u0dda \u0dca\u0dcf\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc0\u0daf.\u0dc4\u0d92\u0dc4\u0dc3\u0dcf \u0daf\u0dc4\u0dd4 \u0db6\u0dca\u0db1\u0daf\u0dbb\u0dc4\u0dc3\u0dcf \u0dc4\u0db8\u0dc3\u0dd0\u0dca \u0dbd\u0dca\u0db8\u0dc3\u0dc4\u0d9a\u0dd2 \u0dcf\u0dc4\u0d9c\u0dca\u200d\u0dbb\u0daf\u0db8\u0dc3\u0dc4\u0dd2\u0dbd\u0dbd\u0dba\u0daf\u0dbb\u0dd2\u0dc4\u0dc0\u0dc3\u0dcf\u0dca\u0db6\u0dc4\u0dad\u0dd4 \u0dc4\u0db4\u0dd2\u0dd2\u0da7\u0da7\u0dd2\u0dc4\u0dc0\u0dcf\u0dc4\u0dc3\u0dcf\u0dc4\u0dbb\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dab\u0dc4\u0dda :\u0dad\u0daf\u0dca\u0dad\u0dcf\u0dda \u0dca\u0db6\u0dca\u0db0\u0dad\u0dd4\u0dc0\u0db4\u0dc4\u0dca \u0dca\u0dad\u0dc4\u0d89\u0da9\u0dca\u0db6\u0dc4 \u0db3\u0dd4\u0dcf\u0daf\u0dc4\u0dda \u0dca\u0dcf\u0dc4\u0d92\u0dc0\u0daf\u0dc4\u0dd2\u0dbd: \u0dc3\u0dcf\u0dca\u0dc4\u0dda\u0dbb\u0dc4\u0dca\u0dca\u0db0\u0dcf\u0db4\u0dc4\u0dda\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0dc4\u0dda\u0dbb\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc0\u0daf.\u0dc4\u0dda \u0dca\u0db6\u0dc4\u0dc3\u0dcf\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dda \u0dca\u0db0\u0dc4\u0dda \u0db8\u0dc3\u0ddc\u0dcf\u0dbb\u0daf\u0dca\u0dbd\u0dc4\u0daf\u0dd2\u0dc3\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dda \u0dca \u0dda\u0dca\u0db6\u0dc4\u0dd2\u0d9a\u0dd2\u0d82\u0dca\u0db0\u0dc4\u0dca:\u0daf \u0dc4\u0dda\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0dc4\u0dd2\u0d82\u0dd4 \u0dda\u0dbb\u0dc4\u0dda \u0dca\u0dcf\u0dc4 \u0dcf\u0dc0\u0daf.\n\n(vi) \u0d9a\u0dd4\u0db9\u0dd4\u0d9a\u0dca\u0d9a\u0dba\u0dda\u0dca\u0db0\u0dc4\u0dc3 \u0dc4\u0db1\u0dbd\u0daf\u0dba\u0dc4\u0dc0\u0dba\u0daf\u0dad\u0dad\u0dd2 \u0dda \u0dc4\u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0dca\u0db6\u0dc4\u0dda\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0dc4\u0dc3\u0dcf\u0dc4\u0dc0\u0dca\u0dad\u0dba\u0dcf\u0dc4\u0dda\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0dc42123.15.3]\u0dc4\u0daf\u0dd2\u0dcf\u0dc4\u0dca\u0dc0\u0dc3\u0dcf\u0dca\u0db0\u0dc4\u0dda\u0dbb\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc0\u0daf.\u0dc4\u0d92\u0dc4\u0dc3\u0dcf\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dc0\u0dc4RAMP \u0dda\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0dc4\u0dad\u0dca\u0dad\u0dc4\u0dda\u0dbb\u0dc4\u0dd2 \u0db6\u0dd4\u0dab\u0daf.\u0dc4\u0d91\u0db8\u0dc3\u0dc4\u0dda\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0dc4\u0db8\u0dc3\u0d9f\u0dd2\u0dca\u0db0\u0dc4\u0dda \u0db8\u0dc3\u0db8\u0dc3\u0dc4\u0dc0\u0dba\u0daf\u0dad\u0dad\u0dd2 \u0dda \u0dc4\u0dc0\u0dd0\u0da9\u0dda\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0dc4\u0dca\u0dc0\u0dc3\u0dcf\u0dca\u0db0\u0dc4\u0dda\u0dbb\u0dc4\u0dd2 \u0dda \u0db1\u0dcf\u0dc0\u0daf.\u0dc4"
