- \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 1,004,155,715.96\n\n2023 \u0db8\u0d9c\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1\u0dba - \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 13,239,174,994.94\n\n\u0db7\u0dcf\u0da9\u0dd4\u0da9 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1\u0dba - \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 1,993,700,945.89\n\n2024 \u0db8\u0d9c\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1\u0dba - \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 13,748,664,705.98\n\n\u0db7\u0dcf\u0da9\u0dd4\u0da9 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1\u0dba - \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 1,778,989,046.20\n\n2025 \u0db8\u0d9c\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1\u0dba - \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 4,788,581,687.13\n\n\u0db7\u0dcf\u0da9\u0dd4\u0da9 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1\u0dba - \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 734,706,420.07\n\n(ii) \u0d94 .\n\n\uf0b7 \u0dc0\u0dbb\u0dca\u0dad\u0db8\u0dcf\u0db1\u0dc1\u0d86 \u0dc3\u0dd2\u0dba\u0dba\u0da7 5\u0d9a \u0db4\u0db8\u0da7 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0da7\u0dba\u0d9a\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1\u0dc1\u0d86\u0daf\u0dd3 \u0db4\u0dc3\u0dd4 \u0d85\u0dc3\u0dcf\u0dc0\u0db1\u0dd4 \u0dc4\u0dcf\u0dd2 \u0dba\u0da7 \u0dbd\u0d9a\u0dca\u0dc0\u0db1 \u0d9a\u0dd2\u0dd2\u0d9a \u0dd2 \u0dc2\u0dca\u0da8\u0dcf\u0db4\u0dcf\u0db1\u0db1 (\u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1\u0dba\u0db1\u0dca \u0d91\u0dc5\u0dc0\u0dbd\u0dd4) \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1\u0dba\u0da7 \u0d87\u0dad\u0dd2 \u0d9a\u0dba\u0dad\u0dcf\u0dc0 \u0d9c\u0da7\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dd2 \u0dba\u0db8\u0dd4 \u0dc0\u0dba\u0dcf\u0db4\u0dd2\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0dc1\u0dbd\u0dc3 2]25 \u0dc0\u0dc3\u0dc1\u0dbb\u0dca \u0d85\u0dba \u0dc0\u0dd0\u0dc1\u0dba\u0db1\u0dca \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0d87\u0dad\u0dd2 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 5]] \u0d8b\u0db4\u0dc1\u0dba\u0ddd\u0d9c\u0dd3 \u0d9a\u0dba \u0d9c\u0dd2 \u0db8\u0dd2\u0db1\u0dca \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db8\u0dd0\u0db1 \u0db4\u0dc5\u0dcf\u0dad \u0dc1\u0d9a\u0dca\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb \u0d9a\u0dba \u0dc1\u0d9c\u0db1 \u0d9a\u0dd2\u0dd2\u0d9a \u0dd2 \u0dc2\u0dca\u0da8\u0dcf\u0db4\u0dcf\u0db1\u0db1 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dc0 \u0dba \u0db4\u0dd2\u0dba\u0dc0\u0dba \u0d9c\u0dd2 \u0db8\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0da7\u0dd3.\n\n\uf0b7 \u0d9a\u0db1\u0dca\u0d9a\u0dc3\u0db1\u0dca\u0dad\u0dd4\u0dc1\u0dbb\u0dca \u0dc3\u0dd2\u0da7 \u0dd2\u0db1\u0dc0\u0dba\u0dd2\u0db1 \u0db4\u0dd4\u0dba\u0dcf \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dc3\u0dcf\u0dae\u0dcf\u0db1 \u0db1\u0d9a\u0dca\u0dc0\u0dcf \u0db7\u0dcf\u0da9\u0dd4\u0da9 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1\u0dba \u0d86\u0dba\u0db8\u0dca\u0db7 \u0d9a\u0dba \u0d87\u0dad. \u0d9a\u0db1\u0dca\u0d9a\u0dc3\u0db1\u0dca\u0dad\u0dd4\u0dc1\u0dbb\u0dca \u0dc1\u0dad\u0dbd\u0dca \u0db4\u0dbb\u0dca\u0dba\u0db1\u0dca\u0dad\u0dba \u0db1\u0d9a\u0dca\u0dc0\u0dcf \u0dc1\u0dc0\u0db1\u0db8 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0d9a\u0dca \u0d89\u0dd2\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d9a\u0dba\u0dad\u0dcf \u0d85\u0db0\u0dba\u0dba\u0db1\u0dba\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dba \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d9a\u0dba\u0db1 \u0dc1\u0dbd\u0dc3 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dc1\u0db1\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d89\u0d82\u0da2\u0dd2\u0dc1\u0db1\u0dca\u0dbb\u0dd4 (\u0dc3\u0d82\u0da5\u0dcf \u0dc4\u0dcf \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2) \u0dc3\u0dc4 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dc1\u0dc0\u0dad \u0db1\u0db1\u0dca\u0dc0\u0dcf \u0d87\u0dad.\n\n\uf0b7 \u0dc0\u0db1\u0dc0\u0dcf\u0dc3\u0dbd \u0dc3\u0dd2\u0da7 \u0d85\u0dbb\u0dd4\u0dc0\u0d9a\u0dca\u0d9a\u0dcf\u0dbd\u0dd4 \u0db1\u0d9a\u0dca\u0dc0\u0dcf \u0dba\u0db1 \u0db1 \u0d85\u0db4\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dba \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0dc0\u0dba\u0dcf\u0db4\u0dd2\u0dad\u0dd2\u0dba \u0d86\u0dba\u0db8\u0dca\u0db7 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dba\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dd0\u0dc0\u0dad\u0dd3\u0db8.\n\n\uf0b7 \u0dba\u0dcf\u0da2\u0dba \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0dbd\u0dd2\u0d9a \u0dc4\u0dc0\u0dd4\u0dbd\u0dca\u0d9a\u0dcf\u0dbb\u0dd2\u0dad\u0dca\u0dc0\u0dba \u0dba\u0da7\u0dc1\u0dad\u0dca \u0db8\u0d9c\u0dd3 \u0dc4\u0dcf \u0db7\u0dcf\u0da9\u0dd4\u0da9 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0dd2\u0db1\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0 \u0dba \u0db4\u0dd2\u0dba\u0dc0\u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0ddc\u0dc1\u0dba\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0dd3\u0db8. \u0dc1\u0db8\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dc1\u0db1\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc1 \u0d85\u0dad\u0dd2\u0dc1\u0dbb\u0dca\u0d9a \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba\u0dcf\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd3 (\u0dba\u0dcf\u0db1\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a)\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0dad\u0dca\u0dc0\u0dc1\u0dba\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dca \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0d9a\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dcf \u0d87\u0dad."
