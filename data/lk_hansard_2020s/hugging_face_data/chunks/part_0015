    "chunk_text": "\u0dd9\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0ddc \u0dc4 \u0db8\u0dd2\u0db1\u0dca \u0d8b\u0dc3\u0dc3\u0dca \u0dc4\u0dad\u0dc5 \u0dc0\u0dd8\u0dca\u0dad\u0dd3\u0dba \u0dc0\u0dd2\u0dc2\u0dba \u0db0\u0ddc\u0dbb\u0ddc\u0dc0 2018 \u0dc0\u0dca\u0dc2\u0dc4\u0dda \u0dc3\u0dd2\u0dd4 \u0dc0\u0dca\u0dad\u0db8\u0ddc\u0db1\u0dba \u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0ddc \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0ddc\u0dca\u0db8\u0dda \u0dc4 . 2025 \u0dc0\u0dca\u0dc2\u0dba \u0dc0\u0db1 \u0dc0\u0dd2\u0dd4 \u0dc4\u0db8\u0db8 \u0dc0\u0dd2\u0dc2\u0dba \u0db0\u0ddc\u0dbb\u0ddc\u0dc0 \u0dad\u0ddc\u0dc3\u0dbd\u0dca 609\u0d9a\u0dca\u0d9a\u0dba \u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0ddc \u0dc0\u0dba\u0ddc\u0db4\u0dca\u0dad \u0dda\u0dbb \u0d87\u0dad.\n\n\u0d92 \u0d85\u0dd4\u0dc0\u0dc0 \u0dc3\u0dd2\u0dba \u0db8 \u0dad\u0dc5\u0ddc\u0dca \u0dc3\u0dd9 \u0d85\u0db0\u0dba\u0ddc\u0dad\u0db1 \u0dda\u0dbd\u0ddc\u0dad \u0d86\u0dc0\u0dbb\u0daf\u0dba \u0dc0\u0db1 \u0dad\u0dbb\u0dd2\u0daf\u0dd2 \u0dc4\u0dad\u0ddd\u0dbb\u0ddc \u0d9c\u0dca \u0dad\u0ddc\u0dc3\u0dbd\u0dca\u0dc0\u0dbd \u0dc3\u0dcf\u0d9b\u0dba\u0ddc\u0dca\u0db8\u0dda \u0dc0\u0dba\u0ddc\u0db4\u0dca\u0dad\u0dd2\u0db4\u0dba \u0dad\u0dd9\u0dad \u0dad\u0dbb\u0dd2\u0daf\u0dd2 \u0dc4 .\n\n\u0dad\u0ddc\u0dc3\u0dbd\u0dca \u0dad\u0dd4\u0dc5 \u0dc4\u0db8\u0db8 \u0dc0\u0dd2\u0dc2\u0dba \u0db0\u0ddc\u0dbb\u0ddc\u0dc0 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0ddc\u0dca\u0db8\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dad\u0dd9\u0dc3\u0dd4 \u0dc0\u0db1 \u0dad\u0dbb\u0dd2\u0daf\u0dd2 \u0dc3\u0dd4\u0dab \u0dbb\u0dd4 \u0dad\u0db1\u0dca\u0dad\u0dd2\u0db4 \u0dda\u0ddc\u0db8\u0dbb \u0dc4\u0d9c\u0ddc\u0da9\u0db1 \u0ddc \u0dad\u0dbb\u0dd2\u0d9c\u0daf\u0dda \u0dbd\u0dd0\u0db4\u0dca\u0dc4\u0dd4\u0ddc\u0db4\u0dca \u0dc3\u0dd4\u0dab \u0dbb\u0dd4 \u0db4\u0dd4\u0dc0\u0dbb\u0dd4 \u0d85\u0db1\u0dca\u0dad\u0dca\u0da2\u0ddc\u0dbd \u0dad\u0dd9\u0dc3\u0dd4\u0dda\u0db8\u0dca \u0dc3\u0dd9 \u0dad\u0db1\u0dca\u0dad\u0dd2\u0db4 \u0dda\u0ddc\u0db8\u0dbb \u0d8b\u0dad\u0dda\u0dbb\u0daf \u0dbd\u0db6\u0ddc \u0daf\u0dd3 \u0d87\u0dad\u0dd2\u0db4 \u0d85\u0dad\u0dbb \u0d85\u0d9b\u0dab\u0dca\u0da9\u0da9\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0ddc\u0dc4\u0dba\u0ddd\u0d9a\u0dc0\u0dda\u0dc0 \u0dc0\u0dd2\u0dc2\u0dba \u0db0\u0ddc\u0dbb\u0ddc\u0dc0 \u0dad\u0ddc\u0dc3\u0dbd\u0dca \u0dad\u0dd4\u0dc5 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0ddc\u0dca\u0db8\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dd9\u0ddc \u0dad\u0ddc\u0dc3\u0dbd\u0dca \u0dad\u0ddc \u0dda \u0db8\u0dd6\u0dbd\u0dba \u0db4\u0dca\u200d\u0dbb \u0ddc\u0db1 \u0dbd\u0db6\u0ddc \u0dc4\u0dca\".\n\n\u0dc4\u0db8\u0db8 \u0dc0\u0dd2\u0dc2\u0dba \u0db0\u0ddc\u0dbb\u0ddc\u0dc0 \u0dba\u0dd4\u0dc4\u0dca \u0d85.\u0dc4\u0dad\u0ddc.\u0dc3. \u0dc3\u0ddc\u0db8\u0ddc\u0db1\u0dba \u0dc4\u0dad\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dbd\u0dbd \u0dc4\u0db1\u0ddc\u0dc3\u0dbd\u0dda\u0ddc \u0dc3\u0dd2\u0dc3\u0dd4\u0db1\u0dca 12 \u0dc4\u0dbb\u0dca\u0dab\u0dd2\u0dba\u0dd4 \u0d87\u0dad\u0dd4\u0dc5\u0dca \u0dda\u0dbb \u0d9c\u0dd4\u0dc0 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb \u0db8\u0dd8\u0daf\u0dd4 \u0dd4\u0dc3\u0dbd\u0dad\u0ddc \u0dc3\u0dcf\u0dc0\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dd9 \u0dc0\u0dd8\u0dca\u0dad\u0dd3\u0dba \u0dc0\u0dd2\u0dc2\u0dba\u0dba\u0db1\u0dca\u0dc4\u0dd2 \u0db8\u0dd6\u0dd2\u0dda \u0dd9\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0ddc \u0daf\u0dd3\u0db8 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc4\u0dda\u0dc4\u0dbb\u0db1 \u0db8\u0ddc\u0dc3 \u0dd9\u0dba\u0dda \u0dad\u0ddc\u0dc3\u0dbd\u0dca \u0d85\u0db0\u0dba\u0dba\u0db1 \u0dda\u0ddc\u0dbd \u0dc3\u0dd3\u0db8\u0ddc\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0dc0 \u0dc3\u0dd2\u0dc3\u0dd4\u0db1\u0dca NVQ 4 \u0dc0\u0dd8\u0dca\u0dad\u0dd3\u0dba \u0db4\u0dd4\u0dab \u0dab\u0dd4 \u0dad\u0ddc\u0da8\u0db8\u0ddc\u0dbd\u0ddc 154\u0d9a\u0dca\u0d9a\u0dba \u0dc3\u0db3\u0dd9\u0ddc \u0dbb\u0da2\u0dc4\u0dda \u0dc0\u0dd8\u0dca\u0dad\u0dd3\u0dba \u0db4\u0dd4\u0dab \u0dab\u0dd4 \u0d86\u0dba\u0dad\u0db1 \u0dc4\u0dc0\u0dad \u0dc4\u0dba\u0ddc\u0dc4\u0dd4 \u0dda\u0dbb\u0dd4\u0dc0 \u0dbd\u0dd0\u0dc4\u0db6\u0dca\u0dbd. \u0dc0\u0dd8\u0dca\u0dad\u0dd3\u0dba \u0db4\u0dd4\u0dab \u0dab\u0dd4\u0dc0 \u0dc3\u0dd9 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0ddc\u0d9c\u0dad \u0db4\u0dd4\u0dab \u0dab\u0dd4\u0dc0 \u0d85\u0dc0\u0dc3\u0ddc\u0db1\u0dc4\u0dda \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0da2\u0ddc\u0dad\u0dd2\u0db4\u0dda \u0dc0\u0dd8\u0dca\u0dad\u0dd3\u0dba \u0db1\u0dd2\u0db4\u0dd4\u0daf\u0dad\u0ddc \u0d87\u0d9c\u0dd0\u0dba\u0dd3\u0db8\u0dd4 \u0dc4\u0dd4\u0dab \u0daf \u0daf\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dad\u0dbb \u0d85\u0dc0\u0dc3\u0ddc\u0db1\u0dc4\u0dda NVQ 4 \u0dc3\u0dd9\u0dad\u0dd2\u0db4\u0dda\u0dba \u0dbd\u0db6\u0ddc \u0dc4 \u0dd4\u0dc0 \u0dbd\u0dd0\u0dc4\u0db6\u0dca\u0dbd.\n\n\u0db4 \u0dcf\u0dad \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0dc3\u0d82\u0d9b\u0dba\u0dcf\u0dc0\n\n\u0db6\u0dc3\u0dca\u0db1\u0ddc\u0dc4\u0dd2\u0dbb \u0dad\u0dc5\u0ddc\u0dad 132\n\n\u0db8\u0db0\u0dba\u0db8 \u0dad\u0dc5\u0ddc\u0dad 84\n\n\u0dd4\u0dab\u0dd4 \u0dad\u0dc5\u0ddc\u0dad 59\n\n\u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0dad\u0dc5\u0ddc\u0dad 47\n\n\u0db1 \u0dd0\u0dc4 \u0db1\u0dc4\u0dd2\u0dbb \u0dad\u0dc5\u0ddc\u0dad 68\n\n\u0dc0\u0dba\u0db9 \u0dad\u0dc5\u0ddc\u0dad 69\n\n\u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db8\u0dd0 \u0dad\u0dc5\u0ddc\u0dad 46\n\n\u0d8c\u0dc0 \u0dad\u0dc5\u0ddc\u0dad 55\n\n\u0dc3\u0db6\u0dbb\u0d9c\u0dc4\u0dd4\u0dc0 \u0dad\u0dc5\u0ddc\u0dad 49\n\n\u0dc3\u0db8\u0dcf\u0dad\u0dc3\u0dca\u0dad \u0dc3\u0d82\u0d9b\u0dba\u0dcf\u0dc0 609\n\n\u0db8\u0db8 \u0dd0\u0db1\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dda\u0dc4\u0dc5\u0dca 13 \u0dc0\u0dc3\u0dbb\u0dda \u0d85\u0db0\u0dba\u0ddc\u0dad\u0db1\u0dba \u0dba\u0dd4\u0dc4\u0dca \u0dc4\u0db8\u0dc4\u0dad\u0d9a\u0dca\u0d9a\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0ddc\u0dca\u0db8\u0dda \u0dc4\u0dc0\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba.\n\n\u0db1\u0dc0 \u0d85\u0db0\u0dba\u0ddc\u0dad\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dc3\u0dcf\u0dc3\u0dca\u0dda\u0dbb\u0daf \u0dba\u0dd4\u0dc4\u0dca \u0dc4\u0db8\u0dca \u0dc0\u0dd2\u0dc2\u0dba \u0db0\u0ddc\u0dbb\u0ddc\u0dc0 - \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc4\u0db1\u0dca skills stream \u0d91\u0dda - 10 \u0dc3\u0dd9 11 \u0dc4\u0dbb\u0dca\u0dab\u0dd2 \u0dc3\u0db3\u0dd9\u0ddc \u0dd9\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0ddc\u0daf\u0dd3\u0db8\u0dd4 \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad \u0d85\u0dad\u0dbb \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0dc3\u0dd1\u0db8 \u0dad\u0ddc\u0dc3\u0dbd\u0dda\u0db8 10 11 \u0dc4\u0dbb\u0dca\u0dab\u0dd2\u0dc0\u0dbd \u0dc3\u0dd2\u0dc3\u0dd4\u0db1\u0dca \u0dc3\u0db3\u0dd9\u0ddc \u0dda\u0ddc\u0dab\u0dca\u0da9\u0da9 \u0dc0\u0dd2\u0dc2\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dc4\u0dbd\u0dc3 \u0dc4\u0db8\u0db8 \u0dc0\u0dd8\u0dca\u0dad\u0dd3\u0dba \u0dc0\u0dd2\u0dc2\u0dba\u0db1\u0dca \u0dd9\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0ddc \u0daf\u0dd3\u0db8 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd4 \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad\u0dba.\n\n\u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc4\u0db1\u0dca \u0dc4\u0dda \u0dba\u0d9a\u0dca\u0d9a\u0dba \u0db1\u0dd0\u0dad\u0dd2\u0db4\u0dc0 \u0dc3\u0dd2\u0dba \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dd4 \u0dc4\u0db8\u0dca skills sector \u0d91\u0dc4\u0d9a\u0dca\u0d9a\u0dba \u0dc0\u0dd2\u0dc2\u0dba\u0dba\u0db1\u0dca \u0dd9\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0ddc \u0dc4 \u0db1\u0dca\u0db1 \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad\u0dba\u0dd2. \u0d92 \u0dc3\u0db3\u0dd9\u0ddc \u0dc0\u0dd2\u0dc2\u0dba \u0db8\u0ddc\u0dbd\u0ddc\u0dc0 \u0dc3\u0dd9 \u0dc4\u0db8\u0ddc\u0dd2\u0da2\u0dba\u0dd4\u0dbd\u0dca \u0da2\u0ddc\u0dad\u0dd2\u0db4\u0dda \u0d85\u0db0\u0dba\u0ddc\u0dad\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc4\u0db8\u0dca \u0dc4\u0dc0\u0db1\u0dc4\u0dda\u0ddc\u0dd4 \u0dc3\u0dcf\u0dc0\u0dca\u0db0\u0db1\u0dba \u0dda\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dc0\u0dad\u0dd2\u0db4\u0db1\u0dc0\u0ddc.\n\n\u0dad\u0dc0 \u0d8b\u0dc3\u0dc3\u0dca \u0dc4\u0dad\u0dc5 \u0dc3\u0db3\u0dd9\u0ddc \u0dc0\u0dd8\u0dca\u0dad\u0dd3\u0dba \u0dc0\u0dd2\u0dc2\u0dba\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0ddc\u0dca\u0db8\u0dda \u0dda\u0dbb\u0db1 \u0dad\u0ddc\u0dc3\u0dbd\u0dca \u0dc3\u0dcf\u0d9b\u0dba\u0ddc\u0dc0 609 \u0dc3\u0dd2\u0dd4 1 000 \u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0ddc \u0dc0\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd4 \u0dda\u0dd4\u0dba\u0dd4\u0dad\u0dd4 \u0dc4\u0dba\u0ddc \u0ddc \u0d87\u0dad."
