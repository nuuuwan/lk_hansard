    "chunk_text": "\u0d85\u0d9a \u0db8\u0db8 \u0d9a\u0dd0\u0d9a\u0dca\u0d9a\u0dcf \u0dcf\u0dca\u0dd4\u0dc0 \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca \u0dc3\u0db8\u0dc4\u0dba \u0d9a\u0dd2\u0d9a\u0dc1\u0dba\u0ddd \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0daf\u0dd4\u0db4\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dba \u0d9a\u0dcf\u0dcf \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0daf\u0dd4\u0dc2\u0dca\u0da8\u0dba\u0dcf\u0dd4\u0dc0 \u0daf\u0dca\u0db0\u0dc0 \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0d9a\u0dcf. \u0dc4\u0dd0 \u0dd0\u0dba\u0dd2 \u0dca\u0dd2\u0dc0\u0db1\u0dca\u0dad \u0dcf\u0dca\u0dd4\u0dc0 \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0db1\u0dca\u0dad \u0d9a\u0dc5 \u0d92 \u0dc4\u0dd0\u0db8 \u0d9a\u0dcf\u0dcf\u0dc0\u0d9a\u0daf\u0dd3\u0db8 \u0dca\u0dd2\u0dc0\u0dc4\u0dcf\u0dc3\u0dba \u0d9c\u0dd0\u0db1 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0db8\u0dd2\u0dc3\u0d9a\u0dca \u0d85\u0db1\u0dcf\u0d9c\u0dad\u0dba \u0dc3\u0dc4 \u0dca\u0d9a\u0d9a\u0dca\u0d9a\u0dc0\u0d9a\u0da7 \u0dba\u0db1 \u0dc0\u0dd0\u0dcf \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dc0\u0dc5 \u0d9c\u0dd0\u0db1 \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4\u0dc0\u0dad\u0dca \u0d9a\u0dcf\u0dcf \u0d9a\u0dc1\u0dc5\u0dda \u0db1\u0dd0\u0dc4\u0dd0 \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0dca\u200d\u0dba \u0d9a\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0db8\u0db1\u0dd2. \u0dca\u200d\u0dbb \u0dda\u0db1\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0dca\u200d\u0dbb \u0dda\u0db1\u0dba \u0d85\u0db4\u0dd2 \u0d9a\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf. \u0dca\u200d\u0dbb \u0dda\u0db1\u0dba \u0d9a\u0db1\u0dca\u0dad\u0db1\u0dcf \u0db1\u0dd2\u0dc3\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0dcf\u0dca\u0dd4\u0dc0 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dd4\u0dc0\u0dd6\u0dbd\u0d9a\u0dc0 \u0db8\u0dcf\u0dbb\u0dd4 \u0dc1\u0dc0\u0d9a\u0dcf\n\n\u0db4\u0dc3\u0dd4\u0dd2\u0dba \u0d9a\u0dc0\u0dc3\u0d9a \u0d85\u0dd2\u0dc0\u0d9c\u0dbb\u0dd4 \u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0dc0\u0dd4\u0db8\u0dcf \u0dcf\u0dc1\u0dba\u0ddd\u0dca\u200d\u0db1 \u0dc3\u0dda \u0db1\u0dca\u0dad\u0db0\u0dc1\u0dba\u0db1\u0dca\u0dad \u0d9a\u0dcf\u0dcf \u0d9a\u0dc5\u0dcf. \u0d91\u0d9a\u0dca\u0dad\u0dba\u0dcf \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0dba\u0dc1\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0dc1\u0dcf \u0dcf\u0d9a\u0dbb\u0dca\u0dbd \u0db8\u0dd2\u0dd2\u0dba\u0db1 65 \u0d9a \u0dcf\u0dc1\u0dba\u0ddd\u0dca\u200d\u0db1 \u0dad\u0daf\u0dd4\u0dbd\u0dcf\u0d9a\u0dcf \u0dd2\u0dc0\u0dc1 \u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0d9a\u0dcf. \u0dc4\u0dd0 \u0dd0\u0dba\u0dd2 \u0d85\u0dc1\u0db1\u0d9a\u0dca \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0db1\u0dca\u0dad \u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0dc0\u0dc0\u0dba\u0dba\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0dc1\u0dcf \u0dcf\u0d9a\u0dbb\u0dca\u0dbd \u0db8\u0dd2\u0dd2\u0dba\u0db1 \u0d85\u0db1\u0dd6 \u0d9c\u0dda\u0db1\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0dcf\u0dc1\u0dba\u0ddd\u0dca\u200d\u0db1 \u0dad\u0daf\u0dd4\u0dbd\u0dcf\u0d9a\u0dcf \u0dd2\u0dc0\u0dc1 \u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0d9a\u0dcf. \u0d8a\u0da7 \u0db4\u0dc3\u0dda\u0dc1\u0dc3\u0dda \u0d92\u0d9a \u0db1\u0dd2\u0dc0\u0dd0\u0dba\u0daf\u0dd2 \u0d9a\u0dba\u0d9a\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0dc1\u0dcf \u0dcf\u0d9a\u0dbb\u0dca\u0dbd \u0db6\u0dd2\u0dd2\u0dba\u0db1 .6\u0d9a \u0dcf\u0dc1\u0dba\u0ddd\u0dca\u200d\u0db1 \u0d85\u0db4\u0dd2 \u0dc3\u0dd0\u0d9a\u0dc3\u0dd4\u0dda \u0d9a\u0dba \u0dd2\u0dc0\u0dc1 \u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0d9a\u0dcf. \u0d94 \u0dd4\u0db8\u0db1\u0dca\u0dad\u0d9a\u0dcf\u0db8 \u0db4\u0dad\u0dca \u0d9a\u0dba\u0db4\u0dd4 BOI \u0d91\u0dc1\u0d9a\u0dca \u0dc3\u0dcf\u0dcf\u0db4\u0dd2\u0dc0\u0dc0\u0dba\u0dba\u0dcf \u0db4\u0dc3\u0dd4\u0dd2\u0dba \u0daf\u0dd2\u0dc1\u0db1\u0d9a \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0dca\u0db1\u0dca\u0dad\u0daf\u0dd2\u0dba\u0dcf\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0dc3\u0dc4 \u0da0\u0dd3\u0db1\u0dc1\u0dba\u0db1\u0dca\u0dad \u0d9a\u0d82\u0d9a\u0dcf\u0dc0\u0da7 \u0d91\u0db1\u0dca\u0dad\u0db1 \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad \u0dc1\u0dcf \u0dcf\u0d9a\u0dbb\u0dca\u0dbd \u0db6\u0dd2\u0dd2\u0dba\u0db1 \u0dc4\u0dad\u0dba\u0dba\u0dd2 \u0d9a \u0db8 \u0d9c\u0dda\u0db1\u0d9a \u0dd4\u0db1\u0dba\u0dd2 \u0d9a \u0db8 \u0d9c\u0dda\u0db1\u0d9a \u0d91\u0d9a\u0dba\u0dd2 \u0d9a \u0db8 \u0d9c\u0dda\u0db1\u0d9a -\u0db1\u0dd2\u0dc0\u0dd0\u0dba\u0daf\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0- \u0dcf\u0dc1\u0dba\u0ddd\u0dca\u200d\u0db1 \u0d9a\u0d82\u0d9a\u0dcf\u0dc0\u0da7 \u0d92\u0db8 \u0db4\u0dd2\u0dd2\u0db6 \u0db3\u0dc0 \u0db1\u0dd2 \u0dda\u0da0\u0dd2\u0dad \u0dad\u0dd3\u0db1\u0dca\u0dad\u0dbd\u0dd2\u0dc0\u0d9a\u0dca \u0d92 \u0dcf\u0dba\u0dad\u0db1 \u0dc3\u0dc4 BOI \u0d91\u0d9a \u0d85\u0dad\u0dba \u0dad\u0dc0\u0db8\u0dad\u0dca \u0d85\u0dba\u0dc1\u0d9c\u0db1 \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0d9a\u0dcf. \u0d91\u0dad\u0dc1\u0d9a\u0dcf\u0da7 \u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0dc0\u0dc0\u0dba\u0dba\u0dcf\u0da7 \u0dc1\u0dda \u0dca\u0d9a\u0d9a\u0dca\u0d9a\u0dda \u0dc1\u0d9a\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0d9a\u0dc0\u0dd4\u0d9a? \u0d94 \u0dd4\u0db8\u0db1\u0dca\u0dad\u0d9a\u0dcf \u0dc1\u0dda fiscal policy \u0dc4\u0d9a\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dc1\u0dda \u0dba\u0dc1\u0da7\u0dca \u0dcf\u0dc1\u0dba\u0ddd\u0dca\u200d\u0db1 \u0dc3\u0dd0\u0d9a\u0dd0\u0dc3\u0dda\u0db8\u0dc0\u0dbd\u0dcf \u0dc4\u0d9a\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0db8\u0db1\u0dc3\u0dda\u0d9c\u0dcf\u0dad\u0dba\u0d9a\u0dca \u0d94\u0dc5\u0dd4\u0dc1\u0dda \u0dd2\u0dc0\u0dba\u0dcf\u0dc1\u0d9c\u0db1; \u0dd3\u0db8\u0db1 \u0db8\u0dcf\u0dd2\u0db6\u0d9c\u0dcf\u0dc0\u0d9a\u0dca \u0dc4\u0d9a\u0dcf\u0dc1\u0d9c\u0db1. \u0d94 \u0dc4\u0dd2\u0dad\u0db1\u0dc0\u0dcf \u0d85\u0dba \u0dcf\u0dc1\u0dba\u0ddd\u0dca\u200d\u0d9a\u0dba\u0dcf \u0d91\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0d9a\u0dcf. \u0dc4\u0dd0 \u0dd0\u0dba\u0dd2 \u0d92 \u0dcf\u0dc1\u0dba\u0ddd\u0dca\u200d\u0d9a\u0dba\u0dcf \u0d91\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0db1\u0dd0\u0dc4\u0dd0. \u0d91\u0dc1\u0dc4\u0db8 \u0dc4\u0dd2\u0dad\u0d9a\u0dcf \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0dad\u0daf\u0dd4\u0dbd\u0dcf\u0d9a\u0dcf \u0dc1\u0db1\u0dcf\u0dda\u0db8\u0dba \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0d9a\u0dcf \u0dc3\u0dba\u0dba\u0da7 1 \u0d9a \u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba\u0d9a\u0dca \u0dc4\u0d9a\u0dcf\u0dc1\u0d9c\u0db1 \u0dba\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf. \u0dc4\u0dd0 \u0dd0\u0dba\u0dd2 ADB \u0d91\u0d9a \u0dc3\u0dba\u0dba\u0da7 3.6 \u0d9a \u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba\u0d9a\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0dda \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0dc1\u0daf\u0dca project \u0d9a\u0dba\u0d9a\u0dcf \u0dd2\u0dc0\u0dc1 \u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad. \u0dc4\u0dd0 \u0dd0\u0dba\u0dd2 \u0d94 \u0dd4\u0db8\u0db1\u0dca\u0dad\u0d9a\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0d85\u0db4\u0dd2 \u0dc3\u0dba\u0dba\u0da7 1 \u0d9a \u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba\u0d9a\u0dca \u0dc4\u0d9a\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0d9a\u0dcf. \u0dc3\u0dba\u0dba\u0da7 1 \u0d9a \u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba\u0d9a\u0dca \u0dc4\u0d9a\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0d85\u0dd4\u0db8 \u0d9c\u0dda\u0dc1\u0db1\u0dca\u0dad \u0d85\u0dba \u0d91\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0dcf\u0dc1\u0dba\u0ddd\u0dca\u200d\u0db1 \u0dc1\u0d9c\u0db1\u0dca\u0dad\u0db1 \u0d9c\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf \u0db1\u0dda. \u0dc4\u0dd0 \u0dd0\u0dba\u0dd2 \u0d92 \u0dcf\u0dc1\u0dba\u0ddd\u0dca\u200d\u0db1 \u0dc1\u0d9c\u0db1\u0dca\u0dad\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dca\u0db1\u0dca\u0dad\u0db1 \u0dcf\u0dc1\u0dba\u0ddd\u0dca\u200d\u0d9a\u0dc1\u0dba\u0ddd\u0dad\u0dca \u0dba\u0db1\u0dc0\u0dcf."
