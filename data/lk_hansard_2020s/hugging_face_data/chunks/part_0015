    "chunk_text": "\u0d85\u0dc1\u0dda \u0dc0\u0da7\u0d9c\u0dc0 \u0dc3\u0dc1\u0dc4\u0ddd\u0daf\u0dca\u200d\u0dba\u0dba\u0dcf \u0d9a\u0dd2 \u0dc0\u0dcf \u0dc4\u0dca\u0daf\u0dca\u200d\u0dba \u0dc3\u0dcf\u0d9a\u0dca\u0dc2\u0dd2\u0dba\u0d9a\u0dca \u0d9c\u0dd0\u0db1. \u0dc4\u0dca\u0daf\u0dca\u200d\u0dba \u0dc3\u0dcf\u0d9a\u0dca\u0dc2\u0dd2\u0dba\u0da7 \u0d85\u0db7\u0dd2\u0dc1\u0dba\u0ddd\u0d9c \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0d9c\u0dc0\u0d9a\u0dc0\u0db1\u0dca\u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0dc0\u0dcf \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0dad\u0dab\u0dc0\u0dcf. \u0d9c\u0dc0\u0d9a\u0dc0\u0db1\u0dca. \u0dad\u0dba\u0dd2? \u0db8\u0dd4\u0da2\u0dd2\u0db6\u0dd4\u0dbb\u0dca \u0dba\u0dab\u0db8\u0dcf\u0db1\u0dca \u0dc3\u0dc4 \u0dc3\u0da2\u0dd2\u0dad\u0dca \u0dc1\u0db4\u0dca\u200d\u0dbb\u0dda\u0db8\u0daf\u0dca\u200d\u0dcf\u0dc3 \u0dad\u0dad\u0dd4\u0dc0\u0d9a \u0db1\u0da9\u0dba\u0da7 \u0dc1\u0d9a\u0dbd\u0dc1\u0dc4\u0dda\u0daf\u0dca\u200d \u0dc4\u0dca\u0daf\u0dca\u200d\u0dba \u0dc3\u0dcf\u0d9a\u0dca\u0dc2\u0dd2\u0dba\u0d9a\u0dca? \u0dc1\u0d9a\u0dbd\u0dc1\u0dc4\u0dda\u0daf\u0dca\u200d \u0dc4\u0dca\u0daf\u0dca\u200d\u0dba \u0dc3\u0dcf\u0d9a\u0dca\u0dc2\u0dd2\u0dba\u0d9a\u0dca? \u0db8\u0da7\n\n\u0db8\u0da7 \u0db8\u0dad\u0d9a\u0dba\u0dd2 \u0da7 \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0dd2 \u0db6\u0dd4\u0dab\u0dd4 \u0da1\u0db1\u0dca\u0daf\u0dca\u200d\u0dc1\u0dc0\u0daf\u0dd3 \u0dd9\u0db1\u0dad\u0dcf\u0dc0 \u0d92\u0d9a \u0dba\u0dcf\u0dc1\u0dd2 \u0d9a\u0dba\u0dc1\u0d9c\u0db1 \u0dd9\u0db1\u0dad\u0dcf\u0dc0\u0dc1\u0d9c\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb \u0dcf\u0db1 \u0d9a\u0dba\u0db1\u0dc0\u0dcf \"\u0dc1\u0db8\u0dca \u0dc1\u0dc4\u0dbd\u0dba \u0dad\u0d9a\u0dca\u0d9a\u0dd2 \u0dd6 \u0dc2\u0dd2\u0dad \u0dc1\u0db4\u0dbd\u0dc1\u0dc4\u0dbd\u0da7\u0dca\u0da7\u0dd4\u0dc0\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0d85\u0db4\u0dd2 \u0d91\u0d9a\u0dad\u0dd4 \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0db8\u0daf\u0dca\u200d?\" \u0d9a\u0dd2\u0dba\u0dc0\u0dcf. \u0dd9\u0db1\u0dad\u0dcf\u0dc0 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \"\u0d91\u0db4\u0dcf\" \u0d9a\u0dd2\u0dba\u0dc0\u0dcf. \u0d91\u0dc1\u0dc4\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0d9a\u0dd2 \u0dc1 . \u0d91\u0dc1\u0dc4\u0db8 \u0d9a\u0dd2\u0dba \u0d9c \u0d85\u0dba\u0da7 \u0d85\u0daf\u0dca\u200d \u0dc1\u0db4\u0dbd\u0dc1\u0dc4\u0dbd\u0da7\u0dca\u0da7\u0dd4\u0dc0\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0d91\u0d9a\u0dad\u0dd4 \u0dc1\u0dc0\u0dc0\u0dcf \u0dc3\u0dcf\u0dcf \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0db1\u0dca\u0db1 \u0dc4\u0daf\u0dca\u200d\u0db1\u0dc0\u0dcf. \u0dc4\u0dca\u0daf\u0dca\u200d\u0dba \u0dc3\u0dcf\u0d9a\u0dca\u0dc2\u0dd2\u0dba\u0d9a\u0dca \u0dc1\u0d9a\u0dbd\u0dc1\u0dc4\u0dda\u0daf\u0dca\u200d? \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d9a\u0dd4\u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dc1\u0dc1\u0dd3\u0dba\u0dba \u0dc3\u0dcf\u0dcf\u0dc1 \u0dc1\u0d9a\u0dbd\u0da7\u0dca\u0db0\u0dcf\u0dc3 \u0dd2\u0dc3\u0dba\u0dbd\u0dca\u0dc0\u0db8 \u0d85\u0db4\u0dd2 \u0daf\u0dd2\u0db1\u0dd4\u0db8\u0dca. \u0db8\u0db1\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4 21\u0dc1\u0daf\u0dca\u200d\u0dc1\u0db1\u0d9a\u0dca \u0dd2\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0d85\u0db4\u0dd2\u0da7. \u0db8\u0db1\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4 21\u0dba\u0dd2 \u0dd9\u0dcf\u0dd2 \u0d9a \u0dd9\u0db1 \u0db3\u0dc0\u0dc1 \u0d9c\u0dba\u0da7; \u0db8\u0dcf\u0dbd\u0dd2\u0db8\u0dcf\u0dc0\u0da7. \u0dc3\u0dd9\u0db3\u0dba\u0da7 \u0db8\u0db1\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4 9\u0dc1\u0daf\u0dca\u200d\u0db1\u0dcf\u0dba\u0dd2. \u0dc1\u0db4\u0dbd\u0dc1\u0dc4\u0dbd\u0da7\u0dca\u0da7\u0dd4\u0dc0\u0da7 \u0db8\u0db1\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4 6\u0dc1\u0daf\u0dca\u200d\u0db1\u0dcf\u0dba\u0dd2. \u0db8\u0db1\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4 6\u0dc1\u0daf\u0dca\u200d\u0dc1\u0db1\u0d9a\u0dca \u0dc4\u0dd2\u0da7 \u0d9c \u0dc1\u0db4\u0dbd\u0dc1\u0dc4\u0dbd\u0da7\u0dca\u0da7\u0dd4\u0dc0\u0da7 \u0dc3\u0dcf\u0dcf\u0db4\u0dd2 \u0d9a\u0db8 \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf \u0d94\u0dba \u0dc3\u0da2\u0dd2\u0dad\u0dca \u0dc1\u0db4\u0dca\u200d\u0dbb\u0dda\u0db8\u0daf\u0dca\u200d\u0dcf\u0dc3\u0dc0\u0dcf. \u0dc1\u0d9a\u0dbd\u0dc1\u0dc4\u0dda\u0daf\u0dca\u200d \u0dc4\u0dca\u0daf\u0dca\u200d\u0dba \u0dc3\u0dcf\u0d9a\u0dca\u0dc2\u0dd2\u0dba\u0d9a\u0dca? \u0d92\u0dc1\u0d9c\u0dbd\u0dbd\u0dca\u0dc0\u0db1\u0dca \u0d91\u0dc1\u0dc4\u0db8 \u0dc4\u0dca\u0daf\u0dca\u200d\u0dba \u0dc3\u0dcf\u0d9a\u0dca\u0dc2\u0dd2\u0dba\u0d9a\u0dca \u0dd2 \u0dc1\u0db3\u0db1 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dcf\u0dd4\u0db1 \u0dc1\u0db1\u0dbd\u0dc1\u0dc0\u0dba\u0dd2. \u0d92\u0d9a \u0dc4\u0db4\u0dad \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dbd\u0dd2\u0dba\u0dd2. \u0da7 \u0db4\u0dc3\u0dcf\u0dc1\u0dc3\u0dda \u0d8b\u0db4 \u0dc3\u0dcf\u0dcf\u0db4\u0dd2 \u0d9a\u0db8 \u0dc1\u0daf\u0dca\u200d\u0db1\u0dc0\u0dcf \u0db8\u0db1\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4 \u0dc1\u0daf\u0dca\u200d\u0dc1\u0daf\u0dca\u200d\u0db1\u0d9a\u0dd4 \u0dc4\u0dd2\u0da7 \u0d9c \u0d9a\u0da7\u0dca\u0da7\u0dd2\u0dba\u0da7. \u0d85\u0db4\u0dd2\u0da7 \u0db8\u0db1\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4 21\u0dc1\u0daf\u0dca\u200d\u0dc1\u0db1\u0d9a\u0dca \u0dd2\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d9a\u0dd4\u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dc1\u0dc1\u0dd3\u0dba\u0dba \u0dc3\u0dcf\u0dcf\u0dc1 \u0dc0\u0dd0\u0dd2 \u0db8 \u0db8\u0db1\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0da7\u0dba\u0d9a\u0dca \u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d85\u0db4\u0da7.\n\n\u0dad\u0dad\u0dca\u0dad\u0da7\u0db8 \u0d85\u0daf\u0dca\u200d \u0d8b\u0dc1\u0dc1 \u0dd2\u0dc0\u0dc0\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca\u0dad\u0dca\u0dd2 \u0dc1\u0d9c\u0dbd\u0da9\u0d9a\u0dca \u0d91\u0db1\u0dca\u0db1 \u0db4\u0da7\u0db1\u0dca \u0d9c\u0dad\u0dca\u0dad\u0dcf. \u0dc1\u0dc0 \u0dc1\u0d9a\u0dbd\u0dc1\u0dc4\u0dbd\u0db8\u0da7\u0dad\u0dca \u0dc1\u0d9a\u0dbd\u0dc5\u0db9 \u0db8\u0dc4 \u0db1\u0d9c\u0dba \u0dc3\u0dcf\u0dcf\u0dc1 \u0dd2\u0dc3\u0daf\u0dd4\u0dc0\u0dd3\u0dc1\u0db8\u0db1\u0dca \u0dc4\u0dad\u0dba\u0d9c\u0dcf\u0dc1\u0dad\u0dca \u0daf\u0dca\u200d\u0dcf\u0dc0\u0dcf \u0dc0\u0dd0\u0da7\u0dd4\u0da7\u0dcf. \u0d85\u0daf\u0dca\u200d\u0dad\u0dca \u0d91\u0db1\u0dca\u0db1 \u0db4\u0da7\u0db1\u0dca \u0d9c\u0dad\u0dca\u0dad\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca\u0dad\u0dca\u0dd2 \u0dc1\u0d9c\u0dbd\u0da9\u0d9a\u0dca. \"\u0db8\u0dcf\u0dbd\u0dd2\u0db8\u0dcf\u0dc0 \u0d9c\u0dad\u0dca\u0dad\u0dc0\u0db8 \u0db8\u0dc4 \u0db1\u0d9c\u0dba \u0dc3\u0dcf\u0dcf\u0dc1 \u0db3\u0dc0\u0dba \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dba\u0dd2\" \u0d9a\u0dd2\u0dba\u0dc0\u0dcf \u0dda\u0dc0 10.32\u0da7 \u0d9a\u0dc0\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca\u0dad\u0dca\u0dd2 \u0dba. \"\u0db8\u0dcf\u0dbd\u0dd2\u0db8\u0dcf\u0dc0 \u0dc0\u0dd0\u0dbd\u0dd2\u0d9a\u0db1\u0dca\u0daf\u0dca\u200d \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dc1\u0dc1\u0dd3\u0dba\u0dba \u0dc3\u0dcf\u0dcf\u0dc1 \u0db3\u0dc0\u0dba \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dba\u0dd2\" \u0d9a\u0dd2\u0dba\u0dc0\u0dcf \u0dc5\u0dd9 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca\u0dad\u0dca\u0dd2 \u0dba \u0d9a\u0dc0\u0dcf. \u0dd2\u0db1\u0dca\u0db4\u0dd4\u0db1\u0dc0 \"\u0db8\u0dcf\u0dbd\u0dd2\u0db8\u0dcf\u0dc0 \u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dcf\u0dc0 \u0daf\u0dca\u200d\u0d9a\u0dd4\u0da7 (\u0dd2\u0dc3\u0d82\u0dc4\u0dc0) \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dc1\u0dc1\u0dd3\u0dba\u0dba \u0dc3\u0dcf\u0dcf\u0dc1 \u0db3\u0dc0\u0dba \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dba\u0dd2\" \"\u0db8\u0dcf\u0dbd\u0dd2\u0db8\u0dcf\u0dc0 \u0d9a\u0dd4\u0dbb\u0dd4\u0da7\u0db8\u0d9c\u0dc0 \u0db8\u0dc4 \u0db1\u0d9c\u0dba \u0dc3\u0dcf\u0dcf\u0dc1 \u0db3\u0dc0\u0dba \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dba\u0dd2\" \u0d9a\u0dd2\u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca\u0dad\u0dca\u0dd2 \u0d9a\u0dc0\u0dcf. \u0da1\u0db1\u0dca\u0daf\u0dca\u200d \u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dbd\u0dc0 \u0d91\u0d9a\u0dd2\u0db1\u0dca \u0d91\u0d9a \u0d91\u0db1\u0dca\u0db1 \u0db4\u0da7\u0db1\u0dca \u0d9c\u0dad\u0dca\u0dad\u0dcf. \" \u0d9c\u0dad\u0dca\u0dad\u0dc0\u0db8 \u0db8\u0dc4 \u0db1\u0d9c\u0dba \u0dc3\u0dcf\u0dcf\u0dc1 \u0db1\u0dc0 \u0db1\u0d9c\u0dba\u0dcf\u0db0\u0dd2\u0db4\u0dd2 \u0dc1\u0dc0\u0dc3 \u0dd9\u0dcf\u0dd2 \u0d9a \u0dd9\u0db1 \u0db3\u0dc0\u0dc1 \u0d9c\u0dc1\u0dc0 \u0db4\u0dad\u0db1\u0dca\u0dc3\u0dcf\u0da9\u0dca \u0d85\u0dc4\u0db8\u0da9\u0dca \u0db1\u0dd2\u0dad\u0dba\u0d9c\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0dad\u0dca\u0dbb\u0dd3 \u0db4\u0dad\u0dca \u0dc1\u0dc0\u0dba\u0dd2\" \u0d9a\u0dd2\u0dba\u0dc0\u0dcf \u0dad\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca\u0dad\u0dca\u0dd2 \u0dba\u0d9a\u0dca \u0d9a\u0dc0\u0dcf. \u0dc1\u0db8\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca\u0dad\u0dca\u0dd2 \u0d91\u0d9a\u0dd2\u0db1\u0dca \u0d91\u0d9a \u0d91\u0db1\u0dca\u0db1 \u0db4\u0da7\u0db1\u0dca \u0d9c\u0dad\u0dca\u0dad\u0dcf. \u0dad\u0dc4\u0db1\u0db8\u0dca \u0d8b\u0dad\u0dca\u0dc1\u0dad\u0dca\u0dd9\u0d9a \u0d9c\u0dd0\u0dab\u0dc0\u0dcf \u0dc0\u0dcf\u0dc1\u0dda \u0d9a\u0da7\u0dca\u0da7\u0dd2\u0dba \u0db4\u0dd0\u0db1\u0dc0\u0dcf \u0daf\u0dd2 \u0dc0\u0dcf. \u0d91\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0dc1\u0db8\u0dca \u0dd2\u0dba\u0dcf\u0db1- \u0dbb\u0dcf\u0dba\u0dc0 \u0dd4\u0dad\u0dc1\u0db0\u0dba \u0d9c\u0dd0\u0db1 \u0d9a\u0dcf\u0dcf \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0daf\u0dd4\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0dc0\u0dcf \u0dc1\u0db1\u0dbd\u0dc1\u0dc0\u0dba\u0dd2 \u0db4\u0dd0\u0db1\u0dc0\u0dcf \u0daf\u0dd2 \u0dc1 ."
