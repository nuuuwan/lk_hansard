    "chunk_text": "\u0d85\u0db4\u0dd2 \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3 \u0db4\u0dd4\u0dba\u0dcf \u0d85\u0d9a\u0dbb\u0d9a\u0dba\u0dab\u0dc0\u0dbd\u0dd3 \u0dc0\u0dd2\u0d9c \u0dda\u0dc2\u0dca\u0da8\u0d9c\u0dba\u0db1\u0dca\u0daf \u0daf\u0dd0\u0d9a\u0db4\u0dd4 \u0d9a\u0dcf\u0dba\u0dab\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0d85\u0dc0\u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca, \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca\u0daf \u0db1\u0dd3\u0dad\u0dd2\u0d9c \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0d85\u0dca \u0dbd\u0dd4\u0dad\u0dbb\u0dca\u0d9a\u0db8\u0dca \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca\u0daf \u0dad\u0dad\u0dd4\u0dd9\u0db4 \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca\u0daf; \u0db1\u0dd3\u0dad\u0dd2\u0d9c \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0db1 \u0db1\u0dd0\u0dad\u0dd2 \u0dad\u0dd0\u0db1\u0dca\u0daf\u0dc0\u0dd2\u0db1\u0dca\u0daf \u0dad\u0dad\u0dd4\u0dd9\u0db4 \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0dbd\u0dcf \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0d85\u0dc0\u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dd9 \u0d85\u0dc0\u0dc3\u0dda\u0dae\u0dcf \u0d89\u0dc3\u0dda\u0db8\u0dad\u0dd4 \u0db8\u0dad\u0dd4 \u0d9c\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u0d9c\u0dc4\u0db8 \u0dad\u0dd0\u0db1\u0dca\u0daf \u0d85\u0db4\u0dd2 \u0d9c\u0dc0\u0db1\u0dc3\u0dda \u0d9a\u0dba\u0db1\u0dca\u0daf\u0db1 \u0d95\u0db1\u0db8. \u0d91\u0d9c\u0dc4\u0db8 \u0dad\u0dd0\u0db1\u0dca\u0daf \u0d9c\u0dc0\u0db1\u0dc3\u0dda \u0d9a\u0dba\u0db1\u0dca\u0daf\u0db1 \u0dad\u0db8\u0dba\u0dd2 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4 \u0d85\u0db4\u0db4 \u0db6\u0dbd\u0dba \u0dd4\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca\u0daf. \u0d91\u0d9c\u0dc4\u0db8 \u0dad\u0dd0\u0db1\u0dca\u0daf\u0dc0\u0dbd\u0db4 \u0dc3\u0d82\u0d9c \u0ddd\u0db0\u0db1 \u0d9c\u0d9c\u0d9c\u0db1\u0db1\u0dca\u0daf\u0db1 \u0dad\u0db8\u0dba\u0dd2 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4 \u0d85\u0db4\u0db4 \u0db6\u0dbd\u0dba \u0dd3 \u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca\u0daf. \u0dc0\u0dd2\u0d9c \u0dda\u0dc2\u0dca\u0da8\u0d9c\u0dba\u0db1\u0dca\u0daf \u0db8\u0dad [ \u0d9a\u0dba\u0db1\u0dca\u0daf\u0db1 \u0d95\u0db1\u0db8 \u0d9c\u0daf\u0dba [ \u0dad\u0db8\u0dba\u0dd2 \u0dad\u0dad\u0dd0\u0db8\u0dca \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1, \u0dad\u0dad\u0dd0\u0db8\u0dca \u0db4\u0dd4\u0dab\u0dba \u0d86\u0dba\u0dad\u0db1 \u0db4\u0daf\u0db1\u0db8\u0dca \u0dc4\u0daf\u0dcf\u0d9c\u0d9c\u0db1, - \u0dc0\u0dd2\u0d9c \u0dda\u0dc2\u0dca\u0da8\u0d9c\u0dba\u0db1\u0dca\u0daf \u0db1\u0dd4\u0dc0\u0dba\u0d91\u0dc5\u0dd2\u0dba \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2 [\u0d9a\u0d9c \u0dc3\u0dc4 \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dba \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2 [\u0d9a\u0d9c - \u0d9c\u0dc3\u0dda, \u0d9c\u0dca \u0dc0\u0dbd\u0db4 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dd2\u0da7\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0dcf\u0d9c\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0daf\u0db1\u0dc0\u0dcf; \u0db4\u0daf\u0db1\u0db8\u0dca \u0dc4\u0daf\u0dcf\u0d9c\u0d9c\u0db1, \u0dc3\u0dda\u0dc0\u0dcf\u0db7\u0dcf\u0dc0\u0dd2\u0d9a \u0db4\u0dbb\u0dd2\u0dc3\u0dba\u0dba\u0db4 \u0d85\u0dba\u0dd2\u0dad\u0dd2 \u0d9a\u0db3\u0dd4 \u0db8\u0dd4\u0dd4\u0db1\u0dca\u0daf\u0dc0\u0dbd\u0db4 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dd2\u0da7\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0dcf\u0d9c\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0daf\u0db1\u0dc0\u0dcf . \u0db8\u0dd4\u0daf\u0dca \u0dc0\u0dd2\u0dc1\u0dd4\u0dda\u0d9a\u0dbb\u0d9a\u0dba\u0dab\u0dba \u0d9a\u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d9a\u0dc0) \u0dc3\u0dca \u0dd2 \u0dc3\u0dd4\u0dd4 \u0d9a\u0dba\u0db1\u0dca\u0daf\u0db1 \u0db4\u0daf\u0db1\u0db8\u0dca \u0d85\u0db4\u0dc0\u0dcf\u0d9c\u0d9c\u0db1 \u0dc4\u0dd2\u0db4\u0db4\u0dd4 \u0d85\u0dc0\u0dc3\u0dda\u0dae\u0dcf \u0d85\u0db4\u0dd2 \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0d9c \u0daf\u0dd0\u0d9a\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3