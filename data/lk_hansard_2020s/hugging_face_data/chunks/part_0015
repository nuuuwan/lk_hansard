u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d92\u0dc0\u0dcf \u0dc1\u0dc3\u0dcf\u0dba\u0dcf\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d92 \u0dc3\u0dd2\u0dba\u0dbd\u0dca\u0dcf \u0db8\u0dcf \u0dc3 \u0dcf\u0d9c\u0dad \u0d9a \u0d87\u0dd4\u0dab\u0dd4 \u0db8\u0dca\u0dc0\u0dcf \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf.\n\n(iv) \u0d94 .\n\n2021/22 \u0db8\u0dc4 \u0d9a\u0db1\u0dca\u0db1\u0dc1 \u0dc3\u0dd2\u0da7 \u0dc0\u0dd3 \u0d85\u0dc1\u0dcf\u0dd2\u0db0 \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dc1 \u0d9a\u0dcf\u0dcf\u0db4 \u0dc4\u0dba\u0dc4\u0dcf \u0dc1\u0d9c\u0dcf\u0dc0\u0dd3\u0db1\u0dca\u0dc1\u0d9c\u0db1\u0dca \u0db8\u0dd2\u0dcf\u0da7 \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dcf\u0daf \u0dc0\u0dd3 \u0dc1\u0dad\u0dcf\u0d9c \u0dc3\u0dd4\u0dc5\u0dd4 \u0dc4\u0dcf \u0db8\u0db0\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0da7 \u0dc1\u0db8\u0ddd\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0dba\u0db1\u0dca \u0dc4\u0dba\u0dc4\u0dcf \u0dc1\u0d9a\u0da7\u0dd4\u0db8\u0dca \u0d9a\u0dd4\u0dbd\u0dd3 \u0dc1\u0d9c\u0dc0\u0dcf \u0dc3\u0dc4\u0dbd\u0dca \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca\u0d9a\u0dba \u0dc3\u0dc1\u0dad\u0dcf\u0dc3 \u0dc4\u0dba\u0dc4\u0dcf \u0daf\u0dd2\u0dc3\u0dda\u0dd2 [\u0d9a \u0dc1\u0dc0\u0dad \u0dc1\u0db6\u0daf\u0dcf \u0dc4\u0dd0\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 [ \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dba\u0db1 \u0dcf \u0da2. \u0d91\u0db8 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0dd2\u0daf\u0dd2\u0dbb\u0dd2\u0dc1 \u0da2 \u0dba\u0db1\u0dc1 \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca\u0dc0\u0dd3\u0db8 [ \u0dc4\u0dba\u0dc4\u0dcf \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a \u0dc4\u0dd0\u0d9a\u0dd2\u0dba.\n\n(\u0d87) \u0d85\u0daf\u0dcf \u0dc1\u0db1\u0dcf\u0dc1 .\n\n\u0d9c\u0dd4 \u0dbb\u0dd3 \u0d9a\u0dd4\u0dab\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bb0\u0bb5\