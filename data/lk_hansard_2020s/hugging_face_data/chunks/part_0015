    "chunk_text": "\u0dad\u0dca\u0dca\u0dc0\u0dba \u0dad\u0dd4\u0dc5 - \u0dbb\u0ddc\u0da2\u0dad\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dbd\u0ddc\u0dd4 \u0db6\u0dbd\u0dba\u0dd4 \u0d92\u0db8 \u0dc3\u0db3\u0dd9\u0ddc \u0db1\u0dd2\u0dca\u0db8\u0ddc\u0daf\u0dba \u0dda\u0dbb\u0db4\u0dd4 \u0d92 objective situation \u0d91\u0dda \u0dad\u0dd4\u0dc5 - \u0dad\u0db8\u0dba\u0dd2 \u0dc4\u0db8\u0dca\u0dda \u0dc3\u0dd2\u0dca\"\u0db0 \u0dc0\u0dd4\u0dc4\u0dab\u0dca\u0da9. \u0d92\u0dca \u0d92\u0dda \u0dc0\u0dc5\u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0ddc \u0d9c\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0db4\u0db6\u0dd4\u0daf\u0ddc. \u0d95\u0db1\u0dd1 \u0dad\u0dbb\u0db8\u0dca \u0dc3\u0db8\u0ddc\u0da2\u0dba\u0dd3\u0dba \u0dad\u0dca\u0dca\u0dc0 \u0db1\u0dd2\u0dca\u0db8\u0ddc\u0daf\u0dba \u0dda\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0dd9\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0db6\u0dd4\u0dca\"\u0dd2\u0db4 \u0d85\u0dcf\u0dc1 \u0d86\u0dbb\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dda \u0d85\u0dcf\u0dc1 \u0dc4\u0dad\u0ddc\u0dbd\u0dd3\u0dc3\u0dd2\u0dba \u0dd9\u0dc4\u0dd4 \u0ddc\u0dc0 \u0dc1\u0d9a\u0dca\u0d9a\u0dba\u0dad\u0dd2\u0db4\u0db8\u0dca \u0db1\u0db8\u0dca vigilant \u0db1\u0db8\u0dca \u0d92\u0dc0\u0ddc \u0dc0\u0dc5\u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d92 \u0db1\u0dd2\u0dc3\u0ddc \u0dc3\u0da2\u0dd2\u0dca \u0dc4\u0dda\u0db8 \u0ddc\u0dc3 \u0dbb\u0db1\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dd2\u0dcf\u0dd9 \u0dda\u0dbb\u0db4\u0dd4 \u0dc4\u0dbd\u0ddc\u0dd4\u0db8 \u0d85\u0dad\u0dbb\u0ddc\u0db0\u0dba \u0dc4\u0db8\u0ddc\u0dda\u0d9a\u0dca\u0d9a\u0dba ? \u0dc4\u0db8\u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dd9\u0ddc\u0dbb\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 CID evidence reports, \u0db6\u0dd4\u0dca\"\u0dd2\u0db4 \u0dc4\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dc0\u0ddc\u0dca\u0dad\u0ddc \u0dbd\u0dd0\u0db6\u0dd3 \u0dad\u0dd2\u0db4\u0db6\u0dd4\u0daf\u0ddc. \u0d92 \u0dd9\u0dbb\u0dd2\u0db8 \u0d9c\u0daf\u0db1 \u0db8\u0dd4 \u0db8\u0dad\u0dda \u0db1\u0dd0\u0dd9\u0dd0. \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1 \u0dc0\u0dd2\u0dd2\u0db4\u0dba\u0dd4 \u0d85\u0db1\u0dd6 \u0d9c\u0daf\u0db1\u0dda\u0dd4 \u0dc0\u0dd0\u0dd2\u0da2\u0dba\u0dd2. \u0dc4\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd9\u0ddc\u0dbb\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d8b\u0dbd\u0db8\u0ddc \u0dc3\u0dcf\u0dc0\u0dd2\u0db0\u0ddc\u0db1\u0dba \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d89\u0dc3\u0dca\u0dbd\u0ddc\u0db8\u0dd3\u0dba \u0dc3\u0dcf\u0dc0\u0dd2\u0db0\u0ddc\u0db1 \u0daf\u0dd2\u0d9a\u0dc0\u0db1\u0dca \u0daf\u0dd2\u0d9c\u0dd4 \u0d9a\u0dd2\u0dba\u0dbd\u0ddc \u0dad\u0dd2\u0db4\u0db6\u0dd4\u0daf\u0ddc. \u0dbb\u0dc0\u0dd4 \u0dca \u0dd9\u0d9a\u0dd3\u0db8\u0dca \u0db8\u0dd0\u0dad\u0dd2\u0db4\u0dad\u0dd4\u0db8\u0ddc \u0dc0\u0ddc\u0dc4\u0dda \u0d85\u0dba \u0d9a\u0dd2 \u0dc0\u0ddc \u0db8\u0db8 \u0db1\u0dca\u0dc4\u0db1\u0dca \u0db1\u0dd0\u0dd9\u0dd0. \u0dc3\u0db8\u0dd9\u0dbb \u0dc0\u0dd2\u0dd4 \u0d91\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0ddc\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d87\u0dad\u0dd2\u0db4. \u0db1\u0dc4\u0dd4\u0dca \u0d92 \u0d91\u0dda\u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0dca \u0d9c\u0daf\u0db1\u0dca \u0d9c\u0dca\u0dc4\u0dca \u0db1\u0dd0\u0dd9\u0dd0. \u0da2\u0ddc\u0dad\u0dd2\u0db4\u0dda \u0d86\u0dbb\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0ddc\u0dc0 \u0db6\u0dd2\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0dd4 \u0ddc\u0db4\u0dd4 \u0db1\u0ddc\u0dba\u0dda\u0dc4\u0dba\u0ddd \u0dad\u0db8\u0dba\u0dd2 \u0dbb\u0db1\u0dd2\u0dbd\u0dca\u0dbd\u0ddc \u0dc3\u0da2\u0dd2\u0dca\u0dbd\u0ddc \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc4\u0db1\u0dca.\n\n307 308\n\n\u0dad\u0ddc\u0dca\u0dd2\u0dc4\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0d91\u0dad\u0ddc \u0d9a\u0dd2\u0dba\u0dbd\u0ddc. \u0dda\u0dc0\u0dd4 \u0dc1\u0ddc\u0db1\u0dd2 \u0d85\u0dc4\u0db6\u0dca\u0dbd\u0dc4\u0dc3\u0dca\u0dda\u0dbb \u0db1\u0dd0\u0dc0\u0dad\u0dca \u0d92 \u0dad\u0dd0\u0db1\u0dd4 \u0ddc\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc4\u0db1\u0dca. \u0d91\u0dc4\u0dd9\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc4\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0db4\u0dba\u0ddc\u0db1\u0dd2 \u0da2\u0db1\u0dad\u0ddc\u0dc0\u0dc4\u0dda \u0db4\u0dca\u200d\u0dbb\u0db0\u0ddc\u0db1 \u0d86\u0d9c\u0db8\u0dd2\u0dda \u0db1\u0ddc\u0dba\u0dda\u0dba\u0ddc \u0dc4\u0dc0\u0da0\u0dca\u0da0 \u0dda\u0ddc\u0daf\u0dd2\u0db1\u0dbd\u0dca\u0dad\u0dd4\u0db8\u0ddc \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0db1\u0ddc\u0dba\u0dda\u0dba\u0db1\u0dca. \u0dbb\u0dc0\u0dd3 \u0dc4\u0dc3\u0dc4\u0db1\u0dc0\u0dd2\u0dbb\u0dca\u0db1 \u0db8\u0dd0\u0dad\u0dd2\u0db4\u0dad\u0dd4\u0db8\u0ddc \u0db8\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0dda\u0dca \u0dda\u0dc4\u0dad\u0ddd\u0dd2\u0dda - \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0db4\u0dba\u0ddc\u0db1\u0dd2 - \u0db4\u0dca\u200d\u0dbb\u0da2\u0ddc\u0dc4 \u0d91\u0dda \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0d9a\u0dca\u0d9a\u0dba.\n\n\u0dc4\u0db8\u0ddc\u0dda\u0d9a\u0dca\u0d9a\u0dba \u0dda\u0dc4\u0dc5\u0dca? \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc4\u0dba\u0ddd\u0da2\u0dba \u0dda\u0ddc\u0dbb\u0dda \u0dc3\u0dcf\u0ddc\u0dad\u0dad\u0dd2\u0db4\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2. \u0da2\u0db1\u0ddc\u0dd2\u0db4\u0dad\u0dad\u0dd2\u0db4\u0dad\u0dd4\u0db8\u0ddc \u0d92\u0dda \u0dd9\u0dbb\u0dd2\u0dba\u0dd4 \u0d9a\u0dd2 \u0dc0\u0ddc. \u0dc4\u0db8\u0ddc\u0dda\u0d9a\u0dca\u0d9a\u0dba ? \u0d85\u0dad\u0dbb\u0ddc\u0db0 \u0dda\u0dbb\u0dbd\u0ddc \u0dad\u0dbb\u0dd3\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0daf\u0dba\u0dca \u0d85\u0dad\u0dbb\u0ddc\u0db0\u0dda\u0dbb\u0dd4\u0dca \u0d85\u0dad\u0dd4 \u0d9c\u0dca\u0dad \u0dba\u0dd4\u0d9c\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dad\u0dd2\u0db4\u0db6\u0dd4\u0dc4\u0dab\u0dca\u0da9. \u0d91\u0dc4\u0dd9\u0db8 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 7\u0d9a\u0dca\u0d9a\u0dba \u0dad\u0db8\u0dba\u0dd2 \u0d9c\u0dad\u0dc4\u0dc0\u0dbd\u0ddc \u0dad\u0dd2\u0db4\u0db6\u0dd4\u0dc4\u0dab\u0dca\u0da9. \u0d92 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 7\u0db1\u0dca \u0dad\u0dc3\u0dca\u0dc4\u0dc3\u0dca \u0d85\u0db4\u0dd2 \u0dd0\u0db1\u0dca \u0dad\u0dbb\u0dd3\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0daf \u0dad\u0dd4\u0db1\u0dca \u0d85\u0dbb\u0dc4\u0d9c\u0db1 \u0dad\u0dd2\u0db4\u0dc4\u0db6\u0db1\u0dc0\u0ddc. \u0d92 evidence \u0db8\u0dda\u0dbd\u0ddc \u0dad\u0dd2\u0db4\u0db6\u0dd4\u0daf\u0ddc \u0d92 \u0db1\u0dd2\u0dbd\u0db0\u0ddc\u0dbb\u0dd2\u0db1\u0dca \u0da9\u0dba\u0db8\u0dca \u0dda\u0dbb\u0dbd\u0ddc \u0d91\u0dc5\u0dc0\u0ddc \u0dad\u0dd2\u0db4\u0db6\u0dd4\u0daf\u0ddc. \u0db8\u0dd4 \u0db8\u0dad\u0dda \u0dc0\u0dd2\u0dd2\u0db4\u0dba\u0dd4 CID \u0d91\u0dc4\u0d9a\u0dca\u0d9a\u0dba \u0dd9\u0dca\u0dc3\u0dd2\u0dba \u0d9c\u0daf\u0db1\u0d9a\u0dca\u0d9a\u0dba \u0dad\u0db8\u0daf \u0db8\u0ddc\u0dbb\u0dd4 \u0dda\u0dc5\u0ddc. \u0d91\u0dc4\u0dd9\u0db8 \u0dc4\u0db1\u0dca \u0d86\u0db1\u0db1\u0dca \u0dc0\u0dd2\u0dc4\u0dda\u0dad\u0ddc\u0dbd \u0d87\u0db8\u0dad\u0dd2\u0db4\u0dad\u0dd4\u0db8\u0db1\u0dd2? \u0dc4\u0d9c\u0ddd\u0da8\u0ddc\u0dcf\u0dba \u0daf\u0dd2\u0db1\u0dbd\u0ddc \u0d89\u0dc3\u0dca\u0dc4\u0dc3\u0dbd\u0dca\u0dbd\u0ddc\u0db8 \u0dc4\u0db8\u0ddc\u0dda\u0d9a\u0dca\u0d9a\u0dba \u0dda\u0dc4\u0dc5\u0dca? \u0dc4\u0db8\u0dca \u0dad\u0dbb\u0dd3\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0daf \u0dda\u0dbb\u0db4\u0dd4 \u0dd9\u0dca\u0dc3\u0dd2\u0dba \u0d9c\u0daf\u0db1\u0d9a\u0dca\u0d9a\u0dba \u0db8\u0ddc\u0dbb\u0dd4 \u0dda\u0dc5\u0ddc. \u0db1\u0dc4\u0dd4\u0dca \u0d85 \u0dc4\u0db8\u0dad\u0dd0\u0db1\u0dd4 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0ddc \u0dad\u0dbb\u0dd3\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0daf \u0dc0\u0ddc\u0dca\u0dad\u0ddc \u0d9c\u0dd0\u0db1 \u0dda \u0ddc \u0dda\u0dbb\u0db1\u0dc0\u0ddc. \u0d92 \u0dad\u0dbb\u0dd3\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0daf \u0dc0\u0ddc\u0dca\u0dad\u0ddc \u0d94\u0d9a\u0dca\u0d9a\u0dba\u0dc4\u0dda\u0ddd\u0db8 \u0db8\u0dd0 \u0dc4\u0dd4\u0dbd\u0dc4\u0db1\u0dca \u0dad\u0dd2\u0db4\u0dba\u0dbd\u0ddc cook \u0dda\u0dbb\u0db4\u0dd4\u0dc0\u0ddc \u0dd2\u0dba\u0db4\u0dd4\u0dc0\u0ddc. \u0d92\u0dc0\u0ddc\u0dd4 \u0dad\u0db8\u0dba\u0dd2 \u0dc4\u0db8\u0dca\u0dc4\u0d9c\u0ddc\u0dbd\u0dca\u0dbd\u0db1\u0dca \u0d85\u0dca\u0db4\u0dd4\u0dd2\u0da2 \u0d9c\u0dd9\u0db1\u0dca\u0dc4\u0db1\u0dca. \u0db8\u0dd2\u0db1\u0dd3\u0db8\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0d92 \u0d85\u0dad\u0dbb\u0ddc\u0db0\u0dda\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0dc0\u0ddc \u0dda\u0dbb\u0db1 \u0d91\u0dda \u0db8\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0db1\u0dd0\u0dd9\u0dd0. \u0db8\u0dd4 \u0daf\u0dd4\u0dda \u0dc4\u0dd2\u0dc4\u0dad\u0db1 \u0dc4\u0dca\" \u0dad\u0db8\u0dba\u0dd2 \u0dc4\u0db8\u0da0\u0dca\u0da0\u0dbb \u0dad\u0dd9\u0dc5\u0dd4 \u0dc0\u0dd0\u0dc4\u0dd4\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0dda. \u0db6\u0dbd\u0dba \u0d9c\u0db1\u0dca\u0db1 \u0dc4\u0db8\u0dca \u0db8\u0ddc\u0dad\u0dd8 \u0db7\u0dd6\u0db8\u0dd2\u0dba \u0dc0\u0dd2\u0db1\u0ddc\u0dc1 \u0dda\u0dbb\u0db4\u0dd4 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0dc4\u0db8\u0dca \u0dc4\u0dca\"\u0dc1\u0dad\u0ddc\u0dbd\u0db1 \u0d85\u0dad\u0dbb\u0ddc\u0db0\u0dda\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d91\u0dda\u0dd4 \u0d89\u0db3\u0dc4\u0d9c\u0db1 \u0d85\u0dca\u0db4\u0dd4\u0dd2\u0da2 \u0d9c\u0dd9\u0db1\u0dca\u0dc4\u0db1\u0dca \u0dc4\u0dda\u0ddc\u0dc4\u0dd9\u0ddc\u0db8 ?"
  },
