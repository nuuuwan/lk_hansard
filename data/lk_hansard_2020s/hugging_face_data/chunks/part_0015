    "chunk_text": "\u0dc1\u0db8\u0dcf\u0d9a\u0dd9, \u0d85\u0db4\u0dd2 \u0db6\u0dd0\u0dbd\u0dd4\u0dc1\u0dc0\u0dcf\u0dad\u0dca, \u0db4\u0db1\u0dc1\u0dad\u0dca 3(2) \u0d8b\u0db4\u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dc1\u0dad\u0dca \u0dc1\u0db8\u0dc1\u0dc3\u0dda \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc0\u0db1\u0dc0\u0dcf:\n\n\"\u0dc0\u0dd2\u0dc1\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dba\u0da7\u0d9a \u0d85\u0db0\u0dd2\u0d9a\u0dba\u0da7\u0dba\u0d9a \u0db1\u0dd4 \u0dad\u0dd3\u0db1\u0dca\u0dd4\u0dc0\u0d9a\u0dca \u0dba\u0da7\u0dc1\u0dad\u0dca \u0dc1\u0d9c\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dd4 \u0dba\u0db8\u0dca \u0db6\u0dd4, \u0d85\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca, \u0dd9\u0da9 \u0db8\u0dd4\u0dd9\u0dca. \u0dc1\u0dc4\u0ddd \u0dc1\u0dc0\u0db1\u0dad\u0dca \u0dd9\u0dab\u0dca\u0da9\u0da9\u0db1 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0db8\u0db8 \u0db4\u0db1\u0dc1\u0dad\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1 \u0d85\u0dd9\u0dcf\u0dc5 \u0dc1\u0db1\u0dcf\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dd4 \u0dba\u0da9\"\n\n\u0d9c\u0dbb\u0dd4 \u0d9a\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0db8\u0db1\u0dd2, \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0dc1\u0db8\u0dca\u0d9a \u0db6 \u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dba \u0d9c\u0db1\u0dca\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0dba\u0dba\u0dcf \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0db8\u0da7 \u0d87\u0dad\u0dd2 \u0db6 \u0dad \u0d85\u0db1\u0dd4\u0dc0 \u0db8\u0db8 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a\u0dca publish \u0d9a\u0dc5\u0dcf\u0da9 \u0d92 publish \u0d9a\u0dc5 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0d85\u0dd9 \u0db1\u0dd2\u0dba\u0db8\u0dba\u0db1\u0dca \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dba \u0d9c\u0dd0\u0dd3\u0db8\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0db8\u0db8 \u0dc0\u0dd2\u0dc0\u0dcf\u0dd9\u0dba \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca\u0da9 \u0dbd\u0dad\u0dc1\u0d9a\u0dcf\u0da7, \u0dc1\u0db8\u0dba\u0dd2\u0db1\u0dca \u0dc3\u0dd1\u0dc1\u0dc4\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0da7\u0dba\u0d9a\u0dca \u0d92 \u0dc0\u0dd2\u0dc2\u0dca\u0da8\u0dba\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dc3\u0dda \u0d9a\u0dba \u0d9c\u0db1\u0dca\u0db1\u0da7 \u0dbb\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0db1\u0dc0\u0dcf\u0da9 \u0dbd\u0dba \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dc0 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca, \"2024 \u0d85\u0d82\u0d9a 49 \u0dd9\u0dba\u0db1 \u0dc0\u0dd2\u0dc1\u0daf\u0dca \u0db1\u0dd4 \u0dad\u0dd3\u0db1\u0dca\u0dd4 \u0d85\u0dc1\u0db1\u0dba\u0ddd\u0db1\u0dba\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dd0\u0dd3\u0db8\u0db8, \u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0db6 \u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0db4\u0db1\u0dc1\u0dad\u0dca 2\u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dc1\u0dc0 (1)\u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dc1\u0dba\u0db1\u0dca \u0db8\u0dcf \u0dc1\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6 \u0dad \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dba\u0dc0, \u0d85\u0db0\u0dd2\u0d9a\u0dba\u0da7 \u0dc3\u0dc4 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d92\u0d9a\u0dcf\u0db6\u0daf\u0dca\u0db0\u0dad\u0dcf \u0d85\u0db8\u0dcf\u0dad\u0dba, \u0dc4\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0da7 \u0db1\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dca\u0d9a\u0dcf\u0dba \u0dc0\u0db1 \u0db8\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca, \u0dbd\u0d9a\u0dd3 \u0db4\u0db1\u0dc1\u0dad\u0dca I \u0dc0\u0db1 \u0dc1\u0d9a\u0dcf\u0da7\u0dc1\u0dc3\u0dda \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1 \u0dc1\u0db8\u0dc4\u0dd2 \u0d8b\u0db4\u0dc1\u0dca.\u200d\u0db1\u0dc1\u0dc0 \u0db1\u0dd2 \u0dda\u0da0\u0dd2\u0dad\u0dc0 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dba \u0d87\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dba\u0da7\u0dc0 \u0d85\u0db0\u0dd2\u0d9a\u0dba\u0da7 \u0db1\u0dd4 \u0dad\u0dd3\u0db1\u0dca\u0dd4 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0d85\u0dd9\u0dcf\u0dc5 \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dd4 \u0dba\u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf \u0d9a\u0dba \u0dc3\u0dd2\u0da7\u0dd2\u0db8\u0dd2\" \u0d9a\u0dd2\u0dba \u0dcf \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad \u0dbb\u0dc1\u0dc0 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc0\u0db1\u0dc0\u0dcf\u0da9 \u0dc1\u0db8\u0db8 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dc0 \u0d8b\u0db4\u0dc1\u0dca.\u200d\u0db1\u0dba \u0dba\u0da7\u0dc1\u0dad\u0dca \u0dba\u0da7\u0dc0\u0dca. 53\u0d9a\u0dca \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0d9a\u0dba \u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0da9 \u0d85\u0dc1\u0dda \u0dd3\u0db8\u0dad\u0dd2 \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2\u0dba \u0d85\u0dc1\u0db1\u0dba\u0ddd\u0db1\u0dba\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dd6 \u0dd3\u0db8\u0dad\u0dd2 \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2 \u0d87\u0dad\u0dd2 \u0dba\u0da7\u0dc0\u0dca. 53\u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0db8\u0dca\u0d9a \u0dc3\u0db8\u0db1\u0dca\u0dc0\u0dd2\u0dad\u0dba\u0dd2\u0da9 \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0dc1\u0daf\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dd4, \u0dc0\u0dd2\u0dc1\u0daf\u0dca \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba \u0dbd\u0d9a\u0dca\u0d9a \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0d9a\u0dba \u0dcf, \u0dbd\u0db8 \u0dba\u0da7\u0dc0\u0dca. 53 \u0dc1\u0db8\u0dcf\u0db1\u0dc0\u0dcf\u0dd9 \u0d9a\u0dd2\u0dba\u0dcf \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dc0 \u0d87\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dba \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0da9 \u0dbd\u0db8 \u0dba\u0da7\u0dc0\u0dca. \u0dc1\u0db8\u0dcf\u0db1\u0dc0\u0dcf \u0dd9 \u0d9a\u0dd2\u0dba \u0dcf \u0db8\u0db8 \u0dd9\u0dd0\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0\u0da9 \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0dc1\u0db8\u0db8 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dba\u0db1\u0dca \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1\u0dba \u0dc0\u0dd2\u0dc3\u0dd3\u0db8\u0db8 \u0dc3\u0dd2\u0daf\u0dca\u0db0 \u0dc0\u0db1\u0dc0\u0dcf\u0da9 \u0db8\u0dcf \u0dc0\u0dd2 \u0dda\u0dc0\u0dcf\u0dc3 \u0d9a\u0dba\u0db1\u0dc0\u0dcf, \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0dad\u0dcf\u0dba\u0dc0 \u0d85\u0dd9 \u0daf\u0dd2\u0db1\u0dc1\u0dc0\u0daf\u0dd3 \u0dc1\u0db8\u0db8 \u0db1\u0dd2\u0dba\u0db8\u0dba\u0db1\u0dca \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dba \u0d9c\u0db1\u0dca\u0db1 \u0dc4\u0dd0\u0d9a\u0dd2 \u0dc1\u0dc0\u0dba\u0dd2 \u0d9a\u0dd2\u0dba \u0dcf\u0da9\n\n\u0d9c\u0dbb\u0dd4 \u0d9a\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0db8\u0db1\u0dd2, \u0d85\u0dd9 \u0daf\u0dd2\u0db1 \u0dc0\u0dd2\u0dc2\u0dca\u0da8\u0dba \u0db4\u0dcf\u0dc1\u0dba\u0db1\u0dca \u0db6\u0dd0\u0dc4\u0dd0\u0dba\u0dc0 \u0db8\u0db8 \u0dc1\u0db4\u0dcf\u0da9\u0dca\u0da9\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dad\u0dca \u0d9a\u0dcf\u0dba\u0da7\u0dba\u0d9a\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9a\u0dcf\u0dcf \u0d9a\u0dba\u0db1\u0dca\u0db1\u0da7 \u0d9a\u0dd0\u0db8\u0dad\u0dd2\u0dba\u0dd2\u0da9 \u0d85\u0db4\u0dd2, \u0d85\u0dc1\u0dda \u0dc1\u0daf\u0dca \u0db4\u0dcf \u0db1 \u0dc3\u0d82\u0dc3\u0dda\u0d9a\u0dca\u0dad\u0dd2\u0dba \u0dc1\u0dc0\u0db1\u0dc3\u0dda \u0d9a\u0dba\u0db1\u0dca\u0db1\u0da7 \u0dc1\u0d9a\u0dcf\u0da0\u0dca\u0da0\u0dba \u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0d9a\u0dc5\u0dad\u0dca \u0dad\u0dc0\u0db8 \u0d92 \u0dc3\u0d82\u0dc3\u0dda\u0d9a\u0dca\u0dad\u0dd2\u0dba \u0dba\u0db8\u0dca \u0dba\u0db8\u0dca \u0dad\u0dd0\u0db1\u0dca\u0dc0 \u0dc4\u0dd2\u0dba \u0dc1\u0dc0 \u0dcf \u0dc1\u0dc0\u0db1\u0dc3\u0dda \u0dc1\u0dc0\u0db1\u0dc0\u0dcf\u0da9 \u0db8\u0dcf\u0db0\u0dba\u0dc0 \u0dad\u0dca \u0dc0\u0dd0\u0db1\u0db8 \u0dc1\u0dc0\u0db1\u0dc3\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0\u0da9 \u0d85\u0db4\u0dd2 \u0db7\u0dcf\u0dc2\u0dca\u0da8\u0da7\u0dc1\u0dc0 \u0db1\u0dd2\u0dd9\u0dc4\u0dc3\u0da7, \u0db8\u0dcf\u0db0\u0dba \u0db1\u0dd2\u0dd9\u0dc4\u0dc3\u0da7 \u0d9c\u0dbb\u0dd4 \u0d9a\u0dba\u0db1\u0dc0\u0dcf\u0da9 \u0dc3\u0db8\u0dc4\u0dbb\u0dd4 \u0d85\u0dc3\u0dad\u0dba \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca\u0dad\u0dca\u0dad\u0dd2 \u0db8\u0dc0\u0db1\u0dc0\u0dcf\u0da9 \u0dad\u0dc0 \u0dc3\u0db8\u0dc4\u0dbb\u0dd4 \u0db1\u0dd2\u0dc0\u0dd0\u0dba\u0daf\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca\u0dad\u0dca\u0dad\u0dd2 \u0db6\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf\u0da9 \u0db1\u0dd2\u0dc0\u0dd0\u0dba\u0daf\u0dd2 \u0dc1\u0dad\u0dcf\u0dba\u0dd4\u0dbb\u0dd4 \u0db6\u0dcf\u0dc1\u0d9c\u0db1 \u0dc0\u0dd0\u0dba\u0daf\u0dd2 \u0dd2\u0daf\u0dd2\u0db4\u0dad\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0db1\u0dd2\u0dc3\u0dcf \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0dc1\u0db1\u0dcf\u0db8\u0d9f \u0dba\u0dc0\u0db1\u0dc3\u0dd4\u0dbd\u0dd4 \u0d86\u0d9a\u0dcf\u0dba\u0dc1\u0dc0 \u0dc1\u0daf\u0dca\u0dc0\u0dca. \u0dc1\u0dc0\u0db1\u0dc0\u0dcf\u0da9"
