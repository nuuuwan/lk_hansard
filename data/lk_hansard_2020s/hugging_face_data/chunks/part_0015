3\u0dc4\u0dcf \u0d9c\u0db8\u0dca \u0db4\u0db1\u0dad\u0dca \u0dc3\u0d82\u0d9c \u0ddd\u0db0\u0db1 \u0d9a\u0dba\u0db1\u0dca\u0daf\u0db1 \u0db6\u0dbd\u0dcf\u0d9c\u0db4\u0dcf\u0d9c\u0dba\u0dcf\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca\u0daf. \u0d85\u0db4\u0db4 \u0d85\u0d9c\u0dda \u0dba\u0db4 \u0dd2\u0da7\u0d82\u0d9c\u0dda\u0dca\u0dbb\u0dd4\u0dc0 [ \u0d9a\u0dba\u0db1\u0dca\u0daf\u0db1 \u0d95\u0db1\u0db8 \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0db4\u0db4 \u0d95\u0db1\u0db8 \u0d85\u0db4\u0db4\u0db8 \u0d85\u0db1\u0db1\u0dba \u0d9c\u0dc0\u0dca \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0 [ \u0dc4\u0daf\u0db1\u0dca\u0daf\u0db1. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dbb\u0dca\u0dba\u0d9c\u0dba\u0db1\u0dca\u0daf\u0db8 \u0d92 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0 \u0dc4\u0daf\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dc3\u0dc4\u0dad\u0dd2\u0d9a \u0d9a\u0dba\u0dbd\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf.\n\n\u0d8a\u0dd9\u0d9f\u0db4, \u0dc0\u0dd2\u0db4 [\u0dc2\u0dca\u0da8\u0d9c \u0db8\u0db1\u0dca\u0daf\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dca\u0daf\u0dbd\u0dcf \u0dc0\u0dcf\u0dc4\u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9a\u0dae\u0dcf \u0d9a\u0dd9\u0dcf. \u0d85\u0d9c\u0dda \u0dba\u0db4\u0db4 \u0dc0\u0dcf\u0dc4\u0db1 \u0d9c\u0dda\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca\u0daf \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d9a\u0dcf\u0dbd\u0d9c \u0d9c\u0db8\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0d9c\u0db8\u0dca\u0db1\u0dca\u0daf\u0dad\u0dd4\u0dc0 \u0dad\u0dad\u0dd4\u0d9c\u0dd9\u0dda \u0d9a\u0dae\u0dcf \u0d9a\u0dd9\u0dcf \u0d85\u0db4\u0db4 \u0db8\u0dad\u0d9a\u0dba\u0dd2. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dc0\u0dcf\u0dc4\u0db1 \u0d9c\u0d9c\u0db1\u0dcf\u0dc0\u0dcf\u0db4 \u0db4\u0dc3\u0dda\u0d9c\u0dc3\u0dda \u0d92 \u0d85\u0dba \u0d9a\u0dd2\u0dc0\u0dca\u0dc0\u0dcf, \u0d92 \u0dc0\u0dcf\u0dc4\u0db1 \u0dc0\u0dd2\u0d9a\u0dd2\u0d9c\u0dab\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca\u0daf \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc3\u0dd3\u0db8\u0dd2\u0dad \u0dc0\u0dcf\u0dc4\u0db1 \u0dc3\u0d82\u200d\u0dba\u0dcf\u0dc0 [ \u0d9c\u0dda\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0d9a\u0dae\u0dcf \u0d9a\u0d9c\u0dd9\u0dda. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d85\u0daf \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca\u0daf \u0db1\u0dd0\u0dc4\u0dd0. \u0dc0\u0dcf\u0dc4\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0d9c\u0dc0\u0d9c\u0dd9\u0db3 \u0d9c\u0db4\u0dcf\u0dd9 \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dba\u0db4\u0dd4 \u0d91\u0d9a \u0d9c\u0dd0\u0db1 \u0d9a\u0dd2\u0dd2\u0da7 \u0d9c\u0daf\u0dba [ \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca\u0daf \u0db1\u0dd0\u0dad\u0dd4\u0dc0\u0dba\u0dd2 \u0d9c\u0db8\u0dad\u0dd4\u0db8\u0db1\u0dca\u0daf\u0dbd\u0dcf \u0d85\u0daf \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dba\u0db8\u0dd2\u0db1\u0dca\u0daf \u0d89\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca\u0daf.\n\n\u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0daf\u0db1\u0dc0\u0dcf, \u0d9c\u0db8\u0dca \u0dba\u0d9c\u0da7\u0dca \u0d9c\u0dc0\u0db1\u0dc3\u0dda \u0d9a\u0dba\u0db1\u0dca\u0daf\u0db1 \u0d95\u0db1\u0db8 \u0d9a\u0dcf\u0dba\u0dab\u0dcf \u0d9c\u0dab\u0db1\u0dcf\u0dc0 [ \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0db6\u0dc0. \u0d85\u0db4\u0db4 \u0d85\u0daf \u0d9c\u0db8\u0dca \u0db4\u0db1\u0dad\u0dca \u0dc3\u0d82\u0d9c \u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dba\u0db1\u0dca\u0daf\u0db1 \u0dd2\u0da7\u0dd4 \u0d9c\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca\u0daf \u0dad\u0dba\u0dd2? \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d9a\u0dcf\u0dbd\u0d9c \u0d9c\u0db8\u0dca \u0dba\u0d9c\u0da7\u0dca \u0d86\u0d9c\u0dba\u0ddd\u0da2\u0d9a\u0dba\u0db1\u0dca\u0daf\u0db4 \u0db8\u0dd4\u0dad\u0dbb\u0dab \u0db4\u0dcf\u0db1\u0dca\u0d