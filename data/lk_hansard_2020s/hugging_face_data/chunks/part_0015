ca\u200d\u0dbb\u0dcf\u0dc1\u0dda\u0dba\u0dba \u0dc1\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0db1\u0dca\u0dc0\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u0db8 \u0dbd\u0dd2\u0db4\u0dd2\u0dba \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8\u0d9a\u0dca \u0dc1\u0dbd\u0dc3 \u0db1\u0d9a\u0dca\u0dc0\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u0db8 \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 \u0dca\u0db7\u0dcf\u0d9c\u0dad* \u0d9a\u0dba\u0db1\u0dc0\u0dcf.\n\n(\u0d86) (i) \u0d94 . (\u0dc0\u0dc3\u0dba 3]\u0d9a \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0daf\u0dd3\u0dbb\u0dca \u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0db6\u0daf\u0dd4 \u0db4\u0db1\u0db1\u0db8 \u0db8\u0dad \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0d87\u0dad.)\n\n(ii) \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 3]4,]]]\u0d9a\u0dd2.\n\n(iii) \u0dc3\u0dd3/\u0dc3 \u0dc4\u0dd2\u0dbb\u0dd2\u0dba\u0dcf\u0dbd \u0dc1\u0d9c\u0ddc\u0dc0\u0dd2\u0da2\u0db1 \u0dc3\u0db8\u0dcf\u0d9c\u0db8 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dc1\u0dda\u0dba\u0dba\n\n\u0dc1\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dc1\u0dc0\u0dad \u0dc1\u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dba \u0d87\u0dad\u0dd2 2]24.12.]6 \u0dd2\u0db1\u0db1\u0dd0\u0dad\u0dd2 \u0dbd\u0dd2\u0db4\u0dd2\u0dc1\u0dba\u0dc4\u0dd2 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 \u0dc1\u0dbd\u0dc3 \u0db8\u0d82\u0dd4\u0db1\u0dbd\u0dcf \u0dd2\u0db1\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0dba\u0db1 \u0d85\u0dba\u0dc1\u0dda \u0db1\u0db8 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf.\n\n(iv) \u0d94 .\n\n\u0d89\u0da9\u0db8 \u0dd2 \u0dc3\u0dd2 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0dad\u0ddc\u0dba \u0dc0\u0dd6\u0dc0\u0d9a\u0dd2. \u0d89\u0da9\u0db8\u0dca \u0dc1\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dcf \u0da2\u0db1\u0dba\u0dcf\u0dbd\u0dca\u0dc1\u0dda \u0d85\u0dc0\u0dc3\u0dba\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0dad\u0ddc\u0dba\u0dc0 \u0dba\u0dba\u0dd2\u0d9c\u0db8\u0d