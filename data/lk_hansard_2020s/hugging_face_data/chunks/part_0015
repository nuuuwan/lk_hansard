    "chunk_text": "\u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0daf\u0dd2\u0db1\u0d9a \u0d85\u0dc1\u0dda \u0daf\u0dd2\u0dc3\u0dda\u0dd2 [\u0d9a\u0dc1 \u0dc0 \u0db8\u0dc1\u0dda \u0dca\u0dc3\u0db1\u0dc1 \u0dc0 \u0db8\u0dd0\u0daf\u0dc0\u0da0\u0dca\u0da0\u0da0\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dc1\u0db0\u0dd2\u0db8\u0dc1\u0dd3\u0dba \u0dc3 \u0dcf\u0dc1 \u0db6\u0dcf\u0dba \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0db1\u0dca\u0db1 \u0d9c\u0dd2\u0dba\u0dcf. \u0d9a\u0da7\u0dca\u0da7\u0da7\u0dd2\u0dba \u0d9a\u0dd2\u0db1\u0dca\u0db8 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf\u0dc0 \u0dc1\u0d9a\u0dcf\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dda\u0dad\u0dd4\u0db8\u0dcf \u0d91\u0dad\u0dd0\u0db1\u0da7 \u0d91\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dba\u0dc4\u0dc3\u0dda \u0da1\u0db1\u0dca\u0daf\u0dba [ \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dcf\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dba \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0dc0\u0dc1\u0dba\u0db1\u0dca\u0dc0 \u0d87\u0dd2\u0db0\u0dad\u0dca \u0da1\u0db1\u0dca\u0daf\u0dba \u0da2\u0db4\u0db1\u0dca \u0d9a\u0dd2 \u0dc0\u0dcf. \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dcf [\u0dc2\u0dca\u0da8 ]0\u0d9a\u0da7 \u0dc1\u0db4\u0dcf\u0dc1\u0dba\u0dcf\u0db1\u0dca\u0daf\u0dd4 \u0dc1\u0dc0\u0dcf\u0dcf\u0dc0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dcf [\u0dc2\u0dca\u0da8 1]\u0d9a advance \u0d91\u0d9a [ \u0da2\u0dcf\u0dcf\u0dc0 \u0d94\u0dc4\u0dd4\u0dc0 \u0d85\u0dba\u0dc1\u0d9c\u0db1 \u0d87\u0dd2\u0db0\u0dbd\u0dca\u0dcf\u0dcf \u0da1\u0db1\u0dca\u0daf\u0dba \u0d9c\u0dad\u0dca\u0dad\u0dcf. \u0dc1\u0d9a\u0dcf\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dda\u0dad\u0dd4\u0db8\u0dcf \u0dc1\u0db6 \u0da2\u0dc1\u0db8\u0dca\u0dad\u0dca \u0dc1\u0db6 \u0da2\u0db8\u0dca \u0dd2\u0dbd\u0dca\u0dcf\u0db1\u0dc0\u0dcf. \u0db1\u0db8\u0dca \u0dc1\u0daf\u0d9a\u0dba\u0dd2 \u0dc1\u0dba\u0ddd\u0db1\u0db1\u0dcf \u0dc1\u0dc0\u0dcf\u0dcf \u0dad\u0dd2\u0daf\u0dca\u0dc1\u0da9\u0dd4\u0d9a. \u0dad\u0dc0\u0dad\u0dca \u0dc1\u0dba\u0ddd\u0db1\u0db1\u0dcf \u0dad