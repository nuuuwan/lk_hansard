    "chunk_text": "\u0dc3\u0db8\u0dc4\u0dbb \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dcf\u0db1\u0dca \u0d86\u0da9\u0dbd\u0dca\u0dc0\u0dcf\u0dad\u0dca \u0d91\u0d9a\u0dca\u0dbb \u0db1\u0dbb\u0dc4\u0dba\u0dd2\u0dba \u0d9a\u0dd2 ,\u0dcf \u0db8\u0db8 \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db1\u0dd0\u0dc4\u0dd0. \u0dba\u0dda \u0d86\u0da9\u0dbd\u0dca\u0dba\u0dda\u0db8 \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dcf\u0db1\u0dca. \u0d8a\u0dba\u0dda \u0d85\u0db1\u0dd4\u0dbb\u0dcf\u0db0\u0db4\u0dd4\u0dbb\u0dba\u0dda \u0dbb\u0dd8\u0dd2\u0dbb\u0dbb\u0dca\u0dbd\u0db8 \u0d87\u0db8\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0d9a\u0dd2 \u0db1\u0dc0\u0dcf\u0dcf -\u0db1\u0dd4\u0dc0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0da1\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dba \u0d89\u0dbd\u0dca\u0dbd\u0dd4\u0dc0\u0dcf\u0dcf\u0da7 \u0d85\u0db1\u0dd4\u0dbb\u0dcf\u0db0\u0db4\u0dd4\u0dbb\u0dba\u0dda \u0db8\u0db1\u0dd4\u0dc3\u0dca\u0dc3\u0dba \u0d9a\u0dca- \u0d85\u0db4\u0dd2 \u0dc0\u0dcf\u0dc0\u0dcf,\u0dcf \u0d85\u0db4\u0dd2 \u0dbb\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db1 \u0d9a\u0dd2 ,\u0dcf \u0db1\u0dd3\u0dad\u0dd2 \u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0\u0dbd\u0dd4\u0db4 \u0dba\u0dda \u0dc1\u0dca\u200d\u0dbb\u0dd3 ,\u0d82\u0dbb\u0dcf\u0dba\u0dda \u0d91\u0dba\u0dc4\u0db8 \u0db1\u0dd3\u0dad\u0dd2 \u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0\u0dbd\u0dd4\u0db4 \u0d85 \u0da7 \u0d95\u0db1\u0dd1 \u0db1\u0dda \u0d85\u0db4\u0dd2 \u0dc4\u0dcf\u0dbd\u0dca \u0dba\u0dda\u0db1\u0dc0\u0dcf\u0dcf\u0dbd\u0dd4. \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba\u0dba \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbb\u0dba\u0db8 \u0dba\u0db8\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dad\u0dca \u0dbb\u0dd8\u0dd2\u0dbb\u0dbb\u0dca\u0dbd\u0db8 \u0d87\u0db8\u0dad\u0dd2 \u0dba\u0dbb\u0dba\u0db1\u0d9a\u0dca \u0d91\u0dba\u0dc4\u0db8 \u0d9a\u0dd2 \u0db1 \u0d91\u0dbb \u0dc0\u0dcf\u0da7\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db1\u0dd0\u0dc4\u0dd0 \u0dbb\u0dcf\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dd4\u0db8\u0db1\u0dd2? \u0d91\u0dba\u0dc4\u0db8 \u0dc0\u0dcf\u0da7\u0dd2\u0db1\u0dc0\u0dcf\u0dcf\u0dba \u0d9a\u0dd2 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db1\u0dba\u0dbb\u0ddd? Media\u0dc0\u0dcf,\u0da7 \u0d87\u0dc0\u0dd2\u0dbd\u0dca,\u0dcf \u0d9a\u0dd2 \u0db1\u0dc0\u0dcf\u0dcf\u0db4 \u0d85\u0db4\u0dd2 \u0dc0\u0dcf\u0dc0\u0dcf,\u0dcf \u0d85\u0db4\u0dd2 \u0dbb\u0db1\u0dc0\u0dcf\u0dcf \u0d9a\u0dd2 ,\u0dcf\n\n605 606\n\n\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dba\u0dda\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd4\u0dc0\u0dcf"
  },
