    "chunk_text": "\u0db8\u0dc3\u0dde\u0db7\u0dcf\u0d9c\u0dba\u0dcf \u0db6\u0dd0\u0d82\u0dbb\u0dd4\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9a\u0dae\u0dcf \u0d9a\u0dd4\u0db0\u0dad\u0daf\u0dd3 \u0db8\u0dd4\u0ddd\u0dc4\u0d9a \u0db6\u0da9\u0dbd\u0db3\u0dcf\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf \u0daf\u0db1\u0dca\u0db8\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0dc3\u0dad\u0dd2 \u0d92\u0dc0\u0dcf \u0d9c\u0dd2\u0dab\u0dd4\u0dda \u0daf\u0dd3\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0ddb\u0dad\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dc3\u0dd2\u0d9a \u0d9c\u0dd2\u0dab\u0dd4\u0dda \u0db8\u0daf\u0db1\u0dca\u0db8\u0db1\u0dca. \u0dc3\u0dba\u0dd2 \u0ddb\u0dad\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dc3\u0dd2\u0d9a \u0d9c\u0dd2\u0dab\u0dd4\u0dda \u0db8\u0daf\u0db1\u0dca\u0db8\u0db1\u0dca? \u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba\u0dc2\u0dab \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf \u0db8\u0db8\u0dad\u0dd0\u0db1. \u0db8\u0db8\u0ddc\u0d9a\u0daf \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dd4 \u0db4\u0db1\u0db8\u0dad\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dbb\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dbb\u0dd2\u0d82\u0d9c\u0dbd\u0dcf \u0db8\u0dd6\u0dbd\u0dba \u0d86\u0dba\u0dad\u0db1 \u0dc4\u0daf\u0dbd\u0dcf \u0db6\u0dd2\u0dc3\u0dca\u0db1\u0dc3\u0dca \u0d9a\u0dd4\u0db1\u0dc0\u0dcf. \u0db6\u0dd0\u0d82\u0dbb\u0dd4\u0dc0\u0dc2\u0dab \u0daf\u0db8\u0db1\u0dca\u0db1 \u0d9c\u0dd2\u0dba\u0dcf\u0db8 \u0db6\u0dd0\u0d82\u0dbb\u0dd4\u0dc0\u0d9a\u0da7 \u0dca\u200d\u0dbb\u0dcf \u0db0\u0db1 \u0dc3\u0dc0\u0dba\u0dba\u0dad\u0dcf\u0dc0\u0dc2\u0dab \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0dc4 \u0db6\u0dd0\u0d82\u0dbb\u0dd4\u0db8\u0dbb \u0dad\u0dd0\u0db1\u0dca\u0db4\u0dad\u0dd4\u0dc0\u0dc2\u0dab \u0dad\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0db8\u0db8\u0ddc\u0d9a\u0daf \u0dad\u0dd0\u0db1\u0dca\u0db4\u0dad\u0dd4\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0db8 \u0dad\u0dd0\u0db1\u0dca\u0db4\u0dad\u0dd4\u0dc0\u0dbd\u0da7 \u0dc3\u0d9c\u0dad\u0dd2\u0dba\u0dc2\u0dab \u0dc0\u0dd4\u0db8\u0d9a\u0ddc\u0dad\u0dca \u0dc0\u0d9c \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1. \u0db6\u0dd0\u0d82\u0dbb\u0dd4\u0dc0\u0dc2\u0dab \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0db8\u0d9c\u0db1 \u0dba\u0dd1\u0db8\u0da7 \u0dc3\u0dc0\u0dba\u0dba \u0d9a\u0dd4\u0db1 qualities \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0daf\u0dd0\u0db1\u0dca \u0dc3\u0db0\u0dba\u0dc2\u0dab\u0dc2 \u0db8\u0da9\u0dbd\u0db3\u0dbd\u0dba\u0da7 \u0db8\u0d9a\u0db8\u0db1\u0dc2\u0dab \u0db4\u0dad\u0dca \u0d9a\u0db8\u0dc5\u0ddc\u0dad\u0dca \u0d92 \u0dc3\u0db0\u0dba\u0dc2\u0dab\u0dc2\u0dc0\u0dd4\u0dba\u0dcf\u0db8 capacity \u0db6\u0dbd\u0db1\u0dc0\u0dcf. Fit and proper \u0db6\u0dd0\u0dbd\u0dd4\u0dc0\u0dcf\u0db8 \u0d92\u0dc0\u0dcf \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda \u0dc3\u0db0\u0dba\u0dc2\u0dab\u0dc2\u0dc0\u0dd4\u0db8\u0dba\u0dc2\u0dab \u0d9a\u0dd4\u0db1\u0dca\u0db1 \u0db8\u0daf\u0db1\u0dca\u0db8\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0dda \u0db8\u0dd6\u0dbd\u0dba \u0d86\u0dba\u0dad\u0db1\u0dc0\u0dbd \u0dc3\u0db0\u0dba\u0dc2\u0dab\u0dc2\u0dc0\u0dbb\u0dd4 \u0d9a\u0dc0\u0dd4\u0daf? \u0db8\u0db8 \u0d9a\u0dd2\u0dbb\u0db8\u0dbb \u0db8\u0dda\u0d9a \u0db4\u0da7\u0db1\u0dca \u0d9c\u0dad\u0dca\u0db8\u0dad\u0dca \u0db8\u0db0\u0dad\u0dba\u0db4\u0dcf\u0dbd\u0db1\u0db8\u0dba\u0db1\u0dca\u0db8 \u0dad\u0db8\u0dba\u0dd2. \u0d92 \u0dc3\u0dd2\u0dc3\u0dcf \u0db8\u0dda\u0d9a \u0dc3\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dd4\u0db1\u0dca\u0db1 \u0db8\u0dc0\u0db1\u0dca\u0db8\u0db1\u0dad\u0dca \u0db8\u0db0\u0dad\u0dba\u0db4\u0dcf\u0dbd\u0db1\u0dba\u0da7\u0db8 \u0dad\u0db8\u0dba\u0dd2. \u0d92 \u0dc3\u0dd2\u0dc3\u0dcf \u0dc3\u0db4\u0dd2 \u0d92\u0d9a \u0d9a\u0dd4\u0db1\u0dc0\u0dcf. \u0dc3\u0db4\u0dd2 \u0d92\u0d9a \u0d9a\u0dd4\u0db1\u0dca\u0db8\u0db1\u0dca \u0dc3\u0dd2\u0dc0\u0dd0\u0dd4\u0daf\u0dd2\u0dc0\u0dba\u0dd2.\n\n443 444\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dc3\u0dd2 \u0db8\u0d9a\u0ddc\u0dc5\u0db9 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dc2\u0dab\u0d9a\u0db8\u0d9a \u0dc0\u0dd2\u0dad\u0dd4\u0dc2\u0dab \u0db8\u0dc4\u0dd4\u0d9c\u0db8 \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dd4\u0db8\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1 100\u0dc2\u0dab \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0daf\u0dc4\u0dd2\u0dc0\u0dbd-\u0d9c\u0dbd\u0dca\u0d9a\u0dd2\u0dc3\u0dca\u0dc3 \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dd4\u0db8\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1 300\u0dc2\u0dab \u0db1\u0dd0\u0dc4\u0dd0. \u0d9c\u0dbb\u0dd4 \u0da0\u0db1\u0dca\u0daf\u0db1 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dbb\u0dc0\u0dcf \u0dc3\u0dc0\u0dd2\u0dc3\u0dca\u0dc3\u0dcf\u0db8\u0dbb\u0dbd\u0dca\u0db8\u0dbd\u0dca \u0dc3\u0dd3\u0dad\u0dcf\u0dc0\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 980\u0dc2\u0dab \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d9c\u0dda\u0db4\u0dc4 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1 500\u0dc2\u0dab \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0dda \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dd4\u0dc0\u0dbd \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dc3\u0dbd\u0dca\u0dbd\u0dd2. \u0daf\u0dd0\u0db1\u0dca \u0dc3\u0db4\u0dd2 \u0d92\u0dc0\u0dcf \u0db7\u0dcf\u0dd4\u0db8\u0d9c\u0db1 \u0db8\u0dc3\u0ddc\u0dba\u0db8\u0dd2\u0db1\u0dca \u0dba\u0db1\u0dc0\u0dcf \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dc3\u0dd2. \u0dc3\u0db4\u0da7 \u0dc0\u0dd4\u0dc0\u0db8\u0db1\u0dcf\u0dba\u0dd2 \u0db8\u0dda \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dd3\u0dba \u0dba \u0db6\u0dd0\u0d82\u0dbb\u0dd4 \u0db4\u0db0\u0dad\u0db0\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0dda \u0dd4\u0db8\u0da7\u0dca \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0da7 -\u0db6\u0dd0\u0d82\u0dbb\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dbd\u0dd2\u0dba\u0da7 \u0db8\u0db1\u0ddc\u0db8\u0dc0\u0dba\u0dd2- \u0d91\u0daf\u0dd2\u0db8\u0db1\u0daf\u0dcf \u0d9a\u0dd3\u0dba\u0dc2\u0dab \u0db8\u0dc4\u0ddd \u0d9a\u0dba\u0da7 \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0d86\u0dba\u0dad\u0db1\u0dba\u0dc2\u0dab \u0dad\u0db8\u0db1\u0dca\u0db8 \u0db6\u0dd0\u0d82\u0dbb\u0dd4 \u0db4\u0db0\u0dad\u0db0\u0dad\u0dd2\u0dba \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dd4\u0db1\u0dca\u0db1. \u0d91\u0db8\u0dc3\u0dda \u0db4\u0dad\u0dca \u0d9a\u0dd4\u0db1\u0dca\u0db1 \u0dad\u0db8\u0dba\u0dd2 \u0dc3\u0db4\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd4\u0db8\u0dd2\u0db1\u0dca \u0dba\u0db1\u0dca\u0db8\u0db1\u0dca. \u0d91\u0db8\u0dc3\u0dda \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4"
  },
