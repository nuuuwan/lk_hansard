    "chunk_text": "\u0dc0\u0dd2\u0db8\u0db0\u0dba\u0d9c\u0dad \u0dc3\u0dd4\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc4\u0dd4\u0dc4\u0dcf \u0db8\u0dc4\u0da2\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc0\u0dd2\u0dba\u0daf\u0dda \u0dc0\u0dd3\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db8\u0db1\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc3\u0dd2\u0db8\u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dd4\u0db1 \u0d92 \u0d92 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dc2\u0dab\u0d9a \u0dc3\u0db3\u0dc4\u0dcf \u0d92 \u0d92 \u0dca\u200d\u0dbb\u0db8\u0db0\u0dad\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dd4\u0dcf\u0da2\u0dba \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db8\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda \u0d9a\u0dca\u200d\u0dbb\u0db8\u0db8\u0dbb\u0daf\u0dba\u0dc2\u0dab. \u0db8\u0db0\u0dba\u0db8 \u0d86\u0da9\u0dbd\u0da9\u0dd4\u0db8\u0dc0\u0db1\u0dca \u0db8\u0dba\u0ddc\u0daf\u0dc0\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dca\u0dc0\u0dbd\u0da7 \u0db4\u0dbb\u0dd2\u0db6\u0dcf\u0dc4\u0dd2\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf \u0dba\u0da7\u0db8\u0dad\u0dca\u0dad\u0dca \u0db8\u0dbb\u0dca\u0dd3\u0dba\u0dba \u0dc3\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dba \u0dba\u0da7\u0db8\u0dad\u0dca \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0dc4\u0dd4\u0dc4\u0dcf \u0dc3\u0dd2\u0db0\u0dad\u0db0 \u0db8\u0dc0\u0db1 \u0db8\u0db0\u0dad\u0dc0\u0dbd\u0dca\u0dc0\u0dbd\u0daf\u0dd3\u0dad\u0dca \u0dba\u0dda \u0dc0\u0dd2\u0db8\u0db0\u0dba\u0d9c\u0dad \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db8\u0dc0\u0db1\u0dca\u0dc0\u0dd3\u0dda \u0dc3\u0dd2\u0db0\u0dad\u0db0 \u0db8\u0dc0\u0db1\u0dc0\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0db8\u0dda \u0dc3\u0dd2\u0dba\u0dca\u0da0\u0dd2\u0dad \u0d9a\u0dcf\u0dd4\u0d9a\u0db8\u0d9a\u0daf\u0dd3 \u0dc0\u0dd2\u0db8\u0db0\u0dba\u0d9c\u0dad \u0dc0\u0dd0\u0db3\u0dc3\u0da7\u0dc4\u0db1 \u0dba\u0da7\u0db8\u0dad\u0dca \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0dcf\u0dcf \u0d9a\u0dd4\u0db1\u0dca\u0db8\u0db1\u0dca \u0db8\u0db8\u0dc0\u0dd0\u0dc3\u0dd2 \u0db8\u0daf\u0dba\u0dc2\u0dab.\n\n\u0d9a\u0dd4\u0db1\u0dca\u0db1 \u0dc3\u0dc0\u0dba\u0dba \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0dc3\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0db8\u0dba\u0ddd\u0da2\u0db1\u0dcf \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dc2\u0dab \u0dc3\u0dda\u0db6\u0db1\u0dca\u0d9a\u0dca\u0d9a\u0dd4\u0d9a \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd4\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0dca\u200d\u0dbb\u0dcf\u0db8\u0db0\u0dad\u0dba \u0dba \u0dc3\u0dda\u0db6\u0db1\u0dca\u0d9a\u0dca\u0d9a\u0dd4\u0d9a \u0d9a\u0db8\u0dd2\u0da7\u0dd4 \u0dc4\u0dd4\u0dc4\u0dcf \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0dcf\u0dcf \u0d9a\u0dd4\u0dbd\u0dcf \u0dc4\u0dd0\u0db8 \u0db8\u0d9a\u0db8\u0db1\u0dbb\u0dd4\u0db8 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0 \u0d9a\u0dd4\u0db8\u0d9c\u0db1 \u0d91\u0dad\u0dd0\u0db1\u0da7 \u0d91\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d92 \u0dc3\u0db1\u0dd4\u0dc0 2025 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0da7\u0dad\u0dca \u0db8\u0dda \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 2 250 \u0dc3\u0db3\u0dc4\u0dcf\u0db8 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 \u0db8\u0dba\u0ddd\u0da2\u0db1\u0dcf \u0dbd\u0dd0\u0db6\u0dd2\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0d9a\u0db8\u0dc3\u0dda \u0db8\u0dc0\u0dad\u0dad\u0dca \u0db8\u0dda \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc3\u0dad\u0da7 \u0daf\u0dd3\u0dbd\u0dcf \u0dca\u200d\u0dbb\u0dcf\u0db8\u0db0\u0dad\u0dba \u0dba \u0dc0\u0dba\u0db8\u0dba\u0db1\u0dca \u0dc3\u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0d86\u0d9a\u0dcf\u0dd4\u0db8\u0dba\u0db1\u0dca \u0d92 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc0\u0dd2\u0dba\u0daf\u0dda \u0db8\u0dc0\u0db1 \u0d91\u0d9a \u0dc3\u0db4\u0dd2 \u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd4\u0db1\u0dca\u0db8\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0db8\u0ddc\u0d9a\u0daf \u0dc3\u0dc0\u0dc3\u0dcf\u0db1\u0db8\u0d9a\u0daf\u0dd3 \u0db8\u0dc4\u0da2\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc0\u0dd0\u0dba \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dc0\u0db1\u0dca\u0db8\u0db1\u0dca \u0dc3\u0db8\u0dc3\u0dca\u0dad\u0dba\u0dc2\u0dab \u0db8\u0dbd\u0dc3 \u0dd4\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0db8\u0d9c\u0db1 \u0dba\u0dd1\u0db8\u0da7\u0dba\u0dd2. \u0d92\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0dc3\u0db8\u0dda \u0db1\u0dc0 \u0dca\u200d\u0dbb\u0db8\u0dbb\u0dba\u0dba.\n\nii. \u0d92 \u0dca\u200d\u0dbb\u0db8\u0dbb\u0dba\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd4\u0db8\u0dd2\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc3\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dba\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca MF/02/2025 \u0daf\u0dd4\u0db1 2025.01.29 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0da0\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db8\u0d9a \u0dc3\u0d82\u0d9a 2.7 \u0dc4\u0dcf 3 \u0db8\u0da2\u0dca\u0daf\u0dc0\u0dbd\u0da7 \u0dc3\u0db1\u0dd4\u0dc0 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dc2\u0dab \u0dc3\u0dda\u0db6\u0db1\u0dca\u0d9a\u0dca\u0d9a\u0dd4\u0d9a \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0da7 \u0db8\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d8b\u0db4\u0db8\u0daf\u0dc3\u0dca \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf.\n\n\u0d91\u0dad\u0dd0\u0db1\u0daf\u0dd3 \u0d92 \u0d8b\u0db4\u0db8\u0daf\u0dc3\u0dca \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8 \u0dc0\u0dd2\u0db8\u0dba\u0dda\u0dc2\u0db8\u0dba\u0db1\u0dca\u0db8 \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba\u0d9a\u0dad\u0dca\u0dc0\u0dba \u0d89\u0dbd\u0dc2\u0dab\u0d9a \u0d9a\u0dd4\u0db8\u0d9c\u0db1 \u0dc3\u0dc0\u0dd2\u0db6\u0dbd\u0d9c\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0d89\u0dbd\u0dc2\u0dab\u0d9a \u0d9a\u0dd4\u0db8\u0d9c\u0db1 \u0d92 \u0dc0\u0dcf\u0db8 \u0db8 \u0d9a\u0da9\u0dbd\u0db3\u0dcf\u0dba\u0dda \u0dc4\u0dd0\u0d9f\u0dd3\u0db8 \u0d89\u0dbd\u0dc2\u0dab\u0d9a \u0d9a\u0dd4\u0db8\u0d9c\u0db1 \u0dad\u0dc3\u0dd2 \u0dad\u0dc3\u0dd2\u0dc0 \u0d9a\u0dd4\u0db1 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dc0\u0dbd\u0da7 \u0dc0\u0db3\u0dcf \u0d92\u0d9a\u0dcf\u0db6\u0db0\u0dad\u0db0\u0dc0 \u0dc0\u0dd0\u0db3 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9a\u0dd2\u0dba\u0db1 \u0dc3\u0dd2\u0dbb\u0dca\u0d9a\u0dcf\u0dba\u0d9a \u0d9c\u0d9a\u0db1\u0dcf\u0dc0\u0dc2\u0dab \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd4\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf.\n\niii. \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dc0\u0dc3\u0dd4 10 \u0d9c\u0dad\u0dca\u0dad\u0dcf\u0db8 \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db8\u0dc0\u0db1\u0dca \u0db8\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0db8\u0dc0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc0\u0db1 \u0dc3\u0db8\u0dd4\u0dab\u0dd4\u0db8\u0dc2\u0dab \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db8 \u0dc3\u0dc0\u0db8\u0db6\u0ddd\u0db0\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0da7 \u0d92\u0db8\u0d9a\u0db1\u0dca \u0db8\u0d9a\u0ddc\u0da7\u0dc3\u0dc2\u0dab \u0d9a\u0dd2\u0dba\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. 2015 \u0dc3\u0dd2\u0da7 2025 \u0daf\u0dc2\u0dab\u0dc0\u0dcf \u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0db1 \u0db8\u0dc0\u0db1\u0dca \u0db4 \u0d86\u0d9a\u0dcf\u0dd4\u0dba \u0d91\u0dc4\u0dd2 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0db8\u0dc0\u0db1\u0dc0\u0dcf. 2015 \u0dc0\u0dbb\u0dca\u0dc2\u0db8\u0d9a\u0daf\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1 125\u0dbb\u0dd4\u0dad\u0dca 2016 \u0dc0\u0dbb\u0dca\u0dc2\u0db8\u0d9a\u0daf\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 3 375\u0dbb\u0dd4\u0dad\u0dca \u0d86\u0daf\u0dd3 \u0dc0\u0dba\u0db8\u0dba\u0db1\u0dca \u0db8\u0dc0\u0db1\u0dc3\u0dca \u0db8\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0dc3\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf. 2024 \u0dc0\u0dbb\u0dca\u0dc2\u0db8\u0d9a\u0daf\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 13 250\u0d9a \u0dc0\u0dd2\u0dba\u0dcf\u0dbd \u0db8\u0dd4\u0daf\u0dbd\u0dc2\u0dab \u0db8\u0dc0\u0db1\u0dca \u0d9a\u0dd4\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0dda \u0dc3\u0dc0\u0dd4\u0dbb\u0dd4\u0db0\u0dad\u0db8\u0db0\u0dad\u0daf\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 2 250\u0dc2\u0dab \u0db8\u0dc0\u0db1\u0dca \u0db8\u0dc0\u0db1\u0dca\u0db8\u0db1\u0dca \u0db8\u0dda \u0dc3\u0dd2\u0dbb\u0dca\u0d9a\u0dcf\u0dba\u0d9a \u0db4\u0dcf\u0daf\u0d9a \u0d9a\u0dd4 \u0d9c\u0dad\u0dca \u0d9a\u0dca\u200d\u0dbb\u0db8\u0db8\u0dbb\u0daf \u0dc3\u0db3\u0dc4\u0dcf\u0dba\u0dd2. \u0db8\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dd4\u0dcf\u0dad\u0dca\u0db8\u0d9a\u0dc0 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc0\u0db1 \u0db8\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1\u0dba \u0db8\u0dda \u0dc3\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0db8\u0dbb\u0daf\u0dd3 \u0db8\u0dcf \u0dc4\u0db7\u0dcf\u0d9c\u0dad* \u0d9a\u0dd4\u0db1\u0dc0\u0dcf.\n\n\u0db8\u0dda \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db8\u0dc0\u0db1\u0dca \u0db8\u0dc0\u0db1\u0dca\u0db8\u0db1\u0dca \u0db8\u0dda \u0dc3\u0dd2\u0dbb\u0dca\u0d9a\u0dcf\u0dba\u0d9a \u0db4\u0dcf\u0daf\u0d9a \u0d9a\u0dd4 \u0d9c\u0dad\u0dca \u0d9a\u0dca\u200d\u0dbb\u0db8\u0db8\u0dbb\u0daf \u0dc3\u0db3\u0dc4\u0dcf\u0dba\u0dd2."
  },
