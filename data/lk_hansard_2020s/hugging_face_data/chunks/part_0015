    "chunk_text": "1978\u0dd3 \u0d85\u0d9c\u0dda \u0dba\u0db4\u0db4 \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba \u0d9c\u0d9c\u0db1\u0dd0\u0dca \u0dbd\u0dcf, \u0d85\u0d9c\u0dda \u0dba\u0db4\u0dad\u0dca \u0dd2\u0da7\u0d82\u0d9c\u0dda\u0dca\u0dbb\u0dd4\u0dc0 [ \u0dc0\u0dcf\u0d9c\u0dda \u0dba\u0db4 [ \u0db6\u0dc0\u0db4 \u0db4\u0dad\u0dca \u0d9a\u0dba\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dad\u0db8\u0dba\u0dd2, 1982 \u0d85\u0d82\u0d9a 17 \u0daf\u0dba\u0db1 \u0db4\u0dd0\u0dba\u0dab\u0dd2 \u0dc3\u0db8\u0dcf\u0d9c\u0db8\u0dca \u0db4\u0db1\u0dad \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0d9c\u0dd9\u0dda. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0d9a\u0dcf\u0dbd\u0dba [ \u0dba\u0db1\u0d9c\u0d9a\u0dcf\u0db4 \u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0d85\u0dc0 \u0dba\u0dad\u0dcf\u0dc0 [ \u0db8\u0dad 2007\u0dd3 \u0d91\u0dba \u0dc3\u0d82\u0d9c \u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dba\u0db1\u0dca\u0daf\u0db1 \u0d9c\u0dc0\u0db1\u0dc0\u0dcf. \u0d92 \u0d9c\u0d9a\u0dcf\u0d9c\u0dc4\u0dcf\u0db8 \u0dc0\u0dd4\u0dab\u0dad\u0dca 1978\u0dd3 \u0d9a\u0dd2\u0dc0\u0dca\u0dc0 \u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0db4 \u0d85\u0d9c\u0dda \u0dba\u0db4 \u0dd2\u0da7\u0d82\u0d9c\u0dda\u0dca\u0dbb\u0dd4\u0dc0 [ \u0db6\u0dc0\u0db4 \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0dba \u0d9a\u0dba\u0d9c\u0db1\u0dca\u0daf\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0d9c\u0dc0\u0db1\u0dc0\u0dcf. \u0d91\u0daf\u0dcf \u0d85\u0d9c\u0dda \u0dba\u0db4\u0dad\u0dca \u0dd2\u0da7\u0d82\u0d9c\u0dda\u0dca\u0dbb\u0dd4\u0dc0 [ \u0d9c\u0dbd\u0dc3 \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0dba \u0d9a\u0dba\u0db1\u0dca\u0daf\u0db1 \u0dc4\u0dd2\u0dad\u0dd4\u0dc0\u0dcf\u0db4, \u0d85\u0d9c\u0dda \u0db4\u0db1\u0dad\u0dca\u0dc0\u0dbd \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0d9c\u0dd0\u0db4\u0dbd\u0dd4 \u0db1\u0dd2\u0dc3\u0dcf \u0dc3\u0dc4 \u0d86\u0d9c\u0dba\u0ddd\u0da2\u0d9a\u0dba\u0db1\u0dca\u0daf \u0d9c\u0db8\u0dca \u0dba\u0db4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0daf [\u0dc0\u0db1 \u0d86\u0d9a\u0dca \u0db4\u0dba \u0db1\u