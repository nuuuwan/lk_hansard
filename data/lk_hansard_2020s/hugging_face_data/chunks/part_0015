    "chunk_text": "\u0dba\u0db8\u0dca \u0dbb \u0dbb\u0dbd\u0dca \u0dbb\u0dda\u0dbb\u0db1\u0dca \u0da2\u0db1\u0db1\u0dcf\u0dc0\u0dcf ,\u0db6\u0dcf \u0d9c\u0dad\u0dca \u0db1\u0dca\u0db4\u0dd2 \u0dbd\u0dca 21\u0db4000\u0dbb \u0dba \u0dcf\u0dbb\u0dcf \u0dc0\u0dcf\u0dd0\u0da7\u0dd4 \u0dba\u0dda \u0dbb\u0da2 \u0da7\u0dba\u0dad\u0dca ,\u0db6\u0db1 \u0da2\u0db1\u0dc0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dba\u0dc0\u0dcf\u0db1\u0dba\u0dbb\u0dcf\u0da7 -\u0dba\u0dda \u0d85\u0dc0\u0dd4\u0db1\u0dca\u0dda\u0dba\u0dda \u0dba\u0dba\u0dc3\u0dd0\u0dda\u0db6\u0dbb\u0dca\u0dbd 31\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dd4- \u0db1\u0dca\u0db4\u0dd2 \u0dbd\u0dca 30\u0db4000\u0d9a\u0dca \u0dba\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0dc0\u0dcf\u0dd0\u0da9\u0dd2 \u0dbb\u0dbb \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0dcf. \u0d87\u0dad\u0dca\u0db1\u0da7\u0db8 \u0dba\u0dda\u0dbb \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7 \u0dc3\u0dd1\u0dba\u0dc4\u0db1 \u0dc0\u0dcf\u0dd0\u0da7\u0dd4 \u0d9a\u0dca \u0d9a\u0dd2 \u0dcf \u0d9a\u0dd2 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db1 \u0db6\u0dd0\u0dc4\u0dd0. \u0dba\u0db8\u0dcf\u0dbb\u0dba\u0db4 \u0dba\u0dda \u0dbb\u0dba\u0db8 \u0dad\u0dd2\u0dba\u0db6\u0db1 \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0dbb \u0db1\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dcf \u0da7\u0dba\u0dad\u0dca \u0db1\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dba\u0dda \u0d9c\u0dd0\u0db1 \u0dbb\u0dae\u0dcf \u0dbb\u0dbb\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0db4\u0dd2 \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db1\u0dc0\u0dcf\u0dcf\u0db4 \u0dba \u0dde\u0dda\u0d9c\u0dd2\u0dbb \u0d85\u0d82 \u0dba\u0dda \u0dba\u0dc3\u0dca\u0dc0\u0dcf\u0dbb \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7 \u0dc3\u0db8\u0dc4\u0dbb \u0dba\u0dc0\u0dcf,\u0dcf\u0dc0\u0dcf\u0da7 \u0db8\u0dd3\u0da7 \u0dc0\u0dcf\u0dba\u0dcf \u0dc0\u0dd2 \u0dcf, \u0dc0\u0dcf\u0dd0\u0da7\u0dd4 \u0d9a\u0dca ,\u0dd0\u0dba\u0db6\u0db1 \u0db6\u0dc0\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2\u0db4 \u0dba\u0dda \u0dd4\u0dc5\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d85\u0db4\u0dd2 \u0dc4\u0dc5\u0db8 \u0db8\u0db8\u0da7\u0dba\u0dda \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dba\u0dc3\u0dca\u0dc0\u0dcf\u0dbb \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7 \u0dda \u0dc3\u0dc4\u0db1 \u0d9a\u0dca ,\u0db6\u0dcf \u0daf\u0dd3 \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0dcf. \u0d85\u0db4\u0dd2 \u0dc3\u0dd2 \u0da7 50\u0dbb\u0da7 \u0d86\u0dc3\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db1 \u0dc0\u0dcf\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc0\u0dcf\u0dd0\u0da9\u0dd2\u0dd3\u0db8\u0d9a\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dd4\u0dc5 \u0dc3\u0db8\u0dc3\u0dca\u0db1 \u0dba\u0dc3\u0dca\u0dc0\u0dcf\u0dbb\u0dba\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7 \u0dc0\u0dcf\u0dd0\u0da7\u0dd4\u0db4\u0dca ,\u0db6\u0dcf \u0daf\u0dd3\u0dba\u0dda\u0daf\u0dd3 \u0d92 \u0dc4\u0dcf\u0dda\u0db4\u0dd4\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7 \u0dba\u0dda \u0d9c\u0dd0\u0db1 \u0dc3,\u0dbb\u0dcf \u0db6,\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db1 \u0dc3\u0dd2\u0dda\u0db0 \u0dba\u0dc0\u0dcf\u0db1\u0dc0\u0dcf\u0dcf. \u0d92 \u0dc0\u0dd2\u0db1\u0dbb\u0d9a\u0dca \u0dba\u0db1\u0dcf\u0dba\u0dc0\u0dcf\u0dba\u0dd2. \u0dba\u0dda \u0db1\u0dd2\u0dc3\u0dcf \u0dcf\u0dbb\u0dd2\u0dba\u0db1\u0ddd\u0dd2\u0dbb ,\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0dba\u0dda\u0daf\u0dd3\u0dad\u0dca\u0db4 ETF ,\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0dba\u0dda\u0daf\u0dd3\u0dad\u0dca \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0d86\u0dbb\u0dcf\u0dbb\u0dba \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dba\u0dc3\u0dca\u0dc0\u0dcf\u0dbb\u0dba\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2,\u0dcf\u0db7 ,\u0dd0\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0dcf.\n\n\u0d85\u0db4\u0dd2 \u0db6,\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db1 \u0d95\u0db1\u0dd1\u0db4 \u0d87\u0dba\u0dd2 \u0dba\u0db8\u0dba\u0dc4\u0db8 \u0dc0\u0dcf\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc0\u0dcf\u0dd0\u0da9\u0dd2 \u0dbb\u0dba\u0dc5\u0dca\u0db4 \u0d87\u0dba\u0dd2 \u0dbb\u0da2 \u0da7 \u0dba\u0db8\u0dba\u0dc4\u0db8 \u0dc0\u0dcf\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc0\u0dcf\u0dd0\u0da9\u0dd2 \u0dbb\u0dbb\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db1 \u0dc4\u0dd2\u0dd4\u0dba\u0da9\u0dbd\u0db4 \u0d87\u0dba\u0dd2 \u0dba\u0dda \u0dbb\u0da2 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\n\n\u0dba\u0db8\u0db1\u0dd0\u0db1\u0daf\u0dd3 \u0db8\u0dd6\u0dd2\u0dbb \u0dc0\u0dcf \u0dba \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dd2\u0dda\u0db0\u0dd2\u0dba \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dd2\u0dda\u0db0\u0dd2 \u0db4 \u0db1\u0dca\u0db4\u0dd2 \u0dba,\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db1\u0dca\u0db4\u0dd2 , \u0d9c\u0dd0\u0db1 \u0dbb\u0dae\u0dcf \u0dbb\u0dbb\u0db1\u0dc0\u0dcf\u0dcf\u0da7 \u0dc0\u0dcf\u0dba\u0dcf \u0d87\u0dad\u0dca\u0db1\u0da7\u0db8 \u0dba\u0dda \u0dbb\u0da2\u0dba\u0dda \u0d85\u0dbb\u0db8\u0dd4\u0dab\u0db4 \u0dba\u0dda \u0dbb\u0da2 \u0db1 path \u0d91\u0dbb - \u0dbb\u0da2 \u0db1 \u0db8\u0d9f - \u0dba\u0db8\u0dcf\u0dbb\u0d9a\u0dca\u0dba \u0d9a\u0dd2 \u0db1 \u0d91\u0dbb \u0dba\u0dda \u0dc0\u0dcf\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc0\u0dcf\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d87\u0dd4\u0dba\u0dc5\u0dca \u0dba \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db1\u0dd4\u0dda \u0dbb\u0dbb\u0db1\u0dc0\u0dcf\u0dcf. \u0dba\u0dda \u0dbb\u0da2\u0dba\u0dda \u0d91\u0d9a\u0dca \u0d85\u0dbb\u0db8\u0dd4\u0dab\u0d9a\u0dca \u0db1\u0db8\u0dba\u0dd2\u0db4 \u0da2\u0db1 \u0dc3\u0dc4\u0db7\u0dcf\u0d9c\u0dd2\u0dad\u0dca\u0dc0\u0dcf \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0dbb \u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8. \u0d92 \u0da2\u0db1 \u0dc3\u0dc4\u0db7\u0dcf\u0d9c\u0dd2\u0dad\u0dca\u0dc0\u0dcf \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0dbb \u0d87\u0dd4\u0dba\u0dc5\u0dca \u0dc3\u0dd2\u0dbb\u0dcf\u0dc0\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0db8 \u0dbb\u0dcf\u0dbb\u0dab \u0db1\u0db8\u0dba\u0dd2\u0db4 \u0dc3\u0dd2 \u0dbd\u0dd4 \u0da2\u0db1 \u0dcf \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0dbb \u0da7 \u0dc3\u0dc4\u0db7\u0dcf\u0d9c\u0dd2 \u0dd3\u0db8. \u0d92 \u0dc0\u0dd2\u0db1\u0dbb\u0d9a\u0dca \u0dba\u0db1\u0dcf\u0dba\u0dc0\u0dcf\u0dba\u0dd2. \u0d92 \u0dc3\u0dc4\u0db7\u0dcf\u0d9c\u0dd2\u0dad\u0dca\u0dc0\u0dcf \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0dbb\u0dba \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb ,\u0dd0\u0dba\u0db6\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2,\u0dcf\u0db7 \u0da2\u0db1\u0db1\u0dcf\u0dc0\u0dcf \u0d85\u0db1\u0da7 \u0dad\u0dca \u0dba\u0dc0\u0dcf\u0db1\u0dc0\u0dcf\u0dcf. \u0dba\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db1 \u0dba\u0dda\u0dbb \u0db1\u0db8\u0dba\u0dd2 \u0d85\u0dba\u0db4\u0dca \u0db8\u0dd6,\u0db0\u0dbb\u0dca\u0dbd\u0db8 ."
