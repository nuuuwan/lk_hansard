u0dba \u0dc3\u0db3\u0dd9\u0ddc \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4 \u0dbd\u0db6\u0ddc \u0daf\u0dd3\u0dbd\u0ddc \u0dad\u0dd2\u0db4\u0dc4\u0db6\u0db1\u0dc0\u0ddc \u0d9a\u0dd2\u0dba\u0dbd\u0ddc \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dd2\u0dba \u0d9a\u0dd2 \u0dc0\u0ddc.\n\n\u0d9c\u0dbb\u0dd4 (\u0d86\u0da0\u0dcf\u0dbb\u0dca\u0dba) \u0dad\u0dbb\u0dd2\u0db1\u0dd2 \u0d85\u0db8\u0dcf\u0dad\u0dbb\u0dc3\u0dd6\u0dbb\u0dd2\u0dba (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 (\u0b95\u0bb2\u0bc6\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf) \u0bb9\u0bc6\u0bbe\u0bbf\u0ba9\u0bbf \u0b85\u0bc8\u0bb0\u0b9a\u0bc2\u0bc6\u0bbe\u0bbf\u0baf) (The Hon. (Dr.) Harini Amarasuriya) \u0dad\u0dc0\u0dbb\u0ddc \u0d87\u0dad\u0dd2\u0db4 \u0db1\u0dd4 \u0dc3\u0dcf\u0d9b\u0dba\u0ddc\u0dc0 157\u0dba\u0dd2. \u0d9c\u0dbb\u0dd4 \u0dd4 \u0dd2\u0dad\u0db6\u0dd4\u0dbb\u0dca \u0dbb\u0dc4\u0dd4\u0db8\u0dcf\u0dad\u0dcf\u0db1\u0dca \u0db8\u0dcf\u0dad\u0dad\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0bae\u0bc1\u0b9c\u0bbf\u0baa\u0bc1\u0bb0\u0bcd \u0bb0\u0bb9\u0bc1\u0bc8\u0bc6\u0bbe\u0ba9\u0bcd) (The Hon. Mujibur Rahman) \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4 \u0dbd\u0db6\u0ddc \u0daf\u0dd3\u0dbd\u0ddc \u0dad\u0dd2\u0db4\u0dc4\u0db6\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0ddc\u0daf\u0dba \u0d9a\u0dd3\u0dba\u0d9a\u0dca\u0d9a\u0dba ? \u0d9c\u0dbb\u0dd4 (\u0d86\u0da0\u0dcf\u0dbb\u0dca\u0dba) \u0dad\u0dbb\u0dd2\u0db1\u0dd2 \u0d85\u0db8\u0dcf\u0dad\u0dbb\u0dc3\u0dd6\u0dbb\u0dd2\u0dba (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 (\u0b95\u0bb2\u0bc6\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf) \u0bb9\u0bc6\u0bbe\u0bbf\u0ba9\u0bbf \u0b85\u0bc8\u0bb0\u0b9a\u0bc2\u0bc6\u0bbe\u0bbf\u0baf) (The Hon. (Dr.) Harini Amarasuriya) 65\u0dba\u0dd2. \u0d9c\u0dbb\u0dd4 \u0dd4 \u0dd2\u0dad\u0db6\u0dd4\u0dbb\u0dca \u0dbb\u0dc4\u0dd4\u0db8\u0dcf\u0dad\u0dcf\u0db1\u0dca \u0db8\u0dcf\u0dad\u0dad\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0bae\u0bc1\u0b9c\u0bbf\u0baa\u0bc1\u0bb0\u0bcd \u0bb0\u0bb9\u0bc1\u0bc8\u0bc6\u0bbe\u0ba9\u0bcd) (The Hon. Mujibur Rahman) \u0d92 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4 \u0dbd\u0db6\u0ddc \u0daf\u0dd3\u0dbd\u0ddc \u0dad\u0dd2\u0db4\u0dc4\u0db6\u0db1 65\u0db1\u0dca \u0d9a\u0dd3\u0dba\u0dda \u0dc0\u0dd2\u0dca\u0dad\u0dd2\u0db4\u0dda\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dbb \u0dda\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dd9\u0dd0\u0dd2\u0dba\u0dd4 \u0db1\u0db8\u0dca \u0dda\u0dbb\u0dbd\u0ddc \u0dad\u0dd2\u0db4\u0dc4\u0db6\u0db1\u0dc0\u0ddc ?\n\n\u0d9c\u0dbb\u0dd4 (\u0d86\u0da0\u0dcf\u0dbb\u0dca\u0dba) \u0dad\u0dbb\u0dd2\u0db1\u0dd2 \u0d85\u0db8\u0dcf\u0dad\u0dbb\u0dc3\u0dd6\u0dbb\u0dd2\u0dba (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 (\u0b95\u0bb2\u0bc6\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf) \u0bb9\u0bc6\u0bbe\u0bbf\u0ba9\u0bbf \u0b85\u0bc8\u0bb0\u0b9a\u0bc2\u0bc6\u0bbe\u0bbf\u0baf) (The Hon. (Dr.) Harini Amarasuriya) \u0d92 \u0dc4\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0db8\u0ddc \u0d89\u0dd9\u0dad\u0dd2\u0db4\u0db1\u0dca \u0dc3\u0dcf\u0ddc\u0d9c\u0dad \u0dda\u0dc5 \u0d87\u0dc4\u0dd4 \u0dab\u0dd4\u0dc4\u0db8\u0dc4\u0dd2 \u0dc3\u0db3\u0dd9\u0db1\u0dca\u0dc0 \u0dad\u0dd2\u0db4\u0dc4\u0db6\u0db1\u0dc0\u0ddc \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0ddc.\n\n\u0dc0\u0dda\u0dbd\u0dc0\u0db1\u0dba\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dcf.\u0dc0\u0dbd\u0dca. \u0dc0\u0d9a\u0dcf\u0dca\u0dc3\u0dcf\u0dc3\u0dba \u0dad\u0dd0\u0db4\u0dd0\u0dbd\u0dca\n\n\u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba \u0b95\u0bb5\u0bb2\u0bb2\u0ba3 \u0baa\u0bbf\u0bb0\u0b95\u0ba4\u0b9a \u0ba4\u0b9a\u0baf\u0bb2\u0bc6\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bc6\u0bbe\u0bbf\u0bb5\u0bc1: \u0ba4\u0baa\u0bc6\u0bbe\u0bb2\u0bcd\n\n\u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0b95\u0bae\u0bcd VELANAI DS DIVISION: POST OFFICE\n\n950/2025 5. \u0d9c\u0dbb\u0dd4 \u0dbb\u0da2\u0dd3\u0dc0\u0db1\u0dca \u0dc0\u0da2\u0dba\u0da0\u0db1\u0dca\u0dbb\u0db8\u0dd6\u0dbb\u0dca\u0dad\u0dd2\u0da5 \u0db8\u0dcf\u0dad\u0dad\u0dad\u0dcf