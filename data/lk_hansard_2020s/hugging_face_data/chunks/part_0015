    "chunk_text": "\u0d92 \u0db1\u0dd2 \u0db0\u0dcf\u0db4\u0dad\u0dba\u0dcf \u0d9c\u0dad\u0dca\u0dad \u0dad\u0dd3\u0dba\u0da7\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dad\u0db8\u0dba\u0dd2 \u0dd9\u0dd0\u0db1\u0dca \u0dc1\u0db8\u0dca \u0d85\u0dba\u0ddd\u0dc1\u0dba\u0ddd\u0d9c\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dcf\u0dba\u0da7\u0dba \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca\u0da9 \u0dd9\u0dd0\u0db1\u0dca \u0dc1\u0d9a\u0dcf\u0dc5\u0db9 \u0db8\u0dc4 \u0db1\u0d9c\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0dc1\u0db1\u0dca \u0db4\u0dcf\u0dd9\u0d9a \u0d9a\u0dba \u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca\u0da9 \u0d85\u0dba\u0ddd\u0dc1\u0dba\u0ddd\u0d9c\u0dba cancel \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0dc1\u0db1\u0dca\u0da9 \u0dc1\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0dd9 \u0d85\u0dba\u0ddd\u0dc1\u0dba\u0ddd\u0d9c\u0dba? \u0d85\u0dba\u0ddd\u0dc1\u0dba\u0ddd\u0d9c\u0dba cancel \u0dc1\u0dc0\u0db1\u0dc0\u0dcf\u0da9 \u0dc3\u0dd2\u0dad\u0dad\u0dca \u0dc1\u0dda\u0db8\u0dd9\u0dcf\u0dc3 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dba\u0dcf\u0dc1\u0dda\u0db8 \u0db4\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dc1\u0dc0 \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dca \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0dc1\u0dc0 \u0dcf \u0dba\u0dc4\u0dc3\u0dba \u0da1\u0db1\u0dca\u0dd9\u0dba\u0da7 \u0dba\u0dcf\u0da9 \u0dd2\u0dad\u0dd2\u0db1\u0dca, \u0dc1\u0d9a\u0dcf\u0dc1\u0dc4\u0dcf\u0db8\u0dd9 \u0dd3\u0db8\u0dad\u0dd2\u0db8\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0dbd\u0dc1\u0dc4\u0db8 \u0d9a\u0dc1\u0dc5\u0dda \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0db1\u0dca \u0dc1\u0db1\u0dca\u0da9 \u0d92\u0d9a \u0dc1\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dd9\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca\u0da9 \u0d85\u0dd2\u0dad\u0dad\u0dca \u0db4\u0dd3\u0da9 \u0dc1\u0db4\u0dc1\u0dbb\u0dca\u0dba\u0dcf \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dba\u0dcf \u0db1\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dbd\u0dad\u0dd0\u0db1\u0daf\u0dd3 \u0db1\u0db8\u0dca \u0d85\u0dac\u0d9c\u0dc4\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1\u0dba \u0d9a\u0dd2\u0dba \u0dcf\u0da9 \u0dd2\u0dad\u0dd2\u0db1\u0dca, \u0db1\u0db8\u0dca \u0d85\u0dac\u0d9c\u0dd0\u0dbb\u0dd4\u0dc0\u0dcf \u0dc1\u0db1\u0dca\u0da9 \u0dc1\u0d9a\u0dcf\u0dc5\u0db9 \u0db8\u0dc4 \u0db1\u0d9c\u0dba \u0dc3\u0db7\u0dcf\u0dc1\u0dda \u0dba\u0dc4\u0dc3\u0dba \u0da1\u0db1\u0dca\u0dd9\u0dba \u0dc0\u0dd2\u0db8\u0dd6 \u0d85\u0dc0\u0dc3\u0dda\u0dcf\u0dcf\u0dc1\u0dda\u0daf\u0dd3 117\u0dc1\u0dd9\u0db1\u0dcf\u0dc1\u0dda\u0db8 \u0db1\u0db8\u0dca \u0d85\u0dac \u0d9c\u0dc4 \u0dcf \u0da1\u0db1\u0dca\u0dd9\u0dba \u0dd4\u0dc0\u0db8\u0dca \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf\u0da9 \u0da1\u0db1\u0dca\u0dd9\u0dba \u0d9c\u0da7\u0db1\u0dca \u0d9a\u0dba\u0db1\u0dc1\u0d9a\u0dcf\u0da7 \u0dad\u0db8\u0dba\u0dd2 \u0dd9\u0dd0\u0d9a\u0dca\u0dc1\u0d9a\u0dca 62\u0d9a \u0dc1\u0dca.\u200d\u0db1\u0dba 54 \u0dc1\u0dc0 \u0dcf, \u0d85\u0dc1\u0dda \u0dc1\u0dca.\u200d\u0db1\u0dba 61 \u0dc1\u0dc0 \u0dcf \u0d9a\u0dd2\u0dba \u0dcf\u0da9 \u0dbd\u0dad\u0dc1\u0d9a\u0dcf\u0da7 \u0dc1\u0db8\u0dca \u0d85\u0dba\u0da7 \u0dc1\u0d9a\u0dca\u0db1\u0dca\u0dad\u0dd2 \u0dba\u0dcf\u0da9 \u0dc1\u0d9a\u0dca\u0db1\u0dca\u0dad\u0dd2 \u0dc4\u0dd2\u0db1\u0dca \u0dc1\u0db8\u0dca \u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0d87\u0dc0\u0dd2\u0dca. \u0dcf \u0d9a\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0db8\u0dcf\u0da7 \u0db6\u0dd0\u0da7 \u0dc0\u0dd0\u0dd4\u0da7\u0dcf\u0da9 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dd4 \u0dbb\u0dd0\u0dc3\u0dda\u0dd3\u0db8\u0dca \u0dd9\u0dc0\u0dc3\u0d9a\u0dca \u0dc0\u0dbb\u0dca\u0da2\u0db1\u0dba \u0d9a\u0dc5\u0dcf\u0da9 \u0dd9\u0dc0\u0dc3\u0d9a\u0dca \u0dc0\u0dbb\u0dca\u0da2\u0db1\u0dba \u0d9a\u0dba\u0db8\u0dd2\u0db1\u0dca \u0dd2\u0db3 \u0dcf \u0d8a\u0da7 \u0db4\u0dc3\u0dd4\u0dc0 \u0dd9\u0dcf face \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0dbb\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc1\u0dc0\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dcf \u0dc4\u0dd2\u0dad \u0dcf \u0dc1\u0db8\u0dca \u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0d86\u0dc0\u0dcf\u0da9 \u0d85\u0dc1\u0db1\u0dca! \u0dc1\u0db8\u0dad\u0dd0\u0db1\u0da7 \u0d87\u0dc0\u0dd2\u0dad\u0dca \u0dc0\u0dcf\u0db1\u0db8 \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0dcf\u0da7 \u0dc1\u0d9a\u0dcf\u0dc1\u0dc5\u0dcf\u0db1\u0dca\u0db1\u0dcf\u0dc0 \u0db1\u0d9c\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0d9c\u0dc4 \u0dcf \u0dc4\u0dd2\u0dca. \u0dcf\u0da9 \u0d9a\u0dc0\u0dd4\u0dd9 \u0da1\u0db1\u0dca\u0dd9\u0dba \u0daf\u0dd3 \u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0dc3\u0db8 \u0da2\u0db1 \u0db6 \u0dc1\u0dda\u0d9c\u0dc1\u0dc0\u0db8 \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dca\u0da9 \u0d8a\u0da7 \u0db4\u0dc3\u0dd4\u0dc0 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf, \"\u0db1\u0dba\u0dd2-\u0db8\u0dd4\u0d9c\u0da7\u0dd2\", \"\u0db1\u0dba\u0dd2-\u0db8\u0dd4\u0d9c\u0da7\u0dd2\" \u0d9a\u0dd2\u0dba \u0dcf\u0da9 \u0db8\u0dcf\u0dba \u0dc0\u0dd0\u0da9\u0d9a\u0dca \u0dc1\u0db1\u0dca\u0da9\n\n\u0d9a\u0dba\u0db1\u0dca\u0db1 \u0d85\u0db4\u0da7 \u0d9a\u0dd2\u0dc3\u0dd2\u0dc1\u0dc3\u0dda\u0dad\u0dca\u0db8 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba \u0dcf\u0da9 \u0dd9\u0dd0\u0db1\u0dca \u0dc1\u0d9a\u0dcf\u0dc1\u0dc5\u0dcf\u0db1\u0dca\u0db1\u0dcf \u0dc0 \u0db1\u0d9c\u0dba \u0dc3\u0db7\u0dcf\u0dc1\u0dda \u0dc1\u0db8\u0dcf\u0d9a\u0dd9 \u0dc1\u0dc0 \u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0dc0\u0dd0\u0db1\u0db8\u0db8 \u0da1\u0db1\u0dca\u0dd9 \u0d9c\u0dad\u0dca\u0dad \u0d85\u0dc1\u0dda\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0d9a\u0dba\u0dcf \u0db1\u0d9c\u0dba\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0d9a\u0db8 \u0dd2\u0dca.\u0dbd\u0dd4\u0dc0\u0dcf\u0db8 \u0db6\u0dbb\u0dd4\u0dc0 \u0db4\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0da7 \u0dd9\u0dcf \u0dcf \u0dd0\u0dba\u0dd2\u0dc3\u0dda\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0d86\u0dbb \u0dc1\u0d9a\u0dc1\u0db1\u0dd4\u0dc0\u0da7 \u0daf\u0dd3 \u0dcf\u0da9 \u0db8\u0db8 \u0dd9\u0dd0\u0d9a\u0dca\u0d9a\u0dcf, \u0d92 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dba\u0dba\u0dcf \u0d92 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0d85\u0dd9\u0dc4\u0dc3\u0dda \u0db4\u0dc5 \u0d9a\u0dba \u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0da9 \u0db6\u0dbb\u0dd4 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0dd9? \"\u0db8\u0db8\u0dba\u0dd2 \u0dc3\u0dd4\u0dd4\u0dc3\u0dda\u0dc3\u0dcf\u0da9 \u0dc1\u0db8\u0dca \u0db4\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dc1\u0dc0 \u0dc3\u0dd4\u0dd4\u0dc3\u0dda\u0dc3\u0dcf\u0da7 \u0dc3\u0dd4\u0dd4\u0dc3\u0dd4 \u0dad\u0dd0\u0db1 \u0db1\u0dd0\u0dc4\u0dd0\u0da9 \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dc4\u0dca\u0dd9\u0dba \u0dc3\u0dcf\u0d9a\u0dca \u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dca \u0dc5\u0d9f\u0da7 \u0dba\u0db1\u0dca\u0db1 \u0dad\u0dd3\u0dba\u0da7\u0dba \u0d9a\u0dba\u0db1\u0dc0\u0dcf\" \u0d9a\u0dd2\u0dba \u0dcf \u0db6\u0dbb\u0dd4 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf, \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0d9a\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0db8\u0db1\u0dd2\u0da9 \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0dad\u0db8\u0dba\u0dd2 \u0db6\u0dbb\u0dd4 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0db1 \u0db6 \u0dc1\u0dda\u0d9c \u0dba\u0da7 \u0dc3\u0dc4\u0dc1\u0dba\u0ddd\u0d9c\u0dba \u0db4\u0dc5 \u0d9a\u0dba \u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca\u0da9"
  },
