    "chunk_text": "\u0d9c\u0dda\u0db4\u0dc4 \u0daf\u0dd2\u0dbd \u0dd2\u0d9a\u0dca\u0d9a\u0dc1\u0dda \u0db4\u0dc4 \u0d86\u0dbd\u0dc3\u0dc1\u0dda 5\u0dcf\u0dc1\u0dda\u0db4 \u0dc3\u0d82\u0d9a\u0dcf\u0dc1\u0dda\u0dad\u0dca\u0dc0 \u0dc1 \u0dcf\u0dc1\u0dc4\u0ddd\u0dc1\u0daf\u0dc1\u0dc3\u0d9a\u0dca \u0daf\u0db1\u0dca\u0dc3\u0dcf, \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dd4 \u0db4\u0db1\u0dca\u0dd35 \u0dc1\u0dba\u0dcf\u0d9a\u0d9a\u0dd4, \u0d85\u0db4\u0dcf\u0dad\u0dba5 \u0dc1\u0dba\u0dcf\u0d9a\u0d9a\u0dd4 5\u0dcf\u0dc1\u0dda\u0db4 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dad\u0dcf\u0dc3\u0dcf\u0db4\u0dad\u0dd25 \u0dc1\u0dba\u0dcf\u0d9a\u0d9a\u0dd4 \u0daf \u0d87 \u0d9c\u0dc0 \u0da7\u0dd2\u0dba\u0dd4\u0da9\u0dbb\u0dca \u0d9c\u0dd4\u0dab\u0dc1\u0dbd \u0d9a \u0db4\u0dd0\u0dad\u0dd2\u0dd4\u0db4\u0dcf\u0dc1\u0dda \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dc1\u0dda \u0d9c\u0dd4\u0dab \u0dba\u0dcf\u0d9a\u0dc4\u0db4\u0dad\u0dca\u0dc0\u0d9a\u0dda \u0dba \u0dba\u0dcf\u0d9a\u0dbd\u0dca\u0dc3\u0dad\u0dca\u0dc0 \u0daf \u0dcf\u0dc1\u0d9c\u0dc3 5\u0dcf \u0db4\u0dd4 \u0db4 \u0dda\u0db4 \u0dcf5\u0da7 \u0dc1\u0d9c\u0dc3 \u0dba\u0dcf\u0d9a\u0dd1\u0dc1\u0dda 5\u0d9c\u0dd3\u0db8\u0db4 \u0d85\u0db4\u0da7 \u0dad\u0dd2\u0dc1 \u0dc35\u0dcf \u0d9a\u0dd2\u0dba\u0dcf\u0d9a\u0dc3 \u0d91\u0d9a \u0dc4\u0dd2\u0dad\u0dca\u0dc05\u0dc3 \u0dad \u0dcf \u0dc1\u0d9c\u0dc3 \u0d85\u0daf \u0dc1\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dd4\u0dc1\u0dda \u0dc1 \u0ddd\u0d9a\u0dba\u0dcf\u0d9a \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf \u0d9a \u0dc3 \u0dc4\u0dd0\u0db4 \u0dc1\u0daf\u0dc3\u0dcf \u0d85\u0dad \u0da7 \u0d85\u0db4\u0dc1\u0dda \u0dc1 \u0ddd\u0d9a\u0dba\u0dcf\u0d9a\u0dad\u0dca\u0dc0 \u0d91\u0dd4\u0db4\u0dcf \u0dc15\u0db1\u0dd4\u0dc15\u0db1\u0dca \u0d91\u0db4 \u0db4\u0dc0\u0dd4\u0dc1\u0dbd\u0dca \u0d85\u0dba\u0dcf\u0d9a\u0da7 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf \u0d9a \u0dc3 5 \u0db4\u0dcf \u0d9a\u0dd2\u0dba\u0dcf\u0d9a\u0dcf \u0dba \u0da7\u0dd2\u0dc35\u0dcf. \u0db4\u0da7 \u0d855\u0dbd \u0dae\u0dcf5 \u0dc3 \u0dcf \u0daf\u0dd3\u0db4 \u0db4\u0dd2\u0db6\u0db3 \u0d8b5 \u0dbd \u0dd4\u0dad\u0dd2\u0dba\u0dcf\u0d9a \u0db4\u0dd4\u0daf \u0d9a \u0db8\u0dd2\u0db1\u0dca \u0db4\u0dcf \u0db1\u0dd2\u0dc4\u0dac \u0dc15\u0dc35\u0dcf, \u0db8\u0dd6\u0dc3\u0dcf\u0dbd\u0dc3\u0dcf \u0d91\u0daa \u0d9c\u0dc0 \u0db4\u0db1\u0dca\u0dd3\u0dd4\u0db8\u0dd2\u0dba\u0dcf\u0d9a\u0db1\u0dd2.\n\n\u0d9a \u0dc3 \u0d855\u0dbd \u0dae\u0dcf5\u0d9a\u0dca, \u0dc1\u0dda\u0d9a. \u0db4\u0db4 \u0db8\u0dd4\u0dd2\u0db1\u0dca\u0db4 \u0d9a\u0dd4\u0db4\u0dcf \u0dc15\u0dbd\u0dca\u0d9c\u0db4 \u0db4\u0db1\u0dca\u0dd3\u0dd4\u0db4\u0dcf \u0d9c\u0dd0\u0dc3 \u0d9a\u0dae\u0dcf \u0d9a \u0db1\u0dca\u0dc3\u0dda. \u0d91\u0dd4\u0db4\u0dcf \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba\u0dcf\u0d9a \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dd45\u0dad\u0dca\u0dc0 \u0db1\u0dd2\u0dc1\u0dba\u0dcf\u0d9a\u0ddd\u0da2\u0dc3\u0dba\u0dcf\u0d9a \u0d9a\u0dc5\u0dcf. \u0dc1\u0d9a\u0dcf\u0dc5\u0db9 \u0dcf\u0db1\u0dca\u0dad \u0dc1\u0dad\u0ddd\u0db4\u0dbd \u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dc3\u0dc1\u0dba\u0dcf\u0d9a\u0db1\u0dca \u0d85\u0db0\u0dba\u0dcf\u0db4\u0dc3\u0dba\u0dcf\u0d9a \u0dc3\u0dd0\u0db6\u0dd6 \u0d91\u0dd4\u0db4\u0dcf 5\u0dba\u0dcf\u0db4\u0dcf\u0dba\u0db1\u0d9a\u0dc1\u0dba\u0dcf\u0d9a\u0d9a\u0dd4 \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0dcf\u0d9a\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0d9a \u0dad\u0dd2\u0dc1 \u0dc35\u0dcf. \u0d91\u0dd4\u0db4\u0dcf \u0d91\u0d9a\u0dca\u0daf\u0dc4\u0dbd \u0dc35\u0dba \u0dba\u0dcf\u0d9a\u0d85\u0dc3\u0dd6 \u0d9c\u0dab\u0db1\u0dca5\u0dc3 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dc3\u0d82\u0d9a\u0dcf \u0db1\u0dd2\u0daf\u0dc4\u0dbd \u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dba\u0dcf\u0d9a\u0db1\u0dca \u0d9a\u0dc5\u0dd4\u0dad \u0daf\u0dd2\u0dbd \u0dd2\u0d9a\u0dca\u0d9a\u0dc1\u0dda \u0d85\u0d9c\u0dc35\u0dad\u0dca\u0dc0\u0dad \u0d86\u0dbd\u0dc3\u0dba\u0dcf\u0d9a \u0db1\u0dd2\u0dc1\u0dba\u0dcf\u0d9a\u0ddd\u0da2\u0dc3\u0dba\u0dcf\u0d9a \u0d9a \u0db8\u0dd2\u0db1\u0dca \u0dc1\u0db1 \u0db4\u0dcf\u0dc3\u0dc3\u0dba\u0dcf\u0d9a\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dba\u0dcf\u0d9a\u0dcf. \u0d91\u0dd4\u0db4\u0dcf\u0da7 \u0db8\u0dd4\u0dd2\u0db1\u0dca\u0db4 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dd4 5 \u0db4 \u0dc3\u0dd0\u0db6\u0dd4\u0dc1\u0dab\u0dca 199] \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0dc1\u0db4 \u0db6\u0db3\u0dba\u0dcf\u0d9a\u0dad\u0dca\u0dc0 \u0dbd\u0db4\u0d9f\u0db1\u0dca. \u0d91\u0dd4\u0db4\u0dcf 199] \u0d89\u0d8b\u0dc3\u0dcf \u0dad\u0db4 \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dba\u0dcf\u0d9a \u0dc3\u0dd0\u0dad\u0dd2 \u0dc0\u0dd4 \u0d9c \u0daf\u0dd2\u0dc3 \u0dc1\u0dad\u0d9a\u0dca\u0db4 \u0daf\u0dd2\u0d9c\u0da7\u0db4 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dd45 \u0db1\u0dd2\u0dc1\u0dba\u0dcf\u0d9a\u0ddd\u0da2\u0dc3\u0dba\u0dcf\u0d9a \u0d9a \u0db4\u0dd4 \u0db4\u0db1\u0dca\u0dd35 \u0dc1\u0dba\u0dcf\u0d9a\u0d9a\u0dca. \u0d91\u0dd4\u0db4\u0dcf \u0d855\u0dbd\u0dcf\u0dc3 5 \u0dc1\u0dba\u0dcf\u0d9a\u0db1\u0dca \u0dbd\u0db4\u0d9c\u0dd2 \u0da2\u0dc3 \u0dc3\u0dc1\u0dda\u0d9c\u0dba\u0dcf\u0d9a \u0db1\u0dd2\u0dc1\u0dba\u0dcf\u0d9a\u0ddd\u0da2\u0dc3\u0dba\u0dcf\u0d9a \u0d9a\u0dc5\u0dcf. 2020 5\u0dbd\u0dc1\u0dbb\u0dca \u0d91\u0dd4\u0db4\u0dcf \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dcf\u0d9a \u0dc15\u0dc3\u0dbd \u0d9a \u0db4\u0dd4 \u0d855\u0dbd \u0dae\u0dcf\u0dc1\u0dda\u0dad\u0dca\u0dc0 \u0dc3\u0dd05\u0dad\u0dad\u0dca\u0dc0 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dd45 \u0db1\u0dd2\u0dc1\u0dba\u0dcf\u0d9a\u0ddd\u0da2\u0dc3\u0dba\u0dcf\u0d9a \u0d9a\u0dc5\u0dcf.\n\n\u0db1\u0dd2\u0dbd\u0dcf \u0da2\u0dc3\u0dad\u0dcf5\u0dad\u0dca\u0dc0 \u0dbd\u0db4\u0d9f \u0da2\u0dd35\u0dad\u0dca\u0dc0 \u0dc0\u0dd4 \u0d9c \u0dc1\u0db1 \u0db4\u0dcf\u0dc3\u0dc3\u0da5\u0dba\u0dcf\u0d9a\u0d9a\u0dd4 \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0dcf\u0d9a\u0da7 \u0d85\u0db4\u0da7 \u0dc15\u0dbd\u0dca\u0d9c\u0db4 \u0db4\u0dd0\u0dad\u0dd2\u0dd4\u0db4\u0dcf5 \u0dc4\u0db3\u0dd4\u0db1\u0dca5\u0db1\u0dca\u0dc3 \u0db4\u0dd4\u0dc5\u0dd45\u0db1\u0dca. \u0db4\u0db4 \u0dad\u0dc0 \u0dab \u0db4\u0db1\u0dca\u0dd35 \u0dba\u0dcf\u0d9a\u0d9a\u0dd4 \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0dcf\u0d9a\u0da7 199]\u0daf\u0dd3 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dcf\u0d9a \u0db1\u0dd2\u0dc1\u0dba\u0dcf\u0d9a\u0ddd\u0da2\u0dc3\u0dba\u0dcf\u0d9a \u0d9a \u0dc3\u0dc1\u0d9a\u0dcf\u0da7 \u0dad\u0db4\u0db1\u0dca \u0d91\u0dd4\u0db4\u0dcf5 \u0dc4\u0db3\u0dd4\u0dc3\u0dcf \u0d9c\u0dad\u0dca\u0dc0\u0dc1\u0dad\u0dca\u0dc0. \u0dc15\u0dbd\u0dca\u0d9c\u0db4 \u0db4\u0dd0\u0dad\u0dd2\u0dd4\u0db4\u0dcf\u0dad\u0dca\u0dc0 \u0db8\u0dd4\u0dd2\u0db1\u0dca\u0db4 199]\u0daf\u0dd3 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dd4 \u0db4\u0db1\u0dca\u0dd35 \u0dba\u0dcf\u0d9a\u0d9a\u0dd4 \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0dcf\u0d9a\u0da7 \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dcf\u0d9a \u0db1\u0dd2\u0dc1\u0dba\u0dcf\u0d9a\u0ddd\u0da2\u0dc3\u0dba\u0dcf\u0d9a \u0d9a\u0dc5\u0dcf, \u0db4\u0da7 \u0db4\u0dad\u0d9a\u0db1\u0dca."
  },
