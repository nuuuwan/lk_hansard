    "chunk_text": "\u0dd2\u0daf\u0dc1 \u0d9a\u0dc2\u0dc1 \u0db1\u0dca\u0db8 \u0dc1\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0d85\u0dbb\u0dd4\u0dd4\u0dc0\u0dd4\u0dbd 50\u0da7 \u0d85\u0dca \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca \u0dbd\u0dc4\u0dd4\u0dad\u0dbb \u0d9a\u0dca \u0d86\u0db1 \u0db1\u0dd2\u0d9a \u0dcf\u0dc1\u0dca\u0da9\u0dbd \u0dd2\u0db6\u0db1\u0dca \u0dad\u0db8\u0dd2 \u0d94\u0dbb\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0dc3\u0dd4 \u0db4\u0dc4\u0dc3\u0dd4 \u0d9a\u0d82\u0dc1\u0db4 \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0db8\u0dc1\u0dab \u0d9a\u0dbb\u0dc1\u0d9c\u0db1 \u0dad\u0dd2\u0dc1\u0dbd\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0dc1 \u0db1\u0dca \u0d89\u0dc4\u0dc5 \u0dad\u0dad\u0dca\u0dad\u0dca \u0d9a \u0d89\u0db1\u0dca\u0db1 \u0d85 \u0dad\u0dca, \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0dc1 \u0db1\u0dca \u0db4\u0dc4\u0dc5 \u0dad\u0dad\u0dca\u0dad\u0dca \u0d9a \u0d89\u0db1\u0dca\u0db1 \u0d85 \u0dad\u0dca \u0db1 \u0dc1\u0dca \u0dc4\u0dd0\u0db8 \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dca\u0db8 \u0dad\u0db8\u0db1\u0dca\u0dc1\u0dda \u0da2\u0dd3\u0dd2\u0daf\u0dad\u0dc1\u0dda \u0dc3\u0dd4 \u0db4\u0dc4\u0dc3\u0dd4 \u0d9a\u0d82\u0dc1\u0db4 \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0db8\u0dc1\u0dab \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d86\u0db1 \u0db1\u0dd2\u0d9a \u0dcf\u0dc1\u0dca\u0da9\u0dbd \u0db8\u0dad \u0db4:\u0db1\u0dca \u0dc1 \u0db8\u0dd2\u0db1\u0dca. \u0d86\u0db1 \u0db1\u0dd2\u0d9a \u0dcf\u0dc1\u0dca\u0da9\u0dbd \u0d9a\u0dd2\u0dda \u0dc1\u0db8, \u0d86\u0db1 \u0db1\u0dd2\u0d9a \u0dcf\u0dc1\u0dca\u0da9\u0dbd \u0dbb\u0dca\u0dbd\u0d9c \u0d9a\u0dd2\u0dc4\u0dd2\u0db4 \u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0dbd\u0db1 \u0dc1. \u0d91\u0d9a\u0d9a\u0dca \u0dad\u0db8\u0dd2, \u0d85\u0db4\u0dd2 \u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u0db1 \u0db4\u0dbb\u0dd2\u0dc1\u0dcf\u0ddd\u0da2\u0db1 \u0dcf\u0dc1\u0dca\u0da9\u0dbd. \u0d85\u0dc1\u0db1\u0d9a\u0dca \u0d91\u0d9a \u0dad\u0db8\u0dd2, \u0d85\u0dad\u0dbb\u0db8\u0dd0\u0daf\u0dd2 \u0dcf\u0dc1\u0dca\u0da9\u0dbd. \u0d8a\u0dc5\u0db4 \u0d91\u0d9a \u0dad\u0db8\u0dd2, \u0d86\u0dc1 \u0ddd\u0da2\u0db1 \u0dcf\u0dc1\u0dca\u0da9\u0dbd. \u0db4\u0dbb\u0dd2\u0dc1\u0dcf\u0ddd\u0da2\u0db1 \u0dcf\u0dc1\u0dca\u0da9\u0dbd \u0d9a\u0dd2 \u0d82\u0dc1 \u0d9c\u0dad\u0dca\u0dad\u0dc1\u0db8, \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dcf\u0d9a\u0dc3\u0dd4 \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab \u0d9a\u0dbb\u0db1 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc0\u0db1 \u0db1\u0dca, \u0d86\u0dc4\u0dc1\u0dbb \u0db4\u0dc1\u0db1 \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc0\u0db1 \u0db1\u0dca, \u0dc1\u0dda\u0dad\u0dca\u0dc1\u0dc4\u0d9a\u0dad\u0dca \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc0\u0db1 \u0db1\u0dca. \u0dc1\u0dca \u0dc3\u0dd2 \u0dbd\u0dca\u0d82 \u0dc3\u0dcf \u0dc4\u0dc1 \u0d86\u0db1 \u0db1\u0dd2\u0d9a \u0dcf\u0dc1\u0dca\u0da9\u0dbd \u0db8\u0dad \u0dad\u0db8\u0dd2 \u0dbd\u0dc4\u0dd4\u0dad\u0dbb \u0d9a\u0dc1\u0dda \u0dc3\u0dd4 \u0db4\u0dc4\u0dc3\u0dd4 \u0d9a\u0d82\u0dc1\u0db4 \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0db8\u0dc1\u0dab \u0dc1 \u0db1\u0dca\u0dc1\u0db1\u0dca.\n\n1357 1358\n\n\u0db4\u0dc1\u0dbb\u0dca\u0dbd\u0dd2\u0db6\u0dc1\u0dca \u0db1\u0dca\u0dad\u0dd4\n\n\u0dc4\u0dbb\u0dc4\u0dc1 \u0d85:\u0dc1\u0dc5 quality \u0d91\u0d9a\u0da7 \u0da9\u0dbd\u0dc1 \u0db4\u0dc4\u0dd2\u0db6\u0db1\u0dca \u0dad\u0dd2\u0dc1\u0dbd\u0db1 \u0dcf\u0dc1\u0dca\u0da9\u0dbd \u0dc1\u0dda\u0db1\u0dca\u0db1 \u0dbd\u0dd0\u0dc4\u0dd0, \u0db1\u0dd2 \u0db8\u0dd2\u0dad quality \u0d91\u0d9a\u0da7 \u0dc1\u0dc4\u0ddd \u0d8a\u0da7 \u0da9\u0dbd\u0dc1 \u0d89\u0dc4\u0dd2\u0db6\u0db1\u0dca \u0dad\u0dd2\u0dc1\u0dbd\u0db1 \u0dcf\u0dc1\u0dca\u0da9\u0dbd \u0dd2\u0daf\u0dad\u0dbb\u0dd2 \u0dc1\u0dda\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc0\u0db1 \u0db1\u0dca \u0d9a\u0dd2 \u0db1 \u0dc3\u0dcf\u0d9a\u0d9a\u0dbd\u0dca\u0db4\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1 \u0dd2\u0db6 \u0d94\u0dc3\u0dcf\u0d9a\u0dc1\u0dc3\u0dcf\u0d9a \u0dad\u0db8\u0dd2 \u0d86\u0db1 \u0db1\u0dd2\u0d9a \u0dcf\u0dc1\u0dca\u0da9\u0dbd \u0dc3\u0dd3\u0db8\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0dc3\u0dd2\u0dd4\u0dbd \u0dc1 \u0db1 \u0dc1 \u0db1\u0dca \u0dc3\u0dd2\u0dd4\u0dbd \u0dc1 \u0db1\u0dca\u0dc1\u0db1\u0dca.\n\n\u0dc1\u0dca \u0dc1\u0db8\u0dc1\u0dc1\u0dc4\u0dc1\u0dc1\u0dad\u0dca \u0d85\u0dc1\u0dda \u0dbb\u0da7 \u0dd4 \u0dc4\u0dd4\u0dab\u0db4\u0dc1\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dc1\u0db1 \u0d85\u0dbb\u0dca\u0dbd\u0dd4\u0dab: \u0dad\u0db8\u0dd2, \u0daf\u0dd2\u0d9c\u0dd2\u0db1\u0dca \u0daf\u0dd2\u0d9c\u0da7\u0db8 \u0d86\u0db1 \u0db1\u0dd2\u0d9a \u0dcf\u0dc1\u0dca\u0da9\u0dbd \u0d82\u0da7 \u0db4\u0db1 \u0db1 \u0dbd\u0dd4\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dab . \u0d92\u0dc1\u0d9a\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db5\u0d82 \u0d9a\u0dca \u0dc1\u0d82\u0dc3\u0dcf \u0d85\u0db4\u0db1 \u0db1 \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0dad\u0dca \u0d9a\u0da9\u0dbd\u0dc1 \u0dd0\u0dc1\u0da7\u0db1 \u0dc1. \u0d87\u0dd2, \u0db8\u0db8 \u0d91\u0dc1\u0dc4\u0db8 \u0d9a\u0dd2 \u0db1\u0dca\u0dc1\u0db1\u0dca? \u0d85\u0dc1\u0dda \u0dc1\u0dc1\u0dda \u0dbb\u0da7 \u0d82 \u0d85\u0db4\u0db1 \u0db1 \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0db8\u0dc1\u0dab \u0dc1 \u0d82\u0dc1 \u0dad\u0dd2\u0dc1\u0dbd\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0d86\u0db1 \u0db1\u0dd2\u0d9a \u0dc1 :\u0dbb\u0dd4\u0dca \u0db8\u0dad. \u0dc1\u0d9c\u0ddd\u0db0\u0dc1\u0dcf \u0dbb\u0dc1\u0da2\u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda \u0d86\u0dca\u0dca \u0d9a\u0dc1\u0d82\u0dc1\u0dda \u0d85\u0db4\u0dd2 :\u0dd0\u0d9a\u0dca\u0d9a\u0dc1, \u0dc1\u0db4\u0dc1\u0dc1\u0dc4\u0dc1\u0dbb \u0da7\u0dd2\u0d9a \u0d85\u0dca \u0dc1 \u0da0\u0dca\u0da0 \u0d9c\u0db8\u0db1\u0dca, \u0dc1\u0db4\u0dc1\u0dc1\u0dc4\u0dc1\u0dbb \u0da7\u0dd2\u0d9a \u0db1 \u0dad\u0dca \u0db4\u0dd4 \u0d9c\u0db8\u0db1\u0dca \u0dc1\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0d9a\u0dd8\u0dd2 \u0d9a\u0dbb\u0dca\u0dbd\u0db8\u0dc1\u0db1\u0dca\u0dad \u0d9a\u0da9\u0dbd\u0dc1 \u0dd0\u0da7\u0dd4\u0dab\u0dd4 \u0dd2\u0daf\u0db0\u0dd2 . \u0d92 \u0dc1\u0dc1\u0dda\u0db8, \u0d86\u0db1 \u0db1\u0dd2\u0d9a \u0dcf\u0dc1\u0dca\u0da9\u0dbd \u0d82\u0da7 \u0dc3\u0dd3\u0db8\u0dc1 :\u0dc1\u0db4\u0dd4 \u0d9c\u0db8\u0db1\u0dca \u0d85\u0dc1\u0dda \u0dad\u0dd2\u0dc1\u0dbd\u0db1 \u0d87\u0db4\u0dbd\u0dd4\u0dca \u0d9a\u0dbb\u0dca\u0dbd\u0db8\u0dc1\u0db1\u0dca\u0dad \u0da7\u0dd2\u0d9a \u0dd2\u0daf\u0db1\u0dc1 \u0dc1 \u0db1 \u0dc1. \u0d92 \u0dbd\u0dc4\u0dd4\u0dad\u0dbb \u0d9a\u0dca \u0d87\u0db4\u0dbd\u0dd4\u0dca \u0d9a\u0dbb\u0dca\u0dbd\u0db8\u0dc1\u0db1\u0dca\u0dad \u0d82\u0da7 \u0d85 \u0dba \u0dc3\u0dd2 \u0dbd\u0dd4 \u0dcf\u0dc1\u0dca\u0da9\u0dbd \u0dc1\u0dda\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1 \u0db1\u0dad\u0dca \u0dbb\u0da7 \u0dd2\u0db6\u0db1\u0dca. \u0d92 \u0dc1\u0da7 \u0dc3\u0dd3\u0db8\u0dc1 :\u0dc1\u0db4\u0dd4 \u0d9c\u0db8\u0db1\u0dca \u0dc3\u0dd2\u0daf\u0dca\u0db0\u0db0 \u0dc1 \u0db1\u0dca\u0dc1\u0db1\u0dca, \u0d85\u0dc1\u0dda \u0d85\u0db4\u0db1 \u0db1 \u0dcf\u0dc1\u0dca\u0da9\u0dbd \u0d82 \u0db8\u0dd2\u0d82 \u0d89\u0dc4\u0dc5 \u0db1 \u0dc1. \u0d85\u0db4\u0db1 \u0db1 \u0dcf\u0dc1\u0dca\u0da9\u0dbd \u0d82 \u0db8\u0dd2\u0d82 \u0d89\u0dc4\u0dc5 \u0d9c\u0dd2 \u0d9c\u0db8\u0db1\u0dca, \u0dc1\u0d82\u0ddd\u0d9a \u0dc1 \u0dc1\u0dc5 \u0dc1\u0db4\u0dc1\u0dc5 \u0dad\u0dd4\u0dc5 \u0d85\u0db4\u0da7 \u0dad\u0dbb\u0d9c \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dbd\u0dd0\u0dbb\u0dd2 \u0dc1 \u0db1 \u0dc1. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf\u0dc1 \u0d86\u0db1 \u0db1\u0dd2\u0d9a \u0dcf\u0dc1\u0dca\u0da9\u0dbd \u0dc3\u0dd3\u0db8\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc4\u0dbb\u0dc4\u0dc1 \u0d9a\u0dd2\u0dc3\u0dd2 \u0dd2\u0daf\u0dc1\u0da7\u0d9a\u0dad\u0dca \u0d85\u0db4\u0db1 \u0db1 \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0d9a\u0dca \u0dc1\u0d9c\u0dc1\u0da9\u0dbd\u0db1\u0db4\u0db1\u0dca\u0db1 \u0dbd\u0dd0\u0dc4\u0dd0."
