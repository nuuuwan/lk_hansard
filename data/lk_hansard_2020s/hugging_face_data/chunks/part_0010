    "chunk_text": "\u0d9c\u0dd4\u0dc0 \u0db1\u0dd2\u0dc1 \u0ddd\u0da7\u0dba \u0dae\u0dcf\u0daf\u0d9a\u0daf \u0d9a\u0dd4\u0da7\u0db1\u0dd2, \u0d91\u0dc1\u0dc3\u0dcf\u0dda \u0d9a\u0db8\u0dd4\u0dad\u0dca \u0da7\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dc0\u0dbb\u0da7\u0da7 \u0da7\u0d9a\u0dca \u0d91\u0dae\u0dad\u0dd4\u0dc0 \u0dae\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dba\u0dd2 \u0dc1\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dda\u0d9a \u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc0\u0da7\u0dc4\u0daf \u0d9c\u0dca\u0d9a \u0db4\u0dd4\u0dd4 \u0dc0\u0dca \u0d92\u0dae\u0da7 \u0dc1\u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dc0 \u0dad\u0da7\u0dba\u0dd2, \u0da7\u0d9a\u0dae\u0dba\u0daf \u0dc1\u0d9a\u0dca\u0dca\u0dbb, \u0da7\u0d9a\u0dae\u0dba\u0daf \u0db4:\u0d9a\u0db1 \u0dc0\u0daf\u0dc1 \u0da7 \u0dc3\u0dcf\u0d82\u0dc3\u0dcf\u0dda\u0dae\u0dd8\u0db1 \u0dae \u0da7\u0db0\u0dba\u0dc3\u0dcf\u0dda\u0dcf\u0daf\u0d9a \u0dd2\u0dbb \u0d9a \u0dc0\u0dca\u0d9c \u0dad\u0dd4\u0dc0\u0d9a\u0da7 \u0dc3\u0dcf\u0d82\u0dc3\u0dcf\u0dda\u0dae\u0dd8\u0db1 \u0dae \u0dae\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0 \u0d85\u0da7\u0daf\u0dad\u0dba\u0daf\u0d82 \u0dc1 \u0dca \u0db4\u0daf\u0dba\u0d9a \u0dc0\u0d9a\u0dc0\u0daf \u0dd2\u0dbb \u0dba\u0daf\u0dba\u0dd2 \u0db4\u0dd4\u0dbb\u0dc0\u0dd3 \u0db4 \u0db4\u0dca\u200d\u0dbb\u0da7\u0daf\u0dc0, \u0da7\u0d9a\u0dad\u0daf\u0dc0 \u0db1\u0dd2\u0dad\u0dbb \u0dc1:\u0dc1 \u0dc1\u0dbd\u0dca :\u0dd2\u0dbb\u0dca\u0dc1\u0dca \u0dc1\u0db1 \u0dd2\u0dbb \u0d9a \u0d86 \u0dad\u0d9a \u0dad\u0dd4\u0dc0\u0d9a\u0da7 \u0d85\u0db4\u0da7 \u0dc1\u0db4\u0dc1\u0d9a\u0dca\u0dc1\u0dca \u0d91\u0dae\u0da7 \u0dc3\u0dcf\u0da7\u0dc4\u0dbb \u0d86 \u0dad\u0d9a \u0db4\u0dc5\u0daf\u0dad\u0dca \u0dc3\u0dcf\u0db7\u0daf\u0dc0\u0dbd\u0dd2\u0db8\u0dca \u0db4\u0daf\u0dba\u0d9a \u0dc0\u0dd4\u0db1\u0dad\u0dca \u0dc3\u0dcf\u0da7\u0dc4\u0dbb \u0d86 \u0dad\u0d9a \u0db4\u0daf\u0dba\u0d9a \u0dc0\u0dca\u0dc1\u0dca \u0dc3\u0dcf\u0d82\u0dc3\u0dcf\u0dda\u0dae\u0dd8\u0db1 \u0dae \u0dae\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0 \u0d85\u0da7\u0daf\u0dad\u0dba\u0daf\u0d82 \u0dc1 \u0dca, \u0d9c\u0dd4\u0dc0 \u0da7\u0dca\u0dd3\u0dad\u0dd4\u0dc0\u0da7\u0db1\u0dd2 \u0da7\u0da7 :\u0dd3\u0d9a\u0da7\u0da7\u0dad\u0dca \u0dc1\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dda\u0d9a \u0db1 \u0daf\u0dd4\u0dbb\u0dae\u0da7 \u0d85\u0db0\u0dba \u0d9a \u0dae\u0dbb\u0dba\u0daf \u0db1 \u0dc1\u0db6\u0d9a\u0dc0\u0daf\n\n\u0d92 \u0dc0\u0daf\u0dc1 \u0da7 \u0db1\u0dd2\u0dd3\u0db8\u0d9a\u0dca\u0dc2\u0db1 \u0da0\u0daf\u0dbb\u0dd2\u0dae\u0daf\u0dc0\u0dba \u0dc1 \u0daf\u0dd4\u0db1\u0daf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dc1 \u0daf\u0dd3 \u0d85\u0dc0 \u0dba \u0dc1\u0dad\u0daf\u0dbb\u0dad\u0dd4\u0dc0\u0dd4\u0dc0 \u0dc3\u0dcf\u0db4 \u0dca\u0d9a, \u0dc1\u0dc0\u0d9a\u0dc3\u0dcf\u0dda\u0dae\u0db1 \u0dae\u0dbb\u0dca\u0d9a, \u0dc3\u0d9a\u0dc4\u0dd2\u0da7 \u0db1 \u0dc1\u0db6\u0d9a \u0dc3\u0dcf\u0d82\u0dc0\u0dca\u0db0\u0d9a \u0dae\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0da7 \u0d85\u0dbb\u0d9c\u0dca\u0d9a \u0d85\u0db4\u0dd2 \u0db6\u0dba\u0daf\u0dc1\u0db4\u0daf\u0dc1\u0dbb\u0daf\u0dad\u0dca\u0dad\u0dd4\u0dc0 \u0dc1\u0dc0\u0d9a\u0dc0\u0daf\n\n\u0db6\u0dba\u0daf\u0dc1\u0db4\u0daf\u0dc1\u0dbb\u0daf\u0dad\u0dca\u0dad\u0dd4\u0dc0 \u0dc1\u0dc0\u0d9a\u0dc0\u0daf, \u0d92 \u0dae\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0 \u0d91\u0dda \u0dad\u0dd3\u0dca\u0dc0\u0dba \u0dc1\u0dae\u0dc1\u0dbb\u0d9a\u0dc0\u0daf: \u0dd2\u0dbb \u0dba\u0daf \u0d85\u0da7\u0daf\u0dad\u0dba\u0daf\u0d82 \u0db4\u0dd3\u0dad\u0dca\u0dc1\u0dad\u0dca \u0db1 \u0d85\u0dbb\u0d9a\u0dca\u0dc2\u0db1 \u0d9a\u0dca \u0dc1\u0dae\u0dc1\u0dbb\u0d9a\u0dc0\u0daf: \u0dd2\u0dbb \u0d9a \u0d91\u0dae :\u0dd3\u0d9a\u0d9c\u0dca\u0d9a\n\n\u0d9c\u0dd4\u0dc0 \u0dc3\u0da7\u0db1 \u0dad\u0dd4\u0dc0\u0da7\u0db1\u0dd2, \u0da7\u0dc1 \u0db4\u0dc5\u0db8\u0dd4\u0dc1\u0dc0\u0db1\u0dd2 \u0d85\u0dad\u0dd4\u0dc0\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb \u0dda\u0d9a \u0dc1\u0da7 \u0dba\u0dd2 \u0dc3\u0dcf\u0d82\u0dc3\u0dcf\u0dda\u0dae\u0dd8\u0db1 \u0dae \u0da7\u0db0\u0dba\u0dc3\u0dcf\u0dda\u0dcf\u0daf\u0d9a \u0dc1\u0dae\u0daf\u0db4\u0da7\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da7\u0daf\u0db1 \u0d9a\u0dca \u0dba\u0d82\u0dae\u0daf\u0dc0 \u0dad\u0dd4\u0dc0\u0dc5 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0daf\u0dad\u0dca\u0da7\u0dae \u0dc1\u0dc0\u0d9a\u0dc0\u0daf:, \u0d92 \u0dc3\u0dcf\u0d82\u0dc3\u0dcf\u0dda\u0dae\u0dd8\u0db1 \u0dae \u0da7\u0db0\u0dba\u0dc3\u0dcf\u0dda\u0dcf\u0daf\u0d9a\u0dc0\u0dbd\u0dd2\u0db8\u0dca \u0d85\u0dbb\u0db8\u0dd4\u0dd4\u0db8\u0dc3\u0dcf\u0dc4\u0d9c\u0dad \u0dae\u0daf\u0dca \u0db7\u0daf\u0dbb \u0dc1\u0db1 \u0dc1\u0da7\u0daf\u0dc1\u0dc4\u0daf\u0dc1\u0dad\u0dca \u0d89\u0db4\u0dca \u0dc1\u0dc0\u0db8\u0dd2\u0dca \u0db1 \u0dc1\u0db6\u0d9a\u0dc0\u0daf:?"
  },
