    "chunk_text": "\u0dc1\u0dc4\u0ddc\u0db3 \u0dda\u0dba\u0dcf\u0dc4\u0dbb\u0dba\u0dba\u0d9a\u0dca \u0daf\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dc1\u0dda \u0dbb\u0da7\u0d9a\u0dd2\u0db1\u0dca \u0dbd\u0db6\u0dcf \u0dc1\u0dba\u0db1\u0dca\u0db1 \u0db8\u0dc0\u0db8\u0dc0 \u0d9a\u0dd0\u0db8\u0dc0\u0dd0\u0dad\u0dd2\u0dba\u0dd2. 0225 \u0dc0\u0dc3\u0dc1\u0dca\u0dc2\u0daf\u0dd3 \u0dc1\u0d9a\u0ddc\u0dc1\u0dbd\u0ddc\u0db8\u0dca\u0dd2\u0dbd\u0dba\u0dcf\u0dc0 \u0d9a\u0dd2\u0dba\u0db1 \u0dbb\u0da7\u0da7 \u0dad\u0db8\u0dc0\u0db1\u0dca\u0dc1 \u0dc1\u0d9a\u0ddd\u0db4\u0dd2 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0dbd\u0ddc\u0d9a\u0dd4 \u0dca\u200d\u0dbb \u0dca\u0db1\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dba\u0dcf. \u0d92 \u0dad\u0db8\u0dc0\u0dba\u0dd2 \u0dc1\u0d9a\u0ddd\u0db4\u0dd2 \u0d9a\u0dd2\u0dba\u0db1 \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dba \u0dad\u0db8\u0dc0\u0db1\u0dca\u0dc1 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2 \u0d85\u0db4\u0db1\u0dba\u0db1 \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dba\u0d9a\u0dca \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dba\u0dcf\u0da7 \u0dc1\u0dbd\u0ddd\u0d9a \u0dc1\u0dc0\u0dc1\u0dc5\u0db3 \u0dc1\u0db4\u0ddc\u0dc1\u0dc5\u0dda \u0db1\u0dd2\u0dad\u0dbb \u0db1\u0dd2\u0dad\u0dbb \u0dc1\u0d9a\u0ddd\u0db4\u0dd2 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0db8\u0dd2\u0dbd \u0dda\u0da0\u0dca\u0da0\u0dcf\u0dc0\u0da0\u0db1\u0dba \u0dc0\u0dd3\u0db8\u0dc0. \u0d91\u0dad\u0dc1\u0d9a\u0ddc\u0da7 \u0dc1\u0d9a\u0ddc\u0dc1\u0dbd\u0ddc\u0db8\u0dca\u0dd2\u0dbd\u0dba\u0dcf\u0dc0\u0da7 \u0dc1\u0dbd\u0ddc\u0d9a\u0dd4 \u0dca\u200d\u0dbb \u0dca\u0db1\u0dba\u0d9a\u0dca \u0d86\u0dc0\u0dcf \u0dc1\u0d9a\u0ddd\u0db4\u0dd2 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dca\u0dcf\u0dcf\u0dc0\u0dbb \u0db8\u0dd2\u0dbd\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0d9a\u0ddc\u0dc1\u0dc4\u0ddc\u0db8\u0dc0\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca. 0225 \u0dc0\u0dc3\u0dc1\u0dca\u0dc2\u0daf\u0dd3 \u0d92\u0dc1\u0d9c\u0ddc\u0dca\u0daf\u0dbd\u0db1\u0dca \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dda\u0db4\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dba\u0d9a\u0dca \u0dc1\u0dba\u0ddc\u0dba\u0db1\u0dc0\u0dcf. \u0dc1\u0d9a\u0ddc\u0dc1\u0dbd\u0ddc\u0db8\u0dca\u0dd2\u0dbd\u0dba\u0dcf\u0dc1\u0daf \u0dc3\u0dcf\u0db8\u0dca\u0dca\u200d\u0dbb\u0dba\u0dcf\u0dba\u0dd2\u0d9a \u0dc0\u0dd3\u0dbb\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dd4 \u0daf\u0db3\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0da2\u0dd4\u0dc0\u0dcf\u0db1\u0dca \u0dc1\u0dc0\u0ddd\u0dca\u0daf\u0da7\u0dca\u0dc2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d92 \u0da2\u0dd4\u0dc0\u0dcf\u0db1\u0dca \u0dc1\u0dc0\u0ddd\u0dca\u0daf\u0da7\u0dca\u0dc2\u0dc1 \u0db1\u0dcf\u0db8\u0dc0\u0dba \u0dbb\u0dd6\u0db4\u0dba \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dbb\u0dbd\u0dcf 0225\u0daf\u0dd3 \u0dc1\u0db8\u0dca \u0dc1\u0d9c\u0ddc\u0dca\u0daf\u0dbd\u0db1\u0dca \"\u0d9a\u0dd0\u0dc1\u0dc6\u0dda \u0da9\u0dd3 \u0dc1\u0d9a\u0ddc\u0dc1\u0dbd\u0ddc\u0db8\u0dca\u0dd2\u0dbd\u0dba\u0dcf\" \u0db1\u0db8\u0dd2\u0db1\u0dca \u0db7\u0dd6\u0dc1\u0d9c\u0ddd\u0dbd\u0dd3\u0dba \u0dba\u0dca\u0dc2 \u0d9a\u0dba \u0dba\u0da7\u0dc1\u0dad\u0dca \u0dc1\u0db8\u0dc0\u0dba \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0dd2\u0dbb\u0d82\u0da0\u0dd2 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. 0225\u0daf\u0dd3 \u0d9a\u0dd0\u0dc1\u0dc6\u0dda \u0da9\u0dd3 \u0dc1\u0d9a\u0ddc\u0dc1\u0dbd\u0ddc\u0db8\u0dca\u0dd2\u0dbd\u0dba\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0db1\u0db8\u0dc0 \u0dba\u0da7\u0dc1\u0dad\u0dca \u0dc1\u0db8\u0dca\u0d9a \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0dd2\u0dbb\u0d82\u0da0\u0dd2 - register - \u0d9a\u0dc5\u0dcf\u0da7 \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dda \u0d85\u0dd4\u0db1\u0dbb\u0dd4\u0daf\u0dd4 02\u0d9a\u0dca \u0dc0\u0dcf\u0dc1 \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0d9a\u0dd0\u0dc1\u0dc6\u0dda \u0da9\u0dd3 \u0dc1\u0d9a\u0ddc\u0dc1\u0dbd\u0ddc\u0db8\u0dca\u0dd2\u0dbd\u0dba\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0dc1\u0d9a\u0ddd\u0db4\u0dd2 \u0dc0\u0dca\u0dc2\u0d9c\u0dba \u0dc1\u0dbd\u0ddd\u0d9a\u0dc1\u0dda \u0d85\u0d82\u0d9a \u0d91 \u0dc1\u0d9a\u0dca \u0dc3\u0db1\u0dca\u0db1\u0dcf\u0db8\u0dc0 \u0d85\u0dad\u0dbb\u0da7 \u0d87\u0dc0\u0dd2\u0dca\u0daf\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d92\u0dc1\u0d9a\u0db1\u0dca \u0dbd\u0db6\u0db1 \u0d86\u0dba\u0dcf\u0dba\u0db8\u0dc0 \u0dc0\u0dd2 \u0dcf\u0dbd \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0daf\u0dc4\u0dc5 \u0dc4\u0dd2\u0dc4\u0dd2\u0dca\u0daf\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf.\n\n\u0db7\u0dd6\u0dc1\u0d9c\u0ddd\u0dbd\u0dd3\u0dba \u0dc3\u0db1\u0dca\u0db1\u0dcf\u0db8\u0dc0 \u0d9c\u0dd0\u0db1 \u0db8\u0dc0\u0db8\u0dc0 \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0db4\u0dd0\u0dc4\u0dd0\u0dd2\u0dbb\u0dbd\u0dd2 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0db6\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0db7\u0dd6\u0dc1\u0d9c\u0ddd\u0dbd\u0dd3\u0dba \u0dc3\u0db1\u0dca\u0db1\u0dcf\u0db8\u0dc0 \u0dba\u0da7\u0dc1\u0dad\u0dca \u0d85\u0db4\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0dbd\u0d82\u0d9a\u0dcf\u0dc1\u0daf \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0dca\u200d\u0dbb\u0dc1 \u0dc0\u0dbd\u0da7 \u0d86\u0dc1\u0daf\u0dd2\u0da2\u0d9a \u0db7\u0dcf\u0dab\u0dca\u0da9 \u0dbb\u0dd0\u0dc3\u0d9a\u0dca \u0dc1\u0db8\u0dca \u0dba\u0da7\u0dad\u0da7 \u0d9c\u0db1\u0dca\u0db1. \u0dda\u0dba\u0dcf\u0dc4\u0dbb\u0dba\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0db4\u0dd2 \u0dc1\u0db6\u0ddc\u0dc1\u0dc4\u0ddc\u0db8\u0dc0 \u0d85\u0db8\u0dc0\u0dcf\u0dbb\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dbd\u0d82\u0d9a\u0dcf\u0dc1\u0daf \u0d9a\u0dd4\u0dbb\u0dd4\u0db3\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0d92 \u0dc3\u0dc4\u0dad\u0dd2\u0d9a\u0dba \u0dbd\u0db6\u0dcf \u0d9c\u0dad\u0dca\u0dad\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1 \u0db8\u0dc0 \u0dba\u0d9a\u0dd4\u0dc1\u0dab\u0dca \u0dd3\u0da7 \u0d9a\u0dd2\u0dbb\u0dd2 \u0d9a\u0db1\u0dca\u0dad\u0dc1\u0dca\u0daf \u0dd3\u0da7 \u0d9a\u0dd2\u0dbb\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dba\u0dd0\u0db1\u0dca \u0dc1\u0db4\u0ddc\u0da9\u0dd2 \u0dc1\u0dc0\u0dbd\u0dcf\u0dc0\u0d9a\u0da7 \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0d85\u0dc1\u0db4\u0dca \u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dd4 \u0d9a\u0dd2\u0daf\u0dc0\u0dcf \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca \u0dd3\u0da7 \u0d9a\u0dd2\u0dbb\u0dd2 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca. \u0d92 \u0dc0\u0dcf\u0dc1 \u0db8\u0dc0 \u0db1\u0dd2\u0dca\u0daf \u0db8\u0dc0\u0dd0\u0dd2\u0da2\u0d9a\u0dca. \u0db8\u0dc0\u0db8\u0dc0 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dbd \u0d9c\u0dbd \u0d86\u0dc3\u0db1\u0dba. \u0dbd \u0d9c\u0dbd \u0d86\u0dc3\u0db1\u0dc1\u0dda \u0dad\u0db8\u0dc0\u0dba\u0dd2 \u0d9a\u0dcf\u0db6\u0db1\u0dca \u0d85\u0d9c\u0dba \u0dc0\u0dd0\u0da9\u0dd2\u0db8\u0dc0 \u0d91\u0dc1\u0dc4\u0db8\u0dc0 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0dc0\u0dd0\u0da9\u0dd2\u0db8\u0dc0 \u0dc0\u0da7\u0dd2\u0db1\u0dcf\u0d9a\u0db8\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db8\u0dc0\u0dd0\u0dd2\u0da2\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dbd \u0d9c\u0dbd \u0d86\u0dc3\u0db1\u0dc1\u0dda \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d85\u0dc1\u0db4\u0dca \u0dbd \u0d9c\u0dbd \u0db8\u0dc0\u0dd0\u0dd2\u0da2\u0d9a\u0dca \u0d92 \u0dc0\u0dcf\u0dc1 \u0db1\u0dcf\u0db8\u0dc0\u0dba\u0d9a\u0dca \u0dba\u0da7\u0dc1\u0dad\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0dd2\u0dbb\u0d82\u0da0\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0daf\u0dd4\u0db8\u0dca\u0db6\u0dbb \u0db4\u0dd0\u0daf\u0dd4\u0dbb\u0dd4\n\n1519 1520\n\n\u0db4\u0dcf\u0dca\u0dc2\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0"
  },
