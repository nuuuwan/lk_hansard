0\u0dbb\u0dca\u0dba\u0dcf\u0dc0 \u0dc3\u0dc4\u0dd2\u0dad \u0d85\u0dc0\u0dc3\u0dca\u0dcf\u0dcf\u0dc0\u0db1\u0dca\u0dc4\u0dd2\u0daf\u0dd3 \u0da2\u0dca\u200d\u0dcf\u0dd2\u0d9a \u0dc1\u0d9c\u0ddc\u0da7\u0db1\u0dd0\u0d9f\u0dd2\u0dbd\u0dd2 \u0db4\u0dbb\u0dca\u0dc1\u0dda \u0dba\u0dab \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba \u0dc0\u0dd2\u0dd2\u0db1\u0db1\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0dbb\u0db1 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0dda \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0db0\u0dd2 \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0dda \u0dc3\u0dca\u0dcf\u0dcf\u0db1\u0dba\u0db1\u0dca\u0dc4\u0dd2 \u0db4\u0daf\u0dd2\u0d82 \u0d9a\u0dc0 \u0dd2\u0db1\u0da7\u0dd2\u0db1 \u0db4\u0dd4 \u0d9c\u0dbd\u0dba\u0dd2\u0db1\u0dca \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dc4\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dc1 \u0dc1\u0dd3\u0dba \u0dc1\u0dbd\u0dca \u0dda\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dba\u0dab\u0dba \u0dba\u0da7\u0dc1\u0dad\u0dca \u0d89\u0dc0\u0dad\u0dca \u0dbb \u0dc3\u0dd4\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0dc3\u0dca\u0dcf\u0dcf\u0db1 \u0dc1\u0dc0\u0dad \u0dc1\u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dc0 \u0dba \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0\u0dd3 \u0dbb\u0dab\u0dba \u0daf \u0dd2\u0db1\u0dd4\u0dc0 \u0dbb\u0dba\u0dd2.\n\n\u0d91\u0dc1\u0dc3\u0dda\u0db8 \u0db1\u0dd0\u0dc0\u0dad \u0db4\u0daf\u0dd2\u0d82 \u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dda \u0dc0\u0dd0\u0da7\u0dc3\u0da7\u0dc4\u0db1\u0da7 \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0dc0\u0dd3\u0db8\u0da7 \u0d85 \u0dd0\u0db8\u0dd0\u0dd2\u0d9a \u0dc4\u0dcf \u0dc1\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0da7\u0dad\u0dca \u0d85\u0db0\u0dd2 \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0dda \u0db1\u0dd2\u0dc1\u0dc0\u0dc3\u0dca\u0dc0\u0dbd \u0dbb\u0dd0\u0db3\u0dd3 \u0dd2\u0db1\u0da7\u0dd2\u0db1 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dca \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0d9c\u0dad \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0db4\u0dcf\u0daf\u0db1 \u0dc0\u0dba\u0dc3\u0db1 \u0dc5\u0db8\u0db1\u0dcf \u0dbb\u0dab \u0db4\u0db1\u0dad\u0da7 \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0dbb \u0d87\u0dd2\u0d9a \u0d85\u0dad\u0dbb \u0d91\u0db8 \u0db4\u0db1\u0dad \u0dc3\u0d82\u0dc1 \u0ddd\u0db0\u0db1\u0dba\u0da7 \u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dbb \u0d87\u0dad.\n\n(\u0d86) \u0db4\u0dd0\u0db1 \u0dc1\u0db1\u0ddc\u0db1\u0d9f\u0dd3.\n\n(\u0b85) (i) \u0b87\u0ba4\u0bc1 \u0b87\u0bae\u0ba3\u0baa\u0bcd\u0baa\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.\n\n\u0b87\u0bae\u0ba3\u0baa\u0bcd\u0baa\u0bc1 \u0b95\u0bc0\u0bb0\u0bb4 \u0ba4\u0bb0\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1:\n\n(ii) \u0b87\u0ba4\u0bc1 \u0b87\u0bae\u0ba3\u0baa\u0bcd\u0baa\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.\n\n\u0bc8\u0bc6\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd\n\n\u0ba8\u0bbf\u0bb2\u0b9a\u0bcd\u0b9a\u0bc6\u0bbe\u0bbf\u0bb5\u0bc1\n\n\u0b86\u0baa\u0ba4\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\n\n\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bb3\u0bcd\n\n(\u0baa\u0bbf\u0bb0\u0bb0\u0ba4\u0b9a\n\n\u0ba4\u0b9a\u0baf\u0bb2\u0b95\u0baa\u0bcd\n\n\u0baa\u0bbf\u0bc6\u0bbe\u0bbf\u0bb5\u0bc1)\n\n\u0b85\u0bae\u0b9f\u0baf\u0bc6\u0bbe\u0bb3\u0bae\u0bcd\n\n\u0b95\u0bc6\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\n\n\u0bb5\u0bc0\u0b9f\u0bc1\u0b95\u0bb3\u0bcd \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd\n\n\u0b85\u0bae\u0b9a\u0bb5\u0bbf\u0bb2\u0bcd\u0bb2\u0bc6\u0bbe\u0b9a\u0bcd\n\n\u0ba4\u0b9a\u0bc6\u0bbe\u0ba4\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\n\n\u0b87\u0b9f\u0b99\u0bcd\u0b95\u0bb3\