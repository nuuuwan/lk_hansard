    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7 \u0db8\u0db8 \u0dd9\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dd2., \u0dc3\u0dd2\u0dbb\u0dd2\u0db1\u0dcf\u0dbd\u0dca \u0daf \u0dc1\u0db8\u0dbd\u0dca \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0d9c\u0dd0\u0db1 \u0dd9\u0dcf\u0dcf \u0dd9\u0dba\u0db1\u0dca\u0db1. \u0db8\u0dad\u0dd4\u0db8\u0dcf \u0db8\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0dd9 \u0db4\u0d9a\u0dca\u0dc2\u0dba 1977\u0daf\u0dd3 \u0dbd\u0db6\u0db4\u0dd4 \u0db8\u0dc4 \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dba\u0da7 \u0da2\u0dba\u0dca\u200d\u0dc4\u0da7\u0dc1\u0dda \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0daf\u0dd0\u0dc0\u0dd0\u0db1\u0dca\u0dad \u0db1\u0dcf\u0dba\u0dd9\u0dc1\u0dba\u0d9a\u0dca. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8, \u0db8\u0dad\u0dd4\u0db8\u0dcf \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd3\u0dba \u0dc3\u0db8\u0dd2\u0dad\u0dd2 \u0d9a\u0dca\u0dc1\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb\u0dba\u0da7 \u0d85\u0dad\u0dd2\u0dc0\u0dd2 \u0dcf\u0dbd \u0dc0\u0dd0\u0da9\u0dc1\u0dd9\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0dd9\u0dba\u0db4\u0dd4 \u0dc1\u0dd9\u0dc1\u0db1\u0d9a\u0dca. 1977 \u0db8\u0dc4 \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dba\u0da7\u0dba\u0da7 \u0db8\u0dd9\u0dad\u0dd4 \u0dc0\u0dd4\u0dab\u0dd4 \u0da2\u0dcf\u0dad\u0dd2\u0dd9 \u0dc1\u0dc3\u0dda\u0dc0\u0dd9 \u0dc3\u0dcf\u0d9c\u0db8\u0dba \u0dc3\u0dcf\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba \u0dd9\u0dba\u0dbd\u0dcf, \u0db8\u0dc4\u0dd2 \u0dc0\u0dd2 \u0dcf\u0dbd \u0dc0\u0dd0\u0da9\u0dc1\u0dd9\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0dd9\u0dba\u0dbd\u0dcf, \u0d92\u0dd9\u0da7 \u0db1\u0dcf\u0dba\u0dd9\u0dad\u0dca\u0dc0\u0dba \u0db8\u0dca\u0db1\u0dca \u0dc1\u0dd9\u0dc1\u0db1\u0d9a\u0dca, \u0db8\u0dad\u0dd4\u0db8\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8, \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dd9\u0dcf\u0dbd \u0dc0\u0dd9\u0dc0\u0dcf\u0db1\u0dd4\u0dc1\u0dda\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0dd9 \u0dc1\u0dc3\u0dda\u0dc0\u0dd9 \u0dc3\u0dcf\u0d9c\u0db8\u0dc1\u0dda \u0dc1\u0dbd\u0dca\u0dd9\u0db8\u0dca\u0dc0\u0dba\u0dba\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0db8\u0dad\u0dd4\u0db8\u0dcf \u0dc0\u0dd2 \u0dcf\u0dbd \u0dc1\u0dc3\u0dda\u0dc0\u0dba\u0d9a\u0dca \u0dd9\u0dc5\u0dcf. \u0db8\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0dd9 \u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda \u0d85\u0db8\u0dcf\u0dbb\u0dd4 \u0dd9\u0dcf\u0dbd\u0dc0\u0dbd\u0daf\u0dd2\u0dad\u0dca, \u0db8\u0dad\u0dd4\u0db8\u0dcf \u0dc1\u0dc3\u0dda\u0dc0\u0dba \u0dd9\u0dba\u0db4\u0dd4 \u0da2\u0dcf\u0dad\u0dd2\u0dd9 \u0dc1\u0dc3\u0dda\u0dc0\u0dd9 \u0dc3\u0dcf\u0d9c\u0db8\u0dc1\u0dda \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd3\u0dba \u0dc3\u0db8\u0dd2\u0dad\u0dd2 \u0d85\u0da9\u0db4\u0da7 \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dd9\u0dcf\u0dbd\u0dc1\u0dda\u0dad\u0dca -1994 \u0dbd\u0db3\u0dbd\u0dcf\n\n1193 1194\n\n2025 \u0da2\u0db1\u0dc0\u0dcf\u0dbb\u0dd2 24\n\n\u0dc3\u0dd2\u0dbb\u0dd2\u0db1\u0dcf\u0dbd\u0dca \u0daf \u0dc1\u0db8\u0dbd\u0dca \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0db8\u0dca 84\u0d9a\u0dca \u0d86\u0dba\u0dd4 \u0dc0\u0dc5\u0db3\u0dcf \u0d85\u0dc1\u0db4\u0db1\u0dca \u0dc3\u0db8\u0dd4\u0d9c\u0dad\u0dca\u0dad\u0dcf. \u0db8\u0dad\u0dd4\u0db8\u0dcf 2000 \u0dc0\u0dc3\u0dc1\u0dda \u0dc4\u0dad\u0dba\u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dcf\u0dda\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0da2\u0dcf\u0dad\u0dd2\u0dd9 \u0dbd\u0dd0\u0dd2.\u0dc3\u0dcf\u0dad\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dba\u0dba\u0d9a\u0dd4 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0db4\u0dad\u0dca \u0dc0\u0dd4\u0da7\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0db8\u0dad\u0dd4\u0db8\u0dcf 2015 \u0d85\u0da7\u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dcf\u0dda\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc1\u0dda\u0dad\u0dca \u0d85\u0db4\u0dd2\u0dad\u0dca \u0db8\u0d9a\u0dca\u0dd9 \u0dd9\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dd9\u0dc5\u0dcf. \u0dbd\u0dad\u0dcf \u0d85\u0dc0\u0dcf\u0dd9, \u0db1\u0dd2\u0dc4\u0dad\u0db8\u0dcf\u0db1\u0dd3 \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd3\u0dba \u0dc3\u0db8\u0dd2\u0dad\u0dd2 \u0db1\u0dcf\u0dba\u0dd9\u0dba\u0d9a\u0dd4 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7, \u0d85\u0dc0 \u0dba \u0dad\u0dd0\u0db1\u0daf\u0dd2 \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd3\u0dba \u0dc3\u0db8\u0dd2\u0dad\u0dd2 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dbd\u0dad\u0dcf \u0daf\u0dd0\u0dc0\u0dd0\u0db1\u0dca\u0dad \u0dd9\u0dcf\u0dda\u0dba\u0db7\u0dcf\u0dba\u0dba\u0d9a\u0dca \u0dd9\u0dba\u0db4\u0dd4 \u0db1\u0dcf\u0dba\u0dd9\u0dba\u0d9a\u0dd4 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0db4\u0dd2 \u0db8\u0dad\u0dd4\u0db8\u0dcf\u0dc0 \u0daf\u0d9a\u0dd2\u0db1\u0dc0\u0dcf. \u0db8\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0dda \u0d86\u0daf\u0dba\u0dab\u0dd3\u0dba \u0db4\u0dd4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dcf \u0dc0\u0db1 \u0d9c\u0dba\u0dcf\u0db1\u0dca \u0daf \u0dc1\u0db8\u0dbd\u0dca \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0db8\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0dda \u0dc1 \u0db4\u0dcf\u0dbd\u0db1 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dba\u0dba \u0dbd\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0dc1\u0d9c\u0db1\u0dba\u0db8\u0dd2\u0db1\u0dca \u0d85\u0daf \u0dd9\u0dd0\u0dc3\u0dcf\u0db6\u0dd1\u0dc0 \u0d86\u0dc3\u0db1\u0dc1\u0dda \u0dc3\u0db8\u0d9c\u0dd2 \u0da2\u0db1 \u0db6\u0dbd\u0dc1\u0dda\u0d9c\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0dc3\u0dcf\u0dc0\u0dd2\u0db0\u0dcf\u0dba\u0dd9\u0dc0\u0dba\u0dba\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dc0\u0dd0\u0da9 \u0dd9\u0dba\u0db1\u0dc0\u0dcf. \u0d9c\u0dba\u0dcf\u0db1\u0dca \u0daf \u0dc1\u0db8\u0dbd\u0dca \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d92 \u0db4\u0dc0\u0dd4\u0dc1\u0dbd\u0dca \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0dc1\u0daf\u0db1\u0dcf\u0da7 \u0db8\u0dc1\u0dda \u0dd9\u0db1\u0d9c\u0dcf\u0da7\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dd9\u0dcf \u0dd9\u0dba\u0db8\u0dd2\u0db1\u0dca, \u0db8\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0db1\u0dd2\u0dc0\u0db1\u0dca \u0dc3\u0dd4\u0dc0 \u0d85\u0dad\u0dca\u0dc1\u0dda\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dda\u0dcf\u0db1\u0dcf \u0dd9\u0dba\u0db1\u0dc0\u0dcf."
  },
