8\u0dba\u0da79\u0dbd \u0db4\u0db8\u0da7\u0d9a\u0dca \u0d86\u0d9c\u0db8 \u0d85\u0db1\u0dd49 \u0dc19\u0db1\u0dca \u0dd9\u0dba\u0db1 \u0dbd\u0daf \u0daf\u0dad\u0dca\u0dad \u0db49\u0dbb\u0dd4.\n\n(\u0d86) (i) \u0dc1\u0dd9\u0dcf\u0dc0\u0dd2\u0da9\u0dca 17 \u0db8\u0dd2\u0dad \u0dc1\u0dda\u0dc4 \u0db6\u0dd0\u0dc4\u0dd0\u0dba \u0dd2\u0dbb\u0dbb\u0dd3\u0dc1\u0db8\u0dca\u0daf\u0dd3 \u0dc1\u0dd9\u0dcf\u0dc0\u0dd2\u0da9\u0dca 17 9\u0db1\u0dca\u0dba\u0dca\u0dda \u0dca\u200d\u0dbb\u0dc1\u0daf\u0daf\u0dc1\u0daf \u0dca\u0dda9\u0db7\u0dcf9\u0dba \u0dca\u0dc4 \u0dc1\u0dbd\u0ddd\u0dd9\u0dc1\u0daf \u0d85\u0dc1\u0db1\u0dd4\u0dad\u0dad\u0dca \u0dba\u0da79\u0dbd\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0dd9\u0dba\u0db1 \u0dbd\u0daf \u0d86\u0dd9\u0dcf\u0dba\u0dba \u0dca\u0dbd\u0dd9\u0dcf \u0db8\u0dc4\u0da2\u0db1\u0dad\u0dcf9\u0dc1\u0dda \u0dc1\u0dca\u0dde\u0d9b\u0dca\u200d\u0dba \u0d86\u0dba\u0d9a\u0dca\u0dc2\u0da7\u0dba \u0d8b\u0dc1\u0daf\u0dca\u0dcf \u0dc1\u0dd9\u0dcf\u0dc0\u0dd2\u0da9\u0dca 17 \u0d86\u0dca\u0dcf\u0daf\u0dd2\u0dad \u0db8\u0dd2\u0dad \u0dbb\u0dd3\u0dba \u0d86\u0daf\u0dcf\u0dc4\u0db1\u0dba \u0dd9\u0dc5\u0db8\u0db1\u0dcf\u0dd9\u0dba\u0da7\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dad\u0dcf\u0d9a\u0dca\u0dc2\u0d9a\u0dc0\u0dd9 \u0dd9\u0db8\u0dd2\u0da7\u0dd49 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca 9\u0db4\u0dad\u0db1\u0dca 9\u0dba \u0dd2\u0d9a\u0dbb\u0dca\u0dbd\u0dc1\u0dda \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8 \u0dc3\u0dd2\u0daf\u0dd4 \u0dd9\u0dba \u0d87\u0dad. \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0db8\u0dd2\u0dba \u0d9c\u0dd2\u0dba \u0db4\u0dd4\u0dda\u0d9c\u0dbd\u0db1\u0dca\u0db1\u0dca\u0dc1\u0dda \u0db8\u0dba\u0da79\u0dbd \u0d859\u0dca\u0db1\u0dca \u0dd9\u0da7\u0dba\u0dd4\u0dd4 \u0dc3\u0dd2\u0daf\u0dd4 \u0dd2\u0dbb\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0daf\u0dcf\u0dc59 \u0dd9\u0db8\u0dd2\u0da7\u0dd49 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dc4\u0dad \u0dd2\u0d9a\u0dbb\u0dca\u0dbd\u0dc1\u0dda \u0dd2\u0daf\u0dd2\u0db4\u0dad\u0db4\u0dad\u0dca \u0dd9\u0dba \u0d87\u0dad. \uf0d8 \u0db8\u0dd2\u0dba\u0d9c\u0dd2\u0dba \u0db4\u0dd4\u0dda\u0d9c\u0dbd\u0db1\u0dca\u0db1\u0dca\u0dc1\u0dda \u0db8\u0dd2\u0dad \u0dbb\u0dd3\u0dba \u0db4\u0dd0\u0dba 14\u0d9a\u0dca\n\n\u0d87\u0dd4\u0dc5\u0dad \u0d86\u0daf\u0dcf\u0dc4\u0db1\u0dba \u0dd2\u0dbb\u0dbb\u0dd3\u0db8.\n\n\uf0d8 \u0dc1\u0dad\u0ddd\u0dba\u0dcf\u0d9c\u0dad\u0dca \u0dd4\u0dc0\u0daf\u0dd9\u0dbd\u0dcf \u0db7\u0dd6\u0db8\u0dd29\u0dbd \u0db8\u0dd2\u0dad \u0dbb\u0dd3\u0dba\n\n\u0db7\u0dd6\u0db8\u0daf\u0dcf\u0db1\u0dba \u0dd2\u0dbb\u0dbb\u0dd3\u0db8."
