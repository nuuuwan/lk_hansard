9f\u0bcd\u0b9f\u0bae\u0bcd \u0bc6\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0ba4\u0bb0\u0bb5\u0bc1\u0b95\u0bb3\u0bcd [\u0bc6: 513] \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bc2\u0bb2\u0bae\u0bcd, 2025 \u2013 [\u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0bc6\u0b9f\u0bcd\u0b9f \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bc6\u0bbe\u0bae\u0bcd \u0ba8\u0bc6\u0bbe\u0bb3\u0bcd]: \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bc6\u0bbe\u0bae\u0bcd \u0bc8\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc1 - \u0bb5\u0bbf\u0bb5\u0bc6\u0bbe\u0ba4\u0bae\u0bcd \u0b92\u0ba4\u0bcd\u0ba4\u0bbf\u0bae\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0bc6\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1 [\u0bc6: 523-650]\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db4\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dbb\u0dc0\n\n\u0bc6\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0bb3\u0bc1\u0bc8\u0ba9\u0bcd\u0bb1\u0bae\u0bcd PARLIAMENT \u2014\u2014\u2014\u2014\u2014\u2013\u2014-\n\n2025 \u0db4\u0db4\u0db6\u0dbb\u0dc0\u0dcf\u0dbb\u0dd2 19\u0dc0\u0db1 \u0db6\u0daf\u0dcf\u0daf\u0dcf 2025 \u0ba4\u0bc6\u0baa\u0bcd\u0bb0\u0bc1\u0bb5\u0bc6\u0bbe\u0bbf 19, \u0baa\u0bc1\u0ba4\u0ba9\u0bcd\u0b95\u0bbf\u0bb4\u0bae\u0bc8\n\nWednesday, 19th February, 2025\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2013\u2014\u2014\n\n\u0db4\u0dd6.\u0db7\u0dcf. 9.30 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db4\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dbb\u0dc0 \u0dbb\u0dd0\u0dc3\u0db1 \u0dc0\u0dd2\u0dba. \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0dbb\u0dd9\u0dcf [\u0d9c\u0dd4 (\u0dc0\u0dc0\u0daf\u0dba) \u0da2\u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0dca\u200d\u0dbb\u0dd9\u0dbb\u0dad\u0dca\u0db1 \u0dd9\u0dad\u0dad\u0dcf]\n\n\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dc0\u0dd2\u0dba. \u0bc6\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0bb3\u0bc1\u0bc8\u0ba9\u0bcd\u0bb1\u0bae\u0bcd \u0bae\u0bc1.\u0bc6. 9.30 \u0bc8\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bbf\u0baf\u0ba4\u0bc1. \u0b9a\u0bc6\u0bc6\u0bbe\u0ba8\u0bc6\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd [\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 (\u0bae\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bc6\u0bbe\u0bcd) \u0b9c\u0b95\u0ba4\u0bcd\n\n\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bb0\u0bc8\u0bb0\u0ba4\u0bcd\u0ba9] \u0ba4\u0bae\u0bb2\u0bae\u0bc8 \u0bb5\u0b95\u0bbf\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd.\n\nThe Parliament met at 9.30 a.m., MR. SPEAKER [THE HON. (DR.) JAGATH\n\nWICKRAMARATNE] in the Chair.\n\n\u0db1\u0dd2\u0db4\u0dda\u0daf\u0db1 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd ANNOUNCEMENTS\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db4\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dbb\u0db4\u0dda \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc0\u0dbd \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0db4\u0dda\n\n\u0db1\u0dd2 \u0db4\u0dba\u0ddd\u0da2\u0db1\u0dba \u0bc6\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0bb3\u0bc1\u0bc8\u0ba9\u0bcd\u0bb1\u0b95\u0bcd \u0b95\u0bc1\u0bb4\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0baf\u0bbf\u0ba9\u0bcd"
