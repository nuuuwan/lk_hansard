    "chunk_size_bytes": 3621,
    "chunk_text": "\u0dc1\u0dda \u0d85\u0dba \u0dc0\u0dc3\u0dba \u0da2\u0db1\u0dad\u0dcf \u0d85\u0dba \u0dc0\u0dc3\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf. \u0db1\u0dda \u0d91\u0dc1 \u0dc4\u0dd2\u0dad\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dc3 \u0dc3. \u0dc1\u0dda\u0d9a \u0dbd\u0dc3\u0dc0\u0dc3\u0db1\u0da7 \u0d91\u0dd2\u0db6\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0db4\u0db1\u0dca\u0dc0\u0dd6\u0dc0\u0dcf\u0da7 \u0da2\u0db1\u0dad\u0dcf \u0d85\u0dba \u0dc0\u0dc3\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf, \u0dc1\u0dda\u0d9a \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d85\u0db1\u0dca\u0daf\u0db1 \u0d85\u0dba \u0dc0\u0dc3\u0dba\u0d9a\u0dca. \u0dc1\u0d9a\u0dd2\u0db6\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0db1\u0dda, \u0dc1\u0dda\u0d9a \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d85\u0db1\u0dca\u0daf\u0db1 \u0d85\u0dba \u0dc0\u0dc3\u0dba\u0d9a\u0dca. \u0dc1\u0dda\u0d9a pro-poor Budget \u0d91\u0d9a\u0d9a\u0dca \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dba\u0dd2. \u0dc3 \u0dbb \u0d85\u0dba \u0d9a\u0dc1\u0dda \u0dba\u0db1\u0dc0\u0dcf. \u0dcf\u0db0\u0dba\u0dc1\u0dda\u0dca\u0dad \u0dc3 \u0dbb \u0d85\u0dba \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0dc1\u0db1\u0dca, \u0d9a \u0dc1\u0dda \u0dba\u0db1. \u0dc1 \u0dc1 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dda\u0dc1\u0d9a\u0ddd. \u0dbb\u0dcf\u0da2\u0dba \u0dc1\u0dc3\u0dda\u0dc0\u0d9a\u0dba\u0db1\u0dca\u0da7 \u0dc0\u0dc3\u0da7\u0dd4\u0dda \u0dc0\u0dc3\u0da9\u0dd2 \u0d9a\u0dd2\u0dd3\u0db8 \u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 345\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dc5\u0dcf. \u0dbd\u0d9a\u0dca\u0dc2 14\u0d9a\u0dca \u0dbb\u0dcf\u0da2\u0dba \u0dc1\u0dc3\u0dda\u0dc0\u0d9a\u0dba\u0db1\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0dc3\u0db3\u0dc3\u0dba\u0dd2, \u0d85\u0dc0\u0dd2\u0db0\u0dd2 \u0dca\u0dad \u0d85\u0d82 \u0dc1\u0dda \u0d9a\u0dd3 \u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf\u0daf? \u0dc1\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0d85\u0d82 \u0dc1\u0dda \u0d9a\u0dd3 \u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf\u0daf? \u0dbd\u0d9a\u0dca\u0dc2 60\u0d9a\u0dca. \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0dab\u0dba\u0d9a\u0dca \u0d9c\u0db1\u0dca\u0db1 \u0db3\u0dc3 \u0dc3. \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0da2\u0dd3\u0dc0\u0dca\u0dad \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0d85 \u0dcf\u0dbb\u0dd4\u0dba\u0dd2. \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d9c\u0dc3\u0db1 \u0dc1\u0d9a\u0ddc\u0da0\u0dca\u0dcf\u0dbb \u0db1\u0dca\u0dbb\u0da7 \u0dc4\u0dd2\u0dad\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dcf\u0daf? \u0dbb\u0dcf\u0da2\u0dba \u0dc1\u0dc3\u0dda\u0dc0\u0d9a\u0dba\u0db1\u0dca\u0da7 \u0dc0\u0dd4\u0dab\u0dca\u0dad \u0dc1\u0dda \u0d9a\u0dbb\u0db4\u0dd4 \u0dc0\u0dc3\u0da7\u0dd4\u0dda \u0dc0\u0dc3\u0da9\u0dd2 \u0d9a\u0dd2\u0dd3\u0db8 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dab\u0dc0\u0dca\u0dad\u0daf?\n\n\u0dc1\u0db4\u0ddc\u0dbd\u0dca \u0d9c\u0dca\u0dad\u0dc1\u0dad\u0ddc\u0dca\u0dad, \u0dad\u0dbb \u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dca \u0da2\u0dd3\u0dc0\u0dca\u0dad \u0dc1\u0dc0\u0db1 \u0dc1\u0d9c\u0daf\u0dbb\u0d9a\u0da7 \u0daf\u0dd2\u0db1\u0d9a\u0da7 \u0d85\u0dc0 \u0dba \u0dc1\u0db4\u0ddc\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dab\u0dba \u0d9c\u0dab\u0db1\u0dca \u0daf\u0dbd\u0dcf \u0db3\u0dc3\u0dbd\u0dd4\u0dc0\u0dcf. \u0dc3 \u0dbb \u0d85\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf, \u0dc1 \u0ddc \u0da7 \u0d9a\u0db1\u0dc0\u0dcf \u0db1\u0dda \u0dc1\u0db4\u0ddc\u0dbd\u0dca \u0dc1\u0d9c\u0da9\u0dd2 \u0d91\u0d9a \u0dcf\u0dbb\u0d9a\u0dca \u0db1\u0db1\u0dd1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0daf\u0dc3\u0db1\u0dca \u0d89\u0dad\u0dd2\u0db1\u0dca \u0dc1 \u0ddc \u0da7 \u0d9a\u0db1\u0dca\u0db1 \u0db3\u0dc3 \u0dc3 \u0dc1\u0db1\u0dca. \u0dc1\u0db4\u0ddc\u0dbd\u0dca \u0dc3\u0dda\u0dc1\u0db3\u0ddd\u0dbd\u0dba \u0daf\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dad \u0dc1\u0db4\u0ddc\u0dbd\u0dca \u0da7\u0dd2\u0d9a \u0db8\u0dd2\u0dbb\u0dd2\u0d9a\u0dbd\u0dcf \u0d91\u0db1 \u0dc1\u0db4\u0ddc\u0dbd\u0dca \u0d9a\u0dd4\u0da9\u0dd4 \u0da7\u0dd2\u0dc1\u0d9a\u0db1\u0dca \u0dba\u0dd2. \u0d91 \u0dad\u0dc1\u0d9a\u0ddc\u0da7 \u0dad\u0dbb \u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dca \u0da2\u0dd3\u0dc0\u0dca\u0dad \u0dc1\u0dc0\u0db1 \u0dc1\u0d9c\u0daf\u0dbb\u0d9a\u0da7 \u0dc1\u0db4\u0ddc\u0dbd\u0dca \u0dc1\u0d9c\u0da9\u0dd2\u0dba\u0d9a\u0dca \u0daf\u0dc0\u0dc3\u0d9a\u0da7 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dab\u0dc0\u0dca\u0dad. \u0d91\u0dad\u0dc1\u0d9a\u0ddc\u0da7 \u0dcf\u0dc3\u0dba\u0d9a\u0da7 \u0dc1\u0db4\u0ddc\u0dbd\u0dca \u0dc1\u0d9c\u0da9\u0dd2 30\u0d9a\u0dca \u0db1\u0db1\u0dd1. \u0d94\u0db3\u0dad\u0dd4 \u0db1\u0dca\u0dbd\u0dcf \u0db3\u0dbd\u0dba\u0da7 \u0d91\u0db1\u0dca\u0db1 \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0dc1\u0db4\u0ddc\u0dbd\u0dca \u0dc1\u0d9c\u0da9\u0dd2\u0dba\u0d9a\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 100\u0dba\u0dd2. \u0daf\u0dc3\u0db1\u0dca \u0dc1\u0db4\u0ddc\u0dbd\u0dca \u0dc1\u0d9c\u0da9\u0dd2\u0dba\u0d9a\u0dca 240\u0dba\u0dd2. \u0dc1\u0db4\u0dc1\u0dbb\u0dca\u0daf\u0dcf \u0d91\u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0db1\u0dd2\u0da7\u0dca\u0da7\u0db9\u0dd4\u0dc1\u0dda \u0daf\u0dd3 \u0daf\u0dc3\u0d9a\u0dca\u0d9a\u0dcf \u0dc1\u0dbd\u0ddc\u0d9a\u0dd4 \u0dc1\u0db3\u0ddd\u0dda \u0d9c \u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf, '\u0dc1\u0db4\u0ddc\u0dbd\u0dca \u0dc1\u0d9c\u0da9\u0dd2\u0dba\u0d9a\u0dca 240\u0dba\u0dd2' \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 140\u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0db4\u0ddc\u0dbd\u0dca \u0dc1\u0d9c\u0da9\u0dd2\u0dba\u0d9a \u0db8\u0dd2\u0dbd \u0dc0\u0dc3\u0da9\u0dd2 \u0dc1\u0dc0\u0dbd\u0dcf. \u0dc1\u0db4\u0ddc\u0dbd\u0dca \u0dc1\u0d9c\u0da9\u0dd2\u0dba\u0d9a \u0dc0\u0dc3\u0da9\u0dd2\u0dc0\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 140\u0d9a\u0dca \u0dc0\u0dd4\u0dab\u0dcf , \u0dc1\u0db4\u0ddc\u0dbd\u0dca \u0dc1\u0d9c\u0da9\u0dd2 30\u0d9a\u0da7 \u0dcf\u0dc3\u0dba\u0d9a\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 4,200\u0d9a\u0dca \u0dc0\u0dc3\u0da9\u0dd2\u0db4\u0dd4\u0dbb \u0dc0\u0dc3\u0dba \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0d92 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 4,200\u0dba\u0dd2, \u0dcf\u0dbd\u0dca\u0dc0\u0dbd\u0da7 \u0dc0\u0dc3\u0da9\u0dd2 \u0dc0\u0dd4\u0dab\u0dd4 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 2,400\u0dba\u0dd2 \u0d9c\u0dca\u0dad\u0dad\u0dcf \u0dcf\u0dc3\u0dba\u0d9a\u0da7 \u0dc1\u0db4\u0ddc\u0dbd\u0dca \u0dc3 \u0dcf\u0dbd\u0dca \u0db8\u0dd2\u0dbd \u0dc0\u0dc3\u0da9\u0dd2\u0dc0\u0dd4\u0dab\u0dd4 \u0d9c\u0dab\u0db1 \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 6,600\u0d9a\u0dca \u0dc0\u0dd2\u0dba\u0daf\u0dda \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0dc3\u0db3\u0dc3\u0dba\u0dd2, \u0d94\u0db3\u0dad\u0dd4 \u0db1\u0dca\u0dbd\u0dcf \u0dbb\u0dcf\u0da2\u0dba \u0dc1\u0dc3\u0dda\u0dc0\u0d9a\u0dba\u0db1\u0dca\u0da7 \u0dc1\u0daf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 5,900\u0dba\u0dd2."
  },
