    "chunk_text": "\u0da2\u0dca\u200d\u0db1\u0dad\u0dca\u0dcf\u0dc0\u0d9a\u0d9c\u0db1\u0dca \u0dc4\u0dd4\u0d9a\u0daf\u0d9a\u0db1\u0dcf \u0d9a\u0dbb\u0db1 \u0db1\u0daf \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dbb\u0db1\u0d9a\u0dca \u0db1\u0dd0\u0dcf \u0dd0. \u0db1\u0dd2\u0dc2\u0dca\u0dbb\u0dcf\u0daf\u0db1\u0dba \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0d9c\u0dad\u0dca \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2, \u0d91\u0dba\u0da7 \u0da2\u0dca\u200d\u0db1\u0dad\u0dca\u0dcf\u0dc0\u0d9a\u0dda \u0db7\u0dcf \u0dcf\u0dcf\u0d9c\u0dd2\u0dca \u0dc0\u0dba \u0db1\u0db6\u0dcf\u0d9c\u0dad\u0dca \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2.\n\niii. \u0db1\u0dd2\u0dc2\u0dca\u0dbb\u0dcf\u0daf\u0db1\u0d9a\u0dba\u0db1\u0dca \u0db1\u0dd0\u0d9a\u0db6\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db1\u0dcf\u0dcf \u0db7\u0dcf \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba\u0db1\u0dca \u0db7\u0db8\u0dcf\u0da2\u0dca\u200d\u0dba \u0db4\u0dd4\u0dbb\u0dcf \u0db7\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dc0 \u0d9a\u0db6 \u0db1 \u0dba\u0dcf \u0dba\u0dd4\u0dad\u0dd4 \u0dc0\u0dd3\u0db8.\n\n\u0d9a\u0db8\u0dca\u0dc0\u0dcf \u0dad\u0dca\u0db8\u0dba\u0dd2, \u0d85\u0d9a\u0dda \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0d9a \u0dd6\u0dbd\u0dbd\u0dd2\u0d9a \u0dd6\u0dbd\u0db1\u0db0\u0dbb\u0dca\u0db8 \u0dc0\u0db1\u0dca\u0d9a\u0db1\u0dca.\n\ni. \u0d85\u0dad\u0dca\u0dba\u0dc0\u0dc1\u0dba\u0dd3\u0dba\u0dba \u0dcf\u0dcf\u0dab\u0dca\u0da9 \u0dcf \u0dcf \u0d9a\u0db7\u0dda\u0dc0\u0dcf \u0d85 \u0dab\u0dca\u0da9\u0dc0 \u0db7\u0dd0\u0dbb \u0d8b\u0db8 \u0db7\u0dcf \u0dad\u0dd2\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8.\n\nii. \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0dcf\u0dcf\u0dab\u0dca\u0da9 \u0dcf \u0dcf \u0d9a\u0db7\u0dda\u0dc0\u0dcf \u0db7\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0db8\u0dd2\u0db1\u0d9a\u0da7 \u0db7\u0dd0\u0dbb\u0dba\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dc0\u0dd3\u0db8.\n\niii. \u0dcf\u0dcf\u0dab\u0dca\u0da9 \u0dcf \u0dcf \u0d9a\u0db7\u0dda\u0dc0\u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dca \u0dcf \u0dd0\u0d9a\u0dd2 \u0db8 \u0da7\u0d9a\u0db8\u0dca \u0d9c\u0dd4\u0dab\u0dcf\u0dca \u0db8\u0d9a \u0db6\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dca \u0dc0\u0dd3\u0db8.\n\n\u0d9a\u0db8\u0dca\u0d9a \u0dad\u0dca\u0db8\u0dba\u0dd2 \u0dbb\u0da2\u0dca\u200d\u0dba\u0d9a\u0dca \u0dcf \u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0d85\u0dbb\u0da7 \u0dad\u0dd2\u0d9a\u0db6\u0db1 \u0dc0\u0d9c\u0d9a\u0dd3\u0db8. \u0dcf\u0dcf\u0dab\u0dca\u0da9 \u0dcf \u0dcf \u0d9a\u0db7\u0dda\u0dc0\u0dcf \u0d85 \u0dab\u0dca\u0da9\u0dc0\u0dca , \u0d9c\u0dd4\u0dab\u0dcf\u0dca \u0db8\u0d9a\u0dc0\u0dca , \u0db7\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0db8\u0dd2\u0db1\u0d9a\u0da7\u0dca \u0db4\u0dd4\u0dbb\u0dc0\u0dd0\u0dc3\u0dd2\u0dba\u0db1\u0dca\u0da7 \u0db1\u0db6\u0dcf \u0db1\u0d9a\u0db8\u0dca \u0dc0\u0d9c\u0d9a\u0dd3\u0db8 \u0dbb\u0da2\u0dca\u200d\u0dba\u0d9a\u0dca \u0db7\u0dad\u0dd4\u0dc0 \u0dad\u0dd2\u0d9a\u0db6\u0db1\u0dc0\u0dcf.\n\n\u0d9a\u0db8\u0db8 \u0db7\u0dd0\u0dbb\u0dba\u0dd4\u0db8 \u0db7\u0dcf \u0d89\u0dca \u0dbd\u0dd4\u0d9a\u0db8\u0dca \u0d85\u0dbb\u0db8\u0dd4\u0dab\u0dd4 \u0db7\u0dcf\u0d9a\u0dca\u0dc2\u0dcf\u0dca \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0d9a\u0db8\u0dca \u0dba\u0db1\u0dca\u200d\u0dbb\u0dab\u0dba \u0dbb\u0dcf \u0dad\u0dca \u0dbb\u0dd2\u0db4\u0daf\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\n\ni. \u0d9a\u0dc0\u0d9a\u0dcf\u0db3 \u0d9a\u0dbb\u0ddc\u0dcf \u0db6\u0db1\u0d9a\u0dda\u0d9c \u0d94\u0db7\u0dca\u0d9a\u0db7\u0dda \u0db7\u0dd0\u0dbb\u0dba\u0dd4\u0db8, \u0d89\u0dca \u0dbd\u0dd4\u0db8 \u0db7\u0dcf \u0db8\u0dd2\u0db1 \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0db1\u0db6\u0db1 \u0dad\u0dca\u0dbb\u0d9c\u0d9a\u0dcf\u0dbb\u0dd3 \u0d9a\u0dc0\u0d9a\u0dcf\u0db3 \u0d9a\u0dbb\u0ddc\u0dcf.\n\n\u0db7\u0db8\u0dcf \u0dbb \u0d9a\u0dca\u0d9a\u0dc2\u0dda\u200d\u0dbb \u0db7\u0db3\u0dcf \u0dcf \u0d85\u0db4\u0dd2 \u0dad\u0dca\u0dbb\u0d9c\u0d9a\u0dcf\u0dbb\u0dd3 \u0d9a\u0dc0\u0d9a\u0dcf\u0db3 \u0d9a\u0dbb\u0ddc\u0d9a\u0dcf\u0dda \u0db8\u0dd2\u0db1 \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d91\u0d9a\u0d9f\u0dad\u0dca\u0dcf\u0dc0 \u0dbb\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0db7\u0db8\u0dcf \u0dbb \u0d92\u0dc0\u0dcf \u0db1\u0dd2\u0dba\u0dcf\u0db8\u0db1\u0d9a\u0dba\u0db1\u0dca.\n\nii. \u0db1\u0dd2\u0dba\u0dcf\u0db8\u0db1\u0dba: \u0d9a\u0db8\u0dc4\u0dd2 \u0db1 \u0dbb\u0da2\u0dca\u200d\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0dcf\u0db8\u0db1 \u0d86\u0dba\u0dad\u0dca\u0db1 \u0dcf \u0dbb\u0dcf \u0dcf \u0d9a\u0dc0\u0d9a\u0dcf\u0db3 \u0d9a\u0dbb\u0ddc\u0dcf \u0db1\u0dd2\u0dba\u0dcf\u0db8\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8.\n\n\u0db7\u0db8\u0dcf \u0dbb \u0d9a\u0dca\u0d9a\u0dc2\u0dda\u200d\u0dbb\u0dc0\u0db1\u0da7 \u0db1\u0dd2\u0dba\u0dcf\u0db8\u0db1\u0dba \u0d87\u0dad\u0dd4\u0dcf\u0dca \u0d9a\u0dbb\u0d9c\u0dad\u0dca \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2.\n\niii. \u0d87\u0dad\u0dca\u0dd0\u0db8\u0dca \u0d9a\u0dca\u0d9a\u0dc2\u0dda\u200d\u0dbb\u0dc0\u0db1 \u0db7\u0dd0\u0dbb\u0dba\u0dd4\u0db8 \u0db7\u0dcf \u0d89\u0dca \u0dbd\u0dd4\u0db8 \u0db7\u0db3\u0dcf \u0dcf \u0db7\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0db7\u0dcf \u0dcf\u0dcf\u0d9c\u0dd2\u0dca \u0dc0\u0dba.\n\n\u0db7\u0db8\u0dcf \u0dbb \u0d9a\u0dca\u0d9a\u0dc2\u0dda\u200d\u0dbb \u0dad\u0dd2\u0d9a\u0db6\u0db1\u0dc0\u0dcf, \u0d9a\u0dc0\u0d9a\u0dcf\u0db3 \u0d9a\u0dbb\u0ddc\u0d9a\u0dcf\u0db1\u0dca \u0dbb\u0da2\u0dca\u200d\u0dba \u0dbb\u0dcf\u0d82\u0d9c\u0dd4\u0dc0\u0d9a\u0dca \u0d85\u0dca \u0dbb\u0dca \u0d9a\u0dbb\u0d9c\u0dad\u0dca \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2.\n\niv. \u0db7\u0db8\u0dcf \u0dbb \u0d9a\u0dca\u0d9a\u0dc2\u0dda\u200d\u0dbb\u0dc0\u0db1 \u0db1\u0dd2\u0dc2\u0dca\u0dbb\u0dcf\u0daf\u0db1 \u0db7\u0dcf\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8.\n\n\u0db7\u0db8\u0dcf \u0dbb \u0d9a\u0dca\u0d9a\u0dc2\u0dda\u200d\u0dbb\u0dc0\u0db1 \u0db1\u0dd2\u0dc2\u0dca\u0dbb\u0dcf\u0daf\u0db1 \u0db7\u0db8\u0dd4\u0dbb\u0d9a\u0dcf\u0dbb \u0d86\u0d9a\u0dd8\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0db7\u0dcf\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba \u0d9a\u0dcf \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0d91\u0dba \u0d85\u0d9a\u0dda \u0dc0\u0dd0\u0da9 \u0db4\u0dd2 \u0dc5\u0dd2\u0d9a\u0dc0\u0dcf \u0dad\u0dd4\u0dcf \u0db7\u0db3\u0dcf \u0db1\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0d9a\u0db6\u0db1\u0dc0\u0dcf.\n\n\u0d9a\u0db8\u0dc0\u0dbb \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0d9a\u0db8\u0db8 \u0dd6\u0dbd\u0db1\u0db0\u0dbb\u0dca\u0db8 \u0db8\u0dad\u0dca \u0dbb\u0daf\u0db1\u0db8\u0dca\u0dc0 \u0db7\u0d9a\u0db7\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0d9a\u0db6\u0db1 \u0d85\u0dad\u0dca\u0dbb, \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0db4\u0dd4\u0dbb\u0dc0\u0dd0\u0dc3\u0dd2\u0dba\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0dbb\u0dd3 \u0db7\u0dcf \u0dcf\u0dcf\u0d9c\u0dd2\u0dc0\u0db1\u0dca\u0db1\u0db1\u0dca, \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0dbb\u0dd3 \u0dbb\u0dcf\u0dbb\u0dca\u0dc1\u0dba\u0dd3\u0dba\u0dca\u0dc0\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0db7\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0dbb\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db1\u0dcf\u0dd3\u0db1\u0db1\u0dca \u0dc0\u0db1 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba\u0d9a\u0dca \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dbb\u0daf\u0db1\u0db8\u0d9a\u0dca \u0db7\u0dd0\u0d9a\u0dc3\u0dd3\u0db8\u0da7 \u0d85\u0dbb \u0d85\u0daf\u0dcf \u0db7\u0dca\n\n\u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0dbb\u0da2\u0dca\u200d\u0d9a \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbb\u0dba \u0dc0\u0db1\u0dca\u0d9a\u0db1\u0dca, \u0db8\u0dd2\u0db1\u0dd2 \u0d91\u0db1\u0dca\u0da7 \u0dad\u0dca\u0db8 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc0\u0dd2\u0dcf\u0dc0\u0dba\u0db1\u0dca \u0db7\u0db4\u0dd4\u0dbb\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d87\u0dad\u0dd2 \u0db6\u0dcf\u0db0\u0dcf \u0d89\u0dc0\u0dca \u0d9a\u0dbb \u0dbb\u0dcf \u0d91\u0d9a\u0db8\u0dca \u0db7\u0dd0\u0db1\u0dc3\u0dd3\u0db8\u0dba\u0dd2. \u0daf\u0dd4\u0dc2\u0dca\u0d9a\u0dbb \u0db4\u0dca\u200d\u0dbb\u0d9a \u0dc1\u0dba\u0dd3\u0dba\u0dba\u0d9a \u0da2\u0dd3\u0dc0\u0dca \u0dc0\u0dd3\u0db8 \u0d9a\u0dcf \u0dda\u0dad\u0dd4\u0d9a\u0dc0\u0db1\u0dca, \u0dba\u0db8\u0dca \u0db4\u0dd4 \u0d9c\u0db1\u0d9a\u0dba\u0d9a\u0dd4 \u0d86\u0db6\u0dcf\u0db0\u0dd2\u0dad\u0dca\u0dcf\u0dcf\u0dc0\u0dba\u0d9a\u0dca \u0d9a\u0dcf \u0dda\u0dad\u0dd4\u0d9a\u0dc0\u0db1\u0dca, \u0d85\u0db0\u0dba\u0dcf\u0dbb\u0db1 \u0d85\u0dc0\u0db7\u0dca\u0dae\u0dcf \u0dc4\u0dd2\u0d9f\u0dc0\u0dd3\u0db8 \u0d9a\u0dcf \u0dda\u0dad\u0dd4\u0d9a\u0dc0\u0db1\u0dca, \u0dd6\u0dbd\u0dbd\u0dd2\u0d9a \u0dba\u0da7\u0dd2\u0dad\u0dca\u0db1 \u0dbb\u0dcf \u0d91\u0d9a\u0db8\u0dca \u0d9a\u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2\u0d9a\u0db8 \u0d9a\u0dcf \u0dda\u0dad\u0dd4\u0d9a\u0dc0\u0db1\u0dca \u0dad\u0dca\u0db8 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dcf \u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0db7\u0db4\u0dd4\u0dbb\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d9a\u0db1\u0ddc\u0dcf \u0dd0\u0d9a\u0dd2 \u0dc0\u0dd6 \u0dc0\u0dd2\u0da7 \u0d92\u0d9a \u0d85\u0db7\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca. \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dd2\u0dc2\u0db8\u0dad\u0dca\u0dcf \u0db8\u0dad\u0dca \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba\u0da7 \u0db7\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0dc0\u0dd3\u0db8 \u0db7\u0db3\u0dcf \u0dcf \u0dad\u0dd2\u0d9a\u0db6\u0db1 \u0db6\u0dcf\u0db0\u0dcf \u0d85\u0db4\u0dd2 \u0d89\u0dc0\u0dca \u0d9a\u0dcf \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2."
