    "chunk_text": "\u0d9c\u0dc0 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2\u0dd4\u0db8\u0dd2\u0dba \u0d94\u0db6\u0dd4\u0db8\u0dd2\u0dba \u0d85\u0daf \u0d9c\u0dc0 \u0dca\u0db7\u0dcf9\u0da7 \u0db4\u0dd09\u0dc3\u0dd6 \u0db4\u0dd2\u0dc5\u0dd2\u0dd4\u0dba \u0dd2\u0d9a9\u0dd0\u0dba\u0daf\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0dd4\u0dba\u0d9a\u0dca \u0dd2\u0dbb\u0dba\u0dbd\u0dcf \u0dd2\u0dbb\u0dc3\u0dd2\u0dc1\u0dca\u0dda\u0dad\u0dca\u0db8 \u0d85\u0db4\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0. \u0dc1\u0db8\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc1\u0dda \u0dc1\u0dda\u0da7\u0dca\u0da7\u0dd49 \u0d9c\u0dcf9\u0da7 \u0dd9\u0dc0\u0dd4\u0dc0 \u0db1\u0dca \u0dc1\u0dc4\u0ddd \u0dd2\u0d9a\u0dbd\u0db0\u0dcf\u0db4\u0dad\u0dc1\u0dba\u0d9a\u0dca \u0db4\u0dad\u0dca \u0dd9\u0dba\u0db1\u0dca\u0db1 \u0d94\u0db6\u0dd4\u0db8\u0dd2\u0dba\u0da7 \u0db4\u0dd4\u0dc5\u0dd49\u0db1\u0dca \u0db1\u0db8\u0dca \u0d91\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0db8\u0dcf\u0daf\u0dd2\u0dc19\u0dbd \u0db8\u0db1\u0dca\u0dd3 \u0dd2\u0d9a9\u0dcf\u0dca \u0dca\u0ddc\u0d82\u0dd3\u0dbb\u0dbb\u0dca\u0dbd\u0da7\u0dba \u0d9c\u0dcf9\u0da7 \u0dd9\u0dc0\u0dd4\u0dc0 \u0dc1\u0dc4\u0ddd \u0dd2\u0d9a\u0dbd\u0db0\u0dcf\u0db4\u0dad\u0dc1\u0dba\u0d9a\u0dca \u0db4\u0dad\u0dca \u0dd9\u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd49\u0db1\u0dca \u0db1\u0db8\u0dca \u0d92 CCTV \u0db6\u0dbd\u0dbd\u0dcf \u0d94\u0db6\u0dd4\u0db8\u0dd2\u0dba\u0da7 \u0dd2\u0dad\u0dcf \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd29\u0db8 \u0dc1\u0dad\u0dca\u0dc0 \u0db8\u0dca \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd49\u0db1\u0dca \u0dc1\u0db8\u0dca9\u0dcf. \u0d85\u0db4\u0da7 \u0dc1\u0db4\u0dc1\u0db1\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0db1\u0db8\u0dca \u0dc1\u0d9c\u0ddd\u0dbd\u0dca \u0dc1\u0dc6\u0dda\u0dca\u0dda \u0d91\u0dc1\u0d9a\u0dca \u0dc1\u0db4\u0db1\u0dca9\u0db4\u0dd4 9\u0dcf\u0dc4\u0db19\u0dd2\u0db1\u0dca \u0db6\u0dcf\u0d9c\u0dba\u0d9a\u0dca \u0dc1\u0db8\u0dad\u0dd0\u0db1 \u0dd2\u0db1\u0dca\u0db1 \u0db8\u0db1\u0dca\u0dd39\u0dc0 \u0db4\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0dd2 \u0dd9\u0dba\u0db19\u0dcf. \u0dc4\u0dd0\u0db8 \u0db8\u0db1\u0dca\u0dd39\u0dba\u0dba\u0dd4\u0dad\u0da7\u0db8 \u0dad\u0dd2\u0dc1\u0db6\u0db19\u0dcf. \u0d94\u0db6\u0dd4\u0db8\u0dd2\u0dba\u0dad\u0dca \u0dc1\u0db1\u0dcf\u0db8\u0d9f \u0dba9\u0dbd\u0dcf\u0daf \u0dd2\u0dbb\u0dba\u0dbd\u0dcf \u0db8\u0db8 \u0daf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d92\u0dd9 \u0dd2\u0d9a\u0dca\u0dcf \u0dd2\u0dad\u0dcf \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd29 \u0dc1\u0db8\u0dca \u0d9c\u0dd0\u0db1 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0da7\u0dba\u0d9a\u0dca \u0dd9\u0dba\u0db1\u0dca\u0db1. \u0d94\u0db6\u0dd4\u0db8\u0dd2\u0dba\u0dbd\u0dcf \u0db6\u0dbd\u0dba\u0da7 \u0d86\u0dc1\u0dda \u0dc1\u0db8\u0dca9\u0dcf \u0d85\u0db1\u0dca\u0db1\u0dca \u0dd9\u0dba\u0db19\u0dcf \u0dd9\u0dd0\u0db1\u0dca\u0da7\u0dd2\u0db1\u0dca 9\u0dc4\u0db19\u0dcf \u0dd2\u0dbb\u0dba\u0dbd\u0dcf \u0dc1\u0db1\u0dca. \u0d92 \u0dd2\u0dbb\u0dda9 \u0dc1\u0dda9\u0dbd\u0dca \u0d91\u0dd9\u0d9a\u0dca9\u0dad\u0dca \u0dc19\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0dc1\u0db1\u0dca. \u0dc1\u0db4\u0dcf\u0da9\u0dca\u0da9\u0d9a\u0dca \u0dd9\u0dd0\u0db1\u0dca\u0da7\u0dd2\u0db1\u0dca \u0d91\u0dd9 \u0db4\u0dd0\u0dad\u0dca\u0dad\u0da7\u0dad\u0dca \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db1\u0dca\u0db1. \u0dd9\u0dc0 \u0da7\u0dcf\u0dd9\u0dba\u0dbd\u0dcf \u0dc1\u0db8\u0dca \u0d9c\u0dd0\u0db1 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0da7\u0dba\u0d9a\u0dca \u0db49\u0dad\u0dca9\u0db1\u0dca\u0db1.\n\n\u0d8a\u0dbb\u0dca\u0dbd\u0dc2\u0dba\u0dcf9\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dc19\u0db19\u0dcf \u0db1\u0db8\u0dca \u0d92\u0dd9\u0da7 \u0d85\u0db4\u0da7 \u0dd9\u0dba\u0db1\u0dca\u0db1 \u0dc1\u0daf\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dd3\u0db6\u0dcf\u0db0\u0dcf \u0dd2\u0dbb\u0dbb\u0dd3\u0db8\u0dca \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dbb\u0dd4\u0dba\u0da7\u0dba \u0dd9\u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0db8\u0dcf\u0dad\u0dba9\u0dc0 \u0db1\u0dca\u0da7 9\u0dcf\u0dc4\u0db1 \u0d859 \u0dba\u0db1\u0dca \u0dd2\u0d9a\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0d85\u0db8\u0dcf\u0dad\u0dba9\u0dc0 \u0db1\u0dca\u0da7 9\u0dcf\u0dc4\u0db1 \u0d859 \u0dba\u0db1\u0dca. \u0d92\u0dc1\u0d9c\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca 9\u0dd0\u0da9 \u0dd9\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0db4\u0dd2 \u0dc1\u0dd9\u0dcf\u0db1\u0dca \u0dc19\u0dbd\u0dcf9\u0dd99\u0dad\u0dca 9\u0dcf\u0dc4\u0db1 \u0db4\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0dd2 \u0dd9\u0dba\u0db1 \u0d91\u0dd9 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dca\u0dc1\u0dc2\u0dda\u0db4 \u0dd9\u0dba\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0dc1\u0db1\u0dca. \u0dd2\u0d9a\u0dbd 9 \u0dc1\u0dba\u0db1\u0dca \u0d92 9\u0dcf\u0dc4\u0db1 \u0db4\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0dd2\u0dba \u0d85\u0db4\u0dd2 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dca\u0dc1\u0dc2\u0dda\u0db4 \u0dd9\u0dba\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0dc1\u0dd9\u0dcf\u0dad\u0dd0\u0db1\u0dd99\u0dad\u0dca. \u0dd2\u0d9a\u0dbd 9 \u0dc1\u0dba\u0db1\u0dca \u0d85\u0db4\u0da7 \u0d9c\u0dad \u0dc4\u0dd0\u0dd2\u0dbb \u0d9c\u0dad \u0dba\u0dd4\u0dd4 9\u0dcf\u0dc4\u0db1 \u0d85\u0db4\u0dd2 \u0db4\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0dd2 \u0dd9\u0dba\u0db19\u0dcf. \u0d92 \u0d9c\u0dd0\u0db1 \u0d85\u0db4\u0da7 \u0dd2\u0dbb\u0dc3\u0dd2\u0db8 \u0dca\u200d\u0dbb \u0dda\u0db1\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0."
