    "chunk_text": "\u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dba\u0dc1\u0dda \u0d85\u0dba \u0d85\u0db4\u0da7 \u0daf\u0dd3\u0dbd\u0dcf \u0dd2\u0d9a\u0db6\u0dd4\u0dc1\u0dca\u0da9 \u0db8\u0dcf\u0dc3 \u0dc1\u0daf \u0d9a\u0dca \u0dc0\u0dd0\u0db1\u0dd2 \u0d89\u0dad\u0dcf\u0db8 \u0dc3\u0dd4\u0dc5\u0dd4 \u0dcf\u0dbd\u0dba\u0d9a\u0dca. \u0db8\u0dcf\u0dc3 \u0dc1\u0daf \u0d9a\u0dca \u0dba\u0db1\u0dc1 \u0ddc\u0da7 \u0d86\u0dca\u0da9\u0da9\u0dd4\u0dc0 \u0da7\u0dcf \u0dc0\u0dd0\u0dc1\u0da7\u0db1\u0dc0\u0dcf \u0db4\u0da9\u0dd2 \u0dc1\u0d9c\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0dc1\u0dad\u0dbd\u0dca\u0dc0\u0dbd\u0da7 \u0d9c\u0dd1\u0dc3\u0dca\u0dc0\u0dbd\u0da7 \u0dc1\u0db4\u0ddd\u0dbd\u0dd2\u0dc1\u0dda \u0d89\u0db1\u0dca\u0db1 \u0dd2\u0db1 \u0db0 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0da2\u0dca\u200d\u0dcf\u0dad\u0dba\u0db1\u0dca\u0dad\u0dbb \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d \u0dc1\u0dba\u0ddd \u0db1\u0dd0\u0dd2\u0d9a \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0dbb\u0da7 \u0da7\u0dcf \u0dc0\u0dd0\u0dc1\u0da7\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d92 \u0d85\u0dba \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0ddc\u0dc1\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dd2\u0db1\u0da7\u0dd2\u0dba\u0dcf. \u0da2\u0dca\u200d\u0db1 \u0dc0\u0dbb\u0db8\u0d9a\u0dd2\u0db1\u0dca \u0d85\u0dd4\u0dbb\u0dbb\u0dd4\u0dd4\u0dc0 \u0db4\u0dc4 \u0da7 \u0db6\u0dbd\u0dba\u0da7 \u0db4\u0dad\u0dca \u0dc1\u0dc0\u0da0\u0dca\u0da0 \u0d85\u0db4\u0dd2 \u0db8\u0dcf\u0dc3 \u0dc1\u0daf \u0d9a\u0dd2\u0db1\u0dca \u0d86\u0dca\u0da9\u0da9\u0dd4\u0dc0 \u0daf\u0db8\u0dcf \u0dd4\u0dc0\u0dc0\u0db1 \u0dda \u0db6\u0dbd\u0dcf \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dc1\u0dda \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dba\u0dc1\u0dda \u0d85\u0dba\u0da7 \u0d85\u0db4\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0dd2\u0d9a\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d94\u0db6 \u0d92 \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0ddc\u0dc1\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0dd4\u0dbb\u0dab\u0dd4 \u0dc1 \u0d85\u0dd4\u0dbb\u0dbb\u0dd4\u0dd4\u0dc0 \u0db4\u0dc4\u0d9a\u0dca \u0dba\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0db8 \u0d94\u0db6\u0da7 \u0dd2\u0db1\u0dc4\u0dd2\u0db1\u0dba\u0d9a\u0dca \u0db4\u0db8\u0dab\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1 \u0dcf\u0dbb\u0dab\u0dba\u0dba\u0dd2. \u0d85\u0db4\u0dd2"
