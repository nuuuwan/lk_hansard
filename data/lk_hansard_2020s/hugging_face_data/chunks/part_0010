    "chunk_text": "1981\u0daf\u0dd3 \u0da2\u0db4\u0dcf\u0db1\u0dc1\u0dda \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d9a\u0dbb\u0dca \u0dcf\u0db1\u0dca\u0dad \u0d86\u0dba\u0dad\u0db1 \u0dc0\u0db1 \u0dc1\u0da7\u0ddc \u0dc1\u0dba\u0ddd\u0da7\u0dcf, \u0dc3\u0dc3\u0dc0\u0dc3\u0dcf, \u0dc1 \u0ddc\u0db1\u0dca\u0dc3\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0dad\u0dd4\u0db1 \u0dc0\u0dcf \u0db1 \u0daf\u0db1\u0dca\u0db1, \u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0d9a\u0dbb\u0dca \u0dcf\u0db1\u0dca\u0dad \u0daf\u0db1\u0dca\u0db1 \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0d9a\u0dba\u0db1\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0da7 \u0d86\u0dc0\u0dcf. \u0dc3\u0db3\u0dc3\u0dba\u0dd2 \u0d91\u0daf\u0dcf \u0dc1\u0dda\u0dc0\u0dd3\u0db4\u0dd3 \u0d91\u0dc1\u0d9a\u0dca unions \u0db4\u0dcf\u0dbb\u0da7 \u0db3\u0dc3 \u0dc3\u0dbd\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf, \"\u0dc1\u0dda\u0dc0\u0dcf\u0da7 \u0d89\u0dc3 \u0dc1\u0daf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dc3 \u0dc3\" \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d91\u0dad\u0dc1\u0d9a\u0ddc\u0da7 \u0dc1\u0da7\u0ddc\u0dc1\u0dba\u0ddd\u0da7\u0dcf, \u0dc3\u0dc3\u0dc0\u0dc3\u0dcf, \u0dc1 \u0ddc\u0db1\u0dca\u0dc3\u0dcf \u0dc3 \u0dcf\u0d9c\u0dda \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0db1 \u0d85\u0d9a\u0dd4\u0dc5\u0dcf\u0dc1\u0d9c\u0db1 \u0dc3\u0dc1\u0dbd\u0dca\u0dc3\u0dd2\u0dba\u0dcf\u0dc0\u0da7, \u0dad\u0dcf\u0dba\u0dd2\u0dbd\u0db1\u0dca\u0dad\u0dba\u0da7, \u0d89\u0db1\u0dca\u0db1\u0dca\u0db1\u0dd3\u0dc3\u0dd2\u0dba\u0dcf\u0dc0\u0da7 \u0d9c\u0dd2\u0dba\u0dcf. \u0d92 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0db4\u0da7 \u0d92 \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0db1 \u0d85\u0dc4\u0dd2\u0db8\u0dd2 \u0dc0\u0dd4\u0dab\u0dcf. \u0dc1\u0d9a\u0ddd\u0da7\u0dd2 \u0d9c\u0dab\u0db1\u0d9a \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0db1 \u0d85\u0db4\u0da7 \u0d85\u0dc4\u0dd2\u0db8\u0dd2 \u0dc0\u0dd4\u0dab\u0dcf. \u0d92\u0dc1\u0d9a\u0db1\u0dca \u0d85\u0dc1\u0dda \u0d85\u0dba\u0da7 \u0dc4\u0dd2\u0db8\u0dd2 \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dbb\u0dc3\u0dc0\u0dc3\u0dcf \u0da7\u0dd2\u0d9a \u0db1\u0dc3\u0dad\u0dd2 \u0dc0\u0dd4\u0dab\u0dcf. \u0d92\u0d9a\u0da7 \u0dc0\u0d9c\u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0db1\u0db1\u0dd1 \u0d94\u0db3\u0dad\u0dd4 \u0db1\u0dca\u0dbd\u0dcf.\n\n1981 \u0dc3\u0dc3\u0dda\u0dad\u0dc3\u0dda\u0db3\u0dbb\u0dca \u0dcf\u0dc3\u0dc1\u0dda \u0dc1\u0dda.\u0d86\u0dbb\u0dca. \u0da2\u0dba\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dad\u0dcf \u0dbb\u0dcf\u0d9c \u0da9\u0dc0\u0daf\u0dba \u0dc0\u0dd2 \u0dc0\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd\u0dba \u0d86\u0dbb\u0dda\u0db7 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d8b\u0dca\u0dad\u0dc3\u0dcf \u0d9a\u0dc5\u0dcf. 1988\u0daf\u0dd3 \u0dc1\u0dda\u0dc0\u0dd3\u0db4\u0dd3 \u0d91\u0d9a \u0d92 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db1 \u0dc1\u0d9c\u0ddc\u0dc3\u0db1\u0dc3\u0d9f\u0dd2\u0dbd\u0dca\u0dbd\u0da7 \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dc3\u0db6\u0dd4\u0dc0\u0dcf. \u0d85\u0db1\u0dca\u0dad\u0dd2 \u0da7 \u0dbb\u0dab\u0dc3\u0dd2\u0d82 \u0dc1\u0db4\u0dca\u200d\u0dbb\u0dda \u0daf\u0dcf\u0dc3 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4 \u0dcf\u0da7 \u0d92\u0d9a\u0da7 \u0d94\u0dc1\u0dbb\u0ddc\u0dca\u0dad\u0dad\u0dd4 \u0dc1\u0daf\u0db1\u0dca\u0db1 \u0db3\u0dc3\u0dbb\u0dd4\u0dc0 \u0d92\u0d9a \u0dc3\u0dda\u0dd6\u0dbb\u0dbb\u0dca\u0dab\u0dc1\u0dba\u0db1\u0dca \u0dc0 \u0dbd\u0dcf \u0daf\u0dc3\u0dda \u0dcf. \u0d8a\u0da7 \u0db4\u0dc3\u0dc0\u0dc1\u0dc3\u0dda \u0dc1 \u0ddc\u0d9a\u0d9a\u0dca\u0daf \u0dc0\u0dd4\u0dc1\u0dab\u0dca? \u0dad\u0dd3\u0dbb\u0dca \u0dc1 \u0ddc \u0dda \u0dc3\u0dc1\u0dbd\u0dca\u0dc3\u0dd2\u0dba\u0dcf\u0dc1\u0dda \u0dc3\u0dd2\u0da7 \u0d92\u0dc0\u0dcf \u0db3\u0dbd\u0dcf\u0dc1\u0d9c\u0db1 \u0d89 \u0dbd\u0dcf \u0dc1 \u0ddc\u0d9a\u0d9a\u0dca\u0daf \u0d9a\u0dc1\u0dc5\u0dda? \u0d85\u0dc1\u0dda \u0d92 \u0dcf\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dc0\u0dbb\u0dd4, \u0d86\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dc0\u0dbb\u0dd4 \u0d94\u0d9a\u0dca\u0dc1\u0d9a\u0ddd\u0da7 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf \u0d92 \u0dbb\u0da7\u0da7. \u0d91\u0dc1 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0dbd\u0dcf \u0d92 \u0dc1\u0dc3\u0da7\u0dca \u0d91\u0d9a\n\n\u0dc3\u0dc1\u0dbd\u0dca\u0dc3\u0dd2\u0dba\u0dcf\u0dc0\u0da7 \u0d9c\u0dca\u0dad\u0dad\u0dcf. \u0d85\u0dbb\u0dc1\u0d9c\u0db1, International Medical University \u0d91\u0d9a \u0dc3\u0dc0\u0dae\u0dcf\u0db4\u0db1\u0dba \u0d9a\u0dc5\u0dcf, \u0dc3\u0dc1\u0dbd\u0dca\u0dc3\u0dd2\u0dba\u0dcf\u0dc1\u0dda. \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0db1\u0dca 25\u0d9a\u0dca, 30\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0dc0\u0dc1\u0dc3\u0dda \u0dc3 \u0dc0\u0dc3\u0dbb\u0d9a \u0dbd\u0d82\u0d9a\u0dcf\u0dc1\u0dda \u0dc3\u0dd2\u0dd4\u0db8\u0db1\u0dca 150\u0d9a\u0dca, 200\u0d9a\u0dca \u0dc3\u0dc1\u0dbd\u0dca\u0dc3\u0dd2\u0dba\u0dcf\u0dc1\u0dda \u0d92 \u0dc0\u0dd2 \u0dc0\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd\u0dc1\u0dda \u0d89\u0dc1\u0d9c\u0db1 \u0d9c\u0db1\u0dca\u0db1 \u0dba\u0db1\u0dc0\u0dcf, \u0dc1\u0dc3\u0ddc\u0dbd\u0dbb\u0dca \u0dbd\u0d9a\u0dca\u0dc2 \u0d9c\u0dab\u0db1\u0d9a\u0dca \u0dc0\u0dd2\u0dba\u0daf\u0dda \u0d9a\u0dbb\u0dc1\u0d9c\u0db1. \u0d92 \u0db4\u0dc0 \u0d9a\u0dcf\u0dc1\u0dda\u0daf?\n\n\u0d92 \u0dc0\u0dcf\u0dc1\u0dda \u0d94\u0db3\u0dad\u0dd4 \u0db1\u0dca\u0dbd\u0dcf\u0dc1\u0d9c\u0db1\u0dca \u0dc1\u0dda \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0dca\u0dad \u0d85 \u0db1\u0dca\u0db1 \u0d9a\u0dc3 \u0dc3\u0dad\u0dd2\u0dba\u0dd2. NSBM \u0d91\u0dc1\u0d9a\u0dca \u0dc1\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0da9\u0dc0\u0daf\u0dba \u0dc0\u0dd2 \u0dc0\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0d86\u0dbb\u0dda\u0db7 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9c\u0dd2\u0dba \u0dc0\u0dc3\u0dc1\u0dbb\u0dca \u0d85\u0db1\u0dd4 \u0dc3\u0dad\u0dd2\u0dba \u0dbd\u0db3\u0dcf \u0db1\u0dca\u0db1\u0dca\u0db1\u0dcf. \u0d94\u0db3\u0dad\u0dd4 \u0db1\u0dca\u0dbd\u0dcf \u0d92\u0d9a \u0d86\u0dbb\u0dda\u0db7 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0daf, \u0db1\u0dc3\u0daf\u0dca\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d8b\u0dca\u0dad\u0dad\u0dbb\u0dba\u0d9a\u0dca \u0dc1\u0daf\u0db1\u0dca\u0db1. \u0d94\u0db3\u0dad\u0dd4 \u0db1\u0dca\u0dbd\u0dcf \u0daf\u0dc3\u0db1\u0dca\u0dc0\u0dca\u0dad \u0dc1\u0dc0\u0db1\u0dc3\u0dc0 \u0dc1\u0dc0\u0dbd\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1."
