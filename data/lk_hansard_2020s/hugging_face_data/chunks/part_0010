    "chunk_text": "\u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0d9a\u0db7\u0dda\u0dc0\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0d9a\u0dda \u0d85\u0dc0\u0db8 \u0dd6\u0dbd\u0dbd\u0dd2\u0d9a \u0dc0\u0dd0\u0da7\u0dd4\u0dbb \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db7\u0db1\u0d9a\u0dcf \u0db6\u0dd0\u0dbd\u0dd3\u0d9a\u0db8\u0dca \u0db1 \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0d9a\u0db7\u0dda\u0dc0\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0d9a\u0dda \u0d86\u0dbb\u0daf\u0dcf \u0dab\u0dba \u0dc3\u0dd3\u0db8\u0dcf\u0dc0 \u0daf\u0dd0\u0db1\u0da7 \u0dbb\u0dc0\u0dad\u0dd2\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 250,000 \u0dc3\u0dd2\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 400,000 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d89\u0dcf \u0dcf \u0db1\u0dcf\u0d82\u0dc0\u0db1\u0dc0\u0dcf. \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dc0\u0dd0\u0da9\u0dd2\u0dc0\u0dd3\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dd4\u0dbb \u0dc0\u0dd2\u0db7\u0dca\u0dad\u0dca\u0dbb \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 v \u0dad\u0dca\u0dcf\u0d9a\u0dca\u0dc2\u0dab\u0dd2\u0d9a \u0db7\u0da7\u0dcf \u0d9a\u0db1\u0dc4\u0dd2 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dad\u0dd2\u0d9a\u0db6\u0db1\u0dc0\u0dcf.\n\n\u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0d85\u0dba\u0da7 \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dc0\u0db1\u0dca\u0d9a\u0db1\u0dca \u0d9a\u0d9a\u0ddc\u0d9a\u0dcf \u0ddc\u0db8\u0daf \u0d9a\u0dd2\u0dba\u0db1\u0dcf \u0d92\u0d9a\u0d9a\u0db1\u0dca \u0db6\u0db1\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca.\n\n40. \u0db8\u0db4\u0dde \u0d9c\u0dbd\u0dd2\u0d9a \u0d85\u0dcf\u0d82\u0dc1\u0dca\u0db8\u0dda \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc0\u0dd0\u0dd2\u0da2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\n\n\u0daf\u0dd0\u0db1\u0dca \u0d9a\u0dbb\u0dde \u0d9c\u0dbd\u0dd2\u0d9a \u0d85\u0dcf\u0d82\u0dc1\u0dba\u0dd3\u0dba\u0d9a \u0d85\u0dc0\u0db8 \u0db8\u0dcf\u0dc3\u0dd2\u0d9a \u0dc0\u0dd0\u0da7\u0dd4\u0dbb \u0d9a\u0db1\u0db7 \u0db1\u0dd0\u0d9a\u0db6\u0db1\u0dca\u0d9a\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 21,000\u0dba\u0dd2. \u0d9a\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a \u0d85\u0d9a\u0db4\u0dca\u200d\u0dbb\u0dda\u0dca \u0db8\u0dcf\u0db7\u0d9a \u0dc3\u0dd2\u0da7 \u0dd6\u0dbd\u0dbd\u0dd2\u0d9a \u0dc0\u0dd0\u0da7\u0dd4\u0dbb \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 27,000\u0d9a\u0dca \u0d9a\u0dc0\u0db1\u0dc0\u0dcf. 2026 \u0da2\u0dca\u200d\u0db1\u0dc0\u0dcf\u0dd2\u0db4 \u0dc3\u0dd2\u0da7 \u0d92\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 30,000\u0d9a\u0dca \u0d9a\u0dc0\u0db1\u0dc0\u0dcf.\n\n41. \u0dc0\u0dad\u0dd4 \u0d9a\u0dda\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0db8\u0dda \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0db1\u0dd0\u0dc0\u0dcf \u0dc3\u0dbd\u0d9a\u0dcf \u0db6\u0dd0\u0dd3\u0db1\u0db8\n\n\u0d9a\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dba\u0dd3\u0dba\u0dca\u0db1\u0dba \u0db8\u0dad\u0dd4 \u0d9a\u0dc0\u0db1\u0dcf \u0dad\u0dd2\u0d9a\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0db7\u0dca\u0dae\u0dcf\u0dc0\u0dbb\u0dba\u0d9a \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf.\n\n\u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0dc0\u0dc1\u0dba\u0dd3\u0dba\u0d9a\u0dba\u0db1\u0dca \u0d9a\u0dca , \u0dbb\u0db6\u0dbb\u0dca \u0db7\u0dcf \u0d9a\u0dbb\u0ddc\u0dca \u0dba\u0db1 \u0d9a\u0dca\u0d9a\u0dc2\u0dda\u200d\u0dbb\u0dc0\u0db1 \u0db1\u0dd2\u0dba\u0dd0\u0d9a\u0dcf\u0db1 \u0dc0\u0dad\u0dd4 \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1.5\u0d9a\u0da7 \u0d86\u0db7\u0db1\u0dca\u0db1 \u0db7\u0dcf\u0d82 \u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dcf. \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0d9a\u0dda \u0da2\u0dd3\u0dc0\u0db1 \u0dad\u0dca\u0dca \u0dca \u0dc0\u0dba \u0dda\u0db7\u0db7\u0dca \u0d9a\u0dcf \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0 \u0dbb\u0da2\u0dca\u200d\u0d9a \u0d85\u0daf\u0dcf \u0db7\u0dba\u0dd2. \u0dc0\u0dad\u0dd4\u0d9a\u0dbb\u0d9a \u0db7\u0dcf\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0d9a\u0d9a\u0dbb\u0dc4\u0dd2 \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba \u0d9a\u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0dc0\u0dd0\u0da9\u0db7\u0da7\u0dcf \u0db1\u0dca\u0dc0\u0db1\u0da7 \u0d85\u0db8\u0dad\u0dca\u0dbb\u0dc0 \u0daf\u0dd0\u0db1\u0da7 \u0d9a\u0dba\u0ddd\u0dd2\u0dad\u0dad\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 1,700\u0d9a\n\n\u0dc0\u0dd0\u0da7\u0dd4\u0dbb \u0db1\u0db6\u0dcf \u0db1\u0db8 \u0dbb\u0da2\u0dca\u200d\u0dba \u0db7\u0dcf \u0dad\u0dd2\u0d9a \u0d9a\u0dbb\u0db1\u0dc0\u0dcf; \u0db8\u0dd0\u0daf\u0dd2\u0dcf \u0dca \u0d9a\u0dc0\u0db1\u0dc0\u0dcf. \u0d9a\u0db8\u0dca\u0d9a \u0db1\u0db6\u0dcf \u0d9a\u0daf\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1.\n\n\u0daf\u0dd0\u0db1\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 1,350\u0dba\u0dd2. 350\u0da7 \u0d87\u0dc0\u0dd2\u0dca \u0db1\u0dcf \u0dad\u0dd2\u0d9a\u0db6\u0db1\u0dc0\u0dcf. \u0daf\u0dd0\u0db1\u0dca \u0db6\u0db1\u0db8\u0dd4 \u0d85\u0db4\u0dd2. \u0d91\u0d9a\u0dcf \u0db8 \u0dad\u0dca\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1.\n\n42. \u0dbb\u0dcf\u0d9c\u0dba \u0d85\u0dcf\u0d82\u0dc1\u0dca\u0db8\u0dda \u0dc0\u0dd2\u0dbb\u0dcf\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca\n\n\u0dc0\u0dd2\u0dbb\u0dcf\u0db8\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0d9a\u0dda \u0dc0\u0dd2\u0dbb\u0dcf\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0dbb \u0d9a\u0db8\u0dca \u0dc0\u0db1 \u0dc0\u0dd2\u0da7\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 3,000\u0d9a\u0dca \u0d85\u0dbb \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0dbb\u0dad\u0dd2\u0dc0\u0dbb\u0dab\u0dba \u0da2\u0dca\u200d\u0dba\u0d9c\u0dca \u0dc0\u0dd2\u0d9c\u0db7\u0db8 \u0dc0\u0dd0\u0da9\u0dd2\u0d9a\u0d9a\u0ddc\u0da7 \u0dad\u0dd2\u0d9a\u0db6\u0db1\u0dc0\u0dcf.\n\n\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 3,000\u0d9a\u0dca \u0daf\u0dd0\u0db1\u0da7\u0db8\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb\u0db1\u0dcf \u0dad\u0dd2\u0d9a\u0db6\u0db1\u0dc0\u0dcf. \u0db1\u0db8\u0dd4\u0dca , 2017.12.31 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0dd2\u0dbb\u0dcf\u0db8 \u0d9c\u0dd2\u0dba \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0db8 \u0dc0\u0dd2\u0dbb\u0dcf\u0db8\u0dd2\u0d9a\u0dba\u0db1\u0dca \u0d91\u0d9a\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dbb\u0dd2\u0db4\u0db8\u0dcf\u0dab\u0dba\u0d9a \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0db6\u0dd0\u0dc0\u0dd2\u0db1\u0dca, 2016-2020 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0dd2\u0dbb\u0dcf\u0db8 \u0d9c\u0dd2\u0dba \u0dbb\u0da2\u0dca\u200d\u0d9a \u0d9a\u0db7\u0dda\u0dc0\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0d9a\u0dda \u0dc0\u0dd2\u0dbb\u0dcf\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dbb\u0db8\u0dab\u0d9a\u0dca \u0db7\u0dcf\u0d82\u0d9a\u0dc1\u0dba\u0dd3\u0dba\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dc0\u0dd2\u0dc2\u0db8\u0dad\u0dca\u0dcf\u0dc0\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dc0\u0db1 \u0db6\u0dc0 \u0d85\u0dbb \u0db1\u0dd2\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0dba \u0d9a\u0dcf\u0dcf.\n\n\u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9a\u0db1\u0dca, \u0dc0\u0dd2\u0dc1\u0dba\u0dd3\u0dba\u0dcf\u0db1 \u0d9a\u0db1\u0db7 \u0d9a\u0db8\u0dca 2016-2020 \u0d9a\u0dcf\u0db1\u0d9a \u0dc0\u0dd2\u0dbb\u0dcf\u0db8 \u0d9c\u0dd2\u0dba \u0d85\u0dba\u0d9a\u0dda \u0daf\u0dd4\u0d9a\u0dca\u0d9c\u0dd0\u0db1\u0dc0\u0dd2\u0dca \u0db1\u0d9a\u0dca \u0dad\u0dd2\u0d9a\u0db6\u0db1\u0dc0\u0dcf. \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7, \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf\u0d9a\u0dda \u0da0\u0d9a\u0dca\u200d\u0dbb\u0d9a\u0dca \u0dba\u0d9a\u0dd4\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf. \u0d92 \u0da0\u0d9a\u0dca\u200d\u0dbb\u0d9a\u0dca \u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0d92 \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dc0\u0dd0\u0da9\u0dd2\u0dc0\u0dd3\u0db8 \u0dc3\u0dd2 \u0db0 \u0dc0\u0dd4\u0d9a\u0dab\u0dca \u0db1\u0dd0\u0dcf \u0dd0. [\u0db6\u0dcf\u0db0\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dca]"
