    "chunk_text": "\u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0d85\u0db4\u0dd2\u0da7 \u0d86\u0dba\u0ddc\u0d82\u0dd2 \u0dc0\u0dd4\u0da7\u0dcf \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dca\u0dad\u0dd2\u0dba \u0dd4\u0dc5 \u0db7\u0dcf\u0dab\u0dca\u0da9\u0da9 \u0db1\u0dd0\u0dda 30\u0d9a\u0dca \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0d86\u0db4\u0dc3\u0dd4 \u0dc4\u0dd0\u0db4\u0dad\u0dbd\u0dcf \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db69. \u0db7\u0dcf\u0dab\u0dca\u0da9\u0da9 \u0db1\u0dd0\u0dda 30\u0d9a\u0dca! \u0d91\u0dd9 \u0db1\u0dd09\u0dd2\u0dbb\u0db1\u0dca \u0daf9\u0dca\u0dd9\u0da7 \u0dc1\u0da9\u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0dbd\u0d9a\u0dca\u0dc2\u0dba\u0d9a\u0dca \u0db4\u0dcf\u0dd4 \u0dc19\u0db19\u0dcf. \u0d92 \u0dd2\u0dbb\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0da9\u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0dbd\u0d9a\u0dca\u0dc2 30\u0d9a\u0dca \u0d92 \u0db1\u0dd0\u0dda 30\u0db1\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd49\u0da7 \u0d91\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d86\u0daf\u0dcf\u0dba\u0db8 \u0d85\u0dc4\u0dd2\u0db8\u0dd2 \u0dc19\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db19\u0dcf. \u0d85\u0db4\u0dd2 \u0dc0 \u0db4\u0dd2\u0dba\u0dbd\u0dca9\u0dd2\u0db1\u0dca \u0db6\u0dd0\u0dbd\u0dd4\u0dc19\u0dcf\u0dad\u0dca \u0dc0 \u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dbd\u0d9a\u0dca\u0dc2 700\u0d9a\u0dca \u0dba\u0da2\u0dba\u0da7 \u0dbd\u0dd0\u0dc1\u0db6\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d86\u0daf\u0dcf\u0dba\u0db8 \u0db1\u0dd0\u0dad\u0dd2 \u0dd9\u0dba \u0d9c\u0dad\u0dca\u0dad\u0dcf. \u0d92 \u0dd9\u0dcf\u0dc1\u0dda 9\u0dd0\u0dbb\u0dd0\u0dda\u0dc1\u0daf\u0db1\u0dca\u0daf? \u0dd9\u0dc0\u0dd4\u0daf \u0d92\u0dd9\u0da7 9\u0d9c\u0dd2\u0dbb\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0d92\u0dd9\u0da7 9\u0d9c\u0dd2\u0dbb\u0dba\u0db1\u0dca\u0db1 \u0dd9\u0dc0\u0dd4\u0dc0 9\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d91\u0dad\u0dc1\u0dd9\u0dcf\u0da7 \u0d92 \u0dc19\u0db1 \u0db4\u0dcf\u0dd4 \u0d94\u0d9a\u0dca\u0dc1\u0dd9\u0ddd\u0db8 \u0d85\u0db1\u0dca\u0dad\u0dd2\u0db8\u0da7 \u0dc1\u0db8\u0dca \u0dba\u0dc1\u0da7\u0dca \u0dd2\u0db1\u0dca\u0db1 \u0da2\u0db1\u0dad\u0dcf9\u0da7 \u0db7\u0dcf\u0dab\u0dca\u0da9\u0da9 \u0d9c\u0db1\u0dca\u0db1\u0dc1\u0dd9\u0dcf\u0da7 \u0dc1\u0d9c9\u0db1\u0dca\u0db1 \u0dc19\u0db19\u0dcf.\n\n\u0d9c\u0dc0 \u0dd2\u0d9a\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0dd9\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0dd9\u0dd4\u0db8\u0dd2\u0d9a \u0d8a\u0dc1\u0daf containers 313\u0d9a\u0dca \u0d91\u0dc5\u0dd2\u0dba\u0da7 \u0d9c\u0dd2\u0dba\u0dcf \u0dd2\u0dbb\u0dba\u0dbd\u0dcf \u0dd2\u0dbb\u0dda9\u0dcf. \u0db8\u0db8 \u0daf\u0dd0\u0d9a\u0dca\u0dd9\u0dcf \u0d8a\u0dc1\u0daf \u0dd2\u0d9a\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc1\u0dda\u0daf\u0dd3 \u0dd2\u0dbb\u0dba\u0db19\u0dcf \u0d92 \u0dca\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0da7 \u0dd9\u0dba\u0db19\u0dcf\n\n\u0d9c\u0dc0 \u0dd2\u0d9a\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0dd9\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0dd9\u0dd4\u0db8\u0dd2\u0d9a \u0d8a\u0dc5\u0d9f\u0da7 \u0dc4\u0dcf\u0dbd\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dca\u200d\u0dbb \u0dda\u0db1\u0dba \u0db6\u0dbd\u0db1\u0dca\u0db1. \u0dc4\u0dcf\u0dbd\u0dca \u0dca\u200d\u0dbb \u0dda\u0db1\u0dba \u0daf\u0dd0\u0db1\u0dca \u0d8b\u0d9c\u0dca\u200d\u0dbb \u0dc19\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db19\u0dcf. \u0daf\u0dd0\u0db1\u0dca \u0db1\u0dcf\u0dd4 \u0dc4\u0dcf\u0dbd\u0dca \u0dd2\u0dbb\u0dc1\u0dbd\u0ddd9\u0d9a\u0dca \u0dc0 \u0db4\u0dd2\u0dba\u0dbd\u0dca 160\u0db1\u0dca \u0dd2\u0dbb\u0dba\u0db19\u0dcf. \u0d8a\u0dc1\u0daf \u0dc3\u0dd2\u0dba\u0dca \u0db1\u0dcf\u0dc5\u0dd2\u0dd9\u0dcf\u0dc1\u0dda \u0dca\u0da7\u0db1 9\u0dd0\u0da9\u0dca\u0da7\u0dc4\u0db1\u0da7 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dcf\u0db8 \u0dd2\u0dbb\u0dba\u0db19\u0dcf \u0db8\u0db8 \u0daf\u0dd0\u0d9a\u0dca\u0dd9\u0dcf \u0dba\u0dd4 \u0dc4\u0dcf\u0dbd\u0dca \u0dd2\u0dbb\u0dc1\u0dbd\u0ddd9\u0d9a\u0dca \u0daf\u0dd4\u0dad\u0dab\u0dd4 \u0db4\u0dc5\u0dcf\u0dc1\u0dad\u0dca \u0dc0\u0dd2\u0dd4\u0dad\u0da7\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc0 \u0db4\u0dd2\u0dba\u0dbd\u0dca 160\u0da7 180\u0da7 \u0dd2\u0dbb\u0dba\u0dbd\u0dcf. \u0daf\u0dd0\u0db1\u0dca \u0dba\u0dd4 \u0dc4\u0dcf\u0dbd\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0dd9\u0dcf\u0dc5\u0db9 \u0dca\u200d\u0dbb\u0dc1\u0dda \u0dc1\u0daf \u0db1\u0dcf\u0dd4 \u0dc4\u0dcf\u0dbd\u0dca \u0dd2\u0dbb\u0dc1\u0dbd\u0ddd9\u0d9a\u0dca \u0dc0\u0dd2\u0dd4\u0dad\u0da7\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc0 \u0db4\u0dd2\u0dba\u0dbd\u0dca 160\u0da7. \u0dba\u0dd4 \u0dca\u0db8\u0dca\u0db6\u0dcf \u0dd2\u0dbb\u0dba\u0dbd\u0dcf 9\u0dbb\u0dca\u0dbd\u0d9c\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0dd4\u0dad\u0da7\u0db19\u0dcf \u0dd2\u0dbb\u0dc1\u0dbd\u0ddd9 \u0dc0 \u0db4\u0dd2\u0dba\u0dbd\u0dca 310\u0da7. \u0dc1\u0db8\u0dcf\u0dd9\u0d9a\u0dca\u0daf \u0dc1\u0db8\u0dca \u0dc19\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0db4\u0dca\u0dda 9\u0dad\u0dcf9\u0d9a\u0dca \u0dc4\u0dcf\u0dbd\u0dca \u0dc1\u0db8\u0ddd\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0dba\u0db1\u0dca \u0d91\u0d9a\u0dca\u0dd9 \u0dc1\u0db8\u0dca \u0dca\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0dca\u0dcf\u0dd9\u0da0\u0dca\u0da1\u0dcf \u0dd9\u0dc5\u0dcf. \u0d91\u0dc1\u0dc4\u0db8 \u0dca\u0dcf\u0dd9\u0da0\u0dca\u0da1\u0dcf \u0dd9\u0dba\u0dbd\u0dcf \u0db4\u0dcf\u0db4\u0dad\u0dc1\u0db7\u0ddd\u0d9c\u0dd2\u0dd9 \u0dd9\u0da7\u0dba\u0dd4\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0db0\u0dd2\u0dd9\u0dcf\u0db4\u0dad\u0dc1\u0daf \u0dd2\u0d9a\u0dc1\u0dba\u0ddd\u0da2\u0dd2\u0dad\u0dc1\u0dba\u0d9a\u0dca \u0daf\u0dd0\u0db8\u0dca\u0db8\u0dcf \u0d92\u0dc1\u0d9c\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca \u0dc4\u0db4\u0dad\u0dba\u0da7 \u0dc4\u0dcf\u0dbd\u0dca \u0da7\u0dd2\u0dd9 \u0d91\u0dc5\u0dd2\u0dba\u0da7 \u0daf\u0db8\u0db19\u0dcf\u0daf \u0db6\u0dbd\u0db1\u0dca\u0db1. \u0dc1\u0db8\u0dcf\u0dd9\u0daf \u0dc0\u0dd4\u0dc1\u0dab\u0dca\u0da9? \u0d91\u0dc1\u0dc4\u0db8 \u0dd2\u0d9a\u0dc1\u0dba\u0ddd\u0da2\u0dd2\u0dad\u0dc1\u0dba\u0d9a\u0dca \u0daf\u0db8\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd2\u0dba\u0daf\u0dd3 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0dc1\u0db4\u0dc1\u0dbb\u0dca\u0dbd\u0daf\u0dcf \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0dd2\u0dbb\u0dba\u0db19\u0dcf \u0d85\u0db4\u0dd2 \u0d8a\u0dc5\u0d9f 9\u0dad\u0dcf\u0dc1\u0dda \u0dc4\u0db8\u0dd4\u0daf\u0dcf9 \u0daf\u0db8\u0db19\u0dcf \u0dd2\u0dbb\u0dba\u0dbd\u0dcf. \u0dc4\u0db8\u0dd4\u0daf\u0dcf9 \u0daf\u0db8\u0db1\u0dca\u0db1 \u0dd9\u0dd2\u0db1\u0dca \u0db4\u0dcf\u0db4\u0dad\u0dc1\u0db7\u0ddd\u0d9c\u0dd2\u0dd9 \u0dd9\u0da7\u0dba\u0dd4\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0db0\u0dd2\u0dd9\u0dcf\u0db4\u0dad\u0dc1\u0daf \u0dd2\u0d9a\u0dbd\u0db0\u0dcf\u0db4\u0dad\u0dc1\u0dba\u0d9a\u0dca \u0daf\u0dd0\u0db8\u0dca\u0db8\u0dcf \u0dc1\u0db1\u0dca. \u0daf\u0dd0\u0db1\u0dca \u0d92 9\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf9 \u0dc1\u0dd9\u0ddd? \u0d92 \u0dd2\u0d9a\u0dbd\u0db0\u0dcf\u0db4\u0dad\u0db1\u0dca \u0dc4\u0db4\u0dad\u0dba\u0da7 \u0db6\u0dd0\u0dbd\u0dd49\u0dcf\u0daf \u0dc0\u0dd3 \u0dc1\u0db8\u0ddd\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0dba\u0db1\u0dca \u0dc4\u0dcf\u0dbd\u0dca \u0da7\u0dd2\u0dd9 \u0d919\u0db19\u0dcf\u0daf \u0dd2\u0dbb\u0dba\u0dbd\u0dcf. \u0db1\u0dd0\u0dc4\u0dd0."
  },
