d82\u0dd2\u0db1\u0dca\u0dc3\u0dcf\u0d9a \u0d86 \u0dad\u0db1 \u0da7 \u0d85:\u0dc1\u0dc5 \u0dd4\u0dc0\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2\u0db6 \u0db1 2.3\u0d9a\u0dca; \u0dc1\u0d9a\u0ddd\u0da7\u0dd2 238\u0d9a\u0dca \u0dc1\u0d9c \u0dc1 \u0dad\u0dd2\u0dc1\u0dbd\u0db1 \u0dc1. \u0dc1\u0db8 \u0d92 \u0dc1\u0d9c\u0dc1\u0dbd\u0dca\u0d82\u0db1\u0dca\u0dc1\u0dda \u0dab \u0dc1\u0d9c\u0dd3\u0db8\u0db8\u0da7 \u0dd2\u0daf\u0dad\u0dbb\u0dd2. \u0dbb\u0da2\u0dc1\u0dda \u0dbd\u0dd0\u0d9a\u0d9a\u0dd4 \u0d82\u0da7 \u0dad\u0db8\u0dd2 \u0dc1\u0d9c \u0d82\u0dc1 \u0dad\u0dd2\u0dc1\u0dbd\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dad\u0db8\u0db1\u0dca\u0dc1\u0dda \u0dc1\u0d9a\u0dc1\u0da7\u0dc3\u0dcf \u0dd2\u0daf\u0db0\u0dd2 \u0da7 \u0db8\u0dc4\u0da2\u0db1 \u0dbd\u0dd0\u0d9a\u0d9a\u0dd4 \u0da7 \u0d92\u0dc1\u0d9a\u0db1\u0dca \u0dc3\u0dd2 \u0da7 50\u0d9a\u0dca \u0d82\u0dd0\u0dc1\u0dbd\u0db1 \u0dc1. \u0dc1\u0db8\u0dc1\u0dc3\u0dcf\u0d9a \u0db4\u0dc1\u0dca \u0d82\u0dbd\u0db1 \u0d86 \u0dad\u0db1 \u0d82\u0da7 \u0d86\u0dca\u0dca\u0dc1 \u0db1\u0dca \u0dd4 :\u0dbd\u0dca \u0dc1 \u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd4 \u0dc1\u0dca \u0dd4 :\u0dbd\u0dca \u0db4\u0dc1\u0dd2\u0daf\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dbd\u0dd0\u0dbb\u0dd2:, \u0d85\u0dca \u0dc1\u0db4\u0dc1\u0dd2\u0db6 \u0da7 \u0dab \u0d82\u0dbd\u0dc1 \u0daf\u0dd3\u0db8 \u0dc3\u0dcf \u0dc4\u0dc1? \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0dc1\u0dd2, \u0db8\u0db8\u0dd2 Public Finance Committee \u0d91\u0dc1\u0d9a\u0dca \u0dc3\u0dcf\u0dc1\u0db8\u0dc1\u0da2\u0dd2\u0d9a \u0db1\u0dca \u0dc1\u0d82\u0dc3\u0dcf \u0d89\u0db1\u0dca\u0db1 \u0dc1. \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0db1\u0dca\u0d82\u0dc1\u0da7 \u0d86\u0dca\u0dca \u0dc1 \u0db1\u0dca monetary policies \u0d9c\u0dd0\u0db1 \u0dd3\u0dbb\u0dbb\u0dab \u0d9c\u0db1\u0dca\u0db1 \u0dbd\u0dd0\u0dc4\u0dd0. \u0d92 \u0dc1 \u0db8\u0dc4 \u0dbd\u0dd0\u0d9a\u0d9a\u0dd4\u0dc1 \u0db1\u0dca \u0dad\u0db8\u0dd2 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf\u0dc1 \u0dad\u0db8\u0dd2 \u0db8\u0db8 \u0db8\u0dd3\u0da7 \u0dc1\u0db4\u0dbb \u0d85\u0dbb \u0db4\u0dca\u200d\u0dbb \u0d9a\u0db1 \u0d87\u0dc4\u0dd4\u0dc1\u0dda. \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0db1\u0dca\u0d82\u0dc1 \u0dbb\u0da2 \u0d9a\u0dca \u0dc1 \u0db1\u0dca \u0dd3\u0dbb\u0db1\u0dca\u0dd4\u0dbd \u0d9c\u0db1\u0dca\u0db1 \u0d85 \u0dba\u0dd2, \u0dc1\u0db8 \u0dd0\u0db1\u0dd2 \u0dd2\u0daf :\u0dca :\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd4 \u0dc3\u0dd4\u0dc0\u0db1 \u0dc4\u0dc1 \u0db8\u0db0\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dc1\u0dab \u0dba\u0dc1\u0db4\u0dc1\u0dbb\u0dd2\u0d9a \u0db1\u0dca\u0da7 \u0dc3\u0dcf\u0dc4 \u0dba \u0dc3\u0dcf\u0dc1 \u0d9a \u0db1\u0dca\u0da7 \u0d85\u0dca \u0dc1\u0db4\u0dc1\u0dd2\u0db6 \u0da7 \u0dab \u0dc1:\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc0\u0db1 \u0db1\u0dca \u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0d9a\u0dc1\u0dc1\u0dc4\u0dc1\u0db8: \u0d9a\u0dd2 \u0db1 \u0d9a\u0dc1\u0dbb\u0dab \u0dc3\u0dcf\u0dca \u0dbd\u0db1\u0dca\u0db0\u0dc1 \u0db1\u0dca."
