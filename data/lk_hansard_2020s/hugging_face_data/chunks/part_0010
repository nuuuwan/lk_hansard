    "chunk_text": "\u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0dda \u0dc3\u0d9a\u0dc3\u0dc0 \u0d9a\u0dd2\u0dd3\u0db8\u0dc1\u0dda \u0d85\u0daf\u0dd2\u0dba\u0dbb 2017 \u0dc0\u0dbb\u0dca\u0dc2\u0dc1\u0dda\u0daf\u0dd3 \u0d86\u0dbb\u0dda\u0db7 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0dad\u0dbb, \u0d9c\u0dca\u200d\u0dbb\u0dcf \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dc1\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dba \u0db4\u0daf\u0db1\u0dda \u0d9a\u0dbb\u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0db8\u0dd4\u0dc5\u0dd4 \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1 \"\u0dc3\u0d82\u0d9c\u0dab\u0db1 \u0d9a\u0dcf\u0dab\u0dca\u0dc3\" \u0dc1\u0dbd\u0dc3 \u0db3\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0db3\u0db1 \u0d9a\u0dd4\u0dc3\u0dcf \u0dc1\u0d9a\u0ddc\u0da7\u0dc3\u0dc0\u0dc0\u0dbd\u0da7 \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3. \u0dc1 \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0dda \u0dc3\u0d9a\u0dc3\u0dc0 \u0d9a\u0dd2\u0dd3\u0db8\u0dc1\u0dda \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dba 2020 \u0dc0\u0dbb\u0dca\u0dc2\u0dc1\u0dda\u0daf\u0dd3 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc0\u0dd6 \u0d85\u0dad\u0dbb \u0db8\u0dd4\u0dc5\u0dd4 \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1 \u0dc3\u0d82\u0d9c\u0dab\u0db1 \u0d9a\u0dcf\u0dab\u0dca\u0dc3 88,000\u0d9a\u0da7 \u0db4 \u0dab \u0dc1\u0dc0\u0db1\u0dca\u0dc0 \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0dda\u0d9c\u0dad \u0d9a\u0dbb \u0d87\u0dad. \u0dc1\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0dc1 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dc3\u0d82\u0d9c\u0dab\u0db1 \u0d9a\u0dcf\u0dab\u0dca\u0dc3 \u0d87\u0dad\u0dd4\u0dc5\u0dca\u0dad \u0db7\u0dd6\u0dc1\u0d9c\u0ddd\u0dbd\u0dd3\u0dba \u0daf\u0dca\u0dad\u0dad \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0dc3\u0d9a\u0dc3\u0dc0 \u0dc1\u0d9a\u0ddc\u0da7 \u0d87\u0dad.\n\n\u0dc3\u0d82\u0d9c\u0dab\u0db1\u0dc1\u0dba\u0dc4\u0dd2 \u0dad\u0dd4\u0db1\u0dca\u0dc0\u0db1 \u0d85\u0daf\u0dd2\u0dba\u0dbb \u0dc0\u0db1 \u0d9c\u0dab\u0db1\u0dca \u0d9c\u0dc3\u0db1\u0dd3\u0dc1\u0dda \u0d85\u0daf\u0dd2\u0dba\u0dbb 2024 \u0d94\u0d9a\u0dca\u0dc1\u0dad\u0ddd\u0db3\u0dbb\u0dca \u0dcf\u0dc3\u0dc1\u0dda\u0daf\u0dd3 \u0d86\u0dbb\u0dda\u0db7 \u0dc0\u0dd2\u0dba. \u0dc1\u0d9c\u0ddc\u0dc3\u0db1\u0dc3\u0d9f\u0dd2\u0dbd\u0dd2 \u0d92\u0d9a\u0d9a\u0dc0\u0dbd \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dc3\u0dcf \u0dcf\u0db1\u0dba \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dba\u0db1\u0dca\u0dc1\u0dda \u0da2\u0dd3\u0dc0 \u0daf\u0dca\u0dad\u0dad \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4, \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dba, \u0dc3\u0dcf\u0d9a\u0dca\u0dc2\u0dbb\u0dad\u0dcf\u0dc0, \u0d9a\u0dcf\u0dba\u0dd2\u0d9a \u0dcf \u0dcf\u0db1\u0dc3\u0dd2\u0d9a\u0dca\u0dad\u0dc0\u0dba\u0db1\u0dca, \u0dc3\u0d82\u0d9a\u0dca\u200d\u0dbb \u0dab\u0dd2\u0d9a \u0dad\u0dca\u0dad\u0dca\u0dad\u0dc0\u0dba\u0db1\u0dca \u0d86\u0daf\u0dd3 \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dbb\u0dd0\u0dc3\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dba\u0dcf\u0dc1\u0d9c\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0dc0 \u0dbd\u0db3\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dc1 \u0d85\u0daf\u0dd2\u0dba\u0dc1\u0dbb\u0dca\u0daf\u0dd3, \u0d8a\u0da7 \u0d85 \u0dad\u0dbb\u0dc0 \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0d92\u0d9a\u0d9a \u0dc3\u0d9a\u0dc3\u0dc0 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0daf\u0dca\u200d\u0dbb\u0dc0\u0dba, \u0d86 \u0dcf\u0dbb \u0dc3\u0d9a\u0dc3\u0dc0 \u0d9a\u0dd2\u0dd3\u0db8 \u0da7 \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db3\u0db1 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0dc0\u0dbb\u0dca\u0d9c, \u0dc3\u0db1\u0dd3\u0db4\u0dcf\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0db4 \u0dd4\u0db8\u0d9a\u0dda \u0dc0\u0dc3\u0db1\u0dd2 \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dbb\u0dcf\u0dc1\u0dd2\u0dba\u0d9a\u0dca \u0dbd\u0db3\u0dcf \u0d9c\u0dc3\u0dc1\u0db1\u0dca.\n\n2024 \u0d94\u0d9a\u0dca\u0dc1\u0dad\u0ddd\u0db3\u0dbb\u0dca \u0dc3 07 \u0daf\u0dd2\u0db1 \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dbb\u0dd0\u0dc3\u0dc0 \u0d9a\u0dd2\u0dd3\u0db8\u0dc1\u0dda \u0d9a\u0dca\u0dc1\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d86\u0dbb\u0dda\u0db7 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0dad\u0dbb, 2024 \u0dc1\u0daf\u0dc3\u0dc3\u0dda\u0db3\u0dbb\u0dca \u0dc3 19 \u0daf\u0dd2\u0db1 \"\u0dc3\u0d82\u0d9c\u0dab\u0db1 \u0daf\u0dd2\u0db1\u0dba\" \u0dc1\u0dbd\u0dc3 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf \u0dba\u0da7 \u0db4\u0dca\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3. 2024 \u0dc1\u0db1\u0ddc\u0dc0\u0dc3\u0dda\u0db3\u0dbb\u0dca \u0dc3 26 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0daf\u0dd2\u0db1 \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0db4\u0dc3\u0dc0\u0dad\u0dd2 \u0d85\u0db0\u0dd2\u0d9a \u0dd4\u0db8\u0dc5\u0d82 \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dbb\u0dca\u0dc2\u0dcf\u0dc0 \u0dcf \u0d87\u0dad\u0dc3\u0dda \u0daf\u0dd2\u0dc3\u0dc0\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a \u0d9c\u0d82\u0dc0\u0dad\u0dd4\u0dbb \u0dad\u0dca\u0dad\u0dca\u0dad\u0dc0\u0dba\u0d9a\u0da7 \u0db8\u0dd4\u0dc4\u0dd4\u0dab\u0daf\u0dd3 \u0daf \u0d9c\u0dab\u0db1\u0dca \u0d9c\u0dc3\u0db1\u0dd3\u0dc1\u0dda \u0d85\u0daf\u0dd2\u0dba\u0dc1\u0dbb\u0dc4\u0dd2 \u0d9a\u0dca\u0dc1\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0daf \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3. \u0d91\u0dc1\u0dc3\u0dda \u0dc0\u0dd4\u0dc0\u0daf, \u0dc3\u0dc3\u0dbd\u0dd4\u0db8\u0dda \u0d9a\u0dc5 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 2024 \u0dc1\u0daf\u0dc3\u0dc3\u0dda\u0db3\u0dbb\u0dca \u0dc3 18 \u0daf\u0dd2\u0db1 \u0dbb\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dd2 \u0d9a\u0dcf\u0dbd\u0dc1\u0dda \u0db8\u0dd4\u0dc5\u0dd4 \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1 \u0d86\u0dc0\u0dbb\u0dab\u0dba \u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc4\u0dd2\u0dc3\u0da7 \u0dc0 \u0dbd\u0d9a\u0dca \u0dc1\u0db1\u0ddc \u0dc3\u0dad\u0dd2 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dba\u0db1\u0dca \u0d9c\u0dab\u0db1\u0dca \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dbd\u0daf\u0dd3.\n\n\u0daf\u0dd2\u0dc3\u0dc0\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a 23\u0d9a \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dbb\u0dd0\u0dc3\u0dc0 \u0d9a\u0dd2\u0dd3\u0db8\u0dc1\u0dda \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dc3\u0dbd\u0dd4\u0db8\u0dda \u0d9a\u0dc5 \u0daf\u0dd2\u0db1\u0da7 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc0\u0dd6 \u0d85\u0dad\u0dbb, \u0d91 \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dc1\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dc1\u0dda \u0dc3\u0dc0\u0dae\u0dcf\u0db4\u0dd2\u0dad \u0dc3\u0dbb\u0dca\u0dc0\u0dbb\u0dca \u0db4\u0dbb\u0dd2\u0d9c\u0dab\u0d9a \u0dc1\u0dc0\u0dad \u0dbd\u0dc3\u0dd3 \u0d87\u0dad. \u0dc1\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0daf\u0dca\u0dad\u0dad \u0db4\u0dd3\u0db8\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dd2\u0dd3\u0db8\u0dc1\u0dda \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dd2\u0db1\u0dca \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd3. \u0d9c\u0dab\u0db1\u0dca \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dc1\u0dda \u0dc4\u0dd2\u0d9f\u0dba, \u0daf\u0dd2\u0dc0\u0dcf \u0d9a\u0dcf\u0dbd\u0dc1\u0dda\u0daf\u0dd3 \u0dc1\u0db3\u0ddc\u0dc1 \u0ddc \u0dba\u0d9a\u0dca \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0dc0\u0dc3\u0dcf \u0dad\u0dc3\u0dd3 , \u0dd4\u0db8\u0db4\u0dd2\u0dbb\u0dd2 \u0dbd\u0dca \u0db1\u0dd2\u0dc0\u0dcf\u0dc3\u0dc0\u0dbd\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dd2 \u0dc0\u0da7\u0dc0\u0dd3\u0dc1\u0dda \u0d85\u0db4 \u0dd4\u0db8\u0dc0 \u0dc0\u0dc3\u0db1\u0dd2 \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dad, \u0db4\u0dca\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9c\u0dab\u0db1\u0dca \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0d9c\u0dab\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dad\u0dbb \u0d9c\u0daf\u0dd3 \u0d89\u0dc0\u0dca\u0dad \u0dc0\u0dd3 \u0db1\u0dd2\u0dc3\u0dcf \u0dc1\u0d9a\u0ddc\u0dc5\u0db9 \u0dc3 \u0d9c\u0dda\u0db4 \u0dc0\u0dc3\u0db1\u0dd2 \u0dad\u0daf\u0dcf\u0dc3\u0db1\u0dca\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0daf\u0dca \u0dba\u0db1\u0dca\u0dc4\u0dd2 \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dbb\u0dd0\u0dc3\u0dc0 \u0d9a\u0dd2\u0dd3\u0db8\u0dc1\u0dda \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dbd \u0dba\u0dda \u0db4\u0dca\u200d\u0dbb \u0dcf\u0daf\u0dba\u0d9a\u0dca \u0dc3\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0dba. \u0d91 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0daf\u0dca \u0dba\u0db1\u0dca\u0dc4\u0dd2 \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dbb\u0dd0\u0dc3\u0dc0 \u0d9a\u0dd2\u0dd3\u0db8 \u0dc3\u0d82\u0d9c\u0dab\u0db1 \u0daf\u0dd2\u0db1\u0dba \u0d86\u0dbb\u0dda\u0db7 \u0dc0\u0db1 \u0dc1 \u0ddc\u0dc1 \u0ddc\u0dad \u0db4\u0daf\u0db1\u0dda \u0d9a\u0dbb \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca -\u0d91\u0db1\u0dda, 2024 \u0dc1\u0daf\u0dc3\u0dc3\u0dda\u0db3\u0dbb\u0dca \u0dc3 19 \u0daf\u0dd2\u0db1 00:00\u0da7- \u0dc3\u0dd2\u0db1\u0dca \u0d9a\u0dd2\u0dd3\u0db8 \u0dc3 \u0dcf \u0dc1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca, \u0daf\u0dd2\u0dc3\u0dc0\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dcf \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dc1\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db1\u0dba \u0dcf \u0d91\u0d9a\u0dca\u0dc0 \u0d9a\u0da9\u0dd2\u0db1\u0dda \u0db4\u0dd2\u0dba\u0dc0\u0dbb \u0d9c\u0dc3\u0db1\u0dd3 \u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd3."
  },
