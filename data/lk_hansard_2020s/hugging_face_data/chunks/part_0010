    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7 \u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dc1 medical insurance \u0d91\u0d9a\u0d9a\u0dca \u0d9c\u0dd0\u0db1\u0dad\u0dca \u0d85\u0dba \u0d9a\u0dd2\u0daf\u0dc0\u0dcf. \u0dc1\u0db8\u0dca\u0dc0\u0dcf\u0da7 \u0dad\u0db8\u0dc0\u0dba\u0dd2 \u0db4\u0dd0\u0db1 \u0db4\u0dd0\u0db1 \u0dc1\u0db6\u0ddc\u0dbb\u0dd4 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dc0\u0db1\u0dd2. 0224\u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0db4\u0dcf\u0dca\u0dc2\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc1\u0daf \u0dc3\u0da7\u0dd2 \u0d9a\u0dcf\u0dbd\u0dc1\u0dda\u0daf\u0dd3\u0dad\u0dca \u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0dc1\u0dba\u0db1 \u0dc1\u0db8\u0dca medical insurance \u0d91\u0d9a \u0d85\u0db4\u0da7\u0dad\u0dca \u0dbd\u0dd0\u0db6\u0dd4\u0dba\u0dcf. \u0d91\u0dad\u0dc1\u0d9a\u0ddc\u0da7 \u0dc1\u0db8\u0dc0\u0dc4\u0dd2 \u0dc0\u0da7\u0dd2\u0db1\u0dcf\u0d9a\u0db8\u0dc0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca\u0daf \u0dbd\u0d9a\u0dca\u0dc2 0\u0dba\u0dd2. \u0dc1\u0db8\u0dca\u0d9a \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dc1\u0dc5\u0dda 0203.28.02\u0dc1\u0dc0\u0db1\u0dd2 \u0dba\u0dcf. \u0dc4\u0dd0\u0db8\u0dc0 \u0d85\u0dd4\u0db1\u0dbb\u0dd4 \u0dba\u0d9a\u0dca \u0db4\u0dcf\u0dc3\u0dcf\u0db8\u0dc0 \u0dc1\u0db8\u0dca insurance \u0d91\u0d9a \u0daf\u0dc3\u0dca\u0dc3\u0dbb\u0dc4\u0da7 \u0dba\u0db1\u0dc0\u0dcf. 0203.28.02\u0dc1\u0dc0\u0db1\u0dd2 \u0dba\u0dcf \u0dad\u0db8\u0dc0\u0dba\u0dd2 \u0dc1\u0db8\u0dca\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca\u0daf \u0dbd\u0d9a\u0dca\u0dc2 12 \u0dba\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dc1\u0dc5\u0dda. 0203.28.02\u0dc1\u0dc0\u0db1\u0dd2 \u0dba\u0dcf \u0d92 \u0db8\u0dd4\u0dba\u0dbd \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca\u0daf \u0dbd\u0d9a\u0dca\u0dc2 12\u0d9a\u0dca \u0d9a\u0dc5\u0dcf\u0db8\u0dc0 0204.28.02\u0dc1\u0dc0\u0db1\u0dd2 \u0dba\u0dcf \u0dba\u0d9a\u0dca\u0dc0\u0dcf \u0d92\u0d9a \u0db6\u0dbd\u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0d9a\u0dca\u0dc2\u0dba \u0dc3\u0d82\u0dc3\u0dca\u0dcf\u0dcf\u0dc1\u0dc0\u0db1\u0dca \u0dad\u0db8\u0dc0\u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0dbb\u0d9a\u0dca\u0dc2\u0dba\u0dba \u0dbd\u0db6\u0dcf \u0dc1\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca. 0204.28.02\u0dc1\u0dc0\u0db1\u0dd2 \u0dba\u0dcf \u0dc1\u0db8\u0dca \u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca 005\u0dc1\u0dba\u0db1\u0dcf\u0db8\u0dc0 insure \u0d9a\u0dc5\u0dcf\u0db8\u0dc0 \u0d92\u0d9a 0205.28.02\u0dc1\u0dc0\u0db1\u0dd2 \u0dba\u0dcf \u0dc1\u0dc0\u0db1\u0d9a\u0dca\u0daf \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dc0\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db4\u0dcf\u0dca\u0dc2\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca 005\u0dc1\u0dba\u0db1\u0dcf\u0da7\u0db8\u0dc0 \u0dc1\u0db8\u0dca insurance \u0d91\u0d9a \u0dbd\u0dd0\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda \u0daf\u0db1\u0dca\u0db1 \u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d9c\u0dad\u0dca\u0dad\u0dcf \u0da2\u0dca\u200d\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0dca\u200d\u0db1 \u0db6\u0dbd\u0dc1\u0daf\u0d9c \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0d86\u0dc0\u0dcf\u0db8\u0dc0 \u0dc1\u0db8\u0dca \u0dbb\u0d9a\u0dca\u0dc2\u0dba \u0db8\u0dd4\u0dba\u0dbd \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb\u0d9c\u0dad\u0dca\u0dad\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc1\u0db8\u0dca \u0d85\u0dba \u0db4\u0da7\u0dca\u0da7\u0db4\u0dca\u0daf \u0dc1\u0db6\u0ddc\u0dbb\u0dd4 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0db4\u0dcf\u0dca\u0dc2\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0d87\u0dad\u0dd4\u0dc1\u0dc5\u0dda \u0dc1\u0db6\u0ddc\u0dbb\u0dd4 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc1\u0db6\u0ddc\u0dbb\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dd2\u0dbb\u0db1\u0dcf\u0d9c\u0db1\u0dca\u0db1 \u0dc4\u0dba\u0db1 \u0d91\u0d9a \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dad\u0db8\u0dc0\u0dba\u0dd2 \u0d85\u0db4\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1\u0db8\u0dca \u0dc4\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0db6\u0ddc\u0dbb\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dc0\u0dd0\u0dc5\u0dc1\u0dbd\u0db1\u0dca\u0db1\u0dba\u0dd2."
