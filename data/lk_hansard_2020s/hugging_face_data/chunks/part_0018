    "chunk_text": "\u0d9c\u0dd4\u0dc0\u0db4\u0dbb\u0dcf\u0daf\u0dba\u0daf\u0d9a\u0dbb\u0dd4 \u0dad\u0db1\u0dd2,\u0db4\u0d85\u0dbd\u0dd4\u0dad\u0dca\u0db4\u0db4\u0db1\u0dba\u0dba\u0dad\u0dca\u0db4]]\u0dca \u0db4\u0dc0\u0db8\u0dca\u0db4\u0dc0\u0dc3\u0dcf\u0dbb\u0db4\u0dd4 \u0db4\u0d85\u0dbb\u0dc0\u0d9c\u0dba\u0db4\u0d91\u0dba\u0db4\u0db6\u0dc0\u0da7\u0db4\u0da2\u0dcf\u0dba\u0daf\u0db0\u0dd2\u0db4\u0db1\u0dba\u0dad\u0dd2\u0dc3\u0dc0\u0dbb\u0d9a\u0daf\u0db4\u0dc0\u0db4\u0db1\u0dba\u0daf\u0dc0\u0dbb\u0daf\u0db1\u0dca\u0daf\u0dd4\u0db4\u0dc0\u0dd4 \u0daf.\u0db4\u0dcf\u0dd0\u0db6\u0dd0\u0dd2,\u0db4\u0d94\u0db6\u0dd4 \u0dad\u0daf\u0db4\u0db4\u0dd4\u0daf\u0dd4\u0dad\u0db4\u0dc0\u0dc0\u0dd2,\u0db4\u0d85 \u0db4\u0dc0\u0dc0\u0dba\u0dc0\u0dbb\u0daf\u0da7\u0db4\u0d92\u0db4\u0db4\u0db1\u0dba\u0dba\u0dad\u0dca\u0db4]]\u0db1\u0dca,\u0db4\u0d91\u0dbb\u0db4\u0db4\u0db1\u0dba\u0dba\u0dad\u0dca \u0dc0\u0dad\u0dca\u0db4\u0dc3\u0dcf\u0db8\u0dca\u0dad\u0dad\u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dba\u0db4\u0d85\u0dc3\u0dcf\u0dad\u0dad\u0dca\u0db4\u0dc0\u0dc0\u0daf\u0daf\u0db4\u0dad\u0dd2\u0dc3\u0dc0\u0db6\u0dba\u0dc0\u0daf.\u0db4\u0d91\u0dc0\u0dbb\u0daf \u0dc0\u0dcf\u0db1\u0dca\u0db4\u0db6\u0dd2\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0dd2.\u0db4\u0dc0\u0dc6\u0db1\u0dca\u0db4\u0dc0\u0db1\u0dca ,\u0db4\u0d9c\u0dd4\u0dc0\u0db4\u0dbb\u0dcf\u0daf\u0dba\u0daf\u0d9a\u0dbb\u0dd4 \u0dad\u0db1\u0dd2?\u0db4\u0d92\u0db4\u0dd2\u0dbb\u0d9a\u0db1\u0dca\u0dc0\u0db1\u0dca,\u0db4\u0dbb\u0dc0\u0da7\u0db8\u0db4\u0dca\u0dbb\u0dca\u0dd2\u0dbb\u0d9a\u0db4\u0dc0\u0d9c\u0daf\u0da9\u0dba\u0dd0\u0d9f\u0dd3\u0dad\u0da7\u0db4\u0d85\u0dc0\u0dc1\u0dca\u0dba\u0db4\u0dbb\u0dbb\u0dba\u0db4\u0dc0\u0dba\u0dad\u0dd2\u0dc3\u0dbb\u0db4\u0dc0\u0daf\u0dad\u0daf\u0dc0\u0dbb \u0d9a\u0db4\u0dc3\u0dcf\u0dbb\u0dc3\u0dcf\u0db1\u0db4\u0dd2\u0dbb\u0dd3\u0db8\u0dad\u0db4\u0d8b\u0dc0 \u0dc3\u0dcf\u0daf\u0db4\u0d85\u0dad\u0dba\u0dc0\u0dc1\u0dca\u0dba\u0dc0\u0d9a\u0db1\u0dca\u0dad\u0db4\u0dc0\u0d9c\u0dba\u0db4\u0d92\u0dad\u0da7\u0db4\u0dc0\u0db4\u0db1\u0dba\u0daf\u0dc0\u0dbb\u0daf\u0db1\u0dca\u0daf\u0dd4\u0db4\u0dc0\u0dc0\u0da0\u0dca\u0da0\u0db4\u0db4\u0db1\u0dba\u0dba\u0dad\u0dca\u0db4]]\u0db1\u0dca,\u0db4]\u0dca \u0dc0\u0dad\u0dca\u0db4\u0dc0\u0db8\u0dca\u0db4\u0dc0\u0dc3\u0dcf\u0dbb\u0db4\u0dd4 \u0db4\u0dc3\u0dcf\u0db8\u0dca\u0db8\u0dca\u0dad\u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dba\u0db4\u0db6\u0dd0\u0dbb\u0dd2\u0db4\u0dc0\u0dc0\u0daf\u0daf\u0db4\u0dad\u0dd2\u0dc3\u0dc0\u0db6\u0dba\u0dc0\u0daf.\u0db4\u0d92\u0db4\u0dc0\u0dd2\u0dad\u0dbb\u0dca \u0db4\u0dc0\u0dba\u0daf\u0dc0\u0dc0\u0dd2,\u0db4\u0d92\u0db4\u0db4\u0db1\u0dba\u0dba\u0dad\u0dca\u0db4]]\u0db1\u0dca,\u0db43\u0dca \u0db4\u0d85\u0dad\u0dad\u0dbb\u0db4\u0dbb\u0dbb\u0daf\u0daf,\u0db40\u0dca \u0db4\u0dba\u0dd0\u0dc0\u0dad\u0db4\u0dc0\u0dbb\u0dca \u0db4\u0dc0\u0db8\u0dca\u0db4\u0dc0\u0dc3\u0dcf\u0dbb\u0db4\u0dd4 \u0db4\u0dbb\u0dbb\u0dba\u0dc0\u0daf\u0db4\u0dd2\u0dbb\u0d9a\u0daf\u0daf\u0db4\u0dc0\u0db4\u0db1\u0dba\u0daf\u0dc0\u0dbb\u0daf\u0db1\u0dca\u0daf\u0dd4\u0db4\u0dc0\u0dc0\u0daf\u0daf\u0dad\u0dca\u0db4\u0dad\u0dd2\u0dc3\u0dc0\u0db6\u0dba\u0dc0\u0daf.\u0db4\n\n\u0d9c\u0dd4\u0dc0\u0db4\u0dbb\u0dcf\u0daf\u0dba\u0daf\u0d9a\u0dbb\u0dd4 \u0dad\u0db1\u0dd2,\u0db4\u0d9c\u0dd4\u0dc0\u0db4\u0da2\u0dcf\u0dba\u0daf\u0db0\u0dd2\u0db4\u0db1\u0dba\u0dad\u0dd2\u0dc3\u0dd4 \u0dad\u0daf\u0db4\u0db8\u0dd4 \u0dca\u0db4\u0d87\u0dad\u0dad\u0dd2\u0dc3\u0dd4 \u0dad\u0daf\u0db4\u0dcf\u0dd0\u0dc0\u0dcf\u0d9a\u0da7\u0db4\u0dbb\u0dbb\u0db4\u0dd4\u0db4\u0dbb\u0dcf\u0daf\u0dc0 \u0daf\u0dd3\u0db4\u0d85\u0dca\u0daf\u0dc3\u0dcf\u0db4\u0dcf\u0daf\u0db4\u0daf\u0dd6\u0dc2 \u0d9a\u0db4\u0dad\u0dd0\u0dac\u0dbd\u0dd3\u0db8\u0dad\u0db4\n\n\u0dc3\u0dcf\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dca\u200d\u0dc0\u0d9a\u0db1\u0dca\u0db4\u0dc0\u0daf\u0daf\u0d9a\u0dd4\u0db4\u0db6\u0dbb\u0dca \u0db4\u0daf\u0dd4\u0db1\u0dca\u0dba\u0daf.\u0db4\u0db4\u0db1\u0dba\u0dd0\u0d9a\u0db4\u0dcf\u0dad\u0dbb\u0dcf\u0dad\u0daf\u0dbb\u0dca \u0db4\u0d91\u0dd4 \u0dad\u0daf\u0db4\u0dbb\u0dcf\u0daf\u0db4\u0dbb \u0daf.\u0db4\u0dc0\u0db8\u0dca\u0db4\u0d85\u0d9a\u0db4\u0dc0\u0dd0\u0d9a\u0db4 \u0dca \u0dc2\u0dad\u0db4\u0dbb\u0dd2\u0dbb\u0d9a\u0daf\u0db4\u0dc0\u0dad\u0ddd\u0dbb\u0dba\u0db4\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dc0\u0dbd\u0dd2\u0d9a\u0dca \u0db4\u0dba\u0db8\u0dca,\u0db4\u0d91\u0dd4 \u0dad\u0daf\u0da7\u0db4\u0d92\u0db4\u0dc3\u0dcf\u0db8\u0dca\u0dad\u0daf\u0dba\u0d9a\u0db4\u0dc4\u0dd2\u0db8\u0dd2\u0db4\u0dc0\u0dc0\u0dba\u0dc0\u0daf.\u0db4\u0dba\u0db8\u0dd4\u0dad\u0dca,\u0db4\u0d9c\u0dd4\u0dc0\u0db4\u0dbb\u0dcf\u0daf\u0dba\u0daf\u0d9a\u0dbb\u0dd4 \u0dad\u0db1\u0dd2,\u0db4\u0d85\u0d9a\u0db4\u0dc0\u0dd0\u0d9a\u0db4\u0dd2\u0dbb\u0d9a\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db4 \u0dca \u0dc2\u0dad\u0db4\u0dbb\u0dd2\u0dbb\u0d9a\u0daf\u0db4\u0dc0\u0dad\u0ddd\u0dbb\u0dba\u0db4\u0d91\u0dbb\u0db4\u0dc0\u0dba\u0daf\u0dc0\u0dc0\u0dd2,\u0db4\u0dbb\u0dc0\u0da7\u0db8\u0db4\u0dca\u0dbb\u0dca\u0dd2\u0dbb\u0d9a\u0db4\u0dc0\u0d9c\u0daf\u0da9\u0dba\u0dd0\u0d9f\u0dd3\u0dad\u0da7,\u0db4\u0dbb\u0da7\u0db4\u0dc0\u0d9c\u0daf\u0da9\u0dba\u0dd0\u0d9f\u0dd3\u0dad\u0da7\u0db4\u0d85\u0dc0\u0dc1\u0dca\u0dba\u0db4\u0dbb\u0dbb\u0dba\u0db4\u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0db4\u0db1\u0dba\u0dad\u0dca\u0dad\u0dd2\u0dc3\u0db4\u0d91\u0dc5\u0dd2 \u0dca \u0dc0\u0dba,\u0db4\u0dc3\u0dcf\u0dc3\u0d9b\u0dba\u0daf\u0dc0\u0dca\u0d9b\u0dba\u0db4\u0d91\u0dc5\u0dd2 \u0dca \u0dc0\u0dba\u0db4\u0dc0\u0dca\u0d9b\u0dba\u0d9a.\u0db4\u0d91\u0dd4 \u0dad\u0daf\u0db4\u0daf\u0dd3\u0dbb\u0dca\u0d9d\u0db4\u0dc0\u0dc1\u0dca\u0dc0\u0d9a\u0db1\u0dca\u0db4\u0dbb\u0dbb\u0db4\u0dd4\u0db4\u0dbb\u0dcf\u0daf\u0dc0 ,\u0db4\u0d85\u0dca\u0daf\u0dc3\u0dcf\u0db4\u0dcf\u0daf\u0db4\u0daf\u0dd6\u0dc2 \u0d9a\u0db4\u0dad\u0dd0\u0dac\u0dbd\u0dd3\u0db8\u0dad\u0db4\u0dc3\u0dcf\u0dc4\u0dcf\u0daf\u0db4\u0dc0\u0daf\u0daf\u0d9a\u0dd4\u0db4\u0db6\u0dbb\u0dca \u0db4\u0dad\u0dd0\u0db6\u0dd4\u0dc0\u0daf.\u0db4\u0d85\u0db4\u0dd2\u0db4\u0d92\u0dbb\u0db4\u0d85\u0d9c\u0d9a\u0db4\u0dbb\u0dbb\u0dba\u0dc0\u0daf.\u0db4\u0d92\u0dbb\u0db4\u0dc0\u0dc0\u0db1\u0dca\u0dba\u0db4\u0d95\u0dba\u0dd1.\u0db4\u0d9c\u0dd4\u0dc0\u0db4\u0dbb\u0dcf\u0daf\u0dba\u0daf\u0d9a\u0dbb\u0dd4 \u0dad\u0db1\u0dd2,\u0db4\u0dc0\u0db8\u0dca\u0db4\u0dbb\u0dc0\u0da7\u0db8\u0db4\u0d85\u0dca\u0daf\u0dc3\u0dcf\u0db4\u0dcf\u0daf\u0db4\u0daf\u0dd6\u0dc2 \u0d9a\u0db4\u0dad\u0dd0\u0dac\u0dbd\u0dd3\u0db8\u0dad\u0db4\u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dc4\u0dc0\u0db4\u0d85\u0dc0\u0dc3\u0dbb\u0db4\u0d8b\u0dba\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0dc0\u0db6\u0dba\u0dc0\u0daf\u0db4\u0dba\u0db8\u0dca,\u0db4\u0d85\u0dca\u0daf\u0dc3\u0dcf\u0db4\u0dcf\u0daf\u0db4\u0daf\u0dd6\u0dc2 \u0d9a\u0db4\u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dc4\u0dc0\u0db4\u0d85\u0dc0\u0dc1\u0dca\u0dba\u0db4\u0dbb\u0dbb\u0dba,\u0db4\u0d92\u0db4\u0dc0\u0d9c\u0d9a\u0dd3\u0dad\u0db4 \u0dbb\u0dba\u0db4\u0d85\u0dca\u0daf\u0dc3\u0dcf\u0db1\u0db4\u0dc0\u0dcf\u0ddd\u0db4\u0daf\u0dd6\u0dc2 \u0db4\u0dc0\u0da0\u0ddd \u0dba\u0daf\u0db4\u0dc0\u0dd2\u0dad\u0dbb\u0dca\u0dc1\u0dca\u0dba\u0db4\u0dc0\u0dbb\u0daf\u0db8\u0dd2\u0dc2\u0db1\u0dca\u0db4\u0dc3\u0dcf\u0db7\u0daf\u0dc0\u0da7\u0db4\u0db4\u0dca\u200d\u0dbb\u0dad\u0daf \u0dc0\u0dad\u0dca\u0db4\u0dad\u0dbb\u0db8\u0dca\u0db4\u0db8\u0dd4 \u0daf\u0dca \u0db4\u0daf\u0db6\u0daf\u0db4\u0dc0 \u0db1\u0dca\u0dba\u0db4\u0d95\u0dba\u0dd1.\u0db4\u0dcf\u0dd0\u0db6\u0dd0\u0dd2,\u0db4\u0dbb\u0da2\u0dcf\u0dc0\u0d86\u0db4\u0db8\u0dd4 \u0dca\u0db4\u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dc4\u0db4\u0dbb\u0daf\u0dbb\u0dbb\u0db4\u0dc3\u0dcf\u0db7\u0daf\u0dc0\u0da7\u0db4\u0d87\u0dc0\u0dd2\u0dca\u0daf\u0daf,\u0db4\u0d85\u0dca\u0daf\u0dc3\u0dcf\u0db1\u0db4\u0dc0\u0dcf\u0ddd\u0db4\u0daf\u0dd6\u0dc2 \u0db4\u0dc0\u0da0\u0ddd \u0dba\u0daf\u0db4\u0dc0\u0dd2\u0dad\u0dbb\u0dca\u0dc1\u0dca\u0dba\u0db4\u0dc0\u0dbb\u0daf\u0db8\u0dd2\u0dc2\u0db1\u0dca\u0db4\u0dc3\u0dcf\u0db7\u0daf\u0dc0 \u0db4\u0d85\u0db0\u0dca\u200d\u0dba\u0dca \u0dc2\u0db4\u0da2\u0dcf\u0dba\u0dbb\u0daf\u0dca\u0dc0\u0dbb\u0d9a\u0daf\u0db4\u0dd2\u0dbb \u0dc0 \u0db4\u0dc0\u0dad\u0daf\u0dbb\u0dca ?\u0db4\"\u0dad\u0da7\u0db4\u0db8\u0dd4 \u0dca\u0db4\u0d85\u0dad\u0daf\u0dad\u0dba\u0daf\u0dc3\u0dc1\u0dca\u0dc0\u0d9a\u0db1\u0dca\u0db4\u0db4\u0dca\u200d\u0dbb\u0dad\u0daf \u0dc0\u0dad\u0dca\u0db4\u0dad\u0dbb\u0db8\u0dca\u0db4\u0db8\u0dd4 \u0dca\u0db4\u0dc0\u0dc0\u0db1\u0dca\u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db4\u0dba\u0dd0\u0dcf\u0dd0.\u0db4\u0db4\u0db1\u0dba\u0dba\u0dc0\u0dad\u0dca\u0db4\u0dad\u0dd2\u0dc3\u0dc0\u0db6\u0dba\u0dc0\u0daf,\u0db4\u0d85\u0dca\u0daf\u0dc3\u0dcf\u0db1\u0db4\u0dc0\u0dcf\u0ddd\u0db4\u0daf\u0dd6\u0dc2 \u0db4\u0dc0\u0da0\u0ddd \u0dba\u0daf\u0db4\u0dc0\u0dd2\u0dad\u0dbb\u0dca\u0dc1\u0dca\u0dba\u0db4\u0dc0\u0dbb\u0daf\u0db8\u0dd2\u0dc2\u0db1\u0dca\u0db4\u0dc3\u0dcf\u0db7\u0daf\u0dc0\u0da7\u0db4\u0dc3\u0dcf\u0db1\u0dc0\u0daf\u0db0\u0dd3\u0dba\u0dc0\u0db4\u0dad\u0dad\u0db1\u0dca\u0dc0\u0dda\u0db4\u0dbb\u0da7\u0dd4\u0dad\u0dd4 \u0db4\u0dd2\u0dbb\u0dd3\u0db8\u0dad\u0db4\u0dc3\u0dcf\u0dc4\u0dcf\u0daf\u0db4\u0d85\u0dc0\u0dc1\u0dca\u0dba\u0db4\u0d85\u0dbb\u0db8\u0dd4 \u0daf\u0dca \u0db4\u0dc0\u0d9c\u0daf\u0da9\u0dba\u0dd0\u0d9f\u0dd3\u0dad\u0da7.\u0db4\u0d92\u0db4\u0d85\u0dbb\u0db8\u0dd4 \u0daf\u0db4\u0dc3\u0dcf\u0dc4\u0dcf\u0daf\u0db4\u0db8\u0dd4 \u0dca\u0db4\u0dc3\u0dcf\u0db4\u0db1\u0dba\u0d9a\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db4\u0dba\u0dd0\u0dcf\u0dd0.\u0db4\u0dbb\u0da2\u0dcf\u0dc0\u0d9a\u0db1\u0dca\u0db4\u0d85\u0dc0\u0dc1\u0dca\u0dba\u0db4\u0dc3\u0dcf\u0dcf\u0dc0\u0d9a\u0ddd\u0d9c\u0d9a\u0db4\u0daf\u0dd0\u0dc0\u0db6\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db4\u0dba\u0dd0\u0dcf\u0dd0\"\u0db4\u0dd2\u0dbb\u0d9a\u0daf\u0daf\u0db4\u0d94\u0dbd \u0db4\u0dd2\u0dbb\u0d9a\u0dba\u0dc0\u0daf.\u0db4"
  },
