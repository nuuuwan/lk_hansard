    "chunk_text": "2025 \u0d85\u0dc0\u0dd4\u0dd4\u0dc0\u0daf\u0dca\u0db8\u0daf\u0dca \u0dba\u0dbd \u0dc3\u0dc4 \u0db8 \u0dc4 \u0d9a\u0db1\u0dca\u0dad\u0db1 \u0dbd \u0dd3 \u0d85\u0dc3\u0dca \u0d9a\u0db1\u0dca\u0dad\u0db1 \u0dd2\u0db8\u0d9a\u0db8\u200d\u0dcf\u0db8\u0d9a, \u0d85\u0db8\u0dda \u0dbb\u0db8\u0da7\u0dca\u0da7 \u0d85\u0dad\u0dd2\u0d9a \u0dca\u200d \u0dd3 \u0d85\u0dc3\u0dca \u0d9a\u0db1\u0dca\u0dad\u0db1\u0dca \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0dcf3 \u0dc4\u0d9a\u0db6\u0d9a\u0dba\u0dd2 \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0db4 \u0daa \u0dd2\u0dd4\u0dc0 \u0db8 \u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db8 \u0db1\u0dd2, \u0dc3\u0db8 \u0dc4\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0daf \u0dbd - varieties \u0dbd - \u0d85\u0dc3\u0dca \u0d9a\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dcf\u0dab \u0db8\u0d9a \u0db1\u0d9a\u0dc4\u0d9a3 \u0db1\u0dcf\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 64\u0dca \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0dcf3 \u0dbb\u0dd4 \u0dc3\u0dc4\u0dbd\u0dca\u0dad \u0dc3\u0dd2\u0dba\u0dba\u0da7 31\u0dca \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0dcf3 \u0d9a\u0dd3\u0d9a \u0dc3\u0dda\u0db6\u0dcf \u0dc3\u0dd2\u0dba\u0dba\u0da7 7 \u0dba\u0dd23 \u0dc3\u0dda\u0db6\u0dcf \u0dc3\u0dd2\u0dba\u0dba\u0da7 6\u0dca \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0dcf3 \u0d85\u0db8\u0db1\u0dd4\u0db8\u0d9a \u0dc3\u0dc4\u0dbd\u0dca\u0dad \u0dc3\u0dd2\u0dba\u0dba\u0da7 3\u0dca \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0dcf3 \u0dc4\u0d9a\u0db6\u0d9a\u0dba\u0dd2, \u0d85\u0db8\u0dda \u0d9a\u0dd3\u0d9a \u0dc3\u0dda\u0db6\u0dcf \u0db4\u0d9a \u0db8\u0db7\u0db6 \u0db1\u0dba \u0dc3\u0dd2\u0dba\u0dba\u0da7 19\u0d9a\u0da7 \u0dcf\u0dc3\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dcf\u0dab\u0dba\u0dca \u0db1 \u0dcf3 \u0d92 \u0db4\u0d9a \u0db8\u0db7\u0db6 \u0db1\u0db8\u0dda \u0da2 \u0dc3\u0dad\u0dd2 \u0db1 \u0dc4\u0dd2\u0d9f\u0dba \u0db4\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0dbb\u0dbd\u0dcf \u0d9a\u0dd3\u0d9a \u0dc3\u0dda\u0db6\u0dcf \u0dd4\u0dc0\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0dad 099\u0da7 \u0dc0\u0dd2\u0dd4\u0dab\u0dbd\u0dcf \u0d85\u0dad\u0dd2\u0d9a \u0dca\u200d \u0dbd\u0dcf\u0db7 \u0dbd\u0db6\u0db1 \u0dcf3 \u0d9a\u0db8\u0dc3\u0dca \u0d85\u0dad\u0dd2\u0d9a \u0dca\u200d \u0dbd\u0dcf\u0db7 \u0dbd\u0db6\u0db1 \u0d9a\u0d9a \u0db1 \u0db8\u0d9a \u0db1\u0dca\u0dad\u0db1 \u0db1\u0dda, \u0db8 \u0db8 \u0db3 \u0db8\u0db4\u0dcf\u0db8 \u0dca \u0d9a\u0dd3\u0d9a \u0dc3\u0dda\u0db6\u0dcf \u0dbd\u0da7 \u0dcf\u0db8\u0daf\u0dca\u0dba\u0d9a\u0dba\u0dca \u0db8\u0dd2\u0db1\u0d9a\u0dbd\u0dca\u0dad\u0dbd\u0dcf \u0daf\u0db8 \u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dd2\u0db8\u0d9a \u0dd3\u0dbb\u0dbb\u0dab\u0dba\u0da7 \u0d9a\u0d9a\u0dd2\u0dba\u0db1\u0da7\u0dca\u0da7 \u0db8 \u0dab\u0dca\u0da9\u0dbd\u0dba \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0da2\u0dd6\u0db1\u0dd2 \u0db8 \u0dcf\u0dc3\u0db8\u0dda \u0da2 \u0d85 \u0dc3\u0dbb \u0daf\u0dd4\u0db1\u0dca\u0dad\u0db1\u0dcf3 \u0d92 \u0dcf\u0db8\u0dda\u0db8 \u0dcf\u0dc4\u0dcf\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0db8\u0d9a\u0dad\u0dd2 \u0dc4\u0dcf \u0dc3\u0dd4\u0dbb\u0dca\u0dd2\u200d\u200d\u0dcf \u0d9a\u0db8\u0dd2\u0da7\u0dd4 \u0da7 \u0d9a\u0dd2\u0dda \u0dcf, \u0dba\u0dbd \u0d9a\u0db1\u0dca\u0dad\u0db1\u0db8\u0dda \u0d9a\u0dd3\u0d9a \u0dc3\u0dda\u0db6\u0dcf \u0dc3\u0dc4\u0dbd\u0dca\u0dad \u0d85\u0dc3\u0dca \u0d9a\u0db1\u0dca\u0dad\u0db1 \u0db6\u0dbd\u0dbd\u0dcf, \u0d92 \u0dc3\u0dc4\u0dbd\u0dca\u0dad \u0d85\u0dc3\u0dca \u0d9a\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dcf\u0dab\u0dcf\u0db8\u0d9a\u0db8 \u0d9a \u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba\u0dca \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db6\u0dbd\u0dbd\u0dcf \u0d92 \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dcf\u0dab\u0dcf\u0db8\u0d9a\u0db8 \u0d9a \u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba\u0da7 \u0dc3\u0dcf\u0db8\u0dda\u0dca\u0dc2 \u0d9a\u0dd3\u0d9a \u0dc3\u0dda\u0db6\u0dcf \u0dbd\u0d9a\u0db8\u0db6\u0db1 \u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db6\u0dbd\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf3 \u0d92 \u0d85\u0db1\u0dd4 \u0dcf\u0dc4\u0dcf\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0db8\u0d9a\u0dad\u0dd2 \u0dc4\u0dcf \u0dc3\u0dd4\u0dbb\u0dca\u0dd2\u200d\u200d\u0dcf \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0db8\u0dda \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 \u0dd4\u0dc0\u0db1\u0dca\u0dad \u0db8\u0dbd\u0dc3 \u0dd2\u0dd4\u0dc0 \u0dbd\u0dcf\u0dbd\u0dca\u0dad \u0d9a\u0dcf\u0db1\u0dca\u0dad\u200d \u0dc3\u0db8 \u0dad\u0dd2\u0dd4\u0db8 \u0dcf\u0dba\u0dd2 \u0db8 \u0db8 \u0dba\u0dd2 \u0d92\u0d9a\u0dcf\u0db6\u0daf\u0dca\u0db0 \u0dd3\u0dbb\u0dbb\u0dab\u0dba\u0dca \u0d85\u0dbb\u0db8\u0dd2\u0db1 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba 10 \u0d9a\u0db1\u0dd2\u0daf\u0dcf \u0d9a\u0d9a\u0dd2\u0dba\u0db1\u0da7\u0dca\u0da7 \u0db8 \u0dab\u0dca\u0da9\u0dbd \u0db4\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dcf \u0dca \u0d89\u0daf\u0dd2\u0d9a \u0db4\u0db8\u0d9a \u0d9a \u0dcf, \u0d9a\u0dd3\u0d9a \u0dc3\u0dda\u0db6\u0dcf \u0dc3\u0dc4\u0dbd\u0dca\u0dad \u0db8\u0db8 \u0da7\u0dca\u200d\u0dbb\u0dd2\u0dca \u0db8\u0da7\u0dcf\u0db1\u0dca\u0dad 39,999\u0d9a\u0da7 \u0d9a\u0da9\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dcf\u0dab\u0dba\u0dca \u0dbb\u0da7\u0da7 \u0db8\u0dd2\u0db1\u0dca\u0dad \u0dcf \u0dd2\u0d9a\u0db1\u0dd3\u0db8 \u0d89\u0dbd\u0dca\u0d9a \u0d9a\u0dbb\u0db8\u0dd2\u0db13 \u0d9a\u0db8 \u0d89\u0dbd\u0dca\u0d9a\u0dba \u0dc3\u0dda\u0db4\u0dd6\u0dbb\u0dca\u0dbd\u0dab \u0d9a\u0dbb \u0dd2\u0db1\u0dca\u0dad\u0db1 \u0dba\u0daf\u0dca \u0da2 \u0dc3\u0db8 \u0dc4\u0dd4\u0dc0 \u0dc4\u0dd2\u200d\u0dcf\u0db8\u0dd2\u0db1 \u0d89\u0db1\u0dca\u0dad\u0db1 \u0dcf, wholesale \u0dc4\u0dcf\u0dbd\u0dca\u0dad \u0db8\u0dd2\u0db8\u0db1\u0db1\u0dca\u0dad\u0db1 \u0db8\u0daf\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf3 \u0d9a\u0db8\u0dc4\u0db8 \u0db8\u0dda\u0db1\u0dca\u0dad\u0db1 \u0db8\u0daf\u0db1\u0dca\u0dad\u0db8 \u0db1\u0dca\u0dad \u0db1\u0d9a\u0dc4\u0d9a3 \u0d89\u0db1\u0dca\u0dad\u0daf\u0dd2\u0dba\u0dcf\u0db8\u0dda \u0dc4\u0dcf\u0dbd\u0dca\u0dad \u0db8\u0dda\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca\u0dad \u0db8\u0d9a\u0dcf\u0db8\u0dc4\u0dcf\u0db8 \u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0dad\u0db1 \u0dcf3 \u0dbd\u0d82\u0d9a\u0dcf\u0db8\u0dda \u0dc3\u0dc4\u0dbd\u0dca\u0dad\n\n\u0d9c\u0dd4 \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dd9\u0db1\u0dca\u0dd3\u0dd4\u0dbb\u0dd9\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba4\u0bae\u0bb2\u0bae\u0bc8\u0ba4\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0dd2\u0dd4\u0dc0 \u0dc3\u0db8 \u0dad\u0dd2\u0dd4\u0db8 \u0db1\u0dd2, \u0d9a\u0dcf\u0dbd\u0dba \u0d85 \u0dc3\u0db1\u0dca\u0dad3"
