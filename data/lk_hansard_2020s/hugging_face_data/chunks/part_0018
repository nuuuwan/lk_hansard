    "chunk_text": "\u0dbb\u0dbb\u0dd4 \u0d9a \u0ddc\u0db1\u0ddc\u0dba\u0dcf \u0d9a\u0dd4\u0dc5\u0db8\u0dd4\u0dad, \u0db4\u0db1\u0dca \u0dbb\u0db1\u0da7\u0dca \u0da2\u0db1\u0dad\u0ddc\u0dc0 \u0db1\u0db1\u0ddc\u0db1\u0dba\u0dcf \u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0dcf \u0da7 \u0dad\u0ddc\u0da9\u0db1 \u0db4\u0dd3\u0da9\u0db1\u0dc0\u0dbd\u0da7 \u0dbd\u0d9a\u0dca \u0d9a\u0dbb\u0dbd\u0ddc, \u0dd6 \u0dbb\u0ddc \u0d9a\u0dd1\u0db8\u0da7 \u0dbd\u0d9a\u0dca \u0d9a\u0dbb\u0dbd\u0ddc, \u0db4\u0db1\u0dca\u0d9a\u0dca\u0dc2\u0ddc \u0dcf\u0dc0\u0dbb\u0dad\u0dca\u0daf\u0dca\u200d\u0dc0\u0dba\u0dcf \u0da7 \u0db4\u0dad\u0dca\u0daf\u0dca\u200d \u0d9a\u0dbb\u0dbd\u0ddc, \u0d94\u0dd4\u0dbb \u0db1\u0dda \u0dd4\u0dbb\u0dc0\u0db8\u0db1\u0ddc \u0d91\u0db4\u0ddc\u0d9a\u0db8\u0dca \u0d89\u0da7\u0dd4 \u0db1\u0db1\u0ddc\u0dc0\u0db1 \u0dad\u0dad\u0dca\u0daf\u0dca\u200d\u0dad\u0dca\u0daf\u0dca\u200d\u0dc0\u0dba\u0dcf \u0da7 \u0db4\u0dad\u0dca\u0daf\u0dca\u200d \u0d9a\u0dbb\u0dbd\u0ddc, \u0d94\u0dd4\u0dbb \u0da7 \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0db6\u0dd2\u0dba\u0dcf , \u0db8\u0dbb\u0dab \u0db6\u0dd2\u0dba\u0dcf \u0daf\u0db1\u0dc0\u0db4\u0dd4 \u0d92 \u0daf \u0d9a \u0dc4\u0dad\u0dbb\u0dc4\u0db8\u0ddc\u0dbb\u0d9a\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0ddc\u0dbd\u0dba\u0dcf \u0db4\u0dc0\u0dca \u0d9a\u0dbb\u0dbd\u0ddc \u0db1\u0dc0 \u0dbb\u0db8\u0db1\u0d9a\u0da7, \u0db4\u0dd4\u0db1\u0dbb\u0dd4\u0daf\u0dba\u0dcf \u0d9a\u0dca \u0db1\u0daf\u0dca\u0da7 \u0dbb\u0db8 \u0d9a\u0dbb\u0db8\u0dd2 \u0dd2\u0dc0\u0da7\u0dd2\u0db1 \u0d9a\u0ddc\u0dbd \u0dc0\u0d9a\u0dc0\u0ddc\u0db1\u0dd4\u0dc0\u0d9a\u0dca \u0dad\u0db8\u0db1\u0dca \u0db4\u0db4\u0dd2 \u0db1\u0db8\u0dca \u0db1\u0dbb\u0dc0\u0db8\u0dd2 \u0dd2\u0dc0\u0da7\u0dd2 \u0db1 . \u0d92\u0dad\u0dca\u0daf\u0dca\u200d \u0db4\u0db4\u0dd2 \u0dd2\u0dc0\u0dba\u0dcf \u0dbd\u0dd4 \u0db1\u0daf\u0db1\u0ddc\u0db8 \u0daf \u0db1\u0dc0\u0ddc, \u0db4\u0db4\u0dd2 \u0dd2\u0dc0\u0dba\u0dcf \u0dbd\u0dd4 \u0db1\u0daf\u0db1\u0ddc\u0db8 \u0db1\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0dd4\u0db8\u0dca\u0dbb\u0dad \u0dba\u0dd4\u0dd4\u0dc5\u0dc0 \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0ddc, \u0db1\u0db8\u0dca \u0dc0\u0dd2\u0db1\u0ddc \u0d9a\u0ddc\u0dd3\u0db8 \u0dbb\u0db8 \u0db8\u0d9f \u0db1\u0dc0\u0db1\u0dca\u0dda \u0d9a \u0ddc \u0dc0\u0ddc\u0db1\u0dda\u0db8 \u0db1\u0db8\u0dca \u0d91\u0dc4\u0dd2 \u0d86\u0dbb\u0db8\u0dca\u0dcf\u0dba\u0dcf \u0db4\u0db8\u0dab\u0db1\u0dca; \u0d91\u0dc4\u0dd2 \u0db4\u0da7 \u0dbb\u0dd0 \u0db8 \u0db4\u0db8\u0dab\u0db1\u0dca \u0dd2\u0dbb\u0dba\u0dcf \u0db1 \u0d91\u0d9a. \u0db4\u0db4\u0dd2 \u0dad\u0dc0 \u0db1\u0db6\u0ddc\u0db1\u0dc4\u0dba\u0daf\u0dd4\u0dbb \u0db1\u0dbb\u0dc0\u0ddc \u0db1\u0dbb\u0db1 \u0db1\u0db8\u0dca \u0dbb\u0db8\u0db1 \u0dba\u0dcf \u0ddc \u0dba\u0dd4\u0dd4\u0dc5\u0dc0 \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0ddc. \u0db4\u0db4\u0dd2 \u0db4\u0dc3\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d92 \u0daf \u0d9a \u0dc4\u0dad\u0dbb\u0dc4\u0db8\u0ddc\u0dbb\u0d9a \u0d9a\u0ddc\u0dbd \u0dc0\u0d9a\u0dc0\u0ddc\u0db1\u0dd4\u0db1 \u0da2\u0ddc\u0dc0\u0ddc\u0dbb\u0db8\u0dca\u0d9a\u0ddc\u0dbb, \u0db4\u0ddc\u0dad\u0ddc\u0dbd, \u0db8\u0da2\u0dbb \u0db1\u0dc1 \u0db4\u0ddc\u0dbd\u0db1\u0dba\u0dcf \u0dc4\u0dd0\u0dd2\u0dc0\u0dbb\u0dd4\u0dab\u0dd4 \u0d86\u0d9a\u0ddc\u0dbb\u0dba\u0dcf \u0d9a\u0dca \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0ddc. \u0d92 \u0dc0\u0ddc\u0db1\u0dda\u0db8 \u0d92 \u0db1\u0dc1 \u0db4\u0ddc\u0dbd\u0db1\u0dba\u0dcf \u0d9a\u0da7\u0dba\u0dd4\u0dd4\u0dc5 \u0d9a\u0dbb\u0db4\u0dd4 \u0d86\u0d9a\u0ddc\u0dbb \u0dba\u0dcf \u0d9a\u0dca \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0ddc. \u0d92 \u0dc0\u0ddc\u0db1\u0dda\u0db8 \u0d92 \u0db1\u0dc1 \u0db4\u0ddc\u0dbd\u0db1\u0dba\u0dcf \u0dca\u0dc4 \u0da2\u0ddc\u0dc0\u0ddc\u0dbb\u0db8\u0dca\u0d9a\u0ddc\u0dbb \u0db4\u0dc1\u0db0\u0dad\u0dd2\u0dba\u0dcf \u0d9a\u0da7\u0dba\u0dd4\u0dd4\u0dc5 \u0d9a\u0dbb\u0db4\u0dd4 \u0dad\u0dbd \u0dbb\u0dab\u0db1\u0ddc\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0ddc.\n\n\u0db8\u0db8 \u0db1\u0db8\u0dca \u0dbb \u0db1\u0ddc \u0d8b\u0daf\u0ddc\u0dc4\u0dbb\u0dab\u0dba\u0dcf \u0db4\u0daf\u0ddc \u0dc0 \u0db1 \u0dbb\u0db8\u0dca\u0db4\u0dc4 \u0daf\u0dd2\u0dca\u0dda\u0dd2\u0d9a\u0dca\u0d9a\u0db1\u0dda \u0db8\u0dd3\u0dbb\u0db8\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dc1 \u0dba\u0dcf \u0da7\u0db1\u0dca. \u0db1\u0db8\u0dba\u0dcf \u0dbb\u0db8\u0dca\u0db4\u0dc4 \u0daf\u0dd2\u0dca\u0dda\u0dd2\u0d9a\u0dca\u0d9a\u0db1\u0dda, \u0db8\u0dd3\u0dbb\u0db8\u0dd4\u0db1 \u0d89\u0db4\u0daf\u0dd2\u0dbd\u0ddc, \u0db8\u0dd3\u0dbb\u0db8\u0dd4 \u0dc0\u0dd0\u0dbd\u0dca\u0db1\u0dbd\u0dca \u0dc4\u0dd0\u0daf\u0dd4\u0dab\u0dd4 \u0dc0\u0dd0\u0dd4\u0dab\u0dd4 \u0db0\u0dd3\u0dc0\u0dbb\u0db1\u0dba\u0dcf \u0d9a\u0dd4\u0db1\u0dda \u0db4\u0dd4\u0db1\u0dad\u0d9a\u0dd4 \u0db1\u0dc0\u0da0\u0dca\u0da0 \u0dbb\u0dc0\u0daf\u0dba\u0dc0\u0dbb\u0db1\u0dba\u0dcf \u0d9a\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dca\u0db8\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0dba\u0dcf \u0d9a\u0dca. \u0d94\u0dc4\u0dd4 \u0dbb\u0dc0\u0daf\u0dba \u0dc0\u0dd8\u0dad\u0dca\u0daf\u0dca\u200d\u0dad\u0dd2\u0db1\u0dda \u0db1\u0dba\u0dcf \u0db1\u0daf\u0db1 \u0dbb\u0db8 , \u0dbb\u0dc0\u0daf\u0dba \u0dc0\u0dd8\u0dad\u0dca\u0daf\u0dca\u200d\u0dad\u0dd2\u0dba\u0dcf \u0da7 \u0d91\u0dc4\u0ddc \u0d9c\u0dd2\u0dc4\u0dd2 \u0db1\u0db8\u0dca \u0dc0\u0dd2\u0dc2 \u0db8\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dba\u0dc0\u0dbd\u0da7 \u0dd4\u0dda\u0db6\u0dd0\u0dc4\u0dd2\u0dc0\u0dd6\u0dc0 \u0db4\u0dd4\u0db1\u0dbb\u0dd4\u0dad\u0dca\u0daf\u0dca\u200d \u0ddc\u0db4\u0db1\u0dba\u0dcf \u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0dca\u0db3\u0dc4\u0ddc \u0dc0\u0db1 \u0dca\u0dda\u0db1 \u0da0\u0dca\u0da1\u0ddc \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0db1\u0dc0 \u0d9a\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0ddc\u0dad\u0dca\u0daf\u0dca\u200d\u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dc0\u0ddc. \u0d92 \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0db1\u0dc0 \u0da7 \u0dca\u0db8\u0dca\u0db6 \u0db0 \u0dc0\u0db1 \u0db1\u0daf\u0db8 \u0db4\u0dd2\u0dba\u0dcf \u0dca\u0db8\u0d9f \u0d92 \u0dd4\u0dda\u0db6\u0dd0\u0dc4\u0dd2\u0dc0\u0dd6\u0dc0 \u0db8\u0dd6\u0dd2\u0d9a \u0d9a\u0dbb\u0db1\u0dbb\u0db1 \u0d94\u0dc4\u0dd4 \u0db1\u0db8\u0dca \u0dca\u0db8\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0dba\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0ddc. \u0d92 \u0dca\u0db8\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0db1\u0dda\u0daf\u0dd3 \u0d94\u0dc4\u0dd4 \u0dc4\u0db8\u0dca\u0db1\u0ddc \u0dbb \u0db1\u0dc0\u0ddc, \u0db8\u0dd6\u0dd2\u0d9a \u0dc0 \u0db1\u0dba\u0dcf \u0db4\u0ddc\u0dad\u0ddc\u0dbd\u0dba\u0dcf \u0db1\u0db8\u0dad\u0dbb\u0db8\u0dca \u0db8\u0dbb\u0ddc\u0dbb \u0db1 \u0dd4\u0db1\u0dca \u0dd2\u0dbb\u0dba\u0dcf \u0db1 \u0d9a\u0ddc\u0dbb\u0dab\u0dba\u0dcf . \u0d94\u0dc4\u0dd4\u0db1\u0dda \u0dca\u0db8\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0dba\u0dcf \u0da7 \u0d94\u0dc4\u0dd4 \u0db1\u0dba\u0dcf \u0ddc\u0daf\u0ddc \u0dbb \u0db1\u0dc0\u0ddc, \u0dad\u0db8 \u0d9f\u0da7 \u0dbb\u0dd0\u0db1\u0dbb\u0db1 \u0d91\u0db1 \u0dd4\u0dda\u0db6\u0dd0\u0dc4\u0dd2\u0dc0\u0dd6\u0dc0 ."
  },
