u0dbb\u0dca\u0db0\u0db1 \u0db4\u0daf\u0db1\u0db8\n\n\uf0fc\n\n8 \u0dbb\u0dbd\u0dc4 \u0db8\u0dbd\u0dca\u0db1\u0db6\u0dbb\u0dd2\u0dc0\u0dad\u0dca\u0daf\u0dca\u200d\u0dad \u0dca\u0dbb\u0dad\u0dca\u0daf\u0dca\u200d \u0dc0\u0dd3\u0dbb\u0dbb\u0dad\u0dca\u0daf\u0dca\u200d\u0db1 \uf0fc\n\n(iv) \u0daf\u0dd3\u0dbb\u0dca\u0d9d \u0d9a\u0ddc\u0dbd\u0dba\u0dcf \u0d9a \u0dd2\u0dc0\u0da7 \u0d89\u0da9\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dca\u0dc0\u0dca\u0dda\u0d9a\u0dbb\u0dab \u0db1\u0d9a\u0ddc\u0db8\u0dd2\u0dc2 \u0dca\u0dcf\u0ddc\u0dc0 \u0dca\u0dd4\u0dc5 \u0d89\u0da9\u0db8\u0dca\u0dc0\u0dbd \u0db4\u0dd4\u0dc1\u0dbb\u0dbd\u0dba\u0dcf \u0db4\u0daf\u0dd2\u0dc0\u0da0\u0dd2 \u0dc0\u0dd3 \u0dd4\u0dad. \u0d86\u0dba\u0dcf \u0dad\u0db1\u0dba\u0dcf \u0da7 \u0db4\u0daf\u0ddc \u0db1\u0dd3\u0dad\u0dd2 \u0dbb\u0ddc\u0db8\u0dd4\u0dc0\u0dbd\u0da7 \u0db4\u0db1\u0dd4\u0dd6\u0dbd\u0dbd\u0dc0 \u0d94\u0dca\u0db4\u0dd4 \u0dbd\u0db6\u0ddc \u0daf\u0dd3\u0db8\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dd4\u0dc5 \u0d9a\u0dbb\u0db8\u0dd2 \u0db4\u0dc0\u0dad\u0dd3. \u0dca\u0db8\u0ddc\u0dbb\u0db8\u0dca \u0dc0\u0dd2\u0dd2\u0dc0 \u0db1\u0dd3\u0dad\u0dba\u0db1\u0dd4\u0dd6\u0dbd\u0dbd \u0db1\u0db1\u0ddc\u0dc0\u0db1 \u0d86\u0d9a\u0ddc\u0dbb\u0dba\u0dcf \u0da7 \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0db1\u0dd4 \u0db1\u0db1\u0ddc\u0dbd\u0db6\u0db1\u0dca. (v) \u0db4\u0db1\u0dc0\u0dca\u0dbb\u0d9a\u0dbb\u0dd4\u0dc0 \u0dd4\u0dad\u0dba\u0dcf \u0db8\u0ddc\u0db1\u0dd4\u0dd6\u0dbd\u0dbd \u0dd2\u0dbb\u0dd3\u0db8\u0db1\u0db8\u0dca \u0dc0\u0dd2\u0dc2\u0db1\u0dba\u0dcf \u0dc4\u0dd2\u0dbd\u0ddc \u0dc0\u0dbb\u0dd2 \u0dc0\u0dbb \u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd6 \u0dbb\u0ddc\u0da2\u0dba \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0daf\u0dca\u200d\u0dad\u0dd2\u0dc0\u0dbd\u0da7 \u0db4\u0db1\u0dd4\u0dd6\u0dbd\u0dbd\u0dc0 \u0dc4\u0ddc \u0d89\u0da9\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dca\u0dc0\u0dca\u0dda\u0d9a\u0dbb\u0dab \u0db1\u0d9a\u0ddc\u0db8\u0dd2\u0dc2 \u0dca\u0dcf\u0ddc\u0dc0 \u0dc0\u0dd2\u0dd2\u0dc0 \u0db4\u0db1\u0dd4\u0db8\u0dad \u0da0\u0d9a\u0dca\u200d\u0dbb\u0db1\u0dbd\u0dca\u0dca\u200d \u0dc4\u0ddc \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0ddc\u0db1\u0dc0\u0dbd\u0da7 \u0dba\u0dcf \u0da7\u0dad\u0dca\u0daf\u0dca\u200d\u0dc0, \u0db1 \u0dc0\u0ddc\u0dd2\u0dc0\u0d9a \u0db4\u0dbb\u0db8\u0dd4\u0dab\u0dd4 \u0dca\u0db3\u0dc4\u0ddc \u0dc4\u0ddc \u0db6\u0daf\u0dd4 \u0db4\u0daf\u0db1\u0db8 \u0db8\u0dad \u0db4\u0db1\u0dc0\u0dca\u0dbb\u0d9a\u0dbb\u0dd4\u0dc0 \u0dd4\u0dad\u0dba\u0dcf \u0db8\u0ddc\u0db1\u0dd4\u0dd6\u0dbd\u0dbd \u0dd2\u0dbb\u0dd3\u0db8\u0db8\u0dca \u0dd2\u0dc0\u0daf\u0dd4 \u0db1\u0d9a\u0db1\u0dbb\u0dca. (\u0d86) \u0db4\u0daf\u0ddc \u0db1\u0db1\u0ddc\u0db1 .\n\n\u0d9c\u0dd4 \u0d8a.\u0d91\u0db8\u0dca. \u0db6\u0dca\u0db4\u0db1\u0dcf\u0dba\u0d9a \u0dd9\u0dc4\u0dc3\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b88.\u0b8e\u0bae\u0bcd. \u0baa\u0bb8\u0bcd\u0ba8\u0bc6\u0bbe\u0baf\u0b95\u0bcd\u0b95) (The Hon. E.M. Basnayaka) \u0dbb\u0dbb\u0dd4 \u0d9a \u0ddc\u0db1\u0ddc\u0dba\u0dcf \u0d9a\u0dd4\u0dc5\u0db8\u0dd4\u0dad, \u0db8\u0db1\u0dda \u0db4 \u0db8\u0dd4\u0dc0\u0dd0\u0dd4\u0dad \u0db4\u0dd4\u0dc5\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1\u0dba\u0dcf \u0db1\u0db8\u0dba\u0dcf \u0db1\u0dca.\n\n\u0dbb\u0dbb\u0dd4 \u0dd4\u0dad\u0db1\u0dba\u0dcf \u0dba\u0da2\u0dba \u0dd4\u0db8\u0dad\u0dd2\u0dd4\u0dc5\u0db8\u0dd4\u0dad, \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0daf\u0dd2\u0dca\u0dda\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dcf \u0dd4\u0dc5 \u0d89\u0da9\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dca\u0dc0\u0dca\u0dda\u0d9a\u0dbb\u0dab \u0db1\u0d9a\u0ddc\u0db8\u0dd2\u0dc2 \u0dca\u0dcf\u0ddc\u0dc0 \u0dca\u0dd4\u0dc5 \u0d89\u0da9\u0db8\u0dca \u0dad\u0dc0 \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0ddc\u0daf? \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0ddc \u0db1\u0db8\u0dca \u0d91\u0db8 \u0d89\u0da9\u0db8\u0dca \u0d86\u0db1\u0dba\u0dcf \u0dba\u0da2\u0db1 \u0dc4\u0ddc \u0dd4\u0dad\u0dc2\u0dda\u0db4\u0ddc\u0daf\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dd4\u0dc5 \u0dca\u0db3\u0dc4\u0ddc \u0db1\u0dba\u0dcf \u0ddc\u0daf\u0ddc \u0dbb\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db4\u0dd2\u0dba\u0dcf \u0dc0\u0dbb \u0db1\u0dbb\u0db1 \u0dad\u0dd2\u0db1\u0dda \u0daf?"
