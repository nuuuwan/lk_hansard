    "chunk_text": "5. \u2022 \u0dc0\u0dd2\u0db8 \u0dc0\u0dca\u200d\u0dba\u0dd0\u0dda \u200d\u0dbb\u0db8 \u0dc0\u0db8\u0dda\u0daf\u0dba \u0d94\u0dc3\u0dda\u0db8\u0dc3\u0dda \u0d85\u0dca\u0dbb\u0dcf\u0dca \u0dbb\u0dc4\u0dd2\u0dda\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dbb\u0dad\u0dca\n\n\u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0 \u0dc0\u0dd0\u0db4\u0dca \u0daf \u0d85\u0dba\u0daf\u0dd4\u0dda \u0dbb\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a \u0dbb\u0dbb\u0dd3\u0d9a\u0dc2\u0dcf \u0d9a\u0dbb \u0d85\u0db1\u0dd4\u0db8 \u0dc0\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0dc0\u0db1\u0dca \u0dbb\u0dc3\u0dd4\u0dc0 \u0db8\u0dc5\u0db8\u0dd9\u0db1 \u0db8 \u0dc0\u0dcf\u0dc3\u0db8\u0dda \u0daf\u0dd3 \u0dca\u200d\u0dbb\u0dae\u0db8 \u0dc0 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0 \u0dc0\u0dd0\u0db4\u0dca\u0dbb \u0dc4\u0dd2\u0dd2\u0dba\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0dc0 \u0db1\u0dca\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0db8\u0dda.\n\n\u2022 \u0db8 \u0dc0\u0dca\u200d\u0dba\u0dd0\u0dda \u200d\u0dbb\u0db8 \u0dc0\u0db8\u0dda\u0daf\u0dba \u0d94\u0dc3\u0dda\u0db8\u0dc3\u0dda \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dbb\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1\u0dca\u0db8\u0db1\u0dca\n\n\u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0 \u0dc0\u0dd0\u0db4\u0dca \u0daf \u0da0\u200d\u0dbb\u0db8\u0dca \u0d9b\u0dca\u200d 03/2015 \u0dc4\u0dcf \u0db8\u0dc4\u0dd2 \u0dc3\u0d82\u0db8\u0dba\u0ddd\u0dca\u200d\u0db1\n\n\u0db8 \u0dc0\u0dca \u0db1\u0dca \u0daf \u0dbb\u0dcf\u0da2\u0dcf\u0dba \u0dbb\u0dbb\u0dd2\u0dbb\u0dcf\u0dbd\u0db1 \u0da0\u200d\u0dbb\u0db8\u0dca \u0d9b\u0dca\u200d 07/2018 \u0db8 \u0dc0\u0dca \u0db1\u0dca \u0daf \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0 \u0dc0\u0dd0\u0db4\u0dca \u0daf \u0db8\u0dd0\u0dc0\u0dd3\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dca\u200d\u0db8\u0dba\u0db1\u0dca \u0dbb\u0dcf\u0da2\u0dcf\u0dba \u0d86\u0dba\u0dda\u0db1 \u0db8\u0dc0\u0dda \u0d85\u0dc0\u0dba\u0dba \u0dc3\u0dbb\u0db8\u0daf\u0dc3\u0dda \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8 \u0dc0 \u0db1\u0dca\u0daf\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0db1\u0dd2\u0dbd\u0dca\u200d\u0dbb\u0db8\u0dba\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0 \u0dba\u0dd1\u0db8 \u0dc0\u0da7 \u0db8 \u0dc0\u0dcf\u0dc3 3\u0d9a\u0da7 \u0db8\u0dbb\u0dbb \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0 \u0dc0\u0dd0\u0db4\u0dca \u0daf \u0d85\u0dba\u0daf\u0dd4\u0dda \u0dbb\u0dad\u0dca\u200d\u0dbb\u0dba \u0db8\u0db8 \u0dc0\u0db8 \u0dc0 \u0db8\u0daf\u0dbb\u0dcf\u0dad\u0db8\u0dda\u0db8\u0dda\u0db1\u0dca \u0dc0 \u0db8\u0dc0\u0dda \u0db8\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0db1 \u0db8\u0dbd\u0dc3 \u0dc3\u0dbb\u0db8\u0daf\u0dc3\u0dda \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca\u0d8b \u0d87\u0dda\u0dd0\u0dda \u0d86\u0dba\u0dda\u0db1 \u0dc0\u0dd2\u0db1\u0dca\u0db1\u0dca \u0db8\u0db6\u0dcf\u0db8\u0dc4\u0ddd \u0dc0\u0dd2\u0da7 \u0d85\u0dba\u0daf\u0dd4\u0dda \u0dbb\u0dad\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dbb\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0 \u0db1\u0dca\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1\u0dca\u0db8\u0db1\u0dca \u0db1\u0dd2\u0dbd\u0dca\u200d\u0dbb\u0dba\u0dcf \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0 \u0dba\u0dd1\u0db8\u0db8 \u0dc0\u0db1\u0dca \u0dbb\u0dc3\u0dd4\u0dc0\u0dd2 . \u0db8\u0dba\u0daf \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0 \u0dc0\u0dd0\u0db4\u0dca \u0daf \u0db8\u0dd0\u0dc0\u0dd3\u0dda \u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dcf\u0daf\u0dc0\u0dd3\u0db8 \u0dc0\u0da7 \u0db8\u0dc4\u0dda \u0dc0\u0d9a \u0dc0\u0dd3 \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf.\n\n2187 2188\n\n2025 \u0d94\u0d9a\u0db8\u0dda\u0ddd\u0db6\u0dad\u0db8 21\n\n\u2022 \u0dc0\u0dd2\u0db8 \u0dc0\u0dca\u200d\u0dba\u0dd0\u0dda \u0db8\u0dc4\u0ddd \u0db8 \u0dc0\u0dca\u200d\u0dba\u0dd0\u0dda \u200d\u0dbb\u0db8 \u0dc0\u0db8\u0dda\u0daf\u0dba \u0dba\u0da7\u0db8\u0dad\u0dca \u0dbb\u0dc5\u0db8\u0dd4\n\n\u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0 \u0dc0\u0dd0\u0db4\u0dca\u0dbb \u0dc4\u0dd2\u0dd2\u0dba\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8\u0db8 \u0dc0\u0db1\u0dca \u0dbb\u0dc3\u0dd4\u0dc0 \u0db8\u0dc5\u0db8\u0dd9\u0db1 \u0db8 \u0dc0\u0dcf\u0dc3 2\u0d9a \u0d9a\u0dcf\u0dbd\u0dba \u0dc5 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0 \u0dbb\u0dcf\u0dbb\u0dd2\u0db8\u0dda\u0ddd\u0dc2\u0dd2\u0d9a\u0dba \u0dc4\u0dd2\u0dd2\u0dba\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0dc0 \u0db1\u0dca\u0daf\u0dd4 \u0db8\u0d9a\u0db8\u0dad\u0db8. \u0db8\u0daf\u0dbb\u0dcf\u0dad\u0db8\u0dda\u0db8\u0dda\u0db1\u0dca \u0dc0 \u0db8\u0dc0\u0dda \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbb\u0dcf\u0daf\u0db1 \u0dbd\u0dd0\u0db8\u0db6\u0db1 \u0d86\u0d9a\u0dcf\u0dbb\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0d92\u0d9a \u0db1\u0dca\u0daf\u0dca\u0dca\u200d \u0db8\u0dc0\u0db1\u0dca\u0db8\u0db1\u0dca. \u0db8\u0dda \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0d85\u0dc0\u0dba\u0dba \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbb\u0dcf\u0daf\u0db1 \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf.\n\n\u2022 \u0dc0\u0dd0\u0db1\u0dca\u0daf\u0db9\u0dd4/\u0dc0\u0dd0\u0db1\u0dca\u0daf\u0db9\u0dd4 \u0dd4\u0dbb\u0dd4\u0dc2 \u0dc4\u0dcf \u0d85\u0db1\u0dad\u0dca\u0daf\u0dbb\u0dd4 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0 \u0dc0\u0dd0\u0db4\u0dca \u0daf \u0d85\u0d82\u0dba\u0dba\n\n\u0db8\u0dc0\u0dda \u0d85\u0dca\u0dbb\u0dcf\u0dca \u0dbb\u0dc4\u0dd2\u0dda\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dbb\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0d85\u0dba\u0daf\u0dd4\u0dda \u0dbb\u0dad\u0dca\u200d\u0dbb \u0dc3\u0db3\u0dc4\u0dcf \u0db8 \u0dc0\u0dcf\u0dc3 2\u0d9a \u0dbb\u0db8 \u0dc0\u0dd9 \u0d9a\u0dcf\u0dbd\u0dba\u0d9a \u0dc5\u0daf\u0dd3 \u0db8 \u0dc0\u0dbb\u0dd9 \u0dbb\u0dcf\u0dbb\u0dd2\u0db8\u0dda\u0ddd\u0dc2\u0dd2\u0d9a\u0dba \u0daf\u0d8b \u0db8 \u0dc0\u0dcf\u0dc3 3\u0d9a \u0dbb\u0db8 \u0dc0\u0dd9 \u0d9a\u0dcf\u0dbd\u0dba\u0d9a \u0dc5\u0daf\u0dd3 \u0dc0\u0dd0\u0db1\u0dca\u0daf\u0db9\u0dd4/\u0dc0\u0dd0\u0db1\u0dca\u0daf\u0db9\u0dd4 \u0dd4\u0dbb\u0dd4\u0dc2 \u0dc4\u0dcf \u0d85\u0db1\u0dad\u0dca\u0daf\u0dbb\u0dd4 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0 \u0dc0\u0dd0\u0db4\u0dca\u0dbb \u0daf \u0db8\u0dd0\u0dc0\u0dd3\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0da7 \u0d9a\u0da7\u0dba\u0dd4 \u0d9a\u0dbb\u0dd2\u0dba\u0db1\u0dca \u0dbb\u0dc0\u0dad\u0dd3."
