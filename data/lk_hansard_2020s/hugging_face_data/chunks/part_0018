    "chunk_text": "\u0daf\u0dd4\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db1\u0d9a\u0dc4\u0d9a3 \u0db8\u0d9a\u0dcf\u0dda\u0db4\u0d9a\u0db1\u0dd2 \u0db4\u0dc4\u0d9a\u0da7, \u0daf\u0dc4\u0dba\u0d9a\u0da7 \u0d92 \u0dba\u0dcf\u0db4\u0dcf\u0d9a \u0d9a\u0db8\u0dba\u0db6 \u0db4\u0dc3\u0dca\u0db8\u0daf\u0db1\u0dcf \u0d92 \u0dcf \u0daf\u0dcf \u0dd2\u0db8\u0d9a\u200d\u0dcf3 \u0d85\u0daf \u0db8 \u0db1\u0db8\u0d9a\u0dcf\u0da7 \u0db8\u0d9a\u0dcf \u0dbb\u0dcf\u0dba\u0da7 \u0dc4\u0dcf\u0dbd\u0dca\u0dad \u0dc3\u0dc0\u0dd2\u0dbd\u0dca\u0dad\u0dbd\u0dcf \u0d89 \u0dbb\u0dba\u0dd23 \u0db8\u0d9a\u0dcf\u0db8\u0dc4\u0dcf\u0db8 \u0daf \u0daf \u0dc3\u0dca 5\u0dca \u0dc3\u0dd4 \u200d \u0db8\u0da0 \u0db1\u0dca\u0dad\u0db1\u0dcf\u0dba\u0dd2 \u0db8\u0db8 \u0db6\u0dbd\u0dca\u0dad \u0dd2\u0db1\u0dca\u0dad \u0db8\u0d9a\u0dcf\u0da7\u0dbd\u0dcf, \u0dad\u0dd6\u0db8\u0d9a\u0dd4\u0dd4\u0da9\u0dd2 \u0db8\u0db8 \u0db6\u0dbd\u0dca\u0dad \u0dd2\u0db1\u0dca\u0dad \u0db8\u0d9a\u0dcf\u0da7\u0dbd\u0dcf \u0dd3 \u0da7\u0dd2\u0d9a \u0dc4\u0dcf\u0dbd\u0dca\u0dad \u0d9a\u0dbb\u0dbd\u0dcf \u0db8\u0da0 \u0db1\u0dca\u0dad\u0db1\u0dcf\u0dba\u0dd2 \u0dbb\u0dcf\u0dba\u0da7 \u0dc3\u0dc4 \u0dad\u0dd6\u0db8\u0d9a\u0dd4\u0dd4\u0da9\u0dd2\u0dba \u0dbb\u0dcf\u0dba\u0da7 \u0db8\u0dd2\u0db1\u0dcf\u0db8\u0dda? \u0dd2\u0d9a\u0dc3\u0da7\u0dca\u0da7 \u0d9a\u0d9a \u0dd2\u0d9a\u0dd4\u0dc0\u0db8\u0dda \u0dbb\u0dd1 13399\u0da73 \u0dd2\u0d9a\u0dc3\u0da7\u0dca\u0da7 \u0d9a\u0d9a \u0dd2\u0dc4\u0db4\u0dd4 \u0daf \u0db8\u0dc3\u0dca \u0d8b\u0db8\u0daf\u0dca \u0db8 \u0db1\u0db8\u0d9a\u0dcf\u0da7 \u0dc4\u0dcf\u0dbd\u0dca\u0dad \u0dbb\u0dcf\u0dba\u0da7 \u0dc3\u0dc0\u0dd2\u0dbd\u0dca\u0dad\u0dbd\u0dcf \u0d89 \u0dbb\u0dba\u0dd23 \u0d92 \u0dba\u0dcf\u0db4\u0dcf\u0d9a \u0d9a\u0db8\u0dba\u0db6 \u0dc4\u0dd2\u200d \u0db8\u0d9a \u0dcf\u0dab\u0dca\u0dca \u0da7\u0daf, \u0dc3\u0db8 \u0dad\u0dd2\u0dd4\u0db8 \u0dcf\u0da7\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0db8 \u0db8 \u0daf\u0db1\u0dca\u0dad\u0db8\u0db1\u0dc