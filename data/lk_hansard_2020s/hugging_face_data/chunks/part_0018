    "chunk_text": "\u0db8\u0dd6\u0db6\u0daf\u0dc3\u0dcf\u0db1\u0daf\u0dbb\u0dd6\u0daa\u0d9a\u0d9c\u0dbb\u0dd4\u0d9a\u0db8\u0dca \u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba,\u0d9a\u0db8\u0ddd \u0d9a\u0db4\u0dd2\u0dba\u0daf\u0dad\u0dca\u0d9a\u0dc3\u0dcf\u0db8\u0dd9\u0d9a\u0dd2\u0dc0 \u0db4\u0dd4\u0d9a\u0ddd\u0dda\u0d9a\u0db8\u0dca \u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dca \u0db6\u0daf\u0d9a\u0dc3\u0dd2\u0dba\u0dd4\u0db8\u0ddd:\u0db1\u0daf\u0db8\u0d9a\u0dc3\u0dcf\u0db8\u0daf\u0da2\u0dba \u0d9a\u0dc0\u0dd2\u0dba\u0daf\u0db6\u0d9a\u0dc0\u0dd0\u0da9\u0d9a\u0ddd\u0db4\u0ddc \u0dc3\u0dcf\u0dca\u0dc2\u0d9a\u0db4\u0dbb\u0db4\u0dd4\u0d9a\u0db1\u0daf\u0dba\u0db4\u0dba\u0dca .\u0d9a\u0db8\u0d9c\u0dc0\u0dd2\u0dca \u0d9a\u0da9\u0dd3.\u0d9a:\u0d9a\u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0daf\u0d9a\u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0daf,\u0d9a\u0da0\u0dd6\u0db6\u0daf\u0d9a\u0dcf\u0dab\u0dca\u0da9\u0daf\u0dbb\u0d9a\u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0daf,\u0d9a\u0db4\u0db1\u0d9c\u0dc3\u0dcf\u0dcf\u0daf\u0dcf\u0dad\u0dd2\u0d9a\u0d8a\u0db6\u0ddd\u0daf\u0dca :\u0dca \u0d9a\u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0daf\u0ddd \u0d9a\u0d85\u0dcf\u0daf\u0dc0\u0dba\u0d9a\u0d9a\u0ddd\u0dc0\u0dca \u0ddd\u0dc0\u0dca \u0dad\u0dca\u0d9a\u0db8\u0daf\u0d9a\u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dd4\u0d9a\u0db8\u0ddd \u0d9a\u0dcf\u0dc0\u0dd4\u0ddd\u0dbd\u0dca\u0d9a\u0dc3\u0dd2\u0dba\u0dd4\u0db8\u0ddd:\u0db1\u0daf\u0ddd \u0d9a\u0ddd\u0dba \u0db4\u0dba\u0d9a\u0ddd\u0dda\u0d9a\u0ddd\u0dc0\u0db6\u0daf\u0ddd\u0daf\u0d9a\u0db4\u0dca\u200d\u0dbb\u0db4\u0dba\u0d9a\u0db4\u0dbb\u0dca \u0db1\u0d9a\u0db4\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dd2.\u0d9a\n\n2815 2816\n\n[\u0d9c\u0dbb\u0dd4\u0d9a\u0d8b\u0db4\u0dd4\u0dbd\u0dca\u0d9a\u0dd2\u0dbb\u0dad\u0dca\u0dc3\u0dd2\u0dbb\u0dd2\u0d9a\u0d9a\u0db8\u0dc4\u0dca\u200d\u0daf]\n\n2025 \u0d94\u0dca\u0dc2\u0ddd\u0dca\u200d \u0dcf\u0d9c\u0d9a2.\n\n\u0db8\u0db8\u0d9a\u0dcf\u0dc5\u0db8\u0dd4\u0dc0\u0dd0\u0dd2\u0dba\u0dba \u0db8\u0d9a\u0db4\u0dca\u200d\u0dbb\u0daf\u0ddd\u0daf\u0dca\u0dba \u0dba\u0d9a\u0dc3\u0dcf\u0dcf\u0daf\u0dc0 \u0d9a\u0dca\u200d\u0db8\u0dba\u0dd2\u0d9a\u0da1\u0dca :\u0dba\u0d9a\u0d89\u0dbd\u0dca\u0dd4\u0db8\u0ddd\u0daf.\u0d9a\u0db8\u0ddd \u0d9a\u0dca\u200d\u0daf\u0dad\u0dca\u0dca\u200d\u0daf\u0d9a\u0dd2\u0dbb\u0dba\u0db6\u0daf\u0d9a\u0ddd\u0db1\u0ddc\u0ddd\u0dc0\u0dba\u0dd2\u0d9a\u0db8\u0db8\u0d9a\u0db4\u0dca\u200d\u0dbb\u0daf\u0ddd\u0daf\u0dca\u0dba \u0dba\u0d9a\u0dc3\u0dcf\u0dcf\u0daf\u0dc0 \u0d9a\u0da1\u0dca :\u0dba\u0d9a\u0d9a\u0da1\u0dca :\u0dba\u0d9a\u0d89\u0dbd\u0dca\u0dd4\u0db8\u0ddd\u0daf.\u0d9a\u0d92\u0d9a\u0ddd\u0dc0\u0db6\u0daf\u0ddd\u0daf\u0d9a\u0db8 \u0d9a\u0da1\u0dca :\u0dba\u0d9a\u0d89\u0dbd\u0dca\u0db6\u0dca \u0db1\u0d9a\u0d9a\u0dd2\u0dbb\u0daf\u0ddd\u0daf\u0d9a\u0dcf\u0dc0\u0dd2\u0dad\u0dca\u200d\u0dbb\u0daf\u0d9a\u0dc0\u0dca \u0dd2\u0dba\u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0ddd \u0d9a\u0db8\u0dd0\u0dad\u0dd2\u0dd2\u0dba\u0dba\u0ddd \u0d9a\u0db4\u0dd2\u0dba\u0daf\u0d9a\u0dc0\u0db1\u0d9a\u0db0\u0d9c\u0db8:\u0daf\u0dc3\u0dcf\u0d9a\u0dc0\u0dca \u0dd2\u0dba\u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9a\u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0daf.\u0d9a\u0dbb\u0dad\u0dd4\u0db8\u0db8\u0daf\u0d9a\u0dcf\u0daf\u0d9c\u0dbd\u0dd2\u0ddd\u0dda\u0dca \u0dad\u0dd4\u0db8\u0ddd\u0daf\u0d9a\u0dd2\u0dc0 \u0db4\u0dd4\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0dc0\u0dbb\u0ddd\u0dba\u0dca\u0dc2.\u0d9a\u0db0\u0d9c\u0db8:\u0daf\u0dc3\u0dcf\u0d9a\u0dc0\u0dca \u0dd2\u0dba\u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9a\u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0daf\u0d9a\u0dca\u200d\u0db8\u0dba\u0dd2\u0d9a\u0d85\u0ddd\u0db4\u0dca\u0d9a\u0dca\u200d\u0daf\u0dad\u0dca\u0dca\u200d\u0daf\u0dad\u0dca\u0d9a\u0ddd\u0daf\u0dca\u0dba\u0dcf\u0daf\u0db6\u0db1\u0dba \u0d9a\u0ddd\u0d9c\u0db1\u0daf\u0ddd\u0daf.\u0d9a\u0db8 \u0d9a\u0db8\u0dca\u200d\u0db4\u0dba\u0dd2,\u0d9a\u0db8\u0db8\u0d9a\u0db4\u0dca\u200d\u0dbb\u0daf\u0ddd\u0daf\u0dca\u0dba \u0dba\u0d9a\u0dc3\u0dcf\u0dcf\u0daf\u0dc0 \u0d9a\u0d9c\u0dd2\u0dba\u0d9a\u0dcf\u0dc5\u0db8\u0dd4\u0dc0\u0dd0\u0dd2\u0dba\u0d9a:\u0dc0\u0ddd\u0dc3\u0dcf\u0dda\u0d9a\u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dd0\u0db1\u0dd3\u0ddd\u0dda\u0d9a\u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc0\u0dba \u0d9a\u0db8\u0ddd \u0d9a\u0db4\u0dd2\u0dba\u0daf\u0dad\u0dca\u0d9a\u0d9a\u0d86\u0dc0\u0daf.\u0d9a\u0d8a \u0d9a\u0dcf\u0dc3\u0dcf\u0db1\u0ddd\u0dc3\u0dcf\u0dda\u0d9a\u0db1\u0dd0\u0dc0\u0dca\u200d\u0dad\u0dca\u0d9a\u0d92\u0d9a\u0dc3\u0dcf\u0dda\u0dcf\u0dca \u0db0\u0ddd\u0dba\u0dca \u0d9a\u0db4\u0dae\u0daf\u0d9a\u0db4\u0ddd\u0dc5\u0dda\u0d9a\u0db1\u0dd0\u0dc4\u0dd0.\u0d9a\u0d9a\u0d92\u0d9a\u0dc0\u0daf\u0ddd \u0db8\u0d9a\u0db8\u0db8\u0d9a\u0dcf\u0dc5\u0daf\u0dad\u0dca\u0d9a\u0dc3\u0dcf\u0dcf\u0daf\u0dc0 \u0d9a\u0ddd:\u0dc3\u0dcf\u0dd0\u0dbb\u0dba\u0dca\u0dc2\u0d9a\u0ddd\u0dad\u0dca\u0dbb\u0dd4\u0dab\u0daf.\u0d9a\u0ddd:\u0dc3\u0dcf\u0dd0\u0dbb\u0dba\u0dca\u0dc2\u0d9a\u0ddd\u0dad\u0dca\u0dbb\u0dd2\u0db6\u0daf\u0d9a\u0dcf\u0dc5\u0daf\u0dad\u0dca\u0d9a\u0dc3\u0dcf\u0dcf\u0daf\u0d9a\u0db8\u0dca \u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0ddd\u0dba\u0dca\u0dc2\u0d9a\u0dc4\u0dd0\u0da7\u0dd2\u0dba \u0d9a\u0db4 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0d9a\u0db4\u0dc5\u0daf.\u0d9a\u0db4\u0dc0:\u0daf\u0dc0\u0dad\u0dca\u0d9a\u0dca\u200d\u0daf\u0dad\u0dca\u0dca\u200d\u0daf\u0d9a\u0dcf\u0dc5\u0daf\u0dad\u0dca\u0d9a\u0dc3\u0dcf\u0dcf\u0daf\u0dc0 \u0d9a\u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0db6\u0daf\u0d9a\u0dad\u0dd2\u0db6\u0dd4\u0ddd\u0dab\u0dca\u0d9a\u0db1\u0dd0\u0dc4\u0dd0.\u0d9a\u0d92\u0d9a\u0dc0\u0daf\u0ddd \u0db8\u0d9a\u0db8\u0db8\u0d9a\u0dcf\u0dc5\u0db8\u0dd4\u0d9a\u0dc3\u0dcf\u0dd0\u0ddd\u0d9c\u0d9a\u0dcf\u0daf\u0d9c\u0dbd\u0dd2\u0ddd\u0dda\u0dca \u0dad\u0dd4\u0db8\u0dc0 \u0d9a\u0dbb\u0db1\u0d9a:\u0dc0\u0ddd\u0dc3\u0dcf\u0dda\u0d9a\u0dca\u200d\u0daf\u0dad\u0dca\u0dca\u200d\u0daf\u0d9a\u0dcf\u0daf\u0d9c\u0dbd\u0dd2\u0ddd\u0dda\u0dca \u0dad\u0dd4\u0db8\u0dc0 \u0d9a\u0d86\u0dc0\u0daf.\u0d9a\u0d8a \u0d9a\u0dcf\u0dc3\u0dcf\u0db1\u0ddd\u0dc3\u0dcf\u0dda\u0d9a\u0d86\u0dcf\u0dc3\u0dd4\u0d9a\u0ddd:\u0dc3\u0dcf\u0dd0\u0dbb\u0dba\u0dca\u0dc2\u0d9a\u0db8\u0db8\u0d9a\u0da2\u0dba\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dab\u0dba\u0d9a\u0db4\u0dc5\u0daf.\u0d9a\u0db1\u0db8\u0dd4\u0dad\u0dca\u0d9a\u0db1\u0dd0\u0dc0\u0dca\u200d\u0d9a\u0dbb\u0dad\u0dd4\u0db8\u0db8\u0daf\u0d9a\u0d86\u0ddd\u0daf\u0d9a\u0db1\u0dd0\u0dc4\u0dd0.\u0d9a\u0d89\u0dad\u0dd2\u0dca \u0d9a\u0dbb\u0dad\u0dd4\u0db8\u0db8\u0daf \u0d9a\u0dc0\u0dd4\u0dc0\u0db8\u0db1\u0daf\u0dc0\u0dca\u0dc2\u0d9a\u0dad\u0dd2\u0db6\u0dd4\u0ddd\u0dab\u0dca\u0d9a\u0db1\u0dd0\u0dc4\u0dd0,\u0d9a\u0db4\u0dca\u200d\u0dbb\u0dc3\u0dd2\u0daf\u0dca\u0db0\u0dd2\u0dba\u0dca\u0dc2\u0d9a\u0d9c\u0dca \u0db1,\u0d9a\u0dbb\u0ddd\u0dc4\u0db8\u0d9a\u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda\u0d9a\u0db1\u0db8\u0d9a\u0d89\u0dc3\u0dcf\u0db1\u0dc3\u0dcf\u0dbb\u0dc4 \u0d9a\u0ddd\u0d9c\u0dd2\u0dba\u0dba\u0dca \u0db1.\u0d9a\u0d92\u0d9a\u0dc0\u0daf\u0ddd \u0db8\u0d9a\u0dbb\u0dad\u0dd4\u0db8\u0db8\u0daf\u0d9a\u0d9c\u0dd0\u0db1\u0d9a\u0db4\u0dae\u0daf\u0d9a\u0db4\u0dbb\u0db1\u0dc0\u0daf \u0d9a\u0db4\u0dc0:\u0daf\u0dc0\u0dad\u0dca\u0d9a\u0db4\u0dd0\u0db8\u0dad\u0dd2\u0d9a\u0dc0\u0dd4\u0ddd\u0dab\u0dca\u0d9a\u0db1\u0dd0\u0dc4\u0dd0.\u0d9a\u0dbb\u0dad\u0dd4\u0db8\u0db8\u0daf\u0d9a\u0dc0\u0dd0\u0da9\u0d9a\u0db4\u0dc5\u0daf\u0d9a\u0dcf\u0db8\u0dab\u0dba\u0dd2.\u0d9a\u0d85\u0ddd\u0db4\u0dca\u0d9a\u0d9c\u0dba\u0dca \u0dca\u200d\u0d9a\u0db4\u0dbb\u0dd4\u0dab\u0daf\u0dad\u0dd2\u0db6\u0db4\u0d9a\u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0daf\u0d9a\u0dd2\u0dbb\u0daf\u0dc0\u0daf\u0d9a\u0dc0\u0daf\u0ddd ,\u0d9a\u0d85\u0ddd\u0db4\u0dca\u0d9a\u0d9c\u0dbb\u0dd4\u0d9a\u0dc0\u0dd2\u0dcf\u0dca\u0dc2\u0dc2\u0d9a\u0db1\u0daf\u0dba\u0db4\u0dad\u0dd4\u0db8\u0db8\u0daf\u0dad\u0dca\u0d9a\u0dd2\u0dbb\u0daf\u0dc0\u0daf\u0d9a\u0dc0\u0daf\u0ddd \u0d9a\u0dbb\u0dad\u0dd4\u0db8\u0db8\u0daf\u0d9a\u0dcf\u0daf\u0d9c\u0dbd\u0dd2\u0ddd\u0dda\u0dca \u0dad\u0dd4\u0db8\u0dc0\u0d9a\u0dad\u0dd4\u0db8\u0dc5\u0d9a\u0dc0\u0dd2\u0dba\u0daf\u0db6\u0d9a\u0dc0\u0dd0\u0da9\u0d9a\u0ddd\u0db4\u0ddc \u0dc3\u0dcf\u0dca\u0dc2\u0d9a\u0db4\u0dc5\u0daf.\u0d9a\u0dcf\u0dca\u0dc2\u0dc2\u0dba\u0dca\u0dc2\u0d9a\u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0d9a\u0d9c\u0dad\u0dca\u0ddd\u0dca\u200d\u0ddc\u0dad\u0dca,\u0d9a\u0dca\u200d\u0daf\u0dad\u0dca\u0dca\u200d\u0daf\u0d9a\u0dc1\u0dca\u200d\u0dbb\u0dd3\u0d9a\u0db6\u0dc0\u0db4\u0daf\u0d9a\u0dd2\u0dba:\u0dc4\u0dc3\u0dcf\u0db1\u0d9a\u0dcf\u0dca\u0dc2\u0dc2\u0dba \u0d9a\u0dc3\u0dcf\u0dda\u0dcf\u0dca \u0db0\u0d9a\u0ddd\u0dc0\u0db6\u0daf\u0d9a\u0dcf\u0dab\u0dca\u0da9\u0daf\u0dbb\u0db1\u0daf\u0dba\u0db4\u0d9a\u0db8\u0dd0\u0dad\u0dd2\u0dd2\u0dba\u0dba\u0ddd\u0d9c\u0dca \u0d9a\u0db6\u0dcf\u0db4\u0dd4\u0d9a\u0ddd\u0daf\u0dca\u0dba\u0dcf\u0daf\u0db6\u0db1\u0d9a\u0d85\u0dad\u0dca:\u0dd0\u0dba\u0d9a\u0dda\u0d9a\u0dbb\u0dca\u0dc2\u0db4\u0dba\u0dd2\u0d9a\u0ddd\u0daf\u0dca\u0dba\u0dcf\u0daf\u0db6\u0db1\u0dba\u0d9a\u0ddd\u0db4\u0dbb\u0dd4\u0ddd\u0daf.\u0d9a\u0d92\u0d9a\u0dd2\u0dba\u0dc3\u0dcf\u0daf\u0db8\u0d9a\u0dc0\u0dd2\u0dba\u0daf\u0db6\u0d9a\u0dc0\u0dd0\u0da9\u0d9a\u0ddd\u0db4\u0ddc \u0dc3\u0dcf\u0dca\u0dc2\u0d9a\u0db4\u0dc5\u0daf.\u0d9a\n\n\u0d92\u0d9a\u0dc0\u0daf\u0ddd \u0db8,\u0d9a\u0dd2\u0dc0 \u0db4\u0dd4\u0d9a\u0da2\u0db1\u0daf\u0db0\u0dd2\u0dcf\u0dad\u0dd2\u0d9a\u0db8\u0dd2\u0dc0\u0dca :\u0d9a\u0dbb\u0daf\u0da2\u0dcf\u0dca\u0dc2\u0dc2\u0d9a\u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0daf\u0d9a\u0dc3\u0dcf\u0db8\u0dd9\u0dad\u0dca\u0d9a\u0dbb\u0dad\u0dd4\u0db8\u0db8\u0daf\u0d9a\u0dd2\u0dc0\u0dca\u200d\u0dc0\u0dad\u0dca.\u0d9a\u0d9a\u0dbb\u0dad\u0dd4\u0db8\u0db8\u0daf\u0dc0\u0d9a\u0dc5\u0d9f\u0dd2\u0dca \u0d9a\u0d86\u0dc1\u0dca\u200d\u0dbb\u0dba\u0d9a\u0db4\u0dc5\u0daf.\u0d9a\u0db8\u0db8\u0d9a\u0dd2\u0dc0\u0dca\u200d\u0db1\u0d9a\u0dc0\u0dd2\u0db0\u0dd2\u0dba ,\u0d9a\u0dca\u200d\u0daf\u0dad\u0dca\u0dca\u200d\u0daf\u0d9a\u0dc0\u0dd2\u0dca\u200d\u0daf\u0dbb\u0dca \u0ddd:\u0dab\u0dd2\u0dba\u0d9a\u0d89\u0dc3\u0dcf\u0db1\u0ddd\u0db4 \u0ddd\u0dbd\u0dca\u0d9a\u0dc0\u0dd0\u0da9\u0d9a\u0db4\u0dbb\u0db4\u0dd4\u0d9a\u0db4\u0daf\u0db6\u0ddd\u0dda\u0d9a\u0d89\u0db3\u0db6\u0daf\u0d9a\u0db8\u0dd2\u0dc0\u0dca :\u0d9a\u0dbb\u0daf\u0da2\u0dcf\u0dca\u0dc2\u0dc2\u0d9a\u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0daf\u0dad\u0dca\u0d9a\u0dbb\u0dca\u0dc2\u0db4\u0d9a\u0dc5\u0d9f\u0dd2\u0dca \u0d9a\u0ddd\u0daf\u0dca\u0dba\u0dcf\u0daf\u0db6\u0db1\u0dba\u0d9a\u0db4\u0dc5\u0daf;\u0d9a\u0d86\u0dc1\u0dca\u200d\u0dbb\u0dba\u0d9a\u0db4\u0dc5\u0daf.\u0d9a\u0d92\u0d9a\u0dd2\u0dba\u0dc3\u0dcf\u0daf\u0d9a\u0dbb\u0dca\u0dc2\u0dc0\u0daf\u0db1\u0d9a\u0d86\u0dc3\u0dcf\u0db1\u0ddd\u0dda\u0d9a\u0da2\u0db1\u0dca\u200d\u0daf\u0dc0 \u0d9a\u0dbb\u0dad\u0dd4\u0db8\u0db8\u0daf\u0ddd\u0d9c\u0dca \u0d9a\u0dc0\u0dd2\u0dba\u0daf\u0db6\u0d9a\u0dc0\u0dd0\u0da9\u0d9a\u0ddd\u0db4\u0ddc \u0dc3\u0dcf\u0dca\u0dc2\u0d9a\u0db4\u0dbb\u0d9c\u0dca \u0db1\u0d9a\u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0d9a\u0dc0\u0dd4\u0dab\u0daf."
  },
