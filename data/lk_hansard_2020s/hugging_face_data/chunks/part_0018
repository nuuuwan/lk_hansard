    "chunk_text": "\u0d92 \u0daf\u0dc0\u0dca\u0dda\u0dc0\u0dbd \u0db4\u0db4\u0dd2 \u0db4\u0ddc\u0dca\u0dbd\u0dca \u0dc1\u0dd2\u0dc2\u0dba\u0db1\u0dba\u0dcf \u0dba. 1980-90 \u0daf \u0d9a\u0db1\u0dda \u0dad\u0db8\u0db1\u0dca \u0db1\u0db8\u0dca\u0dc0\u0ddc \u0d89\u0dca\u0dda\u0dca\u0dbb\u0dc4\u0da7 \u0d86\u0db1 . \u0db8\u0dd6\u0dbd\u0ddc\u0dca\u0db1\u0ddc\u0dbb\u0dd6\u0daa \u0dbb\u0dbb\u0dd4 \u0db8 \u0dd3\u0dd4\u0dc5\u0db8\u0dd4\u0dad, \u0d9a\u0dd4\u0dd4 \u0d86\u0db1 \u0dc4\u0dd4 \u0d9f\u0da7 \u0db1\u0db1\u0ddc\u0db1\u0dc0\u0db1\u0dca. \u0d9a\u0dd4\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0db1\u0dc1 \u0db4\u0ddc\u0db1\u0dc0\u0dbd\u0ddc \u0d86\u0db1 \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0dd6\u0dbd\u0ddc\u0dca\u0db1\u0ddc\u0dbb\u0dd6\u0daa \u0dbb\u0dbb\u0dd4 \u0db8 \u0dd3\u0dd4\u0dc5\u0db8\u0dd4\u0dad, \u0daf\u0dd0 \u0db1\u0db8\u0dca \u0db8\u0dd4\u0dc4\u0dd4\u0db1\u0dc1 \u0db4\u0ddc\u0db1\u0dc0\u0dbd\u0ddc\u0dad\u0dca\u0daf\u0dca\u200d \u0d9a\u0dd4\u0dd4 \u0d91\u0db1\u0dc0\u0ddc. \u0db1\u0db8\u0ddc\u0d9a\u0daf, \u0daf\u0dd0 \u0dca\u0dd0\u0db4\u0dba\u0dd4\u0db8\u0dca \u0db8\u0ddc\u0dbb\u0dca\u0dbb \u0dca\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab\u0db1\u0dba\u0dcf \u0db8 \u0db4\u0dc0\u0dc4\u0dd2\u0dbb \u0db1\u0dc0\u0dbd\u0ddc \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0ddc. \u0db1\u0ddc\u0dc0\u0dd2\u0d9a \u0dc4\u0db8\u0dd4\u0daf\u0ddc\u0dc0 \u0daf\u0dd0 \u0db1\u0dbd\u0ddc\u0d9a\u0dd4 \u0db1\u0db8\u0db1\u0dc4\u0dba\u0dd4\u0db8\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0ddc. \u0d92 \u0dd4\u0dad\u0dca\u0ddc \u0daf\u0dd0 \u0dca\u0db8\u0dc4\u0dbb \u0db1\u0dc0\u0dbd\u0ddc\u0dc0\u0da7 \u0db8\u0dd4\u0dc4\u0dd4\u0db1\u0dc1 \u0db4\u0ddc\u0db1\u0dc0\u0dbd \u0d91 \u0db1 \u0db4\u0ddc\u0dd2\u0dbb\u0dca\u0dda\u0dad\u0ddc\u0db1\u0db1\u0dda \u0d89\u0db3 \u0d9a\u0dd4\u0dd4 \u0db1\u0dbb\u0dba\u0dd4\u0dad \u0daf\u0ddc\u0db1\u0dc0\u0ddc. \u0d92 \u0dca\u0db3\u0dc4\u0ddc \u0db0\u0dd3\u0dc0\u0dbb \u0dba\u0dcf \u0ddc\u0dad\u0dca\u200d\u0dbb\u0ddc \u0db1\u0dba\u0dcf \u0ddc\u0daf\u0ddc\u0dbb \u0db1\u0dc0\u0ddc \u0dd2\u0dbb\u0dba\u0dcf \u0dbd\u0ddc \u0db4\u0db4\u0da7 \u0d86\u0dbb\u0dc0\u0da0\u0dd2\u0dba\u0dcf \u0d9a\u0dca \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0ddc. \u0dca\u0dc0\u0dc0\u0dd2\u0db0\u0ddc\u0db1\u0ddc\u0dad\u0dca\u0daf\u0dca\u200d\u0db8\u0d9a\u0dc0 \u0dad\u0db8\u0db1\u0dca \u0db1\u0db8\u0dca\u0dc0\u0ddc \u0d86\u0db1 . \u0db1\u0db8\u0ddc\u0d9a\u0daf, \u0dca\u0db8\u0ddc\u0da2, \u0db1\u0dc1 \u0db4\u0ddc\u0dbd\u0db1 \u0dca\u0dc0\u0dca\u0dda\u0d9a\u0dd8\u0dad\u0dd2\u0dba\u0dcf \u0db1\u0dc0\u0db1\u0dca\u0dda \u0dd2\u0dbb\u0dd3\u0db8\u0db1\u0db8\u0dca \u0dd4\u0dbb\u0dc0\u0db8\u0db1\u0ddc\u0dc0\u0d9a\u0dca \u0d91\u0daf\u0ddc \u0db4\u0ddc\u0dbd\u0db1\u0dba\u0dcf \u0da7 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0ddc. \u0d92\u0d9a \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba\u0dcf \u0dad\u0dca\u0daf\u0dca\u200d \u0d91\u0d9a\u0dca\u0d9a \u0db6\u0dd0\u0db3\u0dd2\u0da0\u0dca\u0da0 \u0dad\u0dad\u0dca\u0daf\u0dca\u200d\u0dad\u0dca\u0daf\u0dca\u200d\u0dc0\u0dba\u0dcf \u0d9a\u0dca. \u0d91\u0dad\u0db1\u0d9a\u0ddc\u0da7 \u0d92\u0d9a\u0da7 \u0d9a\u0dc0 \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba\u0dcf \u0d9a\u0dca, \u0db4\u0ddc\u0daf\u0da9 \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba\u0dcf \u0d9a\u0dca, \u0db4\u0ddc\u0daf\u0da9 \u0db1\u0dc1 \u0db4\u0ddc\u0dbd\u0db1 \u0dca\u0dc0\u0dca\u0dda\u0d9a\u0dd8\u0dad\u0dd2\u0dba\u0dcf \u0d9a\u0dca \u0d95\u0db1\u0dd1 \u0db1\u0dc0\u0dbd\u0ddc \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0ddc. \u0db4 \u0db1 \u0d92 \u0db4\u0ddc\u0daf\u0da9 \u0db1\u0dc1 \u0db4\u0ddc\u0dbd\u0db1 \u0dca\u0dc0\u0dca\u0dda\u0d9a\u0dd8\u0dad\u0dd2\u0dba\u0dcf \u0dad\u0db8\u0db1\u0dca \u0d91\u0daf\u0ddc 1980-90 \u0daf \u0d9a\u0db1\u0dda \u0db4\u0da7 \u0dbb\u0dad\u0dca\u0daf\u0dca\u200d\u0db1\u0dad\u0dca\u0daf\u0dca\u200d. \u0db8\u0dd6\u0dbd\u0ddc\u0dca\u0db1\u0ddc\u0dbb\u0dd6\u0daa \u0dbb\u0dbb\u0dd4 \u0db8 \u0dd3\u0dd4\u0dc5\u0db8\u0dd4\u0dad, 1980-90 \u0daf \u0d9a\u0db1\u0dda \u0db1\u0db8\u0dca \u0db1\u0db8\u0dca\u0dc0\u0ddc \u0db4\u0da7 \u0dbb\u0dad\u0dca\u0daf\u0dca\u200d\u0db1\u0dad\u0dca\u0daf\u0dca\u200d, \u0db4\u0daf \u0db4\u0db4\u0dd2 \u0d9a \u0ddc \u0d9a\u0dbb \u0db1 2025 \u0db4\u0dd4\u0dbb\u0dbb\u0dd4\u0dc1\u0db1\u0dc1. \u0d92 \u0dd2\u0dbb\u0dba\u0dcf \u0db1 \u0db4\u0dd4\u0dbb\u0dbb\u0dd4\u0daf\u0dd4 \u0dc4\u0dad\u0dc5\u0dd2\u0dca\u0dda \u0dbb\u0dab\u0db1\u0d9a\u0dca \u0d92 \u0db4\u0ddc\u0daf\u0da9 \u0dca\u0dc0\u0dca\u0dda\u0d9a\u0dd8\u0dad\u0dd2\u0dba\u0dcf , \u0d9a\u0dd4\u0dd4 \u0dca\u0dc0\u0dca\u0dda\u0d9a\u0dd8\u0dad\u0dd2\u0dba\u0dcf \u0db1\u0dd0\u0dad\u0dd2 \u0d9a\u0dbb \u0db1 \u0dad\u0dd2\u0db6\u0dd2\u0da0\u0dca\u0da0 \u0db4\u0ddc\u0dbd\u0db1\u0dba\u0dcf \u0da7 \u0db6\u0dd0\u0dbb\u0dd2 \u0db1\u0dc0\u0dbd\u0ddc \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0ddc.\n\n\u0dc0\u0dd2\u0db1 \u0dda\u0dc2\u0db1\u0dba\u0dcf \u0db8 \u0db8\u0dc4\u0da2\u0db1 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0dd4\u0db8\u0dad\u0dd2\u0dd4\u0dc5\u0db8\u0ddc \u0dd4\u0dd4\u0dc5\u0dc0 \u0db4\u0db4\u0dd2 \u0dc4\u0dd0\u0db1\u0db8\u0dba\u0db8 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0dcf \u0da7 \u0db1\u0db8\u0dca \u0d8b\u0dad\u0dca\u0daf\u0dca\u200d\u0dca\u0ddc\u0dc4 \u0d9a\u0dbb \u0db1 \u0db1\u0dc4\u0ddc\u0dbb\u0dbb\u0dbd\u0dca \u0db4\u0dc4\u0dd4\u0dbd \u0db1 \u0db1\u0dd0\u0dd4\u0dc5\u0dc0 \u0db1\u0db8\u0dca\u0dc0\u0ddc \u0dca\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab\u0db1\u0dba\u0dcf \u0db1\u0db8\u0dca \u0dbb\u0da7\u0dd2 \u0d89\u0dc0\u0dad\u0dca\u0daf\u0dca\u200d \u0d9a\u0dbb \u0db1\u0db1\u0dca. \u0d92 \u0dca\u0db3\u0dc4\u0ddc \u0dad\u0db8\u0db1\u0dca \u0db1\u0db8\u0dca \u0dc4\u0dd0\u0db1\u0db8\u0dba\u0da7\u0db8 \u0dbd\u0db6\u0db1 \u0d94\u0d9a\u0dca\u0db1\u0dad\u0dba\u0db6\u0dbb\u0dca 30\u0dc0\u0dd0\u0dd4\u0dad \u0daf\u0ddc \u0dc3\u0dd4\u0dbb\u0dad\u0daf\u0ddc\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0ddc\u0dc0\u0dbb\u0dab\u0dba\u0dcf \u0da7 \u0d91 \u0db1 \u0dd2\u0dbb\u0dba\u0dcf \u0dbd\u0ddc \u0d9a\u0dd0\u0db3\u0dc0\u0dd3\u0db8\u0d9a\u0dca \u0d9a\u0dbb\u0dbd\u0ddc \u0dad\u0dd2\u0db1\u0db6 \u0db1 . \u0d92 \u0dd4\u0dad\u0dca\u0ddc \u0d94\u0db6\u0dd4\u0dc5\u0db8 \u0dbd\u0ddc \u0db4\u0daf \u0dd4\u0db3\u0db1\u0dbb\u0db1 \u0d91 \u0db1 \u0dad\u0dd2\u0db6\u0dd4\u0db1\u0dab\u0dca\u0da9 \u0d9a\u0dc0 \u0dd4\u0db8\u0dca\u0db8\u0dca \u0db1\u0db1\u0ddc\u0db1\u0dc0\u0db1\u0dca. \u0d9a\u0dc0 \u0dd4\u0db3\u0db1\u0dbb\u0db1 \u0d91\u0db1\u0dc0\u0ddc \u0db1\u0db8\u0dca \u0d94\u0dc0\u0db1 \u0d89\u0db3 \u0d9a\u0dc0\u0dc0\u0dd2 \u0dc0\u0dc4\u0db1\u0dbb\u0db1\u0db1\u0dca \u0d91 \u0db1 \u0dad\u0dd2\u0db6\u0dd4\u0db1\u0dab\u0dca\u0da9. \u0dc4\u0dbb\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba\u0dcf \u0dad\u0db8\u0db1\u0dca \u0d94\u0dc0\u0db1 \u0d89\u0db3 \u0d9a\u0dc0\u0dc0\u0dd2 \u0dc0\u0dc4\u0dbb \u0db1 \u0d91\u0d9a. \u0daf\u0ddc\u0dbb \u0db1\u0dc0\u0ddc \u0db1\u0db8\u0dca \u0d9a\u0dc0 \u0db1\u0dbd\u0dba\u0dc0\u0db1\u0dc0\u0d9a\u0dca \u0daf\u0ddc\u0dbb \u0db1 \u0d95\u0db1\u0dd1. \u0db4\u0daf \u0db1\u0db8\u0dca \u0dc0\u0dd2\u0dc0\u0ddc\u0daf\u0db1\u0dda\u0daf\u0dd3\u0dad\u0dca\u0daf\u0dca\u200d \u0d9a\u0db1 \u0dda, \u0db4\u0dd4\u0dbb\u0dbb\u0dd4\u0daf\u0dd4 \u0dc4\u0dad\u0dc5\u0dd2\u0dca\u0dda \u0dbb\u0dab\u0db1\u0d9a\u0dca \u0db1\u0dc4\u0ddc\u0dbb \u0dbb\u0dbd\u0dca \u0dd4\u0dc4\u0dd2\u0dbd\u0dd4\u0dc0\u0ddc \u0dc0\u0ddc\u0db1\u0dda \u0db1\u0dc4\u0ddc\u0dbb\u0dbb\u0dbd\u0dca \u0dd4\u0dc4\u0dd2\u0dbd\u0dd4\u0dc0 \u0d91\u0d9a. \u0dd2\u0dbb\u0dd2\u0dc0\u0db8 \u0db1\u0d9a\u0db1\u0db1\u0d9a\u0dca \u0db1\u0db8\u0dca \u0db1\u0dba\u0dcf \u0dba\u0da2\u0db1\u0ddc\u0db1 \u0dca\u0db8\u0ddc\u0da2 \u0dd4\u0dbb\u0dc0\u0db8\u0db1\u0ddc\u0dc0, \u0dbb\u0db1\u0da7\u0dca \u0dd4\u0dbb\u0dc0\u0db8\u0db1\u0ddc\u0dc0 \u0dca\u0db8\u0dca\u0db6 \u0db0\u0db1\u0dba\u0dcf \u0d91\u0d9a \u0dc0\u0da0\u0db1\u0dba\u0dcf \u0d9a\u0dca \u0dd2\u0dbb \u0db1 \u0db1\u0dd0\u0dc4\u0dd0. \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0db1\u0dda \u0dd2\u0dbb\u0dd2\u0dc0\u0db8 \u0db1\u0d9a\u0db1\u0db1\u0d9a\u0dca \u0d92 \u0dbb\u0dd0\u0db1 \u0d91\u0d9a \u0dc0\u0da0\u0db1\u0dba\u0dcf \u0d9a\u0dca \u0dd2\u0dbb \u0db1 \u0db1\u0dd0\u0dc4\u0dd0. \u0db4\u0dc4\u0dc0\u0dbd\u0ddc \u0db1\u0db8 \u0db1 \u0db1\u0db8\u0dca\u0d9a \u0dd2\u0dbb \u0dc0\u0ddc\u0dba\u0dcf \u0dd2\u0dbb\u0dba\u0dcf \u0dbd\u0ddc \u0db4\u0dd4\u0dc0\u0dc0 \u0db1\u0db8\u0dca \u0db8\u0da7 \u0dd2\u0dbb\u0dba\u0dcf \u0db1. \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0db1\u0dc1\u0dc0\u0dbd\u0dca \u0dd2\u0dbb\u0dba\u0dcf \u0dbd\u0ddc \u0d89\u0dc0\u0dbb \u0db1\u0dc0\u0dbd\u0ddc, \u0db4\u0db4\u0dd2\u0dad\u0dca\u0daf\u0dca\u200d \u0db1\u0db8\u0dca\u0d9a\u0da7 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0db1\u0dca \u0dd2\u0dbb\u0dba\u0dcf \u0dbd\u0ddc \u0d89\u0db3\u0dbd\u0ddc \u0dc4\u0dd2\u0da7\u0dbd\u0ddc \u0db1\u0d9a\u0db1\u0db1\u0d9a\u0dca \u0dd4\u0da7\u0dca\u0da7\u0d9a\u0dca \u0dd2\u0dbb \u0dc0\u0ddc. \u0d91\u0da0\u0dca\u0da0\u0dbb\u0db1\u0dca. \u0dc4\u0dd0\u0db6\u0dd0\u0db1\u0dca \u0dd4\u0dad\u0dca\u0daf\u0dca\u200d\u0dad, \u0db4\u0dc0\u0dc0\u0d9a \u0dd4\u0dbb\u0dc0\u0db8\u0db1\u0ddc\u0dc0\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0dd6\u0dbd\u0ddc\u0dca\u0ddc\u0db1\u0dbb\u0dd6\u0daa \u0dbb\u0dbb\u0dd4 \u0db8 \u0dd3\u0dd4\u0dc5\u0db8\u0dd4\u0dad, \u0dc4\u0dd0\u0db6\u0dd0\u0db1\u0dca \u0dbb\u0da7\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0dcf \u0da7, \u0dca\u0db8\u0ddc\u0da2\u0dba\u0dcf \u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0dcf \u0da7 \u0db1\u0db8\u0dca \u0dd4\u0dbb\u0dc0\u0db8\u0db1\u0ddc\u0dc0 \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0ddc."
