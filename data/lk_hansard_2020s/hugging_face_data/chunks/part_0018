    "chunk_text": "\u0dd4\u0dd4\u0dc5\u0db1 \u0dda\u0dad\u0dca\u0daf\u0dca\u200d \u0d92\u0d9a \u0db1\u0dc0\u0db1\u0dca\u0daf \u0daf \u0db1 \u0db1\u0dd0\u0dc4\u0dd0. \u0db1\u0db8\u0ddc\u0d9a\u0daf, 1987 \u0d9a\u0ddc\u0dbd\u0db1\u0dda \u0db1\u0db8\u0dca \u0db4\u0ddc\u0dbb\u0dca\u0dd2\u0db1\u0db8\u0dca \u0dd4\u0dc5\u0dc0\u0da7 \u0db1\u0d9c\u0dca\u200d\u0dbb\u0db1 \u0da9\u0dca \u0d91\u0d9a\u0d9a\u0dca \u0dbb\u0dc4\u0db4\u0dd4 \u0d8b\u0daf\u0dc0\u0dd2\u0dba\u0dcf \u0dad\u0db8\u0db1\u0dca \u0db4\u0daf \u0db6\u0dbd\u0db1\u0dda \u0d89 \u0db1 . \u0db1\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0daf \u0dad\u0dd2\u0db1\u0db6\u0db1 \u0dca\u0dc4\u0dad\u0dd2\u0d9a\u0dba\u0dcf , \u0db4\u0ddc\u0dbb\u0dca\u0dd2\u0db1\u0db8\u0dca \u0dd4\u0dc5\u0db1 \u0d91\u0db1\u0dc4\u0db8 \u0db1\u0dc0 \u0db1 \u0db1\u0dd0\u0dc4\u0dd0 \u0dd2\u0dbb\u0dba\u0dcf \u0db1? \u0d91\u0daf\u0ddc \u0d89 \u0daf\u0dd4-\u0dbd\u0dc0\u0d9a\u0ddc \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8 \u0d91\u0db1\u0db1\u0d9a\u0ddc\u0da7 \u0db4\u0ddc\u0dbb\u0dca\u0dd2\u0db1\u0db8\u0dca \u0dd4\u0dc5\u0dc0\u0da7 \u0db1\u0d9c\u0dca\u200d\u0dbb\u0db1 \u0da9\u0dca \u0d91\u0d9a\u0d9a\u0dca \u0dbb\u0dd0\u0dc4\u0dd4\u0dc0\u0ddc. \u0d92 \u0db1\u0d9c\u0dca\u200d\u0dbb\u0db1 \u0da9\u0dca \u0d91\u0d9a \u0dbb\u0dc4\u0db4\u0dd4 \u0d8b\u0daf\u0dc0\u0dd2\u0dba\u0dcf \u0dad\u0db8\u0db1\u0dca \u0db4\u0daf \u0db6\u0dbd\u0dba\u0dcf \u0db4\u0dbb\u0db1\u0dbb\u0db1 \u0dad\u0dd2\u0db1\u0db6 \u0db1 . \u0db1\u0d9a\u0ddc\u0db1\u0dc4\u0ddc\u0db8\u0daf, \u0d91\u0db1\u0dc4\u0db8 \u0db1\u0dc0 \u0db1 \u0db1\u0dd0\u0dc4\u0dd0 \u0dd2\u0dbb\u0dba\u0dcf \u0db1 ? \u0d92\u0d9a\u0dad\u0dca\u0daf\u0dca\u200d \u0db1\u0dc0 \u0db1 \u0db4\u0dd4\u0dc0\u0dc0 ."
  },
