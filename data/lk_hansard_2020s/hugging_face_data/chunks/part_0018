    "chunk_text": "\u0db4\u0dcf\u0db1\u0dd3\u0dba \u0da2\u0dbd \u0dc3\u0dd0\u0db4\u0dd4\u0dad\u0dc0\u0db8\u0db1\u0dca \u0dc0\u0dda \u0dd9\u0db1 \u0dd2\u0dc3\u0da7 \u0dc3\u0db4\u0dd4\u0dba\u0dcf \u0d87\u0dad\u0dca\u0dc0\u0dad\u0dca \u0d82\u0dd9\u0dc1\u0dba\u0dad\u0dcf\u0dc0\u0dd9\u0db1\u0dca \u0dd2\u0db1\u0dba\u0dba\u0da7 0 \u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0db4\u0db8\u0dab\u0dba\u0dd2. \u0dd2\u0dc5\u0dbb\u0dd2\u0dd2\u0db1\u0db1\u0dca \u0db4\u0dcf\u0db1\u0dd3\u0dba \u0da2\u0dbd\u0dba \u0dbd\u0dd9\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0dc0\u0db1\u0dcf\u0db8\u0dd0\u0dad\u0dd2 \u0dd3\u0db8 \u0da2\u0db1\u0dad\u0dcf\u0dd9 \u0db8\u0dd4\u0dc4\u0dd4\u0dab \u0dc0\u0daf\u0db1 \u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dd9\u0d9a\u0dca \u0dd9\u0dd9\u0da7 \u0db4\u0dad\u0dca\u0dd9 \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. \u0db1\u0dd9 \u0da2\u0dbd \u0dc3\u0dd0\u0db4\u0dd4\u0dad\u0dda \u0dca\u0dba\u0dda\u0db7 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc4\u0dcf \u0daf\u0dd0\u0db1\u0da7 \u0dca\u0dba\u0dda\u0db7 \u0dba \u0dad\u0dd2\u0dc0\u0dd9\u0db1 \u0dd9\u0dba\u0dcf\u0db4\u0dad\u0dad\u0dd2 \u0da9\u0dd2\u0db1\u0db8\u0dd2\u0db1\u0dca \u0d82\u0dd9\u0dc3\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dd2\u0db1\u0db1\u0dca \u0dba\u0db1\u0dd9\u0dcf. \u0d9c\u0dda\u0db4\u0dc4 \u0dc5\u0dd4\u0dad\u0dba \u0d82\u0db1\u0dd4\u0dba\u0dcf\u0db0\u0db4\u0dd4\u0dba \u0db8\u0dc4\u0db1\u0dd4\u0dd9\u0dba \u0dba\u0dcf\u0db4\u0db1\u0dba \u0d9a\u0dd2\u0dd2\u0dc0\u0db1\u0dcf\u0da0\u0dca\u0da0\u0dd2\u0dba \u0dc3\u0dc4 \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dc3\u0d9c\u0dbd \u0dd9\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0dc3\u0dae\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dca\u0dd9\u0dba\u0dab\u0dba \u0dba\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dcf\u0db1\u0dd3\u0dba \u0da2\u0dbd \u0dc3\u0dda\u0db4\u0dcf\u0daf\u0db1 \u0dd9\u0dba\u0dcf\u0db4\u0dad\u0dad\u0dd2 \u0dc0\u0db8\u0db1\u0dca\u0db8 \u200d\u0dbb\u0da2\u0dcf \u0da2\u0dbd \u0dc3\u0dda\u0db4\u0dcf\u0da