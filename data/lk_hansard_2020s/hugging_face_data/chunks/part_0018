    "chunk_text": "\u0dd9\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d82\u0dad\u0dba\u0dd9\u0dc1\u0dba \u0dd9\u0dcf\u0dc4\u0db1 0 4\u0d9a\u0dca \u0dc3\u0dc4 \u0db1\u0dd3\u0db1 \u0dc3\u0db1\u0dca\u0db1\u0dd2\u0dc0 \u0daf\u0db1 \u0d8b\u0db4 \u0dba\u0dab \u0dbd\u0dd9\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d82\u0db1\u0dd4\u0db8\u0dd0\u0dad\u0dd2\u0dba \u0dbd\u0dd9\u0dcf \u0da2 \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. -\u0dc0\u0db8\u0dcf \u0daf \u0d9a\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0dd9\u0dcf\u0dc4\u0db1 \u0db1\u0dd0\u0dc4\u0dd0. \u0db1\u0dd2\u0dc3\u0dcf \u0dba\u0db1\u0dca\u0db1 \u0dd2\u0dc3\u0db0\u0dd2\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \uf0d8 \u0dc0\u0dda \u0dd9\u0db1 \u0dd2\u0dc3\u0da7 \u0d89\u0daf\u0dd2 \u0dba \u0d82\u0dd9\u0dc3\u0db1\u0dca\u0dd9 \u0d91\u0dc0\u0dc4\u0dad\u0dca \u0d82\u0dd9\u0dbd\u0db1\u0dca\u0dd9 \u0dc4\u0dd2\u0db3 \u0dd9\u0dd0\u0da7\u0dd3\n\n\u0d87\u0dad\u0dd2 \u0d82\u0d9a\u0d9a\u0dca \u0d89\u0daf\u0dd2 \u0dba \u0d87\u0dad\u0dd2 \u0dc0\u0dc4\u0db6 \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd4\u0dda \u0dba \u0d87\u0dad\u0dd2\n\n\u0dc3\u0db3\u0dc4\u0dcf \u0dd2\u0dc3\u0dc0\u0dc1\u0dae\u0dc2 \u0db4\u0dd4\u0dc4\u0dd4\u0dd4 \u0dd9\u0d9a\u0dca \u0dbd\u0dd9\u0dcf \u0da2 \u0dd2\u0db1\u0dd2\u0dc3\u0db8 \u0dca\u0dba\u0d9a\u0dca\u0dc2 \u0dc0\u0dc3\u0dae\u0dd9\u0dcf\u0dc0 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca 222\u0d9a\u0dca \u0dd9\u0db1\u0da2\u0dd3\u0dd3 \u0dc0\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9 \u0dc0\u0dd9\u0dad \u0dc3\u0dae\u0dd2\u0dba \u0db4\u0daf\u0db1\u0db8\u0dd2\u0db1\u0dca \u0d82\u0db1\u0dd4\u0dd4\u0dad\u0d9a\u0dca\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc0\u0dba\u0db6\u0da2\u0db1\u0dcf \u0dba\u0db1\u0dd9\u0dcf. - 222\u0d9a\u0dca \u0dc3\u0dae\u0dd2\u0dba \u0db4\u0daf\u0db1\u0db8\u0dd2\u0db1\u0dca \u0d82\u0dd2\u0dc5 \u0da7 \u0d82\u0db1\u0dd4\u0dd4\u0dad\u0d9a\u0dca\u0dad \u0dba\u0db1\u0dd9\u0dcf. \uf0d8 \u0dd2\u0dc3\u0db1\u0dca\u0dd2 \u0dd9\u0dd0\u0da7 \u0db1\u0dd2\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0dc4\u0dcf \u0db1\u0d9a\u0dad\u0dca\u0dad\u0dd4 \u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0d82\u0db1\u0dd4\u0dd4\u0dad\u0d9a\u0dca\u0dad\n\n\u0dba\u0db1\u0dd4 \u0dbd\u0dd9\u0db1 \u0dd2\u0db1\u0dd2\u0dc3\u0db8 \u0dca\u0dba\u0d9a\u0dca\u0dc2 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0da7 \u0dca\u0dc4\u0dcf\u0dba \u0da2\u0db8\u0db1\u0dcf \u0dc4\u0dcf \u0d8b\u0db4 \u0dba\u0dab \u0db1\u0d9a\u0dad\u0dca\u0dad\u0dd4 \u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0d82\u0daf\u0dcf\u0dc5 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0da2\u0db8\u0db1\u0dcf \u0dbd\u0dd9\u0dcf \u0da2\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 \u0db8\u0dd2\u0dd2\u0dba\u0db1 39 \u0d9a\u0dca \u0dc0\u0dd9\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc0\u0dba\u0db6\u0da2\u0db1\u0dcf \u0dba\u0db1\u0dd9\u0dcf. - \u0d82\u0db1\u0dd4\u0dd4\u0dad\u0d9a\u0dca\u0dad \u0dba\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0da7 \u0dd2\u0db1\u0dd2\u0dc3\u0db8 \u0dca\u0dba\u0d9a\u0dca\u0dc2 \u0dc0\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dbd\u0dd0\u0dc0\u0dd9\u0db1 \u0dd9\u0dd0\u0da7\u0dd4\u0db4\u0da7 \u0d82\u0db8\u0dad\u0dba\u0dd9 \u0dc0\u0dda \u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dba \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dd4\u0dad\u0dca \u0da2\u0db8\u0db1\u0dcf\u0dd9\u0d9a\u0dca \u0dbd\u0dd9\u0dcf \u0dc0\u0daf\u0db1\u0dd9\u0dcf \u0d9a\u0dc0\u0dd4\u0db1\u0dca \u0daf\u0dd2\u0dbb\u0dd2 \u0d9c\u0db1\u0dca\u0dd9\u0db1\u0dca\u0db1. \uf0d8 \u0d82\u0dd2 \u0d87\u0dad\u0dd4\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dca\u0dc4\u0dcf\u0dba \u0dc3\u0dc4 \u0da2\u0dbd\u0dba \u0dbd\u0dd9\u0dcf \u0da2\u0db8 \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\n\n\u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0dab \u0dc4\u0dd2\u0dda \u0dc3\u0dc4 \u0da2\u0dbd \u0dd6\u0dbd\u0dbd\u0dcf\u200d \u0dbd\u0db8\u0db1\u0dcf \u0dba\u0dab \u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 \u0db8\u0dd2\u0dd2\u0dba\u0db1 82 \u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0db1 \u0dc0\u0dd9\u0db1\u0dca \u0dba \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. -\u0dc0\u0db8\u0dcf \u0daf \u0dd9\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dba \u0d87\u0dad\u0dd4\u0dc0\u0dc5\u0dae \u0dad\u0dd2\u0dc0\u0dd9\u0db1 \u0da2\u0dbd \u0dd6\u0dbd\u0dbd\u0dcf\u200d \u0dc4\u0dd2\u0db3 \u0dd9\u0dd0\u0da7\u0dd2\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dd9\u0db1 \u0db1\u0dd2\u0dc3\u0dcf \u0d82\u0dd2 \u0d9c\u0dda \u0dd9\u0daf\u0dd2\u0db1\u0dd9\u0dcf. \uf0d8 \u0d82\u0dd2-\u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dae \u0d9c\u0dd0\u0da7\u0dd4\u0db8 \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dd2\u0dc3\u0db1\u0dca\u0dd2 \u0dd9\u0dd0\u0da7 \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0dda\n\n\u0dc3\u0dda\u0db4\u0dd6\u0dbb\u0dbb\u0dca\u0dbd\u0dab \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d82\u0dc0\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0d82\u0dd9\u0dc1\u0dba \u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dba\u0db1\u0dca \u0dd2\u0db1\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0db1\u0da2\u0dd3\u0dd3 \u0dc3\u0dcf\u0dba\u0d9a\u0dca\u0dc2\u0dab \u0dc0\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0dc0\u0dd9\u0dad \u0dc0\u0dd9\u0db1\u0dca \u0dba \u0d87\u0dad\u0dd2 \u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0db1\u0dd9\u0dbd\u0da7 \u0d82\u0db8\u0dad\u0dba\u0dd9 -\u0d9a\u0dc0\u0dd4\u0db1\u0dca \u0d91\u0daf\u0dd2\u0dc0\u0db1\u0daf\u0dcf \u0dd9\u0dd0\u0d9a \u0dba\u0db1\u0dc0 \u0dcf\u0da7 \u0dc0\u0dda \u0dc3\u0dda\u0dd9\u0db1\u0dca\u0db0\u0dc0\u0dba\u0db1\u0dca \u0dc0\u0dba\u0db6\u0da2\u0db1\u0dcf \u0d91\u0db1\u0dd9\u0dcf \u0db1\u0dda \u0dd9\u0dd0\u0d9a \u0dba\u0db1\u0dc0 \u0dcf\u0da7 \u0d82\u0dd9\u0dc1\u0dba\u0dad\u0dcf \u0d91\u0db1\u0dd9\u0dcf \u0db1\u0dda \u0dd9\u0dcf \u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca- \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 \u0db8\u0dd2\u0dd2\u0dba\u0db1 222 \u0d82\u0dad\u0dd2\u0dc0\u0dbb\u0dca\u0dbd \u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0db1\u0dba\u0d9a\u0dca \u0dc0\u0dd9\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc0\u0dba\u0db6\u0da2\u0db1\u0dcf \u0dba\u0db1\u0dd9\u0dcf. -\u0d82\u0dd2-\u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dae \u0d9c\u0dd0\u0da7\u0dd4\u0db8\u0dd2\u0db1\u0dca \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dd3\u0dba \u0da2\u0db1\u0dad\u0dcf\u0dd9 \u0dc0\u0d85\u0da9\u0dba\u0dcf \u0d9c\u0dad \u0dd4\u0dad\u0dad\u0dd4\u0dba\u0dd2 \u0d82\u0dd2\u0db1\u0dca \u0dc0\u0d85\u0da9\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dad\u0dca \u0d95\u0db1\u0dc3 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dae\u0dc3\u0dd4 \u0dc0\u0d85\u0da9\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dad\u0dca \u0d95\u0db1\u0dc3. \uf0d8 \u0dc0\u0db8\u0db8 \u0d82\u0dd2-\u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dae \u0d9c\u0dd0\u0da7\u0dd4\u0db8 \u0d82\u0dd9\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dd2\u0dc3\u0db1\u0dca\u0dd2 \u0dd9\u0dd0\u0da7\u0dd9\u0db8\n\n\u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0dda \u0dd9\u0dd0\u0db1\u0dd2 \u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dba\u0db1\u0dca\u0dd9\u0dd2\u0db1\u0dca \u0d9a\u0d85\u0da9\u0dd9\u0da7 \u0dc0\u0d9c\u0dcf\u0dc3\u0dae \u0daf\u0dd2\u0d9c\u0dd4 \u0dcf\u0dbd\u0dd3\u0db1 \u0db4\u0dbb\u0dca\u0dbd\u0dc0\u0d86\u0dc2\u0dab \u0db4\u0dcf\u0daf \u0dd2\u0dc3\u0dc3\u0dd4\u0dab\u0dda \u0dc0\u0dc3\u0dcf\u0dba\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 \u0db8\u0dd2\u0dd2\u0dba\u0db1 2\u0d9a\u0dca \u0dc0\u0dd9\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc0\u0dba\u0db6\u0da2\u0db1\u0dcf \u0dba\u0db1\u0dd9\u0dcf. \u0dc0\u0dda \u0dc3\u0db3\u0dc4\u0dcf \u0dd2\u0dc3\u0dc3\u0dd4\u0dab\u0db8 \u0d82\u0dd2 \u0dd9\u0dd0\u0da7\u0db8\u0daf \u0dad\u0dd9 \u0dc0\u0dda\u0dd9\u0db8 \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc0\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9 \u0d87\u0dad\u0dd4\u0dc0\u0dc5\u0dae \u0da2\u0dad\u0dca \u0dc4\u0dd0\u0db8\u0dad\u0dd0\u0db1\u0db8\u0dad\u0dca \u0dc3\u0dcf \u0da0\u0dca\u0da1\u0dcf \u0dba\u0dbd\u0dcf \u0dd2\u0dc3\u0dc3\u0dd4\u0dab\u0db8\u0d9a\u0dca \u0dc0\u0dc3\u0dcf\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dd9\u0db1\u0dca. \u0dd2\u0dc3\u0dc3\u0dd4\u0dab\u0db8 \u0dc0\u0dc3\u0dcf\u0dba\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 \u0db8\u0dd2\u0dd2\u0dba\u0db1 2\u0d9a\u0dca \u0dc0\u0dd9\u0db1\u0dca \u0dba\u0db1\u0dd9\u0dcf. 20. \u0db1\u0dcf\u0da7\u0dba \u0dad\u0dcf \u0dbb\u0dcf\u0d9c \u0d9a\u0dbd\u0dcf\u0dc0 \u0dc3\u0dad \u0dc3\u0dcf\u0dc4\u0dd2\u0dcf\u0dba\u0dba \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0dbd\u0dca\u200d\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8"
