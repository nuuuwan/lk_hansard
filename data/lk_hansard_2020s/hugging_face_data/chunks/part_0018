8\u0dab\u0dca \u0db1\u0d9a\u0dc4\u0d9a3 \u0d85\u0db4\u0dd2 \u0db8\u0dda \u0db4\u0dc0\u0dd4\u0dbd\u0dca\u0dad \u0db8\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0db8\u0dc3\u0dca \u0dcf \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0d9a \u0db1\u0dd2\u0dba\u0db1\u0dca\u0dad \u0dc3\u0db3\u0dc4\u0dcf \u0dba\u0dd4\u0dd4\u0dc0 \u0db4\u0d9a\u0daf\u0dd2 3,359\u0dca \u0dbd\u0db6\u0dcf \u0db8\u0daf\u0db1 \u0dcf3 \u0dbd\u0db6\u0db1 \u0dc3\u0db8\u0dbb\u0dca\u0dbd \u0d85\u0db8\u0dda\u0dbd\u0dca\u0dad \u0db8 \u0dcf\u0dc3\u0dba \u0db1 \u0dc0\u0dd2\u0da7 \u0d92 \u0dcf \u0dbd\u0db6\u0dcf \u0db8\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d85\u0db4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca\u0dad\u0d9a\u0db8 \u0dbd\u0d9a\u0db8\u0db6\u0dba\u0dd23 \u0db8\u0dda \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0d85\u0dca\u0db4\u0dcf\u0dca \u0dc3\u0dda\u0db4\u0dd6\u0dbb\u0dca\u0dbd\u0dab \u0d9a\u0dbb\u0dbd\u0dcf \u0dca\u0db8\u0dc2\u0dca\u0dca\u200d\u0dbb\u0db8\u0dda \u0dbb\u0dcf \u0d9a\u0dcf\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0d9a\u0dbb\u0db1 \u0dc3\u0dc4 \u0d85\u0db8\u0dda \u0db8\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0db8\u0dc3\u0dca \u0dcf \u0da7 \u0dc0\u0dd2\u0dba\u0dcf\u0dbd \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0db7\u0dcf\u0dbb\u0dba\u0dca \u0d9a\u0dbb\u0db1 \u0db4\u0dc0\u0dd4\u0dbd\u0dca\u0dad \u0db8\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0db8\u0dc3\u0dca \u0dcf \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0d9a \u0db1\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db8\u0dda \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dc4\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba\u0da7 \u0dc3\u0d9a\u0dbd\u0d9a\u0dd2\u0dba \u0dba\u0dd4\u0dd4 \u0dc0\u0dd2\u0dc3\u0db3\u0dd4\u0db8 \u0dca \u0dbd\u0db6\u0dcf \u0db8\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0db8 \u0d9f\u0dd2\u0db1\u0dca\u0dad \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca\u0dad\u0d9a\u0db8 \u0dca \u0dbd\u0d9a\u0db8\u0db6\u0db1 \u0dcf3\n\n2. \u0dc0\u0dd2\u0db8\u0dba\u0dca\u0dc2 \u0dbb\u0dcf \u0d9a\u0dcf\u0d9a \u0dc3\u0db3\u0dc4\u0dcf \u0dd4\u0dc036,999\u0d9a \u0da2\u0db8 \u0db1\u0dcf \u0dca \u0dbd\u0db6\u0dcf \u0da2\u0db8 \u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dcf3\n\n3. \u0db1\u0dd2\u0dbd \u0dc3\u0db3\u0dd4\u0dda \u0da2\u0db8 \u0db1\u0dcf \u0dd4\u0dc035,999\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0d9a\u0da9\u0dd2 \u0d9a\u0dbb\u0dbd\u0dcf \u0daf\u0d9a\u0db1\u0dca\u0dad \u0dd4\u0dc0\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0dad 38,999\u0dca \u0dbd\u0db6\u0dcf \u0db8\u0daf\u0db1 \u0dcf3 \u0d9a\u0dba \u0d9a\u0dd2\u0db1\u0dca\u0dad \u0dd4\u0dc0\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0dad 30,999\u0dca \u0db8\u0dbd\u0dc3\u0dba\u0dd2 \u0dad\u0dd2\u0db6\u0dd4\u0db8\u0dab\u0dca3 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0db8 \u0d9a\u0dba\u0dd2 \u0db8 \u0dcf\u0dc3\u0db8\u0dda \u0d89\u0db3\u0dbd\u0dcf \u0dd4\u0dc0\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0dad 38,999\u0dca \u0dbd\u0db6\u0dcf \u0db8\u0daf\u0db1 \u0dcf3 \u0dc3\u0db8 \u0dc3\u0dca\u200d\u0dba\u0dca \u0dc4\u0d9a\u0da7\u0dd2\u0dba\u0da7, \u0dbb \u0db8\u0dda \u0db8\u0dc3\u0dca \u0d9a\u0dba\u0db1\u0dca\u0dad\u0da7 \u0dbd\u0db6\u0dcf \u0db8\u0daf\u0db1 \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dda \u0dbd\u0da7 \u0d85\u0db8 \u200d\u0dbb \u0db8\u0dda \u0d85\u0dba \u0db8 \u0db1\u0dd4\u0db8 \u0db1\u0dca\u0dad \u0db8\u0dda \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dda \u0daf \u0dbd\u0db6\u0dcf \u0da2\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0dcf3 \u0d8a\u0da7\u0db8\u0d9a \u0d85\u0db8 \u200d\u0dbb \u0dd2\u0db8\u0d9a\u0db8\u200d\u0dcf\u0db8\u0d9a, \u0dbb\u0dcf \u0dba \u0db8\u0dc3\u0dca \u0db8\u0dda \u0db8\u0db4\u0dcf\u0daf\u0dd4 \u0d9a\u0da7\u0dd4\u0dda \u0d9a\u0da9\u0dd2\u0dd3\u0db8 \u0d92\u0db8\u0dd2\u0dcf\u0dbd\u0dca\u0dad\u0dbd\u0db1\u0dca\u0dad\u0da7\u0db8\u0d9a \u0db6\u0dbd\u0db4\u0dcf\u0db1 \u0dcf3\n\n(\u0dcf \u0db4\u0d9a\u0db1 \u0db8\u0db1\u0dcf\u0db1\u0d9f\u0dd33\n\n\u0d9c\u0dd4 \u0db1\u0dd3\u0dad\u0dd2\u0da5 \u0da0\u0dd2\u0dba\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dcf\u0dab\u0dd3 \u0d9a \u0d9a\u0dd2\u0dbb\u0dd2\u0d87\u0dbd\u0dca\u0dbd \u0dd9\u0dc4\u0dad\u0dca\u0dd2\u0dba\u0dba (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4 \u0ba3\u0bbf (\u0ba4\u0bbf\u0bb0\u0bc1\u0bc8\u0ba4\u0bbf) \u0b9a\u0bc8\u0bbf\u0ba8\u0bcd\u0ba4\u0bbf \u0bc6\u0bbe\u0ba3\u0bbf \u0b95\u0bbf\u0bc6\u0bbe\u0bbf\u0b8e\u0bb2\u0bcd\u0bb0\u0bb2) (The Hon. (Mrs.) Chamindranee Kiriella, Attorney-at-Law) \u0dd2\u0dd4\u0dc0 \u0d9a\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0db8 \u0db1\u0dd2, \u0db8 \u0db8\u0dda \u0db4 \u0db8\u0dd4 \u0db1 \u0d85\u0dd4\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba \u0db8\u0db8 \u0dba\u0dba\u0dd23 \u0dc0\u0dd2\u0db8\u0dba\u0dca\u0dc2\u0db8\u0dba\u0db1\u0dca\u0dad\u0db8 \u0db8\u0dd2\u0db6\u0dbd\u0dd3\u0dba \u0db4\u0dd2\u0dba\u0dba\u0dd4\u0dd4\u0dc0 \u0db4\u0dd2 \u0d9a\u0d9a\u0dcf \u0dd2\u0d9a\u0db1 \u0daf\u0d9a\u0db1\u0dd4 \u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9a\u0dca\u0db8\u200d\u0db6\u0db6\u0dbb\u0dca\u0dbd \u0db8 \u0dcf\u0dc3\u0db8\u0dda \u0dc3\u0dd2\u0daf\u0dca\u0db0 \u0db8 \u0db1 \u0dcf3 \u0db8\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0db8\u0dba\u0db1\u0dca\u0dad \u0daf\u0d9a\u0db1\u0dd4 \u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda \u0dc0\u0dd2\u0db8\u0dba\u0dca\u0dc2 \u0d9a\u0da9\u0dc3\u0da7\u0dc4\u0db1\u0dca \u0d85\u0daf \u0db8\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dda \u0da2 \u0db4 \u0db8\u0d9a \u0db1 \u0dcf3 \u0d85\u0db8\u0dda \u0db4\u0dc0\u0dd4\u0dbd\u0dca\u0dad \u0db8\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0db8\u0dc3\u0dca \u0dcf \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0d9a \u0db1\u0dd2\u0dba\u0db1\u0dca\u0dad \u0dd2\u0dba\u0dda \u0db8 \u0da7\u0dca\u0da7\u0da7\u0db8\u0dda \u0dc3\u0dd2\u0da7 \u0dc0\u0dd2\u0dba\u0dcf\u0dbd \u0db8\u0dc3\u0dca \u0dcf \u0dca \u0d9a\u0dbb\u0db1 \u0dcf, \u0dc0\u0dd2\u0dba\u0dcf\u0dbd \u0db8\u0db8 \u0db8\u0dc4\u0dba\u0dd4\u0db8 \u0dca \u0d9a\u0dbb\u0db1 \u0dcf, \u0dc0\u0dd2\u0db8\u0dba\u0dca\u0dc2\u0db8\u0dba\u0db1\u0dca\u0dad \u0db4\u0dd2\u0dba\u0dba\u0dd4\u0dd4\u0dc0 \u0db4\u0dd2 \u0d9a\u0d9a\u0dcf \u0dc4\u0db3\u0dd4\u0db1\u0dcf \u0dd2\u0d9a\u0db1\u0dd3\u0db8 \u0da73 \u0d85\u0daf \u0d8b\u0db8\u0daf\u0dca \u0dd2\u0dd4\u0dc0 \u0d9a\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0db8 \u0dcf\u0db8\u0d9a \u0db8\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0db8\u0dba\u0db1\u0dca\u0dad \u0d85\u0db4\u0dd2\u0db8\u0d9a \u0d9a\u0dca\u0d9a \u0d9a\u0dcf\u0dcf \u0d9a \u0dcf3 \u0dc0\u0dd2\u0db8\u0dba\u0dca\u0dc2\u0db8\u0dba\u0db1\u0dca\u0dad\u0db8 midwives\u0dbd\u0dcf \u0db8\u0dda \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0db8\u0dba\u0db1\u0dca\u0dad \u0db8\u0dbd\u0dcf\u0dd4 \u0db8\u0dc3\u0dca \u0dba\u0dca \u0d9a\u0dbb\u0db1 \u0dcf3 \u0db8\u0db8 \u0d9a\u0db1\u0dd2 \u0daf\u0dd2\u0db1\u0dba\u0d9a \u0d92 \u0d85\u0dba \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0db8\u0dba\u0db1\u0dca\u0dad \u0d9a\u0dcf\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0dd2\u0dd4\u0dc0 \u0db8\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0dc3\u0db8 \u0dad\u0dd2\u0dd4\u0db8 \u0dcf\u0db8\u0dd2\u0db1\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba\u0dca \u0dc3\u0dd3\u0db8\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db8 \u0da7 \u0d85 \u0dc3\u0dca\u0dcf\u0dcf \u0dca \u0dbd\u0d9a\u0dd3\u0db8 \u0db4\u0dd2 \u0d9a\u0db6\u0db3 \u0db8 \u0db8 \u0dc3\u0db1\u0dca\u0dad\u0db8\u200d\u0db6\u0dc2 \u0db8 \u0db1 \u0dcf3"
