    "chunk_text": "\u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1 \u0b8e\u0ba9 \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0baf\u0bbe\u0b95\u0baa\u0bc2\u0bb0\u0bcd\u0bb5\u0bae\u0bbe\u0b95\u0ba4\u0bcd \u0bb5\u0ba4\u0bbe\u0bbf\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bbe\u0baf\u0bbf\u0ba9\u0bc1\u0bae\u0bcd \u0b87\u0ba4\u0bc1 \u0bae\u0bc1\u0bae\u0bb1\u0baf\u0bbe\u0b95 \u0ba8\u0bae\u0b9f\u0bae\u0bc1\u0bae\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bb5\u0ba4\u0bbf\u0bb2\u0bcd\u0bae\u0bc8. \u0b8e\u0ba9\u0b9a\u0bb5, \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0b85\u0bae\u0ba9\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0bb0\u0b9a \u0b9a\u0b9a\u0bae\u0bb5 \u0b86\u0b9f\u0bcd\u0b9a\u0b9a\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bbf\u0ba9\u0bcd\u0b9a\u0baa\u0bbe\u0ba4\u0bc1\u0bae\u0bcd \u0b9a\u0bae\u0bb1\u0bcd\u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u0bbe\u0bb1\u0bc1 3 \u0b9a\u0ba4\u0bb5\u0bc0\u0ba4 \u0b86\u0b9f\u0bcd\u0b9a\u0b9a\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bae\u0bb3\u0b9a\u0bcd \u0bb5\u0b9a\u0baf\u0bcd\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0b9a\u0ba4\u0bae\u0bb5\u0baf\u0bbe\u0ba9 \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0bae\u0b95\u0b95\u0bb3\u0bcd \u0b8e\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd.\n\n\uf0d8 \u0b92\u0b9f\u0bcd\u0b9f\u0bbf\u0b9a\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bbf\u0b9f\u0bcd\u0b9f \u0bb5\u0bc8\u0ba4\u0bc1\u0b95\u0bc1\u0bae\u0bb1\u0ba8\u0bcd\u0ba4 \u0baa\u0bbf\u0bb3\u0bcd\u0bae\u0bb3\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95\n\n\u0baa\u0b95\u0bb2\u0bcd\u0b9a\u0ba8\u0bb0\u0baa\u0bcd \u0baa\u0bb0\u0bbe\u0bae\u0bbe\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0ba8\u0bbf\u0bae\u0bc8\u0baf\u0b99\u0bcd\u0b95\u0bae\u0bb3 \u0b85\u0bae\u0bae\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0baa\u0ba3\u0bbf, \u0b9a\u0bc1\u0b95\u0bbe\u0ba4\u0bbe\u0bb0 \u0b85\u0bae\u0bae\u0b9a\u0bcd\u0b9a\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bae\u0bc2\u0b95 \u0b9a\u0b9a\u0bae\u0bb5\u0b95\u0bb3\u0bcd \u0ba4\u0bbf\u0bae\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b8f\u0bb1\u0bcd\u0b95\u0ba9\u0b9a\u0bb5 \u0bae\u0bc1\u0ba9\u0bcd\u0bb5\u0ba9\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0bb0\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b87\u0baa\u0bcd\u0baa\u0ba3\u0bbf\u0bae\u0baf \u0b85\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4 \u0bb5\u0bb0\u0bc1\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0bb5\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1 \u0ba8\u0bae\u0b9f\u0bae\u0bc1\u0bae\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0b95 \u0b9a\u0bc1\u0b95\u0bbe\u0ba4\u0bbe\u0bb0 \u0b85\u0bae\u0bae\u0b9a\u0bcd\u0b9a\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 100 \u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0ba8\u0bbf\u0ba4\u0bbf\u0baf\u0bc1\u0bae\u0bcd, \u0b9a\u0bae\u0bc2\u0b95 \u0b9a\u0b9a\u0bae\u0bb5\u0b95\u0bb3\u0bcd \u0ba4\u0bbf\u0bae\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 447 \u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0ba8\u0bbf\u0ba4\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. \u0b87\u0baa\u0bcd\u0baa\u0ba3\u0bbf\u0b95\u0bae\u0bb3\u0ba4\u0bcd \u0bb5\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bbe\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0baa\u0b95\u0bb2\u0bcd\u0b9a\u0ba8\u0bb0\u0baa\u0bcd \u0baa\u0bb0\u0bbe\u0bae\u0bbe\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0ba8\u0bbf\u0bae\u0bc8\u0baf\u0b99\u0bcd\u0b95\u0bae\u0bb3 \u0b85\u0bae\u0bae\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd, \u0b9a\u0bae\u0bc8\u0ba4\u0bbf\u0b95\u0bae\u0bbe\u0b95 \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 500 \u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0ba8\u0bbf\u0ba4\u0bbf\u0bae\u0baf \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0bb5\u0bae\u0bbe\u0bb4\u0bbf\u0b95\u0bbf\u0ba9\u0bcd\u0b9a\u0bb1\u0bbe\u0bae\u0bcd.\n\n11. \u0b95\u0bb2\u0bcd\u0bb5\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0baa\u0baf\u0bbf\u0bb1\u0bcd\u0b9a\u0bbf\u0baf\u0bc1\u0bae\u0bcd\n\n\u0bb5\u0b95\u0bcc\u0bb0\u0bb5 \u0b9a\u0baa\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0b9a\u0bb3,\n\n\uf0d8 \u0ba4\u0bae\u0ba4\u0bc1 \u0baa\u0bbf\u0bb3\u0bcd\u0bae\u0bb3\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bb2\u0bcd\u0bb5\u0bbf\u0baf\u0bc2\u0b9f\u0bcd\u0b9f\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0b89\u0baa\u0b95\u0bb0\u0ba3\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bbe\u0b95\u0bbf\u0ba4\u0bbe\u0ba4\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0bb5\u0b9a\u0bc8\u0bae\u0bb5\u0b95\u0bcd \u0b95\u0bc1\u0bae\u0bb1\u0ba4\u0bcd\u0ba4\u0bc1, \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b95\u0bb1\u0bcd\u0bae\u0b95\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b9a\u0ba4\u0bae\u0bb5\u0baf\u0bbe\u0ba9 \u0b95\u0bbe\u0b95\u0bbf\u0ba4\u0bbe\u0ba4\u0bbf\u0b95\u0bae\u0bb3 \u0b92\u0bb5\u0bcd\u0bb5\u0bb5\u0bbe\u0bb0\u0bc1 \u0baa\u0bbf\u0bb3\u0bcd\u0bae\u0bb3\u0baf\u0bc1\u0bae\u0bcd \u0bb5\u0baa\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0bb5\u0b95\u0bbe\u0bb3\u0bcd\u0bb5\u0bae\u0ba4 \u0b89\u0bb1\u0bc1\u0ba4\u0bbf\u0bb5\u0b9a\u0baf\u0bcd\u0baf\u0bc1\u0bae\u0bcd \u0b9a\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0b9f\u0ba9\u0bcd 2025\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0bae\u0bbe\u0ba3\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 6,000 \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd \u0b95\u0bbe\u0b95\u0bbf\u0ba4\u0bbe\u0ba4\u0bbf\u0b95\u0bb3\u0bcd \u0bb5\u0b95\u0bbe\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0ba9\u0bae\u0bb5 2026\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0bb5\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b9a\u0bb5\u0bbe\u0bae\u0bcd. \u0b87\u0ba8\u0bcd\u0b9a\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0ba4\u0bcd \u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0b95 \u0b85\u0bb8\u0bcd\u0bb5\u0bb5\u0b9a\u0bc1\u0bae \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 9,000 \u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc0\u0b9f\u0bc1 \u0bb5\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.\n\n123 124\n\n[\u0d9c\u0dbb\u0dd4 \u0d82\u0db1\u0dd4\u0dba \u0d9a\u0dd4\u0db8\u0dcf\u0dba \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba \u0db8\u0dc4\u0dad\u0dcf]\n\n020 \u0dc0\u0db1\u0dcf\u0dd9\u0dd0\u0dda\u0dd9\u0dbb\u0dca\u0dbd 29\n\n\uf0d8 \u0b95\u0bb2\u0bcd\u0bb5\u0bbf, \u0b85\u0bae\u0ba9\u0ba4\u0bcd\u0ba4\u0bc1 \u0baa\u0bbf\u0bb3\u0bcd\u0bae\u0bb3\u0b95\u0bb3\u0bbf\u0ba9\u0ba4\u0bc1\u0bae\u0bcd \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bae\u0b9f \u0b89\u0bbe\u0bbf\u0bae\u0bae\u0baf\u0bbe\u0b95\u0b95\u0bcd \u0b95\u0bb0\u0bc1\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bb5\u0ba4\u0ba9\u0bbe\u0bb2\u0bcd \u0b85\u0bae\u0ba9\u0bb5\u0bae\u0bb0\u0baf\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0b9f\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0bb2\u0bcd\u0bb5\u0bbf\u0baf\u0bbf\u0ba9\u0bc2\u0b9f\u0bbe\u0b95 \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0ba9\u0bc1\u0bae\u0b9f\u0baf \u0baa\u0bbf\u0bb3\u0bcd\u0bae\u0bb3\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bb2\u0bcd\u0bb5\u0bbf \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0bae\u0bc1\u0baf\u0bb1\u0bcd\u0b9a\u0bbf \u0b9a\u0bae\u0bb1\u0bcd\u0bb5\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0bb0\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b8e\u0ba9\u0bbf\u0ba9\u0bc1\u0bae\u0bcd, \u0b95\u0bb2\u0bcd\u0bb5\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0ba9\u0bcd\u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0baa\u0bbf\u0bb3\u0bcd\u0bae\u0bb3\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b88\u0b9f\u0bc1\u0baa\u0bbe\u0b9f\u0bc1 \u0b95\u0bc1\u0bae\u0bb1\u0bb5\u0bbe\u0b95\u0b9a\u0bb5 \u0b95\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b95\u0bc1\u0bae\u0bb1\u0ba8\u0bcd\u0ba4 \u0bb5\u0bb0\u0bc1\u0bae\u0bbe\u0ba9\u0b95\u0bcd \u0b95\u0bc1\u0b9f\u0bc1\u0bae\u0bcd\u0baa\u0b99\u0bcd\u0b95\u0bae\u0bb3\u0b9a\u0bcd \u0b9a\u0b9a\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0ba9\u0bbe\u0bb3\u0bbf\u0baa\u0bcd \u0baa\u0bbf\u0bb3\u0bcd\u0bae\u0bb3\u0bb5\u0baf\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0baa\u0bcd \u0baa\u0bbe\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1\u0bae\u0bb0\u0baf\u0bbf\u0ba9\u0bcd \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bae\u0b9f\u0baf\u0bbf\u0bb2\u0bcd \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 5,000 \u0bb5\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0bae\u0bbe\u0ba4\u0bbe\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0bb5\u0b95\u0bbe\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0ba9\u0bb5\u0bb5\u0bbe\u0ba9\u0bcd\u0bae\u0bb1 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b87\u0bb5\u0bcd\u0bb5\u0bbe\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0bb5\u0bb0\u0bb5\u0bc1 \u0bb5\u0b9a\u0bc8\u0bb5\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 50 \u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0bae\u0ba9 \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc0\u0b9f\u0bc1 \u0bb5\u0b9a\u0baf\u0bcd\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0ba8\u0bbe\u0bae\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u0bb5\u0bae\u0bbe\u0bb4\u0bbf\u0b95\u0bbf\u0ba9\u0bcd\u0b9a\u0bb1\u0bbe\u0bae\u0bcd.\n\n\uf0d8 \u0b95\u0b9f\u0ba8\u0bcd\u0ba4 \u0ba4\u0b9a\u0bbe\u0baa\u0bcd\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0bb2\u0bcd\u0b95\u0bae\u0bc8\u0b95\u0bcd\u0b95\u0bb4\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b87\u0bae\u0ba3\u0ba8\u0bcd\u0ba4\u0bc1"
