    "chunk_text": "\u0d91\u0dc0\u0db8\u0db1\u0dca\u0db8 \u0da7\u0dd4\u0d9c\u0dc3\u0dae\u0dc0\u0dad\u0dcf\u0da7 \u0dd2\u0db1\u0da7 \u0d9c\u0dbd\u0dc0\u0d9c\u0daf\u0dba \u0daf\u0d9a\u0dca\u0dd9\u0dcf \u0dd9\u0db1 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0dc0 \u0dcf\u0da7\u0dc3\u0daf \u0db4\u0dd4\u0dc5\u0dd4\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d82\u0dd9\u0dc1\u0dba \u0d82\u0db0\u0dba\u0dba\u0db1 \u0da7\u0dd4\u0dad\u0dad\u0dd4\u0daf \u0dbd\u0dd9\u0db1 \u0dd9\u0dc3\u0dc0\u0dbb\u0dca\u0dbd \u0dca\u0dba\u0dda\u0db7 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd4\u0dda \u0dba \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. -\u0d82\u0dd2\u0dc5 \u0d9a\u0d9a\u0dca\u0dc0 \u0db6\u0db8 \u0dd2\u0dba\u0dc4\u0dd2\u0db8\u0dbd\u0dcf \u0d9c\u0dbd\u0dc0\u0d9c\u0daf\u0dbb\u0dd2\u0db1\u0dca \u0d91\u0dd2\u0db6\u0dba\u0da7 \u0d91\u0db1\u0dd9\u0dcf. \u0d9f\u0da7 \u0db4\u0dc3\u0dae\u0dc0\u0dc3\u0dae \u0dc0\u0db8\u0dcf \u0d9a\u0dca\u0daf \u0dc0\u0dd9\u0db1\u0dca\u0dc0\u0db1\u0dca? \u0d9f\u0da7 \u0db4\u0dc3\u0dae\u0dc0\u0dc3\u0dae \u0dad\u0dd9\u0dad\u0dca \u200d\u0dbb\u0dc1\u0dae\u0db1\u0dba\u0d9a\u0dca \u0d91\u0db1\u0dd9\u0dcf. \u0db8\u0db0\u0dba\u0db8 \u0d82\u0db0\u0dd2\u0dc0 \u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0dc0\u0d86 \u0dd9\u0dd0\u0d9a \u0d82\u0dd9\u0dc3\u0db1\u0dca \u0dc0\u0dd9\u0db1\u0dc0 \u0dcf\u0da7 \u0d82\u0dd2\u0dc5 \u0d9c\u0dbd\u0dc0\u0d9c\u0daf\u0dba \u0db8\u0dc4\u0db1\u0dd4\u0dd9\u0dba \u0dc0 \u0dcf\u0da7\u0dc0\u0dc3\u0dae \u0dd9\u0dd0\u0d9a\u0dad\u0dca \u0d82\u0dd9\u0dc3\u0db1\u0dca \u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dca\u0db1\u0da7 \u0d95\u0db1\u0dc3. \u0dc3\u0db3\u0dc4\u0dcf \u0d82\u0dd2\u0dc5 \u0dbd\u0dd9\u0db1 \u0dd9\u0dc3\u0dc0\u0dbb\u0dca\u0dbd \u0dc3\u0dd0\u0dbd\u0dc3\u0dd4\u0dda \u0dc4\u0daf\u0db1\u0dd9\u0dcf.\n\n\uf0d8 \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dc3\u0d9c\u0dbd-\u0daf\u0db9\u0dd4\u0db8\u0dbd \u0dc0\u0dba\u0db6\u0da2\u0dd2\u0dad \u0d82\u0db0\u0dd2\u0dc0 \u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0dba\n\n\u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dc3\u0d9c\u0dbd \u0daf\u0db9\u0dd4\u0db8\u0dbd \u0dc0\u0dba\u0db6\u0da2\u0dd2\u0dad \u0d82\u0db0\u0dd2\u0dc0 \u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0dba \u0dd2\u0dc5\u0dd2\u0db6\u0dd9\u0db3\u0dd9\u0dad\u0dca \u0dc3\u0dcf\u0dd9\u0dcf\u0daf\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf \u0dc4\u0daf\u0db1\u0dd9\u0dcf\u0daf \u0db1\u0dd0\u0dda\u0daf \u0d82\u0dd9\u0dc1\u0dba\u0daf \u0db1\u0dd0\u0dda\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0dc3\u0dcf\u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0db1 \u0d82\u0db0\u0dd2 \u0dcf\u0dbb\u0dd2\u0dba \u0db1\u0dd2\u0dd2\u0db1 \u0d82\u0db0\u0dba\u0dba\u0db1\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dd9 \u0dad\u0dd3\u0dba\u0dab\u0dba \u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dc3\u0d9c\u0dbd \u0daf\u0db9\u0dd4\u0db8\u0dbd \u0d82\u0db0\u0dd2\u0dc0 \u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0dba \u0dc4\u0daf\u0db1\u0dca\u0db1. \u0d82\u0dd2\u0dc5 \u0dc4\u0daf\u0db1\u0dd9\u0dcf. \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dc3\u0d9c\u0dbd \u0daf\u0db9\u0dd4\u0db8\u0dbd \u0dc0\u0dba\u0db6\u0da2\u0dd2\u0dad \u0d82\u0db0\u0dd2\u0dc0 \u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0dba \u0db1\u0dd0 \u0dc0\u0d9f\u0db1\u0dc4\u0dd2\u0dba -\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0db8\u0dbd\u0dba \u0dc3\u0dc4 \u0db8\u0d9a \u0dbd\u0db4\u0dd4\u0dd9 \u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dc0\u0d86- \u0dc3\u0dcf\u0da0\u0dcf\u0dba \u0dd9\u0dba\u0dcf\u0db4\u0dcf\u0dba\u0dba \u0d89\u0dbd\u0d9a\u0dca \u0dba\u0dc0\u0d9c\u0db1 \u0dba\u0db1 \u0db1\u0dd2\u0dc3\u0dcf \u0d91\u0db8 \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dba \u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba \u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d82\u0db4\u0da7 \u0d91\u0db8 \u0d82\u0db0\u0dd2\u0dc0 \u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0dba \u0dd9\u0dd0\u0daf\u0d9c\u0dad\u0dca \u0dc0\u0dd9\u0db1\u0dd9\u0dcf.\n\n\u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dc3\u0d9c\u0dbd \u0daf\u0db9\u0dd4\u0db8\u0dbd \u0dc0\u0dba\u0db6\u0da2\u0dd2\u0dad \u0d82\u0db0\u0dd2\u0dc0 \u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d89\u0d9a\u0dda \u0d82\u0dad\u0dca \u0db4\u0dad\u0dca \u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0dc0\u0dda \u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0dc0\u0dda \u0dd9\u0db1 \u0dd2\u0dc3\u0da7\u0dad\u0dca \u0dd2\u0db1\u0db1\u0dca \u0dba\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dd9\u0dad\u0dd2\u0db1\u0dd9\u0dcf. \u0d91\u0dc4\u0dd2 \u0d89\u0d9a\u0dda \u0d82\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dc0\u0dda \u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0d82\u0dd9\u0dc3\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 \u0db8\u0dd2\u0dd2\u0dba\u0db1 222\u0d9a\u0dca \u0dc0\u0dd9\u0db1\u0dca \u0dba \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. -\u0d91\u0db8 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0db1 \u0d89\u0d9a\u0dda \u0d82\u0dd2\u0dc5 \u0dbd\u0dd9\u0db1 \u0dd9\u0dc3\u0dc0\u0dbb\u0dca\u0dbd \u0da2 \u0d82\u0dad\u0dca \u0db4\u0dad\u0dca \u0dba\u0dc0\u0d9c\u0db1 \u0d82\u0dd9\u0dc3\u0db1\u0dca \u0dba\u0db1\u0dd9\u0dcf.\n\n\uf0d8 \u0dbb\u0dd4\u0dd9\u0db1\u0dca\u0db4\u0dd4\u0dba \u0d82\u0db0\u0dd2\u0dc0 \u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0dba \u0dc4\u0dad\u0dd4\u0dca\u0dd9 \u0dd2\u0db1\u0da7 \u0d89\u0dcf\u0dd2\u0dba\u0dbb\u0dd2\u0dba \u0daf\u0d9a\u0dca\u0dd9\u0dcf \u0db4\u0dc5\u0db8\u0dd4 \u0dc0 \u0dcf\u0da7\u0dc3\n\n\u0dbb\u0dd4\u0dd9\u0db1\u0dca\u0db4\u0dd4\u0dba \u0d82\u0db0\u0dd2\u0dc0 \u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0dc0\u0d86 \u0dc4\u0dad\u0dd4\u0dca\u0dd9 \u0dd2\u0db1\u0da7 \u0d89\u0dcf\u0dd2\u0dba\u0dbb\u0dd2\u0dba \u0daf\u0d9a\u0dca\u0dd9\u0dcf \u0d9a\u0dd2\u0dc0\u0dbd\u0db6\u0db8\u0dd3\u0da7\u0dba 0 \u0d82\u0db0\u0dd2\u0dc0 \u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0dc0 \u0dcf\u0da7\u0dc0\u0dc3\u0dae \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0dda \u0d82\u200d\u0dbb\u0db8\u0dd9\u0dad\u0dca \u0dc0\u0dbd\u0dc3 \u0dad\u0dd0\u0db1\u0dd2\u0db1\u0dca \u0dad\u0dd0\u0db1 \u0dd2\u0db1\u0db1\u0dca \u0dba \u0d87\u0dad\u0dd2 \u0d82\u0dad\u0dba \u0dca\u0dbb\u0dca\u0dbd\u0dd2 \u0d82\u0dbb\u0dca\u0dbd\u0db6\u0dd4\u0daf\u0dba\u0dad\u0dca \u0dc3\u0db8\u0d9f \u0d91\u0db8 \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0dda \u0dad\u0dcf\u0dd9 \u0dcf\u0dd2 \u0dd9 \u0db1\u0dd9\u0dad\u0dca\u0dd9\u0dcf \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. \u0dc0\u0db8\u0dc0\u0dc3\u0dae \u0d82\u0d9a\u0d9a\u0dca \u0db1\u0dd2\u0db8 \u0dc5 \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0dda \u0dc0\u0dc4\u0dae\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dc0\u0d86 \u0da2\u0db1\u0dad\u0dcf\u0dd9 \u0dca\u0dbb\u0dca\u0dbd\u0dd2 \u0dc3\u0db8\u0dcf\u0da2\u0dba\u0dd3\u0dba \u0dc0\u0db8\u0db1\u0dca\u0db8 \u0db4\u0dcf\u0dbb\u0dd2\u0dc3\u0dbb\u0dd2 \u0d9c\u0dd0\u0da7\u0dbd\u0dd4 \u0dba\u0dcf\u0dc1\u0dd2\u0dba \u0da7\u0daf \u0db8\u0dd4\u0dc4\u0dd4\u0dab \u0db4\u0dcf \u0dd2\u0db1\u0da7\u0dd2\u0db1\u0dd9\u0dcf. \u0d91\u0dd9\u0dd0\u0dd2\u0dc3\u0db1\u0dca \u0dc0\u0db8\u0db8 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0dc0 \u0dcf\u0da7\u0dc3 \u0dc3\u0db3\u0dc4\u0dcf 02 8 \u0dd9\u0dc3\u0dc0\u0dbb\u0dca\u0dbd \u0da2 \u0dd2\u0db1\u0db1\u0dca \u0dba \u0d87\u0dad\u0dd2 \u0dc1 \u0dba\u0dad\u0dcf \u0d82\u0db0\u0dba\u0dba\u0db1\u0dba \u0dc3\u0db8\u0dcf\u0dc0\u0dbd\u0db6\u0da0\u0db1\u0dba \u0da7 \u0dbd\u0d9a\u0dca \u0dba \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dbd\u0dd0\u0dc0\u0dd9\u0db1 \u0dc0\u0dad\u0dcf\u0dba\u0dad\u0dd4\u0dbb\u0dd4 \u0dd2\u0dc3\u0dc1\u0dae\u0dc0\u0db8\u0dc2\u0dab\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d82\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0dd9 \u0dc4\u0dad\u0dd4\u0dca\u0dd9 \u0dd2\u0db1\u0da7 \u0d89\u0dcf\u0dd2\u0dba\u0dbb\u0dd2\u0dba \u0daf\u0d9a\u0dca\u0dd9\u0dcf \u0daf\u0dd0\u0db1\u0da7 \u0db4\u0dd9\u0dad\u0dd2\u0db1 \u200d\u0dbb\u0dc0 \u0dc1\u0dba \u0dd9\u0dd0\u0da9\u0dd2\u0daf\u0dd2\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dd2\u0dc5\u0dd2\u0db6\u0dd9\u0db3\u0dd9 \u0dad\u0dd9\u0db1\u0dca\u0dba\u0da7\u0dad\u0dca \u0dc3\u0dbd \u0dcf \u0dd9\u0dd0\u0dbd\u0dd3\u0db8\u0da7 \u0d82\u0dc0\u0dda\u0d9a\u0dca\u0dc2\u0dcf \u0dba\u0db1\u0dd9\u0dcf. \u0dc0\u0db8\u0db8 \u0d82\u0db0\u0dd2\u0dc0 \u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0dc0 \u0dcf\u0da7\u0dc0\u0dc3\u0dae \u0d89\u0d9a\u0dda \u0d82\u0dad\u0dca \u0db4\u0dad\u0dca \u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0daf \u0d82\u0d9b\u0da9\u0dd4\u0d9a\u0d9a\u0dd9 \u0dd2\u0db1\u0db1\u0dca \u0dba\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dd9\u0dad\u0dd2\u0db1 \u0d82\u0dad\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 \u0db8\u0dd2\u0dd2\u0dba\u0db1 22\u0d9a\u0dca \u0dc0\u0dd9\u0db1\u0dca \u0dba \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf.\n\n\uf0d8 \u0d9a\u0dd4\u0dbd\u0dd4\u0db1\u0dd4 \u0db8\u0dad \u0d89\u0daf\u0dd2 \u0dc0 \u0dc0\u0dba\u0db1 \u0dd9\u0dba\u0dcf\u0dba \u0dd2\u0dc5\u0dd2\u0dc3\u0dc3\u0dd4\u0dda \u0d82\u0db0\u0dd2\u0dc0 \u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0dc0\u0d86 \u0dd2\u0db1\u0da7 \u0dc3\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dd3\u0dba \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c - Marine Drive - \u0daf\u0dd2\u0d9c\u0dd4\u0dd9 (\u0d82\u0daf\u0dd2\u0dba\u0dba II) \u0daf\u0d9a\u0dca\u0dd9\u0dcf \u0dc3\u0dda\u0dd9\u0db1\u0dca\u0db0\u0dad\u0dcf\u0dd9\u0dba \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dd2\u0dc5\u0dd2\u0db6\u0dd9\u0db3 \u0dc1 \u0dba\u0dad\u0dcf \u0d82\u0db0\u0dba\u0dba\u0db1\u0dba\u0d9a\u0dca \u0dd2\u0db1\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8"
