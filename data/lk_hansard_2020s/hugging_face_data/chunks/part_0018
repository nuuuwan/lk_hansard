db6\u0db1 \u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0d85\u0db4\u0dd2 \u0db4\u0dd2 \u0d9a\u0dd2\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd13 \u0db8\u0dda \u0dcf\u0dab\u0dca\u0dca \u0db6\u0dbd\u0dba\u0da7 \u0d9a\u0db1\u0db8\u0d9a\u0dcf\u0da7 \u0d9a\u0dd2\u0dda \u0dcf, \u0d9a\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0da7 \u0db8\u0dda \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd2\u0dc3\u0db3\u0dd4\u0dda \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf3 \u0d9a\u0daf\u0dcf \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dcf\u0dab\u0dca\u0dca \u0d85\u0dbd, \u0dbd\u0dd6\u0db1\u0dd4 \u0dbd\u0da7 \u0db6\u0daf\u0dd4 \u0db4\u0db1 \u0db1\u0db8\u0d9a\u0dcf\u0da7 \u0d9a\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dda \u0dcf, \u0db6\u0daf\u0dd4 \u0db4\u0db1 \u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db8\u0d9a\u0dcf\u0db8\u0dd2\u0dc3\u0dca \u0dd2\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf3 \u0d9a\u0db8\u0dc4\u0db8 \u0db1\u0d9a\u0db8\u0d9a\u0db1\u0dda \u0dd2 \u0db8\u0dd2\u0dd4\u0dbb\u0db1\u0dca\u0dad \u0dc3\u0dd4\u0da7\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf3 \u0d85\u0daf \u0dcf\u0dab\u0dca\u0dca \u0d9a\u0dbb\u0db1, \u0dc3\u0db8 \u0dad\u0dd2\u0d9a\u0dda \u0d9a\u0dbb\u0db1, \u0d9a\u0daf\u0dcf \u0dc0\u0dd2\u0db4\u0dca\u0dc2\u0db8\u0dda \u0dc4\u0dd2\u0da7\u0db4\u0dd4, \u0d9a\u0daf\u0dcf \u0dd8\u0db8\u0d9a\u0dd3\u0dbb\u0dba \u0dc3\u0db8\u0dd2\u0dad\u0dd2 \u0dbd\u0da7 \u0db1\u0dcf\u0dba\u0d9a\u0db8\u0d9a \u0dba \u0da2\u0db4\u0dd4 \u0db8\u0dda \u0dc3\u0db8 \u0dad\u0dd2 \u0dd4\u0dc0 \u0d9a\u0db8\u0dc4\u0db8 \u200d\u0db8 \u0dba\u0dd2 \u0d9a\u0daf\u0dcf \u0d9a\u0dd2\u0dda\u0db8\u0dda3 \u0dd2\u0dd4\u0dc0 \u0db1\u0dd2\u0db8\u0dba\u0db6 \u0dba \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2, \u0d9a\u0daf\u0dcf \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dc3\u0db8 \u0dad\u0dd2 \u0dd4\u0dc0 \u0db6\u0daf\u0dd4 \u0db4\u0d9a\u0db8\u0db1\u0dda\u0db8\u0dda \u0db8\u0d9a\u0dcf\u0db8\u0dd2\u0dc3\u0dca \u0dd2\u0db1\u0dca\u0dad\u0db1 \u0db1\u0dda, \u0d9a\u0daf\u0dcf \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dc3\u0db8 \u0dad\u0dd2 \u0dd4\u0dc0 \u0db6\u0daf\u0dd4 \u0db4\u0d9a\u0db8\u0db1\u0dda\u0db8\u0dda \u200d\u0db8 \u0db1\u0dca\u0dad\u0db8\u0dda \u0dd2 \u0db8\u0dd2\u0dd4\u0dbb\u0db1\u0dca\u0dad\u0da7 \u0dc3\u0dc4\u0dcf\u0dba \u0db8\u0daf\u0db1\u0dca\u0dad\u0db1 \u0db1\u0dda, \u0d85\u0daf\u0da7\u0db8\u0d9a \u0d92\u0d9a \u0d92 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7\u0db8 \u0db8\u0d9a\u0db8\u0dbb\u0db1 \u0dcf\u0daf, \u0db1\u0d9a\u0db8\u0d9a\u0db1\u0dda \u0d85\u0daf \u0d92\u0d9a \u0db8 \u0db1\u0dc3\u0dca \u0db8 \u0dbd\u0dcf\u0daf \u0d85\u0db4\u0da7 \u0d85\u0dc4\u0db1\u0dca\u0dad\u0db1 \u0dc3\u0dd2\u0daf\u0dca\u0db0 \u0db8 \u0db1 \u0dcf3\n\n2401 2402\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4"
