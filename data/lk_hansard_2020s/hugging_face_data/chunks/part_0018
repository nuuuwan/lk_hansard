    "chunk_text": "\u0b87\u0ba8\u0bcd\u0ba4\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0ba4\u0b9a\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0b9a\u0bc6\u0bbe\u0ba9\u0bcd\u0ba9\u0bae\u0ba4\u0baa\u0bcd\u0b95\u0baa\u0bc6\u0bbe\u0bb2, \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0bc6\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd \u0ba4\u0bbf\u0bae\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bc1\u0bae\u0bcd \u0baa\u0bc1\u0bae\u0b95\u0baf\u0bbf\u0bb0\u0ba4\u0ba4\u0bcd \u0ba4\u0bbf\u0bae\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bc1\u0bae\u0bcd \u0ba4\u0baa\u0bc6\u0bbe\u0ba4\u0bc1\u0bc8\u0b95\u0bcd\u0b95\u0b95\u0bb3\u0bc6\u0bbe\u0b9f\u0bc1 \u0b95\u0bb2\u0ba8\u0bcd\u0ba4\u0bc1\u0bae\u0bb0\u0baf\u0bc6\u0bbe\u0b9f\u0bbf, \u0b85\u0bae\u0b9f\u0baf\u0bc6\u0bbe\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bb5\u0bc0\u0ba4\u0bbf\u0b95\u0bae\u0bb3 \u0b87\u0ba8\u0bcd\u0ba4 \u0bb5\u0bb0\u0bc1\u0b9f Budget\u0b87\u0bb2\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc6\u0bbe\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0ba4\u0bcd\u0ba4\u0bb0 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bc8\u0bc6\u0bbe? \u0b85\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd, \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0b9a\u0bc6\u0bbe\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0bb5\u0bc6\u0bbe\u0bb1\u0bc1 \u0b87\u0ba8\u0bcd\u0ba4\u0baa\u0bcd \u0baa\u0bc1\u0bae\u0b95\u0baf\u0bbf\u0bb0\u0ba4\u0baa\u0bcd \u0baa\u0bc6\u0bbe\u0bae\u0ba4\u0baf\u0bc1\u0b9f\u0ba9\u0bcd \u0b9a\u0bc8\u0bc6\u0bbe\u0ba8\u0bcd\u0ba4\u0bb0\u0bc8\u0bc6\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0bc6\u0bbe\u0bae\u0ba4\u0b95\u0bb3\u0bcd \u0b85\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0b9f\u0baf \u0bb5\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0bae\u0ba4\u0ba4\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd \u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0b95\u0bb1\u0ba9\u0bcd. \u0b87\u0baa\u0bcd\u0baa\u0b9f\u0bbf\u0baf\u0bc6\u0bbe\u0ba9 \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1\u0b95\u0bae\u0bb3\u0b9a\u0bcd \u0ba4\u0b9a\u0baf\u0bcd\u0ba4\u0bc1 \u0b85\u0ba8\u0bcd\u0ba4 \u0bc8\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0b9f\u0baf \u0baa\u0bbf\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0bae\u0ba9\u0bae\u0baf\u0b95\u0bcd \u0b95\u0bc6\u0bbe\u0bb2\u0bae\u0bcd \u0ba4\u0bc6\u0bbe\u0bb4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bc8\u0bb2\u0bcd \u0b89\u0b9f\u0ba9\u0b9f\u0bbf\u0baf\u0bc6\u0bbe\u0b95\u0ba4\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bc8\u0bc6\u0bbe?\n\n\u0d85\u0db4\u0da7 \u0dd9\u0d9a\u0dd4\u0dab\u0dd4 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0db8\u0dcf\u0dca\u0d9c\u0daf\u0d86\u0dad\u0dca \u0daf\u0db8\u0dca \u200d\u0dbb\u0dc1\u0dca\u0dae\u0db1\u0dba \u0d92 \u0dc0\u0dcf\u0daf\u0dda\u0db8 \u0dad\u0dd2\u0daf\u0db6\u0db1\u0dc0\u0dcf. \u0d9c\u0dbb\u0dd4 \u0d9c\u0dba\u0dca\u0dad \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dad\u0dd2\u0dbd\u0d9a \u0db8\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dcf \u0db1\u0dd2\u0daf\u0dba\u0ddd\u0da2\u0dcf\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0d9c\u0dcf\u0dbd\u0dca\u0daf\u0dbd\u0dca\u0dad\u0dca \u0d9a\u0dc5\u0dd4\u0dad\u0dbb \u0dc0\u0dcf\u0daf\u0dda \u0daf\u0dd2\u0dcf\u0dae\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dc0\u0dbd\u0dad\u0dca \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dcf \u0dbb\u0dcf\u0dae \u0db8\u0dcf\u0dca\u0d9c \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0daf\u0db6\u0db1 \u0dcf\u0db8\u0dcf \u0dbb \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0dca\u200d\u0dcf\u0dbb\u0dd2 \u0dc0\u0dcf\u0db8\u0dca \u0dad\u0dd2\u0daf\u0db6\u0db1\u0dc0\u0dcf \u0d9c\u0dbb\u0dd4 \u0d9a\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0d91\u0d9a \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0dca\u200d\u0dcf\u0dbb\u0dd2 \u0dc0\u0dcf\u0db8\u0d9a \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dcf \u0dbb\u0dcf\u0dae \u0db8\u0dcf\u0dca\u0d9c \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0daf\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0d9a\u0dd2\u0dba\u0dca\u0daf\u0dca \u0d91\u0d9a\u0db8 \u0d9c\u0daf\u0db8\u0dca \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0db8\u0dcf\u0dca\u0d9c\u0dba cross \u0dc0\u0db1\u0dc0\u0dcf \u0dcf \u0dbb\u0dcf\u0dae \u0db8\u0dcf\u0dca\u0d9c \u0dcf \u0dad\u0d9a\u0dd2\u0dca \u0db4\u0dcf \u0d9a\u0dd2\u0dca \u0daf\u0dcf \u0ddd \u0dad\u0dd4\u0db1\u0d9a\u0dd2\u0dca \u0dc0\u0dcf\u0daf\u0dda.\n\n\u0daf\u0db8\u0dca \u200d\u0dbb\u0dc1\u0dca\u0dae\u0db1\u0dba \u0dba\u0dd4\u0dc1\u0dca\u200d\u0dba \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u200d\u0dbb\u0daf\u0dc1\u0dc1\u0dca\u0dc0\u0dbd\u0da7 \u0dc0\u0dd2\u0daf\u0dc1\u0dca\u0dae\u0dd2\u0dad\u0dc0\u0dad\u0dca \u0d85\u0daf\u0db1\u0d9a\u0dca \u200d\u0dbb\u0daf\u0dc1\u0dc1\u0dca\u0dc0\u0dbd\u0da7\u0dad\u0dca \u0db6\u0dbd\u0db4\u0dcf\u0db1\u0dc0\u0dcf. \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0 \u0dad\u0db8\u0dca\u0daf\u0dda \u0db4\u0dcf \u0dc3\u0dd4\u0dc0 \u0dcf\u0dc4\u0dcf \u0dcf \u0db4\u0dcf\u0dbb \u0dcf \u0dd9\u0dcf \u0d9c\u0dca\u0db1 \u0d91\u0d9a \u0dc0\u0dd0\u0dbb\u0dd0\u0dc1\u0dd9\u0d9a\u0dca \u0db1\u0dd0\u0dcf \u0dd0. \u0d9c\u0dbb\u0dd4 \u0d9a\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0db8\u0dcf\u0dca\u0d9c\u0dba \u0d9a\u0dd2\u0dba\u0dca\u0daf\u0dca \u0d85\u0db0\u0dd2\u0daf \u0d9c\u0dd3 \u0db8\u0dcf\u0dca\u0d9c\u0dba \u0dc0\u0dcf\u0daf\u0dda dedicated track \u0d91\u0d9a\u0d9a\u0dca. \u0d92\u0d9a \u0db8\u0dd0\u0dc1\u0daf\u0dd9\u0dca \u0db1\u0dd2\u0dad\u0dbb \u0daf\u0dc0\u0db1 \u0daf\u0dc0\u0db1 \u0dcf \u0dbb\u0dcf\u0dae \u0db8\u0dcf\u0dca\u0d9c \u0db1\u0dd2\u0daf\u0dba\u0dcf\u0dad\u0dca \u0daf\u0d9a\u0ddd\u0da0\u0dca\u0da0\u0da0\u0dd2\u0daf\u0dba\u0dca \u0d9a\u0dbb\u0db1 \u0dc0\u0dd0\u0daf\u0dda \u0d9a\u0dbb\u0dca\u0db1 \u0daf\u0dc0\u0dca\u0daf\u0dca \u0db1\u0dd0\u0dcf \u0dd0. \u0d85\u0db4\u0dd2 expressways\u0dc0\u0dbd \u0db8\u0dd0\u0dc1\u0daf\u0dd9\u0dca \u0dcf \u0dd0\u0db8 \u0dad\u0dd0\u0db1\u0dd2\u0dca\u0db8 \u0dcf \u0dbb\u0dcf\u0dae \u0db8\u0dcf\u0dca\u0d9c \u0dad\u0dd2\u0dda\u0daf\u0db6\u0dcf\u0dad\u0dca \u0d92\u0dc0\u0dcf expressways \u0daf\u0dc0\u0dca\u0daf\u0dca \u0db1\u0dd0\u0dcf \u0dd0. \u0d92\u0dc0\u0dcf \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0\u0daf\u0dda \u0db4\u0dcf \u0dc3\u0dd4\u0dc0 \u0dcf\u0dc4\u0dcf \u0dcf\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0dad\u0dd2\u0daf\u0db6\u0dca\u0daf\u0dca. \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0\u0da7\u0dad\u0dca \u0d85\u0dc0\u0dc1\u0dca\u0dba \u0daf\u0dc0\u0db1\u0dc0\u0dcf \u0dcf\u0db8\u0dcf \u0dbb\u0dc0\u0dd2\u0da7 \u0daf\u0d9a\u0dcf\u0dc5\u0db9 \u0d89\u0dc4\u0dbd\u0dcf \u0d89\u0d9a\u0dca\u0db8\u0db1\u0dd2\u0dca \u0d95\u0db8\u0dca\u0dad\u0dba\u0da7 \u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dcf\u0dc0\u0da7 \u0dba\u0dca\u0db1. \u0dcf \u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0db8\u0dcf\u0dca\u0d9c\u0dba \u0db8\u0dd0\u0dc1\u0daf\u0dd9\u0dca \u0daf\u0d9c\u0dcf\u0da9\u0d9a\u0dca \u0dcf \u0dbb\u0dcf\u0dae \u0db8\u0dcf\u0dca\u0d9c \u0dca\u0daf\u0dc0\u0dcf\u0dad\u0dca \u0d92\u0d9a \u0d9a\u0dbb\u0dca\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0daf\u0dc0\u0db1\u0dc0\u0dcf. \u0d92 \u0db1\u0dd2\u0dcf\u0dcf \u0daf\u0db8\u0dca\u0daf\u0d9a\u0dca \u0daf\u0dad\u0ddd\u0dbb\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0d9a\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d9a\u0dc0\u0dd9\u0dcf \u0dc0\u0dd4\u0dab\u0dad\u0dca \u0d9a\u0dbb\u0dca\u0db1 \u0daf\u0dc0\u0dca\u0daf\u0dca."
  },
