    "chunk_text": "\u0dd4\u0db4\u0dd2 \u0dd4 \u0dc0\u0dc0\u0dd0\u0dc3\u0dd4\u0dd9 \u0daf\u0dd3\u0dd9\u0db1\u0db1\u0dc0 \u0dc0\u0dd0\u0dd2 \u0dd9\u0db1. \u0dd4 \u0dc0\u0dc0\u0dd0\u0dc3\u0dd4\u200d\u0dd9\u0db1\u0dca\u0daf \u0db4\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0d9a\u0dca\u0dc2\u0dc2\u0dba 8\u0d9a\u0dca\u0dc2 \u0d89\u0dc0\u0dad\u0dca \u200d\u0dc0\u0db1\u0dca\u0daf\u0db1 \u0dc4\u0dd2\u0dd2\u0dba\u0db1. \u0dd4\u0db4\u0dd2 \u0dd4 \u0dc0\u0dc0\u0dd0\u0dc3\u0dd4\u200d\u0dd9\u0db1\u0dca\u0daf \u0d89\u0dc0\u0dad\u0dca \u200d\u0dc0\u0db1\u0dca\u0daf\u0db1 \u0dc4\u0dd2\u0da7\u0dbb \u0db4\u0dc0\u0dd4\u0dbd\u0dca \u0dd2 \u0dad\u0dc0 \u0db1\u0d9a\u0dba\u0d9a\u0dca\u0dc2 \u0dad\u0dd2\u0dbd\u0dba\u0db1 \u0d9c\u0dad\u0dca\u0dad\u0db1 \u0db4\u0dd9\u0dab\u0d9a\u0dca\u0dc2 \u200d\u0db1\u0db1\u200d\u0dc0\u0dd2, \u0dd4 \u0dc0\u0dc0\u0dd0\u0dc3\u0dd4\u0dd9 \u0daf\u0dd3\u0dd9\u0db1\u0db1\u0dc0 \u0dc0\u0dd0\u0dd2 \u0dbb\u0d9a\u0db1\u0dad\u0dca \u0dd4\u0db1\u0dca\u0daf\u0db1\u0db1. \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 8,500\u0d9a\u0dca\u0dc2 \u0d9a\u0db6\u0db1 \u0d9c\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0d9a\u0db1\u0dd2\u0db1\u0dba\u0db1\u0da7 \u0dd4\u0db4\u0dd2 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 10,000\u0d9a\u0dca\u0dc2 \u200d\u0dc3\u0db1\u0dc0\u0db1. \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 15,000\u0d9a\u0dca\u0dc2 \u0d9a\u0db6\u0db1 \u0d9c\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0d9a\u0db1\u0dd2\u0db1\u0dba\u0db1\u0da7 \u0dd4\u0db4\u0dd2 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 17,500\u0d9a\u0dca\u0dc2 \u200d\u0dc3\u0db1\u0dc0\u0db1. \u0dd4 \u0dc0\u0dc0\u0dd0\u0dc3\u0dd4\u0dd9 \u200d\u0db1\u0db1\u0d9a\u0dd0\u0db6\u0dd4\u0dab\u0dd4 \u0dd4\u0dba\u200d\u0d9c\u0db1\u0dca\u0daf \u0dd4\u0dba\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca \u0dd0\u0db3\u0dc0\u0d9a\u0db1 \u0dad\u0dc0\u0dad\u0dca \u0db4\u0dc0\u0dd4\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd9\u0db1\u0dab\u0dba \u0da7 \u0d91\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0d9a\u0db1 \u0dba \u0d9a\u0db6\u0db1 \u200d\u0dc3\u0db1\u0dca\u0daf\u0db1 \u0d87\u0dd9\u0dad\u0dd2\u0dbd\u0dad\u0dd4\u0dd9\u0db1\u0dca\u0daf\u0d9a\u0db1 \u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0dbb\u0db1\u0dc0\u0db1. \u200d\u0db1\u0db1\u0dc0\u0dd0\u0db8\u0dca\u0db6\u0d9c, \u200d\u0dc3 \u0dd0\u0db8\u0dca\u0db6\u0d9c \u200d\u0dc0\u0db1\u200d \u0db1\u0da7 \u0d92 \u0dd4\u0dba\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca \u0dd0\u0db3\u0dc0\u0dd3\u0dd9 \u0dd4\u0dc0 \u0db1\u0dca\u0daf \u0dbb\u0db1\u0dc0\u0db1. \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0d9a\u0db1 \u0d9a\u0dd0\u0db6\u0dd2\u0dba \u0dd4\u0dad\u0dad\u0dd4 \u0db4\u0dc0\u0dd4\u0dbd\u0dca\u0dc0\u0d9a\u0da7 \u0dd4\u0db4\u0dd2 \u0d92 \u0d9a\u0db6\u0db1 \u200d\u0dc3\u0db1\u0dc0\u0db1.\n\n\u0d9c\u0dbb\u0dd4 \u0dcf\u0db1\u0db1\u0db1\u0dba \u0dad\u0dd4\u0dd9\u0daf\u0dc4, \u0d9a\u0dd2 \u0db8\u0dca \u0dc0\u0db1\u200d\u0dda \u0dca\u0db6\u0db1\u0db0 \u0dad\u0dd2\u0dbd\u200d\u0db6\u0db1 \u0dc3\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0daf\u0da7 \u0daf\u0dd2\u0dc0\u0db1 \u0dc3\u0dd4\u0dbb\u0dd0\u0dc0\u0dda\u0db8\u0dca \u0dd9\u0db0\u0dba \u0dc0\u0dcf\u0db1\u0db1 \u0dca\u0dc3\u0db1\u0dca\u0daf\u0db1\u0dad\u0dca \u0dd4\u0db4\u0dd2 \u0dd4\u0daf\u0dc3\u0dbd\u0dca \u200d\u0dc0\u0db1\u0dca\u0daf \u0dbb \u0dad\u0dd2\u0dbd\u200d\u0db6\u0db1\u0dc0\u0db1. \u0d92 \u0db3\u0dca\u0db1 \u0dd9 \u0dc0\u0dad\u0dba\u0d9a\u0dca\u0dc2 \u0dca\u0dd0\u0dd2\u0dba\u0da7 \u0d9c\u0dad\u0dca\u200d\u0dad\u0db1\u0dad\u0dca, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1,000\u0d9a\u0dca\u0dc2 \u200d\u0dc0\u0db1\u0dca\u0daf \u0dbb\u0d9a\u0db1 \u0dad\u0dd2\u0dbd\u200d\u0db6\u0db1\u0dc0\u0db1. \u0dd4\u0db4\u0dd2 \u200d\u0db8\u0dca \u0db3\u0dca\u0db1 \u0dbd\u0dd2\u0db1\u0dca\u0daf \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 547\u0d9a\u0dca\u0dc2 \u200d\u0dc0\u0db1\u0dca\u0daf \u0dbb\u0d9a\u0db1 \u0dad\u0dd2\u0dbd\u0db6\u0dd4\u0dab\u0db1. \u0dc3\u0dd0\u0db1\u0dca\u0daf \u200d\u0dd9\u0dc0\u0dbb \u0dd4\u0dbd\u0dd4\u200d\u0dad\u0db1\u0dca\u0daf \u0dad\u0dc0\u0dad\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 500\u0d9a\u0dca\u0dc2 \u200d\u0dc0\u0db1\u0dca\u0daf \u0dbb\u0d9a\u0db1, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1,000 \u0da7 \u0dc0\u0da9\u0db1 \u200d\u0dc0\u0db1\u0dca\u0daf \u0dbb\u0db1\u0dc0\u0db1, \u0d9a\u0dd2 \u0db8\u0dca \u0dc0\u0dd0\u0daf\u0dc4 \u0dca\u0db6\u0db1\u0db0 \u0dc4\u0dd2\u0dad \u0dc3\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0daf \u0db3\u0dca\u0db1 \u0daf\u0dd2\u0dc0\u0db1 \u0dc3\u0dd4\u0dbb\u0dd0\u0dc0\u0dda\u0db8\u0dca \u0dd9\u0db0\u0dba \u0dc0\u0dcf\u0db1\u0db1 \u0dca\u0dc3\u0db1\u0dca\u0daf\u0db1\u0da7. \u0dd4\u0db4\u0dd2 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dc0\u0dad\u0db1\u200d\u0dda \u200d\u0dc0\u0db1\u0dca\u0daf \u0dbb\u0dbb \u0dd4\u0daf\u0dc3\u0dbd\u0dd2\u0db1\u0dca\u0daf \u0d9a\u0dd2 \u0db8\u0dca \u0dad\u0dd2\u0dbd\u200d\u0db6\u0db1 \u0dc3\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0daf\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd \u0db1\u0dbb \u0dd9\u0db0\u0dba \u0dc0\u0dcf\u0db1\u0db1\u0dba\u0d9a\u0dca\u0dc2 \u0dca\u0dc3\u0db1\u0dca\u0daf\u0db1 \u0dc3\u0dd0\u0db1\u0dca\u0daf LRH \u0d91 \u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0dbb\u0db8\u0dd2\u0db1\u0dca\u0daf \u0dc3\u0dd2\u0dd2\u0db1\u0dc0\u0db1. \u0dca\u0db6\u0db1\u0db0 \u0dc4\u0dd2\u0dad \u0dd4\u0dba\u0da7 \u200d\u0db4\u0db1\u0dd4 \u0dc0\u0dcf\u0db1\u0db1 \u200d\u0dc0\u0dad \u0db4\u0dca\u200d\u0dbb\u200d\u0dda\u0dc1\u0dca \u0dc0\u0dd3\u200d\u0db8\u0dca \u0db4\u0dca\u0dc3\u0dd4 \u0db8\u0dca \u0db3\u0dca\u0db1\u0dad\u0dca, \u0db1\u0dd3\u0db4\u0db1\u0dbb\u0d9a\u0dca\u0dc2\u0dc2\u0dba \u0db4\u0dca\u0dc3\u0dd4 \u0db8\u0dca \u0dd0\u0db4\u0db8 \u0dd9\u0da7\u0dad\u0dca \u0dad\u0dc0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1,000\u0d9a\u0dca\u0dc2 \u200d\u0dc0\u0db1\u0dca\u0daf \u0dbb\u0d9a\u0db1 \u0dad\u0dd2\u0dbd\u200d\u0db6\u0db1\u0dc0\u0db1."
