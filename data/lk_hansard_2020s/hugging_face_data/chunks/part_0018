u0d82\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0d82\u0dbd\u0dca\u200d\u0dcf\u0db4\u0dca\u200d\u0dbb\u0db4\u0dcf\u0db4\u0dca\u200d\u0dbb\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0db1\u0dc0\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da9\u0dcf\u0dbd\u0dca\u200d\u0dbb\u0dca\u0dbd \u0db6\u0dd2 \u0dbd\u0dd2\u0dba\u0db1 7 \u0db8\u0dda\u0dbb\u0db8 \u0dbb \u0d91\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9c\u0db1 \u0dba\u0da7 \u0db1. \u0d85\u0db4\u0dca\u200d\u0dbb\u0db4\u0dca \u0dc3\u0dcf\u0dbb\u0dca\u0dbd\u0dc0 \u0d86\u0dbb\u0dca\u0dbd\u0dbb \u0dba \u0dc3\u0dca\u0dc3\u0dcf\u0dc0\u0dbb \u0dbb\u0dbd\u0dca\u200d\u0dcf \u0dad\u0dd2\u0db4\u0dca\u200d\u0dbb\u0d82\u0da7 \u0db4\u0dca\u200d\u0dbb\u0da7 \u0d91\u0db4\u0dca\u200d\u0dbb\u0dc4\u0db8\u0db1\u0dca. \u0d85\u0db4\u0dd2 \u0d91\u0db4\u0dca\u200d\u0dbb\u0dc4\u0db8 \u0dbb\u0dbd\u0dca\u200d\u0dcf \u0dad\u0dd2\u0db4\u0dca\u200d\u0dbb\u0d82\u0da7 \u0db4\u0dca\u200d\u0dbb\u0da7 \u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0da9\u0dcf\u0dbd\u0dca\u200d\u0dbb\u0dca\u0dbd \u0db6\u0dd2 \u0dbd\u0dd2\u0dba\u0db1 0 \u0dbb \u0d86\u0dc3\u0da7 \u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dda \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dc0\u0dc3\u0db4\u0dca\u200d\u0dbb\u0dbb\u0dca\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dc0\u0dcf\u0dc4\u0db1 \u0d86\u0db1\u0dba\u0db1\u0dba \u0dc3\u0dcf\u0dc4\u0dcf \u0dc0\u0dd2\u0dba\u0db1 \u0dbb\u0db1 \u0d85\u0dca\u200d\u0dbb\u0dad\u0dd4\u0db8\u0dbb\u0db1\u0dca.\n\n\u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0db4\u0dca\u200d\u0dbb\u0dba \u0dca\u200d\u0dba \u0dc3\u0dcf\u0db1\u0dcf\u0dba \u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba \u0dab\u0dba \u0d9c\u0dd4\u0db1 \u0dd2\u0dbb\u0dba\u0db1\u0db4\u0dca\u200d\u0dbb \u0dcf\u0dbb \u0db8\u0dbb \u0dc3\u0dcf\u0dc4\u0da7 \u0dbb\u0da7 \u0db1 \u0dbb\u0dd4\u0dab\u0dd4 \u0d9a\u0dd3\u0db4\u0dba\u0dda \u0dad\u0dd2\u0db4\u0dca\u200d\u0dbb\u0d82\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 0000 \u0dc0\u0dc3\u0db4\u0dca\u200d\u0dbb\u0dbb\u0dca\u0dbd \u0d82\u0d9a\u0db4\u0dca\u200d\u0dbb \u0dcf\u0db4\u0dca\u200d\u0dbb\u0dbd\u0dca\u200d\u0dcf\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc0\u0db1\u0db4\u0dca\u200d\u0dbb \u0dcf\u0dbb \u0d85\u0db4\u0dbb \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d85\u0dbb\u0dca\u0dbd\u0db6\u0dd4\u0db1\u0dba\u0dda \u0dca\u200d\u0db8\u0db1\u0dca \u0dc0\u0dd2\u0db4\u0dca\u200d\u0dbb\u0dd3\u0dba \u0dba \u0dab\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dc0\u0dcf \u0d9c\u0da7 \u0db1 \u0d82\u0dd4\u0dba\u0dd0 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0da0\u0dca\u0dbb \u0d91 . \u0dc0\u0dd2\u0db4\u0dca\u200d\u0dbb\u0dd3\u0dba \u0dba \u0dab\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dc0\u0dcf \u0d9c\u0da7 \u0db1 \u0d82\u0dd4\u0dba\u0dd0 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbd\u0dca\u200d\u0dcf \u0d85\u0db4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0da9\u0dcf\u0dbd\u0dca\u200d\u0dbb\u0dca\u0dbd \u0db6\u0dd2 \u0dbd\u0dd2\u0dba\u0db1 38 \u0dbb \u0d86\u0dc3\u0da7 \u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dc4\u0dd2\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbd\u0dca\u200d\u0dcf \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf. \u0dc4\u0dd4\u0d82\u0dd4\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dbd\u0dd2\u0db4\u0dca\u200d\u0dbb \u0da7 \u0dad\u0dd4\u0db8\u0db4\u0dca\u200d\u0dbb\u0dda\u0daf\u0dd3\u0dc0\u0dad\u0dca \u0d91\u0dc5\u0dd2\u0db4\u0dca\u200d\u0dbb\u0dda\u0daf\u0dd3\u0dc0\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dda \u0dc3\u0dd4\u0d82\u0dd1 \u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dc5\u0dd2 \u0dbb\u0da7 \u0db4\u0dca\u200d\u0dbb\u0da7 \u0db1\u0dd4\u0dc4\u0dd4 \u0dc3\u0dd4\u0d82\u0dd1 \u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0d9c\u0dd4\u0db1 \u0dc3\u0dcf \u0da0\u0dca\u0da1\u0dcf \u0dbb\u0da7 \u0db4\u0dca\u200d\u0dbb\u0da7 \u0db1\u0dd4\u0dc4\u0dd4 \u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0db4\u0dca\u200d\u0dbb\u0dba \u0dca\u200d\u0dba \u0dc3\u0dcf\u0db1\u0dcf\u0dba \u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba. \u0d85\u0db4\u0dbb \u0dc0\u0dd2\u0db4\u0dca\u200d\u0dbb\u0dd3 \u0dab\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dc0\u0da7 \u0db1 \u0dad\u0dd2\u0db4\u0dca\u200d\u0dbb\u0d82\u0db1\u0dc0\u0dcf. \u0dd3\u0dc0\u0dd2\u0db4\u0dcf\u0dbb\u0dca\u0dbd \u0dca\u0dc0\u0dd2 \u0dab\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dc0\u0da7 \u0db1 \u0dad\u0dd2\u0db4\u0dca\u200d\u0dbb\u0d82\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0db4\u0dca\u200d\u0dbb \u0db8 \u0d82\u0dc4\u0db4\u0dcf\u0dbb\u0dca\u0dbd \u0dca\u0dc0\u0dd2 \u0dab\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dc0\u0da7 \u0db1 \u0dad\u0dd2\u0db4\u0dca\u200d\u0dbb\u0d82\u0db1\u0dc0\u0dcf. \u0db4\u0dca\u200d\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db1 \u0db8 \u0d85\u0db4\u0dd2 \u0d85\u0db1\u0dbb\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dc0\u0dcf \u0db4\u0dca\u200d\u0dbb\u0d9c\u0db1 \u0dba\u0db1\u0dc0\u0dcf."
