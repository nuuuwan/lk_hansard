dd2\u0db0\u0dcf\u0db1\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dad\u0dd2\u0dbb\u0dc3\u0dbb \u0dc3\u0d82 \u0dbb\u0dca\u0dbd\u0db0\u0db1 \u0d89\u0dbd\u0dca\u0d9a \u0d85\u0db1\u0dd4 \u0d9a\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0dc3\u0d9a\u0dbd\u0dc3\u0dd4\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc4\u0dcf \u0d85\u0d9b\u0dca\u200d\u0dab\u0dca\u0da9 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0d9a\u0db8 \u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 3\n\n* \u0dc3\u0db7\u0dcf\u0dca\u0db8\u0dca\u0dc3\u0dba \u0dd9\u0dad \u0dad\u0db6\u0db1 \u0dbd\u0daf \u0d87\u0db8\u0dd4\u0dd4\u0dd9: \u0b9a\u0baa\u0bc6\u0bbe\u0baa\u0bc0\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bae\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0bae\u0ba3\u0baa\u0bcd\u0baa\u0bc1 : Annex tabled:\n\n\u0d9c\u0dd4 \u0dc3\u0dd4\u0db1\u0dd2\u0dbd\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dca\u0db1\u0dad\u0dca\u0dad\u0dd2 \u0dd9\u0dc4\u0dad\u0dcf (\u0d9a\u0dbb\u0dca\u0dd9\u0dcf\u0db1\u0dca\u0dad \u0dc3\u0dc4 \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba\u0d9a\u0dad\u0dca\u0dc0 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dcf\u0db1 \u0d85\u0dd9\u0dcf\u0dad\u0dba\u0dd4\u0dbb\u0dd9\u0dcf) (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b9a\u0bc1\u0ba9\u0bbf\u0bb2\u0bcd \u0bb9\u0ba8\u0bcd\u0ba4\u0bc1\u0ba9\u0bcd\u0ba4\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf - \u0bae\u0b95\u0ba4\u0bcd\u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0baf\u0bb1\u0bcd\u0b9a\u0bbf\u0baf\u0bc6\u0bbe\u0ba3\u0bcd\u0bae\u0bc8 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd) (The Hon. Sunil Handunnetti - Minister of Industry and Entrepreneurship Development) \u0dd2\u0dd4\u0dc0 \u0d9a\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0db8 \u0db1\u0dd2, \u0dd2\u0dd4\u0dc0 \u0dbb\u0dd3 \u0d9a\u0dd