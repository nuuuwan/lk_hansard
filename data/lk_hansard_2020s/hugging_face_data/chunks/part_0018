    "chunk_text": "\u0d85\u0daf \u0dc3\u0db8\u0daf\u0dca \u0db8 \u0dc0\u0db8 \u0d86\u0dbb\u0dda\u0db7\u0d9a \u0d9a\u0dae\u0dcf\u0db8\u0dda\u0daf\u0dd3 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0dc0\u0dcf\u0db8 \u0db8\u0dda\u0d9a \u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dba \u0dba\u0dd4 \u0daf\u0dd3\u0dad\u0db8\u0d9d \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dd2\u0dba\u0d9a. \u0dc0\u0dad\u0db8\u0dda\u0db8 \u0dc0\u0dcf\u0db1 \u0d87\u0db8 \u0dc0\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0db8 \u0dc0\u0da7 \u0db8\u0dc4\u0ddd \u0db8 \u0dc0\u0da7 \u0d9a\u0dd2\u0db1\u0dca \u0dc4\u0dd2\u0da7\u0dd4 \u0d87\u0db8 \u0dc0\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0db8\u0dda\u0daf\u0db1\u0dba\u0d9a \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0d96\u0dc2\u0dca\u200d \u0dd2\u0dba\u0dbd \u0d85\u0dca \u0d9a\u0dbb \u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dcf\u0dda\u0dcf\u0dc0\u0dbb\u0dd9\u0dba\u0d9a \u0dad\u0dd2\u0db6\u0dd4\u0db8\u0da9\u0dd4\u0d9a \u0db1\u0dd0\u0dc4\u0dd0. \u0dc3\u0db8 \u0dc0\u0dc4\u0dbb \u0d87\u0db8 \u0dc0\u0dad\u0dd2\u0dc0\u0dbb\u0dd4 \u0db8\u0dda\u0d9a\u0da7 \u0dc3\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0d9a\u0dc5\u0dcf\u0d8b \u0dd2\u0dba\u0dbd \u0dc3\u0dd6\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0d8b \u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0db8\u0dda\u0daf\u0db1 \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dc5\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca\u0d8b \u0d96\u0dc2\u0dca\u200d \u0dd2\u0dba\u0dbd \u0d85\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0da7 \u0db8\u0db8\u0dbb\u0dc4\u0dd2 \u0d9a\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba\u0dda \u0dc3\u0dc4 \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0db8\u0daf\u0dca\u0dba\u0dbb\u0dcf\u0dbd\u0db1\u0db8\u0dba\u0db1\u0dca \u0db1\u0da9\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0d9a\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba\u0dda\u0d8b \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0db8 \u0dc0\u0dcf\u0dca\u200d\u0dba \u0dca\u200d\u0dbb\u0da0\u0dcf\u0dbb \u0dbd\u0db6\u0dcf \u0db8\u0daf\u0db1 \u0d9a\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba\u0dda \u0dc0\u0dd2\u0db1\u0dca\u0db1\u0dca \u0dc0\u0dd2\u0dc0\u0dd2\u0dca\u200d \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8 \u0dc0\u0dcf\u0dad\u0db8\u0dd0 \u0d94\u0dc3\u0dda\u0db8\u0dc3\u0dda \u0db8\u0db8 \u0dc0 \u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0db8\u0dda\u0daf\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8 \u0dc0\u0d9a \u0dc0\u0dd3\u0db8 \u0dc0 \u0dc0\u0dd0\u0dc5\u0dd0\u0d9a\u0dc0\u0dd6\u0dc0\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d85\u0dbb\u0da7 \u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0d9a\u0db8 \u0dc0 \u0dbd\u0dd0\u0db6\u0dd4\u0dd9\u0dcf\u0d8b \u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0db8\u0dda\u0daf\u0db1\u0dba\u0d9a \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dbb\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dad\u0dca\u0d8b \u0dbb\u0dcf\u0dad\u0db8\u0dd2\u0db8\u0dda\u0db1\u0dca \u0db8\u0dda \u0d85\u0db1\u0dd4\u0db8 \u0dc0\u0dd0\u0dad\u0dd2\u0dba\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dbb\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dad\u0dca. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 MRP \u0db8\u0d9a \u0dc3\u0dc4 MCP \u0db8\u0d9a \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0dcf \u0daf\u0dd3\u0dbd\u0dcf \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d96\u0dc2\u0dca\u200d \u0db1\u0dd2\u0dba\u0dcf\u0db8 \u0dc0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0db8\u0dda \u0d96\u0dc2\u0dca\u200d \u0dd2\u0dba\u0dcf\u0dbb\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dc0\u0dd3\u0db8\u0dda\u0daf\u0dd3 \u0dc3\u0dc4 \u0db1\u0dc0 \u0dd2\u0dba\u0dcf\u0dbb\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dc0\u0dd3\u0db8\u0dda\u0daf\u0dd3 \u0d85\u0dbb\u0da7 \u0daf\u0dd0\u0db1\u0dca \u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0d8b \u0dc3\u0dcf\u0dca\u200d\u0dcf\u0dbb\u0dd9 \u0dd2\u0dba\u0dbd\u0d9a \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dbb\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0d85\u0dba\u0db8 \u0d96\u0dc2\u0dca\u200d \u0dd2\u0dba\u0dcf\u0dbb\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db1.\n\n\u0db8\u0dda \u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0dbb\u0dad\u0dca\u200d\u0dbb\u0dba \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u0daf\u0dd3 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d96\u0dc2\u0dca\u200d \u0db1\u0dd2\u0dba\u0dcf\u0db8 \u0dc0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dbb\u0db1\u0db8\u0dad\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc0\u0db1 \u0d86\u0d9a\u0dcf\u0dbb\u0dba\u0da7 \u0d92 \u0dbb\u0dcf\u0dad\u0db8\u0dba\u0dda\u0dc0 \u0dc0\u0dd2\u0db8 \u0dc0\u0dc3\u0dcf \u0db1\u0dca\u0da7\u0dd2\u0dba\u0dcf. \u0d92 \u0d85\u0dba \u0db8\u0d9a\u0d9f \u0db8\u0dc0\u0db1\u0dca\u0db8\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0db8\u0dc0\u0db1\u0dca\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0db8 \u0dc0\u0dc3\u0dcf \u0db1\u0dca\u0da7\u0dd2\u0dba\u0dcf. \u0d85\u0db4\u0dd2 \u0db8\u0db8 \u0dc0\u0dcf\u0d9a\u0d9a\u0daf \u0d9a\u0dbb\u0db1\u0dca\u0db8\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0db8\u0d9a \u0d85\u0db4\u0dd2 \u0daf\u0dd0\u0db1\u0dd4\u0dda \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf.\n\n\u0d92 \u0dc0\u0dcf\u0db8 \u0db8 \u0dc0 \u0d85\u0db8\u0db1\u0d9a \u0dbb\u0dd0\u0dad\u0dca\u0db8\u0dda\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0dc3\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0d8b \u0d96\u0dc2\u0dca\u200d\u0dc0\u0dbd \u0dd2\u0dba\u0dbd \u0d85\u0dca \u0d9a\u0dc5\u0dcf\u0db8 \u0dc0 \u0dc3\u0db8 \u0dc0\u0dc4\u0dbb \u0dc3\u0db8 \u0dc0\u0dcf\u0dd0\u0dda \u0dbd\u0d82\u0d9a\u0dcf\u0db8\u0dc0\u0db1\u0dca \u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db8\u0db8\u0dc4\u0db8 \u0dc0 \u0db8\u0daf\u0dba\u0d9a \u0db8\u0dc0\u0db1\u0dca\u0db8\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. 2015\u0daf\u0dd3 \u0dbb\u0dcf\u0da7\u0dbd\u0dda \u0db8\u0dc3\u0dda\u0db1\u0dcf\u0dbb\u0dad\u0dca\u0db1 \u0d87\u0db8 \u0dc0\u0dad\u0dd2 \u0db8 \u0dc0\u0db1\u0dca\u0dbd\u0dcf \u0db8\u0dda \u0dbb\u0db1\u0dda \u0db8\u0dd0\u0db1\u0dcf\u0dd4 \u0db8\u0dc0\u0dbd\u0dcf\u0db8\u0dda\u0dad\u0dca \u0d94\u0dba \u0db8 \u0dc0\u0dda\u0dba\u0db8 \u0dc0 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dc3\u0db8 \u0dc0\u0dcf\u0dd0\u0dda \u0dbd\u0d82\u0d9a\u0dcf\u0db8\u0dc0\u0db1\u0dca \u0d9c\u0dd2\u0db8\u0dda \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0d9a\u0db8 \u0dc0 \u0db8\u0d9a \u0d96\u0dc2\u0dca\u200d \u0db1\u0dd2\u0dc2\u0dda\u0dbb\u0dcf\u0daf\u0d9a\u0db8\u0dba\u0d9a - \u0db8\u0d9a innovator \u0db8\u0d9a\u0db8\u0db1\u0d9a - \u0dc0\u0dd2\u0dda\u0dbb\u0d9a \u0dbb\u0da7\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0da7\u0db8\u0dc0\u0dbd\u0dcf \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dd9\u0dcf."
  },
