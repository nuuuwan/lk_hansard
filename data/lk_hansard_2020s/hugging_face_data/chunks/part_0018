    "chunk_text": "\u0db8\u0dda \u0dcf\u0db8\u0dda \u0dc0\u0dd2\u0db4\u0dca\u0dc2\u0dba\u0dca, \u0db8\u0dda \u200d\u0dbb\u0dda \u0d85\u0dc3\u0dbb\u0dab \u0db8 \u0da0\u0dca\u0da0 \u0dc0\u0dd2\u0db4\u0dca\u0dc2\u0dba\u0dca \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0db8\u0dda \u0d85\u0db4\u0dd2 \u0d9a \u0daf\u0dcf \u0db8\u0d9a \u0daf\u0d9a\u0dca\u0db8\u0dca \u0db1\u0d9a\u0dc4\u0d9a3 \u0d9a\u0db1\u0dd2\u0dcf\u0da7\u0dd4 \u0da7 \u0d9a\u0dd4\u0dc0\u0dab \u0d92\u0d9a\u0dba\u0dd23 \u0dbb\u0da7\u0d9a \u0dc3\u0d82 \u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba\u0da7 \u0db8\u0dc4\u0dcf\u0db3 \u0dc0\u0dd2\u0db4\u0dca\u0dc2\u0dba\u0dca \u0d85 \u0dba\u0dba\u0dba\u0dd23 \u200d\u0dcf\u0dbb\u0dca\u0dbd\u0d9a\u0dd2\u0d9a, \u0db6\u0dd4\u0daf\u0dca\u0db0\u0dd2\u0db8 \u0db8\u0d9a, \u0dc0\u0dd2\u0db8\u0dda\u0da0 \u0db1 \u0db8\u0dd2\u0db8\u0db1\u0db1 \u0dc0\u0dd2\u0db4\u0dca\u0dc2\u0dba\u0dca \u0d85 \u0dba\u0dba\u0dba\u0dd23 \u0d9a\u0db1\u0dd2\u0dcf\u0da7\u0dd4 \u0da7 \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u200d\u0db8 \u0dba\u0dd2, \u0d9a\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dd4\u0dc0\u0dab\u0dca \u0dc0\u0dd2\u0db1\u0dcf\u0da9\u0dd2\u0dba\u0dca \u0dba\u0db1\u0dca\u0dad\u0db1\u0da7 \u0d9a\u0dd2\u0db1\u0dca\u0dad \u0d85\u0db8\u0db1\u0dca \u0db4\u0d9a\u0db8\u0d9a\u0db8\u200d\u0db1\u0dca\u0dad \u0d9a\u0da9\u0dbd\u0dcf \u0dd2\u0dba\u0db3\u0dbd\u0dcf, \u0dc3\u0dd4\u0db1\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd4\u0db1\u0dd4 \u0d9a\u0dbb \u0daf\u0db8 \u0db1 \u200d\u0db8\u0d9a\u0db8\u0d9a \u0dba\u0da7 \u0db4\u0d9a \u0dbb\u0dca\u0dbd\u200d\u0db1\u0dba \u0dd3\u0db8 3\n\n\u0d85\u0daf \u0d8b\u0db8\u0daf\u0dca \u0dc0\u0dd2\u0db4\u0dca\u0dc2 \u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0db8 \u0dcf \u0db8\u0dda \u0dc3\u0db7\u0dcf\u0db8\u0dda \u0da2 \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0db1 \u0dcf \u0d85\u0db4\u0dd2 \u0daf\u0d9a\u0dca\u0d9a\u0dcf, \u0db8\u0dda \u0dcf\u0dba\u0dd2\u0db1\u0dca\u0dad \u0db8\u0dd2\u0dcf\u0dc0\u0dd2\u0dba\u0dcf\u0da7 \u0dbd\u0dcf\u0db7\u0dba\u0dd4\u0db8\u0d9a \u0db1\u0d9a\u0dc4\u0d9a, \u0db4\u0dcf\u0d9a \u0db8\u0db7\u0db6\u0d9c\u0dd2\u0d9a\u0dba\u0dcf\u0da7 \u0dbd\u0dcf\u0db7\u0dba\u0dd4\u0db8\u0d9a \u0db1\u0d9a\u0dc4\u0d9a \u0d9a\u0dd2\u0dba\u0dbd\u0dcf3 \u0dc4\u0d9a\u0db6\u0d9a\u0dba\u0dd2, \u0d9a\u0dd4\u0db8 \u0dcf\u0da7 \u0d85\u0db8 \u200d\u0d9a \u0dc0\u0dd4\u0dab\u0dcf, 3915 \u0da2 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd4\u0dab\u0dd4 \u0dd3\u0db8\u0db1\u0dd2 \u0d82\u0da0 \u0dcf 3 \u0d9a\u0dd4\u0db8 \u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0d9a \u0dc4\u0d9a 3 \u0d9a\u0dd4\u0db8 \u0dcf \u0d9a\u0dab\u0dca\u0dab\u0dcf\u0da9\u0dd2\u0dba\u0dca \u0d89\u0daf\u0dd2\u0d9a \u0dba\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dad\u0dbd\u0dcf \u0d9a\u0dd4\u0db8 \u0dcf\u0db8\u0dda \u0db8\u0dd4\u0dd4\u0dc0\u0dab \u0daf\u0dd2\u0dc4\u0dcf \u0db6\u0dbd\u0dcf\u0db8\u0dd2\u0db1\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1, \u0db8\u0dda\u0db8\u0d9a\u0db1\u0dca\u0dad \u0db8\u0dd2\u0dcf\u0dc0\u0dd2\u0dba\u0dcf\u0da7 \u0dcf\u0dc3\u0dd2\u0db8\u0d9a \u0db1\u0d9a\u0dc4\u0d9a, \u0db8\u0dda\u0db8\u0d9a\u0db1\u0dca\u0dad \u0db4\u0dcf\u0d9a \u0db8\u0db7\u0db6\u0d9c\u0dd2\u0d9a\u0dba\u0dcf\u0da7 \u0dcf\u0dc3\u0dd2\u0db8\u0d9a \u0db1\u0d9a\u0dc4\u0d9a \u0d9a\u0dd2\u0dba\u0dbd\u0dcf3 \u0dd3\u0db8\u0db1\u0dd2 \u0db6\u0daf\u0dd4 \u0d82\u0da0 \u0dcf\u0db8 \u0db1\u0dca\u0dad \u0dd4\u0dc0\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0dad \u0db8\u0d9a\u0db6\u0da7\u0dd2 \u0dd2\u0dab\u0db1\u0dca\u0dad \u0dc3\u0da2\u0dd2\u0db8\u0d9a \u0db8\u0dda\u0db8 \u0daf\u0dcf\u0dc3 \u0db8 \u0dc4\u0db8\u0d9a\u0db8 \u0dba\u0dbd\u0dcf \u0dc4\u0dd2\u0da7\u0db4\u0dd4, \u0dbb\u0db1\u0dd2\u0dbd\u0dca\u0dad \u0dc0\u0dd2\u200d\u0dbb\u0db8 \u0dc3\u0dd2\u0d82\u0dc4 \u0db8 \u0dc4\u0db8\u0d9a\u0db8 \u0dba\u0dbd\u0dcf \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dcf\u0dab\u0dca\u0dca \u0da7 \u0dd2\u0db8\u0d9a\u200d\u0dcf3 \u0d92\u0d9a \u200d\u0db8 \u0dba\u0dd2 \u0d85\u0daf \u0dc3\u0dc0\u0dd2\u0db8\u0d9a \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad3 \u0db8\u0dda \u0db6\u0daf\u0dd4 \u0db4\u0d9a\u0db8\u0db1\u0dda\u0db8\u0dda \u0db8\u0dd2\u0dcf\u0dc0\u0dd2\u0dba\u0dcf \u0dbb\u0dd0\u0d9a \u0dd2\u0d9a\u0db1\u0dd3\u0db8 \u0da7 \u200d\u0db8 \u0dba\u0dd23 \u0db8\u0dd2\u0dcf\u0dc0\u0dd2\u0dba\u0dcf \u0dbb\u0dd0\u0d9a \u0dd2\u0db1\u0dca\u0dad\u0db1 \u0db8\u0dda\u0d9a \u0dc0\u0dd2\u200d\u0dbb\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dc4\u0d9a \u0dba\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db1\u0d9a\u0dc4\u0d9a3\n\n\u0d92 \u0dcf\u0db8\u0dda\u0db8 \u0d85\u0dbd \u0db8\u0dd2\u0dcf\u0dd3\u0db1\u0dca\u0dad \u0d89\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad 39,999\u0dca \u0dc0\u0dd2\u200d\u0dbb3 \u0dbd\u0dd6\u0db1\u0dd4 \u0db8\u0dd2\u0dcf\u0dd3\u0db1\u0dca\u0dad \u0d89\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad 7,999\u0dca \u0dc0\u0dd2\u200d\u0dbb3 \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0db4 \u0daa \u0dd2\u0dd4\u0dc0 \u0db8 \u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db8 \u0db1\u0dd2, \u0dc4\u0d9a\u0db6\u0d9a\u0dba\u0dd2 \u0db4\u0dcf\u0d9a \u0db8\u0db7\u0db6\u0d9c\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dba\u0dcf\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dcf\u0dab\u0dba\u0dca \u0d89\u0db1\u0dca\u0dad\u0db1 \u0dcf3 \u0db4\u0dcf\u0d9a \u0db8\u0db7\u0db6\u0d9c\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0dad \u0dd2\u0d9a\u0db1 \u0d85\u0db4\u0dd2 \u0dc4\u0dd2\u200d\u0db1\u0dca\u0dad\u0db1\u0db8\u0d9a \u0d95\u0db1\u0dd13 \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0dd2\u0dcf\u0dc0\u0dd2\u0dba\u0dcf \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0db8\u0dba\u0db1\u0dca\u0dad \u0dc4\u0dd2\u200d\u0dbd\u0dcf \u0db6\u0daf\u0dd4 \u0dd2\u0dc4\u0dbd\u0dcf \u0dc0\u0dd2\u200d\u0dbb\u0dca \u0dc4\u0d9a \u0dba\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db1\u0d9a\u0dc4\u0d9a3 \u0dbb\u0dca\u0dbd\u200d\u0db8 \u0dcf\u0db1 \u0dbb \u0dba \u0d9a\u200d\u0d9a\u0db1\u0da7 \u0dc0\u0dd2\u200d\u0dbb\u0dca \u0db8\u0db1\u0dcf\u0db8 \u0dba\u0dd2 \u0d85 \u0db0\u0dcf\u0db1\u0dba \u0db8\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad3 \u0dc0\u0dd2\u0db8\u0dba\u0dca\u0dc2\u0db8\u0dba\u0db1\u0dca\u0dad \u0d85\u0dca \u0db4\u0dd2\u0d9a \u0d9a\u0dba\u0d9a\u0da7 \u0db8\u0dda \u0dcf \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd13 \u0d85\u0dca \u0db4\u0dd2\u0d9a \u0d9a\u0dba\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0db8 \u0dcf\u0db8\u0d9a \u200d\u0db8 \u0dba\u0dd2 \u0db8\u0dd2\u0dcf\u0dc0\u0dd2\u0dba\u0dcf\u0da7 \u0dbd\u0dcf\u0db7\u0dba\u0dca \u0dbd\u0d9a\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad3 \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0db4\u0dd2\u0d9a \u0d9a\u0dba \u0d85 \u0db8 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd13 \u0d92 \u0db8 \u0db1\u0dd4\u0db8 \u0db1\u0dca\u0dad \u0db8\u0dd2\u0dcf\u0dc0\u0dd2\u0dba\u0dcf\u0da7 \u0dc3\u0dc4\u0db1\u0dcf\u0db0\u0dcf\u0dbb \u0da7\u0dd2\u0d9a \u0db8\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1; \u0db8\u0dc4\u0dcf\u0db3 \u0dd3 \u0da7\u0dd2\u0d9a\u0dca \u0db8\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1; \u0db8\u0dc4\u0dcf\u0db3 \u0db8\u0db4\u0dcf\u0db8\u0dc4\u0dcf\u0dbb \u0da7\u0dd2\u0d9a\u0dca \u0db8\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd13 \u0d92 \u0dc0\u0dd2\u200d\u0dbb\u0dca \u0db8\u0db1\u0dcf\u0db8 \u0dba\u0dd2, \u200d\u0dcf\u0dca\u0dc2\u0dab\u0dba\u0db8\u0d9a \u0db8\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd13"
