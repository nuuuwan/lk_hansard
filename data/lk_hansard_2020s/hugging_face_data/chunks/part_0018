    "chunk_text": "\u0dd6\u0dbd\u0d9a\u0db1 \u0db1\u0db1\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0dd9\u0db1\u0dca\u0daf\u0dd3\u0dad\u0dd4\u0dd9\u0daf\u0dc4, \u0da2\u0dcf\u0db1\u0dad\u0dd2\u0dbd \u0da2\u0dcf\u0db1 \u0db6\u0d9a\u200d\u0dda\u0d9c\u200d\u0d86 \u0dd4\u0db4\u0da7 \u0dd4\u0dc3\u0dca \u0d9a\u0dca\u0dc2 \u0dad\u0dd2\u0dbd\u200d\u0db6\u0db1\u0dc0\u0db1. \u0d87\u0dad\u0dca\u0dad\u0da7\u0dd9 \u0dd4\u0db4 \u0dbd\u0dca\u0db4\u0db1\u0db1 \u0dbb\u0db1\u0dca\u0daf\u200d\u0db1\u0dca\u0daf \"\u200d\u0db4\u0db1\u200d\u0dca\u0db1 \u0dad\u0dca \u0dbb\u0da7\u0d9a\u0dca\u0dc2 - \u0d9a \u0dc0 \u0db1 \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dba\u0d9a\u0dca\u0dc2\" \u0dba\u0da7\u200d\u0dad\u0dca \u0d9c\u0dc0 \u0db8\u0dca\u0dd6\u0dbb\u0d9c\u0dab \u0dbb\u0da7\u0d9a\u0dca\u0dc2 \u200d\u0d9c\u0db1\u0da9 \u0db1\u0d9c\u0db1\u0dca\u0daf\u0db1\u0dd2; \u0db8\u0dd2\u0daf\u0dc4\u0dc3\u0dd4\u0db1\u0dca\u0daf\u0da7 \u0dad\u0dd4\u0dd2\u0db1\u0dca\u0daf \u0da2\u0dd3\u0dc0\u0dad\u0dca \u200d\u0dc0\u0db1\u0dca\u0daf\u0db1 \u0dbb \u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0daf \u0dd9\u0db1\u0da2\u0dcf\u0dba\u0d9a\u0dca\u0dc2 \u200d\u0d9c\u0db1\u0da9 \u0db1\u0d9c\u0db1\u0dca\u0daf\u0db1\u0dd2. \u0dd4\u0db4\u0dd2 \u200d\u0db8\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dbb \u0dad\u0dd2\u0dbd\u200d\u0db6\u0db1\u0dca\u0daf\u200d\u0db1\u0dca\u0daf \u0dd4\u200d\u0db4\u0dca \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0d9c\u0dd9\u0db1\u0dca\u0daf \u0dbb\u0db1 \u200d\u0dc3\u0dc0\u0dd0\u0daf\u0dc4 \u0dc0 \u0dbb\u0da7 \u0dd4\u0dc3\u0db1\u0dd9 \u0dd4\u0dba \u0dc0\u0dd0\u0dba\u0dd2. \u0dca\u0dd0\u0db6\u0dd0\u0dd2, \u0dc0 \u0dbb\u0d9a\u0dca\u0dc2 \u0d87\u0dad\u0dd4\u0dd9\u0dad \u200d\u0dca\u0ddd \u200d\u0dc3\u0dc0\u0db1 \u0dc0 \u0dbb \u0d87\u0dad\u0dd4\u0dd9\u0dad \u0da2\u0dcf\u0db1\u0dad\u0dd2\u0dbd \u0da2\u0dcf\u0db1 \u0db6\u0d9a\u200d\u0dda\u0d9c\u0dba \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dd4\u0db4 \u0db6\u0d9a\u0db1\u200d\u0db4\u0db1\u200d\u0dbb\u0db1\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0db1 \u0d9c\u0dc0 \u0db8\u0dca\u0dd6\u0dbb\u0d9c\u0dab \u0dbb\u0da7 \u200d\u0d9c\u0db1\u0da9\u0db1\u0d9c\u0db1\u0dca\u0daf\u0db1 \u0db6\u0dd0\u0dca\u0dd0. \u0d87\u0dd2? \u0d92 \u0da7 \u0db4\u0dca\u200d\u0dbb\u0db0\u0db1\u0db1 \u200d\u0dca\u0dc0\u0dad\u0dd4\u0dc0 \u200d\u0dd9\u0db1 \u0d9a\u0dca\u0dc2\u0dc3? \u0dc0 \u0dbb 76\u0d9a\u0dca\u0dc2 \u0dad\u0dd2\u0dbd \u0dc0\u200d \u0dc0 \u200d\u0db8\u0dca\u200d\u0d9c\u0db1\u0dbd\u0dca\u0d9a\u0db1\u0dca\u0daf \u200d\u0db8\u0dca \u0dbb\u0da7 \u0db8\u0dc0\u0db1. \u0db8\u0dc0\u0db1 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca\u0dc2 \u200d\u0db1\u0db1\u200d\u0dc0\u0dd2, \u0dc3\u0dd9\u0db1 \u0db8\u0dc0\u0db1. \u0d91\u0dc3\u0db1 \u0dbb\u0da7 \u200d \u0db1\u0dad\u0dd0\u0db1\u0dc3 \u0dad\u0dd2\u0dbd\u0db6\u0dd4\u200d\u0da9\u0dd4\u0d9a? \u200d\u0db8\u0dca \u0dbb\u200d\u0da7\u0dca \u0db8\u0dd2\u0daf\u0dc4 \u0dc0 \u0dd9\u0db1\u0da2\u0dcf\u0dba \u0df2\u0dbb\u0dad\u0dca\u0dc0\u200d\u0d86 \u0dc3\u0dd2\u0da7 \u0dd4\u0dad\u0dd2\u0dbd \u0df2\u0dbb\u0dad\u0dca\u0dc0\u0dba \u0dc3\u0d9a\u0dca\u0dc2\u0dc0\u0db1 \u0d9c\u0dd9\u0db1\u0dca\u0daf \u0dbb\u0db8\u0dd2\u0db1\u0dca\u0daf \u0dad\u0dd2\u0dbd\u0db6\u0dd4\u200d\u0da9\u0dd4\u0d9a. \u0db1\u0dbb\u0dd4\u0dd9\u0dc0\u0db1\u0dc3\u200d\u0d86 \u0dc3\u0dd2\u0da7 \u0dd4\u0dad\u0dd2\u0dbd\u0db1\u0dbb\u0dd4\u0dd9\u0dc0\u0db1\u0dc3\u0dba \u0dc3\u0d9a\u0dca\u0dc2\u0dc0\u0db1 \u0d9c\u0dd9\u0db1\u0dca\u0daf \u0dbb\u0db8\u0dd2\u0db1\u0dca\u0daf \u0dad\u0dd2\u0dbd\u0db6\u0dd4\u200d\u0da9\u0dd4\u0d9a. \u0db8\u0dca\u200d\u0dbd\u0dca\u0da0\u0dca\u0da1\u0dad\u0dca\u0dc0\u200d\u0d86 \u0dc3\u0dd2\u0da7 \u0dd4\u0dad\u0dd2\u0dbd\u0db8\u0dca\u200d\u0dbd\u0dca\u0da0\u0dca\u0da1\u0dad\u0dca\u0dc0\u0dba \u0dc3\u0d9a\u0dca\u0dc2\u0dc0\u0db1 \u0d9c\u0dd9\u0db1\u0dca\u0daf \u0dbb\u0db8\u0dd2\u0db1\u0dca\u0daf \u0dad\u0dd2\u0dbd\u0db6\u0dd4\u200d\u0da9\u0dd4\u0d9a. \u0d91\u0dc3\u0db1 \u200d\u0db8\u0dca \u0dbb\u200d\u0da7\u0dca \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2\u0dbd \u0dc0\u0da7\u0dca\u0da7\u0d9a\u0db1 \u0dad\u0dd2\u0dbd\u0db6\u0dd4\u200d\u0da9\u0dd4\u0d9a. \u0dca\u0d9c\u0dd2 \u0dba \u0db6\u0dcf\u200d \u0db1\u200d\u0d9a\u0db1\u0dad\u0dca \u0dbb\u0d9a\u0db1 \u0dad\u0dd2\u0dbd\u0db6\u0dd4\u200d\u0da9\u0dd4\u0d9a. \u200d\u0db8\u0dca \u0dbb\u0da7 \u0dd4\u0dd4\u0daf \u200d \u0db1\u200d\u0dca\u0db1\u0db1\u0d9a\u0dca\u0dc2 \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0dbb\u0d9a\u0db1 \u0dad\u0dd2\u0dbd\u0db6\u0dd4\u200d\u0da9\u0dd4\u0d9a. \u0d91\u200d\u0dca\u0dda \u0dbb\u0da7\u0dd2 \u0dd4\u0db4\u0dd2 \u0db1\u0dbb \u0d9c\u0dad\u0dca\u200d\u0dad\u0dca. \u0dd4\u0db4 \u0dbb\u0da7 \u0db1\u0dbb\u0d9c\u0dad\u0dca \u0db4\u0dc3\u0dd4 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dd9 \u200d\u0dc3\u0dc0\u0dd0\u0daf\u0dc4 \u0dd4\u0dba \u0dc0\u0dd0\u0dba\u0dd2, \u200d\u0db8\u0dca. \u0da2\u0dcf\u0dba\u0d9c\u0dca\u200d\u0dbb\u0db1\u0dc4\u0dd3 \u0dc0 \u0dbb\u0d9a\u0dd2\u0db1\u0dca\u0daf \u0db4\u0dc3\u0dd4\u0dc0 \u0dd4\u0db4 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dbb\u0db1 \u0dd4\u0dba \u0dc0\u0dd0\u0dba\u0dd2, \u200d\u0db8\u0dca.\n\n\u0d92 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca\u0dc2 \u200d\u0db1\u0db1\u200d\u0dc0\u0dd2, \u0dc0\u0d9c\u0dad\u0dd9\u0db1\u0db1 \u0dbb\u0da2\u0dcf\u0dba \u200d\u0d9c\u0db1 \u0dba\u0db1 \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u200d\u0dc0\u0dd9 \u0da2\u0dcf\u0db1\u0dad\u0dba\u0db1\u0dca\u0daf\u0dad\u0dbb\u0dba \u0dca\u0dd4\u0daf\u200d\u0dda, \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u200d\u200d\u0dbb\u0dc0\u0dab\u0dd2\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dd4\u0dad\u200d\u0d9c, \u0dbb\u0db1\u0da2\u0dcf\u0dba \u0dad\u0db1\u0db1\u0dca\u0daf\u0dad\u0dca\u200d\u0dbb\u0dd2 \u0dd9\u0da7\u0dca\u0da7\u200d\u0db8\u0dca, \u200d\u0d9a\u0ddd \u0db6\u0dd0\u0dcf\u0dc0\u0dda\u0dc0 \u0dad\u0dd4\u0dd9 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0dcf \u0db1\u0dc0\u0da7 \u0d9a\u0d9a\u0dca\u0dc2 \u200d\u0dc0\u0d9a\u0db1 \u0dad\u0dd2\u0dbd\u200d\u0db6\u0db1\u0dc0\u0db1. \u0dd4\u0dc3 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dc2\u0dba\u200d\u0d86 \u0dd4\u0dba\u200d\u0dda \u0d87 \u0dc0\u0dc0\u0d9a\u0da7 \u0da7\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca\u0daf \u0dd4\u0daf\u0dc4\u0db1\u0dc0\u0db1 \u0dc0\u0db1\u200d\u0dda, \u200d\u0db4\u0db1\u0dbd\u0dca \u0db4\u0dbb\u0db1\u0d9a\u0dc0\u0dbd\u0dd2\u0db1\u0dca\u0daf \u0dd4\u0daf\u0dc4\u0db1\u0dc0\u0db1 \u0dc0\u0db1\u200d\u0dda \u200d\u0db8\u0dca \u0dd4\u0dba \u0dc0\u0dd0\u0dba \u0dc3\u0dd0\u200d\u0db1\u0db1\u0dca\u0daf\u200d\u0db1\u0dca\u0daf \u0d92 \u0daf\u0dc4 \u0db1\u0dd2."
