    "chunk_text": "\u0db4\u0dca\u200d\u0dbb \u0dd8\u0db8\u0d9a\u0dad\u0dd2 \u0db4 \u0d9a \u0dcf\u0db8 \u0dca\u200d\u0dbb\u0dc3\u0dca\u200d \u0dc0\u0dd2\u0db8 \u0dbb\u0dca\u0dbd\u0dba\u0db1 \u0d92\u0d9a\u0d9a\u0db8\u0dba\u0db1\u0dca\u0dad \u0d9a\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0d9a\u0d9a\u0db3 \u0dbd\u0dcf \u0db4\u0d9a\u0dba \u0dd2\u0dab\u0db1\u0dca\u0dad \u0dad\u0dd2\u0dba\u0dcf\u0db8\u0dd2\u0db1 \u0d89\u0db3\u0dbd\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1 \u0d9a\u0dbb\u0db1 \u0dcf3 \u0db8\u0dda \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0db4\u0dca\u200d\u0dbb \u0dd8\u0db8\u0d9a\u0dad\u0dd2 \u0db4 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0dc3\u0dba\u0dd2, \u0db4\u0dbd\u0dc3\u0dca\u0dd3\u0dbb\u0db1\u0dba \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0db8\u0dba\u0db1\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb \u0dd8\u0db8\u0d9a\u0dad\u0dd2 \u0db4 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0db8\u0db8 \u0dcf\u0d9a\u0dca\u0daf \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0dc0\u0dd4 \u0db8 \u0db1\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0daf\u0dd2\u0d9c\u0dd2\u0db1\u0dca\u0dad \u0daf\u0dd2\u0dd2\u0da7\u0db8 \u0d9a\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0da7 \u0dba\u0dda\u0d9a\u0dd2\u0dc3\u0dd2 \u0dcf\u0d9a\u0dcf\u0dbb\u0db8\u0dda \u0db4\u0dd3\u0da9\u0db1\u0dba\u0dca \u0d9a\u0dbd\u0dca\u0dad\u0dbd \u0d9a\u0dbb\u0db1 \u0dcf3\n\n\u0db8 \u0db8 \u0daf\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db1\u0d9a\u0dc4\u0d9a, \u0d9a\u0db6\u0dd4\u0db8 \u0dcf \u0db8\u0dda \u0db4\u0dd2 \u0d9a\u0db6\u0db3 \u0daf\u0d9a\u0db1\u0dd4 \u0db8\u0d9a \u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf3 \u0d9a\u0db6\u0dd4\u0db8 \u0dcf \u0db8\u0dda \u0db4\u0dd2 \u0d9a\u0db6\u0db3 \u0daf\u0d9a\u0db1\u0dd4 \u0db8\u0d9a \u0db1\u0dda \u0d92 \u0db4\u0dd2 \u0d9a\u0db6\u0db3 \u0dd2\u0db1\u0dca\u0dad\u0db1\u0dcf \u0dc0 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8 \u0dcf\u0dbb\u0dca\u0dbd\u0dd2 \u0dd2\u0d9a\u0db1 \u0db8\u0db4\u0dcf\u0da9\u0dca\u0da9\u0dca \u0db4\u0d9a\u0dc4\u0d9a\u0daf\u0dd2\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db13\n\n\u0d9c\u0dd4 \u0db8\u0dd4\u0da2\u0dd2\u0db6\u0dd4\u0dbb\u0dca \u0dbb\u0dc4\u0dd4\u0dd9\u0dcf\u0db1\u0dca \u0dd9\u0dc4\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0bae\u0bc1\u0b9c\u0bbf\u0baa\u0bc1\u0bb0\u0bcd \u0bb9\u0bc1\u0bc8\u0bc6\u0bbe\u0ba9\u0bcd) (The Hon. Mujibur Rahuman) \u0dd2\u0dd4\u0dc0 \u0d9a\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0db8 \u0db1\u0dd2, \u0db8 \u0db8\u0dda \u0db8\u0daf \u0d9a\u0db1\u0dd2 \u0d85\u0dd4\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba \u0d89\u0daf\u0dd2\u0d9a \u0db4\u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0db1\u0dca\u0dad \u0db8\u0dda \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d85 \u0dba\u0dba\u0dba\u0dd23 \u0db8\u0db8 \u0dcf\u0d9a\u0daf, \u0dd2\u0dd4\u0dc0 \u0dc3\u0db8 \u0dad\u0dd2\u0dd4\u0db8 \u0dcf \u0d9a\u0dd2\u0dda \u0dcf, \u0db1\u0dd2\u0dba\u0dca\u0da0\u0dd2\u200d \u0d9a\u0dd4\u0dc0\u0dab\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf3 \u0db4\u0dbd\u0dc3\u0dca\u0dd3\u0dbb\u0db1 \u200d\u0dcf\u0db1\u0dcf\u0db4\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dcf\u0dbd\u0db8\u0dda \u0db8 \u0dcf\u0db0\u0dba \u0d85\u0d82\u0dba\u0db8\u0dda \u0d9a\u0da9 \u0d9a\u0dbb\u0db1 \u0d92 \u200d\u0dd4\u0dc0\u0dab\u0dba\u0dcf \u0db8\u0dd2\u0daf\u0dbb \u0d9c\u0dd2\u0dba\u0dcf\u0db8 \u0d9a\u0dd4\u0dc0\u0db8\u0dda \u0db4\u0dca\u200d\u0dbb\u0db8\u0daf\u0dca\u0dba\u0db8\u0dda \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0db8\u0db4 \u0dcf\u0dbd\u0dd3\u0dc3\u0dd2\u0dba\u0da7 \u0d9a\u0dd3\u0db4 \u200d\u0dcf \u0dca\u0db8 \u0d9a\u0d9a\u0db3 \u0dbd\u0dcf \u0d9a\u0dd4\u0dc0\u0db8\u0dd2\u0db1\u0dca\u0dad \u0d8d\u0da2\u0dd4 \u0db8 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1 \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0dcf, \u0dc3\u0dba\u0dd2, \u0dc3\u0db8 \u0dcf \u0db8 \u0dcf\u0db0\u0dba \u0dbd \u0db4\u0dbd\u0dc3\u0dca\u0dd3\u0dbb\u0db1\u0dba \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0 \u0db4\u0dca\u200d\u0dbb\u0da0 \u0dcf\u0dbb\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0dbd\u0dcf3 \u0d9a\u0dd4\u0dc0 \u200d\u0dcf\u0db1\u0dcf\u0db4\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dcf\u0dbd\u0db8\u0dda \u0db8 \u0dcf\u0db0\u0dba \u0d85\u0d82\u0dba\u0db8\u0dda \u0d9a\u0da9 \u0d9a\u0dbb\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0dd2\u0dba\u0dcf3 \u0dd2\u0dd4\u0dc0 \u0dc3\u0db8 \u0dad\u0dd2\u0dd4\u0db8 \u0db1\u0dd2, \u0d9a\u0db6\u0dd4\u0db8 \u0dcf \u0db1\u0dd2\u0dba\u0dca\u0da0\u0dd2\u200d \u0dba\u0db8\u0dba\u0db1\u0dca\u0dad \u0d9a\u0dd4\u0dc0\u0dab\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0dc4\u0dd2\u0db1\u0dca\u0dad\u0daf\u0dcf \u200d\u0db8 \u0dba\u0dd2 \u0db8 \u0db8 \u0d92 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0d9a\u0dd2\u0dda\u0db8\u0dda3 \u0d92 \u0db4\u0dca\u200d\u0dbb\u0db8\u0daf\u0dca\u0dba\u0db8\u0dda \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0db8\u0db4\u0dcf\u0dd2\u0dc3\u0dca \u0dc3\u0dca\u0dcf\u0dcf\u0db1\u0dba\u0da7 \u0d9a\u0dd4\u0dc0 \u0d9a\u0dd3\u0db4 \u200d\u0dcf \u0dca\u0db8 \u0d9a\u0d9a\u0db3 \u0dcf \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1 \u0d9a\u0dbb \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0dcf3 \u0db8 \u0db8 \u0db8\u0dd3\u0da7 \u0d9a\u0dd2\u0db1\u0dd4\u0db8\u0d9a \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dda \u0da2 \u0db8\u0dda \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0db8 \u0dd4 \u0d9a \u0dcf, \u0dd2\u0dd4\u0dc0 \u0dc3\u0db8 \u0dad\u0dd2\u0dd4\u0db8 \u0db1\u0dd23 \u0db8\u0dda\u0d9a \u0d9a\u0db6\u0dd4\u0db8 \u0dcf\u0db8\u0dda \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba\u0dca \u0db8\u0db1\u0dcf\u0db8 \u0dba\u0dd23 \u0d9a\u0dca\u0db8\u0d9a\u0db6, \u0db8\u0dda \u0dcf\u0dba\u200d\u0db1 \u0dbd \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0d9a \u0db1\u0dca\u0dad\u0db8\u0dda \u0dcf\u0d9a\u0dbd\u0dca\u0dad\u0db4 \u0db4\u0dd2 \u0d9a\u0db6\u0db3 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba\u0dca \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0dcf3\n\n\u0d9a\u0dca\u0db8\u0d9a\u0db6, \u0db8\u0dda\u0db8\u0dd2\u0dcf\u0dbd\u0dca\u0dad\u0dbd\u0db1\u0dca\u0dad \u0d8a\u200d\u0dbb\u0dcf\u0dba\u0dbd\u0db8\u0dba\u0db1\u0dca\u0dad \u0dc3\u0dbd\u0dca\u0dad\u0dd2 \u0dd2\u0db1\u0dca\u0dad\u0db1 \u0dcf3 \u0d9a\u0dca\u0db8\u0d9a\u0db6, \u0db8\u0db8 \u0dcf\u0dc3\u0dcf\u0da9\u0dca \u0d9a\u0d9a \u0dc3\u0dbd\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0dba\u0daf\u0dda \u0d9a\u0dbb\u0db1 \u0dcf, \u0db8\u0dda \u0dcf\u0dbb\u0dca\u0dc2\u0d9a \u0d85\u0d82\u0dba \u0dbd \u0d89\u0db1\u0dca\u0dad\u0db1 \u0dc3\u0db8 \u0dc4\u0dbb \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0d9a \u0db1\u0dca\u0dad\u0da73 \u0d9a\u0db6\u0dd4\u0db8 \u0db1\u0dca\u0dad\u0dbd\u0dcf \u0daf\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad\u0db8\u0d9a \u0db1\u0d9a\u0dd4 \u0dc3\u0dad\u0dd23 \u0d92\u0d9a\u0dba\u0dd2 \u0db8 \u0db8 \u0db8\u0dda \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad3 \u0db8\u0dda \u0dd2\u0d9a\u0db1 \u0db6\u0dbd\u0db1\u0dca\u0dad\u0db1, \u0dc3\u0dba\u0dd2, \u0d92 \u0d85\u0dba \u0db4\u0dbd\u0dc3\u0dca\u0dd3\u0dbb\u0db1\u0dba \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0 \u0d9a\u0da9 \u0d9a\u0dbb\u0db1\u0db8\u0d9a\u0dcf\u0da7 \u0db8\u0dda \u0dcf\u0dbb\u0dca\u0dc2\u0d9a \u0d85\u0d82\u0dba\u0db8\u0dda \u0d85\u0dba \u0d9a\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0d9a \u0dcf\u0db8\u0dd2\u0db1 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dad\u0dbd\u0dcf \u0d92\u0d9a \u0db1 \u0db8\u0d9a \u0db1\u0dca\u0dad\u0db1 \u0db8 \u0dcf\u0db1\u0dc3\u0dd2\u0d9a \u0db4\u0dd3\u0da9\u0db1\u0dba\u0dca \u0d9a\u0dbd\u0dca\u0dad\u0dbd \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0d9a3 \u0db8\u0db8 \u0dcf\u0d9a\u0daf, \u0dc4\u0d9a\u0db8 \u0d9a\u0dca\u0db8\u0d9a\u0db1\u0dcf \u0db8 \u0d9a\u0d9a\u0db3 \u0db1 \u0dcf3 \u0d92\u0d9a\u0dba\u0dd2 \u0db8 \u0db8 \u0db8\u0dda \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad3 \u0d9a\u0db6\u0dd4\u0db8 \u0dcf \u0d85\u0dc4\u0db4\u0dd4 \u0db1\u0dd2\u0dba\u0dca\u0da0\u0dd2\u200d \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0dd2\u0d9a\u0db1\u0dba\u0dd2 \u0db8 \u0db8 \u0db8\u0dda \u0d9a\u0dd2\u0dda\u0db8\u0dda3"
