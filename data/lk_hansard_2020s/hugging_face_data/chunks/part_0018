    "chunk_text": "\u0dc0\u0d9c\u0dcf\u0d9a\u0db1\u0dd0\u0d9f\u0dd2\u0dd2 0 922\u0d9a\u0dca. \u0db8\u0dcf\u0dad\u0dba \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf \u0dc3\u0dcf\u0dc3\u0dae \u0dad\u0dad\u0dd2 \u0db8\u0db0\u0dba\u0dc3\u0dae\u0dcf\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0dc3\u0dcf\u0dbb\u0dca\u0dbd\u0d9a\u0dca \u0dc3\u0dcf\u0dc3\u0dae \u0dad\u0dad\u0dd2 \u0db8\u0db0\u0dba\u0dc3\u0dae\u0dcf\u0dcf\u0db1\u0dba \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db8\u0dcf\u0dad\u0dbb\u0dd2\u0db1\u0dca \u0dc3\u0dcf\u0dc3\u0dae \u0dad\u0dad\u0dd2 \u0d87\u0db8\u0dad\u0dd2\u0dd9\u0dba\u0dba\u0dcf \u0dca\u0dd9\u0dcf. \u0d89\u0dad\u0dd2\u0db1\u0dca \u0dc0\u0db8\u0dcf \u0daf \u0dc0\u0dc5\u0dae \u0d9a\u0dc4\u0dd4? \u0dc3\u0dcf\u0dbb\u0dca\u0dbd\u0d9a\u0dca \u0dc3\u0dcf\u0dc3\u0dae \u0dad\u0dad\u0dd2 \u0db8\u0db0\u0dba\u0dc3\u0dae\u0dcf\u0dcf\u0db1\u0dba \u0db8\u0dcf\u0dad\u0dba \u0dc4\u0dd0\u0db1\u0dca\u0dd9\u0dcf. \u0d91\u0dba\u0da7 \u0db8\u0dd2\u0dd2\u0dba\u0db1 22\u0d9a\u0dca \u0dd9\u0dd0\u0dba \u0dba \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. \u0d82\u0daf \u0d91\u0dba \u0db7\u0dcf\u0dba\u0d9c\u0db1\u0dca\u0db1 \u0dc0 \u0dc0\u0db1\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db7\u0dcf\u0dc0\u0d9c\u0da7 \u0dc4\u0daf\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. \u0dbb\u0dd4\u0dc4\u0dd4\u0dd4 \u0dd2\u0dc3\u0dc1\u0dae\u0dd9\u0dd2\u0dc3\u0daf\u0dba\u0dcf\u0dbd\u0dba\u0da7 \u0dcf\u0dcf \u0dc5\u0dcf \u0dc0\u0dda \u0dc0\u0d9c\u0dcf\u0d9a\u0db1\u0dd0\u0d9f\u0dd2\u0db8\u0dbd \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dd9\u0db1\u0dca\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dbb\u0dd4\u0dc4\u0dd4\u0dd4 \u0dd2\u0dc3\u0dc1\u0dae\u0dd9\u0dd2\u0dc3\u0daf\u0dba\u0dcf\u0dbd\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dd9\u0dcf \u0d82\u0dba\u0dc0\u0d9c\u0db1 \u0dc0\u0d9c\u0dcf\u0db8\u0dbd\u0db1\u0dca\u0da7 \u0db1\u0d9a\u0dad\u0dca\u0dad\u0dd4 \u0dba\u0db1\u0dca\u0db1 \u0dd9\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db7\u0dcf\u0dc0\u0d9c\u0da7 \u0dc4\u0daf\u0db4\u0dd4 \u0dd2\u0dc3\u0dc1\u0dcf\u0dbd \u0dc3\u0dcf\u0d9a\u0dd3\u0dbb\u0dca\u0dbd\u0dab\u0dba\u0d9a\u0dca. \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0d9a\u0dcf \u0d82\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dcf\u0dc1\u0dba\u0da7 \u0dcf\u0dcf \u0dc5\u0dcf \u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc0\u0db4\u0dde\u0dda\u0d9c\u0dd2 \u0dd2\u0dc3\u0dc1\u0dae\u0dd9\u0dd2\u0dc3\u0daf\u0dba\u0dcf\u0dbd\u0dba \u0da7 \u0dcf\u0dcf \u0dc5\u0dcf \u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0dd2\u0dd2\u0dba\u0db1 22\u0d9a\u0dca \u0dd9\u0dd0\u0dba \u0dba\u0dbd\u0dcf \u0d9a\u0dd2\u0dd2\u0db1\u0db1\u0dca \u0dc1 \u0dba\u0dad\u0dcf \u0d82\u0db0\u0dba\u0dba\u0db1\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dad\u0dcf\u0dba\u0dd9. \u0dc3\u0dcf\u0dc3\u0dae \u0dad\u0dad\u0dd2 \u0d87\u0db8\u0dad\u0dd2 \u0db8\u0dcf\u0dad\u0dbb\u0dd2\u0db1\u0dca \u0d91\u0db1\u0dc0 \u0dcf\u0da7 \u0db8\u0dcf\u0dad\u0dba \u0dc4\u0daf\u0db1\u0dd9\u0dcf \u0dc3\u0dcf\u0dbb\u0dca\u0dbd\u0d9a\u0dca \u0dc3\u0dcf\u0dc3\u0dae \u0dad\u0dad\u0dd2 \u0db8\u0db0\u0dba\u0dc3\u0dae\u0dcf\u0dcf\u0db1\u0dba\u0d9a\u0dca. \u0db8\u0dd2\u0dd2\u0dba\u0db1 22\u0d9a\u0dca \u0dd9\u0dad\u0dd4\u0dc0\u0dbb\u0dca\u0dbd \u0dd2\u0dba\u0dba\u0dcf. \u0dd9\u0dcf\u0dc0\u0dda\u0db8 \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf \u0d82\u0db1\u0dd4\u0dba\u0dcf\u0db0\u0db4\u0dd4\u0dba\u0dc0\u0d86 \u0dc3\u0dda\u0db8\u0db1\u0dca\u200d\u0dbb\u0dab \u0dc1\u0dcf\u0dbd\u0dcf\u0dd9\u0d9a\u0dca \u200d\u0dbb\u0dcf\u0dc1 \u0dca\u0db0\u0dcf\u0dba\u0dd9\u0dd2\u0db1\u0dca\n\n\u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dc3\u0d9c\u0dbd \u0db1\u0dcf\u0d9c\u0dbb\u0dd2 \u0db8\u0db1\u0dca\u0dd3\u0dd9\u0dbb\u0dd4 \u0db8\u0da7 \u0d9a\u0dd2 \u0dd9\u0dcf \u0db1\u0d9c\u0dba \u0dc3\u0db7\u0dcf\u0dd9 \u0db1\u0d9a\u0dad\u0dca\u0dad\u0dd4 \u0dba\u0db1\u0dca\u0db1 \u0dd9\u0dd0\u0dc4\u0dd0 -\u0dd2\u0dc3\u0dc1\u0dcf\u0dbd \u0db1\u0d9c\u0dba \u0dc3\u0db7\u0dcf\u0dd9\u0d9a\u0dca \u0dc4\u0daf\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf- \u0db8\u0db0\u0dba\u0db8 \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dc0\u0dd9\u0db1\u0dca \u0dc3\u0db8\u0dd2 \u0dc0\u0daf\u0db1\u0dca\u0db1 \u0dd9\u0dd0\u0dbb\u0dd2\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d91\u0dad\u0dd0\u0db1\u0da7 \u0d9c\u0dd0\u0dc5\u0dc0\u0db4\u0db1 \u0dc1\u0dcf\u0dbd\u0dcf\u0dd9\u0d9a\u0dca \u0dc4\u0daf\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dc3. \u0dc0\u0db8\u0dcf \u0d9a\u0dca\u0daf \u0dc0\u0dc5\u0dae? \u0dc4\u0d9a\u0dca\u0db8\u0db1 \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf \u200d\u0dbb\u0dcf\u0dc0\u0dda\u0dd3\u0dba\u0dba \u0dc0\u0db8 \u0dda \u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dd0\u0dc0\u0db8\u0da7 \u0dd2\u0dba\u0dc4\u0dd2\u0db8\u0dbd\u0dcf. \u0dc0\u0daf\u0db1\u0dd2\u0dba\u0dcf\u0dc0\u0d86 \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf \u0dc0\u0dba\u0dcf\u0dc0\u0dd4\u0db1\u0dca \u0dc0\u0dc3\u0dae\u0db1\u0dcf\u0dcf \u0dba\u0d9a\u0dca. \u0dc0\u0dba\u0dcf\u0dc0\u0dd4\u0db1\u0dca \u0dc0\u0dc3\u0dae\u0db1\u0dcf\u0dcf \u0dba\u0d9a\u0dca \u0dc0\u0daf\u0db1\u0dd2\u0dba\u0dcf\u0dba\u0da7 \u0dd2\u0dba\u0dc0\u0d86 \u0dc0 \u0dcf\u0dc0\u0dc4\u0dcf\u0db8\u0daf? \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0dc0\u0dc3\u0dae\u0dbd\u0dcf \u0daf\u0db1\u0dca\u0db1\u0dd9\u0dcf \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dba. \u0dd9\u0dcf \u0dd0\u0dbd\u0dc3\u0dd9\u0da7 \u0dd2\u0dba\u0dc4\u0dd2\u0db8\u0dbd\u0dcf \u0db7\u0dcf\u0dba\u0d9c\u0db1\u0dca\u0db1 \u0dc0 \u0dc0\u0db1\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc0\u0dda \u0dd2\u0dc3\u0db0\u0dd2\u0dba\u0da7 \u0dc4\u0daf\u0db4\u0dd4 \u0dc0\u0d9c\u0dcf\u0d9a\u0db1\u0dd0\u0d9f\u0dd2\u0dd2 0 922\u0d9a\u0dca \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. \u0db8\u0dc4\u0da2\u0db1\u0dba\u0dcf\u0dc0\u0dda \u0db0\u0db1\u0dba \u0db1\u0dd0\u0dad\u0dd2 \u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dca\u0dc0\u0db1\u0dca. \u0d82\u0dd2\u0dc5 \u0dc0\u0dda\u0dd9\u0dcf \u0dd2\u0dc5\u0dd2\u0db6\u0dd9\u0db3 \u0d9a\u0d9a\u0dca\u0dc0 \u0dcf\u0db8 \u0dc0\u0dad\u0dcf\u0dba\u0dad\u0dd4\u0dbb\u0dd4 \u0dc0\u0dc3\u0dcf\u0dba\u0dcf\u0dc0\u0d9c\u0db1 \u0db1\u0dd2\u0dd2\u0db1 \u0d87\u0d9c\u0dba\u0dd3\u0db8\u0d9a\u0dca \u0dba\u0dbd\u0dcf \u0dc0\u0db4\u0dde\u0dda\u0d9c\u0dd2 \u0d82\u0dcf\u0dc1\u0dba\u0da7 \u0dc0\u0daf\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dc3 \u0dad\u0dd0\u0db1\u0dca \u0dd9\u0dcf\u0da7 \u0da2\u0dbd\u0dcf \u0dc0\u0d9c\u0dcf\u0d9a\u0db1\u0d9f\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dd9\u0db1\u0dca \u0dad\u0dd0\u0db1\u0dca \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf \u0db1\u0dda \u0dc3\u0dae\u0dc0 \u0da0\u0dca\u0da1\u0dcf \u0db8\u0db0\u0dba\u0dc3\u0dae\u0dcf\u0dcf\u0db1\u0dd9\u0dbd\u0da7 \u0dc0\u0dc4\u0db6 \u0da2\u0dbd\u0dcf \u0dc0\u0dda \u0dd9\u0dbb\u0dd2\u0db1\u0dca \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dd9 \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dae \u0dc0\u0dd9\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dc3.\n\n\u0d82\u0db1\u0dd4\u0dd9 \u0d82\u0dad\u0dd3\u0dad\u0dc0\u0d86 \u0db1\u0dd2\u0dd2\u0db1 \u0dc1 \u0dba\u0dad\u0dcf \u0d82\u0db0\u0dba\u0dba\u0db1\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dad\u0dcf\u0dba\u0dd9 \u0d82\u0db0\u0dd2 \u0dd9\u0dd0\u0dba \u0dd9\u0dba\u0d9a\u0dca \u0daf\u0dba\u0dcf \u0d89\u0daf\u0dd2 \u0dba \u0d87\u0dad\u0dd2 \u0dc0\u0db8\u0db8 \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0dda \u0dd9\u0dbb\u0dca\u0dbd\u0dad\u0db8\u0dcf\u0db1\u0dc0\u0d86 \u0dd2\u0dc3\u0db1\u0dcf\u0dc1 \u0dd3 \u0dba\u0dcf\u0db8\u0da7 \u0dc0\u0db1\u0dcf \u0da2 \u200d\u0dbb\u0dc1\u0dc3\u0dae\u0dad \u0dc0\u0dbd\u0dc3 \u0db7\u0dcf\u0dd2\u0dc3\u0dad\u0dba\u0da7 \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dad\u0dd4\u0dd2\u0db6\u0db1\u0dca \u0dc0\u0db8\u0db8 \u0dca\u0dc0\u0dba\u0db6\u0da2\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0da7\u0dd2\u0db1\u0dcf \u0db8\u0d9a\u0dca \u0dbd\u0dd9\u0dcf \u0dc0\u0daf\u0db1\u0dca\u0db1\u0da7 \u0d82\u0dd2\u0dc5 \u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0dba\u0db1\u0dd9\u0dcf.\n\n29. \u0dc3\u0dd0\u0db4\u0dba\u0dd4\u0dda \u0daf\u0dcf\u0db8 \u0dc3\u0dcf\u0dc0\u0dbb\u0dca\u0dbd\u0dca\u200d\u0db1\u0dba\n\n29.1 \u0dc0\u0dbb\u0dcf\u0dba \u0dd4\u0dc5 \u0db6\u0dad\u0dbd\u0dd4\u0dda \u0db8\u0db8\u0db8\u0dad\u0dba\u0dd4\u0dda \u0dc0\u0dd0\u0dd2\u0da2\u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dad\u0dcf \u0dba\u0da7\u0dd2\u0dcf\u0dbd \u0db4\u0dad\u0dc5\u0dd4\u0d9a\u0dda \u0dc0\u0dd0\u0dd2\u0da2\u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8"
