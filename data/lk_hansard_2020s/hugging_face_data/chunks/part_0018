    "chunk_text": "(\u0d86) (i) \u0db4\u0dd6\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dca\u200d \u0dda\u0dbb \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d\u0db4\u0dd4\u0dbb\u0dba \u0d89\u0da9 \u0dd4\u0d82\u0dbd\u0dd2 66\u0dd2\u0dbb\u0da7 \u0dc3\u0db8\u0da7 \u0dc0\u0dd2\u0dca\u200d \u0db4\u0dca\u200d\u0dbb\u0dda. (ii) \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d \u0dc4\u0dd2\u0dd2\u0dba\u0da7 19\u0db4\u0dca\u200d\u0dbb\u0db1\u0db4\u0dca\u200d\u0dbb\u0db1\u0dd4\u0dad \u0dc3\u0dcf\u0dc4\u0dcf \u0db4\u0dca\u200d\u0dbb \u0dc0\u0db1\u0dc0\u0dd2\u0dbb \u0d89\u0da9 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dbb\u0dc3\u0dca 60\u0dda \u0dbd\u0dca\u200d\u0d82\u0dcf \u0daf\u0dd3 \u0d87\u0dad\u0dd2 \u0d85\u0dca\u200d\u0dbb \u0dca\u200d\u0dc0\u0dad\u0dca \u0d89\u0da9 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dbb\u0dc3\u0dca 13\u0dda \u0dc4\u0dd2\u0dc3\u0dca\u0dc0 \u0db4\u0dc0\u0dad\u0dd3. \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d \u0dc3\u0d9a\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1 \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0dca\u200d\u0db4\u0dca\u200d\u0dbb\u0dda \u0dbb\u0dd4\u0dad\u0dad\u0dd4\u0db8 \u0dc3\u0dcf\u0dc4\u0dcf \u0d89\u0da9 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dbb\u0dc3\u0dca 00\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc0\u0da7 \u0dbb \u0d87\u0dca\u200d. (iii) \u0db4\u0dca\u200d\u0dbb \u0dc0\u0db1\u0dc0\u0dd2\u0dbb \u0db4\u0dd6\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dca\u200d \u0dda\u0dbb \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d\u0db4\u0dd4\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dda \u0d89\u0da9 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dbb\u0dc3\u0dca \u0dbd\u0dca\u200d\u0d82\u0dcf \u0dbb\u0dd4\u0da7 \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d \u0dc4\u0dd2\u0dd2\u0dba\u0da7 03\u0db4\u0dca\u200d\u0dbb\u0db1\u0db4\u0dca\u200d\u0dbb\u0db1\u0dd4\u0dad \u0dc4\u0dd4\u0db4\u0dca\u200d\u0dbb\u0dbb\u0da7 \u0db1\u0dbb \u0d89\u0dad\u0dd4\u0db8\u0dbb\u0dd4 \u0dc3\u0dd2\u0dba\u0dc0\u0d9a \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d \u0dc4\u0dd2\u0dd2\u0dba\u0da7 \u0dc3\u0dcf\u0dbb\u0dca\u0dbd\u0dc3 \u0dc0 \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0db4\u0dca\u200d\u0dbb\u0d9c\u0db1 \u0dba\u0db1\u0dd4 \u0dbd\u0dca\u200d\u0d82\u0db1\u0dca. (iv) \u0db4\u0dd6\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dca\u200d \u0dda\u0dbb \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d\u0db4\u0dd4\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dda \u0d89\u0da9 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dbb\u0dc3\u0dca \u0dbd\u0dca\u200d\u0d82\u0dcf \u0dbb\u0dd4\u0da7 \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba \u0db1\u0dca\u0da7 \u0d85\u0dca\u200d\u0dba\u0dd0\u0da7 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0dbb\u0dd4\u0dad\u0dad\u0dd4\u0db8 \u0dc3\u0dd2\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf \u0dbb\u0db1 \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d \u0dc4\u0dd2\u0dd2\u0dba\u0da7 \u0dbb \u0d85\u0dba\u0dad\u0dca \u0d89\u0da9 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dbb\u0dc3\u0dca \u0d85\u0dc0\u0dbd\u0dca\u200d\u0d9a\u0d9c\u0dd4 \u0dbb \u0db1\u0dc0 \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba \u0db1\u0dca\u0da7 \u0dbb \u0dbd\u0dca\u200d\u0d82\u0dcf \u0daf\u0dd3\u0db4\u0dca\u200d\u0dbb \u0dc4\u0dd4\u0dd2\u0dbb\u0dba\u0dcf\u0dc0 \u0d87\u0dca\u200d. \u0d92 \u0dc3\u0dcf\u0dc4\u0dcf \u0d85\u0dc0 \u0dba \u0dbb\u0dd4\u0dad\u0dad\u0dd4\u0db8 \u0dc3\u0dd2\u0dbb\u0dd4 \u0dbb\u0dd2\u0da7 \u0db4\u0dc0\u0dad\u0dd3. (v) \u0db1\u0dd4\u0db1\u0dbb \u0dc4\u0dd2\u0dc3\u0dca\u0dc0 \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d89\u0da9 \u0dd4\u0d82\u0dbd\u0dd2 13 \u0db1\u0dc0 \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba \u0db1\u0dca\u0da7 \u0dbb \u0dbd\u0dca\u200d\u0d82\u0dcf \u0daf\u0dd3\u0db8 \u0dc3\u0dd2\u0dbb\u0dd4 \u0dc5 \u0dc4\u0dd4 . \u0dbb \u0d85\u0db8\u0dca\u200d\u0dbb\u0dc0 \u0db1\u0dd4\u0db1\u0dbb \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf \u0dbb\u0db1 \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d \u0dc4\u0dd2\u0dd2\u0dba\u0da7 \u0dd2\u0dbb\u0dc4\u0dd2\u0db4\u0db4\u0dca\u200d\u0dbb\u0db1\u0db4\u0dca\u200d\u0dbb\u0db1\u0dd4\u0dad\u0db4\u0dca\u200d\u0dbb \u0d89\u0da9 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dbb\u0dc3\u0dca \u0d85\u0dc0\u0dbd\u0dca\u200d\u0d9a\u0d9c\u0dd4 \u0dbb \u0db1\u0dc0 \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba \u0db1\u0dca\u0da7 \u0dbb \u0dbd\u0dca\u200d\u0d82\u0dcf \u0daf\u0dd3\u0db8\u0dbb \u0d85\u0dc0 \u0dba \u0dbb\u0dd4\u0dad\u0dad\u0dd4\u0db8 \u0dc3\u0dd2\u0dbb\u0dd4 \u0dbb\u0dd2\u0da7 \u0db4\u0dc0\u0dad\u0dd3. (vi) \u0db4\u0dd6\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dca\u200d \u0dda\u0dbb \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d\u0db4\u0dd4\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dda \u0d85\u0dc0\u0dc3\u0da7 \u0dc0\u0dbb\u0dbb \u0dc3\u0d9a\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1 \u0dc0\u0dd4\u0da9\u0dc3\u0dbb\u0dc4\u0db1 \u0dc3\u0dd2\u0dbb\u0dd4 \u0dbb\u0db1\u0dd4 \u0dbd\u0dca\u200d\u0dd4\u0db6\u0dd4\u0db4\u0dca\u200d\u0dbb\u0dda 0000 \u0dc4\u0dcf 0001 \u0dc0\u0dbb\u0dca\u0dbd\u0dc2 \u0dad\u0dd4\u0db8\u0dc5\u0daf\u0dd3\u0dba. \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d \u0dca\u200d\u0db1\u0db4\u0db1\u0db4\u0dca\u200d\u0dbb\u0dda \u0dd2\u0dba\u0dc2\u0dca\u0db4\u0dcf\u0db1\u0db1 \u0dbb\u0dd4\u0dad\u0dd4\u0dd4\u0dad\u0dd4\u0db8 \u0dc3\u0dcf\u0dc4\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dc0\u0dad\u0dca \u0dc0\u0dd2\u0dbb\u0dd4\u0dbd\u0dd2 \u0db0\u0dcf\u0dba\u0dd0\u0dca\u200d\u0dcf\u0dc0\u0dda \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db8\u0dd4\u0dad\u0dd2 \u0d9c\u0dd4\u0dbb\u0dc0\u0d9a\u0dc0\u0dbb \u0db4\u0dd2\u0dc5\u0dd2\u0dba\u0db8\u0dda \u0db4\u0dca\u200d\u0dbb\u0dbd\u0dca\u200d\u0dc3 0000 \u0dc0\u0dbb\u0dca\u0dbd\u0dc2\u0db4\u0dca\u200d\u0dbb\u0dda\u0daf\u0dd3 400KVA \u0db1\u0dc0 \u0dca\u200d\u0dcf\u0dbb\u0dcf\u0db4\u0dd4\u0dc0\u0dd2\u0dba\u0dda -transformer- \u0dd2\u0dbd\u0dd2\u0dba\u0db1 0.6 \u0dc0\u0dd2\u0dba\u0db1\u0db8\u0dda \u0db1\u0dbb\u0dcf \u0dc3\u0dc0\u0dd2 \u0dbb\u0db1 \u0dbd\u0dca\u200d\u0daf\u0dd3. \u0d91\u0db4\u0dca\u200d\u0dbb\u0dc3\u0dca\u0db8 0001 \u0dc0\u0dc3\u0dbb \u0dad\u0dd4\u0db8\u0dc5\u0daf\u0dd3 \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d\u0db4\u0dd4\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dda \u0db8\u0dcf\u0db1\u0dca \u0dc0\u0dd4\u0dbb \u0d89\u0dd2\u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0dd2\u0dbd\u0dd2\u0dba\u0db1 0.6 \u0dc0\u0dd2\u0dba\u0db1\u0db8\u0dd2\u0dbb\u0da7 \u0dc3\u0dd2\u0dbb\u0dd4 \u0dbb\u0db1 \u0dbd\u0dca\u200d\u0daf\u0dd3. (vii) \u0db4\u0dd6\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dca\u200d \u0dda\u0dbb \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d\u0db4\u0dd4\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dda \u0d8b\u0db4\u0dba\u0dd0\u0db8 \u0db0\u0dcf\u0dba\u0dd0\u0dca\u200d\u0dcf\u0db4\u0dca\u200d\u0dbb\u0dc0\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8 \u0dd2\u0dbb\u0dd3\u0db8\u0db8\u0dbb \u0d85\u0dc0 \u0dba \u0dbb\u0dd4\u0dad\u0dad\u0dd4\u0db8 \u0dc3\u0dd2\u0dbb\u0dd4 \u0dbb\u0dd2\u0da7 \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d85\u0dca\u200d\u0dbb \u0db1\u0dd4\u0db1\u0dbb \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0dc4\u0dd2\u0dc3\u0dca \u0db6\u0dd2 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dbb\u0dc3\u0dca \u0dd4\u0d82\u0dbd\u0dd2 13 \u0dc3\u0dcf\u0dc4\u0dcf \u0db1 \u0db1\u0dc0 \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d \u0dbb\u0dd4\u0dc0\u0da7 03\u0db4\u0dca\u200d\u0dbb\u0db1\u0db4\u0dca\u200d\u0dbb\u0db1\u0dd4\u0dad \u0d89\u0dbd\u0dc0\u0d9a \u0dbb \u0d87\u0dad\u0dd2 \u0d82\u0dd4\u0dc0\u0dd2\u0da7 \u0d94\u0dc0\u0dd4\u0da7 \u0dbb\u0db1 \u0dc4\u0dd2\u0dc3\u0dca \u0db6\u0dd2 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dbb\u0dc3\u0dca \u0db4\u0dc0\u0dbb\u0dcf \u0daf\u0dd3\u0db4\u0dca\u200d\u0dbb\u0db8\u0da7 \u0d85\u0db1\u0dad\u0dd4\u0db8\u0dbb\u0dd4\u0dc0 \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d\u0db4\u0dd4\u0dbb\u0dba \u0d8b\u0db4\u0dba\u0dd0\u0db8 \u0db0\u0dcf\u0dba\u0dd0\u0dca\u200d\u0dcf\u0dc0 \u0dbb\u0dcf \u0dc5\u0d9f\u0dcf \u0dc0\u0dd3\u0db8\u0dbb \u0dc4\u0dd4\u0dd2\u0dbb\u0dba\u0dcf\u0dc0 \u0db4\u0dc0\u0dad\u0dd3.\n\n(\u0d87) \u0d85\u0db1\u0dcf\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db4\u0dca\u200d\u0dbb\u0dda.\n\n\u0b85\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0b95\u0bc6\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bae\u0bb3\u0b95\u0bcd \u0ba4\u0b95\u0bc6\u0bbe\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0b9a\u0baf\u0bc6\u0bbe\u0bc6\u0ba9\u0bc8\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd. \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bc6\u0bbe\u0bbf\u0baf \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0bae\u0b95\u0b95\u0bae\u0bb3 \u0bb5\u0bbf\u0bae\u0bb0\u0bb5\u0bc6\u0bbe\u0b95\u0b9a\u0bcd \u0ba4\u0bc6\u0baf\u0bcd\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bc6\u0bbe\u0bbf\u0baf \u0b8f\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd \u0b8f\u0ba4\u0bc1\u0bae\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc6\u0bbe? \u0b8e\u0ba9\u0b95\u0bcd \u0b9a\u0b95\u0b9f\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0b9a\u0bb1\u0ba9\u0bcd."
