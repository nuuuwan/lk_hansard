    "chunk_text": "\u200d\u0db8\u0dca \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u200d\u0dbb\u0dd9\u0dc0\u0d9a\u0da7 \u0dc3\u0db1\u0dba \u200d\u0dbb\u0dd9\u0dba\u0d9a\u0dca\u0dc2 \u0dd4\u0dc0\u0dc1\u0dca\u0dba \u0dc0\u0db1\u0dc0\u0db1 \u0d9a\u0dd2\u0dba\u0d9a\u0db1 \u0d9a\u0dd2\u0dda\u0dc0\u0db1. \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0daf\u200d\u0db1\u0dca\u0daf, contributory pension \u0d91 \u0d9a\u0dca\u0dc2. \u0db1\u0dd4\u0daf\u0dad\u0dca, \u0d8a\u200d\u0d86 \u0da2\u0dcf\u0db1\u0db1\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dbd\u0dad\u0dd4\u0dd9\u0db1 \u0d89\u0dad\u0db1\u0dd9 irresponsible \u0dc0\u0dd0\u0da9\u0d9a\u0dca\u0dc2 \u0dd9\u0db1. \u0d92 \u200d\u0dd9\u0db1 \u0d9a\u0dca\u0dc2\u0dc3? \u0dbb\u0dcf\u0da2\u0dd2\u0dad\u0dca \u0dd9\u0daf\u0dca\u0dd4\u0dd9 \u0db6\u0da9\u0dd4\u0d9a\u0da9\u0db1\u0dbb \u0dd9\u0dca\u0dad\u0dca\u0dd9\u0dba\u0db1 \u200d\u0db4\u0db1\u0dca\u0daf\u0db1\u0d9a\u0db1 \u0d9a\u0dd2\u0dda\u0dc0\u0db1, \u0d92 \u0dc3\u0dc0 \u0dc0\u0dc0\u0d9a \u0db6\u0db3\u0dc0\u0db1 \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dca \u0dbb\u0db1\u200d \u0db1\u0da7 \u0d9c\u0dca\u0dbb \u0d9c\u0dd0 \u0da7\u0dca \u0d91 \u0d89\u0dc0\u0dad\u0dca \u0dbb\u0db1\u0dc0\u0db1 \u0d9a\u0dd2\u0dba\u0d9a\u0db1. \u0d92\u200d \u0db1\u0dca\u0daf \u200d\u0dd9\u0db1 \u0d9a\u0dca\u0dc2\u0dc3 \u0d91\u0dad\u0dd4\u0dd9\u0db1 \u0dd4\u0dc3\u0dca \u0dc0 \u200d\u0dd9\u0dc0? \u0d91\u0dad\u0dd4\u0dd9\u0db1 \u0dd4\u0dc3\u0dca \u0dc0 \u200d\u0dd9\u0dc0 \u0dd4\u0db4\u0dd2 \u0d9a\u0dd2\u0dc3\u0dd2\u0dd9 \u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0da7 \u0dc3\u0db1\u0dba \u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca\u0dc2 \u0d9a\u0db6\u0db1 \u0d9c\u0db1\u0dca\u0daf\u200d\u0db1\u0dca\u0daf \u0db1\u0dd0\u0dad\u0dd2\u0dbd\u0dc0 \u0daf\u0dd2\u0d9c\u0da7\u0dd9 \u200d\u0db8\u0dca \u0d9c\u0dd2\u0daf\u0dc4 \u0db1\u0dca\u0daf\u0dc3 \u0dc3\u0da9\u0dd9 \u0da2\u0dd3\u0dc0\u0dad\u0dca \u200d\u0dc0\u0db1\u0dca\u0daf\u0db1 \u0db6\u0d9a\u0db1\u200d\u0db4\u0db1\u200d\u0dbb\u0db1\u0dad\u0dca\u0dad\u0dd4 \u200d\u0dc0\u0db1\u0dc0\u0db1 \u0d9a\u0dd2\u0dba\u0d9a\u0db1\u0dd2. 2015\u0daf\u0dd3 \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0db3\u0dca\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 562\u0dd2; \u0dc0\u0dd2\u200d\u0dbb\u0db1\u0dd9 \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0db3\u0dca\u0db1 \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 157\u0dd2. 2026\u0daf\u0dd3 \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0db3\u0dca\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1,323\u0dd2; \u0dc0\u0dd2\u200d\u0dbb\u0db1\u0dd9 \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0db3\u0dca\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 517\u0dd2. \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0daf\u200d\u0db1\u0dca\u0daf \u0dc3\u0dd2\u0dba\u0dba\u0da7 135\u0d9a\u0dd2\u0db1\u0dca\u0daf \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc0\u0dd0\u0dd2 \u200d\u0dc0\u0d9a\u0db1 \u0dad\u0dd2\u0dbd\u200d\u0db6\u0db1\u0dc0\u0db1. \u0dc3\u0dd2\u0dba\u0dba\u0da7 230\u0d9a\u0dd2\u0db1\u0dca\u0daf \u0dc0\u0dd2\u200d\u0dbb\u0db1\u0dd9 \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc0\u0dd0\u0dd2 \u200d\u0dc0\u0d9a\u0db1 \u0dad\u0dd2\u0dbd\u200d\u0db6\u0db1\u0dc0\u0db1.\n\n279 280\n\n[\u0d9c\u0dbb\u0dd4 6\u0dca\u0da0\u0db1\u0d9c\u0dba \u0dca\u0d9c\u0dc2\u0dba \u0dc3 \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0db1 \u0dd9\u0dca\u0dad\u0db1]\n\n2025 \u200d\u0db1\u0db1\u0dc0\u0dd0\u0db8\u0dca\u0db6\u0d9c 08\n\n\u200d\u0dc3\u0dd9\u0dda\u0db4\u0dd2\u0dba\u0db1\u0dca\u0daf\u200d\u0dda \u200d \u0dde\u0d9b\u0dca\u200d\u0dba \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0d9c\u0dd0\u0db1 \u0dcf\u0db1 \u0dbb\u0db1\u200d \u0db1\u0da7 \u200d\u0db1\u0db1\u200d\u0dba\u0dc0\u0dda\u0dad\u0dca \u200d\u0db4\u0db1\u200d\u0dbb\u0db1\u0db1\u0dca\u0daf\u0dd4 \u0dd4\u0db1\u0dca\u0daf\u0db1\u0db1. \u200d \u0dd2 \u0db1\u0d9a\u0dba \u0daf\u0dd3 \u200d \u0dde\u0d9b\u0dca\u200d\u0dba \u0dc0\u0dd2\u0dba\u0dc3\u0dd9 \u0dc3\u0dd2\u0dba\u0dba\u0da7 3\u0d9a\u0dca\u0dc2 \u0dbb\u0db1\u0dc0\u0db1 \u0d9a\u0dd2\u0dba\u0d9a\u0db1 \u200d\u0db4\u0db1\u200d\u0dbb\u0db1\u0db1\u0dca\u0daf\u0dd4 \u0dc0\u0dd4\u0dab\u0db1. \u0dc3\u0dd2\u0dba\u0dba\u0da7 1.5\u0d9a\u0dca\u0dc2, 1.6\u0d9a\u0dca\u0dc2 \u0dc0\u0dd2\u0dba\u0dc3\u0db8\u0dca \u0dc0\u0db1\u0dc0\u0db1 \u0d87\u0dad\u0dd2\u0dbd. \u0dc0\u0dc3\u0db1\u0dc3 \u200d\u0db8\u0dca \u200d\u0dc0\u0db1\u0dca\u0daf\u200d\u0db1\u0dca\u0daf \u0d9a\u0dd2\u0dba\u0d9a\u0db1 \u0dd9\u0dd9 \u0dc3\u0db1\u0dca\u0daf\u200d\u0db1\u0dca\u0daf \u0db1\u0dd0\u0dca\u0dd0. \u0dca\u0dd0\u0db6\u0dd0\u0dd2, \u200d\u0dca\u0db1\u0db3 \u200d\u0dc3\u0dba\u0da7 \u200d\u0dca\u0db1\u0db3\u0dd2 \u0d9a\u0dd2\u0dba\u0d9a\u0db1\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0daf\u0db1 \u0d95\u0db1\u0db8. \u0dba\u0db8\u0dca \u0dd4\u0daf\u0dc3\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd9\u0db1\u0dab\u0dba\u0d9a\u0dca\u0dc2 base hospitals\u0dc0\u0d9a\u0da7 \u200d\u0dc0\u0db1\u0dca\u0daf \u0dbb \u0dad\u0dd2\u0dbd\u200d\u0db6\u0db1\u0dc0\u0db1. \u0dca\u200d\u0dbb\u0ddd\u0d9c\u0dba\u0db1 \u0dd9\u0db0\u0dba \u0dc0\u0dcf\u0db1\u0db1\u0dc0\u0d9a\u0da7 \u0dd4\u0daf\u0dc3\u0dbd\u0dca \u200d\u0dc0\u0db1\u0dca\u0daf \u0dbb \u0dad\u0dd2\u0dbd\u200d\u0db6\u0db1\u0dc0\u0db1. \u0d92\u0dc0\u0db1 \u200d\u0dca\u0db1\u0db3\u0dd2. \u0dd4\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4 40\u0da7 \u0dc0\u0dd0\u0dd2 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u200d\u0dc3\u0db1\u0db1\u0da7 - \u0d9a\u0db6\u0dad\u0dd4\u0dd9\u0db1\u0dad\u0dca \u0dd9\u0dca\u0dbb \u0dc0\u0dd2\u0da7 \u200d\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0db1\u0dca\u0daf\u0db1 \u0dc3\u0dc3\u0dc0\u0dd4 \u200d\u0dc0\u0db1\u0dca\u0daf\u0db1 \u0d87\u0dad\u0dd2\u0dbd - \u0dc0\u0db1\u0d9c\u0dd2 \u0dc0 \u200d\u0db1\u0db1\u0db8\u0dd2\u200d\u0dbd\u0dca \u0daf\u0dc0\u0dc3\u0dba \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dc2\u0dba\u0dab\u0dba\u0d9a\u0dca\u0dc2 \u0dbb\u0db1\u0dc0\u0db1 \u0d9a\u0dd2\u0dda\u0dc0\u0db1. \u0d91\u200d\u0dca\u0dd9 \u0d9a\u0dd2\u0dda\u0dc0\u0db1 \u200d\u0db1\u0dca\u0daf. \u0d92 \u0db3\u0dca\u0db1\u0dca\u0daf \u0dbb \u0dad\u0dd2\u0dbd\u200d\u0db6\u0db1\u0dc0\u0db1. \u0dca\u0dd0\u0db6\u0dd0\u0dd2, \u0d9a\u0dd2\u0dc3\u0dd2\u0dd9 \u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0da7 \u0d92 \u0d9c\u0dd0\u0db1 \u0dcf\u0db1\u0dc0\u0d9a\u0dca\u0dc2 \u200d\u0dc0\u0db1\u0dca\u0daf\u200d\u0db1\u0dca\u0daf \u0db1\u0dd0\u0dca\u0dd0. \u0daf\u0dc4\u0dc3\u0db1\u0dca\u0daf\u0d9c\u0dad \u200d\u0dbb\u0ddd\u0d9c\u0dd3\u0db1\u0dca\u0daf\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 10,000 \u0d9c\u0dab\u200d\u0db1\u0dca\u0daf \u0d9a\u0db6\u0db1 \u200d\u0dc3\u0db1\u0dc0\u0db1 \u0d9a\u0dd2\u0dba\u0d9a\u0db1 \u0dad\u0dd2\u0dbd\u200d\u0db6\u0db1\u0dc0\u0db1. \u0d92 \u0dad\u0dd0\u0d9a\u0dc3\u0dd3\u0db8\u0dd2\u0dba\u0db1 \u200d\u0dbb\u0ddd\u0d9c\u0dd3\u0db1\u0dca\u0daf\u0da7 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca\u0dc2 \u200d\u0dc3\u0db1\u0dca\u0daf\u0db1 \u0d9a\u0dd2\u0dba\u0d9a\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 250\u0d9a\u0dca\u0dc2 \u200d\u0dc0\u0db1\u0dca\u0daf \u0dbb \u0dad\u0dd2\u0dbd\u200d\u0db6\u0db1\u0dc0\u0db1."
  },
