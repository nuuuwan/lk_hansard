    "date_str": "2025-11-07",
    "description": "Hansard of 2025-11-07",
    "url_metadata": "https://www.parliament.lk/en/business-of-parliament/hansards",
    "lang": "si-ta-en",
    "url_pdf": "https://www.parliament.lk/uploads/businessdocs/english/22710_english_2025-11-07.pdf",
