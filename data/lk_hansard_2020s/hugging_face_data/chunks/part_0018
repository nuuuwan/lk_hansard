\u0dd4\u0dca\u200d\n\n\u0dca\u200d\u0dcf\u0dc0 \u0dcf\u0dbd\u0dd2 \u0db4\u0dca\u200d\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dbd \u0dd2\u0dba\u0dbd\u0dca\u200d\u0db4\u0dca\u200d\u0dbb\u0dda \u0dc3\u0dd2\u0dbb \u0dc3\u0dca\u0dbb\u0dbb \u0db4\u0dca\u200d\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dbd \u0dd2\u0dba\u0dbd\u0dca\u200d\u0dba \u0db1\u0dda\u0dc0\u0dcf\n\n08 6 \u00bd 04\n\n\u0dc3\u0dca\u0dbb\u0dbb \u0db4\u0dca\u200d\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dbd \u0dd2\u0dba\u0dbd\u0dca\u200d\u0db4\u0dca\u200d\u0dbb\u0dda \u0dc3\u0dd2\u0dbb \u0dca\u200d\u0dcf\u0dc0 \u0dcf\u0dbd\u0dd2 \u0dc3\u0dd4\u0dbb\u0dba\u0da7 \u0dd2\u0dba\u0dbd\u0dca\u200d\u0dba \u0db1\u0dda\u0dc0\u0dcf\n\n11 9 \u00bd 07\n\n\u0dca\u200d\u0dcf\u0dc0 \u0dcf\u0dbd\u0dd2 \u0dc3\u0dd4\u0dbb\u0dba\u0da7 \u0dd2\u0dba\u0dbd\u0dca\u200d\u0db4\u0dca\u200d\u0dbb\u0dda \u0dc3\u0dd2\u0dbb \u0dc3\u0dca\u0dbb\u0dbb \u0dc3\u0dd4\u0dbb\u0dba\u0da7 \u0dd2\u0dba\u0dbd\u0dca\u200d\u0dba \u0db1\u0dda\u0dc0\u0dcf\n\n13 11 \u00bd 09\n\n(\u0d86) (i) \u0db4\u0dca\u200d\u0dbb \u0dc0\u0db1 \u0dc0\u0dd2\u0dbb \u0dad\u0dca\u200d\u0dbb\u0dd2\u0dc0\u0dd2\u0db0 \u0dc4\u0db8\u0dd4\u0db1\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d9a\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba \u0d89\u0dca\u200d\u0dcf \u0dc3\u0dd4\u0dbd\u0dca\u200d\u0dc3\u0dd4 \u0dc3\u0dc4\u0d9c\u0dca\u200d \u0db4\u0dca\u200d\u0dbb\u0dbd\u0dca\u200d\u0dc3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8 \u0dd2\u0dbb\u0dd3\u0db8\u0db8\u0dbb \u0dc3\u0dd4\u0dbd\u0dca\u200d\u0dc3\u0dd4 \u0dc3 \u0dc3\u0dca \u0dbb\u0dd2\u0da7 \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d85\u0dca\u200d\u0dbb \u0dc4\u0db8\u0dd4\u0db1\u0dcf\u0d9c\u0dca\u200d \u0db4\u0dd4\u0dd3\u0d9c\u0dbd\u0dca\u200d\u0dba\u0da7 \u0d89\u0dc0\u0dad\u0dca \u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0dc3\u0dcf\u0dc4\u0dcf \u0dd2\u0dbb\u0dc3\u0dd2\u0dbb\u0dd4 \u0dad\u0dd3\u0dbb\u0dab\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0d9c\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db8\u0dd4\u0dca\u200d.\n\n(ii) \u0d85\u0db1\u0dcf\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db4\u0dca\u200d\u0dbb\u0dda.\n\n(iii) \u0d85\u0db1\u0dcf\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db4\u0dca\u200d\u0dbb\u0dda.\n\n(iv) \u0dad\u0dca\u200d\u0dbb\u0dd2\u0dc0\u0dd2\u0db0 \u0dc4\u0db8\u0dd4\u0db1\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d9a\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba \u0dd2\u0dbb\u0dd3\u0db8\u0db4\u0dca\u200d\u0dbb \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dbd\u0dd2\u0dba \u0dcf\u0dbd\u0dca\u200d\u0dba\u0dbb \u0d9c\u0dd4\u0dc5\u0db4\u0dca\u200d\u0dbb\u0db4\u0db1 \u0db4\u0dba\u0dd0\u0dd2 \u0dc3 \u0dc3\u0dca \u0dd2\u0dbb\u0dd3\u0db8\u0db8\u0dbb \u0dbb\u0dd4\u0dad\u0dad\u0dd4\u0db8 \u0dbb\u0dd2\u0da7 \u0d87\u0dca\u200d. \u0d91\u0db1\u0db8\u0dd4\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0db4\u0dca\u200d\u0dbb\u0dda \u0dc3\u0dcf\u0dc4\u0da7 \u0db4\u0dba\u0dd0\u0dd2 \u0d91\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d9a\u0dc0\u0dd2\u0db0\u0dcf\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dbd\u0dd2\u0dba \u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0da7 \u0db1\u0dd4\u0db1\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dca\u0dc0\u0db4\u0dca\u200d\u0dbb\u0dda \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dc4\u0db8\u0dd4\u0db1\u0dcf \u0dc3\u0dcf\u0db8\u0dcf\u0da7\u0dbd \u0dba\u0da7 \u0d89\u0dc0\u0dad\u0dca \u0dd2\u0dbb\u0dd3\u0db8\u0db8\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc4 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0d9c\u0dd4\u0da7 \u0dc0\u0dd3\u0db8\u0dda \u0d9c\u0dd4\u0db1 \u0dd2\u0dbb\u0dc3\u0dd2\u0dbb\u0dd4 \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0dbb \u0d91\u0dc5\u0dd4\u0db9\u0dd3 \u0db1\u0dd4\u0dad\u0dd2 \u0d82\u0dc0 \u0db4\u0dca\u200d\u0dbb \u0dcf \u0dbb\u0dd2. \u0dd2\u0dba\u0dba\u0dd2\u0dca\u200d \u0dcf\u0dbd\u0dca\u200d\u0dba \u0dc3\u0db4\u0dd4\u0dbb\u0dcf \u0d89\u0dd2\u0dba\u0dd0\u0db4\u0dca\u200d\u0dbb\u0dda\u0daf\u0dd3 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dba\u0dcf\u0db8\u0dbb \u0dd2\u0dba\u0dba\u0dd2\u0dca\u200d \u0dc3\u0dc4 \u0db1\u0dd4\u0db1\u0dbb \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dcf\u0dc3\u0dca \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dc4\u0db8\u0dd4\u0db1\u0dcf \u0dc3\u0dcf\u0db8\u0dcf\u0da7\u0dbd \u0dba\u0da7 \u0db4\u0dca\u200d\u0dbb \u0dc4\u0dd4\u0dd2\u0dbb\u0dba\u0dcf\u0dc0\u0da7 \u0d92 \u0dc0\u0dcf\u0db4\u0dca\u200d\u0dbb \u0db8 \u0d94\u0dc0\u0dd4\u0da7 \u0db4\u0dca\u200d\u0dbb \u0dd2\u0dba\u0db4\u0dd4\u0dab\u0dca\u200d\u0dcf \u0d85\u0db1\u0dd4\u0dc0 \u0d94\u0dc0\u0dd4\u0da7 \u0dca\u200d\u0dcf\u0dad\u0dd2 \u0d86\u0dbb\u0dca\u0dbd\u0dbb \u0dba\u0dbb \u0d82\u0dd3\u0db0 \u0dbb \u0db5\u0dbd\u0dca\u200d\u0db1\u0dcf\u0dba\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dca\u0dc0\u0dba\u0dda \u0dbb\u0dbb\u0dbb \u0dbd\u0dca\u200d\u0d82\u0dcf \u0d9c\u0dd4\u0dd3\u0dad\u0db4\u0dca\u200d\u0dbb \u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0dc0\u0dd4\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc5\u0dda \u0dc3\u0dd4 \u0dc3\u0dd3\u0db4\u0dca\u200d\u0dbb \u0dbb\u0dd4\u0dad\u0dad\u0dd4\u0db8 \u0d86\u0dbb \u0db7 \u0dbb \u0d87\u0dca\u200d. \u0d92 \u0dc3\u0dcf\u0dc4\u0dcf \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0da7 \u0dca\u200d \u0dc3\u0dc4 \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba \u0dad\u0dca\u0dc0 \u0dc3\u0d9a\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dca\u200d\u0dba\u0dcf\u0d9a \u0dba \u0dc3\u0db8\u0d9f \u0dc3\u0dcf \u0da0\u0dca\u0da1\u0dcf \u0dbb \u0db8\u0dd6\u0dbd\u0dd2 \u0d85\u0dd2\u0dba\u0dbb\u0dba\u0da7 \u0db4\u0dca\u200d\u0dbb \u0dc0\u0db1 \u0dc0\u0dd2\u0dbb\u0dad\u0dca \u0d86\u0dbb\u0dda\u0dc2 \u0d85\u0db8\u0dcf\u0dca\u200d\u0dba\u0dcf\u0d9a \u0dba \u0d86\u0dbb \u0db7 \u0dbb \u0d87\u0dad\u0dd2 \u0d82\u0dc0 \u0dc3\u0dcf\u0dc4\u0da7 \u0dbb\u0dd2."
