dc0\u0dc3\u0dcf\u0db1\u0daf\u0daf\u0dc0\u0dda\u0db4\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0dad\u0dca \u0db4\u0dad\u0dad\u0dd2\u0db4\u0d91\u0d9a\u0dd3\u0db4\u0dca\u0da5\u0daf\u0db4\u0db4\u0db1\u0dba\u0dba\u0dc0\u0dad\u0dca\u0db44]\u0db4\u0dc3\u0dcf\u0dcf\u0db442\u0db4\u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dc3\u0db4\u0dc3\u0dcf\u0dc3\u0dc0\u0dc1\u0dca\u0ddd\u0db0\u0dca\u200d\u0dba\u0d9a\u0db4\u0dbb\u0dbb\u0daf\u0daf\u0db4\u0dc3\u0dcf\u0d9f\u0db4\u0db4\u0db1\u0dba\u0dbb\u0db4\u0dd4\u0dbb\u0da7\u0db4\u0daf\u0db6\u0daf\u0db4\u0dc0 \u0dba\u0db4\n\n\u0dca\u0dbb\u0dca \u0dc2\u0daf\u0dc0\u0db4\u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca\u0db4\u0dc1\u0dca\u0dca \u0dad\u0dd2\u0dc3\u0dad\u0dad\u0dca\u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dba\u0db4\u0dd2\u0dbb\u0d9a\u0dba\u0db4\u0d91\u0dbb.\u0db4\u0d92\u0db4\u0dc0\u0dc0\u0dc0 \u0dc0\u0dc0\u0db1\u0dca\u0db4\u0dbb\u0da2\u0dcf\u0d9a\u0db4\u0d9c\u0db1\u0dca\u0dba\u0daf\u0db4\u0db4\u0dd2\u0d9a\u0dc0\u0dbb\u0db4\u0dc0\u0dad\u0daf\u0dbb\u0dca \u0db4\u0dd2\u0dbb\u0d9a\u0daf\u0daf\u0db4\u0d85\u0db4\u0dd2\u0db4\u0d85\u0dcf\u0db1\u0dca\u0dba\u0db4\u0dbb\u0dd0\u0dad\u0dd0\u0dad\u0dd2\u0dc3\u0dd2.\u0db4\n\n6. 2124\u0db4\u0dc0\u0dc3\u0dcf\u0dc0\u0dbb\u0dca\u0daf\u0dd3\u0db4\u0db6\u0dd4\u0dca \u0db0\u0dca\u200d\u0dc1\u0dca\u0daf\u0dc3\u0dcf\u0dba\u0db4\u0d85\u0dad\u0daf\u0dad\u0dba\u0daf\u0dc3\u0dc1\u0dca\u0d9a\u0da7\u0db4\u0dc0\u0dc0\u0db1\u0dca\u0db4\u0dbb \u0db4\u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0db4\u0db1\u0dba\u0daf \u0dba\u0db4\u0db4\u0dca\u200d\u0dbb\u0dad\u0daf \u0d9a\u0db4\u0dc0\u0dbb\u0daf\u0db4\u0db1\u0dba\u0dad ?\u0db4\u0d91\u0dc4\u0dd2\u0db4\u0dc0\u0db7\u0dde\u0dad\u0dd2\u0dc3\u0dbb\u0db4\u0dcf\u0daf\u0db4\u0dd6\u0dbd\u0daf\u0dba\u0db4\u0db4\u0dca\u200d\u0dbb\u0d9c\u0dad\u0dd2\u0dc3\u0d9a\u0db4\u0dc0\u0dbb\u0db6\u0db3\u0dd4 ?\u0db4212)\u0db4\u0dc0\u0dc3\u0dcf\u0dc0\u0dbb\u0dca\u0daf\u0dd3\u0db4\u0db6\u0dd4\u0dca \u0db0\u0dca\u200d\u0db4\u0dc1\u0dca\u0daf\u0dc3\u0dcf\u0dba,\u0db4\u0dca\u0d9c\u0db8\u0dd2\u0dbb\u0db4\u0dc3\u0dcf\u0dcf