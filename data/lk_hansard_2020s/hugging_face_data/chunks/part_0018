    "chunk_text": "\u0db8\u0dd6\u0db6\u0daf\u0dc3\u0dcf\u0db1\u0daf\u0dbb\u0dd6\u0daa\u0d9a\u0d9c\u0dbb\u0dd4\u0d9a\u0db8\u0dca \u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba,\u0d9a\u0d85\u0ddd\u0db4\u0dca\u0d9a\u0dbb\u0ddd\u0da7\u0dca\u0d9a\u0db4\u0dca\u200d\u0dbb\u0daf\u0ddd\u0daf\u0dca\u0dba \u0dba\u0d9a\u0ddd\u0dbd\u0dca\u0db4\u0dda\u0d9a\u0ddd\u0db4\u0ddc\u0da7\u0dca\u0dc3\u0daf\u0dc3\u0dcf\u0d9a339\u0dca\u0dc2\u0d9a\u0dad\u0dd2\u0ddd\u0dcf\u0db1\u0dc0\u0daf.\u0d9a\u0ddd\u0dda\u0d9a\u0db4\u0dca\u200d\u0dbb\u0daf\u0ddd\u0daf\u0dca\u0dba \u0dba\u0d9a\u0ddd\u0dbd\u0dca\u0db4\u0dda\u0d9a\u0ddd\u0db4\u0ddc\u0da7\u0dca\u0dc3\u0daf\u0dc3\u0dcf\u0d9a339\u0dba\u0dd2,\u0d9a\u0d8b\u0dcf\u0d9a\u0db4\u0daf\u0d9c\u0dba\u0daf\u0db6\u0d9a\u0ddd:\u0db4\u0dba\u0dd2\u0d9a\u0dbb\u0dca\u0dc2\u0db4\u0d9a\u0d94\u0dca\u0dc2\u0ddd\u0db4 \u0db8\u0d9a3.1\u0dba\u0dd2.\u0d9a\u0ddd\u0dda\u0dc0\u0daf\u0ddd\u0dba\u0dca \u0d9a16.\u0db4\u0d9a\u0d89\u0dca \u0ddd\u0dca \u0d9a\u0db4\u0daf\u0dca \u0dca\u200d\u0daf\u0ddd\u0dc0 .\u0d9a\u0ddd\u0dda\u0d9a\u0dba\u0db1\u0d9a\u0db4\u0dca\u200d\u0dbb\u0dc0\u0dab\u0dca\u200d\u0daf\u0dc0\u0d9a\u0d85\u0dbb\u0ddd\u0d9c\u0db1\u0d9a\u0dcf\u0db6\u0db1\u0ddd\u0db4\u0ddc \u0d9a\u0ddd\u0dcf\u0ddd\u0db1\u0db1\u0dc0\u0daf,\u0d9a\u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0ddd\u0dda\u0dd3 \u0d9a\u0ddd\u0dda\u0d9a\u0db4\u0daf\u0dca \u0dca\u200d\u0daf\u0dc0\u0dca \u0d9a\u0dc3\u0dcf\u0dc0\u0d9b\u0dba\u0daf\u0dc0\u0d9a\u0dca\u200d\u0dc0\u0dad\u0dca\u0d9a\u0dc0\u0dd0\u0da9\u0dd2\u0dc0\u0db1\u0d9a\u0dcf\u0dc0.\u0d9a\u0dc0\u0d9c\u0dca\u200d\u0db8\u0daf\u0db1\u0ddd\u0dda\u0dd3 \u0d9a\u0dbb\u0daf\u0da2\u0dba\u0d9a\u0dcf\u0dbb\u0dd2\u0dcf\u0daf\u0db6\u0db1\u0dba\u0dad\u0dca\u0d9a\u0db4\u0daf\u0dca \u0dca\u200d\u0daf\u0dc0\u0d9a\u0dc0\u0dd2\u0dc3\u0dd2\u0dca \u0d9a\u0d85\u0dad\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dab\u0dba\u0d9a\u0db4\u0dbb\u0db6\u0daf\u0d9a\u0d89\u0dc0\u0dbb\u0dba\u0dd2.\u0d9a\u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0ddd\u0dda\u0dd3 \u0d9a\u0ddd\u0dda\u0d9a\u0ddd\u0dcf\u0dde\u0daf\u0dca\u0db0\u0d9a\u0dc0\u0dd2\u0dc4\u0daf\u0dbb\u0d9a\u0ddd\u0daf\u0dca\u0dc0\u0daf\u0db6\u0d9c\u0dda\u0d9a\u0d86\u0da5\u0daf\u0dcf\u0db1\u0ddd\u0dad\u0dca\u0d9a\u0dc3\u0dcf\u0db3\u0dc4\u0dca \u0d9a\u0db8\u0dc4\u0dad\u0dca\u0dad\u0dd4\u0db8\u0dbb\u0dd4\u0dca \u0d9a\u0db1\u0dd0\u0dad\u0dd2\u0dc0\u0d9a\u0dba\u0db1\u0dc0\u0daf,\u0d9a\u0db4\u0dca\u200d\u0dbb\u0d9a\u0dca\u0daf\u0ddd\u0daf\u0dca\u0dba \u0dba\u0d9a\u0ddd\u0dbd\u0dca\u0db4\u0dda\u0dc0\u0dbb\u0dd4\u0dca \u0d9a\u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0d9a\u0da1\u0dca :\u0dba\u0d9a\u0ddd:\u0dca \u0db1.\u0d9a\u0dbb\u0ddd\u0dc4\u0db8\u0d9a\u0dc0\u0dd4\u0ddd\u0dab\u0ddc\u0dad\u0dca\u0d9a\u0d89\u0dad\u0dd2\u0dbb\u0dd2\u0d9a\u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dcf\u0d9a\u0dc3\u0dcf\u0db1\u0dc0\u0daf\u0d9a\u0dca\u0dca \u0d9a\u0dc0\u0dc4\u0dca \u0ddd\u0dc3\u0dcf\u0dda\u0db6\u0daf\u0d9a\u0dcf\u0db8\u0dab\u0dca\u0dc2\u0d9a\u0dcf\u0dc0 \u0d9a\u0dcf\u0dad\u0dca\u0d9a\u0dc0\u0db1\u0dc0\u0daf.\u0d9a\u0d9c\u0dbb\u0dd4\u0d9a\u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba,\u0d9a\u0d92\u0d9a\u0dd2\u0dba\u0dc3\u0dcf\u0daf\u0d9a\u0db8\u0db8\u0d9a\u0dd2\u0dbb\u0dba\u0db1\u0dc0\u0daf,\u0d9a\u0d94\u0dcf\u0dad\u0dd4\u0db8\u0db8\u0daf\u0d9a\u0ddd\u0dda\u0db4 \u0d9a\u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca\u0d9a\u0ddd\u0dc0\u0dca \u0db1\u0d9a\u0dd2\u0dbb\u0dba\u0db6\u0daf.\u0d9a\u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca\u0d9a\u0ddd\u0dc0\u0db6\u0daf\u0d9a\u0ddd\u0dda\u0d9a\u0db4 \u0dba\u0dd4\u0dad\u0dca\u0ddd\u0dad\u0dca\u0dd3 \u0d9a\u0db8\u0dc4\u0dad\u0dca\u0dad\u0dd4\u0db8\u0dbb\u0dd4\u0dca \u0d9a\u0dcf\u0db8\u0dab\u0dca\u0dc2\u0d9a\u0dad\u0dd2\u0db6\u0dd4\u0dd4\u0d9a\u0ddd\u0dda\u0d9a\u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0d9a\u0db4\u0daf\u0dca \u0dca\u200d\u0daf\u0dc0 \u0dad\u0dca\u0d9a\u0db6\u0dcf\u0daf\u0d9a\u0ddd:\u0dca \u0db1.\u0d9a\u0db6\u0dd4\u0daf\u0dca\u0db0\u0d9a\u0dba\u0daf\u0dc3\u0dcf\u0db1\u0ddd\u0dda\u0d9a\u0ddd\u0db4\u0ddc\u0dca\u200d\u0dd0\u0db1\u0db4\u0dc0\u0dad\u0dca,\u0d9a\u0db6\u0dd4\u0daf\u0dca\u0db0\u0d9a\u0ddd\u0daf\u0dca\u0dba\u0db1\u0ddd\u0dda\u0d9a\u0ddd\u0db4\u0ddc\u0dca\u200d\u0dd0\u0db1\u0db4\u0dc0\u0dad\u0dca\u0d9a\u0db4\u0daf\u0dca \u0dca\u200d\u0daf\u0dc0\u0d9a\u0ddd:\u0dc0\u0dd0\u0dd2\u0dba\u0ddd\u0db4\u0ddc \u0d9a\u0dc3\u0dcf\u0db6\u0db4\u0db6\u0daf\u0d9a\u0db1\u0dd0\u0dc4\u0dd0.\u0d9a\u0d92\u0d9a\u0dc0\u0daf\u0d9a\u0ddd \u0db8\u0d9a\u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8\u0d9a\u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0db1\u0dae\u0daf\u0ddd\u0daf\u0d9a\u0ddd\u0db4\u0ddc\u0dca\u200d\u0dd0\u0db1\u0db4\u0dc0\u0dad\u0dca\u0d9a\u0db4\u0daf\u0dca \u0dca\u200d\u0daf\u0dc0\u0d9a\u0ddd:\u0dc0\u0dd0\u0dd2\u0dba\u0d9a\u0ddd\u0db4\u0ddc \u0d9a\u0dc3\u0dcf\u0db6\u0db4\u0daf\u0d9a\u0db1\u0dd0\u0dc4\u0dd0.\u0d9a\u0d92\u0d9a\u0dd2\u0dba\u0dc3\u0dcf\u0daf\u0d9a\u0ddd\u0dda\u0d9a\u0ddd\u0dcf\u0dde\u0daf\u0dca\u0db0\u0d9a\u0dc0\u0dd2\u0dc4\u0daf\u0dbb\u0d9a\u0ddd\u0daf\u0dca\u0dc0\u0daf\u0db6\u0d9c\u0dda\u0d9a\u0d86\u0da5\u0daf\u0dcf\u0db1\u0ddd\u0dad\u0dca\u0d9a\u0ddd\u0dda\u0d9a\u0dad\u0dd2\u0ddd\u0dcf\u0db1\u0d9a\u0ddd\u0db4\u0ddc \u0dc3\u0dcf\u0d9a\u0dc3\u0dcf\u0dc0\u0ddd\u0dba \u0db0\u0db1\u0d9a\u0db4\u0dbb\u0dca \u0db1 \u0d9a\u0d95\u0db1\u0dd1.\u0d9a\u0dc0\u0dd2\u0ddd\u0dba\u0dda\u0dc2\u0ddd\u0dba\u0dca \u0db8\u0d9a\u0ddd\u0dda\u0d9a\u0dc3\u0dcf\u0d9a\u0dca\u0dc0\u0ddd\u0dba \u0db0\u0db1\u0ddd\u0dda\u0dd3 \u0d9a\u0dca\u200d\u0db8\u0d9a\u0db8\u0dc0 ,\u0d9a\u0dc3\u0dcf\u0ddd\u0dc4 :\u0dbb\u0dd2\u0dba \u0d9a\u0d9c\u0dbb\u0dd4\u0d9a\u0db4\u0dbb\u0db1\u0d9a\u0d85\u0ddd\u0db4\u0dca\u0d9a\u0db8\u0dbd\u0dca\u0dc0\u0dad\u0dd4\u0db8-\u0d85\u0dc3\u0dcf\u0db1\u0d9c\u0dd2\u0dbb\u0dd2\u0d9a\u0d8b\u0dcf\u0dba\u0d9a\u0dcf\u0daf\u0d9c\u0dba\u0db1\u0dc0\u0dd3\u0dba\u0d9a\u0d9c\u0dbb\u0dd4\u0dca\u200d\u0dbb\u0d9a\u0db1\u0daf\u0dba\u0db4\u0d9a\u0dc3\u0dcf\u0db1\u0dc0\u0daf\u0d9a\u0dca\u0dca \u0d9a\u0dc0\u0dc4\u0dca \u0ddd\u0dc3\u0dcf\u0dda\u0db6\u0daf\u0d9a\u0ddd:\u0dcf\u0dc5\u0ddd \u0dad\u0dca,\u0d9a\u0d9c\u0dbb\u0dd4\u0dca\u200d\u0dbb\u0d9a\u0d85\u0dca \u0db1\u0daf\u0dba\u0db4\u0d9a\u0dc3\u0dcf\u0db1\u0dc0\u0daf\u0d9a\u0dca\u0dca \u0d9a\u0dc0\u0dc4\u0dca \u0ddd\u0dc3\u0dcf\u0dda\u0db6\u0daf\u0d9a\u0ddd:\u0dcf\u0dc5\u0ddd \u0dad\u0dca,\u0d9a\u0d9c\u0dbb\u0dd4\u0dca\u200d\u0dbb\u0d9a\u0db4\u0daf\u0dbb\u0db4\u0d9a\u0dc3\u0dcf\u0dcf\u0daf\u0d9a\u0dc3\u0dcf\u0db7\u0dd2\u0db4\u0d9a\u0dc3\u0dcf\u0db1\u0dc0\u0daf\u0d9a\u0dca\u0dca \u0d9a\u0dc0\u0dc4\u0dca \u0ddd\u0dc3\u0dcf\u0dda\u0db6\u0daf\u0ddd \u0dad\u0dca\u0d9a\u0d9a\u0d85\u0dca \u0db8\u0dd0\u0dad\u0dd2\u0ddd\u0dba\u0dca ,\u0d9a\u0d85\u0dca \u0dba\u0daf\u0dc3\u0dcf\u0db1\u0daf\u0ddd\u0dc0\u0dca ,\u0d9a\u0d86\u0dba \u0d9c\u0dc0\u0daf:\u0ddd\u0dba\u0dca \u0d9a\u0ddd\u0db8\u0db8\u0d9a\u0ddd\u0dcf\u0dde\u0daf\u0dca\u0db0\u0d9a\u0dc0\u0dd2\u0dc4\u0daf\u0dbb\u0d9a\u0ddd\u0daf\u0dca\u0dc0\u0daf\u0db6\u0d9c\u0dda\u0d9a\u0d86\u0da5\u0daf\u0dcf\u0db1\u0dca\u200d\u0d9a\u0dc3\u0dcf\u0dc0\u0ddd\u0dba \u0db0\u0db1\u0dba\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db8\u0d9a\u0dc3\u0dd4\u0dd4\u0db1\u0dc3\u0dd4\u0dba\u0dd2\u0d9a\u0dd2\u0dbb\u0dba\u0daf\u0d9a\u0db8\u0daf\u0d9a\u0ddd\u0dba \u0da2\u0db1\u0daf\u0d9a\u0d9a\u0db4\u0dbb\u0db1\u0dc0\u0daf.\u0d9a\n\n\u0dc3\u0dcf\u0db1\u0dad\u0dd4\u0db8\u0dad\u0dd2\u0dba\u0dd2. \u0d9c\u0dd4 \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dc0 \u0daa \u0dd9\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dd4\u0dbb\u0dd9\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0b95\u0bb2\u0b95\u0bae\u0ba4\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0d9c\u0dbb\u0dd4\u0d9a\u0dca\u200d\u0dca \u0dbb\u0d9a\u0daf\u0dd2\u0dc3\u0dcf\u0daf\u0db1\u0daf\u0dba\u0db4\u0d9a\u0db8\u0dca \u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0daf.\u0d9a\u0d94\u0dcf\u0dad\u0dd4\u0db8\u0db8\u0daf \u0d9a\u0dc0\u0dd2\u0db1\u0daf\u0da9\u0dd2\u0d9a\u0dcf\u0dc4\u0db4\u0d9a\u0db4\u0daf\u0db6\u0dba\u0dca\u0dc2\u0d9a\u0dad\u0dd2\u0ddd\u0dcf\u0db1\u0dc0\u0daf.\n\n2823 2824\n\n[\u0d9c\u0dbb\u0dd4\u0d9a\u0ddd\u0dbb \u0dd2\u0dc0\u0dab\u0dd3\u0d9a\u0d9a\u0dd4\u0db8\u0daf\u0dbb\u0dd2\u0d9a\u0dc0\u0dd2\u0ddd\u0dda\u0dbb\u0dad\u0dca\u0db1\u0d9a\u0db8\u0dc4\u0dad\u0dca\u0dd2\u0da7\u0dba]\n\n2025 \u0d94\u0dca\u0dc2\u0ddd\u0dca\u200d \u0dcf\u0d9c\u0d9a2.\n\n\u0dc3\u0dcf\u0db8\u0dd9\u0d9a\u0d85:\u0daf\u0dc5\u0d9a\u0dc3\u0dcf\u0daf\u0db4\u0da0\u0dca\u0da1\u0daf\u0d9a\u0d86\u0dbb\u0dda\u0dcf\u0d9a\u0db4\u0dbb\u0dca \u0db1\u0d9a\u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0d9a\u0ddd\u0dc0\u0dba\u0dd2\u0d9a\u0dd2\u0dbb\u0dba\u0db6\u0daf.\u0d9a\u0d8b\u0dca \u0dc0\u0dc4\u0dca \u0ddd\u0dc3\u0dcf\u0dda\u0db6\u0daf\u0ddd \u0d9a\u0d86\u0dba \u0d9c\u0dc0\u0daf:\u0dba\u0dad\u0dca\u0d9a\u0dbb\u0dca\u0dc2\u0db4\u0d9a\u0d9c\u0dbb\u0dd4\u0d9a\u0da0\u0dad\u0dd4\u0db8\u0dbb\u0d9a\u0d9c\u0db6\u0db4\u0dca\u0dcf\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0db8\u0dca \u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0daf\u0d9a\u0dc0\u0dd2\u0dc3\u0dd2\u0dca \u0d9a\u0ddd\u0d9c\u0ddd\u0db1\u0db1\u0d9a\u0db6:,\u0d9a\u0ddd\u0dbb \u0dd2\u0dc0\u0dab\u0dd3\u0d9a\u0db4\u0dc0\u0dd2\u0dbb\u0dad\u0dca\u0db1\u0d9a\u0db8\u0dca \u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0da7\u0dba\u0d9a\u0dc0\u0dd2\u0dc3\u0dd2\u0dca \u0d9a\u0dc3\u0dcf\u0db1\u0dd2\u0d9a\u0dbb\u0d9a\u0db4\u0dbb\u0db1\u0d9a\u0db6:\u0d9a\u0dc3\u0dcf\u0dcf\u0daf\u0dc0\u0d9a\u0db4\u0dbd\u0dca\u0d9a\u0dca\u200d\u0dd0\u0db6\u0dd3\u0ddd\u0dda\u0d9a\u0ddd\u0dba \u0da2\u0db1\u0daf\u0dc0\u0d9a\u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba \u0d9a\u0ddd\u0d9c\u0dd2\u0dba\u0dba\u0dca \u0db1\u0d9a\u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0d9a\u0ddd\u0dc0\u0dba\u0dd2\u0d9a\u0dd2\u0dbb\u0dba\u0dd2\u0da7\u0dca \u0d9a\u0db8\u0ddd \u0d9a\u0d85:\u0dc4\u0dc3\u0dcf\u0db1\u0d9a:\u0dd0\u0dca\u0dc2\u0dc0\u0dd3\u0db8\u0d9a\u0db8\u0db8\u0d9a\u0dc3\u0dcf\u0db8\u0daf\u0db4\u0dca\u0dca\u200d\u0d9a\u0db4\u0dbb\u0db1\u0dc0\u0daf.\u0d9a\u0db8 \u0d9a\u0ddd\u0dda\u0d9a\u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dae\u0daf\u0dc0\u0d9a\u0db6\u0dcf\u0daf\u0d9a\u0dd4\u0db1\u0dca \u0db1\u0daf \u0d9a\u0d9a\u0ddd\u0dcf\u0ddc\u0ddd\u0dc4\u0ddc\u0db8\u0d9a\u0dc3\u0dcf\u0db1\u0dad\u0dd4\u0db8\u0dad\u0dd2\u0dba\u0dd2,\u0d9a\u0db8\u0dd6\u0db6\u0daf\u0dc3\u0dcf\u0db1\u0daf\u0dbb\u0dd6\u0daa\u0d9a\u0d9c\u0dbb\u0dd4\u0d9a\u0db8\u0dca \u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba."
  },
