f\u0db1\u0dc4\u0dd2\u0dbb 6613\n\n\u0dc3\u0db6\u0dbb\u0dd0\u0db8\u0dd4\u0dc0 3994\n\n\u0dc3 \u0dbb 3271\n\n\u0db8\u0d9a \u0dc0 36178\n\n\u0dc3\u0dbb\u0dcf\u0db0\u0dd2\u0dca\u200d\u0dcf\u0dbb\u0dd2\u0db1\u0dca \u0db6\u0db3\u0dc0\u0dcf \u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0db8 \u0dc0\u0db1\u0dca \u0d85\u0db1 \u0dbb\u0dd4\u0dc0 \u0dc0\u0dd0\u0da9 \u0db7\u0dcf\u0dbb \u0db8\u0db1\u0dcf\u0dd0\u0dad\u0dca \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0dda\u0dbd\u0dcf\u0db7\u0dd3\u0db1\u0dca 353\u0d9a \u0dc3\u0db3\u0dc4\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0db8 \u0dc0\u0dcf\u0dc3 02 \u0dc5\u0daf\u0dd3 \u0db6\u0db3\u0dc0\u0dcf \u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc0 \u0db1\u0dca\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0da7 \u0db1\u0dd2\u0dba\u0dd2\u0dba\u0dda\u0dba.\n\n(b) \u0d85\u0d82\u0d9a 2233 \u0dc4\u0dcf 2021.0).18 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0db8\u0dda\u0daf\u0db1\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0daf\u0dd2\u0dc0\u0dd2 \u0db8\u0db1\u0dca \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0dbb\u0dcf\u0dc3\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd2\u0db8\u0daf\u0dca\u0dba \u0db7\u0dcf\u0dc2\u0dcf \u0d89\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0dc0\u0da7 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9c\u0dd4\u0dbb\u0dd4 \u0db8\u0dc3\u0dda\u0dc0\u0db8\u0dda 3-I (\u0d85 \u0db8\u0dc1\u0dca\u200d\u0dbb\u0dda\u0dab\u0dd2\u0dba\u0da7 \u0dc3\u0dbb\u0dcf\u0db0\u0dd2\u0dca\u200d\u0dcf\u0dbb\u0dd2\u0db1\u0dca \u0db6\u0db3\u0dc0\u0dcf \u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0dda \u0dbd\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d85\u0dba\u0daf\u0dd4\u0dda\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca 92 \u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dd0\u0dc0\u0dda \u0dca\u200d\u0dbb\u0dcf\u0db8\u0dba\u0ddd\u0d9c\u0dd2\u0d9a \u0dbb\u0dbb\u0dd3\u0d9a\u0dc2\u0dd9 \u0db1\u0dca\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0da7 \u0d85\u0db8 \u0dc0\u0dcf\u0dda\u0dba \u0db8 \u0dc0\u0da9\u0dd4\u0d9a\u0da9\u0dbd \u0d85\u0db1\u0dd4\u0db8 \u0dc0\u0dd0\u0dad\u0dd2\u0dba \u0dbd\u0dd0\u0db6\u0dd3\u0db8 \u0dc0 \u0db8 \u0dc0\u0dda \u0db8\u0db8 \u0dc0 \u0dbb\u0dbb\u0dd3\u0d9a\u0dc2\u0dd9\u0dba 2025.08.19 \u0daf\u0dd2\u0db1 \u0dbb\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd6 \u0d85\u0dda\u0dbb\u0d8b \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0d89 \u0dbb\u0dd4 \u0dd4\u0dbb \u0daf\u0dbb\u0dcf\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dba\u0daf\u0dd4\u0dda\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca 33\u0db8\u0daf\u0db8\u0db1\u0d9a\u0dd4 \u0dca\u200d\u0dbb\u0d82\u0dba\u0d8b \u0da2\u0dcf\u0dbb\u0db1\u0dca\u0d8b \u0db1,\u0db1\u0d8b \u0db8\u0d9a\u0dcf\u0dbb\u0dd2\u0dba\u0db1\u0dca\u0d8b \u0da2\u0dcf\u0dad\u0db8\u0db8 \u0dc0\u0db1\u0dca \u0dc4\u0dcf \u0dc4\u0dd2\u0db1\u0dca\u0daf\u0dd2 \u0dba\u0db1 \u0dc0\u0dd2\u0dc2\u0dba\u0dba\u0db1\u0dca 0) \u0dc3\u0db3\u0dc4\u0dcf \u0db6\u0db3\u0dc0\u0dcf \u0dd0\u0dd0\u0db1\u0dd3\u0dda \u0db1\u0dca\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0da7 \u0db1\u0dd2\u0dba\u0dd2\u0dba\u0dda\u0dba.\n\n(c) \u0daf\u0dd2\u0dc0\u0dd2 \u0db8\u0db1\u0dca \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0dc4\u0dcf \u0dbb\u0dc5\u0dcf\u0dad\u0dca \u0dbb\u0dcf\u0dc3\u0dca \u0dc0\u0dbd \u0dbb\u0dc0\u0dad\u0dd2\u0db1"
