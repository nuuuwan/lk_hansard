    "chunk_text": "\u0db1\u0d9a\u0db8\u0d9a\u0db1\u0dda \u0dc3\u0dd4\u0db1\u0dd2\u200d\u0dba \u0db6\u0dbd\u0dba\u0dca\u0dad\u0dd2\u0dba \u0db4\u0dd4\u0db8\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dca3 \u0d92 \u0d85\u0dba\u0da7 \u0db8\u0dd2 \u0db1 rate \u0d9a\u0d9a \u0d85\u0dca \u0d9a\u0dbb\u0db1\u0db8\u0d9a\u0dcf\u0da7 \u0dc3\u0dd2\u0daf\u0dca\u0db0 \u0db8 \u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0dc3\u0dd6\u0dbb\u0dca\u0dbd\u0dba \u0db6\u0dbd\u0dba\u0dca\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb \u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba \u0d8b\u0db8\u0daf\u0dc3\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0d9a\u0db8 \u0d9a \u0dc0\u0dd4\u0dab\u0dd4 \u0dca\u0dd4\u0daf\u0dca\u200d\u0dbb, \u0dd4\u0da9\u0dcf \u0dc4\u0dcf \u0db8 \u0db0\u0dba \u0db4\u0d9a \u0db8 \u0dcf\u0dab \u0d9a\u0dbb\u0dca\u0dbd\u0db8 \u0dcf\u0db1\u0dca\u0dad\u200d\u0d9a\u0dd4\u0dc0 \u0db1\u0dca\u0dad\u0da7 \u0db6\u0dbb\u0db4\u200d \u0d85\u0dd2\u0dad\u0dd2\u0dba\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0db8 \u0dbd\u0dcf \u0dc3\u0dd6\u0dbb\u0dca\u0dbd\u0dba \u0db6\u0dbd\u0dba\u0dca\u0dad\u0dd2\u0dba\u0da7 \u0db8\u0dba\u0dcf\u0db8\u0dd4 \u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dcf\u0dab\u0dba \u0dc3\u0dc4\u0db8\u0dd4\u0dd2\u0db1\u0dca\u0dad\u0db8 \u0d85\u0dc0\u0db0\u0dbb\u0dca\u0dbd\u0dba \u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dca3\n\n\u0d92 \u0dcf\u0db8\u0dda\u0db8 \u0d9a\u0db6\u0dd4\u0db8 \u0db1\u0dca\u0dad\u0dbd\u0dcf 3909 \u0db1\u0db8\u0d9a\u0dcf\u0da7 \u0db4\u0dd4\u0db1\u0dbb\u0dca\u0dbd \u0db1\u0db1\u0dd3\u0dba \u0db6\u0dbd\u0dba\u0dca\u0dad\u0dd2\u0dba - renewable energy - \u0dc3\u0dd2\u0dba\u0dba\u0da7 79 \u0d89\u0dbd\u0dca\u0d9a\u0dba \u0d9a\u0dbb\u0dcf \u0db8\u0dd2\u0db1 \u0dba\u0dd1\u0db8 \u0da7 \u0d92\u0d9a \u0dc3\u0dd4 \u0da7 LNG\u0db8\u0d9a \u0dc3\u0dd4\u0dc5\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0dcf3 \u0d9a\u200d\u0db8\u0d9a\u0dcf\u0da7 LNG \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db4\u0dd4\u0db1\u0dbb\u0dca\u0dbd \u0db1\u0db1\u0dd3\u0dba \u0db6\u0dbd\u0dba\u0dca\u0dad\u0dd2\u0dba\u0daf? \u0db4\u0dd4\u0db1\u0dbb\u0dca\u0dbd \u0db1\u0db1\u0dd3\u0dba \u0db6\u0dbd\u0dba\u0dca\u0dad\u0dd2\u0dba\u0da7 LNG \u0db6\u0dbd\u0dba\u0dca\u0dad\u0dd2\u0dba\u0db8\u0d9a \u0dc3\u0dd4\u0dc5\u0dd4 \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0dcf3 \u0d85\u0db4\u0dd2 \u0db4\u0dd2 \u0d9a\u0dd2\u0db1\u0dca\u0dad\u0db1 \u0dcf, \u0dd2\u0dbd\u0dca\u0dad \u0d85\u0d9f\u0dd4\u0dd4\u0dc0 \u0d9a\u0dca\u0d9a \u0dc3\u0d82\u0dc3\u0db1\u0dca\u0dad\u0daf\u0db1\u0dba \u0d9a \u0dcf\u0db8 LNG \u0db6\u0dbd\u0dba\u0dca\u0dad\u0dd2\u0dba \u0dd4 \u0d9a\u0db1\u0dca\u0dad \u0dc3\u0dd2\u0daf\u0dd4 \u0db1 \u0d9a\u0dcf\u0db6\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0db8\u0db8 \u0db6\u0da0 \u0db1\u0dba \u0d85\u0dca\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf3 \u0db1\u0db8\u0dd4\u0db8\u0d9a, LNG \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db4\u0dd4\u0db1\u0dbb\u0dca\u0dbd \u0db1\u0db1\u0dd3\u0dba \u0db6\u0dbd\u0dba\u0dca\u0dad\u0dd2\u0dba \u0db8\u0db1\u0dcf\u0db8 \u0dba\u0dd23 \u0d92\u0db8\u0d9a\u0db1\u0dd4\u0db8\u0d9a \u0dc3\u0dbd\u0dca\u0dad\u0dc6\u0dbb\u0dca\u0dbd \u0dc0\u0dd2\u0db8\u0db8 \u0db6\u0da0 \u0db1\u0dba \u0dc3\u0dd4\u0dc5\u0dd4 \u0db4\u0d9a \u0dc3\u0dbb\u0dba\u0da7 \u0d85\u0dc4\u0dd2\u200d\u0d9a\u0dbb \u200d \u0db8\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0daf\u0dcf\u0db8 \u0dba\u0db1\u0dca\u0dad \u0dbb\u0dd0\u0dc3\u0dca \u0dc3\u0dd2\u0daf\u0dca\u0db0 \u0db8 \u0db1 \u0dcf3 \u0dd2\u0dd4\u0dc0 \u0dc3\u0db8 \u0dad\u0dd2\u0dd4\u0db8 \u0db1\u0dd2, \u0d85 \u0dc3\u0dcf\u0db1 \u0dba\u0db8\u0dba\u0db1\u0dca\u0dad \u0db8 \u0db8 \u0d9a\u0db6\u0dd4\u0db8 \u0dcf\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0d9a\u0db8 \u0d9a\u0dad\u0dd2\u0dba\u0dd2, LNG \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db4\u0da7\u0db1\u0dca\u0dad \u0dd2\u0db8\u0d9a \u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2, - \u0d8b\u0daf\u0dcf\u0dc4\u0dbb\u0dab\u0dba\u0dca \u0dc4\u0d9a\u0da7\u0dd2\u0dba\u0da7 \u0dba\u0dd4\u0dd2\u0daf\u0db1\u0dc0\u0dd2 - \u0d85\u0daf \u0db8 \u0db1\u0dd4\u0dd4\u0dc0 LNG \u0db8 \u0dbd\u0dcf \u0db1\u0d9a\u0dc4\u0d9a \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0d9a3 \u0d92 \u0db8\u0db8 \u0dcf\u0d9a\u0daf, \u0d92\u0d9a\u0da7 \u0d85 \u0dba\u0dba FSRU \u0d9a\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0d9a\u0db8 \u0d9a \u0db8\u0db1\u0dcf\u0dd3\u0db8 \u0dd4 LNG \u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0d9a\u0db8 \u0d9a \u0db8 \u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0d89\u0db1\u0dca\u0dad\u0db0\u0db1 \u0db6\u0dbd\u0dcf\u0dd2\u0dcf\u0dbb, \u0da9\u0dd3\u0dc3\u0dbd\u0dca\u0dad \u0db6\u0dbd\u0dcf\u0dd2\u0dcf\u0dbb3 \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dc0\u0dd2\u0db8\u0dba\u0dca\u0dc2\u0db8\u0dba\u0db1\u0dca\u0dad\u0db8 \u0db8 \u0db8 \u0d85\u0db8 \u0dcf\u200d\u0dba \u0dbb\u0dba\u0dcf\u0db8\u0dda \u0d85 \u0db0\u0dcf\u0db1\u0dba \u0db8\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0d9a\u0db8 \u0d9a\u0dad\u0dd2\u0dba\u0dd2, \u0db4\u0dd4\u0db1\u0dbb\u0dca\u0dbd \u0db1\u0db1\u0dd3\u0dba \u0db6\u0dbd\u0dba\u0dca\u0dad\u0dd2\u0dba \u0db4\u0dd4\u0db8\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db1\u0d9a\u0dad\u0dd2 \u0dc3\u0dd6\u0dbb\u0dca\u0dbd\u0dba \u0db6\u0dbd\u0dba\u0dca\u0dad\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb \u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0da73 \u0d85\u0daf \u0db1\u0db8\u0d9a\u0dcf\u0da7 \u0dba \u0dc3\u0dcf\u0dba\u0d9a\u0dba\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dba\u0dcf\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dcf\u0dab\u0dba\u0dca \u0d85\u0dd2\u0dad\u0dd2\u0dba\u0da7 \u0db4\u0db8\u0d9a \u0db8 \u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0dcf3 \u0d9a\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0d9a\u0dd4\u0dc0\u0dab\u0dcf\u0d9a\u0dbb\u0dbd\u0dcf \u0d92 \u0d85\u0dba\u0da7 \u0db8\u0dd2 \u0db4\u0dd4 \u0d92 \u0db1\u0dd2\u0dba\u0dca\u0da0\u0dd2\u200d \u0db8\u0dd4\u0daf\u0dbd \u0dbd\u0db6\u0dcf \u0da2\u0dbd\u0dcf, \u0d92 \u0d85\u0dba \u0d85\u0dc0\u0db0\u0dbb\u0dca\u0dbd\u0dba \u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db1\u0d9a\u0dad\u0dd2 , \u0d92 \u0d85\u0dba \u0dc3\u0dd6\u0dbb\u0dca\u0dbd\u0dba \u0db6\u0dbd\u0dba\u0dca\u0dad\u0dd2 \u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 \u0d8b\u0db8\u0daf\u0dc3\u0dcf \u0dc0\u0db0\u0dbb\u0dca\u0dbd\u0dba \u0db8\u0d9a \u0d9a\u0dbb\u0db1 \u0dbb\u0dcf \u0dba \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0db8\u0d9a\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0db8\u0dba\u0dcf\u0db8\u0dd4 \u0db8 \u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8 \u0db8 \u0d89\u0dbd\u0dca\u0dad\u0dbd\u0dd3\u0db8 \u0dca \u0d9a\u0dbb\u0db1 \u0dcf3"
