    "chunk_text": "\u0ddd\u0db8\u0ddd\u0dca\u200d\u0dca\u0dc2\u0d9a\u0dcf\u0dd0\u0dc0\u0dad\u0dd2\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0d9a\u0ddd:\u0db4\u0db4\u0d9a\u0db1\u0daf\u0db8\u0dba\u0d9a\u0dbb\u0dba \u0d9a\u0d85\u0dba\u0dad\u0dca\u0d9a\u0dc0\u0db1\u0d9a\u0dc0\u0dd2\u0dc2\u0dba\u0dca \u0d9a\u0d85\u0dca \u0dc0\u0d9a\u0dc3\u0dcf\u0dc0\u0ddd\u0dba \u0db0\u0db1\u0dba\u0d9a\u0dc0\u0dd3\u0d9a\u0dad\u0dd2\u0ddd\u0dcf\u0db1\u0dc0\u0daf.\u0d9a\n\n\u0d92\u0d9a\u0d85\u0dca \u0dc0\u0d9a\u0ddd\u0dcf\u0dbb\u0d9a\u0dcf\u0dd0\u0dc0\u0dad\u0dd2\u0d9a\u0d9a\u0db1\u0daf\u0d9c\u0dbb\u0dd2\u0db4\u0d9a\u0dc3\u0dcf\u0dc0\u0dc0\u0d9c\u0db0\u0db1,\u0d9a\u0d89\u0daf\u0dd2\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u0d9a\u0dc3\u0dcf\u0dc4\u0d9a\u0dd2\u0dba\u0dc0\u0daf\u0dc3\u0dcf\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0dba\u0d9a\u0dd2\u0dbb\u0dba\u0db1\u0d9a\u0db1\u0daf\u0db8\u0dba,\u0d9a:\u0dd0\u0dca \u0d9a\u0dd2\u0dba\u0dc0\u0daf\u0dc3\u0dcf,\u0d9a\u0d89\u0daf\u0dd2\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u0d9a\u0dc3\u0dcf\u0dc4\u0d9a\u0da2\u0db6\u0dc3\u0dcf\u0dda\u0dcf\u0daf:\u0db1\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0dba\u0d9a\u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0d9a\u0ddd\u0dc0\u0db1\u0dc3\u0dcf\u0db1\u0d9a-\u0d9a\u0dc3\u0dcf\u0dc0\u0ddd\u0dba \u0db0\u0db1\u0dba\u0d9a-\u0d9a\u0ddd\u0dc0\u0db1\u0dc0\u0daf.\u0d9a\n\n3. \u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0dc0\u0db6\u0d9a\u0dc0\u0dd2\u0dc2\u0dba\u0dca \u0d9a\u0dc3\u0dcf\u0dc0\u0ddd\u0dba \u0db0\u0db1\u0dba\u0d9a\u0dc0\u0dd3\u0db8\u0d9a\n\n\u0dcf\u0dc4\u0dca\u200d\u0d9a\u0dcf\u0dc5\u0db8\u0dd4\u0d9a\u0dad\u0dd3\u0dbb\u0dd4\u0ddd\u0daf\u0d9a:\u0dd0\u0dca\u0dc2\u0ddd\u0dc0\u0db1\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0d9a\u0dba \u0ddd\u0dad\u0dca\u0d9a\u0ddd\u0db8\u0ddd\u0dca\u200d\u0dca\u0dc2\u0d9a\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dad\u0dca\u0db8\u0db4\u0d9a\u0dc0\u0dd6\u0d9a\u0dc0\u0dd2\u0dc2\u0dba\u0dba\u0dca \u0d9a\u0dba\u0d9a\u0dcf\u0dba\u0dca\u0dc2\u0d9a\u0ddd:\u0dc0\u0db1\u0d9a\u0dad\u0dd3\u0dbb\u0dd4\u0ddd\u0daf\u0d9a:\u0dd0\u0dca\u0dc2\u0ddd\u0dc0\u0db1\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0d9a\u0dba \u0dca\u200d \u0d9a\u0dcf\u0dc0\u0dbb\u0daf\u0d9a\u0dad\u0dd2\u0ddd\u0dcf\u0db1\u0dc0\u0daf.\u0d9a\n\n\u0dcf\u0dc5\u0db8\u0dd4\u0dc0\u0dd0\u0dd2\u0dba\u0d9a\u0dad\u0dd3\u0dbb\u0dd4\u0ddd\u0daf\u0d9a:\u0dd0\u0db1 \u0d9a\u0dad\u0dd2\u0ddd\u0dcf\u0db1\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0dba\u0d9a\u0dc0\u0db1\u0d9a\u0db1\u0daf\u0d9c\u0dbb\u0dd2\u0db4\u0d9a\u0dc3\u0dcf\u0dc0\u0dc0\u0d9c\u0db0\u0db1,\u0d9a\u0d89\u0daf\u0dd2\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u0d9a\u0dc3\u0dcf\u0dc4\u0d9a\u0dd2\u0dba\u0dc0\u0daf\u0dc3\u0dcf\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0dba\u0d9a\u0dad\u0dd2\u0ddd\u0dcf\u0db1\u0dc0\u0daf.\u0d9a\u0ddd:\u0dc0\u0dd0\u0dd2\u0dba\u0d9a\u0dad\u0dd3\u0dbb\u0dd4\u0ddd\u0daf\u0d9a\u0dad\u0dd2\u0ddd\u0dcf\u0dca \u0ddd\u0dca \u0d9a\u0d9c\u0dd0\u0dc3\u0dcf\u0da7\u0dca\u0d9a\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dba \u0d9a\u0d85\u0dca \u0dc0\u0d9a\u0dc3\u0dd2\u0dd4\u0db1\u0d9a\u0dc0\u0dd6\u0d9a\u0dc3\u0dcf\u0dc0\u0ddd\u0dba \u0db0\u0db1\u0dba\u0dba\u0dd2.\u0d9a\u0d92\u0d9a\u0d85\u0dca \u0dc0\u0d9a\u0dbb\u0db8\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0ddd\u0dba\u0dca \u0d9a\u0db1\u0daf\u0d9c\u0dbb\u0dd2\u0db4\u0d9a\u0dc3\u0dcf\u0dc0\u0dc0\u0d9c\u0db0\u0db1\u0d9a\u0dc0\u0dd2\u0dc2\u0dba\u0d9a\u0d89\u0dc0\u0dad\u0dca\u0d9a\u0db4\u0dbb\u0db1\u0dc0\u0daf.\u0d9a\n\n\u0d8a\u0dc5\u0dd9 ,\u0d9a\u0db4\u0dca\u200d\u0dbb\u0dc0\u0daf\u0dc4\u0db1,\u0d9a\u0db8\u0dc4\u0daf\u0db8\u0daf\u0d9c\u0d9c,\u0d9a\u0dc0\u0dbb\u0daf\u0dba\u0d9a\u0dc3\u0dcf\u0dc4\u0d9a\u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca\u0d9a\u0d9c\u0dd4\u0dc0\u0dca \u0d9a\u0ddd\u0dc3\u0dcf\u0dda\u0dc0\u0daf\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0ddd\u0dba\u0dca \u0d9a\u0d9a\u0dc0\u0dbb\u0daf\u0dba\u0d9a\u0dc3\u0dcf\u0dc4\u0d9a\u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca\u0d9a\u0d9c\u0dd4\u0dc0\u0dca \u0d9a\u0ddd\u0dc3\u0dcf\u0dda\u0dc0\u0daf\u0d9a\u0dc0\u0dd2\u0dc2\u0dba\u0d9a\u0d89\u0dc0\u0dad\u0dca\u0d9a\u0ddd\u0dc0\u0db1\u0dc0\u0daf\u0d9a\u0dc0\u0daf\u0ddd \u0db8,\u0d9a\u0d9a\u0db1\u0daf\u0d9c\u0dbb\u0dd2\u0db4\u0d9a\u0dc3\u0dcf\u0dc0\u0dc0\u0d9c\u0db0\u0db1\u0d9a\u0dc0\u0dd2\u0dc2\u0dba\u0d9a\u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dad\u0dca\u0d9a\u0ddd\u0dc0\u0db1\u0dc0\u0daf.\u0d9a\n\n4. \u0ddd:\u0dcf\u0daf\u0d9c\u0dca\u200d\u0ddd\u0dda\u0dca \u0dad\u0dd4\u0db8,\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0d9a\u0dba \u0ddd\u0dad\u0dca\u0d9a\u0dc0\u0d9c\u0db1\u0dca\u0db4\u0dbb\u0dab\u0dba\u0d9a\u0dc0\u0dd3\u0db8\u0d9a\u0d9a\n\n\u0ddd:\u0dcf\u0daf\u0d9c\u0dca\u200d\u0ddd\u0dda\u0dca \u0dad\u0dd4\u0db8\u0d9a\u0dd2\u0dbb\u0dd2\u0dc0\u0dcf\u0dba\u0dca\u0dc2\u0d9a\u0d92\u0dc0\u0daf\u0ddd\u0dda\u0d9a\u0dc0\u0dd2\u0dc2\u0dba\u0d9a\u0dcf\u0dae\u0dba\u0d9a\u0ddd\u0db8\u0ddd\u0dca\u200d\u0dca\u0dc2\u0d9a\u0dcf\u0dd0\u0dc0\u0dd3\u0db8\u0d9a\u0d87\u0dad\u0dd2\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0d9a\u0ddd\u0dc0\u0dca \u0dc0 \u0d9a\u0ddd\u0dc0\u0db1\u0dad\u0dca\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0d9a\u0dba \u0ddd\u0dad\u0dca\u0d9a\u0dc0\u0d9c\u0db1\u0dca\u0db4\u0dbb\u0dab\u0dba\u0d9a\u0d9a\u0db4\u0dbb\u0d9a\u0dad\u0dd2\u0ddd\u0dcf\u0db1\u0dc0\u0daf.\n\n\u0d92\u0d9a\u0d85\u0dca \u0dc0,\u0d9a\u0dc0\u0dd0\u0dba\u0d9a\u0dba \u0d9c\u0dc2\u0d9a336\u0d9a-\u0d9a\u0ddd\u0dc0\u0dc5\u0db3\u0d9a\u0db1\u0daf\u0dc0\u0dd2\u0db4\u0d9a\u0ddd\u0dbd\u0dca\u0db4\u0dda\u0d9a\u0db4\u0daf\u0d9c\u0dba\u0daf\u0db6\u0dba.\u0d9a\u0dbb\u0dba\u0d9a\u0db4\u0dbd\u0dd2\u0dca \u0d9a\u0dcf\u0dd0\u0dc0\u0dad\u0dd2\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0dba\u0d9a\u0dca\u200d\u0db8\u0dba\u0dd2\u0d9a\u0db4\u0dca\u200d\u0dbb\u0dc0\u0daf\u0dc4\u0db1,\u0d9a\u0db8\u0dc4\u0daf\u0db8\u0daf\u0d9c\u0d9c,\u0d9a\u0dc0\u0dbb\u0daf\u0dba\u0d9a\u0dc3\u0dcf\u0dc4\u0d9a\u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca\u0d9a\u0d9c\u0dd4\u0dc0\u0dca \u0d9a\u0ddd\u0dc3\u0dcf\u0dda\u0dc0\u0daf\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0dba.\u0d9a\u0dbb\u0dba\u0d9a\u0d85\u0dd4\u0db8\u0dad\u0dca\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0dba\u0d9a\u0dc0\u0db1\u0d9a\u0dc0\u0dbb\u0daf\u0dba\u0d9a\u0dc3\u0dcf\u0dc4\u0d9a\u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca\u0d9a\u0d9c\u0dd4\u0dc0\u0dca \u0d9a\u0ddd\u0dc3\u0dcf\u0dda\u0dc0\u0daf\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0dba \u0d9a\u0db8\u0daf\u0dbb\u0dd4\u0d9a\u0ddd\u0dc0\u0db1\u0dc0\u0daf.\u0d9a\n\n\u0d8a\u0dc5\u0dd9 ,\u0d9a\u0dc0\u0dd0\u0dba\u0d9a\u0dba \u0d9c\u0dc2\u0d9a311\u0d9a-\u0d9a\u0da2\u0daf\u0dad\u0dd2\u0db4\u0d9a\u0ddd\u0dcf\u0dde\u0dad\u0dd2\u0db4\u0d9a\u0dc3\u0dcf\u0dd0\u0db6\u0dc3\u0dd4\u0dda\u0d9a\u0ddd:\u0dcf\u0daf\u0d9c\u0dca\u200d\u0ddd\u0dda\u0dca \u0dad\u0dd4\u0db8\u0dc0.\u0d9a\u0dbb\u0dba\u0d9a\u0d9a\u0dca \u0d9a\u0ddd\u0dcf\u0dbb\u0d9a\u0dcf\u0dd0\u0dc0\u0dad\u0dd4\u0db8\u0ddd\u0dab\u0dca\u0d9a\u0db1\u0daf\u0d9c\u0dbb\u0dd2\u0db4\u0d9a\u0dc3\u0dcf\u0dc0\u0dc0\u0d9c\u0db0\u0db1,\u0d9a\u0d89\u0daf\u0dd2\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u0d9a\u0dc3\u0dcf\u0dc4\u0d9a\u0dd2\u0dba\u0dc0\u0daf\u0dc3\u0dcf\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0dba\u0d9a\u0dba \u0dca\u200d .\u0d9a\u0db1\u0dc0\u0d9a\u0ddd\u0dc0\u0db1\u0dc3\u0dcf\u0db1\u0dc0\u0dd3\u0db8\u0d9a\u0d85\u0dca \u0dc0\u0d9a\u0dbb\u0dba\u0d9a\u0db4\u0dca\u200d\u0dbb\u0dc0\u0daf\u0dc4\u0db1,\u0d9a\u0db8\u0dc4\u0daf\u0db8\u0daf\u0d9c\u0d9c\u0d9a\u0dc3\u0dcf\u0dc4\u0d9a\u0db1\u0daf\u0d9c\u0dbb\u0dd2\u0db4\u0d9a\u0dc3\u0dcf\u0dc0\u0dc0\u0d9c\u0db0\u0db1\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0dba\u0d9a\u0dba \u0dca\u200d \u0d9a\u0dc0\u0dd0\u0ddd \u0db1\u0dc0\u0daf.\u0d9a\n\n\u0d8a\u0dc5\u0dd9 ,\u0d9a\u0dc0\u0dd0\u0dba\u0d9a\u0dba \u0d9c\u0dc2\u0d9a320\u0d9a-\u0d9a\u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca\u0d9a\u0d86\u0dbb\u0dca\u0dc2\u0dc2\u0db4\u0d9a\u0ddd:\u0dcf\u0daf\u0d9c\u0dca\u200d\u0ddd\u0dda\u0dca \u0dad\u0dd4\u0db8\u0dc0.\u0d9a\u0dbb\u0dba\u0d9a\u0d9a\u0dca \u0d9a\u0ddd\u0dcf\u0dbb\u0d9a\u0dcf\u0dd0\u0dc0\u0dad\u0dd4\u0db8\u0ddd\u0dab\u0dca\u0d9a\u0d86\u0dbb\u0dca\u0dc2\u0dc2\u0db4\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0dba\u0d9a\u0dba \u0dca\u200d .\u0d9a\u0dbb\u0dba\u0d9a\u0db8\u0dc4\u0da2\u0db1\u0d9a\u0d86\u0dbb\u0dca\u0dc2\u0dc2\u0db4\u0d9a\u0dc4\u0daf\u0d9a\u0dcf\u0daf\u0d9c\u0dbd\u0dd2\u0ddd\u0dda\u0dca \u0dad\u0dd4\u0db8\u0d9a\u0db4 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0dba \u0d9a\u0db8\u0daf\u0dbb\u0dd4\u0d9a\u0ddd\u0dc0\u0db1\u0dc0\u0daf.\u0d9a\n\n\u0dc0\u0dd0\u0dba\u0d9a\u0dba \u0d9c\u0dc2\u0d9a337\u0d9a-\u0d9a\u0d9a\u0dd4\u0dbb\u0dd4\u0db3\u0dd4\u0d9a\u0dc3\u0dcf\u0dc0\u0dc0\u0d9c\u0db0\u0db1\u0d9a\u0ddd:\u0dcf\u0daf\u0d9c\u0dca\u200d\u0ddd\u0dda\u0dca \u0dad\u0dd4\u0db8\u0dc0.\u0d9a\u0d9a\u0dbb\u0dba\u0d9a\u0ddd\u0dcf\u0dbb\u0d9a\u0dcf\u0dd0\u0dc0\u0dad\u0dd4\u0db8\u0ddd\u0dab\u0dca\u0d9a\u0dc0\u0dd0\u0dc0\u0dd2\u0dbd\u0dd2\u0d9a\u0dc3\u0dcf\u0dc4\u0d9a\u0db4\u0dca\u200d\u0dbb\u0da2\u0daf\u0d9a\u0dba\u0da7\u0dd2\u0dca\u200d\u0db6\u0d9a\u0dcf\u0dc4\u0dc3\u0dd4\u0db4\u0dda\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0dba\u0d9a\u0dba \u0dca\u200d .\u0d9a\u0dbb\u0dba\u0d9a\u0db4\u0dd2\u0dd2\u0dc0\u0db4\u0d9c\u0db8,\u0d9a\u0dcf\u0dc1\u0dd4\u0d9a\u0dc3\u0dcf\u0dda\u0dcf\u0dad\u0dca,\u0d9a\u0d89\u0da9\u0dda\u0d9a\u0dc3\u0dcf\u0dc4\u0d9a\u0dc0\u0daf\u0dbb\u0dd2\u0db8\u0daf\u0d9c\u0d9c\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0dba \u0d9a\u0d9a\u0dba \u0dca\u200d \u0d9a\u0dc0\u0dd0\u0ddd \u0db1\u0dc0\u0daf.\n\n2721 2722\n\n\u0dcf\u0daf\u0d9c\u0dbd\u0dd2\u0ddd\u0dda\u0dca \u0dad\u0dd4\u0db8\u0dc0\n\n5. \u0dbb\u0daf\u0da2\u0dba\u0d9a\u0d86\u0dba\u0dca\u200d\u0db1\u0d9a\u0ddd\u0dc0\u0db1\u0dc3\u0dcf\u0db1\u0dc0\u0dd3\u0db8.\n\n\u0ddd\u0db8\u0db8\u0d9a\u0d9c\u0dd0\u0dc3\u0dcf\u0da7\u0dca\u0d9a\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a\u0d85\u0dca \u0dc0\u0d9a\u0ddd\u0dc0\u0db1\u0dad\u0dca\u0d9a\u0d85\u0db8\u0daf\u0dca\u200d\u0dba\u0daf\u0dc0\u0dba\u0d9a\u0ddd\u0dc0\u0dca\u200d\u0d9a\u0dcf\u0dc0\u0dbb\u0daf\u0d9a\u0d87\u0dad\u0dd2\u0d9a\u0d86\u0dba\u0dca\u200d\u0db1\u0d9a\u0db6\u0dd0\u0dba\u0dd2\u0dc3\u0dcf\u0db1\u0dad\u0dd4\u0db8\u0dc0\u0d9a\u0d87\u0db8\u0dd4\u0dd4\u0db8\u0d9a01\u0d9a\u0d9a\u0db8\u0d9f\u0dd2\u0dca \u0d9a\u0d9a:\u0dca\u0dc2\u0dc0\u0daf\u0d9a\u0dad\u0dd2\u0ddd\u0dcf\u0db1\u0dc0\u0daf.\u0d9a\u0d9a"
