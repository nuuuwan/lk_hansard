ba \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8 \u0dc0\u0dcf\u0dad\u0db8\u0dd0 \u0dd0\u0db1\u0dd2\u0dd2\u0dba\u0db1\u0dca \u0dbb\u0dc0\u0dad\u0dd3.\n\n2. \u0daf\u0dd2\u0dc0 \u0dd2 \u0db8\u0db1\u0dca \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0dc4\u0dcf \u0dbb\u0dc5\u0dcf\u0dad\u0dca \u0dbb\u0dcf\u0dc3\u0dca \u0dc0\u0dbd \u0d86\u0dd0\u0dd2\u0dba\u0d9a \u0dc0\u0dd2\u0dc2\u0dba\u0db1\u0dca \u0d89\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0dda \u0dbd\u0dad\u0dca \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0db8 \u0dc4\u0dd2\u0d9f\u0dda\u0dcf\u0dc0 \u0db8 \u0dc0\u0d9f \u0dc4\u0dbb\u0dc0\u0dcf \u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc0 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \"\u0d86\u0dd0\u0dda \u0dc0\u0dd2\u0dc2\u0dba\u0db1\u0dca \u0d89\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dca\u200d\u0dad\u0db8\u0db8 \u0dc0\u0dcf\u0da0\u0dcf\u0dad\u0db8\u0dba \u0dc3\u0db8 \u0dc0 \u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9c\u0dd4\u0dbb\u0dd4 \u0db8\u0dc3\u0dda\u0dc0\u0db8\u0dda 3-II \u0db8\u0dc1\u0dca\u200d\u0dbb\u0dda\u0dab\u0dd2\u0dba\u0da7 \u0db6\u0db3\u0dc0\u0dcf \u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc0\" \u0dba\u0db1 \u0db8 \u0dc0\u0dd0\u0db8\u0dba\u0db1\u0dca \u0d85\u0dca\u200d\u0dba\u0dcf\u0dbb\u0db1 \u0d85\u0db8 \u0dc0\u0dcf\u0dda\u0dba \u0db8 \u0dc0\u0dcf \u0dc0\u0dd2\u0db1\u0dca\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dbb\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d9a 2017/ED/E/06 \u0dc3\u0dc4 2017.02.28 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0db8 \u0dc0\u0dcf\u0dda\u0dba \u0db8 \u0dc0\u0da9\u0dd4\u0d9a\u0da9\u0dbd \u0dc3\u0d82\u0db8\u0daf\u0dca\u0dba\u0dba\u0da7 \u0d85\u0d82\u0d9a \u0d85\u0db8 \u0dc0\u0dbb/17/0(5)/7(2/007 \u0dc4\u0dcf 2017.05.09 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0db8 \u0dc0\u0dcf\u0dda\u0dba \u0db8 \u0dc0\u0da9\u0dd4\u0d9a\u0da9\u0dbd \u0dad\u0dd3\u0dbb\