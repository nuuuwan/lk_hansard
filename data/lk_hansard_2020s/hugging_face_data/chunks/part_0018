    "chunk_text": "\u0d82\u0db1\u0dd4\u0dd9 \u200d\u0dbb\u0da2\u0dcf \u0dc1\u0d9a\u0dca\u0dad\u0dd2 \u0daf\u0dd2\u0dd2\u0db6\u0dd4\u0dab \u0dd9\u0dd9 \u0dad\u0dd4\u0dba\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dc0\u0dda \u0da2\u0dcf\u0dad\u0dd2 \u0dd9\u0dba\u0dcf\u0db4\u0dcf\u0dba\u0dba \u0dba\u0da7\u0dc0\u0dad\u0dca \u0dcf\u0dd9\u0dda\u0db0 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dd3\u0dba \u0dc3\u0dcf\u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0db1 \u0dd9\u0dd0\u0d9a\u0dc3\u0da7\u0dc4\u0db1 \u0daf\u0dd2\u0dd9\u0dba\u0dd2\u0db1 \u0db4\u0dd4\u0dba\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u200d\u0dbb\u0da2\u0dcf\u0dc1\u0d9a\u0dca\u0dad\u0dd2 \u0dd9\u0dd0\u0d9a\u0dc3\u0da7\u0dc4\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc0\u0dd9\u0db1\u0dca \u0dba \u0d87\u0dad\u0dd2 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 \u0db8\u0dd2\u0dd2\u0dba\u0db1 4 0 2 \u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0db1\u0dd9\u0dbd\u0da7 \u0d82\u0db8\u0dad\u0dba\u0dd9 \u0dad\u0dd9\u0dad\u0dca \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 \u0db8\u0dd2\u0dd2\u0dba\u0db1 02 9 2\u0d9a\u0dca \u0dc0\u0dd9\u0db1\u0dca \u0dba\u0db8\u0dd2\u0db1\u0dca \u0db8\u0dd4\u0dc5\u0dd4 \u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0db1 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 \u0db8\u0dd2\u0dd2\u0dba\u0db1 0 222\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dd9\u0dcf \u0dd9\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc0\u0dba\u0db6\u0da2\u0db1\u0dcf \u0dba\u0db1\u0dd9\u0dcf.\n\n14. \u0dc0\u0dd4 \u0d9a\u0dda\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0db8\u0dda \u0da2\u0dd3\u0dc0\u0db1 \u0dcf\u0dca \u0dca \u0dc0\u0dba \u0db1\u0d9f\u0dcf \u0dc3\u0dd2\u0da7\u0dd4\u0dd3\u0db8\n\n\u0dd9\u0dad\u0dd4 \u0dda \u0dbb\u0dd4\u0dd9\u0db1\u0dca\u0da7 \u0d9a\u0dc0\u0dd4\u0db1\u0dca\u0dc0\u0dda \u0dc0\u0dc3\u0dae\u0dd9\u0dba\u0da7 \u0dc3\u0dbb\u0dd2\u0dbd\u0db1 \u0dc3\u0dcf\u0db0\u0dcf\u0dba\u0dab \u0dc0\u0daf\u0db1\u0dd2 \u0dc0 \u0dad\u0db1\u0dba\u0d9a\u0dca \u0dc4\u0dd2\u0db8\u0dd2 \u0dd2\u0dc3\u0dba \u0dd4\u0dad\u0dad\u0dd4\u0dba \u0dba\u0db1\u0dca\u0db1 \u0d82\u0db4 \u0dba\u0da2\u0dc0\u0d86 \u0dc3\u0dae\u0dcf\u0dcf\u0dd9\u0dba\u0dba\u0dba\u0dd2. -\u0d82\u0dd2\u0dc5 \u0da7 \u0dc3\u0da7\u0db1\u0dca \u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dd9\u0db1\u0dd9\u0dcf \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca. \u0daf\u0dd0\u0db1\u0da7 \u0dc0\u0d9c\u0dd9\u0db1\u0dd4 \u0dbd\u0dd9\u0db1 \u0dc0\u0daf\u0db1\u0dd2 \u0d82\u0dd9\u0db8 \u0dd9\u0dd0\u0da7\u0dd4\u0db4 \u0dd9\u0db1 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 3 2 020 \u0da2\u0db1\u0dd9\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 \u0dd2\u0db1\u0da7 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 2\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dd9\u0dcf \u0dd9\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc0\u0dba\u0db6\u0da2\u0db1\u0dcf \u0dba\u0db1\u0dd9\u0dcf. -\u0db1\u0dad\u0dba \u0dc0\u0dd9\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0dad\u0dd9\u0db8. \u0d91\u0dad\u0dc0 \u0dcf\u0da7 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 3 2 \u0d82\u0dd9\u0db8 \u0dd9\u0dd0\u0da7\u0dd4\u0db4 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 2\u0d9a\u0dca \u0dc0\u0dbd\u0dc3 \u0dbd\u0dd0\u0dc0\u0dd9\u0db1\u0dd9\u0dcf. \u0dad\u0dd9\u0daf \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 2 \u0dd9\u0dd0\u0da7\u0dd4\u0db4\u0da7 \u0d82\u0db8\u0dad\u0dba\u0dd9 \u0dba\u0da2 \u0dba \u0dd2\u0dc3\u0dd2\u0db1\u0db1\u0dca \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd3\u0dc0\u0dda \u0dc0\u0daf\u0db1\u0dd2 \u0daf\u0dd2\u0dbb\u0dd2 \u0da2\u0db8\u0db1\u0dcf\u0dd9\u0d9a\u0dca \u0dc0\u0dbd\u0dc3 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 022\u0d9a\u0dca \u0dc0\u0d9c\u0dd3\u0db8\u0da7 \u0dc0\u0dba\u0db6\u0da2\u0db1\u0dcf \u0dba\u0db1\u0dd9\u0dcf. -\u0dc3\u0db8\u0dcf\u0d9c\u0db8 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 2\u0d9a\u0dca \u0dc0\u0daf\u0db1\u0dd9\u0dcf \u0dba\u0da2\u0dc0\u0dba\u0db1\u0dca \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 022\u0d9a\u0dca \u0dc0\u0daf\u0db1\u0dd9\u0dcf. \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0db8 9 2 \u0dd9\u0dd0\u0da7\u