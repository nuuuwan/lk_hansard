b1\u0bcd\u0bb1\u0bbf\u0baf \u0baa\u0bc6\u0bbe \u0bc6\u0bbe\u0bb3\u0bc1\u0bc8\u0ba9\u0bcd\u0bb1 \u0b92\u0ba9\u0bcd\u0bb1\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb2\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1 \u0ba4\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0bb0\u0bc8\u0bae\u0b9f \u0ba8\u0bc6\u0bbe\u0b9f\u0b95\u0bae\u0bcd [\u0baa: 2309]\n\n\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0baf\u0bcd\u0bb5\u0bc6\u0bbe\u0bb3\u0bb0\u0bcd \u0b85\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0ba4\u0bc1 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0bae\u0b95 [\u0baa: 2309] \u0b85 \u0b9a\u0bc6\u0bbe\u0b99\u0bcd\u0b95 \u0ba8\u0bbf\u0ba4\u0bbf \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bbf\u0ba9\u0bcd \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0bae\u0b95 [\u0baa: 2311]\n\n\u0bb5\u0bbf\u0ba9\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bc6\u0bbe\u0baf\u0bcd\u0bae\u0bc2\u0bb2 \u0bb5\u0bbf\u0bae\u0b9f\u0b95\u0bb3\u0bcd [\u0baa: 2312-2342] \u0ba4\u0ba9\u0bbf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bae\u0bc2\u0bb2 \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe:\n\n\u0bc8\u0ba9\u0bcd\u0ba9\u0bc6\u0bbe\u0bc6\u0bbe\u0bbf\u0bb2\u0bcd \u0ba8\u0bae\u0b9f\u0bae\u0bc1\u0bae\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b89\u0bb2\u0bb0\u0bcd \u0bb5\u0bb2\u0baf\n\n\u0ba8\u0b95 \u0ba8\u0bc0\u0bb0\u0bcd \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bb4\u0bbf\u0bb5\u0b95\u0bb1\u0bcd\u0bb1\u0bb2\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd [\u0baa: 2342] 2025.08.06\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba8\u0ba8\u0bcd\u0ba4\u0ba9 \u0baa\u0ba4\u0bcd\u0bc8\u0b95\u0bc1\u0bc8\u0bc6\u0bbe \u0bb5\u0bc6\u0bbe\u0bb2\u0bcd\n\n\u0bb0\u0b95\u0b9f\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe: \u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u