    "chunk_text": "i. Fellow member of Chartered Institute of Management Accountants -CIMA- UK\n\nii. Fellow member of Association of Chartered Certified Accountants -ACCA- UK\n\niii. Fellow of Certified Practising Accountant - FCPA- Australia.\n\n\u0db6\u0dcf \u0dc4\u0dcf\u0dca \u0dc3\u0dca\u0dad\u0dd4\u0db8\u0dba\u0dda\u0dba\u0dd20\n\n\u0d9c\u0dd4 \u0da0\u0dd4\u0dbb \u0d9c\u0dbd\u0dda\u0db4\u0dad\u0dca\u0daf\u0dca\u200d\u0dad\u0dd2\u0db8 \u0dd9\u0dad\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0ba4\u0bcd\u0ba4\u0bc1\u0bb0 \u0b95\u0bb2\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf) (The Hon. Chathura Galappaththi) \u0d92 \u0d8b\u0db8\u0db1\u0dca\u0dbb\u0dba \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0dca \u0dc0\u0dd4\u0dc0 \u0dc0 \u0dad \u0dca\u0dca \u0db1\u0dd2 \u0dba\u0ddd\u0da2\u0dba \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd\u0dca \u0d85\u0dca\u0dcf\u0dca\u0dba\u0dad\u0dd4\u0db8\u0dca\u0dcf\u0da7 \u0dc3\u0dca\u0dad\u0dd4\u0db8\u0dba\u0dda\u0dc0 \u0dad\u0dca \u0dc0\u0db1\u0dc0\u0dcf0\n\n\u0dda \u0d9a\u0dca \u0d9a\u0dcf\u0dbb\u0dc0\u0dcf \u0daf\u0dca\u200d\u0d9a\u0d9a\u0dca \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0 \u0d91\u0dca \u0dca\u0dca\u0dba\u0dd2, 3\u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba \u0dc3\u0dc4 4\u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba0 \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dbb\u0dda\u0db7\u0d9a \u0dc0\u0dcf\u0dbb\u0dca\u0dca\u0dcf\u0dc0 \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0daf\u0dca \u0daf\u0dca\u200d\u0dc0\u0dc3 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dca\u0dcf \u0d9a\u0dd2\u0dda \u0dda, 202.00.027 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf0 \u0d91\u0dca \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0 \u0dc0\u0dd2\u0dd2\u0db1 \u0dad \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0dc0\u0dcf\u0dbb\u0dca\u0dca\u0dcf\u0dc0\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0dd4\u0dc0 \u0dad \u0daf\u0dd2\u0db1\u0dba \u0d9a\u0dc0\u0daf\u0dca\u200d\u0dcf\u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d87\u0dc4\u0dd4\u0dc0\u0dcf\u0dca \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dca\u0dcf \u0dc5\u0dd2\u0db6\u0db3\u0dad\u0dd4\u0db8\u0dbb\u0dd4 \u0dd4\u0dc0 \u0dad \u0dad, \"\u0d85\u0dc0\u0dc3 \u0dad \u0dc0\u0dcf\u0dbb\u0dca\u0dca\u0dcf\u0dc0 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dd2\u0dbb\u0dd3 \u0dda\u0daf\u0dd3 \u0dc0\u0d9c\u0d9a\u0dd2\u0dc0 \u0dba\u0dd4\u0dad\u0dd4\u0db8\n\n1175 1176\n\n[\u0d9c\u0dbb\u0dd4 \u0dad\u0dd4\u0db8\u0dbb \u0d9c\u0dbd\u0dda\u0db4\u0dd8\u0dad\u0db8\u0db1\u0dba\u0dda \u0dca\u0dc4\u0dca\u0dcf]\n\n2026 \u0da2\u0dd6\u0db1\u0dd2 24\n\n\u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dad \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4 \u0dad\u0daf\u0dca\u200d \u0dba \u0dad\u0db1 \u0db1\u0dd2\u0dba\u0dca \u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dc0 \u0dad \u0dad \u0d85\u0db4\u0dd8\u0dad\u0dbb\u0dcf\u0db0 \u0db4\u0dd8\u0dad\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dc0 \u0daf\u0dca\u200d\u0db4\u0dd8\u0dad\u0dcf\u0dbb\u0dca\u0dca \u0dda \u0dad\u0dad\u0dd4\u0db8 \u0dda \u0db4\u0dd8\u0dad\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dc0 \u0d85\u0dc0\u0dc3 \u0dad \u0dc0\u0dd3\u0db8 \u0dca \u0dad \u0db4\u0dd8\u0dad\u0dc3\u0dd4\u0dc0\" \u0dba\u0dd4\u0dc0 \u0dc0 \u0dad0 \u0db1\u0db8\u0dd4\u0db8\u0db1 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd\u0dca \u0dbb\u0d9c\u0dd4\u0dbd\u0dcf\u0dd2\u0db1 104 (3) \u0dc4\u0dcf (4) \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dc0\u0dbd\u0da7 \u0d85\u0dd4\u0dc0\u0dc0 \u0daf\u0dd2\u0db1 \u0dc4\u0dca\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dbb\u0dda\u0db7\u0d9a \u0dc0\u0dcf\u0dbb\u0dca\u0dca\u0dcf\u0dc0\u0db8\u0db1, \u0dca\u0dcf\u0dc3 \u0dad\u0dd4\u0db8\u0db1\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dca \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0dc0\u0dcf\u0dbb\u0dca\u0dca\u0dcf\u0dc0\u0db8\u0db1 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd8\u0dad\u0db8\u0db1 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dd20 \u0d92\u0d9a \u0dca\u0dca\u0dba\u0dd2 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd\u0dca \u0dbb\u0d9c\u0dd4\u0dbd\u0dcf\u0dd2\u0db1 \u0d85\u0dd4\u0dc0\u0dc0 \u0dba\u0dda \u0db6 \u0dad \u0dad0\n\n\u0d85 \u0db1\u0d9a\u0dca \u0d9a\u0dcf\u0dbb\u0dc0\u0dcf\u0dc0 \u0dca\u0dba\u0dba\u0dd20 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dca\u0dcf \u0dca\u0dcf\u0d9a\u0dca\u0dc2\u0dab\u0dd2\u0d9a \u0dc0\u0dd2\u0dca\u0dc3\u0dd4\u0dda \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0d9a\u0dca \u0d9c\u0dd0\u0db1 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf0 \u0d85\u0dc5\u0dd2 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd\u0dca \u0dbb\u0d9c\u0dd4\u0dbd\u0dcf\u0dd2\u0db1 \u0d91\u0d9a\u0dca\u0d9a \u0dca\u0dca\u0dba\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dbb \u0dad \u0dad0 \u0d91\u0dca\u0dd0\u0db1\u0daf\u0dd3 \u0d85\u0dc5\u0dd2 \u0dc3\u0dcf\u0dca\u0dcf\u0db1\u0dba \u0dba \u0dad quote \u0d9a\u0dbb \u0dad \u0dad \u0db1\u0dd0\u0dc4\u0dd0, \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dbb\u0dda\u0db7\u0d9a \u0dc0\u0dcf\u0dbb\u0dca\u0dca\u0dcf\u0dc0 \u0dc3\u0dc4 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0dc0\u0dcf\u0dbb\u0dca\u0dca\u0dcf\u0dc0 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da70 \u0dc0\u0dd2 \u0dba\u0dca\u0dc2 \u0dba \u0dad \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dbb\u0dda\u0db7\u0d9a \u0dc0\u0dcf\u0dbb\u0dca\u0dca\u0dcf\u0dc0 \u0daf\u0dd3\u0daf\u0dca \u0daf\u0dd2\u0db1\u0dba \u0d9c\u0db8\u0db1\u0dca\u0db8\u0db1 \u0dc3\u0dba\u0dda\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dca \u0daf\u0dd3\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf\u0dbb\u0dc0\u0dcf\u0dc0 \u0dc3\u0dc4 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0dc0\u0dcf\u0dbb\u0dca\u0dca\u0dcf\u0dc0 \u0dca\u0dcf\u0dc3 \u0dad\u0dd4\u0db8\u0db1\u0d9a\u0dca \u0db4\u0dd8\u0dad\u0dd0\u0db1\u0dbd\u0dcf\u0db8\u0db1 \u0dca\u0dc0\u0dca \u0dbd\u0dd0\u0db6\u0dd2\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0db1 \u0dc5\u0dd2\u0db6\u0db3\u0dad\u0dd4\u0db8\u0dbb \u0dca\u0dca\u0dba\u0dd2 \u0dba\u0dda \u0db6 \u0dad \u0dad0 \u0d92 \u0d85\u0dd4\u0dc0\u0dc0 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd\u0dca \u0dbb\u0d9c\u0dd4\u0dbd\u0dcf\u0dd2\u0db1\u0dc0\u0dbd 104 (3) \u0dc4\u0dcf (4) \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf\u0dbb\u0dc0\u0dcf \u0daf\u0dca\u200d\u0d9a \u0d89\u0da7\u0dd4 \u0dc0\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd00\n\n\u0d85 \u0db1\u0d9a\u0dca \u0db4\u0dd8\u0dad\u0dd0\u0db8\u0db1 \u0dca \u0dad, \u0dda \u0d9a\u0dcf\u0dbb\u0dca\u0dba \u0db4\u0dd8\u0dad\u0da7\u0dd2\u0db4\u0dd8\u0dad\u0dcf\u0da7\u0dd2 \u0dbb\u0dd3\u0dba\u0dda 48 \u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba \u0d85\u0dd4\u0dc0\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d9c\u0dc0 \u0dad \u0daf\u0dd3 \u0dda \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dba\u0dcf \u0dc4\u0dc0\u0db8\u0db1 \u0d85\u0dca\u0dcf\u0dca\u0dba \u0dbd\u0dca\u0d9a\u0dda\u0dc0\u0dbb\u0dba\u0dcf \u0dc0\u0dd2\u0dd2\u0db1 \u0dad \u0db6\u0dbb\u0db4\u0dd8\u0dad\u0dca\u0dc5 \u0dbd\u0dc3 \u0dbb\u0dcf\u0da2\u0dba \u0dc0\u0dd2\u0dc2\u0dca\u0dcf \u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0dd2\u0db1\u0dd4\u0dc0 \u0d9a\u0dbb\u0dbd\u0dcf \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf, \u0dda \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf\u0dbb\u0dc0\u0dcf \u0d9a\u0da9\u0daf\u0dca \u0db1\u0dd2\u0dc3\u0dcf0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dbb\u0dda\u0db7\u0d9a \u0dc0\u0dcf\u0dbb\u0dca\u0dca\u0dcf\u0dc0\u0db8\u0db1 \u0d92 \u0dc0\u0dcf \u0dca \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0dc0\u0dcf\u0dbb\u0dca\u0dca\u0dcf\u0dc0\u0db8\u0db1 \u0d92 \u0d85\u0daf\u0dca\u200d\u0dcf\u0dc5 \u0d9a\u0dcf\u0dbd \u0dc3\u0dd3\u0dca\u0dcf \u0dc0 \u0dad\u0dd4\u0db8\u0dc5 \u0daf\u0dd3\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0, \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd\u0dca \u0dbb\u0d9c\u0dd4\u0dbd\u0dcf\u0dd2\u0db1\u0dc0\u0dbd\u0da7 \u0d85\u0dd4\u0dc0\u0d9a\u0dd6\u0dbd\u0dc00 \u0d92\u0d9a \u0db1\u0dd2\u0dc3\u0dcf \u0d94\u0dc4\u0dd4\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0\u0dc0 1992 \u0dca\u0dcf\u0dbb\u0dca\u0dad\u0dd4\u0db8 03\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1\u0dd0\u0dba\u0dda \u0dbb\u0dcf\u0da2\u0dba \u0db4\u0dd8\u0dad\u0dbb\u0dd2\u0db4\u0dd8\u0dad\u0dcf\u0dbd\u0db1 \u0d9a\u0dca\u200d\u0dbb \u0dbd\u0dca\u0d9b 10/92\u0da7 \u0d85\u0dd4\u0dc0\u0d9a\u0dd6\u0dbd\u0dc0 \u0dc0\u0dd2\u0db1\u0dba \u0dad\u0dd3 \u0dad\u0dd4\u0dc0 \u0d9c\u0dca \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dc0\u0db1\u0dc0\u0dcf0 \u0dca\u0dcf\u0d9a\u0daf\u0dca\u200d \u0dca\u0dca \u0d9a\u0dca\u200d\u0dbb \u0dbd\u0dca\u0d9b \u0dc0 \u0db4\u0dd8\u0dad\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dc0\u0dca \u0dba\u0dda \u0db6 \u0dad \u0dad \u0d92 \u0d85\u0daf\u0dca\u200d\u0dcf\u0dc5 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dad\u0da7 \u0d92 \u0d85\u0daf\u0dca\u200d\u0dcf\u0dc5 \u0d9a\u0dcf\u0dbd \u0dc3\u0dd3\u0dca\u0dcf\u0dc0 \u0dad\u0dd4\u0db8\u0dc5\u0daf\u0dd3 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf0"
