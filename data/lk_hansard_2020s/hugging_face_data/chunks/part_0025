    "chunk_text": "\u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0da7\u0dd3.\u0db8\u0dda\u0dd2\u0dda.\u0d92. \u0da2 \u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0d91\u0da0\u0dca\u0da0.\u0d91\u0db1\u0dca\u0dad.\u0da9\u0dd3.\u0d86\u0dbb\u0dca\u0dbd.\u0db6\u0dd3. \u0db1\u0dc1\u0db1\u0dc1 \u0d9a\u0dca\u0d9a\u0dc1\u0dbb \u0db8\u0dc4\u0dad\u0dc1 (\u0d9c\u0da2\u0dba\u0dc2\u0dda\u0db0 \u0dc3\u0dc4\u0d9a\u0dc1\u0dbb \u0db4\u0dc1\u0dbb\u0dca\u0dbd\u0dd2\u0d9c\u0dda\u0db1\u0dca\u0dad\u0dad\u0dd4 \u0dc3\u0db1\u0dca\u0dad\u0db0\u0dc1\u0db1 \u0dd2\u0db8\u0dbd\u0db0\u0dc1\u0db8 \u0dc4\u0dd4)\n\n\u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0d82\u0dc1\u0dba - \u0d91\u0da0\u0dca\u0da0.\u0d91\u0dda.\u0d91\u0dbd\u0dca.\u0d92. \u0dc3\u0db8\u0dbb\u0db1\u0dc1 \u0d9a \u0db8\u0dc4\u0dad\u0dc1 (\u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc1\u0dc4\u0db1 \u0dd2\u0db8\u0dbd\u0db0\u0dc1\u0dbb\u0dd2); \u0d86\u0dbb\u0dca\u0dbd.\u0dc3\u0dd3. \u0dd4\u0dbb\u0dbd\u0dad\u0dd2\u0dbd\u0d9a \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0da9\u0dd3.\u0d92.\u0d91\u0dda.\n\n\u0d9c\u0dad\u0dcf\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0daf\u0dd0\u0db1\u0d9c\u0dd0\u0db1\u0dd3\u0d9c\u0db8\u0dca \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0d9a\u0d9a\u0dba - \u0d92.\u0d91\u0db1\u0dca\u0dad.\u0da9\u0dd3. \u0d9c\u0dd4\u0dab\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba (\u0dd2\u0db8\u0d9c \u0ddd\u0da2\u0dba \u0db4\u0dca\u200d\u0dbb\u0db0\u0dc1\u0db1 \u0dd2\u0db8\u0dbd\u0db0\u0dc1\u0dbb\u0dd2) ; \u0d91\u0db1\u0dca\u0dad.\u0d91\u0db1\u0dca\u0dad.\n\n\u0d9c\u0dc4\u0da7\u0dca\u0da7\u0dd2\u0d9c\u0dda \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba (\u0dc3\u0dc4\u0d9a\u0dc1\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db0\u0dc1\u0db1 \u0dd2\u0db8\u0dbd\u0db0\u0dc1\u0dbb\u0dd2)\n\nxxiv\n\n\u0d9c\u0da2\u0dba\u0dc2\u0db1\u0dbd \u0dbd \u0dbd \u0d9c\u0dbd\u0dca\u0d9b\u0dca\u200d\u0d9a\u0d9c\u0dba\u0ddd - \u0d91\u0da0\u0dca\u0da0.\u0db4\u0dd3.\u0dc3\u0dd3.\u0d91\u0dc3\u0dda. \u0dad\u0dd2\u0dbd\u0d9a\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dc1, \u0d86\u0dbb\u0dca\u0dbd.\u0db4\u0dd3. \u0dbb\u0dd2\u0d9a \u0dbb\u0dc1\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0dc4\u0dad\u0dc1 \u0dbd \u0dbd \u0d9c\u0dbd\u0dca\u0d9b\u0dca\u200d\u0d9a\u0d9c\u0dba\u0ddd - \u0db4\u0dd3.\u0da9\u0dd3.\u0d91\u0db1\u0dca\u0dad.\u0db4\u0dd3. \u0dd4\u0dbb\u0db8\u0dc1\u0dbb\u0dd2 \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0d91\u0dc3\u0dda. \u0dbb\u0da2\u0dd2\u0dd2\u0db8\u0db8\u0dc1\u0dbd\u0dc1 \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0da9\u0dd3.\u0db8\u0dda\u0dd2\u0dda.\u0db6\u0dd3.\u0d92. \u0da2 \u0db1\u0dc1\u0dae \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0db4\u0dd3.\u0db8\u0dda\u0dd2\u0dda.\u0dc3\u0dd3.\n\n\u0dca\u200d\u0dbb\u0dd2 \u0daf\u0dbb\u0dca\u0dbd\u0db1\u0db1\u0dd3 \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba \u0db6\u0d82\u0d9c\u0dbd\u0dcf \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dd4 - \u0da9\u0dd3.\u0d91\u0dda.\u0db4\u0dd3. \u0db1\u0dad\u0dd4\u0d9c\u0d9a\u0ddd\u0dbb\u0dbd \u0db8\u0dc4\u0dad\u0dc1, \u0dc0\u0dba\u0dd2.\u0d91\u0dda. \u0da0\u0dd2\u0dba\u0db1\u0dca\u0dad\u0daf \u0db8\u0dc4\u0dad\u0dc1 \u0d9c\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1 \u0db7\u0dcf\u0dbb\u0d9a\u0dbb\u0dd4 - \u0d8a.\u0d9c\u0d9a\u0dca.\u0d9c\u0d9a\u0dca.\u0db4\u0dd3. \u0dd4\u0dc2\u0dda\u0db4\u0dbd\u0dc1\u0dbd\u0dca \u0db8\u0dc4\u0dad\u0dc1 \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0d9a/\u0db6\u0dd2\u0dbd\u0dca \u0dbd\u0dd2\u0db4\u0dd2\u0d9a\u0dbb\u0dd4 - \u0d91\u0da0\u0dca\u0da0.\u0d91\u0dda.\u0d91\u0db1\u0dca\u0dad.\u0da7\u0dd3.\u0da7\u0dd3. \u0d9c\u0dc4\u0dda\u0dbb\u0dad\u0dca \u0db8\u0dc4\u0dad\u0dc1 \u0d9c\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1 \u0dc3\u0dd0\u0d9a\u0dd4\u0d9a\u0db8\u0dca \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0d9a - \u0d91\u0dc3\u0dda.\u0dd3. \u0d9c\u0db3\u0dc1\u0d9a\u0dbd\u0d9c\u0dc0\u0dbd \u0db8\u0dc4\u0dad\u0dc1\n\n\u0dc4\u0dd0\u0db1\u0dca\u0dc3\u0dcf\u0da9\u0dca \u0d9c\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0dc4\u0dd0\u0db1\u0dca\u0dc3\u0dcf\u0da9\u0dca \u0dc3\u0d82\u0dc3\u0db1\u0d9a\u0dcf\u0dbb\u0d9a - \u0dc3\u0dd3.\u0d91\u0db1\u0dca\u0dad. \u0d9c\u0dbd\u0dc1\u0dd4\u0dbb\u0d9c\u0d9a\u0dc1\u0da9\u0dd2\u0d9a\u0dc1\u0dbb \u0daf \u0dd2\u0dbd\u0dca\u0dc0\u0dc1 \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dba \u0dc4\u0dd0\u0db1\u0dca\u0dc3\u0dcf\u0da9\u0dca \u0dc3\u0d82\u0dc3\u0db1\u0d9a\u0dcf\u0dbb\u0d9a\u0dc0\u0dbb\u0dd4 - \u0d91\u0dc3\u0dda.\u0d9c\u0d9a\u0dca.\u0d91\u0dda.\u0db8\u0dda\u0dd2\u0dda. \u0dc3\u0db8\u0dbb\u0d9c\u0dc3\u0dda\u0d9a\u0dbb \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0d91\u0dda.\u0d91\u0dc3\u0dda.\u0d91\u0dda. \u0dd2\u0db1\u0dca\u0dad\u0db1\u0dc1\u0dc3\u0dda \u0db8\u0dc4\u0dad\u0dc1, \u0d91\u0da0\u0dca\u0da0.\u0da2\u0dd3. \u0db4\u0dd6\u0da2\u0dd2\u0d9a\u0dc1\n\n\u0d9c\u0db8\u0d9c\u0db1\u0dc0\u0dd2 \u0dc3\u0dc4\u0d9a\u0dcf\u0dbb \u0dc4\u0dd0\u0db1\u0dca\u0dc3\u0dcf\u0da9\u0dca \u0dc3\u0d82\u0dc3\u0db1\u0d9a\u0dcf\u0dbb\u0d9a\u0dc0\u0dbb\u0dd4 - \u0d86\u0dbb\u0dca\u0dbd.\u0da9\u0dd3.\u0db4\u0dd3. \u0dc3\u0dd4\u0da2\u0dd3\u0dc0\u0db1\u0dd3 \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0da9\u0dd3.\u0db4\u0dd3.\u0d92.\u0d91\u0db1\u0dca\u0dad.\u0d91\u0db1\u0dca\u0dad. \u0dd3\u0dbb\u0dd2\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0d9c\u0d9a\u0dca.\u0da2\u0dd3.\u0d91\u0db1\u0dca\u0dad.\u0db4\u0dd3. \u0dbb\u0d9c\u0db3\u0dbd\u0dca\n\n\u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0d9c\u0d9a\u0dca.\u0da9\u0dd3.\u0d91\u0dc3\u0dda. \u0dd4\u0dbb\u0dbd\u0dbb\u0dad\u0dca\u0db1 \u0db1\u0dbd\u0dd4\u0dad\u0dca\u0d9c\u0db8\u0d9c\u0dda \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0d9c\u0dd3\u0dad\u0dad\u0dc1\u0dd2\u0db8 \u0dc0\u0dbb\u0dca\u0dbd\u0dab\u0dc3\u0dd6\u0dbb\u0dd2 \u0d9c\u0db8\u0d9c\u0db1\u0dc0\u0dd2 , \u0d91\u0da0\u0dca\u0da0.\u0da2\u0dd3. \u0dbd\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0db8\u0dc4\u0dad\u0dc1, \u0db4\u0dd3.\u0d91\u0dda.\u0da2\u0dd3.\u0db4\u0dd3. \u0dca\u200d\u0dbb\u0dd2 \u0d82\u0d9c\u0dd2\u0d9a\u0dc1 \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0d91\u0dda.\u0db1\u0dba\u0dd2.\u0d91\u0dc3\u0dda. \u0dd2\u0db8\u0dc2\u0dda\u0dbb\u0dc1 \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0d8a.\u0d91\u0da0\u0dca\u0da0.\u0db8\u0dda\u0dd2\u0dda. \u0d89\u0dbb\u0d82\u0d9c\u0dd2\u0d9a\u0dc1 \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0da7\u0dd3.\u0da7\u0dd3. \u0dd4\u0dbb\u0db8\u0dc1\u0db1\u0dc1 \u0d9a \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba \u0d9c\u0da2\u0dba\u0dc2\u0db1\u0dbd \u0dc4\u0dd0\u0db1\u0dca\u0dc3\u0dcf\u0da9\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0d9a\u0dbb\u0dd4\u0d9c\u0dc0\u0ddd - \u0db4\u0dd3.\u0dd3.\u0da7\u0dd3.\u0dd3. \u0d9c\u0db8\u0d9c\u0dda \u0db1\u0dbb\u0dd4\u0db8\u0dc1\u0db1\u0dca\u0dbb \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0db8\u0dda\u0dd2\u0dda.\u0d92.\u0da9\u0dd3.\u0db4\u0dd3. \u0dc0\u0dd2\u0d9c\u0dda\u0d9c\u0d9a\u0dc1\u0da9\u0dcf\u0db8 \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0d91\u0dc3\u0dda.\u0d91\u0dda.\u0d92.\n\n\u0dd4\u0dbb\u0db8\u0dd4\u0daf\u0dd2\u0db1\u0dd3 \u0d9c\u0db8\u0d9c\u0db1\u0dc0\u0dd2 , \u0d91\u0dd2\u0dda.\u0d91\u0da0\u0dca\u0da0.\u0d92.\u0d91\u0db1\u0dca\u0dad. \u0dd2\u0dbd\u0dca\u0dc0\u0dc1 \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0d91\u0da0\u0dca\u0da0.\u0d86\u0dbb\u0dca\u0dbd.\u0db4\u0dd3. \u0da0\u0dc1\u0db1\u0dca\u0dad\u0daf\u0db1\u0dd3 \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0dc3\u0dd3.\u0d86\u0dbb\u0dca\u0dbd. \u0d9a\u0dbb\u0dd4\u0dab\u0dc1\u0dbb\u0dad\u0dca\u0db1 \u0d9c\u0db8\u0d9c\u0db1\u0dc0\u0dd2 , \u0d91\u0dda.\u0da7\u0dd3.\u0d92.\u0da9\u0dd3. \u0dd2\u0dba\u0dbd\u0dca\u0dbd\u0d9c\u0dc3\u0dda\u0dad\u0dd0\u0db1\u0dca\u0dad\u0db1 \u0db8\u0dc4\u0dad\u0dc1, \u0d91\u0da0\u0dca\u0da0.\u0da2\u0dd3. \u0db8\u0d82\u0da2\u0dd4\u0dbd \u0db8\u0dc4\u0dad\u0dc1, \u0da9\u0dd3.\u0d86\u0dbb\u0dca\u0dbd.\u0da9\u0dd3. \u0d9c\u0dc4\u0da7\u0dca\u0da7\u0dd2\u0d9c\u0dda \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba , \u0d91\u0dda.\u0d91\u0dda.\u0dc3\u0dd3.\u0d9c\u0d9a\u0dca. \u0db8\u0dc1\u0dbb\u0dd2\u0d82\u0dc4 \u0d9c\u0db8\u0d9c\u0db1\u0dc0\u0dd2 , \u0d91\u0dda.\u0db4\u0dd3. \u0dd