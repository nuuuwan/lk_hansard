    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7, \u0dc0\u0da0\u0dca\u0dad\u0db1\u0dcf\u0dca\u0dd2\u0db4\u0dad\u0dc0 \u0d85\u0dc3\u0dcf\u0dad\u0dba \u0dc0\u0dad\u0dcf\u0dbb\u0dad\u0dd4\u0db1\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db1 \u0dc0\u0dc4\u0ddd \u0dc3\u0dd2\u0dd4 \u0d9a\u0dbb\u0dc0\u0db1, \u0d91\u0dc0\u0dc3\u0dcf\u0dda\u0dad\u0dca \u0db1\u0dd0\u0dad\u0dc0\u0dc4\u0dcf\u0dad\u0dca \u0daf\u0dad\u0dca\u0dad \u0d91\u0dca\u0dbb\u0dd0\u0dc3\u0dcf\u0dda \u0d9a\u0dbb\u0db1 \u0db1\u0dc4 \u0dc0\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0dda \u0dc0\u0dbd\u0dba\u0dbd\u0dad\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dba\u0dcf \u0dd2\u0db4\u0dc0\u0dbb\u0ddd\u0db0\u0dba \u0daf\u0dd0\u0dca\u0dc0\u0dd3\u0db1 \u0dc0\u0dc4\u0ddd \u0dc0\u0dcf\u0db0\u0dcf \u0d9a\u0dbb\u0db1 \u0dc0\u0dc4\u0ddd \u0dbb\u0dd3\u0dad\u0dd2 \u0dc0\u0daf\u0d9a\u0db1 \u0dba\u0da7\u0dc0\u0dad\u0dca \u0dc0\u0dbb\u0daf\u0dca \u0dc3\u0dd2\u0dd4 \u0d9a\u0dbb \u0d87\u0dad\u0dca\u0db1\u0db8\u0dca, \u0d89\u0dbd\u0dca \u0daf\u0db8\u0dca \u0d9a\u0dc5 \u0dc0\u0dad\u0dcf\u0dbb\u0dad\u0dd4\u0db1\u0dca \u0d91\u0db1 \u0dd4\u0dda\u0dd4\u0dbd\u0dba\u0dcf \u0dd2\u0db4\u0dc3\u0dd2\u0dca \u0dbd\u0dc0\u0dcf \u0dc0\u0daf\u0db1 \u0dc0\u0dad\u0dca \u0d85\u0dc0\u0dc3\u0dcf\u0dda\u0dae\u0dcf\u0dc0\u0dc0\u0ddd\u0dd2\u0d9a\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db1\u0dc4 \u0dc0\u0dd0\u0d82\u0d9a\u0dd4\u0dc0 \u0dd2\u0db4\u0dc3\u0dd2\u0dca \u0d91\u0db1 \u0dc0\u0dbb\u0daf \u0d85\u0d9b\u0dab\u0dca\u0da9\u0dc0 \u0dc0\u0dbb\u0daf\u0dca \u0dc0\u0dbd\u0dc3\u0dcf \u0dc3\u0dcf\u0dbd\u0d9a\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd3\u0db1 \u0db1\u0dd3\u0dad\u0dba\u0db1\u0dd4\u0dd6\u0dbd\u0dbd \u0dc0\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0dca \u0d91\u0dc4\u0dd2 \u0dc3\u0dcf \u0dc4\u0dca \u0dc0\u0dc0\u0db1\u0dc0\u0dcf. \u0dc0\u0db8\u0dca\u0d9a \u0d85\u0d9b\u0dab\u0dca\u0da9\u0dc0 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0d91\u0dba \u0dc0\u0dbb\u0daf\u0dca \u0dc0\u0dbd\u0dc3\u0dcf \u0dc3\u0dcf\u0dbd\u0d9a\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dc0\u0db1\u0dc0\u0dcf.\n\n\u0dd4\u0db1\u0dca \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db1\u0db1\u0dd2, \u0dc0\u0dbb\u0daf\u0da7 \u0daf\u0dac\u0dd4\u0dc0\u0db8\u0dca, \u0dc0\u0dbb\u0daf \u0dc3\u0dcf\u0db1\u0dae\u0dba\u0d9a\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0dc4\u0dd0\u0d9a\u0dd2 \u0d9a\u0d9a\u0dcf\u0dbb\u0dba\u0dca 2023 \u0d85\u0d82\u0d9a 16 \u0daf\u0dbb\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db1\u0dc4 \u0dc0\u0dd0\u0d82\u0d9a\u0dd4 \u0db4\u0db1\u0dad \u0dba\u0da7\u0dc0\u0dad\u0dca \u0dbb\u0dd3\u0dad\u0dd2 \u0dad\u0dd4\u0db6\u0db3\u0dca \u0dc3\u0dcf \u0dc4\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dc0\u0db1\u0dc0\u0dcf. \u0d85\u0daf \u0daf\u0dc0\u0dc0\u0dc3\u0dcf\u0dda \u0d85\u0dc5\u0dd2 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db1\u0dc4 \u0dc0\u0dd0\u0d82\u0d9a\u0dd4 \u0db4\u0db1\u0dad \u0dba\u0da7\u0dc0\u0dad\u0dca \u0dbb\u0dd3\u0dad\u0dd2 \u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dc0 \u0dc3\u0dcf\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf\u0dc0\u0da7 \u0dd4\u0dca\u0db1\u0dc0\u0dcf. \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db1\u0dc4 \u0dc0\u0dd0\u0d82\u0d9a\u0dd4\u0dc0 \u0d9a\u0dd2\u0dba\u0dca\u0dc0\u0dca, \u0dbb\u0dc0\u0da7\u0dca \u0d9a\u0dbb\u0dca\u0dd2\u0d9a\u0dba \u0dc4\u0dc3\u0dd4\u0db1\u0dca\u0dc0\u0db1, \u0dc0\u0dd0\u0d82\u0d9a\u0dd4\u0d9a\u0db1\u0dca\u0dc0\u0dca\u0dc0\u0d86 \u0dc0\u0dd0\u0d82\u0d9a\u0dd4\u0dc0 \u0dc0\u0dbd\u0dc3\u0dcf \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1,\n\n\u0d9a\u0dbb\u0dca\u0dd2\u0d9a\u0dc0\u0dda \u0d89\u0dad\u0dcf\u0db1 \u0dc3\u0dcf\u0d82\u0dc0\u0dda\u0daf\u0dd3 \u0dad\u0dd0\u0dca \u0dc0\u0dc3\u0dcf\u0dcf\u0dba\u0dcf \u0dc0\u0dbd\u0db8\u0dd2\u0dca \u0d91\u0dc4\u0dd2 \u0d85\u0daf\u0dcf\u0dc5 \u0dc0\u0dc0\u0db1\u0dc3\u0dcf\u0dda\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db1\u0da7 \u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dca\u0dc0\u0dba - leadership - \u0dd4\u0dca\u0db1\u0dcf \u0d9a\u0dba\u0dad\u0db1\u0dba. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf\u0dcf \u0db1\u0dc4 \u0dc0\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0dda \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0dc4\u0dc3\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db1 \u0dc3\u0dcf \u0dc4\u0dcf \u0dba\u0db8\u0dca\u0d9a\u0dd2\u0dc3\u0dd2 \u0db1\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca\u0dc0\u0dd3\u0db1\u0dca \u0d9a\u0dbb\u0dca\u0db1\u0da7 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc4\u0dd2\u0dad\u0dbd \u0dcf \u0dad\u0db1\u0dba\u0dd2 2023 \u0d85\u0d82\u0d9a 16 \u0daf\u0dbb\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db1\u0dc4 \u0dc0\u0dd0\u0d82\u0d9a\u0dd4 \u0db4\u0db1\u0dad \u0dba\u0da7\u0dc0\u0dad\u0dca \u0dc0\u0db1 \u0dbb\u0dd3\u0dad\u0dd2 \u0dc0\u0db8\u0dca \u0dd2\u0db4\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0dc5\u0dd2 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dc0\u0dca\u0dc0\u0dca."
  },
