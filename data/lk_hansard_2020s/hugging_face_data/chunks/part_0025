a\u0db1\u0dcf\u0d9a\u0dbb\u0dab \u0d9c\u0dc3\u0dca\u0dc0\u0dcf \u0dbb\u0d9a\u0dca\u0dc2\u0dab (\u0db4\u0dd4\u0daf\u0dca) \u0dc3\u0db8 \u0dba\u0dcf\u0d9c\u0db8 \u0dba\n\n5 100%\n\n\u0d9a\u0dd0\u0db1\u0dca\u0dc0\u0dd2\u0dbd\u0dca \u0d9c\u0dc4\u0ddd\u0dbd\u0dca\u0dd2\u0db1\u0dca\u0dda\u0dc3\u0dca (\u0db4\u0dd4\u0daf\u0dca) \u0dc3\u0db8 \u0dba\u0dcf\u0d9c\u0db8 \u0dba\n\n- -\n\n2025\n\n\u0d9c\u0dc3\u0dca\u0dc0\u0d9a \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0 (\u0dc3\u0dca \u0dbb \u0d9c\u0d9a\u0dcf\u0db1\u0dca\u0dbb\u0dcf\u0dad\u0dca \u0dd1\u0daf\u0db1\u0db8 \u0dba \u0db8 \u0dba\u0dad\u0dca\u200d)\n\n2,707\n\n\u0d9a\u0dcf\u0dbb\u0dca\u0db8 \u0db8 \u0dba\u0dab\u0dca\u0da9\u0dbd (\u0db4\u0dd2\u0dd2\u0d9a\u0dc0\u0dd0\u0db8 \u0dbb\u0dd4\u0db4\u0dd2\u0db8\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0db1\u0db8\u0db1)\n\n9,103\n\n2025 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d89\u0db1\u0dca\u0dbb\u0dc0\u0dbb\u0db1\u0dca\u0dc3\u0dca \u0d9c\u0d9a\u0ddd\u0dd1\u0d9c\u0dbb\u0dca\u0dc2\u0db1\u0dca \u0dbd\u0dba\u0dd2\u0dc6\u0dca\n\n\u0dd2\u0db1\u0db8\u0dd2 \u0da9\u0dca (SLICLL)\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d89\u0db1\u0dca\u0dbb\u0dc0\u0dbb\u0db1\u0dca\u0dc3\u0dca \u0d9c\u0d9a\u0ddd\u0dd1\u0d9c\u0dbb\u0dca\u0dc2\u0db1\u0dca \u0d9c\u0da2\u0db1\u0dbb\u0dbd\u0dca\n\n\u0dd2\u0db1\u0db8\u0dd2 \u0da9\u0dca - SLICGL\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d89\u0db1\u0dca\u0dbb\u0dc0\u0dbb\u0db1\u0dca\u0dc3\u0dca \u0d9c\u0d9a\u0ddd\u0dd1\u0d9c\u0dbb\u0dca\u0dc2\u0db1\u0dca \u0dd2\u0db1\u0db8\u0dd2 \u0da9\u0dca - SLIC\n\n\u0d86\u0d9c\u0db8\u0ddd\u0da2\u0db1 \u0dca\u200d\u0dbb\u0dd2\u0dbd\u0dcf\u0db7\u0db8 ())\n\n11% 9% 14%\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 * \u0db4\u0dd4\u0dca\u0db4\u0dad\u0d9a\u0dcf\u0dbd\u0db4\u0dda \u0dad\u0db6\u0dcf \u0d87\u0dad. * \u0ba8\u0bc2\u0ba9\u0bbf\u0bae\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bae\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0b