    "chunk_text": "\u0db8\u0dd3\u0da7 \u0d85\u0dc0\u0dd4\u0db1\u0dca\u0dd4 6\u0d9a\u0da7, 7\u0d9a\u0da7 \u0d9a\u0dd2\u0dca \u0dc0\u0db8\u0dca \u0dc3\u0dd3\u0db1\u0dcf\u0dc0 \u0dad\u0dd2\u0db6\u0dd4\u0dc0\u0dab\u0dca \u0db1\u0dca\u0dc5\u0dd2\u0dba\u0dbd\u0dca \u0db4\u0dca\u0daf\u0dc4\u0dc0\u0dc3\u0dcf\u0dda. \u0daf\u0dd0\u0dca \u0d91\u0dba \u0db1\u0dca\u0dc5\u0dd2\u0dba\u0dbd\u0dca 17,000\u0d9a\u0da7 \u0dc0\u0da9\u0dcf \u0dc0\u0dd0\u0da9\u0dd2\u0dc0\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dc0\u0db1\u0dc0\u0dcf. \u0dc0\u0db8\u0dca \u0dbb\u0dc0\u0da7\u0dca \u0dbd\u0dca\u0dc2 50\u0d9a\u0da7 \u0d85\u0db0\u0dd2\u0d9a \u0dc5\u0dd2\u0dbb\u0dd2\u0dc3\u0dcf\u0dca \u0d9a\u0dca\u0db1 \u0db1\u0dd0\u0dad\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0da7 -\u0dd4 \u0dbb\u0dca\u0db7\u0dd2\u0dca\u0dc2 \u0dba\u0d9a\u0da7 - \u0d87\u0daf \u0dc0\u0dd0\u0dc0\u0da7\u0db1\u0dc0\u0dcf\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dc0\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd2 \u0d91\u0d9a\u0dd2\u0dca \u0d91\u0d9a \u0dd4\u0dad\u0dca\u0dc0\u0dad\u0dcf\u0dad\u0dca \u0dc4\u0dd4\u0dc0\u0dcf \u0daf\u0dca\u0dc0\u0db1\u0dc0\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0db1\u0da7 \u0d92\u0dc0\u0dcf \u0d94\u0dca\u0dc0\u0d9a\u0ddd\u0db1 \u0d9a\u0dd2\u0dba\u0dc0\u0dca\u0db1 \u0d9a\u0dcf\u0dbd\u0dba \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0dc0\u0dcf\u0dc0\u0d86 news \u0dd2\u0db4\u0dba\u0dcf\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dab\u0dba\u0dca \u0dad\u0dd2\u0dc0\u0dc0\u0db1\u0dc0\u0dcf.\n\n\u0d9a\u0dab\u0dca\u0dd4\u0dc0\u0dda \u0d85\u0dba \u0d9a\u0dba\u0dd2\u0dba \u0dd4\u0dd0\u0dc4\u0dd4\u0dc0\u0dcf \u0dc3\u0dcf\u0dc4\u0dbd\u0dca \u0dc0\u0dd4\u0dca\u0dc0\u0dca\u0dc0\u0dca \u0db1\u0dd0\u0dc4\u0dd0\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc4\u0dd0\u0dc0\u0dd0\u0dba\u0dd2, \u0dc0\u0db1\u0da7\u0dca\u200d\u0dbb\u0dd2\u0dca \u0dc0\u0da7\u0dcf\u0dca 150,000\u0d9a\u0da7 \u0d85\u0db0\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dab\u0dba\u0dca \u0dc0\u0dd4\u0db1\u0dd0\u0dbd\u0dca\u0dbd\u0dcf \u0daf\u0dd0\u0dca \u0dc3\u0dcf\u0dc4\u0dbd\u0dca \u0dd2\u0db4\u0d9a\u0dd4\u0dab\u0dcf \u0dd4\u0dca\u0db1 \u0dc0\u0dd0\u0db1\u0dca\u0dc0 \u0d89\u0dca\u0db1\u0dc0\u0dcf. \u0db1\u0db1 \u0dba\u0dcf\u0db4\u0db1\u0dba \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dba\u0dc0\u0dda \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0db1\u0dca\u0dca\u0da7 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf, \u0d92 \u0dc0\u0dcf\u0dc0\u0d86\u0db1 \u0dc0\u0db4\u0dcf\u0dc0\u0dc5\u0dcf\u0dca\u0db1\u0db1\u0dca\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dba\u0dc0\u0dda \u0d85\u0dc0\u0db4\u0dca\u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0db1\u0dca\u0dca\u0da7 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf. \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dba\u0dc0\u0dbd \u0dc0\u0dd4\u0dcf\u0dc0\u0dd3\u0dca\u0da7 \u0dc0\u0dd3 \u0dd2\u0db4\u0d9a\u0dd4\u0dab\u0dcf \u0dd4\u0dca\u0db1 \u0dc0\u0dd0\u0dc4\u0dd0. \u0d85\u0dc0\u0dd4\u0db1\u0dca\u0dd4 \u0dc0\u0daf\u0d9a\u0d9a\u0da7 \u0d9a\u0dd2\u0dca \u0d9a\u0dd2\u0dda\u0dc0\u0dda, \"\u0dc0\u0db8\u0dca \u0dc3\u0dcf\u0dc4\u0dbd\u0dca \u0dc0\u0dd4\u0dca\u0dc0\u0dca\u0dc0\u0dca \u0d85\u0dca\u0dad\u0dd2\u0db1 \u0dc0\u0dad\u0dcf\u0dc0\u0da7\" \u0d9a\u0dd2\u0dba\u0dcf\u0dba\u0dd2. \u0dbd\u0dda\u0da2\u0dcf \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0d9a\u0db4\u0dc3\u0dd4 \u0dc3\u0dcf\u0dc4\u0dbd\u0dca \u0dc0\u0dd4\u0dca\u0dc0\u0db1\u0dc0\u0dcf. \u0d85\u0dc0\u0dd4\u0db1\u0dca\u0dd4 \u0dc0\u0daf\u0d9a\u0d9a\u0da7 \u0d9a\u0dd2\u0dca \u0d9a\u0dd2\u0dda\u0dc0\u0dcf, \"\u0d85\u0dca\u0dad\u0dd2\u0db1 \u0dc0\u0dad\u0dcf\u0dc0\u0da7\u0dba\u0dd2 \u0dc0\u0db8\u0dca \u0dc3\u0dcf\u0dc4\u0dbd\u0dca \u0dc0\u0dd4\u0dca\u0dc0\u0dca\u0dc0\u0dca\" \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc0\u0db8\u0dca \u0dbb\u0da7 \u0dc3\u0dcf\u0dc4\u0dbd\u0dca\u0dc0\u0dd2\u0dca \u0dc3\u0dcf\u0dda\u0dc0\u0d82\u0dc0\u0db4\u0ddd \u0dad \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0dc0\u0dd4\u0dcf \u0d9a\u0dbb\u0dca\u0dc0\u0dca \u0dc0\u0db1\u0dc0\u0dc4\u0db1\u0dba\u0dd2, \u0dc0\u0db1\u0dc0\u0dc4\u0db1\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \"\u0dc0\u0da7\u0ddd\u0dca\" \u0dd4 \u0dca\u0db1\u0dcf. \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0d9a\u0dd8 \u0d9a\u0dbb\u0dca\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dc4\u0dd0\u0da7\u0dd2 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf, \u0d9a\u0da7\u0dd2\u0dca \u0dc0\u0dad\u0dbd \u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0db1\u0dc0\u0dcf \u0dc0\u0dc0\u0d86. \u0dc0\u0db8\u0dca \u0d9a\u0da7\u0dca\u0da7\u0dd2\u0dba \u0d9a\u0dae\u0dcf \u0d9a\u0dc0\u0dc5\u0dda, \u0d9a\u0dd8 \u0d9a\u0dbb\u0dca\u0db1\u0dcf\u0dca\u0dad\u0dba \u0daf\u0dd2\u0dba\u0dd4\u0dd4 \u0d9a\u0dbb\u0dbd\u0dcf, \u0db1\u0dad\u0dca\u0dc3\u0dcf\u0dba \u0d9a\u0dbb\u0dca\u0db1\u0dcf\u0dca\u0dad\u0dba \u0daf\u0dd2\u0dba\u0dd4\u0dd4 \u0d9a\u0dbb\u0dbd\u0dcf, \u0dc3\u0dcf\u0dbd\u0dca\u0dd2\u0dba\u0dd4\u0dbb\u0dd2\u0dca, \u0d9c\u0dca\u200d\u0dbb\u0dd0\u0dc6\u0dba\u0dd2\u0da7\u0dca, \u0dc0\u0dad\u0ddd\u0dbb\u0dd2\u0dba\u0db8\u0dca \u0dc0\u0dd0\u0db1\u0dd2 \u0dc3\u0dd2\u0dba \u0daf \u0dc0\u0dda\u0dc0\u0dbd\u0dca \u0daf\u0dd2\u0dba\u0dd4\u0dd4 \u0d9a\u0dc5\u0dcf\u0da7 \u0db4\u0dc3\u0dcf\u0dda\u0dc0\u0dc3\u0dcf\u0dda \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0dad\u0dca \u0dd4\u0dc0\u0dcf\u0dba\u0dd2 \u0dc0\u0dcf\u0dc0\u0d86 \u0dc0\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0dba\u0dd2. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0d92 \u0d91\u0d9a\u0d9a\u0da7\u0dc0\u0dad\u0dca \u0d85\u0dad \u0dad\u0dd2\u0dba\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0. \u0d9a\u0dd2\u0dc3\u0dd2\u0db1 \u0dc3\u0dcf\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba\u0dca \u0dc0\u0dc0\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0.\n\n\u0dd4\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dba\u0ddd\u0da2\u0dba \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db1\u0db1\u0dd2, \u0d85\u0dba \u0dc0\u0dd0\u0dc0\u0dba\u0dca \u0db1\u0dca\u0dc5\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 1,300\u0dca \u0dc0\u0dc0\u0dca \u0d9a\u0dc5\u0dcf. \u0dd4\u0db1\u0dca \u0dc4\u0dbb\u0dca\u0dc2 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db1\u0dcf \u0dc0\u0dc4\u0dcf\u0dbd\u0dca\u0db1\u0dca \u0dc0\u0dc0\u0db1\u0dc0\u0dcf, \u0dd2\u0db4\u0dba\u0daf\u0db8\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dc0\u0dca\u0dc0\u0dca \u0d92\u0dc0\u0d9a\u0dca \u0db1\u0dca\u0dc5\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 550\u0dba\u0dd2. \u0db1\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf, \"I did not know that\" \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db1\u0dca\u0dc5\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 850\u0dca \u0dd2\u0db4\u0dba\u0daf\u0db8\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0. \u0d91\u0dad\u0dc0\u0d9a\u0dcf\u0da7 \u0dc0\u0db8\u0dca \u0dbb\u0dc0\u0da7\u0dca \u0d9a\u0dbb\u0dca\u0dd2\u0d9a\u0dba \u0dd4 \u0dc0\u0dca\u0dc0\u0dca \u0dc0\u0d9a\u0dcf\u0dc0\u0dc4\u0dcf\u0db1\u0daf? \u0d9a\u0dbb\u0dca\u0dd2\u0d9a\u0dba \u0d89\u0dc3\u0dcf\u0dda\u0dc3\u0dcf\u0dbb\u0dc4\u0da7 \u0dba\u0dca\u0dc0\u0dca \u0dc0\u0d9a\u0dcf\u0dc0\u0dc4\u0dcf\u0db1\u0daf?"
  },
