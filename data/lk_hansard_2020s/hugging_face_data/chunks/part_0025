dca \u0dc3\u0dd4\u0dcf\u0dad\u0dcf\u0db0\u0db1\u0dca\u200d \u0dc0\u0dbb\u0dd4\u0dd0\u0da9\u0dad\u0dba\u0db1\u0db1\u0dca \u0dd0\u0dab\u0db1\u0dca\u200d\u0dcf\u0dc0\u0dbb\u0dd4\u0d9a\u0dca\u0daf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0db4\u0dcf\u0dca \u0db8 \u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dc0\u0db6\u0dca\n\n(\u0d86) (i) \u0dad\u0dd1\u0db8 \u0db8\u0dcf\u0dad \u0dc0\u0daf \u0dba \u0dc0\u0dbb\u0dd4\u0dbb\u0d9a\u0dca \u0db4\u0dcf\u0dad\u0dbd\u0dca .\u0da7\u0dd4\u0dc0\u0dbb\u0dd4 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dad\u0db8 \u0db4\u0dcf\u0dad\u0dbd\u0dca \u0dc0\u0db4\u0ddd\u0dc2 \u0dca\u200d\u0dbb\u0dc0\u0dda\u0dba\u0dc0\u0dda \u0db4\u0dcf\u0dad\u0dbd\u0dca \u0dc0\u0db1\u0dca\u200d\u0dcf\u0dba \u0db4\u0db1\u0dca\u200d \u0dc5\u0db8\u0dba\u0dd2\u0db1\u0dca\u0dc0 \u0db1\u0dcf \u0d85\u0dad\u0dbb\u0db8\u0d9f \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dca\u200d\u0dc0\u0dba \u0db4\u0db1\u0dca \u0dd2\u0dd2\u0dc4\u0dd4\u0dab\u0dd4\n\n\u0dd2\u0daf\u0dc3\u0dd4\u0db1\u0dca\u0dc0 \u0dc0\u0dad\u0dcf\u0dbb\u0dd4\u0db1\u0dca \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dab .\u0da7\u0dd4\u0dc0\u0dbb\u0dd4\u0dba \u0dc0\u0dbb\u0dd4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf \u0dc5 \u0dba\u0dd4\u0dd4\u0dc0\u0dbb\u0dd4 \u0d87\u0dad \u0db8\u0dcf\u0dad \u0dd4\u0db1\u0dca\u200d \u0dba \u0dc0\u0dbb\u0dd4\u0dbb\u0d9a\u0dca \u0dc0 \u0dcf \u0d94\u0da8\u0dcf\u0dad \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dca\u200d \u0d85\u0db0\u0dba\u0d9a\u0dca\u0dc2 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dad\u0db8 \u0dc0 \u0dcf \u0d94\u0da8\u0dcf\u0dad\u0dc0\u0dda \u0d8b\u0d9a\u0dca\u0dad \u0dc1\u0dd2\u0dc2\u0dba \u0dc0\u0dad\u0dcf\u0dbb\u0dd4\u0db1\u0dca \u0dbd\u0dcf\u0db4 \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dca\u200d \u0d85\u0db0\u0dba\u0d9a\u0dca\u0dc2\u0dc0\u0dbb\u0dd4\u0dbb\u0dba \u0db4\u0dcf\u0dba\u0daf, \u0dbd\u0dcf\u0db4 \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dca\u200d \u0d85\u0db0\u0dba\u0d9a\u0dca\u0dc2\u0dc0\u0dbb\u0dd4\u0dbb\u0dba \u0db4\u0dcf \u0dc0\u0dd2\u0dd2\u0daf\u0db1\u0dca \u0dad\u0db8 \u0dbd\u0dcf\u0db4\u0dc0\u0dda \u0d8b\u0d9a\u0dca\u0dad \u0dc1\u0dd2\u0dc2\u0dba \u0dc0\u0dad\u0dcf\u0dbb\u0dd4\u0db1\u0dca \u0db4\u0dc5\u0dcf\u0dca \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dca\u200d \u0d85\u0db0\u0dba\u0d9a\u0dca\u0dc2\u0dc0\u0dbb\u0dd4\u0dbb\u0dba \u0db4\u0dcf\u0dba\u0daf \u0dc0\u0dbb\u0dd4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf \u0dc5 \u0dba\u0dd4\u0dd4 \u0dc0\u0dda \u0db4\u0dc5\u0dcf\u0dca \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dca\u200d \u0d85\u0db0\u0dba\u0d9a\u0dca\u0dc2\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc0\u0dd2\u0dd2\u0daf\u0db1\u0dca \u0dad\u0dd1\u0db8 \u0dc0\u0dbb\u0dd4\u0dbb\u0dca\u0dbd\u0dc2\u0dba \u0db4 \u0db8 \u0d85\u0dc0\u0dbb\u0dd4\u0dad\u0dcf\u0db1\u0dca\u200d\u0dba \u0db4 \u0dc0\u0dbb\u0dd4\u0db1\u0dca\u200d\u0dc0\u0dd2\u0dba \u0db4\u0dc5\u0dcf\u0dc0\u0dca \u0db4\u0dcf\u0dad\u0dbd\u0dca \u0dc0\u0db1\u0dca\u200d\u0dcf\u0dba \u0db4\u0db1\u0dca\u200d \u0dc5\u0db8\u0dba\u0dd2, \u0d85\u0dad\u0dbb\u0db8\u0d9f \u0db4\u0dcf\u0dad\u0dbd\u0dca \u0db1\u0dd0\u0dbb \u0dd2\u0dba \u0db4 \u0dc1\u0dd2\u0dc2\u0dba \u0dc0\u0dad\u0dcf\u0dbb\u0dd4\u0db1\u0dca, \u0db4\u0dcf\u0dad\u0dbd\u0dca\u0dd0\u0dad \u0dc5 \u0dc5\u0db8\u0dd4\u0db1\u0dca \u0dad\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0\u0dbb\u0dd4, \u0d92 \u0dad\u0db3\u0db1\u0dcf \u0dd0\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0db4\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0dd0 \u0d87\u0dd4\u0dc5\u0dca \u0dc0\u0dbb\u0dd4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf \u0dad\u0dd0\u0db4\u0dba\u0dd3\u0db8 \u0dc5 \u0dba\u0dd4\u0dd4 \u0dc0\u0dda\n\n\u0d91\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0db4\u0dcf\u0dc0\u0dbb\u0dd4\u0dd2\u0dc0\u0dda \u0d85\u0da9\u0dd4\u0db4\u0dcf\u0da9\u0dd4 \u0dad\u0dd2\u0dc0\u0dcf\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf, \u0dd0\u0db1\u0dca \u0dae\u0dcf\u0db1\u0dca\u200d\u0dcf\u0dba \u0db4 \u0dd4\u0db8\u0db1\u0dd2 \u0d92 \u0db1\u0dd2\u0dad\u0dcf\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0dbb\u0dd2 \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dca\u200d\u0dba \u0db4 \u0da2\u0dd2\u0da7\u0dbd\u0dba\u0dbd\u0dca \u0dbb\u0dab\u0dba \u0db4 \u0dbb\u0dd3\u0db8\u0dc0\u0dda \u0dc0\u0dbb\u0dd4\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0db4\u0d9a\u0dca \u0d86\u0dbb\u0dda\u0db7 \u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dcf\u0db1\u0dca\u0dc0\u0db1\u0dca \u0d92\u0dc0\u0d9a\u0dca \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0dbb\u0dd4\u0dd0\u0db1\u0dd2 phase \u0d91 \u0d85\u0dbb\u0dd2 \u0dc0\u0dda \u0dad\u0dad\u0dd2\u0dc0\u0dda \u0dc0\u0dad\u0db1\u0dca\u200d\u0dc3\u0dd4\u0dbb\u0dcf\u0daf\u0dcf \u0d86\u0dbb\u0dda\u0db7 \u0dc5\u0dcf \u0d92, \u0d9c\u0dd4\u0db1\u0dca\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0db1\u0dca\u0dc0 \u0dc0\u0dad\u0dcf\u0dbb\u0dd4\u0db1\u0dca \u0da2\u0dd2\u0da7\u0dbd\u0dba\u0dbd\u0dca \u0db4\u0dda\u0db0\u0dad\u0dd2\u0dba \u0db4\u0dba \u0d91 \u0dd4 \u0dbb\u0db1\u0dca\u0db1\u0dca\u200d \u0dc0\u0daf\u0dc0\u0dbb\u0dd4\u0dd0\u0db1\u0dd2 phase \u0d91\u0dc0\u0d9a\u0dca\u0daf\u0dd3 \u0daf\u0db1\u0dca\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dc0 \u0dc0\u0dad\u0dcf\u0dbb\u0dd4\u0db1\u0dca\u0dca \u0d91\u0db8 \u0db4\u0dda\u0db0\u0dad\u0dd2\u0dba \u0db4\u0dba \u0d91 \u0dd4 \u0dbb\u0db1\u0dca\u0db1\u0dca\u200d \u0d85\u0dbb\u0dd2 \u0dad\u0dd0\u0dbd\u0dc3\u0dd4\u0dda \u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dcf\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf \u0d91\u0dad\u0dc0 \u0dcf\u0dba \u0d85\u0db4\u0dba \u0dd3\u0dba \u0dc0\u0dbb\u0dd4\u0da9\u0dcf \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0db1\u0dca \u0daf\u0dca \u0dad \u0dbd\u0dcf\u0dcf \u0dd0\u0dd0\u0dd3\u0db8\u0db8\u0dba \u0db1\u0dd0\u0dbb\u0dd3 \u0dc0\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf\n\n(ii) \u0d85\u0daf\u0dcf\u0dc5 \u0dc0\u0db1\u0dca\u200d\u0dcf\u0dc0\u0dda"
