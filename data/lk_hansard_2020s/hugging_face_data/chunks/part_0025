    "chunk_text": "\u0d9a\u0dc0\u0dcf\u0db8 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf\u0db8 \u0dba \u0db8 \u0dba \u0d9c\u0dad\u0dca\u0d9c\u0dbb\u0db1\u0dca\u0d9c\u0db1\u0dca, \u0d91\u0d9c\u0dc4\u0db8 \u0dba \u0db1\u0dc0 \u0d9c\u0d9c\u0ddd\u0d85\u0dcf\u0db7\u0db8 \u0dbb\u0dcf\u0da2\u0dd1\u0d9a\u0dca\u0dc2 \u0dbd\u0dbd\u0db8 \u0d9c\u0d9c\u0d9c\u0db1\u0db1\u0dca\u0db1 \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0dbd\u0dcf \u0dd2\u0d9c\u0dbd\u0db1\u0dca\u0d9c\u0db1\u0dca \u0da2\u0db1\u0dad\u0dca\u200d\u0dcf \u0dc0\u0dd2\u0db8\u0dd4\u0d9a\u0dca\u0dd2 \u0d9c\u0dd1\u0dbb\u0db8\u0dd4\u0d9c\u0dab\u0dca \u0d9a\u0dda\u0da7\u0dd2\u0db8 \u0d9a\u0dd2\u0db8\u0dbd\u0dcf\u0dba\u0dd2. \u0d92 \u0dc0\u0dd2\u0db0\u0dd2\u0db8 \u0dbd\u0dd0\u0dd4\u0dc0\u0dc0\u0dcf\u0db8 \u0dba \u0d92\u0d9a\u0dba\u0dd2 \u0dc4\u0dd2\u0d9c\u0dad\u0dca\u200d\u0db1\u0dca\u0d9c\u0db1\u0dca. \u0d92\u0d9a \u0d8b\u0db7\u0d9c\u0dad\u0dca\u200d\u0ddd\u0d9c\u0d9a\u0ddd\u0da7\u0dd2\u0d9a \u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0db8\u0d9a\u0dca \u0d9c\u0dc0\u0dbd\u0dcf \u0dd2\u0d9c\u0dbd\u0db1\u0dca\u0d9c\u0db1\u0dca. \u0d91\u0db8 \u0dba \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0db8\u0db1\u0dca\u0d9c\u0db1\u0dca, \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0d9a\u0dbb\u0dbd\u0dcf \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dca\u0dc0\u0dcf\u0db0\u0dd3\u0db1 \u0dd1\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0db8\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0db8\u0dbd\u0dcf\u0dba\u0dd2. \u0d9c\u0db8 \u0dba\u0dcf\u0d9a\u0daf \u0d9c\u0dc4\u0dca\u0dad\u0dd4\u0dc0, \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0db8 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0db1\u0dca \u0dc0\u0dd2\u0d9c\u0dba\u0dca\u0dc2\u0da5 \u0dc0\u0dc0\u0daf\u0dba\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dd1\u0dad\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dcf. \u0d92 \u0dd1\u0dad\u0dca \u0d9a\u0dbb \u0dd2\u0d9c\u0dbd\u0db1 \u0d85\u0db8 \u0d9c\u0dad\u0dca\u0d9c\u0dad\u0dca\u200d\u0dcf\u0dad\u0dca, \u0d91\u0d9a\u0dca\u0d9c\u0d9a\u0d9c\u0db1\u0d9a\u0dca \u0da0\u0dd2\u0dad\u0dca\u0dad\u0dca\u200d\u0dcf\u0dc4\u0dd2\u0d9a \u0d85\u0d9c\u0db6\u0dca\u0dbd\u0db1\u0dcf\u0db8\u0d9a \u0db8 \u0dba\u0dd0\u0dd2\u0db1\u0dd2\u0db8. \u0d91\u0dad\u0dd4\u0db8\u0dd2\u0db8\u0d9c\u0dda Facebook account \u0d91\u0d9a \u0dd2\u0dc4\u0dd2\u0db1\u0dca \u0dbd\u0dbd\u0db1\u0dca\u0db1. \u0d9c\u0dc0 \u0dbb\u0d9c\u0dda \u0d89\u0db1\u0dca\u0db1 \u0dc4\u0db8\u0dd4\u0daf\u0dcf \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dd2\u0d9a\u0db1\u0dca \u0d89\u0dad\u0dca\u200d\u0dcf\u0db8 \u0dba \u0dd1\u0dc4\u0dad\u0dca \u0d9c\u0dbd\u0dc3 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1 \u0d9c\u0d9a\u0d9c\u0db1\u0d9a\u0dca. \u0d89\u0dd2\u0db1\u0dca, \u0d92 \u0d85\u0db8\u0d9c\u0d9c\u0db1\u0dca \u0dbd\u0dbd\u0dcf\u0d9c\u0dd1\u0dcf\u0d9c\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4 \u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0daf, \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0db8\u0d9a\u0dca?\n\n\u0d9c\u0dc1\u0dca\u200d\u0dbb\u0dca\u0dc2\u0dca\u0d85\u0dcf\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0d9c\u0dda \u0dad\u0dca\u200d\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dd4\u0dbb\u0dc0\u0db1\u0dca\u0d9c\u0db1\u0dca \u0db1\u0dd0\u0dd2\u0dc0 \u0db8 \u0dba\u0dcf\u0dc3 6\u0d9a\u0dca \u0dd2\u0dc3\u0dca\u0d9c\u0dc3\u0dca \u0dd2\u0db8\u0dcf\u0d9c\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0dc3\u0dba\u0dd2 \u0d92? \u0d92\u0d9a \u0dc3\u0dc0\u0dd6\u0dbb\u0dca\u0dab\u0d9c\u0db8\u0db1\u0dca\u0db8 \u0dba \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0dd1\u0dd2\u0dc0\u0dbb\u0db8\u0dcf\u0d9c\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8 \u0dba. \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dba \u0dc0\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dda 111\u0dc0\u0db1 \u0dc0\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0d85\u0dd4\u0dc0\u0dc0 \u0d91\u0dad\u0dd4\u0db8 \u0dba\u0dcf \u0d9c\u0dc0 \u0dca\u200d\u0dbb\u0dd2\u0db8\u0dcf\u0dc0\u0dd2\u0db1\u0db8 \u0d89\u0dc3\u0dca\u0dc3\u0dbb\u0dc4 \u0d85\u0dbb\u0d9c\u0d9c\u0db1 \u0db8\u0db1\u0dca\u0db1 \u0d95\u0db1\u0db8. \u0dc4\u0dd0\u0dbd\u0dd0\u0dba\u0dd2, \u0d92\u0d9a \u0d9c\u0dc0\u0db1\u0dca\u0d9c\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d9c\u0dc0\u0d9a \u0d9c\u0da0\u0dca\u0dad\u0dca\u200d\u0db1\u0dcf\u0db1\u0dca\u0dc0\u0dd2\u0dad\u0dca\u200d\u0dc0 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dba \u0dc0\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0d8b\u0dbd\u0dca\u0dbd\u0d82\u0d9d\u0db1\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dba\u0d9a\u0dca. \u0d92 \u0db4\u0dd4\u0dbb\u0dda\u0dd1\u0dcf\u0da9\u0dd4\u0dc0\u0dbd \u0d9c\u0dc1\u0dca\u200d\u0dbb\u0dca\u0dc2\u0dca\u0d85\u0dcf\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0dc0\u0dd2\u0db1\u0dd2\u0dba\u0dca\u0da0\u0db8\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dd4, \u0d85\u0db7\u0dd2\u0db8\u0dcf\u0da0\u0db1\u0dcf\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0dc0\u0dd2\u0db1\u0dd2\u0dba\u0dca\u0da0\u0db8\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dd4 \u0dd1\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0d9c\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc3\u0dba\u0dd2, \u0d92 \u0dd1\u0dad\u0dca \u0d9c\u0db1\u0dcf\u0d9a\u0dbb\u0db1\u0dca\u0d9c\u0db1\u0dca? \u0d91\u0d9c\u0dc4\u0db8 \u0dba \u0db1\u0dc0, \u0d8a\u0dc0\u0d9f \u0d91\u0db1\u0dca\u0db1 \u0dd2\u0d9c\u0dbd\u0db1 \u0db1\u0da9\u0dd4 \u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dd2\u0db1\u0db1\u0dca \u0dbd\u0dd0\u0d9c\u0dbd\u0db1 \u0dad\u0dd3\u0db1\u0dca\u0dd4\u0db8\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0daf \u0d9c\u0dc0 \u0d85\u0db8\u0dc0 \u0dd1\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dc4\u0daf\u0db1\u0dca\u0d9c\u0db1\u0dca \u0d9a\u0dd2\u0db8\u0db1 \u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0db8 \u0d85\u0dd1 \u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dcf.\n\n\u0d85\u0daf \u0dba\u0dc2\u0dd3 \u0dc0\u0dd3\u0dbb\u0dc0\u0d82\u0dba \u0db8 \u0dba\u0dd0\u0dd2\u0db1\u0dd2\u0db8\u0dc0 \u0dc3\u0dad\u0dd4\u0dc0 \u0daf\u0db8 \u0dba\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0dba, \u0dd1\u0dcf\u0dc3\u0dca\u0d9a\u0dd4 \u0d89\u0dd2\u0d9a\u0daf\u0dcf \u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0dbd\u0db3 \u0dc0\u0dd2\u0db8 \u0dba\u0dbb\u0dca\u0dba\u0db1 \u0db8 \u0dba\u0dcf\u0dc3 3\u0d9a\u0dd2\u0db1\u0dca \u0d89\u0dc0\u0dbb \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0db8\u0dbd\u0dcf \u0dbd\u0dbd\u0dd1\u0db8\u0dc0 \u0d9a\u0dbb\u0dbd\u0dcf\u0dad\u0dca \u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf, \u0d92 \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0d9c\u0d9a\u0dcf\u0d9c\u0dc4\u0db1\u0dca\u0daf \u0d9c\u0dc0\u0db1\u0dca\u0d9c\u0db1\u0dca \u0d9a\u0dd2\u0db8\u0dbd\u0dcf. \u0d92\u0dc0\u0dcf \u0d9c\u0db1\u0dcf\u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0d9c\u0db1\u0dcf\u0d9c\u0dc0\u0dba\u0dd2. \u0d9c\u0dc0 \u0dc3\u0dd2\u0db8\u0dbd\u0dca\u0dbd \u0dc3\u0dd2\u0daf\u0dca\u0db0 \u0dc0\u0dd4\u0dab\u0dcf \u0dd1\u0dc3\u0dd4\u0dc0\u0daf - \u0d92 \u0d9a\u0dd2\u0db8\u0db1\u0dca\u0d9c\u0db1\u0dca, \u0db8 \u0dba\u0dc4\u0dcf\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0d9c\u0db8\u0db1\u0dca \u0d92 \u0d85\u0db8 \u0dc0\u0dd4\u0dc0\u0db8 \u0dba\u0db1\u0dcf \u0d9a\u0dda\u0da7\u0dd2\u0db8 \u0dc4\u0dd2\u0d9c\u0dbb\u0dca \u0daf\u0dd0\u0dc0\u0db8 \u0dba\u0dcf \u0dd1\u0dc3\u0dd4\u0dc0\u0daf - \u0d92 \u0d85\u0db7\u0dd2\u0db8\u0dcf\u0da0\u0db1\u0dcf\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0dad\u0dca\u200d\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d9c\u0daf\u0db1\u0dca\u0d9c\u0db1\u0dca? \u0d92\u0d9a\u0dba\u0dd2 \u0dd2\u0d9c\u0dbd\u0db1 \u0dc3\u0dd0\u0d9a\u0db8. \u0d9c\u0dc0\u0db1 \u0d91\u0d9a\u0d9a\u0dca \u0d9c\u0db1\u0dcf\u0d9c\u0dc0\u0dba\u0dd2. \u0dc3\u0dba\u0dd2 \u0d9c\u0db8 \u0dba\u0d9c\u0dc4\u0db8 \u0dba \u0db4\u0dd4\u0dbb\u0dda\u0dd1\u0dcf\u0da9\u0dd4 \u0dd2\u0db8\u0dcf\u0d9c\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0d9c\u0db1\u0dca?"
