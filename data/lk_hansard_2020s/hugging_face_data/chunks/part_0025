    "description": "Hansard of 2026-06-11",
    "url_metadata": "https://www.parliament.lk/en/business-of-parliament/hansards",
    "lang": "si-ta-en",
    "url_pdf": "https://www.parliament.lk/uploads/businessdocs/english/23716_english_2026-06-11.pdf",
