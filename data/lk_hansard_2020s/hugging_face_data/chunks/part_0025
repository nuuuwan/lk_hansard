    "chunk_text": "\u0daf\u0dca\u200d\u0dd0 \u0dad \u0dca\u0dca\u0dd0\u0db1\u0daf\u0dd3 Clean Sri Lanka \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0d9c\u0dd0\u0db1 \u0dca\u0dca\u0d9a\u0dca \u0d9a\u0dc5\u0dcf0 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dca \u0dad\u0dbd\u0dcf \u0daf\u0dca\u200d \u0dad\u0db1\u0dc0\u0dcf, Clean Sri Lanka \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dc5\u0dcf\u0da7, \u0d9c \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0daf\u0dca\u200d \u0dc0\u0db1 \u0d9a\u0dcf\u0da7 \u0d9a\u0dcf\u0dc5\u0dd9 \u0da2\u0db1\u0dca\u0dcf\u0dc0 \u0db4\u0dd8\u0dad\u0dba\u0dd2 \u0dad \u0d87\u0dc0\u0dd2\u0daf\u0dd2 \u0dad\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0dca\u0db8\u0db1\u0db8\u0db1\u0dc0\u0dba\u0da7 \u0db4\u0dd8\u0dad\u0db8\u0db1 \u0dc0\u0dbd\u0dcf \u0dba\u0dda \u0db6\u0db1 \u0db6\u0dc00 \u0d91\u0dca \u0d9a\u0dcf\u0da7 \u0d91\u0dca\u0dd0\u0db1 clean \u0d91\u0d9a\u0d9a\u0dca \u0dd2\u0db1\u0daf\u0dca\u0db0 \u0dc0\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd00 \u0db4\u0dd8\u0dad\u0dbb\u0dd2\u0dc3\u0dbb\u0dba \u0dc3\u0dda\u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0dba \u0dad\u0dca \u0d91\u0dca\u0dd0\u0db1 \u0dc0\u0dd2\u0db1\u0dcf\u0dba \u0dc0\u0dbd\u0dcf \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0 \u0d92 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0db4\u0dd8\u0dad\u0dbb\u0dd2\u0dc3\u0dbb\u0dba \u0dc0\u0dd2\u0db1\u0dcf\u0dba \u0dc0\u0daf\u0dca\u0daf\u0dd3 \u0dca\u0dca\u0d9a \u0dca\u0db6\u0dcf \u0d9c\u0dca \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dcf\u0dbb\u0dc0\u0dcf\u0dc0\u0d9a\u0dca \u0dca\u0dca\u0dba\u0dd2, \u0d85\u0dc5\u0dd2 \u0dd3\u0dad\u0dba\u0dda\u0dba\u0d9a\u0dca \u0daf\u0dca\u200d\u0dd0\u0dda\u0dca\u0dcf\u0da7, \u0dc0\u0dd0\u0da9 \u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dc5\u0d9a\u0dca \u0dc4\u0dd0\u0dd4\u0dc0\u0dc0\u0dcf\u0da7, \u0daf\u0dca\u0dba\u0db4\u0dd8\u0dad\u0dcf\u0dbd\u0db1 \u0dc0\u0dba \u0dba \u0dad \u0d91\u0d9a \u0d91\u0d9a \u0daf\u0dca\u0dc0\u0dbd\u0dca \u0dda \u0dbb\u0da7\u0da7 \u0d9c\u0db1\u0dcf\u0dc0\u0dcf\u0da7, \u0d92 \u0daf\u0dca\u0dba\u0db4\u0dd8\u0dad\u0dcf\u0dbd\u0db1\u0dba \u0dad\u0dd4\u0db8\u0db6\u0db3 \u0dad \u0dbb \u0da7\u0dca \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0db1\u0dca\u0d9a \u0dc0\u0db1 \u0d9a\u0dcf\u0dbb\u0dc0\u0dcf \u0db1\u0dd2\u0dc3\u0dcf \u0d9a\u0dcf \u0dca\u0d9a\u0dca \u0dd4\u0dc0\u0dbb\u0da7 \u0dbb\u0da7 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0dc0\u0db1, \u0d91 \u0dc4\u0dca \u0db1\u0dd0\u0db8\u0db1\u0db1\u0dda \u0db4\u0dd8\u0dad\u0dbb\u0dd2\u0dc3\u0dbb\u0dba \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0dc0\u0db1 \u0dc0\u0dd0\u0da9 \u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dc5\u0d9a\u0dca \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0db1\u0dca\u0d9a \u0dc0\u0db1\u0dc0\u0dcf\u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a0 \u0d92\n\n\u0dda \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0daf\u0dca\u0daf\u0dd3 \u0dca\u0dca \u0dca\u0dc0\u0db8\u0db1 \u0d9a\u0dcf\u0dbb\u0dc0\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dba \u0dad\u0db1 \u0db1\u0db1\u0dd10 \u0d85\u0daf\u0dca\u200d \u0daf\u0dca\u0db8\u0db1\u0dca\u0dbd\u0dca \u0daf\u0dd2\u0dc3\u0dca\u0dd2\u0d9a\u0dca\u0d9a \u0dc0 \u0daf\u0dca\u200d\u0dd0\u0dd4\u0dc0\u0dbb\u0dd4 \u0d94\u0dba \u0db1\u0dd2\u0dda\u0db1 \u0dc0 \u0dc0\u0dd0\u0dd2 \u0da7\u0dd2\u0d9a \u0d9a\u0db4\u0dd8\u0dad\u0db1\u0dc0\u0dcf0 \u0dca\u0dcf\u0dbb\u0dc0\u0dd2\u0dbd, \u0dc4\u0dcf\u0dbd\u0dca\u0db4\u0dd8\u0dad \u0dad\u0dc0\u0dd2\u0dbd \u0dc4\u0dcf\u0dbb\u0d9a\u0dd0 \u0dc5\u0dca \u0dc0\u0db8\u0db1\u0dca \u0d9a\u0dd2\u0dba \u0dad \u0dad \u0d9a\u0dc0\u0daf\u0dca\u200d\u0dcf\u0dc0\u0db8\u0db1 \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4\u0db8\u0db1 \u0d85\u0dca \u0dba\u0dda\u0dba\u0daf\u0dca \u0db1\u0dd0\u0dba\u0dda \u0dca\u0dd0\u0db1\u0d9a\u0dca0 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d85\u0daf\u0dca\u200d \u0d91\u0dc4\u0dd2 \u0dba\u0dda \u0db6\u0db1 \u0db4\u0dd8\u0dad\u0dcf\u0dbd\u0dca \u0d9c\u0dc3\u0dca \u0da7\u0dd2\u0d9a \u0dc3\u0dda\u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0dba \u0dad \u0dc0\u0dd2\u0db1\u0dcf\u0dba \u0d9a\u0dbb\u0dbd\u0dcf, \u0d92\u0dc0\u0dcf \u0d85\u0dd4\u0dc0 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd\u0da7 \u0dc4\u0d82 \u0dba\u0dd2\u0dba\u0dbd\u0dcf\u0da7 \u0dc0\u0dd2\u0dd4\u0dad\u0dc0\u0dbd\u0dcf, \u0d92 \u0d9a\u0dca \u0db4\u0dd8\u0dad\u0dc3\u0dca \u0da7\u0dd2\u0d9a \u0d9a\u0db4\u0dd8\u0dad\u0dbd\u0dcf \u0d9c\u0db1\u0dd2\u0dba\u0db1\u0dc0\u0dcf0 \u0d92 \u0db4\u0dd8\u0dad\u0dc3\u0dca \u0db4\u0dd8\u0dad\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd4\u0da0\u0dd2 \u0d9a\u0dbb \u0dad\u0db1 \u0dc4\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf0 \u0db1\u0db8\u0dd4\u0db8\u0db1 \u0d92 \u0db4\u0dd8\u0dad\u0dc3\u0dca \u0da7\u0dd2\u0d9a \u0dc4\u0dcf \u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d92 \u0d85\u0daf\u0dca\u200d\u0dcf\u0dc5 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dad \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf0 \"\u0d92 \u0db4\u0dd8\u0dad\u0dc3\u0dca \u0dc4\u0dcf \u0dba\u0dd2, \u0dc4\u0dcf \u0db4\u0dd8\u0dad\u0dc3\u0dca \u0da7\u0dd2\u0d9a \u0dda \u0d9c\u0db1\u0dd2\u0dba \u0dad \u0dad\" \u0d9a\u0dd2\u0dba\u0dbd\u0dcf0 \u0d91 \u0dc4\u0dca \u0d9c\u0db1\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0dca\u0dc0 \u0d9a\u0dcf \u0dc4 \u0dad \u0dc4\u0dbb\u0dd2 \u0db4\u0dd8\u0dad\u0dc3\u0dca \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0d9c\u0db1\u0dd0\u0dbd\u0dca\u0dbd\u0dcf \u0daf\u0dca\u200d\u0dcf\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf0 \u0d92 \u0d9a \u0dad loads 10\u0d9a\u0dca \u0d91\u0db6\u0db3\u0dba\u0da7 \u0dba\u0db1\u0dc0\u0dcf \u0db1\u0dda loads 5\u0d9a\u0dca \u0d91\u0db6\u0db3\u0dba\u0da7 \u0dba\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dca\u0dca\u0dba\u0dd2 \u0dd2\u0dba \u0dad \u0dad0 \u0d85 \u0db1\u0d9a\u0dca . missing \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0db8\u0db1 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf0 \u0dda \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba \u0dca\u0dca\u0d9a \u0dba\u0dda\u0dba\u0dcf \u0d9c \u0dad\u0db10 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dca \u0dad\u0dbd\u0dcf \u0db4\u0dd8\u0dad\u0dbb\u0dd2\u0dc3\u0dbb\u0dba \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb \u0dad\u0db1 \u0dd3\u0dad\u0dba\u0dda \u0dc4\u0daf\u0dca\u200d\u0db1\u0dc0\u0dcf, \u0dd3\u0dad\u0dba\u0dda \u0dc3\u0dda\u0db4\u0dd8\u0dad\u0dcf\u0daf\u0dca\u200d\u0db1\u0dba \u0d9a\u0dbb\u0dbd\u0dcf \u0db4\u0dd8\u0dad\u0dcf\u0dbb\u0dca\u0dd2 \u0dda \u0dad\u0dad\u0dd4\u0db8 \u0dda \u0dc3\u0dda\u0dca\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf0 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0daf\u0dca\u200d\u0dd0\u0dd4\u0dc0\u0dbb\u0dd4 \u0d94\u0dba \u0d85\u0dc0\u0da7 \u0dc0\u0dd0\u0dd2 \u0da7\u0dd2\u0d9a \u0d9a\u0db4\u0dd8\u0dad\u0db1\u0dc0\u0dcf0 \u0d92 \u0d9a\u0dcf\u0dbb\u0dc0\u0dcf \u0dd2\u0db1\u0daf\u0dca\u0db0 \u0dc0 \u0dad \u0dad \u0d9a\u0dcf \u0dc4\u0dcf\u0dca\u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc0\u0dd2 \u0dba\u0dca\u0dc2 \u0dba \u0dad \u0dca\u0dca\u0d9a \u0dca\u0db6\u0dcf \u0d9c\u0dca \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dd20"
