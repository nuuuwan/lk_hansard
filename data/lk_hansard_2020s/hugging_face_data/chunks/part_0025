    "chunk_text": "\u0b9a\u0b95\u0bcc\u0bb0\u0bb5 \u0b87\u0bb0\u0bbe\u0ba4\u0bbe\u0b95\u0bbf\u0bb0\u0bc1\u0bb7\u0bcd\u0ba3\u0ba9\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bc6\u0bbe\u0ba9\u0bcd\u0ba9 \u0bae\u0bbe\u0ba4\u0bbf\u0bbe\u0bbf, \u0bae\u0bae\u0bc8\u0baf\u0b95 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u0bae\u0bae \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 \u0b95\u0b9f\u0bcd\u0b9f\u0bbe\u0baf\u0bae\u0bcd \u0b9a\u0baa\u0bc6\u0baa\u0bcd\u0baa\u0b9f \u0b9a\u0bb5\u0ba3\u0bcd\u0b9f\u0bbf\u0baf \u0b92\u0bb0\u0bc1 \u0bb5\u0bbf\u0bb7\u0baf\u0bae\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd! \u0b85\u0bae\u0ba4 \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b85\u0bae\u0bae\u0b9a\u0bcd\u0bc6\u0bb0\u0bae\u0bb5 \u0b85\u0ba9\u0bc1\u0bae\u0ba4\u0bbf \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bc1. \u0b85\u0bae\u0ba4 \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bae\u0bc1\u0bb2\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bbe\u0baf\u0bae\u0bcd \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd. \u0bc6\u0bae\u0bcd\u0baa\u0bb3\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0b9a\u0bcd\u0bc6\u0bbf\u0bae\u0ba9 \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1 \u0b9a\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bbe\u0ba9\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0bae\u0ba4 \u0bae\u0bae\u0bc8\u0baf\u0b95\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0ba8\u0bbf\u0ba4\u0bbf\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0b92\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b9a\u0b95\u0bbe\u0bb3\u0bcd\u0bb3 \u0b9a\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd. \u0b9a\u0baa\u0bb0\u0bc1\u0ba8\u0bcd\u0b9a\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0bbf\u0baa\u0ba8\u0bcd\u0ba4\u0bae\u0ba9\u0b95\u0bae\u0bb3 \u0bb5\u0bbf\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9. \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0ba4\u0bae\u0ba9 Wages Board \u0bae\u0bc2\u0bc8\u0bae\u0bbe\u0b95\u0b95\u0bcd \u0b9a\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0ba8\u0bcd\u0ba4\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1\u0bbe\u0bb2\u0bcd, \u0b95\u0b9f\u0bcd\u0b9f\u0bbe\u0baf\u0bae\u0bcd \u0b9a\u0baa\u0bb0\u0bc1\u0ba8\u0bcd\u0b9a\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bbe\u0ba4\u0bc1. \u0b87\u0ba9\u0bcd\u0bae\u0bb1\u0b95\u0bcd\u0b95\u0bc1 \u0b9a\u0ba4\u0bbe\u0bb4\u0bbf\u0bb1\u0bcd\u0bc6\u0b99\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bbe\u0bb2\u0bc1\u0bae\u0bcd \u0b87\u0ba4\u0bc1 \u0baa\u0bb1\u0bcd\u0bb1\u0bbf \u0b9a\u0baa\u0bc6 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bb5\u0bbf\u0bb2\u0bcd\u0bae\u0bc8. \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bbe\u0bb0\u0ba3\u0bae\u0bcd, \u0b87\u0ba4\u0bc1 Wages Board \u0bae\u0bc2\u0bc8\u0bae\u0bbe\u0b95\u0b95\u0bcd \u0b9a\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bbe\u0ba4 \u0b92\u0bb0\u0bc1 \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0ba9\u0bae\u0bcd. \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bae\u0ba4\u0b95\u0bcd \u0b95\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b8e\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bc0\u0bb0\u0bcd\u0b95\u0b9a\u0bb3\u0ba9 \u0ba8\u0bae\u0bcd\u0baa\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0b9a\u0bb1\u0ba9\u0bcd. \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bc6\u0ba9\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bb5\u0b9a\u0bb5\u0ba9\u0bcd\u0b9f\u0ba9\u0bcd \u0bb5\u0bbf\u0bb7\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0ba4\u0bae\u0bc8\u0baf\u0bbf\u0b9f\u0bcd\u0b9f\u0bc1, \u0b85\u0b99\u0bcd\u0b95\u0bc1\u0bb3\u0bcd\u0bb3 \u0baa\u0bbf\u0bb0\u0b9a\u0bcd\u0bc6\u0bbf\u0bae\u0ba9\u0b95\u0bae\u0bb3\u0ba4\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0ba4\u0bcd \u0ba4\u0bb0\u0bc1\u0bb5\u0bbe\u0b9a\u0bb0\u0ba9 \u0ba8\u0bbe\u0ba9\u0bcd \u0ba8\u0bae\u0bcd\u0baa\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0b9a\u0bb1\u0ba9\u0bcd.\n\n\u0d91\u0dae \u0dd9\u0dcf\u0daf\u0dda\u0db8 \u0db8\u0daf\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0da2\u0daf\u0dda \u0da2\u0dad\u0dca \u0db4\u0dd0\u0dc4\u0dd0\u0dd2\u0db1\u0dd2 \u0daf\u0dd9\u0db1\u0dca\u0db1 \u0d87\u0dad\u0dd2 \u0daf\u0dda \u0dba\u0daf \u0dd9\u0dad\u0dd4 \u0dda \u0dbb\u0dd4\u0dd9\u0db1\u0dca \u0daf\u0dd9\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dca \u0db1\u0dd9 \u0dba\u0da2\u0daf\u0d86 \u0d85\u0db4\u0dd2 \u0d85, \u0dbb\u0dd4\u0daf\u0dd4 \u0d91 \u0dc4\u0db8\u0dcf\u0dba \u0dd9\u0dcf\u0daf\u0dda \u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dad\u0dd4\u0dc5 \u0dd2\u0dc3\u0dc1\u0dcf\u0dbd \u0dd9\u0dd0\u0da9 \u0daf \u0dcf\u0da7\u0dc3\u0d9a\u0dca \u0dba \u0dad\u0dd2\u0daf\u0dd9\u0db1 \u0dd9\u0dd9. \u0d85\u0db4\u0dd2 \u0dd9\u0dad\u0dd4 \u0dda \u0dbb\u0dd4 \u0dd9\u0dd0\u0da7\u0dd4 \u0dd9\u0dd0\u0da9\u0dd2 \u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf \u0dd2 \u0dd9\u0dcf\u0dc3 \u0dbd\u0dd9\u0dcf \u0da2\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf. \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1\u0dd9\u0dcf \u0d94\u0dd9\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0dad\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dd2 \u0dba\u0dd2 \u0dbb\u0dd3\u0dba\u0dbd\u0dcf \u0dbd\u0dcf \u0dcf \u0dca\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0daf\u0d86 \u0dd9\u0dd0\u0da9\u0dd2\u0db8 \u0dd2 \u0dd9\u0dcf\u0dc3 \u0dc4\u0dd2\u0db8\u0dd2 \u0db8\u0d9a\u0dca \u0d9c\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0d85\u0db1\u0dd4\u0dba \u0d9a\u0dd4\u0db8\u0dcf\u0dba \u0dd2\u0db1\u0dc3\u0dcf\u0db1\u0dcf\u0dba \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0daf\u0dda \u0dd6\u0dbd\u0dd2 \u0dad\u0dca\u0dd9\u0daf\u0dba\u0db1\u0dca \u0dbd\u0dd9\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0dba \u0dbb\u0dd3\u0dba\u0db1 \u0d91 . \u0d9c\u0dd2\u0dba \u0d85, \u0dbb\u0dd4\u0dda\u0daf\u0dda \u0d85\u0db4\u0dd2 \u0dca\u0db1\u0dca\u0dd2\u0db1\u0dba\u0dcf\u0db1\u0dd4 \u0dca\u0db0\u0dcf\u0dba \u0dba\u0da7\u0daf\u0dad\u0dca \u0dd9\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba\u0daf\u0dd9\u0dbd \u0dd2 \u0dd9\u0dcf\u0dc3 0 20 \u0dc4\u0dd2\u0db8\u0dd2 \u0dda \u0dbd\u0dd9\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf. \u0daf\u0dd0\u0db1\u0dca \u0dca\u0da9\u0dda \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dad\u0dca \u0dd2\u0db1\u0dba\u0dba\u0da7 2\u0d9a\u0dca \u0dd2\u0dc3\u0dad\u0dba \u0d85\u0dd9\u0dc3\u0db1\u0dca \u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca. \u0daf\u0dd0\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0daf\u0dd9\u0dcf\u0daf\u0dc4\u0ddd \u0d92\u0dd9\u0dcf\u0daf\u0d86 \u0dca\u0dd2\u0db1\u0dbb\u0dd3\u0db8\u0dda\u0dda \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dd9\u0dbd \u0dca\u0dba\u0dda\u0db7 \u0d85\u0dd9\u0dc3\u0dae\u0dcf\u0dcf\u0daf \u0dca\u0db1\u0dca\u0daf\u0db1\u0dca."
  },
