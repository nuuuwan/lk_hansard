    "chunk_text": "\u0d8a \u0dd9\u0da7 \u0daf\u0dd6 \u0d9c\u0dd0\u0db1 \u0db6\u0dbd\u0db1\u0dca\u0db1 \u0da0\u0db8\u0dca\u0d9a \u0daf\u0dd3\u0dbb\u0dca\u0dbd\u0d9d \u0d9a\u0dcf\u0dbd \u0dca \u0dd2\u0dba\u0dc3\u0dda\u0da0\u0dc3\u0dda \u0db8\u0da0\u0d9a \u0db8\u0dd0\u0dd2\u0dba\u0dc0\u0dbb \u0da0\u0dda\u0daf\u0dd2\u0d9a\u0dcf\u0da0\u0dda \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf\u0dc0\u0da7 \u0db6\u0db3\u0dd4\u0db1\u0dca \u0dc0\u0dd6 \u0db8\u0dcf\u0dca\u200d\u0dd8\u0d9a\u0dcf\u0dc0\u0dca \u0db8\u0dd2\u0dc5 \u0da0\u0dc4\u0dd2\u0db6\u0daf\u0dbb\u0dda \u0d9a\u0dbb\u0da0\u0d9c\u0db1 \u0dd2\u0dba\u0da0\u0db6\u0db1\u0dc0\u0dcf \u0db8\u0da0\u0d9a \u0dbb\u0da7\u0dd2\u0db1\u0dca \u0d9a \u0dc3\u0dbd\u0dca\u0dd2 \u0dd2\u0dc5\u0da7 \u0d9a\u0da0 \u0dda \u0da0\u0d9a\u0dcf\u0da0\u0dc4\u0dcf\u0db8\u0daf \u0dbb\u0dd3 \u0dbd\u0dcf \u0dd2\u0dc5\u0da7 \u0d9a\u0dbb\u0dbd\u0dcf \u0dd2\u0dba\u0da0\u0db6\u0db1\u0dca\u0da0\u0db1\u0dca TT \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc4\u0dbb\u0dc4\u0dcf Advance payment \u0d9a\u0dbb\u0dbd\u0dcf \u0dd2\u0dba\u0da0\u0db6\u0db1\u0dc0\u0dcf \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0db7\u0dcf\u0da9\u0dbd\u0da9 \u0d87\u0daf\u0dca\u0dbd\u0dca\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 2023 \u0dc0\u0dbb\u0dca\u0dbd \u0da0 \u0d89 \u0db1\u0dca \u0da0\u0db8\u0dca \u0dc0\u0db1\u0da0\u0d9a\u0dcf\u0da7 TT \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc4\u0dbb\u0dc4\u0dcf advance payment \u0d9a\u0dbb\u0dbd\u0dcf \u0dd2\u0dba\u0da0\u0db6\u0db1\u0dc0\u0dcf \u0da0\u0da9\u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0db6\u0dd2\u0dd2 \u0db1 \u0d9a\u0da7 \u0d86\u0dc3\u0db1\u0dca\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0db7\u0dcf\u0da9\u0dbd\u0da9 \u0d87\u0daf\u0dca\u0dbd\u0dca\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0da0\u0da9\u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0db6\u0dd2\u0dd2 \u0db1 \u0dca \u0dbb\u0dd3 \u0db1\u0dca\u0da0\u0db1\u0dca \u0d86\u0dc3\u0db1\u0dca\u0db1 \u0dc0\u0dba\u0da0 \u0db1\u0dca \u0d9c\u0dad\u0dca\u0da0\u0dca\u200d\u0dcf\u0dad\u0dca \u0dbb\u0dd4\u0dd2\u0dc5 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0db1 300\u0dca \u0dbb\u0dd4\u0dd2\u0dc5 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0db1 300\u0d9a \u0dc3\u0dbd\u0dca\u0dd2 \u0d9a \u0daf\u0dca\u0db0\u0dd2 \u0da7 \u0dbb\u0da7\u0dd2\u0db1\u0dca \u0dd2\u0dc5\u0da7\u0da7 \u0da0\u0d9c\u0db1 \u0db1\u0dca\u0db1 \u0db4\u0dd4 \u0dc0\u0db1\u0dca \u0dc0\u0db1\u0dca\u0da0\u0db1\u0dca \u0d9a\u0dcf\u0da7\u0daf? \u0dbb\u0db4\u0dcf\u0db8 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba \u0da0\u0d9a\u0da0\u0db1\u0d9a\u0dd4\u0da7 \u0da0\u0d9c\u0db1 \u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0 \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dcf\u0dbb\u0dd2\u0d9a\u0da0 \u0d9a\u0dd4\u0da7 \u0dbb\u0dd4\u0dd2\u0dc5 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0db1 300\u0dca \u0dbb\u0da7\u0dd2\u0db1\u0dca \u0db4\u0dcf\u0db1\u0dca\u0db1\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0db4\u0dcf\u0db1\u0dca\u0db1\u0dbd\u0dcf \u0dd2\u0dba\u0da0\u0db6\u0db1\u0dc0\u0dcf \u0d9a \u0dad\u0dd4\u0db8 \u0d9a\u0dd4\u0dd4\u0dc0\u0dd2\u0db1\u0dca \u0dc0\u0db4\u0dcf \u0dcf \u0d9c\u0dad\u0dca \u0dc3\u0dbd\u0dca\u0dd2 \u0dd2\u0dba\u0da0\u0db6\u0db1\u0dc0\u0dcf \u0daf\u0dd6 \u0da0 \u0db1\u0dca \u0dc0\u0db4\u0dcf \u0dcf \u0d9c\u0dad\u0dca \u0dc3\u0dbd\u0dca\u0dd2 \u0dd2\u0dba\u0da0\u0db6\u0db1\u0dc0\u0dcf \u0db8\u0db4\u0dcf\u0dbb\u0dcf\u0db0\u0dc0\u0dd2\u0db1\u0dca \u0dc0\u0db4\u0dcf \u0dcf \u0d9c\u0dad\u0dca \u0dc3\u0dbd\u0dca\u0dd2 \u0dd2\u0dba\u0da0\u0db6\u0db1\u0dc0\u0dcf \u0d9a \u0dd2\u0dc5\u0dd2\u0db6\u0db6 \u0dc0 \u0db8\u0dd2\u0dc5 \u0db4\u0dcf\u0db8\u0dda\u0dca \u0daf\u0dd2 \u0dad\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dd2\u0dba\u0da0\u0db6\u0db1\u0dc0\u0dcf \u0da0\u0da9\u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0db6\u0dd2\u0dd2 \u0db1 \u0d9a\u0da7 \u0d86\u0dc3\u0db1\u0dca\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dca advance payment \u0d9a \u0dad\u0dca \u0dbd\u0dcf\u0d9a\u0dcf\u0dc0\u0da7 \u0db6\u0dd4 \u0d87\u0daf\u0dca\u0dbd\u0dca\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0db8\u0dc0\u0d