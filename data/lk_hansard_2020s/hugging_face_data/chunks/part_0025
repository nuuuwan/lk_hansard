    "chunk_text": "\u0dbb\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf \u0d92\u0dc0\u0dd0\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca \u0d85\u0dad\u0dba\u0dc0\u0dbb\u0dd4\u0dba\u0dba \u0db7\u0dcf\u0dab\u0dca\u0da9\u0da9\u0dc0\u0dbb\u0dd4\u0dbd\u0dba \u0dc0\u0dd2\u0dad\u0dbb\u0dba\u0dd2 TT \u0dd0\u0db1\u0db1\u0dca\u0dc0\u0db1\u0dca \u0d92 \u0dc4\u0dd2\u0db1\u0dca\u0daf\u0dcf \u0d85\u0db4\u0dba \u0dc0\u0db4\u0dc0\u0db1\u0dca\u200d\u0db1\u0dca\u0db1\u0dca\u200d\u0dba \u0dad\u0dd2\u0dc0\u0dcf\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf, \u0dc0\u0dda \u0dba \u0db4\u0dda crisis \u0d91 \u0dba \u0daf\u0dd0\u0db1\u0dca \u0dd0\u0db8\u0db1\u0dca \u0dbb\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf \u0dbb\u0dd3\u0dba \u0db4\u0dbd\u0dcf \u0dc0\u0dda \u0dca\u0dad\u0dcf\u0db8 \u0db7\u0dba \u0db4\u0dcf\u0db1\u0dca\u200d \u0dba\u0dd2 \u0d85\u0dbb\u0dd2 \u0dc0\u0dda \u0dd2\u0db1\u0dca \u0dbb\u0dd3\u0dda\u0dc0\u0dbb\u0dd4\u0dcf \u0d92 \u0dbb\u0dd3\u0dba \u0db4\u0db1\u0dca\u0dc0\u0db1\u0dca \u0dc0\u0dc0\u0dbb\u0dd4\u0dc0\u0dc5\u0db3 \u0dc0\u0db4\u0dcf\u0dc0\u0dc5\u0d9a \u0dc0\u0dd2\u0dba\u0d9a\u0dc0\u0dbb\u0dd4\u0dad\u0dd3\u0db8\u0dba \u0db4\u0dca \u0dc0\u0dbb\u0dd4\u0dba \u0db4 \u0db6\u0dd2\u0db3 \u0dc0\u0dbb\u0dd4\u0dd0\u0db8\u0dd2\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dcf\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf \u0dc0\u0dc0\u0dbb\u0dd4\u0dc0\u0dc5\u0db3 \u0dc0\u0db4\u0dcf\u0dc0\u0dc5\u0d9a \u0dc0\u0dd2\u0dba\u0d9a\u0dc0\u0dbb\u0dd4\u0dad\u0dd3\u0db8\u0dba \u0db4\u0dca \u0dc0\u0dbb\u0dd4\u0dba \u0db4 \u0db6\u0dd2\u0db3 \u0dc0\u0dbb\u0dd4\u0dd0\u0da7\u0dd4\u0dab\u0dd4 \u0db1\u0dd2\u0dad\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0dc0\u0dc0\u0dbb\u0dd4\u0dc0\u0dc5\u0db3 \u0dc0\u0db4\u0dcf\u0dc5 \u0dd4\u0dc5 \u0daf\u0dd0\u0db1\u0dca \u0dc0\u0da9\u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0dc4\u0dd2\u0d9f\u0dba \u0db4\u0d9a\u0dca \u0db8\u0dd4 \u0dc0\u0dc0\u0dbb\u0dd4\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dcf\u0db1\u0dca\u0dc0\u0db1\u0dca \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dca\u200d\u0dcf\u0db1\u0dca\u0dc0\u0dad\u0d9a\u0dbd\u0dcf