b6\u0dbd\u0db4\u0dd8\u0dad\u0dcf\u0dd4\u0dc0 \u0dbd\u0db6\u0dba\u0dd20\n\n\u0d850 \u0dc0\u0dd2\u0dc0\u0dcf\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0dca\u0dcf\u0daf\u0dca\u200d \u0dc0\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0dc0\u0dd2\u0dc0\u0dcf\u0dc4 \u0d85\u0dd4\u0dc0\u0db4\u0dd8\u0dad\u0dcf\u0dca \u0d85\u0dd4\u0dc0 \u0dc0\u0dd3\u0db8\u0dca0\n\n\u2022 \u0dc0\u0dd2\u0dc0\u0dcf\u0dc4 \u0dc0\u0db1 \u0dc0\u0dba\u0dc3 \u0d89\u0dc4\u0dc5 \u0dba\u0dcf\u0dca0 \u2022 \u0dc0\u0dd2\u0dc0\u0dcf\u0dc4 \u0d85\u0dd4\u0dc0\u0db4\u0dd8\u0dad\u0dcf\u0dca\u0dba \u0db4\u0dd8\u0dad\u0dc4\u0dc5 \u0dba\u0dcf\u0dca \u2022 \u0dc0\u0dd2\u0dc0\u0dcf\u0dc4 \u0dba \u0dad \u0dc0 \u0dad\u0dc0\u0dd3\u0db8\u0dda \u0dc4\u0dcf \u0daf\u0dd2\u0d9a\u0dca\u0d9a\u0dc3\u0dcf\u0daf\u0dca\u200d \u0db4\u0dca\u200d\u0dbb\u0dca\u0dcf\u0dc0\u0dba \u0d89\u0dc4\u0dc5 \u0dba\u0dcf\u0dca\n\n\u0d860 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0d9a \u0dca\u0da9\u0db1\u0dba\n\n\u2022 \u0da2\u0dd3\u0dc0\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dca\u200d\u0dca \u0d89\u0dc4\u0dc5 \u0dba\u0dcf\u0dca \u2022 \u0db1\u0dd2\u0dc0\u0dcf\u0dc3, \u0d85\u0db0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0db1\u0dba \u0dc3\u0dc4 \u0dc5\u0dca\u0dcf \u0dbb\u0dd0\u0d9a\u0dc0\u0dbb\u0dc0\n\n\u0dc0\u0dd2\u0dba\u0daf\u0dca\u200d\u0dda \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd3\u0db8\u0dca \u2022 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0d9a \u0d85\u0dc0\u0dd2\u0db1\u0dd2\u0dba\u0dca\u0da0\u0dd2\u0dca\u0dca\u0dcf\u0dc0 \u0dc3\u0dc4 \u0dca\u0dae\u0dba\u0dd4\u0dad\u0da7\u0dd4\u0dda\u0db7\n\n\u0d86\u0daf\u0dca\u200d\u0dcf\u0dba\u0dca \u0d85\u0dd4\u0dc0 \u0dc0\u0dd3\u0db8\u0dca \u2022 \u0daf\u0dca\u200d\u0dbb\u0dd4\u0dc0 \u0dad \u0d87\u0dba\u0dda \u0daf\u0dca\u200d\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0dc0\u0da9 \u0dc0\u0da9\u0dcf\u0db8\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dca\u200d\u0dda\n\n\u0d85\u0db0\u0dd2\u0d9a \u0dc0\u0dd3\u0db8 \u0d87\u0dba\u0dda \u0db6\u0dc0\u0da7 \u0dc0\u0db1 \u0dca\u0dca\u0dba\n\n\u0d870 COVID - 19 \u0dc0\u0dc3\u0d82\u0d9c\u0dca \u0dc0 \u0db6\u0dbd\u0db4\u