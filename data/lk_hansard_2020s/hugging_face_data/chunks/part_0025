\u0daf\u0dd3\u0db8\u0da7 \u0d9a \u0dc4\u0dbb\u0dc4\u0dcf \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0db8\u0dad\u0dca \u0dc0\u0dc0\u0dd4\u0dbb\u0da0\u0dbb\u0db1\u0dca \u0d86\u0dbb\u0dca \u0dcf \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db8\u0db4\u0dcf\u0da7 \u0db4\u0dd4 \u0dc0\u0db1\u0dca \u0dc0\u0db1\u0dc0\u0dcf \u0db8\u0daf \u0dc0\u0db1\u0da0\u0d9a\u0dcf\u0da7 \u0d9a \u0da0\u0dca\u200d\u0dcf\u0dbb\u0dad\u0dd4\u0db8\u0dbb\u0dd4 \u0da2\u0dcf\u0dbd \u0dc4\u0dbb\u0dc4\u0dcf \u0dca\u200d\u0dbb\u0dd4 \u0db1\u0dca \u0daf\u0dca\u0dba\u0dcf\u0dbd \u0dc0\u0dba\u0da0 \u0db1\u0dca \u0db8\u0dad\u0dca \u0dc0\u0dc0\u0dd4\u0dbb\u0dbb \u0dc3 \u0dc4\u0dcf \u0da0 \u0dcf\u0db8\u0dd4 \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0db8\u0dc0\u0dc3\u0dda\u0d9c\u0dcf \u0db8\u0dd2\u0dc5 \u0d87\u0dd2\u0dba \u0dca\u200d\u0dbb\u0db8\u0dca \u0daf\u0dd0\u0d9a \u0dd2\u0dba\u0da0\u0db6\u0db1\u0dc0\u0dcf\n\n\u0dbb\u0daf\u0dcf \u0dbb\u0dca\u200d\u0dbb\u0db8\u0dca \u0da0\u0dc4\u0dcf \u0dc3\u0db8\u0dcf\u0da2 \u0dca \u0dd2\u0dba\u0db6\u0dd4 \u0dcf \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0db8\u0daf \u0da0\u0d9c\u0daf\u0dbb \u0dd9\u0db8 \u0dd2\u0dba\u0da0\u0db6\u0db1 \u0db4\u0dcf\u0dcf\u0dc3\u0dbd\u0da7\u0dad\u0dca \u0daf\u0dbb\u0dd4\u0dc0\u0dcf \u0da0 \u0db8\u0dca\u200d \u0db8\u0dbd\u0dca\u0dbd\u0dcf\u0da0\u0d9c\u0db1 \u0dd2\u0dab\u0dd2\u0dc0\u0dbd\u0dca\u0dbd\u0dcf \u0d87\u0dbb\u0dbd\u0db1 \u0dca\u200d\u0dbb\u0db8\u0da7 \u0dc3\u0dd1\u0db8 \u0da0\u0daf\u0db1\u0dcf\u0da0 \u0db8 \u0dd2\u0dc0\u0dad\u0dca \u0dad\u0dd4\u0db8 \u0db6\u0dd2 \u0dca \u0d87\u0dd2\u0dba \u0da0\u0dc0\u0dbd\u0dcf \u0dd2\u0dba\u0da0\u0db6\u0db1\u0dc0\u0dcf \u0d9a \u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0da0\u0dc0\u0db1\u0dc3\u0dda \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db1\u0db8\u0dca \u0d9a \u0d86\u0dbb\u0dca\u0dd2\u0dca\u200d \u0dc4\u0dd0\u0d9f\u0dd3\u0db8 \u0db8\u0dd4 \u0dc3\u0db8\u0dcf\u0da2 \u0dad\u0dd4\u0db8 \u0db8 \u0d87\u0dd2\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db1\u0db8\u0dca \u0db8\u0db4\u0dcf\u0da7 \u0d9a \u0da0\u0dc0\u0dd4 \u0da0\u0dc0\u0db1\u0dca \u0daf\u0dca\u0dba\u0dcf\u0dbd \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0dca \u0db4\u0dcf\u0dd0\u0dc0\u0db8\u0dda \u0dd2\u0dba\u0da0\u0db6\u0db1\u0dc0\u0dcf \u0dbb\u0dd3 \u0dcf \u0db8\u0db8 \u0dd2\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dcf \u0da0\u0dda\u0daf \u0db6\u0dd2\u0db1\u0dca\u0db1 \u0da0\u0dc0\u0dbd\u0dcf \u0dc0\u0dcf\u0daf \u0daf\u0dca\u0dc0\u0dcf\u0daf \u0d9a\u0dbb\u0db1 \u0db8\u0dca\u200d\u0dbb\u0dad\u0dd4\u0db8\u0dbb\u0db8 \u0da0\u0dc4\u0dcf \u0da0 \u0da2\u0db1\u0dcf \u0da0\u0d9c\u0db1\u0dd0\u0dbd\u0dca\u0dbd\u0dcf \u0db8\u0dd4 \u0dbb\u0da0\u0da7\u0dca\u0db8 \u0da2\u0db1\u0dca\u200d\u0dcf\u0dc0 \u0da0\u0db8\u0dca \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0dc0\u0dc0\u0dd4\u0dbb\u0da0\u0dbb\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dd2\n\n\u0dc3\u0db8\u0dcf\u0da2 \u0dad\u0dd4\u0db8 \u0da2\u0dd3\u0dc0\u0dad\u0dca \u0dc0\u0db1 \u0db4\u0dd4\u0dbb\u0dc0\u0dd0\u0dc3\u0dd2 \u0db1\u0dca \u0dc4\u0dd0\u0da7\u0dd2 \u0da7 \u0db8\u0dd2\u0dc5 \u0dc4\u0dd0\u0db8 \u0da0\u0daf\u0db1\u0dcf\u0db8 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0da0\u0db8\u0dca \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0dbb\u0d9a\u0dd4\u0dc3\u0dcf \u0da0\u0d9a\u0dcf\u0dca\u200d\u0dbb\u0db8\u0dca \u0daf\u0dbb\u0dd4\u0dd4\u0db8 \u0daf\u0dca\u0db0\u0dd2 \u0da7 \u0db8\u0da0\u0d9a \u0da0\u0daf\u0dcf\u0dbb\u0d9a\u0da9 \u0dd9\u0da7\u0db8 \u0d87\u0daf\u0dca\u0dad\u0dca \u0dd2\u0dba\u0da0\u0db6\u0db1\u0dc0\u0dcf\u0daf \u0dbb\u0dd3 \u0db1 \u0dc0\u0d9c \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0db1\u0dd2\u0dc0\u0dcf\u0dbb \u0dbb\u0dd3 \u0db1 \u0dbb\u0d9a \u0db1\u0dd3\u0dd2\u0dba\u0da0 \u0db1\u0dca \u0db4\u0dcf\u0db8 \u0dca \u0db8\u0db4\u0dcf\u0da7 \u0db8\u0da7\u0dca\u0dd4\u0daf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db8\u0db8\u0dcf\u0dbb\u0dd4\u0dba\u0dd2 \u0db8\u0dd2\u0dc5 \u0da0\u0db8\u0dcf\u0db1 \u0dca\u200d\u0dbb\u0db8\u0dca \u0dba\u0dca\u0dd2\u0dba\u0db8\u0dad\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0d9c\u0dad\u0dca\u0dca\u200d\u0dad\u0dca \u0dc3\u0db8\u0dcf\u0da2 \u0dca \u0da0\u0dbd\u0dc3 \u0d9a\u0dc0\u0dcf\u0da7 \u0dc4\u0db4\u0dcf\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd9\u0dcf\u0dbb \u0daf\u0dd0\u0dca\u0dc0\u0dd3\u0db8 \u0dc3\u0dc4\u0da0 \u0d9c \u0daf\u0dd0\u0dca\u0dc0\u0dd3\u0db8 \u0dad\u0dd4\u0db8\u0dd2\u0db6\u0db1\u0dca \u0dc0\u0dcf\u0da0 \u0db8 \u0dbb\u0d9a\u0da7 \u0dbb\u0d9a\u0dad\u0dd4\u0db8 \u0da0\u0dc0\u0dbd\u0dcf \u0dc0\u0dd0\u0da9 \u0dbb\u0dd3\u0db8\u0dda\u0db8 \u0dad\u0dd4\u0db8\u0dd2\u0db6\u0db1\u0dca \u0db4\u0dcf\u0db8 \u0dba\u0dd2 \u0da0\u0db8\u0dca \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0dbb\u0d9a\u0dd4\u0dc3\u0dcf\u0dc0 \u0db8\u0db4\u0dcf\u0da7 \u0db4\u0dcf\u0dbb\u0dcf\u0da2 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4 \u0dc0\u0db1\u0dca \u0dc0\u0db1\u0dca\u0da0\u0db1\u0dca \u0db4\u0dcf\u0dc0\u0dd4\u0dbd\u0dca \u0dc0\u0dba\u0da0 \u0db1\u0dca \u0dc0\u0dcf\u0da0 \u0db8 \u0db4\u0dcf\u0dcf\u0dc3\u0dbd\u0dca \u0daf\u0dca\u0dba\u0dda\u0dc0\u0daf\u0dca\u0daf\u0dba\u0dcf\u0dbd \u0d86\u0d9c\u0db8\u0dd2\u0d9a \u0dc3\u0dda\u0d9c\u0dcf\u0db1 \u0dc4\u0dcf \u0dc3\u0db8\u0dcf\u0da2 \u0dc3\u0dcf\u0daf\u0dca\u0db0\u0dcf\u0db1 \u0d87\u0dad\u0dd4\u0db8 \u0db8\u0dd2\u0dc5 \u0dc3\u0dd2 \u0dd4 \u0da0\u0daf\u0db1\u0dcf\u0db8 \u0db4\u0dcf\u0dca \u0db4\u0dcf\u0dcf\u0da7 \u0da0\u0dda\u0daf \u0dbb\u0dd3\u0db1\u0dca \u0da0\u0dca\u200d\u0dcf\u0dbb\u0dc0 \u0dc3\u0dd1\u0db8 \u0da0\u0dda\u0daf \u0dca\u0db8 \u0db4\u0dcf\u0da0\u0dc3\u0d9a\u0dbd\u0dcf \u0db8\u0da0\u0d9a \u0d86\u0daf\u0dbb\u0dab\u0dd3 \u0dca\u200d\u0dbb\u0dd4 \u0db4\u0dcf\u0dbb\u0db8\u0dca\u0db4\u0dcf\u0dbb\u0dcf\u0dc0 \u0da0\u0db8\u0dca \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0dbb\u0d9a\u0dd4\u0dc3\u0dcf\u0da0\u0d9c\u0db1\u0dca \u0da0\u0dda\u0dbb\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3 \u0dc4\u0dcf \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dbb\u0db8\u0dd4 \u0d9a \u0da0\u0dc0\u0dd4 \u0da0\u0dc0\u0db1\u0dca \u0da0\u0db8\u0dca \u0dbb\u0da2 \u0db8\u0db1\u0dd2\u0dc0\u0dcf\u0dbb\u0dca\u0dbd \u0da0 \u0db1\u0dca \u0db1\u0dd2\u0dca\u200d\u0dd0\u0dd2\u0dba\u0db1\u0dca\u0db8 \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0dbb\u0dd3 \u0db8\u0dd2\u0db1\u0dca \u0db8\u0da7 \u0d9a\u0d9c\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db8\u0dc0\u0dc3\u0dda\u0d9c\u0dcf\u0dc0 \u0dbd\u0db6\u0dcf \u0dd4\u0dbb\u0db1\u0dca\u0db1\u0dcf\u0da7 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0da7\u0dad\u0dca \u0dc3\u0dda\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0dc0\u0db1\u0dca\u0dca\u200d \u0da0\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0db8\u0db8 \u0db1\u0dd2\u0dc4\u0dac \u0dc0\u0db1\u0dc0\u0dcf \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2\n\n\u0d9c\u0dd4 \u0db8\u0dd6\u0dbd\u0dcf\u0dca\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0db8\u0dca\u0dd3\u0dd4\u0dbb\u0db8\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0b95\u0bb2\u0b95\u0bae\u0ba4\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0d9c\u0dbb\u0dd4 \u0db8\u0dad\u0dd4\u0db8\u0dbd \u0da0\u0dc0 \u0da0\u0d9c\u0dcf\u0da9 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0da7 \u0daf\u0dca\u0db1\u0dcf\u0da2\u0dd2 7\u0d9a \u0d9a\u0dcf\u0dbd \u0dca \u0dbd\u0dd0\u0da0\u0db6\u0db1\u0dc0\u0dcf"
