    "chunk_text": "\u0daf\u0dd0\u0db1\u0dca \u0db8\u0dba \u0d87\u0dc4\u0dd4\u0dab\u0dcf \u0dc0\u0dda \u0dad\u0db7\u0dcf\u0dc0\u0dda \u0dc0\u0dcf\u0dcf\u0dc0\u0db1\u0dcf\u0db8 \u0dc0\u0dbd\u0dcf\u0d9a\u0dd4\u0dc0\u0dbb\u0dd4\u0dba \u0dbb\u0dd3\u0dba \u0db4\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf, \u0dca\u200d\u0dbb\u0dcf\u0dae. \u0dd2\u0dab\u0dd4\u0dc0\u0dda \u0dad\u0dcf\u0dbb\u0dca\u0dbd\u0dae \u0dca \u0dc0\u0dbb\u0dd4\u0dba \u0db4 \u0db1\u0dcf \u0dbb\u0dcf\u0da2\u0dba \u0d86\u0daf\u0dcf\u0dba \u0db4\u0dc0\u0dda \u0dad\u0dcf\u0dbb\u0dca\u0dbd\u0dae \u0dca \u0dc0\u0dbb\u0dd4\u0dba \u0db4 \u0dd0\u0dd0\u0db1\u0dca\u200d \u0dc0\u0db8\u0dcf\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf \u0dbb\u0dbd\u0dcf\u0daf \u0dc0\u0dda \u0dad\u0dcf\u0dbb\u0dca\u0dbd\u0dae \u0dca \u0dc0\u0dbb\u0dd4\u0dba \u0db4 \u0dc5\u0d9f\u0dcf \u0dbb \u0dd0\u0dca \u0dc0\u0dca ? \u0dcf\u0daf\u0dd4 \u0dd0\u0db1\u0dbd\u0dcf \u0dca\u0dad\u0dd2\u0db1\u0dca, \u0d92 \u0dd1\u0db1\u0dca\u200d\u0dd1\u0db8 \u0dc0 \u0dc0\u0db1\u0dca\u200d\u0d9a\u0dd4\u0dba \u0dbb\u0db1\u0dca\u0db1\u0dca\u200d \u0dc3\u0dca\u0dc5\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc0\u0daf\u0dba \u0db4\u0d9a\u0dca \u0dc0\u0db1\u0dca \u0dcf\u0daf\u0dd4 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dba\u0dad\u0dba \u0db4 \u0dc0\u0dbb\u0dd4\u0dd0\u0da2\u0dd2 \u0dc5\u0dcf\u0db8 \u0dbb\u0dcf\u0da2\u0dba \u0d86\u0daf\u0dcf\u0dba \u0db4\u0db8 \u0dc0\u0dbb\u0dd4\u0dd0\u0da2\u0dd2 \u0dc0\u0dbb\u0dd4\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf, \u0dca\u200d\u0dbb\u0dcf\u0dae. \u0dd2\u0dab\u0dd4\u0dc0\u0dda \u0dc0\u0dba\u0d9a\u0dc2\u0dba \u0db4 \u0dc0\u0dbb\u0dd4\u0dd0\u0da2\u0dd2 \u0dc0\u0dbb\u0dd4\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf \u0dcf\u0dbd\u0db1\u0dca\u0db1\u0dca\u200d, \u0d91\u0daf\u0dcf \u0dc0\u0dda \u0dbb\u0dc0 \u0d94 \u0d9a\u0dca\u0dd4\u0dbb, \u0d9a\u0dd4\u0da9\u0dcf \u0db1\u0dcf \u0db8\u0db0\u0dba \u0db4\u0dc0\u0dd0\u0db8\u0dcf\u0dab\u0dc0\u0dda \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0db1\u0dca\u0dad \u0db1\u0dca\u0dc0\u0dbb\u0dd4\u0db1\u0dca, \u0dc0\u0dbb\u0dd4\u0dba\u0dc0\u0dbb\u0dd4\u0dad\u0dcf\u0dba \u0db4 \u0dba \u0db4\u0db1\u0dca \u0db1\u0dcf \u0db8\u0db1\u0dcf \u0db4\u0dc0\u0dd0\u0db8\u0dcf\u0dab\u0dc0\u0dda \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0db1\u0dca\u0dad \u0db1\u0dca\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dbb\u0dd0\u0dbb\u0dd3\u0dba \u0db4\u0dcf \u0daf\u0dad\u0daf\u0db1\u0dad\u0d9a \u0dd0\u0dab\u0db1\u0dca\u200d\u0d9a\u0dca \u0d8b\u0dca \u0db4\u0dcf\u0daf\u0db1\u0dca\u200d\u0dba \u0db4 \u0dc5\u0dcf \u0d92 \u0dc0\u0dbb\u0dd4\u0dba\u0dcf\u0db4\u0dcf\u0dc0\u0dd0 \u0dca\u200d\u0dbb\u0da2\u0dcf\u0dc0\u0dbb\u0dd4\u0dc0 \u0d86\u0dbb\u0dca\u0dbd\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0db4\u0dcf\u0daf\u0dcf\u0db8\u0dba \u0db4 \u0dad\u0db1\u0db8\u0dd4\u0dd2\u0db1\u0dca\u0db8 \u0d85\u0daf \u0d85\u0da9\u0db4\u0dab \u0dc0\u0dc0\u0dbb\u0dd4\u0dbd\u0dcf \u0dca\u0dad\u0dd2\u0db1\u0dca, \u0dc3\u0dca\u0dc5\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc0\u0db1\u0dca \u0dc0\u0dda \u0dbb\u0da2\u0dba \u0db4\u0dba\u0dca \u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dba\u0dcf\u0dbd\u0dcf 200 \u0dc0\u0dbb\u0dd4\u0dd0\u0da9\u0dad\u0dba\u0db1\u0db1\u0dca\u200d\u0d9a\u0dca \u0db4\u0dba\u0db1\u0dca \u0dd0\u0db1\u0dca\u0db1\u0dca\u200d, \u0d91\u0daf\u0dcf \u0d87\u0d9f\u0dd4 \u0dda \u0dda\u0db1\u0dbd\u0dca 200 \u0dc0\u0dbb\u0dd4\u0dd0\u0da9\u0dad\u0dba\u0db1\u0db1\u0dca\u200d \u0d86\u0dbb\u0dda\u0db7 \u0dc5\u0dcf \u0dc0\u0dbb\u0dd4\u0dcf\u0dc0 \u0d91\u0dc0\u0db1\u0db8 \u0dc0\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dca \u0db1\u0dca\u200d\u0dd0\u0db1\u0dd0 \u0dc3\u0dca\u0dda\u0dd0\u0dbd\u0dba \u0db4\u0db1\u0dca \u0db8\u0dad \u0db4\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u200d \u0dcf\u0daf\u0dd4 \u0db8\u0dd2 \u0dc0\u0dbb\u0dd4\u0dd0\u0da2\u0dd2 \u0dbb\u0dbd\u0dcf, \u0d86\u0dba \u0db4\u0dad\u0db1\u0dca\u200d \u0db8\u0dad \u0db4\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u200d \u0dcf\u0daf\u0dd4 \u0db8\u0dd2 \u0dc0\u0dbb\u0dd4\u0dd0\u0da2\u0dd2 \u0dbb\u0dbd\u0dcf, \u0dd2\u0daf\u0dba \u0db4\u0dba \u0db4\u0dba 8\u0d9a\u0dca \u0d