    "chunk_text": "\u0dca\u200d\u0dbb\u0dc3\u0dda\u0dca\u200d\u0dc0\u0dcf\u0daf \u0daf\u0dca\u0daf\u0dca\u0db0 \u0d86\u0d9a\u0dcf\u0dbb\u0da0 \u0db1\u0dca \u0db8\u0dbb\u0dca\u0dbd\u0d9c \u0d9a\u0d9c\u0db1 \u0d9a\u0dbb\u0dbd\u0dcf \u0db8\u0db4\u0dcf\u0da7 PTA \u0dbb\u0d9a \u0da7\u0da0\u0dad\u0dca \u0db1\u0dd4 \u0daf\u0db8\u0db1\u0dca\u0db1 \u0db4\u0dd4 \u0dc0\u0db1\u0dca \u0db8\u0dbb\u0dca\u0dbd\u0d9c \u0db1\u0dd2\u0dbb\u0dd6\u0db4\u0dcf \u0dbb\u0dd3\u0db8\u0dda\u0da0\u0db8\u0dca \u0daf\u0dca\u0dba\u0dcf\u0dbd \u0db4\u0dcf\u0dbb\u0dcf\u0dc3 \u0dca \u0dca\u200d\u0dbb\u0dc3\u0dda\u0dca\u200d\u0dc0\u0dcf\u0daf \u0dc0\u0dd0 \u0dd0\u0dca\u0dc0\u0dd3\u0da0\u0db8\u0dca \u0db4\u0dcf\u0db1\u0dca\u200d \u0d87\u0dad\u0dd4\u0db8\u0da0 \u0dda \u0dd2\u0dba\u0da0\u0db6\u0db1\u0dc0\u0dcf \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0db8\u0dd2\u0dc5 \u0dc3\u0dcf\u0daf\u0dca\u0db0\u0dcf\u0db1\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0db8\u0db4\u0dcf\u0dbb\u0dcf\u0db0\u0dc0\u0dbd\u0da7 \u0db8\u0daf\u0dcf \u0dc0 \u0db8\u0dbb\u0dca\u0dbd\u0d9c \u0db1\u0dd2\u0dbb\u0dd6\u0db4\u0dcf \u0dc4\u0dbb\u0dd2 \u0da7\u0db8 \u0dc3\u0dcf\u0dba\u0dd4\u0dca\u0dca\u200d \u0d9a\u0dbb\u0dbd\u0dcf \u0dc3\u0dcf\u0daf\u0dca\u0db0\u0dcf\u0db1\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0db8\u0db4\u0dcf\u0dbb\u0dcf\u0db0 \u0d9a\u0da7 \u0db8\u0daf\u0dcf \u0dc0\u0db1 \u0db4\u0dcf\u0dbb\u0dd2\u0daf\u0dd2 \u0db8\u0dbb\u0dca\u0dbd\u0d9c \u0db1\u0dd2\u0dbb\u0dd6\u0db4\u0dcf \u0dc3\u0d9a\u0dc3\u0dda \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\n\n1275 1276\n\n\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0da0\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\n\n\u0d8a \u0dd9\u0da7 \u0dc3\u0dcf\u0daf\u0dca\u0db0\u0dcf\u0db1\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0db8\u0db4\u0dcf\u0dbb\u0dcf\u0db0 \u0db8\u0dd0\u0da9\u0db4\u0dcf\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0dd2\u0dc5\u0dd2\u0db6\u0db6 \u0dc0 \u0da0\u0d9c\u0da0\u0db1\u0db1 \u0db4\u0dcf\u0db1\u0dca\u200d \u0d9c\u0dad\u0dca\u0da0\u0dca\u200d\u0dcf\u0dad\u0dca \u0dbb \u0dc3\u0dcf\u0daf\u0dca\u0db0\u0dcf\