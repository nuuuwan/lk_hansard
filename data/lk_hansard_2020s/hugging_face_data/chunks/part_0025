u0dca\u0dca\u0dd4\u0dbb\u0dc0 \u0dca\u0dd4\u0dbb \u0d9c\u0db6\u0da9\u0dcf\n\n\u0db1\u0dc0\u0dd3\u0d9a\u0dbb\u0dab\u0dba \u0b89\u0ba3\u0bb5\u0bc1 \u0b86\u0bae\u0ba3\u0baf\u0bc6\u0bbe\u0bb3\u0bb0\u0bcd \u0ba4\u0bbf\u0bae\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0ba4\u0b9a\u0bc6\u0bbe\u0ba8\u0bcd\u0ba4\u0bc8\u0bc6\u0bbe\u0ba9 \u0b95\u0bb3\u0b9e\u0bcd\u0b9a\u0bbf\u0baf\u0b9a\u0bc6\u0bbe\u0bae\u0bb2\u0b95\u0bb3\u0bcd: \u0ba8\u0bb5\u0bc0\u0ba9\u0bc8\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\n\nWAREHOUSES OWNED BY DEPARTMENT OF FOOD\n\nCOMMISSIONER: MODERNIZATION 655/2025 7. \u0d9c\u0dd4 \u0d9c\u0dba\u0dca\u0dad \u0d9a\u0dd4\u0dab\u0dcf\u0dd2\u0db1\u0dbd\u0d9a \u0dd9\u0dc4\u0dc3\u0dad\u0dcf (\u0d9c\u0dd4 \u0db4\u0dbb\u0ddd\u0dc4\u0dc3\u0dab \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dbb\n\n\u0dd9\u0dc4\u0dc3\u0dad\u0dcf \u0db4\u0dc0\u0db1\u0dd4\u0dc0 ) (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b95\u0baf\u0ba8\u0bcd\u0ba4 \u0b95\u0bb0\u0bc1\u0ba3\u0bc6\u0bbe\u0ba4\u0bbf\u0bb2\u0b95\u0bcd\u0b95 - \u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0bae\u0bb0\u0bc6\u0bbe\u0bb9\u0ba3 \u0baa\u0ba3\u0bcd\u0b9f\u0bc6\u0bbe\u0bb0 \u0b9a\u0bc6\u0bbe\u0bb0\u0bcd\u0baa\u0bc6\u0bbe\u0b95) (The Hon. Gayantha Karunathilleka on behalf of the Hon. Rohana Bandara) \u0d9c\u0dc0\u0d9c\u0dc0\u0db3, \u0dc0\u0dcf\u0dab\u0dd2\u0da2, \u0d86\u0dc4\u0dcf\u0dbb \u0dc3\u0dd4\u0dbb\u0d9a\u0dca\u0dd2\u0dad\u0dca\u200d\u0dad\u0dca\u200d\u0dcf \u0dc3\u0dc4 \u0dc3\u0db8\u0dd4\u0dd1\u0d9a\u0dcf\u0dbb \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db8 \u0dba\u0dcf\u0dad\u0dca\u200d\u0dba\u0dad\u0dd4\u0db8 \u0dba\u0dcf\u0d9c\u0d9c\u0db1\u0dca \u0dc3\u0dd6 \u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0db8 - (1):\n\n(\u0d85) (i) \u0d86\u0dc4\u0dcf\u0dbb \u0d9c\u0d9a\u0dcf\u0db8 \u0dba\u0dc3\u0dcf\u0dd2\u0d9a\u0dc3\u0dca \u0d9c\u0daf\u0dd1\u0dcf\u0dbb\u0dca\u0dad\u0dca\u200d\u0d9c\u0dc0\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc3\u0dad\u0dd4 \u0d9c\u0dbd\u0da9\u0dcf \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0 \u0d9c\u0d9a\u0dcf\u0dd1\u0db8 \u0dba\u0dab\u0daf;\n\n(ii) \u0d92\u0dc0\u0dcf \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0d9a\u0dc0\u0d9c\u0dbb\u0dca\u0daf;\n\n(iii) \u0d91\u0db8 \u0dba \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0d9c\u0dbd\u0da9\u0dcf\u0d9c\u0dda \u0db0\u0dcf\u0dd2\u0d9a\u0dad\u0dca\u200d\u0dcf\u0dc0 \u0d9c\u0dc0\u0db1\u0dca \u0d9c\u0dc0\u0db1\u0dca \u0dc0\u0dba\u0d9c\u0db8\u0db1\u0dca \u0d9c\u0d9a\u0dcf\u0dd1\u0db8 \u0dba\u0dab\u0daf;\n\n(iv) \u0d89\u0dc4\u0dad\u0dca\u200d \u0d9c\u0dbd\u0da9\u0dcf \u0d85\u0dad\u0dca\u200d\u0dd2\u0d9a\u0db1\u0dca 2020 \u0dc0\u0dbb\u0dca\u0dc2\u0d9c\u0db8\u0db1\u0dca \u0dd1\u0dc3\u0dd4 \u0db1\u0dc0\u0dd3\u0d9a\u0dbb\u0dab\u0db8 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9c\u0dbd\u0da9\u0dcf \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0 \u0dc4\u0dcf \u0d92\u0dc0\u0dcf\u0d9c\u0dda \u0db1\u0dc0 \u0d9a\u0dc0\u0d9c\u0dbb\u0dca\u0daf;\n\n(v) \u0d91\u0db8 \u0dba \u0db1\u0dc0\u0dd3\u0d9a\u0dbb\u0dab \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd0\u0db8 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db8\u0dd4\u0daf\u0dbd \u0d9c\u0d9a\u0dcf\u0dd1\u0db8 \u0dba\u0dab\u0daf;\n\n(vi) \u0d91\u0db8 \u0dba \u0d9c\u0dbd\u0da9\u0dcf \u0db1\u0dc0\u0dd3\u0d9a\u0dbb\u0dab\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0d9c\u0dc0 \u0d85\u0dbb\u0db8\u0dd4\u0dab\u0dd4 \u0d9a\u0dc0\u0d9c\u0dbb\u0dca\u0daf;\n\n(vii) \u0d91\u0db8 \u0dba \u0db1\u0dc0\u0dd3\u0d9a\u0dbb\u0dab \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0dbd\u0db3\u0dc0 \u0dc0\u0dd2\u0d9c\u0dab\u0db1 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dca\u200d\u0dcf\u0d9c\u0dda \u0daf\u0dd0\u0d9a\u0dca\u0d9c\u0dc0\u0db1 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dc3\u0dc0\u0dbd\u0db1\u0dca\u0db0\u0d9c\u0db8\u0db1\u0dca \u0d9c\u0dd4\u0dc0 \u0dbd\u0dbd\u0db1 \u0dca\u200d\u0dbb\u0dd2\u0db8\u0dcf\u0db8 \u0dba\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0dc0\u0d9c\u0dbb\u0dca\u0daf;"
