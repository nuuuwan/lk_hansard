\u0dd9\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0d85\u0db1\u0dd4\u0dd9 \u0dc3\u0dc4 \u0d91\u0d9a\u0dca\n\n\u0d91\u0d9a\u0dca \u0dd2\u0db1\u0dc3\u0dae\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dba \u0d85\u0db1\u0dd4\u0dd9 \u0daf\u0dd9\u0db1\u0dca \u0daf\u0dd9\u0db1\u0dca \u0dd9\u0dc1\u0daf\u0dba\u0db1\u0dca \u0dd9\u0daf\u0dbb\u0dca\u0dbd\u0daf;\n\n(iv) \u0d91\u0dd9\u0dd0\u0dd2 \u0d94 \u0db4\u0dd4 \u0dd2 \u0d9a\u0dd4\u0dad\u0dca \u0dba\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd3\u0daf\u0db8\u0db1\u0dca \u0dd9\u0dd0\u0dc5\u0dd0\u0d9a\u0dd3\n\n\u0dd2\u0db1\u0da7\u0dd3\u0db8\u0da7 \u0daf\u0dc4\u0dae\u0dad\u0dd4\u0dd3 \u0d87\u0dad\u0dd2 \u0dd2 \u0dc1\u0dae\u0da0\u0dd2\u0dad \u0db1\u0db1\u0dad\u0dd2 \u0db8\u0dd2\u0db1\u0dd4\u0dda \u0dd2\u0db1\u0dad\u0dd2\u0dba\u0dda \u0dca\u0da9\u0dda \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0daf\u0dda \u0daf\u0dc4\u0ddd \u0dd2\u0dba\u0dbb\u0dd3\u0dba\u0dd2\u0dc3\u0dd2 \u0d85\u0dca\u0db4\u0dcf\u0dca \u0dd9\u0daf\u0dbb\u0dca\u0dbd\u0daf;\n\n(v) \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dd9\u0dc3\u0dba 2 \u0dad\u0dd4\u0dc5 \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dd2\u0db1\u0daf\u0dd4 \u0daf \u0daf\u0dba\u0db8\u0dd2\u0db1\u0dca\n\n\u0db4\u0dd9\u0dad\u0dd2\u0db1 \u0dd2\u0db4\u0dd2\u0daf\u0d9c\u0dcf\u0db1\u0dd4 \u0dc3\u0dcf\u0d9b\u0dba\u0dcf\u0dd9 \u0daf \u0dcf\u0db4\u0db8\u0dab\u0daf;\n\n(vi) \u0dd9\u0dd0\u0da9 \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dd9\u0dc3\u0db1\u0dca \u0daf\u0db1\u0dcf \u0dba \u0daf\u0d9c\u0dcf\u0da9\u0d9c\u0dd0\u0dc3\u0dd3 \u0d87\u0dad\u0dd2 \u0d94 \u0db4\u0dd4 \u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba 020 \u0dd9\u0dbb\u0dca\u0dbd\u0dc2\u0dba \u0dad\u0dd4\u0dc5 \u0d85\u0dd9\u0dc3\u0db1\u0dca \u0dbb\u0dd3\u0db8\u0dda\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0db1 \u0db8\u0dcf\u0dd2\u0db1 \u0dca\u0dbd\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0dcf\u0dbd \u0dd2 \u0dba\u0db8\u0dba\u0db1\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0dcf\u0db8\u0dda \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u