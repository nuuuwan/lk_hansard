    "chunk_text": "\u0db8\u0db8\u0dca \u0dc0\u0dda \u0dd0\u0db1\u0dca \u0dad\u0db7\u0dcf\u0dc0\u0dbb\u0dd4\u0dba \u0d85\u0dbb\u0dd2 \u0daf\u0dd0\u0db1\u0dca \u0dca\u0db1\u0dca\u0db1\u0dca\u200d \u0dad\u0dca \u0dca \u0dc0\u0dbb\u0dd4\u0dba \u0db4 \u0dbb\u0dd3\u0dba \u0db4\u0db1\u0dca\u0db1\u0dca\u200d \u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dd2 \u0d91 \u0db4\u0dd0\u0dca \u0dad\u0dbb\u0dd3\u0db1\u0dca \u0db4\u0dc0\u0dbb\u0dd4\u0dad\u0dd2\u0db1\u0dca\u200d \u0db8\u0dd0\u0daf \u0dc0\u0db4\u0dbb\u0daf\u0dd2\u0dd0 \u0dba\u0dd4\u0dda\u0db0\u0dba \u0db4 \u0dad\u0db1 \u0d85\u0dc0\u0db1\u0dca\u200d\u0d9a\u0dca \u0db4\u0dd0\u0dca \u0dc0\u0dad\u0db1\u0dca \u0d85\u0db4\u0dba \u0dd2\u0daf\u0dda\u0db0 \u0dd4\u0db1\u0dab\u0dd4 \u0dad\u0d9a\u0dc0\u0dbb\u0dd4\u0dcf\u0db7\u0dcf\u0dc0\u0dd2 \u0d86\u0db4\u0daf\u0dcf\u0dc0\u0dbb\u0dd4 \u0db1\u0dd2\u0dad\u0dcf \u0d85\u0dc0\u0dda \u0d86\u0dbb\u0dca\u0dbd\u0dd2 \u0dba \u0db4 \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0db1\u0dca \u0dc5\u0db8\u0db1\u0dca\u200d\u0dcf \u0dbb\u0dab\u0dba \u0db4 \u0dbb \u0dd0\u0db1\u0dca\u0db1\u0dca\u200d \u0db1\u0dca\u200d\u0dda, \u0d86\u0dbb\u0dca\u0dbd\u0dd2 \u0da0\u0dbd\u0db1\u0dca\u200d\u0dba \u0db4\u0db1\u0dca\u0dba \u0db8\u0dd4\u0dc4\u0dd4\u0dab \u0dc0\u0daf\u0db1\u0dca\u0db1\u0dca\u200d \u0db1\u0dd0\u0dbb\u0dd3 \u0dad\u0d9a\u0dae\u0dcf\u0dc0\u0dbb\u0dd4\u0dbb \u0dad\u0dca \u0dca \u0dc0\u0dbb\u0dd4\u0dba \u0db4 \u0dba \u0dc0\u0dda \u0d86\u0dbb\u0dca\u0dbd\u0dd2 \u0dba \u0db4 \u0dc0\u0dd0\u0db1\u0dca\u200d \u0d91\u0db1\u0dca\u0db1\u0dca\u200d \u0db1\u0dca\u200d\u0dda, \u0d85\u0dc0\u0dda \u0db1\u0dd2\u0dc2\u0d9a\u0db4\u0dcf\u0daf\u0db1\u0dca\u200d \u0dad\u0dc0\u0dbb\u0dd4\u0daf\u0dd4\u0dbb\u0dba\u0dca \u0dc0\u0dbb\u0dd4\u0dd0\u0da2\u0dd2 \u0dbb\u0dc0\u0dd0\u0db1\u0dca\u200d \u0dad\u0d9a\u0dae\u0dcf\u0dba\u0dd3 \u0dbb\u0dab\u0dba \u0db4\u0dba \u0d91\u0db1\u0dca\u0db1\u0dca\u200d \u0db1\u0dca\u200d\u0dda \u0dba \u0db4\u0dda \u0dba \u0db4\u0dda \u0dbb\u0dd2\u0dba \u0db4\u0dc0\u0dbb\u0dd4\u0dbb \u0dd0\u0db1\u0dca\u0db1\u0dc