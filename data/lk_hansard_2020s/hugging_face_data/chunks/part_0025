    "chunk_text": "\u0db8\u0db8 \u0dbb\u0dd3\u0dba\u0db8\u0dd2\u0db1\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0daf\u0d86 \u0daf\u0dda \u0dcf\u0dba\u0dab\u0dba\u0dba\u0dd2 \u0d9c\u0dbb\u0dd4 \u0dd2 \u0daf\u0dba\u0ddd\u0da2\u0dba \u0dcf\u0dba \u0dc3\u0db7\u0dcf \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0dd2 . \u0da2\u0dd4\u0dd2 \u0db8\u0dcf\u0dc3\u0daf\u0d86 9\u0dd9\u0dd0\u0dd2 \u0daf\u0dcf \u0dc4\u0dd9\u0dc3 1 \u0dd9\u0db1 \u0db4\u0dd0\u0daf\u0d86 \u0da2 thermal oil\u0dd9\u0dd2\u0db1\u0dca \u0d85\u0db4\u0dd2 generate \u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0daf\u0db8\u0d9c\u0dcf\u0daf\u0dd9\u0dcf 11. \u0dba\u0dd2. \u0db8\u0dd4\u0dc5\u0dd4 generation \u0d91 \u0daf\u0db8\u0d9c\u0dcf\u0daf\u0dd9\u0dcf 0 (19\u0dba\u0dd2. \u0daf\u0dda \u200d\u0dbb\u0dad\u0dd2\u0dc1\u0dad\u0dba\u0d9a\u0dca \u0dd2\u0dc3\u0db0\u0dd2\u0dba\u0da7 \u0d9c\u0dad\u0dca\u0daf\u0dad\u0dcf\u0dad\u0dca 9.0\u0dba\u0dd2. \u0da9\u0dd3\u0dc3\u0dbd\u0dca \u0dbd\u0dd3\u0da7\u0dbb\u0dca\u0dbd \u0dbd\u0d9a\u0dca\u0dc2 \u0db1\u0dd9\u0dba\u0dbb\u0dd3\u0db1\u0dca generate \u0dc5\u0dcf \u0db1\u0dda \u0daf \u0dcf\u0daf\u0dc4\u0dcf\u0db8\u0daf \u0daf\u0dda \u0dd2\u0db1\u0dba\u0dba\u0da7 9.0\u0d9a\u0dca \u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca? \u0d8b\u0dad\u0dca\u0dad\u0dba \u0daf\u0daf\u0db1\u0dca\u0db1 \u0dd9\u0dd0\u0dbb\u0dd2 \u0dd2 \u0dc3\u0dcf \u0db1\u0dd0\u0d9f\u0dd2\u0da7\u0dbd\u0dcf \u0d9c\u0dd2\u0dba\u0dcf\u0da7 \u0db8\u0da7 \u0db8\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc4\u0dd0\u0dd9\u0dd0\u0dba\u0dd2 \u0daf\u0db8\u0dad\u0dd0\u0db1 \u0daf\u0dd9\u0dcf\u0dbb\u0dd4 \u0dc3\u0dcf\u0d9b\u0dba\u0dcf\u0daf\u0dbd\u0dca\u0d9b\u0db1 \u0dca\u0dd2\u0db1\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dba\u0dbd\u0dcf \u0da2\u0db1\u0dad\u0dcf\u0dd9 \u0daf\u0db1\u0dcf\u0db8\u0d9f \u0dba\u0dd9\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf. \u0db8\u0dc4\u0da2\u0db1 \u0dd2 \u0daf\u0dba\u0ddd\u0da2\u0dd2\u0dad\u0dba\u0db1\u0dca \u0dc4\u0dd0\u0db8\u0dd2\u0dba\u0da7 \u0d85\u0db8\u0dcf\u0dbb\u0dd4\u0daf\u0dd9\u0db1\u0dca \u0dc4\u0dbb\u0dd2 \u0da2\u0dcf\u0dad\u0dd2 \u0dbd\u0dd0\u0dba\u0dd2\u0dc3\u0dae\u0dad\u0dd4\u0daf\u0dd9\u0db1\u0dca \u0dc4\u0dbb\u0dd2 \u0daf\u0db8\u0dad\u0dd0\u0db1\u0da7 \u0db4\u0dad\u0dca \u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dd9\u0dad\u0dca \u0dc3\u0db8\u0dc3\u0dae\u0dad \u0da2\u0db1\u0dad\u0dcf\u0dd9\u0dad\u0dca \u0daf\u0db1\u0dcf\u0db8\u0d9f \u0dba\u0dd9\u0db1 \u0dc3\u0dcf\u0d9b\u0dba\u0dcf\u0daf\u0dbd\u0dca\u0d9b\u0db1 \u0dca\u0dd2\u0db1\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dba\u0db1\u0dca\u0db1 \u0daf\u0db1\u0dcf\u0daf\u0dd9\u0dba\u0dd2.\n\n\u0d9c\u0dbb\u0dd4 \u0dd2 \u0daf\u0dba\u0ddd\u0da2\u0dba \u0dcf\u0dba \u0dc3\u0db7\u0dcf \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0dd2 \u0daf\u0dbd\u0ddd \u0daf\u0d86 \u0d9c\u0dd4\u0dd9\u0db1\u0dca \u0daf\u0dc3\u0dae\u0dd9\u0dcf\u0dd9\u0da7 \u0daf\u0dda \u0d85\u0dad\u0dd2\u0dd2\u0dc3\u0daf\u0dc1\u0dae\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0d8d\u0da2\u0dd4\u0dd9\u0db8 \u0d85\u0daf\u0dcf\u0dc5 \u0daf\u0db1\u0dcf, \u0dab\u0dad\u0dca \u0daf\u0dda \u0daf\u0dd9\u0dbd\u0dcf\u0dd9 \u0dbb\u0dd3\u0dba\u0db1\u0dca\u0daf\u0db1\u0dca \u0db8\u0dd0\u0daf \u0daf\u0db4\u0dba\u0dd2\u0db1\u0d9c \u0dba\u0dd4\u0dda\u0db0\u0dba\u0dad\u0dca \u0d91\u0d9a\u0dca \u0dd2\u0dc3\u0daf\u0dc1\u0dae\u0dc2\u0daf\u0dba\u0db1\u0dca\u0db8 \u0db8\u0dd4\u0dc5\u0dd4 \u0daf\u0dbd\u0ddd \u0daf\u0d86\u0db8 \u0dd2\u0db1\u0dd2\u0dc3\u0dbd\u0dca \u0d9c\u0dd4\u0dd9\u0db1\u0dca \u0daf\u0dc3\u0dae\u0dd9\u0dcf\u0dd9\u0da7 \u0d91\u0da0\u0dca\u0da0\u0dba \u0daf\u0dc4\u0dcf\u0db3 \u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0daf\u0db1\u0dcf\u0daf\u0dd9\u0dba\u0dd2 \u0dbb\u0dd3\u0dba\u0db1 \u0d91 \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dd9\u0dcf. \u0db8\u0dd0\u0daf \u0daf\u0db4\u0dba\u0dd2\u0db1\u0d9c \u0d87\u0dad\u0dd2\u0daf\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dd9\u0dba\u0dad\u0dca \u0d91\u0d9a\u0dca \u0d9c\u0dd4\u0dd9\u0db1\u0dca \u0dc3\u0dda\u0dd9\u0db1\u0dca\u0db0\u0dad\u0dcf \u0da2\u0dcf\u0dbd\u0dba \u0dca\u0dba\u0d9a\u0dca\u0dc2\u0dcf \u0daf\u0db1\u0dcf\u0dd3\u0db8 \u0dc3\u0db8\u0dc4\u0dba \u0d85\u0dd9\u0dc3\u0dae\u0dcf\u0dcf\u0dd9\u0dbd \u0d9c\u0dd4\u0dd9\u0db1\u0dca \u0dbd\u0dcf\u0db4 \u0dd9\u0dc3\u0dcf \u0daf\u0dd0\u0db8\u0dd3\u0db8 \u0d9c\u0dd4\u0dd9\u0db1\u0dca \u0dba\u0dcf\u0db1\u0dcf \u200d\u0dbb\u0db8\u0dcf\u0daf \u0dd3\u0dda \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0dd2\u0dc3\u0dd2\u0dc3\u0db0 \u0dcf\u0dba\u0dab\u0dcf \u0dd2 \u0dc3\u0dcf \u0d9c\u0dd4\u0dd9\u0db1\u0dca \u0daf\u0dc3\u0dae\u0dd9\u0dcf\u0dd9\u0db1\u0dca\u0dd9\u0dbd\u0da7 \u0dd2\u0dc3\u0dd2\u0dc3\u0db0 \u0dd9\u0dcf\u0db0\u0dcf \u0d87\u0dad\u0dd2\u0daf\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf. \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0daf\u0dda \u0dad\u0dad\u0dca\u0dad\u0dca\u0dd9\u0dba \u0dad\u0dd4\u0dc5 \u0d85\u0daf \u0da2\u0dcf\u0dad\u0dd2 \u0d9c\u0dd4\u0dd9\u0db1\u0dca \u0daf\u0dc3\u0dae\u0dd9\u0dba \u0dd9\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dbd\u0db1\u0dca \u0db1\u0dca \u0d9c\u0dd4\u0dd9\u0db1\u0dca \u0daf\u0dc3\u0dae\u0dd9\u0dcf\u0dd9\u0da7\u0dad\u0dca \u0d8d\u0da2\u0dd4\u0dd9 \u0dd9\u0dbd\u0db4\u0dd1\u0db8\u0d9a\u0dca \u0d91\u0dbd\u0dca\u0dbd \u0daf\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d9c\u0dd4\u0dd9\u0db1\u0dca \u0daf\u0dc3\u0dae\u0dd9\u0daf\u0d86 \u0daf\u0db8\u0daf\u0dc4\u0dba\u0dd4\u0dda \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u200d\u0dbb\u0dcf\u0dda\u0db0\u0db1 \u0dca\u0daf\u0dba\u0ddd\u0da2\u0db1 \u0dc4\u0dd0\u0db8\u0dd2\u0dba\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 122\u0d9a\u0dca \u0db8\u0dc4\u0dcf \u0db7\u0dcf\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0d9c\u0dcf\u0dba\u0daf\u0dba\u0db1\u0dca \u0daf\u0dba\u0dcf\u0daf\u0db1\u0dca\u0db1 \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dba\u0db1\u0dd9\u0dcf \u0dbb\u0dd3\u0dba\u0dbd\u0dcf \u0daf\u0dda \u0daf\u0dd9\u0dc3\u0dae\u0dd9\u0dbd \u0dc3\u0db8\u0dcf\u0da2\u0dba \u0dad\u0dd4\u0dc5 \u0db8\u0dad\u0dba\u0d9a\u0dca \u0dc4\u0daf\u0dcf\u0daf\u0d9c\u0db1 \u0dba\u0db1\u0dd9\u0dcf. \u0db8\u0da7 \u0dcf\u0dcf \u0dba\u0db1\u0dca\u0db1 \u0dca\u0dad\u0dd2\u0dbb\u0dd2\u0dd9 \u0dad\u0dd2\u0daf\u0dd9\u0db1 \u0dcf\u0dbd\u0dba \u0dad\u0dd4\u0dc5 \u0db8\u0db8 \u0daf\u0dda \u0db4\u0dd0\u0dc4\u0dd0\u0dd2\u0db1\u0dd2 \u0dba\u0db1\u0dca\u0db1 \u0dd9\u0dbd\u0dcf\u0daf\u0db4\u0dcf\u0daf\u0dba\u0dcf\u0dad\u0dca\u0dad\u0dd4 \u0daf\u0dd9\u0db1\u0dd9\u0dcf. \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0daf\u0dbd\u0dcf\u0d9a\u0dd4 \u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0d9c\u0db1\u0dca\u0daf\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0."
  },
