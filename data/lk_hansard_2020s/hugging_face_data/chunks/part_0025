    "chunk_text": "\u0db1\u0dd3\u0dd2\u0dba\u0da0 \u0db1\u0dca \u0daf\u0dca\u0dca\u200d\u0dbb\u0dca \u0da0\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0db1 \u0daf\u0dca\u0dc3 \u0db1\u0dca\u0db1 \u0db4\u0dd4 \u0dc0\u0db1\u0dca \u0dbb\u0dd3 \u0dbd\u0dcf \u0db8\u0dd2\u0dc5 \u0daf\u0dca\u0dba\u0dda\u0dc0\u0dcf\u0dc3 \u0d9a\u0dbb\u0db1\u0dca\u0da0\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0da0\u0db8\u0dca \u0dc3\u0db8\u0dcf\u0da2\u0da0 \u0db8\u0dd4\u0dbd\u0dca \u0db6\u0dd0\u0dc3\u0d9c\u0dad\u0dca \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0dc0\u0dc0\u0dd4\u0dbb\u0dbb \u0db8\u0dd4\u0dd2\u0dd4 \u0db4\u0dd4\u0da7\u0dcf \u0daf\u0db8\u0db1\u0dca\u0db1 \u0db1\u0dd3\u0dd2\u0dba \u0dc3\u0dc4 \u0db1\u0dd3\u0dd2\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dbb\u0dd3\u0db8\u0dda\u0da0\u0db8\u0dca \u0d86 \u0dca\u200d\u0db1 \u0db4\u0dcf\u0db8 \u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf \u0dc0\u0dad\u0dca \u0dbb\u0dd3 \u0dbd\u0dcf \u0db8\u0dd2\u0dc5 \u0daf\u0dca\u0dba\u0dda\u0dc0\u0dcf\u0dc3 \u0d9a\u0dbb\u0db1\u0dca\u0da0\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0dbb\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0dbb\u0dca\u200d\u0dd0\u0db1\u0dd2\u0db1\u0dca \u0dbb\u0dc4\u0dcf\u0da7 \u0dd2\u0dab\u0dd2\u0dc0\u0dbd\u0dca\u0dbd\u0dcf \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0dc0\u0dc0\u0dd4\u0dbb\u0dbb\u0da7 \u0da0\u0d9c\u0dcf\u0dd4\u0dbb\u0dbb\u0dd4 \u0dc0\u0dd6 \u0dca\u200d\u0dd0\u0db1\u0dd0\u0dad\u0dca\u0dca\u200d\u0db1\u0dca\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0d9a\u0dcf\u0dbb \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0da0\u0db8\u0dca \u0d9a\u0dca\u200d\u0dbb\u0db8\u0da0\u0dda\u0daf \u0dca \u0db8\u0dc0\u0dba\u0dba\u0dba\u0dd2 \u0dbb\u0dd3 \u0dbd\u0dcf \u0db8\u0dd2\u0dc5 \u0daf\u0dca\u0dba\u0dda\u0dc0\u0dcf\u0dc3 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0da0\u0d9c\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca \u0db4\u0dd4\u0db1\u0dbb\u0dd4\u0dad\u0dca\u0d9c\u0dcf\u0db4\u0dcf\u0db1 \u0dbb\u0dd3\u0db8\u0dda\u0da0\u0db8\u0dca \u0d9a\u0dca\u200d\u0dbb\u0db8\u0da0\u0dda\u0daf \u0dca \u0db8\u0dc