\u0db4 \u0dba \u0dcf\u0dbb\u0db4\u0dad\u0dc5 \u0dd4\u0dc0\u0dbb\u0dd4\u0dcf\u0dbd \u0dd2\u0daf\u0daf\u0dd4 \u0dbb, \u0d85\u0dad\u0dd2\u0dc0\u0dd2\u0dba\u0dcf\u0dbd \u0dc0\u0dda\u0db4\u0dc5 \u0db1\u0dcf\u0db1\u0dd2\u0dba \u0db4\u0d9a\u0dca \u0dd2\u0daf\u0daf\u0dd4 \u0dbb.\u0db1\u0dca, \u0dc0\u0db8\u0dbb\u0dba \u0d86\u0dbb\u0dca\u0dbd\u0dd2 \u0dba \u0db4\u0dba \u0d8d\u0da2\u0dd4 \u0dc0\u0dbd\u0dad \u0dcf\u0dbd\u0db4\u0dd1\u0dda \u0dbb.\u0db1\u0dca, \u0dc0\u0db8\u0dbb\u0dba \u0da2\u0dcf\u0dad\u0dd3\u0db1\u0dca \u0db1\u0dcf \u0d86\u0dd0\u0dda \u0d85\u0dad\u0dbb \u0dad\u0db1\u0dad\u0dda\u0dcf\u0db1\u0dca\u0db0\u0dad\u0dcf\u0dc0\u0dbb\u0dd4 \u0db6\u0dd2\u0db3 \u0daf\u0db8.\u0db1\u0dca 20]9 04 2] \u0dc0\u0dbb\u0dd4\u0dd0\u0db1\u0dd2 \u0db4\u0dcf\u0dad\u0d9a\u0d9a\u0dd4\n\n301 302\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc0\u0dda\u0db1\u0dca\u0dd4\u0dc0\u0dbb\u0dd4\n\n\u0dca\u0db1\u0dca\u0daf\u0dd2\u0db1\u0dca\u200d \u0d91\u0dbd\u0dca\u0dbd \u0dc5 \u0db8\u0dbb\u0dcf\u0dc0\u0dd0\u0db1\u0dca\u200d \u0db8\u0dd0\u0dc0\u0dbb\u0db1\u0dca\u200d \u0dc0\u0dcf\u0ddd\u0dda\u0dcf \u0dca\u200d\u0dbb\u0db1\u0dcf\u0dbb \u0db8\u0dcf\u0dbd\u0dcf\u0dc0\u0dbb\u0dd4 \u0db1\u0dcf \u0d92 \u0dad\u0dda\u0dcf\u0db1\u0dca\u0db0\u0dd2\u0dad \u0dad\u0dcf\u0db1\u0dd2\u0daf \u200d\u0dbb\u0dad\u0d9a\u0dad\u0dc0\u0dbb\u0dd4\u0dcf\u0daf\u0dd3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0db4\u0dcf \u0dcf\u0dbb \u0dda \u0dbb\u0dd2\u0dc5\u0dd2\u0dcf\u0db3\u0dc0\u0dbb\u0dd4 \u0dc0\u0db8\u0dbb\u0dba \u0dad\u0db1\u0dca\u0db1\u0dca\u200d\u0dda\u0db0 \u0db1\u0db8\u0dd4\u0daf\u0dcf \u0db6\u0dd4\u0dda\u0db0\u0dd2 \u0d85\u0d82\u0dba \u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0dd2\u0dc0\u0dba \u0db4\u0d9a\u0dd4 \u0db1\u0dcf \u0dbb\u0dcf\u0da2\u0dba \u0db6\u0dd4\u0dda\u0db0\u0dd2 \u0dc0\u0dad\u0d9a\u0dc0\u0dbb\u0dd4\u0dc0\u0dda \u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0dd2\u0dc0\u0dba \u0db4\u0d9a\u0dd4 \u0dc0\u0dbd\u0dad \u0dba\u0dba\u0dd4\u0dd4 \u0dc5 \u0dc0\u0da2\u0dba\u0dc2\u0d9a\u0da8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dc0\u0dd0\u0dc0\u0dba \u0db4\u0d9a\u0dd4 \u0dc0\u0dbb\u0dd4\u0db1\u0dca\u200d \u0dc0\u0dd2\u0dbb\u0dcf. \u0dc0\u0dda\u0da2\u0dbb\u0dca\u0dbd \u0da2\u0db1\u0dca\u200d\u0dbb\u0dcf\u0dbd\u0dca \u0dd4\u0dc0\u0dbb\u0dd4\u0dcf\u0db1\u0dca \u0dc3\u0dd4\u0dc0\u0dbb\u0dca\u0dbd\u0dc2\u0d9a \u0dad\u0dc0\u0dbd\u0dca \u0dba \u0db4\u0db1\u0dca\u200d \u0dad\u0dd0 \u0db1\u0dca \u0db4\u0dd6\u0dbb\u0dca\u0dbd\u0dc0\u0dbb\u0dd4 \u0daf\u0dd0\u0db1\u0dd4\u0dc0\u0dbb\u0dd4\u0dca \u0db7\u0dcf\u0dc0\u0dbb\u0dd4\u0dc0\u0dba \u0db4\u0db1\u0dca \u0d9a\u0dd4\u0db8\u0db1\u0dca\u200d\u0dbb\u0dab\u0dba \u0db4 \u0dbb \u0d87\u0dad\u0dd2 \u0dcf\u0dc0\u0dbb\u0dd4\u0dca , \u0db4\u0dcf\u0dad\u0d9a\u0d9a\u0dd4 \u0dca\u200d\u0dbb\u0db1\u0dcf\u0dbb\u0dba \u0db4\u0dba \u0dc0\u0db4\u0dbb \u0dc0\u0db1\u0ddd \u0db4\u0dc3\u0dd4 \u0db4\u0dcf\u0dad\u0d9a\u0d9a\u0dd4 \u0dca\u200d\u0dbb\u0db1\u0dcf\u0dbb\u0dc0\u0dda \u0d85\u0dad\u0dd2\u0dba\u0dba \u0db4 \u0dad\u0d82\u0dc0\u0dda\u0daf\u0dd3 \u0db1\u0dcf \u0d86\u0db1\u0dca\u0dc0\u0daf\u0ddd\u0dbd\u0db1\u0dca\u200d\u0dba \u0db4\u0dba \u0dd4\u0da9\u0dd4 \u0daf\u0dd4\u0db1\u0dca \u0db1\u0dca\u0dab\u0dd4 \u0dc0\u0db1\u0dc5\u0dd2\u0daf\u0dbb\u0dda \u0db8\u0dda\u0db8 \u0dc0\u0dbb\u0dd4\u0dd0\u0dc5\u0dd0\u0d9a\u0dca\u0db8\u0dda\u0db8\u0dba \u0dba\u0dba\u0dd4\u0dd4 \u0dbb \u0d87\u0dad\u0dd2 \u0dcf\u0dc0\u0dbb\u0dd4\u0dca , \u0d92 \u0dd4\u0dc5\u0dd2\u0db1\u0dca \u0dd4\u0dc0\u0dbb\u0dd4\u0dcf\u0db1\u0dca \u0dc3\u0dd4\u0dc0\u0dbb\u0dca\u0dbd\u0dc2\u0d9a \u0dad\u0dc0\u0dbd\u0dca \u0dba \u0db4\u0db1\u0dca\u200d \u0dad\u0dd0 \u0db1\u0dca ]979 \u0d85\u0d82 48 \u0daf\u0dbb\u0db1\u0dca\u200d \u200d\u0dbb\u0dad\u0d9a\u0dad\u0dc0\u0dbb\u0dd4\u0dcf\u0daf\u0dba \u0db4 \u0dc0\u0dbb\u0dd4\u0dd0\u0dc5\u0dd0\u0d9a\u0dca\u0db8\u0dda\u0dc0\u0dda (\u0dad\u0dcf\u0dc0\u0dbb\u0dd4 \u0dcf\u0dd2 \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dca\u200d) \u0db4\u0db1\u0dca\u200d\u0dc0\u0dca 2(\u0d8c), 0(\u0d85), (\u0d86), (\u0d87), 5(\u0d85)(i), (ii) \u0dc0\u0dbb\u0dd4\u0dd0\u0db1\u0dca\u0dad\u0dd2 \u0dba \u0db4\u0dba\u0dc0\u0dca \u0dd0\u0dd0\u0dc0\u0db1\u0dca\u200d\u0db1\u0dca\u200d \u0dc0\u0dbb\u0dd4\u0dd0\u0dbb\u0daf\u0dd2 \u0dd2\u0daf\u0daf\u0dd4 \u0dbb.\u0db1\u0dca \u0d8d\u0da2\u0dd4 \u0db1\u0dcf \u0dc0\u0dbb\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0dcf \u0dcf\u0dbb\u0dc0\u0dba \u0db4\u0db1\u0dca \u0d86\u0db0\u0dcf\u0dbb \u0d85\u0db1\u0dd4\u0dcf\u0dbd \u0daf\u0dd3\u0db8 \u0db1\u0dcf \u0d91\u0db8 \u0dad\u0dcf\u0db1\u0dd2\u0daf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0db4\u0dcf \u0dcf\u0dbb \u0dda \u0dd2\u0daf\u0daf\u0dd4 \u0dbb\u0dd3\u0db8\u0db8\u0dba \u0d91\u0d9a\u0dd3 \u0dbb\u0dd2\u0dc0\u0dd0\u0dad \u0dc0\u0db8\u0dc0\u0db1\u0dba \u0db4\u0dc0\u0dd6 \u0dc3\u0dca\u0dda\u0dd0\u0dbd\u0dba \u0db4\u0db1\u0dca, \u0dc3\u0dca\u0dda\u0dd0\u0dbd\u0dba \u0db4\u0db1\u0dca \u0dab\u0dca\u0da9\u0da9\u0dcf\u0dba \u0db4\u0dda \u0dc0\u0db1\u0ddd \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0d9a\u0dc0\u0dbb\u0dd4 \u0dc0\u0db1\u0dc5\u0dd2\u0daf\u0dbb\u0dda \u0db8\u0dda\u0db8 \u0dc0\u0dbb\u0dd4\u0dd0\u0dc5\u0dd0\u0d9a\u0dca\u0db8\u0dda\u0db8\u0dba \u0dba\u0dba\u0dd4\u0dd4 \u0dbb \u0d87\u0dad\u0dd2 \u0dcf\u0dc0\u0dbb\u0dd4\u0dba\u0dca \u0dc0\u0dda \u0dc0\u0dbb\u0dd4\u0db1\u0dca\u200d \u0dc0\u0dd2\u0dba \u0db1\u0dca\u0dab\u0dd4 \u0d85\u0db1\u0dca\u200d\u0dcf\u0dc0\u0dbb\u0dd4\u0dbb\u0dab \u0dc0\u0dc0\u0dbb\u0dd4\u0dbd\u0dcf \u0dad\u0dd2\u0dc0\u0dcf\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf 05. \u0dca\u0db1\u0dad \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dbd\u0dba\u0db1\u0dca\u200d\u0dc0\u0dda\u0daf\u0dd3 \u0d85\u0db1\u0dca\u200d\u0dcf\u0dc0\u0dbb\u0dd4\u0dbb\u0dab \u0dbb\u0db1\u0dca\u200d \u0dbd\u0daf \u0db1\u0dca\u0dab\u0dd4 \u0db8\u0dad"
