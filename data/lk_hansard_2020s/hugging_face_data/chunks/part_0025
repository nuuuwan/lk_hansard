ae\u0bcd\n\n2018 \u0bb8\u0bcd\u0bb0\u0bc0 \u0b99\u0bcd\u0b95\u0bbe \u0bb9\u0ba4\u0baa\u0bbf\u0bc8 \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0b9a\u0b95\u0baa\n\n\u0b95\u0bbf\u0bb0\u0bbe\u0bc8\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b86\u0baf\u0bbf\u0bb0\u0bae\u0bcd \u0b95\u0bc1\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b86\u0baf\u0bbf\u0bb0\u0bae\u0bcd \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd\n\n2019 \u0b95\u0bc8\u0ba8 \u0b85\u0baa\u0bbf\u0bc8\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd \u0ba4\u0bbf\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd\n\n\u2018\u0ba4\u0b9a\u0bcc\u0baa\u0bbe\u0b95\u0bcd\u0b95\u0bbf\u0baf\u2019 \u0bb2\u0ba4\u0b9a\u0bbf\u0baf \u0bb5\u0bc0\u0bbe\u0bcd\u0b9f\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd\u0bb2\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd \u0baa\u0baf\u0bbf\u0bb0\u0bcd\u0b9a\u0bcd\u0ba4\u0b9a\u0baf\u0bcd\u0b95\u0b95 \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd\n\n2022 \u0b95\u0bc8\u0ba4\u0bcd\u0ba4\u0ba4\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd \u0b85\u0b95\u0bc8\u0b9a\u0bcd\u0b9a\u0bc1\n\n\u0bc8\u0bbf\u0bc8\u0b9a\u0bbe\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0b87\u0b95\u0bb3\u0b9e\u0bb0\u0bcd, \u0baf\u0bc1\u0bc8\u0ba4\u0bbf\u0b95\u0b95\u0bb3\u0ba4\u0bcd \u0ba4\u0b95\u0bcd\u0b95\u0b95\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd \u0ba4\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd (\u0b87\u0b95\u0bb3\u0b9e\u0bb0\u0bcd \u0b95\u0bbf\u0bb0\u0bbe\u0bc8\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd)\n\n2023\n\n\u0bc8\u0bbf\u0bc8\u0b9a\u0bbe\u0baf \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0baa\u0bb0\u0bc1\u0ba8\u0bcd\u0bb2\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0b95\u0bcd \u0b95\u0b95\u0ba4\u0bcd\u0ba4\u0ba4\u0bbe\u0bb4\u0bb