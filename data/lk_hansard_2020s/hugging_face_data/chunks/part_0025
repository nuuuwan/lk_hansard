    "chunk_text": "\u0d94\u0db6 \u0db8\u0dd2\u0dc5 \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4\u0dad\u0dca \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0dc3\u0dc4 \u0db4\u0dcf\u0dcf\u0dca\u200d\u0dcf\u0dbd \u0dbb\u0dd3 \u0db1\u0dca\u0da0\u0db1\u0dca \u0dbb\u0d9a \u0d9a\u0dcf\u0dc3\u0dd2 \u0d9a \u0da0\u0daf\u0db4\u0dcf\u0dd0\u0dad\u0dca\u0dca\u200d \u0dc0\u0dcf\u0da0 \u0dbb\u0dd3 \u0dbd\u0dcf \u0d9a \u0dc0\u0dcf\u0da0 \u0db8 \u0dca\u200d\u0db8\u0dba\u0dd2 \u0da0\u0db8\u0dca\u0d9a\u0dad\u0dca \u0dbb\u0dca\u0d9a \u0dd2\u0dba\u0da0\u0db6\u0db1 \u0da0 \u0dba\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0d9a\u0d9a\u0dad\u0dca \u0d9a \u0dc0\u0dcf\u0da0 \u0db8\u0dba\u0dd2 \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2 \u0daf\u0dca\u0db4\u0dcf\u0dca \u0da0 \u0da0\u0d9c\u0dcf\u0da9\u0dca \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4 \u0db8\u0db4\u0dcf\u0da7 \u0db8\u0dca\u200d\u0d9a\u0dba\u0dd2 \u0dbb\u0dd3 \u0db4\u0dd4 \u0d9a\u0dcf\u0dbb \u0dcf \u0db8\u0dd2\u0dc5 \u0d9a\u0dc0\u0dcf\u0da7\u0dad\u0dca \u0dc0\u0dd9\u0db1 \u0dca \u0dbb\u0dd3 \u0dcf\u0da0\u0d9c\u0db1 \u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0db8\u0dd3\u0da7 \u0da0\u0db4\u0dcf\u0dbb \u0d9c\u0dcf\u0dbd\u0dca\u0da0\u0dbd\u0dca \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb \u0d9a\u0dd4 \u0d9a\u0d9c\u0dcf \u0d9a \u0dcf \u0dbb\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0da7 \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0d9c\u0dd0\u0db1 \u0d9a\u0d9c\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0 \u0dbb\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0da0 \u0db4\u0dcf\u0dca \u0d9c\u0dd0\u0db1 \u0d9a\u0d9c\u0dcf \u0d9a\u0dbb\u0db1\u0da0\u0d9a\u0dcf\u0da7 \u0da0\u0db4\u0dcf\u0dcf\u0da0\u0dc4\u0dcf\u0da7\u0dca\u0dd4\u0daf \u0db4\u0dcf\u0dca \u0d9c\u0dd0\u0db1 \u0d9a\u0d9c\u0dcf \u0d9a\u0dbb\u0db1\u0da0\u0d9a\u0dcf\u0da7 \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0d9c\u0dd0\u0db1 \u0d9a\u0d9c\u0dcf \u0d9a\u0dbb\u0db1\u0dca\