\u0dd2 \u0dba\u0db8\u0dba \u0d85\u0db1\u0dd4\u0db8\u0dad \u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0dba.\n\n(\u0d85\u0db8\u0dcf\u0dad\u0dba \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0daf\u0d86 \u0d85\u0db1\u0dd4\u0db8\u0dad\u0dd2\u0dba \u0daf\u0db1\u0dca\u0dd9\u0dcf \u0dad\u0dd2\u0daf\u0db6\u0dca\u0dbd.)\"\n\n\u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba \u0dc0\u0dd2\u0db8\u0dc3\u0db1 \u0dbd\u0dd2\u0db1\u0db1\u0dca\u0dad, \u0dc3\u0db7\u0dcf \u0dc3\u0dda\u0db8\u0dcf \u0dc0\u0dd2\u0dba. \u0bb5\u0bbf\u0ba9\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b9a\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. Question put, and agreed to.\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dda \u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dad \u0db1\u0dd2\u0db8\u0dba\u0ddd\u0d9c \u0dba\u0da7\u0db8\u0dca \u0dbb\u0dab\u0dad\u0dab\u0dba \u0baa\u0bbe\u0bb0\u0bbe\u0bb3\u0bc1\u0bae\u0ba9\u0bcd\u0bb1 \u0ba8\u0bbf\u0bae\u0bc8\u0baf\u0bbf\u0baf\u0bb1\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bb3\u0b95\u0bb3\u0bbf\u0ba9\u0bcd\n\n\u0b95\u0bc0\u0bb4\u0bbe\u0ba9 \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0ba9\u0bae\u0bcd DECISION UNDER THE STANDING ORDERS OF\n\nPARLIAMENT\n\n\u0d9c\u0dbb\u0dd4 \u0d85\u0dd4\u0db4\u0dad \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dad\u0dd2\u0dbd\u0d9a \u0db8\u0dc4\u0dcf\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b85\u0ba9\u0bc1\u0bb0 \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0ba4\u0bbf\u0bc8\u0b95\u0bcd\u0b95) (The Hon. Anura Karunathilaka) \u0d9c\u0dbb\u0dd4 \u0dd2 \u0daf\u0dba\u0ddd\u0da2\u0dba \u0dcf\u0dba \u0dc3\u0db7\u0dcf \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0dd2 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0daf \u0dc3\u0db7\u0dcf\u0db1\u0dcf\u0dba \u0dad\u0dd4\u0db8\u0dcf \u0daf\u0dd9\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dca \u0db8\u0dcf \u0db4\u0dc4\u0dad \u0dc3\u0db3\