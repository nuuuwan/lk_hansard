    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2 \u0dba\u0ddd\u0da2\u0dba \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf \u0dc3\u0db7\u0dcf\u0db4\u0dd8\u0dad\u0dba\u0dda\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba\u0db1\u0dd2, \u0d9c\u0dbb\u0dd4 \u0d87\u0dca\u0dba\u0dda\u0dad\u0dd4\u0db8\u0dca\u0dcf\u0db8\u0db1 \u0dda \u0dc0\u0dbd\u0dcf \u0dda \u0dc3\u0db7\u0dcf \u0dda \u0d89 \u0dad\u0db1\u0dc0\u0dcf0 \u0dca\u0dca \u0dda \u0dc3\u0dda\u0db6 \u0dad\u0db0 \u0dc0 \u0d91\u0dad\u0dd4\u0db8\u0dca\u0dcf \u0dc3\u0dca\u0d9f \u0dd4\u0dc0\u0dbb\u0d9a\u0dae\u0db1 \u0dba\u0dd4\u0dc0\u0db8\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf0 \u0dda \u0dc3\u0dda\u0db6 \u0dad\u0db0\u0dc0 \u0dc3\u0dcf\u0dba\u0dcf \u0db6\u0dbd \u0dad\u0db1 \u0dc0\u0dd2 \u0dba\u0dca\u0dc2 \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0dca\u0d9a\u0dca \u0db4\u0dd8\u0dad\u0dcf \u0dc5\u0dcf \u0dad\u0db1\u0dbb\u0dd4\u0dc0\u0da7 \u0dba\u0dc0 \u0dad\u0db10 \u0dd4\u0dad\u0db9\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca\u0d9a\u0dbb \u0db6\u0dbb \u0d9c\u0dc0\u0db1\u0d9a\u0dca; \u0d85\u0d9a\u0dca\u0d9a\u0dbb .0\u0d9a\u0da7 \u0dc0\u0da9\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dca\u0dcf\u0dc0\u0dba\u0d9a\u0dca \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0 \u0dbb\u0db8\u0db1\u0db1\u0dd2\u0db1\u0dbb\u0dd2 \u0dca \u0dad\u0dd3\u0dad\u0dd4\u0db8\u0dca\u0dcf\u0db8\u0db1 \u0dda \u0dc3\u0dda\u0db6 \u0dad\u0db0\u0dc0 \u0daf\u0dca\u200d\u0dd0\u0dd4\u0dc0\u0dc0\u0db8\u0db1 \u0dc0\u0dbd\u0dcf \u0d89 \u0dad \u0dad0 \u0dca\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dca\u0dcf\u0db8\u0db1 \u0d91\u0d9a\u0dca\u0d9a\u0db8\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf0 \u0d91\u0dad\u0dd4\u0db8\u0dca\u0dcf \u0dca\u0dc4\u0da2\u0db1 \u0daf\u0dd2\u0db1 \u0dc0\u0daf\u0dd3 \u0d92 \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0dca \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0d91\u0dad\u0dd4\u0db8\u0dca\u0dcf\u0dc0 \u0dc4\u0dda\u0db6 \u0dc0\u0dbd\u0dcf \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dca \u0dad\u0dbd\u0dcf\n\n\u0d92 \u0dc0\u0dcf \u0dca \u0d85\u0daf\u0dca\u200d \u0dc0\u0dd3\u0db8 \u0db8\u0dd2\u0dbd \u0dc3\u0dda\u0db6 \u0dad\u0db0 \u0dba\u0dd4\u0dc0\u0db8\u0db1 \u0dbd\u0dcf\u0dd4\u0dad \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba\u0d9a\u0dca \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0 \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2 \u0dba\u0ddd\u0da2\u0dba \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf \u0dc3\u0db7\u0dcf\u0db4\u0dd8\u0dad\u0dba\u0dda\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba\u0db1\u0dd2, \u0dc3\u0dd1\u0dca \u0d9c\u0dcf\u0dc0\u0dd2 \u0dba\u0dd4\u0dad \u0dc5\u0d9f\u0dca \u0dc0\u0dd3\u0db8 \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0 \u0dc0\u0dd3\u0db8 \u0db1\u0dd0\u0dba\u0dda \u0d9c\u0dcf\u0dc0\u0dd2 \u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd00 \u0d8a\u0dc5\u0d9f \u0dca\u0dc4 \u0d9a \u0dad\u0db1\u0dba \u0db4\u0dd8\u0dad\u0da7 \u0dad \u0d9c \u0dad\u0db1\u0d9a\u0dda \u0d9c\u0dcf\u0dc0\u0dd2\u0dba\u0dcf \u0dc0\u0dd3\u0db8 \u0da7\u0dd2\u0d9a \u0d9c\u0daf\u0dca\u200d\u0dbb \u0dba\u0dda\u0dba\u0dcf \u0d9c \u0dad\u0db1\u0dc0\u0dcf0 \u0d92\u0d9a \u0dca\u0dca\u0dba\u0dd2 \u0d9c\u0dcf\u0dc0\u0dd2\u0dba\u0dcf \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dcf\u0d9c\u0dcf\u0dbb\u0dba0 \u0d94\u0dc0\u0dd4 \u0dad \u0d92 \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dcf\u0d9c\u0dcf\u0dbb \u0dba \u0dad \u0dc0\u0dd3\u0db8 \u0d9c\u0ddd\u0db1\u0dd2\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0dd4\u0dad\u0dc0\u0dbd\u0dcf \u0db6 \u0dc4\u0db8\u0db1 \u0da7\u0dd2\u0d9a \u0d9c \u0dad\u0db1\u0dc0\u0dcf, \u0dca\u0dca \u0dad \u0d9c\u0daf\u0dca\u200d\u0dbb \u0d85\u0dc0\u0dba\u0dba\u0dca\u0dcf \u0dc5\u0dd2\u0dbb\u0dd2\u0dca\u0dc4 \u0d9c \u0dad\u0db1\u0dc0\u0dcf, \u0dca\u0dbb\u0dc0\u0dcf\u0db0\u0dcf\u0dbb \u0dc3\u0db8\u0dd2\u0dba\u0dda \u0dc0 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd\u0dca \u0d9c\u0dc0\u0db1\u0dc0\u0dcf, \u0daf\u0dca\u200d\u0dcf\u0db1 \u0daf\u0dca\u200d\u0db1\u0dc0\u0dcf, \u0dca\u0dc5 \u0d9c\u0dba\u0d9a\u0dca \u0dc0\u0dd4 \u0dc0\u0dcf\u0db8\u0db1 \u0dc0\u0dd3\u0db8 \u0d9c\u0ddd\u0db1\u0dd2 \u0daf\u0dca\u200d\u0d9a \u0dad\u0dd4\u0db8\u0db1\u0d9a\u0dca \u0dc0\u0dd2\u0dd4\u0dad\u0dc0\u0dbd\u0dcf \u0d85\u0dc0\u0dba\u0dba \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf0 \u0d85 \u0dad\u0db1 \u0d92 \u0dc0\u0dd3\u0db8 \u0da7\u0dd2\u0d9a\u0da7 \u0dca\u0dca\u0dba\u0dd2 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dca \u0dad\u0dbd\u0dcf \u0db4\u0dd8\u0dad\u0dc4\u0dbb \u0d9c\u0dc4\u0dbd\u0dcf \u0dba\u0dda \u0db6 \u0dad \u0dad0 \u0d9c\u0dcf\u0dc0\u0dd2\u0dba\u0dcf \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dcf\u0d9c\u0dcf\u0dbb \u0dc0 \u0dba\u0dda \u0db6\u0db1 \u0dc0\u0dd3\u0db8\u0dc0\u0dbd\u0da7\u0db8\u0db1 \u0d85\u0daf\u0dca\u200d \u0db8\u0dd2\u0dbd\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd00 \u0dda\u0d9a \u0db4\u0dd8\u0dad\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2 \u0d9a\u0dbb\u0dbd\u0dcf \u0daf\u0dca\u200d \u0dad\u0db1 \u0dc4\u0daf\u0dca\u200d\u0db1 \u0d9a\u0dcf\u0da7, \u0dda \u0d9c\u0dd0\u0db1 \u0d9a\u0dd2\u0dba \u0dad\u0db1 \u0dc4\u0daf\u0dca\u200d\u0db1 \u0d9a\u0dcf\u0da7 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dca \u0dad\u0dbd\u0dcf \u0d85\u0dc5\u0dd2 \u0daf\u0dd2\u0dc4\u0dcf \u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0db6\u0dbd\u0dbd\u0dcf \u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0daf\u0dca\u0dc0\u0dbd\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf0 \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dda \u0dc0\u0dd3\u0db8 \u0db8\u0dd2\u0dbd \u0dc3\u0dda\u0db6 \u0dad\u0db0 \u0dba \u0dad \u0d9c\u0dcf\u0dc0\u0dd2\u0dba\u0dcf\u0da7 \u0d8b\u0db4\u0dd8\u0dad\u0dbb\u0dd2\u0dca \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dc0\u0dba\u0d9a\u0dca \u0d9a\u0dbb \u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dcf \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0dd2\u0db1\u0da7\u0dd2\u0db1\u0dc0\u0dcf0 \u0dca\u0dcf\u0d9a\u0daf\u0dca\u200d, \u0d85\u0dda\u0db4\u0dd8\u0dad\u0dcf \u0dbb\u0dca \u0dda \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0d9c\u0dcf\u0dba\u0dda \u0d9a\u0db4\u0dd8\u0dad\u0db1\u0dc0\u0dcf0 \u0dbb\u0da2\u0dba \u0dbb\u0dd4\u0dc5\u0dd2\u0dba\u0dbd\u0dca 120\u0d9a \u0dc3\u0dc4\u0dba\u0dda\u0d9a \u0db8\u0dd2\u0dbd\u0d9a\u0dca \u0daf\u0dd3\u0dbd\u0dcf \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf \u0db1\u0dda, \u0dda\u0dc5\