    "chunk_text": "\u0d8a\u0dc5\u0d9f \u0dcf\u0dbb\u0dab\u0dba \u0db4 \u0dad\u0db8\u0dba\u0dd2, \u0dc0\u0dc0\u0dbb\u0dd4\u0daf\u0dba\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0db1\u0dca\u0dc0 \u0db4\u0db1\u0dc3\u0dd4 \u0dda \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dc0\u0dbb\u0dd4\u0dca \u0dc0\u0db1\u0dca\u200d\u0dcf\u0db8\u0dda\u0db8 \u0d92 \u0dc0\u0db1\u0d9a\u0dd4\u0dc0 \u0dcf\u0dba\u0dc0\u0dd0\u0db1\u0dca\u200d \u0dad\u0db8\u0dba\u0dd2, \u0dc0\u0dcf\u0dcf\u0dc0\u0db1\u0ddd \u0dc0\u0dd2\u0dba \u0d94\u0dd4\u0db1\u0db1\u0dca \u0dbb\u0dba \u0db1\u0dd0\u0dbb \u0dba \u0db4\u0db1\u0dca\u0dc0\u0db1\u0dca \u0dc0\u0db1\u0daf \u0dc0\u0db1\u0daf\u0dd2\u0dba \u0db4\u0db1\u0dd4\u0dca \u0d91\u0dc0\u0db1\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0d8b\u0daf\u0dcf\u0db1\u0dbb\u0dab\u0dba \u0db4\u0d9a\u0dca \u0dd0\u0dca \u0dc0\u0dad\u0dcf\u0dca , \u0dcf\u0dbd\u0dba \u0db4 \u0dd2\u0daf\u0dba \u0dc0\u0dc0\u0dbb\u0dd4\u0daf\u0dba\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0db1\u0dca\u0dba \u0dbd\u0dcf\u0dcf \u0dc0\u0daf\u0db1\u0dca\u200d \u0dc0\u0dbb\u0dd4\u0dcf\u0db1\u0db1\u0dca\u200d \u0db4\u0dbb\u0dca\u0dbd. \u0d94 \u0d91 \u0daf\u0dd0\u0db1\u0dca \u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dca \u0dc0\u0dbb\u0dd4\u0dcf \u0dad\u0dd2\u0dc0\u0dcf\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf \u0d92 \u0dbb\u0da2\u0dc0\u0dda \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0db4\u0d9a\u0dca \u0d92 \u0dba \u0d85\u0dbb\u0dd2 \u0d91 \u0d9f\u0dba\u0dd2 \u0d92 \u0dbb\u0da2\u0dc0\u0dda \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0db4\u0dba \u0d91 \u0d9f \u0dc0\u0dbb\u0dd4\u0db1\u0dca\u200d \u0d85\u0dad\u0dbb\u0dd4\u0dbb, \u0dc0\u0dda \u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dd4\u0dcf\u0db1\u0db1\u0dca\u200d \u0dca\u200d\u0dbb\u0dba\u0d9a\u0db1\u0dca\u200d\u0dba \u0db4\u0dba \u0dca\u0db1\u0dca\u0db0\u0db1\u0dca\u200d \u0daf\u0dd3\u0db8\u0db1\u0dca\u200d\u0dcf\u0dc0\u0dbb\u0dd4\u0d9a\u0dca \u0dbd\u0dcf\u0dcf \u0daf\u0dd3\u0db8 \u0dc0\u0db1\u0ddd \u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dd4\u0dcf\u0db1\u0db1\u0dca\u200d \u0daf\u0dd3\u0db8\u0db1\u0dca\u200d\u0dcf\u0dc0\u0dbb\u0dd4\u0d9a\u0dca \u0dbd\u0dcf\u0dcf \u0daf\u0dd3\u0db8 \u0dc0\u0dbb\u0dd4\u0dcf\u0dc0 \u0dca\u200d\u0dbb\u0dcf\u0dc0\u0dba \u0db4\u0ddd\u0dd2 \u0dc0\u0dbb\u0dd4\u0dd0\u0da9 \u0dbb\u0dd2\u0dc5\u0dd2\u0dc0\u0dc0\u0dbb\u0dd4\u0dc5 \u0dba \u0dad\u0dc0\u0dbb\u0dd4\u0db8 \u0dc0\u0dda \u0d86\u0dab\u0dca\u0da9\u0da9\u0dd4\u0dc0\u0dbb\u0dd4 \u0d85\u0dc0\u0dbb\u0dd4\u0db0\u0dcf\u0db1\u0dca\u200d\u0dba \u0db4 \u0dc0\u0dba \u0db4\u0dcf\u0db8\u0dd4 \u0dbb\u0dbd\u0dcf \u0db1\u0dca\u200d\u0dd0\u0db1\u0dd0 \u0db1\u0dd0\u0dcf\u0dd0\u0dba\u0dd2, \u0dc0\u0dda \u0d86\u0dab\u0dca\u0da9\u0da9\u0dd4\u0dc0\u0dbb\u0dd4 \u0db8\u0dd6\u0dbd\u0dba \u0dca\u200d\u0dbb\u0dba\u0d9a\u0db1\u0dca\u200d\u0dba \u0db4\u0d9a\u0dca \u0dc0\u0db1\u0dca\u200d\u0dcf\u0db8\u0dd0\u0dad\u0dd2 \u0d86\u0dab\u0dca\u0da9\u0da9\u0dd4\u0dc0\u0dbb\u0dd4\u0d9a\u0dca \u0d92 \u0dad\u0db8\u0dba\u0dd2 \u0dc0\u0dbb\u0dd4\u0dd0\u0daf\u0dd0\u0dca \u0db8 \u0dc0\u0dda \u0db8\u0dd6\u0dbd\u0dba \u0dca\u200d\u0dbb\u0dba\u0d9a\u0db1\u0dca\u200d\u0dba \u0db4\u0d9a\u0dca \u0dad\u0dd2\u0dc0\u0dcf\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf \u0db1\u0dca\u200d\u0dda, \u0d92 \u0d91\u0dc0\u0db1\u0db8 \u0dbb\u0db1\u0dca\u0db1\u0dca\u200d \u0dcf\u0dd0\u0dc0\u0dd0 \u0dc0\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0db1\u0dca\u200d \u0dc3\u0dca\u0dc5\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0db1\u0dca\u200d\u0db8\u0dd4\u0dca , \u0dc0\u0db8\u0dc0\u0db1\u0db8 \u0dd4\u0db1\u0dab\u0dcf\u0db8 \u0dc0\u0dd2\u0dc0\u0daf\u0dad\u0d9a\u0dd0\u0dad\u0dc0\u0dbb\u0dd4 \u0dca\u0db1\u0dca\u0db1\u0dca\u200d \u0dc0\u0dda \u0d9a\u0dca\u0dc0\u0dc2\u0d9a\u200d\u0dbb\u0dba \u0db4\u0dba \u0dad\u0dda\u0dcf\u0db1\u0dca\u0db0 \u0d85\u0dba \u0db4 \u0dba \u0db4\u0dc5\u0dd2 \u0dc0\u0dda \u0dbb\u0dba\u0dba \u0d91\u0db1\u0dca\u0dc0\u0db1\u0dca \u0db1\u0dca\u200d\u0dd0\u0db1\u0dd0 \u0dc0\u0dd2\u0dba\u0dcf\u0dbd \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0dc0\u0dd2\u0dba \u0db4\u0daf\u0dda \u0dbb\u0dbd\u0dcf \u0dad\u0db8\u0dba\u0dd2, \u0dc0\u0dda \u0dc0\u0dc0\u0dbb\u0dd4\u0daf\u0dba\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0db1\u0dca \u0db1\u0dcf \u0dc0\u0db1\u0daf \u0dc0\u0db1\u0daf\u0dd2\u0dba \u0db4\u0db1\u0dca \u0d85\u0dbb\u0dd2 \u0db6\u0dd2\u0dc4\u0dd2 \u0dbb\u0db1\u0dca\u0dc0\u0db1\u0dca \u0d85\u0dc0\u0dda \u0dbb\u0dba \u0d87\u0dd4\u0dc0\u0dc5\u0d9a \u0dc3\u0dca\u0dbb\u0dda\u0db4\u0dcf\u0da9\u0dd4 \u0db4\u0dc0\u0dbb\u0dd4\u0dad\u0dd2\u0db1\u0dca\u200d \u0dc0\u0dd2\u0dba \u0d92 \u0d85\u0dba \u0db4 \u0dc0\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u200d\u0dca \u0dbb\u0dba\u0dc0\u0dbb\u0dd4\u0dbd \u0dc0\u0dad\u0d9a\u0dc0\u0dbb\u0dd4\u0dba \u0db4 \u0dbb\u0db1\u0dca\u200d \u0db1\u0dd2\u0dad\u0dcf, \u0d92 \u0d85\u0dba \u0db4\u0dc0\u0dbb\u0dd4 \u0dc0\u0dd0\u0db1\u0dca\u0dc0\u0dbb\u0dd4\u0dcf \u0dd0\u0dd0\u0dd3\u0db8\u0db8 \u0dad\u0db3\u0db1\u0dcf \u0dc0\u0dd6 \u0dc0\u0dbb\u0dd4\u0dd0\u0da9 \u0dbb\u0dd2\u0dc5\u0dd2\u0dc0\u0dc0\u0dbb\u0dd4\u0dc5\u0d9a\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dba\u0dc0\u0dda \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dc0\u0dd0 \u0db8 \u0d94\u0dba.\u0db1\u0dca, \u0dc3\u0dd4\u0db8\u0dba\u0dc0\u0dbb\u0dd4 \u0dd2\u0daf\u0dda\u0db0 \u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dca \u0db1\u0dca\u200d\u0dd0\u0db1\u0dd0 \u0dbb\u0dd3\u0dba \u0db4\u0db1\u0dca\u200d \u0dc0\u0da0\u0ddd\u0daf\u0db1\u0dca\u200d\u0dcf\u0dc0\u0dbb\u0dd4\u0dca \u0db8\u0dc0 \u0db4\u0dd0\u0dca \u0dc0\u0dad\u0db1\u0dca \u0dbb\u0da2\u0dba \u0db4\u0dba \u0dca\u0daf\u0dd2\u0dc0\u0dd0\u0db4\u0dca \u0dbb\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf \u0d92 \u0dbb\u0dd3\u0dba \u0db4\u0db1\u0dca\u0dc0\u0db1\u0dca \u0dbb\u0dcf\u0da2\u0dba \u0dc0\u0dad\u0d9a\u0dc0\u0dbb\u0dd4 \u0dba\u0dd2\u0db1\u0dca\u0dba, \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dba \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dc0\u0dd0\u0db1\u0dca\u0dba \u0d85\u0dd4\u0db1\u0db1\u0dca\u0daf\u0dd4 \u0dd0\u0dab\u0db1\u0dca\u200d\u0dcf\u0dc0\u0dbb\u0dd4 \u0dca\u0db3\u0dbd\u0dcf \u0dc0\u0dda \u0dca\u200d\u0dbb\u0dba\u0d9a\u0db1\u0dca\u200d\u0dba \u0db4 \u0db1\u0dd2\u0dad\u0dcf \u0dc0\u0dbb\u0ddd\u0db1\u0dbd\u0dca \u0db4\u0dda\u0db0\u0dad\u0dd2\u0dc0\u0dda \u0db4\u0dd0\u0dc0\u0dbb\u0dd4\u0dad\u0dd2 \u0dc3\u0dca\u0dbb\u0dda\u0db4\u0dcf\u0da9\u0dd4 \u0dc0\u0dda \u0d86\u0dab\u0dca\u0da9\u0da9\u0dd4\u0dc0\u0dbb\u0dd4 \u0dba \u0db4\u0dba\u0dc0\u0dca \u0dad\u0dc0\u0dbb\u0dd4\u0db8 \u0dad\u0dda\u0db4\u0dd6\u0dbb\u0dca\u0dbd\u0dab \u0dc0\u0dc0\u0dbb\u0dd4\u0dbd\u0dcf \u0db1\u0dca\u200d\u0dd0\u0db1\u0dd0 \u0dbb\u0dd3\u0dba \u0db4\u0db1\u0dca\u200d \u0d91 \u0dca \u0dc0\u0dda \u0dc0\u0dc0\u0dbb\u0dd4\u0dbd\u0dcf\u0dc0\u0dda \u0db8\u0db8 \u0dbb\u0dd3\u0dba \u0db4\u0db1\u0dca\u0db1\u0dca\u200d \u0dd1\u0db1\u0dca\u200d\u0dd1 \u0d92 \u0dc0\u0dda \u0d86\u0dab\u0dca\u0da9\u0da9\u0dd4\u0dc0\u0dbb\u0dd4\u0dba \u0dc0\u0db4\u0dbb \u0d86\u0dab\u0dca\u0da9\u0da9\u0dd4\u0dc0\u0dbb\u0dd4\u0dbd \u0dca\u0db3\u0db1\u0dca\u0db8, economic crisis \u0d91\u0dc0\u0d9a\u0dca \u0dca\u0db3\u0db1\u0dca\u0db8 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dad\u0dca \u0dca \u0dc0\u0dbb\u0dd4\u0dba \u0db4\u0d9a\u0dca"
