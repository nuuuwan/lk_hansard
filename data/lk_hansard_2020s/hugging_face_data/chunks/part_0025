    "chunk_text": "\u0d9a\u0dd2\u0dbb\u0dd3\u0dda \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf; \u0d9c\u0dcf\u0da9\u0db1\u0dd0\u0d9f\u0dd2\u0dd2 \u0d89\u0daf\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dda \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf0 \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0db4\u0dd8\u0dad\u0dbb\u0dd2\u0dc3\u0dbb\u0dba \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a \u0dc5\u0dca \u0d9c\u0dda\u0dc0\u0dbd \u0d89 \u0dad\u0db1 \u0d85\u0dbb \u0d9a\u0dd2\u0dba\u0daf\u0dca \u0dc3\u0dcf\u0dca\u0dcf\u0db1\u0dba \u0daf\u0dca\u0d82\u0da0\u0dd2 \u0db4\u0dd8\u0dad\u0dbb\u0dd2\u0dc3\u0dbb \u0dda\u0daf\u0dd2 \u0dad0 \u0db1\u0db8\u0dd4\u0db8\u0db1, \u0d92 \u0dca\u0db8\u0db1\u0db8\u0db1\u0dc0\u0dba \u0dc0\u0db1\u0dc3\u0dca \u0dc0\u0db1\u0dc0\u0dcf, 2024 \u0dc3\u0dd0\u0dda\u0dca\u0dd0\u0dda\u0db6\u0dbb\u0dca 21\u0dc0\u0db1 \u0daf\u0dca\u200d\u0dcf\u0dba\u0dd2 \u0dad \u0db4\u0dd8\u0dad\u0dc3\u0dd4\u0dc00 \u0d91\u0db6\u0db3 \u0dc0, \u0d9c\u0dda\u0dc0\u0dbd \u0dca\u0dca \u0dca\u0dca\u0dba \u0db1\u0dd2 \u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dd2 \u0dad \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dc5 \u0db4\u0dd8\u0dad\u0dbb\u0dd2\u0dc3\u0dbb \u0dda\u0daf\u0dd2 \u0dad \u0d92 \u0dca\u0dca\u0dba \u0daf\u0dca\u0dba\u0db4\u0dd8\u0dad\u0dcf\u0dbd\u0db1 \u0db4\u0dd8\u0dad\u0dbb\u0dd2\u0dc0\u0dbb\u0dca\u0dca\u0db1\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0db8 \u0dc5\u0dca \u0daf\u0dca\u0dba\u0db4\u0dd8\u0dad\u0dcf\u0dbd\u0db1 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0dad\u0dd4\u0db8\u0dc5\u0da7 \u0d91\u0db1\u0dc0\u0dcf; \u0d91\u0dba \u0d91\u0dca \u0daf\u0dca\u0dba\u0db4\u0dd8\u0dad\u0dcf\u0dbd\u0db1 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dcf\u0dbb \u0dc0 \u0db1\u0dba\u0dcf\u0dba \u0db4\u0dd8\u0dad\u0dad\u0dca\u200d\u0dbb\u0dba \u0dad\u0dd4\u0db8\u0dc5 \u0d85 \u0dad\u0dca\u0dbb\u0dca\u0d9c\u0dca \u0dc0\u0db1\u0dc0\u0dcf0 \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dca\u0dca\u0dba\u0dd2 \u0dd2\u0d9a\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0dca \u0dad\u0dd3\u0dad\u0dd4\u0db8\u0dca\u0db1\u0dd2, 1980 \u0d9c\u0db1 \u0d86 \u0da2\u0dcf\u0dba\u0dda\u0d9a \u0db4\u0dd8\u0dad\u0dcf\u0dbb\u0dd2\u0dc3\u0dbb\u0dd2\u0d9a \u0db4\u0dd8\u0dad\u0db1\u0dca \u0dc3\u0dc4 \u0d91\u0dca \u0db4\u0dd8\u0dad\u0db1\u0dca\u0da7 1988\u0daf\u0dd3 \u0dc3\u0dc4 2000\u0daf\u0dd3 \u0d9c\u0db1 \u0d86 \u0dc3\u0d82 \u0dba\u0ddd\u0db0\u0db1 \u0db4\u0dd8\u0dad\u0db1\u0db8\u0db1 \u0d89\u0d9a\u0dca\u0dca\u0dc0\u0dcf \u0db1\u0dc0 \u0dca\u0db8\u0db1\u0db8\u0db1\u0dc0\u0dba \u0dad\u0da7 \u0d9c\u0dd0\u0dc5 \u0db4\u0dd8\u0dad\u0db1 \u0dc0\u0dd2\u0db0\u0dd2 \u0dc0 \u0d85\u0dbd\u0dd4\u0db8\u0db1, \u0daf\u0dca\u200d\u0dd0\u0da9\u0dd2 \u0db4\u0dd8\u0dad\u0dbb\u0dd2\u0dc3\u0dbb \u0dc3\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dc0 \u0dd3\u0dad\u0dba\u0dda \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0db8\u0db1 \u0d9a\u0dbb\u0dbd\u0dcf \u0dc0\u0db8\u0db1\u0dca \u0dad \u0d86\u0dab\u0dca\u0dd4\u0dc0\u0dc0 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0dc5\u0dd2 \u0dca\u0dca \u0da2\u0dcf\u0dba\u0dda\u0d9a \u0db4\u0dd8\u0dad\u0dcf\u0dbb\u0dd2\u0dc3\u0dbb\u0dd2\u0d9a (\u0dc3\u0d82 \u0dba\u0ddd\u0db0\u0db1) \u0db4\u0dd8\u0dad\u0db1\u0db8\u0db1 \u0d9a\u0da7\u0dd4\u0dda\u0db4\u0dd8\u0dad\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd8\u0dad\u0db8\u0db1 \u0d9a \u0dc5\u0dca0 \u0d91\u0dba \u0d85 \u0dda \u0d93\u0dba\u0dda\u0dc4\u0dcf\u0dd2\u0db1\u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0d9a\u0dca\u0d9a\u0dca \u0dc3\u0dc4 \u0dc0\u0d9c\u0d9a\u0dd3\u0dca\u0d9a\u0dca \u0dc0\u0db1\u0dc0\u0dcf0 \u0dd2\u0d9a\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0dca \u0dad\u0dd3\u0dad\u0dd4\u0db8\u0dca\u0db1\u0dd2, \u0d85 \u0dda \u0d86\u0dab\u0dca\u0dd4\u0dc0 \u0dda \u0d92 \u0dc0\u0d9c\u0d9a\u0dd3\u0dca \u0d85\u0dc5\u0dd2 \u0d85\u0daf\u0dca\u200d \u0daf\u0dd2\u0db1 \u0d89\u0dc2\u0dca\u0da7 \u0d9a\u0dbb\u0dbd\u0dcf \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0\n\n\u0dbd\u0d82\u0d9a\u0dcf \u0dda \u0d9c\u0d82\u0d9c\u0dcf 103\u0d9a\u0dca \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf; \u0d92 \u0dc0\u0dcf \u0dca \u0dc0\u0dd2\u0dba\u0dcf\u0dbd \u0da2\u0dbd\u0dcf\u0dba \u0db4\u0dca\u200d\u0dbb\u0dca\u0dcf\u0dc0\u0dba\u0d9a\u0dca \u0daf\u0dca\u200d \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0 \u0dca\u0db0\u0dba\u0dca \u0d9a\u0dd4\u0db1\u0d9a\u0dbb\u0dba \u0d86\u0daf\u0dd2 \u0dba \u0dad \u0db4\u0dd8\u0dad\u0da7 \u0dad \u0d9c\u0db1 \u0d92 \u0d9c\u0d82\u0d9c\u0dcf 103 \u0d94\u0dc3\u0dca \u0dc3\u0dca \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dca\u200d\u0da7 \u0d9c\u0dbd\u0dcf \u0d9c\u0db1 \u0dba \u0dad \u0dad \u0da2\u0dbd\u0dba \u0dc0\u0dd2\u0dca\u0dbb\u0d9a\u0dca \u0db1\u0dcf \u0dc0\u0dba\u0dd2, \u0dd2\u0d9a\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0dca \u0dad\u0dd3\u0dad\u0dd4\u0db8\u0dca\u0db1\u0dd20 \u0d92 \u0dc3\u0dca\u0d9f \u0dda\u0dbd\u0dcf\u0dc3\u0dca\u0da7\u0dd2\u0d9a\u0dca, \u0db4\u0dd8\u0dad\u0dcf\u0dd2\u0dba\u0dda \u0dad \u0d86\u0daf\u0dd2\u0dba\u0db8\u0db1 \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0 \u0daf\u0dca\u200d\u0dd0\u0dc0\u0dd0 \u0dad\u0dca \u0dda\u0dbd\u0dcf\u0dc3\u0dca\u0da7\u0dd2\u0d9a\u0dca \u0d9a \u0dad\u0daf\u0dca\u200d\u0d9a\u0dca \u0dda \u0dca\u0dc4\u0dcf \u0dc3\u0dcf\u0d9c\u0dbb\u0dba\u0da7 \u0d91\u0d9a\u0dad\u0dd4\u0db8 \u0d9a\u0dbb\u0db8\u0dd2 \u0dad \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0 Microplastics \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dd2\u0dba\u0dcf\u0dbd \u0d85\u0db4\u0dd8\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dba \u0db4\u0dca\u200d\u0dbb\u0dca\u0dcf\u0dc0\u0dba\u0d9a\u0dca \u0d9c\u0dcf\u0da9 \u0d9c\u0dd0 \u0dc3\u0db8\u0dd2 \u0dad \u0d85 \u0dda \u0dbb \u0da7\u0dca \u0db4\u0dd8\u0dad\u0dbb\u0dd2\u0dc3\u0dbb \u0db4\u0dd8\u0dad\u0daf\u0dca\u0db0\u0dba\u0dda\u0dba \u0dc0\u0dcf \u0dca \u0da2\u0dd3\u0dc0\u0dd2 \u0dad \u0da2\u0dd3\u0dc0\u0dd2\u0dca\u0db8\u0db1 \u0dc0\u0dd2\u0db1\u0dcf\u0dba \u0d9a\u0dbb\u0db8\u0dd2 \u0dad \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0 \u0d92 \u0db1\u0dd2\u0dc3\u0dcf microplastics \u0dc5\u0dd2\u0db6\u0db3\u0db6 \u0dc0, \u0db1\u0dd0\u0dc0\u0dca \u0db1\u0dd0\u0dc0\u0dca \u0db7\u0dcf\u0dc0\u0dd2\u0dca \u0d9a\u0dc5 \u0dc4\u0dd0\u0d9a\u0dd2 \u0d91\u0dca \u0daf\u0dca\u0dc0\u0dbd\u0dca \u0dc5\u0dd2\u0db6\u0db3\u0db6 \u0dc0 \u0d85\u0dc5\u0dd2 \u0dc0\u0dd0\u0daf\u0dca\u200d\u0d9c\u0db8\u0db1 \u0dc3\u0d82 \u0dba\u0ddd\u0db0\u0db1 \u0dda \u0db4\u0dd8\u0dad\u0db1\u0db8\u0db1 \u0d9a\u0da7\u0dd4\u0dda\u0db4\u0dd8\u0dad\u0dca \u0dad\u0dd4\u0db8\u0dc5\u0da7 \u0d85 \u0dad\u0dca\u0dbb\u0dca\u0d9c\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0\n\n\u0dd2\u0d9a\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0dca \u0dad\u0dd3\u0dad\u0dd4\u0db8\u0dca\u0db1\u0dd2, \u0d92 \u0dc0\u0dd2\u0dca\u0dbb\u0d9a\u0dca \u0daf\u0dca\u200d \u0db1\u0dcf \u0dc0\u0dba\u0dd20 \u0db4\u0dd8\u0dad\u0dbb\u0dd2\u0dc3\u0dbb\u0dba\u0da7 \u0d9a\u0dcf\u0db6 \u0dad\u0da9 \u0dba\u0dcf\u0d9a\u0dca\u0dc3\u0dba\u0dd2\u0da9\u0dca \u0dc5\u0dd2\u0da7 \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0d9c\u0db8\u0db1 \u0dca\u0dcf\u0db8\u0db1, \u0d85 \u0dda \u0dbb \u0da7\u0dca \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0d9a\u0da7 \u0dc5\u0dd2\u0da7 \u0d9a\u0dbb\u0db1 \u0d9a\u0dcf\u0db6 \u0dad\u0da9 \u0dba\u0dcf\u0d9a\u0dca\u0dc3\u0dba\u0dd2\u0da9\u0dca \u0db4\u0dca\u200d\u0dbb\u0dca\u0dcf\u0dc0 \u0dba \u0dad \u0dd2\u0db1\u0dba\u0dba\u0da7 4.\u0d9a\u0dca \u0dc5\u0dd2\u0da7 \u0dc0 \u0dad \u0dad \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0d9a\u0dca \u0dc2\u0dca\u0dad\u0dca\u200d\u0dbb\u0dba \u0dad\u0dd4\u0db8\u0db6\u0db3 \u0dad \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0da5 \u0dba\u0ddd \u0dc3\u0dcf\u0dba\u0dcf \u0d9c\u0db1 \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0 \u0d92 \u0dc5\u0dd2\u0da7 \u0d9a\u0dbb\u0db1 \u0d9a\u0dcf\u0db6 \u0dad\u0da9 \u0dba\u0dcf\u0d9a\u0dca\u0dc3\u0dba\u0dd2\u0da9\u0dca \u0db4\u0dca\u200d\u0dbb\u0dca\u0dcf\u0dc0\u0dba 2032 \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0dd2\u0db1\u0dba\u0dba\u0da7 40\u0d9a\u0dd2 \u0dad \u0d85\u0dd4\u0dc0 \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0dc3 \u0dc4\u0dcf \u0d85\u0dc5\u0dd2 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd4\u0dda \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0 \u0d92 \u0dc3 \u0dc4\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0d9a\u0dca \u0dc2\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0 \u0dc0\u0dd2\u0dd4\u0dc0\u0dd2 \u0dd4\u0dc0\u0dda\u0dbb\u0dd2\u0dba \u0db4\u0dd8\u0dad\u0daf\u0dca\u0db0\u0dba\u0dda\u0dba\u0d9a\u0dca \u0d87\u0dba\u0dda \u0d9a\u0dbb \u0dad\u0db1 \u0dc0\u0dcf \u0dca \u0d85 \u0dda \u0daf\u0dca\u0db1\u0dbb\u0dca\u0da2\u0db1\u0dd3\u0dad\u0dba \u0db6\u0dbd\u0dba\u0d9a\u0dca\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0db7\u0dc0\u0dc0\u0dbd\u0da7 \u0db4\u0dd8\u0dad\u0dc0 \u0daf\u0dca\u200d \u0dad\u0db1 \u0d85\u0dc5\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dbb\u0db8\u0dd2 \u0dad \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0 \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dca, \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0dca\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dca\u0dc0 \u0d85\u0db1\u0dcf\u0d9c\u0dca \u0daf\u0dca\u200d\u0dbb\u0dd4\u0dc0 \u0dad \u0dc0\u0dd4\u0dc0 \u0dc0 \u0dad \u0db4\u0dd8\u0dad\u0dbb\u0dd2\u0dc3\u0dbb \u0db4\u0dd8\u0dad\u0daf\u0dca\u0db0\u0dba\u0dda\u0dba \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0dc3 \u0dc4\u0dcf \u0d86\u0dab\u0dca\u0dd4\u0dc0\u0dc0 \u0dda \u0d86\u0d9a\u0dcf\u0dbb \u0dba \u0dad \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dbb\u0db8\u0dd2 \u0dad \u0dba\u0dda \u0db6\u0db1\u0dc0\u0dcf0"
