    "chunk_text": "\u0dc0\u0dda \u0d86\u0dab\u0dca\u0da9\u0da9\u0dd4\u0dc0\u0dda \u0d85 \u0dcf\u0dbb\u0dca\u0dbd\u0dba \u0db4\u0d9a\u0dca\u0dc2\u0db8\u0dad\u0dcf\u0dc0\u0dbb\u0dd4 \u0dd0\u0dd0\u0db1\u0dca\u200d \u0db8\u0db8 \u0dbb\u0dd3\u0dba \u0db4\u0db1\u0dca\u0db1\u0dca\u200d \u0dba \u0db4\u0db1\u0dca\u0dc0\u0db1\u0dca \u0db1\u0dca\u200d\u0dd0\u0db1\u0dd0 \u0d8b\u0daf\u0dcf\u0db1\u0dbb\u0dab\u0dba \u0db4\u0d9a\u0dca \u0dd0\u0dca \u0dc0\u0dad\u0dcf\u0dca , \u0dc0\u0db8\u0ddd\u0dba\u0dbb\u0dca\u0dbd \u0dbb\u0dae \u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dd4\u0dcf\u0db1\u0db1\u0dca\u200d \u0dc0 \u0dcf\u0db8\u0dad\u0dcf\u0dc0\u0dd0\u0dad\u0d9a \u0da2\u0db1\u0dca\u200d\u0dbb\u0dcf\u0dbd\u0dca \u0d85\u0dca \u0d85\u0da9\u0d82\u0d9c\u0dd4\u0dc0\u0dbb\u0dd4\u0dba \u0db4\u0dca \u0dd4\u0db1\u0dab\u0dcf \u0daf\u0dd0\u0db1\u0dca replacement \u0d91 \u0d9a\u0dca \u0daf\u0dcf\u0dd0\u0db1\u0dca\u0db1\u0dca\u200d \u0dcf\u0dd0\u0db1\u0dd0; \u0dad\u0dc0\u0dbb\u0dd4\u0db8 \u0dad\u0db1\u0dca\u200d\u0dd4\u0dbb \u0dc4\u0dd2\u0dad\u0d9a \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0dbb\u0dc0\u0dba \u0db4\u0d9a\u0dca \u0dca\u0dbd\u0dca\u0dbd\u0dcf \u0d85\u0dad\u0d9a\u0dd4\u0db1\u0dab\u0dcf, \u0d85\u0dd4 \u0dad\u0dd2\u0db1\u0dca \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0dbb\u0dc0\u0dba \u0db4\u0d9a\u0dca \u0daf\u0dcf\u0db1\u0dca\u0db1\u0dca\u200d \u0dcf\u0dd0\u0db1\u0dd0 \u0dca\u0db1\u0dca\u0db1\u0dca\u200d \u0dc0 \u0dc0\u0db1\u0dca\u200d\u0d9a\u0dca \u0daf\u0dcf\u0db1\u0dca\u200d\u0dc0\u0dbb\u0dd4\u0dcf, \u0dc0\u0dbb\u0dd4\u0dd0\u0da9 \u0dcf\u0dbd\u0db1\u0dca\u0db1\u0dca\u200d \u0dc0\u0dda \u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0db4\u0dba \u0d86\u0dba \u0db4\u0dad\u0db1\u0dca\u200d \u0dd0\u0dab\u0db1\u0dca\u200d\u0dcf\u0dc0\u0dbb\u0dd4 \u0dba \u0dd4\u0db1\u0db1\u0dca\u0dc0\u0dbb\u0dd4\u0dca \u0db4\u0dca \u0dbb\u0dbd\u0dcf \u0db1\u0dca\u200d\u0dd0\u0db1\u0dd0\n\n\u0dbb\u0dcf\u0da2\u0dba \u0d92 \u0dcf\u0db0\u0dd2 \u0dcf\u0dbb\u0dba \u0db4 - monopoly - \u0dad\u0dd2\u0dc0\u0dcf\u0db1\u0dca\u200d \u0dad\u0