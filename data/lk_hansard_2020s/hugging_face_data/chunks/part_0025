 \u0dd4\u0dab\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc3\u0dc4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dd4\u0dab\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dc0\u0db4\u0dcf\u0da0 \u0dba\u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0db4\u0dd4\u0dc4\u0dd4\u0dd4\u0db8 \u0d9a\u0dbb \u0d87\u0dca\u200d \u0dbb\u0db8\u0d9f\u0dd2\u0db1\u0dca \u0daf\u0dca\u0da0\u0dba\u0dda \u0db8\u0dc0\u0dba\u0dba\u0dca\u200d\u0dcf \u0dc3\u0dd2\u0dc0\u0dca\u200d \u0dc3\u0dd2\u0dc3\u0dd4\u0db1\u0dca\u0da0 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0d9a\u0dd4\u0dc3\u0dbd\u0dca\u200d\u0dcf \u0d89\u0dc4 \u0db1\u0dcf\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7\u0dad\u0dca \u0d9a \u0dc3 \u0dc4\u0dcf \u0dc3\u0dc4\u0db7\u0dcf\u0dd2\u0dab\u0dad\u0dca\u0dc0 \u0d89\u0dc4 \u0db1\u0dcf\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7\u0dad\u0dca \u0db8\u0dc0\u0dc3\u0dda\u0d9c\u0dcf\u0dc0 \u0dbd\u0dd0\u0db6\u0dd3 \u0d87\u0dca\u200d\n\n\u0dbb\u0da0\u0dc3\u0dda\u0db8 \u0db8\u0daf\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dca\u200d\u0dbb\u0d9c \u0db4\u0dcf\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0da0\u0db8\u0dca \u0daf\u0dd3 \u0daf\u0dca\u0da0\u0dba\u0dda \u0db8\u0dc0\u0dba\u0dba\u0dca\u200d\u0dcf \u0dc3\u0dd2\u0dc0\u0dca\u200d \u0dc3\u0dd2\u0dc3\u0dd4\u0db1\u0dca\u0da0 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dc3 \u0dc4\u0dcf \u0db7\u0dcf\u0daf\u0dca\u0dca\u200d \u0d9a\u0dbb\u0db1 \u0dc0\u0db4\u0dcf\u0d9a\u0dbb \u0da0\u0db8\u0db1\u0dca\u0db8 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0da0 \u0d9c\u0dba \u0db4\u0dcf\u0dbb\u0dd2\u0daf\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dd2\u0dc5\u0da7\u0dd2 \u0dc3\u0dd0\u0d9a\u0dc3\u0dd3\u0db8 \u0daf \u0dc3\u0dd2\u0dd4\u0dbb\u0d9a\u0dbb\u0dd4 \u0dbd\u0db6\u0db1 \u0db6\u0dc0\u0dad\u0dca \u0db8\u0db0\u0dba\u0dcf\u0db4\u0dcf\u0db1 \u0dc0\u0dc3\u0dc3\u0dda \u0db8\u0db0\u0dba\u0dcf\u0db4\u0dcf\u0db1 \u0dc4\u0dcf \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd3 \u0db8\u0db0\u0dba\u0dcf\u0db4\u0dcf\u0db1 \u0db8\u0db8\u0dcf\u0dca\u200d\u0dba\u0dcf\u0dcf\u0dba \u0daf\u0dca\u0dc3\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0dd4 \u0db8\u0dca \u0daf\u0dd3 \u0d87\u0dca\u200d\n\n(iii) \u0daf\u0dd0\u0db1\u0da7 \u0d89\u0daf\u0dd2\u0d9a\u0dbb \u0d87\u0dd2\u0dba \u0dc3\u0dcf\u0d9a\u0dd3\u0dbb\u0dca\u0dbd \u0db1\u0dca \u0dc3 \u0dc4\u0dcf \u0d86\u0db6\u0dcf\u0db0\u0dd2\u0dca\u200d \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da2\u0dd2\u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0da7 \u0db4\u0dca\u200d\u0dbb\u0da0\u0dda\u0dba \u0db4\u0dcf\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0db8\u0dd4 \u0dd2\u0dba\u0db1\u0dca \u0dc3\u0dda\u0d9c\u0dcf\u0db4\u0dcf\u0db1 \u0dbb\u0dd3\u0db8\u0dda\u0db8\u0da7 \u0d87\u0dd2\u0dba \u0dc4\u0dd0\u0dbb\u0dd3 \u0dcf\u0dc0 \u0dd2\u0dc5\u0dd2\u0db6\u0db6 \u0dc0 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dbb\u0da0\u0d9c\u0db1 \u0dd4 \u0dbd\u0db6\u0db1 \u0db8\u0dca\u200d\u0dbb \u0db8\u0dd4 \u0dd2\u0dba\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dc0\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dc3\u0dcf\u0d9a\u0dd3\u0dbb\u0dca\u0dbd \u0dc3 \u0dc4\u0dcf \u0da0\u0db8\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd3 \u0da2\u0dd2\u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0da7 \u0db8\u0dc0\u0dba\u0dba \u0db4\u0dca\u200d\u0dbb\u0da0\u0dda\u0dba \u0db4\u0dcf\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc4\u0dcf \u0da0\u0dc0\u0db1\u0dad\u0dca \u0db4\u0dcf\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0d9a\u0dc3\u0dda \u0dbb\u0dd3\u0db8\u0dda\u0db8\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dc3\u0dcf\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1 \u0da0\u0daf\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dca\u200d\u0da0\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0 \u0daf\u0dca\u0dc3\u0dd2\u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dbb\u0dd4 \u0dbd\u0dd0\u0da0\u0dda \u0db8\u0db0\u0dba\u0dcf\u0db4\u0dcf\u0db1 \u0dc0\u0dc3\u0dc3\u0dda \u0db8\u0db0\u0dba\u0dcf\u0db4\u0dcf\u0db1\n\n\u0dc4\u0dcf \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd3 \u0db8\u0db0\u0dba\u0dcf\u0db4\u0dcf\u0db1 \u0db8\u0db8\u0dcf\u0dca\u200d\u0dba\u0dcf\u0dcf\u0dba \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0daf\u0dca\u0da0\u0dba\u0dda \u0db8\u0dc0\u0dba\u0dba\u0dca\u200d\u0dcf \u0dc3\u0dd2\u0dc0\u0dca\u200d \u0dc3\u0dd2\u0dc3\u0dd4\u0db1\u0dca \u0dc3 \u0dc4\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dca\u200d\u0dbb\u0d9c \u0db4\u0dcf\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0da0\u0db8\u0dca\u0daf\u0dd3 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dd2\u0dc5\u0da7\u0dd2 \u0dc3\u0dd0\u0d9a\u0dc3\u0dd3\u0db8 \u0dc3\u0dc4 \u0db4\u0dcf\u0dbb\u0dd2\u0dc3\u0dbb \u0dc3\u0dd0\u0d9a\u0dc3\u0dd3\u0db8 \u0d9a \u0dc3 \u0dc4\u0dcf \u0da0 \u0da7\u0dbd\u0dca\u200d \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dc0\u0db4\u0dcf\u0d9a\u0dbb \u0db7\u0dcf\u0daf\u0dca\u0dca\u200d \u0dd2\u0dc5\u0dd2\u0db6\u0db6 \u0db4\u0dcf \u0dcf\u0dad\u0dca \u0dc3\u0dc4 \u0d9a\u0dbd\u0dcf\u0db4\u0dcf \u0daf\u0dca\u0da0\u0dba\u0dda \u0db8\u0db0\u0dba\u0dcf\u0db4\u0dcf\u0db1 \u0dc3\u0dc4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0daf\u0dca \u0db7\u0dcf\u0dbb \u0db1\u0dd2\u0da0 \u0da2\u0dba \u0dc3\u0dc4 \u0dc3\u0dc4\u0d9a\u0dcf\u0dbb \u0db8\u0db0\u0dba\u0dcf\u0db4\u0dcf\u0db1 \u0db8\u0db0\u0dba\u0dca \u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dc0\u0db4\u0dcf\u0da0 \u0dba\u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dd4\u0dab\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc3\u0dc4 \u0daf\u0dca\u0da0\u0dba\u0dda \u0db8\u0db0\u0dba\u0dcf\u0db4\u0dcf\u0db1 \u0dc3\u0db8\u0dca\u0db4\u0dcf\u0dad\u0dca\u0daf\u0dcf \u0d9a \u0dd4\u0dab\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0db4\u0dd4\u0dc4\u0dd4\u0dd4\u0db8 \u0d9a\u0dbb \u0d87\u0dca\u200d\n\n\u0daf\u0dca\u0da0\u0dba\u0dda \u0db8\u0db0\u0dba\u0dcf\u0db4\u0dcf\u0db1 \u0d9a\u0d9a\u0d9a \u0dc3\u0dd2\u0dc0\u0dca\u200d \u0db4\u0dcf\u0dcf\u0dc3\u0dbd\u0dca\u0dc0\u0dbd\u0da7 \u0daf\u0dca\u0da0\u0dba\u0dda \u0db8\u0db0\u0dba\u0dcf\u0db4\u0dcf\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0db4\u0dd4\u0dc4\u0dd4\u0dd4\u0db8\u0dc0 \u0dc3 \u0dc4\u0dcf \u0db8\u0dc0\u0dba\u0dba \u0dc0\u0db4\u0dcf\u0d9a\u0dbb \u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf \u0dca\u0daf \u0db8\u0db0\u0dba\u0dcf\u0db4\u0dcf\u0db1 \u0dc0\u0dc3\u0dc3\u0dda \u0db8\u0db0\u0dba\u0dcf\u0db4\u0dcf\u0db1 \u0dc4\u0dcf \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd3 \u0db8\u0db0\u0dba\u0dcf\u0db4\u0dcf\u0db1 \u0db8\u0db8\u0dcf\u0dca\u200d\u0dba\u0dcf\u0dcf\u0dba \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0d87\u0dd2\u0dba \u0db8\u0dca\u200d\u0dbb \u0db1\u0dd0\u0dc0\u0dca\u200d \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0dc0\u0dbb\u0dca\u0dbd \u0dc0\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db4\u0dcf\u0dcf\u0daf\u0db1 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0db8\u0dc0\u0dba\u0dba \u0dc0\u0db4\u0dcf\u0d9a\u0dbb \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8\u0da7 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd4\u0db8\u0dca \u0d9a\u0dbb \u0d87\u0dd2\u0dba \u0db6\u0dc0 \u0daf\u0db1\u0dca\u0dc0\u0dcf \u0d87\u0dca\u200d\n\n(\u0d86 (i) \u0da2\u0dcf\u0dd2\u0dba\u0d9a \u0db8\u0da7\u0dca\u0da7\u0da0\u0db8\u0dca \u0dca\u200d\u0dbb\u0d9c \u0dc3\u0dcf\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0 \u0dbb\u0d9a\u0dbb\u0dd3 \u0d82\u0da2\u0dcf\u0dd2\u0dba\u0d9a\n\n\u0db4\u0dcf\u0dd0\u0dbb\u0dcf \u0da0 \u0dcf\u0dc0\u0dd4\u0db1\u0dca \u0db8\u0dbd\u0dbd \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dbb\u0dad\u0dbb\u0dca\u200d\u0dcf\u0dc0\u0dd2"
