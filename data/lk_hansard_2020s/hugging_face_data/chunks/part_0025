    "chunk_text": "\u0ba4\u0b95\u0bcc\u0bb0\u0bc8 \u0baa\u0bbf\u0bb0\u0ba4\u0bbf \u0b85\u0b95\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b85\u0bc8\u0bb0\u0bcd\u0b95\u0bb2\u0bb3, 2026\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0bb2\u0ba4\u0b9a\u0bbf\u0baf \u0bc8\u0bc0 \u0bbe\u0ba4\u0bc1\u0ba9\u0bcd \u0ba8\u0baa\u0bbf \u0bc8\u0bbf\u0bb4\u0bbe\u0b95\u0bc8 \u0ba8\u0b9f\u0bbe\u0ba4\u0bcd\u0ba4\u0bc1\u0bc8\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0b95\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bc8\u0bbf\u0b9f\u0baa\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0bc8\u0bbf\u0b9f\u0baf\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0b95 \u0b87\u0baa\u0bcd\u0bb2\u0baa\u0bbe\u0ba4\u0bc1 \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0b8f\u0bb1\u0bcd\u0b95\u0ba9\u0bb2\u0bc8 \u0b87\u0b95\u0ba4 \u0b95\u0bae\u0bcd\u0baa\u0bb9\u0bbe \u0bc8\u0bbe\u0bc8\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2 \u0ba8\u0b9f\u0ba4\u0bcd\u0ba4\u0bc1\u0bc8\u0ba4\u0bbe\u0b95\u0ba4\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0bc8\u0bbe\u0ba9\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0bb1\u0b95\u0bc1 \u0b85\u0ba4\u0b95\u0ba9 \u0b85 \u0bbe\u0bbf \u0bc8\u0bbe\u0bb3\u0bbf\u0b95\u0b95\u0baf\u0bbf\u0bb2\u0bcd \u0ba8\u0b9f\u0bbe\u0ba4\u0bcd\u0ba4\u0bc1\u0bc8\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0ba8\u0bbf\u0bb0\u0bc1\u0baa\u0ba4\u0bcd\u0b95\u0ba4 \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4 \u0b85\u0b95\u0bc8\u0b9a\u0bcd\u0b9a\u0bc1 \u0bae\u0bc1\u0bb8\u0bcd\u0bb2\u0bbf\u0bae\u0bcd \u0b9a\u0bc8\u0baf \u0baa\u0ba3\u0bcd\u0baa\u0bbe\u0b9f\u0bcd\u0b9f\u0bb2\u0bc1\u0bc8\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bbf\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0baa\u0bcd \u0baa\u0ba3\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0bb3\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0baf\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4 \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0ba8\u0bbf\u0bb0\u0bc1\u0baa\u0ba4\u0bcd \u0ba4\u0bbf\u0ba9\u0bc1\u0b95\u0b9f\u0baf \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0b95\u0baf \u0ba8\u0bbe\u0ba9\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bbe\u0bb3\u0bc1\u0bc8\u0ba9\u0bcd\u0bb1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2 *\u0bc6\u0bae\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0baf\u0bb1\u0ba9\u0bcd.\n\n\u0ba4\u0b95\u0bcc\u0bb0\u0bc8 \u0baa\u0bbf\u0bb0\u0ba4\u0bbf \u0b85\u0b95\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b85\u0bc8\u0bb0\u0bcd\u0b95\u0bb2\u0bb3, \u0ba8\u0bbe\u0ba9\u0bcd \u0b92\u0bb0\u0bc1 \u0baa\u0bbe\u0bb0\u0bbe\u0bb3\u0bc1\u0bc8\u0ba9\u0bcd\u0bb1 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd. \u0b8e\u0ba9\u0ba4\u0bc1 \u0bae\u0bc1\u0b95\u0bc8\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0bc1 2025\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 09\u0b86\u0bae\u0bcd \u0bc8\u0bbe\u0ba4\u0bae\u0bcd 05\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0b85\u0bae\u0bcd\u0baa \u0bbe\u0ba8\u0bcd\u0bb2\u0ba4\u0bbe\u0b9f\u0bcd\u0b95\u0b9f\u0baf\u0bbf\u0bb2\u0bcd \u0ba8\u0b95\u0b9f\u0ba4\u0baa\u0bb1\u0bcd\u0bb1 \u0bb2\u0ba4\u0b9a\u0bbf\u0baf \u0bc8\u0bc0 \u0bbe\u0ba4\u0bc1\u0ba9\u0bcd \u0ba8\u0baa\u0bbf \u0bc8\u0bbf\u0bb4\u0bbe\u0bc8\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0b9a\u0bbe\u0b9a\u0ba9, \u0b9a\u0bc8\u0baf \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95 \u0bbe\u0b9a\u0bbe\u0bb0 \u0b85\u0bb2\u0bc1\u0bc8\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0b95\u0bc8\u0b9a\u0bcd\u0b9a\u0bbf\u0ba9\u0bcd \u0ba4\u0b9a\u0baf \u0bbe\u0bb3\u0bb0\u0bcd \u0b9f\u0baa\u0bbf\u0bb3\u0bcd\u0baf\u0bc2.\u0baa\u0bbf. \u0bb2\u0b9a\u0ba9\u0bbe\u0ba4\u0bc0\u0bb0 \u0b85\u0bc8\u0bb0\u0bcd\u0b95\u0bb3\u0bbe\u0bb2\u0bc1\u0bae\u0bcd, \u0bae\u0bc1\u0bb8\u0bcd\u0bb2\u0bbf\u0bae\u0bcd \u0b9a\u0bc8\u0baf \u0baa\u0ba3\u0bcd\u0baa\u0bbe\u0ba3\u0bcd\u0b9f\u0bb2\u0bc1\u0bc8\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bbf\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0baa\u0ba3\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0bb3\u0bb0\u0bcd \u0b8e\u0bae\u0bcd.\u0b8e\u0bb8\u0bcd.\u0b8e\u0bae\u0bcd. \u0ba8\u0bc8\u0bbe\u0bb8\u0bcd \u0b85\u0bc8\u0bb0\u0bcd\u0b95\u0bb3\u0bbe\u0bb2\u0bc1\u0bae\u0bcd \u0b85\u0b95\u0bb4\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 2025\u0b86\u0bae\u0bcd \u0bc8\u0bb0\u0bc1\u0b9f \u0bb2\u0ba4\u0b9a\u0bbf\u0baf \u0bc8\u0bc0 \u0bbe\u0ba4\u0bc1\u0ba9\u0bcd \u0ba8\u0baa\u0bbf \u0bc8\u0bbf\u0bb4\u0bbe \u0b85\u0b95\u0bb4\u0baa\u0bcd\u0baa\u0bbf\u0ba4\u0bb4\u0bcd, 2025\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 09\u0b86\u0bae\u0bcd \u0bc8\u0bbe\u0ba4\u0bae\u0bcd 06\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0bb1\u0bc1\u0ba4\u0bbe\u0ba9\u0bcd \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bbf\u0b95\u0b9f\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0ba4\u0baa\u0bb1\u0bcd\u0bb1\u0ba4\u0bc1. \u0b85\u0ba9\u0bcd\u0b95\u0bb1\u0baf \u0ba4\u0bbf\u0ba9\u0bae\u0bcd \u0b85\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0b95\u0b9f\u0bbf\u0ba4\u0bae\u0bcd \u0b95\u0bbf\u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0b95\u0bc8\u0b95\u0baf \u0b85\u0ba4\u0bcd\u0ba4\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf, \u0b8e\u0ba9\u0ba4\u0bc1 \u0b8a\u0bb0\u0bbe\u0ba9 \u0b85\u0b9f\u0bcd\u0b9f\u0bbe\u0b95\u0bb3\u0b9a\u0bcd\u0bb2\u0b9a\u0b95\u0ba9 \u0b85\u0b9e\u0bcd\u0b9a\u0bb2\u0bcd \u0b85\u0bb2\u0bc1\u0bc8 \u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0ba4\u0baa\u0bbe \u0ba4\u0bbf\u0baa\u0bb0\u0bbe\u0bb2\u0bcd \u0b95\u0b95\u0ba4\u0baf\u0bbe\u0baa\u0bcd\u0baa\u0bc8\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4 \u0b95\u0b9f\u0bbf\u0ba4 \u0b89\u0b95\u0bb1\u0b95\u0baf\u0baf\u0bc1\u0bae\u0bcd \u0ba8\u0bbe\u0ba9\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bbe\u0bb3\u0bc1\u0bc8\u0ba9\u0bcd\u0bb1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2 *\u0bc6\u0bae\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0baf\u0bb1\u0ba9\u0bcd.\n\n\u0b8e\u0ba9\u0bb2\u0bc8, 2026\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0ba8\u0b95\u0b9f\u0ba4\u0baa\u0bb1\u0bc8\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0ba4\u0b95\u0bcc\u0bb0\u0bc8 \u0bae\u0bc1\u0bb8\u0bcd\u0bb2\u0bbf\u0bae\u0bcd \u0baa\u0bbe\u0bb0\u0bbe\u0bb3\u0bc1\u0bc8\u0ba9\u0bcd\u0bb1 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0b95\u0ba9\u0bc8\u0bb0\u0bc1\u0bae\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf \u0bb2\u0baa\u0ba4\u0bae\u0bcd \u0b87\u0bb2\u0bcd \u0bbe\u0bc8\u0bb2\u0bcd \u0b85\u0b95\u0bb4\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bc8\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bbe? \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0bb2\u0b95\u0b9f\u0bcd\u0b95 \u0bc8\u0bbf\u0bb0\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb2\u0bb1\u0ba9\u0bcd.\n\n\u0d9c\u0dbb\u0dd4 \u0d9c\u0dd9\u0dc0\u0d9c\u0daf\u0dbb \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0dd9\u0dc4\u0dad\u0dcf (\u0bc8\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b95\u0bc8\u0ba4\u0b95\u0ba4\u0bb0 \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95) (The Hon. Gamagedara Dissanayake) \u0dbb\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2\u0d8b \u0d9c\u0dda \u0dbb\u0dbb\u0dd4 \u0db8\u0dca \u0dd3\u0dad\u0dd4\u0db8\u0dcf \u0dc3\u0db3\u0dc4\u0dca \u0d9a\u0dbb\u0db4\u0dd4 \u0dd2\u0dc3\u0db0\u0dd2\u0dba\u0dd4\u0db8 \u0db8\u0dd4\u0dbd\u0dcf \u0dbb\u0dc0\u0dc3\u0d85\u0dae\u0dcf\u0d9c\u0dda\u0daf\u0dd3 \u0dbb\u0dbb\u0dd2\u0dba\u0dbb\u0dc4 \u0db8\u0dca \u0daf\u0dd2\u0dbb\u0dba \u0d9c\u0d9a\u0dca\u0dca \u0daf\u0dca\u200d\u0dbb \u0d9a\u0dbb \u0d9c\u0dbb\u0db1 \u0dcf\u0db8\u0dba\u0dd2 \u0d9c\u0dda \u0dc3\u0dad\u0dd3\u0dba\u0dc3\u0dc0\u0dba \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd3\u0dba\u0dc0\u0dd3\u0db8\u0dd4 \u0d9c\u0dba\u0ddd\u0da2\u0dd2\u0dcf\u0dc0 \u0dad\u0dd2\u0db6\u0dd4\u0d9c\u0da9\u0dd4\u0d9a. \u0db8\u0d9c\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0d9c\u0dca\u0daf\u0dd3 \u0db8\u0db8 \u0d91 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dc3\u0db3\u0dc4\u0dca \u0d9a\u0dc5\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dd3\u0dba\u0d8b \u0db4\u0dc3\u0dd4\u0dc0 \u0dd2\u0dc3\u0dd2\u0dc3\u0db0\u0dca\u200d \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d85 \u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d89\u0dbd\u0dcf\u0dd3\u0dda \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd4\u0dc0\u0dcf\u0d8b \u0d9c\u0dda \u0dc3\u0dad\u0dd3\u0dba\u0dc3\u0dc0\u0dba \u0d9c\u0d9a\u0dcf\u0dc5\u0db9 \u0d9c\u0d9a\u0dca\u0dca \u0daf\u0dca\u200d\u0dbb \u0d9a\u0dbb\u0d9c\u0dbb\u0db1 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0dd4 \u0dc0\u0da9\u0dcf\u0d8b \u0d9c\u0db8\u0dba\u0dd4 \u0dc3\u0db8\u0dbb\u0dcf\u0db8\u0dd3\u0dc0 \u0d91 \u0d91 \u0d9c\u0dcf\u0ddd\u0dbb\u0dcf \u0dbb\u0dca \u0db1\u0dcf \u0daf\u0dd2\u0dc3\u0d85\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dc0\u0dbd \u0d9c \u0dc0\u0dc3\u0d85\u0dae\u0dcf\u0db1\u0d8b \u0db4\u0dbd\u0dcf\u0dd2\u0d8b \u0dbb\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1 \u0dc3\u0d85\u0dae\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0dcf\u0d82\u0dc3\u0d85\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dd4\u0dad\u0dd3\u0dba \u0d9a\u0dbb\u0db1 \u0db1\u0dd2\u0dc3\u0dcf \u0d9c\u0dda \u0dc3\u0dad\u0dd3\u0dba\u0dc3\u0dc0\u0dba \u0db4\u0dca\u200d\u0dbb\u0dcf\u0d9c \u0dc1\u0dd3\u0dba\u0dc0 \u0db4\u0dc0\u0dad\u0dd3\u0dba\u0dc0\u0db1\u0dc0\u0dcf \u0db1\u0dda \u0d9c\u0dc4\u0dcf\u0db3\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d91 \u0dbb\u0db1\u0dd4\u0dc0 \u0dcf\u0db8\u0dba\u0dd2 \u0d9c\u0dda \u0dc3\u0dad\u0dd3\u0dba\u0dc3\u0dc0\u0dba \u0dbb\u0dda\u0db4\u0dc4 \u0daf\u0dd2\u0dc3\u0d85\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0d9c\u0dda \u0db4\u0dc0\u0dad\u0dd3\u0dba\u0dc0\u0dca \u0db1 \u0dad\u0dd3\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0dbb\u0dad\u0dd3\u0dba\u0d9c\u0dad\u0dd3\u0dba."
