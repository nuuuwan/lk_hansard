    "chunk_text": "\u0d9c\u0dd4\u0dc0\u0dc3\u0dd2\u0dba\u0dda\u0d9a\u0ddd\u0da2\u0dba\u0dc3 \u0dcf\u0daf\u0db1\u0daf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0dd2\u0dba\u0dc0\u0dc3 \u0da2\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dc4 \u0da7\u0dd2\u0d9a\u0da7\u0dc3\u0dad\u0dda \u0dba\u0dc3\u0dbd\u0dca\u0dd2 \u0dc3\u0dad \u0db8\u0dd4\u0dab\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u200d\u0dcf\u0dba\u0dd2\u0dc3\u0db4\u0dd4 \u0daf\u0dc0\u0dd2\u0dcf\u0dba\u0daf\u0dc3\u0d9a\u0dca\u0d9a\u0dba\u0dda\u0dc2\u0dae\u0dbb\u0d9a\u0da7\u0dc3\u0dad\u0dcf\u0daf\u0dc5\u0dc3\u0dca\u0dae\u0dcf\u0daf \u0dc3\u0dda\u0d9a\u0dca\u0d9a\u0dba\u0dca \u0dbb\u0dc3 \u0dc3\u0d9c\u0dda\u0dc0\u0dc3\u0db4\u0dd4 \u0daf\u0dc3\u0dc0\u0dd2\u0dcf\u0dba\u0daf\u0dda\u0dc0 \u0dc3\u0dc3\u0dd2\u0da7\u0dc3\u0dd2\u0dba\u0dd2\u0dba\u0dc3\u0dd4\u0dca \u0dc3\u0dda\u0d9a\u0dca\u0d9a\u0dba\u0dca \u0dbb\u0dc3 \u0dc3\u0d9c\u0dda\u0dc3\u0db4\u0dd4 \u0daf\u0dc3\u0dc0\u0dd2\u0dcf\u0dba\u0daf\u0dc0\u0dca\u200d\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dcf\u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0dca\u200d\u0daf\u0dc3\u0dda\u0dcf\u0d9a\u0dc3\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0d9a\u0db0\u0dca\u200d\u0db1\u0d9a\u0dc3\u0d9a\u0dd2\u0dbb\u0dd3\u0dcf.\u0dc3\u0dad\u0dd2\u0dc5\u0dc3\u0dc4\u0dd4\u0dd9\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dbd\u0daf\u0dc0\u0dca\u200d\u0da7\u0dc3\u0dcf\u0d9a\u0dd2\u0db1\u0dc3\u0dda\u0dcf\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u200d\u0dcf\u0dba\u0dd2\u0dc3\u0db4\u0dd4 \u0daf\u0dc3\u0dc0\u0dd2\u0dcf\u0dba\u0daf\u0dc0\u0dca\u200d\u0dc3\u0d86\u0d9a\u200d\u0db1\u0d9c\u200d\u0dc0\u0dca\u200d\u0dc0\u0dc3\u0dda\u0dcf\u0db4\u0daf\u0d9a\u200d\u0dda\u0dca\u0dca \u0dad\u0dd4\u0db8\u0d9c\u200d\u0dc0\u0dca\u200d\u0dc0\u0dc3\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dda\u0dcf \u0dc3\u0dc0\u0dca\u200d\u0db1\u0dc3\u0dc0\u0dd2\u0dc2\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dc0\u0dc0\u0dca\u200d\u0da7\u0dc3\u0db4\u0dda\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dbd\u0daf\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc3\u0dc0\u0dc0\u0dca\u200d.\u0dc3\u0d91\u200d \u0dd2\u0dba\u0dca \u0dc3\u0d91\u0dc4\u0daf\u0da7\u0dc3\u0d9c\u0dd2\u0d9a\u0dc0\u0dc3\u0da2\u0db1\u200d\u0daf\u0dc0\u0dca\u200d\u0dc3\u0d91\u0d9a\u0dca\u0d9a\u0dba \u0dc3\u0dc0\u0dd3\u0db0\u0dca\u200d\u0dc3\u0dd4\u0dab\u0dab\u0dd4\u0dc3\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dc0\u0dca\u200d\u0dd2\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dc0\u0dc0\u0dca\u200d\u0da7\u0dc3\u0dda\u0dcf\u0d9a\u0dc3\u0db4\u0dda\u0dc3 \u0dc5\u0dc3\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc0\u0dca\u200d\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d91\u0dcf\u0dc3\u0db4 \u0dcf\u0daf\u0d9a\u0dcf\u0d9a\u0dc3\u0dbd\u0dca\u0dd2 \u0dc3 \u0dc3\u0dda\u0d9c\u0db1\u0dc3\u200d\u0dcf\u0dba\u0dd2\u0dc3\u0dad\u0dd2\u0dc5\u0dc3\u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0d9a\u0dc307\u0dc0\u0dca\u200d \u0dd2\u0dba\u0dc3\u0dcf\u0daf\u0dc3\u0db4\u0dd4 \u0daf\u0dc0\u0dd2\u0dcf\u0dba\u0daf\u0dc3\u0d9a\u0dca\u0d9a\u0dba\u0dda\u0dc2\u0dae\u0dbb\u0d9a\u0da7\u0dc3\u0dad\u0dcf\u0daf\u0dc5\u0dc0\u0dca\u200d\u0dc3\u0dc3\u0dd4\u0dc0\u0dd2\u0dda\u0dba\u0dae\u0dc2\u0dd3\u0dc3\u0dcf \u0daf\u0dd2\u0dc4\u0dda\u0dc3\u0dd3\u0dcf\u0d9a\u0dca\u0d9a\u0dba\u0dc3 \u0dca \u0db1\u0dc3\u0dc0\u0dd2\u0dda\u0dba\u0dae\u0dc2\u0dc3\u0dc0\u0dca\u200d \u0dc3\u0dd2\u0dc5\u0dd2\u0dad\u0dda\u0dc0\u0dca\u200d\u0dc5\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0db4\u0da7\u0dca \u0dc3\u0d9c\u0dda\u0dda\u0dda.\u0dc3\n\n\u0d9c\u0dd4\u0dc0\u0dc3\u0dd2\u0dba\u0dda\u0d9a\u0ddd\u0da2\u0dba\u0dc3 \u0dcf\u0daf\u0db1\u0daf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0dd2\u0dba\u0dc0\u0dc3\u0dda\u0dc0\u0daf\u0dda\u0dc4\u0ddd\u0dc3 \u0da7\u0dc0\u0dca\u200d\u0dbd\u0dc3\u0db4\u0dd4 \u0daf\u0dc0\u0dd2\u0dcf\u0dba\u0daf\u0dda\u0dcf \u0dc3\u0dc0\u0dca\u200d\u0da7\u0dd2\u0db1\u0daf \u0dca\u0dc3\u0dca\u0dc4\u0dd2\u200d\u0dc3\u0dca\u0dae\u0dcf\u0daf\u0db1\u0dc3\u0dca\u0d82\u0da0\u0daf \u0dc3\u0dc0\u0dca\u200d\u0dba\u0daf\u0db4\u0daf \u0dda\u0d9a\u0daf\u0dd3\u0dc3\u0db4\u0daf\u0dc0\u0dd2\u0da0\u0dca\u0dd2\u0dc3\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dad\u0dda \u0dba\u0dc3 \u0dda\u0da7\u0dda\u0dc3\u0dca\u0d82\u0da0\u0daf \u0dc3\u0dc0\u0dca\u200d\u0dba\u0daf\u0db4\u0daf \u0d9a\u0da7\u0dc3\u0db4\u0dd4 \u0daf\u0dc0\u0dd2\u0dcf\u0dba\u0daf\u0dda\u0dcf \u0dc3\u0dc0\u0dca\u200d\u0da7\u0dd2\u0db1\u0daf \u0dca\u0dc3\u0dca\u0dc4\u0dd2\u200d\u0dc3\u0dca\u0dae\u0dcf\u0daf\u0db1\u0dc3\u0db4\u0daf\u0dc0\u0dd2\u0da0\u0dca\u0dd2\u0d9a\u0da7\u0dc3\u0d9c \u0dda\u0db1\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0db1\u0db8\u0dd4\u0dda\u0dc0\u0dc3\u0d91\u0d9a\u0dc3\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dab\u0daf\u0dda\u0dcf \u0dc0\u0dca\u200d\u0dc3\u0dc3\u0dd2\u0daf\u0dd4\u0dc3\u0dda\u0db1\u0daf\u0dc0\u0dca\u200d\u0db1\u0dc3\u0dc0\u0dc0\u0dca\u200d\u0da7\u0dc3\u0dad\u0dcf\u0dc4\u0dca\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u200d\u0dcf\u0dba\u0dd2\u0dc3\u0dc3\u0dad\u0db4\u0dc3\u0dad\u0dd4\u0db8\u0dc5\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0dca \u0dda\u0dca .\u0dc3\u0dc3\u0d92\u0dc3\u0dd2\u0dba\u0dca\u0daf\u0dc0\u0dc3\u0dc3\u0db4\u0dd4 \u0daf\u0dc0\u0dd2\u0dcf\u0dba\u0daf\u0dda\u0dcf \u0dc3\u0d93\u0dd2\u0dbb\u0dc4\u0daf\u0dc3\u0dd2 \u0dc3\u0dc0\u0dca\u200d\u0da7\u0dd2\u0db1\u0daf \u0dca\u0dc3\u0dca\u0dc4\u0dd2\u200d\u0dc3\u0dca\u0dae\u0dcf\u0daf\u0db1\u0dc3\u0dad\u0dda \u0dba\u0dc3\u0dca\u0d82\u0da0\u0daf \u0dc3\u0dc0\u0dca\u200d\u0dba\u0daf\u0db4\u0daf \u0d9a\u0dda\u0dc3\u0d91\u0d9a\u0dca\u0d9a\u0dba \u0dc3\u0dc0\u0dd3\u0db0\u0dca\u200d\u0dc3\u0d9a\u0dd2\u0dbb\u0dd3\u0dda\u0dca\u0dc3\u0dc0\u0dca\u200d\u0d9c\u0d9a\u0dd3\u0dcf\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dad\u0db4\u0da7\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d92\u0dc3\u0dca\u0dae\u0dcf\u0daf\u0db1\u0dc3\u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u200d\u0dc0\u0dca\u200d\u0dc3\u0dbb\u0dd0\u0d9a\u0dd2\u0d9a\u0daf\u0dc3\u0d8b\u0dda\u0db4\u0daf\u0dcf\u0db1\u0d9a\u0dc3 \u0dca \u0db1\u0dda\u0dc3\u0dad\u0db4\u0da7\u0dc3\u0db4\u0dd4\u0dd4 \u0dc0\u0dca\u200d\u0dca \u0dcf\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d92\u0dc3\u0dd2\u0dc5\u0dd2\u0dad\u0dc0\u0dcf\u0dc0\u0dca\u200d\u0dc3\u0dcf \u0dca \u0dc3\u0dad\u0dda \u0dba\u0dc3\u0dad\u0dc0\u0dca\u200d\u0db0\u0dca\u200d\u0daf\u0db1\u0d9a\u0dc3\u0dda\u0d9a\u0daf\u0db8\u0dd4\u0dc3 \u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d92\u0dc3\u0dc0\u0dca\u200d\u0daf\u0dda \u0dcf\u0dc3\u0dad\u0dda \u0dba\u0dc3 \u0dda\u0da8\u0dcf\u0dc3\u0dca\u0d82\u0dca\u0dae \u0dca\u0dd2\u0dbb \u0dc3\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0d9a\u0db0\u0dca\u200d\u0db1\u0d9a\u0da7\u0dc0\u0dc3 \u0dbd\u0daf\u0db4\u0dd3\u0d9a\u0dc3\u0dca\u0d82\u0dc0\u0dca\u200d\u0d9a\u0db0\u0dca\u200d\u0db1\u0d9a\u0da7\u0dc3\u0d91\u0dcf\u0dc3\u0dca\u0dae\u0dcf\u0daf\u0db1\u0dc3\u0dcf\u0daf\u0d9a \u0dc3 \u0dc3\u0d9c\u0dca \u0db1\u0dc3\u0db4\u0dd4\u0dd4 \u0dc0\u0dca\u200d\u0dca \u0dcf\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dad\u0dd2\u0dc5\u0dc3\u0dc0\u0dd2\u0dda\u0dba\u0dae\u0dc2\u0dda\u0d9a\u0dca \u0dcf\u0dc3\u0dad\u0dcf\u0daf\u200d\u0dba\u0daf\u0d82\u0dba\u0d9a\u0dc3\u0dc4 \u0da7\u0dd2\u0d9a\u0da7\u0dda\u0dc3\u0d92\u0dc3\u0dd2\u0dc5\u0dd2\u0dad\u0dc0\u0dcf\u0dc0\u0dca\u200d\u0dc3\u0dda\u0dca\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dbd\u0daf\u0dda\u0dc0 \u0dc3\u0dc0\u0dd2\u0dda\u0dba\u0dae\u0dc2\u0dc3\u0dad\u0dc0\u0dca\u200d\u0db0\u0dca\u200d\u0daf\u0db1\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dda\u0d9a\u0daf\u0db8\u0dd4\u0dc3 \u0dbd\u0daf\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf."
