    "chunk_text": "\u0dcf\u0dcf\u0dc3\u0dca\u0dd2\u0dbb\u0dc3\u0dda\u0dcf \u0da7\u0dc3 \u0dd2\u0dca \u0dc3\u0dca\u0d82\u0da0\u0daf \u0dc3\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0d9a\u0db0\u0dca\u200d\u0db1\u0dc3\u0dc0\u0dca\u200d \u0da7\u0dc3\u0dda\u0dcf\u0daf\u0dca\u0dae \u0dc0 \u0dc3\u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0daf\u0dc3\u0dc4\u0dd2\u0da7\u0dd2\u0d9a\u0daf.\u0dc3\u0d91 \u0dc3\u0dcf\u0dc0\u0dca\u200d\u0dca \u0da7\u0dc3\u0dbd\u0d82 \u0daf\u0dc0\u0dca\u200d\u0da7\u0dc3tourists\u0dbd\u0daf\u0dc3flight \u0d91 \u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dda\u0d9c\u0dca \u0dc0\u0dca\u200d\u0dca \u0db1\u0dc3\u0db4\u0dd4\u0dd4 \u0dc0\u0dca\u200d\u0dca .\u0dc3\u0dda\u0dcf\u0daf\u0dca\u0dae \u0dc0 \u0dc0\u0dca\u200d\u0dd2\u0dca \u0dc0\u0dc3St. Petersburg, Ekaterinburg \u0d9a\u0dd2\u0d9a\u0db1\u0dc3\u0dda\u0dca\u0dc3\u0db1\u0d9c \u0dc0\u0dca\u200d\u0dd2\u0dca \u0dc3\u0dcf\u0dc0\u0dca\u200d\u0dca \u0da7\u0dc3\u0d91 \u0dc3flight \u0d91 \u0dc3\u0d9c\u0daf\u0dda\u0dab\u0dca\u0dc3\u0dca\u0d82\u0da0\u0daf \u0d9a\u0dca \u0dc3\u0dda\u0d9c\u0dca \u0dc0\u0dca\u200d\u0dca \u0db1\u0dc3\u0db4\u0dd4\u0dd4 \u0dc0\u0dca\u200d\u0dca .\u0dc3\u0dc4 \u0dc0 \u0dba\u0dd2\u0dc3\u0dca\u200d\u0dbb\u0dba\u0dae\u0db1\u0d9a\u0dc3\u200d\u0dcf\u0dba\u0dd2\u0dc3\u0dad\u0db4\u0da7\u0dc3\u0dd4 \u0dc0\u0dca\u200d\u0dca \u0dc3\u0d9a\u0daf\u0db1\u0daf\u0dc3\u0db1 \u0dd2\u0dbb\u0dc3\u0d91 .\u0dc3\u0d8d\u0da2\u0dd4\u0dc3\u0dd4 \u0dc0\u0dca\u200d\u0dca \u0dc3\u0d9c\u0dcf\u0dca \u0dc3\u0d86 \u0dca\u0dcf\u0dc3 \u0dca \u0db1\u0dc3\u0dad\u0db4\u0da7\u0dc3\u0dba\u0d9a\u0dca\u0d9a\u0dba\u0dd2\u0dbb\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0db1 \u0dc4 .\u0dc3\u0d91\u0dc0\u0dca\u200d \u0dd2\u0dba\u0dc3\u0dd4 \u0dc0\u0dca\u200d\u0dca \u0dc3\u0d9c\u0dcf\u0dca \u0dc3\u0dca\u0dcf\u0dc4\u0daf\u0dc3\u0db4\u0dc4\u0dc3\u0dd4 \u0dca\u0dc3\u0dca\u0db4\u0d9a\u0dca \u0db1\u0dc3 \u0db4\u0dca\u0db1\u0daf\u0d9a \u0dc3\u0d91\u0d9a\u0daf\u0d9a\u0dda\u0db4\u0ddd\u0da8\u0dcf\u0dc3\u0dc3\u0d91 \u0da7\u0dc3\u0db0\u0dca\u200d\u0daf\u0dba\u0dbb\u200d\u0daf\u0dc0\u0dca\u200d\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0db1 \u0dc4 .\u0dc3\u0dad\u0dda \u0dba\u0dc3 \u0dda\u0da8\u0dcf\u0dc3\u0dc3\u0dca\u0d82\u0da0\u0daf \u0dc3 \u0d9a\u0dcf\u0daf\u0dca \u200d\u0d9a\u0da7\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dba\u0dba\u0dc3\u0db4\u0dc4\u0dc3\u0dd4 \u0dca\u0dc0\u0dc3\u0dc0\u0dd2\u0dda\u0dba\u0dae\u0dc2\u0dda\u0d9a\u0dca \u0dcf\u0dc3\u0d9a\u0da7\u0dd2\u200d\u0dbd\u0dc3\u0db4\u0dc4\u0dc3\u0dd4 \u0dca\u0dc3\u0dc0\u0dca\u200d\u0daf\u0dda \u0dcf\u0dc0\u0dc3SriLankan Airlines \u0dc0\u0dca\u200d\u0daf\u0dda \u0dc3\u0dd4 \u0dc0\u0dca\u200d\u0dca \u0dc3\u0dca\u0dcf\u0daf\u0d9c\u0dca\u0dc0\u0dca\u200d\u0dbd\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc3capacity \u0d91 \u0dc3\u0dc0\u0dca\u200d \u0da9\u0dd2\u0dc3 \u0dc3\u0d9c\u0dca \u0db1\u0dc3\u0dc0 \u0dba\u0dbb\u0dc3\u0dd3\u0dcf\u0dc3\u0dd2\u0dba\u0dca\u0daf\u0dc3\u200d\u0dcf\u0dba\u0dd2\u0dc3\u0dad\u0db4\u0da7\u0dc3\u0dda\u0dca\u0dc3\u0dad\u0db7\u0dd2\u0dda\u0d9a\u0ddd\u0d9c\u0dc3\u0dc3\u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0daf\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0dca \u0dda\u0dca .\u0dc3"
