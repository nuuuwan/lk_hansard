    "chunk_text": "\"\u0dc0\u0dca\u200d\u0d9a\u200d\u0dcf\u0daf\u0db1\u0dda\u0d9a\u0dc3\u0dda\u0dc0\u0daf\u0dda\u0dc4\u0ddd\u0dc3\u0db4\u0daf\u0dca\u0dbd\u0dca\u0dc3\u0dc3\u0dd2\u0dc3\u0dd4\u0dca \u0dc3\u0dad\u200d \u0dc3\u0dc0\u0dd2\u0dc0\u0dd2\u0db0\u0dca\u200d\u0dc3\u0dcf\u0daf\u0db1\u0dc3\u0dd2 \u0dc3\u0db4\u0dc3\u0dd4\u0dc0 \u0dca\u0dc3\u0dcf\u0d9a\u0dca\u0d9a\u0dba\u0db1\u0da7\u0dc3\u0dbd \u0dda\u0dc0\u0db1\u0dc3\u0dda\u0dc4\u0dba\u0dd2\u0dca \u0dc3\u0dcf\u0dc0\u0dc3\u0dda\u0dcf\u0dcf\u0dc3\u200d\u0dda\u0dda\u0dc0\u0dca\u200d\u0d9a\u0dca \u0dc3\u0d94\u0dd4\u0dab\u0dca \u0dda \u0dc3\u0dba\u0daf\u0dbb\u0dd3\u0dba\u0dbb \u0dc3\u0dc4\u0daf\u0dc3\u0dca\u0dcf\u0daf\u0da2\u0dd3\u0d9a\u0dc3\u0db4 \u0dc0\u0dca\u200d \u0dda\u0dcf\u0dc3\u0dca\u0dcf\u0dc4\u0daf\u0dc3\u0dc0\u0dca\u200d\u0d9a\u0dca\u200d\u0dbb\u0daf \u0daf \u0dc0\u0dca\u200d\u0dc3\u0dc0\u0dbd\u0db4\u0daf\u0db1\u0dc3\u0dda\u0dc4\u0dba\u0dd2\u0dca \u0dc3\u0dcf\u0dc0\u0dc3\u0d87\u200d \u0dca\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dca\u0dae\u0dcf\u0daf\u0dc0\u0dca\u200d\u0dbd\u0daf\u0dd3\u0dc3\u0db4\u0daf\u0dca\u0dbd\u0dca\u0dc3\u0dca\u0dcf\u0dc4\u0daf\u0dc3\u0db4\u0daf\u0dca\u0dbd\u0dca\u0dc3\u0dcf\u0dda\u0db1\u0ddd\u0dc3\u0d8b\u0db4\u0dda\u0dd3\u0dba \u0dc0\u0dca\u200d \u0d9a\u0dca \u0dc3\u0db4\u0dda\u0dc3 \u0dc3\u0dd2\u0dbb\u0db6\u0dd4\u0dab\u0dc3\u0dcf\u0dc3\u0d91\u0dcf\u0dc3\u200d\u0db1\u0dad\u0dd4\u0db8 \u0dc3\u0dca\u0dcf\u0dc4\u0daf\u0dc3\u0db4\u0daf\u0dca\u0dbd\u0dca\u0dc3\u0dd4 \u0dd4\u0dc0\u0dc0\u0dca\u200d\u0dd4\u0dc0\u0dca \u0dda \u0dc3\u0db7\u0dd6\u0dd2\u0dba \u0daf\u0dc0\u0dca\u200d\u0dc3\u0dcf\u0dc3\u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dda\u0dc3\u0dd3\u0dcf\u0dc3\u0dc4 \u0dc4\u0daf\u0dc3\u0db1\u0dca \u0dc3\u0dc0\u0dbd\u0daf\u0dda\u0db4\u0daf\u0dda \u0daf\u0dda\u0dad\u0dd4\u0db8\u0dc3\u0dc0\u0dca\u200d\u0db1\u0dc3\u0dda\u0dca\u0dae\u0dc0\u0dca\u200d\u0d9a\u0dc3\u0dbd\u0dbd\u0dcf\u0daf\u0dba\u0dd3\u0dc0\u0dca\u200d\u0dc3\u0dc3\u0dd2\u0daf\u0dd4\u0dc3\u0dd3\u0dc3\u0dda\u0db1\u0daf\u0dcf \u0dd2\u0dbb\u0dc3\u0dda