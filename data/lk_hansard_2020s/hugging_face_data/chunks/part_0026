4 \u0db8\u0db0\u0dba\u0dc3\u0dae\u0dae\u0dcf\u0db1\u0dc0\u0dbd \u0d91\u0db8 \u0d9c\u0db8\u0dcf\u0da9\u0dd2\u0dba\u0dd4\u0dbd \u0d85\u0db0\u0dba\u0dba\u0db1\u0dba\u0da7 \u0d85\u0dc0\u0dc3\u0dae\u0dae\u0dcf\u0dc0 \u0dc3\u0dbd\u0dc3\u0dcf \u0dad\u0dd2\u0db6\u0dd6 \u0d85\u0dad\u0dbb \u0d87\u0dad\u0dd0\u0db8\u0dca \u0d9a\u0dcf\u0dbd\u0dc0\u0dbd\u0daf\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0d9c\u0dad \u200d\u0dbb\u0db8\u0dba\u0da7\u0daf - \u0dd2\u0dc3\u0d9c\u0dc1\u0dae\u0dc2\u0d9c\u0dba\u0db1\u0dca \u0d9c\u0d9a\u0dcf\u0dd2\u0dc3\u0da9\u0dca \u0dc0\u0dc3\u0d82\u0d9c\u0dad\u0dba \u0d85\u0dc0\u0dc3\u0dae\u0dae\u0dcf\u0d9c \u0daf\u0dd3 - \u0d85\u0db0\u0dba\u0dba\u0db1\u0dba\u0da7 \u0d89\u0dcf \u0dc3\u0dbd\u0dc3\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd2. \u0d91\u0db8 \u0d85\u0dc0\u0dc3\u0dae\u0dae\u0dcf\u0dc0\u0db1\u0dca\u0dc4\u0dd2\u0daf\u0dd3 \u0d85\u0daf\u0dcf\u0dc5 \u0d9c\u0db8\u0dcf\u0da9\u0dd2\u0dba\u0dd4\u0dbd \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0d9c\u0db1\u0dcf\u0d9a\u0dc5 \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0db4\u0db8\u0dab\u0d9a\u0dca \u0d9c\u0db8\u0db8 \u0dd2\u0dc3\u0db7\u0dcf\u0d9c\u0dba\u0da7 \u0d9c\u0db4\u0dad\u0dd2 \u0dd2\u0db1\u0da7\u0dd3\u0db8\u0da7 \u0dd2\u0db1\u0daf\u0dd4 \u0dd3 \u0d87\u0dad.\n\n\u0dad\u0dc0\u0daf \u0dc3\u0d82\u0d9c\u0dc1\u0ddd\u0db0\u0dd2\u0dad \u0d9c\u0dd4\u0dbb\u0dd4 \u0d9c\u0dc3\u0dae\u0dc0\u0dcf \u0dc0\u0dba\u0dc0\u0dc3\u0dae\u0dae\u0dcf\u0dc0 \u0d85\u0db1\u0dd4\u0dc0 \u0d9c\u0dd4\u0dbb\u0dd4 \u0d9c\u0dc3\u0dae\u0dc0\u0d9c\u0dda \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0d9a\u0dca\u0dc2\u0db8\u0dad\u0dcf \u0d9a\u0dcf\u0d89\u0db8\u0dca \u0db4\u0db8\u0da7\u0d9a\u0dca\u0dc2\u0dab\u0dba I \u0dc4\u0dcf II \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0db8\u0dd3\u0db8\u0da7 - I \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9c\u0db1\u0dca 3-I \u0dd2\u0db1\u0da7 0-II \u0daf\u0d9a\u0dca\u0dc0\u0dcf II \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9c\u0db1\u0dca 0-II \u0dd2\u0db1\u0da7 0-I \u0daf\u0d9a\u0dca\u0dc0\u0dcf - \u0d85\u0daf\u0dcf\u0dc5\u0dc0 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0d9c \u0daf\u0db1 \u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u0dad\u0dca\u0db8 \u0d9a\u0dbb \u0d9c\u0db8\u0dca \u0dc0\u0db1 \u0dd2\u0dc3\u0da7 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca\u0db8 \u0d9a\u0dd0\u0db3\u0dd3\u0db8\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0d9a\u0dca\u0dc2\u0db8\u0dad\u0dcf \u0d9a\u0dcf\u0d89\u0db8\u0dca \u0db4\u0db8\u0da7\u0d9a\u0dca\u0dc2\u0dab\u0dba III \u0dc3\u0db3\u0dc4\u0dcf \u0d89\u0dd2\u0db1\u0dbb\u0dd2 \u0db8\u0dc3 \u0dad\u0dd4\u0dc5 \u0d85\u0daf\u0dcf\u0dc5 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0d9c \u0daf\u0db1\u0dba \u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u0dad\u0dca\u0db8 \u0d9a\u0dd2\u0db8\u0da7\u0db8\u0da7 \u0db1\u0dd2\u0dba\u0dd2\u0dad\u0dba.\n\n5. \u0d9c\u0dd4\u0dbb\u0dd4 \u0d9c\u0dc3\u0dae\u0dc0\u0dcf \u0dc0\u0dba\u0dc0\u0dc3\u0dae\u0dae\u0dcf\u0d9c 15(\u0d85) \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0d9c\u0dda \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d85\u0db1\u0dca\u0dad\u0dbb\u0dca\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0dd2\u0dc3\u0db0\u0dd2\u0dd2\u0dc3\u0db0\u0dcf\u0db1 0005.0 .30 \u0dd2\u0db1\u0db1 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0daf\u0dd3\u0dbb\u0dca\u0d9d \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb \u0d91\u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dad\u0db8\u0db1\u0dca \u0daf\u0dd0\u0db1\u0da7 \u0dd2\u0db1\u0da7\u0dd2\u0db1 \u0d9c\u200d\u0dbb\u0dae\u0dab\u0dd2\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0d9a\u0dca\u0dc2\u0db8\u0dad\u0dcf \u0d9a\u0dcf\u0d89\u0db8\u0dca \u0db8\u0dad \u0d8b\u0dc3\u0dc3\u0dae\u0dc0\u0db1 \u0d9c\u200d\u0dbb\u0dae\u0dab\u0dd2\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0d9a\u0dca\u0dc2\u0db8\u0dad\u0dcf \u0d9a\u0dcf\u0d89\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0d9a\u0dd2\u0db8\u0da7\u0d9c\u0db8\u0dca \u0d9c\u0d9a\u0dcf\u0db1\u0dca\u0d9c\u0daf\u0dca\u0dd2\u0db1\u0db