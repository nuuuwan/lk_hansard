    "chunk_text": "\u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf. \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba \u0d85\u0dba \u0dad\u0dd8\u0dad\u0dd3\u0dba\u0dd2\u0d9a \u0db8\u0da7\u0dca\u0da7\u0db8\u0dda \u0dda \u0dbb\u0ddd\u0dc4\u0dbd\u0dca\u0dc0\u0dbd\u0da7 \u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0dcf. \u0d85\u0db4\u0dd2 medical board \u0d91\u0d9a\u0d9a\u0dca \u0d9a\u0d9a\u0dca \u0db1\u0db8\u0dca \u0d9a\u0dc5\u0dcf. \u0daf\u0dd2\u0db1 28\u0d9a\u0da7 \u0dc0\u0da9\u0dcf \u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb \u0dbb\u0ddd\u0dc4\u0dbd\u0dda \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0d91\u0db8 \u0dbb\u0ddd\u0d9c\u0dd3\u0db1\u0dca \u0d92 \u0d92 medical board \u0d91\u0d9a\u0da7 \u0dba\u0dc0\u0db1\u0dc0\u0dcf. \u0db8\u0ddc\u0d9a\u0daf, \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d9a\u0dcf\u0dbd\u0dba\u0dda \u0db8\u0dda\u0d9a \u0d85\u0dc0\u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0dc0\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf.\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf.\n\n\u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d9a\u0dcf\u0dbd\u0dba \u0db4\u0dd4\u0dbb\u0dcf\u0dc0\u0da7\u0db8 \u0db8 \u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dba\u0dd9\u0db1\u0dca\u0db8 \u0dc0\u0dd2\u0dc2 \u0db8\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dba\u0dba \u0da2\u0dcf\u0dc0\u0dcf\u0dbb\u0db8 \u0db8\u0dd0\u0da9 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dad\u0dca, \u0db4\u0dcf\u0dad\u0dcf\u0dbd\u0dba \u0db8\u0dbb\u0dca\u0daf\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dad\u0dca, \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0d85\u0db4\u0dbb\u0dcf\u0db0\u0dc0\u0dbd\u0da7 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0db0 \u0d85\u0dba \u0d85\u0dad\u0dca\u0d85\u0da9\u0d82\u0d9c\u0dd4\u0dc0\u0da7 \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dad\u0dca \u0db4\u0ddc\u0dbd\u0dd3\u0dc3\u0dd2\u0dba \u0dc0\u0dd2\u0dc1\u0dda\u0dc2 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0db7\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0d9a\u0dca \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0d9c\u0dad \u0d9a\u0dbb\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0dd2 \u0dc0\u0dd4\u0dab\u0dcf. \u0dbb\u0dd0\u0db3\u0dc0\u0dd2\u0dba\u0db1\u0dca 1 0,801\u0d9a\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dad \u0dc0\u0dd4\u0dab\u0dd4 \u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb 37 \u0dc3\u0dc4 \u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb 37 \u0dc3\u0dc4 \u0d9a\u0db3\u0dc0\u0dd4\u0dbb\u0dd4\u0dc0\u0dbd \u0daf\u0dd0\u0db1\u0dca \u0dbb\u0dd0\u0db3\u0dc0\u0dd2\u0dba\u0db1\u0dca 40, 884\u0d9a\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d94\u0dc0\u0dca, \u0d92\u0d9a \u0d87\u0dad\u0dca\u0dad. \u0dad. \u0dc0\u0dd0\u0dbd\u0dd2\u0d9a\u0da9 \u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\u0dda \u0dbb\u0db3\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dad \u0dbb\u0dd0\u0db3\u0dc0\u0dd2\u0dba\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dbb\u0db8\u0dcf\u0dab\u0dba 839\u0d9a\u0dca \u0dc0\u0dd4\u0dab\u0dcf\u0da7 2026.07.13 \u0daf\u0dd2\u0db1 \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0d91\u0dc4\u0dd2 \u0dbb\u0dd0\u0db3\u0dc0\u0dd2\u0dba\u0db1\u0dca 3,390\u0d9a\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d9a\u0dc5\u0dd4\u0dad\u0dbb \u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\u0dda \u0d89\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dbb\u0dd0\u0db3\u0dc0\u0dd2\u0dba\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dbb\u0db8\u0dcf\u0dab\u0dba 400\u0d9a\u0dca \u0dc0\u0dd4\u0dab\u0dcf\u0da7 \u0daf\u0dd0\u0db1\u0dca \u0d91\u0dc4\u0dd2 \u0dbb\u0dd0\u0db3\u0dc0\u0dd2\u0dba\u0db1\u0dca 2,084\u0d9a084\u0d9a\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0db4\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0dc3\u0dda\u0db1 \u0d9a\u0db3\u0dc0\u0dd4\u0dbb\u0dda \u0d89\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dbb\u0dd0\u0db3\u0dc0\u0dd2\u0dba\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dbb\u0db8\u0dcf\u0dab\u0dba 470\u0d9a\u0dca \u0dc0\u0dd4\u0dab\u0dcf\u0da7 \u0daf\u0dd0\u0db1\u0dca \u0d91\u0dc4\u0dd2 \u0dbb\u0dd0\u0db3\u0dc0\u0dd2\u0dba\u0db1\u0dca 1 ,731\u0d9a\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0dcf. \u0d94\u0dc0\u0dca, \u0d91\u0dc4\u0dd9\u0db8 \u0dbb\u0dd0\u0db3\u0dc0\u0dd2\u0dba\u0db1\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d91\u0dc4\u0dd9\u0db8 \u0dbb\u0dd0\u0db3\u0dc0\u0dd2\u0dba\u0db1\u0dca \u0d89\u0db1\u0dca\u0db1 \u0d85\u0dad\u0dbb\u0dad\u0dd4\u0dbb \u0dbb \u0d85\u0db4\u0dd2 \u0db8\u0ddc\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dc5\u0dda? ?"
