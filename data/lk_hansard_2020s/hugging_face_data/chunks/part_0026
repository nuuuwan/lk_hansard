    "chunk_text": "\u0d8a\u0dc5\u0d9f \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0db8\u0dda\u0d9a\u0dd2. \u0db8\u0dda \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d9a\u0dcf \u0dc0\u0dd2\u0db8\u0daf\u0dca\u0dc1\u0dba \u0dc3 \u0db8\u0dc3\u0dca\u0dc0\u0dcf \u0db1\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dd2\u0dbd \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dcf\u0dcf\u0dc1\u0dba \u0dc3\u0dba \u0daf\u0dd0\u0db1\u0d9c\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0db8\u0dda \u0dbb\u0da7\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0dc0\u0dd4\u0daf\u0dd2 \u0d85\u0dbb\u0dcf\u0db6\u0dd2\u0dba\u0da7 \u0db4\u0dd6\u0dba\u0dd0\u0daf\u0dd4\u0dbb\u0db1\u0dca\u0dad \u0dd9\u0dd0\u0da7\u0dd2\u0dba\u0da7 559 \u0db8\u0daf\u0db8\u0db1\u0d9a\u0dca \u0dba\u0dc0\u0dcf \u0dad\u0dd2\u0dbd\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0da7 559 \u0db8\u0daf\u0db1\u0dcf \u0da7 \u0dbb\u0db8\u0da7\u0dca\u0da7 \u0d85\u0db1\u0dcf\u0dcf \u0db8\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dbd\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0dda 559 \u0db8\u0daf\u0db1\u0dcf \u0dba\u0dc0\u0dcf \u0dad\u0dd2\u0dbd\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db8\u0d9a\u0dcf\u0dda\u0dbd\u0dd4\u0db4\u0dd2\u0da7\u0dd2\u0db8\u0dda \u0dad\u0dd2\u0dbd\u0db8\u0db6\u0db1 Ashif Travels & Tours \u0d9a\u0dd2\u0dba\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a\u0dd2\u0db1\u0dca\u0dad. Ashif Travels & Tours \u0d9a\u0dd2\u0dba\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba \u0db8\u0dda 559 \u0db8\u0daf\u0db1\u0dcf\u0da7 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0dbd\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db4\u0dd6\u0dba\u0dcf\u0dda 5,700\u0d9a \u0db4\u0da9\u0dd2\u0dba\u0d9a\u0da7 \u0d91\u0dca \u0dbb\u0db8\u0da7\u0dca\u0da7 \u0db8\u0dc3\u0dca\u0dc0\u0dba\u0da7 \u0dba\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0dd2. \u0db4\u0dd6\u0dba\u0dcf\u0dda 5,700\u0d9a \u0db4\u0da9\u0dd2\u0dba\u0d9a\u0dca \u0dbd\u0dd0\u0db8\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf\u0da7, \u0d91\u0dca \u0d85\u0dba\u0da7 \u0daf\u0dd0\u0db1\u0dca\u0dad \u0dbd\u0dd0\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db4\u0dd6\u0dba\u0dcf\u0dda 600\u0dd2. \u0da7 \u0d85\u0dba \u0daf\u0dd0\u0db1\u0dca\u0dad \u0dc3\u0dc0\u0dd4\u0daf\u0dd2\u0db8\u0dda \u0d85\u0db1\u0dcf\u0dcf \u0db8\u0dc0\u0dbd\u0dcf \u0d89\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad. \u0db8\u0d9c\u0dc0\u0dda \u0db8\u0daf\u0dcf\u0dbb\u0dc0\u0dda \u0dd4\u0d9a\u0dc3\u0dca \u0dad\u0dd2\u0dbd\u0dba\u0dbd\u0dcf \u0dab\u0dba \u0db8\u0dc0\u0dbd\u0dcf \u0dad\u0db8\u0dd2 \u0db8\u0dda \u0d85\u0dba \u0dbb\u0da7 \u0d9c\u0dd2\u0db8\u0dda.\n\n813 814\n\n[\u0d9c\u0dbb\u0dd4 \u0d91\u0dda.\u0db8\u0d9a\u0dca.\u0d91\u0dda. \u0d85\u0dc3\u0dca\u0dbd\u0dda \u0db8\u0dd9\u0dad\u0dcf]\n\n2026 \u0da2\u0dd6\u0dd2 25\n\n\u0da7\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0db8 \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0db8\u0dc3\u0dca\u0dc0\u0dba \u0d9c\u0dd0\u0db1\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1. \u0dd4\u0d9c\u0dad\u0dca, \u0db6\u0dd4\u0daf\u0dca\u0db0\u0dd2\u0db8\u0dad\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0dbd\u0da5\u0dc0\u0dbb\u0dd4 \u0dad\u0db8\u0dd2 \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0d87\u0db8\u0dad\u0dd2\u0dbd\u0dc0\u0dbb\u0dd4 \u0db8\u0dc0\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad. \u0db8\u0dda \u0dc3\u0dd0\u0db8\u0dbb\u0dca\u0dbd \u0db8\u0db8\u0dd9\u0dc3\u0dca\u200d\u0dbb\u0dcf\u0dad\u0dca\u0dc0\u0dbb\u0dd4 \u0dd9\u0dd0\u0da7\u0dd2\u0dba\u0da7 35\u0db8\u0daf\u0db8\u0db1\u0d9a\u0dca \u0db6\u0db3\u0dc0\u0dcf\u0db8\u0d9c\u0db1 \u0dad\u0dd2\u0dbd\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0d9c\u0dda\u0db4\u0dd9 \u0db4\u0dd0\u0dad\u0dca\u0db8\u0dad\u0dca \u0d89\u0db1\u0dca\u0dad\u0db1 \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0dbd\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db1\u0dd2\u0db8\u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0db4\u0dc0\u0dd4\u0dda\u0dc0\u0dbd \u0d85\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 \u0db8\u0da7\u0dca\u0da7\u0da7\u0db8\u0d9a \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0db8\u0db8\u0dd9\u0dc3\u0dca\u200d\u0dbb\u0dcf\u0dad\u0dca\u0dc0\u0dbb\u0dd4 \u0dd9\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0db6\u0db3\u0dc0\u0dcf\u0db8\u0d9c\u0db1 \u0dad\u0dd2\u0dbd\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db8\u0dcf\u0dd2\u0db8\u0dcf\u0db8\u0dda\u0db8 \u0d85\u0dba \u0dc0\u0dd2\u0dad\u0dbb\u0dd2; \u0db8\u0dcf\u0dd2\u0db8\u0dcf\u0dc0\u0da7\u0db8 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0 \u0d85\u0dba \u0dc0\u0dd2\u0dad\u0dbb\u0dd2 \u0db6\u0db3\u0dc0\u0dcf\u0db8\u0d9c\u0db1 \u0dad\u0dd2\u0dbd\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad. \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 \u0dc0\u0dd0\u0da9\u0dd2 \u0d85\u0dba \u0d9c\u0dd0\u0db1 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0db8\u0db8 \u0d9a\u0dd0\u0db8\u0dad\u0dd2\u0dbd \u0db1\u0dd0\u0dd9\u0dd0. \u0db8\u0db8\u0dcf\u0d9a\u0daf, \u0da7 \u0d9c\u0dd0\u0db1\n\n\u0d9a\u0dd2\u0dda\u0db8\u0dc0\u0dcf\u0dad\u0dca, - \u0db8\u0dda \u0d9a\u0dca\u0db8\u0dc2\u0dca\u200d\u0dbb\u0db8\u0dda \u0d89\u0db1\u0dca\u0dad\u0db1 \u0d85\u0dba\u0db8\u0dda \u0dc3\u0dca\u0dad\u0dcf\u0dbd\u0dad\u0dca \u0d91\u0dad\u0dd0\u0db1 \u0d89\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf. \u0db8\u0dda \u0dbb\u0db8\u0da7\u0dca\u0da7 \u0d91\u0db8\u0dd9\u0db8 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1\u0dad\u0dca \u0db6\u0dd0\u0dd9\u0dd0 \u0db8\u0db1\u0dca\u0dad. \u0d85\u0dda\u0db8\u0dcf \u0db6\u0dd0\u0dcf\u0d9a\u0dd4\u0db8\u0dda \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc3\u0dca\u0dad\u0dcf\u0dad\u0dca \u0db6\u0dd0\u0dcf\u0d9a\u0dd4\u0db8\u0dda \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0db6\u0dd0\u0dd9\u0dd0 \u0db8\u0db1\u0dca\u0dad. \u0dad\u0dcf\u0dad\u0dca\u0dad\u0dcf \u0db6\u0dd0\u0dcf\u0d9a\u0dd4\u0db8\u0dda \u0dc0\u0dd0\u0da9 \u0d9a\u0dc5\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc3\u0dca\u0dad\u0dcf\u0da7\u0dad\u0dca \u0db6\u0dd0\u0dcf\u0d9a\u0dd4\u0dc0\u0da7 \u0dba\u0db1\u0dca\u0dad\u0db1 \u0db6\u0dd0\u0dd9\u0dd0 \u0db8\u0db1\u0dca\u0dad. \u0da7\u0d9a \u0dd9\u0db4\u0dd6 \u0db1\u0dd0\u0dd9\u0dd0. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0da7 \u0dc0\u0dcf\u0db8\u0dda \u0d85\u0dba \u0db8\u0dda 35 \u0db8\u0daf\u0db1\u0dcf \u0d85\u0dad\u0dbb \u0d89\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf. \u0da7 \u0dc0\u0dcf\u0db8\u0dda\u0db8 \u0d85\u0d9c\u0dad \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 \u0dbd\u0db6\u0dcf\u0d9c\u0dad\u0dca \u0d85\u0dba \u0db8\u0d9c\u0dcf\u0da9\u0d9a\u0dca \u0db6\u0db3\u0dc0\u0dcf\u0db8\u0d9c\u0db1 \u0dad\u0dd2\u0dbd\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0da7 \u0db8\u0dad\u0dcf\u0dbb\u0dd4\u0dbb\u0dd4 \u0d85\u0db4\u0da7 \u0d91\u0db1\u0dc0\u0dcf."
  },
