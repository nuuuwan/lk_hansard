    "chunk_text": "\u27a2 \u0d9c\u0d9a\u0d9c\u0dc3\u0dae \u0d9c\u0dc0\u0dad\u0dad\u0dca\u0db8 \u0d9c\u0db8\u0db8 \u200d\u0dbb\u0d9c\u0daf\u0dca\u0dc1\u0dba\u0da7 \u0dc3\u0db4\u0dba\u0db1 \u0da2\u0dcf\u0dbd \u0db0\u0dcf\u0dbb\u0dd2\u0dad\u0dcf\u0dc0 \u0d89\u0dc4\u0dc5 \u0db1\u0dd0\u0d82\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dc4 \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0db1\u0dc5 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dc0\u0db1\u0dd4\u0dc0\u0da7 \u0dd2\u0dc3\u0dc1\u0dcf\u0dbd \u0dd2\u0dc3\u0dc2\u0dae\u0d9a\u0db8\u0dca\u0db7\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dca\u0db8 \u0db1\u0dc5 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dc3\u0dc4 \u0db6\u0dd6\u0dc3\u0dae\u0da7\u0dbb\u0dca \u0d9c\u0db4\u0dcf\u0db8\u0dca\u0db4 \u0d9a\u0dd2\u0db8\u0da7\u0d9c\u0db8\u0dca \u200d\u0dbb\u0db8\u0d9c \u0daf \u200d\u0dbb\u0dad\u0dd2\u0dc3\u0dae\u0dae\u0dcf\u0db4\u0db1\u0dba \u0d9a\u0dd2\u0db8\u0da7\u0db8 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0d8b\u0dc3\u0dae \u0db6\u0dd2\u0db8\u0dca \u200d\u0dbb\u0d9c\u0daf\u0dca\u0dc1\u0dc0\u0dbd \u0da2\u0dcf\u0dbd \u0dc3\u0dd0\u0db4\u0dba\u0dd4\u0db8 \u0d85\u0dad\u0da9\u0dd4\u0d9a\u0dcf\u0dc0 \u0db4\u0dc0\u0dad\u0dca\u0db8\u0dc0\u0dcf\u0d9c\u0d9c\u0db1 \u0dba\u0dd1\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd4\u0db8\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4/\u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2 \u0dd2\u0dc3\u0dc1\u0dae\u0d9c\u0dca \u0dc2\u0dab \u0daf\u0dd0\u0db1\u0da7 \u0dd2\u0db1\u0daf\u0dd4 \u0d9c\u0d9a\u0d9c\u0dbb\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd3.\n\n1. \u0dc0\u0dcf\u0dbd\u0da0\u0dca\u0d9c\u0da0\u0dca \u0db1 \u0da2\u0dcf\u0dbd \u0dc3\u0dd0\u0db4\u0dba\u0dd4\u0db8\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba\n\n\u0db8\u0d9f\u0dd2\u0db1\u0dca \u0d9c\u0d9a\u0ddd\u0dbb\u0d9c\u0dc5\u0dae\u0db4\u0dad\u0dca\u0db8\u0dad\u0dd4 \u0d9c\u0d9a\u0ddd\u0dbb\u0d9c\u0dc5\u0dae\u0db4\u0dad\u0dca\u0db8\u0dad\u0dd4 \u0db8\u0db0\u0dba\u0db8 \u0d9c\u0d9a\u0ddd\u0dbb\u0d9c\u0dc5\u0dae\u0db4\u0dad\u0dca\u0db8\u0dad\u0dd4 \u0db6\u0da7\u0dc4\u0dd2\u0dbb \u0d9c\u0d9a\u0ddd\u0dbb\u0d9c\u0dc5\u0dae\u0db4\u0dad\u0dca\u0db8\u0dad\u0dd4 \u0daf\u0d9a\u0dd4\u0dab \u0dc3\u0dc4 \u0d91\u0dbb\u0dcf\u0dc0\u0dd4\u0dbb\u0dca\u0db4\u0dad\u0dca\u0db8\u0dad\u0dd4 \u200d\u0dbb\u0dcf\u0d9c\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0d9c\u0dca \u0d9a\u0db8\u0dca \u0d9c\u0d9a\u0dcf\u0da7\u0dca\u0da8\u0dcf\u0dc3 \u0dca\u0dc0\u0dbb\u0dab\u0dba \u0dc0\u0db1 \u0d85\u0dad\u0dbb \u0dbb\u0dcf\u0da2\u0dcf\u0dba \u0dca\u0d9c\u0dba\u0ddd\u0da2\u0dcf\u0db1 \u0dc0\u0dd0\u0dcf\u0dc3\u0da7\u0dc4\u0db1 \u0dba\u0da7\u0d9c\u0dad\u0dca\u0db8 0007 \u0dc0\u0dbb\u0dca\u0dc2\u0d9c\u0dda\u0daf\u0dd3 \u0d9c\u0db8\u0db8 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0db8\u0d9a \u0d9a\u0dd2\u0db8\u0da7\u0db8\u0da7 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd4\u0db8\u0dca \u0d9a\u0dbb \u0d87\u0dad.\n\n2. \u0d9c\u0dba\u0ddd\u0da2\u0dd2\u0dad \u0db8\u0dcf\u0d9a\u0dbd\u0db4\u0dd4\u0dc0 \u0daf\u0d9a\u0dd4\u0dab \u0da2\u0dcf\u0dbd \u0dc3\u0dd0\u0db4\u0dba\u0dd4\u0db8\u0dca\n\n\u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0d9c\u0db4\u0ddd\u0dbb\u0dad\u0dd3\u0dc0\u0dd4\u0db4\u0dad\u0dca\u0db8\u0dad\u0dd4 \u0dc3\u0dc4 \u0db8\u0db1\u0dca \u0db8\u0dd4 \u0db1 \u0daf\u0d9a\u0dd4\u0dab \u0d91\u0dbb\u0dd4\u0dd2\u0dc3\u0dca \u0db4\u0dad\u0dca\u0db8\u0dad\u0dd4 \u200d\u0dbb\u0dcf\u0d9c\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0d9c\u0dca \u0d9a\u0db8\u0dca \u0d9c\u0d9a\u0dcf\u0da7\u0dca\u0da8\u0dcf\u0dc3 \u0dca\u0dc0\u0dbb\u0dab\u0dba \u0d9c\u0d9a\u0d9c\u0dbb\u0dca. \u0d85\u0db8\u0dca\u0db4\u0dcf\u0dbb \u0dd2\u0db1\u0dc3\u0dae\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0d9a\u0d9c\u0dda \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc4\u0dd2\u0dd2\u0daf\u0dd4\u0dbb\u0dcf\u0dc0 \u0dc0\u0dd0\u0dc0 \u0d9c\u0db8\u0dc4\u0dd2 \u0d9c\u0dba\u0ddd\u0da2\u0dd2\u0dad \u0da2\u0dcf\u0dbd \u0db8\u0dd6\u0dbd\u0dcf\u200d\u0dbb\u0dba \u0d9c .\n\n1049 1050\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dd2 \u0d9c\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n3. \u0d9c\u0dba\u0ddd\u0da2\u0dd2\u0dad \u0db8\u0dcf\u0d9a\u0dbd\u0db4\u0dd4\u0dc0 \u0d8b\u0dad\u0dd4\u0dbb \u0da2\u0dcf\u0dbd \u0dc3\u0dd0\u0db4\u0dba\u0dd4\u0db8\u0dca\n\n\u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0d9c\u0d9a\u0ddd\u0dbb\u0d9c\u0dc5\u0dae\u0db4\u0dad\u0dca\u0db8\u0dad\u0dd4 \u0d8b\u0dad\u0dd4\u0dbb \u200d\u0dbb\u0dcf\u0d9c\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0d9c\u0dca \u0d9a\u0db8\u0dca \u0d9c\u0d9a\u0dcf\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba \u0dca\u0dc0\u0dbb\u0dab\u0dba \u0d9c\u0d9a\u0d9c\u0dbb\u0dca. \u0d9c\u0db8\u0dc4\u0dd2 \u0d9c\u0dba\u0ddd\u0da2\u0dd2\u0dad \u0da2\u0dcf\u0dbd \u0db8\u0dd6\u0dbd\u0dcf\u200d\u0dbb\u0dba \u0dc0\u0db1\u0dca\u0d9c\u0db1\u0dca \u0d9a\u0da7\u0dca\u0da7\u0dd4\u0db8\u0dd4\u0dbb\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0dc0\u0dd0\u0dc0\u0db1\u0dca.\n\n\u0d9c\u0dd4 \u0dc2\u0dcf\u0d85\u0dda\u0dbb\u0dd3\u0dba\u0db1\u0dca \u0dad\u0dcf\u0d9c\u0db4\u0dd4 \u0db8\u0dad\u0dd2\u0d9a\u0dad\u0db1\u0dca \u0dad\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dd9\u0dcf\u0dab\u0dd2\u0dda\u0d9a\u0db8\u0dca \u0dd9\u0dc5\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0bbe\u0ba3\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0ba9\u0bcd \u0bb0\u0bbe\u0b9c\u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0ba9\u0bcd \u0b87\u0bb0\u0bbe\u0b9a\u0bae\u0bbe\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bae\u0bcd) (The Hon. Shanakiyan Rajaputhiran Rasamanickam) \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dcf\u0dba \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0dd2\u0dba\u0db1\u0dd2 \u0db8\u0d9c\u0dda \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u200d\u0dbb\u0dc1\u0dae\u0db1\u0dba \u0d87\u0dc3\u0dd3\u0db8\u0da7 \u0d9c\u0db4\u0dbb \u0db8\u0db8 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf\u0dc0\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0db4\u0dd2 \u0dba\u0db8\u0dca \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u200d\u0dbb\u0dc1\u0dae\u0db1\u0dba\u0d9a\u0dca \u0d85\u0dc4\u0db1\u0d9c\u0d9a\u0dcf\u0da7 \u0d91\u0dba \u200d\u0dbb\u0db0\u0dcf\u0db1 \u200d\u0dbb\u0dc1\u0dae\u0db1\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d9c\u0db1\u0dcf\u0d9c\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0d9c\u0dba\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0d9c\u0db1\u0dca. \u0d91\u0db8 \u0db4\u0dd6\u0dbb\u0dca\u0dc0\u0dcf\u0daf\u0dbb\u0dca\u0dc1\u0dba \u0db4\u0dcf\u0dbb\u0dca\u0dd2 \u0d9c\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0d9c \u0daf\u0dd3 \u0d85\u0db4\u0dd2\u0da7 \u0dbd\u0db6\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0d9c\u0db1\u0dca \u0dc0\u0dad\u0dca\u0db8\u0db8\u0db1\u0dca \u0da2\u0dcf\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf. \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0d89\u0dc3\u0dae\u0dc3\u0dbb \u0dd2\u0dc3\u0db4\u0d9a\u0dca\u0dc2\u0d9c\u0dda \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0d9c\u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dd2\u0db1\u0da7\u0dd2\u0dba\u0daf\u0dd3 \u0d9a\u0dd2 \u0dc0\u0dcf \u0db8\u0dd4\u0daf\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dc1\u0d9c\u0dba\u0db1\u0dca \u0dad\u0db8\u0db1\u0dca \u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\u0da7 \u0db8\u0dd4\u0daf\u0dca \u0d9c\u0dc0\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0d9c\u0db1\u0dca \u0d91\u0dad\u0d9c\u0d9a\u0dcf\u0da7 \u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u200d\u0dbb\u0dc1\u0dae\u0db1 \u0db8\u0dd4\u0daf\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dc1\u0d9c\u0dba\u0db1\u0dd4\u0dad\u0dca\u0db8 \u0d85\u0dc4\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d92 \u0db4\u0dd6\u0dbb\u0dca\u0dc0\u0dcf\u0daf\u0dbb\u0dca\u0dc1\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0db4\u0da7\u0dad\u0dca\u0db8 \u0d85\u0dc4\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0dc4\u0dd0\u0db6\u0dd0\u0db1\u0dca \u0db8\u0db8 \u0d91\u0dad\u0dd0\u0db1\u0da7 \u0dba\u0db1\u0dca\u0d9c\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9c\u0db1\u0dca \u0d92\u0d9a \u0d9c\u0dc4\u0dcf\u0db3 \u0db4\u0dd6\u0dbb\u0dca\u0dc0\u0dcf\u0daf\u0dbb\u0dca\u0dc1\u0dba\u0d9a\u0dca. \u0db8\u0dd4\u0daf\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dc1\u0d9c\u0dba\u0db1\u0dca \u0d9c\u0db1\u0dca \u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\u0da7 - [\u0db6\u0dcf\u0db0\u0dcf \u0d9a\u0dd2\u0db8\u0da7\u0db8\u0d9a\u0dca]"
  },
