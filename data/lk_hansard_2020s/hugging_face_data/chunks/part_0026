d9a\u0dcf\u0dba\u0dc4\u0dcf\u0db8\u0daf\u0dca\u200d, \u0d91\u0dba\u0dc4\u0db8 \u0d9a\u0dbb\u0db1\u0dca\u0dba\u0db1\u0dca? \u0d9a\u0dc0\u0dd4\u0daf\u0dca\u200d \u0d92\u0dc0\u0dcf \u0db6\u0dbd\u0db1\u0dca\u0dba\u0db1\u0dca? \u0d8a\u0dc5\u0d9f\u0da7, junket operations \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf. \u0d92 junket operations\u0dc0\u0dd2\u0db1\u0dca \u0dba\u0d9a\u0dcf\u0dba\u0dc4\u0dcf\u0db8\u0daf\u0dca\u200d \u0d9a\u0dd0\u0dc3\u0dd2\u0dba\u0db1\u0ddd \u0d9c\u0dc4\u0db1\u0dca\u0db1 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd\u0dca \u0dba \u0dba\u0daf\u0dca\u200d\u0db1\u0dca\u0dba\u0db1\u0dca? \u0d92 \u0dbb\u0da7\u0dc0\u0dd2\u0db1\u0dca\u0db8 \u0dc3\u0dbd\u0dca\u0dd2 \u0dba\u0d9c\u0dc0\u0dbd\u0dcf, \u0d92 \u0dbb \u0da7\u0dc0\u0dd2\u0db1\u0dca\u0db8 \u0dba\u0db6\u0daf\u0dca\u200d\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d91\u0dad\u0dba\u0d9a\u0dcf\u0da7 \u0dba\u0d9a\u0dcf\u0dba\u0dc4\u0dcf\u0db8\u0daf\u0dca\u200d \u0d85\u0db4\u0dd2 \u0d92\u0dc0\u0dcf\u0da7 tax \u0d85 \u0d9a\u0dbb\u0db1\u0dca\u0dba\u0db1\u0dca? \u0d92\u0dc0\u0dcf AML \u0d91\u0d9a\u0da7 \u0da7\u0dad\u0dca \u0dba\u0dc0\u0db1\u0dc0\u0dcf\u0daf\u0dca\u200d? \u0dba\u0db8\u0dca \u0d85\u0daf\u0dca\u200d \u0dba\u0d9c\u0db1\u0dcf\u0db4\u0dd4 \u0db1\u0dd3\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dba\u0dc0\u0db1\u0dc0\u0dcf\u0daf\u0dca\u200d? \u0d85\u0dba\u0dda \u0dc3\u0dc3\u0dcf \u0d89\u0daf\u0dd2 \u0daf\u0db4\u0dd2\u0da7 \u0dba\u0db8\u0dca \u0db1\u0dd3\u0dad\u0dd2 \u0dc3\u0dbd\u0dca\u0dbd\u0dcf\u0d9d\u0db1 \u0dba\u0dc0\u0db1\u0dba\u0d9a\u0dcf\u0da7 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc3\u0dc3\u0dcf \u0dc0\u0dc4\u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf\u0daf\u0dca\u200d? \u0d92\u0d9a\u0dba\u0dd2 \u0db8\u0db8 \u0d85\u0dc4\u0db1 \u0dca\u200d\u0dbb\u0dba\u0dcf\u0db1 . \u0db1\u0dd2\u0dbb\u0dca\u0dd3 \u0dad\u0dc0 \u0d85\u0dc4\u0db1 \u0dca\u200d\u0dbb\u0dba\u0dcf\u0db1 \u0d92\u0d9a\u0dba\u0dd2.\n\n\u0d8a\u0dc5\u0d9f\u0da7, Virtual Asset Service Providers. \u0d85\u0daf\u0dca\u2