u0d9a \u0d85\u0db0\u0dba\u0dba\u0db1 \u0db4\u0dd0\u0dba \u0d9c\u0dab\u0db1\u0dd2\u0db1\u0dca 90%\u0d9a\u0dca \u0d9c\u0dc4\u0ddd \u0d8a\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0db4\u0dd0\u0dba \u0d9c\u0dab\u0db1\u0d9a\u0dca \u0db4\u0dcf\u0da8\u0db8\u0dcf\u0dbd\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dc4\u0db7\u0dcf\u0d9c\u0dd2 \u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0db4\u0dd0\u0dd2\u0dab\u0dd3\u0d9c\u0db8\u0dca \u0d9c\u0dca \u0dad\u0db1 \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dbd\u0dad\u0dca\u0db8 \u0db6\u0dbd\u0db0\u0dbb\u0dba\u0dcf \u0dc3\u0dc4\u0dad\u0dd2\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0d9c\u0db1\u0dca \u0db1\u0db8\u0dca \u0d91\u0dc0\u0db1\u0dca \u0dd2\u0db1\u0dc3\u0dd4\u0d9c\u0dc0\u0d9a\u0dd4 \u0dbb\u0dd4.7 500\u0d9a\u0dca \u0dc0\u0db1 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0dc1\u0dd2\u0dc2\u0dba\u0dcf\u0db0\u0dcf\u0dbb\u0dba \u0dbd\u0dd0\u0db6\u0dd3\u0db8\u0da7 \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dbd\u0db6\u0db1\u0dca.\n\n\u2022 \u0db8\u0dcf\u0dd2\u0db1\u0d9a \u0db4\u0dd0\u0dd2\u0dab\u0dd3\u0d9c\u0db8\u0dca \u0db4\u0dd0\u0dba \u0d9c\u0dab\u0db1 \u0db4\u0dcf\u0da8\u0db8\u0dcf\u0dbd\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dd2\u0dba\u0dd2\u0dad \u0db8\u0dcf\u0dd2\u0db1\u0d9a \u0db4\u0dd0\u0dba \u0d9c\u0dab\u0db1\u0dd2\u0db1\u0dca 75%-89% \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0db1\u0db8\u0dca (75% \u0dc4\u0dcf 89% \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca\u0db8\u0dc0) \u0d91\u0dc0\u0db1\u0dca \u0dd2\u0db1\u0dc3\u0dd4\u0d9c\u0dc0\u0d9a\u0dd4 \u0dbb\u0dd4. 500\u0d9a \u0dc1\u0dd2\u0dc2\u0dba\u0dcf\u0db0\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd3\u0db8\u0da7 \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dbd\u0db6\u0db1\u0dca.\n\n\u2022 75%\u0da7 \u0d85\u0dca \u0db8\u0dcf\u0dd2\u0db1\u0d9a \u0db4\u0dd0\u0dd2\u0dab\u0dd3\u0d9c\u0db8\u0dca \u0db4\u0dd0\u0dba \u0d9c\u0dab\u0db1\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dd2\u0db1\u0dc3\u0dd4\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dc1\u0dd2\u0dc2\u0dba\u0dcf\u0db0\u0dcf\u0dbb \u0dc4\u0dd2\u0dd2 \u0d9c\u0db1\u0dcf\u0d9c .\n\n(iii) \u0dd2\u0dc3\u0dc1\u0dae\u0dc0\u0dd2\u0dc3\u0daf\u0dba\u0dcf\u0dbd \u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0db1 \u0d9c\u0d9a\u0dcf\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0dba\u0da7\u0d9c\u0dad\u0dca\u0db8 \u0d87\u0dad\u0dd2 \u0dd2\u0dc3\u0dc1\u0dae\u0dc0\u0dd2\u0dc3\u0daf\u0dba\u0dcf\u0dbd \u0dc4\u0dcf \u0d8b\u0dc3\u0dc3\u0dae \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1 \u0dca\u0dba\u0dad\u0db1\u0dc0\u0dbd \u0dd2\u0db1\u0dc3\u0dd4\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9c\u0db6\u0dde\u0daf\u0dca\u0db0 \u0dc4\u0dcf \u0db4\u0dcf\u0dd2 \u0dd2\u0dc3\u0dc1\u0dae\u0dc0\u0dd2\u0dc3\u0daf\u0dba\u0dcf\u0dbd \u0dc3\u0dc4 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9a\u0dca\u0d9a\u0dca\u0dc0 \u0dd2\u0dc3\u0dc1\u0dae\u0dc0\u0dd2\u0dc3\u0daf\u0dba\u0dcf\u0dbd \u0dd2\u0db1\u0dc3\u0dd4\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf\n\n\u0db8\u0dc4\u0d9c\u0db4\u0dcf\u0dc5 \u0dc4\u0dcf \u0dc1\u0dd2\u0dc2\u0dba\u0dcf\u0db0\u0dcf\u0dbb \u0daf\u0dd3\u0db8\u0db1\u0dcf \u0db1\u0dd2\u0dd2\u0db1 \u0db4\u0dbb\u0dd2\u0dd2\u0db1 \u0dd2\u0db1\u0dc3\u0dd4\u0db1\u0dca \u0d9c\u0dc0\u0dad \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0db8\u0dcf\u0dc3\u0dba\u0da7 \u0d85\u0dc0\u0dc1\u0dba \u0db7\u0dcf\u0da9\u0dd4\u0d9a\u0dcf\u0dcf\u0d9c\u0dcf\u0dbb \u0daf\u0dcf\u0dba\u0d9a\u0dad\u0dca\u0db8\u0dc0 \u0db8\u0dd4\u0daf\u0dca \u0d91\u0db8 \u0db8\u0dcf\u0dc3\u0d9c\u0dda \u0db8\u0dd4\u0dca \u0dd2\u0db1\u0db1\u0dc0\u0dbd \u0db7\u0dcf\u0da9\u0dd4\u0d9a\u0dcf\u0dcf\u0d9c\u0dcf\u0dbb\u0d9c\u0dba\u0db1\u0dca \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u0dad\u0dd2\u0db8\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dd2\u0db1\u0daf\u0dd4 \u0d9a\u0dd2\u0db8\u0da7\u0db8 \u0dc4\u0dcf \u0d91\u0db8 \u0db8\u0dd4\u0daf\u0dca \u0dbd\u0dd0\u0db6\u0dd4\u0dab\u0dd4 \u0dd2\u0dc3\u0d9c\u0dc3 \u0db8\u0dc4\u0d9c\u0db4\u0dcf\u0dc5 \u0db7\u0dc