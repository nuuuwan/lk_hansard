    "chunk_text": "\u0d91\u0d9a\u0da7 \u0db1\u0da9\u0dd4 \u0db4\u0dd0\u0dc0\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dc4\u0dd0\u0d9a\u0dd2 \u0dcf\u0dc0 \u0dba\u0db8\u0dca \u0db4\u0db1\u0dad\u0dd2\u0db1\u0dca \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0dbd\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dba \u0db8 \u0dba\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0daf\u0dca\u200d\u0da9 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd\u0dca \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab \u0d89\u0dad\u0dcf\u0db8 \u0dbd\u0dca \u0db4\u0dd0\u0db1 \u0d9c\u0dd2 , \u0d85\u0da9\u0dd4 \u0daf\u0dca\u200d\u0da9 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd\u0dca \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab \u0d9a\u0dca\u0dc2. \u0d92 \u0daf\u0dca\u200d\u0da9 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 50,000 \u0dc3\u0dd2\u0da7 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 500,000 \u0daf\u0dca\u200d\u0d9a\u0dca\u0dc2\u0dc0\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dba \u0db8 \u0db8\u0dca \u0dba\u0d9a\u0dba\u0db1\u0d9a\u0dca\u0dc2 \u0dc3\u0dad\u0dd4\u0db8\u0dba\u0dc5\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1 \u0dd2\u0dc1\u0db8\u0dbb\u0dca\u0dba\u0db1 \u0d9c\u0dd0\u0db1 \u0dba\u0dad\u0dcf\u0dbb\u0dad\u0dd4\u0db8\u0dbb\u0dd4 \u0d85\u0db1\u0dcf\u0dc0\u0dbb\u0dab \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 - tipping off - \u0d9a\u0dd2 \u0db1 \u0dc0\u0dbb\u0daf\u0dca\u200d\u0da7 \u0db4\u0db1\u0dc0\u0dcf \u0dc3\u0dad\u0dd2 \u0daf\u0dca\u200d\u0da9 \u0dad\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf."
  },
