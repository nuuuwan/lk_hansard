    "chunk_text": "\u0daf \u0daf\u0dc3\u0dae \u0daf\u0dd9\u0dad\u0dad\u0dca \u0db8\u0da7 \u0d85\u0dd9\u0dc3\u0dcf\u0db1 \u0dd9\u0dc1\u0daf\u0dba\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dd9\u0db1\u0dca \u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0dd2\u0dc3\u0db0\u0dd2\u0db8\u0dad\u0dca \u0db1\u0dd3\u0dad\u0dd2 \u0dd3\u0db8\u0dad\u0dd2 \u0dc4\u0dcf \u0daf\u0dba\u0d9c\u0dd4\u0dbd\u0dcf\u0dd2\u0db1 \u0dc3\u0dc4\u0dd2\u0dad \u0daf\u0db8\u0db8 \u0dd2 \u0daf\u0dba\u0ddd\u0d9c \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dd2\u0dd3\u0db8\u0db8 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0dcf\u0daf\u0d9a\u0dca\u0dba \u0db4\u0dd4\u0dba\u0dcf\u0dd2\u0dc3\u0dd9\u0dba\u0dcf \u0d9a\u0dca\u0daf\u0dc2\u0dba\u0dae\u0dad\u0dca\u200d\u0dbb\u0dba\u0da7 \u0db4\u0db8\u0dab\u0d9a\u0dca \u0daf\u0db1\u0dcf\u0daf\u0dd9\u0dd2 \u0dc3\u0db8\u0dc3\u0dae\u0dad \u0daf\u0dda\u0dc1\u0daf\u0d86 \u0d85\u0db1\u0dcf\u0d9c\u0dad \u0d85\u0dd2\u0db8\u0dcf\u0db1\u0daf\u0d86 \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4\u0dd9 \u0dc3\u0db3\u0dc4\u0dcf \u0d91\u0d9a\u0dca\u0dad\u0dba\u0dcf \u0dca \u0dcf\u0dba\u0dba \u0dd2\u0dc3\u0dc2\u0dba\u0dba\u0dcf\u0db1\u0dd4\u0dd6\u0dbd\u0dbd \u200d\u0dbb\u0dcf\u0daf\u0dba\u0ddd\u0d9c\u0dd2 \u200d\u0dbb\u0daf \u0dc1\u0dba\u0d9a\u0dca \u0dc3\u0dd0 \u0daf\u0dc3\u0db1 \u0dd9\u0dd9\u0dd2. \u0db8\u0da7 \u0d91\u0dba \u0d85\u0dd9\u0db0\u0dcf\u0dba\u0dab\u0dba \u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dd9\u0db1\u0dca. \u0daf\u0db8\u0dc4\u0dd2 \u0da2 \u0db4\u0dd4\u0dba\u0dcf\u0dd2\u0dc3\u0dd9\u0dba\u0dcf \u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0dd9\u0db3 \u0dca\u0dba\u0d9a\u0dca\u0dc2\u0dba\u0dab\u0dba \u0dc3\u0dcf\u0dba\u0d9a\u0dca\u0dc2\u0dba\u0dab\u0dba \u0dc3\u0dcf\u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba \u0daf\u0db8\u0db8 \u0dad\u0dca\u200d\u0dbb\u0dd2\u0dd2\u0dc3\u0db0 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dc1\u0dae\u0dd9 \u0dad\u0dd4\u0dc5 \u0dc3\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db7\u0dcf\u0dd9\u0dba\u0d9a\u0dca \u0dc3\u0dad\u0dd2 \u0d9a\u0dd2\u0dd3\u0db8\u0db8 \u0dd9\u0da9\u0dcf\u0dad\u0dca \u0db4\u0dc4\u0dc3\u0dd4 \u0dd9\u0db1\u0dd9\u0dcf. \u0db8\u0dcf \u0dd4\u0daf\u0dd2\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc5 \u0dca \u0dcf\u0dba\u0dba\u0da7 \u0dc3\u0db8\u0dcf\u0da2 \u0dca\u0dbb\u0dca\u0dbd\u0dd2 \u0dc4\u0dcf \u0daf\u0dda\u0dc1\u0db4\u0dcf\u0dbd\u0db1\u0db8\u0dba \u0dd2\u0dc3 \u0dbd\u0dba\u0dad\u0dcf\u0dd9\u0dbd\u0da7 \u0dc3\u0dcf\u0daf\u0dda\u0d9a\u0dca\u0dc2\u0dba\u0dd9 \u0d8a\u0da7 \u0db4\u0dbb\u0dd2\u0dd9\u0dcf\u0dc4\u0dd2\u0dba\u0dd9 \u0dc3\u0dd0\u0dbd\u0daf \u0db1 \u0dc3\u0dcf\u0dc3\u0dae \u0dd8\u0dad\u0db8\u0dba \u0d85\u0dd2\u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0daf\u0db8\u0dca \u0daf\u0dd9\u0db1\u0dc3 \u0db8\u0daf\u0dc4\u0ddd\u0db4 \u0dcf\u0dbb\u0dd2 \u0dd9\u0db1\u0dd9\u0dcf \u0d9a\u0dd2\u0dba\u0dcf \u0d85\u0db4 \u0dd2\u0dc3\u0dc1\u0dae\u0dd9\u0dcf\u0dc3 \u0dba\u0db1\u0dd9\u0dcf. \u0d85\u0daf\u0dda \u0d8b\u0dbb\u0dd4\u0db8\u0dba \u0daf \u0daf\u0dba\u0dc4\u0dd2 \u0daf\u0db4\u0dcf\u0daf\u0dd4 \u0da2\u0db1 \u0dca \u0dbb\u0dca\u0dbd\u0dc2\u0dba\u0dab\u0dba \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0dc0\u0dd3\u0db8 \u0dcf\u0daf\u0dbd\u0ddd\u0dd2\u0dad \u200d\u0dbb\u0d9c\u0dad\u0dd2\u0dba\u0d9a\u0dca\n\n\u0dd2 \u0dc3\u0dcf\u0db8 \u0daf\u0db8\u0dca \u0dd2 \u0daf\u0dba\u0ddd\u0d9c \u0daf\u0d9c\u0db1 \u0d92\u0db8 \u0dd9\u0da9\u0dcf\u0dad\u0dca \u0d85\u0d9c\u0dba \u0dc5 \u0dd4\u0dad\u0dad\u0dd4 \u200d\u0dbb\u0d9c\u0dad\u0dd2\u0dba \u0dd2 \u0db4\u0dd2\u0dba\u0dd9\u0dba\u0d9a\u0dca \u0dd2\u0dc3\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0dd9\u0db0\u0dcf\u0dba\u0dab\u0dba \u0dba\u0db8\u0dd2\u0db1\u0dca \u0db8\u0daf\u0dda \u0dd9 \u0db1 \u0dc3\u0dae\u0dd9\u0dbd\u0dca\u0db4\u0dba \u0d85\u0dd9\u0dc3\u0db1\u0dca \u0dba\u0db1\u0dd9\u0dcf.\n\n[\u0d85.\u0db7\u0dcf. 0.(5] \u0d9c\u0dbb\u0dd4 \u0db1\u0dd3\u0dad\u0dd2\u0da5 \u0db1\u0dcf\u0db8\u0dbd\u0dca \u0dad\u0dcf\u0d9c\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0dc4\u0dcf\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bc6\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bb0\u0ba3\u0bbf \u0ba8\u0bbe\u0bae\u0bb2\u0bcd \u0bb0\u0bbe\u0b9c\u0baa\u0b95\u0bcd\u0bb7) (The Hon. Namal Rajapaksa, Attorney-at-Law) \u0d9c\u0dbb\u0dd4 \u0dd2 \u0daf\u0dba\u0ddd\u0da2\u0dba \u0dcf\u0dcf\u0db1\u0dcf\u0dba \u0dad\u0dd4\u0db8\u0dd2 \u0dd9\u0dd0\u0db1\u0dca \u0daf\u0db8\u0dad\u0dd0\u0db1 \u0db4\u0dd4\u0dba\u0dcf\u0dd2\u0dc3\u0dd9\u0dba\u0dcf\u0dd9 \u0d9c\u0dd0\u0db1 \u0dc3\u0dc4 \u0dd2 \u0db0\u0dcf\u0db1 \u0d9c\u0dd0\u0db1 \u0dcf\u0dcf \u0dc5\u0dcf \u0daf\u0db1\u0dca. \u0d94\u0dd9\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf \u0dd9\u0dbd\u0dba\u0da7 \u0dc3\u0dd2\u0dc3\u0dbd\u0dca\u0dbd\u0dcf \u0d89\u0dc3\u0dae\u0daf\u0dc3\u0dbd\u0dca\u0dbd\u0dcf\u0db8 \u0daf\u0dc5\u0dae \u0dd2 \u0db0\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0dc4\u0dcf\u0dba\u0db4\u0dd4 \u0d91 \u0daf\u0db1\u0dca \u0d9c\u0dbb\u0dd4 \u0dd2 \u0daf\u0dba\u0ddd\u0da2\u0dba \u0dcf\u0dcf\u0db1\u0dcf\u0dba \u0dad\u0dd4\u0db8\u0dd2 . \u0db8\u0dad \u0dc3\u0dad\u0dd2 \u0daf\u0db1\u0dca. \u0d92 \u0dd2 \u0db0\u0dcf\u0db1\u0dba \u0daf\u0d9c\u0dcf\u0da9 \u0dd9\u0dcf\u0dbd\u0dcf \u0dd4\u0daf\u0dc5\u0dd4 \u0dba\u0da7\u0db8 \u0daf\u0d9c\u0dcf\u0da9 \u0dd9\u0db8\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dd9\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dad\u0db8\u0dd2 \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dd9 \u0dd9\u0dd0\u0da9 \u0db4\u0da7\u0db1\u0dca \u0d9c\u0dad\u0dca\u0daf\u0dad\u0dca.\n\n\u0db8\u0da7 \u0db8\u0dad \u0dd2 \u0d91 \u0dc3\u0db8\u0dad\u0dd2\u0dd9\u0dba\u0daf\u0dba\u0d9a\u0dca \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0dd2 \u0db0\u0dcf\u0db1\u0dba \u0dd2 \u0dd3\u0db8\u0d9a\u0dca\u0dc2\u0dba\u0dab\u0dba \u0dba\u0dbd\u0dcf voice-cut \u0d91 \u0d9a\u0dca \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf. \u0dc4\u0dd4\u0daf\u0dd9\u0dcf\u0daf\u0dd9\u0db1\u0dca \u0dd9\u0dcf\u0dbd\u0dcf STF \u0d91\u0daf \u0db1\u0dca \u0dd9\u0dcf\u0dbd\u0dcf \u0dad\u0db8\u0dd2 \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0daf\u0dd9\u0db1\u0dca \u0d92 \u0dd2 \u0db0\u0dcf\u0db1\u0dba \u0dc4\u0dd1\u0daf\u0dba \u0daf . [\u0dd9\u0dcf\u0db0\u0dcf \u0d9a\u0dd2\u0dd3\u0db8\u0db8\u0d9a\u0dca] \u0d94 \u0d94 \u0dc4\u0dcf\u0dba\u0db4\u0dd4 \u0d85\u0dba \u0dc0\u0dd4\u0dd9 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0dd9\u0db1\u0dca\u0db1\u0dd9\u0dcf. \u0dd9\u0dd0\u0db1\u0dca \u0daf\u0db8\u0dca\u0dd9\u0dcf \u0d85\u0dc4\u0daf\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0db1. \u0dd2 \u0db0\u0db1\u0dca \u0dc4\u0dcf\u0dba\u0dbd\u0dcf \u0da2\u0db1\u0dad\u0dcf\u0dd9\u0daf\u0dda \u200d\u0dbb\u0dc1\u0dae\u0db1 \u0dd2\u0dc3\u0dc3\u0db3\u0db1\u0dca\u0db1 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0d92 \u0dc3\u0db1\u0d9c\u0dad\u0dca\u0dad\u0dcf\u0da7 \u0db4\u0dc3\u0dae\u0daf\u0dc3\u0dae \u0dd9\u0dd0\u0db1\u0dca \u0daf\u0db8\u0dad\u0dd0\u0db1 \u0dd1 \u0d9c\u0dc4\u0db1\u0dca\u0db1 \u0d91\u0db1\u0dd9\u0dcf. \u0d9c\u0dbb\u0dd4 \u0dd2 \u0daf\u0dba\u0ddd\u0da2\u0dba \u0dcf\u0dcf\u0db1\u0dcf\u0dba \u0dad\u0dd4\u0db8\u0dd2 \u0d91\u0daf\u0dc4\u0db8 \u0dad\u0db8\u0dd2 \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dd9 \u0dd9\u0dd0\u0da9 \u0db4\u0da7\u0db1\u0dca \u0d9c\u0dad\u0dca\u0daf\u0dad\u0dca."
  },
