    "chunk_text": "\u0db8\u0db4\u0dad\u0dca\u0dc3\u0db8\u0d9a\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0db8\u0dba\u0db1\u0dca\u0dad \u0dad\u0db8\u0db1\u0dca\u0dad\u0db8\u0dda \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dda\u0dbd \u0d89\u0daf\u0dd2\u0db4\u0dd6\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dad\u0dd2\u0dbd\u0db8\u0db6\u0db1 \u0dc3\u0dca\u0dcf\u0dcf\u0db1\u0dba\u0d9a\u0dca. \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0dd9\u0da2\u0db1 \u0db8\u0db4\u0dad\u0dca\u0dc3\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0db8\u0dda \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dbd\u0dd4\u0db8\u0dcf \u0d87\u0dd4\u0dc5\u0dd4 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0db8 \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad\u0da7 \u0dbd\u0dd0\u0db6\u0dd3 \u0dad\u0dd2\u0dbd\u0db8\u0db6\u0db1 \u0da7 \u0db6\u0dbd\u0dad\u0dbd \u0d9c\u0dd0\u0db1 \u0d85\u0d9c\u0dad\u0db8\u0dc0\u0db1\u0dca\u0dad \u0dc3\u0dbd\u0d9a\u0db1\u0dca\u0dad\u0db1 \u0d91\u0db4\u0dcf. \u0db8\u0dd9\u0da2\u0db1 \u0db8\u0db4\u0dad\u0dca\u0dc3\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc0 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad, \u0db8\u200d\u0dbb\u0dca\u0dc2\u0dca\u0dc3\u0dcf\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0db8\u0dda \u0db8\u0dd6\u0dd2\u0d9a \u0d85\u0dd2\u0dad\u0dd2\u0dbd\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0 \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0db6\u0dbd\u0dad\u0dbd\u0dc0\u0dbd\u0da7 \u0dc3\u0db8\u0dcf\u0db1, \u0db4\u0dd6\u0da7\u0dca\u0da7 \u0d86\u0da5\u0dcf \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0d85\u0db7\u0dd2\u0dba\u0dcf\u0da0\u0db1\u0dcf\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0db8\u0dda \u0db6\u0dbd\u0dad\u0dbd\u0dc0\u0dbd\u0da7 \u0dc3\u0db8\u0dcf\u0db1 \u0dc3\u0dd9 \u0d8a\u0da7\u0dad\u0dca \u0dc0\u0da9\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db6\u0dbd \u0dc3\u0dca\u0dcf\u0dcf\u0db1\u0dba\u0d9a\u0dca. \u0da7\u0db8\u0d9c\u0dcf\u0dda\u0dbd\u0db1\u0dca\u0dad\u0da7 \u0dc3\u0dca\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad, \u0d95\u0db1\u0dd1\u0db8 \u0d85\u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca\u0dad\u0d9a\u0dca \u0dc3\u0db3\u0dd9\u0dcf \u0d85\u0daf\u0dcf\u0dc5 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0db4\u0dd6\u0db1\u0dca\u0dad \u0d9a\u0dd0\u0db3\u0dc0\u0dcf \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0db8\u0d9c\u0db1\u0dca\u0dad \u0da7 \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d85\u0dd9\u0db1\u0dca\u0dad\u0db1.\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0dc3\u0dca\u0dcf\u0dcf\u0dc0\u0dbb \u0d9a\u0db8\u0dd2\u0da7\u0dd4 \u0db4\u0dd2\u0da7\u0dd4\u0db4\u0dc3 \u0d93\u0dad\u0dd2\u0dbd\u0dd9\u0dcf\u0dc3\u0dd2\u0d9a \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dad\u0dd2\u0dbd\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0da7\u0dc0\u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0db4\u0daf\u0dd2\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1. \u0d87\u0dad\u0dca\u0dad\u0dc0\u0dc1\u0dba \u0dc3\u0db8\u0dba\u0db1\u0dca\u0dad\u0db8 \u0db8\u0db8 \u0db4\u0dc5\u0db8\u0dd4 \u0dc0\u0dbb\u0da7 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0d85\u0dc0\u0dc3\u0dca\u0dcf\u0dcf\u0db8\u0dda\u0daf\u0dd3\u0dad\u0dca, \u0db1\u0dd3\u0dad\u0dd2\u0dbd \u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd\u0db8\u0dda\u0daf\u0dd3\u0dad\u0dca \u0db8\u0dd9\u0da2\u0db1 \u0db8\u0db4\u0dad\u0dca\u0dc3\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc0 \u0d9c\u0dd0\u0db1 \u0d89\u0db8\u0d9c\u0db1 \u0d9c\u0dad\u0dca\u0dad\u0dcf. \u0d94\u0dda\u0db6\u0dd4\u0da9\u0dca\u0dc3\u0dca\u0db8\u0db1\u0dca\u0dad\u0dc0\u0dbb\u0db8\u0dba\u0d9a\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dc5\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0da7\u0d9a\u0dad\u0dca \u0d91\u0dca\u0da0\u0dbb \u0dc3\u0dcf\u0dbb\u0dca\u0dbd\u0dcf\u0d9a \u0dc0\u0dd4\u0db8\u0da9\u0dd4\u0d9a \u0db1\u0dd0\u0dd9\u0dd0. \u0db8\u0db8\u0dcf\u0d9a\u0daf, \u0d85\u0daf \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0db8\u200d\u0dbb\u0dca\u0dc2\u0dca\u0dc3\u0dcf\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0db8\u0dda \u0dc3\u0dd9 \u0d85\u0db7\u0dd2\u0dba\u0dcf\u0da0\u0db1\u0dcf\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0db8\u0dda \u0dad\u0dd2\u0dbd\u0db8\u0db6\u0db1 \u0db8\u0dd6\u0dd2\u0d9a \u0d85\u0dd2\u0dad\u0dd2\u0dbd\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0db1\u0d9c\u0dad \u0dc3\u0dd9 \u0db4\u0dd6\u0da7\u0dca\u0da7 \u0d86\u0da5\u0dcf \u0db1\u0d9c\u0dad \u0dc0\u0dcf\u0db8\u0dda\u0db8 \u0db4\u0dc5\u0dcf\u0dad\u0dca\u0db6\u0daf \u0db8\u0dd9\u0dcf\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dc0\u0dbd \u0dad\u0dd2\u0dbd\u0db8\u0db6\u0db1 \u0db4\u0dd6\u0da7\u0dca\u0da7 \u0d86\u0da5\u0dcf \u0db1\u0d9c\u0dad \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0d91\u0d9a\u0dd4 \u0d9a\u0dbb\u0dbd\u0dcf \u0db6\u0dd0\u0dbd\u0dd4\u0dc0\u0dcf\u0db8 \u0db8\u0db4\u0db8\u0db1\u0db1\u0dc0\u0dcf, \u0db8\u0dda \u0dbb\u0db8\u0da7\u0dca\u0da7 \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0dc3\u0dca\u0daf\u0dd4\u0db8 \u0d9a\u0dbb\u0daf\u0dbb\u0dba\u0d9a \u0d89\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a. \u0d85\u0db4\u0dd2 \u0dc0\u0dcf\u0db8\u0dda \u0db1\u0dd3\u0dad\u0dd2\u0dbd\u0da5 \u0db8\u0dd9\u0dad\u0dca\u0db8\u0db8\u0dba\u0d9a\u0dca \u0da7 \u0db1\u0d9c\u0dad \u0d9a\u0dcf\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0db8\u0dba\u0dcf\u0daf\u0dcf \u0d9c\u0dad\u0dca\u0db8\u0dad\u0dcf\u0dad\u0dca \u0da7 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4\u0db1\u0dca\u0dad\u0da7 \u0db8\u0dbd\u0dcf\u0d9a\u0dd4 \u0dc0\u0dd2\u0dba\u0daf\u0db8\u0d9a\u0dca \u0dba\u0db1\u0dc0\u0dcf. \u0da7\u0d9a \u0db8\u0dbd\u0db8\u0dd9\u0dc3\u0dd2 \u0db1\u0dd0\u0dd9\u0dd0."
  },
