    "chunk_text": "\u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bcd 25\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0ba8\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bb2\u0b9f\u0baf \u0b89\u0bb0\u0bc1\u0bb5\u0b9a\u0bcd \u0bc6\u0bbf\u0bb2\u0bb2\u0b95\u0bb2\u0bb3\u0ba4\u0bcd \u0ba4\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4\u0bc1\u0bb2\u0bb5\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0bae\u0bc1\u0baf\u0bb1\u0bcd\u0bc6\u0bbf\u0b95\u0bb2\u0bb3\u0b9a\u0bcd \u0ba4\u0bc6\u0baf\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0ba4\u0bb1\u0bc6\u0bbe\u0bae\u0bcd. \u0ba8\u0bc6\u0bbe\u0bb2\u0bb3\u0baf \u0ba4\u0bbf\u0ba9\u0bae\u0bcd \u0ba8\u0bc0\u0ba4\u0bbf\u0bc8\u0ba9\u0bcd\u0bb1\u0ba4\u0bcd\u0ba4\u0bbf\u0ba4\u0bb2 \u0b87\u0ba4\u0bc1 \u0ba4\u0ba4\u0bc6\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bc6\u0bbe\u0ba9 \u0bb5\u0bbf\u0bc6\u0bc6\u0bbe\u0bb0\u0bb2\u0ba3 \u0bc8\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0ba8\u0bb2\u0b9f\u0ba4\u0baa\u0bb1\u0bb5\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b86\u0b95\u0ba4\u0bb5, \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0bb2\u0b9f\u0baf \u0b87\u0ba8\u0bcd\u0ba4 \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bc1 \u0bc8\u0bc6\u0bbe\u0ba4\u0baa\u0bb0\u0bc1\u0bae\u0bcd \u0ba4\u0bb2\u0bb2\u0bb5\u0bb0\u0bcd \u0b95\u0bb3\u0bc1\u0bb2\u0b9f\u0baf \u0b89\u0bb0\u0bc1\u0bb5\u0b9a\u0bcd \u0bc6\u0bbf\u0bb2\u0bb2\u0b95\u0bb2\u0bb3\u0ba4\u0bcd \u0ba4\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb2\u0bb5\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0b86\u0bb2\u0ba3\u0bb2\u0baf \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0b86\u0ba4\u0bb0\u0bb2\u0bb5 \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bb5\u0bb2\u0b95\u0baf\u0bbf\u0ba4\u0bb2 \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bc6\u0baf\u0bb1\u0bcd\u0baa\u0b9f \u0ba4\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1 \u0ba4\u0b95\u0bc6\u0bbe\u0bc6\u0bbe\u0bbf\u0b95\u0bcd\u0bb2\u0b95\u0bb2\u0baf \u0ba8\u0bc6\u0bbe\u0ba9\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0b85\u0bb0\u0bc6\u0bbf\u0b9f\u0bae\u0bcd \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95 \u0bb5\u0bbf\u0bb0\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0ba4\u0bb1\u0ba9\u0bcd. \u0b8f\u0ba4\u0ba9\u0ba9\u0bcd\u0bb1\u0bc6\u0bbe\u0bb2\u0bcd, \u0ba4\u0baa\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b87\u0bb2\u0bcd\u0bb2\u0bc6\u0bbe\u0ba4 \u0b92\u0bb0\u0bc1 \u0b9c\u0ba9\u0ba8\u0bc6\u0bbe\u0baf\u0b95 \u0ba8\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0ba4\u0bb2 \u0ba8\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0ba9\u0bcd\u0bb1\u0bc1 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba4\u0bb1\u0bc6\u0bbe\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1 \u0b85\u0ba8\u0bcd\u0ba4 \u0b89\u0ba3\u0bb0\u0bcd\u0bb5\u0bc1 \u0b87\u0ba4\u0ba9\u0bc2\u0b9f\u0bc6\u0bbe\u0b95 \u0b8e\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f \u0ba4\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.\n\n\u0ba8\u0bc6\u0bbe\u0ba9\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1\u0ba4\u0baa\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1 \u0b87\u0ba8\u0bcd\u0ba4 \u0b85\u0bb0\u0b9a\u0bc1 \u0baa\u0bb2 \u0ba4\u0baa\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd \u0baa\u0ba4\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0ba8\u0bcd\u0ba4, \u0baa\u0bb2 \u0b87\u0bb4\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb2\u0bb3, \u0baa\u0bb2 \u0ba4\u0bbf\u0baf\u0bc6\u0bbe\u0b95\u0b99\u0bcd\u0b95\u0bb2\u0bb3\u0b9a\u0bcd \u0ba4\u0bc6\u0baf\u0bcd\u0ba4 \u0b85\u0bb0\u0bc6\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b85\u0ba8\u0bcd\u0ba4 \u0bb5\u0bb2\u0b95\u0baf\u0bbf\u0bb2\u0bcd, \u0baa\u0b9f\u0bc1\u0ba4\u0b95\u0bc6\u0bbe\u0bb2\u0bb2 \u0ba4\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0bb2\u0b9f\u0baf \u0ba4\u0bc8\u0bbf\u0bb4\u0bc0\u0bb4 \u0bb5\u0bbf\u0b9f\u0bc1\u0ba4\u0bb2\u0bb2 \u0b87\u0baf\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bc1\u0bb2\u0b9f\u0baf \u0bb8\u0bcd\u0ba4\u0bc6\u0bbe\u0baa\u0b95\u0bb0\u0bcd\u0b95\u0bb3\u0bc6\u0bbe\u0ba9 \u0ba4\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bc1\u0bb2\u0bb0, \u0b95\u0bc1\u0b9f\u0bcd\u0b9f\u0bbf\u0bc8\u0ba3\u0bbf \u0b86\u0b95\u0bbf\u0ba4\u0baf\u0bc6\u0bbe\u0bb0\u0bc1\u0bb2\u0b9f\u0baf \u0b89\u0bb0\u0bc1\u0bb5\u0b9a\u0bcd \u0bc6\u0bbf\u0bb2\u0bb2\u0b95\u0bb2\u0bb3\u0ba4\u0bcd \u0ba4\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb2\u0bb5\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b8f\u0ba9\u0bcd \u0ba4\u0bb2\u0b9f \u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1? \u0b86\u0b95\u0ba4\u0bb5, \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0bb2\u0b9f\u0baf \u0b85\u0bb0\u0bc6\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0b9f\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0ba4\u0bb2 \u0b95\u0bb5\u0ba9\u0bae\u0bcd \u0ba4\u0bc6\u0bb2\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf, \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0bb2\u0b9f\u0baf \u0b95\u0b9f\u0bb1\u0bcd\u0ba4\u0bb1\u0bc6\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd \u0b85\u0bb2\u0bc8\u0b9a\u0bcd\u0bc6\u0bb0\u0bcd \u0ba4\u0bc6\u0bc6\u0bbe\u0ba9\u0bcd\u0ba9\u0bb2\u0ba4\u0baa\u0bcd\u0ba4\u0baa\u0bc6\u0bbe\u0bb2, 25\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0b85\u0ba8\u0bcd\u0ba4 \u0b89\u0bb0\u0bc1\u0bb5\u0b9a\u0bcd \u0bc6\u0bbf\u0bb2\u0bb2\u0b95\u0bb2\u0bb3\u0ba4\u0bcd \u0ba4\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb2\u0bb5\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0b86\u0ba4\u0bb0\u0bb2\u0bb5, \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0bb5\u0bc6\u0ba4\u0bbf \u0bb5\u0bc6\u0bbe\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb2\u0bb3 \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd \u0ba4\u0bb0\u0ba4\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bc8\u0ba9\u0b95\u0bcd \u0ba4\u0b95\u0bc6\u0bbe\u0bc6\u0bbe\u0bbf, \u0bb5\u0bbf\u0bb2\u0b9f \u0ba4\u0baa\u0bb1\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0ba4\u0bb1\u0ba9\u0bcd. \u0ba8\u0ba9\u0bcd\u0bb1\u0bbf!\n\n\u0d9c\u0dbb\u0dd4 \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dd9\u0db1\u0dca\u0dd3\u0dd4\u0dbb\u0dd9\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba4\u0bb2\u0bb2\u0bb2\u0bc8\u0ba4\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba \u0dc3\u0dcf\u0db1\u0dca\u0dad\u0dad \u0db8\u0db4\u0db8\u0dbb\u0dca\u0dbd\u0dbb\u0dcf \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db8\u0dcf. \u0d94\u0db6\u0dd4\u0db8\u0dcf\u0da7 \u0dc0\u0dd2\u0db1\u0dcf\u0da9\u0dd2 8\u0d9a \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dbd\u0dd0\u0db8\u0db6\u0db1\u0dc0\u0dcf.\n\n[\u0d85.\u0db7\u0dcf. 3.36] \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dca\u0dcf\u0db1\u0dca\u0dad \u0dc0\u0db4\u0dc0\u0dbb\u0dca\u0dbb\u0dcf \u0dd9\u0dc4\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba8\u0bbf\u0bb7\u0bc6\u0bbe\u0ba8\u0bcd\u0ba4 \u0ba4\u0baa\u0ba4\u0bb0\u0bb0\u0bc6\u0bbe) (The Hon. Nishantha Perera) \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db8\u0db1\u0dd2, \u0dc0\u0dd2\u0db8\u0dc1\u0dba \u0dc3\u0dca\u0dc2\u0db8\u0dba\u0db1\u0dca\u0dad\u0db8 \u0daf\u0dc3\u0dc0\u0db1 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dda \u0db8\u0dd9\u0da2\u0db1 \u0db8\u0db4\u0dad\u0dca\u0dc3\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0db8\u0dda \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0db7\u0dcf\u0dbb\u0dba \u0dc3\u0dd9 \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dc3\u0dcf\u0db0\u0db1\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc0\u0dcf\u0daf\u0dba\u0d9a\u0da7 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0 \u0dc0\u0dd3\u0db8\u0da7 \u0dbd\u0dd0\u0db6\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db8\u0dcf \u0d89\u0dad\u0dcf \u0dc3\u0dd4\u0da7\u0dd4 \u0dc0\u0db1\u0dc0\u0dcf. \u0d91\u0db8 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0db8\u0dda \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dbd \u0d9c\u0dbb\u0dd4 \u0d86\u0dbb\u0dca\u0dbd.\u0d91\u0dda. \u0d9c\u0dcf\u0db8\u0dd2\u0dab\u0dd3 \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd0\u0dad\u0dd2\u0dbd\u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0dc0\u0dcf\u0db8\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0d89\u0dad\u0dd2\u0dbd\u0dd9\u0dcf\u0dc3\u0db8\u0dda \u0db8\u0dd9\u0da2\u0db1 \u0db8\u0db4\u0dad\u0dca\u0dc3\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0db8\u0dba\u0db1\u0dca\u0dad \u0db8\u0db8\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dd2\u0dc0\u0dcf\u0daf\u0dba\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1 \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0db6\u0dc0\u0da7 \u0db8\u0db8\u0db8 \u0daf\u0dc3\u0dc0\u0db1 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0db4\u0dad\u0dca \u0dc0\u0dd4\u0dab\u0dcf."
  },
