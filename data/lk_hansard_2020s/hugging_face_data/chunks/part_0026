f\u0dca\u0db1\u0dda\u0dda \u0da2\u0db1\u0dad\u0dc1\u0dc0 \u0dad\u0dad\u0dd2\u0dc4\u0dc1\u0dc3\u0dd2\u0d9a \u0dc0\u0db1\u0dda \u0db1\u0dca \u0d85\u0dc3\u0dc1\u0db0\u0dc1\u0dbb\u0dab \u0da7 \u0dbd\u0d9a\u0dca \u0dc0\u0dd6 \u0da2\u0db1 \u0dda\u0d9a\u0dc1\u0da7\u0dc3\u0d9a\u0dca. \u0d92 \u0db8\u0db1\u0dca\u0daf \u0dda\u0dc3\u0d9a\u0db1\u0dc1\u0db1\u0dc1 \u0d9a \u0dc3\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb \u0d85\u0d9a\u0dca\u0d9a\u0dbb \u0d85\u0da2\u0dd2 770 000\u0d9a \u0da2\u0dbd \u0db0\u0dc1\u0dbb\u0dd2\u0dad\u0dc1\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0dba\u0dd4\u0d9a\u0dca\u0dad \u0da2\u0dbd\u0dc1\u0db1 \u0d9a\u0dca. \u0d91\u0db8 \u0da2\u0dbd\u0dc1\u0db1 \u0d89\u0daf\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dda\u0db8\u0dca\u0daf\u0dd3 \u0db6\u0daf\u0dd4\u0dbd\u0dd4\u0dda\u0dc0\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dda\u0daf\u0dca\u0db1\u0dda\u0dda \u0da2\u0db1\u0dad\u0dc1\u0dc0\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d9c\u0dca\u200d\u0dbb\u0dc1\u0db8\u0dd3 \u0d89\u0da9\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab\u0dda \u0db1\u0dca \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0dd2\u0daf\u0dd4\u0dc0 \u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dc1. \u0daf\u0db1\u0d9a \u0d9c\u0dab\u0db1\u0dc1\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0d9a\u0dda\u0dc3\u0d9a \u0d91\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dda\u0daf\u0dca\u0db1\u0dda\u0dda \u0da2\u0db1\u0dad\u0dc1\u0dc0 \u0db0\u0dd3\u0dc0\u0dbb \u0dda\u0dad\u0dc1\u0da7\u0dd4\u0db4\u0dc5\u0d9a\u0dca \u0dda\u0dc0\u0dd4 \u0dda\u0dc0\u0db1\u0dca \u0d85\u0dbb\u0d9c\u0dc5 \u0d9a\u0dbb\u0db1\u0dc0\u0dc1. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d92 \u0da2\u0db1\u0dad\u0dc1\u0dc0\u0da7 \u0dda\u0db8\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dc1 \u0d92 \u0dc3\u0db3\u0dc4\u0dc1 \u0d85\u0dc0\u0dc3\u0d9a\u0dcf\u0dc1\u0dc0\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd2\u0dbd\u0dc1 \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0d85\u0dd4 \u0dc0 \u0d91\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dda\u0daf\u0dca\u0db1\u0dda\u0dda \u0da2\u0db1\u0dad\u0dc1\u0dc0\u0da7 \u0db0\u0dd3\u0dc0\u0dbb \u0dda\u0dad\u0dc1\u0da7\u0dd4\u0db4\u0dc5\u0d9a\u0dca \u0dbd\u0db6\u0dc1 \u0daf\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dc1 \u0db6\u0dc1\u0db0\u0dc1\u0dc0\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dc0\u0dc1\u0daf \u0d9a\u0dd2 \u0dbd\u0dc1 \u0db8\u0db8 \u0db0\u0dd3\u0dc0\u0dbb \u0d85\u0db8\u0dc1\u0dad\u0dba\u0dc1\u0dc3\u0db1\u0dda \u0db1\u0dca \u0daf\u0dd0\u0db1 \u0d9c\u0db1\u0dca\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dd2."
