    "chunk_text": "\u0da2\u0db1\u0d9a\u0dca \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dc1 \u0da2\u0db1\u0dc1\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dda\u0d9a\u0dc1\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dc1 \u0dc0\u0dc1\u0dbb\u0dca\u0dad\u0dc1\u0dda \u0db1\u0dd2\u0dbd\u0db1\u0dca\u0dad \u0da2 \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0db1\u0dd2\u0dbb\u0dca\u0dda\u0daf\u0dca\u0db1 \u0dbd\u0db6\u0dc1 \u0daf\u0dd3 \u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dc1 \u0d94\u0dc4\u0dd4\u0da7 \u0d85\u0db4\u0dbb\u0dc1\u0db0\u0db8 \u0db1\u0dca\u0dc0\u0d9a\u0dca \u0db4\u0dc0\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd2 \u0dbd\u0dc1. \u0ddb\u0db8\u0dd3\u0db4\u0dc1\u0dbd \u0dc3\u0dd2\u0dbb\u0dd2\u0dda\u0dc3\u0d9a\u0db1 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0db1\u0dd2\u0dbb\u0dca\u0dda\u0daf\u0dca\u0db1 \u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dc1. \u0d94\u0dc4\u0dd4 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0d9a\u0dc0\u0dd4\u0db1\u0dca\u0dc3\u0dbd \u0d9a\u0dd0 \u0dda\u0db3 \u0dda \u0db1\u0dd0\u0dc4\u0dd0 \u0db8\u0dc1\u0dc3 6\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0d9a\u0dda\u0dc3\u0d9a. \u0d92 \u0dda\u0db6\u0ddd\u0db8\u0dca\u0db6 \u0db4\u0dd2\u0db4\u0dd2\u0dda\u0dbb\u0db1\u0dda\u0d9a\u0dc1\u0da7 \u0d94\u0dc4\u0dd4 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0d87\u0db8\u0dad\u0dd2. \u0dad\u0dca\u200d\u0dbb\u0dd2\u0dc0\u0dd2\u0db0 \u0dc4\u0db8\u0dd4\u0daf\u0dc1\u0dc0 \u0dda\u0db4\u0dc1\u0dbd\u0dd3\u0dc3\u0dd2 \u0db6\u0dd4\u0daf\u0dca\u0db0\u0dd2 \u0d85\u0dc3\u0db1 \u0d92 \u0dc3\u0dd2 \u0dbd\u0dd4 \u0dda\u0daf\u0dca\u0dc0\u0dbd\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dda\u0da9\u0dd4\u0d9a \u0ddb\u0db8\u0dd3\u0db4\u0dc1\u0dbd \u0dc3\u0dd2\u0dbb\u0dd2\u0dda\u0dc3\u0d9a\u0db1 \u0da7\u0dda\u0dad\u0dca. \u0d91\u0dad\u0dda\u0d9a\u0dc1\u0da7 \u0d94\u0dc4\u0dd4 \u0dc0\u0d9c\u0d9a\u0dd3\u0dda\u0db8\u0db1\u0dca \u0db6\u0dd0\u0dc4\u0dd0\u0dbb \u0dda\u0dc0\u0db1\u0dca\u0dda\u0db1\u0dca \u0dda\u0d9a\u0dc1\u0dda\u0dc4\u0dc1\u0db8\u0daf?\n\n\u0dda\u0dc0\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0db0\u0dd2 \u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db1\u0dd3\u0dad\u0dd2\u0dda\u0dda \u0d86\u0db0\u0dd2\u0db4\u0dad\u0dba \u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dc1 \u0db1\u0db8\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0dda\u0dda \u0dc3\u0dc1\u0db0\u0dc1\u0dbb\u0dab\u0dad\u0dca\u0dc0 \u0d89\u0dc2\u0d9a\u0da7 \u0dda\u0dc0\u0db1\u0dc0\u0dc1 \u0db1\u0db8\u0dca \u0db4\u0dc1\u0dc3\u0d9a\u0d9a\u0dd4 \u0d89\u0dbb\u0dd2\u0daf\u0dc1 \u0dda\u0db6\u0ddd\u0db8\u0dca\u0db6 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dc1\u0dbb\u0dda\u0dda \u0dc0\u0dd2\u0db1\u0dca\u0daf\u0dd2\u0dad \u0db1\u0dca\u0da7 \u0dc3\u0dc1\u0db0\u0dc1\u0dbb\u0dab\u0dad\u0dca\u0dc0 \u0d89\u0dc2\u0d9a\u0da7 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2 \u0dbd\u0dc1 \u0d85\u0db7\u0dd2\u0dbd\u0dc1\u0dc2 \u0dad\u0dd2\u0dda\u0db6\u0db1 \u0db6\u0dbd\u0dc1\u0dda\u0db4\u0dc1\u0dda\u0dbb\u0dc1\u0dad\u0dca\u0dad\u0dd4\u0db8\u0dc0 \u0dad\u0dd2\u0dda\u0db6\u0db1 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dc1\u0db1\u0dca\u0dda\u0dc3\u0d9a\u0dbd\u0dc1\u0dda \u0dda\u0db8\u0dc0\u0dd0\u0db1\u0dd2 \u0d86\u0da9\u0dd4\u0d9a\u0dca\u0dc0\u0d9a\u0dca \u0da7\u0dda\u0dad\u0dca \u0d91\u0dda\u0dc4\u0db8 \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0d9a \u0dda\u0dc0\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0db0\u0dd2 \u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d91\u0dda\u0dc4\u0db8 \u0dda\u0db6\u0dca\u0dbd\u0dbb\u0dd2\u0dbd\u0dc1 \u0db1\u0dca\u0db1 \u0dda\u0daf\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0.\n\n\u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dc1 2021\u0daf\u0dd3 \u0dda\u0d9c\u0ddd\u0dc3\u0dc1\u0db7 \u0dbb\u0dc1\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dc1 \u0dad\u0db8\u0dd2 \u0dda\u0db8\u0dc1\u0dc0\u0dd4\u0db1\u0dca \u0dda\u0daf\u0dda\u0daf\u0db1\u0dc1\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0\u0dc0 indictments file \u0d9a\u0dda\u0dc5\u0d9a. \u0d92 \u0d86\u0db4\u0dd4 \u0db1\u0dca\u0dc0 \u0dad\u0db8\u0dd2 \u0dda\u0db8\u0dca \u0d89\u0dc3\u0d9a\u0dc3\u0dbb\u0dc4\u0da7 \u0dda\u0d9c\u0db1 \u0d9c\u0dd2\u0dda\u0dda. \u0d92 \u0dc3\u0dd2 \u0dbd\u0dd4 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0d87\u0dad\u0dca\u0dad. \u0daf\u0dd0\u0db1\u0dca \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dc1\u0db1\u0dca\u0dda\u0dc3\u0d9a\u0dbd\u0dc1\u0da7 \u0db6\u0dbd \u0dbd\u0dd0\u0db6\u0dd2\u0dbd\u0dc1 \u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dc1. \u0d92 \u0dc4\u0dd2\u0db1\u0dca\u0daf\u0dc1 \u0d85\u0db4\u0dd2 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dc1\u0db1\u0dca\u0dda\u0dc3\u0d9a\u0dbd\u0dc1\u0dda\u0d9c\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dc1 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dc1 \u0dda\u0db8\u0dca\u0d9a\u0da7 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0dda\u0dc0\u0da0\u0dca\u0da0; \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dc0\u0db8 \u0dda\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0dca \u0daf\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2 \u0dbd\u0dc1 \u0da2\u0db1\u0dc1\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dda\u0d9a\u0dc1\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dc1 \u0dc0\u0dc1\u0dbb\u0dca\u0dad\u0dc1\u0dda \u0dc3\u0dc1\u0d9a\u0dca\u0dc2\u0dd2 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0dbd\u0dc1 \u0dad\u0dd2\u0dda\u0db6\u0db1; \u0db1\u0dd2\u0dbb\u0dca\u0dda\u0daf\u0dca\u0db1 \u0dbd\u0db6\u0dc1\u0daf\u0dd3 \u0dad\u0dd2\u0dda\u0db6\u0db1 \u0d85 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dda \u0dd4 \u0dad\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0d9a\u0dc1\u0dbd \u0dad\u0dd4\u0db8\u0dc5\u0daf\u0dd3 \u0dc0\u0dc4\u0dc1\u0db8 \u0db1\u0dd3\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd2 \u0dbd\u0dc1. \u0d91\u0dc0\u0d9a\u0da7 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0da2\u0db1\u0dc1\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb \u0dc1 \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dc0\u0db8 \u0dad\u0db8\u0db1\u0dca\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0dca \u0db4\u0dd0\u0dc4\u0dd0\u0dbb \u0dc4\u0dd0\u0dbb \u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dc1 \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a \u0da2\u0db1\u0d9a\u0dca \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dc1 \u0dda\u0d9a\u0dc1\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dc1 \u0dc0\u0dc1\u0dbb\u0dca\u0dad\u0dc1\u0dda \u0dda\u0dc4\u0dc5\u0dd2\u0daf\u0dbb \u0dda\u0dc0\u0dbd\u0dc1 \u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dc1. \u0d85\u0db1\u0dca\u0db1 \u0d92 \u0dc4\u0dd2\u0db1\u0dca\u0daf\u0dc1 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7\u0dad\u0dca \u0db1\u0dd3\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dad\u0dca\u0db8\u0d9a \u0dda\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dd6\u0dbd\u0dbd\u0dc1\u0dc3\u0db1\u0dc1\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2 \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dc1 \u0d85\u0db4\u0dd2 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0dc1\u0dda \u0db8\u0dc1\u0dbb\u0dca\u0d9c\u0dda \u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dc1 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dc1 \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dda \u0dd4 \u0dad\u0dca \u0dc0\u0dc4\u0dc1\u0db8 \u0db1\u0dd3\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0dbd\u0dc1 \u0dda\u0db8\u0dca \u0db4\u0dc1\u0dc3\u0d9a\u0d9a\u0dd4 \u0d89\u0dbb\u0dd4\u0daf\u0dd2\u0db1 \u0dda\u0db6\u0ddd\u0db8\u0dca\u0db6 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dc1\u0dbb\u0dda\u0dda \u0dc0\u0dd2\u0db1\u0dca\u0daf\u0dd2\u0dad \u0db1\u0dca \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca\u0dda\u0dc0\u0dbd\u0dc1 \u0d89\u0db1\u0dca\u0db1 \u0d92 \u0da2\u0db1\u0dad\u0dc1\u0dc0\u0da7 \u0dc3\u0dc1\u0db0\u0dc1\u0dbb\u0dab \u0d9a\u0dca \u0d89\u0dc2\u0d9a\u0da7 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dc1\u0db1\u0dca\u0dda\u0dc3\u0d9a\u0dbd\u0dc1 \u0dda\u0db8\u0dca\u0d9a\u0da7 \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0dda\u0dc0\u0db1\u0dca\u0db1 \u0d9a\u0dd2 \u0dbd\u0dc1."
