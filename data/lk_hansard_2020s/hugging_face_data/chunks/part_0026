    "chunk_text": "\u0d9c\u0dd4\u0dc0\u0dc3\u0dd2\u0dba\u0dda\u0d9a\u0ddd\u0da2\u0dba\u0dc3\u0d87\u0dcf\u0dd2\u0dbb\u0dad\u0dd4\u0db8\u0dcf\u0daf\u0dda\u0dc3\u0dda\u0dc0\u0daf\u0dda\u0dc4\u0daf\u0dcf\u0dc3\u0dc4 \u0dc0\u0dca\u200d\u0dda\u0dc3\u0dc0\u0dd2\u0db0\u0dd2\u0d9a\u0da7\u0dc3\u0db4 \u0dc4 \u0daf\u0dd2\u0dd2\u0dc3 \u0dc5\u0daf\u0dc0\u0dc3\u0dda\u0dcf\u0dcf\u0dc3\u0dc0\u0dd2\u200d\u0dbb\u0daf\u0dcf\u0dc3\u0dc0\u0dca\u200d \u0db4\u0dca \u0dba\u0dc3\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dc0\u0dca\u200d\u0dd2\u0d9a\u0dc3\u0d86 \u0dca\u0dcf\u0dc3 \u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf\u0dc3\u0d9a\u0dd2\u0d9a\u0dbd\u0daf.\u0dc3\u0dcf\u0dcf\u0dc3\u0d92\u0dc3\u0d9c \u0db1\u0dc3\u0dca\u0dad\u0dd4\u0db8\u0db4\u0dca\u0dc3\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dda\u0dcf\u0daf \u0dcf\u0dc0\u0dc3\u0d92 \u0dc3\u0dcf\u0dcf\u0dc3 \u0daf\u0dbd\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dd2\u0dbb\u0dca\u0dae\u0dda\u0dca\u0dae\u0dc3\u0dc0\u0dbd\u0daf\u0dda\u0db4\u0daf\u0dda \u0daf\u0dda\u0dad\u0dd4\u0db8\u0dc3\u0dda\u0dc0\u0dca\u200d\u0da0\u0dca\u0da0\u0dc3\u0dda\u0dcf\u0d9a\u0d9a\u0dca\u0d9a\u0dba.\u0dc3\u0dda \u0daf\u200d \u0dd2\u0dba\u0dca \u0dc3\u0dc4\u0dba\u0dbb\u0dc3\u0d91\u0dae \u0dc3\u0dc3\u0dd2\u0dd3\u0db0\u0dca\u200d\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf\u0dc3\u0db1\u0dca\u0dc0\u0dc3\u0dcf\u0da7\u0dc3\u0dca\u0dad\u0dd4\u0db8\u0db4\u0dca\u0dba\u0dd2.\u0dc3\u0dda\u0dcf\u0daf \u0dcf\u0dc0\u0dc3\u0dad\u0dd2\u0dc5\u0dc3\u0d9a\u0dd4\u0dc4 \u0dc3\u0dc0\u0dca\u200d\u0dca \u0db1\u0dc3\u0d95\u0db1 \u0dc3\u0db1 \u0dc4 .\u0dc3\u0d9a\u0dd2\u0d9a\u0dd2\u0dd2\u0dad\u0dcf\u0dc3\u0db6\u0dd2\u0dda\u200d \u0d9a\u0dcf\u0dc3\u0db1\u0dca\u0dae\u0dda\u0dca\u0dbd\u0dca\u0dbd\u0daf\u0dc3\u0d86\u0dda\u0dc0 \u0dc3\u0d9a\u0dd2\u0d9a\u0db1\u0dc3\u0d91 \u0dc3\u0dda\u0dcf\u200d \u0db1\u0da7\u0dc3\u0dad\u0dcf\u0daf\u0dc5\u0dc3\u0dc3\u0db1 \u0dc4 .\u0dc3\u0dad\u0dda \u0dba\u0dc3\u0dc4\u0dcf\u0dc0\u0dca\u200d\u0dda\u0dda\u0dc3\u0dd2\u0dbb\u0db6\u0dd4\u0dda\u0dab\u0dca\u0dc3\u0dda\u0dca\u0dc3\u0dda\u0dd3\u0dc3\u0dc3\u0dd2\u0dd3\u0db0\u0dca\u200d\u0dc3\u0dc0\u0dd2\u0d9a\u0dc3\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc3\u0dc0\u0dc0\u0dca\u200d\u0dc3\u0db1\u0dca\u0dc0\u0dc3 \u0daf\u0da7\u0dc4\u0dba\u0dbb\u0dc3\u0d9a\u0dc4\u0db4\u200d\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dda\u0dc0\u0dca\u200d\u0db1\u0dc3\u0d91 \u0dc3\u0db1\u0dca\u0dc0\u0dc3\u0d92 \u0dc3 \u0dd4\u0dab\u0dd4\u0dc0\u0dc3 \u0dc5\u0dda\u0dc3\u0dad\u0db4\u0da7\u0dc3\u0dca\u0dad\u0dd4\u0db8\u0db4\u0dca\u0dc3\u0dc0\u0dca\u200d\u0dca \u0db1\u0dc3\u0db4\u0dd4\u0dd4 \u0dc0\u0dca\u200d\u0dca .\u0dc3\u0d92\u0dc3\u0dd2\u0dba\u0dca\u0daf\u0dc3\u0dcf\u0dda \u0dc3\u0d91\u0dda\u0dc4\u0dcf\u0dc3\u0d9a\u0dd4\u0dc4 \u0dda\u0dc0\u0dca\u200d\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0db1 \u0dc4 .\u0dc3\u0d94\u0dc0\u0dad\u0dd4\u0db8\u0dcf\u0dca \u0dbd\u0daf\u0dc3\u0dda\u0dca\u0dc3\u0dd2\u0dc5\u0dd2\u0dad\u0dc0\u0dcf\u0dc3\u0dc3\u0d9a\u0dca\u0dc3\u0dc0\u0dca\u200d \u0dc3\u0dd2\u0dc5\u0dd2\u0dad\u0dda\u0dc0\u0dca\u200d\u0dc5\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dca \u0dca\u0dae\u0dc3 \u0dda\u0d9c\u0db1\u0dc3\u0d9a\u0db1\u0dc0\u0dca\u200d\u0daf\u0dc3\u0db1\u0dca\u0dc3\u0dcf\u0dcf\u0dc3\u0dda\u0dc0\u0daf\u0dda\u0dc4\u0daf\u0dcf\u0dc3\u0dca\u0dad\u0dd4\u0db8\u0db4\u0dca\u0dba\u0dd2.\u0dc3\u0d92\u0dc3\u0dd2\u0dba\u0dca\u0daf\u0dc3\u0d92\u0dc3 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc3\u0dca\u0daf\u0d9a\u0dcf \u0dc3 \u0dc3\u0d9c\u0dca \u0db1\u0da7\u0dc3\u0dba\u0d9a\u0dca\u0d9a\u0dba\u0dd2\u0dbb\u0d9a\u0dc3\u0dca\u0dc4\u0dc3\u0dc0\u0db0\u0dca\u200d\u0d9a\u0d9a\u0d9a\u0dc3\u0dbd \u0dda\u0db6\u0dca\u0dbd\u0dc0\u0dca\u200d\u0daf\u0dc3\u0d9a\u0dd2\u0d9a\u0dbd\u0daf\u0dda\u0dc3\u0dcf\u0dcf\u0dc3\u0dca\u200d\u0dbb\u0daf\u0d9a\u0dcf\u0db1\u0daf\u0dc3 \u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\n\n\u0d9c\u0dd4\u0dc0\u0dc3\u0dd2\u0dba\u0dda\u0d9a\u0ddd\u0da2\u0dba\u0dc3 \u0daf \u0dc3\u0dca\u0dcf\u0daf\u0dc3\u0dca\u0dcf\u0daf\u0db4\u0dd2\u0dbb\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0d9a\u0dd2\u0dba\u0dc0\u0dc3\u0dc3\u0dc0\u0dd2\u0dda\u0dba\u0dae\u0dc2\u0dda\u0d9a\u0dca \u0dcf\u0dc3\u0dad\u0dd2\u0dc5\u0dc3\u0dcf\u0d9a\u0dd2\u0db1\u0dc0\u0dca\u200d\u0daf\u0dc3\u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc3\u200d\u0dbb\u0dd2\u0dba \u0d9a\u0dca \u0da7\u0dc3\u0dc0\u0dca\u200d \u0daf\u0dc3\u0dd4\u0dc0\u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc3\u200d\u0dbb\u0dd2\u0dba \u0d9a\u0dca \u0dc3\u0dc0\u0dd2\u0dda\u0dd3\u0dba\u0dc0\u0dca\u200d\u0dbd\u0da7\u0dc3\u0d9c\u0dd2\u0d9a\u0daf\u0dcf\u0dc3\u0dad\u0db1\u0daf \u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dd2\u0dad\u200d\u0dcf\u0daf\u0dc0\u0dca\u200d\u0d9a\u0dc3\u0dc0\u0dca\u200d \u0da9\u0dd2\u0dba\u0dd2\u0dc3\u0d9a\u0dd2\u0d9a\u0dbd\u0daf.\u0dc3\u0dca\u0dcf\u0dc4 \u0dc3 \u0da7\u0dc0\u0dca\u200d\u0dbd\u0dca\u0dc3\u0d92\u0dc0\u0dca\u200d\u0daf\u0da7\u0dc3brand \u0dda\u0dc0\u0dca\u200d\u0dbd\u0daf\u0dc3\u0db1\u0dca \u0dda\u0dca .\u0dc3\u0d8b\u0dcf\u0daf\u0dc4 \u0dab\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dc0\u0dca\u200d\u0dba\u0dda\u0d9a\u0dca \u0dc3\u0dd2\u0dc5\u0dd2\u0db4\u0dd3\u0db1\u0d9a\u0dc3\u0d9c\u0dda\u0dda\u200d\u0daf\u0dda\u0dc0\u0dc3nurses\u0dbd\u0daf\u0da7.\u0dc3\u0d92\u0dc3\u0d9a\u0dd2\u0d9a\u0dca \u0dda\u0dca \u0dc0\u0dc3\u0d92\u0dc3 \u0da7\u0dc0\u0dca\u200d\u0dbd\u0da7\u0dc3\u0dda\u0dc4\u0daf\u0dcf\u0dc3\u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc3\u200d\u0dbb\u0dd2\u0dba \u0dda\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u200d\u0dcf\u0dba\u0dd2\u0dc3\u0d9a\u0dca \u0dda\u0dca .\u0dc3 \u0da7\u0daf\u0d9a\u0dc3 \u0daf\u0da2\u0dba\u0d9a\u0dc3\u0d9c\u0dda\u0dda\u200d\u0daf\u0dda\u0dc0\u0dc3\u0dad\u0dda \u0dba\u0dc3 \u0dda\u0da8\u0dcf\u0dc3quantity surveyors\u0dbd\u0daf\u0da7\u0dc3\u0db4\u0dd4\u0daf\u0dd4\u0dcf\u0dc3\u0db1\u0dbd\u0dca\u0dbd\u0dd4\u0dcf\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d92\u0dc0\u0dc3\u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc3\u0dad\u0d9a.\u0dc3\u0dad\u0dd2\u0dc5\u0dc3\u0db4\u0dd4\u0dd4 \u0dc0\u0dca\u200d\u0dca \u0dc3\u200d \u0dca\u0dc3\u0d8b\u0db1\u0dca \u0daf\u0dd4\u0dc3 \u0dca \u0db1\u0dc3\u0d95\u0db1 \u0dc0\u0dc3\u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc3\u200d\u0dbb\u0dd2\u0dba \u0d9a\u0dca \u0dc3\u0dc0\u0dd2\u0dda\u0dd3\u0dba\u0d9c\u200d\u0dc3 \u0dc0\u0dca\u200d\u0dca \u0db1\u0da7.\u0dc3\u0d91\u200d\u0dda \u0daf\u0da7\u0dc3\u0d92\u0dc3\u0dad\u0d9a\u0da7\u0dc3\u0dc0\u0dca\u200d \u0da9\u0dd2\u0dc3\u0dc0\u0dca\u200d \u0db4\u0dca\u0db4\u0d9a\u0dd4\u0dda\u0dc3\u0dbd \u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dd4\u0dc0\u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc3\u200d\u0dbb\u0dd2\u0dba \u0dda\u0d9a\u0d9a\u0dd4\u0da7\u0dc3\u0dbd \u0dda\u0dc0\u0db1\u0dc3\u0dc0\u0dca\u200d \u0db4\u0dca\u0db4\u0da7\u0dc3\u0dc0\u0dca\u200d \u0daf\u0dc3\u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc3\u200d\u0dbb\u0dd2\u0dba \u0dda\u0d9a\u0d9a\u0dd4\u0da7\u0dc3\u0dbd \u0dda\u0dc0\u0db1\u0dc3\u0dc0\u0dca\u200d \u0db4\u0dca\u0db4\u0dc3\u0dc0\u0dca\u200d \u0da9\u0dd2\u0dba\u0dd2.\u0dc3\u0dad\u0dda \u0dba\u0dc3\u0dd4\u0dc0\u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc3\u0d9c\u0dca\u0dc4\u0dca\u0dae\u0dcf\u0dc3\u0dda\u0dca\u0dae\u0dc0\u0dd2 \u0daf\u0dc0\u0dca\u200d \u0dc3\u0dc4 \u0da7\u0dd2\u0d9a\u0da7\u0dc3\u0d9a\u0db1\u0dc3\u0dda \u0dda\u0db1\u0d9a\u0dd4\u0da7\u0dc3\u0dc0\u0dca\u200d \u0daf\u0dc3\u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc3\u0dda\u0dca\u0dae\u0dc0\u0dd2 \u0daf\u0dc0\u0dca\u200d \u0dc3\u0dc4 \u0da7\u0dd2\u0d9a\u0da7\u0dc3\u0d9a\u0db1\u0dc3\u0dda \u0dda\u0db1\u0d9a\u0dd4\u0dda \u0dc3\u0dc0\u0dca\u200d \u0db4\u0dca\u0db4\u0dc3\u0dc0\u0dca\u200d \u0da9\u0dd2\u0dba\u0dd2.\u0dc3\u0d92\u0dc3\u0dc0\u0dca\u200d \u0db4\u0dca\u0db4\u0dc3"
  },
