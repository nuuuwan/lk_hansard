    "chunk_text": "\u0db8\u0dd0\u0daf \u0dda\u0db4\u0dbb\u0daf\u0dd2\u0d9c \u0dba\u0dd4\u0daf\u0dca\u0db0 \u0db1\u0dd2\u0dc3\u0dc1 \u0d89\u0db1\u0dca\u0db0\u0db1\u0dc0\u0dbd\u0da7 \u0dc0\u0dd0\u0da2\u0dd2 \u0dda\u0da9\u0dc1\u0dbd\u0dbb\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dab \u0d9a\u0dca \u0dc0\u0dd0 \u0dda\u0dc0\u0dbd\u0dc1 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dc1. \u0d85\u0daf \u0dc0\u0db1\u0dda\u0d9a\u0dc1\u0da7 \u0dbd\u0dc1\u0db8\u0dca\u0db4\u0dd4\u0dda\u0dad\u0dbd\u0dca \u0dc0\u0dc1\u0dda \u0d89\u0db1\u0dca\u0db0\u0db1 \u0db4\u0dc1\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0dbb\u0db1 \u0dc3\u0dd4\u0dc5\u0dd4 \u0db4\u0dbb\u0dd2\u0db8\u0dc1\u0dab\u0dda\u0dda \u0dda\u0db6\u0ddd\u0da7\u0dca\u0da7\u0dd4 \u0dc4\u0dd2\u0db8\u0dd2 \u0db0\u0dd3\u0dc0\u0dbb \u0dc1 \u0dda\u0dbd\u0dc1\u0d9a\u0dd4 \u0d85\u0db4\u0dc4\u0dc3\u0dd4\u0dad\u0dc1\u0dc0\u0d9a\u0da7 \u0db4\u0dad\u0dca \u0dda\u0dc0\u0dbd\u0dc1 \u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dc1. \u0dc4\u0dd0\u0db8 \u0d85\u0dc0\u0dc3\u0d9a\u0dcf\u0dc1\u0dc0\u0d9a\u0daf\u0dd3\u0db8 \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0db8\u0dca\u0dc0\u0dd2\u0db1\u0dca \u0d9a\u0dd2 \u0db1\u0dc0\u0dc1 \u0d92 \u0d85 \u0dda\u0dc0\u0dd4 \u0dda\u0dc0\u0db1\u0dca \u0dda\u0db8\u0da0\u0dca\u0da0\u0dbb \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0dda\u0dc0\u0db1\u0dca \u0d9a\u0dc5\u0dc1 \u0d9a\u0dd2 \u0dbd\u0dc1. \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0d92 \u0dc3\u0dc4\u0db1 \u0db0\u0dd3\u0dc0\u0dbb \u0da2\u0db1\u0dad\u0dc1\u0dc0\u0da7 \u0dbd\u0dd0\u0dda\u0db6\u0db1\u0dc0\u0dc1\u0daf \u0d9a\u0dd2 \u0dbd\u0dc1 \u0db6\u0dbd\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1.\n\n\u0d85\u0daf \u0dad\u0dd2\u0dda\u0db6\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0db6\u0dbd\u0db1\u0dca\u0db1. \u0da2\u0db1\u0dad\u0dc1\u0dc0\u0da7 \u0da2\u0dd3\u0dc0\u0dad\u0dca \u0dda\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0d9a\u0dca \u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dc1\u0daf? \u0daf\u0dd0\u0db1\u0dca \u0d9a\u0dd2 \u0dc0\u0dc1 \u0d85\u0dc3\u0d9a\u0dc0\u0dd0\u0dc3\u0dd4\u0db8 \u0dc3\u0dc4\u0db1\u0dc1\u0db0\u0dc1\u0dbb \u0dda\u0daf\u0db1\u0dc0\u0dc1 \u0d9a\u0dd2 \u0dbd\u0dc1. \u0d85\u0dc3\u0d9a\u0dc0\u0dd0\u0dc3\u0dd4\u0db8 \u0dc3\u0dc4\u0db1\u0dc1\u0db0\u0dc1\u0dbb \u0daf\u0dd3\u0dbd\u0dc1 \u0daf\u0dd4\u0db4\u0dca\u0db4\u0dad\u0dca\u0d9a\u0db8 \u0db1\u0dd0\u0dad\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0. \u0d9a\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0dd8\u0daf\u0dca\u0db0\u0dd2 \u0dc3\u0dc4\u0db1\u0dc1\u0db0\u0dc1\u0dbb \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dc1. \u0daf\u0dd0\u0db1\u0dca \u0d85\u0dc3\u0d9a\u0dc0\u0dd0\u0dc3\u0dd4\u0db8 \u0dc3\u0dc4\u0db1\u0dc1\u0db0\u0dc1\u0dbb \u0dda\u0daf\u0db1\u0dc0\u0dc1. \u0d9a\u0dc1\u0dbd\u0dda \u0db1\u0dca \u0d9a\u0dc1\u0dbd \u0da7 \u0dda\u0db8\u0dca\u0dc0\u0dc1 \u0dda\u0daf\u0db1\u0dc0\u0dc1. \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dc1\u0da7 \u0da2\u0db1\u0dad\u0dc1\u0dc0\u0da7 \u0d92\u0dda\u0d9a\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dda \u0ddd\u0da2\u0db1 \u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dca\u0dbd\u0dc1 \u0d9a\u0dd2\u0db1\u0dca \u0d9a\u0dd2 \u0dc0\u0dc1 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0dbd\u0dc3\u0d9a\u0dc1\u0dc0\u0da7 \u0dda\u0d9c\u0db1\u0dd0\u0dc0\u0dd2\u0dad\u0dca \u0db6\u0dc1\u0db1\u0dda\u0d9a\u0dc1\u0da7 \u0dda\u0dbd\u0ddd\u0d9a \u0dda\u0dc0\u0dda\u0dc5\u0db3 \u0dda\u0db4\u0dc1\u0dda\u0dc5\u0d9a \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0db8\u0dd2\u0dbd\u0da7 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0dda\u0daf\u0db1\u0dc0\u0dc1 \u0d9a\u0dd2 \u0dbd\u0dc1. \u0dda\u0daf\u0db1\u0dca\u0dda\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0dda\u0db1\u0dca. \u0d85\u0daf \u0d89\u0db1\u0dca\u0db0\u0db1 \u0db8\u0dd2\u0dbd \u0d9a\u0dd3 \u0daf? \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0d85\u0daf \u0daf\u0dd4\u0db4\u0dca\u0db4\u0dad\u0dca \u0da2\u0db1\u0dad\u0dc1\u0dc0 \u0d89\u0dad\u0dc1 \u0d85\u0dc3\u0dbb\u0dab \u0dda\u0dc0\u0dbd\u0dc1 \u0d89\u0db1\u0dca\u0dda\u0db1\u0dca. \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dda \u0ddd\u0da2\u0dba \u0d9a\u0dc1\u0dbb\u0d9a \u0dc3\u0db7\u0dc1 \u0dc3\u0db7\u0dc1\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dd2 \u0db1\u0dd2 \u0da2\u0db1\u0dad\u0dc1\u0dc0\u0da7 \u0dc3\u0dc4\u0db1 \u0dda\u0daf\u0db1\u0dc0\u0dc1\u0da7 \u0db8\u0dc1 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0 \u0db1\u0dd0\u0dc4\u0dd0. \u0dda\u0db8\u0db8 \u0db4\u0dbb\u0dd2\u0db4\u0dd6\u0dbb\u0d9a \u0d87\u0dc3\u0d9a\u0dad\u0dda\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0 \u0d85\u0daf \u0d85\u0dd4 \u0db8\u0dad \u0dc0\u0db1\u0dc0\u0dc1. \u0d87\u0dad\u0dca\u0dda\u0dad\u0db1\u0dca\u0db8 \u0d9a\u0dd2 \u0dda\u0dc0\u0dc1\u0dad\u0dca \u0dbb\u0dda\u0da7\u0dca \u0dc3\u0db8\u0dc3\u0d9a\u0dad \u0da2\u0db1\u0dad\u0dc1\u0dc0\u0da7\u0db8 \u0dda\u0db8\u0dca \u0dc3\u0dc4\u0db1 \u0dbd\u0dd0\u0dda\u0db6\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1.\n\n\u0dda\u0db4\u0dc1\u0dda\u0dc4\u0dc1\u0dbb \u0dc3\u0dc4\u0db1\u0dc1\u0db0\u0dc1\u0dbb \u0dda\u0daf\u0db1\u0dc0\u0dc1 \u0dda\u0daf\u0db1\u0dc0\u0dc1 \u0d9a\u0dd2 \u0dc0\u0dc1\u0da7 \u0dbd\u0dd0\u0db6\u0dd2\u0dbd\u0dc1 \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0daf \u0db8\u0db8 \u0dc0\u0d9c\u0d9a\u0dd3\u0dda\u0db8\u0db1\u0dca \u0d9a\u0dd2 \u0db1\u0dc0\u0dc1 \u0dda\u0db8\u0dca \u0d9a\u0dc1\u0dbb\u0dab . \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dca\u0dbd\u0dc1 \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db1\u0dca\u0db1 \u0dda\u0db1\u0dc1\u0dda\u0dbb\u0dc1\u0da0\u0dca\u0dda\u0da0\u0ddd\u0dda\u0dbd\u0dca \u0d9a\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2 \u0dda\u0d9c\u0dc1\u0dc0\u0dd2 \u0da2\u0db1\u0dad\u0dc1\u0dc0\u0da7 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0d9a \u0dc3\u0dc4\u0db1\u0dc1\u0db0\u0dc1\u0dbb \u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd2\u0dbd\u0dc1 \u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dc1\u0daf \u0d9a\u0dd2 \u0dbd\u0dc1. \u0d85\u0daf\n\n\u0dda\u0db4\u0dc1\u0dda\u0dc4\u0dc1\u0dbb \u0db8\u0dd2\u0dbd \u0d89\u0dc4\u0dc5 \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dc1. \u0dd3.\u0dc3\u0dbd\u0dca \u0dc4\u0dc1 \u0dbd\u0dc1\u0db8\u0dca\u0db4\u0dd4\u0dda\u0dad\u0dbd\u0dca \u0db8\u0dd2\u0dbd \u0d89\u0dc4\u0dc5 \u0db1\u0dc0\u0dc1. \u0d92 \u0dc0\u0dc1\u0dda \u0db8 electricity bill \u0d91\u0d9a \u0d89\u0dc4\u0dc5 \u0db1\u0dc0\u0dc1. \u0dda\u0d9a\u0dc1\u0dda\u0dc4\u0dc1\u0db8\u0daf \u0dda\u0d9c\u0dc1\u0dc0\u0dd2\u0dad\u0dd0\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dda\u0db1\u0dca? \u0dda\u0d9a\u0dc1\u0dda\u0dc4\u0dc1\u0db8\u0daf \u0db0\u0dd3\u0dc0\u0dbb \u0da2\u0db1\u0dad\u0dc1\u0dc0 \u0db0\u0dd3\u0dc0\u0dbb \u0dbb\u0dc3\u0d9a\u0dc3\u0dc1\u0dc0 \u0d9a\u0dbb\u0db1\u0dca\u0dda\u0db1\u0dca? \u0d92 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0da7 \u0dbb\u0da7 \u0dc0\u0dd0\u0da7\u0dd2\u0dbd\u0dc1 \u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dc1."
