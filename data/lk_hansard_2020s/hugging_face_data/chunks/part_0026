    "chunk_text": "\u0b95\u0b95\u0bcc\u0bb0\u0bb5 \u0b85\u0b95\u0bc7\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bae\u0bb3, \u0b95\u0b95\u0bb0\u0bae\u0baf\u0bbe\u0bb0\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0bae\u0ba4\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bc7\u0b95\u0bcd\u0b95\u0bb3\u0bcd, \u0bb0\u0baf\u0bbf\u0bb2\u0bcd \u0baa\u0bbe\u0b95\u0ba4\u0b95\u0baf\u0b95\u0bcd \u0b95\u0b9f\u0b95\u0bcd\u0b95\u0bbe\u0bc7\u0bb2\u0bcd \u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0b9f\u0baf \u0b87\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0bae\u0baa\u0bbe\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bbe\u0ba4\u0bc1. \u0b8f\u0b95\u0ba9\u0ba9\u0bbf\u0bb2\u0bcd, \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0b95\u0b9a\u0bb2\u0bcd\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\u0bb5\u0bb1\u0bc1 \u0bb5\u0bb4\u0bbf\u0bae\u0baf \u0b87\u0bb2\u0bcd\u0b95\u0bc8. \u0b85\u0ba8\u0bcd\u0ba4 \u0bc7\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bb5\u0bbf\u0bae\u0bb0\u0bbe\u0ba4\u0bc7\u0bbe\u0b95 \u0b85\u0ba8\u0bcd\u0ba4 \u0b87\u0b9f\u0ba4\u0bcd\u0b95\u0ba4\u0baa\u0bcd \u0bae\u0baa\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd \u0b95\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0bb1\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b95\u0b9a\u0bbe\u0bb2\u0bcd\u0bb2\u0bbf, \u0b85\u0ba8\u0bcd\u0ba4 \u0b87\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0ba4\u0b95\u0b9f\u0b95\u0baf \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bc8\u0bbe\u0b95 \u0bc7\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bb5\u0bb4\u0bbf\u0b95\u0b95\u0bb3 \u0b89\u0bb0\u0bc1\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bbf \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0baf\u0ba3\u0bbf\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd, \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bc7\u0bbe\u0b95 accidents \u0ba8\u0b9f\u0b95\u0bcd\u0b95\u0bc8\u0bbe\u0bae\u0bcd. \u0b87\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b8f\u0ba4\u0bbe\u0bb5\u0ba4\u0bc1 \u0ba4\u0bc0\u0bb0\u0bcd\u0bb5\u0bc1 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bbe? \u0b8e\u0ba9\u0b95\u0bcd \u0bae\u0b95\u0b9f\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bae\u0bb1\u0ba9\u0bcd.\n\n\u0dda\u0dcf\u0dc4\u0dd2\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc3\u0dca\u0dcf\u0dca\u0dae\u200d\u0dc3\u0dd2\u0dc5\u0dca \u0dd6 \u0d9a\u0dc3\u0d9a\u0dd2\u0d9a\u0dca \u0db1\u0dca.\u0dc3\u0dca\u0dcf\u0dca\u0dae\u200d\u0dc3\u0daf\u0dd4\u0dca\u0dba\u0dbb\u0d9a\u0dc3\u0dcf\u0daf\u0d9a\u0d9c\u0dc3\u0db4\u0dd3\u0db0\u0dca\u200d\u0dd2\u0dbb\u0dda\u0d9a\u0dc3\u0daf\u0dd2\u0d9c\u0dc3\u0d9a\u0dd2\u0dda\u0dbd\u0ddd\u0db8\u0dd3\u0da7 \u0dc35\u0dc0700\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dc0\u0dca\u200d\u0daf\u0dda \u0dc3\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dab\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d92\u0dc0\u0dca\u200d\u0daf\u0dc3\u0dc4 \u0dc4\u0daf\u0dc3\u0d9a\u0db1\u0dc3\u0dd2\u0dba\u0dbd\u0dc3\u0dc0\u0dca\u200d\u0dba\u0dda\u0d9a\u0dca \u0dc3\u0dd2\u0dc5\u0dd2\u0dad\u0d9c\u0dda\u0dad\u0dd4\u0db8\u0dc3\u0daf\u0dd4\u0dca\u0dba\u0dbb\u0d9a\u0dc3\u0dc4 \u0dca\u0dae\u0dc3\u0db4\u0daf \u0dc0\u0dca\u200d\u0dbd\u0dca\u0dc35\u0dc0362\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dda\u0dca\u0dc0\u0dca\u200d\u0daf\u0dda\u0d9a\u0dca \u0dc3\u0dcf\u0dc4\u0da2\u0db1\u0dc3\u0dcf\u0daf\u0dc0\u0dd2\u200d\u0d9a\u0dc3\u0dca\u0dcf\u0dc4\u0daf\u0dc3\u0dc0\u0dd2\u0dc0\u0dca\u200d\u0dca\u200d\u0dc0\u0dca\u200d\u0dc3\u0db4\u0dc0\u0dca\u200d\u0dd2\u0dbb\u0db1\u0dc3\u0daf\u0dd4\u0dca\u0dba\u0dbb\u0d9a\u0dc3\u0dc4 \u0dca\u0dae\u0dc3\u0dcf\u0daf\u0d9a\u0d9c\u0dc3\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dab\u0d9a\u0dc35\u0dc0577\u0dba\u0dd2.\u0dc3587\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dda\u0db4\u0dde\u0dd3\u0d9c\u0dd2 \u0dc3\u0daf\u0dd4\u0dca\u0dba\u0dbb\u0d9a\u0dc3\u0dc4 \u0dca\u0dae\u0dc3\u0dcf\u0daf\u0d9a\u0d9c.\u0dc3\n\n\u0d86 \u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dd2\u0dad\u200d\u0dc3\u0daf\u0dd4\u0dca\u0dba\u0dbb\u0d9a\u0dc3\u0dc4 \u0dca\u0dae\u0dc3\u0dcf\u0daf\u0d9a\u0d9c\u0dc3\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dab\u0d9a\u0dc3763\u0dba\u0dd2.\u0dc3\u0d92\u0dc3\u0daf\u0dd4\u0dca\u0dba\u0dbb\u0d9a\u0dc3\u0dc4 \u0dca\u0dae\u0dc3\u0dcf\u0daf\u0d9a\u0d9c\u0dc3763\u0dca \u0dc330] \u0da7\u0dc3system \u0d91 \u0d9a\u0dd2\u0dca \u0dc3\u0d86 \u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0daf\u0dc0\u0dca\u200d\u0dc3\u0daf\u0dd3\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0daf\u0dd4\u0dca\u0dba\u0dbb\u0d9a\u0dc3\u0dc4 \u0dca\u0dae\u0dc3\u0dcf\u0daf\u0d9a\u0d9c\u0dc3474 \u0da7\u0dc3\u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0dc3\u0dc3\u0dd3\u0dd4\u0dc0\u0dc3\u0dca\u0dc4\u0dd2\u200d\u0dc0\u0dca\u200d\u0dc3\u0d86 \u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0daf\u0dc0\u0dca\u200d\u0dc3\u0daf\u0dd3\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0daf\u0dd4\u0dca\u0dba\u0dbb\u0d9a\u0dc3\u0dda\u0dcf\u0db4\u0daf\u0d9a\u200d\u0dda\u0dca\u0dca \u0dad\u0dd4\u0db8\u0dc0\u0dca\u200d\u0dda\u0dc3\u0dd2\u0dc5\u0dd2\u0dad\u0d9c\u0dca \u0db1\u0daf\u0dc0\u0dc3\u0dda\u0db4\u0daf\u0dd2\u0dca\u0dae\u0dc3\u0d86 \u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0daf\u0dc0\u0dca\u200d\u0dc3\u0dca\u0dc4\u0dd2\u200d\u0dc3\u0dad\u0db1\u0dad\u0dd4\u0db8\u0dd4\u0dc0\u0dc3\u0d87\u0dd9\u0dd3\u0dca\u0dc3\u0db4\u0dd4\u0dc0\u0dca\u200d\u0dd4\u0dc0\u0dc0\u0dca\u200d\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dcf\u0db1\u0dca\u0dca \u0dc3\u0d86 \u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0daf\u0dc0\u0dca\u200d\u0dc3\u0dca\u0db4\u0d9a\u0daf\u0dc3\u0d87\u0dd2\u0dbb\u0dc3\u0daf\u0dd4\u0dca\u0dba\u0dbb\u0d9a\u0dc3\u0dc4 \u0dca\u0dae\u0dc3\u0dcf\u0daf\u0d9a\u0d9c\u0dc3\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dab\u0d9a\u0dc3454\u0dba\u0dd2.\u0dc3\u0d92\u0dc3454\u0dda\u0dc3system \u0d91 \u0d9a\u0dd2\u0dca \u0dc3control \u0dca \u0db1\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dba\u0dba\u0dc3\u0dc0\u0dca\u200d \u0dc3 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc3 \u0dda\u0d9c\u0db1\u0dc3\u0d9a\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dad\u0dd2\u0dc5\u0dc3\u0dda\u0dca\u0dc3\u0dc0\u0dca\u200d\u0dca\u0dda\u0d9a\u0dc3\u0dcf\u0dc4\u0dc0\u0dca\u200d\u0dc3\u0dc3\u0dd2\u0da7\u0dc3\u0dad\u0dd4\u0dc0 \u0daf\u0db0\u0dca\u200d\u0db4\u0dd4 \u0d9a\u0dc3\u0dcf\u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0dca\u200d\u0daf\u0dc346\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dc4\u0dcf\u0daf\u0dda\u0d9c\u0db1\u0dc3\u0d9a\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u200d\u0dc0\u0dca\u200d\u0dda\u0dc3368\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0db1\u0dd2\u0dbb\u0dba\u0dbb\u0dc3\u0dda\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d9c\u0dd4\u0dc0\u0dc3 \u0dcf\u0daf\u0db1\u0daf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0dd2\u0dba\u0dc0\u0dc3\u0dad\u0dd2\u0dc5\u0dc3\u0dc0\u0dbd\u0daf\u0dda\u0db4\u0daf\u0dda \u0daf\u0dda\u0dad\u0dd4\u0db8\u0dc3\u0dda\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf\u0dc0\u0dc3\u0d92\u0dc3\u0daf\u0dd4\u0dca\u0dba\u0dbb\u0d9a\u0dc3\u0dc4 \u0dca\u0dae\u0dc3\u0dcf\u0daf\u0d9a\u0d9c\u0dc3368\u0dca \u0dc3534\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dad\u200d\u0dba\u0dc0\u0dca\u200d\u0dba\u0dba\u0dba\u0dd2\u0dc3\u0d9a\u0dd2\u0d9a\u0dbd\u0daf\u0dc3\u0dc4\u0db3\u0dd4\u0db1\u0daf\u0dda\u0d9c\u0db1\u0dc32027\u0dad\u0dd4\u0dab\u0dd4\u0dc0\u0dd3\u0dda\u0dd3\u0daf\u0dd3\u0dc3\u0db1\u200d\u0daf\u0dc3\u0db1\u0d9a\u0dca\u0d9a\u0dba\u0dcf\u0dd2\u0dba\u0dca \u0dc3\u0d92\u0dc0\u0dca\u200d\u0daf\u0dda\u0d9a\u0dc3 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dca\u0dca \u0dc3 \u0dca \u0db1.\u0dc3\u0d92\u0dc0\u0dca\u200d\u0daf\u0dda\u0d9a\u0dca \u0dc3500 \u0dc3 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc3\u0dda\u0da7\u0dca \u0d9a\u0dc3\u0dcf\u0db1\u0dca\u0dd4\u0dc0\u0dda\u0dc0\u0dc334 \u0dc3 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc3\u0daf\u0dd4\u0dca\u0dba\u0dbb\u0d9a\u0dc3\u0dda\u0dcf\u0db4\u0daf\u0d9a\u200d\u0dda\u0dca\u0dca \u0dad\u0dd4\u0db8\u0dc0\u0dca\u200d\u0dc3\u0dcf\u0db1\u0dca\u0dd4\u0dc0\u0dda\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dca\u0dca \u0dc3 \u0dca \u0db1\u0dc3 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc3 \u0db1\u0dc0\u0dca\u200d\u0daf\u0dc0\u0dc3\u0d92\u0dc3\u0dad\u0dc0\u0dca\u200d\u0dba\u0dba\u0dc3 \u0db1\u0dc3capacity \u0d91 \u0dc3\u0daf\u0dd4\u0dca\u0dba\u0dbb\u0d9a\u0dc3\u0dda\u0dcf\u0db4\u0daf\u0d9a\u200d\u0dda\u0dca\u0dca \u0dad\u0dd4\u0db8\u0dc0\u0dca\u200d\u0da7\u0dc3\u0db1 \u0dd2\u0dbb\u0dc3\u0dd2\u0dba\u0dca\u0daf.\n\n\u0d9c\u0dd4\u0dc0\u0dc3\u0dcf\u0dca \u0dd3\u0dad\u0dd4\u0db8\u0dcf\u0daf\u0dda \u0dc3\u0dca\u200d\u0dbb\u0dba\u0dae\u0db1\u0d9a\u0dc3\u0d9c\u0dda\u0dda\u200d\u0daf\u0dda\u0dc0\u0dc3\u0dc0\u0dd2\u0dda\u0dba\u0dae\u0dc2\u0dda\u0d9a\u0dca \u0dcf\u0dc3\u0d8b\u0dad\u0dd4\u0db8\u0dd4\u0dc0\u0dc3\u0db4\u0dc5\u0daf\u0dda\u0dda\u0dc3\u0daf\u0dd4\u0dca\u0dba\u0dbb\u0d9a\u0dc3\u0dc4 \u0dc4\u0daf\u0dc3\u0dc4 \u0dca\u0dae\u0dc3\u0dcf\u0daf\u0d9a\u0d9c\u0dc3\u0dc0\u0dca\u200d \u0da9\u0dd2\u0dba\u0dd2.\u0dc3\u0db1 \u0dda\u0dd9\u0db1\u0dc4\u0dd2 \u0dc3\u0db4\u0dc5\u0daf\u0dda\u0dda\u0dda\u0dc3\u0d9a\u0dca\u0dc3\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dab\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dc0\u0dd2\u0dda\u0dba\u0dae\u0dc2\u0dda\u0d9a\u0dca \u0dcf\u0dc3\u0dba\u0dd4\u0dd3\u0db0\u0dca\u200d\u0d9a\u0dc3\u0db4 \u0dc0\u0dca\u200d\u0dd2\u0dbb\u0dc3\u0dc0\u0dca\u200d \u0dc0\u0dca\u200d\u0daf\u0dd4\u0dc0\u0dda\u0dc0 \u0dc3\u0dda \u0ddd\u0da0\u0dca\u0dd2\u0dc3\u0d9c\u0dd2\u0dda\u0d9a\u0dc3\u0db1 \u0dd2\u0dbb\u0dc3\u0dd2\u0dba\u0dca\u0daf\u0dc3\u0da2\u0db1\u200d\u0daf\u0dc0\u0dca\u200d\u0dc3\u0dad\u0dd4\u0dab\u0dd4\u0dc0\u0daf\u0dd4\u0dc350\u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0dc357\u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0dc320\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dd2\u0dbb\u0dca\u0dae\u0dda\u0dca\u0dae\u0dc3\u0dda \u0ddd\u0da0\u0dca\u0dd2\u0dc3\u0db4\u0daf \u0dc3\u0dc4 \u0dc4\u0daf\u0dc3\u0d9a\u0dca \u0db1\u0dc3\u0db4\u0dd4\u0dd4\u0dc0\u0daf\u0dd4\u0dc3\u0dd4\u0dab\u0dab\u0daf.\u0dc3\u0dda \u0ddd\u0da0\u0dca\u0dd2\u0dc3\u0d91\u0dca \u0dda\u0dca \u0dc3\u0db1 \u0dd2\u0dbb\u0dc3\u0dd2\u0dba\u0dca\u0daf\u0dc3\u0d92\u0dda\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dca\u200d\u0dbb\u0dba\u0dae\u0db1\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0db1 \u0dc4 .\u0dc3\u0db1\u0db8\u0dd4\u0dda\u0dc0\u0dc3\u0dcf \u0dca \u0dc3\u0dda \u0ddd\u0da0\u0dca\u0dd2\u0dc3"
  },
