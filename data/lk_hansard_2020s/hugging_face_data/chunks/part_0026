    "chunk_text": "\u0dd6\u0dbd\u0d82\u0dcf\u0dab\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dba\u0dbb\u0dd4 \u0db1\u0dca\u0daf\u0dd3\u0dad\u0dd4\u0db8 \u0dd2\u0dba, \u0dc0\u0dda \u0dc0\u0dba \u0dca\u200d\u0db1\u0dcf\u0dc0 \u0d89\u0dd2\u0dbb\u0dd2\u0db4\u0dcf\u0dad\u0dca \u0daf\u0dcf\u0db1\u0dca\u0daf\u0dc0\u0db1\u0dca\u0daf \u0db4\u0dcf\u0d9a\u0dca\u0dc2\u0dba\u0d9a\u0dca \u0dc0\u0d82\u0dab \u0dca\u200d\u0dcf\u0dad\u0dd2\u0daf \u0dca\u200d\u0db1 \u0db6\u0d82\u0dc0\u0dda\u0dba\u0dba\u0dad\u0dca, \u0dab \u0dcf\u0dca\u200d\u0dc0\u0dcf\u0daf\u0dd3 \u0dd2\u0dbb\u0dd4\u0d9c \u0dab\u0dd2\u0dba \u0dba\u0dad\u0dca \u0d92 \u0dd2\u0dbb\u0dd4\u0d9c \u0dab\u0dd2\u0dba\u0dda\u0dc0\u0d82 \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0daf\u0dcf\u0dbb\u0dd2\u0dad\u0dca\u0dc0 \u0dab \u0d9f\u0dd2\u0db1\u0dca\u0daf. \u0dc0\u0dda \u0d89\u0dd2\u0dbb\u0dd2\u0db4\u0dcf\u0dad\u0dca \u0dc0\u0dc0\u0db1\u0dca\u0daf\u0dc0\u0db1\u0dca\u0daf \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0daf\u0da7 \u0db8\u0dc4\u0dd2\u0dd2\u0dba \u0daf\u0dcf\u0db4\u0dd4 \u0db8\u0db1\u0dcf\u0dba\u0dd2\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0daf\u0dbb\u0dd4\u0dab\u0dd4. \u0dd2 \u0db1\u0dca\u0daf\u0dc0 \u0db8\u0dda \u0d82\u0dcf \u0dd2\u0dcf\u0dad\u0dca\u0dd2\u0d82\u0dcf, \u0db8\u0db1\u0dca\u0dba\u0d82\u0dcf \u0db8\u0d9a\u0dca\u0daf\u0d82\u0dcf \u0db1\u0dd0\u0dad\u0dd2 \u0dc0\u0dc0\u0da0\u0dca\u0da0 \u0dd2\u0dcf\u0dbb\u0dd4\u0d9c\u0dba\u0dc0\u0dda \u0dc4\u0dac \u0dd2 \u0db1\u0dca \u0dc0\u0dda \u0dc0\u0dba \u0dca\u200d\u0db1\u0dcf\u0dc0 \u0dad\u0dd4\u0db8\u0dc3 \u0dad\u0dd2\u0dc0\u0db6\u0db1\u0dca\u0daf\u0dc0\u0db1\u0dca\u0daf. 1980\u0db1\u0dca\u0daf \u0db4\u0dcf\u0dab\u0dca\u0dc0\u0dab\u0dca \u0d82\u0dd2\u0daf\u0dcf\u0dc0\u0dda \u0dd2\u0dbb\u0dd4\u0d9c\u0dba\u0db1\u0dca\u0daf\u0da7 \u0db7\u0dcf\u0dcf \u0dc0\u0dc5\u0db1\u0dca\u0daf\u0db1 \u0dad\u0dd2\u0db6\u0dd4\u0dc0\u0dab\u0dca \"\u0dd4\u0d9a\u0db1\u0dca\u0daf\u0dc5\u0dcf, \u0dab\u0dcf \u0daf\u0dcf\u0db8\u0dd3, \u0dab\u0dc0\u0dc4 \u0dc5\u0dcf\u0dad\u0dca\u0dc0\u0dc0\u0dba\u0db1\u0dca\u0daf \u0db4\u0dd2\u0dbb\u0dd2 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d82\u0dd2\u0daf\u0dcf\u0dc0\u0d9a\u0dca\" \u0d9a \u0dba\u0db1 \u0db6\u0dd0\u0da7\u0dca\u0db1\u0dca\u0daf \u0d91\u0daf. \u0d92 \u0db6\u0dd0\u0da7\u0dca\u0db1\u0dca\u0daf \u0d91\u0daf \u0dd2 \u0db1\u0dca \u0db8\u0dbd\u0dd4\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dda\u0db4\u0dcf\u0dcf\u0dcf\u0dc0\u0da7 \u0db7\u0dcf\u0dcf \u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc0 \u0dad\u0dd2\u0db6\u0dd4\u0dc0\u0dab\u0dca. \u0dc4\u0dd0\u0db6\u0dd0\u0db1\u0dca, \u0d92 \u0dc0\u0dc0\u0db1\u0dd4\u0dc0\u0da7 \u0daf\u0dc5\u0dd4 \u0da2\u0dd6\u0dbd\u0dd2\u0dba \u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0db1\u0dca\u0daf \u0dab\u0dd2\u0dc0\u0d9a\u0dca\u0dd2\u0dcf\u0dad\u0dca \u0daf\u0dc0\u0dad\u0dca, \u0d8a\u0da7 \u0dc0\u0db4\u0dcf\u0dcf\u0dad\u0dca, \u0d8a\u0da7 \u0db4\u0dcf\u0dd4\u0d9a\u0dc0\u0dad\u0dca \u0dc3\u0dd2\u0dda\u0dca\u200d \u0dc0\u0dc0\u0da0\u0dca\u0da0 \u0dc0\u0dda \u0dd2 \u0db1\u0dca, - \u0dc0\u0dd2\u0dc0\u0dc1\u0dca\u0dc2\u0dc0\u0dba\u0db1\u0dca\u0daf \u0daf\u0dc5\u0dd4 \u0da2\u0dd6\u0dbd\u0dd2\u0dc0\u0dda\u0daf\u0dd3 \u0dc3\u0dd2\u0dda\u0dca\u200d \u0dc0\u0dc0\u0da0\u0dca\u0da0 \u0dc0\u0dda \u0dd2 \u0db1\u0dca - \u0d92 \u0dab\u0dc0\u0dc4 \u0dc5\u0dcf\u0dad\u0dca\u0dc0\u0dba, \u0dab\u0dcf \u0daf\u0dcf\u0db8\u0dd3 \u0db6\u0dc0, \u0dab \u0d9f\u0dd2\u0dba \u0db4\u0dd2\u0dbb\u0dd2\u0da0\u0dca\u0da0 \u0d82\u0dd2\u0daf\u0dcf\u0dc0\u0d9a\u0dca \u0d9a \u0dba\u0db1 \u0db6\u0dd0\u0da7\u0dca\u0db1\u0dca\u0daf \u0d91\u0daf \u0dc0\u0dc0\u0db1\u0dd4\u0dc0\u0da7, \u0dab\u0dd2\u0daf\u0dcf\u0dc0, \u0dbb\u0dc0\u0dcf\u0dba \u0db4\u0dd2\u0dbb\u0dd2\u0da0\u0dca\u0da0, \u0dad\u0dd4\u0db8\u0dc0\u0d9a\u0dca\u0d9a\u0dd4\u0dc0 \u0db8\u0dd2\u0da7 \u0dba\u0dad\u0dca\u0dd2 \u0db6\u0dd0\u0da7\u0dca\u0db1\u0dca\u0daf \u0d91\u0daf\u0d9a\u0dca \u0db8\u0db4\u0dcf\u0da7 \u0db7\u0dcf\u0dcf \u0daf\u0dd3 . \u0d92\u0daf \u0daf\u0dd4\u0db1\u0dca\u0daf\u0dc0\u0db1\u0dca\u0daf \u0dc0\u0dca.\u0d86\u0dbb\u0dca. \u0dca\u200d\u0dba\u0dc0\u0dbb\u0dca\u0dca\u200d\u0db1. \u0d92\u0daf \u0daf\u0dd4\u0db1\u0dca\u0daf\u0dc0\u0db1\u0dca\u0daf, \u0d91\u0d9a\u0dca\u0dab\u0dad\u0dca \u0dca\u200d\u0dcf\u0dad\u0dd2\u0daf \u0db4\u0dcf\u0d9a\u0dca\u0dc2\u0dba. \u0d8a\u0da7 \u0daf\u0dbd\u0dd2\u0db1\u0dca\u0daf \u0db8\u0dba\u0dad\u0dca - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d82\u0dd2\u0daf\u0dcf \u0dd2\u0dba\u0dc5\u0dc4\u0dab\u0dca \u0db4\u0dcf\u0d9a\u0dca\u0dc2 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 - \u0d92\u0daf\u0da7 \u0db8\u0dc5\u0dcf\u0dc3\u0dc0 \u0daf\u0dcf\u0db4\u0dd4 \u0dc0\u0dda\u0dc0\u0dbd\u0dca \u0dad\u0dd2\u0dc0\u0db6\u0db1\u0dc0\u0dcf. \u0db1\u0dc4\u0dd4\u0dad\u0dca \u0d92\u0daf \u0dba\u0dd4\u0dda\u0dca\u200d\u0dba\u0d9a\u0dca \u0daf\u0dcf\u0d82\u0dcf, \u0dad\u0dd4\u0db8\u0dc0\u0d9a\u0dca\u0d9a\u0dd4\u0dc0\u0d9a\u0dca \u0db8\u0dd2\u0da7 \u0daf\u0dd3\u0d82\u0dcf, \u0d92\u0daf \u0db8\u0dc0\u0db4\u0dca \u0dcf\u0dc0\u0da7\u0dca \u0dab\u0dc5\u0dcf\u0daf\u0dcf\u0dbd\u0dd2\u0daf \u0daf\u0dd0\u0dc3\u0dd0\u0d82\u0d9a\u0dca \u0dc0\u0d82\u0dab \u0dd2\u0dba\u0dc1\u0dca\u0da0\u0dd2\u0dd2\u0dc0 \u0daf\u0dc0\u0dc3\u0dca \u0d91\u0d9a\u0dca\u0dab\u0dad\u0dca \u0dca\u200d\u0dcf\u0dad\u0dd2\u0daf \u0db4\u0dcf\u0d9a\u0dca\u0dc2\u0dba. \u0d92\u0daf \u0dc0\u0dda \u0dcf\u0dc0\u0da7\u0dca \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dab\u0dc0\u0dda \u0dd2\u0dba\u0dc1\u0dca\u0da0\u0dd2\u0dd2 \u0daf\u0dbb\u0dd4\u0d9c\u0d9a\u0dca, \u0dc4\u0dd2\u0dba\u0db1\u0dca\u0daf\u0db1 \u0db6\u0dd0\u0dbb\u0dd2. \u0db8\u0db1\u0dca\u0daf\u0db1 \u0d92 \u0dc0\u0dda\u0dc5\u0db1\u0dcf\u0dc0 \u0dd2\u0dba\u0dab\u0dcf \u0dd2 \u0db1\u0dca \u0daf\u0dc5\u0dd4 \u0da2\u0dd6\u0dbd\u0dd2\u0dba\u0da7 \u0d91\u0dc0\u0dcf\u0dc4\u0dd2\u0dc0 \u0dab\u0dc0\u0dc4 \u0dc5\u0dcf\u0dad\u0dca\u0dc0\u0dba \u0dc0\u0dbb\u0dca\u0dca\u200d\u0db1\u0dba \u0daf\u0dcf\u0db1, \u0dab\u0dc4\u0da2\u0dd3\u0dc0\u0db1\u0dba \u0dc0\u0dbb\u0dca\u0dca\u200d\u0db1\u0dba \u0daf\u0dcf\u0db1, \u0d82\u0dd2\u0daf\u0dcf\u0dc0 \u0dc0\u0dc5 \u0dc3, \u0dc4\u0dd4\u0dab\u0dca\u0dbd\u0dd2\u0dda, \u0dc3\u0dd2\u0dd2\u0dc4\u0d82 \u0db8\u0db4\u0dcf \u0daf\u0dcf\u0da7\u0dad\u0dca \u0d91\u0daf \u0dc4\u0dcf \u0dab \u0dcf\u0db1\u0dc0 \u0db8\u0db1\u0dca\u0dad\u0dd2\u0db1\u0dca \u0d9a \u0dba\u0d82\u0dcf \u0d82\u0dd2\u0daf\u0dcf\u0dc0\u0dda \u0dd2\u0dcf\u0dbb\u0dd4\u0d9c\u0dba\u0dba\u0da7 \u0db8\u0db4\u0dd2 \u0dc0\u0dda \u0dc4\u0dcf\u0dc4\u0dcf \u0d9a \u0dba\u0db1\u0dca\u0daf\u0dc0\u0db1\u0dca\u0daf. \u0daf\u0dc5\u0dd4 \u0da2\u0dd6\u0dbd\u0dd2\u0dba \u0dd2\u0d9a\u0dca \u0d9a \u0dd3\u0d9a\u0dc0 \u0db1\u0dca\u0daf \u0d92 \u0dc4\u0dcf\u0dc4\u0dcf \u0d89\u0dab\u0dca\u0dab\u0dcf\u0dc4\u0da7 \u0dba\u0db1 \u0dba \u0db1 \u0dba\u0dd0\u0db1 \u0dd2 \u0db1\u0dca \u0dc0\u0dda \u0dad\u0dd2\u0dc0\u0db6\u0db1\u0dca\u0daf\u0dc0\u0db1\u0dca\u0daf."
  },
