    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7 \u0db4\u0dd4\u0dda\u0dbb\u0ddd\u0d9a\u0dcf\u0db1 \u0d9a\u0dbb\u0db1\u0dc0\u0dc1 \u0dda\u0d9c\u0ddd\u0dbd\u0dd3 \u0d8b\u0daf\u0dca\u0db0\u0db8\u0db1 \u0d89\u0dc4\u0dc5 \u0db1\u0dc0\u0dc1 \u0d9a\u0dd2 \u0dbd\u0dc1. \u0d92\u0d9a\u0da7 \u0dc0\u0dd2\u0dda\u0db1\u0d9a\u0dc2\u0dda \u0db1\u0dca \u0d89\u0db1\u0dca\u0db0\u0db1 \u0dc3\u0dc4 \u0dda\u0db4\u0dc1\u0dda\u0dc4\u0dc1\u0dbb \u0db8\u0dd2\u0dbd \u0d89\u0dc4\u0dc5 \u0dc1\u0db8 \u0db6\u0dbd\u0db4\u0dc1\u0db1\u0dc0\u0dc1. 2026\u0daf\u0dd3 \u0dc3\u0dd2 \u0da7 (.7\u0d9a \u0dda\u0d9c\u0ddd\u0dbd\u0dd3 \u0d8b\u0daf\u0dca\u0db0\u0db8\u0db1 \u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dda\u0dc0\u0dd2 \u0d9a\u0dd2 \u0dbd\u0dc1 \u0d85\u0dda\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dc1 \u0d9a\u0dbb\u0db1\u0dc0\u0dc1. \u0dbd\u0dc3\u0d9a\u0dc1\u0dc0 \u0dc0\u0dc1\u0dda \u0dc3\u0dc3\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc0\u0db1 \u0dbb\u0da7\u0dc0\u0dbd \u0dc3\u0dd2 \u0da7 5.1 \u0d89\u0d9a\u0dca\u0db8\u0dc0\u0db1 \u0d8b\u0daf\u0dca\u0db0\u0db8\u0db1 \u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dda\u0dc0\u0dd2 \u0d9a\u0dd2 \u0dbd\u0dc1 \u0d85\u0dda\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dc1\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dc1. \u0d92 \u0dc0\u0dc1\u0dda \u0db8 \u0dc3\u0dd0\u0db4\u0dba\u0dd4\u0db8\u0dca \u0daf\u0dc1\u0db8 \u0d9a\u0da9\u0dc1\u0d9a\u0db4\u0dca\u0db4\u0dbd\u0dca \u0dd3\u0db8 \u0db1\u0dd2\u0dc3\u0dc1 \u0dda\u0dc4\u0ddd\u0db8\u0dd4\u0dc3\u0d9a \u0dc3\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb \u0dc3\u0db1\u0dca\u0db0\u0dd2 \u0dc4\u0dbb\u0dc4\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc1\u0dc4\u0db1 \u0d9a\u0dbb\u0db1 \u0dc3\u0dd1\u0db8 \u0db7\u0dc1\u0da9\u0dd4\u0d9a\u0da9 \u0d9a\u0db1\u0dca\u0dda\u0da7\u0dca\u0db1\u0dbb \u0d9a\u0da7\u0db8 \u0d85\u0db8\u0dad\u0dbb \u0dda\u0da9\u0dc1\u0dbd\u0dbb\u0dca 1 000\u0d9a \u0db4\u0dd2\u0dbb\u0dd2\u0dc0\u0dd0 \u0d9a\u0dca \u0dc0\u0dd0 \u0dda\u0dc0\u0dbd\u0dc1 \u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dc1 \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dc1. \u0d92\u0d9a \u0dda\u0dbd\u0ddd\u0d9a\u0dda\u0dda \u0d86\u0dc4\u0dc1\u0dbb \u0db4\u0dc1\u0db1 \u0dc3\u0dc4 \u0dda\u0db4\u0dc1\u0dda\u0dc4\u0dc1\u0dbb \u0dc4\u0dd2\u0d9f \u0da7 \u0db8\u0dca \u0db6\u0dbd\u0db4\u0dd1\u0db8\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0d9a\u0dbb\u0db1\u0dc0\u0dc1. \u0d92 \u0db1\u0dd2\u0dc3\u0dc1 \u0dda\u0d9c\u0ddd\u0dbd\u0dd3 \u0db7\u0dc1\u0da9\u0dd4\u0d9a\u0da9 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc1\u0dc4\u0db1 \u0db4\u0dd2\u0dbb\u0dd2\u0dc0\u0dd0 \u0dda\u0db4\u0dbb\u0da7 \u0dc0\u0da9\u0dc1 \u0dc3\u0dd2 \u0da7 8(\u0d9a\u0dd2\u0db1\u0dca \u0d89\u0dc4\u0dc5 \u0db1\u0dc0\u0dc1.\n\n\u0dda\u0db8\u0dca \u0d85\u0dc0\u0dc3\u0d9a\u0dcf\u0dc1\u0dda \u0daf\u0dd3\u0dad\u0dca \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2 \u0dc4\u0dd3\u0db1 \u0daf\u0d9a\u0dd2\u0db1\u0dc0\u0dc1 \u0d9a\u0dd4\u0db8\u0db1 \u0dda\u0dc4\u0ddd \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf \u0d9a\u0dca \u0d94\u0dc3\u0d9a\u0dda\u0dc3\u0d9a \u0dad\u0db8\u0db1\u0dca\u0dda \u0da2\u0db1\u0dc1\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dc3\u0dd2\u0dc4\u0dd2\u0db1 \u0d86\u0da9\u0dd4\u0d9a\u0dca \u0dc3\u0dd2\u0dc4\u0dd2\u0db1 \u0dc3\u0dd0\u0db6\u0dd1 \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1. \u0d92 \u0d9a\u0da7\u0dca\u0da7\u0dd2 \u0da7 \u0da2\u0db1 \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0d9a\u0da9\u0dc1\u0d9a\u0db4\u0dca\u0db4\u0dbd\u0dca \u0dda\u0dc0\u0db1\u0dc0\u0dc1 \u0db1\u0db8\u0dca \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0d9a\u0dc3\u0dd4\u0db1\u0dca\u0da7 \u0dda\u0dc4\u0dab \u0d9c\u0dd0\u0dc4\u0dd4\u0dc0\u0dad\u0dca \u0d9a\u0db8\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db6\u0dbd \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0db1\u0db8\u0dca \u0d92 \u0dda\u0dc0\u0dd4 \u0dda\u0dc0\u0db1\u0dca \u0d92 \u0d9a\u0da7\u0dca\u0da7\u0dd2 \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf \u0d9a\u0dca \u0db8\u0dc0\u0dbd\u0dc1 \u0dc4\u0dbb\u0dd2\n\n1685 1686\n\n\u0db4\u0dc1\u0dbb\u0dca\u0dd2\u0dda\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\n\n\u0dda\u0db4\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db1 \u0d8b\u0dad\u0dca\u0dc3\u0dc1\u0dc4 \u0d9a\u0dbb\u0db1\u0dc0\u0dc1. \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0db1 \u0db8\u0dd2\u0dc3\u0dd2\u0dbd \u0d89\u0dbb\u0dc1\u0db1 \u0da7 \u0dc0\u0daf\u0dd2\u0db1\u0dda\u0d9a\u0dc1\u0da7 \u0dda\u0db8\u0dda\u0dc4\u0d9a \u0dda\u0dad\u0dbd\u0dca \u0dda\u0db4\u0ddd\u0dd2\u0db8\u0dca \u0da7\u0dd2\u0d9a \u0dc4\u0daf\u0dbd\u0dc1 \u0d89\u0dc0\u0dbb\u0dd2 \u0dda\u0db6\u0dc1\u0dbb\u0dd4 \u0db8\u0dad\u0d9a\u0dca \u0d9a\u0dbb\u0dbd\u0dc1. \u0d91\u0dda\u0dc4\u0db8 \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf \u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dda\u0da9\u0dd4\u0d9a\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d92\u0d9a \u0d85\u0db4\u0dd2 \u0dda\u0dc4\u0dc1\u0db3\u0dd2\u0db1\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dc1\u0d9a\u0dbb\u0dab \u0d9a\u0dbb\u0dbd\u0dc1 \u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dc1. \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dc1 \u0da2\u0db1\u0dad\u0dc1\u0dc0 \u0d92 \u0dad\u0dbb\u0db8\u0dca \u0d85\u0dd4 \u0dc0\u0dab \u0dc0\u0db1\u0dca\u0dda\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0db6\u0dc0. \u0daf\u0db1\u0d9a \u0dc4\u0dad \u0d85\u0da7\u0d9a\u0dca \u0dd2\u0dc4\u0dbd\u0dc1 \u0db6\u0dbd\u0db4\u0dd4 \u0db8\u0dbd\u0dca\u0dbd \u0d86\u0dda\u0dda \u0dda\u0db8\u0dc1\u0d9a\u0da7\u0daf \u0dad\u0dc0 \u0dc0\u0dbb\u0d9a\u0dca \u0d94\u0db6\u0dbd\u0dc1 \u0db6\u0dbd\u0db1\u0dca\u0dda\u0db1\u0dca. \u0dda\u0db8\u0dca \u0d9a\u0dd4\u0db8\u0db1 \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf \u0d86\u0dc0\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0da2\u0db1\u0dad\u0dc1\u0dc0\u0da7 \u0dda\u0dc0\u0da0\u0dca\u0da0 \u0dda\u0db4\u0dc1\u0dda\u0dbb\u0dc1\u0db1\u0dca\u0daf\u0dd4\u0dc0 \u0d85\u0dad\u0dca\u0dc4\u0dd0\u0dbb\u0dbd\u0dc1 \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0db4\u0dd2 \u0d92 \u0d85 \u0dc3\u0db8\u0d9f \u0dad\u0dd2\u0dda\u0db6\u0db1 \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8 \u0d9a\u0da9\u0db1\u0dca\u0dda\u0db1\u0dca\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0db4\u0dd2 \u0d92 \u0d85 \u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0d89\u0dc3\u0d9a\u0dc3\u0dbb\u0dc4\u0da7 \u0db1\u0dc0\u0dc1. \u0d85\u0db4\u0dd2 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dc5 \u0d9a\u0dd2\u0dc3\u0dd2\u0db8 \u0dc3\u0dc3\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc0\u0dd0\u0da9\u0d9a\u0dca \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0dc1 \u0db1\u0dd0\u0dc4\u0dd0. \"\u0daf\u0dd2\u0da7\u0dca\u0dc0\u0dc1\" \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab\u0dc1\u0da7\u0dd4\u0dc0 \u0d86\u0dc0\u0dc1. \u0d92\u0dda\u0d9a\u0db1\u0dca \u0d85\u0dda\u0db4\u0dca \u0dbb\u0da7\u0da7 \u0dda\u0dbd\u0dc1\u0d9a\u0dd4 \u0dc4\u0dc1\u0db1\u0dd2 \u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd4\u0dab\u0dc1. \u0d92\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0dc3\u0dc3\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc0\u0dd0\u0da9 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0db1\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd6\u0dda \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0dd0\u0daf \u0dda\u0db4\u0dbb\u0daf\u0dd2\u0d9c \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf \u0d86\u0dc0\u0dc1. \u0d92\u0d9a \u0dda\u0d9c\u0ddd\u0dbd\u0dd3 \u0dc0\u0db1\u0dda \u0db1\u0dca \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0da7 \u0db6\u0dbd\u0db4\u0dc1\u0db1\u0dc0\u0dc1. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d92 \u0d9a\u0dd2\u0dc3\u0dd2 \u0dda\u0daf \u0d9a\u0dd2\u0db1\u0dca \u0da2\u0db1 \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0db6\u0dd2\u0db3 \u0dc0\u0dd0\u0dda\u0da7\u0db1\u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0d89\u0da9 \u0dad\u0dd0\u0db6\u0dd4\u0dda \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0db0\u0dd2\u0dda \u0d9c\u0dd3 \u0db8\u0dc1\u0dbb\u0dca\u0d9c\u0dc0\u0dbd \u0dc3\u0dd2\u0da7 \u0d9c\u0dca\u200d\u0dbb\u0dc1\u0db8\u0dd3 \u0db8\u0dc1\u0dbb\u0dca\u0d9c \u0daf\u0d9a\u0dca\u0dc0\u0dc1 \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0db8\u0dc1\u0dbb\u0dca\u0d9c \u0dc3\u0dc3\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0dc1 \u0db1\u0dd0\u0dc4\u0dd0. \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc1\u0dc4\u0db1\u0dda\u0dda \u0d89\u0db3\u0dbd\u0dc1 \u0db6\u0dc3\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc1\u0dc4\u0db1 \u0daf\u0d9a\u0dca\u0dc0\u0dc1 \u0d9a\u0dd2\u0dc3\u0dd2\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc1\u0dc4\u0db1 \u0d9a\u0dca \u0db6\u0dd2\u0db3 \u0dc0\u0dd0\u0dda\u0da7\u0db1\u0dca\u0db1 \u0dda\u0daf\u0db1\u0dca\u0dda\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd4\u0db8\u0dc0 \u0d85\u0db4\u0dd2 \u0d92\u0dc0\u0dc1 \u0d85\u0d9b\u0dca\u200d\u0da9\u0dd4\u0d9a\u0da9\u0dc0 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dc1\u0dda\u0d9c\u0db1 \u0db1\u0dc0\u0dc1. \u0d92 \u0dc0\u0dc1\u0dda \u0db8 \u0dda\u0dbb\u0ddd\u0dc4\u0dbd\u0dca \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2 \u0dda\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2 \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dc1 \u0db8\u0dd2\u0dc3\u0d9a\u0dca \u0d92\u0dc0\u0dc1 \u0db6\u0dd2\u0db3 \u0dc0\u0dd0\u0dda\u0da7\u0db1\u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0d89\u0da9 \u0daf\u0dd3\u0dbd\u0dc1 \u0db1\u0dd0\u0dc4\u0dd0."
