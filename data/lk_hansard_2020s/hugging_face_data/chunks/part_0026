    "chunk_text": "(\u0d85 (i) \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dc3\u0d9a\u0dc1\u0dc0 \u0dad\u0dd4\u0db8\u0dc5 \u0daf\u0dd4\u0db8\u0dca\u0dc0\u0dd0\u0da7\u0dd2 \u0dc3\u0db3\u0dc4\u0dc1 \u0dc0\u0db1 \u0db6\u0daf\u0dd4\u0d9a\u0dbb\u0dab \u0db4\u0dca\u200d\u0dbb\u0db0\u0dc1\u0db1 \u0dc0\u0db1\u0dda \u0db1\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0dd4 \u0dbd\u0db6\u0db1\u0dca\u0dda\u0db1\u0dca \u0db1\u0dd2\u0dc2\u0d9a\u0db4\u0dc1\u0daf\u0db1 \u0db6\u0daf\u0dca\u0daf \u0dc4\u0dbb\u0dc4\u0dc1 . \u0db1\u0dd2\u0dc2\u0d9a\u0db4\u0dc1\u0daf\u0db1 \u0db6\u0daf\u0dca\u0daf\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0daf\u0dd4\u0db8\u0dca\u0dc0\u0dd0\u0da7\u0dd2 \u0dc3\u0db3\u0dc4\u0dc1 \u0d91\u0d9a\u0dad\u0dd4\u0db8 \u0d9a\u0dc5 \u0d85\u0d9c \u0db8\u0dad \u0db6\u0daf\u0dca\u0daf \u0dc3\u0dc4 \u0dc3\u0db8\u0dc1\u0da2 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0daf\u0dc1 \u0d9a\u0dad\u0dca\u0dc0 \u0db6\u0daf\u0dca\u0daf \u0d85 \u0dda\u0d9a\u0dda\u0dbb\u0dca.\n\n\u0dad\u0dc0\u0daf \u0daf\u0dd4\u0db8\u0dca\u0dc0\u0dd0\u0da7\u0dd2 \u0db1\u0dd2\u0dc2\u0d9a\u0db4\u0dc1\u0daf\u0db1 \u0dda\u0dc4\u0ddd \u0daf\u0dd4\u0db8\u0dca\u0dda\u0d9a\u0dc1\u0dc5 \u0db4\u0dd2\u0db4\u0dca\u0db4 \u0dc3\u0db3\u0dc4\u0dc1 \u0dda \u0dc1\u0daf\u0dc1 \u0d9c\u0dd0\u0dda\u0db1\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dc3\u0d9a\u0dc1\u0dc0 \u0dad\u0dd4\u0db8\u0dc5 \u0db1\u0dd2\u0dc2\u0d9a\u0db4\u0dc1\u0daf\u0db1 \u0dda\u0d9a\u0dda\u0dbb\u0db1 \u0dc3\u0dd2 \u0dbd\u0dd4\u0db8 \u0daf\u0dd4\u0db8\u0dca\u0dda\u0d9a\u0dc1\u0dc5 \u0dc3\u0db3\u0dc4\u0dc1 \u0daf\u0dd4\u0db8\u0dca\u0dda\u0d9a\u0dc1\u0dc5 \u0db6\u0daf\u0dca\u0daf \u0d85\u0daf\u0dc1\u0dc5 \u0dda .\n\n*\u0dc3\u0dc3\u0dc3\u0d9a\u0dcf\u0dc1\u0db4\u0dd2\u0dad \u0d86\u0daf\u0dc1 \u0db8\u0dca \u0db6\u0daf\u0dd4 \u0d9c\u0dab\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0db3\u0dc4\u0dc1 \u0d85\u0daf\u0dc1\u0dc5 \u0dad\u0d9a\u0dca\u0dda\u0dc3\u0d9a\u0dbb\u0dd4 \u0dc0\u0dbb\u0dca\u0dc2 \u0db4\u0daf\u0db1\u0db8\u0dca \u0d9a\u0dbb\u0dda\u0d9c\u0db1 \u0dad\u0dd2\u0dda\u0db6\u0dca\u0dbd:\n\n2022/2023 2023/202( \u0dc3\u0dc4 202(/2025.\n\n(iii) \u0db1\u0dd3\u0dad\u0dba\u0dd4 \u0dd6\u0dbd\u0dbd \u0daf\u0dd4\u0db8\u0dca\u0dc0\u0dd0\u0da7\u0dd2 \u0db1\u0dd2\u0dc2\u0d9a\u0db4\u0dc1\u0daf\u0db1 \u0dc3\u0dc4 \u0d85\u0dda\u0dc5\u0dc0\u0dd2 \u0db8\u0dad \u0db6\u0daf\u0dd4 \u0db4\u0db1\u0dc0\u0dc1 \u0dad\u0dd2\u0db6\u0dd2 \u0daf\u0dd3\u0dad\u0dca \u0daf\u0dd4\u0db8\u0dca\u0dc0\u0dd0\u0da7\u0dd2 \u0db1\u0dd3\u0dad\u0dd2 \u0dc0\u0dd2\u0dda\u0dbb\u0ddd\u0db0\u0dd3 \u0dda\u0dbd\u0dc3 \u0d86\u0db1 \u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0d85\u0dda\u0dc5\u0dc0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dda\u0db8\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dd3\u0db8\u0dca \u0dbb\u0da2 \u0da7 \u0dc0\u0dc1\u0dbb\u0dca\u0dad\u0dc1 \u0dd3 \u0d87\u0dad.\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dc3\u0d9a\u0dc1 \u0dda\u0dbb\u0dca\u0d9c\u0dd4\u0dc0 \u0dc3\u0dd4\u0dbb\u0dc1\u0db6\u0daf\u0dd4 \u0dda\u0daf\u0db4\u0dc1\u0dbb\u0dca\u0dad\u0dda\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dc3\u0d9a\u0dc1 \u0db1\u0dc1\u0dc0\u0dd2\u0d9a \u0dc4\u0db8\u0dd4\u0daf\u0dc1\u0dc0 \u0dc3\u0dc4 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dc3\u0d9a\u0dc1 \u0dda\u0db4\u0dc1\u0dbd\u0dd3\u0dc3\u0dd2 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dd4 \u0d85\u0daf\u0dc1\u0dc5 \u0db6\u0dbd\u0db0\u0dc1\u0dbb\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0da2\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dbb\u0dd3\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db1\u0dd2\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dc3\u0dc4 \u0db1\u0dd2 \u0dc1\u0db8\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0db8\u0dc1\u0dbb\u0dca\u0d9c \u0dc4\u0dbb\u0dc4\u0dc1 \u0daf\u0dd4\u0db8\u0dca\u0dda\u0d9a\u0dc1\u0dc5 \u0db1\u0dd2\u0dc2\u0d9a\u0db4\u0dc1\u0daf\u0db1\u0dc0\u0dbd \u0db1\u0dd3\u0dad\u0dd2 \u0dc0\u0dd2\u0dda\u0dbb\u0ddd\u0db0\u0dd3 \u0dda\u0dc0\u0dda\u0dc5\u0db3\u0dc1\u0db8 \u0dc0\u0dd0\u0dc5\u0dd0\u0d9a\u0dca\u0dd3\u0db8\u0da7 \u0dc3\u0dc4 \u0d8a\u0da7 \u0d91\u0dda\u0dbb\u0dc4\u0dd2\u0dc0 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0db4\u0dd2 \u0dc0\u0dbb \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb \u0d87\u0dad. \u0dbb\u0da2\u0dda\u0dda \u0d86\u0daf\u0dc1 \u0db8 \u0dbb\u0dd0\u0d9a \u0d9c\u0dd0\u0db1\u0dd3\u0dda\u0db8\u0dca \u0dc3\u0dc4 \u0d85\u0daf\u0dc1\u0dc5 \u0db1\u0dd3\u0dad\u0dd2 \u0dc4\u0dc1 \u0dda\u0dbb\u0d9c\u0dd4\u0dbd\u0dc1\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0d85\u0dd4 \u0dd6\u0dbd\u0dbd \u0dd3\u0db8 \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dda\u0db8\u0dca \u0d85\u0dbb\u0db8\u0dd4\u0dab\u0dd2\u0db1\u0dca \u0daf\u0dd4\u0db8\u0dca\u0dc0\u0dd0\u0da7\u0dd2 \u0db1\u0dd3\u0dad\u0dd2 \u0dc0\u0dd2\u0dda\u0dbb\u0ddd\u0db0\u0dd3 \u0dda\u0dbd\u0dc3 \u0d86\u0db1 \u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dda\u0db6\u0daf\u0dc1 \u0dc4\u0dd0\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0d85\u0dda\u0dc5\u0dc0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dc1\u0dbd\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dc1 \u0d85\u0d9b\u0dca\u200d\u0da9\u0dd4\u0d9a\u0da9\u0dc0 \u0d8b\u0dad\u0dca\u0dc3\u0dc1\u0dc4 \u0db1\u0dca \u0daf\u0dbb\u0dd4 \u0dbd\u0dd0\u0dda\u0db6\u0dca\u0dbd.\n\n(iv) \u0db1\u0dd3\u0dad\u0dd2 \u0dc0\u0dd2\u0dda\u0dbb\u0ddd\u0db0\u0dd3 \u0dda\u0dbd\u0dc3 \u0daf\u0dd4\u0db8\u0dca\u0dc0\u0dd0\u0da7\u0dd2 \u0d86\u0db1 \u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dda\u0dbb\u0dca\u0d9c\u0dd4 \u0d86)\u0dc1\u0db4\u0db1\u0dad \u0dc3\u0dc4 \u0daf\u0dd4\u0db8\u0dca\u0dda\u0d9a\u0dc1\u0dc5 \u0db6\u0daf\u0dd4 \u0db4\u0db1\u0dad \u0da7\u0dda\u0dad\u0dca \u0dc0\u0dbb\u0daf\u0d9a\u0dca \u0dda . \u0dbb\u0dda\u0da7\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dda\u0dad\u0dc1\u0da7\u0dd4\u0db4\u0dc5\u0dc0\u0dbd \u0dc3\u0dc4 \u0dc0\u0dbb\u0dc1 \u0db1\u0dca\u0dc4\u0dd2\u0daf\u0dd3 \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0db1\u0dd3\u0dad\u0dd2 \u0dc0\u0dd2\u0dda\u0dbb\u0ddd\u0db0\u0dd3 \u0d86\u0db1 \u0db1 \u0db1\u0dca \u0dc4\u0dd4\u0db1\u0db1\u0dc1\u0dda\u0d9c\u0db1 \u0d85\u0dad\u0dca\u0d85\u0da9\u0dc3\u0d9c\u0dd4\u0dc0\u0da7 \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dc3\u0dc4 \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dd0\u0dbb\u0daf\u0dd2\u0dc0\u0dbd\u0da7 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd \u0db1\u0dca\u0da7 \u0d91\u0dda\u0dbb\u0dc4\u0dd2\u0dc0 \u0db1\u0dd3\u0dad\u0dd2\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0db8\u0dc1\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dc3\u0d9a\u0dc1 \u0dda\u0dbb\u0dca\u0d9c\u0dd4\u0dc0 \u0d85\u0dc0\u0db1\u0dba \u0db4\u0dd2 \u0dc0\u0dbb \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dc1.\n\n\u0d8a\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0db1\u0dd3\u0dad\u0dd2 \u0dc0\u0dd2\u0dda\u0dbb\u0ddd\u0db0\u0dd3 \u0dda\u0dbd\u0dc3 \u0daf\u0dd4\u0db8\u0dca\u0dc0\u0dd0\u0da7\u0dd2 \u0d86\u0db1 \u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dda\u0db6\u0daf\u0dc1 \u0dc4\u0dd0\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0dc0\u0dd2\u0d9a\u0dd2\u0dab\u0dd3\u0db8 \u0dc0\u0dd0\u0dc5\u0dd0\u0d9a\u0dca\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dc1 \u0dc3\u0dd4\u0dbb\u0dc1\u0db6\u0daf\u0dd4 \u0dda\u0daf\u0db4\u0dc1\u0dbb\u0dca\u0dad\u0dda\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dc3\u0d9a\u0dc1 \u0db1\u0dc1\u0dc0\u0dd2\u0d9a\n\n\u0dc0\u0dc3\u0dca\u0dbb \u0dc0\u0d9a\u0dca\u200d\u0dbb \u0db6\u0daf\u0dd4 \u0d8d\u0da2\u0dd4 \u0db6\u0daf\u0dd4\n\n\u0db1\u0dd2\u0dc2\u0dad\u0db4\u0dcf\u0daf\u0db1\n\n\u0db6\u0dda\u0daf\n\n\u0daf\u0dd4\u0db8\u0dca\u0d9c\u0d9a\u0dcf\u0dc5\n\n\u0db6\u0dda\u0daf\n\n\u0d91\u0d9a\u0dd4 \u0d9a\u0dc5 \u0d85 \u0dba\n\n\u0db8\u0dad \u0db6\u0dda\u0daf\n\n\u0dc3\u0dca\u0db8\u0dcf\u0da2 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab\n\n\u0daf\u0dcf\u0dba\u0d9a\u0dad\u0dca\u0dc0\n\n\u0db6\u0dda\u0daf\n\n\u0dc3\u0dca\u0db8\u0dc3\u0d