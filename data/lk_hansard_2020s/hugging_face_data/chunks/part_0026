    "chunk_text": "\u0d92\u0dc3\u0dc0\u0dca\u200d\u0daf\u0dda \u0dcf\u0dc3\u0d91\u0dad\u0dd4\u0db8\u0dcf\u0daf\u0dc3\u0d87\u0dc4\u0dd4\u0dc0\u0dca\u200d\u0daf\u0dc0\u0dc3\u0d92\u0dc0\u0dca\u200d\u0daf\u0dda\u0d9a\u0dc3\u0db1 \u0dca\u0dc3\u0db1\u0dbd\u0dca\u0dbd\u0dd3\u0dca\u0dc3\u0dca\u0dca\u0dc0\u0dca \u0db0\u0dca\u200d\u0dda\u0d9a\u0dca \u0dc3\u0db1\u0daf\u0dd2\u0dba\u0dbb\u0dda\u0d9a\u0daf\u0dd3\u0dc3\u0dda\u0dcf\u0daf \u0d9a\u0dca\u0d9a\u0dba\u0dcf\u0dc3 \u0dca \u0dda\u0dca \u0dc3\u0d9a\u0dd2\u0d9a\u0dbd\u0daf.\u0dc3 \u0da2\u0dda\u0d9a\u0dc3\u0dad\u200d\u0dba\u0dc0\u0dca\u200d\u0dba\u0dba\u0dc3 \u0daf\u0d9a\u0d9a\u0d9a\u0dca \u0dc3\u0dca\u0dcf\u0dc4\u0daf\u0dc3\u0db1 \u0dca\u0dc3\u0dbd\u0dc0\u0daf\u0dc3\u0daf\u0dd2\u0d9a\u0dc3\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc0\u0dca\u200d\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dc4 \u0dc0 \u0dba\u0dd2\u0dc0\u0dc3 \u0db1\u0dc3\u0db1\u0dbd\u0dca\u0dbd\u0dd3\u0dca\u0dc3\u0dca\u0dca\u0dc0\u0dca \u0db0\u0dca\u200d\u0dda\u0d9a\u0dca \u0dc3\u0dda\u0dc4\u0daf\u0db3\u0dd2\u0dca \u0dc3\u0dda\u0dca\u0daf\u0d9a\u0daf\u0dc3\u0dc0\u0dbd\u0daf\u0dc3\u200d\u0dcf\u0dba\u0dd2\u0dc3\u0d92\u0dc0\u0dca\u200d\u0daf\u0dc3\u0dbd\u0dc0\u0daf\u0dc3\u0daf\u0dd3\u0dca\u0dc3\u0dc3\u0dd2\u0daf\u0dd4\u0dc3 \u0dca \u0dda\u0dca .\u0dc3\u0dda\u0dc0\u0daf\u0dda\u0dc4\u0ddd\u0dc3\u0db1\u0dbd\u0dca\u0dbd\u0dd3\u0dca\u0dc3\u0d91\u0db1\u0dc0\u0dca\u200d\u0daf\u0dc0\u0dc3\u0db4\u0daf\u0dca\u0dbd\u0dca\u0dc0\u0dc3\u0db4\u0dca \u0dca\u0dbd\u0dca\u0dc0\u0dc3\u0db4\u0dbd\u0dca\u0dd2\u0dc0\u0dc3\u0dda \u0ddd\u0dc0\u0dd2\u0dbd\u0dca\u0dc3\u0d87\u0dad\u0dd4\u0db8\u0dd4 \u0dc3\u0dda\u0dd3\u0dc0\u0dca\u200d\u0dbd\u0da7\u0dc3 \u0dc3\u0d9a\u0dd4\u0dab\u0dd4\u0dc3\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0da0\u0dca\u200d\u0dbb\u0dd3 \u0dab\u0dc3\u0dcf\u0db0\u0dca\u200d\u0dba\u0dca\u0dae\u0dcf\u0daf\u0db1\u0dc0\u0dca\u200d\u0dbd\u0da7.\u0dc3\u0dbd\u0dc0\u0daf\u0dc3\u0daf\u0dd2\u0d9a\u0dc3\u0dc4 \u0d9a\u0dd2\u0dc3\u0dc3\u0dd3\u0dd2\u0dba\u200d\u0dc3\u0db1 \u0dca\u0dc3\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dab\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3 \u0dda\u0da8\u0dcf\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0dca \u0dda\u0dca .\u0dc3\u0dad\u200d\u0dba\u0dc0\u0dca\u200d\u0dba\u0dba\u200d\u0daf\u0dc0\u0dca\u200d\u0dc3\u0dc0\u0dbd\u0dbd\u0daf\u0dc0\u0dc3\u0dda\u0dc4\u0daf\u0dcf\u0dc3\u0dc0\u0dd2\u0dcf\u0d9a\u0dba\u0db1\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dcf\u0db0\u0dca\u200d\u0dba\u0dda\u0d9a\u0dc3\u200d\u0dcf\u0dba\u0dd2\u0dc3\u0dad\u0dd2\u0dc5\u0dc3\u0db1 \u0dca\u0dc3\u0dbd\u0dc0\u0daf\u0dc3\u0daf\u0dd3\u0dcf\u0dc3\u0db1\u0daf\u0dd2\u0dba\u0dbb\u0dda\u0d9a\u0daf\u0dd3\u0dc3\u0dc3\u0dd2\u0daf\u0dd4\u0dc3 \u0dca \u0dda\u0dca .\n\n\u0da2\u0db1\u200d\u0daf\u0dc3\u0dc0\u0dca\u200d\u0dad\u0dd4\u0db8\u0dc3\u0dca\u0d82\u0dc0\u0dca\u200d\u0d9a\u0db0\u0dca\u200d\u0db1\u0dc3\u0dcf\u0dab\u0dca \u0dbd\u0d9a\u0da7\u0dc3\u0dad\u0dba\u0dd2\u0dd2\u0dbb\u0dc3\u0db1 \u0dca\u0dc0\u0dca\u200d\u0dbd\u0dc0\u0dc3\u0d92\u0dc3\u0d92\u0dc3\u0daf\u0dd2\u0dca\u0dae\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dc0\u0dca\u200d\u0dbd\u0da7\u0dc3\u0dad\u0dda\u0dc0 \u0dab\u0dd2 \u0dc3\u0dda\u0dc0\u0dca\u200d\u0da0\u0dca\u0da0\u0dc3\u0dc0\u0dd2\u0dc0\u0dd2\u0db0\u0dca\u200d\u0dc3\u0dda\u0dcf\u0ddd\u0d9c\u0dc3\u0dc0\u0dca\u200d\u0d9a\u0d9c\u0dc3\u0dc0\u0dca\u200d\u0d9c\u0daf\u0dc3\u0dda\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dc0\u0daf\u0dd4\u0dbd\u0dca\u0dbd\u0dc3\u0dca\u0dc4\u0dc3\u0dd4\u0dc0\u0dc0\u0dca\u200d \u0d91\u0dd2\u0dad\u0d9a\u0dc3\u0daf\u0dd2\u0dca\u0dae\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dc3\u0dad\u0dd4\u0db8\u0dc5\u0dc3\u0dda\u0dda\u0dc3\u0dc0\u0dca\u200d\u0d9c\u0daf\u0dc0\u0dca\u200d\u0dc3\u0db8\u0dd4\u0dbd\u0dca\u0dc3 \u0dda\u0d9c\u0db1\u0dc3\u0d92\u0dc3\u0d86\u0d9a\u200d\u0db1\u0d9a\u0dc3\u0dca\u0dad\u0dd4\u0db8\u0dc0\u0dca\u200d\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc3\u0db1 \u0dca\u0dc0\u0dca\u200d\u0dbd\u0dc3\u0dc0\u0dca\u200d\u0d9c\u0daf\u0dc3 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dc3\u0dc3\u0dd2\u0daf\u0dd4\u0dc3 \u0db1\u0dc0\u0dca\u200d\u0daf\u0dc3\u0d9a\u0dd2\u0d9a\u0dbd\u0daf\u0dc3\u0dc4\u0dd2\u200d\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dda\u0dca\u0dc3\u0dc0\u0dca\u200d\u0db1\u0dc3\u0dda \u0daf\u0da7\u0dc3\u0dad\u0db4\u0da7\u0dc3\u0d86 \u0d82\u0dd2\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dbd \u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf\u0dc0\u0dc3\u0d86\u0dcf\u0d9a\u0dba\u0dc3\u0dda\u0dda\u0dc3\u0d9c\u0dca\u0dcf\u0daf\u0db1\u0dc3700\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0d86 \u0dca\u0dcf\u0dc3\u0d9a\u0dd2\u0dbb\u0dd3\u0dcf\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dca\u0dca\u0dc0\u0dca \u0db0\u0dca\u200d\u0dc0\u0dca\u200d.\u0dc3\u0dcf\u0dcf\u0dc3\u0dad\u0dda \u0dba\u0dc3\u0dc0\u0dca\u200d\u0d9a\u200d\u0dcf\u0daf\u0db1\u0dc3\u0d9c\u0dd4\u0dc0\u0dc3\u0dad\u0dcf\u0daf\u200d\u0dba\u0dad\u0dd4\u0db8\u0dcf\u0daf\u0dda\u0d9c\u0dca \u0dc3\u0dad\u0dc4\u0db1\u0dc0\u0dca\u200d\u0daf\u0dc0\u0dc3 \u0da2\u0d9a\u0dc3\u0dca\u0dad\u0dd4\u0db8\u0dc0\u0dca\u200d\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc3\u0dcf \u0dc0\u0dca\u200d \u0dca \u200d\u0dc3\u0dca\u0dca\u0db4\u200d\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dda\u0d9a\u0daf\u0dcf\u0daf\u0dda\u0d9c\u0db1\u0dc3\u0d92\u0dc3\u0d86\u0dcf\u0d9a\u0dba\u0dc3\u0dda\u0dda\u0dc3\u0d9c\u0dca\u0dcf\u0daf\u0db1\u0dc3\u0dd2\u0dc5\u0dc4\u0dd2\u0db4\u0dca\u0dc0\u0dca\u200d\u0daf\u0dc3\u0d92\u0dc3\u0dad\u0d9a\u0dda \u0dc3\u0da2\u0db1\u0dc3\u0da2\u0dd3\u0dc0\u0dd2\u200d\u0dda\u0d9a\u0dc3\u0dda\u0dd3\u0dba\u0db4\u0daf\u0dbd\u0db1\u0dc0\u0dc3\u0dca\u0dcf\u0daf\u0da2\u0dc0\u0dc3\u0d86\u0d9a\u0dae\u0dd2\u0d9a \u0dc0\u0dc3\u0dca\u0d82\u0dca\u0dae \u0dca\u0dd2\u0dbb \u0dc3\u0db4 \u0dd2\u0dbb\u0dc3\u0dca\u0d82\u0dc0\u0dca\u200d\u0d9a\u0db0\u0dca\u200d\u0db1\u0d9a\u0dc3 \u0dca \u0db1\u0dc3\u0d94\u0dc0\u0dad\u0dd4\u0db8\u0dcf\u0dca \u0dbd\u0daf\u0dc3\u0dc0\u0dd2\u0dc3\u0dd2\u0dca \u0dc3\u0dad\u0dcf\u0daf\u200d\u0dba\u0daf\u0d82\u0dba\u0d9a\u0dc3\u0dc4 \u0da7\u0dd2\u0d9a\u0da7\u0dc3\u0d9c\u0dca \u0db1\u0daf\u0dc3\u0dc0\u0dd6\u0dc3\u0db1\u0daf\u0dd2\u0dba\u0dbb\u0dc3\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dcf\u0daf\u0d9a\u0d9c\u0dc3\u0dda\u0dcf\u0daf\u0db1\u0dc0\u0dca\u200d\u0daf\u0dcf\u0dc3\u0d9a\u0dd2\u0d9a\u0dbd\u0daf.\n\n609 610\n\n\u0db4\u0daf\u0d9a\u0dd2\u0dda\u0dca\u0dca \u0dad\u0dd4\u0db8\u0dc0\u0dca\u200d\n\n\u0d9c\u0dd4 \u0dc0\u0dda.\u0dd3. \u0dc3\u0dd9\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbb\u0dca \u0db1 \u0dd9\u0dc4\u0dad\u0dcf (\u0bc7\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc7\u0bbf\u0b95\u0bc1 \u0bae\u0b95.\u0bb5\u0bc0. \u0b9a\u0bc7\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0ba4\u0bcd\u0baf\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9) (The Hon. K.V. Samantha Viddyarathna) \u0d9c\u0dd4\u0dc0\u0dc3 \u0dcf\u0daf\u0db1\u0daf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0dd2\u0dba\u0dc0\u0dc3\u0d91\u0dad\u0dd4\u0db8\u0dcf\u0daf\u0dc3\u0dda\u0dca\u0dc3\u0dca\u200d\u0dbb\u0dba\u0dae\u0db1\u0d9a\u0dc3\u0dc0\u0dd2\u0dcf\u0dc3\u0dd3\u0dcf\u0dc3\u0dd2\u0dc5\u0dd2\u0dad\u0dc0\u0dcf\u0dc0\u0dca\u200d\u0dc3\u0dcf\u0dcf\u0dc3\u0dda\u0dc0\u0dda\u0dc4\u0dc0\u0dd2\u0dca \u0dc3\u0dca\u0dae\u0dad\u0dd4\u0db8\u0dd2\u0dbb\u0dc0\u0dca\u200d\u0dca \u200d\u0dc3\u0dda\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dc0\u0dca\u200d \u0dc0\u0dd2\u0dd2\u0dc3\u0dca\u0dc4\u0dc3\u0dca\u200d\u0dbb\u0da2\u0daf\u0dc3\u0d9a\u0da7\u0dd2\u200d\u0dbd\u0dc3\u0db4\u0dc4\u0dc3\u0dd4 \u0dca\u0dc3\u0dad\u0dcf\u0daf\u200d\u0dba\u0daf\u0d82\u0dba\u0d9a\u0dc3\u0dc4 \u0da7\u0dd2\u0d9a\u0da7\u0dc3\u0dad\u0dd2\u0dc5\u0dc3\u0dda\u0dca\u0dc3\u0da2\u0dd6\u0dd2\u0dc357\u0dc0\u0dca\u200d\u0db1\u0dc3\u0dcf\u0daf\u0dc3 \u0da7\u0dc3\u0db4\u0dd4 \u0daf\u0dc3\"Ceylon Tea Village\" \u0db1\u0dd2\u0dba\u0dca \u0dc3\u0db1\u0dc0\u0dca\u200d\u0dc3\u0dc0\u0dca\u200d\u0dba\u0daf\u0db4\u0dca\u0dd2\u0dbb\u0d9a\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0d86 \u0dca\u0dcf\u0dc3 \u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d92\u0dc3\u0d9a\u0dd2\u0d9a\u0dca \u0dda\u0dca \u0dc0\u0dc3\u0dda\u0dda\u0dc3\u0d9c\u0dca\u0dcf\u0daf\u0db1\u0dc3700\u0dc3\u0dc0\u0dca\u200d\u0dba\u0daf\u0db4\u0dca\u0dd2\u0dbb\u0d9a.\u0dc3\u0dcf \u0db1\u0da7\u0dc3\u0db4\u0dc0\u0dca\u200d\u0dd2\u0dbb\u0db1\u0dc3\u0d9a\u0dd4 \u0daf\u0dc3\u0dda\u0dda\u0dc3\u0dc0\u0dca\u200d\u0dad\u0dd4\u0db8\u0dc3\u0d9c\u0dca\u0dcf\u0daf\u0db1\u0dc3\u0dbd\u0dca\u0dd2 \u0dc3 \u0dda\u0d9c\u0db1\u0dc3\u200d\u0dcf\u0dba\u0dd2\u0dc3\u0d92\u0dc3\u0d9c\u0dca\u0dcf\u0daf\u0db1\u0dc3700\u0dc3\u0dda\u200d\u0ddd \u0daf\u0dda\u0d9c\u0db1\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0dca \u0dda\u0dca .\u0dc3\u0dbd\u0d82 \u0daf\u0dda\u0dc0 \u0dc3\u0dda\u0dda\u0dc3\u0dc0\u0dca\u200d\u0d9c\u0daf\u0dc3 \u0db1\u0dc3\u0daf\u0dd2\u0dca\u0dae\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dc354\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0dda\u0dcf\u0dcf\u0dc3\u0dc0\u0dca\u200d \u0dca\u0da7\u0dc4\u0db1\u0dc3\u0d9a\u0da7\u0dda\u0dda\u0dc3\u0d92\u0dc3\u0daf\u0dd2\u0dca\u0dae\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dc354\u0dca \u0dc3\u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0dca\u200d \u0dd2\u0dba\u0dc3\u0dad\u0daf\u0dd2\u0d9a\u0dda\u0d9a\u0daf\u0dd3\u0dc3\u0daf\u0dd2\u0dca\u0dae\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dc355 \u0dc3\u0d91\u0d9a\u0dd3\u0dc3\u0d9c\u0dca\u0dcf\u0daf\u0db1\u0dc3\u0d86 \u0dca\u0dcf\u0dc3\u0dda\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d91\u0dcf\u0dc3\u0dc0\u0dca\u200d \u0dca\u0da7\u0dc4\u0db1\u0dc3\u0da2\u0daf\u0dd2\u0dbb \u0dc3\u0dc0\u0dca\u200d\u0dba\u0dda\u0d9a\u0dca \u0dc3\u0d86 \u0dca\u0dcf\u0dc3 \u0db1\u0dc3\u0d8b\u0dda\u0dca\u0dc0\u0dca\u200d\u0d9a\u0dc3\u0dda \u0daf\u0dda\u0dcf\u0dda\u0dbd\u0dca\u0dc3\u0dca\u200d\u0dbb\u0daf\u0dda\u0dd3\u0dba \u0d9a\u0dc3\u0dda\u0dbd\u0dca \u0dca\u0dc3\u0dda \u0daf\u0da8\u0dcf\u0dc3\u0daf\u0dca\u0dda\u0d9a\u0dc3\u0db4\u0dc0\u0dca\u200d\u0dda\u0dc0\u0dca\u200d\u0dca \u0db1\u0dc3\u0dad\u0dd2\u0dc5\u0dc3\u0dcf \u0db1\u0da7\u0dc3\u0dca \u0dbd\u0dc3\u0dd4\u0dca\u0dc3 \u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3\u0d8a\u0da7\u0dc3\u0dad\u0dcf\u200d \u0dc0\u0dca\u200d\u0dc0\u0dc3\u0daf\u0dd2\u0dca\u0dae\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dc355\u0dc4\u0dd2\u0dcf\u0dc3\u0dca\u200d\u0dbb\u0db0\u0dca\u200d\u0daf\u0db1\u0dc3\u0d8b\u0dda\u0dca\u0dc0\u0dca\u200d\u0d9a\u0dc3\u0dc0 \u0d9c\u0dd2\u0dca \u0dc3\u0db4\u0dc0\u0dca\u200d\u0dda\u0dc0\u0dca\u200d\u0dca \u0db1\u0dc3\u0dad\u0dd2\u0dc5\u0dc3\u0dc3\u0dd6\u0dcf\u0daf\u0db1\u0dca\u0dc3 \u0dc3\u0dd2\u0dbb\u0dda\u0dc0\u0db1\u0dc0\u0dca\u200d\u0daf.\u0dc3"
  },
