c0\u0dc1\u0d9c\u0dba\u0db1\u0dca \u0dc0\u0dc3\u0dbb 5\u0d9a \u0dc3\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0dc4\u0dcf \u0dc3\u0dad\u0dd4\u0da7\u0dd4\u0daf\u0dcf\u0dba\u0d9a \u0d9c\u0dc3\u0dae\u0dc0\u0dcf \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dba\u0d9a\u0dd4 \u0dd3\u0db8.\n\n\u0d9c\u0dc4\u0ddd\n\nii. \u0dbb\u0dcf\u0da2\u0dcf\u0dba \u0d9c\u0dc3\u0dae\u0dc0\u0d9c\u0dda \u0d9c\u0dc4\u0ddd \u0db4\u0dc5\u0dcf\u0dad\u0dca\u0db8 \u0dbb\u0dcf\u0da2\u0dcf\u0dba \u0d9c\u0dc3\u0dae\u0dc0\u0dba\u0d9a \u0d9c\u0dc4\u0ddd \u0dc3\u0dae\u0dd2\u0dbb \u0dd2\u0dc3\u200d\u0dbb\u0dcf\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dc3\u0dc4\u0dd2\u0dad \u0dbb\u0dcf\u0da2\u0dcf\u0dba \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db1 \u200d\u0dbb\u0d9c\u0dca \u0dad \u0d85\u0d82\u0d9a 10/0005 \u0dc4\u0dd2 \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0d9c\u0d9a\u0dca\u0dad \u0d85\u0d82\u0d9a MN 2-2025 \u0d9c\u0dc4\u0ddd \u0d8a\u0da7 \u0d89\u0dc4\u0dc5 MN \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0d9c\u0d9a\u0dca\u0dad \u0d85\u0d82\u0d9a\u0dba\u0d9a\u0dca \u0dba\u0da7\u0d9c\u0dad\u0dca\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dbd\u0db6\u0db1 SL 1-2025 \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0d9c\u0d9a\u0dca\u0dad \u0d85\u0d82\u0d9a\u0dba \u0dba\u0da7\u0d9c\u0dad\u0dca\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dbd\u0db6\u0db1 \u0d9c\u0dc4\u0ddd \u0d9c\u0dc3\u0dae\u0dc0\u0dba\u0d9a / \u0dad\u0db1\u0dad\u0dd4\u0dbb\u0d9a \u0d85\u0dc0\u0db8 \u0dc0\u0dc1\u0d9c\u0dba\u0db1\u0dca \u0dc0\u0dc3\u0dbb 10\u0d9a \u0dc3\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0dc4\u0dcf \u0dc3\u0dad\u0dd4\u0da7\u0dd4\u0daf\u0dcf\u0dba\u0d9a \u0d9c\u0dc3\u0dae\u0dc0\u0dcf \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dba\u0d9a\u0dd4 \u0dd3\u0db8.\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0dbb\u0dd2\u0db4\u0dcf\