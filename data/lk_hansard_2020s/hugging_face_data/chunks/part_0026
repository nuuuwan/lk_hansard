    "chunk_text": "\u0d86\u0db1\u0dba\u0db1\u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0daf\u0da7 \u0dba\u0dda \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0daf \u0db4\u0dcf\u0dc4\u0dd4\u0d9a\u0dc0\u0d9a\u0dca \u0d82\u0db6\u0dcf \u0dba\u0dd0\u0db1\u0dd3 \u0da7 advance payments \u0daf\u0dcf\u0db1\u0dca\u0daf\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0daf. \u0d86\u0db1\u0dba\u0db1\u0daf\u0dbb\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0daf advance payment \u0d91\u0daf \u0daf\u0dc3\u0dcf\u0da7 \u0db4\u0dcf\u0dab\u0dca\u0dc0\u0dab\u0dca \u0db8\u0dc5\u0dcf\u0dc3 \u0dc4\u0dd4\u0dc5\u0dbd\u0dca \u0dc0\u0dba\u0dc0\u0dd3\u0dda \u0dc3\u0dd2\u0daf\u0dd4 \u0daf\u0dcf\u0d82\u0dcf \u0d92 \u0db7\u0dcf\u0dab\u0dca\u0da9 \u0d82\u0dd2\u0daf\u0dcf\u0dc0\u0da7 \u0dc0\u0dba\u0db1\u0dca\u0daf\u0dc0\u0dcf \u0dba\u0db1\u0dca\u0daf\u0db1 \u0d95\u0db1\u0dd1. \u0dc0\u0dda \u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0dcf\u0dc5\u0db1\u0dba \u0d87\u0dad\u0dd4\u0db8\u0dc0\u0dc3\u0dca \u0daf\u0dbd\u0dd2\u0db1\u0dca\u0daf \u0dc0\u0dba\u0dc0\u0dd3\u0dda - advance payments - \u0daf\u0dc3\u0dcf\u0da7 \u0db4\u0dcf\u0dd4\u0d9a\u0dc0 \u0d92 \u0d86\u0db1\u0dba\u0db1\u0daf\u0dbb\u0dd4\u0da7 \u0dc0\u0dba\u0d9a\u0dd3 \u0d9a\u0dca \u0dad\u0dd2\u0dc0\u0db6\u0db1\u0dc0\u0dcf. \u0d92, \u0d92 \u0db7\u0dcf\u0dab\u0dca\u0da9 \u0dc0\u0dbb\u0dca\u0dba\u0dba \u0db8\u0db1\u0dd4\u0dc0 \u0d92\u0dc0\u0dcf \u0d82\u0dd2\u0daf\u0dcf\u0dc0\u0da7 \u0dc0\u0dba\u0db1 \u0d86 \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0daf\u0dcf\u0d82\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0d9c\u0dcf. \u0db8\u0dc5\u0dcf\u0dc3 \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dba \u0db8\u0dc4\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dba\u0dba\u0d9a\u0dca, \u0db4\u0dcf\u0dbb\u0dd2\u0dc0\u0db7 \u0dca\u200d\u0db1 \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dba\u0d9a\u0dca \u0db1\u0dda \u0dd2\u0db1 180\u0d9a\u0dca, \u0daf\u0dcf\u0dbb\u0dca\u0dd2\u0dba\u0daf \u0d8b\u0db4\u0dcf\u0daf\u0dcf\u0d9c\u0dba\u0d9a\u0dca, \u0dd2\u0dba\u0dc2\u0dca\u0db4\u0dcf\u0dcf\u0dc5\u0db1\u0dba\u0da7 \u0dc0\u0dba\u0dcf\u0dc5\u0dcf \u0dba\u0db1\u0dca\u0daf\u0db1 \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dba\u0d9a\u0dca \u0db1\u0dda \u0dd2\u0db1 360\u0d9a\u0dca, \u0dab \u0dc4\u0dcf \u0db8\u0dc0\u0dab\u0dca\u0dae\u0dcf\u0dc0\u0d82 \u0dd2\u0db1 730\u0d9a\u0dca - \u0db8\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0dc0\u0dc5\u0daf\u0d9a\u0dca \u0dc0\u0dcf\u0dc0 \u0daf\u0dd3\u0dbb\u0dca\u0d9d \u0daf\u0dcf\u0d82\u0dba\u0d9a\u0dca - \u0d82\u0db6\u0dcf \u0daf\u0dd3\u0d82\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0d9c\u0dcf, \u0d82\u0dd2\u0daf\u0dcf\u0dc0\u0da7 \u0dc0\u0dba\u0db1 \u0d91\u0db1\u0dca\u0daf\u0db1."
  },
