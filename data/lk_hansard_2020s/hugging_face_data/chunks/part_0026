u0dad\u0dca\u0db8\u0dc0\u0dba\n\n2. \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dc4 \u0d9d\u0db1\u0dad\u0dca\u0db8\u0dc0\u0dba\n\n3. \u0d9c\u0dc3\u0dae\u0dc0\u0dcf \u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0dc3\u0dc4 \u0dba\u0da7\u0dd2\u0dad\u0dbd \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca\u0dc0\u0dbd\n\n\u0dd2\u0db1\u0dba\u0dd4\u0dab\u0dd4\u0dc0\n\n4. \u0dc0\u0dcf\u0dab\u0dd2\u0da2\u0dcf \u0dc3\u0dc4 \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad \u0dca\u0dba\u0dad\u0db1\u0dc0\u0dbd \u0dc0\u0dba\u0dcf\u0dda\u0dad\u0dd2\u0dba\n\n5. \u0d9c\u0dc3\u0dae\u0dc0\u0dcf \u0db1\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dd2\u0dba\n\n6. \u0dc3\u0dae\u0dc0\u0dba\u0d82 \u0da2\u0dcf\u0db1\u0dd2\u0dad \u0dca\u0daf\u0dcf\u0dba\u0db8 \u0dba\u0db1 \u0dc3\u0dcf\u0db0\u0d9a \u0dc3\u0dbd\u0d9a\u0dcf \u0db6\u0dbd\u0db1\u0dd4\n\n\u0dbd\u0db6\u0db1\u0dca. \u0d89\u0dc4\u0dad \u0db1\u0dd2\u0dbb\u0dca\u0dab\u0dcf\u0dba\u0d9a \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0dba \u0daf\u0dad\u0dca\u0db8\u0dad \u0dc4\u0dcf \u0d9c\u0dad\u0dcf\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0da2\u0dcf\u0db1\u0d9c\u0dca \u0dad\u0db1 \u0dc4\u0dcf \u0dc3\u0d82\u0dad\u0dba\u0dcf\u0d9c\u0dca \u0dad\u0db1 \u0d9c\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dd2\u0dc3\u0dd2\u0db1\u0db1\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dc2\u0dd2\u0d9a\u0dc0 \u0dba\u0dcf\u0dc0\u0dad\u0dca\u0db8\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0d9a\u0dbb\u0dd2\u0db1\u0dca \u200d\u0dbb\u0dd2\u0db1\u0daf\u0dca\u0db0 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc0\u0dcf\u0dbb\u0dca\u0dc2\u0dd2\u0d9a \u0dc3\u0d82\u0dad\u0dba\u0dcf\u0d9c\u0dca \u0dad\u0db1 \u0daf\u0dad\u0dca\u0db8\u0dad \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0d85\u0dad\u0dbb \u0db8\u0dd6\u0dd2 \u0d9a \u0db1\u0dd2\u0dbb\u0dca\u0dab\u0dcf\u0dba\u0d9a \u0db8\u0dd0\u0dad\u0dd2\u0db8\u0da7 \u0db4\u0dcf\u0daf\u0d9a \u0d9a\u0dbb \u0d9c\u0dad 