bae\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd\u0baf\u0baa\u0bbe\u0ba4\u0bc1, 41B \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 95(1)\u0b87\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bc1 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0b95\u0bc8 \u0b89\u0bb3\u0bcd\u0bc8\u0b9f\u0b95\u0bcd\u0b95\u0bbf \u0b8e\u0bb2\u0bcd\u0b95\u0bc8 \u0ba8\u0bbf\u0bb0\u0bcd\u0ba3 \u0b86\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1 \u0baa\u0bb5\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba8\u0bbf \u0bc8\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd, \u0baa\u0bbe\u0bb0\u0bbe\u0bb3\u0bc1 \u0bc8\u0ba9\u0bcd\u0bb1\u0ba4\u0bcd \u0baf\u0ba4\u0bb0\u0bcd\u0ba4\u0bb2\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b8e\u0bb2\u0bcd\u0b95\u0bc8 \u0ba8\u0bbf\u0bb0\u0bcd\u0ba3 \u0baa\u0ba3\u0bbf\u0b95\u0bb3\u0bcd \u0bc8\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd \u0b85\u0bb0\u0b9a\u0bbf \u0bc8\u0b95\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0bb2\u0bcd \u0b92\u0baa\u0bcd\u0baa\u0b95\u0b9f\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bc8\u0ba9.\n\n(ii)\n\n(iii) 1. \u0bc8\u0bbe\u0b95\u0bbe\u0ba3 \u0b9a\u0b95\u0baa\u0ba4\u0bcd \u0baf\u0ba4\u0bbe\u0bcd\u0ba4\u0bb2\u0bcd \u0baa\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bc8\u0bbf\u0ba9\u0bcd\n\n\u0b8e\u0bb2\u0bcd\u0b95\u0bc8 \u0ba8\u0bbf\u0bb0\u0bcd\u0ba3 \u0bae\u0bcd\n\n2. \u0baf\u0ba4\u0b9a\u0bbf \u0b8e\u0bb2\u0bcd\u0b95\u0bc8 \u0ba8\u0bbf\u0bb0\u0bcd\u0ba3 \u0b95\u0bc1\u0bb4\u0bc1 - \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\n\n\u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0b99\u0bcd\u0b95\u0bc8\u0bbf\u0ba9\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd \u0b95\u0b95\u0b95 4,000\u0b86\u0b95\u0b95\u0bcd \u0b95\u0bc1\u0b95\u0bb1\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0baa\u0bbe\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1\u0b95\u0bb0\u0b95\u0b95\u0bc8 \u0bae\u0bc1\u0ba9\u0bcd\u0b95\u0bb5\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd.\n\n3. \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf \u0bc8\u0ba9\u0bcd\u0bb1\u0ba4\u0bcd \u0baf\u0ba4\u0bbe\u0bcd\u0ba4\u0bb2\u0bcd \u0baa\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bc8\u0bbf\u0ba9\u0bcd \u0b8e\u0bb2\u0bcd\u0b95\u0bc8 \u0ba8\u0bbf\u0bb0\u0bcd\u0ba3 \u0bae\u0bcd 50:50 \u0ba4\u0ba9\u0bbf\u0ba4\u0bcd\u0baa\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf \u0bb5\u0bbf\u0b95\u0bbf\u0ba4\u0bbe\u0b9a\u0bbe\u0bb0 \u0bae\u0bc1\u0b95\u0bb1\u0b95\u0bcd\u0b95\u0bc1 \u0bc8\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bb5\u0bb4\u0bbf \u0bbe\u0b95 60:40 \u0ba4\u0ba9\u0bbf\u0ba4\u0bcd\u0baa\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf \u0bb5\u0bbf\u0b95\u0bbf\u0ba4\u0bbe\u0b9a\u0bbe\u0bb0 \u0bae\u0bc1\u0b95\u0bb1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0baf\u0ba4\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd \u0baa\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bbe\u0bbf \u0bae\u0bc1\u0ba9\u0bcd\u0baa\u0bc8\u0bbe\u0bb4\u0bbf\u0bb5\u0bc1\u0b95\u0b95\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0ba4\u0bb2\u0bcd.\n\n4. \u0bc8\u0bbe\u0b95\u0bbe\u0ba3 \u0b9a\u0b95\u0baa\u0ba4\u0bcd \u0baf\u0ba4\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd \u0baa\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bc8\u0bbf\u0ba9\u0bcd\n\n\u0b8e\u0bb2\u0bcd\u0b95\u0bc8 \u0ba8\u0bbf\u0bb0\u0bcd\u0ba3 \u0bae\u0bcd 50:50 \u0ba4\u0ba9\u0bbf\u0ba4\u0bcd\u0baa\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf \u0bb5\u0bbf\u0b95\u0bbf\u0ba4\u0bbe\u0b9a\u0bbe\u0bb0 \u0bae\u0bc1\u0b95\u0bb1 \u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0bbe\u0bb0\u0bae\u0bcd \u0ba4 \u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baf\u0ba4\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd \u0baa\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bc8\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bb5\u0bb4\u0bbf \u0bbe\u0b95 \u0baa\u0ba8\u0bbe\u0baa \u0bb2\u0bcd \u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0baa\u0bb5\u0bb2\u0bcd\u0bc8 \u0b86\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bbf\u0ba9\u0bcd \u0baf\u0ba4\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd \u0baa\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0b95\u0bc8 (160) \u0baa \u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0baa\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0ba9 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0b95 \u0ba4 \u0bbe\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd.\n\n569 570\n\n[\u0d9c\u0dbb\u0dd4 \u0d82\u0d86\u0da0\u0dcf\u0dbb\u0dca \u0dc4 \u0daf\u0db1\u0dd2 \u0d85\u0db8\u0dbb\u0dc3\u0dd6 \u0daf ]\n\n\u0baa\u0baa \u0bb0\u0bcd \u0bb5\u0b95\u0bbf\u0ba4\u0bcd\u0ba4 \u0baa\u0ba4\u0bb5\u0bbf \u0b95\u0bbe\u0bc8\u0bae\u0bcd\n\n1. \u0b95\u0bc8\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf \u0ba4\u0bbf\u0bb0\u0bc1. \u0baf\u0b95. \u0ba4\u0bb5\u0bb2\u0bbf\u0b99\u0bcd\u0b95\u0bae\u0bcd\n\n\u0ba4\u0b95\u0bc8\u0bb5\u0bb0\u0bcd / \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\n\n2015 \u0ba8\u0bb5\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bae\u0bc1\u0ba4\u0bb2\u0bcd 2020 \u0b9f\u0bbf\u0b9a\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bb5\u0b95\u0bb0\n\n2.\n\n\u0b95\u0bc8\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf \u0ba4\u0bbf\u0bb0\u0bc1\u0bc8\u0ba4\u0bbf \u0b8f.\u0b9f\u0bc0. \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0\u0ba8\u0bbe \u0b95\u0bcd\u0b95\n\n\u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\n\n2015 \u0ba8\u0bb5\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bae\u0bc1\u0ba4\u0bb2\u0bcd 2020 \u0b9f\u0bbf\u0b9a\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bb5\u0b95\u0bb0\n\n3.\n\n\u0baf\u0baa\u0bb0\u0bbe\u0b9a\u0bbf\u0bbe\u0bbf \u0bb0\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1. \u0b8e\u0bb8\u0bcd.\u0b8e\u0b9a\u0bcd. \u0bb9\u0bb8\u0bcd\u0baa\u0bc1\u0bb2\u0bcd\u0bc8\u0bbe\n\n\u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd"
