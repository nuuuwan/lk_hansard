\u0dca\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u200d\u0dbb\u0db8\u0d9c \u0daf\u0dba - social security systems - \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0dbb\u0da7\u0dc0\u0dca \u0dd2\u0dc3\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0db4\u0dd2 \u0d9c\u0dad\u0dca\u0db8\u0d9c\u0dad\u0dcf\u0dad\u0dca\u0db8 \u0dc3\u0db1\u0dca\u200d\u0dbb\u0dc3\u0dba \u0d9c\u0da2\u0dcf\u0ddd\u0dbb\u0dca\u0daf\u0dcf\u0db1\u0dba \u0db8\u0dd0\u0d9c\u0dca \u0dd2\u0db1\u0dba\u0dcf\u0dc0 \u0d9a\u0da7\u0dcf\u0dbb\u0dca \u0dbb\u0dcf\u0da2\u0dcf\u0dba\u0dba \u0d9c\u0dc3\u0dde\u0dd2\u0db1 \u0d85\u0dbb\u0dcf\u0db6\u0dd2\u0dba \u0dc0\u0dcf\u0d9c\u0dda \u0dbb\u0da7\u0dc0\u0dca \u0dc0\u0dbd \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0dad\u0db8\u0db1\u0dca \u0dc3\u0db8\u0dc4\u0dbb \u0dbb\u0da7\u0dc0\u0dca \u0dc0\u0dbd \u0dd2\u0dc3\u0d9c\u0dc1\u0dae\u0dc2\u0dba\u0d9a\u0dca \u0dd2\u0dc3\u0db0\u0dd2\u0dba\u0da7 \u0dd2\u0dc3\u0d9c\u0daf\u0dca\u0dc1 \u200d\u0dbb\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0da7\u0db8 \u0d85\u0daf\u0dcf\u0dc5 \u0dc3\u0db8\u0dcf\u0da2\u0dcf \u0dca\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u200d\u0dbb\u0db8\u0d9c \u0daf\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db1\u0db8\u0dd4\u0dad\u0dca\u0db8 \u0d92 \u0dbb\u0d9c\u0da7\u0dca \u0dad\u0dd2\u0d9c\u0db6\u0db1 domestic \u200d\u0dbb\u0db8\u0d9c \u0daf\u0dba\u0dad\u0dca\u0db8 \u0d91\u0d9a\u0dca\u0d9a \u0db6\u0daf\u0dca\u0db0 \u0d9c\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dcf\u0dba \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0d91\u0dad\u0dd0\u0db1\u0daf\u0dd3 \u0d9c\u0dad\u0dca\u0db8\u0d9c\u0dad\u0dcf\u0dad\u0dca\u0db8 \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0d9c\u0d9a\u0dcf\u0dbb\u0dd2\u0dba\u0dcf\u0d9c \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf National Pension Service \u0d9a\u0dd2\u0dba\u0dbd\u0dcf scheme \u0d91\u0d9a\u0d9a\u0dca. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 National Health Insurance \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dad\u0dc0 \u0d91\u0d9a\u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u0dad\u0dd0\u0db1\u0daf\u0dd3 National Pension Service \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf\u0da9\u0dd4\u0d9a\u0dcf\u0dba \u0dba\u0da7\u0d9c\u0dad\u0dca\u0db8 03 999\u0d9a\u0dca \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 National Health Insurance \u0d9a\u0dcf\u0da9\u0dd4\u0d9a\u0dcf\u0dba \u0dba\u0da7\u0d9c\u0dad\u0dca\u0db8 31 444\u0d9a\u0dca \u0dd2 \u0dba\u0dcf\u0db4\u0dd2\u0db1\u0d82\u0da0\u0dd2 \u0d9c\u0dc0\u0dbd\u0dcf \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca\u0db8 \u0d85\u0dbb\u0dcf\u0db6\u0dd2 \u0d91\u0da7 \u0dbb\u0dca \u0dbb\u0dcf\u0da2\u0dcf\u0dba\u0dba \u0d9a\u0dd4\u0d9c \u0da7\u0dca \u0d9c\u0dbd\u0db6\u0db1\u0db1\u0dca \u0db8\u0dcf\u0dbd\u0dd2\u0db1\u0dc0\u0db1\u0dca\u0db1 \u0dc0\u0dcf\u0d9c\u0dda \u0dbb\u0da7\u0dc0\u0dca \u0d9c\u0dad\u0dca\u0db8\u0d9c\u0dad\u0dcf\u0dad\u0dca\u0db8 \u0dd2\u0dc3\u0d9c\u0daf\u0dca\u0dc1 \u200d\u0dbb\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d9c\u0dc0\u0db1\u0db8 dedicated social security schemes \u0db1\u0dd0\u0dad\u0dd2 \u0dbb\u0da7\u0dc0\u0dca \u0dd2\u0dc3\u0db0\u0dd2\u0dba\u0da7 \u0dad\u0db8\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0dc4\u0db3\u0dd4\u0db1\u0dcf \u0d9c\u0db1\u0dca\u0d9c\u0db1\u0dca.\n\n(iii) \u0d94 \u0d9c\u0db8\u0dad\u0dd0\u0db1 \u200d\u0dbb\u0dc1\u0dae\u0db1 \u0d9c\u0dd0\u0da7 \u0daf \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0db6\u0dc0 \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf.\n\n(iv) \u0d9c\u0db8\u0dad\u0dd0\u0db1\u0daf\u0dd3 \u200d\u0dbb\u0db8\u0d9c \u0daf \u0d9c\u0daf\u0d9a\u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0d85\u0db1\u0dd4\u0d9c\u0db8\u0db1\u0dba"
