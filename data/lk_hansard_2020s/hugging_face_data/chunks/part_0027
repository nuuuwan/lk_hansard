    "chunk_text": "\u0dbb\u0dd4 \u0dc3 \u0dad\u0dd2\u0dad\u0dd4 \u0dd2\u0dba, \u0d8a\u0dc1\u0dc3 \u0dcf\u0dc0\u0dc1 \u0dcf \u0d94\u0db6\u0dad\u0dd4 \u0dca\u0da7 \u0dba\u0dcf\u0dad\u0db8\u0dca \u0d9a\u0dca\u0dbb\u0dab\u0dca\u0dc0\u0d9a\u0dca\u0d9a\u0dba \u0dbb\u0dd3\u0dba\u0dcf\u0dad\u0db1\u0dca\u0db1 \u0dc0\u0dd0\u0dbd\u0dd2\u0dc0\u0dca. \u0db1\u0db8\u0dd4\u0db8\u0d9a \u0d92 \u0d9a\u0dca\u0dbb\u0dab\u0dca\u0dc0 \u0dbb\u0dd3\u0dba\u0dcf\u0dad\u0db1\u0dca\u0db1 \u0d89\u0da9\u0dcf \u0dbd\u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc0\u0dd0, \u0dbb\u0dd4 \u0d9a\u0db1\u0dca\u0db1\u0dca\u0dba\u0dcf\u0dad\u0d9a\u0dad\u0dd4 \u0dca. \u0d92 \u0dd2\u0dba \u0dca \u0dcf\u0dd0\u0db1\u0dca \u0d91\u0dba\u0dcf\u0dad \u0dbb\u0dd3\u0dba\u0dcf\u0dad\u0db1\u0dca\u0db1\u0db8\u0dca. \u0d9a\u0dd4\u0da9\u0dcf \u0dca \u0dc0\u0dca \u0db0\u0dba \u0db4\u0dbb\u0dd2 \u0dca\u0dab\u0dc1\u0dc3 \u0dc1 \u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0dba\u0dcf\u0dad\u0db1\u0dd4\u0db8\u0d9a MSME category \u0d91\u0d9a\u0da7 \u0db8\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0dd2. \u0d94\u0db6\u0dad\u0dd4 \u0dca \u0dc4\u0dd2\u0dda\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dca, \u0d92 \u0dc1 \u0dca\u0dbd\u0dca\u0dc1\u0dbd \u0dab\u0dba\u0dcf\u0dad \u0db8\u0dbb\u0dc1 \u0db1 \u0dab\u0dba\u0dcf\u0dad \u0dc1 \u0dc0\u0dd3 \u0db4\u0dd0\u0dc0\u0dd0\u0dbb \u0dc0\u0dd0\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca \u0dbb\u0dd3\u0dba\u0dcf\u0dad\u0dbd\u0dca. \u0d94\u0db6\u0dad\u0dd4 \u0dca \u0db8\u0dc0\u0dc1\u0db6 \u0db0 \u0d9a\u0dbb \u0db1\u0dca\u0db1, \u0db4\u0dc3\u0dd4\u0dd2\u0dba\u0dcf\u0dad \u0db8\u0dc0\u0dd4\u0dbb\u0dd4\u0dbd\u0dd2 \u0dc0\u0dc1\u0db8\u0d9a \u0db8\u0dd4\u0dc5\u0dd4 \u0dbb\u0da7\u0da7 \u0dc1\u0dda\u0dcf\u0dc0\u0dca\u0da0\u0d9a\u0dba\u0dcf\u0dad\u0db1\u0dca 5\u0d9a\u0dca\u0d9a\u0dba \u0dc3\u0dad\u0dd2 \u0dc0\u0dd4\u0dab\u0dd4 \u0db6\u0dc0. \u0d92\u0dc0\u0dca \u0dda \u0dba\u0dd2 \u0db4\u0dca \u0dcf\u0d9a\u0dd4 \u0d89\u0dbb\u0dd4\u0daf\u0dd2\u0db1 \u0dad\u0dca\u200d\u0dbb \u0dcf\u0dda \u0dca\u200d\u0dbb\u0dc0\u0dca\u0dbb\u0dba\u0dcf\u0dad, \u0dc1\u0d9a\u0dca\u0dc1\u0dbb \u0db1\u0dca \u0dc0 \u0dda \u0dda\u0dba\u0dcf\u0dad, \u0dbb\u0dc1\u0dda \u0db6\u0dda\u0dc1\u0d9a\u0dca\u0dc1\u0dbd\u0dca\u0db8\u0d9a\u0db7\u0dca\u0dc0\u0dba\u0dcf\u0dad, \"\u0daf\u0dd2\u0dda\u0dc0\u0dca\" \u0d86\u0db4\u0dcf\u0dca\u0dc0, \u0dd0\u0dcf \u0dc1\u0db4\u0dbb\u0daf\u0dd2 \u0db8\u0dad\u0db8\u0db6\u0dd4\u0dcf\u0dba\u0dcf\u0dad \u0dc1\u0dc0\u0dc0\u0db8\u0d9a \u0db6\u0da7\u0dc4\u0dd2\u0dbb \u0d86\u0dd2\u0dc0\u0dba\u0dcf\u0dad\u0dca\u0db1\u0dd4 crisis \u0d91\u0d9a. \u0dd0\u0dcf \u0dc1\u0db4\u0dbb\u0daf\u0dd2 \u0db8\u0dad\u0db8\u0db6\u0dd4\u0dcf\u0dba\u0dcf\u0dad \u0dbb\u0dd3\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0dc1\u0dc0 \u0dad\u0db8\u0db8\u0dd4 \u0dcf \u0db8\u0dd4\u0dca\u200d\u0dbb \u0db1\u0dca\u0db0\u0dd2\u0dba\u0dcf\u0dad \u0dc1\u0d9a\u0dca\u0d9a\u0dba\u0db1\u0dca\u0dca\u200d\u0dbb \u0d9a\u0dbb\u0dc1 \u0db1 \u0d89\u0dbb\u0dca\u0dab\u0dba\u0dcf\u0dad, \u0d8a\u200d\u0dbb\u0dca\u0dba\u0dcf\u0dad\u0dbd\u0dba\u0dcf\u0dad \u0dc0 \u0dc3\u0dc1 \u0dbb\u0dd2\u0d9a\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0dba \u0db8\u0d9a \u0dca\u200d\u0db1\u0db4\u0dcf\u0dba\u0dcf\u0dad \u0d9a\u0dbb\u0dc1 \u0db1 \u0dba\u0dcf\u0dad\u0db1 \u0dba\u0dd4 \u0db0\u0dba\u0dcf\u0dad.\n\n\u0dbb\u0dd4 \u0dc3 \u0dad\u0dd2\u0dad\u0dd4 \u0dd2\u0dba, \u0dc1 \u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0dba\u0dcf\u0dad\u0db1\u0dca\u0da7 \u0dbd\u0db6\u0dca \u0dbd\u0dd2\u0db1\u0dca\u0db1\u0dca, pledge loan \u0dbb\u0dd3\u0dba\u0dcf\u0dad\u0dbd\u0dca \u0d91\u0d9a\u0d9a\u0dca\u0d9a\u0dba. \u0d92\u0d9a \u0dc0\u0db1 \u0dc1\u0db4\u0dca\u0dc3\u0dd2 \u0dab\u0dba\u0dcf\u0dad\u0d9a\u0dca\u0d9a\u0dba. \u0db1\u0db8\u0dd4\u0db8\u0d9a, \u0d92 \u0dab\u0dba\u0dcf\u0dad \u0db1\u0dca\u0db1 \u0d92 \u0dc1 \u0dca\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0da7 \u0db6\u0dd0\u0dc0\u0dd0. \u0dc1 \u0dca\u0d9a\u0dcf, \u0d92 \u0dc1 \u0dca\u0dbd\u0dca\u0dbd\u0db1\u0dca blacklist \u0d9a\u0dbb\u0dbd\u0dca - \u0db8 \u0dca\u0dbd\u0dd2 \u0dc1\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1 \u0dda \u0d9a\u0dbb\u0dbd\u0dca. \u0dc1\u0db8\u0dca \u0dc0\u0dd3 \u0dd2\u0dba\u0dc2\u0dcf\u0db4\u0dca\u0dcf\u0db1\u0dba\u0dcf\u0dad \u0db8\u0dd2\u0dbd \u0daf\u0dd3 \u0db1\u0dca\u0db1 \u0d92 \u0dc1 \u0dca\u0dbd\u0dca\u0dbd\u0db1\u0dca \u0db8\u0dda\u0dba\u0dc0\u0dc3\u0dba \u0dba\u0dd2. \u0d92 \u0db6\u0dc0 \u0d94\u0db6\u0dad\u0dd4 \u0dca\u0db8\u0d9a \u0dcf\u0db1\u0dca\u0db1\u0dc0\u0dca. \u0d8a\u0dc1\u0dc3\u0db8\u0d9a \u0db8\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0dd0\u0db1 \u0d9a\u0db1\u0dca \u0d9a\u0dc5\u0dca. \u0d94\u0db6\u0dad\u0dd4 \u0dca \u0dbb\u0dd3\u0dda\u0dc0\u0dca \u0dc1\u0db1\u0dca, \u0dcf\u0dd0\u0db1\u0da7 \u0dc0\u0dd3 \u0db8\u0dd2\u0dbd \u0daf\u0dd3 \u0dc1 \u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dd2\u0dc0\u0dba\u0dcf\u0dad\u0dba\u0dcf\u0dad\u0da7 3\u0dba\u0dd2 \u0dbb\u0dd3\u0dba\u0dcf\u0dad\u0dbd\u0dca. \u0db8\u0db4\u0dd2 \u0dbb\u0dd3\u0dba\u0dcf\u0dad\u0db8\u0dd4, \u0db8\u0dd2\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dca\u200d\u0dbb\u0dc1 \u0dc3\u0dc0\u0dbd \u0dc1 \u0dca\u0dba\u0dcf\u0dad\u0db8\u0dca \u0d9a\u0dd0\u0db4\u0dd3 \u0dc1 \u0db1 \u0d91\u0db1\u0dc0\u0dca \u0dbb\u0dd3\u0dba\u0dcf\u0dad\u0dbd\u0dca. \u0d8b\u0db4\u0dbb\u0dd2 \u0dd2\u0dc0\u0dba\u0dcf\u0dad\u0dba\u0dcf\u0dad\u0da7 5\u0dba\u0dd2, 6\u0dba\u0dd2, 7\u0dba\u0dd2, 8\u0dba\u0dd2 \u0db8\u0dd2\u0dbd \u0daf\u0dd3 \u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1\u0d9a\u0dca\u0dc1\u0dc0\u0dca \u0dc0\u0dd4\u0dab\u0db8\u0d9a \u0dd2\u0dc0\u0dba\u0dcf\u0dad\u0dba\u0dcf\u0dad\u0da7 10\u0da7 \u0db8\u0dd4\u0dba\u0dd2. \u0d89\u0dad\u0dd2\u0dbb\u0dd2 \u0da7\u0dd2\u0d9a \u0db1\u0dca\u0db1 \u0db1\u0db8\u0dca \u0d9a\u0dd4\u0da9\u0dcf \u0dca \u0dc0\u0dca \u0db0\u0dba \u0db4\u0dbb\u0dd2 \u0dca\u0dab \u0dc1 \u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0dba\u0dcf\u0dad\u0db1\u0dca\u0dc1 \u0db8\u0dd6\u0dbd\u0dba \u0dc3\u0d9a\u0dca\u0d9a\u0dba\u0dad\u0dd2\u0dba\u0dcf\u0dad \u0dca\u200d\u0dbb\u0dc0\u0dad\u0db8\u0db0\u0db1\u0dba\u0dcf\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dba\u0dcf\u0dad\u0db8\u0dca\u0dbb\u0dd3\u0dd2\u0dc0 \u0dc0\u0dd0\u0da9\u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5\u0d9a\u0dca\u0d9a\u0dba \u0db8\u0dc0\u0dc3\u0dba\u0dba\u0dd2. \u0daf\u0dd4\u0dc1\u0dc3\u0dcf\u0dc2\u0dc1\u0dba\u0dcf\u0dad\u0db1\u0dca \u0d94\u0db1\u0dca\u0db1 \u0d94\u0dba\u0dcf\u0dad \u0d9a\u0dca\u0dbb\u0dab\u0dca\u0dc0\u0db8\u0d9a \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dc0\u0dca.\n\n\u0dbb\u0dd4 \u0db1\u0dca \u0dbd\u0dca \u0d9a\u0dbb\u0dd4\u0dab\u0dca\u0dbb\u0db8\u0d9a\u0db1 \u0dd0\u0dad\u0dd2\u0dad\u0dd4 \u0dd2\u0dba, \u0dda\u0dbb\u0dc0 \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dca, \u0dc1\u0db8\u0dca \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0d9a\u0dca\u0dbb\u0dab\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0db8\u0d9a \u0d9a\u0dc5\u0dca\u0da7. \u0db8\u0dc0 \u0dca\u0db1\u0dc1\u0dc3 \u0d91\u0d9a \u0d89\u0dbd\u0dca\u0dc3\u0dd2 \u0d9a\u0dca\u0d9a\u0dba \u0d9a\u0dbb\u0db1\u0dc0\u0dca. [\u0db6\u0dca\u0db0\u0dca \u0dbb\u0dd3\u0db8 \u0d9a\u0dca\u0d9a\u0dba]"
  },
