    "chunk_text": "\u0d8a\u0db4 \u0d85\u0db8\u0db1\u0dbb\u0dc0, \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0db3\u0dc4\u0dca \u0d9a\u0dc5 \u0db1\u0dbb\u0dd2\u0dbb\u0dd2 \u0d9c\u0db1\u0dde\u0daf\u0dca\u0d9c\u0dad\u0dd2\u0d9a \u0dba\u0d9c\u0db1 \u0da2\u0d9a\u0db1\u0dca, \u0db1\u0dbb\u0dd2\u0db1\u0dba\u0dcf\u0d9c\u0dad\u0dba \u0dd3\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d85\u0d9c\u0dba\u0d9a\u0dd4\u0dad\u0dca \u0db1\u0dcf\u0dbb\u0dca\u0dc1\u0dda\u0dc0\u0db1\u0dca\u0d9c\u0dda \u0d9c\u0daf\u0dca\u0dba \u0db1 \u0dc4\u0dcf \u0dc0\u0dd2\u0d9c\u0daf\u0dca\u0dba \u0db1 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0dba \u0dbd\u0db6\u0dcf \u0d9c\u0dad \u0db1\u0dd3\u0db8 \u0d9a\u0dca\u0db6\u0dca\u0db0\u0dca\u200d\u0d9c\u0db1\u0dca \u0db8\u0db8 \u0d9a\u0dd2\u0dca \u0d9a\u0db3\u0dc4\u0dca \u0d9a\u0dbb\u0db4\u0dd4 \u0db1\u0dba\u0d9c\u0dad\u0dca 37 \u0dc0\u0d9c\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0db1 \u0db1\u0db4\u0d9c\u0dad\u0dca \u0dc0\u0dd2\u0d9a\u0dbb\u0dc0\u0dd2\u0db0\u0dca\u200d\u0dcf\u0dba \u0d9a\u0dbd\u0d9a\u0dcf \u0dad\u0dd2\u0d9a\u0d9c\u0db6\u0dba\u0dc0\u0dcf. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0d9c\u0dc0\u0dba\u0db8 \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd \u0db4\u0dd2\u0dc4\u0dd2\u0dd4\u0db8\u0dc0\u0dca\u0d9c\u0dca \u0dba \u0dad\u0dd4\u0dc0 \u0d92 \u0dc0\u0dcf\u0d9c\u0dda \u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0dba \u0d9a\u0dca\u0db6\u0dca\u0db0\u0dca\u200d\u0d9c\u0db1\u0dca \u0d9c\u0db1\u0dcf\u0daf\u0dd4 \u0db1 \u0dca\u0db1\u0dad\u0dca \u0d9c\u0dd2\u0dab\u0dd4\u0db8 \u0db7\u0dcf\u0dc0\u0dd2\u0db1 \u0d9a\u0dbb\u0dbd\u0dcf \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0dca\u0dba \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca. \u0d9c\u0db1\u0dcf\u0daf\u0dd4 \u0db1 \u0dca\u0db1\u0dad\u0dca \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0db4 \u0d92\u0dc0\u0dcf \u0d85\u0dbb\u0d9c\u0d9c\u0dad\u0dba, \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0db6\u0dbd\u0dcf\u0d9c\u0db1\u0dcf\u0d9c\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4 \u0d9c\u0dc0\u0dba \u0d9a\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0dba \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0d89\u0dd4\u0db8 \u0d9a\u0dbb \u0d9c\u0dad \u0db1\u0dd3\u0d9c\u0dca \u0dc4 \u0d9a\u0dd2\u0db1\u0dcf\u0dc0 \u0dad\u0dd2\u0d9a\u0d9c\u0db6\u0dba\u0dc0\u0dcf. \u0d92 \u0d9a\u0dca\u0db6\u0dca\u0db0\u0dca\u200d\u0d9c\u0db1\u0dca \u0dd2\u0dba\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0d9a\u0d9c\u0db6\u0dba \u0da0\u0d9a\u0dca\u200d\u0dbb\u0d9c\u0dbd\u0dca\u0d9b\u0dca\u200d\u0dc0\u0dbd\u0db4, \u0dc0\u0dd2\u0d9a\u0dbb\u0dc0\u0dd2\u0db0\u0dca\u200d\u0dcf\u0dba\u0dc0\u0dbd\u0db4 \u0db1\u0db4\u0dad\u0dca\u0dc0 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0db1\u0dba \u0d9c\u0dc0\u0dba\u0dad\u0dca \u0d9c\u0db1\u0dde\u0daf\u0dca\u0d9c\u0dad\u0dd2\u0d9a \u0dba\u0d9c\u0db1 \u0da2\u0dba, \u0d92 \u0d9c\u0db1\u0dcf\u0daf\u0dd4 \u0db1 \u0dca\u0db1\u0dad\u0dca \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0d9a\u0db4 \u0daf\u0dcf\u0dbd\u0dcf \u0d92 \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0d9c\u0dad \u0db1\u0dd3\u0d9c\u0dca \u0dc4 \u0d9a\u0dd2\u0db1\u0dcf\u0dc0 \u0dad\u0dd2\u0d9a\u0d9c\u0db6\u0dba\u0dc0\u0dcf. \u0d92\u0d9a\u0db4 \u0db6\u0dcf\u0db0\u0dca\u200d\u0dcf\u0dc0 \u0dba \u0dc4 . \u0dc0\u0dd2\u0d9c\u0dc1\u0dda\u0dc2\u0dca\u0da8\u0d9c\u0db1\u0dca\u0db8 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0d89\u0dbb\u0dd2\u0dbb\u0dd2\u0db1\u0dad\u0dca \u0d9a\u0dbb\u0dba \u0d9a\u0dcf\u0dbb\u0da7\u0db1 \u0dad\u0dd4\u0dc5 \u0dad\u0dd2\u0d9a\u0d9c\u0db6\u0dba, \u0d92\u0d9a \u0db4\u0dd2\u0dd4\u0db8\u0db1\u0d9a \u0dad\u0dd2\u0d9a\u0d9c\u0db6\u0dba \u0d85\u0dbb\u0db8\u0dd4\u0da7, \u0d85\u0db7\u0dd2\u0dbd\u0dcf\u0dc2\u0dca\u0da8\u0db1 \u0d89\u0db1\u0dcf \u0dc0 \u0daf\u0d9c\u0dad\u0dad\u0dca. \u0d92\u0d9a \u0d85\u0db4\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dca\u0dba\u0dc0\u0dcf. \u0d9c\u0d9a\u0dcf\u0d9c\u0dc4\u0dcf\u0db8 \u0dc0\u0dd4\u0da7\u0dad\u0dca, \u0d85\u0db4\u0dd2 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0dca \u0d89\u0dbb\u0dd2\u0dbb\u0dd2\u0db1\u0dad\u0dca \u0d9a\u0dbb\u0dba \u0d89\u0dbd\u0dca\u0dd3\u0db8 \u0d89\u0dc0\u0db1 \u0daf\u0db8\u0dca\u0d9c\u0dca \u0dba \u0dc4 . \u0d92 \u0d9c\u0dad \u0dba \u0dc0 \u0da9\u0dd2\u0daf\u0dd4\u0dbb \u0d85\u0dc0\u0db0\u0dca\u200d\u0dcf\u0dba\u0db1 \u0d9c\u0db1\u0dcf\u0db8\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9a\u0db3\u0dc4\u0dcf \u0db8\u0db8 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf\u0d9c\u0dda \u0d89\u0dbd\u0dca\u0dd3\u0db8 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0db8\u0dad\u0dd2\u0d9a\u0dad\u0dd4\u0db8\u0dcf \u0d9c\u0dc0\u0db1\u0dad\u0dca \u0d9c\u0db1\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0dca\u0dba\u0dca. \u0d9a\u0dbd\u0d9a\u0dcf \u0db6\u0dbd\u0dcf \u0d92 \u0d89\u0dbd\u0dca\u0dd3\u0db8 \u0db1\u0dae\u0dcf\u0dbb\u0dca\u0dae\u0db1 \u0db6\u0dc0\u0db4 \u0db1\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0dad\u0dca\u0dba \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0dba\u0dca \u0d89\u0dbb\u0dd2\u0dbb\u0dd2\u0d9c\u0dda\u0daf\u0dd3 \u0d92\u0d9a \u0d89\u0dd4\u0db8 \u0d9a\u0dbb \u0d9c\u0dad\u0dca\u0dba \u0db6\u0dbd\u0db8\u0dd4. \u0dba\u0db8\u0dd4\u0dad\u0dca, \u0daf \u0dba\u0db4 \u0d9c\u0dca \u0d9c\u0dad \u0dba \u0dbb\u0da2\u0d9c\u0dda \u0daf \u0db8 \u0dc0\u0dd2\u0d9a\u0dbb\u0db1\u0db4 \u0dad\u0dd2\u0d9a\u0d9c\u0db6\u0dca\u0d9c\u0dca, \u0d9a\u0db8\u0d9a\u0dda\u0db1 \u0dbb\u0db4 \u0dc0\u0dd2\u0d9a\u0dbb\u0db1\u0db4 \u0d92 \u0d92 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0d85\u0dc0\u0d9c\u0db6 \u0db0\u0dca\u200d \u0d9a\u0dbb\u0d9c\u0d9c\u0dad\u0dba, \u0dbb\u0d9c\u0da7\u0dca \u0da2\u0dba\u0db1\u0dcf\u0dc0\u0db4 \u0d9a\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0dba\u0d9c\u0dda \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dbd\u0dcf\u0db7 \u0d9c\u0dad\u0dbd\u0dcf \u0d9c\u0d9c\u0dad\u0dba \u0db1\u0dd1\u0db8\u0db4 \u0d85\u0dc0\u0dc1\u0dba \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dba\u0dd2.\n\n2247 2248\n\n[\u0d9c\u0dad\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1\u0dcf\u0dca\u0db1 \u0da2\u0db1\u0dd3\u0dbb \u0db8\u0dc4\u0db1\u0dcf\n\n2026 \u0d85\u0d9c\u0d9c\u0dad \u0d9a\u0dda\u0dad\u0dd4 07\n\n[\u0d85.\u0db7\u0dcf. 5.26\n\n\u0dd4\u0dab \u0dc2\u0dcf\u0dab\u0d9a\u0dca\u0d9a\u0dd2\u0dba\u0db1\u0dca \u0dbb\u0dcf\u0da2\u0dd4\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0dbb\u0db1\u0dca \u0dbb\u0dcf\u0dc3\u0dca\u0dd9\u0dcf\u0dab\u0dd2\u0d9a\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0dc4\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b9a\u0bc6\u0bbe\u0ba3\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0ba9\u0bcd \u0bb0\u0bc6\u0bbe\u0bc7\u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0ba9\u0bcd \u0b87\u0bb0\u0bc6\u0bbe\u0b9a\u0bc8\u0bc6\u0bbe\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bae\u0bcd) (The Hon. Shanakiyan Rajaputhiran Rasamanickam) \u0d85\u0daf \u0dbb\u0dd2\u0dba \u0db8\u0db8 \u0d89\u0dbb\u0dd2\u0dbb\u0dd2\u0db1\u0dad\u0dca \u0d9a\u0dbb\u0db4\u0dd4 \u0d9c\u0db1 \u0da2\u0dba\u0dcf\u0dc0 \u0d9a\u0dda\u0dd3\u0dbb \u0d9a\u0dbb\u0db4\u0dd4 \u0d9c\u0dad\u0dbb\u0dd4 (\u0daf\u0dc0\u0daf\u0dba) \u0db1\u0dad\u0dca\u0db8\u0dba\u0dcf\u0daf\u0dca \u0d9a\u0db1\u0dba\u0dd2\u0d82\u0d9c\u0dad\u0dca \u0db8\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dcf\u0db4\u0dad\u0dca, \u0d92 \u0dc0\u0dcf\u0d9c\u0dda \u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb \u0dbd\u0db6\u0dcf \u0daf\u0dd4\u0dca\u0db1\u0dd4 \u0d9c\u0dad\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1\u0dcf\u0dca\u0db1 \u0da2\u0db1\u0dd3\u0dbb \u0dd2\u0dba\u0d9c\u0db1 \u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0d9a\u0dad\u0dd4\u0db8\u0dcf\u0db4\u0dad\u0dca \u0d9a\u0dda\u0dad\u0dd4\u0dad\u0dd2\u0d9a\u0dc0\u0dca\u0db1 \u0d9c\u0dc0\u0dba\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda \u0db8 \u0db8\u0d9c\u0dda \u0dc4\u0dd2\u0db1\u0dc0\u0dad\u0dca, \u0d9c\u0dad\u0dbb\u0dd4 \u0dbb\u0da2\u0dd3\u0dc0\u0dca \u0d9c\u0da2\u0db1\u0da0\u0dca\u0daf\u0dca\u200d\u0dbb\u0db8\u0dd6\u0dbb\u0dca\u0dad\u0dd2\u0d9a \u0db8\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dcf, \u0d9c\u0dad\u0dbb\u0dd4 (\u0daf\u0dc0\u0daf\u0dba) \u0dbb\u0dcf\u0db8\u0dba\u0dcf\u0daf\u0dca \u0d85\u0dbb\u0dca\u0da0\u0dca\u0dd4\u0dba\u0dcf \u0db8\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dcf, \u0d9c\u0dad\u0dbb\u0dd4 \u0dbb\u0dd2\u0d9c\u0dca\u0dc2\u0dca\u0da8\u0dda \u0d9c\u0dc4\u0dda\u0db8\u0dca\u0db1 \u0db8\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dcf, \u0d9c\u0dad\u0dbb\u0dd4 \u0d85\u0db8\u0dd2\u0dbb\u0dca\u0db1\u0dba\u0dcf\u0daf\u0dca \u0d85\u0daf\u0da9 \u0d9a\u0dbd\u0dba\u0dcf\u0daf\u0dca \u0db8\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dcf \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0dc3\u0dd2\u0db1 \u0d9c\u0daf\u0dba\u0dcf\u0db4\u0dad\u0dca \u0d9a\u0dda\u0dad\u0dd4\u0dad\u0dd2\u0d9a\u0dc0\u0dca\u0db1 \u0d9c\u0dc0\u0dba\u0dc0\u0dcf, \u0d9c\u0db8\u0db8 \u0d9c\u0db1 \u0da2\u0dba\u0dcf\u0dc0 \u0d9c\u0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0dca \u0d85\u0daf\u0dc4\u0d9a\u0dda \u0daf \u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0."
