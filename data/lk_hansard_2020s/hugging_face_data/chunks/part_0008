    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0d85\u0db1\u0dd4\u0d9a\u0dcf\u0db0 \u0da2\u0dba\u0d9a \u0dc3\u0db1 \u0db8\u0dc4\u0dad\u0dcf, \u0d9c\u0dbb\u0dd4 (\u0d82\u0da0\u0dcf\u0dbb\u0dca\u0dae\u0dba) \u0dc3\u0dd4\u0dc1\u0dbb\u0dca\u0dae\u0db1\u0dca \u0d9a\u0dcf\u0d9d\u0dc0\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dcf, \u0d9c\u0dbb\u0dd4 (\u0db8\u0dc4\u0dcf\u0da0\u0dcf\u0dbb\u0dca\u0dae\u0dba) \u0da2\u0dd3 \u0d91\u0dbd\u0dca \u0db4\u0dd3\u0dd2\u0d9a\u0dc3\u0dca \u0db8\u0dc4\u0dad\u0dcf, \u0d9c\u0dbb\u0dd4 \u0d9a\u0dc0\u0dd4\u0dc6\u0dca \u0dc4\u0d9a\u0dd3\u0db8\u0dca \u0db8\u0dc4\u0dad\u0dcf, \u0d9c\u0dbb\u0dd4 \u0dad\u0dbd\u0dad\u0dcf \u0d85\u0dad\u0dd4\u0dc1\u0d9a\u0ddd\u0d9a\u0dbd \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba, \u0d9c\u0dbb\u0dd4 \u0da0\u0db1\u0dca\u0daf\u0dd2\u0db8 \u0dc0\u0dd3\u0d9a\u0dca\u0dc1\u0d9a\u0dcf\u0da9\u0dd2 \u0db8\u0dc4\u0dad\u0dcf, \u0d9c\u0dbb\u0dd4 \u0da2\u0dd3 \u0da2\u0dd3 \u0dc1\u0db4\u0dcf\u0db1\u0dca\u0db1\u0db8\u0dca\u0db3\u0dbd\u0db8\u0dca \u0db8\u0dc4\u0dad\u0dcf, \u0d9c\u0dbb\u0dd4 \u0d91\u0db8\u0dca \u0d92 \u0dc3\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dd2\u0d9a\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dcf, \u0d9c\u0dbb\u0dd4 \u0dc1\u0dda\u0db8\u0dca\u0db1\u0dcf \u0dc3 . \u0dc1\u0dba\u0dcf\u0dbd\u0dc0 \u0dc3\u0dad \u0db8\u0dc4\u0dad\u0dcf, \u0d9c\u0dbb\u0dd4 \u0db8\u0db0\u0dd4\u0d9a \u0dc0\u0dd2\u0dad\u0dcf\u0db1\u0dc1\u0dda \u0db8\u0dc4\u0dad\u0dcf, \u0d9c\u0dbb\u0dd4 \u0dc3\u0dcf\u0d9c\u0d9a \u0d9a\u0dcf\u0dd2\u0d9a\u0dba\u0dc0\u0dc3\u0db8\u0dca \u0db8\u0dc4\u0dad\u0dcf\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc0\n\n\u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dd2\u0db4 \u0dd9\u0dab\u0dca\u0da9\u0dbd\u0dba\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dd4\u0d9c\u0dda \u0dd9\u0dc4 \u0d9c\u0dbd\u0dca\u0d9a\u0db8\u0dca - \u0dc1\u0dca \u0d92 \u0dc1\u0d9a\u0ddd\u0dc4 \u0daf\u0dd3\u0d9a \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba \u0d9a\u0dcf\u0dbb\u0dca\u0dba \u0dd9\u0dab\u0dca\u0da9\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1\u0dd3 \u0dc3\u0dca\u0dc4 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dd4\u0d9c\u0dda \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u200d \u0dd9\u0dc4 \u0d9c\u0dbd\u0dca\u0d9a\u0db8\u0dca - \u0da2\u0dd3 \u0dc1\u0dca \u0d92 \u0da0\u0db8\u0dd2\u0db1\u0dca\u0dba \u0d9a\u0dd4\u0db8\u0dcf\u0d9a \u0d9a\u0dd4\u0dbd\u0d9a \u0dc3\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0dc3\u0dca\u0dc4\u0d9a\u0dcf\u0dbb \u0dd9\u0dc4 \u0d9c\u0dbd\u0dca\u0d9a\u0db8\u0dca - \u0d92 \u0d91\u0da0\u0dca\u0da0 \u0d91\u0db8\u0dca \u0d91\u0da0\u0dca\u0da0 \u0d91\u0da0\u0dca\u0da0 \u0d91\u0dc3\u0dca \u0d85\u0dc1\u0db6\u0dca\u0d9a \u0dc3\u0db1 \u0db8\u0dc4\u0dad\u0dcf\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dd4\u0d9c\u0dda \u0dd9\u0dc4 \u0d9c\u0dbd\u0dca\u0d9a\u0db8\u0dca\u0d9c\u0db4 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba\n\n\u0db4\u0dcf.\u0dd9.\u0d9c\u0dbd\u0dca.\u0d9c\u0db4 \u0dc3\u0dca\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd3\u0d9a\u0dbb\u0dab \u0d9c\u0dbd\u0dca\u0d9a\u0db8\u0dca - \u0d91\u0dc3\u0dca \u0db4\u0dd3 \u0d9c\u0db8\u0dc1\u0dda \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd9 \u0dc0\u200d\u0dc0\u0dc3\u0dca\u0dad\u0dae\u0db8\u0dd2\u0dcf \u0dc3\u0dca\u0db7\u0dcf\u0dc0 - \u0da7\u0dd3 \u0d91\u0db8\u0dca \u0d91\u0db1\u0dca \u0db4\u0dd3 \u0dc1\u0dad\u0db1\u0dca\u0db1\u0dc1\u0d9a\u0ddd\u0db1\u0dca \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba, \u0d91\u0dc3\u0dca \u0d82\u0dbb\u0dca\u0dae \u0ddb\u0db6\u0dca \u0dc3\u0daf \u0dc0\u0db1 \u0dc1\u0dc3\u0dca\u0d9a\u0d9a \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba (\u0dc3\u0dc4\u0d9a\u0dcf\u0d9a \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\n\n\u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd3\u0dc4\u0dd4)\n\n\u0d85\u0db7\u200d\u0db1\u0dca\u0dad\u0dbb \u0dc0\u0dd2 \u0dab\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0d82\u0dc1\u0dca\u0dba\n\n\u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0d85\u0db7\u200d\u0db1\u0dca\u0dad\u0dbb \u0dc0\u0dd2 \u0dab\u0d9a - \u0ddb\u0db6\u0dca \u0dc3\u0daf \u0dc1\u0dca \u0da9\u0dd3 . \u0dc0\u0dd2\u0dad\u0dcf\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dd2\u0db4 - \u0da9\u0dd3 \u0d82\u0dbb\u0dca\u0dae \u0d91\u0dc3\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db1\u0dca\u0dbd\u0dd2 \u0db8\u0dc4\u0dad\u0dcf \u0dc3\u0dca\u0dc4\u0d9a\u0dcf\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dd2\u0db4 - \u0ddb\u0db6\u0dca \u0dc3\u0daf \u0ddb\u0db6\u0dca \u0dc3\u0daf \u0d91\u0dc3\u0dca \u0d82\u0dbb\u0dca\u0dae \u0d91\u0db8\u0dca \u0d91\u0da0\u0dca\u0da0 \u0dc3\u0db8\u0d9a\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba \u0dc3\u0dca\u0dc4\u0d9a\u0dcf\u0dbb \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dd4 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dd2\u0db4 - \u0ddb\u0db6\u0dca \u0dc3\u0daf \u0d82\u0dbb\u0dca\u0dae \u0da2\u0dd3 \u0d91\u0dc3\u0dca \u0dcf\u0db8\u0dd3\u0d9a \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba\n\n\u0d9c\u0dda\u0dad\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0dd2\u0db4 \u0d9c\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc0\n\n\u0d9c\u0dda\u0dad\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0dd2\u0db4 - \u0d9a\u0dd4\u0dc2\u0dab\u0dcf\u0db1\u0dca \u0dc3\u0db8\u0dca\u0db4 \u0dc3 \u0da2\u0dba\u0d9a \u0dc3\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u200d \u0d9c\u0dda\u0dad\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0dd2\u0db4 - \u0d91\u0db1\u0dca \u0d92 \u0d91\u0dc3\u0dca \u0d9a\u0dd4\u0dc1\u0dbb\u0dca\u0dae \u0db8\u0dc4\u0dad\u0dcf \u0dc3\u0dca\u0dc4\u0d9a\u0dcf\u0dbb \u0d9c\u0dda\u0dad\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0dd2\u0db4 - \u0dc1\u0dca \u0d91\u0dc3\u0dca \u0d91\u0dbd\u0dca \u0d9a\u0da9\u0dd2\u0d9c\u0db8\u0dd4\u0dc0 \u0db8\u0dc4\u0dad\u0dcf \u0db4\u0dd3 \u0da9\u0dd3 \u0d91\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db1\u0dca\u0dbd\u0dd2 \u0db8\u0dc4\u0dad\u0dcf (\u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dd2\u0d9a) \u0dba\u0dd6 \u0da9\u0dd3 \u0d91\u0db8\u0dca \u0d91\u0db8\u0dca \u0dc0\u0dd2\u0dc1\u0da2\u0dca\u0dd2\u0dc4\u0dc1\u0dc4 \u0db8\u0dc4\u0dad\u0dcf (\u0dc3\u0dc4\u0d9a\u0dcf\u0d9a \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dd2\u0d9a);\n\n\u0d92 \u0da2\u0dd3 \u0d82\u0dbb\u0dca\u0dae \u0dc1\u0dca \u0d85\u0dc1\u0db6\u0dca\u0d9a \u0dc3\u0db1 \u0db8\u0dc4\u0dad\u0dcf (\u0db4\u0dcf\u0dbb\u0dca\u0dae \u0dc3\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd3) \u0d91\u0db1\u0dca \u0d92 \u0db0\u0dbb\u0dca\u0dae\u0db8\u0dba\u0dcf\u0dc3 \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba (\u0dbd\u0dd2\u0d9a\u0d9a\u0dae\u0db1 \u0d85\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0d9a), \u0dc1\u0dca \u0da7\u0dd3 \u0da9\u0dd3 \u0dc3\u0dd6\u0dd2\u0d9a\u0dba\u0db3\u0dab\u0dca\u0ddb\u0dcf\u0d9a \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba (\u0dc3\u0dc4\u0d9a\u0dcf\u0d9a \u0db4\u0dcf\u0dbb\u0dca\u0dae \u0dc3\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd3)\n\n\u0db4\u0dd2\u0db4\u0db4\u0dcf\u0dbd\u0db1 \u0d9c\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc0\n\n\u0d85\u0db0\u0dcf\u200d\u0d9a\u0dca\u0dc2 (\u0db4\u0dd2\u0db4\u0db4\u0dcf\u0dbd\u0db1) - . \u0d85\u0dba\u0dd2 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba\n\n\u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u200d \u0d85\u0db0\u0dcf\u200d\u0d9a\u0dca\u200d\u0dc2 (\u0db4\u0dd2\u0db4\u0db4\u0dcf\u0dbd\u0db1) - \u0d8a \u0da9\u0dd3 \u0d91\u0dc3\u0dca \u0d91\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db1\u0dca\u0dbd\u0dd2 \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba\n\n\u0d86\u0dba\u0dad\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0d82\u0dc1\u0dca\u0dba - \u0ddb\u0db6\u0dca \u0dc3\u0daf \u0d92 \u0dc1\u0dca . \u0dda\u0ddb\u0dc1\u0db4\u0dcf\u0dbd \u0db8\u0dc4\u0dad\u0dcf (\u0dc3\u0dc4\u0d9a\u0dcf\u0d9a \u0d85\u0db0\u0dba\u0dca\u0dc2\u0dab - \u0db4\u0dd2\u0d9a\u0db4\u0dcf\u0dbd\u0db1) \u0db4\u0dd3 \u0da2\u0dd3 \u0db4\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dc1\u0d9a\u0d9a \u0db8\u0dc4\u0dad\u0dcf, \u0da2\u0dd3 \u0d91\u0db1\u0dca \u0da9\u0dd3\n\n\u0dad\u0dd2\u0dbd\u0d9a\u0d9a \u0dc3\u0db1 \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba (\u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd3\u0dc4\u0dd4); \u0dc0\u0dd3 \u0db4\u0dd3 \u0da2\u0dd3 \u0d91\u0dc3\u0dca \u0dc0\u0dd2\u0dba\u0dcf\u0db1\u0db4\u0dad\u0dd2\u0d9a \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba, \u0da9\u0dd3 \u0d91\u0db8\u0dca \u0da9\u0dd3 \u0d85\u0dbd\u0dc4\u0dc1\u0d9a\u0ddd\u0db1\u0dca \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba (\u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dd2\u0d9a\u0dc4\u0dd4) \u0dc1\u0dca \u0d85\u0dba\u0dd2 \u0d91\u0db8\u0dca \u0dc1\u0db4\u0dc1\u0dbb\u0dca\u0dae\u0d9a\u0dcf \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba, \u0ddb\u0db6\u0dca \u0dc3\u0daf \u0d91\u0dc3\u0dca \u0dc0\u0dba\u0dd2 \u0dc1\u0dc3\u0dcf\u0dba\u0dd2\u0dc3\u0dcf \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba, \u0d82\u0dbb\u0dca\u0dae \u0d82\u0dbb\u0dca\u0dae \u0da2\u0dd3 \u0da9\u0dd3 \u0dc1\u0dca \u0da2\u0dba\u0dad\u0dd2\u0dbd\u0d9a \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba (\u0dc3\u0dc4\u0d9a\u0dcf\u0d9a \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dd2\u0d9a\u0dc4\u0dd4) \u0d91\u0da0\u0dca\u0da0 \u0d92 \u0d82\u0dbb\u0dca\u0dae \u0d82\u0dbb\u0dca\u0dae \u0dc0\u0db1 \u0dc1\u0dc3\u0dca\u0d9a\u0d9a \u0db8\u0dc4 \u0dc3\u0db8\u0dd2\u0dba (\u0dc3\u0dc4\u0d9a\u0dcf\u0d9a \u0db4\u0dcf\u0dbb\u0dca\u0dae \u0dc3\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dd2\u0d9a)"
  },
