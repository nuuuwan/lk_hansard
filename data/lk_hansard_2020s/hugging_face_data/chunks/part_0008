    "chunk_text": "\u0dc1\u0db8\u0dca \u0daf\u0dc0\u0dc3\u0dca\u0dc0\u0dbd \u0dbb\u0ddc\u0da2\u0dba \u0dc1\u0dc3\u0dca\u0dc0\u0d9a\u0dba\u0db1\u0dca \u0d9c\u0dd0\u0db1 \u0dc3\u0dca\u0dd4 \u0db8\u0ddc\u0d9a\u0ddc\u0dbb \u0dd4 \u0d9a\u0d9a\u0dca, \u0dc1\u0dda\u0daf\u0db1\u0ddc\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0da2\u0db1\u0dad\u0ddc\u0dc0 \u0d9c\u0dd0\u0db1\u0dad\u0dca \u0dc3\u0dca\u0dd4 \u0db8 \u0dd4 \u0d9a\u0d9a\u0dca, \u0dc1\u0dda\u0daf\u0db1\u0ddc\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1\u0dad\u0dbd\u0dca\u0da7 \u0db8\u0dd2\u0dbd \u0d85\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0dad\u0dbb\u0db8\u0dca \u0d9a\u0dbd\u0dca\u0da7 \u0dad\u0dd2\u0dd4\u0dab\u0ddc. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d87\u0dc4\u0dd0\u0d9a\u0dca \u0d87\u0dbb\u0dbd\u0ddc \u0db6\u0dd0\u0dbd\u0dd4\u0dc1\u0dda \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0db8\u0dca \u0daf\u0dc0\u0dc3\u0dca\u0dc0\u0dbd \u0d85\u0db8\u0ddc\u0dbb\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dc1\u0dad\u0dbd\u0dca\u0da7 \u0db8\u0dd2\u0dbd \u0d85\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0ddc. \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0ddc, \u0d9a\u0db8\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0dbd\u0ddc. \u0dc1\u0db8\u0ddc\u0d9a\u0daf, \u0dc1\u0db8\u0dca \u0daf\u0dc0\u0dc3\u0dca 18, 20 \u0dad\u0dd4\u0dc5 \u0dc4\u0dd2\u0db4 \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0dca \u0d85\u0dd2\u0d82\u0dc3\u0d9a \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4\u0db1\u0dca\u0da7 \u0dba\u0db8\u0dca \u0dc3\u0dc4\u0db1\u0dba\u0d9a\u0dca \u0dbd\u0dd0\u0dc1\u0db6\u0db1\u0dc0\u0ddc \u0db1\u0db8\u0dca \u0d85\u0db4\u0dd2 \u0dc3\u0dad\u0dd4\u0da7\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc.\n\n897 898\n\n\u0db4\u0ddc\u0db0\u0db1\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0dc1\u0dc0\u0db1 \u0dc1\u0dda\u0dc0\u0dbd\u0dca\u0da7 \u0dc3\u0db3\u0dc4\u0ddc \u0dbd\u0dba\u0dd2\u0dc3\u0db1\u0dca \u0daf\u0dd3\u0dbd\u0ddc, \u0da2\u0db1\u0dad\u0ddc\u0dc0\u0dc1\u0dda \u0db8\u0dd4\u0daf\u0dbd\u0dca\u0da7 \u0dc4\u0dd6\u0dbb\u0ddc \u0d9a\u0ddc\u0dbd\u0ddc, \u0d92 \u0db8\u0dd4\u0daf\u0dbd\u0dca\u0da7 \u0da7\u0dd2\u0d9a pump \u0d9a\u0dbb\u0dbd\u0ddc \u0da1\u0db1\u0dca\u0daf\u0dba \u0daf\u0dd2\u0db1\u0db1\u0dca\u0db1 \u0dd2\u0dad\u0ddc\u0dc1\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0ddc \u0db1\u0db8\u0dca, \u0d92\u0d9a \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0dca \u0da2\u0db1\u0dad\u0ddc\u0dc0 \u0d8a\u0da7 \u0dc0\u0dd0\u0da9\u0dd2\u0dba \u0d91\u0dc4\u0ddc \u0d9c\u0dd2\u0dd2\u0dbd\u0dca\u0da7\u0dbd\u0ddc \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0ddc. \u0dc1\u0dda \u0db4\u0ddc\u0dbd\u0db1 \u0dc3\u0ddc\u0d9a\u0dca\u0dc2\u0dbb\u0dad\u0ddc\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0da2\u0db1\u0dad\u0ddc\u0dc0\u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7, \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d9a\u0ddc\u0dbd\u0dc1\u0dda \u0dc1\u0d9c\u0ddd\u0da8\u0ddc\u0db7\u0dba \u0db8\u0dc4\u0dad\u0dca\u0dad\u0dba\u0ddc\u0da7 \u0d85\u0daf\u0dd4 \u0dc0\u0dd4\u0dab\u0dd4 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0daf\u0dd4 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0da2\u0db1\u0dad\u0ddc\u0dc0\u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0daf \u0dc0\u0db1 \u0dc1\u0d9a\u0ddc\u0da7 \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dc1\u0dda \u0db4\u0ddc\u0dbd\u0db1\u0dd2\u0d9a \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0dc3\u0dd4\u0dda\u0db0\u0dd2\u0d9a\u0dba\u0dd2."
  },
