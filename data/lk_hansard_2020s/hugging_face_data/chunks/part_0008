    "chunk_text": "\u0dc1\u0db8\u0dc1\u0dc4\u0db8 \u0daf\u0dd3\u0db4\u0dd4 \u0dad\u0dd0\u0d9c\u0dda \u0d9c\u0dd0\u0db1 \u0d9a\u0d9c\u0dcf \u0d9a\u0dc1\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dbb\u0dd4\u0d9c\u0dd2 \u0d9a\u0dcf\u0dbd\u0dc1\u0dda Indian Oil Company - IOC - \u0d91\u0d9a\u0da7 \u0dc1\u0db4\u0da7\u0dca\u200d\u0dbb\u0dbd\u0dca \u0dc1\u0dc2\u0da9\u0dca 400\u0d9a\u0dca \u0dd4\u0dc0\u0d9c\u0dda\u0db1\u0dcf\u0daf \u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0d9c\u0dda\u0dd3\u0dad\u0dd4\u0db8\u0dc3\u0dd4 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0dc1\u0db4\u0da7\u0dca\u200d\u0dbb\u0dbd\u0dca \u0dc1\u0dc2\u0da9\u0dca \u0d9c\u0dd0\u0db1 \u0d9c\u0dda\u0db1\u0dc0\u0dcf \u0dc1\u0d9c\u0dda\u0daf \u0d92 \u0dc1\u0db4\u0da7\u0dca\u200d\u0dbb\u0dbd\u0dca \u0dc1\u0dc2\u0da9\u0dca 400 \u0dd0\u0d9c\u0dda 257\u0d9a\u0dca \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca\u0dc1\u0dc0\u0dbd\u0dcf\n\n\u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0d9c\u0dda\u0dd3\u0dad\u0dd4\u0db8\u0dc3\u0dd4 \u0dd0\u0d9c\u0dda \u0dc1\u0db8\u0dca \u0dc1 \u0dc0 \u0db4\u0dc0 \u0db4\u0db1 \u0d85\u0dbb\u0dca \u0dba\u0d9a\u0dca \u0d9c\u0dd0\u0db1 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf\u0daf \u0db6\u0d82\u0dc1\u0d9a\u0dcf\u0dc1\u0dbd\u0dcf\u0dad\u0dca \u0db6\u0dc0\u0d9a\u0dca \u0db4\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0daf \u0dc1\u0db8\u0dca \u0da7 \u0db6\u0d82\u0dc1\u0d9a\u0dcf\u0dc1\u0dbd\u0dcf\u0dad\u0dca \u0dc0\u0dd4\u0dab\u0dcf \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dd2 \u0db6\u0d82\u0dc1\u0d9a\u0dcf\u0dc1\u0dbd\u0dcf\u0dad\u0dca \u0d9a\u0dc5\u0dcf\u0daf \u0dc4\u0dbb\u0dd2 \u0dc1\u0dc0\u0dbd\u0dcf\u0dc0\u0da7 \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb \u0db4\u0db4\u0dad\u0dca \u0db4 \u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a \u0d9c\u0dda\u0dc1\u0d9c\u0dda \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0dad\u0dd3\u0d9c\u0dda\u0dd4\u0dc0 \u0d9c\u0d9c\u0dda\u0dc1\u0d9c\u0dda \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0dc3\u0dd4\u0dc0\u0dd0 \u0daf\u0dd2 \u0dd0\u0d9a\u0dca\u0db8\u0d9a\u0dca \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0d9c\u0dd2\u0dba \u0d9c\u0db8\u0d9c\u0dda \u0db8 \u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb \u0db4\u0dbd\u0dbd\u0dba\u0d9a\u0dca \u0dc1\u0db8\u0dca\u0d9a\u0daf \u0d92\u0d9a \u0dc3\u0dd4\u0dc3\u0dcf \u0dc1\u0db8\u0dca \u0db6\u0d82\u0dc1\u0d9a\u0dcf\u0dc1\u0dbd\u0dcf\u0dad\u0dca \u0d9a \u0db4\u0dd4 \u0da7 \u0dc1\u0d9c\u0dcf\u0da9\u0d9c\u0d9c\u0dda\u0db1 \u0dc0\u0dd2\u0d9a\u0dbd\u0dca\u0db4\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dda \u0d91\u0d9a\u0db8 \u0dc1\u0db6\u0dc1\u0dc4\u0dad \u0d91\u0d9a\u0db8 \u0db8\u0d9c\u0dda\u0dad \u0dba IMF \u0dc0\u0dd2\u0dad IMF \u0d91\u0d9a\u0dad\u0dca \u0d86\u0dc1\u0dda \u0dc1\u0db8\u0dca \u0d9a\u0dd4\u0db8\u0d9c\u0dda\u0dad\u0dca\u200d\u0dbb\u0dab\u0dc1\u0dda \u0dc1\u0d9a\u0dcf\u0da7\u0dc3\u0dcf\u0d9a\u0dcf \u0dc1\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7\u0dd2\u0daf IMF \u0d9a\u0dd4\u0db8\u0d9c\u0dda\u0dad\u0dca\u200d\u0dbb\u0dab\u0dc1\u0dda \u0dc1\u0d9a\u0dcf\u0da7\u0dc3\u0dcf\u0d9a\u0dcf \u0dba\u0d9c\u0dda \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dad\u0db8\u0dd2 \u0db8\u0dc4 \u0db6\u0dd0\u0d82\u0d9a\u0dd4 \u0d85\u0db0\u0dd2\u0db4 \u0db4\u0dc0 \u0dba\u0dcf \u0d91\u0d9c\u0dda\u0dc1\u0d9c\u0dda \u0db8\u0dd4 \u0dbd\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dc1\u0dda \u0dc1\u0dbd\u0dca\u0d9a\u0db8\u0dca\u0dc0 \u0dba\u0dcf \u0d91\u0d9c\u0dda\u0dc1\u0d9c\u0dda\u0daf \u0d9a\u0dd0\u0db6\u0dd2\u0db1 \u0dc0 \u0db8\u0dca\u0da9\u0dbd\u0dba\u0dc0\u0dad\u0dca \u0d9c\u0dda\u0dc1\u0d9c\u0dda \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0dc1\u0db8\u0dca \u0da7 \u0db6\u0d82\u0dc1\u0d9a\u0dcf\u0dc1\u0dbd\u0dcf\u0dad\u0dca \u0dcf\u0da2\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf \u0d9a \u0d9c\u0dda\u0dc1\u0d9c\u0dda \u0d92 \u0d9a\u0dd4\u0db8\u0d9c\u0dda\u0dad\u0dca\u200d\u0dbb\u0dab\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb \u0db4\u0dbd\u0dbd\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7\u0dd2\u0daf \u0dc1\u0db8\u0dca \u0da7 \u0db6\u0d82\u0dc1\u0d9a\u0dcf\u0dc1\u0dbd\u0dcf\u0dad\u0dca \u0dcf\u0da2\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf \u0d9a \u0d9c\u0dda\u0db1 \u0d89\u0dc3\u0dcf\u0dc1\u0dc3\u0dbd\u0dca\u0dbd\u0dcf \u0d92 \u0db6\u0dc0 \u0dc1\u0db8\u0dca \u0dc1 \u0dc0 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf \u0db4 \u0db8\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dba\u0dba \u0db4\u0dc1\u0db6\u0db1 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0d9c\u0dda\u0dad\u0dd4\u0dc0 \u0d9c\u0dda\u0db1\u0dc0\u0dcf \u0dc1\u0db8\u0dca \u0dc4\u0dd0\u0db8 \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dca\u0db8 \u0d91\u0dc4\u0dd2 \u0dc1\u0d9a\u0dcf\u0da7\u0dc3\u0dcf\u0d9a\u0dbb\u0dd4\u0dc0\u0d9c\u0dda \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca\u0dc1\u0dc0\u0dbd\u0dcf \u0dc1\u0db8\u0dca \u0da7\u0da7 \u0db6\u0d82\u0dc1\u0d9a\u0dcf\u0dc1\u0dbd\u0dcf\u0dad\u0dca \u0dc1\u0dbd\u0dca\u0db6\u0dbd\u0dba \u0d9c\u0dc4\u0dbd\u0dcf \u0dc1\u0db8\u0dca \u0d86\u0dba\u0dad\u0db1 \u0d9a\u0dd4\u0dab\u0dd4 \u0dc1\u0d9a\u0dcf\u0dbd\u0dca\u0dbd\u0dba\u0da7 \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0dbd\u0dcf \u0d85\u0dc1\u0dda \u0da7 \u0dc1\u0d9a\u0dcf\u0dbd\u0dc3\u0dd4\u0dba\u0d9a\u0dca \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0d9a \u0db1 \u0d9c\u0db8\u0db1 \u0dad\u0db8\u0dd2 \u0dc1\u0db8\u0dca \u0d89\u0dc3\u0dcf\u0dc3 \u0dc4\u0da7 \u0dba\u0d9c\u0dda\u0dc1\u0d9c\u0dda\u0daf\n\n\u0dd0\u0d9c\u0dda \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba \u0dc1\u0d9c\u0dcf\u0da9 \u0d9c\u0dad\u0dca\u0dad\u0dcf \u0dbd\u0dd4 \u0dc1\u0dad\u0dbd\u0dca \u0dc1\u0db4\u0ddd\u0dbd\u0dd2\u0db8\u0dca \u0db1\u0dd0 \u0db4 \u0dbd\u0dd4 \u0d85 \u0dc0\u0dcf \u0db1\u0dd0 \u0db4 \u0dbd\u0dd4 \u0dc1\u0db8\u0dca\u0dc0\u0dcf \u0db1\u0dd0 \u0db4 \u0dbd\u0dd4 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0daf \u0d92\u0dc0\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0dc0\u0dcf\u0dc1\u0dc3\u0db8 \u0db4 \u0dab\u0dd4 \u0dab\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dad\u0dca 