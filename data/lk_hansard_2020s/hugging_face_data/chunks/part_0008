    "chunk_text": "2024 \u0dc3\u0d9a\u0db4\u0dcf\u0dad\u0d9a\u0dda\u0db6\u0dbb\u0dca 22\u0dc0\u0db1 \u0daf\u0dcf \u0d89\u0db3\u0dcf\u0dcf \u0daf\u0dc0\u0dc3\u0dca 65\u0d9a\u0dca, 70\u0d9a\u0dca \u0db1\u0dc0\u0dcf, \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0d9a\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dca\u0db1. \u0d92\u0dc1\u0d9c\u0ddc\u0dbd\u0dca\u0dcf\u0db1\u0dca \u0dc3\u0d9a\u0db4\u0dcf\u0dad\u0d9a\u0dda\u0db6\u0dbb\u0dca 2 \u0dc0\u0d9a\u0db1\u0dd2 \u0daf\u0dcf \u0daf\u0dd2\u0db1\u0dd4\u0dc1\u0dc0\u0ddc\u0dad\u0dca \u0d9c\u0db8\u0da7 \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0db6\u0dcf \u0dad\u0dca \u0dc1\u0daf\u0db1\u0dca\u0db1 \u0db1\u0dc0\u0dcf \u0dc1\u0db1\u0dca. \u0d9c\u0dbb\u0dd4 \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2, 2022 \u0db8\u0d9a\u0dba\u0dd2 09\u0dc0\u0d9a\u0db1\u0dd2 \u0daf\u0dcf \u0db4\u0d9a 6\u0d9a\u0dca \u0dad\u0dd4\u0dc5 \u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0dc1\u0d9c\u0dc0\u0dbd\u0dca \u0d9a\u0dd3 \u0d9a\u0dca \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dd2\u0dda\u0db6\u0dcf\u0daf? \u0dc0\u0dcf\u0dc4\u0db1 \u0d9a\u0dd3 \u0d9a\u0dca \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dd2\u0dda\u0db6\u0dcf\u0daf? \u0da2\u0dd3\u0dc0\u0dd2\u0dad 8\u0d9a\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0d9c\u0dad\u0dca\u0dad\u0dcf, \u0d85\u0dad\u0dd4\u0dc1\u0d9a\u0ddd\u0dbb\u0dc5 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0db8. \u0dc1\u0dda\u0dc0\u0dcf \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dc1\u0dda\u0dad\u0dca \u0d85\u0db4\u0da7 \u0daf\u0d9a\u0dd2\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. 988 \u0db4\u0d9a\u0dc0\u0d9a\u0dad\u0dd2 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dab\u0dc1\u0dda \u0daf\u0dd3 \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dcf\u0d82\u0d9a\u0dcf \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda, \u0dc1\u0d9a\u0ddc\u0db8\u0dd2\u0dba\u0dd4\u0db1\u0dd2\u0dc3\u0dca\u0da7\u0dca \u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dcf\u0d82\u0d9a\u0dcf \u0db8\u0dc4\u0da2\u0db1 \u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda 68 \u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dca \u0da2\u0db1\u0dad\u0dcf \u0dc0\u0dd2\u0db8\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc1\u0db4\u0dbb\u0db8\u0dd4\u0dab \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d9d\u0dcf\u0dad\u0db1 \u0d9a\u0dc5\u0dcf. \u0d91\u0daf\u0dcf -\u0db8\u0d9a\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0daf\u0dd2\u0db1\u0dc1\u0dda \u0daf\u0dd3- \u0da1\u0db1\u0dca\u0daf \u0daf\u0dd3\u0dbb\u0db4 \u0dc3\u0dc4 \u0dbb\u0dcf\u0da2\u0d9a\u0dcf\u0dbb\u0dd2 \u0d9a\u0dc5 \u0db1\u0dd2\u0dcf\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca 63\u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dca \u0d9d\u0dcf\u0dad\u0db1 \u0d9a\u0dc5\u0dcf. \u0d89\u0db1\u0dca\u0db4\u0dd4\u0dbb\u0dc0 \u0daf\u0dd2\u0db1 70\u0d9a\u0daf\u0dd3 -\u0db8\u0dc4 \u0db8\u0d9a\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0dc1\u0dad\u0d9a\u0dca- \u0d92 \u0d9a\u0dd2 \u0db1\u0dca\u0dc1\u0db1\u0dca, 989 \u0dc1\u0db4\u0db6\u0dbb\u0dc0\u0dcf\u0dbb\u0dd2 5\u0dc0\u0d9a\u0db1\u0dd2 \u0daf\u0dcf \u0db8\u0d9a\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0daf\u0dd2\u0db1\u0dc1\u0dda \u0dc3\u0dc4 \u0d8a\u0da7 \u0daf\u0dd2\u0db1 2\u0d9a\u0da7 \u0d9a\u0dbd\u0dd2\u0db1\u0dca 433\u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dca \u0db8\u0d9a\u0dbb\u0dd4\u0dc0\u0dcf. \u0db8\u0d9a\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0daf\u0dd2\u0db1\u0dc1\u0dda 84\u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dca \u0d9d\u0dcf\u0dad\u0db1 \u0d9a\u0dc5\u0dcf. \u0da1\u0db1\u0dca\u0daf \u0db8\u0db0\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1 2 \u0d9a\u0da7 \u0dc1\u0db6\u0ddd\u0dda\u0db6 \u0d9c\u0d9a\u0dab\u0dd4\u0dc0\u0dcf. \u0d91\u0dc0\u0d9a\u0db1\u0dd2 \u0daf\u0dd2\u0db1 70\u0d9a\u0dca \u0d85\u0db4\u0da7 \u0db1\u0d9a\u0dc0\u0dad \u0dc0\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0db4\u0dab\u0dd4\u0d9a\u0dbb\u0db1\u0dca\u0db1\u0da7 \u0dc1\u0db1\u0ddc\u0dcf\u0d9a\u0dc1\u0dda\u0dc0\u0dcf \u0d9a\u0dd2 \u0dcf\u0dcf \u0db8\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dbb\u0dca\u0dae\u0db1\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dab\u0dc1\u0dda \u0daf\u0dd3\u0dad\u0dca, \u0d8a\u0da7 \u0db4\u0dd4\u0dbb\u0dc0 \u0daf\u0dd2\u0db1 70\u0d9a\u0daf\u0dd3 \u0d91\u0dc5\u0d9a\u0dc1\u0db9\u0db1 \u0db8\u0dc4 \u0db8\u0d9a\u0dad\u0dd2\u0dc0\u0dbb\u0dab\u0dc1\u0dda \u0daf\u0dd3\u0dad\u0dca, \u0d8a\u0da7 \u0db4\u0dd4\u0dbb\u0dc0\u0dad\u0dca \u0d91\u0dc0\u0d9a\u0db1\u0dd2 \u0dd3\u0dc2\u0dab \u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dc1\u0db1\u0ddc\u0dc1\u0d9a\u0dc0\u0dcf \u0d9a\u0dd2 \u0dcf\u0dcf \u0db8\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dbb\u0dca\u0dae\u0db1\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0dc1\u0db8\u0ddc\u0d9a\u0daf, \u0d8a\u0dc1\u0dda \u0daf\u0db9\u0dd4\u0dbd\u0dca\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dc1\u0dda \u0dc3\u0db8\u0d9c\u0dd2 \u0da2\u0db1 \u0db6\u0dcf\u0dc1\u0d9a\u0d9c\u0dc1\u0dda \u0db8\u0d9a\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0dcf\u0dbb\u0dca \u0dcf\u0dcf \u0d9a\u0da7 \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0db6\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf.\n\n\u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0db8\u0dc4 \u0db6\u0d9a\u0d82\u0dc0\u0dda\u0dc0 \u0dc3\u0dca\u0dc0\u0dcf\u0db0\u0dd3\u0db1 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d85\u0d9a\u0d9a\u0db8\u0d9a\u0dad\u0dd2 \u0dc0\u0dd3\u0db8, \u0d86\u0dab\u0dca\u0dc0\u0d9a\u0dc0 \u0dc1\u0db4\u0ddc\u0dbd\u0dd2 \u0dad\u0dd3\u0dbb\u0dab \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dad\u0dd3\u0dbb\u0dab \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d86\u0daf\u0dd2 \u0dbb\u0da7\u0da7\n\n731 732\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0dc1\u0d9a\u0ddc\u0dc1\u0dc4\u0ddc\u0db8 \u0db6\u0dcf\u0db4\u0dcf\u0dba\u0dd2\u0daf \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0d9c\u0d9a\u0db1 \u0daf\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dad\u0dc1 \u0ddd \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0db8\u0da7 \u0d86\u0dc3\u0dba\u0dd2 \u0db8\u0dc4 \u0db6\u0d9a\u0d82\u0dc0\u0dda \u0d85\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0db1\u0db1\u0dca\u0daf\u0dcf\u0dcf\u0dbd\u0dca \u0dc0\u0dd3\u0dbb\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0d9a\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0d9c\u0db1\u0dca \u0d85\u0dc4\u0db1\u0dca\u0db1, \u0dc1\u0dda \u0d85 \u0da7 \u0d86\u0dab\u0dca\u0dc0\u0d9a\u0dc0\u0d9a\u0dca \u0d86\u0dc1\u0dc0\u0ddc\u0dad\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0db4\u0d9a \u0d9a\u0dd3 \u0d9a\u0dca \u0dad\u0db1\u0dad\u0dd4\u0dc1\u0dbb\u0dca \u0d89\u0db3\u0dd3\u0daf \u0d9a\u0dd2 \u0dcf\u0dcf. \u0d8a\u0dc5\u0d9f\u0da7 \u0d92\u0dc1\u0d9c\u0ddc\u0dbd\u0dca\u0dcf\u0db1\u0dca \u0d9a\u0dd2 \u0db1\u0dc0\u0dcf, IMF \u0d9c\u0dd2\u0dc0\u0dd2\u0dd4\u0dbb\u0db8 \u0dc0\u0dd3\u0dc3\u0dd2 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dd2 \u0dcf\u0dcf. \u0d91\u0dc1\u0dc4\u0db8 \u0d9a\u0dc1\u0dc5\u0ddc\u0dad\u0dca \u0dc1\u0daf\u0dc3\u0d9a\u0dda\u0db6\u0dbb\u0dca \u0db8\u0dcf\u0dc3\u0dc1\u0dda \u0dcf\u0d9a\u0dc1\u0db6\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dc1\u0da9\u0ddc\u0dcf\u0dbb\u0dca \u0db8\u0dd2\u0dbd\u0dd2 \u0db1 700 \u0dcf\u0d9a\u0dc1\u0db6\u0dba\u0dd2\u0daf? \u0d91\u0dc1\u0dc4\u0db8 \u0dc1\u0db1\u0ddc\u0dc0\u0dd4\u0dc1\u0dab\u0ddc\u0dad\u0dca \u0dc1\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0daf \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0d91\u0daf\u0dcf \u0db8\u0d9a\u0daf\u0db8\u0dd4\u0dcf\u0dc1\u0db1\u0dca \u0dc1\u0d9c\u0ddd\u0db0\u0dcf\u0dcf \u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0dc4\u0dad\u0dca\u0dad \u0dcf \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dcf\u0dcf \u0dc4 \u0db4\u0dcf\u0dcf\u0db1 \u0d86\u0dab\u0dca\u0dc0\u0d9a\u0dc0 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf \u0dc1\u0d9c\u0db1 \u0d9c\u0dd2 IMF \u0dc0\u0d9a\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0dc0\u0dd3\u0dc3\u0dd2 \u0d9a\u0dc5\u0dcf\u0da7 \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dda \u0dc1\u0db8\u0ddc\u0d9a\u0daf \u0dc0\u0dd4\u0dc1\u0dab\u0dca \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a \u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0db8\u0dad\u0d9a \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0db1\u0d9a\u0dc0\u0dad\u0dad\u0dca \u0dc1\u0da9\u0ddc\u0dcf\u0dbb\u0dca \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf \u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0d9a\u0dbb\u0d9c\u0db1\u0dca\u0db1 \u0dc4\u0daf\u0db1\u0dc0\u0dcf. \u0d92 \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca \u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0dc1\u0dda \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0dc3\u0dc4\u0db8\u0dd4\u0dbd\u0dd2\u0db1\u0dca\u0db8 \u0d9a\u0da9\u0dcf \u0dc0\u0d9a\u0dc1\u0da7\u0db1\u0dc0\u0dcf."
  },
