    "chunk_text": "1999 \u0db4 \u0dcf\u0dad\u0dca \u0dcf\u0dcf \u0db8\u0dad\u0dad\u0dd2\u0dc0\u0dbb\u0dab\u0dc1\u0dcf\u0db1\u0dca \u0db4\u0dd4\u0dc3 \u0da0\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dd2\u0dc5\u0dcf \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dad\u0dd4\u0dd2\u0d82\u0d9c \u0db8\u0dad\u0dad\u0dd2\u0db1\u0dd2\u0dcf \u0dc4\u0dbb\u0dc4\u0dcf \u0db8\u0da7 \u0dc0\u0dcf\u0db9 \u0db4 \u0dcf\u0dad\u0dca \u0dcf\u0dcf\u0dc1\u0dda \u0d85\u0db8\u0dcf\u0dad\u0dba \u0db0\u0dd4\u0dbb\u0dcf\u0d9a\u0dca \u0dc1\u0daf\u0db1\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0dd6\u0dbd\u0dd2\u0db4\u0dc5\u0dad\u0dca\u0dc0\u0dcf \u0d9c\u0dad\u0dca\u0dad\u0dcf \u0d9a\u0dd2\u0dcf \u0dc5\u0dcf\u0dbb\u0dab\u0dcf \u0db8\u0db8 \u0dc1\u0db8\u0dca \u0d85\u0dc0 \u0dca\u0dae\u0dcf\u0dc1\u0dda \u0dc5\u0dd2\u0dad\u0dc1\u0dda\u0daf\u0dd3\u0dc0 \u0db8\u0dad\u0d9a\u0dca \u0dc5\u0dbb\u0db1\u0dca \u0db1 \u0db80 \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0dd6\u0dbd\u0dbd\u0dcf \u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0db8\u0db8 \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0d9c\u0dad \u0dc0\u0dad\u0da9\u0dd2\u0db4\u0dd4\u0dbb \u0dc5\u0dae\u0dcf \u0dc5\u0dbb\u0db1\u0dca \u0d85\u0dc0 \u0dba \u0dad\u0dc4\u0dad0 \u0dc1\u0db8\u0ddc\u0dc5\u0daf, \u0dd2\u0db1 \u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dc5\u0dc1\u0dda \u0da2\u0dca\u200d \u0dad\u0dcf\u0dc0 \u0daf\u0db1\u0dca \u0dc0\u0dcf \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0d85\u0db4\u0da7 \u0dc5\u0dbb\u0db4\u0dd4 \u0dc1 \u0dda\u0dc0\u0dcf0 \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8, \u0db8\u0db8 \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0d91\u0d9a\u0dca\u0dc5 2222\u0daf\u0dd3 \u0dad\u0dcf\u0db6\u0dcf\u0dbd \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dc1\u0dcf\u0d9a\u0dca \u0dc4\u0dad\u0da7\u0dd2\u0dcf\u0da7 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0db4\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0d86\u0dc0\u0dad\u0dca, 2212\u0daf\u0dd3 \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0d91\u0d9a\u0dca\u0dc5 \u0d9