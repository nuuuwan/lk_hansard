    "chunk_text": "\u0d9a\u0dbb\u0db1 \u0db1\u0dcf\u0da9 \u0dad \u0dc1\u0dad\u0ddc\u0d9a\u0d9a\u0dca\u0dd9 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. 9\u0dc0\u0dd0\u0db1\u0dd2 \u0dd9\u0dcf \u0dd9\u0db9\u0dd4\u0dbd\u0dca\u0dbd \u0da2\u0dca\u200d\u0dcf\u0dad\u0dba\u0db1\u0dca\u0dad\u0dbb \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0db4\u0dd2\u0dd2 \u0dc1\u0dd2 \u0dc1\u0dda \u0dc0\u0dcf \u0dc1\u0dda\u0dad \u0dc3\u0dcf\u0d82\u0dd3\u0dad\u0dad \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0d82 \u0dba\u0d9a\u0dca \u0d85\u0d82\u0db6\u0dd4\u0dab\u0dcf. \u0d92\u0dc1\u0d9a\u0dca group \u0d91\u0d9a\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dbd\u0d9a\u0dca\u0dc2 45\u0d9a\u0dca \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf. Stage \u0d91\u0d9a\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dbd\u0d9a\u0dca\u0dc2 30\u0dba\u0dd2. Sound system \u0d91\u0d9a\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dbd\u0d9a\u0dca\u0dc2 13\u0dba\u0dd2. \u0db8\u0dd4\u0dc5\u0dd4 \u0dc0\u0dd2\u0dba\u0dd9\u0dad \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dbd\u0d9a\u0dca\u0dc2 88\u0dba\u0dd2. \u0d9a\u0dd4\u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0dd2\u0dd2 \u0dc1\u0dd2 \u0d85\u0d82\u0db6\u0dd4\u0dab\u0dd4 \u0dc3\u0dcf\u0d82\u0dd3\u0dad\u0dad \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0d82 \u0dc1\u0dd2 \u0dc0\u0dd2\u0dba\u0dd9\u0dad \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 200\u0dba\u0dd2. Dome tents \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca 12\u0d9a\u0dca \u0dd0\u0dc4\u0dd4\u0dc0\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d92 ground \u0d91\u0d9a \u0dad\u0da9 \u0dc0\u0dd4\u0dab\u0dcf. \u0d8a\u0da7 \u0db4\u0dc3\u0dca\u0dc1\u0dc3 \u0da0\u0dd2\u0db4\u0dca \u0dbd\u0dca \u0d9a\u0dd2\u0dba\u0dd4\u0db6\u0dca 90\u0d9a\u0dca \u0dc1 \u0db1\u0dcf\u0dc0\u0dcf. \u0dc1\u0dda \u0db1\u0dcf\u0dc3\u0dca\u0d85\u0d82\u0d9a\u0dcf\u0dbb \u0dc0\u0dd2\u0dba\u0dd9\u0dda \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db1\u0dcf\u0dba\u0d9a \u0dc0\u0dba \u0dc1\u0dd9\u0db1 \u0d85\u0dad\u0dcf\u0dad\u0dba \u0dc4\u0dd2\u0db4\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db1\u0dca\u0daf\u0dd4 \u0dad\u0dd0\u0d85\u0d82\u0dd4\u0db1\u0dad\u0dcf\u0dc1 \u0db1\u0dca \u0d85\u0db4\u0dd2 \u0d85\u0dc4\u0db1\u0dc0\u0dcf, \u0dc1\u0dda \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1\u0dda \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dad \u0dca \u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0dda\u0dc0\u0dcf\u0dd9 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dcf\u0dbd\u0dca\u0dbd \u0dc3\u0dad\u0db1\u0dbd \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf\u0d82 \u0dab\u0dc1\u0dd2 \u0d85\u0d82\u0db6\u0dd4\u0dab\u0dd4 \u0dc3\u0dcf\u0d82\u0dd3\u0dad\u0dad \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0d82 \u0dc1\u0dd2 \u0dc0\u0dd2\u0dba\u0dd9\u0dad \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 100\u0dba\u0dd2. \u0da2\u0dd6\u0db1\u0dd2 21, 26 \u0d85\u0dda\u0db4\u0dcf\u0dc1\u0dbb\u0dca \u0d85\u0d82\u0db6\u0dd4\u0dab\u0dd4 \u0dc3\u0dcf\u0d82\u0dd3\u0dad\u0dad \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0d82 \u0dc1\u0dd2 \u0dc0\u0dd2\u0dba\u0dd9\u0dad \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dc1\u0d9a\u0ddd\u0dd2 3\u0dba\u0dd2. \u0dad\u0dc0\u0dad \u0d92\u0dc1\u0d9a\u0dca \u0db1\u0dd4\u0dc1\u0dd9\u0db1\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc6\u0dba\u0dd2\u0dbd\u0dca \u0dc4\u0dd9\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0dd9 \u0dc3\u0dcf\u0d82\u0dd3\u0dad\u0dad \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0d82 \u0dba\u0d9a\u0dca \u0d85\u0d82\u0dc1\u0db6\u0db1\u0dc0\u0dcf, \u0dba\u0dcf\u0db4\u0db1\u0dc1\u0dd2. 15\u0dc0\u0dd0\u0db1\u0dd2 \u0dd9\u0dcf \u0dc4\u0dd0\u0da7\u0db1\u0dca\u0dc0\u0dbd \u0d85\u0d82\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dbb\u0dd4 \u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dd4\u0db1\u0dad\u0db1\u0dd2, \u0dc1\u0dda \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1\u0dda \u0d86\u0db6\u0dcf\u0db0\u0dd2\u0dad \u0dc1\u0dc3\u0db6\u0dc5\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0daf\u0dd3\u0dad\u0db1\u0dcf\u0dc0 \u0d9a\u0db4\u0dbd\u0dcf \u0d85\u0d82\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d92\u0d9a \u0dc1\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0da7 \u0db4\u0dad\u0dab\u0d9a\u0dca \u0daf\u0dd3\u0dbd\u0dcf \u0d85\u0d82\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4 \u0d86\u0db6\u0dcf\u0db0\u0dd2\u0dad \u0dc1\u0dc0\u0dbd\u0dcf \u0d85\u0d82\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dbb\u0da7, \u0da2\u0dca\u200d\u0dcf\u0d85\u0d82\u0dba \u0d92\u0d9a\u0dcf \u0db8\u0dd2\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0d91\u0d9a\u0dca\u0dc1\u0dc3 \u0dc3 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf\u0dba\u0dd2. \u0d92 \u0d86\u0db6\u0dcf\u0db0\u0dd2\u0dad \u0dc1\u0dc3\u0db6\u0dc5\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0daf\u0dd3\u0dad\u0db1\u0dcf\u0dc0 \u0d9a\u0db4\u0dbd\u0dcf \u0d85\u0d82\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0db1\u0dda, \u0d92 \u0daf\u0dd3\u0dad\u0db1\u0dcf\u0dc0 \u0dc1\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0da7 \u0db4\u0dad\u0dab\u0d9a\u0dca \u0db8\u0dd3\u0da7 \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0daf\u0dd3\u0dbd\u0dcf \u0d85\u0d82\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0db1\u0dda \u0d92 \u0dd0\u0db1 \u0db1\u0dd0\u0dc0\u0dad \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba \u0dc1\u0dba\u0ddc\u0db8\u0dd4 \u0dc1\u0db1\u0ddc\u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d87\u0dba\u0dd2? \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 \u0dab\u0db1\u0dca\u0dc0\u0dbd\u0dd2\u0db1\u0dca, \u0dbd\u0d9a\u0dca\u0dc2 \u0dab\u0db1\u0dca\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc1\u0dda \u0db1\u0dcf\u0dc3\u0dca\u0d85\u0d82\u0d9a\u0dcf\u0dbb \u0dc1\u0dda\u0dc0\u0dbd\u0dca\u0dc0\u0dbd\u0da7 \u0dc0\u0dd2\u0dba\u0dd9\u0dda \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\n\n\u0d9c\u0dd4 \u0db1\u0dd3\u0dad\u0dd2\u0da5 \u0dc0\u0dc3\u0db1\u0dca\u0dad \u0dba\u0dcf\u0db4\u0dcf\u0db6\u0dab\u0dca\u0da9\u0dcf\u0dbb \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bb0\u0ba3\u0bbf \u0bb5\u0b9a\u0ba8\u0bcd\u0ba4 \u0baf\u0bbe\u0baa\u0bcd\u0baa\u0bbe\u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0) (The Hon. Wasantha Yapabandara, Attorney-at-Law) \u0dad\u0da7 \u0dc1\u0dda \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d89\u0da9 \u0dc1\u0dd9\u0db1\u0dca\u0db1, \u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dbb\u0dd4 \u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dd4\u0db1\u0dad\u0db1\u0dd2.\n\n\u0dad\u0db0\u0dba\u0dad \u0db4\u0dc5\u0dcf\u0dc1 \u0dc3\u0dd2\u0dd2 \u0db1 \u0d8b\u0db4\u0dcf\u0db0\u0dd2\u0db0\u0dcf\u0dd2\u0db4\u0db1\u0dca 3,000\u0d9a\u0dca \u0dbb\u0dd4 \u0dc1\u0dc3 \u0dc0\u0dcf \u0dad\u0dbb \u0dc0\u0dd2\u0db7\u0dcf \u0dba \u0dc3\u0dad \u0dc0\u0dd4\u0dc0 , \u0dc1\u0dd9\u0dc0\u0db1 \u0d85\u0daf\u0dd2\u0dba\u0dbb \u0dba\u0da7 \u0dc1 \u0db4 \u0dc0\u0dd3\u0dda \u0daf\u0dd3\u0dbd\u0dcf \u0d85\u0d82\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca 386\u0d9a\u0da7 \u0db4\u0dad\u0dab\u0dba\u0dd2. \u0dad\u0db0\u0dba\u0dad \u0db4\u0dc5\u0dcf \u0dc1 \u0dbb\u0dd4 \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0da9\u0dd4 6,300\u0d9a\u0dca \u0d85\u0d82\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1 \u0d87\u0dad\u0d85\u0d82\u0dd4\u0db1\u0dad\u0dcf\u0da7 -\u0d85\u0dc1\u0db4\u0dca \u0dc3\u0dd4\u0dc3\u0dd2\u0dbd\u0dca \u0dc1\u0db4\u0dca\u200d\u0dbb \u0dad\u0da2\u0dca\u200d\u0dba\u0db1\u0dca\u0dad \u0dad\u0dd0\u0d85\u0d82\u0dd4\u0db1\u0dad\u0dcf\u0da7- \u0dc1\u0dda \u0dc0\u0dd0\u0dc1\u0da9\u0dca \u0d9a\u0dbb\u0dc1 \u0db1 \u0dba\u0db1\u0dca\u0db1, \u0dc4\u0dd2\u0db4\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db1\u0dca\u0daf\u0dd4 \u0dad\u0dd0\u0d85\u0d82\u0dd4\u0db1\u0dad\u0db1\u0dca\u0dbd\u0dcf \u0dad\u0dbb\u0dd4\u0dab \u0dc1\u0dc3 \u0dc0\u0dcf \u0dc3\u0db7\u0dcf\u0dc1\u0dda \u0d9a\u0dcf\u0db6\u0dcf\u0dc3\u0dd2\u0db1\u0dd2\u0dba\u0dcf \u0d9a\u0dbb\u0db1 \u0db8\u0dd4\u0dd9\u0dbd\u0dca \u0dd2 \u0d9a \u0dc1\u0dd9\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dad\u0dad \u0d89\u0dad\u0dcf \u0dc0\u0dd0\u0dd9 \u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dd2 \u0dc4\u0dd2\u0dd2 \u0dba \u0dc3\u0dd4\u0dc3\u0dd2\u0dbd\u0dca \u0dc1\u0db4\u0dca\u200d\u0dbb \u0dad\u0da2\u0dca\u200d\u0dba\u0db1\u0dca\u0dad \u0dad\u0dd0\u0d85\u0d82\u0dd4\u0db1\u0dad\u0dcf \u0d85 \u0dba \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0dad\u0db0\u0dba\u0dad \u0db4\u0dc5\u0dcf\u0dc1 , \u0dc0\u0dd2\u0dc1 \u0dc2\u0dc1\u0dba\u0db1\u0dca \u0dad\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dc1\u0dd2 \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dd4\u0db1 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0d85\u0db4\u0da7 \u0d9a\u0dd0\u0d9a\u0dca\u0d9a\u0dd4\u0dad\u0d9a\u0dca \u0d85\u0d82\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc1\u0dad\u0ddc\u0d9a\u0dd9, \u0dad\u0dad \u0dad\u0dc4\u0db1\u0dd4\u0dc0\u0dd2\u0db4\u0db1\u0dca \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dba \u0dbd\u0db6\u0db4\u0dd4 \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dca. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf\u0dba\u0dd2 \u0dad\u0dad \u0dc1\u0dda \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca."
