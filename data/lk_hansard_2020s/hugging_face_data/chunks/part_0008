\u0dbd\u0dd3\u0db1 \u0d85\u0dc0 \u0dba\u0dad\u0dc1\u0dc0\u0db1\u0dca\u0da7 \u0d9c\u0dd0\u0dc5\u0dc1\u0db4\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0db4\u0dc1\u0dcf\u0db1 \u0dca\u0dc4 \u0dc1\u0dad\u0ddc\u0d9c \u0dc1\u0dc0\u0dc1\u0dc5\u0dd4\u0db1\u0db1\u0dca\u0da7 \u0db1\u0da9\u0dd4 \u0db4\u0dd0\u0dc0\u0db8 \u0dc1\u0dc0\u0dbd \u0dc4\u0dd0\u0dbb\u0dd3 \u0dc1\u0dc0 \u0dc0\u0dd0\u0da9\u0dd2\u0dd4\u0dbd\u0dbb\u0da7\u0dad\u0dca \u0dca\u0dcf\u0dc1 \u0ddd\u0db0\u0dca\u200d\u0db1 \u0d9a\u0dbb \u0dc3\u0dad. \u0dbb\u0dc1\u0db8\u0db1\u0dca\u0db8 \u0db1\u0dd2\u0db1\u0db0\u0dca\u200d\u0dc1\u0dbb\u0dd2\u0db1\u0dca \u0db3\u0dc0\u0dc1 \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d85\u0dcf\u0dc1\u0dc5\u0dc0 \u0db4\u0dc0\u0dd2\u0dbb\u0db1 \u0da0\u0d9a\u0dca\u200d\u0dbb\u0dc1\u0dbd\u0dca\u0dca\u200d \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dca\u200d\u0dc1\u0db1 \u0d85 \u0dbd\u0dc0 \u0dad\u0db1\u0dad\u0dd4\u0db8\u0dbb\u0dd4 \u0dc4\u0dd4\u0dbb\u0dda\u0db4\u0dc1\u0da9\u0dd4 \u0dca\u0db3\u0dc4\u0dc1 \u0db3\u0dc0\u0dc1 \u0d9c\u0dd0\u0db1\u0dd3\u0dc0\u0dbd \u0dc3\u0dd2\u0dd4\u0dbd \u0dbb\u0dd3\u0db8 \u0db8\u0da7 \u0db1\u0dd2 \u0db8\u0dd2\u0dad \u0dc0\u0db1 \u0d85\u0dad\u0dbb \u0d92 \u0dca\u0dc0\u0dbd \u0db1\u0dca\u0db0\u0dca\u200d\u0dc0 \u0dc1\u0dc0\u0dbd \u0dc0\u0db1 \u0dc0\u0dd2\u0da7\u0dad\u0dca \u0dca\u0dc1\u0d9a\u0da0\u0dca\u0da1\u0dc1 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0dc3\u0dd2\u0dd4\u0dbd \u0d9a\u0dbb \u0dbd \u0db1 \u0db1\u0dca. \u0db4\u0dc1\u0dbb\u0dd2\u0dc1\u0dcf\u0ddd\u0d9c\u0dd2\u0d9a \u0db1\u0dca\u0da7 \u0dc0\u0da9\u0dc1\u0dad\u0dca \u0dca\u0dc4\u0db1\u0dcf\u0dc1\u0dba\u0dd3 \u0dc1\u0dca\u0dda\u0dc0 \u0d9a\u0dca \u0dca\u0dd0\u0db4\u0dba\u0dd3\u0db8 \u0dca\u0db3\u0dc4\u0dc1 \u0db1\u0dc0 \u0dad\u0dc1\u0d9a\u0dca\u0dc2\u0dab \u0d8b\u0db4\u0dc1 \u0ddd\u0dd3 \u0d9a\u0dbb \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dbb\u0dd3\u0db8 \u0db8 \u0dca\u0db3\u0dc4\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0db4\u0dc1\u0dcf\u0db1 \u0db8\u0dc4\u0dc1 \u0dcf\u0dc1\u0dab\u0dca\u0da9\u0dc1\u0d9c\u0dc1\u0dbb\u0dc1 \u0db1\u0dca \u0dd2\u0dbd\u0dca\u0db1\u0dc1 \u0dc3\u0dad.\n\n\u0d92 \u0dc0\u0dc1\u0dc1 \u0db8 \u0db4\u0dc1\u0dbb\u0dd2\u0dc1\u0dcf\u0ddd\u0d9c\u0dd2\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0db4\u0dd2\u0dd2\u0db6 \u0db3 \u0d85\u0db0\u0dd2\u0d9a\u0dc1\u0dbb\u0dd2 \u0da7 \u0db1\u0dd0\u0dc1 \u0db1 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dbd\u0dd2 \u0dc0\u0dd2\u0db8\u0d9a \u0db1 \u0dbb\u0dd3\u0db8 \u0db8 \u0dca\u0db3\u0dc4\u0dc1 \u0dca\u0dc4 \u0d9a\u0dc1\u0d9a \u0d9a\u0dca\u0dc2\u0db8 \u0dbb\u0dd3\u0db8 \u0db8 \u0d8b\u0dc1\u0dcf\u0dca\u0dc1 2003 \u0d85\u0dcf\u0d9a 9 \u0dcf\u0dbb\u0db1 \u0db4\u0dc1\u0dbb\u0dd2\u0dc1\u0dcf\u0ddd\u0d9c\u0dd2\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0db4\u0dd2\u0dd2\u0db6 \u0db3 \u0d85\u0db0\u0dd2\u0d9a\u0dc1\u0dbb\u0dd2 \u0db4\u0db1\u0dc1\u0dad\u0dca 13 \u0dca\u0dc4 32 \u0dc0\u0d9c\u0db1\u0dca\u0dd2\u0dbb \u0da7\u0dc1\u0dad\u0dca \u0db1\u0dd0\u0dc1 \u0db1 \u0db4\u0dc1\u0dbb\u0dd2\u0dc1\u0dcf\u0ddd\u0d9c\u0dd2\u0d9a \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dbd\u0dd2 \u0dc0\u0dd2\u0db8\u0d9a \u0db1 \u0dbb\u0dd3\u0db8 \u0db8 \u0dbb\u0dd2\u0dca\u0dae\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a \u0d9a\u0dbb\u0dc1 \u0dc0\u0dd2\u0db8\u0db0\u0dca\u200d\u0dba\u0d9c\u0dad \u0dbb\u0dd3\u0db8 \u0dc1\u0dc0\u0dbd \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dc0\u0dc5\u0d9a\u0dca \u0dc1\u0dc0\u0dbd \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0dca\u0d9a\u0dca\u0dae \u0d9a\u0dbb \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd3.\n\n\u0d92 \u0d85 \u0dbd\u0dc0 \u0dca\u0dc4\u0db1 \u0d85\u0dc1\u0dda\u0d9a\u0dca\u0dc2\u0dc1\u0dc1\u0dc0\u0db1\u0dca \u0dc3\u0dd2 \u0dd4 \u0dbb\u0dd2\u0dca\u0dae\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0d9a\u0dc1\u0d9a \u0dc1\u0db1\u0dc0\u0db1\u0da7 \u0db4\u0dc1\u0dbb\u0dd2\u0dc1\u0dcf\u0ddd\u0d9c\u0dd2\u0d9a \u0db1\u0dca \u0dd2\u0dbb\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0db1\u0dcf \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dbd\u0dd2 \u0dca\u0db3\u0dc4\u0dc1 \u0dbb\u0dd2\u0dca\u0dae\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0db8\u0da7\u0dca\u0da7\u0db8\u0dd2\u0db1\u0dca \u0db4\u0db8 \u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dbb\u0dd3\u0db8 \u0db8 \u0dca\u0db3\u0dc4\u0dc1 \u0dc1 \u0ddc\u0db8\u0dd4 \u0d9a\u0dbb \u0dbd \u0db1 \u0db1\u0dca.\n\n\u0d9c\u0dbb\u0dd4 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2 \u0db1\u0dc1 \u0d9a\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2 \u0dc1\u0dc0\u0dbd \u0db4\u0db1\u0dc1\u0dad\u0dca \u0dd2\u0dbb\u0dc1 \u0db1 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0db4\u0dc1\u0dcf\u0db1\u0dc0\u0db1\u0da7 \u0d85 \u0dbd\u0dc0 \u0db4\u0dc1\u0db1\u0db1 \u0db8\u0dd2\u0db1\u0d9a\u0dca \u0dcf\u0dc1\u0db1\u0dc1 \u0dc1\u0dc0\u0dbd \u0db1\u0da9\u0dd4\u0dc0\u0db1\u0da7 \u0db4\u0da7\u0db1\u0dc0\u0dc1\u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dbb\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dc0\u0dbd \u0db1\u0da9\u0dd4 \u0dcf\u0dc1\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc3\u0dd2\u0dbd\u0dca\u0db1\u0dbb \u0dc1\u0dc0\u0dc1\u0dc5\u0db1\u0dca\u0dcf\u0dc1\u0da7\u0db1\u0dca. \u0d85\u0db4\u0dd2 \u0dc1\u0dc0\u0dbd \u0d85\u0dd4 \u0dad\u0dca \u0dca\u0dcf\u0dc1 \u0ddd\u0db0\u0dca\u200d\u0db1\u0dc1 \u0db1\u0dca \u0db1\u0dc1\u0dc1\u0db4\u0ddc\u0dc1\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4\u0db8 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0dcf? \u0dc0\u0dd2 \u0dc1\u0db1 \u0dc0 \u0dc1 \u0db1\u0dca \u0db1\u0dc1\u0dcf \u0dd2\u0dbb \u0dc1\u0dc1\u0d9c\u0db1 \u0dbb\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dc0\u0dbd \u0dc1\u0dad\u0ddc\u0d9c \u0dca\u0d9f\u0dc0\u0dc1 \u0dc1\u0d9c\u0db1 \u0dbb\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dc0\u0dbd \u0dc1\u0dad\u0ddc\u0d9c \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0dc1\u0db1\u0ddc\u0d9a\u0dbb \u0db8\u0dc4\u0dc1 \u0db4\u0dbb\u0dd2\u0db8\u0dc1\u0dab\u0dc1 \u0db1\u0dca \u0dc1\u0dc0\u0dbd \u0dca\u0dc0\u0dbd \u0db1\u0dca\u0db0\u0dca\u200d\u0dc1 \u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd2\u0dc2\u0dae\u0db4\u0dc1\u0dcf\u0d9a \u0dc1\u0db1\u0dca. \u0db1\u0dd2\u0dc2\u0dae\u0db4\u0dc1\u0dcf\u0d9a \u0dc1 \u0dad\u0db8\u0db1\u0dca \u0dca\u0dad\u0dd4\u0db8 \u0dc1\u0dad\u0ddc\u0d9c \u0dca\u0d9f\u0dc0\u0dc1 \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dc1 \u0db1\u0dc0\u0dbd \u0dbb\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dc0\u0dbd \u0dbb\u0db8 \u0dc1\u0dad\u0ddc\u0d9c \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0dc1\u0db1\u0ddc\u0d9a\u0dbb\u0db1\u0dc0\u0dc1 \u0db1\u0dc0\u0dbd \u0d92 \u0dcf\u0dc1\u0dab\u0dca\u0da9 \u0dbb\u0dc1\u0da2\u0dca\u0db1\u0dca\u0dad\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dc4\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dca \u0db1\u0dd3\u0dd2\u0dbb \u0d85\u0db4\u0dd2 \u0dc1\u0dc0\u0dbd \u0dca\u0dcf\u0dc1 \u0ddd\u0db0\u0dca\u200d\u0db1\u0dc1 \u0db1\u0dca \u0dc1\u0d9c\u0db1\u0dd0\u0dbd\u0dca\u0db1\u0dc1 \u0dd2\u0dbb\u0dc1 \u0db1\u0dc0\u0dc1. \u0dad\u0dc0 \u0dca\u0dd2\u0dbb \u0dc1\u0dcf\u0d9a\u0d9a\u0dca \u0dad\u0dd4\u0db8\u0db1\u0d9a\u0dca \u0db0\u0dd2\u0daf\u0dd3 \u0d85\u0db4\u0da7 \u0db4\u0dc1\u0d9a\u0dbd\u0dd2\u0dc1\u0dc0\u0dbd\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\u0da7 \u0dc1\u0dc0\u0dbd \u0d85\u0dd4 \u0dad\u0dca \u0dc1\u0d9a\u0da7\u0dd4\u0dc0\u0dbd\u0db4\u0dad \u0dc1 \u0ddc\u0db8\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dc4\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dca."
