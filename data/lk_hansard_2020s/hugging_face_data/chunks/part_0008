    "chunk_text": "\u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0d9c\u0dda\u0dd3\u0dad\u0dd4\u0db8\u0dc3\u0dd4 \u0dc1\u0db8\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a \u0db1 \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0db4\u0dbb\u0dd2\u0dc0\u0dbb\u0dca\u0dad\u0db1\u0dba\u0d9c\u0dda \u0dc3\u0db8\u0dca\u0db6\u0d9c\u0dda\u0db0\u0dc1\u0dba\u0d9c\u0dda \u0d94\u0db6\u0dad\u0dd4\u0db8\u0d9c\u0dda\u0dbd\u0dcf\u0dc1\u0dc3 \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba \u0dc1\u0dba\u0dcf\u0db8\u0dd4 \u0d9a \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d9a\u0dcf \u0dab\u0dcf 3\u0d9a\u0dca \u0db4\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0daf \u0d92\u0dc0\u0dcf\u0dc1\u0dba\u0d9c\u0dda \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0dd0\u0dc3\u0dd4 \u0d91\u0d9a \u0dad\u0db8\u0dd2 \u0d9a\u0da9\u0dcf \u0dc0\u0dd0\u0da7\u0dd4\u0dab\u0dd4 \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dc1\u0dda \u0db4\u0dd3\u0da9\u0dcf\u0d9a\u0dcf\u0dbb\u0dd2 \u0db6\u0dbd\u0db4\u0dd1\u0dc1\u0db8\u0d9c\u0dda \u0dd2\u0db1\u0dba\u0dbd\u0dd4 \u0da2\u0dca\u200d\u0db1 \u0dc1\u0d9a\u0dcf\u0da7\u0dc3\u0dcf \u0db8\u0dd4 \u0dcf \u0dc1\u0d9c\u0db1 \u0d92 \u0dc3\u0dd1\u0db8 \u0d9a\u0dca\u0dc1\u0dc2\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a\u0dca\u0db8 \u0db8\u0dd0\u0daf\u0dd2 \u0d9a\u0dcf\u0dbd\u0dd3\u0db1\u0dc0 \u0dc4\u0dcf \u0daf\u0dd2\u0d9c\u0dd4\n\n\u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0d9c\u0dda\u0dd3\u0dad\u0dd4\u0db8\u0dc3\u0dd4 \u0d85\u0dc1\u0dda \u0dc1 \u0dc0 \u0d85\u0db4\u0db1\u0dba\u0db1\u0dba \u0dc1\u0da9\u0dcf\u0dbd\u0dbb\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 44\u0dd2\u0daf \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4\u0dc0 20\u0d9a\u0dca \u0d91\u0d9a\u0db8 \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba \u0db4\u0dc1\u0db6\u0d9c\u0dda\u0dc1\u0d9c\u0dda\u0daf \u0dc1\u0dbd\u0ddd\u0d9a\u0dc1\u0dda \u0d85\u0dc1\u0db1\u0d9a\u0dca \u0da7\u0dc0\u0dbd\u0dca \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dcf\u0dad\u0dca \u0d85\u0db4\u0db1\u0dba\u0db1\u0dba \u0dd2\u0db1\u0dba\u0dba\u0da7 300\u0d9a\u0dd2\u0d9c\u0dda 400\u0d9a\u0dd2\u0d9c\u0dda 500\u0d9a\u0dd2\u0d9c\u0dda \u0db4\u0db8\u0dab \u0dc0\u0dd0\u0dd2 \u0dc1\u0dc0\u0dbd\u0dcf \u0db4\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0daf \u0dc0\u0dd2\u0dba \u0dc0\u0db1\u0dcf\u0db8\u0dba \u0db6\u0d82\u0dc3\u0dbd\u0dcf\u0dc1\u0dda \u0dba \u0d86\u0daf\u0dd2 \u0da7\u0dc0\u0dbd\u0dca \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dcf\u0dad\u0dca 2040 \u0dc0\u0dc3\u0dc1\u0dbb\u0dca \u0db4 \u0dab\u0dd4 \u0d85\u0db4\u0db1\u0dba\u0db1 \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dc0\u0dbd\u0da7 \u0dc3\u0dcf\u0dc1\u0dda\u0d9a\u0dca\u0dc2\u0dc0 \u0d85 \u0dc0\u0db1 \u0dc1\u0d9a\u0dcf\u0da7 \u0d91\u0dc4\u0dd2 \u0dc1\u0dd3\u0d9d\u0dca\u200d\u0dbb \u0d89\u0dc4\u0dc5 \u0dba\u0dd1\u0db8\u0d9a\u0dca \u0dd2\u0db1\u0dd4\u0dc0 \u0dc1\u0dc0\u0dbd\u0dcf \u0db4\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0daf \u0d85\u0dc1\u0dda \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba \u0dad\u0db8\u0dd2 \u0d85\u0dc1\u0dda \u0d85\u0db4\u0db1\u0dba\u0db1\u0dba \u0d85\u0da9\u0dd4 \u0d9c\u0dab\u0dc1\u0d9c\u0dda \u0dc1\u0da9\u0dcf\u0dbd\u0dbb\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 20 \u0d9a\u0dca\u0dc0\u0dcf\u0dc0\u0dad\u0dca \u0dc0\u0dd0\u0dd2 \u0d9a \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0daf \u0dc4\u0dd0\u0db6\u0dd0\u0dd2 \u0d85\u0db4\u0da7 \u0dd2\u0db1\u0dd4\u0dc0 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda \u0d9a\u0da7 \u0dc1\u0da9\u0dcf\u0dbd\u0dbb\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 3\u0d9a\u0dc0\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dda \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1 \u0dc1\u0d9c\u0db1 \u0d91\u0d9c\u0dda\u0db1\u0daf \u0d91\u0dba \u0dc0\u0dd2\u0dad \u0d9a\u0dca \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dd2 \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dc1\u0dda \u0daf\u0dd3 \u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc3\u0dd4\u0dba\u0dd2\u0dad \u0dc1\u0db8\u0dca \u0db4\u0db1\u0dad \u0dad\u0dd4\u0dc5\u0dd2\u0d9c\u0dda \u0dc0\u0db1 \u0dc0\u0dcf\u0dd2\u0db1\u0dba\u0daf \u0d9a\u0dd2\u0dd2\u0db1 \u0dcf\u0d9a \u0dc1\u0db8\u0dc0\u0dd0\u0dc3\u0dd4 \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0d85\u0dbb\u0dca \u0dba\u0d9a\u0da7 \u0dc1\u0db1\u0dcf\u0dba\u0dd1\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5\u0d9a\u0dca \u0dc1\u0db8\u0dca \u0db4\u0db1\u0dad \u0dad\u0dd4\u0dc5 \u0d85\u0da9\u0d82\u0d9c\u0dd4 \u0d9a \u0db4\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0daf \u0db4\u0db1\u0dad \u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85 \u0dcf\u0dc5 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dd2\u0db1 \u0db4\u0dba\u0db8\u0d9a\u0dca - road map \u0d91\u0d9a\u0d9a\u0dca - \u0dc4 \u0dbd\u0dcf \u0db4\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0daf \u0d92 \u0dc0\u0dcf\u0dc1\u0dc3\u0db8 \u0dba\u0dcf \u0dba\u0dd4\u0dad\u0dd4 \u0dc1\u0dda\u0d9c\u0dba \u0d86\u0daf\u0dd2 \u0dd2\u0db1\u0dba\u0dbd\u0dca\u0dbd \u0dc1\u0db8\u0dca \u0db4\u0db1\u0dc1\u0dad\u0dca \u0dc3\u0db3\u0dc4\u0d9c\u0dda \u0d9a \u0db4\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0daf \u0dc0\u0dc5\u0dc0\u0dbd\u0dca\u0dc0\u0dbd \u0dc0\u0dd0\u0dc1\u0da7\u0d9c\u0dda\u0dc1\u0d9c\u0dda \u0db1\u0dd0 \u0db4\u0dc0 \u0db1\u0dd0\u0dc0\u0dad \u0db4 \u0dab \u0dad\u0dd3\u0d9c\u0dda\u0dd4\u0dc0 \u0d85\u0db1\u0dc0 \u0dba \u0dad\u0dd3\u0d9c\u0dda\u0dd4\u0dc0 \u0d9c\u0d9c\u0dda\u0dc1\u0d9c\u0dda \u0db1\u0dd0 \u0db4\u0dc0 \u0db6\u0d82\u0dc1\u0d9a\u0dcf\u0dc1\u0dbd\u0dcf\u0dad\u0dca \u0dc0\u0db1 \u0dad\u0dd3\u0d9c\u0dda\u0dd4\u0dc0 \u0d9c\u0d9c\u0dda\u0dc1\u0d9c\u0dda \u0db1\u0dd0 \u0db4\u0dc0 \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dca \u0d9a \u0dcf \u0dba\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1\u0d9a\u0dca \u0dc1\u0db8\u0dca \u0dad\u0dd4\u0dc5 \u0db4\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0daf\n\n\u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0d9c\u0dda\u0dd3\u0dad\u0dd4\u0db8\u0dc3\u0dd4 \u0dc3\u0d82 \u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0 \u0dc1\u0dba\u0d9c\u0dda \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dcf\u0dad\u0dca \u0da2\u0dca\u200d\u0dba \u0dc1\u0db8\u0dca \u0db4\u0db1\u0dad \u0dad\u0dd4\u0dc5\u0dd2\u0d9c\u0dda \u0d89\u0dbd\u0d9a\u0dca\u0d9a 20\u0d9a\u0da7 \u0dba\u0d9c\u0dda\u0db1 \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0dcf\u0dc1 \u0dcf\u0dad\u0dca\u0dad\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf\u0daf \u0d92\u0dc0\u0dcf \u0d85\u0dad\u0dbb\u0dd2\u0d9c\u0dda \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0dad\u0db8\u0dd2 \u0d85\u0dc1\u0dda \u0dc5 \u0dc1\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0dd4\u0dc2\u0dcf\u0db4\u0dcf \u0db1\u0dba \u0dc0\u0dd0\u0dd2 \u0d9a \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc1\u0dc3\u0dcf\u0dc0\u0dcf \u0dc0\u0dd2\u0dba\u0dd4\u0d9a\u0dca \u0db4\u0dba \u0d85\u0da9\u0dd4 \u0db8 \u0dc0\u0da7\u0db8\u0d9a \u0dad\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc1\u0db8\u0d9c\u0dda\u0db8 \u0d9a\u0dcf\u0d9c\u0dda\u0dad\u0dcf\u0dc0\u0d9c\u0dda \u0dbb\u0db8 \u0db6\u0dbd\u0d9a\u0dcf\u0dba\u0da7 \u0dc3\u0dc4\u0db7\u0dcf\u0d9c\u0dd2 \u0d9a \u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0daf \u0dbd\u0d82\u0d9a\u0dcf\u0dc0 \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dcf\u0dad\u0dca \u0d85 \u0dbb\u0db8 \u0db6\u0dbd\u0d9a\u0dcf\u0dba\u0da7 \u0d9a\u0dcf\u0d9c\u0dda\u0dad\u0dcf\u0dc0\u0d9c\u0dda\u0dc1\u0dc3 \u0dcf\u0dba\u0d9a\u0dad\u0dca\u0dc0\u0dba \u0dd2\u0db1\u0dba\u0dba\u0da7 30\u0dd2\u0daf \u0dc1\u0dbd\u0ddd\u0d9a\u0dc1\u0dda \u0d85\u0dc1\u0db1\u0d9a\u0dca \u0da7\u0dc0\u0dbd \u0dd2\u0db1\u0dba\u0dba\u0da7 70\u0dd2 \u0dd2\u0db1\u0dba\u0dba\u0da7 80\u0dd2\u0daf \u0d92 \u0dc3\u0dd4\u0dc3\u0dcf \u0dc1\u0db8\u0dca \u0dc4 \u0dc4\u0dcf \u0d91\u0db8 \u0d85\u0d9c\u0dba \u0dc0\u0dd0\u0dd2 \u0d9a \u0d9c\u0d9c\u0dda\u0db1 \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0dcf\u0dc1 \u0dcf\u0dad\u0dca\u0dad\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf\u0daf \u0dad\u0dc0\u0dad\u0dca \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dca \u0dad\u0db8\u0dd2 \u0dc1\u0d9c\u0dd3\u0db8\u0dca \u0dc1 \u0dcf\u0dc2\u0dc1\u0dba\u0dc4\u0dd2 \u0da2\u0dca\u200d\u0d82\u0d9c\u0db8 \u0d9c\u0dd2\u0d