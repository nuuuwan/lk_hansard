    "chunk_text": "\u0d91\u0d9a\u0d9a\u0dca \u0daf\u0ddc\u0dc1\u0d9c\u0db1 \u0dc0\u0dd2\u0db1\u0ddc\u0da9\u0dd2 120\u0d9a\u0dd2\u0db1\u0dca \u0dc5\u0db8\u0dba\u0dd2\u0db1\u0dca 1,000\u0d9a\u0da7 \u0d8b\u0d9c\u0db1\u0dca\u0dc0\u0ddc \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0d9a\u0ddc\u0dc1\u0dc4\u0ddc\u0db8\u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0db8\u0da7 \u0db1\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0dba\u0d9a\u0dca, \u0db8\u0dd6\u0dbd\u0ddc\u0dc3\u0db1\u0ddc\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0db8\u0db8 \u0dc1\u0db8\u0dc1\u0dc4\u0db8 \u0d9a\u0dd2\u0dda\u0dc0\u0ddc\u0db8 \u0dc1\u0dc4\u0da7 \u0d89\u0db3\u0dbd\u0ddc \u0db8\u0da7 \u0d9c\u0dc4\u0dba\u0dd2. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0db8\u0dc1\u0dda \u0d85 \u0dca\u0dc0\u0dba\u0ddc\u0da7 \u0dc1\u0dc0\u0da9\u0dd2 \u0dad\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dba\u0dd0, \u0db8\u0dd6\u0dbd\u0ddc\u0dc3\u0db1\u0ddc\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0dc1\u0db8\u0dca \u0d87\u0dad\u0dca\u0dad \u0d9a\u0dae\u0ddc \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dc1\u0db8\u0dca \u0d87\u0dad\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dbb\u0da7 \u0dc4\u0daf\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0db1\u0db8\u0dca \u0dad\u0db8\u0db1\u0dca\u0dc1\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8, \u0dad\u0db8\u0db1\u0dca\u0dc1\u0dda \u0dba\u0dd4\u0dad\u0dd4\u0d9a\u0db8 \u0d89\u0dc2\u0dca\u0da7 \u0dc3\u0dd2\u0dda \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0ddc \u0db8\u0db8 \u0d89\u0dbd\u0dca\u0da7\u0dbd\u0ddc \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0ddc. \u0d92 \u0dc0\u0ddc\u0dc1\u0dda\u0db8 \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb\u0db1, \u0d8b\u0d9c\u0db1\u0dca\u0dc0\u0db1, \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc1\u0dda \u0d85\u0db1\u0ddc\u0d9c\u0dad\u0dba \u0d9c\u0dd0\u0db1 \u0dd2\u0dad\u0db1 \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0d85\u0db4\u0dd2 \u0d85\u0dc1\u0db4\u0dca \u0d86\u0dbb\u0da0\u0da0\u0ddc\u0dbb\u0dba, \u0d8b\u0dad\u0dca\u0dad\u0db8\u0ddc\u0da0\u0ddc\u0dbb\u0dba, \u0dc1\u0d9c\u0dde\u0dbb\u0dc0\u0dba \u0dc3\u0dca\u0daf \u0d9a\u0dbb\u0db1\u0dc0\u0ddc.\n\n\u0d92 \u0dc0\u0ddc\u0dc1\u0dda\u0db8 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0daf\u0ddc \u0dc3\u0dd2\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db8\u0dd2\u0db1\u0db1\u0dca \u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca\u0da7 \u0d86\u0dbb\u0da0\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0dc1\u0daf\u0db4\u0ddc\u0db0\u0db1\u0dad\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0dc3\u0dc4 \u0dd2\u0dc0\u0dd2 \u0dc4\u0db8\u0dd4\u0daf\u0ddc\u0dc0\u0da7 \u0dc0\u0dd2 \u0ddc\u0dbd \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0db4\u0da9\u0dd2 \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dd2\u0db4\u0db8\u0dca \u0dc3\u0dd2\u0dda \u0d9a\u0dc5\u0ddc. \u0dc1\u0db8\u0dca\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0dbd\u0d82\u0d9a\u0ddc \u0d89\u0dad\u0dd2\u0dc4\u0ddc\u0dc3\u0dc1\u0dda \u0dd2\u0dc0\u0dd2 \u0dc4\u0db8\u0dd4\u0daf\u0ddc\u0dc0\u0da7 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8. \u0db8\u0dd6\u0dbd\u0ddc\u0dc3\u0db1\u0ddc\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d8b\u0daf\u0dba \u0d86\u0dbb\u0da0\u0db0\u0db1. \u0dc1\u0dc3\u0dc1\u0db1\u0dc0\u0dd2\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dba\u0ddc \u0dc3\u0db7\u0ddc\u0db4\u0dad\u0dd2\u0dad\u0dca\u0dc0\u0dba \u0daf\u0dbb\u0db1 \u0dbb\u0ddc\u0da2\u0dba \u0dc1\u0dc3\u0dca\u0dc0\u0dc1\u0dda \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc4\u0ddc \u0daf\u0dd3\u0db8\u0db1\u0ddc \u0d89\u0dc4\u0dc5 \u0db1\u0dd0\u0d82\u0db8 \u0db8 \u0dc3\u0db3\u0dc4\u0ddc \u0db1 \u0db1\u0dd2\u0db0\u0db1\u0dc1\u0dda \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0da2\u0db1\u0ddc\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1 \u0dca\u0dc2\u0da5 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc1\u0dda \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc0\u0ddc\u0db0\u0db1\u0dad\u0ddc\u0dc0\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0dc3\u0ddc\u0db8\u0ddc\u0db1\u0dba \u0dc1\u0dc3\u0db6\u0dc1\u0dc5\u0d9a\u0dd4\u0dc1\u0dda \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0da7 11,260\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0dad\u0dbb \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc; \u0dbd\u0ddc\u0db1\u0dca\u0dc3\u0dca \u0dc1\u0d9a\u0ddd\u0db4\u0dca\u200d\u0dbb\u0dbd\u0dca\u0da7\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dd4\u0dc1\u0dda \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0da7 12,460\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0dad\u0dbb \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc; \u0dc1\u0d9a\u0ddd\u0db4\u0dca\u200d\u0dbb\u0dbd\u0dca\u0da7\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dd4\u0dc1\u0dda \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0da7 13,500\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc; \u0dc3\u0dd0\u0dbb\u0dba\u0db1\u0dca\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dd4\u0dc1\u0dda \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0da7 14,610\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc; \u0db8\u0ddc\u0dab\u0dca\u0da9\u0dbd\u0dd2\u0d9a \u0dc3\u0dd0\u0dbb\u0dba\u0db1\u0dca\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dd4\u0dc1\u0dda \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0da7 15,600\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc; \u0db6\u0dbd\u0dbd\u0dad\u0dca \u0db1\u0dd2\u0dbd \u0ddc\u0dd2\u0db4\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dd4\u0dc1\u0dda \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0da7 17,580\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc; \u0db6\u0dbd\u0dbd\u0dad\u0dca \u0db1\u0dd2\u0dbd \u0ddc\u0dd2\u0db4 1 \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0da7 21,705\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0dad\u0dbb \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc; \u0d9a\u0dd0\u0dc1\u0da9\u0dca \u0db1\u0dd2\u0dbd \u0ddc\u0dd2\u0db4\u0dc1\u0dba\u0d9a\u0dd4\u0dc1\u0dda \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0da7 13,500\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc; \u0dc1\u0daf\u0dc0\u0db1 \u0dbd\u0dd4\u0dad\u0dd2\u0db1\u0db1\u0dca\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dd4\u0dc1\u0dda \u0db4\u0da9\u0dd2\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0da7 19,725\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc. \u0dbd\u0dd4\u0dad\u0dd2\u0db1\u0db1\u0dca\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dd4\u0dc1\u0dda \u0db4\u0da9\u0dd2\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0da7 28,855\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc. \u0d9a\u0db4\u0dd2\u0dad\u0ddc\u0db1\u0dca\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dd4\u0dc1\u0dda \u0db4\u0da9\u0dd2\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0da7 37,045\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc.\n\n\u0dc1\u0db8\u0dca\u0da2\u0db0\u0db1\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dd4\u0dc1\u0dda \u0db4\u0da9\u0dd2\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0da7 42,505\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc. \u0dc1\u0dbd\u0dc6\u0dca\u0da7\u0dd2\u0db1\u0db1\u0dca\u0dca \u0d9a\u0db0\u0db1\u0db1\u0dbd\u0dca\u0da7\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dd4\u0dc1\u0dda \u0db4\u0da9\u0dd2\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0da7 44,175\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc. \u0d9a\u0db0\u0db1\u0db1\u0dbd\u0dca\u0da7\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dd4\u0dc1\u0dda \u0db4\u0da9\u0dd2\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca\u0da7 58,095\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2"
