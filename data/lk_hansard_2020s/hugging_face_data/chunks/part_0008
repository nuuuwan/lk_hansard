u0dc0\u0dba\u0dc0\u0dc3\u0dda\u0dae\u0dd2\u0dc0\u0da7 \u0dc3\u0dc4 14(1 \u0dc0\u0dba\u0dc0\u0dc3\u0dda\u0dae\u0dd2\u0dc0\u0da7 \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dbd \u0dc0\u0db1 \u0d85\u0dad\u0dba \u0db4\u0dd2\u0dbb\u0dca\u0dd2\u0dba\u0dc1\u0db8\u0dca\u0db1\u0dca\u0daf\u0dad\u0dd4\u0dc1\u0dda\u0daf\u0dd3 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dca\u0da8 \u0db6\u0dc4\u0dd4\u0dad\u0dba \u0da1\u0db1\u0dca\u0daf\u0daf \u0d9a\u0dd2\u0db1\u0dca\u0daf \u0db4\u0db8\u0dda \u0d9a \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dd9\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 . \u0d91\u0dc1\u0dc3\u0dda \u0dc0\u0dd4\u0dc0\u0daf \u0d91\u0db8 \u0dc0\u0d9c\u0db1\u0dca\u0daf\u0dad\u0dd2 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0daf\u0db0\u0dc1 \u0db1\u0dca\u0daf \u0dc1\u0dbb\u0dda\u0dc2\u0dca\u0da8\u0dda\u0db0\u0dd2\u0db0\u0dd2\u0dd9\u0dba\u0dda \u0dbb\u0dab\u0dba\u0dda\u0dc1\u0dad \u0daf \u0d9a\u0dc0\u0dd2 \u0d87\u0dad\u0dd2 \u0dc3\u0da0\u0dc1 \u0ddd\u0db0\u0db1 \u0db1\u0dca\u0dd4 \u0dd9\u0dba\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0db1\u0db8\u0dca \u0d91\u0db8 \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dbd\u0dad\u0dd2 \u0d89\u0dc0\u0dad\u0dca\u0dc0 \u0dd4\u0d9a \u0d87\u0dad.\n\n\uf0b7 79 \u0dc0\u0d9c\u0db1\u0dca\u0daf\u0dad\u0dd2 \u0d86\u0dab\u0dca\u0da9\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dba\u0dc0\u0dc3\u0dda\u0dae\u0dd2\u0dc1\u0dda 12(1 \u0dc0\u0dba\u0dc0\u0dc3\u0dda\u0dae\u0dd2\u0dc0\u0da7 \u0dc3\u0dc4 14(1 (\u0d91 \u0dc0\u0dba\u0dc0\u0dc3\u0dda\u0dae\u0dd2\u0dc0\u0da7 \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dbd \u0dc0\u0db1 \u0d85\u0dad\u0dba \u0db4\u0dd2\u0dbb\u0dca\u0dd2\u0dba\u0dc1\u0db8\u0dca\u0db1\u0dca\u0daf\u0dad\u0dd4\u0dc1\u0dda\u0daf\u0dd3 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dca\u0da8 \u0db6\u0dc4\u0dd4\u0dad\u0dba \u0da1\u0db1\u0dca\u0daf\u0daf \u0d9a\u0dd2\u0db1\u0dca\u0daf \u0db4\u0db8\u0dda \u0d9a \u0d91 \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dd9\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 . \u0d91\u0dc1\u0dc3\u0dda \u0dc0\u0dd4\u0dc0\u0daf 79 \u0dc0\u0d9c\u0db1\u0dca\u0daf\u0dad\u0dd2 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0daf\u0db0\u0dc1 \u0db1\u0dca\u0daf \u0dc1\u0dbb\u0dda\u0dc2\u0dca\u0da8\u0dda\u0db0\u0dd2\u0db0\u0dd2\u0dd9\u0dba\u0dda \u0dbb\u0dab\u0dba\u0dda\u0dc1\u0dad \u0daf \u0d9a\u0dc0\u0dd2 \u0d87\u0dad\u0dd2 \u0dc3\u0da0\u0dc1 \u0ddd\u0db0\u0db1 \u0db1\u0dca\u0dd4 \u0dd9\u0dba\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0db1\u0db8\u0dca \u0d91\u0db8 \u0d85\u0dd4\u0d9a\u0dd6\u0dbd\u0dbd\u0dad\u0dd2 \u0d89\u0dc0\u0dad\u0dca\u0dc0 \u0dd4\u0d9a \u0d87\u0dad."
