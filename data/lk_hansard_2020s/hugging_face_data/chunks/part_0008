    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0dab\u0dae\u0dcf\u0db1\u0dcf\u0d85\u0dab\u0dd4\u0db8\u0db1\u0dd2, \u0d85\u0d9a \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0daf\u0dd2\u0dc4\u0dcf \u0db6\u0dbd\u0db1\u0dca\u0daf\u0db1. \u0d85\u0d9a \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0d9c\u0dca\u0dad\u0dcf\u0db8, \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0dc4\u0d9a\u0dcf\u0dc1\u0d9c\u0db1\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0d91\u0dab \u0d91\u0dab \u0d85\u0dc1\u0db4\u0dcf \u0db4\u0dc2\u0dca\u0da8\u0dab\u0d85\u0dcf \u0daf\u0dd2\u0db1\u0dc0\u0db1\u0dca\u0daf\u0db1 \u0dc1\u0dc0\u0db1\u0db8 \u0dc0\u0da7\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dc0\u0dc5 \u0db4. \u0d85\u0dc1\u0db4\u0dcf \u0dc1\u0da7\u0dca \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0d85\u0d9a \u0d91\u0dab \u0d85\u0dc1\u0db4\u0dcf \u0db4\u0dc2\u0dca\u0da8\u0dab\u0dc1\u0d85\u0dd4 \u0dc1\u0dc0\u0dc0\u0dc1\u0dc0\u0db1\u0dca\u0daf \u0dc1\u0dc0\u0db1 \u0dc1\u0dc0\u0db1\u0db8 \u0dab\u0da7\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dda \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda\u0d9a \u0d85\u0dc0\u0d9c\u0db8\u0db1\u0d85 \u0dab \u0db1\u0dc0\u0dcf. \u0d92 \u0d9a\u0dd2\u0d85\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf, \u0dc1\u0dbd\u0ddd\u0dab\u0dc1\u0dda \u0dc1\u0dc0\u0db1 \u0d9a\u0dd2\u0dc3\u0dd2\u0db8 \u0da7 \u0db4 \u0dc1\u0db1\u0dcf\u0dab \u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dc1\u0dda \u0dc1\u0db6\u0dcf\u0dc1\u0dc4\u0dcf\u0db8 \u0d85\u0dc1\u0dd3\u0dbd\u0dcf\u0da0\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda\u0d9a\u0d85 \u0db4 \u0d85\u0dc0\u0d9c\u0db8\u0db1\u0d85 \u0dab \u0db1 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0db1\u0dcf\u0dd2\u0db6\u0dab\u0dcf \u0d85\u0dc1\u0db4\u0dcf \u0dc1\u0da7\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc1\u0dda \u0dad\u0dd2\u0dc3\u0dda\u0db1\u0dc0 \u0dc1\u0d9a\u0db1\u0dcf\u0db8 \u0d85\u0d9a\u0dc4\u0dc3\u0dda \u0db4\u0dca\u200d\u0dbb\u0dab\u0dcf \u0dab \u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0db1\u0dda, \u0d92 \u0d85\u0d85\u0da7 \u0dc3\u0db8 \u0d85\u0dd2 \u0dad\u0dd2\u0d85 \u0dc1\u0d9a\u0db1\u0dca\u0daf\u0db1 \u0db1\u0db1.. \u0dc3\u0db8\u0dc4 \u0dc0\u0dd2\u0da7 \u0d92 \u0dad\u0dd2\u0dc3\u0dda\u0db1\u0dc0 \u0dc1\u0d9a\u0db1\u0dcf\u0dc1\u0d9c\u0db1\u0dca\u0daf \u0d9a\u0dc4 \u0dc1\u0d9a\u0dc1\u0db1 \u0db4 \u0dc1\u0dc0\u0db1\u0dca\u0daf\u0db1 \u0dbb\u0db4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0daf \u0d85\u0d9a\u0dc4\u0dc3\u0dda \u0db4\u0dca\u200d\u0dbb\u0dab\u0dcf \u0dab \u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf. \u0db1\u0dd4\u0dc4\u0dca, \u0d92 \u0d85\u0d85\u0da7 \u0dc3\u0db8 \u0d85\u0dd2 \u0dad\u0dd2\u0d85 \u0dc1\u0d9a\u0db1\u0dca\u0daf\u0db1 \u0db1\u0db1.. \u0dc1\u0dab\u0ddd, \u0d92 \u0dc3\u0db8 \u0d85\u0dd2 \u0dad\u0dd2\u0d85?\n\n\u0d9a\u0da7\u0db1\u0dca\u0daf \u0dc1\u0d9c\u0db1\u0da7\u0dbd\u0dca\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0dc1\u0db1\u0dca\u0daf, \u0db8\u0da7\u0dad\u0dd2\u0dc0 \u0dad \u0dc0\u0dd2\u0d85\u0d9a\u0dda \u0dc3\u0dd3\u0db8\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3 \u0db8\u0da7 \u0db4\u0db1\u0dad \u0db4. \u0d92 \u0db4\u0db1\u0dad \u0dc1\u0d9c\u0db1\u0da7\u0dbd\u0dca\u0dbd\u0dcf \u0d85\u0dc1\u0db4\u0dcf \u0db4\u0dc2\u0dca\u0da8\u0dcf \u0dab\u0dc1\u0dc5\u0dda \u0dc1\u0db8\u0dcf\u0dab \u0db4\u0d9a? \u0d92 \u0db4\u0db1\u0dad \u0dad\u0db8\u0dd2 , 2023 \u0d85\u0d82\u0dab 3 \u0d9a \u0db1 \u0db8\u0da7\u0dad\u0dd2\u0dc0 \u0dad \u0dc0\u0dd2\u0d85\u0d9a\u0dda \u0db1\u0dd2\u0d85\u0dcf\u0db8\u0db1\u0d85 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dda \u0db4\u0db1\u0dad, \u0d9c\u0dbb\u0dd4 \u0dab\u0dae\u0dcf\u0db1\u0dcf\u0d85\u0dab\u0dd4\u0db8\u0db1\u0dd2. \u0dc1\u0dda \u0db4\u0db1\u0dad \u0dc1\u0d9c\u0db1\u0da7\u0dbd\u0dca\u0dbd\u0dcf \u0d85\u0dc1\u0db4\u0dcf \u0db4\u0dc2\u0dca\u0da8\u0dcf \u0dab\u0dc1\u0dc5\u0dda\u0db8 \u0db8\u0da7\u0dad\u0dd2\u0dc0 \u0dad\u0d85\u0dab\u0daf\u0dd3 \u0dc0\u0dd2\u0d85\u0d9a\u0dda \u0dab \u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0dc1\u0dab\u0dcf\u0dd2 \u0d86\u0dab\u0dcf \u0dc1\u0d85\u0db1\u0dca\u0daf\u0d9a, \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dd4\u0dc4\u0d9a\u0dbd\u0dca \u0d8b\u0db4\u0d85\u0dcf \u0d9c\u0dca\u0dc1\u0dca \u0dc1\u0dab\u0dcf\u0dc1\u0dc4\u0dcf\u0db8\u0d9a \u0d9a\u0dd2\u0d85\u0db1 \u0d91\u0dab \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0dab \u0d9c\u0da7\u0dd3\u0db8.\n\n\u0db8\u0da7 \u0db1\u0dda \u0dc1\u0dbd\u0dcf\u0dd4 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1\u0d85 \u0db4 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf, \u0d9c\u0dbb\u0dd4 \u0dab\u0dae\u0dcf\u0db1\u0dcf\u0d85\u0dab\u0dd4\u0db8\u0db1\u0dd2. \u0d92, \u0dc1\u0dda\u0dab\u0dd2 . \u0d94\u0db6\u0dd4\u0db8\u0dcf \u0db6\u0dbd\u0db1\u0dca\u0daf\u0db1, \u0dab\u0dc5\u0dd4 \u0dc3\u0dbd\u0dca\u0dd2, \u0db4\u0dcf\u0dad\u0dcf\u0dbd \u0dc3\u0dbd\u0dca\u0dd2, \u0dc3\u0dd6\u0dd4 \u0dc3\u0dbd\u0dca\u0dd2 \u0d9a\u0dbb\u0dd4 \u0dc1\u0dbd\u0dc3 \u0dc1\u0dda \u0db8\u0da7\u0dad\u0dd2\u0dc0 \u0dad\u0dc1\u0dda\u0daf\u0dd3 \u0dc3\u0da7\u0dbb\u0dd2\u0dc3 \u0db1 \u0d86\u0dab\u0dcf \u0d85. \u0d92, \u0dc1\u0dda \u0da7 \u0dc0\u0dd2\u0dd4\u0dad\u0dbd\u0dcf \u0dc3\u0dbd\u0dca\u0dd2 \u0d9c\u0db1\u0dca\u0daf\u0db1, \u0d85\u0db1\u0dcf\u0d9c\u0dad\u0dc1\u0dda \u0da7 \u0dc0\u0dd2\u0dd4\u0dad\u0db1\u0dca\u0daf\u0db1. \u0dc1\u0db8\u0dc1\u0dc4\u0db8 \u0d9c\u0dd2\u0dc1\u0d85\u0dcf\u0dca \u0dc1\u0dda \u0da7\u0da7 \u0d85\u0dca\u0dc0\u0db1 \u0d89 \u0dad\u0db8 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0d85\u0db1\u0dcf\u0d9c\u0dad\u0dc1\u0dda\u0daf\u0dd3 \u0dd4\u0dc4\u0dd4\u0dab\u0dad \u0dc1\u0d9a\u0db1\u0dca\u0daf\u0db1 \u0dc1\u0dc0\u0db1 \u0dc1\u0dda\u0d9a\u0dc0\u0dcf\u0da0\u0dab\u0d85\u0dca \u0db6 \u0db4\u0dad\u0dc5\u0dd2 . \u0d85\u0db4\u0dd2 \u0d85\u0dc0\u0dc1\u0db6\u0ddd\u0db0\u0dca\u200d \u0dab \u0d9c\u0db1\u0dca\u0daf\u0db1 \u0db1\u0db1., \u0dd2\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4 \u0dc0\u0dd2\u0db3\u0dd2\u0db1 \u0dd4\u0dab. \u0d9c\u0dbb\u0dd4 \u0dab\u0dae\u0dcf\u0db1\u0dcf\u0d85\u0dab\u0dd4\u0db8\u0db1\u0dd2, \u0dc1\u0dda \u0dc1\u0da7\u0dca \u0d89\u0dc4\u0dc5 \u0dad\u0dbd\u0d85 \u0dc4\u0d9a\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0db1\u0da7\u0dad\u0dd2\u0dc0 \u0dc1\u0db8\u0dcf\u0db1 \u0dc3\u0da7\u0dbd\u0dc3\u0dd4\u0dda \u0dc1\u0d9c\u0db1\u0dcf\u0dc0\u0dca \u0dc4\u0dbb\u0dd2\u0d85\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0db1\u0da7\u0dc4\u0da7. \u0dc0\u0dd2\u0db0\u0dca\u200d\u0dcf\u0d85\u0dab \u0dba\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0d85 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dab\u0dbd\u0dca \u0dc1\u0db8\u0dcf\u0dab \u0db4\u0d9a \u0dc1\u0dc0\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf? \u0dc1\u0db4\u0dcf\u0dbd\u0dca \u0d9c\u0dc4\u0da7 \u0dc1\u0d9a\u0dbd\u0dca \u0d9c\u0dc4 \u0d9a\u0dd2\u0d85\u0db1, \u0dc1\u0db4\u0dcf\u0dbd\u0dca \u0d9c\u0dc4\u0da7 \u0dc1\u0dab\u0dcf\u0dc3\u0dda \u0d9c\u0dc4\n\n\u0d9a\u0dd2\u0d85\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0d85 \u0db4 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf. \u0dc0\u0dba\u0dc0\u0dc3\u0dda\u0dae\u0dcf\u0d9a\u0dcf\u0d85\u0dab\u0d85\u0da7 -\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7- 225\u0dc1\u0d9a\u0dc1\u0db1 \u0db4 \u0db4\u0dca \u0dc1\u0dc0\u0dbd\u0dcf \u0d86\u0dc0\u0dcf\u0da7 \u0dc0\u0da7\u0da9 \u0db4 \u0db1\u0da7\u0dc4\u0da7. \u0dc1\u0dda\u0dc0\u0dcf \u0dbb\u0dd6\u0dab\u0da9! \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dad\u0db8\u0dd2 \u0dc1\u0dda \u0da7 \u0db1\u0da7\u0dad\u0dd2 \u0dcf\u0d82\u0d9c\u0dc3\u0dda\u0dae\u0dcf\u0db1 \u0dc0\u0dd4\u0dc1\u0dab\u0dca. \u0d92 \u0dc1\u0dab\u0dc1 \u0dc4\u0dd2 \u0d94\u0db6\u0dd4\u0db8\u0dcf\u0dc1\u0dda \u0d85\u0dc0\u0db0\u0dca\u200d\u0dcf\u0db1\u0d85 \u0dad\u0db6\u0dcf\u0d9c\u0db1\u0dca\u0daf\u0db1 \u0d9a\u0dd2\u0d85\u0db1 \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8 \u0db8\u0db8 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1\u0d85\u0db1\u0dca\u0daf\u0db8 \u0dab \u0db1\u0dc0\u0dcf. \u0d9c\u0dbb\u0dd4 \u0dab\u0dae\u0dcf\u0db1\u0dcf\u0d85\u0dab\u0dd4\u0db8\u0db1\u0dd2, \u0db8\u0da7 \u0dad\u0dc0 \u0dc0\u0dd2\u0db1\u0dcf\u0da9\u0dd2 \u0dc1\u0d9a\u0dab \u0db4 \u0dc1\u0d9a\u0db1\u0dca\u0daf\u0db1."
