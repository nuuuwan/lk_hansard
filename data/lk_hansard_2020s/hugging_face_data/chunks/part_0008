    "chunk_text": "\u0d85\u0db4\u0dd2 \u0dbb\u0ddc\u0da2\u0dba \u0d86\u0dbb\u0da0\u0daf\u0ddc\u0dba\u0db8 \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0db1\u0dca \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0db6\u0dd0\u0dbd\u0dd4\u0dc1\u0dc0\u0ddc\u0dad\u0dca, \u0daf\u0dc5 \u0dc1\u0dda\u0dc1\u0dd3\u0dba \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0ddc\u0daf\u0dd2\u0dad\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2 \u0dad\u0dba\u0d9a\u0dca \u0dc1\u0dbd\u0dc3 \u0dc3\u0dd2\u0dba\u0dba\u0da7 8.3\u0d9a\u0da7 \u0dc0\u0dd0\u0da7\u0dd3 \u0dad\u0dd2\u0dd4\u0dab\u0dd4 \u0d86\u0dbb\u0da0\u0daf\u0ddc\u0dba\u0db8 \u0d85\u0db4\u0dd2 \u0daf\u0dd0\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 12 \u0daf\u0d9a\u0dca\u0dc0\u0ddc \u0dc1\u0d9c\u0db1\u0dd0\u0dbd\u0dca\u0da7\u0dbd\u0ddc \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0ddc. \u0d92 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0dc1\u0d9c\u0db1\u0dd0\u0dbd\u0dca\u0da7\u0dbd\u0ddc \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db4\u0dd3\u0da9\u0ddc\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0dc3\u0db8\u0ddc\u0da2\u0dba\u0d9a \u0da2\u0dd3\u0dc0\u0dad\u0dca \u0dc0\u0db1 \u0da2\u0db1\u0dad\u0ddc\u0dc0\u0dc1\u0d9c\u0db1\u0dca \u0db6\u0dd4 \u0d86\u0dbb\u0da0\u0daf\u0ddc\u0dba\u0db8\u0dca \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0db1\u0dca. \u0dc1\u0db8\u0dca\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dc1\u0dbd\u0dca\u0da7\u0dc3\u0dd2 \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0db1\u0dd2\u0dc3\u0ddc \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0dca \u0dc3\u0db8\u0dc3\u0dca\u0dad \u0da2\u0db1\u0dad\u0ddc\u0dc0\u0da7 \u0dc3\u0dca\u0dad\u0dd4\u0dad\u0dd2\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1, \u0dd2\u0dc3 \u0db1\u0db8\u0ddc \u0d86\u0dbb\u0da0\u0da0\u0ddc\u0dbb \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dc1\u0db8\u0ddc\u0db1 \u0dad\u0dbb\u0db8\u0dca \u0db6\u0dbd\u0db4\u0dd1\u0db8\u0dca \u0d9a\u0dc5\u0dad\u0dca \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0dc0\u0dd2 \u0dca\u0dc0\u0ddc\u0dc3\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dd4\u0dab\u0ddc \u0dc1\u0db8\u0dca \u0db1\u0ddc\u0dba\u0d9a\u0dba\u0ddc \u0dc1\u0db8\u0dca \u0dbb\u0da7 \u0dc1\u0d9c\u0ddc\u0da9 \u0d9c\u0db1\u0dd2\u0dba\u0dd2, \u0d85\u0db4\u0dd2 \u0d89\u0dc0\u0dc3\u0ddc\u0dc1\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dba\u0dbd\u0ddc. \u0d92 \u0db1\u0dd2\u0dc3\u0ddc\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0db1\u0ddc\u0dba\u0d9a\u0dba\u0ddc\u0da7 \u0dc1\u0db8\u0dca \u0d9c\u0db8\u0db1 \u0dc1\u0db8\u0dc1\u0dad\u0d9a\u0dca \u0d91\u0db1\u0dca\u0db1 \u0dbd\u0dd0\u0dd4\u0dc1\u0dab\u0dca. \u0d86\u0dbb\u0da0\u0dab\u0dca\u0dd4 \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0d9c\u0dad\u0dca\u0dad\u0dad\u0dca \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0d9a\u0dae\u0ddc\u0db1\u0ddc\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0d92 \u0dad\u0dd4\u0dc5 \u0dc0\u0dd2\u0dc0\u0dd2 \u0db8\u0dad \u0dad\u0dd2\u0dd4\u0dab\u0ddc. \u0db8\u0da7 \u0db8\u0dad\u0d9a\u0dba\u0dd2, \u0d85\u0db4\u0dd2 \u0db6\u0dd4 \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0ddc \u0d9a\u0dbb\u0dda\u0daf\u0dd2 \u0dc3\u0db8\u0dc4\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db6\u0dbd \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4 \u0da2\u0db1\u200d\u0dbb\u0dd2\u0dba\u0dad\u0ddc\u0dc0 \u0d9c\u0dd0\u0db1 \u0dd2\u0dad\u0dbd\u0ddc\u0daf \u0daf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0, \"\u0d85\u0db4\u0dd2 \u0db1\u0db8\u0dca \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0dbd\u0dd2\u0d9a\u0dc0 \u0dc1\u0db8\u0dca\u0d9a\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0dda \u0dba\u0dd2\" \u0d9a\u0dd2\u0dba\u0dbd\u0ddc \u0db8\u0ddc \u0dba\u0dc0\u0dbd\u0da7 \u0d9a\u0dd2\u0dda\u0dc0\u0ddc. \u0d85\u0db4\u0dd2 \u0d9a\u0dc0\u0daf\u0ddc\u0d9a\u0dc0\u0dad\u0dca \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0db1\u0dca \u0db6\u0dda\u0daf\u0d9a\u0dca \u0db4\u0db1\u0dc0\u0dbd\u0ddc \u0db1\u0dd0\u0dc4\u0dd0, \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0d9a\u0dae\u0ddc\u0db1\u0ddc\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0dbb\u0dc1\u0dca \u0d85\u0dc0 \u0dba\u0dad\u0ddc\u0dc0 \u0d85\u0db1\u0dd4\u0dc0\u0dba\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc1\u0dc5\u0dca.\n\n799 800\n\n2024 \u0dc3\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0db8\u0dca\u0db6\u0db0\u0db1 04\n\n\u0d92 \u0dc0\u0ddc\u0dc1\u0dda\u0db8 \u0d85\u0db0\u0db1\u0dd4\u0daf\u0dba\u0da7 \u0dc0\u0d9c\u0d9a\u0dd3\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca \u0dc1\u0dba\u0db1\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0db8\u0dba \u0dad\u0dd3\u0db1\u0dca\u0dd4 \u0dc0\u0d9a\u0dca \u0d86\u0dbb\u0da0\u0dc0\u0ddc, \u0d86\u0dbb\u0da0\u0dab\u0dca\u0dd4 \u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda \u0d9a\u0dab\u0dca\u0da9\u0ddc\u0dba\u0db8\u0d9a\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0. \u0d92 \u0dc0\u0ddc\u0dc1\u0dda\u0db8 \u0da2\u0db1\u0dad\u0ddc\u0dc0 \u0dad\u0dd4\u0dc5 \u0daf\u0dd0\u0dc0\u0dd0\u0db1\u0dca\u0dad \u0db8\u0dad\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dd4\u0dab\u0ddc, \u0d92 \u0d9a\u0dab\u0dca\u0da9\u0ddc\u0dba\u0db8 \u0dc1\u0db8\u0dca\u0d9a\u0da7 \u0dc0\u0d9c \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dba\u0dbd\u0ddc. \u0dc1\u0db8\u0dca \u0dc3\u0dd2\u0dba\u0dbd\u0dca\u0da7\u0dbd \u0d91\u0d9a\u0dca\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4 \u0dc1\u0daf\u0d9a\u0d9a \u0d9a\u0ddc\u0dbd\u0dba \u0dad\u0dd4\u0dc5 \u0dc1\u0db8\u0dca \u0dbb\u0da7 \u0dc1\u0db8\u0dad\u0dd0\u0db1\u0da7 \u0dc1\u0dda\u0db1\u0dca\u0db1 \u0dc3\u0dca\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0d9a\u0db8 \u0dbd\u0dd0\u0dd4\u0dc1\u0dab\u0dca. \u0d92, \u0dc1\u0db8\u0dca \u0db1\u0ddc\u0dba\u0d9a\u0dba\u0ddc\u0dc1\u0dda \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dc3\u0dd4\u0dc0\u0dd2\u0dc1 \u0dca\u0da7\u0dca \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0ddc\u0dc0, \u0daf\u0d9a\u0dca\u0dc2\u0dad\u0ddc\u0dc0, \u0d89\u0dc0\u0dc3\u0dd3\u0db8, \u0db4\u0dc5\u0dc3\u0dca\u0dbb\u0dd4\u0dda\u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d92\u0dc0\u0ddc\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0d91\u0dad\u0dd4\u0db8\u0ddc\u0dc1\u0dda \u0dc5\u0dd2\u0db1\u0db1\u0dca\u0db8 \u0dc3\u0dd2\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca, \u0dbb\u0ddc\u0da2\u0dba \u0d86\u0dbb\u0da0\u0daf\u0ddc\u0dba\u0db8\u0dca \u0dc1\u0dc3\u0db8 \u0dc1\u0db8\u0dca \u0dbb\u0ddc\u0da2\u0d9a\u0ddc\u0dd2\u0db4\u0dc1\u0dda \u0dc1\u0dba\u0dd4 \u0dab\u0dd4 \u0dbb\u0ddc\u0da2\u0dba \u0d85\u0db8\u0ddc\u0dad\u0dba\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0db8\u0db8 \u0dc1\u0db8\u0dca \u0dbb\u0da7\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d85\u0dc0 \u0dba\u0dba\u0dd2, \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0d9a\u0dae\u0ddc\u0db1\u0ddc\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2."
  },
