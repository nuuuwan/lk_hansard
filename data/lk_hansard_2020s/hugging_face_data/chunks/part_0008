    "chunk_text": "\" \u0da7\u0dab \u0db1\u0dcf\u0d85\u0dab\u0dca\u0dc0\u0d85\u0da7 \u0db4\u0dca \u0dc0\u0dd2\u0d85 \u0dd4\u0dad\u0dca\u0dc1\u0dca \u0dc0\u0dd2 \u0dda\u0dc0\u0dcf\u0dc3\u0d85\u0dca, \u0dc0\u0db0\u0dca\u200d\u0dbb\u0dca\u0dbd\u0d85\u0d85\u0dca, \u0db1\u0dd2\u0d9a\u0dc4\u0dc3\u0dca, \u0d85\u0db1\u0dcf\u0d9c\u0dad\u0d85\u0dca \u0d9c\u0da7\u0db1 \u0dc3\u0dd2\u0dc4\u0dd2\u0db1 \u0db8\u0dc0\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dd4 \u0db4\u0db8\u0dad\u0dd2 \" \u0d85\u0db1\u0dca\u0daf\u0db1\u0dd2 \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0db6\u0dbd \u0dc1\u0d9a\u0db8\u0dc5 \u0dab\u0dc0\u0dd2\u0dc1\u0d85\u0dd4 \u0dc0\u0db1 \u0dc0\u0dbd\u0dca\u0dd4 \u0dc0\u0dbb\u0dca\u0dbd \u0d9a\u0dd2\u0d85\u0dcf \u0dc3\u0dd2\u0dc0\u0dc1\u0dda. \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0daf\u0dd3\u0dd4\u0db8\u0db1\u0dd2, \u0d94\u0db6\u0dd4\u0db8\u0dcf \u0dc1\u0dda \u0dc3\u0dcf\u0dcf\u0dc1\u0dda \u0dd4\u0dc4\u0dbd\u0dc3\u0dd4\u0db1 \u0d9a \u0db1 \u0dc1\u0dda \u0d85\u0dc0\u0dc3\u0dda\u0dae\u0dcf\u0dc1\u0dda, \u0db8\u0dcf\u0dc1\u0dda \u0dc1\u0dd2 \u0d85, \u0d94\u0db6\u0dc1\u0dda \u0dc1\u0dd2 \u0d85 \u0dc3\u0dd2\u0dda \u0db8\u0d82\u0dc3\u0dbd\u0dab \u0d9a\u0dd4\u0db3\u0dd3 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dc1\u0db8\u0dcf\u0dc1\u0dc4\u0dcf\u0dad\u0dab, \u0d91 \u0db4\u0dad \u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0d85\u0dab \u0dc3\u0dd2\u0dda\u0dc1\u0dab\u0dcf\u0db1\u0dca\u0daf \u0dc3\u0da7\u0db1\u0dab \u0dc1\u0d85\u0daf\u0dd3 \u0dc3\u0dd2\u0dc0\u0db1 \u0dc1\u0db8\u0dcf\u0dc1\u0dc4\u0dcf\u0dad\u0dab \u0dba\u0dcf\u0dad\u0dd2\u0dab \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0dab\u0d85\u0dca, \u0d91\u0db1\u0dd2 \u0db1\u0dca\u0daf \u0d85\u0d9a\u0dcf\u0dc5 \u0dc0\u0db1 \u0dc0 \u0dcf\u0d85 \u0db1\u0d9c \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0d85\u0dca \u0db4\u0dd2\u0dd2\u0db6\u0db6\u0db3\u0dc0 \u0dc0\u0da0\u0db1 \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0d85 \u0db4 \u0dab\u0dae\u0dcf \u0dab \u0db1\u0dca\u0daf\u0db1\u0da7 \u0dbd\u0da7\u0dd3 \u0db8 \u0db8\u0dcf \u0dcf\u0dcf\u0d9c\u0dba\u0d85 \u0db4 \u0dc4\u0da7\u0dc0\u0d85\u0da7 \u0dc3\u0dbd\u0dab\u0db1\u0dc0\u0dcf. \u0db8\u0db1\u0dca\u0daf\u0d9a \u0d85\u0dca, \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0d85 \u0dc1\u0dc0\u0db1\u0dc3\u0dda \u0dc1\u0dc0\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0dab\u0dd2 \u0d85\u0db1\u0dcf\u0d85\u0dab\u0dbd\u0dcf\u0dc1\u0d9c\u0db1\u0dca\u0daf \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dd2 . \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0d85 \u0dc1\u0dc0\u0db1\u0dc3\u0dda \u0dab \u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0dbb\u0db4\u0dad\u0dcf\u0dc1\u0dad\u0ddd\u0dbd\u0dcf \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dd2 . \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0d85 \u0dc1\u0dc0\u0db1\u0dc3\u0dda \u0dc1\u0dc0\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0dc3\u0dd2\u0da7\u0dcf\u0dc1\u0dad\u0ddd\u0dbd\u0dcf\u0dc1\u0d9c\u0db1\u0dca\u0daf \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dd2 . \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0d85 \u0dc1\u0dc0\u0db1\u0dc3\u0dda \u0dc1\u0dc0\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0dc0\u0da7\u0da9 \u0dab \u0db1 \u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca\u0daf\u0dc1\u0d9c\u0db1\u0dca\u0daf, \u0dad\u0dd3 \u0dad \u0d9c\u0db1\u0dca\u0daf\u0db1 \u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca\u0daf\u0dc1\u0d9c\u0db1\u0dca\u0daf, \u0dc0\u0db0\u0dca\u200d\u0dbb\u0dca\u0dbd\u0d85\u0d85 \u0d87\u0dad\u0dd2 \u0db1\u0dcf\u0d85\u0dab\u0d85\u0db1\u0dca\u0daf\u0dc1\u0d9c\u0db1\u0dca\u0daf \u0db6\u0dc0 \u0dd4\u0dc4\u0dc5\u0dd4 \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0d85 \u0dbb\u0db4 \u0dcf\u0db8 \u0dc1\u0dd2 \u0db4\u0dcf\u0dbd\u0db1 \u0dc0\u0dd2\u0d9a\u0dba\u0dcf\u0dc0 \u0d89\u0dc1\u0d9c\u0db1 \u0d9c\u0db1\u0dca\u0daf\u0db1\u0dcf, \u0d8b\u0d9c\u0db1\u0dca\u0daf\u0dc0\u0db1 \u0d85\u0db4 \u0d9a\u0db1\u0dca\u0daf\u0db1\u0dc0\u0dcf.\n\n567 568\n\n[\u0d9c\u0dbb\u0dd4 \u0d91\u0dda.\u0d91\u0dc3\u0dda. \u0dad\u0dda\u0dc6\u0dd2 \u0db4 \u0db8\u0dc4\u0dad\u0dcf]\n\n2024 \u0d85\u0dc1\u0d9c\u0ddd\u0dc3\u0dda\u0dd4 21\n\n\u0db4\u0da7\u0dc4\u0da7\u0daf\u0dd2\u0dd2 \u0db4\u0dab\u0dd2\u0dc0\u0dd4\u0da9\u0d85 \u0db4 \u0dbd\u0da7\u0db6\u0dd4\u0dad\u0dcf, \"\u0dc1\u0dda \u0da7 \u0dc1\u0dda \u0dcf \u0d9c\u0db1\u0dca\u0daf\u0db1\u0da7 \u0db1\u0dda \u0dbd\u0db6\u0db1 21\u0dc0\u0da7\u0db1\u0dd2 \u0d9a\u0dcf \u0d85\u0db4\u0dd2 \u0da1\u0db1\u0dca\u0daf\u0d9a\u0d85 \u0dc1\u0d9a\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0db1\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dd2\u0d82\u0dc4 \u0d9a\u0dd2\u0d85\u0db1 \u0d85 \u0da2\u0dad \u0db1\u0dcf\u0d85\u0dab\u0d85\u0dcf\u0da7 \u0db4\u0db8\u0dad\u0dd2 \" \u0d9a\u0dd2\u0d85\u0dbd\u0dcf. \u0db8\u0db1\u0dca\u0daf\u0d9a? \u0db8\u0dad\u0dab \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dab\u0dcf\u0dbd\u0d85\u0dab\u0da7 \u0dc1\u0db4\u0dcf\u0dc1\u0dc4\u0dcf \u0dc0\u0dbd\u0da7 \u0dc1\u0db4\u0dcf \u0db6\u0da7\u0dd2\u0dc1\u0dd2 \u0db1\u0da7\u0dad\u0dd2 \u0db6\u0dc0\u0dd2 \u0d92 \u0dba\u0db1\u0dad\u0dcf\u0dc0 \u0d9a\u0dd2\u0dda\u0dc1\u0dda.\n\n\u0db8\u0dad\u0dab \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dab\u0dcf\u0dbd\u0d85\u0dab \u0d85\u0db3\u0dd4\u0dbb\u0dd4 \u0dd4\u0dad\u0d9c\u0d85 \u0db4 \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0dab\u0dca \u0db1\u0da7\u0dad\u0dd2 \u0db6\u0dc0 \u0d92 \u0d85\u0d85 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0db8\u0dad\u0dab \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dab\u0dcf\u0dbd\u0d85\u0dab \u0db4\u0da7\u0d85 14\u0dab\u0da7\u0dca \u0dc0\u0da9\u0dcf \u0dc0\u0dd2\u0dd4\u0dd2\u0d85 \u0db1\u0da7\u0dad\u0dd2\u0dc0 \u0d8b\u0dc1\u0dd2 \u0dc4\u0dc0\u0dc3 \u0db1\u0dd2 , \u0dc1\u0db4\u0dcf\u0dc5\u0d9f\u0dd4\u0db1\u0dca\u0daf, \u0d85\u0dd2-\u0d87\u0dd4\u0db1\u0dca\u0daf \u0d89\u0db1\u0dca\u0daf\u0db1 \u0d9c\u0dda\u0db8\u0dcf\u0db1 \u0dc4 \u0dc4\u0dcf \u0d9c\u0db8\u0db1\u0dca\u0daf \u0dab \u0db1\u0dca\u0daf\u0db1\u0da7 \u0dc3\u0dd2\u0dd4 \u0dc1\u0db1\u0dcf\u0dc0\u0dd4 \u0db6\u0dc0 \u0d92 \u0dba\u0db1\u0dad\u0dcf\u0dc0 \u0d85\u0db4\u0da7 \u0d9a\u0dd2\u0d85\u0dcf \u0dc3\u0dd2\u0dc0\u0d85\u0dcf. \u0d92 \u0dad\u0dca\u0dca\u0dc0\u0d85 \u0dc1\u0dc0\u0db1\u0dc3\u0dda \u0dab \u0d8b\u0dc1\u0dd2 \u0dd4\u0dbb\u0dd4\u0dd4 \u0dc4\u0dac\u0dd2\u0db1\u0dca\u0daf \u0db1\u0da7\u0d9f\u0dd2\u0dc0\u0db1 \u0d85\u0db4\u0da7 \u0db6\u0dd4\u0dd4 \u0db4\u0dc4\u0db1 \u0db4\u0dca\u0dd4 \u0dab \u0d9a\u0dc0\u0dc1\u0dc3\u0dda \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dbb\u0dca\u0dbd\u0dae\u0db1\u0d85 \u0dab \u0db1\u0dca\u0daf\u0db1\u0da7\u0dca, \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dbb\u0dca\u0dbd\u0dae\u0db1\u0d85 \u0d85\u0dc1\u0db4\u0dcf \u0dd4\u0dc0\u0dcf \u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0daf\u0da7\u0dca, \u0dc3\u0db8\u0dcf\u0dba\u0d85\u0da7\u0dca \u0dc1\u0d85\u0dcf\u0dd4\u0dc4 \u0dab \u0db1\u0dca\u0daf\u0db1\u0da7 \u0dbb\u0db4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0daf \u0dc0\u0db1 \u0db1\u0dd2\u0d9a\u0dc4\u0dc3\u0dda \u0dc3\u0db8\u0dcf\u0dba\u0d85 \u0db4 \u0d87\u0dad\u0dd2 \u0dab \u0dbb\u0db4 \u0db1\u0dcf\u0d85\u0dab\u0d85\u0dcf \u0dc3\u0db8\u0d9f \u0d85\u0db4\u0dd2 \u0dc4\u0dd2\u0da7\u0d9c\u0db1\u0dca\u0daf\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0d85\u0dbd\u0dcf\u0dd2 \u0d92 \u0d85\u0d85 \u0d9a\u0dd2\u0d85\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf."
  },
