85\u0db8\u0ddc\u0dad\u0dba\u0dad\u0dd4\u0db8\u0ddc\u0dc1\u0d9c\u0db1\u0dca \u0d87\u0dd6 \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0dba - (1) :\n\n(\u0d85) (i) \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0ddc\u0dc1\u0dda \u0d9c\u0dd8\u0dc4\u0dc3\u0dca\u0dae \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc1\u0dbd\u0dc3 \u0dc1\u0dc3\u0dca\u0dc0\u0dba\n\n\u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc3\u0dca\u0dda\u0d9c\u0dbd\u0dba\u0db1\u0dca\u0dc1\u0dda \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dc1\u0daf\u0db4\u0ddc\u0db0\u0db1\u0dad\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc3\u0dad\u0dd4\u0dc0 \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca\u0daf;\n\n(ii) \u0d91\u0dc1\u0dc3\u0dca \u0db1\u0db8\u0dca, \u0dc1\u0db8\u0dca \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0ddc\u0dc1\u0dda \u0dc1\u0dc3\u0dca\u0dc0\u0dba \u0d9a\u0dbb\u0db1\u0dd4\n\n\u0dbd\u0db6\u0db1 \u0d9c\u0dd8\u0dc4\u0dc3\u0dca\u0dae \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0d82\u0d9b\u0dba\u0ddc\u0dc0 \u0dc1\u0d9a\u0ddc\u0db4\u0db8\u0dab\u0daf;\n\n(iii) \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0d86\u0dbb\u0da0\u0dbb\u0d9a\u0dca\u0dc2\u0ddc\u0dc0 \u0dc3\u0dc4 \u0dbb\u0dd0\u0d9a\u0dc0\u0dbb\u0dab\u0dba \u0dc3\u0db3\u0dc4\u0ddc \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dc1\u0daf\u0db4\u0ddc\u0db0\u0db1\u0dad\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc1\u0d9c\u0db1 \u0d87\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0ddc\u0db8\u0ddc\u0db0\u0db1\u0d9c \u0d9a\u0dc0\u0dc1\u0db0\u0db1\u0daf;\n\n\u0dba\u0db1\u0dca\u0db1 \u0d91\u0dad\u0dd4\u0db8\u0ddc \u0dc1\u0db8\u0db8 \u0dc3\u0db7\u0ddc\u0dc0\u0da7 \u0daf\u0db1\u0dca\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca\u0daf?\n\n(\u0d86\u0dbb\u0da0) \u0dc1\u0db1\u0ddc\u0d91\u0dc1\u0dc3\u0dca \u0db1\u0db8\u0dca, \u0d92 \u0db8\u0db1\u0dca\u0daf?\n\n\u0ba4\u0ba4\u0bbe\u0bc8\u0bbf\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bb5\u0bb3\u0bbf\u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb2\u0bb5\u0b95\u0bb2\u0bb5\u0bbe\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bc1 \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a \u0b95\u0bb0\u0b95\u0bcd \u0bb2\u0b95\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0ba9\u0bbe:\n\n(\u0b85) (i) \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0b95\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb2\u0bb5\u0b95\u0bb2\u0baf\u0bbe\u0b9f\u0bcd\u0b95\u0bb3\u0bbe\u0b95 \u0baa\u0ba3\u0bbf \u0baf\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b86\u0b9f\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0ba4\u0bbe\u0bc8\u0bbf\u0bb2\u0bcd \u0ba4\u0bbf\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bbe \u0b8e\u0ba9\u0bcd\u0baa\u0b95\u0ba4\u0baf\u0bc1\u0bae\u0bcd;"
