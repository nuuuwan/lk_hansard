    "chunk_text": "\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0ddc\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda\u0daf \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dc1\u0dc3\u0ddc\u0dba\u0ddc \u0db6\u0dbd\u0ddc \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db1\u0dd2\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0dc4\u0ddc \u0db1\u0dd2\u0db0\u0db1\u0dc1\u0dda \u0db4\u0ddc\u0db0\u0db1\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0d89\u0daf\u0dd2\u0dd2\u0db4\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0ddc \u0dc0\u0db1 \u0dc0\u0dd2\u0dc1 \u0dca\u0dc2 \u0d9a\u0ddc\u0dbb\u0d9a \u0dc3\u0db7\u0ddc\u0dc1\u0dda \u0dc3\u0db7\u0ddc\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0ddc \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0db8\u0db8 \u0d91\u0d9a\u0dd3 \u0dc0\u0dd2\u0dc1 \u0dca\u0dc2 \u0d9a\u0ddc\u0dbb\u0d9a \u0dc3\u0db7\u0ddc\u0dc1\u0dda \u0dc0\u0ddc\u0db0\u0db1\u0dad\u0ddc\u0dc0 \u0dc3\u0dc4 \u0d91\u0dd2 \u0d9a\u0ddc\u0db0\u0db1\u0dba \u0dc3\u0da7\u0dc4\u0db1\u0dca \u0dc3\u0db7\u0ddc\u0d9c\u0dad \u0d9a\u0dbb\u0db8\u0dd2.\n\n\u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0ddc\u0db1\u0ddc\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0db8\u0da7 \u0dc0\u0dd2\u0db1\u0ddc\u0da9\u0dd2\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0ddc \u0dc1\u0daf\u0db1\u0dca\u0db1, \u0dc1\u0db8\u0dca \u0d9a\u0ddc\u0dbb\u0d9a \u0dc3\u0db7\u0ddc\u0dc0\u0da7 \u0dc3\u0dc4\u0db7\u0ddc\u0d9c\u0dd2 \u0db1 \u0db6\u0ddc\u0dd2\u0dbb \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca\u0daf\u0ddc\u0dba\u0d9a\u0dba\u0db1\u0dca\u0dc1\u0dda \u0dc1\u0dba\u0ddd\u0da2\u0db1\u0ddc\u0dc0\u0d9a\u0dca \u0d89\u0daf\u0dd2\u0dd2\u0db4\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0ddc. \u0d85\u0daf \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0dca \u0da2\u0ddc\u0dad\u0dd2\u0dba \u0dc4\u0db8\u0dd4\u0dc1\u0dda \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db4\u0dca\u200d\u0dbb \u0ddc\u0db1\u0dad\u0db8 \u0d8b\u0dc0\u0dd4 \u0dbb, \u0d91\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0d85\u0dd2\u0dc1\u0dba\u0ddd\u0d9c\u0dba \u0dad\u0db8\u0dba\u0dd2 \u0db8\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dba \u0dc0\u0dba\u0ddc\u0db4\u0dca\u0dad\u0dd2\u0dba. \u0db8\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dba \u0dc0\u0dd0\u0dc5\u0dd0\u0d9a\u0dca\u0db8 \u0db8 \u0dc3\u0db3\u0dc4\u0ddc \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0ddc\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0db1 \u0dbb\u0da2\u0dc1\u0dda \u0d86\u0dbb\u0da0\u0dba\u0dad\u0db1 \u0dc3\u0dc4 \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0dbd\u0dd2\u0d9a \u0d86\u0dbb\u0da0\u0dba\u0dad\u0db1 \u0dc1\u0db1\u0ddc\u0dc0\u0db1\u0dca\u0db1\u0da7 \u0dc1\u0db8\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0dad\u0dc0\u0dad\u0dca \u0dc1\u0db6\u0ddc\u0dc1\u0dc4\u0ddd \u0db6\u0dbb\u0db4\u0dad\u0dc5 \u0dc1\u0dc0\u0db1\u0dca\u0db1\u0da7 \u0d89\u0da9 \u0dad\u0dd2\u0dd4\u0dab\u0ddc. \u0dc4\u0dd2\u0db4\u0dc4\u0db8\u0db1\u0dca \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0d9a\u0dca \u0db1\u0dd0\u0dad\u0dad\u0dca \u0db4\u0ddc\u0dc3\u0dbd\u0dca\u0da7 \u0dc5\u0db8\u0dba\u0dd2\u0db1\u0dca \u0dc0\u0dd2 \u0ddc\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8\u0ddc\u0dab\u0dba\u0d9a\u0dca \u0d85\u0dba\u0dd2\u0dc3\u0dca \u0dc0\u0dd0\u0db1\u0dd2 \u0db8\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dba\u0dc0\u0dbd\u0da7 \u0dc1\u0d9c\u0ddc\u0dd4 \u0dbb\u0dd4 \u0dc1\u0dc0\u0dbd\u0ddc \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0ddc. \u0db1\u0d9c\u0dbb\u0dc1\u0dda \u0dc1\u0db8\u0db1\u0dca\u0db8 \u0d9c\u0dc1\u0db8\u0dca\u0dad\u0dca, \u0d9a\u0ddc\u0db1\u0dca\u0dad\u0ddc, \u0db4\u0dd2\u0dd2\u0db4\u0db8\u0dd2, \u0dc5\u0db8\u0ddc, \u0db6\u0ddc\u0dbd, \u0db8\u0dc4\u0dbd\u0dd4, \u0dc0\u0dd0\u0da9\u0dd2\u0dd2\u0da7\u0dd2 \u0dc1\u0dda\u0daf\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0dad\u0ddc\u0dbb\u0dc0 \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4\u0dad\u0dca \u0dc1\u0db8\u0dca \u0db8\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dba \u0d8b\u0dc0\u0dd4 \u0dbb\u0da7 \u0db7\u0ddc\u0da2\u0db1 \u0dc1\u0dc0\u0dbd\u0ddc \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0ddc. \u0d92 \u0db1\u0dd2\u0dc3\u0ddc \u0dad\u0db8\u0dba\u0dd2 \u0db4\u0ddc\u0dc3\u0dbd\u0dca\u0da7 \u0dc0\u0dd2\u0dc1\u0dda \u0dc3\u0dd2\u0da7\u0db8 \u0db8\u0dad\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0dbb\u0da7\u0d9a\u0dca, \u0dc3\u0db8\u0ddc\u0da2\u0dba\u0d9a\u0dca, \u0dc3\u0dca\u0dda\u0d9c\u0dbd\u0dc1\u0dba\u0d9a\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9a\u0dbd\u0dca\u0da7\u0db4\u0db1\u0ddc \u0d9a\u0dbb\u0dc3\u0dca, \u0d92 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dc3\u0da2\u0dd3\u0db8 \u0dc0 \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0dc0\u0dd4\u0dab\u0dd4 \u0dc3\u0dca\u0dda\u0d9c\u0dbd\u0dc1\u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0db8\u0db8\u0dad\u0dca, \u0dad\u0dc0\u0dad\u0dca \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0db4\u0dd2\u0dd2\u0db4\u0dc3\u0d9a\u0dd4\u0dad\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc1\u0db8\u0dca \u0dc0\u0dd2\u0dc1 \u0dca\u0dc2 \u0d9a\u0ddc\u0dbb\u0d9a \u0dc3\u0db7\u0ddc\u0dc0 \u0d89\u0dbd\u0dca\u0da7\u0dbd\u0ddc \u0dc3\u0dd2\u0da7\u0dd2\u0dc1\u0dda. \u0dc1\u0db8\u0db8 \u0d9a\u0ddc\u0dbb\u0d9a \u0dc3\u0db7\u0ddc\u0dc0 \u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9c\u0dd0\u0db1 \u0d85\u0db4\u0dd2 \u0dc1\u0db6\u0dc1\u0dc4\u0dc0\u0dd2\u0db1\u0dca\u0db8 \u0dc3\u0dad\u0dd4\u0da7\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc. \u0db8\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dba \u0db4\u0ddc\u0dbd\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0ddc \u0dc0\u0d9c\u0d9a\u0dd2\u0dba\u0db1 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dbb\u0ddc\u0da2\u0dba \u0d86\u0dbb\u0da0\u0dba\u0dad\u0db1, \u0d92 \u0dc0\u0ddc\u0dc1\u0dda\u0db8 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0db8 \u0dbb\u0ddc\u0da2\u0dba \u0dc1\u0db1\u0ddc\u0dc0\u0db1 \u0dc3\u0dca\u0dc1\u0dda\u0da0\u0dd2 \u0da1\u0ddc \u0dc3\u0d82\u0dc0\u0dd2 \u0ddc\u0db1 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0daf\u0dba\u0dd2 \u0db8\u0ddc\u0dc3\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0dca\u0dc1\u0dc3\u0dca \u0dc1\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dc3\u0ddc\u0d9a\u0da0\u0dd2 \u0da1\u0ddc \u0d9a\u0dc5\u0ddc. \u0daf\u0dc0\u0dc3 \u0db8\u0dd4\u0dc5\u0dd4\u0dbd\u0dca\u0da7\u0dc1\u0dbd\u0dca\u0da7\u0db8 \u0dd6\u0dbb\u0db0\u0db1\u0dab \u0dc3\u0dd0\u0dc3\u0dd2 11\u0d9a\u0dca, \u0d85\u0db0\u0db1 \u0dc3\u0dd0\u0dc3\u0dd2 4\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0ddc \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0dc0\u0dd2\u0dc1 \u0dca\u0dc2 \u0db1\u0dd2\u0db0\u0db1\u0dc1\u0dda \u0dc3\u0dc4 \u0db1\u0dd2\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dc1\u0dc5\u0dca."
