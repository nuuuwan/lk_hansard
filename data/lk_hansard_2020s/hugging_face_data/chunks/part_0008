bbf\u0ba4\u0bcd \u0b9a\u0bbf\u0baf\u0bae\u0bcd\u0baa\u0bb2\u0bbe\u0baa\u0bbf\u0b9f\u0bbf\u0baf) (The Hon. Ranjith Siyambalapitiya) \u0dc1\u0dc4\u0dcf\u0db3\u0dd2\u0daf\n\n\u0db8\u0db8 \u0dc1\u0db8\u0dca \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0d9a\u0dd2\u0dba\u0d9c\u0dda\u0db1 \u0dc3\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0d9a\u0dc1\u0dc5\u0dcf \u0d85\u0db4\u0dd2 \u0d89\u0dad\u0dcf \u0dc3\u0dc0\u0db8\u0db1\u0dcf\u0dc1\u0dc0\u0d9c\u0dda \u0d91\u0d9a \u0db4\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd2\u0d9c\u0dda \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0d85\u0d9c\u0dcf\u0db0\u0dc1\u0dba\u0d9c\u0dda \u0dc1\u0d9c\u0dcf\u0da9 \u0d91\u0db1 \u0d9c\u0db8\u0d9c\u0dda \u0d85\u0db4\u0dd2 \u0dc0\u0dd0\u0da7\u0dd4\u0dab\u0dd4 \u0dc0\u0dc1\u0dc5\u0d9c\u0dda \u0dc1\u0dda\u0d9c\u0dc1\u0dba\u0d9c\u0dda \u0dc1\u0d9c\u0dcf\u0da9 \u0d91\u0db1 \u0d9c\u0db8\u0d9c\u0dda \u0d85\u0dc1\u0db1\u0d9a\u0dca \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0d9c\u0dda \u0d85\u0db1\u0dcf\u0d9c\u0dad\u0dc1\u0dda \u0daf\u0dd3 \u0dc1\u0db8\u0dc0\u0dd0\u0dc3\u0dd4 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0d87 \u0db4 \u0dc1\u0db1\u0dcf\u0dc0\u0d9c\u0dda\u0db1 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0d89\u0d9c\u0dda\u0db1 \u0dc4\u0dd2\u0dc1\u0dad\u0db1 \u0da7\u0d9a\u0dca \u0dc3\u0dd4\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0dba \u0d9a \u0dc1 \u0d9c\u0dda\u0db1 \u0d85\u0dc0 \u0dba \u0db1\u0dd3 \u0db4\u0db8\u0dba \u0db4\u0dbb\u0dd4\u0db6\u0dd2\u0db8 \u0dc3\u0dd4\u0dbb\u0dca\u0db8\u0dcf\u0dab \u0d9a \u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dd2\u0daf \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dd4\u0da7 \u0d9a\u0dd2\u0dba\u0d9c\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0d9c\u0dda \u0dc1\u0db8\u0dca \u0db1\u0dd3 \u0db4 \u0d9a\u0da9\u0d9c\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0d9c\u0dda \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0daf \u0d94\u0dda \u0d9a\u0da9\u0d9c\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0d9c\u0dda\u0daf \u0dc1\u0db6\u0dcf\u0dc1\u0dc4\u0ddd \u0db1\u0dd3 \u0db4 \u0db4\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0dc1\u0db8\u0dca \u0db4\u0d