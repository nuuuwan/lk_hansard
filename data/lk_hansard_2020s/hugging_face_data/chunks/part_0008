    "chunk_text": "\u0dc1\u0db8\u0dca \u0dc1\u0db8\u0ddc\u0db1 \u0dad\u0dbb\u0db8\u0dca \u0db4\u0dc4\u0dad\u0dca \u0dc1\u0dda \u0db4\u0ddc\u0dbd\u0db1\u0dba\u0d9a\u0dca\u0daf? \u0d92 \u0dc0\u0ddc\u0dc1\u0dda\u0db8\u0dba\u0dd2 \u0db8\u0dd4\u0daf\u0dbd\u0dca\u0da7 \u0dbb\u0ddc\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0ddc\u0dad\u0dca. \u0d91\u0dad\u0dd4\u0db8\u0ddc \u0d9a\u0dd2\u0dda\u0dc0\u0ddc, \"\u0dc0\u0dd2\u0dc0\u0dd2 \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0db4\u0dca\u200d\u0dbb\u0d9a\u0ddc \u0db1\u0dc0\u0dbd \u0dbb\u0da2\u0dc1\u0dda \u0dc1\u0dc3\u0dca\u0dc0\u0d9a\u0dba\u0db1\u0dca\u0dc1\u0dda \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0db8\u0dca \u0d9c\u0dd0\u0db1 \u0dc0\u0dd2\u0dc0\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0da5\u0ddc \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0ddc, \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dbd\u0db6\u0db1 \u0dc0\u0dc3\u0dc1\u0db0\u0db1 \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca \u0dc1\u0dba\u0db1\u0dca, \u0daf\u0dd3\u0db8\u0db1\u0ddc \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca \u0dc1\u0dba\u0db1\u0dca \u0d9a\u0dbb\u0dc3\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0ddc \u0dba\u0da7 \u0dbb\u0ddc\u0da2\u0dba \u0dc3\u0dc4\u0dad\u0dd2\u0d9a\u0dba \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0ddc\" \u0d9a\u0dd2\u0dba\u0dbd\u0ddc. \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0dc1\u0db8\u0dca\u0d9a\u0dad\u0dca \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0dc1\u0d9a\u0ddc\u0db8\u0dd2\u0dc3\u0db8 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0db8\u0db0\u0db1 \u0db1\u0dba \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dbd\u0dca\u0da7\u0dbd\u0dc3\u0d9a\u0dca \u0dc1\u0db1\u0ddc\u0dc1\u0dda\u0daf? \u0d85\u0daf \u0d9a\u0dbb\u0db1 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0ddc \u0d85\u0db1\u0dd4\u0dc0 \u0dc1\u0db8\u0dca \u0db8\u0ddc\u0dc3\u0dc1\u0dda \u0d85\u0d9c \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0ddc\u0da7, \u0dbd\u0db6\u0db1 \u0db8\u0ddc\u0dc3\u0dba \u0db8\u0dd4\u0dbd"
