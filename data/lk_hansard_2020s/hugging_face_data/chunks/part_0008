\u0dad\u0db1 \u0d9a. \u0dc0\u0dd2\u0dc1\u0dda\u0db8 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0da0\u0dd9\u0dd2 \u0dc1\u0da7\u0dd2\u0dba\u0dc1\u0dd9\u0dd2\u0db8\u0dca \u0d86 \u0dad\u0db1 \u0db6\u0dd4 \u0dc3\u0dc4 \u0dbd\u0dd2\u0db7\u0dd2\u0da0 \u0dc1\u0dbd\u0dc3 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dba \u0db1 25 000\u0dd9\u0da7 \u0d86\u0dc3\u0db1\u0dca\u0daf\u0db1 \u0db8\u0dd4\u0daf\u0dbd \u0d9a \u0db8\u0dc4\u0dd2 \u0db7\u0dd2\u0dab\u0dca\u0da9\u0da9\u0dd2\u0d9c\u0dd2\u0dba \u0da7 \u0dbd\u0db6\u0dd2 \u0daf\u0dd3\u0dbd\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dd2. \u0db4\u0dd2\u0da9\u0dd4 \u0dbd\u0db6\u0db1 \u0d86 \u0dad\u0db1 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0daf\u0db0\u0dc1 \u0db1\u0dca\u0daf \u0daf\u0db1\u0db1\u0dca\u0daf \u0d85\u0db4\u0da7 \u0dad\u0dbb\u0dca\u0dd9 \u0d9a \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dd2. \u0d86 \u0dad\u0db1 \u0dd2\u0d82\u0d9c\u0dd2\u0db1\u0dca\u0daf \u0dd2\u0d82\u0d9c\u0da7\u0db8 \u0db4\u0dd2\u0da9\u0dd4 \u0dbd\u0db6\u0db1\u0dca\u0daf\u0db1 \u0db6\u0db1\u0dc4\u0db1. \u0db8\u0dca\u0d9a\u0dd2\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0d9a \u0dad\u0dd4\u0dc5 \u0d91\u0dc0\u0db1\u0db1\u0dd2 \u0d86 \u0dad\u0db1 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc0\u0dba\u0dd4\u0dc4\u0d9c\u0dad \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1\u0da7 \u0d95\u0db1\u0dd1. \u0dc0\u0dd2 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0da0\u0dc3\u0dda\u0dd9\u0dba\u0dda \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1\u0da7 \u0d95\u0db1\u0dd1. \u0d85\u0db4\u0dd2 \u0dd9 \u0db4\u0dd2\u0dd2\u0d9c\u0d9c\u0db1\u0dca\u0daf\u0db1\u0dc0\u0dd2. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dc1\u0db8\u0dca \u0d86\u0dd9\u0dd2\u0dba \u0da7 \u0dbd\u0dd2\u0db7 \u0dbd\u0db6\u0db1 \u0d86 \u0dad\u0db1 \u0d9a\u0dd4\u0dab\u0dd4 \u0dc1\u0dd9\u0dd2\u0dbd\u0dca\u0dbd \u0da7 \u0dc0\u0dd2\u0d9a\u0dd4\u0dda\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0dc1\u0dd9\u0dd2\u0dc1\u0dc4\u0dd2\u0db8\u0daf? \u0dc4\u0db1\u0db6\u0db1\u0dd2 \u0d91\u0dd9 \u0dc1\u0daf \u0d9a \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dd2 \u0d9c\u0dbb\u0dd4 \u0d85\u0d9c\u0db8\u0db1\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0d91\u0dd9 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0daf\u0dd9 \u0dc0\u0dd2\u0dad\u0dba \u0d9a \u0dc1\u0db8\u0dca \u0d86 \u0dad\u0db1 \u0db4\u0dd2\u0da9\u0dd4 \u0dbd\u0db6\u0dbd\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dd2. \u0d9c\u0dbb\u0dd4 \u0d85\u0d9c\u0db8\u0db1\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db8\u0dd2 \u0dc5 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0daf\u0db0 \u0dc3\u0da0\u200d\u0dba\u0dd2\u0dc1\u0dbd\u0dca\u200d\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dd2. \u0db8\u0db8 \u0d91\u0db8 \u0dc3\u0da0\u200d\u0dba\u0dd2\u0dc1\u0dbd\u0dca\u200d\u0db1 \u0dca\u0dcf\u0dcf\u0d9c\u0dad\u0dcf* \u0dd9\u0dba\u0db1\u0dc0\u0dd2.\n\n\u0dc1\u0dd9\u0dd2 \u0dc0\u0dd2\u0da9-19 \u0dc0\u0dc3\u0da0\u0d9c\u0dad \u0db4\u0db1\u0dc0\u0dad\u0dd2 \u0dc3\u0db8\u0dc1\u0dad\u0dad\u0dca \u0dc1\u0db8\u0db8 \u0d86 \u0dad\u0db1 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2\u0dba \u0db1 12\u0dd9 \u0dc1\u0dd4\u0dda\u0db0 \u0dbd\u0dd2\u0db7 \u0d9a \u0dbd\u0db1\u0db6\u0dd4\u0dc0\u0dd2. \u0dc4\u0db1\u0db6\u0db1\u0dd2 \u0dc1\u0db8\u0dd2\u0dd9 \u0d9a\u0daf \u0dd9\u0dc1\u0dc5\u0dda? \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0da0\u0dd9\u0dd2 \u0dc1\u0da7\u0dd2\u0dba\u0dc1\u0dd9\u0dd2\u0db8\u0dca \u0d86 \u0dad\u0db1 \u0dc0\u0dd2\u0d9a\u0dd4\u0dda\u0dd2 \u0daf\u0db8\u0db1\u0dca\u0daf\u0db1\u0da7 \u0dc1\u0da7\u0dd2\u0dba\u0dc1\u0dd9\u0dd2\u0db8\u0dca \u0d86 \u0dad\u0db1\u0dc1\u0dad Chairman \u0db4\u0db1\u0dca\u0daf\u0db1\u0dbd\u0dd2 \u0daf\u0db1\u0db8\u0dca\u0db8\u0dd2. Chairman \u0db4\u0db1\u0dca\u0daf\u0db1\u0dd2 \u0daf\u0db1\u0db8\u0dd4\u0dc0\u0dd2\u0da7 \u0db4\u0dc3\u0dda\u0dc1\u0dc3\u0dda \u0d91\u0dd9 \u0db4\u0dd2\u0dba\u0da7\u0db8 \u0dc1\u0da7\u0dd2\u0dba\u0dc1\u0dd9\u0dd2\u0db8\u0dca \u0d86 \u0dad\u0db1\u0dc1\u0dad \u0dbd\u0dd2\u0db7 \u0d85\u0da9\u0dd4 \u0dc0\u0dd4\u0dda\u0dd2. \u0daf\u0db1\u0db1\u0dca\u0daf \u0dd9 \u0d85\u0dbd\u0dd2\u0db7 \u0dbd\u0db6\u0db1 \u0d86 \u0dad\u0db1 \u0d9a \u0dc0\u0dd4\u0dda\u0dd2. \u0dc1\u0dd9\u0dd2\u0dc1\u0dc4\u0dd2\u0db8\u0daf \u0dd9 \u0dc0\u0dd4\u0dc1\u0dab\u0dca\u0da9? \u0db8\u0db8 \u0db4\u0db1\u0dc4\u0db1\u0dd2\u0d82\u0dd2\u0dba\u0dc0 \u0d9a\u0dd2 \u0db1\u0dca\u0daf\u0db1 \u0dd9\u0db1\u0db8\u0db1\u0dad\u0dd2\u0dd2 \u0dc1\u0db8\u0dca \u0dc1\u0db8\u0dd2\u0db1 \u0dc1\u0dda \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1\u0dad\u0dca \u0d89\u0dc3\u0dda\u0dc1\u0dc3\u0dbd\u0dca\u0dbd\u0dd2 \u0dc1\u0db8\u0dca \u0d9c\u0db1\u0db1 \u0dc1\u0dc0\u0ddd\u0dc4\u0dd2\u0dbb\u0dd2\u0dd9 \u0dc0\u0dd2\u0d9c\u0dda\u0db1 \u0d9a \u0d85\u0db1\u0dd2\u0dc0\u0dd2\u0dbb\u0dca \u0dc1 \u0db1\u0dca\u0daf\u0db8 \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1\u0da7 \u0d95\u0db1\u0dd1 \u0db6\u0dc0. \u0dc1\u0db8\u0dca\u0dd9 \u0db8\u0dc4\u0dd2 \u0da2\u0dd2\u0dad\u0dd2\u0dd9 \u0d85\u0db4\u0dba\u0dd2\u0db0 \u0d9a. \u0dbd\u0dd2\u0db7 \u0dbd\u0db6\u0db1 \u0d86 \u0dad\u0db1 \u0d9a \u0d9c\u0da2 \u0db8\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0db0\u0db1\u0dc0\u0dd2\u0daf \u0dc4\u0dba\u0dc4\u0dd2 \u0dc1\u0db8\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dc1\u0dad \u0d9a\u0dd4\u0dab\u0dd4 \u0dc1\u0dd9\u0dd2\u0dbd\u0dca\u0dbd \u0da7 \u0dc0\u0dd2\u0d9a\u0dd4\u0dda\u0dd2 \u0daf\u0db1\u0db8\u0dd3\u0db8 \u0d89\u0dad\u0dd2\u0db8 \u0d85\u0db1\u0dca \u0d9a\u0d9a\u0dd2\u0dad \u0dc1\u0daf \u0d9a. \u0db1\u0dd2\u0dc3\u0dd2 \u0d9c\u0dbb\u0dd4 \u0d85\u0d9c\u0db8\u0db1\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dc1\u0d9c\u0db1\u0dca\u0daf \u0db8\u0db8 \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8 \u0d9a \u0dd9\u0dba\u0db1\u0dc0\u0dd2. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dd2\u0dad\u0dca \u0dba\u0dd2\u0da2\u0dba \u0dc1\u0dda\u0db4\u0dc5 \u0dc0\u0dd2\u0d9a\u0dd4\u0dda\u0dd2 \u0daf\u0db8\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dd2\u0daf\u0dd2\u0db8 \u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0dda\u0db0 \u0dc0\u0dd4\u0dab\u0dd4 \u0db4\u0dd4\u0dda\u0d9c\u0dbd\u0dc1 \u0d9a. \u0dbd\u0dd2\u0db7 \u0dbd\u0db6\u0db1 \u0dc1\u0da7\u0dd2\u0dba\u0dc1\u0dd9\u0dd2\u0db8\u0dca \u0d86 \u0dad\u0db1 \u0dc0\u0dd2\u0d9a\u0dd4\u0dda\u0dd2 \u0daf\u0db8\u0db1\u0dca\u0daf\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0da2\u0db1\u0dc0\u0dba\u0db8 \u0dc1\u0db8\u0dd2\u0dd9 \u0d9a\u0daf? \u0dc1\u0db8\u0dd2\u0dd9 \u0d9a\u0daf \u0dc0\u0dba\u0db8? \u0db1\u0dd2\u0dc3\u0dd2 \u0dc1\u0db8\u0dca \u0dd9\u0db1\u0dad \u0dc0\u0db1\u0dc1\u0da9 \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1 \u0d91\u0db4\u0dd2. \u0dbd\u0dd2\u0db7 \u0dbd\u0db6\u0db1 \u0d86 \u0dad\u0db1 \u0dc1\u0db8\u0dc1\u0dc4\u0db8 \u0d9a\u0dd4\u0dab\u0dd4 \u0dc1\u0dd9\u0dd2\u0dbd\u0dca\u0dbd \u0da7 \u0dc0\u0dd2\u0d9a\u0dd4\u0dda\u0db1\u0dca\u0daf\u0db1 \u0d91\u0db4\u0dd2. \u0d85\u0dbd\u0dd2\u0db7 \u0dbd\u0db6\u0db1 \u0d86 \u0dad\u0db1\u0dc0\u0dbd\u0da7 \u0dc1\u0db8\u0dc1\u0dc4\u0db8 \u0db1\u0dca\u0daf\u0db1 \u0db6\u0db1\u0dc4\u0db1 \u0d9a\u0dd2 \u0dbd\u0dd2 \u0d85\u0db4\u0dd2 \u0db4\u0dd2\u0dd2\u0d9c\u0d9c\u0db1\u0dca\u0daf\u0db1\u0dc0\u0dd2. \u0dc0\u0dd2 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc0\u0dba\u0dd4\u0dc4\u0d9c\u0dad\n\n2361 2362\n\n[\u0d9c\u0dbb\u0dd4 \u0da9\u0dd3.\u0db6\u0dd3. \u0dc1\u0dc4\u0dda\u0dba\u0dad\u0dca \u0db8\u0dc4\u0dad\u0dd2]\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 * \u0db4\u0dd4\u0dca\u0dae\u0dad\u0dcf\u0d9a\u0dcf\u0dbd\u0dc0\u0dda \u0dad\u0dcf\u0db6\u0dcf \u0d87\u0dad\u0dcf. * \u0ba8\u0bc2\u0ba9\u0bbf\u0bb2\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bb2\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. * Placed in the Library.\n\n2024 \u0da2\u0dd6\u0dd2\u0dba 23"
