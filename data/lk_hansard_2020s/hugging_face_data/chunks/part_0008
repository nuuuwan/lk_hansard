    "chunk_text": "\u0dd0\u0d9c\u0dda \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba \u0dc1\u0d9c\u0dcf\u0da9 \u0d9c\u0dad\u0dca\u0dad\u0dcf \u0dbd\u0dd4 \u0dc1\u0dad\u0dbd\u0dca \u0dc1\u0db4\u0ddd\u0dbd\u0dd2\u0db8\u0dca \u0db1\u0dd0 \u0db4 \u0dbd\u0dd4 \u0d85 \u0dc0\u0dcf \u0db1\u0dd0 \u0db4 \u0dbd\u0dd4 \u0dc1\u0db8\u0dca\u0dc0\u0dcf \u0db1\u0dd0 \u0db4 \u0dbd\u0dd4 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0daf \u0d92\u0dc0\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0dc0\u0dcf\u0dc1\u0dc3\u0db8 \u0db4 \u0dab\u0dd4 \u0dab\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dad\u0dca \u0dd0\u0d9c\u0dda \u0dc0\u0dd2 \u0dcf\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dd2\u0d9c\u0dda \u0dc0\u0dd0\u0dd2 \u0dc1\u0dc0\u0dbd\u0dcf\u0daf \u0db4\u0dbb\u0dd4\u0d9c\u0dd2\u0dba \u0db8\u0dcf\u0dc3\u0dc1\u0dda 24\u0dc0\u0db1 \u0dcf \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0dcf\u0da7 \u0dc1\u0db1\u0dcf\u0dc1\u0d9c\u0dc0\u0dd6 \u0dab\u0dba \u0d9a\u0d9c\u0dda \u0da7 \u0d87\u0dc1\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0dd4\u0dc0 \u0dc1\u0da9\u0dcf\u0dbd\u0dbb\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 8\u0dd2 \u0d9c\u0dab\u0db1\u0d9a\u0dca \u0d91\u0d9a\u0dad\u0dd4\u0dc1\u0dc0\u0dbd\u0dcf \u0db4\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0daf \u0d92 \u0dc0\u0dcf\u0dc1\u0dc3\u0db8 \u0dc1\u0db1\u0dcf\u0dc1\u0d9c\u0dc0\u0dd6 \u0dab\u0dba \u0dc0\u0dcf\u0dbb\u0dd2\u0d9a \u0dc3\u0dd4\u0dc3\u0dcf \u0dab\u0dba \u0dc1\u0d9c\u0dcf\u0da9 \u0dad\u0dc0\u0dad\u0dca \u0dc0\u0dd0\u0dd2 \u0dc0\u0dd4\u0dab\u0dcf\u0daf \u0d85\u0dc1\u0db1\u0d9a\u0dca \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0d9c\u0dda \u0d9c\u0dad\u0dca\u0dad\u0dcf\u0db8 \u0db4\u0dc1\u0db6\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0dd2\u0db1\u0d9a \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0dc1\u0d9c\u0db1 \u0d9a\u0d9c\u0dda\u0db1 \u0dc1\u0db8\u0dca \u0dc0\u0dc1\u0dc3 \u0dad\u0d9a\u0dca\u0d9a\u0dd2 \u0db4\u0db1\u0dad\u0dca \u0dc1\u0d9c\u0dc1\u0db1\u0d9c\u0dda\u0db1 \u0dc3\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0d9a \u0db1\u0dc0\u0dcf\u0daf \u0dd0\u0d9c\u0dd