    "chunk_text": "\u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0dad \u0d95\u0db1\u0da7\u0dad \u0d86 \u0dad\u0d9a, \u0d86 \u0db8\u0dd2\u0d9a \u0db1\u0dd2\u0dd9\u0dc4\u0dc3 \u0d85\u0d82\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dd4\u0db1\u0dba\u0dd2. \u0dc1\u0dad\u0ddc\u0db1 \u0d86 \u0dc1\u0dda \u0dc0\u0dd4\u0dc0 , \u0d86 \u0db8\u0dd2\u0d9a \u0db1\u0dd2\u0dd9\u0dc4\u0dc3 \u0db1\u0dd0\u0d85\u0d82\u0dc1\u0dc0\u0dbd\u0dcf \u0d85\u0d82\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d86 \u0db8\u0dd2\u0d9a \u0d85\u0db1\u0dca\u0dad\u0dc0\u0dcf\u0dd9\u0dba \u0db1\u0dd2\u0dc3 \u0dca\u0dcf\u0dba\u0dd2. \u0dc1\u0dad\u0ddc\u0db1 \u0d86 \u0dc1\u0dda \u0dc0\u0dd4\u0dc0 , \u0d86 \u0db8\u0dd2\u0d9a \u0d85\u0db1\u0dca\u0dad\u0dc0\u0dcf\u0dd9\u0dba \u0db1\u0dd2\u0dc3\u0dcf\u0dad \u0d85\u0dc3\u0dbb\u0dab\u0db7\u0dcf\u0dc0\u0dba\u0da7, \u0d85\u0db4\u0dc4\u0dc3\u0dd4\u0dad\u0dcf\u0dc0\u0da7 \u0db4 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0d92 \u0d86 \u0dc1\u0dda\u0dad \u0dc3\u0dd2\u0dd2 \u0db1 \u0d86 \u0dad \u0dc1\u0dc4\u0ddc\u0db1\u0dca\u0db1\u0dca \u0d85\u0dd9\u0dc4\u0db1 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca\u0dad\u0dba\u0dd2. \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0dc3\u0dad\u0dcf\u0db1\u0dcf \u0dad\u0dad\u0dcf\u0dc0 \u0dd0\u0db1 \u0d85\u0dc0\u0dc1\u0db6\u0ddd\u0db0\u0dc1\u0dba\u0db1\u0dca \u0dc3\u0dd2\u0dd2 \u0db1 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4. \u0d91\u0dad \u0db1\u0dd2\u0dc3\u0dcf \u0dc1\u0dad\u0ddc\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dc1\u0dd2 \u0dc0\u0dd4\u0dab , \u0dc1\u0dad\u0ddc\u0db1 \u0d86 \u0dc1\u0dda \u0dc0\u0dd4\u0dab , \u0d86 \u0dda\u0dc0\u0dcf\u0dd9\u0dba, \u0d85\u0db1\u0dca\u0dad\u0dc0\u0dcf\u0dd9\u0dba \u0dc4\u0dbb\u0dc4\u0dcf \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0dad \u0dad\u0dbb\u0dd4\u0dab \u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0db4\u0d9a\u0dca\u0dc2 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2 \u0dc1\u0dda\u0dd9\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0dad\u0ddc\u0dbb\u0dc0 \u0d85\u0db4\u0dd2 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0dc1\u0dd9\u0db1\u0dcf\u0dad \u0d91\u0d9a\u0dd4\u0db1\u0dc1\u0dc0\u0dbd\u0dcf \u0dc0\u0dd0\u0dc5\u0dd0\u0d9a\u0dca\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dd4\u0db1\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0dc0\u0dd2 \u0dca\u0dc0\u0dcf\u0dc3 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0dad \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5\u0d9a\u0dca \u0dc3\u0dd0\u0d9a\u0dc3\u0dd2\u0dba \u0dba\u0dd4\u0dd4\u0db1\u0dba\u0dd2.\n\n2195 2196\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dd4\u0db1\u0dc0"
  },
