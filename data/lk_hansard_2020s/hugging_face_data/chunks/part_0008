    "chunk_text": "\u0bae\u0bae\u0bc8\u0baf\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0baa\u0bc8 \u0b8e\u0ba4\u0bcd\u0ba4\u0bae\u0ba9\u0baa\u0baf\u0bbe \u0ba4\u0bbe\u0baf\u0bcd\u0bae\u0bbe\u0bb0\u0bcd \u0b95\u0bc1\u0bb3\u0bb5\u0bbf\u0b95\u0bcd\u0b9a\u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0bc8\u0b95\u0bcd\u0b95\u0bbe\u0b95\u0bbf \u0b86\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0bb3\u0bcd\u0bb3\u0bbe\u0ba9\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0b8e\u0ba4\u0bcd\u0ba4\u0bae\u0ba9\u0baa\u0baf\u0bbe \u0baa\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0b99\u0bcd \u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0baa\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd \u0b9a\u0ba4\u0bbe\u0bb4\u0bbf\u0bc8\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0bb5\u0bae\u0bc8\u0ba8\u0bbf\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd \u0baa\u0baa\u0bbe\u0bb0\u0bbe\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0b9f\u0bae\u0bcd\u0b9a\u0baa\u0bb1\u0bcd\u0bb1\u0ba9. \u0b8e\u0ba4\u0bcd\u0ba4\u0bae\u0ba9\u0baa\u0baf\u0bbe \u0baa\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0baa\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd \u0b9a\u0ba4\u0bbe\u0bb4\u0bbf\u0bc8\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f \u0ba8\u0bbf\u0bb0\u0bcd\u0bb5\u0bbe\u0b95\u0bae\u0bcd \u0bae\u0bc2\u0bc8\u0bae\u0bbe\u0b95\u0ba4\u0bcd \u0ba4\u0ba3\u0bcd\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0baa\u0bb5\u0bae\u0bc8\u0baf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0ba8\u0bbf\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0b87\u0bb5\u0bcd\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0bc6\u0ba8\u0bcd\u0ba4\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b8e\u0bb2\u0bcd\u0bc8\u0bbe\u0bae\u0bcd \u0b8f\u0ba9\u0bcd \u0b87\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bae\u0bc8\u0baf\u0b95 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0ba4\u0bb5\u0bbf\u0b9a\u0bc6\u0baf\u0bcd\u0baf \u0bae\u0bc1\u0ba9\u0bcd\u0bb5\u0bb0\u0bb5\u0bbf\u0bb2\u0bcd\u0bae\u0bc8? \u0b8f\u0ba9\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0bc6\u0bbe\u0bb0\u0bcd\u0baa\u0bbe\u0b95\u0b95\u0bcd \u0b95\u0bc1\u0bb0\u0bb2\u0bcd \u0b9a\u0b95\u0bbe\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bb5\u0bbf\u0bb2\u0bcd\u0bae\u0bc8? \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bbe\u0bb0\u0bbe\u0bb3\u0bc1\u0bae\u0ba9\u0bcd\u0bb1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bae\u0bae\u0bc8\u0baf\u0b95 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0bc6\u0bbe\u0bb0\u0bcd\u0baa\u0bbe\u0b95\u0b95\u0bcd \u0b95\u0bc1\u0bb0\u0bb2\u0bcd\u0b9a\u0b95\u0bbe\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd\u0baa\u0baa\u0bbe\u0ba4\u0bc1, \u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b8e\u0ba8\u0bcd\u0ba4\u0bb5\u0bbf\u0ba4\u0b9a\u0bcd \u0bc6\u0bae\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0bae\u0bc1\u0bae\u0bcd \u0b87\u0bb2\u0bcd\u0bc8\u0bbe\u0ba4\u0ba4\u0bc1\u0baa\u0baa\u0bbe\u0bb2\u0bcd \u0ba8\u0b9f\u0ba8\u0bcd\u0ba4\u0bc1\u0b9a\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0b87\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0ba9\u0bcd\u0bb1\u0bc1 \u0b87\u0bae\u0b9f\u0ba4\u0bcd \u0ba4\u0bb0\u0b95\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bc2\u0bc8\u0bae\u0bbe\u0b95\u0ba4\u0bcd \u0baa\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bbf\u0b9c\u0baf\u0bae\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bc1\u0b9a\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bae\u0ba4\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bc1\u0bae\u0bcd \u0baa\u0baa\u0bbe\u0ba4\u0bc1 \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbf\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0baa\u0bb5\u0ba4\u0bae\u0ba9\u0baf\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1.\n\n1 352\u0d9a\u0dca \u0dbd\u0d82 \u0daf\u0da2\u0daf\u0db4 \u0dbd\u0d82\u0dd2\u0dbb \u0daf\u0db4. \u0dbd\u0d82\u0d85 \u0dca \u0dbd\u0d82\u0da2\u0dcf\u0da2\u0dcf\u0db4\u0daf \u0dbd\u0d82\u0db1\u0dd2 ) \u0dbd\u0d82 \u0dcf\u0dae\u0dbd\u0dca \u0dbd\u0d82\u0daf\u0db4\u0da2\u0daf\u0db4; \u0dbd\u0d82\u0daf\u0dd4 \u0dba \u0d86 \u0dbd\u0d82\u0da2\u0dcf\u0da2\u0dcf\u0db4\u0daf \u0dbd\u0d82 \u0dcf\u0dae\u0dbd\u0dca \u0dbd\u0d82\u0daf\u0db4\u0da2\u0daf\u0db4. \u0dbd\u0d8210\u0daf\u0dd0\u0db1\u0dd2 \u0dbd\u0d82\u0daf\u0db4\u0da7 \u0dbd\u0d82\u0db4\u0dcf\u0dae \u0dcf\u0dae \u0dbd\u0d82\u0d85\u0dd2\u0dc5\u0dad\u0dca \u0dbd\u0d82 \u0dca\u0daf\u0dd4\u0db4- \u0dba\u0dab \u0dbd\u0d82\u0d9c\u0dca\u0da2 \u0dbd\u0d82\u0dcf\u0dd0\u0da2\u0da7 \u0dbd\u0d82\u0dcf\u0dbd\u0dca\u0dbd\u0dd4 \u0dbd\u0d82 \u0daf\u0da2\u0daf\u0db4 \u0dbd\u0d82\u0dd2\u0dbb \u0da2 \u0dbd\u0d82\u0d91 \u0dad\u0dca \u0dbd\u0d82\u0da2\u0da2 \u0dbd\u0d82 ) \u0dbd\u0d82\u0d85\u0daf\u0dcf\u0dae\u0dcf\u0db4 \u0dbd\u0d82\u0dd2\u0dbb \u0dca\u0da2 \u0dbd\u0d82 \u0dd0\u0da2\u0dd0\u0dad\u0dd2\u0dba\u0dd2. \u0dbd\u0d82\n\n\u0db8\u0dd6\u0d9a\u0db4\u0dcf\u0da2\u0db4\u0dbb\u0dd6\u0daa \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0da2\u0dca\u0dd3\u0dd4\u0da2\u0db1\u0dd2 \u0dbd\u0d82\u0daf\u0dd4 \u0dbd\u0d82\u0d85\u0dcf \u0d86 \u0dbd\u0d82 \u0da7\u0dd2\u0dcf\u0d9a \u0dbd\u0d82\u0db4\u0dc4\u0dc3\u0dd4 ) \u0dbd\u0d82\u0d9c\u0dd0\u0da2 \u0dbd\u0d82Budget \u0d91 \u0d9a\u0dca \u0da2 \u0dbd\u0d82 \u0dcf\u0db4 \u0dbd\u0d82 \u0dc5\u0db4 \u0dbd\u0d82\u0d85\u0dd2\u0dc5 \u0dbd\u0d82Budget \u0d91 \u0da7 \u0dbd\u0d82\u0dcf\u0dc4 \u0ddd\u0d9c \u0dbd\u0d82\u0daf\u0dd4\u0db4\u0dca\u0da2\u0db4. \u0dbd\u0d82\u0d92 \u0dbd\u0d82 \u0dbd\u0d82\u0d94\u0d9a\u0dca \u0ddd\u0da2 \u0dbd\u0d82 \u0dc5\u0db4. \u0dbd\u0d82\u0da2\u0db8\u0dd4\u0dad\u0dca \u0dbd\u0d82\u0dcf\u0da2\u0dc4\u0dba \u0dbd\u0d82\u0db4\u0db4\u0dba\u0daf\u0dbd\u0dca \u0dbd\u0d82 \u0dd0\u0da9\u0dd2\u0d9a\u0db4 \u0dbd\u0d82\u0db6\u0db6\u0db4 \u0dbd\u0d82\u0dc4)\u0db6 \u0dbd\u0d82 \u0daf\u0dca\u0da2 \u0dbd\u0d82\u0d89\u0dca\u0da2 \u0dbd\u0d82\u0d85)\u0da2\u0d9a\u0db4 \u0dbd\u0d82\u0d89\u0dcf\u0dae\u0dd2\u0dc5\u0dbb\u0dd2\u0dcf\u0db4 \u0d9a\u0da7 \u0dbd\u0d82 \u0dda\u0dca\u0da2 \u0dbd\u0d82\u0db6\u0dd0\u0dbb\u0dd2 \u0dbd\u0d82\u0dcf\u0dad\u0dca\u0dad\u0dca\u0daf \u0da7 \u0dbd\u0d82\u0db4\u0dad\u0dca \u0dbd\u0d82 \u0daf\u0d9a\u0db4 \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0da2\u0daf\u0db4. \u0dbd\u0d82\u0db6\u0da9\u0dd4\u0d9a\u0da9\u0db4\u0dba \u0daf\u0d9a \u0dbd\u0d82\u0d89\u0db3\u0d9a\u0db4 \u0dbd\u0d82 \u0dbd\u0d82\u0dd6\u0da2\u0db4\u0d9c\u0d9a \u0dbd\u0d82\u0db4\u0db4\u0dba \u0dbd\u0d82\u0dc4\u0dd4\u0dbd\u0dcf \u0dbd\u0dca \u0dbd\u0d82\u0d89\u0db3\u0d9a\u0db4 \u0dbd\u0d82\u0daf \u0dda\u0dcf\u0dd0\u0dca\u0da2\u0da7 \u0dbd\u0d82 \u0da2 \u0dbd\u0d82\u0da2\u0db4\u0dbb\u0dca\u0dbd\u0d9c \u0dbd\u0d82\u0db4\u0dcf\u0dae\u0dcf\u0dba \u0dbd\u0d82\u0d89\u0db3\u0d9a\u0db4 \u0dbd\u0d82\u0da2 \u0da9\u0db4\u0dbd\u0dca\u0dd2\u0db1\u0da2\u0da7 \u0dbd\u0d82 \u0da2 \u0dbd\u0d82\u0da2\u0db4\u0dbb\u0dca\u0dbd\u0d9c \u0dbd\u0d82\u0da2\u0db4\u0daf\u0d9a\u0dd2\u0dc5\u0da7\u0dd2 \u0dbd\u0d82\u0db6 \u0daf\u0db4\u0d9c\u0da2 \u0dbd\u0d82\u0d89\u0db3\u0d9a\u0db4 \u0dbd\u0d82\u0db4\u0dcf\u0da2 \u0dbd\u0d82\u0dc4\u0dca\u0dd2\u0db1 \u0dbd\u0d82\u0daf\u0d9a\u0dca\u0daf\u0db4 \u0dbd\u0d82 \u0da2 \u0dbd\u0d82\u0da2\u0db4\u0dbb\u0dca\u0dbd\u0d9c \u0dbd\u0d82\u0da2\u0db4 \u0dbd\u0d82\u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0d9a\u0db4. \u0dbd\u0d82\u0dcf\u0daf\u0da2 \u0dbd\u0d82\u0d91 \u0dc4\u0da2\u0da2 \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0da2\u0daf\u0db4. \u0dbd\u0d82\u0daf\u0dd0\u0da9 \u0dbd\u0d82 \u0da7\u0dba\u0dd4\u0dd4 \u0dbd\u0d82 \u0da2\u0db4\u0d9a\u0dd4\u0dad\u0dca \u0dbd\u0d82 \u0dba\u0d9a\u0db4 \u0dbd\u0d82\u0da2\u0dd0\u0dc4\u0dd0. \u0dbd\u0d82"
  },
