    "chunk_text": "\u0dd9\u0dd2\u0dba\u0dda\u0dd2\u0dc0 \u0db4\u0dd4\u0dda\u0d9c\u0dbd \u0db1\u0dca\u0daf \u0dc4\u0db1\u0da7\u0dd2 \u0da7 \u0db4\u0db8\u0dda \u0d9a \u0dc1\u0db1\u0dd2\u0dc1\u0dc0\u0dd2 \u0dc1\u0dda \u0db4\u0dd2\u0dbd\u0db1 \u0db4 \u0d9a\u0dc2\u0dca\u0da8 \u0dc4\u0db1\u0da7\u0dd2 \u0da7\u0dad\u0dca \u0dad\u0db8\u0dd4\u0db1\u0dca\u0daf \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0db1 \u0dd9\u0dba\u0db1 \u0dd9\u0dab\u0dca\u0da9\u0da9\u0dd2 \u0db8\u0dca \u0dc4\u0db1\u0da7\u0dd2 \u0da7\u0dad\u0dca \u0d9c\u0dad\u0dca\u0dad\u0dd2\u0db8 \u0dc4\u0db1\u0db8\u0dc1\u0daf\u0db1\u0dd2\u0da7\u0db8 \u0dc0\u0d9c\u0d9a\u0dd3\u0db8 \u0d9a \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dd2 \u0db1\u0db1\u0dc0\u0dad \u0dc1\u0db8\u0dca \u0dba\u0dc1\u0da7\u0dca \u0dd9\u0dc5\u0dd4 \u0da2\u0dd6\u0dd2\u0dba \u0dc0\u0db1\u0db1\u0dd2 \u0db1\u0dca\u0dd4\u0dd3\u0db8\u0dca \u0d87\u0dad\u0dd2 \u0dc1\u0db1\u0dd2\u0dc0\u0db1 \u0d86\u0dd9\u0dd2\u0dba \u0da7 \u0dc0\u0dd2\u0dc1\u0dda\u0db8 \u0da2\u0dd2\u0dbb\u0dab\u0db1\u0dca\u0daf \u0d85\u0dad\u0dba \u0dc3\u0db8\u0dca \u0d87\u0dad\u0dd2 \u0dc1\u0dc0\u0db1 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0dd9\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1. \u0dd9\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dca\u200d\u0dbb\u0dd2\u0dc1 \u0ddd\u0d9c\u0dd2\u0dd9\u0dc0 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dd2\u0dad\u0dca\u0db8\u0dd9 \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1 \u0d85\u0dc0 \u0dba\u0dd2 . \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1 \u0db1\u0dca\u0daf\u0db8 \u0d85\u0db4\u0dd2 \u0dd9\u0dae\u0dd2 \u0dd9\u0dba\u0db1 \u0db7\u0dd2\u0dc2\u0dca\u0da8\u0dd2\u0dc0 \u0d85\u0dd4\u0d9a\u0dc0 \u0d85\u0daf\u0dc4\u0db1 \u0d86\u0d9c\u0db8 \u0d85\u0dd4\u0d9a\u0dc0 \u0dc0\u0dbb\u0dca\u0dd3\u0dd9\u0dba\u0dda \u0dd9\u0dba\u0dbd\u0dd2 \u0dc1\u0d9c\u0dd2\u0da9\u0dc0\u0dbd\u0dca \u0d9a\u0dad\u0dd2\u0db8\u0dad\u0dca \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1\u0da7 \u0dc1\u0db8\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0db4\u0dd2\u0dc0\u0dd2\u0da0\u0dca\u0dd2 \u0dd9\u0dba\u0db1\u0dc0\u0dd2 \u0dc1\u0dc0\u0dd4\u0d9a\u0dc0\u0da7 \u0d91\u0dad\u0db1\u0db1\u0dd2\u0db1\u0dca\u0daf \u0d91\u0dc4\u0dd2\u0da7 \u0d9c\u0dd2\u0dd2 \u0dbd\u0dca\u0dbd\u0dd2 \u0d85\u0db4\u0dd2 \u0dc4\u0db1\u0dc1\u0db8\u0ddd\u0da7\u0db8 \u0dc1\u0db8\u0dca \u0dba\u0dc1\u0da7\u0dca \u0da2\u0dd3\u0dc0\u0dad\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0daf\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d85\u0dd2 \u0dad\u0dd2 \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2 \u0db1 \u0dd9\u0dd2\u0dba\u0dda\u0dd2\u0dc0 \u0dad\u0db8\u0dd2 \u0dc0\u0db1\u0daf\u0d9c\u0dad\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0d9a\u0dd2 \u0db1 \u0d91\u0dd9 \u0db8\u0db8 \u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dc3\u0dda\u0dae\u0dd2\u0dc1\u0dda\u0daf\u0dd3 \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0daf \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1 \u0dd9\u0db1\u0db8\u0db1\u0dad\u0dd2\u0dd2 .\n\n2459 2460\n\n\u0db4\u0dd2\u0dbb\u0dca\u0dd2\u0dba\u0dc1\u0db8\u0dca\u0db1\u0dca\u0daf\u0dad\u0dd4\u0dc0\n\n\u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0daf\u0dc0\u0dc3\u0dda\u0dc0\u0dbd \u0dc4\u0dd4 \u0d9a \u0dd9\u0dae\u0dd2 \u0dd9\u0dba\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0da2\u0db1\u0dd2\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dba\u0dda \u0d9c\u0db1\u0db1. \u0dbd\u0dd2\u0dbd\u0dd2\u0dc3\u0db1\u0dd2\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0daf\u0dd3\u0dad\u0dd4\u0db8\u0dd2 \u0db1\u0dd2 \u0daf\u0db1\u0db1\u0dca\u0daf \u0dc1\u0dda\u0dd2\u0d82\u0dd9\u0dd2\u0dc0 \u0dad\u0dd4\u0dc5 \u0d85\u0db4\u0da7 \u0d85\u0dc4\u0db1\u0dca\u0daf\u0db1 \u0dbd\u0db1\u0dc1\u0db6\u0db1 \u0dc1\u0dda \u0db8\u0dd2\u0db0\u0dba \u0dad\u0dd4\u0dc5 \u0d85\u0db4\u0da7 \u0d85\u0dc4\u0db1\u0dca\u0daf\u0db1 \u0dbd\u0db1\u0dc1\u0db6\u0db1 \u0dc1\u0dda \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dd2\u0dad\u0dca \u0dc1\u0db8\u0dca \u0dba\u0dc1\u0da7\u0dca \u0dc1\u0daf\u0dc1\u0dd9\u0ddd\u0da7\u0dd2 \u0dc0\u0dd2\u0db1\u0dca\u0dbd \u0d9a\u0dc2\u0dca\u0da8 \u0d9a \u0dc0\u0db1 \u0da2\u0db1\u0dad\u0dd2\u0dc0\u0da7 \u0dc3\u0dda\u0dc0\u0d9a\u0dd3 \u0d85\u0dba\u0ddd\u0db8\u0dad \u0dc4\u0dbb\u0dd2 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0db4\u0dd2\u0dc0\u0dd2\u0da0\u0dca\u0dd2 \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0daf \u0db8\u0dd2\u0dbb\u0dca\u0dc1\u0d9c\u0ddd\u0db4\u0dc1\u0dda \u0dd9\u0dad\u0dca\u0dc0 \u0d9a \u0dc0\u0dd2 \u0dad\u0dd4\u0dd2\u0d9c\u0db1\u0dca\u0daf \u0dbd\u0db1\u0dc1\u0db6\u0db1\u0dc0\u0dd2 \u0daf \u0d9a\u0dd2 \u0db1 \u0dd9\u0dd2\u0dba\u0dda\u0dd2\u0dc0 \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0db1\u0dca\u0daf\u0db1 \u0d95\u0db1\u0dd1. \u0d8b\u0daf\u0dd2\u0dc4\u0dba\u0dda \u0d9a \u0dc4\u0db1\u0da7\u0dd2 \u0da7 \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dd2\u0dad\u0dca \u0d86\u0dab\u0dca\u0da9\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dba\u0dc0\u0dc3\u0dda\u0dae\u0dd2\u0dc1\u0dda \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dc0\u0dba\u0dc0\u0dc3\u0dda\u0dae\u0dd2 \u0d9a\u0dd3\u0db4 \u0d9a \u0db4\u0dd2\u0dd2\u0d9c\u0db6\u0db3\u0dc0 -\u0da2\u0db1\u0dd2\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dba \u0dd2\u0dc1\u0dda \u0db0\u0dd4\u0dba \u0dd9\u0dd2\u0dbd \u0db4\u0dd2\u0dd2\u0d9c\u0db6\u0db3\u0dc0- \u0dc0\u0dd2\u0db8\u0dbb\u0dca \u0db1 \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1 \u0dc1\u0dbb\u0dda\u0dc2\u0dca\u0da8\u0dda\u0db0\u0dd2\u0db0\u0dd2\u0dd9\u0dba\u0dda \u0da7 \u0d9c\u0dd2\u0dd2 \u0dbd\u0dca\u0dbd\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dd2. \u0dc1\u0db8\u0dca\u0dd9 \u0dc1\u0db8\u0dca \u0dba\u0dc1\u0da7\u0dca \u0dc0\u0dd2\u0db4 \u0d9a\u0dc2\u0dca\u0da8 \u0db4\u0dd2\u0dc0\u0dd2\u0da0\u0dca\u0dd2 \u0dd9\u0dba\u0db1\u0dc0\u0dd2 \u0dc0\u0dbb\u0dca\u0dad\u0db8\u0dd2\u0db1 \u0da2\u0db1\u0dd2\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2 \u0d89\u0dad\u0dca\u0dc1\u0dad \u0d9a \u0daf\u0dd2\u0dbd\u0dd2 \u0d91\u0dad\u0dd4\u0db8\u0dd2\u0dc1\u0dda \u0db0\u0dd4\u0dba \u0dd9\u0dd2\u0dbd \u0dd2\u0d82\u0d9c\u0dd4 \u0dd9\u0dba\u0d9c\u0db1\u0dca\u0daf\u0db1 \u0dd9\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dd9\u0dba\u0db1\u0dc0\u0dd2 \u0d9a\u0dd2 \u0db1\u0dca\u0daf\u0db1. \u0dc1\u0db8\u0dca\u0dd9 \u0dc0\u0dd2\u0db4 \u0d9a\u0dc2\u0dca\u0da8\u0dc1\u0dad \u0dd9\u0dab\u0dca\u0da9\u0da9\u0dd2 \u0db8\u0dca \u0dad\u0db8\u0dd4\u0db1\u0dca\u0daf\u0dc1\u0dda \u0db4\u0da7\u0dd4 \u0dc1\u0dda \u0db4\u0dd2\u0dbd\u0db1 \u0db4\u0dba\u0db8\u0dd2\u0dbb\u0dca\u0dae \u0db8\u0dd4\u0dd4\u0db1\u0dca\u0daf \u0db4\u0db8\u0dd4\u0dab\u0dd4\u0dc0\u0dd2 \u0d9c\u0db1\u0dca\u0daf\u0db1 \u0da2\u0db1\u0dd2\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0d85\u0dc1\u0db4\u0dca \u0d9a\u0dc2\u0dca\u0da8\u0dd9 \u0d9a\u0dd4\u0dc1\u0dda \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dd2\u0dd9\u0dd2\u0dba\u0dd9\u0db8\u0dca \u0db4\u0dd2\u0dd2\u0d9c\u0db6\u0db3\u0dc0 \u0d85\u0db1\u0dd2\u0d9c\u0dad\u0dc1\u0dad \u0dc3\u0db8\u0dd2\u0da2 \u0db8\u0dad \u0dc1\u0dc0\u0db1\u0dc3\u0dda \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1 \u0daf\u0dba\u0db1 \u0d8b\u0dad\u0dca\u0dc3\u0dd2\u0dc4 \u0d9a. \u0dc1\u0db8\u0dca \u0dc0\u0dd2\u0dc1\u0dda \u0dad\u0db1\u0db1\u0dd9\u0da7 \u0d85\u0db4\u0dd2 \u0dd2 \u0dba\u0dd4\u0dad\u0dd4 \u0daf \u0d9a\u0dd2 \u0db1 \u0d91\u0dd9 \u0d85\u0db4\u0dd2 \u0dd2 \u0dad\u0dd2 \u0db6\u0dbd\u0db1\u0dca\u0daf\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0db4\u0da7 \u0d89\u0dc3\u0dda\u0dc3\u0dba\u0dc4\u0da7 \u0dc1\u0dc4\u0dd2\u0db3\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dd2 \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0daf \u0dc1\u0dc3\u0dbd\u0dca\u0dbd\u0db8\u0dca \u0db4\u0dd2\u0da7\u0dca\u0da7\u0db1\u0dd2 \u0d9a \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dd2. \u0dc3\u0db3\u0dc4\u0dd2 \u0d9c\u0db1\u0dc5\u0dc1\u0db4\u0db1 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dd9 \u0db1\u0dca\u0daf \u0dc3\u0dd9\u0dc3\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0daf\u0dc1\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8 \u0d9a. \u0d85\u0db4\u0dd2 \u0da2\u0db1\u0dd2\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dba\u0dda \u0da7 \u0d89\u0dd2\u0d82\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dc1\u0dc0\u0db1 \u0d85 \u0db4\u0dd2\u0dd2\u0d9c\u0db6\u0db3\u0dc0 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0daf\u0dc1\u0dda \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dd2\u0dd9\u0dd2\u0dba\u0dd9\u0db8\u0dca \u0db4\u0dd2\u0dd2\u0d9c\u0db6\u0db3\u0dc0 \u0d85\u0dc0\u0da0\u0dd9\u0dc0 \u0dd9\u0dae\u0dd2 \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1 \u0d85\u0dc0 \u0dba\u0dd2 . \u0d89\u0dad\u0dd2\u0db1\u0dca\u0daf \u0d91\u0dad\u0db1\u0db1\u0daf\u0dd3 \u0da2\u0db1\u0dd2\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dad\u0dba\u0d9c \u0da7 \u0d89\u0dd2\u0d82\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dc1\u0dc0\u0db1 \u0d85 \u0dc1\u0dda \u0dc1\u0dda \u0db4\u0dd2\u0dbd\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dd2\u0dd9\u0dd2\u0dba\u0dd9\u0db8\u0dca \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0daf \u0dba\u0da7 \u0dc1\u0d9c\u0dd2\u0da9 \u0d9c\u0db1\u0dca\u0daf\u0db1 \u0daf\u0dd2 \u0dd9 \u0dc0\u0dd4\u0dab\u0dd4 \u0d86\u0dd9\u0dd2\u0dba \u0dc0\u0dd2\u0dc1\u0dda \u0dc1\u0dda\u0dc0\u0dbd\u0dca \u0dd9\u0dae\u0dd2 \u0dd9\u0dba\u0db1\u0dc0\u0dd2 \u0db8\u0dd2\u0dc3 \u0d85\u0db7\u0dd6\u0dad \u0dc1\u0da0\u0ddd\u0daf\u0db1\u0dd2 \u0d89\u0dd2\u0d82\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dda\u0da7 \u0dc3\u0db8\u0dca\u0db4\u0db1\u0dca\u0daf\u0db1 \u0dc3\u0db8\u0dd2\u0da2 \u0dd9\u0da7 \u0d9c\u0db1\u0dc5\u0dc1\u0db4\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0db1\u0db1\u0dc4\u0db1 \u0d9a\u0dd2 \u0db1 \u0dd9\u0dd2\u0dba\u0dda\u0dd2\u0dc0 \u0dad\u0db8\u0dd2 \u0db8\u0da7 \u0db8\u0dad \u0d9a \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1 \u0dc1\u0dc0\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf."
