    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7 \u0d85\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dca \u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0dca \u0d85\u0dc1\u0dca\u0d9a\u0dca \u0db4\u0dca\u0dca \u0dc1 \u0da7\u0dd4 \u0db4\u0dad \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca \u0da2\u0daf\u0dad\u0dba\u0db1\u0dca\u0dad\u0dbb \u0dc0\u0dc0\u0dca\u200d\u0dcf\u0dba \u0d85\u0db0\u0dca\u200d\u0dba\u0daf\u0db4\u0dca\u0d9a\u0da7 \u0dca\u0db8\u0da7\u0daf\u0db8\u0dd3\u0dc0\u0dca\u200d \u0d85\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd3\u0db1\u0dca \u0d85\u0dc1\u0dda \u0db1\u0dd2\u0dda \u0daf\u0d9a \u0d85\u0dc1\u0dda \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda\u0dcf \u0dca \u0dca\u0dae \u0dbb \u0da7\u0db1\u0dca\u0dca\u0da7 \u0d8b\u0dca\u0dca\u0daf\u0dc4 \u0dcf\u0dbb\u0dca\u0dc0\u0dca\u200d\u0daf. \u0d94\u0db6 \u0dcf\u0db1\u0dca\u0dca\u0dc0\u0dca\u200d\u0daf \u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0dda \u0dcf\u0dbb\u0dd4\u0dc0\u0dca\u200d\u0db1\u0dca \u0dc3\u0dd2\u0d9a \u0dc4\u0dc1\u0dcf\u0dca\u0daf\u0da7\u0db8 \u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0dda \u0dbb\u0daf\u0da2\u0dba \u0dc0\u0dd2 \u0dae\u0dc0\u0dca\u200d\u0dc0\u0dd2\u0dcf\u0dba\u0daf\u0dbd \u0dad\u0dd4\u0dc5 \u0dc0\u0dc0\u0dca\u200d\u0dcf\u0dba \u0d85\u0db0\u0dca\u200d\u0dba\u0daf\u0db4\u0dca\u0d9a \u0dbd\u0db6\u0db1\u0dca\u0dca\u0da7 \u0dc1\u0dca\u0ddc\u0dc4\u0dbd\u0dd2\u0dbb \u0dc0\u0dca\u200d\u0dca \u0db6\u0dc0\u0dca\u200d. \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4 \u0dca \u0dbb\u0dca\u0dda \u0dbb \u0dc0\u0dd2 \u0dae\u0dc0\u0dca\u200d\u0dc0\u0dd2\u0dcf\u0dba\u0daf\u0dbd\u0da7\u0dad \u0dc0\u0dca\u200d\u0db1\u0dca\u0dca\u0da7 \u0d85\u0dc0\u0dca\u200d\u0dca\u0dae\u0dcf\u0daf\u0dc0\u0dca\u200d \u0dad\u0dd2\u0db6\u0dd4 \u0dca \u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0dda \u0db4\u0dc0\u0dca\u200d\u0dad\u0dd2\u0dca \u0dc3\u0dd3\u0db8\u0dd2\u0dad \u0db4\u0dc4\u0dc3\u0dd4 \u0db1\u0dd2\u0dca\u0daf \u0d87\u0dad\u0dbd \u0dc0\u0dd2\u0da7 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0d92 \u0d85\u0dc0\u0dca\u200d\u0dca\u0dae\u0dcf\u0daf\u0dc0\u0dca\u200d \u0dc1\u0dca\u0ddc\u0dbd\u0dbd\u0db6\u0dd3 \u0d9a\u0dca\u0dc0\u0dca\u200d\u0daf. \u0d92 \u0dc0\u0dca\u200d\u0daf\u0dc1\u0db4\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0db1\u0dc1\u0dca\u0dda \u0db8\u0dd6\u0dbd\u0dd2 \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4 \u0dca\u0db4\u0dd4\u0dbb\u0db4\u0dd4 \u0dad\u0dc0\u0dca\u200d\u0dca \u0dcf\u0dbb\u0dd4\u0dc0\u0dca\u200d\u0db1\u0dca \u0dbb\u0daf\u0dc1\u0dd2\u0d9a\u0d9a\u0dca \u0d85\u0db0\u0dca\u200d\u0dba\u0daf\u0db4\u0dca\u0d9a \u0dca\u0db3\u0dc4\u0daf \u0dc0\u0dd2\u0dc1\u0dda \u0da7\u0dad \u0dc1\u0dc0\u0dca\u200d\u0dca\u0dc0\u0dca\u200d\u0daf. \u0dc1\u0db8\u0dad\u0dd4\u0dc0\u0dca\u200d\u0d9a\u0dca \u0dbd\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dc0\u0dd2\u0db0\u0dd2\u0d9a\u0da7 \u0d92 \u0dc0\u0dd2 \u0dae\u0dc0\u0dca\u200d\u0dc0\u0dd2\u0dcf\u0dba\u0daf\u0dbd \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dca\u0dae\u0dc0\u0dca\u200d \u0dbd\u0db8\u0dbd\u0dca\u0dc1\u0dad\u0db1\u0dca \u0d85\u0d9a\u0daf\u0dd4 \u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dc1\u0db4 \u0dc0\u0dd2 \u0dae\u0dc0\u0dca\u200d\u0dc0\u0dd2\u0dcf\u0dba\u0daf\u0dbd\u0dc0\u0dca\u200d\u0dbd \u0d8b\u0db4\u0daf\u0db0\u0dd2\u0d9a \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82 \u0daf \u0dc0\u0dc0\u0dca\u200d\u0dcf\u0dba \u0dca\u0db7\u0daf\u0dc0\u0dca\u200d \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0da7\u0db1\u0dca\u0dca\u0da7 \u0d85\u0dc0\u0dca\u200d \u0dba \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dca \u0dca\u0dae \u0dbb\u0da7\u0db1\u0dca\u0dca\u0da7. \u0dca\u0dd4\u0dc4\u0dca \u0d94\u0db6 \u0dcf\u0db1\u0dca\u0dca\u0dc0\u0dca\u200d\u0daf \u0dc1\u0dbd\u0ddd \u0dc1\u0dda \u0d89\u0dad\u0daf \u0d89\u0dc4\u0dc5 \u0dc1\u0dc1\u0dca\u200d\u0dbb\u0dda\u0dab\u0dd2\u0da7\u0dad \u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0dca\u200d\u0dbd \u0dc3\u0dd2\u0dd2\u0dba\u0dca \u0dc0\u0dd2 \u0dae\u0dc0\u0dca\u200d\u0dc0\u0dd2\u0dcf\u0dba\u0daf\u0dbd\u0dc0\u0dca\u200d\u0dbd\u0da7 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82 \u0daf \u0dc0\u0dc0\u0dca\u200d\u0dcf\u0dba \u0dca\u0db7\u0daf\u0dc1\u0dda \u0dbd\u0dd2\u0d9a\u0daf\u0db4\u0daf\u0dd2\u0d82 \u0db8 \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dca\u0dca\u0da7 \u0d95\u0dca\u0dd1\u0d9a \u0dd2\u0dbb\u0d9a\u0daf \u0d85\u0db7\u0dd2\u0dbd\u0daf\u0dc2\u0d9a\u0d9a\u0dca \u0dca\u0dbd\u0dad\u0dd2 \u0db6\u0dc0\u0dca\u200d. \u0dc1\u0db8\u0ddc \u0dcf \u0db1\u0dd2\u0dda \u0daf\u0d9a \u0d85\u0db1\u0dd4\u0dc0\u0dca\u200d \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dc1\u0dbd\u0ddd \u0dc1\u0dda \u0d89\u0dc4\u0dc5\u0db8 \u0dc1\u0dc1\u0dca\u200d\u0dbb\u0dda\u0dab\u0dd2\u0da7\u0dad \u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0dca\u200d\u0dbd \u0dc3\u0dd2\u0dd2\u0dba\u0dca \u0dc0\u0dd2 \u0dae\u0dc0\u0dca\u200d\u0dc0\u0dd2\u0dcf\u0dba\u0daf\u0dbd\u0dba\u0dd2. \u0d89\u0dad\u0dd2\u0db1\u0dca \u0dc1 \u0db4\u0dca\u0dad\u0dca \u0dca\u0db8\u0d9f \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2 \u0d85\u0dc0\u0dca\u200d\u0dca\u0dae\u0dcf\u0daf\u0dc0\u0dca\u200d\u0d9a\u0dca \u0dbd\u0db6\u0daf \u0dc1\u0dcf\u0dca\u0dc0\u0dca\u200d\u0daf.\n\n337 338\n\n[\u0da7\u0dbb\u0dd4 (\u0dc0\u0dc0\u0dca\u200d\u0dcf\u0dba) \u0dc3\u0dd3\u0dad\u0daf \u0d85\u0dbb\u0dc1\u0db9\u0dc1\u0db4\u0ddc\u0dc5 \u0db8\u0dc4\u0dca\u0db8\u0dd2\u0d9a ]\n\n2024 \u0d85\u0dc1\u0da7\u0ddd\u0dca\u0dae\u0dad\u0dd4 08\n\n\u0dc1\u0dbd\u0ddd \u0dc1\u0dda \u0dc1\u0dc1\u0dca\u200d\u0dbb\u0dda\u0dab\u0dd2\u0da7\u0dad \u0dd2\u0dbb\u0dd3\u0db8 \u0db8\u0dad \u0db4\u0dcf\u0dca \u0dc1\u0dc0\u0dca\u200d\u0dbd\u0daf \u0db1\u0db8 \u0d8b\u0db4\u0daf\u0db0\u0dd2\u0db0\u0dca\u200d\u0daf\u0dbb\u0dd2\u0db1\u0dca\u0da7 \u0dbd\u0d82 \u0daf\u0dc0\u0dca\u200d \u0dad\u0dd4\u0dc5 \u0dc1\u0dca\u0dda\u0dc0\u0dca\u200d\u0d9a \u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0dca\u0db3\u0dc4\u0daf \u0dbd\u0d82 \u0daf\u0dc1\u0dda \u0dc0\u0dc0\u0dca\u200d\u0dcf\u0dba \u0dca\u0db7\u0daf\u0dc0\u0dca\u200d \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca \u0d85\u0dc0\u0dca\u200d \u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0da7\u0dbd\u0dd3\u0dba\u0db8 \u0dbd\u0db6\u0daf \u0dc1\u0dcf\u0db1\u0dca\u0dca\u0da7. \u0dc1 \u0db4\u0dca\u0dad \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca \u0d92 \u0dca\u0db3\u0dc4\u0daf \u0dc0\u0dca\u200d\u0dca \u0db8\u0dd6\u0dbd\u0dd2 \u0db4\u0dcf\u0dca\u0db8 \u0dc0\u0dca\u200d\u0dbd\u0dc1\u0da7\u0dca\u0dc0\u0dca\u200d\u0daf. \u0db1\u0d9a \u0d89\u0dad\u0daf \u0dc1\u0dc4\u0ddc\u0db3 \u0dad\u0dca\u0dca\u0dc0\u0dca\u200d\u0d9a\u0d9a\u0dca."
