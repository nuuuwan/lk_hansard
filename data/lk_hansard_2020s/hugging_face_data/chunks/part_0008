    "chunk_text": "\u0dc1\u0db8\u0dcf\u0d9a\u0d9a\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0dc1\u0dc0\u0db1\u0dc3 \u0db8\u0db8 \u0dc1\u0db8\u0dca \u0dc3 \u0dcf\u0dc4 \u0dab\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0dad \u0dd2 \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dca\u0daf \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 400\u0d9a\u0dca \u0d85 \u0d9c\u0dd1\u0dc1\u0dc0\u0d9c\u0dda\u0db1\u0dc0\u0dad\u0dca \u0db8\u0daf\u0dd2\u0daf \u0d85\u0db4\u0dd2 \u0d85\u0db4\u0db1\u0dba\u0db1 \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a \u0d9c\u0dda\u0db1 \u0d95\u0db1\u0dd1\u0daf \u0dc1\u0dda\u0dc1\u0dd3\u0dba \u0dc1\u0dc0\u0d9c\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0d9c\u0dda \u0dc0\u0dd2\u0dc1\u0dda\u0dc1\u0dd3\u0dba \u0dc1\u0dc0\u0d9c\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0d9c\u0dda \u0d85\u0db4\u0db1\u0dba\u0db1 \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0 \u0dba \u0d86\u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1 \u0d9a\u0dd0\u0db3\u0dc0\u0dcf \u0d9c\u0d9c\u0dda\u0db1 \u0d95\u0db1\u0dd1\u0daf\n\n\u0dc1\u0db8\u0dca \u0daf\u0dd2\u0dc4\u0dcf \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0dc1\u0d9a\u0ddd\u0dab\u0dc0\u0dbd\u0dd2\u0d9c\u0dda \u0db6\u0dbd\u0d9c\u0dda\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0d9c\u0dda\u0daf \u0d85 \u0d85\u0dc1\u0dda \u0dc1 \u0dc0 \u0dc1\u0db8\u0dcf\u0db1 \u0dc1\u0dda \u0d9a\u0dc5\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0d9c\u0dda\u0dc1\u0d9c\u0dda \u0dc1\u0db8\u0dca\u0dc0\u0dcf \u0d9a \u0d9c\u0dda\u0dc1\u0d9c\u0dda \u0da1\u0d9c\u0dda \u0dba \u0dc3\u0dd4\u0dc3\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0dd2\u0daf \u0d91\u0dc1\u0dc4\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0d85\u0db4\u0da7 \u0dc1\u0db8\u0dca \u0db8\u0dcf\u0dc3\u0dc1\u0dda \u0db8\u0dcf\u0dd2\u0db1\u0d9a \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0dc1\u0d9c\u0dc0\u0d9c\u0dda\u0db1\u0dad\u0dca \u0db6\u0dd0\u0dc4\u0dd0 \u0dc1\u0d9c\u0dda \u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0d9c\u0dda\u0dd3\u0dad\u0dd4