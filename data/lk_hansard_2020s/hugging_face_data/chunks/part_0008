be\u0bbf\u0baf\u0b99\u0bcd\u0b95\u0bb0) (The Hon. Jagath Priyankara) \u0d9c\u0dbb\u0dd4 \u0dbd\u0d82 \u0dcf\u0db4\u0da2\u0db4 \u0dd4\u0da2\u0db1\u0dd2 \u0dbd\u0d82\u0da2 \u0dda \u0dbd\u0d82\u0db4\u0dc5\u0db8\u0dd4 \u0daf\u0db1\u0dd2 \u0dbd\u0d82\u0d85\u0dd4\u0dbb\u0dd4 \u0dbd\u0d82\u200d\u0dbb \u0dae\u0da2 \u0dbd\u0d82 \u0da2 \u0dba\u0dd2. \u0dbd\u0d82\n\n\u0dbb\u0dca\u0dbd\u0da2\u0db4\u0dca\u0dcf \u0dbd\u0d82\u0d85\u0da2\u0db4\u0dcf\u0dba\u0db4\u0dcf \u0dbd\u0d82\u0dcf\u0dc4 \u0dbd\u0d82\u0d8a\u0da7 \u0dbd\u0d82\u0d85\u0daf\u0db4\u0dc5 \u0dbd\u0d82\u0dca \u0dcf\u0da2 \u0dbd\u0d82\u0da2\u0d9f\u0dd2\u0dca \u0dbd\u0d82\u0dd2\u0db1\u0dcf\u0dae\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0d86 \u0dbd\u0d82\u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0db4\u0dad\u0dca\u0da2 \u0dbd\u0d82\u0daf\u0da2 \u0dbd\u0d82 \u0da2\u0da2 \u0dbd\u0d82\u0dca \u0dcf\u0da2 \u0dbd\u0d82\u0dd4\u0dd2\u0db6\u0dca \u0dbd\u0d82\u0dd2\u0dc3 \u0db4\u0d9a \u0dbd\u0d82\u0daf\u0dd0\u0da9 \u0da7\u0dba\u0dd4\u0dad\u0dca\u0dcf\u0d9a\u0dca \u0dbd\u0d82\u0d85 \u0dca \u0dbd\u0d82\u0dd2\u0db1\u0dcf\u0dae\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0da7 \u0dbd\u0d82\u0dd2\u0db1 \u0db0\u0dca\u200d \u0dbd\u0d82 \u0daf\u0da2\u0daf\u0db4. \u0dbd\u0d82 \u0dcf\u0dae \u0dbd\u0d82\u0da2\u0db8\u0dd4\u0dad\u0dca \u0dbd\u0d82\u0db4\u0dc3\u0dd4\u0d9c\u0dd2 \u0dbd\u0d82 \u0db4\u0d9a \u0d86 \u0dbd\u0d82 ) \u0dbd\u0d82 \u0dbb\u0dca\u0dbd\u0da2\u0db4\u0dca\u0dcf \u0dbb\u0dd4 \u0daf\u0ddd \u0dbd\u0d82\u0d89\u0dcf\u0db4 \u0dbd\u0d82\u0dd2\u0dc3 \u0db4\u0d9a \u0dbd\u0d82\u0daf\u0dd4\u0db4\u0dc2\u0dae \u0dba\u0dcf\u0db4\u0daf \u0da7 \u0dbd\u0d82\u0db8\u0dd4\u0dc4\u0dd4\u0dab \u0dbd\u0d82\u0daf\u0dd4\u0db4\u0dca\u0da2\u0db4. \u0dbd\u0d82\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dbd\u0d82\u0d85\u0da2\u0db4\u0dcf\u0dba\u0db4\u0dcf \u0dad\u0dca \u0dbd\u0d82 \u0dbb\u0dca\u0dbd\u0da2\u0db4\u0dca\u0dcf \u0dbd\u0d82\u0d85\u0da2\u0db4\u0dcf\u0dba\u0db4\u0dcf \u0dad\u0dca \u0dbd\u0d82\u0da2\u0dd0\u0dd2\u0db1\u0dc4\u0dad\u0dca \u0dbd\u0d82 \u0daf\u0d9a\u0db4 \u0dbd\u0d82\u0dd2\u0dc3\u0dd2\u0dc3\u0db0\u0dca\u200d \u0dbd\u0d82\u0db4\u0dd0 \u0d9a\u0dca\u0da2\u0dcf \u0dbd\u0d82\u0dd2\u0dc3\u0dd2\u0dc3\u0db0\u0dca\u200d \u0dbd\u0d82\u200d\u0dbb\u0da2 \u0dbd\u0d82 ) \u0dbd\u0d82 \u0dbb\u0dca\u0dbd\u0da2\u0db4\u0dca\u0dcf \u0dbb\u0dd4\u0daf\u0dca\u0da7 \u0dbd\u0d82\u0dc4\u0db3\u0dd4\u0dca\u0daf\u0db4 \u0dbd\u0d82 \u0daf\u0da2\u0daf\u0db4 \u0dbd\u0d82\u0d85\u0dd2\u0dc5 \u0dbd\u0d82\u0daf\u0dd0 \u0d9a\u0db4 \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0da2\u0daf\u0db4. \u0dbd\u0d82\u0da2\u0db8\u0dd4\u0dad\u0dca \u0dbd\u0d82\u0db4\u0dc3\u0dd4\u0d9c\u0dd2 \u0dbd\u0d82\u0daf\u0daf\u0dcf\u0dae\u0daf\u0d9a\u0dad\u0dca \u0dbd\u0d82\u0d85\u0dd2\u0dc5 \u0dbd\u0d82\u0db1\u0dd4\u0dba\u0db4\u0db1\u0dd2 \u0dbd\u0d82\u0dcf\u0dc4 \u0dbd\u0d82\u0da2\u0db4\u0daf\u0dcf\u0d9c\u0da2 \u0dbd\u0d82\u0daf\u0dcf \u0db4\u0da7\u0dd4\u0daf \u0dbd\u0d82 \u0dbb\u0dca\u0dbd\u0da2\u0db4\u0dca\u0dcf\u0dd4\u0dbd\u0dba \u0d86 \u0dbd\u0d82\u0daf\u0dba\u0db4\u0db4\u0db4\u0dba \u0dbd\u0d82 \u0dba\u0da2 \u0dbd\u0d82\u0dd2\u0dc5\u0dbb\u0dd2\u0dcf\u0dae \u0dbd\u0d82\u0db8\u0dd4\u0dab \u0dbd\u0d82\u0d9c\u0dd0\u0dc4\u0dd4\u0dab\u0db4. \u0dbd\u0d82\u0d94\u0dc0\u0dd4\u0dca\u0da7 \u0dbd\u0d82 ) \u0dbd\u0d82\u0dcf\u0dc4\u0da2 \u0dbd\u0d82\u0d9a\u0db6\u0db4 \u0dbd\u0d82\u0d9c\u0dd0\u0dd3 ) \u0dbd\u0d82 ) \u0dbd\u0d82\u200d\u0dbb\u0db4 \u0ddd\u0d9c\u0dd2 \u0dbd\u0d82\u0daf\u0dd4\u0db4\u0dc2\u0dae \u0dba\u0dcf\u0db4\u0daf\u0d9a\u0dca \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0da2\u0daf\u0db4. \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0db1\u0dd2\u0dcf\u0db4 \u0dbd\u0d82\u0da2\u0da2 \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0d85\u0da2\u0db4\u0dcf\u0dba\u0dd4\u0da2\u0db4 \u0d9c\u0dca \u0dbd\u0d82\u0d85\u0dc4\u0dca\u0da2 \u0dbd\u0d82 \u0dd0\u0da2\u0dd0\u0dad\u0dd2\u0dba\u0dd2 \u0dbd\u0d82\u0dba\u0da2\u0dcf \u0dbd\u0d82 \u0dbd\u0d82 \u0dca\u0daf\u0dd4\u0db4 \u0dbd\u0d82 \u0dba\u0d9a\u0db4 \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0da2 \u0dbd\u0d82 ) \u0dbd\u0d82 \u0dbb\u0dca\u0dbd\u0da2\u0db4\u0dca\u0dcf \u0dbd\u0d82\u0da2\u0d9f\u0db4\u0dd2\u0db1\u0da7\u0dd4\u0daf\u0dca\u0da2 \u0dbd\u0d82\u0db1\u0dd2\u0dbb\u0dca\u0dbd \u0dbd\u0d82 \u0dba\u0d9a\u0db4 \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0da2 \u0dbd\u0d82\u0dd2\u0dc5 \u0daf\u0dba \u0dbd\u0d82\u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0db4\u0dad\u0dca\u0da2 \u0dbd\u0d82 \u0daf\u0da2\u0daf\u0db4\u0daf \u0dbd\u0d82\u0da2\u0dd0 \u0daf \u0dbd\u0d82\u0dd2\u0dbb \u0da2 \u0dbd\u0d82\u0d91 \u0dbd\u0d82\u0d9c\u0dd0\u0da2 \u0dbd\u0d82 ) \u0dbd\u0d82\u0d85\u0daf \u0db6\u0ddd\u0db0\u0dca\u200d \u0d9a\u0dca \u0dbd\u0d82\u0d9a\u0db6\u0db4 \u0dbd\u0d82\u0d9c\u0dca\u0da2 \u0dbd\u0d82\u0daf\u0dd0\u0da9 \u0dbd\u0d82\u0dd2\u0dc5\u0dd2\u0db6 \u0daf\u0dc5\u0d9a\u0dca \u0dbd\u0d82\u0d94\u0db6\u0dd4\u0da2\u0db4 \u0dbd\u0d82\u0dc4\u0db3\u0dd4\u0dca\u0daf\u0db4 \u0dbd\u0d82 \u0da2\u0d9a\u0db4 \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0da2\u0daf\u0db4\u0daf \u0dbd\u0d82\u0d91 \u0dcf\u0dae \u0dbd\u0d82\u0dc4\u0db3\u0dd4\u0dca\u0daf\u0db4 \u0dbd\u0d82 \u0da2 \u0dbd\u0d82\u0dad\u0dd2 \u0db6\u0da2\u0daf\u0db4 \u0dbd\u0d82\u0da2) \u0dbd\u0d82\u0d91\u0dc4\u0dd2 \u0dbd\u0d82\u0dcf\u0dad\u0dca\u0dad\u0dca\u0daf \u0dbd\u0d82\u200d\u0dbb\u0d9c\u0dad\u0dd2 \u0dbd\u0d82 \u0dcf\u0dae\u0daf \u0dbd\u0d82\u0dd2\u0dbb \u0d9a\u0db4."
