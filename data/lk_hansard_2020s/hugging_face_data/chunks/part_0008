d\u0db1\u0db1\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd9 \u0d85\u0dad\u0dd2\u0d9a\u0dca\u0daf \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d94\u0db4\u0dca\u0db4\u0dd4 \u0dbd\u0db3\u0dcf\u0daf\u0dd3\u0dd9 \u0d9c\u0dad\u0ddd\u0dbb\u0dcf\u0d9c \u0db1 \u0d87\u0dd2\u0db1 \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0dc3\u0d82\u0d9b\u0dba\u0dcf\u0dc0 \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0d9c\u0dba\u0ddd\u0db1\u0db1\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd9\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0d9c\u0dc0\u0dca\u0daf \u0d9c\u0dc0\u0dca\u0daf\u0dc0 \u0db4\u0dc4\u0dc3\u0dad \u0db4\u0dd2\u0d9a\u0daf\u0dd2 \u0d9c\u0dda.\n\n\u0dc1 \u0dc0\u0dca\u200d\u0dca\u0dc0\u0dd2\u0da7 \u0dca\u0daf\u0da7\u0dbb\u0dd2 \u0dca\u0d82\u0dc0\u0dca\u200d\u0dda\u0db0\u0dca\u200d\u0dca \u0d85\u0db0\u0dd2 \u0daf\u0dbb\u0dd2\u0d9a \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0d89\u0daf\u0dd2 \u0dbb \u0d85\u0dc0\u0dca\u200d\u0dca\u0db1\u0dca \u0dbb\u0dca \u0dbd\u0dcf \u0dc4\u0daf \u0db1\u0dd2\u0dc0\u0dca\u200d\u0daf\u0dca\u0dbd\u0daf\u0dd3 \u0db1\u0dca \u0db4\u0daf\u0dd2\u0d82 \u0db8 \u0dbb\u0dca \u0dbd\u0dcf \u0db1\u0dd2\u0dc0\u0dca\u200d\u0daf\u0dca \u0dc0\u0dca\u200d\u0dba\u0daf\u0db4\u0dd2\u0dad\u0dd2 24 \u0d9a\u0dca \u0db4\u0dc0\u0dca\u200d\u0dad\u0dd3. \u0d92 \u0d85\u0dad\u0dd4\u0dbb\u0dd2\u0db1\u0dca \u0d85\u0daf\u0dd2\u0d9a\u0dbb 2\u0d9a\u0dca \u0d94\u0dca\u0dae\u0dc1\u0dca\u0dda \u0dc4\u0dd2\u0db8\u0dd2 \u0d94\u0dda\u0db4\u0dd4 \u0dbd\u0db6\u0daf \u0daf\u0dd3\u0db8\u0da7 \u0db1\u0dd2\u0d9a\u0db8\u0dd2\u0dad \u0d85\u0dad\u0dbb \u0db4\u0dc5\u0dd4\u0dc4 \u0d85\u0daf\u0dd2\u0d9a\u0dbb \u0d9a\u0da7\u0dc1\u0dca\n\n\u0dca\u0db8\u0dca\u0dae\u0dad \u0db1\u0dd2\u0dc0\u0dca\u200d\u0daf\u0dca \u0d92 \u0dca\u0d82\u0d9b\u0dca\u200d\u0dba\u0daf\u0dc0\u0dca\u200d - 14 885\u0dd2\u0dbb.\n\n\u0d85\u0db1\u0dd4 \u0d85\u0d82 \u0d9a\n\n\u0db1\u0dd2\u0dc0\u0dca\u200d\u0daf\u0dca \u0d9a\u0dca\u200d\u0dbb\u0db8\u0d9a \u0db1\u0dd2\u0dc0\u0dca\u200d\u0daf\u0dca \u0dca\u0d82\u0d9b\u0dca\u200d\u0dba\u0daf\u0dc0\u0dca\u200d\n\n01