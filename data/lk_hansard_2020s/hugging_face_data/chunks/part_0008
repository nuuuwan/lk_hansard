    "chunk_text": "\u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dbb\u0dd4 \u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dd4\u0db1\u0dad\u0db1\u0dd2, \u0dad\u0dad \u0dc1\u0dda \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc1\u0dda \u0dc1\u0dda \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0da7. Z-score \u0d91\u0d9a\u0da7 \u0dc0\u0dd2 \u0db1\u0dcf\u0d9a\u0dad\u0d9a\u0dca \u0dbd\u0dd0\u0dc1\u0db6\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dbb\u0da2\u0dca\u200d\u0dc1\u0dd2 \u0db4 \u0dc0\u0dd3\u0dda\u0dc0\u0dbd\u0daf\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd4\u0db1\u0dad\u0dcf\u0dc0 \u0dc1\u0dd9\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dad\u0dad\u0dba\u0dd2 \u0dc1\u0dda \u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf\u0dc0 \u0dd4\u0db1\u0dc5\u0dd2\u0db1\u0dca \u0dbb\u0dd4 \u0da9\u0dbd\u0dc3\u0dca \u0d85\u0dbd\u0dc4\u0db4\u0dca\u0dc1\u0db4\u0dbb\u0dd4\u0dad \u0dad\u0dd0\u0d85\u0d82\u0dd4\u0db1\u0dad\u0dcf \u0d9a\u0dbb\u0dd4\u0dab\u0dd4\n\n\u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d9a\u0dcf\u0dbd\u0dc1\u0dd2 \u0d85\u0db4\u0dd2 \u0dc1\u0db6\u0dbd\u0dca\u0dc0\u0dd4\u0da9\u0dca \u0dc1\u0dc3\u0dde\u0db1\u0dca\u0dd9\u0dbb\u0dca\u0dba \u0db1\u0dd2\u0dc1\u0d9a\u0dca\u0dad\u0db1\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf. \u0dc1\u0db6\u0dbd\u0dca\u0dc0\u0dd4\u0da9\u0dca \u0dc1\u0dc3\u0dde\u0db1\u0dca\u0dd9\u0dbb\u0dca\u0dba \u0dd3\u0dba\u0dc3\u0dba, \u0da0\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc1\u0dbd\u0dca\u0db1\u0dcf \u0dc1\u0db4\u0dc1\u0dbb\u0dca\u0dbb\u0dcf, \u0dc1\u0dc3\u0ddd\u0dad\u0dc3\u0dd2\u0dd2\u0db4 \u0dad\u0dd0\u0dd9\u0dc1 \u0dd9\u0dbb, \u0da0\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc1\u0dc3 \u0db1 \u0dc1\u0dc4\u0da7\u0dca\u0dd2 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2, \u0dc2\u0dbb\u0dca\u0dbd\u0dd2 \u0ddb\u0dc0\u0da2\u0dca\u200d\u0dba\u0db1\u0dca\u0dad, \u0da0\u0db1\u0dca\u0dd9\u0db1 \u0dbd\u0dd2\u0dba\u0db1\u0dcf\u0dbb\u0da0\u0dca\u0da0\u0dd2, \u0db4\u0dca\u200d\u0dbb\u0dd2\u0db1\u0dca\u0dc3\u0dca \u0d8b\u0dd9\u0dba \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db1\u0dca\u0dad \u0dc0\u0dcf\u0dc1\u0dda \u0dbd\u0dcf\u0d82\u0d9a\u0dcf\u0dc1\u0dda \u0da2\u0dca\u200d\u0db1\u0d9a\u0dcf\u0db1\u0dca\u0dad \u0dcf\u0dba\u0d9a\u0dba\u0db1\u0dca\u0da7 \u0dc1\u0dad\u0ddd\u0dad\u0dd0\u0db1\u0dca\u0db1\u0d9a\u0dca \u0dc0\u0dd4\u0dab\u0dcf. \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dbd\u0d9a\u0dca\u0dc2 50\u0d9a\u0dca \u0dc0\u0dd2\u0dba\u0dd9\u0dda \u0d9a\u0dbb\u0dbd\u0dcf \u0d92 \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc1 \u0ddc\u0da9 \u0dd9\u0dad\u0dcf \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca, \u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dbb\u0dd4 \u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dd4\u0db1\u0dad\u0db1\u0dd2. \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dbd\u0d9a\u0dca\u0dc2 50\u0d9a\u0dca \u0dc0\u0dd2\u0dba\u0dd9\u0dda \u0d9a\u0dbb \u0d92 \u0dc1\u0dc3\u0dde\u0db1\u0dca\u0dd9\u0dbb\u0dca\u0dba \u0db1\u0dd2\u0dc1\u0d9a\u0dca\u0dad\u0db1\u0dba \u0dc1 \u0ddc\u0da9 \u0dd9\u0dad\u0dcf \u0dc1\u0dad\u0ddc , \u0d8b\u0dc3\u0dc3\u0dca \u0dc1\u0db4\u0dc5 \u0dc4\u0dd9\u0dcf\u0dbb\u0db4\u0dd4 \u0dad\u0dbb\u0dd4\u0dab \u0dad\u0dbb\u0dd4\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0da7 \u0d92 \u0dc0\u0dcf\u0dc1\u0dda \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a\u0da7 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0d9a\u0dca\u0d85\u0d82\u0dba \u0db8\u0dd4\u0dc0\u0dc4 \u0d9a\u0dbb \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca; \u0dd9\u0d9a\u0dca\u0dc2\u0dad\u0dcf\u0dc0 \u0db8\u0dd4\u0dc0\u0dc4 \u0d9a\u0dbb \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca; \u0d9a\u0dbd\u0dcf\u0dc0 \u0db6\u0db6\u0dc5\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0dc1\u0dda \u0dc1\u0db6\u0dbd\u0dca\u0dc0\u0dd4\u0da9\u0dca \u0dc1\u0dc3\u0dde\u0db1\u0dca\u0dd9\u0dbb\u0dca\u0dba \u0db1\u0dd2\u0dc1\u0d9a\u0dca\u0dad\u0db1\u0dba \u0dc0\u0dcf\u0dc1\u0dda \u0d86\u0dba\u0dad\u0db1 \u0d9a\u0dca\u0d85\u0d82\u0dad \u0dc1\u0db1\u0ddc\u0d9a\u0dbb \u0dbb\u0dcf \u0dc0\u0dd0\u0dc1\u0da7\u0db1 \u0dad \u0dc0\u0dba\u0da7 \u0db4 \u0d9a\u0dbb\u0dbd\u0dcf \u0d85\u0d82\u0dc1\u0db6\u0dda\u0daf\u0dd3 \u0dad\u0dbb\u0dd4\u0dab \u0dc1\u0dc3 \u0dc0\u0dcf \u0dc3\u0db7\u0dcf\u0dc0 \u0dc1\u0dad\u0ddc\u0d9a\u0d9a\u0dca\u0dd9 \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca?"
