    "chunk_text": "\u0d8a\u0dc5 \u0dd9\u0dd2\u0dba\u0dda\u0dd2\u0dc0 \u0dc4\u0db1\u0da7\u0dd2 \u0da7 \u0db8\u0db8 \u0daf\u0d9a\u0dd2\u0db1\u0dc0\u0dd2 \u0d85\u0db4\u0dc1 \u0ddd\u0da2\u0db1 \u0da7 \u0dbd \u0d9a \u0dc1\u0dc0\u0da0\u0dca\u0da0 \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0daf \u0db8\u0dd2\u0db0\u0dba \u0da7 \u0db1\u0dd2\u0dba\u0dd2\u0dc0\u0dba\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8. \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0daf\u0db0\u0dc1 \u0db1\u0dca\u0daf \u0daf \u0dd3\u0db8\u0dad\u0dd2 \u0dc1\u0d9c\u0dc1\u0db1\u0db1\u0dca\u0daf\u0db1 \u0d9a\u0dd2 \u0dd2 \u0db8\u0db8 \u0dc1\u0db8\u0dca \u0dc1\u0dc0\u0dbd\u0dd2\u0dc1\u0dda \u0dc1 \u0ddd\u0da2\u0db1\u0dd2 \u0dd9\u0dba\u0db1\u0dc0\u0dd2. \u0d9c\u0db1\u0db1 \u0d85\u0db4\u0dd2 \u0dd2\u0d82\u0d9c\u0dd2\u0db1\u0dca\u0daf \u0dd2\u0d82\u0d9c\u0da7\u0db8 \u0dc1\u0db8\u0dca \u0db4\u0dd2\u0dbb\u0dca\u0dd2\u0dba\u0dc1\u0db8\u0dca\u0db1\u0dca\u0daf\u0dad\u0dd4\u0dc1\u0dda \u0dd9\u0dae\u0dd2 \u0dd9\u0dc5\u0dad\u0dca \u0dad\u0dc0\u0db8\u0dad\u0dca \u0dc0\u0dd2 \u0dc3\u0db8\u0dd2\u0da2 \u0db8\u0dd2\u0db0\u0dba \u0dc4\u0dba\u0dc4\u0dd2 \u0dc1\u0dc4\u0ddd \u0db1\u0dca\u0dda\u0db0 \u0dc1\u0dc0\u0db1\u0dc0\u0dd2.\n\n\u0d89\u0da9\u0db8\u0dca \u0dc3\u0dc4 \u0dc1\u0dda\u0db4\u0dc5 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0daf\u0db0\u0dc1 \u0db1\u0dca\u0daf \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dd2\u0dad\u0dca \u0db4\u0db1\u0dc1\u0dad\u0dca \u0d91\u0dd9 \u0dc0\u0d9c\u0db1\u0dca\u0daf\u0dad\u0dd2 \u0d9a \u0dad\u0dd2\u0db6\u0dd4\u0dda\u0dd2 \u0db4\u0dc3\u0dd4 \u0d8b\u0dbb\u0dd4\u0db8 \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0daf \u0dd9\u0dba\u0dbd\u0dd2 \u0db1\u0db1\u0dad\u0dd2 \u0dad\u0db1\u0db1\u0dca\u0daf\u0dc0\u0dbd\u0daf\u0dd3 \u0d91 \u0db4\u0dc0\u0dd4\u0dc1\u0dbd\u0dca \u0dc0\u0db1\u0da9\u0dd2\u0db8\u0dbd\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0db8\u0dd2 \u0dc5\u0db8 \u0dd2\u0da7\u0dd2 \u0d9a\u0dd2 \u0dbd\u0dd2. \u0db4\u0dc3\u0dd4\u0dc0 \u0dd9 \u0dc1\u0dc0\u0db1\u0dc3\u0dda \u0dc0\u0dd4\u0dda\u0dd2 \u0d9c \u0d89\u0da9\u0dc1\u0db8\u0dca \u0db4\u0dd2\u0d82\u0da0\u0dd2 \u0dc1\u0dc4\u0ddd \u0dc0\u0db1\u0da9\u0dd2\u0db8\u0dbd\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0db8\u0dd2 \u0dc5\u0db8 \u0dd2\u0da7\u0d9c \u0dd4\u0d9a\u0dc1\u0dc0\u0db1\u0dca\u0daf. \u0db8\u0db8 \u0dd2 \u0dad\u0db1\u0dc0\u0dd2 \u0d9c\u0dc0\u0db1\u0da9\u0dd2\u0db8\u0dbd\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0db8\u0dd2 \u0dc5\u0db8 \u0dd2\u0da7\u0d9c \u0d9a\u0dd2 \u0dbd\u0dd2 \u0db1\u0dd2 \u0dda\u0dd2\u0dad\u0dc0 \u0d9a\u0dd2 \u0db1 \u0d91\u0dd9 \u0d9c\u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0daf\u0dc1\u0dda \u0dd9\u0db1\u0db8\u0db1\u0dad\u0dca\u0dad \u0db4\u0dbb\u0dd2\u0dd2\u0d82\u0d9c \u0d9a\u0dd2 \u0dbd\u0dd2 \u0dc1\u0dc4\u0ddd \u0dc1\u0dc0\u0db1\u0dc3\u0dda \u0dc1\u0dc0\u0db1\u0dc0\u0dd2 \u0db1\u0db8\u0dca \u0dc3\u0dd4\u0dd4\u0dc3\u0dd4\u0dd2 \u0d9a\u0dd2 \u0dd2. \u0dc1\u0db8\u0dd2\u0dd9\u0daf \u0dc3\u0db8\u0dc4\u0dba \u0dc1\u0dc0\u0dbd\u0dd2\u0dc0\u0da7 \u0db4\u0dc0\u0dd4\u0dc1\u0dbd\u0dca \u0dc0\u0db1\u0da9\u0dd2\u0db8\u0dbd\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0db8\u0dd2 \u0dc5\u0db8 \u0dd2 \u0dc1\u0daf\u0db8\u0dda\u0db4\u0dd2 \u0db1\u0dca\u0daf\u0da7 \u0dc3\u0dbd\u0dd9\u0dbd\u0dd2\u0dad\u0dca \u0db1\u0db1\u0dad\u0dd4\u0dc0 \u0d87\u0dad\u0dd2. \u0db1\u0dd2\u0dc3\u0dd2 \u0dc3\u0da0\u0dc1 \u0ddd\u0db0\u0db1 \u0d86\u0dd9\u0dd2\u0dba \u0da7 \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1 \u0d9a\u0dd2 \u0dbd\u0dd2\u0dad\u0dca \u0db8\u0dd2 \u0d89\u0dbd\u0dca\u0dbd\u0dd2 \u0db1\u0dca\u0da7\u0dd2\u0db1\u0dc0\u0dd2.\n\n\u0d85\u0db0\u0dd2\u0dd9\u0dba\u0dda \u0db6\u0db1\u0dca\u0daf\u0db0\u0db1\u0dd2\u0d9c\u0dd2\u0dba \u0dd9\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dc4 \u0d86\u0dab\u0dca\u0da9\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dba\u0dc0\u0dc3\u0dda\u0dae\u0dd2 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0da0\u0dc3\u0dda\u0dd9\u0dba\u0dda \u0d85\u0db8\u0dd2\u0dad\u0dba\u0dad\u0dd4\u0db8\u0dd2 \u0dc1\u0d9c\u0dc1\u0db1\u0db1 \u0dbd\u0daf \u0db4\u0db1\u0dad\u0dca \u0dc1\u0dd9\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad \u0d9a \u0dc3\u0dc4 \u0db1\u0dd2\u0dc1 \u0ddd\u0d9c \u0d9c\u0db1\u0db1\u0dd2 \u0d85\u0daf \u0dc3\u0dd2\u0dd9\u0da0\u0dca\u0da1\u0dd2 \u0dc1\u0dc0\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf. \u0db1\u0dd2\u0dc3\u0dd2 \u0db6\u0db1\u0dca\u0daf\u0db0\u0db1\u0dd2\u0d9c\u0dd2\u0dba \u0d9c\u0db1\u0db1\u0dad\u0dca \u0db8\u0db8 \u0db8 \u0d9a \u0d9a\u0dd2 \u0db1\u0dca\u0daf\u0db1 \u0d95\u0db1\u0dd1. \u0db8\u0dd1\u0dad\u0dd9\u0daf\u0dd3 \u0db8\u0da7 \u0db6\u0db1\u0dca\u0daf\u0db0\u0db1\u0dd2\u0d9c\u0dd2\u0dba \u0dad\u0dd4\u0dc5\u0da7 \u0db1\u0dca\u0daf\u0db1 \u0db1\u0dca\u0dda\u0db0 \u0dc0\u0dd4\u0dda\u0dd2. \u0db8\u0db8 \u0d91\u0dd2 \u0daf\u0dd3 \u0daf\u0db1 \u0d9a\u0dd9\u0dd2 \u0d9c\u0db1\u0dca\u0dba\u0dd9\u0dbb\u0dd4\u0dc1\u0dc0\u0ddd \u0db8\u0dd4\u0d9a\u0dc2\u0dca\u0da8\u0dba\u0dc1 \u0ddd \u0d9c \u0d9a\u0dd2 \u0dbd\u0dd2 \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0daf \u0dd9\u0dba \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dd2. \u0dc4\u0db1\u0db6\u0db1\u0dd2 \u0dd9 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0db6\u0dd2\u0dad\u0dca\u0dad\u0dd2\u0dc1\u0dad \u0dc0\u0dd2\u0dad\u0dba \u0d9a\u0dc1\u0daf\u0ddd \u0d9a\u0dd2 \u0dd2 \u0db8\u0da7 \u0dd2 \u0dad\u0dd4\u0dda\u0dd2 \u0dd9\u0dd2\u0db1\u0dca\u0daf\u0dad\u0dd2 \u0dbb\u0dd0\u0db3\u0dc0\u0dd2 \u0db1\u0dca\u0daf \u0db1\u0dca\u0da7\u0dd2\u0db1 \u0dc3\u0dda\u0dae\u0dd2\u0db1 \u0da7 \u0d9c\u0dd2 \u0dd2\u0da7 \u0db4\u0dc3\u0dda\u0dc1\u0dc3\u0dda. \u0d9c\u0dbb\u0dd4 \u0dba\u0dd2\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dd9\u0dd2\u0db1\u0dca\u0daf\u0dad\u0dd2\u0dc0\u0dd9 \u0dc4\u0db1\u0da7\u0dd2 \u0da7 \u0db8\u0da7 \u0dbd\u0da2\u0dca\u0da2\u0dd2 \u0d9a\u0dd2 \u0db1\u0dca\u0daf\u0db1 \u0dd9\u0dd2\u0db1\u0dca\u0daf\u0dad\u0dd2 \u0dbb\u0dd0\u0db3\u0dc0\u0dd2 \u0db1\u0dca\u0daf check \u0dd9\u0dba\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0dc3\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dda\u0dc1 \u0db1\u0dca\u0daf\u0db8 \u0d87 \u0dc1\u0dda \u0db1\u0dd6\u0dbd\u0dca \u0dc1\u0db4\u0dd2\u0da7 \u0d9a\u0dc0\u0dad\u0dca \u0db1\u0db1\u0dad\u0dd2 \u0dc0\u0db1 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0db1\u0dd2\u0dbb\u0dd4\u0dc0\u0dad\u0dca \u0dd9\u0dba\u0dbd\u0dd2\u0dd2 . [\u0db6\u0dd2\u0db0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9a] \u0dbd\u0dd2\u0dbd\u0dd2\u0dc3\u0db1\u0dd2\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0daf\u0dd3\u0dad\u0dd4\u0db8\u0dd2 \u0db1\u0dd2 \u0db8\u0db8 \u0daf\u0db1\u0dca\u0daf\u0db1\u0dc0\u0dd2 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dd2 \u0d94 \u0d9a\u0dd2 \u0db1\u0dca\u0daf\u0db1 \u0dc4\u0daf\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0db8\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0dad\u0dc0\u0dad\u0dca \u0db8\u0dd2\u0db1\u0dd2\u0dad\u0dca\u0dad\u0dd4 \u0dc1\u0daf\u0dd9 \u0d9a \u0db4\u0db8\u0dda\u0dd2 \u0d9a\u0dd2 \u0dbd\u0dd2 \u0db6\u0dc0.\n\n\u0dd9\u0dd2\u0db1\u0dca\u0daf\u0dad\u0dd2 \u0dbb\u0dd0\u0db3\u0dc0\u0dd2 \u0db1\u0dca\u0daf Prison Hospital \u0d91\u0dd9\u0da7 \u0dc1\u0d9c\u0db1\u0dd2 \u0dbd\u0dd2 \u0db1\u0db1\u0dc0\u0dad \u0dc1\u0d9c\u0db1 \u0d86\u0dc0\u0dad\u0dca \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0daf\u0dc0 check \u0dd9\u0dba\u0db1\u0dca\u0daf\u0dc1\u0db1\u0dca\u0daf \u0db1\u0dd2\u0dbb\u0dd4\u0dc0\u0dad\u0dca \u0dd9\u0dba\u0dbd\u0dd2\u0dd2 . \u0dad\u0dd2 \u0d9a\u0dc2\u0dca\u0da8\u0dda \u0dc1\u0db8\u0da0\u0dca\u0da0\u0dba \u0dd2\u0d82\u0dba\u0dd4\u0dab\u0dd4 \u0dc1\u0dbd\u0ddd\u0dd9\u0dc1\u0dad scanner \u0d91\u0dd9 \u0d9a \u0dc0\u0dd2\u0dc1\u0dda \u0dc1\u0daf \u0d9a \u0dc1\u0d9c\u0db1\u0db1\u0dbd\u0dca\u0dbd\u0dd2 \u0dc1\u0dc4\u0ddd \u0d85 check \u0dd9\u0dba\u0db1\u0dca\u0daf\u0db1 \u0db6\u0db1\u0dbb\u0dd2 \u0d87\u0dd2 \u0d9a\u0dd2 \u0dbd\u0dd2 \u0db8\u0db8 \u0d85\u0dc4\u0db1\u0dc0\u0dd2. \u0dd9\u0dd2\u0db1\u0dca\u0daf\u0dad\u0dd2 \u0db1\u0dd2\u0dbd\u0db0\u0dd2\u0dbb\u0dd2\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db1\u0dca\u0db1\u0dca\u0daf \u0dd9\u0dd2\u0db1\u0dca\u0daf\u0dad\u0dd2 \u0dbb\u0dd0\u0db3\u0dc0\u0dd2 \u0db1\u0dca\u0daf check \u0dd9\u0dba\u0db1\u0dc0\u0dd2 \u0dc1\u0dc0\u0db1\u0dca\u0daf\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0daf. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0db1\u0dd2\u0dbb\u0dd4\u0dc0\u0dad\u0dca \u0dd9\u0dba \u0db4\u0dbb\u0dd3 \u0d9a\u0dc2\u0dca\u0da8\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dad\u0dd4\u0dd2\u0d9c\u0db1\u0dca\u0daf \u0dbb\u0dd0\u0db3\u0dc0\u0dd2 \u0db1\u0dca\u0daf\u0dc1\u0dda \u0d86\u0dad\u0dca\u0db8 \u0dc1\u0d9c\u0dca\u0dba\u0dc0 \u0db1\u0dca\u0db3 \u0daf\u0db1\u0db8\u0dd3\u0db8 \u0d9a \u0dc0\u0db1\u0dc0\u0dd2 \u0d9a\u0dd2 \u0dd2 \u0db8\u0db8 \u0dd2 \u0dad\u0db1\u0dc0\u0dd2."
