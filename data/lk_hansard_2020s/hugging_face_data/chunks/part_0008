    "chunk_text": "\u0b95\u0b9f\u0ba8\u0bcd\u0ba4 2 \u0bb5\u0bb0\u0bc1\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb2\u0bb3 \u0ba8\u0bbe\u0b9f\u0bcd\u0b95\u0b9f \u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bc1 \u0ba4\u0bb5\u0bb3\u0bbf\u0ba8\u0bbe\u0b9f\u0bc1 \u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0ba4\u0b9a\u0ba9\u0bcd\u0bb1\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b87\u0b95\u0bb3\u0b9e\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0b9f\u0baf \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0b95 \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bbe\u0ba4 \u0b85\u0bb3\u0bb5\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0ba4\u0bb5\u0bb3\u0bbf\u0ba8\u0bbe\u0b9f\u0bc1 \u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0ba4\u0b9a\u0bb2\u0bcd\u0bb5\u0ba4\u0ba4\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba4\u0b9a\u0bbe\u0ba9\u0bcd\u0ba9\u0bbe\u0bb2\u0bcd, \u0b85\u0b95\u0ba9\u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0b90\u0bb2\u0bb0\u0bbe\u0baa\u0bcd\u0baa\u0bbf\u0baf \u0ba8\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0ba4\u0b9a\u0bb2\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bb2\u0bcd\u0bb2. \u0b85\u0ba4\u0bbf\u0b95\u0bae\u0bbe\u0ba9\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0b95\u0bbf\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0ba4\u0b9a\u0ba9\u0bcd\u0bb1\u0bc1 \u0b95\u0bb7\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bb2, \u0baa\u0bb2 \u0b9a\u0bb5\u0bbe\u0bb2\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0b95\u0b99\u0bcd\u0ba4\u0b95\u0bbe\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0b9f\u0baf \u0b95\u0bc1\u0b9f\u0bc1\u0bae\u0bcd\u0baa\u0b9a\u0bcd \u0b9a\u0bc2\u0bc8\u0b95\u0bb2\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0b85\u0ba8\u0bcd\u0ba4 \u0bb5\u0b95\u0b95\u0baf\u0bbf\u0bb2\u0bb2, 2024 \u0ba4\u0b9a\u0baa\u0bcd\u0ba4\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bcd 21\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0ba8\u0b95\u0b9f\u0ba4\u0baa\u0bb1\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bb2\u0ba4\u0bb0\u0bcd\u0ba4\u0bb2\u0bbf\u0bb2\u0bb2 \u0b8e\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0b9f\u0baf \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0b95\u0bbe\u0bb2\u0bae\u0bcd \u0ba4\u0b99\u0bcd\u0b95\u0bbf\u0baf\u0bbf\u0bb0\u0bc1\u0b95\u0bcd \u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b8f\u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0bbf\u0b9f\u0bc1\u0bb2\u0bb5\u0bbe\u0ba4\u0bae\u0ba9\u0bcd\u0bb1 \u0b92\u0bb0\u0bc1 \u0bae\u0ba9\u0ba8\u0bbf\u0b95\u0bb2\u0baf\u0bbf\u0bb2\u0bcd \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bb2\u0bb5\u0ba3\u0bcd\u0b9f\u0bbf\u0baf \u0b85\u0bb5\u0b9a\u0bbf\u0baf\u0bae\u0bbf\u0bb2\u0bcd\u0b95\u0bb2. \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0baa\u0bcd\u0ba4\u0baa\u0bbe\u0bb4\u0bc1\u0ba4\u0bc1\u0bae\u0bcd \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0b95\u0bbe\u0bb2\u0ba4\u0bcd\u0b95\u0ba4 \u0bb2\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0bbf \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0b95\u0baf\u0bc1\u0b9f\u0ba9\u0bcd \u0baa\u0baf\u0ba3\u0bbf\u0b95\u0bcd\u0b95 \u0bb2\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd. \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0b95\u0b95\u0baf \u0b87\u0bc8\u0ba8\u0bcd\u0ba4 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bbe\u0b95 \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0bb2\u0baa\u0bbe\u0b95\u0bbf\u0ba9\u0bcd\u0bb2\u0bb1\u0bbe\u0bae\u0bbe? \u0b8e\u0ba9\u0bcd\u0bb1 \u0bb2\u0b95\u0bb3\u0bcd\u0bb5\u0bbf\u0b95\u0baf\u0ba4\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd \u0ba8\u0bbe\u0ba9\u0bcd \u0ba4\u0bae\u0bbf\u0bb4\u0bcd \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0b9f\u0bae\u0bcd \u0bb2\u0b95\u0b9f\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb2\u0bb1\u0ba9\u0bcd. \u0bb2\u0ba4\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd\u0bb2\u0baa\u0bbe\u0baf\u0bcd, \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0b9f\u0bcd\u0b95\u0b9f \u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd \u0ba4\u0b95\u0bbe\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb2\u0bb1\u0bbe\u0ba4\u0bae\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba4\u0b9a\u0bbe\u0bb2\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bbe\u0b95 \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0bb2\u0baa\u0bbe\u0b95\u0bbf\u0ba9\u0bcd\u0bb2\u0bb1\u0bbe\u0bae\u0bbe? \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bbf\u0b95\u0b9f\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0b9a\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0b95\u0ba4\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf, \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0b9f\u0baf \u0b85\u0bb0\u0b9a\u0bbf\u0baf\u0bb2\u0bcd \u0b89\u0bbe\u0bbf\u0b95\u0bae\u0b95\u0baf\u0baa\u0bcd \u0ba4\u0baa\u0bb1\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd \u0b95\u0b95\u0b95\u0b95\u0bb3 \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0bb2\u0baa\u0bbe\u0b95\u0bbf\u0ba9\u0bcd\u0bb2\u0bb1\u0bbe\u0bae\u0bbe? \u0b85\u0ba8\u0bcd\u0ba4 \u0bb5\u0b95\u0b95\u0baf\u0bbf\u0bb2\u0bcd, \u0b9a\u0bbe\u0bbf\u0baf\u0bbe\u0ba9 \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0ba9\u0ba4\u0bcd\u0b95\u0ba4 \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0ba4\u0b9a\u0baa\u0bcd\u0ba4\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bcd 21\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0b9f\u0baf \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0b9f\u0bc1\u0b95\u0bcd\u0b95 \u0bb2\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.\n\n\u0d87\u0dad\u0dca\u0dad\u0dc0 \u0dc1\u0dba\u0db1\u0dca\u0db8 \u0db8\u0db8 \u0d85\u0daf \u0daf\u0dd3\u0db0\u0db1\u0d9d \u0dc1\u0dc0\u0dbd\u0ddc\u0dc0\u0d9a\u0dca \u0dc1\u0daf\u0db8\u0dc5 \u0db7\u0ddc\u0dc2\u0ddc\u0dc1\u0dc0\u0db1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d9a\u0dae\u0ddc \u0d9a\u0dc1\u0dc5\u0dca. \u0dc1\u0db8\u0ddc\u0d9a\u0daf, \u0d85\u0daf \u0da2\u0db1\u0ddc\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dab\u0dba\u0da7 \u0dc1\u0daf\u0db8\u0dc5\n\n\u0dc3\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0db8\u0dca\u0db6\u0db0\u0db1 21\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0ddc \u0db4\u0dca\u200d\u0dbb \u0ddc\u0db1 \u0d85\u0dc1\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0d9a\u0dc1\u0dba\u0ddd \u0dad\u0dd4\u0db1\u0dca\u0dc1\u0daf\u0db1\u0ddc\u0dc1\u0d9c\u0db1\u0dca \u0d91\u0d9a\u0dca\u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dca \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0dca \u0da2\u0db1\u0ddc\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0ddc \u0dc1\u0dbd\u0dc3 \u0db4\u0dad\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0ddc. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4 \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0dca \u0da2\u0db1\u0ddc\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dc0\u0dd4\u0dab\u0dad\u0dca, \u0d92 \u0db4\u0dad\u0dca \u0dc1\u0dc0\u0db1 \u0da2\u0db1\u0ddc\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0ddc\u0da7 \u0d89\u0dad\u0ddc \u0dc0\u0dd2 \u0ddc\u0dbd \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0ddc. \u0dc1\u0db8\u0ddc\u0d9a\u0daf,\n\n873 874\n\n\u0db4\u0ddc\u0db0\u0db1\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0daf\u0d9a\u0dd4\u0dc1\u0dab\u0dca \u0da2\u0db1\u0dad\u0ddc\u0dc0 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d9a\u0ddc\u0dbd\u0dc1\u0dda\u0daf\u0dd3 \u0dc0\u0d82\u0da0\u0ddc, \u0db4\u0dad\u0dc2\u0dab\u0dc0\u0dbd\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0dda \u0dc0 \u0dc0\u0dd2 \u0ddc\u0dbd \u0d85\u0dbb\u0d9c\u0dc5\u0dba\u0d9a\u0dca \u0d9a\u0dc5\u0ddc. \u0d92 \u0d85\u0dbb\u0d9c\u0dc5\u0dc1\u0dba\u0db1\u0dca \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dca \u0db8\u0dd4\u0daf\u0dd4\u0dab \u0dc1\u0daf\u0db1 \u0db4\u0dca\u200d\u0dbb \u0ddc\u0db1 \u0da1\u0db1\u0dca\u0daf\u0dba \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0db8\u0dca\u0d9a. \u0d89\u0dad\u0dd2\u0db1\u0dca \u0dc1\u0db8\u0dca \u0da1\u0db1\u0dca\u0daf\u0dc1\u0dda\u0daf\u0dd3 \u0da2\u0db1\u0dad\u0ddc\u0dc0 \u0dc0\u0dd2 \u0ddc\u0dbd \u0dc1\u0dc0\u0db1\u0dc3\u0d9a\u0dca \u0db6\u0dbd\u0ddc\u0dc1\u0db4\u0ddc\u0dc1\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc. \u0d92 \u0dc1\u0dad\u0dca\u0dbb\u0dd3 \u0db4\u0dad\u0dca \u0dc0\u0db1 \u0d85\u0dc1\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0d9a\u0dba\u0ddc \u0da2\u0db1\u0dad\u0ddc\u0dc0\u0dc1\u0dda \u0db6\u0dbd\u0ddc\u0dc1\u0db4\u0ddc\u0dc1\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0d89\u0dc2\u0dca\u0da7 \u0dc1\u0db1\u0ddc\u0d9a\u0dc1\u0dc5\u0ddc\u0dad\u0dca, 2022\u0daf\u0dd3 \u0dc3\u0dd2\u0dd4 \u0dc0\u0dd4\u0dab\u0ddc\u0da7 \u0dc0\u0da9\u0ddc \u0dc0\u0dd2 \u0ddc\u0dbd \u0d85\u0dbb\u0d9c\u0dc5\u0dba\u0d9a\u0dca \u0db8\u0ddc\u0dc3 \u0d9a\u0dd2\u0dd2\u0db4\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d87\u0dad\u0dd2 \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0dc3\u0dca\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d92\u0d9a \u0db1\u0dd2\u0dc3\u0ddc \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0d85\u0dc1\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0dc0\u0d9c\u0d9a\u0dd3\u0dc1\u0db8\u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0ddc\u0dbd\u0dba\u0d9a\u0dca \u0dc1\u0db8\u0dca\u0d9a. \u0da2\u0db1\u0ddc\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dab\u0dba \u0daf\u0dd2\u0db1\u0dd4\u0dc0\u0ddc\u0da7 \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dca \u0dd3\u0db8\u0da7 \u0dc0\u0da9\u0ddc \u0dc0\u0d9c\u0d9a\u0dd3\u0dc1\u0db8\u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1."
  },
