    "chunk_text": "\u0dc0\u0dd0\u0daf\u0d9c\u0dca\u0dad\u0db8 \u0dc1\u0dda \u0dc1\u0dda \u0dba\u0dd2. \u0d85\u0db4\u0dd2 \u0dc1\u0dda \u0dc1\u0db3\u0ddc\u0dc1\u0dc4\u0ddd \u0dc1\u0dda \u0dcf\u0dcf \u0dc5\u0dca\u0dad, \u0d85\u0db4\u0dd2\u0dca\u0dad \u0db4\u0dd2\u0dd2\u0db6\u0d9c\u0dca\u0dad\u0db1\u0dc0\u0dcf \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0dc1\u0db8\u0dad\u0dd4\u0db8\u0dca\u0dad\u0dbd\u0dcf\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf, IMF \u0d91 \u0da7 \u0db8\u0dd3\u0da7 \u0dbd\u0dd2\u0dca\u0dad \u0dc1\u0dca\u0dad \u0dba\u0dca\u0dad\u0db1 \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0da9\u0dd4 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc4\u0dbb\u0dd2, \u0d85\u0db4\u0dd2 IMF \u0d91 \u0da7 \u0d9c\u0dd2\u0dba\u0dcf. \u0d85\u0db4\u0dd2 \u0d94\u0dc0\u0dd4\u0dca\u0dad \u0dc3\u0db8\u0db1 \u0dba\u0dda \u0dba\u0dda \u0d91 \u0db1\u0dad\u0dcf \u0dad\u0dad\u0dd2 \u0dbb\u0d9c\u0dca\u0dad\u0dad\u0dcf. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0dc0\u0dcf\u0dbb\u0dd2 3\u0d9a\u0dca \u0dab\u0dba \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dbd\u0db3\u0dcf\u0dc1\u0d9c\u0db1 \u0d85\u0db4\u0dd2 \u0dba\u0dda \u0db8\u0da7\u0dca\u0da7\u0db8\u0d9a\u0dd2\u0dca\u0dad \u0dc3\u0dae\u0dcf\u0dcf\u0dc0\u0dbb \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dcf. \u0d94\u0dc0\u0dd4\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0dca\u0dad\u0dc1\u0dca\u0dad \u0dc1\u0db8\u0ddc\u0db1\u0dc0\u0dcf\u0daf \u0dc1\u0dda \u0dc3\u0dcf\u0dc0\u0dd2\u0db0\u0dcf\u0db1 \u0dcf\u0dcf \u0dbb\u0dca\u0dad\u0dc1\u0dca\u0dad \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0d9c\u0dd0\u0db1 \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dba\u0dd2 \u0dc1\u0dca\u0dad. \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0da2\u0dd6\u0dbd\u0dd2 25\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dcf \u0dbd\u0dcf \u0dcf\u0dc0\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0da2\u0dca\u200d\u0dcf\u0dad\u0dba\u0dca\u0dad\u0dad\u0dbb \u0dd6\u0dbd\u0dbd\u0dba \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dc1\u0dbd\u0dca \u0dd6\u0dad\u0dad \u0da9\u0dd4\u0da9\u0dcf\u0dba\u0db8 \u0d85\u0dc1\u0d9c\u0ddd\u0dc3\u0dae\u0dad\u0dd4 02\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dcf \u0d85\u0dc1 \u0dbb\u0da7\u0dd2\u0dca\u0dad \u0db4\u0dd2\u0da7\u0dc0 \u0d9c\u0dd2\u0dba\u0dcf. \u0db1\u0dd0\u0dc0\u0dad \u0dba\u0db1\u0dc0\u0dd2\u0da7 \u0d94\u0dc0\u0dd4\u0dca\u0dad \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dbd\u0dd2 \u0db8\u0dcf\u0db0\u0dba \u0db1\u0dd2\u0dc1 \u0daf\u0db1\u0dba\u0d9a\u0dca \u0dbb\u0dbd\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0d9c\u0dd2\u0dc1\u0dda. \u0d92 \u0dca\u0dad \u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0daf\u0dd0\u0db1\u0d9c\u0dca\u0dad\u0db1, \u0db3\u0dbd\u0dcf\u0d9c\u0dca\u0dad\u0db1, \u0dc0\u0dd2 \u0dae\u0dc1\u0dbd\u0dca\u0dc2\u0dab\u0dba \u0dbb\u0dca\u0dad\u0db1 \u0d85\u0dc0 \u0dba\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8\u0db8 \u0dd2 \u0dad\u0db1\u0dc0\u0dcf. \u0d91\u0db8 \u0db8\u0dcf\u0db0\u0dba \u0db1\u0dd2\u0dc1 \u0daf\u0db1\u0dc1\u0dda \u0d91 \u0dc0\u0dcf \u0dba\u0dba \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dbd\u0dd2\u0dc0 \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dcf, \"\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf \u0dcf \u0db3\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dca\u0dad \u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0dad \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0da7 \u0db1\u0dcf\u0dc0\u0db1 \u0dbd\u0daf \u0dca\u0dbb\u0dca\u0dae\u0dd2 \u200d\u0dbb\u0dad\u0dd2\u0dc3\u0dcf\u0dc3\u0dae \u0dbb\u0dab, \u0d85\u0db1\u0da9\u0dd4\u0da9\u0dc0 \u0dcf\u0dbb\u0dca\u0dad\u0dd4 \u0dad\u0dd4\u0db1 \u0dd6\u0dbd\u0dbb\u0dca\u0dad \u0daf\u0dc5 \u0dc1\u0dda\u0dc1\u0dd3\u0dba \u0db1\u0dd2\u0dc2\u0dae\u0db4\u0dcf\u0daf\u0dd2\u0dad\u0dc1\u0dda \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba, \u0d85\u0d9a\u0dca \u0db4\u0dda\u0db0\u0db8\u0db1\u0dba, \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0dca\u0daf\u0dcf\u0dba\u0dda \u0dbb\u0dd0\u0dc3\u0dae \u0d9a\u0dd2\u0dd3\u0d9a\u0db8 \u0d89\u0dc4\u0dc5 \u0dba\u0dd1\u0db8 \u0dc3\u0dc4 \u0dc0\u0dd2\u0dc1\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0dcf\u0da0\u0dd2\u0dad \u0dc1\u0d9c\u0ddc\u0da9\u0db1\u0dd0\u0d9f\u0dd3\u0db8 \u0dc3\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dca\u0dbb\u0dca\u0dae\u0dd2 \u0dba \u0dba\u0dcf\u0dcf \u0dad\u0dca\u0dad\u0dca\u0dad\u0dc0\u0dba\u0da7 \u0db4\u0dca\u0dad \u0d9a\u0dd2\u0dd3\u0d9a\u0db8\u0da7 \u0d85\u0db1\u0da9\u0dd4\u0da9\u0dc0 \u0dc3\u0dc4\u0dcf\u0dba \u0db8 \u0dad\u0dad.\""
