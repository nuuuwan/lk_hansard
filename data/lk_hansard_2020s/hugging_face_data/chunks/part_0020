\u0d9a\u0db8\u0dd2\u0dd4\u0dc0 \u0dcf \u0dbb\u0dcf \u0dcf \u0dba, \u0db4\u0dca) \u0dbb\u0db4\u0da8\u0dcf \u0dd4\u0dc0\u0dda\u0db4\u0dad\u0dca\u0d9a\u0db8 \u0dad\u0dd4\u0dbb\u0dca \u0d9a\u0dbb\u0dca\u0db1 \u0dba\u0dca\u0db4\u0dca? Centre for Poverty Analysis \u0d91\u0d9a \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf, \u0d85\u0db4\u0dda \u0dbb\u0db4\u0da8\u0dcf \u0dd4\u0dc0\u0dda\u0db4\u0dad\u0dca\u0d9a\u0db8 \u0db1\u0dca\u0dba\u0dba 25\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dad\u0dc0\u0dad\u0dca \u0db3\u0db8\u0dcf \u0dbb \u0dd2\u0db6\u0dc1\u0dca\u0db1\u0db4\u0dda\u0dc2\u0d9a\u0dba\u0dd2\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf, \u0d85\u0db4\u0dda \u0dbb\u0db4\u0da8\u0dcf \u0dd4\u0dc0\u0dda\u0db4\u0dad\u0dca\u0d9a\u0db8 \u0db1\u0dca\u0dba\u0dba 40\u0dad\u0dca, 50\u0dad\u0dca \u0d85\u0dad\u0dbb \u0db4\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d91\u0dad\u0db4\u0d9a\u0dcf \u0db4\u0dca) \u0d85\u0db3\u0db1\u0dc0\u0db1\u0dd4\u0d9a\u0db4\u0db8\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca\u0dba, \u0dd4\u0dc0\u0dda\u0db4\u0dad\u0dca\u0d9a\u0db8 \u0dad\u0dd4\u0dbb\u0dca \u0d9a\u0dbb\u0dca\u0db1? \u0dd4\u0dc0\u0dda\u0db4\u0dad\u0dca\u0d9a\u0db8 \u0dad\u0dd4\u0dbb\u0dca \u0d9a\u0dbb\u0dca\u0db1 \u0dd2\u0dc2\u0db1\u0db4\u0dcf\u0dba\u0db1\u0dba \u0dad\u0dd2\u0db4\u0dbd\u0dca\u0db1 \u0d95\u0db1\u0dd1, \u0daf\u0dad\u0dd2\u0dd2\u0db4\u0d9a\u0dd2\u0dd3\u0db8\u0db8 \u0dad\u0dd2\u0db4\u0dbd\u0dca\u0db1 \u0d95\u0db1\u0dd1, \u0d86\u0db4\u0dba\u0ddd \u0db1\u0dba \u0dad\u0dd2\u0db4\u0dbd\u0dca\u0db1 \u0d95\u0db1\u0dd1, \u0db4\u0dd2\u0db4\u0db4\u0db7\u0ddd \u0db1\u0dba \u0dad\u0dd2\u0db4\u0dbd\u0dca\u0db1 \u0dad\u0dca \u0d95\u0db1\u0dd1, \u0d85\u0db4\u0db1\u0dba\u0db1\u0dba \u0dad\u0dd2\u0db4\u0dbd\u0dca\u0db1 \u0dad\u0dca \u0d95\u0db1\u0dd1. \u0d85\u0db3\u0db1\u0dc0\u0db1\u0dd4\u0d9a\u0db4\u0dca) \u0dad\u0dd2\u0db4\u0dbd\u0dca\u0db4\u0dca \u0db4\u0dd2\u0db4\u0db4\u0db7\u0ddd \u0db1\u0dba \u0dd2\u0db6\u0dad\u0dbb\u0dba\u0dd2.\n\n\u0d92 \u0dd2\u0db3\u0dcf \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0d9a\u0dbb\u0dbd\u0dcf, \u0dd4\u0dc0\u0dda\u0db4\u0dad\u0dca\u0d9a\u0db8 \u0dad\u0dd4\u0dbb\u0dca \u0d9a\u0dd2\u0dd3\u0db8\u0db8 \u0db3\u0dc4\u0dcf \u0dcf \u0db4\u0db8\u0db4\u0dad\u0d9a\u0dca \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0dd4 \u0db1 \u0db3\u0dd1\u0db8 \u0dc0\u0db1\u0da9\u0db3 \u0dcf \u0db1\u0d9a\u0dca\u0db8 \u0db4\u0dcf \u0dcf\u0db3\u0dd2\u0dca \u0db4\u0dd2\u0db4\u0dc1\u0dd3\u0dbd\u0db1\u0dba \u0d9a\u0dbb\u0dbd\u0dcf, \u0d92\u0dc0\u0dcf\u0db4\u0dbd \u0dad\u0dd2\u0db4\u0dbd\u0db1 \u0db4\u0dcf \u0dcf\u0dc4 \u0d9c\u0dd4\u0dab\u0dcf\u0dbb\u0d9c \u0da7\u0dd2\u0d9a \u0d85\u0dbb\u0db4\u0d9c\u0db1, \u0dc0\u0db1\u0dbb\u0dd2\u0dba \u0d85\u0da9\u0dd4\u0db4\u0dcf\u0da9\u0dd4\u0d9a\u0dca) \u0da7\u0dd2\u0d9a \u0daf\u0dc0\u0dad\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0d85\u0dab\u0dd4\u0dad\u0dca \u0dc0\u0db1\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0db4\u0dc0\u0dc5\u0d9a\u0dca \u0db3\u0d9a\u0db3\u0db1 \u0d9a\u0dbb\u0dca\u0db1 \u0d85\u0dc0\u0dc1\u0dca\u0dba\u0dba\u0dd2, \u0d85\u0db4\u0dda \u0dbb\u0db4\u0da8\u0dcf \u0dd4\u0dc0\u0dda\u0db4\u0dad\u0dca\u0d9a\u0db8 \u0dad\u0dd4\u0dbb\u0dca \u0d9a\u0dd2\u0dd3\u0db8\u0db8 \u0db3\u0dc4\u0dcf \u0dcf.\n\n\u0d9c\u0dbb\u0dd4 \u0db3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2, \u0d85\u0dba \u0dd2\u0dba\u0db1\u0db4\u0dbd \u0db8\u0dcf\u0dad\u0dd8\u0d9a\u0dcf\u0dc0 \u0d85\u0dba\u0dcf\u0dc5 \u0db4\u0db1\u0dcf\u0dc0\u0dd4\u0dab\u0dad\u0dca \u0db8\u0db8 \u0db4\u0dca) \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0dad\u0dca \u0d9a\u0dd2\u0dc0 \u0dd4\u0dab\u0dad\u0dd4\u0db8\u0dba\u0dd2. \u0dd4\u0d9a\u0dd2\u0dda \u0dcf \u0db3\u0dd4\u0dca\u0db4\u0db1\u0dad\u0dca\u0dad\u0dd2 \u0db8\u0db1\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0db4\u0d9c\u0dca \u0db8\u0db8 \u0daf\u0dda\u0dd3\u0db8\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf, \u0d85\u0db4\u0dda \u0dd2\u0db6\u0da2\u0dd2\u0dad \u0db4\u0dcf \u0db1\u0dbb\u0dad\u0dca \u0db8\u0db1\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0db4\u0dca) \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0dba\u0db1\u0db1\u0dd4\u0dca) \u0db4\u0dba\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dd2\u0db6\u0db4\u0dda\u0dc1\u0dca \u0db4\u0db3\u0db1\u0dc0\u0dcf\n\n1171 1172\n\n2025 \u0db4\u0db1\u0dcf\u0dc0\u0db1\u0dca)\u0dbd\u0dbb 21\n\n\u0dd2\u0dd4\u0dab\u0d9a\u0dca\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0dba\u0dcf\u0dbb\u0dc1\u0dca\u0db4\u0dbd \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0dd2\u0dba\u0dbb\u0da0\u0dd2 \u0db4\u0dc0\u0da0\u0dca\u0da0\u0da0 \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0db4\u0dbd\u0db1\u0dc0\u0dcf \u0db8\u0dcf \u0dbb\u0d9c\u0db8, \u0dc3\u0db4\u0dbb\u0dca\u0db4\u0dbd\u0ddd\u0dc3 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dbb\u0dd4\u0db4\u0dca)\u0dd2\u0dba\u0dcf\u0dc0 \u0dba\u0dc0\u0db1\u0dc0\u0dcf\u0dba \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d91\u0db8 \u0d86\u0dba\u0dad\u0db1\u0dba \u0d91\u0d9a\u0dca \u0db4\u0dd4\u0dda\u0d9c\u0dbd\u0db4\u0dba\u0d9a\u0dd4\u0db4\u0d9c\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dda 850,000 \u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dda 1,850,000 \u0dba\u0d9a\u0dca\u0dc0\u0dcf \u0d85\u0dbb\u0db4\u0d9c\u0db1 \u0dad\u0dd2\u0db4\u0dbd\u0db1\u0dc0\u0dcf. \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1 \u0dd2\u0db6\u0dd2\u0db8\u0dba \u0db4\u0dca) \u0dd2\u0db3\u0dcf 500\u0d9a \u0dd2\u0db6\u0dad\u0dbb \u0db4\u0dd2\u0dd2\u0db4\u0db3\u0d9a\u0dca \u0d85\u0d9c\u0dad\u0dd2\u0dba \u0db4\u0dad\u0dca\u0db4\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db4\u0dbd\u0db1\u0dc0\u0dcf. \u0db4\u0dca)\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dda \u0db4\u0d9a\u0ddd\u0da7\u0dd2 74\u0d9a \u0dc0\u0dbb\u0da0\u0dcf\u0dc0\u0d9a\u0dca. \u0db8\u0db8 \u0d85\u0dba \u0d9c\u0dbb\u0db4\u0d9c\u0dcf\u0da9\u0dd2\u0db6\u0dbd \u0db4\u0db3\u0dcf\u0dd2\u0db6\u0dba \u0dc5\u0d9f \u0d9c\u0dd2\u0dc4\u0dd2\u0dda\u0dbd\u0dcf \u0d86\u0db4\u0dda, \u0d85\u0d9c\u0dad\u0dd2\u0dba \u0db4\u0dad\u0dca \u0db4\u0dc0\u0da0\u0dca\u0da0\u0da0 \u0d92 \u0db4\u0dd2\u0dd2\u0db4\u0db3 \u0dcf \u0db8\u0dd4\u0db4\u0dc0\u0dbd\u0dcf. \u0db8 \u0dad\u0dd2\u0db8\u0dba \u0dc0\u0dc1\u0dca\u0db4\u0dba\u0dca \u0d85\u0db4\u0dbb\u0dcf, \u0db4\u0dd3\u0db8\u0d9a\u0dca\u0dc2\u0dab \u0db4\u0dba\u0db4\u0dcf\u0dbb\u0dad\u0db4\u0dca)\u0dca\u0dad\u0dd4\u0dc0 \u0db4\u0dca) \u0db3\u0dc4\u0dcf \u0dcf \u0dba\u0dca) \u0db4\u0dd2\u0dba\u0dc0\u0dbb \u0d85\u0dbb\u0db4\u0d9c\u0db1 \u0dad\u0dd2\u0db4\u0dbd\u0db1\u0dc0\u0dcf. \u0db4\u0db8\u0dcf\u0d9a\u0dba, \u0db4\u0dcf \u0dcf\u0dc4 \u0db4\u0dba\u0dba\u0d9a\u0dca \u0d9a\u0dc5\u0dcf\u0db8 \u0d85\u0db4\u0dd2 \u0d92 \u0db4\u0dcf \u0dcf\u0dc4 \u0db4\u0dba\u0dba \u0db4\u0dcf \u0dcf\u0dc4\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0db4\u0dca. \u0dcf \u0db1\u0dbd\u0db1\u0dba\u0dd2, \u0dc0\u0db3\u0dbb \u0d9c\u0dab\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0db4\u0d9c\u0db1 \u0d9c\u0dd2\u0dba \u0d92 \u0dc0\u0dbb\u0da0\u0dcf \u0db3\u0dcf \u0d9c\u0dad \u0d86\u0dba\u0dad\u0db1\u0dba,-\n\n\u0d9c\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dd2\u0dc3\u0dd4\u0dbb\u0dd9\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0bb5\u0bbf\u0b9a\u0bbe\u0bb3\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd)\n\n(The Hon. Chairman) Hon. Sajith Premadasa, your allotted time is up."
  },
