    "chunk_text": "\u0d85\u0db4\u0dda \u0dc0\u0dbb\u0dcf\u0db4\u0d89 elevated highway \u0dad\u0d9a\u0dad\u0dca \u0d89\u0dad\u0dca\u200d\u0dcf\u0db8\u0dc0 \u0dd4 \u0dc2\u0db1\u0d9a\u0dbb \u0db4\u0d9a\u0dca\u0db1\u0dca\u0db4\u0daf\u0dca\u0dc3\u0dd2 \u0dba \u0db4\u0da7\u0db4\u0dad\u0dca \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dca\u0db4\u0db1\u0dca.\u0dbd\u0dda \u0d92 contractor, \u0d92 \u0db4\u0d9a\u0dca\u0dda\u0dca\u0dc3\u0db1\u0dd2\u0dba \u0db4 \u0dc0\u0dd2\u0dc1\u0dca\u0dcf\u0dd3 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0dba\u0dc0\u0dd3\u0da7 \u0db8\u0dd4\u0dc4\u0dd4\u0dab \u0daf\u0dd3\u0dd3\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d87\u0dad\u0dca\u0dad\u0dca\u200d\u0da7\u0db8\u0dc0 \u0d86\u0da9\u0dd4\u0d9a\u0dca\u0db4\u0daf \u0d85\u0d9a\u0dca\u0dca\u0dcf\u0d9a\u0dca\u0d9a\u0dda \u0dc0\u0dcf \u0db4 \u0db8\u0dc0, \u0db1\u0dd2\u0dd3\u0db0\u0dca\u200d\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0db4 \u0d85\u0d9a\u0dca\u0dca\u0dcf\u0d9a\u0dca\u0d9a\u0dda \u0dc0\u0dcf\u0db4 \u0db8\u0dc0, \u0d8a\u0da7 \u0dc0\u0dca\u0dcf contractors\u0dd3\u0dcf\u0db4 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0db1 \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0d85\u0db4\u0dda \u0db4\u0dbd\u0dca\u0d9a\u0dda\u0dad\u0dd4\u0db8\u0dc0\u0db1\u0dca\u0dd3\u0dcf \u0db8\u0dc0\u0dc4\u0db1\u0dca\u0dc3\u0dd2\u0db4\u0dc0\u0dd3\u0dcf \u0dba \u0db4\u0dda\u0d9a\u0dd2\u0dc3\u0dd2 solution \u0dad\u0d9a\u0d9a\u0dca \u0dba\u0dc3\u0db1\u0dca \u0db4,\u0db1\u0dc3\u0dc0\u0dd2\u0dad\u0dca \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d85\u0d9a\u0dca ,\u0dab\u0db4\u0db1\u0dca \u0dd3\u0db6\u0db1 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0dba \u0db8\u0dc0\u0dc3\u0dba \u0db4\u0dc0\u0db1\u0db4\u0d9a\u0dca\u0da7\u0dc0\u0dad\u0dca elevated highway \u0dad\u0db4\u0d9a\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0dd3\u0dcf \u0dc0\u0dbb\u0dcf\u0db4\u0d89 \u0db4\u0dca\u200d\u0dbb\u0db4\u0dba \u0db4\u0ddd\u0da2\u0db1\u0dba \u0db4\u0da7 \u0db4\u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0db4\u0dc0\u0dd2 \u0d9a\u0dd2\u0dba \u0db4\u0dd3\u0dcf \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0dc1\u0dca\u0db1\u0dc0\u0dcf\u0dc3 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\u0dbd\u0dda\n\n\u0d85\u0db4\u0dd2 \u0dca\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0db4 \u0dc0\u0dad\u0dca\u200d\u0dcf\u0db4\u0daf \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0dca\u0dc5\u0dcf\u0dad\u0dca\u200d \u0db4\u0dc0\u0db1\u0dd4\u0db4\u0dc0\u0db1\u0dca \u0dc0\u0dd2\u0dc1\u0dca\u0dcf\u0dd3 \u0db8\u0dd4\u0dba\u0dd3\u0d9a\u0dca \u0db4\u0dc0\u0db1\u0dca \u0d9a\u0dc5\u0dcf.\u0dbd\u0dda \u0dad\u0dc4\u0dd2 \u0d89\u0dad\u0dca\u200d\u0dcf\u0db8\u0dc0 \u0dd4 \u0dc2\u0db1\u0d9a\u0dbb \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dca\u200d ,\u0dad\u0dca\u200d \u0d9a\u0dbb\u0db4\u0dd4 \u0da2\u0db1\u0dad\u0dca\u200d\u0dcf\u0dc0\u0d9a\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d92 \u0d85\u0dba \u0db4 \u0dba\u0dd4\u0daf\u0dca\u0db0\u0dca\u200d\u0dba \u0db4 \u0db1\u0dd2\u0dc3\u0dcf \u0db6\u0dc3\u0da7 \u0d9a\u0dcf\u0db4\u0dd4 \u0da2\u0db1\u0dad\u0dca\u200d\u0dcf\u0dc0\u0d9a\u0dca.\u0dbd\u0dda \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0db6\u0dca\u0dad\u0dca\u0dd2\u0db6 \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0db4\u0dd2 \u0db4\u0dda \u0dc0\u0dad\u0dca\u200d\u0dcf\u0db4\u0dc0\u0dad\u0dca \u0d8b\u0dad\u0dd4\u0dbb \u0dc3\u0dc4 \u0db1\u0dc3 \u0db4\u0d9f\u0db1\u0dc4\u0dd2\u0dbb \u0dca\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dba\u0d9a\u0da7\u0db8\u0dc0 \u0db8\u0dd4\u0dba\u0dbd\u0dca \u0db4\u0dc0\u0db1\u0dca \u0d9a\u0dbb\u0dd3\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d9a\u0dd2\u0dbb\u0dcf\u0db1\u0dca \u0dca\u0dcf\u0dd3\u0db8\u0dc0\u0da7 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0dca\u0dd2\u0db6\u0dad\u0dd4\u0db8\u0dc0\u0dcf \u0db8\u0dd4\u0dba\u0dbd\u0dca \u0db4\u0dc0\u0db1\u0dca \u0d9a\u0dc5 \u0db6\u0dc0 \u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dc0\u0db1\u0dca\u0dd3\u0dcf \u0dba\u0db1\u0dca\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d92 \u0dc0\u0dcf\u0db4 \u0db8\u0dc0 \u0d85\u0db4\u0dd2 \u0d8b\u0dad\u0dd4\u0db4\u0dbb\u0dca\u0dad\u0dca \u0dc0\u0dd2\u0dc1\u0dca\u0dcf\u0dd3 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0db1\u0dba \u0db4\u0d9a\u0dca \u0d87\u0dd2\u0db6 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\u0dbd\u0dda\n\n,\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dca\u0dd2\u0db6\u0dad\u0dd4\u0db8\u0dc0\u0db1\u0dd2, \u0d92 \u0dc0\u0dcf\u0db4 \u0db8\u0dc0 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dc0\u0dcf \u0dba\u0db1\u0dca\u0db1\u0dc0\u0dcf, \u0d85\u0db4\u0dd2 - \u0d86\u0da9\u0dd4\u0d9a\u0dca\u0db4\u0dc0\u0db1\u0dca - \u0db8\u0dc0\u0da7\u0dd3\u0dba \u0db4\u0dc4\u0dda \u0da2\u0db1\u0dad\u0dca\u200d\u0dcf\u0dc0\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0db4\u0dbd\u0dca 200\u0d9a\u0dca \u0dca \u0d85 \u0dc0\u0dc3 \u0d85 \u0d9a\u0dc5 \u0db6\u0dc0.\u0dbd\u0dda \u0d92\u0d9a\u0da7 \u0dc3\u0db8\u0dc0\u0dc4\u0dbb \u0d85\u0dba \u0db4 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0\u0dca\u200d\u0dad\u0dca \u0dc0\u0dd4\u0dab\u0dcf.\u0dbd\u0dda \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d8a\u0da7 \u0d85\u0db8\u0dc0\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0d85\u0db4\u0dd2 \u0db4\u0dc0\u0db1 \u0dc0\u0dba\u0dcf\u0dca\u0dd8\u0dd2\u0db6\u0dba \u0db4\u0d9a\u0dd2\u0db1\u0dca \u0d89\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dc0\u0da0\u0dca\u0dd2 \u0db8\u0dd4\u0dba\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dcf\u0dab\u0dba \u0db4\u0d9a\u0dca \u0dc0\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0db4\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba \u0db4\u0db1 3.\u0dbd\u0dda8\u0d9a\u0dca - \u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0db4\u0dbd\u0dca \u0db4\u0d9a\u0ddd\u0da7\u0dd2 380\u0d9a\u0dca - \u0dc0\u0dad\u0dd4\u0d9a\u0dbb\u0db4\u0d89 \u0dca\u0dcf\u0dbb\u0dc0\u0dbd\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dc0\u0db1\u0dca \u0d9a\u0dbb \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0db1\u0dd4\u0dc0\u0dbb\u0dad\u0dc5\u0dd2\u0dba \u0db4\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0db4\u0dbd\u0dca \u0db4\u0d9a\u0ddd\u0da7\u0dd2 100\u0d9a\u0dca, \u0db6\u0dd4 \u0dbd\u0dca\u0dd3\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0db4\u0dbd\u0dca \u0db4\u0d9a\u0ddd\u0da7\u0dd2 100\u0d9a\u0dca, \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb\u0dba \u0db4\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0db4\u0dbd\u0dca \u0db4\u0d9a\u0ddd\u0da7\u0dd2 100\u0d9a\u0dca, \u0d9a\u0dd1,\u0dbd\u0dca\u0dd3\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0db4\u0dbd\u0dca \u0db4\u0d9a\u0ddd\u0da7\u0dd2 80\u0d9a\u0dca \u0dc0\u0dc1\u0dca\u0db4\u0dba \u0db4\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0db4\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba \u0db4\u0db1 3.\u0dbd\u0dda8\u0d9a\u0dca \u0db8\u0dc0\u0da7\u0dd3\u0dba \u0db4\u0dc4\u0dda \u0da2\u0db1\u0dad\u0dca\u200d\u0dcf\u0dc0 \u0da2\u0dd3\u0dc0\u0dad\u0dca \u0db4\u0dc0\u0db1 \u0dc0\u0dad\u0dd4\u0d9a\u0dbb\u0db4\u0d89 \u0dca\u0dcf\u0dbb\u0dc0\u0dbd\u0dca \u0dc3\u0dd1\u0daf\u0dd3\u0db8\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dca\u0db8\u0dc0\u0dab\u0d9a\u0dca \u0db4\u0dc0\u0db1\u0dca \u0d9a\u0dbb\u0dd3\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d92 \u0dc0\u0dcf\u0db4 \u0db4\u0daf\u0dca\u0dc0\u0dbd\u0dca \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0d9a\u0dbb\u0dd3\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d9a\u0dbb,\u0db1\u0dca\u0db1 \u0db6\u0dc3\u0dbb\u0dd2 \u0db4\u0dc0\u0da0\u0dca\u0dd2 \u0d92\u0dc0\u0dcf\u0dad\u0dca \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d9a\u0dd2\u0db4\u0dd3\u0ddd\u0db8\u0dd3\u0da7\u0dbb\u0dca 100,000 \u0db8\u0dc0\u0dcf\u0dbb\u0dca, \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0db1 \u0dc0\u0dc3\u0dca\u0dc3\u0da7\u0dc4\u0db1 \u0dba \u0db4\u0da7\u0db4\u0dad\u0dca \u0db1\u0dad\u0dca\u200d\u0dbb \u0db4\u0dc0\u0da0\u0dca\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0d92\u0dc0\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dca\u0da7\u0db1\u0dca ,\u0db1\u0dca\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0db4\u0db8\u0dc0\u0dca\u0d9a\u0dba, \u0dc0\u0dc3\u0dbb\u0daf\u0dd2 \u0dad\u0dd3\u0db1\u0dca\u0dd4 \u0dc0\u0dd4\u0dab\u0dcf\u0da7 \u0d85\u0db4\u0dd2 \u0d92\u0dc0\u0dcf \u0d85\u0dad\u0dca\u200d \u0dc4\u0dbb\u0dd2\u0db1\u0dca\u0db4\u0db1\u0dca \u0db1\u0dc3\u0dd2\u0db6 \u0db1\u0dd2\u0dc3\u0dcf.\u0dbd\u0dda"
  },
