    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7 \u0db8\u0db8 \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd1\u0d8b \u0db8\u0dc0\u0dc3\u0dd0 \u0d86 \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d \u0d9c\u0dd0 1 \u0db8\u0dc0\u0dc3\u0dd0 \u0d86 \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d \u200d\u0db8\u0dd2\u0d8b \u0d9a\u0dcf\u0d9a\u0dc0\u0db4\u0daf \u0db0\u0dd3\u0daf\u0dba \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d\u0db4\u0dda \u0dca\u0dba\u0dca\u0db7\u0d9a \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d 1 \u0dc0\u0dc3 \u0db8\u0dc0\u0dc3\u0dd0 \u0d86 \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d \u0dc0\u0db7\u0dc0\u0daf \u0da7 \u0daf\u0dc01 \u0d92 \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d8b \u0d92\u0d9a\u0da7 \u0dbb\u0db8 \u0dc3\u0dc0 \u0d9a \u0d9a\u0daf \u0dd0 \u0dd01 \u200d\u0dd4\u0dc0 \u0db4\u0d9a\u0dc0\u0da7\u0dc4\u0dda \u0d92\u0db4\u0d9a\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9c\u0dd2\u0dbd\u0dd2\u0dc4\u0dd3 \u0daf\u0dc01 \u0daf \u0dc4\u0d9a \u0d9a\u0dab\u0dca\u0dd2\u0dc0 \u0dca \u200d\u0db8\u0dd2 \u0dc0\u0dc3 \u0db8\u0dc0\u0dc3\u0dd0 \u0d86 \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb1 \u0dc3\u0d9a\u0dd4\u0dab\u0dd4 \u0dc5\u0dc0\u0db4 \u0d9a \u0dca \u0dd0 \u0dc2\u0dab \u0dd0 \u0d91\u0d9a \u0db8\u0dc0\u0dba\u0dc2\u0dab \u0db4\u0d9a\u0dc0\u0da7 \u0db8\u0dc0\u0dc3\u0dd0\u0d9a\u0dc2\u0dab \u0db4\u0d9c\u0dc0\u0dd2 \u0dc0\u0dbb\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd4\u0dc5\u0dd4\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb1 \u0d91\u200d\u0db4\u0d9a\u0dc0\u0da7 \u0daf\u0dd0\u0da2\u0dd2 \u0db8 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dd2 \u0dc2\u0dab \u0dc0\u0db8\u0dc