    "chunk_text": "\u0dc0\u0dba\u0dcf\u0dca\u0dd8\u0dd2\u0db6 \u0db4\u0dba\u0d9a\u0db8\u0dc0 \u0d85\u0dba \u0dc0\u0db1 \u0db4\u0d9a\u0dca\u0da7 \u0db8\u0dc0\u0db1\u0dca\u0dba,\u0dcf\u0db8\u0dd3 \u0dc3\u0db1\u0dc0\u0dbb\u0dd6\u0dca\u0db4\u0dba \u0db4\u0db1\u0dca \u0dad\u0dca\u200d\u0db8\u0dc0\u0dd2 \u0db4\u0d9a\u0dbb\u0dd3\u0db4,\u0db1 \u0dba \u0db4\u0db1\u0dca\u0db4\u0db1\u0dca.\u0dbd\u0dda \u0d92\u0dc0\u0dcf\u0db4\u0d89 \u0dc0\u0dc3\u0dca \u0db4\u0dc0\u0db1\u0dca\u0db4\u0db1\u0dca \u0db1\u0dc3\u0dc4\u0dc3.\u0dbd\u0dda \u0d89\u0dad\u0dca\u200d\u0dcf\u0db8\u0dc0 \u0db4\u0dc4\u0db1\u0dca\u0db1\u0dca \u0dad\u0dca\u200d\u0db8\u0dc0\u0dd2 \u0d92\u0dc0\u0dcf\u0db4\u0d89 \u0dc0\u0dc3\u0dca \u0db4\u0d9a\u0db4\u0dbb\u0db1\u0dca\u0db4\u0db1\u0dca.\u0dbd\u0dda \u0d92 \u0dc0\u0dba\u0dcf\u0dca\u0dd8\u0dd2\u0db6\u0dba \u0db4\u0da7 \u0dd3\u0dc3\u0db6\u0dd4\u0dab\u0dd4 \u0dc0\u0dd2\u0db4\u0daf\u0dca\u0dc1\u0dca \u0dab\u0dba \u0db4 \u0d87\u0db4\u0db8\u0dc0\u0dbb\u0dd2\u0d9a\u0dcf\u0db1\u0dd4 \u0db4\u0dca\u0dca\u0dd3\u0dbb\u0dca \u0db1\u0dca\u0dbd\u0dd2\u0dba \u0db4\u0db1 200\u0d9a\u0dca \u0dc0\u0dd2\u0dad\u0dca\u200d\u0dbb \u0dba\u0dc3\u0db1\u0dca \u0d89\u0dd2\u0db6\u0dbb\u0dd2 \u0db4\u0dc0\u0dd3\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d92 \u0db8\u0dd4\u0dba\u0dbd\u0dca \u0d89\u0dd2\u0db6\u0dbb\u0dd2 \u0db4\u0dc0\u0dd3\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba \u0db4\u0db1\u0dca\u0db4\u0db1\u0dca\u0db8\u0dc0, \u0d92 \u0dc0\u0dc3\u0db4 \u0db4\u0dc0\u0db1\u0dca\u0db4\u0db1\u0dca \u0db1\u0dc3\u0dc4\u0dc3 \u0d9a\u0dd2\u0dba \u0db4\u0db1 \u0dad\u0d9a\u0dd2 .\u0dbd\u0dda \u0dba\u0dc3\u0db1\u0dca \u0dc3\u0dd1\u0db4\u0dc4\u0db1\u0dca\u0db1 \u0d9a\u0dcf\u0dd3\u0dba \u0db4\u0d9a\u0dca \u0db4\u0dc0\u0db1\u0dc0\u0dcf, \u0d92\u0d9a \u0d89\u0dad\u0dca\u200d\u0dcf \u0db8\u0dc0\u0db1\u0dca\u0dba,\u0dcf\u0db8\u0dd3\u0dc0\u0dd2 \u0dc3\u0dd2\u0dd4 \u0db4\u0dc0\u0db1\u0dca\u0db4\u0db1\u0dca.\u0dbd\u0dda"
  },
