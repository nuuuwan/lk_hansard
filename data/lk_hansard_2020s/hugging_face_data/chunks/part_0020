    "chunk_text": "\u0ba4\u0b95\u0bcc\u0bb0\u0bb5 \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb0\u0bb3, \u0b87\u0ba8\u0bcd\u0ba4 \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0ba4\u0bae\u0bbe\u0bb0\u0bc1 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0bae\u0bbe\u0ba9 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0bae\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd LMSL. \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b92\u0bb0\u0bc1 \u0bae\u0bbf\u0b95\u0baa\u0bcd\u0ba4\u0baa\u0bbe\u0bbf\u0baf \u0ba4\u0b9a\u0bbe\u0ba4\u0bcd\u0ba4\u0bc1\u0ba4\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd mineral \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1. \u0b87\u0ba8\u0bcd\u0ba4 mineral\u0b87\u0b95\u0ba9 \u0b8e\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0ba8\u0bbe\u0bae\u0bcd \u0b9a\u0bbe\u0bbf\u0baf\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0bb2 \u0baa\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0ba4\u0b9f\u0bbe\u0bb2\u0bb0\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bcd \u0b86\u0ba4\u0bbe\u0baf\u0ba4\u0bcd\u0b95\u0ba4\u0b95\u0bcd \u0ba4\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1 \u0bb5\u0bb0\u0bb2\u0bbe\u0bae\u0bcd. \u0b86\u0ba9\u0bbe\u0bb2\u0bcd, \u0ba8\u0bbe\u0bae\u0bcd \u0b85\u0b95\u0ba4\u0b9a\u0bcd \u0b9a\u0bbe\u0bbf\u0baf\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bbf\u0bb2\u0bcd\u0b95\u0bb2. \u0b87\u0ba8\u0bcd\u0ba4 mineral \u0bae\u0ba3\u0bcd\u0b95\u0ba3 \u0b8e\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 export \u0ba4\u0b9a\u0baf\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbe\u0b95 \u0bae\u0b9f\u0bcd\u0b9f\u0bc1\u0bb0\u0bae \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb0\u0bb1\u0bbe\u0bae\u0bcd. \u0b85\u0bb5\u0bcd\u0bb5\u0bbe\u0bb1\u0bbf\u0bb2\u0bcd\u0bb2\u0bbe\u0bae\u0bb2\u0bcd, \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0b95 investors\u0b87\u0b95\u0ba9 \u0b85\u0b95\u0bb4\u0ba4\u0bcd\u0ba4\u0bc1, \u0b85\u0bae\u0bcd\u0baa\u0bbe\u0ba8\u0bcd\u0bb0\u0ba4\u0bbe\u0b9f\u0bcd\u0b95\u0b9f \u0bb0\u0baa\u0bbe\u0ba9\u0bcd\u0bb1 \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bbf\u0bb0\u0bb2 titanium dioxide \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b85\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4 \u0b95\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0ba4\u0bbe\u0ba4\u0bc1\u0baa\u0bcd\u0ba4\u0baa\u0bbe\u0bb0\u0bc1\u0bb3\u0bcd \u0b89\u0bb1\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b92\u0bb0\u0bc1 factory\u0b90 \u0b85\u0b95\u0bae\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b87\u0b9f\u0ba4\u0bcd\u0b95\u0ba4 \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc0\u0b9f\u0bc1 \u0ba4\u0b9a\u0baf\u0bcd\u0ba4\u0bc1, \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0baa\u0bcd\u0ba4\u0baa\u0bbe\u0bb0\u0bc1\u0bb3\u0bcd\u0b95\u0b95\u0bb3 \u0bae\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bb2\u0bcd\u0bb2\u0bbe\u0ba4\u0bc1, \u0b85\u0bb0\u0bc1\u0b95\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b8f\u0b95\u0ba9\u0baf \u0ba8\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0bae\u0bc2\u0bb2\u0baa\u0bcd\u0ba4\u0baa\u0bbe\u0bb0\u0bc1\u0bb3\u0bcd \u0b95\u0b95\u0bb3\u0b95\u0bcd \u0ba4\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0ba8\u0bcd\u0ba4\u0bc1, \u0b85\u0b99\u0bcd\u0b95\u0bc1 value addition \u0ba4\u0b9a\u0baf\u0bcd\u0ba4 \u0b89\u0bb1\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0b95\u0bb3 export \u0ba4\u0b9a\u0baf\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0baa\u0bbe\u0bb4\u0bc1\u0ba4\u0bc1, \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0ba4\u0baa\u0bb0\u0bc1\u0ba8\u0bcd \u0ba4\u0ba4\u0bbe\u0b95\u0b95\u0baa\u0bcd \u0baa\u0ba3\u0ba4\u0bcd\u0b95\u0ba4 \u0bb5\u0bb0\u0bc1\u0bae\u0bbe\u0ba9\u0bae\u0bbe\u0b95\u0baa\u0bcd \u0ba4\u0baa\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd \u0ba4\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0bb2\u0bbe\u0bae\u0bcd. \u0b87\u0baa\u0bcd\u0ba4\u0baa\u0bbe\u0bb4\u0bc1\u0ba4\u0bc1 GSMB \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b8e\u0ba9\u0bb0\u0bb5, \u0b87\u0ba4\u0bc1 \u0b9a\u0bae\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0bae\u0bbe\u0ba9 \u0bb0\u0bb5\u0b95\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0b95\u0ba4 \u0b87\u0b99\u0bcd\u0bb0\u0b95\u0baf\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b85\u0bb1\u0bbf\u0b9e\u0bb0\u0bcd\u0b95\u0bb3\u0bcd, \u0b86\u0baf\u0bcd\u0bb5\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0b95\u0bb3 \u0b95\u0bb5\u0ba4\u0bcd\u0ba4\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0ba4\u0ba9\u0b9f\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd!\n\n\u0d9c\u0dbb\u0dd4 \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2, \u0dba\u0db1\u0dca \u0db8\u0db8 \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0dcf\u0db4\u0d9c\u0dca \u0d92 \u0d9c\u0db1\u0db1 \u0d85\u0dcf \u0db1\u0dc0\u0dcf. \u0d92\u0d9a \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0dcf \u0db4\u0dad\u0dca\u0dad\u0dbb\u0dba\u0d9a\u0dca \u0db4\u0dba\u0dca\u0db1. \u0d92 \u0db4\u0dca\u200d\u0dbb\u0db4\u0dda\u0dc1\u0dca\u0dba \u0dba\u0dca\u0db1 \u0dbd\u0db1\u0dd2\u0db4\u0dc0\u0dba\u0dd2 \u0daf\u0dca\u0db4\u0dca \u0d85\u0db4\u0dd2. \u0d92 \u0db4\u0dca\u200d\u0dbb\u0db4\u0dda\u0dc1\u0dca\u0db4\u0dbd \u0dc5\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0db4\u0dca \u0daf\u0dda\u0dd3\u0db8\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\n\n\u0d9c\u0dcf\u0dda\u0db4\u0dda \u0dc5\u0db8\u0dba\u0dd2\u0dca \u0db4\u0dd2\u0daf \u0db4\u0dba\u0db1\u0dc0\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0d92 \u0db4\u0dca\u200d\u0dbb\u0db4\u0dda\u0dc1\u0dca\u0db4\u0dbd \u0dc5\u0db8\u0dba\u0dd2\u0dca \u0db4\u0dd2\u0daf \u0db4\u0dba\u0dca\u0db4\u0dca \u0db1\u0db1\u0dcf \u0db1. \u0d87\u0dba\u0dd2 \u0d92? \u0d87\u0db8\u0dad\u0dd2,- [\u0dbd\u0dcf,\u0dcf \u0d9a\u0dd2\u0dd3\u0db8\u0db8\u0d9a\u0dca] \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0dcf \u0db4\u0db1\u0dcf\u0db4\u0dc0\u0dba\u0dd2. \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0dcf \u0d9c\u0dcf\u0dda\u0db4\u0dda \u0db4\u0db1\u0dcf\u0db4\u0dc0\u0dba\u0dd2, \u0db8\u0dcf\u0dad\u0dbb \u0db4\u0dca. \u0db4\u0dd4\u0d9a\u0d9c\u0dd2\u0dba \u0d86\u0dab\u0dca\u0da9\u0dd4\u0db4\u0dda \u0dc4\u0dd2 \u0db4\u0dd4 \u0db4\u0d9a\u0db1\u0dcf \u0d9c\u0dcf\u0dda\u0db4\u0dda \u0dd2\u0db3\u0dcf \u0d94\u0dc4\u0dd4 \u0dba\u0db8\u0db4\u0dd4 \u0d85\u0dba \u0db4\u0dd2\u0daf \u0db4\u0dba\u0db1\u0dc0\u0dcf. \u0db4\u0dca)\u0db4\u0d9c\u0dcf\u0dda\u0dbd\u0db1\u0dd4\u0dad\u0dca \u0d94\u0dc4\u0dd4 \u0dad\u0db8\u0dba\u0dd2 \u0db4\u0dad\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0db4\u0dbd\u0dca\u0db4\u0dca. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0d92 \u0d85\u0dba \u0d9c\u0db4\u0dca) \u0db8\u0dd2\u0dd2\u0db3\u0db1\u0dd4\u0d9a \u0dd2\u0db3\u0dcf \u0d92 \u0d85\u0dba \u0db4\u0dd2\u0daf \u0db4\u0dba\u0dca\u0db4\u0dca \u0db1\u0db1\u0dcf \u0db1."
