    "chunk_text": "\u0db4\u0db1\u0dca\u0dc3\u0dd3\u0d9a\u0dcf \u0dc4\u0dbb\u0dd2\u0db1 \u0dd3\u0dba \u0d85\u0db4\u0dca\u0ddd \u0dc4\u0dc3\u0da7\u0dd2\u0dba \u0db4\u0da7 \u0dc0\u0dc3\u0dbb ,\u0dab\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0dca\u0dc0\u0dd2\u0db6\u0db1 \u0d85\u0db4\u0dca\u0ddd \u0dbb\u0dcf\u0dc2\u0dca\u0dba \u0db4\u0d9a\u0dca \u0db4\u0d9a\u0dca\u0dc5\u0db9 \u0db1,\u0dbb\u0db4\u0d89\u0dad\u0dca \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf; \u0dbb\u0da7 \u0db4\u0dd4\u0dbb\u0dcf\u0db8\u0dc0\u0dad\u0dca \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db4\u0dda\u0dc0\u0dcf \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0db1\u0dba \u0db4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dc0\u0da7 \u0db8\u0dd4\u0dba\u0dbd\u0dca \u0db4\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0d85\u0db8\u0dc0\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\u0dc1\u0dca\u0dba \u0db4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca ,\u0db1\u0dca\u0db1\u0dcf \u0db4\u0dc4\u0dca\u0db3 \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0db4\u0d9a\u0dca \u0d9a\u0dd2\u0dba \u0db4\u0dd3\u0dcf \u0d85\u0db4\u0dd2 \u0dc4\u0dd2\u0dad\u0dca\u200d\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d8a\u0da7 \u0d85\u0db8\u0dc0\u0dad\u0dca\u200d\u0dbb\u0dc0, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dd3\u0d82,\u0db8\u0dc0 \u0db6\u0dc3\u0db1 \u0dbb 307\u0d9a \u0db4,\u0dc0\u0dd3 \u0d9c\u0dd2\u0dba \u0db4 \u0dad\u0db1\u0dca\u0da2\u0dd2\u0db1\u0dca \u0d9a\u0da8\u0dcf\u0da7\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0db6\u0dc2\u0db1\u0dc3\u0dcf\u0dca\u0db1\u0dba \u0db4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf\u0dad\u0dca, \u0db4\u0dca\u0dca\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0d9a\u0dca\u0db4\u0dc2\u0dda\u200d\u0dbb\u0dba \u0db4 \u0dc1\u0dca\u0d9a\u0dca\u0dd2\u0db6\u0db8\u0dc0\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dca \u0dd4 \u0dbb ,\u0db8\u0dc0\u0db1\u0dca \u0db4\u0dc3\u0dda\u0dc0\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u0db6\u0dc3\u0db1 \u0dbb 600\u0d9a\u0dca \u0dad\u0d9a\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf\u0dad\u0dca \u0db4\u0db8\u0dc0\u0dc0\u0dbb \u0d85\u0dba \u0db4 \u0dc0\u0dc3\u0db4\u0dba \u0db4\u0db1\u0dca \u0db8\u0dd4\u0dba\u0dbd\u0dca \u0db4\u0dc0\u0db1\u0dca \u0d9a\u0dbb \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda\n\n\u0d92 \u0dc0\u0dcf\u0db4 \u0db8\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0d87\u0db8\u0dc0\u0dd2\u0db6\u0dad\u0dd4\u0db8\u0dc0\u0dcf\u0da7 \u0db4\u0dda \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0db4 \u0db8\u0dc0\u0dad\u0dca\u200d\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dc3\u0db8\u0dc0\u0dc3\u0dd2\u0db6\u0dd2 .\u0dbd\u0dda \u0db4\u0d9a\u0dca\u0dc5\u0db9 \u0db1,\u0dbb\u0dba \u0db4 \u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d85\u0d9a\u0dca \u0d86\u0dba\u0dcf\u0dba \u0db4\u0dda\u0dd3\u0dcf\u0dd3\u0db1 \u0da2\u0db1\u0dad\u0dca\u200d\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc1\u0dca\u0dcf\u0dd3 \u0dc0\u0dc1\u0dca\u0db4\u0dba \u0db4\u0db1\u0dca ,\u0db8\u0dc0\u0db1\u0dca \u0d9a\u0dbb\u0db1 bus routes \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d92 bus routes \u0db4\u0db6\u0dca\u0db4\u0dc4\u0dca\u0db8\u0dc0\u0dba \u0db4\u0d9a\u0dca \u0db4\u0dda \u0db4\u0dc0\u0db1\u0db4\u0d9a\u0dca\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0db4\u0dcf\u0dad\u0dca\u0db8\u0dc0\u0d9a \u0db4\u0dc0\u0db1\u0dca\u0db4\u0db1\u0dca \u0db1\u0dc3\u0dc4\u0dc3.\u0dbd\u0dda \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dd3\u0dba \u0db4 \u0db8\u0dc0\u0dcf\u0dbb\u0dca, ,\u0dc3\u0db1 \u0dc4\u0dd2\u0dad\u0dca\u200d\u0db1\u0db4\u0d9a\u0dca\u0da7 \u0db4\u0d9a\u0dca\u0dc5\u0db9 \u0db1,\u0dbb\u0dba \u0db4 \u0dad\u0dd4\u0dc5 \u0dd2\u0db6\u0db4\u0db6\u0db1 \u0d92 bus routes ,\u0dc3\u0db1\u0dad\u0dca \u0dc4\u0dd2\u0dad\u0dca\u200d\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba \u0db4\u0dd3\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0d85\u0db8\u0dc0\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\u0dc1\u0dca\u0dba \u0db4\u0da7\u0dad\u0dca, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dd3\u0d82\u0d9a\u0dcf ,\u0db8\u0dc0\u0db1\u0dcf,\u0db8\u0dc0\u0db1 \u0db8\u0dc0\u0da9\u0dd4\u0dca\u0dd3\u0dba \u0db4\u0da7\u0dad\u0dca, \u0da2\u0dcf\u0dd2\u0db6\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0db4\u0d9a\u0dca\u0db1\u0dca\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0\u0da7\u0dad\u0dca \u0db8\u0dc0\u0dad\u0dca\u200d\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0da7 \u0d9a\u0dc3\u0db8\u0dc0\u0dc3\u0dd2\u0db6\u0dd2 .\u0dbd\u0dda"
  },
