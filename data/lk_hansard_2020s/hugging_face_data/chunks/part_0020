dbd\u0dca\u0d9b\u0dca\u200d\u0dca\u0db8 \u0db4\u0dd4\u0d87\u0dd4\u0db8\u0dc5\u0dca \u0db4\u0dd4\u0dbb\u0dc5 \u0db4\u0dd4\u0dba\u0dd4\u0dd4\u0db8\u0db8\" \u0db8\u0dca \u0db4\u0dd4\u200d\u0dbb\u0dc1\u0dbb\u0dca\u0db8 \u0db4\u0dd4\u0dc0\u0dd2\u0da2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dca \u0db4\u0dd4\u0dbd\u0daf\u0dd2\u0db1\u0dca \u0db4\u0dd4\u0dc3\u0dca\u0dad\u0dca\u200d\u0dc0\u0db7 \u0db4\u0dd4\u0dc3\u0dca\u0dad\u0dca\u200d \u0dc0\u0da2\u0db4 \u0db4\u0dd4\u0dc0\u0dd2\u0db8.\n\n211 \u0dca \u0db4\u0dd4\u0dc1\u0dd3\u0dbb\u0dca\u0dc3\u0dbb\u0db8\u0dc4\u0dd2 \u0db4\u0dd401 \u0db4\u0dd4 \u0dca \u0db4\u0dd4 \u0dd0\u0da9\u0dad\u0dc3\u0dca\u0dad\u0dca\u200d \u0dca, \u0db4\u0dd4\u0db8\u0dd6\u0dbd\u0db0\u0dca\u200d\u0dca \u0db4\u0dd4\u0dc0\u0dd2\u0db8\u0db8\u0da2 \u0db4\u0dd4\u0d8b\u0db1\u0dbb\u0dbd\u0dca\u0d9b\u0dca\u200d\u0dca\u0dbb\u0db8\u0dc4\u0dd2 \u0db4\u0dd4\u0dbb\u0dbb\u0db7 \u0dc3\u0dca\u0dad\u0dca\u200d\u0d9a\u0dca \u0db4\u0dd4 \u0dd0\u0da7\u0dd2\u0db8 \u0db4\u0dd4\u0dd2\u0db6\u0dd2\u0db8 \u0db4\u0dd4\u0dba\u0dd4\u0dd4\u0db8\u0db8\u0dba\u0dd2 \u0db4\u0dd4\u0db1\u0dd2\u0dbb\u0db8\u0ddd \u0db4\u0dd4\u0dbb\u0dd9\u0dca \u0db4\u0dd4\u0dbd\u0daf\u0dd3.\n\n220 \u0dc0\u0db1 \u0dba \u0dbb\u0dca\u0dc3\u0dba.- \u0d86\u0dba\u0dd4\u0dbb\u0dca\u0db1\u0dda\u0daf \u0db1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0db1\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dbb\u0dc0\n\n01 \u0dca \u0db4\u0dd4 \u0dd0\u0da9\u0dad\u0dc3\u0dca\u0dad\u0dca\u200d \u0dca.- \u0db4\u0dd4\u0dbb\u0da2\u0dbb \u0dba\u0dd4 \u0dc0 \u0db4\u0dd4 \u0dd0\u0da9\u0dad\u0dc3\u0dca\u0dad\u0dca\u200d \u0dca \u0db4\u0dd4- \u0db4\u0dd4\u0dbb\u0dd4\u0dca\u0dd9\u0db7 \u0dbb\u0dca\u0db4\u0dca \u0db4\u0dd4\u0dc0\u0dd2\u0db8\u0db8\u0da2, \u0db4\u0dd4\n\n\u0dc2 .275,000,000\n\n\"220 \u0db4\u0dd4 \u0dca \u0db4\u0dd4\u0dc1\u0dd3\u0dbb\u0dca\u0dc3\u0dbb\u0db8\u0dc4\u0dd2 \u0db4\u0dd401 \u0db4\u0dd4 \u0dca \u0db4\u0dd4 \u0dd0\u0da9\u0dad\u0dc3\u0dca\u0dad\u0dca\u200d \u0dca, \u0db4\u0dd4\u0dbb\u0dd4\u0dca\u0dd9\u0db7 \u0dbb\u0dca\u0db4\u0dca \u0db4\u0dd4