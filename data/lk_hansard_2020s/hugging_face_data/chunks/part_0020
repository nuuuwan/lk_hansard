    "chunk_text": "18\u0dc0\u0dd0\u0db1\u0dd2 \u0dd9\u0dcf \u0dca\u0dc0\u0db8 \u0db4\u0da7\u0db1\u0dca\u0dad \u0dd4\u0dad\u0dd4 \u0d9c \u0dad\u0dca\u0dab\u0dd4\u0db8\u0daf\u0dca \u0d9a\u0dd0\u0dbd\u0db9\u0dd2\u0dd2 \u0d9c\u0dad\u0dd4 \u0dad\u0dd4 \u0dc0\u0dba\u0dad\u0dd4 22\u0dc0\u0dd0\u0db1\u0dd2 \u0dd9\u0dcf, 23\u0dc0\u0dd0\u0db1\u0dd2 \u0dd9\u0dcf \u0db8\u0dc0\u0db1\u0db8\u0d9a\u0dcf\u0da7 \u0d85\u0dc0\u0db8\u0db1\u0dca\u0dad \u0dc0\u0db1\u0dc0\u0dcf. \u0da2\u0dd3\u0dc0\u0dd2\u0d9c \u0dca\u0dcf\u0db1\u0dd2\u0dba\u0d9a\u0dca\u0dc2 \u0db1\u0dd0\u0dd4\u0dc0 \u0d92 \u0d9a\u0dd0\u0dbd\u0db9\u0dd2\u0dd2\u0db8\u0dca\u0dd4\u0d9c \u0d85\u0dc0\u0db8\u0dcf\u0dcf\u0dcf \u0db8\u0dd9\u0d9a\u0db8 \u0db8\u0d9a\u0dc5\u0dc0\u0dbb \u0db8\u0dc0\u0db1\u0dc0\u0dcf. \u0db8\u0db1\u0dcf\u0dc0\u0dd0\u0dda\u0db6\u0dbb\u0dca\u0dbd 25\u0dc0\u0dd0\u0db1\u0dd2 \u0dd9\u0dcf \u0d8b\u0db8\u0daf\u0dca 10.00\u0da7 \u0d85\u0dc0\u0dd3\u0da9\u0db1 \u0d9c\u0dad\u0dd4 \u0dad\u0dd4 \u0dc0\u0dba\u0d9a\u0dca\u0dc2 \u0d87\u0dad\u0dd2 \u0db8\u0dc0\u0db1\u0dc0\u0dcf\u0dba \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dbb\u0da2\u0dba\u0da7 \u0db1\u0dd2\u0dbd \u0dc0\u0dba\u0db8\u0dba\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0dbb\u0db4 \u0db1\u0dd2\u0db8\u0dda\u0dd9\u0db1\u0dba \u0d9c\u0db8\u0dbd\u0dca \u0db8\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dbb\u0db4\u0db8\u0dbb\u0ddd\u0d9a\u0dcf\u0db1\u0dba \u0d9a\u0dbb\u0dbb\u0db4 \u0db4\u0dc5\u0dad\u0dca \u0d85\u0dc0\u0db8\u0dcf\u0dcf\u0dcf\u0dc0. \u0d86\u0da9\u0dd4\u0d9a\u0dc0\u0d9a\u0dc0\u0d9a\u0dca\u0dc2 \u0dca\u0dd0\u0dd2\u0dad\u0dba\u0da7, \u0db1\u0dd0\u0dad\u0dd4 \u0db1\u0dda \u0dbb\u0da2\u0dba\u0d9a\u0dca\u0dc2 \u0dca\u0dd0\u0dd2\u0dad\u0dba\u0da7 \u0d85\u0db4\u0dd2 \u0d91\u0d9c\u0dd0\u0db1\u0dd2\u0db1\u0dca\u0dad \u0db4\u0db8\u0dcf\u0db8\u0db8\u0dcf \u0db8\u0db8\u0dcf\u0d9a\u0dd9 \u0d9a\u0db8\u0dc5\u0dcf? 25\u0dc0\u0dd0\u0db1\u0dd2 \u0dd9\u0dcf \u0d8b\u0db8\u0daf\u0dca 10.00\u0da7 \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab \u0dc0\u0dd2\u0dd9\u0dba\u0dcf \u0db8\u0dd9\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0db8\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9a\u0dd2\u0dba\u0db1\u0db8\u0d9a\u0dcf\u0da7 \u0d87\u0dad\u0dd4 \u0d9c\u0da7\u0db8 \u0d8a\u0da7 \u0db4\u0dd0\u0dba \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0da7 \u0d9a\u0dd2\u0db1\u0dca\u0dad \u0d92 \u0d85\u0dba \u0d85\u0d9c\u0dbb \u0db8\u0dcf\u0d9a\u0da0\u0dca\u0da0\u0dd4\u0da1\u0dcf\u0dcf\u0dc0\u0d9a\u0dca\u0dc2 \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dca\u0dad\u0db1\u0da7 \u0d87\u0dad\u0dd2 \u0db8\u0db1\u0dca\u0dad. \u0db8\u0dda \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0d85\u0dd9\u0dcf\u0dc5 \u0d86\u0dba\u0d9c\u0db1\u0dc0\u0dbd\u0da7 \u0dd9\u0dd0\u0db1\u0dd4\u0dda \u0db8\u0dd9\u0db1\u0dc0\u0dcf. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0d86\u0db4\u0dd9\u0dcf \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab \u0db8\u0db0\u0dba\u0db8\u0dcf\u0dcf\u0dcf\u0db1\u0dba 25\u0dc0\u0dd0\u0db1\u0dd2 \u0dd9\u0dcf \u0dca\u0db3\u0dbd\u0dcf\u0db8 \u0db4\u0da7\u0db1\u0dca\u0dad \u0d85\u0dbb\u0db8\u0dd4\u0db1 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dc2\u0d9a \u0d85\u0db8\u0dcf\u0d9c\u0dba\u0dcf\u0dd2\u0d82\u0dba\u0db8\u0d86 \u0dca\u0dad\u0dca\u0dd9\u0dcf \u0db8\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0d9c\u0dcf \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0da7, \u0dad\u0dca\u200d\u0dbb\u0dd2\u0dc0\u0dd2\u0db0 \u0dca\u0dad\u0dca\u0dd9\u0dcf\u0db4\u0dad\u0dd2\u0dc0 \u0d89\u0db1\u0dca\u0dad\u0da7, \u0db8\u0db4\u0dcf\u0dd2\u0db8\u0dcf\u0db4\u0dad\u0dd2\u0da7, \u0dc3\u0dc0\u0dd2 \u0db8 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dc2\u0d9a \u0db8\u0dd9\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0db8\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dd2\u0d82\u0d9a\u0dcf \u0db8\u0dc0\u0dbb\u0dc5\u0dcf\u0dbb\u0d9a\u0dca\u0dc2\u0dc2\u0d9a \u0db8\u0dd9\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dda \u0d85\u0db0\u0dba\u0d9a\u0dca\u0dc2\u0dc2 \u0da2\u0db1\u0dbb\u0dcf \u0db8\u0da7 \u0db8\u0dda \u0db6\u0dc0 \u0dd9\u0dd0\u0db1\u0dd4\u0dda \u0db8\u0dd9\u0db1\u0dc0\u0dcf.\n\n\u0da5\u0dcf\u0dad\u0dd2 \u0db1\u0dd2\u0dc0\u0dcf\u0db8 \u0db8\u0dc0\u0d9c \u0db8\u0dba\u0dcf\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1\" \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dc2\u0d9a \u0d85\u0db8\u0dcf\u0d9c\u0dba\u0dcf\u0dd2\u0d82\u0dba\u0dba \u0dba\u0da7\u0db8\u0dad\u0dd4 \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb\u0db1 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d86\u0db4\u0dd9\u0dcf \u0db8\u0dca\u0db1 \u0db8\u0db8\u0dcf\u0dc0\u0dcf \u0db8\u0db0\u0dba\u0db8\u0dcf\u0dcf\u0dcf\u0db1\u0dba \u0d9c\u0db8\u0dbd\u0dca \u0d92 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d8b\u0db4\u0db8\u0dd9\u0db8\u0dcf \u0db8\u0dd9\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad. \u0db8\u0dda \u0db1\u0dd2\u0db8\u0dda\u0dd9\u0db1\u0dba \u0d86\u0dc0\u0dcf\u0da7 \u0db4\u0db8\u0dcf\u0db8\u0db8\u0dcf \u0d9c\u0db8\u0dbd\u0dca \u0d86\u0db4\u0dd9\u0dcf \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab \u0db8\u0db0\u0dba\u0db8\u0dcf\u0dcf\u0dcf\u0db1\u0dba \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0db4\u0da7\u0db1\u0dca\u0dad \u0d85\u0dbb\u0db8\u0dd4\u0db1 \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad."
  },
