    "chunk_text": "\u0db8\u0dd6\u0d9a\u0dc0\u0dc4 \u0dc0\u0dbb\u0dd6\u0daa \u0d9c\u0dd4\u0dc0 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dda\u0dd2\u0dba \u0db1\u0dd2\u0d8b \u0dc0\u0dcf\u0db4\u0dc1\u0dda\u0dc2\u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db8 \u0db0\u0dd3\u0daf\u0dba \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dcf\u0daf \u0db8\u0db8 \u0d9a\u0dae\u0dc0 \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0daf\u0dc1\u0dba\u0dd21 \u0db8\u0db8 \u0da2\u0dd3\u0daf \u0d9a \u0db4\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0dcf\u0dc1\u0dc0\u0d9a \u0db0\u0dd3\u0daf\u0dba \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dd2\u0db4\u0dad\u0dc4\u0dc2\u0dab \u0da2\u0dd3\u0daf \u0d9a \u0db4\u0daf \u0db0\u0dd3\u0daf\u0dba \u0d9a\u0d9a\u0dc0 \u0d9a1 \u0db8\u0db8 \u0dcf \u0dc0\u0db0\u0dd2 \u0dd2\u0dda\u0db8\u0dc0\u0da7 \u0dc4\u0dda\u0dda\u0dd2\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d \u0db4\u0daf \u0daf\u0dc0 \u0db0\u0dd3\u0daf\u0dba \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4 \u0dca\u0dba\u0dc2\u0dab\u0dc2\u0dc0\u0daf\n\n\u0db8\u0dd6\u0d9a\u0dc0\u0dc4 \u0dc0\u0dbb\u0dd6\u0daa \u0d9c\u0dd4\u0dc0 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dda\u0dd2\u0dba \u0db1\u0dd2\u0d8b \u0db8\u0db8 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0dcf\u0d9a\u0dc0\u0db4\u0daf \u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dbb\u0dd2 \u0dc0\u0db1\u0dd4 \u0db8 \u0db4\u0d9a\u0dc0\u0db8\u0dc4\u0dc0\u0db4\u0dad\u0dc4\u0dda \u0d9a\u0dc0\u0dbd\u0dd2\u0db8 \u0dc0\u0d9a \u0da7 \u0d9a\u0db6\u0dc0 \u0daf\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbd\u0dd2\u0db4\u0dd2 \u0dc4\u0db7\u0dcf\u0d9c\u0dad* \u0d9a\u0dba \u0daf\u0dc01\n\n\u0d92 \u0dbd\u0dd2\u0db4\u0dd2 \u0dbb\u0dd3 \u0daf\u0dc0 \u0db6\u0d9a\u0dc0 \u0d94\u0db6\u0dda\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dc0 \u0d92 \u0d9a\u0da7\u0dba\u0dd4\u0dda \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb 1 \u0db4\u0dca\u0d9a \u0d9a\u0db6\u0dc0 \u0db4\u0