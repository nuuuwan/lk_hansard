    "chunk_text": "\u0db8\u0dd6\u0d9a\u0dc0\u0dc4 \u0dc0\u0dbb\u0dd6\u0daa \u0d9c\u0dd4\u0dc0 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dda\u0db8\u0db1\u0dd2\u0d8b \u0dc3\u0dd0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0dcf\u0db4\u0daf\u0dca\u0dc1 \u0db4\u0daf\u0db4\u0dc5\u0dcf \u0db4 \u0dc0\u0dc5\u0da7 \u0dc0\u0daf\u0dc1\u0dba \u0d9a\u0dba \u0dd2\u0db4\u0db6\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dd3\u200d\u0d9a \u0dcf\u0d9a \u0dda\u0dc5 \u0da2\u0dd3\u0daf \u0d9a \u0daf \u0dc0\u0dcf\u0dc3\u0dd2\u0dda\u0dd4\u0dc0 \u0db8\u0dc3\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb1 \u0dc0\u0db4\u0dd2 \u0db4\u0dca \u0daf \u0dc0\u0dcf\u0da7 \u0dc0\u0db4\u0db4\u0dca\u0db4 \u0dc0\u0db8\u0dc0\u200d\u0dba\u0dc0\u0dcf\u0dc1\u0db4\u0dda \u0db4 \u0d86\u0d9a\u0dca\u0dda\u0db8\u0dc0\u0db4 \u0dc4 \u0d91\u0db8 \u0db1\u0dd2\u0d9a\u0dca\u200d\u0dc0\u0db4\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4 \u0db8\u0d9f \u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dbb\u0db8 \u0da7\u0db4 \u0d9a \u0d92 \u0dc4\u0dcf \u0dc0 \u0daf \u0daf\u0dd0\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0db4\u0daf\u0dc5 \u0db1\u0dd4\u0daf\u0dba\u0d91\u0dc5\u0dd2 \u0dbb\u0dd2\u0dc4\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dc2\u0dab\u0d9a \u0dda\u0dc5 \u0dca\u0dba\u0dca\u0db7 \u0d9a\u0dba \u0dd2\u0db4\u0db6 \u0daf\u0dc01 \u0d92 \u0dc0\u0db1\u0dd4\u0daf \u0dc3\u0dd3\u200d\u0d9a \u0dcf\u0d9a\u0db4\u0dda \u0da2\u0dd3\u0daf \u0d9a \u0daf \u0db8\u0dc3\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0db6\u0db1 \u0dbb\u0dd3 \u0db8\u0da7 \u0dc0\u0daf\u0dc1\u0dba \u200d\u0dd0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0db4\u0dd2 \u0db4\u0dca \u0daf \u0dc0\u0dcf\u0da7 \u0db4\u0dd2 \u0daf\u0dba \u0db4\u0d9c \u0dd2\u0db4\u0db6 \u0daf\u0dc01 \u0dc0\u0db4\u0dd2 \u0db4\u0dca \u0dd0\u0db8 \u0db4\u0dc3 \u0dc2\u0dab\u0db8 \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dcf \u200d\u0dc0\u0daf\u0dc0\u0