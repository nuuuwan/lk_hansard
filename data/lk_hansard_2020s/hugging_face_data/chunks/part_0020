u0dd6 \u0d9a\u0dcf\u0dc3\u0dd4\u0d9a\u0dd4\u0dc0\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dc3 \u0dc0\u0dbd\u0dd2\u0db8\u0dc1\u0dda\u0daf \u0dc2\u0dab \u0dc0\u0dcf\u0dc3\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0db7\u0dd2 \u0dc0\u0da0 \u0dc0 \u0dd2\u0dbb\u0dd2\u0db4\u0dad \u0d9a \u0dbb\u0dd3 \u0db8 \u0db4 \u0dda\u0dda\u0db4\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d91\u0db8 \u0dc0\u0db7\u0dd2 \u0dc0\u0da0 \u0dc0\u0d8b \u0dca\u200d\u0dbb\u0dc4\u0dca \u0dc0\u0dc3 \u0dc0\u0db7\u0dd2 \u0dc0\u0da0 \u0dc0 \u0db8\u0dab\u0dca\u0dd2\u0d9a \u0db4\u0daf\u200d \u0db4 \u0dc0\u0db8\u0dd4 \u0d9a\u0dba \u0d9a\u0daf\u0dd31 \u0d92 \u0db4 \u0dda\u0dda\u0db4\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0db8\u0db8 \u0dca\u200d\u0dbb\u0dc4\u0dca \u0dc0\u0dc3 \u0dca\u200d\u0dbb\u0db8\u0dc0\u0dc3 \u0da7 \u0d9a\u0dc2\u0dab \u0d9a\u0dbb \u0d87\u200d1 (iii) 291\u0d8b3]5\u0dbb\u0dd31 (iv) \u0db4\u0dca \u0daf \u0dc0\u0dcf\u0da7 \u0dc0\u0db7\u0dd2 \u0dc0\u0da0 \u0dc0 \u0d9a\u0dd2\u0dba\u0da7\u0dd4\u0daf \u0db8\u0d9f\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0db6\u0dc0 \u0daf\u0dd3 \u0d87\u0dd2 \u0dd3\u0dbb\u0dba \u0dc0\u0db1\u0dd4\u0daf \u0d9a\u0da7\u0dba\u0dd4\u0dda \u0d9a\u0dba\u0dd2\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0daf\u0dd2 \u0dc0\u200d\u0dba\u0d8b 2025192195 \u0dbb\u0dd2 \u0daf \u0dc0\u0dcf\u0da7 \u0daf\u0dc0 \u0dc0\u0dcf\u0d9a \u200d \u0da9\u0dd4 \u0db8\u0dd4\u0dbb \u0d9a\u0dba \u0dc4\u0dd0 \u0dba\u0dd3\u0db8 \u0dc4\u0dcf \u0dc0 \u0daf \u0dca\u200d\u0dbb\u0dc4\u0dca \u0dc0\u0dc3 \u0db4\u0dda \u0db4\u0d9a\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d\u0dbb\u0dc0 \u0d9a \u0dca\u200d\u0dbb\u0dc3\u0dc0 \u0dbb\u0dd3 \u0db8\u0da7 \u0dc0\u0db4\u0db4\u0dca\u0db4\u0dc2\u0dab\u0dc2\u0dc0 \u0db4\u0d9a\u0db4\u0dbd\u0dd2\u0db81\n\n(\u0dca) \u0dc0\u0dc3\u0dc0\u0dc5 \u0db4 \u0dc0\u0db4\u0daf1\n\n(\u0b85) (i) \u0ba4\u0bc6\u0bbe\u0bc8\u0ba4\u0bae\u0bcd \u0ba8\u0bbf\u0bb2\u0bb5\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1.\n\n\u0bb5\u0bc6\u0bbe\u0b95\u0ba9\u0b99\u0bcd\u0b95\u0bae\u0bb3\u0baa\u0bcd \u0baa\u0bc1\u0ba4\u0bbf\u0ba4\u0bc6\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bc1\u0ba4\u0b9a\u0baf\u0bcd\u0baf\u0bc1\u0bae\u0bcd\u0bb0\u0baa\u0bc6\u0bbe\u0ba4\u0bc1 \u0bb5\u0bc6\u0bbe\u0b95\u0ba9 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0ba4\u0bcd \u0ba4\u0b95\u0b9f\u0bc1\u0b95\u0bae\u0bb3 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc6\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0ba8\u0bb0\u0bcd \u0b92\u0bb0\u0bc1\u0bb5\u0bae\u0bb0\u0ba4\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0bbf\u0bb5\u0bc1 \u0ba4\u0b9a\u0baf\u0bcd\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0ba4\u0baa\u0bb1\u0bc1\u0bae\u0b95\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0bb5\u0bbf\u0bae\u0bb2 \u0bc8\u0ba9\u0bc1\u0b95\u0bcd\u0bb0\u0b95\u0bc6\u0bbe\u0bb0\u0bb2\u0bcd 2024.12.30\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0ba4\u0b9a\u0baf\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb3\u0bcd \u0bb5\u0bbf\u0bb3\u0bae\u0bcd\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd\u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0bb0\u0bc8\u0bb1\u0bcd \u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba9. \u0bae\u0bc1\u0ba4\u0bb2\u0bcd \u0ba4\u0b9f\u0bae\u0bb5\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbf\u0bae\u0bb2 \u0bc8\u0ba9\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba4\u0bc1\u0bb5\u0bc1\u0bae\u0bcd \u0b9a\u0bc8\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc6\u0bbe\u0ba4 \u0b95\u0bc6\u0bbe\u0bb0\u0bc8\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb2\u0bcd, 2025.03.25\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0bc8\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0ba4\u0b9a\u0baf\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb3\u0bcd \u0bb5\u0bbf\u0bb3\u0bae\u0bcd\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bb5\u0bb3\u0bbf\u0baf\u0bbf\u0b9f\u0baa\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bb0\u0ba4\u0bc6\u0bbe\u0b9f\u0bc1, 2025.04.28\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0bb5\u0bbf\u0bae\u0bb2 \u0bc8\u0ba9\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bbf\u0bb1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba9."
