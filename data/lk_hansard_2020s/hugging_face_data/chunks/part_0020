    "chunk_text": "\u0db4\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0db1\u0dba \u0db4 \u0dc0\u0dd2\u0dc3\u0db3\u0dd3\u0dcf \u0db4\u0dba\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba \u0db4\u0dd3\u0dcf.\u0dbd\u0dda \u0db1\u0dd3\u0dd2\u0db6 \u0d9a\u0dd2\u0dba \u0db4\u0db1\u0dca\u0db4\u0db1\u0dca \u0db4\u0dba\u0dc0\u0dd2\u0dba \u0db4\u0db1\u0dca \u0dc0\u0dc4\u0db1\u0dca\u0db4\u0dc3\u0dda \u0dc4\u0dba\u0db4\u0dd4 \u0d92\u0dc0\u0dcf \u0db4\u0db1\u0dca\u0db4\u0dc0\u0dd2 , \u0db1\u0dca\u0db1\u0dd2\u0dc3\u0db1\u0dc3\u0dd4 \u0dc4\u0dba\u0db4\u0dd4 \u0d92\u0dc0\u0dcf.\u0dbd\u0dda \u0d85\u0db4\u0dd2 \u0d92\u0dc0\u0dcf \u0db4\u0dd2\u0dc5\u0dd2,\u0db1\u0dca\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0db4\u0dda\u0dc0\u0dcf\u0db4\u0d89 \u0dc0\u0dd2\u0dc1\u0dca\u0dcf\u0dd3 \u0d85\u0dc0\u0dd4\u0dbd\u0dca \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0db8\u0dd4\u0dba\u0dbd\u0dca \u0d85\u0db8\u0dc0\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\u0dc1\u0dca\u0db4\u0d89 \u0d9a\u0dc5\u0db8\u0dc0\u0db1\u0dcf\u0d9a\u0dbb\u0dab \u0db4\u0dba\u0dca\u0dcf\u0dbb\u0dca\u0dad\u0dca\u200d\u0db4\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0db4\u0dda\u0dc0\u0dcf \u0d89\u0dad\u0dca\u200d\u0dcf\u0db8\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0db4\u0dc0\u0dc5\u0d9a\u0da7 \u0dc4\u0dba\u0db1\u0dca\u0db1 \u0db8\u0dc0\u0dc4\u0db1\u0dca\u0dc3\u0dd2 \u0db4\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba \u0db4\u0dd3\u0dcf \u0d85\u0db4\u0dd2 \u0dba\u0db1\u0dca\u0db1\u0dc0\u0dcf.\u0dbd\u0dda\n\n,\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dca\u0dd2\u0db6\u0dad\u0dd4\u0db8\u0dc0\u0db1\u0dd2, \u0db8\u0dc0\u0da7 \u0dad\u0dca\u200d\u0dc0 \u0db4\u0d9a\u0da7\u0dd2 \u0db4\u0dc0\u0dd3\u0dcf\u0dc0\u0d9a\u0dca \u0dd2\u0db6\u0db4\u0db6\u0db1 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0dc0\u0dc4\u0dcf\u0db8\u0dc0\u0dcf\u0dbb\u0dca, \u0d9a\u0dca\u0db4\u0dc2\u0dda\u200d\u0dbb\u0dba \u0db4 ,\u0dc3\u0db1\u0dad\u0dca \u0d9a \u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dc3\u0db8\u0dc0\u0dc3\u0dd2\u0db6\u0dd2 .\u0dbd\u0dda \u0db8\u0dc0\u0dc4\u0dcf\u0db8\u0dc0\u0dcf\u0dbb\u0dca, \u0d9a\u0dca\u0db4\u0dc2\u0dda\u200d\u0dbb\u0dba \u0db4 ,\u0dad\u0dca\u0db4\u0dad\u0dca\u200d\u0dca\u0dad\u0dca, \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0dca\u0dd2\u0db6\u0dad\u0dd4\u0db8\u0dc0\u0dcf \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dd3\u0dba \u0db4 \u0db8\u0dc0\u0dcf\u0dbb\u0dca, \u0dc4\u0dba\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0dc1\u0dca\u0dcf\u0dd3 \u0db8\u0dd4\u0dba\u0dd3\u0d9a\u0dca \u0db4\u0dc0\u0db1\u0dca \u0d9a\u0dbb\u0dd3\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d85\u0db4\u0dd2 \u0dba\u0dc3\u0db1\u0da7 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dd3\u0dba \u0db4 \u0db8\u0dc0\u0dcf\u0dbb\u0dca, \u0dc0\u0dba\u0dcf\u0dca\u0dd8\u0dd2\u0db6 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0db4\u0dbd\u0dca \u0db4\u0d9a\u0ddd\u0da7\u0dd2 2,229\u0d9a -\u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0db4\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba \u0db4\u0db1 22.\u0dbd\u0dda29\u0d9a- \u0d87\u0dc3\u0db1\u0dad\u0dca\u200d\u0db4\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0d85\u0db1\u0dd4\u0db8\u0dc0\u0dad\u0dca\u200d \u0d9a\u0dbb\u0dd3\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d92 \u0d87\u0dc3\u0db1\u0dad\u0dca\u200d\u0db4\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dd3 \u0dc3\u0db8\u0dc0\u0dc3\u0db1\u0dad\u0dca\u200d \u0dc0\u0da7\u0dd2\u0db1\u0dcf\u0d9a\u0db8\u0dc0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0db4\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba \u0db4\u0db1 22.\u0dbd\u0dda29\u0dd2 .\u0dbd\u0dda \u0d85\u0db1\u0dd4\u0db8\u0dc0\u0dad\u0dca\u200d \u0d9a\u0dbb\u0dd3\u0dcf \u0db4\u0db1\u0dca\u0db4\u0dc0\u0dd2 , \u0d85\u0db1\u0dd4\u0db8\u0dc0\u0dad\u0dca\u200d \u0d9a\u0dbb\u0db4\u0dd4 \u0d92\u0dc0\u0dcf\u0db4\u0d89 breakdown \u0dad\u0d9a\u0d9a\u0dca \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dd3\u0dba \u0db4 \u0db8\u0dc0\u0dcf\u0dbb\u0dca, \u0db4\u0dc0\u0db1\u0dd4\u0db4\u0dc0\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0dca\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0db4 \u0dc0\u0dc3\u0db4\u0dbb\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0db4\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba \u0db4\u0db1 22.\u0dbd\u0dda29\u0d9a\u0dca \u0db4\u0dc0\u0db1\u0dca \u0d9a\u0dbb\u0dd3\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0dba\u0dc3\u0db1\u0dca \u0d92\u0dc0\u0dcf\u0db4\u0d89 \u0dc0\u0dd2\u0dc3\u0db1\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dd2\u0dba \u0db4\u0db1\u0dca\u0db1 \u0d9c\u0dd2\u0db4\u0dba \u0db4\u0dca\u0dad\u0dca \u0db4\u0dc0\u0dd3\u0dcf\u0dc0 ,\u0dad\u0dca\u200d \u0db4\u0dc0\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d85\u0db4\u0dd2 \u0dd3\u0db6\u0db4\u0dd4 \u0db4\u0dd3\u0dca\u0d9a\u0dd4\u0db8\u0dc0 \u0da2\u0dba \u0db4\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dab\u0dba \u0db4\u0d9a\u0dca \u0dad\u0dca\u200d\u0db8\u0dc0\u0dd2 \u0db8\u0dc0\u0db0\u0dca\u200d\u0dba\u0db8\u0dc0 \u0d85\u0db0\u0dd2\u0db4\u0daf\u0d9c\u0dd3 \u0db8\u0dc0\u0dcf\u0dbb\u0dca,\u0db4\u0d89 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dca\u0da7\u0db1\u0dca ,\u0db1\u0dca\u0db1 \u0dd3\u0dc3\u0dd3\u0db8\u0db8\u0dc0.\u0dbd\u0dda \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d92\u0d9a \u0d89\u0dad\u0dca\u200d\u0dcf\u0db8\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0db4\u0dc0\u0dc5\u0da7 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba \u0db4\u0dd3\u0dcf \u0d85\u0dca\u0da7 \u0db4\u0dad\u0dca\u200d\u0dca\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dd3\u0dc3\u0dd3\u0db8 \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0db8\u0dd4\u0dba\u0dbd\u0dca \u0d85\u0db8\u0dc0\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\u0dc1\u0dca\u0db4\u0dba \u0db4\u0db1\u0dca \u0d85\u0dca\u0da7 \u0db8\u0dd4\u0dba\u0dbd\u0dca \u0dd3\u0db6\u0dcf \u0daf\u0dd3\u0dd3\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf, \u0db8\u0dc0\u0db0\u0dca\u200d\u0dba\u0db8\u0dc0 \u0d85\u0db0\u0dd2\u0db4\u0daf\u0d9c\u0dd3 \u0db8\u0dc0\u0dcf\u0dbb\u0dca,\u0db4\u0d89 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1.\u0dbd\u0dda \u0db8\u0dc0\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dcf\u0dbb\u0dca \u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dc0\u0dcf \u0d9a\u0dd2\u0dba \u0db4\u0db4\u0dd4 \u0db8\u0dc0\u0db0\u0dca\u200d\u0dba\u0db8\u0dc0 \u0d85\u0db0\u0dd2\u0db4\u0daf\u0d9c\u0dd3 \u0db8\u0dc0\u0dcf\u0dbb\u0dca,\u0dba \u0db4 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dd3\u0dcf \u0dc0\u0dc3\u0db4\u0da7\u0db1 ,\u0dd3\u0db4,\u0dba\u0dbb \u0dc3\u0dc4 \u0dbb\u0db9\u0dd4\u0d9a\u0dca\u0d9a\u0db1\u0da7 \u0d85\u0dba\u0dcf\u0dc5 \u0dca\u0dcf\u0dbb\u0dc0\u0dbd\u0dca - \u0d92\u0dc0\u0dcf\u0dad\u0dca \u0dad\u0d9a\u0dca\u0d9a\u0db8\u0dc0 - \u0d85\u0db4\u0dd2 \u0dc4\u0dba\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0dad\u0db4\u0dc4\u0db8\u0dc0 \u0db1\u0dc3\u0dad\u0dca\u0db1\u0dda \u0dad\u0dad\u0dca\u200d\u0dc3\u0db1 traffic \u0d87\u0dd2\u0db6 \u0db4\u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0db1\u0dba \u0db4\u0d9a\u0dca \u0dad\u0db1\u0dc0\u0dcf.\u0dbd\u0dda"
  },
