    "chunk_text": "2026\u0daf\u0dd3 \u0d85\u0d9a\u0dda \u0d89\u0dbd\u0d9a\u0dca \u0dba \u0d9a\u0db8\u0ddc \u0d9a\u0dca\u0daf? \u0d9c \u0dbb\u0dd4 \u0db1\u0dd2\u0d9a\u0dba\u0ddd\u0da2\u0dba \u0dc3 \u0ddc\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba\u0db1\u0dd2 \u0dc3\u0ddc\u0db8\u0dca\u0db4\u0dca\u200d\u0dbb\u0daf\u0ddc\u0dba\u0dd2 \u0d9a\u0d9c \u0ddc\u0dc0\u0dd2\u0dba\u0ddc \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd \u0db4\u0db8\u0dab\u0d9a\u0dca\u0db8 \u0d9a\u0dc4\u0ddc\u0dba\u0db1 \u0d9a\u0d9c \u0ddc\u0dc0\u0dd2\u0dba\u0ddc \u0d9a\u0da9\u0ddc\u0dbd\u0dbb \u0d9a\u0dc4\u0ddc\u0dba\u0db1 \u0d9a\u0d9c \u0ddc\u0dc0\u0dd2\u0d9a\u0dba\u0d9a\u0dca \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0ddc\u0d9a\u0db4\u0ddc\u0d9a\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4\u0db8 \u0d9a\u0dc0\u0db1\u0dca\u0d9a\u0db1\u0dca. \u0db8\u0dc4\u0dd2\u0dba\u0dc0\u0d9c \u0db1\u0dba \u0d86\u0dc3\u0db1\u0d9a\u0dba\u0db1\u0dca \u0dc0\u0dd2\u0dba\u0dbd\u0dd4\u0dc0 \u0d86\u0dc3\u0db1\u0d9a\u0dba\u0db1\u0dca \u0db1\u0d9a\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0db6\u0daf\u0dd4\u0dbd\u0dca\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0d9a\u0dba\u0db1\u0dca \u0d9a\u0da9\u0ddc\u0dbd\u0dbb \u0dc3\u0dad\u0dca\u0db4\u0ddc\u0daf\u0db1\u0dba \u0dbb\u0db1 \u0d9a\u0d9c \u0ddc\u0dc0\u0dd2\u0dba\u0db1\u0dca \u0dc4\u0daf\u0db1\u0dca\u0db1 \u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0ddc\u0d9a\u0db4\u0ddc\u0d9a\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4\u0db8 \u0d9a\u0dc0\u0db1\u0dca\u0d9a\u0db1\u0dca. \u0db8\u0dc4\u0dd2\u0dba\u0dc0\u0d9c \u0db1\u0dba \"\u0dd3\u0db8\" \u0dbd\u0ddc\u0db4\u0d9a\u0dda \u0d85\u0d9a\u0dca \u0dbb 1 050\u0d9a\u0dca \u0dc0\u0dd2\u0dc1\u0ddc\u0dbd \u0d89 \u0ddc \u0daf\u0dd0\u0dc0\u0dd0\u0db1\u0dca \u0db6\u0dd2\u0db8\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0ddc. \u0d85\u0db4\u0dd2 \u0d92 \u0da7 \u0d9a\u0dd2\u0dda\u0d9a\u0dda \u0dc3\u0dad\u0dca\u0dc0 \u0d9a\u0d9c \u0ddc\u0dc0\u0dd2\u0d9a\u0db4\u0ddc\u0dc5 \u0d9a\u0dd2\u0dba\u0dbd\u0ddc. \u0dc0\u0dc3\u0dbb 20 \u0da7 25 \u0da7 \u0d86\u0dc3\u0db1\u0dca\u0db1 \u0ddc\u0dbd\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0dca\u0d9a\u0dc3\u0dca \u0d92 \u0db6\u0dd2\u0db8 \u0dc0\u0dbd\u0dca \u0dc0\u0dd0\u0d9a\u0daf\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0d9a\u0dab\u0dca. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0daf\u0dd0\u0db1\u0dca \u0d92 \u0dc3\u0db3\u0dc4\u0ddc\n\n2245 2246\n\n\u0db4\u0ddc\u0dbb\u0dd2\u0d9a\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\n\n\u0d9c \u0dbb\u0dd4 \u0db1\u0dd2\u0d9a\u0dba\u0ddd\u0da2\u0dba \u0dc3 \u0ddc\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba\u0db1\u0dd2 \"\u0dc3\u0db3\u0dd4\u0db1\u0dca \u0dc0\u0d9c \u0ddc \u0db7\u0dd6\u0db8\u0dd2\u0dba\" \u0d9a\u0dd2\u0dba\u0dbd\u0ddc \u0db1 \u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0ddc. \u0d9a\u0dda\u0dc1\u0db4\u0ddc\u0dbd \u0dba\u0dd2\u0db1\u0dca\u0d9a \u0dc4\u0dba\u0dd2\u0dba\u0da7 \u0dba\u0db8\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0dca \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0ddc \u0db1 \u0dd0\u0db1 \u0dc0\u0dd0\u0da9 \u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0da7\u0dd2\u0dba\u0ddc \u0db1 \u0dd0\u0db1 \u0d85\u0d9a\u0dca \u0dbb 130\u0d9a\u0dca. \u0d85\u0db4\u0dd2 \u0dc0\u0ddc\u0dbb\u0dd2 \u0d89\u0da9\u0db8\u0d9a\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0dc0\u0dd2\u0dc0\u0ddc\u0dc4 \u0d9a\u0d9c \u0ddc\u0dc0\u0dd3\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0ddc \u0d85\u0d9a\u0dca \u0dbb\u0dba \u0db6\u0dd0\u0d9c\u0dd2\u0db1\u0dca \u0db1\u0db8 \u0db7\u0dd6\u0db8\u0dd2\u0d9a\u0dba\u0db1\u0dca \u0d85\u0d9a\u0dca \u0dbb 100\u0d9a\u0dca \u0d9a\u0daf\u0db1\u0dc0\u0ddc. \u0d89\u0dad\u0dd2\u0dbb\u0dd2 \u0d85\u0d9a\u0dca \u0dbb 30 \u0d86\u0d9a\u0dba\u0ddd\u0da2 \u0d9a\u0dba\u0d9a\u0dd4\u0da7 \u0d9a\u0daf\u0db1\u0dc0\u0ddc. \u0d94\u0dc4\u0dd4 \u0db4\u0dbd\u0dad\u0dd4\u0db8\u0dbb\u0dd4 \u0dc6\u0dd0\u0d9a\u0dca\u0da7\u0dbb\u0dd2\u0dba\u0d9a\u0dca \u0d9c \u0dc4\u0db1\u0dc0\u0ddc \u0d9a\u0d9c \u0ddc\u0dc0\u0dd3\u0db1\u0dca \u0db4\u0dbd\u0dad\u0dd4\u0db8\u0dbb\u0dd4 \u0dc0\u0d9c \u0ddc \u0dbb\u0db1\u0dc0\u0ddc. \u0d85\u0db4\u0dd2 \u0d92 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0db4\u0dbd\u0dad\u0dd4\u0db8\u0dbb\u0dd4 \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0ddc\u0daf\u0db1 \u0db4\u0dd2\u0da7 \u0dbb\u0da7 \u0dba\u0dc0\u0db1\u0dca\u0db1 \u0d85\u0dc0\u0dc1\u0dba \u0dc0\u0dd0\u0da9 \u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dba\u0db1\u0dc0\u0ddc. \u0d92 \u0d85 \u0dc0 \u0d9a\u0da9\u0ddc\u0dbd\u0dbb \u0dc3\u0dad\u0dca\u0db4\u0ddc\u0daf\u0db1\u0dba \u0dbb\u0db1 \u0d9a\u0d9c \u0ddc\u0dc0\u0dd2\u0d9a\u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0daf\u0dd3\u0db8 \u0db8\u0dba\u0dd2 \u0d85\u0d9a\u0dda \u0d85\u0dbb\u0db8\u0dd4\u0dab. \u0d85\u0db4\u0dd2 \u0d92 \u0d85\u0dbb\u0db8\u0dd4\u0dab \u0dbb\u0ddc \u0dc5\u0d9f\u0ddc \u0dc0\u0db1\u0dc0\u0ddc \u0d9c \u0dbb\u0dd4 \u0db1\u0dd2\u0d9a\u0dba\u0ddd\u0da2\u0dba \u0dc3 \u0ddc\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba\u0db1\u0dd2.\n\n\u0db8\u0dc4\u0dd2\u0dba\u0dc0\u0d9c \u0db1\u0dba \u0dbb\u0dd2\u0daf\u0dd3\u0db8\u0ddc\u0dd2\u0dba\u0dda\u0d9a\u0dda \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0ddc \u0db4\u0dd0\u0d9f\u0dd2\u0dbb\u0dd2 \u0dc0\u0d9c \u0ddc\u0dc0 \u0dc5 \u0db7\u0dd6\u0db8\u0dd2\u0dba\u0d9a\u0dca. \u0ddc\u0dbd\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0dca\u0d9a\u0dc3\u0dca \u0d92 \u0db7\u0dd6\u0db8\u0dd2\u0dba \u0d9a\u0db6\u0daf\u0ddc\u0d9a\u0d9c \u0db1 \u0dc4\u0dd2\u0da7\u0dd2\u0d9a\u0dda \u0d9a\u0dda\u0dc1\u0db4\u0ddc\u0dbd \u0d9a\u0dba\u0ddd \u0db1 \u0dd0\u0db1 \u0d85\u0d9a\u0dca \u0dbb 500\u0dba\u0dd2. \u0d85\u0db4\u0dd2 \u0d92 \u0da7 \u0d9a\u0dc4\u0ddc\u0db3 \u0d86\u0d9a\u0dba\u0ddd\u0da2 \u0d9a\u0dba\u0d9a\u0dca \u0d9a \u0db1\u0dc0\u0ddc. \u0dbb\u0dd2\u0daf\u0dd3\u0db8\u0ddc\u0dd2\u0dba\u0dda\u0daf \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9a\u0db1\u0dca \u0dbd\u0dc0 \u0ddc\u0d9a\u0dda \u0daf\u0dd4\u0dda\u0db4\u0dad\u0dca\u0db8 \u0db4\u0dca\u200d\u0dbb\u0ddc\u0d9a\u0dda\u0dc1\u0dd3\u0dba \u0d9a\u0dbd\u0dca \u0db8\u0dca \u0d9a \u0ddc\u0da7\u0dca\u0db8\u0ddc\u0dc3\u0dc0\u0dd2\u0db1\u0dca \u0db1 \u0d9a\u0dca. \u0d85\u0db4\u0dd2 \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0d86\u0d9a\u0dba\u0ddd\u0da2\u0db1 \u0d9a\u0dc4\u0ddc\u0dba\u0ddc\u0d9a\u0d9c \u0db1 \u0dba\u0db1\u0dc0\u0ddc. \u0d9c \u0dbb\u0dd4 \u0db1\u0dd2\u0d9a\u0dba\u0ddd\u0da2\u0dba \u0dc3 \u0ddc\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba\u0db1\u0dd2 \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0dba\u0da7 \u0db4\u0dad\u0dca\u0d9a\u0dc0\u0dbd\u0ddc \u0dc0\u0db8 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0daf\u0dba\u0dd2. \u0d92 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0daf \u0d87\u0dad\u0dd4\u0db8\u0dc5 \u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0d9a\u0db8\u0dca \u0dc0\u0dd0\u0da9 \u0db4\u0da7\u0db1\u0dca \u0d9c \u0dad\u0dca\u0d9a\u0dad\u0dca.\n\n\u0d94\u0db6 \u0dc0\u0dd4\u0dbb\u0dd4\u0dad\u0dca \u0daf\u0db1\u0dca\u0db1\u0dc0\u0ddc \u0db8\u0dc4\u0dd2\u0dba\u0dc0\u0d9c \u0db1\u0dba \u0d9a\u0dda\u0dc0\u0dad\u0dca \u0daf\u0db9\u0ddc\u0db1 \u0d9a\u0dd2\u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dda\u0dc1\u0dba \u0d85\u0dad\u0dd2\u0daf\u0dd4\u0dc2\u0dca \u0dbb \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dda\u0dc1\u0dba\u0d9a\u0dca \u0db6\u0dc0. \u0db1 \u0dc0\u0ddc\u0dbb\u0dd2 \u0dbb\u0db8\u0ddc\u0db1\u0dca \u0dba\u0d9a\u0dca\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0d9a\u0dab\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0db4\u0dd2 \u0d9a\u0dba\u0ddd\u0da2\u0db1\u0ddc \u0dbb\u0dbd\u0ddc \u0dad\u0dd2\u0d9a\u0db6\u0db1\u0dc0\u0ddc 2026\u0daf\u0dd3 \u0db4\u0dd4\u0dbd\u0dca\u0dbd\u0d9c \u0dc3\u0dca\u0dba\u0ddc\u0dba \u0dc0\u0dd0\u0dc0 \u0dc4\u0daf\u0db1\u0dca\u0db1. \u0d92 \u0dc3\u0db3\u0dc4\u0ddc \u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0dba\u0db1\u0dc0\u0ddc. \u0d92 \u0dc0\u0dd0\u0dc0 \u0dc4\u0dd0\u0daf\u0dd4\u0dc0\u0ddc\u0da7 \u0db4\u0dc3\u0dca\u0d9a\u0dc3\u0dca \u0db4\u0dc4\u0dc5\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0d9a\u0db6\u0db1 \u0db6\u0d9a\u0dd2\u0db1\u0dd2\u0d9c \u0dc4\u0dc3\u0dbd\u0dca\u0db4 \u0dc0\u0dd0\u0dc0 \u0db4\u0dc4\u0dc5\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0d9a\u0db6\u0db1 \u0d9a\u0d9c \u0ddc\u0db1\u0dca\u0d94\u0dd4\u0dc0\u0dc0 \u0dc0\u0dd0\u0dc0 \u0db4\u0dc4\u0dc5\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0d9a\u0db6\u0db1 \u0db8\u0dd3\u0dc0\u0dd0\u0dad\u0dca\u0d9a\u0dad\u0dca \u0dc0\u0dd0\u0dc0 \u0d9a\u0dd2\u0dba\u0db1 \u0dc0\u0dd0\u0dda \u0d94\u0d9a\u0dca\u0d9a \u0ddd\u0db8 \u0db4\u0dd4\u0dbb\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4\u0dc0\u0dc0\u0db1\u0dca. \u0d9a\u0dc4\u0dca\u0db1\u0dca \u0dc0\u0d9c \u0ddc\u0dc0 \u0db4\u0db8\u0dab\u0d9a\u0dca \u0dbb\u0d9a\u0d9c \u0db1 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d9a\u0d9c \u0ddc\u0dc0\u0dd3\u0db1\u0dca\u0da7 \u0dba\u0dbd \u0db8\u0dc4 \u0d9a\u0daf \u0db8 \u0d85\u0dc3\u0dca\u0dc0\u0dda\u0daf\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4\u0dc0\u0dc0\u0db1\u0dca \u0dc3\u0dbb\u0dd4 \u0db6\u0dd2\u0db8\u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0dc4\u0daf\u0dbd\u0ddc \u0d9a\u0daf\u0db1\u0dc0\u0ddc. \u0d85\u0dc0\u0dd4 \u0ddc\u0dc2\u0dca\u0da7 \u0dba\u0da7 \u0dc4\u0dd0\u0db8 \u0daf\u0ddc\u0db8\u0dad\u0dca \u0d89\u0dbb\u0dd2 \u0dc5\u0db4\u0dd4 \u0db7\u0dd6\u0db8\u0dd2\u0dba\u0da7 \u0d85\u0db4\u0dd2 \u0db4\u0dab \u0d85\u0dbb\u0d9a\u0d9c \u0db1 \u0d9a\u0daf\u0db1\u0dc0\u0ddc. \u0db1\u0d9a\u0dc4\u0db8 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd4\u0db8\u0d9a\u0dca \u0db1\u0d9a\u0dca \u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0d9a\u0db8\u0dca \u0d9c \u0db8\u0db1 \u0dba\u0db1\u0dca\u0d9a\u0db1\u0dca \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0d9a\u0dda \u0d9c \u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dd2."
