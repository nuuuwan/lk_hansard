u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dd9\u0db1\u0dca\u0dd3\u0dd4\u0dbb\u0dd9\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba4\u0bae\u0bb2\u0bae\u0bc8\u0ba4\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0d9c\u0dd4\u0dc0 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dda\u0db8\u0db1\u0dd2\u0d8b \u0d94\u0db6\u0dda\u0db8\u0dc0\u0da7 \u0dc0\u0db8\u200d\u0dba\u0daf \u200d \u0d9a \u0dba 35\u0dc2\u0dab \u0daf\u0dd3\u0d9a\u0dc0 \u0dd2\u0db4\u0db6 \u0daf\u0dc01 \u0d94\u0db6\u0dda\u0db8\u0dc0 \u0d9a\u0dae\u0dc0 \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb 1\n\n\u0d9c\u0dd4 \u0d85\u0dd2\u0dba\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0daf\u0dca \u0dd9 \u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b85\u0bc8\u0bbf\u0bb2 \u0baa\u0bbf\u0bb0\u0b9a\u0bc6\u0bbe\u0ba4\u0bcd) (The Hon. Amila Prasad) \u0db4\u0dad1 \u0db8\u0db4 \u0db4\u0daf\u0d9a\u0dc0\u0daf \u0d9c \u0d9a\u200d\u0dc0\u0dc3 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dc0\u0d8b \u0d91\u0db4 \u0db8 \u0dca1\n\n\u0db8\u0dc0 \u0dbb\u0dd3 \u0dd2\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dd2\u0da7\u0dd2 \u0d9a\u0dc0\u0dba \u0dc0\u0daf \u0db4\u0dca\u0d9a\u0dd21 \u0dcf\u0dc0\u0dd2\u0d9a \u0dca\u200d\u0dbb\u0daf\u0dc0 \u0d9c\u0db1\u0dd4\u0db4\u0dc3\u0db1\u0dd4 \u0dc3 \u0d9a\u200d Eimsky Business Solutions (Pvt.) Limited \u0dbb\u0dd3 \u0dc4\u0db8\u0dc0\u0d9c\u0db8 \u0d87\u0dda\u0dc5\u0dd4 \u0dc3\u0dd4\u0db6\u0dd2\u0dca \u0dc4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0daf\u200d \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db1\u0dd2\u0db4 \u0db1\u0dcf\u0dba \u0dc0\u0db8\u0dc0\u200d\u0dba\u0daf\u0dba \u0dc0\u0db4 \u0db4 \u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc4\u0db8\u0dc0\u0d9c\u0db8\u0da7 \u0dc4\u0db8\u0dc4\u0dda\u200d \u0dcf\u0dc0\u0dd2\u0d9a \u0d9c\u0db1\u0dd4\u0db4\u0dc3\u0db1\u0dd4 \u0dc3 \u0d9a\u200d \u0dc0\u0d9a \u0dbb\u0dd3 \u0db4\u0dca \u0dc0\u0daf\u0dc4\u0dda\u0dae\u0dc0\u0daf \u0d9a\u0db6\u0dc0 \u0db4\u0dc3\u0dd2\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbb\u0dd3 \u0d91\u0d9a \u0dd0 \u0dd0\u0dbb\u0dd2\u0dbd\u0dd2\u0dd21 \u0d91\u0dda\u0db8\u0dc0 \u0db4\u0dca \u0db4\u0db8\u0dc0\u0db4 \u0dc0\u0db4 \u0d9a\u0daf\u0dd3 \u0d92\u0db4\u0dc2\u0dab \u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0daf\u0dc0\u0dc3 \u0dd0\u0daf\u0dca\u0dc3 \u0dbb\u0dd3 \u0d9a\u0dc0 \u0dd2\u0dbb\u0dd2\u0db4\u0dad \u0d9a\u0dc0\u0d9a\u0db4\u0dda\u0daf\u0dd3 \u0dc0 \u0da7 \u0db4 \u0dc5\u0dd2 \u0db4\u0daf\u0dd21 \u0dd0\u0db6\u0dd0\u0dd2\u0d8b \u0d91 \u0d91\u0dda\u0db8\u0dc0 CEO \u0db4\u0d9a\u0dc4 \u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dca \u200d \u0dc2\u0dab1 \u0db4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d8b \u0da1\u0dc0 \u0dc0\u0dbb\u0dd6 \u0dd2\u0db4\u0db6 \u0daf\u0dc01 \u0d92 \u0dc3\u0dd2 \u0dbd\u0dd4 \u0db4\u0daf\u0dca\u0daf \u0d86 \u0d91\u0dc2\u0dab\u0d9a \u0d9c \u0d9a\u200d\u0dc0\u0db8\u0d8b \u0dc0\u0db0\u0dd2\u0db4\u0daf\u0d9c\u0dd3 \u0db8\u0dc0\u0dbd\u0dd2\u0db8\u0d9c \u0d9c\u0dc0\u0dc4\u0dda\u0dda\u0d8b \u0dcf\u0dc0\u0dd2\u0d9a \u0db6\u0dc4\u0dda \u0d9c\u0dc0\u0dc4\u0dda\u0dda \u0db1\u0dd4 \u0dba\u0db4\u0da7\u0dca \u0dd4\u0dba\u0daf\u0dd0\u0dc3\u0dd2 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4 \u0db8\u0dd4\u0dc3 \u0d861 \u0d91\u0db8 \u0db8\u0dd4\u0dc3 \u0d86 \u0d9a\u0dc5\u0db8 \u0dc0\u0d9a\u0dba \u0d9a\u0dba \u0daf\u0dca\u0dca\u200d\u0dd2\u0daf\u0d9a \u0dc0\u0d9a \u0dba\u0dcf\u0db4\u0dda \u0dd2 \u0dc5\u0db8 \u200d \u0dda\u0dba\u0dc2\u0dab \u0dc3\u0dba \u0dd4\u0daf\u0dca\u0d9c\u0d9a\u0db4 \u0d9a\u0dd4\u0db4 \u0dc4\u0db8\u0dc0\u0d9c\u0db8\u0da7 \u0dc4\u0dd2\u0dd2\u0dba \u0d9a\u0dbb\u0db8 \u0dba\u0dcf\u0db4\u0dda \u0dc0\u0dcf\u0db1\u0dd2\u0dc0\u0dcf\u0dc3\u0db7\u0dc0\u0daf \u0dc0 \u0dc4\u0dc0\u0dca\u200d\u0dc0\u0dba \u0d9a\u0daf \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dcf\u0daf \u0dd0\u0daf\u200d \u0dc3\u0dd2\u200d\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0da7 \u0dc0 \u0da7 \u0db6\u0d9a \u0d9a\u0dba \u0daf\u0dc01 \u0d92 \u0db1\u0dd2\u0dc4\u0dc0 \u0db8\u0db8 \u0dd0\u0daf\u200d \u0dbb\u0dd3 \u0daf\u0dc0\u0d8b \u0db4\u0dca Eimsky Business Solutions (Pvt.) Limited \u0dc4 Omobio (Pvt.) Limited \u0dbb\u0dd3 \u0dc4\u0db8\u0dc0\u0d9c\u0dca\u0daf\u0d9a \u0dc3\u0dd2 \u0dbd\u0dd4 \u0dba\u0dc0\u0dcf\u0dba \u0db4\u0d9a\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d\u0dbb\u0dc0 \u0d9a\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dcf\u0daf \u0dc0\u0dcf\u0db4\u0dc1\u0dda\u0dc2 \u0dc0\u0dbd\u0dd2\u0db8\u0dbd\u0dd2\u0db4\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dda \u0db4 \u0d9a \u0dca \u0d9a\u0dc0\u0dba\u0d9a \u0dc4\u0db7\u0dc0\u0daf\u0dc2\u0dab \u0dba \u0dc0 \u0db4 \u0db1 \u0dc0\u0dcf\u0d9c \u0d9a\u0dc0\u0db0\u0dd2 \u0dd2 \u0dc2\u0dab\u0dc2 \u0dc2\u0dab \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbb\u0dd3 \u0d9a\u0dc01\n\n\u0d9c\u0dd4 \u0db8\u0dd6\u0dbd\u0dbd\u0dcf\u0dc4\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dd9\u0db1\u0dca\u0dd3\u0dd4\u0dbb\u0dd9\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba4\u0bae\u0bb2\u0bae\u0bc8\u0ba4\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0d9c\u0dd4\u0dc0 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dda\u0db8\u0dc0\u0d8b \u0d94\u0db6\u0dda\u0db8\u0dc0\u0db4 \u0d9a\u0dc0\u0d9a \u0dc0\u0daf\u0dc4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb1"
