    "chunk_text": "\u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbb\u0dd3 \u0d9a\u0dc01 \u0dd0\u0db6\u0dd0\u0dd2\u0d8b \u0db4\u0dca \u0daf \u0db4\u200d\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc0 \u0d9a\u0db8\u0d9a \u0db4\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd0 \u0dd01 \u0d9c\u0dd4\u0dc0 \u0d87\u0db8\u0dd2\u0dda\u0db8\u0db1\u0dd2\u0d8b \u0d94\u0db6\u0dda\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dc0\u0d8b \u0dcf \u0dc0\u0db0\u0dd2 \u0dd2\u0dda\u0db8\u0dc0 \u0db4\u0dca\u0d9a\u0da7 \u0dc3 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0daf\u0dd4 \u0db4\u0daf \u0daf\u0dc01 \u0dd0\u0db6\u0dd0\u0dd2\u0d8b \u0db4\u0dca\u0d9a\u0da7 \u0db8\u0dd4\u0dc5\u0dd4 \u0dba\u0dc0\u0dcf\u0dba \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d\u0dbb \u0db8 \u0dd6 \u0dc3\u0dc0 \u0dca \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd11 \u0d92 mentality \u0d91\u0d9a \u0dc3\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd11 \u0d92 \u0db1\u0dd2\u0dc4\u0dc0 \u0db8\u0db8 \u0dc5\u0db8\u0dd4\u0daf \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dd0\u0db8\u0dd0\u0dd2\u0dd2\u0d8b \u0da2\u0dd2\u0da7\u0dbd\u0da7 \u0d86 \u0dba\u0dc0\u0dcf\u0dba \u0d9a\u0da7 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dca\u0d8b \u0dc0\u0db4\u0dd2 \u0dd0\u0db4\u0db8\u0db1\u0db8 \u0d91\u0d9a \u200d\u0dd0 \u0d9a\u0da7 \u0d91\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd1 \u0db6\u0daf1 \u0dc0\u0dcf \u0dc2\u0dab\u0dc2\u0db4\u0dda \u0dc0\u0db4\u0dd2 \u0d9a \u0d92 mentality \u0d91\u0d9a \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd11 \u0d92 \u0daf\u0dc0\u0db4 \u0db8 \u0dca\u0dab\u0dca\u0da9\u0dd4 \u0d9a\u0dba \u0d94\u0db6\u0dda\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dc0 \u0d9a \u0d92 mentality \u0d91\u0d9a \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd11\n\n\u0d92 \u0daf\u0dc0\u0db4 \u0db8 \u0dba\u0dcf \u0db1\u0dd2\u200d\u0dba\u0db8 \u0dbb\u0dd3 \u0db4\u0dc3 \u0dc2\u0dab \u200d\u0db8\u0dd2\u0d8b startup ecosystem \u0d91\u0d9a\u0dc2\u0dab \u0dc3\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd1 \u0dbb\u0dd3 \u0d91\u0d9a1 \u0d91\u200d \u0db4\u0d9a\u0dc0\u0da7 \u0db4\u0d9c\u0dc0\u0dd2\u0dc2\u0dab \u0db4\u0daf\u0d9a\u0dc0\u0daf\u0da7 \u0dc0\u0db8\u200d\u0d9a \u0db4\u0daf\u0da0\u0dca\u0da0\u0da0 \u0db4\u0dc3 \u0dc2\u0dab \u0dd2\u0db4\u0db6 \u0daf\u0dc01 \u0d92 \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb startup ecosystem \u0d91\u0d9a\u0dc2\u0dab \u0dc3\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd1\u0d8b \u0db8\u0dd4 \u0d9a \u0dc0\u0db8\u200d\u0d9a \u0db4\u0daf\u0da0\u0dca\u0da0\u0da0 \u200d\u0dd0 \u0dc2\u0dab \u0dd2\u0db4\u0db6 \u0daf\u0dc01 \u0d92 \u200d\u0db8\u0dd2 \u0dc0\u0db4\u0db4\u0dca\u0db4 \u0dca\u200d\u0dbb\u0dca\u200d\u0dc0 \u0d9a\u0dab\u0dca\u0dd2\u0dc0 \u0db8\u0dc2\u0dab \u0daf SME sector \u0d91\u0db4\u0dc2\u0dab middle layer \u0d91\u0d9a1 \u0d92 SME sector \u0d91\u0db4\u0dc2\u0dab middle layer \u0d91\u0d9a \u0dc0\u0db8\u200d\u0d9a\u0d9a\u0dbb\u0db8 \u0dda\u0dc5 \u0db4\u0dca IT field \u0d91\u0d9a\u0da7 \u0db4\u0d9a\u0dc0\u0d9a\u0dd4 \u0dca\u200d\u0dbb\u0dc1\u0dda \u0dc2\u0dab \u0db4\u0daf\u0d9a\u0dc0 \u0dd2\u0db4\u0db6 \u0daf\u0dc01 \u0dc3\u0dc3\u0dc0 \u0dba \u0dc2\u0dab \u0dc0\u0dcf\u0db0\u0dd2 \u0da7 \u0db8\u0db8 \u0db4\u0dca \u0d9a\u0dae\u0dc0 \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb WSO2, Virtusa \u0daf\u0dd0\u0db1\u0dd2 top-notch companies \u0d9c\u0dd0 \u0db4 \u0dc0\u0db4\u0daf\u0dd21 \u0d92 \u0daf\u0dc0\u0db4 \u0db8 \u0dc5 \u0db8\u0da7\u0dca\u0da7\u0db4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0da7\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9c \u0d9a\u200d\u0d8b investors\u0d9a\u0dc0 \u0db4 \u0dc0 \u0dc0 \u0db4\u0d9c \u0d8a\u0db4\u0dda \u0db4 \u0db4\u0dbd\u0dd2\u0db8\u0dc3\u0dc0 \u0dca\u0dba\u0dca\u0db7 \u0d9a\u0dba\u0dd4 startups \u0d9c\u0dd0 \u0db4 \u0dc0\u0db4\u0daf\u0dd21 \u0db8\u0db8 \u0db4\u0dca \u0d9a\u0dae\u0dc0 \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db6\u0dd2\u0dc4\u0dda \u0dc4\u0dda \u0db4 \u0dc0 \u0dc0 \u0db4\u0d9c \u0d8b cash flow \u0d91\u0d9a\u0dc2\u0dab \u0dc3\u0dc0\u0db4\u0d9c \u0d8b \u0d92 \u0daf\u0dc0\u0db4 \u0db8 projects delivery \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd4\u0dc5\u0dd4\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d8b clients\u0d9a\u0dc0 \u0d9a\u0dab\u0dca\u0dd2\u0dc0 \u0db8\u0dc2\u0dab \u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d8b employees\u0d9a\u0dc0 900\u0dc2\u0dab\u0d8b 950\u0dc2\u0dab \u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb middle layer \u0d91\u0d9a \u0d9c\u0dd0 \u0dd21 \u0db4\u0db8\u0dc0\u0d9a\u0dc3\u0d8b \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7 \u0db4\u0d9a\u0dc0\u0d9a\u0dd4 capacity \u0d91\u0d9a\u0dc2\u0dab \u0dd2\u0db4\u0db6 \u0daf\u0dc01 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7 \u0daf\u0dd0\u0dd2\u0dc2\u0dab \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd4\u0dc5\u0dd4\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dab\u0dca\u0dd2\u0dc0 \u0db8\u0dc2\u0dab \u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0daf\u0dc01 \u0d92\u0db4\u0d9c\u0dc0 \u0d86\u0d9a\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0daf \u0db4\u0dca field \u0d91\u0db4\u0dc2\u0dab \u0dca\u0dba\u0dc2\u0dab\u0dc2\u0dc0 \u0d9a\u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0db4\u0daf\u0db1\u0dd4\u0db4\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbb\u0dd3\u0dc3\u0dd2\u0db8 \u0daf\u0dd0\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0db4\u0daf\u0dc5\u0dc2\u0dab \u0dd0 \u0dd0 \u0dbb\u0dd3 \u0d91\u0d9a\u0dd2 \u0db8\u0db4 \u0dc0\u0dc3 \u0dc41\n\n\u0dc3\u0dc3\u0dc0 \u0dba \u0dc2\u0dab \u0dc0\u0dcf\u0db0\u0dd2 \u0da7\u0d8b procurement system \u0d91\u0d9a digitalize \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd1 \u0dbb\u0dd3 \u0d9a\u0dc0 \u0dbb\u0dd3\u0daf\u0daf\u0dc01 \u0dd0\u0db6\u0dd0\u0dd2\u0d8b procurement system \u0d91\u0d9a \u0dda\u0dc5 middle layer \u0d91\u0db4\u0dc2\u0dab \u0d9a\u0dab\u0dca\u0dd2\u0dc0 \u0db8\u0da7\u0d