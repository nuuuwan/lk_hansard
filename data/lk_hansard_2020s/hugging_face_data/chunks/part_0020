    "chunk_text": "\u0b85\u0ba8\u0bcd\u0ba4\u0baa\u0bcd \u0ba4\u0baa\u0ba3\u0bcd\u0bae\u0ba3\u0bbf \u0b8e\u0ba9\u0bcd\u0ba9 \u0ba4\u0b9a\u0baf\u0bcd\u0ba4\u0bbe\u0bb0\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1\u0bbe\u0bb2\u0bcd, \u0b85\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bbe\u0bbf\u0baf permits\u0b90\u0baa\u0bcd \u0ba4\u0baa\u0bb1\u0bcd\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0bb0\u0bc1\u0bb5\u0ba4\u0bbe\u0b95\u0b95\u0bcd \u0b95\u0bc2\u0bb1\u0bbf, 6 \u0b9a\u0b95\u0bbe\u0b9f\u0bbf \u0bb0\u0bc2\u0baa\u0bbe\u0b95\u0baf \u0b9a\u0bae\u0bbe\u0b9a\u0b9f\u0bbf \u0ba4\u0b9a\u0baf\u0bcd\u0ba4\u0bc1 \u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bbe\u0bb0\u0bcd. \u0ba8\u0bbe\u0ba9\u0bcd \u0b87\u0ba4\u0bc1 \u0b9a\u0bae\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0bae\u0bbe\u0b95 \u0ba4\u0b95\u0bcc\u0bb0\u0bb5 \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0bb2\u0bbe\u0bb2\u0bcd \u0b95\u0bbe\u0ba8\u0bcd\u0ba4 \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0b9f\u0bae\u0bcd \u0ba4\u0b9a\u0bbe\u0ba9\u0bcd\u0ba9\u0ba4\u0baa\u0bbe\u0bb4\u0bc1\u0ba4\u0bc1, \u0b89\u0b9f\u0ba9\u0b9f\u0bbf\u0baf\u0bbe\u0b95 \u0b87\u0ba4\u0bc1 \u0b9a\u0bae\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0bae\u0bbe\u0b95 \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0b95 \u0b8e\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0bbe\u0b95\u0b95\u0bcd \u0b95\u0bc2\u0bb1\u0bbf\u0baf\u0b9a\u0ba4\u0bbe\u0b9f\u0bc1, \u0b85\u0ba4\u0bc1 \u0b9a\u0bae\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0bae\u0bbe\u0b95 \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0b9a\u0baa\u0b9a\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b8e\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0ba4\u0bbf\u0ba9\u0ba4\u0bae\u0bbe\u0ba9\u0bcd\u0b95\u0bb1\u0baf\u0bc1\u0bae\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0ba4\u0bcd \u0ba4\u0ba8\u0bcd\u0ba4\u0bbe\u0bb0\u0bcd. \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0b95 \u0b85\u0bb5\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0ba9\u0bcd\u0bb1\u0bbf \u0ba4\u0b9a\u0bbe\u0bb2\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0b9a\u0bb1\u0ba9\u0bcd.\n\n\u0db1\u0db4\u0db8\u0dab\u0d9a\u0dca \u0d9a\u0db1\u0ddc\u0d9a\u0dc0\u0dba\u0dd2 \u0dc0\u0dd2\u0d9a\u0dc1\u0dca\u0dc2\u0d9a\u0dba\u0db1\u0dca\u0db8 \u0db8\u0db8 \u0d9a\u0db8\u0dca \u0ddc\u0dbb\u0dab\u0dba\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0d9a\u0dda \u0db4\u0dc0\u0dd4\u0d9a\u0dbd\u0dca \u0d85\u0dba \u0d9a\u0dc4\u0ddd \u0d95\u0db1\u0dd1\u0db8 \u0db4\u0dc0\u0dd4\u0dbd \u0daf\u0dbb\u0dd4 \u0daf\u0dd0\u0dbb\u0dd2\u0dba\u0db1\u0dca \u0db4\u0ddc\u0dc3\u0dbd\u0dca \u0dba\u0dd1\u0db8 \u0dc3\u0db3\u0dc4\u0ddc \u0db4\u0dca\u200d\u0dbb\u0dc0\u0ddc\u0dc4\u0db1 \u0db8\u0ddc\u0db0\u0dba \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dc3\u0dd2\u0dba\u0dba\u0da7 90\u0d9a\u0dca\u0db8 \u0d9a \u0ddd\u0dbb\u0ddc \u0d9c \u0db1\u0dca\u0d9a\u0db1\u0dca \u0dd3\u0dc0\u0dd2\u0dbd\u0dca \u0dbb\u0dae. \u0dc0\u0dd2\u0d9a\u0dc1\u0dca\u0dc2\u0d9a\u0dba\u0db1\u0dca\u0db8 kindergarten \u0d89\u0db3\u0dbd\u0ddc \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0dc1\u0dca\u200d\u0dbb\u0dca\u0dab\u0dd2\u0d9a\u0dda \u0dc3\u0dd2\u0da7 5 \u0d9a\u0dc1\u0dca\u200d\u0dbb\u0dca\u0dab\u0dd2\u0dba \u0daf\u0d9a\u0dca\u0dc0\u0ddc \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dc0\u0ddc\u0dc4\u0db1 \u0db8\u0ddc\u0db0\u0dba \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d92 \u0d85\u0db8\u0dca\u0db8\u0dbd\u0ddc \u0ddc\u0dad\u0dca \u0dbd\u0ddc \u0d9a \u0ddd\u0dbb\u0ddc\u0d9a\u0d9c \u0db1 \u0dad\u0dd2\u0d9a\u0db6\u0db1\u0dca\u0d9a\u0db1\u0dca \u0d9c \u0d9a\u0db8\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0db1 \u0dd3\u0dc0\u0dd2\u0dbd\u0dca \u0db1 . \u0d92 \u0dd3\u0dc0\u0dd2\u0dbd\u0dca \u0db1\u0d9a\u0d9a\u0dca \u0daf\u0dbb\u0dd4 \u0daf\u0dd0\u0dbb\u0dd2\u0dba\u0db1\u0dca \u0dc4 \u0dbb \u0db4\u0dc3\u0dca\u0d9a\u0daf\u0d9a\u0db1\u0d9a\u0dca \u0d85\u0dbb\u0d9a\u0d9c \u0db1 \u0dba\u0db1\u0dc0\u0ddc. \u0daf\u0dd0\u0db1\u0dca \u0d9a\u0db8\u0dca \u0dc4\u0dbb\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba\u0d9a\u0dca. \u0d9a\u0db8\u0ddc \u0daf \u0dd3\u0dc0\u0dd2\u0dbd\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9a\u0db1\u0dca \u0d85\u0db4\u0da7 \u0d85 \u0dba\u0dc0\u0dc1\u0dba \u0d9a\u0daf\u0dba\u0d9a\u0dca. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d92 \u0db1\u0dd2\u0dba\u0ddc\u0db8\u0db1\u0dba \u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dd2. \u0d9a\u0db8\u0dca \u0dc4\u0dbb\u0dd2\u0db8 \u0dc0\u0dd0\u0daf\u0d9c \u0dad\u0dca \u0d9a\u0dba\u0ddd\u0da2\u0db1\u0ddc\u0dc0\u0d9a\u0dca. \u0d9a\u0dc0\u0db1 \u0d9a\u0dc0\u0dbd\u0ddc\u0dc0 \u0db1\u0db8\u0dca \u0db8\u0db8 \u0d9a\u0db8\u0dca \u0d9c \u0dd0\u0db1 \u0d9a\u0dc0\u0db1\u0db8 \u0dae\u0ddc \u0dbb\u0db1\u0dc0\u0ddc. \u0d9a\u0db8\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0dba\u0ddd\u0da2\u0db1\u0ddc\u0dc0\u0d9a\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9c \u0dd0\u0db1 \u0db8\u0db8 \u0dc3\u0dca\u0dad\u0dd4\u0db8\u0dad\u0dd2\u0dc0\u0db1\u0dca \u0d9a\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d92 \u0db1\u0dd2\u0dba\u0ddc\u0db8\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0d9a\u0db8\u0dca\u0daf\u0dd3 \u0dd3\u0dc0\u0dd2\u0dbd\u0dca \u0dbb\u0dae \u0db0\u0ddc\u0dc0\u0db1\u0dba \u0dbb\u0db1 \u0d85\u0dba\u0da7\u0dad\u0dca \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0ddc\u0dc4\u0db1 \u0db4\u0dc4\u0dc3\u0dd4 \u0db8\u0dca \u0dbd\u0db6\u0ddc \u0d9c \u0db1\u0dca\u0db1\u0ddc \u0db4\u0ddc\u0dbb\u0dd2 \u0d9a \u0ddd\u0d9c\u0dd2 \u0dba\u0ddc\u0da7\u0dad\u0dca \u0d9a\u0dd2\u0dc3\u0dd2\u0db8 \u0d85\u0dc3\u0ddc\u0db0\u0ddc\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0d9a\u0db1\u0ddc\u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d92 \u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d92 \u0d9a\u0dd2\u0dbb\u0dd3\u0d9a\u0db8\u0dca\u0daf\u0dd3 \u0dc0\u0dd0\u0daf\u0d9c \u0dad\u0dca \u0ddc\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0db8\u0dba\u0dd2 \u0dc3\u0dc0\u0dc0\u0dd8 \u0dd3\u0d9a\u0dbb\u0ddd\u0daf \u0dbb\u0dae \u0d9a\u0dba\u0ddc\u0daf\u0ddc \u0d9c \u0dd0\u0db1\u0dd3\u0db8. EV \u0dba\u0da7\u0d9a\u0dad\u0dca \u0db1\u0db1 \u0dd3\u0d9a\u0dbb\u0ddd\u0daf \u0dbb\u0dae\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dba\u0ddc \u0d9c \u0dad\u0dca \u0ddc\u0db8 \u0d92 \u0d9a\u0dbd\u0ddc\u0d9a\u0dd4 \u0db4\u0dc4\u0dc3\u0dd4\u0dc0\u0d9a\u0dca \u0d9a\u0dc0\u0db1\u0dc0\u0ddc. \u0dc0\u0dd2\u0dc0\u0dd8 \u0dd3\u0dc0\u0dd2\u0dbd\u0dca \u0db1 \u0d9a\u0dd2\u0db1\u0dca \u0db8 \u0dc3\u0dca\u0dc3\u0d9a\u0dba\u0d9a\u0dca \u0dba\u0db1\u0d9a \u0ddc\u0da7 \u0db4\u0ddc\u0d9a\u0dbb \u0dad\u0dd2\u0d9a\u0db6\u0db1 \u0daf\u0dd6\u0dc0\u0dd2\u0dd2 \u0da7\u0dd2 \u0db1\u0dba\u0ddc\u0d9a \u0d87\u0d9f \u0db4\u0dd4\u0dbb\u0ddc\u0db8 \u0d9c \u0dd1\u0d9a\u0dc0\u0db1\u0dc0\u0ddc. \u0dc0\u0dd0\u0dc3\u0dca\u0dc3 \u0d9a\u0dc0\u0dbd\u0ddc\u0dc0\u0da7 \u0daf\u0dd0\u0db1\u0dca \u0dad\u0dd2\u0d9a\u0db6\u0db1 \u0dd3\u0dc0\u0dd2\u0dbd\u0dca \u0dbb\u0dae\u0dc0\u0dbd \u0dba\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dba\u0db8\u0dca\u0d9a\u0dd2\u0dc3\u0dd2 \u0d86 \u0ddc\u0dbb\u0dba \u0db1\u0dd2\u0dba\u0ddc\u0db8\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc4\u0dbb\u0dc4\u0ddc \u0d92 \u0dd3\u0dc0\u0dd2\u0dbd\u0dca \u0dbb\u0dae \u0db0\u0ddc\u0dc0\u0db1\u0dba \u0dbb\u0db1 \u0d85\u0dba\u0da7 \u0dba\u0db8\u0dca\u0d9a\u0dd2\u0dc3\u0dd2 \u0daf\u0dd2\u0dbb\u0dd2 \u0daf\u0dd3\u0db8\u0db1\u0ddc\u0dc0\u0d9a\u0dca \u0dbd\u0db6\u0ddc \u0daf\u0dd3\u0dbd\u0ddc \u0d85 \u0dba\u0dc0\u0dc1\u0dba \u0dc3\u0db4\u0ddc\u0dc0\u0d9c \u0dc3\u0dc0\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0ddc \u0d85\u0db4\u0dd2 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0ddc\u0dc0\u0d9a\u0dca \u0dbd\u0db6\u0ddc \u0d9a\u0daf\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dd3\u0dc0\u0dd2\u0dbd\u0dca \u0dbb\u0dae\u0d9a\u0dda \u0d9c \u0db8\u0db1\u0dca \u0d9c \u0db1\u0dca\u0db1\u0ddc \u0db8\u0dd3\u0db1\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dd2 \u0dc0\u0db1 \u0d86 \u0ddc\u0dbb\u0dba\u0da7 \u0d86\u0dc0\u0dbb\u0dab\u0dba \u0dbb \u0d9c \u0db1\u0dca\u0db1 \u0d92 \u0dbb\u0dae\u0dba \u0dad\u0dd4\u0db8\u0dc5\u0da7 \u0d9a\u0dc4\u0ddc\u0db3\u0dd2\u0db1\u0dca \u0dc0\u0ddc \u0dba\n\n2375 2376\n\n[\u0d9c \u0dbb\u0dd4 \u0da2\u0db1\u0ddc\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0da5 \u0db1\u0db8\u0dca. \u0db1\u0dd2\u0dc3\u0ddc\u0db8\u0dca \u0ddc\u0dbb\u0dd2\u0dba\u0dda\u0db4\u0dbb \u0db8\u0dc4 \u0ddc]\n\n2025 \u0d9a\u0db1\u0ddc\u0dc0\u0dd0\u0db8\u0dca\u0db6\u0dbb 27\n\n\u0dbd\u0dd0\u0d9a\u0db6\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc3 \u0dc3\u0dca \u0dbb \u0d9c \u0db1\u0dca\u0db1 \u0d92 \u0dd3\u0dc0\u0dd2\u0dbd\u0dca \u0db1\u0d9a\u0d9a\u0dca \u0dc3\u0dd2 \u0db1\u0dbd\u0dca \u0da7\u0dd2 \u0dc4\u0dbb\u0dd2\u0dba\u0da7 \u0daf\u0ddc\u0d9c \u0db1\u0dca\u0db1 \u0d85\u0dc0\u0dc1\u0dba \u0db4\u0dc4\u0dc3\u0dd4 \u0db8\u0dca \u0d9a\u0dc0 \u0d9a\u0dc0\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0ddc\u0dc0\u0d9a\u0dca \u0d9a\u0daf\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0db4\u0dd2 electric vehicles - EVs - \u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1."
