    "chunk_text": "2026 \u0dc0\u0dbb\u0dca\u0dc2\u0db4 \u0d9c\u0dad\u0dca\u0dad\u0db4\u0dad\u0dcf\u0dad\u0dca\u0dad, 2026\u0daf\u0dd3 \u0db4\u0da7\u0dd2\u0dad\u0dbd \u0dd9 \u0dc3\u0dd4\u0dda \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d \u0db4 \u0db4\u0dc0\u0dd4 \u0db4\u0dc0\u0dca \u0d85\u0dd9 \u0dbb\u0dbb\u0dca \u0db4 \u0db4\u0daf\u0dca\u0dc0\u0dbd\u0dca \u0dcf \u0dd2\u0dbb\u0db4\u0dca \u0dda. \u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0db4\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc1\u0dca\u0d85\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd\u0db4\u0dda \u0d86\u0dd9\u0dba\u0dc1\u0dca\u0dcf\u0dbd\u0dcf\u0db4\u0dda \u0db4\u0dda \u0db4\u0dc0\u0dbd\u0dcf\u0dc0 \u0dc0 \u0db4\u0dbb\u0dcf\u0da7 \u0dd2\u0dad\u0dca\u0dad\u0dd2\u0d9a 4 \u0dc0\u0dd2\u0dad\u0dbb\u0dba\u0dd2 \u0dd2\u0d9a\u0db4\u0db6\u0dca \u0db4\u0dca . \u0d85\u0db4\u0dd2 \u0d91 \u0d86\u0dd9\u0dba\u0dc1\u0dca\u0dcf\u0dbd\u0dcf\u0dc0 \u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca \u0db8\u0dd2\u0dad\u0dbd\u0dd2\u0db4 64\u0d9a\u0dca \u0db4\u0db4\u0dcf\u0daf\u0dc0 \u0dc0\u0dcf. \u0db4\u0db4\u0dca\u0db4\u0dbb\u0dcf\u0db4\u0daf\u0dab\u0dd2\u0db4 \u0dc0\u0dd2\u0dc1\u0dca\u0d85\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd\u0db4\u0dda \u0dc3 \u0db4\u0dc3\u0dde\u0d9b\u0dba \u0dd3\u0da8\u0db4\u0dda \u0dc0\u0dc0\u0daf\u0dba \u0dbb\u0dc3\u0dcf\u0db4 \u0dcf\u0d9c\u0dcf\u0dbb, \u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0d9c\u0dcf\u0dbb \u0dc3\u0dc4 \u0dcf \u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0d9c\u0dcf\u0dbb \u0dc3\u0d82\u0d9a\u0dd3\u0dbb\u0dca\u0dba\u0db4\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca \u0db8\u0dd2\u0dad\u0dbd\u0dd2\u0db4 120\u0d9a\u0dca \u0db4\u0db4\u0dcf\u0daf\u0dc0 \u0dc0\u0dcf. \u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0db4\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc1\u0dca\u0d85\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd\u0db4\u0dda \u0dc0\u0dc0\u0daf\u0dba \u0db0\u0dca\u200d\u0dba\u0dc3\u0d85\u0dcf\u0dcf \u0db4 \u0db4\u0d9c\u0dcf\u0da9 \u0dd0\u0d9f\u0dd3 \u0dc3\u0dc4 \u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca \u0db8\u0dd2\u0dad\u0dbd\u0dd2\u0db4 45\u0d9a\u0dca \u0db4\u0db4\u0dcf\u0daf\u0dc0 \u0dc0\u0dcf. \u0db4\u0dd9\u0dcf\u0daf\u0dd4\u0db4\u0dda \u0d9c\u0dad\u0dca\u0dad\u0dad\u0dcf , \u0dc0\u0dd2\u0dc1\u0dca\u0d85\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd \u0dd9\u0daf\u0dca\u0db0\u0dca\u200d\u0dd2\u0d9a\u0db4\u0dda \u0dc0\u0dc0\u0daf\u0dba\u0dc0\u0dbb\u0dd4\u0dca \u0db4\u0dda \u0d85\u0da9\u0dd4\u0dc0\u0d9a\u0dca \u0dd2\u0d9a\u0db4\u0db6 \u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0db4\u0dc3\u0dde\u0d9b\u0dba \u0d85 \u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dc1\u0dca\u0db4\u0dad\u0dca\u0dad \u0d91\u0d9a\u0dca\u0dbb \u0dc3\u0dcf\u0dbb\u0da0\u0dca\u0da0\u0da1\u0dcf \u0dbb\u0dbb\u0dbd\u0dcf \u0d91\u0dbb\u0d9f\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0dc3\u0dd2\u0d9a \u0dbb\u0dbb\u0db4\u0d9c \u0dd2\u0d9a\u0db4\u0db6 \u0dc0\u0dcf, \u0dc3\u0dd2\u0db4\u0dbd\u0dd4 \u0dc0\u0dd2\u0dc1\u0dca\u0d85\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd\u0dc0\u0dbd \u0dc0\u0dc0\u0daf\u0dba \u0db0\u0dca\u200d\u0dba\u0dc3\u0d85\u0dcf\u0dcf \u0dc3\u0dc4 \u0dcf \u0db4\u0dc3\u0dde\u0d9b\u0dba \u0d85 \u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dc1\u0dca\u0db4 \u0d9f\u0dd2\u0dca \u0dc0\u0dc0\u0daf\u0dba\u0dc0\u0dbb\u0dd4\u0dca \u0dc3\u0dd4\u0db8\u0dc5\u0dad\u0dca\u0dad \u0dbb\u0dbb \u0d9c\u0dd0\u0db1\u0dd3 \u0da7.\n\n\u0d8a\u0dc5\u0d9f\u0da7, \u0d85\u0dd9\u0da7 \u0dd2\u0d9a\u0db6\u0dd4\u0dab\u0dd4 \u0db4\u0dbd\u0dcf\u0d9a\u0dd4 \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0d9a\u0dca \u0dad \u0dba\u0dd2, \u0db4\u0dca \u0dc0\u0dcf\u0dc3\u0dd2\u0dbb\u0dcf\u0d9c\u0dcf\u0dbb \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0. \u0db4\u0dda \u0db4\u0dc0\u0daf\u0dca\u0daf\u0dd3 \u0d85\u0dd9\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0db4\u0dc0\u0dbd\u0dcf \u0dd2\u0d9a\u0db4\u0db6 \u0dc0\u0dcf\n\n\u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0dd9 \u0db4 \u0dc3\u0dc4 \u0dcf \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db6\u0dcf\u0db0\u0dca\u200d\u0dbb\u0db4\u0d9a\u0dca \u0dc0\u0dd2\u0db4 \u0dba\u0dd4\u0dd4\u0db8 \u0dd0 \u0dd0. \u0d85\u0db4\u0dd2 \u0db4\u0dd9\u0dcf\u0dc5 \u0dc1\u0dd2\u0dc2\u0dba\u0dcf\u0db0\u0dca\u200d\u0dcf\u0dbb \u0dc3 \u0dc1\u0dd2\u0dc2\u0dba\u0dcf\u0db0\u0dca\u200d\u0dcf\u0dbb \u0daf\u0dd3 \u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0dbb\u0dbb \u0dd2\u0d9a\u0db4\u0db6 \u0dc0\u0dcf. \u0d8a\u0dc5\u0d9f\u0da7, \u0d85\u0db4\u0dd2 \u0dad\u0dc0\u0dad\u0dca\u0dad \u0dc0\u0dd2\u0db4\u0dc1\u0dca\u0d85\u0dd2\u0dad \u0db4\u0daf\u0db4\u0d9a\u0dca \u0dbb\u0dbb \u0dc0\u0dcf. \u0d92 \u0db4 \u0dcf\u0dbb\u0d9a\u0dca\u0daf? \u0d85\u0dd9\u0da7 \u0dc0\u0dd2\u0db4\u0daf\u0dca\u0dc1\u0dd3\u0db4 \u0daf\u0dd0\u0dd4 \u0d85\u0dc0\u0dc1\u0dca\u0dba\u0dba\u0dd2 \u0dc0\u0dd2\u0db4\u0daf\u0dca\u0dc1\u0dd3\u0db4 \u0daf\u0dd0\u0dd4 \u0dbd\u0d82\u0dbb\u0dcf\u0db4\u0dda \u0d86\u0dbb\u0dca\u0dd2\u0dbb\u0db4\u0da7, \u0dbd\u0d82\u0dbb\u0dcf\u0db4\u0dda \u0dcf \u0dc0 \u200d\u0dbb\u0dcf\u0dda\u0db0\u0dca\u200d \u0db4\u0da7 - human capital \u0dc3\u0dc4 \u0dcf - \u0dbd\u0db6\u0dcf \u0d9c\u0dca \u0d85\u0dc0\u0dc1\u0dca\u0dba\u0dba\u0dd2. \u0d92 \u0dc3\u0dc4 \u0dcf \u0dc0 \u0d85\u0db4\u0db4\u0dca\u0db4 \u0dc3\u0dd9\u0dcf\u0db4 \u0dc3\u0dd9\u0d9a\u0dca\u200d\u0dbb \u0db4 \u0db4\u0dc3\u0d85\u0dba\u0dd2. 2025 \u0d85\u0db4 \u0dc0\u0dd0\u0db4 \u0db4\u0db4\u0ddd\u0da2\u0dca\u200d \u0dcf\u0dc0\u0dbd \u0dd2\u0d9a\u0db4\u0db6 \u0dc0\u0dcf, \u0dc0\u0dd2\u0db4\u0daf\u0dca\u0dc1\u0dca \u0dc0\u0dd2\u0dc1\u0dca\u0d85\u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd\u0dc0\u0dbd \u0dc3\u0dd9\u0dcf\u0db0\u0dd2 \u0dd9\u0dcf\u0da8 \u0dcf\u0dbd\u0dcf \u0dd0\u0daf\u0dd1\u0dd3\u0db8 \u0dc3\u0dc4 \u0dcf \u0dc1\u0dd2\u0dc2\u0dba\u0dad\u0dca\u0dad\u0dc0 \u0db4\u0dd2\u0dbb\u0dd2 \u0db6\u0dc0. \u0d8a\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dd9\u0dcf\u0da8 \u0dcf\u0dbd\u0dcf \u0dc0\u0dd2\u0db4\u0dc1\u0dca\u0d85\u0dd2\u0dad\u0dba\u0dd2. \u0d8a\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dd9\u0dcf\u0da8 \u0dcf\u0dbd\u0dcf \u0dd0\u0daf\u0dd1\u0dd3\u0db8\u0db4\u0dda \u0d85\u0dc0\u0dc3\u0d85\u0dcf\u0dcf \u0d85\u0dd9 \u0dbd\u0db6\u0dcf \u0d9c\u0dca \u0db4\u0dca \u0db4\u0dbd\u0ddd\u0dbb\u0db4\u0dda \u0dd2\u0d9a\u0db4\u0db6 \u0db4 \u0dcf\u0dc4 \u0dc0\u0dd2\u0dc1\u0dca\u0d85\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd\u0dc0\u0dbd\u0dd2\u0dca . \u0dc0\u0dd2\u0dc1\u0dca\u0d85\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd\u0dc0\u0dbd \u0db4\u0dc1\u0dca\u200d\u0dbb\u0d85\u0dab\u0dd2\u0d9c\u0dad \u0dd2\u0dbb\u0dd3\u0db8\u0dda \u0dd2\u0d9a\u0db4\u0db6 \u0dc0\u0dcf. QS \u0db4\u0dbd\u0ddd\u0dbb \u0dc0\u0dd2\u0dc1\u0dca\u0d85\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd \u0db4\u0dc1\u0dca\u200d\u0dbb\u0d85\u0dab\u0dd2\u0d9c\u0dad \u0dd2\u0dbb\u0dd3\u0db8\u0dda \u0d85\u0dd4 \u0dc0, \u0d92 Top 500 \u0dc3\u0dd4\u0db8\u0dc5\u0dad \u0dc0\u0dd6 \u0dc0\u0dd2\u0dc1\u0dca\u0d85\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dbd\u0dc0\u0dbd \u0dc3\u0dd9\u0dcf\u0db0\u0dd2 \u0dd9\u0dcf\u0da8 \u0dcf\u0dbd\u0dcf \u0dd0\u0daf\u0dd1\u0dd3\u0db8 \u0dc3\u0dc4 \u0dcf \u0d85\u0db4\u0dd2 \u0dc1\u0dd2\u0dc2\u0dba\u0dad\u0dca\u0dad\u0dc0 \u200d\u0dbb\u0daf\u0dcf \u0db4 \u0dbb\u0dbb \u0dc0\u0dcf. \u0dd9\u0dcf\u0da8 \u0dcf\u0dbd\u0dcf \u0d9c\u0dcf\u0dc3\u0d85\u0dd4\u0db8, \u0d86 \u0dcf\u0dbb, \u0db4\u0dc3\u0dde\u0d9b\u0dba \u0dbb\u0d9a\u0dca\u0dc2\u0dba\u0db4, \u0db4\u0dca \u0dc0\u0dcf\u0dc3\u0dd2\u0dbb \u0dd9 \u0dc3\u0dd4\u0dbb\u0dda \u0db4\u0dc0\u0dd4 \u0db4\u0dc0\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf\u0dbb\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca \u0db8\u0dd2\u0dad\u0dbd\u0dd2\u0db4 20\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf, \u0dc3\u0dd9\u0dbb\u0dd2 \u0db4 \u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca \u0db8\u0dd2\u0dad\u0dbd\u0dd2\u0db4 80\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0db8\u0dd4\u0dc5\u0dd4 \u0dbb\u0dcf\u0dbd\u0db4 \u0dc3\u0dc4 \u0dcf \u0dc0\u0dd0\u0db4 \u0dbb\u0dbb \u0dc0\u0dcf. \u0db4\u0dda \u0db4\u0dc0\u0daf\u0dca\u0daf\u0dd3, \u0dc1\u0dd2\u0dc2\u0dba\u0db4\u0dca \u0dd2\u0d9a\u0dc3\u0d85\u0db4\u0daf\u0db4\u0daf\u0db4 \u0d9a\u0dca \u0dc3\u0dd4\u0db8\u0dc5\u0dad\u0dca\u0dad \u0dbb\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db4\u0dda \u0db8\u0dd6\u0dbd\u0dd2\u0dbb \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db4\u0dcf\u0dc0\u0dbd\u0dd2\u0db4 \u0dbb\u0dbb \u0d9c\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0dbb \u0dbd\u0dd0\u0dd2\u0dbd\u0dcf \u0dd2\u0d9a\u0db4\u0db6 \u0dc0\u0dcf. \u0dc3\u0daf\u0dcf \u0dbb\u0dba\u0db4\u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0db4\u0da7 \u0d9c\u0dad\u0dca\u0dad\u0db4\u0dad\u0dcf\u0dad\u0dca\u0dad, \u0d85\u0db4\u0dd2 \u0db4 \u0dca \u0db4 \u0db4 \u0db4\u0daf\u0db4\u0d9a\u0dca \u0dbb\u0dbb \u0dc0\u0dcf. \u0dc1\u0dd2\u0dc2\u0dba\u0db4\u0dcf \u0db4 \u0dc0\u0dcf, \u0daf\u0dd0\u0dd4 \u0d9c\u0dca \u0dc0\u0dcf, \u0dd0\u0dc0\u0dad \u0d91 \u0dc0\u0dcf, \u0d85\u0db4\u0dd2 \u0db6\u0dd0\u0dd4\u0db1\u0dda\u0dbb\u0dbb \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4 \u0dbb\u0da7 \u0d91\u0dc5\u0db4\u0db9 \u0dc0\u0dcf. \u0d91\u0dad\u0db4\u0dbb\u0dcf\u0da7 \u0dc1\u0dd2\u0dc2\u0dba\u0db4\u0dcf \u0dc3\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0d85\u0dd9\u0da7 \u0db4\u0dc3\u0d85\u0dc0\u0db4 \u0dbb\u0dbb \u0dc0\u0dcf, \u0d85\u0dbd\u0dd4\u0dad\u0dca\u0dad \u0daf\u0dd0\u0dd4 \u0d85\u0dbb\u0db4\u0d9c . \u0db4\u0dda\u0dbb \u0d85\u0db4\u0db4\u0dca\u0db4 \u0d91\u0dbb \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0d85 \u0d9a\u0dca, \u0daf\u0dd0\u0dd4 \u0dc0\u0dd0\u0da9\u0dd2 \u0dbb\u0dbb \u0d9c\u0dca \u0da7 \u0dbb\u0dbb ."
