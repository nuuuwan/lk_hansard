    "chunk_text": "\u0dd3\u0d82,\u0db8\u0dc0\u0db4\u0d89 ,\u0dc3\u0da7\u0dbd\u0dd4 \u0dd2\u0db6\u0db4\u0db6\u0db1 \u0db6\u0dc0 \u0d85\u0db4\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2,\u0db1\u0dca\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d9a\u0dc5\u0dd4\u0dad\u0dca\u200d\u0dbb \u0daf\u0dd2\u0dc3\u0db1\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0db4\u0d89 \u0dd3\u0d82,\u0db8\u0dc0 \u0d85\u0db4\u0dca\u0ddd \u0dca\u0dc4\u0d9a\u0dca \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d92 \u0d85\u0db4\u0dca\u0ddd \u0dca\u0dc4\u0db8\u0dc0 \u0dca\u0dcf\u0d9a\u0dca \u0db4\u0dd2\u0da7 \u0dad\u0dca\u200d\u0db8\u0dc0\u0dd2 \u0dca\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0db4,\u0db1 \u0dba \u0db4\u0db1\u0dca\u0db4\u0db1\u0dca.\u0dbd\u0dda ,\u0dc3\u0da7\u0dbd\u0dd4 \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0dbb\u0da2\u0dba \u0db4\u0dad\u0dca \u0db8\u0dc0\u0dc3\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0db4\u0dc0\u0dd3\u0dcf \u0d92 ,\u0dc3\u0da7\u0dbd\u0dd4 \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dbb\u0db4,\u0db1, \u0d92\u0dc0\u0dcf \u0dd3\u0dcf\u0db7 \u0dd3\u0db6\u0db1 \u0d86\u0dba \u0db4\u0dad\u0dca\u200d\u0db1 \u0db6\u0dc0\u0da7 \u0dca\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d85\u0dca\u0da7 \u0d85\u0dc0\u0dc1\u0dca\u0dba\u0dd2 .\u0dbd\u0dda \u0d92 \u0db1\u0dd2\u0dc3\u0dcf, \u0dad\u0db8\u0dc0 ,\u0dc3\u0da7\u0dbd\u0dd4 \u0dc0\u0dd2\u0dc3\u0db3\u0dcf\u0db4,\u0db1, \u0d85\u0dd3\u0dcf\u0db7\u0dba \u0db4 \u0d85\u0dc0\u0db8\u0dc0 \u0d9a\u0dbb\u0db4,\u0db1, \u0dd3\u0d82,\u0db8\u0dc0\u0dba \u0db4 \u0dc0\u0dca\u0dcf \u0d9a\u0dcf\u0dbb\u0dca\u0dba \u0db4\u0d9a\u0dca\u0dc2\u0db8\u0dc0 \u0d86\u0dba \u0db4\u0dad\u0dca\u200d\u0db1\u0dba \u0db4\u0d9a\u0dca \u0db6\u0dc0\u0da7 \u0dca\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d85\u0dca \u0dc3\u0db8\u0dc0\u0d9f \u0dad\u0d9a\u0dad\u0dd4 \u0db4\u0dc0\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba \u0db4\u0dd3\u0dcf \u0d92 \u0dc3\u0dd2\u0dba \u0db4\u0dbd\u0dd4 \u0db1\u0dd2\u0dd3\u0db0\u0dca\u200d\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0da7 \u0db4\u0dda \u0db4\u0db8\u0dc0\u0dca\u0db4\u0dc4\u0dca\u0db4\u0dad\u0dca\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0d85\u0dbb\u0dcf\u0db0\u0dca\u200d\u0db1\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d85\u0db4\u0dd2 \u0d94\u0db6\u0dad\u0dca \u0dad\u0d9a\u0dca\u0d9a \u0dad\u0d9a\u0dad\u0dd4 \u0db4\u0dc0\u0db1\u0dc0\u0dcf, \u0d86\u0da9\u0dd4\u0d9a\u0dca\u0dc0\u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0db4\u0da7 \u0d85\u0db4\u0dd2 \u0d94\u0db6\u0dad\u0dca \u0dad\u0d9a\u0dca\u0d9a \u0dc3\u0db8\u0dd3\u0dca\u0dc0 \u0dc0\u0dc3\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d89\u0dc4\u0dc5 \u0dc3\u0dd2\u0da7 \u0dca\u0dc4\u0dc5 \u0dba\u0d9a\u0dca\u0dc0\u0dcf \u0dc3\u0dd2\u0dba \u0db4\u0dbd\u0dd4 \u0db1\u0dd2\u0dd3\u0db0\u0dca\u200d\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0da7 \u0dc3\u0dc4 \u0db4\u0dc3\u0dda\u0dc0\u0d9a\u0dba \u0db4\u0db1\u0dca\u0da7 \u0db4\u0dda \u0db4\u0dc0\u0db1\u0dd4\u0db4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0dba \u0db4\u0d9a \u0db4\u0dc0\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba \u0db4\u0dd3\u0dcf \u0d85\u0db4\u0dd2 \u0d86\u0dbb\u0dcf\u0db0\u0dca\u200d\u0db1\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d92 \u0dc0\u0dcf\u0db4 \u0db8\u0dc0 \u0d9a\u0dc5\u0dd4\u0dad\u0dca\u200d\u0dbb \u0daf\u0dd2\u0dc3\u0db1\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0db4\u0d89 \u0db8\u0dc0\u0dcf\u0dbb\u0dca, \u0dbb\u0dd0\u0dc3\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0db4\u0dd2 \u0d92\u0d9a\u0dcf\u0db6\u0daf\u0dca\u0db0\u0dca\u200d \u0d9a\u0dcf\u0dd3 \u0dc3\u0da7\u0dc4\u0db1\u0d9a\u0dca \u0dc3\u0d9a\u0dc3\u0db1 \u0d9a\u0dbb\u0dd3\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d9a\u0dc5\u0dd4\u0dad\u0dca\u200d\u0dbb \u0db8\u0dc0\u0dcf\u0dbb\u0dca, 4\u0d9a, \u0dca\u0dcf\u0db1\u0dd4 \u0dbb \u0db8\u0dc0\u0dcf\u0dbb\u0dca, 15\u0d9a, \u0db8\u0dc0\u0dad\u0dd4,\u0db8\u0dc0 \u0db8\u0dc0\u0dcf\u0dbb\u0dca, 4\u0d9a, \u0db4\u0dc4\u0dca\u0dbb\u0dab \u0db8\u0dc0\u0dcf\u0dbb\u0dca, 5\u0d9a, \u0d85\u0dbd\u0dd4\u0dad\u0dca,\u0db8\u0dc0 \u0db8\u0dc0\u0dcf\u0dbb\u0dca, 8\u0d9a \u0d92\u0d9a\u0dcf\u0db6\u0daf\u0dca\u0db0\u0dca\u200d \u0d9a\u0dcf\u0dd3 \u0dc3\u0da7\u0dc4\u0db1\u0d9a\u0da7 \u0db6\u0dc3\u0db1 \u0dbb \u0db0\u0dca\u200d\u0dcf\u0dc0\u0db1\u0dba \u0db4 \u0db4\u0dc0\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d92\u0dc0\u0dcf\u0db4\u0d89 \u0dba \u0db4\u0dda \u0dba \u0db4\u0dda ,\u0dc3\u0da7\u0dbd\u0dd4 \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d85\u0db4\u0dd2 \u0d92\u0d9a\u0dcf\u0db6\u0daf\u0dca\u0db0\u0dca\u200d \u0d9a\u0dcf\u0dd3 \u0dc3\u0da7\u0dc4\u0db1\u0d9a\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0dad\u0db8\u0dc0 \u0db6\u0dc3\u0db1 \u0dbb \u0db0\u0dca\u200d\u0dcf\u0dc0\u0db1\u0dba \u0db4 \u0dc0\u0db1 \u0dc3\u0dd2\u0dba \u0db4\u0dbd\u0dd4 \u0db8\u0dc0\u0dcf\u0dbb\u0dca, \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db1\u0dc3\u0dc0\u0dad\u0dca\u200d \u0dc0\u0da7\u0dba \u0db4\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0db8\u0dc0\u0dc3\u0dcf \u0db6\u0dc3\u0db8 \u0db8\u0dc0\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d9a\u0dc3\u0db3\u0dc0\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d92 \u0dc4\u0dbb\u0dc4\u0dcf \u0dc0\u0dca\u0dcf\u0dad\u0dca \u0dbd\u0dd3\u0dba\u0dcf\u0dba\u0dd3 \u0db4\u0dd3\u0dc3 \u0d92\u0d9a\u0dcf\u0db6\u0daf\u0dca\u0db0\u0dca\u200d \u0db4\u0dc3\u0dda\u0dc0\u0dba \u0db4 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0db4\u0dcf\u0dad\u0dca\u0db8\u0dc0\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0db6\u0dd3\u0dcf\u0db4\u0dca\u0dca\u0db4\u0dbb\u0dca\u0dad\u0dca\u0dad\u0dd4 \u0db4\u0dc0\u0db1\u0dc0\u0dcf.\u0dbd\u0dda\n\n\u0db8\u0dd6\u0dd3\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa ,\u0dbb\u0dd4 \u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dc0\u0db1\u0dd2, \u0db4\u0dda \u0d86\u0d9a\u0dcf\u0dbb\u0db4\u0dba \u0db4\u0db1\u0dca \u0dc0\u0dca\u0dcf\u0dad\u0dca \u0db4\u0daf,\u0db4\u0dba \u0db4\u0db1\u0dca \u0dbb\u0da7 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0db1 \u0db8\u0dc0\u0dcf\u0dc0\u0dad\u0dca\u200d\u0d9a\u0da7 \u0db4,\u0db1\u0dba \u0db4\u0db1\u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0d85\u0db4\u0dda\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0dc4\u0dc3\u0db6\u0dc3\u0dd2 , \u0dc0\u0dd2\u0dca\u0d9a\u0dca\u0dc2\u0db4\u0d89 \u0d89\u0db1\u0dca\u0db1 \u0db4,\u0dca\u0dca\u0d9a\u0dca \u0d85\u0dba \u0db4 \u0db4\u0dda \u0dad\u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0db4 \u0db4\u0dad\u0dca\u0dbb\u0dd4\u0dda \u0d85\u0dbb\u0db4,\u0db1 \u0db1\u0dc3\u0dc4\u0dc3.\u0dbd\u0dda \u0d85\u0db4\u0dd2 \u0dad\u0db4\u0dc4\u0db8\u0dc0 \u0d9a\u0dd2\u0dba \u0db4\u0db1\u0dca\u0db4\u0db1\u0dca \u0d87\u0dd2 ? \u0d85\u0db4\u0dd2 \u0db7\u0dcf\u0dbb ,\u0dad\u0dca\u0db4\u0dad\u0dca \u0dc0\u0da8\u0dcf\u0da7\u0db4\u0dd4 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba \u0db4\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad\u0dca\u200d \u0dbb\u0da7\u0d9a\u0dca; \u0db1\u0dc3\u0dc0\u0dad\u0dd4\u0dab\u0dd4 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba \u0db4\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad\u0dca\u200d \u0dbb\u0da7\u0d9a\u0dca.\u0dbd\u0dda \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a, \u0db4\u0daf\u0dca\u0dc1\u0dca\u0dca\u0dcf\u0dd3\u0db1, \u0dc3\u0db8\u0dc0\u0dcf\u0da2\u0dba\u0dd3\u0dba \u0db4 \u0dc0\u0dc1\u0dca\u0db4\u0dba \u0db4\u0db1\u0dca \u0dc0\u0dd6 \u0dc3\u0dd1\u0db8\u0dc0 \u0d9a\u0dca\u0db4\u0dc2\u0dda\u200d\u0dbb\u0dba \u0db4\u0d9a\u0db8\u0dc0 \u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0db1\u0dba \u0db4 \u0db1\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dbb\u0dd3\u0dcf \u0dd2\u0db6\u0db6\u0dd2\u0da0\u0dca\u0dd2 \u0dbb\u0da7\u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0db7\u0dcf\u0dbb ,\u0dad\u0dca\u0db4\u0dad\u0dca.\u0dbd\u0dda \u0db1\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dbb \u0dd2\u0db6\u0db6\u0dd2\u0da0\u0dca\u0dd2 \u0dbb\u0da7\u0d9a\u0dca \u0dad\u0dad\u0dca\u200d\u0dc3\u0db1\u0dd2\u0db1\u0dca \u0dad\u0dc4\u0dcf\u0da7 \u0d85\u0db4\u0dd2 \u0dca\u0dab,\u0db1\u0dca\u0dc0\u0dcf\u0db4,\u0db1 \u0dba \u0db4\u0db1 \u0d85\u0dc0\u0dc3\u0db1 \u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0dca\u200d\u0db8\u0dc0\u0dd2 \u0dba\u0dc3\u0db1\u0dca \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dca\u0db4\u0db1\u0dca.\u0dbd\u0dda \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db4\u0dda \u0d9a\u0dca\u0d89\u0db8\u0dc0 \u0dc0\u0dca\u0dcf \u0dc3\u0dcf\u0dbb\u0dca \u0d9a\u0dc0 \u0d85\u0db4\u0dd2 \u0dc3\u0db4\u0dd4\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba \u0db4\u0dcf \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dca \u0db8\u0dc0\u0db4 \u0d85\u0dba\u0dc4\u0dc3\u0db1 \u0dba\u0dc3\u0d9a\u0dca\u0dc0\u0dd3\u0db8\u0dc0 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\u0dbd\u0dda\n\n\u0db8\u0dc0\u0da7 \u0d9a\u0dcf\u0dd3\u0dba \u0db4 \u0dd3\u0db6\u0dcf \u0daf\u0dd3\u0db8\u0dc0 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0\u0dca\u200d\u0db4\u0dba \u0db4\u0db1\u0dca \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dc0\u0dcf\u0da7 \u0dc3\u0db1\u0dad\u0dd4\u0dd2\u0db6\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d \u0db4\u0dc0\u0db1\u0dc0\u0dcf, \u0db8\u0dd6\u0dd3\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa ,\u0dbb\u0dd4 \u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dc0\u0db1\u0dd2.\u0dbd\u0dda"
