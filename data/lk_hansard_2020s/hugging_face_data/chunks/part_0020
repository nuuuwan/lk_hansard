    "chunk_text": "\u0d92 \u0dc0\u0dcf\u0db4 \u0db8\u0dc0 \u0d85\u0dba \u0dca\u0dc3\u0dc0\u0dc3\u0dad\u0dca\u0db4\u0dc0\u0db1 \u0dc0\u0dd2\u0dc0\u0dcf\u0dba\u0dba \u0db4\u0da7 \u0d85\u0dba\u0dcf\u0dc5 \u0d85\u0db8\u0dc0\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\u0dc1\u0dca\u0dba \u0db4\u0d9a\u0dca \u0dba \u0db4\u0da7\u0db4\u0dad\u0dca \u0dad\u0dca\u200d\u0db8\u0dc0\u0dd2 \u0dc0\u0dd2\u0db4\u0dc1\u0dca\u0dda\u0dc2\u0db4\u0dba \u0db4\u0db1\u0dca\u0db8\u0dc0 \u0db1\u0dcf,\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0db4\u0dad\u0dca \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dca\u0db4\u0db1\u0dca.\u0dbd\u0dda \u0d87\u0dad\u0dca\u0dad\u0dca\u200d\u0dc0\u0dc1\u0dca\u0db4\u0dba \u0db4\u0db1\u0dca\u0db8\u0dc0 construction industry \u0dad\u0d9a \u0dad\u0dca\u200d\u0db8\u0dc0\u0dd2 2018\u0da7 \u0db4\u0dca\u0dbb \u0db4\u0dda \u0dbb\u0db4\u0da8\u0dcf \u0dba\u0dc5 \u0da2\u0dcf\u0dd2\u0db6\u0d9a \u0db1\u0dd2\u0dc2\u0db1\u0dca\u0dcf\u0dba\u0db1\u0db4\u0dba \u0db4\u0db1\u0dca \u0dc3\u0dd2\u0dba \u0db4\u0dba \u0db4\u0da7 8\u0d9a\u0da7 \u0dc0\u0dcf\u0db4 \u0d86\u0dc3\u0db1\u0dca\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dcf\u0dab\u0dba \u0db4\u0d9a\u0da7 \u0dba\u0dcf\u0dba \u0db4\u0d9a\u0dad\u0dca\u0dc0\u0dba \u0db4 \u0dd3\u0db6\u0dcf \u0dd4 \u0db1\u0dca\u0db4\u0db1\u0dca.\u0dbd\u0dda \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0db4\u0d9a\u0dca\u0dc0\u0dd2 \u0dc0\u0dc3\u0d82,\u0dad\u0dca\u200d\u0dba \u0db4, \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0dba\u0dba \u0db4 \u0d9a\u0dd2\u0dba \u0db4\u0db1 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0dad\u0d9a\u0dca\u0d9a \u0d92 industry \u0dad\u0d9a \u0d9a\u0dca\u0dcf \u0dc0\u0dc3\u0da7\u0dd2\u0dd3\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d87\u0dad\u0dca\u0dad\u0dca\u200d\u0dc0\u0dc1\u0dca\u0db4\u0dba \u0db4\u0db1\u0dca\u0db8\u0dc0 UDA \u0dad\u0d9a\u0da7 \u0dad\u0dca\u200d\u0db8\u0dc0\u0dd2 \u0dc0\u0dd2\u0dc1\u0dca\u0dcf\u0dd3 \u0d86\u0dba\u0dcf\u0dba \u0db4\u0db8\u0dc0\u0d9a\u0dca \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dca\u0db4\u0db1\u0dca.\u0dbd\u0dda \u0d87\u0dd2 , \u0d92? \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4 \u0dc4\u0dbb\u0dd2 \u0d86\u0db4\u0dba \u0db4\u0ddd\u0da2\u0d9a\u0db4\u0dba \u0db4\u0d9a\u0dca construction \u0dad\u0d9a\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d89\u0dca\u0db8\u0dc0\u0d9a\u0dca \u0db1\u0dca\u0dd3\u0daf\u0dd3 ,\u0db1\u0dca\u0db1\u0db4\u0d9a\u0dca\u0da7 \u0dc3\u0dd2\u0dba \u0db4\u0dba \u0db4\u0da7 4\u0d9a \u0db8\u0dd4\u0daf\u0dca\u0dba\u0dbb ,\u0dcf\u0dc3\u0db1\u0dad\u0dd4\u0dc0\u0d9a\u0dca \u0db4,\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1.\u0dbd\u0dda \u0d8a\u0dc5\u0d9f\u0da7, \u0dc3\u0dd2\u0db4\u0db8\u0dc0\u0db1\u0dca\u0dd2\u0db6, ,\u0dbd\u0dca \u0dc4\u0dcf \u0dc0\u0dc3\u0dbd\u0dd2 \u0dba \u0db4\u0db1\u0dcf\u0daf\u0dd3 \u0db4\u0daf\u0dca\u0dc0\u0dbd\u0dca ,\u0db1\u0dca\u0db1\u0db4\u0d9a\u0dca\u0da7 \u0d92\u0dc0\u0dcf\u0da7\u0dad\u0dca \u0db6\u0dd4 \u0dad\u0d9a\u0dad\u0dd4 \u0db4\u0dc0\u0dd3\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda \u0d92 construction \u0dad\u0d9a \u0dc4\u0dba\u0dd3\u0dcf \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0db1\u0dca\u0db1 \u0d9c\u0dd2\u0dba \u0db4\u0dcf\u0db8\u0dc0 \u0dc3\u0dd2\u0dba \u0db4\u0dba \u0db4\u0da7 18\u0d9a VAT \u0dad\u0d9a\u0d9a\u0dca \u0db4,\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1.\u0dbd\u0dda \u0d92\u0d9a \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0db1\u0db4\u0d9a\u0dca\u0da7 \u0d86\u0dca\u0dc3\u0dd4 \u0dc3\u0dd2\u0dba \u0db4\u0dba \u0db4\u0da7 4\u0d9a \u0db8\u0dd4\u0daf\u0dca\u0dba\u0dbb ,\u0dcf\u0dc3\u0db1\u0dad\u0dd4\u0dc0\u0d9a\u0dca \u0db4,\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1.\u0dbd\u0dda \u0d8a\u0da7 \u0dca\u0dc3\u0dd4\u0dc0 \u0dd3\u0dcf\u0db7\u0dba \u0db4\u0d9a\u0dca \u0dd3\u0dc3\u0db6\u0dd4\u0dc0\u0dcf\u0db8\u0dc0 \u0dc3\u0db8\u0dc0\u0dcf,\u0dda tax \u0dad\u0d9a \u0dc4\u0dc3\u0da7\u0dd2\u0dba \u0db4\u0da7 \u0dc3\u0dd2\u0dba \u0db4\u0dba \u0db4\u0da7 30\u0d9a\u0dca \u0db4,\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1.\u0dbd\u0dda \u0d92\u0db4\u0d9a\u0db1\u0dca dividends \u0dd3\u0dc3\u0db6\u0dd4\u0dc0\u0dcf\u0db8\u0dc0 \u0dad\u0dca\u200d\u0dc0 \u0dc3\u0dd2\u0dba \u0db4\u0dba \u0db4\u0da7 15\u0d9a\u0dca \u0db4,\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1.\u0dbd\u0dda \u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0db4\u0dbd\u0dca \u0dd3\u0d9a\u0dca\u0dc2 \u0dad\u0d9a\u0dc4\u0db8\u0dc0\u0dcf\u0dbb\u0d9a\u0da7 \u0dc0\u0dca\u0dcf \u0dca \u0d85 ,\u0db1\u0dca\u0db1 \u0d85\u0dba \u0db4 \u0dc3\u0dd2\u0dba \u0db4\u0dba \u0db4\u0da7 4 \u0dc3\u0dd2\u0da7 \u0dc3\u0dd2\u0dba \u0db4\u0dba \u0db4\u0da7 36 \u0dba\u0d9a\u0dca\u0dc0\u0dcf \u0d8b\u0dca\u0dba \u0db4\u0db1 \u0dc0\u0dd2\u0da7 \u0d86\u0dba\u0dcf\u0dba \u0db4\u0dda \u0db6\u0daf\u0dca\u0dba \u0db4,\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1.\u0dbd\u0dda \u0d87\u0dad\u0dca\u0dad\u0dca\u200d\u0dc0\u0dc1\u0dca\u0db4\u0dba \u0db4\u0db1\u0dca\u0db8\u0dc0 \u0d92 project \u0dad\u0d9a\u0da7 \u0dc0\u0dd2\u0dba \u0db4\u0dba\u0dda \u0dc0\u0db1 \u0db8\u0dd4\u0dba\u0dbd\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0dba \u0db4\u0dba \u0db4\u0da7 40\u0d9a \u0dc0\u0dd2\u0dad\u0dca\u200d\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dcf\u0dab\u0dba \u0db4\u0d9a\u0dca \u0db1\u0dc3\u0dc0\u0dad\u0dca\u200d \u0dbb\u0da2\u0dba \u0db4\u0da7 \u0dd3\u0dc3\u0db4\u0db6\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dba \u0db4\u0d9a\u0dca \u0db4\u0dda\u0d9a.\u0dbd\u0dda 2018 \u0db4\u0dc0\u0daf\u0dca\u0daf\u0dd2 \u0d85\u0db4\u0dda \u0dbb\u0db4\u0da8\u0dcf construction \u0d9a\u0dca\u0db4\u0dc2\u0dda\u200d\u0dbb\u0dba \u0db4 export level \u0dad\u0d9a\u0da7 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dd3\u0dcf \u0dd2\u0db6\u0db6\u0dd4\u0db4\u0da9\u0dd4.\u0dbd\u0dda \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0dad\u0db8\u0dc0 \u0d9a\u0dca\u0db4\u0dc2\u0dda\u200d\u0dbb\u0dba \u0db4 \u0d9a\u0dca\u0dcf\u0db4,\u0db1 \u0dc0\u0dc3\u0da7\u0dd4\u0dab\u0dcf.\u0dbd\u0dda \u0d92 \u0d9a\u0dca\u0dcf\u0db4,\u0db1 \u0dc0\u0dc3\u0da7\u0dd4\u0dab\u0dd4 \u0dc0\u0dc3\u0da7\u0dd2\u0dbd\u0dca\u0db4\u0dbd\u0dca \u0dc4\u0dc3\u0da7\u0dd2\u0dba \u0db4\u0da7 \u0dad\u0dca\u200d\u0dc0\u0db8\u0dc0 \u0d94\u0dc5\u0dd4\u0dc0 \u0d8b\u0dc3\u0db1\u0dc3\u0dcf ,\u0db1\u0dca\u0db1 \u0db6\u0dc3\u0dbb\u0dd2 \u0db4\u0dc0\u0dd3\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dc0\u0dcf.\u0dbd\u0dda"
  },
