0dad\u0dd4\u0db8\u0dba\" \u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba \u0dc0\u0dd2\u0db8\u0dc3\u0db1 \u0dbd\u0daf\u0dd2\u0db1\u0dca \u0dc3 \u0ddc \u0dc3\u0db8\u0dca\u0db8 \u0dc0\u0dd2\u0dba.\n\n281 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dc2\u0d9a\u0dba\u0dc4\u0dd2 02 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0db4\u0dd4\u0db1\u0dbb\u0ddc\u0dc0\u0dbb \u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0db8 \u0dc3\u0db4\u0d9a\u0dbd\u0dca\u0dca\u200d\u0db1\u0d9a\u0dba\u0dc4\u0dd2 \u0d9a \u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dba\u0dd2 \u0db1\u0dd2\u0d9a\u0dba\u0ddd\u0d9c \u0dbb\u0db1 \u0dbd\u0daf\u0dd3.\n\n02 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1.- \u0dc3\u0dc0\u0dc0\u0dbb\u0db0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 - \u0db8\u0dd6\u0dbd\u0db0\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0db8\n\n\u0dbb\u0dd4. 4 270 000,000\n\n\"281 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dc2\u0d9a\u0dba\u0dc4\u0dd2 02 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0db8\u0dd6\u0dbd\u0db0\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0db8 \u0dc3\u0db3\u0dc4\u0ddc \u0dbb\u0dd4. 4 270 000 000 \u0db8\u0dd4\u0daf\u0dbd \u0dc3\u0db4\u0d9a\u0dbd\u0dca\u0dca\u200d\u0db1\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dad\u0dca \u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\" \u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba \u0dc0\u0dd2\u0db8\u0dc3\u0db1 \u0dbd\u0daf\u0dd2\u0db1\u0dca \u0dc3 \u0ddc \u0dc3\u0db8\u0dca\u0db8 \u0dc0\u0dd2\u0dba.\n\n281 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dc2\u0d9a\u0dba\u0dc4\u0dd2 02 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0db8\u0dd6\u0dbd\u0db0\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0db8 \u0dc3\u0db4\u0d9a\u0dbd\u0dca\u0dca\u200d\u0db1\u0d9a\u0dba\u0dc4\u0dd2 \u0d9a \u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dba\u0dd2 \u0db1\u0dd2\u0d9a\u0dba\u0ddd\u0d9c \u0dbb\u0db1 \u0dbd\u0daf\u0dd3.\n\n282 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dba.- \u0dc0\u0dcf\u0dbb\u0dd2\u0dd9\u0dcf\u0dbb\u0dca\u0d9c \u0db1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0db1\u0db8\u0dca\u0dca\u0dd4\u0dbb\u0dc0\n\n01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1.- \u0d9a\u0db8\u0d9a\u0dc4\u0dba\u0dd4\u0db8\u0dca \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 - \u0db4\u0dd4\u0db1\u0dbb\u0ddc\u0dc0\u0dbb \u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0db8\n\n\u0dbb\u0dd4. 1 066 000 000\n\n\"282 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dc2\u0d9a\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0db4\u0dd4\u0db1\u0dbb\u0ddc\u0dc0\u0dbb \u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0db8 \u0dc3\u0db3\u0dc4\u0ddc \u0dbb\u0dd4. 1 066 000 000 \u0db8\u0dd4\u0daf\u0dbd \u0dc3\u0db4\u0d9a\u0dbd\u0dca\u0dca\u200d\u0db1\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dad\u0dca \u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\" \u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba \u0dc0\u0dd2\u0db8\u0dc3\u0db1 \u0dbd\u0daf\u0dd2\u0db1\u0dca \u0dc3 \u0ddc \u0dc3\u0db8\u0dca\u0db8 \u0dc0\u0dd2\u0dba.\n\n282 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dc2\u0d9a\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0db4\u0dd4\u0db1\u0dbb\u0ddc\u0dc0\u0dbb \u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0db8 \u0dc3\u0db4\u0d9a\u0dbd\u0dca\u0dca\u200d\u0db1\u0d9a\u0dba\u0dc4\u0dd2 \u0d9a \u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dba\u0dd2 \u0db1\u0dd2\u0d9a\u0dba\u0ddd\u0d9c \u0dbb\u0db1 \u0dbd\u0daf\u0dd3."
