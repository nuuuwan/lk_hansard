    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7 \u0d91\u0dda\u0db8\u0dc0 \u200d\u0daf \u0d9a\u0dc0\u0dba \u0dc2\u0dab \u0db8\u0dda \u0d9a\u0dc5\u0dc01 \u0d92 \u200d\u0db8\u0dd2\u0d8b the case study on Hans. \u0d92\u0d9a interesting topic \u0d91\u0d9a\u0dc2\u0dab1 \u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc4\u0dda \u0dc0\u0dcf\u0db4\u0dda\u0dd6 \u0db4\u0dad \u0db8 \u0d9a\u0db8 \u0dc0\u0db4 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc0\u0daf\u0dbd\u0dd2 \u0d8b \u0dd0\u0dc3\u0dd2 \u0db8 \u0db4\u0d9a\u0dc0\u0db4 \u0dc0\u0db8\u0dc3 \u0dd3\u0dbb\u0dba \u0db4\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbb\u0dd3 \u0d9a\u0dc0\u0dba \u0d9c\u0dd0 \u0d9a\u0dae\u0dc0 \u0d9a\u0dc5\u0dc01 \u0d87 \u0d9a\u200d\u0d8b \u0d91\u0db4 \u0db8 \u0d91\u0d9a \u0d91\u0dc2\u0dab\u0db4\u0d9a \u0dc0\u0db4 \u0dd0\u0dc3\u0dd2 \u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dcf\u0daf \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0daf\u0dc2\u0dab \u0db8\u0dda \u0db4\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd0 \u0dd01 \u0d87\u0dd2? \u0dc0\u0db4\u0dd2 \u0dca\u0dab\u0dca\u0da9\u0dd4\u0daf\u0dc2\u0dab1 \u0dc0\u0db4\u0dd2 \u0dd3\u0dbb\u0dba \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dca\u0dab\u0dca\u0da9\u0dd4\u0daf\u0dc2\u0dab \u0dc0\u0dcf\u0db0\u0dd2 \u0da71 \u0dc0 \u0da7 \u0dd2\u0db4\u0db6 \u0daf\u0dc0\u0d8b collective consciousness \u0d91\u0d9a\u0dc2\u0dab1 \u0dc0 \u0da7 \u0dc4\u0dc0\u0db8\u0dd6\u0dc4\u0dd2\u0d9a \u0dca\u0dc3 \u0dc4\u0dc0\u0dc2\u0dab\u0dc2\u0dd2 \u0dc2\u0dab \u0dd2\u0db4\u0db6 \u0daf\u0dc0\u0d8b \u0dc0\u0daf\u0db4\u0db6\u0db1\u0dca\u200d \u0dc2\u0dab \u0dd2\u0db4\u0db6 \u0daf\u0dc01 \u0dc0 \u0da7 democratic values \u0db8\u200d \u0dc3 \u0dca \u0db4\u0daf\u0da0\u0dca\u0da0\u0da0 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc0\u0daf\u0dbd\u0dd2 \u0dc2\u0dab \u0dd2\u0db4\u0db6 \u0daf\u0dc0\u0d8b \u0dd3\u0dbb\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0daf\u0dd4 \u0dd3\u0dbb\u0dba \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb 1 \u0d91\u0dda \u0db1\u0dd2\u0dc4\u0dc0 \u200d\u0db1\u0dd2 \u200d\u0db1\u0dd2 \u0dd4\u0daf\u0dca\u0d9c\u0d9a \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4 \u0dd0\u0dc3\u0dd2 \u0db8 \u0db4\u0dca\u0d9a\u0da7 \u0dc0\u0dc3\u0dc0\u0dc5 \u0dd0 \u0dd01 \u0dc0\u0d9a\u0d9a \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d91\u0dc2\u0dab\u0d9a \u0dd2\u0dd2 \u0dc0\u0dc4\u0db4\u0dda \u0d91\u0d9a\u0da7 \u0daf\u0dd0\u0dd2 \u0d9a\u0dba\u0d9a\u0dc0 \u0daf\u0dd0\u0dbb\u0dd0\u0dbb\u0dd2 \u0d9a\u0dba\u0dd4 \u0dc0 \u0da7 \u0d9a \u0db1\u0dd2\u0daf\u0dd0\u0dba\u0dbb\u0dd2 \u0db4\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd1 \u200d\u0dba\u0dca \u0dc0\u0daf\u0dc4\u0dda\u0dae\u0dc0\u0daf \u0dc4\u0dc4\u0dd2\u200d\u0daf \u0d9a\u0dcf\u0d9a\u0dc0\u0db4\u0daf \u0db4\u0dca \u0daf\u0dd0\u0dd2 \u0d9a\u0dba \u0daf\u0dc01\n\n\u0d91\u0dda\u0db8\u0dc0 \u200d\u0daf \u0d9a \u0d9a\u0dc0\u0dba \u0dc2\u0dab \u0db8\u0dda \u0d9a\u0dc5\u0dc0\u0d8b citizenship \u0dc4\u0dca\u0db6\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dca\u200d\u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb1 \u0d91\u0dda\u0db8\u0dc0 \u0dd4\u0dba\u0daf\u0dd0\u0dc3\u0dd2\u0db7\u0dc0\u0daf \u0dc4\u0dca\u0db6\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dca\u200d concept \u0d91\u0d9a\u0dc2\u0dab \u0db8\u0dda \u0d9a\u0dc5\u0dc0\u0d8b \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0daf\u0dc2\u0dab \u0db8\u0dda \u0db4\u0daf \u0daf\u0dc0 \u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3 \u0dbb\u0dd3 \u0d9a\u0dc01 \u0dc4\u0dda\u0dc0\u0dcf\u0da7\u0dca\u0dc4\u0dbd\u0dd2\u0db8\u0d9a\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d \u0dca\u0dab\u0dca\u0da9\u0dd4\u0daf \u0dc3\u0dd4\u0d9c\u0dd2 \u0dc4\u0dd0\u0db4\u0dca\u0db4\u200d\u0dd0\u0dca\u0db6\u0dbd\u0dd2\u0db8 \u0db8\u0dc0\u0dc4\u0db4\u0dda 28\u0daf\u0dd0\u0db1\u0dd2 \u0dc3\u0dc0 digital ID \u0d91\u0d9a\u0dc2\u0dab \u0db4 \u0daf\u0dc0\u0dc3 \u0dbb\u0dd3 \u0d9a\u0dc0\u0dba \u0dc4\u0dca\u0db6\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dca\u200d\u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d92 \u0dba\u0db4\u0da7\u0dca \u0d9a