    "chunk_text": "\u0d92 \u0db8\u0dc0\u0dca \u0dca\u0dcf\u0dbb\u0dca\u0d9a\u0dca \u0dad\u0d9a\u0da7 \u0dad\u0dca\u200d\u0db8\u0dc0\u0dd2 \u0db4\u0d9a\u0dc5\u0dd2\u0db1\u0dca\u0db8\u0dc0 brand new \u0dc0\u0dcf\u0dc4\u0db1 \u0db4,\u0dca\u0dca\u0db6\u0dcf\u0db1\u0dca\u0db4\u0db1\u0dca; \u0db8\u0dc0\u0dca \u0da7 \u0db6\u0dcf\u0db1\u0dca\u0db4\u0db1\u0dca.\u0dbd\u0dda \u0d92 \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0dc0\u0dcf\u0dc4\u0db1 \u0db8\u0dc0\u0db4 \u0dad\u0dbb\u0dd2\u0dd3\u0dcf \u0dd2\u0db6\u0db4\u0db6\u0db1\u0dca\u0db4\u0db1\u0dca.\u0dbd\u0dda \u0d92 \u0dc0\u0dcf\u0dc4\u0db1 \u0dad\u0dc5\u0dd2\u0dba \u0db4\u0da7 ,\u0db1\u0dca\u0db4\u0db1\u0dca \u0db6\u0dc3\u0db4\u0d9a\u0ddd \u0dad\u0d9a\u0d9a\u0dd2\u0db1\u0dca \u0d87\u0dba\u0dd3\u0dcf\u0dd2 , \u0d87\u0db8\u0dc0\u0dd2\u0db6\u0dad\u0dd4\u0db8\u0dc0\u0db1\u0dd2.\u0dbd\u0dda \u0db8\u0dc0\u0db8\u0dc0 \u0db4\u0dda \u0d9a\u0dd2\u0dba \u0db4\u0db1\u0dca\u0db4\u0db1\u0dca \u0dc3\u0dc4\u0dd2\u0db6\u0d9a \u0d87\u0dad\u0dca\u0dad\u0dca\u200d.\u0dbd\u0dda \u0dad\u0db4\u0dc4\u0db8\u0dc0\n\n\u0d85\u0db4\u0db1\u0d9a\u0dca \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0db4 \u0db4\u0db8\u0dc0\u0dba \u0db4\u0dd2 .\u0dbd\u0dda \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0db6\u0dc3\u0db1 300\u0d9a\u0dca\u0dba \u0db4\u0d9a\u0dca\u0db4\u0dc4\u0db4\u0dba\u0ddd \u0dca\u0dcf\u0dbb\u0da7 \u0dba\u0db8\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0daf\u0dc0\u0dcf; 300\u0d9a\u0dca\u0dba, 100\u0d9a\u0dca\u0dba \u0db8\u0dc0\u0db8\u0dc0 \u0dba\u0db1\u0dca\u0db4\u0db1\u0dca \u0db1\u0dc3\u0dc4\u0dc3.\u0dbd\u0dda \u0d92 \u0dc3\u0db3\u0dc4\u0dcf Budget \u0dad\u0db4\u0d9a\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba \u0db4\u0dbd\u0dca \u0db1\u0dca\u0dbd\u0dd2\u0dba \u0db4\u0db1 300\u0d9a\u0dca\u0dba \u0db4\u0d9a\u0dca\u0db4\u0dc4\u0db4\u0dba\u0ddd \u0db4\u0dc0\u0db1\u0dca \u0d9a\u0dbb\u0dd3\u0dcf\u0dad\u0dca \u0dd2\u0db6\u0db6\u0dd4\u0dab\u0dcf.\u0dbd\u0dda ,\u0dbb\u0dd4 \u0d87\u0db8\u0dc0\u0dd2\u0db6\u0dad\u0dd4\u0db8\u0dc0\u0db1\u0dd2, \u0db8\u0dd3\u0da7 \u0d89\u0dc3\u0db1\u0db4\u0dc3\u0dbd\u0dca\u0dd3\u0dcf\u0dad\u0dca \u0d85\u0db4\u0dd2 park-and-drive system \u0dad\u0d9a\u0d9a\u0dca \u0d87\u0dd2\u0db6 \u0d9a\u0dc5\u0dcf, \u0db8\u0dc0\u0dcf\u0d9a\u0dd4\u0db9\u0dd4\u0db4\u0dbb\u0dca.\u0dbd\u0dda \u0d9a\u0dcf\u0dbb\u0dca \u0dad\u0db4\u0d9a\u0db1\u0dca \u0dad\u0dad\u0dca\u200d\u0dc3\u0db1\u0da7 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dd3\u0dcf \u0dad\u0dad\u0dca\u200d\u0dc3\u0db1 \u0d9a\u0dcf\u0dbb\u0dca \u0dad\u0d9a park \u0d9a\u0dbb\u0dd3\u0dcf \u0db6\u0dc3\u0db1 \u0dad\u0db4\u0d9a\u0dca \u0db1\u0dc3\u0d9f\u0dd3\u0dcf \u0db4\u0d9a\u0dca\u0dc5\u0db9\u0da7 \u0dba \u0db4\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dba \u0db4\u0d9a\u0dca \u0dc4\u0dc3\u0daf\u0dd3\u0db8\u0dc0 \u0dad\u0dca\u200d\u0db8\u0dc0\u0dd2 \u0d92\u0db4\u0d9a\u0db1\u0dca \u0db6\u0dd3\u0dcf\u0db4\u0dca\u0dca\u0db4\u0dbb\u0dca\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0dd4\u0db4\u0da9\u0dd4.\u0dbd\u0dda \u0db8\u0dc0\u0db8\u0dc0 \u0dc4\u0dd2\u0dad\u0dca\u200d\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0db4\u0da7 \u0d92 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dba \u0db4 \u0dc4\u0dc3\u0dd4 \u0db4\u0daf \u0dca\u0dcf\u0dc3\u0db8 \u0dd2\u0dda\u0db4\u0dd2\u0d9a \u0dbb\u0dab\u0dc0\u0d9a \u0db8\u0dc0\u0dc3\u0dd2\u0db6\u0dad\u0dd4\u0db8\u0dc0\u0dcf\u0db4 \u0d9a\u0dcf\u0dd3\u0db4\u0d89.\u0dbd\u0dda \u0db4\u0d9a\u0dca\u0db4\u0dc4\u0dca\u0db8\u0dc0 \u0dc0\u0dd4\u0dab\u0dad\u0dca, \u0d92 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dba \u0db4 \u0d85\u0dc3\u0dcf\u0dbb\u0dca \u0d9a \u0dc0\u0dd4\u0dab\u0dcf.\u0dbd\u0dda \u0d92\u0d9a\u0da7 \u0db4\u0dc4\u0dda\u0dad\u0dd4\u0dc0 \u0dad\u0dca\u200d\u0db8\u0dc0\u0dd2 , \u0dca\u0dcf\u0dbb\u0dc0\u0dbd\u0dca \u0db1\u0dc0\u0dd3\u0d9a\u0dbb\u0dab\u0dba \u0db4 \u0db4\u0db1\u0dca\u0dc0\u0dd3\u0db8\u0dc0.\u0dbd\u0dda \u0dca\u0dcf\u0dbb\u0dc0\u0dbd\u0dca \u0dc4\u0dba\u0db1\u0dca\u0db4\u0db1\u0dca \u0db1\u0dc3\u0dad\u0dca\u0db1\u0dda, \u0dca\u0dcf\u0dbb\u0dc0\u0dbd\u0dca\u0dc0\u0dd3\u0da7 \u0d92 \u0d85\u0dc0\u0dc1\u0dca\u0dba \u0db4\u0dca\u200d\u0dbb\u0db4\u0daf\u0dc1\u0dca\u0dba \u0db4 \u0db1\u0dc3\u0dad\u0dca\u0db1\u0dda, \u0d89\u0d9a\u0dca\u0db8\u0dc0\u0db1\u0dd2\u0db1\u0dca \u0dba \u0db4\u0db1\u0dca\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dba \u0db4\u0d9a\u0dca \u0db1\u0dc3\u0dad\u0dca\u0db1\u0dda \u0db4\u0db8\u0dc0\u0dca\u0d9a\u0dba \u0db4\u0dc0\u0db1\u0dca\u0db4\u0db1\u0dca? \u0d92\u0db4\u0d9a\u0db1\u0dca \u0dc0\u0dd4\u0db4\u0da9\u0dd4 \u0d86\u0dca\u0dc3\u0dd4 \u0dc0\u0dad\u0dca\u200d\u0dcf\u0dc0\u0d9a\u0dca \u0dca\u0dbb\u0dab \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dba \u0db4\u0da7\u0db8\u0dc0 \u0dad\u0dca\u200d\u0db8\u0dc0\u0db1\u0dca\u0db4 \u0dc0\u0dcf\u0dc4\u0db1\u0db4\u0dba \u0db4\u0db1\u0dca\u0db8\u0dc0 \u0dad\u0db1 \u0dad\u0d9a\u0dd2 .\u0dbd\u0dda \u0dba\u0dc3\u0db1\u0dca \u0dca\u0dc0\u0dd2\u0db6\u0db1 \u0dad\u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0db4 \u0dad\u0dd4\u0dc5 \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dd3\u0dd3\u0dbb\u0dca \u0dad\u0d9a\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0dc4\u0ddd \u0db4\u0db8\u0dc0\u0ddd\u0da7\u0dbb\u0dca \u0dc3\u0dd2 \u0d9a\u0dd3\u0dba \u0db4\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0dc4\u0ddd \u0dba \u0db4\u0db1 \u0dad\u0d9a \u0db4\u0daf,\u0dc0\u0dad\u0dca, \u0d85\u0db4\u0dd2 \u0dba \u0db4\u0db1 \u0dc0\u0dcf\u0dc4\u0db1\u0dba \u0db4\u0d9a \u0dba \u0db4\u0db1\u0dc0\u0dcf\u0da7 \u0dc0\u0dca\u0dcf.\u0dbd\u0dda \u0d92\u0d9a compulsory \u0d9a\u0dd2\u0dba \u0db4\u0dd3\u0dcf \u0d85\u0dca\u0da7 \u0db1\u0dd3\u0dd2\u0db6\u0dba \u0db4\u0d9a\u0dca \u0dba\u0db8\u0dc0\u0db1\u0dca\u0db1 \u0db6\u0dc3\u0dc4\u0dc3.\u0dbd\u0dda \u0dc0\u0dcf\u0dc4\u0db1\u0dba \u0db4 \u0dad\u0dad\u0dca\u200d\u0dc3\u0db1 \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0dcf \u0db6\u0dc3\u0db1 \u0dad\u0db4\u0d9a\u0dca \u0dba \u0db4\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba \u0db4\u0dd3\u0dcf \u0d9a\u0dcf\u0da7\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dba \u0db4\u0db1\u0dca\u0db1 \u0db6\u0dc3\u0dc4\u0dc3 \u0db4\u0db1\u0dca.\u0dbd\u0dda \u0d92\u0d9a \u0dad\u0dca\u200d\u0db8\u0dc0\u0db1\u0dca\u0db4 \u0d85\u0db7\u0dd2\u0db8\u0dc0\u0dad\u0dca\u200d\u0dba \u0db4.\u0dbd\u0dda \u0db8\u0dc0\u0db8\u0dc0 \u0d9a\u0dd2\u0dba \u0db4\u0db1\u0dca\u0db4\u0db1\u0dca \u0db1\u0dca\u0db1\u0dd2\u0dc3\u0db1\u0dc3\u0dd4 \u0db4\u0dda\u0dc0\u0dcf\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0db4\u0dba \u0db4\u0ddd\u0d9c\u0dd2\u0d9a\u0dc0 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0\u0dca\u200d \u0d9a\u0dbb,\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba \u0db4\u0dd3\u0dcf\u0dd2 .\u0dbd\u0dda\n\n\u0d87\u0db8\u0dc0\u0dd2\u0db6\u0dad\u0dd4\u0db8\u0dc0\u0dcf \u0db8\u0dc0\u0da7 \u0dc0\u0dd2\u0dc0\u0dd8\u0dad\u0dca\u200d \u0d86\u0dbb\u0dcf\u0db0\u0dca\u200d\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0d9a\u0dc5\u0dcf, \u0db4\u0dda \u0dca\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db4\u0dda\u0db1\u0dca\u0dad\u0dd4\u0db4\u0daf\u0daf\u0dd3.\u0dbd\u0dda \u0db8\u0dc0\u0db8\u0dc0 \u0d92\u0d9a\u0da7 \u0dc3\u0db1\u0dad\u0dd4\u0dd2\u0db6\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d \u0dc0\u0dd4\u0dab\u0dcf.\u0dbd\u0dda \u0dc4\u0dc3\u0db6\u0dc3\u0dd2 , \u0db8\u0dc0\u0db8\u0dc0 \u0dc0\u0dbb\u0dba\u0d9a\u0dca \u0d9a\u0dc5\u0dcf.\u0dbd\u0dda \u0db4\u0db8\u0dc0\u0dca\u0d9a\u0d9a\u0dca\u0dba, \u0db8\u0dc0\u0db8\u0dc0 \u0d9a\u0dc5 \u0dc0\u0dbb\u0dba? \u0db8\u0dc0\u0db8\u0dc0 \u0d9a\u0dd2\u0daf\u0dc0\u0dcf, \u0db8\u0dc0\u0da7 \u0dc0\u0dc3\u0da7\u0dd4\u0dda \u0dad\u0dca\u0dcf, \u0db8\u0dc0\u0da7 \u0db1\u0dd2\u0dd3 \u0dc0\u0dcf\u0dc4\u0db1 \u0dad\u0dca\u0dcf, \u0db8\u0dc0\u0db8\u0dc0 \u0db8\u0dc0\u0db4 \u0db4\u0dc3\u0dda\u0dc0\u0dba \u0db4 \u0db4\u0dba\u0db1\u0dca\u0db1\u0dda \u0d9a\u0dd2\u0dba \u0db4\u0dd3\u0dcf.\u0dbd\u0dda \u0d87\u0db8\u0dc0\u0dd2\u0db6\u0dad\u0dd4\u0db8\u0dc0\u0dcf\u0da7 \u0db8\u0dc0\u0dad\u0dca\u200d\u0d9a \u0d87\u0dd2\u0db6, \u0db8\u0dc0\u0db8\u0dc0 \u0db4\u0dda \u0dc3\u0db1 \u0dcf\u0db1\u0db4\u0d89 \u0d89\u0db3\u0db4,\u0db1\u0db8\u0dc0 \u0d92\u0d9a \u0d9a\u0dd2\u0daf\u0dc0\u0dcf.\u0dbd\u0dda \u0db4\u0d9a\u0dca\u0db4\u0dc4\u0dca\u0db8\u0dc0 \u0dc4\u0dbb\u0dd2 \u0d85\u0dba \u0db4\u0dc0\u0db1\u0d9a\u0dbd\u0dca \u0db8\u0dc0\u0da7 \u0d92 \u0d89\u0dbd\u0dca\u0db8 \u0db8\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dca\u0dad\u0dca \u0d9a\u0db4\u0dc5\u0dda \u0db1\u0dc3\u0dc4\u0dc3.\u0dbd\u0dda \u0db8\u0dc0\u0db8\u0dc0 \u0db4\u0dda \u0d9a \u0dcf \u0d9a \u0dbb\u0db1\u0dca\u0db4\u0db1\u0dca \u0db8\u0dc0\u0dcf\u0dbd\u0dd2\u0db8\u0dc0\u0dcf\u0dc0 ,\u0dc3\u0db1\u0dc0\u0dad\u0dca, \u0dc3\u0db8\u0dc0\u0d9c\u0dd2 \u0da2\u0db1 \u0db6\u0dd3\u0db4\u0daf,\u0dba \u0db4 ,\u0dc3\u0db1\u0dc0\u0dad\u0dca, \u0dba\u0dd6\u0dad\u0db1\u0dca\u0db4\u0dd3 \u0dad\u0d9a ,\u0dc3\u0db1\u0dc0\u0dad\u0dca \u0db4\u0db1\u0dca\u0db4\u0dc0\u0dd2 .\u0dbd\u0dda \u0db8\u0dc0\u0dcf \u0dc5\u0d9f \u0dd2\u0db6\u0db4\u0db6\u0db1 \u0dba\u0d9a\u0dca\u0dc2\u0d9a\u0db8\u0dc0 \u0db4\u0dba\u0db1\u0dca\u0db1 \u0db8\u0dc0\u0db8\u0dc0 \u0dbb\u0dd2\u0dba\u0dcf\u0db1\u0dda.\u0dbd\u0dda"
  },
