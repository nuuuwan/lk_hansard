    "chunk_text": "\u0db8\u0dd6\u0d9a\u0dc0\u0dc4 \u0dc0\u0dbb\u0dd6\u0daa \u0d9c\u0dd4\u0dc0 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dda\u0dd2\u0dba \u0db1\u0dd2\u0d8b \u0db8\u0da7 \u0db4\u0daf\u0d9a\u0dc0\u0daf \u0dd0\u0dd2 \u0db1\u0dd2\u0dc4\u0dc0 \u0dd2\u0dc2\u0dab\u0db8\u0db1\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db8 \u0db4\u0dca \u0d9a\u0dc0\u0dba \u0d9a \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d95 \u0dd11 2025 \u0db4 \u0dc0\u0daf\u0dd0\u0dca\u0db6\u0dbd\u0dd2\u0db8 03\u0daf\u0dd0\u0db1\u0dd2 \u0dc3\u0dc0 \u0dcf \u0dc0\u0db0\u0dd2 \u0dd2 \u0db4 \u0d86\u0d9a\u0dca \u0d9a\u0dc0\u0dbd\u0dd2\u0db8 \u0dc0\u0d9a\u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbd\u0dd2\u0db4\u0dd2 \u0dc2\u0dab \u0daf\u0d9a\u0dc0 \u0dd0 \u0dd0\u0dbb\u0dd2\u0dbd\u0dd2 \u0d9a\u0dba \u0daf\u0dc0\u0d8b \u0dc0\u0db8\u0dc0\u0dc3\u0dd0 \u0d86 \u0daf\u0da7 \u0dbb\u0dd3 \u0db8 \u0dc4\u0dcf \u0dc0 \u0dc0\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da0\u0dca\u0da0 \u0dc3 \u0d9a\u0dba \u0dc4\u0dc0\u0dcf \u0d9a\u0dc5 \u0dd9\u0dd0\u0dc2\u0dab\u0da7\u0dbd\u0dd2\u0db8 \u0db4 \u0dc0\u0dc3\u0dc0 \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u200d \u0dca \u0dbb\u0dd3 \u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dcf\u0daf \u0dc4 \u0db4\u0db8\u0db8 \u0dc3 \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0db4\u0daf\u0db1\u0dd4\u0daf\u0da7 \u0db3\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0daf\u0dc0 \u0db4\u0dc3 \u0d9a\u0dbb \u200d\u0dc0\u0dc2\u0dab\u0dc2\u0dab\u0dd2\u0d9a \u0dc0\u0dcf\u0d9a \u0d86 \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc4\u0dca\u0db6\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dca\u200d\u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d94\u0db6\u0db4 \u0db1\u0dd2 \u0dc2\u0dab\u0dc2 \u0d87\u0dda\u0dc5 \u0d9a \u0daf\u0dc0\u0dbd\u0dd2\u0db8\u200d\u0dc0\u0daf\u0dc2\u0dab 2025199123 \u0dbb\u0dd2 \u0db4 \u0db1 \u0d8a\u0da7 \u0dca\u200d\u0dbb\u0dae\u0db8 \u0db8\u0dc0 \u0db4\u0daf\u200d \u0db4 \u0dc0\u0db8\u0dd4 \u0d9a\u0dba \u0db4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dc0\u0dd4\u0dc0\u0dab\u0dd2\u0d9a\u0daf \u0dc3\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0daf\u0dd2\u0dba\u0dc0 \u0dbb\u0dd3 \u0d9a\u0dc01 \u0d9c\u0dd4\u0dc0 \u0db0\u0dd3\u0daf\u0dba \u0d87\u0db8\u0dd2\u0dda\u0db8\u0db1\u0dd2\u0d8b \u0db1\u0dd2 \u0dc2\u0dab\u0dc2 \u0d87\u0dda\u0dc5 \u0d9a \u0daf\u0dc0\u0dbd\u0dd2\u0db8\u200d\u0dc0\u0daf\u0dc2\u0dab \u0daf\u0d9a\u0dc0 \u0dd2\u0db4\u0db6 \u0daf\u0dc0\u0dc3? \u0dc0\u0dc3 \u0daf \u0db4\u0d9a\u0dc0\u0da7 2025199123 \u0dbb\u0dd2 \u0dc4\u0dd4 \u0db4\u0daf\u0d9a\u0dc0 \u0dd2\u0db4\u0db6 \u0daf\u0dc01 \u0db4\u0dca\u0d9a \u0daf\u0d9a\u0dc0 \u0dd2\u0db4\u0db6 \u0daf\u0dc0\u0dc3? \u0db4\u0dca \u0daf\u0dc0\u0dbd\u0dd2\u0db8\u200d\u0dc0\u0daf \u0daf\u0d9a\u0dc0\u0dc3\u0d8b \u200d \u0dca \u0dbb\u0dd3 \u0db8\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dda \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbb\u0dd3 \u0d91\u0d9a \u0d9a \u0db8\u0db8 \u0dc0 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dd0\u0db8\u0dd0\u0dd2\u0dd21 \u0d91\u0db4 \u0db8 \u0dd0 \u0d9a \u0dca\u0d8b \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc0\u0db8\u0dc0\u0dbd\u0dd2\u0db8\u0d9c \u0dc0 \u0da7 \u0dd0 \u0dd0\u0dbb\u0dd2\u0dbd\u0dd2 \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb 1 \u0db8\u0dc0\u0dc3\u0dd0 \u0d86 \u0db0\u0dd3\u0daf\u0dba \u0dca\u200d\u0dbb\u0dcf\u0dc0\u0daf \u0dc0\u0dcf\u0db4\u0dc1\u0dda\u0dc2\u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db8 \u0dd2 \u0d86\u0d9a\u0dc0 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d8b \u200d\u0dc0\u0daf\u0d9a\u0dc0\u0dbd\u0dd2\u0d9a\u0daf \u0dc0\u0daf\u0dc4\u0dda\u0dae\u0dc0\u0daf \u0d9a\u0db6\u0dc0 \u0db4\u0dc3\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d8b \u0db4\u0dca \u0dc4\u0dca\u0db6\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dca\u200d\u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0dcf\u0d9a \u0d86 \u0db4\u0d9c\u0db4 \u0daf\u0dc0 \u0dca \u0d92 \u0dc4\u0dca\u0db6\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dca\u200d\u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dc0\u0d9a \u0dc2\u0dab \u0d9a\u0db6\u0dc0 \u0daf\u0dd3\u0d9a\u0dc0 \u0d9a\u0da7\u0dba\u0dd4\u0dda \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbb\u0dd3 \u0d91\u0d9a\u0dd21 \u0d92\u0d9a \u0db1\u0dd2\u0dc4\u0dc0 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0daf\u0db1\u0dd4\u0db4\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db8\u0db8 \u0dcf \u0dc0\u0db0\u0dd2 \u0dd2 \u0db4 \u0d86\u0d9a\u0dca \u0d9a\u0dc0\u0dbd\u0dd2\u0db8 \u0dc0\u0d9a\u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0db6\u0dc0 \u0daf\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbd\u0dd2\u0db4\u0dd2 \u0dc2\u0dab - \u0d9c\u0dd4\u0dc0 \u0d87\u0db8\u0dd2\u0daf\u0dba \u0dc0 \u0dc3\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd0 \u0d9a \u0dca \u0d91\u0dda\u0db8\u0dc0\u0da7 \u0dc3\u0dd0 \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a - \u0db8\u0db8 \u0dc4\u0db7\u0dcf\u0d9c\u0dad* \u0d9a\u0dba \u0daf\u0dc01\n\n\u0d9a\u0dae\u0dc0 \u0d9a\u0dba\u0d9a\u0dc0 \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0d9a\u0dd2\u0dc4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d91\u0d9a \u0dd0 \u0dd0\u0d8b \u0d92\u0d9a \u0dca \u0db8\u0da7 \u0db4 \u0d85\u0dba \u0d9c\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd4\u0dc5\u0dd4\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0dbb\u0dd3 \u0d9a\u0dc0? \u0dc0\u0db8\u0dc0\u200d\u0dba\u0daf\u0dba\u0db4 \u0dc2\u0dab \u0d91\u0db4 \u0db8 \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0db8\u0dc0\u0d9a\u0da7\u0dc3? \u200d\u0daf \u0dc0 \u0daf\u0dc0\u0d8b \u0dc0\u0d9a\u0dc2\u0dab\u0dc2 83\u0d9a \u0dc3\u0dd2 \u0dc2\u0dab \u0dd2\u0db4\u0db6 \u0daf\u0dc0\u0d8b \u0d92\u0d9a\u0da7 \u0db4\u0db8\u0dc0\u0d9a\u0dc3 \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb?\u0dc0 \u0dbb\u0dd3 \u0d9a\u0dc0 \u0db4\u0db8\u0dc0\u0d9a\u0dc3 \u0d9a\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbb\u0dd3 \u0d9a\u0dc0 \u0d87\u0dc4\u0dd4\u0daf\u0dc0\u0db8 \u0dc0\u0db4\u0dd2 \u0db4\u0db8\u0dc0\u0d9a\u0dc2\u0dab \u0dbb\u0dd3 \u0d9a\u0dc0\u0dc3 \u0dc4\u0dd2\u200d\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb? \u0d9a\u0dc2\u0dab\u0dc2 50\u0dc2\u0dab \u0dc0\u0dcf\u200d\u0dba \u0db8\u0da7 \u0db4\u0dc3\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbb\u0dd3 \u0daf\u0dc0\u0dc3 \u0dc3\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a \u0dd0 \u0dd0\u0d8b \u0d9a\u0dc2\u0dab\u0dc2 83 \u0d91 \u0dc0 \u0dbb\u0dd3 \u0d9a\u0dc01 \u0dc4\u0dca\u0db4\u0dd6\u0dbd\u0dd2\u0db8 \u0dac \u0da7 \u0dd2 \u0db4\u0db6 \u0daf\u0dc0 \u0dca \u0d9a\u0dd4\u0dc0 \u0dc0\u0d9a\u0dba\u0d9a\u0dc0 \u0d92\u0d9a \u0d91\u0dc5\u0dd2 \u0da7 \u0dc3\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dbb\u0dd3 \u0d9a\u0dc0 \u0db8\u0db8 \u0dc0\u0db7\u0dd2\u0db4 \u0db1\u0d9c \u0d9a\u0dba \u0daf\u0dc01 \u0d9a\u0dd1\u0dbd\u0dd2 \u0d9a\u0dd1\u0dbd\u0dd2 \u0dbb\u0dd3 \u0d9a\u0dc0 \u0db4\u0dca\u0d9a \u0db8\u0d9f \u0db4\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d91 \u0dc01 \u0db4\u0dca\u0d9a\u0db8 \u200d\u0db8\u0dd2 \u0dc0\u0dd4\u0db4\u0dab\u0dca \u0d9a\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0da7\u0dca \u0dbd\u0dd2\u0db8 ]2]\u0da7 \u0d9a1 \u0d92 \u0daf\u0dc0\u0dbd\u0dd2\u0db8\u200d\u0dc0\u0daf \u0dc0\u0db4\u0dd2 \u0db4\u0db6\u0dc0\u0db4 \u0dc0\u0db8 \u0dc0\u0db8\u0dc0\u0dd4\u0dc0\u0db4\u0daf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4 \u0dc0 \u0dc0 \u0db4\u0d9c \u0d87\u0dc0\u0dcf \u0d86\u0d9a\u0dc0 \u0db4\u0dca \u0d9c\u0dd4\u0dc0 \u0dc4\u0db7\u0dc0\u0daf\u0da7 \u0dd2\u0dbb\u0dd2\u0db4\u0dad \u0d9a \u0d9a\u0dc5\u0dc0\u0db8 \u0dbb\u0dd3\u0daf\u0daf\u0dc0\u0d8b \u0d95\u0d9a \u0db4 \u0dc0\u0db4\u0daf\u0dd2 \u0dc4\u0dca\u0db4\u0dd6\u0dbd\u0dd2\u0db8 \u0daf\u0dc0\u0dbd\u0dd2\u0db8\u200d\u0dc0\u0daf \u0dbb\u0dd3 \u0d9a\u0dc01 \u0d91\u0db4 \u0dca\u0d8b \u0db4\u0d9a\u0db1 \u0dc4\u0dca\u0db4\u0dd6\u0dbd\u0dd2\u0db8 \u0daf\u0dc0\u0dbd\u0dd2\u0db8\u200d\u0dc0\u0daf? \u0dc3\u0dd0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0dc3 \u0daf \u0d9a \u0d86 \u0d92\u0d9a \u0d9a \u0dd0 \u0dd01 \u0d92 \u0db1\u0dd2\u0dc4\u0dc0 \u0db4\u0dca \u0dc4\u0dca\u0db6\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dca\u200d\u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0 \u0da7 \u0dc3 \u0d9a\u200d\u0dba \u0dc2\u0dab \u0db4\u0dc3\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb 1 \u0db4\u0db8\u0dc0\u0d9a\u0dc3\u0d8b \u0db4\u0dca \u0dba\u0db4\u0da7\u0dca \u0dd2\u0dba\u0db1\u0dd2\u0dc4\u0dda\u0dc3\u0dd4 \u0db6\u0d9a\u0dc0\u0db4\u0d9c \u0dd2\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0daf\u0dc01 \u0d9a\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0da7\u0dca \u0dbd\u0dd2\u0db8 ]2] \u0dc4\u0dca\u0db6\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dca\u200d\u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd0 \u0dd0\u0d9f\u0dd4\u0dab\u0dd4 \u0dca\u200d\u0dbb\u0dc1\u0dda \u0db4\u0dca\u0db4\u0d9a\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u200d\u0daf \u0d9a \u0daf\u0dd0\u0da2\u0dd2 \u0db4\u0daf \u0daf\u0dc0 \u0dbb\u0dd3 \u0d91\u0d9a \u0d9a \u0db8\u0db8 \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0da7 \u0d9a\u0dd0\u0db8\u0dd0\u0dd2\u0dd21"
