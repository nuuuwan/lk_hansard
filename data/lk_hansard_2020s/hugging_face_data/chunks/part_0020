    "chunk_text": "\u0db8\u0dd6\u0d9a\u0dc0\u0dc4 \u0dc0\u0dbb\u0dd6\u0daa \u0d9c\u0dd4\u0dc0 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dda\u0db8\u0db1\u0dd2\u0d8b \u0dc0\u0dcf\u0dc3\u0dd2\u0dda\u0dd4\u0dc0 \u0db8 \u0d9a\u0dc4\u0dba \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d87 \u0d9a\u200d\u0da7\u0db8 \u0d9a\u0dcf\u0d9a\u0dc0\u0daf\u0da7 \u0dd2\u200d\u0dc0\u0db8 \u0db4 \u0dc0\u0dcf \u0dc0\u0dcf\u0db4\u0daf\u0dca\u0dc1 \u0dc0\u0dcf\u0db1\u0dd2\u0db8 \u0dc0\u0dba\u0db4\u0d9c \u0d91 \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d \u0dc2\u0dab1 \u0dd0\u0db6\u0dd0\u0dd2\u0d8b \u0dc0\u0db4\u0dd2 \u0d92 \u0d9c\u0dd0 \u0dba\u0dcf \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd0\u0da7\u0dd2 \u0da7 \u0dbb\u0dd3\u0dc3\u0dd2\u0db8 \u0db4\u0dc4\u0dc0 \u0dc0 \u0db6\u0dd0 \u0db8\u0dc2\u0dab \u0d9a\u0dba\u0d9a\u0dc0 \u0dd0 \u0dd01 \u0dc0\u0db4\u0dd2 \u0db4\u0dca \u0db8\u0dc0\u0dc4\u0db4\u0dda 29\u0d8b 22 \u0dc4 2] \u0dbb\u0dd3 \u0dbb\u0dd2 \u0daf\u0d9a \u0dca\u200d\u0dbb\u0dc3\u0dbd\u0dd2\u0db8\u0dc1 \u0dc2\u0dab \u0dd0\u0daf\u0dd0 \u0d9a\u0dc0\u0dd6\u0daf\u0dc01 \u0d91 \u0dc3\u0dd0\u0daf\u0dd0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d \u0dca\u200d\u0dbb\u0dc3\u0dbd\u0dd2\u0db8\u0dc1 \u0dc2\u0dab1 \u0d92 \u0dca\u200d\u0dbb\u0dc3\u0dbd\u0dd2\u0db8\u0dc1 \u0db4\u0dda\u0daf\u0dd3 \u0dc0 \u0da7 \u0db4 \u0d9a\u0dd4\u0dc0 \u0dc0\u0d8b \u0d92 \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d\u0db4\u0dda \u0dc0\u0da9\u0dd4 \u0dc0\u0da9\u0dd4 \u0db4\u0d9a\u0dc0\u0da0\u0dca\u0da0\u0da0\u0dba \u0dd2\u0db4\u0db6 \u0daf\u0dc0\u0dc3 \u0dbb\u0dd3 \u0d9a\u0dc01 \u0db4\u0db8\u0dc0\u0d9a\u0dc3\u0d8b \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d91\u0dc2\u0dab\u0d9a \u0daf\u0dd3\u0dbd\u0dd2\u0db8\u0d9d \u0dc4\u0dc0\u0d9a\u0da0\u0dca\u0da0\u0da1\u0dc0\u0daf\u0dc2\u0dab \u0daf \u0d9a\u0daf\u0dc0 \u0dc0\u0db4\u0db4\u0dca\u0db4 \u0d87\u0db8\u0dd2\u0dda\u0db8\u0dc0\u0d8b \u0db1\u0dd2\u0db4 \u0db1\u0dcf\u0dba \u0d87\u0db8\u0dd2\u0dda\u0db8\u0dc0 \u0daf\u0dc0\u0db4 \u0db8 \u0dc0\u0db8\u0dc0\u200d\u0dba\u0dc0\u0dcf\u0dc1 \u0db1\u0dd2\u0d9a\u0dca\u200d\u0dc0\u0db4\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0d9a\u0dc0\u0d9a\u0dd4 \u0d9a\u0dd0 \u0dbb\u0dd3 \u0db8\u0dc2\u0dab \u0d9a\u0dba\u0d9a\u0dc0 \u0db4\u0dca \u0dca\u200d\u0dbb\u0dc3\u0dbd\u0dd2\u0db8\u0dc1 \u0dd0\u0daf\u0dd0 \u0d9a\u0dc0\u0dd6\u0db4\u0dda \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7 \u0dd2\u0db4\u0db6 \u0d92 \u0dc0\u0da9\u0dd4 \u0dc0\u0da9\u0dd4\u0d9a\u0dca \u0db4 \u0dc0 \u0d9a\u0dc0 \u0d92 \u0dc0 \u0da7 \u0dc0\u0daf\u0dc1\u0dba \u0d9a\u0dba \u0d92 \u0dc3\u0dd4\u0d9a\u0dca \u0da7\u0dd2\u0d9a \u0dca\u0dab\u0dca\u0da9\u0dd4\u0daf\u0dc2\u0dab \u0daf\u0dc1\u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0d9a\u0db6\u0dc0\n\n\u0db8\u0dd6\u0d9a\u0dc0\u0dc4 \u0dc0\u0dbb\u0dd6\u0daa \u0d9c\u0dd4\u0dc0 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dda\u0db8\u0db1\u0dd2\u0d8b \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7 \u0db4\u0dca \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u200d \u0d9a\u0dba\u0db4\u0d9c \u0dd1\u0db8 \u0dc4\u0dcf \u0dc0 \u0dd2\u0dd2\u0dca \u0dc0\u0daf\u0dc1\u0dba \u0d9a\u0dba\u0d9a\u0dc0 \u0dd2\u0db6\u0dd4 \u0dc01 \u0d92 \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d8b \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7 \u0daf\u0d9c\u0dc0 \u0db4 \u0dc0\u0d9a\u0dba \u0d8b \u0dd4\u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0daf\u0da0\u0dca\u0da0\u0da0 \u0d9a\u0dd4\u0db9\u0dd4\u0dd4\u0dc0 \u0dc0\u0daf\u0dc1\u0dba\u0dd2 \u0dbb\u0dd3\u0daf\u0daf\u0dc0\u0d8b \u0d92 \u0db4 \u0dc0\u0d9a\u0dd4\u0dab\u0dd4 \u0dc3\u0dc0 \u0d92\u0daf\u0dc0\u0db4\u0dda \u0db8\u0dc3\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0db6\u0db1 \u0d9a\u0dba \u0dc0\u0dcf\u0db4\u0daf\u0dca\u0dc1 \u0dba\u0da7\u0daf\u0d9a\u0da7 \u0dd0\u0d9a\u0dbb\u0db8\u0da71 \u0dc0\u0db4\u0dd2 \u0d92 \u0dc4\u0dca\u0db6\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dca\u200d\u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0db4\u0dad\u0dc4\u0dba \u0dc0\u0db8\u0dc0\u200d\u0dba\u0dc0\u0dcf\u0dc1 \u0d91\u0dc2\u0dab\u0d9a \u0daf\u0dc0\u0db4 \u0db8 \u0db4\u0d9c\u0dc0\u0dc0\u0dcf\u0dcf \u0dc4\u0dcf\u0daf\u0dbd\u0dd2\u0db8\u0dca\u200d \u0db4\u0dc3 \u0dc0\u0dbd\u0dd2\u0db8\u200d\u0db4\u0dca\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dda\u0daf \u0daf\u0dd0\u0db1\u0dd2 \u0dc0\u0daf\u0dc1\u0dba \u0d9a\u0dba \u0db4\u0daf \u0d9a \u0dca \u200d \u0d91\u0dc2\u0dab\u0d9a \u0d9a\u0dae\u0dc0 \u0d9a\u0dba\u0d9a\u0dc0 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0da7 \u0d92 \u0dc3\u0dd4\u0d9a\u0dca \u0d9a\u0db6\u0dc0 \u0daf\u0dd3\u0db8 \u0dc4\u0dcf \u0dc0 \u0db4\u0dca \u0daf \u0dc0\u0dcf\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dda \u0d9a\u0dd0 \u0dd0\u0dc4\u0dda\u0dd2 \u0d9a\u0dba \u0dd2\u0db4\u0db6 \u0daf\u0dc01\n\n\u0db8\u0dd6\u0d9a\u0dc0\u0dc4 \u0dc0\u0dbb\u0dd6\u0daa \u0d9c\u0dd4\u0dc0 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dda\u0db8\u0db1\u0dd2\u0d8b \u0dc3\u0dd0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0dcf\u0db4\u0daf\u0dca\u0dc1 \u0db4\u0daf\u0db4\u0dc5\u0dcf \u0db4 \u0dc0\u0dc5\u0da7 \u0dc0\u0daf\u0dc1\u0dba \u0d9a\u0dba \u0dd2\u0db4\u0db6\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dd3\u200d\u0d9a \u0dcf\u0d9a \u0dda\u0dc5 \u0da2\u0dd3\u0daf \u0d9a \u0daf \u0dc0\u0dcf\u0dc3\u0dd2\u0dda\u0dd4\u0dc0 \u0db8\u0dc3\u0dd4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb1 \u0dc0\u0db4\u0dd2 \u0db4\u0dca \u0daf \u0dc0\u0dcf\u0da7 \u0dc0\u0db4\u0db4\u0dca\u0db4 \u0dc0\u0db8\u0dc0\u200d\u0dba\u0dc0\u0dcf\u0dc1\u0db4\u0dda \u0db4 \u0d86\u0d9a\u0dca\u0dda\u0db8\u0dc0\u0db4 \u0dc4 \u0d91\u0db8 \u0db1\u0dd2\u0d9a\u0dca\u200d\u0dc0\u0db4\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4 \u0db8\u0d9f \u0db4 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dbb\u0db8 \u0da