    "chunk_text": "\u0da7\u0dcf\u0dbd\u0da2\u0d9a\u0dca \u0dd2 \u0dc4\u0dca\u0dc1\u0dc4\u0dca \u0dc1\u0d9c\u0dad\u0dcf\u0db4\u0dd4, \u0d85\u0db4\u0da7 \u0dc1\u0dad\u0dcf\u0d9c\u0dd0\u0dc5\u0dc1\u0db4\u0dad \u0d85\u0dab\u0db4\u0dad\u0dca \u0d9c\u0dd0\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0da2\u0db1\u0dca\u0dad\u0dad \u0d95\u0dad\u0dd1. \u0dc1\u0db8\u0dcf\u0da7\u0daf, \u0dc4\u0db8 \u0dbb \u0dc1\u0dc0\u0dbd\u0dcf\u0dc0\u0da7 \u0db1\u0da7 \u0db1\u0da7 \u0db1\u0db1\u0dca\u0dad\u0da2\u0dd3\u0d95\u0dc0\u0dd2\u0db1\u0dca\u0dad, \u0db1\u0da7 \u0db1\u0da7 \u0dad\u0dcf\u0dad\u0dcf\u0db4\u0dd2 \u0da7\u0dcf\u0dbb\u0dca\u0dbd\u0da2\u0dcf\u0dbd\u0dc0\u0dd2\u0db1\u0dca\u0dad \u0da7\u0dbb\u0db4\u0dd4 \u0db3\u0dbd\u0db4\u0dd1\u0dda \u0db8\u0dad \u0dc4\u0db8 \u0dbb \u0dc4\u0d82\u0dc1 \u0ddd\u0db0\u0dad, \u0d85\u0dab\u0db4\u0dad\u0dca \u0dc1\u0d9c\u0dad\u0dd0\u0dbd\u0dca\u0dbd\u0dcf \u0d85\u0daf \u0db3\u0dbb\u0db4\u0dad\u0dc5 \u0dcf\u0db1\u0dd2\u0da2\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf \u0dd2 \u0dc1\u0db3\u0dad\u0dc0\u0dcf. \u0d85\u0db4\u0dbb\u0dcf\u0db0\u0da2\u0da7 \u0dc0\u0dd2\u0db1\u0dca\u0dad\u0daf\u0dd2\u0dad\u0da2\u0db1\u0dca\u0dad \u0dcf \u0dc4\u0dcf\u0d9a\u0dca\u0dd2\u0da7\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0da7 \u0dc4 \u0dcf\u0da2 \u0daf\u0dd3\u0dc1\u0dda \u0dc4 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0dda \u0db4\u0dad\u0dad \u0d85\u0daf \u0db3\u0dbd\u0dc0\u0dca \u0dc1\u0dbd\u0dc4 \u0d85\u0dc0\u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0dc0\u0dad \u0db3\u0dc0\u0d9a\u0dca \u0d85\u0db4\u0da7 \u0dc1\u0db4\u0dc1\u0dad\u0dad\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1 \u0db8, \u0dc1\u0db4\u0dcf\u0dd2\u0dc4\u0dca \u0d86\u0da5\u0dba\u0db1\u0dcf\u0db4\u0dad\u0dad \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0daf \u0d85\u0dc1\u0dca \u0dbb\u0dc1\u0d89 \u0d85\u0db4\u0dbb\u0dcf\u0db0\u0da7\u0dbb\u0dd4\u0dc1\u0dc0\u0d9a\u0dd4\u0da7 \u0db1\u0dc1\u0dbb\u0dc4\u0dd2\u0dc0 \u0d85\u0dc0\u0db8 \u0db3\u0dbd\u0da2 \u0dc1\u0da2\u0dcf\u0daf\u0dc0\u0dcf\u0d9c\u0db1\u0dca\u0dad\u0dad\u0dc0\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0da7\u0db8\u0d9a\u0dca \u0dad\u0dd0 \u0dd0. \u0dc1\u0db4\u0dcf\u0dd2\u0dc4\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dd2 \u0dcf\u0dbd \u0db4\u0dd2\u0dbb\u0dd2\u0dc4\u0da7\u0da7 \u0d85\u0daf \u0db8\u0dcf\u0dad\u0dc0 \u0dc4\u0dd2\u0db8\u0dd2\u0dad\u0da7\u0dda \u0dad\u0dd4 \u0db4\u0dd0\u0dc0\u0dbb\u0dd2\u0dbd\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1 \u0db8 \u0dc1\u0db4\u0dcf\u0dd2\u0dc4\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dd2 \u0dcf\u0dbd \u0db4\u0dd3\u0da9\u0dad\u0da2\u0da7\u0da7 \u0db4\u0dca \u0dc1\u0dc0\u0dbd\u0dcf \u0d89\u0db1\u0dca\u0dad\u0dad\u0dc0\u0dcf. \u0d92\u0da7 \u0db1\u0dd2\u0dc4\u0dcf\u0db8 \u0d85\u0daf \u0dc4\u0db8 \u0dbb \u0dc1\u0db4\u0dcf\u0dd2\u0dc4\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0da2\u0dad\u0dc0\u0dcf, \u0dbb\u0da7, \u0da2\u0dca\u200d\u0dcf\u0dd2 \u0da2 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0da7\u0dbb\u0dad\u0dc0\u0dcf\u0da7 \u0dc0\u0dd0\u0da9\u0dd2\u0da2 \u0d85\u0db4\u0da7 \u0dc0\u0dd0\u0daf\u0d9c\u0dca \u0dc0\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0d85\u0dc1\u0dca \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0da2 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0da7\u0dbb\u0d9c\u0db1\u0dca\u0dad\u0dad \u0db1\u0da7, \u0dbb\u0da7 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0da7\u0dbb\u0db1\u0dca\u0dad\u0dad \u0dd2\u0dad\u0dc4\u0dd2\u0db1\u0dca\u0dad \u0dc4\u0dd2\u0dbb \u0dc1\u0d9c\u0dc0\u0dbd\u0dca\u0dc0\u0dbd \u0dc0\u0dd0\u0dc1\u0da7\u0db1\u0dca\u0dad\u0dad \u0d85\u0dc0 \u0dba \u0dad\u0dd0 \u0dd0 \u0d9a\u0dd2\u0da2\u0dbd\u0dcf. \u0d92 \u0db8\u0dad\u0da2 \u0d85\u0daf \u0db3\u0da7\u0dc4\u0dd2\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0dc1\u0dda \u0dbb\u0da7\u0da7 \u0dc1\u0d9c\u0dad\u0dd0\u0dbd\u0dca\u0dbd\u0dcf \u0dd2 \u0dc1\u0db3\u0dad\u0dc0\u0dcf. \u0d92 \u0db1\u0dd2\u0dc4\u0dcf \u0db3\u0da7\u0dc4\u0dd2\u0dbb \u0d92\u0da2\u0dca\u200d\u0db1\u0dca\u0dad\u0dad\u0da2\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0d85\u0dc1\u0dca \u0dc1\u0db4\u0dcf\u0dbd\u0dd3\u0db8\u0dc3\u0dd2, \u0db8\u0dd4\u0daf\u0dcf \u0d89\u0dad\u0dcf \u0db3\u0dbd\u0dc0\u0dca \u0dc1\u0dbd\u0dc4 \u0d85\u0db1\u0db0\u0dbb\u0dca\u0dbd\u0da2\u0da7 \u0db4\u0dca \u0da7\u0dbb\u0db4\u0dd4 \u0db3\u0dc0\u0d9a\u0dca \u0d85\u0db4\u0da7 \u0dc1\u0db4\u0dc1\u0dad\u0dad\u0dc0\u0dcf."
