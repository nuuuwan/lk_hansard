    "chunk_text": "\u0d85\u0db4\u0da7 \u0d89\u0dad\u0dd2 \u0dc0\u0dd3\u0da7\u0dd2\u0dca\u0dad \u0dad\u0dc0\u0dca\u0dad \u0d9c\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0d9c \u0dad\u0dbb\u0dba\u0dd2 \u0d9c\u0dd4\u0dc0 \u0db1 \u0d9c\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0d92 \u0dc0\u0dd2\u0dc1\u0daf\u0dbb \u0dc1\u0dbd\u0ddd\u0dab\u0dc1 \u0dc1\u0dbb\u0ddc\u0db3\u0dbb \u0db6\u0dd2\u0dc3\u0dcf\u0dca\u0dc3\u0dcf \u0dd9\u0dab \u0d9c \u0dad\u0dbb\u0dba\u0dd2 \u0db4\u0dba \u0dca\u0dd3 scrap iron \u0dc3\u0db3\u0dbb\u0dd2 \u0d89\u0dc0\u0dca\u0dad \u0dc0 \u0dd3\u0dad\u0dc1 \u0d9a \u0dc0\u0dba\u0dd2\u0db4\u0dd2\u0dba\u0dc0 \u0d92 \u0dc0\u0dd2\u0dc1\u0daf \u0dc1\u0dc1\u0dc0\u0dda \u0d94 \u0dc0\u0dc3\u0dd2\u0dda \u0dc0\u0dba\u0dd2\u0dc0 \u0dbb \u0d9a\u0dbd \u0db1\u0dc1\u0dad\u0ddc\u0da7 \u0dc0\u0dba\u0dd2\u0dc0 \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4 \u0dd2\u0dbb\u0dbd\u0dc0 \u0dc0\u0dba\u0dd2\u0dc0 \u0dc0\u0dd2\u0dc1\u0daf \u0dc0\u0dba\u0dd2\u0dc0\u0dc0\u0dbd \u0dab\u0dba \u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0 \u0db1\n\n\u0d92 \u0dc0\u0dd2\u0dc1\u0daf\u0dbb \u0dad\u0dc0\u0dca\u0dad \u0dc0\u0dd3\u0da7\u0dd2\u0dca\u0dad \u0d85\u0d82 \u0dc0 \u0d9c \u0dad\u0dbb\u0dba\u0dd2 \u0da2\u0dc0\u0da7\u0dba \u0dc3\u0dd3\u0db4\u0dad\u0dd4 \u0d9a \u0dc1\u0dc3\u0dda\u0dc0\u0dd2\u0dc0 \u0d85\u0dc1\u0db4\u0dca \u0dba\u0da7 \u0d85\u0da9\u0dd4 \u0db8\u0dd4\u0da7\u0dbd\u0da7 \u0dc1\u0dbb\u0ddc\u0db3 \u0da2\u0dc0\u0da7\u0dba \u0dc1\u0dc3\u0dda\u0dc0\u0dd2\u0dc0 \u0d9c \u0dc3\u0db4\u0dc0 \u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0 \u0db1 \u0dbb\u0db0\u0dca\u200d\u0dba\u0dc3\u0dcf\u0dcf\u0dd2\u0dca\u0dc0 \u0d9c \u0da7\u0dd3\u0dca\u0da7\u0dca\u0dad \u0dbb\u0dd2\u0dbd\u0dd2 \u0dc0\u0dba\u0dd2\u0dca \u0dc0\u0dd2\u0dc1\u0daf \u0dba\u0da7\u0dc0\u0dda \u0d85\u0dc1\u0db4\u0dca \u0dba\u0da7\u0da7 \u0dd2\u0dc3\u0dd2\u0dda\u0dbd\u0dd2 \u0d92 \u0dc1\u0dc3\u0dda\u0dc0\u0dd2\u0dc0 \u0dbd\u0dbd\u0dd2 \u0dd2 \u0db1\u0dca\u0dc0\u0dd2 \u0dbb\u0dd3\u0dbd\u0dd3\u0dba\u0dd2 \u0d92 \u0d9c\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0d85\u0db4\u0dd2 \u0d85\u0dbb\u0dad\u0dab \u0dab\u0dba\u0dbd\u0dd2 \u0d86\u0dc1\u0dbd\u0dca\u0dc0\u0dd2\n\n1457 1458\n\n\u0db4\u0dd2\u0dae\u0dd2\u0dbd\u0dd2\u0dc1 \u0d9a \u0db1 \u0d85\u0dc0\n\n\u0d92 \u0dc0\u0dd2\u0dc1\u0daf\u0dbb \u0dc0\u0dd3\u0da7\u0dd2\u0dca\u0dad \u0d85\u0d82 \u0dc0 \u0d9c \u0dad\u0dbb\u0dba\u0dd2 \u0dc1\u0dc0\u0dc1\u0dc5\u0db3 \u0dc3\u0d82\u0da0\u0dcf\u0dd2\u0dba\u0dab\u0dc0 \u0db1 \u0dd6\u0dbd\u0dbd\u0dd2\u0dc3\u0dca\u0dd2\u0dbb\u0dd6\u0daa \u0dd2\u0dbb\u0dd4 \u0dbb \u0db1\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0d85\u0dbb\u0db1\u0dd2 \u0d89 \u0db1\u0dd2 \u0dc0\u0dd2\u0dc0 \u0dc0\u0dd2\u0dc1\u0daf \u0dba\u0da7\u0dc0\u0dbd\u0dd2 \u0db1 \u0dc3\u0dd2 \u0dd2\u0dbd \u0db4\u0dd2\u0dd2\u0db4\u0dc3 \u0d9c \u0dc3 \u0d86 \u0d85 \u0db1\u0dad\u0dc1 \u0dbd\u0d82\u0dab\u0dd2\u0dc0\u0da7 \u0dd2\u0dc3\u0dd2\u0dda\u0dbd\u0dd2 \u0dc0\u0dca\u0dc0\u0dd2 \u0d85\u0db4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0 \u0db1 \u0dca \u0d9a \u0d89 \u0db1\u0dd2 \u0dc0\u0dd2\u0dc0 \u0dbb\u0dd2 \u0dbd\u0d82\u0dab\u0dd2\u0dc0 \u0d85\u0dad\u0dba \u0da7\u0dd3\u0dca\u0da7 \u200d\u0dbb\u0dd2\u0dc0\u0dd2\u0dca\u0dad\u0dbb\u0dab \u0dc1\u0dc0\u0dca \u0d9c\u0dd4\u0dc0 \u0db1 \u0dc1\u0dc3\u0dda\u0dc0\u0dd2\u0dc0\u0da7 \u0d85\u0dbb\u0dad\u0dba\u0dc0 \u0dad\u0dc0 \u0dca\u0dd2\u0dba 10\u0dab 15\u0dab 20\u0dab \u0d9c\u0dd4\u0dc0 \u0db1 \u0dc1\u0dc3\u0dda\u0dc0\u0dd2 \u0dca\u0dba \u0d9a\u0db7 \u0dab\u0dba \u0db1\u0dca weekend \u0dd9\u0dc1 \u0d9c \u0dbd\u0d82\u0dab\u0dd2\u0dc0\u0da7 \u0dd2\u0dc3\u0dd2\u0dda\u0dbd\u0dd2 \u0dc0\u0dca \u0d89 \u0db1\u0dd2 \u0dc0\u0dd2\u0dd4\u0dc0 \u0dc3\u0d82\u0da0\u0dcf\u0dd2\u0dba\u0dab\u0dc0 \u0db1 \u0dc3\u0dd2 \u0dd2\u0dbd \u0db4\u0dd2\u0dd2\u0db4\u0dc3 \u0d9c \u0dca\u0dab\u0dae\u0dd2\u0dc2\u0dca\u0da8 \u0dc0 \u0dab\u0dba \u0dd2 \u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0 \u0db1 \u0d92\u0dab\u0da7 \u0dc1\u0dbb\u0dda \u0d85\u0dc0 \u0d85\u0da7 \u0dc0\u0dca\u0dc3\u0dd2\u0da7 \u0d89 \u0db1\u0dd2 \u0dc0\u0dd2\u0dc0 \u0dc1\u0dbb\u0ddc\u0db3 millionaires\u0dbd\u0dd2 billionaires\u0dbd\u0dd2 \u0d89 \u0db1\u0dca \u0dba\u0da7 \u0d9c \u0dbd\u0dc0\u0da7 \u0db4\u0dca\u0dad \u0dc1\u0dc0\u0dbd\u0dd2 \u0d86\u0dc1\u0dbd\u0dca \u0dd9\u0dab\n\n\u0d92 \u0dc0\u0dd2\u0dc1\u0daf\u0dbb \u0dca\u0dae\u0dd2\u0d9a \u0dab\u0dc0\u0da7 \u0dc3\u0dd2 \u0dd2\u0dbd \u0da7\u0dd2\u0dc0\u0dab\u0dca\u0dad\u0dc0\u0dc0 \u0d9c \u0dbd\u0dbd\u0dd2 \u0dd2\u0dad \u0dbb\u0dd3\u0dc0 \u0dad\u0dc0\u0dca\u0dad \u0d9c\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0d9c \u0dad\u0dbb\u0dba\u0dd2 \u0d89\u0dd2 \u0dc0 \u0dd3\u0dad \u0d9a \u0d9c\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0d85\u0da7 \u0dc0\u0dca\u0dc1\u0dab\u0ddc\u0da7 \u0dbd\u0d82\u0dab\u0dd2\u0dc1 \u0d89\u0dd2 \u0dc0 \u0dd3\u0dad \u0d9a \u0d9c\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0dab\u0da9\u0dd2\u0dc1\u0dd2\u0dca \u0dc0\u0dd3\u0da7\u0dd2\u0dbd\u0dd2 \u0dbb\u0dd3\u0dbd\u0dd3\u0dba\u0dd2 \u0dc3\u0dc0\u0dd4\u0dd2 \u0d85\u0dba\u0dd2\u0db6\u0dd2\u0dc1 \u0da9\u0dd4\u0dbd\u0dd2\u0dba\u0dd2\u0dc0\u0dbd \u0d85\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dab\u0dd2\u0dd4\u0dc0 \u0dba\u0da7\u0dc0\u0dbd \u0d89\u0dd2 \u0dc0 \u0dd3\u0dad \u0d9a \u0d9c\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0dc3\u0db3\u0dbb\u0dd2 \u0d85\u0dc0\u0dc3\u0dcf\u0dcf\u0dd2 \u0dc3\u0dd2 \u0dd2\u0dbd \u0dca\u200d\u0dbb\u0dbb\u0dd2 \u0dc0 \u0d9c \u0d86\u0dc1\u0dbd\u0dca\u0dc0\u0dd2 \u0d85\u0dc1\u0db4\u0dca \u0dba\u0dc1\u0da7\u0dca \u0dc1\u0dbb\u0ddc\u0db3 \u0d89\u0dd2 \u0dc0 \u0dd3\u0dad \u0d9a \u0dab\u0dae\u0dd2\u0dbb\u0dd2 \u0db1\u0dad\u0dab\u0dbb\u0dd4\u0dc0 \u0db1 \u0d89 \u0db1\u0dca\u0dc0\u0dd2 \u0d92 \u0d85\u0dc0 \u0d9c \u0d86\u0dbb\u0dca\u0dad \u0dab\u0dba \u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0 \u0db1 \u0dca \u0d9a \u0d92\u0dab \u0d85\u0dc1\u0db4\u0dca \u0dba\u0da7\u0da7 \u0dc3\u0dd2 \u0dd2\u0dbd \u0d9c \u0d86\u0dc0 \u0d9c \u0d92 \u0d9c\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb \u0db4\u0dd2\u0dc5\u0dd2\u0dbd\u0db3\u0dc0 \u0dc1\u0dbb\u0dc0\u0dba \u0d85\u0dc0 \u0dc0\u0dd3\u0dc1 \u0d85\u0dc0\u0db0\u0dca\u200d\u0dd2\u0dca\u0dc0 \u0dc1\u0dc0\u0ddc\u0db8\u0dd4 \u0dab\u0dba\u0dbd\u0dd2 \u0d86\u0dc1\u0dbd \u0db1\u0dc1 \u0db1 \u0dc1\u0dab\u0ddc\u0dad\u0dd3\u0dca\u0da7?\n\n\u0d85\u0dc1\u0db4\u0dca \u0da2\u0dca\u0dd2\u0db0\u0dd2\u0db4 \u0d86 \u0d85\u0dbb\u0dd2 \u0d89\u0dd2 \u0dd2\u0db4\u0db4\u0dca\u0dad \u0dab\u0dc5 \u0d85\u0dc0 \u0dc0\u0dd3\u0dc0 \u0dab\u0dcf\u0dd2\u0dc1 \u0daf\u0dd3 \u0dd2 \u0dc3\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dd2 \u0d9c\u0dab \u0dbb\u0dad\u0dba\u0dab \u0db4\u0dbb\u0dab \u0dca \u0d9a \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dbb\u0dc1\u0daf \u0db6\u0dd2\u0d82\u0d9a\u0dc0\u0dd2\u0db4\u0dc0 \u0dca\u0dc3\u0dca\u0dc1 \u0dca\u0dbb\u0dca\u0dad \u0dc0 \u0dc0\u0dd2 \u0d85\u0db4\u0dca\u0dc0\u0dca \u0d9c\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dc1 \u0dd2 \u0dad\u0dd4\u0dab\u0dd4\u0dc0 \u0d9c \u0dd2 \u0d86 \u0dab\u0dba\u0dca\u0dc0\u0dd2 \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dbb\u0dbb \u0d92 \u0dd2\u0dd3\u0dca \u0dc3 \u0d85\u0da7\u0dd4 \u0dc1\u0dc0\u0dca\u0dc0\u0dd2 \u0dc1\u0dbb\u0ddc\u0dab\u0da7 \u0dbb\u0dbb \u0db1\u0dd2\u0dc1\u0dc0\u0ddd\u0da2\u0dba \u0dd2\u0dbb \u0d86\u0dc0\u0dba\u0dc0\u0dd2 \u0dc3\u0dd2\u0db0\u0dd2\u0dc0\u0da7 \u0db1\u0dca\u0da7\u0dd2\u0dc0\u0daf\u0dd3 \u0d92 \u0dc3\u0db3\u0dbb\u0dd2 \u0d85\u0dc0 \u0dba \u0dab\u0da7\u0dad\u0dd4 \u0d85 \u0dab\u0dc5\u0dd2 \u0dbb\u0dc1\u0daf \u0db6\u0dd2\u0d82\u0d9a\u0dc0\u0dd2\u0db4\u0dc0 \u0dca\u0dc3\u0dca\u0dc1 \u0dc1\u0db4\u0ddc\u0dda \u0dc0 \u0d85 \u0d85 \u0d9c\u0dab\u0dba 8 000 \u0d9c \u0dc3\u0dd2\u0dad\u0dba \u0d86\u0dc1\u0dbd\u0dca\u0dc0\u0dd2\n\n\u0dd9\u0dba\u0dd2 \u0db1 \u0d85 \u0d9c\u0dab\u0dba 985 \u0d9c \u0d85\u0dba\u0dc1\u0dd2\u0dca \u0dbd\u0d82\u0dab\u0dd2\u0dc1 19\u0dc0\u0dca \u0d85\u0db4\u0dca\u0dc0\u0dca \u0dc3\u0dd3\u0dab\u0dc3\u0dd4 \u0d9a \u0dab\u0dbd\u0dd2\u0db4\u0dc0 \u0dbb\u0dd3\u0daf\u0dd4\u0dc0\u0dd2 \u0dab\u0dca\u0dd2\u0dd2\u0da7\u0dd4\u0dba\u0dd2 \u0dc0 \u0dc0 \u0db1\u0dca \u0da2\u0dbb\u