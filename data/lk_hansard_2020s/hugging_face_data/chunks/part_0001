    "chunk_text": "\u0dad\u0dc0 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dd4\u0dc1\u0db8\u0d9a\u0dca \u0d9a\u0dd2\u0dda\u0dc0\u0dcf, \u0dbb\u0d9a\u0dca \u0da7\u0da7\u0dcf \u0dc1 telephones \u0db3\u0dbd\u0db1\u0dca\u0dad\u0dad \u0d95\u0dad\u0dd1 \u0d9a\u0dd2\u0da2\u0dbd\u0dcf. \u0d85\u0db4\u0dd2 \u0d92 \u0dc3\u0dd2\u0da2\u0dbd\u0dd4 \u0dc1\u0dda \u0da7\u0dbb\u0dad\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0dd0\u0db8 telephone call \u0db1\u0da7\u0d9a\u0dca\u0db8 check \u0da7\u0dbb\u0dad\u0dc0\u0dcf. \u0da7\u0dcf \u0db1\u0d9a\u0dca\u0da7\u0daf \u0dc1\u0dda \u0dc1\u0d9c\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0dad\u0dc1 \u0d86\u0dc1\u0dca\u200d\u0dbb\u0da2 \u0dd2 \u0db6\u0dd2\u0dbd\u0dcf \u0dd2 \u0dc1\u0db3\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0da2\u0dbd\u0dcf \u0db3\u0dbd\u0dad\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1 \u0db8 \u0d85\u0db4\u0dd2 \u0daf\u0dd0\u0db1\u0dca\u0dad \u0dc1\u0dda \u0dc1\u0d9c\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0dad\u0dc1 \u0dc0\u0dca \u0da7\u0dda \u0d9c\u0dd0\u0dad \u0db3\u0dbd\u0dad\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0d92\u0dc0\u0dcf \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dc4\u0db1\u0dca\u0dad\u0dad\u0da7 \u0da7\u0dbb\u0db1\u0dca\u0dad\u0dad \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dc0\u0dc5\u0d9a\u0dca \u0db4\u0da7\u0db1\u0dca\u0dad \u0d85\u0dbb\u0dc1\u0d9c\u0dad \u0dd2 \u0dc1\u0db3\u0dad\u0dc0\u0dcf. \u0d89\u0dd2 \u0db1\u0dca\u0dad, \u0d92 \u0dc0\u0dd2\u0db0\u0dd2\u0da2\u0da7 \u0d85\u0db4\u0dd2 \u0dc1\u0dda \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dc0\u0dc5 \u0daf\u0dd2\u0dd2\u0dad\u0db1\u0dca\u0dad \u0daf\u0dd2\u0d9c\u0da7\u0db8 \u0da7\u0dbb\u0dc1\u0d9c\u0dad \u0da2\u0dad\u0dc0\u0dcf. \u0dc1\u0dda \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1\u0dda \u0d85\u0dc1\u0dca \u0db8 \u0da2\u0dca\u200d\u0dad\u0da2\u0dcf\u0dc1\u0d9c\u0db1\u0dca\u0dad \u0db1\u0da7 \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0db8\u0d9a\u0dca \u0da7\u0dbb\u0db1\u0dca\u0dad\u0dad \u0db8\u0db8 \u0da7\u0dd0\u0db8\u0dd0\u0dd2 \u0dba\u0dd2. \u0d85\u0db4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dad\u0dbb\u0dda \u0dc1\u0dad\u0dcf\u0dbb\u0dd4\u0dbb\u0dd4 \u0dbd\u0db3\u0dcf \u0dc1\u0daf\u0db1\u0dca\u0dad\u0dad. 118 \u0d85\u0d82\u0da7\u0da2\u0da7 \u0da7\u0dae\u0dcf \u0da7\u0dbb\u0dbd\u0dcf \u0d95\u0dad\u0dd1 \u0dc1\u0daf\u0da2\u0d9a\u0dca \u0d9a\u0dd2\u0da2\u0db1\u0dca\u0dad\u0dad. \u0d92\u0dc0\u0dcf \u0dbb \u0dc3\u0dd2\u0d9c\u0dad\u0dba\u0dd2. \u0d92\u0da7 \u0dc1\u0da7\u0dd2\u0db6\u0db1\u0dca\u0dad\u0db8 \u0db8\u0dcf \u0da2\u0da7\u0dc1\u0dca \u0dd2 \u0dc1\u0db3\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad. \u0d85\u0db4\u0da7 \u0dc1\u0dad\u0dcf\u0dbb\u0dd4\u0dbb\u0dd4 \u0dbd\u0db3\u0dcf \u0dc1\u0daf\u0db1\u0dca\u0dad\u0dad. \u0dc1\u0dda \u0da7\u0da7\u0dba\u0dd4\u0dca \u0dad \u0d85\u0db4\u0dd2 \u0daf\u0dd2\u0dd2\u0dad\u0db1\u0dca\u0dad \u0daf\u0dd2\u0d9c\u0da7\u0db8 \u0da7\u0dbb\u0dc1\u0d9c\u0dad \u0da2\u0dad\u0dc0\u0dcf.\n\n\u0db8\u0da7 \u0dad\u0dc0 \u0db1\u0da7 \u0da7\u0dcf\u0dbb\u0dab\u0da2\u0d9a\u0dca \u0d9a\u0dd2\u0da2\u0db1\u0dca\u0dad\u0dad \u0db3\u0dd0\u0dbb\u0dd2 \u0dc0\u0dd4\u0dab\u0dcf. \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dbb\u0dc1\u0da2\u0d9a\u0dca -\u0db8\u0da7 \u0db8\u0dad\u0da7 \u0dc0\u0dd2\u0db0\u0dd2\u0da2\u0da7 \u0dbb\u0dc0\u0dd4 \u0dca \u0d9a\u0dd3\u0dda \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db8\u0dcf- \u0d9a\u0dd2\u0dda\u0dc0\u0dcf,"
