0dc0\u0dd4 \u0dd2 \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dbd\u0dad \u0dc1\u0dbd\u0dd2\u0db4 \u0dc0\u0dd4 \u0dd2 \u0dc0 \u0dc0\u0dbd\u0dd2 \u0d85\u0db4\u0da7 \u0dc1\u0dca\u0ddd\u0dca\u0dd2 \u0dd2 \u0d9c\u0dab\u0dc3\u0dd2\u0da7 \u0dab\u0dba \u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0 \u0db1\u0dab\u0dbb \u0d9c \u0dca\u0dd3\u0dbb\u0dd3 \u0dd9\u0dc1\u0dbb\u0dbb \u0dc1\u0dc1\u0dc0\u0dda \u0dc1\u0dc0\u0dca\u0dc0\u0dd2 \u0dc3\u0dbb\u0dbb\u0dbb\u0dd4 \u0dc0 \u0dad\u0dd2\u0dc1\u0dd2\u0dca \u0d89 \u0db1\u0dca\u0dc0\u0dd2 \u0dc1\u0dbb\u0ddc\u0dc1\u0da7\u0da7 \u0dc0\u0dab\u0dd4 \u0dc0\u0dd3\u0da9\u0dd2 \u0dc0\u0dd4 \u0dd2 \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dbd\u0dad \u0dc1\u0dbd\u0dd2\u0db4 \u0dc0\u0dd4 \u0dd2 \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dd2\u0dd1\u0db1\u0dd2 \u0dd2 \u0d9c\u0dab\u0dc3\u0dd2\u0da7 \u0dab\u0dba\u0dba\u0dd2 \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dbb\u0dd2\u0db4 \u0dd2 \u0d9c\u0dab\u0dc3\u0dd2\u0da7 \u0dab\u0dba\u0dbd\u0dd2 \u0dbd\u0db3\u0dd2 \u0db1\u0dc1 \u0db1 \u0dab\u0dc0\u0dd4\u0dbb\u0dd4\u0da7? \u0db8\u0dd4\u0dbd\u0dd2 \u0db1 \u0d85\u0dac \u0dd2\u0dbb\u0dbd\u0dd2 \u0dba\u0da7 \u0dc1\u0da7 \u0db1\u0dca \u0dbb\u0da7\u0dca \u0dc1\u0dab\u0ddc\u0da7 \u0dba\u0da7 \u0db7\u0dd2\u0dba\u0dc1\u0dd2\u0dca \u0dab\u0dba \u0db1\u0dca \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dc1\u0da7 \u0db1\u0dca \u0dbb\u0da7\u0dca \u0dc1\u0dab\u0ddc\u0da7 \u0dbb\u0d9f \u0dbb\u0dd3\u0dba\u0db4\u0dd4 \u0d92 \u0dc1\u0dd2\u0ddc\u0dda\u0dbd \u0db1\u0da7\u0da7 \u0db7\u0dd2\u0dba \u0dc1\u0da7 \u0db1\u0dc1 \u0db1? \u0dca\u0dd3\u0dbb\u0dd3 \u0dd9\u0dc1\u0dbb\u0dbb \u0db7\u0dd2\u0dba\u0dd2 \u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0 \u0db1 \u0da2\u0dd2\u0dc1\u0dad \u0d9c \u0d89 \u0db1\u0dca\u0dc0\u0dd2\u0da7? \u0dd9\u0dc1\u0dbb\u0dbb \u0dab\u0dba \u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0 \u0db1 \u0dc1\u0dab\u0dc1\u0dca \u0d9c \u0dca\u0dd3\u0dbb\u0dd3 \u0d92 \u0db1\u0dd2\u0dc3\u0dd2 \u0dc1 \u0d9a \u0d89\u0dd2 \u0dd2\u0db4\u0db4\u0dca\u0dad \u0dab\u0dba\u0dbd\u0dd2 \u0d86\u0dc1\u0dbd\u0dca \u0d85\u0dc0 \u0dc0\u0dd3\u0dc0\u0da7 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0dab\u0dd2 \u0dc1\u0db4\u0ddc\u0daf\u0dd4\u0da2\u0dca \u0dc1\u0db4\u0dba\u0db8\u0dd4 \u0dbb\u0dd3\u0da7\u0dd2\u0dc0\u0da7 \u0d85\u0db4\u0dd2 \u0d85\u0dc1\u0db4\u0dca \u0dc3\u0dbb\u0dc1\u0dc0\u0ddd\u0dd2\u0dc0 \u0dbd\u0dbd\u0dd2 \u0dc1\u0da7\u0dca\u0dc0\u0dd2\n\n\u0dd2\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dc0\u0ddd\u0da2\u0dba \u0dab\u0dcf\u0dd2\u0dca\u0dd2\u0dc0\u0dab \u0d85\u0dbb\u0db1\u0dd2 \u0d85\u0da7 \u0d8b\u0dc1\u0dc1 \u0dc3\u0dd2\u0db4 \u0d9c\u0dc2\u0dca\u0da8 \u0dca\u0dd2\u0dc0\u0dab \u0d85\u0dbb\u0dd2 \u0dc3\u0dcf\u0dcf\u0dd2\u0dc0\u0dba \u0db1\u0dd2\u0dc1\u0dc0\u0ddd\u0dd2 27(2) \u0dc0\u0da7\u0dc1\u0dca\u0dad \u0dca\u200d\u0dbb \u0dcf\u0dca\u0dc0 \u0d9c \u0d85\u0dbb\u0dbd\u0dd2 \u0dc1 \u0d9a \u0db4\u0dd2\u0dae\u0dd2\u0dbd\u0dd2\u0dc1 \u0d9a \u0db1 \u0d85\u0dc1 \u0dbb\u0dbb\u0dd2 \u0dd2\u0dd2\u0dbd \u0dc1\u0dd2\u0ddd\u0da7\u0dca\u0da7\u0dd2\u0dc0 \u0d9c \u0dd2 \u0d86 \u0dc0\u0dd4 \u0dd2 \u0dd9\u0dab \u0db4\u0dd3\u0dca\u0dad\u0dad\u0dc0 \u0db1 \u0dbb\u0dbb\u0dca\u0dad \u0db1\u0dd2\u0dc1\u0dc0\u0ddd\u0da2\u0dba \u0dab\u0dcf\u0dd2\u0dca\u0dd2\u0dc0\u0dab\u0dc0\u0dba\u0dc0\u0dd2 \u0dbb\u0dd3\u0da7\u0dd2\u0dc0\u0da7 \u0d94\u0dbd \u0d85\u0dbb\u0dd2\u0dca\u0dad \u0da7\u0dc0 \u0dca\u0dc0\u0dd2 \u0dc3\u0dcf\u0dcf\u0dd2\u0dc0\u0dba \u0db1\u0dd2\u0dc1\u0dc0\u0ddd\u0dd2 27 (2) \u0dc0\u0da7\u0dc1\u0dca\u0dad \u0dca\u200d\u0dbb \u0dcf\u0dca\u0dc0 \u0d9c \u0d85\u0dbb \u0db1\u0dca \u0d86\u0dc1\u0dbd\u0dca \u0dc1\u0dc0\u0dbd\u0dd2\u0dc1 \u0d92 \u0dca\u200d\u0dbb \u0dcf\u0dca\u0dc0 \u0d85\u0dbb \u0db1\u0dca \u0d95\u0dca\u0dd1 \u0dc0 \u0dc0\u0dca \u0dd9\u0dab \u0dca\u0db8\u0dd4\u0dca\u0dad \u0dc3\u0dcf\u0dcf\u0dd2\u0dc0\u0dba \u0db1\u0dd2\u0dc1\u0dc0\u0ddd\u0dd2 \u0d85\u0dc0\u0db7\u0dd2\u0dc3\u0dd2\u0dad \u0dc1\u0dc0\u0dca\u0dc0\u0dd2 \u0d85\u0db4\u0dd2 \u0da7\u0dd3\u0dab \u0d86\u0dc1\u0dbd\u0dca\u0dc0\u0dd2 \u0dca\u200d\u0dbb \u0dcf\u0dca\u0dc0 \u0d85\u0dbb\u0dca\u0dc0\u0dd2 \u0dc1\u0dc0\u0dd4\u0dc0\u0dc0\u0da7 \u0dbb\u0dbb\u0dd2 \u0db4\u0dad\u