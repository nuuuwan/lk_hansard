    "chunk_text": "\u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0b9f\u0baf \u0b95\u0bbf\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bae\u0bb2 \u0b85\u0b95\u0bcd\u0b95\u0b95\u0bb0\u0baa\u0bcd\u0baa\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0ba4\u0baa\u0bbe\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bbf\u0bb2\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b87\u0b95\u0b9f\u0baf\u0bbf\u0bb2\u0bbe\u0ba9 \u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0bae\u0b95\u0bbe\u0bb5\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0bae\u0ba4\u0b9a\u0bae\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bae\u0bbe\u0b95 \u0bb5\u0bbf\u0bb5\u0b9a\u0bbe\u0baf\u0bae\u0bcd \u0bae\u0bae\u0bb1\u0bcd\u0ba4\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b93\u0bb0\u0bcd \u0b87\u0b9f\u0bae\u0bbe\u0b95 \u0bb5\u0bbf\u0bb3\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b85\u0b99\u0bcd\u0b95\u0bc1 \u0baa\u0bb2\u0bae\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bc1\u0bb1\u0bb5\u0bc1\u0b9a\u0bcd \u0b9a\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bc2 \u0b9f\u0bbe\u0ba9 \u0b8e\u0bbe\u0bbf\u0ba4\u0baa\u0bbe\u0bb0\u0bc1\u0bb3\u0bcd \u0ba8\u0bbf\u0bb0\u0baa\u0bcd\u0baa\u0bc1 \u0ba8\u0bbf\u0b95\u0bb2\u0baf\u0ba4\u0bae\u0bbe\u0ba9\u0bcd\u0bae\u0bb1 \u0b87\u0baf\u0b99\u0bcd\u0b95\u0bbf\u0b95\u0bcd \u0ba4\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b85\u0ba8\u0bcd\u0ba4 \u0b8e\u0bbe\u0bbf\u0ba4\u0baa\u0bbe\u0bb0\u0bc1\u0bb3\u0bcd \u0ba8\u0bbf\u0b95\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bc2\u0b9f\u0bbe\u0b95 \u0b85\u0b99\u0bcd\u0b95\u0bc1\u0bb3\u0bcd\u0bb3 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bae\u0ba4\u0b95\u0bb5\u0b95\u0b95\u0bb3\u0baa\u0bcd \u0baa\u0bc2\u0bb0\u0ba3\u0bae\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0bc2\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf\u0ba4\u0b9a\u0baf\u0bcd\u0baf \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bbe\u0ba4 \u0b92\u0bb0\u0bc1 \u0ba8\u0bbf\u0b95\u0bb2 \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1\u0ba4\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b87\u0baa\u0bcd\u0baa\u0bbf\u0bb0\u0bae\u0ba4\u0b9a\u0ba4\u0bcd \u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b8e\u0bbe\u0bbf\u0ba4\u0baa\u0bbe\u0bb0\u0bc1\u0bb3\u0bcd \u0ba8\u0bbf\u0bb0\u0baa\u0bcd\u0baa\u0bc1 \u0ba8\u0bbf\u0b95\u0bb2\u0baf\u0ba4\u0bae\u0bbe\u0ba9\u0bcd\u0b95\u0bb1 \u0b85\u0b95\u0bae\u0ba4\u0bcd\u0ba4\u0bc1\u0ba4\u0bcd \u0ba4\u0bb0\u0bae\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bae\u0ba9\u0bcd\u0bb1 \u0bae\u0b95\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0b95\u0b95\u0baf \u0ba8\u0bbe\u0ba9\u0bcd \u0ba8\u0bc0\u0ba3\u0bcd\u0b9f \u0b95\u0bbe\u0bb2\u0bae\u0bbe\u0b95 \u0bae\u0bc1\u0ba9\u0bcd\u0b95\u0bb5\u0ba4\u0bcd\u0ba4\u0bc1 \u0bb5\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bae\u0bb1\u0ba9\u0bcd. \u0b8e\u0ba9\u0bae\u0bb5, \u0b85\u0ba8\u0bcd\u0ba4\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0bae\u0ba4\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b8e\u0bbe\u0bbf\u0ba4\u0baa\u0bbe\u0bb0\u0bc1\u0bb3\u0bcd \u0ba8\u0bbf\u0bb0\u0baa\u0bcd\u0baa\u0bc1 \u0ba8\u0bbf\u0b95\u0bb2\u0baf\u0ba4\u0bae\u0bbe\u0ba9\u0bcd\u0b95\u0bb1 \u0b85\u0b95\u0bae\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd \u0ba4\u0b95\u0bbe\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0ba4 \u0ba9\u0bc2\u0b9f\u0bbe\u0b95, \u0b85\u0ba8\u0bcd\u0ba4 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bae\u0ba4\u0bc1 \u0bb5\u0bbf\u0bb5\u0b9a\u0bbe\u0baf\u0ba4\u0bcd \u0bae\u0ba4\u0b95\u0bb5\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b8e\u0bbe\u0bbf\u0ba4\u0baa\u0bbe\u0bb0\u0bc1\u0bb3\u0bcd \u0bb5\u0b9a\u0ba4\u0bbf\u0baf\u0bbf\u0b95\u0ba9 \u0b87\u0bb2\u0b95\u0bc1\u0bb5\u0bbe\u0b95\u0baa\u0bcd \u0ba4\u0baa\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bbf\u0baf\u0ba4\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bae\u0ba9 \u0ba8\u0bbe\u0ba9\u0bcd \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bae\u0bb1\u0ba9\u0bcd.\n\n\u0b85\u0ba3\u0bcd\u0b95\u0bae\u0baf\u0bbf\u0bae\u0bb2 \u0ba4\u0baa\u0bbe\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bbf\u0bb2\u0bcd \u0b95\u0ba9\u0b95\u0bb0\u0bcd \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bae\u0bc0\u0bb3\u0bcd\u0b95\u0bc1\u0b9f\u0bbf \u0bae\u0baf\u0bb1\u0bcd\u0bb1\u0bae\u0bcd \u0ba4\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0ba4\u0ba4\u0bbe\u0bbf\u0baf\u0bc1\u0bae\u0bcd. \u0b85\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0baa\u0bb2 \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0b95\u0b9f\u0ba4\u0bcd \u0bae\u0ba4\u0b95\u0bb5\u0b95\u0bb3\u0bcd \u0b85\u0ba8\u0bcd\u0ba4 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd \u0b95\u0bc1\u0baa\u0bcd \u0baa\u0bc2\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf\u0ba4\u0b9a\u0baf\u0bcd\u0ba4\u0bc1 \u0ba4\u0b95\u0bbe\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bae\u0bb5\u0ba3\u0bcd\u0b9f\u0bbf\u0baf\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b8e\u0ba9\u0bae\u0bb5, \u0b8e\u0ba9\u0ba4\u0bc1 \u0bae\u0b95\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0b95\u0b95\u0b95\u0bb3\u0b95\u0bcd \u0b95\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0ba4\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1, \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0b9f\u0baf \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bae\u0ba4\u0b95\u0bb5\u0b95\u0b95\u0bb3\u0baa\u0bcd \u0baa\u0bc2\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf\u0ba4\u0b9a\u0baf\u0bcd\u0baf \u0bae\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bae\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba8\u0bbe\u0ba9\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0b9f\u0bae\u0bcd \u0b85\u0ba9\u0bcd\u0baa\u0bbe\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba8\u0baf\u0bae\u0bbe\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0bae\u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0ba8\u0bbf\u0bb1\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bae\u0bb1\u0ba9\u0bcd. \u0ba8\u0ba9\u0bcd\u0bb1\u0bbf, \u0bb5\u0ba3\u0b95\u0bcd\u0b95\u0bae\u0bcd!\n\n\u0d9c\u0dd4 \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0dcf\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dd9\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dd4\u0dbb\u0dd9\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0b95\u0bb2\u0b95\u0bae\u0ba4\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0d9c\u0dd4\u0dc0 \u0da0\u0dbd\u0dca \u0db1 \u0dcf \u0dc0\u0dd3 \u0dca\u0dc2\u0dc1 \u0ddc\u0da9\u0dd2 \u0dcf\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dd4 \u0dcf\u0daf. \u0d94\u0db6\u0dd4 \u0dcf\u0daf\u0da7 \u0dc0\u0dd2\u0db1\u0daf\u0da9\u0dd2 ]3 \u0daf\u0dbd\u0d9a\u0dca\u0dc2 \u0dd2\u0dbb\u0dc1\u0db6\u0db1\u0dc0\u0dca\u200d\u0daf."
  },
