    "chunk_text": "\u0dc3\u0d82\u0da0\u0dcf\u0dd2\u0dba\u0dab \u0d9c\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0dd2 \u0dad\u0dd4\u0dab\u0dd4 \u0dc0 \u0dd3\u0dad\u0dbb\u0da7 \u0dc1\u0dbb\u0ddd\u0da7\u0dda \u0dd2 \u0dad\u0dd4\u0dab\u0dd4 \u0dc0 \u0dd3\u0dad\u0dbb \u0dc3\u0db3\u0dbb\u0dd2 \u0db8\u0dd4\u0da7\u0dbd \u0d9c \u0dc1\u0dc0 \u0db1 \u0dab\u0dba\u0dca\u0dc0\u0dd2 \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dc0 \u0dc0\u0dd3\u0dc0\u0dd4 \u0dd2 \u0d85\u0dc0 \u0dc0\u0dd3\u0dc0 \u0dc1\u0dc0\u0ddd\u0da2\u0dca\u0dd2\u0dc0\u0dbd\u0daf\u0dd3 \u0dc1\u0dbb\u0ddd\u0da7\u0dda \u0dc1\u0dd2\u0ddc\u0da9\u0dca\u0d9f\u0dbd\u0dd2 \u0db4\u0dbb \u0d9c \u0dc3\u0d82\u0da0\u0dcf\u0dd2\u0dba\u0dab \u0d9c\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0dd2 \u0dad\u0dd4\u0dab\u0dd4 \u0dab\u0dba \u0db1\u0dca \u0dbd\u0dd3\u0dbb\u0dd3 \u0dc1 \u0d9a \u0dba\u0da7\u0da7 \u0dc3\u0d82\u0da0\u0dcf\u0dd2\u0dba\u0dab\u0dc0 \u0db1 \u0dca\u0dab\u0dae\u0dd2\u0dc2\u0dca\u0da8 \u0dc0 \u0dab\u0dba \u0dd2 \u0db1\u0dca \u0d85\u0dc0 \u0dba \u0dc3\u0dcf\u0dc0\u0dd2\u0db7\u0dd2\u0dc3\u0dd2\u0dab \u0dc3 \u0d9a\u0db4\u0dca\u0dad \u0d86\u0dc1\u0dbd\u0dca\u0dc0\u0dd2 \u0dd9\u0dca \u0d9a \u0dc0\u0dca \u0da2\u0dd3\u0dc0\u0dd3 \u0db1 \u0d89 \u0db1\u0dca\u0dc0\u0dd2 \u0dab\u0dd4\u0db1\u0dab\u0dba\u0dc0 \u0d86\u0dc1\u0dbd\u0dca\u0dc0\u0dd2 \u0db8\u0dd4\u0dd4\u0dc0\u0dc1\u0dc1 \u0dad\u0dda\u0dbb\u0dc3\u0dd4 \u0db1 \u0d89 \u0db1\u0dca\u0dc0\u0dd2 \u0dc1\u0da9\u0ddc\u0dda\u0dc6\u0dd2 \u0db1 \u0dbb\u0dc3\u0dd4 \u0db1 \u0d89 \u0db1\u0dca\u0dc0\u0dd2 \u0dc1\u0dca\u0ddc\u0dc1\u0dc0 \u0d9c \u0dca\u0dab\u0dd2\u0dba\u0dc1 \u0dca\u0da7\u0daf\u0dba \u0db1 \u0d86\u0dc1\u0dbd\u0dca\u0dc0\u0dd2 \u0d92 \u0db1\u0dca\u0dc0 \u0dc0 \u0dc1\u0dc1 \u0d86\u0dc1\u0dbd\u0dc1\u0daf\u0dd3 \u0dc1\u0dbb\u0ddd\u0da7\u0dda \u0db4\u0dbb \u0d9c \u0dbb\u0da7\u0dbd\u0dd2 \u0dc3\u0d82\u0da0\u0dcf\u0dd2\u0dba\u0dab \u0d9c\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dc0 \u0dd2 \u0dad\u0dd4\u0dab\u0dd4 \u0dab\u0dba \u0db1\u0dc