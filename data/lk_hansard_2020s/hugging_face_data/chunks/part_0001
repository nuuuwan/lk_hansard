    "chunk_text": "\u0ba4\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1 4, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc2\u0bc8\u0ba4\u0ba9\u0b9a\u0bcd \u0b9a\u0b9a\u0bc8\u0bb5\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bc8\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1 5.- \u0b85\u0bae\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bae\u0bb5 \u0b85\u0bb2\u0bc1\u0bb5\u0bc8\u0b95\u0bae\u0bcd \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01.- \u0b9a\u0b9a\u0baf\u0bb2\u0bcd\u0bae\u0bc1\u0bae\u0bb1\u0b9a\u0bcd \u0b9a\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd - \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd\n\n\u0b9a\u0b9a\u0bc8\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 191,000,000\n\n\u0ba4\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1 5, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0b9a\u0b9a\u0bc8\u0bb5\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bc8\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01.- \u0b9a\u0b9a\u0baf\u0bb2\u0bcd\u0bae\u0bc1\u0bae\u0bb1\u0b9a\u0bcd \u0b9a\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd - \u0bae\u0bc2\u0bc8\u0ba4\u0ba9\u0b9a\u0bcd\n\n\u0b9a\u0b9a\u0bc8\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 35,000,000\n\n\u201c\u0ba4\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1 5, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc2\u0bc8\u0ba4\u0ba9\u0b9a\u0bcd \u0b9a\u0b9a\u0bc8\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 35,000,000 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0bb1\u0bcd \u0baa\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bbe\u0b95\u201d \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba9\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b9a\u0b95\u0bbe\u0bb3\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1 5, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc2\u0bc8\u0ba4\u0ba9\u0b9a\u0bcd \u0b9a\u0b9a\u0bc8\u0bb5\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bc8\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1 6.- \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95 \u0baa\u0b9a\u0bae\u0bb5 \u0b86\u0bae\u0ba3\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1 \u0b85\u0bb2\u0bc1\u0bb5\u0bc8\u0b95\u0bae\u0bcd\n\n\u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01.- \u0b9a\u0b9a\u0baf\u0bb2\u0bcd\u0bae\u0bc1\u0bae\u0bb1\u0b9a\u0bcd \u0b9a\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd -\n\n\u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0b9a\u0b9a\u0bc8\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 295,740,000\n\n\u201c\u0ba4\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1 6, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0b9a\u0b9a\u0bc8\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 295,740,000 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0bb1\u0bcd \u0baa\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bbe\u0b95\u201d \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba9\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b9a\u0b95\u0bbe\u0bb3\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1 6, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0b9a\u0b9a\u0bc8\u0bb5\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bc8\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01.- \u0b9a\u0b9a\u0baf\u0bb2\u0bcd\u0bae\u0bc1\u0bae\u0bb1\u0b9a\u0bcd \u0b9a\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd - \u0bae\u0bc2\u0bc8\u0ba4\u0ba9\u0b9a\u0bcd\n\n\u0b9a\u0b9a\u0bc8\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 8,000,000\n\n\u201c\u0ba4\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1 6, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc2\u0bc8\u0ba4\u0ba9\u0b9a\u0bcd \u0b9a\u0b9a\u0bc8\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 8,000,000 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0bb1\u0bcd \u0baa\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\