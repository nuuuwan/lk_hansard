    "chunk_text": "\u0dad\u0dc0\u0dcf 222 \u0d85\u0dba \u0db4 \u0dc0\u0dd0\u0dba \u0db4 \u0dc1\u0dba \u0db4\u0ddd\u0da2\u0dca\u0dcf \u0d85\u0d82\u0d9a \u0dba \u0db4\u0da7\u0dc1 \u0d9a \u0d85 \u0d9a\u0dba \u0db4\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0dca \u0dc2\u0dca\u0da8 \u0d9a\u0d9a\u0db8\u0dcf\u0dca\u0dad\u0dc1\u0dad \u0db1\u0dd2\u0dba\u0dad \u0d9a\u0dcf\u0dca\u0dad\u0dcf\u0dc0\u0dca \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4 \u0dad 9\u0dda \u200d\u0dbb\u0da2\u0dcf\u0dc0 \u0dca\u0d9a\u0dae\u0dd2\u0d9a \u0dc0 \u0dc1\u0dba \u0db4\u0dca \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc0\u0dd2\u0db6\u0dbd \u0d9c\u0dd0\u0dca\u0dc0\u0dd3\u0db8 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3\u0dc4\u0dcf \u0dc0\u0dd2\u0dc1 \u0dbb\u0dc2\u0dca\u0da8 \u0dc0\u0dd0\u0da9\u0dc3\u0dca\u0dad\u0dca\u200d\u0da7\u0dc4\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0db4\u0dcf \u0d9a\u0db8\u0d9a \u0d9a\u0dd2\u0db8\u0db8\u0da7 9\u0db4\u0dd2\u0dba \u0db4\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dba \u0db4\u0dca 322\u0d9a \u0dc1\u0dc0\u0dca \u0d9a\u0dba \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dba \u0d9a\u0d9a\u0db8\u0dcf\u0dca\u0dad \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba \u0db4 \u0dc0\u0dd2\u0dd2\u0db1\u0dca \u0dc1\u0db4\u0dad \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3\u0dc4\u0dcf \u0d85\u0dcf\u0dcf\u0dc5 \u0db4\u0dcf\u0d9a \u0dbb\u0dc0 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db4\u0dad\u0db6\u0dca\u0db0 \u0d9a\u0dba\u0dc1\u0d9c\u0dca \u0dc0\u0dd0\u0da9\u0dc3\u0dca\u0dad\u0dca\u200d\u0da7\u0dc4\u0dca\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0db4\u0dcf \u0d9a\u0db8\u0d9a \u0d9a\u0dd2\u0db8\u0db8\u0da7 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dd0\u0dbd\u0dc3\u0dd4\u0db4\u0dad \u0d9a\u0dba \u0d87\u0dad. \u0db8\u0dd3\u0da7 \u0d85\u0db8\u0dad\u0dba\u0dc0 222 \u0d85\u0dba \u0db4 \u0dc0\u0dd0\u0dba \u0db4 \u0db8\u0d9f\u0dd2\u0dca \u0d9a\u0dcf\u0dca\u0dad\u0dcf \u0dc5\u0db8\u0dcf \u0d9a\u0da7\u0dad\u0dd4\u0dad\u0dd4 \u0dc4\u0dcf \u0dc3\u0dca\u0dad\u0dca\u200d\u0db8\u0dcf\u0da2 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc0\u0dd2\u0db6\u0dbd\u0d9c\u0dd0\u0dc