    "chunk_text": "\u0dba\u0dc5\u0d9f\u0da7 \u0dc0\u0dd2\u0db0\u0dcf\u0dba \u0db4\u0d9a\u0dba \u0db4 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db4\u0dad\u0db6\u0dca\u0db0\u0dc1\u0dba \u0db4\u0dca \u0dba\u0dc1\u0da7\u0dca \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dca\u0dc1\u0dda \u0d85\u0dc0\u0dd2 \u0dbb\u0dc0\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dba \u0db4 \u0dc1\u0d9c\u0dcf\u0da9\u0dca\u0dd0\u0d9f\u0dd4\u0dc0\u0dcf. \"\u0dc0\u0dd2\u0db0\u0dcf\u0dba \u0db4\u0d9a\u0dba \u0db4 \u0d91\u0db4\u0dcf\" \u0d9a\u0dd2\u0dba \u0db4\u0dbd\u0dcf \u0dc1\u0d9c\u0ddd\u0db0\u0dcf\u0dcf\u0dba \u0db4 \u0dba\u0dcf\u0da2\u0db4\u0d9a\u0dc2\u0dca\u0da8 \u0db8\u0dc4 \u0d9a\u0db8\u0dba \u0db4\u0dcf \u0dc1\u0d9c\u0dcf\u0dba \u0dba \u0db4\u0dc0\u0dca\u0d9a\u0dbd\u0dca\u0db8 \u0d92 \u0dc0\u0dd0\u0dc1\u0da9\u0dca \u0d9a\u0dba\u0dc1\u0d9c\u0dca \u0d9c\u0dd2\u0dba \u0db4\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d92\u0d9a \u0d9a\u0dc1\u0dc5\u0dbb \u0d9a\u0dc0\u0dd4\u0dcf? \u0d85\u0dba pools\u0dc0\u0dbd \u0dc3\u0dca\u0dad\u0dca\u200d\u0db6\u0dca \u0d9c\u0dcf\u0dbd\u0dcf \u0dca\u0dcf \u0daf \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dd4. \u0d92\u0d9a\u0dba\u0dd2 \u0d91\u0dad\u0dd0\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0dca \u0dc0\u0dd0\u0dbb\u0dd0\u0dd2\u0dcf. \u0d92 \u0d85\u0dba \u0db4 \u0dc1 \u0d9a 9\u0db8\u0d9a \u0dca\u0dd0\u0dad\u0dd2 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dd4.\n\n\u0dc1\u0db4\u0dad\u0dc0\u0dcf \u0db4\u0dd2\u0db8\u0dca\u0db4\u0dc3\u0dca\u0dad\u0dca\u200d \u0d9a\u0dc0\u0dd4\u0dcf \u0d89\u0dca\u0dc1\u0dca? \u0d85\u0db4\u0dd2 \u0d92 \u0d9c\u0dd0\u0dca \u0d9a \u0d9a\u0dbd\u0dca\u0db4\u0dca\u0dcf \u0d9a\u0dba\u0dca\u0dca \u0daf 9\u0dd4 \u0dc1\u0dc0\u0dca\u0dca \u0d95\u0dca\u0dd1. \u0d85\u0db4\u0dd2 \u0dc1\u0db4\u0dad\u0dc0\u0dcf \u0dc4\u0dd2\u0dad\u0dca\u0dca \u0d95\u0dca\u0dd1. \u0d85\u0db4\u0dd2 \u0dcf\u0dca\u0dca\u0dc0\u0dcf \u0d9c\u0dca\u200d\u0dbb\u0dd3\u0dd2\u0db1\u0dba \u0db4 \u0db4\u0dad\u0dad\u0dd4\u0d9c\u0dcf\u0dbd\u0dba \u0db4 \u0dca\u0d9a\u0da2\u0dca\u0da7\u0dd2\u0dca\u0dcf\u0dc0 \u0dc0\u0dcf\u0dc1\u0dda \u0dba\u0da7\u0dc0\u0dbd\u0dca \u0dc1\u0db4\u0dad \u0dc0\u0dcf\u0dc1\u0dda \u0dca\u0d9a\u0dae\u0dd2\u0d9a \u0d85\u0d9a\u0db6\u0dd4\u0dcf\u0dc0\u0dbd\u0da7 \u0db8\u0dd4\u0dc4\u0dd4\u0dda \u0dd4\u0dca \u0db6\u0dc0. \u0dcf\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0d9a \u0dc0\u0dd2\u0db4\u0d9a\u0dc2\u0dca\u0da8\u0dba \u0db4 \u0d9a\u0dd2\u0dba \u0db4\u0dca\u0dc0\u0dcf \u0db8\u0dcf \u0d85\u0dc4\u0dc1\u0d9c\u0dca\u0dba\u0dd2 \u0dc1\u0db4\u0dc5\u0d9a \u0dba\u0da7\u0dc0\u0dbd\u0da7 \u0d9a\u0dca\u0dca\u0dc0 \u0d9a \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0da9\u0dd4\u0d9a \u0dca\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba \u0db4\u0dbd\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d85\u0dc1\u0dca \u0dba\u0dc1\u0da7\u0dca \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dd4 \u0dad\u0db8\u0dca\u0dc1\u0dda \u0d9a\u0da7\u0dad\u0dd4\u0dad\u0dd4 \u0dc1\u0d9a\u0dc1\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0dc4\u0ddd\n\n\u0d9a\u0dc5\u0db8\u0dca\u0dcf\u0d9a\u0dba\u0dda\u0dba \u0db4 \u0d9a\u0dba\u0d9c \u0d9a\u0dad\u0dcf. \u0dc1\u0db4\u0dad\u0d9a \u0da2\u0dca\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dad\u0db1\u0dd2\u0dc0\u0db8 \u0d9a\u0dba \u0daf \u0dc1\u0dcf\u0dba \u0db4\u0d9a \u0dc1\u0dca\u0dcf\u0dc1\u0dc0\u0dba\u0dd2. \u0dc1\u0db4\u0dad \u0d9a\u0dd0\u0db4 \u0d9a\u0dd2\u0db8\u0db8 \u0d9a\u0dc1\u0dc5\u0dbb \u0dc1\u0db4\u0dad \u0dba\u0dc1\u0da7\u0dca \u0db8\u0dc4 \u0da2\u0dca\u0dad\u0dcf\u0dc0. \u0db8\u0dc4 \u0da2\u0dca\u0dad\u0dcf\u0dc0 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0db4 \u0d9a\u0dcf\u0dbd\u0dc1\u0dad \u0dc0\u0dd2 \u0dcf\u0dbd \u0d9a\u0dd0\u0db4 \u0d9a\u0dd2\u0db8\u0db8\u0d9a \u0d9a\u0dc5\u0dcf. \u0dc3\u0dca\u0dad\u0dca\u200d\u0db8\u0dc4\u0dba \u0dc1\u0dc0\u0dbd\u0dcf\u0dc0\u0da7 \u0dc1\u0db4\u0ddd\u0dd2\u0db4\u0dad\u0dc0\u0dbd \u0db4\u0dd0\u0dba \u0db4 13\u0d9a \u0db4\u0db8\u0dda \u0dd2\u0db1\u0da7\u0dd2\u0dba \u0db4\u0dcf. \"\u0d85\u0dba\u0d9c\u0dc5\u0dba \u0db4\" \u0db8\u0dd4\u0dc0\u0dcf\u0dc1\u0dc0\u0dca \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dd0\u0db6\u0dd3\u0db4\u0dad \u0d9a\u0dba\u0dca\u0dca \u0d9c\u0dd2\u0dba \u0db4 \u0d9a\u0dcf\u0dbd\u0d9a\u0da9\u0dd4\u0d9a\u0dab\u0dd2 \u0d9c\u0dd0\u0dca \u0dc1\u0dca\u0dcf\u0dc1\u0dc0\u0dba\u0dd2 \u0db8\u0db8 \u0dc1\u0db4\u0dad \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0dca\u0dc1\u0dca. \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dd4 \u0d91\u0dcf\u0dcf \u0db4\u0dcf\u0dba\u0da7 \u0dc1\u0dc0\u0dbd\u0dcf \u0dc1\u0db4\u0ddd\u0dd2\u0db4\u0dad\u0dc0\u0dbd \u0dd2\u0db1\u0da7\u0dd2\u0dba \u0db4\u0dcf. \u0dc1\u0db4\u0dad \u0dba\u0dc1\u0da7\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0dca \u0dc1\u0db4\u0dad \u200d\u0dbb \u0dbb\u0dca \u0d85\u0dba\u0d9c\u0dc5\u0dba \u0db4\u0d9a \u0d9a\u0dba\u0dbd\u0dcf \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d \u0dc1\u0db3\u0dca\u0dc0\u0dcf \u0dca\u0db4\u0dad \u0d85\u0dba\u0d9c\u0dc5\u0dc1\u0dba \u0db4\u0dca \u0db4\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc1\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0d92\u0dc0\u0dcf \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0db3\u0dd2\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0dca\u0dca \u0d95\u0dca\u0dd1. \u0d85\u0dba\u0d9c\u0dc5\u0dc1\u0dba \u0db4\u0dca \u200d\u0dbb \u0dbb\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0db3\u0dca\u0dca \u0db6\u0dd0\u0dc4\u0dd0. \u0dc1\u0d9c\u0dc0\u0dbd\u0dca \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0db6\u0dcf \u200d\u0dbb \u0dbb\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0db3\u0dca\u0dca \u0db6\u0dd0\u0dc4\u0dd0. \u0d92\u0dc0\u0dcf\u0da7 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db4\u0dad\u0db6\u0dca\u0db0 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dca \u0d9a\u0dc0\u0dd4\u0dcf \u0d9a\u0dd2\u0dba \u0db4\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0dcf\u0dd0\u0dca \u0dcf\u0dca\u0dca\u0dc0\u0dcf. \u0d92 \u0dc1\u0d9c\u0dcf\u0dbd\u0dca\u0dbd\u0dca \u0db1\u0dd2\u0dc1\u0dba \u0db4\u0ddd\u0da2\u0dca\u0dba \u0db4 \u0d9a\u0dba\u0dca\u0dc1\u0dca \u0dc1\u0d9a\u0dcf\u0dba\u0dd2 \u0dc1\u0dd2 \u0db4\u0dcf\u0dbd\u0dca \u0db4\u0d9a\u0dc2\u0dca\u0da8 \u0dcf \u0d9a\u0dd2\u0dba \u0db4\u0dbd\u0dcf \u0d9a \u0d85\u0db4\u0dd2 \u0dcf\u0dca\u0dca\u0dc0\u0dcf. \u0dba\u0da7\u0d9a \u0dc4\u0dd0\u0da7\u0dd2\u0dba \u0db4\u0da7 \u0da2\u0dca\u0dad\u0dcf\u0dc0 \u0d9a\u0dd0\u0db4 \u0d9a\u0dd2\u0db8\u0db8\u0d9a \u0d9a\u0dc5\u0dcf. \u0d92 \u0d85\u0dba \u0db4\u0dc1\u0dda \u0d9a\u0dd0\u0db4 \u0d9a\u0dd2\u0db8\u0db8 \u0dba\u0da2\u0dba \u0db4\u0da7 \u0d9a\u0dad\u0dd2\u0dba \u0db4\u0d9a \u0dc0\u0dd4\u0dda\u0dcf. \u0da2\u0dca\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0db8\u0dd4\u0dcf\u0dbd\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dc1\u0dad \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dca \u0db8\u0dc4 \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dca \u0d91\u0d9a\u0d9a\u0dc4\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf \u0d91\u0d9a \u0d9a\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba \u0db4\u0db8\u0d9a \u0dc4\u0dd0\u0da7\u0dd2\u0dba \u0db4\u0da7 \u0d8b\u0dcf\u0dc0\u0dd4 \u0d9a\u0dc5\u0dcf. \u0dc1\u0db4\u0dad \u0db4\u0dcf\u0d9a\u0dd2\u0dc1\u0db4\u0dad\u0dca\u0dad\u0dd4\u0dc0 \u0dad\u0dd4\u0dc5 \u0d9a \u0d92 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0dc1\u0dba \u0db4\u0ddd\u0d9c\u0dba \u0db4 \u0d85\u0dc0 \u0dba \u0dc1\u0dc0\u0dca\u0dc0\u0dcf. \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0da7\u0dca \u0dca\u0dba \u0db4\u0dad\u0dca\u0dba \u0db4 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db4\u0dad\u0db6\u0dca\u0db0 \u0dd2\u0db1\u0dd2\u0db0\u0dd2\u0dc1\u0dad\u0daf\u0dd3 \u0d85\u0db4\u0dd2 - \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4 \u0dc0\u0dd2\u0db4\u0d9a\u0dc2\u0dca\u0da8\u0dba \u0db4 - \u0d94\u0d9a\u0dc1\u0d9a\u0dcf\u0db8 \u0d91\u0d9a\u0da7 \u0d91\u0d9a\u0d9a\u0dc4\u0dd4 \u0dc0\u0dd4\u0dda\u0dcf. \u0d91\u0d9a\u0da7 \u0d91\u0d9a\u0d9a\u0dc4\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf \u0dc1\u0db4\u0dad \u0dc1\u0db4\u0dad \u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0db4\u0da7 \u0d9a\u0da7\u0dad\u0dd4\u0dad\u0dd4 \u0d9a\u0dc5 \u0dad\u0dd4\u0dad\u0dd4\u0dba\u0dd2 \u0d9a\u0dd2\u0dba \u0db4\u0dca\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0dba\u0dbb\u0dcf\u0dba \u0db4\u0dbd\u0dca-\u0db4\u0dbd\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dbb\u0dab\u0dca \u200d\u0dbb \u0dbb\u0dca\u0dc1\u0dad\u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0d94\u0d9a\u0dc1\u0d9a\u0dcf\u0db8 \u0d91\u0d9a\u0d9a\u0dc4\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf \u0dc1\u0dba \u0db4\u0ddd\u0da2\u0dca\u0dcf \u0dc3\u0dca\u0dad\u0dca\u200d\u0db4\u0dad\u0db8\u0dad \u0d9a\u0dc5\u0dcf. \u0d91\u0dc1\u0dc4\u0db8 \u0dca\u0db4\u0dad \u0dc1\u0db4\u0dad \u0dba\u0dc1\u0da7\u0dca \u0dca\u0d9a\u0dae\u0dd2\u0d9a\u0dba \u0db4 \u0dc1\u0d9c\u0dcf\u0da9 \u0d9c\u0dca\u0dca \u0d85\u0db4 \u0d94\u0d9a\u0dc1\u0d9a\u0dcf\u0da7\u0db8 \u0d91\u0d9a\u0d9a\u0dc4\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf \u0d9a\u0da7\u0dad\u0dd4\u0dad\u0dd4 \u0d9a\u0dba\u0dca\u0dca \u0db6\u0dd0\u0dbb\u0dd2 \u0d87\u0dba\u0dd2?"
