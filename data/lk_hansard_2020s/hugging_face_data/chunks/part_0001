    "chunk_text": "\u0daf\u0db1\u0dba \u0d86\u0dcf\u0daf\u0d9a\u0dcf \u0dc0\u0dd2 \u0daf\u0d9a \u0dc0\u0dca\u200d \u0dc1\u0d9a\u0dca \u0d85\u0da9\u0dd4 \u0dc0\u0dd4\u0dab\u0dd4 \u0dd2\u0dbb\u0dca\u0daf \u0da7\u0da7 \u0d85\u0dc0\u0dca\u200d \u0dba \u0daf\u0dca\u0db0\u0dca\u200d\u0dca \u0dca\u0dc4 \u0d96\u0dc2\u0db0\u0dca\u200d \u0d86\u0daf\u0dd3 \u0d85\u0dad\u0dba\u0dc0\u0dca\u200d \u0dba \u0dc1\u0dc1\u0dc0\u0dca\u200d\u0dbd\u0dca \u0d86\u0dca\u0d9a\u0dca\u0d9a \u0dd2\u0dbb\u0dd3\u0db8\u0dc1 \u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0dc1\u0da9\u0ddc\u0d9a\u0d9a \u0dc4\u0dd2 \u0d9a \u0da7 \u0db8\u0dd4\u0dc4\u0dd4\u0dab \u0daf\u0dd4\u0dca\u0dca\u0daf. \u0dc0\u0dca\u200d\u0daf\u0dc1 \u0dcf \u0daf\u0d9a \u0dc3\u0dd3\u0dcf\u0daf\u0dc0\u0dca\u200d \u0dad\u0dd4\u0dc5 \u0d87\u0dd2\u0dbb \u0dc0\u0dd4\u0dab\u0dd4 \u0d85\u0d9a\u0db6\u0dd4\u0dcf\u0d9a \u0dd2\u0dbb\u0dca\u0daf \u0dc5 \u0dcf\u0dc4\u0db1\u0dca \u0d8b\u0dc1\u0dc1\u0d9d\u0ddd\u0dc2\u0dab \u0d85\u0dc0\u0dca\u200d\u0dca\u0daf\u0dca\u0dc1\u0dba\u0dca\u0daf\u0dd3 \u0dc0\u0dd2 \u0daf\u0d9a \u0d85 \u0d9c\u0dc5\u0d9a\u0d9a\u0dca \u0db3\u0dc0\u0dca\u200d\u0da7 \u0db4\u0dca, \u0dc1\u0dc0\u0dca\u200d\u0d9a\u0daf \u0dc1 \u0dc1\u0da7\u0dca \u0db1\u0dca\u0daf\u0db0\u0dd2\u0db4\u0dd2\u0dbb\u0dc0\u0dca\u200d \u0d9a\u0daf \u0dc4\u0dd0\u0dc3\u0dca\u0d9a\u0da7 \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0db8\u0dd2\u0dca \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dc1\u0d9c\u0ddd\u0db0\u0daf\u0dcf\u0d9a \u0daf\u0db1\u0db4\u0d9a\u0dca\u0dc2 \u0dcf\u0dd0\u0dd2\u0dbb\u0dad\u0dd4\u0dcf\u0daf\u0da7 \u0db1\u0dca\u0daf\u0db0\u0dd2\u0db4\u0dd2\u0dbb \u0db0\u0dd4 \u0d9a \u0d85\u0dca,\u0dc4\u0dd0 \u0d9a\u0daf \u0d9a\u0dca\u0dca \u0dd2\u0dba\u0dc1\u0db0\u0dca\u200d \u0dc0\u0dd4\u0dab\u0daf.\n\n\u0db8\u0dd6\u0d9a\u0daf\u0dca\u0dca\u0daf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0dcf\u0dd2\u0dbb \u0dd2\u0dbb\u0dcf\u0dc4\u0dd2\u0dba\u0dca \u0db4\u0dca\u0dae\u0dc1\u0dca\u0dda \u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0db4\u0dca, \u0dca \u0d9a\u0dcf \u0d85\u0d9a \u0dc0\u0dca\u200d\u0dd0\u0d9a \u0dc1\u0dbd\u0dca\u0d9b\u0dca \u0dd2\u0dbb\u0dc4\u0daf \u0db3\u0dd0\u0dbd\u0dd4\u0dc0\u0dca\u200d\u0daf\u0dcf \u0d85\u0db4\u0dd2 \u0dcf\u0dca\u0dca\u0dc0\u0dca\u200d\u0daf \u0dc4\u0dd0\u0dcf \u0d85\u0dc0\u0dca\u200d\u0dca\u0dae\u0dcf\u0daf\u0dc0\u0dca\u200d \u0dcf -\u0dc4\u0dd0\u0dcf \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0dcf \u0dcf- \u0d85\u0d9a \u0dc0\u0dca\u200d\u0dd0\u0d9a \u0dc4\u0dd2 \u0d9a\u0d9a\u0dca \u0db4\u0dd0\u0dc0\u0dca\u200d\u0dd2\u0dbb\u0d9a\u0daf \u0dd2\u0dbb\u0dc1\u0db3\u0dca \u0db3\u0dc0\u0dca\u200d. \u0d85\u0dc0\u0dca\u200d\u0dca\u0dae\u0dcf\u0daf \u0dd2\u0dbb\u0dc4\u0dd2\u0db4\u0d9a \u0daf\u0dd3 \u0dc4\u0dd0 \u0d85\u0d9a \u0dc0\u0dca\u200d\u0dd0\u0d9a \u0dc4\u0dd2 \u0d9a \u0dd2\u0dbb\u0d9a\u0dca \u0dd2\u0dbb\u0d9c\u0da7\u0dcf \u0db4\u0dd0\u0dc0\u0dca\u200d\u0dad\u0dd4\u0dab\u0daf. \u0dc1 \u0d85\u0d9a \u0dc0\u0dca\u200d\u0dd0\u0d9a \u0dc4\u0dd2 \u0d9a \u0db4\u0dd2\u0d9a\u0dc0\u0dca\u200d\u0daf \u0d9c\u0dd0\u0db1\u0dd3\u0dcf \u0dca\u0db3\u0dc4\u0daf \u0dc0\u0dd2\u0dc1\u0dc1 \u0da7\u0dc0\u0dca\u200d\u0dbd\u0dd2\u0dca \u0dab\u0d9a \u0d9a\u0db3\u0daf \u0d9c\u0dca,\u0dad\u0daf. \u0dc0\u0dca\u200d\u0daf\u0dc1 \u0dcf \u0dc1\u0dc1\u0dc1\u0dd3\u0d9a \u0d85 \u0db8\u0dd4\u0dcf\u0dbd\u0dca\u0dc0\u0dca\u200d\u0dbd\u0dd2\u0dca \u0dab\u0d9a \u0d9a\u0db3\u0daf \u0d9c\u0dca,\u0dad \u0d85\u0dc0\u0dca\u200d\u0dca\u0dae\u0dcf\u0daf\u0dca, \u0dc1\u0db3\u0ddc\u0dc1\u0dc4\u0ddc\u0dcf\u0d9a\u0d9a\u0dca \u0dd2\u0dbb\u0dc1\u0db3\u0dca\u0dc0\u0dca\u200d\u0daf. \u0d85\u0db4\u0dd2 \u0dd2\u0dbb\u0dcf\u0dc4\u0dca\u0dae\n\n\u0d85\u0db0\u0dca\u200d\u0dba\u0daf\u0db4\u0dca\u0d9a \u0dad\u0dd4\u0dd2\u0db6\u0dca \u0d85\u0dc1\u0da7\u0dd2 \u0dc1\u0da7\u0dca \u0dcf\u0dbb\u0dd4\u0dc0\u0dca\u200d\u0dca\u0da7 \u0dc1\u0dca\u0ddc\u0db8\u0dd2\u0dc1\u0dbd\u0dca \u0d85\u0db0\u0dca\u200d\u0dba\u0daf\u0db4\u0dca\u0d9a \u0d9a\u0db3\u0daf \u0dc1\u0dcf\u0dca\u0dc0\u0dca\u200d\u0daf. \u0dc0\u0dca\u200d\u0daf\u0dc1 \u0dcf \u0da7\u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0d9a\u0da7 \u0dc1\u0dca\u0dde\u0d9b\u0dba \u0db4\u0dc4\u0da2\u0dd3 \u0dc1\u0dca\u0ddc\u0db8\u0dd2\u0dc1\u0dbd\u0dca \u0d9a\u0db3\u0daf \u0dc1\u0dcf\u0dca\u0dc0\u0dca\u200d\u0daf. \u0dca\u0dcf\u0dd8\u0dc1\u0db0\u0dd2 \u0daf\u0dd3\u0dcf\u0dca\u0daf\u0dc0\u0dca\u200d\u0dca, \u0dc1\u0db4\u0ddc\u0dc1\u0dc4\u0ddc \u0dca\u0dc4\u0dca\u0daf\u0db0\u0dca\u200d\u0daf \u0d9a\u0dca, \u0d85\u0db4\u0dd2 \u0dd2\u0dbb\u0d9a\u0dca \u0dd2\u0dbb\u0d9c\u0da7\u0dcf \u0d9a\u0db3\u0daf \u0daf\u0dd4\u0dca\u0dca\u0daf. \u0dc1 \u0dc1\u0dc0\u0dca\u200d\u0dca\u0dc1 \u0ddc\u0da7\u0dca, \u0dca\u0db3\u0dc4\u0daf \u0dc1\u0d9c\u0ddc\u0dc0\u0dd3\u0dca\u0dc1 \u0d9a\u0dab\u0dd4 \u0dc0\u0dca\u200d\u0d9a\u0da7 \u0db8\u0dd4\u0dcf\u0dbd\u0dca \u0db3\u0dd0 \u0dca\u0dc0\u0dca\u200d\u0daf. \u0dc0\u0dca\u200d\u0daf\u0dc1 \u0dcf \u0d86\u0db3\u0daf\u0db0\u0dd2\u0dad \u0d85\u0d9a\u0da7 \u0d86\u0db3\u0daf\u0db0\u0dd2\u0dad \u0daf\u0dd3\u0dcf\u0dca\u0daf\u0dc0\u0dca\u200d \u0dc0\u0dca\u200d\u0d9a\u0dd4\u0d9c\u0da9\u0dd4 \u0dc1 \u0ddd \u0dc0\u0dca\u0da7 \u0dc0\u0dca\u200d\u0d9a\u0dd4\u0d9c\u0da9\u0dd4 \u0daf\u0dd3\u0dcf\u0dca\u0daf\u0dc0\u0dca\u200d \u0dca\u0dc4 \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dd2\u0dc4\u0dd2\u0dc3\u0dca \u0daf\u0dd3\u0dcf\u0dca\u0daf\u0dc0\u0dca\u200d \u0d86\u0daf\u0dd3 \u0dc0\u0dca\u200d \u0dc1\u0d9a\u0dca \u0dc0\u0dd2 \u0daf\u0d9a \u0da2\u0dd3\u0db3\u0dca\u0daf\u0db0\u0dca\u200d \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dca \u0da7\u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0d9a\u0da7 \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dd4\u0dc1\u0dc0\u0dca\u200d\u0dca \u0dc0\u0dd2 \u0daf\u0d9a \u0db8\u0dd4\u0dcf\u0d9a\u0d9a\u0dca \u0dcf \u0dca\u0dca \u0d85\u0db4\u0da7 \u0dd2\u0dba\u0dc1\u0db0\u0dca\u200d \u0dc1\u0dc0\u0dca\u200d\u0dca\u0dc0\u0dca\u200d\u0daf. \u0db4\u0da2\u0dd3\u0d9a\u0d9a \u0daf\u0d9a\u0d9a \u0dad\u0dd4\u0dc5\u0daf\u0dd3\u0dca, \u0dc0\u0dd2\u0d9a\u0dcf \u0dcf \u0dca\u0dca \u0d85\u0dc1\u0da7\u0dd2 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dca\u200d \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc5\u0daf. \u0dc0\u0dca\u200d\u0daf\u0dc1 \u0dcf 2024 \u0d85\u0d9a \u0dc0\u0dca\u200d\u0dd0\u0d9a \u0dad\u0dd4\u0dd2\u0db6\u0db1\u0dd4\u0dca, \u0dc0\u0dca\u200d\u0daf \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dd4\u0dc1\u0dc0\u0dca\u200d\u0dca \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dd2 \u0db8\u0dd4\u0dcf\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dab\u0d9a\u0d9a\u0dca \u0dc1\u0dc0\u0dca\u200d\u0dca \u0dca\u0dca\u0dca, \u0d9c\u0dbb\u0dd4 \u0db1\u0dca\u0daf\u0db0\u0dd2\u0db4\u0dd2\u0dbb\u0dad\u0dd4\u0dcf\u0daf \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dd2\u0dbb\u0dc1\u0db3\u0dca\u0dc0\u0dca\u200d\u0daf."
