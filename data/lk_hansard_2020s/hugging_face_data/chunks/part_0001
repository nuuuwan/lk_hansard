    "chunk_text": "\u0db8\u0dca\u0dd3\u0dc0 9 225\u0dc1\u0dcf\u0dc1\u0dca\u0d9a \u0dc1\u0db4\u0dad \u0db4\u0dcf\u0d9a\u0dd2\u0dc1\u0db4\u0dad\u0dca\u0dad\u0dd4\u0dc0 \u0db1\u0dd2\u0dc1\u0dba \u0db4\u0ddd\u0da2\u0dca\u0dba \u0db4 \u0d9a\u0dba\u0dca\u0dc0\u0dcf. \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dbd\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dd4\u0dc1\u0dc0\u0dca \u0db4 \u0d9a \u0dc0\u0dca \u0db8\u0dca\u0dd3\u0dc0 9 \u0dc4\u0dd0\u0dc1\u0dba\u0dca\u0dca \u0d85\u0dc1\u0dca\u0d9a \u0db8\u0dca\u0dd3\u0dc0 9 \u0dd2\u0db1\u0dba \u0db4\u0dbd\u0dd4\u0dc1\u0dcf\u0dca\u0dcf\u0db8 \u0db8\u0dc4\u0da2\u0dca\u0dad\u0dcf\u0dc0\u0dc1\u0dda \u0da1\u0dca\u0dcf\u0dc1\u0dba \u0db4\u0dca \u0db4 \u0d9a \u0dc1\u0dc0\u0dca\u0dc1\u0dca. \u0dad\u0db8\u0dca\u0dc1\u0dda \u0dc1\u0d9a\u0dcf\u0da7\u0dca\u0db0\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d \u0d85\u0db1\u0dd4\u0dc0 \u0d92 \u0db8\u0dca\u0dd3\u0dc0 9 \u0db8\u0dd2\u0dd2\u0dba \u0db4\u0dca 21\u0d9a \u0da2\u0dca\u0dad\u0dcf\u0dc0 \u0db1\u0dd2\u0dc1\u0dba \u0db4\u0ddd\u0da2\u0dca\u0dba \u0db4 \u0d9a\u0dba\u0dca\u0dc0\u0dcf. \u0db8\u0dc4\u0da2\u0dca \u0db1\u0dd2\u0dc1\u0dba \u0db4\u0ddd\u0dd2\u0d9a\u0dad\u0dba \u0db4\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0db4\u0da7 \u0dc0\u0dad \u0d9a\u0dad\u0dd2\u0d9a\u0dc1\u0dba \u0db4\u0ddd \u0d91\u0dca\u0dc0\u0dcf \u0dad\u0dc0\u0dcf\u0dba\u0dc0 9 \u0d91\u0dca\u0dc0\u0dcf \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dc1\u0dba \u0db4\u0ddd \u0d91\u0dca\u0dc0\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0d9a\u0dc1\u0dba \u0db4\u0ddd \u0d91\u0dca\u0dc0\u0dcf. \u0d91\u0d9a \u0d91\u0d9a \u0d9a\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba \u0db4\u0db4\u0dad \u0db4\u0dcf\u0d9a\u0dd2\u0dc1\u0db4\u0dad\u0dca\u0dad\u0dd4\u0dc0 \u0db1\u0dd2\u0dc1\u0dba \u0db4\u0ddd\u0da2\u0dca\u0dba \u0db4 \u0d9a\u0dba\u0dca\u0dc0\u0dcf. \u0dca\u0daf\u0dd2\u0dc0\u0dcf\u0dc3\u0dd3\u0dca\u0dc1\u0d9c\u0db1\u0dd4 \u0d9a \u0d91\u0dca\u0dca \u0d95\u0dca\u0dd1. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 225\u0dc1\u0dcf\u0dca\u0dcf\u0db8 \u0dc0\u0dd2\u0dba \u0db4\u0dad\u0dd4\u0dca \u0d8b\u0d9c\u0dad\u0dd4\u0dca \u0d9a\u0dd2\u0dba \u0db4\u0dcf\u0dc1\u0d9c\u0dca \u0dca \u0dad\u0dd4\u0dad\u0dd4\u0dba\u0dd2 \u0d9a\u0dd2\u0dba \u0db4\u0dbd\u0dcf \u0db8\u0db8 \u0dc0\u0dd2 \u0dbb\u0dc0\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d \u0d9a\u0dba\u0dca\u0dc1\u0dca \u0dca\u0dd0\u0dc4\u0dd0. \u0d92 \u0d92 \u0dc1\u0d9a\u0dcf\u0da7\u0dca\u0db0\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dc0\u0dbd \u0dad\u0dd2\u0dc1\u0db6\u0dca \u0dc3\u0dca\u0dad\u0dca\u200d\u0db8\u0dcf\u0da2 \u0d9c\u0dd0\u0da7\u0dbd\u0dd4 \u0d9c\u0dd0\u0dca \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0dca\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0db4\u0dcf\u0d9a\u0dd2\u0dc1\u0db4\u0dad\u0dca\u0dad\u0dd4\u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0dca\u0dc1\u0dca. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0db4\u0dcf\u0d9a\u0dd2\u0dc1\u0db4\u0dad\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0dca\u0dc0\u0dcf\u0db8 \u0dc0\u0dd2\u0dba \u0db4\u0dad\u0dd4\u0dca \u0d8b\u0d9c\u0dad\u0dd4\u0dca \u0d85\u0db4\u0dd2 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db4\u0dad\u0db6\u0dca\u0db0 \u0d9a\u0dba\u0dc1\u0d9c\u0dca \u0dc1\u0db4\u0dad \u0dba\u0da7 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0dca \u0dba\u0dcf\u0da2\u0dba \u0dca\u0dba \u0db4\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0dca\u0dba \u0db4 \u0d9a\u0dba\u0dca \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5 \u0dc4\u0dcf\u0dca\u0dca \u0d95\u0dca\u0dd1.\n\n\u0d9c 9 \u0dca\u0da0\u0dcf\u0d9a\u0dba \u0db4 \u0dc4\u0d9a\u0dc2\u0dca\u0da8 \u0dcf \u0dd2\u0db1\u0dbd\u0dca\u0dc0\u0dcf \u0db8\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dcf \u0d9a \u0dcf\u0dca\u0dca\u0dcf \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dc1\u0dad \u0d89\u0db3\u0dbd\u0dcf \u0d85\u0dc1\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba \u0db4\u0da7\u0dc1 \u0d9a \u0dad\u0dd2\u0dc1\u0db6\u0dca \u0dca\u0dba \u0db4\u0dad\u0dca\u0dc0\u0dbd \u0d85\u0db0\u0dba\u0d9a\u0dc2\u0dca\u0da8 \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0dc0\u0dbd \u0dba\u0dcf\u0da2\u0dba \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dca \u0d89\u0dca\u0dca\u0dc0\u0dcf; \u0db8\u0dd4\u0dcf\u0dbd\u0dca\n\n1009 1010\n\n\u0db4\u0dcf\u0d9a\u0dd2\u0dc1\u0db4\u0dad\u0dca\u0dad\u0dd4\u0dc0\n\n\u0d9c 9 \u0db1\u0dd2\u0dc1\u0dba \u0db4\u0ddd\u0da2\u0dba \u0d9a\u0dae\u0dcf\u0dca\u0dcf\u0dba \u0db4\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dc4\u0dd0\u0dc1\u0db8\u0ddd\u0db8 \u0db8\u0dc4 \u0dc1\u0dbd\u0dcf\u0d9a\u0dd4\u0dc0\u0da7 \u0d9a\u0dd2\u0dba \u0db4\u0dca\u0dc0\u0dcf \u0dc1\u0db4\u0dad \u0dba\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0dca\u0dc1\u0dca \u0d9a\u0dd4\u0dbd\u0dd4\u0dab\u0dd4 \u0dad\u0dd4\u0dca\u0d9a \u0d8b\u0da9 \u0d9a\u0dd2\u0dba \u0db4\u0dbd\u0dcf. \u0d92\u0dc0\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0dc0\u0dd2\u0db0\u0dcf\u0dba \u0db4\u0d9a\u0dba \u0db4 \u0dc0\u0dba\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae\u0dcf\u0dcf\u0dcf\u0dba \u0db4\u0d9a\u0dba \u0db4 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4 \u0d85\u0db0\u0dd2\u0d9a\u0dba\u0dda\u0dba \u0db4. \u0dba\u0da7\u0d9a \u0dc0\u0da7\u0dca\u0da7\u0dca\u0dca \u0dca\u0db4\u0dad \u0dc1\u0db4\u0dad \u0dad\u0dd4\u0dca\u0db8 \u0dc0\u0dd2\u0dca\u0dcf \u0d9a\u0dba\u0dca\u0dca \u0d95\u0dca\u0dd1. \u0d92 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3\u0dc4\u0dcf \u0dc3\u0dca\u0dad\u0dca\u200d\u0db8\u0dc4\u0dba \u0dba\u0dcf\u0da2\u0dba \u0dc1\u0dca\u0dcf\u0dc0\u0dca \u0dc3\u0dca\u0dad\u0dca\u200d\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0dca\u0dc0\u0dbd\u0da7 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbd\u0dca\u0dd2 \u0dbd\u0dd0\u0db6\u0dd4\u0dda\u0dcf. \u0d92 \u0d85\u0dba \u0db4 \u0d92 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3\u0dc4\u0dcf \u0dc1\u0db8\u0dc1\u0dc4\u0dad\u0dd4\u0db4\u0dad \u0d9a\u0dc5\u0dcf. \u0db4\u0dc3\u0dd4 \u0d9c\u0dd2\u0dba \u0db4 \u0d9a\u0dcf\u0dbd\u0dba \u0db4 \u0daf\u0dba\u0dcf \u200d\u0dbb\u0db8\u0dcf\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0\u0dba\u0dd2 \u0d91\u0dba \u0db4 \u0dd2\u0db1\u0dd4 \u0dc0\u0dd4\u0dc1\u0da9\u0dd4\u0d9a. \u0d92\u0d9a \u0d91\u0d9a \u0db4\u0dcf\u0dba\u0da7\u0db8 \u0daf \u0daf\u0dba\u0dcf \u0d9c\u0dd2\u0dca\u0dca\u0d9a \u0d87\u0dad\u0dd2 \u0dc0\u0dd4\u0dda\u0dcf \u0dc0\u0dcf\u0dc1\u0dda \u0dc1\u0dc0\u0da0\u0dd2 \u0da0 \u0dc1\u0dcf\u0dba \u0db4\u0d9a \u0dc1\u0dca\u0dcf\u0dc1\u0dc0\u0dba\u0dd2. \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0db4 \u0d9a\u0dcf\u0dbd\u0dc1\u0dad \u0d92\u0dc0\u0dcf \u0dc3\u0dca\u0dad\u0dca\u200d\u0dd0\u0dbd\u0dc3\u0dd4\u0db4\u0dad\u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0d9c\u0dad\u0dc0 \u0dd2\u0db1\u0dd4 \u0dc0\u0dd4\u0dda\u0dcf. \u0dc1\u0db6\u0db1\u0dd2\u0db0\u0dcf\u0d9c\u0db8 \u0d9c\u0dd0\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0dca \u0dc0\u0dd2 \u0dbb\u0dc0\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dba \u0db4 \u0dca\u0dd0\u0dad\u0dd2 \u0d9a\u0dba\u0dca\u0dca \u0dc4\u0dcf\u0db8\u0dd4\u0dd4 9\u0dc0 9\u0dca\u0dc1\u0dda \u0dc0\u0dd0\u0dba\u0daf\u0dd2 \u0dc1\u0dd2\u0dc0\u0dbd\u0dca - \u0dc4\u0dcf\u0dbd\u0dcf \u0dc1\u0dc4\u0ddd \u0d87 \u0d9a\u0dad \u0d92\u0dc0\u0dcf \u0dc1\u0dc4\u0ddd - \u0dc3\u0dca\u0dad\u0dca\u200d\u0db8\u0dcf\u0da2 \u0db8\u0dcf\u0db0\u0dba\u0dc0\u0dd2\u0dca \u0dc1\u0db6\u0dcf\u0dc1\u0dc4\u0ddd \u0dc1\u0dc3\u0dca\u0dad\u0dca\u200d\u0dba\u0dd2\u0dca \u200d\u0dbb\u0da0\u0dcf\u0dba\u0dba \u0db4 \u0d9a\u0dc5\u0dcf. \u0dc1\u0db4\u0dad \u0dba\u0dc1\u0da7\u0dca \u0dad 9\u0dda \u0db4\u0dba \u0daf\u0dba\u0da7 \u0db4\u0dca\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbd\u0da7 \u0dba \u0db4\u0dca\u0dca \u0d91\u0db4\u0dcf\u0dc1\u0d9a\u0dc1\u0dba \u0dc1 \u0d92 \u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0db4\u0da7. \u0d91\u0dc1\u0dc4\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0dba\u0da7\u0d9a \u0dc0\u0dd2\u0dca\u0dcf \u0d9a\u0dba\u0dca\u0dca \u0dca\u0db4\u0dad \u0d92 \u0dba\u0dc1\u0da7\u0dca \u0dc3\u0dca\u0dad\u0dca\u200d\u0d82\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dad\u0dad\u0dd2\u0dba \u0db4 \u0d9a \u0dc0\u0dd2\u0dca\u0dcf \u0d9a\u0dba\u0dca\u0dca \u0d95\u0dca\u0dd1 \u0dc1\u0dca. \u0d92 \u0db1\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dcf \u0db8\u0dd4\u0dd2\u0dca\u0db8 \u0dc1\u0db4\u0dad \u0dba\u0dc1\u0da7\u0dca \u0dc3\u0dca\u0dad\u0dca\u200d\u0d82\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0d9a\u0dad\u0dad\u0dd2\u0dba \u0db4\u0da7 \u0d9c\u0dc4\u0dbd\u0dcf \u0d89\u0dc0\u0dba \u0d9a\u0dc5\u0dcf.\n\n\u0dba\u0dc5\u0d9f\u0da7 \u0dc0\u0dd2\u0db0\u0dcf\u0dba \u0db4\u0d9a\u0dba \u0db4 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db4\u0dad\u0db6\u0dca\u0db0\u0dc1\u0dba \u0db4\u0dca \u0dba\u0dc1\u0da7\u0dca \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dca\u0dc1\u0dda \u0d85\u0dc0\u0dd2 \u0dbb\u0dc0\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dba \u0db4 \u0dc1\u0d9c\u0dcf\u0da9\u0dca\u0dd0\u0d9f\u0dd4\u0dc0\u0dcf. \"\u0dc0\u0dd2\u0db0\u0dcf\u0dba \u0db4\u0d9a\u0dba \u0db4 \u0d91\u0db4\u0dcf\" \u0d9a\u0dd2\u0dba \u0db4\u0dbd\u0dcf \u0dc1\u0d9c\u0ddd\u0db0\u0dcf\u0dcf\u0dba \u0db4 \u0dba\u0dcf\u0da2\u0db4\u0d9a\u0dc2\u0dca\u0da8 \u0db8\u0dc4 \u0d9a\u0db8\u0dba \u0db4\u0dcf \u0dc1\u0d9c\u0dcf\u0dba \u0dba \u0db4\u0dc0\u0dca\u0d9a\u0dbd\u0dca\u0db8 \u0d92 \u0dc0\u0dd0\u0dc1\u0da9\u0dca \u0d9a\u0dba\u0dc1\u0d9c\u0dca \u0d9c\u0dd2\u0dba \u0db4\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d92\u0d9a \u0d9a\u0dc1\u0dc5\u0dbb \u0d9a\u0dc0\u0dd4\u0dcf? \u0d85\u0dba pools\u0dc0\u0dbd \u0dc3\u0dca\u0dad\u0dca\u200d\u0db6\u0dca \u0d9c\u0dcf\u0dbd\u0dcf \u0dca\u0dcf \u0daf \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dd4. \u0d92\u0d9a\u0dba\u0dd2 \u0d91\u0dad\u0dd0\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0dca \u0dc0\u0dd0\u0dbb\u0dd0\u0dd2\u0dcf. \u0d92 \u0d85\u0dba \u0db4 \u0dc1 \u0d9a 9\u0db8\u0d9a \u0dca\u0dd0\u0dad\u0dd2 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dd4."
