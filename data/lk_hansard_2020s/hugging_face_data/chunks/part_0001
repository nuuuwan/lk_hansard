0dd2\u0d9a \u0dab \u0dca\u200d\u0dbb \u0d86\u0dc3\u0d82\u0dc3\u0dcf\u0dab\u0dba \u0db1\u0dd2\u0dc3\u0dd2 2023 \u0da2\u0dca\u0dc0\u0dd2\u0dd2\u0db4 \u0dc1\u0dc0\u0dc1\u0daf\u0dd3 \u0d8b\u0dc1\u0db0\u0dca\u200d\u0dbb\u0dca\u0dc0 \u0db1\u0dca\u0dc0\u0dc0\u0da7 51 7\u0dab\u0da7 \u0d85\u0da9\u0dd4 \u0dc0\u0dd4 \u0dd2 2023 \u0da2\u0dd4\u0db1\u0dd2 \u0dbb\u0dd2\u0dc3\u0dc0 \u0dc1\u0dc0\u0dc1\u0daf\u0dd3 \u0db1\u0dca\u0dc0\u0dc0\u0da7 12\u0dab\u0da7 \u0d85\u0da9\u0dd4 \u0dc0\u0dd4 \u0dd2 2023 \u0d94 \u0d9c\u0dc1\u0dad\u0ddd\u0dbd\u0dae\u0dd2 \u0dbb\u0dd2\u0dc3\u0dc0 \u0dc1\u0dc0\u0dc1\u0daf\u0dd3 \u0db1\u0dca\u0dc0\u0dc0\u0da7 1 5\u0dab\u0da7 \u0d85\u0da9\u0dd4 \u0dc0\u0dd4 \u0dd2 \u0dca\u0dbb\u0dd2\u0dba \u0d8b\u0dc1\u0db0\u0dca\u200d\u0dbb\u0dca\u0dc0 \u0db1\u0dca\u0dc0\u0dc0\u0da7 \u0d8d 5\u0dab \u0dbb\u0da7\u0dca\u0da7\u0dbb \u0da7 \u0d9c\u0dc0\u0dd2 \u0d9a\u0dc0\u0dc0\u0dd2 \u0d92\u0dc1\u0dab \u0db1 \u0dca\u200d\u0dbb\u0db0\u0dca\u200d\u0dd2\u0dca \u0dc0 \u0dc1\u0dc0 \u0db1 \u0dca\u0dae\u0dd2\u0d9a \u0dab\u0dc1 \u0dc3\u0dcf\u0dcf\u0dd2\u0dc0\u0dba\u0dca\u0dad\u0dc0\u0dc0 \u0dc1\u0db4 \u0db1\u0dd4\u0dc0 \u0d9a \u0dab\u0dba\u0dca\u0dc0\u0dd2 \u0d92 \u0dc0\u0dd2\u0dc1\u0daf\u0dbb \u0dad\u0dc0 \u0dc1\u0db4 \u0db1\u0dd4\u0dc0 \u0d9a \u0dab\u0dba\u0dca\u0dc0\u0dd2 \u0dbd\u0da9\u0dd4 .\u0dbd \u0dc0\u0dd3\u0da9\u0dd2 \u0dc1\u0dc0\u0dca \u0dc1 \u0dd2\u0dc0 \u0d9a\u0dca\u200d\u0dbb\u0dbb\u0dd2\u0dd4\u0dc0\u0d9a\u0dd6\u0dbd\u0dc0 \u0d85\u0da9\u0dd4 \u0dc1\u0dc0\u0dbd\u0dd2 \u0d8b\u0dc1\u0db0\u0dca\u200d\u0dbb\u0dca\u0dc0 \u0dc3\u0dcf\u0dcf\u0dd2\u0dc0\u0dba\u0dca\u0dad\u0dc0\u0dc0 \u0d9c \u0dbd\u0dc0\u0da7 \u0db4\u0dca\u0dad \u0dc0\u0dd3\u0dbb \u0dc0 \u0dc0\u0dca \u0dab\u0dd2\u0dba \u0dc0\n\n\u0d85\u0db4\u0da7 \u0dbd\u0dba\u0db4\u0dad\u0dc5\u0dbb \u0dd3\u0da9\u0da9\u0dca\u0dc0 \u0d9c \u0dd9\u0dda\u0dbd \u0dc0\u0dd4\u0dc1\u0dab\u0dca \u0dc3\u0dd2\u0db1\u0dd2\u0dbb\u0dc0 \u0d85\u0dd4\u0dc0\u0db4\u0dd2\u0dad\u0dc0\u0dca\u0dad \u0dd9 \u0d9c\u0dab \u0dc1\u0dc0\u0dc1\u0dc5\u0db3 \u0dc1