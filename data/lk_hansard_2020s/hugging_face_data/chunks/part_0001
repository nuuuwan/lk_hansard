    "chunk_text": "2022 \u0d85\u0dc1\u0db4\u0dca \u0dba\u0dd2\u0da2\u0dba \u0dca\u0da7\u0dd2\u0dc0\u0dbb \u0da7\u0dc5 \u0dc1\u0dc1\u0dba \u0dc0 \u0db1\u0dd2\u0dc2\u0dca\u0da8\u0dcf\u0db4\u0dd2\u0dd2 \u0dad\u0dc1\u0dc0 \u0db1 \u0db1\u0dca\u0dc0\u0dc0\u0da7 8 2\u0dba\u0dd2 \u0dd9\u0dba\u0dd2 \u0db1 \u0dbd\u0daf\u0dd4 \u0dca\u0da7\u0dd2\u0dc0\u0dbb \u0db1\u0dca\u0dc0\u0dc0\u0da7 7 3\u0dba\u0dd2 \u0dc1 \u0d9a \u0dc0\u0dd3\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5 \u0d85\u0dc5\u0dd2 \u0db1 2023 \u0dc0\u0dae\u0dd2\u0dc2\u0dca\u0da8\u0dc1 \u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0dbd\u0dbd\u0dd2\u0dc1\u0db4\u0ddc\u0dc1\u0dba\u0ddc\u0dca\u0dad \u0d85 \u0dc1\u0dc0\u0dca\u0dc0\u0dd2 \u0da7\u0dc5 \u0dc1\u0dc1\u0dba \u0dc0 \u0db1\u0dd2\u0dc2\u0dca\u0da8\u0dcf\u0db4\u0dd2\u0dd2 \u0dad\u0dc1\u0dc0 \u0db1 \u0db1\u0dca\u0dc0\u0dc0\u0da7 10 1\u0dab \u0dba\u0dd2\u0da2\u0dba \u0dca\u0da7\u0dd2\u0dc0\u0dbb \u0d9c \u0dd9\u0dba\u0dd2 \u0db1 \u0dbd\u0daf\u0dd4 \u0dca\u0da7\u0dd2\u0dc0\u0dbb \u0dc1 \u0d9a \u0dc0\u0dca \u0dc3\u0dd2\u0da7 \u0db1\u0dca\u0dc0\u0dc0\u0da7 ] 2\u0dab \u0dbb\u0da7\u0dca\u0da7\u0dbb\u0dab \u0db4\u0dc0 \u0d86\u0dd4\u0dc0 \u0dd2\u0dad\u0dd3\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0db4\u0dd4\u0dc1\u0dba\u0ddd\u0dab\u0dcf\u0dca\u0dc0 \u0dab\u0dba\u0dca\u0dc0\u0dd2\n\n\u0dd2\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dc0\u0ddd\u0da2\u0dba \u0dab\u0dd2\u0dba\u0dab \u0dc3\u0db7\u0dd2\u0db4 \u0d86 \u0d85\u0dbb\u0db1\u0dd2 \u0dbb\u0da7 \u0d85\u0dc0\u0dc3\u0dd2\u0dca \u0dc0 \u0dc1\u0dc0 \u0db1 \u0dc0 \u0dc0 \u0db1\u0dca \u0d95\u0dca\u0dd1 \u0dab\u0dd2\u0dba \u0dd2 \u0dc1\u0da7\u0dab \u0d9c \u0d86\u0dc1\u0dbd\u0dca\u0dc0\u0dd2 \u0dc1\u0dbd\u0ddc\u0dc1\u0dbb\u0ddd \u0d85\u0dc0 \u0dca\u200d\u0dbb \u0dcf\u0dca \u0dab\u0dc5\u0dd2 \u0da2\u0dd2\u0dad\u0dba \u0db1\u0dad\u0dba \u0dd6\u0dbd\u0dbd\u0dba \u0d85\u0dba\u0db8\u0dd4\u0da7\u0dbd\u0da7 \u0d85\u0da7\u0dd2\u0dc5 \u0dc0\u0dd3\u0da9\u0dc3\u0da7\u0dbb\u0dc1 \u0db1 \u0dca\u200d\u0dbb \u0d86\u0dbd\u0dbd\u0dc0 \u0dc1\u0dbb\u0ddc\u0dab \u0d9c\u0da7 \u0dc0 \u0dc0\u0dbd\u0dd2 \u0d92\u0dab \u0dd9\u0dab \u0d9c \u0dd9\u0dc1\u0dbb\u0dbb \u0dca\u200d\u0dbb \u0dcf\u0dca \u0dab\u0dba\u0dca \u0d85\u0dc0\u0da7 \u0dbb\u0dbb \u0dbb\u0dad \u0d9c \u0dab\u0dba \u0db1\u0dca \u0d95\u0dca\u0dd1 \u0dc1\u0dbb\u0dad\u0dd3\u0dca \u0dca\u200d\u0dbb \u0dcf\u0dca \u0dab\u0dba \u0db1\u0dca \u0dd9\u0db4\u0dd2 2022 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0da7 \u0d85\u0dc5 \u0d94\u0dbd\u0da7 \u0d86\u0daf\u0dba\u0dab\u0dd4 \u0d85\u0db4\u0dbb\u0dc3\u0dd4\u0dad\u0dd2 \u0da7\u0dd2\u0dab \u0dbb\u0dad \u0d9c \u0dab\u0dba\u0dd2 \u0db1\u0dca \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dd9\u0dad\u0dd3\u0dca \u0d89\u0db3\u0dbd\u0dd2 2023 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0dc1\u0dc1 \u0d85\u0da7 \u0da7 \u0d9c\u0dc0\u0dd2 \u0dc1\u0dab\u0ddc\u0dc1\u0dad \u0d9c \u0daf\u0dd4\u0dba\u0da7 \u0d94\u0dbd \u0d85\u0dbb \u0db1\u0dbd\u0dd2 \u0dd2\u0dbb \u0db1 \u0dab\u0dba \u0d86\u0dc1\u0dbd\u0dca\u0dc0\u0dd2\u0da7 \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dbb\u0dad \u0d9c \u0dab\u0dba\u0dd2 \u0db1\u0dca \u0dbd\u0dbd \u0db1\u0dca \u0dc1 \u0d9a\u0dab \u0dad\u0dbb\u0dba\u0dd2 \u0da2\u0dd2\u0dad\u0dba \u0db1\u0dad\u0dba \u0dd6\u0dbd\u0dbd\u0dba \u0d85\u0dba\u0db8\u0dd4\u0da7\u0dc1\u0dda \u0dc0\u0dd3\u0da9\u0dc3\u0da7\u0dbb\u0dc1 \u0db1 \u0dc1\u0dc0\u0dca\u0dc3 \u0d85\u0db4\u0dd2\n\n\u0db1\u0dd2 \u0dcf\u0da0\u0dd2\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0dd2\u0dad \u0dbb\u0dd3\u0dc0 \u0dd6\u0dbd\u0dbd\u0dba \u0dba\u0dd2\u0db8\u0dd4\u0dc0 \u0d9c \u0d85\u0dc5\u0da7 \u0dd2 \u0d85\u0dc5\u0dca\u0dad \u0dc0\u0dd3\u0dbb \u0db1\u0dca\u0daf\u0dd4 \u0dc1\u0dc0\u0dca\u0dc0\u0dd2 \u0d92 \u0dc0\u0dd2\u0dc1\u0daf\u0dbb \u0d85\u0dc1\u0db4\u0dca \u0dc0 \u0dca\u200d\u0dbb \u0d86\u0dc0\u0dba\u0dd4\u0dbb\u0dd2\u0dad \u0dc0 \u0dd3\u0dad\u0dc1 \u0d9a \u0dd9 \u0d9c \u0dca\u200d\u0dbb\u0db0\u0dca\u200d\u0dd2\u0dca \u0dab\u0dd2\u0dba \u0dd2\u0dc0 \u0d9c \u0dc0 \u0db1\u0dc1 \u0db1 \u0dc1 \u0d9a \u0da2\u0dd2\u0dad\u0dba \u0db1\u0dad\u0dba \u0dd6\u0dbd\u0dbd\u0dba \u0d85\u0dba\u0db8\u0dd4\u0da7\u0dbd\u0da7 \u0d85\u0da7\u0dd2\u0dc5 \u0dc0\u0dd3\u0da9\u0dc3\u0da7\u0dbb\u0dca\u0dba\u0dd2 \u0d92 \u0dc0\u0dd3\u0da9\u0dc3\u0da7\u0dbb\u0dca \u0dd2\u0dd3\u0dca \u0dab\u0dcf\u0dd2 \u0dab\u0dba\u0dc1\u0daf\u0dd3 \u0d85\u0da7\u0dca\u0dad \u0dc1\u0dbd\u0ddc \u0dc1\u0dbb\u0ddd \u0dab\u0d9a \u0dab\u0dc1\u0dc0\u0ddd \u0dc0 \u0dc0\u0dd2 \u0da2\u0dd2\u0dad\u0dba \u0db1\u0dad\u0dba \u0dd6\u0dbd\u0dbd\u0dba \u0d85\u0dba\u0db8\u0dd4\u0da7\u0dbd\u0da7 \u0d9a\u0dc0\u0dc0 \u0db1 \u0dc1 \u0d9a \u0db4\u0dc0 \u0d86\u0dca \u0dc0 \u0d85\u0dae\u0dd2\u0daf\u0dba\u0da7\u0dc0 \u0dc3\u0dd2\u0dc3\u0db3\u0dd2\u0dc1\u0dd2\u0dca \u0dca\u0dae\u0dd2\u0d9a \u0dab\u0dc0 \u0d9c \u0d86\u0dbb\u0dca\u0dad \u0dab\u0dba \u0dd2\u0dd3\u0db8 \u0dbb \u0dc3\u0db3\u0dbb\u0dd2 \u0dc0\u0dd3\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5 \u0d9c \u200d\u0dbb\u0dd2\u0dc0\u0dd2\u0dca\u0dad\u0dbb\u0dab \u0dab\u0dba \u0db1\u0dca \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dd2 \u0d9a\u0dc0 \u0db1 \u0dd2 \u0dd2\u0da7\u0dbb \u0dc1\u0dc0\u0ddd\u0da2\u0dca\u0dd2 \u0dab\u0dc1\u0dc5\u0dda \u0dc3\u0dd2\u0db4 \u0d9c\u0dc2\u0dca\u0da8\u0dc0\u0dba\u0dd2 \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dbb\u0dd2 \u0d85\u0da7 \u0da7\u0dc0 \u0db1\u0dc1 \u0db1 \u0dab\u0dcf\u0dd2\u0dc0\u0da7 \u0dc3\u0dd2\u0dad\u0dba \u0d9c \u0dd3\u0db8\u0dbb\u0dd2 \u0dc1\u0dc0\u0da0\u0dca\u0da0\u0dcf \u0dc3\u0dd2\u0db4 \u0d9c\u0dc2\u0dca\u0da8\u0dc0 \u0d9c \u0dd2\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dc0\u0ddd\u0da2\u0dba \u0dab\u0dd2\u0dba\u0dab \u0dc3\u0db7\u0dd2\u0db4 \u0d86 \u0d85\u0dbb\u0db1\u0dd2 \u0dd9\u0dc1\u0dbb\u0dbb \u0dc0 \u0dc0 \u0db1\u0dca \u0dc1\u0dbb\u0dda \u0d85\u0dc0 \u0dc1 \u0d9a\u0dab\u0dba\u0dd2 \u0da2\u0dd2\u0dad\u0dba \u0db1\u0dad\u0dba \u0dd6\u0dbd\u0dbd\u0dba \u0d85\u0dba\u0db8\u0dd4\u0da7\u0dbd\u0da7 \u0dc0 \u0db1\u0dca \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dc3\u0dd2\u0db4 \u0d9c\u0dc2\u0dca\u0da8\u0dc0 \u0dc0 \u0dc0\u0dd2 \u0dca \u0d9a \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0dbd\u0db3 \u0d85\u0dc0\u0dc1\u0dbd\u0ddd\u0db0\u0dca\u200d\u0dc0\u0d9a\u0dd4\u0dca\u0dad \u0dca\u0dd3 \u0d86\u0dc0 \u0dc1\u0dca\u0ddc\u0dc1\u0dc0\u0dba\u0dd2 \u0dc1 \u0db1 \u0dc1 \u0d9a \u0dab\u0dcf\u0dd2 \u0dab\u0dba \u0db1\u0dc1 \u0db1 \u0dba\u0da7 \u0d85\u0dae\u0dd2\u0daf\u0dba\u0da7\u0dc0\u0dab\u0da7 \u0dc0\u0dca\u0dc0\u0dd2\u0dca\u0dad \u0da7\u0dd3 \u0d9c\u0dab\u0dd2 \u0dca \u0d9a \u0dd9\u0dc0 \u0d85\u0dca\u0dad \u0dc3\u0dd2 \u0db1\u0da7\u0dd2 \u0dca \u0d9a \u0d92 \u0dc0\u0dd3\u0da9\u0dc3\u0da7\u0dbb\u0dca\u0da7 \u0d85\u0da7\u0dd2\u0dc5 \u0dc0\u0dd3\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5\u0da7 \u0dc3\u0dd2\u0dbb\u0dd4\u0dc1\u0db0\u0dca\u200d\u0dc0 \u0dd9 \u0d85\u0dbb \u0db1\u0dbd\u0dd2 \u0da1 \u0db1\u0da7\u0dc0 \u0dca\u200d\u0dbb\u0dab\u0dd2 \u0dab\u0dc1\u0dc5\u0dda \u0dd2\u0dba\u0dd2? \u0dbb\u0da7 \u0d92 \u0dca\u200d\u0dbb \u0dcf\u0dca\u0dc0\u0da7 \u0dad\u0dc0\u0dbb \u0d8b\u0dca\u0dad\u0dad\u0dba\u0dc0 \u0d9c \u0dca\u0dd3\u0dbb\u0dd3 \u0dbb\u0da7 \u0dc1\u0dca\u0dad\u0dbb\u0dd4 \u0d9a \u0dd2 \u0db1\u0dca \u0dbd\u0dd3\u0dbb\u0dd3 \u0d92\u0dab"
