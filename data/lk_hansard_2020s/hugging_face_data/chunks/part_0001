    "chunk_text": "2016 2017.06.05\n\n2017 2018.06.20\n\n2018 2019.06.19\n\n2019 2020.08.20\n\n2020 2021.12.20\n\n2021 2023.01.11\n\n2022 \u0daf\u0db8\u0daf\u0dad\u0d9a\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dbd \u0db1\u0dd2\u0d9c\u0dda\u0dad\u0dca\u0dad \u0dc0\u0dd3 \u0daf\u0db1\u0dcf\u0db8\u0dd0\u0dad\n\n\u0d91\u0dd9\u0dd0\u0db1\u0dd2 \u0db4\u0dcf\u0dc3\u0dbd\u0dd3\u0db8 \u0db4\u0dc4\u0d9a\u0dca \u0d91\u0d9a\u0dcf\u0da7 \u0d91\u0d9a\u0dcf\u0dad\u0dd4 \u0daf\u0dd9\u0db1\u0daf\u0d9a\u0dcf\u0dcf\u0da7 \u0daf\u0dbb\u0dd4\u0dd9\u0db1\u0dca\u0da7 \u0dd9\u0da9\u0dcf \u0dd9\u0dd0\u0da9\u0dd2\u0dd2\u0d9a, \u0d9c\u0dd4\u0dbb\u0dd4\u0dd9\u0dbb\u0dd4\u0db1\u0dca \u0dc3\u0dcf\u0d82\u0dca\u200d\u0dba\u0dcf\u0dd9.\n\n\u0db4\u0dcf\u0dc3\u0dbd\u0dd3\u0db8 \u0dd9\u0dd4\u0dc4\u0d9c\u0dad \u0d9a\u0dcf\u0dbb\u0db1 \u0daf\u0dad\u0d9a\u0dca \u0d9c\u0dd4\u0dbb\u0dd4\u0dd9\u0dbb\u0dd4 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0d9c\u0dad \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0db1 \u0d85\u0db8\u0dcf\u0dbb\u0dd4\u0dd2\u0d9a. \u0d92\u0d9a\u0dcf\u0da7 \u0d91\u0d9a\u0dcf \u0daf\u0dc4\u0dca\u0dad\u0dd4\u0dd9\u0d9a\u0dca \u0dad\u0db8\u0dd2\u0d9a, \u0daf\u0dbb\u0dd4\u0daf\u0dd9\u0ddd 4\u0daf\u0daf\u0db1\u0dcf, 6\u0daf\u0daf\u0db1\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0db4\u0dcf\u0dc3\u0dbd\u0dd3\u0db8 \u0db4\u0dd0\u0dd9\u0dad\u0dd3\u0db8. \u0dc4\u0dd0\u0dd9\u0dd0\u0dd2\u0d9a, \u0d92 \u0db4\u0dcf\u0dc3\u0dbd\u0dd3\u0db8\u0dd9\u0dbd\u0da7\u0dad\u0dca\u0dad \u0d9c\u0dd4\u0dbb\u0dd4\u0dd9\u0dbb\u0dd4 \u0daf\u0daf\u0db1\u0dca\u0db1 \u0dd1\u0db1\u0dd1. \u0d91\u0daf\u0dc4\u0db8 \u0d9c\u0dd4\u0dbb\u0dd4\u0dd9\u0dbb\u0dd4 \u0daf\u0daf\u0db1\u0dca\u0db1 \u0d9a \u0dba\u0dcf\u0db8 \u0d85\u0db4\u0da7 \u0daf\u0db4\u0daf\u0db1\u0db1\u0dd9\u0dcf, \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba\u0d9a\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dd2\u0dc3\u0dd4\u0db1\u0dca \u0dc3\u0dcf\u0d82\u0dca\u200d\u0dba\u0dcf\u0dd9\u0da7 \u0dd9\u0da9\u0dcf \u0d85\u0dd4 \u0dc3\u0dcf\u0d82\u0dca\u200d\u0dba\u0dcf\u0dd9\u0d9a\u0dca \u0d91\u0db8 \u0db4\u0dcf\u0dc3\u0dbd\u0dd3\u0db8\u0dd9\u0dbd \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dd9\u0dd9. \u0d91\u0dad\u0daf\u0d9a\u0dcf\u0dcf\u0da7 \u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0dc3\u0dda\u0db4\u0dad\u0dca\u0dad \u0d85\u0db4\u0daf\u0dad\u0dca\u0dad \u0dba\u0dd1\u0db8\u0d9a\u0dca.\n\n\u0d9c\u0dbb\u0dd4 \u0d9a\u0dcf\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dcf\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0dc3\u0db8\u0dc3\u0dca\u0dad\u0dba\u0d9a\u0dca \u0dd9\u0dc1\u0daf\u0dba\u0db1\u0dca \u0d9c\u0dad\u0dca\u0dad\u0daf\u0dad\u0dcf\u0dad\u0dca\u0dad, \u0d85.\u0daf\u0db4\u0dcf.\u0dc3. \u0d8b\u0dc3\u0dc3\u0dca \u0daf\u0db4\u0dc5 \u0dc0\u0dd2\u0db7\u0dcf\u0d9c\u0daf\u0dda\u0daf\u0dd3 \u0d9c\u0dab\u0dd2\u0dad\u0dba \u0dc0\u0dd2\u0dc2\u0dba \u0db0\u0dcf\u0dbb\u0dcf\u0dd9 \u0d9a\u0dcf\u0dbb\u0db1 \u0dc3\u0dd2\u0dc3\u0dd4\u0db1\u0dca\u0da7 \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0dc0\u0dd2\u0dc2\u0dba\u0dba\u0db1\u0dca \u0dad\u0dd4\u0db1\u0dd2\u0d9a, \u0dd3 \u0dd9 \u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dd9 \u0dc0\u0dd2\u0dc2\u0dba \u0db0\u0dcf\u0dbb\u0dcf\u0dd9 \u0d9a\u0dcf\u0dbb\u0db1 \u0dc3\u0dd2\u0dc3\u0dd4\u0db1\u0dca\u0da7 \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0dc0\u0dd2\u0dc2\u0dba\u0dba\u0db1\u0dca \u0dad\u0dd4\u0db1\u0dd2\u0d9a. \u0d91\u0daf\u0dc4\u0db8 \u0d9c\u0dad\u0dca\u0dad\u0dad\u0dcf\u0db8 \u0d85\u0db4\u0da7 \u0dc0\u0dd2\u0daf\u0dba\u0dcf \u0d9a\u0dca\u0daf\u0dc2\u0dca\u200d\u0dbb\u0daf\u0dda \u0d9c\u0dd4\u0dbb\u0dd4\u0dd9\u0dbb\u0dd4 ,000\u0d9a\u0dcf \u0dc0\u0dd2\u0dad\u0dbb \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0dca \u0d89\u0db1\u0dca\u0db1\u0dd9\u0dcf. \u0d92 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3 \u0d85\u0db4\u0dd2 \u0d9c\u0dad\u0dca\u0dad\u0daf\u0dad\u0dcf\u0dad\u0dca\u0dad, \u0dc3\u0db8\u0dc3\u0dca\u0dad\u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dd9\u0dba\u0dcf\u0dda\u0dad \u0dc0\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0dd9\u0db3\u0dd9 \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dd9\u0d9a\u0dca \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf. \u0daf\u0dda \u0dc3\u0dd2\u0dba\u0dbd\u0dd3\u0db8\u0dbd\u0da7\u0db8 \u0daf\u0dc4\u0dca\u0dad\u0dd4\u0dd9, \u0db4\u0dcf\u0dc3\u0dbd\u0dd3\u0db8 \u0dd9\u0dbb\u0dca\u0dbd\u0dd3\u0d9a\u0dcf\u0dbb\u0dab\u0dba, \u0dd9\u0dd4\u0dc4\u0d9c\u0dad \u0d9a\u0dd2\u0dd3 \u0db8 \u0dc4\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dd9\u0dd4\u0dc4\u0d9c\u0dad \u0d9a\u0dd2\u0dd3 \u0db8 - restructure \u0d9a\u0dd2\u0dd3 \u0db8 - \u0d9a\u0dcf\u0dcf\u0dbd\u0dcf\u0db1\u0dca\u0dad\u0dbb\u0dba\u0d9a\u0dcf \u0dc3\u0dd2\u0da7 \u0dc3\u0dd2\u0daf\u0dd4 \u0daf\u0db1\u0dcf\u0dc0\u0dd3\u0db8\u0dd2\u0d9a.\n\n\u0db8\u0db8 \u0daf\u0dd0\u0db1\u0dca \u0d92 \u0daf\u0d9a\u0dcf\u0dcf\u0da7\u0daf\u0dc3\u0dca \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d86\u0dbb\u0dda\u0db7 \u0d9a\u0dcf\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf. \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0daf\u0dc3\u0dca\u0dbd\u0dcf\u0daf\u0db4 \u0dc3\u0dc4\u0daf\u0dba\u0ddd\u0d9c\u0dba\u0dad\u0dca\u0dad \u0dd1\u0db1\u0dd1. \u0da2\u0dcf\u0dad\u0dd2\u0d9a\u0dcf \u0db4\u0dcf\u0dc3\u0dbd\u0dd3\u0db8\u0dd9\u0dbd\u0da7 \u0d9c\u0dd4\u0dbb\u0dd4\u0dd9\u0dbb\u0dd4 1,700\u0d9a\u0dca \u0dd9\u0db3\u0dd9\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0db1 \u0d9c\u0dd0\u0dc3\u0dca \u0db1\u0dd2\u0daf\u0dda\u0daf\u0db1\u0dba \u0d85\u0db4\u0dd2 \u0d9a \u0dba \u0dc3\u0dad\u0dd2\u0daf\u0dda \u0db1\u0dd2\u0d9c\u0dda\u0dad\u0dca\u0dad \u0d9a\u0dcf\u0dc5\u0dcf. \u0dc0\u0dd2\u0daf\u0dc1\u0dca\u0dc2\u0daf\u0dba\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0d85\u0dd9\u0db0\u0dcf\u0db1\u0dba \u0daf\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dcf\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf, \u0dbb\u0dc3\u0dcf\u0dba\u0db1 \u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dd9, \u0daf\u0db7 \u0dad\u0dd2\u0d9a\u0dcf \u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dd9, \u0dd3 \u0dd9 \u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dd9, \u0d9c\u0dab\u0dd2\u0dad\u0dba \u0dc3\u0dc4 \u0d8b\u0dc3\u0dc3\u0dca \u0daf\u0db4\u0dc5 \u0dc3\u0db3\u0dc4\u0dcf \u0d89\u0dcf\u0d82\u200d\u0dbb\u0dd3\u0dc3\u0dd2 \u0db7\u0dcf\u0dc2\u0dcf\u0dd9 \u0dad\u0dad\u0dd4\u0dc5\u0dd4\u0dd9 \u0dc0\u0dd2\u0daf\u0dda\u0dca\u0dc2\u0dba \u0db7\u0dcf\u0dc2\u0dcf \u0dc3\u0dc4 \u0dad\u0dcf\u0d9a\u0dca\u0dc2\u0dab\u0dd2\u0d9a\u0dcf \u0dc0\u0dd2\u0dc2\u0dba \u0db0\u0dcf\u0dbb\u0dcf\u0daf\u0dda \u0dc0\u0dd2\u0dc2\u0dba\u0dba\u0db1\u0dca \u0dc3\u0dda\u0dd9\u0db1\u0dca\u0db0\u0daf\u0dba\u0db1\u0dca. \u0d92 \u0dc3\u0dcf\u0d82\u0dca\u200d\u0dba\u0dcf\u0dd9 \u0dd9\u0db3\u0dd9\u0dcf \u0d9c\u0dad\u0dca\u0dad\u0dad\u0dcf\u0db8 \u0da2\u0dcf\u0dad\u0dd2\u0d9a\u0dcf \u0db4\u0dcf\u0dc3\u0dbd\u0dd3\u0db8\u0dd9\u0dbd\u0da7 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dd9\u0dad\u0dca\u0dad \u0d9c\u0dd4\u0dbb\u0dd4\u0dd9\u0dbb\u0dd4 \u0dc3\u0dcf\u0d82\u0dca\u200d\u0dba\u0dcf\u0dd9\u0d9a\u0dca \u0d8b\u0db4\u0dcf\u0db0\u0dd2\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca \u0dbd\u0dd0\u0daf\u0dd9\u0db1\u0dd9\u0dcf.\n\n\u0d85\u0db1\u0dd2\u0d9a\u0dca \u0d9a\u0dcf\u0dcf\u0dbb\u0dab\u0dba \u0daf\u0dda\u0d9a\u0dcf\u0dd2\u0d9a. \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dab\u0daf\u0dda \u0db1\u0dd4\u0dd9 \u0d85\u0dd9\u0dc3\u0db1\u0dca \u0daf\u0dd9\u0db1\u0dd9\u0dcf \u0db1\u0dda \u0d85\u0db4\u0da7 \u0daf\u0dda\u0dbd\u0dcf\u0dc3\u0db1\u0dd2\u0db1\u0dca\u0db8 \u0d85\u0daf\u0db1\u0d9c\u0dda\u0dad\u0dca\u0dad \u0dc0\u0dd2\u0dc2\u0dba\u0dba\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1 \u0db1\u0dbb\u0dbb\u0dda\u0db4\u0dcf\u0dd4 \u0da7\u0dd2\u0d9a\u0dcf \u0db1\u0dbb\u0dbb\u0dd9\u0db1\u0dca\u0db1 \u0db1\u0dbb\u0dc5\u0dd4\u0dd9\u0db1\u0dca. \u0dc4\u0dd0\u0dd9\u0dd0\u0dd2\u0d9a, \u0d85\u0db4\u0dd2 \u0d91\u0daf\u0dad\u0d9a\u0dca \u0dd9\u0dbd\u0dcf\u0daf\u0d9c\u0db1 \u0dc4\u0dd2\u0da7\u0dd2\u0daf\u0dda \u0db1\u0dd0\u0dc4\u0dd0. \u0dd9\u0dc3\u0dca\u0db1\u0dcf\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dad\u0da7 \u0d8b\u0db4\u0dcf\u0db0\u0dd2\u0db0\u0dcf\u0dd3 \u0d9c\u0dd4\u0dbb\u0dd4\u0dd9\u0dbb\u0dd4 4,000\u0d9a\u0dcf\u0da7 \u0dd9\u0dd0\u0da9\u0dd2 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0dca \u0dd9\u0db3\u0dd9\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0daf\u0dda \u0daf\u0dd2\u0db1\u0dd9\u0dbd \u0dc3\u0dda\u0db8\u0dd4\u0dca\u200d \u0db4\u0dd3 \u0d9a\u0dca\u0dc2\u0dab \u0db4\u0dd9\u0dad\u0dca\u0dad\u0dd9\u0db1\u0dd9\u0dcf. \u0d92 \u0d85\u0dd4\u0dc0\u0dd9, \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0d9a \u0dba \u0dc3\u0dc4 \u0daf\u0dc3\u0dca\u0dd9\u0dba \u0dc4\u0dd0\u0dbb \u0d9a \u0dba \u0d85\u0dba \u0d9c\u0dab\u0db1\u0dba \u0d9a\u0dcf\u0dbb\u0dbd\u0dcf \u0d92 \u0d85\u0dba \u0daf\u0dd9\u0dd4\u0dc0\u0dd9\u0da7 \u0d85\u0dbd\u0dd4\u0daf\u0dad\u0db1\u0dca \u0d9c\u0dd4\u0dbb\u0dd4\u0dd9\u0dbb\u0dd4 \u0dd9\u0db3\u0dd9\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0d85\u0dd9\u0dc1\u0dba\n\n9 10\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9"
  },
