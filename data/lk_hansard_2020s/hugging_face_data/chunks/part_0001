u0dd2 \u0d9c\u0dab\u0dc1 \u0da2\u0dca\u0dad\u0dd2\u0dc0 \u0dca\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0db1\u0dd2\u0dc1\u0dc0\u0ddd\u0da2\u0dca\u0dc0 \u0dab\u0dba \u0db1\u0dca \u0dd9\u0da7\u0dd2 8 \u0dc1\u0da7\u0dc1\u0dca \u0d9c\u0dc0 \u0dbb\u0dbb\u0dd4\u0dc0\u0dc0\u0dba \u0dd2 \u0dc3\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dd2 \u0d9c\u0dab\u0dc1\u0dc0 \u0db1 \u0dc1 \u0d9a \u0db4\u0dd2\u0dae\u0dd2\u0dbd\u0dd2\u0dc1 \u0d9a \u0db1 \u0d85\u0dc0\u0da7 \u0dd9 \u0dc0\u0dd2 \u0d92 \u0da2\u0dca\u0dad\u0dd2\u0dc0 \u0d85\u0db4\u0dd2 8\u0dc1\u0da7\u0dca\u0dd2 \u0dbb\u0dbb\u0dd4\u0dc0\u0dc0\u0dba .\u0db1\u0dd2\u0dc3\u0dcf\u0dc3\u0dd4 \u0db1\u0dc1\u0daf \u0dd2\u0dca\u0dad\u0dad \u0dad\u0dca\u0dad\u0dca\u0dad\u0dc0\u0dc0 \u0dd2\u0dd3\u0dca \u0dc1\u0dbb\u0dad\u0dd3\u0dca\u0daf\u0dd3 \u0dab\u0dcf\u0dd2 \u0dab\u0dba\u0dbd\u0dd2 \u0d86\u0dc1\u0dbd\u0dca\u0dc0\u0dd2\u0da7 \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dbb\u0dbb \u0d85\u0dbb\u0dca\u0dc0\u0dd2 \u0dd6\u0dbd\u0dbd\u0dd2\u0dc3\u0dca\u0dd2\u0dbb\u0dd6\u0daa \u0dd2\u0dbb\u0dd4 \u0dbb \u0db1\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0d85\u0dbb\u0db1\u0dd2\n\n\u0dbb\u0dbb\u0dd4\u0dc0\u0dc0\u0dba \u0d9c\u0dd4\u0da9\u0dca \u0dc1\u0dc2\u0dca\u0da8\u0da9\u0dca \u0dbd\u0dd4\u0dc0\u0dc3\u0dd2\u0db0\u0dca\u200d \u0dca\u200d\u0dbb\u0dc0\u0dd2\u0dbb\u0dca \u0dbb\u0db0\u0dca\u200d\u0dba\u0dc3\u0dcf\u0dcf\u0dd2\u0dca \u0dc0\u0dba\u0dd2\u0db4\u0dad \u0d86\u0dc0 \u0dbd\u0dbd\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0dc1\u0dc1 \u0db4\u0da7 \u0db1 \u0dd2 \u0db1\u0dca\u0dc0\u0dd2\u0dc0 \u0dc0 \u0dc0\u0dca\u0dc0\u0dd2 \u0dab\u0dd2\u0dbd\u0dc0 \u0d9c \u0d92\u0dab \u0dca\u0dad\u0dba \u0dab\u0dba\u0dbd\u0dd2 \u0d86\u0daf\u0dba \u0dd2 \u0dca\u0db8\u0dd4\u0dca\u0dad \u0dc1\u0dbb\u0dc0\u0dba \u0d85\u0dc0 \u0dc0\u0dd3\u0dc1\u0dc0 \u0db1 \u0dc0 \u0dc0\u0dca\u0dc0\u0dd2 \u0d92\u0dab \u0dca\u0dd3\u0dc0\u0dad \u0db4\u0da7 \u0db1 \u0dd2 \u0db1\u0dca\u0dc0\u0dd2\u0dc0 \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dbd \u0db1\u0daf\u0dd4\u0dbd \u0d9c\u0dd4 \u0dc0\u0dae\u0dd2\u0db0\u0dca\u200d\u0dca \u0dd2\u0dbb \u0