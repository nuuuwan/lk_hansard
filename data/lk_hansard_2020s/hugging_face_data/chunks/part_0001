    "chunk_text": "\u0d8a\u0dc5\u0d9f \u0da7\u0dcf\u0dbb\u0dab\u0da2 \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0dad \u0db8\u0dd0\u0daf\u0dd2 \u0dca \u0dd3\u0dda. \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0dad \u0db8\u0dd0\u0daf\u0dd2 \u0dca \u0dd3\u0dda \u0db3\u0dbb\u0db4\u0dad\u0dc5 \u0dc0\u0dd2\u0db0\u0dd2\u0da2\u0da7 \u0dd2 \u0dc1\u0db3\u0dad\u0dc0\u0dcf. \u0dc1\u0db4\u0dcf\u0dd2\u0dc4\u0dca\u0db4\u0dd2 \u0db0\u0dd4\u0dbb\u0da2 \u0dc4\u0dda\u0db3\u0db1\u0dca\u0dad\u0db0\u0dc1\u0da2\u0db1\u0dca\u0dad \u0dc0\u0dd4\u0dab\u0dca \u0dc1\u0dda \u0dc1\u0dc0\u0dad\u0dc1\u0da7\u0dcf\u0da7 \u0dc4\u0dcf\u0da7\u0da0\u0dca\u0da1\u0dcf \u0dc1\u0dc0\u0dad\u0dc0\u0dcf. \u0dc1\u0db4\u0dcf\u0dd2\u0dc4\u0dca\u0db4\u0dd2 \u0db0\u0dd4\u0dbb\u0da2 \u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0db8\u0dcf\u0dad \u0dc1\u0db4\u0dcf\u0dd2\u0dc4\u0dca\u0db4\u0dd2 \u0dd4\u0db8\u0dcf\u0da7 \u0dc1\u0daf\u0dad\u0dc0\u0dcf \u0dad\u0dda, \u0db1\u0da2 \u0dc4\u0dd2 \u0dd4\u0dc1\u0dad\u0db1\u0dca\u0dad \u0dd4\u0dad\u0da7 \u0daf\u0dd3\u0dbb\u0dca\u0dbd\u0d9d \u0da7\u0dbb\u0db1\u0dca\u0dad\u0dad. \u0dc1\u0dda \u0dc4\u0db7\u0dcf\u0dc1\u0dda\u0daf\u0dd3 \u0db1\u0da7 \u0dc0\u0dad\u0dcf\u0dc0\u0da7 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf, \u0dc1\u0db4\u0dcf\u0dd2\u0dc4\u0dca\u0db4\u0dd2 \u0db0\u0dd4\u0dbb\u0da2 reload\" \u0da7\u0dbb\u0dad\u0dc0\u0dcf \u0d9a\u0dd2\u0da2\u0dbd\u0dcf. \u0db1\u0dc1 \u0db8 \u0dad\u0dda, \u0db8\u0dcf\u0dc4 6\u0da7\u0da7 \u0dc1\u0daf\u0db1\u0dca\u0dad\u0dad, \u0da7\u0db8\u0d9a\u0dca \u0dad\u0dd0 \u0dd0. \u0db1\u0dc1 \u0db8 \u0dad\u0dd0\u0dca \u0dad\u0dda \u0dc1\u0dc0\u0dad \u0dc1\u0da7\u0dc1\u0dad\u0d9a\u0dd4\u0da7 \u0dc1\u0daf\u0db1\u0dca\u0dad\u0dad. \u0dc1\u0db8\u0dcf\u0da7\u0d9a\u0dca\u0daf \u0d92 \u0dc4\u0dda\u0db3\u0db1\u0dca\u0dad\u0db0\u0dc1\u0da2\u0db1\u0dca\u0dad \u0dd2 \u0dc1\u0db3\u0dad \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0? \u0d85\u0db4\u0da7 \u0dc1\u0dca \u0dc1\u0dbb\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dad\u0dd0 \u0dd0, \u0d92\u0da7 \u0db4\u0dd2\u0dd4\u0db8\u0db4\u0dc4 \u0dd2 \u0dc1\u0db3\u0dad \u0dc1 \u0dca\u0dad\u0dd6\u0db1\u0dca\u0dad \u0dc1\u0db8\u0dcf\u0dad\u0dc0\u0dcf\u0daf \u0d9a\u0dd2\u0da2\u0dbd\u0dcf. \u0d92\u0dc1\u0da7\u0db1\u0dca\u0dad, \u0dc1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0d9a\u0dca \u0dd4\u0dc5 \u0dd2 \u0dc1\u0db3\u0dad \u0dc0\u0dd2 \u0dca\u0dc0\u0dc4\u0db1\u0dd3\u0da2\u0db7\u0dcf\u0dc0\u0da2 \u0da7\u0da9\u0dcf \u0dc1\u0d9c\u0dad \u0dc0\u0dd0\u0dc1\u0da7\u0dad\u0dc0\u0dcf. \u0d85\u0db1\u0dca\u0dad\u0dad \u0d92 \u0daf\u0dd4\u0dbb\u0dca\u0dbd\u0dc0\u0dbd\u0da7\u0dda \u0da7\u0dd2\u0da7 \u0daf\u0dcf \u0d9c\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dad\u0dd0\u0dca \u0dad\u0dda \u0dc1\u0dda \u0dad\u0dca \u0dca \u0dc0\u0da2 \u0dad\u0dc0\u0dca \u0db3\u0dbb\u0db4\u0dad\u0dc5 \u0dad\u0dd0\u0dad\u0da7\u0da7 \u0d9c\u0db8\u0db1\u0dca\u0dad \u0da7\u0dbb\u0dcf\u0dc0\u0dd2.\n\n313 314\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0db4\u0dca\u200d\u0dbb \u0dca\u0dad\u0da2 \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0db4\u0dcf\u0dd2\u0dc4\u0dca \u0dc4\u0dca\u0dae\u0dcf\u0dad\u0da2\u0da7\u0da7 \u0dd2\u0dad\u0da2\u0dcf\u0db8 \u0dad\u0db8\u0db1\u0dca\u0dad\u0dc1 \u0db8\u0dda \u0db7\u0dcf\u0dc2\u0dcf\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0db4\u0dd0\u0db8\u0dd2\u0dad\u0d9a \u0dbd\u0dca\u0dbd\u0d9a\u0dca \u0da7\u0dbb\u0db1\u0dca\u0dad\u0dad, \u0db1\u0dc1 \u0db8 \u0dad\u0dd0\u0dca \u0dad\u0dda \u0db1\u0da2 \u0dc4\u0da7 \u0db1\u0dca\u0dad \u0da7\u0dbb\u0db1\u0dca\u0dad\u0dad \u0db3\u0dcf\u0db0\u0dcf \u0d87\u0dd2 \u0dd3\u0db8. \u0d92\u0da7 \u0dc1\u0dbd\u0dcf\u0d9a\u0dd4 \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0d9a\u0dca. \u0d92\u0da7 \u0da2\u0dca\u200d\u0dad\u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dad\u0da7 \u0d85\u0dbb\u0dca\u0dbd\u0db6\u0dd4\u0daf\u0da2\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0db8 \u0da2\u0dda \u0da2\u0dda \u0d85\u0dc0\u0dc4\u0dca\u0dae\u0dcf\u0dc0\u0dbd\u0daf\u0dd3 \u0db8\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf \u0dd2 \u0dc1\u0db3\u0dad\u0dc0\u0dcf. \u0d92\u0da7 \u0dc4\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0dc1 \u0dca\u0dd4\u0dc0\u0d9a\u0dca; \u0daf\u0dd4\u0d9a\u0dca\u0d9c\u0dd0\u0dad\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0d9a\u0dca \u0dd2 \u0dc1\u0db3\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad. \u0dad\u0db8\u0db1\u0dca\u0dad\u0dc1 \u0db8\u0dda \u0db7\u0dcf\u0dc2\u0dcf\u0dc1\u0dc0\u0db1\u0dca\u0dad -\u0dc1\u0dad\u0dcf\u0daf\u0db1\u0dca\u0dad\u0dad\u0dcf \u0db7\u0dcf\u0dc2\u0dcf\u0dc0\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0dc1\u0dad\u0dcf\u0dc1\u0dc0\u0dba\u0dd2- \u0dc1\u0db4\u0dcf\u0dbd\u0dd3\u0db8\u0dc3\u0dd2\u0da2\u0da7 \u0dd2\u0dad\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0db4\u0dd0\u0db8\u0dd2\u0dad\u0d9a \u0dbd\u0dca\u0dbd\u0d9a\u0dca \u0da7\u0dbb\u0db1\u0dca\u0dad\u0dad \u0db3\u0dd0\u0dbb\u0dd2 \u0dad\u0dda \u0db1\u0dad\u0dd0\u0dad \u0db4\u0dca\u200d\u0dbb \u0dca\u0dad\u0da2\u0d9a\u0dca \u0dd2 \u0dc1\u0db3\u0dad\u0dc0\u0dcf. 85,000\u0d9a\u0dca \u0dc0\u0dd2\u0dad\u0dbb \u0dc0\u0dad \u0dc1\u0db4\u0dcf\u0dd2\u0dc4\u0dca \u0db3\u0dbd \u0d87\u0d9a \u0dc1\u0dda \u0dc3\u0dd2\u0da2\u0da2\u0da7 1\u0d9a\u0dca\u0dc0\u0dca -\u0d92 \u0d9a\u0dd2\u0da2\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad 850\u0dc1\u0daf\u0dc1\u0dad\u0d9a\u0dca\u0dc0\u0dca - \u0dad\u0dd0 \u0dd0, \u0daf\u0db8\u0dd2\u0dad\u0dc5 \u0db7\u0dcf\u0dc2\u0dcf\u0dc0, \u0db8\u0dda \u0db7\u0dcf\u0dc2\u0dcf\u0dc0 \u0da7\u0dbb \u0d9c\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dad. \u0d8a\u0da7 \u0d85\u0dd4 \u0dc4\u0d82\u200d\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d89\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad. \u0d92 \u0db1\u0dd2\u0dc4\u0dcf \u0db8\u0db8 \u0daf\u0db8\u0dd2\u0dad\u0dc5 \u0dc4\u0dc1 \u0ddd\u0daf\u0dbb \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0dad\u0da5\u0dba\u0db1\u0da2\u0db1\u0dca\u0dad\u0dc1\u0d9c\u0db1\u0dd4\u0dca , \u0dc4\u0db8\u0dcf\u0da2\u0dca\u200d \u0dad\u0dcf\u0da2\u0da7\u0dba\u0dd2\u0db1\u0dca\u0dad\u0dc1\u0d9c\u0db1\u0dd4\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0db8\u0d9a\u0dca \u0da7\u0dbb\u0dad\u0dc0\u0dcf, \u0da7\u0dbb\u0dd4\u0dab\u0dcf\u0da7\u0dbb \u0daf\u0db8\u0dd2\u0dad\u0dc5 \u0dc1\u0db4\u0dcf\u0dd2\u0dc4\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dd0\u0da9\u0dd2-\u0dc0\u0dd0\u0da9\u0dd2\u0dc1\u0da2\u0db1\u0dca\u0dad \u0dc1\u0db4\u0dcf\u0dd2\u0dc4\u0dca \u0dc1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0db3 \u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc4 \u0dcf \u0da2\u0db1\u0dca\u0dad\u0dbb\u0dab\u0da2\u0d9a\u0dca \u0daf\u0dcf \u0d9c\u0db1\u0dca\u0dad\u0dad \u0d9a\u0dd2\u0da2\u0dbd\u0dcf. \u0d92\u0da7 \u0d85\u0dad\u0dba\u0dc0 \u0dba\u0dba\u0dd2. \u0db1\u0dc1 \u0db8 \u0dad\u0dd0\u0dca \u0dad\u0dda \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0da7 \u0d92\u0da7 \u0daf\u0dd0\u0dc1\u0dad\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dc1\u0dc0\u0dad\u0dc4\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0da2\u0da7\u0da7\u0dba\u0dd2, \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0da2\u0ddd\u0da2\u0dca\u200d\u0dba \u0dc4\u0db7\u0dcf\u0db4\u0dd2 \u0dd4\u0db8\u0db1\u0dd2.\n\n\u0d92 \u0dc0\u0dcf \u0dc1 \u0db8 \u0db8\u0db8 \u0d94\u0db3\u0dd4\u0db8\u0dcf\u0da7 \u0dad\u0dc0 \u0da7\u0dcf\u0dbb\u0dab\u0dcf\u0dc0\u0d9a\u0dca \u0d9c\u0dd0\u0dad \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0da7\u0dcf \u0dc1\u0db4\u0dcf\u0dbd\u0dd3\u0db8\u0dc3\u0dd2\u0dc1\u0dda research division \u0db1\u0da7\u0d9a\u0dca \u0dd2 \u0dc1\u0db3\u0dad \u0db3\u0dc0 \u0db8\u0db8 \u0daf\u0db1\u0dca\u0dad\u0dad\u0dc0\u0dcf. \u0dd0\u0db3\u0dd0\u0dba\u0dd2, \u0db8\u0dd1\u0dad \u0da7\u0dcf\u0dbd\u0dc1\u0dda\u0daf\u0dd3 \u0d92\u0dc1\u0da7\u0db1\u0dca\u0dad \u0db1\u0dd2\u0db6\u0da2\u0da7 \u0d86\u0db4\u0dd4 research \u0db1\u0da7\u0d9a\u0dca \u0dad\u0dd0 \u0dd0, \u0d9c\u0dbb\u0dd4 \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0d87\u0db8\u0dd2 \u0dd4\u0db8\u0db1\u0dd2. \u0d95\u0dad\u0dd1\u0db8 \u0dc1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7\u0da7, \u0d95\u0dad\u0dd1\u0db8 \u0d86\u0da2\u0dad\u0dad\u0da2\u0da7\u0da7 \u0dad\u0db8\u0db1\u0dca\u0dad \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0dc0 \u0d85\u0db0\u0dba\u0da2\u0dad\u0da2\u0d9a\u0dca \u0da7\u0dbb\u0db1\u0dca\u0dad\u0dad, \u0dbb\u0dc1\u0d89 \u0dad\u0dca \u0dca \u0dc0\u0da2 \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0dc0 \u0d85\u0db0\u0dba\u0da2\u0dad\u0da2\u0d9a\u0dca \u0da7\u0dbb\u0db1\u0dca\u0dad\u0dad \u0db1\u0dc0\u0dd0\u0db1\u0dd2 \u0d92\u0da7\u0da7\u0da2\u0d9a\u0dca \u0dd2 \u0db6\u0dd3\u0db8 \u0d89\u0dad\u0dcf \u0dc0\u0dd0\u0daf\u0d9c\u0dca . \u0d92 \u0db1\u0dd2\u0dc4\u0dcf \u0db1\u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0dd4\u0db4\u0dcf\u0dd4\u0da7\u0dda \u0daf\u0dcf \u0d9c\u0db1\u0dca\u0dad\u0dad \u0d95\u0dad\u0dd1."
