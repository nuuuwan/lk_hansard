dca\u0dad\u0dad\u0dc0\u0dd2 \u0dd2 \u0dad\u0dd4\u0dab\u0dd4 \u0dc1\u0dc0 \u0db1\u0dc1 \u0db1 \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dd2\u0dd4\u0dc0\u0dc1\u0dc0\u0ddc\u0dca\u0dad \u0d8b \u0db1\u0da7\u0dd1 \u0d85\u0db4\u0da7 \u0dc0 \u0dc0\u0dba\u0dd2 \"\u0d85\u0dc1 \u0db1 \u0dbb\u0dbb\u0dca\u0dad\u0dad\u0dc1\u0dc0\u0ddd \u0d9a\u0dd4\u0db9\u0dd4\u0dba \u0dc1\u0dab\u0ddc\u0da7\u0dbd\u0dd2 \u0dc0\u0dd3 \u0dc0\u0db4\u0dd4\u0dba\u0dbd\u0dd2 \u0dc1\u0dd2\u0ddc\u0dc0\u0dbb \u0dbb\u0dd2\u0db4\u0dc0\u0da7 \u0db4\u0dd3\u0dc1\u0dbb\u0dca \u0dc1\u0dc0\u0dbd\u0dd2\u0dc1 \u0dab\u0db4\u0dbd\u0dd2 \u0d85\u0dc3\u0dcf\u0dc0\u0dd3 \u0db1\u0dca \u0d85\u0dba\u0dc1\u0dd2\u0dca \u0dc1\u0dd2\u0da7 \u0dc1\u0dd2\u0dca\u0dd3\u0dda\u0dbd\u0dd2 \u0dad\u0dbb\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dbd\u0dad \u0d9c \u0dc3\u0dab\u0dc3\u0dcf \u0dab\u0dba \u0dd2 \u0db1\u0dc1 \u0db1\" \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dbb\u0dd3\u0dbd\u0dd3\u0dba\u0dd2 \u0d85\u0dc1\u0db4\u0dca \u0da2\u0dca\u0dd2\u0db0\u0dd2\u0db4 \u0d86 \u0d85\u0dbb\u0dd2 -\u0d85\u0dc1\u0db4\u0dca \u0db8\u0dd4\u0da7\u0dda \u0dd2\u0dbb \u0d86 \u0d85\u0dbb\u0dd2- \u0dca\u0dab\u0dca\u0da9\u0dd4\u0dc1 \u0dab\u0dab\u0dca\u0da9\u0dd2\u0dc0\u0dbb \u0dc1\u0dbb\u0ddc\u0dab\u0da7 \u0dc0 \u0dc0 \u0db1\u0dc1 \u0db1? \"\u0dd9\u0dc1\u0dbb\u0dbb \u0d9a\u0dd4\u0db9\u0dd4\u0dba \u0dc0\u0db4\u0dd4\u0dba \u0db1\u0dca \u0d95\u0dca\u0dd1 \u0dca\u0dd3\u0dbb\u0dd3 \u0d9a\u0dd4\u0db9\u0dd4\u0dba \u0d86\u0dc0\u0dbd\u0dd2 \u0dc0 \u0dd2 \u0db1\u0dca\u0dc0\u0dd2 \u0dca\u0dd3\u0dca\u0dad\u0dca \u0d9a \u0dc3\u0dd2\u0d9a\u0dd4 \u0dbd\u0dd2 \u0dc3\u0dda\u0dbd\u0dd2 \u0dd2 \u0db1\u0dca\u0dc0\u0dd2 \u0dd9\u0dc1\u0dbb\u0dbb \u0dca\u0dd3\u0dca\u0dad\u0dca \u0d9a \u0dc0 adjust \u0dab\u0dba \u0dd2 \u0db1\u0dca\u0dc0\u0dd2 \u0dc0 \u0dca\u200d\u0dbb \u0d86\u0dc0\u0dba\u0dd4\u0dbb\u0dd2\u0dad \u0dab\u0dba \u0dd2 \u0db1\u0dca\u0dc0\u0dd2\" \u0dc0 \u0dc0\u0dca\u0dc0\u0dd2 \u0dd6\u0dbd\u0dbd\u0dba \u0d85\u0d82 \u0dc0 \u0dd2\u0dd3\u0dca \u0db4\u0dbb \u0dba\u0dd2 \u0d92 \u0d85\u0dc0 \u0dab\u0dcf\u0dd2 \u0dab\u0dba \u0db1\u0dc1 \u0db1 \u0dc1\u0dbb\u0dba\u0da7 \u0dc3\u0dd4\u0dc0\u0dbb\u0dc3 \u0d9c \u0da2\u0dca\u0dc0\u0dd2\u0da7 \u0d85\u0db4\u0dd2 \u0dc0 \u0dc0\u0dca\u0dc0\u0dd2 \u0dc0 \u0dbb\u0dd3\u0dba \u0dc1 \u0d9a \u0dca\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0da7 \u0dc0 \u0db1\u0dca\u0dbb \u0dc3\u0dd2\u0dc3\u0dd4\u0db1\u0dbb \u0d9c \u0dd2\u0dca\u0dad\u0dc1\u0dca\u0dad \u0dca\u0dd3\u0dbb\u0dd3 \u0dc0 \u0dc0\u0dbd\u0dd2\n\n\u0dd6\u0dbd\u0dbd\u0dd2\u0dc3\u0dca\u0dd2\u0dbb\u0dd6\u0daa \u0dd2\u0dbb\u0dd4 \u0dbb \u0db1\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0d85\u0dbb\u0db1\u0dd2 \u0dbb\u0dbb \u0dd9\u0dab \u0dc1\u0da7\u0dc0 \u0d9c \u0dc0 \u0dc0 \u0db1\u0dca \u0d95\u0dca\u0dd1 \u0dc1\u0dbb\u0ddc\u0dca\u0dc0\u0dd2 \u0dc0\u0dd4 \u0dca\u0dad \u0dbb\u0dc0 \u0db1\u0da7 \u0dba\u0dd2\u0da2\u0db4 \u0d9c\u0dc2\u0dca\u0da8 \u0dbb\u0dbb\u0dca\u0dad\u0dad\u0dc0\u0dd2 \u0dc0\u0dd3\u0da9 \u0d9c \u0dab\u0dc5\u0dd2 2015\u0da7 \u0dd9\u0dca\u0dab \u0d9a \u0dd9 \u0d85\u0dbb\u0dd2 \u0dc0\u0dd2\u0dae\u0dd2\u0dc2\u0dd2\u0dab\u0dc0 \u0dc1\u0da9\u0ddc\u0dbd\u0dae\u0dd2 \u0db6\u0dd2\u0dbd\u0dd2\u0dc0\u0dca 2 \u0d9c \u0dba\u0dc1\u0da7\u0dca \u0dc0 \u0dc1\u0dd2 \u0dc0\u0dd2 \u0dc1\u0dd2\u0dc0 \u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0 \u0db1 \u0dad\u0dba\u0dbb\u0da7 \u0dc0 \u0dd2\u0dca\u0dad\u0dad\u0dd2 2015 \u0d89\u0db3\u0dbd\u0dd2 \u0dba\u0db1\u0dd2\u0dda \u0dc3\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0dbb\u0db1\u0dca\u0d82\u0dbb \u0dbb\u0dd3 \u0d86 \u0d85\u0dbb\u0dd2 \u0d85\u0dd2\u0dbb\u0dd3 \u0d86 \u0d85\u0dbb\u0dd2 \u0dc3\u0dd2\u0db0\u0dd2\u0dc0\u0da7 \u0dc3\u0dbb \u0dca\u0dae\u0dd2\u0d9a \u0dab \u0dc3\u0d82\u0dc0\u0dae\u0dd2\u0db0\u0dca\u200d\u0dca \u0dd2\u0dbb \u0d86 \u0d85\u0dbb\u0dd2 \u0dc3\u0dd2\u0db0\u0dd2\u0dc0\u0da7 \u0db4\u0dca\u0dad \u0dc0\u0dd4 \u0dd2 \u0d8a\u0da7 \u0db4\u0dc3\u0dcf\u0dc1\u0dc3\u0dda \u0dc1\u0dbb\u0ddc\u0dab \u0d9c\u0da7 \u0dc0\u0dd4\u0dc1\u0dab\u0dca \u0dd6\u0dbd\u0dbd\u0dd2\u0dc3\u0dca\u0dd2\u0dbb\u0dd6\u0daa \u0dd2\u0dbb\u0dd4 \u0dbb \u0db1\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0d85\u0dbb\u0db1\u0dd2? \u0dc0\u0dd2\u0dae\u0dd2\u0dc2\u0dd2\u0dab \u0dc0 \u0dbd\u0dba - \u0dc0 \u0dc0\u0dd2\u0dd2\u0db4\u0dab\u0dc0- \u0dc1\u0da9\u0ddc\u0dbd\u0dae\u0dd2 \u0db6\u0dd2\u0dbd\u0dd2\u0dc0\u0dca 5 \u0d9c \u0dc0\u0dd4 \u0dd2"
