    "chunk_text": "\u0dd6\u0dbd\u0dbd\u0dd2\u0dc3\u0dca\u0dd2\u0dbb\u0dd6\u0daa \u0dd2\u0dbb\u0dd4 \u0dbb \u0db1\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0d85\u0dbb\u0db1\u0dd2 \u0dc1 \u0d9a \u0dca\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dad\u0dc0\u0daf\u0dd4\u0dba\u0da7\u0dca\u0dad \u0d86\u0daf\u0dba\u0dc1 \u0ddc\u0dca\u0dad \u0dd2\u0dc1 \u0d9a \u0dad\u0dd3\u0db4\u0dd3\u0dda \u0dab \u0db1\u0dc1\u0dad\u0ddd\u0dbb\u0dd4\u0dc0 \u0d9c\u0dc0\u0dca\u0dad \u0d89 \u0d85\u0dbb\u0dd4 \u0dab\u0dba \u0db1\u0dc1 \u0db1 \u0dca\u0dd3\u0dbb\u0dd3 \u0d85 \u0db1 \u0d86\u0dbb \u0dad\u0dd3\u0db4\u0dd3\u0dda \u0dab \u0db1\u0dc1\u0dad\u0ddd\u0dbb\u0dd4\u0dc0 \u0da7 \u0d9c\u0dc0\u0dd2 \u0dc3\u0dd2\u0d9a\u0dd4 \u0dca\u0dc0\u0dd2 \u0dba\u0dc1\u0da7\u0dca \u0dc0 \u0dbd\u0dba \u0dd2\u0dd3\u0dca \u0dbb\u0dd2\u0db4\u0dc0\u0da7 \u0da7 \u0db1\u0dc1 \u0db1 \u0dca\u0dd3 \u0d85\u0dc0 \u0dc3\u0dbb\u0dbb\u0dba \u0d85\u0dc0 \u0dc1\u0dbb\u0dad\u0dd3\u0dca\u0da7 \u0dd2\u0dc3\u0dd2\u0dca\u0dad \u0dca\u0dae\u0dd2\u0d9a \u0dab\u0dc0 \u0dd2\u0dd3\u0dca \u0dab\u0dcf\u0dd2 \u0dab\u0dba\u0dca\u0dc0\u0dd2\n\n\u0dd6\u0dbd\u0dbd\u0dd2\u0dc3\u0dca\u0dd2\u0dbb\u0dd6\u0daa \u0dd2\u0dbb\u0dd4 \u0dbb \u0db1\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0d85\u0dbb\u0db1\u0dd2 \u0d94\u0dbd \u0d85\u0dbb\u0dd2 \u0dc1\u0dbb\u0ddc\u0db3\u0da7 \u0dbb\u0dad\u0dab \u0dad\u0dbd\u0dd2 \u0dd2 \u0db1\u0dca \u0d89\u0dd2 \u0dd2\u0db4 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 5 \u0dd2 \u0d85\u0dc5\u0dad \u0d85\u0db4\u0dd2 \u0dc1\u0da9\u0ddc\u0dbd\u0dae\u0dd2 \u0db6\u0dd2\u0dbd\u0dd2\u0dc0\u0dca 20 \u0d9c \u0dc0 \u0dc1\u0dd2\u0dc0 \u0db1\u0dca \u0d86\u0dc1\u0dbd\u0dca \u0dbd\u0dc0 \u0db8\u0dd4\u0dc5\u0dd4 \u0dc0 \u0dc0 \u0dc1\u0dc0 \u0db1 \u0dc1\u0dd2\u0dc0 \u0db1\u0dca \u0d86\u0dc1\u0dbd\u0dca\u0dc0\u0dd2 \u0dc1\u0da9\u0ddc\u0dbd\u0dae\u0dd2 \u0db6\u0dd2\u0dbd\u0dd2\u0dc0\u0dca 27 \u0d9c\n\n\u0dd6\u0dbd\u0dbd\u0dd2\u0dc3\u0dca\u0dd2\u0dbb\u0dd6\u0daa \u0dd2\u0dbb\u0dd4 \u0dbb \u0db1\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0d85\u0dbb\u0db1\u0dd2 \u0dc1 \u0d9a\u0dc0\u0dd2