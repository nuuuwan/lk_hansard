    "chunk_text": "2024 \u0dc0\u0dd2\u0dc3\u0dbb\u0dca\u0dbd\u0da2\u0db1 \u0db4\u0db1\u0dad\u0dca\u0dad \u0daf\u0d9a\u0dcf\u0da7\u0dd4\u0dda\u0db4\u0dad\u0da7 \u0d85\u0daf\u0dcf\u0dc5\u0dd9 \u0daf\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0daf\u0dd9\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dad \u0d9a\u0dcf\u0dbb\u0db1\u0dbb \u0daf\u0dda \u0db4\u0dc3\u0dd4\u0dd2\u0db1\u0dda \u0dc3\u0da7\u0dc4\u0daf\u0db1\u0dca \u0db4\u0dd9\u0dcf \u0daf\u0db8\u0dcf\u0d9a\u0dcf\u0d9a\u0dca\u0daf \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0daf\u0db1\u0dca? \u0daf\u0db8\u0dc4\u0dd2 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dcf\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf, \u0dab\u0dba . \u0db8\u0dcf\u0dd9 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dd3\u0db8 \u0dd2\u0db1\u0dd2\u0dba\u0db1 3,.00 \u0daf\u0db1\u0dcf\u0d89\u0d9a\u0dca\u0db8\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dd9\u0dd9. \u0d85\u0daf\u0dcf\u0dc5 \u0dab\u0dba \u0db8\u0dd4\u0daf\u0dbd \u0db4\u0dd2\u0dc5\u0dd2\u0dd9\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dad \u0d9a\u0dcf\u0dbb\u0db1 \u0d85\u0dd9\u0dc3\u0dcf\u0db1 \u0d85\u0dba \u0dd9\u0dd0\u0dba \u0dad\u0dad\u0dca\u0dad\u0dad\u0dca\u0dad\u0dd9\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0dd9\u0db3 \u0dd9\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0daf\u0dda \u0dad\u0dad\u0dd4\u0dc5\u0dad\u0dca\u0dad \u0d9a\u0dcf\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dd2\u0d9a. \u0d8a\u0da7 \u0d85\u0dd9\u0dc1\u0dba \u0db1\u0dd3\u0dad\u0dd2\u0db8\u0dba \u0dd9\u0dbd\u0dba \u0dbd\u0dd0\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca 2003 \u0d85\u0dcf\u0d82\u0d9a\u0dcf 3 \u0daf\u0dbb\u0db1 \u0db8\u0dd6\u0dbd\u0dba \u0d9a\u0dcf\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dcf\u0dbb\u0dab (\u0dd9\u0d9c\u0d9a\u0dd3\u0db8) \u0db4\u0db1\u0daf\u0dad\u0dca\u0dad 3\u0dd9\u0db1 \u0dd9\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb\u0dd9. \u0daf\u0dd0\u0db1\u0dca \u0daf\u0dda\u0daf\u0d9a\u0dca \u0db8\u0dd6\u0dbd\u0dba \u0dad\u0dc3\u0dca\u0dad\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0dbd \u0dab\u0dba . \u0db8\u0dcf\u0dd9 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dd3\u0db8 \u0dd2\u0db1\u0dd2\u0dba\u0db1 3,.00\u0dd2\u0d9a. \u0d85\u0db4\u0dd2 \u0dd9\u0dd0\u0dbd\u0dd4\u0daf\u0dd9\u0dcf\u0dad\u0dca\u0dad, 2024\u0da7 \u0dad\u0dc3\u0dca\u0dad\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0d9c\u0dad \u0daf\u0dc5 \u0daf\u0dda\u0dca\u0dc2\u0dba \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dd3\u0dba\u0daf? \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dd3\u0db8 \u0dd2\u0db1\u0dd2\u0dba\u0db1 21,100\u0dd2\u0d9a. \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc1\u0dad\u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dd9\u0dd0\u0dbd\u0dd4\u0daf\u0dd9\u0dcf\u0dad\u0dca\u0dad \u0d9a\u0dd3\u0dba\u0daf? \u0dc3\u0dd2\u0dba\u0dba\u0da7 13.1\u0dd2\u0d9a. \u0d85\u0dba \u0dd9\u0dd0\u0dba \u0dc4\u0dd2\u0d9f\u0dba \u0dc3\u0dd2\u0dba\u0dba\u0da7 \u0da7 \u0db4\u0dc4\u0dc5\u0dd2\u0db1\u0dca \u0dad\u0dd9\u0dcf\u0d9c\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0daf\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0daf\u0dda \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0dc3\u0dda\u0db8\u0dad \u0d9a\u0dcf\u0dbb\u0dbd\u0dcf \u0daf\u0dda \u0d8b\u0d9c\u0dd4\u0daf\u0dbd\u0db1\u0dca \u0db8\u0dd2\u0daf\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0daf\u0dba\u0ddd\u0da2\u0db1\u0dcf\u0dd9\u0d9a\u0dca \u0dc3\u0dda\u0db8\u0dad \u0d9a\u0dcf\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dd2\u0db1\u0dba\u0daf\u0dd3\u0dad\u0dca\u0dad, \u0daf\u0dda \u0db8\u0dd6\u0dbd\u0dba \u0dad\u0dc3\u0dca\u0dad\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9 \u0d85\u0dd4\u0dc0\u0dd9 \u0dad\u0dd2\u0daf\u0dd9\u0db1 \u0daf\u0dc5 \u0daf\u0dda\u0dca\u0dc2\u0dba \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0dc3\u0dd2\u0dba\u0dba\u0da7 13.1\u0dd2\u0d9a.\n\n\u0daf\u0dda \u0dc3\u0dcf\u0d82\u0daf\u0dc1\u0ddd\u0db0\u0db1\u0dba \u0d85\u0dd4\u0dc0\u0dd9 \u0db1\u0dd9 \u0dab\u0dba . \u0db8\u0dcf\u0dd9 \u0d9a\u0dd3\u0dba\u0daf? \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dd3\u0db8 \u0dd2\u0db1\u0dd2\u0dba\u0db1 7,3 0\u0d9a\u0dca. \u0d91\u0dad\u0daf\u0d9a\u0dcf\u0dcf\u0da7 \u0d92\u0d9a\u0dcf \u0daf\u0dc5 \u0daf\u0dda\u0dca\u0dc2\u0dba \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0dd2\u0dad\u0daf\u0dda -\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dd3\u0db8 \u0dd2\u0db1\u0dd2\u0dba\u0db1 21,100- \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc1\u0dad\u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dd9\u0dd0\u0dbd\u0dd4\u0daf\u0dd9\u0dcf\u0dad\u0dca\u0dad \u0d9a\u0dd3\u0dba\u0daf? 2 \u0d9a\u0dca. \u0daf\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0daf\u0dda \u0db4\u0db1\u0dad\u0d9a\u0dca \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf, \u0d92\u0d9a\u0dcf \u0dc3\u0dd2\u0dba\u0dba\u0da7 \u0da7 \u0dd9\u0da9\u0dcf \u0d85\u0dd4 \u0d9a\u0dcf\u0dbb\u0db1\u0dd9\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d92\u0d9a\u0dcf \u0dc3\u0dd2\u0dba\u0dba\u0da7 2 \u0da7 \u0d9a \u0dc4\u0dd2\u0dbd\u0dd3\u0db8\u0dbd\u0dcf \u0db1\u0dbb\u0dc5\u0dd4\u0dd9\u0db1\u0dca\u0daf \u0d85\u0db4\u0da7 \u0d9c\u0dd0\u0dbd\u0daf\u0dd9\u0db1\u0dca\u0db1? \u0daf\u0db8\u0dcf\u0db1\u0dd9\u0dcf\u0daf \u0daf\u0dda \u0d9a\u0dcf\u0dbb\u0db1 \u0daf\u0dd9\u0dcf\u0dbb\u0dd4? \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0daf\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0, \u0daf\u0dda \u0daf\u0dd9\u0dcf\u0dbb\u0dd4\u0dd9 \u0dad\u0dd9\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca\u0dad \u0daf\u0d9c\u0db1\u0dd2\u0dc4\u0dd2\u0dbd\u0dd3\u0db8\u0dbd\u0dcf\u0daf \u0d85\u0daf\u0dda \u0dbb\u0da7 \u0daf\u0dda\u0dbb\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0dc4\u0daf\u0db1\u0dca\u0daf\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0daf\u0dda \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0db1 \u0dc4\u0daf\u0db1\u0dca\u0daf\u0db1\u0dca \u0d92\u0d9a\u0dcf \u0daf\u0db1\u0dcf\u0daf\u0dd9\u0dd2\u0d9a. \u0dab\u0dba \u0d8b\u0d9c\u0dd4\u0dbd\u0d9a\u0dcf \u0d9a \u0dbd\u0dd3\u0db8\u0dd9\u0dbd\u0dcf, \u0dc3\u0dca\u0dd9\u0dcf\u0db0\u0dd3\u0db1 \u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d82\u0d9a\u0dcf\u0dcf\u0dd9 \u0db1\u0dd0\u0dad\u0dd2 \u0db7\u0dcf\u0d82\u0d9c\u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0d9a\u0dd2\u0dd3 \u0daf\u0dda \u0d9c\u0db8\u0db1\u0d9a\u0dcf \u0dad\u0db8\u0dd2\u0d9a \u0daf\u0dda \u0daf\u0dba\u0daf\u0dd2\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dad\u0db8\u0dd2\u0d9a \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0dad\u0dc0\u0dd2\u0dbd\u0dd3\u0db8\u0dbd\u0dcf \u0d85\u0dbb \u0dd9\u0dcf\u0daf\u0db4 \u0dc0\u0dd2\u0dc4\u0dd2\u0dc5\u0dd4\u0dd9\u0d9a\u0dca \u0d85\u0daf \u0d8b\u0daf\u0dda \u0db4\u0dcf\u0db1\u0dca\u0daf\u0dbb \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0db1 \u0db1\u0dbb\u0dc5\u0dd4\u0dd9\u0db1\u0dca \u0dc0\u0dd4\u0daf\u0dab\u0dca\u0da9."
