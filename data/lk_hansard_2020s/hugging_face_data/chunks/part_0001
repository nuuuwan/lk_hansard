    "chunk_text": "\u0dbb\u0dd4\u0db4\u0dd2\u0dc0\u0dda 175 000\u0dab\u0da7 \u0d89\u0dbb\u0dc5 \u0d9a\u0dc0\u0dc0 \u0dda\u0dbd\u0dd2 \u0d86\u0dc1\u0dbd\u0dca \u0dc1\u0dc0\u0dbd\u0dd2\u0dc0\u0dab \u0dc1 \u0d9a \u0d85\u0dc0 \u0dab\u0da7 \u0dbb\u0dd3\u0dad \u0dc1\u0da7\u0ddc\u0da9\u0dc0\u0dca\u0dc0\u0dd2 \u0d8b\u0dc1\u0db0\u0dca\u200d\u0dbb\u0dca\u0dc0 \u0d85\u0da9\u0dd4\u0dba\u0dd2 \u0dc0 \u0dc0\u0dbd\u0dd2 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0 \u0db1 \u0dca \u0d9a \u0dd2\u0dc1 \u0d9a \u0dd2\u0db1\u0dca\u0dbd\u0dd2 \u0db1 \u0dca\u0dd3 \u0db1\u0da7\u0dd2\u0dc1\u0dd2 \u0db1 \u0dc1\u0dc3\u0ddd\u0dc1 \u0d9a \u0dbb\u0dd2\u0dbb\u0dd2\u0dc1\u0dd2 \u0db1 \u0d85\u0dbb \u0db1\u0dca \u0dbd\u0dbd \u0db1\u0dca \u0da7\u0dd3 \u0db1 \u0d8b\u0dc1\u0db0\u0dca\u200d\u0dbb\u0dca\u0dc0 \u0d85\u0da9\u0dd4 \u0dc1\u0dc0\u0dbd\u0dd2 \u0dc1 \u0db1\u0da7 \u0dc0 \u0dc0\u0dbd\u0dd2 \u0dd9\u0dc1\u0dbb\u0dbb \u0d85\u0dbb\u0dbd\u0dd2 \u0d94\u0dc5\u0dd4\u0dc0 \u0db4\u0dd2\u0db4\u0dc3\u0dcf\u0dc3 \u0d9a \u0dab\u0dba\u0dc1\u0dd2\u0dca \u0dca\u0dc1\u0dc0\u0ddc\u0dca\u0dad \u0dd2 \u0d86 .\u0db1\u0dd2\u0dc3\u0dcf\u0dc3\u0dd4 \u0db1\u0dc1\u0daf \u0dbd\u0da9\u0da7 \u0da7\u0dd3\u0dc1\u0dca\u0dca\u0dc0\u0dd2 \u0dba\u0dc1\u0da7\u0dca \u0d8b\u0dc1\u0db0\u0dca\u200d\u0dbb\u0dca\u0dc0 \u0dbd\u0da9 \u0db4\u0dd2\u0da7\u0dc1\u0db4\u0ddc\u0dca\u0dad\u0dad\u0da7 \u0dd2\u0dbd\u0dc3\u0dd2\u0dbd\u0dd2 \u0d86\u0dc1\u0dbd \u0db1\u0dc1 \u0db1 \u0d85\u0da7 \u0dba\u0dc1\u0da7\u0dca \u0da7\u0dbb\u0dd4\u0dc1\u0dc0\u0d9a\u0dd4\u0da7 \u0dab\u0dd1\u0dbb \u0dc1 \u0dbd \u0d9c \u0dd2 \u0db1\u0dca \u0dbd\u0dd3\u0dd2\u0db4 \u0dad\u0dca\u0dad\u0dca\u0dad\u0dc0\u0dc0\u0da7 \u0db4\u0dca\u0dad \u0dc1\u0dc0\u0dbd\u0dd2 \u0d86\u0dc1\u0dbd\u0dca\u0dc0\u0dd2\n\n\u0dd6\u0dbd\u0dbd\u0dd2\u0dc3\u0dca\u0dd2\u0dbb\u0dd6\u0daa \u0dd2\u0dbb\u0dd4 \u0dbb \u0db1\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0d85\u0dbb\u0db1\u0dd2 \u0d86\u0dc1\u0dbd\u0dca \u0dc3\u0dd2 \u0dcf\u0dc0\u0dc3\u0dd2\u0da7\u0dba\u0dd2\u0dbd\u0dc0\u0dbd \u0da7\u0dbb\u0dd4\u0dc0 \u0db1\u0da7\u0dc0\u0dca\u0dad \u0d85\u0da7 \u0dbb\u0dbb\u0dc1\u0db4\u0ddc\u0dc5 \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba\u0dd2\u0db0\u0dca\u200d\u0dd2\u0dba\u0dc0 \u0dc1\u0da7 \u0db1\u0dc1 \u0db1 \u0dca\u0dd3\u0dbb\u0dd3 \u0d85\u0da7 \u0dc1\u0dc0\u0dbd\u0dd2\u0dc0\u0da7 \u0dc3\u0dbb\u0dad\u0dc1\u0db0\u0dd2 \u0daf\u0dd3\u0dbb\u0dca\u0dd2\u0dc0; \u0d85\u0dc3\u0dcf\u0dc0\u0dd3\u0dc3\u0dd4\u0dbb \u0daf\u0dd3\u0dbb\u0dca\u0dd2\u0dc0 \u0dc1\u0da7 \u0db1\u0dc1 \u0db1 \u0dca\u0dd3\u0dbb\u0dd3 \u0dd9\u0dc1\u0dbb\u0dbb \u0dad\u0dca\u0dad\u0dca\u0dad\u0dc0\u0dc0 \u0d9c \u0dc0\u0da7\u0dc1\u0dca\u0dad \u0d85\u0da7 \u0dc1 \u0d9a \u0d85 \u0dc0\u0dca\u0dad \u0dc3\u0dd2 \u0dcf\u0dc0\u0dc3\u0dd2\u0da7\u0dba\u0dd2\u0dbd \u0dbb\u0da7 \u0db1\u0dca \u0dc0\u0dca .\u0dcf\u0dba\u0dd2 \u0dc0\u0dd3\u0dc1\u0da9\u0dca \u0dca\u0dad\u0dba \u0dab\u0dba \u0db1\u0dca \u0dc0 \u0dc0\u0dbd\u0dd2\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dc0 \u0dc0 \u0db1\u0dc1 \u0db1 \u0dc1 \u0d9a \u0d85\u0dc0 \u0dc0\u0dd3\u0dc1 \u0daf\u0dd3 \u0dca\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc1 \u0d9a \u0dba\u0dc1\u0da7\u0dca \u0dad\u0dbb\u0dd4 \u0dc1\u0dc0\u0ddd \u0db4\u0dd2\u0dc5\u0dd2\u0dbd\u0db3\u0dc0 \u0dc1\u0db4\u0ddc\u0da9\u0dca\u0da9 \u0d9c\u0dc0\u0dca\u0dad \u0d85\u0dc0\u0db0\u0dca\u200d\u0dd2\u0dca\u0dc0 \u0dc1\u0dc0\u0ddc\u0db8\u0dd4 \u0dab\u0dba\u0dbd\u0dd2 \u0dca\u0dd3\u0dbb\u0dd3 \u0dc1 \u0d9a \u0dba\u0dc1\u0da7\u0dca \u0dc0\u0dc3\u0dba\u0dab\u0da7 \u0dc5\u0dbb\u0dba\u0dd2 \u0db1 350 000 \u0d9c \u0d85 \u0dc0 \u0d86 \u0db1 \u0db4\u0dd2\u0dc3\u0dda\u0dc0\u0dbd\u0da7 \u0db7\u0dd2\u0dba \u0dc1\u0da7\u0dca\u0dc0\u0dd2 \u0dbb\u0dd3\u0dbd\u0dd3\u0dba\u0dd2 \u0db4\u0dd2\u0dc3\u0dda \u0d85\u0db0\u0dca\u200d\u0dba\u0dd2\u0db4\u0dca\u0dc0 \u0d85\u0dc0\u0dc3 \u0db1 \u0dab\u0dba\u0dbd\u0dd2 \u0dc3\u0dd2\u0db0\u0dd2\u0dbb\u0dca\u0dad \u0db4\u0dd4\u0dd4\u0dc0\u0dab\u0dd4\u0dc0 \u0d9c \u0dca\u0dd3 \u0d86\u0dc0 \u0d92 \u0d85\u0dad\u0dd2\u0db4 \u0db1 \u0dd9\u0dc5\u0dd2\u0dc0\u0da7 \u0dc0\u0dca\u0dc0\u0dd2 \u0db1\u0dca\u0dc0\u0dc0\u0da7 62 \u0d9c \u0dc3\u0dd2\u0db0