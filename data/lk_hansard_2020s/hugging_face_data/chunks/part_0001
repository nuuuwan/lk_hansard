    "chunk_size_bytes": 3261,
    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0dc3\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2, 1938.0 .2 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0dad\u0db8\u0dba\u0dd2 \u0dc0\u0dd2\u0db8\u0db4\u0dad\u0dca\u0dad\u0dd4\u0dc0 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d8b\u0daf\u0dca\u200d\u0dba\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0d9a\u0dc1\u0dc5\u0dda. \u0dc0\u0dbb\u0dca\u0dad\u0db8\u0dcf\u0db1\u0dc1\u0db1 \u0d94\u0dc0\u0dd4\u0dc0\u0dcf \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dc3\u0dbd\u0d9a\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dba\u0dd2 \u0d91\u0dc4\u0dd2 \u0d9a\u0dd2\u0dc0\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0dab\u0dca. \u0d92 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0d9a\u0dbb\u0db4\u0dd4 \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca, \u0dc1\u0dc0\u0db1\u0db8 \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca, \u0d9c\u0dbb\u0dd4 \u0dc3\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2. \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 3\u0da7 \u0d85\u0daf\u0dca\u200d\u0dcf\u0dc5\u0dc0 1969.06.27\u0dc0\u0db1 \u0daf\u0dd2\u0db1\u0dad\u0dca\n\n\u0d9c\u0dbb\u0dd4 \u0dc3\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2, \u0d85\u0d82\u0d9a 329 \u0d9a\u0da7\u0dd4\u0db4\u0dad\u0dca\u0dc0\u0dd0\u0dc0 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0dc1\u0db8\u0dca \u0d9a\u0da7\u0dd4\u0db4\u0dad\u0dca \u0dc0\u0dd0\u0dc0 \u0dc3\u0dc4 \u0daf\u0dd2\u0dc0\u0dd4\u0db8 \u0dc0\u0dd0\u0dc0 \u0dd2\u0dbb\u0dba\u0db1 \u0dc0\u0dd0\u0dda \u0dc1\u0daf\u0dca\u200d\u0d9a\u0dad\u0dca, \u0d85\u0d82\u0d9a 332 \u0dad\u0db8\u0d9c\u0dc3\u0dca\u0dc0\u0dd0\u0dc0 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0dc1\u0db8\u0dca \u0d85\u0d82\u0dc0\u0dd0\u0da7\u0dd2\u0dba\u0dcf\u0dc0 \u0dc0\u0dd0\u0dc0 \u0dc3\u0dc4 \u0d9a\u0dc5\u0dd4\u0dc0\u0dcf\u0daf\u0dca\u200d\u0dd1\u0d9c\u0db8 \u0dc0\u0dd0\u0dc0\u0dad\u0dca, \u0d8a\u0dc5\u0d9f\u0da7 \u0d9a\u0dd4\u0d9a\u0dd4\u0db8\u0d9a\u0da7\u0dd4\u0dc0 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dc1\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dc1\u0db1 \u0d9a\u0dd4\u0d9a\u0dd4\u0db8\u0d9a\u0da7\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0dc0\u0dd0\u0dc0\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0dc0\u0dd0\u0dda \u0dad\u0dd4\u0db1\u0d9a\u0dca 1969.06.27\u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0d85\u0dd2 \u0dc0\u0dd0\u0da7 \u0d89\u0daf\u0dd2\u0d9a\u0dbb\u0dc0\u0dcf\u0db1 \u0d9c\u0dc4\u0db4\u0dd4 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0dc1\u0dda\u0daf\u0dca\u200d\u0db1\u0dba \u0db1\u0dd2\u0dc3\u0dcf \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dc0\u0dcf \u0dc0\u0dd2\u0dd2\u0db1\u0dc0\u0dcf \u0d85\u0daf\u0dca\u200d \u0dc1\u0db4\u0dca\u200d\u0dbb\u0dda\u0dbb\u0d9a \u0d9a\u0dbd\u0dcf\u0db4\u0dba \u0dc3\u0dad\u0dd4\u0dc5\u0da7 \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d9c\u0dbb\u0dd4 \u0dc3\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2, \u0d92 \u0d9c\u0db8\u0dca\u0dc0\u0dbd \u0d89\u0dc0\u0dcf\u0db1 \u0d85\u0dba\u0da7 \u0d85\u0daf\u0dca\u200d \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0d92 \u0dc0\u0dd0\u0dda\u0dc0\u0dd2\u0dc0\u0dcf \u0db1\u0dcf\u0dc0\u0dcf\u0db1\u0dc0\u0dad\u0dca \u0db6\u0dd0\u0dc4\u0dd0. \u0d94\u0dc0\u0dd4\u0dc0\u0dcf\u0da7 \u0db1\u0dcf\u0dc0\u0dcf\u0db1 \u0dc0\u0dd0\u0dc0\u0da7 \u0db6\u0dc4\u0dd2\u0dc0\u0dcf\u0db1 \u0db6\u0dd0\u0dc4\u0dd0. \u0dc1\u0db8\u0ddc\u0d9a\u0daf\u0dca\u200d, \u0dc0\u0dd0\u0dda bund \u0d91\u0d9a \u0d8b\u0da9 \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0dd2 \u0dc0\u0dd0\u0da7 \u0d89\u0daf\u0dd2\u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0dc0\u0dcf\u0dc1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0d94\u0dc0\u0dd4\u0dc0\u0dcf\u0da7 \u0d92 \u0dc0\u0dd0\u0dda\u0dc0\u0dd2\u0dc0\u0dcf \u0db8\u0db8 \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0d9a\u0da9\u0dcf \u0d9c\u0dc0\u0dcf\u0db1 \u0db6\u0dd0\u0dc4\u0dd0. \u0dc1\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb, \u0d85\u0daf\u0dca\u200d\u0dcf\u0dc5 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0dc1\u0dda\u0daf\u0dca\u200d\u0db1\u0dba \u0dc3\u0dad\u0dd4\u0dc5\u0dd4 \u0dc1\u0db8\u0d9b\u0dca\u200d\u0db1 \u0dd2\u0db1\u0dba\u0db8\u0dbd \u0db8\u0db8 \u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc1\u0dda\u0daf\u0dd3 \u0dc3\u0dc0\u0dcf\u0d9c\u0dad\u0dca* \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\n\n\u0d85\u0dc1\u0dda \u0d9c\u0db8\u0dca\u0dc0\u0dbd \u0d85\u0dc4\u0dd2\u0d82\u0dc3\u0d9a \u0dc1\u0d9c\u0ddc\u0dc0\u0dd3\u0dc0\u0dcf \u0dc0\u0dd0\u0dc0\u0d9a\u0da7 \u0db6\u0dd0\u0dc4\u0dd0\u0dbd\u0dcf \u0db8\u0dcf\u0dc5\u0dd4\u0dc1\u0dc0\u0d9a\u0dca \u0d85\u0db8\u0dbd\u0dcf \u0d9c\u0dad\u0dca\u0dad\u0dcf\u0db8 \u0d94\u0dc0\u0dd4\u0dc0\u0dcf\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4 \u0db0\u0dc0 \u0daf\u0dca\u200d\u0dcf\u0db4\u0dd4 \u0db1\u0da9\u0dd4 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0db8\u0dcf \u0dc5\u0d9f \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dc0\u0dcf \u0dc0\u0dd2\u0dd2\u0db1\u0dc0\u0dcf \u0d85\u0daf\u0dca\u200d \u0d92 \u0dc1\u0d9c\u0ddc\u0dc0\u0dd3\u0dc0\u0dcf\u0da7 \u0db8\u0dcf\u0dc5\u0dd4\u0dc1\u0dc0\u0d9a\u0dca \u0d85\u0db8\u0dbd\u0dcf\u0dc1\u0d9c\u0db1 \u0d9a\u0dc0\u0dcf\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0dc3\u0dad\u0dd2 \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc1\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d85\u0db4\u0dd2 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dc3\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dd4 \u0dc4\u0dd0\u0db8 \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dd4\u0da7\u0db8 \u0dc0\u0dcf\u0dc1\u0dda \u0dd2\u0dbb\u0dda\u0dc0\u0dcf, \u0d9c\u0dbb\u0dd4 \u0dc3\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d91\u0dad\u0dd4\u0db8\u0dc0\u0dcf\u0dbd\u0dcf \u0dc1\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0dba\u0da7 \u0d8b\u0dad\u0dca\u0dad\u0dbb\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0dd4\u0dc0\u0dc0\u0dcf\u0dc1\u0dc0\u0dcf \u0db1\u0dd0\u0dc4\u0dd0."
  },
