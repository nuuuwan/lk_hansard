    "chunk_text": "\u0d85\u0daf \u0d8a\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0da2\u0dbd\u0dc1\u0dda \u0dad\u0dca \u0dca \u0dc0\u0da2 \u0dc1\u0da7\u0dcf\u0dc1 \u0dcf\u0db8\u0daf? \u0dc1\u0dc0\u0dad\u0dca \u0dbb\u0da7\u0dc0\u0dbd \u0db1\u0dc0\u0daf\u0dba\u0dc0\u0dbb\u0dd4, \u0d89\u0d82\u0dd2\u0dad\u0dc1\u0db1\u0dca\u0dad\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4, \u0db8 \u0dcf\u0da0\u0dcf\u0dbb\u0dca\u0dbd\u0da2\u0dc0\u0dbb\u0dd4 \u0dcf \u0d86\u0da0\u0dcf\u0dbb\u0dca\u0dbd\u0da2\u0dc0\u0dbb\u0dd4 \u0dd0\u0da7\u0dd2\u0da2\u0da7 \u0dc3\u0dd2\u0da7\u0dd2\u0dad \u0d8a\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0da2\u0dbd \u0da2\u0dca\u200d\u0dad\u0dad\u0dcf\u0dc0 \u0d94\u0d9a\u0dca\u0dc1\u0da7\u0ddd\u0db8 \u0dc1\u0dda \u0dba\u0dd4\u0dda\u0db0 \u0d85\u0dc0\u0dc4\u0dca\u0dae\u0dcf\u0dc1\u0dda \u0dad\u0db8\u0db1\u0dca\u0dad\u0dc1 \u0dbb\u0dc1\u0d89 \u0db8\u0dd4\u0daf\u0dcf\u0dc0\u0da7 \u0dc4 \u0dc1\u0da2\u0ddd\u0d9c\u0da2 \u0dc1\u0daf\u0db1\u0dca\u0dad\u0dad \u0db1\u0dad\u0dc0\u0dcf. \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 60, 70, 80 \u0dcf 90 \u0d9a\u0dd2\u0da2\u0dad \u0dc0\u0da2\u0dc4\u0dca\u0dc0\u0dbd \u0db4\u0dc0\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0dad \u0d8a\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0da2\u0dbd \u0da2\u0dca\u200d\u0dcf\u0dd2 \u0da7\u0da2\u0db1\u0dca\u0dad \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0d9c\u0db3\u0da9\u0dcf\u0dc0\u0dbd \u0dc1 \u0ddd \u0d89 \u0dc1\u0d9c\u0dad \u0dbb\u0da7 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca\u0dad \u0dc4 \u0dcf\u0da2 \u0dc1\u0daf\u0dad\u0dc0\u0dcf; \u0dbb\u0da7 \u0dc1\u0dda\u0dbb\u0dcf \u0d9c\u0db1\u0dca\u0dad\u0dad \u0dba\u0dd4\u0dda\u0db0\u0da2 \u0da7\u0dbb\u0dc1\u0d9c\u0dad \u0da2\u0db1\u0dca\u0dad\u0dad \u0d9c\u0db3\u0da9\u0dcf\u0dc0\u0dbd \u0d89 \u0dc1\u0d9c\u0dad \u0dc1 \u0ddd \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0dc4 \u0dcf\u0da2 \u0dc1\u0daf\u0dad\u0dc0\u0dcf. \u0dc1\u0db8\u0dcf\u0da7\u0daf, \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0dbb\u0da7\u0da7 \u0d86\u0daf\u0dbb\u0da2 \u0da7\u0dbb\u0dad \u0db1\u0dd2\u0dc4\u0dcf. \u0db8\u0dd6\u0dbd\u0dcf\u0dc4\u0dad\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db8\u0db1\u0dd2, \u0dc1\u0dda \u0dbb\u0dc1\u0d89 \u0db8\u0dd2\u0dad\u0db1\u0dd2\u0dc4\u0dca\u0dc3\u0dd4\u0db1\u0dca\u0dad\u0da7 \u0d89\u0dc4\u0dca\u0dc1\u0dc4\u0dbd\u0dca\u0dbd\u0dcf\u0db8 \u0d8b\u0d9c\u0db1\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dad\u0dad \u0d95\u0dad\u0dd1 \u0dbb\u0da7\u0da7 \u0d86\u0daf\u0dbb\u0da2 \u0da7\u0dbb\u0db1\u0dca\u0dad\u0dad. \u0dbb\u0da7\u0da7 \u0d86\u0daf\u0dbb\u0da2 \u0da7\u0dbb\u0db1\u0dca\u0dad\u0dad \u0d8b\u0d9c\u0dc0\u0db1\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dad\u0dad \u0d95\u0dad\u0dd1, \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc1\u0dc0\u0db1\u0dca\u0dad\u0db8. \u0dc1\u0dda \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0da2\u0db1\u0dca\u0dad \u0da7\u0dbb\u0dad \u0dc4\u0db8 \u0dbb \u0da7\u0dae\u0dcf \u0d87\u0dc1 \u0dad\u0dc1\u0da7\u0dcf\u0da7 \u0d85\u0db4\u0da7 \u0dc4\u0dd2\u0dad\u0dcf \u0d9c\u0db1\u0dca\u0dad\u0dad\u0dc0\u0dca \u0db3\u0dd0 \u0dd0. \u0db1\u0da7 \u0db1\u0da7 \u0dc0\u0dd2\u0db0\u0dd2\u0da2\u0da7 \u0d9a\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dbb\u0dab \u0dd2 \u0db6\u0dd4\u0dab\u0dcf. 2005\u0da7 \u0da7\u0dd2\u0db1\u0dca\u0dad \u0dba\u0dd4\u0dda\u0db0\u0da2 \u0d85\u0dc0\u0dc4\u0db1\u0dca\u0dad \u0da7\u0dbb\u0db1\u0dca\u0dad\u0dad \u0d85\u0dc0 \u0dba \u0d9a\u0dca\u0dd2 \u0da2 \u0db8\u0dd4\u0daf\u0dcf\u0dc0\u0da7 \u0dd2 \u0db6\u0dd4\u0dab\u0dcf; \u0db8\u0dd4\u0daf\u0dcf \u0d9a\u0dca\u0dd2 \u0da2 \u0dd2 \u0db6\u0dd4\u0dab\u0dcf. \u0dd0\u0db3\u0dd0\u0dba\u0dd2, \u0db1 \u0dad\u0dc1\u0da7\u0dcf\u0da7 \u0db1\u0dd2\u0da2\u0db8 \u0dad\u0dcf\u0da2\u0da7\u0dca \u0dc0\u0da2\u0d9a\u0dca \u0dd2 \u0db6\u0dd4\u0dc1\u0dab\u0dca\u0da9 \u0dad\u0dd0 \u0dd0. \u0dd0\u0db3\u0dd0\u0dba\u0dd2, \u0db8\u0dd4\u0daf\u0dcf \u0d9a\u0dca\u0dd2 \u0da2 \u0dd2 \u0db6\u0dd4\u0dab\u0dcf. \u0d92\u0da7\u0dba\u0dd2 \u0db8\u0db8 \u0d9a\u0dd2\u0da2\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad. \u0db8\u0dd4\u0daf\u0dcf\u0dc1\u0dda \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dd3\u0dc1\u0dbb\u0ddd\u0daf\u0dcf\u0dbb \u0dbb\u0dab \u0dc0\u0dd2\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dad\u0db8\u0dba\u0dd2 2009\u0daf\u0dd3 \u0dba\u0dd4\u0dda\u0db0\u0da2 \u0d85\u0dc0\u0dc4\u0db1\u0dca\u0dad \u0da7\u0dc1\u0dc5\u0dca. \u0dc1\u0dc0\u0dad\u0dc4\u0dca \u0dc0\u0dd4\u0dc1\u0dab\u0dca\u0da9 \u0da7\u0dc0\u0dd4\u0daf? \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc1\u0dc0\u0dad\u0dc4\u0dca \u0dc0\u0dd4\u0dab\u0dcf; \u0dad\u0dcf\u0da2\u0da7\u0dca \u0dc0\u0da2 \u0dc1\u0dc0\u0dad\u0dc4\u0dca \u0dc0\u0dd4\u0dab\u0dcf. \u0db1\u0daf\u0dcf \u0db1\u0dc1 \u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0dba\u0dd4\u0dda\u0db0 \u0da7\u0dc1\u0dc5\u0dca. \u0d92 \u0da7\u0dcf\u0dbd\u0dc1\u0dda \u0dd2 \u0db6\u0dd4\u0dab\u0dd4 \u0dad\u0dca \u0dca \u0dc0\u0da2 \u0d92\u0da7\u0dba\u0dd2. \u0d85\u0daf \u0dc1\u0dda \u0dc0\u0dcf\u0dc1 \u0dad\u0dca \u0dca \u0dc0\u0da2\u0da7 \u0db4\u0dca\n\n353 354\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0"
  },
