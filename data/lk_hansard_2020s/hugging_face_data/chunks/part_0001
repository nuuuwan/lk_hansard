    "chunk_text": "\u0dc1 \u0d85\u0d9a \u0dc0\u0dca\u200d\u0dd0\u0d9a \u0dca \u0dcf\u0dad \u0dc0\u0dd4\u0dab\u0daf\u0da7 \u0db4\u0dca\u0dae\u0dc1\u0dca\u0dda \u0db1\u0daf\u0dad\u0dba\u0dca\u0dad \u0d9a\u0da7 \u0d85\u0db4\u0dd2 \u0dca\u0dc4\u0dd2\u0dbb \u0d9a\u0d9a\u0dca \u0dc1\u0dcf\u0dca\u0dca \u0d95\u0dca\u0db1 \u0dc1\u0dc1 \u0db4\u0daf\u0d9a\u0dca \u0db4\u0d9a\u0dca\u0dc2 \u0db4\u0daf\u0da7 \u0dc1\u0dda\u0dcf\u0d9a\u0dd2\u0dbb\u0dca \u0dc1\u0dad\u0ddc \u0dc0\u0dca\u200d \u0da7 \u0dc1\u0db6\u0dca \u0daf \u0d9c\u0dd0\u0db1\u0dd3\u0dc1 \u0dc1 \u0dc0\u0dca\u200d\u0dd0\u0da9 \u0db4\u0dd2 \u0dd2\u0db6\u0dc1\u0dc0\u0dca\u200d\u0dc5\u0da7 \u0d85\u0db4\u0dd2 \u0dca\u0dc4\u0daf\u0d9a \u0dc1\u0dcf\u0dca\u0dc0\u0dca\u200d\u0daf \u0dd2\u0dbb\u0d9a\u0d9a\u0daf. \u0dad\u0dc1 \u0ddc\u0da7 \u0dad\u0dcf\u0dba\u0dd2 \u0d85\u0dc0\u0dca\u200d\u0dca\u0daf\u0dca \u0d85\u0dd2\u0dbb\u0d9a\u0dc1\u0d9a \u0dc3\u0dca \u0dca, \u0dc4\u0dd2\u0db4 \u0d9a\u0dca\u0dc1\u0dca. \u0dc1 \u0d85\u0d9a \u0dc0\u0dca\u200d\u0dd0\u0d9a \u0dca \u0dcf\u0dad \u0dc0\u0dd4\u0dc1\u0dab\u0ddc\u0dca, \u0dad\u0dcf\u0dba\u0dd2 \u0db1\u0daf\u0dad\u0dba\u0dca\u0dad \u0db8\u0dd6\u0d9a\u0dba \u0d85 \u0db8\u0dd4\u0dcf\u0dc1\u0dbd\u0dca \u0dc1\u0dcf\u0dc0\u0dca\u200d\u0dd0\u0dd2\u0dbb \u0dc0\u0dca\u200d\u0daf\u0dd2\u0db4 \u0d9a \u0d9a\u0dd0\u0dc1\u0db3\u0dca\u0dc1\u0dca. \u0dad\u0dc0\u0dca\u200d\u0dcf \u0dc1\u0dcf\u0dc0\u0dca\u200d\u0dd0\u0dd2\u0dbb \u0dc0\u0dca\u200d\u0daf\u0dd2\u0db4 \u0d9a \u0d9a\u0dd0\u0db6\u0dd2\u0d9a\u0daf \u0dca\u0dd0\u0dc4\u0dd0. \u0dc1\u0dcf\u0dc0\u0dca\u200d\u0dd0\u0dd2\u0dbb \u0dc0\u0dca\u200d\u0daf\u0dd2\u0db4 \u0d9a \u0d9a\u0dd0\u0dc1\u0db3\u0dca\u0dc1\u0dca \u0dc1 \u0d85\u0d9a \u0dc0\u0dca\u200d\u0dd0\u0d9a \u0dca \u0dcf\u0dad \u0dc0\u0dd4\u0dab\u0daf\u0da7 \u0db4\u0dca\u0dae\u0dc1\u0dca\u0dda. \u0dc1\u0dcf\u0dc0\u0dca\u200d\u0dd0\u0dd2\u0dbb \u0dc0\u0dca\u200d\u0daf\u0dd2\u0db4 \u0d9a \u0d9a\u0dd0\u0db6\u0dd4\u0dab\u0daf\u0da7 \u0db4\u0dca\u0dae\u0dc1\u0dca\u0dda \u0dad\u0dcf\u0dba\u0dd2 \u0dc0\u0dd2\u0dc1\u0dc1\u0dc1\u0dd3\u0d9a \u0dab\u0d9a\u0dc4\u0dd2\u0db8\u0dd2\u0dc1\u0d9a\u0ddd \u0dc4\u0dd2\u0dad\u0dca\u0dc1\u0dca \u0d85\u0db4\u0da7 \u0dc0\u0dca\u200d\u0dd0\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dc0\u0dca\u200d\u0dc5\u0d9a\u0dca \u0dd2\u0dbb\u0dc1\u0db3\u0dca\u0dc0\u0dca\u200d\u0daf \u0dc0\u0dca\u200d\u0dd0\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dc0\u0dca\u200d\u0dc5 \u0dd2\u0dbb\u0dc1\u0db3\u0dca \u0dd2\u0dbb\u0dca\u0daf \u0d85\u0db4\u0dd2 \u0dc1 \u0dab\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0dc0\u0dca\u200d\u0dd4\u0dc4\u0d9c\u0dad \u0dca\u0dca \u0dd0\u0dcf\u0dd0\u0dd2\u0dbb\u0dba\u0dd2 \u0dd2\u0dbb\u0d9a\u0d9a\u0daf. \u0dc4\u0dd2\u0db4 \u0dc1\u0dc4\u0dcf \u0dc0\u0dd4\u0dc1\u0dab\u0dca \u0dca\u0dd0\u0dc4\u0dd0 \u0dd2\u0dbb\u0d9a\u0db8\u0dd4. \u0db3\u0dd0\u0dd2\u0db4 \u0dc1\u0dc0\u0dca\u200d\u0d9a\u0daf\u0dc0\u0dca\u200d\u0dca, \u0d85\u0dc0\u0dca\u200d\u0daf\u0dca\u0dca\u0daf\u0dc0\u0dca\u200d\u0dca\u0dad \u0dc1\u0dc1 \u0dc0\u0dca\u200d\u0dcf\u0daf\u0dc0\u0dca\u200d\u0dca, \u0da7 \u0da7 \u0dc1\u0dca\u0ddc\u0dc0\u0dd2\u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0dc1\u0dc1 \u0dc0\u0dd4\u0dab\u0daf\u0d9a \u0dd2\u0dbb\u0d9a\u0d9a\u0daf \u0dc4\u0dd2\u0dad\u0db8\u0dd4. \u0dad \u0dc1 \u0ddc\u0da7 \u0dc1\u0dcf\u0ddc \u0d9a\u0dca\u0dcf \u0dc1\u0dc0\u0dca\u200d\u0dca\u0dc1\u0dca? \u0dc1\u0dc1 \u0dc1\u0dc0\u0dca\u200d\u0da0\u0dca\u0da0 \u0d9c\u0dcf\u0dca \u0d85\u0db4\u0dd2 \u0dab\u0d9a \u0d85 \u0dc1\u0d9c\u0dca \u0dc1\u0d9c\u0dc0\u0dca\u200d\u0dca\u0dca \u0daf\u0dcf\u0dcf\u0daf\u0dca\u0dcf\u0d9a\u0dca\u0dc0\u0dca\u200d\u0dca, \u0dca\u0dd0\u0dd2\u0dbb \u0da7\u0d9a\u0dca \u0dd2\u0dbb\u0d9a\u0d9a\u0daf \u0dd2\u0dbb\u0d9a\u0db4\u0dd4 \u0d9c\u0dcf\u0dca - \u0dcf\u0daf \u0daf\u0db3\u0dca- \u0d85\u0dc1\u0da7\u0dd2 \u0dd2\u0dbb\u0dd2\u0dba\u0dcf \u0dab\u0d9a\u0dc0\u0dca\u200d \u0dbd\u0dd2\u0db4\u0dd2\u0d9a\u0d9a\u0dca \u0dc1\u0d9a\u0ddd \u0dc1\u0dba\u0dca \u0dd2\u0dbb\u0dd2\u0dba\u0dcf \u0da7\u0d9a\u0dca \u0db4\u0dd2\u0dd2\u0db6\u0d9c\u0dca\u0dc1\u0dca \u0dca\u0dd0\u0dd2\u0dbb \u0dad\u0dca,\u0dca,\u0dc0\u0dca\u200d\u0d9a\u0d9a\u0dca \u0d87\u0dd2\u0dbb \u0dc1\u0dc0\u0dca\u200d\u0dca\u0dc0\u0dca\u200d\u0daf. \u0dc0\u0dd4\u0dbb\u0dd4\u0dca \u0dc1\u0dc4\u0ddd LC \u0d9a\u0dca \u0d94\u0dc5\u0dd4\u0dc1\u0dc0\u0dca\u200d\u0dca \u0dc4\u0dd2\u0da7\u0dc1\u0d9c\u0dca \u0dd2\u0dbb\u0d9a\u0dd4\u0dca, \u0dc5\u0dca, \u0db1\u0daf\u0dad\u0dba\u0dca\u0dad \u0db8\u0dd6\u0d9a\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dcf\u0d9a \u0dc0\u0dd2\u0dd2\u0dba\u0dca \u0db4\u0dd2\u0dd2\u0db6\u0d9c\u0dca\u0dc1\u0dca \u0dca\u0dd0\u0dc4\u0dd0. \u0d85\u0db4\u0da7 \u0dca\u0db3\u0dc4\u0daf \u0dad\u0daf\u0dc0\u0dca\u200d \u0d87\u0dd2\u0dbb \u0d9c\u0dca\u0dca \u0db3\u0dd0\u0dd2\u0db4 \u0dc1\u0dc0\u0dca\u200d\u0dca \u0dcf\u0dc0\u0dca\u200d\u0dc1\u0dca\u0dda \u0daf\u0db3\u0dca \u0dc0\u0dd4\u0dbb\u0dd4 \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0dc5\u0dca, \u0dc1\u0dad\u0dbd\u0dca \u0dca\u0dd0\u0dc0\u0dca\u200d\u0d9a\u0dca\u0dc0\u0dca\u200d\u0dca, \u0db4\u0dd2\u0da7 \u0dc3\u0dca\u0dca \u0dc1 \u0dca\u0dca \u0db3\u0dd0\u0dc4\u0dd0 \u0d9c\u0db1\u0dca\u0dae \u0dc1 \u0dca\u0dca \u0db3\u0dd0\u0dc4\u0dd0 \u0dc1\u0db6\u0dca\u0dca, \u0dc1\u0dc4\u0dda\u0dca, \u0dc1 \u0dca\u0dca \u0db3\u0dd0\u0dc4\u0dd0 \u0d85\u0d9a \u0dbd\u0dd6\u0db1\u0dd4 \u0db8\u0dd2\u0dd2\u0db4\u0dca\u0dae \u0db4\u0dd2\u0db4\u0da7\u0dd2\u0db4\u0dd4 \u0dc0\u0dca\u200d\u0dd0\u0dd2\u0dbb \u0d85\u0dad\u0dba\u0dc0\u0dca\u200d \u0dba \u0dcf\u0daf\u0dab\u0dca\u0da9 \u0dc1 \u0dca\u0dca \u0db3\u0dd0\u0dc4\u0dd0 \u0d9a\u0dca\u0dad\u0dca\u200d\u0dbb \u0daf\u0dcf\u0dad\u0dca\u200d\u0dbb \u0d8b\u0db4 \u0dab \u0dc1 \u0dca\u0dca \u0db3\u0dd0\u0dc4\u0dd0. \u0dc1\u0dc4\u0dcf \u0dc0\u0dd4\u0dc1\u0dab\u0ddc\u0dca, \u0d95\u0dca\u0db1\u0dcf \u0dc1 \u0dc1\u0dca\u0d9a\u0dd4\u0da7 \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0dca\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca\u200d\u0dca \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dd2\u0dcf \u0daf\u0d9a\u0d9a \u0dc1\u0dc0\u0dca\u200d\u0dca\u0dc1\u0dca \u0da2\u0dd3\u0dcf\u0daf\u0dca \u0dc1\u0dcf \u0dba\u0dd2.\n\n\u0dc1 \u0dad\u0dcf\u0dba\u0dd2 \u0db4 \u0dcf \u0d87\u0dca,\u0dad. \u0dc1 \u0d87\u0dca,\u0dad\u0da7 \u0dc0\u0dca\u200d\u0da9\u0daf \u0dc1\u0dc0\u0dca\u200d\u0dca \u0dc1\u0dcf\u0d9a\u0d9a\u0dca \u0dd2\u0dbb\u0dc1\u0db3\u0dca\u0dc0\u0dca\u200d\u0daf \u0dca \u0dd2\u0dbb\u0d9a\u0dca\u0dca. \u0dca\u0dd0\u0dca,\u0dca \u0dc1 \u0db4\u0dd2\u0dd2\u0db6\u0d9c\u0dca\u0dca. \u0db4\u0dd2\u0dd2\u0db6\u0d9c\u0dca\u0dca \u0db3\u0dd0\u0dd2\u0db4 \u0dca \u0dc1 \u0daf\u0d9a\u0d9a\u0dca \u0d94\u0d9a\u0dca\u0dc1 \u0ddd\u0dcf \u0d85\u0dca\u0dad\u0dba \u0dc0\u0dca\u200d\u0daf"
  },
