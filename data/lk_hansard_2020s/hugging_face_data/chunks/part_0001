    "chunk_text": "\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dca\u0dcf\u0dbb\u0dd6\u0daa \u0d9c 9 \u0db8\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0db4\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbd\u0d9a \u0dc1\u0d9c\u0dcf\u0da9\u0dca\u0dd0\u0d9f\u0dd2\u0dbd\u0dca\u0dbd\u0d9a \u0dc4\u0dd0\u0dd4\u0dc0\u0dcf, \u0db4\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dc1\u0dbd\u0dca \u0dcf 9\u0dc0\u0dca\u0da7 \u0dc1\u0db4\u0dcf \u0d9a \u0da7\u0dd2\u0d9a \u0dd4\u0dca\u0dca\u0dcf, \u0db4\u0dad \u0db4\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dc1\u0dbd\u0dca \u0dcf 9\u0dc0\u0dca\u0da7 \u0db4\u0dcf\u0dc0\u0dc4\u0dca \u0da7\u0dd2\u0d9a \u0dd4\u0dca\u0dca\u0dcf \u0d9a\u0dd2\u0dba \u0db4\u0dbd\u0dcf \u0dca\u0db4\u0dad \u0dc1\u0db4\u0dad \u0dcf 9\u0dc0\u0dca\u0dc1\u0dda \u200d\u0dbb \u0dbb\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0db3\u0dca\u0dca \u0d85\u0db4\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba \u0db4\u0dcf\u0dc0\u0d9a \u0dbd\u0dd0\u0dc1\u0db6\u0dca\u0dc1\u0dca \u0dca\u0dd0\u0dc4\u0dd0. \u0d85\u0dc1\u0dca \u0dcf 9\u0dc0\u0dca \u0d85\u0dcf \u0db4 \u0d9a \u0dc1\u0dc0\u0dbd\u0dcf \u0dd2\u0db1\u0da7\u0dd2\u0dca \u0d89\u0dad\u0dcf\u0db8 \u0d85\u0dc3\u0dca\u0dad\u0dca\u200d\u0dba\u0dda \u0dad \u0d9a \u0d9a\u0dc0\u0dba \u0db4 \u0db6\u0dbd\u0dca\u0dca. \u0d85\u0db4\u0dd2 \u0dc4\u0dd0\u0db8\u0dcf\u0dcf\u0db8 \u0d9a\u0dd2 \u0dc1 , \u0dcf 9\u0dc1\u0dc0\u0ddd \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0db4\u0dad \u0dba\u0dc1\u0da7\u0dca \u0dc0\u0da7\u0dd2\u0dca\u0dcf\u0db8 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db4\u0dad\u0db4\u0dad; \u0d85\u0dc1\u0dca \u0dba \u0dc1\u0da7\u0dca \u0d85\u0dca\u0dcf\u0d9c\u0dad\u0dba \u0db4 \u0d9a\u0dd2\u0dba \u0db4\u0dbd\u0dcf\u0dba\u0dd2. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0dc1\u0dc4\u0da7 \u0dcf\u0dc0\u0dc1\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc1\u0dbd\u0ddd\u0d9a\u0dba \u0db4 \u0daf\u0dd2\u0dca\u0dca\u0dc1\u0dca \u0d85\u0dc1\u0dca \u0dcf 9 \u0dc1\u0dc0\u0ddd \u0d9a\u0dd2\u0dba \u0db4\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0d9a\u0dd2 \u0dc0\u0dcf. \u0dca\u0db8\u0dd4 \u0d9a \u0dc1\u0d9a\u0dcf\u0dc1\u0dc4\u0dbb \u0dc1\u0dbd\u0ddd\u0d9a\u0dba \u0db4 \u0daf\u0dd2\u0dca\u0dca\u0dca\u0dcf? \u0d85\u0db4\u0dd2 \u0db4\u0dcf\u0dba, \u0dc1\u0db6\u0ddd\u0d9a\u0d9a\u0dd4\u0dc0, \u0d9a\u0dcf\u0dab\u0dd4\u0dc0, \u0d85\u0db0\u0dd2\u0dc1 \u0d9c\u0dd3 \u0db8\u0dcf\u0d9a\u0d9c, \u0da2\u0dcf\u0dad\u0dba\u0dca\u0dad\u0dba \u0d9c\u0dd4\u0dc0\u0dca \u0dc1\u0dad\u0dcf\u0db8\u0dca\u0dc1\u0db4\u0dcf\u0dc5, \u0da2\u0dcf\u0dad\u0dba\u0dca\u0dad\u0dba \u0dc0\u0dba\u0dcf\u0dba \u0db4 \u0dc0\u0dcf\u0dc1\u0dda \u0d94\u0d9a\u0dc1\u0d9a\u0ddd\u0db8 international \u0dc0\u0dd0\u0da9 \u0d9c\u0dd0\u0dca \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf\u0da7 \u0dc1\u0dcf\u0dba\u0dd2\u0dba \u0db4\u0dc1\u0dca, \u0d85\u0dcf \u0dc1\u0dc0\u0dca\u0dc1\u0d9a\u0dcf\u0da7 \u0dc1\u0db4\u0dad \u0dba\u0dc1\u0da7\u0dca \u0dcf 9\u0dc0\u0dca\u0dc1\u0dda \u0dad \u0d9a \u0d9a\u0dc0\u0dba \u0db4 \u0d89\u0dad\u0dcf\u0db8 \u0dc1\u0dda\u0dcf\u0db1\u0dd3\u0dba \u0db4 \u0dad\u0dd0\u0dca\u0d9a \u0dad\u0dd2\u0dc1\u0db6\u0dca\u0dc1\u0dca.\n\n\u0db4\u0dc0\u0dcf \u0d85\u0dc1\u0dca \u0dcf 9\u0dc1\u0dc0\u0ddd \u0d89\u0dad\u0dcf \u0d85\u0dc3\u0dca\u0dad\u0dca\u200d\u0dba\u0dda \u0dad \u0d9a \u0d9a\u0dc0\u0dba \u0db4\u0da7 \u0db4 \u0d9a \u0dc0\u0dd3\u0db8 \u0dd2\u0db1\u0dd4 \u0dc1\u0dc0\u0db8\u0dd2\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0dca\u0dc0\u0dcf \u0dca\u0db4\u0dad \u0d91\u0dba \u0db4 \u0d89\u0dad\u0dcf \u0d9a\u0dca\u0d9c\u0dcf\u0db8\u0dca\u0dcf\u0dcf\u0dba \u0db4\u0d9a \u0dc1\u0dda\u0dcf\u0db1\u0dd3\u0dba \u0db4 \u0dad \u0d9a \u0d9a\u0dc0\u0dba \u0db4\u0d9a \u0dc4\u0dd0\u0da7\u0dd2\u0dba \u0db4\u0da7\u0dba\u0dd2 \u0db8\u0db8 \u0dcf\u0d9a\u0dd2\u0dca\u0dc1\u0dca. \u0db8\u0db8 \u0dc1\u0db4\u0dad \u0d9a 9\u0dab\u0dd4 \u0d9a\u0dcf\u0dba\u0dda\u0dcf \u0d9a\u0dd2\u0dba \u0db4\u0dca\u0dc1\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc5\u0db8\u0dcf\u0dba\u0d9a\u0dc2\u0dca\u0da8\u0d9a \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dc1\u0dad \u0dc3\u0dca\u0dad\u0dca\u200d\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf \u0dc1\u0dbd\u0dca\u0d9b\u0dca\u200d\u0dca \u0d85\u0db1\u0dd4\u0dc0.\n\n\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dca\u0dcf\u0dbb\u0dd6\u0daa \u0d9c 9 \u0db8\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 2223 \u0da2\u0dca\u0dc0\u0dcf\u0dbb\u0dd2 \u0d89\u0db3\u0dbd\u0dcf \u0dc1\u0dca\u0dcf\u0dc0\u0dd0\u0db4\u0dad\u0db6\u0d9a 15 \u0dcf\u0d9a\u0dc0\u0dcf \u0dcf 9\u0dc0\u0dca \u0dc4\u0dd2\u0d82\u0dc3\u0dca\u0dad\u0dca\u200d\u0dca\u0dba \u0db4\u0da7 \u0db4 \u0d9a\u0dc0\u0dd3\u0db4\u0dad \u0d85\u0db4\u0dc1\u0dba \u0db4\u0ddd\u0da2\u0dca\u0dba \u0db4\u0da7 \u0dbd\u0d9a\u0dc0\u0dd3\u0db8 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4 \u0daf\u0d82\u0db8 \u0dcf\u0dd0\u0dbb\u0dd2\u0dba \u0db4\u0dca \u0d9c\u0dd0\u0db6\u0dca\u0dbd \u0d9c\u0dd0\u0db1\u0dd3\u0db4\u0dad \u0dc3\u0dca\u0dad\u0dca\u200d\u0db4\u0dad\u0db6\u0dca\u0db0 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dd2 8 362\u0d9a \u0dbd\u0dd0\u0db6\u0dd2\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0dca\u0dc0\u0dcf. \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dc1\u0db4\u0dcf\u0dbd\u0dd3\u0dd2\u0db1\u0dc1\u0dad \u0dc0\u0dcf\u0d9a\u0dad\u0dcf\u0dc0 \u0d85\u0db1\u0dd4\u0dc0 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dd0\u0dca \u0dad\u0dd0\u0db4\u0dad\u0db6\u0d9a \u0db8\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dc1\u0dad \u0dcf 9\u0dc0\u0dca 168\u0d9a \u0daf\u0dd6\u0dc2\u0dca\u0da8\u0dda\u0dba \u0db4 \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0dca\u0dc0\u0dcf. \u0d91\u0dba\u0dd2\u0dca \u0dcf\u0dd0\u0dbb\u0dd2\u0dba \u0db4\u0dca 22\u0d9a \u0d9c\u0dd0\u0db6\u0dca\u0dbd \u0d85\u0dba\u0dc1\u0d9c\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0dca\u0dc0\u0dcf. 2223 \u0d94\u0d9a\u0dc1\u0dad\u0ddd\u0db6\u0d9a \u0db8\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dc1\u0dad \u0dcf 9\u0dc0\u0dca 131\u0d9a \u0daf\u0dd6\u0dc2\u0dca\u0da8\u0dda\u0dba \u0db4 \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0dca\u0dc0\u0dcf. \u0d91\u0dba\u0dd2\u0dca \u0dcf\u0dd0\u0dbb\u0dd2\u0dba \u0db4\u0dca 12\u0d9a \u0d9c\u0dd0\u0db6\u0dca\u0dbd \u0d85\u0dba\u0dc1\u0d9c\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0dca\u0dc0\u0dcf. \u0d91\u0dc1\u0dc4\u0db8 \u0dc1\u0dd2\u0dc0\u0dbd\u0dca \u0dc1\u0db4\u0dad \u0dba\u0dc1\u0da7\u0dca \u0dd2\u0db1\u0dd2\u0db0 \u0dc1\u0dc0\u0dd2\u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0db4\u0dcf\u0dba \u0dc4\u0dcf\u0dca \u0d91\u0d9a\u0dba\u0dd2 \u0dc1\u0db6\u0ddd\u0d9a\u0d9a\u0dd4\u0dc0 \u0dc4\u0dcf\u0dca \u0d91\u0d9a\u0dba\u0dd2 \u0d9a\u0dcf\u0db1\u0dd4 \u0dc4\u0dcf\u0dca \u0d91\u0d9a\u0dba\u0dd2 \u0d9c\u0dd0\u0dca \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0dca\u0dc0\u0dcf."
