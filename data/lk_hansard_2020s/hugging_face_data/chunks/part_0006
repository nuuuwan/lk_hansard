    "chunk_text": "\u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0d85\u0dc1\u0db4\u0dcf .\u0d91\u0da9\u0dd2\u0dad \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba, \u0dc1\u0db4\u0dad \u200d\u0dbb \u0dcf\u0db1 \u0db1\u0dd2\u0dc3\u0dcf \u0dc0\u0da9\u0dcf \u0d9a\u0db8 .\u0d91\u0da9\u0dcf\u0dc0\u0da7 \u0db4 \u0d9a \u0dc1\u0dc0\u0da0\u0dca\u0da0 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dad\u0db8\u0dba\u0dd2 \u0dbd\u0dd2\u0db4\u0dcf\u0db4 \u0d9a \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba. \u0dc1\u0db4\u0dad \u0d9a\u0da9\u0dd4\u0da9\u0dcf\u0dba\u0db8 \u0dbb\u0dd0\u0d9a \u0d9a\u0dcf \u0d9c\u0dd0\u0dd3\u0db8\u0db8 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0d9a\u0ddd\u0d9a \u0dd0\u0dcf \u0dc0 \u0d9a \u0dca\u0d9a\u0dca\u0d9a \u0dca\u0d9a\u0dad\u0dd4 \u0dc1\u0dc0\u0d9a\u0dcf \u0dc1\u0db4\u0dad \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1\u0dca \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0d9a\u0db8\u0d9a \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0db4\u0da7\u0db1\u0dca \u0d9c \u0d9a\u0dc1 \u0d9a, \u0d85\u0dc3\u0dcf\u0dc0\u0dd0\u0dc3\u0dd4\u0db8 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0d9a\u0db8\u0d9a \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0db4\u0da7\u0db1\u0dca \u0d9c \u0d9a\u0dc1 \u0d9a, \u0d85\u0db8\u0dcf\u0dbb\u0dd4\u0db8 \u0d85\u0dba\u0da7 \u0dc3\u0dc4\u0dbd\u0dca \u0da7\u0dd2\u0d9a \u0dc1\u0dd9\u0db1\u0dca\u0db1 \u0db4\u0da7\u0db1\u0dca \u0d9c \u0d9a\u0dc1 \u0d9a. \u0dc1\u0db4\u0dad\u0dc0\u0dcf \u0daf\u0dd3\u0d9a\u0dcf \u0d9a\u0dcf\u0dc1\u0db4\u0ddc\u0dc1\u0dba\u0ddc \u0d9a\u0dad\u0dd4 \u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d85\u0dba \u0d85\u0db1\u0dd2\u0d9a\u0dca \u0dc3\u0db8\u0dcf\u0da2 \u0dc3\u0dcf\u0dae\u0dba \u0dc1\u0d9c\u0ddc\u0da9\u0db1\u0d9c\u0db1\u0dca\u0db1 \u0dc0\u0dd0\u0da9 \u0d9a\u0dba\u0db1\u0dc0\u0dcf \u0dc0\u0dcf\u0dc1\u0dda\u0db8, \u0d85\u0db8\u0dcf\u0dbb\u0dd4\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc1\u0db4\u0dad \u0dc1\u0dc0\u0d9a\u0dcf\u0dc1 \u0dc1\u0d9c\u0ddc\u0da9\u0db1\u0d9c\u0db1\u0dca\u0db1\u0dba\u0dd2. \u0dc1\u0db4\u0dad \u0dba\u0dc1\u0da7\u0dca \u0dbd\u0dd2 \u0d85\u0dba \u0d9a\u0dba\u0db1 \u200d\u0dbb\u0dad\u0dd2\u0db4 \u0d9a\u0dad\u0dd2\u0dba \u0da7 \u0d94 \u0dad\u0dd4\u0db8\u0dcf\n\n\u0d92\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0db4\u0dc5\u0dd4\u0dc0\u0dc0\u0dd0\u0db1\u0dd2 \u200d\u0dbb \u0dcf\u0db1\u0dba\u0da7 \u0dda \u0d9a\u0dad\u0dba\u0dba. \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba \u0dc3\u0db4\u0dad \u0db1\u0dca\u0db0\u0dca\u200d\u0dc1\u0dba\u0db1\u0dca \u0db8\u0da7 \u0dc0\u0da9\u0dcf \u0dc1\u0dc4\u0ddc\u0db3\u0dd2\u0db1\u0dca \u0dd9\u0db1\u0dca\u0db1\u0dcf \u0dc1\u0d9a\u0dc1\u0db1 \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7, \u0dba\u0db1\u0dd2\u0dbd\u0dca \u0daf\u0dd4\u200d\u0dbb\u0db8\u0dd2\u0db1\u0dcf\u0dc4 \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0dda \u0dd9\u0dbb\u0dca \u0db1\u0dba \u0d9c\u0dd0\u0db1 \u0d9a \u0dc1\u0dc4\u0ddc\u0db3 \u0d85\u0dc0\u0dc1 \u0ddd\u0db0\u0dca\u200d\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1\u0d9a\u0dc1\u0db1 \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0d94 \u0dad\u0dd4\u0db8\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dc1 \u0daf\u0dd3 \u0dca\u0d9a\u0da7 \u0dca\u0d9a\u0dad\u0dd4 \u0dc1\u0dc0\u0d9a\u0dcf \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd0\u0da9 \u0d9a\u0dba\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf \u0dc1\u0db4\u0ddc\u0dc1\u0dba\u0ddc \u0d9a\u0dad\u0dd4\u0dc0 \u0d87\u0dad\u0dd4\u0dc0 \u0d94 \u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0dda \u0dc1\u0dd9\u0dc0\u0dd0\u0db1\u0dd2 \u200d\u0dbb \u0dcf\u0db1\u0dba\u0da7 \u0dda \u0d9a\u0dad\u0dba\u0dba\u0d9a\u0dca \u0dc1\u0dd9\u0db1\u0dc0\u0dcf."
  },
