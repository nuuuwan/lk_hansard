    "chunk_text": "\u0da7 \u0d85\u0dbb\u0dcf\u0dc0 \u0dc1\u0db8\u0dca \u0db8\u0dd0 \u0dc0\u0dc0\u0dba\u0da7\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db4\u0dc3\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0dc1\u0dda -2025\u0daf\u0dd3- \u0dbd\u0d82\u0dd9\u0dcf \u0dba\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0da2\u0dcf\u0dad\u0dba\u0db1\u0dca\u0dad\u0dba \u0dd6\u0dbd\u0dbd\u0dba \u0d85\u0dba\u0db8\u0dd4:\u0dbd \u0dc3\u0db8\u0d9f \u0dd2 \u0dc0 \u0dd9\u0dba\u0dc1\u0d9c\u0db1 \u0dc0\u0dc1\u0db6\u0db1 \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u200d\u0dad\u0dcf\u0dc0 \u0db8\u0dad \u0dc0\u0dd2\u0dc1\u0dda \u0da7\u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0dc1\u0db8\u0dca \u0d85\u0dc0 \u0dba\u0dad\u0dcf\u0dc0\u0dca \u0dc0\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0da7 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0dc0\u0dd2\u0dc1\u0dda \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0db4\u0dba\u0dad\u0dba\u0dba\u0dca - foreign resource gap \u0d91\u0dd9\u0dca - \u0dd2 \u0dc0 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0dad\u0dc0 \u0db8\u0dcf\u0dc3 6\u0dd2\u0dc4\u0db1\u0dca \u0dd2\u0dc4\u0db1\u0dca \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dda 2025\u0daf\u0dd3 \u0dd2\u0dc1\u0db8\u0dbb\u0dd2\u0dd9\u0dcf\u0dbb\u0dcf \u0dc1\u0da9 \u0dbd\u0dbb\u0dca \u0da7\u0dca\u0dbd\u0dd2\u0dba\u0db1 5 08 \u0dd9.\n\n\u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dd6\u0db4\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0d9c\u0dd2\u0dba \u0dc0\u0dbb\u0dca\u0dc2\u0dc1\u0dda\u0daf\u0dd3 VAT \u0dd2\u0dad\u0dd4\u0dc5\u0dd4 \u0d85\u0dc1\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0db6\u0dd4\u0db4 \u0dc0\u0dbb\u0dca\u0d9c \u0db4\u0db1\u0dc0\u0dbd\u0dcf \u0db6\u0dd4\u0db4 \u0dc1\u0db1 \u0dc0\u0db1 \u0dbd\u0dcf\u0db7 \u0dbd\u0dcf\u0db7\u0dcf\u0d82 \u0dc3\u0db1 \u0dc1\u0db4 \u0db1 \u0dba\u0db1\u0dcf\u0daf\u0dd2\u0dba \u0d85\u0dba \u0dd9\u0dba\u0dbd\u0dcf \u0db8\u0dd4\u0dc5\u0dd4\u0db8\u0db1\u0dd2\u0db1\u0dca\u0db8 \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dcf\u0d9c\u0dcf\u0dba\u0dba \u0d91\u0dd9\u0dad\u0dd4 \u0dd9\u0dba\u0dbd\u0dcf \u0dc0\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0da7\u0dca\u200d\u0dbb\u0dd2\u0dbd\u0dd2\u0dba\u0db1 3\u0dba\u0dd2. \u0d91\u0daf\u0dd2\u0dc1\u0db1:\u0dcf \u0dc0\u0dd2\u0dba:\u0db8\u0dca \u0da7\u0dd2\u0dd9 \u0dd9\u0dba\u0dbd\u0dcf \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dc1\u0d9c\u0db1 \u0dba\u0db1\u0dca\u0db1 \u0d85\u0dc0 \u0dba \u0dc0\u0dd2\u0dba:\u0db8 \u0da7\u0dca\u200d\u0dbb\u0dd2\u0dbd\u0dd2\u0dba\u0db1 4.6\u0dba\u0dd2. \u0d91\u0daf\u0dd2\u0dc1\u0db1:\u0dcf \u0dc0\u0dd2\u0dba:\u0db8\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dc1\u0d9c\u0db1 \u0dba\u0dcf\u0db8 \u0dd2\u0dc4\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dba\u0dcf\u0da2\u0dba \u0dc1\u0dc3\u0dda\u0dc0\u0dd9 \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc1\u0d9c\u0dc0\u0dd3\u0db8 \u0dc0\u0dd2\u0dbb\u0dcf\u0db8\u0dd2\u0dd9 \u0dc1\u0da2\u0dba\u0dc2\u0dca\u0db0 \u0db4\u0dd4\u0dba\u0dc0\u0dd0\u0dc3\u0dd2\u0dba\u0db1\u0dca\u0da7 \u0dc0\u0dd2\u0dbb\u0dcf\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc1\u0d9c\u0dc0\u0dd3\u0db8 \u0d85\u0dc3\u0dca\u0dc0\u0dd0\u0dc3\u0dd4\u0db8 \u0dc3\u0dc4\u0db1\u0dcf\u200d\u0dcf\u0dba \u0da7\u0dd2\u0dd9 \u0dc1\u0d9c\u0dc0\u0dd3\u0db8 \u0d8a\u0dc5\u0d9f\u0da7 \u0da7\u0dba\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc1\u0dd9 \u0da7\u0dc3\u0dca \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca\n\n1829 1830\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0db1\u0dd0 \u0dc0\u0dc0 \u0dc1\u0db4 \u0dbd\u0dd2\u0dba \u0dc0\u0dd2\u0dad\u0dba\u0dca \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0dc0\u0dc1\u0db6\u0db1 \u0db8\u0dd4:\u0dca\u0dbd \u0da7\u0dd2\u0dd9\u0dad\u0dca \u0d9c\u0dad\u0dca\u0dad\u0dcf\u0db8 \u0da7 \u0d94\u0dca\u0dc1\u0dd9 \u0db8 \u0da7\u0dca\u200d\u0dbb\u0dd2\u0dbd\u0dd2\u0dba\u0db1 4.6\u0dca. \u0dd9\u0dc0\u0dd4\u0dbb\u0dd4 \u0dba\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0d9c\u0dad\u0dca\u0dad\u0dad\u0dca \u0db8\u0dcf\u0dc1\u0dc3\u0dda \u0d85\u0db1\u0dca \u0dc0\u0db8 \u0dc0\u0db1\u0dc1\u0dd9 \u0da7 \u0dba\u0dcf\u0da2\u0dba \u0dc1\u0dc3\u0dda\u0dc0\u0dd9\u0dba\u0db1\u0dca\u0da7 \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1; \u0dc0\u0dd2\u0dbb \u0dcf\u0dcf\u0db8\u0dd2\u0dd9\u0dba\u0db1\u0dca\u0da7 \u0dc0\u0dd2\u0dbb\u0dcf\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1; \u0dc3\u0d85\u0dc3\u0dca\u0dc0\u0dd0\u0dc3\u0dd4\u0db8\u0dc3 \u0db4\u0dca\u200d\u0dbb \u0dc0\u0dbd\u0dcf\u0db7 \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1; \u0dba\u0dcf\u0da2\u0dba \u0da7\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc1\u0db4 \u0db1 \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dc1\u0db8\u0dca \u0da7\u0dd2\u0dd9 \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0dba:\u0dcf\u0dba\u0db8\u0dca \u0dd9\u0dc0:\u0dcf\u0dc0\u0dad\u0dca \u0d91\u0dd9\u0dad\u0dd4 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0db8\u0dca \u0dc0\u0dad\u0dcf\u0dc1\u0dda \u0dad\u0db8\u0dba\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0\u0dad\u0dcf\u0dc0\u0da7 \u0dba\u0dcf\u0da2\u0dba \u0dc1\u0db4 \u0dbd\u0dd2\u0dba \u0db1\u0dd0 \u0dc0\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8\u0dd2\u0dd9 \u0d9c\u0dd2\u0dab\u0dd4\u0dc1\u0db8\u0dca \u0d85 \u0dc0\u0dbb\u0dd2\u0dca\u0dad\u0dba\u0dca \u0dd2 \u0dc0 \u0dd9\u0dba\u0dc1\u0d9c\u0db1 \u0dc0\u0dc1\u0db6\u0dc1\u0db1\u0dca \u0db1\u0dca. \u0db4\u0dca\u200d\u0dbb \u0dc0\u0dc0\u0dba\u0dd4\u0dc4\u0d9c\u0dad\u0dd9\u0dba\u0da7\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u200d\u0dc1\u0dba\u0db1\u0dca \u0dc0\u0db1 \u0db4\u0db1\u0dc1\u0dad\u0dca \u0dc1\u0dd9 \u0db1\u0dca\u0dc1\u0dda\u0dc3\u0dd2\u0dba\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0db8\u0dd3\u0da7 \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dda \u0d91\u0db1 \u0dc4\u0dd0\u0db8 \u0dba\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0db8 \u0dba\u0dcf\u0da2\u0dba \u0d85\u0dba \u0dc0\u0dd0\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8\u0dd2\u0dd9 \u0d9c\u0dd2\u0dab\u0dd4\u0dc1\u0db8\u0dca \u0d85 \u0dc0\u0dbb\u0dd2\u0dca\u0dad\u0dba\u0dca \u0dd2 \u0dc0 \u0dd9\u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8. \u0d91\u0dc1\u0dc4\u0db8 \u0dd2 \u0dc0 \u0dd9\u0dba\u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dca \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0da7\u0dba \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0da2\u0dcf\u0dad\u0dba\u0db1\u0dca\u0dad\u0dba\u0dba \u0d85\u0db4\u0da7 \u0dc3\u0dc4\u0dc1\u0dba\u0ddd\u0d9c\u0dba \u0dc1:\u0db1\u0dca\u0dc1\u0db1\u0dca \u0da7 \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8 \u0da7 \u0dba\u0dd9\u0dcf\u0dba\u0dc1\u0dba\u0db1\u0dca \u0d89\u0dc2\u0dca\u0da7 \u0dd9\u0dc1\u0dc5 \u0dad\u0dca \u0db4\u0db8\u0da7\u0dba\u0dd2."
  },
