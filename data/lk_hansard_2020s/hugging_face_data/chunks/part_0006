    "chunk_text": "\u0db8\u0dd6\u0dbd\u0dc1\u0dc4\u0db1\u0dc1\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0dc4\u0dd0\u0db3\u0dd0\u0dba\u0dd2 \u0d85\u0db4\u0da7 \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dc1 \u0dc1\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dc1\u0dbb \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d89\u0da9 \u0dc4\u0dd0\u0dbb\u0dd2 \u0dc1\u0dc1\u0daf\u0ddd \u0d9a\u0dd2 \u0db1 \u0dc4\u0dd0\u0d9a . \u0dc1\u0db8\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dd2\u0db1\u0dc1 \u0d9a\u0dca \u0d9a\u0dbb\u0dbd\u0dc1 \u0dc4\u0dbb\u0dd2 \u0db1\u0dd0\u0dc0\u0dad \u0db3\u0dbd \u0da7 \u0d91\u0db1\u0dca\u0db1 \u0dd1\u0db1\u0dd1 \u0d9a\u0dd2 \u0db1 \u0d85\u0dc1\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dc1\u0dc1\u0dc0\u0db1\u0dca \u0d92\u0dc0\u0dc1 \u0db8\u0d9f \u0dc4\u0dd0\u0dbb\u0dd2 \u0dc1\u0daf, \u0d91\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0d92 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dd2\u0db1\u0daf\u0dd4 \u0d9a\u0dbb\u0dda\u0daf\u0dd3 \u0db8\u0dca \u0dbb\u0dc1\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0dd2\u0dad\u0dad\u0dc0\u0dc1\u0daf\u0dd3\u0db1\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0dc4\u0d9a\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0d85\u0d82 \u0dc0\u0dbd \u0d89 \u0dc1\u0d9c\u0db1 \u0d92\u0d9a \u0dc4\u0dd0\u0dbd\u0dc3\u0dd4\u0db8\u0dca \u0d9a\u0dc5\u0dc1\u0dc1\u0daf\u0ddd \u0d9a\u0dd2 \u0dbd\u0dc1 \u0dc4\u0dd0\u0d9a \u0d9a\u0dca \u0d85\u0db4\u0da7 \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dc1. \u0db4\u0dc1\u0dc4\u0dca\u0d9a\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dc1\u0dbb \u0dd2\u0db1\u0daf\u0dd4 \u0dc1\u0dc0\u0dbd\u0dc1 \u0daf\u0dd0\u0db1\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 5\u0d9a\u0dca \u0d9c\u0dad \u0dc1\u0dc0\u0dbd\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dc1. \u0d85\u0db4\u0da7 \u0dd2\u0db1\u0da7\u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca \u0daf\u0d9a\u0dca\u0dc2\u0dad\u0db8 \u0dc4\u0db8\u0dd4\u0daf\u0dc1\u0dc0\u0d9a\u0dca \u0dc4\u0dc4 \u0dc1\u0db4 \u0dbd\u0dd3\u0dd2\u0db1 \u0d9a\u0dca. \u0d92 \u0d9c\u0dd0\u0db1 \u0d9a\u0dd2\u0dd2\u0db1\u0db8 \u0dc4\u0dd0\u0d9a \u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0db4 \u0dbd\u0dd3\u0dd2\u0db1 \u0da7 \u0d85\u0daf\u0dc1\u0dc5 \u0dc1\u0dda \u0db4\u0dc1\u0dbd\u0db1 \u0d9a\u0dca\u0dad\u0dd2 \u0dbd\u0dd0\u0db6\u0dd4\u0dc1\u0dab \u0dad\u0dd2\u0db1\u0dca \u0d85\u0db1\u0dd2\u0dc0\u0dc1\u0dbb\u0dca \u0dc1 \u0db1\u0dca\u0db8 \u0d85\u0daf\u0dc1\u0dc5 \u0dc4\u0dd0\u0d9a\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d85\u0dbd\u0dca\u0dbd\u0db1\u0dc0\u0dc1. \u0d9a\u0dd2\u0dd2\u0db1 \u0db8\u0dca\u0db8 \u0dc1\u0dc0\u0dbd\u0dc1\u0dc0\u0d9a \u0dc1\u0dda \u0db4\u0dc1\u0dbd\u0db1 \u0dc4\u0dc4\u0dca\u0dad \u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0db4 \u0dbd\u0dd3\u0dd2\u0db1 \u0da7 \u0db8\u0dca \u0db3\u0dc1\u0db0\u0dc1\u0dc0\u0d9a\u0dca \u0d9a\u0dc5\u0dc1\u0daf, \u0d85\u0db1\u0dca\u0db1 \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0dc0\u0dc4\u0dca\u0dae\u0dc1\u0dc0\u0dbd \u0dad\u0db8\u0dba\u0dd2 \u0dc0\u0dbb\u0daf\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d85\u0dbd\u0dca\u0dbd\u0dc1 \u0d9c\u0db1\u0dca\u0db1 \u0db3\u0dd0\u0dbb\u0dd2 \u0dc1\u0dc0\u0dbd\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d92\u0d9a\u0dba\u0dd2 \u0d87\u0dad\u0dca\u0dad. \u0daf\u0dd0\u0db1\u0dca \u0d85\u0db4\u0da7 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1\u0dbd \u0d9a\u0dd4\u0db8 \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0, \u0dc1\u0dbd \u0d9a\u0dd4\u0db8 \u0dc4\u0dd0\u0d9a \u0dc1\u0db8 \u0d9a\u0d9a\u0dca\u0daf? \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 5\u0d9a\u0dca \u0d9c\u0dad \u0dc1\u0dc0\u0dbd\u0dad\u0dca \u0dc1\u0db8\u0dca \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0dc0 \u0d85\u0dc0\u0dc4\u0dc1\u0db1 \u0dc0\u0dd2\u0db8\u0dbb\u0dca \u0db1 \u0d9a\u0dca \u0dd2\u0db1\u0daf\u0dd4 \u0dc1\u0dc0\u0dbd\u0dc1 \u0db1\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca, \u0d92 \u0dc4\u0dad\u0dba \u0dc1\u0dc4 \u0dc1 \u0d9c\u0db1\u0dca\u0db1 \u0db3\u0dd0\u0dbb\u0dd2 \u0dc1\u0dc0\u0dbd\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d87\u0dba\u0dd2? \u0d92 \u0dc1\u0dc0\u0db1 \u0d9a\u0dd2\u0dd2\u0db1\u0db8 \u0dc1\u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0d9a\u0dca \u0dd2\u0dad\u0db1\u0dca\u0daf\u0dc1 \u0dc1\u0db1 \u0dc1\u0dc0\u0dba\u0dd2, \u0dc1\u0dda \u0db4\u0dc1\u0dbd\u0db1 \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca\u0dd3\u0db8\u0db8 \u0db8\u0dad.\n\n\u0db8\u0dab\u0dca\u0da9\u0dbd\u0dc1 \u0d89\u0db1\u0dca\u0db1\u0dc1\u0d9a \u0da7, \u0d91\u0d9a\u0da7 \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dc4\u0dc1\u0d9a\u0da0\u0dca \u0dc1 \u0d9a\u0dbb\u0db1\u0dc1\u0d9a \u0da7, \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dc1 \u0d91\u0db1 \u0da2\u0db1\u0dc1\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0da7 \u0dc1\u0db4 \u0dc1\u0dc4 \u0da7\u0dca\u0da7\u0dd4\u0dc1\u0dda \u0dc4\u0dc4\u0dc1 \u0ddd\u0d9c \u0dbd\u0db3\u0dc1 \u0d9c\u0db1\u0dca\u0db1 \u0dda\u0dad\u0dca\u0dc4\u0dc1\u0dc4 \u0d9a\u0dbb\u0db1\u0dc1\u0d9a \u0da7 \u0da2\u0dd3\u0dc0\u0dd2\u0dc1\u0dad\u0dca\u0da7 \u0dc0\u0dd2 \u0dca\u0dc0\u0dc1\u0dc4 \u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0d9a\u0dbb\u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0daf \u0dbb\u0db1\u0dd2\u0dbd\u0dca- \u0dbb\u0dc1\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc1\u0dc0\u0db1\u0dca, \u0d91\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0dbb\u0db1\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dd2\u0db1\u0d82\u0dc4 \u0da2\u0db1\u0dc1\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb \u0dc1\u0dc1\u0d9c\u0db1\u0dca \u0dc4\u0dc1\u0db0\u0dc1\u0dbb\u0dab \u0d9a\u0dca \u0d89\u0da7\u0dd4 \u0dc1\u0dc0\u0dba\u0dd2 \u0d9a\u0dd2 \u0dbd\u0dc1? \u0d91\u0dc1\u0dc4\u0db8 \u0dc4\u0dc1\u0db0\u0dc1\u0dbb\u0dab \u0d9a\u0dca \u0d89\u0da7\u0dd4 \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dd2\u0db1\u0dc1\u0dc4\u0dda\u0dad\u0dca\u0db8 \u0db4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0d9a\u0db8\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d92\u0d9a\u0dba\u0dd2 \u0d87\u0dad\u0dca\u0dad \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 ."
