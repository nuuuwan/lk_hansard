    "chunk_text": "\u0d92 \u0db1\u0dd2\u0dc4\u0dc1 \u0d92 \u0d87\u0dad\u0dca\u0dad \u0d9a\u0dd2 \u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd4\u0dc0, \u0dc1\u0da2\u0dba\u0dc2\u0dca\u0db0 \u0db4\u0dbb\u0dc0\u0dd0\u0dd2\u0db1 \u0db1\u0dca\u0dc1 \u0dad\u0dd0\u0db1\u0dca\u0db4\u0dad\u0dd4 \u0dc4 \u0dc4\u0dc1 \u0dc1\u0db4 \u0dd2\u0db8 \u0dd2\u0db1 \u0da7 15\u0d9a\u0dca \u0dc1\u0daf\u0db1\u0dc0\u0dc1, \u0db4\u0dc1\u0dc4\u0dbd\u0dca \u0dd2\u0db1\u0dc3\u0dd4\u0db1\u0dca\u0da7 \u0daf\u0dd2\u0dc0\u0dc1 \u0d86\u0dc4\u0dc1\u0dbb \u0dc4\u0dc1 \u0dbb\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d86\u0dc4\u0dc1\u0dbb \u0d9a\u0dd2 \u0db1 \u0dc1\u0daf\u0d9a\u0db8 \u0dc1\u0daf\u0db1\u0dc0\u0dc1, \u0dc4\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0dd1\u0db1\u0dd1 \u0db1\u0db8\u0dca, \u0dc4\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0dc1\u0daf\u0db1\u0dc0\u0dc1 \u0d9a\u0dd2 \u0dbd\u0dc1 \u0d9a\u0dd2 \u0db1\u0dca\u0db1 \u0db4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dc1\u0daf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0d9a \u0dc1\u0dc4 \u0db8\u0daf? \u0d91\u0dc1\u0dc4\u0db8 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dc0\u0dc1\u0daf? \u0dc1\u0db3 \u0dbb\u0dd4 \u0d9a\u0dd2 \u0dbd\u0dc1 \u0dbb\u0da7\u0d9a\u0dca \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dd2 \u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd4\u0dc0, \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1 \u0d9c\u0dd0\u0dd4\u0dbb\u0dbb\u0dd2\u0db1\u0dca \u0dc4\u0dc1\u0d9a\u0da0\u0dca \u0dc1 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0db8\u0d9a\u0dca\u0db1\u0dd2\u0dc4\u0dc1\u0daf \u0dad\u0dca, \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dba\u0dc0\u0dc4\u0dca\u0dae\u0dc1\u0dc0 \u0d85\u0db1\u0dd4\u0dc0 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0dc4\u0db8\u0dca\u0dd6\u0dbb\u0dbb\u0dca\u0dab \u0db3\u0dbd \u0dc1\u0db8\u0dca \u0d9c\u0dbb\u0dd4 \u0dc4 \u0dc1\u0dc0 \u0db4\u0dd0\u0dc0\u0dc1\u0dbb\u0db1 \u0db1\u0dd2\u0dc4\u0dc1\u0dba\u0dd2.\n\n\u0dd2\u0db1 \u0da7 13 \u0d89\u0d9a\u0dca\u0db8\u0dc0\u0db1\u0dca\u0db1\u0da7 \u0db3\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a. \u0dc1\u0db8\u0dca \u0d9a\u0dd4\u0dbd\u0dd4\u0db1\u0dd4 \u0dad\u0dd4\u0db1 \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0dad\u0db8\u0dba\u0dd2, \u0da2\u0dc1\u0dad\u0dba\u0db1\u0dca\u0dad\u0dbb \u0d91\u0d9a\u0dca\u0d9a \u0d9c\u0db1\u0dd4\u0dc1\u0daf\u0db1\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1\u0db8\u0dca \u0d9a\u0dd4\u0dbd\u0dd4\u0db1\u0dd4 \u0dad\u0dd4\u0db1 \u0d9a\u0da9\u0dbd\u0dc1, \u0daf\u0dc0\u0dc4\u0d9a\u0dca\u0dc0\u0dad\u0dca \u0d85\u0db4\u0da7 \u0dab \u0dc0\u0dbb \u0dd2\u0db8\u0db4\u0dd2 \u0d9a\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0dbd\u0dc1 \u0dc1\u0dad\u0dbd\u0dca \u0dc1\u0d9c\u0db1 \u0d91\u0db1\u0dca\u0db1 \u0db3\u0dd0\u0dc4\u0dd0, \u0d9c\u0dd1\u0dc4\u0dca \u0dc1\u0d9c\u0db1 \u0d91\u0db1\u0dca\u0db1 \u0db3\u0dd0\u0dc4\u0dd0, \u0dc1\u0db3\u0dc1\u0dc4\u0dad\u0dca \u0dc1\u0d9c\u0db1 \u0d91\u0db1\u0dca\u0db1 \u0db3\u0dd0\u0dc4\u0dd0, \u0d9a\u0db1 \u0dc1\u0db3 \u0db1 \u0dc1\u0dda\u0dc0\u0dbd\u0dca \u0dc1\u0d9c\u0db1 \u0d91\u0db1\u0dca\u0db1 \u0db3\u0dd0\u0dc4\u0dd0. \u0dbb\u0da7 \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0."
