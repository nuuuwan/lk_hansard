    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dba \u0d9a\u0dcf\u0dcf\u0db1\u0dcf \u0d9a\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2, \u0db8\u0dc4\u0da2\u0db1 \u0d8b\u0db4\u0dc1 \u0ddd\u0dd2\u0dab\u0dad\u0dcf \u0dc1\u0d9a\u0dcf\u0db8\u0dd2\u0dcf\u0db8\u0da7 \u0db4\u0dc3\u0dd4\u0dd2\u0dab \u0dc1\u0db4\u0db6\u0dba\u0dc0\u0dcf\u0dbb\u0dd2 \u0db8\u0dcf\u0dcf\u0dc1\u0d86, \u0db8\u0dcf\u0dbb\u0dca\u0dad\u0dd4\u0db8 \u0db8\u0dcf\u0dcf\u0dc1\u0d86 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dba\u0db4\u0dd4 \u0dd2\u0db8 \u0dc0\u0dd2\u0dbd\u0dca\u0dbd \u0db6\u0dbd\u0db1\u0dca\u0db1. \u0dd2\u0db8 \u0dc0\u0dd2\u0dbd\u0dca\u0dc1\u0dbd\u0dca \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0db8\u0dc0\u0db8 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf, \u0db8\u0db1\u0dca\u0db1\u0dcf\u0dba\u0dc1\u0db8\u0dca \u0daf\u0dd0\u0db1\u0da7\u0dad\u0dca \u0dbb\u0dd2 \u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc1\u0dc0\u0db1 \u0dc3\u0dd4\u0dc5\u0dcf \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db8 \u0db6\u0dbd\u0dcf\u0d9c\u0dcf\u0dba\u0dc1\u0d86 \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db8 \u0d9a\u0d9a \u0d9a\u0dca \u0dcf\u0db3\u0dc4\u0dcf \u0d87\u0dc1\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0dd4\u0dc0 \u0dc1\u0da9\u0dcf\u0dbd\u0dbb\u0dca \u0dad 8.47\u0d9a\u0dca \u0dc0\u0dd0 \u0dc1\u0dc0\u0db1 \u0db6\u0dc0. \u0d91\u0dad\u0dc1\u0d9a\u0dcf\u0da7 \u0dc1\u0db8\u0dca \u0db6\u0dbd\u0dcf\u0d9c\u0dcf\u0dba\u0dc1\u0d86 \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db8 \u0d9a\u0d9a \u0d9a\u0dca \u0d9a\u0dd3 \u0da7\u0daf \u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0d87\u0dc1\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0dd4\u0dc0 \u0dc1\u0da9\u0dcf\u0dbd\u0dbb\u0dca \u0dad 8.26\u0da7. \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db8\u0db6\u0dbd \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0dc1\u0d86 \u0db4\u0dcf\u0dbd\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dc1\u0d9c\u0db1\u0dca \u0db8\u0db8 \u0d87\u0dc4\u0dd4\u0dc0\u0dcf, \u0dc1\u0da9\u0dcf\u0dbd\u0dbb\u0dca \u0dad 8.26\u0dad\u0dca \u0dc4\u0dbb\u0dd2\u0daf \u0dbb\u0dd3 \u0dbd\u0dcf. \u0d94\u0dc4\u0dd4 \u0dbb\u0dd3 \u0dc0\u0dcf \"\u0db1\u0dd0\u0dc4\u0dd0, \u0d9c\u0dab\u0db1 \u0dad\u0dc0 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf, \u0dc1\u0db8\u0dcf\u0d9a\u0daf \u0d9a\u0da7 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db1 \u0dc0\u0dd2 \u0daf\u0db8\u0dca, loan \u0d91\u0dc1\u0d9a\u0dca \u0d9c\u0dab\u0db1\u0dca \u0daf\u0dcf\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0\" \u0dbb\u0dd3 \u0dbd\u0dcf. \u0d85\u0dc1\u0db1\u0d9a \u0d85\u0db4\u0dd2 \u0dcf\u0dcf\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0db1 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dd2\u0dad\u0dcf \u0dad\u0db1\u0dc0\u0dd2\u0db8\u0db1\u0dca loan \u0d91\u0d9a \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dca\u0dad\u0dca commercial loan rate \u0d91\u0d9a\u0da7 \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2. \u0d85\u0db4\u0da7 \u0dc4\u0db8\u0dca\u0db6 \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca concessionary loan \u0d91\u0d9a\u0d9a\u0dca. \u0dbb\u0dd3 \u0db1\u0dca\u0dc1\u0db1\u0dca \u0d85\u0db4\u0da7 \u0d85\u0dca \u0dc1\u0db4\u0dcf\u0dbd\u0dd3 loan \u0d91\u0d9a\u0d9a\u0dca \u0dc4\u0db8\u0dca\u0db6 \u0dc1\u0dc0\u0dbd\u0dcf, loan \u0d91\u0dc1\u0d9a\u0db1\u0dca \u0dc4\u0daf\u0db4\u0dd4 \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db8 \u0db6\u0dbd\u0dcf\u0d9c\u0dcf\u0dba\u0dc1\u0d86\u0dad\u0dca \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db8 \u0d9a\u0d9a \u0d9a\u0dca \u0d9c\u0dab\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2\u0dba\u0dd2.\n\n\u0d85\u0daf \u0dbb\u0dd3 \u0db1\u0dc0\u0dcf, \u0dc1\u0db8\u0dca\u0dc0\u0dcf \u0d85\u0dba \u0dcf\u0db8\u0dcf\u0d9c\u0db8\u0dca\u0dc0\u0dbd\u0da7 \u0dc1\u0daf\u0db1\u0dca\u0db1, \u0dc1\u0db8\u0dca \u0dcf\u0db8\u0dcf\u0d9c\u0db8\u0dca\u0dc0\u0dbd\u0da7 \u0dc1\u0daf\u0db1\u0dca\u0db1 \u0dbb\u0dd3 \u0dbd\u0dcf. \u0db8\u0db8 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0da7 \u0dbb\u0dd3 \u0db1\u0dca\u0db1\u0db8\u0dca, \u0daf\u0dd0\u0db1\u0dca \u0dc1\u0dda\u0dc1\u0dd3 \u0dcf\u0db8\u0dcf\u0d9c\u0db8\u0dca\u0dc0\u0dbd\u0da7 \u0dc1\u0d9c\u0dc0\u0db1 \u0db8\u0dd2\u0dbd \u0d9c\u0dab\u0db1\u0dca. \u0db4\u0dc3\u0dd4\u0dd2\u0dab \u0daf\u0dc0\u0dcf\u0d9a \u0d91\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0dbb\u0dd3 \u0dc0\u0dcf, \"\u0d85\u0dc1\u0db4\u0dca \u0dba\u0dc1\u0da7\u0dca \u0d91\u0d9a\u0dca \u0dc1\u0db4\u0dcf\u0da9\u0dd2 \u0dc3\u0dd4\u0dc5\u0dcf \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db8 \u0db6\u0dbd\u0dcf\u0d9c\u0dcf\u0dba \u0d9a\u0dca \u0db8\u0db1\u0dca\u0db1\u0dcf\u0dba\u0dc1\u0db8\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf, \u0dc1\u0d9a\u0dca \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db8 \u0d9a\u0d9a \u0d9a\u0dca \u0db1\u0dd2\u0dc2\u0dae\u0db4\u0dcf\u0daf\u0db1 \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0dc0\u0dd0 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 22\u0dba\u0dd2\" \u0dbb\u0dd3 \u0dbd\u0dcf.\n\n\u0db8\u0db8 \u0d9c\u0dd0\u0db1\u0dad\u0dca \u0dbb\u0dd3 \u0db1\u0dca\u0db1\u0db8\u0dca, \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dba \u0d9a\u0dcf\u0dcf\u0db1\u0dcf \u0d9a\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2. \u0db8\u0dcf \u0dc5\u0d9f \u0dc0\u0dd2\u0dcf\u0dae\u0dad\u0dba \u0dd2\u0d9a \u0d94\u0d9a\u0dca\u0dc1\u0d9a\u0ddd\u0db8 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0dc1\u0db4\u0dca \u0dba\u0dc1\u0da7\u0dca \u0dca\u0dbb\u0dca\u0dd2\u0d9a \u0d85\u0dbb\u0dca\u0dd4\u0daf \u0d91\u0db1\u0dca\u0db1 \u0d89\u0dcf\u0dae\u0dc1\u0dcf\u0dbd\u0dca\u0dbd\u0dcf \u0d9a\u0da7\u0dca\u0dd2 \u0dbd\u0dcf\u0dc3\u0dd4 \u0dad\u0dd0\u0dd4\u0dc1 \u0d9a\u0d9a \u0d9a\u0dca \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 16\u0d9a\u0da7 \u0dc1\u0daf\u0db1\u0dc0\u0dcf \u0dbb\u0dd3 \u0dbd\u0dcf\u0dba\u0dd2. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1 \u0dc1\u0da9\u0dcf\u0dbd\u0dbb\u0dca \u0d91\u0d9a\u0d9a \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0dc0\u0dd2\u0db1\u0dcf\u0d9a\u0db8 \u0d9a\u0dd3 \u0daf? \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1 \u0dc1\u0da9\u0dcf\u0dbd\u0dbb\u0dca \u0d91\u0d9a \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 183\u0dba\u0dd2. \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1 \u0dab \u0dc1\u0db4\u0dcf\u0dd2\u0db8 \u0d9a\u0dd3 \u0daf? Single digit. \u0dbb\u0dd3 \u0db1\u0dca\u0dc1\u0db1\u0dca, \u0d91 \u0dc3\u0dd2 \u0da7 10\u0da7 \u0d85\u0dca \u0d85\u0d9c \u0d9a\u0dba\u0dd2 \u0dad\u0dd2\u0dd4\u0dc1\u0da9\u0dd4\u0d9a. \u0dc0\u0db1 \u0dc1\u0d9a\u0dcf\u0da7 \u0d85\u0dc1\u0db4\u0dca \u0dba\u0da7 \u0db6\u0dcf\u0dc1\u0d9a\u0dcf\u0dc1\u0dbd\u0dcf\u0dad\u0dca \u0dbb\u0dd3 \u0dcf \u0db1\u0dd2\u0dc1 \u0daf\u0db1 \u0d9a\u0dba\u0dbd\u0dcf\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0dc1\u0dca\u200d\u0dbb\u0dae\u0dab\u0dd2\u0d9c\u0dad \u0dbb\u0dd3\u0db8\u0dda\u0db8\u0dca\u0dc0\u0dbd\u0dad\u0dca - ratings\u0dc0\u0dbd\u0dad\u0dca - \u0d85\u0db4\u0dd2 \u0dc1\u0dc4\u0dcf\u0db3 \u0db8\u0da7\u0dca\u0da7\u0db8\u0d9a \u0dc3\u0dd2\u0dd2\u0dc1\u0d86. \u0d85\u0db4\u0da7 \u0dc1\u0d9c\u0dc0\u0dd3\u0db8\u0dca \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0dc4\u0dd0\u0dbb\u0dd3 \u0dcf\u0dc0\u0d9a\u0dd4\u0dad\u0dca \u0dad\u0dd2\u0dd4\u0dab\u0dcf. \u0d85\u0dc1\u0db4\u0dca \u0db8\u0dc4 \u0db6\u0dd0\u0dcf\u0d9a\u0dd4\u0dc0\u0da7 \u0dcf\u0dc4 \u0d85\u0dc1\u0db1\u0d9a\u0dca \u0db6\u0dd0\u0dcf\u0d9a\u0dd4\u0dc0\u0dbd\u0da7 \u0db4\u0dca\u200d\u0dbb \u0dae\u0db1 \u0d9a\u0dca \u0dad\u0dd2\u0dd4\u0dc1\u0da9\u0dd4\u0d9a\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0; \u0dca \u0dad\u0db1 \u0da7 \u0db4\u0dca\u200d\u0dbb \u0dae\u0db1 \u0d9a\u0dca \u0dad\u0dd2\u0dd4\u0dc1\u0da9\u0dd4\u0d9a\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db1\u0dd2\u0dcf\u0dcf \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1 \u0d9a\u0da7\u0dca\u0dd2 \u0dbb\u0dd3 \u0dc0\u0dcf \u0d9a\u0d9a \u0d9a\u0dca \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 16\u0d9a\u0da7 \u0dc1\u0daf\u0db1\u0dc0\u0dcf \u0dbb\u0dd3 \u0dbd\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d85 \u0d89\u0daf\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u0db8\u0dca \u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dd4\u0db8 \u0d9a\u0dba\u0db1 \u0dc1\u0d9a\u0dcf\u0da7 \u0dba\u0dc1\u0da7\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0dcf\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dab\u0dc1 \u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dcf\u0dae \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dd4\u0dc1\u0da9\u0dd4\u0d9a. \u0dc1\u0da9\u0dcf\u0dbd\u0dba\u0dc1\u0d86 \u0d85\u0d9c \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 400\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0dbd\u0dcf, \u0dab \u0dc1\u0db4\u0dcf\u0dd2\u0db8 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0dbd\u0dcf, \u0dc1\u0dc1\u0dca\u200d\u0dbb\u0dae\u0dab\u0dd2\u0d9c\u0dad \u0dbb\u0dd3\u0db8\u0dda\u0db8\u0dca\u0dc0\u0dd2\u0db8\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0db4\u0dc4\u0dc5\u0da7 \u0dc0\u0dd0\u0dd2\u0dbd\u0dcf \u0dc3\u0dd2\u0dd2\u0dc1\u0d86. \u0d85\u0dc0\u0dcf\u0dae\u0dcf\u0dcf\u0dc1 \u0d85 \u0db8 \u0d85\u0dc1\u0db4\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0d9a\u0dca \u0d9a\u0dc5\u0dcf, \u0d9a\u0d9a \u0d9a \u0dc0\u0dd2\u0db1\u0dcf\u0d9a\u0db8 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 40\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dc0\u0dad\u0dca \u0dc1\u0d9c\u0db1 \u0db1\u0dca\u0db1 \u0dbb\u0dd3 \u0dbd\u0dcf. \u0d85\u0db4\u0dd2 \u0dbb\u0dd3 \u0dc0\u0dcf, \"\u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 40\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc1\u0d9c\u0db1 \u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0. \u0d94 \u0d9a\u0da7\u0dca\u0dd2 \u0dbd\u0dcf\u0dc3\u0dd4"
  },
