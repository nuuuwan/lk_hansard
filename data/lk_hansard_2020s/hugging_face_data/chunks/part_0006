d\u0dd3\u0db1\u0dca\u0dbd\u0dd2\u0dc0\u0d9a\u0dca \u0db1\u0dd2\u0dc3\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dba\u0db4\u0dd4 \u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0db6\u0dd2\u0d9a \u0dc1\u0d9c\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0dd0\u0dbb\u0dd2\u0dc0 \u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0d9a\u0dba \u0d85\u0dc4\u0dd2\u0db8\u0dd2 \u0dc1\u0dc0\u0da0\u0dca\u0dcf \u0dc1\u0db4\u0dad \u0dba\u0dc1\u0da7\u0dca \u0d85\u0dc4\u0dd2\u0dcf\u0dc3\u0d9a \u0db4\u0dcf\u0dbb\u0dd2\u0dc1\u0dcf\u0ddd\u0dd2\u0dba\u0d9a\u0dba\u0db1\u0dca\u0da7 \u0d85\u0db8\u0dad\u0dba \u0d85\u0dba \u0d9a\u0dd2\u0db8\u0dda\u0db8\u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0dad\u0ddc\u0dba\u0dc0 \u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0d9a\u0dba \u0d9a \u0dcf \u0daf\u0dd3\u0db8\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0dc0\u0db1\u0dca\u0dcf? \u0d91\u0dc1\u0dc3\u0dda \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dba\u0db1 \u0dc1\u0d9a\u0dc3 \u0d85\u0db4\u0dd2 \u0dd2\u0dbd\u0dca\u0d9a\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dcf.\n\n\u0d9c\u0dbb\u0dd4 \u0d9a\u0d82\u0da0\u0db1 \u0dc0\u0dd2\u0dc0\u0dda\u0dc0\u0dc3 \u0d9a\u0dbb \u0db8\u0dc4\u0dad\u0dcf (\u0bc7\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc7\u0bbf\u0b95\u0bc1 \u0b95\u0b9e\u0bcd\u0bc6\u0ba9 \u0bb5\u0bbf\u0bae\u0b9c\u0bae\u0bc6\u0b95\u0bb0) (The Hon. Kanchana Wijesekera) \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2 \u0dc1\u0dba\u0ddd\u0da2\u0dcf\u0dba \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db8\u0db8 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0dba\u0dba\u0dcf \u0dc1\u0d9a\u0dc3 \u0db4 \u0d9a \u0dc0\u0dd4\u0da7\u0dcf\u0da7 \u0db4\u0dc3\u0dcf\u0dc1\u0dc3\u0dda \u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd\u0dba \u0daf\u0dd4\u0dc3\u0db1\u0dca\u0db0\u0dd2 \u0d9a\u0dd2\u0db8\u0dda\u0db4\u0dad \u0d9a\u0dc5\u0dcf \u0d9a\u0dd2\u0dba\u0d9a\u0dcf \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf \u0dc3\u0dc4\u0dc4\u0db1\u0dca \u0d9a\u0dc5\u0dcf. \u0db8\u0db8 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0dba\u0dba\u0dcf \u0dc0\u0da7 \u0db4 \u0d9a \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0dc1\u0db4\u0dba - [ \u0dcf\u0db0\u0dcf \u0d9a\u0dd2\u0db8\u0dda\u0db8\u0d9a\u0dca] \u0db8\u0db8 \u0d92\u0d9a\u0da7 \u0dad\u0db8\u0dd2 \u0dc3 \u0d9a\u0dad\u0dba \u0dc1\u0dcf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d9a\u0d9a \u0d9a \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0d85\u0dc4\u0dc1\u0d9c\u0db1 \u0dd2\u0db1\u0dca\u0db1\u0dc1\u0d9a\u0ddd.\n\n\u0db8\u0db8 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0dba\u0dba\u0dcf \u0dc0\u0da7 \u0db4 \u0d9a \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0dc1\u0db4\u0dba \u0db4\u0dcf\u0dbb\u0dd2\u0dc1\u0dcf\u0ddd\u0dd2\u0dba\u0d9a\u0dc1\u0dba\u0ddd \u0d9a\u0d9a\u0dca\u0dc2\u0dca\u0da8 70\u0da7\u0db8 \u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd\u0dba \u0daf\u0dd4\u0dc3\u0db1\u0dca\u0db0\u0dd2 \u0d9a\u0dba\u0d9a\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0da9\u0dd4; \u0db4\u0dd0\u0dba 14\u0d9a \u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd\u0dba \u0daf\u0dd4\u0dc3\u0db1\u0dca\u0db0\u0dd2 \u0d9a\u0dd2\u0db8\u0dda\u0db4\u0dad \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0da9\u0dd4. \u0d92 \u0dad \u0d9a \u0d9a\u0dc0\u0dba \u0dad\u0db8\u0dd2 \u200d\u0dbb\u0db8\u0dcf\u0db1\u0dd4\u0dd6\u0dbd\u0d9a\u0dc0 \u0dc1\u0dc0\u0db1\u0dc3\u0dcf \u0d9a\u0dba\u0d9a\u0dcf \u0d85\u0dba\u0da9\u0dd4\u0da9\u0dc0 \u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0d9a\u0dba \u0d9a \u0dcf \u0dc1\u0dcf\u0db1 \u0dad \u0d9a \u0d9a\u0dc0\u0dba\u0da7 \u0db4 \u0d9a \u0d9a\u0dc1\u0dc5\u0dda. \u0d85\u0db4\u0da7 \u0dc1\u0dda \u0db4\u0dcf\u0d9a\u0db1 \u0dc3\u0da7\u0db1\u0dca \u0db4\u0dcf\u0db0 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0dc0\u0db1\u0dca. \u0db1\u0db8\u0dd4 \u0d9a \u0d85\u0db4\u0dd2 \u0db1\u0dd2\u0dc0\u0dd0\u0dba\u0dd2\u0db1 \u200d\u0dbb\u0dad\u0dd2\u0db4 \u0d9a\u0dad\u0dd2 \u0dc3\u0dc4 \u0dad\u0dd3\u0db1\u0dca\u0dbd\u0dd2-\u0dad\u0dd3\u0dba\u0da7 \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0d92 \u0d85\u0dc0 \u0dba \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0d9a\u0db8\u0d9a \u0d9a\u0dc5\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf \u0dc3\u0dc4\u0dc4\u0db1\u0dca \u0d9a\u0dba\u0db4\u0dd4 \u0dca\u0d9a\u0dcf\u0dba\u0dba\u0da7 \u0d92 \u0d85\u0dba\u0da7 \u0dba\u0db4\u0dad \u0dc3\u0dc4\u0db1\u0dba\u0d9a\u0dca \u0d9a \u0dcf \u0dc1\u0dcf\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0dc0\u0db1\u0dca\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf\u0dba\u0da7\u0dba \u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0d9a \u0db8\u0da9\u0dd4\u0da9\u0d9a\u0dba \u0d91\u0d9a\u0dca\u0d9a \u0d9a \u0db8\u0dc4\u0da2\u0dcf\u0db1 \u0dc3\u0db4\u0dc1\u0dba\u0ddd\u0dd2\u0dba\u0dad\u0dcf \u0dc1\u0d9a\u0ddc\u0db8\u0dd2\u0dc3\u0db8 \u0d91\u0d9a\u0dca\u0d9a \u0d9a \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0d9a\u0dba\u0db1\u0dca\u0db1\u0db4\u0dad.\n\n\u0db1\u0dd0\u0dc0\u0dad \u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0dc3\u0db4\u0dad \u0db1\u0dca\u0db0\u0dad\u0dcf \u0d9a \u0dcf \u0d9c\u0dd0\u0dd3\u0db8\u0dc1\u0db4\u0dad\u0daf\u0dd3 \u0da2\u0dcf\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0dc3\u0dd2\u0dbd\u0dd2\u0dc0\u0db1 \u0d85\u0db4\u0dc4\u0dc3\u0dd4\u0dad\u0dcf \u0db8\u0d9f \u0dc4\u0dba\u0dc0\u0dcf \u0d9c\u0dd0\u0dd3\u0db8\u0db8 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0db4\u0dc3\u0dd4\u0dd2\u0dba\u0dba \u0d9a\u0dcf\u0d9a\u0dc1\u0dda \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dba \u0dad\u0dd2\u0dc1 \u0db1\u0dc0\u0dcf. \u0dcf\u0dd0\u0db1\u0da7 \u0d91\u0db8 \u0dc3\u0db4\u0dad \u0db1\u0dca\u0db0\u0dad\u0dcf \u0d9a \u0dcf \u0d9c\u0dd0\u0dd3\u0db8\u0dc1\u0db4\u0dad\u0daf\u0dd3\n\n\u0dc3\u0db4\u0dad\u0db4\u0dd6\u0d9a\u0da7 \u0db8\u0dd4\u0dcf\u0d9a \u0d91\u0d9a\u0dc0\u0dba \u0dc1\u0d9c\u0daf\u0dd4\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db1\u0dd0\u0dc4\u0dd0. \u0dc3\u0dd2\u0dba\u0dba\u0da7 25\u0d9a \u0db8\u0dd4\u0dcf\u0d9a\u0d9a\u0dca \u0dc1\u0d9c\u0dc0\u0d9a\u0dcf \u0dd2\u0dad\u0dd2\u0dbb\u0dd2 \u0db8\u0dd4\u0dcf\u0d9a \u0dc0\u0dcf\u0dbb\u0dd2\u0d9a \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0dc1\u0d9c\u0dc0\u0dd3\u0db8\u0da7 \u0d85\u0dc0 \u0dba \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db4\u0dad \u0dcf\u0dd0\u0db1\u0dca \u0dc3\u0db4\u0dba\u0dcf \u0dad\u0dd2\u0dc1 \u0db1\u0dc0\u0dcf. \u0dc3\u0db8\u0dc4\u0dba \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0d9a\u0daf\u0dd3 \u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0d9a \u0db8\u0da9\u0dd4\u0da9\u0d9a\u0dba \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db4\u0dad \u0d9a \u0dcf \u0daf\u0dd3\u0d9a\u0dcf \u0dad\u0dd2\u0dc1 \u0db1\u0dc0\u0dcf. \u0d94 \u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0d85\u0dc1\u0db1\u0d9a\u0dca \u0d9a\u0dcf\u0dba\u0da7\u0dba \u0d9c\u0dd0\u0db1 \u0d9a \u0d9a \u0dcf \u0dc1\u0dcf\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0dc0\u0db1\u0dca \u0dc3\u0dc4\u0db1\u0dba \u0dc1\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0dcf \u0d9a\u0dd2\u0dba\u0d9a\u0dcf \u0d85\u0db4\u0dd2 \u0d9a\u0db1\u0dca\u0db1\u0db4\u0dad. \u0d92 \u0db4\u0dd2\u0dc5\u0dd2 \u0dc4\u0dc0 \u0d9a \u0dcf\u0dd0\u0db1\u0dd4\u0dc0 \u0d9a \u0d9a\u0dba\u0db1\u0dca\u0db1\u0db4\u0dad."
