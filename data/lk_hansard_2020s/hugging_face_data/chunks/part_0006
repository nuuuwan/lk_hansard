    "chunk_text": "\u0dc3\u0db4\u0dcf\u0db0\u0dd2\u0db0\u0dcf\u0dbb\u0dd2 \u0d9a\u0dd8\u0dc2\u0dd2\u0d9a\u0d9a\u0db8 \u0db4\u0d9a\u0dc1\u0dda\u0dc2\u0dca\u0da8\u0da7 \u0dc4\u0dcf \u0db1\u0dd2\u0dc2\u0dca\u0da8\u0dcf\u0db4\u0dcf\u0dcf\u0db1 \u0dc3\u0dc4\u0d9a\u0dcf\u0dba \u0db1\u0dd2\u0d9a\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0da7 \u0dc1\u0d9c\u0ddc\u0daf\u0dd4\u0da2\u0dcf\u0db1 \u0dc3\u0dcf\u0dc0\u0d9a\u0db0\u0db1 \u0db1\u0dd2\u0d9a\u0db0\u0dcf\u0dbb\u0dd2 \u0dad\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0dc3\u0dc4\u0dc4\u0dcf \u0dc0\u0db1 \u0dc3\u0dd3\u0db8\u0dd2\u0dad \u0dc4\u0dc0\u0dcf \u0d9c\u0dd0\u0dd3\u0db8\u0dc1\u0db4\u0dad \u0daf\u0dd4\u0dcf\u0dcf\u0d9c\u0dba\u0da7 \u0dd2\u0dd2\u0db1\u0dbb\u0dd2\u0db4 \u0d9a \u0dc0\u0dd3\u0db8 \u0dc3\u0dc4\u0dc4\u0dcf \u0d85\u0dcf\u0dcf\u0dc5 \u0dc4\u0dc0\u0dcf \u0d9c\u0dd0\u0dd3\u0db8\u0dc1\u0db4\u0dad \u0db4\u0da7\u0dd2\u0db4\u0dcf\u0da7\u0dd2\u0dba \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca \u0d85\u0dc0\u0dc3\u0dcf\u0dae\u0dcf\u0dc0 \u0dc3\u0d9a\u0dc3\u0dcf \u0daf\u0dd3 \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dba \u0dad\u0dc0\u0dbd\u0dd2\u0dba\u0da7 \u0d9a \u0dc3\u0db4\u0dcf\u0db0\u0dd2\u0db0\u0dcf\u0dbb\u0dd2 \u0db1\u0dd2\u0d9a\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0da7 \u0d85\u0dc0\u0dc3\u0dcf\u0dae\u0dcf\u0dc0 \u0dc3\u0d9a\u0dc3\u0dcf \u0daf\u0dd3\u0db8 \u0dc3\u0dc4\u0dc4\u0dcf \u0dc1\u0d9c\u0ddc\u0daf\u0dd4\u0da2\u0dcf\u0db1 \u0dc3\u0dcf\u0dc0\u0d9a\u0db0\u0db1 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 \u0db1\u0dd2\u0d9a\u0db0\u0dcf\u0dbb\u0dd2 \u0dad\u0db1\u0dad\u0dd4\u0dbb\u0dd4 1 126\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0d9a\u0dd2\u0db8\u0dda\u0db8 \u0dc3\u0dc4\u0dc4\u0dcf 2022.09.06 \u0dd2\u0db1\u0db1 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dba\u0da7 \u0dc1\u0dc3\u0dda\u0dc0\u0dcf \u0dc1\u0dcf\u0db4\u0dcf\u0d9a\u0dad\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dd4\u0dc1 \u0d85\u0db0\u0dba\u0d9a\u0dca\u0dc2\u0dca\u0da8 \u0da2\u0dcf\u0db1\u0dba\u0dcf\u0dbd\u0dca \u0dc1\u0dc0\u0dad \u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dad\u0dd2\u0dba \u0dc3\u0dc4\u0dc4\