    "chunk_text": "\u0db4\u0dca\u200d\u0dbb\u0dd9\u0dcf\u0dba\u0dc0 \u0dba\u0db8\u0dca \u0d9c\u0db8\u0db1\u0dca \u0d9c\u0dd2\u0dc4\u0dd2\u0dca\u0dbd\u0dbd\u0dcf \u0dc0\u0dc1\u0db6\u0db1\u0dc0\u0dcf. :\u0dd0\u0db1\u0dca \u0da7\u0dc1\u0dd9\u0db1\u0dca \u0d94\u0dda\u0db6\u0da7 \u0dba\u0db1\u0dca\u0db1 \u0dd9\u0dcf\u0da7\u0dc0\u0dad\u0dca \u0db6\u0dd0\u0dc4\u0dd0. \u0dc3\u0db8\u0dc4\u0dba \u0db4\u0dca\u200d\u0dbb\u0dd9\u0dcf \u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dd2\u0dc4\u0dba\u0dd0\u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0dc3\u0d85\u0db4\u0dd2 \u0dba\u0dc0\u0dcf\u0db8 \u0dc3\u0d82\u0dc1 \u0ddd\u200d\u0db1\u0dba \u0dd9\u0dba\u0db1\u0dc0\u0dcf \u0d85\u0db4\u0dd2 \u0dba\u0dc0\u0dcf\u0db8 \u0dc1\u0dc0\u0db1\u0dc3\u0dca \u0dd9\u0dba\u0db1\u0dc0\u0dcf\u0dc3 \u0dd2\u0dc4\u0dba\u0dbd\u0dcf. \u0d91\u0dc1\u0dc4\u0db8 \u0dd9\u0dba\u0db1\u0dca\u0db1 \u0d9c\u0dd2\u0dc1\u0dba \u0dad\u0dca \u0dc1\u0db8\u0dca \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dc0\u0dc5 \u0db1\u0dad\u0dba \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0d91\u0dad\u0dc1\u0dd9 \u0da7 \u0db1\u0dd0\u0dc0\u0dad \u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0db4\u0dba \u0dc0\u0db6\u0dd4\u0da7\u0dcf\u0da7\u0dad\u0dca \u0dc0\u0da9\u0dcf \u0d85\u0db8\u0dcf\u0dbb\u0dd4 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0dd9\u0da7\u0dba\u0dd2. \u0dc1\u0db8 \u0dd9: \u0dba\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dca \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8\u0dca \u0d85\u0dad\u0dca\u0dc3\u0db1\u0dca \u0dd9\u0dc5\u0dcf\u0da7 \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dda \u0da7\u0dd9 \u0d85\u0dba \u0dba\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dba\u0dd2 \u0d85\u0dad\u0dca\u0dc3\u0db1\u0dca \u0dd9\u0dc1\u0dc5\u0dda \u0dc1\u0db8\u0dca \u0dba\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dba\u0dd2 \u0d85\u0dad\u0dca\u0dc3\u0db1\u0dca \u0dd9\u0dc1\u0dc5\u0dda \u0dd2\u0dc4\u0dba\u0dbd\u0dcf \u0dd9\u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0dd9\u0dba\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0da7 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1\u0dd2\u0db1\u0dca \u0d89\u0dc0\u0dad\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. IMF \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1\u0dd2\u0db1\u0dca \u0d89\u0dc0\u0dad\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0dc4\u0dd0\u0dd2\u0dc4\u0dba\u0dcf\u0dc0 \u0dc0\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0da7\u0dc1\u0dca \u0dd2\u0dc4\u0dc3\u0dd2\u0db8 \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0dba\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0da7\u0dd9 \u0db4\u0dcf\u0dbb\u0dca \u0dca\u0dc0\u0dd2\u0dd9\u0dc0 \u0da7 \u0dd9\u0da7\u0dd4\u0dad\u0dad\u0dca\u0dad \u0dd9\u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d91:\u0dcf\u0da7 \u0dd2 \u0dc0 \u0dc0\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0db8\u0dd3\u0da7 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4\u0db4 \u0dc1:\u0dd9\u0dd9\u0da7 \u0d89\u0dc3\u0dca\u0dc1\u0dc3\u0dca\u0dbd\u0dbd\u0dcf \u0dd2 \u0dc0 \u0dc0\u0dd4\u0dab\u0dd4 \u0d85\u0dba\u0d9c\u0dc5 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0dc0\u0da9\u0dcf \u0dc1\u0dc0\u0db1\u0dc3\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0da7 \u0db1\u0dd2\u0dc3\u0dcf \u0da7\u0dd9 \u0dd9\u0dcf\u0da7\u0dc0\u0dad\u0dca \u0dd9\u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc1\u0dc0\u0dba\u0dd2 \u0dd2\u0dc4\u0dba\u0dbd\u0dcf \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0db8\u0dca \u0dba\u0db1 \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dc0\u0dc5\u0dad\u0dca \u0d91\u0dca\u0dd9 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0dba\u0db1\u0dca\u0db1\u0dba\u0dd2 \u0dc0\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d91\u0dad\u0dd0\u0db1 \u0d85\u0da9\u0dd4 \u0db4\u0dcf\u0da9\u0dd4 \u0dc0\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0dc1\u0db4\u0db1\u0dca\u0dc0\u0dcf \u0daf\u0dd3\u0dc1\u0db8\u0dca \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0da7 \u0dc3\u0dcf\u0dd9\u0da1\u0dcf \u0dcf\u0dc0\u0dbd\u0da7 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u200d \u0dc1\u0dc0\u0dbd\u0dcf \u0dc0\u0dc1\u0db6\u0db1 \u0d85\u0da9\u0dd4 \u0db4\u0dcf\u0da9\u0dd4 \u0dba\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dd2\u0dc4\u0dd3\u0db8\u0dc1\u0db8\u0dca \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4 \u0dc0\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dd2\u0dc4\u0dd3\u0db8\u0dc1\u0db8\u0dca \u0d85:\u0dcf\u0dc5 \u0db1\u0dd2\u0dbd\u200d\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dd2\u0dc4\u0dd3\u0db8\u0dc1\u0db8\u0dca \u0dc0\u0d9c\u0d9a\u0dd3\u0db8 \u0dc3\u0dd1\u0db8 \u0db8\u0dc4\u0da2\u0db1 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0dd2\u0dad\u0dad\u0dc1\u0dba \u0dc3\u0da7\u0db8 \u0dc0\u0dc1\u0db6\u0db1\u0dc0\u0dcf."
  },
