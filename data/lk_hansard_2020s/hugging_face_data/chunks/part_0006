    "chunk_text": "\u0db8\u0dd6\u0d9a\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0d85\u0db4\u0dd2 \u0dcf\u0dd0\u0d9a \u0dad\u0dd2\u0dc1 \u0db1\u0dc0\u0dcf \u0dc3\u0db8\u0dc4\u0dba \u0dc1 \u0dbd\u0dd2\u0db4\u0dad \u0db1\u0d9a\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dbd\u0dd2 20 30 \u0daf\u0dd4\u0dcf\u0dcf\u0d9c \u0dc1\u0dc0\u0db1 \u0dca\u0d9a\u0dcf\u0dba\u0dba. \u0dad\u0db8\u0db1\u0dca\u0dc1\u0dda \u0dd2\u0da9\u0db8 \u0dc1 \u0dcf\u0d9a\u0dcf\u0dba \u0d9a\u0dd2\u0dba\u0d9a\u0dcf \u0dc3\u0db8\u0dc4\u0dba \u0dc3\u0dcf\u0daf\u0dd4\u0dba \u0dcf\u0dd0\u0db1\u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dbd\u0dd2 \u0d9c\u0da7\u0db1\u0d9a\u0da7 \u0db4\u0dc3\u0dd4\u0dc0\u0dd2 . \u0db1\u0db8\u0dd4 \u0d9a \u0dc1\u0db4\u0dad \u0d85\u0dbd\u0dd4\u0dad\u0dd2\u0db1\u0dca \u0dc1\u0d9c\u0db1\u0dd0\u0dbd\u0dca\u0d9a\u0dcf \u0dad\u0dd2\u0dc1 \u0db1 \u0dd3\u0db8\u0dad\u0dd2 \u0dc3\u0dcf\u0dc1 \u0ddd\u0db0\u0db1 \u0dba\u0da7\u0dc1 \u0d9a \u0d91\u0dc1\u0dc4\u0db8 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0.\n\n\u0db8\u0dd6\u0d9a\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db8\u0dd3\u0da7 \u0dc1\u0db4\u0dba \u0daf\u0dd3\u0d9a\u0d9d \u0d9a\u0dcf\u0d9a\u0dba\u0d9a\u0dca \u0dc1\u0db4\u0dad \u0db1\u0d9a\u0dca \u0daf\u0dd4\u0dcf\u0dcf\u0d9c \u0dc0\u0dd4\u0da7\u0dcf \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dbd\u0dd2 20 25 30 \u0dc0 \u0dc1\u0dba\u0db1\u0dca. \u0db1\u0db8\u0dd4 \u0d9a \u0dc1\u0db4\u0dad \u0d85\u0dbd\u0dd4 \u0d9a \u0dc3\u0dcf\u0dc1 \u0ddd\u0db0\u0db1 \u0d85\u0db1\u0dd4\u0dc0 \u0dc3\u0db4\u0dbb\u0dd2\u0db8 \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dbd\u0dd2 \u0dcf\u0dc4\u0dba\u0d9a \u0d9a\u0dcf\u0d9a\u0dba\u0d9a\u0dca \u0dad\u0dd4\u0dc5 \u0db4\u0db8\u0da7\u0dd2 \u0d91\u0db8 \u0db1\u0d9a\u0dca \u0daf\u0dd4\u0dcf\u0dcf\u0d9c \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0dc0\u0db1\u0dca \u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d87 \u0d9a\u0dad\u0da7\u0db8 \u0db8\u0db8 \u0d9c\u0dbb\u0dd4 \u0d85\u0db0\u0dd2\u0d9a\u0dba\u0da7 \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0d9a\u0dd2 \u0dc0\u0dcf \u0d91\u0db8 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dbd\u0dd2 \u0dcf\u0dc4\u0dc1\u0dda \u0d9a\u0dcf\u0d9a \u0dc3\u0dd3\u0db8\u0dcf\u0dc0 \u0db4\u0dd4\u0dd4 \u0dc0\u0db1\u0dca \u0db1\u0db4\u0dad \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dbd\u0dd2 \u0db4\u0dc4 \u0dcf\u0d9a\u0dca\u0dc0\u0dcf \u0d85\u0d9a\u0dca \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0d9a\u0dcf. \u0db1\u0db8\u0dd4 \u0d9a \u0d85\u0db0\u0dd2\u0d9a\u0dba\u0da7 \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0d91\u0dc1\u0dc3\u0dda \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dbd\u0dd2 \u0dcf\u0dc4\u0dba\u0d9a \u0d9a\u0dcf\u0d9a \u0dc3\u0dd3\u0db8\u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0dd0\u0db6\u0dd3\u0db8\u0da7 \u0dc1\u0dc4\u0dda\u0dad\u0dd4\u0dc0 \u0dc1\u0db4\u0db1\u0dca\u0dc0\u0dcf \u0dbd\u0dd2\u0db1\u0dca\u0db1\u0dcf. \u0db8\u0db8 \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf\u0dba\u0da7\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0dc1\u0db8\u0da0\u0dca\u0dcf\u0dba \u0d9a\u0dcf\u0d9a\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dc3\u0dd2 \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dca \u0d85\u0dad \u0d9c\u0dc4\u0db4\u0dd4 \u0db1\u0dd0\u0dad\u0dd2; \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dbd\u0dd2 47\u0d9a\u0da7 \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4\u0dc0 \u0d9a \u0d85\u0dad \u0d9c\u0dc4\u0db4\u0dd4 \u0db1\u0dd0\u0dad\u0dd2 \u0dc1\u0db4\u0dad \u0dd3\u0db8\u0dad\u0dd2\u0dba \u0dba\u0dcf\u0dc0 \u0d9a\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0d9a\u0dba\u0d9a\u0dcf \u0dc1\u0db4\u0dad \u0daf\u0dd4\u0db0\u0dd2\u0dba\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0db8\u0dda\u0db8 \u0d9c\u0dd0\u0db1 \u0db8\u0db8 \u0d9c\u0dbb\u0dd4 \u0d85\u0db0\u0dd2\u0d9a\u0dba\u0da7 \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0dc3\u0dcf\u0dad\u0dd4\u0dad\u0dd2\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0dd3\u0db8\u0dad\u0dd2\u0da5\u0dc0\u0dbb\u0dd4 \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0da2\u0dcf\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dd3\u0db8\u0dad\u0dd2\u0da5\u0dc0\u0dbb\u0dd4 \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0dcf\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0dc1\u0db8\u0dad\u0dd0\u0db1 \u0dad\u0dd2\u0dc1 \u0db1 \u200d\u0dbb \u0dcf\u0db1\u0dba \u0d9c\u0dd0\u0db1. \u0dc1\u0db8\u0dad\u0dd0\u0db1\u0daf\u0dd3 \u0db8\u0dd2\u0db1\u0dd2\u0db1\u0dca\u0dc1\u0dcf\u0ddd\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc1 \u0dc0\u0dcf \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0d9a\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca \u0dc1 \u0dc0\u0dcf \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc5 \u0dba\u0dd4 \u0d9a\u0dc1 \u0d9a \u0d85\u0db0\u0dd2\u0d9a\u0dba\u0da7\u0dc1\u0dda \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0da7\u0dba \u0dba\u0da7\u0dc1 \u0d9a\u0dd2 . \u0d92\u0d9a \u0dc1 \u0ddc\u0dc1\u0dc4\u0ddc\u0db8 \u0dc0\u0dd0\u0dcf\u0d9c \u0d9a.\n\n\u0d8a\u0dc5\u0d9f\u0da7 \u0dd0\u0dcf\u0d9a\u0dd4 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u200d\u0dbb\u0dcf\u0dcf\u0db1\u0dba \u0d9a\u0dba\u0db1 \u0d9a\u0dcf \u0da7\u0dba \u0dca\u0db4\u0dc3\u0dd4 \u0d85\u0dba \u0d9a\u0dba \u0d9c\u0dd0\u0dd3\u0db8\u0dc1\u0db4\u0dad\u0daf\u0dd3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0d9a\u0db8\u0d9a \u0d9a\u0dba\u0db1 \u0db4\u0dba\u0dcf\u0dc1\u0da7\u0dca \u0dd3\u0db8\u0dad\u0dd2\u0dba \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0db6\u0dbd\u0d9a\u0dc0 \u0d85 \u0d9a\u0dc4\u0dd2\u0db8\u0dca\u0dc0\u0dd3\u0db8 \u0dc3\u0dc4\u0dc4\u0dcf \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0db8\u0dda\u0db8\u0da7 \u0d85\u0dcf\u0dcf\u0dc5 \u0db4\u0db1 \u0d9a \u0dc1\u0d9a\u0db8\u0dca\u0db4\u0dad\u0db4\u0dad \u0d9c\u0dbb\u0dd4 \u0db8\u0dd4\u0dcf\u0dbd\u0dca \u0dca\u0d9a\u0dae\u0dd2\u0d9a \u0dc3\u0dcf\u0dae\u0dcf\u0dba\u0dd3\u0d9a\u0dba\u0da7 \u0dc3\u0dc4 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u200d\u0dbb\u0dad\u0dd2\u0db4 \u0d9a\u0dad\u0dd2 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dad\u0dd4\u0db8\u0dcf \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dd2\u0dd2\u0db1\u0dbb\u0dd2\u0db4 \u0d9a \u0d9a\u0dd2\u0db8\u0dda\u0db8 \u0d9c\u0dd0\u0db1 \u0d9a \u0db8\u0db8 \u0d9c\u0dbb\u0dd4 \u0d85\u0db0\u0dd2\u0d9a\u0dba\u0da7 \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0dc3\u0dcf\u0dad\u0dd4\u0dad\u0dd2\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0dc0\u0db1\u0dc0\u0dcf.\n\n\u0d85\u0dc1 \u0d85\u0db0\u0dd2\u0d9a\u0dba\u0da7 \u0dba\u0dcf\u0da2\u0dcf\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0dc1\u0dda \u0d9a \u0dc4\u0dbb\u0dd2\u0dba\u0da7 \u0dc4\u0dbb\u0dd2. \u0dc1\u0db4\u0dad \u0db4\u0dd2\u0dc5\u0dd2 \u0dc4 \u0d85\u0db4\u0dd2 \u0d9c\u0dbb\u0dd4 \u0da2\u0dcf\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0dc3\u0dcf\u0dad\u0dd4\u0dad\u0dd2\u0dc0\u0db1\u0dca\u0dad \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0da2\u0dcf\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dcf\u0d9a\u0dba\u0d9a\u0da7 \u0dd2\u0dc3\u0dcf\u0dc1\u0dc3\u0dbd\u0dca\u0d9a\u0dcf \u0dc1\u0dba\u0ddd\u0da2\u0dcf\u0db1\u0dcf \u0d9a\u0dc5\u0dcf \u0dc1\u0db4\u0dad \u0dc3\u0dc4\u0db1\u0dba \u0dc1\u0dcf\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dba\u0d9a\u0dcf. \u0d85\u0db4\u0dd2 \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a \u0dcf\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0dba\u0dc1\u0da7\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7\n\n901 902\n\n\u0db4\u0dcf\u0d9a\u0db6\u0dbd\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dd4\u0dc0"
  },
