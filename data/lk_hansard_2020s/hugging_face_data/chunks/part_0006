    "chunk_text": "\u0d92 \u0daf\u0dd4\u0db0\u0dd2\u0dba\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dba\u0dc1\u0d9c\u0db1 \u0dba\u0db1 \u0d85\u0dad\u0dc1\u0d9a \u0d85\u0db4\u0dd2 \u0dca\u0dc3\u0dd2\u0dba\u0dcf\u0db1\u0dd4 \u0dc3\u0dcf\u0dc0\u0d9a\u0db0\u0db1 \u0dd0\u0dcf\u0d9a\u0dd4\u0dc0 \u0dc3\u0db8\u0d9f \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0d9a\u0dc5\u0dcf\u0db8 \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d85\u0db4\u0da7 \u0dc1\u0da9 \u0dcf\u0dcf\u0d9a\u0d9a \u0db8\u0dd2\u0db6\u0dbd\u0dba\u0db1 100\u0d9a \u0da7\u0dba \u0db8\u0dd4\u0dcf\u0d9a\u0d9a\u0dca \u0d9a \u0dcf \u0dbd\u0dd2\u0db1\u0dca\u0db1\u0dcf. \u0d85\u0db4\u0dd2 \u0dc1\u0db4\u0dad \u0dba\u0dc1\u0da7\u0dca \u0dad\u0dd2\u0dc1 \u0db1 \u0dd0\u0dcf\u0d9a\u0dd4 13\u0d9a\u0da7 \u0d91\u0dcf\u0dcf \u0da7\u0dba \u0db8\u0dd4\u0dcf\u0dc1\u0d9a\u0db1\u0dca \u0dc1\u0da9\u0ddc\u0d9a\u0d9a \u0db8\u0dd2\u0db6\u0dbd\u0dba\u0db1 50\u0d9a\u0dca \u0d9a \u0dcf \u0dc1\u0dcf\u0db1\u0dc0\u0dcf. \u0d92 \u0d9a\u0dcf\u0da7 \u0dc1\u0dcf\u0db1\u0dca\u0db1 \u0dcf? \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0db6\u0dbd\u0dba\u0db1 10\u0d9a \u0dc3\u0db4\u0dbb\u0dd2\u0db8 \u0dc3\u0dd3\u0db8\u0dcf\u0dc0\u0d9a\u0da7 \u0dba\u0da7 \u0d9a\u0dc0 \u0d9a\u0dcf\u0dba\u0d9a \u200d\u0dbb\u0dcf\u0dda\u0db0\u0db1 - working capital - \u0d85\u0dc0 \u0dba\u0dad\u0dcf \u0dc3\u0dc4\u0dc4\u0dcf \u0dc3\u0dd4\u0dd4 \u0dc4\u0dcf \u0db8\u0db0\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0da7 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0dcf\u0da7 \u0d9a \u0dcf \u0dc1\u0dcf\u0db1\u0dca\u0db1\u0dd2 . \u0d91\u0dc4\u0dd2 \u0dc1\u0db4\u0ddc\u0db6\u0dbd\u0dba \u0dd3 \u0dba\u0dcf? \u0d85\u0db4\u0dd2 \u0dd0\u0dcf\u0d9a\u0dd4\u0dc0\u0d9a\u0da7 \u0dc3\u0dd2\u0dba\u0dba\u0da7 5\u0d9a \u0dc1\u0db4\u0ddc\u0db6\u0dbd\u0dba\u0d9a\u0da7 \u0dad\u0db8\u0dd2 \u0dc1\u0dcf\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dd0\u0dcf\u0d9a\u0dd4\u0dc0\u0da7 \u0d9c\u0db1\u0dd4\u0dc1\u0dcf\u0db1\u0dd4\u0d9a\u0dbb\u0dd4\u0dc0\u0dcf\u0da7 \u0dc3\u0db4\u0dbb\u0dd2\u0db8 \u0dc3\u0dd2\u0dba\u0dba\u0da7 8\u0d9a \u0dc1\u0db4\u0ddc\u0db6\u0dbd\u0dba\u0da7 \u0dc1\u0db4\u0dad \u0db8\u0dd4\u0dcf\u0dbd\u0dca \u0dc1\u0dcf\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0dc0\u0db1\u0dca \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0d9a\u0dcf\u0dba\u0d9a \u200d\u0dbb\u0dcf\u0dda\u0db0\u0db1 \u0d85\u0dc0 \u0dba\u0dad\u0dcf \u0dc3\u0dc4\u0dc4\u0dcf. \u0db8\u0dd6\u0d9a\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0d85\u0db4\u0dd2 \u0dc1\u0db4\u0dad \u0da7\u0dba\u0dc0\u0d9a\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0db6\u0dbd\u0dba\u0db1 10\u0d9a \u0dc3\u0db4\u0dbb\u0dd2\u0db8\u0dba\u0d9a\u0dca \u0dc1\u0dba\u0ddc\u0dcf\u0d9a\u0dcf \u0dad\u0dd2\u0dc1 \u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dca \u0d85\u0dad\u0da7 \u0db1\u0dd0 \u0d9a\u0db1\u0db4\u0dad \u0d9a\u0da9\u0dd4\u0da9\u0dcf\u0dba\u0db8\u0d9a\u0dca \u0d85\u0dad\u0da7 \u0dc1\u0db4\u0dad \u0db8\u0dd4\u0dcf\u0dbd\u0dca \u0dba\u0dd1\u0db8 \u0dc0\u0dc5\u0d9a\u0dca\u0dc0\u0db1\u0dca\u0db1\u0dd2 . \u0d85\u0db4\u0dd2 \u0dd0\u0dcf\u0d9a\u0dd4 13\u0d9a\u0da7 \u0db8\u0dd4\u0db6\u0dbd\u0db1\u0dca \u0dc1\u0dcf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0da9\u0ddc\u0d9a\u0d9a \u0db8\u0dd2\u0db6\u0dbd\u0dba\u0db1 26\u0dd2 . \u0d85\u0db4\u0dd2 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0d9a\u0dcf\u0d9a\u0dba \u0dc3\u0dcf\u0db0\u0db1\u0dba \u0d9a\u0d9a\u0dcf \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 80\u0d9a\n\n875 876\n\n[\u0d9c\u0dbb\u0dd4 \u0dba\u0dcf\u0da2\u0dd2 \u0d9a \u0dc3\u0dd2\u0dba\u0dd9\u0d9a\u0dcf\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db8\u0dc4\u0dad\u0dcf ]\n\n2024 \u0db8\u0dd0\u0dd2 07\n\n\u0db8\u0dd6\u0d9a\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0d85\u0db1\u0dd2\u0d9a\u0dca \u0dc1\u0da9\u0ddc\u0d9a\u0d9a \u0db8\u0dd2\u0db6\u0dbd\u0dba\u0db1 50 \u0d85\u0db4\u0dd2 \u0dc1\u0dba\u0ddc\u0dcf\u0dcf \u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0da7\u0dba \u0dc3\u0dd4\u0dbb\u0dd0\u0d9a\u0dd4\u0db4\u0dad \u0d9a\u0dcf\u0d9a\u0dba\u0dcf\u0dcf \u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0d9a\u0db8\u0d9a \u0d9a\u0dba\u0db1\u0dca\u0db1\u0dd2 . \u0d91\u0dba \u0dc1\u0db8\u0dc1\u0dad\u0d9a\u0dca \u0dc3\u0dd2\u0dc4\u0dd2\u0db1\u0dba\u0d9a\u0dca \u0dc1\u0dc0\u0d9a\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0da7\u0dcf. \u0dc1\u0db8\u0dc1\u0dad\u0d9a\u0dca \u0dc1\u0db4\u0ddc\u0dad\u0da7 \u0daf\u0dd4\u0dad\u0dba\u0d9a\u0dca \u0dc3\u0dd3\u0db8\u0dcf \u0dc1\u0dc0\u0d9a\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0da7\u0dba \u0dc3\u0dd4\u0dbb\u0dd0\u0d9a\u0dd4\u0db4\u0dad \u0d9a\u0dcf\u0d9a\u0dba\u0dcf\u0dcf \u0dba\u0da7 \u0d85\u0db4\u0dd2 \u0dc1\u0da9\u0ddc\u0d9a\u0d9a \u0db8\u0dd2\u0db6\u0dbd\u0dba\u0db1 50\u0d9a\u0dca \u0dc1\u0dcf\u0db1\u0dc0\u0dcf. \u0db8\u0dd0\u0dd2 31\u0dc0\u0dd0\u0db1\u0dd2 \u0dcf\u0dcf \u0d85\u0db4\u0da7 \u0d92 \u0dc1\u0da9\u0ddc\u0d9a\u0d9a \u0db8\u0dd2\u0db6\u0dbd\u0dba\u0db1 50 \u0d9a\u0dd0\u0dc1 \u0db1\u0dc0\u0dcf.\n\n\u0dc1\u0db4\u0dad \u0dca\u0dba\u0dad\u0db1\u0dba \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0dbd\u0dd2\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0db4\u0dad\u0d9a\u0dd2 . \u0da7\u0dba \u0d9c\u0dd0\u0db1\u0dd4\u0db4\u0dad\u0d9a\u0dbb\u0dd4\u0dc1\u0dc0\u0d9a\u0dd4\u0da7 -\u0dc3\u0dd4\u0dd4 \u0dc4\u0dcf \u0db8\u0db0\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0da7 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dc1\u0dba\u0d9a\u0dd4\u0da7- \u0db8\u0dd6\u0d9a\u0dba \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db4\u0dad \u0d9a \u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0dad\u0db8\u0db1\u0dca\u0da7 \u0dc3\u0dd4\u0dbb\u0dd0\u0d9a\u0dd4\u0db4\u0dad \u0db1\u0dd0 \u0d9a\u0db1\u0db4\u0dad \u0d94\u0dc4\u0dd4\u0da7 \u0dd0\u0dcf\u0d9a\u0dd4\u0dc0 \u0dc4\u0dba\u0dc4\u0dcf \u0dc1\u0dc4\u0ddd \u0dc3\u0dd8\u0da2\u0dd4\u0dc0 \u0dd2\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0d9a\u0dca \u0d9a\u0dba\u0d9a\u0dcf \u0dc1\u0db4\u0dad \u0dca\u0dba\u0dad\u0db1\u0dc1\u0dba\u0db1\u0dca \u0dc3\u0dd4\u0dbb\u0dd0\u0d9a\u0dd4\u0db8\u0d9a\u0dca \u0d9a \u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0dc0\u0db1\u0dca. \u0d91\u0dad\u0dd0\u0db1\u0daf\u0dd3 \u0d94\u0dc4\u0dd4\u0da7 \u0da7\u0dba \u200d\u0dbb\u0db8\u0dcf\u0da7\u0dc1\u0dba\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 1\u0d9a \u200d\u0dbb\u0db8\u0dcf\u0da7\u0dba\u0d9a\u0dca \u0dad\u0db8\u0dd2 \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0dc3\u0dd2\u0dbd\u0dd2 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1\u0db8\u0dba \u0d85\u0dc1 \u0dba\u0dc1\u0da7\u0dca \u0dc1\u0db8\u0dc1\u0dad\u0d9a\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0d9a\u0db8\u0d9a \u0dc1\u0db1\u0ddc\u0dc0 \u0dcf \u0dab\u0dd4 \u0dc3\u0dd4\u0dd4 \u0dc4\u0dcf \u0db8\u0db0\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0da7 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0dcf \u0d9a\u0dca\u0dad\u0dd2\u0db8 \u0d9a \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0d9c \u0d9a \u0dd2\u0dad\u0dcf \u0dc3\u0dd4\u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8 \u0db4\u0dd2\u0dba\u0dc0\u0dba\u0d9a\u0dca. \u0dc1\u0db4\u0dad \u0dca\u0dba\u0dad\u0db1\u0dba \u0dc3\u0dd2\u0dba\u0dba\u0da7 1\u0d9a \u0dc1\u0db4\u0ddc\u0db6\u0dbd\u0dba\u0d9a\u0da7 \u0da7\u0dba \u0d9a \u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0dcf\u0dc1\u0dda \u0dc0\u0d9c\u0dd3 \u0db4\u0dad \u0dcf\u0dcf\u0dba \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0dd2\u0dad\u0dd2\u0db1\u0dca \u0dc1\u0db4\u0dad\u0d9a \u0d85\u0dbd\u0dd4 \u0d9a \u0dc1\u0dcf\u0dba\u0d9a\u0dca. \u0dc1\u0da9\u0ddc\u0d9a\u0d9a \u0db8\u0dd2\u0db6\u0dbd\u0dba\u0db1 100\u0db1\u0dca \u0dc1\u0da9\u0ddc\u0d9a\u0d9a \u0db8\u0dd2\u0db6\u0dbd\u0dba\u0db1 50\u0d9a\u0dca \u0d91\u0dad\u0dd0\u0db1\u0da7 \u0dc1\u0dba\u0ddc\u0dcf\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0db4\u0dad \u0d85\u0dbd\u0dd4 \u0d9a \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5 \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dd4 \u0d9a \u0dc3\u0dd4\u0dd4 \u0dc4\u0dcf \u0db8\u0db0\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0da7 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0dcf \u0d9a\u0dca\u0dad\u0dd2\u0db8 \u0d9a \u0d9a\u0dba\u0db1\u0dca\u0db1\u0dd2 ."
