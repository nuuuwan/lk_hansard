    "chunk_text": "\u0d85\u0db4\u0dd2 \u0d91\u0daf\u0dcf \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0dc1 \u0db8 \u0dad\u0db8\u0dd2 \u0d85\u0daf\u0dda \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0daf \u0db1\u0dca \u0dc1\u0db8\u0dad \u0db1 \u0d9c \u0da7\u0dbd\u0dd4\u0dc0 \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0dc3\u0dcf\u0db8\u0dd4\u0dc0 \u0d87\u0dad\u0dd4\u0dc1\u0db8\u0dda \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0dc1 \u0db8 \u0d9a\u0dc3\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dd2. \u0db1 \u0dc4 . \u0dc1\u0db8\u0dca \u0dc1\u0dc0\u0dbd\u0dcf\u0dc1\u0dda \u0d9a\u0dc3\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0db1 \u0dc4 . \u0d85\u0db4\u0dd2 \u0d92 \u0daf\u0dd2\u0dc3\u0dcf\u0dc0\u0da7 \u0d9c\u0db8\u0db1\u0dca \u0d9a\u0dc3\u0db1\u0dc0\u0dcf. \u0dc4 \u0db6 \u0dd2 \u0dc1\u0db8\u0dca IMF \u0d91\u0dc1\u0d9a\u0dca \u0dc3\u0dcf\u0db8\u0dd4\u0dc0 \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0dc1 \u0db8 \u0d85\u0db4\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0db1 \u0d85\u0dc0 \u200d \u0db1 \u0dc4 . \u0d85\u0db4\u0dd2 \u0db4\u0dd3\u0da7\u0dbb\u0dca \u0db8\u0dd2\u0dba\u0dd4\u0dc3\u0dbb\u0dca\u0dc1\u0dda \u0db8\u0dd4\u0dc4\u0dd4\u0dba\u0da7\u0db8 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0dc1\u0db8\u0dca\u0dc1\u0d9a\u0dca \u0d9c \u0da7\u0dbd\u0dd4 \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0daf \u0db8\u0dd6\u0dbd\u0dd2\u0d9a\u0db8 \u0d9c \u0da7\u0dbd\u0dd4\u0dc0? \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0dbd\u0d82\u0d9a\u0dcf\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0dba \u0dc0\u0dd2\u0dc1 \u0dba\u0dba \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf\u0dba\u0d9a\u0dca \u0d85\u0db4\u0dd2\u0da7 \u0dc1\u0da9\u0ddc\u0dbd\u0dbb\u0dca \u0d95\u0db1\u0dd1 \u0d85\u0dad \u0db1\u0dd2\u0db1\u0dca \u0dc1\u0da9\u0ddc\u0dbd\u0dbb\u0dca \u0d91\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0dc1\u0db8\u0dad \u0db1\u0dd2\u0db1\u0dca \u0dc1\u0da9\u0ddc\u0dbd\u0dbb\u0dca \u0d91\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 ADB \u0d91\u0dc1\u0d9a\u0db1\u0dca \u0dc1\u0da9\u0ddc\u0dbd\u0dbb\u0dca \u0d91\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d85\u0db4\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0db8\u0db8 \u0dc1\u0db4 \u0d9c\u0dbd\u0dd2\u0d9a \u0d85\u0d82 \u0dc1\u0dda \u0db6 \u0d82\u0d9a\u0dd4\u0dc0\u0d9a \u0d89\u0dc4\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dc1\u0dba\u0d9a\u0dca \u0dc4 \u0da7\u0dd2\u0dba\u0da7 \u0dc0 \u0da9 \u0d9a\u0dc3\u0db4\u0dd4 \u0db4\u0dd4 \u0d9c\u0dbd\u0dc1\u0dba\u0d9a\u0dca; \u0dc1\u0dbd\u0ddd\u0d9a\u0dc1\u0dda \u0dc3\u0da7\u0dc0\u0dbd\u0dca 15\u0d9a 16\u0d9a \u0da2\u0dcf\u0dad\u200d\u0db1\u0dca\u0dad\u0dc3 \u0d86\u0dba\u0dad\u0db1\u0dc0\u0dbd \u0dc0 \u0da9 \u0d9a\u0dc3\u0db4\u0dd4 \u0db4\u0dd4 \u0d9c\u0dbd\u0dc1\u0dba\u0d9a\u0dca; \u0dc0\u200d\u0dc0\u0dc3\u0dcf\u0dba\u0d9a\u0dc1\u0dba\u0d9a\u0dca \u0dc4 \u0da7\u0dd2\u0dba\u0da7 \u0db6 \u0d82\u0d9a\u0dd4\u0dc0\u0dda \u0d91\u0d9a\u0dca\u0d9a \u0dc0 \u0da9 \u0d9a\u0dc3\u0db4\u0dd4 \u0db4\u0dd4 \u0d9c\u0dbd\u0dc1\u0dba\u0d9a\u0dca; \u0dc1\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0dc0\u0dd2 \u0dca\u0dc0\u0dc0\u0dd2\u0daf\u200d\u0dcf\u0dbd\u0dc0\u0dbd \u0dda\u0d9c\u0db1\u0dca\u0dc0\u0db4\u0dd4 \u0db4\u0dd4 \u0d9c\u0dbd\u0dc1\u0dba\u0d9a\u0dca. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d91\u0dc1\u0dc4\u0db8 \u0db4\u0dd4 \u0d9c\u0dbd\u0dc1\u0dba\u0d9a\u0dca \u0dc4 \u0da7\u0dd2\u0dba\u0da7\u0dd2 \u0db8\u0db8 \u0dc1\u0db8\u0dca \u0d9a\u0dae\u0dcf\u0dc0 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d85\u0dda\u0daf \u0d9a\u0dd3\u0db8\u0d9a\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1\u0db8\u0dca\u0d9a \u0db8\u0db8 Google \u0d91\u0dc1\u0d9a\u0db1\u0dca \u0db6\u0dbd\u0dbd\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0dc1\u0daf\u0dba\u0d9a\u0dca \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dd2.\n\n1523 1524\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0daf \u0db1\u0dca \u0d85\u0dc0 \u200d\u0dad\u0dcf\u0dc0 \u0dc1\u0da9\u0ddc\u0dbd\u0dbb\u0dca \u0db1\u0db8\u0dca \u0d9c\u0dbb\u0dd4 \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0db8\u0da7\u0dda \u0dc0\u0da9\u0dcf \u0dc1\u0dc4\u0ddc\u0db3\u0da7\u0db8 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0da2\u0dcf\u0dad\u200d\u0db1\u0dca\u0dad\u0dc3 \u0db8\u0dd6\u0dbd\u200d \u0d85\u0dc3\u0db8\u0dd4\u0daf\u0dbd\u0dda \u0d91\u0d9a\u0dca\u0d9a \u0d91\u0d9a\u0dd9\u0dad\u0dcf\u0dc1\u0dda\u0daf\u0dd3 \u0dc1\u0da9\u0ddc\u0dbd\u0dbb\u0dca \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dca \u0dda\u0db4\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dc0\u0dbd\u0da7 \u0d85\u0db4\u0dd2 \u0daf\u0dd2\u0dbb\u0dd2 \u0d9c\u0db1\u0dca\u0dc0\u0dbd\u0dcf \u0db1 \u0dc4 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a. \u0d92\u0d9a \u0dad\u0db8\u0dd2 \u0dc1\u0db8\u0dca IMF Agreement \u0d91\u0dc1\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dc1\u0dbd\u0ddc\u0d9a\u0dd4\u0db8 \u0d9c \u0da7\u0dbd\u0dd4\u0dc0. \u0d85\u0db4\u0dd2 \u0d92\u0d9a \u0db8\u0dd4\u0dbd\u0dd2\u0db1\u0dca\u0db8 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc3\u0dc1\u0da7\u0dca \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0dc3\u0dd2\u0dba\u0dba\u0da7 3 \u0daf \u0dc3\u0dd2\u0dba\u0dba\u0da7 5 \u0daf \u0dc3\u0dd2\u0dba\u0dba\u0da7 10 \u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dd2. \u0d92\u0d9a \u0d91\u0dc1\u0dc4\u0db8 \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dd2. \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0db8\u0dc4\u0dd2\u0db1\u0dca\u0daf \u0dc3\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0db8 \u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0daf \u0db1\u0dca \u0dc1\u0db8\u0dca \u0d9c\u0dbb\u0dd4 \u0dc3:\u0dcf\u0dc1\u0dc0\u0db1\u0dca \u0db4\u0dd2\u0da7\u0dc0 \u0d9c\u0dd2\u0dba\u0dcf. \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0dda \u0d9a\u0dcf\u0dbd\u0dc1\u0dda\u0daf\u0dd3 \u0dad\u0db8\u0dd2 \u0dc3\u0dc1\u0da7\u0dca \u0dc0 \u0da9\u0dd2\u0db8 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0dbd \u0db6\u0dd4\u0dc1\u0dda \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0dc1\u0daf\u0d9a\u0d9a\u0dca. \u0d92 2011-2012\u0daf\u0dd3. \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dc1\u0dda \u0dc1\u0db8\u0ddc\u0d9a\u0daf \u0dc0\u0dd4\u0dc1\u0dab\u0dca? 2013 \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba \u0dc3\u0dd2\u0dba\u0dba\u0da7 \u0dad\u0dd4\u0db1\u0dc4\u0db8\u0dcf\u0dc3\u0d9a\u0da7 \u0d9a\u0da9\u0dcf \u0dc1\u0d9c\u0db1 \u0dc0 \u0da7\u0dd4\u0dba\u0dcf. 2014 \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0dba\u0dba \u0dc1\u0d9c\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db6 \u0dbb\u0dd2 \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf\u0dba\u0d9a\u0dca \u0d86\u0dc0\u0dcf."
  },
