    "chunk_size_bytes": 3603,
    "chunk_text": "13.4\u0d9a\u0dca\u0dc0 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0d85\u0dba \u0dc1\u0db1\u0ddc\u0dc0\u0db1 \u0da7\u0dba \u200d\u0dbb\u0dad\u0dd2 \u0dad\u0dba 2023 \u0dc1\u0dcf\u0dc3\u0dd0\u0db4\u0dad \u0d9a 31 \u0dc0\u0db1 \u0daf\u0dd4\u0da7 \u0dc3\u0dd2\u0dba\u0dba\u0da7 12.8\u0d9a\u0dca \u0dcf\u0d9a\u0dca\u0dc0\u0dcf \u0d87\u0daf\u0dd4\u0dbd\u0dca\u0d9a\u0dcf \u0dad\u0dd2\u0dc1 \u0db1\u0dc0\u0dcf. \u0dc3\u0db8\u0dc3\u0dcf\u0dad \u200d\u0dbb \u0dcf\u0db1\u0dc0\u0d9a\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0dc1\u0dc3\u0ddc\u0dba\u0db1 \u0d91\u0d9a \u0dad\u0db8\u0dd2 \u0d85\u0dc1 \u0dba\u0da2\u0dcf\u0dc1\u0dda \u200d\u0dbb\u0dad\u0dd2\u0db4 \u0d9a\u0dad\u0dd2\u0dba. \u0d85\u0dcf \u0db4\u0dba\u0dcf\u0dc1\u0da7\u0dca \u0dd3\u0db8\u0dad\u0dd2\u0dba \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0d9a\u0dcf \u0dc1\u0dc4\u0da7 \u0d85\u0dc1\u0db1\u0d9a\u0dca \u0db4\u0dd0 \u0d9a\u0dc1\u0dad\u0db1\u0dca \u0dd2\u0dba\u0dc4\u0dd2\u0db1\u0dca \u0dd0\u0dcf\u0d9a\u0dd4 \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0db1 \u200d\u0dbb\u0dad\u0dd2\u0db4 \u0d9a\u0dad\u0dd2\u0dba \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dd2 \u0dba\u0da2\u0dcf\u0dba\u0da7 \u0dad\u0dd2\u0dc1 \u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dba\u0da2\u0dcf\u0dba\u0da7 \u0d8a\u0da7 \u0dc0\u0da9\u0dcf \u0dc0\u0d9c\u0dd3 \u0db8\u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db1\u0dc0\u0dcf \u0db8\u0dd6\u0d9a\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2.\n\n\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0dc3\u0dd4\u0dd4 \u0dc4\u0dcf \u0db8\u0db0\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0da7 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0dcf\u0da7 \u0db4\u0db8\u0da7\u0d9a\u0dca \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dd2 \u0d91\u0dd2\u0db1\u0dc1\u0db1\u0dcf\u0dcf \u0da2\u0dd3\u0dc0\u0dc1\u0db1\u0ddd\u0db4\u0dcf\u0dba \u0dc3\u0db4\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dc1\u0d9a\u0db1\u0dcf\u0da7 \u0db4\u0dc0\u0dcf \u0d9a\u0db4\u0dcf\u0db1 \u200d\u0dbb \u0dcf\u0db1\u0dba\u0d9a\u0da7 \u0d85\u0db4\u0dd2 \u0db8\u0dd4\u0dc4\u0dd4\u0da7 \u0dbd\u0dd2\u0db1\u0dca\u0db1\u0dcf. \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf 2022 \u0d85\u0dc0\u0dc3\u0dcf\u0db1 \u0d9a\u0dcf\u0d9a\u0dad\u0dd4\u0dc0 \u0dc0\u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0dc3\u0dd2\u0dba\u0dba\u0da7 12.4\u0d9a \u0d8d\u0da7 \u0dca\u0d9a\u0dae\u0dd2\u0d9a\u0dba\u0d9a\u0da7 \u0d85\u0db4\u0dd2 \u0dd2\u0dba\u0dba\u0dcf \u0d9a\u0dd2\u0dba\u0d9a\u0dcf. \u0d94 \u0dad\u0dd4\u0db8\u0dcf \u0dca\u0d9a\u0dae\u0dd2\u0d9a \u0daf\u0dd4\u0dcf\u0dba\u0dcf\u0dc0 \u0d9c\u0dd0\u0db1 \u0dcf\u0db1\u0dca\u0db1\u0dcf \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dca \u0db8\u0dd6\u0d9a\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0dc3\u0dd2\u0dba\u0dba\u0da7 \u0d8d\u0da7 12.4\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d8a\u0da7 \u0dc1\u0db4\u0dba \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0dc1\u0dda \u0d91\u0db8 \u0d9a\u0dcf\u0d9a\u0dad\u0dd4\u0dc1 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2 \u0d85\u0d9c\u0dba\u0da7 \u0dc0\u0da9\u0dcf \u0d85\u0dc1\u0da7\u0db1\u0dca \u0d91\u0d9a\u0d9a\u0dca \u0d85\u0d9a\u0dca \u0dc0\u0dd3\u0db8\u0d9a\u0dca. \u0d92 \u0d85\u0d9a\u0dca \u0dc0\u0dd4\u0dc1\u0da9\u0dd4 \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dd4\u0dc1\u0dda \u0d9a \u0db4\u0dad \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0dc0\u0db1\u0dca \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dd4\u0dc1\u0dda \u0db4\u0da9\u0dd2 \u0db4\u0dad \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0dc0\u0db1\u0dca \u0db1\u0dd2\u0dc2\u0dca\u0da8\u0dcf\u0db4\u0dcf\u0dcf\u0d9a\u0dc1\u0dba\u0d9a\u0dd4\u0dc1\u0dda \u0db8\u0dd4\u0dd4 \u0db1\u0dd2\u0dc2\u0dca\u0da8\u0dcf\u0db4\u0dcf\u0dcf\u0db1\u0dba \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0dc0\u0db1\u0dca \u0dc3\u0db8\u0dc3\u0dcf\u0dad\u0dba\u0d9a\u0dca \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0d85\u0dc1\u0da7\u0db1\u0dca \u0d91\u0d9a\u0d9a\u0dca \u0d85\u0d9a\u0dca \u0dc0\u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0dc3\u0db8\u0dc4\u0dba \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dd4\u0dc1\u0d9c\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 50\u0d9a\u0dca \u0d85\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4 \u0dc0\u0db1\u0dca. \u0dc1\u0db8\u0db1\u0dca\u0db1 \u0dc1\u0db4\u0dad\u0d9a\u0da7 \u0dad\u0db8\u0dd2 \u0dc3 \u0d9a\u0dad\u0dba \u0dc1\u0dc3\u0ddc\u0dba\u0db1\u0dca\u0db1 \u0d85\u0db4\u0da7 \u0dc3\u0dd2\u0dbd\u0dd2 \u0dc1\u0dc0\u0d9a\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0da9\u0dd4 \u0db8\u0dd6\u0d9a\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0d85\u0db4\u0dd2 \u0dc1\u0db4\u0dad \u200d\u0dbb \u0dcf\u0db1\u0dba\u0da7 \u0dc3 \u0d9a\u0dad\u0dba \u0dc1\u0dc3\u0ddc\u0dba\u0dcf\u0dc1\u0d9c\u0db1 \u0dba\u0db1 \u0d9c\u0db8\u0dc1\u0db1\u0dca\u0daf\u0dd3 2023 \u0da2\u0dd4\u0db1\u0dd2 \u0dc0\u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0dc3\u0dd2\u0dba\u0dba\u0da7 13.4\u0d9a\u0dca \u0dc0\u0dd4\u0dab\u0dd4 \u0d85\u0dba \u0dc1\u0db1\u0ddc\u0dc0\u0db1 \u0da7\u0dba \u200d\u0dbb\u0db8\u0dcf\u0da7\u0dba 2023 \u0dc1\u0dcf\u0dc3\u0dd0\u0db4\u0dad \u0d9a \u0dc1\u0dc0\u0dda\u0daf\u0dd3 \u0dc3\u0dd2\u0dba\u0dba\u0da7 12.8 \u0dcf\u0d9a\u0dca\u0dc0\u0dcf \u0d85\u0d9a\u0dca \u0dc0\u0dd4\u0da7\u0dcf \u0d9a\u0dd2\u0dba\u0d9a\u0dcf \u0db8\u0db8 \u0d9a\u0dd2 \u0dc0\u0dcf. \u0d85\u0dc1 \u0dc1\u0db4\u0ddc\u0dbd\u0dd3 \u0d85\u0db1\u0dd4\u0db4\u0dcf\u0dad\u0dba \u0d85\u0d9a\u0dca \u0dc0\u0dd3\u0db8 \u0d9a \u0d91\u0d9a\u0dca\u0d9a \u0dca\u0db4\u0dc3\u0dd4 \u0dc1\u0d9c\u0dc0\u0dd3\u0db8\u0da7 \u0d85\u0dc3\u0db8 \u0d9a \u0da7\u0dba \u0dc3\u0dcf\u0dba\u0dba\u0dcf\u0dc1 \u200d\u0dbb\u0dad\u0dd2 \u0dad\u0dba \u0d85\u0d9a\u0dca \u0dc0\u0dd3\u0dc1\u0db4\u0dad \u200d\u0dbb\u0dc0\u0da7\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0d92 \u0db4\u0dd0 \u0d9a\u0dad \u0d9a \u0dd0\u0dbd\u0dd4\u0dc0\u0dcf. \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dd0\u0dcf\u0d9a\u0dd4\u0dc0\u0d9a \u0dca\u0dba\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dcf\u0dc0 \u0d9c\u0dd0\u0db1 \u0d9a \u0d85\u0db4\u0dd2 \u0dd0\u0dbd\u0dd4\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dd2 . \u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1\u0dba\u0db1\u0dca \u0dba\u0dcf\u0da2\u0dcf\u0dba \u0dd0\u0dcf\u0d9a\u0dd4 \u200d\u0dbb\u0dcf\u0dda\u0db0\u0dd3\u0db8\u0d9a\u0dba\u0da7\u0dba \u0dc3\u0dc4\u0dc4\u0dcf \u0d91\u0db8 \u0dd0\u0dcf\u0d9a\u0dd4 \u0d9a\u0dca\u0dad\u0dd2\u0db8 \u0d9a \u0d9a\u0dd2\u0db8\u0dda\u0db8 \u0dc3\u0dc4\u0dc4\u0dcf \u0dc1\u0db8\u0dc0\u0dba \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0dc1\u0dbd\u0dca\u0dba\u0db1\u0dc1\u0dba\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0db6\u0dbd\u0dba\u0db1 450\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dc5\u0dcf."
  },
