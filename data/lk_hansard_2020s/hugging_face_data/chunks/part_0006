    "chunk_text": "\u0dc1\u0d9c\u0ddd\u0dbd\u0dd3\u0dba \u0dc1\u0d9a\u0ddc\u0daf\u0dd4 \u0dc3 \u0dc0\u0dc3\u0dcf\u0d9c\u0dad\u0dc1\u0dba\u0db1\u0dca \u0dc3\u0dc4 \u0d89\u0db1\u0dca \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0dc0 \u0dba\u0da7 \u0dad\u0dd4\u0dc5 \u0dda \u0d9c\u0dad \u0dc0\u0dd6 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0dd9\u0dba \u0d9a, \u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1\u0dba\u0db1\u0dca \u0daf\u0dd4\u0dc1 \u0daf\u0dd4\u0db1\u0dd2\u0db8\u0dc1 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2 \u0d8c\u0db1\u0dad\u0dcf\u0dc0 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0dad\u200d\u0dc0 \u200d \u0d86\u0dc4\u0dcf\u0dba \u0dca\u200d\u0dbb\u0dc0\u200d \u0d86\u0db1\u0dba\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc1\u0db1\u0ddc\u0dc4\u0dd0\u0d9a\u0dd2 \u0dc0\u0dd3\u0db8 \u0d9a \u0db1\u0dd2\u0dc3\u0dcf \u0dda \u0db0\u0dca\u200d\u0db8\u0db1\u0dc1 \u0dc1 \u0d9c\u0dba \u0dc1\u0dd3\u0d9d\u0dca\u200d\u0dbb\u0dc1\u0dba\u0db1\u0dca \u0d89\u0dc4\u0dc5 \u0d9c\u0dd2\u0dba \u0d85\u0dad\u0dba \u0d86\u0dc4\u0dcf\u0dba \u0dda \u0db0\u0dca\u200d\u0db8\u0db1\u0dba \u0dd2\u0db1\u0dba\u0dba\u0da7 4\u0d9a\u0dca \u0dd9\u0d9a\u0dca\u0dc0\u0dcf \u0d89\u0dc4\u0dc5 \u0d9c\u0dd2\u0dba\u0dcf. \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba\n\n\u0dca\u0dc4\u0dd2 \u200d\u0dbb\u0dad\u0dd2\u0dbd\u0d9a\u0dba\u0d9a\u0dca \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0dc1\u0db8\u0db8 \u0dc0\u0dc3\u0dc1\u0dbb\u0dca \u0dba\u0dc1\u0da7\u0dca \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0dd2\u0db1\u0dcf\u0dc4\u0d9a \u0dc4\u0dcf \u0dc4\u0dd2\u0db1\u0dca\u0dbd\u0dd2 \u0d85\u0dbd\u0dd4 \u0d9a \u0d85\u0dc0\u0dd4\u0dbb\u0dd4 \u0dd9 \u0dc0\u0da9\u0dcf \u0d9a \u0dda\u0dc1\u0dd9\u200d\u0ddd\u0d9c\u0dd2\u0db8 \u0d9a\u0dc0 \u0dc3\u0dd0\u0db8\u0dbb\u0dd3\u0db8\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dc0\u0dd3\u0db8 \u0d9c\u0dd0\u0db1 \u0db8\u0dcf \u0dc3\u0dad\u0dd4\u0db8\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1\u0dba\u0db1\u0dca \u0db8\u0dd3\u0da7 \u0dd9\u0dcf\u0dba\u0d9a \u0dc0\u0dd6 \u0dc1\u0dad\u0ddc\u0d9c \u0dc3\u0dc4 \u0dd2\u0db1\u0dbd\u0dca\u0d9a\u0dba \u0dc1\u0dc0 \u0dc1\u0dad\u0dc5\u0db3\u0dd4\u0db1\u0dca\u0da7, \u0db1\u0dd2\u0dc2\u0dca\u0da8\u0dcf\u0db4\u0dcf\u0dd9\u0d9a\u0dba\u0db1\u0dca\u0da7 \u0dc3\u0dc4 \u0db8\u0dc1\u0dda \u0d85\u0db8\u0dcf\u0dad\u200d\u0dcf\u0dcf \u0dba \u0dba\u0da7\u0dc1 \u0d9a \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dc0\u0d9a\u0da7, \u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1\u0dba\u0db1\u0dca \u0d9a\u0dcf\u0d9a\u0dcf \u0dc3\u0dc1\u0dad\u0ddc\u0dc3 \u0dc3\u0db8\u0dcf\u0d9c\u0db8 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dbd\u0dd2 \u0dc3\u0db8\u0dba \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca :\u0dcf\u0da9\u0dd4\u0da9\u0dc0\u0d9a -\u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0d85\u0dad\u200d\u0dc0 \u200d :\u0dcf\u0da9\u0dd4\u0da9\u0dc0\u0d9a \u0dc3\u0dc4 \u0d86\u0dc4\u0dcf\u0dba \u0dca\u200d\u0dbb\u0dc0\u200d\u0dc0\u0d9a- \u0db8\u0dd2\u0d9a \u0d9c\u0da7\u0db1\u0dca \u0d85\u0d9a\u0dca \u0d9a\u0dba\u0db8\u0dd2\u0db1\u0dca \u0dc3\u0dd4\u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8 \u0dd9\u0dcf\u0dba\u0d9a \u0d9a\u0dc0\u0dba\u0d9a\u0dca \u0d9a \u0dcf \u0daf\u0dd3\u0db8 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0db8\u0dcf\u0dc1\u0dda \u0dc3\u0dcf\u0dad\u0dd4\u0dad\u0dd2\u0dba \u0dbb\u0db4\u0dd9 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dd2.\n\n\u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0dc0\u0d9a\u0da7 \u0dc3\u0dcf\u0dc1\u0db4\u0dcf\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dc0 \u0dc1 \u0dc1\u0dd3\u0dba \u0dc1\u0dc0\u0dc5\u0db3 \u0dc1\u0db4\u0ddc\u0dc1\u0dc5\u0dda \u0dd9\u0d9a\u0dca\u0db1\u0da7 \u0d9a\u0dd0 \u0dc3 \u0dad\u0dc0 \u0d9a \u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8 \u0d9a\u0dc0\u0dba\u0d9a\u0dca \u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0dda \u0d9a\u0dc3\u0dc0 \u0dc3\u0db8\u0dc1 \u0daf\u0dd3 :\u0dcf\u0da9\u0dd4\u0da9 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d89\u0dbd\u0dca\u0dbd\u0dd4\u0db8 \u0d89\u0dc4\u0dc5 \u0dba\u0dd1\u0db8 \u0d85\u0db1\u0dd4\u0dc0 \u0db8\u0dd2\u0d9a \u0d9c\u0da7\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd3\u0db8\u0dba\u0dd2. \u0dc1\u0db4\u0dad \u0dc0\u0dc3\u0dc1\u0dbb\u0dca \u0dca\u0db8 \u0d89\u0dbd\u0dca\u0dbd\u0dd4\u0db8\u0da7 \u0dc3\u0dcf\u0dc1\u0db4\u0dcf\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dc0 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dbd\u0dd2 \u0dc3\u0dd0\u0db8\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc1\u0dad\u0ddc\u0d9c \u0db8\u0dd2\u0d9a\u0daf\u0dd3 \u0d9c\u0db1\u0dd4 \u0d9a\u0dd0\u0db6\u0dd4\u0dc0 \u0dd9 \u0d9a\u0dcf\u0d9a\u0dcf \u0dc3\u0dc1\u0dad\u0ddc\u0dc3 \u0dc3\u0db8\u0dcf\u0d9c\u0db8 \u0daf\u0dd4\u0dd2\u0db1\u0db1\u0dca \u0dc4\u0dad\u0dba \u0dc0\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0d85\u0dad\u200d\u0dc0 \u200d \u0db4\u0dcf\u0dbb\u0dd2\u0dc1:\u0ddd\u0d9c\u0dd2\u0d9a :\u0dcf\u0da9\u0dd4\u0da9\u0dc0\u0d9a \u0db8\u0dd2\u0d9a \u0dc1 \u0dc1\u0dd3\u0dba \u0dc1\u0dc0\u0dc5\u0db3 \u0dc1\u0db4\u0ddc\u0dc1\u0dc5\u0dda \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u200d \u0db8\u0dd2\u0d9a\u0da7 \u0dc0\u0da9\u0dcf \u0d85\u0d9a\u0dca \u0d9a\u0dba\u0db1\u0dd4 \u0d9a\u0dd0\u0db6\u0dd4\u0dc0\u0dcf. \u0dc1 \u0dc1\u0dd3\u0dba \u0dc1\u0dc0\u0dc5\u0db3 \u0dc1\u0db4\u0ddc\u0dc1\u0dc5\u0dda \u0dbd\u0dd6\u0db1\u0dd4\u0dc0\u0d9a \u0db8\u0dd2\u0d9a \u0d89\u0dc4\u0dc5 \u0dba\u0dd1\u0db8\u0d9a\u0dca \u0dd9\u0d9a\u0dca\u0db1\u0da7 \u0d9a\u0dd0\u0db6\u0dd4\u0da7\u0dcf. \u0dc1\u0db8\u0dba, \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0 \u0dbd\u0dd6\u0db1\u0dd4 \u0d85\u0db4\u0db1\u0dba\u0db1\u0dba \u0dad\u0dc4\u0db1\u0db4\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0d87\u0dad\u0dd2 \u0dc0\u0dd6 \u0dad \u0d9a \u0d9a\u0dc0\u0dba\u0d9a\u0dca. \u0dbd\u0dd6\u0db1\u0dd4 \u0dc4\u0dd2\u0d9f\u0dc0\u0dd3\u0dc1\u0db8\u0db1\u0dca \u0daf\u0dd4\u0dc0\u0dd8\u0dad \u0dc1\u0dc0\u0dc5\u0db3 \u0dc1\u0db4\u0ddc\u0dc1\u0dc5\u0dda \u0dbd\u0dd6\u0db1\u0dd4 \u0d9a\u0dd2\u0dc1\u0d9a\u0ddd\u0dc0\u0d9a \u0db8\u0dd2\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 700\u0d9a\u0dca \u0dd9\u0d9a\u0dca\u0dc0\u0dcf \u0d89\u0dc4\u0dc5 \u0d9c\u0dd2\u0dba\u0dcf. \u0dc1\u0db8\u0db8 \u0db8\u0dd2\u0d9a \u0d89\u0dc4\u0dc5 \u0dba\u0dd1\u0dc1\u0db4\u0dad \u200d\u0dbb\u0dc0\u0da7\u0dad\u0dcf\u0dc0 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dba\u0da7\u0dba \u0d9a\u0dba \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0d9a\u0dcf\u0d9a\u0dcf \u0dc3\u0dc1\u0dad\u0ddc\u0dc3 \u0dc3\u0db8\u0dcf\u0d9c\u0db8\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0d9a\u0dd0\u0db6\u0dd4\u0da7\u0dcf, \u0da0\u0dd3\u0db1\u0dc1\u0dba\u0db1\u0dca \u0d86\u0db1\u0dba\u0db1\u0dba \u0d9a\u0dba\u0db1\u0dd4 \u0d9a \u0db1 \u0dc1\u0d9a\u0ddc \u0dbd\u0dd6\u0db1\u0dd4 \u0d9a\u0dd2\u0dc1\u0d9a\u0ddd\u0dc0\u0d9a\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 600\u0d9a\u0dca \u0db4\u0db8\u0da7 \u0dc0\u0dd6 \u0db8\u0dd2\u0d9a\u0d9a\u0da7 \u0d9a \u0dcf \u0daf\u0dd3\u0db8\u0da7. \u0d8a\u0da7 \u0d85\u0db8\u0dad\u0dba\u0dc0 \"\u0dc0\u0dcf\u0dd2\u0db1 \u0db8\u0dbd\u0dca\u0d9a\" \u0dba\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dc3\u0dc4\u0db1 \u0db8\u0dbd\u0dca\u0d9a\u0d9a\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0dcf \u0daf\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 4,500\u0d9a\u0dca \u0dc0\u0da7\u0dd2\u0db1\u0dcf \u0d85\u0dad\u200d\u0dc0 \u200d :\u0dcf\u0da9\u0dd4\u0da9 12\u0d9a\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 6,420\u0d9a\u0da7 \u0d85\u0dc1\u0dc5\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dba\u0db1 \u0d9a\u0dd9 \u0d85\u0dad\u0dba, \u0dc1\u0db8\u0db8 \u0dc0\u0dcf\u0dd2\u0db1 \u0db8\u0dbd\u0dca\u0d9a \u0dc3\u0db3\u0dc4\u0dcf \u0daf\u0dd4 \u0dcf\u0d9a \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0d9a\u0dca \u0db4\u0dd0\u0dc0\u0dad\u0dd3\u0db8 \u0dd9 \u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8 \u0d9a\u0dc0\u0dba\u0d9a\u0dd2."
