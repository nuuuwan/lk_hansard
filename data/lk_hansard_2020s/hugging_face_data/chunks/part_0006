    "chunk_text": "\u0d85\u0db4\u0dd2 \u0d85\u0dad\u0dd3\u0dad\u0dc1\u0dda \u0d89\u0dad\u0dcf\u0db8 \u0daf\u0dbb\u0dd4\u0dd4\u0db8 \u0dc0\u0dd2\u0db0\u0dd2\u0dd9\u0da7 \u0dbb\u0dc3\u0dad\u0dad\u0dc0\u0dcf\u0daf\u0dd9 \u0db1\u0dd2\u0dc3\u0dcf \u0dd4\u0d9a\u0dca \u0dc0\u0dd2 \u0dd4\u0dbb \u0da2\u0dcf\u0dd2\u0dd9\u0d9a\u0dca. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dc3\u0dcf\u0dc0\u0db0\u0dcf\u0db1\u0dc0 \u0d85\u0db0\u0dba\u0dd9\u0db1\u0dd9 \u0d9a\u0dbb\u0dbd\u0dcf \u0dc1\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb \u0dad\u0db1\u0dd9 \u0dc0\u0dd2\u0dc3 \u0dcf\u0d9c\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0db4\u0dcf\u0dc3\u0dad\u0dd4 \u0d89\u0dbb\u0dd2\u0daf\u0dcf \u0dbb\u0dc3\u0dad\u0dad \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0dd9 \u0dc3\u0dd2\u0dd4\u0dc1\u0dc0\u0dbd\u0dcf \u0dc1\u0db8\u0dca \u0d85\u0dc1\u0dda\u0dbd\u0dca 2 21\u0dc0\u0db1 \u0daf\u0dcf\u0da7 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4 \u0db4\u0dc4\u0d9a\u0dca \u0d9c\u0dad \u0dc1\u0dc0\u0dbd\u0dcf \u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0da7\u0dad\u0dca \u0dbb\u0dc3\u0dad\u0dad\u0dc0\u0dcf\u0daf\u0dd2\u0db1\u0dca \u0dc1\u0db6\u0ddd\u0db8\u0dca\u0db6 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0dd9\u0d9a\u0dca \u0db8\u0dbd\u0dca 2\u0dbd \u0d9a\u0dc5\u0dcf. \u0d92 \u0d9c\u0dd0\u0db1 \u0d9a\u0dd2\u0db1\u0dca \u0d9a\u0dcf\u0dcf \u0d9a\u0dc5 \u0d87\u0db8\u0dd2\u0dd4\u0db8\u0dcf \u0dc3 \u0dc4\u0db1\u0dca \u0d9a\u0dc5\u0dcf. \u0dc1\u0db8\u0dca \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0dcf\u0da7 \u0d92 \u0dc3\u0dd2\u0dda\u0db0\u0dd2\u0dd9 \u0dc3\u0dd2\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf\n\n\u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4 18\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0dc1\u0db8\u0dca \u0dc1\u0db6\u0ddd\u0db8\u0dca\u0db6 \u0dc1\u0dc3\u0dbd\u0dca 2\u0dbd\u0db8 \u0d9c\u0dd0\u0db1\u0d91 \u0dbb\u0dc3\u0dad\u0dad\u0dc0\u0dcf\u0daf\u0dd9 \u0d9c\u0dd0\u0db1 \u0d85\u0db4\u0da7 \u0d89\u0dad\u0dcf \u0d85\u0dc4\u0dd2\u0db8\u0dd2\u0dbb\u0dd2 \u0d85\u0dad\u0dca\u0daf\u0dd0\u0dd3 \u0db8\u0dca \u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc1\u0db8\u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0dad\u0dca\u0daf\u0dd0\u0dd3 \u0db8\u0dca \u0d87\u0dd2\u0dc0\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0d9a\u0dcf\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1\u0d9a\u0dcf\u0dc1\u0dc4\u0dcf\u0db8 \u0dc0\u0dd4\u0dab\u0dad\u0dca\u0d91 \u0dc1\u0db8\u0dca\u0dc1\u0d9a\u0dca \u0dc0\u0dd2\u0db1\u0dca\u0daf\u0dd2\u0dad\u0dd9\u0db1\u0dca\u0da7 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dd9\u0d9a\u0dca \u0d89\u0da7\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0.\n\n\u0dc1\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0dd9 \u0dc3\u0dd2\u0dd4\u0dc0\u0dd4\u0dd4\u0db8 \u0d9a\u0dcf\u0dbd\u0dc0\u0d9a\u0dc0\u0dcf\u0db1\u0dd4\u0dc0\u0d91 \u0d92\u0d9a \u0db6\u0dbd\u0db4\u0dd1 \u0dca\u0d9a\u0dcf\u0dbb\u0dd9\u0d91 \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0dd9 \u0dc4\u0dbb\u0dc4\u0dcf \u0dc0\u0dcf\u0dc3\u0dd2 \u0dbd\u0dd0\u0db6\u0dd4\u0dc1\u0da9\u0dd4\u0d9a \u0d9a\u0dcf\u0da7\u0daf \u0d9a\u0dd2\u0dd9\u0db1 \u0d9a\u0dbb\u0dd4\u0dd4\u0db8 \u0d9c\u0dd0\u0db1 -\u0dc1\u0db8\u0dca \u0d94\u0d9a\u0dca\u0dc1\u0d9a\u0dcf\u0db8 \u0d9c\u0dd0\u0db1- \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0db8 \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d85\u0dc0\u0dc1\u0db6\u0ddd\u0db0\u0dc1\u0dd9\u0db1\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0dc1\u0db8\u0dcf\u0db1 \u0dc0\u0dcf\u0dc1 \u0d9a\u0dcf\u0dbd\u0dd9\u0d9a\u0daf \u0dc1\u0db8\u0dca\u0d9a \u0dc0\u0dd4\u0dc1\u0da9\u0dd4\u0d9a\u0d91 \u0d8a\u0da7 \u0db4\u0dc3\u0dd4\u0dc0 \u0dc1\u0db8\u0dcf\u0db1 \u0dc0\u0dcf\u0dc1 \u0db8\u0dd0\u0dd2\u0dc0\u0dbb\u0dab \u0dca\u0dc0\u0dcf\u0daf\u0d91 \u0db8\u0daf\u0dcf \u0dc1\u0db8\u0dcf\u0db1 \u0dc0\u0dcf\u0dc1 \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1 \u0db4\u0dc3\u0dd4\u0db6\u0dd2\u0db8\u0d9a\u0dca\u0daf \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0db8 \u0dd2\u0db6\u0dd4\u0dc1\u0da9\u0dd4\u0d9a\u0d91 \u0d9a\u0dc0\u0dd4\u0daf \u0d92\u0dc0\u0dcf \u0db8\u0dcf\u0d9a\u0db8 \u0d9a\u0dc1\u0dc5\u0dad\u0d91 \u0d9a\u0dc0\u0dd4\u0daf \u0d92\u0dc0\u0dcf\u0dba\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbd\u0dbd \u0dbd\u0dd0\u0db6\u0dd4\u0dc1\u0dca \u0d9a\u0dd2\u0dd9\u0dbd\u0dcf \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0db8 \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf."
  },
