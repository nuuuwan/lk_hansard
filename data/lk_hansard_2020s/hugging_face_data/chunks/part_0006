    "chunk_text": "\u0db8\u0dd6\u0d9a\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db8\u0dd4\u0dd4 \u0da7\u0dba\u0dc0\u0d9a \u200d\u0dbb\u0dad\u0dd2 \u0dad\u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dd0\u0dbd\u0dd4\u0dc1\u0dc0\u0ddc \u0d9a \u0db8\u0dd4\u0dd4 \u0da7\u0dba \u200d\u0dbb\u0db8\u0dcf\u0da7\u0dc1\u0dba\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 1.03\u0d9a\u0dca \u0dc1\u0db4\u0dad \u0d9a\u0dcf\u0d9a \u0dc3\u0dd3\u0db8\u0dcf\u0dc0 \u0dad\u0dd4\u0dc5 \u0db4\u0dba\u0dcf\u0dc1\u0da7\u0dca \u0dd3\u0db8\u0dad\u0dd2\u0dba\u0da7 \u0dba\u0da7 \u0d9a \u0dc0\u0dd4\u0da7\u0dcf. \u0d85\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0da7\u0dba \u0d85\u0dba\u0dc1\u0d9c\u0db1 \u0dd0\u0dbd\u0dd4\u0dc1\u0dc0\u0ddc \u0d9a \u0dc1\u0db4\u0dad \u0d9a\u0dcf\u0d9a \u0dc3\u0dd3\u0db8\u0dcf\u0dc0 \u0dad\u0dd4\u0dc5 \u0dc3\u0dd2\u0dba\u0dba\u0da7 8.03\u0d9a\u0dca \u0db4\u0dba\u0dcf\u0dc1\u0da7\u0dca \u0dd3\u0db8\u0dad\u0dd2\u0dba\u0da7 \u0dba\u0da7 \u0d9a \u0dc0\u0dd4\u0da7\u0dcf. \u0db8\u0db8 \u0d92 \u0dcf \u0d9a\u0dad \u0d91\u0d9a\u0dca\u0d9a\u0db8\u0dd2 \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc0\u0dd0\u0db8\u0dca\u0dab\u0dd4 \u0dca\u0d9a\u0dae\u0dd2\u0d9a\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db1 \u0dca\u0d9a\u0dae\u0dd2\u0d9a \u0d85\u0d9a\u0db6\u0dd4\u0dcf\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db1 \u0dc1\u0db4\u0dad \u0dba\u0dc1\u0da7\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0db1\u0dca 2 263\u0dc1\u0dcf\u0dc1\u0db1\u0d9a\u0dd4\u0da7 \u0dc1\u0db4\u0dad \u0db4\u0dba\u0dcf\u0dc1\u0da7\u0dca \u0dd3\u0db8\u0dad\u0dd2\u0dba \u0db1\u0dd2\u0dc3\u0dcf \u0d8d\u0da2\u0dd4\u0dc0 \u200d\u0dbb \u0dcf\u0db1\u0dc0\u0d9a\u0da7 \u0db8\u0dd4\u0dc4\u0dd4\u0da7 \u0dc1\u0dcf\u0db1\u0dca\u0db1 \u0dc3\u0dd2\u0dbd\u0dd2 \u0dc0\u0dd4\u0da7\u0dcf. \u0d92 \u200d\u0dbb \u0dcf\u0db1\u0dc0\u0d9a\u0da7 \u0dad\u0db8\u0dd2 \u0d85\u0db4\u0dd2 \u0d85\u0dcf \u0dc1\u0db4\u0dad \u0dc3 \u0d9a\u0dad\u0dba \u0dc1\u0dc3\u0ddc\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc4\u0dd0 \u0dd0\u0dd2 \u0d91\u0dba \u0dc3\u0db8\u0dc3\u0dcf\u0dad \u200d\u0dbb \u0dcf\u0db1\u0dc0\u0d9a\u0da7 \u0dc3 \u0d9a\u0dad\u0dba \u0dc1\u0dc3\u0ddc\u0dba\u0db1 \u0dc0\u0dba\u0dcf\u0dba\u0dcf\u0db8\u0dba\u0d9a\u0dca. \u0db4\u0dba\u0dcf\u0dc1\u0da7\u0dca \u0dd3\u0db8\u0dad\u0dd2\u0dba \u0daf\u0dd4\u0dad\u0dba\u0d9a\u0dca \u0d85\u0dd2 \u0db1\u0dca \u0d9a\u0dba\u0d9a\u0dcf \u0dba\u0db4\u0dad \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0da7 \u0daf\u0dd4\u0dad\u0dba\u0d9a\u0dca \u0dc3 \u0d9a\u0dad\u0dba \u0dc1\u0dcf\u0db1\u0dca\u0db1 \u0dba\u0da2\u0dcf\u0dba\u0d9a\u0da7 \u0dd0\u0dc4\u0dd0. \u0dc3\u0db8\u0dc3\u0dcf\u0dad \u0dca\u0d9a\u0dae\u0dd2\u0d9a\u0dba \u0dd2\u0db1\u0dc4\u0dcf \u0d9a\u0db1\u0dca\u0db1 \u0dba\u0da2\u0dcf\u0dba\u0da7 \u0dc3\u0dd2\u0dda\u0db0 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf.\n\n873 874\n\n\u0db4\u0dcf\u0d9a\u0db6\u0dbd\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n13.4\u0d9a\u0dca\u0dc0 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0d85\u0dba \u0dc1\u0db1\u0ddc\u0dc0\u0db1 \u0da7\u0dba \u200d\u0dbb\u0dad\u0dd2 \u0dad\u0dba 2023 \u0dc1\u0dcf\u0dc3\u0dd0\u0db4\u0dad \u0d9a 31 \u0dc0\u0db1 \u0daf\u0dd4\u0da7 \u0dc3\u0dd2\u0dba\u0dba\u0da7 12.8\u0d9a\u0dca \u0dcf\u0d9a\u0dca\u0dc0\u0dcf \u0d87\u0daf\u0dd4\u0dbd\u0dca\u0d9a\u0dcf \u0dad\u0dd2\u0dc1 \u0db1\u0dc0\u0dcf. \u0dc3\u0db8\u0dc3\u0dcf\u0dad \u200d\u0dbb \u0dcf\u0db1\u0dc0\u0d9a\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0dc1\u0dc3\u0ddc\u0dba\u0db1 \u0d91\u0d9a \u0dad\u0db8\u0dd2 \u0d85\u0dc1 \u0dba\u0da2\u0dcf\u0dc1\u0dda \u200d\u0dbb\u0dad\u0dd2\u0db4 \u0d9a\u0dad\u0dd2\u0dba. \u0d85\u0dcf \u0db4\u0dba\u0dcf\u0dc1\u0da7\u0dca \u0dd3\u0db8\u0dad\u0dd2\u0dba \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0d9a\u0dcf \u0dc1\u0dc4\u0da7 \u0d85\u0dc1\u0db1\u0d9a\u0dca \u0db4\u0dd0 \u0d9a\u0dc1\u0dad\u0db1\u0dca \u0dd2\u0dba\u0dc4\u0dd2\u0db1\u0dca \u0dd0\u0dcf\u0d9a\u0dd4 \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0db1 \u200d\u0dbb\u0dad\u0dd2\u0db4 \u0d9a\u0dad\u0dd2\u0dba \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dd2 \u0dba\u0da2\u0dcf\u0dba\u0da7 \u0dad\u0dd2\u0dc1 \u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dba\u0da2\u0dcf\u0dba\u0da7 \u0d8a\u0da7 \u0dc0\u0da9\u0dcf \u0dc0\u0d9c\u0dd3 \u0db8\u0d9a\u0dca \u0dad\u0dd2\u0dc1 \u0db1\u0dc0\u0dcf \u0db8\u0dd6\u0d9a\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2."
  },
