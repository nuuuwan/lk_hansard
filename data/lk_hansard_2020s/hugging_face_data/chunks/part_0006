    "chunk_text": "\u0b86\u0bb1\u0bc1 \u0bb5\u0bb0\u0bc1\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd, \u0ba4\u0baa\u0bb0\u0bc1\u0ba8\u0bcd\u0bae\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd \u0ba4\u0ba4\u0bbe\u0bc8\u0bbf\u0bb2\u0bbe \u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbe\u0b9f\u0bcd\u0b9a\u0bae\u0bcd\u0baa\u0bb3\u0bae\u0bcd 1,000 \u0bb0\u0bc2\u0baa\u0bbe\u0ba4\u0baf\u0ba9 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. \u0b8e\u0ba9\u0bbf\u0ba9\u0bc1\u0bae\u0bcd, \u0b85\u0ba4\u0b95\u0ba9\u0b95\u0bcd \u0ba4\u0b95\u0bbe\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b90\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0bb0\u0bc1\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0b9a\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0ba4\u0ba4\u0bbe\u0bbf\u0baf\u0bc1\u0bae\u0bcd! \u0b95\u0b9f\u0ba8\u0bcd\u0ba4 \u0bae\u0bae \u0ba4\u0bbf\u0ba9\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9c\u0ba9\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0ba4\u0b95\u0bcc\u0bb0\u0bb5 \u0ba4\u0ba4\u0bbe\u0bc8\u0bbf\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bb5\u0bb3\u0bbf\u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0bae\u0bb5\u0b95\u0bb2\u0bb5\u0bbe\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bc1 \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0ba4\u0baa\u0bb0\u0bc1\u0ba8\u0bcd \u0bae\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd \u0ba4\u0ba4\u0bbe\u0bc8\u0bbf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 1,700 \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd \u0ba8\u0bbe\u0b9f\u0bcd\u0b9a\u0bae\u0bcd\u0baa\u0bb3\u0bae\u0bcd \u0ba4\u0b95\u0bbe\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0bbe\u0b95\u0b9a\u0bcd \u0ba4\u0b9a\u0bbe\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0b89\u0ba3\u0bcd\u0b95\u0bae\u0baf\u0bbf\u0bae\u0bb2 \u0b87\u0ba4\u0bc1 \u0bb5\u0bb0\u0bae\u0bb5\u0bb1\u0bcd\u0b95\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0b92\u0bb0\u0bc1 \u0bb5\u0bbf\u0b9f\u0baf\u0bae\u0bbe\u0b95\u0bc1\u0bae\u0bcd. \u0b8e\u0b99\u0bcd\u0b95\u0b95\u0bb3\u0baa\u0bcd \u0ba4\u0baa\u0bbe\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4 \u0bb5\u0b95\u0bb0\u0baf\u0bbf\u0bb2\u0bcd, \u0bae\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd \u0ba4\u0ba4\u0bbe\u0bc8\u0bbf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 1,500 \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0baa \u0b95\u0b9f\u0b9a\u0bcd \u0b9a\u0bae\u0bcd\u0baa\u0bb3\u0bae\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\u0bae\u0bb2\u0ba4\u0bbf\u0b95\u0bae\u0bbe\u0b95\u0b95\u0bcd \u0ba4\u0b95\u0bbe\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0ba9\u0bb5\u0bc1\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0bb5\u0bc8\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f \u0bae\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd. \u0ba4\u0b95\u0bb3\u0bb0\u0bb5 \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bae\u0bb3, \u0b85\u0ba9\u0bcd\u0bb1\u0bc1 1,350 \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0b95\u0b9f\u0b9a\u0bcd \u0b9a\u0bae\u0bcd\u0baa\u0bb3\u0bae\u0bcd \u0bb5\u0bc8\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bbe\u0b95\u0b9a\u0bcd \u0ba4\u0b9a\u0bbe\u0ba9\u0bcd\u0ba9 \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0b87\u0ba9\u0bcd\u0bb1\u0bc1 1,200 \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd \u0bb5\u0bc8\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bbe\u0b95\u0b9a\u0bcd \u0ba4\u0b9a\u0bbe\u0bb2\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bcd.\n\n\u0dad\u0dc0 \u0d9a\u0dcf\u0dba\u0da7\u0dba\u0d9a\u0dca \u0db8\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0dc1 \u0db1\u0dc0\u0dcf. \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 1,700\u0d9a \u0db4\u0da9\u0dd2\u0dba\u0d9a\u0dca \u0dc1\u0dd9\u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0d94 \u0dad\u0dd4\u0db8\u0db1\u0dca\u0d9a\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0dbd\u0dd4, \u0dd9\u0dbd\u0dd4 \u0d9a\u0dd2\u0dc1\u0d9a\u0ddd 25\u0d9a\u0dca \u0d9a\u0da9\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0d9a\u0dcf. \u0dca\u0dc1\u0dc4\u0db8 \u0d9a\u0dba\u0db1\u0dca\u0db1 \u0dd0\u0dc4\u0dd0 \u0dc1\u0db1\u0dca. \u0dca\u0dc1\u0dc4\u0db8 \u0db1\u0db4\u0dad, \u0dc1\u0db8\u0ddc\u0db1\u0dc0\u0dcf\u0da7\u0dd9 \u0db4\u0da9\u0dd2 \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0dbb\u0db8\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dba\u0db1\u0dc0\u0dcf \u0db1\u0db4\u0dad,- [ \u0dcf\u0db0\u0dca\u200d\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dca] \u0d94 \u0dad\u0dd4\u0db8\u0dcf \u0db8\u0da7 \u0dcf\u0db0\u0dca\u200d\u0dcf \u0dc1\u0db1\u0ddc\u0d9a\u0dba \u0d89\u0db1\u0dca\u0db1. \u0db8\u0db8 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf\u0da7 \u0db4\u0dc3\u0dcf\u0dc1\u0dc3\u0dda \u0d94 \u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0db1\u0dca\u0db1. \u200d\u0dbb \u0dcf\u0db1\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0.\n\n\u0dc0\u0dad\u0dd4\u0d9a\u0dba\u0dc1 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dcf\u0dc3\u0dd4 \u0daf\u0dd2\u0d9c\u0da7\u0db8 \u0dba\u0dc0\u0da7\u0d9a\u0dcf \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dc1\u0d9c\u0db1\u0dca \u0dc4\u0dd0\u0db8\u0dd9\u0dcf\u0db8 \u0dbb\u0db8\u0dba \u0d9c \u0d9a\u0dad \u0d9a \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad \u0dc0\u0dd0\u0db8\u0dca\u0db4\u0d9a\u0dca \u0d9a \u0dcf \u0dc1\u0dd9\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dd4\u0dc0\u0db6\u0dbd\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 1,700\u0d9a \u0dc0\u0dd0\u0db8\u0dca\u0db4\u0d9a\u0dca \u0d9a \u0dcf \u0dc1\u0dd9\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0d9a\u0dcf \u0d8a\u0da7 \u0db4\u0dc3\u0dcf\u0dc1\u0dc3\u0dda \u0dc4\u0dcf\u0db4\u0dad\u0dbb\u0db4\u0dad\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0dc3\u0dcf\u0d9c\u0db8\u0dba \u0dca\u0d9a\u0dca\u0d9a \u0d9a\u0dae\u0dcf \u0d9a\u0dba\u0d9a\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 1,200\u0d9a \u0dc0\u0dd0\u0db8\u0dca\u0db4\u0d9a\u0dca \u0d9a \u0dcf \u0dc1\u0dd9\u0db1\u0dca\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dba\u0db1\u0dc0\u0dcf \u0d9a\u0dd2 \u0dc1 \u0d87\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0db8\u0db8 \u0dd9\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0d9a\u0ddc\u0dc1\u0dc4\u0ddc\u0db8 \u0dc0\u0dd4\u0da7 \u0d9a \u0d92 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dcf\u0dc3\u0dd4\u0db1\u0dca\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 1,700\u0d9a\u0dca \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dba\u0dd2, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 2,000\u0d9a\u0dca \u0dbd\u0dd2\u0db1\u0dca\u0db1 \u0d9a \u0d85\u0db4\u0dd2 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dd2. \u0dca\u0dc1\u0dc4\u0db8 \u0dc1\u0dd9\u0db1\u0dca\u0db1 \u0dbb\u0db4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0db1\u0db4\u0dad \u0dc1\u0dc4\u0ddc\u0db3\u0dba\u0dd2. \u0d94 \u0dad\u0dd4\u0db8\u0dcf \u0d9a, \u0d85\u0db4\u0dd2 \u0d9a \u0dca\u0d9a camp \u0dca\u0d9a\u0d9a \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf \u0dc1\u0db1\u0dca. \u0d94 \u0dad\u0dd4\u0db8\u0dcf \u0dc1\u0db4\u0dad \u0d9c\u0dd0\u0db1 \u0dd9\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dc0\u0dad\u0dd4 \u0d9a\u0db4\u0dad\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 2,000\u0d9a\u0dc0 \u0d9a \u0db4\u0da9\u0dd2\u0dba\u0d9a\u0dca \u0dc1\u0dd9\u0db1\u0dca\u0db1 \u0d94 \u0dad\u0dd4\u0db8\u0db1\u0dca\u0d9a\u0dcf \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dba\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dcf \u0db8\u0db8 \u0d9a\u0dcf\u0dc1\u0db4\u0ddc\u0dc1\u0dba\u0dad\u0dcf \u0d9a\u0dad\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0d92 \u0dc3\u0db4\u0dad \u0db1\u0dca\u0db0\u0dca\u200d\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0dc4\u0ddc\u0db3 \u0dad\u0dd3\u0dba\u0da7\u0dba\u0d9a\u0dca \u0d85\u0dba\u0dc1\u0d9c\u0db1 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1. \u0dc0\u0dad\u0dd4 \u0dc3\u0dcf\u0d9c\u0db4\u0dad \u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dbb\u0dca\u0dba\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0db4\u0dad\u0d9a\u0da7 \u0dda\u0dc3\u0dcf\u0daf\u0dd4\u0dba\u0da7 \u0dba\u0db1\u0dc0\u0dcf. \u0d92\u0d9a \u0dc0\u0dc5\u0d9a\u0dca\u0dc0\u0db1\u0dca\u0db1 \u0dd0\u0dc4\u0dd0. \u0d92\u0dc1\u0d9c\u0ddc\u0dbd\u0dca\u0d9a\u0db1\u0dca \u0dda\u0dc3\u0dcf\u0daf\u0dd4\u0dba\u0da7 \u0d9c\u0dd2\u0dba\u0dcf\u0db8 \u0db4\u0da9\u0dd2 \u0dc1\u0dd9\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4 \u0dd9\u0d9a\u0dca \u0dc1\u0dd9\u0d9a\u0d9a\u0dca \u0dc1\u0db4\u0dad\u0d9a \u0d87\u0dd9\u0dc1\u0d9c\u0db1 \u0dba\u0db1\u0dc0\u0dcf. \u0dca\u0dad\u0dc1\u0d9a\u0ddc\u0da7 \u0d92\u0dc1\u0d9a\u0dca \u200d\u0dbb\u0dc1\u0dba\u0ddd\u0da2\u0db1\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0."
