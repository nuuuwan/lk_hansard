u0dbd\u0dd2\u0dba\u0db1 2018 (106,162.41)\n\n2019 (11,856.60)\n\n2020 2,356.38 2021 (81,816.43)\n\n2022 (617,589.39)\n\n1013 1014\n\n2024 \u0db8\u0dd0\u0dba\u0dd2 08\n\n(iv) 1. \u0dc0\u0dbb\u0dca\u0dad\u0db8\u0dcf\u0db1\u0dc1\u0d86 \u0da2 \u0da2\u0dcf\u0dad\u0dba\u0db1\u0dca\u0dad\u0dba \u0db8\u0dd2\u0dbd \u0d9c\u0dab\u0db1\u0dca\u0dc0\u0dbd\n\n\u0dc4\u0dcf \u0dc0\u0dd2\u0db1\u0dd2\u0db8 \u0d85\u0dd4\u0dc0\u0db4\u0dcf\u0dad\u0dd2\u0d9a\u0dc1\u0d86 \u0dc1\u0dc0\u0db1\u0dcf\u0dae\u0dc0\u0dd3\u0db8\u0dca\u0dc0\u0dbd\u0da7 \u0dcf\u0db8\u0d9c\u0dcf\u0db8\u0dd3\u0dc0 \u0d85\u0dc1\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0dc0\u0dd0 \u0dc0\u0dbd \u0d87\u0dad\u0dd2 \u0dc0\u0db1 \u0dc1\u0dc0\u0db1\u0dcf\u0dae\u0dc0\u0dd3\u0db8\u0dca \u0daf \u0dcf\u0dbd\u0d9a\u0dcf \u0dc1\u0dda\u0dc1\u0dd3 \u0d9b\u0dca\u200d\u0db1\u0dd2\u0da2 \u0dc1\u0dad\u0dbd\u0dca \u0dc0\u0dd2\u0d9a\u0dd4\u0dd4\u0db8\u0db8\u0dca \u0db8\u0dd2\u0dbd \u0d9c\u0dab\u0db1\u0dca \u0dcf\u0dcf\u0dc1 \u0ddd\u0db0\u0dca\u200d\u0db1 \u0dbb\u0dd3\u0db8\u0dda\u0db8.\n\n2. \u0dc0\u0dd2\u0db1\u0dd2\u0db8 \u0d85\u0dd4\u0dc0\u0db4\u0dcf\u0dad \u0db8\u0dad \u0d87\u0dad\u0dd2 \u0dc0\u0db1 \u0d85\u0dbd\u0dcf \u0dcf\u0dc4 \u0dd6\u0dbd\u0dbd\u0dba\n\n\u0db4\u0dd2\u0dbb\u0dd2\u0dc0\u0dd0 \u0d85\u0dc0\u0db8 \u0dc0\u0db1 \u0dc1\u0dbd\u0dcf \u0dcf\u0dcf\u0dcf\u0dae\u0dcf\u0dcf\u0dc1 \u0dcf\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0d9c\u0dcf\u0dba \u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dd4\u0db8 \u0d9a\u0dcf\u0dbb\u0dca \u0d9a\u0dca\u0dc2\u0db8 \u0dbb\u0dd3\u0db8\u0dda\u0db8.\n\n3. \u0d89\u0db1\u0dca\u0db0\u0dca\u200d\u0db1 \u0dca\u0db1 \u0db1\u0dc1\u0d86 \u0da2 \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0daf \u0d87\u0dad\u0dd2\n\n\u0dc1\u0db1\u0dcf\u0dc0\u0dd3\u0db8 \u0dcf\u0db3\u0dc4\u0dcf \u0db1\u0dc0 \u0d89\u0db1\u0dca\u0db0\u0dca\u200d\u0db1 \u0db8\u0dd2\u0dbd \u0da2 \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dcf\u0dc4 \u0db4\u0dd2 \u0dc0\u0dd3\u0dc1\u0db8\u0dca \u200d\u0dbb\u0db8 (ex-storage \u0dc0\u0dd0\u0db1\u0dd2 \u200d\u0dbb\u0db8 \u0dcf\u0dc0\u0dd2\u0dad \u0dbb\u0dd3\u0db8\u0dda\u0db8 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0daf \u0d9c\u0dcf\u0dcf\u0dae\u0dad\u0dd4\u0db8 (demurrage) \u0dc1\u0dd4\u0db1\u0dba \u0dc0\u0dd3\u0db8 \u0dc4\u0dcf \u0dcf\u0dcf\u0dcf\u0dae\u0dcf\u0dcf\u0dc1 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dba\u0dab \u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0db1\u0dca \u0dd6\u0dbd\u0dbd\u0dba \u0dc0\u0dd2 \u0daf\u0db8\u0dca \u0db4\u0dcf\u0dbd\u0db1 .\n\n4. \u0dd2\u0db8 \u0dcf\u0db4\u0daf\u0dd2\u0dcf\u0dd2 \u0dcf\u0dd0\u0db4\u0dd4\u0dad\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dbb\u0dd3\u0db8\u0dda\u0db8 \u0dc4\u0dcf\n\n\u0d9b\u0dca\u200d\u0db1\u0dd2\u0da2 \u0dc1\u0dad\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0dcf\u0db3\u0dc4\u0dcf \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dc1 \u0dcf\u0dc4 \u0dcf\u0dd2\u0dab\u0dad\u0dca\u0dc0 \u0dc0\u0dd0\u0da9\u0dd2 \u0dbb\u0dd3\u0db8\u0dda\u0db8 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dad\u0dba\u0d9c\u0d9a\u0dcf\u0dbb\u0dd2\u0dad\u0dca\u0dc0 \u0dc0\u0dd0\u0da9\u0dd2 \u0dbb\u0dd3\u0db8\u0dda\u0db8 \u0dcf\u0dc4 \u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0db1\u0dca \u0d89\u0db1\u0dca\u0db0\u0dca\u200d\u0db1 \u0dca\u0db1 \u0db1 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0db8\u0dd2 \u0db8\u0dca \u0d85\u0d9c \u0d85\u0dca \u0dbb\u0dd3\u0db8\u0dda\u0db8\u0da7 \u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dd4\u0db8 \u0dbb\u0dd3\u0db8\u0dda\u0db8."
