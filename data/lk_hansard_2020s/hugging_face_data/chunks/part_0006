    "chunk_size_bytes": 3395,
    "chunk_text": "\u0db4\u0dca\u200d\u0dbb\u0db0\u0dc1\u0db1 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2 \u0dc0\u0dc1\u0dc1 \u0db8, \u0da2\u0dc1\u0dad\u0dd2\u0d9a \u0da2\u0db1 \u0db3\u0dbd\u0dc1\u0dda\u0d9c\u0dc1 \u0db1\u0dc1 \u0d9a\u0dad\u0dd4\u0db8\u0dc1\u0dad\u0dca \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dc1\u0dbb \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0dc0 \u0dc4\u0dd0\u0d9a \u0dc1 \u0db8\u0dd4 \u0d9a\u0dc1\u0dc5\u0dda, \u0dc1\u0d9c\u0ddd\u0db0\u0dc1 \u0dbb\u0dc1\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dc1 \u0dbb\u0dc1\u0da7\u0dca \u0db4\u0dc1\u0dbd\u0db1 \u0da7 \u0dc1\u0d9c\u0db1 \u0d92\u0db8 \u0dc4 \u0dc4\u0dc1 \u0d9a\u0dc5 \u0dc1\u0dbd\u0dca \u0dc0\u0dd0\u0d9a\u0dd2 \u0d9a\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dab \u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2 \u0da7\u0dba\u0dd2. \u0dc1\u0d9c\u0ddd\u0db0\u0dc1 \u0dbb\u0dc1\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dc1 \u0db3\u0dbd \u0da7 \u0db4\u0dad\u0dca \u0dc1\u0dc0\u0dbd\u0dc1 \u0da2\u0db1\u0dc1\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dc1 \u0dc0 \u0dc1 \u0db1\u0dca \u0dd2\u0db1\u0da7\u0dd2 \u0daf\u0dd3 \u0dc1\u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dc0\u0dd2\u0dc1\u0dbb\u0ddd\u0db0\u0dad\u0dc1 \u0dc4\u0db8\u0dd4\u0dc1\u0dda \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0db3\u0dbd \u0d85\u0dad\u0dc4\u0dd0\u0dbb \u0d9c\u0dd2 \u0d86\u0d9a\u0dc1\u0dbb \u0d9c\u0dd0\u0db1 \u0dd2\u0dad\u0dad\u0db1 \u0dc0\u0dd2\u0da7, \u0d85\u0db4 \u0db1\u0db8\u0dca \u0dd2\u0dad\u0dad\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0db8 \u0db1 \u0d86\u0d9a\u0dc1\u0dbb \u0d9a\u0da7\u0dc0\u0dad\u0dca \u0dc1\u0db8\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dab \u0d9a\u0da7 \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0dc4\u0dc0\u0dd4\u0dbd\u0dca \u0dc0\u0dd4\u0dab\u0dc1 \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a \u0dd2\u0db1\u0dad\u0dd3\u0db8\u0dad\u0dca \u0d85\u0db4\u0dc4\u0dc3\u0dd4 \u0db3\u0dc0\u0dba\u0dd2.\n\n\u0d86\u0dab\u0dca\u0da9\u0dd4 \u0db4\u0d9a\u0dca\u0dc2\u0dc1 \u0dc1\u0db3 \u0dc1\u0dc4\u0ddd \u0db8\u0db1\u0dca\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0db8\u0dad\u0d9a\u0dca \u0d9a\u0dc1\u0dc5\u0dda, \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dc1\u0dbb \u0dd2\u0db1\u0daf\u0dd4 \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0dab\u0dca, \u0d85\u0daf \u0db4\u0dca\u200d\u0dbb\u0db0\u0dc1\u0db1 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dc1 \u0dd2\u0db1\u0da7\u0dd2\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dc1\u0db1\u0dd3\u0db1\u0dca\n\n\u0d87\u0db8\u0dad\u0dd2 \u0db0\u0dd4\u0dbb \u0daf\u0dd0\u0dbb\u0dd6 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0d9a\u0dca \u0db3\u0dc0\u0dba\u0dd2. \u0d85\u0db4\u0dd2 \u0daf\u0dd0\u0db1\u0dca \u0d85\u0db4 \u0d91\u0d9a\u0dd2\u0dc1\u0db1\u0d9a\u0dc1\u0da7\u0db8 \u0dc1\u0db8\u0dca \u0dc4\u0db8\u0dca\u0db3\u0db1\u0dca\u0db0\u0dc1 \u0db1\u0dca \u0dc1\u0da0\u0ddd\u0daf\u0db1\u0dc1 \u0db1\u0d9f\u0dc1 \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dc1.\n\n\u0daf\u0dd0\u0db1\u0dca \u0daf\u0dd0\u0db1\u0dca \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0db8\u0dc1 \u0dab \u0db8\u0d82\u0dc1\u0db4\u0dad\u0dca \u0dc0\u0dd2\u0dc0\u0dbb \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dad\u0dca, \u0d88\u0dad \u0d89\u0dad\u0dd2\u0dc4\u0dc1\u0dc4\u0dc1 , \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0d87\u0dad\u0dd0\u0db8\u0dd4\u0db1\u0dca \u0dc4\u0dbd\u0d9a\u0db1 \u0db8\u0dd2\u0dae\u0dba\u0dc1 \u0d89\u0dad\u0dd2\u0dc4\u0dc1\u0dc4\u0dc1 \u0dd2\u0db1\u0daf\u0dd4 \u0dc0\u0dd6 \u0dd2\u0db1\u0dda\u0db0\u0dd2\u0daf\u0dc1\u0db8 \u0dc0\u0dd0\u0db1\u0dd2\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dc0\u0dd2\u0db8 \u0d9a\u0dca. \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0db8\u0dc1 \u0dab \u0db8\u0d82\u0dc1\u0db4\u0dad\u0dca \u0dc0\u0dd2\u0dc0\u0dbb \u0dc1\u0d9a\u0dc1\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d85\u0dc1\u0db4\u0dca \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf \u0da7 \u0dda\u0dad\u0dca\u0dad\u0dbb \u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2 \u0da7 \u0db3\u0dc0\u0dba\u0dd2 \u0d9a\u0dd2 \u0db1\u0dca\u0dc1\u0db1\u0dca. \u0db4\u0dc1\u0dc4\u0dca\u0d9a\u0dd4 \u0d89\u0dbb\u0dd4\u0daf\u0dd2\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dc1\u0dbb \u0d91\u0dbd\u0dca\u0dbd \u0dc1\u0d9a\u0dbb\u0dd4\u0dc1\u0dab\u0dca, \u0dc1\u0db8\u0dca \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0d85\u0d9c\u0dc1\u0db0 \u0da7 \u0dbd\u0d82\u0d9a\u0dc1\u0dc0 \u0dc1 \u0db8\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0db4\u0dd2\u0dab\u0dd2\u0dc4 \u0daf?\n\n\u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dc1, \u0db8\u0dd3\u0da7 \u0dc1\u0db4\u0dbb\u0dad\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 20\u0d9a\u0dca \u0db4\u0dbb\u0dc1\u0dc0\u0da7 \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0dd6 \u0dc1\u0db3\u0daf\u0dd4\u0db8\u0dca\u0dc0\u0dc1\u0daf\u0dd3 \u0dad\u0dca\u200d\u0dbb\u0dc4\u0dca\u0dad\u0dc0\u0dc1\u0daf \u0da7 \u0d85\u0dc1\u0db4\u0dca \u0d85\u0dc4\u0dbd\u0dca\u0dc0\u0dd0\u0dd2\u0db1 \u0dc1 \u0dc0\u0dd6, \u0d85\u0dc1\u0db4\u0dca \u0dd2\u0dad\u0dad\u0dc0\u0dad\u0dc1 \u0dc0\u0dd2 \u0dba\u0dd4\u0dad\u0dd4\u0dc0 \u0dad\u0dd2\u0dd6\u0dc0 \u0d89\u0db1\u0dca\u0daf\u0dd2 \u0dc1\u0dc0 \u0db8\u0dd6\u0dbd\u0dba\u0db8 \u0d86\u0db0\u0dc1\u0dbb, \u0dc4\u0db8\u0dd4\u0daf\u0dc1 \u0db4\u0dd4\u0dab\u0dab\u0dd4\u0dc0 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0dc1\u0db1 \u0dc0, \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dd3\u0db8\u0dc1\u0dc0 \u0d86\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dab\u0dc1 \u0db1\u0dca \u0d9a\u0dc5 \u0db4\u0dbb\u0dd2\u0db4\u0dca\u0db4 \u0daf\u0dd0\u0db8\u0dd3\u0db8 \u0dc4\u0dc4 \u0d85\u0dc1\u0db4\u0dca \u0dc1\u0dda \u0db4\u0dc1\u0dbd\u0db1 \u0db1\u0dd2\u0daf\u0dc4\u0dc4\u0da7 \u0db8\u0dca \u0d86\u0d9a\u0dc1\u0dbb \u0d9a \u0db3\u0dc1\u0db0\u0dc1 \u0db4\u0db8\u0dd4\u0dab\u0dd4\u0dc0\u0db1 \u0d89\u0db1\u0dca\u0daf\u0dd4-\u0dbd\u0d82\u0d9a\u0dc1 \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8 \u0d85\u0db4 \u0db8\u0dad \u0db3\u0dbd\u0dc4\u0dad\u0dca\u0d9a\u0dc1\u0dbb\u0dc1 \u0db1\u0dca \u0db4\u0dd0\u0da7\u0dc0\u0dd6 \u0db3\u0dc0. \u0d91\u0dc1\u0dc4\u0db8 \u0db1\u0db8\u0dca \u0d92 \u0dc4\u0dc1 \u0dc4\u0db8\u0dc1\u0db1, \u0d91\u0dc1\u0dc4\u0db8\u0dad\u0dca \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0d91\u0daf\u0dc1 \u0dc4\u0db1\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dc1\u0dc1 \u0da0\u0dbb\u0db4\u0dbb\u0dd4\u0dc2 \u0dc1\u0db8\u0dc1\u0dc4\u0dba\u0dd4\u0db8\u0da7 \u0dc4\u0db8\u0dc1\u0db1 \u0dc1\u0db8\u0dc1\u0dc4\u0dba\u0dd4\u0db8\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0daf\u0dbd \u0d9a\u0dca \u0daf, \u0db4\u0dc1\u0dc4\u0dca\u0d9a\u0dd4 \u0d89\u0dbb\u0dd4\u0daf\u0dd2\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dc1\u0dbb ?"
  },
