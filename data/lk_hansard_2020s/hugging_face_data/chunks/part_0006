    "chunk_text": "\u0d91\u0db8\u0dca.\u0d92. \u0db4\u0dc0\u0dd4\u0dd2 \u0dca \u0dc1\u0db4\u0dc1\u0dbb\u0dca\u0dbb\u0ddc \u0db8\u0dbd\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0ddc\u0dc1\u0dda \u0dc4 \u0dc1 \u0ddd\u0db8\u0ddc \u0dc1\u0db4\u0dc1\u0dbb\u0dca\u0dbb\u0ddc \u0db8\u0dbd\u0dad\u0dd2\u0db1\u0dd2\u0dba\u0dc1\u0dda \u0db4\u0dd4\u0dad\u0dca\u200d\u0dbb \u0dbb\u0dad\u0dca\u0db1\u0dba\u0d9a\u0dca \u0dd6 \u0d9c\u0dbb\u0dd4 \u0d9c\u0ddc\u0db8\u0dd2\u0dab\u0dd3 \u0da2\u0dba\u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc1\u0db4\u0dc1\u0dbb\u0dca\u0dbb\u0ddc \u0db8\u0dbd\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0ddc 1941 \u0dc0 \u0dc1\u0dbb\u0dca \u0daf\u0dd3 \u0da2\u0db1\u0dca\u0db8 \u0dbd\u0ddc\u0db7\u0dba \u0dbd\u0dbd\u0db6\u0dd4\u0dc0\u0ddc. \u0dc1\u0d9a\u0ddc\u0dc5\u0db9 \u0db1\u0ddc\u0dbd\u0db1\u0dca\u0dcf\u0ddc \u0dc0\u0dd2\u0dcf\u0dba\u0ddc\u0dbd\u0dc1\u0dba\u0db1\u0dca \u0dc3\u0dd2\u0db4\u0dca \u0dad\u0dbb \u0dc4\u0dbd\u0dcf\u0dd1\u0dbb\u0dd4 \u0d91\u0dad\u0dd4\u0db8\u0ddc 1960 \u0dc0 \u0dc1\u0dbb\u0dca \u0d91\u0db8 \u0dc0\u0dd2\u0daf\u0dd4\u0dc4\u0dc1\u0dbd\u0dca \u0dc1\u0da2\u0dba\u0dc2\u0dca\u0da8 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0da7\u0dca \u0d9a\u0dca\u0da9\u0dbd\u0ddc\u0dba\u0dc1\u0db8\u0dca \u0db1\u0ddc\u0dba\u0d9a\u0dad\u0dca\u0dc0\u0dba \u0dcf \u0dc1\u0dc4\u0db6\u0dd6\u0dc0\u0ddc. 1968 \u0daf\u0dd3 \u0dc4\u0db8\u0db1\u0dca\u0d9c\u0dbd\u0dca\u0dbd \u0d9c\u0db8\u0dca \u0db7\u0ddc \u0ddc\u0db8\u0ddc\u0da2\u0dd2\u0d9a\u0dc1\u0dba\u0d9a\u0dca \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0ddc\u0d9a\u0ddc\u0dbb\u0dd3 \u0dc1\u0dda \u0db4\u0ddc\u0dbd\u0db1\u0dc1 \u0db1\u0dd2\u0dba\u0dd4\u0dad\u0dd4 \u0dd6 \u0d91\u0dad\u0dd4\u0db8\u0ddc 1977\u0daf\u0dd3 \u0db4\u0dbd\u0dc0\u0dad\u0dd2 \u0db8\u0dc4 \u0db8\u0dbd\u0dad\u0dd2\u0dc0\u0dbb\u0dab\u0dc1\u0dba\u0db1\u0dca \u0d91\u0d9a\u0dca \u0dad\u0dca \u0da2\u0ddc\u0dad\u0dd2\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dba\u0db1\u0dca \u0dad\u0dbb\u0d9c\u0dc1\u0d9a\u0ddc\u0da7 \u0db4\u0ddc\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0db4\u0dd2\u0dc0\u0dd2\u0dc3\u0dd2\u0dba\u0ddc. 1978 \u0dc3\u0dd2\u0da7 1988 \u0dcf\u0d9a\u0dca\u0dc0\u0ddc \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0daf\u0dd2 \u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0d85\u0db8\u0ddc\u0dad\u0dba\u0dc0\u0dbb\u0dba\u0ddc \u0dc1\u0dbd \u0dc4 \u0d9a\u0da7\u0dd4\u0d9c\u0db8\u0dca\u0db4\u0dbd \u0dbb \u0db1\u0dc1 \u200d\u0dbb\u0db0\u0ddc\u0db1 \u0dcf\u0dc0\u0dd2\u0db0\u0ddc\u0dba\u0d9a \u0dd4\u0dbb\u0dbb\u0dba \u0dcf, 1988 \u0dc3\u0dd2\u0da7 1993 \u0dcf\u0d9a\u0dca\u0dc0\u0ddc \u0dc0\u0dba\u0db9 \u0db4\u0dc5\u0ddc\u0dad\u0dca \u200d\u0dbb\u0db0\u0ddc\u0db1 \u0d85\u0db8\u0ddc\u0dad\u0dba\u0dc0\u0dbb\u0dba\u0ddc \u0dc1\u0dbd \u0dcf \u0d91\u0dad\u0dd4\u0db8\u0ddc \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc5\u0ddc. \u0d91\u0dad\u0dd4\u0db8\u0ddc \u0dad\u0db8\u0dba\u0dd2 \u200d\u0dbb\u0db0\u0ddc\u0db1 \u0d85\u0db8\u0ddc\u0dad\u0dba\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dca \u0dc4\u0dbd\u0da7\u0dd2\u0dba\u0da7 \u0db8\u0dd4\u0dd2\u0db1\u0dca\u0db8 \u0db4\u0dc5\u0ddc\u0dad\u0dca \u0db7\u0ddc\u0dc0\u0dbd\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dc0\u0dd2\u0dc2\u0dba\u0dba\u0db1\u0dca\u0da7 \u0d85\u0dcf\u0ddc\u0dc5\u0dc0 \u200d\u0dbb\u0da5\u0dcf\u0db4\u0dca\u0dad\u0dd2 \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0ddc \u0dc1\u0dcf\u0db1\u0dca\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc1\u0dc5\u0dca. \u0d91\u0dba \u0dd6\u0dbb\u0dca\u0dc0\u0ddc\u0dcf\u0dbb\u0dca \u0dba\u0da7 \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0dad\u0db8\u0dba\u0dd2 \u0d8a\u0da7 \u0db4\u0dd4\u0db8\u0dc0 -\u0db8\u0db8\u0dad\u0dca \u0db6 \u0dca\u0db1\u0ddc\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0ddc\u0dc1\u0dad\u0dca \u0db8\u0dc4 \u0d87\u0db8\u0dad\u0dd2 \u0dc1\u0dc0\u0dbd\u0ddc \u0d89\u0db1\u0dca\u0db1\u0dc1\u0d9a\u0ddc\u0da7- \u0dc1\u0dc0\u0db1\u0dad\u0dca \u0db4\u0dc5\u0ddc\u0dad\u0dca\u0dc0\u0dbd\u0dad\u0dca \u200d\u0dbb\u0da5\u0dcf\u0db4\u0dca\u0dad\u0dd2 \u0db8\u0dca\u0db8\u0dad \u0d9a\u0dbb\u0dbd\u0ddc, \u0d92 \u0db4\u0dc5\u0ddc\u0dad\u0dca \u0db7\u0ddc \u0dc0\u0dd2\u0dc2\u0dba\u0dba\u0db1\u0dca \u0db1\u0dd3\u0dad\u0dba\u0db1\u0dd4\u0dd6\u0dbd\u0dbd \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0dc1\u0d9c\u0db1 \u0d91\u0db1\u0dca\u0db1\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc1\u0dc5\u0dca. \u0d92\u0d9a \u0d91\u0dad\u0dd4\u0db8\u0ddc \u0dbd\u0db6\u0ddc \u0daf\u0dd4\u0db1\u0dca \u0dd6\u0dbb\u0dca\u0dc0\u0ddc\u0dcf\u0dbb\u0dca \u0dba\u0d9a\u0dca.\n\n\u0d91\u0dad\u0dd4\u0db8\u0ddc \u0d9a\u0dbb\u0db1 \u0dbd\u0dcf \u0d85\u0db8\u0dd2\u0dbd \u0db8\u0ddc\u0da2, \u0dcf \u0dca\u0d9a\u0dd8\u0dad\u0dd2\u0d9a \u0dc4\u0ddc \u0dbb\u0d9c\u0db8\u0dd2\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0db4\u0db8\u0dab\u0d9a\u0dca \u0db8\u0ddc \u0db4\u0dc4\u0dad\u0dd2\u0db1\u0dca \u0dcf\u0d9a\u0dca\u0dc0\u0db1\u0dc0\u0ddc. \u0d9c\u0dbb\u0dd4\u0dad\u0dbb \u0db7\u0dd2\u0d9a\u0dca\u0dd6\u0db1\u0dca \u0dc0\u0dc4\u0db1\u0dca\u0dc1 \u0dca\u0dbd\u0ddc \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dd4\u0db8\u0dbb\u0d9a\u0dca\u0dc2\u0ddc \u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba \u0dbb\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d91\u0dad\u0dd4\u0db8\u0ddc\u0dc1\u0dda \u0da2\u0ddc\u0dad\u0dd2\u0d9a \u0dc1\u0db8\u0dc1\u0dc4\u0dc0\u0dc1\u0dbb\u0dc4\u0dd2 \u0d85\u0d9c\u0db1\u0ddc \u0dc1 \u0dca\u0dc0\u0ddc\u0dc0\u0d9a\u0dca. \u0da2\u0db1\u0d9a\u0dbd\u0ddc \u0dc1\u0d9a\u0dca\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dba, \u0dab \u0db6\u0dbd\u0dcf\u0d9a\u0dd4\u0dc0, \u0dbb\u0dca\u0dc1\u0dc0\u0ddd\u0dcf\u0dba \u0dc0\u0dbd\u0db1\u0dd2 \u0dbb\u0dba\u0dad\u0db1 \u0dc4 \u0d9a\u0dd4\u0dbb\u0dd6\u0dab\u0dd1\u0d9c\u0dbd \u0dc1\u0dc0\u0dbd\u0dc1\u0d9c\u0dcf\u0dbb \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dbd\u0ddc\u0dcf\u0d9c\u0dab\u0dba \u0dbb\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d91\u0dad\u0dd4\u0db8\u0ddc \u200d\u0dbb\u0db6\u0dbd \u0dcf\u0ddc\u0dba\u0d9a\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0ddc \u0daf\u0dd3\u0db8 \u0d85\u0d9c\u0dba \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. 2016 \u0d85\u0dc1\u0dda\u0dbd\u0dca \u0db8\u0ddc \u0dc1 \u0daf\u0dd3 \u0d91\u0d9a\u0dca \u0dad\u0dca \u0da2\u0ddc\u0dad\u0dd3\u0db1\u0dca\u0dc1\u0dda \u0dbb\u0dc3\u0dd2\u0dba\u0ddc\u0db1\u0dd4 \u0dc4 \u0ddc\u0db1\u0dca\u0dad\u0dd2\u0d9a\u0dbb \u0d9a\u0dbd\u0ddc\u0db4\u0dba \u0db3\u0dc4\u0ddc \u0dc0\u0db1 \u0dbb\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0d9a \u0dc4 \u0db8\u0ddc\u0da2\u0dba\u0dd3\u0dba \u0dc1\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0db7\u0ddc\u0dc1\u0dda - ESCAP - \u0db7\u0ddc\u0db4\u0dad\u0dd2 \u0dc1\u0dbd \u0dc1\u0dad\u0dca\u0dbb\u0dd3 \u0db4\u0dad\u0dca \u0dc0\u0dd4\u0dab\u0dd4 \u0d91\u0dad\u0dd4\u0db8\u0ddc \u0d9a\u0dd8\u0dad\u0dc4 \u0dca\u0dad \u0dc1\u0dda \u0db4\u0ddc\u0dbd\u0db1\u0da5\u0dcf\u0dba\u0d9a\u0dd4 \u0dc1\u0dbd \u0dad\u0db8 \u0db4\u0ddc\u0d9a\u0dca\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0da7\u0dad\u0dca, \u0dc1\u0db4\u0ddc\u0daf\u0dd4 \u0da2\u0db1\u0dad\u0ddc\u0dc0\u0da7\u0dad\u0dca \u0dcf \u0d9a \u0db4\u0dc4\u0d9a\u0da7 \u0d85\u0db0\u0dd2\u0d9a \u0d9a\u0ddc\u0dbd\u0dba\u0d9a\u0dca \u0d85\u0db8\u0dd2\u0dbd \u0dc1 \u0dca\u0dc0\u0ddc\u0dc0\u0d9a\u0dca \u0d89\u0da7\u0dd4 \u0d9a\u0dc5\u0ddc."
  },
