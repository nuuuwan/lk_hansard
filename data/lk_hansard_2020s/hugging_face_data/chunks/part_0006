    "chunk_text": "\u0dc0\u0dd2\u0dc1\u0da2\u0dca\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2 , \u0d9c\u0dd4\u0dc0 \u0d9a\u0dd4\u0dc0\u0dda\u0dc1\u0daf\u0dc1\u0dc3 \u0dc1\u0d9a\u0dc1\u0da9\u0dd2\u0dad\u0dd4 \u0d9a\u0dca\u0d9a\u0dd4 \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0db8\u0dd4\u0daf\u0dd2\u0dad\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0db1\u0dca\u0dad\u0dd2 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2 , \u0d9c\u0dd4\u0dc0 \u0dbb\u0dc1\u0da2\u0dd2\u0d9a\u0dc1 \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2 , \u0da9\u0dd3. \u0dc0\u0dd3\u0dbb\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0db8\u0d82\u0da2\u0dd4\u0dbd\u0dc1 \u0daf\u0dd2\u0dc3\u0dc1\u0db1\u0dc1 \u0d9a \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2 , \u0d9c\u0dd4\u0dc0 (\u0d86\u0da0\u0dc1\u0dbb\u0dca\u0dae ) \u0dc4\u0dbb\u0dd2\u0dd2 \u0d85\u0db8\u0dbb\u0dc3\u0dd6\u0dbb\u0dd2 \u0dc1\u0db8\u0dc1\u0db1\u0dc0\u0dd2 , \u0d9c\u0dd4\u0dc0 \u0da2\u0d9c\u0dad\u0dca \u0dc3\u0db8\u0dbb\u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0da2\u0d9c\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd2 \u0d82\u0d9a\u0dbb \u0db8\u0dc4\u0dad\u0dc1 \u0db8\u0dcf\u0db0\u0dcf\u200d \u0dad\u0dcf\u0dbb\u0dd4\u0dab\u200d \u0dda\u0dbb\u0dd4\u0db8\u0dba \u0dc4\u0dcf \u0dd6\u0dad\u0dad\u0db1 \u0db4\u0dd4\u0dbb\u0dc0\u0dd0\u0dd2\u0d82\u0dba\u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d86\u0dcf\u0d82\u0dc1\u0dd2\u0d9a \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0dc0\u0dcf\u0dc0 \u0d9c\u0dd4\u0dc0 \u0dbd\u0dbd\u0dd2\u0dad\u0dca \u0dbb\u0dca\u0dae\u0dda \u0d9a\u0dd4\u0db8\u0dc1\u0dbb \u0db8\u0dc4\u0dad\u0dc1 (\u0dc3\u0db7\u0dc1\u0db4\u0dad\u0dd2), \u0d9c\u0dd4\u0dc0 \u0d9c \u0db1\u0dca\u0dad \u0d9a\u0dd4\u0dc0\u0dda\u0dc1\u0dad\u0dd2\u0dbd\u0d9a \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0da9\u0dbd\u0dbd\u0dc3\u0dda \u0d85\u0dbd\u0dc4\u0dca \u0dc1\u0db4\u0dd4\u0dc0\u0db8 \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0d91\u0dc3\u0dda.\u0d91\u0db8\u0dca.\u0d91\u0db8\u0dca.\n\n\u0d9c\u0dd4\u0dc0 \u0dc1\u0da2\u0dca.\u0dad\u0dcf. \u0d85\u0dbd \u0dad\u0dd4 \u0dbd \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0dc1\u0db8\u0dc1\u0dc4\u0db8\u0da9\u0dca \u0db8\u0dd4\u0dc3\u0db8\u0dca\u0db8\u0dd2\u0dbd\u0dca \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0dc1\u0dc0\u0dca\u0db6\u0dd4 \u0d9a\u0dd4\u0db8\u0dc1\u0dbb\u0dca\u0dae \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0dc3\u0d82\u0da2\u0dd3 \u0d91\u0daf\u0dd2\u0dbb\u0dd2\u0db8\u0dc1\u0db1\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0dda\u0daf \u0db1 \u0d9a\u0dd2\u0dbb\u0dd2\u0db3\u0dd2\u0dc1\u0d9c\u0dc1\u0da9\u0dbd \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0dc1\u0dbb\u0ddd\u0dc4\u0dda \u0db6\u0dab\u0dca\u0da9\u0da9\u0dbd\u0dc1\u0dbb \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0dd4 \u0dda\u0dad\u0dd2\u0dbd\u0d9a \u0dbb\u0dc1\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0da2 \u0db1\u0dca\u0dad \u0dc0\u0dd3\u0dbb\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0db8\u0dbb\u0dca\u0dae\u0da2\u0dc1\u0db1\u0dca \u0dc6\u0dd3\u0db1\u0dbd\u0dca \u0db8\u0dc4\u0dad\u0dc1\n\n\u0d85\u0db8\u0dcf\u0dad\u200d\u0dcf\u0dcf\u0d82\u0dc1 \u0d8b\u0dba \u0dda\u0db4\u0d9c\u0dda\u0dc1\u0d9a \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0dc0\u0dcf\n\n\u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0d9a \u0dd4\u0dad\u0dad\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0db8\u0dcf\u0dad\u200d\u0dcf\u0dcf\u0d82\u0dc1 \u0d8b\u0dba \u0dda\u0db4\u0d9c\u0dda\u0dc1\u0d9a \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0dc0\u0dcf\u0dc0 \u0d9c\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad \u0db6\u0dab\u0dca\u0da9\u0da9\u0dbd\u0dc1\u0dbb \u0dc1\u0dad\u0db1\u0dca\u0db1\u0dc1\u0d9a\u0ddd\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0da0\u0db8\u0dbd\u0dca \u0dbb\u0dc1\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0dc4\u0dad\u0dc1, \u0dc6\u0dd3\u0dbd\u0dca\u0da9\u0dca \u0db8\u0dc1\u0dbb\u0dca\u0dae\u0dc2\u0dbd\u0dca \u0d9c\u0dd4\u0dc0 \u0dc3\u0dbb\u0dad\u0dca \u0dc1\u0dc6\u0dc1\u0db1\u0dca\u0dc1\u0dc3\u0dda\u0d9a\u0dc1 \u0db8\u0dc4\u0dad\u0dc1,\n\n\u0d9c\u0dd4\u0dc0 (\u0d86\u0da0\u0dc1\u0dbb\u0dca\u0dae ) \u0dc3\u0dbb\u0dad\u0dca \u0dc0\u0dd3\u0dbb\u0dc1\u0dc3\u0dda\u0d9a\u0dbb \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0db8\u0dd4\u0da2\u0dd2\u0dd4\u0dbb\u0dca\u0dae \u0dbb\u0dc4\u0dd4\u0db8\u0dc1\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 (\u0d86\u0da0\u0dc1\u0dbb\u0dca\u0dae ) (\u0dc1\u0db8\u0dca\u0da2\u0dbb\u0dca\u0dae) \u0db4\u0dca\u200d\u0dbb\u0daf\u0dd3\u0dca \u0dda\u0dd4\u0db1\u0dc1\u0d9c\u0dc1\u0da9\u0dbd \u0db8\u0dc4\u0dad\u0dc1 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d86\u0dbb\u0dca \u0d9a \u0dc3\u0db1\u0dae\u0dcf \u0d8b\u0d9a\u0dbb\u0dab \u0dc3\u0dc4 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0d9a \u0dd4\u0dad\u0dad\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0db8\u0dcf\u0dad\u200d\u0dcf\u0dcf\u0d82\u0dc1 \u0d8b\u0dba \u0dda\u0db4\u0d9c\u0dda\u0dc1\u0d9a \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0dc0\u0dcf\u0dc0 \u0d9c\u0dd4\u0dc0 \u0dbb\u0d82\u0da2\u0dd2\u0dad\u0dca \u0dc3\u0dd2 \u0dd9\u0dbd\u0dc1\u0db4\u0dd2\u0da7\u0dd2 \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0dc1 \u0dc4\u0dc1\u0db1\u0dca \u0dc1\u0dc3\u0dda\u0db8\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0db8\u0dc4\u0dd2\u0db1\u0dca\u0daf\u0dc1\u0db1\u0db1\u0dca\u0daf \u0d85\u0dd4\u0dad\u0dca\u0d9c\u0db8\u0dc1\u0dda \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0d9a\u0db6\u0dd3\u0dbb\u0dca\u0dae \u0dc4\u0dc2\u0dd3\u0db8\u0dca \u0db8\u0dc4\u0dad\u0dc1,\n\n\u0d9c\u0dd4\u0dc0 (\u0d86\u0da0\u0dc1\u0dbb\u0dca\u0dae ) \u0dc4\u0dbb\u0dca\u0dae\u0dc2 \u0daf \u0dc3\u0dd2\u0dbd\u0dca \u0dc1 \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0d91\u0db8\u0dca.\u0da9\u0dbd\u0db6\u0dca\u0dbd\u0dd2\u0dc0\u0dca\u0db6.\u0da9\u0dd3. \u0dc3\u0dc4\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0daf\u0dd3\u0dca \u0dc0\u0dd2\u0dad\u0dc1\u0db1 \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 (\u0db8\u0dc4\u0dc1\u0da0\u0dc1\u0dbb\u0dca\u0dae ) \u0dbb\u0d82\u0da2\u0dd2\u0dad\u0dca \u0db6\u0dab\u0dca\u0da9\u0da9\u0dbd\u0dc1\u0dbb \u0db8\u0dc4\u0dad\u0dc1 \u0dad\u0dcf\u0d9a\u0dca\u0dc2\u0dab \u0d9a \u0dd4\u0dad\u0dad\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0db8\u0dcf\u0dad\u200d\u0dcf\u0dcf\u0d82\u0dc1 \u0d8b\u0dba \u0dda\u0db4\u0d9c\u0dda\u0dc1\u0d9a \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0dc0\u0dcf\u0dc0 \u0d9c\u0dd4\u0dc0 \u0d9a\u0db1\u0d9a \u0dc1\u0dc4\u0dda\u0dbb\u0dad\u0dca \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0d85\u0db1\u0dd4\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dd2 \u0daf\u0dbb\u0dca\u0dae \u0db1 \u0dc1\u0db4\u0dc1 \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0db8 \u0db1\u0dca\u0dad \u0daf\u0dd2\u0dc3\u0dc1\u0db1\u0dc1 \u0d9a \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0d89\u0db8\u0dca\u0dbb\u0dc1\u0db1\u0dca \u0db8\u0dc4\u0dbb\u0dd6\u0dc6\u0dda \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0\n\n\u0dc1\u0dda\u0db8\u0dca\u0db1\u0dc1\u0dad\u0dca \u0dad\u0dcf. \u0dc1\u0daf\u0dc1\u0dbd \u0dad\u0dca\u0dad \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0dc3\u0db8\u0db1\u0dca\u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dc4\u0dda\u0dbb\u0dad\u0dca \u0db8\u0dc4\u0dad\u0dc1 \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dcf \u0dcf\u0db8\u0dcf \u0d9a \u0dd4\u0dad\u0dad\u0dd4 \u0dc4\u0dcf \u0dc3\u0db8\u0dcf\u0da2 \u0dc3\u0dc0\u0dd2\u0db6\u0dbd\u0dd9\u0dd0\u0db1\u0dca\u0dd3\u0db8\u0dca \u0d9a \u0dd4\u0dad\u0dad\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0db8\u0dcf\u0dad\u200d\u0dcf\u0dcf\u0d82\u0dc1 \u0d8b\u0dba \u0dda\u0db4\u0d9c\u0dda\u0dc1\u0d9a \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0dc0\u0dcf\u0dc0 \u0d9c\u0dd4\u0dc0 \u0d9c\u0dd3\u0dad\u0dc1 \u0dc3\u0db8\u0db1\u0dca\u0db8\u0dd3\u0db1 \u0d9a\u0dd4\u0db8\u0dc1\u0dbb\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2 , \u0d9c\u0dd4\u0dc0 \u0d85\u0db1\u0dd4\u0db4 \u0db4\u0dc3\u0dda\u0d9a\u0dd4 \u0dbd\u0dca \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0dc1\u0dbb\u0ddd\u0dc4\u0dd2\u0dab\u0dd3 \u0d9a\u0dd4\u0db8\u0dc1\u0dbb\u0dd2 \u0dc0\u0dd2\u0dc1\u0da2\u0dca\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2 , \u0d9c\u0dd4\u0dc0 \u0da2\u0d9c\u0dad\u0dca \u0d9a\u0dd4\u0db8\u0dc1\u0dbb\n\n\u0dc3\u0dd4\u0db8\u0dd2\u0dad\u0dca\u200d\u0dbb\u0dc1\u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0dbb\u0dc1\u0da2\u0dd2\u0d9a\u0dc1 \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2 , \u0d9c\u0dd4\u0dc0 \u0db8\u0d82\u0da2\u0dd4\u0dbd\u0dc1 \u0daf\u0dd2\u0dc3\u0dc1\u0db1\u0dc1 \u0d9a \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2 , \u0d9c\u0dd4\u0dc0 \u0da2\u0d9c\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd2 \u0d82\u0d9a\u0dbb \u0db8\u0dc4\u0dad\u0dc1 \u0dc0\u0dbb\u0dcf\u0dba \u0db1\u0dcf\u0dc0\u0dd2\u0d9a \u0dc4\u0dcf \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0d9c\u0dc3\u0db1\u0dc0\u0dcf \u0d9a \u0dd4\u0dad\u0dad\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0db8\u0dcf\u0dad\u200d\u0dcf\u0dcf\u0d82\u0dc1 \u0d8b\u0dba \u0dda\u0db4\u0d9c\u0dda\u0dc1\u0d9a \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0dc0\u0dcf\u0dc0 \u0d9c\u0dd4\u0dc0 \u0dd2\u0db8\u0dbd\u0dca \u0dc3\u0dd2\u0dbb\u0dd2\u0db4\u0dc1\u0dbd \u0daf \u0dc3\u0dd2\u0dbd\u0dca \u0dc1 \u0db8\u0dc4\u0dad\u0dc1 (\u0dc3\u0db7\u0dc1\u0db4\u0dad\u0dd2), \u0d9c\u0dd4\u0dc0 \u0dc1\u0dda\u0db8\u0dbd\u0dc1\u0dbd\u0dca \u0da2 \u0dc1\u0dc3\u0dda\u0d9a\u0dbb \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0 \u0da0\u0dc1\u0db8\u0dbb \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0daf\u0dc3\u0db1\u0dc1 \u0d9a \u0db8\u0dc4\u0dad\u0dc1, \u0d9c\u0dd4\u0dc0"
  },
