    "chunk_text": "\u0d85\u0db4\u0dd2 \u0d89\u0dad\u0dcf\u0db8 \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dc0 \u0d9a\u0dd2\u0dd9\u0db1\u0dc0\u0dcf\u0d91 \u0dc1\u0db8\u0dca \u0dc0\u0dd2\u0db1\u0dca\u0daf\u0dd2\u0dad\u0dd9\u0db1\u0dca\u0da7 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dd9 \u0d89\u0da7\u0dd4 \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dd9\u0dbd\u0dcf. \u0dc1\u0db8\u0dca \u0dc0\u0dcf\u0dc1 \u0dc0\u0dd2\u0dc0\u0dcf\u0daf \u0dad\u0dc0\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0d85\u0dc0 \u0dba \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0db8\u0dcf\u0d9a\u0da7\u0daf \u0dc0\u0dd2\u0dc0\u0dcf\u0daf \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0dc1\u0db8\u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0dc1\u0db8\u0dcf\u0dd4\u0dad\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0db8\u0dca \u0db4\u0dcf\u0dc0 \u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc1\u0dca \u0d9a\u0dcf\u0dbd\u0dd9 \u0dad\u0dc0 \u0db8\u0dcf\u0dc3 3\u0dba\u0dd2. \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dd4\u0db8\u0db1\u0dd2\u0d91 \u0d94\u0d9a\u0dca\u0dc1\u0dad\u0ddd\u0db6\u0dc0 \u0db8\u0dcf\u0dc3\u0dc1\u0dda 16\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dcf \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0dcf\u0da7 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0dc0\u0dbb\u0dab\u0dd9 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0db4\u0dd2 \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dc0 \u0d9a\u0dd2\u0dd9\u0db1\u0dc0\u0dcf\u0d91 \u0dc3\u0db8\u0d9f\u0dd2 \u0da2\u0db1 \u0db6\u0dbd\u0dc1\u0dca \u0d9c \u0dbb\u0da2\u0dd9\u0d9a\u0dca \u0dd9\u0da7\u0dc1\u0dad\u0dca \u0dc1\u0db8\u0dca \u0dc0\u0dd0\u0dbb\u0daf\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0da7 \u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dc0 \u0dd9\u0dc1\u0dd9\u0db1\u0dca\u0db8 \u0dad\u0dbb\u0dcf\u0dd2\u0dbb\u0db8 \u0dc1\u0db1\u0dcf\u0db6\u0dbd\u0dcf \u0daf\u0dac\u0dd4\u0dc0\u0db8\u0dca \u0dc1\u0daf\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dd9\u0db1 \u0db8\u0d9a. \u0dc3\u0db8\u0dc4\u0dbb \u0d85\u0dd9 \u0daf\u0dd0\u0db1\u0dca \u0dc1\u0db8\u0dca\u0d9a \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dd9\u0dcf\u0dc0 \u0db4\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dd9\u0dc0\u0db1\u0dc0\u0dcf. \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dd9\u0dcf\u0dc0 \u0db4\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dd9\u0dc0\u0dbd\u0dcf \u0dc1\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0daf \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0dc1\u0db8\u0dca \u0dc1\u0db6\u0dcf\u0dbb\u0dd4\u0dc0\u0d9a\u0dca \u0dc1\u0db1\u0dca. \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dd9\u0dcf\u0dc1\u0dc0\u0db1\u0dca \u0db1\u0db8\u0dca \u0dc1\u0dad\u0dcf\u0dbb\u0dd4\u0dbb\u0dd4 \u0dbd\u0db6\u0dcf \u0dd4\u0db1\u0dca\u0dc1\u0db1\u0dca\u0d91 \u0d85\u0dc1\u0dda\u0dbd\u0dca 2 \u0db8\u0dcf\u0dc3\u0dc1\u0dda 4\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dcf \u0d89 \u0dbd\u0dcf \u0dbb\u0dcf\u0da2\u0dba \u0db6\u0dd4\u0dda\u0db0\u0dd2 \u0d85\u0d82 \u0dd9\u0da7 \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dc1\u0dad\u0dcf\u0dbb\u0dd4\u0dbb\u0dd4 \u0dbd\u0db6\u0dcf\u0daf\u0dd3\u0dbd\u0dcf \u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca\u0d91 \u0d92\u0dc0\u0dcf \u0db8\u0d9f \u0dc4\u0dd0\u0dbb\u0dd2\u0dc1\u0dda \u0d9a\u0dc0\u0dd4\u0daf? \u0d87\u0dba\u0dd2\u0d91 \u0d92\u0dc0\u0dcf \u0db8\u0d9f \u0dc4\u0dd0\u0dbb\u0dd2\u0dc1\u0dda? \u0db8\u0dad\u0dc1\u0d9a\u0dcf\u0da7 \u0dc1\u0db8\u0dca \u0d85\u0db1\u0dca\u0dad\u0dc0\u0dcf\u0daf\u0dd3\u0db1\u0dca\u0dc0 \u0dc1\u0db4\u0ddd\u0dc2\u0dab\u0dd9 \u0d9a\u0dbb\u0dd4\u0dbb\u0d91 \u0d92 \u0d85\u0dd9 \u0db8\u0d9a\u0dca\u0d9a \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0d9a\u0db8\u0dca \u0dd2\u0db6\u0dd2\u0da0\u0dca\u0da0 \u0dc4\u0db8\u0dd4\u0daf\u0dcf \u0db6\u0dd4\u0dda\u0db0\u0dd2 \u0d85\u0d82 \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a\u0dc1\u0dd9\u0ddd \u0d9a\u0dc0\u0dd4\u0daf? \u0d92 \u0dc1\u0d9c\u0dcf\u0dbd\u0dca 2\u0dbd\u0db1\u0dca\u0da7 \u0db4\u0da9\u0dd2 \u0dc1\u0d9c\u0dca \u0dc1\u0dca \u0d9a\u0dc0\u0dd4\u0daf? \u0dc1\u0db8\u0db1\u0dca\u0db1 \u0dc1\u0db8\u0dca\u0dc0\u0dcf\u0dba\u0dd2 \u0dc1\u0dc4\u0dcf\u0dd9\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dc1\u0db8\u0dca \u0d85\u0dd9 \u0db1\u0da9\u0dad\u0dca\u0dd4 \u0d9a\u0dc1\u0dc5\u0dad \u0d9a\u0dc0\u0dd4\u0daf \u0d9a\u0dd2\u0dd9\u0db1 \u0db8\u0d9a\u0dad\u0dca \u0dc1\u0dc4\u0dcf\u0dd9\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dc0 \u0d9a\u0dd2\u0dd9\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1\u0d91 \u0daf\u0dac\u0dd4\u0dc0\u0db8\u0dca \u0dbd\u0dd0\u0db6\u0dd2\u0dd9 \u0dba\u0dd4\u0dd4 \u0d85\u0dd9\u0da7 \u0d87\u0d9f \u0dc1\u0dda\u0dbb\u0dcf \u0dc1\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0db1\u0dad\u0dca\u0d91 \u0dc1\u0db8\u0dca\u0dc0\u0dcf\u0da7 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0dc1\u0dc0\u0da0\u0dca\u0da0 \u0d85\u0dd9\u0da7 \u0db1\u0dd2\u0daf\u0dc4\u0dc1\u0dc3\u0dad \u0d89\u0db1\u0dca\u0db1 \u0dc1\u0daf\u0db1\u0dca\u0db1\u0dad\u0dca \u0db6\u0dd0\u0dc4\u0dd0. \u0d92 \u0dc0\u0dcf\u0dc1 \u0db8\u0d91 \u0da2\u0dcf\u0dd2\u0dc0\u0dcf\u0daf\u0dd9 \u0d87\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0dc1\u0dc0\u0da0\u0dca\u0da0 \u0d85\u0dd9\u0dad\u0dca \u0d91\u0d85\u0dc1\u0db1\u0dca\u0d91 \u0db8\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dc4\u0dd0; \u0dc1\u0db8\u0dd9\u0dcf \u0db8\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dc4\u0dd0; \u0db8\u0dd9\u0dcf \u0dc4\u0dbb\u0dd2 \u0dc1\u0dc4\u0dcf \u0dba\u0dd2\u0d91 \u0d9a\u0dd2\u0dd9\u0db1\u0dc0\u0dcf. \u0dc1\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0daf\u0d91 \u0dc1\u0dc4\u0dad\u0dd4\u0dc0? \u0dbd\u0dc3\u0db1\u0dca\u0dad \u0db8\u0dbb\u0dd4\u0dbb \u0daf\u0dcf \u0d89 \u0dbd\u0dcf\u0db8\u0d91 \u0dc3\u0dd4\u0dd4 \u0dc0\u0dd1\u0db1\u0dca \u0d9a\u0dcf\u0dcf\u0dc1\u0dca\n\n\u0db8\u0dc1 \u0d9a\u0dcf\u0dcf\u0dc0 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0db1\u0dca \u0db8\u0da7 \u0dad\u0dc0 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0dc1\u0daf\u0d9a\u0d9a\u0dca \u0d9a\u0dd2\u0dd9\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0db4\u0dc3\u0dd4\u0dd2\u0dab\u0dd9 \u0daf\u0dc0\u0dc3\u0d9a \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0da7\u0da7 \u0d89\u0dbb\u0dcf\u0db1 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0dd4\u0db8\u0dcf \u0d87\u0dc0\u0dd2\u0dbd\u0dca 2\u0dbd\u0dcf \u0dd2\u0dab\u0dd9\u0dcf. \u0dbb\u0da2\u0dc1\u0dd9\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca 2 \u0dbd\u0db6\u0db1\u0d91 \u0dbb\u0da2\u0dc1\u0dda \u0d85\u0db1\u0dd4\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dd9 \u0dd2\u0dc1\u0db6\u0db1 \u0dc1\u0daf\u0db8\u0dc5 websites\u0dc0\u0dbd \u0daf\u0dd0\u0db1\u0dca \u0daf\u0dcf\u0db1\u0dc0\u0dcf\u0d91 \u0d91\u0dc3\u0da2\u0dd2\u0dad\u0dca \u0dc1\u0dda\u0db8\u0daf\u0dcf\u0dc3 \u0db8\u0dd0\u0dd2\u0dd4\u0db8\u0dcf \u0d89\u0dbb\u0dcf\u0db1 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0dd4\u0db8\u0dcf \u0dc4\u0db8\u0dca\u0db6 \u0dc0\u0dd4\u0dc1\u0da9\u0dd4\u0d9a \u0db1\u0dd0\u0dc4\u0dd0\u0d91 \u0d87\u0dc1\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0da7 \u0d9c\u0dc1\u0dda\u0d91 \u0d9a\u0dd2\u0dd9\u0dbd\u0dcf. \u0d85\u0db4\u0da7 \u0dca\u0dbb\u0dcf\u0db0\u0db1\u0dcf \u0d9a\u0dc5\u0dcf\u0daf? \u0d89\u0dbb\u0dcf\u0db1 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0dd4\u0db8\u0dcf \u0db8\u0d9a\u0dca\u0d9a \u0dbb\u0dcf\u0dd3 \u0dc1\u0d9c\u0ddd\u0da2\u0db1 \u0dc3\u0d82\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dd9\u0d9a\u0dca \u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf; \u0d92\u0d9a\u0da7 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2 \u0db8\u0db1\u0dca\u0daf\u0dd2\u0dbb\u0dd9\u0da7 \u0db8\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dd9\u0dbd\u0dcf \u0db8\u0daf\u0dcf \u0dbb\u0dc1\u0dda call \u0d9a\u0dc5\u0dcf. \u0d92 \u0dc1\u0db8\u0dcf\u0d9a\u0da7\u0daf? \u0d85\u0db4\u0dd2\u0dc0 \u0db8\u0dad\u0dd0\u0db1\u0da7 \u0dc1\u0d9c\u0db1\u0dca\u0dc0\u0dbd\u0dcf \u0dc1\u0dc6\u0dcf\u0dc1\u0da7\u0ddd \u0d9c\u0dc4\u0dbd\u0dcf\u0d91 \u0d85\u0db1\u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0dbb\u0db1\u0dd2\u0dbd\u0dca 2 \u0db8\u0d9a\u0dca\u0d9a \u0db8\u0d9a\u0dd4 \u0dc0\u0dd4\u0dab\u0dcf \u0d9a\u0dd2\u0dd9\u0dbd\u0dcf \u0dc1\u0db4\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db1."
