    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d94 \u0dad\u0dd4\u0db8\u0dcf \u0d9a \u0dc1\u0dc4\u0ddc\u0db3\u0da7\u0db8 \u0dd9\u0db1\u0dca\u0db1\u0dc0\u0dcf, \u0db4\u0dcf\u0dc3\u0dcf \u0d89\u0dbb\u0dd2\u0dd9\u0dcf \u200d\u0dbb\u0dc4\u0dcf\u0dba\u0dba, \u0dc1\u0d9a\u0ddc\u0daf\u0dd4 \u0dc3 \u0dc0\u0dc3\u0dcf\u0d9c\u0dad\u0dba \u0dc3\u0dc4 \u0d89\u0db1\u0dca \u0db4\u0dc3\u0dd4 \u0d87\u0dad\u0dd2 \u0dc0\u0dd6 \u0dc1\u0db4\u0dad \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0dd9\u0dba \u0d9a \u0db1\u0dd2\u0dc3\u0dcf \u0dd9\u0dd0\u0dc0\u0dd0\u0db1\u0dca\u0dad \u0dc1\u0d9a\u0dc3\u0db8 \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0dd9\u0dba\u0da7 \u0d9a\u0d9a\u0dca \u0dc0\u0dd4\u0dc1\u0da9\u0dd4 \u0d85\u0db0\u0dca\u200d\u200d\u0dcf\u0db4\u0db1 \u0d9a\u0dca\u0dc1\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb\u0dba \u0dc0. \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1 \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0d92\u0dc1\u0d9a\u0dca \u0d9a\u0db4\u0dd1\u0db8 \u0dc1\u0db4\u0dad \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0dd9\u0dba\u0da7 \u0dc0\u0da9\u0dcf \u0dc0\u0dd0\u0da9\u0dd2\u0dba\u0dd2. \u0dd9\u0dd0\u0db1\u0dca\u0db8 \u0dc1\u0db1\u0ddc\u0dc1\u0db4\u0db1\u0dd4\u0da7\u0dcf\u0da7, \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dc1 \u0daf\u0dd3 \u0d92\u0d9a \u0dba\u0db4\u0dad\u0dc5 \u200d\u0dbb \u0dcf\u0db1\u0dba\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0dc1\u0db4\u0dad \u0dad \u0d9a \u0d9a\u0dc0\u0dba \u0dad\u0dd4\u0dc5 \u0dc1\u0db4\u0dad \u0dc1\u0dc0 \u0daf\u0dd3 \u0daf\u0dd4\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0d9a\u0dcf\u0d9a\u0dcf\u0dc1 \u0daf\u0dd4 \u0dcf\u0dc0\u0daf\u0dd4\u0dd9\u200d\u0dcf\u0d9a \u0d85\u0db0\u0dca\u200d\u200d\u0dcf\u0db4\u0db1\u0dba \u0dc1\u0d9a\u0dc1\u0dba\u0dc4\u0dd2 \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0dad\u0dd4\u0dc5 \u0d9a\u0dd2\u0dd2\u0db1\u0dbd\u0dd2 \u0daf\u0dd4 \u0dcf\u0dc0\u0dcf\u0dc3\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0dc1 \u0dc1\u0d9c\u0db1 \u0dca\u0db1\u0dc0\u0dcf. \u0db8\u0db8 \u0d85\u0dba \u0daf\u0dd4\u0dc1 \u0d9c\u0dad \u0dc1\u0dc0\u0da0\u0dca\u0da0 \u0dd2\u0dba\u0dc2\u0dca\u0da8\u200d \u0dc3\u0dcf\u0d9b\u200d\u0dcf\u0dc0 \u0dc1\u0d9a\u0ddc\u0db4\u0db8\u0da7\u0dd9 \u0d9a\u0dd2\u0dba\u0db1 \u200d\u0dbb \u0dcf\u0db1\u0dba \u0d87\u0dc4\u0dd4\u0dc1 \u0d9a, \u0dc1\u0db4\u0dad \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0ddc\u0da7 Immigration and Emigration Department \u0dca\u0d9a\u0da7 \u0d9c\u0dd2\u0dba \u0d9a, fingerprints \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dad\u0dd0\u0db1\u0d9a\u0da7 \u0d9c\u0dd2\u0dba \u0d9a, \u0dc0\u0dd3\u0dc3\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0d9c\u0dd2\u0dba \u0d9a \u0d85\u0db0\u0dca\u200d\u200d\u0dcf\u0db4\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0daf\u0dd4 \u0dcf\u0d9a \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0daf\u0dd4\u0dc1 \u0d9c\u0dad \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0d89\u0db1\u0dca\u0db1 \u0dc0 \u0dc1\u0db4\u0dc1\u0db1\u0db1 \u0db1\u0dd2\u0dc3\u0dcf\u0dba\u0dd2. \u0dc1\u0db4\u0dad\u0d9a\u0da7 \u200d\u0dbb\u0db0\u0dca\u200d\u0dcf\u0db1 \u0dc1\u0dc4\u0dda\u0dad\u0dd4\u0dc0, \u0dc1\u0db1\u0ddc\u0db8\u0dd2\u0dc1\u0dbd\u0dca \u0d89\u0dc1\u0d9c\u0db1 \u0d9c\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0dc1 \u0db1 \u0d85\u0dc1\u0db4\u0dcf \u0daf\u0dd4 \u0dcf\u0dc0\u0daf\u0dd4\u0dd9\u200d\u0dcf\u0d9a \u0db4 \u0db0\u0dca\u200d\u0dad\u0dd2\u0dba \u0db4\u0dd2\u0dc5\u0dd2 \u0db3 \u0daf\u0dd4 \u0dcf\u0dc0\u0dcf\u0dc3\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0dc0\u0dd3\u0db8\u0dba\u0dd2. \u0daf\u0dd4 \u0dcf\u0dc0\u0daf\u0dd4\u0dd9\u200d\u0dcf\u0d9a\u0dba\u0d9a\u0da7 \u0dc1 \u0d9a\u0dbb\u0dd2\u0d9a\u0dcf \u0d89\u0db1\u0dca\u0db1 \u0dc5\u0db8\u0dba\u0dd2 \u0d9a \u0dd9\u0dd0\u0db1\u0dca \u0daf\u0dd4\u0dc1 \u0d9c\u0dad \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0d85\u0dc1\u0db4\u0dcf \u0daf\u0dd4 \u0dcf\u0dc0\u0daf\u0dd4\u0dd9\u200d\u0dcf\u0d9a \u0db4 \u0db0\u0dca\u200d\u0dad\u0dd2\u0dba \u0db4\u0dd2\u0dc5\u0dd2 \u0db3\u0dc0 \u0daf\u0dd4 \u0dcf\u0dc0\u0dcf\u0dc3\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0dc1\u0dc4\u0dda\u0dad\u0dd4 \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0d9a\u0db4\u0dcf\u0db1\u0dc0\u0dcf. \u0d9a\u0dcf\u0d9a\u0dba\u0d9a\u0da7 \u0dd2\u0dba\u0dc2\u0dca\u0da8\u200d \u0d85\u0dba\u0d9c\u0dc5 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db0\u0dca\u200d\u200d\u0dcf\u0db4\u0db1\u0dba \u0db6\u0dd2\u0db3 \u0dc0\u0dd0\u0dc1\u0da7\u0db1\u0dc0\u0dcf, \u0dad\u0dc0 \u0d9a \u0d9a\u0dcf\u0d9a\u0dba\u0d9a\u0da7 \u0d85\u0db1\u0db0\u0dca\u200d\u200d\u0dba\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0dba \u0db8\u0da9\u0dd4\u0da9\u0d9a\u0dc1 \u0dc0\u0dbb\u0dca\u0da2\u0db1 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db0\u0dca\u200d\u200d\u0dcf\u0db4\u0db1\u0dba \u0db6\u0dd2\u0db3 \u0dc0\u0dd0\u0dc1\u0da7\u0db1\u0dc0\u0dcf, \u0dad\u0dc0 \u0d9a \u0d9a\u0dcf\u0d9a\u0dba\u0d9a\u0da7 \u0d85\u0db0\u0dca\u200d\u200d\u0dba\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0dba \u0db8\u0da9\u0dd4\u0da9\u0d9a\u0dc1 \u0dc0\u0dbb\u0dca\u0da2\u0db1 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db0\u0dca\u200d\u200d\u0dcf\u0db4\u0db1\u0dba \u0db6\u0dd2\u0db3 \u0dc0\u0dd0\u0dc1\u0da7\u0db1\u0dc0\u0dcf. \u0dca\u0dc1\u0dc4\u0db8 \u0dc0\u0dd4\u0da7\u0dcf\u0db8 \u0db1\u0dd2\u0dd2\u0db1\u0dba\u0dcf\u0d9a\u0dcf\u0dba\u0dc0 \u0dda\u0db4\u0dcf\u0db0\u0dd2\u0dba \u0dc3\u0db4\u0dad\u0dd6.\u0dbb\u0dca\u0da7 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db4\u0dad \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0d9a\u0dd0\u0dc1 \u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0.\n\n1185 1186\n\n\u0db4\u0dcf\u0dbb\u0dca\u0db6\u0dbd\u0dc1\u0db4\u0dad\u0db1\u0dca\u0dad\u0dd4\u0dc0"
  },
