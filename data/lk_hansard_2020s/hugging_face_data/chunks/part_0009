f\u0daf\u0dca\u200d\u0dbb \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dbb \u0db8\u0dc4\u0dc3\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bb0\u0bb5\u0bc0\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0 \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0) (The Hon. Ravindra Bandara) \u0d9c\u0dd4\u0dc0 \u0d9a\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db8\u0dc1\u0d9a \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0dca\u200d\u0db1 \u0d85\u0dad\u0dd4\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb \u0dae\u0db1\u0dba \u0dc1\u0db8\u0dba\u0dba\u0dd2. \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0da2\u0dba\u0db1\u0dca \u0dd2\u0db0\u0dc3\u0dd2\u0db1\u0dca EoIs \u0dd2\u0db0\u0db0\u0dd2\u0dba\u0da7 \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca Expressions of Interest \u0dd2\u0db0\u0db0\u0dd2\u0dba\u0da7 solar energy projects \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0dad\u0dd2\u0dbd\u0dc1\u0db6\u0db1\u0dc0\u0dca\u200d\u0dcf. Solar energy projects\u0dc0\u0dca\u200d\u0dbd tariff \u0d91\u0d9a unit \u0d91\u0d9a\u0d9a\u0da7 \u0dc1\u0d9c\u0dc0\u0dca\u200d\u0db1 \u0db8\u0dd4\u0dcf\u0dbd \u0dd2\u0db0\u0dd2\u0db0\u0db0 \u0d85\u0d9c\u0dba\u0db1\u0dca \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0db6\u0dc0\u0dca\u200d \u0dc0\u0dca\u200d\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0dcf. \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0db4\u0dd0\u0dc4\u0dca\u200d\u0dd0\u0daf\u0dd2\u0dbd\u0dd2\u0dc0\u0dca\u200d \u0dc1\u0db4\u0dc1\u0db1\u0db1 \u0d9a\u0dcf \u0dc3\u0dba\u0d9a\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0dc3\u0db3\u0dc4\u0dca\u200d\u0dcf \u0dba\u0db8\u0dca \u0dc1 \u0db4\u0dcf\u0dbd\u0db1 \u0dc4\u0dd2\u0dad\u0dc0\u0dca\u200d\u0dad\u0dca\u0d9a\u0db8\u0dca \u0dc1\u0dc4\u0dca\u200d\u0ddd \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dba\u0db8\u0dca \u0db6\u0dbd\u0db4\u0dd1\u0db8\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd4\u0dc3\u0dcf\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a.\n\n\u0d9c\u0dd4\u0dc0 \u0d87\u0db8\u0dad\u0dd2\u0dbd\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dc1\u0db8\u0dca \u0dc3\u0