    "chunk_text": "\u0db1\u0dd0\u0dc4\u0dca\u200d\u0dd0 \u0d91\u0dad\u0dd0\u0db1\u0dd2\u0db1\u0dca \u0d91\u0dc4\u0dca\u200d\u0dcf \u0d9c\u0dd2\u0dba \u0db4\u0dd4\u0dc5\u0dd4\u0db1 \u0d85\u0dbb\u0dca\u0dcf\u0dba\u0d9a\u0dca Clean Sri Lanka \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0dca\u200d\u0db1\u0da7 \u0dad\u0dd2\u0dbd\u0dc1\u0db6\u0db1\u0dc0\u0dca\u200d\u0dcf. \u0d92\u0d9a \u0dc1\u0dad\u0dca\u0dd4\u0dc0\u0db8\u0dca \u0d9c\u0db1\u0dca\u0db1. \u0db6\u0dc3\u0dae \u0dcf\u0dc0\u0dca\u200d\u0dbd \u0d9a\u0dd1\u0dbd\u0dd2 \u0d9c\u0dbd\u0dc0\u0dca\u200d\u0db1 \u0d91\u0d9a \u0dc1\u0db4\u0ddc\u0dbd\u0dd3\u0dc3\u0dd2\u0dc1\u0dda \u0dc0\u0dca\u200d\u0dd0\u0da9\u0d9a\u0dca. \u0d92\u0d9a\u0dad\u0dca \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0dad\u0db8\u0dba\u0dd2. \u0d92\u0dc0\u0dca\u200d\u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dca\u200d\u0dc5\u0da7 \u0dc3\u0d9a\u0dc3\u0dae \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0dad\u0db8\u0dba\u0dd2. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d92\u0d9a \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dca\u200d\u0dba\u0dd2 Clean Sri Lanka \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca."
