    "chunk_text": "\u0d91\u0dad\u0db8\u0d9a\u0dcf\u0da7 \u0d92 \u0dc3\u0dc4\u0dbd\u0dca\u0dc0\u0dbd\u0da7 \u0dc3\u0dcf\u0db8\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dc0 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 20\u0d9a\u0dca, 25\u0d9a\u0dca \u0d89\u0dc4\u0dc5\u0dd2\u0db1\u0dca\u0dad \u0db8\u0daf\u0dca\u0dd3\u0dbd \u0dc3\u0dc4\u0dbd\u0dca \u0db8\u0dd2\u0dbd \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dda\u0db8\u0d9a \u0db8\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0d89\u0da9 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u0dd2, \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dd4\u0daf \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc3\u0db1\u0dca\u0dad\u0daf\u0dbb\u0dca\u0dbd \u0db1 \u0db4\u0dc0\u0dda\u0dc0\u0db1\u0dc0\u0dcf \u0d85\u0db4\u0dd2 \u0daf\u0dd0\u0d9a\u0dca\u0d9a\u0dcf. \u0dc4\u0dcf\u0dbd\u0dca \u0db8\u0db8\u0ddd\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2 \u0db1\u0dca\u0dad\u0da7 \u0d91\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2 \u0dbd\u0dcf, \u0db8\u0dda\u0db8\u0dc3\u0da7 \u0d9c\u0dc4\u0dbd\u0dcf \u0d9a\u0dae\u0dcf \u0d9a \u0dcf; \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0db8\u0db4\u0ddd\u0dd2\u0dda \u0d9a\u0dbb\u0dbd\u0dcf \u0d94\u0db6\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dcf\u0db8\u0dda \u0dc4\u0dcf\u0dbd\u0dca \u0db8\u0db8\u0ddd\u0dbd\u0dca \u0dc0\u0da7\u0dbd\u0db1\u0dca\u0dad\u0db1 \u0d91\u0dc0\u0db1\u0dc0\u0dcf, \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d89\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0d85\u0db4\u0dd2\u0dda \u0d91\u0d9a\u0dca\u0d9a \u0d9a\u0dd2 \u0dbd\u0dcf \u0dc3\u0daf\u0dca\u0db8\u0daf \u0daf\u0dd0\u0dda\u0db8\u0dcf. \u0d8a\u0da7 \u0db4\u0dc3\u0dca\u0db8\u0dc3\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0db8\u0dd2\u0dbd \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 10\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb\u0dbd\u0dcf\u0dda \u0daf\u0dd3\u0dbd\u0dcf, \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0db8\u0dda \u0d86\u0db1 \u0db1 \u0d9a\u0dbb\u0db1 \u0dc3\u0dc4\u0dbd\u0dd4\u0dda \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 65\u0d9a \u0db6\u0daf\u0dca\u0daf\u0da7 \u0da7\u0dda\n\n153 154\n\n\u0d9a\u0dbb\u0dbd\u0dcf \u0db8\u0daf\u0dca\u0dd3\u0dbd \u0dc3\u0dc4\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0da7\u0db8 \u0dc3\u0db8\u0dcf\u0db1 \u0d9a\u0dbb\u0dbd\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0dad\u0db1\u0dcf. \u0dc3\u0dc4\u0dbd\u0dca\u0dc0\u0dbd \u0db4\u0dcf\u0dbd\u0db1 \u0db8\u0dd2\u0dbd \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 220\u0d9a\u0dca \u0d9a \u0dcf\u0db8 \u0db8\u0dbb\u0daf\u0d9c\u0dc4\u0dd4\u0daf\u0dbd \u0dc3\u0dc4\u0dbd\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dba\u0dbb\u0d9a\u0db8 \u0ddd, \u0db8\u0d9a\u0dcf\u0da7\u0dd4\u0db8\u0dda \u0dc3\u0dc4\u0dbd\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dba\u0dbb\u0d9a\u0db8 \u0ddd \u0d85\u0daf \u0d86\u0db1 \u0db1 \u0d9a\u0dbb\u0db1 \u0dc3\u0dc4\u0dbd\u0dca\u0dc0\u0dda \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db1\u0dd0\u0dad\u0dd2 \u0dad\u0dda\u0dda\u0dc0 \u0da7 \u0db4\u0dda\u0db8\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0db8\u0dcf\u0d9a\u0daf, \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0da7 \u0dbd\u0dd0\u0db8\u0db6\u0db1 \u0db8\u0dd2\u0dbd\u0dda \u0d91\u0d9a\u0dca\u0d9a \u0db4\u0dcf\u0dbd\u0db1 \u0db8\u0dd2\u0dbd\u0da7 \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0db1\u0dca\u0dad\u0db1 \u0db6\u0dd0\u0dc4\u0dd0. \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0daf \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0dc3\u0dc4\u0dbd\u0dca \u0db8\u0dc0 \u0db8 \u0db3\u0dcf\u0db8\u0db8\u0db1\u0dca\u0dad \u0d89\u0dc0\u0dda\u0db8\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0dc0\u0db8 \u0db3 \u0d87\u0db8\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0dc3\u0dc4\u0dbd\u0dca\u0dc0\u0dbd \u0db4\u0dcf\u0dbd\u0db1 \u0db8\u0dd2\u0dbd \u0d92 \u0dad\u0dda\u0dda\u0dc0 \u0da7 \u0db8\u0d9c\u0db1\u0dd0\u0dbd\u0dca\u0dbd\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0dad\u0db1\u0dcf\u0da7 \u0db4\u0dc3\u0dca\u0db8\u0dc3\u0dca \u0db8\u0dda \u0dbb\u0db8\u0da7\u0dca \u0d85\u0dc4\u0dd2\u0d82\u0dc3\u0d9a \u0db8\u0dc0\u0db8 \u0db1\u0dca\u0dad\u0db8\u0daf\u0ddd \u0dba\u0da7\u0d9a \u0dad\u0db8\u0dd2 \u0daf\u0da9 \u0d9a\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad. \u0dad\u0db8\u0db1\u0dca\u0dad \u0dc3\u0dc4\u0dbd\u0dca \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0db1 \u0db1\u0dd2\u0dc3\u0dcf \u0dad\u0db8\u0db1\u0dca\u0dad \u0d9f\u0da7 \u0d91\u0db1 \u0dc3\u0dc4\u0dbd\u0dca\u0dc0\u0dbd\u0da7 \u0dbd\u0dcf\u0db7 \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0d9a\u0dca \u0d91\u0d9a\u0dd4 \u0d9a\u0dbb\u0dbd\u0dcf \u0d85\u0db8 \u0dc0\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1\u0da7 \u0dba \u0dcf\u0db8 \u0db4\u0dcf\u0dba\u0dbb\u0db8\u0db7\u0ddd\u0dba\u0d9a \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dba\u0dbb\u0db8 \u0db1\u0dca\u0dad \u0db4\u0dd0\u0db1\u0dbd\u0dcf \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0da7 \u0daf\u0dac\u0dd4\u0dc0\u0dda \u0db8\u0daf\u0db1\u0dc0\u0dcf. \u0d92 \u0daf\u0dac\u0dd4\u0dc0\u0db8 \u0dc0\u0dd2\u0db3\u0dd2\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0d9a, \u0db8\u0daf\u0d9a\u0d9a \u0dbd\u0dcf\u0db7 \u0d9a\u0dca \u0d9c\u0db1\u0dca\u0dad\u0db1 \u0dba \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dba\u0dbb\u0d9a\u0db8 \u0ddd. \u0dc4\u0dd0\u0db6\u0dd0\u0dd2, \u0dc0\u0dd2 \u0dcf\u0dbd \u0dbd\u0dcf\u0db7 \u0db4\u0dbb\u0dcf\u0dc3 \u0d9a\u0dca \u0dbd\u0db6\u0db1 \u0d85 \u0da7 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0d85\u0dc3\u0dca\u0dc0\u0dd0\u0dc3\u0dd2\u0dbd\u0dca\u0dbd\u0d9a\u0dca \u0daf\u0dd4\u0db1\u0dca\u0dad\u0db1\u0dcf. \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 220\u0d9a \u0db4\u0dcf\u0dbd\u0db1 \u0db8\u0dd2\u0dbd\u0d9a\u0dd4\u0dda \u0daf\u0dd4\u0db1\u0dca\u0dad\u0db1\u0dcf. \u0d86\u0db1 \u0db1\u0dd2\u0d9a \u0dc3\u0dc4\u0dbd\u0dca\u0dc0\u0dbd\u0da7 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 220\u0d9a \u0db4\u0dcf\u0dbd\u0db1 \u0db8\u0dd2\u0dbd\u0d9a\u0dca \u0daf\u0dd0\u0dda\u0db8\u0dcf\u0db8, \u0db8\u0daf\u0dca\u0dd3\u0dbd \u0dc3\u0dc4\u0dbd\u0dca \u0db8\u0dd2\u0dbd \u0dc3\u0dca\u0dc0 \u0d82\u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc0\u0db8 \u0d8a\u0da7 \u0dc0\u0da9\u0dcf \u0d89\u0dc4 \u0da7 \u0db1\u0dc0\u0dcf. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0dad\u0db8\u0dd2 \u0d85\u0daf \u0d9a\u0dc5\u0dd4 \u0d9a\u0db8\u0dda \u0dc4\u0d82\u0d9c\u0dcf\u0db8\u0d9c\u0db1 \u0dc3\u0dc4\u0dbd\u0dca \u0d9a\u0dd2\u0db8\u0dbd\u0ddd\u0dc0 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 260, \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca 280 \u0dc0\u0dcf\u0db8\u0dda \u0d9c\u0dab\u0db1\u0dca\u0dad\u0dc0\u0dbd\u0da7 \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0db1 \u0dad\u0dda\u0dda\u0dc0 \u0da7 \u0db4\u0dda\u0db8\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad."
  },
