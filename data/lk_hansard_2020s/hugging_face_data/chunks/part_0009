u0db1 15 990 \u0dcf\u0d9a\u0dca\u0dc0\u0dca\u200d\u0dcf \u0d85\u0da9\u0dd4 \u0dc1\u0dc0\u0dca\u200d\u0dbd\u0dcf \u0dad\u0dd2\u0dbd\u0dc1\u0db6\u0db1\u0dc0\u0dca\u200d\u0dcf \u0d9c\u0dd4\u0dc0 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0d9a\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0d92 \u0dc0\u0dca\u200d\u0dcf\u0dc1\u0d9a\u0db8 2]22 \u0dc0\u0dca\u200d\u0dbb\u0dca\u0dc2\u0dc1\u0dda\u0daf\u0dd3 \u0dc3\u0dd2\u0dba\u0dba\u0da7 6].0] \u0dcf\u0d9a\u0dca\u0dc0\u0dca\u200d\u0dcf inflation \u0d89\u0dc4\u0dca\u200d\u0dc5 \u0db1\u0dd0\u0d9f\u0dbd\u0dcf \u0dad\u0dd2\u0dbd\u0db6\u0dd4\u0dc3\u0dcf. 2]20 \u0dc1\u0dcf\u0dc3\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dcf\u0dc3\u0dba \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0d8d\u0dc3 1.2 \u0dcf\u0d9a\u0dca\u0dc0\u0dca\u200d\u0dcf \u0dcf\u0dcf\u0dab\u0dca\u0da9 \u0dc4\u0dca\u200d\u0dcf \u0dc1\u0dc3\u0dda\u0dc0\u0dca\u200d\u0dcf\u0dc0\u0dca\u200d\u0dbd \u0db8\u0dd2\u0dbd \u0d89\u0dc4\u0dca\u200d\u0dc5 \u0dba\u0dd1\u0db8 \u0d85\u0da9\u0dd4 \u0dc1\u0dc0\u0dca\u200d\u0dbd\u0dcf \u0dad\u0dd2\u0dbd\u0dc1\u0db6\u0db1\u0dc0\u0dca\u200d\u0dcf.\n\n\u0d9c\u0dd4\u0dc0 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0d9a\u0dcf\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db8\u0db8 \u0dc1\u0db8\u0dca \u0d9c\u0dd4\u0dc0 \u0dc3\u0dcf\u0dcf\u0dc1\u0dda \u0d85\u0dc0\u0dca\u200d\u0db0\u0dcf\u0db1\u0dba \u0dc1\u0dba\u0ddc\u0db8\u0dd4 \u0d9a \u0dc0\u0dca\u200d\u0db1\u0dca\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dbd\u0dba\u0dd2 \u0d85\u0dc1\u0db4\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0dbd\u0d9a \u0da2\u0db1 \u0db6\u0dbd\u0dc1\u0dda\u0d9c\u0dc1\u0dda \u0da2\u0dba \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0dca\u200d\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a \u0db4\u0dd4 \"\u0dc1\u0db4\u0ddc\u0dc1\u0dc4\u0dca\u200d\u0ddc\u0dc3\u0dad\u0dca \u0da7\u0d9a\u0dca \u0dbd\u0dc3\u0dae\u0dc3\u0db1 \u0da2\u0dd3\u0dd2\u0db0\u0dad\u0dba\u0d9a\u0dca\" \u0d9a\u0dd2\u0dba\u0db1 \u0dc0\u0dca\u200d\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dca\u200d\u0dc5 \u0db8\u0dd2\u0dcf\u0dba\u0dcf\u0dc0\u0dca\u200d\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dd2\u0db0\u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dca\u200d\u0dd4\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dda\u0dc0\u0dca\u200d\u0dcf\u0da7 \u0d85\u0db4\u0dd2 \u0d92\u0d9a \u0dc3\u0dad\u0dba \u0dc1\u0dbd\u0dc3\u0db8 \u0dc1\u0db8\u0dca \u0dc1\u0da7\u0dca \u0dba\u0dcf\u0dcf\u0dbb\u0dca\u0dcf\u0dba\u0d9a\u0dca \u0db6\u0dc0\u0dca\u200d\u0da7 \u0db4\u0dad\u0dca \u0d9a \u0db1\u0dc0\u0dca\u200d\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf \u0dc3\u0dba\u0da7. \u0d86\u0dcf\u0dcf\u0dba\u0db8\u0dca \u0dc4\u0dca\u200d\u0dcf \u0dd2\u0db0\u0dba\u0dcf\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0db4\u0da7 \u0dc1\u0dc4\u0dca\u200d\u0ddc\u0db3 \u0d85\u0dc0\u0dca\u200d\u0dc1\u0db6\u0ddd\u0db0\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dbd\u0dc1\u0db6\u0db1\u0dc0\u0dca\u200d\u0dcf. \u0d85\u0dc1\u0db4\u0dca \u0d86\u0dcf\u0dcf\u0dba\u0db8\u0dca \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dd2 \u0d9a \u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0d9a\u0ddc\u0dc1\u0dc4\u0dca\u200d\u0ddc\u0db8\u0dcf \u0dd2\u0db0\u0dba\u0dcf\u0db8\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a \u0dc3\u0dba \u0d9a \u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0d9a\u0ddc\u0dc1\u0dc4\u0dca\u200d\u0ddc\u0db8\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0dc1\u0db4\u0dca \u0da2\u0dba\u0da7 \u0dc1\u0dc4\u0dca\u200d\u0ddc\u0db3 \u0d85\u0dc0\u0dca\u200d\u0dc1\u0db6\u0ddd\u0db0\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dbd\u0dc1\u0db6\u0db1\u0dc0\u0dca\u200d\u0dcf. \u0d85\u0db4\u0da7 \u0dc1\u0db8\u0dca \u0dc1\u0da7\u0dca \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0dca\u200d \u0db6\u0dbd\u0dba \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0dbd\u0dcf \u0dad\u0dd2\u0dbd\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc0\u0dca\u200d\u0dc3 \u0db4\u0dc4\u0dca\u200d\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dca\u200d\u0dcf. \u0d92 \u0dc0\u0dca\u200d\u0dc3 \u0db4\u0dc4\u0dca\u200d \u0dc3\u0db3\u0dc4\u0dca\u200d\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0dc0\u0dca\u200d\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dca\u200d\u0dc5 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a \u0dbd\u0dcf \u0dad\u0dd2\u0dbd\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d92 \u0dc0\u0dca\u200d\u0dc3 \u0db4\u0dc4\u0dca\u200d\u0d9a \u0dc0\u0dca\u200d\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dca\u200d\u0dc5 \u0dad\u0dd4\u0dc5"
