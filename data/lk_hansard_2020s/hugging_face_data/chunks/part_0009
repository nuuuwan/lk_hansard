    "chunk_text": "\u0d91\u0dad\u0dd4\u0db8\u0dcf \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dda \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf, \u0da7\u0dd2\u0dba\u0dd4\u0dc2\u0db1\u0dca \u0db1\u0dc0\u0dda\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0db4 \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0db6\u0dc0\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0, \u0d85\u0db4\u0dd2 \u0d9a\u0dc0\u0daf\u0dcf\u0dc0\u0dda \u0d92 \u0dc0\u0dcf\u0dc1\u0dda \u0dc0\u0dc4\u0dc3\u0dd2 \u0db6\u0dc3\u0dca \u0dc1\u0daf\u0ddc\u0da9\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0; \u0d92 \u0dc0\u0dcf\u0dc1\u0dda \u0db4\u0da0 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc3\u0dc4 \u0d85\u0dc0\u0dbd\u0dcf\u0daf \u0db1\u0d9f\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0d85\u0db4\u0dd2 \u0dc4\u0dd0\u0db8 \u0daf\u0dcf\u0db8\u0dda \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dba \u0dc1\u0dc0 \u0d9a\u0dc1\u0dc0\u0db1\u0dca \u0d85\u0db4\u0da7 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0d9a\u0dd0\u0db4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf; \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7\u0dda \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dd4\u0dda, \u0d85\u0db4 \u0d92 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0dc3\u0dc4\u0dc1\u0dba\u0ddd\u0d9c\u0dba \u0dd3\u0db8\u0dbd\u0dcf, \u0d85 \u0d9a\u0dca\u200d\u0dbb\u0dc4\u0dba \u0dd3\u0db8\u0dbd\u0dcf \u0d92 \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d89\u0dc4\u0dc5\u0dd2\u0db1\u0dca \u0d94\u0dc3\u0dc0\u0dcf \u0dad\u0db6\u0db1\u0dca\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0dc1\u0d9a\u0ddc\u0da7 '\u0dc1\u0dc4\u0ddc\u0db3\u0db8 \u0dc1\u0daf\u0dca \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0da7 \u0dad\u0db8\u0dba\u0dd2' \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1 \u0d92 \u0db8\u0dc4\u0dda\u0dad\u0dd4\u0dbb\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0d9a\u0dca\u200d\u0