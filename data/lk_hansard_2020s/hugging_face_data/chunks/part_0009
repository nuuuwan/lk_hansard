    "chunk_text": "\u0d9c\u0dc5\u0dc3\u0dca\u0dda \u0d91\u0d9a\u0da7 \u0d85\u0db1\u0dd4 \u0d85 \u0dc3\u0dca\u0dad\u0dcf\u0dc1 \u0dc3\u0dca\u0dc5\u0dbd\u0dc1\u0dc3\u0dca\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1 \u0d9c\u0dc5\u0dc3\u0dca\u0dda \u0db1\u0dd2\u0dc1\u0dda\u0dba\u0db1 \u0dc1\u0db4\u0dc1\u0daf\u0dd4 \u0d9c\u0dc5\u0dc3\u0dca\u0dda \u0db1\u0dd2\u0dc1\u0dda\u0dba\u0db1 \u0d9a\u0dca \u0dba \u0d91\u0dc1\u0dc4\u0db8 \u0db1\u0dc5\u0dad\u0dca\u0dc0\u0db1 \u0dad\u0db1\u0dd2 \u0db4\u0dd4\u0dda\u0d9c\u0dbd\u0dc1 \u0d9a\u0dd4 \u0dc1\u0dc4\u0ddd \u0d86 \u0dad\u0db1 \u0d9a\u0dca \u0dc1 \u0db1\u0dd4\u0dc1 \u0db1\u0dca \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca\u0dc0 \u0d9a\u0dbb\u0dbd\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0d9c\u0dc5\u0dc3\u0dca\u0dda \u0db1\u0dd2\u0dc1\u0dda\u0dba\u0db1 \u0d9a\u0dca \u0dba \u0d9a\u0dd2 \u0dbd\u0dc1 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dad\u0dbb \u0dc1\u0dc3\u0dca\u0dc1 \u0dc1 \u0db3\u0dbd\u0db1 \u0dc1\u0d9a\u0dc1\u0da7 \u0d85\u0db4\u0da7 \u0dba\u0dc5\u0db1 \u0d9c\u0db1\u0dca\u0db1\u0da7 \u0dbd\u0dc5\u0db6\u0dd4\u0db4\u0dc1 \u0dc1 \u0d9a \u0dad\u0db1\u0dd2 \u0d86 \u0dad\u0db1 \u0d9a\u0dca \u0dc1 \u0db1\u0dd4\u0dc1 \u0db1\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca\u0dc0 \u0d9a\u0dbb\u0dbd\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0d9c\u0dc5\u0dc3\u0dca\u0dda \u0db1\u0dd2\u0dc1\u0dda\u0dba\u0db1 \u0d9a\u0dca \u0d9a\u0dd2 \u0dbd\u0dc1. \u0dc1 \u0d9c\u0dc5\u0dc3\u0dca\u0dda \u0db1\u0dd2\u0dc1\u0dda\u0dba\u0db1 \u0da7 \u0d85\u0dba\u0dc1\u0dd0 \u0dad \u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca\u0dc0 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dad\u0dbb \u0dc1\u0dc3\u0dca\u0dc1 \u0dc1 \u0db3\u0dbd\u0db1\u0dc1\u0d9a\u0dc1\u0da7 \u0d85\u0db4\u0da7 \u0dc1\u0db4\u0db1\u0dd3 \u0d9c\u0dd2 \u0dad \u0dad\u0dca\u0dc0 \u0d9a\u0dc1\u0dbb\u0db4 \u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1. 2024 \u0db8\u0dc5\u0dd2 \u0db8\u0dc1\u0dc3\u0dca\u0dc1 \u0dad\u0db8\u0dd2 \u0dc1 \u0d9c\u0dc5\u0dc3\u0dca\u0dda \u0db1\u0dd2\u0dc1\u0dda\u0dba\u0db1 \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca\u0dc0 \u0d9a\u0dbb\u0dbd\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d92 \u0d9a\u0dc1\u0dbd\u0dc1 \u0db8 \u0dc1 \u0d9a \u0db4\u0dc1\u0dbd\u0dd2\u0db8\u0dda\u0dc1 \u0db1\u0dca\u0dad\u0dd4 \u0da7 \u0d89\u0dd2\u0db1\u0dd2 \u0db4\u0dad\u0dca\u0dc0 \u0d9a\u0dbb\u0dbd\u0dc1 \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0da7 \u0dad\u0dd2\u0db6\u0dd4\u0db4\u0dc1. \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0db4\u0dc3\u0dca\u0dad\u0dc3\u0dca\u0da7 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dad\u0dbb \u0dc1\u0dc4\u0dc1 \u0dc1\u0dc1\u0d9c\u0db1 \u0db1 \u0dc1\u0d9a\u0dc1\u0da7 \u0d85\u0db4\u0da7 \u0dc1\u0db4\u0dc1\u0db1\u0db1\u0dca\u0db1\u0da7 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1\u0dba \u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1. \u0dc1\u0db8\u0dc4\u0dd2 \u0dc1\u0d9a\u0dc1\u0db1\u0dca\u0dc1\u0dda\u0dc3\u0dd2 \u0dc1\u0dba\u0d9a\u0d9a\u0dca \u0d9a\u0dd2 \u0dc1 \u0dad\u0dd2\u0db6\u0dd4\u0db4\u0dc1. \u0db8\u0db8 \u0d92\u0d9a\u0dd2 \u0d9c\u0dc5\u0dc3\u0dca\u0dda \u0d91\u0dc1\u0d9a\u0dca requirement \u0d91\u0d9a \u0d9a\u0dd2\u0dc1 \u0dda\u0dc1\u0dda. \u0d91\u0d9a\u0d9a\u0dca \u0dad\u0db8\u0dd2 \u0d85 \u0dba \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dad\u0dbb \u0dc1\u0dad\u0dc1\u0dbb\u0dad\u0dd4\u0dd4\u0dc0 \u0db1\u0dd2 \u0dad\u0da0 \u0d9a\u0dd0 \u0d85 \u0daf\u0dd4 \u0d9a\u0dd4\u0dc0\u0dc1\u0dda \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dad\u0dbb \u0d85\u0db0\u0dba\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d85 \u0dc3\u0dca\u0db1\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dc1\u0dba \u0db1\u0dd4 \u0db3\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9c\u0dc1\u0dc3\u0dca\u0dad\u0dad\u0dd4 \u0dc1\u0d9c \u0dc1 \u0db1\u0dd2\u0db8 \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0da7 \u0d95\u0db1\u0dd1. \u0dc1\u0db8\u0db1\u0dca\u0db1 \u0dc1 \u0dc1\u0d9a\u0dc1\u0db1\u0dca\u0dc1\u0dda\u0dc3\u0dd2 \u0dc1\u0dba\u0d9a\u0db8 \u0dc3\u0dca \u0dd4\u0dbd\u0dd2\u0db8\u0db4 \u0d9a\u0dd0 \u0dc1\u0d9a\u0dc1\u0db1\u0d9a\u0dd4\u0da7 \u0dc0\u0dd2\u0dad\u0dbb\u0dd2 2024 \u0da2\u0db1 \u0dc1\u0dd2 62 \u0da7 \u0dc1\u0db4\u0dbb \u0dc1 \u0d9a \u0d9c\u0db1\u0dca\u0db1\u0da7 \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca.\n\n\u0d92 \u0dc3\u0dca \u0db3\u0db1\u0dca\u0db0 \u0dad \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dad\u0dbb \u0db3\u0dbd\u0db1\u0dc1\u0d9a\u0dc1\u0da7 \u0d85\u0db4\u0da7 \u0dc1\u0dda\u0db1 \u0dc1, \u0d85\u0dba\u0dc1\u0dd0 \u0d85\u0db8\u0dc1\u0dad\u0dba \u0dbb \u0dc1\u0db8 \u0dad\u0db8\u0dd2, 2024 \u0da2\u0db1 \u0dc1\u0dd2 \u0d89 \u0dbd\u0dc1 \u0db6\u0dd2\u0dda \u0db1 5\u0d9a\u0dca \u0dc1\u0d9c \u0db1\u0dca\u0db1\u0da7 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2 \u0dbd\u0dc1 2024 \u0da2\u0db1 \u0dc1\u0dd2 62 \u0dc5\u0db1\u0dd2 \u0dba\u0dc1 \u0dc1 \u0d85\u0dbd\u0dd4\u0dad\u0dca\u0dc0 \u0d9c\u0dc5\u0dc3\u0dca\u0dda \u0d91\u0d9a \u0d89\u0dd2\u0db1\u0dd2 \u0db4\u0dad\u0dca\u0dc0 \u0d9a\u0dc1\u0dd0\u0dad, \u0dc1 \u0d85\u0dbd\u0dd4\u0dad\u0dca\u0dc0 \u0db1\u0dd3\u0dad\u0dd2 -\u0dc1\u0dbb\u0dab \u0dbd\u0dc1\u0dc3\u0dd2 - \u0dc1\u0d9c\u0db1\u0dc1\u0dc1\u0dda \u0d9a\u0dd2 \u0dbd\u0dc1. \u0d91\u0dc1\u0dc4\u0db8 \u0db1 , \u0d92\u0d9a\u0da7 \u0d85\u0dba\u0dc1\u0dd0 \u0d85\u0dad\u0dca\u0dc0\u0dc3\u0dca\u0db1 \u0d8a\u0da7 \u0dba \u0dc3\u0dca\u0dad 30\u0d9a\u0da7 \u0d9a\u0dda\u0db1\u0dca \u0dad\u0dd2 \u0db1\u0dc1\u0d9a\u0dc1\u0da7 \u0d92 \u0d85\u0dba\u0dc1\u0dd0 \u0d86 \u0dad\u0db1 , \u0d85\u0dba\u0dc1\u0dd0 \u0db1\u0dd2\u0dbd\u0db0\u0dc1\u0dd2 \u0db1\u0dca \u0dc3\u0dca\u0dc4 \u0d87\u0db8\u0dad\u0dd2 \u0dbb \u0dc1 \u0dc1 \u0d9c\u0dc5\u0db1 \u0dba\u0dc5\u0db1\u0dc1\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0db1\u0da7 \u0dc1\u0dbd\u0dc1\u0d9a\u0dd4 \u0dc4\u0dc5\u0d9a\u0dd2 \u0dc1 \u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1. \u0d91\u0dc1\u0dc4\u0db8 \u0db1 \u0dc1 \u0dc3\u0dd2 \u0dbd\u0dca\u0dbd \u0dba\u0dc5\u0db1 \u0dba\u0dc5\u0db1 \u0dc1 \u0dc1\u0dc1\u0dda \u0dc1\u0dba \u0d9a\u0dca \u0dc0\u0dd4\u0db4\u0dc1\u0dba\u0dc5\u0dd2 \u0d85\u0db4\u0da7 \u0dc1 \u0dbd\u0dc1 \u0d9a\u0da7 \u0db4\u0dca\u200d\u0dbb \u0dad\u0db1 \u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dc1 \u0db1 \u0dc1. \u0dc1 \u0d9a\u0da7 \u0dc3\u0dca \u0db3\u0db1\u0dca\u0db0 \u0dc1 \u0dbd\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc0\u0dd2\u0dc1\u0dda \u0d86\u0dc1 \u0ddd\u0da2\u0d9a\u0dc1 \u0d9a\u0dca \u0d89\u0db1\u0dca\u0db1 \u0dc1. \u0dc1 \u0d9a \u0dc0\u0dd2\u0dc1\u0dda \u0d86\u0dc1 \u0ddd\u0da2\u0db1 \u0d9a\u0dca \u0dc1\u0dbd\u0dc3\u0dca \u0d9a\u0dc5\u0dc3\u0dd2\u0dc1\u0db1\u0ddd \u0dba\u0dc1\u0db4\u0dc1\u0dbb \u0da7 \u0dc1 \u0dbb\u0da7\u0da7 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0d91\u0d9a\u0d9a\u0dca. \u0dc1 \u0d9a \u0d92 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0daf\u0dd3\u0db4\u0dd4 \u0db3\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dca. \u0dc0\u0dd2\u0dc1\u0dda"
  },
