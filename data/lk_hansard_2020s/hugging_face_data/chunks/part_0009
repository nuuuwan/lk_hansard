    "chunk_text": "\u0d92 \u0dc0\u0dbb\u0dd4\u0dca\u0db1\u0dda\u0db8 \u0dc0\u0dbb\u0dd4\u0dca\u0dab\u0dd2\u0da2 \u0db1\u0dc0\u0dbb\u0dd4\u0db1\u0dc5\u0db3 \u0db1\u0dbb\u0ddc\u0db1\u0dc5\u0dda \u0da2\u0dca\u0dad\u0dba\u0db1\u0dca\u0dad\u0dbb \u0dd0\u0dca\u0db0\u0dc0\u0dbb\u0dd4 \u0db4 \u0db6\u0dd2\u0db3\u0dd4\u0dca\u0dba\u0dbb \u0dd9\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dd0\u0dca\u0dba\u0da0\u0dca\u0da1\u0dca \u0dbb\u0dad\u0db1\u0dca \u0d85\u0dbb\u0db1\u0d9c\u0db1 \u0dad\u0dd2\u0dd4\u0dab\u0dd9\u0dca. \u0d85\u0dbb\u0dad \u0db8\u0dad\u0dba\u0dba\u0dd2\u0daf \u0d92 \u0db1\u0dc0\u0dbb\u0dd4\u0dbd\u0dca\u0db1\u0dda \u0db8\u0dca\u0db0\u0dba \u0dc4\u0dbb\u0dc4\u0dca \u0db4\u0dca\u200d\u0dbb\u0dba\u0dca\u0db1\u0dba\u0dad \u0dbb\u0dd3 \u0dba\u0dc5\u0dca\u0daf \u0da2\u0db1\u0dca\u0db0\u0dd2\u0dbb\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0dbb\u0dd9\u0dba\u0dad \u0db1 \u0db1 \u0db1\u0dc0\u0dba\u0dba\u0dad \u0db1\u0dbb\u0dbb \u0d92 \u0dd0\u0dca\u0dba\u0da0\u0dca\u0da1\u0dca \u0d85\u0dc0\u0dbb\u0dd4\u0dd0\u0db1\u0dca \u0db6\u0dc0\u0dbb\u0dd4. \u0d92 , \u0dd0\u0dca \u0d85\u0dbb\u0dad \u0dba\u0dc5\u0dd2 \u0dd9\u0dba \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0dd4\u0dc4\u0d9c\u0dad \u0dba\u0dbb \u0d9c\u0dd2\u0db1\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dd0\u0dca\u0dba\u0da0\u0dca\u0da1\u0dca\u0dc0\u0dbb\u0dd4\u0dba\u0dad \u0d89\u0da7\u0dba\u0da7 \u0dba \u0dc0\u0dd2\u0dc0\u0dbb\u0dd4\u0dd8\u0dad \u0db1\u0dc0\u0dbb\u0dd4\u0dbd\u0dca \u0dad\u0dd2\u0dd4\u0dab \u0db1\u0dda \u0db1\u0dd2\u0dc4\u0dd2. \u0d91\u0dba \u0d85\u0dd4\u0dbb\u0dbb\u0dd4\u0daf\u0dd4 \u0db1\u0dc0\u0dba\u0dba\u0dad \u0dc0\u0dbb\u0dd4\u0da7\u0dca \u0dc0\u0dbb\u0dd4\u0dd2\u0da9\u0dd2 \u0dba\u0dca\u0dbd\u0dba \u0dba \u0dd0\u0dca\u0dba\u0da0\u0dca\u0da1\u0dca\u0dc0\u0dbb\u0dd4\u0dad \u0db6\u0db3\u0dd4\u0db1\u0dca\u0db1\u0dc0\u0dbb\u0dd4\u0dbd\u0dca \u0dad\u0dd2\u0dd4\u0dab\u0dd9\u0dca. \u0db1\u0dd2\u0dc0\u0dbb\u0dd4\u0dad \u0daf\u0dd3\u0dbd\u0dd2\u0d9d \u0dba\u0dca\u0dbd\u0dba \u0dba \u0d91\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0dd4\u0dc4\u0d9c\u0dad \u0dba\u0dbb \u0d9c\u0dd2\u0db1\u0dd3\u0db1\u0dca \u0dc0\u0dbb\u0dd4\u0dd2\u0da7\u0dd0\u0dad\u0dc4\u0db1\u0db1\u0dca \u0dd0\u0dca\u0dba\u0da0\u0dca\u0da1\u0dca \u0dcf\u0dbb\u0dca\u0dc0 \u0dba\u0db1\u0dc5\u0ddc\u0dd3 \u0dd9\u0dba \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0dd4\u0dc4\u0d9c\u0dad \u0d9a\u0dd2 \u0db4\u0db1\u0dca \u0dc0\u0dbb\u0dd4\u0dd2\u0da7\u0dd0\u0dad\u0dc4\u0db1\u0dca \u0d85\u0dc0\u0dbb\u0dd4\u0dd0\u0db1\u0dca \u0dba\u0dbb \u0d9c\u0dd2\u0db1\u0dd3\u0db8\u0d9a\u0dd2\u0db1\u0dca \u0dad \u0db1 \u0dca\u0dbb\u0dc0\u0dbb\u0dd4 \u0d85\u0dbb\u0dad \u0dcf\u0dbd\u0dd2\u0dae\u0dd2\u0dba\u0dba \u0d89\u0db1 \u0dbb\u0dd2\u0dba\u0dad \u0db1\u0d9c\u0db1 \u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dba\u0db8 \u0dba \u0dbd\u0dd2\u0db1\u0db6\u0db1\u0dca\u0db1\u0db1\u0dca \u0db1\u0dd2\u0dc4\u0dd2. \u0d85\u0dd4\u0dbb\u0dbb\u0dd4\u0daf\u0dd4 \u0db1\u0dc0\u0dba\u0dba\u0dad \u0dcf\u0dd0\u0db1\u0dca\u0db1 \u0dba\u0dca\u0dbd\u0dba \u0dba \u0dd9\u0dba \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0dd4\u0dc4\u0d9c\u0dad \u0dba\u0dbb \u0d9c\u0dd2\u0db1\u0dd3\u0db8 \u0dd0\u0db3\u0dc4\u0dca \u0dba\u0dbb\u0db1 \u0dbd\u0dc0 \u0dd0\u0dca\u0dba\u0da0\u0dca\u0da1\u0dca \u0d85\u0dc0\u0dbb\u0dd4\u0dd0\u0db1\u0dca \u0d85\u0db1 \u0dba\u0db1\u0dbd\u0dd2 \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0dba \u0d9c\u0db1\u0dca\u0db1\u0dca \u0dc0\u0dd2\u0dad \u0dad\u0dd2\u0dd4\u0dab \u0db1\u0dda. \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0dd4\u0dc4\u0d9c\u0dad \u0dba\u0dbb \u0d9c\u0dd2\u0db1\u0dd3\u0db1\u0dca \u0db1\u0dba\u0ddd\u0da2\u0db1\u0dca \u0db1\u0dc4\u0ddc\u0db3 \u0dc0\u0daf \u0db1\u0dbb\u0dba \u0dc0\u0daf \u0dc0\u0dbb\u0dd4\u0dca\u0dc3\u0dd2 \u0dc0\u0daf \u0d85\u0dc0\u0dbb\u0dd4\u0dca\u0dc3\u0dd2 \u0dc0 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0dba \u0dc0\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0dc0\u0dbb\u0dd4\u0dca\u0dc0 \u0d9a\u0dd2 \u0db4\u0db1\u0db8\u0db1\u0dca \u0dbb\u0dc5 \u0dba \u0db1\u0dd2\u0dc4\u0dd2. \u0d92\u0dba \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0dbb \u0dc4\u0db8\u0dd4\u0db1\u0dda \u0dad\u0dd2\u0db1\u0db6\u0db1 \u0dba\u0dae\u0dca\u0dbd\u0dd2\u0dae\u0dba. \u0daf\u0dca\u0dc0\u0dd2\u0dbb\u0dca\u0dbd\u0dd2\u0db1\u0dca\u0dc0\u0dd3\u0dba \u0dd9\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0\u0dbb\u0dd4 \u0db1\u0dbb\u0ddc\u0daf\u0dd4 \u0d91\u0dba\u0d9f\u0dad\u0dca\u0dc0\u0dbb\u0dd4\u0dba\u0dad \u0d87\u0dc0\u0dd2\u0dbd\u0dcf\u0dbd\u0dca \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0dbb\u0dd4\u0dca. \u0d92 \u0d85\u0db1\u0dd4\u0dc0\u0dbb\u0dd4 \u0d85\u0db4\u0dd2 \u0d89 \u0dba\u0db8, \u0db1\u0dca\u0db8 \u0d91 \u0dba \u0d91 \u0dba \u0dbb\u0dad\u0dc0\u0dbb\u0dd4\u0dbd\u0dcf \u0d91 \u0dba\u0dba \u0db1\u0dc0\u0dbb\u0dd4\u0db1 \u0db1\u0dc0\u0dbb\u0dd4\u0db1\u0db8 \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0dca\u0dc0\u0dbb\u0dd4\u0dbd\u0dad \u0d91\u0dc5\u0dd2\u0db9\u0dd3\u0db8\u0dad \u0dc3\u0dd6\u0dc0\u0dca\u0db1\u0dca \u0db1\u0dc0\u0dbb\u0dd4\u0dbd\u0dca \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0dbb\u0dd4\u0dca.\n\n\u0d85\u0db1\u0db1 \u0dba \u0dbb\u0dc3\u0dd2\u0db1\u0dca \u0d9c\u0dd3\u0db1\u0dad\u0ddc\u0dd3\u0daf \u0da2\u0dca\u0dad\u0dba\u0db1\u0dca\u0dad\u0dbb \u0dd0\u0dca\u0db0\u0dc0\u0dbb\u0dd4 \u0db4 \u0db6\u0dd2\u0db3\u0dd4\u0dca\u0dba\u0dbb. \u0dc0\u0dbb\u0dd4\u0dca\u0dab\u0dd2\u0da2 \u0db1\u0dc0\u0dbb\u0dd4\u0db1\u0dc5\u0db3 \u0db1\u0dbb\u0ddc\u0db1\u0dc5\u0db1\u0dca \u0d9c\u0db1\u0dca\u0db1\u0dca \u0dd9\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0\u0dbb\u0dd4 \u0dbd\u0dcf\u0db8\u0dda\u0dba\n\n33 34\n\n\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0db1\u0dca\u0dc0\u0da7\u0dc0\u0dbb\u0dd4\n\n\u0d92 \u0dd0\u0db3\u0dc4\u0dca \u0dbb\u0dc5\u0db8\u0dd4\u0db1\u0dba\u0ddc\u0dad\u0db8 \u0d85\u0db1\u0dda \u0dbb\u0db1\u0dda \u0dc0\u0dca\u0dda\u0da7 \u0dc4\u0dca \u0db1\u0dd0\u0dda\u0dc0\u0dbb\u0dd4\u0dca , \u0dc2\u0dca\u0dbb\u0dca\u0dc0\u0db1\u0db1\u0dda \u0db1\u0dda\u0d9c\u0dc0\u0dbb\u0dd4\u0dd3 \u0dc0\u0dbb\u0dd4\u0dbd\u0dd2\u0db0\u0db1\u0dba \u0dba \u0dd0\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0dd0\u0dca\u0dbb\u0dd9\u0dba \u0dba \u0d87\u0dad\u0dd2 \u0dba\u0dbb \u0d9c\u0dad \u0dba\u0dd4\u0dc0\u0da7\u0dba\u0dd2. \u0d85\u0db4\u0dd2 \u0dc0\u0dca\u0dda\u0da7 \u0dc4\u0dca \u0db1\u0dd0\u0dda\u0dc0\u0dbb\u0dd4\u0dca , \u0dc2\u0dca\u0dbb\u0dca\u0dc0\u0db1\u0dba \u0dc0\u0dbb\u0dd4\u0dbd\u0dd2\u0db0\u0db1\u0dba \u0dba\u0dbb \u0d9c\u0dad \u0dba\u0dd4\u0dc0\u0da7\u0dba\u0dd2. \u0d92 \u0dc0\u0dbb\u0dd4\u0dca\u0db1\u0dda\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dd0\u0dca\u0dbb\u0dd9\u0dba \u0dba\u0dbb \u0d9c\u0dad \u0dba\u0dd4\u0dc0\u0da7\u0dba\u0dd2. \u0db1\u0db6\u0ddc\u0db1\u0dc4\u0ddd \u0dc0\u0dd2\u0dad \u0d85\u0db1\u0dda \u0dbb\u0db1\u0dda \u0dcf\u0dbd\u0dd2\u0dae\u0dd2\u0dba\u0db1\u0dda \u0dc0\u0dbb\u0dd4\u0dbd\u0dd2\u0db0\u0db1\u0db1\u0dba\u0db1\u0dca \u0dc0\u0dd2\u0db1\u0dca\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8\u0dca\u0dd9\u0dba \u0dba \u0d85\u0dbb\u0dad \u0db1\u0d9c\u0db1\u0dd2\u0dd3 \u0db1\u0dc0\u0db1\u0dca\u0db1\u0db1\u0dca \u0db6\u0dd0\u0dca\u0db1\u0dca\u0dc4\u0dd2\u0dbb \u0dbb\u0dc5\u0dca\u0dad. \u0d92 , \u0dd0\u0dca \u0dcf\u0dbd\u0dd2\u0dae\u0dd2\u0dba\u0dba \u0db4\u0dca\u200d\u0dbb\u0dd0\u0dca\u0dbb\u0dd9\u0dba \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dc0\u0da7\u0dba\u0dd2 \u0d85\u0db1\u0db1 \u0dba \u0dbb\u0dc5\u0dca\u0dd3 \u0dc0 \u0dba\u0dc0\u0dbb\u0dd4\u0dca. \u0d92 \u0d85\u0db1\u0dd4\u0dc0\u0dbb\u0dd4 \u0d85\u0db1\u0dda \u0dcf\u0dbd\u0dd2\u0dae\u0dd2\u0dba\u0db1\u0dda \u0db4\u0dca\u200d\u0dbb\u0db0\u0dca\u0db1 \u0dd0\u0dd2\u0dbd\u0dd2\u0dd0\u0dca\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0dc0\u0dca\u0dda\u0da7 \u0dc4\u0dca \u0db1\u0dd0\u0dda\u0dc0\u0dbb\u0dd4\u0dca , \u0dc2\u0dca\u0dbb\u0dca\u0dc0\u0db1\u0db1\u0dda \u0db1\u0dda\u0d9c\u0dc0\u0dbb\u0dd4\u0dd3 \u0dc0\u0dbb\u0dd4\u0dbd\u0dd2\u0db0\u0db1\u0dba \u0dba \u0dd0\u0dc4 \u0db1\u0dda\u0d9c\u0dc0\u0dbb\u0dd4\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0dd0\u0dca\u0dbb\u0dd9\u0dba \u0dba \u0d87\u0dad\u0dd2 \u0d9a\u0dd2 \u0db4\u0db8."
