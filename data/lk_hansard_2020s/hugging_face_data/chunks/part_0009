    "chunk_text": "\u0dad\u0d9a\u0dca\u0dc1\u0dc3\u0dca\u0dbb\u0dd4\u0dc0 \u0db4\u0daf\u0db1\u0db8\u0dca \u0d9a\u0dbb\u0dc1\u0d9c\u0db1 \u0db1\u0dd0\u0dc0\u0dad\u0dad\u0dca\u0dad \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0ddc\u0dc0 \u0dc3\u0db8\u0ddc\u0dc1\u0dbd\u0ddd\u0da0\u0db1\u0dba \u0d9a\u0dbb\u0dda\u0db1 \u0dad\u0dd3\u0dda\u0daf\u0dd4 \u0d9a\u0dbb\u0dbd\u0ddc \u0dad\u0dd2\u0dc0\u0dc1\u0db6\u0db1\u0dc0\u0ddc. \u0d92 \u0d85\u0dc0\u0dd9\u0dc0 \u0dba\u0db8\u0dca \u0dba\u0db8\u0dca \u0dc3\u0dd2\u0d82\u0dc1 \u0ddd\u0dd9\u0db1 \u0d9a\u0dbb \u0dad\u0dd2\u0dc0\u0dc1\u0db6\u0db1\u0dc0\u0ddc \u0d9a\u0dd2\u0dba\u0dbd\u0ddc \u0db8\u0ddc \u0dc1\u0db8\u0dca \u0dc3\u0dc0\u0ddc\u0dc0\u0da7 \u0d9a\u0dd2\u0dba\u0dda\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dba\u0dd2. \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0ddc\u0dc0 \u0dca\u200d\u0dbb\u0db8\u0ddc\u0dab\u0dc0\u0dad\u0dca\u0dad \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0dbd\u0ddc \u0d9a\u0dd2\u0dba\u0db1 \u0dca\u0daf\u0dc0\u0dd2\u0dba \u0d91\u0dc1\u0dc4\u0db8 \u0d9a\u0dd2\u0dba\u0dda\u0dc1\u0dda \u0d9a\u0dd2\u0dc3\u0dba\u0db8\u0dca \u0db8\u0dc4\u0da2\u0db1 \u0dc4\u0dd2\u0dad\u0d9a\u0ddc\u0db8\u0dd3 \u0d85\u0db7\u0dd2\u0dbd\u0ddc\u0dc2\u0dba\u0d9a\u0dd2\u0dda \u0dc1\u0db1\u0ddc\u0dc0\u0db1 \u0db6\u0dc0\u0dad\u0dca\u0dad \u0da2\u0ddc\u0dad\u0dd2\u0dc0\u0d9a \u0dd9\u0db1\u0dba \u0dad\u0db8\u0dda\u0dc1 \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0dd2\u0d9a \u0dc3\u0dd4\u0d9b\u0dca\u200d\u0dc0\u0dd2\u0dc4\u0dbb\u0dab\u0dba\u0da7 \u0dc1\u0dba\u0ddc\u0daf\u0ddc \u0d9c\u0dd0\u0db1\u0dd3\u0dc1\u0db8\u0dca \u0db4\u0dd4\u0dbb\u0dd4\u0dda\u0daf \u0d85\u0dad\u0dca\u0dad\u0dc4\u0dd0\u0dbb \u0d9c\u0dda\u0db1\u0da7 \u0dc1\u0db1\u0ddc\u0dc4\u0dd0\u0d9a\u0dd2 \u0db1\u0dd2\u0dc3\u0ddc \u0db6\u0dc0\u0dad\u0dca\u0dad \u0db8\u0ddc \u0d9a\u0dd2\u0dba\u0dda\u0db1 \u0d85\u0dc0 \u0dba\u0dba\u0dd2. \u0d85\u0dc1\u0db1\u0d9a\u0dca \u0d85\u0dad\u0da7 \u0dc1\u0db8\u0dad\u0dbb\u0db8\u0dca \u0dc0\u0dd2 \u0ddc\u0dbd \u0dc4\u0db8\u0dd4\u0daf\u0ddc \u0db1\u0dd2\u0dbd\u0dd9\u0ddc\u0dbb\u0dd2\u0dda \u0dc3\u0dd2\u0d82\u0d9b\u0dca\u200d\u0dba\u0ddc\u0dc0\u0d9a\u0dca \u0d85\u0dc0 \u0dba \u0dc1\u0db8\u0ddc\u0db1\u0dc0\u0ddc\u0da7\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0ddc\u0dad\u0dca\u0dad \u0d94\u0dc0\u0dd4\u0dda\u0da7 \u0d9a\u0dd2\u0dba\u0dda\u0db1 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc. \u0dc3\u0db8\u0dc4\u0dbb \u0dc4\u0db8\u0dd4\u0daf\u0ddc \u0db1\u0dd2\u0dbd\u0dd9\u0ddc\u0dbb\u0dd2\u0dda \u0d95\u0db1\u0dd1 \u0dc3\u0dd4\u0db1\u0d9b\u0dca\u200d\u0dba\u0dda \u0db6\u0dbd\u0ddc\u0d9c\u0dda\u0db1\u0daf \u0dc3\u0dd4\u0db1\u0d9b\u0dca\u200d\u0dba\u0dda \u0db1\u0ddc\u0dc0\u0dda\u0db1\u0daf \u0dc3\u0dd4\u0db1\u0d9b\u0dca\u200d\u0dba\u0dda \u0d85\u0dc3\u0db1\u0dd3\u0db4 \u0dc0\u0dd4\u0dab\u0ddc\u0db8 \u0d89\u0dc3\u0dca\u0db4\u0dd2\u0dbb\u0dd2\u0dad\u0ddc\u0dc1\u0dbd\u0da7 \u0dc1\u0d9c\u0db1 \u0dba\u0dda\u0db1\u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0dca\u200d\u0dbb \u0dca\u0db1 \u0dc1\u0db8\u0dca \u0dc1\u0dc0\u0dbd\u0ddc\u0dc1 \u0d85\u0db4\u0da7 \u0d85\u0dc4\u0dda\u0db1 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc. \u0dc1\u0db8\u0ddc\u0d9a\u0daf \u0dc1\u0db8\u0dca \u0da2\u0db1\u0ddc\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dc0\u0dbb\u0dd4\u0dda\u0dc1 \u0d9a\u0ddc\u0dbb\u0dca\u0dba \u0db8\u0dab\u0dca\u0da9\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dc4\u0db8\u0dd4\u0daf\u0ddc\u0dc1\u0dc0\u0dda \u0d85\u0dc0\u0dd9\u0dba\u0dd4\u0d9a\u0dca\u0dad \u0d9a\u0dbb\u0dbd\u0ddc \u0d89\u0dda\u0db1 \u0dc3\u0db8\u0dc4\u0dbb \u0dc1\u0dc3\u0db6\u0dc5\u0dd4\u0dda \u0d92 \u0d9a\u0ddc\u0dbb\u0dca\u0dba\u0dba\u0dda \u0dc3\u0db3\u0dc4\u0ddc \u0dc1\u0dba\u0ddc\u0daf\u0dc0\u0ddc \u0dad\u0dd2\u0dc0\u0dc1\u0db6\u0db1 \u0db6\u0dc0 \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0dda \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4\u0dad\u0dca\u0dad \u0daf\u0dda\u0db1\u0dc0\u0ddc.\n\n\u0dc1\u0db4\u0ddc\u0dbd\u0dd3\u0dc3\u0dc1 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0dc0\u0dd2\u0dc1 \u0dca\u0dc2\u0da5\u0db4\u0dba\u0dda\u0dc1 \u0dad\u0dd3\u0dda\u0daf\u0dd4 \u0dad\u0dd3\u0dbb\u0dab \u0d85\u0dc0\u0dd9\u0dc0 \u0dc1\u0db8\u0dca \u0dc1\u0dc0\u0d