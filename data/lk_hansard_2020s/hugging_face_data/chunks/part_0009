b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b95\u0bc1\u0bb4\u0bc1: \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\n\n\u0ba8\u0bbf\u0baf\u0bc8\u0ba9\u0bae\u0bcd [\u0baa: 1219] \u0b85\u0bb0\u0b9a\u0bc6\u0bbe\u0b99\u0bcd\u0b95 \u0ba8\u0bbf\u0ba4\u0bbf \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b95\u0bc1\u0bb4\u0bc1: \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0bbf\u0baf\u0bc8\u0ba9\u0bae\u0bcd\n\n[\u0baa: 1220] \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bc6\u0bbe\u0baf\u0bcd\u0bae\u0bc2\u0bb2 \u0bb5\u0bbf\u0bae\u0b9f\u0b95\u0bb3\u0bcd [\u0baa: 1222-1283] \u0ba4\u0ba9\u0bbf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bae\u0bc2\u0bb2 \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe: \u0baf\u0bc6\u0bbe\u0bb4\u0bcd. \u0baa\u0baa\u0bc6\u0bbe\u0ba4\u0ba9\u0bc6\u0bbe \u0bae\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0b9a\u0bc6\u0bbe\u0bae\u0bb2 \u0b9a\u0bc1\u0b95\u0bc6\u0bbe\u0ba4\u0bc6\u0bbe\u0bb0\u0ba4\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0ba3\u0bcd\u0b9f\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0bae\u0ba9 [\u0baa: 1284]\n\n\u0d9c\u0dd4 \u0db1\u0dcf\u0dd9\u0dbd\u0dca \u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0dd9\u0dc4\u0dad\u0dcf\u0daf\u0dda \u0daf\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0d9a\u0dd4\u0dd4 \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dbd\u0dd2\n\n\u0d9a\u0dd2\u0dbb\u0dd3\u0dd9 [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 1289] \u0d9c\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0da5\u0dd4\u0dbb\u0dd9\u0dcf\u0daf\u0dda \u0dc0\u0dd2\u0daf\u0dc1\u0dca\u0dda\u0dc2 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dca\u0dba [\u0dad\u0dd3\u0dbb\u0dd4\u0dc0 1297] \u0db4\u0dbb\u0dd2\u0db4\u0dd6\u0dbb\u0d9a \u0db8\u0dd4\u0dd9\u0dbd \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0daf\u0dd4\u0dc2\u0dca\u0d9a\u0dbb\u0dad\u0dcf \u0dc3\u0dc4\u0dd2\u0dad \u0db4\u0dc0\u0dd4\u0dbd\u0dca\u0dc0\u0dbd \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dbd\u0dd2\u0db4\u0dd2\n\n\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dba \u0dd3\u0db8\u0db8\u0db1\u0dcf\u0dc0 - \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dc0\u0dd2\u0dba [\u0dad\u0dd3\u0dbb\u0dd4 1309-1405] \u0d9a\u0dbd\u0dca\u0dad\u0dd0\u0db6\u0dd3\u0daf\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0db1 [\u0dad\u0dd3\u0dbb\u0dd4 1405-1412]\n\n\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba8\u0bc6\u0bbe\u0bc8\u0bb2\u0bcd \u0bb0\u0bc6\u0bbe\u0b9c\u0baa\u0b95\u0bcd\u0bb7\u0bb5\u0bbf\u0ba9\u0ba4\u0bc1 \u0ba4\u0b9a\u0bc6\u0bbe\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0bb3\u0b95\u0bcd\u0b95\u0bae\u0bcd\n\n[\u0baa: 1289] \u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b9a\u0ba9\u0bc6\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0ba4\u0bc1 \u0bb5\u0bbf\u0baa\u0b9a\u0b9f \u0b95\u0bc2\u0bb1\u0bcd\u0bb1\u0bc1 [\u0baa: 1297] \u0b95\u0bc1\u0bae\u0bb1\u0ba8\u0bbf\u0bb0\u0baa\u0bcd\u0baa\u0bc1\u0ba4\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0bae\u0b95: \u0ba4\u0baa\u0bc6\u0bbe\u0bb0\u0bc1\u0bb3\u0bc6\u0bbe\u0ba4\u0bc6\u0bbe\u0bb0 \u0bc6\u0bbe\u0bc0\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0ba4\u0b99\u0bcd\u0b95\u0bbf\u0baf \u0b95\u0bc1\u0b9f\u0bc1\u0bae\u0bcd\u0baa\u0b99\u0bcd\u0b95\u0bae\u0bb3\u0b9a\u0bcd"
