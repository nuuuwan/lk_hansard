    "chunk_text": "(\u0d89) \u0dc1\u0db8\u0dca \u0dc1\u0dba\u0ddd\u0da2\u0db1\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dad\u0dc1\u0dda \u0db4\u0db8\u0dd4\u0dc0\u0db1 \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0db1\u0dc1\u0dda \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc1\u0dd3\u0dbb\u0dca\u0dc2 240 - \"\u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0dc1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0dc0\" \u0dba\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dba \u0dba\u0da7\u0dc1\u0dad\u0dca \"\u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf\" \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0dba\u0da7\u0dc1\u0dad\u0dca, \u0db4\u0dd4\u0db1\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dad\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0db8\u0dca \u0dc1\u0dc4\u0ddd \u0db8\u0dd6\u0dbd\u0db0\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0db8\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0dd4\u0daf\u0dbd\u0dca \u0dc1\u0db8\u0dca \u0dc1\u0dba\u0ddd\u0da2\u0db1\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dad\u0dc1\u0dda \u0dc3\u0dd2\u0dda\u0dc0\u0db1 \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0db1\u0dc1\u0dda \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0dc1\u0d9c\u0ddd\u0db4\u0dc1\u0dda \u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0, \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dcf\u0d9c\u0dcf\u0dbb\u0dc1\u0dda \u0dc1\u0dbd\u0dca\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dc1\u0dda \u0db1\u0dd2\u0dba\u0db8\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0dc1\u0dc4\u0ddd \u0dad\u0dad\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dcf\u0d9c\u0dcf\u0dbb\u0dc1\u0dda \u0dc1\u0dbd\u0dca\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dba\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dd9\u0dbd\u0dba \u0dc1\u0daf\u0db1\u0dd4 \u0dbd\u0dd0\u0dd2\u0dba\u0dba \u0dc4\u0dd0\u0d9a\u0dd2 \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dcf\u0d9c\u0dcf\u0dbb\u0dc1\u0dda \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0dc1\u0dbd\u0dca\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dba \u0dc1\u0dda \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db1\u0dd0\u0dad\u0dc1\u0dc4 \u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0dc1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0dda \u0d85\u0db0\u0dba\u0d9a\u0dca\u0dc2\u0d9a \u0da2\u0db1\u0dbb\u0dcf\u0dbd\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dc1\u0dda \u0db1\u0dd2\u0dba\u0db8\u0dba \u0d85\u0db1\u0dd4\u0dc0, \u0d92 \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0db1\u0dc1\u0dda \u0dc1\u0dc0\u0db1\u0dad\u0dca \u0dba\u0db8\u0dca \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dba\u0d9a\u0dca \u0dba\u0da7\u0dc1\u0dad\u0dca \u0dd6 \u0dc1\u0dc0\u0db1\u0dad\u0dca \u0dba\u0db8\u0dca \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1\u0d9a\u0da7 \u0db8\u0dcf\u0dbb\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd2\u0dba\u0dba \u0dc4\u0dd0\u0d9a\u0dd2 \u0dba \u0d91\u0dc1\u0dc3\u0dda \u0db8\u0dcf\u0dbb\u0dd4 \u0d9a\u0db8 \u0dd4\u0daf\u0dbd\u0dca, \u0d85\u0daf\u0dcf\u0db8 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba \u0dc1\u0dc0\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db4\u0dbb\u0dd2\u0db4\u0dd6\u0dbb\u0d9a \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dca \u0dc1\u0dbd\u0dc3 \u0dc3\u0dbd\u0d9a\u0db1\u0dd4 \u0dbd\u0dd0\u0dd2\u0dba\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf \u0d85\u0dad\u0dbb, \u0d91\u0dc1\u0dc3\u0dda \u0db8\u0dcf\u0dbb\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0dd9\u0db3\u0dc0 \u0dc3\u0dc4 \u0d91\u0db8 \u0db8\u0dcf\u0dbb\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc1\u0dc4\u0dda\u0dad\u0dd4\u0db8\u0dcf \u0d85\u0db1\u0dca\u0dad\u0dbb\u0dca\u0d9c\u0dad \u0dc0\u0db1 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0\u0d9a\u0dca, \u0d91\u0d9a\u0dd3 \u0db8\u0dcf\u0dbb\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0db8\u0dcf\u0dc3 \u0dc1\u0daf\u0d9a\u0d9a \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0dad \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0dc0 \u0dc1\u0dc0\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd2\u0dba\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf \u0dd9\u0dc0,\n\n\u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dba\u0dc0\u0dc3\u0db1\u0dae\u0dcf\u0dc1\u0dda 150 \u0dc0\u0dba\u0dc0\u0dc3\u0db1\u0dae\u0dcf\u0dc1\u0dda (2) \u0d85\u0db1\u0dd4\u0dc0\u0dba\u0dc0\u0dc3\u0db1\u0dae\u0dcf\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbb\u0dc0 \u0dc1\u0db8\u0db8 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0dc0 \u0dc1\u0dba\u0ddd\u0da2\u0db1\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dbb\u0dba\u0dd2\n\n759 760\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0dc0 763 764\n\n2024 \u0dc1\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0dd9\u0dbb\u0dca 06 765 766\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0dc0 767 768\n\n2024 \u0dc1\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0dd9\u0dbb\u0dca 06 769 770\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0dc0 771 772\n\n2024 \u0dc1\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0dd9\u0dbb\u0dca 06 773 774\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0dc0 775 776\n\n2024 \u0dc1\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0dd9\u0dbb\u0dca 06 777 778\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0dc0 779 780\n\n2024 \u0dc1\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0dd9\u0dbb\u0dca 06 781 782\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0dc0 783 784\n\n2024 \u0dc1\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0dd9\u0dbb\u0dca 06 785 786\n\n\u0db4\u0dcf\u0dbb\