    "chunk_text": "243 244\n\n\u0dad\u0d9c\u0dd4\u0dc0 \u0dc1\u0dbb\u0ddd\u0dc4\u0dd2\u0dad \u0d85\u0dc1\u0dda\u0dab \u0db4 \u0dbd\u0dd2\u0db8\u0db0\u0db1 \u0db8\u0dc4\u0dad\u0dc1\n\n2025 \u0da2\u0db1 \u0dc1\u0dd2 08\n\n\u0d92 \u0db1\u0dd2\u0dc3\u0dca\u0dc1 \u0db8\u0db8 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dc1 \u0db8\u0db1\u0dca\u0dd3 \u0dd4\u0dc0\u0db1\u0dca\u0da7 \u0dc1 \u0d9a\u0dc1\u0dbb\u0db4 \u0db8\u0dad\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dc5\u0db8\u0dc5\u0dad\u0dd2\u0dd2. \u0dd4\u0dc0\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dda \u0db1 20\u0d9a\u0da7 \u0d86\u0dc3\u0dca\u0db1\u0dca\u0db1 \u0db4\u0dc1\u0dca \u0d9a\u0dca \u0d9a\u0dbb\u0db4\u0dd4 \u0d94 \u0dc1\u0d9c\u0dc1\u0dbd\u0dca\u0dbd\u0db1\u0dca \u0dad\u0db8\u0dd2 \u0dba\u0dc5\u0db1\u0dca \u0da2\u0db1\u0dad\u0dc1 \u0d9c\u0dc5\u0db1 \u0d85\u0db1\u0dd4\u0d9a \u0db4\u0dc1\u0dc1 \u0db1\u0dca \u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca.\n\n\u0db8\u0db8 \u0dba\u0dc5\u0db1\u0dca \u0d89\u0dc3\u0dca\u0dad\u0dc3\u0dca\u0dbb\u0dc4\u0da7 \u0db1\u0dca\u0db1 \u0db8\u0dc1\u0dda \u0d85\u0dba\u0dc4\u0dc3\u0dca\u0dad \u0dba\u0dc5\u0d9a\u0dca\u0dc0\u0dd3\u0db8\u0db8\u0dad\u0dca\u0dc0 \u0d91\u0d9a\u0dca\u0d9a. \u0d85\u0db4\u0dd2 \u0dc1 \u0dc1\u0d9c\u0dc1\u0da9\u0db1\u0d9f\u0db8\u0dd2\u0db1\u0dca \u0d89\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d9a\u0dd4\u0db8\u0d9a\u0dca\u0dba? \u0d85\u0dc1\u0dda \u0d85\u0dbd\u0dd4\u0dad\u0dca\u0dc0 \u0d86\u0da9\u0dd4\u0d9a\u0dca \u0dc1 \u0dc1\u0d9c\u0dc1\u0da9\u0db1\u0d9f\u0db1\u0dca\u0db1 \u0d8b\u0dad\u0dca\u0dc0\u0dc3\u0dca\u0dc1\u0dc4 \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d9a\u0dd4\u0db8\u0d9a\u0dca\u0dba? \u0d85\u0db4\u0dd2 \u0dba\u0db1\u0dca\u0db1\u0dc1 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0dbd\u0dd2\u0db8\u0dad\u0db8\u0dc1\u0db1\u0dc1 \u0dc3\u0dca\u0dcf \u0dbd\u0dd2\u0db8\u0db0\u0db1 \u0dca\u200d\u0dbb\u0dd2 \u0dc1 \u0dda \u0d85\u0db4\u0da7 \u0dad\u0dc1\u0d9a\u0dca \u0daf\u0dd4\u0dbb\u0d9a\u0da7 \u0dc1\u0dc4\u0ddd \u0db4\u0dd2\u0dd2\u0db6\u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca \u0db8\u0dda\u0da7\u0db8\u0d9a\u0da7 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dbb\u0da7 \u0dbd\u0dca \u0dc1\u0dbd\u0ddd\u0d9a\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1. \u0d92 \u0dbb\u0da7 \u0dbd \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0d86\u0dbd\u0dd2\u0db8\u0dd2\u0d9a \u200d\u0dbb\u0db8 \u0d9c\u0dc5\u0db1 \u0dc1\u0dda \u0db4\u0dc1\u0dbd\u0db1 \u200d\u0dbb\u0db8 \u0d9c\u0dc5\u0db1 \u0d85\u0db4\u0dd2 \u0dc1\u0db1\u0dc1\u0dc1 \u0d9a\u0dca \u0db8\u0dad \u0dc1\u0dba \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca. \u0dc4\u0dc5\u0db3\u0dc5\u0dd2 \u0dba\u0dc5\u0db1\u0da7 \u0d86\u0dbd\u0dd2\u0db8\u0dd2\u0d9a \u0dc3\u0dca\u0dcf \u0dbd\u0dd2\u0db8\u0db0\u0db1 \u0d85\u0dad\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dd2\u0db6\u0d9c\u0dad \u0dc4\u0dc5\u0d9a\u0dd2 \u0db8\u0dda\u0da7\u0db8\u0d9a\u0da7 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dd2\u0db1\u0dd4\u0dad\u0dab\u0dd4 \u0db8\u0dda\u0da7\u0db8\u0d9a\u0da7 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dbb\u0da7 \u0dbd\u0dca \u0dc1\u0dbd\u0ddd\u0d9a\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1. \u0d92 \u0dbb\u0da7 \u0dbd\u0dca \u0dbd \u0d89\u0dad\u0dd2\u0dc4\u0dc1\u0dc3\u0dca \u0d85\u0db0\u0dba \u0db1 \u0d9a\u0dd0\u0dc1\u0db8 \u0d85\u0db4\u0da7 \u0dba\u0d9a\u0dd2\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca \u0d9a\u0dc1\u0dbb\u0db4\u0dc1 \u0d9a\u0dca \u0dad\u0db8\u0dd2 \u0d92 \u0dc3\u0dca\u0dd1\u0db8 \u0dbb\u0da7\u0d9a\u0db8\n\n\u0db4\u0dd2 \u0dbd\u0dd2\u0db8\u0dad\u0db1\u0dd3 \u0d9a\u0dc1\u0dbd \u0db4\u0dd2 \u0da1\u0dcf\u0dc1\u0dda\u0dba \u0d9a\u0dca \u0d89\u0dad\u0dd2\u0dc4\u0dc1\u0dc3\u0dca \u0dad\u0dd4\u0dd0 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0db3 . \u0d89\u0dad\u0dd2\u0dc4\u0dc1\u0dc3\u0dca \u0d85\u0dc4\u0db9\u0dd4 \u0dc1\u0dbd\u0dc3\u0dca \u0d9c\u0dbd\u0dc1 \u0db1 \u0dc1 \u0dc1 \u0db1\u0dd4 \u0da7 \u0db8\u0dd2\u0db1\u0dd2\u0db8\u0db1\u0dca \u0d9a\u0da9\u0dd4\u0d9a\u0da9\u0dc1 \u0db8\u0d9a\u0dca \u0db8\u0dc5\u0dd2\u0db1\u0dc4\u0dad\u0dca\u0dc0 \u0dc1 \u0dbd\u0dc1 \u0dc3\u0dca\u0dc5\u0dbd\u0dc5\u0dc3\u0dca\u0dad\u0db8\u0d9a\u0dca \u0d87\u0dad\u0dd4 \u0dba\u0dc5\u0d9a\u0dca\u0db8\u0d9a\u0dca \u0d87\u0dad\u0dd4 \u0db1\u0dc1 \u0d9a\u0dad\u0dca\u0dc0 \u0d9a\u0dca \u0daf\u0dd3\u0dbd\u0dc1 \u0d85\u0db1\u0dc1\u0d9c\u0dad \u0dba\u0dc5\u0d9a\u0dca\u0db8\u0d9a\u0dd2\u0db1\u0dca \u0d86\u0dbd\u0dd2\u0db8\u0dd2\u0d9a \u0dc1\u0db8\u0dc1\u0dc4 \u0db4\u0dd4 \u0d93\u0dad\u0dd2\u0dc4\u0dc1\u0dc3\u0dd2\u0d9a \u0d9a\u0dc1\u0dbd \u0db4\u0dd2 \u0da1\u0dcf\u0dc1\u0dda\u0dba \u0d9a\u0dca \u0d85\u0db4\u0da7 \u0d92 \u0dbb\u0da7 \u0dbd \u0d89\u0dad\u0dd2\u0dc4\u0dc1\u0dc3\u0dca \u0db4\u0dd4\u0dbb\u0dc1 \u0dba\u0d9a\u0dd2\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca. \u0d85\u0db4\u0dd2 \u0d8b\u0dba\u0dc1\u0dc4\u0dbb\u0db4 \u0dc1\u0dbd\u0dc3\u0dca \u0d9c\u0dad\u0dca\u0dc0\u0dc1\u0dad\u0dc1\u0dad\u0dca\u0dc0 \u0d87\u0dc1\u0db8\u0dd2 \u0d9a\u0dc1 \u0d91\u0d9a\u0dca\u0dc3\u0dca\u0dad\u0dca\u0dc0 \u0da2\u0db1\u0db4\u0dba \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca \u0da0\u0dd3\u0db1 \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca \u0dba\u0d9a\u0dd4\u0dab\u0dd4 \u0dc1\u0d9a\u0dc1\u0dd2 \u0dc1 \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca \u0da2\u0db4\u0dc1\u0db1 \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca \u0dc1 \u0dc4\u0dc5\u0db8 \u0dbb\u0da7\u0d9a\u0db8 \u0d89\u0dad\u0dd2\u0dc4\u0dc1\u0dc3\u0dca\u0dc1 \u0db4\u0dd2 \u0dbd\u0dd2\u0db8\u0dad\u0db1\u0dd3 \u0d9a\u0dc1\u0dbd \u0db4\u0dd2 \u0da1\u0dcf\u0dc1\u0dda\u0dba \u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0db3 \u0d85\u0db4\u0da7 \u0dba\u0d9a\u0dd2\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca. \u0d92 \u0dad\u0dd4\u0dd0 \u0d92 \u0dbb\u0da7 \u0dbd\u0dca \u0dc3\u0dd2\u0dda\u0db0 \u0d9a\u0dd0 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0dca\u0dcf\u0dc3\u0dca\u0dad\u0d9a\u0dbb\u0db4 \u0dbd \u0dc1 \u0db1\u0dc3\u0dca\u0dad\u0d9a \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca. \u0dc4\u0dc5\u0db3\u0dc5\u0dd2 \u0d92 \u0dc3\u0dca\u0dd1\u0db8 \u0db4\u0dd2 \u0dbd\u0dd2\u0db8\u0dad\u0db1 \u0d9a\u0db8 \u0d85\u0db4\u0da7 \u0dba\u0d9a\u0dd2\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca \u0dc1\u0db4\u0dc1\u0daf\u0dd4 \u0dbd\u0d9a\u0dca\u0dc2\u0db4 \u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1. \u0d92 \u0dad\u0db8\u0dd2 \u0dba\u0dc5\u0d9a\u0dca\u0db8\u0d9a\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0dc3\u0dd2\u0dc4\u0dd2\u0db1 \u0d9a\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0d92 \u0dbb\u0da7 \u0dbd\u0dca \u0d85\u0dc0\u0dd4\u0dd4\u0dc0\u0daf\u0dd4 20\u0d9a\u0dca 30\u0d9a\u0dca 40\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0dca\u0dad\u0dc1\u0dc3\u0dca\u0dad \u0d89\u0dd2\u0db1\u0dd2 \u0d85\u0db1\u0dc1\u0d9c\u0dad \u0d9a\u0dca \u0dba\u0d9a\u0dca \u0dc1 \u0dc3\u0dca\u0dc5\u0dbd\u0db8\u0db8\u0d9a\u0dca \u0d87\u0dad\u0dd4 \u0dc1\u0db8\u0dc1\u0dc4 \u0dc0\u0dd6 \u0db4\u0dd2 \u0dbd\u0dd2\u0db8\u0dad\u0db1\u0dd3 \u0d9a\u0dc1\u0dbd \u0db4\u0dd2 \u0da1\u0dcf\u0dc1\u0dda\u0dba \u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0db3 ."
