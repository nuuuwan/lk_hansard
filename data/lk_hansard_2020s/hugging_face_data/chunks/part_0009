\u0dd2\u0dc3\u0dcf\u0db1 \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf\n\n\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b86\u0bb0\u0bcd.\u0b8e\u0bae\u0bcd. \u0b95\u0bbe\u0bae\u0bbf\u0ba9\u0bbf \u0bb0\u0ba4\u0bcd\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b85\u0b9c\u0bbf\u0ba4\u0bcd \u0b85\u0b95\u0bb2\u0b95\u0b9f \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b89\u0baa\u0bc1\u0bb2\u0bcd \u0b95\u0bbf\u0ba4\u0bcd\u0b9a\u0bbf\u0bb1\u0bbf \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b85\u0b9c\u0bbf\u0ba4\u0bcd \u0b95\u0bbf\u0bb9\u0bbe\u0ba9\u0bcd \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b85\u0bb2\u0b9a\u0bbe\u0b95 \u0b95\u0bc1\u0ba3\u0bb2\u0b9a\u0ba9 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0bb0\u0bcd\u0bae\u0baa\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0baf \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba8\u0ba8\u0bcd\u0ba4\u0ba9 \u0baa\u0ba4\u0bcd\u0bae\u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba8\u0bbf\u0bb7\u0bbe\u0ba8\u0bcd\u0ba4 \u0ba4\u0baa\u0bb2\u0bb0\u0bb0\u0bbe \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0bb2\u0baa\u0bcd\u0b9f\u0bbf\u0ba9\u0ba9\u0bcd \u0b95\u0bae\u0bbe\u0ba3\u0bcd\u0b9f\u0bb0\u0bcd (\u0b93\u0baf\u0bcd\u0bb5\u0bc1\u0ba4\u0baa\u0bb1\u0bcd\u0bb1) \u0baa\u0bbf\u0bb0\u0b95\u0bc0\u0ba4\u0bcd \u0bae\u0ba4\u0bc1\u0bb0\u0b99\u0bcd\u0b95 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0bc1\u0ba9\u0bbf\u0bb2\u0bcd \u0bb0\u0ba4\u0bcd\u0ba9\u0b9a\u0bbf\u0bb1\u0bbf \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 (\u0ba4\u0bbf\u0bb0\u0bc1\u0bae\u0ba4\u0bbf) \u0b8f.\u0b8e\u0bae\u0bcd.\u0b8e\u0bae\u0bcd.\u0b8e\u0bae\u0bcd. \u0bb0\u0ba4\u0bcd\u0bb5\u0ba4\u0bcd\u0bb2\u0ba4 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bae\u0bb2\u0ba9\u0bbe\u0b9c\u0bcd \u0bb0\u0bbe\u0b9c\u0baa\u0b95\u0bcd\u0bb7 \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 (\u0ba4\u0b9a\u0bb2\u0bcd\u0bb5\u0bbf) \u0b85\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bbe \u0b9a\u0bbe\u0bae\u0bbf\u0bb2\u0bb5\u0bb2\u0bcd \u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bae\u0bc1\u0bb9\u0bae\u0bcd\u0bae\u0b9f\u0bcd \u0b95\u0baa\u0b9a\u0bb2\u0bcd"
