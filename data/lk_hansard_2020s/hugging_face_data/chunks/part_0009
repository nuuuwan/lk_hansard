    "chunk_text": "\u0d9c\u0dd4\u0dc0 \u0da0\u0dad\u0dd4 \u0dcf\u0d82\u0d9c \u0d85\u0dc1\u0dda\u0dc3\u0dd2\u0dcf\u0d82\u0dc4\u0dca\u200d \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0d9c\u0dba\u0db1\u0dca\u0dad \u0d9a\u0dd4\u0dc0\u0dc3\u0dcf\u0dad\u0dd2\u0dbd\u0dbd\u0d9a \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0dc1\u0d9a\u0dca. \u0dc3\u0dd4\u0da2\u0dd2\u0dad\u0dca \u0dc3\u0dcf\u0d82\u0da2\u0dba \u0dc1\u0db4\u0dc1\u0dbb\u0dca \u0dcf \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0d85\u0da2\u0dd2\u0dad\u0dca \u0d85\u0d9c\u0dbd\u0d9a\u0da9 \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0db1\u0dd3\u0dad\u0dd2\u0dbd\u0da5 \u0dc3\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a\u0dcf \u0d85\u0dad\u0dcf\u0dc0\u0dd4\u0dcf \u0db8\u0dc4\u0dca\u200d\u0dad\u0dca\u0db8\u0dd2\u0dba \u0d9c\u0dd4\u0dc0 \u0db1\u0dd3\u0dad\u0dd2\u0dbd\u0da5 \u0dba\u0dd6.\u0db4\u0dd3. \u0d85\u0dc1\u0dda\u0dd2\u0db0\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0dc3\u0dd4\u0d9c\u0dad\u0dca \u0dc0\u0dca\u200d\u0dc3\u0db1\u0dca\u0dad \u0dcf \u0dc3\u0dd2\u0db1\u0dc0\u0dca\u200d\u0dcf \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0dad\u0db1\u0dd4 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0dc3\u0dd4\u0da2\u0dd3\u0dc0\u0dca\u200d \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0dd3\u0db8\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb \u0db6\u0dab\u0dca\u0da9\u0dcf \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0db0\u0db1\u0dd4\u0dc2\u0dae\u0d9a \u0dcf\u0d82\u0d9c\u0db1\u0dcf\u0dad\u0dca \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0daf\u0dd3\u0db4\u0dca\u0dad\u0dd2\u0dbd \u0dc0\u0dca\u200d\u0dcf\u0dc3\u0dbd\u0dc1\u0d9a \u0db8\u0dc4\u0dca\u200d\u0dad\u0dca\u0db8\u0dd2\u0dba \u0d9c\u0dd4\u0dc0 \u0d86\u0dbb\u0dca.\u0da2\u0dd3. \u0dd2\u0db0\u0dc1\u0dda \u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0da2\u0d9c\u0dad\u0dca \u0dd2\u0db0\u0dad\u0dcf\u0db1 \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0daf\u0dd2\u0db1\u0dd2\u0db3\u0dd4 \u0dc3\u0db8\u0db1\u0dca \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf\n\n\u0d9c\u0dd4\u0dc0 \u0dcf\u0db1\u0dca\u0dad \u0db4 \u0db8 \u0d9a\u0dd4\u0db8\u0dcf \u0dc3\u0dd4\u0db6\u0dc3\u0dd2\u0dcf\u0d82\u0dc4\u0dca\u200d \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0dc1 \u0dc0\u0dca\u200d\u0dcf\u0db1\u0db1\u0dca\u0dcf \u0dc3\u0dd4 \u0dd3\u0db8 \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0da0\u0db1\u0dca\u0dcf\u0db1 \u0dc3\u0dd6\u0dbb\u0dd2\u0dba\u0d86 \u0da0\u0dca\u0da0\u0dd2 \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0db1\u0dd3\u0dad\u0dd2\u0dbd\u0da5 \u0dbd\u0d9a\u0dca\u0db8\u0dcf\u0dbd\u0dd2 \u0dc1\u0dc4\u0dca\u200d\u0dda\u0db8\u0da0\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb \u0dc1\u0db8\u0dc1\u0db1\u0dd2\u0db0\u0dba\n\n10. \u0dc0\u0dd0\u0dc0\u0dd2\u0dbd\u0dd2 \u0dca\u0dc4\u0dc3 \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf \u0dba\u0dd2\u0dad\u0dad\u0dbd \u0db4\u0dc4\u0dc3\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0d9a \u0dba\u0dd4\u0dd4\u0dbb \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dcf\u0dc1\u0dca \u0d8b\u0dba\n\n11. \u0dc0\u0dca\u0dde\u0d9b\u0dba \u0dca\u0dc4\u0dc3 \u0da2\u0db1\u0db8\u0dcf\u0db0\u0dcf\u0dba \u0d9a \u0dba\u0dd4\u0dd4\u0dbb \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dcf\u0dc1\u0dca \u0d8b\u0dba \u0d8b\u0db4\u0dc0 \u0dc1\u0dca\u0d9a\n\n\u0d9a\u0dcf\u0dbb\u0d9a \u0dca\u0db7\u0dcf\u0dc0 \u0d9c\u0dd4\u0dc0 (\u0d86\u0da0\u0dcf\u0dbb\u0dca\u0dba) \u0d91\u0db8\u0dca.\u0d91\u0db1.\u0d92.\u0d91\u0db8\u0dca. \u0dc4\u0dd2\u0dc3\u0dae\u0db6\u0dd4\u0db1\u0dbd\u0dcf\u0dc4\u0dca\u200d\u0dae \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0d86\u0dbb\u0dca.\u0d91\u0db8\u0dca. \u0d9c\u0dcf\u0db8\u0dd2\u0dab\u0dd3 \u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 (\u0dc0\u0dc0\u0dca\u200d\u0dcf\u0dba) \u0d9a\u0dd2\u0db0\u0db1\u0dca\u0dcf \u0dc1\u0dc4\u0dca\u200d\u0dda\u0dc2\u0dcf\u0db1\u0dca \u0da2\u0dba\u0dc0\u0dca\u200d\u0dbb\u0dca\u0db0\u0db1 \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 (\u0dc0\u0dc0\u0dca\u200d\u0dcf\u0dba) \u0db1\u0dd2\u0dc4\u0dca\u200d\u0dcf\u0db1 \u0d85\u0dc1\u0dda\u0dc3\u0dd2\u0dcf\u0d82\u0dc4\u0dca\u200d \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 (\u0dc0\u0dc0\u0dca\u200d\u0dcf\u0dba) \u0db1\u0da2\u0dd2\u0dad\u0dca \u0d89\u0db1\u0dca\u0daf\u0dd2\u0d9a \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0dc0\u0dca\u200d\u0dc3\u0db1\u0dca\u0dad \u0db4\u0dd4\u0dc2\u0dae\u0db4 \u0d9a\u0dd4\u0db8\u0dcf \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0da0\u0db8\u0dd2\u0db1\u0dca\u0dcf \u0dbd\u0dbd\u0dd2\u0dad\u0dca \u0d9a\u0dd4\u0db8\u0dcf \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0db1\u0dd3\u0dad\u0dd2\u0dbd\u0da5 \u0db1\u0dd2\u0dbd\u0db1\u0dca\u0dad\u0dd2\u0dbd \u0dc1\u0d9a\u0ddc\u0da7\u0dca\u0da7\u0dc4\u0dca\u200d\u0da0\u0dca\u0da0\u0dd2 \u0db8\u0dc4\u0dca\u200d\u0dad\u0dca\u0db8\u0dd2\u0dba \u0d9c\u0dd4\u0dc0 (\u0dc0\u0dc0\u0dca\u200d\u0dcf\u0dba) \u0da2\u0d9c\u0dad\u0dca \u0dd4\u0dc0\u0dc3\u0dc0\u0dca\u200d\u0dbb\u0dca\u0db0\u0db1 \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0d85\u0dc1 \u0ddd\u0d9a \u0dd4\u0dc0\u0dc3\u0dc1\u0dc3\u0dda\u0db1 \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 (\u0db8\u0dc4\u0dca\u200d\u0dcf\u0da0\u0dcf\u0dbb\u0dca\u0dba) \u0dc1\u0dc3\u0dda\u0db1 \u0db1\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dca\u0d9a\u0dcf \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0d9a\u0db1\u0dca\u0dcf\u0dc3\u0dcf\u0db8\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db7\u0dd6 \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0dc3\u0dd4\u0dcf\u0dad\u0dca \u0db6\u0dbd\u0d9c\u0db1\u0dbd \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 (\u0dc0\u0dc0\u0dca\u200d\u0dcf\u0dba) \u0d91\u0dc3\u0dae. \u0dca\u200d\u0dbb\u0dd3 \u0db6\u0dc0\u0dca\u200d\u0dcf\u0db1\u0db1\u0dca\u0dcf \u0dcf\u0da2\u0dcf \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 (\u0dc0\u0dc0\u0dca\u200d\u0dcf\u0dba) \u0dc3\u0db3\u0dd4\u0dc0\u0dc0\u0dca\u200d\u0db1\u0dca \u0db8\u0dcf \u0dc3\u0dd2\u0dcf\u0d82\u0dc4\u0dca\u200d \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 \u0da2\u0d9c\u0dad\u0dca \u0db8\u0db1\u0dd4\u0dc0\u0dca\u200d\u0dbb\u0dca\u0dc3 \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 (\u0d86\u0da0\u0dcf\u0dbb\u0dca\u0dba) \u0db1\u0db1\u0dca\u0dcf\u0db1 \u0db8\u0dd2\u0db1\u0dbd\u0d9c\u0dbd \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 (\u0dc0\u0dc0\u0dca\u200d\u0dcf\u0dba) \u0d89\u0dc1\u0dbd\u0dba\u0dd2\u0dba\u0dad\u0db8\u0dca\u0db6\u0dd2 \u0dc3\u0dd2\u0dbb\u0dd2\u0db1\u0dcf\u0dad\u0dca \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf \u0d9c\u0dd4\u0dc0 (\u0dc0\u0dc0\u0dca\u200d\u0dcf\u0dba) \u0da2\u0db1\u0d9a \u0dc1\u0dc3\u0dda\u0db1\u0dcf \u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dca\u200d\u0dad\u0dcf\n\n12. \u0dc0\u0dc0\u0dc0\u0dc5\u0db3, \u0dc0\u0dcf\u0dab\u0dd2\u0da2, \u0d86\u0dc4\u0dc3\u0dcf\u0dbb \u0dc3\u0dd4\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dad\u0dcf \u0dca\u0dc4\u0dc3 \u0dca\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dbb \u0dca\u0dcf\u0dc0\u0dbb\u0dca\u0db0\u0dcf\u0db1 \u0d9a \u0dba\u0dd4\u0dd4\u0dbb\n\n\u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dcf\u0dc1\u0dca \u0d8b\u0dba \u0d8b\u0db4\u0dc0 \u0dc1\u0dca\u0d9a \u0d9a\u0dcf\u0dbb\u0d9a \u0dca\u0db7\u0dcf\u0dc0"
  },
