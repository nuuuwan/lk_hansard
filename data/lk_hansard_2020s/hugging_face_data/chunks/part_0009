    "chunk_text": "\u0d85\u0dc1\u0dda \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0db4\u0dad\u0dca\u0dad \u0dc1\u0dc0\u0dbd\u0ddc \u0db8\u0ddc\u0dc3\u0dba\u0d9a\u0dca\u0dc0\u0dad\u0dca\u0dad \u0db1\u0dd0\u0dad\u0dd2\u0dc0\u0dc0 \u0d87\u0dad\u0dd2\u0dc0. \u0d85\u0dc1\u0dda \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0db4\u0dad\u0dca\u0dad \u0dc0\u0dd4\u0dab\u0dd4 \u0dc1\u0db8\u0ddc\u0dc1\u0dc4\u0ddc\u0dc1\u0dad\u0dca\u0dad \u0dc3\u0da7\u0db8 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba \u0dca\u0dad\u0dca\u0dad\u0dc3\u0ddc\u0dc4 \u0d9a\u0dc1\u0d94\u0dca \u0d85\u0db4 undermine \u0d9a\u0dbb\u0dda\u0db1 \u0d85\u0db4 \u0d85\u0dc0\u0dad\u0d9a\u0dca\u0dc1\u0dc3\u0dca\u0dbb\u0dd4 \u0d9a\u0dbb\u0dda\u0db1 \u0d85\u0db4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0da0\u0dd2\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a\u0dca \u0dc3\u0db8\u0ddc\u0da2\u0d9c\u0dad \u0d9a\u0dbb\u0dda\u0db1. \u0d94\u0dc0\u0dd4\u0dda \u0d92\u0d9a \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dc0\u0dbb\u0dab \u0d9a\u0ddc\u0dbd\u0dc1 \u0dad\u0dca\u0dad \u0d9a\u0dbb\u0dda\u0db1 \u0dca\u0dad\u0dca\u0dad\u0dc3\u0ddc\u0dc4 \u0d9a\u0d94\u0ddc. \u0db1\u0db8\u0dd4\u0dad\u0dca\u0dad \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0dda \u0da2\u0db1\u0dad\u0ddc\u0dc0 \u0d92\u0d9a \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dca\u0dad\u0dc1\u0dad\u0dca\u0dad \u0db1\u0dd0\u0dc4\u0dd0. \u0d92\u0d9a \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dca\u0dad\u0dc1\u0dad\u0dca\u0dad \u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0db1\u0dd2\u0dc3\u0ddc \u0dad\u0db8\u0dba\u0dd2 \u0db4\u0ddc\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0dca\u0dda\u0dd4 \u0db8\u0dda\u0dd3 \u0db0\u0dd4\u0dbb 159\u0d9a\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0dc1\u0db8\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dda\u0db1 \u0d85\u0db4\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0ddc\u0dc0 \u0dbd\u0dd0\u0dc0\u0dc1\u0dab\u0dca\u0da9. \u0d92 \u0db4\u0ddc\u0da9\u0db8 \u0d89\u0dc1\u0d9c\u0db1 \u0d9c\u0dda\u0dc1\u0dda \u0db1\u0dd0\u0dad\u0dd2\u0dc0\u0dc0 \u0d85\u0dd4\u0db8 \u0dad\u0dbb\u0dd2\u0dba\u0dda \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0db4\u0dad\u0dca\u0dad \u0dc0\u0dd4\u0dab\u0ddc\u0da7 \u0db4\u0dc3\u0dd4\u0dc0\u0dc0\u0dad\u0dca\u0dad \u0da2\u0db1\u0dad\u0ddc\u0dc0 \u0dca\u0d9c\u0dda\u0dc0\u0db1 \u0dc1\u0db8\u0dca \u0db4\u0ddc\u0da9\u0db8 \u0dc4\u0dbb\u0dd2\u0dba\u0da7 \u0d89\u0dc1\u0d9c\u0db1 \u0d9c\u0dda\u0db1 \u0db6\u0dd0\u0dbb\u0dd4\u0dc0 \u0dc1\u0db8\u0dca \u0d85\u0db4\u0dbb\u0dd2\u0dab\u0dad \u0dc1\u0dda \u0db4\u0ddc\u0dbd\u0db1\u0dc1 \u0dc1\u0dba\u0dc1\u0daf\u0db1 \u0d91\u0d9a \u0d9c\u0dd0\u0db1 \u0d85\u0db4\u0dd2 \u0d87\u0dad\u0dca\u0dad\u0dad\u0da7\u0db8 \u0d9a\u0db1\u0d9c\u0ddc\u0da7\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc.\n\n\u0dc4\u0dd0\u0db8 \u0daf\u0dbb\u0dd4\u0dc1\u0dc0\u0d9a\u0dca\u0db8 \u0dc4\u0dd0\u0db8 \u0db4\u0dd4\u0dda\u0d9c\u0dbd\u0dc1\u0dba\u0d9a\u0dca\u0db8 \u0dc4\u0dd0\u0db8 \u0dad\u0dbb\u0dd4\u0dab \u0dad\u0dbb\u0dd4\u0dab\u0dd2\u0dba\u0d9a\u0dca\u0db8 \u0d9a\u0dd2\u0dc3\u0db8 \u0dc0\u0dd2\u0dc1\u0da7\u0d9a \u0dc4\u0dd2\u0dad\u0dda\u0db1 \u0d95\u0db1\u0dd1 \u0db1\u0dd0\u0dc4\u0dd0 ''\u0db8\u0da7 \u0dc1\u0db8\u0dca\u0d9a miss \u0dc0\u0dd4\u0dab\u0ddc \u0db8\u0da7 \u0dc1\u0db8\u0dca chance \u0d91\u0d9a \u0d85\u0dc4\u0dd2\u0dd2\u0dba \u0dc0\u0dd4\u0dab\u0ddc \u0d92 \u0db1\u0dd2\u0dc3\u0ddc \u0db8\u0da7 \u0d85\u0db1\u0ddc\u0d9c\u0dad\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0'' \u0d9a\u0dd2\u0dba\u0dbd\u0ddc. \u0d91\u0dc1\u0dc4\u0db8 \u0dc4\u0dd2\u0dad\u0dda\u0db1 \u0d85\u0db4\u0dd2 \u0d89\u0da9 \u0dad\u0db6\u0dda\u0dc1\u0dda \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0db1\u0dd2\u0dc3\u0ddc \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \"lifelong learning\" \u0d9a\u0dd2\u0dba\u0db1 concept \u0d91\u0d9a\u0dad\u0dca\u0dad \u0d91\u0d9a\u0dca\u0d9a \u0daf\u0dd4\u0dbb\u0dc3\u0dca\u0dae \u0d85\u0dd9\u0dba\u0ddc\u0db4\u0db1\u0dba \u0dc0\u0dd0\u0da9\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0d85\u0dd9\u0dba\u0ddc\u0db4\u0db1\u0dba \u0d91\u0dc1\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0dad\u0db1\u0db8\u0dca \u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0dc1\u0dbb\u0dca\u0d9b\u0dd3\u0dba \u0d85\u0dd9\u0dba\u0ddc\u0db4\u0db1\u0dba \u0db1\u0dd0\u0dad\u0dd2\u0dc0\u0dc0 \u0dad\u0db8\u0dda\u0dc1 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0ddc\u0dc0 \u0dd4\u0dc5\u0dd2\u0dda \u0d92 \u0daf\u0dd0\u0dc0\u0dd9\u0db8 \u0d91\u0d9a\u0dd4 \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d85\u0d9c\u0dba\u0d9a\u0dca \u0dc1\u0daf\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0d9c\u0dd0\u0db1 \u0dc3\u0ddc\u0d9a\u0da0\u0dca\u0da1\u0ddc \u0d9a\u0dbb\u0dda\u0dc1\u0dda. \u0db8\u0ddc \u0dc4\u0dd2\u0dad\u0dda\u0dc1\u0dda \u0d92\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dc3\u0db8\u0dca\u0db4\u0dda\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba. \u0d92\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0db1\u0dd6\u0dad\u0db1 \u0dc1\u0dbd\u0ddd\u0d9a\u0dc1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0d9a\u0dae\u0ddc\u0db1\u0ddc\u0dba\u0d9a\u0dd4\u0db8\u0db1\u0dd2.\n\n\u0d85\u0dc1\u0dda qualifications \u0d9c\u0dd0\u0db1 \u0dc1\u0dc4\u0ddc\u0dba\u0dda\u0db1 \u0db6\u0dbd\u0dda\u0db1. \u0d9a\u0db8\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0db8\u0dca \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba\u0da7 \u0d9a\u0dbb\u0dda\u0db1 \u0dc1\u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0d9a\u0dca \u0db1\u0dd0\u0dad\u0dca\u0dad\u0db1\u0db8\u0dca \u0d92 \u0dc1\u0d9c\u0ddc\u0dbd\u0dca\u0dbd\u0dda\u0dc1 \u0d9a\u0ddc\u0dbb\u0dca\u0dba\u0dc0\u0ddc\u0dbb\u0dba \u0dc1\u0db8\u0dca\u0d9a\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0ddc \u0d92 \u0dc1\u0d9c\u0ddc\u0dbd\u0dca\u0dbd\u0dda \u0dc4\u0dd2\u0dad\u0db1\u0dc0\u0ddc \u0db1\u0db8\u0dca \u0d91\u0dc1\u0dc4\u0db8 \u0d9a\u0d94\u0ddc\u0da7 \u0d9a\u0db8\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0d9c\u0dda\u0db1\u0ddc \u0dc3\u0dba\u0dbd\u0dd4 \u0dad\u0dd3\u0dda\u0daf\u0dd4 \u0dad\u0dd3\u0dbb\u0dab \u0d9c\u0dda\u0dc1\u0dda \u0dba\u0db8\u0dca\u0d9a\u0dd2\u0dc3 \u0dc1\u0dda \u0db4\u0ddc\u0dbd\u0db1 \u0dc3\u0dca\u0dae\u0ddc\u0dc0\u0dbb\u0dba\u0d9a \u0d89\u0db3\u0dc1\u0d9c\u0db1.\n\n\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0d9a\u0dae\u0ddc\u0db1\u0ddc\u0dba\u0d9a\u0dd4\u0db8\u0db1\u0dd2 \u0db4\u0ddc\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0dca\u0dda\u0dd4\u0dc0\u0d9a\u0dca \u0dd4\u0d94 \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0d89\u0db3\u0dbd\u0ddc \u0dc4\u0dbb\u0dd2 \u0dba\u0dda\u0dc1\u0dda \u0db1\u0dd0\u0dc4\u0dd0. \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0da7 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0dbb\u0da7 \u0d9c\u0dd0\u0db1 \u0dc4\u0dd2\u0dad\u0dbd\u0ddc \u0da2\u0db1\u0dad\u0ddc\u0dc0 \u0d9c\u0dd0\u0db1 \u0dc4\u0dd2\u0dad\u0dbd\u0ddc \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca\u0dad \u0dc1\u0dc0\u0dda\u0db1 \u0db6\u0dd0\u0dc4\u0dd0. \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba\u0d9a\u0dd4\u0dad\u0dca\u0dad \u0d85\u0dc0 \u0dba\u0dba\u0dd2. \u0d87\u0dad\u0dca\u0dad\u0dad \u0dc0 \u0dc1\u0dba\u0dda\u0db8 \u0db4\u0ddc\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0dca\u0dda\u0dd4\u0dc0 \u0dd4\u0d94 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0ddc\u0dbb\u0dca\u0dba\u0dc0\u0ddc\u0dbb\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc0\u0dc1\u0db6\u0dda\u0dc1\u0dda \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba\u0da7. \u0d91\u0dc1\u0dc4\u0db8 \u0db1\u0db8\u0dca \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dc1 \u0d9a\u0ddc\u0dbb\u0dca\u0dba\u0dc0\u0ddc\u0dbb\u0dba \u0d85\u0dad\u0dd2\u0dc0 \u0dba\u0dd2\u0dda\u0db8 \u0dc0\u0dd0\u0daf\u0d9c\u0dad\u0dca\u0dad. \u0db1\u0db8\u0dd4\u0dad\u0dca\u0dad \u0daf\u0dd0\u0dc0\u0dd9\u0dad\u0dca\u0dad \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dd0\u0dad\u0dca\u0dad\u0dc1\u0dad\u0dca\u0dad \u0d86\u0dc3\u0db1 \u0dc4\u0dd2\u0dc3\u0dca. \u0d92\u0d9a\u0da7 \u0d9a\u0db8\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0."
