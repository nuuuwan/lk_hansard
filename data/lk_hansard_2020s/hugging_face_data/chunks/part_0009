    "chunk_text": "\u0d92 \u0dc0\u0dcf\u0db8\u0dda\u0db8 \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0d9a\u0dca\u0db8\u0dc2\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0db8 \u0db1\u0dca\u0dad \u0db8\u0dda \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0db8\u0dda \u0dc3\u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dcf\u0dda\u0db8\u0d9a\u0dc0 - detailed - \u0db8\u0dad\u0dcf\u0dbb\u0dd4\u0dbb\u0dd4 \u0daf\u0dd3\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf, \u0dc0\u0dd2 \u0daf\u0dda \u0d9a\u0dbb\u0db4\u0dd4 \u0d9a\u0dca\u0db8\u0dc2\u0dca\u0dad\u0dca\u200d\u0dbb \u0db8\u0db8\u0dcf\u0db1\u0dc0\u0dcf\u0daf, \u0db8\u0d9a\u0dcf\u0dd2 \u0d86\u0d9a\u0dbb\u0db8 \u0db1\u0dca\u0dad\u0daf \u0dc0\u0dd2 \u0daf\u0dda \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad, \u0d92 \u0dc0\u0dd2 \u0daf\u0dda \u0d85\u0dd4 \u0dc0\u0dd0\u0da9\u0dd2 \u0db8\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db8\u0d9a\u0dcf\u0db8\u0dc4\u0dcf\u0db8\u0daf \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a \u0d9c\u0dd0\u0db1. \u0db8\u0db8 \u0dc0\u0dd2 \u0db8 \u0dca\u0dc2 \u0d85\u0dc0\u0db0\u0dcf\u0db1 \u0db8 \u0dcf\u0dd4\u0daf \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dd2, \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1 , \u0db8\u0dc3\u0dde \u0dba \u0dc3\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0d9a\u0dd2 \u0db1 \u0d9a\u0dca\u0db8\u0dc2\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dbd\u0da7. \u0db8\u0dda \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0db8\u0dda\u0db8 \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0db8\u0dc0\u0db1\u0dc0\u0dcf, \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dd4\u0db8\u0db6\u0dc3\u0dcf\u0db0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1\u0dca\u0dad - welfare programmes - \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0db8 \u0db1\u0dca\u0dad \u0db4\u0dd4\u0db8\u0dba \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0db8\u0daf\u0dca \u0db8\u0dda \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0dc0\u0da7 \u0d85\u0daf\u0dcf \u0d9a\u0dcf\u0dbd \u0db4\u0dba\u0dbb\u0da0\u0dca\u0db8\u0dda\u0daf\u0db8\u0dda \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc0\u0dd2 \u0daf\u0dda 2023 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf\u0da7 \u0dc3\u0dcf\u0db8\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dc0 \u0dc3\u0dd2 \u0da7 30\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0d85\u0dd4 \u0db8\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0db6\u0dc0. \u0d92 \u0d9a\u0dd2 \u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad, \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0dd4\u0daf\u0db1\u0dca\u0dad \u0db8\u0dc0\u0db1\u0dd4\u0db8\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dd4\u0db8\u0db6\u0dc3\u0dcf\u0db0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1\u0dca\u0dad\u0dc0\u0dbd\u0da7 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc0\u0dd2 \u0daf\u0db8 \u0dc3\u0dd2 \u0da7 30 \u0d9a\u0dd2\u0db1\u0dca\u0dad \u0d85\u0dd4 \u0db8\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0d8a \u0d9f\u0da7 \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0d85\u0da0\u0dca\u0db1 \u0db8\u0db4\u0dcf\u0dda \u0dc3\u0db3\u0dc4\u0dcf \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc0\u0dd2 \u0daf\u0db8 \u0dc3\u0dd2 \u0da7 70\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0d85\u0dd4 \u0d9a\u0dbb\u0dbd\u0dcf\n\n\u0db8\u0db8 \u0db8\u0dda \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0d85\u0dbb\u0dca\u0dbd\u0db6\u0dd4\u0daf \u0dc3\u0db8 \u0d9c\u0dd0\u0db1 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0db8\u0db1\u0dcf\u0db8\u0dc0\u0dd2. \u0d85\u0dbb\u0dca\u0dbd\u0db6\u0dd4\u0daf\u0db8 \u0db1\u0dca\u0dad \u0d91\u0dc5\u0dd2 \u0da7 \u0d91\u0db1\u0dca\u0dad\u0db1 \u0d85\u0db4\u0dd2 \u0d9c\u0dda\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0dc0\u0dbd\u0daf\u0dd3\u0dda, \u0db8\u0dda \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0db8\u0dda \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0dc0\u0dbd\u0daf\u0dd3\u0dda, \u0d85\u0db4\u0dd2 achievements \u0dc4\u0dd0\u0dba\u0da7 \u0da7 \u0db8\u0db4\u0db1\u0dca\u0dad\u0dc0\u0dcf \u0daf\u0dd3 \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0db8\u0daf\u0dca\u0dc0\u0dbd\u0dca\u0dc0\u0dbd, \u0d92 \u0daf\u0dda\u0dad \u0d87\u0dd4\u0db8 \u0dca\u0dda \u0dad\u0dd2\u0db8\u0db6\u0db1 \u0d9a\u0dad\u0db1\u0dca\u0dad\u0daf\u0dbb \u0dad\u0db8\u0dd2 \u0d85\u0db8\u0db4\u0dca \u0dbb\u0db8\u0da7\u0dca \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0db8\u0d9c\u0dc0\u0db1 \u0dbd\u0daf \u0dc0\u0db1\u0dca\u0dad\u0daf\u0dd2 ; \u0db8\u0dda \u0d85\u0dbb\u0dca\u0dbd\u0db6\u0dd4\u0daf\u0db8 \u0db1\u0dca\u0dad \u0db8\u0d9c\u0dcf\u0da9 \u0d92\u0db8\u0da7 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0dad\u0db8\u0db1\u0dca\u0dad\u0db8\u0dda \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba\u0d9a\u0dbb\u0dab \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0d9c\u0dc0\u0db1 \u0dbd\u0daf \u0d85\u0dad\u0dd2\u0dc0\u0dd2 \u0dcf\u0dbd \u0db8\u0dd2\u0dbd."
  },
