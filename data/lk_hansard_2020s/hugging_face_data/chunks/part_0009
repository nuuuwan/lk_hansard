    "chunk_text": "\u0d85\u0dc1\u0dda \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dc1\u0dda \u0dc0\u0dd2 \u0dcf\u0dbd \u0dc0\u0dd2\u0dc2\u0db8\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0dd9\u0db1\u0dc0\u0dcf 2022\u0daf\u0dd3 \u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0db4\u0dda\u0db0\u0dad\u0dd2\u0dc1\u0dda 10,126\u0d9a\u0dca \u0dc0\u0db1 \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0d85\u0dad\u0dd4\u0db8\u0dcf\u0dbb\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0dc3\u0dd4\u0db1\u0dca 50\u0da7 \u0d85\u0da9\u0dd4 \u0db4\u0dcf\u0dc3\u0dbd\u0dca 1,472\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0dd9\u0db1\u0dc0\u0dcf \u0d91\u0dba \u0dc3\u0dd2\u0dba\u0dba\u0da7 14 5\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0dc3\u0dd2\u0dc3\u0dd4\u0db1\u0dca 200\u0da7 \u0d85\u0da9\u0dd4 \u0db4\u0dcf\u0dc3\u0dbd\u0dca 5,024\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0dd9\u0db1\u0dc0\u0dcf \u0d91\u0dba \u0dc3\u0dd2\u0dba\u0dba\u0da7 51\u0d9a\u0dca \u0dc0\u0dcf\u0dc1\u0dda \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db8\u0da7\u0dca\u0da7\u0dc1\u0db8\u0dca \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0dad\u0dd2\u0dc1\u0dd9\u0db1\u0dca\u0dc1\u0db1\u0dca 296\u0d9a\u0dca \u0db4\u0db8\u0dab\u0dba\u0dd2 \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc0\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0daf\u0dba\u0d9a\u0dca \u0dc1\u0db1 \u0dc1\u0dc0\u0dba\u0dd2, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dc1\u0dda \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dca \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0db1 \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dba \u0dc3\u0db8\u0dca\u0dd9\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0d9a\u0dae\u0dcf \u0d9a\u0db8\u0dcf \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 76\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0db1\u0dc1\u0dc3\u0dda \u0dc1\u0db8\u0dca \u0dbb\u0da7 \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0d9a\u0dbb\u0db4\u0dd4 \u0dc1\u0dda \u0db4\u0dcf\u0dbd\u0db1 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d9a\u0dbb\u0db4\u0dd4 \u0dc3\u0dcf\u0db0\u0db1\u0dd3\u0dba \u0dc1\u0dda\u0dc0\u0dbd\u0dca \u0d85\u0dad\u0dbb \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0db1 \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dba \u0dc3\u0db8\u0dca\u0dd9\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0d9a\u0dd2\u0dc4\u0dd2\u0db4 \u0dc0\u0dad\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0db4\u0dd4\u0db1 \u0db4\u0dd4\u0db1\u0dcf \u0db8\u0dad\u0d9a\u0dca \u0d9a\u0db8\u0dcf \u0dc4\u0dd0\u0dd9\u0dd0\u0dba\u0dd2 \u0d92 \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0db1 \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dba \u0dc0\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0daf\u0dba\u0d9a\u0dca \u0dc1\u0db1 \u0dc1\u0dc0\u0dba\u0dd2 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0dd9\u0dc0\u0dad\u0dca, \u0d91\u0dba \u0daf\u0dd2\u0db1\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d85\u0dbb\u0d9c\u0db8 \u0d9a\u0db8 \u0dd9\u0dc0\u0dad\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0da7 \u0d85\u0db8\u0dad\u0d9a \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0dd9\u0db1\u0dc0\u0dcf\n\n\u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0db1 \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dba \u0d87\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0db8\u0dda \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0d85\u0db4\u0da7 \u0d85\u0dad\u0dc4\u0dd0\u0dbb\u0dd4\u0dab\u0dd4, \u0d85\u0db4\u0dd2 \u0d9a\u0dae\u0dcf \u0dc1\u0db1 \u0d9a\u0dbb\u0db1 \u0dc1\u0d9a \u0da7\u0dc3\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0dd9\u0db1\u0dc0\u0dcf \u0db8\u0db8 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dcf \u0dc3\u0dc4 \u0db8\u0db8\u0dcf \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba\u0da7 \u0d85\u0dba\u0dad\u0dca \u0d91\u0d9a \u0dc1\u0d9a \u0da7\u0dc3\u0d9a\u0dca \u0dc0\u0db1 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0db8\u0db8\u0dcf\u0dc0\u0dd2\u0dba \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dba \u0dc3\u0db8\u0dca\u0dd9\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0d85\u0db4 \u0d9a\u0dae\u0dcf \u0d9a\u0db8 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf\u0dc0 \u0dad\u0dd2\u0dc1\u0dd9\u0db1\u0dc0\u0dcf \u0d92 \u0dc3\u0db8\u0dca\u0dd9\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb \u0db1\u0db1 \u0dc1\u0d9c \u0da9\u0d9a\u0dca\n\n947 948\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0dc0\n\n\u0dad\u0dd2\u0dc1\u0dd9\u0db1\u0dc0\u0dcf \u0dc1\u0db8\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0db1\u0dc1\u0dc3\u0dda \u0d85\u0dad\u0dc4\u0dd0\u0dbb\u0dd4\u0dab\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba\u0d9a\u0dca \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0db1\u0dc1\u0dc3\u0dda\u0db8 \u0dc1\u0db8\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba\u0da7 \u0d9a\u0dd0\u0dd2\u0dba\u0db1\u0da7\u0dca \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dca \u0d89\u0db3\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0dc4\u0dd0\u0dd9\u0dd0\u0dba\u0dd2, \u0dbb\u0dc1\u0da7\u0dca \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dc4 \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dcf\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2 \u0dc1\u0d9a \u0da7\u0dc3\u0d9a\u0dca \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dcf \u0dc3\u0dc4 \u0db8\u0db8\u0dcf \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba \u0dba\u0da7\u0dc1\u0dad\u0dca \u0dd4\u0dbd\u0dca \u0db8\u0db8\u0dcf\u0dc0\u0dd2\u0dba \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0dd9\u0db3 \u0dc1\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0db1\u0dc1\u0dc3\u0dda \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dbb\u0dc1\u0d9c\u0db1 \u0d86\u0dc0\u0dcf \u0db1\u0dd4\u0dad\u0dca, \u0d91\u0dc4\u0dd2\u0dad\u0dca \u0d85\u0da9\u0dd4\u0db4\u0dcf\u0da9\u0dd4 \u0dc1\u0d9c \u0da9\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0dd9\u0db1\u0dc0\u0dcf \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba\u0da7 \u0dbd\u0d9a\u0dca \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0dc0\u0dd2 \u0dcf\u0dbd \u0dc3\u0d82\u0d9b\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0d91\u0dc4\u0dd2 \u0dad\u0dd2\u0dc1\u0dd9\u0db1\u0dc0\u0dcf \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0db1\u0dca \u0dc3\u0dd2\u0da7 \u0db4\u0dc4 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dd6 \u0daf\u0dbb\u0dd4\u0dc0\u0dcf\u0da7 \u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0dd4\u0dbd\u0dca \u0db8\u0db8\u0dcf\u0dc0\u0dd2\u0dba \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1\u0dba\u0d9a\u0dca \u0dbd\u0dd9\u0dcf \u0daf\u0dd3\u0db8 \u0dbb\u0da2\u0dc1\u0dda \u0db8\u0dd6\u0dbd\u0dd2\u0d9a\u0db8 \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u0dd9\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d85\u0dc1\u0dda \u0dc1\u0dba\u0ddd\u0da2\u0db1\u0dcf \u0d87\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0db8\u0dda \u0d85\u0db4\u0dd2 \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0dd9\u0db1\u0dc0\u0dcf"
