    "chunk_text": "\u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d9a\u0ddc\u0dbd\u0dc1 \u0da2\u0db1\u0dad\u0ddc \u0dc0\u0dd2\u0db8\u0dd4\u0d9a\u0dca\u0dad\u0dd2\u0dc0 \u0dc1\u0db4\u0dbb\u0db8\u0dd4\u0dab\u0dad\u0dca\u0dad \u0dc0\u0dd2\u0daf\u0dd4\u0dd2 \u0db6\u0dd2\u0dbd \u0d85\u0dd4 \u0d9a\u0dbb\u0dda\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0ddc \u0dca\u0dda\u0dc1\u0d9d\u0ddd\u0dc2\u0dab \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dad\u0dc0\u0dd6\u0dc0\u0ddc \u0dc0\u0dd4\u0dbb \u0db6\u0dd2\u0dbd \u0d85\u0dd4 \u0d9a\u0dbb\u0dda\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0ddc \u0dca\u0dda\u0dc1\u0d9d\u0ddd\u0dc2\u0dab \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dad\u0dc0\u0dd6\u0dc0\u0ddc PAYE Tax \u0d85\u0dd4 \u0d9a\u0dbb\u0dda\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0ddc \u0dca\u0dda\u0dc1\u0d9d\u0ddd\u0dc2\u0dab \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dad\u0dc0\u0dd6\u0dc0\u0ddc VAT \u0d85\u0dd4 \u0d9a\u0dbb\u0dda\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0ddc \u0dca\u0dda\u0dc1\u0d9d\u0ddd\u0dc2\u0dab \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dad\u0dc0\u0dd6\u0dc0\u0ddc. \u0daf\u0dd0\u0dda \u0d85\u0db4\u0da7 \u0d86\u0dbb\u0dd2\u0d82\u0da0\u0dd2\u0dba\u0dd2 \u0dc1\u0da9\u0ddc\u0dbd\u0dbb\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 12.5\u0d9a\u0dca \u0dc1\u0dc0\u0da0\u0dca\u0da0 \u0da2\u0ddc\u0dad\u0dba\u0dda\u0dad\u0dbb \u0dc3\u0dca\u0dc0\u0dc0\u0dad\u0dbb \u0db6\u0dd0\u0db3\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dc0\u0dd2\u0dda \u0dc1\u0da9\u0ddc\u0dbd\u0dbb\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 3.2\u0d9a haircut \u0d91\u0d9a\u0d9a\u0dca \u0db4\u0db8\u0dab\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd3 \u0dad\u0dd2\u0dc0\u0dc1\u0db6\u0db1\u0dc0\u0ddc \u0d9a\u0dd2\u0dba\u0dbd\u0ddc. \u0d91\u0dad\u0dc1\u0d9a\u0ddc\u0da7 \u0dbb\u0db1\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dd2\u0d82\u0dc4 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dda \u0daf\u0ddc\u0db4\u0dd4 \u0daf\u0dbb\u0daf\u0dac\u0dd4 \u0db6\u0daf\u0dd4 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc0\u0db4\u0dad\u0dca\u0dad\u0dad\u0dd2\u0dc0\u0dba \u0db1\u0dd2\u0dc3\u0ddc \u0d85\u0dc1\u0dda\u0d9a\u0dca\u0dd2\u0dad \u0db6\u0daf\u0dd4 \u0d86\u0daf\u0ddc\u0dba\u0db8\u0da7 \u0dc0\u0da9\u0ddc \u0dc0\u0dd0\u0da9\u0dd2 \u0dca\u200d\u0dbb\u0db8\u0ddc\u0dab\u0dba\u0d9a\u0dd2\u0dda \u0d92 \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba\u0da7 2027 \u0dc1\u0dc0\u0dda\u0dd3\u0db8 \u0d9c\u0dd2\u0dc1\u0dba\u0ddc\u0dad\u0dca\u0dad \u0dc1\u0db8\u0dba \u0dc1\u0da9\u0ddc\u0dbd\u0dbb\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 2\u0d9a\u0da7 \u0d85\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc. \u0d91\u0dc1\u0dc4\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0db4\u0dd4\u0dc1\u0dbb\u0ddd\u0d9a\u0dae\u0db1\u0dba \u0d9a\u0dbb\u0dbd\u0ddc \u0dad\u0dd2\u0dc0\u0dc1\u0db6\u0dda\u0dc1\u0dda. \u0d91\u0dad\u0dc1\u0d9a\u0ddc\u0da7 haircut \u0d91\u0d9a \u0dc3\u0dba\u0dba\u0da7 17\u0d9a\u0da7 \u0d85\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0ddc. \u0d91\u0dc1\u0dc4\u0db8 \u0db1\u0db8\u0dca \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0dda \u0da2\u0db1\u0dad\u0ddc\u0dc0\u0da7 \u0dbd\u0db6\u0ddc \u0daf\u0dd2\u0dba \u0dba\u0dd4\u0dd4 \u0dbd\u0db6\u0ddc \u0daf\u0dd2\u0dba \u0dc4\u0dd0\u0d9a\u0dd2 \u0dc3\u0dc4\u0db1 \u0dbd\u0db6\u0ddc \u0dd3\u0db8\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0dda\u0dd9\u0dc1\u0dba\u0dda \u0d92 \u0dc3\u0ddc\u0d9a\u0da0\u0dca\u0da1\u0ddc\u0dc0\u0dbd\u0dd3\u0db8 \u0da2\u0ddc\u0dad\u0dba\u0dda\u0dad\u0dbb \u0db8\u0dd6\u0dbd\u0dba \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd\u0dad\u0dca\u0dad \u0d91\u0d9a\u0dca\u0d9a \u0d9a\u0dae\u0ddc \u0d9a\u0d94\u0ddc \u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0d9a\u0dd2\u0dba\u0dda\u0db1.\n\n\u0d92 \u0dc0\u0ddc \u0dc1 \u0db8 \u0daf\u0dd0\u0dda \u0d92\u0dc1\u0d9c\u0ddc\u0dbd\u0dca\u0dbd\u0dda \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0ddc \u0dc0\u0dd2\u0daf\u0dd4\u0dd2 \u0db6\u0dd2\u0dbd \u0d85\u0dd4 \u0d9a\u0dbb\u0dda\u0db1 \u0db6\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0dbd\u0ddc. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0db8\u0ddc \u0daf\u0dda\u0db1\u0ddc \u0dad\u0dbb\u0db8\u0da7 \u0db8\u0dc4\u0da2\u0db1 \u0dca\u0db4\u0dc1\u0dba\u0ddd\u0d9c\u0dd2\u0dad\u0ddc \u0dc1\u0d9a\u0ddc\u0dd2\u0dba\u0dc3\u0db8 - PUCSL \u0d91\u0d9a - \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0ddc \u0dc3\u0dba\u0dba\u0da7 11\u0dad\u0dca\u0dad 23\u0dad\u0dca\u0dad \u0d85\u0dad\u0dbb \u0dca\u200d\u0dbb\u0db8\u0ddc\u0dab\u0dba\u0d9a\u0dd2\u0dda \u0dc0\u0dd2\u0daf\u0dd4\u0dd2 \u0db6\u0dd2\u0dbd \u0d85\u0dd4 \u0d9a\u0dd2\u0dad\u0dbb\u0dc1\u0db8\u0dca \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0ddc\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc0\u0dc1\u0db6\u0db1\u0dc0\u0ddc \u0d9a\u0dd2\u0dba\u0dbd\u0ddc. PUCSL \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dbd\u0dd2\u0d82\u0d9a\u0ddc \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db6\u0dbd \u0db8\u0dab\u0dca\u0da9\u0da9\u0dbd\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dda\u0db1 \u0d9a\u0dd0\u0db8\u0dad\u0dd2\u0dc0 \u0db1\u0dd0\u0dad\u0dca\u0dad\u0db1\u0db8\u0dca \u0dc1\u0db8\u0ddc\u0d9a\u0da7\u0daf PUCSL \u0d91\u0d9a\u0d9a\u0dca \u0dad\u0dd2\u0dc0\u0dc1\u0db6\u0dda\u0dc1\u0dda? \u0dc1\u0db8\u0ddc\u0d9a\u0da7\u0daf PUCSL \u0d91\u0d9a \u0db8\u0dc4 \u0da2\u0db1\u0dad\u0ddc\u0dc0\u0dc1 \u0db8\u0dad \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca \u0d9a\u0dbb\u0dda\u0dc1\u0dda? \u0d94\u0dc0\u0dd4\u0dda\u0dc1 \u0d85\u0db8\u0ddc\u0dbb\u0dd4\u0d9a\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0dc0\u0dc1\u0db6\u0ddd\u0dd9\u0dba\u0d9a\u0dca \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0d92 \u0dc1\u0dba\u0ddd\u0da2\u0db1\u0ddc \u0dca\u200d\u0dbb\u0dd2\u0dba\u0ddc\u0dad\u0dca\u0dad\u0db8\u0d9a \u0d9a\u0dd2\u0dad\u0dbb\u0dc1\u0db8\u0dca \u0db6\u0dbd\u0dba\u0d9a\u0dca \u0d92 \u0d85\u0dba\u0da7 \u0db1\u0dd0\u0dad\u0dca\u0dad\u0db1\u0db8\u0dca \u0dbd\u0dd2\u0d82\u0d9a\u0ddc \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db6\u0dbd \u0db8\u0dab\u0dca\u0da9\u0da9\u0dbd\u0dba\u0da7 \u0d85\u0dad\u0dca\u0dad\u0dad\u0dc1\u0db1\u0ddd\u0db8\u0dad\u0dd2\u0dc0\u0d9a \u0dc1\u0dbd\u0dc3 \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb\u0dda\u0db1 \u0d89\u0da9 \u0dd3\u0db8\u0dbd\u0ddc \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0db6\u0dbd\u0ddc\u0dc1\u0d9c\u0db1 \u0d89\u0dda\u0db1\u0dc0\u0ddc \u0db1\u0db8\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc1\u0db8\u0ddc\u0d9a\u0da7\u0daf? \u0d91\u0dc1\u0dc4\u0db8 \u0dc1\u0dda \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d9a\u0ddc\u0dbd\u0dc1 \u0d94\u0db6\u0dd4\u0db8\u0dda\u0dbd\u0ddc \u0d87\u0dc4\u0dd4\u0dc1 . \u0d91\u0dc1\u0dc4\u0db8 \u0dc1\u0dda\u0daf? \u0dc4\u0ddc\u0dbd\u0dca \u0dc1\u0db8\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dc1\u0da7\u0ddc\u0dda 20 000\u0d9a\u0dca \u0d86\u0db1\u0dba\u0db1\u0dba \u0d9a\u0dbb\u0dda\u0db1 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0d9a\u0dca \u0d95\u0db1\u0dd1 \u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0ddc \u0dc1\u0dda \u0d87\u0dc4\u0dd4\u0dc1 . \u0d89\u0dad\u0dd2\u0dc0\u0dda \u0d85\u0db4\u0dd2 \u0d85\u0dc4\u0db1\u0dc0\u0ddc PUCSL \u0d91\u0d9a \u0db8\u0dc4 \u0da2\u0db1\u0dad\u0ddc\u0dc0\u0dc1 \u0db1\u0dd2\u0dbb\u0dca\u0dc1\u0dda \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0dc0\u0dd2\u0daf\u0dba\u0ddc\u0dad\u0dca\u0dad\u0db8\u0d9a \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dc0\u0dd2\u0daf\u0dd4\u0dd2 \u0db6\u0dd2\u0dbd \u0d85\u0dd4 \u0d9a\u0dbb\u0dda\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0ddc \u0db1\u0db8\u0dca \u0d92\u0d9a \u0d9a\u0dbb\u0dda\u0db1 \u0dbd\u0dd2\u0d82\u0d9a\u0ddc \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db6\u0dbd \u0db8\u0dab\u0dca\u0da9\u0da9\u0dbd\u0dba \u0d89\u0da9 \u0dc1\u0daf\u0dda\u0dc1\u0dda \u0db1\u0dd0\u0dad\u0dca\u0dad\u0db1\u0db8\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0d9a\u0dca \u0dc1\u0db8\u0ddc\u0d9a\u0da7\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0ddc. \u0d92 \u0db1\u0dd2\u0dc3\u0ddc \u0d85\u0db4\u0dd2 \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0\u0dad\u0dca\u0dad \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc1 \u0dc3\u0dca\u0dae\u0ddc\u0dc0\u0dbb\u0dba \u0d85\u0dc4\u0dda\u0db1 \u0d9a\u0dd0\u0db8\u0dad\u0dd2\u0dc0\u0dba\u0dd2."
  },
