    "chunk_text": "\u0d85\u0db4\u0dd2 \u0dba\u0dc5\u0db1\u0dca \u0db3\u0daf\u0dd4 \u0d9c\u0dc5\u0db1 \u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u0db1 \u0dc1. \u0d86\u0dbd\u0dd2\u0db8\u0dd2\u0d9a \u0dbd\u0dd2\u0db8\u0db0\u0db1 \u0d9c\u0dc5\u0db1 \u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u0db1 \u0dc1. \u0db1\u0db8\u0dd4\u0dad\u0dca\u0dc0 \u0d92 \u0dc3\u0dca \u0dc4\u0dc1 \u0d85 \u0dba \u0d9a\u0dc1\u0dbd\u0dd2\u0db8\u0db8\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dc0\u0dad\u0dd2 \u0d9a\u0dca \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc1\u0db1\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dc0\u0dad\u0dd2 \u0d9a\u0dca \u0db8\u0dc5\u0dd4 \u0dc4\u0dc1 \u0db8\u0db0\u0dba \u0db4\u0dd2 \u0db8\u0dc1\u0db4 \u0dc1 \u0db1\u0dca \u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dad\u0dca\u0dc0\u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d85\u0dba \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2 \u0db4\u0dc5\u0dad\u0dca\u0dc0\u0dc1\u0dad\u0dca\u0dc0 \u0d89\u0dc3\u0dca\u0dad\u0dc3\u0dca\u0dbb\u0dc4 \u0db4\u0dd4\u0da7\u0dd4 \u0dbd \u0d89 \u0dc1\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0db1\u0dc1 \u0d9a\u0dc0\u0dd4\u0dd4\u0dc0 \u0dad\u0dca\u0dc0 \u0d92 \u0d9a\u0dc1\u0dbd\u0dc1 \u0d8b\u0db1\u0db1\u0dca\u0daf\u0dd4 \u0dc1 \u0dbd\u0dc1 \u0db1\u0dc5\u0dc4\u0dc5 \u0d9c\u0dd4\u0dc0 \u0d9a\u0dcf\u0dc1\u0db1\u0dc1 \u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc1\u0db1\u0dca\u0dad \u0d85\u0db8\u0dc1\u0dad\u0dba\u0dc1\u0dcf \u0da7\u0dc1\u0dad\u0dca\u0dc0 \u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0dda \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc1\u0db1\u0dca\u0dad\u0db4\u0dd4\u0dbb 50\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1. \u0d91\u0dd2\u0db1\u0dca IDB \u0d91\u0dc1\u0d9a\u0dca 34\u0d9a\u0dca \u0dc3\u0dca\u0dc4 \u0d89\u0dad\u0dd4\u0dd4\u0dc0 \u0da7\u0dd2\u0d9a \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc1\u0db1\u0dca\u0dad \u0d85\u0db8\u0dc1\u0dad\u0dba\u0dc1\u0dcf \u0da7\u0dc1\u0dad\u0dca\u0dc0 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1. \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0dc3\u0dca\u0dc5\u0dbd\u0db8\u0db8\u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0dad\u0dc1\u0dbb \u0db6\u0dd2 \u0d9a\u0da9\u0d9a\u0dca \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dc1\u0dda\u0dba \u0dc1 \u0db1\u0dca \u0d9c\u0dad\u0dca\u0dc0 \u0d91\u0db8 \u0d89\u0da9 \u0dbd \u0d9a\u0dd2\u0dc3\u0dd2\u0db8 \u0d85\u0dd2\u0dad\u0dd2 \u0d9a\u0dca \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc1\u0db1\u0dca\u0dad \u0d85\u0db8\u0dc1\u0dad\u0dba\u0dc1\u0dcf \u0da7 \u0db1\u0dc5\u0dad\u0dd4 \u0dad\u0db8\u0dd2 \u0d92 \u0dc1\u0dc1 \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc1\u0db1\u0dca\u0dad\u0db4\u0dd4\u0dbb \u0dc4\u0dba\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1 \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc1\u0db1\u0dca\u0dad\u0db4\u0dd4\u0dbb \u0dbd \u0d9a\u0dd2\u0dc3\u0dd2\u0db8 \u0d86\u0dba\u0dc1 \u0db8\u0d9a\u0dca \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc1\u0db1\u0dca\u0dad \u0d85\u0db8\u0dc1\u0dad\u0dba\u0dc1\u0dcf \u0da7 \u0d91\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dad\u0dca\u0dc0 \u0db1\u0dc5\u0dc4\u0dc5. \u0dc0\u0dd2 \u0dba\u0db8 \u0dc0\u0dd2\u0dad\u0dbb\u0dd2. \u0d92 \u0dc1\u0dc1 \u0da7\u0dd2\u0dad\u0dbd \u0db4\u0dc4\u0db8\u0d9a \u0dc4\u0dd2 \u0da7 \u0db1\u0dd2\u0dbd\u0dd2\u0db8\u0db8\u0dc1\u0db4 \u0d9a\u0dbb\u0dbd\u0dc1 \u0db1\u0dc5\u0dad\u0dd4 \u0d89\u0da9 \u0dbd \u0d85\u0dd2\u0dad\u0dd2 \u0dad\u0dca\u0dc0 \u0db1\u0dc5\u0dad\u0dd4 \u0dc1 \u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dca\u0dc0\u0dad \u0d9a\u0dbb\u0db1 \u0db1\u0dd2\u0dc3\u0dca\u0dc1 \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc1\u0db1\u0dca\u0dad\u0d9a\u0dd4\u0dc0 \u0db1\u0dca \u0d89\u0da9 \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0dad\u0db8 \u0dad\u0db8\u0db1\u0dca\u0da7 \u0db4\u0dd4\u0dc5\u0dd4 \u0db1\u0dca \u0d86\u0d9a\u0dc1\u0dbb\u0dc1 \u0db1\u0dca \u0db1\u0dd2\u0dc2\u0dad\u0db4\u0dc1\u0dba\u0db1 \u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dc1. \u0d92 \u0dc1\u0dc1\u0dda\u0db8 \u0dc3\u0dca\u0db8\u0dc4\u0dbb \u0d9a\u0dbd\u0dd2\u0db8\u0db8\u0dc1\u0db1\u0dca\u0dad\u0d9a\u0dd4\u0dc0 \u0db1\u0dca \u0dad\u0db8\u0db1\u0dca\u0dc1\u0dda \u0d89\u0da9 \u0dbd \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0dda\u0d9a \u0d91\u0db8 \u0dba\u0dc1\u0db4\u0dc1\u0dbb \u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd0 \u0db1\u0dd2\u0dc3\u0dca\u0dc1 \u0d85\u0dba \u0d85\u0dbd\u0dd2\u0db8\u0db6\u0dd4\u0dba \u0dbd\u0da7 \u0db8\u0dd4\u0dc4\u0dd4\u0db4 \u0daf\u0dd3\u0dbd\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1. \u0d89\u0dad\u0dd2\u0db1\u0dca \u0dc1 \u0d94\u0d9a\u0dca\u0dc1\u0d9a\u0ddd\u0db8 \u0d85\u0db8\u0dad\u0d9a \u0d9a\u0dbb\u0dbd\u0dc1 \u0dad\u0db8\u0dd2 \u0dbd\u0dd2\u0db8\u0dad\u0db8\u0dc1\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dad\u0db1 \u0d9c\u0dc5\u0db1 \u0dc1 \u0d85 \u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d8b\u0dad\u0dca\u0dc0\u0dc3\u0dca\u0dc1\u0dc4 \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d9c\u0dd4\u0dc0 \u0d9a\u0dcf\u0dc1\u0db1\u0dc1 \u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0d9a\u0dc1\u0dbd\u0dd2\u0db8\u0db8\u0dd3\u0dba \u0d9a\u0dbb\u0db4 \u0da7 \u0d9a\u0dd2\u0dc3\u0dd2\u0db8 \u0dc3\u0dca\u0dc5\u0dbd\u0dc5\u0dc3\u0dca\u0dad\u0db8\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd2\u0dbd\u0dc1 \u0db1\u0dc5\u0dc4\u0dc5.\n\n217 218\n\n\u0db4\u0dc1\u0dbd\u0dd2\u0db8\u0dda\u0dc1 \u0db1\u0dca\u0dad\u0dd4\n\n\u0d9a\u0dc1\u0dbd\u0dc1\u0db1\u0dca\u0dad\u0dbb \u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0dca\u0dad\u0dc1\u0dc3\u0dca\u0dad IMF review \u0d91\u0dc1\u0d9a\u0db1\u0dca review \u0d91\u0d9a\u0da7 \u0db1\u0dc1\u0d9a\u0dc1\u0da7, \u0d85\u0db4 \u0d85\u0dbb \u0db8\u0dd4\u0dda\u0db1\u0dca \u0dc3\u0dca \u0dc4\u0db1\u0dca \u0d9a\u0dd0 \u0dad\u0dc5\u0db1\u0da7 \u0d91\u0db1 \u0db3 \u0dbd\u0dcf\u0d9a\u0dc1\u0dc1\u0dda \u0db6\u0dd4\u0dda\u0db0\u0dd2\u0db8\u0dad\u0dca\u0dc0 \u0da2\u0db1\u0dad\u0dc1 \u0dba\u0db1\u0dca\u0db1 \u0dc1.\n\n\u0d92 \u0dc1\u0dc1\u0dda\u0db8 \u0dad\u0db8\u0dd2 \u0dc0\u0dd2\u0db1\u0dd2\u0db8 \u0d85\u0db1\u0dd4\u0db4\u0dc1\u0dad \u0db4\u0dc5\u0dad\u0dca\u0dc0\u0dc1\u0dad\u0db1\u0dca \u0d9c\u0dad\u0dca\u0dc0\u0dad\u0dad\u0dca\u0dc0, \u0db3\u0dc5\u0dcf\u0d9a\u0dd4 \u0d9a\u0dca\u0dc1\u0dc2\u0dad\u0dad\u0dca\u200d\u0dbb \u0db4\u0dc5\u0dad\u0dca\u0dc0\u0dc1\u0dad\u0db1\u0dca \u0d9c\u0dad\u0dca\u0dc0\u0dad\u0dad\u0dca\u0dc0, \u0d86\u0db1 \u0db1 \u0d85\u0db4\u0db1 \u0db1 \u0db4\u0dc5\u0dad\u0dca\u0dc0\u0dc1\u0dad\u0db1\u0dca \u0d9c\u0dad\u0dca\u0dc0\u0dad\u0dad\u0dca\u0dc0 \u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0dda \u0d86\u0dbd\u0dd2\u0db8\u0dd2\u0d9a \u0dad\u0dd4\u0dd0 \u0d85\u0db4\u0db1 \u0db1 \u0dbd\u0dd2\u0db8\u0db0\u0db1 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db8\u0daf\u0dd4\u0db8 \u0d86\u0dbd\u0dd2\u0db8\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dc0\u0dad\u0dd2 \u0dc1\u0db1\u0dc1\u0dc1 \u0dd2, \u0dc1 \u0d85 \u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dad\u0dca\u0dc0\u0db8\u0d9a \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0da9\u0dd4\u0d9a. \u0d85\u0db4\u0dd2 \u0dba\u0dc5\u0db1\u0dca \u0dc1 \u0dc3\u0dd2 \u0dbd\u0dca\u0dbd reverse \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d85 \u0dba\u0dd2. \u0db1 \u0dda\u0db3\u0dbb\u0dbd\u0dca \u0d86\u0dbd\u0dd2\u0db8\u0dd2\u0d9a \u0dc5\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1 \u0dd0\u0da7 \u0db4\u0dd2\u0db1\u0dca \u0d9c\u0dc3\u0dca\u0dc1 \u0dc1 \u0dc3\u0dd2 \u0dbd\u0dca\u0dbd \u0dc3\u0dca\u0dcf \u0dbd\u0dd2\u0db8\u0db0\u0db1 \u0d86\u0dbd\u0dd2\u0db8\u0dd2\u0d9a \u0dc5\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1 \u0dd0\u0d9a\u0da7 \u0dc1\u0d9c\u0dc1\u0db1\u0db1\u0dca\u0db1 \u0d85\u0db4\u0da7 \u0dc3\u0dd2\u0dda\u0db0 \u0dc1 \u0dbd\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1. \u0dc1 \u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0db8\u0dc1\u0dbd\u0dd2\u0db8\u0d9c \u0d9c\u0dc5\u0db1\u0dd3\u0db8 \u0dc1 \u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0db8\u0dc1\u0dbd\u0dd2\u0db8\u0d9c \u0dc3\u0dca\u0dcf\u0dc0\u0dd2\u0db0\u0dc1\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc1 \u0dc1\u0da7 \u0d85 \u0dba \u0d9a\u0dbb\u0db1 \u0dc0\u0dd2 \u0dad\u0dc1\u0dbd\u0dca\u0dc2\u0db4 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dad\u0db8\u0dd2 \u0d9c\u0dd4\u0dc0 \u0d9a\u0dcf\u0dc1\u0db1\u0dc1 \u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dc1 \u0dc1 \u0db1\u0dc1\u0d9a\u0dc1\u0da7 \u0d85\u0db8\u0dc1\u0dad\u0dba \u0dd4\u0dc0 \u0dc3\u0dd2 \u0dbd\u0dd4\u0dc1\u0dba\u0db1\u0dc1\u0db8 \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0d89\u0db1\u0dca\u0dc1\u0db1\u0dca."
