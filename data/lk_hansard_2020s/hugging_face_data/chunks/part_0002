    "chunk_text": "\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0dc3\u0dcf\u0da2\u0dca\u200d\u200d \u0dc1\u0dc3\u0dca\u0dc0\u0db4\u0da7 \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dca \u0da7\u0dd0\u0db1\u0dca \u0db1\u0dad\u0dc3 \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc3\u0dcf\u0da2\u0dca\u200d\u200d \u0dc1\u0dc3\u0dca\u0dc0\u0db4\u0da7 \u0d85\u0dbd\u0dd4\u0dad\u0dd2\u0db1\u0dca \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca\u0db8 \u0db1\u0dd0\u0dad\u0dd2 \u0dad\u0dc3\u0db8\u0dca. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0dad\u0db8\u0dd2 , 2016 \u0d89\u0db3\u0dbd\u0dcf \u0dc3\u0dcf\u0da2\u0dca\u200d\u200d \u0dc1\u0dc3\u0dca\u0dc0\u0db4\u0da7 \u0d85\u0dbd\u0dd4\u0dad\u0dd2\u0db1\u0dca \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0d85\u0db4\u0da7 \u0dd6\u0dbb\u0dca\u0dab \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0d9a \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc3\u0db1\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u200d\u0dbb\u0db8\u0dc3\u0dd2\u0dcf\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0db4\u0dcf \u0d91\u0da7\u0dcf \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dc3\u0db4\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0db4\u0da7 \u0d9a\u0dd0\u0db6\u0dd2\u0db1 \u0d85 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0db4 \u0dad\u0dd4\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2\u0db8\u0db4 \u0dad\u0dd3\u0db1\u0dca\u0dd4\u0dc0\u0dca \u0d9c\u0dad\u0dca\u0dad\u0dcf, 2016 \u0da2\u0dca\u200d\u0db1\u0dc0\u0dcf\u0dbb\u0dd2\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dca \u0db6\u0db3\u0dc0\u0dcf\u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dc3\u0dcf\u0da2\u0dca\u200d\u200d \u0dc1\u0dc3\u0dca\u0dc0\u0d9a\u0db4\u0db1\u0dca\u0da7 \u0dd6\u0dbb\u0dca\u0dab \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0d9a \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8 \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0db4\u0dbd\u0dcf. \u0d92 \u0dc1\u0dc0\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0db8\u0dca \u0dbd\u0dd2\u0db4\u0dd2\u0dc1\u0d86 \u0dc0\u0dcf\u0d9a\u200d\u0db4\u0dca \u0da7\u0dcf\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf, \"\u0da7\u0dcf\u0db4\u0d9a \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0da7 \u0dad\u0db8\u0dd2 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d92 \u0dbd\u0db6\u0dcf \u0dc1\u0da7\u0db1 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0d9a \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dc1\u0d86\u0daf\u0dd3 \u0dc3\u0da2\u0dca\u200d\u0db4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d9c\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2\u0db8\u0db4 \u0dad\u0dd3\u0db1\u0dca\u0dd4\u0dc0\u0dca \u0db8\u0dad \u0dad\u0dd3\u0dc3\u0dab\u0db4 \u0d9a\u0dc3\u0db1\u0dd4 \u0dbd\u0dd0\u0dc1\u0dda\" \u0d9a\u0dd2\u0db4\u0dbd\u0dcf. \u0d91\u0dc1\u0dc4\u0db8 \u0db1\u0db8\u0dca, \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0d91\u0db4 \u0db1\u0dd2 \u0dca\u0dd2\u0dad \u0db1\u0dd0\u0dc4\u0dd0; \u0d85\u0dc0\u0dd2\u0db1\u0dd2 \u0dca\u0dd2\u0dad\u0dd2 . \u0dc1\u0db8\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0db4 \u0dad\u0dd4\u0dc5 \u0dad\u0db8\u0dd2 \u0dc3\u0dcf\u0da2\u0dca\u200d\u200d \u0dc1\u0dc3\u0dca\u0dc0\u0d9a\u0dc1\u0db4\u0ddd \u0dbd\u0dca\u0dc2 17\u0d9a\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0db4\u0dca \u0d85\u0da7 \u0dc3\u0dc3\u0dca\u0dc3\u0dcf\u0dc0 \u0d9a\u0dc3\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0dad\u0dd8\u0d9a\u0dad\u0dd2\u0db4\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dbb\u0dd0\u0d9a\u0dd2\u0db4\u0dcf\u0dc1\u0dda \u0dad\u0dd8\u0d9a\u0dad\u0dd2\u0db4\u0dca \u0dad\u0dd2\u0dba\u0dc1\u0dab\u0dcf\u0dad\u0dca \u0dad\u0db8\u0dd2 \u0dc1\u0dc3\u0dca\u0dc0\u0d9a\u0dc1\u0db4\u0d9a\u0dd4 \u0dbb\u0dd0\u0d9a\u0dd2\u0db4\u0dcf\u0dc0 \u0dc4\u0dbb\u0dd2\u0db4\u0dcf\u0d9a\u0dcf\u0dc3\u0dc0 \u0d9a\u0dc3\u0db1\u0dca\u0dc1\u0db1\u0dca; \u0dc1\u0dc3\u0dca\u0dc0\u0dcf\u0dc0 \u0dc4\u0dbb\u0dd2\u0db4\u0dcf\u0d9a\u0dcf\u0dc3\u0dc0 \u0dc3\u0db4\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d85\u0da7 \u0d92 \u0dc1\u0dc3\u0dca\u0dc0\u0dcf\u0dc0 \u0db1\u0dd2\u0dc0\u0dd0\u0dc3\u0daf\u0dd2\u0dc0 \u0dbd\u0dd0\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0d91\u0d9a\u0da7 \u0d92\u0d9a \u0db4\u0dca\u200d\u0dbb\u0db4\u0dcf\u0db1 \u0dc1\u0dc4\u0dca\u0dad\u0dd4\u0dc0\u0dca."
  },
