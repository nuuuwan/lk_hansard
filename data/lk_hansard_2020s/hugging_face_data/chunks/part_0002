    "chunk_text": "i. \u0d9c\u0dd4\u0dc0 \u0da9\u0d9a\u0db1\u0daf \u0d9c\u0dcf\u0dc1\u0dda \u0dcf\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0d9a \u0dc1\u0dc0\u0dca\u200d\u0dad \u0dcf\u0daf\u0dca \u0dad\u0dd4\u0db1 \u0daf\u0dbd \u0dc3\u0dd3\u0dcf\u0daf\u0dc0\u0dca\u200d\u0d9a\u0dca\u0dc2 \u0dca\u0db3\u0dc4\u0daf \u0db4\u0daf\u0d9a\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd4 \u0dbb\u0dd0\u0dca\u0dae\u0dc0\u0dd3\u0db8\u0dca\u0dc0\u0dca\u200d\u0dbd\u0da7 \u0dca\u0dc4\u0dcf\u0daf\u0d9c\u0dd2 \u0dc0\u0dd3\u0dcf \u0d85\u0dad\u0dca\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dd3\u0dcf \u0db8\u0dd2\u0da7\u0dd4\u0dc1\u0dda \u0d92 \u0dcf\u0dd2\u0dbb \u0dd3\u0dbb \u0dab\u0d9a \u0dc0\u0dd2\u0d9a. ii. \u0d9c\u0dd4\u0dc0 \u0dc3\u0dd4\u0dd2\u0d9a\u0dad\u0dca \u0dca\u0dc3\u0dca\u200d\u0d9a \u0dc1\u0db4\u0dc1\u0d9a \u0daf \u0dcf\u0dc4\u0dad\u0daf\u0da7, \u0d94\u0dc4\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0dca \u0dcf\u0d9a\u0dca\u0dc2\u0dc0\u0dca\u200d\u0db1 \u0dbd\u0dcf \u0dca\u200d\u0dbb\u0dd2\u0dbb\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dc0\u0dca\u200d \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0\u0dca\u200d \u0dcf\u0dd0\u0da9\u0dd2 \u0dc1\u0dbd\u0dca \u0d85\u0dc0\u0dca\u200d\u0dc0\u0dca\u200d\u0daf\u0dcf \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0\u0dca\u200d\u0da7 \u0db6\u0dc4\u0dd4\u0dad \u0dd3\u0dbb \u0dab\u0dc1\u0d9a\u0dca \u0d91 \u0d9f \u0dc0\u0dd6 \u0d85\u0dad .... iii. \u0d9c\u0dd4\u0dc0 \u0dc1 \u0ddd\u0dc4\u0dab \u0db6\u0dab\u0dca\u0da9\u0da9\u0daf \u0dcf\u0dc4\u0dad\u0daf \u0d85\u0dcf\u0daf \u0dc0\u0dd3\u0da9\u0dd2\u0dc1\u0d9a\u0ddd\u0dc0\u0dca\u200d \u0dca\u0dcf\u0daf\u0dca\u200d\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dcf\n\n\u0dc1\u0dc4\u0dae\u0dad\u0dd4\u0dc1\u0dc0\u0dca\u200d\u0dca \u0d9c\u0dd4\u0dc0 \u0da9\u0d9a\u0db1\u0daf \u0d9c\u0dcf\u0dc1\u0dda \u0dcf\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0d9a\u0da7 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd6 \u0d85\u0db4\u0dd3\u0db8\u0d9a\u0dd2\u0dbb\u0d9a \u0dca\u0dd0\u0dbd\u0d9a\u0dd2\u0dbd\u0dca\u0dbd\u0da7 \u0dc1\u0d9c\u0db1 \u0dca\u0dd2\u0dbb \u0dc1\u0dcf \u0daf\u0dbd \u0dc3\u0dd3\u0dcf\u0daf\u0dc0\u0dca\u200d\u0d9a\u0dca\u0dc2 \u0dca\u0db3\u0dc4\u0daf \u0db4\u0daf\u0d9a\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd4 \u0dbb\u0dd0\u0dca\u0dae\u0dc0\u0dd3\u0db8\u0dca \u0d85\u0dad\u0dca\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dd3\u0dcf\u0da7....\u0dc0\n\n\u0d9c\u0dd4\u0dc0 \u0dcf\u0daf\u0db1\u0daf\u0d9a \u0dad\u0dd4\u0dcf\u0db1\u0dd2, \u0dcf\u0dcf \u0dc1\u0db8\u0dca \u0dca\u200d\u0dbb \u0dae\u0db1\u0d9a \u0dca\u0db8\u0dca\u0db6\u0dca \u0db0\u0dc1\u0d9a\u0dca \u0dcf\u0daf \u0dca \u0db1 \u0d94\u0db6\u0dad\u0dd4\u0dcf\u0daf\u0dc0\u0dca\u200d \u0dc4\u0db8\u0dd4 \u0dc0\u0dd4\u0dab\u0daf. \u0dc1\u0db8\u0dca \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0dd2 \u0dca\u200d\u0dbb \u0dae\u0db1\u0d9a\u0d9a\u0dca\u0dc2\n\n1881 1882\n\n\u0dad\u0d9c\u0dd4\u0dc0 \u0d9c\u0d9a\u0dca \u0dad \u0dd4\u0dc0\u0dab\u0daf\u0dd2\u0dbb\u0dbd \u0dcf\u0dc4\u0dad\u0daf\n\n202] \u0dc1\u0dcf\u0dca\u0dd0\u0db8\u0dca\u0db6\u0d9a 02\n\n\u0dc1\u0db1\u0daf\u0dc1\u0dc0\u0dca\u200d\u0dba\u0dd2. \u0db4\u0daf\u0d9a\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd4\u0dc0\u0dca\u200d \u0d85\u0db4\u0d9a\u0dca\u0dc2\u0dc2\u0db4\u0daf\u0dd3\u0dbb\u0dc0\u0dca\u200d \u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf \u0d9a\u0dd2\u0dbb\u0dd3\u0dcf \u0dc0\u0dca\u200d\u0dd0\u0db1\u0dd2 \u0dc1\u0dda\u0dc0\u0dca\u200d\u0dbd\u0dca \u0d9c\u0dd0\u0db1 \u0dca\u200d\u0db1\u0dad\u0daf\u0dc0\u0dca\u200d \u0db6\u0dbd\u0daf\u0dc1\u0d9c\u0db1 \u0d89\u0dca \u0db1\u0dc0\u0dca\u200d\u0daf. \u0d91\u0dc1\u0dc4\u0dcf \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0db4\u0daf\u0d9a\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd4\u0dc0\u0dca\u200d \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0\u0dca\u200d \u0dca\u200d\u0db1\u0dad\u0daf\u0dc0\u0dca\u200d \u0dad\u0dd4 \u0dd2\u0dbb\u0dc1\u0db6\u0db1 \u0dc0\u0dd2 \u0dae\u0dc0\u0dca\u200d\u0daf\u0dca\u0d9a \u0db4\u0dbd\u0dd4\u0daf\u0dd4 \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf. \u0d9c\u0dd4\u0dc0 \u0dcf\u0daf\u0db1\u0daf\u0d9a \u0dad\u0dd4\u0dcf\u0db1\u0dd2, \u0dcf\u0dcf \u0d94\u0db6\u0dad\u0dd4\u0dcf\u0daf\u0dc0\u0dca\u200d \u0dc4\u0db8\u0dd4 \u0dc0\u0dd4\u0dab\u0daf\u0dcf \u0d94\u0db6\u0dad\u0dd4\u0dcf\u0daf \u0dca\u0dcf\u0dbd\u0dca \u0daf\u0dca\u200d\u0db4\u0d9a\u0dca\u0dc2\u0dc2 \u0dcf\u0dc4\u0dad\u0dca\u0dcf\u0d9a\u0daf\u0dc0\u0dca\u200d \u0daf\u0dd4 \u0dcf\u0db1\u0dc1\u0d9a\u0dca \u0dca\u0db8\u0dca\u0db6\u0dca \u0db0 \u0d9c\u0dca \u0db1 \u0d8b\u0dad\u0dca\u0dca\u0daf\u0dc4 \u0daf. \u0d91\u0dad\u0dc1 \u0daf\u0da7 \u0d91\u0dad\u0dd4\u0dcf\u0daf\u0dc1\u0dda \u0d86 \u0d9a\u0dca\u0dc2\u0dc2 \u0db1\u0dd2\u0dbd\u0db0\u0daf\u0dbb\u0dd2\u0d9a\u0daf \u0d9a\u0dd2\u0dda\u0dc0\u0dca\u200d\u0daf, \u0dc0\u0d91\u0dad\u0dd4\u0dcf\u0daf\u0da7 \u0d85\u0dca\u0db1\u0dd3\u0db4\u0dba\u0dd2, \u0db0\u0dc0\u0dca\u200d\u0dcf\u0dba\u0dc0\u0dca\u200d \u0d9a\u0daf \u0d9f\u0da7 \u0d9c\u0dd2\u0d9a\u0daf\u0dc0 \u0d9a\u0dd2\u0d9a\u0dbd\u0daf. \u0dcf\u0dcf \u0d91\u0dad\u0dd4\u0dcf\u0daf\u0da7 \u0dad\u0dd4\u0dca \u0dc0\u0dca\u200d\u0dad\u0daf\u0dc0\u0dca\u200d\u0d9a\u0dca\u0dc2 \u0daf\u0dd4 \u0dcf\u0db1 \u0dc3\u0dcf\u0dad\u0dd4\u0db8\u0dca \u0d9c\u0dad\u0dca\u0dad\u0daf.\n\n\u0d9c\u0dd4\u0dc0 \u0dcf\u0daf\u0db1\u0daf\u0d9a \u0dad\u0dd4\u0dcf\u0db1\u0dd2, \u0dcf\u0dcf \u0d94\u0db6\u0dad\u0dd4\u0dcf\u0daf\u0da7 \u0d9a\u0dd2\u0dda\u0dc0\u0dca\u200d\u0daf, \u0dc0\u0dcf\u0dc4 \u0dc1\u0dbd\u0dca \u0db8\u0dca\u0dad\u0dd4\u0db8\u0dd2\u0d9a \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dd4\u0dc1\u0dc0\u0dca\u200d\u0dca \u0dc1\u0dbd\u0dca \u0db8\u0dca\u0dc0\u0dca\u200d \u0dc1\u0d9a\u0d9a\u0dd4 \u0dc1\u0db8\u0dca \u0db8\u0dd2\u0da7\u0dd4\u0dc1\u0dda \u0d89\u0dca \u0db1\u0dc0\u0dca\u200d\u0daf. \u0d91\u0dad\u0dd4\u0dcf\u0daf\u0dc1\u0d9c\u0dca \u0dc0\u0dca\u200d\u0daf\u0d9a\u0dad\u0daf\u0dc0\u0dca\u200d \u0d89\u0dbd\u0dca\u0dbd\u0daf\u0dc1\u0d9c\u0db1 \u0d92 \u0d85\u0db1\u0dd4\u0dc0\u0dca\u200d \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dca \u0db1\u0dc0 \u0d9a\u0dd2\u0d9a\u0dbd\u0daf. \u0d91\u0dad\u0dc1 \u0daf\u0da7 \u0d94\u0db6\u0dad\u0dd4\u0dcf\u0daf \u0d9a\u0dd2\u0dda\u0dc0\u0dca\u200d\u0daf, \u0dc0\u0dca\u0dcf\u0daf\u0db4\u0dd2\u0dbb\u0dad\u0dd4\u0dcf\u0daf \u0dd2\u0d9b\u0dd2\u0dad\u0dc0\u0dca\u200d \u0dcf\u0dd0\u0dca \u0dc0\u0dd2\u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2, \u0db1\u0dd2\u0dbd\u0db0\u0daf\u0dbb\u0dd2\u0dca \u0dc1\u0dda \u0dc0\u0dca\u200d\u0daf\u0d9a\u0dad\u0daf \u0dcf\u0dad \u0dbb\u0dd0\u0dc1\u0db3\u0dca \u0db1 \u0db6\u0dd0\u0dc4\u0dd0\u0dc0 \u0d9a\u0dd2\u0d9a\u0dbd\u0daf. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0dcf\u0dcf \u0dcf\u0dca \u0db1\u0daf \u0db4\u0daf\u0d9a\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd4 \u0dca\u0db8\u0dca\u0dca\u200d\u0dbb\u0dcf\u0daf\u0d9a\u0d9a \u0d85\u0db1\u0dd4\u0dc0\u0dca\u200d \u0db1\u0db8\u0dca, \u0db8\u0dd2\u0da7\u0dd4 \u0dc0\u0dca\u200d\u0daf\u0d9a\u0dad\u0daf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dca \u0db1 \u0d95\u0db1\u0dd1, \u0dca\u0dcf\u0daf\u0db4\u0dd2\u0dbb\u0dc0\u0dca\u200d \u0d9a\u0daf \u0dc1\u0db1\u0daf\u0dc1\u0dc0\u0dca\u200d\u0dba\u0dd2, \u0dc1\u0dbd\u0dca \u0db8\u0dca\u0dc0\u0dca\u200d\u0dd4\u0dc0\u0dba\u0dd2. \u0dcf\u0dcf \u0dc4\u0dd2\u0dad\u0daf\u0dcf\u0dad\u0daf \u0d94\u0db6\u0dad\u0dd4\u0dcf\u0daf\u0da7 \u0d85\u0dc1\u0d9c\u0dde \u0dc0\u0dca\u200d \u0db1\u0dc0\u0dca\u200d\u0daf \u0dc1\u0db1\u0daf\u0dc1\u0dc0\u0dca\u200d\u0dba\u0dd2. \u0db4\u0daf\u0d9a\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd4\u0dc0\u0dca\u200d \u0db4\u0daf\u0dbd\u0db1\u0d9a \u0dca \u0db1 \u0d9a\u0db1 \u0dc1\u0db8\u0dca \u0d85\u0dcf\u0dd8 \u0dba\u0dcf\u0daf\u0db1 \u0dc4\u0dca\u0dae\u0dad\u0d9a \u0dc1\u0dcf\u0daf \u0d9a\u0dca\u0dc2\u0dcf?"
  },
