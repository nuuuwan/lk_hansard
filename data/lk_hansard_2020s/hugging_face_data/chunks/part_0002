    "chunk_text": "\u0db4\u0dc5\u0db4\u0dd4\u0dbb\u0dd4\u0dd4 \u0dc1 \u0db4\u0dcf\u0dbd\u0db1 \u0db1\u0dcf\u0db4\u0d9a\u0db4\u0d9a\u0dd4 \u0dc4\u0dd0\u0dd2\u0db4\u0da7 \u0dc0\u0dcf\u0dc1\u0dda\u0db8, \u0dc3\u0da7\u0da7 \u0dc4\u0dd2\u0dad\u0d9a\u0dc3 \u0dad\u0dd3\u0db1\u0dca\u0dd4 \u0dad\u0dd3\u0dc3\u0dab \u0d9c\u0db1\u0dca\u0db1 \u0db1\u0dcf\u0db4\u0d9a\u0dad\u0dca\u0dc0\u0db4\u0dca \u0dd4\u0db1\u0dca \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0db4\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dc1\u0db8\u0dca \u0d85\u0db8\u0dcf\u0dad\u200d\u0dcf\u0dcf\u0d82 \u0db4 \u0d89\u0dad\u0dcf \u0db1\u0dd2\u0dc0\u0dd0\u0dc3\u0daf\u0dd2\u0dc0 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dc1\u0d9c\u0db1 \u0db4\u0db1\u0dca\u0db1 \u0dc0\u0dd2 \u0dcf\u0dbd \u0db8\u0dc4\u0db1\u0dca\u0dc3\u0dd2\u0db4\u0dca \u0da7\u0dc3\u0db1 \u0db6\u0dc0 \u0d85\u0db4\u0dd2 \u0da7\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0dc3\u0dc4\u0dc1\u0db4\u0ddd\u0d9c\u0db4 \u0da7\u0dca\u0dc0\u0db1\u0dca\u0db1 \u0dc1\u0dc4\u0dcf\u0db3 \u0dc3\u0dcf\u0da2\u0dca\u200d\u200d \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dd4 \u0dc1\u0da7\u0db4\u0dc5\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0da2\u0dca\u200d\u0dcf\u0db1\u0d9a \u0dc0\u0dca\u0d9a\u0dd4\u0db9\u0dd4\u0dc3 \u0dc3\u0dcf\u0da2\u0dca\u200d\u200d \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dca, \u0d85\u0dc1 \u0ddd\u0d9a \u0dca\u200d\u0dbb\u0dd2\u0db4\u0db1\u0dca\u0dad \u0dc3\u0dcf\u0da2\u0dca\u200d\u200d \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dca, \u0dad\u0dbb\u0dd4\u0dab \u0db8\u0dc4\u0da2\u0dca\u200d\u0db1 \u0db1\u0dd2\u0dc1\u0db4\u0ddd\u0da2\u0dd2\u0dad\u0db4\u0db1\u0dca \u0dc4\u0dd0\u0dd2\u0db4\u0da7 \u0d92 \u0dc1\u0dc3\u0dca\u0dc0\u0dcf\u0dc0 \u0d9a\u0dcf\u0dbb\u0dca\u0db4\u0dca\u0dc2\u0db8\u0dc0 \u0d89\u0da7\u0dd4 \u0d9a\u0dc3\u0db1\u0dca\u0db1 \u0dc0\u0dd2 \u0dcf\u0dbd \u0db8\u0dc4\u0db1\u0dca\u0dc3\u0dd2\u0db4\u0dca \u0da7\u0dc3\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8, \u0d91\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf \u0dc3\u0dc1 \u0d85 \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0db4 \u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dbd\u0dca\u0dbd\u0da7 \u0d85\u0dc3\u0dc1\u0d9c\u0db1, \u0dbd\u0dd0\u0dc1\u0db6\u0db1 \u0db8\u0dd4\u0da7\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0da7\u0db1 \u0dda\u0db4\u0dbb\u0dd2\u0db8 \u0db8 \u0d85\u0da7\u0dc1\u0db8\u0db1\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dc3\u0dab\u0db4 \u0d9a\u0dc3\u0db1 \u0d86\u0d9a\u0dcf\u0dc3\u0db4 \u0d9c\u0dd0\u0db1 \u0d85\u0db4\u0da7 \u0db1\u0dd2\u0dc0\u0dd0\u0dc3\u0daf\u0dd2 \u0d85\u0dc0\u0dc1\u0db6\u0ddd\u0db4\u0db4\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf.\n\n\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dca \u0da7\u0db1\u0dca\u0db1\u0dc0\u0dcf, \u0dc1\u0db8\u0dca \u0d85\u0db4 \u0dc0\u0dd0\u0db4 \u0dc1\u0dbd\u0dca\u0d9b\u0db1\u0db4 \u0d85\u0db1\u0dd4\u0dc0 2024 \u0dc0\u0dbb\u0dca\u0dc2\u0db4 \u0dad\u0dd4\u0dc5 \u0d85\u0db4 \u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0db4\u0db1 4,127\u0d9a \u0db4\u0db8\u0dab \u0db8\u0dd4\u0da7\u0dbd\u0dca \u0d85\u0dc1\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dc3\u0db1 \u0db6\u0dc0. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8, 2024 \u0dc0\u0dbb\u0dca\u0dc2\u0dc1\u0d86 \u0dc0\u0dd2\u0db4\u0da7\u0db8 \u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0db4\u0db1 6,978\u0dca \u0dc1\u0dbd\u0dc3 \u0d9c\u0dab\u0db1\u0db4\u0dc1\u0d9a\u0dcf\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u0dad\u0dc1\u0d9a\u0dcf\u0da7 \u0d85\u0db4 \u0dc0\u0dd0\u0db4 \u0dc4\u0dd2\u0d9f\u0db4 \u0dc0 \u0dc1\u0db4\u0db1\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf, \u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0db4\u0db1 2,851\u0dca. \u0dc1\u0db8\u0dca \u0db8\u0dc4\u0dcf \u0db6\u0dc3\u0db4\u0dad\u0dc5 \u0dc4\u0dd2\u0d9f\u0db4\u0dca \u0d91\u0dca\u0d9a \u0dad\u0db8\u0dd2 \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dc1\u0db8\u0dc0\u0dc3 \u0d85\u0db4 \u0dc0\u0dd0\u0db4 \u0dc1\u0dbd\u0dca\u0d9b\u0db1\u0db4 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc3\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d85\u0db4 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dc1\u0d86 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d85\u0db7\u0dd2\u0dc1\u0db4\u0ddd\u0d9c\u0db4 \u0dad\u0db8\u0dd2 , \u0dc1\u0db8\u0dca \u0dc4\u0dd2\u0d9f\u0db4 \u0db4\u0dd2\u0db4\u0dc0\u0dcf\u0dc1\u0d9c\u0db1 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0dc0\u0dbd\u0da7 \u0dc0\u0dd2\u0dc3\u0db3\u0dd4\u0db8\u0dca \u0dbd\u0db6\u0dcf \u0dc1\u0da7\u0db1\u0dca\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8. \u0d85\u0db4\u0dd2 \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dc0\u0dd6 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2\u0db8\u0db4 \u0dad\u0dd3\u0db1\u0dca\u0dd4 \u0db8\u0dc4\u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0d85\u0dad\u0dc3\u0da7 \u0db4\u0db1 \u0db8\u0dcf\u0db4\u200d\u0db4 \u0dad\u0db8\u0dd2 \u0dc3\u0dcf\u0da2\u0dca\u200d\u200d \u0dc1\u0dc3\u0dca\u0dc0\u0db4. \u0dc3\u0dcf\u0da2\u0dca\u200d\u200d \u0dc1\u0dc3\u0dca\u0dc0\u0db4 \u0dad\u0dd8\u0d9a\u0dad\u0dd2\u0db8\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0dc0\u0d9c\u0d9a\u0dd3\u0db8 \u0d85\u0db4\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0d9c\u0d9a\u0dd3\u0dc1\u0db8\u0db1\u0dca \u0db6\u0dd0\u0dc4\u0dd0\u0dc3 \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0dc3\u0dd6\u0da7\u0dcf\u0db1\u0db8\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0d92 \u0dc0\u0d9c\u0d9a\u0dd3\u0db8 \u0d89\u0da7\u0dd4 \u0d9a\u0dc3\u0db1\u0dca\u0db1 \u0db4\u0db1 \u0dc0\u0dd2\u0da7 \u0dc1\u0db8\u0dca \u0dc3\u0dcf \u0dc0\u0dd2 \u0dcf\u0dbd \u0d85\u0db4 \u0dc0\u0dd0\u0db4 \u0dc4\u0dd2\u0d9f\u0db4\u0dca \u0d91\u0dca\u0d9a \u0dad\u0db8\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc3\u0db1\u0dca\u0db1 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca.\n\n\u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0dc1\u0dda \u0d85\u0dc0\u0db4\u0dcf\u0db1\u0db4 \u0db8\u0db8 \u0dad\u0dc0\u0dd4\u0dc3\u0da7\u0dad\u0dca \u0dc1\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db4\u0dc1\u0db4\u0db1\u0dca \u0dc1\u0db4\u0dcf\u0db8\u0dd4 \u0d9a\u0dc3\u0dc0\u0db1\u0dca\u0db1\u0db8\u0dca, \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0db8\u0dc3\u0d9a\u0da7 \u0dc3\u0dcf\u0da2\u0dca\u200d\u200d \u0dc1\u0dc3\u0dca\u0dc0\u0db4 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd0\u0da7\u0dd4\u0d9a \u0dc1\u0d9c \u0db8\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0db4\u0db1 93\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d8a\u0da7 \u0d85\u0db8\u0dad\u0dc3\u0dc0, \u0dc3\u0dd4\u0db6\u0dc3\u0dcf\u0db4\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4, \u0d85\u0dc3\u0dca\u0dc0\u0dd0\u0dc3\u0dd4\u0db8 \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5 \u0dc0\u0dcf\u0dc1\u0dda \u0d92\u0dc0\u0dcf\u0da7 \u0d85\u0db4\u0dd2 \u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0db4\u0db1 30\u0dca \u0dc1\u0da7\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dab\u0db4 \u0dc1\u0db4\u0dcf\u0dbd\u0dd2\u0db4 \u0dc0 \u0dc1\u0db4\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0db4\u0db1 220\u0dca \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d91\u0d9a\u0dad\u0dd4\u0dc0 \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dcf\u0dad\u0dca, \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dc1\u0d86 \u0daf\u0dd3 :\u0dcf\u0dab\u0dca\u0da9\u0dcf\u0d9c\u0dcf\u0dc3\u0db4\u0da7 \u0dc3\u0dd2 \u0db4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf, \u0dc1\u0d9a\u0dc5\u0dd2\u0db1\u0dca\u0db8 \u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0db4\u0db1 353\u0dca \u0db8\u0dcf\u0dc3\u0dd2\u0d9a\u0dc0 \u0dc1\u0d9c \u0db8\u0da7. \u0da7\u0dd0\u0db1\u0dca :\u0dcf\u0dab\u0dca\u0da9\u0dcf\u0d9c\u0dcf\u0dc3\u0db4\u0da7 \u0db8\u0dcf\u0dc3\u0dd2\u0d9a\u0dc0 \u0dbd\u0dd0\u0dc1\u0db6\u0db1 \u0d86\u0da7\u0dcf\u0db4\u0db8 \u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0db4\u0db1 215\u0dd2 . \u0d91\u0dad\u0dc1\u0d9a\u0dcf\u0da7, \u0db8\u0dcf\u0dc3\u0db4\u0d9a\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0db4\u0db1 138\u0d9a \u0dc4\u0dd2\u0d9f\u0db4\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0da7 \u0dbd\u0dd0\u0dc1\u0db6\u0db1 \u0d86\u0da7\u0dcf\u0db4\u0db8\u0da7 \u0dc0\u0da9\u0dcf \u0dad\u0dc0\u0dad\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0db4\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0db4\u0db1 138\u0dca \u0d85\u0db4\u0da7\n\n1103 1104\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0"
  },
