    "chunk_text": "\u0b95\u0b9f\u0ba8\u0bcd\u0ba4 14 \u0bc6\u0bb0\u0bc1\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc6\u0bbe\u0b95 \u0b87\u0ba4\u0ba4 \u0bc6\u0bae\u0b9f\u0bae\u0bc1\u0bae\u0bb1\u0ba4\u0bc6\u0bbe\u0ba9\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1\u0bc6\u0bbe\u0bb2\u0bcd, \u0bc8\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0b9f\u0baf \u0b8e\u0bb5\u0bcd\u0bc6\u0bb3\u0bb5\u0bc1 \u0baa\u0bc8\u0bae\u0bcd \u0b87\u0bb5\u0bcd\u0bc6\u0bc6\u0bbe\u0bb1\u0bc1 \u0bb5\u0bc0\u0bc8\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1! \u0b85\u0ba4\u0bc6\u0bbe\u0bc6\u0ba4\u0bc1, \u0bc6\u0b9f\u0b95\u0bcd\u0b95\u0bc1, \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bb1\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba4\u0baa\u0baf\u0bb0\u0bc6\u0bbe\u0bb2\u0bcd, \u0b8e\u0ba8\u0bcd\u0ba4 \u0bc6\u0b9f\u0bc6\u0b9f\u0bbf\u0b95\u0bcd\u0bae\u0b95\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0b9f\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc6\u0bbe\u0bc8\u0bb2\u0bcd, 14 \u0bc6\u0bb0\u0bc1\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc6\u0bbe\u0b95 \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 Chairman \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd Deputy Chairman \u0bc6\u0bbf\u0baf\u0bc8\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1, \u0b85\u0bc6\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0b9a\u0bae\u0bcd\u0baa\u0bb3\u0bae\u0bcd, \u0bc6\u0bc6\u0bbe\u0b95\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0ba9\u0ba4\u0bc6\u0bb2\u0bcd\u0bb2\u0bc6\u0bbe\u0bae\u0bcd \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0ba4\u0ba9\u0bcd\u0bb1\u0bc6\u0bbe\u0bb2\u0bcd, \u0bc8\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0b9f\u0baf \u0bc6\u0bc6\u0bbe\u0bbf\u0baa\u0bcd \u0baa\u0bc8\u0bae\u0bcd \u0b8e\u0bb5\u0bcd\u0bc6\u0bb3\u0bb5\u0bc1 \u0bb5\u0bc0\u0bc8\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0ba3\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1! \u0b85\u0ba4\u0bc1\u0bb5\u0bc1\u0bae\u0bcd, \u2018\u0bc6\u0b9f\u0b95\u0bcd\u0b95\u0bc1, \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd \u0b85\u0baa\u0bbf\u0bc6\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u2019 \u0b8e\u0ba9\u0bcd\u0bb1 \u0ba4\u0baa\u0baf\u0bc6\u0bbe\u0bbf\u0bb2\u0bcd \u0b87\u0bb5\u0bcd\u0bc6\u0bc6\u0bbe\u0bb1\u0bc1 \u0bb5\u0bc0\u0bc8\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bc6\u0ba4\u0bc1\u0ba4\u0bc6\u0bbe\u0ba9\u0bcd \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0bc8\u0bbf\u0b95\u0baa\u0bcd\u0ba4\u0baa\u0bc6\u0bbe\u0bbf\u0baf \u0b95\u0bc6\u0bae\u0bb2\u0baf\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. KKS \u0b9a\u0bc0\u0ba4\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0ba4\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb1\u0bcd\u0b9a\u0bc6\u0bbe\u0bae\u0bb2 \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bb0\u0ba8\u0bcd\u0ba4\u0ba9\u0bcd chemical \u0b8e\u0ba9\u0bcd\u0bb1 \u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb1\u0bcd\u0b9a\u0bc6\u0bbe\u0bae\u0bb2\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba4\u0baa\u0baf\u0bc6\u0bbe\u0bbf\u0bb2\u0bcd \u0b87\u0baa\u0bcd\u0baa\u0b9f\u0bbf\u0baf\u0bc6\u0bbe\u0b95\u0ba4\u0bcd\n\n1749 1750\n\n[\u0d9c\u0dbb\u0dd4 \u0d85\u0d82\u0d9c\u0da2\u0dca\u200d\u0db1\u0dca \u0dbb\u0dcf\u0db8\u0db1\u0dcf\u0daf\u0db1\u0dca \u0db8 \u0dad\u0dcf ]\n\n2023 \u0dc1\u0daf\u0dc3\u0dd0\u0dda\u0db6\u0dca\u0d9c 91\n\n\u0b86\u0ba9\u0bc6\u0bbe\u0bb2\u0bcd, \u0b87\u0ba4\u0bbf\u0ba4\u0bb2\u0bc6\u0bbe\u0bb0\u0bc1 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0bc8\u0bc6\u0bbe\u0ba9 \u0bc6\u0bbf\u0b9f\u0baf\u0ba4\u0bcd\u0bae\u0ba4 \u0bc6\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bc6\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0ba4\u0bc6\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd. \u0b85\u0ba4\u0bc6\u0bbe\u0bc6\u0ba4\u0bc1, \u0baf\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0bae\u0bc1\u0b9f\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1 14 \u0bc6\u0bb0\u0bc1\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc6\u0bbe\u0b95\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0bae\u0b95\u0ba4\u0bcd\u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd \u0ba4\u0bc1\u0bae\u0bb1\u0b95\u0bb3\u0bcd \u0b85\u0b99\u0bcd\u0b95\u0bc1 \u0b86\u0bb0\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc6\u0bbf\u0bb2\u0bcd\u0bae\u0bb2 \u0b8e\u0ba9\u0bcd\u0bb1\u0bc6\u0bbe\u0bb2\u0bcd, \u0b87\u0ba4\u0bbf\u0bb2\u0bcd \u0b8f\u0ba4\u0ba4\u0bc6\u0bbe\u0ba4\u0bc6\u0bc6\u0bbe\u0bb0\u0bcd \u0b93\u0bb0\u0bc6\u0b9e\u0bcd\u0b9a\u0bae\u0ba9 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b8f\u0ba9\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0b85\u0bc6\u0bbf\u0baf\u0bc6\u0bbe\u0baf\u0bae\u0bcd? \u0b92\u0bb0\u0bc1 \u0baa\u0bbf\u0bb0\u0ba4\u0ba4\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bc1\u0bae\u0b9f\u0baf \u0ba4\u0baa\u0bc6\u0bbe\u0bb0\u0bc1\u0bb3\u0bc6\u0bbe\u0ba4\u0bc6\u0bbe\u0bb0\u0ba4\u0bcd\u0bae\u0ba4\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bbf\u0ba4\u0baf\u0bb4\u0bc1\u0baa\u0bcd\u0baa \u0b87\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0bae\u0b95\u0ba4\u0bcd\u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd \u0ba4\u0bc1\u0bae\u0bb1\u0b95\u0bb3\u0bcd \u0ba4\u0ba4\u0bae\u0bc6\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9. \u0b86\u0ba9\u0bc6\u0bbe\u0bb2\u0bcd, \u0b85\u0bae\u0ba4 \u0b86\u0bb0\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0bc8\u0bb2\u0bcd, \u0b92\u0bb5\u0bcd\u0ba4\u0bc6\u0bc6\u0bbe\u0bb0\u0bc1 budget\u0b87\u0bb2\u0bc1\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0bae\u0b95\u0ba4\u0bcd\u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd \u0ba4\u0bc1\u0bae\u0bb1\u0b95\u0bae\u0bb3 \u0b86\u0bb0\u0bae\u0bcd\u0baa\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b87\u0bb5\u0bcd\u0bc6\u0bb3\u0bb5\u0bc1 \u0bc6\u0bbf\u0ba4\u0bbf \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc0\u0b9f\u0bc1 \u0ba4\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1 \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b85\u0ba8\u0bcd\u0ba4 \u0ba4\u0bc6\u0bae\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0b95 \u0b87\u0bb5\u0bcd\u0bc6\u0bb3\u0bb5\u0bc1 \u0bc6\u0bbf\u0ba4\u0bbf \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc0\u0b9f\u0bc1 \u0ba4\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bc6\u0bae\u0ba4 \u0bc6\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc6\u0bbe\u0ba3\u0bcd\u0b95\u0bbf\u0ba4\u0bb1\u0bc6\u0bbe\u0bae\u0bcd. \u0b85\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4 \u0bc6\u0bb0\u0bc1\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bc1\u0bae\u0bcd budget\u0b87\u0bb2\u0bcd \u0b85\u0ba4\u0ba4 \u0bc6\u0b9a\u0ba9\u0bae\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd. \u0b86\u0ba9\u0bc6\u0bbe\u0bb2\u0bcd, \u0b85\u0b99\u0bcd\u0b95\u0bc1 \u0b8e\u0ba8\u0bcd\u0ba4\u0ba4\u0bc6\u0bc6\u0bbe\u0bb0\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0ba4\u0ba9\u0bb1\u0bcd\u0bb1\u0bae\u0bc1\u0bc8\u0bbf\u0bb2\u0bcd\u0bae\u0bb2. \u0b8e\u0ba9\u0ba4\u0bc6, \u0bc6\u0b9f\u0b95\u0bcd\u0b95\u0bc1, \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bcd \u0b8e\u0ba8\u0bcd\u0ba4\u0ba4\u0bc6\u0bc6\u0bbe\u0bb0\u0bc1 \u0bae\u0b95\u0ba4\u0bcd\u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd \u0ba4\u0bc1\u0bae\u0bb1\u0bae\u0baf\u0baf\u0bc1\u0bae\u0bcd \u0b86\u0bb0\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0bc8\u0bb2\u0bcd \u0b85\u0ba4\u0bbf\u0bb2\u0bcd \u0b93\u0bb0\u0bcd \u0b93\u0bb0\u0bc6\u0b9e\u0bcd\u0b9a\u0bae\u0ba9 \u0ba4\u0ba4\u0bc6\u0bbe\u0b9f\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0baf\u0bc6\u0bbe\u0b95 \u0bc6\u0b9f\u0ba8\u0bcd\u0ba4\u0bc1\u0ba4\u0b95\u0bc6\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1 \u0bc6\u0bb0\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b87\u0bae\u0ba4 \u0bc6\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bcd\u0ba9\u0ba4\u0bc6\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba4\u0b9a\u0bc6\u0bbe\u0bb2\u0bcd\u0bc6\u0ba4\u0bc1? \u0b87\u0bae\u0ba4\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0ba9\u0bcd \u0bc6\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bc6\u0bb2\u0bcd\u0bb2\u0bbf\u0bc8\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b8e\u0ba4\u0bbf\u0bb0\u0bc6\u0bbe\u0ba9 \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba4\u0b9a\u0bc6\u0bbe\u0bb2\u0bcd\u0bb2\u0bc1\u0b95\u0bbf\u0ba4\u0bb1\u0bc6\u0bbe\u0bae\u0bcd."
  },
