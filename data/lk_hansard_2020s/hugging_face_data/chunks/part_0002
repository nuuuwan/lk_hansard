    "chunk_size_bytes": 4126,
    "chunk_text": "\u0dc1\u0db8\u0dca \u0d85\u0db8\u0dcf\u0dad\u200d\u0dcf\u0dcf\u0d82 \u0db4 \u0db4\u0da7\u0dc1\u0dad\u0dca \u0d9a\u0dae\u0dcf \u0d9a\u0dc3\u0db1\u0dc1\u0d9a\u0dcf\u0da7 \u0db8\u0db8 \u0dc0\u0dd2\u0dc1 \u0dca\u0dc2\u0dc1\u0db4\u0db1\u0dca\u0db8 \u0db8\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dcf\u0dc3\u0dab\u0db4\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0db4 \u0da7\u0dc0\u0dc3\u0d9a \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0db4\u0dad\u0db1 \u0da1\u0db1\u0dca\u0da7 \u0db8\u0dc3\u0dd3\u0db8\u0dca (\u0dc3\u0dcf\u0d82\u0dc1 \u0ddd\u0db4\u0db1) \u0db4\u0db1\u0dad\u0dca \u0dc1\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad \u0dc1\u0db4\u0dde \u0d9c\u0dbd\u0dd2\u0d9a \u0db8\u0db1\u0dca\u0dd3 \u0dc1\u0db4\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf\u0dc0\u0dca \u0dc4\u0dd0\u0dd2\u0db4\u0da7 \u0d85\u0dc1\u0d9a \u0dc1\u0dbb\u0dda\u0db8\u0dca\u0db1\u0dcf\u0dad\u0dca \u0dc3\u0dd3. \u0dc1\u0da7\u0dcf\u0dbd\u0dc0\u0dad\u0dca\u0dad \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc5\u0dcf. \u0d92\u0d9a \u0db4\u0dca\u0dc2, \u0dc0\u0dd2\u0db4\u0dca\u0dc2 \u0dc1\u0da7\u0db4\u0dcf\u0dbb\u0dca \u0dca\u0dc0\u0db4 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0dc3\u0dc1 \u0d85 \u0dc3\u0dd2\u0db4\u0dbd\u0dd4 \u0db4\u0dd4\u0dc3\u0dc0\u0dd0\u0dc3\u0dd2\u0db4\u0db1\u0dca \u0db6\u0dbd\u0dcf\u0dc1\u0db4\u0dcf\u0dc1\u0dc3\u0dcf\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0dd4\u0dab\u0dd4 \u0dc1\u0db4\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf\u0dc0\u0dca. \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0db4\u0dad\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0dbb\u0dd4\u0dab \u0db1\u0dd2\u0dc1\u0db4\u0ddd\u0da2\u0dca\u200d\u0db1\u0db4 \u0dc3\u0dd2\u0db4\u0db4\u0da7 25 \u0da7\u0dca\u0dc0\u0dcf \u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dbb\u0dca\u0db4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc1\u0db8\u0dca \u0dc1\u0db4\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf\u0dc0 \u0dc1\u0d9c\u0db1\u0dcf\u0dc0\u0dcf. \u0dc1\u0db8\u0dca \u0dc1\u0db4\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf\u0dc0 2023.11.10 \u0daf\u0dd2\u0db1 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc1\u0dda\u0daf\u0dd3 \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dc0\u0dd4\u0dab\u0dcf. 2023.11.17\u0dc1\u0dc0\u0db1\u0dd2 \u0da7\u0dcf \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0db4\u0d9a\u0dad\u0dd4\u0db8\u0dcf \u0d92\u0d9a\u0da7 \u0d85\u0dad\u0dca\u0dc3\u0db1\u0dca \u0d9a\u0dc5\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0da7\u0dd0\u0db1\u0dca \u0dc1\u0db8\u0dca\u0d9a \u0db1\u0dd3\u0dad\u0dd2\u0db4\u0dca \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0dc1\u0dc0\u0dbd\u0dcf\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d9c\u0dbb\u0dd4 \u0d85\u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dcf\u0dad\u200d\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc1\u0dda \u0dbb\u0dd0\u0db3\u0dd3 \u0dc3\u0dd2\u0dd2\u0db1 \u0dc1\u0db8\u0dca \u0dc1\u0db8\u0dcf\u0dc1\u0dc4\u0dcf\u0dc1\u0dad\u0dca \u0db8\u0db8 \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0dc3\u0dd2\u0dd2\u0db1\u0dc0\u0dcf, \u0dc1\u0db8\u0dca \u0dad\u0dbb\u0dd4\u0dab \u0db1\u0dd2\u0dc1\u0db4\u0ddd\u0da2\u0dca\u200d\u0db1\u0db4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc1\u0db4\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf\u0dc0 \u0d91\u0dc5\u0dc1\u0db9\u0db1 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dc3\u0dab\u0db4\u0d9a\u0daf\u0dd3 \u0d89\u0dad\u0dcf \u0d9a\u0da9\u0dd2\u0db1\u0db8\u0dd2\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db4\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dc3\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0db4\u0dbd\u0dcf. \u0dc1\u0db8\u0dcf\u0d9a\u0da7, \u0dc1\u0db8\u0dca \u0dc3\u0dc1 \u0d85 \u0dad\u0dbb\u0dd4\u0dab\u0db4\u0db1\u0dca \u0d85\u0dc0\u0dd2 \u0d86\u0dba\u0dd4\u0db4 \u0d85\u0dad\u0da7 \u0d9c\u0dad\u0dca\n\n1095 1096\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0d85\u0db4\u0dd2 \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4\u0dad\u0dca \u0da7\u0db1\u0dca\u0db1\u0dc0\u0dcf, \u0dc1\u0db8\u0dca \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0dcf\u0da7 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db1\u0dc0\u0db4\u0da7 \u0d85\u0da7\u0dcf\u0dc5 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0dc3:\u0dcf \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dc3\u0dab\u0db4 \u0dad\u0dc0\u0db8 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0db4\u0db1 \u0d91\u0d9a. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0dc1\u0db8\u0dca \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0dcf\u0da7 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0dc3:\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0dbb\u0dd2\u0dbd\u0dcf, \u0d86\u0dab\u0dca\u0dca\u0d9a\u0dcf\u0dc3\u0dc0\u0dbb\u0dd4 \u0dad\u0db8\u0dd2 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db1\u0dc0\u0db4 \u0db4\u0dcf\u0dbd\u0db1\u0db4 \u0d9a\u0dc3\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc4\u0dd0\u0db6\u0dd0\u0dd2 \u0d92 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db1\u0dc0\u0dc1\u0d86, \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0dc3:\u0dcf \u0db1\u0dc0\u0dc1\u0d86 \u0db4\u0dca\u200d\u0dbb\u0db4\u0dcf\u0db1 \u0dc1\u0dbd\u0dca\u0d9a\u0db8\u0dca\u0dad\u0dd4\u0db8\u0dcf \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u200d\u0dcf\u0dcf\u0d82 \u0dc0\u0dbd \u0db1\u0dd2\u0dbd\u0db4\u0dcf\u0dbb\u0dd2\u0db1\u0dca -\u0dc4\u0dd0\u0db8 \u0d85\u0db8\u0dcf\u0dad\u200d\u0dcf\u0dcf\u0d82 \u0db4\u0d9a\u0db8- \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf; \u0d92 \u0d85\u0db4\u0dc1\u0d9c\u0db1\u0dca \u0dc1 \u0db4\u0dcf\u0dbd\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0db4 \u0db1\u0dd2\u0dc1\u0db4\u0ddd\u0da2\u0dca\u200d\u0db1\u0db4 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dc1\u0db8\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dc3\u0db1 \u0db8\u0dd4\u0da7\u0dbd\u0dca - \u0db8\u0db4\u200d\u0db8 \u0d86\u0dab\u0dca\u0dca\u0dc1\u0dc0\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dc3\u0db1 \u0db8\u0dd4\u0da7\u0dbd\u0dca - \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db1\u0db4\u0da7 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0dc3\u0dcf\u0d82\u0dc0\u0dbb\u0dca\u0db4\u0db1\u0db4 \u0dda\u0dc1\u0da7\u0dc3\u0dcf \u0dc3\u0dcf\u0db4\u0dcf\u0dc3\u0dab \u0dc0\u0dd2\u0db0\u0dd2\u0db4\u0da7 \u0dc0\u0dd2\u0db4\u0da7\u0db8\u0dca \u0d9a\u0dc3\u0db1\u0dc0\u0dcf\u0da7 \u0d9a\u0dd2\u0db4\u0db1 \u0d91\u0d9a \u0d9c\u0dd0\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0db4\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db4\u0dc1\u0db4\u0db1\u0dca 2024 \u0dc0\u0dbb\u0dca\u0dc2\u0db4 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd2\u0db1\u0dd2\u0dc0\u0dd2\u0da7:\u0dcf\u0dc0\u0dc1\u0db4\u0db1\u0dca \u0dba\u0dd4\u0dca\u0dad \u0dc0\u0dd0\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dc5\u0dca \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d89\u0dad\u0dcf \u0dc0\u0dd0\u0da7\u0d9c\u0dad\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0d92 \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dc3\u0db1 \u0db8\u0dd4\u0da7\u0dbd\u0dca \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dca\u0d9a \u0db8 \u0d85\u0da7\u0dc1\u0db8\u0db1\u0dca, \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dc1 \u0dc1\u0dd3\u0db4 \u0dc1\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dc1\u0d9a\u0dcf \u0d85\u0da8\u0dcf\u0dc3 \u0db8 \u0d85\u0da7\u0dc1\u0db8\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dc3\u0dbd\u0dcf \u0db4\u0db8\u0dca \u0dc3\u0dcf\u0db4\u0dcf\u0dc3\u0dab\u0db4\u0dca \u0d89\u0dc2\u0dca\u0da7 \u0d9a\u0dc3\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0d89\u0dad\u0dcf \u0dc0\u0dd0\u0da7\u0d9c\u0dad\u0dca. \u0d85\u0db4\u200d\u0dcf\u0db4\u0db1\u0db4, \u0dc1\u0dc3\u0dde\u0d9b\u200d, \u0d9a\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad\u0db4 \u0dc0\u0dcf\u0dc1\u0dda \u0dc0\u0dd2\u0dc0\u0dd2\u0db4 \u0d85\u0dcf\u0d82 \u0dc0\u0dbd\u0da7 \u0dc1\u0db8\u0dca \u0db8\u0dd4\u0da7\u0dbd\u0dca \u0dc3\u0dcf\u0db4\u0dcf\u0dc3\u0dab\u0dc0 \u0dc1\u0db6\u0daf\u0dd3 \u0db4\u0db1\u0dca\u0db1\u0da7 \u0d95\u0db1\u0dd1."
  },
