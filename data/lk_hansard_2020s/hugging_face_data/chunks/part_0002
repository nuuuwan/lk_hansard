    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0db4\u0dc3\u0dd4\u0d9a \u0dba \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0d89\u0daf\u0dd2\u0d9a\u0dbb\u0dd4\u0dbb \u0db0\u0dcf\u0db1\u0dba \u0dc3\u0dd4\u0dbb\u0dd0\u0d9a\u0dd4\u0dda \u0db8\u0db0\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0d87\u0db9\u0dd2\u0dbd\u0dd2\u0db4\u0dd2\u0dd2\u0d9a\u0dc1\u0dda \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d92\u0d9a\u0da7 \u0d85\u0db4\u0dd2 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dc1\u0d9a\u0ddd\u0dd2\u0d9a \u0dad\u0dd4\u0db1\u0d9a\u0da7 \u0d86\u0dc3\u0db1\u0dca\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0dc0\u0dd2\u0dba\u0daf\u0dda \u0d9a\u0dc5\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0d85\u0daf \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0d92\u0d9a \u0dad\u0dc0\u0db8\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dba\u0d9a\u0da7 \u0d9c\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dc1\u0dba\u0db1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d87\u0db9\u0dd2\u0dbd\u0dd2\u0db4\u0dd2\u0dd2\u0d9a\u0dba \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dc1\u0dda \u0d85\u0dc1\u0db4\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0db1\u0dca \u0dbb\u0dd0\u0dc3\u0d9a\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d85\u0dc1\u0db4\u0dca \u0db4\u0dbd\u0dad\u0dd4\u0dbb\u0dd4 dehydrate \u0d9a\u0dbb\u0dbd\u0dcf \u0db4\u0dd2\u0da7\u0dbb\u0da7 \u0dba\u0dc0\u0dbd\u0dcf \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0da7\u0da7 \u0dc0\u0dd2 \u0dcf\u0dbd \u0d86\u0daf\u0dcf\u0dba\u0db8\u0d9a\u0dca \u0dc1\u0d9c\u0dc1\u0db1\u0db1 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0db1\u0dca \u0dbb\u0dd0\u0dc3\u0d9a\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d92 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0da7 \u0dc1 \u0ddd \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0dd4\u0dbb\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0d86\u0d9a\u0dcf\u0dbb\u0dba\u0da7 \u0d92 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0dc3\u0dd6\u0daf\u0dcf\u0db1\u0dda \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8\u0db8 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0d9c\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0dc3\u0dd2\u0dd2\u0d9a\u0db1\u0dc0\u0dcf."
  },
