    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0dc3\u0dcf\u0dcf\u0daf\u0db4\u0dad\u0dd2\u0dc3\u0dd4\u0dc0\u0db8\u0db1\u0dd2, \u0d85: \u0db8\u0db8 \u0dc1\u0dda \u0dc0\u0dd0\u0dba \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dca\u200d\u0dba \u0d9c\u0dd0\u0db1 \u0dcf \u0daf \u0dcf\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dca\u200d\u0dbb \u0db8\u0dc1\u0dba\u0db1\u0dca, \u0db4\u0daf\u0dbb\u0dca\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dd4\u0dc0\u0dc0\u0da7 \u0d91\u0db1 \u0d85\u0dad\u0dbb\u0dd4\u0dc0\u0dc1\u0dbb\u0dca\u0daf\u0dd3 \u0db8\u0da7 \u0d86\u0dbb\u0dc3\u0da0\u0dd2 \u0dc1\u0dc0\u0da0\u0dca\u0da0\u0dbb \u0d89\u0dad\u0daf \u0dc1\u0dda:\u0db1\u0dd3\u0dba \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0dc3\u0dba\u0d9a \u0d9c\u0dd0\u0db1 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0dcf\u0dd0\u0db8\u0dad\u0dd2\u0dc3\u0dd2 . \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0daf\u0dca \u0dc1 \u0d9c\u0db8\u0dcf \u0dad\u0daf\u0dad\u0dca\u0dad\u0daf \u0dc1\u0dcf\u0dc1\u0db1\u0d9a \u0dad\u0db8\u0db1\u0dca\u0dc1 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4\u0dc0 14\u0d9a \u0dc0\u0dba\u0dc3\u0dcf\u0dd0\u0dad\u0dd2\u0dc3 \u0daf\u0dd2\u0dba\u0dab\u0dd2\u0dba\u0dc1 \u0db1\u0dd2\u0dbb\u0dd4\u0dc0\u0dad\u0dca \u0db4\u0dd2\u0db1\u0dca\u0dad\u0dd6\u0dbb \u0dc3\u0dcf\u0db8\u0daf\u0dba \u0db8\u0daf\u0db0\u0dba\u0dc0\u0da7\u0da7 :\u0daf\u0da7\u0daf \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0da7\u0d9a\u0dc2\u0dca\u200d\u0dba\u0dcf \u0dd4\u0daf:\u0da7\u0d9a \u0da7\u0db3\u0daf \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0da7\u0daf \u0d92 :\u0dbb\u0dd4\u0dc0\u0daf\u0dc1 \u0db1\u0dd2\u0dbb\u0dd4\u0dc0\u0dad\u0dca \u0db4\u0dd2\u0db1\u0dca\u0dad\u0dd6\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0daf \u0dc1\u0da7\u0dc3\u0dcf \u0d92 \u0daf\u0dd2\u0dba\u0dab\u0dd2 \u0dc1 \u0d85\u0dda\u0db8\u0daf\u0da7 \u0db3\u0da7 \u0dcf\u0dbb \u0dad\u0dd2\u0dc3\u0dc1\u0db3\u0db1\u0dc0\u0daf. \u0d92 \u0db4\u0dd3\u0da9\u0dcf \u0daf\u0dc0 :\u0dbb\u0daf\u0d9c\u0db1\u0dca\u0db1 \u0db3\u0dd0\u0dbb\u0dd2\u0dc0 \u0d92 \u0daf\u0dd2\u0dba\u0dab\u0dd2\u0dc1 \u0d85\u0dda\u0db8\u0daf, \u0d92 \u0dad\u0daf\u0dad\u0dca\u0dad\u0daf\u0da7 \u0db4\u0dd2\u0dc4\u0dd2\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0dcf\u0daf\u0da7\u0daf \u0db8\u0dbb\u0daf :\u0db8\u0daf \u0dad\u0dd2\u0dc3\u0dc1\u0db3\u0db1\u0dc0\u0daf. \u0d85: \u0d92 :\u0dbb\u0dd4\u0dc0\u0daf\u0da7 \u0d85\u0dda\u0db8\u0daf\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0, \u0dad\u0daf\u0dad\u0dca\u0dad\u0daf\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d85: \u0dc1\u0dda \u0db4\u0daf\u0da7\u0db1\u0dc1\u0dba\u0db1\u0dca \u0dc3\u0dcf\u0db8\u0daf\u0dba\u0dba\u0da7 \u0d89\u0dd4\u0dc0\u0dbb\u0dd4 \u0dcf\u0dbb \u0dad\u0dd2\u0dc3\u0dc1\u0db3\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0db8\u0db1\u0dca\u0db1 \u0dc1\u0dda\u0dc0\u0daf. \u0dc1\u0dda\u0dcf \u0dad\u0dc0\u0dad\u0dca \u0d91\u0d9a \u0dcf \u0daf\u0dc0\u0d9a \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0db3\u0dd0\u0dc4\u0dd0, \u0d9c\u0dbb\u0dd4 \u0dc3\u0dcf\u0dcf\u0daf\u0db4\u0dad\u0dd2\u0dc3\u0dd4\u0dc0\u0db8\u0db1\u0dd2. \u0dc1\u0dda\u0dcf \u0dad\u0db8\u0dd2 \u0d85: \u0d85\u0dc1\u0db4\u0dca :\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc1 \u0dad\u0dca, \u0d9c\u0dd0\u0dc4\u0dd0\u0dd9\u0db1\u0db1\u0dca\u0dc1 \u0dad\u0dca \u0d85\u0dad\u0dca:\u0dd0\u0d9a\u0dd3\u0db8 \u0db3\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0dc1\u0dc0\u0da7\u0daf \u0dad\u0dd2\u0dc3\u0dc1\u0db3\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1\u0dda\u0dcf \u0dad\u0dc0 \u0d91\u0dcf \u0dcf \u0daf\u0dc0\u0d9a \u0dc0\u0dd2\u0dad\u0dbb\u0d9a \u0dcf\u0dbb\u0da7\u0daf, \u0dc1\u0db8\u0dad\u0dd0\u0db1 \u0d91\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0dc3\u0dba\u0d9a \u0dc0\u0dd2\u0dad\u0dbb\u0d9a \u0dcf\u0dbb\u0da7\u0daf \u0d89\u0dc0\u0dbb \u0dcf\u0dbb\u0db1\u0dca\u0db1 \u0db3\u0dd0\u0dc4\u0dd0. \u0dc1\u0dda \u0db4\u0daf\u0da7\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba \u0dd4\u0dc0\u0dc5, \u0dc1\u0dda \u0dc3\u0dcf\u0db8\u0daf\u0dba \u0d86\u0dbb\u0dca\u0dd2\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba \u0dd4\u0dc0\u0dc5 \u0dc3\u0dad\u0dca\u0dad \u0dc0 \u0dc1\u0dba\u0db1\u0dca\u0db8 \u0db4\u0daf\u0da7\u0dcf \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dc3\u0dba -\u0db3\u0da7\u0dc1 \u0d89\u0db1\u0dca\u0db1\u0daf \u0d85\u0dba- \u0dc4\u0dd0\u0dbb \u0dbd\u0dca\u0dba\u0dbd\u0dd4\u0dc1:\u0db1\u0daf\u0db8 \u0dc0\u0dd2\u0db1\u0dca\u0daf\u0dd2\u0dad\u0dc1\u0dba\u0ddd. \u0db8\u0db8 \u0dd4\u0daf\u0dd2\u0db1\u0dca \u0dc3\u0dcf \u0dc4\u0db1\u0dca \u0dcf\u0dc5 \u0dbd\u0dca\u0dd4\u0dc0\u0dc0\u0dd3\u0dc1\u0dda\u0daf\u0dd3 \u0d92 \u0dad\u0daf\u0dad\u0dca\u0dad\u0daf\u0dad\u0dca \u0dc3\u0dad\u0dca\u0dad\u0da7\u0db8 \u0dc0\u0dd2\u0db1\u0dca\u0daf\u0dd2\u0dad\u0dc1\u0dba\u0d9a.\n\n2145 2146\n\n2023 \u0dc1:\u0dc3\u0dcf\u0dd0\u0dda\u0db3\u0dbb\u0dca 04\n\n\u0d9c\u0dbb\u0dd4 \u0dc3\u0dcf\u0dcf\u0daf\u0db4\u0dad\u0dd2\u0dc3\u0dd4\u0dc0\u0db8\u0db1\u0dd2, \u0db8\u0da7 \u0db1\u0dda \u0d85: \u0dc1\u0dda \u0dc0\u0dd2\u0dc0\u0daf:\u0dba\u0da7 \u0dc3\u0dcf\u0dda\u0db3\u0db1\u0dca\u0db0 \u0dc1\u0dc0\u0db1 \u0d91\u0dcf\u0dad\u0dca \u0db8\u0dc4 \u0dc0\u0dd2\u0dc4\u0dd2\u0dc5\u0dd4\u0dc0\u0d9a. \u0dc1\u0dda\u0dcf \u0db8\u0dc4 \u0dc1\u0db3\u0daf\u0dbb\u0dd4\u0dc0\u0d9a. \u0d85\u0db4\u0dd2 \u0d94\u0d9a\u0dc1\u0dcf\u0ddd\u0db8 \u0dc1\u0db8\u0dad\u0dd0\u0db1 \u0dcf\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db8\u0dc4 \u0dc1\u0db3\u0daf\u0dbb\u0dd4\u0dc0\u0d9a. \u0d85\u0db4\u0dd2 :\u0db1\u0dca\u0db1\u0dc0\u0daf, \u0d85\u0db4\u0dd2 \u0dc1\u0dda \u0d9a\u0dd2\u0dba\u0db1 \u0dc1:\u0dd2 \u0db1\u0dca \u0d9a\u0dd2\u0dbd\u0dca\u0db8 \u0dc0\u0dd0\u0da9\u0dcf \u0d9a \u0db1\u0dd0\u0dad\u0dd2\u0dc3 \u0db3\u0dc0. \u0d85\u0db4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0daf\u0dd2\u0dd4\u0dad\u0dab\u0dd4 \u0dc3\u0dcf\u0dc3\u0dcf\u0dca \u0db4 \u0dc1\u0d9c\u0db1\u0dd0\u0dca \u0da7\u0daf, \u0dc1\u0da7\u0daf\u0d9a\u0dd4 \u0dcf \u0daf \u0dcf\u0dbb\u0da7\u0daf, \u0dc1\u0dda \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0d9c\u0dd0\u0db1 \u0dc0\u0dd2 \u0dae\u0dc1\u0dca \u0dc2\u0dca\u200d\u0dab\u0dba\u0d9a \u0dbd\u0dca\u0dd4\u0dc0 \u0dcf\u0dbb\u0da7\u0daf, \u0d85\u0dba \u0dc0\u0dd0\u0dc1 \u0d85\u0dd4 \u0db4\u0daf\u0dd4 \u0dc1\u0db4\u0db1\u0dca\u0dc0\u0daf \u0dc1\u0dba\u0ddd\u0dba\u0db1\u0daf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dcf\u0dbb\u0db1\u0dca\u0db1. \u0d91\u0dc1\u0dc4\u0db8 \u0dcf\u0dbb\u0da7\u0daf \u0d85\u0db4\u0da7 \u0dc3\u0dcf\u0dd4\u0dc0\u0da7\u0dd4 \u0dc1\u0dc0\u0da7\u0daf \u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0db1\u0dd4\u0daf\u0dad\u0dca \u0d85\u0db3\u0db8\u0dca \u0dc1\u0dbb\u0dca\u0dab\u0dd4\u0dc0\u0dcf \u0dad\u0dbb\u0dda\u0dc0\u0dad\u0dca - \u0dad \u0db4\u0dc4\u0dcf \u0dad\u0dbb\u0dda\u0dc0\u0dad\u0dca- \u0dc0\u0dd0\u0da9\u0dcf \u0d9a \u0db1\u0dd0\u0dc4\u0dd0, \u0d92 \u0d9a\u0dd2\u0dbd\u0dca \u0dc1:\u0dba\u0dcf. \u0dc1\u0db8\u0daf\u0dcf:, \u0dc1\u0dda \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0db8\u0db8 \u0d9c\u0db8\u0db1\u0dcf . \u0dc1\u0dda \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dbd\u0dca\u0dba\u0dbd\u0dd4 \u0d86\u0dba\u0dad\u0db1 \u0db4\u0daf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0da0\u0dd2 \u0dcf\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dad\u0dca \u0d92 \u0d9c\u0db8\u0db1 \u0dba\u0dd1\u0db8 \u0dc3\u0dcf \u0dc4\u0daf \u0db8\u0dd2\u0dc3\u0dcf\u0d9a, \u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0dba\u0db1\u0dad\u0daf\u0dc0 \u0dc1\u0dc0\u0dd9\u0db1\u0dc1\u0dc0\u0db1\u0dca \u0dc1\u0db1\u0daf\u0dc1\u0dc0\u0dd2 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0dcf \u0d89\u0dad\u0daf\u0db8 \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dd2 ."
