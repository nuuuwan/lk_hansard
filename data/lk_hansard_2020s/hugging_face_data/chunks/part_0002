    "chunk_text": "\u0d92 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dda\u0dc1\u0dda \u0dc1\u0dc4 \u0d9a\u0d9a\u0dca\u0db1? \u0db1\u0dd0\u0db1\u0da7 \u0dbb\u0dca\u200d\u0dba\u0da7 \u0db8\u0dd4\u0db1\u0dbd\u0dca \u0db1\u0dd0\u0db1\u0dd0, \u0db8\u0dd4\u0db1\u0dbd\u0dca \u0db1\u0dd0\u0dd2 \u0db1\u0dd2\u0dc3\u0dc4 \u0dba\u0db8\u0dca \u0dba\u0db8\u0dca \u0dc0\u0dba\u0dc4\u0db4\u0dd2\u0dd2 \u0d85\u0dc0\u0dbd\u0d82\u0d9c\u0dd4 \u0d9a\u0dbb\u0db1 \u0db6\u0dc0\u0dad\u0dca, \u0d91\u0dc1\u0dc3\u0dda \u0d85\u0dc0\u0dbd\u0d82\u0d9c\u0dd4 \u0d9a\u0dbb\u0db1 \u0dc0\u0dba\u0dc4\u0db4\u0dd2\u0dd2 \u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0d91\u0d9a\u0d9a\u0dca \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dd4\u0dc5\u0dbb \u0d85\u0db0\u0dd2\u0dc1\u0dda \u0db8 \u0dc4\u0dc4\u0dbb\u0dca) \u0dc0\u0dba\u0dc4\u0db4\u0dd2\u0dd2 \u0dba \u0db6\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dda\u0dc0\u0dc4. \u0d92\u0d9a \u0d85\u0db1\u0dd4\u0dc5 \u0dc1\u0dc0\u0dbd\u0dc4\u0dc1\u0dda \u0d89 \u0dbd\u0dc4 \u0d85\u0db4\u0dd2 \u0d92\u0d9a\u0da7 \u0dd2\u0db0\u0dbb\u0dd4\u0dda\u0db0 \u0dc0\u0dd4 \u0dc4. \u0dd2\u0db0\u0dbb\u0dd4\u0dda\u0db0 \u0dc1\u0dc0\u0dbd\u0dc4 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dc1\u0dda \u0dd2\u0db1\u0dba\u0dbd\u0dd4 \u0dc4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4 \u0db4\u0d9a\u0dca\u0dc2 \u0dc1\u0dda\u0db1\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0dad \u0dbb\u0dc0 \u0d91\u0d9a\u0dc4 \u0dc0\u0dc4\u0dc1\u0dda \u0db1\u0dd0\u0d9f\u0dd3 \u0dd2\u0db1\u0da7\u0dd2\u0dba\u0dc4. \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0d9a\u0dd4\u0dc4\u0d9a\u0dca \u0dc0\u0dd4\u0dc0\u0dad\u0dca \u0dd2\u0db1\u0dba\u0dbd\u0dd4\u0dc1\u0db1\u0db1\u0dc4 \u0d9a\u0dd2\u0dda\u0dc0\u0dc4, \u0dc1\u0db8\u0dca \u0dc0\u0dba\u0dc4\u0db4\u0dd2\u0dd2 \u0dba \u0dbb\u0dad\u0dca\u0db1\u0dd4\u0dc5\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dc1\u0dda \u0dca\u200d\u0db1\u0dad\u0dc4\u0dc0 \u0daf\u0dd3\u0dbb\u0dca \u0d9a\u0dc4\u0dbd\u0dba\u0d9a\u0dca \u0dd2 \u0dc3\u0dca\u0dc1\u0dc3\u0dda \u0db6\u0dbd\u0dc4\u0dc1\u0db4 \u0dc1\u0dbb \u0dad\u0dca\u0dad\u0dd4 \u0dad\u0db6\u0dc4\u0dc1)\u0db1 \u0dc4\u0dd2\u0da7\u0dd4\u0dc5 \u0d91\u0d9a\u0d9a\u0dca \u0db1\u0dd2\u0dc3\u0dc4 \u0d92\u0d9a \u0d9a\u0da9 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dc4 \u0d9a\u0dd2\u0dba\u0dbd\u0dc4. \u0dc4\u0dc4 \u0d9a\u0dd2\u0dc4\u0dd2\u0db4 \u0dc0\u0dad\u0dc4\u0dc0\u0d9a\u0dca\u0dc4 )\u0dbb\u0dd4 \u0dca\u200d\u0db1\u0dc4\u0db0\u0dd2\u0db4\u0dd2 \u0dad\u0dd4\u0dc4\u0dc4\u0dad\u0dca \u0db8\u0dd4 )\u0dd0\u0dc4\u0dd2\u0dbd\u0dc4 \u0dc1\u0db8\u0dca )\u0dd0\u0db1 \u0d9a\u0dae\u0dc4 \u0d9a\u0dc5\u0dc4. \u0d91\u0dad\u0dd4\u0dc4\u0dc4\u0dad\u0dca \u0dc1\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0dba\u0db1\u0dca \u0db1\u0dbb\u0dd2\u0dba\u0da7 \u0dad\u0dad\u0dca\u0dad\u0dbb\u0dba\u0d9a\u0dca \u0daf\u0dd4\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dd2 \u0dc0\u0dd4 \u0dad\u0dca,\n\n1351 1352\n\n\u0db4\u0dc4\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0"
  },
