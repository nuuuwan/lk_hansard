    "chunk_text": "\u0d94\u0db6\u0dad\u0dd4\u0dcf\u0daf \u0d91\u0dad\u0dd0\u0db1\u0daf\u0dd3 \u0d92 \u0db1\u0dd2\u0dca \u0dcf\u0daf \u0dca\u0dc4\u0d9c\u0dad \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dca\u200d\u0d9a\u0da7 \u0dc1\u0db1\u0daf\u0dc0\u0dca\u200d\u0dd0\u0da7\u0dd3 \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dcf\u0da7 \u0d9a\u0db8\u0dca \u0d86 \u0daf \u0d9a \u0da7 \u0d85\u0dcf\u0dc4\u0dca\u0dae \u0db4 \u0daf. \u0d85\u0dc0\u0dca\u200d\u0daf\u0dca\u0db1\u0daf\u0dc0\u0dca\u200d \u0da7 \u0dcf\u0daf\u0db1\u0daf\u0d9a \u0dad\u0dd4\u0dcf\u0daf\u0dad\u0dca, \u0dca\u0dcf\u0daf\u0db1\u0daf\u0d9a \u0dad\u0dd4\u0dcf\u0daf\u0dad\u0dca \u0d91\u0dc0\u0dca\u200d\u0dd0\u0db1\u0dd2 \u0dca\u200d\u0dbb\u0da5\u0daf\u0dca\u0db8\u0dca\u0db4\u0dca \u0db1 \u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf \u0dcf\u0daf\u0d9a\u0d9c\u0d9a \u0da7 \u0dc1\u0d9a\u0daf\u0db8\u0dd4 \u0dc0\u0dd4\u0dc1\u0dab\u0dca\u0da9 \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0db4\u0dd2 \u0d92 \u0d9c\u0dd0\u0db1 \u0db1\u0d9c\u0daf\u0da7\u0dd4 \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dc0\u0dca\u200d\u0daf. \u0d92\u0dad\u0dca \u0d91\u0d9a\u0dca\u0dc2 \u0dcf \u0d85\u0db4\u0dd2 \u0d94\u0db6\u0dad\u0dd4\u0dcf\u0daf\u0da7 \u0d85\u0dc1\u0db4\u0dca \u0dca\u200d\u0dbb\u0dca\u0daf\u0dcf\u0d9a \u0dc4\u0daf \u0dca\u200d\u0dbb \u0dc3\u0dca\u0daf\u0dc0\u0dca\u200d \u0db4 \u0db1\u0dc0\u0dca\u200d\u0daf, \u0d92 \u0dcf\u0d9a\u0dca\u0dc2\u0dc0\u0dca\u200d\u0db4\u0dd4 \u0dca\u0dae\u0dc0\u0dca\u200d\u0daf\u0db0\u0dd3\u0db1\u0dad\u0dca\u0dc0\u0dca\u200d\u0d9a \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dd4\u0dc1\u0dc0\u0dca\u200d\u0dca .\n\n\u0d9c\u0dd4\u0dc0 \u0dc3\u0dcf\u0dd2\u0dbb\u0dad\u0dd4\u0dcf\u0db1\u0dd2, \u0d94\u0db6\u0dad\u0dd4\u0dcf\u0daf \u0dcf\u0dca \u0db1\u0dc0\u0dca\u200d\u0daf, \u0dc0\u0dd2\u0dc3\u0dd2\u0d91\u0d9a\u0dca\u0dc2\u0dc0\u0dca\u200d\u0db1 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0dcf \u0dc0\u0dca\u200d\u0dba\u0dc0\u0dca\u200d\u0dca\u0dae\u0dcf\u0daf \u0dca\u0dc3\u0dc1 \u0ddd\u0db0\u0db1\u0d9a, \u0d8a\u0da7 \u0dc1\u0db4 \u0dd2\u0dbb\u0db6\u0dd4\u0dab\u0dd4 \u0dcf\u0dc4\u0db1\u0dc0\u0dca\u200d \u0dc0\u0dca\u200d\u0db1 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0dcf \u0dc0\u0dca\u200d\u0dba\u0dc0\u0dca\u200d\u0dca\u0dae\u0dcf\u0daf \u0dca\u0dc3\u0dc1 \u0ddd\u0db0\u0db1\u0d9a \u0dc0\u0dca\u200d\u0daf\u0dc1\u0dda \u0dc1\u0db1\u0daf\u0dc1\u0dc0\u0dca\u200d\u0dba\u0dd2 \u0d9a\u0dd2\u0d9a\u0db1 \u0d91 . \u0dc1\u0db8\u0dca\u0dc1 \u0dca \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dc0\u0dca\u200d\u0dcf \u0d92 \u0d92 \u0db4\u0d9a\u0dca\u0dc2\u0dc2\u0dc0\u0dca\u200d\u0dbd \u0dc1\u0dbd\u0dca \u0db8\u0dca\u0dc0\u0dca\u200d\u0dd4\u0dc0\u0dca \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dd4\u0dc0\u0dca\u200d\u0da7 \u0d92 \u0d92 \u0dcf\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\n\n2027 2028\n\n\u0db4\u0daf\u0d9a\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd4\u0dc0\u0dca\u200d"
  },
