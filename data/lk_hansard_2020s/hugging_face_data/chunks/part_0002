    "chunk_text": "\u0dc5\u0daf. \u0d85\u0dcf \u0d85\u0db0\u0dca\u200d\u0dba\u0daf\u0db4 \u0d9a \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dcf\u0daf \u0db1\u0dca\u0dc1\u0db1\u0dca \u0d92 \u0dcf\u0daf\u0dc1\u0dda \u0daf\u0dd2\u0d9c\u0dd4\u0dc0\u0dca\u200d\u0dca \u0dc3\u0dd2\u0db0\u0dd2\u0d9a\u0da7\u0dba\u0dd2, \u0d9c\u0dbb\u0dd4 \u0dd2\u0dc1\u0d9a\u0ddd\u0da2\u0dba \u0dca\u0dcf\u0daf\u0db4\u0dd2\u0dbb\u0dad\u0dd4\u0db8\u0dd2. \u0da7\u0dca \u0dc3\u0dd2\u0db0\u0dd2\u0d9a\u0da7 \u0d85\u0db4\u0da7 \u0dc0\u0dca\u200d\u0dd0 \u0dd4\u0dbb\u0dab\u0dd4 \u0dc1\u0dc0\u0dca\u200d\u0dbd\u0daf\u0dc1\u0dda \u0d85\u0db4\u0dd2 \u0dc4\u0dbb\u0dd2\u0d9a\u0da7 \u0dbd\u0dca\u0db4 \u0daf \u0dc5\u0daf , \u0dc3\u0dad\u0dca\u0dc0\u0dad\u0db8 \u0d85\u0dc0\u0dd4\u0dbd \u0d85\u0db4\u0da7 \u0dc1\u0dad\u0dca\u0dc0\u0dc1 \u0db1\u0dca \u0d95 \u0dd1. \u0dc1 \u0dc1\u0db4 \u0dc1\u0dc4\u0daf\u0dbb\u0dd4, \u0dc1\u0db8\u0ddd\u0da9\u0dcf\u0dc1\u0d9a\u0ddd, \u0daf\u0dd6\u0dd2\u0dad\u0dc1\u0d9a\u0ddd \u0dc3\u0dd2\u0dad \u0dca \u0dc1 \u0daf\u0dc1\u0dc0\u0dca\u200d\u0dba\u0dd2. \u0dc1\u0daf\u0dca \u0db4\u0daf\u0dbd \u0da5\u0dc1\u0d9a\u0ddd, \u0dc3\u0dd2\u0daf\u0dca\u0dc0\u0dca\u200d\u0dad\u0dca\u0dc0 \u0db4\u0dd4 \u0dc0\u0dca\u200d\u0dd0\u0db1\u0dca\u0d9a\u0db1\u0dca \u0db4\u0dc0\u0dca\u200d\u0daf \u0dd2\u0d9a\u0db8\u0daf\u0dab\u0dca\u200d\u0d9a \u0dc0\u0dd4\u0dc1\u0dca \u0db4\u0dd0\u0dc0\u0dca\u200d\u0dd0\u0dd2\u0dbb \u0d85\u0db0\u0dca\u200d\u0dba\u0daf\u0db4 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbb\u0dbd\u0dbd\u0d9a\u0dca \u0dc3\u0dd2\u0db0\u0dd2\u0d9a\u0da7. \u0d85\u0db4\u0dd2 \u0d85\u0db0\u0dca\u200d\u0dba\u0daf\u0db4 \u0d9a \u0dd2\u0dcf\u0dc4\u0dca\u0dae \u0dbb\u0dd3\u0d9a\u0dbd\u0daf \u0d8b\u0dcf\u0db1\u0dca \u0dc3\u0dab\u0dd4\u0dc0\u0dca\u200d\u0dad\u0dca\u0dc0, \u0d92 \u0dc4 \u0dc4\u0daf \u0d85\u0db4\u0da7 \u0d85\u0dcf \u0dc0\u0dca\u200d \u0dad\u0dd4\u0dbb\u0dd4 \u0da7\u0da7 \u0d85\u0dc0\u0dca\u200d \u0dba \u0dca\u0daf\u0db0\u0dca\u200d\u0db1\u0dd3\u0d9a \u0db4\u0dd4 \u0dc0\u0dca\u200d\u0dd0\u0db1\u0dca\u0d9a\u0db1\u0dca \u0dd2\u0d9a\u0db8\u0daf\u0dab\u0dca\u200d\u0d9a \u0db1\u0dca \u0db6\u0dd0\u0dbb\u0dd2\u0dc0\u0dd4\u0dab\u0dca\u200d\u0daf.\n\n\u0d9c\u0dbb\u0dd4 \u0dd2\u0dc1\u0d9a\u0ddd\u0da2\u0dba \u0dca\u0dcf\u0daf\u0db4\u0dd2\u0dbb\u0dad\u0dd4\u0db8\u0dd2, \u0dc1\u0db8\u0dc0\u0dca\u200d \u0d85\u0d9a \u0dc0\u0dca\u200d\u0dd0\u0dc1\u0d9a\u0db1\u0dca 2024 \u0dc0\u0dca\u200d\u0dca\u0dc1\u0d9a \u0db1\u0dca\u0da7 2034 \u0dc0\u0dca\u200d\u0dca \u0dcf\u0dca\u0dc0\u0dca\u200d\u0daf \u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dad\u0dca\u0dc0\u0db8 \u0d89\u0dca\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0db1\u0dca \u0dcf\u0daf\u0dc2\u0daf\u0dc0\u0dca\u200d \u0d89\u0dc4\u0dc5 \u0dd0\u0dca\u0dd3\u0dc1 \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dcf\u0dca\u0da7\u0dc4 \u0dca\u0db3\u0dc4\u0daf \u0dbb\u0dd4\u0db4\u0dd2\u0d9a\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0d9a 500\u0dca \u0d9c\u0dbb\u0dd4 \u0da2 \u0daf\u0db0\u0dd2\u0db4\u0dd2\u0dbb\u0dad\u0dd4\u0db8\u0daf \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dca \u0dbd\u0daf \u0dd2\u0dbb\u0dc1\u0db6 \u0dc0\u0dca\u200d\u0daf. \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0db8\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0d9a\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0d9a 500 \u0dc0\u0dca\u200d\u0da7\u0dd2 \u0daf \u0db8\u0dca \u0dc1 \u0daf\u0dc1\u0dc0\u0dca\u200d\u0dba\u0dd2 \u0dbb\u0dd3\u0d9a\u0dbd\u0daf\u0dba\u0dd2. \u0db6\u0dd2\u0dd2\u0d9a 500 \u0da7 \u0dc0\u0dca\u200d\u0da9\u0dcf\u0daf \u0dc0\u0dca\u200d\u0da7\u0dd2 \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0dc1\u0dc0\u0dca\u200d\u0dc5\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0dc0\u0dca\u200d\u0d9a\u0dad\u0db8\u0daf \u0d9a \u0dad\u0dd4\u0dc5 \u0dca\u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dad\u0dca\u0dc0\u0db8 \u0dbd\u0daf \u0dd2\u0dbb\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca.\n\n\u0da2\u0dc1\u0dda \u0db4\u0daf\u0dca\u0dbd\u0dca \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dca\u200d \u0d9a\u0d9a\u0dd4 \u0dc3\u0dd2\u0db0\u0dd2\u0d9a\u0da7 \u0db8\u0db8 \u0dcf\u0db1\u0dca \u0dc0\u0dca\u200d\u0daf, \u0dc1 \u0dc1\u0db4 \u0dcf\u0dbb\u0dd4\u0dc0\u0dca\u200d\u0db1\u0dca\u0da7 \u0d89\u0dc1\u0d9c \u0d9c\u0db1\u0dca \u0d85\u0db8\u0daf\u0dbb\u0dd4\u0db8 \u0dc3\u0dd2\u0dc2\u0d9a \u0d89\u0dca\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0db1\u0dca \u0db6\u0dc0\u0dca\u200d. \u0d85\u0dc1\u0dbb \u0db4 \u0db4 \u0daf\u0dc0\u0dca\u200d\u0da7 \u0d89\u0dca\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0db1\u0dca \u0dc0\u0dca\u200d\u0dc4 \u0dd4\u0dbb\u0dbb\u0dd4 \u0dc0\u0dca\u200d\u0daf\u0dc1\u0d9c\u0dca\u0db0\u0db1. \u0d85\u0dc1\u0dbb \u0db4\u0daf\u0dca\u0dbd\u0dca \u0db4\u0daf\u0dca\u0db0\u0dca\u200d\u0dd2\u0dbb\u0dc1\u0dda \u0d89\u0dca\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0db1\u0dca \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dca\u200d\u0dbb\u0dd4 \u0dca\u0dc4 \u0dc3\u0dd2\u0dc2\u0d9a \u0dd2\u0d9a\u0dc1\u0daf\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0dc1 \u0da7 \u0dc1\u0dc4\u0dae\u0dad\u0dd4\u0dc0\u0dca\u200d.\n\n\u0dc1 \u0daf\u0dc5\u0dc0 \u0dc3\u0dad\u0dd4\u0dc5\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dca\u200d\u0daf \u0d9c \u0dc0\u0dca\u200d\u0dbd\u0da7 \u0dc1 \u0dcf\u0dd0\u0dc1 \u0db1\u0dca\u0dc1\u0db1\u0dca \u0dd0\u0dc4\u0dd0. \u0d85\u0dcf\u0dad\u0dca\u0dc0 \u0d9c\u0dc1 \u0d85.\u0dc1\u0db4\u0daf.\u0dca. \u0dca\u0daf\u0db8\u0daf \u0dba \u0dc1\u0db4\u0dc5 \u0db4\u0daf\u0dca\u0dae \u0dc0\u0dca\u200d \u0dcf\u0dbb\u0dd4\u0dc0\u0dca\u200d\u0daf \u0d89\u0dca\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0db1\u0dca \u0dc3\u0dd2\u0dc2\u0d9a \u0dc1\u0dc6\u0dae\u0dbd\u0dca \u0dc1\u0dc0\u0dca\u200d \u0dc0\u0dca\u200d\u0daf. \u0dc1 \u0dc1\u0dda\u0dcf\u0dc0\u0dca\u200d\u0daf\u0da0 \u0d9a\u0dca. \u0d89\u0dca\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0db1\u0dca \u0dc1\u0dc6\u0dae\u0dbd\u0dca \u0dc0\u0dd4\u0dab\u0dca\u200d\u0daf\u0da7 \u0db4\u0dca\u0dae\u0dc1\u0dca\u0dae \u0da2\u0dd3\u0dc3\u0dd2\u0dad\u0d9a \u0dc1\u0dc6\u0dae\u0dbd\u0dca \u0db1\u0dca \u0dc1\u0dbd\u0daf\u0d9a\u0dd4 \u0dc1\u0dbd\u0daf\u0dca\u0dc1 \u0ddd \u0db6\u0dbd\u0daf\u0dc1\u0d9c \u0d89\u0db1\u0dca \u0dc0\u0dca\u200d\u0daf. \u0d91\u0db8 \u0dd2\u0dca\u0daf\u0dba\u0dd2 \u0db8\u0db8 \u0dbb\u0dd3\u0d9a\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0dc1 \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dcf\u0dca\u0da7\u0dc4 \u0db8\u0dd2\u0dd2\u0d9a \u0dc1 \u0daf\u0dc1\u0dc0\u0dca\u200d\u0dba\u0dd2, \u0db6\u0dd2\u0dd2\u0d9a \u0d9c\u0dab\u0dca\u200d\u0db1\u0dca \u0dc0\u0dca\u200d\u0da7\u0dd2 \u0daf \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dcf\u0dca\u0da7\u0dc4 \u0dca \u0dbb\u0dd3\u0d9a\u0dbd\u0daf."
