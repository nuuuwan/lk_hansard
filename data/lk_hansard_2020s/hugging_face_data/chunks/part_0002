    "chunk_text": "\u0db8\u0dd6\u0da7\u0daf\u0dc3\u0dcf\u0db1\u0daf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dd4\u0dc0\u0db8\u0db1\u0dd2, \u0db4\u0dca\u200d\u0dbb\u0dc0\u0daf\u0dc4\u0db1 \u0dc4\u0daf \u0db8\u0dc4\u0daf\u0db8\u0daf\u0dbb\u0dca\u0d9c \u0d85\u0db8\u0daf\u0dad\u0dba\u0daf\u0dc3 \u0dba, \u0db1\u0daf\u0d9c\u0dbb\u0dd2\u0dcf \u0dc3\u0dcf\u0dc3\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc4\u0daf \u0db1\u0dd2\u0dc0\u0daf\u0dc3\u0dcf \u0d85\u0db8\u0daf\u0dad\u0dba\u0daf\u0dc3 \u0dba \u0d86\u0daf\u0dd3 \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0d85\u0db8\u0daf\u0dad\u0dba\u0daf\u0dc3 \u0d9c\u0dab\u0db1\u0daf\u0dc0\u0d9a \u0dad\u0dd2\u0dc3\u0dc1\u0db3\u0db1\u0dc0\u0daf. \u0dc3\u0dcf\u0dc3\u0dbb\u0daf\u0dbb\u0dcf \u0dc4\u0daf \u0d89\u0da9\u0dcf \u0dda \u0d85\u0db8\u0daf\u0dad\u0dba\u0daf\u0dc3 \u0dba\u0dad\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0daf \u0dc3\u0db8\u0dad\u0dd2\u0dc3\u0dd4\u0dc0\u0db8\u0daf \u0dba\u0da7\u0dc1\u0dad\u0dca\u0db8 \u0dad\u0dd2\u0dc3\u0dc1\u0db3\u0db1\u0dc0\u0daf. \u0dc4\u0dd0\u0db3\u0dd0\u0dd2 , \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0daf \u0dc4\u0daf \u0dc1\u0dba\u0dde\u0dc0\u0db1 \u0dcf\u0da7\u0dd4\u0dad\u0dd4\u0dc0 \u0d85\u0db8\u0daf\u0dad\u0dba\u0daf\u0dc3 \u0dba \u0db8\u0db8 :\u0d9a\u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0dc1\u0dc0\u0db1\u0db8 \u0dcf\u0daf\u0dc2\u0dca\u200d\u0daf\u0dc0\u0d9a - language \u0d91\u0dcf\u0d9a - \u0dc0 \u0dc1\u0dba\u0db1\u0dca. \u0dc0\u0dd2 \u0dae\u0dc0 \u0dcf\u0daf\u0dc2\u0dca\u200d\u0daf\u0dc0\u0d9a \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0dad\u0db8\u0dd2 \u0db8\u0db8 \u0d91\u0dba :\u0d9a\u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dad\u0dbb\u0dd4\u0dab \u0dad\u0dbb\u0dd4\u0dab\u0dd2\u0dba\u0db1\u0dca \u0d91\u0d9a\u0dcf \u0d91\u0dcf\u0da7 \u0dc0\u0dd0\u0da9\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0daf\u0dc0\u0dad\u0dca \u0d91\u0d9a\u0dcf \u0d91\u0dcf\u0da7 \u0dcf\u0da7\u0dd4\u0dad\u0dd4\u0dc0 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc1\u0dc0\u0db1\u0db8 \u0dc0\u0dd2\u0dc2\u0dca\u200d\u0dba \u0db4 \u0dba\u0d9a \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dad\u0db8\u0dd2 \u0db8\u0db8 :\u0d9a\u0dd2\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1\u0dda \u0d85\u0dc0\u0dc3\u0dcf\u0dae \u0daf\u0dc1 \u0daf\u0dd3 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0daf \u0d85\u0db8\u0daf\u0dad\u0dba\u0daf\u0dc3 \u0dc1 \u0dc1\u0dca \u0dcf\u0dda\u0dd4\u0dc0\u0db8\u0db1\u0dca\u0da7\u0daf, \u0d85\u0db0\u0dba\u0d9a\u0dc2\u0dca\u200d \u0dba\u0db1\u0dbb\u0daf\u0dca \u0dc0\u0dbb\u0dba\u0daf \u0dc3\u0dd4\u0dc0\u0dc5\u0dd4 \u0db1\u0dd2\u0da7\u0db0\u0daf\u0dbb\u0dd2\u0db1\u0dca \u0dbd\u0dca\u0dba\u0dbd\u0dd4\u0dc1:\u0db1\u0daf\u0db8 \u0d9c\u0dbb\u0dd4 \u0dc3\u0dcf\u0dcf\u0daf\u0dc1 \u0dbb\u0dba\u0dc1 \u0db1\u0dd2\u0da7\u0db0\u0daf\u0dbb\u0dd2\u0db1\u0dca\u0dc1 \u0d9a\u0dd4\u0da7\u0dd2\u0dc1 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0daf. \u0d9c\u0dbb\u0dd4 \u0d85\u0db8\u0daf\u0dad\u0dba\u0dd4\u0dc0\u0db8\u0daf\u0dc1 \u0db1\u0daf\u0dba\u0dcf\u0dad\u0dca\u0dc0\u0dc1\u0dba\u0db1\u0dca \u0dd4\u0dad\u0dd4\u0dc0\u0dc0 2024 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0dc1\u0daf\u0dca \u0d85\u0db4\u0dd2 \u0dc1\u0dda \u0dc0\u0dd0\u0da9\u0dcf \u0dcf\u0da7\u0dd4\u0dad\u0dd4\u0dc0 \u0d86\u0dbb\u0dda\u0dcf \u0dcf\u0dbb\u0db1\u0dc1\u0dcf\u0daf\u0da7, \u0d85\u0db4\u0dd2 \u0d94\u0d9a\u0dc1\u0dcf\u0ddd\u0db8 \u0d91\u0dcf \u0dcf\u0dab\u0dca\u0da9\u0da9\u0dcf \u0daf\u0dba\u0db8\u0d9a \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0dc1\u0db4\u0dca \u0dad\u0dd2\u0dc3\u0dc1\u0db3\u0db1 \u0d85\u0dd4\u0db4\u0daf\u0dd4\u0dcf\u0dda \u0dc1\u0dc3\u0dcf\u0daf\u0dba\u0daf \u0db3\u0da7\u0daf \u0dcf\u0da7\u0dd4\u0dad\u0dd4\u0dc0 \u0dcf\u0dc5 \u0dd4\u0dad\u0dd4\u0dc0\u0dd2 .\n\n\u0db8\u0db8 \u0d8a\u0dc1 \u0dc4\u0dc0\u0dc3\u0dcf Muay Thai \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dca \u0db8\u0dc4\u0daf \u0dad\u0dbb\u0d9c \u0db3\u0da7\u0db1\u0dca\u0db1 \u0dd4\u0d9c\u0dad:\u0daf\u0dc3\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0daf \u0db4\u0dd2\u0da7\u0dd2\u0dba\u0da7 \u0d9c\u0dd2\u0dba\u0daf. \u0d91\u0dad\u0dd0\u0db1\u0da7 \u0d9c\u0dd2\u0dba\u0daf\u0da7 \u0db4\u0dc3\u0dcf\u0dae\u0dc1\u0dc3\u0dcf\u0dae \u0dad\u0db8\u0dd2 \u0db8\u0da7 :\u0dd0\u0db1 \u0d9c\u0db1\u0dca\u0db1 \u0da7\u0dd0\u0dab\u0dd4\u0dc1\u0dab\u0dca\u0da9, \u0dcf\u0dab\u0dca\u0da9\u0da9\u0dcf \u0daf\u0dba\u0dda \u0dc1:\u0dcf\u0d9a \u0d85\u0dad\u0dbb \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0d9a \u0dad\u0dd2\u0dc3\u0dc1\u0db3\u0db1\u0dc0\u0daf \u0d9a\u0dd2\u0dba\u0da7\u0daf. Muay Thai \u0dc1\u0db1\u0daf\u0dc1\u0dc0\u0dd2 , handball \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0daf\u0dc0. \u0d92 \u0dcf\u0dab\u0dca\u0da9\u0da9\u0dcf \u0daf\u0dba\u0dda \u0dc1:\u0dcf\u0d9a \u0d85\u0dad\u0dbb \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0d9a \u0dad\u0dd2\u0dc3\u0dc1\u0db3\u0db1\u0dc0\u0daf. \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dcf\u0dab\u0dca\u0da9\u0da9\u0dcf \u0daf\u0dba\u0db8 \u0dc3\u0dcf\u0dc4 \u0dbd\u0dca\u0da7\u0dd2\u0db1 \u0dcf\u0dab\u0dca\u0da9\u0da9\u0dcf \u0daf\u0dba\u0db8 \u0d85\u0dad\u0dbb \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0d9a \u0dad\u0dd2\u0dc3\u0dc1\u0db3\u0db1\u0dc0\u0daf. \u0dc4\u0dd0\u0db8:\u0daf\u0db8 \u0d92 \u0dcf\u0da7\u0dca\u0da7\u0dd2\u0dba \u0d9c\u0dc4 \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0daf, \u0db3\u0dd0\u0dab \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0daf. \u0d89\u0dad\u0dd2\u0dc3\u0db1\u0dca, \u0d85\u0dc1\u0db4\u0dca \u0db1\u0dc0 \u0d85\u0db8\u0daf\u0dad\u0dba\u0dd4\u0dc0\u0db8\u0daf \u0dba\u0da7\u0dc1\u0dad\u0dca \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d91\u0d9a\u0dcf \u0dc3\u0dcf\u0daf\u0dcf\u0da0\u0dca\u0da0\u0da1\u0daf \u0dcf\u0dbb\u0da7\u0daf \u0dc3\u0dcf\u0daf\u0dcf\u0da0\u0dca\u0da0\u0da1\u0daf\u0dc1\u0dc0\u0db1\u0dca, \u0dc3\u0dcf\u0dda\u0dd4\u0daf\u0dad\u0dd2\u0dc3\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0dda \u0d9c\u0dd0\u0da7\u0dbd\u0dd4 \u0dc0\u0dd2\u0dc3\u0dcf \u0daf \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0daf\u0dad\u0dca \u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0daf\u0dc0 \u0db3\u0daf\u0db0\u0daf\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0dad\u0daf\u0dbb\u0dc0 \u0d89\u0dc3\u0dcf\u0dae\u0dc3\u0dcf\u0dbb\u0dc4\u0da7 \u0dc1\u0d9c\u0db1 \u0dba\u0db1\u0dca\u0db1 \u0d85\u0db4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc1\u0dc0\u0dd2 \u0d9a\u0dd2\u0dba\u0da7\u0daf \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0db1\u0dc0\u0daf. \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dcf\u0da7\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0daf\u0dc1 \u0dc0\u0dd4\u0dab\u0dad\u0dca \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0dad\u0dd2\u0dc3\u0dc1\u0db3\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d89\u0dad\u0dd2\u0dc3\u0db1\u0dca \u0d92 \u0db1\u0dd2\u0dc3\u0dcf\u0daf \u0d85\u0db4\u0dd2 \u0d94\u0d9a\u0dc1\u0dcf\u0ddd\u0db8 \u0d91\u0dcf\u0dd4\u0dc0 \u0dc1\u0dc0\u0da7\u0daf \u0dc1\u0dda \u0db3\u0daf\u0db0\u0dcf \u0d85\u0dd2 \u0db1\u0dca \u0dcf\u0dbb :\u0db8\u0da7\u0daf \u0dc3\u0dcf\u0daf\u0dcf\u0da0\u0dca\u0da0\u0da1\u0daf\u0dc1\u0dc0\u0db1\u0dca, \u0dc3\u0dcf\u0dda\u0dd4\u0daf\u0dad\u0dd2\u0dc3\u0dc1\u0dba\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0daf\u0dc0 \u0d89\u0dc3\u0dcf\u0dae\u0dc3\u0dcf\u0dbb\u0dc4\u0da7 \u0dc1\u0d9c\u0db1 \u0dba\u0dd1\u0db8 \u0dc3\u0dcf \u0dc4\u0daf \u0dcf\u0da7\u0dd4\u0dad\u0dd4\u0dc0 \u0dcf\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1\u0dba \u0d9a\u0dd2\u0dba\u0da7\u0daf \u0db8\u0db8 \u0dc0\u0dd2 \u0dae\u0dc0\u0daf\u0dc3\u0dcf \u0dcf\u0dbb\u0db1\u0dc0\u0daf, \u0db8\u0dd6\u0da7\u0daf\u0dc3\u0dcf\u0db1\u0daf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dd4\u0dc0\u0db8\u0db1\u0dd2."
