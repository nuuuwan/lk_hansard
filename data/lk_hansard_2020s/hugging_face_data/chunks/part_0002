    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7 \u0d9a\u0dd2\u0dda\u0dc0\u0dc4, \u0dc3\u0dd2\u0d9a\u0dad\u0dca \u0dc1\u0db4\u0dca\u200d\u0dbb\u0dda\u0dc4\u0db1\u0dc4\u0dc3 \u0d85\u0db1 \u0dc1\u0db8\u0dca \u0dc3\u0db7\u0dc4\u0dc1\u0dda \u0db1\u0dd0\u0db1\u0dd0 \u0dbd\u0dd4. \u0dc3\u0dba\u0dd2, \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0dc4\u0dd2\u0da7\u0dd4\u0dc5 \u0dc3\u0dc4\u0dd2 \u0dc0\u0dbb\u0dd4 \u0d94\u0d9a\u0dca\u0dc1\u0d9a \u0dc4 \u0dc1\u0dc4\u0dad\u0dd0\u0db1 \u0d89\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1\u0db1? \u0d85\u0db1 \u0dd2\u0db0\u0dc0\u0dc4\u0db1\u0dba\u0da7 \u0d85\u0db1\u0dc4\u0dc5 \u0dd2\u0db0\u0dc2\u0dba \u0db7\u0dc4\u0dbb \u0dc3\u0dc4\u0dd2 \u0dc0\u0dbb\u0dba\u0dc4\u0dad\u0dca \u0dc1\u0db8\u0dca \u0dc1\u0dc4 \u0dc1\u0db1 \u0dc1\u0dad\u0dca \u0dd4\u0dc5\u0dd4\u0db4\u0dc1\u0dda \u0db1\u0dd0\u0db1\u0dd0. \u0d85\u0dc4\u0dc4\u0dad\u0dba\u0dc4\u0d82 \u0db7\u0dc4\u0dbb \u0dc3\u0dc4\u0dd2 \u0dc0\u0dbb\u0dd4\u0dad\u0dca \u0dc1\u0db8\u0dca \u0dc1\u0dc0\u0dbd\u0dc4\u0dc1\u0dda \u0db1\u0dd0\u0db1\u0dd0. \u0da9\u0dd3. \u0dc0\u0dd3\u0dbb\u0dd2\u0db1\u0d82\u0db1 \u0dc4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0dc4\u0dc4 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dc4 \u0dc4\u0dd2\u0da7\u0dd4\u0dc5 \u0dc3\u0dc4\u0dd2 \u0dc0\u0dbb\u0dba\u0dc4 \u0dd2\u0db0\u0db0\u0dd2\u0dba\u0da7 \u0dc3\u0dd2\u0d9a\u0dad\u0dca \u0dc1\u0db4\u0dca\u200d\u0dbb\u0dda\u0dc4\u0db1\u0dc4\u0dc3 \u0dc4\u0dd0\u0dd2 \u0dad\u0dd4\u0dc4\u0dc4 \u0dc1\u0db8\u0dca \u0dc1\u0dc0\u0dbd\u0dc4\u0dc1\u0dda \u0dc3\u0db7\u0dc4\u0dc1\u0dda \u0db1\u0dd0\u0db1\u0dd0 \u0d9a\u0dd2\u0dba\u0dbd\u0dc4. \u0d85\u0db1\u0dca\u0db1 \u0d91\u0dad\u0dd4\u0dc4\u0dc4 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dc4 \u0dd2\u0db0\u0db4\u0d9a\u0dca\u0dc2 \u0db1\u0dc4\u0dba\u0d9a \u0d9a\u0dc4\u0dbb\u0dca\u0dba\u0dc4\u0dbd\u0dc1\u0dda , \u0d94\u0db6\u0dad\u0dd4\u0dc4\u0dc4\u0da7 \u0d95\u0db1\u0dd1 \u0db1\u0db8\u0dca \u0dd2\u0db1\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dc4 \u0d91\u0dad\u0dd4\u0dc4\u0dc4\u0dc0 \u0db1\u0db8\u0dca\u0db6 \u0dc1\u0dc0\u0db1\u0dca\u0db1. \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0dc4\u0dc4\u0dbb\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d85\u0db1\u0db1\u0dc3\u0d9a\u0dd4\u0dad\u0dca \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4 \u0dc1\u0db1\u0dca\u0db1? \u0d91\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dba-\u0d9a\u0dd2\u0dba\u0dc4 \u0dc1\u0db1\u0dca \u0dc4\u0dd2\u0da7\u0dd2\u0dc1\u0dda . \u0dd2\u0db1\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dc4 \u0db1\u0db8\u0dca\u0db6 \u0dc1\u0dc0\u0db1\u0dca\u0db1, \u0d85\u0db1\u0dca\u0db1 \u0dc3\u0dd2\u0d9a\u0dad\u0dca \u0dc1\u0db4\u0dca\u200d\u0dbb\u0dda\u0dc4\u0db1\u0dc4\u0dc3 \u0dc4\u0dd0\u0dd2 \u0dad\u0dd4\u0dc4\u0dc4 \u0d9a\u0dc4\u0dbb\u0dca\u0dba\u0dc4\u0dbd\u0dc1\u0dda \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dc4. \u0dc1\u0db8\u0dca \u0d85\u0dc4\u0dc4\u0dad\u0dba\u0dc4\u0d82 \u0dba \u0db7\u0dc4\u0dbb\u0dc0 \u0dc4\u0dd2\u0da7\u0dd4\u0dc5 \u0dc3\u0dc4\u0dd2 \u0dc0\u0dbb\u0dd4 \u0dc3\u0db7\u0dc4\u0dc1\u0dda \u0d89\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0db1\u0db8\u0dca, \u0dc1\u0db8\u0dca \u0d86\u0dc3\u0db1 \u0dc1\u0db4\u0dca\u0dd2\u0db6 \u0db4\u0dd2\u0dc1\u0dbb\u0db1\u0dca\u0db1 \u0d89\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0db1\u0dd0\u0db1\u0dca \u0d89\u0db1\u0dca\u0db1 \u0dc3\u0dc4\u0dd2 \u0dc0\u0dbb\u0dba\u0dc4\u0dad\u0dca \u0dc3\u0db7\u0dc4\u0dc1\u0dda \u0db1\u0dd0\u0db1\u0dd0, \u0dc0) \u0d9a\u0dd2\u0dc0 \u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dc4\u0dd2 \u0dc0\u0dbb\u0dba\u0dc4\u0dad\u0dca \u0dd4\u0dc5\u0dd4\u0db4\u0dc1\u0dda \u0db1\u0dd0\u0db1\u0dd0. \u0d91\u0dc1\u0db1\u0dc4 \u0dd2 \u0dc1\u0dba\u0dda\u0daf\u0dd2, \u0dc3\u0dd2\u0d9a\u0dad\u0dca \u0dc1\u0db4\u0dca\u200d\u0dbb\u0dda\u0dc4\u0db1\u0dc4\u0dc3 \u0dc4\u0dd0\u0dd2 \u0dad\u0dd4\u0dc4\u0dc4 \u0dc3\u0db7\u0dc4\u0dc1\u0dda \u0db1\u0dd0\u0db1\u0dd0 \u0dbd\u0dd4. \u0dc1\u0db8\u0dca \u0dc3\u0db7\u0dc4\u0dc1\u0dda \u0dd4\u0dc5\u0dd4\u0db4 \u0dbb\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dc4\u0da7 \u0dc0\u0da9\u0dc4, \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0dc0) \u0d9a\u0dd2\u0dc0 \u0dba\u0dd4\u0dad\u0dd4 \u0dd4\u0dc5\u0dda)\u0dbd\u0dc1\u0dba\u0d9a\u0dca \u0dd2\u0db0\u0db0\u0dd2\u0dba\u0da7 \u0dc3\u0dd2\u0d9a\u0dad\u0dca \u0dc1\u0db4\u0dca\u200d\u0dbb\u0dda\u0dc4\u0db1\u0dc4\u0dc3 \u0dc4\u0db1\u0dad\u0dca\u0dad\u0dba\u0dc4\u0da7 \u0dbb\u0dc4\u0dca\u200d\u0d9a\u0dc4\u0dbb\u0dd2 \u0dd2\u0db0 \u0dc4\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dc4 \u0dba\u0d9a\u0dca \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4. \u0d91\u0dad\u0dd4\u0dc4\u0dc4 \u0db4\u0dc4\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc1\u0dda \u0dd2\u0db0\u0db4\u0d9a\u0dca\u0dc2 \u0db1\u0dc4\u0dba\u0d9a \u0d9a\u0dc4\u0dbb\u0dca\u0dba\u0dc4\u0dbd\u0dc1\u0dda \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dc4. \u0dc0\u0dd3\u0dbb\u0dd2\u0db1\u0d82\u0db1 \u0dc4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0dc4\u0dc4 \u0d86\u0dc3\u0db1\u0dba\u0d9a\u0dca )\u0dd0\u0db1\u0dad\u0dca \u0d85\u0db1 \u0d85\u0db1 \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dc4. \u0d95\u0db1\u0dd1 \u0db1\u0db8\u0dca \u0d85\u0db4\u0dd2 \u0d94\u0db6\u0dad\u0dd4\u0dc4\u0dc4\u0da7 \u0d92\u0d9a\u0dad\u0dca \u0dc1\u0db1\u0db1\u0dca\u0db1\u0db8\u0dca. \u0dba\u0db1\u0dca\u0db1,\n\n\u0dd2\u0db1\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dc4 \u0d9a\u0dae\u0dc4 \u0d9a\u0dbb )\u0db1\u0dca\u0db1. \u0d92\u0dc0\u0dc4 )\u0dd0\u0db1 \u0dc1\u0db1 \u0dc1\u0dc0\u0dba\u0dd2 \u0d9a\u0dae\u0dc4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d94\u0db6\u0dad\u0dd4\u0dc4\u0db1\u0dca\u0dbd\u0dc4\u0da7 \u0db1\u0dd0\u0db1\u0dca \u0daf\u0dd2\u0da7\u0dca\u0da8\u0db0\u0db8\u0dca\u0dc4\u0dc1\u0dda\u0db1\u0dd3\u0dad\u0dba \u0d9a\u0dbb\u0dca\u0dc4\u0dba \u0db4\u0dbd \u0daf\u0dd3\u0dbd\u0dc4 \u0dc1\u0db1\u0dca \u0dd2 \u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca.\n\n\u0dc4\u0dc4 \u0dba\u0dd4\u0db1 \u0db1\u0db8\u0dd4\u0db1\u0dc4\u0dc0 )\u0dd0\u0db1 \u0d9a\u0dae\u0dc4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dc1\u0db1 \u0dc1\u0dc0\u0dba\u0dd2 \u0dc4\u0dd2\u0da7\u0dd2\u0dc1\u0dda . \u0dba\u0dd4\u0db1 \u0db1\u0db8\u0dd4\u0db1\u0dc4\u0dc0\u0da7 \u0db8\u0dd4\u0db1\u0dbd\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dd3\u0dad\u0dc4 \u0db4\u0dd2\u0dd2\u0db6\u0db6 \u0dc0 \u0d85\u0db4\u0da7 \u0dd2\u0db0\u0dc0\u0dc4\u0db1\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0db1\u0dd0. \u0db1\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dba\u0dd4\u0dda\u0db0\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dd2 \u0dbb\u0dc1\u0da7\u0dca \u0dc1\u0dc4\u0da0\u0dca\u0da0\u0dbb \u0db8\u0dd4\u0db1\u0dbd\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dd3\u0dad\u0dc4 )\u0dd0\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0dba\u0d9a\u0dca \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4. \u0d92 \u0dc0\u0dc4\u0dc1\u0dda\u0dc4 \u0dc4\u0dc4 \u0db1\u0dd0\u0d9a\u0dd4\u0dc5 \u0dad\u0dc0\u0dad\u0dca \u0dc1\u0db1\u0dba\u0d9a\u0dca \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4. \u0db4\u0dc3\u0dd4 \u0dd2\u0db1\u0dba \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0db1\u0dc0\u0dc3\u0d9a, \u0d9a\u0dc4\u0dbb\u0d9a \u0dc3\u0db7\u0dc4 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dc4\u0dc0 \u0db4\u0da7\u0db1\u0dca )\u0dad\u0dca\u0dad \u0db1\u0dc0\u0dc1\u0dc3\u0dda \u0d85\u0dc1\u0db4\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0d85\u0dc4\u0dc4\u0dad\u0dba\u0dc4\u0d82 \u0dc1\u0dda \u0dd2\u0db1\u0dba\u0dbd\u0dd4 \u0db1\u0dd2\u0dbd\u0db0\u0dc4\u0dbb\u0dd2 \u0dc4\u0db1\u0dad\u0dca\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dc1\u0dda \u0dc3\u0dd4\u0dc1\u0d9b\u0dca\u200d\u0ddd\u0db4\u0dc1\u0db7\u0ddd \u0db8 \u0dc0\u0dc4\u0db1\u0db1, \u0dc1\u0db1 \u0dc0\u0dc4\u0db1\u0db1 \u0dd2\u0db1\u0dba\u0dbd\u0dca\u0dbd\u0dc4 \u0dc3\u0dd2\u0db0\u0dbd\u0dca\u0dbd\u0dc4 \u0dd2 \u0dd4\u0dab \u0dc4, \u0dc1\u0db8\u0dca \u0db4\u0dc4\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7. \u0d92 \u0d94\u0d9a\u0dca\u0dc1\u0d9a\u0ddd\u0dc4 \u0d91\u0db1\u0dc4 \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca park \u0d9a\u0dbb\u0dbd\u0dc4 \u0dd2 \u0dd4\u0dab\u0dc1\u0dab\u0dca start \u0d91\u0dc1\u0d9a\u0dca. \u0d92 \u0db1\u0dd2\u0dbd\u0db0\u0dc4\u0dbb\u0dd2 \u0dc4\u0db1\u0dad\u0dca\u0dc0\u0dbb\u0dd4 \u0d94\u0d9a\u0dca\u0dc1\u0d9a\u0ddd\u0dc4 \u0dc1\u0dc4\u0dad\u0dd0\u0db1 \u0dbb\u0dc4\u0dca\u200d\u0dba \u0db1\u0dd2\u0dbd\u0db0\u0dc4\u0dbb\u0dd2 \u0dc4\u0dd0\u0daf\u0dd2\u0dbb\u0dd2\u0dc1\u0dda \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dc4. \u0d91\u0dad\u0dc1\u0d9a \u0da7 \u0dc0\u0dc4\u0db1\u0db1 \u0da7\u0dd2\u0d9a start \u0d91\u0dc1\u0d9a\u0dca. \u0d91\u0dad\u0dd4\u0dc4\u0db1\u0dca\u0dbd\u0dc4 \u0dba\u0dd4\u0dda\u0db0 \u0d9a\u0dbb\u0dbd\u0dc4 \u0d85\u0dad \u0db4\u0dba \u0db1\u0dd0\u0dd2 \u0d9a\u0dbb)\u0dad\u0dca\u0dad\u0dc4 \u0dd2\u0d9a\u0dd2\u0db0\u0dad \u0db1\u0dc4\u0db1\u0dd2 \u0d9a\u0dbb )\u0dad\u0dca\u0dad\u0dc4. \u0d92 \u0db1\u0dd2\u0dc3\u0dc4 \u0d85\u0db4\u0dd2 \u0d9a\u0da7 \u0dc0\u0db1\u0dc1)\u0db1 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dc4, \u0d91\u0dad\u0dd4\u0dc4\u0db1\u0dca\u0dbd\u0dc4\u0da7 \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0db8\u0dd4\u0db1\u0dbd\u0dca )\u0dd0\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1 \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dd2 \u0dc0. \u0db1\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0dd2\u0db0\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0db1\u0dc0 \u0dba \u0dd2\u0db0\u0dba\u0db1\u0db8\u0dca \u0d9a\u0dbb\u0db1 \u0d91\u0d9a )\u0dd0\u0db1 \u0d85\u0db4\u0da7 \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0dba\u0d9a\u0dca \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4. \u0d9a\u0dae\u0dc4 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0dad\u0dc0 \u0d9a\u0dc4\u0dbb \u0dc4 ) \u0db1\u0dc4\u0dc0\u0d9a\u0dca \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0d9a\u0dc4\u0dbd\u0dba \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0db1\u0dd2\u0dc3\u0dc4 \u0dc4\u0dc1\u0dda \u0d9a\u0dae\u0dc4\u0dc0 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dc4, \u0db8\u0dd6\u0dbd\u0dc4\u0dc3\u0db1\u0dc4\u0dbb\u0dd6\u0daa )\u0dbb\u0dd4 \u0dc4\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0dc4\u0db1\u0dd2. \u0dc1\u0db6 \u0dc1\u0db1 \u0dc4 \u0dc3\u0dca\u0dad\u0dd4\u0dd2 \u0dba\u0dd2."
  },
