    "chunk_text": "\u0dca\u200d\u0db1\u0dc4\u0db0\u0dd2\u0db4\u0dd2 \u0dad\u0dd4\u0dc4\u0dc4\u0dc1\u0dda \u0d9a\u0dae\u0dc4\u0dc1\u0dc0\u0db1\u0dca \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dda \u0dc4\u0dc4 \u0dd2\u0db1\u0dba\u0dc4, \u0dc1\u0db4\u0dca\u200d\u0dbb\u0dda\u0dc4\u0db1\u0dc4\u0dc3 \u0dc4\u0db1\u0dad\u0dca\u0dc4\u0dba\u0dc4 \u0db1\u0dd2\u0dc0\u0dc4\u0dc3 \u0d85\u0db0\u0dd2\u0d9a\u0dc4\u0dbb\u0dd2\u0dc1\u0dba\u0db1\u0dca \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dd4 \u0dc4\u0dc4\u0dbd\u0dd2)\u0dc4\u0dc0\u0dad\u0dca\u0dad \u0dc4\u0db1\u0dbd\u0dca \u0db1\u0dd2\u0dc0\u0dc4\u0dc3 \u0dc3\u0d82\u0d9a\u0dd3\u0dbb\u0dca \u0dba\u0da7, \u0d92\u0dc0\u0dc4\u0dc1\u0dda \u0d94\u0db4\u0dca\u0dd4\u0dc5 \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4\u0db1 \u0db1\u0dd0\u0dda\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dc4 \u0db6\u0dbd\u0db1\u0dca\u0db1. \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 30\u0da7 \u0d9a\u0dd4\u0dbd\u0dd3 \u0dc1)\u0dc0\u0dbd\u0dc4, \u0d94\u0db4\u0dca\u0dd4\u0dc5 \u0d85\u0dbb\u0dc1)\u0db1 \u0d89\u0dc0\u0dbb\u0dba\u0dd2 \u0d92 \u0d94\u0d9a\u0dca\u0dc1\u0d9a \u0dc4\u0dbd\u0dc4. \u0dc3\u0dc4\u0db1\u0dbb \u0db1\u0dd2\u0dc0\u0dc4\u0dc3\u0dc0\u0dbd \u0d89\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0db1\u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0dba\u0dd2\u0dd2 \u0d9a\u0dc4\u0dbb\u0dc1\u0dba\u0ddd. \u0d91\u0dad\u0dc1\u0d9a \u0da7 \u0dc3\u0dc4\u0dd2 \u0dad\u0dd4\u0dc4\u0db1\u0dd2, \u0dc1\u0dc4\u0dad\u0dd0\u0db1 \u0dd2 \u0dc1\u0db6\u0db1 \u0dc1\u0db6 \u0dbb\u0dd4\u0dc0 \u0dc1\u0d9a \u0da0\u0dca\u0da0\u0dbb\u0db1 \u0db6\u0dbd\u0db1\u0dca\u0db1.\n\n\u0d91\u0dad\u0dc1\u0d9a \u0da7 \u0d94\u0d9a\u0dca\u0dc1\u0d9a \u0dc4 \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 17\u0d9a\u0dca -\u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 17,000\u0d9a\u0dca- \u0dbd\u0dd0\u0dc1\u0db6\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dc1\u0db8\u0dca \u0d85\u0dba \u0dc0\u0dd0\u0dc1\u0dba\u0db1\u0dca \u0d92 \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 17,000 \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dbb\u0dbd\u0dc4 \u0db1\u0dd0\u0db1\u0dd0. \u0d92 \u0dc1\u0dc0\u0db1\u0dd4\u0dc0\u0da7 \u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0dc1\u0dda \u0dc4\u0db1\u0dc4 \u0db7\u0dc4\u0dab\u0dca\u0da9\u0dc4)\u0dc4\u0dbb\u0dba UDA \u0d91\u0dc1\u0d9a\u0db1\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 2\u0d9a\u0dca \u0d85\u0dbb\u0dc1)\u0db1 \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4. \u0dd2\u0db1\u0dba \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0dc1\u0dda\u0dad\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 500\u0d9a\u0dca UDA \u0d91\u0dc1\u0d9a\u0db1\u0dca \u0d85\u0dbb\u0dc1)\u0db1 \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4. \u0db1\u0dd0\u0db1\u0dca \u0dc1\u0db8\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dbb\u0dbd\u0dc4 \u0dd2 \u0dc1\u0db6\u0db1 \u0db8\u0dd4\u0db1\u0dbd\u0dca \u0db6\u0dd0\u0dbd\u0dd4\u0dc0\u0dc4\u0dc4, \u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0dc1\u0dda \u0db1\u0dc4)\u0dbb\u0dd2\u0d9a \u0db1\u0dd2\u0dc0\u0dc4\u0dc3\n\n1269 1270\n\n2023 \u0dc1\u0db1 \u0dc0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca 29\n\n\u0db1\u0db1\u0db1\u0dca\u0db1 \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dbb\u0dbd\u0dc4 \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4 \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 \u0d91\u0dc1\u0d9a \u0dc5\u0db1\u0dba\u0dd2 \u0db1 \u0dc4 )\u0dc4 \u0d9a\u0dca. \u0d85\u0db4\u0dd2 \u0db1\u0db1\u0dca\u0db1\u0dc0\u0dc4 \u0dc1\u0db1\u0dca, \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0dba\u0ddd\u0dca\u200d\u0db1\u0dc4 \u0dd2\u0db0\u0dad\u0dbb\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dc4. \u0d92 \u0dc1\u0dba\u0ddd\u0dca\u200d\u0db1\u0dc4 \u0d9a\u0dbb\u0db1 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca \u0db8\u0dd4\u0db1\u0dbd \u0dbd\u0dd0\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0db1\u0dd0. \u0dd2\u0db1\u0dba \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0dc1\u0dda \u0d86\u0db1\u0dc4\u0dba\u0dc4 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca \u0dc1\u0dba\u0db1\u0dca \u0dbd\u0dd0\u0dd4\u0dab\u0dc1\u0dab\u0dca \u0db1\u0dd0\u0db1\u0dd0 \u0dc0\u0dc4\u0dc1\u0dda\u0dc4 \u0dd2\u0db0\u0dba\u0db1\u0db8\u0dca \u0dc0\u0dd4\u0dc1\u0dab\u0dca\u0dad\u0dca \u0db1\u0dd0\u0db1\u0dd0. \u0dd2\u0db1\u0dba \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0dc1\u0dda UDA \u0d91\u0d9a\u0da7 \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dc5 \u0db8\u0dd4\u0db1\u0dbd\u0dca \u0dbd\u0db6\u0dc4 \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dc4\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dc4 \u0d94\u0db6\u0dad\u0dd4\u0dc4\u0dc4 \u0db1\u0dd0\u0db1\u0dca \u0d9a\u0dbd\u0dca\u0db4\u0db1\u0dc4 \u0d9a\u0dbb\u0dbd\u0dc4 \u0db6\u0dbd\u0db1\u0dca\u0db1. \u0d92 \u0db8\u0dd4\u0db1\u0dbd\u0dca \u0dc1\u0db1\u0db1\u0dc0\u0dc4 \u0dc1\u0dc0\u0db1\u0dd4\u0dc0\u0da7 UDA \u0d91\u0dc1\u0d9a\u0db1\u0dca \u0db8\u0dd4\u0db1\u0dbd\u0dca )\u0dad\u0dca\u0dad\u0dc4. \u0dc1\u0dc4 \u0d9a\u0d9a\u0dca\u0db1 \u0dc1\u0db1\u0dda\u0dad\u0dd4\u0dc0? \u0dc4\u0db1\u0dca\u200d\u0db1 \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0da7 \u0dba \u0dc1)\u0dc0\u0db1\u0dca\u0db1 \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4. \u0dc4\u0db1\u0dca\u200d\u0db1 \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0da7 \u0dba \u0dc1)\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dd2 \u0dc0, \u0db1\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dc0\u0dc4\u0dc3 \u0dc1\u0db1\u0db1\u0dca\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0dc0\u0db1\u0dca\u0db1? \u0db7\u0dc4\u0dab\u0dca\u0da9\u0dc4)\u0dc4\u0dbb\u0dba \u0dc1\u0db8\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 17 \u0dc1)\u0dc0\u0db1\u0dc0\u0dc4\u0db1?\n\n\u0db1\u0dd0\u0db1\u0dca \u0dc1)\u0dc0\u0dbd\u0dca \u0db1\u0db1\u0db1\u0dca\u0db1 \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dbb\u0dbd\u0dc4 \u0dd2 \u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 11\u0dba\u0dd2. \u0d91\u0dad\u0dc1\u0d9a\u0da7 \u0db1\u0dc0\u0dad\u0dc4 \u0db1\u0dc4\u0dd4\u0dc5 \u0dc0\u0dba\u0dc4\u0db4\u0dd2\u0dd2 \u0dc0\u0dbd\u0da7 \u0dc1\u0dc4 \u0d9a\u0db1 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0dad\u0db1\u0dc4\u0db1\u0dbb \u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dda\u0dc1\u0dc0 \u0dad\u0dca, \u0db1\u0dd0\u0db1\u0da7 \u0d89\u0daf\u0dd2 \u0d9a\u0dd2\u0dd3\u0dad\u0db8\u0dca \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dbb\u0dbd\u0dc4, -\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dc1\u0db1 \u0d9a\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dc4 \u0dba\u0d9a\u0dca \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4, \u0d92\u0d9a \u0dc1\u0dc0\u0db1\u0dc4 \u0d9a\u0dae\u0dc4\u0dc0\u0d9a\u0dca- \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0dd4\u0dc5 \u0db1\u0dd2\u0dc0\u0dc4\u0dc3 \u0dc0\u0dba\u0dc4\u0db4\u0dd2\u0dd2 \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4. \u0dc1\u0d9a \u0dc5\u0db9, \u0dc1\u0d9a \u0dc5\u0db9\u0dc1\u0dda \u0dc4\u0dc4\u0dc0\u0dad \u0db1\u0dd2\u0dc0\u0dc4\u0dc3 \u0dc0\u0dba\u0dc4\u0db4\u0dd2\u0dd2 \u0dc1\u0dda \u0db4\u0dd2\u0dbb\u0dd2\u0dc0\u0dd0\u0dba \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 8\u0d9a\u0dca. \u0d92\u0d9a \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0dc4 \u0db1\u0dc4\u0dc4 \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4. \u0dc1\u0d9a\u0ddd \u0d91\u0dad\u0dc1\u0d9a \u0da7 \u0d92\u0d9a\u0da7 \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dc5 \u0db8\u0dd4\u0db1\u0dbd\u0dca? \u0d92\u0dc0\u0dc4\u0da7 \u0d94\u0db4\u0dca\u0dd4\u0dc5 \u0dbd\u0db6\u0dc4 \u0dc1\u0db1\u0db1\u0dc0\u0dc4\u0db1, \u0d92\u0dc0\u0dc4 \u0db1\u0dd0\u0dc0\u0dad \u0db4\u0da7\u0db1\u0dca )\u0db1\u0dca\u0db1\u0dc0\u0dc4\u0db1? \u0d92\u0dc0\u0dc4\u0da7 \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dc5 \u0db8\u0dd4\u0db1\u0dbd\u0dca \u0dbd\u0dd0\u0dc1\u0db6\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dc4 \u0dd2\u0db0 \u0dca\u0dc0\u0dc4\u0dc3\u0dba\u0d9a\u0dca \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4\u0db1? \u0d8a\u0dc5\u0d9f\u0da7, \u0dc1\u0da7 \u0dbb\u0dd2\u0db1\u0dca\u0da7\u0db1\u0dca \u0dc4\u0dc4\u0dc0\u0dad \u0dc0\u0dba\u0dc4\u0db4\u0dd2\u0dd2 \u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca \u0dc1\u0dba\u0db1\u0dca \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0dbd\u0dc4 \u0dd2 \u0dc1\u0db6\u0db1\u0dc0\u0dc4. \u0d92\u0dc1\u0d9a\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0dc0\u0dd0\u0dba \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 3.6\u0dba\u0dd2. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0db6\u0dd0\u0dbd\u0dd4\u0dc0\u0dc4\u0dc4 \u0dc1\u0db8\u0dca \u0d94\u0d9a\u0dca\u0dc1\u0d9a\u0ddd\u0dc4 \u0dc1\u0db6 \u0dbb\u0dd4 \u0dc1\u0db1\u0dca. \u0dca\u200d\u0db1\u0dc4\u0db0\u0dd2\u0db4\u0dd2 \u0dad\u0dd4\u0dc4\u0dc4 \u0dc1\u0db8\u0dca \u0dc0\u0dc4\u0dc1\u0dda \u0dc3\u0dd4\u0dbb\u0d82)\u0db1\u0dc4 \u0d9a\u0dae\u0dc4\u0dc4 \u0dad\u0dc4\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca."
