    "chunk_text": "\u0d9a\u0dcf\u0dca\u0d9c\u0dba\u0dcf\u0dbd\u0dba \u0dbb \u0dcf \u0dba\u0dda \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dc3\u0dd2 \u0dc0 \u0d9a\u0dbb\u0dbd\u0dcf, \u0dc0\u0dcf\u0dab\u0dd2\u0da2\u0dca\u200d \u0dc1\u0daf\u0db4\u0dcf\u0dca\u0d9c\u0dad\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc1\u0dda \u0daf\u0dd0\u0db1\u0da7 \u0d89\u0db1\u0dca\u0db1 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0dc1\u0dda \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dc1\u0dda \u0d85\u0dba \u0db8\u0d9a\u0dca\u0d9a \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0 \u0d9a\u0dbb\u0dbd\u0dcf \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0dc1\u0d9c\u0db1 \u0dba\u0db1\u0dca\u0db1. \u0dc0\u0dd2 \u0dc1 \u0dda\u0dc2\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0dc1\u0dc0\u0dc5\u0db3, \u0dc0\u0dcf\u0dab\u0dd2\u0da2\u0dca\u200d \u0dcf \u0d86 \u0dcf\u0dbb \u0dc3\u0dd4\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dad\u0dcf \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba\u0da7 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d92 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba \u0dba\u0da7\u0dc1\u0dad\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dc1\u0d9c\u0db1 \u0dba\u0db1\u0dca\u0db1\u0dad\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d9a\u0dcf\u0dca\u0d9c\u0dba\u0d9a\u0dca\u0dc2\u0db8\u0dad\u0dcf\u0dc0 \u0dd4\u0dbb\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0dbb\u0dda \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1 \u0dc1\u0dda \u0dc1\u0daf\u0db4\u0dcf\u0dca\u0d9c\u0dad\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc1\u0d9a\u0ddc\u0dba\u0dd2 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7\u0daf \u0d85\u0db4\u0da7 \u0db4\u0dcf\u0dc0\u0dd2\u0dca\u0da0\u0da0\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dd4\u0dbb\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0db8\u0d9a \u0d9c\u0dd0\u0db1 \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dad\u0dd0\u0db1\u0daf\u0dd3 \u0d9a\u0dbd\u0dca\u0db4\u0db1\u0dcf \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d92 \u0dc0\u0dcf \u0dc1 \u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dbb \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dba\u0dad\u0dca. \u0db8\u0db0\u0dba\u0db8 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dad\u0dd4\u0dc5 \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dbb \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dba\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0dc1\u0d9c\u0db1 \u0dba\u0dcf\u0db8\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0d89\u0dad\u0dcf \u0d85\u0da9\u0dd4\u0dba\u0dd2. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf \u0dc0\u0dd2\u0dc2\u0dba \u0dad\u0dd4\u0dc5 \u0d92 \u0d85\u0dba\u0da7 \u0dc0\u0dd2 \u0dcf\u0dbd \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0dc0\u0dd0 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0d92 \u0d85\u0dba\u0da7 \u0dc3 \u0dc1\u0dba\u0ddd\u0d9c\u0dba \u0dbd\u0db6\u0dcf \u0dc1\u0daf\u0db1 \u0d9c\u0db8\u0db1\u0dca\u0db8 \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dbb \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dba\u0da7 \u0dc3\u0dca\u0dc0\u0dba\u0d82\u0dc0 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0dc1\u0d9c\u0db1 \u0dba\u0db1\u0dca\u0db1 \u0d85\u0dc0 \u0dba \u0dc3 \u0dc1\u0dba\u0ddd\u0d9c\u0dba \u0dbd\u0db6\u0dcf \u0dc1\u0daf\u0db1\u0dca\u0db1\u0dad\u0dca \u0dc1\u0dda \u0dbb \u0dcf \u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf \u0d9a\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf.\n\n\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0dc3\u0dd4\u0dc5\u0dd4 \u0dcf \u0db8\u0db0\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0dab \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf. \u0d92 \u0d85\u0dba \u0d9a\u0dca\u0dad\u0dd2\u0db8\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dbb \u0dcf \u0dc1\u0dda\u0dc1\u0dd3\u0dba\u0dc0 \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0db7\u0dcf\u0dab\u0dca \u0dc0\u0dbd\u0da7\u0dad\u0dca, \u0d85\u0db4\u0db1\u0dba\u0db1 \u0db7\u0dcf\u0dab\u0dca \u0dc0\u0dbd\u0da7\u0dad\u0dca \u0dc0\u0dd2 \u0dcf\u0dbd \u0dc3 \u0dc1\u0dba\u0ddd\u0d9c\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0dd4\u0dbb\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0dc1\u0db8\u0ddc\u0d9a\u0daf, \u0d85\u0dc1\u0db4\u0dca \u0dbb\u0dc1\u0dda \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0dc1\u0d9c\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 6\u0d85\u0d9a\u0dca\u0db8 \u0dc3\u0dd4\u0dc5\u0dd4 \u0dcf \u0db8\u0db0\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0dab \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0dc1\u0dda \u0d85\u0dba \u0dc0\u0dd0\u0dc1\u0dba\u0db1\u0dca \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dd2\u0dc4\u0dbd\u0dd2\u0dba\u0db1 \u0d859\u0d9a \u0db8\u0dd4\u0daf\u0dbd \u0dc3\u0dd4\u0dc5\u0dd4 \u0dcf \u0db8\u0db0\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0dab \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dc1\u0dba\u0ddd \u0dbb\u0dd2\u0dba\u0da7 \u0db4\u0dcf\u0dc0\u0dd2\u0dca\u0da0\u0da0\u0dd2 \u0d9a\u0dc1\u0dc5\u0ddc\u0dad\u0dca \u0dc1 \u0ddc\u0db3 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dbd \u0dc0\u0dcf\u0dc1 \u0db8 \u0dc1\u0dda \u0d9a\u0dd2\u0dba\u0db1 \u0dc0\u0dcf\u0dc3\u0dd2\u0dad\u0dca \u0dbb\u0da7\u0da7 \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0dd4\u0dbb\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf 292] \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0daf \u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dca\u0d9c\u0dba\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0d89\u0dad\u0dcf \u0dc3\u0dd4\u0db6 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0daf\u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0db8\u0db8 \u0dc0\u0dd2\u0dc1 \u0dda\u0dc2\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0db8\u0dad\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0dc3\u0dca\u0dad\u0dd4\u0dad\u0dd2\u0dba\u0dd2, \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2.\n\n\u0d9c\u0dd4 \u0dd2\u0dba\u0dc3\u0dcf\u0da9\u0dca \u0db6\u0daf\u0dd2\u0dd4\u0dad\u0daf\u0dd3\u0db1\u0dca \u0db8\u0dc4\u0dcf\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0bb1\u0bbf\u0bb8\u0bc6\u0bbe\u0b9f\u0bcd \u0baa\u0ba4\u0bbf\u0baf\u0bc1\u0ba4\u0bc0\u0ba9\u0bcd) (The Hon. Rishad Bathiudeen) \u0d9c\u0dbb\u0dd4 \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0dc3\u0dc1\u0dad\u0ddc\u0dc3 \u0d85\u0dc1\u0dc5\u0dc0\u0dd2\u0dc3\u0dd0\u0dbd\u0dca 20\u0d85\u0d9a\u0dca \u0dc0\u0dcf\u0dc1 \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0dd0 \u0dc0\u0dc0\u0dcf. \u0db8\u0db8 \u0d85\u0db8\u0dcf\u0dad\u0dba \u0db0\u0dd4\u0dbb\u0dba\u0da7 \u0d86\u0dc0\u0dcf\u0da7 \u0db4\u0dc3\u0dd4\u0dc0 \u0d85\u0dc1\u0dc5\u0dc0\u0dd2\u0dc3\u0dd0\u0dbd\u0dca ]99\u0d9a\u0da7 \u0dc0 \u0dcf \u0daf\u0dbd\u0dcf \u0db7\u0dcf\u0dbb \u0dc0\u0db1\u0dca\u0db1\u0dcf. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0dc3\u0dc1\u0dad\u0ddc\u0dc1\u0dc3\u0dda \u0dc3\u0dd2\u0dd2\u0d9a \u0d9a\u0dcf\u0dbd\u0dc1\u0dda \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dba\u0dd2, \u0dc1\u0d9c\u0ddd\u0db0\u0dcf\u0db7\u0dba \u0dbb\u0dcf\u0da2\u0dca\u200d\u0db4\u0d9a\u0dca\u0dc2 \u0db8 \u0dad\u0dca\u0db8\u0dba\u0dcf \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dc0\u0dd4\u0dab\u0dcf\u0da7 \u0db4\u0dc3\u0dd4\u0dc0 purposely \u0db1\u0dd0 \u0dc1\u0d9f\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dc1\u0dad\u0dca \u0dad\u0dd2\u0dd4\u0dab\u0dab\u0dd4 \u0dc3\u0dc1\u0dad\u0ddc\u0dc3 \u0d85\u0dc1\u0dc5\u0dc0\u0dd2\u0dc3\u0dd0\u0dbd\u0dca \u0dc0 \u0dbd\u0dcf \u0daf\u0dcf\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc0 \u0dbd\u0dcf \u0daf\u0dcf\u0dbd\u0dcf, \u0d92\u0dc0\u0dcf\u0dc1\u0dda \u0dc0\u0dd0 \u0d9a\u0dbb\u0dd4\u0dbb \u0dc1\u0dc3\u0dda\u0dc0\u0d9a\u0dba\u0db1\u0dca \u0dc1\u0dc0\u0db1 \u0db4\u0dc5\u0dcf\u0dad\u0dca\u0dc0\u0dbd \u0d85\u0dc1\u0dc5\u0dc0\u0dd2\u0dc3\u0dd0\u0dbd\u0dca\u0dc0\u0dbd\u0da7 \u0dc1\u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 3\u0d85,999\u0d9a \u0db4\u0da9\u0dd2\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d92 \u0d85\u0dba\u0da7 \u0da2\u0dd3\u0dc0\u0dad\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0db1\u0dad\u0dca \u0db6\u0dd0 \u0dd0. \u0d92 \u0db4\u0dc5\u0dcf\u0dc1\u0dad\u0dca \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca\u0da7 \u0d92 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dc3\u0dbd\u0d9a\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0db8\u0dd4\u0dc3\u0dca\u0dbd\u0dd2\u0dda \u0db1\u0dd2\u0dc3\u0dcf\u0daf, \u0dc1\u0daf\u0db8\u0dc5 \u0db1\u0dd2\u0dc3\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8\u0db8 \u0daf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0 \u0dd0. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0d86\u0db4\u0dc3\u0dd4 \u0d92\u0dc0\u0dcf \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dbb\u0dd2\u0daf\n\n1763 1764\n\n\u0db4\u0dcf\u0dca\u0d9c\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0"
  },
