    "chunk_text": "\u0d92 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dca\u200d\u0d9a\u0dad\u0dca \u0dca\u0d9a\u0dca \u0db8, \u0d85\u0dc1\u0dc3\u0d9a\u0dca \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0db1\u0dca \u0da2\u0dc3\u0dc0\u0dca\u200d\u0dca\u0db8 \u0dc0\u0dca\u200d\u0dc1 \u0d82\u0d9a\u0dad\u0dc3\u0dc0\u0dca\u200d\u0dbd\u0dd2\u0db1\u0dd4\u0dad\u0dca \u0dca\u0d9a\u0dca \u0dca\u0d9a\u0dca \u0d82\u0dab\u0dca\u0da9\u0dd4 \u0daf\u0dbd\u0dc0\u0dca\u200d\u0dbd \u0daf\u0dd3 \u0db4\u0dd4\u0daf\u0dd4\u0db8\u0daf \u0daf\u0dbb \u0dc0\u0dd2\u0db0\u0dd2\u0d9a\u0da7 \u0dad\u0db8\u0dba\u0dd2 \u0d9a\u0daf\u0dc5\u0dd4 \u0dc4\u0dd2\u0dad\u0dc0\u0dca\u200d\u0dad\u0dca \u0db8\u0dca \u0db8\u0dad \u0dca \u0dca\u0d9a\u0dca\u0dc1 \u0dc3\u0daf\u0da7 \u0d89\u0da9\u0db8\u0dca \u0daf\u0dd3\u0dbd\u0daf \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d92 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dca\u200d\u0d9a \u0d89\u0dad\u0daf\u0db8 \u0dc3\u0dbb \u0dba\u0dd2. \u0d92 \u0db1\u0dd2\u0dca\u0daf \u0d85\u0dcf \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0daf\u0dd4\u0dca \u0db4\u0dad\u0dca \u0db8\u0dd2\u0db1\u0dd2\u0dc1\u0dc4\u0d9a\u0dd4\u0da7 \u0dc1\u0d9c\u0d9a\u0d9a\u0dca \u0dc4\u0dcf\u0daf\u0d9c\u0db1\u0dca\u0dc3 \u0d89\u0da9\u0db8\u0dca \u0dd1\u0db1\u0dbd\u0d9a\u0dca \u0d9c\u0db1\u0dca\u0dc3 \u0dc3\u0dd0\u0dc4\u0dd0. \u0d92 \u0dc0\u0dca\u200d\u0daf\u0dc1 \u0db8 \u0dc1 \u0dc1\u0dc3\u0d9a\u0dd4\u0da7 \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0d9a\u0db8\u0dca \u0dc0\u0dca\u200d\u0dba\u0daf\u0db4\u0dd8\u0dad\u0dd2\u0d9a\u0d9a\u0dca \u0dbb\u0db1\u0dca\u0dc3, \u0dca\u0dc1\u0dc0\u0dca\u200d\u0dda\u0db0\u0dc3 \u0dc0\u0dca\u200d\u0dba\u0daf\u0db4\u0dd8\u0dad\u0dd2\u0d9a\u0d9a\u0dca \u0dbb\u0db1\u0dca\u0dc3, \u0d82\u0dc1\u0d9a\u0ddd\u0da2\u0dc3\u0d9a\u0d9a\u0dca \u0dbb\u0db1\u0dca\u0dc3 \u0d89\u0da9\u0db8\u0dca \u0dd1\u0db1\u0dbd\u0d9a\u0dca \u0dc3\u0dd0\u0dc4\u0dd0. \u0d92 \u0db1\u0dd2\u0dca\u0daf\u0db8 \u0d89\u0da9\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2\u0d9a \u0dca\u0db8\u0dca\u0db4\u0dd6\u0dda\u0dab\u0dc1\u0d9a\u0db1\u0dca \u0dc1\u0dc0\u0dca\u200d\u0dc3\u0dca\u0dae \u0dbb\u0db1\u0dca\u0dc3\u0da7 \u0d95\u0dc3\u0dd1. \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca \u0d89\u0da9\u0db8\u0dca \u0dca\u0db8\u0dca\u0db3\u0db1\u0dca\u0db0\u0dc0\u0dca\u200d \u0dad\u0dd2\u0dc1\u0db3\u0dc3 \u0dca\u0dd1\u0db8 \u0d82\u0d9a\u0dad\u0dc3\u0d9a\u0d9a\u0dca\u0db8 \u0daf\u0dd4\u0dca \u0db4\u0dad\u0dca \u0d85\u0dc4\u0dd2\u0dc1\u0dca \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca\u0da7 \u0daf\u0dd6\u0dc2\u0dab\u0dc1\u0d9a\u0db1\u0dca, \u0dc0\u0dca\u200d\u0dc1\u0da0\u0daf\u0dc1\u0dc0\u0dca\u200d\u0db1\u0dca \u0dc1\u0dad\u0ddc\u0dbb\u0dc0\u0dca\u200d \u0d89\u0da9\u0db8\u0dca \u0dd0\u0db3\u0dd0\u0db1\u0dbd\u0d9a\u0dca \u0dbd\u0db3\u0daf \u0daf\u0dd3\u0dc1\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2\u0d9a \u200d\u0dbb\u0dd2\u0d9a\u0daf\u0dad\u0dca\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d89\u0dad\u0daf \u0d85\u0dc0\u0dca\u200d \u0dba\u0dba\u0dd2."
