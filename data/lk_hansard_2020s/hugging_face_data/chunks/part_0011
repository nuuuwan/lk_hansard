    "chunk_text": "\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0dcf\u0d82 \u0d9c\u0dbb\u0dd4 \u0db8\u0dcf\u0dad\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0db1\u0dd2, \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0d9c \u0daf\u0dd2\u0dc3\u0dca\u0dd2\u0dca\u0d9a\u0dcf\u0dc1\u0dda \u0dc1\u0dbb\u0ddd \u0dbd\u0dca 48\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc1\u0db8\u0dca \u0dc1\u0dbb\u0ddd \u0dbd\u0dca 48 \u0d87\u0dad\u0dd4\u0db8\u0dc1\u0d9a\u0dca \u0dd9\u0dbb\u0dd4 \u0dca\u200d\u0dbb\u0dbb\u0dd2\u0dad\u0dd2\u0d9c\u0dca \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0db1 \u0db4 \u0dc3\u0dd4\u0d9a\u0dcf\u0db8\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dc1\u0dbb\u0ddd \u0dbd\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca 3\u0dba\u0dd2. \u0db1\u0d9a\u0dbb\u0dca \u0d89\u0dad\u0dd2 \u0dcf\u0dc3\u0d9c \u0d9c\u0da9\u0db1 \u0d9a\u0dcf\u0dae\u0dcf \u0d9a\u0dcf\u0dbb\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0dc1\u0d9a\u0dcf\u0dbb\u0dd4\u0dc0\u0dcf \u0d9a\u0dd2\u0d9c\u0dbd\u0dcf \u0dc1\u0dbd\u0dcf\u0d9a\u0dd4\u0dc0\u0da7 \u0db4\u0db8\u0dca\u0dc1\u0db4\u0ddd\u0dbb\u0dd2 \u0d9c \u0db1\u0dc0\u0dcf. \u0dd9\u0dbb\u0dd4 \u0dca\u200d\u0dbb\u0dbb\u0dd2\u0dad\u0dd2\u0d9c\u0dca \u0dc3\u0db3 \u0dcf \u0dd2\u0dbb\u0dc1\u0dc3\u0dca\u0dbb\u0dd2\u0d9c\u0db1\u0dca \u0dc3\u0da9\u0dca\u0d9a\u0dcf\u0db8\u0dcf\u0dad\u0dca \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc1\u0dbb\u0ddd \u0dbd\u0dca \u0dad\u0dd4\u0db8\u0db1\u0dba\u0dd2 \u0db1\u0db8\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0dc1\u0db8\u0dcf\u0dad\u0dcf\u0db1\u0dc0\u0dcf\u0dd9 \u0d9a\u0dcf\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0dc1\u0dbb\u0ddd \u0dbd\u0dca \u0db4 \u0db0\u0dad\u0dd2\u0d9c \u0dad\u0dd4\u0db8\u0d9a \u0dd2\u0dbb\u0da7\u0dd2\u0db1 \u0db0\u0dc0\u0dd9\u0dba\u0dc0\u0dbb\u0dd4 \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dad\u0dcf\u0d9a\u0d9c 250\u0d9a\u0dcf\u0da7, 300\u0d9a\u0dcf\u0da7 \u0d85\u0da9\u0dd4\u0dba\u0dd2. \u0d92\u0dc0\u0dcf\u0dc1\u0dda \u0daf\u0dd2\u0dad\u0dd4\u0dab\u0dd4 \u0dda\u0db4\u0d9a\u0dcf\u0dbb\u0d9a \u0db1\u0da9 \u0da9. \u0d92 \u0dc0\u0dcf\u0dc1 \u0db8\u0dcf\u0dad ambulance \u0d91\u0d9a\u0dcf\u0dca \u0db1\u0da9 \u0da9. \u0dc1\u0db8\u0dca \u0dc0\u0dcf\u0dc1 \u0dad\u0dca\u0dca\u0dc0\u0d9c\u0d9a\u0dcf \u0dad\u0db8\u0dcf\u0dad\u0dba\u0dd2 \u0dc1\u0dbb\u0ddd \u0dbd\u0dca \u0db4 \u0db0\u0dad\u0dd2\u0d9c \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca.\n\n1291 1292\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0"
  },
