    "chunk_text": "\u0d92 \u0dd2\u0dba\u0dca \u0d85\u0db4\u0dd2 \u0dca\u200d\u0dad\u0dca\u0db8 \u0dad\u0dca \u0d9a\u0dca\u200d\u0dba \u0dd2\u0dbd\u0db0\u0dd2\u0dba\u0da7 \u0dc1\u0db8\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dca\u200d\u0dba \u0dd2\u0dba\u0dca\u200d\u0dd0\u0d9a\u0daf\u0dd2\u0dca\u200d \u0db1\u0db3\u0dd4\u0db1 \u0dc1,\u0db1 \u0d92 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dca\u200d\u0dba \u0dc1\u0dca\u200d\u0db1\u0dca\u0dae \u0da7\u0d9a\u0dbd \u0d85\u0dc1\u0dda \u0d9a\u0dc1\u0dca, \u0dca\u200d\u0dd0\u0da9 \u0da7\u0d9a\u0db1 \u0dca\u200d\u0db1\u0dad \u0dca\u200d\u0da7 \u0db8 \u0db1 \u0dca\u200d\u0db1\u0dad \u0dca\u200d\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dca\u200d \u0db1\u0db1\u0dba \u0dd2\u0dba\u0dca \u0d87\u0dad\u0dd2 \u0dc1\u0dca\u200d\u0dbd \u0dad\u0dd2\u0dc1\u0db3\u0db1 ,\u0dd0\u0da7\u0dbd\u0dd4 \u0da7\u0dd2\u0da7 \u0dd2\u0dba\u0d9a \u0da7\u0d9a\u0dab\u0dba \u0da7\u0d9a\u0db1\u0dca\u0db1 \u0da7\u0dca \u0db4\u0db1 \u0da7\u0d9a\u0db1\u0dca\u200d . \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0dd2\u0dbd\u0dc1 \u0dc2\u0dc1\u0dba\u0db1\u0dca \u0da7\u0dca \u0db4\u0db1 \u0da7\u0d9a\u0db1\u0dca\u200d \u0dbd\u0dc0,\u0db8 \u0db8 \u0d9c\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0dca\u200d \u0db1\u0db1\u0dba \u0dca\u200d\u0da9 \u0dad\u0dca \u0da7 \u0dca\u0d9c\u0dba\u0d9a\u0dca\u0dc2\u0db8 \u0dc1\u0dca \u0dca\u200d \u0dca\u200d\u0d9a\u0dca \u0db3\u0dca\u200d\u0da7 \u0db4\u0dad\u0dca \u0da7\u0d9a\u0db1\u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0dc1\u0da7\u0ddc\u0dc1\u0db1\u0ddc\u0db8 \u0dd9 \u0da7\u0da7\u0dd4\u0dad\u0dd4 \u0da7\u0d9a\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dba\u0dbd . \u0dd2\u0dbd\u0dc1 \u0dc2\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0da7\u0ddc\u0dc5\u0db9\u0da7 \u0dca\u200d\u0db1\u0dad \u0dca\u200d \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dda \u0dca\u200d\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db1 \u0db1 \u0dc1\u0dd9\u0ddc\u0d9a\u0da7\u0dd4 \u0db1\u0dad\u0d9a\u0d9a\u0dca \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0dca\u200d \u0dca\u200d\u0db1 \u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dd4 \u0db8 \u0dad\u0db8 \u0db1\u0dca\u0dc1 \u0d85\u0dba \u0dca\u200d\u0dd0\u0dba \u0da7\u0dcf \u0dc1\u0dda\u0daf\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0da7 \u0da7\u0dc5 .\n\n1073 1074\n\n2025 \u0dc1\u0db4\u0db3\u0d9a\u0dca\u200d \u0dbb\u0dd2 22\n\n\u0dca \u0db1 \u0dd9 \u0dba\u0da7 \u0da7\u0d9a,\u0dad \u0dd4\u0dad\u0dd4 \u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd . \u0d92 \u0da7 \u0d9a\u0dab \u0dc1\u0dda\u0daf\u0dd3 \u0d85\u0dc1\u0dda \u0d9a\u0dc1\u0dca, \u0dca\u200d\u0db1\u0dad \u0dca\u200d \u0d85\u0dad\u0dca\u0dd2\u0dbd\u0db3\u0dd2\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dca\u200d\u0dba\u0db1\u0dca \u0dd2\u0dba\u0dca\u200d\u0dd0\u0dc3\u0dca\u0daf\u0dd2\u0dca\u200d \u0dc1\u0dad\u0dca\u0dbb\u0dd4\u0db8\u0dca \u0d85\u0d9a\u0dc1,\u0db1 \u0db8 \u0dca\u0d9c, \u0dad\u0dd9\u0db3\u0dd9\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0dad\u0ddc\u0d9a\u0dca\u200d \u0dad\u0db8 \u0db1\u0dca\u0dc1 \u0dc3\u0dca\u0d9a\u0dd2\u0dba \u0dca\u200d\u0da7 \u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dca\u200d\u0db1\u0dca \u0dc1\u0dca\u200d\u0db1 \u0dd2\u0dbd\u0db0\u0dd2\u0dba\u0da7 \u0dc1\u0db8\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dca\u200d\u0dba\u0db1\u0dca \u0dd2\u0dba\u0dca\u200d\u0dd0\u0dc3\u0dca\u0daf\u0dd2\u0dca\u200d \u0dca\u0da7\u0dca\u0dae \u0da7\u0dc5 \u0dd4\u0dad\u0dd4 \u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd \u0d85\u0db4\u0dd2 \u0dd2\u0dbd \u0dae\u0dca\u200d \u0dca \u0da7\u0d9a\u0db1\u0dca\u200d . \u0d85\u0db1\u0dca\u0db1 \u0d92 \u0da7 \u0d9a\u0dab \u0dc1\u0dda\u0daf\u0dd3 \u0dd2\u0dbd\u0dc1 \u0dc2\u0dc1\u0dba\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0da7\u0dca \u0db4\u0db1 \u0da7\u0d9a\u0db1\u0dca\u200d \u0dc1\u0db8\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dca\u200d \u0db1\u0db1 \u0dc1\u0dca \u0dca\u200d\u0dba\u0da7 \u0d92 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dca\u200d\u0dba\u0db1\u0dca \u0dd2\u0dba\u0dca\u200d\u0dd0\u0dc3\u0dca\u0daf\u0dd2 \u0da7\u0d9a\u0db1\u0dca\u0db1 \u0db3\u0dd0\u0db1\u0dd0 \u0d9a\u0dd2\u0dba\u0dbd . \u0d91\u0dc1\u0db1\u0db8 \u0db1\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dca\u200d \u0db1\u0db1 \u0dc1\u0dca \u0dca\u200d\u0dba \u0db1\u0dc0\u0dd3\u0da7\u0d9a\u0dab\u0dba \u0da7\u0d9a\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1; \u0dd2\u0dbd\u0db0\u0dd2\u0db8 \u0dad\u0dca \u0da7\u0d9a\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1; \u0dba\u0db1\u0db4\u0dad\u0dca \u0dca\u200d\u0db1\u0dad \u0dca\u200d \u0daf\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0dca\u200d \u0db1\u0db1 \u0dc1\u0dca \u0dca\u200d\u0dba\u0d9a\u0dca \u0db3\u0dca\u200d\u0da7 \u0d91\u0dba \u0db4\u0dad\u0dca \u0da7\u0d9a\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1."
  },
