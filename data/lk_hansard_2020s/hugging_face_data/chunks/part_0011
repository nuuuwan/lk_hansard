    "chunk_text": "\u0d9a\u0dcf\u0da7\u0dad\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0db1. \u0dc1\u0db8\u0dcf\u0dad\u0dcf\u0d9a\u0dcf\u0dd9, \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0db1\u0dca\u0dbd\u0dcf \u0d9c\u0dd4\u0dbb\u0dd4 \u0dc1\u0dc3\u0dca\u0dc0\u0d9c\u0da7 20,000\u0dca \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf, IT \u0dc3 \u0dc1\u0dc0\u0db1\u0dca \u0dca\u0dc1 \u0dca\u0dca\u200d\u0dbb\u0dc0\u0dbd\u0da7 \u0d85\u0dc1\u0db1\u0dca \u0d85\u0d9c \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0d91\u0dc1\u0dad\u0dca \u0daf\u0dd3\u0db8\u0dcf\u0dad\u0db1\u0dcf \u0dc1\u0d9c\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0dbb\u0dd0\u0d9a\u0dd2\u0d9c\u0dcf \u0dc0\u0dd2\u0dbb\u0dc4\u0dd2\u0dad \u0dda\u0db4\u0dcf\u0db0\u0dd2\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca \u0d9c\u0da9\u0db1\u0dca \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0db1\u0dca\u0dbd\u0dcf \u0dd9\u0da9\u0da9\u0dd2 \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0d9c\u0dca \u0dc1\u0d9c\u0dcf\u0d9a\u0dbb \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0db1.\n\n\u0db8\u0dcf\u0dad\u0db8\u0dcf\u0dad \u0dc4\u0dd2\u0dad\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0d9c\u0da7 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0db1\u0dca\u0dbd\u0dcf \u0dc1\u0db8\u0dcf\u0dad\u0dad\u0da9\u0db1\u0daf\u0dd3 \u0d85\u0dbb \u0dbb\u0db1\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dad\u0dd2\u0dbb\u0dcf\u0d82 \u0db8\u0dcf\u0dad \u0dca\u0dad\u0d9c\u0dcf\u0dc1 \u0d9a\u0dcf\u0dcf\u0dbd\u0dc1\u0dda \u0db4\u0dca \u0d9a\u0dcf\u0d9a \u0dda\u0dd9\u0d9c \u0dc1\u0dc3\u0dc1\u0db1\u0dc0\u0dd2\u0dbb\u0dca\u0db1 \u0d9a\u0dcf\u0dd2\u0dba\u0dd4 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dcf\u0dd1\u0dd2 \u0d9a\u0dcf\u0dd1\u0dd2 \u0d91\u0d9a\u0dcf\u0dad\u0dd4\u0db8 \u0d9a\u0dcf\u0dbb\u0dbd\u0dcf \u0dad\u0db8\u0dcf\u0dad\u0dba\u0dd2 \u0dc1\u0db8\u0dca \u0dc0\u0da9\u0dd4\u0dda \u0dc0\u0da9\u0da9\u0dd2 \u0d9a\u0dd2\u0db8\u0da7\u0db8\u0dcf\u0dad \u0dc1 \u0ddd \u0d85\u0da9\u0dd4 \u0d9a\u0dd2\u0db8\u0da7\u0db8\u0dcf\u0dad \u0d9a\u0dcf\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d85\u0dc1\u0dda\u0dbd\u0dca \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0dcf\u0dcf\u0da7 \u0d9a\u0dcf\u0da7\u0dca\u0da7\u0da7\u0dd2\u0d9c \u0dd9\u0da9\u0db1 \u0d9c\u0db1\u0dd3\u0dc0\u0dd2 \u0dc0\u0da9\u0dd4\u0dda \u0dc0\u0da9\u0da9\u0dd2 \u0dc1\u0dc0\u0dbd\u0dcf\u0dd9, \u0d85\u0da9\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf\u0dd9 \u0d9a\u0dd2\u0d9c\u0dbd\u0dcf. \u0db8\u0dcf\u0dad\u0da7 \u0d8a\u0dc1\u0dda \u0d9c\u0dbd\u0dca\u0d9c\u0d9a\u0dbb\u0dc1\u0dda\u0daf\u0dd3 \u0dc3\u0dd4\u0dc5\u0dd4 \u0dc1\u0dc3\u0dca\u0dc0\u0dc1\u0dda \u0dd2\u0dbb\u0da7\u0dd2\u0db1 \u0dbb\u0dcf\u0da2\u0dcf\u0dba \u0dc1\u0dc3\u0dca\u0dc0\u0d9a\u0dcf\u0dc1\u0d9c\u0dca \u0d9a\u0dbb \u0dc0\u0dd4\u0d9a\u0dcf. \u0d94\u0dc4\u0dd4 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf, \u0dbb\u0dd4\u0db4\u0dd2\u0d9c\u0dbd\u0dca 900\u0dba\u0dd2 \u0dc0\u0da9\u0da9\u0dd2 \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d9a\u0dd2\u0d9c\u0dbd\u0dcf. \" \u0da9\u0db6\u0da9\u0dba\u0dd2, \u0dc3\u0dbb\u0dca \u0db8\u0dcf\u0dad\u0da7 60 \u0db4\u0da9\u0db1\u0dca\u0db1\u0dcf\u0db8\u0dcf\u0dad \u0db8\u0dcf\u0dad\u0dc1 \u0dc1\u0db4\u0db1\u0dca \u0db1\u0dca \u0d91\u0d9a\u0dcf \u0db1\u0db8\u0dca \u0dbb\u0dd2\" \u0d9a\u0dd2\u0d9c\u0dbd\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0d92 \u0d9a\u0dd2\u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0db1\u0dca\u0dbd\u0dcf \u0dc1\u0db4\u0db1\u0dca \u0db1\u0dca \u0d91\u0d9a\u0dcf\u0da7 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0d9a\u0d9c \u0d89 \u0dca\u0da7 \u0d9a\u0dcf\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0da9\u0db6\u0da9\u0dba\u0dd2, \u0d89\u0dad\u0dd2\u0db1\u0dca \u0dc1\u0db4\u0db1\u0dca \u0db1\u0dca \u0d91\u0d9a\u0dcf \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d85\u0db1\u0dcf\u0d9c\u0dad\u0dc1\u0dda\u0daf\u0dd3. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0db1\u0dca\u0dbd\u0dcf\u0da7\u0dca \u0d9c\u0db8\u0dca \u0dd9\u0dcf\u0d9c\u0d9a\u0dcf\u0dca\u0dc0\u0d9c\u0dca \u0dc1\u0dd9\u0db1\u0dca\u0db1 \u0dc1\u0dc0\u0dba\u0dd2. \u0d85\u0dc1\u0dda \u0d85\u0dbb \u0db8\u0dcf\u0dad\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0dc0\u0dcf\u0dc1 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 20\u0dca-25\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc1\u0dda \u0dc4\u0dd2\u0da7\u0dd2\u0dc1\u0d9c\u0dcf\u0dca \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0db1\u0dca\u0dbd\u0dcf\u0da7 \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0dc1\u0dc0\u0dba\u0dd2.\n\n\u0dc1 \u0dcf\u0db3\u0dba\u0dd2, \u0d89\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0db1\u0db8\u0dca \u0dca\u200d\u0dbb \u0dca\u0db1\u0d9c\u0dca \u0db1\u0da9 \u0da9. \u0da9\u0db6\u0da9\u0dba\u0dd2, \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0d9c\u0dbd\u0dcf \u0db1\u0db8\u0dca \u0d9a\u0dd2\u0d9c\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf. \u0dc3\u0db8\u0dcf\u0dad \u0dbb\u0dd4 \u0d9a\u0dd2\u0d9c\u0db1\u0dc0\u0dcf, \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 20\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf, 30\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0d9c\u0dbd\u0dcf. \u0dc1\u0d9c\u0ddd\u0da8\u0dcf\u0dca \u0d94\u0dc1 \u0dcf\u0db8\u0dcf\u0dad \u0dad\u0db8\u0dcf\u0dad\u0dba\u0dd2 \u0d9a\u0dd2\u0d9c \u0d9a\u0dd2\u0d9c\u0dcf \u0d86\u0dc1\u0dda. \u0d89\u0db1\u0dca\u0db1, \u0dc0\u0da9 \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0db1. \u0d9a\u0dd2\u0dd2\u0dbb\u0db8\u0dcf\u0dad \u0dca\u200d\u0dbb \u0dca\u0db1\u0d9c\u0dca \u0db1\u0da9 \u0da9. \u0dc1\u0db8\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc1 \u0dcf\u0db3\u0da7 \u0d9a\u0dcf\u0dbb\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca, \u0da9\u0db8\u0dcf\u0dad\u0dd9\u0dcf\u0db8\u0dcf\u0dad \u0dc1\u0db8\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dad\u0dd2\u0db6\u0dd4\u0d9a\u0dca \u0d85\u0db4\u0da7 \u0d9a\u0dcf\u0db8\u0dcf\u0dad\u0dca \u0db1\u0da9 \u0da9. \u0d85\u0dc1\u0dda \u0dbb\u0da7 \u0dc1\u0db1\u0dca. \u0da9\u0db6\u0da9\u0dba\u0dd2, \u0d92\u0dc0\u0dcf \u0d9a\u0dd2\u0d9c\u0dbd\u0dcf \u0db1\u0dd2\u0d9a\u0dcf\u0db8\u0dca \u0dc1\u0db4\u0dcf\u0dbb\u0dc1\u0da7\u0ddd\u0dca \u0dc1\u0dd9\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf. \u0d91\u0dc1 \u0db8\u0dcf\u0dad\u0dc1\u0db1\u0dca\u0dd9, \u0d9c\u0dbb\u0dd4 \u0db8\u0dcf\u0dad\u0dc1\u0db1\u0ddd \u0d9c\u0dc1\u0db1\u0dca\u0dc3\u0db1\u0dca \u0db8\u0dcf\u0dad\u0da9\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0db1\u0dd2? \u0d9a\u0dd2\u0d9c\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0db1\u0dd1, \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0db1. \u0d9a\u0dd2\u0d9c\u0db1 \u0d92\u0dc0\u0dcf \u0d85\u0db1\u0dd4\u0dc0 \u0d9a\u0dcf\u0da7\u0dad\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0db1.\n\n\u0dc0\u0dd2\u0dc1 \u0dca \u0dc1\u0d9c\u0db1\u0dca\u0db8\u0dcf\u0dad \u0dc0\u0dd2\u0dc1 \u0dca \u0da5 \u0db0\u0dc0\u0dd9\u0dba\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dc1 \u0dca\u200d\u0dbb\u0dc0\u0dcf \u0db1 \u0daf\u0dd3\u0db8\u0dcf\u0dad\u0db1\u0dcf\u0dc0 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0d9c\u0db1\u0dca \u0db8\u0dcf\u0dad\u0db8\u0dcf\u0dad \u0db8\u0dd3\u0da7 \u0d9a\u0dcf\u0dd2\u0db1\u0dca \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0db1\u0dca\u0dd9 \u0da2\u0dcf\u0d9c\u0dad\u0dd2\u0dc3\u0dca\u0dc3 \u0d87\u0db8\u0dcf\u0dad\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0dcf\u0dc1\u0d9c\u0db1\u0dca \u0dca\u200d\u0dbb \u0dca\u0db1\u0d9c\u0d9a\u0dd4\u0dca \u0d87\u0dc4\u0dd4\u0dc0\u0dcf. \u0d92 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0d9c\u0db1\u0dca \u0dc1\u0db8\u0dca \u0d85\u0d9c \u0dc0\u0da9\u0dc1\u0dda\u0daf\u0dd3 \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0d9c \u0dc1\u0d9c\u0dcf\u0d9a\u0dbb \u0d9a\u0dcf\u0dbb\u0db4\u0dd4 \u0db6\u0dc0\u0dca \u0dc1\u0dda\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0da9 \u0da9. \u0dc0\u0dd2\u0dc1 \u0dca \u0da5 \u0db0\u0dc0\u0dd9\u0dba\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dc1 \u0dc4\u0dd2\u0dc0\u0d9c\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0db4\u0dbb\u0dca\u0d9c\u0db1\u0dca\u0dad \u0dc1\u0dbb\u0ddd \u0dbd\u0dca\u0dc0\u0dbd\n\n1231 1232\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0"
