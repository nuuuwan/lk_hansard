    "chunk_text": "\u0db4\u0dbb\u0dc3\u0dda\u0db4\u0dbb\u0dad\u0dcf\u0dc0\u0dd2\u0dbb\u0dca \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0d9a\u0dc1 \u0dcf\u0dad\u0dca \u0d91\u0d9a\u0d9a\u0dca\u0dad, \u0dbb\u0da7\u0da7 \u0dc1\u0dc4\u0dcf\u0db3 \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0daf\u0dc0\u0dd0\u0db1\u0dd2 \u0d91\u0d9a, \u0dba\u0db6\u0dad\u0dd4 \u0dca\u0dbd\u0dcf\u0dc1\u0dda \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dc0\u0da7 \u0dc1\u0dc4\u0dcf\u0db3 \u0db1\u0dd0\u0dc4\u0dd0. \u0dad\u0dd4\u0dca\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0dcf\u0dbb\u0dab\u0dba, \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da8\u0dcf \u0db6\u0dbd \u0d9a\u0dca\u0dad\u0dad\u0dd2 \u0d9a\u0dca\u0dad\u0dc1\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb\u0dc1\u0d86 \u0d85\u0dc0 \u0dba \u0d9a\u0dbb\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0dc0\u0dc3\u0dda\u0d9a\u0dbb\u0dab \u0db4\u0dca\u200d\u0dbb \u0dcf\u0dab\u0dc0\u0dad\u0dca \u0dc1\u0dbd\u0dc3 \u0d89\u0d9a\u0dca\u0dad \u0db1\u0dd2\u0dca \u0dbd\u0db6\u0dcf \u0d9c\u0dca\u0db1 \u0dc1\u0db1\u0dcf\u0dc4\u0dd0\u0dd2\u0dbb \u0dc0\u0dd4\u0dc1\u0dab\u0dcf\u0dad\u0dca, \u0db4\u0dca\u200d\u0dbb \u0dcf\u0daf \u0dc0\u0dd4\u0dc1\u0dab\u0dcf\u0dad\u0dca, \u0db4\u0da7\u0dbd\u0dd0\u0dd2\u0db0\u0dbd\u0dd2 \u0dc0\u0dd4\u0dc1\u0dab \u0dcf\u0dad\u0dca, \u0db1\u0dca\u0dc4\u0db6\u0dc0\u0dbd\u0da7 \u0dba\u0dca\u0db1 \u0dc0\u0dd4\u0dc1\u0dab\u0dcf\u0dad\u0dca, \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba \u0dc4\u0dbb\u0dc4\u0dcf \u0d85\u0dad\u0dca\u0dc4\u0dd2\u0da7\u0dc0\u0dd6 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0d9c \u0d87\u0dd2\u0db0\u0dbd\u0dca\u0dbd\u0dcf \u0d91\u0dd2\u0dbb\u0dc1\u0db1\u0d9a\u0da7 \u0db4\u0dbb\u0dc3\u0dda\u0db4\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca \u0d9a \u0d9a\u0dbb\u0dca\u0db1 \u0dd2\u0dba\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0d85\u0dc0\u0dd4\u0dbd\u0dca \u0dc3\u0dc4\u0d9c\u0dad \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0da7 \u0db4\u0dad\u0dca \u0dc0\u0dd4\u0dc1\u0dab\u0dcf\u0dad\u0dca \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da8\u0dcf \u0dc3\u0dc0\u0dc0\u0dbb\u0dca\u0dcf\u0db1\u0dba \u0dca\u0db4\u0dc3\u0dd4 \u0dc4\u0dd0 \u0dbb\u0dc1\u0dc0\u0db1\u0dc0\u0dcf.\n\n\u0dc1\u0db8\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db6\u0dbb\u0db4\u0dad \u0db4\u0dbb\u0dc3\u0dda\u0db4\u0dbb\u0dad\u0dcf\u0dc0, \u0dc1\u0db8\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0dba \u0db4\u0dbb\u0dc3\u0dda\u0db4\u0dbb\u0dad\u0dcf\u0dc0 \u0dd2\u0db0\u0dc3\u0db3\u0dcf \u0d9c\u0dad \u0dd4\u0dad\u0dad\u0dd4\u0dd2. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0d89\u0dad\u0dcf \u0dc0\u0d9c\u0d9a\u0dd3\u0dc1 \u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0dc3\u0dd2 \u0db8\u0dca\u0dc1\u0dca \u0dc1\u0db8\u0dca\u0d9a\u0dd2. \u0d85\u0db4\u0dd2 \u0dc3\u0dc4\u0dc1\u0dba\u0ddd\u0d9c\u0dba \u0dc1\u0daf\u0dca\u0db1 \u0d9a\u0dd0 \u0dd0\u0dad\u0dd2\u0dd2, \u0dda\u0daf\u0dda \u0d9a\u0dbb\u0dca\u0db1 \u0d9a\u0dd0 \u0dd0\u0dad\u0dd2\u0dd2, \u0db4\u0d9a\u0dca\u0dad\u0dc2, \u0db4\u0dcf\u0da7 \u0dc1\u0dda\u0daf\u0dba\u0d9a\u0dca\u0dad \u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0db6\u0dbd \u0d9a\u0dca\u0dad\u0dad\u0dd2 \u0d9a\u0dca\u0dad\u0dc1\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb\u0dc1\u0d86 \u0d85\u0dc0 \u0dba \u0d9a\u0dbb\u0db1 \u0dba\u0dcf\u0dc0\u0dad\u0dca\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0dd2\u0dbb\u0dd3\u0db8\u0db8\u0dca \u0d9a\u0dbb\u0dca\u0db1, \u0dc1\u0db8\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0db4\u0dbb\u0dc3\u0dda\u0db4\u0dbb\u0dad\u0dcf \u0dc1\u0dc0\u0db1\u0dc3\u0dda \u0d9a\u0dbb \u0d9c\u0dca\u0db1. \u0d91 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0dc1\u0dc4\u0dcf\u0db3 \u0dc4\u0dd2\u0dad\u0dd2\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dc1\u0dba\u0ddd\u0da2\u0db1\u0dcf \u0d9c\u0dd0\u0db1 \u0dc3\u0dbd\u0d9a\u0dcf \u0db6\u0dbd\u0dca\u0db1. \u0db6\u0dbd \u0d9a\u0dca\u0dad\u0dad\u0dd2 \u0d9a\u0dca\u0dad\u0dc1\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb\u0dba \u0dc0\u0dcf\u0dc1\u0dda \u0d85\u0dad\u0dd2 \u0dba \u0dc0\u0dd0\u0daf\u0d9c\u0dad\u0dca \u0dbb\u0dca \u0dc3\u0dda\u0dcf\u0dcf\u0db1\u0dba\u0d9a \u0dc1\u0db8\u0dca \u0dad\u0dbb\u0db8\u0dca \u0db4\u0dbb\u0dc3\u0dda\u0db4\u0dbb\u0dad\u0dcf \u0d87\u0dad\u0dd2 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0d92\u0d9a \u0dc1\u0dbd\u0dcf\u0d9a\u0dd4 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1\u0dba\u0d9a\u0dca\u0dad; \u0db6\u0dbb\u0db4\u0dad \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1\u0dba\u0d9a\u0dca\u0dad. \u0d92 \u0db6\u0dbb\u0db4\u0dad \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1\u0dba \u0dad\u0dd4 \u0d85\u0dc1\u0db4\u0dca\u0db4 \u0dbb\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0dba\u0dcf \u0db1\u0dd2\u0dc3\u0dd0\u0d9a \u0dc1\u0dbd\u0dc3 \u0d85\u0da9\u0dcf \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. \u0dba\u0db6\u0dad\u0dd4 \u0dca\u0dbd\u0dcf \u0dc1\u0db4\u0dde \u0d9c\u0dbd\u0dd2\u0d9a\u0dc0 \u0dc1\u0dc4\u0ddd \u0d9a\u0dcf\u0dcf \u0d9a\u0dbb\u0dbd\u0dcf \u0dc1\u0db8\u0dca \u0db4\u0dbb\u0dc3\u0dda\u0db4\u0dbb\u0dad\u0dcf\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1\u0dba \u0dd2\u0db0\u0dc3\u0db3\u0dcf \u0d9c\u0dca\u0db1."
