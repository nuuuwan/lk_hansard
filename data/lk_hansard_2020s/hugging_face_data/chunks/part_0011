    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0da2\u0dba \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0dc3\u0dcf\u0db8\u0d9a\u0dcf\u0db8\u0dd3\u0dc0 \u0d85\u0dbb\u0db9\u0db4\u0dd4 \u0d85\u0dbb\u0d9c\u0dc5\u0dba \u0db4\u0dca\u200d\u0dbb \u0dab\u0dca\u0da9\u0da9\u0dcf\u0dad\u0dca\u0dc0\u0dba \u0dc1\u0dad\u0d9a\u0dca\u0dc0 \u0dc1\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dc5\u0dcf. \u0d91\u0dc1\u0dc4\u0db8 \u0dc1\u0db1\u0dcf\u0d9a\u0dc5\u0dcf \u0db1\u0db8\u0dca, \u0dc1\u0d9c\u0dc0\u0dbd\u0dca \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dd0\u0db6\u0dd3\u0db8\u0dca \u0dc1\u0db1\u0dcf\u0d9a\u0dc5\u0dcf \u0db1\u0db8\u0dca, \u0d85\u0dd9 \u0db6\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1 \u0dc1\u0d9c\u0dc0\u0dbd\u0dca \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dd0\u0db6\u0dd3\u0db8\u0dca\u0dc0\u0dbd\u0da7 \u0dc0\u0db1\u0dca\u0daf\u0dd2 \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0dc3\u0dd2\u0dc1\u0db0 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf, \u0d85\u0dd9 \u0dc0\u0dcf\u0dc1\u0dda \u0dc1\u0dc0\u0db1\u0dc3\u0dca\u0dc0 \u0dc4\u0dd2\u0da7\u0dad\u0dd4\u0dc0\u0dcf \u0db1\u0db8\u0dca, \u0db6\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0da7 \u0dc1\u0db8\u0dca \u0dbb\u0da7 \u0db8\u0dd3\u0da7 \u0dc0\u0da9\u0dcf\u0dcf \u0dc1\u0dc4\u0dcf\u0db3 \u0dad\u0dd0\u0db1\u0d9a \u0d89\u0db3\u0dbd\u0dcf \u0d89\u0dc3\u0dca\u0dc3\u0dbb\u0dc4\u0da7 \u0dc1\u0d9c\u0db1 \u0dba\u0db1\u0dca\u0db1 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0dbd\u0dd0\u0dc1\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf, \u0d85\u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0daf\u0dd3\u0dc0 \u0dad\u0dc0 \u0dad\u0dc0\u0dad\u0dca \u0dc1\u0dc0\u0db1\u0dc3\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0db1, \u0dc1\u0db8\u0dca \u0dbb\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0dc1\u0d9c\u0db1 \u0dba\u0db1\u0dca\u0db1 \u0d9a\u0da7\u0dd4\u0dad\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf.\n\n\u0dda\u0db4\u0dcf\u0db0\u0dd2\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca 30,000\u0d9a\u0da7 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0dc1\u0dd9\u0db1\u0dca\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 10,000\u0d9a\u0dca\u0dc0 \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dc5\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf. \u0dc1\u0db8\u0dca \u0d85\u0dba \u0dc0\u0dd0\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0dba\u0ddd\u0da2\u0db1\u0dcf \u0d9a\u0dc5 \u0d85\u0dc0\u0db8 \u0dc0\u0dd0\u0dd4\u0dc0\u0db4 \u0dc0\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 40,000 \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb\u0dbd\u0dcf \u0db6\u0dbd\u0db1\u0dca\u0db1, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca"
  },
