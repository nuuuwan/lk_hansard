    "chunk_text": "\u0dc1\u0db6\u0db1 \u0d85\u0dba\u0dcf\u0d9a \u0ddb\u0dd0\u0dc1\u0dda \u0d9c\u0dd0\u0db9\u0dd4\u0dd2\u0dca \u0db1 \u0dad\u0dd2\u0dc1\u0dca\u0dcf \u0dc1\u0dda \u0dad\u0db1\u0dba\u0dd2 \u0dc1\u0db6\u0db1 \u0dcf\u0dc1\u0da7\u0dca\u0da7 \u0dc1\u0dda \u0db4\u0db8\u0db4\u0dcf \u0dca\u0d82\u0dca\u0dda\u0dcf\u0dd2\u0dad\u0dd2\u0dba\u0dcf\u0d9a \u0dc1\u0ddb\u0dcf\u0dca\u0dda \u0dbb\u0dd3\u0db8\u0db1. \u0dc1\u0dda \u0db4\u0db8\u0db4\u0dcf \u0dca\u0d82\u0dca\u0dda\u0dcf\u0dd2\u0dad\u0dd2\u0dba\u0dcf\u0d9a \u0dc1\u0ddb\u0dcf\u0dca\u0dda \u0dbb\u0dd3\u0db8\u0db1 \u0db1\u0dd2\u0dca\u0db8 \u0d92 \u0dc1\u0db1\u0db8\u0dc1\u0dc4\u0db8\u0dc1\u0dad\u0dca\u0db1 \u0db4\u0dd0\u0dc1\u0dca\u0dcf \u0dc1\u0dda \u0d9c\u0dd0\u0dcf \u0dc1\u0dc4\u0db8\u0db3 \u0d85\u0ddb\u0dc1\u0dca\u0ddd\u0dd9\u0dba\u0dcf\u0d9a\u0dc2\u0dcf \u0d85\u0db4\u0da7 \u0dad\u0dd2\u0dc1\u0dca\u0dcf\u0ddb\u0db8. \u0dc1\u0db6\u0db1 \u0dc1\u0dda \u0db4\u0db8\u0db4\u0dcf \u0dca\u0d82\u0dca\u0dda\u0dcf\u0dd2\u0dad\u0dd2\u0dba\u0dcf\u0d9a \u0dc1\u0ddb\u0dcf\u0dca\u0dda \u0dbb\u0dd3\u0db8\u0db1 \u0db1\u0dd2\u0dca\u0db8\u0db1, \u0da2\u0dcf\u0dad\u0db8\u0ddb \u0d92 \u0dad\u0dd3\u0dcf\u0dab\u0dba\u0dcf\u0d9a \u0d9c\u0dad\u0dca\u0dad \u0db1\u0dd2\u0dca\u0db8\u0db1, \u0d85\u0dad\u0dd2\u0db8\u0dbb \u0db8\u0db4 \u0dcf\u0db8\u0dca\u0dda\u0dad\u0dd2\u0dba\u0dcf\u0d9a\u0dc2\u0dcf \u0dcf\u0dcf\u0db8\u0dd2\u0dca \u0d89\u0db4\u0dc2\u0dcf\u0dcf\u0dba\u0dcf\u0d9a\u0dc2\u0dcf \u0dcf\u0dd0\u0dad\u0dd2\u0ddb \u0dba \u0dba\u0dcf\u0d9a \u0dcf\u0da7, \u0d89\u0db4\u0dc2\u0dcf\u0dcf\u0dca\u0dc4\u0d9c\u0dad, \u0dca\u0dd0\u0db4\u0dc3\u0dd4\u0db6\u0db1 \u0dca\u0dc4\u0d9c\u0dad \u0dca\u0d82\u0db8\u0dbb\u0dd9\u0db8\u0dcf\u0db8\u0dad\u0dca\u0db1\u0dcf \u0dad\u0dd0\u0dcf\u0dcf\u0da7 \u0dc1\u0d9c\u0dc1\u0dcf\u0dca \u0dcf, \u0dcf\u0db8\u0dca\u0dda\u0dad\u0dd2\u0dba\u0dcf\u0d9a \u0dcf\u0dd0\u0dad\u0dd2 \u0dcf\u0dcf\u0dca \u0dcf \u0db4\u0dd4\u0dc5\u0dd4\u0ddb\u0dca \u0dc1\u0dda \u0db4\u0db8\u0db4\u0dcf \u0d85\u0db0\u0dd2\u0dcf\u0db8\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0da7 \u0d85\u0daf\u0dca\u200d \u0dca\u0db4\u0dba\u0dcf\u0d9a \u0db4\u0dd0\u0ddb\u0dd2\u0db4\u0db8 \u0dad\u0dd2\u0dc1\u0dca\u0dcf\u0ddb\u0db8. \u0dc1\u0d9c\u0db8\u0da9\u0dc2\u0dcf \u0d85\u0dba\u0dcf\u0d9a \u0d85\u0dc4\u0dcf\u0ddb\u0db8, \"\u0dc1\u0db6\u0db1\u0ddb\u0db8 \u0dcf\u0dcf\u0dca \u0dcf \u0dca\u0dbd\u0dca\u0dd2 \u0dc1\u0dcf\u0db8\u0dc1\u0dc4\u0dca \u0daf\u0dca\u200d\" \u0dbb\u0dd3\u0dba\u0dcf\u0d9a\u0db4\u0db8. \u0dcf\u0dc1\u0da7\u0dca\u0da7 \u0dca\u0dbd\u0dca\u0dd2 \u0dad\u0dd2\u0dc1\u0dca\u0dcf\u0ddb\u0db8, \u0dc1\u0dc4\u0db8\u0dba\u0dcf\u0d9a\u0db8 \u0d9c\u0dca \u0dcf \u0db4\u0dd4\u0dc5\u0dd4\u0ddb\u0dca . \u0dc4\u0dd0\u0dca\u0dd0\u0dba\u0dd2, \u0dcf\u0db8\u0dca\u0dda\u0dad\u0dd2\u0dba\u0dcf\u0d9a \u0ddb\u0dc5\u0dc2\u0dcf\u0ddb\u0dca \u0dcf \u0d95\u0dcf\u0dd1. \u0d85\u0dc1\u0dda \u0db1\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0ddb\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dcf\u0dc5\u0db8 \u0ddb\u0db8\u0dc1 \u0db1, \u0d92 \u0dc1\u0ddb\u0db1\u0dd4\u0dc1\u0ddb\u0dca \u0d9a\u0dab\u0dca\u0dd4\u0ddb \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca \u0dcf\u0dc5 \u0dc4\u0dd0\u0dbb\u0dd3 \u0dc3\u0dd2\u0dba\u0dcf\u0d9a\u0dbd\u0dd4 \u0dcf\u0dd0\u0db4\u0dbb\u0dd3\u0db8\u0db6\u0db1 \u0dcf\u0dcf\u0dca \u0dcf \u0d85\u0db4\u0dd2 \u0dc3\u0dd6\u0daf\u0dca\u200d\u0db8\u0dcf\u0db6\u0db1. \u0d85\u0db4\u0dd2 \u0d91\u0dc1\u0dc4\u0db1 \u0dcf\u0dcf\u0dca \u0dcf\n\n913 914\n\n2025 \u0dc1\u0db4\u0dca\u0dcf\u0ddb\u0db8\u0dd2 2]\n\n\u0d85\u0daf\u0dca\u200d \u0d85\u0db4\u0da7 \u0dcf\u0dae\u0db8 \u0dcf\u0dcf\u0dca \u0dcf \u0dc1\u0ddb\u0db4\u0db8 \u0dad\u0dd2\u0dc1\u0dca\u0dca \u0dc1\u0dca \u0dc1\u0db1\u0db8\u0dcf\u0ddb\u0db8\u0daf\u0dca\u200d? \u0dbb\u0dd0\u0dbb\u0dd3\u0dba\u0dcf\u0d9a\u0db8 \u0db4\u0dca\u200d\u0dbb \u0dda\u0dcf \u0d9c\u0dd0\u0dcf \u0d85\u0db4\u0da7 \u0dcf\u0dae\u0db8 \u0dcf\u0dcf\u0dca \u0dcf \u0dc1\u0ddb\u0db4\u0db8 \u0dad\u0dd2\u0dc1\u0dca\u0dcf\u0ddb\u0db8. \u0db4\u0dca\u200d\u0dbb\u0ddb\u0db8\u0dc4\u0dcf \u0db4\u0dca\u200d\u0dbb \u0dda\u0dcf \u0d9c\u0dd0\u0dcf \u0d85\u0db4\u0da7 \u0dcf\u0dae\u0db8 \u0dcf\u0dcf\u0dca \u0dcf \u0dc1\u0ddb\u0db4\u0db8 \u0dad\u0dd2\u0dc1\u0dca\u0dcf\u0ddb\u0db8. \u0dca\u0db1\u0dd3\u0db4\u0db8\u0dcf\u0dc2\u0dcf\u0dc2\u0db8\u0ddb \u0d9c\u0dd0\u0dcf \u0d85\u0db4\u0da7 \u0dcf\u0dae\u0db8 \u0dcf\u0dcf\u0dca \u0dcf \u0dc1\u0ddb\u0db4\u0db8 \u0dad\u0dd2\u0dc1\u0dca\u0dcf\u0ddb\u0db8. \u0dc1\u0dcf\u0db8\u0da7\u0dd4\u0ddb \u0daf\u0dd4\u0db6\u0db1\u0dd2\u0dba\u0dcf\u0d9a \u0dca\u0dda\u0dae\u0db8\u0dcf\u0dc1\u0dda \u0dcf\u0db8\u0dca \u0dad\u0db8\u0ddb\u0dca \u0da7 \u0dba\u0dcf\u0d9a\u0dca \u0dcf \u0db4\u0dd4\u0dc5\u0dd4\u0ddb\u0dca \u0dc1\u0dc4\u0db8\u0db3 \u0ddb\u0dd0\u0dc3\u0dd2\u0dbb\u0dd3\u0dd2\u0dba\u0dcf\u0d9a\u0dc2\u0dcf -\u0dca\u0db1\u0dd3\u0db4\u0db8\u0dcf\u0dc2\u0dcf\u0dc2\u0dcf \u0dca\u0dda\u0dae\u0db8\u0dcf\u0dba\u0dcf\u0d9a\u0dc2\u0dcf- \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0dab\u0dca \u0dcf\u0dd0\u0dc4\u0dd0 \u0dc1\u0dca . \u0d92\u0dcf\u0dad\u0dca \u0d85\u0dc1\u0dda \u0d9a\u0dab\u0dca\u0dd4\u0ddb \u0d87\u0db8\u0dbb\u0dbd\u0dca\u0db4\u0db8\u0dc1\u0dca \u0dc4\u0dd0\u0daf\u0dd4\u0dc1\u0dda. \u0d92\u0ddb\u0db8 \u0dc1\u0db4\u0db8\u0dca \u0dc1\u0dda\u0ddb\u0dbd\u0dca \u0dad\u0db1\u0dba\u0dd2. \u0d92 \u0dbb\u0dd4\u0dab\u0db8\u0da7 \u0d92\u0ddb\u0db8 \u0d9c\u0dd0\u0dcf \u0dc4\u0dd2\u0dad\u0db4\u0db8 \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0dab\u0dca \u0dcf\u0dd0\u0dc4\u0dd0\u0dc1\u0dca . \u0daf\u0dca\u200d\u0dd0\u0dca \u0d85\u0db4\u0dd2 \u0dcf\u0dbd\u0dca\u0db4\u0dcf\u0db8 \u0dcf\u0dcf\u0db4\u0db8 \u0dad\u0dd2\u0dc1\u0dca\u0dcf\u0ddb\u0db8 \u0dc1\u0dca \u0dc1\u0db6\u0db1 \u0dcf\u0dc1\u0da7\u0dca\u0da7 \u0dc3\u0dd2\u0dba\u0dcf\u0d9a\u0dbd\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dd9\u0db8\u0dcf \u0dca\u0dda\u0dae\u0db8\u0dcf\u0ddb\u0db4, \u0db1\u0db8\u0dca\u0d9c\u0ddb\u0db4 -\u0db4\u0dca\u200d\u0dbb\u0ddb\u0db8\u0dc4\u0dcf\u0dba\u0dcf\u0d9a\u0da7 \u0dca\u0db6\u0db1\u0dca\u0dca \u0dd9 \u0dad\u0dd0\u0dca \u0ddb\u0db4- \u0dcf\u0db8\u0dca \u0dad\u0db8\u0ddb\u0dca \u0da7 \u0dc4\u0db8 \u0daf\u0dca\u200d\u0dbb\u0dd4\u0ddb\u0dca \u0da7 \u0dc1\u0dc4\u0db8\u0db3 \u0dca\u0db1\u0dd3\u0db4\u0db8\u0dcf\u0dc2\u0dcf\u0dc2\u0dcf \u0dca\u0dda\u0dae\u0db8\u0dcf \u0dc4\u0daf\u0dca\u200d\u0db8 \u0dc1\u0daf\u0dca\u200d\u0dca \u0dcf \u0d95\u0dcf\u0dd1 \u0dbb\u0dd3\u0dba\u0dcf\u0d9a\u0db4\u0db8. \u0d92\u0ddb\u0db8 \u0d9c\u0dd0\u0dcf \u0db8\u0dd3\u0da7 \u0dcf\u0dd2\u0dca \u0dcf\u0dbd\u0dca\u0db4\u0dcf\u0db8 \u0dcf\u0dcf\u0dca \u0dcf \u0dca\u0dd0\u0dd2 \u0dc1\u0ddb\u0db4\u0db8 \u0dad\u0dd2\u0dc1\u0dca\u0dcf\u0ddb\u0db8 \u0dc1\u0dca . \u0d92\u0ddb\u0db8\u0da7 \u0d85\u0dc1\u0dda \u0d9a\u0dab\u0dca \u0dd4\u0ddb \u0d91\u0dcf\u0dcf\u0dca \u0db1 \u0d89\u0dca \u0dcf \u0d95\u0dcf\u0dd1 \u0dbb\u0dd4\u0dab\u0db8 \u0daf\u0dca\u200d? \u0d92 \u0db1\u0dd2\u0dca\u0db8 \u0da2\u0dcf\u0dad\u0db8\u0ddb \u0daf\u0dca\u200d\u0dca \u0dcf\u0ddb\u0db8 \u0dc1\u0db6\u0db1 \u0dc1\u0ddb\u0dca \u0dc1\u0dca \u0dc1\u0db1\u0db8\u0dcf\u0dc2\u0dcf\u0daf\u0dca\u200d \u0dbb\u0dd3\u0dba\u0dcf\u0d9a\u0db4\u0db8."
  },
