    "chunk_text": ",\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1\u0dba\u0ddd\u0dca\u200d\u0dba \u0da7\u0dcf \u0db1 \u0dba\u0da7\u0dd4 \u0db8 \u0dd2\u0dba \u0d91\u0db8 \u0dd2\u0dc0\u0daf\u0dd4\u0dc0\u0dd3\u0dc1\u0db8 \u0db1\u0dca \u0db8\u0dd2\u0dba \u0dc0\u0dba \u0db4\u0dd4\u0daf\u0dca,\u0dbd\u0dba ,\u0dd0\u0db1\u0dad\u0dca \u0db8 \u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d91\u0db8 \u0db4\u0dd4\u0daf\u0dca,\u0dbd\u0dba \u0d85\u0d9a,\u0dc5\u0dba \u0d85\u0dca\u200d\u0dca\u0dae\u0dcf \u0dc1\u0dda\u0daf\u0dd3 \u0da7\u0dd3 56 \u0dc0\u0dd2\u0dba \u0d85\u0dd2\u0dbd\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0db8\u0dd2\u0dd2\u0dba\u0dc3\u0dd4\u0db1\u0dca \u0dc1\u0dd9\u0dc1\u0dd9\u0dc1\u0db1\u0d9a\u0dd4 \u0d9d \u0dad\u0db1\u0dba \u0da7\u0dc5 . \u0d92 \u0d85\u0dca\u200d\u0dca\u0dae\u0dcf \u0dc1\u0dda ]\u0dc1\u0dd9\u0dc1\u0db1\u0d9a\u0dca \u0dd4 \u0dca\u200d \u0dbd \u0dbd\u0dd0\u0db6\u0dd4\u0dca\u200d . \u0da7\u0d9a \u0db4\u0dd2\u0da7\u0dd2\u0dba \u0dc1\u0d9a\u0ddd\u0db1\u0dc1\u0dca \u0dd9\u0dd0\u0da9\u0dd2 \u0dca\u0dad\u0dca\u0da7 \u0d9a \u0d92\u0da7\u0da7\u0dc1\u0dda \u0d92 \u0d85\u0dba \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0da7 \u0d9a \u0dbd\u0dd0\u0db6\u0dd4\u0dca\u200d . \u0d92 \u0dc1\u0dca\u200d\u0da9\u0dd2 \u0dad\u0dd0\u0dd3 \u0db8 \u0da7\u0dc5 \u0db4\u0dd4\u0daf\u0dca,\u0dbd\u0dba \u0dc1 \u0dd9\u0dbb\u0dd4\u0dca\u200d\u0db1\u0dca \u0dc1\u0dd9\u0dc1\u0dd9\u0db1 \u0dd9\u0dd0\u0db1\u0dca \u0da2\u0dd3\u0dd2\u0dbd\u0dad\u0d9a\u0dca\u0dc2\u0dba\u0da7 \u0db4\u0dad\u0dca \u0dc1\u0dca\u200d\u0dbd .\n\n\u0d85\u0dd9\u0dad\u0dca \u0dc1\u0db8 \u0dca\u200d\u0dd0\u0dd2\u0dba \u0dd2\u0dc0\u0daf\u0dca\u0db0\u0dd3\u0db1\u0dca \u0dc1\u0dca\u200d\u0db1 \u0dc1\u0da7\u0ddc\u0da7 \u0d85\u0dc1\u0dda \u0d9a\u0dc1\u0dca, \u0dca\u200d \u0dad\u0dd2\u0da7 \u0d86\u0d9a\u0d9a\u0dca\u0dc2 \u0dca\u200d \u0dc1\u0da7\u0ddc\u0dc1\u0db1 \u0dd9 \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0dbd \u0db8 \u0db8 \u0d85\u0db1\u0db1\u0dca\u0db1 \u0da7\u0dd0\u0db8 \u0dd0\u0dad\u0dd2\u0dba\u0dd2. \u0dc1\u0db8\u0dca \u0db8 \u0dd0\u0dbb\u0dd4\u0db8\u0dca \u0da7\u0dd1 \u0db4\u0dd4\u0daf\u0dca,\u0dbd\u0dba \u0d85\u0dbb\u0dd4\u0dab \u0dd2\u0dbd\u0dd9 \u0db1,\u0db8 \u0dc1 . \u0d94\u0dc4\u0dd4\u0da7 \"\u0da7\u0dda\u0dca\u200d \" \u0d9a\u0dd2\u0dba\u0dbd \u0dad\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u200d . \"\u0da7\u0dda\u0dca\u200d \u0dc1 \" \u0da9\u0dd2\u0dc1\u0dc6\u0db1\u0dca\u0da9\u0dca\u0d9c \u0d91\u0da7 \u0d87\u0dd4 \u0dc1\u0dc5 \u0db3\u0dc0\u0da7\u0d9a\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u200d . \u0d92 \u0db3\u0dc0\u0da7\u0d9a\u0dc1\u0dda \u0dad\u0dd2\u0db6\u0dd2\u0dbd \u0da7\u0dd3-56 \u0dca\u200d\u0dca\u0d9c,\u0dc1\u0dda \u0dc0\u0dd2\u0dba \u0d85\u0dd2\u0dbd \u0dc1\u0dd9\u0da7\u0d9a\u0dca \u0db1\u0dc3\u0dd4 \u0dc1\u0dca\u200d\u0dbd \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u200d . \u0d8a\u0dc1\u0dda\u0dba\u0dd2 \u0d92\u0dca\u200d \u0db1\u0dc3\u0dd4 \u0dc0\u0dd4\u0dc1\u0dab\u0dca \u0dca\u0db1 \u0d85\u0dad\u0dca \u0d85\u0da9\u0dc0\u0dd4\u0dc0\u0dca\u200d\u0da7 ,\u0dad\u0dca\u0dc1\u0dad\u0dca. \u0da0\u0dd6\u0daf\u0dd2\u0dad\u0dba\u0db1\u0dca \u0dad\u0dca\u200d\u0db8 \u0dad\u0dca \u0d85\u0dad\u0dca \u0d85\u0da9\u0dc0\u0dd4\u0dc0\u0dca\u200d\u0da7 ,\u0dd2\u0dba\u0db8\u0dd2\u0db1\u0dca \u0d89\u0db1\u0dca\u0db1\u0dca\u200d . \u0d92 \u0db4\u0dd4\u0daf\u0dca,\u0dbd\u0dba \u0dc1\u0daf\u0dca \u0db4 \u0dbd\u0db1\u0dba \u0da7\u0dc1\u0dc5 \u0d9a \u0dca\u200d\u0db4\u0d9a\u0dca\u0dc2 \u0db4\u0dc0\u0dd4\u0dbd\u0da7. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0db4\u0dc3\u0dd4 \u0dc0\u0dba \u0dca\u200d\u0db1 \u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dca\u200d\u0d9a\u0dab\u0dc1\u0dda\u0daf\u0dd3 \u0d94\u0dc4\u0dd4 \u0da7\u0db4\u0dd2\u0dbd \u0daf\u0dd2\u0dca \u0db1 \u0dba\u0da7\u0dc1,\u0db1\u0dca \u0d85\u0dba\u0dd2\u0db1\u0dca \u0dc0\u0dd4\u0dab . \u0d85\u0dba\u0dd2\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbd \u0d9a \u0dca\u200d\u0db4\u0d9a\u0dca\u0dc2 \u0db4\u0dc0\u0dd4\u0dc1\u0dca \u0d9a\u0db1\u0dca\u0dae - \u0db8 \u0dd0\u0dd9\u0db8\u0dd4\u0dbd\u0dc1\u0db1\u0dca \u0da0\u0dd2\u0db1\u0dca\u0dad\u0da7 \u0d9a\u0dd2\u0dba\u0dbd \u0dc1\u0da7\u0dc1\u0db1\u0d9a\u0dca \u0d89\u0db1\u0dca\u0db1\u0dca\u200d . \u0d92 \u0db8 \u0dd0\u0dd9\u0db8\u0dd4\u0dbd\u0dc1\u0db1\u0dca \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d85\u0dc1\u0dda \u0dca\u0dc0\u0dd2\u0dbd\u0db1 \u0dba\u0da7. \u0d85\u0db4\u0dd2\u0dad\u0dca \u0dca\u0db8 \u0d9f\u0dba\u0dd2 \u0dc4\u0dd2\u0da7\u0dd2\u0dc1\u0dda. \u0d8a\u0da7 \u0db4\u0dca\u0dae\u0dc1\u0dca \u0d94\u0dc4\u0dd4 \u0d85\u0dc1\u0db4\u0db1\u0dca \u0d89\u0dca\u200d\u0dad\u0dca \u0dc0\u0dd4\u0dab . \u0d92 \u0db4\u0dd4\u0daf\u0dca,\u0dbd\u0dba \u0d91\u0dba\u0dad\u0dca \u0d91\u0d9a\u0dca\u0da7 \u0d91\u0da7\u0dd4 \u0dc1\u0dca\u200d\u0dbd \u0dc1\u0dca\u200d\u0db1\u0dad\u0dca \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0da7\u0da7 \u0dc0\u0dba . \u0d85\u0db4\u0dd2\u0dad\u0dca \u0d91\u0d9a\u0dca\u0da7 \u0d91\u0da7\u0dd4 \u0dc0\u0dd4\u0dc1\u0dab\u0dca \u0db1\u0dd0\u0db1\u0dd0.\n\n,\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1\u0dba\u0ddd\u0dca\u200d\u0dba \u0da7\u0dcf \u0db1 \u0dba\u0da7\u0dd4 \u0db8 \u0dd2\u0dba \u0db8 \u0db8 \u0dc1\u0db8\u0dca \u0d85\u0dca\u200d\u0dca\u0dae\u0dcf \u0dc1\u0dda\u0daf\u0dd3 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0da7\u0dd0\u0db8 \u0dd0\u0dad\u0dd2\u0dba\u0dd2 \"\u0da7\u0dda\u0dca\u200d \" \u0d9a\u0dd2\u0dba\u0db1 \u0db4\u0dd4\u0daf\u0dca,\u0dbd\u0dba \u0dc1 \u0db8 \u0d9a\u0dab\u0dba \u0d85\u0db7\u0dd2\u0d9a\u0db1\u0dca\u0d9a\u0dca \u0db3\u0dca\u200d. \u0db8 \u0db8 \u0d89\u0dca \u0dbd\u0dd3\u0db8 \u0d9a\u0dca \u0da7\u0d9a\u0db1\u0dca\u200d \u0d92 \u0db8 \u0d9a\u0dab\u0dba \u0dca\u0db8\u0dca\u0db3\u0db1\u0dca\u0db1\u0dc1\u0dba\u0db1\u0dca \u0db1\u0dbb\u0dd2\u0dba \u0da7 \u0d9a\u0dca\u200d \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0dba\u0d9a\u0dca \u0da7\u0d9a\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd ; \u0db1\u0dbb\u0dd2\u0dba \u0da7 \u0d9a\u0dca\u200d \u0dc1\u0dca\u0ddc\u0dba\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd . \u0dca\u0db8 \u0db1\u0dbb\u0dd4\u0db1\u0dca \u0d85\u0dad\u0d9a \u0db8 \u0dad\u0dca\u200d \u0dd9\u0dba\u0d9a\u0dca \u0dba\u0db1\u0dca\u200d \u0db8 \u0dc4\u0dd2\u0db1\u0dca\u0dd9 \u0d9a \u0dca\u200d\u0db4\u0d9a\u0dca\u0dc2 \u0dca\u200d\u0db1 \u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dd4 \u0db8 \u0dc1 \u0d9a\u0db1\u0dca\u0dae \u0dc1\u0db1\u0dd2\u0db6 \u0dc1\u0dca\u200d\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd \u0dc1\u0db8 \u0ddc\u0dc4\u0dd4 \u0d9d \u0dad\u0db1\u0dba \u0da7\u0dc5 \u0d9a\u0dd2\u0dba . \u0dad\u0dca\u200d\u0dad\u0dca \u0dca\u0db8 \u0db1\u0dbb\u0dd4 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u200d JVP \u0d91\u0dc1\u0d9a\u0dca \u0dd4\u0dc0\u0dbb\u0dd4 \u0dca\u0dc0,\u0db8 \u0dc1\u0dda \u0d89\u0dca\u0dae\u0dc1\u0da7\u0ddd\u0dc1\u0dca \u0db8 \u0db1\u0dad\u0dca\u0dad\u0dba \u0d9d \u0dad\u0db1\u0dba \u0da7\u0dc5 \u0dd2\u0dba\u0dca \u0dc1\u0db8 \u0ddc\u0dc4\u0dd4 \u0d9d \u0dad\u0db1\u0dba \u0da7\u0dc5 \u0d9a\u0dd2\u0dba\u0dbd . \u0d91\u0dd9 \u0d92 \u0d85\u0d9a,\u0dc5\u0dba \u0dca\u0dc0\u0dd2\u0dbd\u0db1 \u0db1\u0dba \u0da7\u0dc1\u0dc5 \u0db7\u0dd2\u0d9a\u0dca\u0dc2\u0dd4 \u0dc1\u0db4\u0d9a\u0db8\u0dd4\u0dc1\u0dab\u0dca \u0db1 \u0db8\u0dd4\u0daf\u0dd4\u0dbb\u0dd4\u0dca\u200d\u0db1\u0dca \u0dca\u200d\u0db1\u0db1\u0dca\u0dc1\u0dca \u0db1\u0db8 \u0d9a\u0dca; \u0dc0\u0dd3\u0d9a\u0da7\u0dd0\u0da7\u0dd2\u0dba \u0db4\u0db1\u0dca\u0dca\u0dc1\u0dca \u0d8b\u0daf\u0dd2\u0dad\n\n1079 1080\n\n\u0db4 \u0dca\u0d9c\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dd4 \u0dca\u200d\n\n\u0db1 \u0db8\u0dd4\u0dbb\u0dd4\u0dc1\u0dca\u200d\u0ddd. \u0d92 \u0db1 \u0db8\u0dd4\u0daf\u0dd4\u0dbb\u0dd4\u0dca\u200d\u0db1\u0dca \u0dca\u200d\u0db1\u0db1\u0dca\u0dc1\u0dca \u0d91\u0d9a\u0dca\u0da7 \u0dad\u0db8 \u0dba\u0dd2 \u0d92 \u0dd4\u0dc0\u0dbb\u0dd4\u0dd4 \u0db8 \u0dc4\u0dd2\u0da7\u0dd2\u0dc1\u0dda. \u0d94\u0dc4\u0dd4 JVP \u0d91\u0dc1\u0d9a\u0dca \u0dc1\u0da7\u0dc1\u0db1\u0d9a\u0dca. \u0dad\u0dca\u200d\u0dad\u0dca \u0da7\u0dca,\u0da7\u0dd2\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u200d JVP \u0d91\u0dc1\u0da7\u0db1\u0dca \u0d9d \u0dad\u0db1\u0dba \u0da7\u0dc5 \u0d9a\u0dd2\u0dba\u0dbd . \u0dad\u0dca\u200d\u0dad\u0dca \u0dca\u0db8 \u0db1\u0d9a \u0da7\u0dca,\u0da7\u0dd2\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u200d \u0d91\u0dba \u0db8 \u0dc0\u0dc1\u0da7\u0ddc\u0dca \u0dbd\u0da7 \u0d9a\u0dc1\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0dbd . \u0d94\u0dc4\u0dd4 \u0da7\u0dd3-56 \u0dc0\u0dd2\u0dba \u0d85\u0dd2\u0dbd\u0dba\u0d9a\u0dca \u0d85\u0d9a\u0dc1,\u0db1 - [\u0db3 \u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9a\u0dca]"
  },
