    "chunk_text": "\u0d92\u0da7\u0da7 \u0d85 \u0dca\u200d ,\u0dad\u0dca\u0dc1\u0dad\u0ddc\u0dad\u0dca \u0db4\u0dc3\u0dd4 \u0dc0\u0dba \u0dca\u200d\u0dca\u0d9a 5 \u0dd4 \u0dc5 \u0dca\u200d\u0dd0\u0da9\u0dd2\u0db8 \u0dca\u200d\u0db1\u0d85\u0dbd\u0dd2 \u0dca\u0dc0\u0d85\u0dba \u0dca\u200d\u0d9a\u0dca \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dc1\u0dda ,\u0dd0\u0da7\u0dd3 \u0db8\u0dd2\u0dba \u0dc0\u0dba \u0dd2\u0dc0\u0daf\u0dca\u0db0\u0dd2 \u0dca\u200d \u0dca\u0d9c\u0dad \u0dc0\u0dd3 \u0d87\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0daf\u0dca \u0dba \u0dc1\u0dbd\u0dca \u0db8 \u0da9\u0da7\u0dbd\u0db4\u0dd4\u0dca\u200d \u0db8 \u0dca\u0d9c,\u0dc1\u0dda 133 \u0dca\u0dd0\u0dad\u0db4\u0dd4\u0db8\u0dca \u0da7\u0dab\u0dd4\u0dca\u200d \u0d86\u0dca\u0db1\u0dca\u0db1\u0dc1\u0dda \u0d87\u0dad\u0dd2 \u0dad\u0dbd\u0db4\u0dad\u0da7\u0db1\u0dca\u0dd9 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0daf\u0dca \u0dba \u0db1\u0db3\u0dd4\u0db1 \u0dc1,\u0db1 \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u200d . \u0dad\u0dca\u200d\u0dd9 2009 \u0dca\u200d\u0dca\u0d9c\u0dc2\u0dc1\u0dda \u0dca\u200d\u0db1\u0dca\u200d \u0dbb\u0dd2 \u0dd2\u0dc0\u0da7 202] \u0dca\u200d\u0dca\u0d9c\u0dc2\u0dc1\u0dda \u0dc1\u0dd9\u0dca\u0dd0\u0db8\u0dca\u0db3\u0dca\u0d9c \u0dd9\u0d9a\u0dca\u0dca\u200d \u0da7 \u0dbd\u0dba \u0dd4 \u0dc5 \u0dca\u200d\u0db1\u0d85\u0dbd\u0dd2 ,\u0dd0\u0da7\u0dd3\u0db8\u0dca \u0dca\u200d \u0dca\u0d9c\u0dad \u0dc1\u0dca\u200d\u0dbd \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u200d . \u0dc1\u0db8\u0dca \u0dca\u0db8\u0dca\u0db3\u0db1\u0dca\u0db1 \u0dd2\u0dc0\u0dba\u0dbd\u0dd4 \u0dc1\u0dad\u0ddc\u0d9a\u0dd4 \u0dbb\u0dd4 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dc1\u0dd9\u0db4 \u0dca\u0d9c\u0dad\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dd4 \u0dca\u200d \u0dca\u0db1 \u0db4\u0dbb\u0dd2\u0dca\u0d9a \u0d85\u0db8 \u0dad\u0dba \u0dc0 \u0dba \u0dca\u0dd4 \u0dca\u200d\u0dad\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u200d . \u0d85\u0db4\u0dd2 \u0dc1\u0db8\u0dca \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0dca\u200d \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0da7\u0d9a\u0db1 \u0dd2\u0dbd\u0dca\u0db3\u0dd4\u0db8\u0dca ,\u0dd0\u0db1 \u0d8a\u0dc1\u0dda\u0dad\u0dca \u0dca \u0da7\u0da0\u0dca\u0da1 \u0da7\u0dc5 \u0dd2\u0dba\u0dca \u0dd2\u0dbd \u0dbd \u0da7 \u0dbd\u0dba\u0d9a\u0dca ,\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dd4 \u0dca\u200d \u0db8 \u0dc1 \u0d85\u0dd9\u0db1\u0dca\u0dae \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d85\u0dca\u200d\u0dca\u0db1\u0dca \u0da7\u0d9a\u0db1\u0dca\u0db1\u0da7 \u0da7\u0dd0\u0db8 \u0dd0\u0dad\u0dd2\u0dba\u0dd2 \u0d85\u0db8 \u0dad\u0dba \u0dc0 \u0dba \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0db1\u0dca.\n\n,\u0dbb\u0dd4 \u0da7\u0dcf \u0db1 \u0dba\u0da7\u0dd4 \u0db8 \u0dd2\u0dba \u0d85\u0db4\u0dd2 \u0dc1\u0da7\u0da7\u0dd2 \u0da7 \u0dbd\u0dd3\u0db1 \u0dca\u0db1 \u0db8 \u0dd0\u0dd9 \u0da7 \u0dbd\u0dd3\u0db1 \u0dd2\u0dbd\u0dca\u0db3\u0dd4\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dab\u0dba\u0d9a\u0dca \u0dc1\u0dba\u0ddd\u0dca\u200d\u0db1 \u0da7\u0d9a \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u200d . \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dc1\u0dd9\u0db4 \u0dca\u0d9c\u0dad\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dd4 \u0dca\u200d \u0dca\u200d\u0dca\u0d9a 160\u0d9a\u0dca \u0dad\u0dd2\u0dca\u0dae\u0dc1\u0dca \u0dd9\u0db1\u0dca\u0db1 \u0d89\u0dad \u0db8 \u0db4\u0dd0\u0db1\u0dd0\u0daf\u0dd2\u0dbd\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dba \u0dad\u0db8 \u0dba\u0dd2 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0db8 \u0dca\u0d9c,\u0dba \u0dc1\u0dd9\u0db4\u0dca \u0dba\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8 \u0dab\u0dba\u0da7\u0da7 \u0db4\u0dbb\u0dd2\u0dca\u0dae\u0dca\u0db8\u0dd2\u0db1\u0dca \u0da7\u0dd0\u0dbd\u0dd1\u0dca\u200d \u0d91\u0dd2\u0db6 \u0da7\u0d9a\u0dbd visibility \u0d91\u0da7 \u0dca\u200d\u0dd0\u0da9\u0dd2 \u0da7\u0d9a\u0db1 \u0d91\u0da7. \u0d92\u0da7\u0da7 \u0dd2\u0dba \u0dae\u0da0\u0dd2\u0dad \u0dca \u0d9a\u0dca\u0dc2\u0dd2\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u200d . \u0db8 \u0db1\u0dca\u0db1 \u0d9a\u0db8\u0dca \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0db8 \u0dca\u0d9c,\u0dc1\u0dda \u0d91\u0dc1\u0db1\u0db8 \u0da7\u0dc5 \u0da7 \u0db4\u0dc3\u0dd4 \u0db4\u0dc3\u0dd4 \u0dc0\u0dba \u0dca\u200d\u0dca\u0d9a \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba \u0dd4 \u0dc5\u0daf\u0dd3 \u0d9a\u0dd2\u0dd2\u0dc0\u0daf\u0dd4 \u0dca\u200d\u0db1\u0d85\u0dbd\u0dd2 ,\u0dd0\u0da7\u0dd4\u0db8 \u0d9a\u0dca \u0dc1\u0dca\u200d\u0dbd \u0db1\u0dd0\u0db1\u0dd0 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba\u0dad\u0dca \u0d91\u0d9a\u0dca\u0da7. \u0d92 \u0dd2\u0dba\u0dca quantum physics\u0dca\u200d\u0dbd solutions \u0dc1\u0db1\u0ddc\u0dc1\u0dca\u200d\u0dba\u0dd2 common sense\u0dca\u200d\u0dbd\u0dd2\u0db1\u0dca ,\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dca\u200d\u0db1\u0dca \u0dca\u0d9a\u0dbd \u0dd2\u0dbd\u0dca\u0db3\u0dd4\u0db8\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u200d . \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0db4 \u0d9a \u0dc1\u0dd9\u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca \u0dca\u200d\u0db1 \u0d86\u0dca\u200d\u0d9a\u0dab\u0dba \u0d89\u0dca\u200d\u0dad\u0dca \u0da7\u0d9a \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dd4\u0daf\u0dd4 \u0da7\u0d9a \u0dad\u0dd2 \u0db6\u0dd4\u0dab \u0db1\u0db8\u0dca \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dbb\u0dd2\u0dba\u0dd0\u0daf\u0dd4\u0d9a \u0da7 \u0dc1\u0db1\u0ddc\u0db3\u0dd2\u0db1\u0dca \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0db8 \u0dca\u0d9c,\u0dba \u0db3\u0dbd ,\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dca\u200d\u0db1\u0dca. \u0d92\u0da7 \u0dad\u0db8 \u0dba\u0dd2 \u0d85\u0dc0\u0da7 1\u0da7 \u0dc1\u0dba\u0ddd\u0dca\u200d\u0db1 \u0da7\u0d9a\u0db1\u0dca\u0dc1\u0db1\u0dca.\n\n2\u0dca\u200d\u0dd0\u0dd2\u0dba \u0d91\u0da7 \u0dad\u0db8 \u0dba\u0dd2 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0db8 \u0dca\u0d9c,\u0dba \u0d94\u0dca\u0dae\u0dc1\u0dca \u0dd9\u0dd0\u0db1\u0da7 \u0d89\u0daf\u0dd2\u0da7\u0d9a \u0d87\u0dad\u0dd2 \u0db4 \u0dbd\u0db8\u0dca \u0db1 \u0dc1\u0db3\u0ddd\u0d9a\u0dca\u0d9a\u0dd4 \u0dd2\u0dba\u0dd2\u0dc0 \u0d8b\u0dca\u0d9a\u0dd2\u0db1\u0dca \u0db1 \u0db4\u0dc5\u0dbd\u0d9a\u0dd2\u0db1\u0dca \u0dd4\u0dad\u0dd4 \u0dca\u200d \u0d85\u0dbd\u0dd2\u0db1\u0dca\u0db1\u0da7 ,\u0db8 \u0db1\u0dca \u0da7\u0dc5 \u0db1\u0dd0\u0d9a\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc2\u0dae\u0dcf \u0db4\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 .\n\n3\u0dca\u200d\u0dd0\u0dd2\u0dba \u0d91\u0da7 \u0dc1\u0db8 \u0db8 \u0da7\u0da7\u0dd4\u0dad\u0dad\u0dca\u0dad\u0da7 \u0dca\u200d\u0db1\u0dad \u0dca\u200d \u0dca\u0db8\u0dca\u0db3\u0db1\u0dca\u0db1 \u0da7\u0d9a ,\u0dd0\u0db1\u0dd3\u0db8 . \u0d85\u0dbd\u0dd2 \u0db1\u0dd0\u0db8 \u0dc1\u0dca\u200d\u0dbd \u0dc1\u0dda\u0db8 \u0d91\u0dc1\u0db1 \u0dc1\u0db8 \u0dc1\u0db1 \u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0db1\u0dd0. \u0dca\u200d\u0db1\u0dad \u0dca\u200d\n\n\u0dd9\u0db1\u0dca\u0db1\u0dca\u200d ,\u0db8\u0dca \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dca\u200d \u0d85\u0dbd\u0dd2 \u0d89\u0db1\u0dca\u0db1\u0dca\u200d \u0db1\u0db8\u0dca. \u0d91\u0dad\u0dc1\u0da7\u0ddc\u0da7 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0d92 ,\u0dd0\u0db1 \u0dd9\u0dd0 \u0db8\u0dca \u0dc1\u0dd9\u0db1 \u0d91\u0da7 \u0d85\u0db8 \u0dbb\u0dd4 \u0dc1\u0dd9\u0dba\u0d9a\u0dca \u0dc1\u0db1\u0ddc\u0dc1\u0dca\u200d\u0dba\u0dd2. \u0d92 \u0dd2\u0dba\u0dca \u0d91\u0dca\u0dae\u0da7\u0dad\u0dca - community participation\u0dad\u0dca - \u0dca\u200d\u0dd0\u0dd9,\u0dad\u0dca."
