    "chunk_text": "\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d87\u0dad\u0dca\u0dad\u0db8\u0dc0 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0dc1\u0dda\u0d9a\u0dba\u0dd2. \u0dc1\u0dda \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0da2\u0dcf\u0dad\u0dcf\u0dc0 \u0dbd\u0dca\u0dc0\u0dd0\u0da7\u0dca\u0da7\u0dd4\u0dc0\u0dcf. \u0d85\u0dc1\u0dcf\u0d9a\u0dca \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0db1\u0dca \u0d8b\u0db4\u0dcf\u0db0\u0dd2\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca 35,000\u0d9a\u0dca \u0dba\u0dd0\u0db1\u0dca \u0db6\u0dbd\u0dcf\u0dc1\u0d9c\u0dcf \u0d89\u0db1\u0dca\u0dcf\u0dc0\u0dcf, \u0dbd\u0dca\u0d9a\u0dd2 \u0dcf \u0dc1\u0dba\u0dcf \u0dad\u0dd4\u0dbb\u0dd4. \u0dc0 \u0dc3 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4\u0dc0 45\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0d85 \u0da7\u0dad\u0dca \u0dbd\u0dca\u0d9a\u0dd2 \u0dcf \u0dc1\u0dba\u0dcf\u0dc0\u0dcf \u0d9a\u0dd2 \u0dbd\u0dcf \u0dc1\u0db4\u0ddc\u0dc1\u0dbb\u0ddc\u0db1\u0dca\u0dd4\u0dc0 \u0dc0\u0dd4\u0dab\u0dcf. \u0dbd\u0dca\u0d9a\u0dd2 \u0dcf \u0dc0\u0dd2\u0dbb\u0dc4\u0dd2\u0dad \u0d8b\u0db4\u0dcf\u0db0\u0dd2\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dc1 \u0dc3\u0d82\u0d9c\u0dda \u0d85\u0db4\u0dd2\u0dc0 \u0dda\u0db6 \u0dc0\u0dd4\u0dab\u0dcf\u0db8\u0dc0 \u0d9a\u0dd2 \u0dcf\u0dc0\u0dcf, 35,000\u0d9a\u0da7\n\n\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1 \u0ddd\u0da2\u0dba \u0d9a\u0dae\u0dcf\u0dcf\u0dcf \u0d9a\u0dad\u0dd4\u0db8\u0dc0\u0db1\u0dd2, \u0d92 \u0dc0\u0dcf\u0dc1 \u0db8\u0dc0 \u0dc1\u0dda \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0d9a\u0dd2 \u0dcf\u0dc0\u0dcf, \u0d85\u0db4\u0dd2 \u0dc0\u0dcf \u0dcf \u0db4\u0dbb\u0dca\u0db8\u0dd2\u0da7\u0dca \u0dc1\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dcf\u0dd0 \u0dd0 \u0d9a\u0dd2 \u0dbd\u0dcf. \u0dc1\u0dda \u0dc1\u0d9a\u0ddc\u0dc1 \u0dda \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dc0\u0dcf \u0dcf \u0db4\u0dbb\u0dca\u0db8\u0dd2\u0da7\u0dca \u0d91\u0d9a\u0d9a\u0dca\u0dba? 2019\u0db1\u0dca \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dda \u0dc1\u0d9a\u0ddc\u0dc1 \u0ddc\u0db8\u0dc0\u0dad\u0dca \u0dc0\u0dcf \u0dcf \u0db4\u0dbb\u0dca\u0db8\u0dd2\u0da7\u0dca \u0dd4\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dcf\u0dd0 \u0dd0. \u0dc1\u0dda \u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dc1\u0daf \u0d92 \u0d9a\u0dcf\u0dbd\u0dc1 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dc1 \u0d9a\u0dca \u0d89\u0db1\u0dca\u0dcf\u0dc0\u0dcf \u0dcf\u0dda \u0dba\u0db1\u0dca\u0dcf\u0dc0\u0dcf, 2019\u0db1\u0dca \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dda \u0dc1\u0d9c\u0ddd\u0da8\u0dcf\u0db7 \u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0dc0 \u0dad\u0dca\u0dad \u0dcf \u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0dc0\u0dcf \u0dcf \u0db4\u0dbb\u0dca\u0db8\u0dd2\u0da7\u0dca \u0dd4\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dcf\u0dd0 \u0dd0 \u0d9a\u0dd2 \u0dcf \u0d91\u0d9a.\n\n\u0dbb\u0db1\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dc3\u0dd2\u0d82 \u0db8\u0dc0 \u0dad\u0dca\u0db8\u0dc0 \u0dcf \u0dc0\u0dcf \u0dcf \u0db4\u0dbb\u0dca\u0db8\u0dd2\u0da7\u0dca \u0dd4\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dcf\u0dd0 \u0dd0. \u0dc1\u0dda \u0d85\u0db8 \u0dad\u0dd2\u0db1\u0dca \u0d9a\u0dbb\u0db4\u0dd4 \u0dc1\u0dba \u0d9a\u0dca \u0dc1\u0dcf\u0ddc\u0dc1\u0dc0\u0dba\u0dd2. \u0dc1\u0dda\u0dc0\u0dcf \u0dc1\u0d9a\u0ddc\u0dc1 \u0ddc\u0db8\u0dc0\u0dad\u0dca \u0dd4\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dcf\u0dd0 \u0dd0. \u0d92 \u0dc0\u0dcf\u0dc1 \u0db8\u0dc0 2024\u0da7 \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0dc0\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0dc0\u0dcf \u0dcf \u0d9a\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0dab\u0dad\u0dca \u0dcf\u0dd0 \u0dd0. \u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d87\u0db8\u0dc0\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf. \u0dc1\u0dda \u0d87\u0db8\u0dc0\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7\u0dad\u0dca \u0d92 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7\u0db8\u0dc0 \u0d92 \u0d9c\u0dab\u0dcf\u0da7\u0db8\u0dc0 \u0dad\u0dd2\u0dc1\u0db6\u0dcf\u0dc0\u0dcf. \u0d91\u0dc1 \u0db8\u0dc0 \u0dcf\u0dd0\u0dad\u0dd2\u0dc0 \u0d85\u0db8 \u0dad\u0dd2\u0db1\u0dca \u0d9a\u0dc5\u0dcf \u0dc0\u0dcf\u0dc1 \u0da2\u0dcf\u0dad\u0dcf\u0dc0 \u0dbb\u0dc0\u0da7\u0dca\u0da7\u0dcf\u0dc0\u0dcf."
  },
