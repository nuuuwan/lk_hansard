    "chunk_text": "\u0d92 \u0dc3\u0db8\u0dcf\u0db1 \u0db6\u0dbb\u0dd2\u0db1\u0dca \u0dc1\u0db1\u0dcf\u0dc0\u0dd4\u0dab\u0dad\u0dca\u0d8b \u0d92 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0db1\u0dcf\u0dc0\u0dd4\u0dab\u0dad\u0dca\u0d8b \u0d8a\u0da7 \u0dc3\u0dbb\u0dd2\u0d89\u0db1 \u0dba\u0dc0\u0dbd\u0db6\u0dd2\u0dda\u0d9c\u0dad \u0d85\u0db4\u0dbb\u0dcf\u0db0 \u0dbb\u0dcf\u0da2\u0dba\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d92\u0dda \u0d87\u0dad\u0dca\u0dad. \u0dc1\u0db8\u0dcf\u0dda\u0d9a\u0dca\u0d9a\u0dba\u0daf \u0dc1\u0dda\u0dda\u0da7 \u0dda\u0dbb\u0db1\u0dca\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca? \u0d85\u0db4\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0dc1\u0daf\u0dda\u0dda\u0da7 \u0dba\u0db1\u0dca\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d91\u0d9a\u0dca\u0d9a\u0dba\u0dc1\u0dda\u0ddd \u0d92 \u0dba\u0dc0\u0dbd\u0db6\u0dd2\u0dda\u0d9c\u0dad \u0d85\u0db4\u0dbb\u0dcf\u0db0 \u0dbb\u0dcf\u0da2\u0dba\u0dba\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0d85\u0db1\u0dd4\u0d9c\u0dad \u0dc1\u0dc0\u0d89\u0dcf \u0d85\u0db4\u0da7 \u0dc0\u0dd0\u0da9\u0dcf \u0dda\u0dbb\u0db1\u0dca\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d91\u0dc1\u0dc4\u0db8 \u0dc1\u0db1\u0dca \u0dda\u0dc0\u0dd4\u0dbb\u0dd4\u0dad\u0dca \u0dda\u0dc1\u0dc5\u0dca. \u0dda\u0dc0\u0dd4\u0dbb\u0dd4\u0dad\u0dca \u0dc1\u0dda\u0dda\u0da7 \u0d85\u0dad\u0d9c\u0dc4\u0db1\u0dca\u0db1 \u0d9c\u0dd2\u0dc1\u0d9a \u0db1\u0dd0\u0dc4\u0dd0. \u0dc4\u0dd0\u0db8\u0dc1\u0daf\u0db1\u0dcf\u0db8 \u0dc1\u0db8\u0dcf\u0dda\u0daf \u0dda\u0dc1\u0dc5\u0dca? \u0dba\u0dc0\u0dbd\u0db6\u0dd2\u0dda\u0d9c\u0dad \u0d85\u0db4\u0dbb\u0dcf\u0db0 \u0dda\u0dca \u0dd2\u0dba\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0d85\u0db1\u0dd4\u0d9c\u0dad\u0dc1\u0dc0\u0d89\u0dcf \u0dc0\u0dd0\u0dc1\u0da9\u0dca \u0dda\u0dbb\u0dc1\u0d9c\u0db1 \u0d9c\u0dd2\u0dba\u0dcf. \u0db8\u0dad\u0dda \u0dad\u0dd2\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0d8b \u0da2\u0dcf\u0dad\u0dd2\u0dda \u0da2\u0db1 \u0db6\u0d89\u0dc1\u0dda\u0d9c\u0dc1\u0d9a \u0d85\u0dc1\u0dda \u0d86\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0dc1\u0dda \u0dba\u0dc0\u0dbd\u0db6\u0dd2\u0dda\u0d9c\u0dad \u0d85\u0db4\u0dbb\u0dcf\u0db0 \u0dda\u0dca \u0dd2\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0dc4\u0dd0\u0dda\u0db4\u0dd2\u0d89\u0dcf \u0d92\u0dc0\u0dcf \u0d85\u0dc1\u0dda \u0dbb\u0dc0\u0dbd\u0db1\u0dca \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dda\u0dbb\u0db1\u0dc0\u0dcf. \u0db8\u0dad\u0dda \u0dad\u0dd2\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0db1. \u0d92\u0dda \u0dda\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0db1\u0dd0\u0dda\u0daf? \u0db8\u0db8 \u0d85\u0dc4\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d91\u0da0\u0dca\u0da0\u0dbb\u0dd2.\n\n\u0d8a\u0dc5\u0d9f\u0da7\u0d8b \u0dc1\u0db4\u0dcf\u0dd2\u0dc3\u0dca \u0dc1\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dc1\u0dda\u0db1\u0dca\u0dd4\u0dc0. \u0db8\u0db8 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf\u0d8b \u0d85\u0dc1\u0dda \u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0db8\u0dcf\u0db1 \u0dc0\u0dd0\u0da9\u0dcf \u0db6\u0d89\u0db1 \u0dc1\u0db4\u0dcf\u0dd2\u0dc3\u0dca\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0dcf \u0dc0\u0dd2 \u0dcf\u0d89 \u0dda\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dda\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0dc0\u0dbd\u0db1\u0dc0\u0dcf. \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dda\u0dcf\u0d89\u0dc1\u0d9a \u0dc1\u0db4\u0dcf\u0dbd\u0dd3\u0dc3\u0dd2\u0dba \u0dc0\u0dd2 \u0dcf\u0d89 \u0dc0 \u0dc1\u0dba\u0db1\u0dca \u0d85\u0db4\u0dbb\u0dcf\u0db0\u0dda\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d85\u0dad\u0dca\u0d85\u0da9\u0dcf \u0d82\u0d9c\u0dd4\u0dc0\u0da7 \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf; \u0d85\u0dc0\u0dd2 \u0d86\u0dad\u0db0 \u0d85\u0dad\u0dca\u0d85\u0da9\u0dcf \u0d82\u0d9c\u0dd4\u0dc0\u0da7 \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1 \u0db8 \u0dc0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dda\u0dcf\u0dbb\u0dc1\u0d9a \u0d85\u0db4\u0dbb\u0dcf\u0db0\u0dc0\u0d89\u0da7 \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0 \u0dc1\u0db4\u0dcf\u0dd2\u0dc3\u0dca \u0db1\u0dd2\u0d89\u0db0\u0dcf\u0dbb\u0dd2 \u0db8\u0dc4\u0dad\u0dca\u0dc0\u0dbb\u0dd4\u0dad\u0dca \u0d85\u0dad\u0dca\u0d85\u0da9\u0dcf \u0d82\u0d9c\u0dd4\u0dc0\u0da7 \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0d87\u0dd2 \u0d92? \u0dc1\u0dda link \u0d91\u0dda \u0dda\u0da9\u0dcf \u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0db4\u0dbb\u0dcf\u0db0\u0dda\u0dbb\u0dd4\u0dc0\u0dcf \u0dc4\u0dd4\u0daf\u0dd4 \u0d85\u0db4\u0dbb\u0dcf\u0db0\u0dc1\u0d9a \u0dc1\u0dda\u0dcf\u0da7\u0dc3\u0d9a\u0dca\u0d9a\u0dba \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca\u0d9a\u0dba \u0dda\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1\u0d8b \u0dc1\u0dda \u0da2\u0dcf\u0d89\u0dc1\u0d9a \u0dc1\u0dda\u0dcf\u0da7\u0dc3\u0dd2\u0db1\u0dca \u0d9c\u0d89\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0dc1\u0dda \u0da2\u0dcf\u0d89\u0dc1\u0d9a \u0d91\u0d9a\u0dd2\u0db1\u0dca \u0d91\u0dda \u0d9c\u0d89\u0dc0 \u0d9c\u0d89\u0dc0\u0dcf \u0dba\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0d92\u0dda \u0d9c\u0d89\u0dc0\u0db1\u0dc0\u0dcf. \u0dc1\u0dc4\u0dcf\u0db3\u0daf? \u0d91\u0dad\u0dc1\u0dda\u0dcf\u0da7 \u0dda\u0dcf\u0da7\u0dc4\u0dbb\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0d8b \u0dc1\u0dda \u0db4\u0dcf\u0d89\u0db1 \u0db8\u0dcf\u0dbb\u0dd4\u0dc0\u0dd3\u0dda \u0d9a\u0dd2\u0dba\u0d89\u0dcf. \u0d92 \u0d9a\u0dd2\u0dc3\u0dd2\u0dc0\u0d9a\u0dca\u0d9a\u0dba \u0dc1\u0dda \u0db4\u0dcf\u0d89\u0db1 \u0db8\u0dcf\u0dbb\u0dd4\u0dc0\u0dd3\u0dda \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dd2. \u0db8\u0db8 \u0db4\u0dc3\u0dd4\u0dc0 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dda \u0d92 \u0d9c\u0dd0\u0db1. \u0db8\u0da7 \u0dc1\u0dc4\u0ddd \u0d85\u0dc1\u0dda \u0d9a\u0dd2\u0dc3\u0dd2\u0dc1\u0dc0\u0d9a\u0dd4\u0da7 \u0d85\u0dc0 \u0dba \u0db1\u0dd0\u0dc4\u0dd0\u0d8b \u0d85\u0db4\u0da7 \u0d95\u0db1\u0dd1 OIC \u0dc1\u0dda\u0dc1\u0db1\u0d9a\u0dca\u0d9a\u0dba \u0db4\u0dad\u0dca\u0dda\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0d8b \u0d85\u0db4\u0da7 \u0d95\u0db1\u0dd1 \u0dc1\u0db4\u0dcf\u0dd2\u0dc3\u0dca\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dc1\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0db4\u0dad\u0dca\u0dda\u0dbb \u0d9c\u0db1\u0dca\u0db1. \u0d92\u0dc0\u0dcf \u0d85\u0dc1\u0dda \u0dc1\u0d89\u0ddd\u0dda\u0dc1\u0d9a \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0db8 \u0d92\u0dda \u0db4\u0dc3\u0dd4\u0dc0 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dda."
