    "chunk_text": ",\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1\u0dba\u0ddd\u0dca\u200d\u0dba \u0da7\u0dcf \u0db1 \u0dba\u0da7\u0dd4 \u0db8 \u0dd2\u0dba ,\u0dbb\u0dd4 \u0dca\u200d\u0db1\u0db4\u0dad\u0dd2\u0dd4 \u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u200d Clean Sri Lanka \u0dca\u200d\u0dd0\u0da9\u0dca\u0da7\u0db1\u0dc1\u0db1\u0dca \u0d85\u0db7\u0dd2\u0dbd \u0dc2 ,\u0dd0\u0db1. \u0db4\u0dc5\u0db8\u0dd4\u0dca\u200d\u0dd0\u0dd2\u0dba \u0d91\u0da7 \u0dad\u0db8 \u0dba\u0dd2 \u0dba\u0db1\u0db4\u0dad\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0da7\u0d9a\u0dab\u0dba \u0dca \u0db1 \u0dca\u200d\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dca\u0dc0\u0dca\u0dae\u0da7\u0d9a\u0dab\u0dba. \u0dc1\u0dd9\u0dca\u200d\u0dd0\u0dd2\u0dba \u0d91\u0da7 \u0daf\u0dd6\u0dc2\u0dab \u0dd2\u0dbd\u0dc1\u0d9a\u0ddd\u0db0\u0dd3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0db8 \u0dca\u0d9c,. ,\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1\u0dba\u0ddd\u0dca\u200d\u0dba \u0da7\u0dcf \u0db1 \u0dba\u0da7\u0dd4 \u0db8 \u0dd2\u0dba ,\u0dbb\u0dd4 \u0dca\u200d\u0db1 \u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dd4 \u0db8 \u0dc1 \u0d85\u0dba \u0dca\u200d\u0dd0\u0dba \u0da7\u0dcf \u0dc1\u0dda Clean Sri Lanka \u0dca\u200d\u0dd0\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dca\u200d\u0dc5 \u0dba\u0da7\u0dad\u0da7 \u0dc1\u0db8\u0dca\u0dca\u200d \u0d85\u0d9a\u0dc1,\u0db1 \u0d91\u0db1 \u0d91\u0da7 \u0db4\u0dd4\u0daf\u0dd4\u0db8 \u0dba\u0dd2. Clean Sri Lanka \u0dca\u200d\u0dd0\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dca\u200d\u0dc5 \u0dc1\u0db1\u0ddc \u0dba\u0dd2. \u0db4\u0dbb\u0dd2\u0dca\u0d9a\u0dba \u0d86\u0d9a\u0d9a\u0dca\u0dc2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc1\u0dca\u200d \u0dc1\u0dca\u200d\u0db1\u0dca \u0da7\u0d9a\u0db1 \u0d86\u0dc1\u0dba\u0ddd\u0dca\u200d\u0db1\u0dba \u0dca\u200d\u0dd0\u0dd9,\u0dad\u0dca.\n\n1041 1042\n\n[,\u0dbb\u0dd4 \u0d85\u0da2\u0dd2\u0dad\u0dca \u0db4\u0dd3. \u0dc1\u0db4\u0dc1\u0dca\u0d9c\u0d9a \u0db8 \u0db1\u0dad ]\n\n2025 \u0dc1\u0db4\u0db3\u0d9a\u0dca\u200d \u0dbb\u0dd2 22\n\n\u0daf\u0dd6\u0dc2\u0dab\u0dba \u0d85\u0dca\u200d\u0db8 \u0da7\u0d9a\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dca\u200d\u0db1\u0dca \u0db3\u0daf\u0dd4\u0da7\u0d9a\u0dab\u0dba \u0d9a\u0dca\u0dad\u0dd2\u0db8 \u0dad\u0dca \u0da7\u0d9a\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dca\u200d\u0db1\u0dca \u0d9a \u0dca\u200d\u0dba \u0d86\u0dd9 \u0dba\u0db8 \u0dca\u200d\u0dd0\u0da9\u0dd2 \u0da7\u0d9a ,\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dca\u200d\u0db1\u0dca. \u0d92 ,\u0dd0\u0db1 \u0d9a\u0dd2\u0dd2\u0dc0\u0db8 \u0dca\u0dd0\u0da7\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0db1\u0dd0. \u0d92 \u0dca\u200d \u0dc1 \u0db8 \u0dc1\u0db8\u0dca \u0d9a\u0dc1\u0dca, \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0dd2\u0dba\u0dd2\u0dc0 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0dad\u0dca\u0db8 \u0da7 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db1\u0d9a\u0db1 \u0daf\u0dd6\u0dc2\u0dab\u0dba \u0d85\u0dca \u0dbd\u0dca \u0db1\u0dad\u0d9a \u0da7\u0dc5 \u0db1\u0dd0\u0d9a\u0dd2\u0dba\u0dd2 \u0db8 \u0dca\u0d9c\u0dd9\u0db1\u0dba \u0da7\u0dc5 \u0db1\u0dd0\u0d9a\u0dd2\u0dba\u0dd2. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d85\u0dca\u200d \u0dca\u0db1 \u0dca\u200d\u0da7\u0da7 \u0dc1\u0db8\u0dca \u0d85\u0dba \u0dca\u200d\u0dd0\u0dba \u0da7\u0dcf \u0dc1\u0dda \u0d9a\u0dd2\u0dd2\u0dc0\u0db8 \u0dad\u0dd0\u0db1\u0da7 \u0daf\u0dd6\u0dc2\u0dab\u0dba \u0db1\u0dad\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0da7 \u0d92 \u0dca\u200d \u0dc1 \u0db8 \u0d85\u0dca \u0dbd\u0dca\u0da7 \u0daf\u0dd6\u0dc2\u0dab\u0dba\u0da7 \u0d91\u0dc1\u0d9a\u0dc4\u0dd2 \u0d86 \u0dba\u0dad\u0db1 \u0d9a\u0dca\u0dad\u0dd2\u0db8 \u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0da7 \u0db1\u0dca\u200d \u0dca\u200d\u0dd0\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dca\u200d\u0dc5\u0d9a\u0dca \u0db1\u0dd0\u0db1\u0dd0. \u0d85\u0dca \u0dbd\u0dca\u0dae \u0dc1\u0db1\u0ddd \u0daf\u0dd6\u0dc2\u0dab \u0dc1\u0da0\u0ddd\u0dd9\u0db1 \u0dd2\u0dbd\u0db8 \u0dca\u0d9c \u0db1 \u0dc1\u0da7\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dca\u0dcf \u0dca\u200d \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u200d . \u0d92\u0da7\u0da7 \u0da7\u0dca\u200d\u0dd9\u0dad\u0dca \u0db1\u0dd0\u0db8 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dca\u200d\u0d9a\u0dca\u0db8 \u0db8\u0dd4\u0dd9\u0dca \u0dc1\u0dca\u200d\u0db1\u0dca \u0da7\u0dc5 . \u0d91\u0db8 \u0dd2\u0dba\u0dbd\u0db1 \u0dbb\u0dd2\u0db1\u0dca\u0da7 \u0db4\u0da9\u0dd2 \u0db1\u0da9\u0dd2 \u0dc1,\u0dca\u200d\u0db1\u0dca\u200d \u0d9a\u0dd4\u0dbd\u0dd3 \u0dc1,\u0dca\u200d\u0db1\u0dca\u200d . \u0d92\u0dca\u200d \u0d94\u0d9a\u0dca\u0dc1\u0da7\u0ddd\u0db8 \u0db1\u0dbb\u0dd2. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dc1\u0db8 \u0ddc\u0da7\u0d9a\u0dca\u0dd9 \u0d85\u0dbd\u0dd4\u0dad\u0dca programme \u0d91\u0da7? \u0dc1\u0db8 \u0ddc\u0da7\u0d9a\u0dca\u0dd9 \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0dca\u200d\u0dd0\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dca\u200d\u0dc5? \u0d91\u0dc1\u0db1\u0db8 \u0d91\u0da7\u0d9a\u0dca \u0db1\u0dd0\u0db1\u0dd0 ,\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1\u0dba\u0ddd\u0dca\u200d\u0dba \u0da7\u0dcf \u0db1 \u0dba\u0da7\u0dd4 \u0db8 \u0dd2\u0dba.\n\n\u0d85\u0db4\u0da7 \u0dc1\u0db8\u0dca ,\u0dd0\u0db1 \u0da7\u0dcf \u0da7\u0d9a\u0db1\u0dca\u0db1 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u200d . \u0dc1\u0db8\u0dca \u0d9a\u0dc1\u0dca, \u0d85\u0dca \u0dbd\u0dca \u0db1 \u0daf\u0dd6\u0dc2\u0dab\u0dba \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0db1\u0da9\u0dd4 \u0dd2\u0dbd\u0dcf , \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0dca\u200d \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dae\u0db1 \u0dd2\u0dbd\u0dca \u0db1\u0dca\u0db1 201]\u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0db8 \u0dd0\u0daf\u0dd2\u0db1\u0dad\u0dca \u0dc0\u0dd4\u0dab . \u0dc1\u0db8\u0dca \u0db4 \u0dca\u0d9c\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dd4 \u0dc1\u0dda \u0dc0\u0db1\u0dad\u0dd2\u0da7 \u0da7\u0da7\u0dd4\u0dad\u0dd4 (\u0daf\u0dd6\u0dc2\u0dab \u0dd2\u0dbd\u0dc1\u0d9a\u0ddd\u0db0\u0dd3) \u0dca\u0db1 \u0db8 \u0db1\u0dba \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0d86\u0dc0\u0dc1\u0dd2\u0da7 \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0da7 \u0d9a\u0da7 \u0dca\u0dcf \u0dca\u200d \u0dd4 \u0dc5 \u0dca \u0da7\u0da0\u0dca\u0da1 \u0da7\u0d9a\u0dbd \u0db4 \u0dca\u0d9c\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dd4 \u0dc1\u0dda \u0db8 \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dca\u200d\u0dbb\u0dd4\u0db1\u0dca\u0dc1 \u0d85\u0dd9\u0db1\u0dca\u0dae \u0d91\u0da7\u0dd4 \u0da7\u0d9a\u0dbd \u0d91\u0dba\u0da7 \u0db8 \u0dd0\u0daf\u0dd2\u0db1\u0dad\u0dca \u0dc1\u0dca\u200d\u0db1\u0dca\u0db1 \u0d85\u0db4\u0da7 \u0d91\u0dd9 \u0db1\u0dd0\u0d9a\u0dd2\u0dba \u0dca\u200d \u0dbd\u0dd0\u0db6\u0dd4\u0dab . ,\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1\u0dba\u0ddd\u0dca\u200d\u0dba \u0da7\u0dcf \u0db1 \u0dba\u0da7\u0dd4 \u0db8 \u0dd2\u0dba \u0d92 \u0da7 \u0d9a\u0dab\u0dba\u0da7 \u0d85\u0dd9 \u0dc5\u0dca\u200d \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0db8 \u0dca\u0d9c, \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca ,\u0dad \u0dd4\u0dad\u0dd4 \u0dba\u0dd2. 201] \u0d85\u0dc0\u0da7 9 \u0dd9\u0d9a\u0db1 \u0d85\u0db0\u0dd2\u0da7\u0d9a\u0dab \u0dca\u0dc0\u0dd2\u0dbd\u0db1 \u0db1 (\u0dca\u0dc0\u0dc1 \u0ddd\u0db1\u0db1) \u0db4\u0db1\u0dad \u0dba\u0da7\u0dc1\u0dad\u0dca \u0daf\u0dd6\u0dc2\u0dab \u0dd2\u0dbd\u0dc1\u0d9a\u0ddd\u0db0\u0dd3 \u0dca\u0dae\u0dd2\u0d9a\u0d9a \u0dad\u0dca\u200d\u0dbb\u0dd2\u0db4\u0dd4\u0daf\u0dca,\u0dbd \u0db8 \u0db1 \u0db0\u0dd2\u0da7\u0d9a\u0dab\u0dba\u0d9a\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0dc1\u0da7\u0dda\u0dca\u200d . \u0d92 \u0db4\u0dc5\u0db8\u0dd4\u0dc1\u0dca\u200d\u0dd2\u0dba \u0d91\u0da7."
  },
