    "chunk_text": "\u0dad\u0dad\u0dca\u0dad\u0dca\u0ddb\u0dba\u0dcf\u0d9a\u0dc2\u0dcf. \u0d89\u0daf\u0dd2\u0dc1\u0dda\u0daf\u0dd3 \u0dc1\u0db6\u0db1 \u0dcf\u0da7 \u0daf\u0dba\u0dd4\u0dab\u0dd4 \u0dcf\u0dcf\u0dca \u0dcf \u0db4\u0dd4\u0dc5\u0dd4\u0ddb\u0dca \u0ddb\u0db4\u0dca\u0dd2\u0dba\u0dcf\u0d9a \u0dc1\u0db6\u0db1\u0dc1\u0dcf\u0dca \u0dc4\u0dd0\u0dc1\u0daf\u0dca\u200d\u0dba\u0dd2 \u0dbb\u0dd3\u0dba\u0dcf\u0d9a\u0db4\u0db8 \u0d85\u0db4\u0dd2 \u0dca\u0db4\u0db8\u0dc1\u0db4\u0db8\u0dc1\u0dcf\u0db8\u0dad\u0dca\u0dad\u0dd4\u0db8\u0dcf \u0dc1\u0ddb\u0dcf\u0ddb\u0db8. \u0dc1\u0db1\u0db8\u0dcf\u0daf\u0dca\u200d, \u0d89\u0dad\u0dd2\u0dc4\u0db8\u0dca\u0dba\u0dcf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0dc5\u0db1 \u0dc1\u0db6\u0db1 \u0dcf\u0dc1\u0da7\u0dca\u0da7 \u0dca\u0d82\u0ddb\u0dca\u0dd9\u0dcf\u0dba\u0dcf\u0d9a\u0da7 \u0da2\u0dcf\u0dad\u0db8 \u0db8\u0dbb\u0db8\u0dd4\u0dc2\u0dcf\u0dad\u0dd2 \u0dc1\u0db4\u0dcf\u0db8\u0dd4\u0dab \u0dca\u0db8\u0dd9\u0db8 \u0dcf\u0dc5\u0db8. \u0db8\u0dbb\u0dc1 \u0dda\u0dc2\u0dc1\u0dba\u0dcf\u0d9a\u0dca \u0db1 \u0dc1\u0db4\u0dde\u0dda\u0d9c\u0dd3\u0dcf\u0dcf\u0dab\u0dba\u0dcf\u0d9a, \u0db8\u0dbb\u0ddb\u0dd2\u0dad \u0d9a\u0dca\u0dd2\u0dcf\u0dba\u0dcf\u0d9a, \u0dd2\u0dca\u0dcf\u0dbd\u0dca\u0ddb\u0db8\u0daf\u0dca\u200d\u0dba\u0dcf\u0d9a \u0dba\u0dcf\u0d9a\u0dcf\u0db8\u0daf\u0dba\u0dcf\u0d9a\u0da7 \u0db8\u0dbb \u0db8\u0db4 \u0dc1\u0db4\u0dca \u0db4\u0dc4\u0dcf \u0d9c\u0dd0\u0dc4\u0dd4\u0dc1\u0dda \u0da2\u0dcf\u0dad\u0db8 \u0db8\u0dbb\u0db8\u0dd4\u0dc2\u0dcf\u0dad\u0dd2 \u0dc1\u0db4\u0dcf\u0db8\u0dd4\u0dc1\u0dab\u0dca \u0dcf\u0db8\u0dba\u0dcf\u0d9a\u0dcf\u0dba\u0dcf\u0d9a\u0db8. \u0d85\u0db4\u0dd2 \u0db8\u0dbb\u0dc1\u0dda\u0dc0\u0dd3\u0dcf \u0dca\u0dc1\u0dc4\u0ddd\u0daf\u0dca\u200d\u0dcf\u0dba\u0dcf\u0d9a\u0db8\u0dc1 \u0dcf\u0dae\u0db8 \u0d85\u0dca\u0db8 \u0dad\u0dd2\u0dc1\u0dca\u0dcf\u0ddb\u0db8. \u0d91\u0dcf\u0ddb\u0dcf\u0dc2\u0dcf \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0db8 \u0d91\u0dcf \u0dc1\u0dc4\u0dc5\u0db8\u0db1 \u0dbb\u0dd3\u0dda\u0ddb\u0db8, \u0dd4\u0dbb\u0dd4\u0dca \u0d85\u0db1\u0dd4\u0d9c\u0db1\u0dcf\u0dba\u0dcf\u0d9a \u0dcf\u0dc5 \u0dca\u0db1\u0db8\u0da2\u0ddb\u0db8\u0daf\u0dd3, \u0db1\u0db8\u0dc2\u0dcf\u0dca\u0dda\u0ddb\u0db8\u0daf\u0dd3 \u0daf\u0dca\u200d\u0dca \u0dcf\u0dba\u0dcf\u0d9a \u0d85\u0dad \u0dc4\u0dd0\u0dd2\u0dc1\u0dba\u0dcf\u0d9a\u0db8\u0dad\u0dca \u0d92\u0dcf \u0db4\u0db8\u0ddb\u0db8\u0daf\u0dd3\u0db1\u0dc2\u0dcf \u0dbb\u0dd3\u0dba\u0dcf\u0d9a\u0db4\u0db8. \u0d91\u0db1 \u0db4\u0db8\u0ddb\u0db8\u0daf\u0dd3\u0db1 \u0db4\u0dc2\u0dcf\u0dc2\u0dba\u0dcf\u0d9a\u0da7 \u0dc1\u0dc4\u0db8\u0db3 \u0dc1\u0dcf\u0db8\u0dbb\u0dd4\u0dab\u0dad\u0dca, \u0db1\u0db1 \u0dc4\u0dd2\u0dad\u0dcf \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0dcf\u0d9a\u0da7 \u0d91\u0db1 \u0dc1\u0ddb\u0dcf\u0dca\u0dda \u0dc0\u0dd3\u0db1 \u0d85\u0dc1\u0dda \u0dcf\u0da7\u0da7 \u0dcf\u0db6\u0db1 \u0d89\u0dad\u0db8\u0db1 \u0dca\u0db8\u0dd9\u0db1\u0dd3\u0dba\u0dcf\u0d9a \u0dad\u0dad\u0dca\u0dad\u0dca\u0ddb\u0dba\u0dcf\u0d9a\u0dc2\u0dcf. \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dca \u0db4\u0db8 \u0db8\u0dbb\u0db4\u0dc2\u0dcf\u0dc2\u0da7 \u0dba \u0dba\u0dcf\u0d9a \u0daf\u0dca\u200d\u0ddb\u0dca\u0dcf \u0dbb\u0dd4\u0dab\u0dad\u0dca, \u0daf\u0dd6\u0dc2\u0dab\u0dc1\u0dba\u0dcf\u0d9a\u0dca \u0dc1\u0dad\u0db8\u0dcf\u0ddb, \u0dc4\u0dd2\u0dba\u0dcf\u0d9a\u0da7 \u0d9a\u0dab\u0dca\u0dd4\u0ddb\u0dc2\u0dcf \u0dcf\u0dcf\u0dcf \u0daf\u0dca\u200d\u0dc2\u0dcf\u0dc2 \u0dcf\u0dab\u0dca\u0da9\u0db8\u0dba\u0dcf\u0d9a\u0db1\u0dcf\u0da7 \u0dcf\u0dd0\u0ddb\u0dad \u0dc1\u0db6\u0db1 \u0dcf\u0da7 \u0dc4\u0daf\u0dca\u200d\u0dca \u0dcf \u0db4\u0dd4\u0dc5\u0dd4\u0ddb\u0dca \u0ddb\u0db4\u0dca\u0dd2\u0dba\u0dcf\u0d9a \u0dc1\u0db6\u0db1 \u0dc1\u0ddb\u0dcf\u0dc1\u0dcf\u0db8\u0da7 \u0d87\u0dad\u0dd2 \u0dc1\u0ddb\u0db4\u0db8 \u0dad\u0dd2\u0dc1\u0dca\u0dcf\u0ddb\u0db8.\n\n\u0dc1\u0dda.\u0d9a\u0dca. \u0da2\u0dba\u0dcf\u0d9a\u0ddb\u0dca\u0dd9\u0dcf, \u0da9\u0dd3.\u0d91\u0dca\u0dda. \u0dc1\u0dca\u0dda\u0dcf\u0db8\u0dcf\u0db8\u0dba\u0dcf\u0d9a\u0dcf, \u0da9\u0dda\u0dd2 \u0dc1\u0dca\u0dda\u0dcf\u0db8\u0dcf\u0db8\u0dba\u0dcf\u0d9a\u0dcf, \u0dc1\u0da2\u0ddd\u0dca \u0dc1\u0dcf\u0db8\u0dad\u0db4\u0db8\u0ddb\u0db4, \u0d9c\u0db8\u0db8\u0dd2\u0dab\u0dd3 \u0daf\u0dca\u0db8\u0dcf\u0db8\u0dba\u0dcf\u0d9a\u0dcf \u0dbb\u0dd3\u0dba\u0dcf\u0d9a\u0dcf \u0d85\u0dc1\u0dda \u0dcf\u0db8\u0dba\u0dcf\u0d9a\u0dcf\u0dc1\u0dba\u0dcf\u0d9a\u0ddd \u0dc3\u0dd2\u0dba\u0dcf\u0d9a\u0dbd\u0dd4\u0dc1\u0daf\u0dca\u200d\u0dcf\u0db8 \u0d9c\u0dd0\u0dcf \u0d85\u0db4\u0dd2 \u0d89\u0dad\u0db8 \u0d9a\u0da9\u0db6\u0db1\u0dca\u0dcf \u0ddb\u0dcf\u0ddb\u0db8. \u0d92 \u0dcf\u0db8\u0db4\u0dc1\u0dda \u0dcf\u0dcf\u0db4\u0dd4 \u0dca\u0d82\u0ddb\u0dca\u0dd9\u0dcf \u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf \u0dad\u0db1\u0dba\u0dd2 \u0d85\u0daf\u0dca\u200d\u0da7\u0dad\u0dca \u0db4\u0ddb\u0dad\u0dd2\u0dca \u0dc1\u0dca . \u0dc1\u0db6\u0db1 \u0d9a\u0dab\u0dca\u0dd4\u0ddb \u0dba\u0dcf\u0d9a\u0db6\u0db1 \u0dca\u0d82\u0ddb\u0dca\u0dd9\u0dcf\u0dba\u0dcf\u0d9a\u0dc2\u0dcf \u0dcf\u0dcf\u0dca \u0dcf \u0dca\u0db4\u0db8\u0dc1\u0db4\u0db8\u0dc1\u0dcf\u0db8\u0dad\u0dca\u0dad\u0dd4\u0db8\u0dcf \u0ddb\u0dcf\u0ddb\u0db8 \u0dcf\u0db6\u0db1, \u0d87\u0d9f\u0dbd\u0dd4\u0db6\u0db1 \u0dcf\u0dca\u0db1\u0db8\u0dca \u0dad\u0dba\u0dcf\u0d9a\u0da7 \u0d92 \u0dca\u0dc4\u0dcf \u0db4\u0dca\u0db8 \u0dc1\u0daf\u0dca\u200d\u0dca \u0dcf \u0dbb\u0dd3\u0dba\u0dcf\u0d9a\u0db8 \u0db1\u0db1 \u0dbb\u0dd3\u0dba\u0dcf\u0d9a\u0dcf\u0ddb\u0db8. \u0db4\u0dc3\u0dd4\u0dba \u0dba\u0dcf\u0d9a \u0ddb\u0dca\u0dc1\u0dca \u0d87\u0d9f\u0dbd\u0dd4\u0db6\u0db1 \u0dcf\u0db8\u0dca\u0db1\u0db8\u0dca \u0dad\u0dc1\u0dba\u0dcf\u0d9a\u0dca \u0db4\u0dd0\u0db6\u0dd4\u0dab\u0dd4 \u0d9a\u0daf\u0dca\u200d\u0db8\u0dba\u0dcf\u0d9a\u0db1 \u0dc1\u0da9\u0db8\u0db4\u0dca \u0dd2\u0dba\u0dd2\u0dba\u0dcf\u0d9a\u0dcf 4\u0dba\u0dd2. \u0dc1\u0db1\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dca \u0db4\u0db8\u0da7 \u0dc1\u0db1\u0ddb\u0dd0\u0db1\u0dd2 \u0d85\u0dba\u0dcf\u0d9a \u0ddb\u0dd0\u0dba\u0dcf\u0d9a\u0dc2\u0dcf \u0d89\u0daf\u0dd2\u0db4\u0dad\u0dca \u0dcf\u0dcf\u0dca \u0dcf\u0ddb\u0dad\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0ddb\u0dca \u0dbb\u0dd4\u0dc1\u0dab\u0dca\u0dad\u0dca, \u0d85\u0dc1\u0dda \u0dcf\u0db8\u0dba\u0dcf\u0d9a\u0dcf\u0dc1\u0dba\u0dcf\u0d9a\u0ddd \u0dcf\u0dcf\u0db4\u0dd4 \u0dc1\u0dda\u0ddb\u0dbd\u0dca \u0db1\u0dd2\u0dca\u0db8\u0dba\u0dd2. \u0d85\u0dad\u0dd3\u0dad\u0dba\u0dcf\u0d9a\u0da7 \u0dca\u0dd0\u0dab \u0dca\u0dd0\u0dab, \u0dc1\u0db6\u0db1 \u0d85\u0dba\u0dcf\u0d9a \u0ddb\u0dd0\u0dba\u0dcf\u0d9a \u0d89\u0daf\u0dd2\u0db4\u0dad\u0dca \u0dcf\u0dc5\u0dad\u0dca \u0dd4\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dca \u0db4\u0db8\u0da7 \u0d85\u0dba\u0dcf\u0d9a \u0ddb\u0dd0\u0dba\u0dcf\u0d9a \u0d89\u0daf\u0dd2\u0db4\u0dad\u0dca \u0dcf\u0dcf\u0dca \u0dcf \u0dc1\u0da9\u0db8\u0db4\u0dca \u0dd2\u0dba\u0dd2\u0dba\u0dcf\u0d9a\u0dcf 4\u0dc2\u0dcf \u0db4\u0dca\u0db8 \u0db4\u0dd0\u0dc1\u0dca\u0dca \u0dc1\u0dca \u0d85\u0dc1\u0dda \u0dcf\u0db8\u0dba\u0dcf\u0d9a\u0dcf\u0dc1\u0dba\u0dcf\u0d9a\u0ddd \u0dcf\u0dcf\u0db4\u0dd4 \u0dca\u0d82\u0ddb\u0dca\u0dd9\u0dcf\u0dba\u0dcf\u0d9a \u0db1\u0dd2\u0dca\u0db8\u0dba\u0dd2, \u0db8\u0dd6\u0db4\u0db8\u0dca\u0dcf\u0db8\u0dbb\u0dd6\u0daa \u0d89 \u0d9c\u0dbb\u0dd4 \u0db1\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0db1\u0dd2.\n\n\u0db1\u0dc4\u0ddb\u0dd0\u0dd2 \u0ddb\u0dba\u0db8\u0db4\u0db8\u0dcf\u0dba\u0dcf\u0d9a \u0d9c\u0dca \u0dcf. \u0d85\u0dc1\u0dda \u0dcf\u0db8\u0dba\u0dcf\u0d9a\u0dcf\u0dc1\u0dba\u0dcf\u0d9a\u0ddd 80 \u0daf\u0dca\u200d \u0dcf\u0dc1\u0dda \u0dad\u0db1\u0dba\u0dd2 \u0d91\u0db1 \u0dcf\u0db8\u0dca\u0dba\u0dcf\u0d9a\u0dcf\u0db8\u0dcf\u0dba\u0dcf\u0d9a \u0dcf\u0dc1\u0dc5\u0dda. \u0dc1\u0db1\u0da0\u0dca\u0da0\u0dd4\u0da0\u0dcf \u0dcf\u0dbd\u0dca \u0dba \u0dc4\u0dd2\u0dbd\u0dca\u0db4\u0db8\u0dad\u0dca \u0db4\u0d82\u0dcf\u0db8\u0ddb\u0da7 \u0d85\u0ddb \u0dba \u0db8\u0dbb\u0daf\u0dd4\u0dd2 \u0dca\u0db4\u0dc1\u0dba\u0dcf\u0d9a\u0dca \u0dad\u0ddb\u0db1\u0dad\u0dca \u0dc3\u0dd2\u0dba\u0dcf\u0d9a\u0dba\u0dcf\u0d9a\u0da7 50\u0dcf\u0da7 \u0ddb\u0dd0\u0dca\u0dba\u0dcf\u0d9a \u0d8b\u0dad\u0dca\u0db4\u0db8\u0daf\u0dca\u200d\u0dcf\u0dba\u0dcf\u0d9a \u0dcf\u0dcf\u0dca \u0dc1\u0dca \u0db1\u0dc4\u0ddb\u0dd0\u0dd2\u0dc1\u0dba\u0dcf\u0d9a\u0dca . \u0d91\u0dc4\u0dd2 \u0ddb\u0da7\u0dd2\u0dcf\u0db8\u0dcf\u0db1 \u0d9c\u0dab\u0dcf\u0dba\u0dcf\u0d9a \u0dcf\u0dc1\u0dc5\u0db8\u0dad\u0dca \u0dc1\u0da9\u0db8\u0db4\u0dca \u0dd2\u0dba\u0dd2\u0dba\u0dcf\u0d9a\u0dcf ]0\u0dcf\u0da7 \u0d9a\u0dca\u0dca \u0dcf \u0dc1\u0ddb\u0dba\u0dd2. \u0d92 \u0db1\u0dd2\u0dca\u0db8 \u0db1\u0db1 \u0dc4\u0dd2\u0dad\u0dcf \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0dcf\u0d9a\u0da7 \u0da2\u0dcf\u0dad\u0db8 \u0db8\u0dbb\u0db8\u0dd4\u0dc2\u0dcf\u0dad\u0dd2 \u0dc1\u0db4\u0dcf\u0db8\u0dd4\u0dc1\u0dab\u0dca \u0dcf\u0db8\u0dba\u0dcf\u0d9a\u0dcf\u0dba\u0dcf\u0d9a\u0db8 \u0ddb\u0dcf \u0da2\u0dcf\u0db8\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0db8 \u0d87\u0dad\u0dd4\u0db8\u0dcf\u0dc5\u0dd4 \u0db1\u0dca \u0dad\u0dca\u200d\u0dbb\u0dd3\u0ddb\u0dbb\u0dd4\u0dca \u0dad\u0dd4\u0db8\u0dcf\u0dc5 \u0d92 \u0d9a\u0dd4\u0dc4\u0dcf\u0dad\u0dca\u0ddb\u0dba\u0dcf\u0d9a \u0dcf\u0dd0\u0dad\u0dd2 \u0dc1\u0ddb\u0dca \u0dcf \u0d95\u0dcf\u0dd1. \u0d85\u0dca \u0dcf, \u0d92 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dca \u0dc1\u0dc4\u0db8\u0db3 \u0dc1\u0daf\u0dca\u200d\u0dba\u0dcf\u0d9a\u0dc2\u0dcf \u0dcf\u0dc5\u0db8 \u0dbb\u0dd3\u0dba\u0dcf\u0d9a\u0db4\u0db8 \u0dbb\u0dd3\u0dba\u0dcf\u0d9a\u0dca \u0dcf \u0db4\u0dd4\u0dc5\u0dd4\u0ddb\u0dca \u0dc1\u0ddb\u0dca \u0dcf \u0d95\u0dcf\u0dd1. \u0da2\u0dcf\u0dad\u0db8 \u0db8\u0dbb\u0db8\u0dd4\u0dc2\u0dcf\u0dad\u0dd2 \u0dc1\u0db4\u0dcf\u0db8\u0dd4\u0dab \u0daf\u0dd6\u0dc2\u0dab\u0dba\u0dcf\u0d9a\u0da7 \u0db8\u0dbb\u0dbb\u0dd4\u0dda\u0dd9\u0ddb \u0dca\u0da7\u0dca \u0dbb\u0dd3\u0db8\u0db1 \u0d9c\u0dd0\u0dcf \u0d85\u0db4\u0dd2 \u0dca\u0dca \u0dc1\u0dad\u0ddd\u0dc2\u0dba\u0dd2. \u0daf\u0dd6\u0dc2\u0dab\u0dba\u0dcf\u0d9a \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0db8\u0dad\u0dca \u0dd4\u0dbb\u0dd4\u0dca \u0da7\n\n951 952\n\n\u0db4\u0db8\u0dca\u0dd2\u0dc1\u0db6\u0db1\u0d