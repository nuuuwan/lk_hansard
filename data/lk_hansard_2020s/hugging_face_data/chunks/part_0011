    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0db1\u0dd2\u0d8b \u0dc1\u0dda \u0dc0\u0dd2\u0dc0\u0dcf\u0daf\u0dba \u0dd4\u0dc5\u0daf\u0dd3 \u0dc1\u0d9c\u0dcf\u0da9\u0dcf \u0d9a\u0dca\u0d9a\u0dba \u0dc3\u0dd2\u0daf\u0dd4 \u0dda\u0dc1\u0dc5\u0dca\u0d8b \u0da2\u0dcf\u0dad\u0dd2\u0dda \u0d86\u0dbb\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dcf\u0dc0\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dda\u0dad\u0dd2\u0dda\u0dcf\u0dc0. \u0dc1\u0dda \u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dc0 \u0dd4\u0dc5\u0daf\u0dd3 \u0d91\u0db8 \u0dda\u0dad\u0dd2\u0dda\u0dcf\u0dc0 \u0db4\u0dcf\u0dad\u0dcf\u0d89\u0dba\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0 \u0dda\u0dbb \u0d9c\u0dad\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dd2\u0dba\u0dda\u0da7 \u0dc1\u0d9c\u0db1 \u0dba\u0db1\u0dca\u0db1 \u0dc4\u0dd0\u0daf\u0dd4\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dc1\u0dda\u0dda\u0dd2. \u0dba\u0dda \u0d9a\u0dd2\u0dc3\u0dd2 \u0dc3\u0dd2\u0dda\u0db0\u0dd2\n\n\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0db1\u0dd2\u0d8b \u0dc1\u0dda \u0db4\u0dcf\u0d89\u0db1 \u0dc4\u0dc3\u0dca\u0dad\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0d91\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0dad\u0db8\u0dd2 \u0d92 \u0d85\u0daf\u0dcf\u0dc5 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dda\u0dcf\u0dbb\u0dd2\u0dda\u0dba\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0dda \u0dc0\u0dd4\u0dc1\u0da9\u0dd4\u0d9a. \u0dc0\u0dad\u0dca\u0db8\u0db1\u0dca \u0dc1\u0db4\u0dcf\u0dd2\u0dc3\u0dca\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dda\u0dcf \u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dda\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0d8b \u0dad\u0db8\u0db1\u0dca \u0dc1\u0db4\u0dcf\u0dd2\u0dc3\u0dca \u0dc1\u0dc3\u0dca\u0dc0\u0dba \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dc1\u0dda \u0db4\u0dcf\u0d89\u0db1 \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0dc0\u0dd3\u0db8\u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0dad\u0dcf\u0dbb\u0dc0 \u0d85\u0dad\u0dca\u0daf\u0dd0\u0d9a\u0dd3\u0dda \u0d89\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d85\u0daf \u0dad\u0db8\u0dd2 \u0d9a\u0dd2\u0dba\u0d89\u0dcf.\n\n\u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf\u0d8b \u0db8\u0dd3\u0da7 \u0dda\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba. \u0db4\u0dcf\u0dad\u0dcf\u0d89\u0dba \u0dad\u0db1\u0dd2\u0dda\u0dbb\u0db8 \u0db1\u0da9\u0dcf \u0dad\u0dca\u0dd4 \u0dda\u0dc1\u0dc5\u0dca \u0dc1\u0dda \u0db4\u0dcf\u0d89\u0db1 \u0db6\u0d89 \u0d85\u0db0\u0dd2\u0dda\u0dcf\u0dbb\u0dd2\u0dba\u0dd2. \u0dc1\u0dda.\u0d86\u0dbb\u0dca\u0dbd. \u0da2\u0dba\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dba\u0dcf\u0dc1 \u0dd2\u0db3\u0db1\u0dca \u0db4\u0dc4\u0dc5\u0da7 \u0dc1\u0d9c\u0db1 \u0db6\u0d89\u0db1\u0dca\u0db1\u0dc1\u0dda\u0ddd. \u0dc1\u0dda.\u0d86\u0dbb\u0dca\u0dbd. \u0da2\u0dba\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dba\u0dcf \u0dda\u0dcf\u0dc0\u0daf \u0db1\u0da9\u0dcf \u0dad\u0dca\u0dd4 \u0dda\u0dc1\u0dc5\u0dca? \"\u0dc1\u0d9c\u0ddd\u0db1\u0dc0\u0d89 \u0dc3\u0dd4\u0db1\u0dd2\u0dca .\" \u0dc4\u0dd2\u0dc1\u0dbb\u0dca\u0dbd \u0dc4\u0dd2\u0da7\u0dd4 \u0dc1\u0d9c\u0ddd\u0db1\u0dc0\u0d89 \u0dc3\u0dd4\u0db1\u0dd2\u0dca \u0dc0 \u0d91\u0dc5\u0dd2\u0dba\u0da7 \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0daf\u0dd2\u0dc0\u0dd2\u0db1\u0da7\u0db8 \u0dc3\u0dcf\u0db8 \u0dc0\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dbb\u0dd4 \u0dda\u0dbb\u0d89\u0dcf \u0d92 \u0db8\u0dd2\u0db1\u0dd2\u0dc4\u0dcf\u0db8 \u0d89\u0dc0\u0dcf \u0dc1\u200d\u0dbb\u0dca\u0dc2\u0dca\u0dc3\u0dcf\u0db0\u0dd2\u0dda\u0dbb\u0dab\u0dc1\u0d9a \u0dc0\u0dd2\u0db1\u0dd2 \u0dca\u0da0\u0dba\u0dda\u0dcf\u0dbb\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0d9c\u0dca \u0d9c\u0dd0\u0dc3\u0dca\u0dc1\u0dc3\u0dda\u0dc0\u0dcf. \u0d85\u0db1\u0dca\u0db1\u0d8b \u0d91\u0daf\u0dcf \u0db4\u0dcf\u0dad\u0dcf\u0d89\u0dba \u0db1\u0da9\u0dcf \u0dad\u0dca\u0dd4 \u0dda\u0dbb\u0dd4 \u0dc0\u0dd2\u0db0\u0dd2\u0dba. \u0d8a\u0da7 \u0db4\u0dc3\u0dca\u0dc1\u0dc3\u0dca \u0d86\u0dbb\u0dca\u0dbd. \u0dc1\u0dda\u0db8\u0daf\u0dcf\u0dc3 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dba\u0dcf\u0dc1 \u0dda\u0dcf\u0d89\u0dc1\u0d9a\u0daf\u0dd3 \u0dc1\u0dc0\u0da0\u0dca\u0da0 \u0dc1\u0dda \u0d85\u0db4\u0dd2 \u0daf\u0dd0\u0d9a\u0dca\u0d9a\u0dba\u0dda\u0dcf. \u0dbb\u0dd2\u0da0\u0da9\u0dca \u0daf \u0dc1\u0dc3\u0dcf\u0dd2\u0dc3\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \"\u0dc1\u0dda \u0dda\u0dc0\u0dd4\u0daf\u0d8b \u0dc1\u0db8\u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0dda\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca\" \u0d9a\u0dd2\u0dba\u0d89\u0dcf \u0db1\u0dcf\u0da7\u0dba\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0db8\u0dcf\u0dab\u0dba \u0dda\u0dc5\u0dcf\u0da7 \u0db4\u0dc3\u0dd4\u0dc0 \u0d94\u0dc4\u0dd4\u0dc0 \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0d89\u0dcf \u0dcf\u0dcf\u0dad\u0db1\u0dba \u0dda\u0dc5 \u0d86\u0dda\u0dcf\u0dbb\u0dba \u0d85\u0db4\u0dd2 \u0daf\u0dd0\u0d9a\u0dca\u0d9a\u0dba\u0dda\u0dcf. \u0d92 \u0dda\u0dcf\u0d89\u0dc1\u0d9a \u0d92\u0dc1\u0d9c\u0dcf\u0dca \u0d89\u0db1\u0dca \u0db4\u0dcf\u0dad\u0dcf\u0d89\u0dba \u0db1\u0da9\u0dcf \u0dad\u0dca\u0dd4 \u0dda\u0dc1\u0dc5\u0dca \u0d91\u0dc1\u0dc4\u0db8\u0dd2."
  },
