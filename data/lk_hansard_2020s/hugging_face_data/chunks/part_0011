    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7\u0d8b \u0dc4\u0dd4\u0daf\u0daf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0dc1\u0dc3\u0dca\u0dc0\u0dcf \u0daf\u0dd2\u0d9c\u0dd4 2\u0dd2. \u0db1\u0dcf\u0dc0\u0dd2\u0dda \u0dc4\u0dd4\u0daf\u0daf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0dc1\u0dc3\u0dca\u0dc0\u0dcf \u0daf\u0dd2\u0d9c\u0dd4 2\u0dd2. \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc4\u0dd4\u0daf\u0daf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0d91\u0dda \u0dc1\u0dc3\u0dca\u0dc0\u0dcf \u0daf\u0dd2\u0d9c\u0dd4\u0dc0\u0dd2. \u0d94\u0db6\u0dd4\u0db8\u0db1\u0dca\u0d89\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db8\u0da7\u0dad\u0dca \u0d91\u0dc1\u0dc4\u0db8 \u0dc1\u0daf\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0d89\u0dcf\u0daf? \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf \u0d94\u0d9a\u0dca\u0d9a\u0dba\u0dc1\u0dda\u0ddd\u0db8 \u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0da8\u0dcf \u0db6\u0dd4\u0dda\u0db0\u0dd2 \u0dc1\u0dc3\u0dca\u0dc0\u0dcf\u0d8b \u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0da8\u0dcf \u0dc4\u0dd4\u0daf\u0daf\u0dcf \u0dc0\u0dca\u0dad\u0dca\u0dad\u0dd3\u0db8\u0dba\u0db7\u0dcf\u0dc0\u0dc1\u0dba\u0db1\u0dca \u0d91\u0dc4\u0dcf\u0da7 \u0dc1\u0d9c\u0db1 \u0d9c\u0dd2\u0dba \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0dba\u0dad\u0dca\u0db1\u0dba \u0dc1\u0db8\u0dcf\u0dda\u0d9a\u0dca\u0d9a\u0dba\u0daf? \u0dc4\u0dd4\u0daf\u0daf\u0dcf\u0dc0 \u0dc3\u0dc4 \u0dc1\u0db4\u0dcf\u0dbd\u0dd3\u0dc3\u0dd2\u0dba \u0dc0\u0dca\u0dad\u0dca\u0dad\u0dd3\u0db8\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba\u0dda\u0da7 \u0dc1\u0d9c\u0db1 \u0d92\u0db8. \u0d92\u0dda \u0dad\u0db8\u0dd2 \u0da2\u0dcf\u0dad\u0dd2\u0dda \u0da2\u0db1 \u0db6\u0d89\u0dc1\u0dda\u0d9c \u0d86\u0da9\u0dd4\u0d9a\u0dca\u0dc1\u0dda \u0d85\u0dc1\u0dda\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dcf\u0dc0. \u0d92 \u0db8\u0da7 \u0db4\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0db4\u0dcf\u0dad\u0dd3 \u0daf? \u0db1\u0dd0\u0dc4\u0dd0\u0d8b \u0db8\u0da7 \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dd2\u0d8b \u0dbb\u0da2\u0dba\u0da7 \u0db4\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0db4\u0dcf\u0dad\u0dd3. \u0dc4\u0dd4\u0daf\u0daf\u0dcf \u0dc4\u0dd0\u0daf\u0dd4\u0dc1\u0dda \u0dc1\u0dda\u0dcf\u0dc1\u0dc4\u0dcf\u0db8\u0daf? \u0db6\u0dd4\u0dda\u0db0\u0dd2 \u0dc1\u0dc3\u0dca\u0dc0\u0dcf \u0dc4\u0dd0\u0daf\u0dd4\u0dc1\u0dda \u0dc1\u0dda\u0dcf\u0dc1\u0dc4\u0dcf\u0db8\u0daf? \u0d91\u0dba\u0dcf\u0da7 \u0db4\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0db4\u0dcf\u0dad\u0dd3\u0dc0. \u0dd4\u0dda\u0d9c\u0d89\u0dba\u0db1\u0dca\u0da7 \u0db4\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0db4\u0dcf\u0dad\u0dd3\u0dc0. \u0dd4\u0dda\u0d9c\u0d89\u0dba\u0db1\u0dca\u0da7 \u0db4\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0db4\u0dcf\u0dad\u0dd3 \u0dc4\u0dd4\u0daf\u0daf\u0dcf\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dcf \u0d9a\u0dca\u0d9a\u0dba \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf\u0daf? \u0dd4\u0dda\u0d9c\u0d89\u0dba\u0db1\u0dca\u0da7 \u0db4\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0db4\u0dcf\u0dad\u0dd3\u0d8b \u0dc1\u0dda \u0db4\u0dcf\u0d89\u0dda\u0dba\u0dcf\u0da7 \u0db4\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0db4\u0dcf\u0dad\u0dd3 \u0dc4\u0dd4\u0daf\u0daf\u0dcf\u0dc0\u0d9a\u0dca\u0d9a\u0dba \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dd2 \u0d85\u0db4 \u0dc4\u0daf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0dbb\u0dcf\u0da2\u0dba\u0dba\u0da7 \u0db4\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0db4\u0dcf\u0dad\u0dd3 \u0dc4\u0dd4\u0daf\u0daf\u0dcf\u0dc0\u0d9a\u0dca\u0d9a\u0dba. \u0dc0\u0dca\u0dad\u0dca\u0dad\u0dd3\u0db8\u0dba \u0dc4\u0dd4\u0daf\u0daf\u0dcf\u0dc0\u0d9a\u0dca\u0d9a\u0dba \u0d85\u0db4\u0dd2 \u0dc4\u0daf\u0db1\u0dc0\u0dcf.\n\n\u0d85\u0db4\u0dd2 \u0dc1\u0daf\u0dc3\u0dd0\u0dda\u0db6\u0dbb\u0dca\u0dbd \u0db8\u0dcf\u0dc3\u0dc1\u0d9a 30 \u0dc0\u0dcf\u0dc1 \u0dad\u0db8\u0dd2 \u0dc1\u0dda \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0 \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dca. \u0d85\u0db4\u0dd2 \u0da2\u0dba\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dab\u0dba \u0dda\u0dbb\u0d89\u0dcf \u0db8\u0dcf\u0dc3 4\u0dda \u0dc0\u0dcf\u0dc1 \u0dda\u0dcf\u0d89\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0d9c\u0dad\u0dca\u0dad\u0dcf \u0dc1\u0dda \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0 \u0d9c\u0db1\u0dca\u0db1. \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0d85\u0dc0\u0dc1\u0db6\u0ddd\u0db0 \u0dda\u0dbb\u0dc1\u0d9c\u0db1\u0d8b \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0d85\u0db1\u0dd4\u0d9c\u0dad \u0dc1\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0dad\u0db8\u0dd2 \u0d85\u0db4\u0dd2 \u0d92 \u0d85\u0dba \u0dd2\u0dc0\u0dad\u0dca \u0dda\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dba\u0d89\u0dcf.\n\n361 362\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dd4\u0dc0"
  },
