0dd0\u0dc5\u0dd0\u0d9a\u0dca\u0dc0\u0dc0\u0dd3\u0db8\n\n\uf0b7 \u0db4\u0dd4\u0dbb \u0dbb\u0dd0\u0d9a\u0dc0\u0dbb\u0dab\u0dba\n\n\u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dcf\u0dbb \u0dc4\u0dcf \u0db4\u0dd4\u0db1\u0dbb\u0dd4\u0dad\u0dca\u0dae\u0dcf\u0db4\u0db1 \u0dc0\u0dd0\u0da9\u0dcf\u0dc3\u0da7\u0dc4\u0db1\u0dca\u0dc0\u0dbd \u0d85\u0db1\u0dca\u0dad\u0dbb\u0dca\u0d9c\u0dad\u0dba \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0da7 \u0db1\u0dd0\u0d82\u0dc0\u0dd3\u0dc1\u0db8\u0dca\u0daf\u0dd3 \u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dc1\u0dda \u0dc3\u0dc4\u0dcf\u0dba \u0dc1\u0db8\u0db1\u0dca\u0db8 \u0dc3\u0dd2\u0dbb\u0d9a\u0dbb\u0dd4 \u0dd4\u0dbb\u0db6\u0dc3\u0dcf\u0db0\u0d9a \u0dc3\u0d82\u0d9c\u0db8\u0dba \u0dda\u0db4 \u0d9a\u0db8\u0dd2\u0dd4\u0dc0, \u0dbb\u0dcf\u0da2\u0dba \u0dc4\u0dcf \u0dbb\u0dcf\u0da2\u0dba \u0dc1\u0db1\u0dcf\u0dc0\u0db1 \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1 \u0dc3\u0dc4 \u0db4\u0dd4\u0dab\u0dba \u0d86\u0dba\u0dad\u0db1\u0dc0\u0dbd \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca\u0dd9\u0dcf\u0dba\u0d9a\u0dad\u0dca\u0dc0\u0dc1\u0dba\u0db1\u0dca \u0dd4\u0dad\u0dad\u0dd4\u0dc0 \u0db4\u0dd4\u0db1\u0dbb\u0dd4\u0dad\u0dca\u0dae\u0dcf\u0db4\u0db1 \u0dc0\u0dd0\u0da9\u0dcf\u0dc3\u0da7\u0dc4\u0db1\u0dca \u0dbb\u0dd0\u0dc3\u0d9a\u0dca\u0dc0 \u0d91\u0d9a\u0dd3 \u0d86\u0dba\u0dad\u0db1 \u0dad\u0dd4\u0dc5 \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0da7 \u0db1\u0d82\u0dc0\u0db1\u0dd4 \u0dbd\u0db6\u0dba\u0dd2.\n\n2. \u0db1\u0db4\u0db8\u0ddd\u0daf\u0dd2\u0dc2\u0db4\u0da8 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0db1\u0d9a\u0dcf\u0dbb \u0db8\u0db0\u0dcf\u0dba\u0dca\u0db4\u0dae\u0dcf\u0db1 \u0dc0\u0dba\u0dcf\u0db4\u0dca\u0dd2\u0db1\u0dba\n\n2007 \u0d85\u0d82\u0d9a 54 \u0dd9\u0dbb\u0db1 \u0d96\u0dc2\u0db0\u0dc0\u0dbd\u0da7 \u0d87\u0dda\u0db6\u0dd0\u0dc4\u0dd2\u0da7 \u0dad\u0dd0\u0db1\u0dd0\u0dad\u0dca\u0dad\u0db1\u0dca (\u0db4\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dcf\u0dbb \u0dc4\u0dcf \u0db4\u0dd4\u0db1\u0dbb\u0dd4\u0dad\u0dca\u0dae\u0dcf\u0db4\u0db1\u0dba) \u0db4\u0dd2\u0dd2\u0db6\u0db6\u0db3 \u0db4\u0db1\u0dad\u0da7 \u0d86\u0db1\u0dd4\u0dc2\u0d82\u0d9c\u0dd2\u0d9a\u0dc0 2010 \u0dc0\u0dbb\u0dca\u0dc2\u0dc1 \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0dd9 \u0d85\u0d82\u0d9a 1653/19 \u0dd9\u0dbb\u0db1 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0db8\u0dad\u0dca\u0dbb\u0dc0\u0dba \u0db4\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dcf\u0dbb \u0dc4\u0dcf \u0db4\u0dd4\u0db1\u0dbb\u0dd4\u0dad\u0dca\u0dae\u0dcf\u0db4\u0db1 \u0db8\u0db0\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0dc1\u0dbd\u0dc3 \u0db1\u0db8\u0dca \u0d9a\u0dbb \u0d87\u0dd2 \u0d85\u0db1\u0dca\u0dad\u0dbb\u0dcf\u0dba\u0d9a\u0dbb \u0d96\u0dc2\u0db0 \u0db4\u0dcf\u0dbd\u0d9a \u0da2\u0dcf\u0dd2\u0d9a \u0db8\u0dab\u0dca\u0da9\u0da9\u0dcf\u0dbd\u0dc1 \u0dad\u0dcf\u0d9a\u0dca\u0dc0\u0dc2\u0dab\u0dd2\u0d9a \u0dda\u0db4\u0dc1\u0dd9\u0dc3\u0dca \u0dc4\u0dcf \u0db8\u0dd9\u0dc1\u0db4\u0db1\u0dca\u0dc0\u0dd3\u0db8\u0da7 \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \u0dc1\u0db8\u0db8 \u0dc0\u0dd0\u0da9\u0dcf\u0dc3\u0da7\u0dc4\u0db1 \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0db4\u0dc4\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc1\u0dda.\n\n01) \u0db4\u0dbd\u0dca\u0dc1\u0dbd\u0dca\u0d9a\u0dd0\u0dc1\u0dbd\u0dca \u0d91\u0dd2\u0db6\u0db8\u0dc4\u0db1\u0dca \u0dc3\u0dd2\u0dbb \u0d9a\u0db3\u0dc0\u0dd4\u0dbb\n\n02) \u0dc0\u0da7\u0dbb\u0dd0\u0d9a \u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\n\n03) \u0dad\u0dbd\u0dca\u0dc1\u0dd9\u0db1 \u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\n\n04) \u0dc0\u0dd3\u0dbb\u0dc0\u0dd2\u0dbd \u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\n\n05) \u0d85\u0db1\u0dd4\u0dbb\u0dcf\u0db0\u0db4\u0dd4\u0dbb \u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\n\n06) \u0db4\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0dc1\u0dc3\u0dca\u0db1 \u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\n\n07) \u0d9a\u0db1\u0dca\u0dc1\u0dd9\u0dc0\u0dad\u0dca\u0dad \u0dc0\u0dd0\u0da9\u0dcf \u0d9a\u0db3\u0dc0\u0dd4\u0dbb"
