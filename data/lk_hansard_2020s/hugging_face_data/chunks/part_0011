    "chunk_text": "01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1.- \u0dc1\u0dcf\u0dc1\u0dc4\u0dba\u0dd4\u0db8\u0dca \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 - \u0db4\u0dd4\u0db1\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dad\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf,\n\n\u0dbb\u0dd4. 26,000,000\n\n\u0db0235 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc1\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1, \u0db4\u0dd4\u0db1\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dad\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf \u0dc3 \u0dc4\u0dcf \u0dbb\u0dd4. 26,000,000\u0d9a\u0dcf \u0db8\u0dd4\u0daf\u0dbd \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dad\u0dca \u0d9a\u0dcf\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0db0 \u0dba\u0db1 \u0dca\u200d\u0dbb \u0dca\u0db1\u0dba \u0dc0\u0dd2\u0dcf\u0dc3\u0db1 \u0dbd\u0daf\u0dd2\u0dca \u0dc3\u0db7\u0dcf \u0dc3\u0db8\u0dca\u0dcf\u0dad \u0dc0\u0dd2\u0dba.\n\n01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1.- \u0dc1\u0dcf\u0dc1\u0dc4\u0dba\u0dd4\u0db8\u0dca \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 - \u0db8\u0dd6\u0dbd\u0dca\u200d\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf,\n\n\u0dbb\u0dd4. 2,000,000\n\n\u0db0235 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc1\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1, \u0db8\u0dd6\u0dbd\u0dca\u200d\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf \u0dc3 \u0dc4\u0dcf \u0dbb\u0dd4. 2,000,000\u0d9a\u0dcf \u0db8\u0dd4\u0daf\u0dbd \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dad\u0dca \u0d9a\u0dcf\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0db0 \u0dba\u0db1 \u0dca\u200d\u0dbb \u0dca\u0db1\u0dba \u0dc0\u0dd2\u0dcf\u0dc3\u0db1 \u0dbd\u0daf\u0dd2\u0dca \u0dc3\u0db7\u0dcf \u0dc3\u0db8\u0dca\u0dcf\u0dad \u0dc0\u0dd2\u0dba.\n\n235 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc1\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1, \u0db8\u0dd6\u0dbd\u0dca\u200d\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1\u0dc1\u0dba\u0dc4\u0dd2 \u0dc1\u0d9a\u0dcf\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dba\u0dd2 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0d9c \u0d9a\u0dcf\u0dbb\u0db1 \u0dbd\u0daf\u0dd3.\n\n567 568\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd4\u0db8\u0dc0\n\n236 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dba.- \u0dbb\u0dcf\u0da2\u0dba \u0db7\u0dcf\u0dc2\u0dcf \u0dc3\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc3\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1.- \u0dc1\u0dcf\u0dc1\u0dc4\u0dba\u0dd4\u0db8\u0dca \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 - \u0db4\u0dd4\u0db1\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dad\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf,\n\n\u0dbb\u0dd4. 211,000,000\n\n\u0db0236 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc1\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1, \u0db4\u0dd4\u0db1\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dad\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf \u0dc3 \u0dc4\u0dcf \u0dbb\u0dd4. 211,000,000\u0d9a\u0dcf \u0db8\u0dd4\u0daf\u0dbd \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dad\u0dca \u0d9a\u0dcf\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0db0 \u0dba\u0db1 \u0dca\u200d\u0dbb \u0dca\u0db1\u0dba \u0dc0\u0dd2\u0dcf\u0dc3\u0db1 \u0dbd\u0daf\u0dd2\u0dca \u0dc3\u0db7\u0dcf \u0dc3\u0db8\u0dca\u0dcf\u0dad \u0dc0\u0dd2\u0dba.\n\n236 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc1\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1, \u0db4\u0dd4\u0db1\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dad\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1\u0dc1\u0dba\u0dc4\u0dd2 \u0dc1\u0d9a\u0dcf\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dba\u0dd2 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0d9c \u0d9a\u0dcf\u0dbb\u0db1 \u0dbd\u0daf\u0dd3.\n\n01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1.- \u0dc1\u0dcf\u0dc1\u0dc4\u0dba\u0dd4\u0db8\u0dca \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 - \u0db8\u0dd6\u0dbd\u0dca\u200d\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf,\n\n\u0dbb\u0dd4. 13,000,000\n\n\u0db0236 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc1\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1, \u0db8\u0dd6\u0dbd\u0dca\u200d\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf \u0dc3 \u0dc4\u0dcf \u0dbb\u0dd4. 13,000,000\u0d9a\u0dcf \u0db8\u0dd4\u0daf\u0dbd \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dad\u0dca \u0d9a\u0dcf\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0db0 \u0dba\u0db1 \u0dca\u200d\u0dbb \u0dca\u0db1\u0dba \u0dc0\u0dd2\u0dcf\u0dc3\u0db1 \u0dbd\u0daf\u0dd2\u0dca \u0dc3\u0db7\u0dcf \u0dc3\u0db8\u0dca\u0dcf\u0dad \u0dc0\u0dd2\u0dba.\n\n236 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc1\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1, \u0db8\u0dd6\u0dbd\u0dca\u200d\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1\u0dc1\u0dba\u0dc4\u0dd2 \u0dc1\u0d9a\u0dcf\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dba\u0dd2 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0d9c \u0d9a\u0dcf\u0dbb\u0db1 \u0dbd\u0daf\u0dd3.\n\n326 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dba.- \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf \u0db4\u0dcf\u0daf\u0d9a \u0dc0\u0dd2\u0dc3\u0dc1\u0dca\u0ddd\u0db0\u0db1 \u0dc3\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc3\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n, 01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1.- \u0dc1\u0dcf\u0dc1\u0dc4\u0dba\u0dd4\u0db8\u0dca \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 - \u0db4\u0dd4\u0db1\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dad\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf,\n\n\u0dbb\u0dd4. 743,000,000\n\n\u0db0326 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc1\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1, \u0db4\u0dd4\u0db1\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dad\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf \u0dc3 \u0dc4\u0dcf \u0dbb\u0dd4. 743,000,000\u0d9a\u0dcf \u0db8\u0dd4\u0daf\u0dbd \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dad\u0dca \u0d9a\u0dcf\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0db0 \u0dba\u0db1 \u0dca\u200d\u0dbb \u0dca\u0db1\u0dba \u0dc0\u0dd2\u0dcf\u0dc3\u0db1 \u0dbd\u0daf\u0dd2\u0dca \u0dc3\u0db7\u0dcf \u0dc3\u0db8\u0dca\u0dcf\u0dad \u0dc0\u0dd2\u0dba.\n\n326 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc1\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1, \u0db4\u0dd4\u0db1\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dad\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1\u0dc1\u0dba\u0dc4\u0dd2 \u0dc1\u0d9a\u0dcf\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dba\u0dd2 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0d9c \u0d9a\u0dcf\u0dbb\u0db1 \u0dbd\u0daf\u0dd3.\n\n01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1.- \u0dc1\u0dcf\u0dc1\u0dc4\u0dba\u0dd4\u0db8\u0dca \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 - \u0db8\u0dd6\u0dbd\u0dca\u200d\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf,\n\n\u0dbb\u0dd4. 24,000,000\n\n\u0db0326 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc1\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1, \u0db8\u0dd6\u0dbd\u0dca\u200d\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0dcf \u0dc3 \u0dc4\u0dcf \u0dbb\u0dd4. 24,000,000\u0d9a\u0dcf \u0db8\u0dd4\u0daf\u0dbd \u0d8b\u0db4\u0dc1\u0dbd\u0dca\u0d9b\u0dca\u200d\u0db1\u0dba\u0da7 \u0d87\u0dad\u0dd4\