u0d89\u0db0\u0db1 \u0dc0\u0dd2\u0dba\u0daf\u0db8 \u0dc3\u0db4\u0dc1\u0dca \u0d9b\u0db1\u0dc1\u0dba\u0dc4\u0dd2 \u0dc1\u0dda\u0dcf\u0da7\u0dc3\u0d9a\u0dca\u0d9a\u0dba \u0dc4\u0dd0\u0dc0\u0dbd\u0dba\u0da7 \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dad\u0dd4\u0dba\u0dd2 \u0db1\u0dd2\u0dc1\u0dba\u0ddd\u0d9c \u0dda\u0dbb\u0db1 \u0d89\u0daf\u0dd3.\n\n\u0ba4\u0b95\u0bb2\u0baa\u0bcd\u0baa\u0bc1 320.- \u0b9a\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0baa\u0bc6\u0bbe\u0ba4\u0bc1\u0b95\u0bc6\u0bbe\u0baa\u0bcd\u0baa\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd\n\n\u0bc6\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01.- \u0ba4\u0b9a\u0baf\u0bb2\u0bcd\u0bae\u0bc1\u0b95\u0bb1\u0b9a\u0bcd \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd - \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd\n\n\u0ba4\u0b9a\u0bb2\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 22,273,000,000\n\n\u201c\u0ba4\u0b95\u0bb2\u0baa\u0bcd\u0baa\u0bc1 320, \u0bc6\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 22,273,000,000 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0b95\u0ba3\u0baf\u0bbf\u0bb1\u0bcd \u0b9a\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0b9f\u0bc1\u0bae\u0bc6\u0bbe\u0b95\u201d \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0b95\u0bb2\u0baa\u0bcd\u0baa\u0bc1 320, \u0bc6\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0b95\u0ba3\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0b95\u0bb3\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0bc6\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01.- \u0ba4\u0b9a\u0baf\u0bb2\u0bcd\u0bae\u0bc1\u0b95\u0bb1\u0b9a\u0bcd \u0ba4\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0bc6\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd - \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd\n\n\u0ba4\u0b9a\u0bb2\u0bb5\u0bc1, \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 157,000,000\n\n\u201c\u0ba4\u0b95\u0bb2\u0baa\u0bcd\u0baa\u0bc1 320, \u0bc6\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 157,000,000 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0b95\u0ba3\u0baf\u0bbf\u0bb1\u0bcd \u0b9a\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bc6\u0bbe\u0b95\u201d \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0b95\u0bb2\u0baa\u0bcd\u0baa\u0bc1 320, \u0bc6\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0b95\u0ba3\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0b95\u0bb3\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\nHEAD 320. - DEPARTMENT OF CIVIL SECURITY Programme 01. - Operational Activities - Recurrent Expenditure,\n\nRs. 22,273,000,000\n\nQuestion, \"That the sum of Rs. 22,273,000,000, for Head 320, Programme 01, Recurrent Expenditure, be inserted in the Schedule\" put and agreed to.\n\nHead 320, Programme 01, Recurrent Expenditure, ordered to stand part of the Schedule.\n\nProgramme 01.- Operational Activities - Capital Expenditure,\n\nRs. 157,000,000\n\nQuestion, \"That the sum of Rs. 157,000,000, for Head 320, Programme 01, Capital Expenditure, be inserted in the Schedule\" put and agreed to.\n\nHead 320, Programme 01, Capital Expenditure, ordered to stand part of the Schedule."
