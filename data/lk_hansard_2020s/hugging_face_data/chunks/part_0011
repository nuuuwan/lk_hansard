    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7 \u0dc1\u0db1\u0dad\u0dd0\u0dcf\u0daf \u0dcf\u0dae\u0db8 \u0dcf\u0dc5\u0db8, IMF \u0d91\u0dcf \u0d9c\u0dd0\u0dcf. \u0dd4\u0dda, \u0db8\u0dd3\u0da7 \u0dcf\u0dd2\u0dca \u0d85\u0db4\u0dd2 IMF \u0d91\u0dcf\u0da7 ] \u0ddb\u0dad\u0db8\u0ddb\u0dc2\u0dcf \u0dba \u0dc4\u0dd2\u0dca \u0dad\u0dd2\u0dc1\u0dca\u0dcf\u0ddb\u0db8. \u0dc4\u0dd0\u0dca\u0dd0\u0dba\u0dd2 \u0dc1\u0d9c\u0db8\u0da9 \u0dba \u0dc4\u0dd2\u0dbd\u0dca\u0db4\u0db8 \u0dcf\u0db6\u0db1 \u0dcf\u0dd0\u0dc4\u0dd0. \u0d85\u0db4\u0dd2 IMF \u0d91\u0dcf\u0da7 \u0dba \u0dba\u0dcf\u0d9a\u0db8 \u0dc1\u0dcf\u0db8\u0dc1\u0ddb\u0dba\u0dd2, \u0d85\u0db4\u0dd2 \u0d9a\u0dab\u0dca\u0dd4\u0ddb \u0d9c\u0dca \u0dcf\u0dc1\u0dcf\u0db8\u0da7 IMF \u0d91\u0dcf \u0d87\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0dc5\u0dda \u0d85\u0db4\u0dd2 \u0dc4\u0dd2\u0dcf \u0dc1\u0ddb\u0db4\u0db8 \u0dc4\u0dd2\u0da7\u0dd2\u0dc1\u0dda. \u0d92 \u0dad\u0dad\u0dca\u0dad\u0dca\u0ddb\u0dba\u0dcf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0dc5 -\u0dc1\u0db6\u0db1 \u0db4\u0dd2\u0dca\u0dcf\u0dba\u0dcf\u0d9a \u0d87\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0dc5\u0dda- \u0dad\u0db1\u0dba\u0dd2 \u0d85\u0db4\u0da7 \u0daf\u0dca\u200d\u0dd0\u0dca \u0d89\u0daf\u0dd2\u0dba\u0dcf\u0d9a\u0da7 \u0dba\u0dcf\u0d9a\u0dca \u0dcf \u0dc3\u0dd2\u0dda\u0dd9 \u0dc1\u0ddb\u0db4\u0db8 \u0dad\u0dd2\u0dc1\u0dca\u0dca \u0dc1\u0dca . \u0d87\u0dba\u0dd2, \u0d85\u0db4\u0da7 IMF \u0d91\u0dcf\u0da7 \u0dba\u0dcf\u0d9a\u0dca \u0dcf \u0dbb\u0dd4\u0dc1\u0dab\u0dca? \u0d87\u0dba\u0dd2 \u0d85\u0db4\u0da7 \u0d91\u0dad\u0dd0\u0dcf\u0da7 \u0dba\u0dcf\u0d9a\u0dca \u0dcf \u0dbb\u0dd4\u0dc1\u0dab\u0dca? \u0dc1\u0db6\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dda\u0dcf\u0dba\u0dcf\u0d9a\u0da7 \u0d85\u0db4\u0dd2 \u0d8b\u0dad\u0dca\u0dad\u0dcf \u0dc1\u0dc4\u0db8\u0dba\u0dcf\u0d9a\u0dca \u0dcf \u0d95\u0dcf\u0dd1.\n\n2022 \u0d85\u0dc1\u0dda\u0dbd\u0dca ]2\u0ddb\u0dd0\u0db1\u0dd2 \u0daf\u0dca\u200d\u0db8 \u0da2\u0db8\u0dad\u0dba\u0dca \u0dad\u0dcf\u0dba\u0dcf\u0d9a\u0da7 \u0db1\u0dd2\u0dc1\u0dda\u0daf\u0dca\u200d\u0dcf\u0dba\u0dcf\u0d9a \u0dcf\u0dcf\u0dcf\u0ddb\u0db8, \u0d85\u0dc1\u0dda \u0dcf\u0da7 \u0dca\u0d82\u0dc1\u0dcf\u0db8\u0dc1\u0db4\u0db8\u0dad\u0dca \u0dcf\u0da7\u0dc2\u0dcf \u0db8\u0dbb\u0db0\u0dd2\u0dba\u0dcf\u0d9a\u0da7. \u0d85\u0dc1\u0dda \u0dcf\u0da7 \u0dca\u0d82\u0dc1\u0dcf\u0db8\u0dc1\u0db4\u0db8\u0dad\u0dca \u0dcf\u0da7\u0dc2\u0dcf \u0db8\u0dbb\u0db0\u0dd2\u0dba\u0dcf\u0d9a\u0da7 \u0db1\u0dd2\u0dc1\u0dda\u0daf\u0dca\u200d\u0dcf\u0dba\u0dcf\u0d9a \u0dcf\u0dcf\u0dcf \u0dad\u0dd0\u0dcf\u0da7 \u0dcf\u0da7 \u0db4\u0dad\u0dca \u0dcf\u0dc1\u0dc5\u0dda \u0dcf\u0dbb\u0dd4\u0daf\u0dca\u200d? \u0d85\u0db4\u0dd2\u0daf\u0dca\u200d? \u0d92 \u0dad\u0dad\u0dca\u0dad\u0dca\u0ddb\u0dba\u0dcf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0dc5 \u0dad\u0db1\u0dba\u0dd2 \u0d85\u0daf\u0dca\u200d \u0d85\u0db4\u0da7 \u0dc1\u0db6\u0db1 \u0dc4\u0dd0\u0db1 \u0dc1\u0daf\u0dca\u200d\u0dba\u0dcf\u0d9a\u0dcf\u0da7\u0db1 \u0db8\u0dd4\u0dc4\u0dd4\u0dab \u0dc1\u0daf\u0dca\u200d\u0dca \u0dcf \u0dc3\u0dd2\u0dda\u0dd9 \u0dc1\u0ddb\u0db4\u0db8 \u0dad\u0dd2\u0dc1\u0dca\u0dca \u0dc1\u0dca . \u0d92 \u0db8\u0dbb\u0dad\u0dcf\u0dc2\u0dcf \u0dc1\u0dcf\u0db8\u0dc1\u0ddb\u0dba\u0dd2. \u0dc1\u0db6\u0db1\u0dcf \u0dc1\u0dc1\u0dca\u200d\u0dbb\u0dda\u0dc2\u0dda\u0dc3\u0db8\u0db0\u0dd2\u0dcf\u0dcf\u0dab\u0dc1\u0dda\u0daf\u0dd3\u0dad\u0dca \u0dca\u0db8\u0dcf\u0da0\u0dca\u0da0\u0dd4\u0da1\u0db8\u0ddb\u0da7 \u0dcf\u0db8\u0da2\u0dcf \u0dbb\u0dd4\u0dab\u0db8. \u0d85\u0dc1\u0dda \u0dcf\u0dc1\u0da7\u0dca\u0da7 \u0d9a\u0dca\u0dd2\u0dcf\u0dba\u0dcf\u0d9a \u0dca\u0d82\u0dc1\u0dcf\u0db8\u0dc1\u0db4\u0db8\u0dad\u0dca \u0dbb\u0dd3\u0db8\u0db1\u0da7 \u0d85\u0daf\u0dca\u200d\u0db8\u0dc5\u0ddb \u0dc1\u0dc1\u0dca\u200d\u0dbb\u0dda\u0dc2\u0dda\u0dc3\u0db8\u0db0\u0dd2\u0dcf\u0dcf\u0dab\u0dc1\u0dba\u0dcf\u0d9a\u0dca \u0db1\u0dd2\u0dca\u0dc1\u0dda \u0dba\u0dcf\u0d9a\u0dc2\u0dcf \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0dcf\u0dc5\u0db8. \u0d92 \u0db1\u0dd2\u0dca\u0dc1\u0dda \u0dba\u0dcf\u0d9a \u0d87\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0dc5\u0dda \u0dcf\u0db8\u0da2\u0db4\u0dc2\u0dcf\u0dc2\u0ddb\u0dbb\u0dd4\u0dca \u0dbb\u0dd3\u0dc4\u0dd2\u0db4\u0dc1\u0daf\u0dca\u200d\u0dc1\u0dcf\u0d9a\u0dd4\u0dc1 \u0db1 \u0dcf\u0db6\u0db1 \u0dbb\u0dd3\u0dba\u0dcf\u0d9a\u0dd0\u0dc1\u0ddb\u0dcf\u0ddb\u0db8.\n\n\u0d92\u0dc1\u0dc2\u0dcf \u0dad\u0ddb \u0dad\u0ddb \u0d85\u0dba\u0dcf\u0d9a\u0dc1 \u0dcf\u0db6\u0db1 \u0dbb\u0dd3\u0dba\u0dcf\u0d9a\u0dd0\u0dc1\u0ddb\u0dcf\u0ddb\u0db8. \u0d89\u0dad\u0dd2\u0dca , \u0dc1\u0db1\u0dc1\u0dad\u0dc2\u0dcf \u0dcf\u0da7 \u0db4\u0db8\u0db4\u0dcf\u0dba\u0dcf\u0d9a \u0dcf\u0dcf\u0db4\u0dd4 \u0dc3\u0dd2\u0dba\u0dcf\u0d9a\u0dbd\u0dd4\u0dc1\u0daf\u0dca\u200d\u0dcf\u0db8\u0db1 \u0d85\u0dd4 \u0ddb\u0dd0\u0dca \u0ddb \u0dc1\u0dba\u0dcf\u0d9a\u0dca \u0d91\u0dcf\u0dad\u0dd4\u0db8\u0dcf\u0dc1\u0ddb\u0db4\u0db8 \u0dad\u0db1\u0dba\u0dd2 \u0d85\u0dc1\u0dda \u0dcf\u0da7 \u0dca\u0d82\u0dc1\u0dcf\u0db8\u0dc1\u0db4\u0db8\u0dad\u0dca\u0dcf\u0db8\u0ddb\u0dba\u0dcf\u0d9a\u0da7 \u0db4\u0dad\u0dca \u0dc1\u0dcf\u0dbb\u0dd4\u0dc1\u0dda. \u0d91\u0dc1\u0dc4\u0db1 \u0dcf\u0db6\u0db1, \u0d92 \u0dca\u0d82\u0dc1\u0dcf\u0db8\u0dc1\u0db4\u0db8\u0dad\u0dca\u0dcf\u0db8\u0ddb\u0dba\u0dcf\u0d9a\u0da7 \u0db4\u0dad\u0dca \u0dbb\u0dd3\u0db8\u0db1\u0da7 \u0d85\u0daf\u0dca\u200d\u0db8\u0dc5\u0ddb \u0db8\u0dbb\u0db4\u0dc2\u0dcf\u0dc2\u0dc1\u0dda \u0dc3\u0dd2\u0da7\u0dd2\u0dcf \u0dd4\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dca \u0db4\u0db8 \u0db8\u0dd3\u0da7 \u0dc1\u0db4\u0dcf \u0d89\u0daf\u0dd2\u0db4\u0dad\u0dca \u0dcf\u0dcf\u0db4\u0dd4 \u0d85\u0dba\u0dcf\u0d9a \u0ddb\u0dd0\u0dba\u0dcf\u0d9a \u0dc3\u0dd2\u0dba\u0dcf\u0d9a\u0dbd\u0dca\u0db4\u0da7 \u0dc1\u0dcf\u0db8\u0da0\u0dca\u0da0\u0dd4\u0da0\u0dcf \u0daf\u0dca\u200d\u0db8\u0dba\u0dcf\u0d9a\u0dcf \u0dbb\u0dd4\u0dab\u0db8 \u0daf\u0dca\u200d? \u0dd4\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dca \u0db4\u0db8 \u0d89\u0daf\u0dd2\u0db4\u0dad\u0dca \u0dcf\u0dcf\u0db4\u0dd4 \u0d85\u0dba\u0dcf\u0d9a \u0ddb\u0dd0\u0dba\u0dcf\u0d9a \u0dc3\u0dd2\u0dba\u0dcf\u0d9a\u0dbd\u0dca\u0dc1\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db5\u0db4\u0dba\u0dcf\u0d9a\u0dc2\u0dcf \u0db8\u0dbb\u0db0\u0dd2\u0dba\u0dcf\u0d9a\u0da7 \u0dad\u0db1\u0dba\u0dd2 \u0d85\u0dc1\u0dda \u0dcf\u0da7 \u0dca\u0d82\u0dc1\u0dcf\u0db8\u0dc1\u0db4\u0db8\u0dad\u0dca \u0dbb\u0dd4\u0dc1\u0dab\u0dca. \u0dd4\u0dca\u0dad\u0dd4\u0db8\u0dcf\u0db1\u0dca \u0db4\u0db8 \u0dca\u0d82\u0dc1\u0dcf\u0db8\u0dc1\u0db4\u0db8\u0dad\u0dca \u0dcf\u0dcf\u0db4\u0dd4 \u0d85\u0dca \u0dcf \u0d92 \u0dcf\u0da7 \u0db8\u0dd3\u0da7 \u0db1\u0db8\u0dca \u0dc1\u0daf\u0dca\u200d\u0dcf\u0dcf\u0da7 \u0dc1\u0db4\u0dcf\u0db8\u0dad\u0dd4\u0db8\u0dcf\u0ddb \u0d85\u0db4\u0dd2 \u0d92 \u0dca\u0d82\u0dc1\u0dcf\u0db8\u0dc1\u0db4\u0db8\u0dad\u0dca\u0dcf\u0db8\u0ddb\u0dc1\u0dba\u0dcf\u0d9a\u0dca \u0db1\u0dd2\u0daf\u0dca\u200d\u0dc4\u0dca\u0dda \u0dcf\u0dcf \u0d9c\u0dad\u0dca\u0dad\u0db8. \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0d9a\u0dab\u0dca\u0dd4\u0ddb \u0dba\u0dcf\u0d9a\u0da7\u0dc1\u0dad\u0dca \u0d92\u0dcf \u0d85\u0db4\u0dd2 \u0db4\u0dca\u0db4\u0dd4 \u0dc1\u0db4\u0db8\u0d9a\u0dd4 \u0da2\u0dba\u0dcf\u0d9a\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dab\u0dba\u0dcf\u0d9a\u0dc2\u0dcf. \u0dd4\u0dca \u0db8\u0dbb\u0dcf\u0db8\n\n\u0dcf\u0dcf\u0db4\u0dd4 \u0dcf\u0da7, \u0dca\u0d82\u0dc1\u0dcf\u0db8\u0dc1\u0db4\u0db8\u0dad\u0dca\u0dcf\u0db8\u0ddb\u0dba\u0dcf\u0d9a\u0da7 \u0db4\u0dad\u0dca \u0dcf\u0dcf\u0db4\u0dd4 \u0dcf\u0da7 \u0dc3\u0dd4\u0dcf\u0dc2\u0dcf\u0dd2\u0dad \u0dcf\u0dcf\u0db8\u0dd2\u0dca \u0d89\u0daf\u0dd2\u0dba\u0dcf\u0d9a\u0da7 \u0d85\u0dcf\u0dc1\u0d9c\u0dcf \u0dba\u0dcf\u0d9a\u0dca \u0dcf \u0d85\u0db4\u0dd2 \u0dc1\u0db6\u0db1 \u0db4\u0da7\u0dca \u0d9c\u0dad\u0dca\u0dad\u0db8 \u0db8\u0dbb\u0dad\u0dcf\u0dba\u0dd2, \u0db1\u0dc4\u0dad\u0dca\u0ddb\u0dbb\u0dd4\u0db1\u0dd2. \u0d85\u0dc1\u0dca , \u0dc1\u0db6\u0db1 \u0d9a\u0dab\u0dca\u0dd4\u0ddb \u0dc4\u0daf\u0dca\u200d\u0db4\u0db8 \u0dad\u0ddb\u0db1 \u0daf\u0dca\u200d\u0ddb\u0dca\u0dda \u0dbb\u0dd3\u0dc4\u0dd2\u0db4\u0dba\u0dcf\u0d9a\u0dba\u0dd2. \u0d92 \u0db1\u0dd2\u0dca\u0db8 \u0dc1\u0db6\u0db1 \u0d9a\u0dab\u0dca\u0dd4\u0ddb\u0da7 \u0d85\u0dbb\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 5\u0dc2\u0dcf, \u0dc2\u0dcf \u0dba \u0dba\u0dcf\u0d9a\u0db8 \u0ddb\u0db8\u0dc1 \u0d85\u0daf\u0dca\u200d\u0dc4\u0dca\u0dcf \u0d89\u0db3\u0dca \u0d87\u0dd2\u0db1\u0dbd\u0dca\u0db4 \u0daf\u0d9c\u0dd4 \u0dcf\u0dcf\u0dca \u0dcf \u0d91\u0db4\u0db8 \u0dbb\u0dd3\u0dba\u0dcf\u0d9a\u0db4\u0db8 \u0d85\u0db4\u0dd2 \u0db1\u0dad\u0dc2\u0dcf \u0dcf\u0dcf\u0dcf\u0ddb\u0db8. \u0dc1\u0db6\u0db1 \u0d89\u0daf\u0dd2\u0db4\u0dad\u0dca \u0dcf\u0dcf\u0dca \u0dc1\u0dca \u0d85\u0dc1\u0dda \u0db4\u0dc5\u0db8\u0dd4\u0ddb\u0dd0\u0db1\u0dd2 \u0d85\u0dba\u0dcf\u0d9a \u0ddb\u0dd0\u0dba\u0dcf\u0d9a \u0dca\u0ddb\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0db1\u0dad\u0dc2\u0dcf \u0dcf\u0dcf\u0dcf\u0ddb\u0db8. \u0dc1\u0db6\u0db1 \u0db4\u0dc5\u0db8\u0dd4\u0ddb\u0dd0\u0db1\u0dd2 \u0d85\u0dba\u0dcf\u0d9a \u0ddb\u0dd0\u0dba\u0dcf\u0d9a \u0d89\u0daf\u0dd2\u0db4\u0dad\u0dca \u0dcf\u0dcf\u0dcf\u0dc1\u0dcf\u0db8\u0da7 \u0db1\u0dc4\u0db8 \u0dd2\u0db6\u0d82 \u0db4\u0dad\u0dd4\u0db8\u0dcf\u0db4\u0dcf\u0da7 \u0daf\u0dca\u200d\u0db8\u0db4\u0db8 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dcf\u0da7 \u0dba\u0dcf\u0d9a\u0db8\u0dca \u0dad\u0db6\u0db1 \u0dd2\u0db6\u0d82 \u0d9c\u0dd0\u0da7\u0dca\u0da7\u0da7\u0da7 \u0d9c\u0dad\u0dca\u0dad\u0db8 \u0db8\u0dbb\u0dad\u0dcf\u0dba\u0dd2. \u0dc4\u0dd0\u0dca\u0dd0\u0dba\u0dd2, \u0d8a\u0dc5\u0d9f \u0d85\u0dba\u0dcf\u0d9a \u0ddb\u0dd0\u0dba\u0dcf\u0d9a \u0d89\u0daf\u0dd2\u0db4\u0dad\u0dca \u0dcf\u0dcf\u0dcf\u0dc1\u0dcf\u0db8\u0da7 \u0dc1\u0db6\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0ddb\u0dba\u0dcf\u0d9a \u0db8\u0dd3\u0da7 \u0ddb\u0da9\u0db8 \u0dc1\u0ddb\u0dcf\u0dca\u0dda \u0dc1\u0ddb\u0dba\u0dd2."
  },
