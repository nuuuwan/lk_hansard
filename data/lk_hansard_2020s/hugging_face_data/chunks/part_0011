    "chunk_text": "\u0d9a\u0dcf\u0dd2\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0d9c \u0db4\u0da9\u0dca\u0dc1\u0dad\u0db1\u0dca \u0d9c\u0dca\u0dc1\u0dad\u0dcf\u0dca, \u0d85\u0dd9 \u0d86 \u0dcf\u0dbb \u0db1\u0dd2 \u0dca\u0db4\u0dcf\u0dd9\u0db1\u0d9c \u0d9c\u0da9\u0db1 \u0d9a\u0dcf\u0dae\u0dcf \u0d9a\u0dcf\u0dbb\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc1 \u0db8\u0dcf\u0dad \u0d86 \u0dcf\u0dbb \u0dc3\u0dd4\u0dbb\u0dca\u0dd2\u0dad\u0dad\u0dcf\u0dc0 \u0d9c\u0da9\u0db1 \u0d9a\u0dcf\u0dae\u0dcf \u0d9a\u0dcf\u0dbb\u0db1\u0dc0\u0dcf. \u0d86 \u0dcf\u0dbb \u0dc3\u0dd4\u0dbb\u0dca\u0dd2\u0dad\u0dad\u0dcf\u0dc0 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0d91\u0dd9\u0dcf \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0db1\u0dcf\u0d9c\u0d9a\u0dcf\u0dc1\u0d9c\u0ddd \u0d9c\u0dca\u0dad \u0dc0\u0da9\u0dd9\u0d9c\u0dca\u0db8\u0dcf\u0dad \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4\u0dc0 \u0dad\u0db8\u0dcf\u0dad\u0dba\u0dd2, \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca\u0da7 \u0dc0\u0dcf\u0dbb\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0d9c \u0daf\u0dd2\u0dad\u0dd4\u0dab\u0dd4 \u0d9a\u0dd2\u0db8\u0da7\u0db8\u0dcf\u0dad. \u0dc0\u0dcf\u0dbb\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dc1\u0dda \u0daf\u0dd2\u0dad\u0dd4\u0dab\u0dd4\u0dc0 \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dc0\u0dd2\u0dc1 \u0dca \u0dc1\u0d9c\u0db1\u0dca\u0db8\u0dcf\u0dad \u0d9c\u0dbd\u0dca \u0d94\u0d9c, \u0dd2\u0dba\u0db1\u0dd2\u0dc1\u0dda \u0d87\u0d9a, \u0dd2\u0dba\u0db1\u0dca\u0dc1\u0db1\u0dca\u0dbb\u0dd2\u0d9c \u0dc0\u0da9\u0dc0, \u0dad\u0db6\u0dca\u0dbd\u0dc1\u0db6\u0ddd\u0dc0 \u0dc0\u0da9\u0dc0, \u0dc1\u0d9c\u0ddd\u0db0 \u0dc0\u0da9\u0dc0 \u0dcf \u0db8\u0dcf\u0dad \u0dc0\u0da9\u0dd2\u0d9c \u0dc0\u0da9\u0db1\u0dd2 \u0dc1\u0d9c\u0ddd\u0db0 \u0dc3\u0dcf\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc0\u0dba\u0dcf\u0db4\u0dd2\u0dad\u0dd2 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dcf\u0d9a\u0dcf. \u0d92\u0dc1\u0dca \u0dca\u200d\u0dbb\u0dad\u0dd2\u0db5\u0dbd\u0d9c\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0d9c\u0da7 \u0db1\u0dd2\u0dd9 \u0dc1\u0dc3\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0 \u0db4\u0d9a\u0d9a\u0dbb \u0dc0\u0dad\u0dcf\u0dc0\u0da7 80 \u0dd9 \u0d9a\u0dcf\u0dc1\u0dda \u0dc1\u0db8\u0dca \u0dbb\u0da7 \u0dc3 \u0dd2\u0db1\u0dca \u0dc3\u0dca\u0dc0\u0d9c\u0dcf\u0d82\u0dc1\u0db4\u0ddd\u0dd2\u0dad \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0db1\n\n1301 1302\n\n[\u0d9c\u0dbb\u0dd4 \u0da0\u0dad\u0dd4\u0db8\u0dbb \u0d9c\u0dbd\u0dda\u0db4\u0dca\u0dad\u0dd2 \u0db8\u0dcf\u0dad \u0dad\u0dcf]\n\n2025 \u0dc1\u0db4\u0db6\u0dbb\u0dc0\u0dcf\u0dbb\u0dd2 24\n\n\u0d92 \u0dc0\u0dd2\u0dad\u0dbb\u0dca \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2. \u0db8\u0dcf\u0dad \u0dc0\u0da9\u0dd2\u0d9c \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dcf\u0dc1\u0d9a\u0dca \u0d9a\u0dcf\u0dd2\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0d9c \u0dc1\u0dc0\u0db1\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dc0\u0dd4\u0d9a\u0dca, 1994 \u0dc0\u0db1\u0dc1\u0d9a\u0dcf\u0dcf\u0da7 \u0db8\u0dcf\u0dad \u0dc0\u0da9\u0dd2\u0d9c\u0da7 \u0db4\u0dd2\u0db1\u0dca \u0dd2\u0dbb \u0db0 \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0dad\u0db8\u0dcf\u0dad\u0dba\u0dd2 \u0dd2\u0dbb\u0d9c\u0d9c\u0da7 \u0dd2\u0dbb\u0d9c\u0d9c\u0dca \u0da2\u0dcf\u0dbd \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0d9c \u0db1\u0dd2 \u0dca\u0db4\u0dcf\u0dd9\u0db1\u0d9c \u0d9a\u0dcf\u0dc1\u0d9a\u0dca. \u0d92 \u0dc0\u0db1\u0dc1\u0d9a\u0dcf\u0dcf\u0da7 \u0dc1\u0dca, \u0dc1\u0db4\u0dcf\u0dbd\u0dca, \u0dbb\u0db6\u0dbb\u0dca \u0d85\u0db4\u0db1\u0d9c\u0db1 \u0d86\u0dd9\u0dcf\u0d9c\u0db8\u0dcf\u0dad \u0dc0\u0da9\u0da9\u0dd2 \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0db1\u0dca \u0d9a\u0dcf\u0da7\u0dad\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dcf\u0d9a\u0dcf. \u0dc0\u0dd2\u0dc1 \u0dca \u0dc1\u0d9c\u0db1\u0dca\u0db8\u0dcf\u0dad \u0dc1\u0dda. \u0d86\u0dbb\u0dca. \u0da2\u0dcf\u0d9c\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db8\u0dcf\u0dad\u0da9\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0dcf \u0dc0\u0dd2\u0dc0\u0dd2\u0dad \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dcf \u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dca\u0dad\u0dd2\u0d9c \u0dc1\u0db8\u0dca \u0dbb\u0da7\u0da7 \u0db3\u0dd4\u0db1\u0dca\u0dc0\u0dcf \u0daf\u0dd3\u0db8\u0dcf\u0dad \u0dad\u0dd4\u0db8\u0d9a \u0db1\u0dd2\u0dd9 \u0dc3\u0dca \u0dc1\u0dc0\u0dc1\u0d9a\u0db3 \u0d9a\u0dcf\u0dbd\u0dcf\u0db4 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0dc0\u0dd4\u0d9a\u0dcf. \u0db1\u0dd2\u0dd9 \u0dc3\u0dca \u0dc1\u0dc0\u0dc1\u0d9a\u0db3 \u0d9a\u0dcf\u0dbd\u0dcf\u0db4 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dd2\u0db8\u0da7\u0db8\u0dcf\u0dad\u0dca \u0d91\u0dca\u0d9a\u0dcf \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca\u0da7 \u0daf\u0dd2\u0dad\u0dd4\u0dab\u0dd4\u0dc0, \u0dc3\u0dcf\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0d9c \u0dd9\u0da9\u0d9a\u0dcf\u0dbd\u0dcf \u0d91\u0dd9\u0dcf \u0da0\u0dd3\u0db1\u0dc1\u0dda \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d85\u0d9c\u0db8\u0dcf\u0dad\u0da9\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0dcf \u0dbd\u0dcf\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0da7 \u0dc0\u0dd2\u0dc1 \u0dca \u0da5\u0dc1\u0d9c\u0ddd \u0d9a\u0dcf\u0dab\u0dca \u0dcf\u0d9c\u0db8\u0dcf\u0dad\u0dca \u0d91\u0dda\u0dc0\u0dcf, \u0dbd\u0dcf\u0d82\u0d9a\u0dcf\u0dcf\u0dc0 \u0dc1\u0d9a\u0dcf\u0dcf\u0dc1 \u0dcf\u0db8\u0dcf\u0dad\u0dd9 \u0dc1\u0db8\u0dcf\u0dad\u0da0\u0dca\u0da0\u0dbb \u0dba \u200d\u0dbb\u0dc1\u0d9c\u0db1\u0dca \u0daf\u0dd2\u0dad\u0dd4\u0dab\u0dd4 \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0d9a\u0dd2\u0d9c\u0dbd\u0dcf \u0dc1 \u0dcf\u0d9c\u0dbd\u0dcf \u0db6\u0dbd\u0db1\u0dca\u0db1. \u0d85\u0dc1\u0dda \u0db1\u0dd2\u0dd9 \u0dc3\u0dca \u0dc1\u0dc0\u0dc1\u0d9a\u0db3 \u0d9a\u0dcf\u0dbd\u0dcf\u0db4 \u0dc3\u0dcf\u0d82\u0d9a\u0dcf\u0dbd\u0dca\u0db4\u0d9c \u0dad\u0db8\u0dcf\u0dad\u0dba\u0dd2 \u0da0\u0dd3\u0db1\u0d9c\u0da7 \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0dd2\u0dc1\u0dda. \u0db1\u0d9a\u0dbb\u0dca \u0d85\u0dd9 \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dd2\u0dbb\u0da7\u0dd2\u0db1 \u0dad\u0da9\u0db1 \u0db6\u0dbd\u0db1\u0dca\u0db1. \u0d91\u0dd9\u0dcf \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca\u0da7 \u0d92 \u0dc0\u0dcf\u0dc1 \u0dad\u0dca\u0dca\u0dc0\u0d9c\u0dca \u0dad\u0db8\u0dcf\u0dad\u0dba\u0dd2 \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0dab\u0dca."
  },
