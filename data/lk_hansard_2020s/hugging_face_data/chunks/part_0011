    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dc1\u0dca \u0dca\u200d\u0dba ,\u0dd0\u0db1 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0dc1\u0dda \u0dca\u200d \u0dc1 \u0d9a\u0da7\u0da7 \u0db4\u0dca\u200d\u0dad\u0dd2\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dca\u200d \u0db1\u0db1 ,\u0dd0\u0da7\u0dbd\u0dd4 \u0dd2\u0dbd\u0dca \u0db1\u0dca\u0db1 \u0db1\u0db8\u0dca \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dc1\u0dca \u0dca\u200d\u0dba \u0da7 \u0dca\u0d9c\u0dba\u0d9a\u0dca\u0dc2\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db1 \u0daf\u0dd2\u0dd4\u0dad\u0dab\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0da7\u0dc5 \u0dd4\u0dad\u0dd4 \u0db8 \u0dba\u0dd2. \u0d92 \u0dca \u0db1 \u0dc1\u0db8 \u0db8 \u0d85\u0dba \u0dca\u200d\u0dd0\u0dc1\u0dba \u0dad\u0dca \u0dd2\u0dbd\u0dc1 \u0dc2 \u0d85\u0dca\u200d\u0db1 \u0db1\u0dba\u0d9a\u0dca \u0dc1\u0dba\u0ddc\u0db8\u0dd4 \u0da7\u0d9a \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u200d . \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0db8 \u0dca\u0d9c, \u0d89\u0daf\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d92\u0dca\u200d \u0dca\u0dc0\u0dca\u200d\u0dca\u0d9c\u0db1\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0db8 \u0dd0\u0daf\u0dd2\u0dbb\u0dd2 \u0dd2\u0dba\u0dc2\u0dae\u0db4 \u0dd9\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dca \u0db1 \u0d85\u0db4\u0dd2 \u0da7\u0da7\u0dd4\u0dad\u0dd4 \u0da7\u0d9a\u0db1\u0dca\u200d . \u0d92 \u0dca\u200d \u0dc1 \u0db8 \u0dd2\u0dbd\u0daf\u0dd4\u0dbd\u0dd2 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0dc1\u0da7\u0ddc\u0dc5\u0db9 \u0db1,\u0d9a\u0dba\u0da7 \u0d86\u0dca\u0db1\u0dca\u0db1\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0dba\u0dd9\u0dc0\u0dd3\u0db8 \u0da7 \u0dd9\u0dd0\u0db1\u0da7\u0db8 \u0dad\u0dca \u0da7\u0da7\u0dd4\u0dad\u0dd4 \u0da7\u0d9a\u0dc1,\u0db1 \u0dba\u0db1\u0dca\u200d . \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dc1\u0dca \u0dca\u200d\u0dba \u0db1\u0dc0\u0dd3\u0da7\u0d9a\u0dab\u0dba \u0da7\u0d9a\u0dbd \u0dca\u200d\u0db1\u0dad \u0dca\u200d \u0d86\u0da7\u0dca\u0d9c\u0dc2\u0dab\u0dba \u0dca\u200d\u0db1 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dc1\u0dca \u0dca\u200d\u0dba\u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0d87\u0dad\u0dd2 \u0da7\u0d9a\u0db1\u0dca\u200d . \u0db3\u0dca\u0dae \u0d9a\u0dcf\u0dca\u200d\u0dbd\u0dd2\u0db1\u0dca \u0db4\u0db8 \u0dab\u0d9a\u0dca \u0d9a\u0da7\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dca\u200d \u0db1\u0db1\u0dba \u0daf\u0dd2\u0dd4\u0dad\u0dab\u0dd4 \u0da7\u0d9a\u0db1\u0dca\u0db1 \u0d85\u0db8 \u0dbb\u0dd4\u0dba\u0dd2. \u0daf\u0dd2\u0dd4\u0dad\u0dab\u0dd4 \u0dc1\u0dca\u200d\u0da0\u0dca\u0da0 \u0d9a\u0da7\u0dca\u200d\u0dca \u0d91\u0da7\u0da7\u0dca\u200d\u0dad\u0dca \u0db3\u0dca\u0dae \u0d9a\u0dcf\u0dca\u200d\u0dbd\u0dd2\u0db1\u0dca \u0db4\u0db8 \u0dab\u0d9a\u0dca \u0db4\u0dca\u200d\u0dbb\u0dca\u200d \u0db1\u0db1 \u0d9a\u0dca\u0dc1\u0dc2 \u200d\u0dbb\u0dba \u0daf\u0dd2\u0dd4\u0dad\u0dab\u0dd4 \u0da7\u0d9a\u0dbd \u0db1\u0dd0\u0db1\u0dd0. \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dc1\u0dca \u0dca\u200d\u0dba \u0dd2\u0dbd\u0dc1 \u0dc2\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0db4\u0dca\u200d\u0dbb\u0db1 \u0db1 \u0dad\u0dd0\u0db1\u0d9a\u0dca ,\u0db1\u0dca\u0db1\u0dca\u200d . \u0d92\u0da7\u0da7 \u0dc1\u0db8\u0dca \u0d85\u0dba \u0dca\u200d\u0dd0\u0dc1\u0dba\u0db1\u0dca \u0db4\u0db8 \u0dab\u0d9a\u0dca -\u0dc1\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0dd9 \u0dca \u0db1 \u0db4\u0db8 \u0dab\u0d9a\u0dca- \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1 000\u0d9a\u0dca \u0dc1\u0dca\u200d\u0db1\u0dca \u0da7\u0d9a \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u200d .\n\n\u0d8a\u0dc5\u0d9f\u0da7 \u0db8 \u0dc1 \u0dd2\u0dbd\u0dc2\u0dba\u0dba\u0da7 \u0d85\u0dd9 \u0dc5 \u0db3\u0dbd \u0d9a\u0dca\u0dad\u0dd2 \u0d9a\u0dca\u0dc1\u0dc2 \u200d\u0dbb\u0dba ,\u0db1\u0dca\u0db1\u0db8\u0dca. \u0db3\u0dbd \u0d9a\u0dca\u0dad\u0dd2 \u0d9a\u0dca\u0dc1\u0dc2 \u200d\u0dbb\u0dba \u0dca\u0dc0\u0dca\u200d\u0dca\u0d9c\u0db1\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dca \u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 21 1]0\u0d9a\u0dca \u0dc1\u0db8 \u0dca\u200d\u0d9a \u0d85\u0dba \u0dca\u200d\u0dd0\u0dc1\u0dba\u0db1\u0dca \u0dc1\u0dca\u200d\u0db1\u0dca \u0da7\u0d9a \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u200d . \u0d92\u0da7 \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0d89\u0dad \u0dca\u200d\u0dd0\u0dd9,\u0dad\u0dca \u0dc1\u0dd9\u0dba\u0d9a\u0dca.\n\n\u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0dca\u200d \u0dad\u0dd2\u0da7 \u0dca\u0db8\u0dca\u0dc1\u0db4\u0dca\u200d\u0dbb \u0dc2\u0dab \u0dca\u0db1 \u0dc1\u0db3\u0dd9 \u0db1\u0dd0\u0dbb\u0dd3\u0db8\u0dca \u0dca\u200d \u0dbd\u0dba \u0db1 \u0da7 \u0dca\u0d9c\u0dba\u0d9a\u0dca\u0dc2\u0db8 \u0dad \u0dca\u200d\u0dd0\u0da9\u0dd2\u0daf\u0dd2\u0dd4\u0dad\u0dab\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dca \u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 7 670\u0d9a\u0dca \u0dc1\u0dca\u200d\u0db1\u0dca \u0da7\u0d9a \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u200d . \u0dd2\u0dbd\u0dc1 \u0dc2\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0db1,\u0d9a\u0dca\u200d\u0dbd \u0d87\u0dad\u0dd2 \u0dc1\u0dca\u200d\u0dbd \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1\u0dbd\u0ddc\u0d9a\u0dd4\u0db8 ,\u0dd0\u0da7\u0dbd\u0dd4\u0dca\u200d\u0d9a\u0dca \u0dad\u0db8 \u0dba\u0dd2 \u0d9d\u0db1 \u0d85\u0db4\u0daf\u0dca\u200d\u0dbb\u0dca\u200d\u0dba \u0db3\u0dd0\u0db1\u0dd0\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 . \u0d92 \u0dca \u0db1 \u0d85\u0db4\u0dd2 \u0dc1\u0da7\u0ddc\u0dc5\u0db9 \u0db1,\u0d9a\u0dba \u0dd2\u0dbd\u0dad\u0d9a\u0d9a\u0dca \u0d85\u0d9a\u0db8\u0dd4\u0dab\u0dd4 \u0da7\u0d9a\u0dc1,\u0db1 ,\u0db1 \u0d85\u0db4\u0daf\u0dca\u200d\u0dbb\u0dca\u200d\u0dba\n\n\u0db3\u0dbd \u0d9a\u0dca\u0dad\u0dd2\u0dba \u0db3\u0dca\u200d\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0db3\u0dbd , \u0d9a\u0dba\u0d9a\u0dca \u0dca\u0dae\u0dcf \u0db4\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dca \u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1 200\u0d9a\u0dca \u0dd9 \u0d9a\u0dca\u200d\u0dc1\u0dda \u0dc1,\u0ddc\u0da9\u0db1\u0dd0\u0d9f\u0dd2\u0dbd\u0dd2 \u0d85\u0da9\u0dd4 \u0d86\u0dd9 \u0dba\u0db8\u0dca\u0dbd \u0db7\u0dd3 \u0dd2\u0dba\u0dca\u200d \u0dca \u0d86,\u0db8\u0dd2\u0da7 \u0dca\u0dae\u0dcf \u0db1 \u0dca\u200d\u0dbd \u0db4\u0dd2\u0dbb\u0dd2\u0db4\u0db1\u0daf\u0dd4 \u0db8 \u0db1\u0dba\u0dca\u0dae\u0dcf \u0db1 \u0dca \u0db1 \u0dd6\u0dca\u0d9c\u0dba\u0dc1\u0da7\u0ddd\u0dc2 \u0da7\u0dca,\u0da7\u0dbd \u0dca\u0dd0\u0db4\u0dba\u0dd3\u0db8 \u0dca \u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 290\u0d9a\u0dca \u0dd9 \u0dd2\u0dbd\u0dc1 \u0dc2\u0dc1\u0dba\u0db1\u0dca\u0db8 \u0d8b\u0dd4 \u0dbb\u0dd4 \u0db4\u0dc5 \u0dad\u0da7 \u0d86\u0dca\u0db1\u0dca\u0db1 \u0dc1\u0da9\u0dca \u0dc6\u0dae\u0dca, \u0d85\u0db1\u0db1\u0dad\u0dd2\u0dda \u0db1\u0dba\u0dd2\u0db1\u0dad\u0dd2\u0dda \u0daf\u0dd6\u0db4\u0dad\u0dca\u0dca\u200d\u0dbd \u0dc1\u0dd9\u0db8\u0dd4\u0dc4\u0dd4\u0db1\u0dca \u0db4\u0dd4\u0db1\u0dca\u0d9c\u0dca\u200d\u0db1\u0db1\u0dd3\u0dba \u0db3\u0dbd \u0d9a\u0dca\u0dad\u0dd2 \u0db4\u0daf\u0dca\u0db1\u0dad\u0dd2 \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dca \u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 3 000\u0d9a\u0dca \u0dd9 \u0dbd\u0dc0\u0da7 \u0dd2\u0dbd\u0daf\u0dd4\u0dbd\u0dd2\u0db3\u0dbd \u0db8 \u0dab\u0dca\u0da9\u0dbd\u0dc1\u0dda \u0db1 \u0dbb\u0dd2\u0dad \u0dca\u200d \u0dca\u0dc0\u0dca\u200d\u0dca\u0d9c\u0db1\u0db1\u0dba \u0dca \u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 290\u0d9a\u0dca \u0dd9 \u0dc1\u0dca\u200d\u0db1\u0dca \u0da7\u0d9a \u0dad\u0dd2\u0dc1\u0db3\u0db1\u0dca\u200d ."
