    "chunk_text": "\u0d8a\u0d9a\u0dc0\u0da7 \u0db6\u0dbd\u0db1\u0dca\u0db1, \u0d85\u0dd9 \u0dc0\u0dcf \u0db1 \u0d86\u0db1\u0d9c\u0db1\u0d9c \u0d9a\u0dd2\u0db8\u0da7\u0db8\u0dcf\u0dad \u0d9c\u0da9\u0db1. \u0d91\u0dd9\u0dcf \u0dc1\u0db8\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc1\u0dda \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0db8\u0dcf\u0dad\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4 \u0dc3 \u0d87\u0db8\u0dcf\u0dad\u0dad\u0dd2\u0dc0\u0dbb\u0dd4 \u0dc1\u0db4\u0dcf\u0dc1\u0dbb\u0dcf\u0db1\u0dca\u0daf\u0dd4 \u0dc0\u0dd4\u0d9a\u0dcf, \u0dbb\u0dd4\u0db4\u0dd2\u0d9c\u0dbd\u0dca \u0dbd\u0dca 12\u0d9a\u0dcf\u0da7 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca \u0d91\u0d9a\u0dcf\u0dca \u0dc1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0d9c\u0dbd\u0dcf. \u0db1\u0d9a\u0dbb\u0dca motorbike \u0d91\u0d9a\u0dcf\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0d9c\u0dbd\u0dca \u0dbd\u0dca 12\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0d9c\u0dbd\u0dcf \u0dad\u0db8\u0dcf\u0dad\u0dba\u0dd2 \u0d85\u0db1\u0dca\u0dad\u0dd2\u0db8\u0dcf\u0dad\u0da7 \u0d8a\u0dc1\u0dda \u0dc1 \u0dc5\u0dd2\u0dd9\u0dbb\u0dda \u0dc0\u0dd4\u0dc1\u0dab\u0dca. \u0d85\u0db4\u0dd2\u0da7 \u0dc1\u0db8\u0dca \u0dd2\u0dba\u0dbd \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dad\u0dcf\u0d9a\u0d9c \u0dc0\u0da9\u0da9\u0dd2\u0dc0\u0dd3\u0db8\u0dcf\u0dad \u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0db1\u0dca\u0db8\u0dcf\u0dad \u0d86\u0dd9\u0dcf\u0d9c\u0db8\u0dcf\u0dad\u0dca \u0dbd\u0da9\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0da9 \u0da9. \u0db8\u0dcf\u0dad\u0dcf \u0dd9\u0db1\u0dca\u0db1\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0d9c\u0da7 \u0d87\u0dc1\u0db8\u0dcf\u0dad\u0dbb\u0dd2\u0d9a\u0dcf\u0dcf\u0db1\u0dd4 \u0dc1 \u0dcf\u0dbd\u0dbb\u0dca \u0dd2\u0dba\u0dd2\u0d9c\u0db1 82\u0d9a\u0dcf \u0dad\u0db8\u0dcf\u0dad\u0dba\u0dd2 \u0dd9\u0da9\u0db1\u0da7 \u0dc1\u0db8\u0dca \u0dbb\u0dc1\u0da7\u0dca\u0da7 LCs \u0dc0\u0dd2\u0dc0\u0dd2\u0dad \u0d9a\u0dcf\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d87\u0dc1\u0db8\u0dcf\u0dad\u0dbb\u0dd2\u0d9a\u0dcf\u0dcf\u0db1\u0dd4 \u0dc1 \u0dcf\u0dbd\u0dbb\u0dca \u0dd2\u0dba\u0dd2\u0d9c\u0db1 1,000\u0dca -\u0d87\u0dc1\u0db8\u0dcf\u0dad\u0dbb\u0dd2\u0d9a\u0dcf\u0dcf\u0db1\u0dd4 \u0dc1 \u0dcf\u0dbd\u0dbb\u0dca \u0db6\u0dd2\u0d9c\u0db1 1\u0dca- \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dcf\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc1\u0d9a\u0dcf\u0dcf\u0da7 \u0d92\u0dc1\u0d9a\u0dcf\u0db1\u0dca \u0d87\u0dc1\u0db8\u0dcf\u0dad\u0dbb\u0dd2\u0d9a\u0dcf\u0dcf\u0db1\u0dd4 \u0dc1 \u0dcf\u0dbd\u0dbb\u0dca \u0dd2\u0dba\u0dd2\u0d9c\u0db1 82\u0dca \u0d9a\u0dd2\u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0dd2\u0dbb\u0d9c\u0d9c\u0da7 8\u0dba\u0dd2 \u0dc0\u0dd2\u0dc0\u0dd2\u0dad \u0d9a\u0dcf\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0db8\u0dcf\u0dad\u0db8\u0dcf\u0dad \u0dc4\u0dd2\u0dad\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0d9c\u0da7 \u0dc1\u0dbd\u0dcf\u0d9a\u0dd4 \u0dc1\u0dc0\u0db1\u0dc3\u0dca \u0d87\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u0db1 \u0d85\u0dc0 \u0dba\u0dba\u0dd2, \u0dc1\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0d9c\u0db1\u0dca. \u0d87\u0db8\u0dcf\u0dad\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0dad\u0dcf \u0d92 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc1\u0d9c\u0db1\u0dca \u0d9c\u0db8\u0dca\u0d9a\u0dd2\u0dd2\u0dbb \u0dc0\u0dd2\u0db0\u0dd2\u0d9c\u0d9a\u0dcf \u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf \u0d9c\u0dca \u0d9a\u0dcf\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0d9a\u0dcf. \u0d91\u0d9c \u0d85\u0da9\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf\u0dd9, \u0db1\u0da9 \u0dd9 \u0d9a\u0dd2\u0d9c\u0db1 \u0d91\u0d9a\u0dcf \u0dc1\u0dc0\u0db1\u0db8\u0dcf\u0dad \u0dc1\u0dd9\u0d9c\u0dca. \u0da9\u0db6\u0da9\u0dba\u0dd2, \u0db8\u0dcf\u0dad\u0dcf \u0dc4\u0dd2\u0dad\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0d9c\u0da7 \u0da2\u0dcf\u0db4\u0dcf\u0db1\u0dc1\u0dda \u0dbb\u0dd4\u0db4\u0dd2\u0d9c\u0dbd\u0dca \u0dbd\u0dca 20\u0d9a\u0dcf\u0da7 \u0dad\u0dd2\u0dc1\u0db6\u0db1 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca \u0d91\u0d9a\u0dcf\u0dca \u0dc1\u0db8\u0dcf\u0dad \u0dcf\u0da7 \u0d91\u0db1\u0dc1\u0d9a\u0dcf\u0dcf\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0d9c\u0dbd\u0dca \u0dd2\u0dba\u0dd2\u0d9c\u0db1 20\u0dca \u0dc0\u0dd3\u0db8\u0dcf\u0dad \u0dca\u200d\u0dbb\u0dcf\u0dc1\u0d9c\u0ddd\u0dd2\u0d9a\u0dcf\u0dc0 \u0dd9\u0dbb\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db6\u0da9 \u0da9. \u0dc1\u0db8\u0dcf\u0dad\u0dcf\u0d9a\u0dcf\u0dd9, \u0db6\u0daf\u0dd4 \u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0db1\u0dca \u0d9a\u0dcf\u0dd2\u0dd2\u0db8\u0dcf\u0dad \u0dc0 \u0dc1\u0d9c\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0d9c\u0dbd\u0dca \u0dd2\u0dba\u0dd2\u0d9c\u0db1 18\u0dca \u0d91\u0d9a\u0dcf\u0dad\u0dd4\u0db8 \u0d9a\u0dd2\u0db8\u0da7\u0db8\u0dcf\u0dad \u0d91\u0dc1\u0dc3\u0dca \u0dc1\u0db8\u0dcf\u0dad\u0dc1\u0dc3\u0dca \u0d9a\u0dcf\u0da7\u0dad\u0dd4\u0dca\u0dad\u0dca \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2. \u0db8\u0dd3\u0da7 \u0dc0\u0da9\u0da9\u0dd2\u0d9c \u0d95\u0db1\u0dd1\u0d9a\u0dcf\u0dd2\u0dba\u0db1\u0dca \u0dc1\u0db8\u0dca\u0dc0\u0dcf \u0d9c\u0da9\u0db1 \u0db6\u0dbd\u0db1\u0dca\u0db1 \u0d85\u0dc0 \u0dba\u0dba\u0dd2. \u0dc1\u0db8\u0dcf\u0dad\u0dcf\u0d9a\u0dcf\u0dd9, \u0db6\u0da9\u0dbb\u0dd2 \u0dc1\u0dc0\u0dbd\u0dcf\u0dc0\u0dca \u0d92 \u0d86\u0dd9\u0dcf\u0d9c\u0db8\u0dcf\u0dad \u0dbd\u0da9\u0db6\u0dd4\u0dc1\u0dab\u0dca \u0db1\u0da9\u0dca\u0db1\u0db8\u0dca \u0dc0\u0dd2\u0d9c\u0dd9\u0db8\u0dca \u0d9a\u0dd2\u0db8\u0da7\u0db8\u0dcf\u0dad\u0da7 \u0d92\u0d9a\u0dcf \u0dc3\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0d9a\u0dc1\u0d9c\u0db1\u0dca \u0db6\u0dcf\u0db0\u0dcf\u0dc0\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0dcf.\n\n\u0d92 \u0dc0\u0dcf\u0dc1 \u0db8\u0dcf\u0dad \u0dc1\u0db8\u0dca \u0d85\u0d9c \u0dc0\u0da9\u0d9c \u0dad\u0dd4\u0db8\u0d9a \u0dad\u0dc0\u0dca \u0dc3\u0dd4\u0dc0\u0dd2\u0dc1 \u0dca\u0dc2\u0dd3 \u0d9a\u0dcf\u0dcf\u0dbb\u0d9a\u0d9c\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0d9a\u0dcf. \u0d92 \u0dad\u0db8\u0dcf\u0dad\u0dba\u0dd2, \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dbd\u0db1\u0dca\u0d9a\u0dcf\u0db1\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0db8\u0dcf\u0dad\u0dcf\u0d9c\u0db8\u0dcf\u0dad\u0da7 \u0d9a\u0d9c \u0d86\u0db4\u0dc3\u0dd4 \u0dc1\u0d9c\u0dc0\u0dd3\u0db8\u0dcf\u0dad \u0dc3\u0db3 \u0dcf \u0dc1\u0db8\u0dcf\u0dad\u0dc0\u0dbb \u0d85\u0d9c \u0dc0\u0da9\u0dc1\u0d9c\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0d9c\u0dbd\u0dca \u0db6\u0dd2\u0d9c\u0db1 20\u0dca -\u0dbb\u0dd4\u0db4\u0dd2\u0d9c\u0dbd\u0dca \u0dc1\u0d9a\u0dcf\u0ddd\u0da7\u0dd2 2,000\u0dca- \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dcf\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf. \u0dc1\u0db8\u0dca \u0dd9\u0dc3\u0dc0\u0db1 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc1\u0dda \u0db4\u0d9a\u0d9a\u0dbb\u0dc0\u0da9\u0db1\u0dd2 \u0dc0\u0dad\u0dcf\u0dc0\u0da7 \u0d9a\u0dcf\u0dae\u0dcf \u0d9a\u0dcf\u0dbb\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc1\u0dda\u0daf\u0dd3 \u0db8\u0dcf\u0dad\u0db8\u0dcf\u0dad \u0dca\u200d\u0dbb\u0dcf\u0dc1\u0d9c\u0ddd\u0dd2\u0d9a\u0dcf \u0dd9\u0da9\u0db1\u0dd4\u0dc0\u0dca\u0d9a\u0dcf\u0db8\u0dcf\u0dad \u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0db1\u0dca \u0d9a\u0dd2\u0dda\u0dc0\u0dcf, \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dbd\u0db1\u0dca\u0d9a\u0dcf\u0db1\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc1\u0dc3\u0dca\u0dc0\u0d9c \u0d9c\u0da9\u0db1 \u0d9a\u0dd2\u0d9c\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0da0\u0dd3\u0db1\u0dc1\u0dda \u0d89\u0db1\u0dca\u0db1 Mr. Chu \u0d91\u0dcf\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0d9c\u0da7 \u0d9c\u0db1\u0dc1\u0d9a\u0dcf\u0dcf\u0da7 \u0d85\u0dc1\u0dda \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d82\u0d9a\u0dcf\u0dcf\u0dc1\u0dda \u0db6\u0daf\u0dd4 \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1\u0dcf \u0d92 \u0dc3\u0db3 \u0dcf \u0db6\u0daf\u0dd4 \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0d85\u0dc0 \u0dba \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0da9 \u0da9; \u0db4\u0dcf\u0da9\u0dd4 \u0dc0\u0dd2\u0dd2 \u0db1\u0dca\u0db1 \u0d85\u0dc0 \u0dba \u0db1\u0da9 \u0da9 \u0d9a\u0dd2\u0d9c\u0dbd\u0dcf.\n\n\u0db1\u0d9a\u0dbb\u0dca, \u0dc1\u0db8\u0dca \u0dc3\u0db3 \u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0d9c\u0dbd\u0dca \u0db6\u0dd2\u0d9c\u0db1 20\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dcf\u0dbb\u0dbd\u0dcf, \u0d92 \u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0db1\u0dca \u0dca\u200d\u0dbb \u0dca\u0db1\u0d9c \u0dc3\u0dd9\u0dcf\u0d9a\u0dcf\u0dcf\u0dbd\u0d9c\u0da7\u0db8\u0dcf\u0dad \u0dc0\u0dd2\u0dc3\u0db3\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0db1\u0db8\u0dca \u0d85\u0db4\u0dd2 \u0dc3\u0dad\u0dd4\u0db8\u0dd4 \u0dc1\u0dc0\u0db1\u0dc0\u0dcf. 2023 \u0db8\u0dcf\u0dad\u0da9\u0dba\u0dd2 \u0db8\u0dcf\u0dad\u0dcf\u0dc3\u0dc1\u0dda \u0dd2\u0dbb\u0da7 2024 \u0dc3\u0da9\u0dda\u0dad\u0da9\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dcf\u0dad\u0dcf\u0dc3\u0d9c \u0dc0\u0db1\u0d9a\u0dcf\u0dbd\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0d9c\u0dbd\u0dca \u0db6\u0dd2\u0d9c\u0db1 102\u0dca \u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dcf\u0dbb \u0dad\u0dd2\u0dc1\u0db6\u0db1\u0dc0\u0dcf, \u0dc1\u0db8\u0dca \u0d9a\u0d9c \u0da7\u0dd2\u0d9a\u0dcf \u0dc1\u0d9c\u0dc0\u0db1\u0dca\u0db1. \u0d92\u0dca \u0dca\u200d\u0dbb \u0dca\u0db1\u0d9c \u0dc0\u0dd2\u0dc3\u0db3\u0dbd\u0dcf \u0db1\u0da9 \u0da9. \u0db8\u0dd6\u0dbd\u0dba \u0dad\u0dca\u0dca\u0dc0\u0d9c \u0dc1 \u0dcf\u0db3"
  },
