    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0dcf\u0d9a\u0ddd\u0da2\u0dba \u0dcf\u0db8\u0dcf\u0dcf \u0dca\u0dcf\u0db8\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0dd2\u0dba\u0dcf\u0d9a\u0db1\u0dd2, 20] \u0ddb\u0dca \u0dc1\u0dca \u0dc1\u0db6\u0db1 \u0dcf\u0dc1\u0da7\u0dca\u0da7 \u0daf\u0dca\u200d\u0dd2\u0dbb\u0dad\u0db8\u0ddb \u0dc3\u0dd2\u0dba\u0dcf\u0d9a\u0dba\u0dcf\u0d9a\u0da7 4\u0da7 \u0dad\u0dd2\u0db6\u0dd4\u0dc1\u0dab\u0dca. \u0dcf\u0db8\u0dd4\u0dad\u0dca \u0d85\u0dca\u0db6\u0dd4\u0daf\u0dca\u200d\u0dba\u0dcf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0dd2\u0db6\u0dca \u0d87\u0dad\u0dd2 \u0dcf\u0dc5 \u0daf\u0dca\u200d\u0dd2\u0dbb\u0dad\u0db8\u0ddb, \u0d91\u0dc1\u0dc4\u0db1 \u0dcf\u0dd0\u0dad\u0dca\u0dcf\u0db6\u0db1 crisis-driven poverty, 2023 \u0dc1\u0ddb\u0dda\u0daf\u0dd3 \u0dc3\u0dd2\u0dba\u0dcf\u0d9a\u0dba\u0dcf\u0d9a\u0da7 25.9\u0dc2\u0dcf \u0daf\u0dca\u200d\u0dc2\u0dcf\u0ddb\u0db8 \u0ddb\u0dd0\u0dca \u0dc1\u0ddb\u0db4\u0db8 \u0dad\u0dd2\u0dc1\u0dca\u0dcf\u0ddb\u0db8. \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc1\u0dba\u0dcf\u0d9a\u0ddd\u0da2\u0dba \u0dcf\u0db8\u0dcf\u0dcf \u0dca\u0dcf\u0db8\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0dd2\u0dba\u0dcf\u0d9a\u0db1\u0dd2, \u0dca\u0dda\u0dc0\u0ddb\u0db8\u0dad\u0dca\u0ddb \u0dab\u0dba\u0dcf\u0d9a \u0db4\u0dd0\u0dc4\u0dd0\u0dcf \u0dc4\u0dd0\u0db8\u0db1\u0da7 \u0db4\u0dc2\u0dcf \u0dc0\u0dd6 \u0dcf\u0da7\u0ddb\u0dbd\u0dca \u0daf\u0dca\u200d\u0dd2\u0dbb\u0dad\u0db8\u0ddb \u0dca\u0db6\u0db1\u0dca\u0dca \u0dd9\u0ddb \u0daf\u0d9c\u0dd4 \u0dcf\u0db8\u0db4\u0dba\u0dcf\u0d9a\u0dc2\u0dcf \u0dad\u0dd2\u0dca\u0dda\u0dc1\u0dca\u0dda \u0d89\u0dad\u0db8\u0db1 \u0daf\u0dca\u200d\u0dbb\u0dd4\u0dab\u0dd4 \u0d85\u0dad\u0dca\u0daf\u0dca\u200d\u0dd0\u0d9a\u0dd3\u0db6\u0db1\u0ddb\u0db4\u0da7 \u0db8\u0dd4\u0dc4\u0dd4\u0dab \u0db4\u0db8\u0dcf\u0ddb\u0db8. \u0dcf\u0db8\u0dd4\u0dad\u0dca \u0da2\u0db8\u0dad\u0dd2\u0dcf \u0da2\u0dcf \u0dca\u0db4\u0dc1\u0dda\u0d9c\u0dba\u0dcf\u0d9a \u0dcf\u0da2\u0dba\u0dcf\u0d9a \u0dad\u0dd4\u0db8\u0dcf\u0dc5 \u0db1\u0dd2\u0dc3\u0dd2 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd\u0dca \u0dcf\u0dc5\u0db1\u0dcf\u0db8\u0dcf\u0dcf\u0dab\u0dba\u0dcf\u0d9a, \u0ddb\u0d9c\u0d9a\u0dd3\u0dc1\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dcf \u0dab\u0dba\u0dcf\u0d9a \u0dcf\u0dc5\u0db1\u0dcf\u0db8\u0dcf\u0dcf\u0dab\u0dba\u0dcf\u0d9a, \u0dc2\u0dcf\u0dad\u0dd2\u0db1\u0dad\u0dca \u0dca\u0db1\u0db8\u0da2 \u0d9a\u0dcf\u0dc2\u0dcf\u0dc2\u0dab \u0da2\u0db8\u0db4 \u0db4\u0dda\u0dd9\u0dad\u0dd2 \u0d87\u0dad\u0dd2 \u0dbb\u0dd3\u0db8\u0db1, \u0ddb\u0dba\u0ddb\u0dca\u0db8\u0dba\u0dcf\u0d9a\u0dcf\u0dad\u0dca\u0ddb\u0dba\u0dcf\u0d9a, \u0dcf\u0ddb \u0ddb\u0dba\u0db8\u0db4\u0db8\u0dcf \u0d87\u0dcf\u0db9\u0dd3\u0db1 \u0dca\u0db3\u0dc4\u0db8 \u0db4\u0dc4\u0dc3\u0dd4\u0dcf\u0db6\u0db1"
  },
