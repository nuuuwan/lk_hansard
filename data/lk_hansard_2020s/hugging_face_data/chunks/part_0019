    "chunk_text": "\u0dbd\u0daf\u0d9c \u0dc3\u0dca\u0dad\u0dd4 31 \u0dd9\u0d9a\u0dca\u0dc2\u0dc0\u0d9a \u0dd2\u0d9a\u0d82\u0dba \u0d9c\u0dca\u0daf\u0dad\u0d9a\u0dca \u0d82\u0dd2\u0dd2\u0d9a\u0dc0\u0da7 \u0d87\u0dc0\u0dd2 \u0db4\u0d82\u0d9a \u0dad\u0dd2\u0daf\u0db4\u0db1\u0dc0\u0d9a, \u0dc3\u0dd2\u0dba\u0d9a\u0dbb\u0dd2\u0dba \u0dc0 198,235\u0d9a\u0dca\u0dc2. \u0dc3\u0dd2\u0dba\u0d9a\u0dbb\u0dd2\u0dba \u0dc0 198,235\u0d9a\u0dca\u0dc2 \u0d82\u0dd2\u0dd2\u0d9a\u0dc0\u0da7 \u0d91\u0db1\u0daf\u0dd2\u0d9a\u0da7, \u0d91\u0dca \u0dd2\u0dc0\u0dd4\u0dc5\u0dd4\u0daf\u0dc0 \u0dc0 \u0dad\u0dca\u0dba \u0daf\u0dd4\u0dbb\u0dd4 \u0db4\u0d82\u0dca\u200d\u0dbb - driving licences - \u0dbd\u0dbb\u0daf\u0d9c\u0db1 \u0dad\u0dd2\u0daf\u0db4 \u0dc0\u0daf \u0dc0 2,306\u0daf\u0dd9\u0db1\u0d9a\u0db1\u0dca. \u0d92\u0dd2, \u0dca\u0dd0\u0dd2\u0da7\u0dab\u0dd2 \u0dc3\u0dd2\u0dba\u0d9a\u0dbb\u0dd2\u0dba \u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dca\u0d9a\u0dab\u0dba \u0dca \u0d91\u0d9a\u0dca\u0dc2\u0dd2 \u0d9c\u0dca\u0dad\u0d9a\u0dca \u0dd2\u0db1\u0dba \u0dba \u0da7 1.16\u0d9a\u0dca\u0dc2. \u0dc3\u0dd0\u0dca\"\u0dad\u0dd0\u0dda\u0db4\u0dbb\u0dca 01\u0dc0\u0dd0\u0db1\u0dd2 \u0dd9\u0d9a \u0dca \u0d82\u0d9a \u0dc3\u0dd0\u0dca\"\u0dad\u0dd0\u0dda\u0db4\u0dbb\u0dca 30 \u0dd9\u0d9a\u0dca\u0dc2\u0dc0\u0d9a \u0dca\u0d9a\u0dc3\u0dba \u0d9c\u0dca\u0daf\u0dad\u0d9a\u0dca, \u0dc3\u0dd2\u0dba\u0d9a\u0dbb\u0dd2\u0dba \u0dc0 150,971\u0d9a\u0dca\u0dc2 \u0d82\u0dd2\u0dd2\u0d9a\u0dc0\u0da7 \u0d87\u0dc0\u0dd2 \u0db4\u0d82\u0d9a \u0dad\u0dd2\u0daf\u0db4\u0db1\u0dc0\u0d9a. \u0dc4\u0dd0\u0db4\u0dd0\u0db1\u0dca \u0d92 \u0dd2\u0dc0\u0dd4\u0dc5\u0dd4\u0daf\u0dc0 \u0dc0 \u0dad\u0dca\u0dba \u0daf\u0dd4\u0dbb\u0dd4 \u0db4\u0d82\u0dca\u200d\u0dbb - driving licences - \u0dbd\u0dbb\u0daf\u0d9c\u0db1 \u0dad\u0dd2\u0daf\u0db4 \u0dc0\u0daf \u0dc0 1,965\u0daf\u0dd9\u0db1\u0d9a\u0db1\u0dca. \u0d92 \u0d9a\u0dba\u0dba \u0dc0\u0daf \u0dc0, \u0dd2\u0db1\u0dba \u0dba \u0da7 1.24\u0d9a\u0dca\u0dc2. \u0dca\u0d9a\u0dca\u0dc2\u0daf\u0dad \u0db4\u0dbb\u0dca 01\u0dc0\u0dd0\u0db1\u0dd2 \u0dd9\u0d9a \u0dd2\u0db1\u0da7 \u0dca\u0d9a\u0dca\u0dc2\u0daf\u0dad \u0db4\u0dbb\u0dca 31 \u0dd9\u0d9a\u0dca\u0dc2\u0dc0\u0d9a \u0dd2\u0d9a\u0d82\u0dba \u0d9c\u0dca\u0daf\u0dad\u0d9a\u0dca \u0d82\u0dd2\u0dd2\u0d9a\u0dc0\u0da7 \u0d87\u0dc0\u0dd2\u0dca \u0dad\u0dd2\u0daf\u0db4\u0db1\u0dc0\u0d9a, \u0dc3\u0dd2\u0dba\u0d9a\u0dbb\u0dd2\u0dba \u0dc0 165,193\u0d9a\u0dca\u0dc2. \u0d92 \u0dd2\u0dc0\u0dd4\u0dc5\u0dd4\u0dc0 \u0dc4\u0dbb\u0dc4\u0d9a \u0dad\u0dca\u0dba \u0daf\u0dd4\u0dbb\u0dd4 \u0db4\u0d82\u0dca\u200d\u0dbb \u0dbd\u0dbb\u0daf\u0d9c\u0db1 \u0dad\u0dd2\u0daf\u0db4 \u0dc0\u0daf \u0dc0, 1,977\u0daf\u0dd9\u0db1\u0d9a\u0db1\u0dca. \u0d91\u0dba \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc1\u0dad\u0dba \u0d9a\u0dca\u0dc2 \u0dc0\u0dc1\u0daf\u0dba \u0dc0 \u0d9c\u0dca\u0daf\u0dad\u0d9a\u0dca 1.26\u0db1\u0dca. \u0daf\u0dda \u0dca\u0d9a\u0dc3\u0daf\u0dda \u0daf\u0db1\u0d9a\u0dc0\u0dd0\u0dda\u0db4\u0dbb\u0dca 01\u0dc0\u0dd0\u0db1\u0dd2 \u0dd9\u0d9a \u0dd2\u0db1\u0da7 14 \u0dd9\u0d9a\u0dca\u0dc2\u0dc0\u0d9a \u0dc3\u0dd2\u0dba\u0d9a\u0dbb\u0dd2\u0dba \u0dc0 82,270\u0d9a\u0dca\u0dc2 \u0d82\u0dd2\u0dd2\u0d9a\u0dc0\u0da7 \u0d87\u0dc0\u0dd2 \u0db4\u0d82\u0d9a \u0dad\u0dd2\u0daf\u0db4\u0db1\u0dc0\u0d9a. \u0d9c\u0dd4\u0dc0 \u0dc0 \u0daf\u0dad\u0d9a\u0dd4\u0dc0\u0daf\u0dca\u0d9a\u0daf\u0dc5\u0dca \u0dad\u0dd2\u0daf\u0db4\u0db1 \u0d92 \u0dd2\u0dc0\u0dd4\u0dc5\u0dd4\u0dc0 \u0dc4\u0dbb\u0dc4\u0d9a \u0dad\u0dca\u0dba \u0daf\u0dd4\u0dbb\u0dd4 \u0db4\u0d82\u0dca\u200d\u0dbb \u0dbd\u0dbb\u0daf\u0d9c\u0db1 \u0dad\u0dd2\u0daf\u0db4 \u0dc0\u0daf \u0dc0 947\u0daf\u0dd9\u0db1\u0d9a\u0db1\u0dca. \u0d92 \u0d9a\u0dba\u0dba \u0dc0\u0daf \u0dc0, \u0dd2\u0db1\u0dba \u0dba \u0da7 1.15\u0d9a\u0dca\u0dc2. \u0d91\u0dad\u0daf\u0dd2\u0d9a\u0da7 \u0dbd\u0daf\u0d9c \u0dc3\u0dca\u0dad\u0dd4 03\u0dc0\u0dd0\u0db1\u0dd2 \u0dd9\u0d9a \u0dd2\u0db1\u0da7 \u0daf\u0dda \u0dd9\u0d9a\u0dca\u0dc2\u0dc0\u0d9a \u0dd2\u0d9a\u0d82\u0dba \u0dad\u0dd4\u0dc5 \u0dca\u0dd0\u0dd2\u0da7\u0dab\u0dd2 \u0dd2\u0db1\u0dba \u0dd4\u0dad \u0dc3\u0dd2\u0dba\u0d9a\u0dbb\u0dd2\u0dba \u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dca\u0d9a\u0dab\u0dba 604,669\u0db1\u0dca. \u0d92 \u0dd2\u0dc0\u0dd4\u0dc5\u0dd4\u0dc0 \u0dc4\u0dbb\u0dc4\u0d9a \u0dad\u0dca\u0dba \u0daf\u0dd4\u0dbb\u0dd4 \u0db4\u0d82\u0dca\u200d\u0dbb \u0dbd\u0dbb\u0daf\u0d9c\u0db1 \u0dad\u0dd2\u0daf\u0db4 \u0dc0\u0daf \u0dc0 7,195\u0daf\u0dd9\u0db1\u0d9a\u0db1\u0dca. \u0d91\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc1\u0dad\u0dba 1.19\u0db1\u0dca. \u0d92 \u0d9a\u0dba\u0dba \u0dc0\u0daf \u0dc0, \u0dc3\u0dd2\u0dba\u0d9a\u0dbb\u0dd2\u0dba \u0dc0\u0daf\u0d9c \u0dc0 \u0dd2\u0db1\u0dba \u0dba \u0da7 98.89\u0d9a\u0dca\u0dc2\u0dca \u0dad\u0dca\u0dba \u0daf\u0dd4\u0dbb\u0dd4 \u0db4\u0d82\u0dca\u200d\u0dbb \u0dbd\u0dbb\u0daf\u0d9c\u0db1 \u0db1\u0dd0\u0dc4\u0dd0. \u0daf\u0dda \u0dd2\u0d9a\u0d82 \u0dca\u0dad\u0dca\u0da0\u0dca\u0daf\u0dda\u0dd9\u0dba \u0dad\u0dd4\u0dc5 \u0daf\u0dda \u0dd2\u0dc0\u0dd4\u0dc5\u0dd4\u0dc0 \u0dc4\u0dbb\u0dc4\u0d9a \u0dbd\u0dc5\u0dd2 \u0d8b\u0dca\u0dba \u0d9a \u0dad\u0dd2\u0daf\u0db4\u0db1\u0dc0\u0d9a, \u0dbb\u0dd4\u0dc5\u0dd2\u0dba \u0db4 \u0dd2\u0da7\u0dd2\u0dba \u0db1 15\u0d9a\u0dca\u0dc2.\n\n\u0db4\u0d82\u0dca\u200d\u0dbb\u0dba \u0d9a\u0dca\u0dc2 \u0db1\u0dd2\u0d9a\u0dd4\u0dca \u0d9a\u0dba\u0dbb\u0dd3\u0dca \u0dc3 \u0dc4\u0d9a \u0dc3\u0d9a\u0dca\u0d9a\u0db1\u0dba\u0daf\u0dba \u0dc0 \u0dca\u0d9a\u0dc3\u0dba \u0dd2 \u0dd2\u0d9a\u0d82\u0dba \u0d9a\u0dca\u0dc2 \u0dc3 \u0dc4\u0d9a \u0d9c\u0dca\u0daf\u0dca \u0dbb\u0dd4\u0dc5\u0dd2\u0dba \u0db4 15,000\u0db1\u0dca. \u0dca\u0d9a\u0dc3\u0dba \u0dd2\u0da7 \u0dc0\u0dd0\u0da2\u0dd2 \u0dc4\u0d9a \u0dca\u0d9a\u0dc3 \u0daf\u0dd9\u0dd2\u0dd2 \u0dd2\u0d9a\u0d82 \u0dc3\u0dd3\u0dca\u0d9a\u0dc0\u0d9a\u0dca\u0dc2 \u0dc3 \u0dc4\u0d9a \u0dbb\u0dd4\u0dc5\u0dd2\u0dba \u0db4 21,000\u0db1\u0dca. \u0dca\u0d9a\u0dc3 2\u0da7 \u0dc0\u0dd0\u0da2\u0dd2 \u0dc3\u0dc4 \u0dca\u0d9a\u0dc3 6\u0dd2 \u0dd2\u0d9a\u0d82 \u0dc3\u0dd3\u0dca\u0d9a\u0dc0\u0d9a\u0dca\u0dc2 \u0dc3 \u0dc4\u0d9a \u0dbb\u0dd4\u0dc5\u0dd2\u0dba \u0db4 30,000\u0db1\u0dca. \u0dca\u0d9a\u0dc3 6\u0da7 \u0dc0\u0dd0\u0da2\u0dd2 \u0dc4\u0d9a \u0dca\u0d9a\u0dc3 12\u0dd2 \u0dd2\u0d9a\u0d82 \u0dc3\u0dd3\u0dca\u0d9a\u0dc0\u0d9a\u0dca\u0dc2 \u0dc3 \u0dc4\u0d9a \u0dbb\u0dd4\u0dc5\u0dd2\u0dba \u0db4 45,000\u0d9a\u0dca\u0dc2 \u0dc0\u0dc1\u0daf\u0dba \u0dc0 \u0d9c\u0d9a\u0dc3\u0dca\u0dad\u0dd4 \u0dbd\u0dba \u0d9a\u0dba\u0dbb\u0dd3\u0dda \u0dc3\u0dd2\u0daf\u0dc1 \u0db0\u0dca\u200d\u0db1\u0dba \u0dd2\u0dbb\u0d82\u0d9a, \u0dbd\u0d9c\u0dba \u0dc0\u0dd0\u0da2\u0dd2 \u0dd2\u0dbb\u0d82\u0d9a \u0dad\u0dd2\u0daf\u0db4\u0db1\u0dc0\u0d9a."
