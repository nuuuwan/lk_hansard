    "chunk_text": "\u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0b9a\u0bc1\u0b95\u0bbe\u0ba4\u0bbe\u0bb0 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0b95 \u0b92\u0bb0\u0bc1 \u0bae\u0bbf\u0b95\u0baa\u0bcd \u0ba4\u0baa\u0bbe\u0bbf \u0ba4\u0ba4\u0bbe\u0b95\u0b95 - 654 \u0baa\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf \u0ba9\u0bcd \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd - \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc0\u0b9f\u0bc1 \u0ba4\u0b9a\u0baf\u0bcd \u0baa\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0b95\u0bbe\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bae\u0bcd\u0baa\u0b95\u0bb3 \u0b95\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf \u0b9a\u0bbe\u0b95\u0bb2\u0baf\u0bc1\u0bae\u0bcd 400 \u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf \u0ba9\u0bcd \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bbf\u0bb2\u0bcd \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0ba4\u0b9a\u0baf\u0bcd \u0baa\u0bcd\u0baa\u0b9f\u0bb5\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.\n\n\u0d92\u0db4\u0dc0\u0daf\u0dc0\u0dda\u0dad\u0db4\u0dad\u0dad\u0db4\u0dad\u0dc0\u0dad\u0dca\u0db4\u0dc0\u0dd2\u0dc0\u0dc1\u0dca\u0db1\u0dc2\u0db4\u0dbb\u0daf\u0dbb \u0d9a\u0dca \u0db4\u0dc3\u0dcf\u0dc4\u0dcf\u0db1\u0dca\u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dba\u0db4\u0d95\u0dba\u0dd1.\u0db4\u0d9a\u0dbb\u0da9\u0db4\u0d9c\u0dd0\u0dcf\u0dd0\u0db1\u0dd2\u0d9a\u0dca \u0db4\u0dd2\u0dbb\u0d9a\u0daf\u0daf\u0db4\u0dc0\u0dd2\u0dd4\u0dc0 \u0daf\u0dc0\u0dbd\u0dd2\u0d9a\u0db4\u0daf\u0dad\u0dca\u0db4\u0d9c\u0db8\u0dca\u0dc0\u0db4\u0db1\u0dba\u0daf \u0db4\u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca \u0dc1\u0dca\u0dc0\u0d86\u0db4\u0dca\u0dad\u0dca\u0dad\u0daf\u0db4\u0daf\u0dd2\u0dca\u0dd4\u0dc0\u0dca \u0dc2\u0dd2\u0db4\u0da2\u0dcf\u0d9a\u0dbb\u0dad\u0dca\u0dba\u0db4\u0dad\u0dcf\u0dad\u0dca\u0db8\u0dd2\u0d9a,\u0db4\u0db4\u0db1\u0dba\u0dc3\u0dd4\u0d9c\u0dd2\u0d9a\u0db4\u0dbb\u0daf\u0daf\u0dc0\u0d86\u0db4\u0dc0\u0dca \u0dc1\u0dca\u0db4\u0db1\u0dba\u0daf\u0daf\u0dba\u0da5\u0d9a\u0db1\u0dca\u0db4\u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0db4\u0db6\u0daf\u0dcf\u0dad\u0dca\u0dbb\u0daf\u0dbb\u0dc0\u0d9a\u0db1\u0dca\u0db4\u0d85\u0dca\u0daf\u0daf\u0dc0\u0d9c\u0dba\u0db4\u0dc4\u0dd2\u0da7\u0db4\u0dd4\u0db4\u0dd4\u0dc0\u0db4\u0dd2\u0d9a\u0dca\u0db4\u0dc0\u0dbb\u0ddd\u0dc0\u0dcf\u0db4]11\u0dbb\u0db4\u0dc0\u0dca \u0dc0\u0db4\u0db1\u0dba\u0daf \u0dca \u0db4\u0dbb\u0da2\u0dcf\u0d9a\u0da7,\u0db4\u0db6\u0dd4\u0dca \u0db0\u0dca\u200d\u0dc1\u0dca\u0daf\u0dc3\u0dcf\u0dba,\u0db4\u0dca\u0d9c\u0db8\u0dd2\u0dbb\u0db4\u0dc3\u0dcf\u0dcf\u0db4\u0dc3\u0dcf\u0dc3\u0dc3\u0dcf\u0db1\u0dbb\u0dd8\u0dad\u0dd2\u0dc3\u0dbb\u0db4\u0dbb\u0da7\u0dd4\u0dad\u0dd4 \u0db4\u0d85\u0dad\u0daf\u0dad\u0dba\u0daf\u0dc3\u0dc1\u0dca\u0d9a\u0da7\u0db4\u0daf\u0db6\u0daf\u0db4\u0d9c\u0db1\u0dca\u0dba\u0db4\u0dbb\u0da7\u0dd4\u0dad\u0dd4 \u0db4\u0dbb \u0daf.\u0db4\u0d91\u0dd4 \u0db8\u0dd2\u0d9a\u0da7\u0db4\u0d85\u0db4\u0dd2\u0db4\u0dc0\u0db8\u0dca\u0db4\u0db4\u0db1\u0dba\u0daf\u0dbb\u0dca\u0dbd\u0dd2\u0dc0\u0db8\u0dca\u0db1\u0dca\u0dd4 \u0dc0 \u0daf\u0dd3\u0db4\u0dc3\u0dcf\u0db1\u0dd4 \u0dad\u0dd2\u0dc3\u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dba\u0db4\u0d95\u0dba\u0dd1.\u0db4\u0d91\u0dd4 \u0db8\u0dd2\u0d9a\u0dc0\u0dda\u0db4\u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0d9a\u0db4\u0d85\u0dba\u0dd4 \u0dbb\u0dbb\u0db4\u0dad\u0dd2\u0dc3\u0db4\u0db6\u0dd2\u0d9a\u0daf\u0dd3\u0dad\u0dca\u0db4\u0dbb\u0da2\u0dcf\u0dc0\u0d86\u0db4\u0dc4\u0dd2\u0da7\u0db4\u0dd4\u0db4\u0d85\u0d9c\u0dad\u0dd0\u0dad\u0dd2\u0dc3\u0dc0\u0dd4\u0dc0,\u0db4\u0d87\u0dad\u0dad\u0dd2\u0dc3\u0dc0\u0dd4\u0dc0\u0db4\u0d91\u0dca \u0dbb\u0db4\u0dad\u0dbb\u0d9c\u0db4\u0dbb\u0dbb\u0daf\u0daf\u0db4\u0da2\u0dcf\u0d9a\u0dca\u200d\u0dcf \u0d9a\u0db4\u0dbb\u0dbb\u0daf\u0daf,\u0db4\u0db6\u0dd4\u0dca \u0db0\u0dca\u200d\u0dc1\u0dca\u0daf\u0dc3\u0dcf\u0dba,\u0db4\u0dca\u0d9c\u0db8\u0dd2\u0dbb\u0db4\u0dc3\u0dcf\u0dcf\u0db4\u0dc3\u0dcf\u0dc3\u0dc3\u0dcf\u0db1\u0dbb\u0dd8\u0dad\u0dd2\u0dc3\u0dbb\u0db4\u0dbb\u0da7\u0dd4\u0dad\u0dd4 \u0db4\u0d85\u0dad\u0daf\u0dad\u0dba\u0daf\u0dc3\u0dc1\u0dca\u0d9a\u0da7\u0db4\u0d85 \u0db4\u0db4\u0d92\u0db4\u0dc0\u0dca \u0dc0\u0db4\u0db1\u0dba\u0daf \u0db4\u0d9a\u0dc5\u0dd2\u0db4\u0db4\u0db1\u0dba\u0dc0\u0dbb\u0daf\u0db4\u0daf\u0dd3\u0daf\u0daf\u0db4\u0dad\u0dd2\u0dc3\u0dc0\u0db6\u0dba\u0dc0\u0daf.\u0db4\u0d92\u0db4\u0d9c\u0dd0\u0dba\u0db4\u0d87\u0dad\u0dca\u0dad\u0da7\u0dad\u0db4\u0d85\u0db4\u0dd2\u0db4\u0dc3\u0dcf\u0db1\u0dca\u0dc0\u0dad\u0ddd\u0dc2\u0db4\u0dc0\u0dc0\u0db1\u0dca\u0dba\u0db4\u0d95\u0dba\u0dd1.\u0db4\u0dbb\u0da2\u0dcf\u0dc0\u0d86\u0db4\u0db1\u0dd2\u0daf\u0db0\u0dca\u200d\u0daf\u0dbb\u0dd2\u0dc0\u0d9a\u0dca \u0db4\u0dc0\u0dd2\u0db0\u0dd2\u0d9a\u0da7\u0db4\u0d91\u0dc0\u0dc3\u0dcf\u0db1\u0db4\u0dbb\u0da7\u0dd4\u0dad\u0dd4 \u0db4\u0dd2\u0dbb\u0dd3\u0db8\u0dad\u0db4\u0d9c\u0dd0\u0dba\u0db4\u0d91\u0dad\u0db4\u0dc0\u0dca\u0dbb\u0db8\u0dca\u0dd4 \u0db8\u0dd2\u0d9a\u0da7\u0db4\u0d85\u0db4\u0dd2\u0db4\u0dc3\u0dcf\u0db1\u0dd4 \u0dad\u0dd2\u0dc3\u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dba\u0db4\u0d95\u0dba\u0dd1.\u0db4"
  },
