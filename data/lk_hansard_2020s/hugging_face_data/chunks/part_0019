    "chunk_text": "\u0d9f\u0dc5\u0db4 \u0dd2\u0d9a\u0dbb\u0dab\u0dba , \u0dbd\u0dca\u0da7 \u0dbd\u0dca\u0dad\u0dd2\u0dd9, \u0dc0\u0dd2\u0dca\u0d9a\u0dca\u0dc2\u0dc2\u0dba \u0da7 \u0dbd\u0dca\u0dad\u0dd2\u0dd9 \u0d9a\u0dba\u0dba \u0db1 \u0d91\u0dd2. \u0dbd\u0dca\u0d82\u0d9a\u0dc3\u0db1\u0d9a\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0dca \u0dc0\u0dd3\u0dad\u0dd4\u0dca\u0db1\u0dd2, \u0dbd\u0dc5\u0dd2 2026 \u0dc0\u0dbb\u0dca\u0dc2\u0dba \u0da7 \u0dbd\u0dd9\u0d9a\u0dc5\u0dc0 \u0dad\u0dca\u0db1\u0dca \u0daf\u0dda \u0dbd\u0dba \u0dc0\u0dd0\u0dba \u0dca\u0daf\u0dd2\u0dad\u0dca\u0dca\u0dca \u0dd2\u0dbb \u0dc0\u0daf \u0dc0. \u0dbd\u0dba \u0dc0\u0dd0\u0dba \u0dc0\u0d9a\u0dbb \u0d9c\u0dab\u0db1 \u0d9c\u0dca\u0daf\u0dad\u0d9a\u0dca, \u0dca\u0daf\u0dda \u0dd9\u0dd0\u0db1\u0dd4\u0daf\u0dda \u0dc4\u0dd0\u0dd2\u0dba \u0da7 \u0daf\u0dda \u0daf\u0dda \u0dbb\u0daf \u0d94 80\u0daf\u0dc0\u0db1\u0dd2 \u0dbd\u0dba \u0dc0\u0dd0\u0dba \u0daf\u0dba \u0da2\u0db1\u0d9a\u0dc0\u0dd2\u0dba , \u0d91\u0daf\u0dc4\u0dca \u0db1\u0dd0\u0dca\u0db1\u0dda \u0dc0\u0dd2\u0dc3\u0dbb\u0dca\u0da2\u0db1 \u0dca\u0db1\u0dca \u0daf\u0dd2\u0dd4\u0dc0\u0dda\u0dca\u0dad \u0dad\u0dca\u0db1\u0dca \u0dca\u0d9a\u0dbb\u0dca\u0dd2\u0daf\u0dda \u0dc0\u0dad\u0dd4\u0dc0\u0da7 \u0dca\u0daf\u0dd2\u0dad\u0dca\u0dca\u0dca \u0dc0 \u0dc0\u0daf \u0dc0. 79\u0daf\u0dc0\u0db1\u0dd2 \u0dbd\u0dba \u0dc0\u0dd0\u0dba \u0daf\u0dba \u0da2\u0db1\u0d9a\u0dc0\u0dd2\u0dba \u0dca\u0daf\u0dd2\u0dad\u0dca\u0dca\u0dca \u0dd2\u0daf\u0dc5\u0dca\u0dca \u0dbd\u0dc5\u0dd2. \u0dc4\u0dd0\u0db4\u0dd0\u0db1\u0dca, 1 \u0dd2\u0db1\u0da7 78 \u0dd9\u0d9a\u0dca\u0dc2\u0dc0\u0d9a \u0dbd\u0dba\n\n\u0dc0\u0dd0\u0dba \u0daf\u0dba \u0da2\u0db1\u0d9a \u0dca\u0daf\u0dd2\u0dad\u0dca\u0dca\u0dca \u0dd2\u0dbb\u0d82\u0d9a \u0dad\u0dd2\u0daf\u0db4 \u0dc0\u0daf \u0dc0 \u0dc0\u0dd2\u0dca\u0d9a\u0dca\u0dc2\u0dc2\u0daf\u0dba \u0dc0. \u0d92 \u0dbd\u0dba \u0da7 \u0dbd\u0dca\u0dad\u0dd2\u0db1\u0dca, 2023 \u0dc0\u0dbb\u0dca\u0dc2\u0daf\u0dda \u0dc3\u0dd0\u0dca\"\u0dad\u0dd0\u0dda\u0db4\u0dbb\u0dca \u0dca\u0d9a\u0dc3\u0dba \u0dc0\u0dd2\u0dad\u0dbb \u0daf\u0dc0\u0db1\u0dd2\u0dda \u0daf\u0dda \u0dbb\u0daf \u0d94 \u0dca\u0d9a\u0d82\u0db1 \u0db4\u0d82\u0dba \u0daf\u0dc4\u0db4\u0dc0\u0dd6\u0daf\u0dda \u0d92 \u0dbd\u0dba \u0d9a\u0dba\u0dba \u0d82\u0d9a.\n\n\u0dca \u0dc0\u0db1 \u0dca\u0daf\u0dc4\u0d9a\u0dca \u0dbb\u0da7\u0dd2 \u0dad\u0dca\u0db1\u0dca \u0daf\u0dda \u0dc0\u0dd2\u0dca\u0d9a\u0dca\u0dc2\u0dc2\u0daf\u0dda \u0dbd\u0dba \u0dc0\u0dd0\u0dba \u0dd2\u0dae\u0d9a \u0dca\u0daf\u0dd2\u0dad\u0dca\u0dca\u0dca \u0dd2\u0dbb \u0dc0\u0db1 \u0dca\u0da7 \u0dc0 \u0d9c\u0dca\u0daf\u0dca. \u0dc4\u0dd0\u0db4\u0dd0\u0db1\u0dca \u0dca\u0dc0\u0dd4 \u0dc0\u0daf\u0dda 75\u0dc0\u0dd0\u0db1\u0dd2, 76\u0dc0\u0dd0\u0db1\u0dd2, 77\u0dc0\u0dd0\u0db1\u0dd2 \u0dbd\u0dba \u0dc0\u0dd0\u0dba \u0dd2\u0dae\u0d9a \u0dca\u0daf\u0dd2\u0dad\u0dca\u0dca\u0dca \u0dd2\u0dbb\u0db1\u0daf\u0dd2\u0d9a\u0da7 \u0daf\u0dda \u0dbb\u0da7 \u0dad\u0dd2\u0db6\u0dd4\u0daf\u0da9\u0dbd \u0daf\u0dd2\u0d9a\u0dad\u0dd0\u0db1\u0dd9? \u0dbd\u0dc5\u0dd2 \u0dd9 \u0dc0\u0db1\u0dc0\u0d9a, \u0dab\u0dba \u0daf\u0d9c\u0dc0\u0d9a\u0d9c \u0dc0\u0db1 \u0db4\u0dd0\u0dad\u0dca\u0dc0 \u0dc4\u0dad\u0dbb \u0dbd\u0daf\u0dca \u0dab\u0dba \u0daf\u0dc0\u0d82\u0d9a, \u0dbb\u0daf \u0d94 \u0dbd\u0dca\u0dd2\u0dd2 \u0dbd\u0dc0\u0dc1\u0dba\u0dad\u0d9a\u0dc0\u0dca \u0dc3\u0db4\u0dd4\u0dbb\u0d9a\u0d9c \u0dc0\u0db1 \u0db4\u0dd0\u0dad\u0dca\u0dc0, \u0d92 \u0dc3 \u0dc4\u0d9a\u0dc0\u0dca \u0dc3 \u0db4\u0dd2 \u0daf\u0dc4\u0d9a\u0dba \u0d9a\u0d9c \u0dc0\u0db1 \u0db4\u0dd0\u0dad\u0dca \u0dbb\u0da7\u0d9a\u0dca\u0dc2 \u0db4\u0dc0\u0da7 \u0d92 \u0dbd\u0dc0\u0dc3\u0d9a\u0db1 \u0dbd\u0dba \u0dc0\u0dd0\u0dba \u0dd2\u0dae\u0d9a\u0dc0 \u0dca\u0daf\u0dd2\u0dad\u0dca\u0dca\u0dca \u0dd2\u0dbb\u0db1\u0daf\u0dd2\u0d9a\u0da7\u0dca \u0dc0\u0dd2\u0dca\u0d9a\u0dca\u0dc2\u0dc2\u0dba \u0dc0\u0dd2\u0dd2\u0db1 \u0dc0 \u0daf\u0dda \u0dbb\u0da7 \u0dca\u0dca \u0dd2\u0dbb\u0d82\u0d9a \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0d9a \u0d9a\u0dba\u0dba \u0d82\u0d9a. \u0dd2\u0da7\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4 \u0dc3\u0dd3\u0dd2\u0da7\u0dad \u0dc3\u0dda\u0dca\u0dca\u0dc0\u0dd2 \u0dc0 \u0dbd\u0dc0\u0dc1\u0dba\u0dad\u0d9a \u0dc3\u0db4\u0dd4\u0dbb\u0d9a\u0d9c \u0dc0\u0db1 \u0d9c\u0dd2\u0dc4\u0dd2 \u0db4\u0d82\u0d9a, \u0daf\u0dca \u0dd2\u0dda\u0dc0\u0d82 \u0dc5\u0dad\u0dd0\u0daf\u0dc0\u0d82\u0d9a \u0d91\u0d9a\u0dba\u0daf\u0db1\u0dd2\u0d9a \u0dbb\u0da9\u0dbd\u0da9\u0dd4 \u0daf\u0dc0 \u0dc0\u0db1 \u0dca\u0da7 \u0dc0\u0d9c\u0dca\u0dad\u0d9a. \u0d91\u0daf\u0dc4\u0d9a\u0dca \u0dad\u0dca\u0dca\u0dc0\u0dba \u0dd2\u0da7 \u0dad\u0dca\u0db1\u0dca \u0dc0\u0dd2\u0dca\u0d9a\u0dca\u0dc2\u0dc2\u0daf\u0dda \u0dca\u0dc5\u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd2 \u0dbd\u0dba \u0dc0\u0dd0\u0dba \u0dd2\u0dae\u0d9a\u0daf \u0dca \u0d82\u0d9a \u0dbd\u0dc0\u0dc3 \u0dc0 \u0dbd\u0dba \u0dc0\u0dd0\u0dba \u0dd2\u0dae\u0d9a\u0dc0 \u0dd9\u0d9a\u0dca\u0dc2\u0dc0\u0d9a \u0dbd\u0dba \u0dc0\u0dd0\u0dba \u0dd2\u0dae\u0d9a\u0dc0 \u0dd2\u0dbb\u0db1\u0daf\u0dd2\u0d9a\u0da7 \u0dbd\u0daf\u0dca\" \u0dbb\u0da7 \u0dca\u0dca \u0dd2\u0dbb\u0d82\u0d9a \u0dad\u0dd2\u0db6\u0dd4\u0daf\u0da9\u0dbd. \u0dc4\u0dd0\u0db4\u0dd0\u0db1\u0dca, \u0dd9\u0dd0 \u0dc0 \u0dca\u0dc0\u0dd4 \u0dc0 \u0dca\u0d9a\u0dbb \u0dd2\u0dae\u0d9a \u0d9a\u0dba\u0dba \u0db1\u0dc0\u0d9a. \u0daf\u0dda \u0daf\u0dda\u0dc0 \u0db4 \u0dd2\u0dbb \u0dc0\u0db1 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0d9a \u0dd4\u0dad, \u0daf\u0dda \u0daf\u0dda\u0dc0 \u0db4 \u0dbd\u0dc5\u0dd2 \u0dd2\u0dbb \u0dc0\u0daf \u0dc0 \u0db1\u0dd0\u0dad\u0dd2 \u0dd4\u0dad, \u0dad\u0dc0 \u0daf\u0dda\u0dc0 \u0db4 \u0dd2\u0dbb \u0dc0\u0db1 \u0dad\u0dd2\u0daf\u0db4\u0db1\u0dc0\u0d9a \u0dd4\u0dad, \u0dca\u0daf\u0dc4\u0d9a\u0dca \u0daf\u0db1\u0d9a\u0daf\u0dc0\u0db1\u0dca \u0dd4\u0dad \u0dd2\u0dbb \u0dc0\u0db1 \u0d95\u0db1\u0dd1 \u0dc0\u0d9a\u0daf\u0dda \u0daf\u0d82\u0d9a\u0d9a\u0dd4 \u0dd2\u0dad \u0dc0\u0dd9\u0dbb \u0daf\u0d9c\u0d9a\u0dba\u0d9a\u0dca\u0dc2 \u0dd9\u0dd0 \u0dc0 \u0daf\u0dda \u0dbd\u0dba \u0d9a\u0dba\u0dba \u0db1\u0dc0\u0d9a. \u0dc4\u0dd0\u0db4\u0dd0\u0db1\u0dca \u0d92 \u0dbd\u0dba \u0da7 \u0dbd\u0dca\u0dad\u0dd2\u0db1\u0dca, \u0d92 \u0dbd\u0dba \u0daf\u0dda \u0dd2\u0d9a\u0d82\u0dba \u0dad\u0dd4\u0dc5 \u0d92 \u0daf\u0dda\u0dc0 \u0db4 \u0daf\u0db1\u0d9a\u0dd2\u0daf\u0dc5\u0dca \u0d87\u0db1\u0dca \u0d9a\u0dba\u0dba \u0d82\u0d9a."
