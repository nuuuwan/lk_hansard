    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0d87\u0db8\u0dd6 \u0dd4\u0db8\u0dcf \u0d8a\u0dc0\u0dc4 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf, \u0dc0\u0db4\u0dcf\u0dd3\u0dc3\u0dba \u0d92 \u0db6\u0dd4\u0daf\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db8\u0dba \u0d89\u0dc0\u0dca \u0d9a\u0dc0\u0dc5\u0dca \u0d86\u0dbb\u0d9a\u0dca \u0dcf\u0dc0\u0da7\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d9a\u0dcf\u0dbb\u0dab\u0dcf\u0dc0 \u0dc0\u0dda\u0d9a\u0dba\u0dd2. \u0d85\u0db4\u0da7 \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0dad\u0dbb\u0dca\u0dbd\u0da2\u0db1\u0dba\u0d9a\u0dca \u0dd6 \u0db6\u0dd4\u0dc0\u0dab\u0dcf\u0dca \u0d85\u0db4\u0dd2 \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0db4\u0dcf\u0dd3\u0dc3\u0dc0\u0dc4 \u0db1\u0dad\u0dbb \u0dc0\u0dc0\u0db1\u0dc0\u0dcf\u0daf? \u0d91\u0dc0\u0dc4\u0db8 \u0db1\u0dd0\u0dca\u0db1\u0dda \u0dc0\u0dc0\u0db1\u0dca \u0d9a\u0dcf\u0da7\u0dc4\u0dbb\u0dd2 \u0dad\u0dbb\u0dca\u0dbd\u0da2\u0db1\u0dba\u0d9a\u0dca \u0dd6 \u0db6\u0dd4\u0dc0\u0dab\u0dcf\u0dca \u0d92 \u0dad\u0dbb\u0dca\u0dbd\u0da2\u0db1 \u0dd6 \u0dc0\u0db6\u0db1 \u0d9a\u0da7\u0dca\u0da7\u0dd2\u0dba \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0db4\u0dcf\u0dd3\u0dc3\u0dc0\u0dc4 \u0db1\u0dc0\u0dcf\u0dad\u0dd0\u0db1\u0dca\u0dad \u0d9c\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf\u0daf? \u0db6\u0dd4\u0daf\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db8\u0dba \u0dd6 \u0db6\u0dd4\u0dab\u0dd4 \u0dad\u0dd0\u0db1\u0da7 \u0d86\u0dbb\u0d9a\u0dca \u0dcf\u0dc0 \u0dc0\u0db1\u0dcf\u0daf\u0dd3, \u0db6\u0dd4\u0daf\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db8\u0dba \u0d86\u0dbb\u0d9a\u0dca \u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db6\u0dd4\u0daf\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db8\u0dba \u0d9c\u0dbd\u0dc0\u0dbd\u0dcf \u0dc0\u0db4\u0dcf\u0dd3\u0dc3\u0dba\u0da7 \u0d85\u0dbb\u0dc0\u0d9c\u0db1 \u0dba\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0db8\u0dcf\u0dbb \u0dc0\u0da2\u0dc6\u0dd2 \u0db1\u0dba\u0dcf\u0dba\u0d9a\u0dca. \u0d91\u0dba \u0d89\u0dad\u0dcf \u0dc0\u0dd2\u0dc4\u0dd2\u0dc5\u0dd4\u0dc3\u0dc4\u0d9c\u0dad \u0d9a\u0dcf\u0dbb\u0dab\u0dcf\u0dc0\u0d9a\u0dca. \u0db6\u0dd0\u0dbb\u0dd2 \u0dc0\u0dc0\u0dbd\u0dcf \u0dc0\u0dc4\u0ddd \u0dc3\u0dd3\u0d9c\u0dd2\u0dbb\u0dd2\u0dba \u0dc0\u0dcf\u0dc0 \u0dad\u0dd0\u0db1\u0d9a\u0da7 \u0dad\u0dbb\u0dca\u0dbd\u0da2\u0db1\u0dba\u0d9a\u0dca \u0d87\u0dd6 \u0dc0\u0dd4\u0dab\u0dd4 \u0daf\u0dcf\u0da7 \u0dc0\u0db8\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dcf \u0dc0\u0db8\u0dcf\u0db1 \u0dc0\u0dcf\u0dc0 \u0db4\u0dd2\u0dba\u0dc0\u0dbb\u0d9a\u0dca \u0d9c\u0da7 \u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0db4\u0da7 \u0dc4\u0dd2\u0dc0\u0dad\u0db1\u0dc0\u0dcf.\n\n\u0dbd\u0dc3\u0db1\u0dca\u0dad\u0dad \u0db8\u0dd0\u0dd6 \u0dd4\u0db8\u0dcf\u0da7 \u0dd6 \u0db6\u0dd4\u0dab\u0dd4 \u0dc0\u0dbd\u0dcf\u0d9a\u0dd4\u0db8 \u0dc0\u0da0\u0ddd\u0daf\u0db1\u0dcf\u0dc0 \u0dc0\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0daf? \u0d91\u0dd4\u0db8\u0dcf IRC registered \u0d85\u0db4\u0dbb\u0dcf\u0db0\u0d9a\u0dcf\u0dbb\u0dc0\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0d91\u0dd4\u0db8\u0dcf\u0da7 \u0daf\u0dd0\u0db1\u0da7 \u0db1\u0dda \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0dd6 \u0dc0\u0db6\u0db1\u0dc0\u0dcf \u0db1\u0dda, \u0d91\u0dd4\u0db8\u0dcf \u0d92\u0dc0\u0dcf\u0dc0\u0dc4 \u0dc3\u0dd0\u0d9a\u0d9a\u0dbb\u0dd4\u0dc0\u0dc0\u0d9a\u0dd4 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7\u0dba\u0dd2 \u0d9c\u0dd0\u0dc0\u0db1\u0db1\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dad. \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dad, \u0d91\u0dd4\u0db8\u0dcf \u0dc0\u0dd0\u0dbb\u0dd0\u0daf\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0dc0\u0d9a\u0dd4\n\n499 500\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc0\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0dc0\u0dc0\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0. IRC registered \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dc0\u0dd4\u0daf? \u0db8\u0dcf\u0dca \u0db4\u0dc3\u0dd4\u0dc0 \u0dad\u0db8\u0dba\u0dd2 \u0d91\u0dba \u0daf\u0dd0\u0db1 \u0d9c\u0dca\u0dc0\u0dca. \u0d91\u0d9a\u0db8 \u0d86\u0d9a\u0dcf\u0dbb\u0dc0\u0dc4 \u0dc0\u0dd0\u0dbb\u0dd0\u0daf\u0dd2 \u0dd4\u0db1\u0d9a\u0dca \u0d91\u0d9a \u0dc5\u0d9f \u0d9a\u0dbb\u0dbd\u0dcf \u0dd6 \u0db6\u0dd4\u0dc0\u0dab\u0dcf\u0dca, \u0d94\u0dc4\u0dd4 IRC \u0d91\u0dc0\u0d9a\u0dca register \u0dc0\u0dc0\u0db1\u0dc0\u0dcf. \u0db8\u0dcf \u0d92 \u0d9c\u0dd0\u0db1 \u0dc0\u0dc3\u0dcf\u0dba\u0dcf \u0db6\u0dd0\u0dd4\u0dc0\u0dcf. \u0dc0\u0dc0\u0dbd\u0dcf \u0dd6 \u0dc0\u0db6\u0db1\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dad \u0dc0\u0dda\u0d9a\u0dba\u0dd2. \u0d9a\u0dd4\u0da9\u0dcf \u0daf\u0da9\u0dba\u0d9a\u0dca \u0dc0\u0daf\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0dd4\u0db1\u0d9a\u0da7 \u0dc3\u0dd0\u0d9a \u0db4\u0dd2\u0da7 \u0d85\u0dca\u0d85\u0da9\u0d82\u0d9c\u0dd4\u0dc0\u0da7 \u0d9c\u0dca\u0dad\u0dcf\u0db8, \u0d91\u0dd4\u0db8\u0dcf\u0da7 \u0d8b\u0db4\u0dc0\u0daf\u0dc3\u0dca \u0daf\u0dd3\u0dbd\u0dcf \u0dd6 \u0dc0\u0db6\u0db1\u0dc0\u0dcf, \u0d94\u0dba \u0dc0\u0db4\u0dcf\u0da9\u0dd2 \u0daf\u0da9\u0dba \u0dc0\u0d9c\u0dda\u0dc0\u0dcf \u0db1\u0dda \u0d94\u0dba \u0db1\u0dda\u0dc0 \u0d89\u0dc0\u0dca \u0dc0\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d92 \u0d8b\u0db4\u0dc0\u0daf\u0dc3 \u0d85\u0db1\u0dd4\u0dc0 \u0dad\u0db8\u0dba\u0dd2 \u0d91\u0dd4\u0db8\u0dcf \u0d92 \u0daf\u0da9\u0dba \u0dc0\u0d9c\u0dc0\u0dbd\u0dcf \u0dc0\u0dd0\u0dbb\u0dd0\u0dda\u0daf \u0db4\u0dd2\u0dc5\u0dd2\u0dc0\u0d9c\u0db1 \u0dd6 \u0dc0\u0db6\u0db1\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dad. \u0d92 , \u0dc3\u0dcf \u0dad\u0db8\u0dba\u0dd2 IRC registered \u0dc0\u0dc0\u0dbd\u0dcf \u0dd6 \u0dc0\u0db6\u0db1\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dad. \u0d91\u0dc0\u0dc4\u0db8 \u0db1\u0dd0\u0dd4\u0dc0 \u0d94\u0db6\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dcf \u0dc4\u0d82\u0dc0\u0dda \u0d9c\u0dc4\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0db8\u0dc4\u0dcf \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0dab\u0dc0\u0dc4 \u0d9a\u0dd2\u0dc3\u0db8 \u0dc0\u0daf\u0dba\u0d9a\u0da7 \u0dc0\u0db1\u0dcf\u0dc0\u0dc0\u0dba\u0dd2 \u0d91\u0dd4\u0db8\u0dcf IRC registered \u0dc0\u0dc0\u0dbd\u0dcf \u0dd6 \u0dc0\u0db6\u0db1\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dad. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dc0\u0dda \u0dbb\u0dc0\u0da7\u0dca \u0dc0 , \u0dc3\u0dd4\u0db1\u0dca\u0dad\u0da7 \u0d91\u0dd4\u0db8\u0dcf \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc0\u0dba\u0db1\u0dca\u0dad \u0d92\u0dca\u0dd4 \u0d9c\u0dd0\u0db1\u0dca\u0dad\u0dc0\u0dd6\u0dc0\u0dc4 IRC \u0dd4\u0db1\u0dca\u0dad\u0dc0\u0db1 \u0dc0\u0dc1\u0dca\u200d\u0dbb\u0dca\u0dab\u0dd2\u0dc0\u0dc4 \u0d85\u0db4\u0dbb\u0dcf\u0db0\u0d9a\u0dcf\u0dbb\u0dc0\u0dba\u0d9a\u0dd4 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7\u0dba\u0dd2. \u0d94\u0dc4\u0dd4 \u0dc0\u0dbb\u0daf \u0db4\u0dd2\u0dc5\u0dd2\u0dc0\u0d9c\u0db1 \u0dc0\u0db6\u0dcf\u0dc0\u0dc4\u0dcf\u0db8 \u0dc0\u0db4\u0dcf\u0da9\u0dd2 \u0daf\u0da9\u0dba\u0d9a\u0dca \u0dc0\u0d9c\u0dc0\u0dbd\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0d91\u0db8 \u0db1\u0dda\u0dc0\u0dc0\u0db1\u0dca\u0dad \u0d89\u0dc0\u0dca \u0dc0\u0dc0\u0dbd\u0dcf \u0dd6 \u0dc0\u0db6\u0db1\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dad. \u0d92\u0dc0\u0d9a\u0dca register \u0dc0\u0dc0\u0dbd\u0dcf \u0dd6 \u0dc0\u0db6\u0db1 , \u0dc3\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0dc0\u0db8\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dcf \u0dc0\u0dda \u0dc4\u0d82\u0dc0\u0dda \u0d9c\u0dc4\u0db1\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dad."
  },
