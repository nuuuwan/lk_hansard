    "chunk_text": "\u0dbb\u0dbb\u0daf\u0daf\u0db4\u0dad\u0dd2\u0dc3\u0dc0\u0db6\u0dba\u0dc0\u0daf.\u0db4\u0d92\u0db4\u0dc0\u0daf\u0dc0\u0dda\u0dad,\u0db4\u0d85\u0d9b\u0da9\u0dd4\u0d9a\u0da9\u0db4\u0dc0\u0dc0 \u0dba\u0db4\u0dc3\u0dcf\u0dd0\u0db4\u0db1\u0dba\u0dd4\u0dad\u0db8\u0dca\u0db4\u0dc3\u0dcf\u0dc4\u0dcf\u0daf\u0db4\u0d96\u0dc2\u0db0\u0dca\u200d\u0db4\u0dc3\u0dcf\u0dcf\u0db4\u0d8b\u0db4\u0db1\u0dba\u0dbb\u0dbb \u0db4\u0dc3\u0dcf\u0dd0\u0db4\u0db1\u0dba\u0dba\u0dd3\u0dad\u0db4\u0dc0\u0dc0\u0dc0 \u0dc0\u0dc0\u0db1\u0dca\u0db4\u0dd4\u0dc0\u0db4\u0dd2\u0d9a\u0dca\u0db4\u0db6\u0dd2\u0dbd\u0dd2\u0d9a\u0dba\u0db4]07.7\u0dca \u0db4\u0dc0\u0dc0\u0db1\u0dca\u0db4\u0dbb\u0dbb\u0daf\u0daf\u0db4\u0dad\u0dd2\u0dc3\u0dc0\u0db6\u0dba\u0dc0\u0daf.\u0db4\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dc0\u0db4\u0db1\u0dba\u0ddd\u0dc2\u0db4\u0dc3\u0dcf\u0dcf\u0db4\u0dc0\u0db4\u0db1\u0dba\u0ddd\u0dc2 \u0db4\u0dc0\u0dd0\u0da9\u0dc3\u0dcf\u0da7\u0dcf\u0db1\u0dca\u0db4\u0dc0\u0dc0\u0dc0 \u0dc0\u0dc0\u0db1\u0dca\u0db4\u0dd4\u0dc0\u0db4\u0dd2\u0d9a\u0dca\u0db4\u0db6\u0dd2\u0dbd\u0dd2\u0d9a\u0dba\u0db4]2.9\u0dca \u0db4\u0dcf\u0daf\u0db4\u0dc0\u0dbb\u0ddd\u0d9c\u0db4\u0dc0\u0dd0 \u0dd0\u0dca \u0dc0\u0dd3\u0dc0\u0db8\u0dca\u0db4\u200d\u0dbb\u0dad\u0db4\u0dc0\u0dc0\u0dc0 \u0dc0\u0dc0\u0db1\u0dca\u0db4\u0dd4\u0dc0\u0db4\u0dd2\u0d9a\u0dca\u0db4\u0db6\u0dd2\u0dbd\u0dd2\u0d9a\u0dba\u0db4]1.4\u0dca \u0db4\u0dc0\u0dc0\u0db1\u0dca\u0db4\u0dbb\u0dbb\u0daf\u0daf\u0db4\u0dad\u0dd2\u0dc3\u0dc0\u0db6\u0dba\u0dc0\u0daf.\u0db4\u0d92\u0db4\u0dc0\u0daf\u0dc0\u0dda\u0dad,\u0db4\u0dc0\u0daf\u0ddd\u0dbb\u0d9a\u0db4\u0dbd\u0dc3\u0dcf\u0db1\u0dc3\u0dcf\u0dbb\u0dcf\u0da7\u0db4\u0d9a\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db4\u0db4\u0db1\u0dba\u0dbb\u0dca\u0dc0\u0d86\u0dc2 \u0db4\u0dc3\u0dcf\u0dcf\u0db4\u0dc3\u0dcf\u0dc3\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0dba\u0db4\u0dc0\u0dd0\u0da9\u0dc3\u0dcf\u0da7\u0dcf\u0db1\u0dca\u0dc0\u0dbd\u0dd2\u0db1\u0dca.\u0db4\u0d92\u0db4\u0db1\u0dd2\u0dc3\u0dcf\u0daf\u0db4\u0dc0\u0dc3\u0dcf\u0dde\u0d9b\u0dba\u0db4\u0db4\u0db1\u0dba\u0dbb\u0dca\u0dc0\u0d86\u0dc2 \u0db4\u0dcf\u0daf\u0db4\u0dc3\u0dcf\u0dc3\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0dba\u0d9a\u0db4\u0dc0\u0dc0\u0dc0 \u0dc0\u0dc0\u0db1\u0dca\u0db4\u0dd4\u0dc0\u0db4\u0dd2\u0d9a\u0dca\u0db4\u0db6\u0dd2\u0dbd\u0dd2\u0d9a\u0dba\u0db4].3\u0dca \u0db4\u0dc0\u0dc0\u0db1\u0dca\u0db4\u0dbb\u0dbb\u0daf\u0daf\u0db4\u0dad\u0dd2\u0dc3\u0dc0\u0db6\u0dba\u0dc0\u0daf.\u0db4\n\n\u0dd6\u0dbd\u0daf\u0daf\u0dc3\u0dcf\u0dba\u0daf\u0dbb\u0dd6\u0daa\u0db4\u0d9c\u0dd4\u0dc0\u0db4\u0dad\u0db1\u0dca\u0dd3\u0dd4 \u0dad\u0db1\u0dd2,\u0db4\u0d92\u0db4\u0dc0\u0daf\u0dc0\u0dda\u0dad\u0db4 \u0d9a\u0db4\u0dc0\u0dc3\u0dcf\u0db1\u0dc0\u0daf\u0dbb\u0dbb \u0d9a\u0db4\u0d87\u0dd4 \u0dd4\u0db4\u0dbb\u0dc0\u0da7\u0db8\u0db4\u0dc3\u0dcf\u0dad\u0dc3\u0dcf\u0db1\u0dad\u0db4\u0dbb\u0daf\u0da2\u0dcf\u0dba\u0db4\u0dc0\u0dd2\u0d9a \u0db8\u0dd2\u0db1\u0dca\u0db4\u0dc3\u0dd2\u0d9a\u0d9a\u0da7\u0db43\u0dca \u0db4\u0dc0\u0dc0\u0db1\u0dca\u0db4\u0dbb\u0dbb\u0db4\u0dad\u0dd2\u0dc3\u0dc0\u0db6\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db4\u0dc0\u0dc3\u0dcf\u0dde\u0d9b\u0dba\u0db4\u0d85\u0dc3\u0dc1\u0dca\u0dc0\u0d86\u0db4\u0dc0\u0dd0\u0da7\u0dd4\u0dda\u0db4\u0dc3\u0dcf\u0dcf\u0db4\u0daf\u0dd3\u0dad\u0dba\u0daf\u0db4\u0dc0\u0dc0\u0dc0 \u0dc0\u0dc0\u0db1\u0dca.\u0db4\u0d92\u0db4\u0db8\u0dd4 \u0daf\u0db4\u0dd4\u0dc0\u0db4\u0dd2\u0d9a\u0dca\u0db4\u0db6\u0dd2\u0dbd\u0dd2\u0d9a\u0dba\u0db4292\u0dca \u0db4\u0dc0\u0dc0\u0dba\u0dc0\u0daf.\u0db4\u0db4\u0d85\u0dc0\u0dd4\u0dd4\u0dc0\u0daf\u0dd4\u0db40\u0dbb\u0da7\u0db4\u0dc0\u0dd2\u0dad\u0dbb\u0db4\u0db4\u0db1\u0dba\u0dc3\u0dcf\u0db1\u0dc0\u0dc3\u0dcf\u0db1\u0db4\u0dbb\u0daf\u0da2\u0dcf\u0dba\u0db4\u0dc0\u0dc3\u0dcf\u0db1\u0dc0\u0d9a\u0da7\u0db4 \u0dd0\u0dc0\u0dba\u0dba\u0db4\u0dc0\u0dd0\u0da7\u0dd4\u0dda\u0db4\u0dc0\u0dd0\u0db8\u0dd2\u0dc0\u0dd3\u0dad\u0dca \u0db4\u0dc0\u0d9c\u0dc0\u0dba\u0db1\u0dca\u0dba\u0db4\u0d85\u0db4\u0db1\u0dba\u0da7\u0db4\u0db4\u0db1\u0dba\u0dc3\u0dd4\u0d9c\u0dd2\u0d9a\u0db4\u0d85\u0d9a\u0db4\u0dc0\u0dd0\u0dc0\u0d9a\u0db1\u0dca\u0db4\u0db4\u0dd4\u0dd4\u0dc0\u0db1\u0dca\u0db4\u0dc0\u0dd4 \u0daf.\u0db4\u0d91\u0dc4\u0dd2\u0db4\u0dc0 \u0dc0\u0dd0\u0db1\u0dd2\u0db4\u0dc0\u0dbb\u0daf\u0da7\u0dc3\u0dcf\u0db4212)\u0db4\u0da2\u0dcf\u0dba\u0dc0\u0daf\u0dbb\u0dd2\u0dc0\u0d86\u0dad\u0dca,\u0db4\u0dd4 \u0db1\u0dca\u0dc0\u0dd0\u0db1\u0dd2\u0db4\u0dc0\u0dbb\u0daf\u0da7\u0dc3\u0dcf\u0db42127\u0db4\u0da2\u0dcf\u0dba\u0dc0\u0daf\u0dbb\u0dd2\u0dc0\u0d86\u0dad\u0dca\u0db4\u0daf\u0dd0\u0dd3\u0db8\u0dad\u0da7\u0db4\u0db1\u0dd2\u0d9a\u0db8\u0dd2\u0dad\u0dd2.\u0db4\u0dcf\u0dd0\u0db6\u0dd0\u0dd2,\u0db4\u0d92\u0dc0\u0dbb\u0db1\u0dca\u0db4\u0dbb\u0daf\u0da2\u0dcf\u0dba\u0db4\u0dc0\u0dc3\u0dcf\u0db1\u0dc0\u0dbb\u0d9a\u0daf\u0da7\u0db4\u0dad\u0dd2\u0dc3\u0dc0\u0db6\u0dba\u0db4\u0dc0\u0dd0\u0da7\u0dd4\u0dda\u0db4\u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba\u0d9a,\u0db4\u0dca\u0dbb\u0dca\u0dd2\u0dbb\u0db4\u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba\u0d9a\u0db4\u0dc3\u0dcf\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca \u0dc0\u0d9a\u0db1\u0dca\u0dad\u0db4\u0dc0\u0dd2\u0dc3\u0dcf\u0dc0\u0dc4\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db4\u0dba\u0dd0\u0dcf\u0dd0.\u0db4\u0d92\u0db4\u0db1\u0dd2\u0dc3\u0dcf\u0daf\u0db4\u0dad\u0dad\u0dd2\u0db4212)\u0db4\u0d85\u0d9a\u0db4\u0dc0\u0dd0\u0dc0\u0d9a\u0db1\u0dca\u0db4\u0da2\u0dcf\u0daf\u0dad\u0dd2\u0dc3\u0dbb\u0db4\u0dc0\u0dd0\u0da7\u0dd4\u0dda\u0db4\u0dc0\u0dbb\u0daf\u0db8\u0dd2\u0dc3\u0dcf\u0dad\u0dca \u0db4\u0db4\u0db1\u0dba\u0dad\u0dca\u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dba\u0db4\u0d85\u0dc0\u0dda\u0db4\u0d9c\u0dd4\u0dc0\u0db4\u0da2\u0dcf\u0dba\u0daf\u0db0\u0dd2\u0db4\u0db1\u0dba\u0dad\u0dd2\u0dc3\u0dd4 \u0dad\u0daf\u0db4\u0dc0\u0d9a\u0ddd\u0da2\u0dcf\u0dba\u0daf\u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dc0\u0db1\u0dca.\u0db4\u0d92\u0db4\u0da2\u0dcf\u0daf\u0dad\u0dd2\u0dc3\u0dbb\u0db4\u0dc0\u0dd0\u0da7\u0dd4\u0dda\u0db4\u0dc0\u0dbb\u0daf\u0db8\u0dd2\u0dc3\u0dcf\u0dad\u0db4\u0dad\u0d9f\u0dd2\u0db1\u0dca\u0db4\u0d91\u0dca \u0db4\u0d91\u0dca \u0db4\u0dca \u0dc0\u0dc2\u0db1\u0dad\u0dca\u200d\u0dbb\u0dc0\u0daf\u0db4\u0dad\u0dd2\u0dc3\u0dc0\u0db6\u0dba\u0db4\u0dc0\u0dd2\u0dc0\u0dc1\u0dca\u0db1\u0dc2\u0db4\u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0db4\u0db4\u0dc3\u0dd2\u0d9a\u0dca\u0daf\u0db4\u0dc3\u0dcf\u0dd0\u0daf\u0dd2\u0dbb\u0dca\u0daf\u0da7\u0db4\u0d85\u0dbb\u0dc0\u0d9c\u0dba\u0db4\u0dc0\u0dc3\u0dcf\u0dbb\u0dca ,\u0db4\u0dc0 \u0dbb\u0dca \u0db4\u0d87\u0dd4 \u0dad\u0db4\u0dc0\u0db8\u0dca\u0db4\u0dc0\u0dd2\u0dc2\u0dad\u0dad\u0daf\u0db4\u0dc3\u0dcf\u0dad\u0dba\u0d9a\u0da7\u0db4\u0db4\u0db1\u0dba\u0dad\u0dca\u0db4\u0dbb\u0dbb\u0daf\u0daf\u0db4\u0dc3\u0dcf\u0dad\u0dc3\u0dcf\u0db1\u0dad\u0db4\u0dbb\u0daf\u0da2\u0dcf\u0dba\u0db4\u0dc0\u0dc3\u0dcf\u0db1\u0dc0\u0d9a\u0da7\u0dad\u0db4\u0dad\u0dd8\u0dda\u0dad\u0dd2\u0dc3\u0dad\u0dad\u0dca\u0db4\u0dc0\u0dd2\u0d9a\u0db4\u0dcf\u0dd0\u0dd2\u0dbb\u0db4\u0dc0\u0dd0\u0da7\u0dd4\u0dda\u0db4\u0dc0\u0dba\u0dd4\u0dcf\u0d9a\u0dca \u0db4\u0db1\u0dd2\u0dbb\u0dca\u0dad\u0daf \u0d9a\u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dba\u0db4\u0d85\u0db4\u0db1\u0dba\u0da7\u0db4\u0db4\u0dd4\u0dd4\u0dc0\u0db1\u0dca\u0db4\u0dc0\u0dc0\u0dd2\u0db4\u0dd2\u0dbb\u0d9a\u0daf\u0daf\u0db4\u0dc4\u0dd2\u0dad\u0dba\u0dc0\u0daf.\u0db4"
