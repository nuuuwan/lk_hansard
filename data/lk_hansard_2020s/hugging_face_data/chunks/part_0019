 \u0dba\u0dd4\u0dd4\u0dba \u0db1\u0dd2\u0dba\u0dba\u0ddd\u0d9c \u0d9a\u0dbb\u0db1 \u0db1\u0daf\u0dd3\u0db4\n\n01 \u0dc0\u0db1 \u0dc0\u0dd0 \u0dc3\u0da7\u0dc4\u0db1\u0db4- \u0dba\u0db8\u0dba\u0dc4\u0dba\u0dd4\u0db8\u0dca \u0dc0\u0dd0 \u0dc3\u0da7\u0dc4\u0db1 - \u0dd6\u0dbd\u0db1\u0db0\u0db1 \u0dd2\u0dbd\u0dba\u0daf\u0db8,\n\n\u0dbb\u0dd4\u0db4 475,000,000\n\n\"255 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dbd\u0dc2\u0dba\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0 \u0dc3\u0da7\u0dc4\u0db1, \u0dd6\u0dbd\u0db1\u0db0\u0db1 \u0dd2\u0dbd\u0dba\u0daf\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0db4 475,000,000\u0d9a \u0d9a\u0dbb\u0daf\u0db1 \u0d8b\u0db4\u0dba\u0dca \u0d9b\u0dca\u200d\u0db1\u0dba\u0da7 \u0d87\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dd4\u0dba\" \u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba \u0dd2\u0dbd\u0db8\u0dc3\u0db1 \u0db1\u0daf\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0db7\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dd2\u0dbd\u0dba\u0db4\n\n255 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dbd\u0dc2\u0dba\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0 \u0dc3\u0da7\u0dc4\u0db1, \u0dd6\u0dbd\u0db1\u0db0\u0db1 \u0dd2\u0dbd\u0dba\u0daf\u0db8 \u0d8b\u0db4\u0dba\u0dca \u0d9b\u0dca\u200d\u0db1\u0dba\u0dba\u0dc4\u0dd2 \u0dba\u0d9a\u0dcf\u0da7\u0dc3\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dad\u0dd2\u0dbd\u0dcf\u0dba \u0dba\u0dd4\u0dd4\u0dba \u0db1\u0dd2\u0dba\u0dba\u0ddd\u0d9c \u0d9a\u0dbb\u0db1 \u0db1\u0daf\u0dd3\u0db4\n\n256 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dba.- \u0daf\u0dd2 \u0db1\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0db1\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba - \u0d9c\u0db8\u0dca\u0db4\u0dc4\n\n01 \u0dc0\u0db1 \u0dc0\u0dd0 \u0dc3\u0da7\u0dc4\u0db1\u0db4- \u0dba\u0db8\u0dba\u0dc4\u0dba\u0dd4\u0db8\u0dca \u0dc0\u0dd0 \u0dc3\u0da7\u0dc4\u0db1 - \u0db4\u0dd4\u0daf\u0dca\u0db1\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0db1 \u0dd2\u0dbd\u0dba\u0daf\u0db8,\n\n\u0dbb\u0dd4\u0db4 3,440,000,000\n\n\"256 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dbd\u0dc2\u0dba\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0 \u0dc3\u0da7\u0dc4\u0db1, \u0db4\u0dd4\u0daf\u0dca\u0db1\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0db1 \u0dd2\u0dbd\u0dba\u0daf\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0db4 3,440,000,000\u0d9a \u0d9a\u0dbb\u0daf\u0db1 \u0d8b\u0db4\u0dba\u0dca \u0d9b\u0dca\u200d\u0db1\u0dba\u0da7 \u0d87\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dd4\u0dba\" \u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba \u0dd2\u0dbd\u0db8\u0dc3\u0db1 \u0db1\u0daf\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0db7\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dd2\u0dbd\u0dba\u0db4\n\n256 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dbd\u0dc2\u0dba\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0 \u0dc3\u0da7\u0dc4\u0db1, \u0db4\u0dd4\u0daf\u0dca\u0db1\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0db1 \u0dd2\u0dbd\u0dba\u0daf\u0db8 \u0d8b\u0db4\u0dba\u0dca \u0d9b\u0dca\u200d\u0db1\u0dba\u0dba\u0dc4\u0dd2 \u0dba\u0d9a\u0dcf\u0da7\u0dc3\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dad\u0dd2\u0dbd\u0dcf\u0dba \u0dba\u0dd4\u0dd4\u0dba \u0db1\u0dd2\u0dba\u0dba\u0ddd\u0d9c \u0d9a\u0dbb\u0db1 \u0db1\u0daf\u0dd3\u0db4\n\n01 \u0dc0\u0db1 \u0dc0\u0dd0 \u0dc3\u0da7\u0dc4\u0db1\u0db4- \u0dba\u0db8\u0dba\u0dc4\u0dba\u0dd4\u0db8\u0dca \u0dc0\u0dd0 \u0dc3\u0da7\u0dc4\u0db1 - \u0dd6\u0dbd\u0db1\u0db0\u0db1 \u0dd2\u0dbd\u0dba\u0daf\u0db8,\n\n\u0dbb\u0dd4\u0db4 460,000,000\n\n\"256 \u0dc0\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dbd\u0dc2\u0dba\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db1 \u0dc0\u0dd0 \u0dc3\u0da7\u0dc4\u0db1, \u0dd6\u0dbd\u0db1\u0db0\u0db1 \u0dd2\u0dbd\u0dba\u0daf\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0db4 460,000,000\u0d9a \u0d9a\u0dbb\u0daf\u0db1 \u0d8b\u0db4\u0dba\u0dca \u0d9b\u0dca\u200d\u0db1\u0dba\u0da7 \u0d87\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dd4\u0dba\" \u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba \u0dd2\u0dbd\u0db8\u0dc3\u0db1 \u0db1\u0daf\u