\u0dd4. 70],000,000 \u0daf\u0dca\u200d\u0d9a\u0dca\u0dad\u0dc0\u0dcf \u0dc0\u0dd0\u0da2\u0dd2 \u0d9a\u0dc5 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd \u0d8b\u0db4\u0dc4 \u0db4\u0d9b\u0dca\u200d\u0db8\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\" \u0dba\u0db8 \u0dca\u200d\u0dbb\u0dba\u0dbd\u0db8\u0dba \u0dc0\u0dd2\u0db8\u0dc3\u0dca\u0db8 \u0dbd\u0daf\u0dd2\u0db1\u0dca \u0dc3\u0dca\u0db7\u0dcf \u0dc3\u0dca\u0db8\u0dca\u0db8\u0dad \u0dc0\u0dd2\u0dba.\n\n\" 119 \u0dc0\u0db8 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc4\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db8 \u0dc0\u0dd0\u0dca\u0dc3\u0dca\u0da7\u0dd9\u0db8, \u0db8\u0dd6\u0dbd\u0dca\u200d\u0db8 \u0dc0\u0dd2\u0dba\u0daf\u0dca\u200d\u0db8 \u0dc3\u0dca\u0db3\u0dd9\u0dcf \u0dbb\u0dd4. 3],000,000 \u0daf\u0dca\u200d\u0d9a\u0dca\u0dad\u0dc0\u0dcf \u0dc0\u0dd0\u0da2\u0dd2 \u0d9a\u0dc5 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd \u0d8b\u0db4\u0dc4 \u0db4\u0d9b\u0dca\u200d\u0db8\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\" \u0dba\u0db8 \u0dca\u200d\u0dbb\u0dba\u0dbd\u0db8\u0dba \u0dc0\u0dd2\u0db8\u0dc3\u0dca\u0db8 \u0dbd\u0daf\u0dd2\u0db1\u0dca \u0dc3\u0dca\u0db7\u0dcf \u0dc3\u0dca\u0db8\u0dca\u0db8\u0dad \u0dc0\u0dd2\u0dba.\n\n119 \u0dc0\u0db8 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc4\u0dba\u0dc4\u0dd2 01 \u0dc0\u0db8 \u0dc0\u0dd0\u0dca\u0dc3\u0dca\u0da7\u0dd9\u0db8, \u0db8\u0dd6\u0dbd\u0dca\u200d\u0db8 \u0dc0\u0dd2\u0dba\u0daf\u0dca\u200d\u0db8 \u0dc3\u0dca\u0dcf\u0dc4\u0dba\u0ddd\u0db0\u0dd2\u0dad\u0dcf\u0d9a\u0dcf\u0dbb\u0dc4\u0dba\u0db1\u0dca \u0d8b\u0db4\u0dc4 \u0db4\u0d9b\u0dca\u200d\u0db8\u0dc4\u0dba\u0dc4\u0dd2 \u0dc4\u0d9a\u0dcf\u0da7\u0dc3\u0dca\u0d9a\u0dca\u0dad \u0dd9\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dba\u0dd2 \u0db1\u0dd2\u0dc4\u0dba\u0ddd\u0d9c \u0d9a\u0dbb\u0db8 \u0dbd\u0daf\u0dd3.\n\n\" 119 \u0dc0\u0db8 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc4\u0dba\u0dc4\u0dd2 02 \u0dc0\u0db8 \u0dc0\u0dd0\u0dca\u0dc3\u0dca\u0da7\u0dd9\u0db8, \u0dd4\u0db8\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dad\u0db8 \u0dc0\u0dd2\u0dba\u0daf\u0dca\u200d\u0db8 \u0dc3\u0dca\u0db3\u0dd9\u0dcf \u0dbb\u0dd4. 2]0,000,000 \u0daf\u0dca\u200d\u0d9a\u0dca\u0dad\u0dc0\u0dcf \u0d85\u0dd4 \u0d9a\u0dc5 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd \u0d8b\u0db4\u0dc4 \u0db4\u0d9b\u0dca\u200d\u0db8\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\" \u0dba\u0db8 \u0dca\u200d\u0dbb\u0dba\u0dbd\u0db8\u0dba \u0dc0\u0dd2\u0db8\u0dc3\u0dca\u0db8 \u0dbd\u0daf\u0dd2\u0db1\u0dca \u0dc3\u0dca\u0db7\u0dcf \u0dc3\u0dca\u0db8\u0dca\u0db8\u0dad \u0dc0\u0dd2\u0dba.\n\n119 \u0dc0\u0db8 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc4\u0dba\u0dc4\u0dd2 02 \u0dc0\u0db8 \u0dc0\u0dd0\u0dca\u0dc3\u0dca\u0da7\u0dd9\u0db8, \u0dd4\u0db8\u0dbb\u0dcf\u0dc0\u0dbb\u0dca\u0dad\u0db8 \u0dc0\u0dd2\u0dba\u0daf\u0dca\u200d\u0db8 \u0dc3\u0dca\u0dcf\u0dc4\u0dba\u0ddd\u0db0\u0dd2\u0dad\u0dcf\u0d9a\u0dcf\u0dbb\u0dc4\u0dba\u0db1\u0dca \u0d8b\u0db4\u0dc4 \u0db4\u0d9b\u0dca\u200d\u0db8\u0dc4\u0dba\u0dc4\u0dd2 \u0dc4\u0d9a\u0dcf\u0da7\u0dc3\u0dca\u0d9a\u0dca\u0dad \u0dd9\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dba\u0dd2 \u0db1\u0dd2\u0dc4\u0dba\u0ddd\u0d9c \u0d9a\u0dbb\u0db8 \u0dbd\u0daf\u0dd3.\n\n\" 119 \u0dc0\u0db8 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc4\u0dba\u0dc4\u0dd2 02 \u0dc0\u0db8 \u0dc0\u0dd0\u0dca\u0dc3\u0dca\u0da7\u0dd9\u0db8, \u0db8\u0dd6\u0dbd\u0dca\u200d\u0db8 \u0dc0\u0dd2\u0dba\u0daf\u0dca\u200d\u0db8 \u0dc3\u0dca\u0db3\u0dd9\u0dcf \u0dbb\u0dd4. 21,371,000,000 \u0daf\u0dca\u200d\u0d9a\u0dca\u0dad\u0dc0\u0dcf \u0d85\u0dd4 \u0d9a\u0dc5 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd \u0d8b\u0db4\u0dc4 \u0db4\u0d9b\u0dca\u200d\u0db8\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\" \u0dba\u0db8 \u0dca\u200d\u0dbb\u0dba\u0dbd\u0db8\u0dba \u0dc0\u0dd2\u0db8\u0dc3\u0dca\u0db8 \u0dbd\u0daf\u0dd2\u0db1\u0dca \u0dc3\u0dca\u0db7\u0dcf \u0dc3\u0dca\u0db8\u0dca\u0db8\u0dad \u0dc0\u0dd2\u0dba.\n\n119 \u0dc0\u0db8 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dc4\u0dba\u0dc4\u0dd2 02 \u0dc0\u0db8 \u0dc0\u0dd0\u0dca\u0dc3\u0dca\u0da7\u0dd9\u0db8, \u0db8\u0dd6\u0dbd\u0dca\u200d\u0db8 \u0dc0\u0dd2\u0dba\u0daf\u0dca\u200d\u0db8 \u0dc3\u0dca\u0dcf\u0dc4\u0dba\u0ddd\u0db0\u0dd2\u0dad\u0dcf\u0d9a\u0dcf\u0dbb\u0dc4\u0dba\u0db1\u0dca \u0d8b\u0db4\u0dc4 \u0db4\u0d9b\u0dca\u200d\u0db8\u0dc4\u0dba\u0dc4\u0dd2 \u0dc4\u0d9a\u0dcf\u0da7\u0dc3\u0dca\u0d9a\u0dca\u0dad \u0dd9\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dba\u0dd2 \u0db1\u0dd2\u0dc4\u0dba\u0ddd\u0d9c \u0d9a\u0dbb\u0db8 \u0dbd\u0daf\u0dd3.\n\n\u201c\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 119, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bc8\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0b85\u0ba4\u0bbf\u0b95\u0bc6\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 706,000,000 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0bb1\u0bcd \u0ba9\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bc8\u0bc6\u0bbe\u0b95\u201d \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 119, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bc8\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bb0\u0bc1\u0b9e\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1 \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u0bc6\u0bbe\u0bb1\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bb3\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n\u201c\u0ba4\u0bae\u0bb2\u0baa\u0bcd\u0baa\u0bc1 119, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 01, \u0bae\u0bc2\u0bb2\u0ba4\u0ba9\u0b9a\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0b85\u0ba4\u0bbf\u0b95\u0bc6\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd 36,000,000 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bae\u0ba3\u0baf\u0bbf\u0bb1\u0bcd \u0ba9\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bc8\u0bc6\u0bbe\u0b95\u201d \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1."
