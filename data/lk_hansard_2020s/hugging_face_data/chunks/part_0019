    "chunk_text": "\u0da7\u0dc5\u0d9f\u0da7, \u0d85\u0db4\u0da7 \u0dc3\u0dd4\u0dc5\u0dcf \u0db6\u0dbd\u0dc4\u0dba\u0db1\u0dca \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0dba \u0db1\u0dd2\u0db4\u0daf\u0dca\u200d\u0dc0\u0dd3\u0db8 \u0dc3\u0dca\u0db3\u0dd9\u0dcf \u0dc4\u0dd9\u0dcf\u0db3 \u0dc0\u0dd2\u0db7\u0dc0\u0dad\u0dcf\u0dc0\u0d9a\u0dca\u0dad \u0dd2\u0dc4\u0db6\u0db8\u0dc0\u0dcf. \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0d9c\u0dad\u0dca\u0dc4\u0dad\u0dcf\u0dad\u0dca, \u0dc3\u0dca\u0dcf\u0db8\u0dcf\u0db8\u0dba\u0dc4\u0dba\u0db1\u0dca \u0d85\u0dc4\u0dda \u0dc0\u0dd2\u0daf\u0dd4\u0dd2 \u0db1\u0db8\u0db8\u0dc4\u0dba\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 5\u0d9a\u0dca\u0dad, ]\u0d9a\u0dca\u0dad \u0dc0\u0dd2\u0dad\u0dbb \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca\u0dad \u0dc3\u0dca\u0db3\u0dd9\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dc3\u0dd4\u0dc5\u0d9f \u0db4\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0da0\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0dc4\u0db1\u0dca. \u0db8\u0db8\u0dd4\u0dad\u0dca, \u0d87\u0dc4\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0dc4\u0dda NREL \u0d86\u0dba\u0dad\u0db8\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca ADB \u0d86\u0dca\u200d\u0dcf\u0dbb \u0db8\u0dad \u0d9a\u0dbb\u0dd4 \u0dc3\u0dca\u0db8\u0dd3\u0d9a\u0dca\u0dad\u0dc2\u0dab\u0dba\u0d9a\u0dca\u0dad \u0dd2\u0dc4\u0db6\u0db8\u0dc0\u0dcf, \u0d85\u0dca\u200d\u0dba\u0dba\u0db8\u0dba\u0d9a\u0dca\u0dad \u0dd2\u0dc4\u0db6\u0db8\u0dc0\u0dcf. \u0d92 \u0d85\u0dca\u200d\u0dba\u0dba\u0db8\u0dba \u0dad\u0dd4\u0db8\u0dc5 \u0d9a\u0dd2\u0dba\u0db8\u0dc0\u0dcf, \u0dc4\u0d9c\u0dcf\u0dca\u0db6\u0dd2\u0db8 \u0dad\u0dd4\u0db8\u0dc5 \u0d87\u0dd2 \u0d9a\u0dbb\u0db8 \u0dc3\u0dd4\u0dc5\u0dcf \u0db6\u0dbd\u0dcf\u0d9c\u0dcf\u0dbb\u0dc0\u0dd2\u0db1\u0dca \u0d9c\u0dd2\u0d9c\u0dcf\u0dc4\u0dc0\u0dcf\u0dda 100\u0d9a\u0da7 \u0dba\u0db1\u0dca\u0db8 \u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca, \u0d92 \u0dc0\u0dcf\u0dc4 \u0db8 \u0d9a\u0dbd\u0dd4\u0dc0 \u0db8\u0dad \u0d87\u0dd2 \u0d9a\u0dbb\u0db8 \u0dc3\u0dd4\u0dc5\u0dcf \u0db6\u0dbd\u0dcf\u0d9c\u0dcf\u0dbb\u0dc0\u0dd2\u0db1\u0dca \u0d9c\u0dd2\u0d9c\u0dcf\u0dc4\u0dc0\u0dcf\u0dda 4\u0d9a\u0da7 \u0dba\u0db1\u0dca\u0db8 \u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dd2\u0db7\u0dc0\u0dad\u0dcf\u0dc0\u0d9a\u0dca\u0dad \u0dbd\u0dcf\u0d9a\u0dcf\u0dc0 \u0dad\u0dd4\u0db8\u0dc5 \u0dd2\u0dc4\u0db6\u0db8\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d92 \u0dc0\u0dcf\u0dc4 \u0db8 \u0dc4\u0dbd\u0ddd\u0d9a \u0db6\u0dd0\u0dcf\u0dd4\u0dc0 \u0d9a\u0dbb\u0dd4 \u0d85\u0dca\u200d\u0dba\u0dba\u0db8\u0dba\u0d9a\u0dca\u0dad \u0dd2\u0dc4\u0db6\u0db8\u0dc0\u0dcf. Offshore \u0d91\u0dc4\u0d9a\u0dca\u0dad, \u0dc4\u0db8\u0dcf\u0d9c\u0dd0\u0db9\u0dd4\u0dbb\u0dd4 \u0db1\u0dbd\u0dc4\u0dda \u0d9c\u0dd2\u0d9c\u0dcf\u0dc4\u0dc0\u0dcf\u0dda 27\u0d9a \u0dc0\u0dd2\u0db7\u0dc0\u0dad\u0dcf\u0dc0\u0d9a\u0dca\u0dad \u0dc0\u0dcf\u0dc4 \u0db8 \u0d9c\u0dd0\u0db9\u0dd4\u0dbb\u0dd4 \u0db1\u0dbd\u0dc4\u0dda \u0d9c\u0dd2\u0d9c\u0dcf\u0dc4\u0dc0\u0dcf\u0dda 29\u0d9a \u0dc0\u0dd2\u0db7\u0dc0\u0dba\u0d9a\u0dca\u0dad \u0dd2\u0dc4\u0db6\u0db8 \u0db6\u0dc0 \u0d9a\u0dd2\u0dba\u0db8\u0dc0\u0dcf. \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc4\u0db1\u0dca \u0db8\u0dd0\u0dd9\u0dd0, \u0dc4\u0db8\u0dca \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dc0\u0dd2\u0db7\u0dc0\u0dba\u0db1\u0dca \u0d85\u0db4\u0da7 \u0db4\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0da0\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db8 \u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dca\u200d\u0dbb\u0dcf\u0dc4\u0dba\u0ddd\u0d9c\u0dd2\u0d9a \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0db1\u0dca \u0dd2\u0dc4\u0db6\u0db8\u0dc0\u0dcf. \u0d92 \u0dc3\u0dca\u0db3\u0dd9\u0dcf \u0d85\u0db0\u0dd2\u0d9a \u0db4\u0dd2\u0dbb\u0dd2\u0dc0\u0dd0\u0dba\u0d9a\u0dca\u0dad \u0daf\u0dca\u200d\u0dbb\u0db1\u0dca\u0db8 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0db8\u0dc0\u0dcf. \u0d92 \u0db1\u0dd2\u0dc3\u0dca\u0dcf \u0dc4\u0db8\u0dca \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0db8 \u0dc5\u0d9f\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db8 \u0db6\u0dd0\u0dbb\u0dd2 \u0dc0\u0dd4\u0dab\u0dad\u0dca \u0d85\u0db4\u0da7 \u0dc3\u0dca\u0dd0\u0dbd\u0d9a\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d85\u0dc0\u0dc3\u0dca\u0dbd\u0dae\u0dcf\u0dc0\u0d9a\u0dca\u0dad \u0dd2\u0dc4\u0db6\u0db8\u0dc0\u0dcf, \u0dc3\u0dd4\u0dc5\u0dcf \u0db6\u0dbd\u0dc4\u0dba\u0db1\u0dca \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0dba \u0db1\u0db8\u0db8\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db8. \u0dc4\u0db8\u0dcf\u0d9a\u0daf\u0dca\u200d, \u0d85\u0dc4\u0dda \u0daf\u0dca\u200d\u0dd0\u0db1\u0dca \u0dd2\u0dc4\u0db6\u0db8 \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0d9c\u0dad\u0dca\u0dc4\u0dad\u0dcf\u0dad\u0dca, \u0d9c\u0dd2\u0d9c\u0dcf\u0dc4\u0dc0\u0dcf\u0dda \u0dc4\u0daf\u0dca\u200d\u0d9a\u0dba\u0dd2 \u0daf\u0dca\u200d\u0dba\u0db8 \u0d9c\u0dab\u0db8\u0d9a\u0dca\u0dad \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0da7 \u0daf\u0dca\u200d\u0dd0\u0db8\u0da7 \u0d85\u0dc0\u0dba\u0dba \u0dc4\u0dc0\u0db1\u0dca\u0dc4\u0db1\u0dca - \u0d9c\u0dd2\u0d9c\u0dcf\u0dc4\u0dc0\u0dcf\u0dda 2.9\u0d9a\u0dca\u0dad \u0dad\u0db8\u0dba\u0dd2 \u0dbd\u0dcf\u0d9a\u0dcf\u0dc4\u0dda \u0daf\u0dca\u200d\u0dd0\u0db1\u0dca \u0d85\u0dc0\u0dba\u0dba\u0dad\u0dcf\u0dc0. \u0db8\u0db8\u0dd4\u0dad\u0dca, \u0d85\u0db4 \u0daf\u0dca\u200d\u0dd0\u0db1\u0dca \u0dc3\u0dd4\u0dc5\u0dcf \u0db6\u0dbd\u0dc4\u0dba\u0db1\u0dca \u0db1\u0dd2\u0dc2\u0dbd\u0db4\u0dcf\u0daf\u0dca\u200d\u0db8\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dc4\u0db1\u0dca \u0dc4\u0db8\u0d9c\u0dcf\u0dc4\u0dc0\u0dcf\u0dda 2]0\u0d9a\u0da7 \u0d86\u0dc3\u0dca\u0db1\u0dca\u0db8 \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca\u0dad \u0dc0\u0dd2\u0dad\u0dbb\u0dba\u0dd2. \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dca\u0dcf \u0d85\u0db4\u0dd2 \u0dc4\u0dd2\u0dad\u0db8\u0dc0\u0dcf \u0daf\u0dca\u200d\u0dd0\u0db8\u0da7 \u0dd2\u0dc4\u0db6\u0db8 \u0dc4\u0db8\u0db8 \u0dca\u200d\u0dbb\u0db7\u0dc0\u0dba \u0d85\u0db4 \u0dc4\u0dd9\u0dcf\u0db3\u0dd2\u0db1\u0dca \u0db4\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0da0\u0dd2 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf.\n\n\u0dc0\u0dd2\u0dc4\u0dba\u0dbd\u0dc2\u0dc4\u0dba\u0db1\u0dca \u0dd6 \u0dbb\u0dca\u0dba \u0db6\u0dbd\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc4\u0db1\u0dca \u0d85\u0dd2\u0dba\u0dba \u0dc3\u0dca\u0dcf\u0dc4\u0dda\u0daf\u0dd3 \u0dca\u200d\u0dbb\u0db7\u0dc0\u0dba\u0d9a\u0dca\u0dad. \u0d92\u0dc4\u0d9a\u0db1\u0dca \u0db4\u0daf\u0dca\u0dca\u200d\u0dd2\u0dc0\u0dbd\u0da7 \u0d87\u0dd2 \u0dc0\u0db8 \u0d9c\u0dd0\u0da7\u0dbd\u0dd4 \u0d9a\u0dc5\u0db8\u0db8\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0dc4\u0db1\u0dca \u0dc4\u0d9a\u0dcf\u0dc4\u0dd9\u0dcf\u0db8\u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0db8 \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d91\u0daf\u0dca\u200d\u0dcf \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dc0\u0dad\u0dca\n\n\u0d85\u0dc0\u0dca\u200d\u0dcf\u0db8\u0dba\u0d9a\u0dca\u0dad \u0dc4\u0dba\u0dcf\u0db8\u0dd4 \u0dc4\u0dc0\u0dbd\u0dcf \u0dd2\u0db6\u0dd4\u0dc4\u0dab\u0dca \u0db8\u0dd0\u0dd9\u0dd0. \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dca\u0dcf \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0d85\u0db4\u0dd2 \u0daf\u0dca\u200d\u0dd0\u0db1\u0dca \u0d9a \u0db4\u0db4\u0db8\u0dcf \u0d9a\u0dbb\u0dc4\u0d9c\u0db8 \u0dba\u0db8\u0dc0\u0dcf, \u0dd4\u0db8\u0dbb\u0dca\u0db1\u0db8\u0db8\u0da7\u0dba \u0db6\u0dbd\u0dba\u0d9a\u0dca\u0dad\u0dd2 \u0dca\u200d\u0dbb\u0db7\u0dc0\u0dba\u0d9a\u0dca\u0dad \u0dd9\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dd9\u0dba\u0dd2\u0da9\u0dca\u200d\u0dbb\u0db1\u0db1\u0dca \u0db4\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0da0\u0dd2 \u0d9a\u0dbb\u0dbd\u0dcf \u0db8\u0daf\u0dd2\u0dbb\u0dd2\u0dc4\u0dda\u0daf\u0dd3 \u0d85\u0dc4\u0dda \u0db6\u0dbd\u0dba\u0d9a\u0dca\u0dad\u0dd2 \u0d85\u0dc0\u0dba\u0dba\u0dad\u0dcf \u0dc3\u0dca\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dab \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0dc4\u0db1\u0dca \u0dc4\u0d9a\u0dcf\u0dc4\u0dd9\u0dcf\u0db8\u0daf\u0dca\u200d \u0d9a\u0dd2\u0dba\u0db8 \u0d91\u0d9a \u0d9c\u0dd0\u0db8."
