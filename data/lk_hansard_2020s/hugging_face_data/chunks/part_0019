    "chunk_text": "\u0d92\u0db4\u0dc0\u0daf\u0dc0\u0dda\u0dad\u0db4\u0dad\u0dad\u0db4\u0dad\u0dc0\u0dad\u0dca\u0db4\u0dc0\u0dd2\u0dc0\u0dc1\u0dca\u0db1\u0dc2\u0db4\u0dbb\u0daf\u0dbb \u0d9a\u0dca \u0db4\u0dc3\u0dcf\u0dc4\u0dcf\u0db1\u0dca\u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dba\u0db4\u0d95\u0dba\u0dd1.\u0db4\u0d9a\u0dbb\u0da9\u0db4\u0d9c\u0dd0\u0dcf\u0dd0\u0db1\u0dd2\u0d9a\u0dca \u0db4\u0dd2\u0dbb\u0d9a\u0daf\u0daf\u0db4\u0dc0\u0dd2\u0dd4\u0dc0 \u0daf\u0dc0\u0dbd\u0dd2\u0d9a\u0db4\u0daf\u0dad\u0dca\u0db4\u0d9c\u0db8\u0dca\u0dc0\u0db4\u0db1\u0dba\u0daf \u0db4\u0db4\u0dca\u200d\u0dbb\u0dc0\u0dca \u0dc1\u0dca\u0dc0\u0d86\u0db4\u0dca\u0dad\u0dca\u0dad\u0daf\u0db4\u0daf\u0dd2\u0dca\u0dd4\u0dc0\u0dca \u0dc2\u0dd2\u0db4\u0da2\u0dcf\u0d9a\u0dbb\u0dad\u0dca\u0dba\u0db4\u0dad\u0dcf\u0dad\u0dca\u0db8\u0dd2\u0d9a,\u0db4\u0db4\u0db1\u0dba\u0dc3\u0dd4\u0d9c\u0dd2\u0d9a\u0db4\u0dbb\u0daf\u0daf\u0dc0\u0d86\u0db4\u0dc0\u0dca \u0dc1\u0dca\u0db4\u0db1\u0dba\u0daf\u0daf\u0dba\u0da5\u0d9a\u0db1\u0dca\u0db4\u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0db4\u0db6\u0daf\u0dcf\u0dad\u0dca\u0dbb\u0daf\u0dbb\u0dc0\u0d9a\u0db1\u0dca\u0db4\u0d85\u0dca\u0daf\u0daf\u0dc0\u0d9c\u0dba\u0db4\u0dc4\u0dd2\u0da7\u0db4\u0dd4\u0db4\u0dd4\u0dc0\u0db4\u0dd2\u0d9a\u0dca\u0db4\u0dc0\u0dbb\u0ddd\u0dc0\u0dcf\u0db4]11\u0dbb\u0db4\u0dc0\u0dca \u0dc0\u0db4\u0db1\u0dba\u0daf \u0dca \u0db4\u0dbb\u0da2\u0dcf\u0d9a\u0da7,\u0db4\u0db6\u0dd4\u0dca \u0db0\u0dca\u200d\u0dc1\u0dca\u0daf\u0dc3\u0dcf\u0dba,\u0db4\u0dca\u0d9c\u0db8\u0dd2\u0dbb\u0db4\u0dc3\u0dcf\u0dcf\u0db4\u0dc3\u0dcf\u0dc3\u0dc3\u0dcf\u0db1\u0dbb\u0dd8\u0dad\u0dd2\u0dc3\u0dbb\u0db4\u0dbb\u0da7\u0dd4\u0dad\u0dd4 \u0db4\u0d85\u0dad\u0daf\u0dad\u0dba\u0daf\u0dc3\u0dc1\u0dca\u0d9a\u0da7\u0db4\u0daf\u0db6\u0daf\u0db4\u0d9c\u0db1\u0dca\u0dba\u0db4\u0dbb\u0da7\u0dd4\u0dad\u0dd4 \u0db4\u0dbb \u0daf.\u0db4\u0d91\u0dd4 \u0db8\u0dd2\u0d9a\u0da7\u0db4\u0d85\u0db4\u0dd2\u0db4\u0dc0\u0db8\u0dca\u0db4\u0db4\u0db1\u0dba\u0daf\u0dbb\u0dca\u0dbd\u0dd2\u0dc0\u0db8\u0dca\u0db1\u0dca\u0dd4 \u0dc0 \u0daf\u0dd3\u0db4\u0dc3\u0dcf\u0db1\u0dd4 \u0dad\u0dd2\u0dc3\u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dba\u0db4\u0d95\u0dba\u0dd1.\u0db4\u0d91\u0dd4 \u0db8\u0dd2\u0d9a\u0dc0\u0dda\u0db4\u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0d9a\u0db4\u0d85\u0dba\u0dd4 \u0dbb\u0dbb\u0db4\u0dad\u0dd2\u0dc3\u0db4\u0db6\u0dd2\u0d9a\u0daf\u0dd3\u0dad\u0dca\u0db4\u0dbb\u0da2\u0dcf\u0dc0\u0d86\u0db4\u0dc4\u0dd2\u0da7\u0db4\u0dd4\u0db4\u0d85\u0d9c\u0dad\u0dd0\u0dad\u0dd2\u0dc3\u0dc0\u0dd4\u0dc0,\u0db4\u0d87\u0dad\u0dad\u0dd2\u0dc3\u0dc0\u0dd4\u0dc0\u0db4\u0d91\u0dca \u0dbb\u0db4\u0dad\u0dbb\u0d9c\u0db4\u0dbb\u0dbb\u0daf\u0daf\u0db4\u0da2\u0dcf\u0d9a\u0dca\u200d\u0dcf \u0d9a\u0db4\u0dbb\u0dbb\u0daf\u0daf,\u0db4\u0db6\u0dd4\u0dca \u0db0\u0dca\u200d\u0dc1\u0dca\u0daf\u0dc3\u0dcf\u0dba,\u0db4\u0dca\u0d9c\u0db8\u0dd2\u0dbb\u0db4\u0dc3\u0dcf\u0dcf\u0db4\u0dc3\u0dcf\u0dc3\u0dc3\u0dcf\u0db1\u0dbb\u0dd8\u0dad\u0dd2\u0dc3\u0dbb\u0db4\u0dbb\u0da7\u0dd4\u0dad\u0dd4 \u0db4\u0d85\u0dad\u0daf\u0dad\u0dba\u0daf\u0dc3\u0dc1\u0dca\u0d9a\u0da7\u0db4\u0d85 \u0db4\u0db4\u0d92\u0db4\u0dc0\u0dca \u0dc0\u0db4\u0db1\u0dba\u0daf \u0db4\u0d9a\u0dc5\u0dd2\u0db4\u0db4\u0db1\u0dba\u0dc0\u0dbb\u0daf\u0db4\u0daf\u0dd3\u0daf\u0daf\u0db4\u0dad\u0dd2\u0dc3\u0dc0\u0db6\u0dba\u0dc0\u0daf.\u0db4\u0d92\u0db4\u0d9c\u0dd0\u0dba\u0db4\u0d87\u0dad\u0dca\u0dad\u0da7\u0dad\u0db4\u0d85\u0db4\u0dd2\u0db4\u0dc3\u0dcf\u0db1\u0dca\u0dc0\u0dad\u0ddd\u0dc2\u0db4\u0dc0\u0dc0\u0db1\u0dca\u0dba\u0db4\u0d95\u0dba\u0dd1.\u0db4\u0dbb\u0da2\u0dcf\u0dc0\u0d86\u0db4\u0db1\u0dd2\u0daf\u0db0\u0dca\u200d\u0daf\u0dbb\u0dd2\u0dc0\u0d9a\u0dca \u0db4\u0dc0\u0dd2\u0db0\u0dd2\u0d9a\u0da7\u0db4\u0d91\u0dc0\u0dc3\u0dcf\u0db1\u0db4\u0dbb\u0da7\u0dd4\u0dad\u0dd4 \u0db4\u0dd2\u0dbb\u0dd3\u0db8\u0dad\u0db4\u0d9c\u0dd0\u0dba\u0db4\u0d91\u0dad\u0db4\u0dc0\u0dca\u0dbb\u0db8\u0dca\u0dd4 \u0db8\u0dd2\u0d9a\u0da7\u0db4\u0d85\u0db4\u0dd2\u0db4\u0dc3\u0dcf\u0db1\u0dd4 \u0dad\u0dd2\u0dc3\u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dba\u0db4\u0d95\u0dba\u0dd1.\u0db4\n\n\u0d92\u0db4\u0dc0\u0daf\u0dc0\u0dda\u0dad\u0db4\u0db4\u0dad\u0dad\u0db4\u0dad\u0dc0\u0dad\u0dca\u0db4\u0dc0 \u0d9a\u0dca \u0db4\u0dd2\u0dbb\u0d9a\u0db1\u0dca\u0dba\u0db4\u0dbb\u0dd0\u0dad\u0dd0\u0dad\u0dd2\u0dc3\u0dd2.\u0db4\u0dba\u0daf\u0dad\u0dca\u0db4\u0dbb\u0daf\u0da2\u0dcf\u0db4\u0db1\u0dba\u0dca \u0dc2\u0db4\u0dad\u0db1\u0dca\u0dd3\u0dd4 \u0dad\u0daf\u0db4\u0d8a\u0dc0\u0d86\u0db4\u0dc3\u0dcf\u0dc4\u0dcf\u0db1\u0dca\u0db4\u0dbb \u0daf,\u0db4\u0d85\u0dc0\u0dda\u0db4\u0dad\u0db1\u0dca\u0dd3\u0dc0\u0dd4\u0dc0\u0db4\u0db6\u0dc3\u0dcf\u0db1\u0db4\u0d91\u0dc0\u0dca \u0db4\u0d91\u0dba\u0dc0\u0daf\u0d9a\u0db4\u0dd2\u0dbb\u0d9a\u0daf\u0daf.\u0db4\u0d94 ,\u0db4\u0d85\u0db4\u0dd2\u0da7\u0db4\u0dca\u0da9\u0db8\u0dca\u0db6\u0dbb\u0dd2.\u0db4\u0d85\u0db4\u0dd2\u0da7\u0db4\u0dc3\u0dcf\u0db1\u0dca\u0dc0\u0dad\u0ddd\u0dc2\u0dd2.\u0db4\u0dc4\u0dd2\u0dad\u0daf\u0daf\u0db4\u0db6\u0daf\u0db1\u0dca\u0dba,\u0db4\u0dc0\u0dd2\u0dd4\u0dc0\u0dca \u0db0\u0dca\u200d\u0db4\u0db4\u0db1\u0dba\u0dca \u0dc2\u0dc0\u0d86\u0db4\u0dbb\u0da7\u0db8\u0dc0\u0dcf\u0d9a\u0db4\u0d85\u0dc0\u0dd4\u0dd4\u0dc0\u0dca \u0dca \u0db4\u0dad\u0db1\u0dca\u0dd3\u0db4\u0dc0\u0dc0\u0daf\u0daf\u0db4\u0dc4\u0dd2\u0dc0\u0dcf\u0dc0\u0d9a\u0daf\u0dad\u0dca\u0db4\u0dc0\u0dad\u0daf\u0dba\u0dc0\u0daf \u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db4\u0dd2\u0dbb\u0d9a\u0daf\u0daf.\u0db4\u0dbb\u0dd0\u0dda\u0db4\u0d91\u0dbb\u0dca \u0db4\u0dc0\u0dba\u0daf\u0dc0\u0dc0\u0dd2,\u0db4\u0dc3\u0dcf\u0dad\u0dcf\u0dbb\u0db4\u0dc0\u0dd2\u0da7\u0db4V8 \u0d91\u0dbb\u0dd4 \u0dad\u0dca\u0db4\u0d85\u0dbb\u0dc0\u0d9c\u0dba\u0db4\u0d87\u0dad\u0dd2\u0dc3,\u0db4\u0dc0\u0dcf\u0daf\u0dbb\u0dbb\u0db8\u0dca\u0db4\u0dbb\u0dbb\u0daf\u0daf;\u0db4\u0daf\u0dd6\u0dc2 \u0db4\u0dbb\u0dbb\u0daf\u0daf.\u0db4\u0dc3\u0dcf\u0dad\u0dcf\u0dbb\u0db4\u0dc0\u0dd2\u0da7\u0db4\u0dc0\u0dcf\u0dbd\u0dd2\u0dc0\u0dbb\u0daf\u0dda\u0da7\u0dbb\u0d9a\u0d9a\u0dd4\u0dad\u0dca\u0db4\u0d85\u0dbb\u0dc0\u0d9c\u0dba\u0db4\u0d87\u0dad\u0dd2\u0dc3.\u0db4\u0d85\u0dc0\u0dda\u0db4\u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dcf\u0db1\u0dc3\u0dd4\u0db4\u0dd4\u0dc0\u0db4\u0dd2\u0d9a\u0daf\u0dca \u0db4\u0dc0\u0dcf\u0daf\u0dbb\u0dbb\u0db8\u0dca\u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db4\u0dba\u0dd0\u0dcf\u0dd0;\u0db4\u0dbb\u0dbb\u0db1\u0dca\u0dba\u0db4\u0dc0 \u0db1\u0dca\u0dc0\u0db1\u0dca\u0dad\u0dca\u0db4\u0dba\u0dd0\u0dcf\u0dd0.\u0db4\n\n\u0d9c\u0dd4 \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dd9\u0db1\u0dca\u0dd3\u0dd4\u0dbb\u0dd9\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0b95\u0bb2\u0b95\u0bae\u0ba4\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0d94\u0db6\u0dd4 \u0dad\u0daf\u0da7\u0db4\u0dad\u0dc0\u0db4\u0dc0\u0dd2\u0dba\u0daf\u0db8\u0dd2\u0db4\u0dc0 \u0dbb\u0dbb\u0db4\u0dbb\u0daf\u0daf\u0d9a\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0dc0\u0db6\u0dba\u0dc0\u0daf,\u0db4\u0d9c\u0dd4\u0dc0\u0db4\u0dad\u0db1\u0dca\u0dd3\u0dd4 \u0dad\u0db1\u0dd2.\n\n949 950\n\n\u0db4\u0db1\u0dba\u0daf\u0dbb\u0dca\u0dbd\u0dd2\u0dc0\u0db8\u0dca\u0db1\u0dca\u0dd4 \u0dc0\n\n\u0d9c\u0dd4 \u0dc6\u0dc3\u0db1\u0dd2\u0dc2\u0db1\u0dca \u0db1\u0dd3\u0db8\u0dc6\u0db1 \u0dd9\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0baa\u0bb8\u0bcd\u0bae\u0bbf\u0ba9\u0bcd \u0bb7\u0bbe\u0bc0\u0baa\u0bcd) (The Hon. Fasmin Sharif) \u0d92\u0db4\u0dc0\u0daf\u0dc0\u0dda\u0dad\u0db4\u0dad\u0dc0\u0dad\u0dca\u0db4\u0dad\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dc0\u0d9a\u0dca \u0db4\u0dd2\u0dbb \u0dc0\u0daf,\u0db4\u0dd3\u0db8\u0db4\u0dbd\u0dd6\u0dc0 \u0dc0\u0dbd\u0dd2\u0db1\u0dca,\u0db4\u0d85\u0daf\u0dc0\u0dbd\u0dd2\u0db1\u0dca\u0db4\u0db4\u0db1\u0dba\u0dd0\u0daf\u0dc0\u0dad\u0dca\u0dad\u0da7\u0db4commission \u0d9c\u0dd2\u0d9a\u0daf\u0db4\u0dd2\u0dbb\u0d9a\u0daf\u0daf.\u0db4\u0d85\u0db4\u0dd2\u0db4\u0dbb\u0daf\u0dc0\u0d9c\u0db1\u0dca\u0dc0\u0dad\u0dca\u0db4commission \u0d9c\u0db1\u0dca\u0dc0\u0dba\u0dad\u0dca\u0db4\u0dba\u0dd0\u0dcf\u0dd0;\u0db4\u0d9c\u0db1\u0dca\u0dba\u0db4\u0dc0 \u0db1\u0dca\u0dc0\u0dba\u0dad\u0dca\u0db4\u0dba\u0dd0\u0dcf\u0dd0.\u0db4\u0d94\u0db6\u0dd4 \u0dad\u0db1\u0dca\u0daf\u0daf\u0db4\u0dc4\u0dd2\u0dad\u0db1\u0dca\u0dba\u0db4\u0d91\u0db4\u0db1\u0dba\u0daf\u0db4\u0d85\u0db4\u0dd2\u0db4\u0dc0\u0dcf\u0daf\u0dbb\u0dbb\u0db8\u0dca\u0db4\u0dbb\u0dbb\u0dba\u0db4\u0da2\u0dcf\u0daf\u0dad\u0dd2\u0dc3\u0d9a\u0dca \u0db4\u0dd2\u0dbb\u0d9a\u0daf\u0daf.\n\n\u0d8a \u0d9f\u0da7,\u0db4\u0dad\u0dc0\u0db4\u0dbb\u0daf\u0dbb \u0d9a\u0dca \u0db4\u0dad\u0dad\u0db4\u0dc0\u0dd2\u0dc0\u0dc1\u0dca\u0db1\u0dc2\u0dc0\u0d9a\u0db1\u0dca\u0dad\u0db4\u0dd2\u0dbb\u0d9a\u0db1\u0dca\u0dba\u0db4\u0d95\u0dba\u0dd1.\u0db4\u0d85\u0db4\u0dd2\u0db4\u0dc3\u0dcf\u0dc3\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0dba\u0db4\u0dbb\u0da7\u0dd4\u0dad\u0dd4 \u0db4\u0dbb\u0dbb\u0dba\u0dc0\u0daf.\u0db4\u0d85\u0db4\u0dd2\u0db4\u0dc0\u0dad\u0daf\u0dba\u0dc0\u0dad\u0dca\u0db4\u0dbb\u0dc0 \u0db1\u0db4\u0dba\u0dd0\u0dcf\u0dd0\u0db4\u0dd2\u0dbb\u0d9a\u0daf\u0daf\u0db4\u0dd2\u0dbb\u0d9a\u0dba\u0dc0\u0daf.\u0db4\u0dc4\u0dd2\u0da7\u0db4\u0dd4\u0db4\u0d85\u0d9c\u0dad\u0dd0\u0dad\u0dd2\u0dc3\u0dd4 \u0dad\u0daf\u0dc0\u0dda\u0db4\u0dc0\u0d9c \u0dbb\u0da7\u0db4\u0d9a\u0dba\u0db4\u0db4\u0db1\u0dba\u0daf\u0dbb\u0dad\u0dca\u0db4\u0dd4\u0dc0\u0db4\u0dd2\u0d9a\u0dca\u0db4\u0daf\u0dca \u0dc2\u0db4],911\u0dd2\u0dbb\u0db1\u0dca\u0db4\u0d85\u0db4\u0dd2\u0db4\u0dad\u0dad\u0dd2\u0db4\u0dcf\u0dd0\u0daf\u0dd4\u0dc0 .\u0db4\u0d92\u0db4\u0dc0\u0daf\u0dc0\u0dda\u0db4\u0dad\u0dc0\u0dad\u0dca\u0db4\u0dbd \u0d9f\u0dca \u0db4\u0dc0\u0dd0\u0da9\u0db4\u0d85\u0db4\u0dd2\u0db4\u0dbd\u0daf\u0dd2\u0dbb\u0dd2\u0dc0\u0d86\u0daf\u0dd3\u0dad\u0dca\u0db4\u0dbb\u0dbb\u0dba\u0dc0\u0daf.\u0db4"
  },
