\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0db1\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dca\u0dad\u0dba\u0db1\u0dca\u0dad\u0db4\n\n\u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dad\u0dcf \u0dc3\u0dc4 \u0dc5\u0db8\u0dcf \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dc1\u0dba \u0dd2\u0dbd\u0dd2\u0dc0\u0db1\u0dca\u0dad \u0d9c\u0db1\u0dd4 \u0db1\u0db6\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c:\n\n1. \u0d9c\u0dd8\u0dc4\u0dc3\u0dca\u0dae \u0dc4\u0dd2\u0d82\u0dc3\u0db1\u0dc0\u0db1\u0da7 \u0d85\u0daf\u0dcf\u0dc5\u0dc0 \u0db1\u0dd0\u0dba\u0db6\u0db1 \u0db4\u0dd0\u0da7\u0dd4\u0dab\u0dd2\u0dd2\u0dc0\u0db1\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dd2\u0dbd\u0db1\u0dca\u0dad\u0daf\u0dd2\u0dad \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dad\u0dcf\u0dc0\u0db1\u0dca\u0dad 2005 \u0d85\u0d82\u0d9a 34 \u0daf\u0dbb\u0db1 \u0d9c\u0dd8\u0dc4\u0dc3\u0dca\u0dae \u0db4\u0dca\u200d\u0dbb\u0db1\u0da9 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0dc0\u0dd0\u0dc5\u0dd0\u0d9a\u0dca\u0dd3\u0dba\u0db8\u0dca \u0db4\u0db1\u0dad \u0dba\u0da7\u0dba\u0dad\u0dca \u0db1\u0da9\u0dd4 \u0db4\u0dd0\u0dc0\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0dd2\u0dad\u0dd2 \u0d86\u0db0\u0dcf\u0dbb \u0dba\u0d9a\u0dcf\u0da7\u0dd4\u0dc2\u0db1\u0dca\u0dad \u0dc3\u0db7\u0dcf\u0dc0 \u0dc4\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0db1\u0d82\u0d9a\u0dcf \u0dba\u0db4\u0dcf\u0dbd\u0dd3\u0dd2\u0dc0\u0dba \u0dba\u0dc0\u0dad\u0da7 \u0dba\u0dba\u0dcf\u0d9a\u0dbb \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0db4\n\n2. \u0d9c\u0dd8\u0dc4\u0dc3\u0dca\u0dae \u0db4\u0dca\u200d\u0dbb\u0db1\u0da9 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0dc0\u0dd0\u0dc5\u0dd0\u0d9a\u0dca\u0dd3\u0dba\u0db8\u0dca \u0db4\u0db1\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dc3\u0dc4 \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dad\u0dcf\u0dc0\u0db1\u0dca\u0dad \u0dc4\u0dcf \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0dc4\u0dd4\u0dab \u0dba\u0daf\u0db1 \u0dc4\u0dd2\u0d82\u0dc3\u0db1\u0dba \u0dc0\u0dd0\u0dc5\u0dd0\u0d9a\u0dca\u0dd3\u0db8 \u0dc4\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db1\u0dcf\u0dbb \u0daf\u0dd0\u0d9a\u0dca\u0dd3\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc0 \u0dba\u0db4\u0dcf\u0dd2\u0dc3\u0dca \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad, \u0dba\u0db4\u0dcf\u0dd2\u0dc3\u0dca \u0dc5\u0db8\u0dcf \u0dc4\u0dcf \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dad\u0dcf \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dcf\u0d82\u0dc1\u0dba \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad \u0dd4\u0dc5 \u0dc3\u0d82\u0dba\u0dda\u0daf\u0dd3\u0db7\u0dcf\u0dc0\u0dba \u0dc4\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db1\u0dcf\u0dbb \u0daf\u0dd0\u0d9a\u0dca\u0dd3\u0db8 \u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dc0\u0dd0 \u0dc3\u0da7\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dc0\u0dcf, \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dad\u0dcf \u0d9a\u0da7\u0dd4\u0dc0 \u0dc0 \u0dd2\u0dbd\u0db0\u0dd2\u0dba\u0da7\u0db4 \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dd0 \u0dc3\u0da7\u0dc4\u0db1\u0dca\u0dad \u0db4\u0dc3\u0dd4\u0dd2\u0dba \u0dc0\u0dc3\u0dbb\u0dc0\u0db1 \u0daf\u0dd2\u0d9c\u0da7\u0db8 \u0dc3\u0d82\u0dd2\u0dbd\u0db0\u0dcf\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dcf \u0d92\u0dc0\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4\n\n3. 2025 \u0dc0\u0dbb\u0dca\u0dbd\u0dc2\u0dba \u0da2\u0dca\u200d\u0dcf\u0dad\u0dd2\u0d9a \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dad\u0dcf \u0d9a\u0da7\u0dd4\u0dc0 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0dbb\u0dd3 \u0dc3\u0dd0\u0db1\u0dd0\u0dc3\u0dca\u0db8 \u0dba\u0da7\u0dba\u0dad\u0dca \u0daf\u0dd0\u0db1\u0dd4\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dc0\u0dd0 \u0dc3\u0da7\u0dc4\u0db1\u0d