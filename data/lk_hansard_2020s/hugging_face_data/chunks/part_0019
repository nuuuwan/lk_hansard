    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dd4\u0db8\u0db1\u0dd2, \u0d8a\u0da7 \u0dba\u0db4\u0dbb \u0db8\u0db8 \u0dba\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0db4 \u0dba\u0db8\u0dca \u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dba\u0dda \u0d8a\u0dba \u0dd2\u0dc0\u0da7 \u0dc0\u0dbb\u0dd2\u0db1\u0dca\u0dad\u0dc0\u0dbb \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0dc0\u0dd4\u0dab\u0dcf, \u0dd3\u0db8\u0dad\u0dcf\u0dc0\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dba\u0dda \u0db6\u0db1\u0dba \u0db4\u0dd2\u0dc4\u0dd2\u0dc0 \u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0\u0db4 \u0db8\u0db8 \u0d85\u0dd2\u0dbd\u0dc3\u0dca\u0dc3\u0dcf\u0dba\u0dda\u0dca \u0db1 \u0d86\u0dc3\u0db1\u0dba \u0dc3\u0d82\u0dd2\u0dbd\u0db0\u0dcf\u0dba\u0d9a\u0dc0\u0dbb\u0dba\u0dcf \u0dd2\u0dbd\u0db0\u0dd2\u0dba\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0db4 1 77\u0db1\u0dca\u0dad \u0db4\u0dc3\u0dd4\u0dc0 \u0d91\u0db8\u0dca\u0db4.\u0dc0\u0db4 \u0dba\u0dda\u0db8\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dba\u0dcf \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0dca\u200d\u0dcf\u0dad\u0dd2\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db1\u0dd2\u0dba\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dba \u0d9a\u0dbb\u0da7\u0dd4\u0db1\u0dca\u0dad \u0d85\u0dd2\u0dbd\u0dc3\u0dca\u0dc3\u0dcf\u0dba\u0dda\u0dca \u0db1 \u0d86\u0dc3\u0db1\u0dba\u0dba\u0db1\u0dca\u0dad \u0dba\u0db8\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dba\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0d87\u0dd2\u0dbd\u0dca \u0db1\u0dcf \u0dad\u0dd2\u0dba\u0db6\u0db1\u0dc0\u0dcf\u0db4 \u0d8a\u0da7 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 47\u0d9a\u0da7 \u0db4\u0dc3\u0dd4\u0dc0 \u0dad\u0db8 \u0da2\u0dca\u200d\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0dca\u200d\u0db1 \u0db6\u0db1\u0dba\u0dda\u0d9c\u0dba \u0db1\u0dd2\u0dba\u0dba\u0ddd\u0da2\u0dca\u200d\u0db