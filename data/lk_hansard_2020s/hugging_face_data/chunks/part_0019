    "chunk_text": "\u0dbd\u0daf\u0dca\" \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dc2\u0dd2\u0daf\u0dda \u0dc3\u0dd2\u0dba\u0d9a\u0dbb\u0dd2 \u0dd2\u0dbb\u0dca\u0dca\u0d9a \u0dc0\u0dad\u0dba \u0d86\u0dbb\u0dda\u0db7 \u0dd2\u0daf\u0dc5\u0dca \u0dc0\u0dd0 \u0db4\u0d82\u0dd2\u0dbb\u0daf\u0dda \u0dca \u0dc0\u0db1 \u0db0\u0dd3\u0dc0\u0dbb \u0da2\u0db1\u0dad\u0d9a\u0dc0\u0daf\u0dda \u0dd9\u0dbb\u0dd4\u0daf\u0dc0 . \u0d92 \u0dd9\u0dbb\u0dd4\u0daf\u0dc0 \u0d92\u0dd2 \u0d86\u0dbb\u0dda\u0db7 \u0dd2\u0daf\u0dc5\u0dca, \u0dad\u0dca \u0dc0 \u0dca \u0dc0\u0db1 \u0dca\u0dba\u0daf\u0dda \u0daf\u0dc4 \u0daf\u0d9c\u0dd9\u0dbb \u0dd2\u0d9a\u0dca\u0dbb 3\u0d9a\u0dca\u0dc2, 4\u0d9a\u0dca\u0dc2, 5\u0d9a\u0dca\u0dc2, 6\u0d9a\u0dca\u0dc2 \u0dc4\u0dd9\u0d9a\u0daf\u0d9c\u0db1, \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0daf\u0dc0\u0dbb\u0dc5\u0dca \u0dc5\u0dd2\u0dad\u0dca\u0dd2\u0db1\u0daf\u0dd4 \u0dd2\u0dbb\u0daf\u0d9c\u0db1. \u0dc3\u0dd2\u0dba\u0d9a\u0dbb\u0dd2 \u0dc0\u0dba\u0d9a\u0dca\u0d9a\u0dbb\u0dba \u0d91\u0dd9\u0d9a \u0db6\u0dd2\u0dda \u0dca \u0d94\u0da7\u0dd2\u0da7 \u0dc0 \u0d86\u0dbb\u0dda\u0db7 \u0dd2\u0daf\u0dc5\u0dca \u0db0\u0dd3\u0dc0\u0dbb \u0da2\u0db1\u0dad\u0d9a\u0dc0\u0daf\u0dda \u0dd9\u0dbb\u0dd4\u0daf\u0dc0 . \u0dca\u0dca \u0dbd\u0dd9 \u0d92 \u0d9c\u0dd0\u0db1 \u0dd2\u0d9a\u0dbb\u0dab\u0d9a \u0d9a\u0dba\u0dc4\u0dd2\u0dca\u0dba \u0d9a\u0dca\u0dc2 \u0d9a\u0dba\u0dba \u0dc0\u0db1 \u0db4\u0d82\u0d9a\u0daf\u0dca\u0d9a\u0daf\u0dbb\u0d9a\u0dca\u0dad\u0dd4 \u0daf\u0dc0\u0db1\u0dc0\u0d9a.\n\n\u0dbd\u0dd9 \u0d82\u0dd2\u0dd2\u0d9a\u0dc0 \u0db4\u0dd4\u0dbb\u0d9a \u0dc3\u0dd4\u0dc5\u0dd4 \u0dca\u0dad\u0dca\u0dca\u0d9a\u0dab\u0daf\u0dba \u0dc0 \u0dc0\u0dba\u0d9a\u0dca\u0d9a\u0dbb \u0dd2\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dd2\u0dbb\u0db1 guest-house \u0dc4\u0dd2\u0dd2\u0da7\u0daf\u0dba 8,000\u0d9a\u0dca\u0dc2 10,000\u0d9a\u0dca\u0dc2 \u0dc0\u0dd2\u0dad\u0dbb \u0dca \u0dc0\u0db1\u0dc0\u0d9a. \u0dca\u0dca \u0daf\u0dda \u0d9a\u0dba\u0dba \u0dc0\u0daf \u0dc0 \u0d92 \u0dbd\u0dba \u0d9c\u0dd0\u0db1. \u0d92 guest-house \u0dc4\u0dd2\u0dd2\u0da7\u0dba \u0dc0\u0da7 \u0d92 \u0db4\u0d82\u0dca\u200d\u0dbb\u0dba \u0d82\u0dd0\u0db6\u0dd2\u0d82\u0d9a \u0db1\u0dd0\u0dc4\u0dd0. \u0dca\u0dca \u0d8b\u0dd9\u0d9a\u0dc4\u0dbb\u0dab\u0dba \u0d9a\u0dca\u0dc2 \u0d9a\u0dba\u0dba \u0dc0\u0db1\u0dda. \u0dad\u0dd2\u0d9c \u0db4\u0d82 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0d9a \u0db4\u0d82 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0daf\u0dda, \u0dad\u0dd2\u0d9c \u0db4\u0d82 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0d9a \u0db4\u0d82 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0daf\u0dda guest-houses 400\u0dd2\u0da7 \u0dc0\u0dba\u0d9a \u0dad\u0dd2\u0daf\u0db4\u0db1\u0dc0\u0d9a. \u0dbd\u0daf\u0dca\" \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dc4\u0d9a \u0db4 \u0d9c\u0d82\u0dca\"\u0dca\u0dca\u0dad\u0dd2 \u0dca \u0dc0\u0dd3\u0dad\u0dd4\u0dca\u0d9a \u0daf\u0dda \u0daf\u0dc0\u0d82\u0d9a\u0daf \u0dc3\u0db7\u0d9a\u0daf \u0dca \u0dc0\u0db1\u0dc0\u0d9a\u0dd9 \u0dd9 \u0dc0\u0daf \u0dc0 \u0db1\u0dd0\u0dc4\u0dd0. \u0d91\u0dad\u0dd4\u0dca\u0d9a\u0dca \u0dd9 \u0dc0\u0db1\u0dc0\u0d9a, \u0d92 \u0dd2 \u0d94\u0dd2\u0dba \u0d91\u0dca \u0dc0\u0dba\u0d9a\u0dca\u0d9a\u0dbb\u0dba \u0dd2\u0dbb\u0daf\u0d9c\u0db1 \u0dba \u0db1 \u0db4\u0dc0. \u0d91\u0dca \u0db4\u0d82 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0daf\u0dda guest-houses 400\u0d9a\u0dca\u0dc2 \u0dc0\u0dd2\u0dad\u0dbb \u0dad\u0dd2\u0daf\u0db4\u0db1\u0dc0\u0d9a. \u0d92 guest-houses 400\u0da7 \u0dbd\u0dd9 \u0db6\u0dd2\u0dba \u0dbb\u0dca \u0daf\u0db4 \u0dad\u0d82\u0dba \u0d9a\u0dca\u0dc2 \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0d9a \u0d9c \u0dc0\u0db1 \u0dbd\u0dc0\u0dc3\u0dca\u0dae\u0d9a\u0dc0 \u0d82\u0db4\u0d9a \u0daf\u0dd9 \u0dc0\u0daf \u0dc0 \u0db1\u0dd0\u0dc4\u0dd0. \u0d92\u0dc0\u0d9a\u0da7 \u0daf\u0dca\u0d9a\u0dbd\u0dd3\u0dd2\u0db1\u0daf\u0dba \u0dc0 \u0dca\u0db1\u0dd2\u0db1\u0dc0\u0d9a, \u0dc3\u0dd4\u0dbb\u0d9a\u0db4\u0daf\u0dd4 \u0daf\u0dd9\u0dca\u0d9a\u0dbb\u0dca\u0dad\u0daf\u0dda \u0dc0\u0dad\u0dd4\u0daf\u0dc0 \u0dc0 \u0dca\u0db1\u0dd2\u0db1\u0dc0\u0d9a, \u0d9c\u0d9a \u0db4\u0d82 \u0dc3\u0dd4\u0dbb\u0d9a\u0db4\u0daf\u0dd4 \u0dc0\u0dd2\u0daf\u0dc1\u0dca\u0dc2 \u0daf\u0dca\u0daf\u0dc4\u0dba\u0dd4\u0dda \u0d92\u0dd2\u0dd2\u0daf\u0dba \u0dc0 \u0d91\u0db1\u0dc0\u0d9a, \u0dca\u0d9a\u0db1\u0daf\u0dd4\u0dbb \u0dc0\u0d82\u0d9a\u0db1 \u0daf\u0dd6\u0dc2\u0dab \u0dca\u0dbb\u0dca\u0dd9\u0db1 \u0d92\u0dd2\u0dd2\u0daf\u0dba \u0dc0 \u0d91\u0db1\u0dc0\u0d9a. \u0daf\u0dda \u0d86\u0dba \u0dad\u0db1 \u0dc4\u0dad\u0dbb\u0dca\u0daf\u0dc4 \u0dc0\u0dca \u0dc0\u0dbb\u0dca\u0dc2\u0dba \u0dd2\u0da7 \u0dad\u0dd4 \u0dc0\u0dc4\u0dad\u0dbb \u0dc0\u0dad\u0d9a\u0dc0\u0d9a\u0dca\u0dc2 \u0d87\u0dc0\u0dd2 \u0db4\u0d82\u0d9a \u0dd9\u0dba \u0d9c\u0dc4\u0db1\u0dc0\u0d9a."
