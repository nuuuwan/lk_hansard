    "chunk_text": "\u0dc0\u0dd2\u0daf\u0dc1\u0dca\u0dc2\u0daf\u0dba \u0dc0\u0dca \u0dbd\u0dc5\u0dd2 \u0d92 \u0dd2\u0d9a\u0dbb\u0dab\u0dba \u0dc0\u0dd2\u0daf\u0dda\u0dc1 \u0dd2\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d87\u0dca\u0dad\u0dd2\u0dad\u0dd4\u0dca\u0d9a\u0daf\u0dda \u0dbd\u0dc0\u0db0\u0dca\u200d\u0d9a\u0db1\u0dba \u0da7 \u0daf\u0dba \u0d9a\u0db8\u0dd4 \u0dd2\u0dbb\u0db1\u0dc0\u0d9a. \u0d9c\u0dd2\u0dba \u0dbd\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0daf\u0dda \u0da2\u0db1\u0dc0\u0d9a\u0dad\u0dca \u0dd2\u0db1\u0da7 \u0dc3\u0dd0\u0dca\"\u0dad\u0dd0\u0dda\u0db4\u0dbb\u0dca \u0dca\u0d9a\u0dc3\u0dba \u0dca \u0d91\u0d9a\u0dca\u0dc2\u0dd2 \u0daf\u0dda \u0dbd\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0daf\u0dda \u0da2\u0db1\u0dc0\u0d9a\u0dad\u0dca \u0dd2\u0db1\u0da7 \u0dc3\u0dd0\u0dca\"\u0dad\u0dd0\u0dda\u0db4\u0dbb\u0dca \u0dca\u0d9a\u0dc3\u0dba \u0dbd\u0dbb\u0daf\u0d9c\u0db1 \u0db4\u0dd0\u0dd4\u0dad\u0dc0\u0d9a\u0dca, \u0dc3\u0dd2\u0dba\u0d9a\u0dbb\u0dd2 \u0dd2\u0dbb\u0dca\u0dca\u0d9a \u0dc0\u0dad\u0daf\u0dda number of tourists\u0d82\u0d9a \u0dba \u0dda \u0db4\u0dca\u200d\u0dbb\u0dca\u0d9a\u0dab\u0dba \u0d9a\u0dca\u0dc2 \u0dc0\u0dd0\u0da2\u0dd2 \u0dc0\u0dd4\u0dab\u0d9a\u0da7 \u0d86\u0dd9\u0d9a\u0dba \u0dca \u0daf\u0dba\u0d9a\u0d82\u0dbb\u0dca \u0dd2\u0da7\u0dd2\u0dba \u0db1 100\u0d9a\u0dca\u0dc2 \u0dad\u0dca\u0db1\u0dca \u0dc0\u0dd0\u0da2\u0dd2 \u0daf\u0dc0\u0d82\u0d9a \u0dad\u0dd2\u0daf\u0db4 \u0dc0\u0daf \u0dc0. \u0d92 \u0dc0\u0d9a\u0daf\u0dda\u0dca \u0dad\u0dca\u0db1\u0dca \u0dc0\u0dd2\u0daf\u0dda\u0dc1 \u0dc1\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dd2\u0dba \u0dc0\u0daf\u0d9c \u0dc0 \u0d91\u0db1 \u0daf\u0dda\u0dc2\u0dab \u0db4\u0dca\u200d\u0dbb\u0dca\u0d9a\u0dab\u0dba . \u0d92\u0dd2\u0dca \u0daf\u0dba\u0d9a\u0d82\u0dbb\u0dca \u0dd2\u0da7\u0dd2\u0dba \u0db1 100\u0dca, 200\u0dca \u0dbd\u0dad\u0dbb \u0d9c\u0dab\u0db1\u0d9a\u0dba \u0dc0 \u0dc0\u0dd0\u0da2\u0dd2 \u0daf\u0dc0\u0d82\u0d9a \u0dad\u0dd2\u0daf\u0db4 \u0dc0\u0daf \u0dc0. \u0d92 \u0db1\u0dd2\u0dc3\u0d9a \u0daf\u0dda \u0daf\u0dca\u0d9a\u0daf\u0dc4\u0d9a\u0daf\u0dca \u0dbb\u0da7 \u0dc3\u0dca\u0dae\u0d9a\u0dc0\u0dbb \u0daf\u0dc0 \u0dc0\u0db1, \u0dab\u0dba \u0daf\u0d9c\u0dc0\u0dd2\u0da7 \u0dc0 \u0dc3\u0dca\u0dae\u0d9a\u0dc0\u0dbb \u0daf\u0dc0 \u0dc0\u0db1 \u0dc0\u0d9a\u0daf\u0dda\u0dca, \u0d86\u0db1\u0dba \u0db1-\u0dbd\u0dca\u0db1\u0dba \u0db1 \u0dca\u0dbb\u0dad\u0dbb\u0dba \u0dbd\u0da9\u0dd4 \u0dd2\u0dbb \u0d9c \u0dc0\u0db1\u0dca \u0dbd\u0db1\u0dd2\u0dc0\u0d9a\u0dbb\u0dca\u0dba \u0daf\u0dba \u0dc0\u0dca \u0daf\u0dba\u0d9a\u0d82\u0dbb\u0dca \u0d95\u0db1\u0dd1.\n\n\u0dca\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0d86\u0da9\u0dbd\u0da9\u0dd4\u0dc0 \u0dd2\u0d9a\u0d82\u0daf\u0dda \u0dd2\u0db1\u0daf\u0dd4 \u0daf\u0dc0\u0da0\u0dca\u0dba \u0dbd\u0dc0\u0dd4\u0d82\u0d9a\u0dba \u0dc0 \u0dad\u0dca\u0db1\u0dca \u0dd2\u0dd4\u0dc0\u0db1\u0d9a\u0dba \u0dd2 \u0d9c\u0dd4\u0dc0 \u0dc0 \u0daf\u0dad\u0d9a\u0dd4\u0dc0\u0daf\u0dca\u0d9a\u0dc5 \u0daf\u0dd9\u0dc0\u0db1 \u0dbd\u0daf\u0dd2\u0dba \u0dbb \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0d9a\u0dca\u0dca\u0dd2 \u0dd2\u0dbb \u0dc0\u0db1 \u0db4\u0dd0\u0dad\u0dca \u0dc0\u0dd4\u0daf\u0da9\u0dbd. \u0d92\u0dd2 \u0d87\u0dca\u0dad. \u0d92 \u0dbd\u0dba \u0da7 \u0dd9\u0dac\u0dd4\u0dc0\u0dda \u0daf\u0dd9 \u0dc0\u0db1. \u0d92\u0dd2\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba \u0d9a\u0dd4\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc4\u0dd0\u0db4\u0dd0\u0db1\u0dca, \u0dbd\u0dd9 \u0dc0\u0dd2 \u0dc1\u0d9a\u0d82 \u0dc0\u0dc1\u0daf\u0dba \u0dc0 \u0dc3\u0dd2\u0dba\u0d9a\u0dbb\u0dd2\u0dba \u0dc0 \u0d86\u0dd2\u0dbb\u0dca\u0dc2\u0dab\u0dba \u0dd2\u0dbb \u0d9c \u0dc0\u0db1 \u0db4\u0dd0\u0dad\u0dca \u0daf\u0dc0 \u0dc0\u0db1 \u0d91\u0dd2 \u0daf\u0dc4\u0dca\u0dad\u0dd4\u0dc0\u0d9a\u0dca\u0dc2 \u0dad\u0dca\u0db1\u0dca, \u0d9c\u0dd4\u0dc0 \u0dc0 \u0daf\u0dad\u0d9a\u0dd4\u0dc0\u0daf\u0dca\u0d9a\u0daf\u0dc5\u0dca \u0dca\u0dba \u0db4\u0dca\u200d\u0dbb\u0dca\u0d9a\u0dab\u0dba \u0dca\u0daf\u0dd2\u0dd2\u0dca. \u0dd2\u0db1\u0d9c\u0d9a\u0dd4\u0dc0 \u0daf\u0dc0 \u0dc0\u0db1, \u0dbd\u0daf\u0dca\" \u0dbb\u0daf \u0d94 \u0dad\u0dca\u0dca\u0dc0\u0dba \u0d9c\u0dd0\u0db1. \u0dbd\u0dd9 \u0daf\u0dca\u0dde\u0dda\u0d9c\u0dd2\u0dd2 \u0dbd\u0dd2\u0dc1\u0dba \u0d91\u0dd2\u0dad\u0dd4 \u0daf\u0dc0\u0d82\u0d9a marquees 12\u0d9a\u0dca\u0dc2 \u0d9c\u0dc4\u0d82\u0d9a \u0dad\u0dca\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0d9a\u0dbb\u0dd2\u0dba \u0dc0 \u0daf\u0d9c \u0dc0\u0dc0\u0d9a \u0d9c \u0dc0\u0db1 \u0dd2\u0db1\u0daf\u0dd4 \u0daf\u0dc0\u0d82\u0d9a \u0dad\u0dd2\u0daf\u0db4 \u0dc0\u0daf \u0dc0. \u0d92 \u0db1\u0dd2\u0dc3\u0d9a \u0dca\u0db4\u0dad\u0dd4\u0dca\u0d9a\u0da7 \u0dbd\u0dc5\u0dd2 \u0daf\u0dba \u0da2\u0db1\u0d9a\u0dc0\u0d9a\u0dca\u0dc2 \u0dd2\u0dbb \u0dc0\u0db1 \u0dd2\u0dd0\u0dca\u0dd0\u0dad\u0dd2\u0db1\u0dca. \u0dca\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dd9\u0dc0\u0dc3\u0dca\u0dc0\u0d82 \u0dbd\u0dc5\u0dd2 \u0d86\u0dd2\u0dc1\u0dd2\u0dd2 \u0dbd\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dc2\u0dab \u0dd2\u0d9a\u0dbb\u0dd2 \u0dc3\u0db7\u0d9a\u0daf \u0daf\u0dd3\u0dca \u0d92 \u0d9c\u0dd0\u0db1 \u0dd2\u0dae\u0d9a \u0dd2\u0dc5\u0d9a. \u0dd2\u0dd4\u0dc0\u0db1\u0d9a\u0dba \u0dd2 \u0d9c\u0dd4\u0dc0 \u0dc0 \u0daf\u0dad\u0d9a\u0dd4\u0dc0\u0daf\u0dca\u0d9a\u0daf\u0dc5\u0dca \u0daf\u0dd9\u0dc0\u0db1 \u0dbd\u0daf\u0dd2\u0dba \u0dbb \u0dbd\u0dc0\u0dc3 \u0dc0 \u0daf\u0dc0\u0db1\u0dd2 \u0db4 budget tourists\u0d82\u0d9a\u0da7 \u0dbd\u0da9\u0dd4\u0dca \u0d9c\u0dab\u0daf \u0dc0 \u0dbb\u0dca\u0dca\u0d82\u0d9a\u0db1 \u0d9c\u0dd4\u0dc0 \u0dc0 \u0daf\u0dad\u0d9a\u0dd4\u0dc0\u0daf\u0dca\u0d9a\u0dc5\u0dc0\u0dca \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0dd2\u0dbb \u0dc0\u0db1. \u0dca\u0dca \u0d92 \u0dc3\u0dda\u0db4 \u0dc0\u0db0\u0dca\u200d \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba \u0dc3\u0db7\u0d9a\u0d9c\u0dad \u0dd2\u0dc5\u0d9a. \u0dd9\u0dd0 \u0dc0 \u0dca\u0dca \u0dc5\u0db4 \u0d92 document \u0d91\u0dd2 \u0db1\u0dd0\u0dc4\u0dd0.\n\n\u0dba\u0dd4\u0dda\u0db0\u0dca\u200d\u0dba \u0dd2\u0d9a\u0d82\u0daf\u0dda \u0d82\u0dd0\u0db6\u0dd3 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0db1\u0dd2\u0daf\u0dba \u0d9c\u0dba \u0d9a\u0dca\u0dc2 \u0dbd\u0db1\u0dd4\u0dc0 \u0dad\u0dca\u0db1\u0dca \u0daf\u0dda \u0dca\u0d9a\u0dbb\u0dca\u0dd2\u0daf\u0dda \u0dc0\u0dad\u0dd4\u0dc0\u0da7 \u0d8b\u0da2\u0dd2 \u0dc0 \u0d9c\u0dd4\u0dc0 \u0dc0 \u0dba \u0d9a\u0db1\u0d9a \u0dba \u0dc0\u0db1 \u0db4\u0dd0\u0dc4\u0dd0 \u0d9a\u0dba\u0dba \u0d82\u0d9a \u0dbb\u0dca\u0dca\u0d82\u0d9a\u0db1\u0da7 \u0dca\"\u0daf \u0db4 \u0dc0 \u0daf\u0d9c\u0d9a\u0dba\u0db4\u0d9a\u0db1 \u0d91\u0dd2 \u0db1\u0dc0\u0dca\u0dc0\u0d82\u0d9a \u0dad\u0dd2\u0daf\u0db4 \u0dc0\u0daf \u0dc0. \u0d87\u0dca\u0dad\u0da7\u0dca London City Airport \u0d91\u0daf\u0d9a\u0dca\u0dc2 runway \u0d91\u0dd2\u0da7 \u0dc0\u0dba\u0d9a \u0daf\u0dd2\u0d9c\u0dd2 \u0dc0 \u0dc0\u0dd0\u0da2\u0dd2\u0db1\u0dca, \u0dbb\u0dca\u0dca\u0d82\u0d9a\u0db1 \u0d9c\u0dd4\u0dc0 \u0dc0 \u0daf\u0dad\u0d9a\u0dd4\u0dc0\u0daf\u0dca\u0d9a\u0daf\u0dc5\u0dca runway \u0d91\u0dd2. \u0daf\u0dca \u0dc0\u0da7\u0d9c\u0db1\u0dba \u0da7 \u0d8b\u0da2\u0dd2 \u0dc0 \u0d9c\u0dd4\u0dc0 \u0dc0 \u0dba \u0d9a\u0db1\u0d9a \u0dba \u0dc0\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0 \u0dc0 \u0db1\u0dda, \u0d82\u0dd2\u0dd2\u0d9a\u0daf \u0dca\u0d9a\u0dbb\u0dca\u0dd2\u0daf\u0dda \u0dc0\u0dad\u0dd4\u0dc0\u0da7 \u0d8b\u0da2\u0dd2 \u0dc0 \u0dba \u0dc0\u0db1 \u0db4\u0dd0\u0dad\u0dca \u0daf\u0dca\u0d9a\u0dd2\u0dd9? \u0d92 \u0d9c\u0dd0\u0db1 \u0d87\u0dc4\u0dd4\u0dc0\u0d9a\u0dca \u0dd9\u0dd0 \u0dc0 \u0d9a\u0dba\u0dba \u0db1\u0dc0\u0d9a, \u0dba\u0dd4\u0dd9 \u0dc4\u0db8\u0dd4\u0dd9\u0d9a \u0dbd\u0dca\u0d82\u0dc3\u0dca\u0dae\u0d9a\u0db1\u0dba \u0dad\u0dd2\u0daf\u0db4\u0db1\u0dc0\u0d9a \u0dd4\u0dad, \u0d92 \u0db1\u0dd2\u0dc3\u0d9a \u0db4\u0dd0\u0dad\u0dca\u0dd4\u0dad. \u0daf\u0dda \u0dba \u0db4 \u0dca\u0dd0\u0db1 \u0d9c\u0dd2\u0dba \u0dbd\u0dd9\u0dc4\u0dc3\u0dca\u0dc0\u0dd2 \u0dc0 \u0dca\u0db6\u0dca\u0dbd\u0db4\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2 \u0db4\u0d82\u0d9a, \u0dbd\u0dd9 \u0dbb\u0daf \u0d94 \u0dad\u0dd2\u0daf\u0db4\u0db1 \u0dbd\u0dc0\u0dc1\u0dba\u0dad\u0d9a\u0dc0 \u0daf\u0dca\u0dbb\u0dd4\u0dda \u0d9c \u0dc0\u0db1. \u0daf\u0dba\u0d9a\u0d82\u0dbb\u0dca \u0d86\u0dd9\u0d9a\u0dba \u0dca \u0dc0\u0dd0\u0da2\u0dd2 \u0dd2\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dca \u0dc3 \u0dc4\u0d9a, \u0dab\u0dba \u0daf\u0d9c \u0dc0\u0dca\u0da7 \u0dbd\u0dc0\u0dc1\u0dba \u0daf\u0dba\u0d9a\u0d82\u0dbb\u0dca \u0d86\u0dd9\u0d9a\u0dba \u0dca \u0dc0\u0dd0\u0da2\u0dd2 \u0dd2\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dca \u0dc3 \u0dc4\u0d9a \u0dc3\u0dd2\u0dba\u0d9a\u0dbb\u0dd2 \u0dd2\u0dbb\u0dca\u0dca\u0d9a \u0dc0\u0dad\u0dba \u0da7 \u0dbd\u0dc0\u0dc1\u0dba \u0dca\u0dc4\u0dc3\u0dd4\u0dd2\u0dda \u0dd2\u0dd2 \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0dd2\u0dbb\u0d82\u0d9a, \u0dc3\u0dd2\u0dba\u0d9a\u0dbb\u0dd2\u0dba \u0dc0 \u0dc0\u0dd0\u0da2\u0dd2\u0db4\u0dd4\u0dbb \u0daf\u0d9c \u0dc0\u0dc0\u0d9a \u0d9c\u0dd0\u0db1\u0dd3\u0dca \u0dc3 \u0dc4\u0d9a \u0dbd\u0dc0\u0dc1\u0dba \u0dc0\u0dd0\u0dba \u0dd2\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dd2\u0dd2 \u0dd2\u0dbb \u0dc0\u0db1."
