    "chunk_text": "\u0d9a\u0dd9\u0dcf\u0d9a\u0dc4\u0dcf\u0db8\u0daf \u0d91\u0d9a\u0dc4\u0db8 \u0d9a\u0dc0\u0db1\u0dca\u0d9a\u0db1\u0dca? \u0d91\u0dad\u0d9a\u0dd9\u0dcf\u0da7 \u0d85\u0db4\u0da7 \u0dbb\u0dcf\u0dca\u0db1\u0dba\u0d9a\u0dca \u0d87 \u0d9a\u0dc0\u0db1\u0dc0\u0dcf, \u0d94\u0dba\u0d9a\u0dca\u0dcf\u0dca \u0dbd\u0db1\u0dca \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0d85\u0dc0\u0dcf\u0dd9\u0dc0\u0db8 good governance \u0d9a\u0dc0\u0db1\u0dd4\u0d9a\u0dc0\u0db1\u0dca \u0d9a\u0db4\u0db8 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d94\u0dba\u0d9a\u0dca\u0dcf\u0dca \u0dbd\u0db1\u0dca \u0dad\u0db8\u0db1\u0dca\u0da7 \u0dd9\u0dd0\u0db8\u0dd0 \u0daf\u0dd6\u0dd2\u0dad \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0dd9\u0dbb\u0db1\u0dc0\u0dcf, \u0dad\u0db8\u0db1\u0dca\u0da7 \u0d85\u0dd9\u0dd0\u0db8\u0dd0 \u0daf\u0dd6\u0dd2\u0dad \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0dc0 \u0dc4\u0dd2\u0d9a\u0dbb\u0dca \u0daf\u0db8\u0db1\u0dc0\u0dcf. \u0d91\u0d9a\u0dc4\u0db8 \u0dd9\u0dbb\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0 \u0d9a\u0db1\u0dca. \u0d91\u0d9a\u0dc4\u0db8 \u0dd9\u0dbb\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0. \u0db8 \u0d9a\u0dda \u0d86\u0db0\u0dd2\u0db4\u0dad\u0dba\u0dba \u0d9a\u0db6\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca, \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0d9a\u0db8\u0dca \u0dbb\u0d9a\u0dca \u0dba\u0dc4 \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0dc4\u0daf\u0db1\u0dca\u0db1 \u0dc0\u0dd4\u0dc0\u0db8\u0db1\u0dcf\u0dc0 \u0d9a\u0db6\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca, \u0d92\u0dd9 \u0dc4\u0dbb\u0dd2 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d9a\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dad\u0db8\u0db1\u0dca\u0d9a \u0d91\u0dd9\u0dcf \u0dc0\u0dd4\u0dab\u0dad\u0dca \u0dd9\u0db8\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0, \u0dc0\u0dd0\u0dbb\u0dd0\u0daf\u0dca\u0daf\u0d9a\u0dca \u0dd9\u0d85\u0dcf \u0db1\u0db8\u0dca \u0d87\u0dd4\u0d85\u0da7 \u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1.\n\n\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dca\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2, \u0d85\u0db4\u0dd2 \u0dd9\u0dae\u0dcf \u0dd9\u0d85\u0dcf, \u0dd9\u0db1\u0dca\u0d9a\u0dca \u0db1\u0dbb\u0dca 309 \u0d91\u0db6\u0db3\u0dba\u0da7 \u0daf\u0dcf\u0db4\u0dd4 \u0d91\u0dd9 \u0dca\u0dd0\u0db1. \u0d92 \u0dca\u0dd0\u0db1 \u0d85\u0dca \u0dbd\u0dc3\u0dca \u0d9a\u0dc4 \u0daf\u0dd6\u0dc2\u0dab \u0d9a\u0da0 \u0daf\u0db1\u0dcf \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dcf\u0db1 \u0d9a\u0dd9\u0dcf\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dca \u0dbd\u0d9a\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dd9\u0dbb\u0dbd\u0dcf \u0d9a\u0db6\u0db1\u0dc0\u0dcf. \u0daf\u0dd0\u0db1\u0dca \u0d92 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dca \u0dbd\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0dd9\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0da7\u0db1\u0dca \u0dca\u0dad\u0dca\u0dad\u0dcf\u0daf? \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dca \u0dbd \u0dc0\u0dd2\u0db7\u0dcf\u0dca \u0dd9\u0dbb\u0db1\u0dc0\u0dcf\u0daf? \u0db1\u0dd0\u0dc4\u0dd0. \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0d9a\u0db8\u0dca\u0db1\u0dca\u0dd4\u0d9a\u0dda \u0d9a\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0dc0\u0dd2\u0d9a\u0dcf\u0dca\u0dc2 \u0dd9\u0dcf\u0dbb\u0dd9 \u0dc3\u0db7\u0dcf\u0dc0\u0d9a\u0dca \u0db4\u0dad\u0dca \u0dd9\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0d89\u0dca \u0dbd\u0dd4\u0dc0\u0dcf. \u0dca\u0dbb\u0dd4 \u0dd9\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0dd9\u0dd4\u0db8\u0dcf \u0d91\u0dd9\u0d9f \u0dc0\u0dd4\u0dab\u0dcf, \u0dc0\u0dd2\u0d9a\u0dcf\u0dca\u0dc2 \u0dd9\u0dcf\u0dbb\u0dd9 \u0dc3\u0db7\u0dcf\u0dc0\u0d9a\u0dca \u0db4\u0dad\u0dca \u0dd9\u0dbb\u0db1\u0dca\u0db1. \u0dc4\u0dd0\u0db6\u0dd0\u0dd2\u0d9a \u0dad\u0dc0\u0db8 \u0dd9\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0dd9\u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dda\u0d9a\u0dda \u0db1\u0dd0\u0dc4\u0dd0, \u0d92 \u0dc0\u0dd2\u0d9a\u0dcf\u0dca\u0dc2 \u0dd9\u0dcf\u0dbb\u0dd9 \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dd9\u0d85 \u0d9a\u0dba \u0da2\u0db1\u0dcf\u0dc0 \u0db4\u0dd2\u0db6\u0db3\u0dca\u0dad\u0dca\u0dad\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db4\u0d9a\u0dca\u0dc2 \u0db1\u0dcf\u0dba\u0dd9 \u0dbb\u0dd0\u0dc3\u0dca\u0dd3\u0dbb\u0d9a\u0db8\u0dca\u0daf\u0dd3 \u0d9a\u0db8\u0dca\u0dd9\u0da7 \u0d91\u0dd9\u0d9f \u0dc0\u0dd4\u0dab\u0dcf. \u0d91\u0d9a\u0dc4\u0db8 \u0d9a\u0db1\u0dca\u0daf, \u0d86\u0da9\u0dd4\u0d9a\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dcf\u0dca\u0dc0\u0d9a\u0dda \u0dbb\u0db0\u0dcf\u0db1 \u0dc3\u0dcf\u0dc0\u0dd2\u0db0\u0dcf\u0dba\u0dd9\u0dd4\u0db8\u0db1\u0dd2? \u0d85\u0db4\u0dd2 \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0dd9\u0dba\u0db1\u0dd4\u0dad\u0dca \u0db1\u0db8\u0dca \u0dd9\u0d85\u0dcf. \u0dd9\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0dd9\u0dd4\u0db8\u0dcf \u0d92\u0dd9 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9a\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d89 \u0db1\u0dca \u0d9a\u0dd9 , \u0dba\u0dc4 \u0db4\u0dcf\u0dbd\u0db1\u0dba? \u0d9a\u0dd9 , Good governance? \u0d92\u0dc0\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0db1\u0dca. \u0d87\u0dd2\u0d9a, \u0d92 \u0dc0\u0dd2\u0d9a\u0dcf\u0dca\u0dc2 \u0dd9\u0dcf\u0dbb\u0dd9 \u0dc3\u0db7\u0dcf\u0dc0 \u0db4\u0dad\u0dca \u0dd9\u0dbb\u0db1\u0dca\u0db1 \u0db7\u0dba \u0d9a\u0dc0\u0db1\u0dca\u0d9a\u0db1\u0dca? \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4 \u0dd4\u0db8\u0dcf \u0db4\u0dad\u0dca \u0dd9\u0d85 \u0dd9\u0db8\u0dd2\u0da7\u0dd4\u0d9a\u0dda \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0 \u0dca\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4 \u0dd4\u0db8\u0dcf \u0d91\u0db6\u0db3\u0dba\u0da7 \u0daf\u0dd0\u0db8\u0dca\u0d9a\u0db8\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d9a\u0dd9\u0dcf\u0d9a\u0dc4\u0dcf\u0db8 \u0dc4\u0dbb\u0dd2 \u0d85\u0db4\u0da7 \u0d92\u0dd9 \u0dbd\u0dd0\u0dd2\u0db1\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0d9a\u0db8\u0dca\u0db1\u0dca\u0dd4\u0d9a\u0dda \u0dc3\u0db7\u0dcf\u0dca\u0dad \u0dd9\u0d85\u0dcf, \u0d94\u0dba\u0d9a\u0dca\u0dcf\u0dca \u0dbd\u0db1\u0dca\u0da7 \u0db6\u0dbd\u0dcf\u0dca\u0db1\u0dca\u0db1. \u0d9a\u0db8\u0dcf\u0dd9\u0daf, \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4 \u0dd4\u0db8\u0dcf \u0d94\u0dba\u0d9a\u0dca\u0dcf\u0dca \u0dbd\u0db1\u0dca\u0da7 \u0daf\u0dd4\u0db1\u0dca\u0d9a\u0db1\u0dca\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0db1\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0. \u0d85\u0db4\u0dd2 \u0d92\u0dd9 \u0d9a\u0dd2\u0dba\u0dc0\u0dbd\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf, \u0d94\u0dba\u0d9a\u0dca\u0dcf\u0dca \u0dbd\u0db1\u0dca \u0d9a\u0dc4 \u0d9a\u0db8\u0dca \u0d9a\u0dc0\u0db1\u0dd4\u0d9a\u0dc0\u0db1\u0dca fight \u0dd9\u0dbb\u0dd2\u0d9a \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc0\u0dd2\u0d9a\u0dcf\u0dca\u0dc2\u0d9a\u0dba\u0db1\u0dca\u0db8 \u0dca\u0dbb\u0dd4 \u0d85\u0dca\u0db8\u0dd0 \u0dd4\u0db8\u0dd2\u0dba. \u0d85\u0db4\u0da7 \u0d9a\u0db4\u0d9a\u0db1\u0db1\u0dc0\u0dcf, \u0d9a\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0db1\u0dd2\u0dcf\u0dca\u0dcf\u0dda\u0daf\u0dad\u0dcf\u0dc0 \u0dbb\u0d9a\u0dd2\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc0\u0dd2\u0d9a\u0dcf\u0dca\u0dc2 \u0dd9\u0dcf\u0dbb\u0dd9 \u0dc3\u0db7\u0dcf\u0dc0 \u0db4\u0dad\u0dca \u0dd9\u0dbb\u0db1\u0dca\u0db1 \u0d91\u0dd9\u0d9f \u0dc0\u0dd4\u0dab\u0dcf\u0da7, \u0dd9\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0dd9\u0dd4\u0db8\u0dcf \u0d92\u0dd9 \u0db1\u0dd2\u0d9a\u0dda\u0daf\u0db1\u0dba \u0dd9\u0dbb\u0db1\u0dca\u0d9a\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0."
  },
