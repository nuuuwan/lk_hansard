    "chunk_text": "\"\u0d87\u0dad\u0dca\u0dad\u0da7 \u0dbb\u0db1\u0dd9\u0dcf\u0d9f\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0db1 \u0db8\u0dd2\u0dbb\u0db1\u0dc3\u0d9a\u0dc3\u0dd4 \u0d85\u0dc0\u0daf\u0dd2 \u0dbb\u0dbb\u0db1\u0dca\u0db1 \u0d9f\u0dbd\u0dca\u0db1\u0dca \u0dc0\u0dd4\u0dba\u0dad\u0dca \u0d9f\u0db6\u0dcf\u0dbb\u0dd4\u0dc0\u0da7 \u0dbb\u0db1\u0dd9\u0dcf\u0d9f\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0db1 \u0db8\u0dd2\u0dbb\u0db1\u0dc3\u0d9a\u0dc3\u0dd4 \u0d85\u0dc0\u0daf\u0dd2 \u0dbb\u0dbb\u0db1\u0dca\u0db1 \u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0dbb\u0dbb\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf, \u0d92 \u0dbb\u0dcf\u0dbd\u0dba \u0d85\u0db4\u0d9f\u0dad\u0dca \u0dba\u0db1\u0dc0\u0dcf\" \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. 2026 \u0d85\u0dba \u0dc0 \u0dba \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0dc3\u0dbb \u0da2\u0db1 \u0db6\u0dbd\u0d9f\u0dda\u0d9c\u0dba \u0d86\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0d9f\u0db8\u0dca \u0db8\u0dc4 \u0d9f\u0db4\u0dcf\u0d9f\u0dc5\u0dcf\u0d9f\u0dda \u0d87\u0dad\u0dd2\u0dc3 \u0dbb\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1 \u0dc3\u0dad\u0dba\u0dba \u0dd9\u0d9a\u0dd2\u0dd2 \u0d9a\u0dd2\u0dba\u0db1 \u0db6\u0dba\u0da7 \u0d87\u0dc3\u0d9a\u0d9f\u0dd9\u0dbb \u0dc0\u0dc4\u0d9f\u0d9c\u0db1 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dbb\u0dbb\u0db1 \u0d9f\u0db8\u0dca \u0dad\u0dbb\u0dca\u0dbb\u0dc0\u0dbd\u0da7 \u0dbb\u0dcf\u0dbd\u0dba \u0d85\u0db4\u0dbb\u0dcf\u0d9f\u0dc1 \u0dc0 \u0dba \u0dbb\u0dbb\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba \u0dd9 \u0db1\u0dd4\u0dc0\u0dad\u0dca \u0dbb\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0db4\u0dd2 \u0d92 \u0dbb\u0dcf\u0dbd\u0dba \u0dc0 \u0dba \u0dbb\u0dbb\u0db8\u0dd4, \u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0dbb\u0dbb\u0db8\u0dd4, \u0da7 \u0da7 \u0dc0\u0dc3\u0dbb\u0dbb\u0da7 \u0dbb\u0dd2\u0db1\u0dca \u0d85\u0db4\u0dd2\u0dad\u0dca \u0d91\u0d9a\u0dca\u0dbb \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8\u0d9a\u0dca \u0d87\u0dad\u0dd2\u0dc3 \u0dbb\u0dbb \u0d9c\u0dad\u0dca\u0dad \u0dd2\u0d9f\u0db8\u0dca \u0dd3.\u0dc0\u0dad\u0dca \u0d9f\u0dc0\u0db1, \u0da2\u0dcf\u0dad\u0dd2\u0dc3\u0dbb \u0da2\u0db1 \u0db6\u0dbd\u0d9f\u0dda\u0d9c\u0dba \u0d86\u0da9\u0dd4\u0d9a\u0dca\u0dc0\u0d9a\u0dca \u0db4\u0dad\u0dca \u0dbb\u0dbb\u0db1\u0dca\u0db1 \u0dbb \u0db4 \u0d9f\u0dc0\u0da0\u0dca\u0da0\u0da0 \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0dd9 \u0db1\u0dd4\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf.\n\n\u0d92 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0d9f\u0db1\u0dcf\u0d9f\u0dc0\u0dd2. \u0dad\u0dc0\u0dad\u0dca \u0db8\u0dd6\u0dbd\u0dba \u0dd9\u0dad\u0dca\u0dad \u0da7\u0dd2\u0dbb\u0d9a\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dbb\u0dbb\u0db1\u0dca\u0db1 \u0db8\u0db8 \u0d9f\u0db8\u0dca \u0d85\u0dc0\u0dc3\u0d9a\u0dae\u0dcf\u0dc0 \u0d9f\u0dba\u0dcf\u0dd9\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d89\u0dad\u0dd2\u0dc3\u0dc4\u0dcf\u0dc3\u0d9f \u0dc0 \u0da9\u0dd2 \u0db8 \u0dc3\u0dc3\u0da0\u0dcf\u0dbb\u0dbb \u0db4 \u0db8\u0dd2\u0dab\u0dd3\u0db8 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0dbb\u0dc5 \u0dc0\u0dc3\u0dbb \u0db6\u0dc0\u0da7 \u0d9f\u0db8\u0dca \u0dc0\u0dc3\u0dbb \u0db4\u0dad\u0dca \u0d9f\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0d9f\u0dda\u0db8 \u0d89\u0dad\u0dd2\u0dc3\u0dc4\u0dcf\u0dc3\u0d9f \u0dc0 \u0da9\u0dd2\u0db8 \u0dc0\u0dd2\u0d9f\u0dc1\u0dba \u0d9f\u0dda\u0dc2\u0dba \u0dc4\u0dd2\u0db8\u0dd2 \u0dc0\u0dd4\u0dab\u0dd4 \u0dc0\u0dc3\u0dbb \u0db6\u0dc0\u0da7\u0dad\u0dca 2025 \u0dc0\u0dc3\u0dbb \u0db4\u0dad\u0dca \u0d9f\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0d9f\u0dda\u0db8 \u0daf\u0dd2\u0db1\u0dbb\u0daf\u0dd3 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0dc0\u0dd6 \u0dc0 \u0da9\u0dd2\u0db8 \u0d86\u0dd9\u0dcf\u0dba\u0db8, \u0daf\u0dd2\u0db1\u0dbb\u0daf\u0dd3 \u0d89\u0db4\u0dba\u0dd6 \u0dc0 \u0da9\u0dd2\u0db8 \u0d9f\u0dbb\u0dca\u0d9c\u0dd4 \u0d86\u0dd9\u0dcf\u0dba\u0db8 \u0dc0\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dba\u0db1 27.7\u0d9a\u0dca \u0d9f\u0db1\u0dcf\u0dc0 \u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dcf\u0dc3\u0d9f 06\u0d9f\u0dc0\u0dbb\u0db1 \u0dd9\u0dcf \u0d9f\u0dbb\u0dca\u0d9c\u0dd4\u0dc0, \u0db1 \u0dad\u0dca\u0db1\u0db8\u0dca \u0d85\u0d9f\u0db4\u0dca \u0dc0\u0dbb\u0dcf\u0dba \u0d85\u0db0\u0dd2\u0dbb\u0dcf\u0dbb\u0dd2\u0dba \u0dc0\u0dd2\u0db1\u0dca\u0db1\u0dca \u0d8b\u0db4\u0dba\u0dcf\u0d9f\u0d9c\u0db1 \u0dad \u0dd2\u0dd2\u0d9f\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0d9f\u0dda\u0db8, \u0d91\u0d9a\u0dca \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0db1\u0dca\u0db1\u0dca \u0d8b\u0db4\u0dba\u0db4\u0dd4 \u0dc0 \u0da9\u0dd2\u0db8 \u0d86\u0dd9\u0dcf\u0dba\u0db8 \u0dc0\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dd2\u0dd2\u0dba\u0db1 2,000\u0d9a\u0dca \u0d8b\u0db4\u0dba\u0db1\u0dca\u0db1\u0da7 \u0d9f\u0dbb\u0dca\u0d9c\u0dd4\u0dc0 \u0dc3\u0db8\u0dad\u0dca \u0d9f\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1\u0dc0\u0dcf. \u0d9f\u0db8\u0db1\u0dca\u0db1 \u0d9f\u0db8\u0dca \u0dc0\u0dcf\u0d9f\u0dda \u0d89\u0dbd\u0d9a\u0dca\u0dbb\u0db8\u0dca\u0dc0\u0dd2\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0dbb\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1\u0dc0\u0dcf, 2025 \u0d85\u0dba \u0dc0 \u0dba \u0dbb\u0db1\u0dbb\u0db8\u0dca\u0db8 \u0d85\u0dba \u0dc0 \u0dba\u0d9a\u0dca \u0d9f\u0db1\u0dcf\u0d9f\u0dc0\u0dd2, \u0d9f\u0db8\u0dca \u0db8\u0dc4 \u0d9f\u0db4\u0dcf\u0d9f\u0dc5\u0dcf\u0d9f\u0dda \u0dba\u0dae\u0dcf\u0dbb\u0dca\u0dae\u0dba\u0d9a\u0dca \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0d9f\u0dc0\u0da0\u0dca\u0da0\u0da0 \u0d85\u0dba \u0dc0 \u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf.\n\n\u0d89\u0dad\u0dd2\u0dc3\u0dbb\u0dd2 \u0dc0\u0dd2\u0db1\u0dcf\u0da9\u0dd2 \u0d9f\u0dd9\u0dbb \u0db8\u0da7 \u0db4\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0dbb\u0dbb\u0db1\u0dca\u0db1 \u0d9f\u0dc0\u0db1\u0dc0\u0dcf \u0d9f\u0db8\u0dca \u0dbb\u0dcf\u0dbb\u0dba\u0dba \u0d9c \u0db1 \u0dbb\u0dae\u0dcf \u0dbb\u0dbb\u0db1\u0dca\u0db1. \u0d85\u0dd9 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0d9f\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0d9f\u0dda\u0daf\u0dd3 \u0dbb\u0dc5 \u0d85\u0d9f\u0db4\u0dca \u0dc4 \u0db8 \u0dbb\u0dae\u0dcf\u0dc0\u0dbb\u0daf\u0dd3\u0db8 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9f\u0dc0\u0da0\u0dca\u0da0\u0da0 \u0dbb\u0dcf\u0dbb\u0dba\u0dba \u0dad\u0db8\u0dd2 \u0d9f\u0db8\u0dca \u0dc0\u0dad\u0dd4"
