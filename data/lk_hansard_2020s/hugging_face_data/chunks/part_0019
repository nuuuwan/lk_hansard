    "chunk_text": "2024 \u0db8\u0dd4\u0dbd\u0dca \u0db8\u0dcf\u0dc3 9\u0da7 \u0dc3\u0dcf\u0d9f\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dc0 2025 \u0db8\u0dd4\u0dbd\u0dca \u0db8\u0dcf\u0dc3 9 \u0dc3\u0dc3\u0dc3\u0db1\u0dca\u0dd9\u0db1\u0dba \u0dbb\u0dbb\u0db1\u0d9f\u0dbb\u0dcf\u0da7 \u0d85\u0db4\u0db1\u0dba\u0db1 \u0d86\u0dd9\u0dcf\u0dba\u0db8 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dd2\u0dd2\u0dba\u0db1 8.5 \u0d89\u0db3\u0dbd\u0dcf, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dd2\u0dd2\u0dba\u0db1 9.1 \u0dd9\u0d9a\u0dca\u0dc0\u0dcf \u0dc0 \u0da9\u0dd2\u0d9f\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1\u0dc0\u0dcf. \u0d9f\u0db8\u0dca \u0dc0\u0dcf\u0d9f\u0dda \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0dbb \u0dd9\u0dbb\u0dca\u0dba\u0dbb, \u0db1 \u0dad\u0dca\u0db1\u0db8\u0dca \u0d85\u0db4\u0db1\u0dba\u0db1 \u0d86\u0dd9\u0dcf\u0dba\u0db8 \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0dc0\u0dd3\u0db8\u0dca\n\n1231 1232\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0d9f\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0db8\u0da7 \u0d9f\u0db4\u0dbb \u0dbb\u0dae\u0dcf \u0dbb\u0dbb\u0db4\u0dd4 \u0d85\u0d9f\u0db4\u0dca \u0d9c\u0dbb\u0dd4 \u0dbb\u0db1\u0d9f\u0dba\u0ddd\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dc3\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0dc0\u0dcf\u0d9f\u0dda \u0d85\u0d9f\u0db4\u0dca \u0dc3\u0d9f\u0dc4\u0ddd\u0dd9\u0dbb \u0dc0\u0dad\u0dd4\u0dbb\u0dbb\u0d9f \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d9f\u0dc3\u0d9a\u0dc0\u0dba\u0da7 \u0db4 \u0db8\u0dd2\u0dab\u0dd3\u0db8 \u0d9f\u0dc0\u0db1\u0dd4\u0d9f\u0dc0\u0db1\u0dca \u0daf\u0dd9\u0dbb\u0db1\u0dbb\u0dc0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 200\u0dbb \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0dc0 \u0da9\u0dd2\u0db4\u0dd4\u0dbb \u0dbd\u0db6\u0dcf \u0d9f\u0dd9\u0db1\u0dca\u0db1 \u0dbb\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dbb\u0dbb\u0db1\u0d9f\u0dbb\u0dcf\u0da7, \u0d92\u0dbb\u0da7 \u0d91\u0d9f\u0dbb\u0dc4\u0dd2\u0dc0\u0dad\u0dca \u0dbb\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dbb\u0dbb\u0db1 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba\u0d9a\u0dca \u0d85\u0dd9 \u0dbb\u0db1\u0dbb\u0dca\u0db8\u0dcf\u0dba\u0dba \u0d9f\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1\u0dc0\u0dcf. \u0dc3\u0db8\u0dc4\u0dbb \u0d85\u0dba \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db4 \u0db8\u0dd2\u0dab\u0dd2\u0dd2 \u0dbb\u0dbb\u0db1\u0dca\u0db1\u0dad\u0dca \u0dd6 \u0dd9\u0dcf\u0db1\u0db8\u0dd2\u0db1\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d91\u0dc0 \u0dbb\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0dbb\u0db1\u0dbb\u0dca\u0db8\u0dcf\u0dba\u0dba \u0d9f\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1\u0dc0\u0dcf. \u0d9f\u0db8\u0dcf\u0db1 \u0d85\u0db7\u0dd2\u0d9f\u0dba\u0ddd\u0d9c \u0d86\u0dc0\u0dad\u0dca \u0dc0\u0dad\u0dd4 \u0dbb\u0db8\u0dca\u0dbb\u0dbb\u0dd4 \u0dc3\u0d9f\u0dc4\u0ddd\u0dd9\u0dbb \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d9f\u0dc3\u0d9a\u0dc0\u0dba\u0da7 \u0db4 \u0db8\u0dd2\u0dab\u0dd3\u0d9f\u0db8\u0dca\u0daf\u0dd3 \u0daf\u0dd9\u0dbb\u0db1\u0dbb\u0dc0 \u0dbd\u0db6\u0dcf\u0d9f\u0dd9\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 1,750\u0dbb \u0dc0 \u0da7\u0dd4\u0db4, \u0d91\u0d9f\u0dc4\u0db8 \u0db1 \u0dad\u0dca\u0db1\u0db8\u0dca \u0dbb\u0da2\u0dba \u0db8 \u0daf\u0dd2\u0dc4\u0dad\u0dca \u0d9f\u0dc0\u0dbd\u0dcf \u0dbd\u0db6\u0dcf\u0d9f\u0dd9\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 200\u0dbb \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dc0 \u0d85\u0dbb\u0db1\u0dc0\u0dcf\u0dbb\u0dca\u0dba\u0d9f\u0dba\u0db1\u0dca\u0db8 \u0dbd\u0db6\u0dcf \u0d9f\u0dd9\u0db1\u0dca\u0db1 \u0dbb\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dbb\u0dbb\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7\u0dad\u0dca \u0d92\u0dbb \u0dbb\u0dbb\u0db1\u0dc0\u0dcf.\n\n\u0dbb\u0dcf\u0da2\u0dba \u0d9f\u0dc3\u0d9a\u0dc0\u0dbb\u0dba\u0db1\u0dca\u0da7 \u0dbb \u0dca \u0dbb\u0dae \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0\u0dad\u0dca \u0daf\u0dd2\u0d9c\u0dd2\u0db1\u0dca \u0daf\u0dd2\u0d9c\u0da7\u0db8 \u0dbb\u0dae\u0dcf \u0dbb\u0dc5\u0dcf. \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dba\u0db1 12,500\u0d9a\u0dca \u0daf\u0dd3\u0dbd\u0dcf \u0dbb\u0da2\u0d9f \u0d9f\u0dc3\u0d9a\u0dc0\u0dbb\u0dba\u0db1\u0dca\u0da7 \u0dbb \u0dca \u0dbb\u0dae \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8\u0da7\u0dad\u0dca \u0d91\u0d9f\u0dbb\u0dc4\u0dd2\u0dc0 \u0d9f\u0db8\u0dca \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0d9f \u0dc3\u0db8\u0dc4\u0dbb \u0dbb\u0da9\u0dd4\u0d9a\u0da9\u0dcf\u0dba\u0db8\u0dca \u0d85\u0dd9\u0dc4\u0dc3\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dbb\u0dcf\u0dba \u0dbb\u0dc5\u0dcf. \u0d9c\u0dbb\u0dd4 \u0dbb\u0db1\u0d9f\u0dba\u0ddd\u0da2\u0dba \u0dbb\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0dbb\u0dad\u0dd4\u0db8\u0dbb\u0db1, \u0dbb\u0dcf\u0da2\u0dba \u0d9f\u0dc3\u0d9a\u0dc0\u0dba \u0dbb\u0dcf\u0dbb\u0dca\u0dba\u0d9a\u0dca\u0dc2\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dbb\u0dcf\u0da2\u0dba \u0d9f\u0dc3\u0d9a\u0dc0\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dbb \u0dca \u0dbb\u0dae 1,750\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0d9f\u0dd9\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d9c\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc3\u0dad\u0dd4\u0db8\u0dcf \u0db4 \u0dc4 \u0daf\u0dd2\u0dd2\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dbb\u0dcf\u0dba \u0dbb\u0dc5\u0dcf. \u0d92 \u0dc3\u0db3\u0dc4\u0dcf\u0dad\u0dca \u0db8\u0dd4\u0dd9\u0dbd\u0dca \u0d9f\u0dc0\u0db1\u0dca \u0dbb\u0dbb \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1\u0dc0\u0dcf. \u0dc4 \u0db6 \u0dd2, \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0dbb \u0dca \u0dbb\u0dae\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0d9f\u0dd9\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0dbb \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0dbb\u0dcf\u0dbb\u0dba\u0dba\u0d9a\u0dca \u0d9f\u0db1\u0dcf\u0d9f\u0dc0\u0dd2. \u0d9c\u0dbb\u0dd4\n\n\u0dbb\u0db1\u0d9f\u0dba\u0ddd\u0da2\u0dba \u0dbb\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0dbb\u0dad\u0dd4\u0db8\u0dbb\u0db1, \"\u0d9f\u0db4\u0dcf\u0d9f\u0dc4\u0dcf\u0dc3\u0dad\u0dca \u0dbb\u0da7\u0d9a\u0dca - \u0dbd\u0dc3\u0d9a\u0dc3\u0db1 \u0dd3.\u0dc0\u0dd2\u0dad\u0dba\u0d9a\u0dca\" \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0db4\u0dad\u0dca\u0dad\u0dd2\u0dc3 \u0db4\u0dca\u200d\u0dbb\u0dbb\u0dcf\u0dba\u0db1\u0d9f 194\u0dc0 \u0dbb\u0db1 \u0db4\u0dd2\u0da7\u0dd4\u0d9f\u0dda \u0d85\u0db4\u0dd2 \u0dd2\u0dba\u0dcf \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1\u0dc0\u0dcf, \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0d9f\u0dda \u0db0\u0dd4\u0dbb \u0dbb\u0dcf\u0dbd\u0dba\u0da7 \u0dc3\u0dd3\u0db8\u0dcf\u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dbb \u0dca \u0dbb\u0dae\u0dba\u0d9a\u0dca, \u0db1 \u0dad\u0dca\u0db1\u0db8\u0dca \u0dc0\u0dcf\u0dc4\u0db1\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0d9f\u0dd9\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d91\u0db8 \u0db0\u0dd4\u0dbb \u0dbb\u0dcf\u0dbd\u0dba\u0da7 \u0db4\u0db8\u0dba\u0d9a\u0dca \u0dc3\u0dd3\u0db8\u0dcf \u0dbb\u0dbb\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0d91\u0db8 \u0dc0\u0dcf\u0dc4\u0db1 \u0dbd\u0db6\u0dcf \u0d9f\u0dd9\u0db1\u0dc0\u0dcf. \u0dd9 \u0db1\u0dca \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf, \u0d92\u0dbb\u0da7 \u0d89\u0db1\u0dca\u0db0\u0db1\u0dad\u0dca \u0d9f\u0dd9\u0db1\u0dca\u0db1 \u0dba\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d89\u0db1\u0dca\u0db0\u0db1 \u0d85\u0dbd\u0dd4\u0dad\u0dd2\u0dc3\u0db1\u0dca \u0d9f\u0dd9\u0db1\u0dca\u0db1 \u0d9f\u0dd9\u0dba\u0d9a\u0dca \u0db1 \u0dc4 , \u0dc4 \u0db8 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0d9f\u0dba \u0da7\u0db8 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0d9f\u0dd9\u0db1\u0dc0\u0dcf. \u0d85\u0d9f\u0db4\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0d9f\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7, \u0d87\u0db8\u0dad\u0dd2\u0dc3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0dbd\u0db6\u0dcf \u0d9f\u0dd9\u0db1 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dc0 \u0d9c\u0db1\u0dca\u0d9f\u0db1\u0dca \u0db1 \u0dc4 . \u0d9f\u0db8\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0d9f\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0d9f\u0dda \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7\u0dad\u0dca \u0d85\u0dd9\u0dcf\u0dc5\u0dc0 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0d9f\u0dd9\u0db1\u0dc0\u0dcf. \u0d92 \u0dbb\u0db1\u0dc3\u0dcf \u0dbb \u0dca \u0dbb\u0dae \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf, \u0d92\u0dc0\u0dcf\u0da7 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0dbd\u0db6\u0dcf \u0d9f\u0dd9\u0db1\u0dca\u0db1 \u0dbb\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dbb\u0dbb\u0db1\u0dca\u0d9f\u0db1\u0dca \u0db1 \u0dc4 ."
