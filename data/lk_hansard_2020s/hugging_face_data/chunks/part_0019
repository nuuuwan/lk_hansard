    "chunk_text": "2024 \u0db4\u0d85\u0db8\u0dd4 \u0db8\u0dcf\u0dc3 \u0db1\u0dc0\u0dba \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc3\u0db7\u0dcf\u0db1\u0dcf\u0dba\u0dd9 \u0dd9\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0d9a\u0dda \u0d9a\u0db4\u0dde\u0daf\u0dca\u0dca\u0dd2\u0dd9 \u0dd9\u0dcf\u0dbb\u0dca\u0dba \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dbd\u0d9a\u0dca\u0dc2 59\u0d9a\u0dca \u0dc0\u0dd2\u0dba\u0daf\u0db8\u0dca \u0dd9\u0dbb\u0dbd\u0dcf \u0d9a\u0db6\u0db1\u0dc0\u0dcf. \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dc0\u0dd0\u0da9\u0dd2\u0dd3\u0dbb\u0db8\u0dad\u0dca \u0d91\u0d9a\u0dca\u0dd9 \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0dba\u0daf\u0db8\u0dca \u0dd9\u0dbb\u0dbd\u0dcf \u0d9a\u0db6\u0db1\u0dca\u0d9a\u0db1\u0dca \u0dbd\u0d9a\u0dca\u0dc2 55\u0dd9 \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca. \u0d85\u0db4\u0dd2 \u0d92 \u0db8\u0dd4\u0daf\u0dbd\u0dad\u0dca \u0dc0\u0dd2\u0dba\u0daf\u0db8\u0da7 \u0d91\u0dd9\u0dd4 \u0dd9\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0db4\u0dd2 \u0d91\u0dad\u0dd0\u0db1\u0dad\u0dca \u0dbd\u0d9a\u0dca\u0dc2 \u0d91\u0dd9\u0dc4\u0db8\u0dcf\u0dbb\u0dd9\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0d89 \u0dbb\u0dd2 \u0dd9\u0dbb\u0dbd\u0dcf \u0d9a\u0db6\u0db1\u0dc0\u0dcf. \u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dba \u0dba\u0dd4\u0dd4 \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dc0\u0dd0\u0da9\u0dd2\u0dd3\u0dbb\u0db8\u0d9a\u0dd4\u0dad\u0dca \u0d91\u0d9a\u0dca\u0dd9 \u0dad\u0db8\u0dd2\u0d9a \u0d92 \u0dc0\u0dd2\u0dba\u0daf\u0db8\u0dca \u0d91\u0db1\u0dca\u0d9a\u0db1\u0dca. \u0db8\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d9a\u0db6\u0db1\u0dca\u0d9a\u0db1\u0dca \u0d9a\u0db8\u0dba\u0dd2\u0d9a. \u0dc3\u0db7\u0dcf\u0db1\u0dcf\u0dba\u0dd9 \u0dd9\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba\u0da7 \u0db6\u0db3\u0dc0\u0dcf \u0dca\u0db1\u0dca\u0db1 \u0db4\u0dd4 \u0dc0\u0db1\u0dca \u0dc4\u0dd0\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0d9a\u0dca\u0db8 \u0db6\u0db3\u0dc0\u0dcf \u0d9a\u0dca\u0db1 \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0db4\u0dd2 \u0d91\u0d9a\u0dc4\u0db8\u0dad\u0dca \u0d89\u0dd4\u0dbb\u0dd4 \u0dd9\u0dbb\u0dbd\u0dcf \u0d9a\u0db6\u0db1\u0dc0\u0dcf. \u0dc3\u0db7\u0dcf\u0db1\u0dcf\u0dba\u0dd9 \u0d9a\u0dca \u0dd9\u0db8\u0dca\u0dd4\u0db8\u0dcf, \u0d92 \u0dd9\u0dcf\u0dbb\u0dca\u0dba \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0d9a\u0dda \u0d89\u0db1\u0dca\u0db1 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0db8\u0dc4\u0dad\u0dca\u0db8 \u0db8\u0dc4\u0dad\u0dca\u0dd3\u0da7\u0db1\u0dca\u0da7 \u0d85\u0db4\u0dd2 \u0dc3\u0dca\u0dd4 \u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dc0\u0db1\u0dc0\u0dcf. \u0dca\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4 \u0dd4\u0db8\u0db1\u0dd2, \u0d94\u0db6\u0dd4\u0db8\u0dcf \u0d9a\u0db8\u0dca \u0dd9\u0dcf\u0dbb\u0dab\u0dba \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0db8\u0db8 \u0daf\u0db1\u0dca\u0d9a\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db4\u0d85\u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dad\u0dcf\u0dc0\u0da7 \u0dad\u0db8\u0dd2\u0d9a \u0dc3\u0db7\u0dcf\u0db1\u0dcf\u0dba\u0dd9 \u0dd9\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0d9a\u0dda \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dd2\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0d9a\u0daf\u0dca\u0dcf\n\n\u0dc3\u0dcf\u0da0\u0dcf\u0dbb\u0dba\u0dd9\u0da7 \u0dd2\u0dc0\u0d9a\u0dda. \u0dc0\u0dd2\u0d9a\u0dcf\u0dca\u0dc2\u0d9a\u0dba\u0db1\u0dca\u0db8 \u0d9a\u0db8\u0dca \u0dd9\u0dcf\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0daf \u0d9a\u0dca \u0dd9\u0db8\u0dca \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0d9a\u0dda \u0d89\u0db1\u0dca\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0da7 \u0d9a\u0db8\u0dca\u0d9a\u0d9a\u0dca \u0d85\u0daf\u0dcf\u0d85 \u0dbb\u0db8\u0dcf\u0dab\u0dba \u0d85\u0daf\u0dcf\u0d85 \u0dd9\u0dbb\u0dca\u0db1\u0dca\u0db1. \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0d9a\u0dca \u0dd9\u0db8\u0dca \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0dba \u0dbb\u0da7 \u0dba\u0db1\u0dc0\u0dcf \u0dc0\u0dd0\u0da9\u0dd2\u0dd2\u0d9a. \u0d87\u0dad\u0dca\u0dad\u0da7\u0db8 \u0dc0\u0dd0\u0da9\u0dd2\u0dd2\u0d9a. \u0db8\u0db8 \u0db4\u0dd4\u0daf\u0dd4\u0db8 \u0dc0\u0dd4\u0dab\u0dcf.\n\n\u0dca\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4 \u0dd4\u0db8\u0db1\u0dd2, \u0db8\u0db8 \u0d94\u0db6\u0dd4\u0db8\u0dcf\u0d9a\u0dca\u0db1\u0dca \u0d89\u0dca \u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dcf, \u0d94\u0db6\u0dd4\u0db8\u0dcf\u0d9a \u0db6\u0dbd\u0dba \u0db4\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0da0\u0dd2 \u0dd9\u0dbb\u0dbd\u0dcf \u0d92 \u0d9a\u0daf\u0dca\u0dc0\u0dca \u0dc0\u0dbd\u0da7 \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0d9a\u0dc0\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d85\u0db4\u0dd2 \u0d9a\u0db8\u0dca \u0dbb\u0d9a\u0dca \u0da2\u0db1\u0dc0\u0dbb\u0db8 \u0d85\u0dbb\u0d9a\u0dca\u0db1 \u0d9a\u0db6\u0db1\u0dca\u0d9a\u0db1\u0dca \u0d91\u0dc4\u0dcf \u0db4\u0dd0\u0dad\u0dca\u0d9a\u0dad\u0dca \u0d89\u0db1\u0dca\u0db1 \u0d9a\u0daf\u0dca\u0dcf\u0db4\u0dcf\u0dbd\u0db1\u0da5\u0dba\u0db1\u0dca\u0d9a \u0dc0\u0dd0\u0dbb\u0dd0\u0daf\u0dd2 \u0db8\u0dd9\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0d9a\u0db1\u0dcf\u0d9a\u0dc0\u0dd2\u0d9a. \u0d92\u0dd9\u0da7 \u0d9a\u0dca\u0dcf\u0daf\u0dd4\u0dbb\u0dd4 \u0d9a\u0dc0\u0dbd\u0dcf, \u0d92 \u0db8\u0dad\u0dca\u0d9a\u0dad\u0dca\u0db8 \u0dd2\u0dc0\u0dc4\u0dd2\u0dca \u0dbd\u0dcf, \u0dc0\u0dbb\u0dbb\u0dc3\u0dcf\u0daf \u0db8\u0dad\u0dca\u0d9a\u0dad\u0dca\u0db8 \u0db1\u0da7\u0db1 \u0db1\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0db4\u0dd0\u0d85\u0dd0\u0db1\u0dca \u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0db8 \u0dad\u0dd0\u0db1\u0db8 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d92\u0dc0\u0dcf\u0dad\u0dca \u0d9a\u0dc0\u0db1\u0dc3\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0db8\u0dd2\u0d9a \u0d85\u0db4\u0da7 \u0db6\u0dbd\u0dba \u0dbd\u0dd0\u0dd2\u0db1\u0dbd\u0dcf \u0d9a\u0db6\u0db1\u0dca\u0d9a\u0db1\u0dca. \u0db8\u0db8 \u0dca\u0dbb\u0dd4\u0dad\u0dca\u0dc0\u0d9a\u0dba\u0db1\u0dca \u0d94\u0db6\u0dd4\u0db8\u0dcf\u0d9a\u0dca\u0db1\u0dca \u0d89\u0dca \u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dcf, \u0da2\u0db1\u0dc0\u0dbb\u0db8\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0db4\u0dcf\u0dbb\u0dca\u0dd2 \u0d9a\u0db8\u0dca\u0db1\u0dca\u0dd4 \u0dc3\u0db8\u0dca\u0dbb\u0daf\u0dcf\u0dba\u0dba\u0db1\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0dd9\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0d92 \u0dd9\u0da7\u0dba\u0dd4\u0dd4 \u0dd9\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf.\n\n\u0dca\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0db4 \u0dd4\u0db8\u0db1\u0dd2, \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0dba\u0da7 \u0d87\u0dc0\u0dd2\u0dca \u0dbd\u0dcf \u0d85\u0daf \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dca\u0d9a\u0db1\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0d9a\u0db8\u0dca\u0db1\u0dca\u0dd4\u0d9a\u0dda 101\u0dc0\u0dd0\u0db1\u0dd2 \u0dbb\u0dd0\u0dc3\u0dca\u0dd3\u0dbb\u0db8. \u0d85\u0db4\u0dd2 \u0db4\u0db1\u0dad\u0dca 22\u0d9a\u0dca \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dd9\u0dbb\u0dbd\u0dcf \u0d9a\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dcf\u0dad\u0dba\u0dd4\u0db8\u0dd2\u0dba\u0d9a\u0dca\u0db1\u0dca \u0dbb\u0dcf\u0dca\u0db1 30\u0d9a\u0dca \u0d85\u0dc4\u0dbd\u0dcf \u0d9a\u0db6\u0db1\u0dc0\u0dcf. \u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbb \u0db1\u0dd2\u0d9a\u0dba \u0dca 27\u0ddb2) \u0dba\u0da7\u0d9a\u0dad\u0dca \u0db4\u0d9a\u0dca\u0dc2 \u0db1\u0dcf\u0dba\u0dd9\u0dba\u0db1\u0dca \u0dbb\u0dcf\u0dca\u0db1 112\u0d9a\u0dca \u0d85\u0dc4\u0dbd\u0dcf \u0d9a\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u0dd2\u0d9a\u0db1\u0dca 96\u0dd9\u0da7 \u0d9a\u0db8\u0dca \u0dd9\u0dcf\u0dbd\u0dba \u0dd4\u0d85\u0daf\u0dd3 \u0db4\u0dd2\u0db6\u0db3\u0dd4\u0dbb\u0dd4 \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0dbd\u0dcf \u0d9a\u0db6\u0db1\u0dc0\u0dcf. \u0dc3\u0db7\u0dcf\u0dc0 \u0dd9\u0dca \u0dad\u0db6\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0d9a\u0dda \u0d86\u0da9\u0dd4\u0d9a\u0dca \u0db4\u0d9a\u0dca\u0dc2\u0d9a\u0dba\u0db1\u0dca \u0d9a\u0dba \u0da2\u0db1\u0dcf 25\u0d9a\u0dd4\u0dad\u0dca, \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0 \u0db4\u0d9a\u0dca\u0dc2\u0d9a\u0dba\u0db1\u0dca \u0d9a\u0dba \u0da2\u0db1\u0dcf 35\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dca\u0db1\u0dd0\u0dca \u0dbd\u0dcf \u0dc3\u0dcf\u0dd9\u0da0\u0dca\u0da0\u0da1\u0dcf \u0dd9\u0dbb\u0dbd\u0dcf \u0d9a\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0d9a \u0db8 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0d9a\u0db8\u0dca\u0db1\u0dca\u0dd4\u0d9a\u0dda \u0d8b\u0db4\u0d9a\u0daf\u0dca\u0dcf\u0dd9 \u0dd9\u0dcf\u0dbb\u0dd9 \u0dc3\u0db7\u0dcf 2(\u0d9a\u0dca, \u0d9a\u0dc0\u0db1\u0dca \u0d9a\u0dc0\u0db1\u0dca \u0dc0\u0dcf\u0d9a\u0dba\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0dbb\u0dd0\u0dc3\u0dca\u0dd3\u0dbb\u0db8\u0dca 55\u0d9a\u0dca \u0dba\u0dbd\u0dcf \u0d9a\u0db6\u0db1\u0dc0\u0dcf. \u0dc3\u0db8\u0dc4\u0dbb \u0d8b\u0db4\u0d9a\u0daf\u0dca\u0dcf\u0dd9 \u0dd9\u0dcf\u0dbb\u0dd9 \u0dc3\u0db7\u0dcf \u0dd9\u0dd2\u0db1\u0dca \u0db6\u0dd4\u0dab\u0dd4 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0d9a\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc0 \u0dda\u0d9a\u0dda\u0db8 \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0dc0\u0dcf\u0d9a \u0db8 \u0d92\u0dc0\u0dcf\u0d9a\u0dda \u0d8b\u0db4\u0d9a\u0daf\u0dca\u0dcf\u0dd9 \u0dd9\u0dcf\u0dbb\u0dd9 \u0dc3\u0db7\u0dcf \u0d85\u0db1\u0dd4\u0dd9\u0db8\u0dd2\u0da7\u0dd4 \u0dc4\u0dad\u0dbb\u0dd9\u0da7 \u0d85\u0daf\u0dcf\u0d85 \u0dbb\u0dd0\u0dc3\u0dca\u0dd3\u0dbb\u0db8\u0dca \u0dc0\u0dcf\u0dbb 33\u0d9a\u0dca \u0dba\u0dbd\u0dcf \u0d9a\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u0dad\u0d9a\u0dd9\u0dcf\u0da7, \u0d92\u0dc0\u0dcf\u0d9a\u0dda \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca \u0d9a\u0dd9\u0dcf\u0da0\u0dca\u0da0\u0da0\u0dbb \u0dc0\u0dd0\u0da9 \u0dd9\u0dbb\u0db1\u0dc0\u0dcf\u0daf? \u0dc0\u0dd2\u0d9a\u0dcf\u0dca\u0dc2\u0d9a\u0dba\u0db1\u0dca\u0db8 \u0d9a\u0daf\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0db4\u0d85 \u0dc3\u0dc4 \u0dd4\u0db1\u0dca\u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0db4\u0d85 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca."
