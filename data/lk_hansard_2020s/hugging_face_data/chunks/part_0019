    "chunk_text": "\u0daf\u0dd0\u0db1\u0dca \u0d87\u0db8 \u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d86\u0db4\u0db1\u0dca \u0dc3\u0dd3\u0db8\u0dcf \u0db1\u0dd2\u0dbb\u0dca\u0dab\u0dba \u0dd9\u0da7\u0dba\u0dd4\u0dd4 \u0dd9\u0dbb\u0dbd\u0dcf \u0dd9\u0dbb\u0db1\u0dca\u0db1 \u0dd2\u0dc0\u0d9a\u0dba\u0dcf\u0dad\u0dca \u0db4\u0d85\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0da1\u0db1\u0dca\u0daf\u0dba \u0dc0\u0dcf\u0d9a \u0d9a\u0dc0\u0db1\u0dc0\u0dcf. \u0daf\u0dd0\u0db1\u0dca \u0db4\u0d85\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf \u0db8\u0dd0 \u0dc0\u0dbb\u0dab\u0dba \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0d9a\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dc0\u0da7 \u0d9a\u0dba \u0da2\u0db1\u0dcf\u0d9a\u0dc0\u0dcf\u0dad\u0dca \u0d85\u0db4\u0dd2\u0da7 \u0db4\u0dbb\u0dab \u200d\u0dbb\u0db8\u0dba\u0da7\u0db8 \u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4 \u0dc0\u0db1\u0dca. \u0db4\u0dbb\u0dab \u200d\u0dbb\u0db8\u0dba \u0db1\u0dbb\u0dd9\u0dd2\u0d9a \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0 \u0d9a\u0db1\u0dca. \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0d9a\u0dc3\u0dca\u0dbd\u0dcf\u0dad\u0dca \u0db4\u0d85\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0d9a\u0dda \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf \u0d9a\u0db1\u0dca? \u0daf\u0dd0\u0db1\u0dca \u0d9a\u0db8\u0dad\u0dd0\u0db1 \u0d89\u0db1\u0dca\u0db1 \u0d9a\u0dca\u0dcf\u0da9\u0dcf\u0d9a\u0dca \u0d9a\u0daf\u0d9a\u0db1\u0d9a\u0dca \u0db4\u0d85\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0db1\u0dd2\u0d9a\u0dba \u0da2\u0db1\u0dba \u0dd9\u0dbb\u0db1\u0dca\u0db1 \u0d87 . \u0d85\u0db4\u0dd2\u0dad\u0dca \u0db4\u0d85\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0db1\u0dd2\u0d9a\u0dba \u0da2\u0db1\u0dba \u0dd9\u0d85\u0dcf. \u0daf\u0dd0\u0db1\u0dca \u0d9a\u0db8\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0d9a\u0db8\u0dca\u0db1\u0dca\u0dd4\u0d9a\u0dda \u0d9a\u0db6\u0db1\u0dca\u0d9a\u0db1\u0dca \u0dc3\u0db8\u0dcf\u0db1\u0dd4\u0db4\u0dcf \u0dd9 \u200d\u0dbb\u0db8\u0dba\u0d9a\u0db1\u0dca \u0db1\u0dbb\u0dd9\u0dd2\u0d9a \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0 \u0d9a\u0db1\u0dca. \u0daf\u0dd0\u0db1\u0dca \u0d9a\u0db8\u0dca \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4 \u0d87\u0dc0\u0dd2\u0dca \u0dbd\u0dcf \u0d89\u0db1\u0dca\u0d9a\u0db1\u0dca. \u0daf\u0dd0\u0db1\u0dca \u0d9a\u0db8\u0dca \u0dca\u0dd0\u0db1 \u0db8\u0dd4\u0dd2\u0db1\u0dca\u0db8 \u0d94\u0db6\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0d9a\u0dda \u0d85\u0dba \u0dad\u0db8\u0dd2\u0d9a \u0d9a\u0dd2\u0dda\u0d9a\u0dda, \"\u0db8\u0db1\u0dcf\u0db4 \u0db6\u0dbd\u0dd4 \u0d9a\u0db4\u0dcf\u0dbb\u0dba\" \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0daf\u0dd0\u0db1\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0d9a\u0dc0\u0db1\u0dc3\u0dca. \u0d9a\u0db8\u0dca \u0dc3\u0db8\u0dcf\u0db1\u0dd4\u0db4\u0dcf \u0dd9 \u0da1\u0db1\u0dca\u0daf \u200d\u0dbb\u0db8\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9a\u0db1\u0dca \u0d89\u0dad\u0dcf \u0dbb\u0da2\u0dcf\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0daf\u0dd3 \u200d\u0dbb\u0db8\u0dba\u0d9a\u0dca. \u0d91\u0dd9 \u0db4\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0da7 \u0da1\u0db1\u0dca\u0daf\u0dba \u0d9a\u0daf\u0db1\u0dc0\u0dcf. \u0d85\u0d9a\u0db1\u0d9a\u0dca \u0db4\u0dd0\u0dad\u0dca\u0d9a\u0dad\u0db1\u0dca \u0da1\u0db1\u0dca\u0daf \u0daf\u0dcf\u0dba\u0dd9\u0dba\u0dcf\u0da7 \u0d85\u0dd2\u0d9a \u0dc0\u0dcf\u0dc3\u0dd2\u0dd9\u0db8\u0d9a\u0dca \u0d9a\u0db6\u0db1\u0dc0\u0dcf \u0db8\u0db1\u0dcf\u0db4\u0dba\u0d9a\u0dca \u0daf\u0dd3\u0dbd\u0dcf \u0dad\u0db8\u0db1\u0dca \u0dd9\u0dd0\u0db8\u0dd0 \u0d9a\u0dd9\u0db1\u0dcf \u0dbd\u0dd0\u0dd2\u0d9a\u0dc3\u0dca\u0dd4\u0d9a\u0dc0\u0db1\u0dca \u0d9a\u0dad \u0dbb\u0dcf \u0dca\u0db1\u0dca\u0db1. \u0d89 \u0db1\u0dca \u0d92\u0dd9 \u0d89\u0dad\u0dcf \u0d89\u0dc4\u0d85 \u0db8\u0dca \u0da7\u0d9a\u0db8\u0dca \u0dbb\u0da2\u0dcf\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0daf\u0dd3 \u200d\u0dbb\u0db8\u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0db8\u0db8 \u0daf\u0d9a\u0dd2\u0db1\u0dc0\u0dcf. \u0d89 \u0db1\u0dca \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0d9a\u0db8\u0db1\u0dca\u0db1 \u0d9a\u0db8\u0dca\u0dc0\u0dcf \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0dd9\u0dbb \u0dca\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dc4\u0dd0\u0db8 \u0d9a\u0daf\u0dba\u0dd9\u0da7\u0db8 \u0d9a\u0da0 \u0daf\u0db1\u0dcf \u0dd9\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0d89\u0db1\u0dca\u0d9a\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0db4\u0dd2 \u0dbd\u0dd0\u0dc4\u0dd0\u0dc3\u0dca \u0dd2\u0d9a \u0dc3\u0dcf\u0db0\u0db8 \u0dba \u0d9a\u0dc0\u0db1\u0dc3\u0dca\u0dd9\u0db8\u0dca\u0dc0\u0dbd\u0da7 \u0dbb\u0d9a\u0dca \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d9a\u0dc0\u0db1\u0dd4\u0d9a\u0dc0\u0db1\u0dca \u0d85\u0d9a\u0dda \u0dc3\u0dc4\u0d9a\u0dba \u0dca\u0dba \u0dbd\u0db6\u0dcf \u0d9a\u0daf\u0db1\u0dca\u0db1. \u0d85\u0db4\u0dd2 \u0d9a\u0dd9\u0dcf\u0dd2\u0d9a\u0db8 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dd9\u0dc0\u0dad\u0dca \u0d92\u0dc0\u0dcf\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0\u0dc0 \u0dc0\u0dd0\u0da9 \u0dd9\u0dbb\u0db1\u0dca\u0d9a\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0."
  },
