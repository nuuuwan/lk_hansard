    "chunk_text": "\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dd2\u0db1\u0dca \u0db1\u0dad\u0dca\u0dcf\u0dc3\u0dc0 \u0db1\u0dd2\u0daf\u0dc4 \u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dcf\u0db1\u0dba\u0db1\u0dca \u0db1 \u0dcf\u0dba\u0dcf \u0db6\u0dbd\u0dcf \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dca\u0dcf\n\n\u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dad\u0dca, \u0d92 \u0dd2\u0dc5\u0dd2\u0dad\u0db6\u0db3\u0dc0 \u0dc3\u0dd2\u0dba \u0db1\u0dba\u0ddd\u0da2\u0db1\u0dcf \u0dc4\u0dcf \u0db1\u0dd2\u0dbb\u0dca\u0db1 \u0dc1\u0dba\u0dd3\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dad\u0dca \u0dc0\u0db1 \u0dc0\u0dd2\u0db1\u0dc1\u0dba\u0dd3\u0dba\u0db1\u0dc2 \u0d9a\u0dcf\u0dc3\u0d9a \u0dc0\u0dcf\u0dc0\n\n\u0ba4\u0b95\u0bc6\u0bbe\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1 \u0ba4\u0bc1\u0bae\u0bb1\u0bae\u0bc1\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 323 \u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0b95\u0bb2\u0ba9\u0bcd\u0b95\u0bae\u0bb3 \u0b95\u0b9f\u0bcd\u0b9f\u0bc6\u0bbe\u0baf \u0ba4\u0baa\u0bcc\u0ba4\u0bbf\u0b95\u0baa\u0bcd\n\n\u0b85\u0ba4\u0ba9\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u0ba4\u0bc8\u0bc6\u0bbe\u0bb4\u0bbf\u0bb5\u0bc1\u0b95\u0bae\u0bb3\u0baf\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba4\u0baa\u0bcd\u0baa\u0bc1\u0bae\u0bb0\u0b95\u0bae\u0bb3\u0baf\u0bc1\u0bae\u0bcd \u0b9a\u0bc8\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bc8\u0bc6\u0bbe\u0ba9\n\n\u0ba4\u0ba4\u0bc6\u0bbe\u0bbf\u0b95\u0bc1\u0bb4\u0bc1 SELECT COMMITTEE TO LOOK INTO AND\n\nREPORT TO PARLIAMENT ON THE RELEASE OF 323 CONTAINERS FROM\n\nTHE PORT OF COLOMBO WITHOUT UNDERGOING MANDATORY\n\nPHYSICAL INSPECTION AND SUBMIT ITS PROPOSALS AND RECOMMENDATIONS IN THAT REGARD\n\n\u0d9c\u0dd4 \u0d9c\u0dba\u0db1\u0dca\u0dad\u0dca \u0d9a\u0dd4\u0dab\u0dcf\u0dad\u0dd2\u0dbd\u0d9a \u0db8\u0dc4\u0dad\u0dca\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b95\u0baf\u0ba8\u0bcd\u0ba4 \u0b95\u0bb0\u0bc1\u0ba3\u0bc6\u0bbe\u0ba4\u0bbf\u0bb2\u0b95\u0bcd\u0b95) (The Hon. Gayantha Karunathilleka) \u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0db8\u0db1\u0dd2, \u0db8\u0dcf \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0dba\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf:\n\n\"\u0d9c\u0dbb\u0dd4 \u0dc3\u0da2\u0dd2\u0dad\u0dca \u0dba\u0dda\u0db8\u0daf\u0dcf\u0dc3 \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0db8\u0dba\u0db1\u0ddd \u0d9c\u0dba\u0db1\u0dca\u0dad\u0dc3\u0db1\u0dca\u0dad \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0dbb\u0dd3 \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0dad\u0dd2\u0dad\u0dd2\u0db1 \u0db1\u0dcf\u0db8\u0dca \u0dbb\u0dcf\u0da2\u0dca\u200d\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0dc2\u0dcf\u0dab\u0d9a\u0dca\u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad \u0dbb\u0dcf\u0da2\u0dca\u200d\u0db4\u0dd4\u0daf\u0dca\u0dad\u0dca\u0dad\u0dd2\u0dbb\u0db1\u0dca\u0dad \u0dbb\u0dcf\u0dc3\u0db8\u0dcf\u0dab\u0dd2\u0d9a\u0dca\u0d9a\u0db8\u0dca \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0d91\u0dc3\u0dca\u0db4 \u0d91\u0db8\u0dca\u0db4 \u0db8\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dcf\u0dbb\u0dca\u0dbd \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 (\u0daf\u0dc0\u0daf\u0dba) \u0db4\u0dad\u0dca\u0db8\u0db1\u0dcf\u0daf\u0db1\u0dca\u0dad \u0dc3\u0dad\u0dba\u0dd2\u0d82\u0d9c\u0db8\u0dca \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0da2\u0dd3\u0dc0\u0db1\u0dca\u0dad \u0dba\u0dad\u0dcf\u0db1\u0dca\u0dad \u0db8\u0db1\u0dca\u0dad \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0dba\u0d9a\u0dca\u0db4 \u0d9a\u0dcf\u0daf\u0dbb\u0dca\u0dbd \u0db8\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dca\u0dad \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0d85\u0da7\u0dd4\u0dbb\u0dca\u0dbd\u0dad\u0db1\u0dcf\u0daf\u0db1\u0dca\u0dad \u0d85\u0daf \u0d9a\u0dca\u0d9a\u0db1\u0db1\u0dcf\u0daf\u0db1\u0dca\u0dad \u0db8\u0dc4\u0dad\u0dcf\n\n\u0d9c\u0dbb\u0dd4 \u0dad\u0dd2\u0dad\u0dd2\u0db1 \u0daf\u0dba\u0dcf\u0dd2\u0dc0\u0dbb\u0dd2 \u0da2\u0dca\u200d\u0dba\u0dba\u0dc3\u0dca\u0d9a\u0dbb \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 (\u0daf\u0dc0\u0daf\u0dba) \u0dbb\u0dcf\u0db8\u0db1\u0dcf\u0daf\u0db1\u0dca\u0dad \u0d85\u0dbb\u0dca\u0dbd\u0da0\u0dca\u0dd4\u0db1\u0dcf \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 (\u0d86\u0db1\u0dcf\u0dbb\u0dca\u0dbd\u0dba) \u0dc4\u0dbb\u0dca\u0dbd\u0dc2 \u0daf \u0dd2\u0dc0\u0dca \u0dc0\u0dcf \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0d9c\u0dba\u0db1\u0dca\u0dad\u0dad \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dad\u0dd2\u0db1\u0d9a \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 .\u0dc0\u0db4 \u0dd3\u0db4 \u0db1\u0dcf\u0db1\u0d9a \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0db1\u0dcf\u0db8\u0dbb \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0daf\u0dc3\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0d9a\u0db6\u0dd3\u0dbb\u0dca\u0dbd \u0dc4\u0dc2\u0dd3\u0db8\u0dca \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0dad\u0dd2\u0dad\u0dd2\u0db1 \u0db1\u0da7\u0dd4\u0db1\u0dca\u0dad\u0daf\u0dca\u200d\u0dbb\u0dcf\u0dab\u0dd3 \u0d9a\u0dd2\u0dbb\u0dd2\u0d87\u0dca \u0db1 \u0db8\u0dc4\u0dad\u0dca\u0da7\u0dd4\u0dba \u0d9c\u0dbb\u0dd4 \u0d91\u0db8\u0dca\u0db4 \u0d92\u0db4 \u0d91\u0db8\u0dca\u0db4 \u0dad\u0dcf\u0dc4\u0dd2\u0dbb\u0dca\u0dbd \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dad\u0dd2\u0dad\u0dd2\u0db1 \u0d91\u0db8\u0dca\u0db4 \u0db1\u0dd2\u0dc3\u0dcf\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dd2\u0dba\u0db4\u0dca\u0db4\u0dbb\u0dca\u0dbd \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0d85\u0da2\u0dd2\u0dad\u0dca . \u0db4 \u0dba\u0db4\u0dba\u0dbb\u0dca\u0dbd\u0dbb\u0dcf \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0db1\u0dca\u0dad \u0db6\u0da9 \u0dcf\u0dbb \u0da2\u0dca\u200d\u0dba\u0db8\u0dc4 \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0d9a\u0dd2\u0d82\u0dc3\u0dca \u0dba\u0db1\u0dca \u0dc3\u0db1\u0dca\u0dad \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0dba\u0dda\u0db4\u0dd3\u0db8\u0db4 \u0d85\u0db1\u0dc0\u0dd4\u0dc0\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0d9a\u0dbb\u0da2\u0dd2\u0db6\u0dd4\u0dbb\u0dca\u0dbd \u0dbb\u0dc4\u0dd4\u0db8\u0dcf\u0db1\u0dca\u0dad \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0db1\u0dcf\u0db1\u0d9a \u0db8\u0dcf\u0daf\u0dd4 \u0dba\u0d9c\u0dcf \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 (\u0d86\u0db1\u0dcf\u0dbb\u0dca\u0dbd\u0dba) \u0d91\u0db8\u0dca\u0db4 \u0d91\u0dca \u0db4 \u0d92\u0db4 \u0d91\u0db8\u0dca\u0db4 \u0dc4\u0dd2\u0dc3\u0dca\u0db6\u0dd4\u0dca \u0db1\u0dcf\u0dc4\u0dca \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0dba\u0dc4\u0d9a\u0dca\u0da7\u0dbb\u0dca\u0dbd \u0d85\u0db4\u0dca\u0db4\u0dd4\u0daf\u0dca\u0dc4\u0dcf\u0da7\u0dd4 \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0dda\u0dd2\u0dda\u0db4 \u0d91\u0da0\u0dca\u0db4 \u0d91\u0db8\u0dca\u0db4 \u0db0\u0dbb\u0dca\u0dbd\u0db8\u0dba\u0dc3\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0db6\u0dd3\u0db4 \u0d86\u0dbb\u0dd2\u0dba\u0dc0\u0d82\u0dc1 \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0d91\u0db8\u0dca\u0db4\u0d91\u0dc3\u0dca\u0db4 \u0d8b\u0daf\u0dd4 \u0db8\u0dcf\u0dba\u0db1\u0dda\u0dba\u0dda \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0d91\u0db8\u0dca\u0db4\u0d91\u0dc3\u0dca\u0db4 \u0d85\u0dda\u0daf\u0dd4 \u0dca \u0dc0\u0dcf\u0dc4\u0dd2\u0dda \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0dba\u0d9a\u0dca\u0db4 \u0dc3\u0dd4\u0da2\u0dd2\u0dad\u0dca \u0dc3\u0d82\u0da2\u0dca\u200d\u0dba \u0dba\u0db4\u0dba\u0dbb\u0dca\u0dbd\u0dbb\u0dcf \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0dad\u0dd2\u0dad\u0dd2\u0db1 \u0dad\u0dca\u200d\u0dcf\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db1\u0dca\u0dad\u0daf\u0dd4 \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0dc4\u0dbb\u0dca\u0dbd\u0dc2\u0dab \u0dbb\u0dcf\u0da2\u0dca\u200d\u0d9a\u0dbb\u0dd4\u0dab\u0dcf \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0dba\u0dbb\u0ddd\u0dc4\u0dab \u0db6\u0d82 \u0dcf\u0dbb \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0d89\u0dc3\u0dca\u0db8\u0dcf \u0dca \u0d9a\u0dbb\u0dad\u0dca\u0dd4 \u0dba\u0db8\u0dcf\u0dba\u0dc4\u0dcf\u0db8\u0da9\u0dca \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0dba\u0dc4\u0dca\u0dc2\u0dcf \u0dd2\u0dbd\u0dad\u0dcf\u0db1\u0dba\u0dda \u0d85\u0d82\u0d9a\u0dd4\u0db9\u0dd4\u0dbb \u0d86\u0dbb\u0da0\u0dca\u0dad\u0dca \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0dc0\u0dbb\u0dd4\u0dab \u0dd2\u0dba\u0db1\u0dba\u0dda \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0db1\u0dd4\u0dbb \u0d9c\u0db1\u0db4\u0dca\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0da2\u0dd3\u0db4\u0da2\u0dd3\u0db4 \u0dba\u0db4\u0dcf\u0db1\u0dca\u0dad\u0db1\u0db8\u0dca\u0db6\u0db1\u0db8\u0dca \u0db8\u0dc4\u0dad\u0dcf \u0d9c\u0dbb\u0dd4 \u0daf\u0dd2\u0dd2\u0dad\u0dca \u0da2\u0dca\u200d\u0dba\u0dd3\u0dbb \u0db8\u0dc4\u0dad\u0dcf"
