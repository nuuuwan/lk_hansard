    "chunk_text": "\u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0daf\u0dca\u200d\u0dba\u0d9a \u0d9c\u0dab\u0db8\u0dcf\u0dc0 \u0dd4\u0dbb\u0dcf \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db6\u0dbd \u0db8\u0dab\u0dca\u0dca\u0dbd\u0dba \u0dad\u0dd4\u0db8\u0dc5 \u0d87\u0dad\u0dd0\u0db8\u0dca \u200d\u0dbb\u0dd2\u0dba\u0dcf\u0daf\u0dca\u200d\u0dcf\u0db8\u0dba\u0db1\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd4\u0dc4\u0dab\u0dca, \u0dc4\u0dc3\u0dca\u0dbd\u0dc0\u0d9a \u0db8\u0dd9\u0dad\u0dca\u0db8 \u0db8\u0dd9\u0dad\u0dca\u0db8\u0dd3\u0db1\u0dca \u0d85\u0dad\u0dbb, \u0d86\u0dba\u0dad\u0db8\u0dc4\u0dda \u0d8b\u0db1\u0dca\u0db8\u0dd2\u0dba \u0d8b\u0dc4\u0daf\u0dca\u200d\u0dc3\u0dca\u0dcf \u0dc3\u0dca\u0daf\u0dca\u0db7\u0dcf\u0dc0\u0dc4\u0dba\u0db1\u0dca \u0dc3\u0dca\u0d9a\u0dc3\u0dca\u0dbd \u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0d91\u0dad\u0dbb\u0db8\u0dca \u0dc4\u0db8\u0dcf\u0db1\u0dd2\u0dbd \u0d91\u0d9a\u0d9f\u0dad\u0dcf \u0dc3\u0dca\u0dd9 \u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c, \u0d91\u0dc4\u0dd9\u0db8 \u0db8\u0dd0\u0dad\u0dca\u0db8\u0db8\u0dca synergies \u0db8\u0dad. \u0db1\u0db8\u0db8 \u0dc0\u0dd2\u0dba\u0daf\u0dca\u200d\u0db8 \u0d85\u0dd4 \u0d9a\u0dbb \u0d9c\u0dd0\u0db8\u0da7\u0db8\u0da7 \u0d85\u0daf\u0dca\u200d\u0dcf\u0dc5 \u0dc4\u0dbb\u0ddd\u0d9c \u0dc0\u0dd2\u0db1\u0dd2\u0dba\u0dbd\u0da0\u0dba \u0d9a\u0dbb \u0d9c\u0dd0\u0db8\u0da7\u0db8\u0da7 \u0d85\u0dc0\u0dba\u0dba \u0dc0\u0dd2\u0db1\u0dd2\u0dc0\u0dd2\u0daf\u0dca\u200d\u0db7\u0dcf\u0dc0\u0dba \u0dc4\u0db8\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0dba\u0da7\u0dc4\u0dad\u0dca \u0dc0\u0dd0' \u0dba\u0db8\u0dc0\u0dcf. \u0d86\u0dbb\u0db8\u0dca\u0db7\u0dc4\u0dda\u0daf\u0dd3 \u0d86\u0dba\u0dad\u0db1\u0dd2\u0d9a \u0dc0\u0dd2\u0dba\u0daf\u0dca\u200d\u0db8\u0dca \u0dc3\u0dd4\u0dc5\u0dd4 \u0dc0\u0dba\u0dc4\u0dba\u0db1\u0dca \u0dc0\u0dd0\u0da2\u0dd2 \u0dc4\u0dc0\u0db1\u0dca\u0db8\u0da7 \u0db8\u0dca\u0d9a\u0dca \u0dd2\u0db6\u0dd4\u0dab\u0dad\u0dca, \u0dc4\u0db8\u0dca \u0dca\u200d\u0dbb\u0dd2\u0dc3\u0dca\u0dcf\u0dc3\u0dca\u0dbd\u0d9a\u0dbb\u0dab \u0db8\u0dd2\u0db1\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d9a\u0dcf\u0dc4\u0dda \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db6\u0dbd \u0d9a\u0dca\u0dad\u0dc4\u0dc2\u0dbd\u0dad\u0dca\u200d\u0dbb\u0dc4\u0dda \u0d87\u0dd2 \u0d87\u0dad\u0dca\u0dad \u0dc4\u0dbb\u0ddd\u0d9c\u0dba \u0dc4\u0dd9\u0dcf\u0dba\u0dcf\u0dc4\u0d9c\u0db8 \u0dc4\u0db6\u0dc4\u0dd9\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db8 \u0db4\u0dd9\u0dc3\u0dd4 \u0dc4\u0dc0\u0db8\u0dc0\u0dcf. \u0d85\u0dc4\u0db8\u0d9a\u0dca\u0dad \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0dad\u0db8\u0dba\u0dd2, \u0d86\u0dc4\u0dba\u0ddd\u0db1\u0db8 \u0dd4\u0db8\u0db8 \u0d86\u0d9a\u0dcf\u0dbb\u0dc4\u0dba\u0db1\u0dca \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db6\u0dbd \u0d9a\u0dca\u0dad\u0dc4\u0dc2\u0dbd\u0dad\u0dca\u200d\u0dbb\u0dba\u0da7 \u0d86\u0dc0\u0dad\u0dca \u0d92 \u0d86\u0dc4\u0dba\u0ddd\u0db1\u0db8\u0dc0\u0dbd \u0dca\u200d\u0dbb\u0dd2\u0dbd\u0dcf\u0db7 \u0dbd\u0db6\u0dcf\u0d9c\u0db1\u0dca\u0db8\u0da7 \u0dc4\u0dc0\u0db1\u0dca\u0dc4\u0db1\u0dca \u0db8\u0dd2\u0dd2\u0dba\u0db8 22\u0d9a\u0dca\u0dad \u0dc0\u0db8 \u0d85\u0dc4\u0dda \u0dbb\u0dc4\u0dda \u0db1\u0db8\u0dad\u0dcf\u0dc0\u0da7. \u0d92 \u0db1\u0dd2\u0dc3\u0dca\u0dcf \u0db1\u0db8\u0dad\u0dcf \u0dc4\u0daf\u0dca\u0db4\u0dc5 \u0dc0\u0dd2\u0dd4\u0dab\u0dcf \u0d86\u0dc4\u0dba\u0ddd\u0db1\u0db8 \u0d9a\u0dd0\u0db3\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0db8\u0dc0\u0dcf \u0dc4\u0dc0\u0dd4\u0dc0\u0dc0\u0da7 \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0db6\u0dbd \u0db1\u0db8\u0db8\u0dba, \u0dc3\u0dca\u0db8\u0dca\u0dc4\u0dda\u0dc2\u0dab\u0dba, \u0dc4\u0db6\u0daf\u0dca\u200d\u0dcf \u0dd9\u0dd0\u0dbb\u0dd3\u0db8 \u0dc3\u0dca\u0dd9 \u0db4\u0daf\u0dca\u0dca\u200d\u0dd2 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db8\u0dba\u0da7 \u0d85\u0dc0\u0dba\u0dba \u0d86\u0dc4\u0dba\u0ddd\u0db1\u0db8 \u0dc4\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dd2\u0d9a \u0d85\u0dcf\u0dba\u0dba \u0dc3\u0dca\u0db8\u0d9f \u0d92\u0d9a\u0dcf\u0db6\u0daf\u0dca\u0dca\u200d\u0dc0 -public-private partnership \u0d86\u0d9a\u0dcf\u0dbb\u0dba\u0da7 - \u0dc4\u0d9c\u0db1\u0dca\u0dc0\u0dcf \u0d9c\u0dd0\u0db8\u0da7\u0db8\u0da7 \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0dc0\u0dd2\u0dad\u0dc0 \u0dc0\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db8\u0dc0\u0dcf. \u0dc4\u0db8\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db8 \u0db1\u0db8\u0dad\u0dcf\u0dc0\u0dcf\u0daf\u0dd3 \u0dca\u200d\u0dbb\u0dd2\u0dc3\u0dca\u0dcf\u0dc3\u0dca\u0dbd\u0d9a\u0dbb\u0dab \u0dd9\u0dbb\u0dd9\u0dcf \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0d86\u0dc4\u0dba\u0ddd\u0db1\u0db8\u0dc0\u0dbd\u0da7 \u0d85\u0dc4\u0dda \u0dc0\u0dd2\u0daf\u0dd4\u0dd2 \u0d9a\u0dca\u0dad\u0dc4\u0dc2\u0dbd\u0dad\u0dca\u200d\u0dbb\u0dba \u0dc0\u0dd2\u0dc0\u0dd2\u0dad \u0dc4\u0dc0\u0db8\u0dc0\u0dcf. \u0dc0\u0dd2\u0db1\u0dd2\u0dc0\u0dd2\u0daf\u0dca\u200d\u0db7\u0dcf\u0dc0\u0dba \u0dc0\u0dd0\u0da2\u0dd2 \u0dc4\u0dc0\u0db8\u0dc0\u0dcf. \u0dad\u0dbb\u0d9c\u0d9a\u0dcf\u0dbb\u0dd3\u0dad\u0dca\u0dc0\u0dba \u0dc0\u0dd0\u0da2\u0dd2 \u0dc4\u0dc0\u0db8\u0dc0\u0dcf. \u0d91\u0db8\u0dd2\u0db1\u0db1\u0dca \u0dca\u200d\u0dbb\u0db8 \u0dca\u200d\u0dbb\u0db8\u0dc4\u0dba\u0db1\u0dca \u0db4\u0dcf\u0dbb\u0dd2\u0dc4\u0db7\u0ddd\u0d9c\u0dd2\u0d9a\u0dba\u0dcf\u0da7 \u0dc4\u0d9c\u0dc0\u0db1\u0dca\u0db8\u0da7 \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0db8 \u0db8\u0dd2\u0dbd \u0d85\u0dd4 \u0dc4\u0dc0\u0db8\u0dc0\u0dcf.\n\n969 970\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dc4\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\n\n\u0db8\u0daf\u0dd2\u0dbb\u0dd2 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0dd9\u0dad\u0dc4\u0dbb\u0dca\u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0dc4\u0db8\u0d9c\u0dcf\u0dc4\u0dc0\u0dcf\u0dda 1,200\u0d9a\u0dca\u0dad \u0dc3\u0dca\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dab \u0d9a\u0dbb\u0db8\u0dc0\u0dcf. \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc4\u0db1\u0dca, \u0dc0\u0dc3\u0dca\u0dbb\u0d9a\u0da7 \u0dc4\u0db8\u0d9c\u0dcf\u0dc4\u0dc0\u0dcf\u0dda 300\u0d9a\u0dca\u0dad \u0d91\u0d9a\u0dad\u0dd4\u0db8 \u0d9a\u0dbb \u0d9c\u0dad\u0dca\u0dad\u0dad\u0dca \u0d85\u0dc4\u0dda target \u0d91\u0d9a\u0da7 \u0dba\u0db1\u0dca\u0db8 \u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d85\u0dc4\u0dda \u0dca\u200d\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dd2 \u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dba\u0db8\u0dc4\u0dda -\u0d85\u0db4\u0dd2 \u0db1\u0db8\u0dad\u0dcf\u0dc0 \u0d91\u0d9a\u0dca\u0dad\u0d9a \u0d9c\u0dd9\u0dd4 \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0dc4\u0db8\u0dca- \u0d9a\u0dd2\u0dba\u0dd4 \u0dc4\u0daf\u0dca \u0d85\u0db4\u0dd2 \u0dc3\u0dca\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dab \u0d9a\u0dbb\u0db8\u0dc0\u0dcf. \u0dd9\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d85\u0dc4\u0dda \u0dc0\u0dd2\u0dc4\u0dba\u0dbd\u0dc2\u0dad\u0dca\u0dc0\u0dba \u0dc4\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0dad\u0daf\u0dca\u200d? \u0d85\u0db4\u0dd2 \u0dc4\u0db8\u0dca \u0dd6 \u0dbb\u0dca\u0dba \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0dba \u0db8\u0dd2\u0dbd\u0da7 \u0d9c\u0db1\u0dca\u0dc4\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0dd0\u0daf\u0dd2 \u0db8\u0dd2\u0dbd \u0dc4\u0d9c\u0dc0\u0dbd\u0dcf. \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc4\u0db1\u0dca \u0d86\u0dc4\u0dba\u0ddd\u0db1\u0d9a\u0dba\u0dcf\u0da7 \u0daf\u0dca\u200d, \u0dc3\u0dca\u0db4\u0dba\u0db1\u0dca\u0db8\u0dcf\u0da7 \u0daf\u0dca\u200d \u0dc3\u0dca\u0dcf\u0dca\u200d\u0dcf\u0dbb\u0dab \u0db8\u0dd2\u0dbd\u0d9a\u0dca\u0dad \u0dbd\u0db6\u0dcf \u0dc4\u0daf\u0dca\u200d\u0db8 \u0d85\u0dad\u0dc4\u0dbb\u0dca \u0db1\u0db8\u0dad\u0dcf\u0dc0\u0da7 \u0daf\u0dca\u200d \u0dc3\u0dca\u0dcf\u0dca\u200d\u0dcf\u0dbb\u0dab \u0db8\u0dd2\u0dbd\u0d9a\u0dca\u0dad \u0dbd\u0dd0\u0dc4\u0db6\u0db8 \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0dba \u0db8\u0dd2\u0dbd\u0daf\u0dd3 \u0d9c\u0db1\u0dca\u0db8\u0dc0\u0dcf."
