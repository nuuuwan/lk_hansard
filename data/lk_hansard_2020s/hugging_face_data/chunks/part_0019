    "chunk_text": "\u0d8a\u0dc5\u0dd9\u0da7, \u0dba\u0dba \u0dad\u0dd2\u0dc3\u0dbb\u0dc3\u0dbb\u0db7\u0dcf\u0dc0\u0dba \u0dc3\u0dc4\u0dad\u0dd2\u0dc3\u0dbb \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d85\u0d9f\u0db4\u0dca \u0d8b\u0db4\u0dcf\u0dba \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dd2\u0dbb \u0dc0 \u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0d9f\u0dc0\u0d9f\u0dc5\u0d9a \u0dc0\u0dd2\u0d9f\u0dba\u0d9a\u0dc2 \u0d85\u0dbb\u0db8\u0dd4\u0dba\u0d9a\u0dca. \u0d9f\u0db8\u0dca\u0dbb \u0d9c \u0db1 \u0dc0\u0dd2\u0d9f\u0dba\u0d9a\u0dc2\u0d9f\u0dba\u0db1\u0dca\u0db8 \u0db8\u0db8 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dbb\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0da7 \u0da7 \u0dbb\u0dd2\u0db1\u0dca \u0d9f\u0db8\u0dca \u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dc0 \u0d86\u0db8\u0db1\u0dca\u0dbb\u0dba\u0dba \u0dbb\u0dbb\u0db4\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dba\u0dcf \u0d9f\u0db8\u0dca \u0dba\u0dba \u0dad\u0dd2\u0dc3\u0dbb\u0dc3\u0dbb\u0db7\u0dcf\u0dc0\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0d9f\u0dba\u0db1\u0dca \u0d85\u0db4\u0da7 \u0dc0 \u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0d9f\u0dc0\u0dc5\u0d9a\u0dca \u0db1 \u0dc4 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dad\u0db8\u0dd2 \u0d9a\u0dd2\u0dda\u0d9f\u0dda. \u0dc0\u0dd2\u0d9f\u0dba\u0d9a\u0dc2\u0d9f\u0dba\u0db1\u0dca\u0db8 \u0db8\u0dad\u0d9a\u0dca \u0dbb\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1, \u0d9f\u0db8\u0dca \u0dc0\u0db1 \u0dc0\u0dd2\u0da7\u0dad\u0dca \u0dba\u0dba \u0d9f\u0dc3\u0d9a\u0dc0\u0dcf\u0dbb\u0dbb\u0dba \u0dbb\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dbd \u0dc3 \u0dbd\u0d9a\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dad\u0dd2\u0dc3\u0dba\u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0dbb\u0dbb\u0d9f\u0d9c\u0db1 \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1 \u0db6\u0dc0. \u0d9f\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0dd9 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0d85\u0db4\u0dd2 \u0dad\u0dc0\u0dad\u0dca \u0d9f\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0d89\u0dad\u0dd2\u0dc3\u0dbb\u0dd2 \u0d9f\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1\u0dca\u0d9f\u0db1\u0dca \u0d9f\u0da9\u0dcf\u0dbd\u0dbb\u0dca \u0db8\u0dd2\u0dd2\u0dba\u0db1 487\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dba\u0dba\u0d9a\u0dca. \u0d85\u0db4\u0dd2 \u0d92 \u0db8\u0dd4\u0dd9\u0dbd \u0d9f\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0dd6 \u0dd9\u0dcf\u0db1\u0db8\u0dd2\u0db1\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0d9f\u0db1\u0dcf\u0d9f\u0dc0\u0dd2, 2028 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0da7 \u0d85\u0db4\u0dd2 \u0dba\u0db1\u0dca\u0d9f\u0db1\u0dca \u0d9f\u0dbb\u0dcf\u0d9f\u0dc4\u0dcf\u0db8\u0dd9 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0d9f \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dba \u0d85\u0d9f\u0db4\u0db1\u0dca \u0d87\u0dc4\u0dd4\u0dc0\u0dcf. \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0d9f \u0d89\u0db3\u0db1\u0dca \u0d85\u0db4\u0da7 \u0dc1\u0d9f\u0dda\u0dc2 \u0dc3\u0dc4\u0d9c\u0dad \u0dc0\u0dd2\u0d9f\u0dda\u0da0\u0db1 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dbb\u0dbb\u0db1 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9f\u0db1\u0dca \u0d9f\u0db8\u0da0\u0dca\u0da0\u0da0\u0dbb\u0dd2. \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0d9f\u0dc3\u0d9a\u0dbd\u0dcf \u0dbb\u0dbd\u0db6\u0dbd \u0d9f\u0dc0\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf. \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0d9f\u0dc3\u0d9a\u0dbd\u0dcf \u0db6\u0dbd\u0dcf\u0d9f\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0db1. \u0d9f\u0db8\u0dca \u0dbb\u0d9f\u0dda \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0dad\u0db8\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db1\u0dca\u0d9f\u0dc3\u0d9a\u0dbd\u0dcf\u0dc0 \u0dad\u0dd2\u0dc3\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0dad \u0db1 \u0dad\u0dd2\u0dc3\u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1\u0dc0\u0dcf.\n\n2025\u0da7 \u0dc3\u0dcf\u0d9f\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dc0 \u0d87\u0d9f\u0db8\u0dbb\u0dd2\u0dbb\u0dcf\u0db1\u0dd4 \u0d9f\u0da9\u0dcf\u0dbd\u0dbb\u0dca \u0db8\u0dd2\u0dd2\u0dba\u0db1 761\u0dbb \u0dc0 \u0da9\u0dd2\u0db4\u0dd4\u0dbb \u0db8\u0dd4\u0dd9\u0dbd\u0d9a\u0dca \u0dad\u0db8\u0dd2 \u0d85\u0db4\u0da7 2028 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0d9f\u0dc1 \u0d9f\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1\u0dca\u0d9f\u0db1\u0dca. \u0d92 \u0db8\u0dd4\u0dd9\u0dbd \u0d9f\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0dd6 \u0dd9\u0dcf\u0db1\u0db8\u0dca \u0d9f\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0dbb\u0dcf\u0dbd \u0db4\u0dbb\u0dd2\u0da0\u0dca\u0da0\u0d9f\u0dda\u0dd9\u0dba \u0dad\u0dd4\u0dc5 \u0dc0 \u0da9 \u0dbb\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dbb\u0dbb\u0db1\u0dc0\u0dcf. \u0dd9 \u0db1\u0da7\u0db8\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3 \u0dbd\u0dc3\u0dd4\u0db8\u0dca \u0dc3\u0dbb\u0dc3\u0d9a \u0dbb\u0dbb \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1 \u0db6\u0dc0 \u0d9f\u0db8\u0dca \u0d9f\u0dc0\u0dbd\u0dcf\u0d9f\u0dda \u0db8\u0db8 \u0dc0\u0dd2\u0d9f\u0dba\u0d9a\u0dc2\u0d9f\u0dba\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dbb\u0dbb\u0db1\u0dca\u0db1\u0da7 \u0d85\u0dc0\u0dba\u0dba\u0dd2.\n\n\u0d92 \u0dc0\u0dcf\u0d9f\u0dda\u0db8 \u0db8\u0dad\u0d9a\u0dca \u0dbb\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0dad\u0dc0\u0dad\u0dca \u0dc0\u0dd2\u0d9f\u0dba\u0d9a\u0dc2 \u0dbb\u0dcf\u0dbb\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0d9f\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0d9f\u0db4\u0dca \u0dbb\u0d9f\u0dda \u0dba\u0dba \u0dad\u0dd2\u0dc3\u0dbb\u0dc3\u0dbb\u0dbb\u0dbb\u0dba\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0d9f\u0dba\u0db1\u0dca 2022 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0d9f\u0dc1 IMF \u0d91\u0d9f\u0d9a\u0dca \u0dbb\u0db1\u0dbb\u0dca\u0dc0\u0da0\u0db1\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dbb\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc3\u0db6\u0dd4\u0dba\u0dcf. 2022 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0d9f\u0dc1 \u0d92\u0d9f\u0d9c\u0dcf\u0dbd\u0dca\u0d9f\u0dbd\u0ddd \u0d92 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0d9f\u0dba\u0db1\u0dca \u0dad\u0dba\u0db4\u0dca\u0dad\u0dd2\u0dc3\u0db8\u0dad\u0dca \u0dc0\u0dd4\u0d9f\u0da9\u0dd4\u0d9a \u0db1 \u0dc4 . \u0d92 \u0d87\u0dd2? \u0d85\u0db4\u0dd2 \u0d9c\u0dad\u0dca \u0dba\u0dba \u0db8\u0dd4\u0dd9\u0dbd\u0da7 \u0dc3\u0dcf\u0d9f\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dc0 \u0d85\u0d9f\u0db4\u0dca \u0dbb\u0d9f\u0dda \u0dc0\u0dad\u0dca\u0dbb\u0db8\u0dca \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dd9\u0db1\u0dba \u0d9f\u0dc0\u0dbd\u0dcf \u0db1 \u0dc4 . \u0d92 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0d9f\u0db1\u0dcf\u0d9f\u0dc0\u0dd2, \u0d92 \u0dbd\u0db6\u0dcf \u0d9c\u0dad\u0dca \u0dba\u0dba \u0db8\u0dd4\u0dd9\u0dbd\u0dca\u0dc0\u0dd2\u0db1\u0dca \u0d85\u0d9f\u0db4\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dba\u0dad\u0dd2\u0dc3 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd4\u0d9b\u0dca\u200d\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0d85\u0db1\u0dd4\u0dc0 \u0d92\u0d9f\u0d9c\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca \u0dbb\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dbb\u0dbb\u0dbd\u0dcf \u0db1 \u0dc4 . \u0d91\u0db8 \u0dbb\u0db1\u0dc3\u0dcf \u0d85\u0d9f\u0db4\u0dca \u0dbb\u0da7 \u0dc0\u0dc5 \u0db4\u0dbd\u0dca\u0dbd\u0da7 \u0dd9\u0db8\u0db4\u0dd4 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4 \u0dad\u0db8\u0dd2 \u0d85\u0db4\u0da7 \u0d91\u0d9f\u0dbb\u0dc4\u0dd2\u0dc0 \u0d85\u0dc0\u0dbd\u0dcf\u0dd9 \u0d9a\u0dd2\u0dba\u0db8\u0dd2\u0db1\u0dca \u0d9f\u0db8\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0d9f\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0d9f\u0dda \u0dba\u0dbb\u0dcf \u0db1\u0da7\u0db1\u0dca\u0d9f\u0db1\u0dca."
  },
