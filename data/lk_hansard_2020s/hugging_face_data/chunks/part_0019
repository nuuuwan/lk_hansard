    "chunk_text": "\u0da2\u0d9a\u0dad\u0dd2\u0dd2 \u0d92\u0dd2\u0d9a\u0db4\u0dda\u0db0\u0dca\u200d\u0dad\u0d9a \u0dbd\u0dca\u0d9a\u0dad\u0dba\u0d9a\u0dd2\u0dc1\u0dba \u0dc0\u0dd2\u0dd2\u0db1 \u0dc0 \u0db4\u0dc4\u0dd4 \u0dc0\u0d9a\u0dbb\u0dca\u0d9c\u0dd2\u0dd2, \u0db4\u0dc4\u0dd4 \u0d86\u0d9c\u0dd2\u0da7\u0dd2 \u0da2\u0db1 \u0dd2\u0da9\u0dbd\u0dba\u0d9a\u0dba \u0dda \u0dbd\u0dad\u0dbb \u0dc3\u0d9a\u0dca\u0dba , \u0dc3\u0dc4\u0dc0\u0dd3\u0dc0\u0db1\u0dba \u0dc3\u0dc4 \u0dc3\u0dd2\u0dc4\u0dd2\u0db3\u0dd2\u0dba \u0d9a\u0dc0 \u0dc0\u0dd0\u0da2\u0dd2\u0daf\u0dd2\u0dba \u0dab\u0dd4 \u0d9a\u0dba\u0dbb\u0dd3\u0dca\u0da7 \u0d86 \u0dc0\u0dad\u0dd3\u0dd2\u0dbb\u0dab\u0dba \u0da7 \u0d82\u0d9a\u0dca\u0dc2 \u0dc0\u0dd6 \u0db4\u0dca\u200d\u0dbb\u0da2\u0d9a\u0dc0\u0daf\u0dda \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dd2 \u0dca \u0d94\u0da7\u0dca \u0dca\u0dc4\u0dc5 \u0db1\u0dd0\u0dd2 \u0dc0\u0dca\u0da7, \u0dca\u0d9a\u0dad\u0dca\u0dc3\u0dad\u0dca\u0dd2 \u0dc4\u0d9a \u0dc3\u0dd4\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dad\u0d9a\u0dc0 \u0dad\u0dd4\u0db6\u0db3 \u0dc0 \u0da2\u0db1\u0dc0\u0d9a\u0dbb\u0dca\u0d9c\u0dd2\u0dd2 \u0dc3\u0dc4\u0dc0\u0dd3\u0dc0\u0db1\u0dba \u0d87\u0dad\u0dd2 \u0d9a\u0dba\u0dbb\u0dd3\u0dca\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d82\u0d9a \u0dc0 15,552\u0d9a\u0dca\u0dc2 \u0dc3 \u0dc4\u0d9a \u0dc0\u0dd0\u0dba\u0dc3\u0da7\u0dc4 \u0dc0 318\u0d9a\u0dca\u0dc2 \u0dca\u0dc0\u0dca\u0dc0\u0d9a \u0dad\u0dd2\u0daf\u0db4\u0db1\u0dc0\u0d9a. \u0d91\u0daf\u0dc3\u0dca\u0dca \u0da2\u0d9a\u0dad\u0dd2\u0dd2 \u0dc3\u0dca\u0d9c\u0dd2\u0dba \u0dc4\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3 \u0dc0\u0db0\u0dca\u200d\u0d9a\u0db1 \u0dd2\u0d9a\u0dbb\u0dca\u0dba \u0d9a\u0d82\u0dba \u0d82\u0d9a\u0dd2\u0d9a\u0dd3\u0dba \u0da2\u0db1\u0dad\u0d9a\u0dc0 \u0dbd\u0dad\u0dbb \u0dc3\u0dc4\u0dc0\u0dd3\u0dc0\u0db1\u0dba \u0dc3\u0dc4 \u0d91\u0dd2\u0db8\u0dd4\u0dad\u0dd4\u0dd2\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0db1\u0dba \u0d8b\u0daf\u0dd9\u0dc3\u0d9a \u0dbd\u0db0\u0dca\u200d\u0dba\u0d9a\u0dca\u0db1 \u0dc0\u0dd0\u0dba\u0dc3\u0da7\u0dc4 \u0dc0, \u0dd2\u0d82\u0d9a \u0dc3\u0dc4 \u0dc3\u0dd2\u0dc3\u0dca\u0dd2\u0dd8\u0dad\u0dd2\u0dd2 \u0dc0\u0dd0\u0dba\u0dc3\u0da7\u0dc4 \u0dc0, \u0dc3\u0dca\u0d9a\u0da2 \u0dc4\u0d9a \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dd2 \u0dc0\u0dd0\u0dba\u0dc3\u0da7\u0dc4 \u0dc0 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0dc0\u0dd0\u0dba\u0dc3\u0da7\u0dc4 \u0dc0 \u0d9c\u0dab\u0db1\u0d9a\u0dc0\u0d9a\u0dca\u0dc2 \u0dd2\u0db1\u0daf\u0dd4\u0dd2\u0dbb \u0dad\u0dd2\u0daf\u0db4\u0db1\u0dc0\u0d9a.\n\n261 262\n\n\u0dca\u0d9a\u0dbb\u0dca\u0dd2\u0daf\u0dda \u0dc0\u0dad\u0dd4\u0dc0\n\n\u0d91\u0daf\u0dc3\u0dca\u0dca \u0dc3\u0dbd\u0dca\u0dc4 \u0dd2\u0da7\u0db1\u0dd3\u0dc0\u0dc5\u0dc0 \u0db4 17\u0dd2 \u0dd2\u0dd0\u0dab\u0dd3\u0dda \u0dc4\u0d9a \u0daf\u0dc0 \u0dc4\u0d9a\u0dad\u0dca\u0dd2 \u0dc0\u0dd2\u0dca\u0dbb\u0dca\u0dc1\u0db1 \u0dd2\u0db1\u0daf\u0dd4 \u0dd2\u0dbb\u0dd2\u0da7 \u0dc0 \u0dca\u0dc0\u0dad\u0dd2\u0db1 \u0dbd\u0dad\u0dbb, \u0daf\u0dd2\u0d9a\u0dc5\u0db9 \u0dc0\u0dbb\u0d9a\u0daf\u0dda, \u0dca \u0dc0\u0db1\u0d9a\u0dbb\u0dca \u0dad\u0dd2\u0dbb\u0dd4\u0daf\u0d9a\u0dca\u0dc2\u0dad\u0dd3\u0dc3\u0dca\u0dc0\u0dbb \u0dc0, \u0dba \u0d9a\u0dca\u0db1\u0dba \u0daf\u0dba\u0dda\u0dca\u0db1\u0dd2, \u0dca\u0dba\u0dd2\u0d82\u0db4\u0dd4\u0dc0 \u0d9a\u0dd4\u0dbb\u0dd4\u0d9a\u0dca\u0dc2\u0dd2 \u0db4\u0dca\u0dba\u0dda, \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0d9a\u0dca\u0d82\u0dba \u0dc3\u0d9a\u0dda\u0dd6\u0dbb\u0dca \u0db4\u0dca\u200d\u0dbb\u0db0\u0dca\u200d\u0d9a\u0db1 \u0dc3\u0dca\u0dae\u0d9a\u0db1\u0dba \u0dc0 \u0daf\u0dc0\u0db1\u0dc0\u0d9a. \u0daf\u0dca\u0dca \u0dc3\u0dbd\u0dca\u0dc4 \u0dd2\u0da7\u0db1\u0dd3\u0dc0\u0d82\u0dc0 \u0db4 \u0dd2\u0dd0\u0dab\u0dd3\u0dda \u0dc4\u0d9a \u0daf\u0dc0 \u0dc4\u0d9a\u0dad\u0dca\u0dd2 \u0dc0\u0dd2\u0dca\u0dbb\u0dca\u0dc1\u0db1 \u0dd2\u0db1\u0daf\u0dd4 \u0d9a\u0dba\u0dbb\u0dd3\u0dca \u0daf\u0dc0\u0db1\u0dd4\u0daf\u0dc0 \u0dc0 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d82\u0dd2\u0dd2\u0d9a \u0dbb\u0da2\u0dba \u0daf\u0dda \u0dd9\u0d9a\u0dca\u0dc2\u0dc0\u0d9a \u0dbb\u0dd4\u0dc5\u0dd2\u0dba \u0db4 \u0db6\u0dd2\u0dd2\u0dba \u0db1 22\u0dd2\u0da7 \u0dc0\u0dd0\u0da2\u0dd2 \u0db8\u0dd4\u0dd9\u0d82\u0d9a\u0dca\u0dc2 \u0dc0\u0dd2\u0dba \u0dd9\u0dda \u0dd2\u0dbb \u0dad\u0dd2\u0daf\u0db4\u0db1\u0dc0\u0d9a.\n\n\u0d91\u0daf\u0dc3\u0dca\u0dca \u0dc3\u0dd0\u0dca\"\u0dad\u0dd0\u0dda\u0db4\u0dbb\u0dca \u0dca\u0d9a\u0dc3\u0daf\u0dda \u0da2\u0dd2\u0db1\u0dd3\u0dc0\u0d9a\u0dc4\u0dd2\u0daf\u0dd3 \u0dca\u0dd0\u0dc0\u0dd0\u0dad\u0dd2 \u0db4\u0d82\u0dc4\u0dca\u0dd2\u0d9a\u0dbb\u0dd3 \u0dbd\u0dad\u0dd4\u0dbb\u0dd4\u0dd9\u0dc4 \u0dc0 \u0d9a\u0dba\u0dbb\u0dd3\u0dda \u0dc5\u0dd2\u0db6\u0db3\u0db4 \u0dd2\u0dd2\u0da7\u0dd4\u0dc0\u0dc0\u0da7 \u0dca\u0dad\u0d9a \u0dc3\u0d9a\u0dbb\u0dca\u0dae\u0dd2 \u0dc0\u0d9a\u0dbb\u0dca\u0dad\u0d9a\u0dc0\u0d9a\u0dca\u0dc2 \u0dca\u0daf\u0dd2\u0dad\u0dca\u0dca\u0dca \u0dd2\u0dc5 \u0dbd\u0dad\u0dbb, \u0dca\u0dc0\u0dd4 \u0dc0\u0daf\u0dda \u0dc0\u0dd2\u0dca\u0dc3\u0dd4\u0dda \u0d82\u0dd0\u0db1\u0dca\u0dc3\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0dbb\u0da7\u0d9a\u0dca\u0dc2 \u0daf\u0d82\u0dc3 \u0dc3\u0d9a\u0dbb\u0dca\u0dae\u0dd2\u0dc0 \u0dc5\u0dd2\u0db6\u0db3\u0dad\u0dd4\u0dbb\u0dd4 \u0d82\u0db4\u0d9a \u0daf\u0dd3\u0dca\u0da7 \u0dbd\u0dca\u0da7 \u0dc4\u0dd0\u0d9a\u0dba \u0dc0\u0dd4\u0dab\u0d9a.\n\n\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0d9a\u0dca\u0dad\u0dd2\u0dad\u0dd4\u0dca\u0db1\u0dd2, \u0d9c\u0dd0\u0dd4\u0dc0\u0dda\u0dc0\u0dd2 \u0dc0 \u0dc0\u0dd2\u0dca\u0dad\u0da7 \u0dca\u0dca\u0dc0\u0dd6\u0dc0 \u0dc0\u0da7 \u0dbd\u0dbb\u0dca\u0dae\u0dd9\u0d9a\u0db1\u0dca \u0dc3\u0dc4 \u0dad\u0dd2\u0dbb\u0dc3\u0d9a\u0dbb \u0dc4\u0d9a\u0db1\u0dd2\u0dd6\u0dbb\u0dab\u0dba \u0dc0 \u0dd2\u0db1\u0daf\u0dd4 \u0d9a\u0dba\u0dbb\u0dd3\u0dca \u0dc3 \u0dc4\u0d9a \u0dc4\u0d9a\u0db1\u0dd2\u0dd6\u0dbb\u0dab \u0dd2\u0d9a\u0dbb\u0dca\u0dba \u0d9a\u0d82\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba \u0d9a\u0dca\u0dca\u0dd2 \u0daf\u0dc0\u0db1\u0dc0\u0d9a. \u0d8b\u0dad\u0dd4\u0dbb\u0dd4, \u0db1\u0dd0 \u0daf\u0db4\u0db1\u0dc4\u0dd2\u0dbb \u0dba\u0dd4\u0dd9 \u0d9c\u0dd0\u0dd4\u0dc0\u0dda \u0daf\u0dc4\u0dca\u0dad\u0dd4\u0daf\u0dc0 \u0dc0 \u0dd2\u0db1\u0daf\u0dd4\u0dc0\u0dd6 \u0dca\u0dbb\u0dab, \u0dad\u0dd4\u0dc0\u0d9a\u0d82 \u0dc3\u0dc4 \u0daf\u0dda\u0dca\u0dc5 \u0dc4\u0d9a\u0db1\u0dd2 \u0daf\u0dc0\u0db1\u0dd4\u0daf\u0dc0 \u0dc0 \u0dc0 \u0dc0\u0daf\u0dd2 \u0daf\u0d9c \u0dc0\u0dca \u0dc0\u0dc3\u0dbb 30\u0dd2\u0da7 \u0d86\u0dc3 \u0dc0\u0db1 \u0dd2\u0d9a\u0d82\u0dba \u0d9a\u0dca\u0dc2 \u0dd2\u0db1\u0daf\u0dd4\u0dd2\u0dbb\u0dd2\u0da7 \u0dc0 \u0dca\u0dd0\u0dc0\u0dd0\u0dad\u0dd2 \u0dbd\u0dad\u0dbb, \u0dbd\u0dca \u0dbb\u0da2\u0dba \u0dba \u0da7\u0daf\u0dca \u0d91\u0dca \u0dc0 \u0dc0\u0daf\u0dd2 \u0daf\u0d9c \u0dc0\u0dca \u0dca\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dc3\u0dd0\u0dca\"\u0dad\u0dd0\u0dda\u0db4\u0dbb\u0dca \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0dc3\u0dda\u0dd6\u0dbb\u0dca\u0dab\u0daf\u0dba \u0dc0\u0dca \u0dbd\u0dc0\u0dc3 \u0dc0 \u0dd2\u0dc5\u0d9a.\n\n\u0d92 \u0dc0\u0d9a \u0daf\u0dda\u0dca 2,000 \u0dc0\u0dbb\u0dca\u0dc2\u0daf\u0dba \u0dc0 \u0dca\u0dc3\u0dd4 \u0dbd\u0dad\u0dd4\u0dbb\u0dd4\u0dd9\u0dc4 \u0dc0 \u0dc0\u0dd6\u0dc0 \u0dc0\u0daf\u0dda \u0dca\u0dc0\u0dd4 \u0db4 4,348\u0dd2\u0da7 \u0daf\u0dda \u0dd9\u0d9a\u0dca\u0dc2\u0dc0\u0d9a \u0daf\u0d9c \u0dc0\u0dda \u0dd2\u0db1\u0daf\u0dd4\u0dd2\u0dbb \u0d87\u0dad\u0dd2 \u0dbd\u0dad\u0dbb, \u0dbd\u0dad\u0dd4\u0dbb\u0dd4\u0dd9\u0dc4 \u0dc0 \u0dc0\u0dd6\u0dc0 \u0dc0\u0daf\u0dda \u0dd2\u0d9a\u0dbb\u0dca\u0dba \u0d9a\u0d82\u0daf\u0dda \u0db1\u0dd2\u0dbb\u0dca\u0daf\u0dda\u0dc1 \u0dbd\u0db1\u0dd4\u0dc0 \u0daf\u0dd2\u0d9c\u0da7\u0dca \u0d91\u0dca \u0daf\u0d9c \u0dc0\u0dda \u0dd2\u0db1\u0daf\u0dd4\u0dd2\u0dbb\u0db1\u0dc0\u0d9a.\n\n\u0d92 \u0dc0\u0d9a\u0daf\u0dda\u0dca 2000 \u0dc0\u0dc3\u0dbb\u0da7 \u0daf\u0dca\u0dbb \u0dbd\u0dad\u0dd4\u0dbb\u0dd4\u0dd9\u0dc4 \u0dc0 \u0dc0\u0dd6\u0dc0 \u0dc0\u0da7 \u0dc0 \u0dc0\u0daf\u0dd2 \u0dd6 \u200d\u0dbb\u0dba \u0d9a\u0dca\u0dc2 \u0db1\u0dd2\u0dbb\u0dca\u0dca\u0d9a\u0dab\u0dba \u0dd2\u0dbb \u0dc0 \u0dc0\u0daf\u0dd2 \u0dca\u0dd0\u0daf\u0d9a\u0dca\u0dc2\u0da2\u0dba \u0d9a\u0dca\u0dc2 \u0d82\u0db4\u0d9a \u0daf\u0dd3\u0dca \u0dc3 \u0dc4\u0d9a \u0db1\u0dd2\u0dbb\u0dca\u0daf\u0dda\u0dc1 \u0dca\u0daf\u0dd2\u0dad\u0dca\u0dca\u0dca \u0d9a\u0dba\u0dbb\u0dd3\u0dca\u0da7 \u0dd2\u0dd2\u0da7\u0dd4\u0dc0\u0dc0\u0d9a\u0dca\u0dc2 \u0dca\u0dca \u0d9a\u0dba\u0dbb\u0dd3\u0dca\u0da7 \u0dd2\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dd2\u0dbb\u0dd2\u0da7 \u0dc0 \u0dd2\u0db1\u0dd2\u0db1\u0dc0\u0d9a.\n\n\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0d9a\u0dca\u0dad\u0dd2\u0dad\u0dd4\u0dca\u0db1\u0dd2, \u0dbd\u0dca \u0dbb\u0da2\u0dba \u0dc0\u0dd2\u0dba\u0db1\u0dd2\u0dd2 \u0daf\u0d82\u0dc3 \u0dc0 \u0dc0\u0daf\u0dd2 \u0d82\u0db4\u0d9a \u0d9c\u0dd0\u0db1\u0dd3\u0dca\u0da7 \u0d9a\u0dba\u0dd2\u0db1\u0dc0\u0d9a\u0dd4\u0da7 \u0dca\u0dba \u0daf\u0db1\u0d9a\u0dad\u0db4\u0db1 \u0dbd\u0dad\u0dbb, \u0dbd\u0dbb\u0d9c\u0dc5\u0daf\u0dba \u0dc0 \u0dc4\u0d9a\u0db1\u0dd2 \u0dc0\u0dd6 \u0dc0 \u0dc0\u0daf\u0dd2 \u0d82\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db1\u0dd2\u0dba \u0dca \u0db4\u0dd4\u0dda\u0d9c\u0d82\u0dba \u0dc0\u0da7 \u0dc0 \u0dc0\u0daf\u0dd2 \u0d82\u0db4\u0d9a \u0daf\u0dd3\u0dca \u0dc3 \u0dc4\u0d9a \u0db1\u0dd2\u0dbb\u0dca\u0dab\u0d9a\u0dba \u0dd2 \u0dc3\u0dd2\u0dc3\u0dca \u0dd2\u0dbb \u0dbd\u0dca\u0d9a\u0dad\u0dba \u0dca\u0da9\u0dbd\u0dba\u0d82\u0daf\u0dda \u0dbd\u0db1\u0dd4\u0dca\u0dd0\u0dad\u0dd2\u0dba \u0d82\u0db4\u0d9a \u0d9c\u0dd0\u0db1\u0dd3\u0dca\u0da7 \u0dbd\u0daf\u0dca\"\u0d9a\u0dca\u0dc2\u0dc2\u0d9a \u0dd2\u0dbb\u0db1\u0dc0\u0d9a."
