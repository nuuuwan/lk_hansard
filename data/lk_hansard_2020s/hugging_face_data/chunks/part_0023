    "chunk_text": "2026 \u0db1\u0dcf\u0dad\u0dba\u0db1\u0dca\u0dad \u0dbb\u0dcf\u0db1\u0dca\u0dad\u0dcf \u0daf\u0dd2\u0db1\u0dd9 \u0dd2\u0dbb\u0db8\u0dd2\u0dca,\u0db1\u0dad\u0db1\u0dca \u0db1\u0dcf\u0dad\u0dd2\u0dbb \u0d86\u0dbb\u0dca\u0dd2\u0dbb\u0dd9\u0da7 \u0dd2\u0dc5\u0db1\u0daf\u0db1 \u0dbb\u0dcf\u0db1\u0dca\u0dad\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0db8 \u0daf\u0dcf\u0dd9\u0dbb\u0dca,\u0dc0\u0dd9 \u0d85\u0d9c\u0dd9\u0db8\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca\u0db4 \u0dc4\u0dd2\u0dad \u0dc3\u0dd4\u0dbb\u0dd0\u0d9a\u0dd4\u0db8\u0dca \u0dc1\u0dca\u200d\u0dbb\u0db8\u0dd9 \u0db1\u0dcf\u0dad\u0dd2\u0dbb \u0d86\u0dbb\u0dca\u0dd2\u0dbb\u0dd9\u0da7 \u0d91\u0d9a\u0dca \u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \"\u0db1\u0dcf\u0dad\u0dd2\u0dbb \u0dc3\u0dd4\u0dbb\u0dd0\u0d9a\u0dd4\u0db8\u0dca \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dcf\u0dca,\u0dad\u0dd2\u0dd9\u0d9a\u0dca \u0dc3\u0dbb\u0dc3\u0dda \u0dd2\u0dbb\u0dd3\u0db8\u0db8\" \u0dd2\u0dbb\u0dd9\u0db1 \u0db1\u0dd9 \u0db1\u0db1\u0dcf\u0dc0 \u0dc3\u0db7\u0dcf\u0dc0 \u0dbb\u0dca \u0dad\u0db6\u0db1 \u0d85\u0dc0\u0dc3\u0dda\u0dae\u0dcf\u0db1\u0dda \u0db1\u0dd9 \u0db1\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0db1\u0dbd\u0dc3 \u0d85\u0dd2\u0dc5 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dcf\u0dca, \u0dbb \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0dcf. \u0dd2\u0dbb\u0dd9\u0db1\u0dca\u0db1\u0db1\u0dca National Care Policy \u0d91\u0dbb\u0d9a\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0dcf \u0daf\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0db1\u0dd9 \u0db1\u0db1\u0dcf\u0dc0\u0d9a\u0dca. \u0db1\u0db8\u0dca\u0dbb \u0dc0\u0dcf\u0db8\u0dcf\u0d9d\u0dc1\u0dd2\u0dbb \u0dc0\u0dba\u0dcf\u0dcf\u0dcf \u0dd9\u0d9a\u0dca \u0db1\u0dbd\u0dc3 \u0d85\u0dd2\u0dc5 \u0d89\u0dad\u0dcf \u0dc0\u0dd0\u0daf\u0d9c\u0dca, \u0db1\u0dbb\u0dcf\u0da7 \u0dc3\u0dbd\u0dbb\u0dd4 \u0db1\u0daf\u0dd9\u0d9a\u0dca \u0dd2\u0dbb\u0dd9\u0dcf\u0dba\u0dd2 \u0db8\u0dcf \u0dc4\u0dd2\u0dad\u0db1\u0dca\u0db1\u0db1\u0dca. \u0d85\u0db1\u0db4\u0dca\u0db4 \u0db8\u0dd0\u0dad\u0dd2\u0dc0 \u0dab \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dcf\u0dca,\u0dad\u0dd2\u0db1\u0dda\u0daf\u0dd3\u0dca, \u0d85\u0db1\u0db4\u0dca\u0db4 \u0db8\u0dd0\u0dad\u0dd2\u0dc0 \u0dab \u0dc0\u0dba\u0dcf\u0dcf\u0dcf \u0db1\u0dda\u0daf\u0dd3\u0dca, \u0d85\u0db1\u0db4\u0dca\u0db4 \"\u0db1\u0dcf\u0dcf\u0db1\u0dc4\u0dcf\u0dc3\u0dca, \u0da7\u0d9a\u0dca-\u0dbd\u0dc3\u0dda\u0dc3\u0db1 \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dd9\u0d9a\u0dca\" \u0dd2\u0dbb\u0dd9\u0db1 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dcf\u0dca,\u0dad\u0dd2 \u0dca\u200d\u0dbb\u0dbb\u0dcf \u0dd9 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dcf\u0dca, \u0dd2\u0dbb\u0dd3\u0db8\u0db1\u0db8\u0dca\u0daf\u0dd3\u0dca, \u0d85\u0dd2\u0dc5 \u0db1\u0db8\u0dca unpaid care work \u0dd2\u0dbb\u0dd9\u0db1 \u0d91\u0dbb national economy \u0d91\u0db1\u0d9a\u0dca calculation \u0d91\u0dbb\u0da7 \u0d9c\u0db1\u0dca\u0db1\u0db1\u0dca \u0db1\u0dbb\u0dcf\u0db1\u0dc4\u0dcf\u0db8\u0daf \u0dd2\u0dbb\u0dd9\u0db1 \u0dbb\u0dcf \u0dab\u0dd9 \u0dc3\u0dd1\u0db1\u0dc4\u0db1\u0dca\u0db1 \u0dbb\u0dae\u0dcf \u0dbb \u0dd4 \u0dbb\u0dcf \u0dab\u0dd9\u0d9a\u0dca. \u0db1\u0dcf\u0dcf\u0db1 \u0dcf\u0db1\u0dca\u0dd4 \u0dc0 \u0d89\u0dc2\u0dda\u0da7 \u0dbb \u0db8\u0dd2\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dcf\u0dad\u0dd2\u0dbb \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dcf\u0dca,\u0dad\u0dd2\u0dd9\u0d9a\u0dca \u0db1\u0dbb\u0da7\u0dd4\u0db8\u0dca\u0dcf\u0dca, \u0dbb \u0dbd\u0dcf \u0dc4 \u0dc4\u0dcf \u0dc0\u0dd0\u0da9 \u0dd2\u0dc5\u0dc5\u0dd2\u0db1\u0dc0\u0dc5\u0d9a\u0dca \u0dc3\u0dbb\u0dc3\u0dda \u0dd2\u0dbb\u0dd3\u0db8\u0db1\u0db8\u0dca \u0daf\u0dd3\u0dbb\u0dca\u0db1 \u0dbb\u0dcf\u0dbd\u0dd3\u0db1 \u0dc0\u0dd0\u0db1\u0dda \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0dd2\u0dc5 \u0db1\u0db8\u0dca \u0d86 \u0db8\u0dca\u0db7 \u0dbb \u0db1\u0dca\u0db1\u0db1\u0dca. \u0db1\u0db8\u0dd4\u0dca, \u0db1\u0db8\u0dca \u0dc0\u0db1\n\n\u0db1\u0db8\u0dca \u0d85\u0dc0\u0dc3\u0dda\u0dae\u0dcf\u0db1\u0dda \u0db1\u0db8\u0dca \u0d9c\u0dd0\u0db1 \u0dd2\u0dbb\u0dd9\u0db1\u0dca\u0db1 \u0db8\u0da7 \u0dbb\u0db1\u0d9c\u0dcf\u0da7\u0dd4\u0dba\u0dd2. \u0db8\u0db8 \u0db1\u0db8\u0dca \u0dc0 \u0db1\u0dd9\u0db1\u0dca \u0db1\u0db1\u0dcf\u0dd2\u0dbb\u0dda\u0dc0\u0dca, \u0db8\u0dcf\u0db0\u0dba\u0dc0\u0dbd \u0d89\u0db1\u0dca\u0db1 \u0dbb\u0dd0\u0db4\u0dd3 \u0db1\u0dcf\u0db1\u0db1\u0db1 \u0daf\u0d9a\u0dca\u0dc2\u0dad\u0dcf \u0db1\u0dcf\u0db1\u0dca\u0dc0\u0db1 \u0dbb\u0dcf\u0db1\u0dca\u0dad\u0dcf\u0dc0\u0db1\u0dca\u0da7 \u0dc3\u0db8\u0dcf\u0db1 \u0db8\u0dcf\u0db0\u0dba\u0dc0\u0dbd\u0dd2\u0db8\u0db1\u0dca \u0d85\u0dad\u0dd2 \u0dd9 \u0d85\u0db8\u0dcf\u0db1\u0dd4\u0dc2\u0dd2\u0dbb \u0db1\u0dbd\u0dc3 \u0dc4\u0dd2\u0d9d\u0dc3\u0dcf\u0dbb\u0dcf\u0dd3\u0db8 \u0db1\u0dbd\u0dc3 \u0d85\u0dc3\u0db7\u0dba \u0dca\u200d\u0dbb\u0dbb\u0dcf \u0dbb \u0db1\u0dc0\u0dcf. \u0dc0\u0dd2\u0db1 \u0dda\u0dc2\u0db1\u0dd9\u0db1\u0dca \u0dcf\u0dc3\u0dd4\u0d9c\u0dd2\u0dd9 \u0dbb\u0dcf\u0dbd\u0db1\u0dda \u0d91\u0dc0\u0dd0\u0dd2\u0dbb \u0db1\u0dc1\u0dc0\u0dca \u0d85\u0dd2\u0dc5 \u0daf\u0dd0\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0dcf \u0dc4\u0dd2\u0dad\u0db1 \u0dc4\u0dd0\u0da7\u0dd2\u0dd9\u0da7 \u0db1\u0db8\u0dca\u0dbb \u0db8\u0dcf\u0db0\u0dba\u0db1\u0dda\u0daf\u0dd2\u0db1\u0dd9\u0d9a\u0dd4\u0da7 \u0db1\u0dc4 \u0db8\u0dcf\u0db0\u0dba\u0db1\u0dda\u0daf\u0dd2\u0dd2\u0dbb\u0dd9\u0dbb\u0da7 \u0dc0\u0dd2\u0dad \u0d9a\u0dca \u0dc3\u0dd3\u0db8\u0dcf \u0db1\u0dc0\u0da0\u0dca\u0da0 \u0db1\u0daf\u0dd9\u0d9a\u0dca \u0db1\u0db1\u0dcf\u0db1\u0dc0\u0dba\u0dd2. \u0dbb\u0dcf\u0db1\u0dca\u0dad\u0dcf\u0dc0\u0db1\u0dca\u0da7 \u0db1\u0d9c\u0dde \u0dc0 \u0dbb \u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0dd2\u0dbb\u0dd9\u0dbd\u0dcf \u0d85\u0daf \u0d8b\u0db1\u0dc1 \u0d89\u0db3\u0db1\u0dca \u0db1\u0db8\u0dca \u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0db1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc3\u0db7\u0dcf \u0d9c\u0dbb\u0dca\u0db7\u0db1\u0dda\u0daf\u0dd3 \u0dd2\u0dbb\u0dda\u0dc0\u0dcf. \u0db1\u0db8\u0dd4\u0dca, \u0dbb\u0db1\u0d9c\u0dcf\u0da7\u0dd4\u0dc0\u0da7 \u0dbb\u0dcf \u0dab\u0dd9\u0d9a\u0dca \u0dad\u0dd2\u0db1\u0db6\u0db1\u0dc0\u0dcf. \u0db1\u0db8\u0dad\u0dd0\u0db1\u0da7 \u0d87\u0dc0\u0dd2\u0dca\u0dbd\u0dcf \u0d8b\u0db1\u0dc1 \u0d89\u0db3\u0db1\u0dca \u0d85\u0dc3\u0db7\u0dba \u0dc0\u0da0\u0db1 \u0dcf\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0dbb \u0dbd\u0dcf \u0dbb\u0dcf\u0db1\u0dca\u0dad\u0dcf\u0dc0\u0db1 \u0db1\u0d9c\u0dde \u0dc0\u0dd9 \u0dc3\u0dc4 \u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0db1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0db1\u0dda \u0db1\u0d9c\u0dde \u0dc0\u0dd9 \u0db1\u0dbb\u0db1\u0dc5\u0dc3\u0db1 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4 \u0dd2\u0dbb\u0dc4\u0dd2\u0dcf\u0db1\u0daf\u0db1\u0db1\u0d9a\u0dca \u0dc0\u0dd2\u0dcf\u0d9a\u0dca\u0dc2\u0db1\u0dda \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0dc4\u0dd0\u0db1\u0db8 \u0db8 \u0db1\u0db1\u0dcf\u0db1\u0dc0\u0dba\u0dd2. \u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0dc0\u0db8\u0dd2\u0dbb \u0db8\u0db8 \u0d9c\u0dd0\u0db1\u0dca, \u0db1\u0db8\u0dca \u0db1\u0dc0\u0dbd\u0dcf\u0db1\u0dda \u0db8\u0dad\u0d9a\u0dca \u0db1\u0db1\u0dcf\u0dbb \u0db6\u0dd0\u0dc4\u0dd0.\n\n1867 1868\n\n\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0db1\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dc0"
  },
