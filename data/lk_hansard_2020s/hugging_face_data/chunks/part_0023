    "chunk_text": "\u0d9c\u0db8\u0d9c\u0dc4\u0dda \u0d86\u0db4\u0dd4 \u0d91\u0dad\u0dd4\u0db8\u0dd2\u0dba \u0daf\u0dad\u0db1\u0dca\u0dad \u0d85\u0d9c\u0dca \u0db4\u0d9a\u0dca\u0dc2\u0dc2\u0d9c \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0d9a\u0dca\u0dc2. \u0d89\u0dad\u0dd2\u0db1\u0dca\u0dad \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dad\u0db8\u0dad\u0dad\u0dd2\u0dba\u0dd2 \u0d9c\u0dda \u200d\u0dbb\u0dc1\u0dda\u0db1\u0d9c \u0da2 \u0d85\u0db4 \u0d9c\u0d9a\u0dcf \u0dad\u0db1\u0daf \u0d89\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d9c\u0db8\u0dcf\u0d9a\u0daf \u0db1\u0dca\u0db8\u0db1\u0dca\u0dad\u0dad\u0dd2\u0dbb\u0db1\u0dca\u0dad \u0dd2\u0db3\u0da7\u0db4\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0dcf \u0db8\u0dd3\u0da7 \u0db8\u0dcf\u0dc3 \u0d9c\u0daf\u0d9a\u0d9a\u0da7 \u0d9a\u0dd2\u0db1\u0dca\u0dad \u0d9c\u0dbd\u0dcf\u0d9a\u0dd4 \u0d9c\u0d9c\u0ddd\u0dbb\u0db1\u0dcf\u0dca\u0dc0\u0d9a\u0dca\u0dc2 \u0d87\u0dbd\u0dca\u0dbd\u0dd4\u0dc0\u0dcf \u0d89\u0db1\u0dca\u0dad\u0dd2\u0db1\u0dba\u0dcf\u0d9c \u0d89\u0db3\u0dbd\u0dcf \u0d86\u0db4\u0dd4 returnee \u0d9c\u0d9a\u0d9c\u0db1\u0d9a\u0dca\u0dc2 Palaly Airport \u0d91\u0d9c\u0d9a\u0db1\u0dca\u0dad \u0d91\u0db1\u0d9c\u0d9a\u0dcf\u0da7 Immigration and Emigration Department \u0d91\u0d9c\u0d9a\u0db1\u0dca\u0dad \u0d85\u0dad\u0dca\u0d85\u0dba\u0da0\u0d9c\u0dd4\u0dc0\u0da7 \u0d9c\u0dad\u0dca \u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db8\u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2 \u0db1\u0dd4\u0dbd\u0dad\u0dca \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0dad\u0dca \u0daf\u0db1\u0dca\u0dad\u0db1\u0dcf \u0db4\u0dd2\u0dba\u0dd2\u0db1 \u0d91\u0daf\u0dcf \u0db4\u0dad\u0dc0\u0dad\u0dad\u0dd2 \u0dba\u0dd4\u0dda\u0db0\u0dba \u0db1\u0dd2\u0dc3\u0dcf \u0d9c\u0dda \u0dbb\u0da7\u0dd2\u0db1\u0dca\u0dad \u0db4\u0dd2\u0da7 \u0d9c\u0dc0\u0dbd\u0dcf \u0d89\u0db1\u0dca\u0dad\u0dd2\u0db1\u0dba\u0dcf\u0dc0\u0da7 \u0dd2\u0dd2\u0db3\u0db1\u0dca\u0dad \u0d85\u0db1\u0dcf\u0dae \u0d9c\u0dc0\u0da0\u0dca\u0da0\u0dcf \u0d85\u0dba \u0d85 \u0dd2\u0dba\u0db1\u0dca\u0dad 200 .01.01\u0dc0\u0db1 \u0daf\u0dcf \u0d89\u0db3\u0db1\u0dca\u0dad \u0dbd\u0da0\u0d9a\u0dcf\u0dc0\u0da7 \u0d87\u0dd2\u0dad\u0dad\u0dca \u0db4\u0dc0\u0dd4\u0dbd\u0dca 1 33 \u0d9a \u0db4\u0dd4\u0dda\u0d9c\u0dbd\u0dba\u0db1\u0dca\u0dad 4 011\u0d9a\u0dca\u0dc2 \u0db1\u0dad \u0d9c\u0d9f\u0db1\u0dd2\u0db3\u0dbb \u0db4\u0dc5\u0dcf\u0d9c\u0dad\u0dca \u0db4\u0dd2\u0db1\u0da0\u0da0\u0dd2 \u0d9c\u0dc0\u0dbd\u0dcf \u0d89\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0db4\u0dc0\u0dd4\u0dbd\u0dca 5 241\u0d9a \u0db4\u0dd4\u0dda\u0d9c\u0dbd\u0dba\u0db1\u0dca\u0dad 14 531\u0d9a\u0dca\u0dc2 \u0dbd\u0da0\u0d9a\u0dcf\u0dc0\u0da7 \u0d87\u0dd2\u0dad\u0dad\u0dca \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dc5\u0dcf\u0d9c\u0dad\u0dca \u0db4\u0dd2\u0db1\u0da0\u0da0\u0dd2 \u0d9c\u0dc0\u0dbd\u0dcf \u0d89\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf. \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0d92 \u0dba\u0db1 \u0dcf\u0dc0 \u0dbd\u0da0\u0d9a\u0dcf\u0dc0\u0da7 \u0d91\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dad\u0db8\u0dad\u0dad\u0dd2\u0dba\u0dd2; \u0dbd\u0da0\u0d9a\u0dcf\u0d9c \u0d89\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dad\u0db8\u0dad\u0dad\u0dd2\u0dba\u0dd2. \u0d92\u0d9a \u0db8\u0dba\u0dd2 \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba.\n\n\u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0d85\u0db4\u0dd2 \u0d9c\u0dda \u0d9a\u0dcf\u0dbb\u0dba\u0dba\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dad\u0db8\u0dad\u0dad\u0dd2\u0dba\u0dd2. \u0d85\u0d9c\u0dca \u0db8\u0dc4\u0dba\u0db1 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dc2\u0d9a \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dc3\u0dda\u0dd6\u0dbb\u0dca\u0dbd\u0dba\u0d9c\u0dba\u0db1\u0dca\u0dad\u0db8 \u0d8b\u0db4\u0d9c\u0daf\u0dc3\u0dda \u0da2\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf \u0d92 \u0d85\u0dba \u0d91\u0db1\u0d9c\u0d9a\u0dcf\u0da7 \u0d85\u0dad\u0dca\u0d85\u0dba\u0da0\u0d9c\u0dd4\u0dc0\u0da7 \u0d9c\u0db1\u0dca\u0dad\u0db1 \u0d91\u0db4\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d9c\u0db8\u0dcf\u0d9a\u0daf \u0d92 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dda\u0db1\u0dca \u0db4\u0dba \u0d9c\u0db6\u0dca\u0dbd\u0dbb\u0dcf \u0d9c\u0db1\u0dca\u0dad\u0db1\u0dba\u0dd2 \u0dbb\u0da7\u0dd2\u0db1\u0dca\u0dad \u0db4\u0dd2\u0da7\u0dc0 \u0dd2\u0d9c . \u0d91\u0daf\u0dcf \u0db1\u0dd3 \u0dba\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dba\u0dbd ports\u0dc0\u0dd2\u0db1\u0dca\u0dad\u0db8 \u0dba\u0db1\u0dca\u0dad\u0db1 \u0d92 \u0d85\u0dba\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0d9a\u0db8\u0d9a\u0dca\u0dc2 \u0dad\u0dd2\u0dd4\u0d9c\u0da9\u0dd4\u0d9a \u0db1\u0dad\u0dc4\u0dad. \u0d92 \u0d85\u0dba \u0da2\u0dd3\u0dd2\u0dad \u0d9c\u0db6\u0dca\u0dbd\u0dbb\u0dcf \u0d9c\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0dc4\u0dd4 \u0dc0\u0dd4\u0dab\u0dd4 \u0dc4\u0dad\u0db8 \u0dad\u0db1\u0d9a\u0dd2\u0db1\u0dca\u0dad\u0db8 \u0dd2\u0dba\u0dcf. \u0db1\u0dd4\u0dbd\u0dad\u0dca \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0d86\u0db4\u0db1\u0dca \u0d91\u0db1\u0d9c\u0d9a\u0dcf\u0da7 \u0dd2\u0dba \u0dc3\u0dd3\u0dbd\u0dca \u0d91\u0d9a passport \u0d91\u0d9c\u0d9a\u0dca\u0dc2 \u0db1\u0dad\u0dc4\u0dad. \u0d89\u0dad\u0dd2\u0db1\u0dca\u0dad illegally port \u0d91\u0d9a\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0dd2\u0dba\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0db4\u0daf\u0db1\u0db8\u0dd2\u0db1\u0dca\u0dad \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0d85\u0dad\u0dca \u0d85\u0dba\u0da0\u0d9c\u0dd4\u0dc0\u0da7 \u0d9c\u0db1\u0dca\u0dad\u0db1 \u0d91\u0db4\u0dcf \u0d9a\u0dd2\u0dba\u0dcf \u0d8b\u0db4\u0d9c\u0daf\u0dc3\u0dda \u0da2\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0d9c\u0dda \u0dc0\u0db1 \u0d9c\u0d9a\u0dcf\u0da7\u0dad\u0dca \u0d9a\u0da7\u0dd4\u0db1\u0dcf\u0dba\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0d91\u0dc0\u0dad\u0db1\u0dd2 \u0daf\u0dc3\u0daf\u0dc4\u0dc3\u0dda \u0d9c\u0dba\u0db1\u0d9a\u0dca\u0dc2 \u0d87\u0dd2\u0dad\u0dbd\u0dca\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0dcf \u0dd2\u0db3 \u0db1 \u0dd2\u0dad\u0dd2\u0d9a\u0dba\u0da7 \u0d92 \u0daf\u0dc4\u0d85\u0da7\u0daf\u0dc4\u0dc3\u0dda \u0d9c\u0dba\u0db1\u0dd2\u0db1\u0dca\u0dad 18 500\u0d9a\u0dca\u0dc2 \u0db8 \u0d91\u0db1\u0dca\u0dad\u0db1 \u0d87\u0dad\u0dca\u0d9c\u0dad\u0dca \u0d92 \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0d9c \u0dcf\u0da7\u0dd4 \u0d9c\u0db4\u0dcf\u0d9c\u0dc5\u0db1\u0dca\u0dad. \u0db1\u0dd4\u0dbd\u0dad\u0dca \u0d85\u0dad\u0dca\u0d85\u0dba\u0da0\u0d9c\u0dd4\u0dc0\u0da7 \u0d85\u0dbb\u0d9c\u0d9c\u0db1 \u0db1\u0dad\u0dc4\u0dad. \u0d9c\u0db8\u0dcf\u0d9a\u0daf \u0db8\u0dc4\u0dba\u0db1 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dc2\u0d9a \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0d92 \u0d8b\u0db4\u0d9c\u0daf\u0dc3\u0dda \u0da2\u0dbd\u0dcf \u0dad\u0dd2\u0dd4\u0dba\u0dcf. \u0db1\u0dd4\u0dbd\u0dad\u0dca Palaly Airport \u0d91\u0d9c\u0d9a\u0dca\u0dc2 \u0da2 \u0d91\u0d9a\u0dca\u0dc2\u0d9c\u0d9a\u0d9c\u0db1\u0d9a\u0dca\u0dc2 \u0d85\u0dad\u0dca\u0d85\u0dba\u0da0\u0d9c\u0dd4\u0dc0\u0da7 \u0d9c\u0dad\u0dca \u0dcf\u0db8 \u0db8\u0dba\u0dd2 \u0d94\u0dba \u0db1\u0dca\u0db8\u0db1\u0dca\u0dad\u0dad\u0dd2\u0dbb\u0db1\u0dca\u0dad \u0dd2\u0db3\u0da7\u0db4\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0dcf \u0d9c\u0dbd\u0dcf\u0d9a\u0dd4 \u0db1\u0dad\u0da7\u0dd4\u0db8\u0d9a\u0dca\u0dc2 \u0db1\u0dad\u0da7\u0dd4\u0d9c . \u0d92 \u0dc4\u0dad\u0db8 \u0db1\u0dad\u0da7\u0dd4\u0db8\u0d9a\u0dd2\u0db1\u0dca\u0dad\u0db8 \u0d9c\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0dc2\u0daf \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad? \u0d91\u0db1\u0dca\u0dad\u0db1 \u0d89\u0db1\u0dca\u0dad\u0db1 \u0d9c\u0d9a\u0db1\u0dcf\u0dad\u0dca\n\n\u0d85\u0db1\u0db0\u0dbb\u0dca\u0dbd\u0dba\u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0d91\u0d9a\u0dba\u0dd2. \u0d92\u0d9c\u0d9a\u0db1\u0dca\u0dad \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dca \u0dba\u0dda\u0d9a\u0dd2\u0dd2\u0daf \u0d9c\u0dad\u0da7\u0dbd\u0dd4\u0dc0\u0d9a\u0da7 \u0dd4\u0dbd\u0dc4\u0dd4\u0dba \u0dd4 \u0db1\u0dca\u0dad\u0db1\u0dcf \u0d9a\u0dd2\u0dba\u0dcf \u0db8\u0da7 \u0db8 \u0d9a\u0dba\u0dd2. \u0d92 \u200d\u0dbb\u0dc1\u0dda\u0db1\u0dba\u0da7 \u0d9c\u0daf\u0db1\u0dca\u0dad\u0db1 \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0d8b\u0dad\u0dca \u0dbb\u0dba \u0d92\u0d9a\u0dba\u0dd2."
