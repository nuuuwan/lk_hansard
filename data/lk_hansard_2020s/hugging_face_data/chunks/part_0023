    "chunk_text": "\u2022 \u0d91\u0dbd\u0dd9\u0dc3 \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0dc0\u0dd2\u0dc2\u0dba \u0db0\u0dcf\u0dbb\u0dcf\u0dc0 \u0dba\u0da7\u0dad\u0dda \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dad \u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0 \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0d9a\u0dbb \u0d91\u0db8 \u0d9a\u0dbb \u0d91\u0db8 \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0\u0dd9\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 5\u0d9a\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0db8\u0dd2 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0d9c\u0dd9\u0db1\u0dca\u0daf, \u0dc3\u0dd2\u0dba\u0dba\u0da7 95\u0d9a\u0dca \u0d9c\u0dd0\u0dc4\u0dd0\u0db1\u0dd4 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0d9c\u0dd9\u0db1\u0dca\u0daf \u0dc3\u0db8\u0db1\u0dca\u0dc0\u0dd2\u0dad \u0dc0\u0db1 \u0dbd\u0dd9\u0dc3 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0dda \u0d89\u0dc4\u0dc5\u0db8 Z \u0d85\u0d9c\u0dba \u0dc3\u0dc4\u0dd2\u0dad \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d85\u0dad\u0dbb\u0dd2\u0db1\u0dca \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc0\u0da7 \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc0\u0da7 \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dad \u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0 \u0dad\u0ddd\u0dbb\u0dcf \u0d9c\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dda.. * \u0dc0\u0dbb\u0dca\u0dc2 \u0daf\u0dd9\u0d9a\u0d9a\u0dca \u0dc4\u0ddd \u0d8a\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dbb\u0dca\u0dc2 \u0d9c\u0dab\u0db1\u0d9a \u0d85\u0db4\u0ddc\u0dc3 (\u0d8b\u0dc3\u0dc3\u0dca \u0db4\u0dd9\u0dc5) \u0db4\u0dca\u200d\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db5\u0dbd \u0db8\u0dad \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dd0\u0db1\u0dd3\u0db8\n\n02. \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0dc0\u0dda\u0daf\u0dd3 (\u0dc4\u0dd9\u0daf) \u0d8b\u0db4\u0dcf\u0db0\u0dd2\u0dba \u0db8\u