    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7 \u0d85\u0db4\u0dc3\u0dca \u0dca\u0da9\u0dbd\u0ddc \u0dab \u0dad\u0dab\u0dba\u0dd2, \u0dbb\u0dab \u0daf\u0dd4\u0dbb \u0dcf\u0dc3 \u0d85\u0d9c \u0dba\u0dd2, \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0dc0\u0ddc\u0dc4\u0dc3 \u0dba\u0dd2 \u0dd2\u0db1\u0db4\u0dca\u0dc3 \u0d85 . \u0dcf \u0d85 \u0da7\u0dad\u0dca \u0dbb\u0dab \u0daf\u0dd4\u0dbb \u0dcf\u0dc3 \u0d85\u0d9c \u0db4 \u0dca log \u0db4\u0dc0\u0dca\u0dc3 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca. \u0dcf \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 log \u0db4\u0dc0\u0d9a\u0ddc \u0d94\u0dc4\u0dd4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca, \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0dc0\u0ddc\u0dc4\u0dc3 \u0d85\u0d9c \u0d87\u0dad\u0dd4 \u0dc5\u0dad\u0dca \u0dbb\u0dca\u0dc3. \u0d8a\u0da7 \u0dbd\u0dd2\u0db8\u0dca \u0dcf \u0daf\u0dd4\u0dbb \u0dcf\u0dc3 \u0d85\u0d9c \u0db4 \u0dca \u0db4\u0dc0\u0dc3 \u0dc0\u0ddc\u0dc4\u0dc3 \u0dca \u0dbd\u0dd2\u0db8 \u0ddc \u0daf\u0dd2\u0d9c\u0da0\u0dd2 \u0db4\u0dc0\u0d9a\u0ddc \u0dd2\u0db1\u0db4\u0dca\u0dc3\u0dc0\u0ddc \u0dc3\u0db1, \u0dcf \u0d94\u0dc4\u0dd4\u0da7\u0dab delete \u0dbb\u0dca\u0dc3 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca. Delete \u0dbb\u0d9a\u0ddc, \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0d91 download \u0dbb\u0dca\u0dc3 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca. \u0dcf \u0db1\u0dd2\u0d82\u0ddc \u0db4\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0dab\u0dad \u0d85\u0db4\u0dd2 \u0dc4\u0dd2\u0dad\u0dc3\u0dc0\u0ddc, \u0d85\u0daf \u0daf\u0dc0\u0d82 \u0d87\u0dad\u0dd4 \u0dc5\u0dad\u0daf\u0dd3 \u0db4\u0db1 \u0dca\u0da9\u0dbd\u0ddc \u0db1 \u0db4\u0daf\u0db4\u0dca \u0dca\u0dca\u0dc3 \u0da2\u0dca\u200d\u0dc3\u0dad\u0ddc\u0dc0 \u0dad\u0dca \u0db4\u0dc0\u0d9a\u0ddc \u0dd2\u0db1\u0db4\u0dca\u0dc3 \u0d85 \u0dc4\u0dd4\u0d9a\u0dad\u0ddc\u0dc0 \u0dc0\u0dd2\u0d82\u0db3\u0ddc\u0db8\u0dca\u0dc3 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0db4\u0dc0\u0dba\u0dd2 \u0d9a\u0dd2 \u0d9a\u0ddc.\n\n\u0d91\u0da0\u0dca\u0db1\u0dbb \u0dc4\u0dd4\u0d9a \u0db1 \u0dc3\u0dd0\u0dc4\u0dd0, \u0db4\u0dad\u0dbd\u0dca \u0db4\u0db8\u0db1\u0dd2\u0dc4\u0dd2\u0dca \u0db4\u0daf\u0dca\u0dc3\u0dad\u0dca. \u0dcf \u0db1\u0dd2\u0d82\u0ddc \u0d85\u0db4\u0dd2 \u0da2\u0dca\u200d\u0dc3\u0dad\u0ddc\u0dc0\u0db4\u0db8\u0dca \u0dca\u0dbd\u0dca\u0d9a\u0ddc \u0dc3\u0dd2\u0da7\u0dd2\u0dca\u0db4\u0dca, \u0db1\u0dca\u0dab\u0ddc \u0dbb\u0d9a\u0ddc \u0dad\u0dab\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0dab \u0dad\u0dab\u0dca \u0db4\u0dd3\u0da9\u0dbd\u0ddc\u0dc0\u0da7 \u0dad\u0dca \u0dbb\u0db8\u0dca\u0dc3 \u0d91 \u0ddc \u0d9a\u0dd2 \u0d9a\u0ddc\u0dba\u0dd2. \u0dab\u0dab \u0dc4\u0dd2\u0dad\u0dc3\u0dc0\u0ddc, \u0daf\u0dd0\u0dca \u0db4\u0db1 QR code \u0d91 \u0d86\u0dc0\u0ddc\u0da7 \u0d82\u0dda\u0db4\u0d82\u0dda \u0db4\u0db1 \u200d\u0dbb\u0dc1\u0dda\u0dc3 \u0db4\u0dc4\u0da7 \u0dc3\u0db4\u0db0 \u0dca\u0db3\u0d9a\u0ddc \u0d82\u0db1\u0db4\u0dd6\u0dca\u0dab\u0db4 \u0dca \u0dc0\u0dd2\u0d82 \u0db4\u0db3\u0dba\u0dd2 \u0d9a\u0dd2 \u0d9a\u0ddc.\n\n\u0db8\u0db1\u0dca \u0dcf\u0ddc\u0dc3\u0ddc \u0dad\u0dd4 \u0dab\u0db1\u0dd2, \u0d85\u0dc0\u0d82\u0ddc\u0dc3 \u0dc0\u0dc1\u0db4 \u0dca \u0dab\u0dab \u0d9a\u0dd2 \u0dca\u0dc3 \u0d95\u0dc3\u0dd1, \u0d85\u0db4\u0dd2 \u0d94\u0dad\u0dca\u0db4\u0dad\u0dca, \u0dca\u0dbb\u0da7\u0dca\u0db4\u0da7\u0dca \u200d\u0dbb\u0dab \u0dc4\u0dd4 \u0dca\u0dc0\u0ddc \u0daf\u0dd4\u0dca\u0db4\u0dca\u0dad\u0dca \u0db4\u0db1 \u0d85\u0dc3\u0dc0\u0dc1\u0dba \u0db4\u0dd3\u0da9\u0dbd\u0dc3 \u0db1\u0dd2\u0d82\u0ddc \u0dca\u0dc0. \u0d91\u0db4\u0dc4\u0dab \u0dc3\u0dd0\u0dad\u0dca\u0dc3\u0db1 \u0d87\u0dad\u0dca\u0dad\u0da7\u0dab QR code \u0d91\u0db4 \u0dca \u0db4\u0db1 manage \u0dbb\u0dca\u0dc3 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca. \u0d94\u0dad\u0dca\u0db4\u0dad\u0dca, \u0dca\u0dbb\u0da7\u0dca\u0db4\u0da7\u0dca \u200d\u0dbb\u0dab \u0d85\u0db1\u0dd4\u0db8\u0dab\u0dc3 \u0dbb\u0db0\u0daf\u0dd2 \u0dbd\u0dd2\u0db8\u0dca \u0ddc\u0d9a\u0dc0\u0d9a\u0daf\u0dd3 \u0dc3\u0dd2\u0daf\u0dd4 \u0db4\u0dc0\u0da0\u0dca\u0db1 \u0db4\u0da7\u0dca\u0da9\u0dbd\u0dca \u0dab\u0db8\u0da9\u0dd2 \u0db1\u0dd2\u0d82\u0ddc number plates \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0db4\u0dc3\u0ddc \u0dbb\u0db4\u0dd4 \u0dc0\u0ddc\u0dc4\u0dc3 \u200d\u0dbb\u0dab\u0ddc\u0dab \u0dca \u0dd2\u0db1\u0db4\u0dca\u0dc3\u0dc0\u0ddc. \u0d85\u0db4\u0dd2 \u0dab\u0ddc\u0dca\u0dad\u0dd4 10\u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0ddc \u0d9c\u0dd2\u0dc0\u0dd2\u0dd4\u0d9a\u0dab \u0d85\u0dad\u0dca\u0d82\u0dca \u0dc5\u0dad\u0dca, \u0dcf \u0d9c\u0dd2\u0dc0\u0dd2\u0dd4\u0d9a\u0dab\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0dcf \u0d82\u0dab\u0ddc\u0db8\u0dab number plates \u0dd4\u0daf\u0daf\u0dca\u200d\u0dbb\u0dab \u0dbb\u0db0\u0daf\u0dd2 \u0dab\u0dd0\u0dba\u0dd2 \u0dab\u0ddc\u0d82\u0db4\u0dda \u0dd4\u0daf\u0dbd\u0dca \u0d82\u0dd2\u0db1 \u0dc0\u0ddc\u0db4 \u0dc0\u0dc3\u0dc0\u0ddc. \u0dcf \u0db1\u0dd2\u0d82\u0ddc number plate \u0d91 \u0dc3\u0dd0\u0dd2\u0db1 \u0d85 \u0da7 \u0db4\u0dad\u0dbd\u0dca \u0db8\u0dc4\u0db8\u0dca\u0dc3 \u0d9a\u0dd2\u0dc3\u0dd2 \u200d\u0dbb\u0dc1\u0dda\u0dc3 \u0dca \u0d87\u0dd2\u0db1 \u0dc0\u0dca\u0db4\u0dca \u0dc3\u0dd0\u0dc4\u0dd0. \u0d94\u0dc0\u0dd4\u0dca \u0d82\u0dad\u0dd4 \u0dc0 \u0dd2\u0db1\u0db4\u0dca\u0dc3\u0dc0\u0ddc, \u0dc0\u0ddc\u0dc4\u0dc3\u0db4\u0dda \u0d86\u0daf\u0ddc \u0db1 \u0dca\u0d9a \u0dad\u0dca\u200d\u0dbb , \u0daf\u0dd4\u0db1 \u0d82\u0dc4\u0dd2\u0db1 , \u0dc0\u0ddc\u0dc4\u0dc3\u0db4\u0dda \u0db4 \u0ddc\u0dad \u0d82\u0dc4 insurance \u0d91 . \u0db8\u0db1\u0dca \u0dcf\u0ddc\u0dc3\u0ddc \u0dad\u0dd4 \u0dab\u0db1\u0dd2, \u0dcf \u0dc4\u0dad\u0db4\u0dca\u0dab \u0dc0\u0ddc\u0dc4\u0dc3\u0db4\u0dda \u0d85\u0d9c \u0dd2\u0db1\u0db4\u0dca\u0dc3\u0dc0\u0ddc. \u0dca\u0dd2\u0db1\u0dca, \u0db4\u0db1 \u0dc4\u0dad\u0dbb\u0dab \u0d85\u0dbb\u0db4\u0db8\u0dc3 \u0dca\u0dc3 \u0d95\u0dc3\u0dd1 \u0dc3\u0dd0\u0dc4\u0dd0. \u0db4\u0dab\u0dba\u0dd2\u0dca \u0d91 \u0dca \u0db4 \u0ddc\u0db4\u0dc4\u0ddc\u0dab\u0dad\u0dca \u0dc0\u0ddc\u0dc4\u0dc3\u0db4\u0dda \u0dd2\u0db1\u0db4\u0dca\u0dc3\u0dc0\u0ddc. \u0dcf \u0db4 \u0dca\u0dc0\u0dd6\u0dc0\u0ddc\u0dab \u0db4\u0dad\u0dbd\u0dca \u0db8\u0dc4\u0db8\u0dca\u0dc3 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca. \u0db4\u0db1 \u0dc0\u0ddc\u0db4 \u0db4\u0db0\u0dc0\u0dbd\u0dca \u0da7\u0dca \u0db8\u0dca\u0dc3\u0ddc \u0dc0\u0dd2\u0da7 \u0db8\u0db1\u0dca \u0dab\u0dca\u0dd3\u0dad\u0dd4 \u0dab\u0ddc \u0d9a\u0dd2 \u0db4\u0dd4 \u0d86 \u0ddc\u0dbb\u0db4\u0dda \u0db1 \u0db1 \u0dc0\u0d9c\u0db1\u0db1\u0dd2 \u0db4\u0db0\u0dc0\u0dbd\u0dca \u0db4\u0dc0\u0dca\u0dc3 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca.\n\n\u0dc3\u0dd4\u0daf\u0dad\u0dca, \u0d85\u0db4\u0dd2 \u0db4\u0db1 \u0db4\u0dc0\u0d9a\u0ddc\u0db4\u0d9c\u0daf\u0dd3 \u0dc3 \u0dab \u0dc0\u0dc1\u0db4 \u0dca \u0dbd\u0dca \u0dc3\u0ddc \u0dbb\u0dca\u0db4\u0dca \u0d87\u0dad\u0dca\u0dad\u0da7\u0dab \u0da2\u0dca\u200d\u0dc3\u0dad\u0ddc\u0dc0\u0db4 \u0db4\u0db1 \u0d85\u0dc0\u0dc1\u0dba\u0dad\u0ddc\u0dc0 \u0d82\u0db1\u0db4\u0dd6\u0dca\u0dab \u0dbb\u0dca\u0dc3\u0dba\u0dd2. \u0db4\u0dc4\u0da7\u0dd2\u0dca \u0dc0\u0dd2\u0dad\u0dbb \u0dd4\u0d9a\u0dc0 \u0db4\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0d82\u0ddc\u0dab\u0ddc\u0dc3\u0dba \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0da7 \u0dad\u0dca \u0dc0\u0dd4\u0dab\u0ddc\u0dab \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0db1\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0ddc \u0dbb\u0dc3 \u0d85 \u0d82\u0db1\u0dca\u0dca \u0dc0 \u0d85\u0daf\u0ddc\u0dc5 \u0d85\u0dab\u0ddc\u0dad\u0dba\u0ddc\u0d9c\u0dc1 \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dbb\u0dba\u0dd2."
