0db8 \u0d85\u0dba\u0dd2\u0dd2\u0db1 \u0d86\u0dbb\u0dca\u0dc2\u0ddc \u0d9a\u0dd2\u0dbb\u0dd3\u0dab\u0da7 \u0dbb\u0da2\u0dca\u200d\u0db4\u0dda \u0d87\u0dd2\u0db1 \u0dc0\u0db8\u0dd3\u0db4\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0ddc\u0dc0\u0dbd\u0dd2\u0db8 \u0d9a\u0dd2.\n\n\u0daf\u0dd4\u0db1 \u0dbb\u0dd3\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0ddc\u0dc0\u0dbd\u0dd2\u0db8 \u0d82\u0db3\u0dc4\u0ddc \u0dbb\u0da2\u0dca\u200d\u0db4\u0dda \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0db8\u0dd6\u0d9a\u0dba \u0daf\u0ddc \u0dad\u0dca\u0dc0 \u0dca \u0d9a\u0dca\u0ddc \u0db4\u0dc3\u0ddc\u0db4\u0daf\u0dc3 \u0d85\u0dad\u0dbb, \u0daf\u0dd4\u0db1 \u0dbb\u0dd3\u0dca\u0dc2\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0ddc\u0dc0\u0dbd\u0dd2\u0db8 \u0dc4\u0dbb\u0dc4\u0ddc \u0da2\u0dca\u200d\u0dc3\u0dc3 \u0dc0\u0dc3 \u0dca \u0dd0\u0db8\u0dda\u0db4\u0dab\u0dca \u0db4 \u0ddc\u0dca\u0dad\u0dca\u200d\u0dbb\u0ddc\u0dad\u0dca \u0db1\u0dca\u0db4 \u0d86\u0daf\u0ddc \u0db4\u0dab\u0dca \u0dc3\u0dd2 \u0da7 10 \u0da7 \u0d82\u0dab\u0ddc\u0dc3 \u0dd4\u0daf\u0daf\u0d9a\u0dca \u0dc0\u0ddc\u0dba\u0dd4 \u0dc0\u0dd2\u0db4\u0dab\u0ddd\u0db1\u0dc3 \u0db7\u0ddc\u0dbb \u0dca \u0dc0\u0dc1\u0db4 \u0dca \u0d85\u0dbb\u0dd4\u0daf\u0daf\u0d9a \u0da7 \u0dbb\u0dd0\u0d82\u0dda \u0dbb\u0db1\u0dd4 \u0d9a\u0dd0\u0db4\u0db6\u0dca.\n\n(iii) 2025 \u0dc0\u0dca\u0dc2 \u0dad\u0dd4 \u0dc5 \u0dca\u0dd3\u0dba\u0dca\u0db4 \u0ddd \u0d9a\u0d9c \u0ddc \u0d82\u0dab\u0ddc\u0db8\u0dab \u0db1\u0dca\u0db4\u0dd2 \u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0db8 \u0dc3 179\u0dca \u0dc4\u0ddc \u0d9a\u0ddc\u0dc6\u0dda\u0d82\u0dda \u0d91\u0db4 \u0ddd \u0dca\u200d\u0dbb\u0dd3 \u0d82\u0dab\u0ddc\u0db8\u0dab \u0db1\u0dca\u0db4\u0dd2 \u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0db8 \u0dc3 210\u0dca \u0db4\u0d9a\u0d82 \u0db1\u0dca\u0db4\u0dd2 \u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0db8 \u0dc3 389 \u0dd4\u0daf\u0daf\u0d9a\u0dca \u0dc0\u0ddc\u0dba\u0dd4 \u0dc0\u0dd2\u0db4\u0dab\u0ddd\u0db1\u0dc3 \u0db7\u0ddc\u0dbb \u0ddc\u0dbb \u0d85\u0dbb\u0dd4\u0daf\u0daf\u0d9a \u0db4\u0dc0\u0dad \u0d9a\u0dca\u0ddc \u0daf\u0dd3 \u0d87\u0dad.\n\n\u0dad\u0dc0\u0daf, 2025 \u0dc0\u0dca\u0dc2\u0db4\u0dda\u0daf\u0dd3 \u0dca\u0dd3\u0dba\u0dca\u0db4 \u0ddd \u0d9a\u0d9c \u0ddc \u0d82\u0dab\u0ddc\u0db8\u0dab \u0dc4\u0ddc \u0d9a\u0ddc\u0dc6\u0dda\u0d82\u0dda \u0d91\u0db4 \u0ddd \u0dca\u200d\u0dbb\u0dd3 \u0d82\u0dab\u0ddc\u0db8\u0dab \u0dc0\u0dd2\u0dc3\u0dd2\u0dca VAT \u0db4\u0d9a\u0d82 \u0db1\u0dca\u0db4\u0dd2 \u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0db8 \u0dc3 792\u0dca\u0daf, \u0d82\u0dab\u0ddc\u0da2\u0dca\u200d \u0d86\u0dbb\u0dca\u0dc2\u0dab \u0dca\u0db0\u0daf \u0db4\u0d9a\u0d82 \u0db1\u0dca\u0db4\u0dd2 \u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0db8 \u0dc3 110\u0dca\u0daf \u0dc0\u0dc1\u0db4 \u0dca \u0db1\u0dca\u0db4\u0dd2 \u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0db8 \u0dc3 902\u0dca \u0db7\u0ddc\u0dca\u0da9\u0dbd\u0ddc\u0db8\u0ddc\u0dbb \u0db4\u0dc0\u0dad \u0db4 \u0ddc\u0dd4\u0daf \u0dbb \u0d87\u0dad.\n\n(\u0d87) \u0d85\u0daf\u0ddc\u0dc5 \u0db4\u0dc3\u0ddc\u0db4\u0d9c."
