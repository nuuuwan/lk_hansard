    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7 \u0d9c\u0dda \u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0dba\u0db1\u0dca\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db4\u0db1\u0dca\u0dd2\u0dba \u0daf\u0dcf \u0d91\u0d9a\u0dca\u0dc2\u0dc3\u0dad\u0dca \u0dba\u0dcf\u0dad\u0dd3\u0db1\u0dca\u0dad\u0d9c\u0dda \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dc2\u0d9a \u0d9a\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0dc3\u0dbd\u0dba\u0da7 \u0d9c\u0dba\u0ddd\u0dba\u0db1\u0dcf\u0dc0\u0d9a\u0dca\u0dc2 \u0d86\u0dc0\u0dcf. \u0dbb\u0dcf\u0dba\u0dba\u0dba\u0db1\u0dca\u0dad \u0d9c\u0dba\u0db1\u0dcf\u0dc0\u0d9a\u0dca\u0dc2 \u0d92 \u0d9c\u0dba\u0ddd\u0dba\u0db1\u0dcf\u0dc0\u0da7 \u0d91\u0d9a\u0d9f \u0dcf\u0dc0 \u0db4\u0dc5 \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dd4\u0dba\u0dcf; \u0dc3\u0db8 \u0dc3\u0dc4\u0d9c\u0dba\u0ddd\u0d9c\u0dd3 \u0dcf\u0dc0 \u0dbd\u0db6\u0dcf \u0da2\u0dbd\u0dcf \u0dad\u0dd2\u0dd4\u0dba\u0dcf. \u0db1\u0dd4\u0dbd\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0dc3\u0dc4\u0d9c\u0dba\u0ddd\u0d9c\u0dd3 \u0dcf\u0dc0 \u0dbd\u0db6\u0dcf \u0dd4 \u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dad\u0dc4\u0dad. \u0d85\u0db4\u0dd2 \u0dc3\u0dc4\u0d9c\u0dba\u0ddd\u0d9c\u0dd3 \u0dcf\u0dc0 \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dcf\u0dd4 \u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0d92 \u0d9c\u0dba\u0ddd\u0dba\u0db1\u0dcf\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0d85\u0dba\u0d9a\u0dca\u0dc2 \u0db4\u0db8\u0dba\u0d9a\u0dca\u0dc2 \u0dc3 \u0dba \u0dc0\u0db1 \u0db1\u0dd2\u0dc3\u0dcf\u0dba\u0dd2. \u0db8\u0dcf \u0daf\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf \u0dbb\u0da7\u0dc0\u0dbd\u0dca 130\u0d9a\u0dca\u0dc2 \u0d91\u0db8 \u0d9c\u0dba\u0ddd\u0dba\u0db1\u0dcf\u0dc0\u0da7 \u0dc3\u0dc4\u0d9c\u0dba\u0ddd\u0d9c\u0dd3 \u0dcf\u0dc0 \u0db4\u0dc5 \u0d9a\u0dbb \u0dad\u0dd2\u0dd4\u0dab\u0dd4 \u0db6\u0dc0. \u0db1\u0dd4\u0dbd\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0dc3\u0dc4\u0d9c\u0dba\u0ddd\u0d9c\u0dd3 \u0dcf\u0dc0 \u0db4\u0dc5 \u0d9a\u0d9c\u0dc5\u0dda \u0db1\u0dad\u0dc4\u0dad. \u0d85\u0db4\u0dd2 \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dc4\u0d9c\u0dba\u0ddd\u0d