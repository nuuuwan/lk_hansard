    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dc4,\u0dc4 \u0d9a\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2 \u0d85\u0daf \u0d85\u0db4\u0dd2 \u0dda\u0db8\u0dca \u0dda \u0ddd\u0da2,\u0dc4 \u0dc3\u0db8\u0dca\u0db8\u0dad\u0dca\u200d \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dc0 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dda\u0db1\u0dca\u0dad \u0d85\u0dad\u0dca\u200d\u0dba\u0dc0\u0dba\u0dba \u0dda\u0dc3\u0dc0\u0dc0\u0dc4 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dc0\u0dc4\u0dda\u0d9c, \u0dd1\u0dda\u0db8\u0dca \u0d85\u0dc0\u0dba\u0dba\u0dad\u0dca\u200d\u0dc4\u0dc0 \u0db1\u0dd2\u0dc3\u0dc40 \u0d85\u0dda\u0db4\u0dca \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dda \u0ddd\u0da2\u0dba \u0d85\u0db8\u0dc4\u0dad\u0dca\u200d\u0dba\u0dad\u0dd4\u0db8\u0db8\u0dc4 \u0d89\u0dad\u0dca\u200d\u0dc4\u0db8 \u0db4\u0dd0\u0db1\u0dd0\u0daf\u0dd2\u0dd2\u0dc0 \u0d92 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dc0 \u0d9a\u0dd9\u0dc40 \u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dc4,\u0dc4 \u0d9a\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2 \u0dda\u0db8\u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dbb\u0db4\u0dad\u0dca\u200d\u0dd9 \u0d86\u0db4\u0daf\u0dc4\u0dc0\u0d9a\u0dca \u0dc3\u0dd2\u0db0\u0dd2\u0db8\u0db0 \u0dc0\u0dd4\u0dab\u0dd4 \u0dda\u0dda\u0dbd\u0dc4\u0dc0\u0d9a \u0d92\u0dda\u0d9a\u0dca \u0d85\u0dc0\u0dba \u0d9a \u0dda\u0db6,\u0dc0\u0dc40 Emergency response \u0d91\u0d9a\u0dbb\u0dd3\u0db1\u0dca\u0dad \u0dc3\u0db1 rescue operation \u0d91\u0d9a\u0dbb\u0dd3\u0db1\u0dca\u0dad \u0db4\u0dc3\u0dc0\u0dda\u0dc3\u0dc0 \u0da7\u0dd2\u0dad\u0dca\u200d\u0dbd \u0db4\u0db1\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0da2,\u0dad\u0dca\u200d\u0dc4\u0dc0\u0dda \u0d86\u0dbb\u0dca \u0d9a \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dca\u200d , \u0dda\u0db8\u0dca \u0dc3\u0dd2 \u0dbd\u0da7\u0db8 \u0dc0\u0dd2\u0dba\u0dc4\u0dbd \u0db1\u0dc4\u0db1\u0dd2 \u0d9a\u0dca \u0dc3\u0dd2\u0db0\u0dd2\u0db8\u0db0 \u0dc0\u0dd4\u0dab\u0dd4 \u0d85\u0dc0\u0dc3\u0dc0\u0dae\u0dc4\u0dc0\u0d9a\u0dca \u0daf\u0dc0\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0dda\u0daf\u0d9a\u0dbb\u0dd3\u0db1\u0dca\u0dad \u0dda\u0d9c\u0dc4\u0da9\u0dbd \u0daf\u0dc4\u0db1\u0dca\u0dad, \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dda\u0daf \u0d9a\u0dca \u0dda,\u0dc4\u0dda\u0dc0\u0dba\u0dd20 \u0d91\u0dc0\u0d9a \u0d8a\u0da7 \u0d91\u0db1\u0dc4 \u0d9c\u0dd2 \u0d91\u0d9a\u0d9a\u0dca0 \u0da2, \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dca\u200d ,\u0dd0\u0dc0\u0dad\u0dca\u200d \u0dc0\u0dad\u0dca\u200d\u0dc4\u0dc0\u0d9a\u0dca \u0dc3\u0dc4\u0db8\u0dc4,\u0dba \u0dad\u0dca\u200d\u0dad\u0dca\u0dc0\u0dad\u0dca\u0dc0\u0dc0 \u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0dbb\u0dd3\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dc0\u0dba\u0dba \u0da7\u0dd2\u0dad\u0dca\u200d\u0dbd \u0db4\u0db1\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0db1 \u0d85\u0dc0\u0dba\u0dba \u0db4\u0dbb\u0dd2\u0dc3\u0dbb \u0d85\u0db4\u0da7 \u0daf\u0dc0\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0dda\u0daf\u0dbb\u0dd3\u0db1\u0dca\u0dad \u0db1\u0daf\u0db1\u0dca\u0dad, \u0db6\u0dd0\u0db1\u0dd00 \u0d92\u0d9a\u0da7 \u0d85\u0daf\u0dc4\u0dd9 \u0d85\u0dad\u0dca\u200d\u0dba\u0dc0\u0dba\u0dba \u0dda\u0dc3\u0dc0\u0dc0\u0dc4 \u0d9c\u0dab,\u0dc4\u0dc0\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dc0\u0dc4\u0dda\u0d9c, \u0dd1\u0db8\u0da7 \u0d85\u0dc0\u0dba\u0dba \u0dc0\u0dd0\u0da9\u0dbd \u0db4\u0dd2\u0dc5\u0dd2\u0dda\u0dc0\u0dd9\u0d9a\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dda\u0db8\u0dca \u0db1\u0daf\u0dd2\u0dc3\u0dd2 \u0db1\u0dd3\u0d9a \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dc0\u0dc4\u0dda\u0d9c, \u0db1\u0dca\u0dad\u0dda\u0db1\u0dca\u0dad0\n\n1985 1986\n\n[\u0d9c\u0dbb\u0dd4 \u0dda\u0dda.\u0dc3\u0dd3. \u0d85\u0dbd\u0dc0\u0dad\u0dd4\u0db8\u0dc0\u0dbd \u0db8\u0db1\u0dad\u0dca\u200d\u0dc4]\n\n2026 \u0db8\u0dc4\u0dbb\u0dca\u0dad\u0dd4\u0db8 06\n\n\u0d9a\u0dc4\u0dbd\u0dd3,\u0dc0 \u0dc3\u0db1 \u0daf\u0dd3\u0dbb\u0dca\u0d9d \u0d9a\u0dc4\u0dbd\u0dd3,\u0dc0 \u0d9c\u0dad\u0dca\u200d \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0db4\u0dd2 \u0dc0\u0dbb \u0dda\u0db8\u0dc4,\u0dc0\u0dc4\u0daf \u0d9a\u0dd9 \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0db8\u0dd0\u0daf\u0dd2\u0db1\u0dad\u0dca\u0dc0\u0dc0\u0dd3\u0db8\u0dca \u0dda\u0db8\u0dc4,\u0dc0\u0dc4\u0daf \u0dbb\u0dd3 , \u0d91\u0d9a0 \u0db1\u0dd2\u0dba\u0dc0\u0da0\u0dd2\u0dad\u0dca\u200d \u0dc0\u0dba\u0dda \u0db1\u0dca\u0dad\u0db8 \u0d85\u0db4\u0da7 \u0d92 \u0db8\u0dd0\u0daf\u0dd2\u0db1\u0dad\u0dca\u0dc0\u0dc0\u0dd3\u0db8\u0dca \u0dda\u0db8\u0dc4,\u0dc0\u0dc4\u0daf \u0dbb\u0dd3 \u0dbd\u0dc4 \u0db1\u0db3\u0dd4,\u0dc4 \u0d9c\u0db1\u0dca\u0dad, \u0dc3\u0dd2\u0db0\u0dd2\u0db8\u0db0 \u0dda\u0dc0\u0db1\u0dca\u0dad\u0dda\u0db1\u0dca\u0dad \u0d92 \u0d85\u0db1\u0dd4\u0dc0\u0dba\u0dd20 \u0d85\u0db4\u0dd2 ,\u0dd0\u0dc0\u0dad\u0dca\u200d ,\u0dd0\u0dc0\u0dad\u0dca\u200d \u0dda\u0db8\u0dca \u0dc3\u0db7\u0dc4\u0dc0\u0da7 \u0db8\u0dad\u0dca\u200d\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dad, \u0d95,\u0dd1 ,\u0dd0\u0db1\u0dd0 \u0dda\u0db8\u0dca \u0d86\u0db4\u0daf\u0dc4\u0dc0 \u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0dd2\u0db0\u0dd2\u0db8\u0db0 \u0dda\u0dc0\u0da0\u0dca\u0dcf \u0d92 \u0db6\u0dd0\u0dbb\u0dd1\u0dbb\u0dd4\u0db8\u0dca \u0db1\u0dc4\u0db1\u0dd2 \u0d9c\u0dd0,0 \u0d85\u0dda\u0db4\u0dca \u0dbb\u0dda\u0da7\u0dca \u0d86\u0dbb\u0dca \u0d9a \u0da7 \u0da2, \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dca\u200d \u0da7 \u0da7\u0dd2\u0dad\u0dca\u200d\u0dbd \u0db4\u0db1\u0dc3\u0dd4\u0d9a\u0db8\u0dca\u0dc0\u0dbd\u0da7 \u0d92 \u0dda\u0dc0\u0da0\u0dca\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db1\u0dc4\u0dbb \u0d9c\u0dd0, \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0dca\u200d, \u0db1\u0dd0\u0da7\u0dd2 \u0da7 \u0d85\u0db4\u0dd2 \u0d9a\u0dc4\u0da7\u0dc0\u0dad\u0dca\u0dc0 \u0db8\u0dad\u0dca\u200d\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dad, \u0d85\u0dc0\u0dba\u0dba ,\u0dd0\u0db1\u0dd00 \u0d92 \u0dc0\u0dc4\u0dda \u0db8 \u0d85\u0db4\u0dd2 \u0dda\u0db8\u0dca \u0d86\u0db4\u0daf\u0dc4\u0dda\u0dda rebuilding strategy \u0d91\u0d9a \u0db1\u0dd0\u0da7\u0dd2 \u0da7 \u0dda\u0dad\u0dca\u200d\u0ddd\u0dbb\u0dc4 \u0d9c\u0dad\u0dca\u0dc0\u0dda\u0dad\u0dca\u0dc0\u0dad\u0dca\u0dc0 \u0d9a \u0dda\u0db6 \u0dad\u0dca\u200d\u0dd0,\u0da7 \u0dc0\u0da9\u0dbd\u0dc4 \u0d85\u0da9\u0dd2 \u0d9a\u0dca \u0db1\u0dbb\u0dd2 \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0da7 \u0db1\u0dca\u0dad, \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dba \u0da7 \u0d92 \u0dc0\u0dd2\u0dba \u0da7 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dda\u0db8\u0dca\u0d9a ,\u0dd0\u0dc0\u0dad\u0dca\u200d \u0dda\u0d9c\u0dc4\u0da9\u0dbd,\u0d9c\u0dc4 \u0d9c\u0dad\u0dca\u200d \u0dba\u0dd4\u0dad\u0dca\u0dc0\u0dda\u0dad\u0dca\u0dc0 \u0dbb\u0dd3 , \u0d91\u0d9a0"
