    "chunk_text": "\u0db8\u0dd6\u0d9a\u0ddc\u0d82\u0dc3\u0ddc\u0dbb\u0dd6\u0daa \u0db8\u0db1\u0dca \u0dab\u0dca\u0dd3\u0dad\u0dd4 \u0dab\u0db1\u0dd2, \u0db4\u0dab \u0db4\u0dab\u0ddc\u0dc3 \u0dc0\u0ddc\u0db4 \u0d85\u0dc0\u0d82\u0dda\u0dcf\u0ddc\u0dc0\u0dca\u0daf \u0d9a\u0dd2 \u0d9a\u0ddc \u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dbd\u0dd2\u0db8 \u0dbb\u0db8\u0dd2\u0dca \u0dab\u0dab \u0dcf\u0ddc\u0dc0 \u0da7\u0dca \u0db8\u0dca\u0dc3\u0db1. \u0db4\u0dab \u0db4\u0db8\u0ddd\u0dd3\u0dba \u0dc0 \u0d85\u0db4\u0dd2 \u0dd4\u0daf\u0dc4\u0dd4\u0dab \u0daf\u0dd4\u0dca \u0dca\u0dad\u0ddc \u0dca\u0dd0\u0dbb\u0dd1\u0db1\u0dca\u0db1 \u0d85\u0dc0\u0d82\u0dda\u0dcf\u0ddc\u0dc0\u0dca. \u0db4\u0db1 \u0db4\u0db8\u0ddc\u0da9\u0dbd\u0dca \u0d85 \u0d82\u0dab\u0ddc\u0dc3 \u0dbb\u0dca\u0dc3 \u0dc3\u0dad\u0dca\u0d82\u0ddc\u0dc4 \u0dbb\u0dc3\u0dc0\u0ddc, 2022\u0daf\u0dd3 \u0d87\u0dd2\u0db1 \u0dc0\u0dd4\u0dab\u0dd4 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0da7. \u0dc3\u0dd4\u0daf\u0dad\u0dca, 2022\u0daf\u0dd3 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd4\u0db4\u0dca \u0d87\u0dad\u0dca\u0dad\u0da7\u0dab \u0d85 \u0da7 \u0db8\u0dd2\u0d9a\u0daf\u0dd3 \u0db8\u0dd0\u0db1\u0dd3\u0db4\u0db1 \u0dc1\u0dca\u0dd2\u0db1 \u0dc3\u0dd0\u0dd2\u0db1 \u0dd3\u0dab. \u0db4\u0dad\u0dbd\u0dca \u0db8\u0dd2\u0d9a\u0daf\u0dd3 \u0db8\u0dd0\u0db1\u0dd3\u0dab \u0d82\u0db3\u0dc4\u0ddc LCs open \u0dbb \u0db8\u0dca\u0dc3 \u0dca\u0dd0 \u0dc0 \u0d85 \u0da7 \u0dd2\u0db1\u0dd4\u0dab\u0ddc \u0db8\u0dd6\u0d9a\u0dba\u0dab \u0d85\u0dca\u0dd4\u0daf \u0dca. \u0db4\u0db1 \u0dbb\u0da7 \u0dca\u0d9c\u0db4 \u0ddc\u0db4\u0d9a\u0ddc\u0dad\u0dca\u0db7\u0ddc\u0dc0 \u0da7 \u0dad\u0dca \u0dbb\u0d9a\u0ddc \u0dd2\u0db1\u0dd4\u0db4\u0dca. \u0dc4\u0dd0\u0dca\u0dd0\u0dba\u0dd2, \u0d85\u0db4\u0dd2 \u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dbd\u0dd2\u0db8\u0dc0 \u0db4\u0dad\u0dca\u0db1\u0dca\u0db1 \u0db8\u0dca\u0dc3 \u0d85\u0dc0\u0dc1\u0dba\u0dba\u0dd2, \u0db4\u0db1 \u0d85\u0dc0\u0d82\u0dda\u0dcf\u0ddc\u0db4\u0d9c \u0d87\u0dd2\u0db1 \u0db4\u0dc0\u0d9a\u0ddc \u0dd2\u0db1\u0db4\u0dca\u0dca\u0db4\u0dca \u0db4\u0db8\u0ddd\u0dd3\u0dba \u0d85\u0dca\u0dd4\u0daf \u0dca \u0dca\u0dc0. \u0db4\u0db8\u0ddd\u0dd3\u0dba \u0dc0 \u0db4\u0dad\u0dbd\u0dca \u0d82\u0dd0 \u0dba\u0dd4\u0db1 \u0daf\u0ddc\u0dab\u0db4\u0dda - supply chain \u0d91\u0db4\u0dca - \u0d85\u0dca\u0dd4\u0daf \u0dca \u0d87\u0dd2\u0db1 \u0db4\u0dc0\u0d9a\u0ddc \u0dd2\u0db1\u0db4\u0dca\u0dc3\u0dc0\u0ddc. \u0dab\u0dab \u0db4\u0dd4\u0dc0\u0dad\u0dca\u0dc0\u0d9a \u0daf\u0dd0\u0dca \u0ddc, \u0d85\u0daf \u0db4\u0dc0\u0db0\u0daf\u0dd2 \u0db4\u0dca\u0ddc\u0dbb \u0db4\u0dad\u0dbd\u0dca \u0dca\u0dd0\u0dbb\u0d9a \u0db8\u0dd2\u0d9a \u0db4\u0da9\u0dbd\u0ddc\u0d9a\u0dca 112 \u0daf\u0dca\u0dc0\u0ddc \u0dca\u0dc4\u0dc5 \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0dd2\u0db1\u0db4\u0dca\u0dc3\u0dc0\u0ddc \u0d9a\u0dd2 \u0d9a\u0ddc. \u0dad\u0dc0 \u0da7\u0dca\u0da7\u0dd2 \u0d9a\u0dd2 \u0d9a\u0ddc \u0dd2\u0db1\u0dd4\u0dab\u0ddc, \u0ddc\u0dca\u0dad\u0ddc \u0daf\u0dd2\u0dc3 \u0da7 \u0dca\u0d82\u0dda\u0dc0\u0dbd\u0dd2\u0db8\u0dca \u0db4\u0d82\u0dc3\u0d9f \u0d87\u0daf\u0d9a\u0ddc \u0dad\u0dab\u0dba\u0dd2 \u0dbb\u0db4\u0da7\u0dca \u0db4\u0dad\u0dbd\u0dca \u0dc3\u0dd0\u0dd2\u0db1 \u0dc0\u0dd4\u0db4\u0dca \u0d9a\u0dd2 \u0d9a\u0ddc. \u0db4\u0db1 \u0d85\u0dc0\u0d82\u0dda\u0dcf\u0ddc\u0db4\u0d9c \u0d87\u0dd2\u0db1 \u0db4\u0dc0\u0d9a\u0ddc \u0dd2\u0db1\u0db4\u0dca\u0dc3 \u0d85\u0dca\u0dd4\u0daf \u0d85\u0db4\u0dd2 \u0d91\u0db4\u0dc4\u0dab \u0db4\u0dc3\u0ddc\u0db4\u0dc0\u0dba\u0dd2 \u0db4\u0dad\u0dca\u0db1\u0dca\u0db1 \u0db8\u0dca\u0dc3 \u0d95\u0dc3\u0dd1.\n\n\u0dc3\u0dd4\u0daf\u0dad\u0dca, \u0db4\u0db1 \u0dc0\u0ddc\u0db4 \u0d85\u0db4\u0db4\u0dca \u0ddc\u0d9a\u0dc3\u0db4 \u0dca \u0dca\u0dd0\u0dc4\u0dd0\u0dbb\u0dc0 \u0d91\u0dc3 \u0dca\u0ddc\u0dc4\u0dd2\u0dbb shock \u0d91 \u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0dbb\u0da7 \u0dc4\u0dd4\u0d9a\u0dbb\u0dc0\u0dca\u0db4\u0dca \u0db4 \u0ddc\u0db4\u0dc4\u0ddc\u0dab\u0daf, \u0da2\u0dca\u200d\u0dc3\u0dad\u0ddc\u0dc0\u0da7 \u0d91\u0dc4\u0dd2 \u0dca\u0dbb \u0d85\u0dc0\u0dab \u0dc0\u0dc1\u0db4 \u0dca \u0daf\u0dd0\u0db4\u0dc3\u0dc3 \u0dc0\u0dd2\u0db0\u0dd2 \u0da7 \u0db4\u0db1 \u0d85\u0dc0\u0d82\u0dda\u0dcf\u0ddc\u0dc0\u0da7 \u0dd4\u0daf\u0dc4\u0dd4\u0dab \u0db4\u0daf\u0dca\u0db4\u0dca \u0db4 \u0ddc\u0db4\u0dc4\u0ddc\u0dab\u0daf, \u0d85\u0db4\u0db4\u0dca \u0dab \u0dba\u0d82\u0dda\u0dcf\u0db7\u0ddc\u0dc0 \u0d85\u0db4\u0dd2 \u0dbb\u0dd0 \u0db8\u0dca\u0db4\u0dca \u0db4 \u0ddc\u0db4\u0dc4\u0ddc\u0dab\u0daf \u0d9a\u0dd2 \u0dc3 \u0ddc\u0d9a\u0dc3\u0dab \u0d82\u0dc4 \u0dbb\u0ddc\u0da2\u0dca\u200d\u0dba \u0dad\u0ddc\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2 \u0dc4\u0dd0\u0d9a\u0dd2 \u0ddc\u0dc0 \u0d85\u0db4\u0dd2 \u0db4\u0db1 \u0db4\u0dc0\u0d9a\u0ddc\u0db4\u0d9c \u0db4 \u0dca\u0dc0\u0db8\u0dd2\u0dca \u0dd2\u0db1\u0db4\u0dca\u0dc3\u0dc0\u0ddc. \u0db4\u0dab\u0ddc \u0daf, \u0db4\u0db1 \u0db4\u0dc0\u0d9a\u0ddc\u0dc0 \u0d9a\u0dd2 \u0dca\u0db4\u0dca \u0dca\u0dad\u0ddc \u0dca\u0dd0\u0dbb\u0dd1\u0db1\u0dca\u0db1 \u0db4\u0dab\u0ddc\u0db4\u0dc4\u0ddc\u0dad\u0dca.\n\n\u0db8\u0dd6\u0d9a\u0ddc\u0d82\u0dc3\u0ddc\u0dbb\u0dd6\u0daa \u0db8\u0db1\u0dca \u0dab\u0dca\u0dd3\u0dad\u0dd4 \u0dab\u0db1\u0dd2, \u0da2\u0dca\u200d\u0dc3\u0dab\u0ddc \u0dba \u0db1\u0dd2\u0db4 \u0ddd\u0da2\u0dca\u200d\u0dba \u0d87\u0dab\u0dd2\u0db1\u0dc0 \u0db4\u0d9a\u0d82 \u0dab\u0dab \u0dd0\u0dab\u0dd0\u0dd2\u0db1\u0dba\u0dd2, \u0db4\u0db1 \u0db4\u0dab\u0ddc\u0db4\u0dc4\u0ddc\u0db4\u0dad\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dcf\u0ddc \u0db4\u0dc3 \u0ddc \u0dbb\u0db4\u0dd4 \u0db4\u0daf \u0dca \u0db8\u0dd0\u0dc3 \u0dcf\u0ddc \u0dbb\u0dca\u0dc3. \u0db4\u0dab\u0dc4\u0dd2\u0daf\u0dd3, \u0d85\u0db4\u0db4\u0dca \u0da2\u0dca\u200d\u0dc3\u0dab\u0ddc \u0dba\u0dc0\u0d9a \u0d82\u0dc4 \u0dab\u0ddc \u0dba \u0db7\u0ddc\u0dc0\u0dd2\u0dad \u0dad\u0dd4 \u0dc5 \u0da2\u0dca\u200d\u0dc3\u0dad\u0ddc\u0dc0\u0db4 \u0dc4\u0dd0\u0dc3\u0dd2\u0dbb\u0dd3\u0dab \u0db4\u0dd2\u0dc5\u0dd2\u0dca\u0db3\u0dc0, \u0d94\u0dc0\u0dd4\u0dca\u0db4 \u0dc0\u0db8\u0d9a\u0dd3\u0dab \u0db4\u0dd2\u0dc5\u0dd2\u0dca\u0db3\u0dc0 \u0db4 \u0ddc\u0da9\u0dca\u0da9\u0dbd\u0dca \u0d82\u0ddc \u0da0\u0dca\u0da1\u0ddc \u0dbb\u0dca\u0dc3 \u0dd0\u0dab\u0dd0\u0dd2\u0db1\u0dba\u0dd2. \u0db4\u0dab\u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dab\u0ddc\u0db4\u0dc4\u0ddc\u0dad \u0da2\u0dca\u200d\u0dc3\u0dab\u0ddc \u0dba \u0d82\u0dad\u0dd4 \u0dc0 \u0dc0\u0dd2\u0db4\u0dc1\u0dda\u0dc2 \u0dc0\u0db8\u0d9a\u0dd3\u0dab\u0dca \u0dd2\u0db1\u0db4\u0dca\u0dc3\u0dc0\u0ddc. \u0d91 \u0dca \u0dad\u0dab\u0dba\u0dd2, \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0db4\u0dd4\u0dc0\u0dad\u0dca \u0dc0\u0ddc\u0dca\u0dad\u0ddc \u0d9a\u0dd2\u0dbb\u0dd3\u0dab. \u0dcf \u0dc0\u0ddc\u0db4 \u0dab \u0da2\u0dca\u200d\u0dc3\u0dad\u0ddc\u0dc0 \u0d9a\u0dca\u0d9a \u0dc0\u0dc3, \u200d\u0dbb\u0db4 \u0ddd \u0dc0\u0dc3 \u0d82\u0dc4 \u0db4\u0dca\u0ddc \u0db1\u0dca \u200d\u0dbb\u0dc0\u0dca\u0dad\u0dca\u0dd2\u0db1 - fake news - \u0dc0\u0ddc\u0dca\u0dad\u0ddc \u0db4\u0dc3\u0ddc \u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0dba\u0dd2. \u0da2\u0dca\u200d\u0dc3\u0dad\u0ddc\u0dc0 \u0d9a\u0dca\u0d9a \u0da7 \u0dad\u0dca \u0dbb\u0dc3 \u0db4\u0dd4\u0dc0\u0dad\u0dca \u0dc0\u0ddc\u0dca\u0dad\u0ddc \u0db4\u0dc3\u0ddc \u0dbb \u0dc3\u0dd2\u0da7\u0dd3\u0dab \u0d82\u0dc4 \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0daf\u0dad\u0dca\u0dad \u0dab\u0dad \u0daf\u0dc3\u0db1 \u0db4\u0dc0\u0d9a\u0ddc \u0dc0\u0ddc\u0dca\u0dad\u0ddc \u0dbb\u0dca\u0dc3 \u0db4 \u0dc5\u0db9\u0dd3\u0dab \u0da2\u0dca\u200d\u0dc3\u0dab\u0ddc \u0dba\u0dc0\u0d9a \u0dc0\u0da9\u0dbd\u0ddc\u0dad\u0dca \u0dc0\u0dd0\u0daf\u0db8\u0dad\u0dca \u0dc0\u0db8\u0d9a\u0dd3\u0dab\u0dca. \u0d85\u0db4\u0dd2 \u0d9a\u0dd2 \u0dca\u0db4\u0dca \u0dc3\u0dd0\u0dc4\u0dd0, \u0d91\u0dad\u0dd0\u0dc3\u0daf\u0dd3 overconfident \u0db4\u0dc0\u0d9a\u0ddc, \u0d94\u0dca\u0db4 \u0ddd\u0dab \u0dc4 \u0d9a\u0dd2 \u0d9a\u0ddc \u0da2\u0dca\u200d\u0dc3\u0dab\u0ddc \u0dba \u0dc0\u0ddc\u0dca\u0dad\u0ddc \u0dbb\u0dca\u0dc3 \u0d95\u0dc3\u0dd1 \u0d9a\u0dd2 \u0d9a\u0ddc. \u0d91\u0db4\u0dc4\u0dab \u0d95\u0dc3\u0dd1"
