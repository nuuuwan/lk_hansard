    "chunk_text": "\u0d85\u0db4\u0da7 \u0db8\u0dad\u0dca\u200d\u0d9a\u0dba\u0dd2 \u0dda\u0db8\u0dca \u0d86\u0dca\u0da9\u0dd4\u0dc0 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dda \u0d89\u0db1\u0dca\u0dad,\u0dda\u0d9a\u0dc4\u0da7 \u0d91\u0dc0 \u0daf\u0dc0\u0dc3\u0dc0\u0dc0\u0dbd \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dbb\u0db4\u0dd4 \u0d86\u0d9a\u0dc4\u0dbb 0 \"\u0d94\u0db6\u0dc4\u0db8\u0dc4 \u0dda\u0dbd\u0dc4\u0d9a\u0dca\u0d9a\u0da7 \u0d91\u0db1\u0dca\u0dad, \u0dbb\u0dd3 \u0dc4\u0db4\u0dd2 \u0dda\u0db8\u0dca\u0dc0\u0dc4\u0da7 \u0d8b\u0dad\u0dca\u0dc0\u0dad\u0dca\u200d\u0dbb \u0dda\u0daf\u0db1\u0dca\u0dad, \u0dbb\u0dd3 \u0dc4\u0db4\u0dd2 \" \u0dbb\u0dd3 \u0dbd\u0dc4 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d91\u0daf\u0dc4 ,\u0dd2\u0db1\u0dca\u0dad\u0daf \u0da2 \u0d9a \u0dc3\u0dc0\u0dc3 \u0db8\u0dd0\u0d9a \u0dad\u0dd4\u0db8\u0db8\u0dc4 \u0dc0\u0dd2\u0da2\u0dd2\u0dad\u0dca\u200d \u0dda\u0db1\u0dc0\u0dbb\u0dad\u0dca\u0dc0 \u0db8\u0dd0\u0d9a \u0dad\u0dd4\u0db8\u0db8\u0dc4 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dd4 \u0dda\u0db8\u0dca\n\n\u0d92 \u0dc0\u0dc4\u0dda \u0db8 \u0dda,\u0dde\u0d9a\u0dc4 \u0dda\u0daf\u0d9a\u0d9a \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d89\u0dbb\u0dc4, \u0da2\u0dc4\u0d9a \u0d9a \u0db1\u0dca\u0dad \u0dda\u0dda\u0dbb\u0dc4\u0d9c\u0db1\u0dca\u0dad, \u0d9c\u0dad\u0dca\u0dc0\u0dad\u0dd4\u0db8 \u0d8b\u0dad\u0dca\u0dc0\u0dc3\u0dc4\u0db1 \u0da7 \u0d92 \u0d9a\u0dd0\u0db4 \u0dbb\u0dd3\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0db4\u0dd2 \u0dda\u0db8\u0dca \u0d86\u0dca\u0da9\u0dd4\u0dda\u0dda \u0dc3\u0dd2 \u0dda\u0daf,\u0dc4\u0da7 \u0d85\u0dda\u0db4\u0dca \u0dc3\u0dc0\u0dad\u0dd4\u0db8\u0d9a \u0db4\u0dd4\u0daf \u0d9a\u0dbb\u0db1\u0dca\u0dad, \u0d95,\u0dd10 \u0d92 \u0dc0\u0dc4\u0dda \u0db8 \u0d85\u0db4\u0dd2 \u0d9c\u0dc4 \u0da2,\u0dad\u0dca\u200d\u0dc4\u0dc0\u0da7\u0dad\u0dca\u0dc0 \u0dc3\u0dc0\u0dad\u0dd4\u0db8\u0d9a \u0dc0\u0db1\u0dca\u0dad\u0dad\u0dca\u200d \u0dda\u0dc0,\u0dc0\u0dc40 \u0d85\u0db4\u0dd2 \u0daf\u0dd0\u0d9a\u0dca\u0d9a\u0dc4 \u0d92 \u0dc3\u0dd2\u0db0\u0dd2\u0db8\u0dba \u0dc0\u0dd4\u0dab\u0dc4\u0db8 \u0dbb\u0da2 \u0d92 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca\u0dc0\u0dad\u0dca\u200d\u0da7 \u0db8\u0dd0\u0daf\u0dd2\u0db1\u0dad\u0dca\u0dc0 \u0dda\u0dc0\u0dbd\u0dc4 \u0d92 \u0dda\u0dbb\u0ddd\u0d9c\u0dd3\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0dc4\u0db4\u0dd2\u0da7\u0dd2 \u0dda\u0dbb\u0ddd\u0db1\u0dbd\u0da7 \u0dda\u0d9c,\u0dc4\u0db4\u0dd4 \u0d85\u0dc0\u0dc3\u0dc0\u0dae\u0dc4\u0dda\u0dda\u0daf\u0dd3 \u0d9a\u0dbb\u0dc4\u0db4\u0dd2\u0da7\u0dd2 \u0dda\u0dbb\u0ddd\u0db1\u0dda \u0dc0\u0dc0\u0daf\u0dba\u0dc0\u0dbb\u0dd4 \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dd4 \u0d9c\u0dc4 \u0da2,\u0dad\u0dca\u200d\u0dc4\u0dc0 \u0dda\u0db8\u0dca \u0dbb\u0da7\u0da7 \u0d89\u0dad\u0dca\u200d\u0dc4\u0db8 \u0dda\u0db1\u0dc4\u0db3 \u0d86\u0daf\u0dbb\u0dca\u0dba \u0d9a\u0dca \u0db4\u0dab\u0dd2\u0dc0\u0dd4\u0da9\u0dbd \u0d9a\u0dca \u0dbd\u0db6\u0dc4 \u0daf\u0dd4\u0db1\u0dca\u0dad \u0db6\u0dc00 \u0d9a\u0dd8\u0dad\u0dca\u200d\u0dda\u0dda\u0daf\u0dd3 \u0da2,\u0dad\u0dca\u200d\u0dc4\u0dc0\u0d9a\u0dca \u0dc0\u0dd2\u0dba \u0da7 \u0d9c\u0dc4 \u0dda \u0da2,\u0dad\u0dca\u200d\u0dc4\u0dc0 \u0d92 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0d9a\u0db8 \u0d89\u0da7\u0dd4 \u0d9a\u0dd9\u0dc4 \u0dbb\u0dd3 , \u0d9a\u0dc4\u0dbb\u0dab \u0dad\u0dca\u0dc0 \u0dda\u0db8\u0dca \u0dda\u0db8\u0dc4\u0dda\u0db1\u0dc4\u0dda\u0dad\u0dca\u0dc0 \u0db8\u0db8 \u0dc3\u0dd2\u0dc4\u0dd2\u0db4\u0dad\u0dca\u0dc0 \u0d9a\u0dbb\u0db1\u0dca\u0dad, \u0d95,\u0dd10\n\n\u0db8\u0dd6\u0dbd\u0dc4\u0dc3,\u0dc4\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0dd2 \u0db1\u0dd2 \u0db8\u0dd0\u0daf \u0dda\u0db4\u0dbb\u0daf\u0dd2\u0d9c \u0d9a\u0dbd\u0dc4\u0db4 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d85\u0dda\u0db4\u0dca \u0db4\u0dca\u200d\u0dbb\u0db0\u0dc4,\u0db8 \u0dda\u0dad\u0dca\u0dc0 \u0d9c\u0dd0\u0db1\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0dc40 \u0d85\u0daf \u0d92 \u0dbb\u0da7\u0dc0\u0dbd \u0d87\u0d9a \u0dda\u0dc0\u0dbd\u0dc4 \u0d9a \u0dda\u0db6, \u0d85\u0dbb\u0dca\u0daf\u0dca\u0daf \u0d91\u0d9a\u0dca\u0d9a \u0d85\u0dda\u0db4\u0dca \u0dbb\u0dda\u0da7\u0dca \u0dda\u0dad\u0dca\u0dc0 \u0d9a\u0dbb\u0dca\u0db8\u0dc4\u0db1\u0dca\u0dad\u0dad\u0dca\u200d \u0da7 \u0dc0\u0dd2\u0dda\u0dba\u0dc0\u0dc2\u0dda \u0db1\u0dca\u0dad\u0db8 \u0d9a\u0dd4\u0da9\u0dbd\u0dc4 \u0dda\u0dad\u0dca\u0dc0 \u0dc0\u0dad\u0dd4\u0db8 \u0dc4\u0dd2\u0db8\u0dd2 \u0db1\u0dca\u0dad\u0da7 \u0dda\u0d9a\u0dc4\u0dba\u0dd2 \u0dc0\u0dc4\u0dda \u0db6\u0dbd\u0db4\u0dd1\u0db8\u0d9a\u0dca \u0d91 \u0dbd \u0dda\u0dc0\u0dba\u0dd2\u0daf \u0dbb\u0dd3 , \u0dc3\u0dd0\u0d9a \u0dbb\u0dd3\u0db1\u0dca\u0dad \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d92 \u0dda\u0d9c\u0dc4\u0dc0\u0dd2 \u0db8\u0db1\u0dad\u0dca\u0dc0\u0dc0\u0dbb\u0dd4 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dda\u0db1\u0dca\u0dad0 \u0dda\u0db8\u0dca \u0d86\u0dca\u0da9\u0dd4\u0dc0 \u0d92\u0d9a\u0da7 \u0db4\u0dd0\u0db1\u0dd0\u0daf\u0dd2\u0dd2 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0db8\u0dbb\u0d9a\u0dca \u0dad\u0dca\u200d\u0dc0\u0db8 \u0daf\u0dd3\u0dbd\u0dc4 ,\u0dd0\u0db1\u0dd00 \u0d92\u0dad\u0dca\u0dc0 \u0d91\u0d9a\u0dca\u0d9a\u0db8 \u0dbb\u0dd3 \u0db1\u0dca\u0dad, \u0d95,\u0dd1 \u0dda\u0db8\u0dca \u0d9a\u0dc4\u0dbb\u0dab \u0dad\u0dca\u0dc00 \u0db8\u0dc4 \u0db1\u0dd2\u0dda \u0ddd\u0da2, \u0d9a\u0dbb, \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0db4\u0dd9\u0dc4\u0dda\u0dad\u0dca\u0dc0 \u0d92 \u0dc0\u0dc4\u0dda \u0db8 \u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dd9\u0dc4\u0dda\u0dad\u0dca\u0dc0 \u0da2,\u0dad\u0dca\u200d\u0dc4\u0dc0 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dba\u0dda \u0db1\u0dca\u0dad \u0d9a\u0dd4\u0da9\u0dbd\u0dc4 \u0dda\u0dad\u0dca\u0dc0 \u0dc0\u0dad\u0dd4\u0db8 \u0d9a\u0dbb\u0dca\u0db8\u0dc4\u0db1\u0dca\u0dad\u0dad\u0dca\u200d\u0dda \u0dda \u0daf\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2,\u0dc0\u0dc4 \u0d85\u0daf \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0daf\u0dd0\u0da9\u0dd2 \u0dda\u0daf\u0d9c\u0dd2\u0da9\u0dd2 \u0dc4\u0dc0\u0dbb\u0dd3\u0db1\u0dca\u0dad \u0db4\u0dc3\u0dd4 \u0dda\u0dc0,\u0dc0\u0dc4 \u0d85\u0db8\u0dd4 \u0dda\u0dad\u0dca\u0dc0 \u0daf \u0dc0\u0dbd\u0da7 \u0d9a \u0dda\u0db6, \u0d89 \u0db8 \u0d85\u0da9\u0dd4 \u0dda\u0dc0\u0dba\u0dd2\u0daf \u0dbb\u0dd3 \u0dbd\u0dc40 \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dc4 \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0dc0\u0daf\u0dc4,\u0db8\u0d9a\u0dca \u0d87\u0d9a \u0dda\u0dc0\u0db1\u0dca\u0dad, \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0daf \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0dc0\u0daf\u0dc4,\u0db8\u0d9a\u0dca \u0d87\u0d9a \u0dc0\u0dd4 \u0dda\u0dab\u0dc4\u0dad\u0dca\u0dc0 \u0d86\u0dca\u0da9\u0dd4\u0dda\u0dda \u0d9a \u0dda\u0db6, \u0dc3\u0dd0\u0dbd\u0dc3\u0dd4\u0db8 \u0dda\u0db8\u0dc4\u0d9a\u0d9a\u0dca\u0daf \u0dbb\u0dd3 , \u0d9a\u0dc4\u0dbb\u0dab \u0dad\u0dca\u0dc0 \u0d86\u0dca\u0da9\u0dd4\u0dc0\u0d9a\u0dca \u0dc0\u0dd2\u0dba \u0da7 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dc4 \u0dda\u0db8\u0dca \u0dc3\u0db7\u0dc4\u0dc0 \u0db1\u0db8\u0dd4\u0dda\u0dda \u0dbb\u0dd3\u0dc0 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dd2 \u0dbb\u0dd3 , \u0d9a\u0dc4\u0dbb\u0dab \u0dad\u0dca\u0dc0 \u0dda\u0db8\u0dca \u0dda\u0db8\u0dc4\u0dda\u0db1\u0dc4\u0dda\u0dad\u0dca\u0dc0 \u0dc3\u0dd2\u0dc4\u0dd2\u0db4\u0dad\u0dca\u0dc0 \u0d9a\u0dbb\u0db1\u0dca\u0dad, \u0d95,\u0dd10"
  },
