b1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dbd\u0dda\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dbd\u0dda\u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dd9\u0dad \u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dbb \u0d87\u0dad. \u0db8\u0dda \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dc0\u0db1 \u0d85\u0db7\u0dd2\u0dba\u0dcf\u0da0\u0db1\u0dcf \u0daf \u0dcf\u0da0\u0db1\u0dcf \u0daf \u0dc3\u0dbd\u0d9a\u0dcf \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0d85\u0dad\u0dbb, \u0d9c\u0dd9\u0dc0\u0dcf \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc0\u0dcf \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0daf\u0dd2\u0db1\u0dba\u0d9a\u0dca \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0d9a\u0dbb \u0db1\u0ddc\u0db8\u0dd0\u0dad. \u0db8\u0dd0\u0dad. *\u0dc3\u0db7\u0dcf\u0db8\u0dda\u0dc3\u0dba \u0db8\u0dad \u0dad\u0db6\u0db1 \u0dbd\u0daf \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8\u0dca: \u0b9a\u0baa\u0bbe\u0baa\u0bc0\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bb5\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0ba3\u0bc8\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bcd :\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bcd : Annexes tabled:\n\n\u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 01\u0dab\u0dd4\u0db8 01\n\n1597 1598\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 02\u0dab\u0dd4\u0db8 02\n\n1599 1600\n\n[\u0d9c\u0dbb\u0dd4 (\u0d86\u0da0\u0dcf\u0dbb\u0dca\u0dba) \u0dc4\u0dbb\u0dd2\u0db1\u0dd2 \u0d85\u0db8\u0dbb\u0dc3\u0dd6\u0dbb\u0dd2\u0dba]]\n\n\u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 03\u0dab\u0dd4\u0db8 03\n\n2026 \u0db8\u0dcf\u0dbb\u0dca\u0dad\u0dd4 04\u0dca\u0dad\u0dd4 04\n\n\u0daf\u0dd0\u0db1\u0dca \u0db1\u0dd2\u0dc