b\u0d9a\u0dca\u0dc2\u0d9a \u0db6\u0dc5\u0d9a\u0dcf\u0d9c\u0d86 \u0db8\u0dd6\u0d9a\u0dc3\u0dda\u0dae\u0dcf\u0db1 \u0dc4\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0db8 (\u0dca) \u0dba\u0da7\u0d9c\u0dad\u0dca \u0d9c\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dc5 \u200d\u0dbb\u0dc1\u0dda\u0db1\u0dba \u0dad\u0db8\u0db6\u0dbb \u0d91\u0db8 \u0db8\u0dd6\u0d9a\u0dc3\u0dda\u0dae\u0dcf\u0db1 \u0dc0\u0dd2\u0dd2 \u0db1\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0d9c\u0d9c\u0db1 \u0dba\u0db1 \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2\u0db4\u0dc5\u0dc0 \u0dc3 \u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0d9c\u0d9a\u0dcf\u0da0\u0dca\u0dcf\u0dbb\u0d9a\u0dca\u0daf \u0dc3\u0dc4 \u0d92\u0dc0\u0dcf \u0d9c\u0dc0\u0db1\u0dca \u0d9c\u0dc0\u0db1\u0dca \u0dc0\u0dc1\u0d9c\u0dba\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a. \u0dc4\u0dd0\u0db6\u0dd0\u0db6\u0dbb \u0d92 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0d9c\u0da7 \u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0d9a\u0dd0\u0db6\u0dad\u0dd2\u0d9c\u0d9c\u0dcf \u0dc3\u0d9a\u0dd1\u0dc0 \u0db6\u0dc5\u0d9a\u0dcf \u0db8\u0dd6\u0d9a\u0dc3\u0dda\u0dae\u0dcf\u0db1\u0d9c\u0d86 \u0d9c\u0dad\u0dcf\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9c\u0dc0\u0d9a\u0dcf \u0db1\u0dd0\u0dc4\u0dd0. \u0dc3\u0db8\u0dc4\u0dbb \u0d9c\u0d9c\u0dcf\u0dc0\u0dd2\u0db4\u0dc5\u0dc0 \u0dc3 \u0dc3 \u0d9c\u0db6\u0db1\u0dca\u0db0\u0d9c\u0dba\u0db1\u0dca \u0dc3\u0db8\u0dc4\u0dbb \u0dca\u0daf\u0dcf\u0dba \u0d9c \u0db8\u0dcf\u0da7\u0d9c \u0dc3 \u0d9c\u0db6\u0db1\u0dca\u0db0\u0d9c\u0dba\u0db1\u0dca \u0d91\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0d9c\u0da7 \u0db1\u0dd2\u0dc1\u0dda\u0da0\u0dd2\u0dad \u0d9c\u0d9a\u0dc3 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9c\u0dc0\u0d9a\u0dcf \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0daf\u0dc4\u0dc3\u0d9a\u0dca \u0dad\u0db8\u0db6\u0dbb \u0db8\u0da7 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0d9c\u0db1\u0dca. \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c\u0dba\u0db8\u0da2\u0dcf\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0d9c \u0d9c \u0dc3 \u0d9c\u0db6\u0db1\u0dca\u0db0\u0d9c\u0dba\u0db1\u0dca \u0db1\u0dd0\u0dc0\u0dad \u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0dc0\u0dcf\u0da7\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0d9a\u0db6\u0dcf \u0daf\u0dd3\u0db8\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0dd3\u0db8\u0db8\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0d9c\u0db1\u0dca\u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0db8\u0db8 \u0db4\u0dc5\u0db8\u0dd4 \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u200d\u0dbb\u0dc1\u0dda\u0db1\u0dba \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0d9c\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\n\n\u0d9c\u0dbb\u0dd4 \u0db1\u0dd3\u0dad\u0dd2\u0da5 \u0dd4\u0dc3\u0db1\u0dd2\u0dbd\u0dca \u0dc0 \u0d9c\u0dbd \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bb0\u0ba3\u0bbf \u0b9a\u0bc1\u0ba9\u0bbf\u0bb2\u0bcd \u0bb5\u0b9f\u0bcd\u0b9f\u0b95\u0bb2) (The Hon. Sunil Watagala, Attorney-at-Law) \u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0db1 \u0d9c (\u0dca) (ii) \u200d\u0dbb\u0dc1\u0dda\u0db1\u0dba\u0da7 \u0d9a\u0db6\u0dcf \u0daf\u0dd4\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb \u200d\u0dbb\u0db8\u0dcf\u0dab\u0dc0\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0\u0db6\u0dbb \u0d9a\u0dd2\u0dba\u0d9a\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0d9a\u0dcf\u0d9a\u0d9c\u0d86 \u0d8a\u0da7 \u0d85\u0daf\u0dcf\u0dc5\u0dc0 \u200d\u0dbb\u0db8\u0dcf\u0dab\u0dc0\u0dad\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0d9a\u0dca \u0dc3\u0db4\u0dba\u0db1\u0dca\u0db1 \u0d9c\u0db4\u0dcf\u0d9c\u0dbb\u0dcf\u0db1\u0dca\u0daf\u0dd4 \u0dc0\u0db1\u0dc0\u0dcf."
