    "chunk_text": "\u0dad\u0dca\u200d\u0db8\u0dd4\u0db1\u0dca\u0dad,\u0dc4\u0db1\u0dca\u0dad\u0dda\u0dc3\u0dc0\u0dbd\u0dc4 \u0daf\u0dd0\u0db1\u0dca\u0dad \u0db1\u0daf\u0dd2\u0dc3\u0dd2 \u0db1\u0dd3\u0d9a \u0daf\u0dd3\u0dbb\u0dca\u0d9d \u0d9a\u0dbb\u0db1\u0dca\u0dad, \u0d9a\u0dae\u0dc4 \u0d9a\u0dbb,\u0dc0\u0dc40 \u0d92 \u0d86\u0db4\u0daf\u0dc4\u0dc0 \u0db1\u0dd2\u0dc3\u0dc4 \u0db8\u0dbb\u0dab \u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0dda\u0dc0\u0da0\u0dca\u0dcf \u0d85 \u0da7 \u0dc3\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dab \u0dc0\u0db1\u0dca\u0dad\u0daf\u0dd2 \u0db8\u0dd4\u0daf \u0da7\u0dd2\u0d9a\u0dc0\u0dad\u0dca\u0dc0 \u0dad\u0dca\u200d\u0dc0\u0db8 \u0dda\u0d9c\u0dc0\u0dbd\u0dc4 ,\u0dd0\u0db1\u0dd0 \u0dda\u0db1\u0dca\u0dad \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dda \u0ddd\u0da2\u0dba \u0d9a\u0dae\u0dc4,\u0dc4 \u0d9a\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd20 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad ,\u0db8\u0dca \u0dbb\u0dd3 \u0db1\u0dca\u0dad, \u0d92 \u0db8\u0dbb\u0dab \u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0dda\u0dc0\u0da0\u0dca\u0dcf \u0d85 \u0da7 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dc4 \u0dc3\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dab \u0dc0\u0db1\u0dca\u0dad\u0daf\u0dd2 \u0db8\u0dd4\u0daf \u0da7\u0dd2\u0d9a \u0dbd\u0db6\u0dc4 \u0daf\u0dd4\u0db1\u0dca\u0dad,\u0dc4 \u0dbb\u0dd3 \u0dbd\u0dc4? \u0d92 \u0dc0\u0dc4\u0dda \u0db8 \u0d85\u0dad\u0dd4\u0db8\u0dbb\u0dd4\u0daf\u0db1\u0db1\u0dca\u0dad \u0dda\u0dc0\u0da0\u0dca\u0dcf \u0d85 \u0dad\u0dca\u0dc0 \u0d89\u0db1\u0dca\u0dad,\u0dc0\u0dc40 \u0dad\u0dca\u200d\u0dc0\u0db8 \u0d92 \u0d85 \u0da7 \u0db8\u0dbb\u0dab \u0dc3\u0db1\u0d9a \u0d9a \u0dbd\u0db6\u0dc4 \u0dda\u0daf\u0db1\u0dca\u0dad, \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dc4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0d9a\u0db8\u0d9a\u0dca ,\u0dd0\u0db1\u0dd00 \u0dda\u0db8\u0dca \u0dc0\u0dc4\u0dda \u0d9c\u0dd0\u0da7 \u0dbb\u0dc4\u0dc2\u0dca \u0d9a\u0dca \u0d9a \u0dda\u0db6,\u0dc0\u0dc40 \u0d89\u0d9a \u0db1\u0dca\u0dad \u0dda\u0db8\u0dca\u0dc0\u0dc4 \u0d94\u0d9a\u0dca\u0dda\u0d9a\u0dc4\u0db8 \u0d9c\u0dd0, \u0d9a\u0dae\u0dc4 \u0d9a\u0dbb\u0db1\u0dca\u0dad, \u0d9c\u0dd2\u0dda \u0dc4\u0dad\u0dca\u0dc0 \u0db8\u0da7 \u0d9a \u0dda\u0db6, \u0d9a\u0dc4\u0dbd \u0dda\u0dda\u0dbd\u0dc4\u0dc0 \u0d89\u0d9a\u0dca\u0db8 , \u0db1\u0dd2\u0dc3\u0dc4 \u0db8\u0db8 \u0d92 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc0 \u0d9a\u0dae\u0dc4 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0dda\u0db1\u0dca\u0dad ,\u0dd0\u0db1\u0dd00\n\n2007 2008\n\n\u0db4\u0dc4\u0dbb\u0dca\u0dd2\u0dda\u0db8\u0dca\u0db1\u0dca\u0dad\u0dad\u0dd4\u0db8\u0dc0\n\n\u0d9a\u0dae\u0dc4 \u0d9a\u0dbb, \u0db6\u0dc00 \u0d92 \u0d85 \u0da7 \u0dbb\u0dd4\u0db4\u0dd2 200\u0d9a\u0dca 300\u0d9a\u0dca \u0db4\u0da9\u0dd2 \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dd9\u0dc4 \u0dbb\u0dd3 \u0dbd\u0dc4 \u0db8\u0db1 \u0dda\u0dbd\u0dc4\u0d9a\u0dd4\u0dc0\u0da7 \u0d9a\u0dae\u0dc4 \u0d9a\u0dbb,\u0dc0\u0dc40 ,\u0db8\u0dd4\u0dad\u0dca\u0dc0 \u0daf\u0dd0\u0db1\u0dca\u0dad \u0d86\u0db4\u0daf\u0dc4\u0dc0\u0da7 \u0dbd\u0d9a\u0dca \u0dda\u0dc0\u0dbd\u0dc4 \u0d89\u0db1\u0dca\u0dad, \u0d85 \u0da7 \u0dda\u0db8\u0dc4\u0d9a\u0d9a\u0dca\u0daf \u0dbd\u0db6\u0dc4 \u0daf\u0dd3 \u0d9a \u0dda\u0db6, \u0dc3\u0db1, ? \u0d92 \u0d85 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0db0\u0dda \u0db1\u0dca\u0dad \u0dad\u0dca\u200d\u0dc0\u0db8 \u0dc0\u0dd0\u0da9\u0dbd \u0db4\u0dd2\u0dc5\u0dd2\u0dda\u0dc0\u0dd9\u0d9a\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc4\u0dad\u0dca\u0dc0\u0db8\u0d9a \u0d9a\u0dbb ,\u0dd0\u0db1\u0dd00 \u0d9c\u0db8\u0dca\u0dc0\u0dbd \u0d89\u0db1\u0dca\u0dad, \u0d85 \u0da7 ,\u0db8\u0dca \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0d9a\u0dca\u0dc2 50 \u0dbd\u0db6\u0dc4\u0dda\u0d9c, \u0d89\u0da9\u0dbd\u0db8\u0d9a\u0dca \u0d85\u0dbb\u0dda\u0d9c, \u0db1\u0dca\u0dad, \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0d9a\u0db8 \u0d9a \u0dda\u0db6, \u0db6\u0dc0 \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0dad,\u0dc0\u0dc40 ,\u0db8\u0dd4\u0dad\u0dca\u0dc0 \u0dc0\u0dad\u0dd4\u0db8 \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0da7 \u0d92 \u0d85 \u0dc0\u0dad\u0dca\u0dc0\u0dda\u0dad\u0dca\u200d\u0db1\u0dca\u0dad \u0dd2\u0dba\u0dd4\u0db8\u0d9a\u0dca \u0d9c\u0db1\u0dca\u0dad, \u0d95,\u0dd1\u0daf \u0d91\u0dda\u0db1\u0db8 ,\u0dd0\u0dad\u0dca\u0dc0,\u0db8\u0dca \u0d92\u0dda\u0d9c\u0dc4 \u0dbd\u0db1\u0dca\u0dad\u0dda \u0d85\u0dba\u0dd2\u0d9a \u0dc0\u0dc4\u0dc3\u0dd2\u0d9a\u0db8\u0dca \u0dad\u0dca\u200d\u0db1\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0dad, \u0d95,\u0dd1\u0daf \u0d91\u0dda\u0db1\u0db8 ,\u0dd0\u0dad\u0dca\u0dc0,\u0db8\u0dca \u0dbb\u0da2\u0dda \u0db1\u0dca\u0dad \u0d89\u0da9\u0dbd\u0db8\u0d9a\u0dca \u0dda\u0daf,\u0dc0\u0dc4\u0daf \u0dbb\u0dd3 \u0dbd\u0dc4 \u0dad\u0dca\u200d\u0dc0\u0db8 \u0dbb\u0dd3 \u0dbd\u0dc4 ,\u0dd0\u0db1\u0dd00 \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dda \u0ddd\u0da2\u0dba \u0d9a\u0dae\u0dc4,\u0dc4 \u0d9a\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2 \u0db8\u0da7 \u0daf\u0dd0,\u0d9c\u0db1\u0dca\u0dad,\u0da7 \u0dbd\u0dd0\u0dda\u0db6, \u0d86\u0d9a\u0dc4\u0dbb \u0da7 \u0dda\u0db8\u0dca\u0dda\u0d9c\u0dc4 \u0dbd\u0db1\u0dca\u0dad\u0da7 \u0dbb\u0dd3 ,\u0dc0\u0dc4 Trust \u0d91\u0dda\u0d9a\u0db1\u0dca\u0dad \u0db8\u0dd4\u0daf \u0d9c\u0db1\u0dca\u0dad, \u0dbb\u0dd3 \u0dbd\u0dc40 \u0d92 \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dda\u0db1\u0dca\u0dad \u0dc0\u0dd0\u0dc0\u0dd2\u0dd2 \u0db8\u0dc4,\u0dc0 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0, \u0db7\u0dc4\u0dbb \u0db1\u0dbb\u0db1\u0dc4 \u0dda\u0daf,\u0dc0\u0dc4 \u0dbb\u0dd3 \u0dbd\u0dc40 \u0d89\u0db1\u0dca\u0dad\u0daf\u0dd2 \u0dc4\u0dda\u0dc0\u0db1\u0dca\u0dad \u0d86\u0db0\u0dc4\u0dbb \u0db8\u0dd4\u0daf \u0dbd\u0dd0\u0daf\u0dca\u0dda\u0dab\u0dc4\u0dad\u0dca\u0dc0 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0dda\u0daf,\u0dc0\u0dc4 \u0dbb\u0dd3 \u0dbd\u0dc4 \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dda\u0db1\u0dca\u0dad0 \u0dda\u0db8\u0dca\u0d9a \u0d85\u0dc3\u0dc4\u0db0\u0dc4\u0dbb\u0dab \u0d9a\u0dca0 \u0dda\u0db8\u0dc4\u0d9a\u0daf \u0dda\u0db8\u0dca\u0dda\u0d9c\u0dc4 \u0dbd\u0db1\u0dd4\u0dad\u0dca\u0dc0 \u0dda\u0db8\u0dca \u0dbb\u0dda\u0da7\u0dca \u0db4\u0dd4\u0dbb\u0dc0\u0dd0\u0dc3\u0dd2 \u0db1\u0dca\u0dad \u0d94\u0dc0\u0dd4\u0db1\u0dd4\u0dad\u0dca\u0dc0 \u0dda\u0db8\u0dca \u0dbb\u0dda\u0da7\u0dca \u0da2, \u0dda\u0d9a\u0dc4\u0da7\u0dc3\u0d9a\u0dca0 \u0d92\u0dda\u0d9c\u0dc4 \u0dbd\u0db1\u0dca\u0dad\u0da7 \u0dda\u0dc0,\u0db8 \u0dc0\u0dd0\u0dc0\u0dd2\u0dd2 \u0db8\u0dc4,\u0dc0 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0, \u0db7\u0dc4\u0dbb \u0db1\u0dbb\u0db1\u0dc4 \u0db8\u0dd4\u0daf \u0d9c\u0db1\u0dca\u0dad, \u0d85\u0dc0\u0dba\u0dba\u0dad\u0dca\u200d\u0dc4\u0dc0\u0d9a\u0dca ,\u0dd0\u0db1\u0dd00 \u0d86\u0dca\u0da9\u0dd4\u0dc0\u0da7 \u0d94\u0da0\u0dca\u0dcf\u0dbb \u0dc3 \u0dd2 \u0d9a \u0dda\u0db6,\u0dc0\u0dc4 ,\u0db8\u0dca \u0db8\u0db1\u0dc4 \u0db7\u0dc4\u0dca\u0da9\u0dbd\u0dc4\u0d9c\u0dc4\u0dbb \u0db4\u0dd2\u0dbb\u0dd2\u0dbd\u0dc4 \u0d89\u0d9a \u0dbb\u0dd2\u0dbd\u0dc4 \u0d9c\u0dd2\u0dc4\u0dd2 \u0dbd\u0dc4 \u0d9a \u0dda\u0db6,\u0dc0\u0dc4 ,\u0db8\u0dca \u0d87\u0dba\u0dd2 \u0d92 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0d9a\u0dca\u0dc2 50 \u0dda\u0daf\u0db1\u0dca\u0dad, \u0db6\u0dd0\u0dbb\u0dd2? \u0d92\u0d9a \u0dbd\u0db6\u0dc4 \u0dda\u0daf\u0db1\u0dca\u0dad, \u0dbb\u0dd3 \u0dbd\u0dc4\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0d89 \u0dbd\u0db1\u0dca\u0dad\u0dda\u0db1\u0dca\u0dad0"
