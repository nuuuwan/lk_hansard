    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dc0\u0dca\u0dc0\u0dcf, \u0db8\u0dd3\u0da7 \u0db4\u0dd9\u0dbb \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u0dbb\u0da2\u0dba\u0da7 \u0d8b\u0dc3\u0dcf\u0dc0\u0dd2 \u0da7 \u0d8b\u0dc3\u0dcf\u0dc0\u0dd2 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf\u0dad\u0dca \u0db8\u0dda\u0d9a \u0d9c\u0dda\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dbb\u0dd2 \u0dc0\u0dd4\u0dab\u0dcf \u0dc0\u0dcf\u0d9c\u0dda \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca. \u0db8\u0db8 \u0d92 \u0d9a\u0dca. \u0db8\u0db8 \u0d92 \u0dbb\u0da2\u0dba \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dc5\u0dda \u0db1\u0dd0\u0dc4\u0dd0. \u0d91\u0dad\u0d9a\u0ddc\u0da7\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dda \u0dda \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda. \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba\u0dba \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0db8\u0dda Bill \u0d91\u0d9a \u0db1\u0ddc\u0dc0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dcf\u0dc3\u0dba\u0dda \u0db8\u0dd0\u0daf \u0db7\u0dcf\u0d9c\u0dba\u0dda \u0dad\u0db8\u0dba\u0dd2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dda. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \"\u0daf\u0dd2\u0da7\u0dca\u0dc0\u0dcf\" \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab\u0dcf\u0da7\u0dd4\u0dc0 \u0d86\u0dc0\u0dda \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0db8\u0dda Bill \u0d91\u0d9a\u0dad\u0dca Supreme Court \u0d91\u0d9a\u0dda challenge \u0dc0\u0db1\u0dc0\u0dcf. \u0d9c\u0dd2\u0dba\u0db4\u0dcf\u0dbb \u0dcf\u0dbb Supreme Court \u0d91\u0d9a\u0dd9\u0db1\u0dca \u0daf\u0dd3\u0db4\u0dd4 \u0db1\u0dca \u0daf\u0dd3\u0db4\u0dd4 interpretation \u0d91\u0d9a\u0dda\u0db8 \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf, \u0db1\u0dc0\u0dcf, \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0daf\u0dd9\u0db1\u0dcf\u0da7\u0db8 \u0dc3\u0db8 \u0dbd\u0dd9\u0dc3 \u0db8\u0dda \u0daf\u0dda \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0daf\u0dd4\u0db4\u0dca\u0db4\u0dad\u0dca \u0db8\u0dd2\u0db1\u0dd2\u0dc4\u0dcf\u0da7 \u0db8\u0dd2\u0db1\u0dd2\u0dc4\u0dcf\u0da7 \u0d8b\u0daf\u0dc0\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d86\u0db4\u0dd4 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0d85\u0daf \u0dbd\u0dd3\u0dc3\u0dd2\u0d82 \u0d86\u0dba\u0dad\u0db1\u0dc0\u0dbd\u0da7, \u0dad\u0db1\u0dc0\u0dbd\u0da7, finance companies\u0dc0\u0dbd\u0da7, \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0dbd\u0da7 \u0dc3\u0dc4\u0dcf\u0dba \u0daf\u0dd9\u0db1\u0dc0\u0dcf. \u0d92 \u0db6\u0dd0\u0d82\u0d9a\u0dd4 \u0db1\u0dc0\u0dcf. \u0d92 \u0db6\u0dd0\u0d82\u0d9a\u0dd4 safety net \u0d91\u0d9a\u0dd9\u0db1\u0dca \u0d91\u0dc5\u0dd2\u0dba\u0dda \u0dad\u0dd2\u0dba\u0dbd\u0dcf \u0db4\u0ddc\u0da9\u0dd2 \u0db4\u0ddc\u0da9\u0dd2 \u0d85\u0dba \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0db8\u0dda\u0d9a\u0da7 \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf. \u0db8\u0dda\u0d9a, \u0dbb\u0da7\u0dda \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0db1 \u0db6\u0dbd\u0dc0\u0dda\u0d9c\u0dba \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0da7 \u0daf\u0dd4\u0db1\u0dca \u0da2\u0db1 \u0dc0\u0dbb\u0db8\u0da7 \u0dc0\u0dd2\u0dbb\u0ddd\u0db0\u0dd3 \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca. \u0d9a\u0dca. \u0d91\u0d9a \u0db4\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd2\u0db1\u0dca \u0d87\u0db8\u0dd9\u0dbb\u0dd2\u0d9a\u0dcf\u0db1\u0dd4 \u0da9\u0ddc\u0dbd\u0dbb\u0dca 2 00\u0d9a \u0dab\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db8\u0dda\u0d9a \u0d85\u0dad\u0dca\u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0db4\u0dca\u200d\u0dbb\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0, \u0dab\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db1\u0dda. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0db1\u0dd2\u0dba\u0dcf\u0db8\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0d9a\u0ddc\u0da7 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0daf\u0dd9\u0db1\u0dcf\u0da7\u0db8 \u0dc3\u0db8 \u0dc3\u0dda \u0db8\u0dda \u0db1\u0dd2\u0dba\u0dcf\u0db8\u0db1\u0dba \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dc5\u0dcf \u0db1\u0db8\u0dca \u0d85\u0db4\u0da7 \u0db8\u0dda\u0d9a \u0dba\u0db8\u0dca\u0dad\u0dcf\u0d9a\u0dca \u0daf\u0dd4\u0dbb\u0d9a\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0db1 \u0db8\u0dca\u0dad\u0dcf\u0d9a\u0dca \u0daf\u0dd4\u0dbb\u0d9a\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca."
  },
