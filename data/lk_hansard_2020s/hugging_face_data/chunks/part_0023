    "chunk_text": "\u0db8\u0dd6\u0dbd\u0dc4\u0dc3,\u0dc4\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dd2 \u0d92 \u0dc0\u0dc4\u0dda \u0db8 \u0db8\u0db8 \u0d89\u0dad\u0dca\u200d\u0dc4 \u0dc0\u0d9c\u0d9a\u0dd3\u0dda\u0db8\u0db1\u0dca\u0dad \u0dbb\u0dd3 ,\u0dc0\u0dc4 \u0d89\u0dbb\u0dc4, \u0dad\u0dca\u200d\u0dc4,\u0dc4\u0db4\u0d9a \u0d9a\u0dc4\u0dbb\u0dca \u0dc4\u0dbd\u0dda \u0d89\u0db1\u0dd9 \u0db1\u0dd2\u0dbd\u0db0\u0dc4\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0db1\u0d9a \u0d9a \u0d9a\u0dbb\u0dbd\u0dc4 \u0dbb\u0dd3\u0dda\u0dc0\u0dc4 \u0dda\u0db8\u0dca ,\u0dd0\u0dda \u0dad\u0dd4\u0db8, \u0dbd\u0d82\u0d9a\u0dc4\u0dc0\u0da7 \u0d86\u0dda\u0dda \u0dbd\u0d82\u0d9a\u0dc4\u0dda\u0dda ,\u0dc4\u0dc0\u0dd2\u0d9a \u0db1\u0db8\u0dd4\u0daf\u0dc4 \u0db4\u0d9a \u0dad\u0dd4\u0db8\u0db8\u0dc4\u0dda \u0d89 \u0dbd\u0dd3\u0db8 \u0d85\u0db1\u0dd4\u0dc0 \u0dbb\u0dd3 \u0dbd\u0dc40 \u0db8\u0db8 \u0dda\u0db8\u0dca\u0d9a \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dda\u0db1\u0dca\u0dad \u0dc0\u0d9c\u0d9a\u0dd3\u0dda\u0db8\u0db1\u0dca\u0dad0 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dc4 ,\u0dc4\u0dc0\u0dd2\u0d9a \u0db1\u0db8\u0dd4\u0daf\u0dc4\u0db4\u0d9a \u0dad\u0dd4\u0db8\u0db8\u0dc4\u0dda\u0d9c\u0db1\u0dca\u0dad \u0d85\u0db1\u0db1\u0dca\u0dad, \u0d91\u0dda\u0db1\u0db8 \u0d86\u0dbb\u0dc4\u0db0,\u0dc4\u0dc0\u0d9a\u0dca \u0d9a\u0dd9\u0dc4\u0daf ,\u0dd0\u0db0\u0dd2\u0db8\u0daf \u0dbb\u0dd3 \u0dbd\u0dc40 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dc4 \u0d85\u0db1\u0db1\u0dca\u0dad,0 \u0db8\u0db8 \u0dda\u0db8\u0dca\u0d9a \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dda\u0db1\u0dca\u0dad \u0d89\u0dad\u0dca\u200d\u0dc4 \u0dc0\u0d9c\u0d9a\u0dd3\u0dda\u0db8\u0db1\u0dca\u0dad0 \u0db8\u0db8 \u0dda\u0db8\u0dca \u0dbb\u0dd3 \u0db1\u0dca\u0dad\u0dda\u0db1\u0dca\u0dad \u0d89\u0dbb\u0dc4, \u0dad\u0dca\u200d\u0dc4,\u0dc4\u0db4\u0d9a \u0dad\u0dd4\u0db8\u0db8\u0dc4 \u0dbb\u0dd3 \u0db4\u0dd4 \u0dda\u0db0\u0dd2\u0db80 \u0d91\u0dad\u0dca\u200d\u0dda\u0d9a\u0dc4\u0da7 \u0d9a\u0dc0\u0dd4\u0daf \u0d92 \u0d86\u0dbb\u0dc4\u0db0,\u0dc4\u0dc0 \u0d9a\u0dda\u0dd9\u0dc0? \u0d91\u0dad\u0dca\u200d\u0dda\u0d9a\u0dc4\u0da7 \u0d86\u0dca\u0da9\u0dd4\u0dc0 \u0daf\u0db1\u0dca\u0dad\u0dda\u0db1\u0dca\u0dad ,\u0dd0\u0dad\u0dd4\u0db8\u0dc0\u0daf ,\u0dc4\u0dc0\u0dd2\u0d9a \u0db1\u0db8\u0dd4\u0daf\u0dc4\u0db4\u0d9a \u0dad\u0dd4\u0db8\u0db8\u0dc4 \u0d92 \u0d86\u0dbb\u0dc4\u0db0,\u0dc4\u0dc0 \u0d9a\u0dda\u0dd9\u0dc0? \u0d91\u0dda\u0db1\u0db8 ,\u0db8\u0dca \u0d92\u0d9a \u0d9c\u0dd0, \u0dda\u0db1\u0dc4 \u0dbd\u0dc4 \u0db6\u0dbd\u0db1\u0dca\u0dad,0 \u0dda\u0db8\u0dca \u0d86\u0dca\u0da9\u0dd4\u0dc0 \u0daf\u0db1\u0dca\u0dad\u0dda\u0db1\u0dca\u0dad ,\u0dd0\u0dad\u0dd4\u0db8\u0dc0 ,\u0dc4\u0dc0\u0dd2\u0d9a \u0db1\u0db8\u0dd4\u0daf\u0dc4\u0db4\u0d9a \u0dad\u0dd4\u0db8\u0db8\u0dc4 \u0d91\u0dda\u0db1\u0db8 \u0d86\u0dbb\u0dc4\u0db0,\u0dc4\u0dc0\u0d9a\u0dca \u0d9a\u0dd9\u0dc4\u0daf \u0dbb\u0dd3 , \u0d91\u0d9a \u0dda\u0db1\u0dc4 \u0dbd\u0dc4 \u0db6\u0dbd\u0db1\u0dca\u0dad,0 [\u0db6\u0dc4\u0db0\u0dc4 \u0dbb\u0dd3\u0dbb\u0dd3\u0db8\u0d9a\u0dca]\n\n2045 2046\n\n2026 \u0db8\u0dc4\u0dbb\u0dca\u0dad\u0dd4\u0db8 06\n\n\u0da2,\u0dad\u0dca\u200d\u0dc4 \u0dc0\u0dd2\u0db8\u0dd4\u0d9a\u0dca\u0d9a \u0dda\u0db4\u0dbb\u0db8\u0dd4\u0dab \u0dc0\u0dd2\u0dda\u0dba\u0dc0\u0dc2\u0dda \u0db1\u0dca\u0dad\u0db8 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dc4 \u0dda\u0db0\u0dd2\u0db8\u0dba\u0db4\u0dc4\u0dbd, \u0d9a\u0dbb, \u0d9a\u0dc4\u0dbd\u0dda \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dc4 \u0dda\u0db8\u0dca \u0dbb\u0dda\u0da7\u0dca \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dda \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d9a\u0dc4\u0dbd\u0dda \u0dda\u0db8\u0dca \u0db6\u0dbd\u0dc0\u0dad\u0dca\u0dc0 \u0dbb\u0da7\u0dc0 \u0d85\u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca\u0dc0 \u0dbb\u0da7\u0dc0\u0dbd\u0da7 \u0d9a\u0dbb, \u0d85\u0dc3\u0dc4\u0db0\u0dc4\u0dbb\u0dab \u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0db0\u0dd2\u0db8\u0db0\u0dc0 \u0db1\u0dd0\u0db8 \u0d9a \u0dc3\u0dc0\u0dda\u0dc3\u0dc0 \u0db8 \u0dd2\u0db4\u0dca\u0da7\u0db1\u0dca\u0dad \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0dda\u0db8\u0dca \u0d87\u0dda\u0db8\u0dbb\u0dd2\u0d9a\u0dc4\u0db1\u0dd4 \u0dad\u0dca\u200d\u0dc4,\u0dc4\u0db4\u0d9a \u0d9a\u0dc4\u0dbb\u0dca \u0dc4\u0dbd \u0d89\u0dc3\u0dc0\u0dc3\u0dbb\u0db1 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d8b\u0daf\u0dc0\u0dd2 0 \u0dda\u0db8\u0dca \u0d89\u0dc3\u0dc0\u0dc3\u0dbb\u0db1 \u0dda\u0db4\u0dca\u0dc5\u0dd2\u0dda \u0d89\u0db1\u0dca\u0dad, \u0d87\u0db8\u0d9a \u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0dad \u0d94\u0d9a\u0dca\u0dda\u0d9a\u0ddd\u0db8 \u0dc0\u0dc4\u0dda \u0d91\u0daf\u0dc4 \u0d91\u0dda\u0db1\u0db8 \u0dc4\u0dd2\u0da7\u0dd2 \u0dc40 \u0db8\u0dc4 \u0dd9\u0d9f \u0d9a \u0dda\u0db6,\u0dc0\u0dc4 \u0d92 video clips. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db8\u0db1\u0dca\u0dad\u0dbd\u0dc4 \u0d91\u0daf\u0dc4 \u0d91\u0dda\u0db1\u0db8\u0dba\u0dd2 \u0dc4\u0dd2\u0da7\u0dd2\u0dda 0 \u0dc0\u0dd2\u0da2\u0dd2\u0dad\u0dca\u200d \u0dda\u0db1\u0dc0\u0dbb\u0dad\u0dca\u0dc0 \u0d87\u0db8\u0d9a \u0dad\u0dd4\u0db8\u0db8\u0dc4 \u0db6\u0dd2\u0db8 \u0dbb\u0dad\u0dca\u0dc0,\u0dc4 \u0d9a ,\u0dd2\u0db1\u0dca\u0dad\u0daf \u0da2 \u0d9a \u0dc3\u0dc0\u0dc3 \u0d91\u0daf\u0dc4 \u0d91\u0dda\u0db1\u0db8 \u0dc4\u0dd2\u0da7\u0dd2 \u0dc40 \u0db8\u0db8\u0dad\u0dca\u0dc0 \u0d89\u0db3\u0dbd\u0dc4 \u0d9a \u0dda\u0db6,\u0dc0\u0dc4 \u0d92 \u0dda\u0db4\u0dd9\u0db4\u0dc4\u0dc5\u0dd2\u0dc0\u0dbd \u0dda\u0db8\u0dca \u0d9a\u0dbb\u0db4\u0dd4 \u0d85\u0dc3\u0dc4\u0db0\u0dc4\u0dbb\u0dab\u0dc0\u0dbd\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0db0\u0dd2\u0db8\u0db0\u0dc00 \u0d91\u0dda\u0db1\u0db8 \u0d9a\u0dbb\u0db4\u0dd4 \u0dda\u0db0\u0dd2\u0db8\u0dba\u0db4\u0dc4\u0dbd, \u0dc0\u0dba\u0dc4\u0db4\u0dc4\u0dbb \u0d9a\u0dca \u0d85\u0daf \u0dc0,\u0dda\u0d9a\u0dc4\u0da7 \u0d89\u0dad\u0dca\u200d\u0dc4\u0db8 ,\u0db4\u0dd4\u0d82\u0dc3\u0d9a \u0dc0\u0dd2\u0dba \u0da7 \u0db1\u0dd0\u0dc3\u0dd2\u0dbb\u0dd3\u0db8 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dc0, \u0d9a \u0dda\u0db6\u0db1\u0dca\u0dad\u0dda\u0db1\u0dca\u0dad0 \u0d85\u0db4\u0dd2 \u0dbb\u0dd3\u0dda\u0dda\u0dda ,\u0dd0\u0db1\u0dd0 \u0d89\u0dbb\u0dc4, \u0dad\u0dca\u0dc0 \u0d91\u0d9a\u0dca\u0d9a \u0d91\u0d9a\u0dad\u0dd4\u0db8 \u0dda\u0dc0\u0dbd\u0dc4 \u0d9c\u0dd2\u0dc4\u0dd2 \u0dbd\u0dc4 \u0d87\u0dda\u0db8\u0dbb\u0dd2\u0d9a\u0dc4\u0dc0\u0da7 \u0d9c\u0db1\u0db1\u0dca\u0dad, \u0d8a\u200d\u0dbb\u0dc4 \u0dbd \u0da7 \u0d9c\u0db1\u0db1\u0dca\u0dad, \u0dbb\u0dd3 \u0dbd\u0dc40 \u0d85\u0db4\u0dd2 \u0dbb\u0dd3\u0dda\u0dda\u0dda \u0d92\u0d9a \u0dda,\u0dc4\u0dda\u0dc0\u0dba\u0dd20 \u0d85\u0db4\u0dd2 \u0dbb\u0dd3\u0dda\u0dda\u0dda \u0db8\u0dd3\u0da7 \u0dda\u0db4\u0dbb \u0dda\u0db8\u0dca \u0dc0\u0dc4\u0dda \u0db4\u0dca\u200d\u0dbb\u0dba\u0dc0, \u0db8\u0dad\u0dd4\u0db8 \u0dc0\u0dd4\u0dab\u0dc4\u0db8 \u0d85\u0dc3\u0dc4\u0db0\u0dc4\u0dbb\u0dab \u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0db0\u0dd2\u0db8\u0db0\u0dc0 \u0dba\u0dd4\u0d9a\u0dca\u0d9a \u0dda\u0dc0\u0db1\u0dd4\u0dda\u0dc0\u0db1\u0dca\u0dad \u0d85\u0dda\u0db4\u0dca \u0dbb\u0dda\u0da7\u0dca \u0dbb\u0dc4\u0da2\u0dba ,\u0dc4 \u0d9a \u0db1\u0dca\u0dad \u0db1\u0dd0\u0db8\u0daf\u0dc4\u0db8 \u0dda\u0db4\u0db1\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2 \u0db6\u0dc00"
