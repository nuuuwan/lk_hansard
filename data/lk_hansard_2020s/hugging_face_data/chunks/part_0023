    "chunk_text": "\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0dad\u0dc0\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf. \u0db1\u0dc0\u0dcf. \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab\u0dcf\u0da7\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dc0\u0dd2\u0db4\u0dad\u0da7 \u0db4\u0dad\u0dca \u0dc0\u0dd4\u0dab\u0dd4 \u0d9a\u0da7\u0dca\u0da7\u0dd2\u0dba\u0da7 \u0dad\u0dc0\u0db8 \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba\u0dba \u0d86\u0db0\u0dcf\u0dbb \u0db0\u0dcf\u0dbb \u0daf\u0dd3\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0. \u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dba\u0dd9\u0db1\u0dca \u0d9a\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba\u0dda \u0db1\u0dcf\u0dc0\u0d9a\u0dca\u0d9a\u0dcf\u0da9\u0dd4, \u0db1\u0dbb\u0d9a\u0dca\u0d9a\u0dbd\u0dd2, , \u0db1\u0dbb\u0d9a\u0dca\u0d9a\u0dbd\u0dd2, \u0db8\u0dcf\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dd2\u0dba, \u0db1\u0ddc\u0dbb\u0ddc\u0da0\u0dca\u0da0\u0ddd\u0dbd\u0dda \u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dca\u200d\u0dbb\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dc0\u0dbd \u0d9c\u0ddc\u0dc0\u0dd2 \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0dc0\u0dd2 \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0dad\u0dc0\u0db8 \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba\u0dba \u0d86\u0db0\u0dcf\u0dbb \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0. \u0d91\u0d9a \u0db4\u0ddc\u0dbd\u0dca \u0d9c\u0dc4\u0d9a\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 10,000\u0d9a\u0dca \u0daf\u0dd9\u0db1\u0dc0\u0dcf. \u0db4\u0ddc\u0dbd\u0dca \u0d9c\u0dc3\u0dca \u0dc0\u0dd0\u0da7\u0dd2\u0da0\u0dca\u0da0 \u0dad\u0dd0\u0db1\u0d9a\u0dca\u0dc0\u0dad\u0dca CDA \u0d91\u0d9a\u0dda \u0db8\u0dc4\u0dad\u0dca\u0dc0\u0dbb\u0dd4 \u0dad\u0dc0\u0db8 \u0db6\u0dbd\u0dbd\u0dcf \u0db1\u0dd0\u0dc4\u0dd0. \u200d\u0db8\u0db8 \u0db8\u0dda \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\u0db1\u0dd4\u0dad\u0dca \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba \u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dbb\u0dc0\u0db1\u0dc0\u0dcf. \u0d9a\u0dbb\u0dc0\u0db1\u0dc0\u0dcf.\n\n\u0b8e\u0ba9 \u0b85\u0bb5\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0b9a\u0bca\u0ba9\u0bcd\u0ba9\u0bbe\u0bb0\u0bcd. \u0b87\u0ba4\u0bc8\u0baf\u0bbf\u0b9f\u0bcd\u0b9f\u0bc1 \u0ba8\u0bbe\u0ba9\u0bcd \u0bbe\u0ba9\u0bcd \u0bb5\u0bc6\u0b9f\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bc7\u0ba9\u0bcd. \u0ba9\u0bcd. \u2018\u0b95\u0bb2\u0bbf\u0bae\u0bbe\u0bbe\u2019 \u0b9a\u0bca\u0ba9\u0bcd\u0ba9 \u0b92\u0bb0\u0bc1\u0bb5\u0bb0\u0bcd\u0ba9\u0bcd\u0ba9 \u0b92\u0bb0\u0bc1\u0bb5\u0bb0\u0bcd, \u0b87\u0ba8\u0bcd\u0ba4 \u0bb0\u0bae\u0bb4\u0bbe\u0ba9\u0bcd \u0bae\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b87\u0ba4\u0bc1 \u0baa\u0bb1\u0bcd\u0bb1\u0bbf \u0b95\u0ba4\u0bc8\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bbe\u0ba4\u0bc6\u0ba9\u0b95\u0bcd \u0ba9\u0b95\u0bcd \u0b95\u0bc2\u0bb1\u0bbf\u0baf\u0ba4\u0bc8 \u0ba8\u0bbe\u0ba9\u0bcd \u0bb5\u0ba9\u0bcd\u0bae\u0bc8\u0baf\u0bbe\u0b95\u0b95\u0bcd \u0b95\u0ba3\u0bcd\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bc7\u0ba9\u0bcd. \u0ba9\u0bcd."
  },
