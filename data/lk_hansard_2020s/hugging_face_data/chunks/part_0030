    "chunk_text": "\u0d92 \u0d85\u0dba\u0da7 \u0dad\u0db8\u0db1\u0dca\u0d9c\u0dda \u0dc0\u0dd3 \u0da7\u0dd2\u0d9a \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0 \u0db1\u0dda. . \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf \u0db4\u0dd2\u0da7 \u0dbb\u0da7\u0dd2\u0db1\u0dca \u0dc4\u0dcf\u0dbd\u0dca \u0d9c\u0dd9\u0db1\u0dcf\u0dc0\u0dcf\u200d, \u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0dd2\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0da7\u0ddc\u0db1\u0dca 150,000\u0d9a000\u0d9a\u0dca. Plan \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0, \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0da7. \"\u0db7\u0dd6\u0dad\u0dba\u0dcf\u0da7\" \u0d9c\u0dd9\u0dc0\u0db1\u0dc0\u0dcf, \u0d85\u0dbb\u0d9a\u0da7 \u0d85\u0dbb\u0d9a\u0da7 \u0d9c\u0dd9\u0dc0\u0db1\u0dc0\u0dcf, \u0db8\u0dda\u0d9a\u0da7 \u0d9c\u0dd9\u0dc0\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d92 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4 \u0dc0\u0dd0\u0dba \u0dc0\u0db1 \u0d9c\u0dab\u0db1\u0dca \u0dc0\u0dd0\u0dba \u0dc0\u0db1 \u0d9c\u0dab\u0db1\u0dca \u0da7\u0dd2\u0d9a \u0db8\u0da7 \u0d9a\u0dd2\u0dc0\u0dca\u0dc0\u0dcf. \u0d85\u0da9\u0dd4\u0db8 \u0d9c\u0dab\u0db1\u0dda \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 90\u0d9a\u0dca \u0dba\u0db1\u0dc0\u0dcf, \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0dda \u0dc0\u0dd3 \u0dc0\u0dd3 \u0d9a\u0dd2\u0dbd\u0ddd \u0d91\u0d9a\u0d9a\u0dca \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1. \u0dad\u0dd9\u0dad \u0dc0\u0dd3 \u0d9a\u0dd2\u0dbd\u0ddd\u0dc0\u0d9a\u0dca\u0dbd\u0ddd\u0dc0\u0d9a\u0dca \u0daf\u0dd9\u0db1\u0dca\u0db1 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 85\u0da7. \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 85\u0da7 \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf\u0db8, \u0d92 \u0da7\u0dd2\u0d9a \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0dcf \u0d9a\u0dd4\u0dab\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dad\u0dca \u0db6\u0dd0\u0dc4\u0dd0. \u0db8\u0ddc\u0d9a\u0daf, \u0d85\u0dbb \u0db4\u0ddc\u0da9\u0dd2 \u0dc4\u0dcf\u0dbd\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d92\u0d9c\u0ddc\u0dbd\u0dca\u0dbd\u0db1\u0dca \u0dbd\u0dca\u0dbd\u0db1\u0dca \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dca\u0db1\u0dda. \u0db6\u0dcf\u0dc3\u0dca\u0db8\u0dad\u0dd3 \u0dc3\u0dc4\u0dbd\u0dca \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0dad\u0db8\u0dba\u0dd2. \u0dd2.\n\n\u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0d92 \u0d9c\u0ddc\u0dc0\u0dd3\u0db1\u0dca\u0da7 \u0dc4\u0ddc\u0db3 \u0db8\u0dd2\u0dbd\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd3 \u0dc0\u0d9c\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db3 \u0db8\u0dd2\u0dbd\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd3 \u0dc0\u0d9c\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba \u0db6\u0dd3\u0da2 \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0db8 \u0d85\u0dbb \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0db6\u0dd3\u0da2 \u0dc0\u0dbb\u0dca\u0d9c \u0db8\u0ddc\u0d9a\u0dc0\u0dad\u0dca \u0d85\u0daf \u0d9a\u0dc0\u0dad\u0dca \u0d85\u0daf \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0daf \u0d91\u0d9a \u0db6\u0dd3\u0da2 \u0dc0\u0dbb\u0dca\u0d9c\u0dba\u0dba\u0dd2 \u0daf\u0dd9\u0d9a\u0dba\u0dd2 \u0d91\u0db1\u0dca\u0db1\u0dda. \u0d92\u0dc0\u0dcf \u0dc0\u0d9c\u0dcf \u0d9a\u0dc5\u0dcf\u0db8 \u0d85\u0da9\u0dd4 . \u0d92\u0dc0\u0dcf \u0dc0\u0d9c\u0dcf \u0d9a\u0dc5\u0dcf\u0db8 \u0d85\u0da9\u0dd4 \u0d9c\u0dab\u0db1\u0dda \u0d92\u0d9c\u0ddc\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 85\u0da7\u0dc0\u0dad\u0dca \u0d92 \u0dc0\u0dd3 \u0d9a\u0dd2\u0dbd\u0ddd\u0dc0\u0d9a\u0dca \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0dcf \u0d9a\u0dd4\u0dab\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dda, \u0d92\u0d9a \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0d9c\u0dda \u0d85\u0db4\u0dda\n\n\u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0daf\u0dd9\u0db1\u0dcf\u0d9c\u0dda\u0db8 \u0db4\u0dca\u200d\u0dbb\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba\u0d9a\u0dca. \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0dba\u0da7 \u0d86\u0dc0\u0dad\u0dca \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dad\u0dca \u0d92 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba\u0da7 \u0db8\u0dd4\u0dc4\u0dd4\u0dab \u0db1\u0dba\u0da7 \u0db8\u0dd4\u0dc4\u0dd4\u0dab \u0daf\u0dd9\u0db1\u0dca\u0db1 \u0d85\u0db4\u0da7 \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd9\u0db1\u0dc0\u0dcf. \u0d91\u0dad\u0d9a\u0ddc\u0da7 \u0d85\u0db4\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1, \u0d92 \u0d92 \u0db8\u0db1\u0dd4\u0dc3\u0dca\u0dc3\u0dba\u0dcf\u0dc0 \u0da2\u0dd3\u0dc0\u0dad\u0dca \u0d9a\u0dbb\u0dc0\u0dd3\u0db8\u0dba\u0dd2. \u0d92 \u0d85\u0dba\u0d9c\u0dd9\u0db1\u0dca \u0d85\u0db4\u0da7 \u0dbd\u0dcf\u0db7 \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db1\u0dca \u0d85\u0db4\u0da7 \u0dbd\u0dcf\u0db7 \u0dbd\u0db6\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dd0. \u0d91\u0dc4\u0dd9\u0db8 \u0db1\u0db8\u0dca, \u0d92 \u0d85\u0dba \u0da2\u0dd3\u0dc0\u0dad\u0dca \u0d9a\u0dbb\u0dc0\u0db1\u0dca\u0db1 \u0dc0\u0dd3 \u0d9a\u0dd2\u0dbd\u0ddd\u0dc0\u0d9a\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dbd\u0ddd\u0dc0\u0d9a\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 110\u0d9a\u0dca, 120\u0d9a\u0dca \u0dc0\u0dcf\u0d9c\u0dda \u0db8\u0dd2\u0dbd\u0d9a\u0dca \u0daf\u0dd9\u0db1 \u0d9a\u0dca\u200d\u0dbb\u200d\u0dbb\u0db8\u0dba\u0d9a\u0dca \u0dc4\u0daf\u0db1\u0dca\u0db1, \u0db4\u0dd2\u0da7\u0dbb\u0da7\u0dd2\u0db1\u0dca \u0dc4\u0dcf\u0dbd\u0dca \u0db4\u0dd2\u0da7\u0dbb\u0da7\u0dd2\u0db1\u0dca \u0dc4\u0dcf\u0dbd\u0dca \u0d9c\u0dd9\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db1\u0dda \u0db1\u0dd0\u0dad\u0dd4\u0dc0. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0da7 \u0dc0\u0dd4\u0dab\u0dda \u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0daf? \u0d9a\u0d9a\u0dca\u0daf? \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf \u0dc4\u0dcf\u0dbd\u0dca \u0d9c\u0dd9\u0db1\u0dca\u0dc0\u0db1 \u0d9a\u0dca\u200d\u0dbb\u200d\u0dbb\u0db8\u0dba \u0daf\u0db1\u0dca\u0db1\u0dda\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0db1\u0dda. \u0d85\u0dbb . \u0d85\u0dbb \u0db4\u0ddc\u0d9a\u0dd4\u0da7\u0dd4 \u0db8\u0dd1\u0db1\u0dca\u0d9a\u0dd4\u0da7\u0dd4 \u0db8\u0dd1\u0db1\u0dca"
  },
