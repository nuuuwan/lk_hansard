    "chunk_text": "\u0dc3\u0dd2\u0dba\u0dba\u0da7 5.4\u0d9a \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dba\u0dda \u0d89\u0dc4\u0dc5\u0dad\u0db8 \u0db0\u0db1 \u0dc1\u0dda\u0dc2\u0dba \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d9a\u0dc5\u0dcf. 2026 \u0d85\u0dba \u0dc2\u0dba \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d9a\u0dc5\u0dcf. 2026 \u0d85\u0dba \u0dc0\u0dd0\u0dba\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0dc0\u0dc3\u0dbb \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dba\u0dda\u0daf\u0dd3 \u0dbb\u0dd4. \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 360\u0d9a\u0dca \u0dbd\u0dd9\u0dc3 \u0d85\u0db4\u0dda\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0db0\u0db1 \u0db1 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dae\u0db8\u0dd2\u0d9a \u0dc1\u0dda\u0dc2\u0dba, \u0dc3\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc0\u0db1 \u0dc0\u0dd2\u0da7, \u0dbb\u0dd4. \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1,84844\u0d9a \u0db0\u0db1 \u0dc1\u0dda\u0dc2\u0dba\u0d9a\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d9a\u0dc5\u0dcf. \u0dc2\u0dba\u0d9a\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d9a\u0dc5\u0dcf. \u2022 2025 \u0dc0\u0dc3\u0dbb\u0dda\u0daf\u0dd3 \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0dc4\u0dd2\u0d9f\u0dba \u0dc3\u0dd2\u0dba\u0dba\u0da7 2.3\u0d9a\u0dca \u0dbd\u0dd9\u0dc3, \u0dc0\u0dc3\u0dbb 68\u0d9a\u0da7 \u0db4\u0dc3\u0dd4 \u0d85\u0da9\u0dd4\u0db8 \u0d85\u0da9\u0dd4\u0db8 \u0d85\u0d9c\u0dba \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d9a\u0dc5\u0dcf. \u2022 2025 \u0dc0\u0dc3\u0dbb\u0dda\u0daf\u0dd3 \u0da2\u0d82\u0d9c\u0db8 \u0d9c\u0dd2\u0dab\u0dd4\u0db8, \u0da9\u0ddc\u0dbd\u0dbb\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1,719\u0d9a \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dba\u0dda \u0d89\u0dc4\u0dc5\u0dad\u0db8 \u0d85\u0dad\u0dd2\u0dbb\u0dd2\u0d9a\u0dca\u0dad\u0dba\u0d9a\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0db4\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2 \u0dc0\u0dd4\u0dab\u0dcf. \u2022 2022 \u0dc0\u0dc3\u0dbb \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dba\u0dda\u0daf\u0dd3 \u0daf\u0dc5 \u0daf\u0dda\u0dc1\u0dd3\u0dba \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0dd2\u0dad\u0dba\u0dd9\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 114\u0d9a\u0dca \u0dc0\u0dd6 \u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 114\u0d9a\u0dca \u0dc0\u0dd6 \u0db8\u0db0\u0dca\u200d\u0dba\u0dba\u0db8 \u0dbb\u0da2\u0dba\u0dda \u0dab\u0dba \u0db4\u0dca\u200d\u0dbb \u0dab\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba, 2025 \u0dc0\u0dc3\u0dbb \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dba \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba \u0dab\u0dba \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab \u0daf\u0dd9\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d85\u0db1\u0db1\u0dca\u0dad\u0dd4 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d85\u0db1\u0dd4\u0dc0 \u0dc3\u0dd2\u0dba\u0dba\u0da7 95 \u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0 \u0dc3\u0dd2\u0dba\u0dba\u0da7 95 \u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d85\u0da9\u0dd4 \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2 \u0dc0\u0dd4\u0dab\u0dcf.\"\n\n\u0dc0\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf. \u0db8\u0dda\u0dc0\u0dcf \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1, \u0d9c\u0dbb\u0dd4 \u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dcf\u0dba\u0db1\u0dca\u0dc0\u0dbd \u0dc0\u0dd9\u0da0\u0dca\u0da0 \u0db4\u0dcf\u0da9\u0dd4 \u0d9a\u0ddc\u0dad\u0dbb\u0db8\u0dca\u0daf \u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0db8\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda \u0d89\u0db1\u0dca\u0db1 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0daf\u0dd9\u0db1\u0dcf\u0db8 \u0dc4\u0ddc\u0db3\u0dd2\u0db1\u0dca \u0db3\u0dd2\u0db1\u0dca \u0daf\u0db1\u0dca\u0db1\u0dcf \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca. \u0db1\u0db8\u0dd4\u0dad\u0dca, 2022\u0daf\u0dd3 \u0db4\u0dca\u200d\u0dbb 2022\u0daf\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dcf\u0dba\u0dba\u0db1\u0dca 52\u0d9a\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d9a\u0dc5 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 774.6\u0d9a \u0dc3\u0db8\u0dc3\u0dca\u0dad \u0db6\u0daf\u0dd4 \u0d86\u0daf\u0dcf\u0dba\u0db8\u0da7 \u0daf\u0dcf\u0dba\u0db8\u0da7 \u0db4\u0dd9\u0dbb \u0dc1\u0dd4\u0daf\u0dca\u0db0 \u0d85\u0dbd\u0dcf\u0db7\u0dba \u0d85\u0db4\u0dd2 2025\u0daf\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 444.4\u0d9a \u0dbd\u0dcf\u0db7\u0dba\u0d9a\u0dca \u0dd2\u0dba\u0db1 444.4\u0d9a \u0dbd\u0dcf\u0db7\u0dba\u0d9a\u0dca \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf, \u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0dc1\u0dd4\u0daf\u0dca\u0db0 \u0d85\u0dbd\u0dcf\u0db7\u0dba\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd6 \u0d92 \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dcf\u0dba\u0dba\u0db1\u0dca \u0d85\u0daf \u0dbd\u0dcf\u0db7 \u0dbd\u0db6\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db8\u0dda \u0dbb\u0da2\u0dba \u0dbb\u0da2\u0dba - \u0db8\u0dda \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0da9\u0dd4\u0dc0 - \u0dc3\u0db8\u0dad\u0dca \u0dc0\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf. \u0db1\u0dc0\u0dcf. \u0db8\u0dda\u0dc0\u0dcf \u0db1\u0ddc\u0dc0\u0dd9\u0dba\u0dd2\u0daf, \u0dbb\u0da7\u0d9a \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dca\u0dad\u0dda? \u0db8\u0dda\u0dc0\u0dcf \u0db1\u0ddc\u0dc0\u0dd9\u0dba\u0dd2\u0daf, \u0d85\u0db4\u0dd2 \u0d85\u0db4\u0dd2 \u0db4\u0ddc\u0dbb\u0ddc\u0db1\u0dca\u0daf\u0dd4 \u0dc0\u0dd9\u0da0\u0dca\u0da0 \u0daf\u0dda\u0dc0\u0dbd\u0dca? \u0dbb\u0da7\u0d9a \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba \u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbb \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0dbb\u0da7\u0dda \u0dad\u0dd2\u0db6\u0dd9\u0db1 \u0daf\u0dd6\u0dc2\u0dab\u0dba, \u0dc0\u0d82\u0da0\u0dcf\u0dc0 \u0db1\u0dd0\u0dad\u0dd2 \u0d9a\u0dbb\u0dbd\u0dcf \u0d91\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0da0\u0dcf\u0dc0 \u0db1\u0dd0\u0dad\u0dd2 \u0d9a\u0dbb\u0dbd\u0dcf \u0d91\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7 \u0dbb\u0da7\u0da7 \u0dbd\u0db6\u0dcf \u0daf\u0dd9\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0db1\u0ddc\u0dc0\u0dd9\u0dba\u0dd2\u0daf \u0d85\u0db4\u0dd2 \u0db4\u0ddc\u0dbb\u0ddc\u0db1\u0dca\u0daf\u0dd4 \u0dc0\u0dd4\u0dab\u0dda? ?"
  },
