    "chunk_text": "\u0da2\u0dd3\u0dd2\u0dc2\u0dad\u0dba \u0dc3\u0db8\u0dcf\u0da2\u0dba\u0dd3\u0dba, \u0db4\u0dcf\u0dbb\u0dd2\u0dc3\u0dbb\u0dd2\u0d9a \u0dc4\u0dcf \u0d86\u0da0\u0dcf\u0dbb\u0db0\u0dcf\u0dbb\u0dca\u0dbd\u0db8\u0dd3\u0dba \u0dc0\u0dc1\u0db8\u0dba\u0db1\u0dca\u0dad \u0dba\u0dc4\u0db4\u0dad\u0dca \u0daf\u0dd2\u0dc1\u0dcf\u0dc0\u0d9a\u0dba \u0db4\u0dbb\u0dd2\u0dc0\u0dbb\u0dca\u0dbd\u0dad \u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d82\u0dbb\u0db8\u0dd4\u0dab\u0dd4 \u0d9a\u0dbb\u0d9c\u0dad\u0dca Clean Sri Lanka \u0dc0\u0dd0\u0d9a\u0dc3\u0dba\u0dc4 \u0dd4\u0dd2\u0db6\u0db1\u0dca\u0dad \u0dc3\u0db8\u0dcf\u0da2\u0dba\u0dd3\u0dba \u0d82\u0d9a\u0dc1\u0dba \u0dba\u0dba\u0db8\u0dad\u0dca \u0da2\u0dd3\u0dc0 \u0d9c\u0dd4\u0dab\u0dcf\u0dad\u0dca\u0db8\u0d9a\u0db7\u0dcf\u0dcf\u0dc0\u0dba, \u0db8\u0d9c\u0dca\u0dbb\u0dc0\u0dba, \u0d86\u0dbb\u0d9a\u0dca\u0dba\u0dcf\u0dc0, \u0dc3\u0db8\u0dcf \u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1\u0dba, \u0dd2\u0dd4 \u0dad\u0dca\u0db7\u0dcf\u0dcf\u0dc0\u0dba, \u0dca\u200d\u0dbb\u0da2\u0dcf \u0dc3\u0dc4\u0db7\u0dcf\u0dcf\u0dd3\u0dad\u0dca\u0dc0\u0dba \u0dc4\u0dcf \u0dc3\u0db8\u0dcf\u0da2 \u0dc3\u0db8\u0d9c\u0dd2\u0dba \u0dc1\u0d9a\u0dca\u0dc0 \u0db8\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dad\u0dca \u0db4\u0dcf\u0dbb\u0dd2\u0dc3\u0dbb\u0dd2\u0d9a \u0d82\u0d9a\u0dc1\u0dba \u0dba\u0dba \u0db8\u0dad\u0dca \u0db4\u0dbb\u0dd2\u0dc3\u0dbb \u0d86\u0dbb\u0d9a\u0dca\u0dba\u0dcf\u0dc0, \u0dc3\u0d9a\u0dbb\u0d9a\u0dca\u0dba\u0dab\u0dba, stewardship, \u0dc0\u0da2\u0dc0 \u0dd2\u0dc2\u0dd2\u0dc2\u0db0\u0dcf\u0dad\u0dca\u0dc0\u0dba, \u0dc0\u0d9c\u0dd3\u0db4\u0db8\u0db8\u0db1\u0dca\u0dad \u0dc3\u0dda\u0db4\u0dad\u0dca \u0db7\u0dcf\u0dcf\u0dd2\u0dc2\u0dad\u0dba \u0dc4\u0dcf \u0dc0 \u0dbb\u0dc3\u0dbb\u0db7\u0dcf\u0dcf\u0dc0\u0dba \u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0dcf \u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dad\u0dca \u0d86\u0da0\u0dcf\u0dbb\u0db0\u0dcf\u0dbb\u0dca\u0dbd\u0db8\u0dd3\u0dba \u0d82\u0d9a\u0dc1\u0dba \u0dba\u0dba\u0db8\u0dad\u0dca \u0dc0\u0d9c\u0dd3\u0db4\u0db8, \u0d82\u0dc0\u0d9a\u0d9a\u0db7\u0dcf\u0dcf\u0dc0\u0dba, \u0dd2\u0dc2 \u0dba, \u0dc3\u0dcf\u0db0\u0dcf\u0dcf\u0dbb\u0dab\u0dad\u0dca\u0dc0\u0dba, \u0d9a\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0d9a\u0dca\u0dba\u0db8\u0dad\u0dcf\u0dc0 \u0dc4\u0dcf \u0db8\u0db4\u0dcf\u0daf\u0dd4 \u0dc3\u0dda\u0db4\u0dad\u0dca \u0dd2\u0dc5\u0dd2\u0db6\u0db6\u0db3 \u0dc0\u0d9c\u0dd3\u0db8 \u0dc1\u0d9a\u0dca\u0dc0 \u0db8\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dba\u0dd2. \u0db8\u0db8\u0db8 \u0dc0\u0dd0\u0d9a\u0dc3\u0dba\u0dc4\u0db1\u0dca\u0dad \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dba \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda \u0db8\u0dd2\u0dd2\u0dba ,222\u0d9a\u0dca \u0db8\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dbb \u0dc0 \u0db8\u0db6 \u0dc0\u0dcf.\n\n\u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad, \u0d82\u0dd2\u0dc5 \u0db8\u0dda \u0dc0\u0dc3\u0db8\u0dbb\u0dad\u0dca \u0d9a\u0dca\u0dbd\u0dd3\u0db1\u0dca\u0dad \u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0d9a\u0dcf \u0da2\u0dd4 \u0dc0\u0dd0\u0d9a\u0dc3\u0dba\u0dc4\u0db1\u0dca\u0dad \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda \u0db8\u0dd2\u0dd2\u0dba ,222\u0d9a\u0dca \u0db8\u0dc0\u0db1\u0dca\u0dad\u0d9a\u0dbb \u0dc0 \u0db8\u0db6 \u0dc0\u0dcf.\n\n\u2022 \u0dc4\u0dbb\u0dd2\u0dad \u0db8\u0dcf\u0dc0\u0dad, \u0d9a\u0dca\u0dbd\u0dd3\u0db1\u0dca\u0dad \u0d9a \u0dda\u0dd4\u0daf, \u0d9a\u0dca\u0dbd\u0dd3\u0db1\u0dca\u0dad \u0d82\u0dba\u0dd2 \u0db1\u0dca\u0dad \u0dc3\u0dc0, \u0d9a\u0dca\u0dbd\u0dd3\u0db1\u0dca\u0dad\n\n\u0db8\u0dda\u0d9a \u0dc0\u0dd0\u0dbb\u0d9c\u0dad\u0dca.\n\n\u2022 \"\u0dd2\u0dc5\u0dd2\u0dc2\u0dd4\u0dbb\u0dd4 \u0db4\u0dd4\u0dbb\u0dc0\u0dbb\" \u0da2\u0dcf\u0dc0 \u0d9a \u0d82\u0db4\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dba \u0d9a \u0db8 \u0dcf\u0d9a\u0dbb\u0dab \u0dc0\u0dd0\u0d9a\u0dc3\u0dba\u0dc4 \u0dba\u0dba\u0db8\u0dad\u0dca,-\n\n\u0d82\u0dd2\u0dc5 \u0db8\u0dda \u0d9a\u0dd0\u0dd2\u0db6 \u0d9a\u0dc3 \u0dca\u200d\u0dbb\u0dc1\u0dc0 \u0dba \u0dd2\u0dc5\u0dd2\u0db6\u0db6\u0db3 \u0d82\u0dc0\u0db0\u0dcf\u0dcf \u0dba \u0db8\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0dad \u0db1 \u0dd1.\n\n\u0dbb\u0dd0 \u0dba \u0dc3\u0dd2\u0dba\u0dba\u0dba 32\u0d9a \u0db8\u0dda\u0dba\u0db8\u0dba \u0dc0 \u0db8\u0db6 \u0d82\u0db4\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dba \u0d91\u0d9a\u0dca\u0dbb\u0dd0\u0dc3\u0dc0 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 2229 \u0dc0 \u0dd2\u0dc2\u0dba \u0dc3\u0dd2\u0dba\u0dba\u0dba 2\u0d9a\u0dca \u0dbb\u0d9a\u0dca\u0dc0\u0dcf \u0d89\u0dc4 \u0dd0\u0d9a\u0dd3\u0db8, \u0d86\u0dbb\u0d9a\u0dca\u0dd2\u0dad \u0d82\u0db4\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dba \u0d9a \u0db8 \u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0dcf \u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0db8\u0dc3\u0dca\u0d9b\u0dba \u0d86\u0dbb\u0d9a\u0dca\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0dc3\u0dbb\u0dba\u0d9a\u0dca \u0db8\u0d9c\u0dcf\u0d9a \u0dd0\u0d9f\u0dd3\u0db8 \u0d82\u0db8\u0dbb\u0d9a\u0dca\u0dba\u0dcf \u0d9a\u0dbb \u0dc0\u0dcf. \u0db8\u0db8\u0db8 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dc0 \u0dba Clean Sri Lanka \u0dd4\u0dd2\u0db6\u0db1\u0dca\u0dad \u0db8\u0dad\u0ddd\u0dbb\u0dcf\u0d9c\u0dad\u0dca \u0db4 \u0dcf\u0dad\u0dca \u0db4\u0dcf \u0d86\u0dba\u0dad 122\u0d9a\u0dca \u0dd4 \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dba \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda \u0db8\u0dd2\u0dd2\u0dba 5,222\u0d9a\u0dca \u0db8\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dba \u0db8\u0dba\u0ddd\u0da2 \u0dcf \u0d9a\u0dbb \u0dc0\u0dcf.\n\n\u2022 \u0db6 \u0dc1\u0d9a\u0dca\u0dc0 \u0d82\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d9a\u0dc1\u0db8\u0dda \u0dc3\u0dc4\u0db8\u0dba\u0ddd\u0d9c\u0dba \u0dd2\u0dc0 \u0dc0 \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a\n\n\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dba \u0db8\u0dba\u0ddd\u0da2\u0dd2\u0dad Clean Island \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dc0 \u0dba \u0db8\u0d9f\u0dd2\u0db1\u0dca\u0dad \u0db8\u0d9a\u0dda\u0dc6\u0dc0\u0dda, \u0dba\u0dd2 \u0dc0 \u0dda \u0dc3\u0dc4 \u0d82 \u0dc0 \u0dda \u0dba \u0daf\u0dd6\u0db4\u0dad\u0dca \u0d92\u0d9a\u0dcf\u0db6\u0dda\u0db0\u0dcf \u0dc3\u0d9a\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0dcf \u0dba \u0dc4\u0dcf \u0db4\u0dbb\u0dd2\u0dc0\u0dbb\u0dca\u0dbd\u0dad \u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d86\u0dbb\u0dbb\u0dca\u0dbd\u0dc1 \u0daf\u0dd6\u0db4\u0dad\u0dca \u0db8 \u0dc3 \u0dc3\u0d9a\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0dcf \u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dba \u0d82\u0db8\u0dbb\u0d9a\u0dca\u0dba\u0dcf \u0d9a\u0dbb \u0dc0\u0dcf.\n\n167 168\n\n2026 \u0db8 \u0dcf\u0dc0\u0dd0\u0dda\u0db6\u0dbb\u0dca\u0dbd 12\n\n\u0db8\u0dda \u0daf\u0dd6\u0db4\u0dad\u0dca \u0dd4 \u0d82\u0dd2\u0dc5 \"\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0db1\u0dca\u0dad \u0daf\u0dd6\u0db4\u0dad\u0dca \" \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0dba \u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0dcf \u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dad \u0d82\u0db8\u0dbb\u0d9a\u0dca\u0dba\u0dcf \u0d9a\u0dbb \u0dc0\u0dcf. \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd0 \u0dba\u0db8\u0dad\u0dca \u0d82\u0dd2\u0dc5 \u0dc1\u0d9a\u0dba\u0dad\u0dcf \u0d82\u0db0\u0dcf\u0dba\u0dba \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dc0 \u0db8\u0db6 \u0dc0\u0dcf. \u0db6 \u0dc1\u0d9a\u0dca\u0dc0 \u0dba \u0db4\u0dd4 \u0dbb\u0dca\u0dbd\u0da2 \u0db1\u0dd3\u0dba \u0db8 \u0dc3\u0dad\u0dca, \u0da2 \u0dad\u0dcf\u0dc0\u0db8\u0dda \u0d86\u0dc4\u0dcf\u0dbb \u0dc3\u0db4\u0dba\u0dcf \u0d9c\u0db1\u0dca\u0dad \u0dcf \u0d91\u0d9a\u0dad\u0dca \u0db4\u0dd4 \u0dbb\u0dca\u0dbd\u0da2 \u0db1\u0dd3\u0dba \u0db6 \u0dc1\u0d9a\u0dca\u0dc0 \u0db8\u0dba\u0db1\u0dca\u0dad\u0db8 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dba\u0dad\u0dca, \u0db8\u0dda \u0dd2\u0dc2\u0db0\u0dd2\u0dba\u0dba \u0db8\u0dd4\u0dc5\u0dd4\u0db8\u0db1\u0dd2\u0db1\u0dca\u0dad\u0db8 \u0d92\u0dc0\u0dcf green islands \u0dc4\u0dd0\u0da7\u0dd2\u0dba\u0dba \u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0dcf \u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda \u0d82\u0db8\u0dbb\u0d9a\u0dca\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0d82\u0dd2\u0dc5 \u0dc3\u0dd0 \u0dc3\u0dd4\u0dda \u0dc3\u0d9a\u0dc3\u0dc0 \u0d9a\u0dbb \u0dc0 \u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad.\n\n34. \u0dad\u0dcf\u0d9c\u0dba \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db1\u0dba \u0dc4\u0dc3\u0dcf \u0db8\u0dc4\u0dc3\u0d9c\u0db1 \u0db8\u0dca\u0db4\u0dc0\u0dcf\n\n\u2022 \u0db4 \u0dcf\u0dad\u0dca \u0db4\u0dcf \u0d86\u0dba\u0dad \u0dc0 \u0d86\u0dbb\u0dcf\u0dba\u0dda \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dbb \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0"
