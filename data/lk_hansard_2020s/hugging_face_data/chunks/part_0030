    "chunk_text": "2026 \u0dc0\u0dc3\u0db8\u0dbb\u0dca\u0dbd \u0db8\u0dbb\u0dc0\u0dd0\u0db1\u0dd2 \u0d82\u0daf\u0dd2\u0dba\u0db8\u0dbb\u0dca\u0dbd\u0daf\u0dd2 \u0db8\u0db8\u0d9c\u0dcf\u0db8\u0dc0\u0dcf\u0dda 252\u0d9a\u0dba \u0d9a\u0dc3\u0dd4 \u0d9a\u0dd0\u0db3\u0dd3\u0db8\u0dda\u0daf\u0dd3 \u0dd0\u0dd4\u0daf\u0dab\u0dd4 \u0d9a\u0dc3\u0dd4\u0dc0 \u0db8\u0dc3\u0d9a\u0dba \u0db8\u0db8\u0d9c\u0dcf\u0db8\u0dc0\u0dcf\u0dda \u0d91\u0d9a\u0d9a\u0dba \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda \u0db8\u0dd2\u0dd2\u0dba 1.828\u0d9a\u0dca \u0dbb\u0d9a\u0dca\u0dc0\u0dcf \u0d82\u0da9\u0dd4 \u0dd3 \u0dc0 \u0dd4\u0daf\u0dab\u0dcf. \u0db8\u0dda\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0dad\u0dbb\u0d9c\u0d9a\u0dcf\u0dbb\u0dd2\u0dad\u0dca\u0dc0\u0db8\u0dda \u0dca\u200d\u0dbb\u0dc0 \u0db5 . \u0d82\u0dd2\u0dc5 \u0db8\u0dad\u0ddd\u0dbb\u0dcf\u0db8\u0d9c \u0db6\u0dd0\u0dba\u0dbb\u0dd2 \u0daf\u0dd4\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0dd0\u0dc4\u0dd0. \u0db8\u0dba\u0db1\u0dca\u0dad\u0d9a\u0dbb\u0dba\u0dba \u0d91\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0dc3\u0db8\u0dcf\u0d9c\u0dda \u0db8\u0dba\u0db1\u0dca\u0dad\u0d9a\u0dbb\u0dba\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dc0\u0dd4\u0dab\u0dcf. \u0d86\u0dbb\u0dda\u0db7\u0dcf\u0db8\u0dda \u0daf\u0dd3 \u0d86\u0dc3\u0db1\u0dca\u0dad \u0dc0\u0dc1\u0db8\u0dba\u0db1\u0dca\u0dad \u0db8\u0dd2\u0dd2\u0dba 2\u0dba \u0dc0 \u0dd4\u0daf\u0dab\u0dcf. \u0db8\u0dbb\u0db8\u0dc0\u0db1\u0dd2 \u0db8\u0dba\u0db1\u0dca\u0dad\u0d9a\u0dbb\u0dba \u0db8\u0dd2\u0dd2\u0dba 1.8\u0dba \u0d82\u0da9\u0dd4 \u0dc0\u0dd4\u0dab\u0dcf. \u0dc0\u0dcf\u0dc3\u0dd2\u0dba. \u0d82\u0dd2\u0dc5 \u0d91 \u0db8\u0d9a\u0dcf\u0dba \u0db8\u0db1\u0dca\u0dad \u0dcf\u0dbb\u0db8\u0dda \u0dd2\u0dc2\u0daf\u0dd4\u0dd2\u0db6 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dc0 \u0dba\u0d9a\u0dca \u0daf\u0dd3 \u0dcf \u0dc0 \u0dd4\u0daf\u0dab\u0dcf, \u0d92\u0d9a\u0d9a\u0dba\u0d9a\u0dca \u0db8\u0d9a\u0dcf \u0dbb\u0dca\u0dbd \u0dc1\u0dad \u0d82\u0dba\u0dba\u0dd2 \u0dbb\u0dc1\u0db8 \u0db8\u0dbb\u0d9a\u0dba\u0dd2 \u0db8\u0dbb\u0d9a\u0dba. \u0db8\u0d9a\u0dcf \u0dbb\u0dca\u0dbd \u0dc1\u0dad \u0d82\u0dba\u0dba\u0dd2 \u0dbb\u0dc1\u0db8 \u0db8\u0dbb\u0d9a\u0d9a\u0dca.\n\n\u0d92 \u0d82\u0db1\u0dd4\u0dc0 \u0dad\u0dbb\u0d9c\u0d9a\u0dcf\u0dbb\u0dd3 \u0d9a\u0dc3\u0dd4 \u0d9a\u0dd0\u0db3\u0dd3\u0db8 \u0dd4\u0dd2\u0db6\u0db1\u0dca\u0dad \u0db8\u0db8\u0db8 \u0dc0\u0dc3\u0db8\u0dbb\u0dca\u0dbd\u0daf\u0dd3\u0db8 \u0db8\u0dd2 \u0dc3\u0dd2\u0dba\u0dba\u0dba 11\u0d9a\u0dd2\u0db1\u0dca\u0dad \u0db4\u0db8\u0dab \u0d82\u0da9\u0dd4 \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dba \u0dc4\u0dd0\u0d9a\u0dd2 \u0dd3 \u0dc0 \u0db8\u0db6 \u0dc0\u0dcf.\n\n\u2022 \u0db4\u0dd4 \u0dbb\u0dca\u0dbd\u0da2 \u0db1\u0dd3\u0dba \u0db6 \u0dc1\u0d9a\u0dca\u0dc0 \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dbb \u0dba \u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0dcf \u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8,\n\n\u0db6 \u0dc1\u0d9a\u0dca\u0dc0 \u0dc3\u0dd4\u0dbb\u0d9a\u0dca\u0dd2\u0dad\u0dad\u0dcf\u0dc0 \u0d89\u0dc4 \u0dd0\u0d9a\u0dd3\u0db8 \u0dc3\u0dc4 \u0da2\u0dcf\u0dc0 \u0d9a \u0dd2\u0dc2\u0daf\u0dd4\u0dd2\u0db6 \u0db4\u0dda\u0db0\u0dcf\u0dc0 \u0db8\u0dda \u0d82\u0dc3\u0db8\u0dd4\u0dd2\u0dad\u0dad\u0dcf \u0d82\u0dc0\u0db8 \u0d9a\u0dbb \u0dc3\u0dc0\u0dae\u0dcf\u0dc0\u0dbb\u0dad\u0dca\u0dc0\u0dba \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda \u0d82\u0dbb\u0db8\u0dd4\u0dab\u0dd2\u0db1\u0dca\u0dad, Net Plus \u0dca\u200d\u0dbb\u0db8\u0db8\u0dda\u0dbb\u0dba \u0dba\u0dba\u0db8\u0dad\u0dca \u0db6\u0dd0\u0dba\u0dbb\u0dd2 \u0d9c\u0db6\u0d9a\u0dcf \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dda \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dc4 \u0db8\u0dad \u0daf\u0dcf\u0dbb\u0dca\u0dbd\u0dba \u0dd2\u0dc2\u0daf\u0dd4\u0dd2\u0db6 \u0db4\u0dda\u0db0\u0dcf\u0dc0 \u0dc3\u0dc0\u0dae\u0dcf\u0db4 \u0dba \u0d9a\u0dbb \u0d9c\u0dd8\u0dc4\u0dc3\u0dc0\u0dae \u0db4\u0dcf\u0dbb\u0dd2\u0db8\u0db7\u0dcf\u0ddd\u0d9c\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0dad\u0dba, \u0db6 \u0dc1\u0d9a\u0dca\u0dc0 \u0d9c\u0db6\u0d9a\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d82\u0dc0\u0dc1\u0dba \u0db6\u0dd0\u0dba\u0dbb\u0dd2 \u0db8\u0dd2 \u0daf\u0dd3 \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0db8\u0dc0\u0db1\u0dd4\u0db8\u0dc0\u0db1\u0dca\u0dad \u0dc3\u0dc4 \u0dcf\u0db0\u0dcf\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0db6\u0dcf \u0daf\u0dd3\u0db8\u0dba \u0db8\u0dba\u0ddd\u0da2 \u0dcf \u0d9a\u0dbb \u0dc0\u0dcf. \u0d9c\u0dd8\u0dc4\u0dc3\u0dc0\u0dae \u0db4\u0dcf\u0dbb\u0dd2\u0db8\u0db7\u0dcf\u0ddd\u0d9c\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0dad\u0dba \u0d82\u0dd2\u0dc5 \u0dc3\u0dc4 \u0dcf\u0db0\u0dcf\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0db6\u0dcf \u0db8\u0dbb \u0dc0\u0dcf, \u0db6\u0dd0\u0dba\u0dbb\u0dd2\u0dba \u0dc3\u0dd2\u0dc2 \u0d9a\u0dbb \u0dc0\u0dcf \u0dda.\n\n\u2022 \u0dc0\u0dc4 \u0db8\u0dad \u0daf\u0dcf\u0dbb\u0dca\u0dbd\u0dba \u0dd2\u0dc2\u0daf\u0dd4\u0dd2\u0db6 \u0db4\u0dda\u0db0\u0dcf\u0dc0 \u0dba \u0d82\u0dbd\u0dd4\u0dc0 \u0db1\u0dca\u0dad \u0dc3\u0dc0\u0dae\u0dcf\u0db4 \u0dba \u0d9a\u0dbb\n\n\u0d9c\u0dd8\u0dc4\u0dc3\u0dc0\u0dae \u0db4\u0dcf\u0dbb\u0dd2\u0db8\u0db7\u0dcf\u0ddd\u0d9c\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0dad\u0dba \u0db6\u0dd0\u0dba\u0dbb\u0dd2 \u0d9c\u0db6\u0d9a\u0dcf \u0db0\u0dcf\u0dcf\u0dbb\u0dd2\u0dad\u0dcf\u0dc0 \u0d9a\u0dd2\u0db8 \u0ddd\u0db8\u0dc0\u0dcf\u0dda \u0d91\u0d9a\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda 25,000\u0d9a \u0dc3\u0dc4 \u0dcf\u0db0\u0dcf\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0db6\u0dcf \u0db8\u0dbb \u0dc0\u0dcf. \u0db8\u0db8\u0db8 \u0dc3\u0dc4 \u0dcf\u0db0\u0dcf\u0dcf\u0dbb\u0dba \u0d9a\u0dd2\u0db8 \u0ddd\u0db8\u0dc0\u0dcf\u0dda 12\u0d9a\u0dca \u0dbb\u0d9a\u0dca\u0dc0\u0dcf \u0d8b\u0db4\u0dbb\u0dd2\u0db8 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda 252,000\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0db6\u0dcf \u0daf\u0dd3\u0db8\u0dba \u0db8\u0dba\u0ddd\u0da2 \u0dcf \u0d9a\u0dbb \u0dc0\u0dcf.\n\n\u0db8\u0dda \u0db8\u0dc0\u0db1\u0dd4\u0db8\u0dc0\u0db1\u0dca\u0dad \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda \u0db8\u0dd2\u0dd2\u0dba 3,522\u0d9a\u0dca \u0db6\u0dcf \u0daf\u0dd3\u0db8\u0dba \u0db8\u0dba\u0ddd\u0da2 \u0dcf \u0d9a\u0dbb \u0dc0\u0dcf. \u0daf\u0dcf\u0dbb\u0dca\u0dbd\u0dba \u0db6 \u0dc1\u0d9a\u0dca\u0dc0 \u0dba \u0d9c\u0db6\u0d9a\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dba \u0db8\u0dba\u0dcf\u0dbb\u0dcf \u0d9c\u0dd0\u0db8 \u0db6\u0dd0\u0dba\u0dbb\u0dd2 \u0dc3\u0db3\u0dc4\u0dcf \u0d86 \u0dba \u0db8\u0dda \u0daf\u0dd3 \u0d82\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0db6 \u0dc0\u0dbb\u0dcf\u0dba \u0dc4\u0dcf \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0db8\u0dad\u0dcf\u0dd4\u0db8\u0db4 \u0dc3\u0d9a\u0dc0\u0dbb\u0dca\u0dbd\u0db0\u0dcf \u0db6\u0dda\u0dbb - PAL - \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dba \u0dbb \u0db8\u0dba\u0ddd\u0da2 \u0dcf \u0d9a\u0dbb \u0dc0\u0dcf. \u0dc0\u0dbb\u0dcf\u0dba \u0dc4\u0dcf \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0db8\u0dad\u0dcf\u0dd4\u0db8\u0db4 \u0db8\u0dc3\u0dc0\u0dc0\u0dcf \u0db6\u0dda\u0dbb \u0dc0 \u0db8\u0db6 \u0dc0\u0dcf, \u0dc3\u0dd2\u0dba\u0dba\u0dba 12\u0d9a\u0dca. \u0db6\u0dd0\u0dba\u0dbb\u0dd2\u0dc0 \u0dba \u0dc0 \u0db8\u0db6 \u0d92 \u0db6\u0dda\u0dbb \u0d82\u0dd2\u0dc5 \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dbb \u0dc0\u0dcf. \u0d9a\u0dd2\u0db8 \u0ddd\u0db8\u0dc0\u0dcf\u0dda \u0d91\u0d9a\u0d9a \u0db6\u0dd0\u0dba\u0dbb\u0dd2\u0dba\u0d9a \u0d86\u0dc3\u0db1\u0dca\u0dad \u0dc0\u0dc1\u0db8\u0dba\u0db1\u0dca\u0dad \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda 4,222\u0dad\u0dca-5222\u0dad\u0dca \u0d82\u0dad\u0dbb \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a \u0db6\u0dda\u0dbb\u0d9a\u0dca \u0dc0 \u0db8\u0db6 \u0dc0\u0dcf. \u0d82\u0dd2\u0dc5 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda 25,222\u0d9a \u0dc3\u0dc4 \u0dcf\u0db0\u0dcf\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0db8\u0dbb \u0dc0\u0dcf. \u0db6\u0dda\u0db8\u0dbb\u0db1\u0dca\u0dad \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda 4,222\u0d9a, \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda 5,222\u0d9a \u0dcf\u0db7\u0dcf\u0dba\u0d9a\u0dca \u0dd0\u0db8\u0db6 \u0dc0\u0dcf. \u0d9a\u0dd2\u0db8 \u0ddd\u0db8\u0dc0\u0dcf\u0dda \u0d91\u0d9a\u0d9a \u0db6\u0dd0\u0dba\u0dbb\u0dd2\u0dba\u0d9a\u0dca \u0dc3\u0dc0\u0dae\u0dcf\u0dd2\u0dc5\u0dad \u0d9a\u0dbb \u0d82\u0dba\u0dba \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda 32,222\u0d9a\u0dca \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda 25,222\u0d9a\u0dca \u0dc3\u0dc4 \u0dcf\u0db0\u0dcf\u0dcf\u0dbb \u0db8 \u0dc3\u0dad\u0dca, \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda 4,222\u0dad\u0dca-5,222\u0dad\u0dca \u0d82\u0dad\u0dbb \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0db6\u0dda\u0db8\u0dbb\u0db1\u0dca\u0dad \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db8\u0db1\u0dd4\u0dad\u0dca \u0dc3\u0dc4 \u0dba\u0d9a\u0dca \u0dd0\u0db8\u0db6 \u0dc0\u0dcf. \u0d82\u0dd2\u0dc5 \u0d82\u0db8\u0dbb\u0d9a\u0dca\u0dba\u0dcf \u0d9a\u0dbb \u0dc0\u0dcf, \u0db6 \u0d82\u0dc0\u0dd4\u0dbb\u0dd4\u0dda\u0db8\u0dda \u0db6\u0dd0\u0dba\u0dbb\u0dd2\u0dc0 \u0dba \u0dba\u0db1\u0dca\u0dad \u0db1 \u0dd1 \u0d9a\u0dd2\u0dba \u0dcf. \u0d91\u0db8\u0dc4\u0db8 \u0dba\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0dd0\u0dad\u0dca \u0dda \u0db8\u0dda\u0d9a \u0db4\u0dbb\u0dd2\u0dc0\u0dbb\u0dca\u0dbd\u0dad \u0dba \u0d9a\u0dbb\u0d9c\u0db1\u0dca\u0dad \u0db6\u0dd0\u0dc4\u0dd0."
