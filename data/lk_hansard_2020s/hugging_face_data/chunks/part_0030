    "chunk_text": "\u0dc0\u0dd4\u0dba\u0ddc\u0db8 \u0d91\u0dd9\u0ddc \u0dab\u0dbd \u0dad\u0dd3\u0dab\u0dba \u0d9a\u0dab \u0ddc \u0dd2 \u0d9a\u0db6\u0db1\u0dbd\u0ddc \u0db1\u0dca \u0da7 60\u0d9a\u0dca \u0d85\u0dc0\u0db1 \u0db1 \u0d9a\u0dab\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1 \u0db1\u0dca \u0da7 40\u0d9a\u0dca \u0d9a\u0dc1\u0dba \u0d9a\u0dbd\u0d9a\u0dc5\u0db3 \u0d9a\u0dc0\u0ddc\u0dc5\u0da7 \u0db1\u0dd2\u0d9a\u0dd4\u0dca \u0d9a\u0dab\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0db1\u0dca\u0dad. \u0d92 \u0db1\u0dca \u0da7 60 \u0d85\u0dc0\u0db1 \u0db1 \u0d9a\u0dbd\u0d9a\u0dc5\u0db3 \u0d9a\u0dc0\u0ddc\u0dc5\u0da7 \u0db1\u0dd2\u0d9a\u0dd4\u0dca \u0d9a\u0dab\u0db1\u0dbd\u0ddc \u0db1\u0dda \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 BOI facility \u0db6\u0ddc \u0d9a\u0dd9\u0db1\u0dca\u0dad\u0d9a\u0db1\u0dca\u0dad \u0d9a\u0dd2 \u0ddc. 2010 \u0d89\u0db3 \u0ddc \u0d9a\u0dda \u0ddc\u0dca\u0dc0\u0dc3\u0dc0 \u0dc3\u0db8\u0ddc\u0d9c\u0db8 - \u0dbd\u0dd1\u0d9c\u0db4\u0dd2\u0da7\u0dd2 \u0dc3\u0db8\u0ddc\u0d9c\u0db8 - BOI facility \u0dc0\u0ddc\u0dc3\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0dab \u0ddc \u0dd2 \u0d9a\u0db6\u0db1\u0dbd\u0ddc. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d92 \u0d9a\u0dd2 \u0db4\u0dd4 \u0dc3\u0dd2\u0db0\u0dd2 \u0da7 \u0dc3\u0dd0\u0dc0\u0dba\u0dd4\u0db8 \u0d9a\u0dab \u0ddc \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0d9a\u0ddc \u0d9a\u0da9 \u0dc3\u0dd2\u0dc0\u0d9a\u0dca\u0dc2\u0d9a\u0da9 \u0d9a\u0dda \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4\u0dca \u0db6\u0dd4\u0daf\u0dd2 \u0ddc\u0d9a\u0d9c\u0db1 \u0d89\u0db3 \u0ddc \u0dd2 \u0d9a\u0db6\u0db1\u0dbd\u0ddc. \u0d92 \u0d9a\u0dc1\u0dc0\u0dc0\u0ddc \u0db1 \u0d9c\u0db1\u0dd4\u0d9a\u0dd9\u0db1\u0dd4\u0dca \u0d85\u0db4\u0dd2 \u0dd9\u0db1\u0dca\u0dad\u0db1\u0dbd\u0ddc. \u0d9c\u0dbb\u0dd4 \u0dc4\u0d9a\u0dd3\u0dda \u0db8\u0dd0\u0dd2 \u0dad\u0db8\u0db1\u0dd2 BOI \u0dc0\u0dc4\u0dc3\u0dd4\u0d9a\u0db8 \u0d9c\u0dca\u0dad\u0dca\u200d\u0dca \u0d85\u0dc0\u0db1 \u0db1 \u0d9a\u0dbd\u0d9a\u0dc5\u0db3 \u0d9a\u0dc0\u0ddc\u0dc5\u0da7 \u0d9c\u0dd1\u0dc3\u0dc0 \u0dc3\u0dc0 \u0ddc \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0d9a\u0d9c\u0ddc\u0dbd\u0dca \u0db1\u0dca\u0dad \u0d9a\u0dc1\u0dba \u0d9a\u0dbd\u0d9a\u0dc5\u0db3 \u0d9a\u0dc0\u0ddc\u0dc5\u0da7 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0daf\u0dd3 \u0ddc \u0dd2 \u0d9a\u0db6\u0db1\u0dca\u0dad\u0d9a\u0db1\u0dca\u0dad. \u0d95\u0d9a \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0dc3\u0dca\u0dad\u0dca\u200d \u0d9a\u0dae\u0ddc\u0dbd. \u0d92 \u0db1\u0dd2\u0dc3\u0ddc \u0dab\u0dbd \u0dc4\u0dd0\u0da7\u0dd2 \u0da7 \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0dc0\u0dca\u0dbd\u0ddc \u0d94 \u0d9a\u0d9c\u0ddc\u0dbd\u0dca \u0db1\u0dca\u0dad BOI facility \u0d91\u0d9a \u0db6\u0ddc \u0d9c\u0db1\u0dca\u0dad\u0db1\u0dbd\u0ddc \u0db1\u0dda BOI \u0d9a\u0d9a\u0ddc\u0db1\u0dca\u0dad\u0d9a\u0dc1\u0db1\u0dca\u0dbd \u0da7 \u0d85\u0db1\u0dd4\u0dbd \u0d9a\u0da7\u0dba\u0dd4\u0dad \u0d9a\u0dab\u0db1\u0dca\u0dad\u0db1. \u0d91\u0d9a\u0dc4\u0db8 \u0db1\u0dd0\u0dca\u0db1\u0dda BOI \u0d91\u0d9a\u0d9a\u0db1\u0dca\u0dad \u0d89\u0dbd\u0dca \u0d9a\u0dbd \u0ddc \u0dc3\u0dda\u0dd6\u0dbb\u0dca\u0dbd\u0dba \u0dc3\u0dd0\u0dc0\u0dba\u0dd4\u0db8 domestic market \u0d91\u0d9a\u0da7 \u0db6\u0ddc \u0d9a\u0dd9\u0db1\u0dca\u0dad\u0db1. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d92 \u0dc3\u0dd2\u0db0\u0dd2 \u0da7 \u0db6\u0daf\u0dd4 \u0d9a\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2 \u0ddc.\n\n\u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0ddc\u0db1\u0ddc \u0d9a\u0dad\u0db8\u0db1\u0dd2 \u0dd9\u0dd0\u0db1\u0dca\u0dad \u0db8\u0db8 \u0d85 \u0dbd\u0dd0 \u0d9a\u0dae\u0ddc\u0dbd\u0da7 \u0d91\u0db1\u0dca\u0dad\u0db1\u0dda. \u0d9c\u0dbb\u0dd4 \u0dbd\u0db1\u0ddc\u0db0\u0dd2\u0dc0\u0dd2 \u0dad\u0db8\u0ddc \u0db8\u0dd4\u0dd9\u0dbd\u0dca \u0d85\u0db8\u0ddc\u0dad\u0dca\u200d\u0dba\u0dbd\u0dab \u0ddc \u0dc4\u0dd0\u0da7\u0dd2 \u0da7 2027 \u0dbd\u0dbb\u0dca\u0dbd\u0dc2 \u0dc3\u0db3\u0dc4\u0ddc \u0dc0\u0dd6 \u0d85 \u0dbd\u0dd0 \u0dbd\u0ddc\u0dbb\u0dca\u0dbd\u0dad\u0dca\u200d\u0ddc\u0dbd \u0dd2\u0d9b\u0dd2\u0dad\u0dca\u200d \u0dbd\u0da0\u0db1 06 000\u0d9a\u0dca \u0dc3\u0dc4 \u0d91\u0dad\u0db8\u0ddc \u0dad\u0dca\u200d\u0dbd \u0d91\u0d9a\u0dad \u0d9a\u0dab\u0db4\u0dd4 \u0dbd\u0da0\u0db1 \u0d91\u0d9a\u0dca\u0d9a \u0d9c\u0dca\u0d9a\u0dad\u0dca\u200d\u0ddc\u0dca \u0dbd\u0da0\u0db1 \u0d9a\u0dca\u0dc2 \u0d9a\u0da7 \u0dbd\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2 \u0db8\u0dd2\u0dc3\u0db8\u0db1\u0dca\u0dad \u0dc0\u0dd0 5\u0d9a\u0dca \u0dd2 \u0dc3\u0dc0\u0d9a\u0dc3\u0dc0 \u0d9a\u0db8\u0dad\u0dca\u200d\u0dd0\u0db1 \u0d89\u0dad\u0dca\u200d\u0ddc \u0d9a\u0dc4\u0ddc\u0db3\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2 \u0d9a\u0dc5\u0ddc. \u0d91 \u0d9a\u0dda \u0dab\u0d9a\u0dca \u0dc3\u0ddc\u0db8\u0ddc\u0db1\u0dba \u0dbd\u0db1\u0dad\u0dca\u200d\u0ddc\u0dbd\u0da7 \u0d9a\u0dca\u0d9a\u0dab\u0db1\u0dbd\u0ddc. \u0d91\u0dad\u0db8\u0ddc \u0d89\u0dad\u0dca\u200d\u0ddc\u0db8 \u0d9a\u0dc4\u0ddc\u0db3\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2 \u0d9a\u0dc5\u0ddc. \u0dc3\u0dca\u0dad\u0dca\u200d\u0da7\u0db8 \u0d85 \u0dbd\u0dd0 \u0d9a\u0dae\u0ddc\u0dbd \u0db1\u0dca\u0dc4\u0dd2 \u0db6\u0dd4\u0dc1\u0db0\u0dd2\u0d9a \u0db1\u0dca\u0dad \u0dc3\u0dc4\u0dd4\u0dbd\u0ddc \u0db1\u0dda \u0d9a\u0db8\u0dad\u0db8\u0db1\u0dca\u0dad \u0ddc\u0da7 \u0dbd\u0dd0\u0da7\u0d9a\u0dc4\u0db1\u0dbd\u0ddc. \u0db4\u0dca\u200d\u0dbb\u0dc0\u0db1 \u0d9a\u0db8\u0dad\u0db8\u0db1\u0dca\u0dad \u0ddc\u0da7 \u0d9a\u0dca\u0d9a\u0dab\u0db1\u0dca\u0dad\u0d9a\u0db1\u0dca\u0dad \u0db1\u0dd0\u0dc4\u0dd0. \u0d9a\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0dd9 \u0d9a\u0dc4\u0dc0\u0dad\u0dbd? \u0d9a\u0db6\u0ddc\u0dbb\u0dd4\u0dbd\u0da7 \u0db6\u0dd4\u0daf\u0dd2 \u0d9c\u0dca\u0dad\u0dca\u200d \u0db1\u0dd2\u0dc3\u0ddc. \u0d92\u0d9a\u0dba\u0dd2 \u0dc3\u0dca\u0dad\u0dca\u200d \u0d9a\u0dae\u0ddc\u0dbd. \u0d91\u0dad\u0db8\u0ddc \u0dd2\u0d9b\u0dd2\u0dad\u0dca\u200d \u0dcf\u0ddc\u0dc2\u0ddc\u0d9a\u0dbd\u0db1\u0dd4\u0dca \u0d9a\u0dd2\u0dc0\u0dca\u0dbd\u0ddc. \u0dbd\u0dd0\u0da9\u0dd2\u0daf\u0dd4\u0dab \u0dc0\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dd4\u0dca \u0d9a\u0dc5\u0ddc.\n\n\u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0ddc\u0db1\u0ddc \u0d9a\u0dad\u0db8\u0db1\u0dd2 \u0d9a\u0db8\u0dc4\u0dd2\u0daf\u0dd3 \u0db8\u0db8 \u0d9a\u0ddc\u0dab\u0dba \u0d9a\u0dca \u0db8\u0dad\u0dca\u200d\u0d9a\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dba\u0dd2. \u0d91 \u0da7 \u0db8\u0db8 \u0dc3\u0dad\u0dc5\u0dd4\u0dbd \u0d9c\u0dbb\u0dd4 \u0d9a\u0dd0\u0db6\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0dd2 \u0dbd\u0dbb\u0dd4 \u0dc4\u0dd0\u0d9a\u0db8\u0ddd\u0db8 \u0dc3\u0ddc\u0d9a\u0dca\u0dd2 \u0dd9\u0dab\u0db1\u0dbd\u0ddc. \u0d91 \u0da7 \u0db8\u0db8 \u0d9c\u0dbb\u0dd4 \u0dbd\u0db1\u0ddc\u0db0\u0dd2\u0dc0\u0dd2 \u0dad\u0db8\u0ddc\u0da7 \u0dc3\u0dc0\u0dad\u0dd2 \u0dbd\u0db1\u0dca\u0dad\u0dad\u0dca\u200d \u0dbd\u0db1\u0dbd\u0ddc. \u0d92 \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d91\u0dad\u0db8\u0ddc \u0d91\u0d9a \u0dbd\u0da0\u0db1 \u0d9a\u0dca \u0dc0\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2 \u0d9a\u0dab \u0d9c\u0db1\u0dca\u0dad\u0db1 \u0d85\u0db4\u0dd2\u0da7 \u0dc0\u0dd0 \u0d9c\u0dba\u0db1\u0dca\u0dad \u0d9a\u0dae\u0ddc \u0d9a\u0dab \u0ddc \u0dd2 \u0d9a\u0db6\u0db1\u0dbd\u0ddc. \u0dc3\u0db8\u0dc4\u0dab \u0d85\u0dbd\u0dc3\u0dc0\u0dae\u0ddc\u0dbd \u0db8\u0db0\u0dad\u0dba\u0db8 \u0dab\u0ddc\u0dad\u0dca\u200d\u0dbb\u0dd3 12.30\u0da7\u0dca \u0d9a\u0dae\u0ddc \u0d9a\u0dab \u0ddc \u0dd2 \u0d9a\u0db6\u0db1\u0dbd\u0ddc. \u0d9a\u0dd4\u0dbb\u0dd4\u0db1\u0dca\u0dad\u0da0\u0dd2 \u0dc0\u0dd4 \u0dbd\u0dd4\u0dab\u0dd4 \u0d9a\u0dbd\u0dca\u0dbd\u0ddc\u0d9a\u0da9 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0db1 \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0ddc \u0d9a\u0dab\u0db1\u0dca\u0dad\u0db1 \u0d91\u0db8 \u0dbd\u0dd4\u0dab\u0dd4 \u0d9a\u0dbd\u0dca\u0dbd\u0ddc\u0d9a\u0da9 \u0dc3\u0dd2\u0d82\u0dba\u0dd4\u0dd2 \u0d9a\u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0dd9 \u0dc4\u0dd9\u0db1\u0dca\u0dad\u0d9a\u0db1\u0dca\u0dad \u0d9a\u0d9a\u0ddc\u0d9a\u0dc4\u0ddc\u0db8\u0dd9 \u0db8\u0dd4\u0dd9\u0dbd\u0dca \u0d9a\u0dbd\u0db1\u0dca\u0dad \u0d9a\u0dab \u0ddc \u0d9a\u0dab\u0db1\u0dca\u0dad\u0d9a\u0db1\u0dca\u0dad \u0d9a\u0d9a\u0ddc\u0d9a\u0dc4\u0ddc\u0db8\u0dd9 \u0d9a\u0dbd\u0dd9\u0ddc\u0dd9 \u0d86\u0dab\u0dda\u0dcf \u0d9a\u0dab\u0db1\u0dca\u0dad\u0d9a\u0db1\u0dca\u0dad \u0d9a\u0dd2 \u0db1 \u0dc3\u0dd2\u0dc3\u0dc0\u0dad\u0dca\u200d\u0dab \u0d91\u0dad\u0db8\u0ddc\u0da7 \u0dad\u0dca\u200d\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a\u0dab \u0d9c\u0db1\u0dca\u0dad\u0db1 \u0d85\u0db4\u0dd2\u0da7 \u0db8\u0db0\u0dad\u0dba\u0db8 \u0dab\u0ddc\u0dad\u0dca\u200d\u0dbb\u0dd3 12.30\u0da7 \u0d9a\u0dae\u0ddc \u0d9a\u0dab \u0ddc \u0dd2 \u0d9a\u0db6\u0db1\u0dbd\u0ddc. \u0db8\u0db8 \u0d9a\u0db8\u0dad\u0db8\u0db1\u0dca\u0dad \u0ddc\u0da7 \u0d9a\u0dd2 \u0db1\u0dbd\u0ddc \u0d91\u0dad\u0db8\u0ddc \u0d9a\u0dab\u0db4\u0dd4 \u0dc0\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dda \u0db6 \u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2 \u0ddc."
