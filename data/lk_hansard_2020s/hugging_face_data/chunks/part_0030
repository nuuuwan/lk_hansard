dc0 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad \u0dad\u0dd3\u0dbb\u0dab\u0dba\u0d9a\u0da7 \u0d91\u0dc5\u0dd0\u0db9\u0dd2\u0dba \u0da0\u0dd2\u0dad \u0dad\u0dd3\u0dbb\u0dab\u0dba\u0d9a\u0da7 \u0d91\u0dc5\u0dd0\u0db9\u0dd2\u0dba \u0db1\u0ddc\u0dc4\u0dd0\u0d9a\u0dd2\u0dc0 \u0d87\u0dad. \u0dc4\u0dd0\u0d9a\u0dd2\u0dc0 \u0d87\u0dad.\n\n(iv) 2021.03.15 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1\u0dda \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc4\u0dcf \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dc3\u0dbd\u0dca\u0dc0\u0dbd \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc4\u0dcf \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dc3\u0dbd\u0dca\u0dc0\u0dbd \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d9c\u0dd4\u0dbb\u0dd4 \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0da9\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0da9\u0dd2\u0db4\u0dca\u0dbd\u0ddd\u0db8\u0dcf\u0db0\u0dcf\u0dbb\u0dd3\u0db1\u0dca \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dcf\u0dbb\u0dd3\u0db1\u0dca \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db4\u0dd4\u0dc0\u0dad\u0dca\u0db4\u0dad\u0dca \u0db1\u0dd2\u0dc0\u0dda\u0daf\u0db1\u0dba\u0da7 \u0d85\u0db1\u0dd4\u0dc0, 2021.12.12 \u0daf\u0dd2\u0db1 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1 \u0dbd\u0daf \u0dad\u0dbb\u0d9c \u0dc0\u0dd2\u0db7\u0dcf\u0d9c\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db5\u0dbd \u0db8\u0dad \u0dc4\u0dcf \u0d85\u0db8\u0db4/23/1568/607/121 \u0dc4\u0dcf 2023.10.09 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0db4\u0dca\u200d\u0dbb\u0da9\u0dbd \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbb\u0dc0 \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1\u0dda \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc4\u0dcf \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc4\u0dcf \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dc3\u0dbd\u0dca\u0dc0\u0dbd \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d89\u0d82\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0dc3\u0dd2 \u0dc0\u0dd2\u0dc2\u0dba \u0d9c\u0dd4\u0dbb\u0dd4 \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0da9\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0d91\u0d9a\u0dd3 \u0dca\u0db4\u0dcf\u0da9\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0d91\u0d9a\u0dd3 \u0dc0\u0dd2\u0db7\u0dcf\u0d9c\u0dba \u0dc3\u0db8\u0dad\u0dca \u0da9\u0dd2\u0db4\u0dca\u0dbd\u0ddd\u0db8\u0dcf\u0db0\u0dcf\u0dbb\u0dd3\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dcf\u0dbb\u0dd3\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9c\u0dd4\u0dbb\u0dd4 \u0dc3\u0dda\u0dc0\u0dba\u0dda 3 3-1 (\u0d87) \u0dc1\u0dca\u200d\u0dbb\u0dda\u0dab\u0dd2\u0dba\u0da7 \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0dad\u0dbb, \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0db8\u0dca\u0dbd\u0dad\u0dca \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d85\u0dad\u0dd4\u0dbb\u0dd2\u0db1\u0dca \u0dc3\u0db8 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 \u0dbd\u0db6\u0dcf \u0dad\u0dd2\u0db6\u0dd6 \u0dbd\u0db6\u0dcf \u0dad\u0dd2\u0db6\u0dd6 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dd2\u0da7\u0dd3\u0db8 \u0daf \u0dc3\u0dbd\u0d9a\u0dcf \u0d89\u0d82\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0dc3\u0dd2 \u0dc0\u0dd2\u0dc2\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dc2\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9a\u0dcf \u0d9c\u0dd4\u0dbb\u0dd4 \u0dc3\u0dda\u0dc0\u0dba\u0dda 3 3-1 (\u0d87) \u0dc1\u0dca\u200d\u0dbb\u0dda\u0dab\u0dd2\u0dba\u0da7 \u0d89\u0d82\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0dc3\u0dd2 \u0d8b\u0dc3\u0dc3\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0da9\u0dd2\u0db4\u0dca\u0dbd\u0ddd\u0db8\u0dcf\u0db0\u0dcf\u0dbb\u0dd3\u0db1\u0dca (HNDE) 501 \u0d9a\u0dca \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dad\u0dd4 \u0d9a\u0dbb \u0d87\u0dad. \u0d91\u0db8 \u0da9\u0dd2\u0db4\u0dca\u0dbd\u0ddd\u0db8\u0dcf\u0db0\u0dcf\u0dbb\u0dd3\u0db1\u0dca\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc1\u0dd2\u0d9a\u0dca\u0dc2\u0dab \u0dcf\u0dbb\u0dd3\u0db1\u0dca\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc1\u0dd2\u0d9a\u0dca\u0dc2\u0dab \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0dba\u0dcf \u0da9\u0dd2\u0db4\u0dca\u0dbd\u0ddd\u0db8\u0dcf\u0db0\u0dcf\u0dbb\u0dd3\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dcf\u0dbb\u0dd3\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9c\u0dd4\u0dbb\u0dd4 \u0dc3\u0dda\u0dc0\u0dba\u0dda 3 3-1 (\u0d86) \u0dc1\u0dca\u200d\u0dbb\u0dda\u0dab\u0dd2\u0dba\u0da7 \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0dba\u0dd2. \u0d92 \u0d85\u0db1\u0dd4\u0dc0, 2020 2020 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda \u0dc3\u0dd2\u0da7 \u0db8\u0dda \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d8b\u0d9a\u0dca\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0da9\u0dd2\u0db4\u0dca\u0dbd\u0ddd\u0db8\u0dcf\u0db0\u0dcf\u0dbb\u0dd3\u0db1\u0dca \u0dcf\u0dbb\u0dd3\u0db1\u0dca \u0dc0\u0dbb\u0dca\u0d9c \u0daf\u0dd9\u0d9a \u0dba\u0da7\u0dad\u0dda \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dbd\u0daf \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0\u0db1\u0dca \u0db4\u0dc4\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc0\u0dda.\n\n\u0dc0\u0dd2\u0dc2\u0dba \u0dc2\u0dba"
