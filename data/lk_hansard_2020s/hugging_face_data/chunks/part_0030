    "chunk_text": "\u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf \u0d9c\u0dad\u0dca\u0dad\u0ddc\u0dad\u0dca \u0d92 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf \u0dad\u0db8\u0dba\u0dd2, \u0d85\u0db4\u0dd2 \u0db8\u0dda \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\u0db1\u0dca \u0db1\u0dca \u0dc4\u0ddc\u0db3\u0da7\u0db8 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db4\u0dd4 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf. 2025 \u0dc3\u0dc4 2026 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf\u0dda \u0daf\u0dda \u0db4\u0dc5\u0db8\u0dd4 \u0db8\u0dcf\u0dc3 8\u0dc4\u0dd2 \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba \u0d86\u0daf\u0dcf\u0dba\u0db8 \u0dc3\u0d82\u0dc3\u0db1\u0dca\u0daf\u0db1\u0dba \u0d9a\u0dc5\u0ddc\u0dad\u0dca, 202 2025\u0daf\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 3,301\u0dba\u0dd2. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, 2026 \u0db4\u0dc5\u0db8\u0dd4 \u0db8\u0dcf\u0dc3 8\u0dc4\u0dd2 \u0d85\u0db4\u0dd2 \u0d91\u0dba 2026 \u0db4\u0dc5\u0db8\u0dd4 \u0db8\u0dcf\u0dc3 8\u0dc4\u0dd2 \u0d85\u0db4\u0dd2 \u0d91\u0dba 4,002\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0dc3\u0dd2\u0dba\u0dba\u0da7 21.2\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0db1\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf, \u0d85\u0db4\u0dd2\u0db8 \u0dbd\u0db6\u0dcf\u0d9c\u0dad\u0dca\u0dad \u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0db8 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0da7\u0dad\u0dca \u0dc0\u0da9\u0dcf \u0d91\u0dc4\u0dcf\u0da7 \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca. 2027 \u0dc0\u0dd9\u0db1\u0d9a\u0ddc\u0da7 \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0dcf\u0db4\u0ddc\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0dd9\u0db1\u0dc0\u0dcf \u0db8\u0dda\u0d9a \u0d9a \u0dc3\u0dd2\u0dba\u0dba\u0da7 16\u0d9a \u0dc0\u0dcf\u0d9c\u0dda \u0db8\u0da7\u0dca\u0da7\u0db8\u0d9a \u0dad\u0dd2\u0dba\u0dcf \u0d9c\u0dd9\u0db1 \u0dba\u0db1\u0dca\u0db1. \u0d9a\u0dd9\u0da7\u0dd2 \u0d9a\u0dcf\u0dbd\u0dd3\u0db1, \u0db8\u0db0\u0dca\u200d\u0dba\u0dba \u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0dc4\u0dcf \u0daf\u0dd3\u0dbb\u0dca\u0d9d \u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d85\u0db4\u0dd2 \u0db8\u0dda\u0d9a \u0daf\u0dc5 \u0d9a \u0daf\u0dc5 \u0daf\u0dda\u0dc1\u0dd3\u0dba \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0dd2\u0dad\u0dba\u0dd9\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 20\u0d9a \u0dc0\u0dcf\u0d9c\u0dda \u0db4\u0dca\u200d\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0da7 \u0dba\u0dd1\u0db8\u0dda \u0db6\u0dbd\u0dcf\u0db4\u0ddc\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf, \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2\u0da7 \u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2\u0da7 \u0dc0\u0dd2\u0dc1\u0dca\u0dc0\u0dcf\u0dc3\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf, \u0d85\u0db4\u0dda \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dc0\u0dbd\u0da7 \u0dba\u0db1\u0dca\u0db1 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dc0\u0dbd\u0da7 \u0dba\u0db1\u0dca\u0db1 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0dbd\u0dd0\u0db6\u0dd9\u0dba\u0dd2\u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dd2\u0d9a\u0dd2\u0dba\u0dbd\u0dcf.\n\n\u0d8a\u0dc5\u0d9f\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dae\u0db8\u0dd2\u0d9a \u0d85\u0dad\u0dd2\u0dbb\u0dd2\u0d9a\u0dca\u0dad\u0dba \u0d9c\u0dad\u0dca\u0dad\u0ddc\u0dad\u0dca, 2025 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf\u0dda \u0db4\u0dc5\u0db8\u0dd4 \u0daf\u0dda \u0db4\u0dc5\u0db8\u0dd4 \u0db8\u0dcf\u0dc3 \u0d85\u0da7\u0dda \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1,276.5\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf. 2026 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf\u0dda \u0daf\u0dda \u0d92\u0d9a \u0d85\u0db4\u0dd2 \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb \u0d9c\u0dad\u0dca\u0dad\u0dcf, \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1,644.5\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf. 644.5\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf. \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dae\u0db8\u0dd2\u0d9a \u0d85\u0dad\u0dd2\u0dbb\u0dd2\u0d9a\u0dca\u0dad\u0dba \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dca\u200d\u0dba\u0dba\u0dba\u0dd9\u0db1\u0dca 2026 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf\u0dda \u0daf\u0dc5 \u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dba \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0dd2\u0dad\u0dba\u0dd9\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 3.6\u0d9a\u0dca. \u0db8\u0dda\u0d9a \u0dc0\u0dd0\u0da9\u0dd2 \u0d85\u0d9c\u0dba\u0d9a\u0dca. \u0d85\u0db4\u0dd2 \u0dd2 \u0d85\u0d9c\u0dba\u0d9a\u0dca. \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0dcf\u0db4\u0ddc\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0dd9\u0da0\u0dca\u0da0 \u0d89\u0dbd\u0d9a\u0dca\u0d9a, \u0d85\u0db4\u0dd2 \u0daf\u0dd3\u0db4\u0dd4 \u0d85\u0db4\u0dd2 \u0daf\u0dd3\u0db4\u0dd4 targets\u0dc0\u0dbd\u0da7 \u0dc0\u0da9\u0dcf, \u0d85\u0db4\u0dd2 \u0d85\u0db4\u0dd2 set \u0d9a\u0dbb \u0d9c\u0dad\u0dca\u0dad targets\u0dc0\u0dbd\u0da7 \u0dc0\u0da9\u0dcf \u0dc0\u0dd0\u0da9\u0dd2\u0db4\u0dd4\u0dbb \u0dd2\u0db4\u0dd4\u0dbb achievement \u0d91\u0d9a\u0d9a\u0dca. 2027 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc0\u0dd9\u0db1\u0d9a\u0ddc\u0da7 \u0db8\u0dda\u0d9a \u0db4\u0dd4\u0dbb\u0ddd\u0d9a\u0dae\u0db1\u0dba \u0d9a\u0dbb \u0db1\u0dba \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dda \u0dc3\u0dd2\u0dba\u0dba\u0da7 2. 6\u0d9a\u0da7 \u0dc0\u0dcf\u0d9c\u0dda. \u0dc3\u0db8\u0dc4\u0dbb \u0dc0\u0dd2\u0da7 \u0daf\u0dc1\u0db8 \u0dad\u0dd4\u0db1\u0d9a\u0dca \u0dc0\u0dcf\u0d9c\u0dda \u0d85\u0da9\u0dd4\u0dc0\u0dd3\u0db8\u0dda \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf, \"\u0daf\u0dd2\u0da7\u0dca\u0dc0\u0dcf\" \u0db1\u0dd2\u0dc3\u0dcf \u0dc0\u0dd9\u0da0\u0dca\u0da0 \u0dc4\u0dcf\u0db1\u0dd2\u0dba \u0dc3\u0dc4 \u0da0\u0dca\u0da0 \u0dc4\u0dcf\u0db1\u0dd2\u0dba \u0dc3\u0dc4 \u0d91\u0dba recover \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dba\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dd4\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0db8. \u0d9a\u0dd9\u0dc3\u0dda \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0d85\u0db4\u0dd2 \u0dad\u0dd2\u0db6\u0dca\u0db6 \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba \u0db6 \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba - target \u0d91\u0d9a - \u0d85\u0db1\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dae\u0db8\u0dd2\u0d9a \u0db8\u0dd2\u0d9a \u0d85\u0dad\u0dd2\u0dbb\u0dd2\u0d9a\u0dca\u0dad\u0dba \u0daf\u0dc5 \u0daf\u0dda\u0dc1\u0dd3\u0dba \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0dd2\u0dad\u0dba\u0dd9\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 2.3\u0d9a \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba\u0da7 \u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 2.3\u0d9a \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba\u0da7 \u0dc0\u0da9\u0dcf \u0db4\u0dc4\u0dc5\u0da7 \u0db1\u0ddc\u0dba\u0dcf \u0db8\u0dda\u0d9a \u0db6\u0dda\u0dbb\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dda \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0d85\u0db4 \u0dc3\u0dad\u0dd4\u0dc0 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0d85\u0db4 \u0dc3\u0dad\u0dd4\u0dc0 \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0dcf. \u0db1\u0dc0\u0dcf.\n\n\u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0da2\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0db1\u0dca\u0dad\u0dbb \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba\u0dba \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0db1\u0dca prediction \u0d91\u0d9a\u0d9a\u0dca \u0daf\u0dd3\u0dbd\u0dcf \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0dcf, \u0dbd\u0ddd\u0d9a \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0db8\u0db1\u0dca\u0daf\u0d9c\u0dcf\u0db8\u0dd3 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0dda\n\n519 520\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0dd4\u0dc0"
