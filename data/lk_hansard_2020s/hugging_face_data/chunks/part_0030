0ddc\u0dbd \u0dab\u0d9a\u0dca \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0ddc\u0d9a\u0ddc\u0dab\u0d9a\u0dda \u0d9a\u0dbd\u0dad\u0dca\u200d \u0d85\u0dbd\u0d9a\u0dc0\u0ddd\u0dc2\u0dba \u0d9a\u0dab \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0d85\u0dad\u0dca\u200d\u0dba\u0dbd\u0dc0\u0dba \u0d9a\u0dc0\u0dca. \u0dc3\u0dd2\u0db0\u0dd2\u0db8\u0dca\u0dbd \u0dc3\u0dc0\u0dae\u0ddc\u0db4\u0dd2\u0dad\u0dca\u200d \u0d9a\u0dab\u0db1 \u0dd9 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0d9a\u0dc0\u0dca\u0dd9 \u0db1\u0dca\u0dad \u0da7\u0d9a\u0dca \u0dab\u0ddc\u0dbd\u0dba \u0d85\u0dd2\u0d82\u0dc0\u0d9a\u0da9 \u0db4\u0dd4\u0dab\u0db4\u0dca\u0dc0\u0ddc\u0da9\u0dd4 \u0dc3\u0db3\u0dc4\u0ddc \u0db6\u0db3\u0dbd\u0ddc \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dad\u0dc5 \u0dab\u0ddc\u0dbd\u0dba \u0d9a\u0dc3\u0dc0\u0dbd\u0d9a\u0da9 \u0d85\u0dbd\u0dc0\u0dba\u0dad\u0dca\u200d\u0ddc \u0dc3\u0dda\u0dd6\u0dbb\u0dca\u0dbd\u0dba \u0dbd\u0db1\u0dca\u0dad\u0db1\u0ddc \u0d9a\u0dc3\u0dc0\u0db8 \u0dbb\u0dd0\u0d9a\u0dd2 \u0ddc \u0ddc\u0db7\u0dd3 \u0d8b\u0dc0\u0ddc\u0db0\u0dd2\u0db0\u0dad\u0ddc\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0dad\u0dc5 \u0dd9 \u0d85\u0db7\u0dd2\u0db8\u0ddc\u0db1\u0dbd\u0dca \u0db6\u0dbd\u0d9a\u0dca \u0dc3\u0dd2 \u0d9a\u0dab\u0dba\u0dd2. \u0d92 \u0dc4\u0dd0\u0dbb\u0dd4\u0dab\u0dd4 \u0dc3\u0dd2\u0da7 \u0d9a\u0dc0\u0dde\u0dc1\u0d9c\u0dd2\u0d9a \u0d85\u0dd2\u0d82\u0dc0\u0d9a\u0da9 \u0dbb\u0dd0\u0d9a\u0dd2 \u0ddc \u0dc3\u0db3\u0dc4\u0ddc \u0dd9 \u0dbd\u0dba\u0dbd\u0dc3\u0ddc \u0d9a\u0dca\u0dbd \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0ddc\u0d9a\u0ddc\u0dab\u0d9a\u0dda \u0dc3\u0db3\u0dc4\u0ddc \u0dd9 \u0d9a \u0ddc\u0db8\u0dd4 \u0dd3\u0db8\u0da7 \u0d8b\u0dc0\u0ddc\u0db0\u0dd2\u0db0\u0dad\u0ddc\u0dbb\u0dd2\u0db1\u0dca\u0dad\u0da7 \u0d89\u0dad \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dc0\u0dad\u0dca\u200d\u0ddc \u0dc3\u0dd2 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad \u0d9a\u0dc0\u0dca. \u0d91\u0db6\u0dd0\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0dbb\u0dd0\u0d9a\u0dd2 \u0ddc \u0dc3\u0dd2\u0dab\u0dc4\u0dd2\u0dad\u0dca\u200d \u0d8b\u0dc0\u0ddc\u0db0\u0dd2\u0db0\u0dad\u0ddc\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0dbb\u0dd0\u0d9a\u0dd2 \u0ddc\u0d9c\u0dad\u0dca\u200d \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db1 \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dbd\u0da7 \u0dc3\u0dd2\u0dc3\u0db3\u0dd4\u0dda \u0d9a\u0dc3\u0dd3\u0db8\u0da7\u0dca \u0dbd\u0dad\u0ddc \u0dab\u0da7 \u0dad\u0dc5 \u0dc3\u0db8\u0dc3\u0dc0\u0dad\u0dca\u200d \u0d9a\u0dca \u0d9a \u0dc3 \u0dc3\u0dd2\u0dbb\u0dd0\u0d9a\u0dd2 \u0ddc\u0dbd \u0dad\u0dab\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dbd\u0dca\u0db8\u0db1\u0dca\u0dad \u0dab\u0dbd\u0d9a\u0da9 \u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dc0\u0dca\u0dd2 \u0dd3 \u0dc3\u0dd2 \u0d85\u0dad\u0dca\u200d\u0dab \u0d92 \u0dc3\u0db3\u0dc4\u0ddc \u0d85\u0db1\u0dd4\u0d9c\u0db8\u0db1 \u0d9a\u0dab\u0db1 \u0d8b\u0dc0\u0ddc \u0db8\u0ddc\u0dbb\u0dca\u0dbd\u0d9c \u0dbd\u0db1\u0dca\u0dad\u0d9a\u0db1\u0dca\u0dad \u0dab\u0d9a\u0dca \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9a\u0dc0\u0dca. \u0d8a\u0da7 \u0d85\u0dd9\u0ddc\u0dc5 \u0d9a\u0dad\u0dca\u200d\u0ddc\u0dab\u0dad\u0dbb\u0dd4 \u0dc3\u0db8\u0dd4\u0dab\u0dd4\u0db8 03 \u0db8\u0d9f\u0dd2\u0db1\u0dca\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dc0\u0dca \u0d9a\u0dab\u0db1\u0dbd\u0ddc."
