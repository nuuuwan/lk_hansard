    "chunk_text": "\u0d9a\u0db6\u0dd3\u0dbb\u0dca\u0dbd \u0dc4\u0dc2\u0dd3\u0dda \u0db8\u0dd0\u0dc0 \u0dd4\u0db8\u0db1\u0dd2, \u0d94\u0db6\u0dd4\u0db8\u0dcf 221 \u0daf\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c \u0dd2\u0db8\u0dc0 \u0dbb? \u0dd0\u0dc4\u0dd0 \u0db8\u0db1\u0dca\u0dad\u0dbb? \u0d94\u0db6\u0dd4\u0db8\u0dcf\u0dba \u0db8 \u0dcf\u0d9a\u0dd4 \u0d92\u0dc0\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0dd0\u0dc4\u0dd0. \u0db8\u0dba \u0db8\u0dad\u0d9a\u0dba\u0dd2. \u0d94\u0db6\u0dd4\u0db8\u0dcf\u0dba \u0db8 \u0dcf\u0d9a\u0dd4 \u0d92\u0dc0\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0dd0\u0dc4\u0dd0. \u0d9a\u0dd2\u0dbb\u0dd2\u0dd2\u0dda \u0dad\u0db8\u0dba\u0dd2 \u0dd2\u0db8\u0dc0 \u0dd2\u0dc2\u0db0\u0dd2\u0dba\u0dba \u0dc4\u0dd2\u0da7\u0dd2\u0db8\u0dda . \u0d92\u0db8\u0d9a\u0dca \u0db8\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0dbb \u0db8\u0dc0 \u0dcf \u0dc0 \u0dd4\u0daf\u0db8\u0dab\u0dca? 221 \u0daf\u0dd3 \u0d9c\u0dd2\u0dd2\u0dc2\u0dc3\u0dd4\u0db8\u0d9a\u0dca \u0d9c\u0dd0\u0dd4\u0dab\u0dc0\u0dcf. \u0d82\u0dd2\u0dc5 \u0d82\u0db0\u0dd2\u0db8\u0dda\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0db8\u0dda \u0db8\u0dd4\u0dbb\u0dda \u0db8\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0db1 \u0dd1 \u0db8\u0d9a\u0dcf \u0dbb\u0dca\u0dbd\u0dc0\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0dc4 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda\u0dc0\u0dd2\u0db1\u0dca\u0dad. \u0d82\u0dd2\u0dc5 \u0d89\u0dc3\u0dc0\u0db8\u0dc3\u0dda \u0dcf\u0db8 \u0dd2\u0dc3\u0dc0\u0dad\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc4\u0dbb\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda\u0dc0\u0dd2\u0db1\u0dca\u0dad. \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda\u0dc0\u0dd2\u0db1\u0dca\u0dad \u0dd2\u0dc3\u0dc0\u0dad\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0dc4\u0dbb \u0dcf \u0d82\u0dd2\u0dc5 \u0d92 \u0db8\u0d9c\u0dcf\u0dda \u0db1\u0dca\u0dad\u0dba \u0db8\u0d9a\u0dcf \u0dbb\u0dca\u0dbd \u0dca\u200d\u0dbb\u0dc0 \u0dc1\u0dad\u0dba \u0db8\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0db1 \u0dd1. \u0db8\u0d9a\u0dcf \u0dbb\u0dca\u0dbd \u0dca\u200d\u0dbb\u0dc0 \u0dc1\u0dad\u0dba \u0db8\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0db8\u0d9a\u0dcf \u0dbb\u0dca\u0dbd \u0d9c\u0dab \u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0d9a\u0dc0\u0dbb\u0dcf \u0db4\u0dd0\u0dc0\u0dd0\u0dc0 \u0d82\u0d9c\u0dba\u0dba \u0dbb? \u0d9c\u0dd2\u0dd2\u0dc2\u0dc3\u0dd4\u0db8 \u0d82\u0dad\u0dca\u0dc3\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0db4\u0dd4 \u0dbb\u0dc0\u0db8\u0dc3\u0dc0 \u0db4\u0dd0\u0dc0\u0dd0\u0dc0 \u0db8\u0d9a\u0dcf \u0dbb\u0db8\u0dda \u0d82\u0d9c\u0dba\u0dba. \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad, \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda 132\u0dba. 2225 \u0d82\u0dd2\u0dc5 \u0db8\u0d9a\u0dcf \u0dbb\u0dca\u0dbd \u0db8\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0db1 \u0dd1 \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda 132\u0db1\u0dca\u0dad \u0db8\u0db6\u0dbb \u0dcf. \u0dd2\u0dc3\u0dc0 \u0dc0\u0dc4\u0db8\u0d9c \u0dbb \u0db8\u0dda \u0d9c\u0dd2\u0dd2\u0dc2\u0dc3\u0dd4\u0dda \u0d9c\u0dd0\u0dd4\u0dab\u0db8\u0dda? \u0db8\u0dda\u0dc0\u0dcf, \u0dbb\u0dba\u0dba \u0d9a\u0dbb\u0db4\u0dd4 \u0d82\u0db4\u0dbb\u0dcf\u0db0\u0dcf! \u0d82\u0dbb \u0d82\u0dd2\u0dc5 \u0d9c\u0dd2\u0dd2\u0dc2\u0dc3\u0dd4\u0dda\u0dc0 \u0dba \u0db6\u0dd0\u0db3\u0dd2 \u0dcf \u0dc0 \u0db8\u0db6 \u0dc0\u0dcf \u0dbb\u0dcf\u0da2\u0dba\u0dba\u0db1\u0dca\u0dad \u0d91\u0d9a\u0dca\u0d9a \u0d9c\u0dd2\u0dd2\u0dc2\u0dc3\u0dd4\u0dda\u0dc0 \u0dba \u0d91 \u0dd0\u0dd2\u0dbd \u0dcf \u0dc0 \u0db8\u0db6 \u0dc0\u0dcf. \u0d82\u0dd2\u0dc5 \u0d8b\u0db4\u0dbb\u0dd2\u0db8 \u0dbb\u0dcf\u0da2\u0dba\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0db8 \u0dc3 \u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0d9a \u0dcf, \u0db8\u0dda\u0d9a \u0dd2\u0dc2\u0dc3\u0db3\u0dcf \u0d9c\u0db1\u0dca\u0dad . \u0d82\u0dd2\u0dc5 \u0d91\u0dba \u0dba\u0dda \u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dba \u0dc3\u0dcf\u0db0\u0dcf\u0dcf\u0dbb\u0dab \u0db8 \u0dc3 \u0dd2\u0dc2\u0dc3\u0db3\u0dcf \u0d9c\u0db1\u0dca\u0dad \u0dc3\u0db8\u0dad\u0dca \u0db8\u0dc0 \u0dcf \u0dc0 \u0db8\u0db6 \u0dc0\u0dcf. \u0db8\u0dd4\u0dad\u0dca \u0d89\u0dad\u0dcf\u0db8 \u0d82\u0dc0\u0dcf\u0dc3\u0dd2\u0dc3\u0dc4\u0d9c\u0dad \u0d9c\u0dd2\u0dd2\u0dc2\u0dc3\u0dd4\u0dda\u0dc0 \u0dca\u200d\u0dbb\u0dc0 \u0dd2\u0dc2\u0db4\u0dcf\u0d9a \u0db1\u0dd2\u0dc3\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0d9a\u0d9a\u0dc0\u0dad - \u0db8\u0dd3\u0dbb\u0dd2\u0d9c\u0db8 \u0d82\u0db0\u0dd2\u0db8\u0dda\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0dba \u0d82\u0dbb\u0dad\u0dca \u0dc4\u0dd0\u0db8\u0dbb\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0dd0\u0dd4\u0dc0 \u0dc0 \u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad. \u0dc0\u0dd0\u0db8 \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dc0 \u0dd4\u0daf\u0dab\u0dcf \u0dda, \u0d82\u0dd2\u0dc5 \u0d86\u0dc0\u0dcf \u0dc3\u0dda\u0dd2 \u0dbb\u0dd0\u0dda\u0db8\u0dcf \u0dc0\u0dd0\u0db8 \u0d89\u0dc0\u0dbb \u0d9a \u0dcf.\n\n\u2022 2026 \u0dc0\u0dc3\u0db8\u0dbb\u0dca\u0dbd \u0dc0\u0dd0\u0d9a \u0d86\u0dbb\u0dda\u0db7\u0dcf \u0d9a \u0db8\u0db0\u0dcf\u0dba\u0db8 \u0d82\u0db0\u0dd2\u0db8\u0dda\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0db8\u0dda \u0dbb\u0dd4 \u0d9a\u0dca\u0d9a - \u0d9c \u0db8\u0d9c\u0dbb\u0dbb \u0db8\u0d9a\u0dcf\u0dba\u0dc3 2229 \u0da2\u0dd6\u0dd2 \u0dc0 \u0dd2\u0dc2\u0dba \u0dc0\u0dd0\u0d9a \u0d82\u0dc0\u0dc3\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d82\u0dbb\u0db8\u0dd4\u0dab\u0dd4 \u0d9a\u0dbb\u0db8\u0d9c 2227 \u0dc0\u0dc3\u0dbb \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0dd2\u0dc5\u0dba\u0dda \u0db8\u0dd2\u0dd2\u0dba 23,252\u0d9a\u0dca \u0db8\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dbb \u0dc0 \u0db8\u0db6 \u0dc0\u0dcf. 222 \u0dc0\u0dc3\u0db8\u0dbb\u0dca\u0dbd \u0dc0\u0dd0\u0d9a \u0d86\u0dbb\u0dda\u0db7\u0dcf \u0d9a -\u0d82\u0dd2\u0dc5 \u0db6 \u0dba\u0dba \u0dd2\u0dd2\u0dc2\u0dda \u0dcf \u0dc0\u0dd0\u0d9a \u0d86\u0dbb\u0dda\u0db7\u0dcf \u0d9a - \u0db8\u0db0\u0dcf\u0dba\u0db8 \u0d82\u0db0\u0dd2\u0db8\u0dda\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0d9c\u0db8\u0dda \u0dbb\u0dd4 \u0d9a\u0dca\u0d9a - \u0d9c \u0db8\u0d9c\u0dbb\u0dbb \u0db8\u0d9a\u0dcf\u0dba\u0db8\u0dc3\u0dc0, \u0dbb\u0dd0\u0db1\u0dca\u0dad \u0d94\u0db1\u0dca\u0dad \u0dc0\u0dd0\u0d9a. \u0d82\u0dbb\u0d9a 221 \u0d86\u0dbb\u0dda\u0db7\u0dcf \u0d9a\u0dbb \u0dcf \u0dad\u0dc0\u0db8 \u0dba \u0dc0\u0dcf. \u0d92\u0dc0\u0dcf\u0dad\u0dca \u0dab\u0dba. \u0d92 \u0d94\u0d9a\u0dca\u0db8\u0d9a\u0ddd\u0db8 \u0dab\u0dba. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0db8\u0dad\u0d9a \u0dad\u0db6\u0dcf\u0d9c\u0db1\u0dca\u0dad , \u0db8\u0dda \u0d91\u0d9a\u0d9a\u0dca\u0dc0\u0dad\u0dca \u0dab\u0dba \u0db8 \u0dcf\u0db8\u0dc0\u0dba\u0dd2. \u0d9a\u0d9a\u0dc0\u0dad - \u0db8\u0dd3\u0dbb\u0dd2\u0d9c\u0db8 \u0d9a\u0dd1\u0dda \u0db4\u0dbb\u0dab \u0dab\u0dba\u0dba \u0d9a\u0dbb\u0db8\u0d9c \u0dba\u0db1\u0dca\u0dad \u0db8\u0dc0 \u0dc0\u0dcf. \u0d92\u0d9a \u0d82\u0db8\u0dbb \u0d9a\u0dcf \u0db8\u0dda \u0d86\u0dbb\u0dda\u0db7\u0dcf \u0d9a\u0dbb\u0db4\u0dd4 \u0d91\u0d9a\u0d9a\u0dca \u0db8 \u0dcf\u0db8\u0dc0\u0dba\u0dd2. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0d82\u0dd2\u0dc5 \u0d86\u0dbb\u0dda\u0db7\u0dcf \u0d9a\u0dbb \u0d94\u0d9a\u0dca\u0db8\u0d9a\u0ddd\u0db8 \u0d86\u0db8\u0dba\u0ddd\u0da2 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0db8\u0dda \u0db7\u0dcf\u0dcf\u0dab\u0dca\u0d9a\u0dcf\u0d9c\u0dcf\u0dbb\u0db8\u0dda \u0dc3\u0dda\u0dd2. \u0db8\u0dad\u0d9a \u0dc0 \u0dba\u0dcf \u0d9c\u0db1\u0dca\u0dad , \u0d82\u0dd2\u0dc5 \u0db8\u0dda \u0dbb\u0dba \u0dc4\u0dbb\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0d91\u0db8\u0dc4\u0db8\u0dba\u0dd2. \u0dad\u0db8\u0dd4\u0db1\u0dca\u0dad \u0dcf\u0db1\u0dca\u0dad\u0db8\u0dc3\u0dc0 \u0dcf \u0d9c \u0db8\u0d9c\u0dbb\u0dbb \u0d9c\u0dd2\u0db8\u0dba\u0dcf\u0dad\u0dca, \u0d92 \u0db8\u0db6\u0ddd \u0d91\u0d9a \u0db6 \u0db1\u0dca\u0dad ."
