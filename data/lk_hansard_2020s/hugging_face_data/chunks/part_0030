    "chunk_text": "\u2022 2025\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0b95\u0bb5\u0bb3\u0bbf\u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0baa\u0ba3\u0bb5\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0bb2\u0bcd \u0bb5\u0bb0\u0bc1\u0bb5\u0bbe\u0baf\u0bcd \u0b90.\u0b85. \u0b95\u0b9f\u0bbe\u0bc8\u0bb0\u0bcd 8.1 \u0baa\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bbe\u0b95 \u0bb5\u0bb0\u0bc8\u0bbe\u0bb1\u0bcd\u0bb1\u0bbf\u0b9a\u0bc8\u0b9a\u0baf \u0b85\u0ba4\u0bbf\u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0b95\u0baa\u0bb1\u0bc1\u0bae\u0ba4\u0bbf\u0bae\u0baf\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bc1 \u0b95\u0b9a\u0baf\u0bcd\u0ba4\u0ba4\u0bc1. \u0b85\u0b9a\u0ba4\u0b9a\u0baa\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1 \u0b87\u0ba8\u0bcd\u0ba4 \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0b92\u0b95\u0bcd\u0b9a\u0bb0\u0bbe\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bb3\u0bb5\u0bbf\u0bb2\u0bcd \u0b85\u0ba4\u0bc1 \u0b90.\u0b85. \u0b95\u0b9f\u0bbe\u0bc8\u0bb0\u0bcd 7.6 \u0baa\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bbe\u0b95\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. \u0b85\u0ba4\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0bbe\u0bb0\u0bae\u0bcd, \u0b87\u0bae\u0bcd\u0bae\u0bc1\u0bae\u0bb1 9 \u0baa\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0b95\u0b9f\u0bbe\u0bc8\u0bae\u0bb0 \u0bae\u0bbf\u0bae\u0b95\u0ba4\u0bcd\u0ba4\u0bc1\u0b9a\u0bcd \u0b95\u0b9a\u0bb2\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b95\u0bb5\u0bb3\u0bbf\u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0baa\u0ba3\u0bb5\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0bb2\u0bcd \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1.\n\n\u2022 2022\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bb5\u0bb0\u0bc1\u0bae\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd 79.1% \u0bb5\u0b9f\u0bcd\u0b9f\u0bbf\u0b95\u0bcd \u0b95\u0b95\u0bbe\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0ba9\u0bb5\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95\u0b9a\u0bcd \u0b95\u0b9a\u0bc8\u0bb5\u0bbf\u0b9f\u0baa\u0bcd \u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0b9a\u0ba4\u0b9a\u0bb5\u0bae\u0bb3\u0baf\u0bbf\u0bb2\u0bcd, 2025\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd 45.9% \u0b9a\u0ba4\u0bb5\u0bc0\u0ba4\u0bae\u0bcd \u0bb5\u0bae\u0bb0\u0baf\u0bbf\u0bb2\u0bc1\u0bae\u0bcd, 2026 \u0b95\u0b9a\u0baa\u0bcd\u0b95\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0b85\u0bb3\u0bb5\u0bbf\u0bb2\u0bcd 39.6% \u0bb5\u0bae\u0bb0\u0baf\u0bbf\u0bb2\u0bc1\u0bae\u0bcd, \u0b9a\u0bae\u0bb2\u0bc1\u0bae\u0bcd \u0b95\u0bc1\u0bae\u0bb1\u0bb5\u0bae\u0b9f\u0ba8\u0bcd\u0ba4\u0ba4\u0bc1.\n\n\u2022 2022\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bbe\u0ba9 52 \u0b85\u0bb0\u0b9a \u0b95\u0ba4\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0baf\u0bb1\u0bcd\u0b9a\u0bbf\u0b95\u0bb3\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bc1 \u0b95\u0b9a\u0baf\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 774.6 \u0baa\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0b92\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bae\u0bbe\u0ba4\u0bcd\u0ba4 \u0bb5\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bb0\u0bbe\u0ba9 \u0b9a\u0ba4\u0bb1\u0bbf\u0baf \u0ba8\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, 2025\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 444.4 \u0baa\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0b87\u0bc8\u0bbe\u0baa\u0bae\u0bbe\u0b95 \u0bae\u0bbe\u0bb1\u0bbf\u0baf\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. \u0b85\u0ba4\u0ba9\u0bcd\u0bae\u0bc2\u0bc8\u0bae\u0bcd, \u0ba4\u0bbf\u0bae\u0bb1\u0b9a\u0b9a\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\n\n225 226\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0b85\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0b95\u0bc1\u0bae\u0bb1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. \u0ba8\u0bbe\u0bae\u0bcd \u0ba8\u0b9f\u0bcd\u0b9f\u0bae\u0bae\u0b9f\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0b99\u0bcd\u0b95\u0bae\u0bb3 \u0b87\u0bc8\u0bbe\u0baa\u0bae\u0bae\u0b9f\u0baf\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bbe\u0b95 \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bbf\u0baf\u0bc1\u0bb3\u0bcd\u0b9a\u0bb3\u0bbe\u0bae\u0bcd. 2026 \u0b86\u0b95\u0bb8\u0bcd\u0b9f\u0bcd \u0bae\u0bbe\u0ba4 \u0b87\u0bb1\u0bc1\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb0\u0bc2\u0baa\u0bbe\u0baf\u0bcd 367 \u0baa\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0bb5\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bb0\u0bbe\u0ba9 \u0b87\u0bc8\u0bbe\u0baa\u0b95\u0bae\u0bbe\u0ba9\u0bcd\u0bae\u0bb1\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bc1\u0b95\u0b9a\u0baf\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0b9a\u0bb3\u0bbe\u0bae\u0bcd. \u0bb8\u0bcd\u0bb0\u0bc0\u0bc8\u0b99\u0bcd\u0b95\u0ba9\u0bcd \u0b8f\u0bb0\u0bcd\u0bae\u0bc8\u0ba9\u0bcd\u0bb8\u0bcd \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0bae\u0bcd, 2008 \u0b87\u0bb2\u0bcd \u0bae\u0b95\u0baf\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 2025 \u0bb5\u0bae\u0bb0 \u0bb0\u0bc2. 528 \u0baa\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0ba8\u0bb7\u0bcd\u0b9f\u0ba4\u0bcd\u0bae\u0ba4\u0b9a\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd \u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bae\u0bae\u0baf \u0bb8\u0bcd\u0bb0\u0bc0 \u0bc8\u0b99\u0bcd\u0b95\u0ba9\u0bcd \u0b8e\u0baf\u0bbe\u0bb0\u0bcd\u0bae\u0bc8\u0ba9\u0bcd\u0bb8\u0bcd \u0b95\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0b95\u0baa\u0bbe\u0ba4\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bae\u0bb1\u0b9a\u0b9a\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0b9a\u0bc1\u0bae\u0bae\u0baf\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0bb0\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0b9a\u0ba4\u0bae\u0bb5\u0baf\u0bbe\u0ba9 \u0ba4\u0bc0\u0bb0\u0bcd\u0bb5\u0bc1\u0b95\u0bae\u0bb3\u0b95\u0bcd \u0b95\u0ba3\u0bcd\u0b9f\u0bb1\u0bbf\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0ba4\u0bb1\u0bcd\u0b9a\u0baa\u0bbe\u0ba4\u0bc1 \u0b85\u0bae\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bae\u0bb5 \u0baf\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0ba8\u0bbf\u0baa\u0bc1\u0ba3\u0bb0\u0bcd \u0b95\u0bc1\u0bb4\u0bc1\u0b95\u0bb5\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba8\u0bbf\u0baf\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.\n\n\u2022 \u0b89\u0bc8\u0b95\u0b9a\u0bcd \u0b9a\u0ba8\u0bcd\u0bae\u0ba4\u0baf\u0bbf\u0bb2\u0bcd \u0b8e\u0bbe\u0bbf\u0b95\u0baa\u0bbe\u0bb0\u0bc1\u0bb3\u0bcd \u0bb5\u0bbf\u0bae\u0bc8 \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bbf\u0baa\u0bcd\u0baa\u0bae\u0ba4\u0b95\u0bcd \u0b95\u0bbe\u0bb0\u0ba3\u0bae\u0bbe\u0b95\u0b95\u0bcd \u0b95\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1 2025\u0b87\u0bb2\u0bcd \u0b92\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bae\u0bbe\u0ba4\u0bcd\u0ba4 \u0b8e\u0bbe\u0bbf\u0b95\u0baa\u0bbe\u0bb0\u0bc1\u0bb3\u0bcd \u0b87\u0bb1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b95\u0baa\u0bbe\u0bb0\u0bc1\u0b9f\u0bcd\u0b9f\u0bc1, \u0b90.\u0b85. \u0b95\u0b9f\u0bbe\u0bc8\u0bb0\u0bcd 4,042 \u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bbe\u0b95 \u0b95\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0baa\u0bb1\u0bc1\u0bae\u0ba4\u0bbf, 2026 \u0b95\u0b9a\u0baa\u0bcd\u0b95\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bcd \u0b85\u0bb3\u0bb5\u0bbf\u0bb2\u0bcd \u0b95\u0b9f\u0bbe\u0bc8\u0bb0\u0bcd \u0b90.\u0b85. 4,487 \u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0b95\u0b9a\u0bc8\u0bb5\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bae\u0bae, \u0bb5\u0bbe\u0b95\u0ba9 \u0b87\u0bb1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0ba4\u0bbf\u0b9a\u0bcd \u0b9a\u0ba8\u0bcd\u0bae\u0ba4 \u0ba4\u0bbf\u0bb1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bc1\u0bae\u0bcd, \u0b95\u0bb5\u0bb3\u0bbf\u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1 2026 \u0b92\u0b95\u0bcd\u0b9a\u0bb0\u0bbe\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bb3\u0bb5\u0bbf\u0bb2\u0bcd \u0b90.\u0b85. \u0b95\u0b9f\u0bbe\u0bc8\u0bb0\u0bcd 7 \u0baa\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bae\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bc1\u0b95\u0b9a\u0baf\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.\n\n\u2022 \u0b8e\u0bb5\u0bcd\u0bb5\u0bbe\u0bb1\u0bbe\u0baf\u0bbf\u0ba9\u0bc1\u0bae\u0bcd, 2025 \u0b95\u0b9a\u0baa\u0bcd\u0b95\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bb3\u0bb5\u0bbf\u0bb2\u0bcd 2.1% \u0b9a\u0ba4\u0bb5\u0bc0\u0ba4\u0bae\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bbe\u0b95\u0bbf\u0baf \u0bb5\u0bb0\u0bc1\u0b9f\u0bbe\u0ba8\u0bcd\u0ba4 \u0baa\u0ba3\u0bb5\u0bc0\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0baf\u0bc1\u0ba4\u0bcd\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bc1\u0bae\u0bcd, \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0b9a\u0bcd \u0b95\u0b9a\u0ba9\u0bcd\u0bb1 \u0b8e\u0bbe\u0bbf\u0b95\u0baa\u0bbe\u0bb0\u0bc1\u0bb3\u0bcd \u0bb5\u0bbf\u0bae\u0bc8, \u0b85\u0b9a\u0ba4\u0b9a\u0baa\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1 \u0b85\u0ba4\u0b9a\u0ba9\u0bbe\u0b9f\u0bc1 \u0b87\u0bae\u0ba3\u0ba8\u0bcd\u0ba4 \u0b8f\u0bae\u0ba9\u0baf \u0b95\u0bbe\u0bb0\u0ba3\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b95\u0bbe\u0bb0\u0ba3\u0bae\u0bbe\u0b95 2026 \u0b92\u0b95\u0bcd\u0b9a\u0bb0\u0bbe\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bb3\u0bb5\u0bbf\u0bb2\u0bcd 8.3% \u0b9a\u0ba4\u0bb5\u0bc0\u0ba4\u0ba4\u0bcd\u0bae\u0ba4\u0bb5\u0bbf\u0b9f \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0ba4\u0bc1."
