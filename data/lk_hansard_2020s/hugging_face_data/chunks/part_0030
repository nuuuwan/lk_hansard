    "chunk_text": "\u0baa\u0ba3\u0bbf\u0baf\u0bbe\u0bb1\u0bcd\u0bb1\u0bbf\u0baf 193 \u0b95\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bb0\u0bcd \u0b86\u0b9a\u0bbf\u0bbe\u0bbf\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0b9a\u0bcd \u0b95\u0b9a\u0baf\u0ba9\u0bcd\u0bae\u0bc1\u0b95\u0bb1\u0baf\u0bbf\u0bb2\u0bcd \u0ba4\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bb5\u0bbf\u0bb2\u0bcd\u0b95\u0bc8. \u0ba4\u0bb1\u0bcd\u0ba4\u0baa\u0bbe\u0ba4\u0bc1 45 \u0bb5\u0baf\u0b95\u0ba4 \u0b8e\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bc1\u0bb3\u0bcd\u0bb3 \u0b85\u0ba8\u0bcd\u0ba4 \u0b86\u0b9a\u0bbf\u0bbe\u0bbf\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0baa\u0bc8\u0bb0\u0bbe\u0bb2\u0bcd \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0ba4\u0bb5\u0bbf\u0b95\u0b95\u0bb3\u0baa\u0bcd \u0b95\u0baa\u0bb1\u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bbe\u0ba4 \u0ba8\u0bbf\u0b95\u0bc8\u0b95\u0bae \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. \u0b8e\u0ba9\u0ba4\u0bb5, \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbe\u0b95\u0bbe\u0ba3 \u0b95\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bb0\u0bcd \u0b86\u0b9a\u0bbf\u0bbe\u0bbf\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb0\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbf\u0baf\u0bae\u0ba9\u0bae\u0bcd \u0b95\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbf\u0bb2\u0bcd \u0b95\u0bb2\u0bcd\u0bb5\u0bbf \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bc1 \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0b95\u0b95\u0b95\u0bb3 \u0b8e\u0b9f\u0bc1\u0b95\u0bcd\u0b95 \u0ba4\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bae\u0ba9\u0b95\u0bcd \u0ba4\u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bbe\u0bb3\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0ba4\u0bb1\u0ba9\u0bcd. \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0b95\u0bcd \u0b95\u0bb2\u0bcd\u0bb5\u0bbf \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bbf\u0ba9\u0bcd \u0b95\u0b9a\u0baf\u0bc8\u0bbe\u0bb3\u0bb0\u0bbe\u0bb2\u0bcd \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b95\u0b9f\u0bbf\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0b95\u0bb2\u0bcd\u0b95\u0bc1\u0b9f\u0bbe \u0b95\u0bb2\u0bcd\u0bb5\u0bbf \u0bb5\u0bc8\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd 3 \u0b95\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bb0\u0bcd \u0b86\u0b9a\u0bbf\u0bbe\u0bbf\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd, \u0b85\u0b95\u0bcd\u0b95\u0b95\u0bb0\u0baa\u0bcd\u0baa\u0bb1\u0bcd\u0bb1\u0bc1 \u0b95\u0bb2\u0bcd\u0bb5\u0bbf \u0bb5\u0bc8\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd 3 \u0b95\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bb0\u0bcd \u0b86\u0b9a\u0bbf\u0bbe\u0bbf\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd, \u0b95\u0bb2\u0bcd\u0bae\u0bc1\u0b95\u0ba9 \u0b95\u0bb2\u0bcd\u0bb5\u0bbf \u0bb5\u0bc8\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd 2 \u0b95\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bb0\u0bcd \u0b86\u0b9a\u0bbf\u0bbe\u0bbf\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0b87\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0bbe\u0b95\u0ba4\u0bcd \u0b95\u0ba4\u0bbe\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bbe\u0bb0\u0bcd. \u0b87\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0ba8\u0bbf\u0bb0\u0ba8\u0bcd\u0ba4\u0bb0 \u0ba8\u0bbf\u0baf\u0bae\u0ba9\u0b99\u0bcd\u0b95\u0b95\u0bb3 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0b8f\u0bb1\u0bcd\u0baa\u0bbe\u0b9f\u0bc1\u0b95\u0b95\u0bb3 \u0ba4\u0bae\u0bb1\u0bcd\u0b95\u0b95\u0bbe\u0bb3\u0bcd\u0bb5\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bbe? \u0b8e\u0ba9\u0b95\u0bcd \u0ba4\u0b95\u0b9f\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0ba4\u0bb1\u0ba9\u0bcd.\n\n\u0d9c\u0dd4\u0dbb\u0dd4 \u0db4\u0dd4\u0dab\u0db4\u0dca\u0dc0\u0ddc\u0da9\u0dd4 \u0dc3\u0dd2\u0d82\u0d9b\u0dca\u200d\u0dba\u0ddc\u0dbd \u0dc3 \u0d9a\u0ddc \u0db6\u0dd0\u0db8\u0dda\u0d9a\u0dda\u0daf\u0dd3 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0d9c\u0dba\u0db1\u0ddc\u0dbd\u0d9a\u0da7 \u0dc0\u0dc3\u0dd4\u0dbd \u0d9a\u0dda \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0d9a\u0dc1 \u0dc3\u0dd0 \u0d9a\u0dd2 \u0dba\u0dd4\u0dad \u0d9c\u0dd4\u0dbb\u0dd4\u0dbd\u0dbb\u0dd4\u0db1\u0dca\u0dad \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0dca \u0dc3\u0dd2\u0d9a\u0dc0\u0dc2\u0d9a \u0db1\u0dca\u0dad\u0db8 \u0dc0\u0dbb\u0dca\u0dbd \u0db1\u0dca\u0dad\u0dad\u0dca\u200d \u0dc3\u0dc4 \u0daf\u0dd4\u0dc2\u0dc0\u0d9a\u0dab \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dc1\u0dc0\u0dbd \u0dd2 \u0d9a\u0db6\u0db1 \u0dc0\u0ddc\u0dc3\u0dbd\u0dca\u0dbd \u0da7 \u0d9a \u0ddc\u0db8\u0dd4 \u0d9a\u0dab\u0db1\u0dca\u0dad\u0db1 \u0d85\u0dc0\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2 \u0ddc\u0dbd \u0dd0\u0d9a\u0db6\u0db1\u0dbd\u0ddc. \u0dc3\u0dd2\u0d9a\u0dc0\u0dc2\u0d9a \u0db1\u0dca\u0dad\u0db8 \u0db1\u0dd0\u0d9a\u0d9f\u0db1\u0dc4\u0dd2\u0dab \u0dc0\u0dc5\u0ddc\u0d9a\u0dca \u0d8b\u0dc0\u0ddc\u0db0\u0dd2\u0db0\u0dad\u0ddc\u0dbb\u0dd2 \u0db6\u0db3\u0dbd\u0ddc \u0d9c\u0dd0\u0db1\u0dd3\u0dda \u0dc3\u0db3\u0dc4\u0ddc \u0dc0\u0dbd\u0dd2 \u0db1 \u0d9c\u0dd4\u0dbb\u0dd4 \u0db4\u0dd4\u0dab\u0db4\u0dca\u0dc0\u0ddc\u0da9\u0dd4 \u0dc3\u0dd2\u0d82\u0d9b\u0dca\u200d\u0dba\u0ddc\u0dbd \u0d9c\u0dba\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0d9a\u0dda\u0daf\u0dd3\u0dca \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0dc4\u0dd2\u0dc0 \u0dbd\u0dad\u0dca\u200d\u0ddc\u0dbd\u0d9a\u0dca\u0db8 \u0dc3\u0ddc\u0d9a\u0da0\u0dca\u0da1\u0ddc \u0d9a\u0dc5\u0ddc \u0db1\u0dd2\u0dbd\u0dd0\u0dab\u0daf\u0dd2 \u0dc3\u0dd2\u0d82\u0d9b\u0dca\u200d\u0dba\u0ddc\u0dbd \u0d91\u0dbd\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2 \u0ddc.\n\n\u0db6\u0db3\u0dbd\u0ddc \u0d9c\u0dd0\u0db1\u0dd3\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dad\u0d9a \u0db1\u0dca\u0dad \u0d9c\u0dca\u0d9a\u0dad\u0dca\u200d\u0ddc\u0dca 2007 \u0dbd\u0dc3\u0d9a\u0dab\u0db1\u0dca\u0dad \u0dc0\u0dc3\u0dd4\u0dbd \u0dc3\u0dc0\u0d9a\u0dc0\u0dca\u0da0\u0dca\u0da1\u0ddc \u0d9c\u0dd4\u0dbb\u0dd4\u0dbd\u0dbb\u0dd4 \u0d9c\u0dd4\u0dbb\u0dd4 \u0dc3\u0dc4\u0ddc \u0d9a \u0dad\u0dca\u200d\u0db1\u0dad\u0dbb\u0dd4 \u0dc3\u0db3\u0dc4\u0ddc \u0db6\u0db3\u0dbd\u0ddc \u0d9c\u0dd0\u0db1\u0dd3\u0d9a\u0dda\u0daf\u0dd3 \u0d85\u0db8\u0ddc\u0dad\u0dca\u200d\u0dba \u0db8\u0dab\u0dca\u0dad \u0dad\u0dd3\u0dab\u0dba \u0d9a\u0dca \u0db8\u0dad\u0dca\u200d \u0dc3 \u0d9a\u0ddc \u0db6\u0dd0\u0db8\u0dda\u0db8\u0d9a\u0dca \u0db1\u0dca\u0daf\u0dd4 \u0d9a\u0db1\u0ddc\u0dc0\u0dd6 \u0db6\u0dbd \u0d85\u0db4\u0dd2 \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dc5\u0ddc. \u0d89\u0db1\u0dca\u0dad \u0d85\u0db1\u0dad\u0dbb\u0dd4\u0dbd \u0db8\u0da7 \u0db8\u0dad\u0dca\u200d\u0d9a \u0dc3\u0dd2\u0db0\u0dd2 \u0da7 2010 \u0dbd\u0dc3\u0d9a\u0dbb\u0dca\u0dbd\u0daf\u0dd3 \u0dbd\u0dad \u0dc0\u0ddc\u0dc3\u0dbd\u0dca\u0dbd \u0d9c\u0dd4\u0dbb\u0dd4 \u0dc3\u0dc4\u0ddc \u0d9a \u0dad\u0dca\u200d\u0db1\u0dad\u0dbb\u0dd4 \u0dc3\u0db3\u0dc4\u0ddc \u0db6\u0db3\u0dbd\u0ddc \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dd2 \u0dd0\u0db6\u0dd4\u0dba\u0ddc. \u0db1\u0db8\u0dd4\u0dca \u0d89\u0db1\u0dca\u0dad \u0dc0\u0dc3\u0dd4\u0dbd \u0d91\u0db8 \u0d9c\u0dd4\u0dbb\u0dd4 \u0dc3\u0dc4\u0ddc \u0d9a \u0dad\u0dca\u200d\u0db1\u0dad\u0dab \u0dc3\u0db3\u0dc4\u0ddc \u0dd0\u0db6\u0dd4\u0dab\u0dd4 \u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dd2 \u0da7 \u0d91\u0d9a\u0dab\u0dc4\u0dd2\u0dbd \u0dbb\u0dd2\u0dca \u0d86\u0da5\u0ddc\u0dbd\u0d9a\u0dca \u0d9a\u0dbd\u0db1\u0dd4\u0d9a\u0dbd\u0db1\u0dca\u0dad \u0d9a\u0dc0\u0dca\u0dc3\u0db8\u0d9a\u0dca \u0d9a\u0d9c\u0ddc\u0db1\u0dd4 \u0d9a\u0d9a\u0dbb\u0dd4\u0dba\u0ddc. \u0d85\u0db4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dc0\u0dca\u0dd2 \u0d9a\u0dca \u0dc3\u0dd2\u0db0\u0dd2 \u0da7 \u0d9c\u0dd4\u0dbb\u0dd4 \u0d9a\u0dc3\u0dc0\u0dbd\u0ddc \u0dbd\u0dba\u0dbd\u0dc3\u0dc0\u0dae\u0ddc\u0dbd \u0d8b\u0dbd\u0dca \u0dd2\u0d82\u0d9d\u0db1 \u0d9a\u0db1\u0ddc\u0d9a\u0dab\u0db8\u0dd2\u0dc3\u0db8\u0db1\u0dca\u0dad \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d9c\u0dd4\u0dbb\u0dd4 \u0d9a\u0dc3\u0dc0\u0dbd\u0ddc\u0dbd \u0dc3\u0db3\u0dc4\u0ddc \u0d9c\u0dd4\u0dbb\u0dd4\u0dbd\u0dbb\u0dd4\u0db1\u0dca\u0dad \u0db6\u0db3\u0dbd\u0ddc \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0db1\u0dca\u0daf\u0dd4 \u0d9a\u0dab\u0db1\u0dca\u0dad\u0d9a\u0db1\u0dca\u0dad. \u0db1\u0db8\u0dd4\u0dca \u0d85\u0db4\u0dd2 \u0dd9\u0db1\u0dca\u0dad\u0db1\u0dbd\u0ddc \u0d9a\u0db8\u0dad\u0db8\u0ddc \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dab\u0db1 \u0d86\u0d9a\u0ddc\u0dab \u0da7 \u0dc3\u0dc0\u0d9a\u0dc0\u0dca\u0da0\u0dca\u0da1\u0ddc\u0d9a\u0dbd\u0db1\u0dca\u0dad \u0dda\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0ddc\u0dba \u0d9a\u0dca \u0d89\u0db1\u0dca\u0dad\u0db1\u0dbd\u0ddc \u0d9a\u0dd2 \u0ddc. \u0db1\u0db8\u0dd4\u0dca 2007\u0daf\u0dd3 \u0daf\u0dd4\u0db1\u0dca\u0dad \u0d91\u0db8 \u0dad\u0dd3\u0dab\u0dba \u0db8\u0dad\u0dca\u200d \u0dc3\u0dc0\u0d9a\u0dc0\u0dca\u0da0\u0dca\u0da1\u0ddc \u0d9c\u0dd4\u0dbb\u0dd4 \u0d9a\u0dc3\u0dc0\u0dbd \u0dc3\u0db3\u0dc4\u0ddc \u0d9c\u0dd4\u0dbb\u0dd4\u0dbd\u0dbb\u0dd4\u0db1\u0dca\u0dad \u0dad\u0dca\u200d\u0db6\u0ddc \u0d9c\u0dd0\u0db1\u0dd3\u0d9a\u0dda \u0dc4\u0dd0\u0d9a\u0dd2 \u0ddc\u0dbd\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dc4\u0dbd\u0dca\u0dc0\u0dd2 \u0dbd\u0dbb\u0dd4\u0db1\u0dca\u0dad\u0da7 \u0db1\u0dd0\u0dc4\u0dd0. \u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0ddc\u0db1\u0ddc \u0d9a\u0dad\u0db8\u0db1\u0dd2 \u0d85\u0db4\u0dd2 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0d9a\u0da9\u0daf\u0dd3 \u0d9a\u0d9a\u0ddc\u0d9a\u0dc4\u0ddc\u0db8\u0dd9 \u0d9a\u0dda \u0d9a\u0da7\u0dba\u0dd4\u0dad \u0db1\u0dca\u0daf\u0dd4 \u0d9a\u0dab\u0db1\u0dca\u0dad\u0d9a\u0db1\u0dca\u0dad \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dad\u0d9a \u0db1\u0dca\u0dad \u0dc3\u0ddc\u0d9a\u0da0\u0dca\u0da1\u0ddc \u0dc0\u0dbd\u0dca\u0dbd\u0db8\u0dd2\u0dc3\u0db8\u0db1\u0dca\u0dad \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d9a\u0dda \u0dbd\u0db1 \u0dc3\u0dd2\u0da7 \u0d89\u0db1\u0dca\u0dad\u0d9a\u0db1\u0dca\u0dad."
  },
