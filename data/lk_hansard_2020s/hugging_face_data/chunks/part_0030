\u0d9a, \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82\n\n\u0dc0\u0dd2\u0daf\u0dba\u0dcf \u0dc4\u0dc3\u0dcf \u0dad\u0dcf\u0d9a\u0dca\u0dc2\u0d85 \u0d9a\u0dbd\u0dba\u0dd4\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0da2\u0dcf\u0dad\u0dba\u0dcf\u0dcf\u0dc1 \u0d8b\u0dba \u0d8b\u0db4\u0db1\u0dda\u0dc1\u0d9a \u0d9a\u0dcf\u0dba\u0d9a \u0dca\u0db7\u0dcf\u0dc0\n\n\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82(\u0db8\u0dc4\u0d9a\u0da0\u0d9a\u0dbb\u0dca ) \u0dbd\u0d82\u200d\u0dbb\u0dd2\u0dc2\u0dca\u0da8\u0d9a\u0dca \u0dbd\u0d82\u0d85\u0da7\u0dda\u0da7\u0dc3\u0dca\u0dda\u0dca \u0dbd\u0d82\u0db8\u0dc4 \u0d9a \u0dbd\u0d82(\u0dc3\u0dca\u0dc0\u0d9a\u0dad\u0dad\u0dd2), \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0dbb\u0dbb\u0dca.\u0d91\u0db4\u0dad. \u0dbd\u0d82\u0dca\u200d \u0dcf\u0dbb\u0dca\u0db0\u0dca \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82(\u0da9\u0dcf\u0dba\u0dba) \u0dbd\u0d82\u0dc4\u0dcf\u0dc3\u0dca \u0dbd\u0d82\u0dc0\u0dd2\u0da7\u0dda\u0db8\u0dd4\u0dab\u0dd2 \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\n\n\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0d91\u0dba\u0dcf\u0d9c \u0dbd\u0d82\u0dc0\u0dd3\u0dba\u0dba \u0d9a\u0dca \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82(\u0da9\u0dcf\u0dba\u0dba) \u0dbd\u0d82\u0dca\u0d9a\u0db8\u0dbd\u0dca \u0dbd\u0d82\u0dc3\u0dd4\u0dba\u0dbb\u0dca\u0dc1\u0dcf\u0db1\u0dca \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0d85\u0da7\u0dc3\u0dca\u0ddd \u0dbd\u0d82\u0dc3\u0dca\u0dd4\u0db8\u0dbd\u0dca \u0dbd\u0d82\u0dba\u0dca \u0dcf\u0d9a \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0db1\u0d9a\u0dca\u0db8\u0dd4 \u0d9a\u0dd4 \u0dbd\u0d82\u0dc1\u0dca\u200d\u0dbb\u0dd3\u0da7\u0dca \u0dc3\u0dca\u0dca \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82(\u0da9\u0dcf\u0dba\u0dba) \u0dbd\u0d82\u0dd2\u0dc4\u0d9a\u0dbd\u0dca \u0dbd\u0d82\u0d85\u0da7\u0dda\u0dc3\u0dcf\u0dc4 \u0dbd\u0d82\u0db8\u0dc4 \u0d9a,\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82(\u0da9\u0dcf\u0dba\u0dba) \u0dbd\u0d82\u0dba\u0d9a\u0db8\u0dca\u0d9a\u0dba\u0dca \u0dbd\u0d82\u0d85\u0dbb\u0dca\u0da0\u0dca\u0da0\u0dd4\u0dca\u0d9a \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0d85\u0dbb\u0dca \u0db4\u0dad \u0dbd\u0d82\u0d89\u0dbd\u0dca \u0d9a\u0dc3\u0dca\u0dda \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0dcf\u0dc3\u0dca\u0dca \u0dbd\u0d82\u0dd4\u0dc2\u0dca\u0da8\u0dda\u0dad \u0dbd\u0d82\u0dd4\u0dbb\u0db8\u0d9a\u0dba \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0d9a\u0dc3 \u0d9a \u0dbd\u0d82\u0dc0\u0d9a\u0dc2\u0dca\u0da8\u0dda \u0dbd\u0d82\u0d9c\u0db8\u0da7\u0dda \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0da0\u0dd4\u0dba \u0dbd\u0d82\u0d9c\u0d9a\u0db4\u0dca\u0db4\u0dad \u0d9a\u0dad\u0dd2 \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0d85\u0da7\u0dc1\u0dcf\u0db1\u0ddd \u0dbd\u0d82\u0d9c\u0dd4\u0dda\u0da7\u0dc3\u0dca\u0dda\u0dca \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0dc3\u0dca\u0dda\u0da7\u0da7\u0dd2\u0dd2 \u0dbd\u0d82\u0db4\u0dca\u200d\u0dbb\u0dca\u0d9a\u0dca \u0daf\u0dd4 \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0d85\u0db8\u0dd2\u0d9a \u0dbd\u0d82\u0db4\u0dca\u200d\u0dbb\u0dc3\u0dca\u0d9a\u0daf\u0dca \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0dba\u0dc0\u0dd3\u0dca \u0dbb \u0dbd\u0d82\u0db6\u0da9\u0dcf\u0ddb\u0d9a\u0dba \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82(\u0da9\u0dcf\u0dba\u0dba) \u0dbd\u0d82\u0dc3\u0dca\u0db3\u0dbb\u0dd4\u0dcf\u0dca \u0dbd\u0d82\u0db8\u0dba\u0dba\u0dc3\u0dcf\u0dc4 \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0dbb\u0dd4\u0dcf\u0dca \u0dbd\u0d82\u0db8\u0d9a\u0dad\u0d9a\u0d9c\u0db8 \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82 \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0dc3\u0dd4\u0dd2\u0dbd\u0dca \u0dbd\u0d82\u0dba \u0d9a\u0dca\u0dc3\u0dbb\u0dd2 \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0dc4\u0dc3\u0dca\u0d9a\u0dba\u0d9a \u0dbd\u0d82\u0dd2 \u0dca\u0da7\u0dda \u0dbd\u0d82\u0db8\u0dc4 \u0d9a\u0db8\u0dd2 , \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82(\u0da9\u0dcf\u0dba\u0dba) \u0dbd\u0d82\u0dd2\u0dc1\u0dcf\u0db1\u0d9a\u0dca \u0dbd\u0d82\u0dc3\u0dca\u0db8\u0dba\u0dc0\u0dd3\u0dba \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 (\u0da9\u0dcf\u0dba\u0dba) \u0dbd\u0d82\u0dca\u200d\u0dca \u0dbd\u0d82\u0da7\u0dc3\u0dca\u0dda\u0dca\u0d9a\u0dba \u0d9a\u0dca \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0dc0\u0d9a\u0d9c\u0dba \u0dbd\u0d82\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0da7\u0dc4\u0dda\u0dba \u0d9a \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82 \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0dbb\u0dbb\u0dca.\u0d91\u0db4\u0dad. \u0dbd\u0d82\u0dc3\u0dca\u0db8\u0dca \u0dbd\u0d82\u0dba\u0dda\u0dc3\u0dcf\u0dc4 \u0dbd\u0d82\u0db8\u0dc4 \u0d9a\n\n\u0da2\u0dc4\u0dc3\u0da2\u0db1 \u0d86\u0dba\u0d9a\u0dca\u0dc2\u0d9a \u0dca\u0dc4\u0dc3 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0db1\u0db8\u0dca\u0dca\u0dd4 \u0d9a\u0dbd\u0dba\u0dd4\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0da2\u0dcf\u0dad\u0dba\u0dcf\u0dcf\u0dc1 \u0d8b\u0dba \u0d8b\u0db4\u0db1\u0dda\u0dc1\u0d9a \u0d9a\u0dcf\u0dba\u0d9a \u0dca\u0db7\u0dcf\u0dc0\n\n\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0dbb\u0dca\u0dca \u0dba \u0dbd\u0d82\u0dc0\u0dd2\u0da7\u0dda\u0dad\u0d9a\u0d9a \u0dbd\u0d82\u0db8\u0dc4 \u0d9a \u0dbd\u0d82(\u0dc3\u0dca\u0dc0\u0d9a\u0dad\u0dad\u0dd2), \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0dc3\u0dd4\u0dd2\u0dbd\u0dca \u0dbd\u0d82\u0dcf\u0da7\u0d9c\u0d9a \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0dba \u0d9a\u0dca \u0dbd\u0d82\u0d9c\u0db8 \u0dbd\u0d82\u0da7\u0dda \u0dbd\u0d82\u0db8\u0dc4 \u0d9a, \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0da7\u0db4\u0dad\u0dca\u200d\u0dbb\u0dca \u0dbd\u0d82\u0da7\u0dca\u200d\u0dca\u0dba\u0d9a\u0dbd\u0dca \u0dbd\u0d82(\u0dc0\u0dd2\u0dbb\u0d9a\u0db8\u0dd2 ) \u0dbd\u0d82"
