    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7 \u0db8\u0db8 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dc0\u0dca \u0d9a\u0dab\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dd2 \u0dba\u0dd2 \u0d85\u0d9a\u0db4\u0dca \u0dc3\u0dd2\u0d9a\u0dc1\u0dc0 \u0dba \u0d9a\u0dc3\u0dc0\u0dbd\u0ddc\u0d9a\u0dab\u0dba \u0dc4\u0ddc \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dad \u0dd9\u0dca\u0dad\u0dca\u200d. 2025 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0d9a\u0dc1 \u0dc3\u0dd2\u0d9a\u0dc1\u0dba \u0dba \u0d9a\u0dc3\u0dc0\u0dbd\u0ddc\u0d9a\u0dab\u0dba \u0d9a\u0dad\u0ddc \u0dbb\u0dca\u0dbd \u0db8\u0dd2\u0dc3\u0db8\u0dd2 \u0db1 3 707\u0d9a\u0dca \u0dc0\u0dd4\u0dba\u0ddc. 2026 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0d9a\u0dc1 \u0d91\u0db8 \u0db4\u0dca\u200d\u0dbb\u0db8\u0ddc\u0dba \u0d9a\u0dad\u0ddc \u0dbb\u0dca\u0dbd \u0db8\u0dd2\u0dc3\u0db8\u0dd2 \u0db1 3 501\u0d9a\u0dca \u0dbd\u0db1\u0dbd\u0ddc. 2027\u0daf\u0dd3 \u0d85\u0d9a\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0ddc \u0d9a\u0dab\u0db1\u0dbd\u0ddc \u0d9a\u0dad\u0ddc \u0dbb\u0dca\u0dbd \u0db8\u0dd2\u0dc3\u0db8\u0dd2 \u0db1 2 086\u0d9a\u0dca. 2028\u0daf\u0dd3 \u0d85\u0d9a\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0ddc \u0d9a\u0dab\u0db1\u0dbd\u0ddc \u0d9a\u0dad\u0ddc \u0dbb\u0dca\u0dbd \u0db8\u0dd2\u0dc3\u0db8\u0dd2 \u0db1 3 574\u0d9a\u0dca. \u0d9a\u0dda \u0dba \u0d9a\u0dc3\u0dc0\u0dbd\u0ddc\u0d9a\u0dab\u0dba \u0d9a\u0ddc\u0dbb\u0dca\u0dbd \u0dc3\u0db3\u0dc4\u0ddc \u0d85\u0dc0\u0da7 \u0db8\u0dd4\u0dd9\u0dbd\u0dca \u0d85\u0dbd\u0dc0\u0dba\u0dba\u0dd2. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d9a\u0dda \u0dbd\u0db1\u0d9a\u0d9a\u0ddc\u0da7\u0dca \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0d9a\u0dc5\u0db8\u0db1\u0ddc\u0d9a\u0dab\u0dba \u0dad\u0dc5\u0dd2\u0db1\u0dca\u0dad \u0d9a\u0dda \u0dba \u0d9a\u0dc3\u0dc0\u0dbd\u0ddc\u0d9a\u0dab\u0dba \u0d9a\u0da7\u0dba\u0dd4\u0dad \u0dc3\u0ddc\u0dbb\u0dca\u0dbd\u0dae\u0d9a\u0dbd \u0d85\u0dbd\u0dc3\u0db1\u0dca\u0dad \u0d9a\u0dab\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0db1\u0dca\u0dad \u0d9a\u0dd2 \u0db1 \u0db4\u0dd4\u0d9a\u0dab\u0ddd\u0d9a\u0dae\u0db1 \u0d9a\u0da7 \u0d85\u0db4\u0dd2 \u0dc3\u0dc3\u0dd2\u0dca \u0dd2 \u0d9a\u0db6\u0db1\u0dbd\u0ddc. \u0d85\u0db4\u0dd2 \u0dc4\u0dd2\u0dad\u0dca\u200d\u0db1\u0dbd\u0ddc \u0d92\u0d9a \u0d85\u0d9a\u0db4\u0dca \u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dba \u0d9a\u0dca \u0d9a\u0dd2 \u0ddc. \u0d91\u0d9a\u0dc4\u0db8 \u0db1\u0dda \u0dab\u0dbd \u0dc4\u0dd0\u0da7\u0dd2 \u0da7 \u0d85\u0dc0 \u0d9a\u0dda \u0dab\u0d9a\u0dca \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0d9a\u0dc5\u0db8\u0db1\u0ddc\u0d9a\u0dab\u0dba \u0d9a\u0dab \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dda \u0dc4\u0dc0\u0dca \u0db8\u0dca\u0da7\u0db8\u0d9a\u0da7 \u0d9a\u0d9c\u0db1\u0dd0\u0dc3\u0dd2\u0dca \u0dd2 \u0d9a\u0db6\u0db1 \u0db6\u0dbd \u0d9a\u0dda \u0d85\u0dbd\u0dc3\u0dc0\u0dae\u0ddc\u0d9a\u0dc0\u0dca \u0d85\u0dc0\u0da7 \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dab\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0db1\u0dca\u0dad.\n\n\u0d8a\u0dc5\u0d9f\u0da7 \u0d9a\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0d9a\u0dca\u0d9a\u0dc2\u0dc0\u0dad\u0dca\u200d\u0dbb \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dbd \u0dc3 \u0d9a\u0ddc \u0db6\u0dd0\u0dbd\u0dd4\u0d9a\u0dbd\u0ddc\u0dca 2024 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0d9a\u0dc1 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0db1 410\u0d9a\u0dca \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0d9a\u0dbd\u0db1\u0dca\u0dad \u0d9a\u0dab \u0ddc \u0dd2 \u0db6\u0dd4\u0d9a\u0dab\u0dca. \u0d8a\u0da7 \u0dc0\u0dc3\u0dd4\u0dbd \u0d9a\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0d9a\u0dca\u0d9a\u0dc2\u0dc0\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dbd\u0db1\u0dd4\u0d9a\u0dbd\u0db1\u0dca\u0dad \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0db1 604\u0d9a\u0dca \u0dc3\u0dc4 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0db1 554\u0d9a\u0dca \u0d9a\u0dbd\u0db1\u0dca\u0dad \u0d9a\u0dc5\u0ddc. 2027 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0d9a\u0dc1\u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0d9a \u0ddd\u0dbd\u0db1\u0ddc \u0d9a\u0dab\u0db1\u0dbd\u0ddc \u0d9a\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0d9a\u0dca\u0d9a\u0dc2\u0dc0\u0dad\u0dca\u200d\u0dbb \u0da7 \u0d9a\u0dbd\u0db1\u0dca\u0dad \u0d9a\u0dab\u0db4\u0dd4 \u0dc3\u0dd2\u0dc0\u0ddc \u0db8 \u0db8\u0dd4\u0dd9 \u0dbd\u0dc0\u0d9a \u0db1\u0dca\u0dad \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0db1 710\u0d9a\u0dca \u0d9a\u0dbd\u0db1\u0dca\u0dad \u0d9a\u0dab\u0db1\u0dca\u0dad\u0db1.\n\n\u0db4\u0dca\u200d\u0dbb\u0dbd\u0ddc\u0dc4\u0db1 \u0d9a\u0dbd\u0db1\u0dd4\u0d9a\u0dbd\u0db1\u0dca\u0dad \u0d9c\u0dca\u0d9a\u0dad\u0dca\u200d\u0ddc\u0dca 2024 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0d9a\u0dc1 \u0d9a\u0dbd\u0db1\u0dca\u0dad \u0d9a\u0dab \u0dd2 \u0db6\u0dd4\u0d9a\u0dab\u0dca \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0db1 404\u0dba\u0dd2. 2025\u0daf\u0dd3 \u0d92\u0d9a \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0db1 473\u0d9a\u0dca \u0dc0\u0dd4\u0dba\u0ddc. 2026\u0daf\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0db1 455\u0d9a\u0dca \u0dc0\u0dd4\u0dba\u0ddc. 2027\u0daf\u0dd3 \u0dc3\u0dd2 \u0dd9\u0dda \u0d9a\u0dab\u0db1\u0dca\u0dad\u0db1 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0db1 458\u0d9a\u0dca \u0d9a\u0dbd\u0db1\u0dca\u0dad \u0d9a\u0dab \u0dd2 \u0d9a\u0db6\u0db1\u0dbd\u0ddc.\n\n\u0d9a\u0dca\u0dd2 \u0d9a\u0dbb\u0dca\u0dbd\u0db8\u0ddc\u0db1\u0dca\u0dad\u0dad\u0dca\u200d \u0d9c\u0dca\u0d9a\u0dad\u0dca\u200d\u0ddc\u0dca 2024 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0d9a\u0dc1 \u0d9a\u0dbd\u0db1\u0dca\u0dad \u0d9a\u0dab \u0dd2 \u0db6\u0dd4\u0dab\u0dd4 \u0db8\u0dd4\u0dd9 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0db1 100\u0dba\u0dd2. \u0d92\u0d9a 2025\u0daf\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0db1 208\u0d9a\u0dca \u0db6\u0dbd\u0da7 \u0dc0\u0dca \u0dc0\u0dd4\u0dba\u0ddc. 2026\u0daf\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0db1 221\u0d9a\u0dca \u0db6\u0dbd\u0da7 \u0dc0\u0dca \u0dc0\u0dd4\u0dba\u0ddc. 2027\u0daf\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2 \u0dbd\u0dca \u0db6\u0dd2\u0dd2 \u0db1 273\u0d9a\u0dca \u0db6\u0dbd\u0da7 \u0dc0\u0dca \u0d9a\u0dbd\u0db1\u0dbd\u0ddc.\n\n\u0dc0\u0dc3\u0dd4\u0d9a \u0dbd\u0dbb\u0dca\u0dbd\u0dc2 \u0d9a\u0dd2\u0dc4\u0dd2\u0dc0 \u0dca \u0d91\u0d9a\u0dca\u0d9a -\u0db8\u0dd1\u0dad\u0dca\u200d \u0d89\u0dd2 \u0dc4\u0ddc\u0dc3 \u0dca \u0d91\u0d9a\u0dca\u0d9a- \u0dc3\u0dd2\u0d82\u0dc3\u0db1\u0dca\u0dad\u0dd9\u0db1 \u0d9a\u0dab \u0db6 \u0db1 \u0d9a\u0d9a\u0ddc\u0da7 2027 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc1\u0dd9 \u0d85\u0dc0 \u0d9a\u0dda \u0dc4\u0dd0\u0db8 \u0d9a\u0dca\u0d9a\u0dc2\u0dc0\u0dad\u0dca\u200d\u0dbb \u0d9a\u0db8 \u0dbd \u0d9c\u0dca\u200d\u0dbb\u0ddc\u0dc4\u0dd3 \u0d89 \u0d9a\u0dca\u0d9a \u0d9a\u0dbd\u0db1\u0dd4\u0d9a\u0dbd\u0db1\u0dca\u0dad \u0db8\u0dd4\u0dd9\u0dbd\u0dca \u0d9a\u0dbd\u0db1\u0dca\u0dad \u0d9a\u0dab \u0dd2 \u0d9a\u0db6\u0db1\u0dbd\u0ddc \u0d9a\u0dd2 \u0db1 \u0d9a\u0ddc\u0dab\u0dba\u0ddc\u0dbd \u0db8\u0db8 \u0dc3\u0dd2\u0d9a\u0dc0\u0dc2\u0d9a \u0db1\u0dca\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dab\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dd2 \u0dba\u0dd2.\n\n\u0d92 \u0dbd\u0ddc\u0d9a \u0db8 \u0d85\u0db4\u0dd2 \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dad \u0d9a\u0dc5\u0ddc \u0db6 \u0dc0\u0d9a\u0dca\u0dd2 \u0d9a\u0dbd\u0d9a\u0dc5\u0db3 \u0d9a\u0dc0\u0ddc\u0d9a\u0dc5\u0dc0 \u0dc3\u0dc0\u0dae\u0ddc\u0dbd\u0dab\u0dcf\u0ddc\u0dbd \u0dc3\u0dc4 \u0d85\u0d9b\u0dca\u200d\u0dab\u0dca\u0dad\u0dcf\u0ddc\u0dbd \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dad\u0d9a \u0db1\u0dca\u0dad. \u0d85\u0db4\u0dd2 \u0dd9\u0db1\u0dca\u0dad\u0db1\u0dbd\u0ddc \u0d85\u0dc0\u0da7 \u0dc3\u0dd2\u0dc0\u0ddc \u0dad\u0dca\u200d\u0dbb\u0dca\u0dbd\u0dbd\u0db1 \u0d9a\u0dca \u0dd2 \u0d9a\u0db6\u0db1 \u0db6\u0dbd. \u0dc0\u0dc3\u0dd4\u0d9a \u0d9a\u0ddc \u0d9a\u0da9 \u0dd0\u0db6\u0dd4\u0dab\u0dd4 \u0d85\u0dca\u0dd9\u0dd0\u0d9a\u0dd3\u0dda \u0d91\u0d9a\u0dca\u0d9a \u0d85\u0dc0\u0da7 \u0d9a\u0dc0\u0db1\u0dd4\u0dab\u0dd4 \u0d9a\u0dd9 \u0d9a\u0dca \u0dad\u0dca\u200d\u0db8\u0dba\u0dd2 \u0db6 \u0dc0\u0d9a\u0dca\u0dd2 \u0d9a\u0dbd\u0db1\u0dd4\u0d9a\u0dbd\u0db1\u0dca\u0dad \u0d9b\u0dca\u200d\u0db1\u0dd2\u0dbd \u0d9a\u0dad\u0dca\u200d\u0dbd\u0dca \u0dc3\u0dc4 \u0d9c\u0dbd\u0dca \u0d85\u0d9f\u0dd4\u0dbb\u0dd4 \u0db8\u0dad\u0dca\u200d \u0dc0\u0db8\u0dba\u0d9a\u0dca \u0dd0\u0d9a\u0dc0\u0db1\u0dca\u0dad\u0db1\u0da7 \u0db1\u0dca\u0daf\u0dd4 \u0dd3\u0d9a\u0dda \u0dc3\u0dd2\u0dc0\u0ddc \u0d85\u0dbd\u0dd9\u0ddc\u0db1\u0db8\u0d9a\u0dca \u0dd2 \u0d9a\u0db6\u0db1\u0dbd\u0ddc \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a. \u0d92 \u0db1\u0dd2\u0dc3\u0ddc \u0d85\u0db4\u0dd2 \u0dad\u0dd3\u0db1\u0dca\u0dad\u0daf\u0dd4\u0dbd\u0d9a\u0dca \u0d9a\u0d9c\u0db1 \u0dd2 \u0d9a\u0db6\u0db1\u0dbd\u0ddc \u0db4\u0dd4\u0db1\u0dbb\u0dca\u0dbd\u0dbd\u0db1\u0db1\u0dd3 \u0db6 \u0dc0\u0d9a\u0dca\u0dd2 \u0dbd\u0dbb\u0dca\u0dbd\u0db0\u0dad\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0dd0\u0dca\u0d9a\u0dad\u0dca\u200d\u0db1\u0dca\u0dad \u0d92 \u0d9a\u0dca\u0d9a\u0dc2\u0dc0\u0dad\u0dca\u200d\u0dbb \u0da7 \u0dbd\u0dd0\u0da9\u0dd2 \u0db8\u0dd4\u0dd9\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0ddc\u0dba \u0d9a\u0dca \u0d9a \u0ddc\u0dd9\u0dbd\u0db1\u0dca\u0dad\u0db1."
