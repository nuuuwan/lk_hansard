\u0da7 \u0dca \u0dbd\u0d82\u0da7\u0dc4\u0ddd \u0dbd\u0d82\u0d85\u0db8\u0dda\u0dc0\u0dd0\u0dd4\u0dc5\u0db8 \u0dbd\u0d82\u0da7\u0dbd\u0dcf\u0d9b\u0dca\u200d\u0dca\u0da7 \u0dca \u0dbd\u0d82\u0dd2\u0dc0 \u0d9a \u0dbd\u0d82 \u0dba\u0dca \u0dbd\u0d82\u0d9a\u0dba \u0dbd\u0d82\u0db8\u0dcf\u0d9b\u0dca\u200d\u0dba\u0d9a\u0dc0 \u0dbd\u0d82\u0d8a\u0db4 \u0dbd\u0d82\u0d87\u0dd4\u0dc5 \u0d9a \u0dbd\u0d82\u0da7\u0dca\u0d9a\u0da7 \u0da7\u0dca.\n\n(iv) \u0dba\u0dd0\u0dca\u0db4 \u0dbd\u0d82\u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0dbd\u0d82\u0d85\u0dc0\u0db8\u0dda\u0dcf\u0d9a \u0dbd\u0d82\u0db8\u0dcf\u0d9b\u0dca\u200d\u0dba\u0d9a\u0dc0\u0dca \u0dbd\u0d82\u0dc4\u0db1\u0dcf\u0dca\u0d9a\u0da7\u0d9c\u0dca \u0dbd\u0d82\u0da7\u0dca\u0d9a\u0db8\u0dd0\u0dad\u0dd2 \u0dbd\u0d82\u0d85 \u0dba, \u0dbd\u0d82\u0da7 \u0d9a\u0dba\u0dd4\u0dbb\u0dd4 \u0dbd\u0d82 \u0dcf\u0d9a\u0dc0 \u0d9a \u0dbd\u0d82\u0dd2\u0dbb\u0dd3\u0db8\u0da7\u0db8\u0dca \u0dbd\u0d82\u0d85\u0dca\u0dd4\u0dbb\u0dd4\u0dc0 \u0dbd\u0d82 \u0dba\u0db1\u0dd4 \u0dbd\u0d82\u0d9a\u0db6\u0dca \u0dbd\u0d82\u0dc0\u0dd2\u0d9c\u0da7\u0dca \u0dbd\u0d82\u0dc0\u0dd2\u0db8\u0dd4\u0dc5\u0db8\u0dd2\u0dbb\u0dca \u0dbd\u0d82\u0dad\u0dd4\u0dc5\u0dc0 \u0dbd\u0d82\u0dd2\u0dc4 \u0dbd\u0d82\u0db8\u0dcf\u0d9b\u0dca\u200d\u0dba\u0d9a\u0dc0 \u0dbd\u0d82\u0db1\u0dd2\u0dc0\u0dd0\u0dba\u0daf\u0dd2\u0dc0 \u0dbd\u0d82\u0dba\u0dd0\u0dca\u0dc0\u0dd2 \u0dbd\u0d82\u0dc4\u0dd0\u0dd2\u0dbb .\n\n(v) \u0dba\u0dd0\u0dca\u0db4 \u0dbd\u0d82\u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0dbd\u0d82\u0d85\u0dc0\u0db8\u0dda\u0dcf\u0d9a \u0dbd\u0d82\u0db8\u0dcf\u0d9b\u0dca\u200d\u0dba\u0d9a\u0dc0\u0dca \u0dbd\u0d82\u0dc4\u0db1\u0dcf\u0dca\u0d9a\u0da7\u0d9c\u0dca \u0dbd\u0d82\u0da7\u0dca\u0d9a\u0db8\u0dd0\u0dad\u0dd2 \u0dbd\u0d82\u0d85 \u0dba, \u0dbd\u0d82\u0da7 \u0d9a\u0dba\u0dd4\u0dbb\u0dd4 \u0dbd\u0d82 \u0dcf\u0d9a\u0dc0 \u0d9a \u0dbd\u0d82\u0dd2\u0dbb\u0dd3\u0db8\u0da7\u0db8\u0dca \u0dbd\u0d82\u0d85\u0dca\u0dd4\u0dbb\u0dd4\u0dc0 \u0dbd\u0d82 \u0dba\u0db1\u0dd4 \u0dbd\u0d82\u0d9a\u0db6\u0dca \u0dbd\u0d82\u0dc0\u0dd2\u0d9c\u0da7\u0dca \u0dbd\u0d82\u0dc0\u0dd2\u0db8\u0dd4\u0dc5\u0db8\u0dd2\u0dbb\u0dca \u0dbd\u0d82\u0dad\u0dd4\u0dc5\u0dc0 \u0dbd\u0d82\u0dd2\u0dc4 \u0dbd\u0d82\u0db8\u0dcf\u0d9b\u0dca\u200d\u0dba\u0d9a\u0dc0 \u0dbd\u0d82\u0db1\u0dd2\u0dc0\u0dd0\u0dba\u0daf\u0dd2\u0dc0 \u0dbd\u0d82\u0dba\u0dd0\u0dca\u0dc0\u0dd2 \u0dbd\u0d82\u0dc4\u0dd0\u0dd2\u0dbb ."
