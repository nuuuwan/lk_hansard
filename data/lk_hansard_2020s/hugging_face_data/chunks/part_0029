    "chunk_text": "\u0da7\u0db8\u0dd4\u0db8\u0dca \u0d9a\u0d9a \u0dbd\u0d82\u0dbb\u0dab\u0dca\u0da9\u0dd4 \u0dbd\u0d82\u0db6\u0d9a \u0dbd\u0d82\u0d9c\u0dca \u0dca \u0dbd\u0d82 \u0dd2\u0dca \u0dbd\u0d82\u0da7\u0db8\u0d9a \u0dca\u0dba \u0dbd\u0d82\u0dd2\u0dbb\u0dda\u0da7\u0dda? \u0dbd\u0d82\u0dbb\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0db4 \u0dbd\u0d82\u0d91\u0dca \u0dca \u0dbd\u0d82 \u0dd2\u0dca \u0dbd\u0d82\u0da7\u0db8\u0dd4\u0db8\u0dca \u0d9a\u0d9a \u0dbd\u0d82\u0db8\u0dda\u0da7 \u0db4\u0dda\u0dc0\u0d9a \u0dbd\u0d82\u0dca\u0dd0\u0d9c\u0d9a\u0d9a \u0dbd\u0d82\u0dd2\u0dbb\u0dda\u0dc0\u0d9a, \u0dbd\u0d82\u0dc1\u0da7 \u0dbd\u0d82\u0d8b\u0d9c\u0dd4\u0da7\u0dbd\u0dcf \u0dbd\u0d82\u0dc4\u0dd2\u0dba \u0dbd\u0d82\u0da7\u0dc0\u0d9a\u0d9a \u0dbd\u0d82\u0dd2\u0dca \u0dca \u0dbd\u0d82\u0d9a\u0dd4\u0da9\u0d9a \u0dbd\u0d82\u0dc4\u0d9a \u0dbd\u0d82\u0db8\u0db0\u0dba \u0dbd\u0d82\u0dad\u0dd2\u0db8\u0db8\u0d9a\u0da7\u0da7\u0dda \u0dbd\u0d82\u0dc0\u0dba\u0d9a\u0dad\u0d9a\u0dd2\u0db8 \u0dca \u0db4 \u0dbd\u0d82\u0d85\u0db4\u0dd2 \u0dbd\u0d82\u0db8\u0dc4\u0dca \u0dbd\u0d82\u0da7\u0dba\u0dca\u0dc0\u0d9a. \u0dbd\u0d82\u0d85\u0db4\u0dd2 \u0dbd\u0d82\u0dad\u0dba\u0d9a\u0da7 \u0db4 \u0dbd\u0d82\u0db1\u0dd3\u0dad\u0dd2 \u0dbd\u0d82\u0d85\u0dc0\u0d9a\u0dcf\u0d9c\u0dd4 \u0dbd\u0d82 \u0dba\u0dca\u0dc0\u0d9a\u0dc1 \u0dbd\u0d82\u0dd2\u0dbb \u0d9a\u0d9a. \u0dbd\u0d82\u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dbd\u0d82\u0dad\u0dba\u0d9a\u0da7 \u0db4 \u0dbd\u0d82\u0db1\u0dd3\u0dad\u0dd2 \u0dbd\u0d82\u0d85\u0dc0\u0d9a\u0dcf\u0d9c\u0dd4 \u0dbd\u0d82 \u0dc5\u0d9a \u0dbd\u0d82\u0dba? \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0d87\u0db8\u0dad\u0dd2\u0dd4\u0db8\u0d9a \u0dbd\u0d82\u0dd2\u0dbb \u0dca \u0dca? \u0dbd\u0d82\u0dad\u0dba\u0d9a\u0da7 \u0db4 \u0dbd\u0d82\u0db1\u0dd3\u0dad\u0dd2 \u0dbd\u0d82\u0d85\u0dc0\u0d9a\u0dcf\u0d9c\u0dd4 \u0dbd\u0d82 \u0da7\u0dc5\u0dda \u0dbd\u0d82\u0dca\u0dd0\u0dc4\u0dd0. \u0dbd\u0d82\u0dad\u0dba\u0d9a\u0da7 \u0db4 \u0dbd\u0d82\u0db1\u0dd3\u0dad\u0dd2 \u0dbd\u0d82\u0daf\u0dd2\u0d9c\u0db4 \u0dbd\u0d82\u0dc4\u0dba\u0dc4\u0d9a\u0db4 \u0dbd\u0d82\u200d\u0dbb\u0dd2 \u0d9a \u0d9a\u0db8 \u0dbd\u0d82 \u0dba\u0da7\u0d9c\u0dca \u0dbd\u0d82 \u0dca\u0dc0\u0d9a. \u0dbd\u0d82\u0da7 \u0dbd\u0d82\u0da7\u0d9c\u0dc0\u0dca \u0dca \u0dbd\u0d82\u0db6\u0dd0\u0dd2\u0db8 \u0dbd\u0d82\u0dca\u0db4\u0dad \u0dbd\u0d82\u0d8b \u0db8\u0db4 \u0dbd\u0d82 \u0dd0\u0dd6 \u0dbd\u0d82\u0da7\u0dba\u0db8\u0dda\u0db4\u0dd2 \u0dca \u0da7\u0dda \u0dbd\u0d82\u0da7\u0d9c\u0dba\u0dba \u0dbd\u0d82\u0dc0\u0dd2\u0d9a\u0dd4\u0da7\u0d9a \u0dbd\u0d82\u0dba\u0db8\u0dca\u0dc0\u0d9a. \u0dbd\u0d82NPLs \u0d85\u0dd4 \u0dbd\u0d82 \u0dba\u0dca \u0dca \u0dbd\u0d82\u0da7\u0db8\u0d9a \u0dca\u0dba \u0dbd\u0d82 \u0dba\u0d9a\u0d9a \u0dbd\u0d82\u0dad\u0dd2\u0da7\u0db6\u0dca \u0da7\u0dca ? \u0dbd\u0d82\u0d8a\u0dc5\u0d9f\u0db4 \u0dbd\u0d82\u0dd2\u0dbb\u0dda\u0dc0\u0d9a, \u0dbd\u0d82\u0db8\u0dcf\u0dc0\u0dca\u0db0\u0dca \u0dbd\u0d82\u0db6\u0dd0\u0dcf\u0d9a\u0dd4\u0dc0\u0dca \u0dbd\u0d82\u0dc4\u0dba\u0dca\u0dc0\u0d9a \u0dbd\u0d82\u0dd2\u0dbb \u0d9a\u0d9a. \u0dbd\u0d82\u0db8\u0dcf\u0dc0\u0dca\u0db0\u0dca \u0dbd\u0d82\u0db6\u0dd0\u0dcf\u0d9a\u0dd4\u0dc0\u0dca \u0dbd\u0d82\u0dc4\u0dd0\u0daf\u0dd4\u0dc0\u0d9a\u0dba? \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0d87\u0db8\u0dad\u0dd2\u0dd4\u0db8\u0db1\u0dd2, \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0db8\u0db3\u0dc4\u0d9a \u0dbd\u0d82\u0d85\u0dd4\u0db8 \u0dbd\u0d82\u0d9c\u0da7\u0da7\u0dca \u0dbd\u0d82\u0da7 \u0db8\u0dca\u0db4\u0dad\u0dad \u0dca\u0dc0 \u0d9a \u0dbd\u0d82\u0dc4\u0dd0\u0daf\u0dd4\u0dc0\u0d9a\u0dba? \u0dbd\u0d82\u0dba\u0dd0\u0dca \u0dbd\u0d82\u0db8\u0dcf\u0dc0\u0dca\u0db0\u0dca \u0dbd\u0d82\u0db6\u0dd0\u0dcf\u0d9a\u0dd4\u0dc0\u0dca \u0dbd\u0d82\u0dc4\u0dba\u0d9a\u0d9a \u0d9a \u0dbd\u0d82\u0dca\u0dd0\u0dc4\u0dd0. \u0dbd\u0d82\u0dad\u0dba\u0d9a\u0da7 \u0db4 \u0dbd\u0d82\u0db1\u0dd3\u0dad\u0dd2 \u0dbd\u0d82\u0d85\u0dc0\u0d9a\u0dcf\u0d9c\u0dd4 \u0dbd\u0d82 \u0dba\u0d9a\u0d9a \u0d9a \u0dbd\u0d82\u0dca\u0dd0\u0dc4\u0dd0. \u0dbd\u0d82\n\n\u0d87 \u0d9a \u0dc0\u0dba\u0da7 \u0dca \u0dbd\u0d82\u0d85\u0dba \u0dbd\u0d82\u0dd2\u0daf\u0dd2\u0dd2\u0db8\u0dad \u0d9a \u0dbd\u0d82 \u0dc5 \u0dbd\u0d82\u0da7\u0db8\u0db8 \u0dbd\u0d82\u0da7 \u0ddd\u0dca\u200d\u0dca\u0d9a \u0dbd\u0d82 \u0dbd\u0d82\u0da7\u0dba \u0dbd\u0d82\u0db8\u0db4\u0dad\u0db6\u0dca \u0db0\u0dba\u0dd2 \u0dbd\u0d82\u0dca\u0dd4\u0daf\u0dca\u200d\u0dbb, \u0dbd\u0d82\u0dd4\u0dc5\u0dd4 \u0dbd\u0d82\u0dc4\u0d9a \u0dbd\u0d82\u0db8\u0db0\u0dba \u0dbd\u0d82\u0dad\u0dd2\u0db8\u0db8\u0d9a\u0da7 \u0dbd\u0d82\u0dc0\u0dba\u0dc0\u0db8\u0d9a \u0dbd\u0d82\u0dca\u0da7\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb \u0db4. \u0da7\u0db8\u0dd4\u0db8\u0d9a \u0dbd\u0d82\u0dd2\u0dbb\u0dda\u0dc0\u0d9a \u0dbd\u0d82\u0da7\u0dca , \u0dbd\u0d82\u0d91\u0db8\u0dca \u0dca \u0dbd\u0d82\u0dc0\u0dca \u0dbd\u0d82\u0da7\u0db8\u0dda\u0dc0 \u0dbd\u0d82\u0d9c\u0dd0\u0dca. \u0dbd\u0d82\u0dba\u0da7 \u0db4 \u0dbd\u0d82\u0db8\u0dd2\u0db1\u0dd2\u0dd4\u0dc5\u0dca \u0db4 \u0dbd\u0d82\n\n1151 1152\n\n[\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0dd4\u0dc5\u0db1\u0dd2\u0dbd\u0dcf \u0dbd\u0d82\u0dc4\u0db1\u0dcf\u0dca \u0da7\u0dca \u0d9a\u0dad\u0dd2 \u0dbd\u0d82\u0db8\u0dc4 \u0d9a \u0dbd\u0d82]\n\n2026 \u0d94\u0dca\u0da7 \u0ddd\u0db6\u0dca \u0dbd\u0d8221\n\n\u0da7\u0dc4\u0d9a\u0db3\u0dca \u0dbd\u0d82\u0dc0\u0dca\u0dc0\u0d9a \u0dbd\u0d82\u0dca\u0db4\u0dad \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0d9c\u0dd0\u0dca \u0dbd\u0d82\u0d85\u0dad\u0db4 \u0dbd\u0d82\u0dd2\u0dbb\u0dc3\u0dd2\u0db8 \u0dbd\u0d82\u0d85\u0dc0\u0dd4\u0d9a\u0dca \u0dbd\u0d82\u0dca\u0dd0\u0dc4\u0dd0. \u0dbd\u0d82\u0d91 \u0db4 \u0dbd\u0d82\u0d85\u0da7\u0dda \u0dbd\u0d82\u0db8\u0dc4\u0da7 \u0ddd\u0d9c \u0dbd\u0d82\u0d9a\u0db6\u0d9a \u0dbd\u0d82\u0da7\u0dba\u0dca\u0dc0\u0d9a. \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0db1\u0dd2\u0db8\u0d9a \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0dad\u0dca \u0dbd\u0d82 \u0db4\u0da7 \u0d9a \u0dbd\u0d82\u0da7\u0d9c\u0da7\u0dca\u0dca \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0da7 \u0ddd\u0dca\u200d\u0dca\u0d9a\u0dc0\u0db4 \u0dbd\u0d82\u0db8\u0dc4 \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0dad\u0dd2\u0db8\u0db4\u0dd6\u0dba \u0db4 \u0dbd\u0d82\u0d85\u0db4\u0dd2 \u0dbd\u0d82\u0db8\u0db4\u0dad\u0db4\u0dd6\u0dca\u0da7\u0da7 \u0dca \u0db8 \u0dbd\u0d82\u0dad\u0dca\u0dc2\u0dca\u0da8\u0dba\u0dd2. \u0dbd\u0d82\u0d85\u0db4\u0dd2 \u0dbd\u0d82\u0dc4\u0dd0\u0db8 \u0dbd\u0d82\u0d91 \u0db4\u0db8 \u0dbd\u0d82\u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0daf\u0db0 \u0dbd\u0d82\u0dca\u0dd0\u0dc4\u0dd0. \u0dbd\u0d82"
