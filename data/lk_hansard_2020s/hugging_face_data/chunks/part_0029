    "chunk_text": "\u0d92 \u0dc0\u0dc1\u0d9c\u0dda\u0db8 \u0d85\u0dc5\u0dd2 \u0d92 \u0d9a\u0da9\u0dc1 \u0dc0\u0dd0\u0da7\u0dd2\u0da0\u0dca\u0da0 \u0d9a\u0dca\u0d9c\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dd2 \u0dbd\u0dca\u0d9a\u0db8 \u0d9c\u0dda \u0d9c\u0dc0\u0db1\u0d9c\u0d9a\u0dc1\u0db4 \u0d9c\u0d9c\u0dc1\u0da9\u0db1\u0dd9\u0dd2\u0dba\u0db1\u0dca\u0dc1 \u0dc3\u0dda\u0dae\u0dc1\u0dc0\u0dbb \u0d9a\u0dbb\u0dd2\u0dba\u0db1\u0dca \u0db1\u0dc0\u0dc1. \u0dda\u0daf\u0dca\u200d\u0dc1\u0dc4\u0dbb\u0da7 \u0d9a\u0dca \u0dc0\u0dd2\u0d9a\u0dbb \u0db4 \u0d9c\u0dad\u0dca\u0d9c\u0dad\u0dc1\u0dad\u0dca\u0dc1 \u0d85\u0dc5\u0dd2 \u0dbb\u0da2 \u0d9a\u0dca \u0dc0\u0dd2\u0d9a\u0dbb \u0db4 \u0d9c\u0dda \u0dc0\u0db1\u0d9c\u0d9a\u0dc1\u0db4 \u0db1\u0dd3\u0dad\u0dd2 \u0d9a\u0dca\u0d9c\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb \u0dda \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0da7 \u0d9a\u0db4 \u200d\u0dbb\u0dd2 \u0dc1\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0dd2\u0dba\u0db1\u0dca\u0dc1 \u0d85\u0da7 \u0db4\u0db1\u0dad\u0dca \u0dc4\u0daf\u0dca\u200d\u0dd2\u0dba\u0db1\u0dca \u0dc3\u0dda\u0dae\u0dc1\u0dc0\u0dbb \u0d9a\u0dbb\u0db1\u0dc0\u0dc1. \u0d92 \u0dc0\u0dc1\u0d9c\u0dda\u0db8 \u0d9c \u0db1\u0db4\u0dc1\u0d9a\u0db1 \u0dad\u0db8\u0dba\u0dd2 \u0d9a\u0dca\u0d9c\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dad\u0dca \u0d85\u0dc5\u0dd2 \u0dda \u0db4\u0dca\u200d\u0dbb\u0d9c\u0db8\u0db1 \u0d9a\u0dca \u0d9c\u0db4\u0db1\u0dca\u0dc0\u0dc1 \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1. \u0da2\u0db1\u0dad\u0dc1\u0dc0 2024\u0daf\u0dd3 \u0da1\u0db1\u0dca\u0daf\u0dca\u200d \u0d9c\u0daf\u0dca\u200d\u0db1\u0d9c\u0d9a\u0dc1\u0db4 \u0dbd\u0d9a\u0dc1\u0d9c\u0db4\u0dc1\u0d9c\u0dbb\u0dc1\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0dd4\u0da7\u0dc1 \u0dc0\u0dd2\u0db1 \u0d9c\u0dbb\u0dd4\u0d9a \u0db4\u0dc1\u0dbb\u0dca\u0dd2\u0d9c\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0d9a\u0dca. \u0dc4\u0dd0\u0dbd\u0dd0\u0dba\u0dd2\u0dc1 \u0d85\u0daf\u0dca\u200d \u0d85\u0dc5\u0dd2 \u0daf\u0dca\u200d\u0dd0\u0d9a\u0dca\u0d9a\u0dc1 \u0dbd\u0dc4\u0dd4\u0dad\u0dbb \u0d9a\u0dca \u0d9c\u0daf\u0dca\u200d\u0db1\u0dc1 \u0d91\u0db6\u0db3 \u0db4 \u0db4\u0dd0\u0db1\u0dca\u0db1\u0dd4\u0dc0\u0dad\u0dca \u0da2\u0db1\u0dad\u0dc1 \u0da1\u0db1\u0dca\u0daf\u0dca\u200d\u0d9c \u0db1\u0dca \u0d86\u0db4\u0dd4 \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0d9c\u0daf\u0dca\u200d\u0d9c\u0db1\u0d9a\u0dca \u0d92 \u0dc0\u0dd2\u0db1 \u0d9c\u0dbb\u0dd4\u0d9a \u0db4\u0dc1\u0dbb\u0dca\u0dd2\u0d9c\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0db4 \u0db1\u0dd0\u0dc0\u0dad \u0dc0\u0dad\u0dc1\u0dc0\u0d9a\u0dca \u0dc4\u0dc1\u0db1\u0dd2 \u0d9a\u0dbb\u0db1 \u0db8\u0da7\u0dca\u0db4\u0db8\u0db4 \u0d87\u0dc0\u0dd2\u0dad\u0dca \u0dad\u0dd2\u0d9c\u0dbd\u0db1 \u0d86\u0d9a\u0dc1\u0dbb . \u0dc4\u0dd0\u0dbd\u0dd0\u0dba\u0dd2\u0dc1 159\u0d9c\u0daf\u0dca\u200d\u0d9c\u0db1\u0d9a\u0dca \u0d89\u0db1\u0dca\u0db1 \u0d9c\u0dda \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0d89\u0dad\u0dc1\u0db8 \u0dc0\u0dd2\u0db1 \u0d9c\u0dbb\u0dd4\u0d9a\u0dc0 \u0d9c\u0dda \u0dc3 \u0dc1\u0d9c\u0dda \u0dc4\u0dd0\u0dc3\u0dd2\u0dbb\u0dd4\u0da7\u0dc1.\n\n\u0db8\u0db4 \u0d9a\u0dd2\u0db1\u0dca \u0d9a\u0dae\u0dc1 \u0d9a\u0dbb\u0db4\u0dd4 \u0daf\u0dd2\u0dd2\u0dad\u0dca \u0da2 \u0dd3\u0dbb \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb \u0dc1 \u0d9a\u0dd2\u0dda\u0dc0\u0dc1\u0dc1 \u0d87\u0dd9\u0dbd\u0dd4\u0dda \u0d9a\u0dca\u0d9c\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb\u0d9c\u0dda \u0d9a\u0da9\u0dc1 \u0dc0\u0dd0\u0da7\u0dd3\u0db8\u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1 \u0d9a\u0dd2 \u0d9a\u0dc1. \u0d94\u0dda\u0dc1 \u0d87\u0dd9\u0dbd\u0dd4\u0dda \u0d9a\u0dca\u0d9c\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb\u0d9c\u0dda \u0d9a\u0da9\u0dc1 \u0dc0\u0dd0\u0da7\u0dd3\u0db8\u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1. \u0d92\u0d9a\u0db4 \u0d9c\u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1. \u0d9c\u0dda \u0d86\u0dc3\u0dd2 \u0dc1\u0dad\u0dd2\u0d9a \u0dbb\u0db4\u0dc0\u0d9a AI \u0dda\u0db4\u0dc1\u0d82\u0d9c\u0dc0\u0d9a \u0dc0\u0dd0\u0db4 \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0d9c\u0d9a\u0dc1\u0db4, \u0d92 \u0d9c\u0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbd\u0dca \u0d86\u0d9c \u0ddd\u0da2\u0db1 \u0d9a\u0dbb\u0db1\u0d9c\u0d9a\u0dc1\u0db4, \u0dd2\u0dba\u0d9a \u0dc3\u0d82\u0d9c\u0dda\u0daf\u0dd3 \u0d87\u0db3\u0dd4\u0dda \u0dc0\u0dc1\u0d9c\u0dda \u0d92\u0dc0\u0dc1\u0db4 \u0dad\u0dd2\u0d9c\u0dbd\u0db1 \u0d89\u0dbd\u0dca\u0dbd\u0dd4\u0db8 \u0d91\u0d9a \u0db4\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd2\u0db1\u0dca \u0d85\u0da9\u0dd4 \u0d9c\u0dc0\u0db1\u0dc0\u0dc1.\n\n\u0d85\u0d9c\u0db1\u0d9a\u0dca \u0d9a\u0dc1\u0dbb\u0da7 \u0d9c\u0dda\u0d9a\u0dba\u0dd2\u0dc1 \u0dbd\u0dca\u0d9a\u0dc1\u0dc3\u0db1\u0dc1\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0d9c\u0d9a\u0ddd\u0d9a\u0d9c\u0dda \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf\u0dca\u200d \u0dc4\u0db8\u0dd4\u0d9c\u0dda \u0dc3\u0db8\u0dc4\u0dbb \u0dbb\u0db4\u0dc0\u0dbd\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d9c\u0dc4\u0db4\u0dd4 \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0dda \u0dad\u0dd2\u0d9c\u0dbd\u0db1 \u0dbd\u0dc0 \u0d85\u0dc5\u0dd2 \u0daf\u0dca\u200d\u0db1\u0dca\u0db1\u0dc0\u0dc1. \u0dbd\u0d82\u0dda\u0d9a\u0dc1\u0d9c \u0db1 \u0dc1 \u0dc0\u0dd2 \u0da7\u0dca\u0db1\u0dc1\u0db8 \u0dc0\u0dc1\u0d9c\u0dda \u0dbb\u0db4\u0dc0\u0dbd\u0dca \u0dc3\u0db8\u0dd9 \u0d85\u0dad\u0dca\u0dc3\u0db1\u0dca \u0d9a\u0dc5 \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0dda \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1. \u0d85\u0db1\u0dca\u0db1 \u0d92 \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0dda \u0d85\u0db1\u0dd4\u0dc0\u0dad\u0dca \u0dda \u0dbd\u0d9a\u0db4\u0dd1\u0db8\u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1\u0dc1 \u0d9c\u0dda \u0d87\u0dd9\u0dbd\u0dd4\u0dda \u0d9a\u0dca\u0d9c\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb\u0d9c\u0dda \u0d9a\u0da9\u0dc1 \u0dc0\u0dd0\u0da7\u0dd3\u0db8\u0db4. \u0d92\u0dad\u0dca \u0d85\u0dc5\u0dd2 \u0dda\u0dad\u0dca\u0dc3\u0dc1\u0dc4 \u0d85\u0dad\u0dc4\u0dd0\u0dbb\u0d9a\u0dc1 \u0db1\u0dd0\u0dc4\u0dd0. \u0d92 \u0d9a\u0dca\u0d9c\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb \u0db1\u0dd9\u0dc1 \u0dc3\u0dd2\u0da7\u0dd4\u0dd3\u0db8 \u0d9c\u0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0db1\u0dca \u0d85\u0dc0\u0db1\u200d \u200d\u0dbb\u0dd2 \u0dc1\u0db8\u0dc1\u0dbb\u0dca\u0d9c \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dc1. \u0d92 \u200d\u0dbb\u0dd2 \u0dc1\u0db8\u0dc1\u0dbb\u0dca\u0d9c \u0d9c\u0db8\u0dc1\u0db1\u0dc0\u0dc1\u0daf\u0dca\u200d \u0d9a\u0dd2 \u0d9a\u0dc1 \u0db8\u0db8 \u0db4\u0dc3\u0dd4\u0dc0 \u0d9a\u0dd2 \u0db1\u0dca\u0db1\u0dda.\n\n\u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dc1 \u0d9a\u0dd2\u0dda\u0dc0\u0dc1\u0dc1 \u0d85\u0db4\u0db1 \u0db1 \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9c\u0dc0\u0d9a\u0dc1 \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dca\u0d9c\u0db1\u0dca \u0d9b\u0dca\u200d\u0db1\u0dd2\u0da2 \u0d9c\u0dad\u0dbd\u0dca \u0db1\u0dd2\u0dc2\u0dda\u0db4\u0dc1\u0daf\u0dca\u200d\u0db1 \u0db4\u0dd0\u0dad\u0dca\u0d9c\u0dad\u0db1\u0dca \u0dc0\u0dd2\u0dad\u0dbb\u0dba\u0dd2 \u0d9a\u0dd2 \u0d9a\u0dc1. \u0dbd\u0dca\u0d9a\u0dc1\u0dc3\u0db1\u0dc1\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2\u0dc1 \u0d9a\u0dca\u0dd2 \u0d85\u0db4\u0db1 \u0db1\u0dc0\u0d9a \u0dc0\u0dd0\u0db4\u0dd3\u0db8 \u0d91\u0dad\u0dd4\u0db8\u0dc1\u0db4 \u0d85\u0db8\u0dad\u0d9a \u0d9c\u0dc0\u0d9a\u0dc1 \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1. 2025 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9c \u0db4\u0d9a\u0dad\u0dd4\u0dbb\u0dd4 \u0dc3\u0dc4 \u0d87\u0db4 \u0dc0\u0dbb\u0dca\u0d9c \u0d85\u0db4\u0db1 \u0db1\u0d9c\u0dda \u0dc3\u0dd2 \u0db4 68.6\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1. \u0d92 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0d9c\u0db1\u0dc1\u0d9c\u0dc0\u0dba\u0dd2\u0dc1 \u0d9c\u0db4\u0dc1\u0dbd\u0dca \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad \u0db1\u0dd2\u0dc2\u0dda\u0db4\u0dc1\u0daf\u0dca\u200d\u0db1\u0dc0\u0d9a \u0dc3\u0dd2 \u0db4 42\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dca\u0dc1 \u0d86\u0dc4\u0dc1\u0dbb \u0dc3\u0dc4 \u0db4\u0dc1\u0db1 \u0dc0\u0dbb\u0dca\u0d9c\u0dc0\u0d9a \u0dc3\u0dd2 \u0db4 24\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dca\u0dc1 \u0d85\u0d9c\u0db1\u0db1\u0db8\u0dad\u0dca \u0d9c \u0ddd\u0d9c\u0dc0\u0d9a \u0dc3\u0dd2 \u0db4 57.2\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1. \u0d9b\u0dca\u200d\u0db1\u0dd2\u0da2 \u0d9c\u0dad\u0dbd\u0dca \u0db1\u0dd2\u0dc2\u0dda\u0db4\u0dc1\u0daf\u0dca\u200d\u0db1 \u0db4\u0dd0\u0dad\u0dca\u0d9c\u0dad\u0db1\u0dca \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0d9c\u0db1\u0dc1\u0d9c\u0dc0\u0dba\u0dd2 \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9c\u0dc0\u0d9a\u0dc1 \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dca\u0d9c\u0db1\u0dca. \u0d91\u0dad\u0dd4\u0db8\u0dc1\u0db4 \u0d85\u0db8\u0dad\u0d9a \u0d9c\u0dc0\u0d9a\u0dc1. \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0d89\u0dad\u0dd2\u0dbb\u0dd2 \u0d9a\u0dd1\u0dd2 \u0da7\u0dd2\u0d9a \u0dc4\u0d9a\u0d9a\u0dc1 \u0dad\u0db8\u0dba\u0dd2 \u0d9a\u0dd2 \u0db1\u0dca\u0d9c\u0db1\u0dca. \u0d95\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0d9c\u0dda \u0dc4\u0dd0\u0da7\u0dd2."
