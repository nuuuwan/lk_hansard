    "chunk_text": "\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0d85\u0daf \u0dc0\u0dd0\u0daf\u0d9c\u0dad\u0dca \u0d9a\u0dcf\u0dbb\u0dab\u0dcf\u0dc0\u0d9a\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\u0db1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0da7 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dca\u0db1\u0dda. \u0db8\u0db8 . \u0db8\u0db8 \u0d85\u0dc4\u0d9c\u0dd9\u0db1 \u0d9c\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf, \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0dc0\u0dd2\u0dc0\u0dda\u0da0\u0db1 \u0db1 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0d9a\u0da7\u0dd4 \u0d9c\u0dc4\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d85\u0db4\u0dd2 \u0d9a\u0da7\u0dd4 \u0d9c\u0dc4\u0db1 \u0dcf. \u0d85\u0db4\u0dd2 \u0d9a\u0da7\u0dd4 \u0d9c\u0dc4\u0db1 \u0da2\u0dcf\u0dad\u0dd2\u0dba\u0dda \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4 \u0db1\u0ddc\u0dc0\u0dd9\u0dba\u0dd2. \u0db8\u0db8 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0dc0\u0dd2\u0dc0\u0dda\u0da0\u0db1\u0dba\u0d9a\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0db8\u0dca. ."
  },
