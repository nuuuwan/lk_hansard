    "chunk_text": "186 \u0dbd\u0d82\u0da7\u0dba\u0da7\u0dca\u0d9a\u0dd4 \u0dbd\u0d82\u0dad\u0dd0\u0dc4\u0dd0\u0dba\u0da7\u0d9c\u0dca \u0dbd\u0d82\u0da7\u0d9c\u0d9a\u0db8\u0dda \u0dbd\u0d82\u0d9d\u0d9a \u0dca \u0dbd\u0d82 \u0dba \u0dbd\u0d82\u0d87\u0dad\u0dd2 \u0dbd\u0d82\u0db6\u0dc0 \u0dbd\u0d82\u0db8\u0db3\u0dc4\u0dca \u0dbd\u0d82 \u0dba\u0db8\u0dd2\u0dca , \u0dbd\u0d82\u0d85\u0dcf \u0dbd\u0d8237 \u0dbd\u0d82\u0db8\u0dd4\u0dbb\u0dd4 \u0dbd\u0d82\u0da7 \u0d9a\u0dca \u0da9\u0d9a\u0dca , \u0dbd\u0d82\u0db8\u0da9 \u0d9a\u0dd4\u0dc0 \u0dbd\u0d82 \u0dca \u0dbd\u0d82\u0dd2\u0db4\u0dd2\u0dca\u0da7\u0dda \u0dbd\u0d82\u0dad\u0daf\u0dd2\u0dcf\u0da0\u0dd2 \u0dbd\u0d82\u0dc0\u0dba\u0dd2\u0dba\u0db8\u0dd4 \u0d9a\u0dd4 \u0dbd\u0d82\u0d9a\u0dd4\u0d9a\u0dca \u0dba \u0dbd\u0d82\u0dc0\u0da9\u0dd2\u0da7\u0dda\u0dbd\u0dcf \u0dbd\u0d82 \u0dca \u0dbd\u0d82\u0d85 \u0dbd\u0d82\u0dc0\u0dd2\u0dc3\u0dd2\u0dca \u0dbd\u0d82\u0da7\u0dad\u0d9a\u0dd2\u0db8\u0dda\u0dad\u0dad\u0dd2 \u0dbd\u0d82\u0da7\u0dc0 \u0dbd\u0d82\u0dd2\u0daf\u0dd2\u0dd2\u0db8\u0dad \u0d9a \u0dbd\u0d82 \u0dba \u0dbd\u0d82\u0d87\u0dad\u0dd2 \u0dbd\u0d82\u0dad\u0dd0\u0db8\u0dd2\u0d9a\u0dc0\u0dbd\u0dcf\u0d9a \u0dbd\u0d82\u0d85\u0db1\u0dd4\u0dc0, \u0dbd\u0d82\u0d85\u0dad\u0dba\u0d9a\u0db0 \u0dbd\u0d82\u0dad\u0dd3\u0db8\u0dca\u0dc2\u0dca\u0da8\u0da7 \u0dbd\u0d82\u0da7\u0dba\u0dad\u0d9a\u0dca \u0da7\u0db4\u0dad\u0dca \u0dd4\u0da7\u0dda \u0dbd\u0d82\u0db8\u0db1\u0dd4\u0dc2\u0dca\u0da8\u0dba \u0dbd\u0d82\u0d9d\u0d9a \u0dca \u0dbd\u0d82\u0dc4\u0d9a \u0dbd\u0d82\u0db8\u0dcf\u0dc0\u0dd2\u0db0\u0d9a\u0dca\u0d9a \u0d9a\u0db8 \u0dbd\u0d82\u0d85\u0dad\u0dba\u0d9a\u0db0 \u0dbd\u0d82\u0dc0\u0dd2\u0db8\u0dca\u0dba\u0dca \u0dbd\u0d82\u0d85\u0dcf\u0dba\u0da7\u0dda \u0dbd\u0d82\u0db8\u0db1\u0dd4\u0dc2\u0dca\u0da8\u0dba \u0dbd\u0d82\u0d9d\u0d9a \u0dca \u0dbd\u0d82\u0dc0\u0dd2\u0db8\u0dca\u0dba\u0dca \u0dbd\u0d82\u0d85\u0dcf\u0dba \u0dbd\u0d82\u0db8\u0dca \u0dca \u0dbd\u0d82\u0dc0\u0dd2\u0db8\u0dca\u0dba\u0dca \u0dbd\u0d82 \u0db4\u0dba\u0dd4\u0dd4 \u