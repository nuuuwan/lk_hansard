    "chunk_text": "\u0db8\u0dd6\u0d9a\u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd6\u0daa \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0db8\u0dca \u0dd3\u0dd4\u0db8\u0db1\u0dd2, \u0dbd\u0d82\u0dca\u200d\u0d9a\u0dad\u0dd2 \u0dbd\u0d82\u0d8b\u0dbb\u0dd4\u0db8 \u0dca , \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0dc0\u0d9a\u0da7\u0dda\u0db8 \u0dbd\u0d82\u0db8\u0dcf\u0db8\u0dda \u0dd8\u0dad\u0dd2 \u0dbd\u0d82\u0dbb\u0dba\u0dca\u0dc2\u0dca\u0da8\u0d9a \u0dbd\u0d82\u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0dbd\u0d82\u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dbd\u0d82\u0dbb\u0dc3\u0dd2 \u0d9a\u0db1\u0dd4 \u0dbd\u0d82\u0db8\u0db8\u0dd4\u0dd4 \u0dc0 \u0db4 \u0dbd\u0d82\u0db8\u0dc4\u0db7\u0d9a\u0d9c\u0dd2 \u0dbd\u0d82\u0dc0\u0dd3\u0db8\u0db8 \u0dbd\u0d82\u0db1\u0dd2\u0db8\u0dd2 \u0d9a\u0da7 \u0dca \u0dbd\u0d82\u0db8\u0db8 \u0dbd\u0d82\u0dba\u0dc0\u0db8\u0dda \u0dbd\u0d82\u0dad\u0dc4 \u0dbd\u0d82\u0dc0\u0dd2\u0da7\u0daf\u0dca\u0daf\u0dba \u0dbd\u0d82\u0db8\u0dcf\u0da0\u0d9a\u0dba \u0dbd\u0d82\u0da7 \u0daf\u0dd3 \u0dbd\u0d82\u0dc3\u0dd2\u0db8\u0dd2 \u0d9a. \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0dba\u0db4\u0dc0\u0d9a\u0db4 \u0dbd\u0d82\u0d9c\u0dd2 \u0d9a\u0db8 \u0dbd\u0d82\u0d85\u0dad\u0db4 \u0dbd\u0d82\u0dba\u0dd0\u0da7\u0dca\u0dca\u0dc0\u0d9a, \u0dbd\u0d82\u0d85\u0da7\u0dda \u0dbd\u0d82\u0dca\u200d\u0dbb\u0dba\u0dda\u0dca \u0dbd\u0d82\u0da7\u0db8\u0d9a \u0dca\u0dba, \u0dbd\u0d82\u0dba\u0db4\u0dca \u0dbd\u0d82\u0da7\u0d9a\u0db8 \u0dbd\u0d82\u0d85\u0db4\u0dd2 \u0dbd\u0d82\u0da7 \u0d9a \u0dd0\u0dca\u0dba \u0dbd\u0d82\u0dd2\u0dca \u0da7\u0dca \u0dbd\u0d82\u0dd2\u0dbb \u0dca \u0dbd\u0d82\u0d91 . \u0dbd\u0d82\u0d87 \u0d9a \u0db4\u0db8 \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0dba\u0db4\u0dc0\u0dbd\u0dcf \u0dbd\u0d82\u0dc4\u0dd0\u0db8 \u0dbd\u0d82\u0d85\u0dad\u0dd2\u0dca \u0db8 \u0dbd\u0d82\u0da7 \u0d9a \u0dd0\u0dca\u0dba \u0dbd\u0d82\u0dd2\u0dca \u0da7\u0dca \u0dbd\u0d82\u0dd2\u0dbb \u0dca \u0dbd\u0d82\u0d91 \u0dbd\u0d82\u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0dbd\u0d82\u0d85\u0dad\u0db4 \u0dbd\u0d82\u0dc4\u0dd2 \u0d9a\u0d9c\u0dca \u0dca \u0dbd\u0d82\u0dd4\u0dd4 \u0dc0\u0dca \u0dbd\u0d82\u0dc0\u0dd4\u0da7\u0d9a. \u0dbd\u0d82\u0db8\u0dd6\u0d9a\u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd6\u0daa \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0db8\u0dca \u0dd3\u0dd4\u0db8\u0db1\u0dd2, \u0dbd\u0d82\u0db6\u0d9a \u0dbd\u0d82\u0d9a\u0db6\u0d9a \u0dbd\u0d82\u0d9c\u0dd0\u0db1\u0dd3\u0da7\u0db4\u0dad \u0dbd\u0d82\u0d85\u0dba\u0db8\u0dd4\u0da7\u0da7\u0dca \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0dba\u0da7 \u0db4 \u0dbd\u0d82\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dca\u0da7\u0dc2\u0dca\u0da8\u0dda\u0dad \u0dbd\u0d82 \u0dc5 \u0dbd\u0d82\u0dba\u0dd4\u0dd4, \u0dbd\u0d82\u0dad\u0dba\u0d9a\u0dca\u200d \u0dbd\u0d82 \u0dc5 \u0dbd\u0d82\u0dba\u0dd4\u0dd4 \u0dbd\u0d82\u0dca\u200d\u0d9a\u0dad\u0dd2\u0dc0\u0d9a\u0dba \u0dbd\u0d82\u0dca\u0dd0\u0dc0 \u0dbd\u0d82\u0dca\u0dd0\u0dc0 \u0d9a \u0dbd\u0d82\u0d87\u0dc0\u0dd2\u0db8\u0dda\u0dc3\u0dd3\u0db8 \u0dbd\u0d82\u0dc4\u0d9a \u0dbd\u0d82\u0d9a\u0dd0\u0da7\u0db6\u0dca \u0dbd\u0d82\u0dc4\u0dd0\u0db8 \u0dbd\u0d82\u0d85\u0dc0\u0db8\u0dda\u0dcf\u0d9a\u0dc0 \u0db8 \u0dbd\u0d82\u0db8\u0db8\u0d9c\u0dd2 \u0dbd\u0d82\u0d9c\u0dd0\u0dca \u0dbd\u0d82 \u0dcf\u0d9a \u0dbd\u0d82 \u0dc5 \u0d9a, \u0dbd\u0d82\u0db8\u0db8\u0d9c\u0dd2 \u0dbd\u0d82\u0dc0\u0dd2\u0dca\u0d9a\u0dba \u0dbd\u0d82 \u0dba\u0dca \u0dbd\u0d82\u0da7\u0daf\u0dca\u0daf\u0dc0\u0dbd\u0dcf \u0dbd\u0d82\u0da7\u0dc0\u0db1\u0dd4\u0da7\u0dc0\u0dca \u0dbd\u0d82\u0da7\u0dad\u0db1\u0dd3 \u0dbd\u0d82\u0dc3\u0dd2\u0da7\u0dd3\u0db8 \u0dbd\u0d82\u0da7 \u0d9a \u0dba\u0db4\u0dad \u0dbd\u0d82\u0da7\u0dda\u0dba\u0dca\u0d9a \u0d9a\u0dd3\u0db8\u0dba \u0dbd\u0d82\u0dd2\u0dbb \u0dca \u0dbd\u0d82\u0d91 \u0dbd\u0d82\u0d85\u0dc0\u0dcf \u0dc0 \u0dbd\u0d82\u0d85\u0dad\u0db4 \u0dbd\u0d82 \u0dbd\u0dcf\u0dad\u0dca\u0d9a \u0dbd\u0d82 \u0dba\u0dca \u0dca \u0dbd\u0d82\u0da7\u0dc0\u0dca\u0dc0\u0d9a. \u0dbd\u0d82\n\n\u0dba\u0db4\u0dca \u0dbd\u0d82\u0da7\u0d9c\u0d9a\u0da9\u0dca\u0d9f\u0dca \u0dca \u0dbd\u0d82\u0dca\u0db4\u0dad, \u0dbd\u0d82\u0d85\u0db4\u0dd2 \u0dbd\u0d82\u0dc4\u0dd0\u0db8 \u0dbd\u0d82\u0da7 \u0dca\u0d9a\u0db4\u0db8 \u0dbd\u0d82\u0dd4\u0dc5\u0dc0\u0dad \u0d9a \u0dbd\u0d82\u0db8\u0dca\u0db8\u0dca \u0dbd\u0d82\u0d85 \u0dba\u0dc0\u0dba\u0dba\u0dba\u0dd2. \u0dbd\u0d82\u0dd4\u0dc5\u0dc0\u0dad \u0d9a \u0dbd\u0d82\u0db8\u0dca\u0db8\u0dd2\u0dbb\u0dca \u0dbd\u0d82\u0da7 \u0d9a\u0dba\u0dc0 \u0dbd\u0d82\u0d85\u0dad\u0db4 \u0dbd\u0d82\u0da7\u0dc4\u0d9a\u0db3 \u0dbd\u0d82\u0dba\u0db4\u0dca \u0dbd\u0d82 \u0dc0\u0dba\u0dba\u0d9a \u0dc0 \u0d9a \u0dbd\u0d82\u0db6\u0dd2\u0dc4\u0dd2 \u0dbd\u0d82 \u0dba\u0dca \u0dca \u0dbd\u0d82\u0db6\u0dd0\u0dc4\u0dd0. \u0dbd\u0d82\u0d85\u0db4\u0dd2 \u0dbd\u0d82\u0dc4\u0dd0\u0db8\u0da7 \u0dca\u0d9a\u0db8 \u0dbd\u0d82\u0db6\u0d9a\u0d9a\u0da7\u0dad\u0d9a\u0da7\u0dba\u0d9a \u0d9a\u0dd4 \u0dbd\u0d82\u0dc0\u0dca \u0da7\u0dca \u0d9a \u0dbd\u0d82\u0dd4\u0dc5\u0dc0\u0dad \u0d9a \u0dbd\u0d82\u0dca\u200d\u0d9a\u0dad\u0dd2 \u0dca \u0dbd\u0d82\u0da7\u0d9a\u0db8 \u0dbd\u0d82\u0da7\u0dc4\u0d9a\u0db3\u0dd2\u0dca \u0dbd\u0d82\u0da2\u0dd3\u0dc0 \u0d9a \u0dbd\u0d82\u0da7\u0dc0\u0dca \u0dca \u0dbd\u0d82\u0d95\u0dca\u0dd1 \u0dbd\u0d82\u0dd2\u0dbb \u0dca \u0dbd\u0d82\u0dad\u0dba\u0db8\u0d9a\u0dca\u0dcf \u0d9a \u0dbd\u0d82\u0d91\u0dca \u0dbd\u0d82\u0da2\u0dd3\u0dc0 \u0d9a \u0dbd\u0d82\u0dc0\u0dca \u0dbd\u0d82\u0db8\u0db8\u0d9a\u0dca\u200d \u0dca. \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0da7\u0daf\u0dca\u0daf\u0dc0\u0dbd\u0dcf \u0dbd\u0d82\u0dad\u0d9a\u0d9a \u0dca \u0dbd\u0d82\u0da7\u0d9a\u0db8 \u0dbd\u0d82\u0d85\u0dad\u0db4 \u0dbd\u0d82\u0dc0\u0dd2\u0dba\u0d9a\u0d9a \u0dbd\u0d82\u0dad\u0d9a\u0dc0\u0dc0\u0dd4\u0da9. \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0dad\u0d9a\u0dc0\u0dc0\u0dd4\u0da9 \u0dbd\u0d82\u0d85\u0dba\u0da7\u0d9c\u0dca \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0db8\u0db8\u0d9a\u0dca\u200d \u0dbd\u0d82\u0da7\u0dc0\u0dca\u0db8\u0dda \u0dbd\u0d82 \u0dba\u0dca \u0dca \u0dbd\u0d82\u0d85\u0db4\u0dd2 \u0dbd\u0d82\u0dc4\u0dd0\u0db8\u0da7 \u0dca\u0d9a\u0db8 \u0dbd\u0d82\u0d91 \u0dd4 \u0dbd\u0d82\u0da7\u0dc0\u0d9a\u0d9a \u0dbd\u0d82\u0dc0\u0dd0\u0da9 \u0dbd\u0d82 \u0dba\u0db8\u0dd4 \u0dbd\u0d82\u0dd2\u0dbb \u0db8\u0dd2\u0dca \u0dbd\u0d82\u0db8\u0db8 \u0dbd\u0d82\u0db1\u0dd2\u0dc4\u0dac \u0dbd\u0d82\u0da7\u0dc0\u0dca\u0dc0\u0d9a. \u0dbd\u0d82\n\n\u0db8\u0dda\u0dd4\u0dad\u0dd2\u0dba\u0dd2.\n\n1129 1130\n\n\u0dad\u0d9a\u0dca\u0dd2\u0da7\u0db4\u0dad\u0dca \u0dd4\u0dc0\n\n\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dd4\u0dab \u0dd9\u0db1\u0dca\u0dd3\u0dd4\u0dbb\u0dd9\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba4\u0bae\u0bb2\u0bae\u0bc8\u0ba4\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0d9c \u0d9a\u0dca \u0dbd\u0d82\u0dca\u200d\u0dca \u0dbd\u0d82\u0db8\u0dca \u0dd3\u0dd4\u0db8\u0d9a. \u0dbd\u0d82\u0d94\u0db6\u0dd4\u0db8\u0d9a\u0db4 \u0dbd\u0d82\u0dc0\u0dd2\u0dca\u0d9a\u0da9\u0dd2 \u0dbd\u0d8210 \u0dbd\u0d82 \u0d9a\u0d9a \u0dca \u0dbd\u0d82\u0dad\u0dd2\u0da7\u0db6\u0dca\u0dc0\u0d9a.\n\n[\u0d85.\u0db7\u0d9a. \u0dbd\u0d823.10]\n\n\u0d9c\u0dd4\u0dab \u0d9c\u0dba\u0dcf\u0db1\u0dca \u0da2\u0db1\u0d9a \u0dd9\u0dc4\u0dad\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b95\u0baf\u0bc6\u0bbe\u0ba9\u0bcd \u0b9c\u0ba9\u0b95) (The Hon. Gayan Janaka) \u0db8\u0dd6\u0d9a\u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd6\u0daa \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0db8\u0dca \u0dd3\u0dd4\u0db8\u0db1\u0dd2, \u0dbd\u0d82\u0db1\u0dd2\u0dba\u0dc4\u0dc3\u0dd2\u0dca \u0dbd\u0d82\u0dad\u0db8\u0dda\u0da7\u0db8\u0dda \u0dbd\u0d82\u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0dbd\u0d8276\u0dca \u0dbd\u0d82\u0dba\u0db4 \u0dbd\u0d82\u0dad\u0d9a\u0d9a\u0dca \u0dbd\u0d82 \u0dba\u0d9a\u0d9a, \u0dbd\u0d82\u0d85\u0dd4\u0db8 \u0dbd\u0d82 \u0dba\u0db8\u0dd2\u0dca \u0dbd\u0d82\u0db8\u0dd2\u0db1\u0dd2\u0db8\u0dda\u0dd4\u0dc5\u0dca \u0da7\u0dda \u0dbd\u0d82\u0db8\u0dd6\u0dd2 \u0dbd\u0d82\u0d85\u0dc0\u0dba\u0dba \u0d9a \u0dbd\u0d82\u0dc0\u0dca \u0dbd\u0d82\u0da7\u0dad\u0ddd\u0dc2\u0dca\u0da8\u0dba\u0dba\u0d9a\u0dba\u0dd3 \u0dbd\u0d82\u0dbb\u0dc4\u0d9a\u0dba \u0dbd\u0d82\u0da7\u0dda\u0d9a\u0dca, \u0dbd\u0d82\u0dd2\u0dca \u0dca \u0dbd\u0d82\u0dc4\u0dd2\u0db8\u0dd2\u0dca \u0dca \u0dbd\u0d82\u0dd4\u0dd4 \u0dc0\u0dca \u0dbd\u0d82\u0db1\u0dd2\u0dc0\u0d9a\u0db8 \u0dca \u0dbd\u0d82\u0d9a\u0db6\u0d9a \u0dbd\u0d82\u0da7\u0dba\u0dca \u0dca \u0dbd\u0d82\u0db6\u0dd0\u0dd2\u0db8 \u0dbd\u0d82\u0da7\u0dc0\u0da0\u0dca\u0da0 \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0d85 \u0dbd\u0d82\u0dba\u0dd0\u0dca \u0dbd\u0d82\u0d85\u0db4\u0dd2 \u0dbd\u0d82\u0dbb\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dca \u0dbd\u0d82\u0d85\u0dba\u0da7\u0d9c\u0dca \u0dbd\u0d82\u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0dbd\u0d82\u0da7\u0dba \u0dbd\u0d82 \u0d9a\u0d9a \u0dca \u0dbd\u0d82\u0d9c \u0dbd\u0d82\u0da7\u0dc0\u0dca\u0da7 \u0d9a\u0db4 \u0dbd\u0d82\u0d85\u0da7\u0dad\u0dca \u0dbd\u0d82\u0d85\u0dc4\u0dca\u0dc0\u0d9a, \u0dbd\u0d82\u0da7\u0db8\u0d9a\u0dca\u0dc0\u0d9a\u0dba \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0dbb\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dbd\u0d82 \u0dba\u0d9a\u0d9a \u0dbd\u0d82\u0dad\u0dd2\u0da7\u0db6\u0dca \u0da7\u0dca \u0dbd\u0d82\u0dd2\u0dbb \u0d9a\u0d9a. \u0dbd\u0d82"
