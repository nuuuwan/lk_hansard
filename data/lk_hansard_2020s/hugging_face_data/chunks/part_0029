    "chunk_text": "\u0db8\u0db8 \u0dbd\u0d82\u0d85\u0dc0\u0db8\u0d9a\u0dca \u0dbd\u0d82\u0dc0\u0dba\u0da7 \u0dca \u0dbd\u0d82\u0d92 \u0db4 \u0dbd\u0d82\u0d85\u0dba\u0d9a\u0dc5\u0dc0 \u0dbd\u0d82\u0d94\u0da7\u0db6\u0dca \u0dbd\u0d82\u0d85\u0dc4\u0dca \u0da7\u0dca , \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0da7 \u0dbd\u0d82\u0d9c \u0d9a\u0dd4 \u0dbd\u0d823, 000 \u0dbd\u0d82\u0da7\u0dba\u0dca\u0d9a\u0db4 \u0dbd\u0d82\u0d85\u0dba\u0d9a\u0dc5\u0dc0 \u0dbd\u0d82\u0daf\u0dd3\u0dd4 \u0dbd\u0d82\u0db8\u0dd4\u0dba\u0dbd\u0dcf \u0dbd\u0d82\u0dca\u200d\u0dbb\u0db8\u0d9a\u0da7\u0da7 \u0dca \u0dbd\u0d82\u0d85\u0dbd\u0dd4\u0dad\u0dd2\u0dca \u0dbd\u0d82\u0d85\u0da7\u0dda \u0dbd\u0d82\u0dbb\u0dca\u0dd2 \u0dbd\u0d82\u0dca\u200d\u0dbb\u0dc0\u0dca\u0db0\u0dca \u0dbd\u0d82\u0da7\u0dc0\u0da0\u0dca\u0da0 \u0dbd\u0d82\u0dc0\u0dd2\u0d9a\u0dbb \u0dbd\u0d82\u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dbd\u0d82\u0d85\u0dba\u0dc4\u0db8\u0dca \u0dbd\u0d82\u0dd2\u0daf\u0dd2\u0dd2\u0db8\u0dad \u0d9a \u0dbd\u0d82 \u0dba\u0dca \u0dca \u0dbd\u0d82\u0dd2\u0dbb \u0d9a\u0d9a\u0dba\u0dd2. \u0dbd\u0d82\u0d91\u0da7\u0dc4\u0db8 \u0dbd\u0d82 \u0dba\u0dca \u0dca \u0dbd\u0d82\u0dd4\u0dd4 \u0dc0\u0dca \u0dbd\u0d82\u0dca\u0db4\u0dad \u0dbd\u0d82\u0da7\u0dc4\u0d9a\u0db3\u0dba\u0dd2. \u0dbd\u0d82\u0dca\u0db8\u0dd4 \u0d9a, \u0dbd\u0d82\u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0dbd\u0d8276\u0dca \u0dbd\u0d82\u0d9c\u0dd0\u0dca \u0dbd\u0d82\u0dd2\u0dbb \u0dc0 \u0dbd\u0d82\u0dd2\u0dbb \u0dc0\u0d9a \u0dbd\u0d82\u0dd2\u0dca \u0dca\u0dc0\u0d9a, \u0dbd\u0d82\u0db6\u0d9a \u0dbd\u0d82\u0d85\u0dba\u0da7\u0d9c\u0dca \u0dbd\u0d82\u0dba\u0dd0\u0dca \u0dbd\u0d82\u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0dbd\u0d822\u0dca \u0dbd\u0d82\u0da7\u0dc0\u0d9a\u0d9a \u0d9a \u0dbd\u0d82\u0da7\u0db4\u0dad \u0db4 \u0dbd\u0d82\u0d85\u0dba\u0d9a\u0dc5 \u0dbd\u0d82\u0db8\u0d9a \u0dd8 \u0d9a\u0dc0\u0dca \u0dbd\u0d82\u0d9c\u0dd0\u0dca \u0dbd\u0d82 \u0dcf\u0d9a \u0dbd\u0d82 \u0dba\u0dca \u0da7\u0dca \u0dbd\u0d82\u0dca\u0dd0\u0dad\u0dd2\u0dc0. \u0dbd\u0d82\u0db8\u0d9a \u0dbd\u0d82\u0d92 \u0dbd\u0d82 \u0dcf\u0d9a \u0dbd\u0d82 \u0da7\u0dc5\u0dda, \u0dbd\u0d82\u0db8\u0dd6\u0d9a\u0dba \u0dbd\u0d82\u0dbb \u0dca\u0dc0\u0dd2\u0dca \u0dbd\u0d82\u0d9a\u0db6\u0d9a \u0dbd\u0d82\u0da7\u0dba\u0dca \u0dbd\u0d82\u0da7 \u0dbd\u0d82\u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dbd\u0d82\u0d85\u0dca\u0db6\u0dd4\u0dba \u0dbd\u0d82\u0d9c\u0dd0\u0dca\u0dba\u0dd2. \u0dbd\u0d82\n\n\u0db8\u0db8 \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0d85\u0dc4\u0db8\u0dd2\u0dca \u0dbd\u0d82\u0dd2\u0dca \u0da7\u0dca \u0dbd\u0d82\u0da7 \u0dbd\u0d82\u0d9c\u0dd0\u0dad\u0dd2 \u0dca \u0dbd\u0d82 \u0dc5\u0db8\u0dca\u0d9a \u0dba\u0da7 \u0dbd\u0d82 \u0dba\u0dca \u0dca \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0dbb\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dbd\u0d82\u0d85\u0dba\u0da7\u0d9c\u0dca \u0dbd\u0d82\u0dad\u0dd2\u0da7\u0db6\u0dca \u0dbd\u0d82\u200d\u0dbb\u0dd2 \u0d9a\u0db8\u0d9a\u0dca\u0d9c \u0dbd\u0d82\u0da7\u0db8\u0d9a\u0dca\u0dc0\u0d9a\u0dba \u0dbd\u0d82\u0dd2\u0dbb \u0d9a\u0d9a\u0dba\u0dd2. \u0dbd\u0d82\u0da7 \u0dbd\u0d82\u0dc4\u0dd2\u0db8\u0dd2 \u0dca \u0da7\u0dda \u0dbd\u0d82\u0da7\u0dca\u0d9a\u0dc0 \u0dbd\u0d82\u0da7 \u0dbd\u0d82\u0d9c\u0dd0\u0dad\u0dd2 \u0dca \u0da7\u0dda \u0dbd\u0d82\u0dad\u0dd0 \u0d9a\u0da7 \u0dca \u0dbd\u0d82\u0dc4\u0dd2 \u0dca \u0dbd\u0d82\u0db8\u0db8\u0d9a\u0dca\u200d\u0dc0\u0d9a\u0daf\u0dd3 \u0dbd\u0d82 \u0dcf\u0d9a \u0dbd\u0d82\u0da7 \u0d9a\u0d9c \u0dca \u0dbd\u0d82\u0dd2\u0dbb \u0d9a\u0d9a \u0dbd\u0d82\u0db6\u0d9a \u0db4 \u0dbd\u0d82\u0dbb\u0dd4 \u0dbd\u0d82\u0dbb\u0dab\u0dca\u0da9\u0dd4\u0dc0, \u0dbd\u0d82\u0da7 \u0dbd\u0d82\u0d9c\u0dd0\u0dad\u0dd2 \u0dca \u0dbd\u0d82\u0dba\u0dc0\u0dc3\u0dd2\u0dca \u0dbd\u0d82\u0dba\u0dc0\u0db8 \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0da7 \u0dbd\u0d82\u0d8b\u0d9c\u0dd4\u0da7\u0dbd\u0dcf \u0dbd\u0d82 \u0dc0 \u0d9a \u0dbd\u0d82\u0dc4\u0dd2\u0dba \u0dbd\u0d82 \u0dba\u0db8\u0dd2\u0dca \u0dbd\u0d82\u0dc3\u0dd2\u0db8\u0dd2\u0dca\u0dc0\u0d9a. \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82 \u0db8\u