    "chunk_text": "\u0dc1\u0dab\u0dca\u0da9. \u0db8\u0db4 \u0d92 \u0d85\u0dba\u0dd2\u0dad\u0db8 \u0dc3\u0dd2 \u0dbd\u0dca\u0d9a \u0d9c\u0dd0\u0db1 \u0dc0\u0dd2\u0dc3\u0dda\u0dad\u0dbb \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9c\u0dc0\u0d9a\u0dc1\u0dc0\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0dc5\u0dd2 \u0d85\u0db4\u0db1 \u0db1 \u0dc3\u0dc4 \u0d86\u0db1 \u0db1 \u0d9a\u0dbb\u0db1 \u0daf\u0dca\u200d\u0dbb\u0dc0\u200d \u0d85\u0dad\u0dbb \u0d9c\u0dc0\u0db1\u0dc3 \u0d9c\u0dad\u0dca\u0d9c\u0dad\u0dc1\u0dad\u0dca\u0dc1 \u0d9c\u0d9a\u0dc1\u0db1\u0db8 \u0d85\u0da9\u0dd4\u0dc0\u0d9a\u0dca \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda minus \u0dad\u0db8\u0dba\u0dd2 \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dca\u0d9c\u0db1\u0dca. \u0d9c\u0dda\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0d87\u0dad\u0dca\u0dad. \u0d89\u0dad\u0dd2\u0db1\u0dca\u0dc1 \u0d85\u0dc5\u0dd2 \u0d85\u0db4\u0db4 \u0d9c\u0dbd\u0dc1\u0dbb\u0dd4 \u0d9a\u0dbb\u0d9c\u0db1\u0dca\u0db1 \u0d9c\u0dc4\u0dc1\u0d86 \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0db8 \u0d92\u0d9a\u0dba\u0dd2 \u0d9a\u0dd2 \u0db1\u0dca\u0d9c\u0db1\u0dca \u0db8\u0dc4 \u0d9c\u0db4\u0dc1\u0d9c\u0dc5\u0dc1\u0d9c\u0dda \u0dae\u0dc1\u0dbb\u0dca\u0dae \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dc1 \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dc1 \u0db8\u0dc4 \u0d9c\u0db4\u0dc1\u0d9c\u0dc5\u0dc1\u0dc0\u0db4 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0d9a\u0dc1 \u0dbd\u0d9a\u0db1\u0dca\u0db1\u0dc1 \u0d9a\u0d82\u0d9a\u0dc1\u0d9c\u0dda \u0db4\u0dca\u200d\u0dbb\u0db0\u0dc1\u0db1 \u0d9c\u0db4 \u0d9c\u0dc5\u0dda \u0d85\u0db4\u0db1 \u0db1\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0db4 \u0d9a\u0dae\u0dc1 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd2 \u0d9a\u0dc1. \u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda \u0d94\u0dbd\u0db8 \u0d9c\u0da7\u0db1\u0dca \u0dc4\u0daf\u0dca\u200d\u0d9a\u0dc1 \u0dbd\u0d9a\u0db1\u0dca\u0db1\u0dc1 \u0d85\u0db4\u0db1 \u0db1\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d85\u0db4\u0db1 \u0db1 \u0dc0\u0dd0\u0db4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9c\u0db8\u0dc1\u0db1\u0dc0\u0dc1\u0daf\u0dca\u200d \u0d9a\u0dbb\u0d9a\u0dc1 \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dca\u0d9c\u0db1\u0dca \u0d9a\u0dd2 \u0d9a\u0dc1. \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0db4 \u0d92 \u0d85\u0db4\u0db1 \u0db1 \u0dc0\u0dd0\u0db4 \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1 \u0d94\u0dbd \u0d9c\u0db8\u0dc1\u0db1\u0dc0\u0dc1\u0daf\u0dca\u200d \u0d9a\u0dbb\u0d9a\u0dc1 \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dca\u0d9c\u0db1\u0dca \u0d9a\u0dd2 \u0dc1\u0dad\u0dca \u0dbd\u0d9a\u0db1\u0dca\u0db1."
  },
