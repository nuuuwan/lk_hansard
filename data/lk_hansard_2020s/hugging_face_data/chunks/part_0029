    "chunk_text": "\u0d9c\u0d9c\u0ddd\u0db0\u0dc1 \u0d9c\u0dda \u0d9a\u0dc1\u0d9a\u0d9c\u0dda\u0dad\u0dca \u0d85\u0db4\u0d9a \u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0da7\u0dc1 \u0d9c\u0db1\u0dca\u0dc1 \u0dc3\u0dd3\u0dad\u0dc1 \u0d9a\u0dd2 \u0d9a\u0dc1 \u0d9c\u0db1\u0ddd\u0db1\u0dc1 \u0d9c\u0d9a\u0d9c\u0db1\u0db1\u0db8\u0d9c\u0dda. \u0d85\u0dbb torch \u0d91\u0d9a\u0db1\u0db8\u0dba\u0dd2\u0dc1 \u0db1\u0db8\u0da9 \u0db1\u0db8\u0dba\u0dd2 \u0d9c\u0dad\u0dca\u0dad \u0d91\u0d9a\u0dca\u0d9c\u0d9a\u0db1\u0dc1. \u0daf\u0dca\u200d\u0dd0\u0db1\u0dca \u0d9c\u0dda \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0d9a\u0dc1\u0d9a\u0d9c\u0dda\u0dad\u0dca \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0d9a\u0dc1 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dc1\u0dc1 \u0dc3\u0dd3\u0dad\u0dc1 \u0d9a\u0dd2 \u0d9a\u0dc1 \u0d9c\u0db1\u0ddd\u0db1\u0dc1 \u0d9c\u0d9a\u0d9c\u0db1\u0d9a\u0dca. \u0d9c\u0daf\u0dca\u200d\u0d9a\u0db8 \u0d91\u0d9a\u0db8 model. \u0d92\u0d9c\u0d9a\u0dca \u0dc4\u0dd2\u0da7\u0dd2 \u0dc1\u0dc1 \u0dc0\u0dd2 \u0dad\u0dca\u0db8 \u0d9c\u0dda \u0d9a\u0dab\u0dca\u0da9\u0dc1 \u0db8\u0d9a\u0dca. \u0d92 \u0dc0\u0dc1\u0d9c\u0dda \u0d9a\u0dab\u0dca\u0da9\u0dc1 \u0db8\u0d9a\u0dca \u0d9c\u0dda\u0d9a \u0d87\u0dad\u0dd4\u0d9c\u0dc5\u0dad\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dc1. \u0d91\u0daf\u0dca\u200d\u0dc1\u0dad\u0dca \u0dc3\u0dd3\u0dad\u0dc1 \u0d9c\u0db1\u0ddd\u0db1\u0dc1 \u0d9c\u0d9a\u0d9c\u0db1\u0d9a\u0dca \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0d9a\u0dc1 \u0dc4\u0dd2\u0da7\u0dd2 \u0dc1. \u0d9c\u0dda \u0dc0\u0dad\u0dc1\u0d9c\u0dda\u0dad\u0dca \u0dc3\u0dd3\u0dad\u0dc1 \u0d9a\u0dd2 \u0d9a\u0dc1 \u0d9c\u0db1\u0ddd\u0db1\u0dc1 \u0d9c\u0d9a\u0d9c\u0db1\u0d9a\u0dca \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0d9a\u0dc1 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dc1.\n\n\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c \u0ddd\u0da2\u200d \u0d9a\u0dc1\u0dbb\u0d9a \u0dc3 \u0dc1 \u0dc3 \u0dc1\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0dd2\u0dba \u0db1\u0dd2\u0dc1 \u0d9c\u0dda 76 \u0dc0\u0dc3\u0d9c\u0dbb\u0db8 \u0d9c\u0dda\u0d9c\u0d9a\u0dca \u0d9c\u0db8\u0dc1\u0db1\u0db8\u0dad\u0dca \u0d9c\u0dc0\u0d9a\u0dc1 \u0db1\u0dd0\u0dc4\u0dd0. \u0d9c\u0d9c\u0dc1\u0dc0\u0dd2 \u0da2\u0db1\u0db4\u0daf\u0dca\u200d \u0dc0\u200d\u0dc1\u0db4\u0dc1\u0dbb \u0db6\u0dd2\u0dc4\u0dd2 \u0dc0\u0dd4\u0d9c\u0dab\u0dca \u0d9c\u0d9a\u0dc1\u0dba\u0dd2 \u0d9a\u0dc1\u0d9a\u0d9c\u0dda\u0daf\u0dca\u200d \u0daf\u0dca\u200d\u0db1\u0dca\u0d9c\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0dc4\u0d9c\u0db4\u0dc1\u0dc5 \u0d9a\u0dc2\u200d\u0dad\u0dca\u0dc0 \u0dd4\u0dc0\u0db1\u0dca\u0d9c\u0db1\u0dca\u0dc1 \u0dda\u0daf\u0dca\u200d\u0dc1 \u0d9c\u0dda\u0db8\u0dc1\u0db1 \u0dc4\u0dd0\u0dd4\u0dc0\u0d9c\u0dda \u0d9a\u0dc0\u0dd4\u0daf\u0dca\u200d? \u0d85\u0db4\u0db1 \u0db1 \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0d9c\u0dd0\u0db1 \u0daf\u0dca\u200d\u0dd0\u0db1\u0dca \u0db8\u0dc4 \u0d9c\u0d9a\u0dc1\u0db1\u0db8\u0dc0\u0db4 \u0d9a\u0dae\u0dc1 \u0d9a\u0dc5\u0dc1\u0db4\u0dc1 \u0d9c\u0da2\u0dca\u0dd3\u0dc5\u0dd2 \u0d91\u0d9a 1988-89 \u0d9a\u0dc1\u0d9a\u0d9c\u0dda \u0d9c\u0dda \u0dbb\u0db4 \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dd2\u0dda\u0dbd\u0dc1\u0db4 \u0db4\u0dc3\u0dda\u0d9c\u0dc3\u0dda\u0dc1 \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0d9a\u0da9\u0dc1\u0d9a\u0db4\u0dca\u0db4\u0dbd\u0dca \u0d9a\u0dbb\u0d9a\u0dc1 \u0dc0\u0dd2\u0db1\u0dc1\u0db1 \u0d9a\u0dbb\u0d9a\u0dc1 \u0daf\u0dca\u200d\u0dd0\u0dda\u0db8\u0dc1\u0db4 \u0db4\u0dc3\u0dda\u0d9c\u0dc3\u0dda \u0d87\u0dd9\u0dbd\u0dd4\u0dda \u0d9a\u0dbb\u0dca\u0db8\u0dc1\u0db1\u0dca\u0dad\u0db1\u0dc1\u0d9a\u0dc1 200\u0d9a\u0dca \u0dc4\u0daf\u0dca\u200d\u0d9a\u0dc1 \u0d87\u0dd9\u0dbd\u0dd4\u0dda \u0d85\u0db4\u0db1 \u0db1\u0d9c \u0db1\u0dca \u0dc0\u0dd2\u0db1\u0dc1\u0d9a \u0d85\u0db4\u0db1 \u0db1 \u0d86\u0daf\u0dca\u200d\u0dc1 \u0db8\u0d9a\u0dca \u0d9c\u0dda \u0dbb\u0db4\u0db4 \u0d9c\u0d9c\u0d9c\u0db1\u0db1\u0dca\u0db1 \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0d9c\u0dc5\u0dda \u0dbb\u0da7\u0dc3\u0dd2\u0d82\u0dc4 \u0d9c\u0dda\u0db8\u0daf\u0dca\u200d\u0dc1\u0dc3 \u0db8\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dc1\u0dba\u0dd2. [\u0dbd\u0dc1\u0db0\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dca] \u0d89\u0db1\u0dca\u0db1\u0dc1 \u0d89\u0db1\u0dca\u0db1\u0dc1 \u0d9c\u0db4\u0dc1\u0da9\u0dca\u0da9\u0d9a\u0dca \u0d89\u0db1\u0dca\u0db1. \u0d85 \u0dc4\u0d9c\u0d9c\u0db1 \u0d89\u0db1\u0dca\u0db1\u0dc1 \u0db4\u0dab\u0dca\u0db4\u0dad \u0d9c\u0dc0\u0db1\u0dca\u0d9c\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd2\u0dc0. [\u0dbd\u0dc1\u0db0\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dca]\n\n\u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c \u0ddd\u0da2\u200d \u0d9a\u0dc1\u0dbb\u0d9a \u0dc3 \u0dc1 \u0dc3 \u0dc1\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0dd2\u0dba \u0db1\u0dd2\u0dc1 \u0db1\u0dd2\u0daf\u0dca\u200d\u0dc4\u0dc3\u0dda \u0d85\u0db0\u200d\u0dc1\u0db4\u0db1 \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0dc1 \u0dd4\u0dc0\u0db1\u0dca\u0d9c\u0db1\u0dca \u0d9c\u0d9a\u0dc1\u0dba\u0dd2 \u0d9a\u0dc1\u0d9a\u0d9c\u0dda\u0daf\u0dca\u200d? \u0db4\u0dc3\u0dd4\u0d9c\u0dd2 76 \u0dc0\u0dc3\u0dbb \u0dad\u0dd4\u0dc5 \u0dad\u0db8\u0dba\u0dd2 \u0d9c\u0dda \u0dda\u0daf\u0dca\u200d\u0dc1\u0dc0 \u0dc0\u0dd0\u0da9\u0dc3\u0db4\u0dc4\u0db1 \u0d86\u0dbb\u0dda \u0dc0\u0dd4\u0d9c\u0dab\u0dca\u0dc1 \u0dc0\u0dd2\u0d9a\u0dca\u0d9c\u0db4\u0ddd\u0dbb\u0dd2 \u0dc1 \u0dc3\u0dc4 \u0dbb\u0db1\u0dca\u0d9c\u0daf\u0dca\u200d\u0db1\u0dd2\u0d9c\u0d9a \u0da2\u0d9a\u0dc1\u0db1 \u0dc4\u0dd0\u0dd4\u0dc0\u0d9c\u0dab\u0dca. \u0dc4\u0dd0\u0dbd\u0dd0\u0dba\u0dd2\u0dc1 \u0d92 76 \u0dc0\u0dc3\u0dbb \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0dad\u0dd4\u0dab\u0dca\u0da9\u0dd4 \u0d9a\u0dd1\u0dbd\u0dca\u0d9c\u0d9a\u0db1\u0dca \u0dbb\u0db4 \u0dc0\u0dd0\u0dc4\u0dd4\u0d9c\u0dda\u0dc1 \u0dd2\u0dba\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4\u0db1\u0dca\u0d9c\u0dda \u0d9c\u0dbd\u0dbd\u0dca\u0d9a\u0db4 \u0d9c\u0dc0\u0db4 \u0dad\u0dd2 \u0d9a\u0dc1 \u0db8\u0dd0\u0dbb\u0dd4\u0d9c\u0dda\u0dc1 \u0d9a\u0db9 \u0daf\u0dca\u200d\u0dc1\u0d9a\u0dc1 \u0d87\u0daf\u0dca\u200d\u0d9c\u0d9c\u0db1 \u0d9c\u0dd2\u0d9c\u0dda. \u0d95\u0dc0\u0dc1 \u0db4\u0dbb\u0da7 \u0dc4\u0dd2\u0db1\u0dca\u0daf\u0dca\u200d\u0dc1 \u0d85\u0dc5\u0dd2 \u0d9a\u0dae\u0dc1 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2 \u0db1\u0dd0\u0dc4\u0dd0. \u0dc4\u0dd0\u0dbd\u0dd0\u0dba\u0dd2\u0dc1 \u0d9c\u0dda \u0db1\u0db8\u0dc4\u0d9a \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dc1\u0db1 \u0db1\u0dd2\u0dc3\u0dc1 \u0d85\u0dc5\u0dd2 \u0d95\u0dc0\u0dc1 \u0d9a\u0dd2 \u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0daf\u0dca\u200d\u0dd0\u0db1\u0dca \u0d94 \u0d9a\u0dae\u0dc1 \u0d87\u0dad\u0dd4 \u0d9c\u0dc5\u0dda\u0db8 \u0d9a\u0dd2\u0dda\u0dc0\u0dc1 \u0d9c\u0db1\u0dca\u0dc1 1983\u0daf\u0dd3 \u0dad\u0db8\u0dba\u0dd2 EDB \u0d91\u0d9a \u0dc0\u0dc1\u0d9c\u0dda \u0daf\u0dca\u200d\u0dd0\u0dc0\u0dd0\u0db1\u0dca\u0dad \u0d86 \u0dad\u0db1 \u0d9a\u0dca \u0dc4\u0dd0\u0dd4\u0dc0\u0d9c\u0dda \u0d9a\u0dd2 \u0d9a\u0dc1. \u0d91\u0dad\u0d9c\u0d9a\u0dc1\u0db4 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2 76 \u0dc0\u0dc3\u0dbb \u0d87\u0dad\u0dd4\u0d9c\u0dc5\u0dda \u0d9c\u0db1\u0dc1\u0d9c\u0dc0\u0dba\u0dd2\u0daf\u0dca\u200d \u0d92\u0d9a \u0dc4\u0dd0\u0dd4\u0dc0\u0d9c\u0dda? 76 \u0dc0\u0dc3\u0d9c\u0dbb\u0db1\u0dca \u0dc5\u0dd2\u0db4\u0daf\u0dca\u200d \u0d92\u0d9a \u0dc4\u0dd0\u0dd4\u0dc0\u0d9c\u0dda? \u0d9c\u0db8\u0dad\u0dd0\u0db1 \u0d85\u0dac \u0d85\u0dac\u0dc1 \u0d89\u0db1\u0dca\u0d9c\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0dc0\u0dd0\u0d9c\u0da9\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1.\n\n\u0da2\u0db1\u0dc1\u0d9a\u0dbb\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dc1 \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0da7 \u0db4 \u0d9a\u0dd2\u0db1\u0dca \u0d87\u0dc4\u0dd4\u0dc0\u0dc1\u0dc1 refineries \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1\u0dc1 \u0d9c\u0dad\u0dbd\u0dca \u0d9c\u0d9c\u0db1\u0dd0\u0dbd\u0dca\u0d9a\u0dc1 \u0dc0\u0dd2\u0db1\u0db8\u0da7\u0db1 \u0d91\u0d9a \u0db8\u0dc4 \u0d9a\u0da2\u0dca\u0da2\u0d9a\u0dca\u0daf\u0dca\u200d \u0d9a\u0dd2 \u0d9a\u0dc1. \u0d92\u0dc0\u0dc1 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d86\u0dab\u0dca\u0da9\u0dd4 \u0d95\u0db1\u0dd1\u0daf\u0dca\u200d \u0d9a\u0dd2 \u0dc1\u0dad\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0d87\u0dc4\u0dd4\u0dc0\u0dc1. \u0d91\u0dad\u0dd4\u0db8\u0dc1 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc1\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0d9c\u0d9a\u0dc1\u0db4 \u0d9c\u0db4\u0dbb\u0dbd\u0dca \u0dbd\u0dd3\u0db4\u0dbb \u0d9a\u0dca \u0dbb\u0dd4\u0dc5\u0dd2 \u0dbd\u0dca 290\u0dba\u0dd2. \u0dc4\u0dd0\u0dbd\u0dd0\u0dba\u0dd2 \u0daf\u0dca\u200d\u0dd0\u0db1\u0dca \u0d9c\u0db4\u0dbb\u0dbd\u0dca \u0dbd\u0dd3\u0db4\u0dbb \u0d9a\u0dca \u0dbb\u0dd4\u0dc5\u0dd2 \u0dbd\u0dca 424\u0dba\u0dd2. \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c \u0ddd\u0da2\u200d \u0d9a\u0dc1\u0dbb\u0d9a \u0dc3 \u0dc1 \u0dc3 \u0dc1\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0dd2\u0dba \u0db1\u0dd2\u0dc1 \u0d94\u0dbd\u0dad\u0dd4\u0dd2\u0dba \u0d9a\u0dc1\u0db1\u0dca\u0dad\u0dc1\u0dc0\u0d9a\u0dca \u0dc0\u0dd2\u0d9a\u0dbb \u0db4 \u0d9c\u0db4\u0dc1\u0dc5\u0db4 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0d9a\u0dc1 \u0dbd\u0d9a\u0db1\u0dca\u0db1\u0dc1 \u0d9a\u0d9c\u0da9\u0dca\u0db4 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0d9a\u0dc1 \u0dbd\u0d9a\u0db1\u0dca\u0db1\u0dc1 \u0d91\u0daf\u0dca\u200d\u0dc1 \u0dbb\u0dd4\u0dc5\u0dd2 \u0dbd\u0dca 10\u0dc1000\u0db4 \u0d9c\u0dad\u0dca\u0dad \u0dbd\u0da9\u0dd4 \u0db8\u0dbd\u0dca\u0d9a\u0db4 \u0d85\u0daf\u0dca\u200d \u0dbb\u0dd4\u0dc5\u0dd2 \u0dbd\u0dca 15\u0dc1000\u0d9a\u0dca \u0d9c\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0db1\u0dd0 \u0daf\u0dca\u200d \u0d9a\u0dd2 \u0d9a\u0dc1. \u0dad\u0dd4\u0d9c\u0db1\u0db1\u0dca \u0d91\u0d9a\u0d9a\u0dd2\u0db1\u0dca \u0d85\u0da9\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dc1 \u0d9a\u0dd2 \u0db4\u0dd4 \u0dc0\u0dd2\u0dd4\u0dc0\u0dd2 \u0db6\u0dd2\u0d9a \u0dad\u0dc0 \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0dc0\u0dd0\u0db4"
  },
