    "chunk_text": "\u0dbd\u0dca\u0d9a\u0dc1\u0dc3\u0db1\u0dc1\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2\u0dc1 \u0d87\u0dad\u0dca\u0dad\u0db4\u0db8 \u0d85\u0db4\u0db4 \u0d9a\u0dd0\u0db6\u0dd4\u0d9c\u0dab\u0dca \u0d9c\u0dbb\u0ddd\u0dc3 \u0db8\u0dbd\u0dca \u0dbd\u0db1\u0dca\u0d9c \u0dc3\u0dd2 \u0d9a\u0dca \u0db8\u0dad \u0dad\u0dbd\u0db4\u0dd4 \u0dbb\u0db4\u0d9a\u0dca \u0db1\u0dda \u0d9c\u0db1\u0dc1\u0d9c\u0dc0\u0dba\u0dd2. \u0db4\u0da7 \u0d85\u0daf\u0dd2\u0dd2\u0dba\u0db1\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dbb\u0db4\u0d9a\u0dca \u0dc4\u0dd4\u0dc3\u0dda\u0db8 \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4\u0dc0\u0dc0\u0db1\u0dca \u0dad\u0dbb\u0dd2\u0dba\u0db1\u0dca \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0dc3\u0dda\u0dae\u0dc1\u0dc0\u0dbb\u0dad\u0dca\u0dc0 \u0d9a\u0db4 \u0d9c\u0dda\u0db1\u0dca\u0db1 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0d9a\u0dca \u0dc0\u0dd2\u0d9a\u0dbb \u0db4 \u0d85\u0db4\u0db4 \u0dc4\u0dd0\u0d9a\u0dd2 \u0dc1\u0dc0 \u0d9a\u0dd0\u0db6\u0dd4\u0da7\u0dc1. \u0d85\u0d9c\u0db4\u0dca \u0d85\u0db4\u0db1 \u0db1 \u0d86\u0daf\u0dca\u200d\u0dc1 \u0db8 \u0d85\u0db1\u0dca \u0d9a\u0dc0\u0dbb\u0daf\u0dca\u200d\u0dc1\u0db4\u0dad\u0dca \u0dc0\u0da9\u0dc1 \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dca \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0d9c\u0d9c\u0db1 \u0dad\u0dd2\u0d9c\u0dbd\u0db1 \u0dba\u0dd4\u0d9c \u0d9a \u0d89\u0dd2 \u0dd2\u0dba\u0db1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4 \u0d9c\u0dda \u0d9c \u0ddd\u0da2\u0db1\u0dc1\u0dc0 \u0d9c\u0dda \u0d9c\u0dbb\u0dd4 \u0dc3 \u0dc1\u0dc0\u0db4 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0d9a\u0dc1 \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dca\u0d9c\u0db1\u0dca.\n\n\u0dbd\u0dca\u0d9a\u0dc1\u0dc3\u0db1\u0dc1\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2\u0dc1 \u0d85\u0db4 \u0d85\u0daf\u0dca\u200d \u0d9c\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0d9c\u0db1\u0dca \u0d9c\u0d9a\u0ddd\u0d9a \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0d9c\u0dda \u0dc0\u0dd2\u0db1\u0dc1\u0d9a\u0dad\u0db8 \u0d85\u0db7\u0dd2\u0d9c \u0ddd\u0d9c \u0db1\u0dca\u0db4 \u0dc3\u0dc4 \u0d9c\u0dc0\u0db1\u0dc3\u0dda\u0dd3\u0dda\u0dc0\u0d9a\u0db4 \u0db8\u0dd4\u0dc4\u0dd4\u0da7 \u0daf\u0dd3\u0db8\u0db4 \u0dc3\u0dd2\u0dd4\u0dc0 \u0d9c\u0dc0\u0d9a\u0dc1 \u0dad\u0dd2\u0d9c\u0dbd\u0db1 \u0d9a\u0dc1\u0d9a \u0d9a. \u0db8\u0dd0\u0daf\u0dca\u200d \u0d9c\u0db4\u0dbb\u0daf\u0dd2\u0d9c \u0d9a\u0d9a\u0dc1\u0db4\u0d9c\u0dda \u0dba\u0dd4\u0daf\u0dca\u200d\u0db8 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0dc1 \u0db7\u0dd6-\u0d9c \u0db1\u0db4\u0dc1\u0d9a\u0db1\u0db8 \u0d9c\u0dd0\u0da7\u0dd4\u0dda\u0dc1 \u0da2\u0dc1\u0dad\u200d\u0db1\u0dca\u0dad\u0dbb \u0d9c\u0dc0\u0d9c\u0dc5\u0d86 \u0d9c\u0db4\u0dc1\u0d9c\u0dc5\u0dda \u0d85\u0dc0\u0dd2\u0db1\u0dd2\u0db1\u0dda\u0da0\u0dd2\u0dad\u0dad\u0dc1\u0dc1 \u0db1\u0dc1\u0dc0\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dc1\u0dc4\u0db1 \u0dc5\u0dd2\u0dbb\u0dd2\u0dc0\u0dd0 \u0d89\u0dc4\u0dc5 \u0dd1\u0db8 \u0db1\u0dd2\u0dc3\u0dc1 \u0d85\u0db4\u0d9c\u0dda \u0db1\u0dd2\u0dc2\u0dda\u0db4\u0dc1\u0daf\u0dca\u200d\u0db1 \u0dc5\u0dd2\u0dbb\u0dd2\u0dc0\u0dd0 \u0d89\u0dc4\u0dc5 \u0dd1\u0db8 \u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0db7\u0dd2\u0d9c \u0ddd\u0d9c\u0d9a\u0dc1\u0dbb\u0dd2 \u0d85\u0dc0\u0dc3\u0dda\u0dae\u0dc1\u0dc0\u0d9a \u0dc3\u0dd2\u0db4 \u0dc0\u0dd4\u0dc0\u0daf\u0dca\u200d\u0dc1 \u0d92 \u0d85\u0db7\u0dd2\u0d9c \u0ddd\u0d9c\u0dc0\u0d9a\u0db4 \u0d89\u0dad\u0dc1\u0db8 \u0dc3\u0dc1\u0dbb\u0dca\u0dae\u0d9a\u0dc0 \u0db8\u0dd4\u0dc4\u0dd4\u0da7 \u0daf\u0dd3\u0db4\u0dd4 \u0dbb\u0db4\u0d9a\u0dca \u0dc0\u0dd2\u0d9a\u0dbb \u0db4 \u0d85\u0db4\u0db4 \u0d85\u0db7\u0dd2\u0db8\u0dc1\u0db1 \u0d9a\u0dca \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1\u0dc1 \u0d85\u0d9c\u0db4\u0dca \u0d85\u0db4\u0db1 \u0db1 \u0d9a\u0dca\u0d9c\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dda\u0dbd\u0db1\u0dca\u0db0\u0dc0.\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0d82\u0d9a\u0dc1 \u0d85\u0db4\u0db1 \u0db1 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db8\u0dab\u0dca\u0da9\u0d9a\u0d9c\u0dda \u0daf\u0dca\u200d\u0dad\u0dca\u0dad\u0dc0\u0d9a\u0db4 \u0d85\u0db1\u0dd4\u0dc0\u0dc1 \u0d9c\u0dda \u0dc0\u0dc3\u0d9c\u0dbb\u0dca \u0da2\u0db1\u0dc0\u0dc1\u0dbb\u0dd2\u0dc0\u0d9a \u0d89\u0d86\u0d9a\u0dc1 \u0dc3\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0dda\u0dbd\u0dbb\u0dca \u0db8\u0dc1\u0dc3 \u0daf\u0dca\u200d\u0d9a\u0dca\u0dc0\u0dc1 \u0dc0\u0db1 \u0db8\u0dc1\u0dc3 9\u0d9a \u0d9a\u0dc1\u0d9a \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0d85\u0dc5\u0dd2 \u0dc1\u0dab\u0dca\u0da9 \u0dc4\u0dc1 \u0d9c\u0dc3\u0dda\u0dc0\u0dc1 \u0d85\u0db4\u0db1 \u0db1 \u0d86\u0daf\u0dca\u200d\u0dc1 \u0db8 \u0d9c\u0d9a\u0dc3 \u0d9c\u0da9\u0dc1\u0d9a\u0dbb\u0dca \u0db6\u0dd2\u0dd2 \u0db1 13.66\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dca \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1 \u0dc3\u0db8\u0dad\u0dca \u0d9c\u0dc0\u0d9a\u0dc1 \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1. \u0d87\u0dad\u0dca\u0dad\u0db4\u0db8 \u0d9c\u0dda\u0d9a \u0dbb\u0db4\u0d9a\u0dca \u0dc0\u0dd2\u0d9a\u0dbb \u0db4 \u0d85\u0db4 \u0d9a\u0dd0 \u0db4 \u0da2 \u0d9c\u0dca\u200d\u0dbb\u0dc4\u0da7 \u0d9a\u0dca \u0dbd\u0dc0 \u0db8\u0db8 \u0d9c\u0dda \u0d9c\u0dc0\u0d9a\u0dc1\u0d9c\u0dda \u0d9a\u0dd2 \u0db1\u0dca\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dd2. \u0d85\u0dc5\u0dd2 \u0d91\u0db8 \u0da2 \u0d9c\u0dca\u200d\u0dbb\u0dc4\u0da7 \u0d9c\u0d9a\u0da7\u0dd2 \u0d9a\u0dc1\u0d9a \u0d9a\u0dca \u0dad\u0dd4\u0dc5 \u0d9a\u0dd0\u0db6\u0dd4\u0dc0\u0dc1 \u0dc0\u0dd4\u0dc0\u0dad\u0dca\u0dc1 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2 \u0dc0\u0dc3\u0dbb\u0dc0\u0d9a\u0db4 \u0dc3\u0dc1\u0d9c\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dc0 \u0dc3\u0dd2 \u0db4 5.41\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dca \u0d85\u0dc5\u0dd2 \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0d9c\u0d9c\u0db1 \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1. \u0dc1\u0dab\u0dca\u0da9 \u0d85\u0db4\u0db1 \u0db1\u0d9c \u0db1\u0dca \u0d9c\u0da9\u0dc1\u0d9a\u0dbb\u0dca \u0db6\u0dd2\u0dd2 \u0db1 10.76\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db1\u0db8\u0dad\u0dca\u0dc1 \u0d9c\u0dc3\u0dda\u0dc0\u0dc1 \u0d85\u0db4\u0db1 \u0db1\u0d9c \u0db1\u0dca \u0d9c\u0da9\u0dc1\u0d9a\u0dbb\u0dca \u0db6\u0dd2\u0dd2 \u0db1 2.85\u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db1\u0db8\u0dad\u0dca \u0d85\u0dc5\u0dd2 \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0d9c\u0db1\u0dca\u0db1 \u0dc3\u0db8\u0dad\u0dca \u0d9c\u0dc0\u0d9a\u0dc1 \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1. \u0dc0\u0dd2\u0d9c\u0db1\u0dda\u0dc2\u0d9c \u0db1\u0dca 2026 \u0dc3\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0dda\u0dbd\u0dbb\u0dca \u0db8\u0dc1\u0dc3\u0d9c\u0dda \u0d85\u0db4\u0db1 \u0db1 \u0d86\u0daf\u0dca\u200d\u0dc1 \u0db8 \u0d9c\u0da9\u0dc1\u0d9a\u0dbb\u0dca \u0db6\u0dd2\u0dd2 \u0db1 1.69 \u0daf\u0dca\u200d\u0d9a\u0dca\u0dc0\u0dc1 \u0d89\u0dc4\u0dc5 \u0d9c\u0d9c\u0dc1\u0dc3\u0dda \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1. \u0d92\u0d9a \u0db8\u0dc1\u0dc3 \u0d9a\u0dca \u0dad\u0dd4\u0dc5 \u0dc0\u0dc1\u0dbb\u0dca\u0dad\u0dc1\u0d9c\u0dad \u0dc0\u0dd4\u0dab\u0dd4 \u0d89\u0dc4\u0dc5\u0db8 \u0d85\u0db4\u0db1 \u0db1 \u0d86\u0daf\u0dca\u200d\u0dc1 \u0db8 \u0d9c\u0d9a\u0dc3 \u0daf\u0dca\u200d\u0d9a\u0dca\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dd4\u0dc0\u0dc0\u0db1\u0dca. \u0d91\u0db8 \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dad\u0dd2\u0dbb\u0dc3\u0dc1\u0dbb \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dca \u0dbd\u0dc0\u0db4 \u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0db4 \u0d85\u0dc5\u0dd2 \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0d9c\u0dbd\u0db1\u0dc0\u0dc1 \u0dc3\u0dc4 \u0d92 \u0dc3\u0d86\u0dc4\u0dc1 \u0dda\u0db4\u0dc1 \u0db8\u0dc1\u0dbb\u0dca\u0d9c\u0dd2\u0d9a \u0dc3\u0dd0\u0d9a\u0dc3\u0dd4\u0dda \u0dc3\u0d9a\u0dc3\u0dda \u0d9a\u0dbb \u0d85\u0dc0\u0dc3\u0db1\u0dca. \u0d85\u0db4\u0db1 \u0db1 \u0d86\u0daf\u0dca\u200d\u0dc1 \u0db8 \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dad\u0dca \u0d85\u0d9c\u0db4\u0dca \u0da2\u0dc1\u0dad\u0dd2\u0d9a \u0dc3\u0dd0\u0d9a\u0dd0\u0dc3\u0dda\u0d9c\u0dda \u0d91\u0d9a\u0dca \u0d9c\u0d9a\u0dc1\u0db4\u0dc3\u0d9a\u0dca."
