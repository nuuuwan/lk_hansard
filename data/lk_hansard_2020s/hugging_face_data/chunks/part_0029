d\u0d82\u0dc0\u0dd2\u0db8\u0dca\u0dba\u0dca \u0dbd\u0d82 \u0db4\u0dba\u0dd4\u0dd4 \u0dbd\u0d82 \u0dc0\u0daf\u0dd4\u0dba\u0db4 \u0d9a \u0dbd\u0d82\u0dc3\u0dd2\u0daf\u0dd4 \u0dbd\u0d82\u0da7\u0dc0\u0db8\u0dd2\u0dca \u0dbd\u0d82\u0dad\u0dd2\u0da7\u0db6\u0dca\u0dc0\u0d9a.\n\n(\u0dbb)\n\n(\u0d87) \u0dbd\u0d82 \u0db8\u0dc4 \u0dbd\u0d82(\u0d88) \u0dbd\u0d82\u0dca\u200d\u0dbb\u0dba\u0dda\u0dca \u0dbd\u0d82\u0db8\u0db3\u0dc4\u0d9a \u0dbd\u0d82\u0db4\u0dd2\u0dc5\u0dd2\u0dd4\u0dbb\u0dd4 \u0dad\u0dc4 \u0dbd\u0d82\u0dad\u0dd2\u0db8\u0daf\u0dd2 \u0dbd\u0d82\u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db4\u0dad\u0d9c \u0dbd\u0d82\n\n\u0dba\u0dca\u0dc0\u0d9a. \u0dbd\u0d82\n\n1. \u0d85\u0dd4\u0dbb\u0dd4\u0dba\u0dca \u0dbd\u0d82\u0dc0\u0dd3\u0db8\u0db4\u0dad - \u0dbd\u0d82\u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 \u0dbd\u0d8201\n\n2. \u0db8\u0db1\u0dd4\u0dc2\u0dca\u0da8\u0dba \u0dbd\u0d82\u0d9d\u0d9a \u0dca - \u0dbd\u0d82\u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 \u0dbd\u0d8202\n\n3. \u0db8\u0db8\u0dd6\u0dc4 \u0dbd\u0d82\u0db8\u0db1\u0dd4\u0dc2\u0dca\u0da8\u0dba \u0dbd\u0d82\u0d9d\u0d9a \u0dca - \u0dbd\u0d82\u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 \u0dbd\u0d8203\n\n4. \u0da7\u0dc0\u0dca \u0d9a \u0dbd\u0d82\u0db6\u0dba\u0dad \u0dc5 \u0dbd\u0d82\u0d9c\u0da7\u0da7\u0dda \u0dbd\u0d82\u0dc0\u0dd0\u0dbb\u0dd0\u0daf\u0dd2 - \u0dbd\u0d82\u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 \u0dbd\u0d8204\n\n\u0dd2\u0dc4 \u0dbd\u0d82\u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db4\u0dad \u0dbd\u0d8201, \u0dbd\u0d8202, \u0dbd\u0d8203 \u0dbd\u0d82\u0db8\u0dc4 \u0dbd\u0d8204 \u0dbd\u0d82\u0db8\u0db8 \u0dbd\u0d82\u0dc3\u0db7\u0dcf\u0d9c\u0dad* \u0dbd\u0d82 \u0dba\u0dca\u0dc0\u0d9a. \u0dbd\u0d82\n\n(\u0dd2) \u0dbd\u0d82 \u0d8b\u0dd4\u0dbb\u0dd4 \u0dbd\u0d82\u0dc4\u0d9a \u0dbd\u0d82\u0dca\u0dd0 \u0dbd\u0d82\u0da7\u0d9f\u0dca\u0dc4\u0dd2\u0dba \u0dbd\u0d82\u0dad\u0dc5\u0d9a \u0d9a\u0dc0\u0d9a \u0dbd\u0d82\u0dad\u0dd0\u0dc0\u0dd0\u0dad\u0dd2 \u0dbd\u0d82\u0db8\u0dca \u0dca\u0daf\u0dca\u0daf\u0db0 \u0dbd\u0d82\u0d9c\u0dd0\u0db8\u0dca\u0db4\u0dad \u0dbd\u0d82\n\n\u0db8\u0db8\u0da7\u0dda \u0dbd\u0d82\u201cChannel 4\u201d \u0dc0\u0d9a\u0dca \u0d9a\u0db8 \u0dbd\u0d82\u0dc0\u0dd0\u0da9\u0db8\u0db4\u0dc4\u0dca \u0dbd\u0d82\u0db8\u0dca \u0dca \u0dbd\u0d82\u0dd2\u0daf\u0dd2\u0dd2\u0db8\u0dad \u0d9a \u0dbd\u0d82 \u0dba \u0dbd\u0d82\u0d87\u0dad\u0dd2 \u0dbd\u0d82\u0da7\u0da0\u0ddd\u0dba\u0dca\u0d9a \u0dbd\u0d82\u0db8\u0db4\u0dad\u0db6\u0dca \u0db0\u0da7 \u0dca \u0dbd\u0d82\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9a \u0dbd\u0d82\u0da7\u0dad\u0d9a\u0dd3\u0dc3\u0dd2 / \u0dbd\u0d82\u0d85\u0dad\u0dba\u0d9a\u0db0 \u0dbd\u0d82\u0dad\u0dd3\u0db8\u0dca\u0dc2\u0dca\u0da8\u0da7 \u0dbd\u0d82\u0da7\u0dba\u0dad\u0d9a\u0dca \u0da7\u0db4\u0dad\u0dca \u0dd4\u0dc0 \u0dbd\u0d82\u0db8\u0dca \u0dca \u0dbd\u0d82\u0dc0\u0dd2\u0db8\u0dca\u0dba\u0dca \u0dbd\u0d82\u0dd2\u0dbb\u0dc3\u0dd2\u0dc0\u0dca \u0dbd\u0d82\u0dc3\u0dd2\u0daf\u0dd4 \u0dbd\u0d82 \u0dba \u0dbd\u0d82\u0dca\u0dd0\u0dc4\u0dd0."
