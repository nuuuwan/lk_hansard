u0bbe\u0bb5\u0ba9\u0bcd\u0ba4\u0bbf\u0bb8\u0bcd\u0bb8\" \u0baf\u0bbe\u0b95\u0ba9\u0baf\u0bbf\u0ba9\u0bcd \u0b9a\u0bbf\u0b95\u0bbf\u0b9a\u0bcd\u0b95\u0b9a \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0b95 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd\n\n\u0bae\u0bb0\u0ba3\u0bae\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4 \u0bb5\u0bbf\u0b9a\u0bbe\u0bb0\u0b95\u0ba3 [\u0baa: 867] 17.10.2026 \u0b85\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba8\u0bbe\u0b9f\u0bb3\u0bbe\u0bb5\u0bbf\u0baf \u0bbe\u0bc0\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bbe\u0ba9 \u0bae\u0bbf\u0ba9\u0bcd \u0ba4\u0b95\u0b9f\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b95\u0bbe\u0bb0\u0ba3\u0bae\u0bcd [\u0baa: 882] 2026.10.17\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0ba8\u0bc6\u0bbe\u0b9f\u0bb3\u0bc6\u0bbe\u0bb5\u0bbf\u0baf \u0bc6\u0bbe\u0bc0\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bc8\u0bbf\u0ba9\u0bcd\n\n\u0ba4\u0bae\u0b9f: \u0bb5\u0bb2\u0bc1\u0b9a\u0b95\u0bcd\u0ba4\u0bbf \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bbe\u0bbf\u0ba9\u0ba4\u0bc1 \u0b95\u0bc2\u0bb1\u0bcd\u0bb1\u0bc1 [\u0baa: 891]\n\n\u0ba4\u0bb5\u0bb3\u0bbf\u0ba8\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0baa\u0bcd \u0baa\u0baf\u0b99\u0bcd\u0b95 \u0bb5\u0bc6\u0bbe\u0ba4\u0bbf\u0baa\u0bcd \u0bb0\u0baa\u0bc6\u0bbe \u0bc6\u0bbe\u0bb3\u0bbf\u0b95\u0bae\u0bb3\u0ba4\u0bcd \u0ba4\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\n\n\u0bc6\u0b9f\u0bcd\u0b9f\u0bae\u0bc2\u0bb2\u0bae\u0bcd: \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bae\u0bc1\u0b95\u0bb1 \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1 [\u0baa: 895]\n\n\u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bae\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0bc1\u0bb1\u0bcd\u0bb1\u0b9a\u0bcd\u0ba4\u0bc6\u0baf\u0bb2\u0bcd\u0b95\u0bae\u0bb3\u0ba4\u0bcd \u0ba4\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bc6\u0b9f\u0bcd\u0b9f\u0bae\u0bc2\u0bb2\u0bae\u0bcd: \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bae\u0bc1\u0b95\u0bb1 \u0bae\u0ba4\u0bbf\u0baa\u0bcd