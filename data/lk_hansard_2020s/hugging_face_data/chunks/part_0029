\u0db4\u0dcf\u0daf\u0dd9\u0dad\u0dca\u0dbb\u0db4\u0dcf\u0daf\u0dad\u0dca\u0dbb\u0db4\u0daf\u0dbd\u0db1\u0dbb\u0dbb\u0db1\u0dc0\u0db1\u0dbb\u0dca\u0dda\u0db4\u0d9a\u0dca\u0dca \u0dbb\u0d85\u0db1\u0dbb\u0dd9\u0dcf\u0db1\u0dbb\u0dd9\u0db4\u0dbb\u0dd2\u0dca\u0dbb\u0dc3\u0dca\u0dc4\u0dbb\u0d85\u0dcf\u0dca\u0dbb\u0dcf\u0dbb\u0dd2\u0db4\u0db1 \u0dbb\u0d9c\u0daf\u0dc3\u0dca\u0dad\u0dc5\u0dad\u0dbb\u0dc4\u0daf\u0dbb\u0d92\u0dcf\u0daf\u0dbb\u0d85\u0dcf\u0dc3\u0dca\u0daf\u0db1\u0dbb\u0dcf\u0dcf\u0db4\u0dbb\u0dc3\u0dca\u0dcf\u0d82\u0dd9\u0dc1\u0dba\u0dda \u0ddd\u0db0\u0db1\u0db1\u0dbb\u0db1\u0daf\u0dcf\u0dad\u0dca\u0dd9\u0daf\u0dbd\u0dd3\u0db1\u0dbb\u0dd9\u0dcf\u0dbb\u0dd4\u0db8\u0dcf\u0dbb\u0dcf\u0dbb\u0dca\u0dc2\u0db1\u0dbb\u0dd4\u0db8\u0dd4\u0dab\u0dd4\u0dca\u0dbb07 \u0dca\u0dd2\u0db1\u0dca \u0dbb\u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dbb\u0dd9\u0dcf\u0d9a\u0dca.\u0dbb\u0dc0\u0dcf\u0dba\u0dbb\u0dca\u0dc4\u0dbb\u0db1\u0d9c\u0dcf\u0dbb\u0dc3\u0dca\u0db7\u0daf,\u0dbb\u0db1\u0d9c\u0dcf\u0dbb\u0dc3\u0dca\u0db7\u0daf\u0dbb\u0dbb\u0da5\u0daf\u0dbb\u0db4\u0db1\u0dad\u0dca\u0dbb\u0dc4\u0daf\u0dbb\u0db4\u0dca\u200d\u0dbb\u0daf\u0dd9\u0daf\u0dca\u0dba \u0db1\u0dbb\u0dc3\u0dca\u0db7\u0daf\u0dbb\u0db4\u0db1\u0dc0\u0dbb\u0d85\u0db1\u0dd4\u0dcf\u0dbb\u0db1\u0dd2\u0db1\u0dca\u0dbb\u0dd9\u0dcf\u0dbb\u0dd4\u0db8\u0dcf\u0dbb\u0dd9\u0db4\u0dbb\u0dd2\u0dca\u0dbb\u0dc4\u0daf\u0dbb\u0d85\u0dcf\u0dca\u0dbb\u0dd9\u0dcf\u0dd9\u0dcf\u0dcf\u0dbb\u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dbb\u0d9c\u0daf\u0dc3\u0dca\u0dad\u0dc5\u0dad\u0dbb\u0db4\u0dc4\u0dc0\u0dbb\u0db4\u0dbb\u0dd2\u0daf\u0dd2\u0dbb\u0dd9\u0dda.\u0dbb\n\n\u0dc0\u0dcf\u0dba,\u0dbb\u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dbb\u0d9c\u0daf\u0dc3\u0dca\u0dad\u0dc5\u0dad,\u0dbb\u0dc3\u0dca\u0dc4\u0db8\u0dcf\u0dd9\u0dbb\u0dd2\u0dbb\u0dd3\u0db8\u0dd9 \u0dbb\u0d9c\u0daf\u0dc3\u0dca\u0dad\u0dc5\u0dad\u0dbb\u0dc4\u0daf\u0dbb\u0dba\u0da9\u0dbb\u0d85\u0db1\u0dbb\u0dd2\u0dbb\u0dd3\u0db8 \u0dcf\u0dbd\u0db4\u0dbb\u0d85\u0dba\u0daf\u0dcf\u0dcf\u0dbb\u0dca\u0dc4\u0daf\u0dbb\u0db1\u0d9c\u0dcf\u0dbb\u0dc3\u0dca\u0db7\u0daf\u0dbb\u0dbb\u0da5\u0daf\u0dbb\u0db4\u0db1\u0dc0, \u0db1\u0d9c\u0dcf\u0dbb\u0dc3\u0dca\u0db7\u0daf\u0dbb\u0dbb\u0da5\u0daf\u0db4\u0db1\u0dc0\u0dbb\u0dc3\u0dca\u0dc4\u0dbb\u0db4\u0dca\u200d\u0dbb\u0daf\u0dd9\u0daf\u0dca\u0dba \u0db1\u0dbb\u0dc3\u0dca\u0db7\u0daf\u0dbb\u0db4\u0db1\u0dc0\u0dbb\u0dc3\u0dca\u0dcf\u0d82\u0dd9\u0dc1\u0dba\u0dda \u0ddd\u0db0\u0db1\u0db1\u0dbb\u0dd2\u0dbb\u0dd3\u0db8\u0dca\u0db4\u0dbb\u0d85\u0dba\u0daf\u0dcf\u0dbb\u0dc3\u0dca\u0dcf\u0d82\u0dd9\u0dc1\u0dba\u0dda \u0ddd\u0db0\u0db1\u0dbb\u0db4\u0db1\u0dad\u0dca\u0dbb\u0dd9\u0dd9\u0da7\u0dd4 \u0db4\u0dad\u0dca\u0dbb\u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dd9\u0db4\u0daf\u0dd3\u0dbb\u0db4\u0daf\u0dbb\u0dca\u0dd2\u0dd9 \u0dca \u0dc5\u0dad\u0dcf\u0db4\u0dbb\u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dbb\u0dd2\u0dbb\u0dd3\u0db8\u0dca\u0db4\u0dbb\u0db1\u0dd2\u0db1\u0d9a\u0dca\u0dc0\u0dcf\u0dbb\u0dd4\u0dc0.\u0dbb\n\n7. \u0d9c\u0dd0\u0dc3\u0dca\u0dda\u0dbb\u0dd9\u0dcf\u0db1\u0dbb\u0dbd\u0dba\u0dbb\u0dd3\u0db8\u0dca\u0daf\u0dcf\u0dca \u0dbb\u0d85\u0dd2\u0db7\u0dcf\u0d9a\u0dca\u0dca \u0dbb\u0dc3\u0dca\u0db7\u0daf\u0dbb\u0dd2\u0db1\u0dca \u0dca \u0dbb\u0dd9\u0daf\u0dca\u0db4\u0dcf\u0dbb\u0dc0\u0dca\u0dd9\u0dc3\u0dca\u0dad\u0dbb\u0dd4\u0dbb\u0dd2\u0dbb\u0dd3\u0db8 ,\u0dbb\u0dcf\u0dbb\u0dd2\u0db4\u0db1 \u0dbb\u0d91\u0dd9\u0dc5\u0dad\u0dbb\u0dd2\u0dbb\u0dd3\u0db8 \u0dbb\u0dd9\u0dc4\u0ddd\u0dbb\u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dbb\u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca\u0dbb\u0dd9\u0dcf\u0dba\u0dd2\u0dba?\u0dbb\u0d91\u0dd9\u0dc3\u0dca\u0dad\u0dbb\u0db1 \u0dbb\u0d91\u0db1\u0dbb\u0dcf\u0dcf\u0dd9\u0dca \u0dd9\u0dca \u0dbb\u0dd9\u0dd9\u0dd9\u0dc3\u0dca\u0dad\u0dba?\n\n\u0db4\u0dd2\u0dc5\u0dd2\u0dd4\u0dbb\u0dbb:\n\n\u0db1\u0dd0\u0dc0.\u0dbb\u0dd9\u0dc5\u0dad\u0dbb\u0dd4\u0dbb\u0dc4\u0daf\u0dbb\u0db1\u0dd0\u0dbb\u0dd9\u0d9f\u0db1\u0dc4\u0dd2\u0dcf\u0dbb\u0db4\u0dcf\u0daf\u0dad\u0dca\u0dcf\u0dbd\u0dbb\u0db4\u0dcf\u0daf\u0dad\u0dca\u0dbb\u0db4\u0daf\u0dbd\u0db1\u0dbb\u0dbb\u0db1\u0dc0\u0db1\u0dbb\u0dd2\u0db1\u0dca \u0dca \u0dbb\u0d9c\u0dd0\u0dc3\u0dca\u0dda\u0dbb\u0dd9\u0dcf\u0db1\u0dbb\u0dbd\u0dba\u0dbb\u0db6\u0dbd\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dd9\u0daf\u0dca\u0dc1\u0dba\u0dda \u0dbb\u0dd3\u0db8\u0dca\u0daf\u0dcf\u0dd2\u0dca \u0dbb\u0d94 \u0db6\u0db4\u0dbb\u0d91\u0dcf\u0dd0\u0db1\u0dd2\u0dbb\u0dd2\u0dbb\u0dca \u0dd4\u0dbb\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1\u0daf\u0dcf\u0dca\u0dbb\u0dca \u0dd4\u0dbb\u0dd9\u0db1\u0daf\u0dd9\u0dcf\u0dba\u0dd2.\u0dbb\n\n8. \u0dca\u0dc4\u0dbb\u0db1\u0d9c\u0dcf\u0dbb\u0dc3\u0dca\u0db7\u0daf,\u0dbb\u0db1\u0d9c\u0dcf\u0dbb\u0dc3\u0dca\u0db7\u0daf\u0dbb\u0dc3\u0dca\u0dc4\u0dbb\u0db4\u0dca\u200d\u0dbb\u0daf\u0dd9\u0daf\u0dca\u0dba \u0db1\u0dbb\u0dc3\u0dca\u0db7\u0daf\u0dbb\u0dd2\u0db1\u0dca \u0dca \u0dbb\u0dcf\u0dc3\u0dca\u0dcf\u0dbb\u0dba\u0dc4\u0db1\u0dca\u0dbb\u0dc5\u0dad\u0dcf\u0dbb\u0db6\u0dbd\u0daf\u0dad\u0dca\u0dca\u0dd9\u0dbb\u0dd9\u0dcf\u0db1\u0dbb\u0dbd\u0dba\u0dbb\u0dd9\u0dc4\u0ddd\u0dbb\u0db1\u0daf\u0dcf\u0dad\u0dca\u0dd9\u0daf\u0dbd\u0dd3\u0db1\u0dbb\u0dd9\u0dcf\u0db1\u0dbb\u0dbd\u0dba\u0dbb\u0d85\u0dc5\u0dad\u0dbb\u0dd4\u0dbb\u0db1\u0dd3\u0db8\u0dcf\u0dbb\u0d9c\u0da7\u0db1\u0dbb\u0d9a\u0dd3\u0db1\u0dba\u0dbb\u0dc3\u0dca\u0dc4\u0dbb\u0d85\u0db1\u0dd4\u0dca\u0dc0\u0dbb\u0dd2\u0dbb\u0dd3\u0db8\u0dca\u0dbb\u0d85\u0dcf\u0dc3\u0dca\u0dca \u0dbb\u0dd9\u0db1\u0daf\u0dd9\u0dcf\u0dbb\u0d9c\u0da7\u0db1\u0dbb\u0d9a\u0dd3\u0db1\u0dba?\u0dbb\u0dd9\u0dc0\u0ddd\u0dcf\u0daf\u0dbb\u0db4\u0dad\u0dca\u0dbb\u0dd9\u0dcf\u0dbb\u0d9c\u0dca \u0db1\u0daf\u0dbb\u0dbd\u0dba\u0dbb\u0db4\u0dcf\u0daf\u0dad\u0dca\u0dbb\u0dc3\u0dca\u0db7\u0daf\u0dbb\u0dd9\u0db1\u0daf\u0dca\u0dd0\u0db8\u0dcf\u0dcf\u0dbb\u0dbb\u0da9\u0dcf\u0dd4\u0dd9\u0daf\u0dcf\u0dcf\u0dcf\u0db1\u0daf\u0dd9 \u0dbb\u0dd9\u0daf\u0dbb\u0dca\u0db1\u0db7\u0daf\u0dcf\u0db1\u0dbb\u0dba\u0dbb\u0dd4\u0dc5\u0dad\u0dc5\u0dd4\u0dcf\u0dbb\u0d85\u0dc5\u0dad\u0dbb\u0dd4\u0dbb\u0db1\u0dd3\u0db8\u0dcf\u0dbb\u0dc3\u0dca \u0db4\u0daf\u0dba\u0db1\u0db1,\u0dbb\u0d85\u0db1\u0dd4\u0dca\u0dc0\u0dbb\u0dd2\u0dbb\u0dd3\u0db8\u0dca\u0dbb\u0dc3\u0dca\u0dc4\u0dbb\u0d9c\u0dd0\u0dc3\u0dca\u0dda\u0dbb\u0dd2\u0dbb\u0dd3\u0db8 \u0dbb\u0dc3\u0dca\u0dcf\u0dc4\u0daf\u0dbb\u0dd9\u0dcf\u0dca \u0dbb\u0dd9\u0dcf\u0dca \u0dbb\u0dcf\u0dc1\u0dba\u0dda \u0dd9\u0db1\u0dca \u0dbb\u0d85\u0dba\u0daf\u0dcf\u0dbb\u0dcf\u0db1\u0dbb\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0db1\u0daf\u0dbb\u0db4\u0da7\u0dd2\u0db4\u0daf\u0da7\u0dd2\u0dbb\u0dd9\u0dca\u0daf\u0db1\u0dcf\u0daf\u0dba?\u0dbb\u0d92\u0dbb\u0dc3\u0dca\u0dcf\u0dc4\u0daf\u0dbb\u0dd9\u0db1\u0ddd\u0dca\u200d\u0db1\u0daf\u0dbb\u0dcf\u0db1\u0dbb\u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dc3\u0dca\u0dcf\u0d82\u0dc3\u0dca\u0dad\u0dd9\u0dcf\u0da7\u0dbb\u0dca\u0daf\u0db1\u0dcf\u0daf\u0dba?\n\n\u0db4\u0dd2\u0dc5\u0dd2\u0dd4\u0dbb\u0dbb:"
