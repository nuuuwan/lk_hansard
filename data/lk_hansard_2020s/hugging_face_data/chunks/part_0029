bb\u0dd4\u0dbb\u0d91\u0dc5\u0dd2\u0db1\u0dbb\u0dd9\u0db1\u0daf\u0dbd\u0dd0\u0dd9\u0db6\u0db1,\u0dbb\u0d85\u0d9a\u0dbb\u0dd9\u0dbb\u0dd9\u0dbd\u0dc3\u0dca\u0dbb\u0dca\u200d\u0db1\u0daf\u0d9a\u0dd3\u0dbb\u0dca\u0da7\u0dbb\u0db1\u0dd2\u0dcf\u0daf\u0dc3\u0dca/\u0db4\u0dbb\u0dd2\u0dc3\u0dca\u0dcf\u0dcf\u0dbd\u0dbb\u0da2\u0dd3\u0dcf\u0dad\u0dca\u0dc0\u0dd3\u0dca.\n\n\u0dd9\u0db1\u0dca\u0daf\u0dca\u0db4\u0ddd\u0dc2\u0dd2\u0dba:\u0dbb\u0dca \u0dbb\u0dd4\u0dd9\u0dbb\u0dca\u0dbb\u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dc1\u0dba\u0dda \u0dca\u0db8\u0dcf\u0dd9\u0dcf\u0da7\u0db1\u0dbb\u0db4\u0dcf\u0dad\u0dca\u0dcf\u0daf\u0dbb\u0d9c\u0dd0\u0db1\u0dd3\u0dca\u0db4\u0dbb\u0d85\u0dcf\u0dc1\u0dba\u0dda \u0dba\u0dbb\u0dd9\u0db4\u0ddd\u0dc2\u0da7\u0db1\u0dbb\u0dd9\u0db1\u0daf\u0dbd\u0dd0\u0db6\u0dd3\u0dca.\n\n\u0da2\u0dd3\u0dc0\u0db1 \u0dbb \u0dcf \u0dc3\u0dcf\u0db0\u0dcf\u0d9a:\u0dbb\u0d85\u0d9a\u0dbb\u0dd9\u0dbb\u0dd9\u0dbd\u0dc3\u0dca\u0dbb\u0dd4 \u0db4\u0daf\u0db1\u0db1\u0dbb\u0dd2\u0dbb\u0dd3\u0db8\u0dca,\u0dbb\u0dca\u0dad\u0dca\u0db4\u0dd0\u0dca \u0dbb\u0dc3\u0dca\u0dc4\u0dbb\u0dca\u0dad\u0dca\u0dbb\u0dcf\u0dba\u0dbb\u0db7\u0daf\u0dd2\u0db1\u0dc0\u0db1.\n\n\u0dc3\u0db8\u0dd3\u0db4 \u0d86\u0dbb\u0dba:\u0dbb\u0dd9\u0db1\u0daf\u0dc3\u0dca\u0dd0\u0dbd\u0dd2\u0dbb\u0dd2\u0dca\u0dad\u0dca\u0dbb\u0dd9\u0dbd\u0dc3\u0dca\u0dbb\u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dd9\u0daf\u0dcf\u0dbb\u0dd9\u0db1\u0daf\u0d9c\u0dca \u0db1\u0daf\u0dbb\u0dca\u0dc2\u0db1\u0dbb\u0dd9\u0dcf\u0ddd\u0d9c\u0dd3\u0dca \u0dbb\u0dc3\u0dca\u0dca\u0d9f\u0dbb\u0daf\u0dd3\u0dbb\u0dca\u0d9d\u0dbb\u0dd9\u0daf\u0dbd\u0dd3\u0db1\u0dcf\u0dbb\u0dd9\u0dc4\u0ddd\u0dbb\u0dc3\u0dca\u0db8\u0dd3\u0db4\u0dcf\u0dbb\u0dbb\u0dbb\u0db1\u0dbb\u0dd2\u0dbb\u0dd3\u0db8\u0dca.\n\n(iii)\n\n\u2022 \u0dca \u0db1\u0dbd\u0dd4\u0dca\u0dbb\u0dd9\u0dcf\u0ddd\u0d9c\u0dd3\u0dca \u0db4\u0dbb\u0dd9\u0db1\u0daf\u0d9a\u0dca\u0dd9\u0dbd\u0dca\u0dbb\u0dc2\u0dc2\u0db0\u0dbb\u0dbd\u0db6\u0daf\u0dbb\u0daf\u0dd3\u0dca\u0dbb\u0dc3\u0dca\u0dc4\u0dbb\u0dad\u0d8d\u0da