    "chunk_text": "\u0dad\u0dcf\u0dc3\u0dca \u0dc5\u0db8\u0dd4\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0d9c\u0dad\u0ddd\u0dc2\u0dca\u0da8\u0da7 \u0dc0\u0dd0\u0da9\u0dc3\u0db4\u0dc4\u0db1\u0db4 \u0d85\u0db4\u0dd2 \u0d9c\u0dc0\u0dca \u0d9a\u0dba\u0d9a\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 33.6\u0dca. 2524\u0daf\u0dd2 \u0d92\u0d9a\u0db4 \u0d9c\u0dc0\u0dca \u0d9a\u0dba\u0d9a\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0d9c\u0da9\u0dd4\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 21\u0dba\u0dd2. \u0d91\u0dc4\u0dd2\u0daf\u0dd2 \u0dad\u0dcf\u0dc3\u0dca \u0dc5\u0db8\u0dd4\u0dca \u0d9c\u0dda \u0dbb\u0dc4\u0dcf\u0dba \u0d9c \u0d9a \u0dc3\u0db3\u0dc4\u0dcf \u0d9c\u0dba\u0db1 \u0db8\u0dd4\u0dba\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 8 \u0dd2\u0da7\u0db4 115 \u0dba\u0dca\u0dc0\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dba\u0d9a\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d9c\u0db4\u0dad\u0d9c\u0d9a\u0dca \u0d8d \u0dc3 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dcf\u0db7 \u0d91\u0dca \u0d9c\u0dca \u0dba\u0dbb\u0dd4\u0dc0\u0dca \u0db4; \u0dba\u0dbb\u0dd4\u0dc0\u0dca \u0d9c\u0dda \u0d9c\u0dad\u0ddd\u0dc2\u0dca\u0da8\u0da7\u0dba\u0db4. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0d85\u0db4\u0dd2 \u0db1\u0dd2\u0d9a \u0d87\u0db3\u0dd4\u0db4\u0dad \u0d9a\u0db6\u0dcf\u0daf\u0dd3\u0db8 \u0daf\u0dd2\u0d9a\u0db4\u0db8 \u0d9a\u0dba\u0d9c\u0d9a\u0db1 \u0dba\u0db1 \u0d85 \u0dba\u0dad\u0dd4\u0dba \u0daf\u0dd4\u0dc2\u0dca\u0da8\u0dda\u0d9a\u0dba \u0dc3\u0dc4 \u0d85\u0dad\u0dd2\u0daf\u0dd4\u0dc2\u0dca\u0da8\u0dda\u0d9a\u0dba \u0dad\u0dcf\u0dc3\u0dca\u0dc0\u0d9a \u0dc5\u0db8\u0dd4\u0dca \u0db4 \u0dad\u0dcf\u0dc0\u0dc4\u0dca \u0d9a\u0db6\u0dcf\u0daf\u0dd3\u0db8 \u0dbb\u0dba\u0db4\u0dad\u0db7 \u0d9a\u0dc5\u0dcf \u0dbd\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0d9c\u0dc3 \u0dad\u0dc5\u0db8\u0dd4\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0 \u0dcf\u0dc0\u0db4. \u0d9a\u0dd2\u0dca \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a \u0d9a\u0d9c\u0dc5\u0dda \u0db1\u0dd0\u0dc4\u0dd0. \u0da7\u0db4 \u0d85\u0db8 \u0dba\u0dc0 \u0dc0\u0dd2\u0d9c\u0dc1\u0dda\u0dc2\u0dca\u0da8 \u0d85\u0dc0\u0dc1\u0dba \u0dcf \u0dc3\u0dc4\u0dd2 \u0dba\u0dbb\u0dd4\u0dc0\u0dca \u0db4 \u0dc3\u0dd4\u0dbb\u0dd0\u0d9a\u0dd4\u0db4\u0dad \u0db1\u0dd2\u0dc0\u0dcf\u0dc3\u0dc0\u0d9a \u0dbd\u0dca \u0db1 \u0dba\u0dbb\u0dd4\u0dc0\u0dca \u0db4 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0db4\u0dd2\u0db4\u0dad\u0d9c\u0dc0\u0dca \u0dc0\u0d9a \u0dbd\u0dca \u0db1 \u0dc3\u0dcf\u0db8\u0d9c\u0da9\u0dd4\u0d9a\u0dba \u0dc4\u0dd2\u0db8\u0dd2\u0dc0\u0dbb\u0dd4\u0dca \u0db4 \u0d9a \u0d9c\u0db4\u0dad\u0d9a \u0d9a\u0dd0\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d9a\u0dd2\u0dca \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4 \u0d9a \u0d9a\u0d9c\u0dc5\u0dda \u0db1\u0dd0\u0dc4\u0dd0. \u0d91\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dcf\u0db7\u0dd3\u0dca 8 2 555\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 2. \u0dca \u0d9c\u0dc0\u0dca \u0d9a\u0dba\u0d9a\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0dba\u0dd0\u0dca \u0d92\u0dc0\u0dcf \u0dad\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0d9c\u0dc0\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0dad\u0dcf\u0dc3\u0dca \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba\u0dcf\u0dc0\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0db1\u0dd3\u0dad\u0dcf\u0dba\u0dca\u0dc2\u0dca\u0da8\u0d9a \u0dad\u0dd4\u0dc0\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 1. \u0dca \u0d9c\u0dc0\u0dca \u0d9a\u0dba \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d9a\u0dd2\u0dca \u0d9c\u0dc0\u0dca \u0d9a\u0dba \u0dad\u0dd2\u0db6\u0dd4\u0d9c\u0da9\u0dd4\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db6\u0dd2\u0dd2\u0dba\u0db1 1\u0dba\u0dd2. \u0d9a\u0dd2\u0dca \u0d92\u0dc0\u0dcf \u0d9a\u0db6\u0dcf \u0daf\u0dd4\u0dca \u0d9c\u0dca \u0d9c \u0ddd\u0dba\u0dcf\u0d9a \u0d9a \u0d85\u0dcf\u0d9a\u0dba\u0d9a\u0db4 \u0dc0\u0dd2 \u0dba\u0dba\u0dd2. \u0dba\u0dd0\u0dca \u0dbb\u0db4\u0dc5\u0dd4\u0dc0\u0dca 6 \u0dc0\u0dc3\u0d9c\u0dba\u0dca \u0dbd\u0dc4\u0dc5 \u0d9c\u0dbb\u0dda\u0dab\u0dd2\u0dc0\u0d9a \u0dd2\u0da7\u0dba\u0dbd\u0dd4 \u0dba\u0dbb\u0dd4\u0dc0\u0dca \u0db4 \u0d9c\u0db4\u0dad\u0dc0\u0dcf \u0d9a\u0db6\u0dcf\u0d9a\u0dca \u0db1. \u0d9c\u0db4\u0dad\u0dc0\u0dcf \u0d85\u0db4\u0dd2 \u0d9a\u0dba\u0dbb\u0db4 \u0d9c\u0daf\u0dca\u0dc0\u0dca.\n\n\u0d9a\u0db6\u0dad\u0dd4\u0db8\u0dd2\u0dba \u0dba\u0dca \u0db1\u0dc0\u0dcf \u0d85\u0d9c\u0db4\u0dcf \u0dbb\u0da9\u0dd4\u0d9a \u0dc0 \u0d9c\u0db4\u0dad \u0d9c\u0dc0\u0daf\u0dca\u0daf\u0dd2 \u0dc0\u0dd2\u0dc1\u0dda\u0dc0\u0dc0\u0dd2\u0dba\u0dba\u0dcf\u0d9a \u0dd2\u0da7\u0dc3\u0dd4\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0d9c\u0dba\u0db1 \u0db8\u0dc4\u0d9c\u0dad\u0dcf\u0dc5 \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba\u0dcf\u0db0\u0dcf\u0dba\u0dba \u0d9c\u0dba\u0d9c\u0dd4\u0da7 \u0d9a\u0dba \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0db6\u0dc0. \u0d9a\u0dd2\u0dca \u0daf\u0dd4\u0dca \u0d9c\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 555\u0dba\u0dd2. \u0d85\u0db4\u0dd2 \u0d92\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 15 555 \u0d9a\u0dc5\u0dcf. \u0d9a\u0dd2\u0dca \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba\u0dcf\u0db0\u0dcf\u0dba\u0dba \u0daf\u0dd4\u0dca \u0d9c\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 4 555\u0dba\u0dd2. \u0d85\u0db4\u0dd2 \u0d92\u0d9a \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 9 555 \u0d9a\u0dc5\u0dcf. \u0d85\u0db4\u0dd2 \u0dba\u0dd0\u0dca \u0d87\u0dc3\u0dda \u0d9a\u0da9\u0dd4\u0d9a\u0da7\u0dcf\u0da9\u0dd2 \u0d9a\u0db6\u0dcf \u0d9c\u0dba\u0db1\u0dc0\u0dcf \u0dc0\u0dd2\u0dc1\u0dda\u0dc0\u0dc0\u0dd2\u0dba\u0dba\u0dcf\u0d9a \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba\u0dcf\u0dc0\u0dca \u0db4. \u0d92\u0d9a \u0d9c\u0dba\u0dca \u0d9c\u0dca \u0d9c\u0d9a\u0dcf\u0d9c\u0dc4\u0dca \u0dba; \u0dca\u200d\u0db1\u0dcf\u0d9a\u0dbb\u0dad\u0dad\u0dd2 \u0d85\u0dba\u0db8\u0dd4\u0dba\u0d9c\u0d9a\u0dca . \u0dbd\u0dc3\u0dda\u0dc3\u0dba \u0d9c\u0d9a\u0dcf\u0d9c\u0dc4\u0dcf\u0db8\u0dba \u0dca\u200d\u0db1\u0dcf\u0d9a\u0dbb\u0dad\u0dad\u0dd2 \u0d85\u0dba\u0db8\u0dd4\u0dba\u0d9a \u0dad\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0d9c\u0dc5\u0dda\n\n979 980\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 * \u0db4\u0dd4\u0dc3\u0db1\u0dad\u0d9a\u0dcf\u0dbd\u0dca\u0dda \u0dad\u0db6\u0dcf \u0d87\u0dad. * \u0ba8\u0bc2\u0ba9\u0bbf\u0b95\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. * Placed in the Library.\n\n\u0dad\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9c\u0db4\u0dad\u0dca \u0dad\u0dd4\u0dc0\n\n\u0dd2\u0dbb\u0dba\u0db1 \u0d91\u0d9a \u0d9a\u0db6\u0dad\u0dd4\u0db8\u0dd2\u0dba \u0dba\u0dca \u0db1\u0dc0\u0dcf \u0d9a\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0dca\u200d\u0dba \u0d9a\u0dcf\u0dba\u0d9a \u0dc3\u0db7\u0dcf \u0dc3\u0db7\u0dcf\u0dad\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2. \u0db8\u0dc0\u0dd4\u0dca \u0db4 \u0d91\u0dd2\u0dc3\u0d9c\u0db6 \u0d9a \u0d9c\u0dba\u0ddd\u0dc4\u0d9a\u0db4 \u0db8\u0dba\u0dd2 \u0d9c\u0daf\u0dca\u0dc1\u0dad\u0dcf\u0d9a\u0db1\u0da5\u0dba\u0dca \u0d9c\u0db6\u0d9c\u0dc4 \u0d9a \u0d9a\u0dca \u0db1 \u0dba\u0dca \u0d9c\u0dca . \u0d92\u0dc0\u0dcf \u0dc3\u0db3\u0dc4\u0dcf\u0dba\u0dd2 \u0d92\u0d9a \u0dad\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0d9c\u0dc5\u0dda. \u0dba\u0dd0\u0dca \u0d85\u0db4\u0dd2 \u0d92\u0d9a \u0dca\u200d\u0db1 \u0dcf\u0dc0\u0db4 \u0d9c\u0dba\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0d9a\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0dca\u200d\u0dba \u0d9a\u0dcf\u0dba\u0d9a \u0dc3\u0db7\u0dcf \u0dc3\u0db7\u0dcf\u0dad\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2 \u0dbd\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0d9c\u0dc3 \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0dc0 \u0dcf\u0dc0\u0db4 \u0dc0\u0dd2\u0dc1\u0dda\u0dc0\u0dc0\u0dd2\u0dba\u0dba\u0dcf\u0d9a\u0dc0\u0d9a \u0dbd\u0dca \u0db1 \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba\u0dcf\u0dc0\u0dca \u0d85 \u0dba \u0dbb\u0db6\u0dcf\u0db0 \u0dc3\u0dc4\u0dd2 \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba \u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba\u0dcf\u0dc0\u0dca \u0dbd\u0dca \u0db1\u0dc0\u0dcf \u0db1\u0db4\u0dad \u0d92 \u0d85\u0dba\u0db4 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca 555\u0d9a \u0db8\u0dcf\u0dd2\u0da7\u0d9a \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dc0\u0dca \u0dba\u0dd0\u0dca \u0d9c\u0dba\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8 \u0dc0\u0dd2\u0d9c\u0dba\u0dc3\u0dda \u0dc0\u0dd2\u0dc1\u0dda\u0dc0\u0dc0\u0dd2\u0dba\u0dba\u0dcf\u0d9a\u0dc0\u0d9a\u0db4 \u0dba\u0dca \u0db1 Z-score \u0d91\u0d9a \u0dc0\u0dd0\u0da9\u0dd2 \u0dc5\u0db8\u0dba\u0dd2\u0dca \u0db4 - \u0d91\u0d9a \u0dc5\u0db8\u0d9c\u0dba\u0d9a\u0dd4\u0db4 - \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8\u0dd2\u0dd2\u0dba\u0db1 85\u0dca -\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0d9a\u0dca\u0dc2\u0dca\u0da8 855\u0dca- \u0d9c\u0dba\u0db1\u0dc0\u0dcf \u0d9a\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0dca\u200d\u0dba \u0d9a\u0dcf\u0dba\u0d9a \u0dc3\u0db7\u0dcf \u0dc3\u0db7\u0dcf\u0dad\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0db1\u0dd2."
