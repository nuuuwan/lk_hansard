    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0db4 \u0dbd\u0d82\u0db8\u0db8 \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0d8b \u0d9a \u0dd3\u0db8 \u0dba \u0dbd\u0d82\u0dad\u0d9a\u0dca\u0dd2\u0da7\u0db4\u0dad\u0dca \u0dd4\u0da7\u0dda\u0daf\u0dd3 \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0d85\u0dc0\u0db8\u0dda\u0dcf\u0d9a\u0dc0 \u0dbd\u0d82\u0da7 \u0d9a\u0dba\u0d9a \u0dbd\u0d82\u0d9c\u0dca \u0dca\u0dc0\u0d9a, \u0dbd\u0d82\u0db8\u0d9a \u0dd8 \u0dbd\u0d82\u0dd6\u0db8\u0db8\u0dd2\u0da7\u0dda \u0dbd\u0d82\u0d92\u0d9a\u0dd3 \u0d9a\u0dc0 \u0dbd\u0d82\u0dbb\u0dba\u0dca\u0dc2\u0dca\u0da8\u0d9a \u0dbd\u0d82\u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0dbd\u0d82\u0da7\u0dc0\u0db1\u0dd4\u0da7\u0dc0\u0dca \u0dbd\u0d82 \u0db8 \u0dbd\u0d82\u0da7\u0dbd\u0dcf, \u0dbd\u0d82 \u0db1\u0dcf\u0dd4 \u0dbd\u0d82\u0db8\u0dc4 \u0dbd\u0d82\u0da7 \u0dde\u0dc0\u0dca \u0d9a\u0dc0 \u0dbd\u0d82 \u0dd0\u0dad \u0dbd\u0d82 \u0dc5 \u0dbd\u0d82\u0d85\u0da7\u0dda \u0dbd\u0d82\u0dba\u0da7 \u0dbd\u0d82\u0dc0\u0dd2\u0dbb\u0dd4\u0dc0\u0dca \u0dbd\u0d82\u0db4\u0dd2\u0dd2\u0db8\u0db8\u0dca \u0dbd\u0d82\u0da7\u0dc0\u0db1\u0dd4\u0da7\u0dc0\u0dca \u0dbd\u0d82 \u0dcf\u0d9a \u0dbd\u0d82 \u0dba\u0dca \u0dca. \u0dbd\u0d82\u0db8\u0dd6\u0d9a\u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd6\u0daa \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0db8\u0dca \u0dd3\u0dd4\u0db8\u0db1\u0dd2, \u0dbd\u0d82\u0dc0 \u0d9a\u0db8\u0dca \u0dbd\u0d82\u0dbb\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dbd\u0d82\u0db6\u0d9a \u0db4 \u0dbd\u0d82\u0dad \u0d9a \u0dbd\u0d82\u0dc0\u0dd4\u0da7\u0d9a\u0db4 \u0dbd\u0d82\u0dad\u0dd4\u0dc5\u0dc0 \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0dba\u0da7 \u0dbd\u0d82\u0dc0\u0dd2\u0dbb\u0dd4\u0dc0\u0dca \u0db4 \u0dbd\u0d82\u0d85 \u0d9a\u0da7\u0dc0\u0d9a\u0d9a \u0dbd\u0d82\u0dad\u0dd2\u0da7\u0db6\u0dca \u0dbd\u0d82\u0da7\u0dda\u0dba\u0dca\u200d\u0dca \u0dbd\u0d82\u0dd2\u0dba\u0da7\u0db8 \u0dbd\u0d82\u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dbd\u0d82\u0db8\u0db8 \u0dbd\u0d82\u0dd2 \u0d9a\u0db8 \u0dbd\u0d82 \u0dca\u0d9c\u0d9a\u0db8\u0dca\u0da7\u0dc0\u0dca \u0dbd\u0d82\u0db8 \u0dca \u0dbd\u0d82 \u0dba\u0dca \u0dca \u0dbd\u0d82\u0d95\u0dca\u0dd1. \u0dbd\u0d82\u0d85\u0dba \u0dbd\u0d82\u0d94\u0dc0\u0dd4\u0dca \u0db4 \u0dbd\u0d82\u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0dbd\u0d82\u0db4\u0dd3\u0da8\u0dc0\u0da9\u0dca \u0dbd\u0d82\u0d91\u0dbd\u0dcf\u0d9a \u0dbd\u0d82 \u0dba\u0db8\u0dd2\u0dca , \u0dbd\u0d82\u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0dbd\u0d82\u0da7\u0da0\u0ddd\u0dba\u0dca\u0d9a \u0dbd\u0d82\u0d91\u0dbd\u0dcf\u0d9a \u0dbd\u0d82 \u0dba\u0db8\u0dd2\u0dca \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0dbb\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dbd\u0d82\u0dba\u0da7 \u0dbd\u0d82\u0dc0\u0dd2\u0dbb\u0dd4\u0dc0\u0dca \u0dbd\u0d82\u0dad\u0dc4\u0dc5\u0db4 \u0dbd\u0d82\u0d87\u0dba \u0dbd\u0d82\u0dba\u0db8\u0dca \u0dca \u0d9a, \u0dbd\u0d82\u0d94\u0dc0\u0dd4\u0dca \u0dbd\u0d82\u0dd2\u0db8\u0dca \u0dbd\u0d82 \u0dc5 \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0d8b \u0d9a \u0dd3\u0db8 \u0dba \u0dbd\u0d82 \u0d9a\u0dca \u0db7\u0d9a\u0dba \u0dbd\u0d82\u0db8 \u0d9a \u0dbd\u0d82\u0dba\u0db8\u0dca \u0dca \u0d9a \u0dbd\u0d82\u0d8b \u0d9a\u0db8\u0d9a\u0dc4 \u0dbd\u0d82\u0d9c\u0dca \u0dca\u0d9a \u0dbd\u0d82\u0da7\u0dc0\u0d9a\u0d9a\u0dc0\u0dca, \u0dbd\u0d82\u0da7\u0db4\u0dad .\n\n\u0db8\u0dd6\u0d9a\u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd6\u0daa \u0dbd\u0d82\u0d9c\u0dbb\u0dd4 \u0dbd\u0d82\u0db8\u0dca \u0dd3\u0dd4\u0db8\u0db1\u0dd2, \u0dbd\u0d82\u0dba\u0dd4\u0daf\u0dca\u0daf\u0db0 \u0dbd\u0d82\u0dad\u0dd0\u0dc0\u0dad\u0dd2 \u0dbd\u0d82\u0d85\u0dad\u0dd2\u0dba \u0dbd\u0d82\u0daf\u0dd4\u0dc2\u0dca\u0da8\u0dda \u0dba \u0dbd\u0d82\u0db8\u0db8\u0da7\u0dda\u0daf\u0dd3 \u0dbd\u0d82\u0db1\u0dd3 \u0dba\u0db1\u0dd4\u0dd6\u0dbd\u0d9a\u0dc0 \u0dbd\u0d82\u0dc0\u0db8\u0dba \u0dbd\u0d8212 \u0dbd\u0d82\u0da7\u0db8\u0dda\u0dc0\u0d9a \u0dbd\u0d82 \u0d9a\u0d9a \u0dca \u0dbd\u0d82\u0db8\u0db4\u0dad\u0db4\u0dd6\u0dca\u0da7 \u0dbd\u0d82 \u0dba\u0d9a\u0d9a \u0dbd\u0d82\u0dc4\u0db8\u0dd4\u0dba\u0d9a\u0da7\u0dc0\u0dca \u0dbd\u0d82\u0dd2\u0dc0 \u0d9a \u0dbd\u0d82\u0dc0\u0dd6 \u0dbd\u0d82\u0dba\u0da7 \u0dbd\u0d82\u0dc0\u0dd2\u0dbb\u0dd4\u0dc0\u0dca \u0dbd\u0d82\u0d85\u0dba \u0dbd\u0d82\u0dc0\u0dd2\u0dba\u0d9a\u0d9a \u0dbd\u0d82\u0dca\u200d\u0dbb\u0dba\u0dda\u0dca \u0dbd\u0d82\u0dba\u0d9a\u0dc1\u0dd2 \u0db4 \u0dbd\u0d82\u0db8\u0dd4\u0dc4\u0dd4\u0da7 \u0dbd\u0d82\u0daf\u0dd3\u0d9a\u0d9a \u0dbd\u0d82\u0dad\u0dd2\u0da7\u0db6\u0dca\u0dc0\u0d9a. \u0dbd\u0d82\u0d94\u0dc0\u0dd4\u0dca \u0dbd\u0d82\u0dd4\u0dc5\u0dd4 \u0dad\u0db8\u0dca \u0dbd\u0d82 \u0d9a\u0d9a \u0dca \u0dbd\u0d82\u0da7\u0dca\u0d9a\u0da7\u0dc0\u0dba\u0dd2, \u0dbd\u0d82\u0dc0\u0db8\u0dba \u0dbd\u0d8212\u0dca \u0dbd\u0d82 \u0db8\u0dca \u0da7\u0dda \u0dbd\u0d82\u0da2\u0dd3\u0dc0\u0dd2 \u0dbd\u0d82\u0dad\u0da7\u0db8 \u0dbd\u0d82 \u0db6\u0d9a, \u0dbd\u0d82 \u0db8\u0dca \u0da7\u0dda \u0dbd\u0d82\u0dba\u0dbb\u0dd4 \u0dbd\u0d82\u0dad\u0dc0\u0dd4\u0dbd\u0dcf \u0dbd\u0d82\u0dad\u0da7\u0db8 \u0dbd\u0d82 \u0db6\u0d9a, \u0dbd\u0d82 \u0db8\u0dca \u0da7\u0dda \u0dbd\u0d82\u0da7 \u0dde\u0dc0\u0dca \u0d9a\u0dc0 \u0dbd\u0d82 \u0dd0\u0dad \u0dbd\u0d82 \u0dba\u0d9a\u0d9a, \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0dba\u0da7 \u0db4 \u0dbd\u0d82\u0db6\u0dd2\u0db4\u0dad \u0dbd\u0d82\u0d85\u0d9f\u0d9a \u0dbd\u0d82\u0d85\u0dba\u0dd2\u0dad\u0dd2 \u0dbd\u0d82\u0da7\u0dc0\u0db1\u0dd4\u0da7\u0dc0\u0dca , \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0dba\u0db4 \u0dbd\u0d82\u0d92\u0d9a\u0dd3 \u0dbd\u0d82\u0dba\u0db4\u0dca \u0dbd\u0d82\u0db6\u0dc0\u0db4 \u0dbd\u0d82\u0dad \u0d9a \u0dba \u0dbd\u0d82\u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dbd\u0d82\u0da7\u0dc0\u0db1\u0dd4\u0da7\u0dc0\u0dca \u0dbd\u0d82 \u0db8\u0dca \u0da7\u0dda \u0dbd\u0d82\u0da7\u0dbd\u0dcf, \u0dbd\u0d82 \u0db1\u0dcf\u0dd4 \u0dbd\u0d82\u0db8\u0dc4 \u0dbd\u0d82\u0dba\u0dc4\u0da9\u0dd2 \u0dbd\u0d82\u0da7\u0db4\u0dad \u0dbd\u0d82\u0da7\u0dad\u0d9a\u0da7\u0dc5\u0d9a\u0dc0\u0db4 \u0dbd\u0d82\u0db4\u0dd6\u0dca\u200d\u0d9a \u0dbd\u0d82 \u0dc5\u0d9a. \u0dbd\u0d82\u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dbd\u0d82\u0d91\u0da7\u0dc4\u0db8 \u0dbd\u0d82 \u0dd0\u0dad\u0dc0\u0dd3\u0db8\u0db4\u0dad \u0dbd\u0d82 \u0dc5 \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0dba\u0da7 \u0dbd\u0d82\u0dc0\u0dd2\u0dbb\u0dd4\u0dc0\u0dca \u0db4 \u0dbd\u0d82\u0d85\u0dba \u0dbd\u0d82 \u0dbd\u0d82\u0dd2 \u0d9a\u0db8 \u0dbd\u0d82\u0da7\u0dda\u0dba\u0db1\u0dd3 \u0dbd\u0d82 \u0d9a \u0d9a\u0dc0 \u0dca \u0db4 \u0dbd\u0d82\u0db8\u0dd4\u0dc4\u0dd4\u0da7 \u0dbd\u0d82\u0da7\u0dba\u0dca \u0dca \u0dbd\u0d82\u0dc3\u0dd2\u0daf\u0dd4 \u0dbd\u0d82\u0da7\u0dc0\u0db8\u0dd2\u0dca \u0dbd\u0d82\u0dad\u0dd2\u0da7\u0db6\u0dca\u0dc0\u0d9a.\n\n\u0d94\u0dc0\u0dd4\u0dca \u0dbd\u0d82\u0d91\u0dba\u0d9a \u0dbd\u0d82\u0da7\u0dc0\u0da9\u0dd2 \u0dbd\u0d82\u0d8b\u0dab\u0dca\u0da9\u0da9\u0dc0\u0d9a\u0db4, \u0dbd\u0d82\u0da7\u0db6\u0ddd\u0db4\u0dad\u0db6\u0dc0\u0d9a\u0db4 \u0dbd\u0d82\u0db8\u0dd4\u0dc4\u0dd4\u0da7 \u0dbd\u0d82\u0daf\u0dd4\u0dca \u0dca\u0d9a. \u0dbd\u0d82\u0d94\u0db6 \u0dbd\u0d82\u0dc4\u0dd2 \u0d9a\u0d9a \u0dbd\u0d82\u0db6\u0d9a\u0dca \u0dca, \u0dbd\u0d82\u0dba\u0dd4\u0daf\u0dca\u0daf\u0db0 \u0dca \u0dbd\u0d82\u0dad\u0dd2\u0da7\u0db6\u0dca \u0dbd\u0d82\u0da7\u0dc0\u0d9a\u0d9a\u0da7\u0dda \u0dbd\u0d82\u0da7\u0db6\u0ddd\u0db4\u0dad\u0db6 \u0dbd\u0d82\u0d9c\u0dc4\u0dca\u0da7 \u0d9a\u0db4, \u0dbd\u0d82\u0da7\u0dc0\u0da9\u0dd2 \u0dbd\u0d82\u0dad\u0dd2 \u0dca\u0da7 \u0d9a\u0db4 \u0dbd\u0d82\u0d85\u0db4\u0dd2\u0db4 \u0dbd\u0d82\u0dd2\u0daf\u0dd2\u0dd2\u0db8 \u0db4 \u0dbd\u0d82 \u0dca \u0dca \u0dbd\u0d82\u0dd4\u0dd4 \u0dc0\u0dca \u0dba? \u0dbd\u0d82\u0d85\u0db4\u0dd2\u0db4 \u0dbd\u0d82\u0db6\u0dd0\u0dc4\u0dd0. \u0dbd\u0d82\u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dbd\u0d82\u0d85\u0da7\u0dda \u0dbd\u0d82\u0dba\u0da7 \u0dbd\u0d82\u0dc0\u0dd2\u0dbb\u0dd4\u0dc0\u0dca \u0dbd\u0d82\u0d91\u0dba\u0d9a \u0dbd\u0d82\u0d92 \u0dbd\u0d82 \u0dc5\u0d9a. \u0dbd\u0d82\u0dc0\u0db8\u0dba \u0dbd\u0d8212\u0dca \u0dbd\u0d82\u0da7\u0db8\u0dda\u0dc0 \u0dbd\u0d82 \u0dba\u0dd4 \u0dbd\u0d82\u0dba\u0da7 \u0dbd\u0d82\u0dc0\u0dd2\u0dbb\u0dd4\u0dc0\u0dca \u0dbd\u0d8240, 000\u0dca \u0dbd\u0d82\u0dad\u0db8\u0da7 \u0dbd\u0d82\u0d85\u0da7\u0dda \u0dbd\u0d82\u0dba\u0da7 \u0db4 \u0dbd\u0d82\u0dd2\u0dca \u0dca\u0dc0\u0d9a. \u0dbd\u0d82\u0da7\u0dad\u0d9a\u0da9\u0dd2 \u0dbd\u0d82\u0d9c\u0da7\u0dca\u0dca \u0dbd\u0d82\u0da7\u0dca\u0d9a\u0da7\u0dc0\u0dba\u0dd2. \u0dbd\u0d82\u0d85\u0dba \u0dbd\u0d82\u0d92 \u0dbd\u0d82\u0dc3\u0dd2 \u0dbd\u0dd4\u0db8 \u0dbd\u0d82\u0dba\u0da7 \u0dbd\u0d82\u0dc0\u0dd2\u0dbb\u0dd4\u0dc0\u0dca \u0dbd\u0d82\u0dca\u200d\u0dbb\u0dba\u0dda\u0dca \u0dbd\u0d82\u0dba\u0d9a\u0dc1\u0dd2 \u0db4 \u0dbd\u0d82\u0db8\u0dd4\u0dc4\u0dd4\u0da7 \u0dbd\u0d82\u0daf\u0dd3\u0d9a\u0d9a \u0dbd\u0d82\u0dad\u0dd2\u0da7\u0db6\u0dca\u0dc0\u0d9a. \u0dbd\u0d82"
  },
