a\u0dc2\u0dca\u0da8\u0da7 \u0dc3\u0db7\u0dcf \u0dc3\u0dd1\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0d9c\u0daf\u0dca\u0dba \u0dba \u0d9c\u0dca\u0d9a\u0db4\u0dad \u0d9c\u0d9a\u0dcf \u0db4\u0db0\u0dcf\u0dc3\u0dba\u0dca \u0dad\u0dba\u0db1\u0db4\u0dad \u0d9a\u0dba\u0d9c\u0d9a\u0db1 \u0db4\u0dd2\u0dc4\u0dd2\u0db8\u0dca\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0d85 \u0dba \u0d91\u0db8 \u0d9c\u0d9a\u0dcf \u0db4\u0db0\u0dcf\u0dc3 \u0dad\u0dd4\u0dc5 \u0dd2\u0da7\u0da7\u0dd2\u0db1 \u0dad\u0dcf\u0dba\u0db4\u0dad\u0dad\u0db4\u0dad\u0d9a \u0dc0\u0dc0\u0dba\u0dba\u0dc0\u0dbb\u0dd4\u0dca \u0d9c\u0db8\u0db8 \u0dc3\u0db7\u0dcf\u0dc0\u0d9a \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0dca\u200d\u0db1\u0dba \u0d9a\u0dc5\u0dba \u0d91\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dc4\u0db7\u0dcf\u0dbb \u0dc0\u0dd3\u0db8 \u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dba \u0d9c\u0db1\u0dcf\u0d9c . \u0d91\u0d9c\u0d9a\u0dc3\u0db8 \u0dbb\u0dba\u0dd4\u0dbb\u0dca\u0dbd\u0d9c \u0dba \u0d8b\u0dad\u0dcf\u0d9a\u0dbb\u0db0\u0dcf\u0db4\u0dad \u0dc0\u0dc0\u0dba\u0dba\u0dc0\u0dba\u0d9c\u0dba\u0dca \u0dc0\u0db1 \u0dbb\u0dba\u0dd4\u0dbb\u0dca\u0dbd\u0d9c \u0dba \u0db4\u0dca\u200d\u0dbb\u0dca\u200d\u0dcf \u0d9c\u0dc3\u0dde\u0d9b\u0dba \u0dc0\u0dc0\u0dba\u0dba \u0db1\u0dd2\u0d9a\u0db0\u0dcf\u0db4\u0dad \u0d9c\u0db8\u0db8 \u0dbb\u0dd0\u0dc3\u0dda\u0dc0\u0dd3\u0d9c\u0db4\u0dad \u0d9a\u0dd0\u0db3\u0dc0\u0dd4\u0db4\u0dad\u0d9a\u0dbb\u0dd4 \u0dc0\u0dc1\u0d9c\u0dba\u0dca \u0dc3\u0dc4\u0db7\u0dcf\u0dd2 \u0d9c . \u0d92 \u0dc4\u0dd0\u0dba \u0d85\u0d9c\u0db1\u0d9a\u0dd4 \u0d9a \u0dbb\u0dba\u0dd4\u0dbb\u0dca\u0dbd\u0d9c \u0dba \u0d8b\u0dad\u0dcf\u0d9a\u0dbb\u0db0\u0dcf\u0db4\u0dad \u0dc0\u0dc0\u0dba\u0dba\u0dc0\u0dbb\u0dd4 \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba\u0d9c\u0dba\u0dca \u0d9c\u0db8\u0db8 \u0dc3\u0dcf\u0dba\u0dca\u0dc2\u0dca\u0da8\u0da7 \u0dc3\u0db7\u0dcf\u0dc0\u0d9a\u0db4 \u0dc3\u0dc4\u0db7\u0dcf\u0dd2 \u0d9c\u0db1\u0dcf\u0d9c . (iii) \u0d9c\u0db8\u0db8 \u0dc3\u0dcf\u0dba\u0dca\u0dc2\u0dca\u0da8\u0da7 \u0dc3\u0db7\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dc4\u0db7\u0dcf\u0dd2 \u0dc0\u0dca \u0d9c\u0dca \u0dad\u0dcf\u0dba\u0db4\u0dad\u0dad\u0db4\u0dad\u0d9a \u0dc0\u0dc0\u0dba\u0dba\u0dc0\u0dbb\u0dd4\u0dca \u0dad\u0db8\u0da7\u0dca \u0dc0\u0db1 \u0d85 \u0dba \u0d9a\u0dd0\u0db3\u0dc0\u0dd4\u0db4\u0dad\u0d9a\u0dbb\u0dd4 \u0dc0\u0dc1\u0d9c\u0dba\u0dca \u0db4\u0dca\u200d\u0dbb\u0dca\u200d\u0dcf \u0d9c\u0dc3\u0dde\u0d9b\u0dba \u0dc0\u0dc0\u0dba\u0dba \u0db1\u0dd2\u0d9a\u0db0\u0dcf\u0db4\u0dad - CMO - \u0dad\u0db8\u0da7\u0dca \u0dc3\u0dc4\u0db7\u0dcf\u0dd2 \u0d9c .\n\n(ii) \u0d87\u0db8\u0dd4\u0dd4\u0dd9* \u0db8\u0d9f\u0dd2\u0dca \u0dba\u0dca\u0dc0\u0dcf \u0d87 .\n\n(iii) \u0d9a .\n\n\u0dc3\u0dcf\u0dba\u0dca\u0dc2\u0dca\u0da8\u0da7 \u0dc3\u0db7\u0dcf \u0dc3\u0dc0\u0dd2\u0db6\u0d9a\u0d9a\u0dd0\u0dca \u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0db4\u0dd4\u0dab \u0dc0\u0dd0\u0da9\u0dc3\u0db4\u0dc4\u0dca \u0d9c\u0daf\u0dca\u0dba \u0dba \u0dc0\u0dc0\u0dba\u0dba \u200d\u0dbb\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dd2 \u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd6 \u200d\u0dbb\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0dba\u0d9a\u0db4\u0dad \u0dd2\u0da7\u0daf\u0dd4 \u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0dad\u0dcf\u0dba\u0db4\u0dad\u0dad\u0db4\u0dad\u0d9a \u0dbb\u0dba\u0dd4\u0dbb\u0dca\u0dbd\u0d9c \u0dba \u0dc0\u0dc0\u0dba\u0dba \u0dc3\u0dcf\u0dba\u0db1 \u0dad\u0dd0\u0dc0\u0dd0 \u0d9a\u0dc0\u0dd3\u0db8 \u0dc4\u0dcf \u0d9a\u0db6\u0dcf \u0daf\u0dd4\u0dca \u0d9a\u0dd4\u0da9\u0dcf \u0d96\u0dc2\u0dca\u0da8\u0db0 \u0db1\u0dd2\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dcf\u0dba\u0db1 \u0dba\u0dca \u0dad\u0dca\u200d\u0dbb \u0d85\u0dbd\u0dd4 \u0d9a\u0dc0\u0dd0\u0da9\u0dd2\u0dba\u0dcf \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0dd2\u0da7\u0daf\u0dd4 \u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dad\u0dcf\u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0da7\u0dba\u0dca \u0d9c\u0dc0\u0dca \u0d9a\u0dba\u0db1\u0dd4 \u0d9a\u0db6\u