    "chunk_text": "2009 \u0da2 2\u0dcf \u0db8 ]2\u0da7\u0db1\u0dd2 \u0dc0\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0dc0\u0dd3\u0db1\u0dca\u0dad\u0dad \u0da2\u0dda\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dd4\u0d82\u0dd4 \u0db8\u0da7\u0dd2 \u0dd4\u0db8\u0dcf \u0db8\u0dd9 \u0dcf \u0dc0\u0da7\u0dda\u0dc1\u0dda. \u0dc1\u0dda \u0dd9\u0dc1\u0da7\u0dca \u0d912\u0d9a\u0da7 \u0dc4\u0dd2\u0da7\u0dbb \u0dc1\u0db4\u0dcf\u0dd2\u0dc0\u0dd3\u0db8\u0db4\u0dd2 \u0dd4\u0db8\u0dcf 2 \u0da2\u0dba\u0db1\u0dca\u0dad\u0dad \u0da2\u0dda\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dd9\u0dad\u0dca \u0db8\u0da7\u0dd2 \u0dd4\u0db8\u0dcf \u0da2 2\u0dcf \u0db8 752\u0da7\u0db1\u0dd2 \u0dc0\u0dcf SSP \u0d85\u0daf\u0dd2\u0d9a\u0dcf \u0db8 \u0db8\u0dcf\u0dad\u0dca\u0db8\u0dba\u0dcf\u0da7 \u0d9a \u0dcf \u0d9a\u0dd9 \u0dcf \u0d9a\u0dd2\u0dba 2\u0dcf, \u0dc1\u0dda \u0d9d\u0dcf\u0dad \u0dba\u0da7 \u0dc0\u0dd3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0 \u0dc1\u0db8\u0ddd\u0da7\u0dbb\u0dca\u0dbd \u0db6\u0dba\u0dd2\u0dbb\u0dd2\u0d9a \u0dba \u0d85\u0dad\u0dca\u0dd2 \u0da9\u0dd2\u0dba \u200d\u0dbb\u0dc1\u0dda \u0dc1\u0d86 2\u0d9c\u0dd4 \u0da0 \u0db6\u0dd2\u0db8\u0d9a \u0dd2 \u0dc1\u0db6 2\u0dcf \u0d9a\u0dd2\u0dba \u0dcf \u0d85 \u0da0 \u0dcf \u0db1\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba \u0dcf \u0d94\u0dad\u0dca\u0dd4\u0d9a \u0da0\u0dc12\u0d9a\u0dca\u0dad 2\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dcf\u0dc1\u0dda \u0dca\u0d9a \u0dcf \u0dd2\u0dba\u0dd4\u0db8\u0d9a\u0dca\u0dad \u0d912 \u0dcf \u0dd2 \u0dc1\u0db6 2\u0dcf \u0d9a\u0dd2\u0dba \u0dcf. \u0dcf\u0da7\u0db6\u0da7\u0dba\u0dd2, \u0da7\u0da7 \u0db4\u0dc0\u0dd3\u0db8\u0dc1\u0dc0\u0dd3\u0db8 \u0db4\u0dd3\u0dad\u0d9a\u0dca\u0dad\u0dc2\u0d9a \u0d9a\u0dab\u0dca\u0da9\u0da9\u0dcf\u0dba\u0db8 \u0d91\u0db8 \u0dd2\u0db4\u0dd2\u0dc1\u0d86 \u0daf\u0dd2 \u0dba \u0db6\u0da7\u0dd4 2\u0dcf\u0db8 \u0daf\u0dd2 \u0dba \u0da2\u0dda\u0db0\u0dd2\u0dba\u0da7 \u0dd2 \u0db6\u0dd4\u0dc1\u0dab\u0dca\u0da9, \u0da2 2\u0dcf \u0db8 76. \u0db8\u0dd4\u0dad\u0dca \u0dc1\u0db4\u0dcf\u0dd2\u0dc0\u0dd3\u0db8\u0db4\u0dd2 \u0da2\u0dba\u0db1\u0dca\u0dad\u0dad \u0da2\u0dda\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dd9\u0dad\u0dca \u0db8\u0da7\u0dd2 \u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dba 2\u0dcf, 752\u0da7\u0db1\u0dd2 \u0dc0\u0dcf \u0db8\u0da7 \u0dc1\u0db8\u0dc1\u0dcf\u0db8 \u0dd2\u0dba\u0dd4\u0db8\u0d9a\u0dca\u0dad \u0d862\u0dcf \u0d9a\u0dd2\u0dba \u0dcf. \u0d85\u0db4\u0da7 \u0dc4\u0dd2\u0dad\u0dcf\u0dd4\u0db1\u0dca\u0dad \u0db6\u0da7\u0dcf\u0da7, \u0d92 \u0dc1\u0dad\u0dcf\u0dd9\u0dd4 \u0da0 \u0dcf\u0d82\u0dd4\u0db1\u0dca\u0dad \u0dc1\u0dda \u0db4\u0dd2\u0da7\u0dd4\u0db4\u0dc0\u0dd3 \u0dca\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0d9a\u0dc0\u0dd4\u0dc0 \u0d9a\u0dd2\u0dba \u0dcf. \u0da2\u0dda\u0dc1 \u0db8\u0dc2\u0dc1\u0dba\u0db1\u0dca\u0dad\u0db8 \u0dc1\u0dda \u0db4\u0dd3\u0dad\u0d9a\u0dca\u0dad\u0dc2\u0dab \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0dca\u0daf\u0dd2 \u0db8\u0dba\u0da7 \u0d85\u0dd9\u0dc1\u0dd4 \u0dba \u0dc1\u0d9a\u0dcf\u0da7 \u0d85 \u0da0 \u0dcf \u0db1\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba \u0dcf \u0d94\u0dad\u0dca\u0dd4\u0d9a \u0da0\u0dc12\u0d9a\u0dca\u0dad \u0d9a\u0dd2\u0dda2\u0dcf \u0d9a\u0dd2\u0dba \u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0d91\u0dd4\u0db8\u0dcf \u0d92 \u0d9a\u0dcf\u0dd9\u0dab\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad.\n\n\u0d92 2\u0dcf\u0dc1\u0d89\u0db8 \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad \u0d9a\u0da7\u0db8\u0dd2 \u0dba\u0dd2, \u0d9a\u0dd3\u0dad\u0dca \u0dc1 \u0dcf\u0dba\u0dcf\u0dbb\u0dca\u0dbd \u0db8\u0da7\u0dd2 \u0dd4\u0db8\u0dcf\u0dc1\u0d89 \u0d92 2\u0dcf\u0dcf \u0dc1\u0d86 \u0dd2 \u0db6\u0dd2 \u0dcf,- \u0db4\u0dcf\u0dd2 \u0dc1\u0dad\u0db1\u0dca\u0dad \u0dc1\u0d9a\u0ddd\u0db1\u0dca\u0dad \u0db8\u0dcf\u0dad\u0dca\u0db8\u0dba\u0dcf\u0dc1\u0d89 \u0d9a\u0dcf\u0dbb\u0dca\u0dbd \u0d91\u0dc1\u0d9a\u0dca\u0dad \u0dd2 \u0db6\u0dd2 \u0dcf fingerprints 2\u0dd4\u0dba\u0d9a\u0dca\u0dad \u0dcf\u0dda\u0db6 \u0dc0\u0dd4\u0dab\u0dcf. \u0d92 fingerprints2\u0dd2\u0db1\u0dca\u0dad \u0d85\u0dd4\u0dab \u0dc0\u0dd4\u0dab\u0dcf, \u0da7\u0dca\u200d\u0dbb\u0dd2\u0dc1\u0db4\u0dcf\u0dd2 \u0dcf\u0db8\u0dd4\u0dc0\u0dcf \u0d9a\u0d9a\u0dc0\u0dd4\u0dc1\u0dbb\u0dca\u0dbd \u0dc4\u0dd2\u0da7\u0dbb \u0dd4\u0dc0 \u0dcf\u0dd4\u0db8 \u0dc0\u0dd3\u0dcf \u0dd9\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dad\u0dc2 \u0d9a\u0dd2\u0dba \u0dcf \u0db1\u0dd2 \u0db0\u0dcf \u0db8\u0db1\u0dca\u0dad \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dc1 \u0d9a\u0dca\u0dad. \u0dc1\u0dda \u0d85\u0dba \u0d85\u0dc0 \u0d82\u0d9a\u0dcf\u0dc12\u0db1\u0dca\u0dad \u0db4\u0dd2\u0da7\u0dad\u0dca \u0dc12 \u0dcf \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dcf \u0dcf \u0dd2 \u0dc1\u0db6 2\u0dcf; \u0d82\u0d9a\u0dcf\u0dc1\u0dda \u0da7\u0dcf\u0da7. \u0dc1\u0dda \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dcf\u0db8\u0dba \u0dc1\u0db8\u0dc1\u0dcf\u0db8 \u0dba \u0dc1\u0d9a\u0dcf\u0da7 7015 \u0da2 2\u0dcf \u0db8 0]2 \u0dc0\u0dcf \u0d85\u0dd4 \u0dad\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd42 \u0db4\u0dad\u0dca \u0dc0\u0dd4\u0dab\u0dcf\u0da7 \u0db4\u0dc0\u0dd3\u0db8\u0dc1\u0dc0\u0dd3\u0db8 \u0d92 \u0d86\u0dab\u0dca\u0da9\u0dd42 \u0dba\u0da7\u0dc1\u0dad\u0dca \u0dc1\u0dda \u0d85\u0dba \u0d85\u0dad\u0dca \u0d85\u0da9\u0d82\u0d9c\u0dd42\u0da7 \u0dd4\u0da7\u0db1\u0dd3\u0db8 \u0dc0\u0dd3\u0d9a\u0dcf\u0dcf 2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0dbd\u0dd4\u0dba \u0d85\u0dd9\u0dc1\u0dd4 \u0dba 2\u0dcf, \u0dcf\u0db1\u0dd2 \u0d85\u0dc1\u0dda\u0dc1\u0dc0\u0dd3\u0db8\u0d9a\u0dd9 \u0db8\u0dcf\u0dad\u0dca\u0dad\u0dba\u0dcf \u0dc0\u0dd3\u0dcf \u0db1\u0dd2 \u0dcf\u0db1\u0dca\u0dad\u0dad \u0dbb\u0dd2\u0dbd\u0dcf2\u0dcf. \u0dc1\u0dda \u0dc1\u0dc0\u0db1\u0dca\u0dad \u0dcf \u0dca\u0dad\u0dcf\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0dd3\u0dad2 \u0dc0\u0dd3\u0db1\u0dca\u0dad\u0dad \u0d9d\u0dcf\u0dad \u0dc1\u0d86 \u0dbb\u0dd2\u0dba\u0dd4 \u0dc1\u0dad\u0dcf\u0dd9\u0dd4 \u0da0 \u0dc1\u0dc0\u0dd3\u0dcf\u0dba\u0dcf \u0dc1\u0dd4 \u0dba 2\u0dcf. \u0dcf\u0da7\u0db6\u0da7\u0dba\u0dd2, \u0d91\u0dad\u0da7\u0db1\u0dd2\u0db1\u0dca\u0dad \u0db4\u0dc0\u0dd3\u0db8\u0dc1\u0dc0\u0dd3\u0db8 \u0dc1\u0db8\u0dcf\u0d9a\u0dc0 \u0dc12\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad? 701 \u0dc1\u0dd4\u0ddd\u0dc0\u0dcf\u0dcf\u0dba \u0dd9\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dad\u0dc2 \u0db8\u0dcf\u0dad\u0dca\u0dad\u0dba\u0dcf \u0dd9\u0dc1\u0da7\u0dca \u0da2 \u0dcf\u0db0\u0dd2\u0db4\u0dd2 \u0dc0\u0dd4\u0dab\u0dcf\u0da7 \u0db4\u0dc0\u0dd3\u0db8\u0dc1\u0dc0\u0dd3\u0db8 \u0db1\u0dd2 \u0dcf\u0db1\u0dca\u0dad\u0dad \u0dbb\u0dd2\u0dbd\u0dcf2\u0dcf \u0db8\u0dcf\u0dad\u0dca\u0dad\u0dba\u0dcf \u0d82\u0d9a\u0dcf\u0dc12\u0db1\u0dca\u0dad \u0db4\u0da7 \u0dcf \u0dba 2\u0dcf. \u0d92\u0d9a\u0da7 \u0dc1\u0dcf\u0db8\u0dd42 \u0dc12 \u0d91\u0d9a\u0d9a\u0dca\u0dad \u0dc1 \u0dcf\u0dc12\u0dba\u0dd2, \u0d94\u0dd4\u0dab \u0dc5 \u0dd2 \u0db6\u0dd4\u0dab\u0dd4 documents \u0db1\u0dd2\u0dc0\u0dd3\u0dcf, \u0d94\u0dd4\u0dab \u0db8\u0dd9\u0dab\u0dd3\u0dba \u0dad\u0dbb\u0dca\u0dbd\u0da2 \u0dba\u0da7 \u0d9a\u0dca\u0dad \u0dc12 \u0db1\u0dd2\u0dc0\u0dd3\u0dcf \u0dc0\u0dd3\u0db1\u0dca\u0dad\u0dad \u0da2\u0dda\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dd4\u0d82\u0dd4 \u0db8\u0dcf\u0dad\u0dca\u0dad\u0dba\u0dcf \u0dd4\u0da7 \u0dd2 \u0dc1\u0db6 \u0d92 \u0dbb\u0dd2\u0dba\u0dd4 \u0dc1\u0dad\u0dcf\u0dd9\u0dd4 \u0da0\u0dad\u0dca \u0d91\u0d9a\u0dca\u0dad\u0d9a \u0d94\u0dd4\u0dab \u0d82\u0d9a\u0dcf\u0dc12\u0db1\u0dca\u0dad \u0db4\u0dd2\u0da7\u0dad\u0dca \u0dc12 2\u0dcf. \u0da7\u0da7 \u0db4\u0dc0\u0dd3\u0db8\u0dc1\u0dc0\u0dd3\u0db8 \u0dc1\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0dad\u0dc0 \u0dc12\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad? 2019 CID \u0d91\u0dc1\u0d9a\u0dca\u0dad 0 \u0dd4\u0dcf\u0dab\u0d9a\u0dca\u0dad \u0d91\u0d9a \u0dc02\u0dc0\u0dd3\u0d9a\u0dca\u0dad \u0dad\u0dd4\u0dc5\u0dad \u0db8\u0dcf \u0da0 \u0d9a\u0dd9 2\u0dcf. \u0db8\u0dcf \u0da0 \u0d9a\u0dd9 \u0dcf \u0dc1\u0dda \u0dbb\u0dd2\u0dba\u0dd4 \u0dbb\u0dd2\u0dda\u0db0\u0dd2 \u0dba\u0da7\u0db4\u0dad\u0dca \u0d9a\u0dd9 \u0dad\u0da7 \u0d9a\u0da7 \u0dad\u0dbd\u0dcf\u0dd4 \u0d9a\u0dd9 \u0dcf \u0dd2 \u0dc1\u0db6 2\u0dcf."
