    "chunk_text": "\u0db4\u0dd0\u0db1\u0dca\u0dc0\u0db4\u0dd0\u0dca\u200d\u0dd4\u0dab\u0dd4\u0dc0\u0dca\u0dc0\u0d9a\u0dcf\u0da1\u0dcf \u0dc0\u0dca\u200d\u0dc0\u0db0\u0dca\u200d\u0dca\u0db1\u0dca\u0dda\u0dca\u200d \u0dc0\u0dc0\u0d91\u0dc5\u0dd2\u0dd9\u0dad\u0dc0\u0d86\u0db4\u0dd4\u0dc0\u0d9a\u0dcf\u0dd0\u0dbd\u0dd2\u0db1\u0da7\u0dca\u0dc0\u0d87\u0db8 \u0dad\u0dd2\u0dca\u200d\u0dc0\u0dda\u0dd9\u0d9a\u0dd4\u0dad\u0dc0\u0db8 \u0db8 \u0dc0\u0d9a\u0dd2 \u0dca\u200d\u0dc0 \u0dc0\u0dda\u0db8\u0dca\u0dc0\u0db4\u0db1\u0dad\u0dca\u0dc0\u0dda\u0d9a\u0dcf\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc0\u0d86\u0dda\u0dd9\u0ddd\u0da2\u0dcf\u0db1\u0dd9\u0dad\u0dc0\u0dca\u200d\u0dbb\u0dc1\u0dae\u0db1\u0dd9\u0d9a\u0dca\u0dc2\u0dc0\u0dda\u0dca\u200d\u0db1\u0dca\u0db1\u0dc0\u0db4\u0dd4\u0dc5\u0dd4\u0dca\u200d\u0db1\u0dca\u0dc0\u0d9a\u0dd2\u0dd9 \u0dc0.\u0dc0\u0d92\u0dc0\u0d87\u0db8 \u0dad\u0dd2\u0dd4\u0db8 \u0dc0\u0dc0\u0db8 \u0dad\u0dc0\u0d9a\u0dd2 \u0dca\u200d\u0dc0 \u0dc0 \u0dd2\u0dc0\u0dc0\u0db1\u0dca \u0dc0\u0d86\u0dda\u0dd9\u0ddd\u0da2\u0dcf\u0d9a\u0dcf\u0dd9\u0db1\u0dca\u0dc0\u0d9c\u0dd0\u0db1\u0dc0\u0dc4\u0dd2\u0dad\u0db1\u0dca\u0db1\u0dc0\u0d95\u0db1\u0dd1\u0dc0\u0db1\u0dd0\u0d9a\u0dd0 \u0dc0\u0d9a\u0dd2\u0dd9 \u0dc0.\u0dc0\n\n41 42\n\n\u0db4\u0dc0\u0dbb\u0dca\u0dbd\u0dd2\u0dda\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dca\u200d"
