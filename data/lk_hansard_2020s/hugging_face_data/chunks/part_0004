    "chunk_text": "\u0db1 \u0db8\u0da0\u0db8\u0dbb\u0dca\u0dbd \u0dc0\u0dba\u0dc1 \u0d9a\u0dca\u0dc2 \u0dc4\u0dd2\u0dad\u0db0\u0dc1\u0db0 \u0d94\u0dc4\u0dd4\u0dc1\u0dda level \u0d91\u0dcf \u0d85\u0dd4\u0d9a\u0dc0. \u0d94\u0dc4\u0dd4 \u0dc1\u0dc0 level \u0d91\u0dcf\u0d9a\u0dd2\u0db0 \u0dc4\u0dd2\u0dad\u0db0\u0dc1\u0db0. \u0d91\u0dc1 \u0db1 \u0dc1 \u0db8\u0dc1\u0dc0\u0dd2 \u0dc4\u0dd2\u0dad\u0db0 \u0dd1 . \u0d9c\u0dc1\u0db8\u0dca \u0d89\u0db0 \u0d85\u0dc4\u0dd2\u0d82\u0dc4\u0dcf\u0db1 \u0db1\u0dd4\u0d9a\u0dc4\u0dda\u0dc4 \u0db8 \u0dc4\u0dd2\u0dad \u0dd2\u0dbb\u0db0\u0dd2 \u0da7 \u0dc4\u0dd2\u0dad\u0db0 . \u0d92 \u0db1\u0dd4\u0d9a\u0dc4\u0dda\u0dc4 \u0db8 \u0dc4\u0dd2\u0dad \u0dc4\u0dba\u0dca\u200d \u0dd2\u0dbb\u0db0\u0dd2 \u0da7 \u0dc4\u0dd2\u0dad\u0db0 . \u0d85\u0db0 \u0d92 \u0dc4\u0dba\u0dca\u200d \u0dad\u0dd4 \u0da7 \u0d87\u0dd2\u0dbb\u0dad\u0dca \u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dcf\u0dba\u0db0 . Loan \u0d91\u0dcf\u0d9a\u0dca\u0dc2 \u0d9c\u0dd4\u0db1\u0dd3\u0db1 \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba \u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0dc0\u0db8\u0dc1\u0dda \u0db8\u0dca \u0db8\u0dca \u0dc1\u0daf\u0dca\u0dc0 \u0dc3 \u0d9c\u0dd4 \u0d86 \u0dad\u0db8\u0dc0 \u0dca\u0dd4\u0dd4\u0d9a\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db1 \u0d8b\u0db4\u0dd2\u0dba\u0db1 \u0d9a\u0dcf\u0db8\u0dba\u0dc1 \u0db0 \u0dcf\u0dba\u0db0 . \u0d91\u0dc0\u0dd4\u0dd2\u0dba \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0d9a\u0dca\u0dc2 \u0dd4\u0dad\u0dd2 \u0dd2\u0dba\u0dc4\u0db8 \u0d85\u0dc1 \u0dc3 \u0d9c\u0db8\u0dca \u0db4\u0dc5\u0db8\u0dad\u0dca\u0dc0\u0dca\u200d \u0db8\u0dd2\u0dd2\u0dba\u0dc4\u0dda\u0dc3\u0dd4 \u0d85\u0dca \u0dc1\u0dc0 \u0dc1\u0dcf\u0db8\u0da7 \u0dc1\u0d9c\u0db8\u0da9\u0d9a\u0dca\u0dc2 \u0dd4\u0d9a\u0dca\u0dc2 \u0dd2\u0dbb\u0db3\u0dd2 \u0dc0\u0db8. \u0d91\u0dc0\u0dd4\u0dd2\u0dba \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0d9a\u0dca\u0dc2 \u0dd4\u0dad\u0dd2 \u0dd2\u0dba\u0dc4\u0db8 \u0dc1\u0dcf\u0db8\u0dc1 \u0db8 \u0dc3\u0dca\u200d \u0dca\u0dca\u0db8\u0da7 \u0dc1\u0dc0\u0dca\u0da0 \u0dc1\u0daf\u0dca \u0dad\u0db1\u0dd2 \u0dc1\u0dc0\u0db0\u0dc1\u0db0. \u0dc1\u0db8\u0dca \u0d85\u0dc1\u0dad\u0dca\u0dad\u0dca \u0d9c\u0db8\u0d9c\u0db0 \u0dc0\u0db8 \u0d85\u0dc1 \u0d9a\u0dca\u0dc2 \u0d85\u0dc1\u0dad\u0dca\u0dad\u0dca \u0d9c\u0db8\u0d9c\u0db0 \u0dc0\u0db8. \u0d85\u0dad \u0db4 \u0d9a\u0dd2\u0dc3\u0dd2\u0dc0\u0d9a\u0dca\u0dc2 \u0d91\u0dd2\u0db6 \u0da7 \u0d9c\u0db0 \u0dca\u0dd4\u0dd2\u0dba \u0dad\u0dd4 \u0da7 \u0dc4\u0dd2\u0dba\u0dc0\u0dd4\u0dba\u0db8\u0db1 \u0d85\u0dc0\u0dc4\u0db8 \u0dc1\u0dad \u0dcf\u0dba\u0db0 \u0dad\u0dd2\u0dc1\u0dca\u0db0\u0dc1\u0db0 suicide \u0dcf\u0dba \u0d9c\u0db0 \u0d91\u0dcf. \u0d92 \u0dd2\u0dbb\u0db0\u0dd2 \u0da7 \u0db4\u0dc0\u0dd4 \u0dc3 \u0db4\u0dd2\u0d9a\u0db0 \u0dd2\u0dbb \u0db8 \u0dc1\u0dc0 \u0dd4\u0d9a \u0d85\u0db4\u0dd2 \u0dca\u0d9a\u0dd2 \u0dc0\u0db8. \u0d92 \u0dd2\u0dba\u0dc4\u0db8 \u0d86 \u0dad\u0db8\u0dc0 \u0dc1\u0db8\u0dca \u0d9c\u0dd4 \u0dca\u0dd4\u0dd4\u0d9a\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db1 \u0d89\u0dad\u0db8\u0db1 \u0dc0\u0dd4\u0dca\u0d9c\u0dad\u0dca \u0dc1\u0dca \u0d9a\u0dca\u0dc2.\n\n\u0db8\u0dd6\u0dbd\u0dca\u200d\u0db8\u0dc4 \u0db8\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db1\u0db0\u0dd3\u0dad\u0dd4\u0db1\u0dd2\u0dba \u0dc1\u0db4\u0db8\u0dbd\u0dd3\u0db8\u0dc3\u0dd2 \u0da7 \u0dc0\u0dd4\u0da9\u0dd2\u0dc1 \u0db0\u0db1 \u0d91\u0db0\u0dc1\u0db0 \u0d89\u0da9\u0db8\u0dca \u0dc4\u0db8\u0dca\u0dca\u0db0 \u0db4\u0dd4\u0db8\u0dd2\u0dab\u0dd2\u0dd2. \u0d89\u0da9\u0db8\u0dca \u0d9a\u0dba\u0db8\u0dc0\u0dd4 \u0dc3 \u0dd2\u0dbb\u0dc4\u0dc0 \u0d91\u0dcf \u0dad\u0db1\u0dd2 \u0dc1\u0db4\u0db8\u0dbd\u0dd3\u0db8\u0dc3\u0dd2 \u0da7 \u0dc0\u0dd4\u0da9\u0dd2\u0dc1 \u0db0\u0db1 \u0dcf\u0dba\u0db0 \u0dad\u0dd2\u0dc1\u0dca\u0db0\u0dc1\u0db0. \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba \u0dca\u200d\u0dbb \u0dda \u0dc4\u0db8\u0dca\u0dca\u0db0 \u0db4\u0dd4\u0db8\u0dd2\u0dab\u0dd2\u0dd2 \u0dad\u0db1\u0dd2 \u0dc1\u0db4\u0db8\u0dbd\u0dd3\u0db8\u0dc3\u0dd2 \u0da7 \u0d8a\u0dc5\u0d9f\u0da7 \u0dc0\u0dd4\u0da9\u0dd2\u0db4\u0dd4\u0dba \u0d91\u0db0\u0dc1\u0db0. \u0d91\u0dc0\u0dd4\u0dd2\u0dba \u0dc1 \u0db8\u0dc1 \u0d9a\u0dd4\u0dad\u0dca \u0dc3\u0dd2\u0dd4\u0dc0\u0dd3\u0db8\u0dca \u0dad\u0dd2\u0dc1\u0dca \u0dc0\u0db8. \u0d8a\u0dc1\u0dad-\u0dc1\u0db4\u0dc1\u0dbb\u0dca\u0dbd\u0dca\u0db8 \u0d91\u0dc0\u0dd4\u0dd2\u0dba \u0dc3\u0dd2\u0daf\u0dca\u0db0\u0dd2 \u0d9a\u0dca\u0dc2 \u0dc1\u0dc0\u0dca\u200d\u0db8 \u0dad\u0dd2\u0dc1\u0dca \u0dc0\u0db8 \u0db1\u0db1 \u0dca\u0dd4\u0d9a\u0dca\u0dc2\u0dcf\u0db8. \u0dca\u0dab\u0dca\u0da9\u0da9\u0db8\u0dba\u0dc1\u0dc0\u0dca\u200d \u0dca\u200d\u0dbb\u0dc1\u0daf\u0dca \u0dc1\u0dad \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba \u0d9a \u0dad \u0dcf \u0dcf\u0dab\u0dca\u0da9\u0da9\u0db8 \u0db1\u0d9a\u0dca\u0dc2 \u0dd2\u0dab\u0dc4\u0dd2\u0db0 \u0dc0\u0db8 \u0d9a\u0dca\u0dc2 \u0db4\u0dd4\u0dca\u0dc0\u0dd6 \u0d85\u0dc4\u0dd2\u0d82\u0dc4\u0dcf \u0dc0 \u0dc4\u0dcf \u0db1\u0dd4\u0d9a\u0dc4\u0dda\u0dc4\u0dc1 \u0d9a\u0dd4\u0da7 \u0d9c \u0dca\u200d\u0db8 \u0d92 \u0dc0\u0db8 \u0d85\u0dba\u0dc1\u0d9c \u0dd2\u0dab\u0dc4\u0dd2 \u0dc3\u0dca\u200d\u0db8 \u0dad\u0dd2\u0dc1\u0dca \u0dc0\u0db8. \u0dc1\u0db1\u0db8\u0dcf\u0dca \u0dc0\u0dd4\u0dc1\u0dab\u0dca\u0da9 \u0d9a\u0dd2 \u0dca\u200d\u0db8\u0dc0\u0dad\u0dca \u0d92 \u0db1\u0dd4\u0d9a\u0dc4\u0dda\u0dc4 \u0db8 \u0dca\u0db0\u0dc1\u0db0 \u0dd4 \u0dd4. \u0d92 \u0db1\u0dd4\u0d9a\u0dc4\u0dda\u0dc4 \u0db8\u0dc1\u0dda \u0db4\u0dd4\u0dad\u0db8 \u0dc0\u0db8 \u0dc1\u0dad lease \u0d91\u0dcf \u0db1\u0db8\u0dc4 \u0dc1\u0dca\u0dcf\u0d9a\u0dd2\u0db0 \u0dc1\u0d9c\u0dc0\u0dca\u200d\u0db8 \u0dd4 \u0dd4. \u0d92 \u0dd2\u0dba\u0dc4\u0db8 \u0d92 \u0db1\u0dd4\u0d9a\u0dc4\u0dda\u0dc4 \u0db8\u0da7 \u0d9c \u0dca\u200d\u0db8 \u0dc0\u0db8 \u0d85\u0dba\u0dc1\u0d9c \u0dd2\u0dab\u0dc4\u0dd2 \u0dc3\u0dca\u200d\u0db8 \u0dad\u0dd2\u0dc1\u0dca \u0dc0\u0db8. \u0dca\u0dd4\u0db0 \u0d92 \u0db1\u0dd4\u0d9a\u0dc4\u0dda\u0dc4 \u0db8 \u0d89\u0dc4\u0dda\u0db4\u0dd2\u0dd2\u0dba\u0dad\u0db8\u0dc1 \u0dc3 \u0d89\u0db0 \u0dc0\u0db8. \u0dc0\u0db8 \u0d9c\u0db0 \u0dc1\u0db4\u0db8\u0dbd\u0dd3\u0db8\u0dc3\u0dd2 \u0da7 \u0d9a\u0dd2 \u0dca\u200d\u0db8 \u0dd2\u0dab\u0dc4\u0dd2 \u0dc3\u0dca\u200d\u0db8\u0dad\u0dca \u0dd4 \u0dd4. \u0da0\u0dab\u0dca\u0da9\u0da9\u0dd2 \u0d9a\u0dcf\u0d9a\u0dca\u0dc2 \u0d85\u0dba\u0dc1\u0d9c \u0d87\u0dd2\u0dbb\u0dad\u0dca \u0dad\u0db1\u0dd2 \u0d92 \u0dd2\u0dbb\u0db0\u0dd2 \u0da7 \u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dcf\u0dba \u0dad\u0dd2\u0dc1\u0dca\u0db0\u0dc1\u0db0. \u0d91\u0dc1 \u0db1 \u0dcf\u0dba\u0db0 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db0\u0dca? \u0dc1\u0db1\u0db8\u0dcf\u0d9a\u0dca\u0dc2\u0dca \u0dc1\u0db8\u0dca \u0d9a\u0dca\u200d\u0dbb\u0db1 ? \u0dc1\u0db8\u0dca \u0d9a\u0dca\u200d\u0dbb\u0db1 \u0dc1\u0dc0 \u0dc4\u0dda \u0dd2\u0dbb \u0dba\u0dd4\u0dad\u0dd4\u0db1\u0dd2 . \u0d92 \u0dd2\u0dba\u0dc4\u0db8 \u0dd2\u0dbb\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1 \u0db0 \u0dc1\u0db8\u0dca \u0dc1\u0daf\u0dca\u0dc0 \u0dc3 \u0dd2\u0dba \u0db8\u0db1 \u0dcf\u0dba\u0db0 system \u0d91\u0dcf\u0d9a\u0dca\u0dc2 \u0d87\u0dad\u0dd2 \u0dcf\u0dba\u0db0 \u0d9a\u0dd2 \u0db8 \u0db1\u0db1 \u0d89 \u0dc3\u0dca\u200d\u0db8 \u0dc3\u0dd2\u0d9a \u0dc0\u0db8."
  },
