    "chunk_text": "\u0dc1\u0db8\u0dc1\u0dc4\u0dda \u0d9a\u0dab\u0dca \u0dcf\u0dba\u0db8\u0dca\u0dc0 \u0d91\u0dca\u0dc0\u0d9a \u0d9c\u0db8\u0dca\u0daf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0d9a\u0dab\u0dca \u0dcf\u0dba\u0db8\u0dca\u0dc0 \u0dc1\u0dbd\u0dc4 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0dcf \u0dc4\u0dd4\u0dc1\u0daf\u0d9a\u0dbd\u0dcf \u0d9a\u0dbb\u0dbd\u0dcf, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db8 \u0dbb\u0dd0\u0d82\u0d9a\u0dd4\u0dc0 \u0db4\u0db1\u0dad\u0dca \u0dc1\u0d9a\u0da7\u0dd4\u0dca\u0db6\u0db4\u0dad \u0d85\u0dbd\u0dd4\u0dad\u0dd2\u0dca\u0daf \u0dc4\u0dca\u0db6\u0db8\u0dad \u0d9a\u0dbb\u0db4\u0dd4 \u0db1\u0dd2\u0dc4\u0dcf \u0db8 \u0dbb\u0dd0\u0d82\u0d9a\u0dd4\u0dc1\u0dda \u0d85\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2\u0dba \u0d9c\u0dd0\u0db1 \u0dc0\u0dd2\u0dad\u0dbb\u0dca\u0dc0 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd3\u0dca\u0daf\u0dd4\u0dc0 \u0dad\u0dd3\u0dbb\u0dab \u0d9c\u0dca\u0daf\u0db1 \u0d95\u0db1\u0dd1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0db4 \u0dc4\u0dd2\u0dad\u0db1\u0dc0\u0dcf \u0db1\u0dca\u0db6 \u0d9c\u0d9a \u0dc0\u0dd0\u0dbb\u0dd0\u0daf\u0dd2\u0dba\u0dd2. \u0d9c \u0dc4\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf\u0dc1\u0dda \u0dc1\u0d9a\u0ddc\u0da7\u0dc4\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0dca\u0daf \u0dbb\u0dc0\u0da7 \u0dc0\u0dd2\u0db0\u0dca\u200d\u0dcf\u0dba\u0d9a\u0dba\u0dad\u0dca, \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82 \u0dba\u0dad\u0dca, \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dad\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dad\u0dca, \u0d85\u0db4\u0dad\u0dca \u0dc4\u0dca\u0db6\u0dbb\u0dca\u0daf\u0db0\u0dca\u200d \u0dc1\u0dc0\u0dca\u0daf\u0dc1\u0dca\u0daf \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dca\u0db6 \u0d9c\u0d9a \u0dad\u0db1\u0dd2\u0dc1\u0dba\u0dca\u0daf \u0d9a\u0dbb\u0dca\u0daf\u0db1 \u0dbb\u0dd0 \u0dd0. \u0d9c \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0dbb\u0dcf\u0dca\u200d\u0dba \u0db8\u0dd6\u0dbd\u0dba \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dad\u0dca. \u0d89\u0dad\u0dd2 \u0dcf\u0dc4\u0dc1\u0dda \u0dd2\u0db1\u0dd4\u0dc0 \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0da0\u0dca\u0daf \u0dc1\u0d9c\u0ddc \u0dca\u0dc0 \u0dc1\u0dda\u0dc0\u0dbd\u0dca \u0d85\u0daf \u0dd2\u0db1\u0dd4\u0dc0 \u0dc1\u0dc0\u0db8\u0dd2\u0dca\u0daf \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0dd2 \u0d89\u0dad\u0dd2 \u0dcf\u0dc4\u0dba\u0da7 \u0d9c\u0db8\u0dca\u0daf \u0d9a\u0dc1\u0dc5\u0ddc\u0dad\u0dca \u0dc1\u0db4\u0dc1\u0db1\u0db1\u0dc0\u0dcf, \u0d91\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db5\u0dbd\u0dba \u0d89\u0dad\u0dcf\u0db8 \u0db7\u0dba\u0d82\u0d9a\u0dcf\u0dbb \u0dc0\u0dd6\u0dc0\u0dca\u0dc0 \u0dbb\u0dc0. \u0dc1\u0dca\u0db6 \u0db4\u0dca\u200d\u0dbb \u0dca\u0db1\u0dba \u0dad\u0dd2\u0dc1\u0dbb\u0dca\u0daf\u0dc1\u0dca\u0daf \u0dad\u0dba\u0dd2?\n\n491 492\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dca\u0db6\u0dca\u0daf\u0dad\u0dd4\u0dc0"
  },
