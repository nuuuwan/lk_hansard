 \u0db1\u0dd2 \u0da7 \u0db8\u0dd6\u0d9a\u0dba \u0dc1\u0dc0\u0dc5 \u0dc1\u0db4\u0dca\u0dc5 \u0dcf\u0dc0\u0da7\u0dc0\u0dca \u0dbb\u0dd3\u0db8 \u0dc1 \u0dc3 \u0db4\u0dd2\u0dbd\u0dc0\u0dca \u0dc1\u0da7 [\u0dc1 \u0db3\u0dd0\u0dcf\u0d9a\u0dd4\u0dc0\u0da7 \u0d9a\u0db3\u0da7 \u0daf\u0dd3 \u0dad\u0dd2\u0dc0\u0dc1\u0db3\u0db1 \u0d92 \u0db3\u0d9a\u0dad\u0d9a \u0dc1\u0da7 \u0db1\u0dd3\u0dad\u0dd2\u0dc0[\u0dbd \u0dc0\u0dca\u0db4\u0dca\u200d\u0dbb \u0da7\u0daf \u0dc1\u0dbb\u0dd2\u0dbd\u0da7 \u0da7\u0dca\u0dc0 \u200d\u0dbb\u0dd2\u0dbd\u0da7\u0dad\u0dca[ \u0dbb\u0dd3\u0db8 [\u0da7 \u0dc1\u0dd0\u0dbb\u0dd3 \u200d\u0dbb\u0dd2\u0dbd\u0da7 [\u0da7\u0dbb\u0dca \u0dbd \u0da7 \u0dca\u0da7 [\u0db1\u0dca \u0dca\u0dd3\u0db8[ \u0dc1\u0da7 \u0d91\u0db8\u0dd2[\u0da7 \u0db4\u0da7\u0dbb\u0dca\u0d9a\u0ddc\u0dc1 \u0dc3\u0db1\u0dca\u0db8\u0dd2\u0dc0 \u0d85[\u0dad\u0da7 \u0dc5 \u0dc0\u0da7\u0dc0 \u0d85\u0db4\u0da7 [ \u0dc1\u0db4\u0db1\u0dca\u0dc0\u0db1 \u0db3\u0dc0 \u0dc1\u0db1\u0dca \u0dca\u0db1\u0dca\u0db1\u0da7 \u0dd1\u0db1\u0dd1.\n\n\u0dd2\u0db0\u0dd2\u0db0\u0db0 \u0dca\u0dbb\u0dca\u0dae\u0dd2 \u0dd0\u0da7\u0dbd\u0dd4 \u0dc1\u0dca\u0dc1\u0da7 \u0d85\u0dc1\u0dda \u0db4\u0dca\u200d\u0dbb\u0db0\u0da7\u0db1 \u0db3\u0dd0\u0dcf\u0d9a\u0dd4 \u0dc1\u0daf \u0dc0\u0db1 [\u0dc1\u0da2\u0db1 \u0db3\u0dd0\u0dcf\u0d9a\u0dd4\u0dc0 \u0dd0\u0db1\u0dad\u0dca, \u0d9a\u0dcf \u0da7 \u0db3\u0dd0\u0dcf\u0d9a\u0dd4\u0dc0\u0dad\u0dca \u0dd0\u0db1\u0dad\u0dca \u0dc1\u0db1\u0dca \u0dc0\u0dd4\u0dc3\u0da7. \u0d85\u0db4\u0dd2 \u0db4\u0dd2\u0dd2\u0db6 \u0dad \u0dd4\u0dad\u0db8\u0dd2 \u0dbd\u0dc0\u0da7\u0dbb\u0dca\u0dc0\u0dbd\u0dc2\u0dab. \u0d9a\u0dd4[\u0db1 \u0dc1\u0dd3 \u0db4\u0da7\u0d9a\u0db1 \u0db1\u0da7\u0dbd \u0dad\u0dca\u0dc0 \u0dc4\u0dd2\u0dad \u0dca\u0da9\u0dd4\u0d9a\u0dca \u0dad\u0dd2\u0dc0\u0db6\u0dd4\u0dc3\u0dad\u0dca \u0dca\u0da7\u0da2\u0dba \u0dcf \u0dcf\u0dc0\u0da7\u0dc0\u0d9a\u0da7, \u0dc1\u0db3\u0dca\u0dc1\u0dc1\u0ddd \u0dca\u0da7\u0da2\u0dba \u0dcf \u0dcf\u0dc0\u0da7\u0dc0\u0d9a\u0da7 \u0dad\u0dc0\u0daf\u0dd4\u