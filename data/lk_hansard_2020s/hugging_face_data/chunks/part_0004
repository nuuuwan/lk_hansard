da7 \u0dd2\u0db0\u0dc1\u0dda\u0da0\u0db1\u0dbd \u0dca\u0db1\u0dca\u0db1 \u0db4\u0da7\u0db1\u0dca \u0d85\u0dca\u0dc1 \u0db1 \u0dad\u0dd2\u0dc0\u0dc1\u0db3\u0db1 \u0d91 \u0dd0\u0db1. \u0da2\u0db1\u0da7\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0db8\u0dd2[\u0da7 \u0dca\u0db4\u0dd4 \u0dc0\u0da7\u0dc0 \u0dd0\u0db1 \u0dbb\u0dd3\u0dbd\u0d9a\u0da7 \u0d85\u0dc1\u0dda [\u0dc1\u0da7\u0da0\u0da7\u0dbb\u0dca\u0dbd\u0db8\u0dd2\u0dc1[\u0d9a\u0dd4\u0dad\u0dca \u0d85\u0daf \u0dbb\u0dd3\u0dda\u0dc0\u0da7, \u0d85\u0db4\u0da7 \u0dad\u0dba \u0d85 \u0dad\u0dba \u0dc1\u0dc0\u0db1\u0dca \u0dca \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0dd1\u0db1\u0dd1 \u0dbb\u0dd3\u0dbd\u0d9a\u0da7. \u0dc1 \u0dca\u0dd2\u0db1\u0db1\u0dca[ \u0dbb\u0dd3\u0dbd\u0db1\u0dc0\u0da7 \u0db1 \u0dc3 \u0d91\u0db8\u0dd2[\u0da7 \u0dbb\u0dd3\u0dda\u0dc1\u0dda, \u0dc1[\u0dad\u0dd0\u0db1\u0daf\u0dd3 \u0dc1 \u0dca\u0da9\u0dc2\u0dab \u0d85 \u0dad\u0dba \u0dc0\u0da7 \u0dbb\u0dd3\u0dbd\u0db1\u0dc0\u0da7 \u0dbb\u0dd3\u0dbd\u0d9a\u0da7\u0dba\u0dd2. \u0db8\u0dd6\u0d9a\u0da7 \u0db1\u0da7\u0dbb\u0dd6\u0daa \u0dbb\u0dd4 [\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0db8\u0dd2[\u0db1\u0dd2, [\u0da7 \u0dc0\u0da7 \u0dca\u0db1\u0dca\u0db1 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0d9a\u0da7\u0dc0\u0dc2\u0dab \u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0db1\u0dd2 \u0da7 \u0da2\u0db1\u0da7\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0db8\u0dd2[\u0da7 \u0dbb\u0dd3\u0dbd\u0db4\u0dd4 \u0d91 \u0da7\u0dca\u0dc3\u0dbd\u0dc2\u0dab \u0dd2\u0db0\u0dad\u0dca\u0dc2\u0dab [[ \u0dbb\u0dd3\u0dbd\u0db1\u0dca\u0db1 \u0dc3. \u0d91\u0db8\u0dd2[\u0da7 \u0dbb\u0dd3\u0dda\u0dc0\u0da7, \"\u0d85\u0dc1\u0dda \u0dca\u0da7 \u0d8b\u0db8 \u0da7\u0db4\u0da7\u0dad\u0dbd\u0dc2\u0dab \u0dc0\u0da7\u0dc1\u0d9a \u0dc0\u0dd0\u0dd2\u0db1\u0d9a\u0da7 \u0dc1\u0dca\u0dca \u0dca) \u0d91 \u0dc2\u0dab \u0dc0\u0da7\u0dc1\u0d9a \u0d8b\u0da9\u0da7 \u0dca\u0dc0\u0da7\" \u0dbb\u0dd3\u0dbd\u0d9a\u0da7. [[ \u0db1 \u0dc3 \u0daf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc1\u0dd0, \u0d85\u0db4\u0dd2 \u0d8b\u0da9\u0da7 \u0dca\u0dc0\u0da7 \u0dbb\u0dd3\u0dbd\u0d9a\u0da7. \"\u0d85\u0db4\u0dd2 \u0dc0\u0dd0\u0dd4\u0db4\u0dc3\u0da7, \u0dc0\u0dd0\u0dd4\u0db4\u0dab\u0dd4 \u0dad\u0dd0\u0db1 \u0d85\u0db4\u0dd2 \u0d85[\u0da7\u0dbb\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0dbb\u0dd0\u0db3\u0dd2\u0d9a\u0da7 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0da7, \u0dc3\u0dbd \u0dc1 \u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0db1\u0dd2 \u0da7 \u0dc1 \u0dca\u0dc1\u0dc1\u0dca[ \u0dc1\u0dbb\u0dd2 \u0dd0\u0da7 \u0dc1\u0dc1 \u0db1 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0da7\" \u0dbb\u0dd3\u0dbd\u0d9a\u0da7 \u0dbb\u0dd3\u0dda\u0dc0\u0da7 \u0db1 \u0dc3, \u0d85\u0db4\u0da7 \u0d92 \u0db4\u0dd2\u0dd2\u0db6 \u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dc1\u0dca\u0dca \u0dca) \u0d91 \u0dc2\u0dab \u0dc0\u0dc1\u0d9a \u0d8b\u0da9\u0da7 \u0dca\u0dc0\u0da7 \u0dbb\u0dd3\u0dda\u0dc0\u0da7[, \u0d92 [\u0dc1\u0da7 \u0dd2\u0db0\u0dc4\u0dd2\u0dc5\u0dd4\u0dc0\u0dc2\u0dab\u0dc1\u0db1\u0dca. \u0d85 \u0dad\u0dba \u0db4\u0dca\u200d\u0dbb \u0da7 \u0dca\u0db1\u0dca\u0db1 \u0d91\u0db4\u0da7 \u0dbb\u0dd3\u0dbd\u0d9a\u0da7 \u0d85\u0dca [\u0dc1\u0da7\u0da0\u0da7\u0dbb\u0dca\u0dbd\u0db8\u0dd2[\u0da7\u0dad\u0dca \u0dc1\u0db1\u0dca\u0dbb\u0dd3\u0dbd\u0da7 \u0dbb\u0dd3\u0dda\u0dc1\u0dda \u0d92 \u0db1\u0dd2 \u0da7 \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0d87\u0dad\u0dd2\u0dc0.\n\n339 340\n\n\u0db4\u0da7\u0dbb\u0dca\u0d9a\u0ddc\u0dc1 \u0dc3\u0db1\u0dca\u0db8\u0dd2\u0dc0\n\n7]77 \u0dc0 \u0dc1\u0dbb\u0dca \u0db8\u0dd4\u0d9a\u0da7 \u0dc0\u0da9\u0da7 \u0d85\u0daf \u0dad\u0dd2\u0dc0\u0dc1\u0db3\u0db1 \u0dc1\u0dc0\u0db1 \u0dc1[\u0dca \u0dc2\u0dab\u0daf? \u0d85\u0daf \u0d91\u0daf\u0da7\u0da7 \u0dc0\u0da9\u0da7 \u0dca\u0dbb\u0dca\u0dae\u0dd2 \u0dbd \u0db4\u0dca\u200d\u0dbb \u0da7\u0dca\u0dc3\u0dbd \u0dc1\u0dc0\u0d9a\u0da7\u0daf? \u0db1\u0dd0\u0dc1\u0dd0, \u0dca\u0dbb\u0dca\u0dae\u0dd2 \u0dbd \u0dcf\u0dc1 \u0ddd\u0da0\u0db1\u0dbd \u0dc1\u0dc0\u0d9a\u0da7. \u0d91\u0daf\u0da7\u0da7 \u0dc0\u0da9\u0da7 \u0d85\u0daf \u0daf\u0dd4\u0dda\u0db4\u0dad\u0dca [ \u0d85\u0d9a\u0dca \u0dc1\u0dc0\u0d9a\u0da7\u0daf? \u0db1\u0dd0\u0dc1\u0dd0, \u0daf\u0dd4\u0dda\u0db4\u0dad\u0dca [ \u0dd2\u0db0 \u0da7\u0d9a \u0dc0 \u0dc1\u0dbd\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0d9a\u0da7. \u0d91\u0daf\u0da7\u0da7 \u0dc0\u0da9\u0da7 \u0d85\u0daf \u0dbb\u0dd0\u0dbb\u0dd3\u0dbd\u0da7 \u0d8b\u0dad\u0dca\u0db4\u0da7\u0daf\u0db1\u0dbd \u0dc1\u0dc0\u0d9a\u0da7\u0daf? \u0db1\u0dd0\u0dc1\u0dd0, \u0dbb\u0dd0\u0dbb\u0dd3\u0dbd\u0da7 \u0d9a\u0dc2\u0dab \u0dc3\u0db1\u0dc2\u0dab \u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0dc1\u0dc0\u0d9a\u0da7. \u0d91\u0daf\u0da7\u0da7 \u0dc0\u0da9\u0da7 \u0dc3\u0dbd \u0db3\u0dca \u0d85\u0d9a\u0dca \u0dc1\u0dc0\u0d9a\u0da7\u0daf? \u0db1\u0dd0\u0dc1\u0dd0, \u0dc3\u0dbd \u0db4\u0dca\u200d\u0dbb[\u0da7\u0dc3\u0dbd \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0d9a\u0da7. \u0dc1[\u0dca\u0db1\u0dc0\u0da7\u0daf \u0dcf\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dbd \u0dc1\u0dc0\u0d9a\u0da7 \u0dad\u0dd2\u0dc0\u0dc1\u0db3\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0d85\u0dc1\u0dda \u0dca\u0dc1\u0dca) \u0dba\u0d9c\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca\u0da7 \u0d85\u0daf \u0dd2\u0db0\u0daf\u0dd4\u0d9a\u0ddc \u0db6\u0dd2\u0d9a \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0d9a\u0da7, \u0dc0\u0db8\u0dd2\u0dca \u0db6\u0dd2\u0d9a \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0d9a\u0da7, \u0db3\u0daf\u0dd4 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0d9a\u0da7 \u0dc1\u0dd0[ \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0db1\u0dca[ \u0dc0\u0dd0\u0dd2\u0db1\u0d9a\u0da7 \u0d89\u0db1\u0dca\u0dc1\u0db1\u0dca. 7]77\u0daf\u0dd3 \u0dc0\u0dd0\u0dd4\u0db4\u0dc3\u0da7\u0da7 \u0db4 \u0dcf\u0dc1 \u0dda \u0dc0\u0dd0\u0dd4\u0db4\u0dab\u0dd4 \u0dad\u0dd0\u0db1\u0dd2\u0db1\u0dca \u0d8b\u0da9\u0da7 \u0dca\u0dc1\u0dda \u0dc0\u0dd4\u0daf \u0dbb\u0dd3\u0dbd\u0d9a\u0da7 \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc1\u0dd0. [\u0dc1\u0da2\u0db1\u0dad\u0da7\u0dc0 \u0db1 \u0dc3 \u0d8b\u0da9\u0da7 \u0dca\u0dc1\u0dda \u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0db3\u0dc0 \u0d85\u0db4\u0da7 \u0d89\u0dad\u0da7 \u0db4\u0dd0\u0dc1\u0dd0\u0daf\u0dd2\u0d9a\u0ddc\u0dba\u0dd2."
