    "chunk_text": "\u0db8\u0dd6\u0dbd\u0dcf\u0dc4\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0dca\u0daf\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0db8\u0dcf \u0dc5\u0d9f \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0dad\u0dd2\u0dc1\u0dbb\u0db1\u0dc0\u0dcf, 2000 \u0d89\u0db3\u0dbd\u0dcf 2020 \u0daf\u0dca\u0dc0\u0dc0\u0dcf \u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0d9c\u0d9a \u0db4\u0dd4\u0dda\u0d9c\u0dbd \u0d86\u0daf\u0dcf\u0dba\u0db8 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc1\u0dc0\u0da0\u0dca\u0daf \u0d86\u0d9a\u0dcf\u0dbb\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0dbb\u0db3\u0dc0; \u0dc1\u0dca\u0db6 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba \u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0db1\u0dba \u0dc1\u0dc0\u0da0\u0dca\u0daf \u0d86\u0d9a\u0dcf\u0dbb\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0dbb\u0db3\u0dc0. 2000\u0daf\u0dd3 \u0dc1 \u0ddc\u0dbd\u0dbb\u0dca 1,000\u0dca\u0dc0 \u0dc1\u0dbd\u0dc4 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba, 2020\u0daf\u0dd3 \u0dc1 \u0ddc\u0dbd\u0dbb\u0dca ,800\u0d9a\u0da7 \u0d9a\u0dd2\u0da7\u0dca\u0da7\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0dbb\u0db1\u0dc0\u0dcf. \u0db8\u0dd6\u0dbd\u0dcf\u0dc4\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0dca\u0daf\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2, \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dbb\u0dd4\u0dc0 \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dbb\u0dd0\u0dbd\u0dd4\u0dc1\u0dc0\u0ddc\u0dad\u0dca, 2000\u0daf\u0dd3 \u0dd2\u0db1\u0dba\u0dba\u0da7 14.5 \u0d89\u0db3\u0dbd\u0dcf 2020 \u0dc1\u0dc0\u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0d91\u0dba \u0dd2\u0db1\u0dba\u0dba\u0da7 8\u0da7 \u0d85\u0da9\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0dbb\u0db1\u0dc0\u0dcf. \u0d9c \u0d9a\u0dd2\u0dba\u0dca\u0daf\u0dc1\u0dca\u0daf, \u0dc1\u0dbd\u0ddd\u0d9a\u0dc1\u0dda \u0d85\u0db1\u0dd2\u0dca\u0dc0 \u0dbb\u0da7\u0dc0\u0dbd \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda\u0daf\u0dba\u0da7 \u0dc1\u0db1\u0ddc\u0dc1\u0dc0\u0dba\u0dd2, \u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0dca\u0daf\u0dc1\u0dca\u0daf. \u0dc1\u0db8\u0ddc\u0d9a\u0dca\u0dc0\u0daf, \u0d9c\u0d9a\u0da7 \u0dc1 \u0dda\u0dad\u0dd4\u0dc0? \u0d85\u0db4\u0dd2 \u0dcf\u0daf\u0dcf \u0dbb\u0dab\u0dba\u0dca\u0dc0 \u0dd0\u0da7\u0dd2\u0dba\u0da7 \u0dc4\u0dca\u0daf\u0dc4\u0dca\u0daf\u0daf\u0db1\u0dcf\u0dad\u0dca\u0db8\u0d9a\u0dc0 \u0dbb\u0dd0\u0dbd\u0dd4\u0dc1\u0dc0\u0ddc\u0dad\u0dca, \u0dc1 \u0dca\u0daf\u0db8\u0dcf\u0dbb\u0dca\u0d9a\u0dba \u0dc0\u0dcf\u0dc1\u0dda \u0dbb\u0da7\u0d9a \u0daf\u0dc5 \u0dc1\u0dda\u0dba \u0dba \u0db1\u0dd2\u0dab\u0dca\u0db4\u0dcf\u0daf\u0dd2\u0dad\u0dba\u0da7"
  },
