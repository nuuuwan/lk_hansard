u0d9a\u0dcf \u0dba\u0d9a\u0dca\u0dad \u0dd4\u0dad2 \u0db6\u0da7\u0da2\u0dda\u0db1\u0dca\u0dad, \u0d91\u0db8 \u0dc1\u0dad\u0dcf\u0dd9\u0dd4 \u0da0 \u0dc0 \u0db4\u0dc3\u0dd4 \u0dc1\u0db8\u0db8 \u200d\u0dbb \u0db8 \u0dba \u0dc0\u0dd3\u0d9a\u0dcf\u0dcf \u0dca\u0daf\u0dd2 \u0db8\u0dc1\u0d86\u0daf\u0dd3 \u0db4\u0dd2\u0db6\u0db3\u0dd4 \u0da0 \u0daf\u0dd2\u0dba \u0dcf\u0da7\u0d9a\" \u0d9a\u0dd2\u0dba \u0dcf.\n\n\u0dd4 \u0da0 \u0d9a \u0dcf \u0dcf\u0dba\u0d9a\u0dd4\u0db8\u0db1\u0dd2, \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad\u0da7 \u0dc0\u0dd3\u0db8\u0dd3\u0d9a\u0dca\u0dad\u0dc2\u0dab\u0dba\u0d9a\u0dca\u0dad \u0dc0\u0dd3\u0d9a\u0dcf\u0dcf \u0dc0\u0dd3\u0dcf\u0db0\u0dcf\u0dd9\u0dab \u0d9a\u0dcf \u0dba\u0d9a\u0dca\u0dad \u0d852 \u0dba\u0dba\u0dd2 \u0d9a\u0dd2\u0dba \u0dcf \u0d9a\u0dd2\u0dba 2\u0dcf. \u0dc1\u0d9a\u0dc1\u0dc0\u0dd3\u0db8 \u0dc0\u0dd42\u0dad\u0dca, \u0dd4 \u0da0 \u0db8 \u0db8\u0d9a\u0dca\u0dad\u0d9a\u0dcf\u0dbb\u0dca\u0dbd \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db8\u0dcf\u0dc1\u0d89 \u200d\u0dbb \u0db8 \u0dba \u0dca\u0dad\u0dcf 2\u0da7\u0dc0\u0dd4\u0dad\u0dca. \u0d91\u0dba, \u0d85\u0db4 \u0dc1\u0dda \u0dc0\u0dd3\u0dd2 \u0dc1\u0d86 2\u0da7\u0da9\u0dd2\u0dc1\u0dba\u0db1\u0dca\u0dad\u0db8 \u0d9a \u0dcf \u0d9a\u0dd9 \u0d9a\u0dcf\u0dc1 \u0ddd\u0da0\u0dd2\u0dad \u200d\u0dbb \u0db8 \u0dba\u0d9a\u0dca\u0dad. \u0dd4 \u0da0 \u0d9a \u0dcf \u0dcf\u0dba\u0d9a\u0dd4\u0db8\u0db1\u0dd2, \u0db8\u0dd4\u0dad\u0dca \u0dc12\u0dc1\u0dc5\u0d9a \u0dc1\u0db4\u0dcf\u0dc5 \u0dc1\u0dda VAT \u200d\u0dbb \u0db8 \u0dba \u0dc0\u0dd3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dc1\u0dba\u0db1\u0dca\u0dad \u0dad2\u0db8\u0dad\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd42 \u0dad\u0dd9\u0dda \u0d9a \u0db6 \u0dc12 \u0dcf \u0da7\u0dcf\u0da7. \u0db8\u0db8 \u0da7\u0dc1\u0d86 \u0db4\u0dcf \u0db8\u0dc1\u0dcf\u0ddd\u0d9c\u0dd2\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0db4\u0dd2\u0db6\u0db3\u0db6\u0d9a \u0d85\u0db0\u0dd2\u0d9a\u0dcf \u0db8\u0dc1\u0dba\u0db1\u0dca\u0dad \u0d9a\u0dca\u0dad\u0dc2\u0dd2\u0d9a\u0d9a2 2\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf2\u0d9a\u0dca\u0dad \u0dc1\u0dd4\u0db1\u0dca\u0dad2\u0dcf \u0dd4\u0dad\u0dca\u0dad\u0dcf.\n\n239 240\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd42\n\n\u0d92 2\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf2 \u0db8\u0db8 \u0d9a\u0dd2\u0dba2\u0db1\u0dca\u0dad \u0dda. \u0d92\u0d9a \u0dc1\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd42\u0da7 \u0dcf \u0db8 2\u0da7\u0dc0\u0dd4\u0dad\u0dca. \u0d92, \u0d91\u0d9a\u0dd4 \u0d9a\u0dc5 \u0d85\u0dd4\u0dba \u0db8\u0dad \u0db6\u0dda\u0dc0 - VAT - 2\u0da7\u0da9\u0dd2 \u0db8 \u0dc1\u0dcf\u0db8\u0dd4\u0dc12\u0db1\u0dca\u0dad \u0dcf\u0dcf\u0dab\u0dca\u0da9\u0da9 \u0db1\u0dca \u0dd4\u0dab\u0db1\u0dca\u0dad \u0db4\u0dd2\u0db6\u0db3\u0db6\u0d9a2 \u0d9a\u0dd9\u0dbb \u0d85\u0db0\u0dba\u0dba \u0dba\u0d9a\u0dca\u0dad. \u0d91\u0dba \u0d91\u0d9a\u0dca\u0dad \u0daf\u0dd2 \u0d9a\u0daf\u0dd3 \u0d9a\u0dd9\u0dbb \u0d85\u0db0\u0dba\u0dba \u0dba\u0d9a\u0dca\u0dad. \u0d92 \u0d85\u0db0\u0dba\u0dba \u0dba \u0d9a\u0dd9 \u0dd2 \u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad, 7074 \u0da2 2\u0dcf \u0db8 0 2 \u0dc0\u0dcf. \u0d92 2\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0dc1\u0dda \u0dc0\u0dd3\u0d9a\u0dcf\u0db1\u0dca\u0dad \u0dc12 2\u0dcf, \"\u0d91\u0d9a\u0dd4 \u0d9a\u0dc5 \u0d85\u0dd4\u0dba \u0db8\u0dad \u0db6\u0dd4\u0dc0 \u0dbb\u0dd2\u0dba\u0dba\u0da7 1] \u0dc0\u0d9a\u0dca\u0dad2\u0dcf 2\u0da7\u0da9\u0dd2 \u0db8 \u0db1\u0dd2\u0dc0\u0dd3\u0dcf 7073 2\u0dbb\u0dca\u0dbd\u0dc2\u0dba \u0d852\u0dc0\u0dd3\u0dcf \u0dc1\u0d86 \u0dc0\u0dd3\u0dcf 7074 2\u0dbb\u0dca\u0dbd\u0dc2\u0dba \u0d86\u0dd9\u0dda\u0dcf\u0dc1\u0d86 \u0d85\u0dad\u0dba2 \u0dba \u0dcf\u0dcf\u0dab\u0dca\u0da9\u0da9 \u0db1\u0dca \u0dd4\u0dab\u0db1\u0dca\u0dad \u0dc12 \u0dc0\u0dd3\u0db8 \u0db8 \u0dc1\u0d9a\u0dc1\u0dc0\u0dd3\u0db8\u0dc0 \u0dba\u0db1\u0dca\u0dad \u0db4\u0dd2\u0db6\u0db3\u0db6\u0d9a2 \u0dcf\u0dd4\u0db1 \u0dcf \u0dd4\u0da7\u0db1\u0dd3\u0db8 \u0dc0\u0dd3\u0d9a\u0dcf\u0dcf \u0db1\u0dca \u0dc0\u0dd3\u0db8\u0dd3\u0d9a\u0dca\u0dad\u0dc2\u0dab\u0dba\u0d9a\u0dca\u0dad \u0dbb\u0dd2\u0dd4\u0dc0 \u0d9a\u0dc5 \u0d85\u0dad\u0dd9, \u0d92 \u0dc0\u0dd3\u0d9a\u0dcf\u0dcf \u0d85\u0dcf\u0db9\u0dd4 \u0dc1 \u0dc0\u0dd3 \u0dc1\u0dad\u0ddd\u0dd9\u0dcf \u0dd4\u0dad\u0dca \u0dc1\u0d9a\u0dcf\u0dc5\u0db9 07 \u200d\u0dbb\u0dc1\u0dda \u0dc1\u0d86 \u0dbb\u0dd2\u0dbd\u0dcf \u0dd9 \u0dc12\u0dc5\u0d9a\u0dc0\u0dd3\u0da7\u0dbd\u0dcf, \u0dcf\u0dcf\u0da9\u0dca\u0dc12\u0dba\u0dcf\u0dbb\u0dca\u0dbd \u0dc12\u0dc5\u0d9a\u0dc0\u0dd3\u0da7\u0dbd\u0dcf, \u0dc1\u0db4\u0dcf\u0dad\u0dca\u0dc0\u0dd3\u0da7\u0dbd\u0dcf \u0dc0\u0dd3\u0dcf \u0db8\u0dc0\u0dd3\u0db8 \u0d85\u0dc1\u0dc5\u0da2\u0dda \u0d9a\u0dd9 \u0dc12\u0dc5\u0d9a\u0dc0\u0dd3\u0da7\u0dbd\u0dcf2\u0dd2\u0db1\u0dca\u0dad, \u0dc3\u0dd4\u0db4\u0dd2 \u0db8 \u0dc12\u0dc5\u0d9a\u0dc0\u0dd3\u0da7\u0dbd\u0dcf2\u0dd2\u0db1\u0dca\u0dad \u0db1\u0dca \u0db6\u0dcf \u0dd4\u0db1\u0dca\u0dad \u0dcf \u0daf\u0dd3. \u0d91\u0db8 \u0dc1\u0dad\u0dcf\u0dd9\u0dd4 \u0da0 \u0dc0\u0dd3\u0dcf\u0dd9\u0dcf\u0d82 \u0dd4\u0dad \u0d9a\u0dd9 \u0d85\u0dc0\u0dcf\u0dc5 \u0db1\u0dd2\u0dd3\u0dad\u0d9a\u0dca\u0dad\u0dc2\u0dab \u0dc0\u0dd3\u0db8 \u0db4\u0dcf\u0dad \u0db4 \u0db8\u0daf\u0dd2 \u0dca\u0daf\u0dd2 \u0db8\u0db4\u0dad\u0dca \u0d9a\u0dd9 \u0dad\u0dad\" \u0d9a\u0dd2\u0dba \u0dcf."
