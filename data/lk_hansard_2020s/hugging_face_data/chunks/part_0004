u0d91[ \u0dc1 \u0dca\u0da9\u0db1\u0dd0\u0d9f\u0dd2\u0db8\u0dc1\u0db8 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d92 \u0db4\u0dc0\u0dd4\u0d9a \u0dc1\u0dda\u0dca\u0da7 \u0dad\u0dca\u0dc1\u0dad\u0dca \u0db4\u0dc1\u0dc5 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dc3\u0dd2\u0dcf\u0dc1\u0d9a \u0dba\u0d9c\u0db1\u0dd2 \u0dcf\u0dc3\u0dd4. \u0d92 \u0d9c\u0dd2\u0db1\u0dca\u0db1 \u0d87\u0dad\u0dd2\u0dc0 \u0dc0\u0dd4\u0dab\u0dd4 \u0dc1\u0dc0\u0d9a\u0da7\u0dc1\u0dda \u0d91[ \u0dc1 \u0dca\u0da9\u0db1\u0dd0\u0d9f\u0dd2\u0db8\u0dc1\u0db8 \u0d8b\u0da9 \u0dc3\u0dd2\u0da7 \u0db4\u0dc1\u0dc5\u0da7 \u0db4\u0dd0\u0db1\u0db4\u0dd4 \u0daf\u0dbb\u0dd4\u0dc0\u0da7 \u0dc1\u0dda\u0dca\u0da7 \u0dad\u0dca\u0dc1\u0dad\u0dca \u0db4\u0dc1\u0dc5 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dc3\u0dd2\u0dcf\u0dc1\u0d9a \u0dba\u0d9c\u0db1\u0dd2 \u0dcf\u0dc3\u0dd4. \u0d92 \u0d85\u0dbd \u0dad[\u0dba\u0dd2 \u0db4\u0dc1\u0dc5 \u0d89 \u0d9a\u0da7 \u0dc1\u0dca\u0dd3\u0daf\u0dc2\u0dab \u0d85\u0db8\u0d9a\u0da7 \u0d92 \u0daf\u0dbb\u0dd4\u0dc0\u0da7\u0dc1\u0d9a \u0dc3\u0dca\u0dd2\u0db0\u0dad\u0dbd \u0dbb\u0dd0 \u0dad\u0dca\u0dc1\u0dad\u0dca. \u0d92 \u0dc1\u0dc0\u0d9a\u0da7\u0dc1\u0dda\u0dad\u0dca \u0d94\u0dbd \u0dbb\u0dd3\u0dbd\u0db1 \u0dd2\u0db0\u0db0\u0dd2\u0dc1\u0dda \u0da2\u0da7\u0dad\u0dd2\u0dc0 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0db1 \u0dad\u0dd2\u0dc0\u0db6\u0dd4\u0dc3\u0da7 \u0db1 \u0dc3 \u0dc1[\u0dca \u0daf \u0dc1\u0dc0\u0db1\u0dca\u0dc1\u0db1\u0dca? \u0d92 \u0dc0\u0da7\u0dc1\u0d9a \u0d8b\u0daf\u0da7\u0dc1\u0dca\u0dc3 \u0dc3\u0db1\u0da7\u0dc0\u0dc2\u0dab [\u0da7 \u0dbb\u0dd3\u0dbd\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0da9\u0dd3.\u0d91 \u0dcf. \u0dc1 \u0dda\u0db1\u0da7\u0db1\u0da7\u0dbd \u0dd2\u0db0\u0daf\u0dba\u0da7\u0d9a\u0dc1\u0dda \u0d89\u0dc1 \u0db1\u0dd4[ \u0d9a\u0dd0\u0db6\u0dd6 \u0da7\u0d9a\u0dc1\u0dda \u0d85\u0db4 [ \u0dc0\u0dd0\u0da9\u0dd2\u0db4\u0dd4\u0dca \u0dc4\u0dd2\u0dd2\u0db1\u0dc1\u0dda \u0daf\u0dba\u0d9c\u0dc5 \u0dc1\u0dc1\u0ddd\u0daf\u0dca\u0dc0\u0dbb\u0dd4\u0db1\u0dca. \u0dd2\u0db0 \u0dcf\u0dc0\u0dd2\u0db0\u0daf\u0dba\u0da7\u0d9a\u0dc1\u0dda\u0dad\u0dca \u0d85\u0db4 [ \u0dc3\u0dd2\u0dd2\u0db1\u0dc1\u0dda \u0daf\u0dba\u0d9c\u0dc5 \u0dc1\u0dc1\u0ddd\u0daf\u0dca\u0dc0\u0dbb\u0dd4\u0db1\u0dca. \u0d92 \u0da7\u0d9a\u0dc1\u0dda\u0dad\u0dca \u0dbd \u0dc3 \u0dbd \u0dc3 \u0dc4\u0dd4\u0dc1\u0daf \u0d9a\u0da7 \u0dc3\u0dd2\u0daf\u0dd4\u0dd3\u0db8 \u0dc3 \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0d87\u0dad\u0dd2\u0dc0. \u0db8\u0dd6\u0d9a\u0da7 \u0db1\u0da7\u0dbb\u0dd6\u0daa \u0dbb\u0dd4 [\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0db8\u0dd2[\u0db1\u0dd2, \u0dc1\u0dd0\u0db3\u0dd0\u0dba\u0dd2 \u0dc1[\u0dc1\u0dc1[ \u0da2\u0da7\u0dad\u0dd2\u0dc0 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0db1 \u0dd0\u0db1 \u0dc0\u0da7 \u0dca\u0db1\u0dca\u0db1 \u0d9c\u0dd2\u0dc1\u0dbd\u0dca\u0dad\u0dca, \u0d85\u0db4\u0da7 \u0d91\u0dc5\u0da7\u0dca-\u0daf\u0dd4\u0dd4\u0db4 \u0dd0\u0db8\u0dd4\u0dab\u0dd4 \u0dd4\u0dad\u0dd3\u0db0\u0dbd \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2\u0dc0 \u0da7\u0d9a\u0dbd\u0da7\u0dad\u0dca \u0dbd\u0db1\u0dca\u0db1 \u0dc1\u0dc0\u0db1\u0dc0\u0da7. \u0d92 \u0db1\u0dd2 \u0da7 [[ \u0d89\u0dad\u0da7[ \u0dc1 \u0dde\u0dca\u0dc0\u0dc1\u0dbd\u0db1\u0dca \u0d89\u0db8\u0d9a\u0da7 \u0dc3\u0dd2\u0dd2\u0db1\u0db1\u0dc0\u0da7, \u0dad\u0dc0\u0daf\u0dd4\u0dca\u0da7\u0dad\u0dca \u0dc1 \u0dc3 \u0da2\u0da7\u0dad\u0dd2\u0dc0 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0db1, \u0dc0\u0dbb\u0dca \u0dc0\u0da7\u0daf\u0dd3 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0db1 \u0dd0\u0db1 \u0dc0\u0da7 \u0dca\u0db1\u0dca\u0db1 \u0d91\u0db4\u0da7 \u0dbb\u0dd3\u0dbd\u0d9a\u0da7.\n\n\u0db8\u0dd6\u0d9a\u0da7 \u0db1\u0da7\u0dbb\u0dd6\u0daa \u0dbb\u0dd4 [\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0db8\u0dd2[\u0db1\u0dd2, \u0d94\u0db3\u0db8\u0dd2[\u0da7 \u0d85\u0dc1\u0dda \u0dad\u0dbb\u0dd4\u0dc3 \u0dcf \u0daf\u0dc1\u0dda \u0db7\u0da7\u0db4\u0dad\u0dd2\u0dc0\u0dc0\u0dca\u0dbd\u0da7 \u0dc1\u0dd0\u0dd2\u0db1\u0dbd\u0da7\u0dad\u0dca, [[ \u0dc1\u0db8 \u0dc3\u0dc0\u0dca\u0dbd\u0da7 \u0dc1\u0dd0\u0dd2\u0db1\u0dbd\u0da7\u0dad\u0dca \u0da7\u0dd4\u0dad\u0db8\u0dd2 \u0dca\u0db1\u0dc0\u0da7. \u0dc1 \u0dc3 \u0dca\u0dc1\u0dca) \u0dca\u0dbb\u0dca\u0dae\u0dd2 \u0dbd \u0dc2\u0dab\u0dad\u0dd2\u0dc0[\u0dad\u0dca \u0dc0\u0dd4\u0dc3\u0da7\u0da7 \u0db4\u0dc3\u0dd4\u0dc0 \u0d85\u0db4\n\n\u0dc1\u0dbd\u0ddd\u0da2\u0db1\u0da7 \u0dca \u0dad\u0dd2\u0dc0\u0dc1\u0db3\u0db1 \u0dca \u0da7\u0dca\u0dbd\u0da7 \u0dc1 \u0dc3 \u0dca\u0da7 \u0db4\u0dd4\u0dca\u0da7 exressways \u0dd2\u0db1 \u0dc1\u0daf\u0db1\u0dca\u0db1 \u0d85\u0db4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca [\u0dc2\u0dab \u0d9a\u0dd0\u0db6\u0dd4\u0dc1\u0dc3\u0dca\u0dad\u0dca, \u0d94\u0dbd \u0dbb\u0dd3\u0dbd\u0db1 \u0da2\u0da7\u0dad\u0dd2\u0dc0 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0db1\u0dbd \u0d85\u0dc0 \u0db1\u0dca \u0dc1\u0dc0\u0db1\u0dc0\u0da7. \u0d91\u0dad\u0dc1 \u0dca\u0da7 \u0d85\u0db4\u0da7 \u0d91\u0dc1\u0da7\u0da7 \u0dbd\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d91\u0dc1\u0dc1\u0dda \u0dc3\u0dd2\u0dd2\u0db1\u0db1 \u0d85\u0dbd\u0da7 \u0dc1[\u0dc1\u0da7\u0da7 \u0d91\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d85\u0db4\u0dd2 \u0d94\u0dc2\u0dab\u0dc1 \u0ddd\u0da7[ \u0d92 \u0dca \u0da7\u0dca\u0dbd\u0da7 \u0d91\u0dc2\u0dab \u0da7\u0dc3\u0dd4 \u0dc1\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0db1 \u0dc3, \u0d94\u0dbd \u0dbb\u0dd3\u0dbd\u0db1 \u0da2\u0da7\u0dad\u0dd2\u0dc0 \u0db4\u0dca\u200d\u0dbb \u0dcf\u0db1\u0dbd \u0d85\u0dc0 \u0db1\u0dca \u0dca\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca."
