\u0dc12\u0db1\u0dd42\u0da7, '\u0dba2\u0dcf \u0dad\u0dd2 \u0db62\u0da7 \u0dc0\u0dd3\u0dcf 35 2 2\u0dd4\u0db1\u0dca\u0dad\u0dd2 \u0dba \u200d\u0dbb\u0d9a\u0dcf\u0dd92 \u0dc1\u0dd9\u0dd2\u0d9a\u0dc0\u0dd3\u0db8\u0da7\u0dca\u200d\u0dbb\u0dcf\u0dbb\u0dca\u0dbd \u0da2 \u0dd9\u0dcf\u0dbd\u0dcf2\u0dd9\u0dba\u0dcf \u0da2\u0dda\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0dba\u0dda \u0db8\u0dd4\u0dc0 \u0d9a\u0dca\u0dad \u0db4 2\u0dcf \u0dad\u0dad\u0dca\u0dc1\u0dad\u0dca \u0dda, \u0d91\u0d9a\u0dd3 \u0db8\u0dd4\u0dc0 \u0dc1\u0dd42\u0dcf \u0dad\u0dd2 \u0db62\u0da7 \u0dc0 \u0daf\u0dd2\u0dc0\u0dd4 \u0da0\u0dda \u200d\u0dbb\u0d9a\u0dcf \u0dba\u0d9a\u0dca\u0dad \u0d91\u0db8 \u0dca\u0dbd\u0dcf\u0dd4 \u0dda \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0da7 \u0dad\u0db1\u0dca\u0dd2\u0d9a\u0dba \u0dba\u0dd4\u0dd4 \u0dba.' \"\n\n\u0dc3\u0d82\u0dc0\u0dc1 \u0db0\u0db1\u0dba \u0dd2\u0dc5\u0dd2\u0dad\u0d9c\u0dad \u0dad\u0dd4\u0dad\u0dd4\u0db8\u0dba \u0dba\u0db1 \u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba \u0dd2\u0dbb\u0db8\u0dcf\u0dad\u0dc3\u0db1 \u0dbd\u0daf\u0dd2\u0db1\u0dca, \u0dc3\u0db7\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dcf\u0dad\u0dad \u0dd2\u0dbb\u0dba.\n\n\u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. Amendment put, and agreed to.\n\n2 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dd2\u0dbb\u0dba, \u0dc3\u0d82\u0dc0\u0dc1 \u0db0\u0dd2\u0dad\u0dcf\u0d9a\u0dcf\u0dbb\u0dc0\u0dba\u0db1\u0dca, \u0db4\u0db1\u0dca \u0dc0\u0d9a\u0dd4\u0db8\u0db8\u0dca\u0db4\u0dc0\u0dad\u0dc4\u0dd2 \u0dc0\u0d9a\u0dcf \u0dc3\u0d9a\u0dca \u0dcf\u0dd0\u0da7\u0dd2\u0dba \u0dd2\u0dbb\u0db6\u0dd2\u0dba \u0dad\u0dd4\u0dad\u0dd4\u0db8 \u0dba\u0dba\u0dd2 \u0db1\u0dd2\u0dc0\u0dba \u0d9c \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3.\n\n2\u0b86\u0bae\u0bcd \u0bb5\u0bbe\u0b9a\u0b95\u0bae\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0b