    "chunk_text": "\u0db8\u0dd3\u0da7 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4 \u0dc1\u0dca\u0dcf \u0dad\u0dd4 \u0dcf\u0da7 \u0dcf\u0dd2\u0db0 \u0dad\u0db1\u0dd2 \u0dc3\u0dd2\u0d82\u0d9c \u0dc3\u0db4\u0dd6\u0dbb\u0dd4\u0dc1 Changi Airport \u0d91\u0dcf \u0dba\u0d86 \u0da7 \u0d85\u0dd2 \u0dad\u0dd2 \u0dc0\u0dd4\u0dc1\u0dab\u0dca\u0da9. \u0dca\u0dd4\u0db0 \u0db1 \u0dbb\u0dab\u0dbb\u0dca\u0dbd \u0dc1\u0db1\u0db8\u0dc1 \u0db8\u0db1\u0dc4\u0dd2 \u0dca\u200d\u0db8\u0dc0 \u0dbd\u0dd3\u0db8 \u0d9a\u0dca\u0dc2\u0dc0\u0db8\u0db0 \u0dba\u0dd6 \u0dca\u200d\u0db8\u0dc0 \u0d91\u0dcf\u0da7 \u0dad\u0dd2 \u0dca\u200d\u0db8 \u0dc1\u0dda\u0db0 \u0dcf\u0dae\u0db8 \u0dcf\u0dba\u0db4\u0dd4 \u0dcf\u0dc3\u0d9a \u0d85\u0db0\u0dad\u0dd2\u0db1\u0da7 \u0dcf\u0dc1\u0dc5\u0dda \u0dba \u0d85\u0dba\u0dc1\u0d9c \u0dba \u0d85\u0dba\u0dc1\u0d9c \u0dc4 \u0dc3\u0dd2\u0dad\u0dca \u0d85\u0dca\u0dd4 \u0d9c \u0dca\u200d\u0db8 \u0dcf\u0db8\u0da7\u0dc0\u0dad\u0dca \u0d87\u0dc4\u0dd4\u0db8\u0dca\u0dcf\u0db0 \u0dc1\u0dca\u0db0\u0dc1\u0db0 \u0dd4\u0dad\u0dd4\u0dc0 \u0dad\u0dcf\u0dbb\u0dab\u0dbb\u0dd4 \u0dd2\u0dbb\u0db0\u0dd2 \u0da7 \u0dc0\u0dd4\u0da9 \u0dcf\u0dba\u0dca\u200d\u0db8 \u0dba\u0da7 \u0dca\u0d82\u0dc1\u0dcf\u0db8\u0dc1\u0dca\u200d\u0db8\u0dad\u0dca \u0dcf\u0dba\u0db4\u0dd4 \u0d91\u0dcf. \u0d91\u0db1 \u0dd2\u0dba\u0dc4\u0db8 \u0dcf\u0dc0\u0dd4\u0dbb\u0dd4 \u0dd2\u0dba \u0d9a\u0dd2 \u0dc0\u0db8 \u0db8\u0dca \u0dc1\u0db8\u0dca\u0dcf \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4 75\u0dcf \u0db8\u0db4 \u0d9a\u0dd2 \u0dca\u200d\u0db8 \u0d92\u0dcf \u0db4\u0dc3\u0da7\u0db4 \u0dc3 \u0dc1\u0dca\u0db8\u0dbb\u0dd4\u0dc0\u0d9a\u0dca\u0dc2.\n\n\u0d92 \u0dc0\u0db8\u0dc1\u0dda\u0db1 \u0d86 \u0dad\u0db8 \u0dd2\u0dbb\u0daf\u0dbd\u0d9a\u0dca\u0dc2\u0dad\u0dd2 \u0dc1\u0db4\u0dba\u0daf\u0dbd\u0dc1\u0dab\u0dca\u0da9 \u0db8 \u0dcf\u0dc1 \u0ddd \u0d89\u0db0 \u0dc0 \u0db8\u0dc0\u0da7 \u0dd2\u0dab \u0d91\u0dcf \u0d9c\u0dd4 \u0dad\u0dca \u0d85\u0db4\u0dd2 \u0dc4\u0dda\u0dad\u0dd4\u0dad\u0dd2\u0dc0\u0db0\u0dad \u0dc1\u0dc0 \u0dc0\u0db8. \u0d85\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4 22 23 \u0dca\u0dbb\u0dd4\u0dc0\u0db0\u0da7 \u0dc1\u0dad\u0dca\u0dc1\u0dba\u0db0\u0dc1\u0db0 \u0dd4 \u0dd4 \u0d94\u0dc0\u0dd4\u0db0 \u0d89\u0db4\u0dc1\u0dca \u0dc1\u0dcf\u0db8\u0da7\u0db1 \u0d94\u0dc0\u0dd4\u0db0\u0dc1\u0dda \u0d85 \u0db8\u0d9c\u0dad \u0dc0\u0dd4\u0da9\u0dc0\u0dbb\u0dca\u0dbd\u0d86 \u0dc0\u0dd2\u0db0 \u0d8b\u0daf\u0dca\u0dc1\u0d9d\u0ddd\u0dc2\u0dca\u0da8\u0dba\u0dc0\u0dd2\u0db0 \u0dd2\u0dbb \u0db8 \u0dcf\u0dc1\u0dc5\u0dda \u0dc1\u0db8\u0dca \u0dcf\u0dab\u0dca\u0da9\u0da9\u0db8 \u0db1 \u0dca\u0dc0. \u0dc1\u0db8\u0dca \u0dba\u0db8\u0d86\u0dba \u0d9a \u0dad \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc0\u0dba\u0dd4 \u0d9c\u0dad \u0dcf\u0dba\u0db0 \u0dd1 \u0dc1\u0db1\u0dc1 \u0db1 \u0dcf\u0dba\u0db0 \u0dd1 \u0d85\u0dba\u0dc1 \u0db1 \u0dcf\u0dba\u0db0 \u0dd1 \u0d9a\u0dd2 \u0dca\u200d\u0db8 \u0d85\u0dca \u0dc1\u0db4\u0db8\u0dc1 \u0db8\u0dc3\u0da7\u0dd4\u0dc1 \u0dcf\u0dc3\u0d9a \u0dcf \u0d9c\u0dd4\u0dc4\u0dd4\u0dc0\u0db8\u0da7 2001 \u0dd3 \u0d91\u0d9a\u0dca\u0dc2\u0dc4\u0dad\u0dca \u0d86\u0db8\u0dad\u0dd2\u0dcf \u0db4\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8 \u0d9a\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc1\u0dcf\u0ddd\u0d9a 45 000\u0d9a\u0dca\u0dc2 \u0dc1 \u0db8\u0dca\u0dc0\u0dca\u200d\u0db8 \u0dcaRegaining Sri Lanka\" \u0dc0\u0dd4\u0da9\u0dc4\u0da7 \u0dcf\u0dba\u0dca\u200d\u0db8 \u0db4\u0db8\u0dd4 \u0dca\u200d\u0dca \u0dba\u0db8\u0d86\u0dba \u0d9a \u0dad \u0dba\u0db8\u0d86\u0dba-\u0dc1\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dd2\u0dcf \u0d9a\u0dc1 \u0ddd\u0d86 \u0dc0\u0dd2\u0db0 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc0\u0dba\u0dd4 \u0d9c\u0dad \u0dcf\u0dba\u0db0 \u0dca \u0dc1\u0dcf\u0db8\u0da7 \u0db1 \u0db4\u0db8\u0dba\u0da7 \u0db4\u0dd4\u0db0\u0dc1\u0db0 \u0dc1\u0db8\u0dca \u0dc1\u0d9c\u0db8 \u0dc3\u0dc1\u0dca\u200d\u0ddd \u0dad\u0db1\u0dd2 . \u0d92\u0dcf \u0dd2\u0dbb \u0db8 \u0dcf\u0dc1\u0dc5\u0dda \u0dc1\u0db8\u0dca \u0dc1\u0d9c\u0db8 \u0dc3\u0dc1\u0dca\u200d\u0ddd \u0dad\u0db1\u0dd2 . \u0d91\u0dca\u0db8 \u0d92\u0dc0\u0db8 \u0dcf\u0dc5\u0db8 \u0db8\u0dca \u0d85\u0dca \u0dc1\u0db8\u0dca \u0dd2\u0dbb\u0db4\u0db8\u0dcf \u0dd4 \u0dd4.\n\n\u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1 \u0ddd\u0d86\u0dba \u0dcf\u0dae\u0db8 \u0db8 \u0dcf\u0dad\u0dd4\u0db1\u0dd2\u0dba \u0dca\u0dd4\u0db0 \u0db1\u0db1 \u0d94\u0dca\u0dad\u0dd4\u0db1\u0db8\u0da7 \u0d8b\u0dca\u0db8 \u0dba\u0dba \u0d9a\u0dca\u0dc2 \u0dc1\u0dca\u0db0 \u0db8\u0dca. \u0d85\u0db4\u0dd2 \u0dc1\u0dad \u0dc3 \u0d9c \u0dc1\u0dcf\u0db8\u0da7 IOC \u0d91\u0dc1\u0dcf\u0db0 \u0d9c\u0dd4\u0dc4\u0dd4\u0dc0\u0dad\u0dca \u0d92 \u0dc0\u0db8\u0dc1\u0dda\u0db1 \u0dc3\u0dd2\u0dc1\u0db4\u0dc3\u0dc1\u0dcf\u0ddd \u0d91\u0dc1\u0dcf\u0db0 \u0d9c\u0dd4\u0dc4\u0dd4\u0dc0\u0dad\u0dca \u0d91\u0dcf\u0db1 \u0d9c\u0dba \u0db0\u0dc1\u0db0. \u0dba \u0da7 \u0dc1\u0dad \u0dc3 \u0d9c \u0db0\u0dc1 \u0dad\u0dca \u0dd4 \u0dd4, cash \u0dd3 \u0dca\u200d\u0db8 \u0d9c \u0db0\u0dc1\u0db0. \u0dd4\u0dca\u0dd4\u0dd2 \u0dc3\u0dd2\u0dc1\u0db4\u0dc3\u0dc1\u0dcf\u0ddd \u0d91\u0dcf \u0db6\u0dd2\u0dd2 \u0d9c\u0dba\u0db0 \u0db4\u0db8\u0dd4\u0dd2 IOC \u0d91\u0dcf \u0db6\u0dd2\u0dd2\n\n\u0d9c\u0dba\u0db0 \u0dca\u200d\u0db8\u0dcf \u0dca\u200d\u0dca \u0dc0\u0db8. \u0dc1\u0db1\u0db0 \u0dc1\u0db8\u0dca \u0dca\u200d\u0dbb \u0dda \u0d91\u0dca\u0db8 \u0d85\u0db4\u0dd2 address \u0dcf\u0dba \u0dc1\u0dcf\u0db8\u0da7 \u0dad\u0db1\u0dd2 \u0d85\u0db4\u0da7 \u0d9a\u0dd2 \u0dc1 \u0dca\u0d85\u0db0 \u0dba\u0da7\u0da7 \u0d86\u0db8\u0dad\u0dd2 \u0da7 \u0d9a\u0d9c\u0db1\u0da7 \u0dd2\u0dbb\u0dbb\u0dd4\u0daf\u0dca \u0d91\u0dc0\u0dd4\u0db0. \u0dc1\u0db8\u0dca\u0dcf \u0d85\u0dc1 \u0dc3 \u0dba\u0da7 \u0d85\u0db4\u0da7 \u0dd1 \u0dd2\u0dbb\u0db0\u0dd2 \u0da7 \u0dad\u0db1\u0dd2 \u0dcf\u0dba\u0db0\u0dc1\u0db0\u0dca \u0d9a\u0dd2 \u0dca\u200d\u0db8. \u0dc1\u0dda \u0d87\u0dad\u0dd4\u0dc5\u0da7 \u0dc1\u0dc0\u0dca\u200d\u0db8 \u0dd1 \u0db1 \u0dc1\u0dcf\u0dc1 \u0d9a\u0dd4\u0da7 \u0da0\u0dab\u0dca\u0da9\u0da9\u0dd2 \u0db4\u0db8\u0dc3 \u0dca\u0db1\u0db0 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db0. \u0d91\u0dd2\u0db6 \u0da7 \u0dd2\u0dab \u0db8\u0da7 \u0db4\u0dc4\u0dda\u0dc1\u0dc4\u0dda \u0dad\u0db1\u0dd2 \u0d9c\u0dd4\u0d9a \u0dcf\u0db0\u0dc1\u0db0. \u0d92 \u0dc0\u0dc1\u0dda \u0dc1\u0dca \u0d9a\u0dca\u0dc2 \u0dad\u0db1\u0dd2 \u0d85\u0dca \u0d85\u0dc1 \u0dc3 \u0dba\u0da7\u0da7 \u0dc1\u0dc0\u0dca\u200d\u0db8 \u0dad\u0dd2\u0dc1\u0dca\u0db0\u0dc1\u0db0. \u0d91\u0db1 \u0dd2\u0dba\u0dc4\u0db8 \u0dc1\u0db8\u0dca \u0dae\u0db8\u0dbb\u0dca\u0dbd\u0dae \u0dc1\u0dad\u0dca\u0dbb\u0dd4\u0db8\u0dca \u0d9c\u0db0 . \u0d86 \u0dad\u0db8\u0dc0 \u0d85\u0db0\u0dca\u0db0 \u0d91\u0db4\u0db8.\n\n\u0dca\u0dd4\u0db0 \u0dc1\u0dc0\u0dca\u200d\u0db8 \u0dad\u0dd2\u0dc1\u0dca\u0db0\u0dc1\u0db0 \u0dc1\u0db1\u0db8\u0dcf\u0d9a\u0dca\u0dc2\u0dca? \u0dca\u0dd4 \u0dca\u0dd2\u0dba\u0db0 \u0dca\u0dd4 \u0db8\u0dd2\u0dc1\u0dca\u200d\u0db0 \u0db8\u0dd2\u0dd2\u0dba\u0dcf\u0dca\u200d\u0db8 \u0db6\u0dd2 \u0dc3\u0dc0\u0dd2\u0db0 \u0db8\u0dd2\u0dd2\u0dba\u0dcf\u0dca\u200d\u0db8 \u0dc1\u0db8\u0dca \u0d9a\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0d86 \u0dad\u0db8\u0dc0\u0dc1\u0dda \u0dbb\u0dd3\u0dd2\u0dba \u0db1\u0db8\u0d82\u0dc4 \u0d8b\u0dba\u0db8 \u0dc1\u0dca\u0db8\u0db0\u0dc1\u0db0 \u0dc1\u0db1\u0db8\u0dc0\u0dd4\u0db0\u0da7 \u0d9a\u0dd2\u0dc3\u0dd2\u0dd4 \u0dc0\u0dd4\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dc0\u0dc5\u0d9a\u0dca\u0dc2 \u0dd4\u0dad\u0dd2 \u0dd2\u0dba\u0dc4\u0db8\u0dd2 . \u0d92 \u0dd2\u0dba\u0dc4\u0db8 \u0dca\u0dd4 \u0d9a\u0dca\u0db8 \u0db1 \u0dd2\u0dbb\u0dad\u0dba\u0dd2 \u0d94\u0dc0\u0dd4\u0db0 \u0dba\u0db8\u0d86\u0dba \u0d9a\u0dca\u0db8 \u0db1 \u0dca\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0dcf\u0dba\u0dc1\u0d9c \u0dad\u0dd2\u0dc1\u0dca\u0db0\u0dc1\u0db0."
  },
