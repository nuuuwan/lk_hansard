    "chunk_text": "\u0dc0\u0daf\u0dc1\u0d9a\u0db8 \u0dc1\u0db4\u0db6\u0dbb\u0dc0\u0daf\u0dbb\u0dd2 \u0db8\u0daf\u0dc3\u0dcf\u0dc1\u0d86 15\u0dc0\u0dd0\u0db1\u0dd2 :\u0daf \u0db8\u0db1\u0da2 \u0da9\u0db4\u0dc1\u0dbd\u0ddd\u0d9c\u0dd2\u0dad\u0daf \u0dc1\u0dca\u0ddc\u0dba\u0d9c\u0dc3\u0dcf\u0db8 \u0db8\u0db1\u0da2 \u0d85:\u0db1\u0dc3\u0dcf\u0dae \u0dbd\u0db6\u0daf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dca\u0dd0 \u0dc0\u0dd6\u0dc0\u0daf. \u0d91\u0dad\u0dd0 \u0daf\u0dd3\u0dad\u0dca \u0d85\u0db4\u0dd2 :\u0dd0\u0d9a\u0dca\u0dca\u0daf \u0db4\u0dca\u200d\u0dbb\u0daf\u0dc1\u0dbd\u0ddd\u0d9c\u0dd2\u0dca\u0dc0 \u0dc0\u0dd2\u0dc0\u0dd2\u0db0\u0dca\u200d \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dcf\u0dae \u0dc1\u0dbd\u0ddd\u0da2 \u0daf \u0dbd\u0db6\u0daf \u0dc0\u0db1\u0dca \u0db6\u0dc0. \u0da2 \u0dca \u0dbb\u0dad\u0dca \u0daf\u0dbd\u0dca\u0dc1\u0d9a \u0d85\u0dad\u0dc1\u0dca\u0ddc\u0dc5\u0dd4 \u0dc1\u0dc0\u0dbd\u0daf \u0d89\u0dca \u0dc1\u0dd3 \u0db4\u0daf\u0dbd \u0dc0 \u0dc1\u0dbd\u0dca \u0dca\u0dcf\u0daf \u0dca\u0dbb\u0db4\u0dd4 \u0dbd\u0dad\u0dd4\u0d9a\u0dd2\u0dc3\u0dd2 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dcf\u0d9a\u0dd4\u0dad\u0dca \u0dd2\u0dad\u0dad\u0dbd\u0dbd\u0daf. \u0db8\u0dd4\u0dad\u0dca \u0dc1\u0dd3 \u0db4\u0daf\u0dbd \u0d85\u0db0\u0dd2\u0dca\u0daf\u0dbb\u0dd2\u0dbd \u0dad\u0db8\u0dd2\u0dc5\u0dd4 \u0d91\u0dad\u0dd0 \u0dd2\u0dad\u0da7\u0db4\u0dd4 \u0db6\u0dc4\u0dd4\u0dad\u0dbb \u0dc1: \u0daf \u0db4\u0dca\u200d\u0dbb\u0daf\u0dc1\u0dbd\u0ddd\u0d9c\u0dd2\u0dca\u0dc0 \u0dad\u0dc0\u0dad\u0dca \u0d85\u0da9\u0dd4 \u0dca\u0dcf \u0db1\u0dd0\u0d9a\u0dd2 \u0dad\u0dd0\u0dca \u0db4\u0dd2\u0dd2\u0db6\u0db6 \u0dc0 \u0d85\u0db4\u0da7 \u0dc1\u0dbd\u0ddd\u0da2 \u0daf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dca\u0dcf\u0daf.\n\n\u0d85: \u0d85\u0dc1\u0dda . .\u0dc0\u0dd3. \u0da0\u0daf \u0dca \u0dbb\u0daf\u0da2\u0dba \u0dad\u0db8\u0dad\u0dd2\u0db8\u0dd2\u0db8\u0daf\u0dad\u0dca \u0dc0\u0dd2\u0dc0\u0db1\u0dbd\u0dd2\u0db6\u0dbd \u0db1\u0daf \u0db6\u0dbd \u0d9a\u0dca\u0dad\u0dd2 \u0dbb\u0daf\u0da2\u0dba \u0d85\u0db8\u0daf\u0dad\u0dba \u0d89\u0dca \u0daf\u0dd2\u0dca \u0d85\u0dbb\u0dcf\u0dbb\u0dd4\u0dd3\u0db0\u0dca\u200d \u0dc1\u0db1\u0dda\u0dbb\u0dad\u0dca \u0db8\u0dd0\u0dad\u0dd2\u0db8\u0dd2\u0db8\u0daf\u0dad\u0dca \u0db8\u0db8\u0dad\u0dca :\u0dd0\u0dca \u0dc3\u0dcf\u0daf\u0dca\u0da0\u0dca\u0da1\u0daf\u0dc1\u0dc0\u0dca \u0db4\u0d9a\u0db8\u0dc0 \u0dad\u0db8\u0dba\u0dd2 \u0dc1\u0dad\u0dd4 \u0db4\u0daf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dad\u0dd4\u0dca \u0db8\u0dd2\u0dc0\u0da7 \u0d91\u0dca\u0db8\u0dd2 \u0dc0\u0dd4\u0dc1\u0dab\u0dca. \u0dc0\u0dd2\u0dc0\u0db1\u0dbd\u0dd2\u0db6\u0dbd \u0db8\u0dab\u0dca\u0db4\u0dbd\u0dc1\u0d86 \u0db1\u0dd2\u0dbd\u0db0\u0dca\u200d\u0daf\u0dbb\u0dd2\u0dca \u0dc3\u0dcf\u0db1 \u0dc3\u0dc0\u0dd4\u0dca \u0da7 \u0dc3\u0dcf\u0db1\u0daf\u0dbd :\u0d9a\u0dca\u0dc0 \u0db4\u0daf\u0dbb\u0dca \u0dae\u0dc0\u0dca\u0dbb\u0dd4\u0dc0\u0dca \u0db1:\u0db4\u0dd4 \u0dc3\u0dcf\u0dc1\u0d9b\u0dba\u0daf\u0dc1\u0db8\u0d9b \u0d85\u0dbb\u0dcf\u0dc0 \u0dc3\u0dc0\u0dd4\u0dca :\u0dd0\u0dca \u0d85\u0db4 :\u0dd0\u0dbb\u0dcf\u0dc0\u0dad\u0dca \u0dca\u0dcf\u0daf \u0dc1\u0db1\u0da7 \u0dc1\u0dbd\u0ddd\u0da2 \u0daf\u0dc0 \u0dc3\u0dc0\u0dd4\u0dca \u0db8\u0db1\u0da2 \u0da9\u0db4\u0dc1\u0dbd\u0ddd\u0d9c\u0dd2\u0dad\u0daf \u0dc1\u0dca\u0ddc\u0dba\u0d9c\u0dc3\u0dcf\u0db8\u0da7 \u0dbd\u0db6\u0daf \u0dc1: \u0dc0\u0daf \u0d9a\u0dd2\u0dbd\u0dbd\u0daf. \u0d85\u0db4\u0dd2 ]0]3 \u0dc3\u0d9a\u0dca\u0dc1\u0dad\u0ddd\u0db6\u0dbb\u0dca \u0db8\u0daf\u0dc3\u0dcf\u0dc1\u0d86 \u0dc1\u0dad\u0dd4 \u0dbb \u0dc1\u0dda \u0d9c\u0dd2\u0db1\u0dc3\u0dcf\u0dae\u0dcf \u0dca\u0daf\u0dab\u0dca\u0db4\u0dc1\u0d86 \u0dc3\u0dcf\u0db1 \u0d86\u0d9c\u0dba\u0d9c\u0dca \u0dc3\u0dd2\u0dd3\u0db0\u0dca\u200d\u0dc3\u0dcf\u0dae\u0dcf\u0daf \u0dc0\u0dbd \u0dc3\u0dd2\u0dbd\u0dbd\u0da7 18\u0d9a\u0dd2\u0dca \u0dc0\u0dd2\u0dc0\u0db1\u0dbd\u0dd2 \u0db6\u0dd2\u0dbd \u0dc0\u0dd0\u0da9\u0dd2 \u0dca\u0dcf\u0daf. \u0dca\u0dbb\u0dca\u0db8\u0daf\u0dca \u0dad \u0dc3\u0dcf\u0db1 \u0dc1\u0db1\u0ddd\u0da7\u0db8 \u0dc1\u0dc0\u0dbb\u0dc