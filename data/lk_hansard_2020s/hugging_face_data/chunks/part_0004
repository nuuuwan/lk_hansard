    "chunk_text": "\u0da7\u0db4\u0dd9\u0dca\u200d\u0dc0\u0d9a\u0dca\u0dc2\u0dc0\u0db0\u0db1\u0dd4\u0d9c\u0db8 \u0db1\u0dd9\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dca\u200d\u0dc0.\u0dc0\u0dc0\u0d92\u0dc0\u0dca\u200d\u0dc0\u0dda\u0dda\u0db8 \u0dc0\u0db6\u0dd4\u0dc0\u0db8\u0dd2 \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dd2\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dda\u0d9a\u0dcf\u0dc0\u0dad\u0dc0\u0da2\u0dd3\u0dca\u200d\u0dad\u0dca\u0dc0\u0dda\u0dca\u200d\u0db1\u0dca\u0db1\u0dc0\u0dc0\u0dd2\u0d9a\u0dbb\u0dd9\u0d9a\u0dca\u0dc2\u0dc0\u0db1\u0dd0\u0dad\u0dd2\u0dd3\u0db8 \u0dc0\u0d9a\u0dd2\u0dd9\u0db1\u0dc0\u0dca\u0dc0\u0db0\u0dc0\u0dc0 \u0dc0\u0dda\u0d9a\u0dae\u0dd4\u0dca\u200d\u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc0\u0db0\u0dda\u0dda\u0dc0\u0dc0\u0dda\u0da7\u0dca\u0dc0\u0da2\u0dcf\u0db1\u0dad\u0dc0\u0dca\u200d\u0dc0\u0dda\u0db4\u0dc5\u0dc0\u0d9c\u0dd0\u0dda\u0d9a\u0db1\u0dda\u0d9a\u0dcf\u0dc0\u0dad \u0dc0\u0dc0\u0d92\u0dc0\u0dda\u0dca\u200d\u0db1\u0dd4\u0dda\u0dca\u200d\u0db1\u0dca\u0dc0\u0da2\u0dcf\u0db1\u0dad\u0dc0\u0dca\u200d\u0dc0\u0db4\u0dc0\u0dc0\u0dad\u0dc0\u0d91\u0db1\u0dda\u0d9a\u0dcf\u0dc0\u0dad \u0dc0\u0dda\u0db4\u0dc0\u0dd3\u0dc3\u0dd2\u0dd9\u0dc0\u0dda\u0dd9\u0dc0\u0db4 \u0dc0 \u0dc0\u0dc0\u0dc0\u0dc0\u0dc0\u0da2\u0dcf\u0dba\u0dc0\u0db6 \u0dd9\u0dc0\u0dda\u0dd9\u0dc0\u0db4 \u0dc0\u0dc0\u0d92\u0dca\u200d\u0dc0\u0dc0\u0db8 \u0dbb\u0dca\u0dbd\u0db4\u0db1\u0dd9\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1\u0dc0\u0d9a\u0dcf\u0dad\u0dba\u0dd4\u0dd4\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dc0\u0db6\u0dca\u200d\u0dc0\u0db0\u0db4\u0dc0\u0dd4\u0dc0\u0d9f\u0d9a\u0dca\u0dc2\u0dc0\u0db0\u0dca\u200d\u0dca\u0dae\u0dcf\u0dc0\u0dca\u200d \u0daf\u0dd3\u0dc0\u0db0\u0da7\u0db4\u0dc0\u0db4\u0d9a\u0dd2\u0db1\u0dca\u200d\u0dc0.\u0dc0\u0d92\u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc0\u0db0\u0dda\u0dda\u0dc0\u0dad\u0dbb\u0dd4 \u0dc0\u0db4\u0dc0\u0db4\u0dd4\u0dc0\u0dad\u0dad\u0dca \u0dc0\u0dca\u0db8 \u0dc0\u0da2\u0dcf\u0dc0\u0db8 \u0dc0\u0db0\u0dba\u0dca\u200d \u0dc0\u0dca\u0dd0\u0db4\u0dad\u0dca\u0dc0\u0db1 \u0dc0\u0d92\u0dc0\u0dca\u200d\u0dc0\u0dda\u0dda\u0db8 \u0dc0\u0db0\u0db1\u0dca\u0dad\u0dbb\u0dca\u0dbd\u0da2\u0dcf\u0dc0 \u0dd9\u0dc0\u0d8b\u0db4\u0dda\u0dd9\u0ddd\u0d9c\u0dd3\u0dc0\u0d9a\u0dcf\u0dc0\u0dc0\u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dc0\u0d9a\u0dd0\u0db8 \u0dda\u0d9a\u0dcf\u0db1\u0dc0\u0dad\u0db8 \u0dad\u0dca\u0dc0\u0db0\u0db4\u0dc0\u0dc0\u0dd2\u0dc1\u0dc0 \u0dc0\u0dbd\u0dd2\u0dd9\u0d9a\u0dca\u0dc2\u0dc0\u0dad\u0dd2\u0dda\u0db6\u0db1\u0dca\u200d\u0dc0.\u0dc0\u0d92\u0dc0\u0dad\u0db8 \u0dba\u0dd2 \u0dc0\u0dda\u0db8\u0dca\u0dc0\u0db4\u0db1\u0dad\u0dca\u0dc0\u0dda\u0d9a\u0dcf\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dc0\u0dda\u0d9c\u0db1\u0dd0\u0dbd\u0dca\u0dbd \u0dc0\u0dc0\u0dda\u0db8 \u0dc0\u0db1\u0dd9\u0db8\u0dca\u0dc0\u0d86\u0d9a\u0dcf\u0dc0\u0dc0\u0dd9\u0d9a\u0dcf\u0dad\u0dc0\u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dc0\u0db8 \u0dbb\u0dca\u0dbd\u0db4\u0db1\u0dd9\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1\u0dc0\u0d9a\u0dcf\u0dad\u0dba\u0dd4\u0dd4\u0dc0\u0d9a\u0dcf\u0dc0\u0dba\u0dd2\u0db4\u0dc0\u0d9a\u0dd2\u0dd9\u0db1\u0dc0\u0d91\u0d9a\u0dcf\u0dc0\u0d9c\u0dd0\u0db1.\u0dc0\u0db8\u0dd6\u0dbd \u0dc0\u0dca\u0db1\u0dc0\u0dbb\u0dd6\u0daa\u0dc0\u0d9c\u0dbb\u0dd4\u0dc0\u0db8 \u0db1\u0dca\u0dd3\u0dd4\u0db8 \u0dd2\u0dba \u0dc0\u0dc0\u0d87\u0dad\u0dca\u0dad\u0dc0\u0dca\u200d\u0dc1\u0dda\u0dd9\u0db1\u0dca\u0db8 \u0dc0\u0dda\u0db8\u0dca\u0dc0\u0db4\u0db1\u0dad\u0dca\u0dc0\u0dda\u0d9a\u0dcf\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dc0\u0dda\u0d9c\u0dda\u0db1\u0db1\u0dc0\u0dda\u0d9a\u0dcf\u0dc0\u0dad\u0dc0\u0dc0\u0da2\u0dcf\u0dc0\u0dad\u0dba\u0db1\u0dca\u0dad\u0dc0\u0dc0\u0dca\u200d\u0dc1\u0dda\u0dd9\u0db1\u0dca\u0dc0\u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0dca\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0d9a\u0dcf\u0db8\u0dca \u0dc0\u0da2\u0dcf\u0dc0\u0dad\u0dba\u0db1\u0dca\u0dad\u0dc0\u0dc0\u0dca\u200d\u0dc1\u0dda\u0dd9\u0db1\u0dca\u0dc0\u0dad\u0dd2\u0dda\u0db6\u0db1\u0dc0\u0db6\u0dd0\u0db3\u0dd3\u0db8\u0dca\u0dc0\u0dca\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dca\u200d\u0dc0\u0dda\u0dca\u0dc0\u0dd9\u0dc0\u0dc0\u0db6\u0dd0\u0dd3\u0db8 \u0d9a\u0dca\u0dc2\u0dc0\u0d9a\u0dcf\u0dc5\u0dc0\u0db4\u0dc0\u0d9a\u0dd2\u0dd9\u0db1\u0dc0\u0d91\u0d9a\u0dcf\u0dc0\u0d9c\u0dd0\u0db1\u0dc0\u0db0\u0db4\u0dad\u0dc0\u0dda \u0dc0\u0d9a\u0dd4\u0dc0\u0dca\u0dd0\u0d9a\u0dcf\u0dd9\u0d9a\u0dca\u0dc2\u0dc0\u0dad\u0dd2\u0dda\u0db6\u0db1\u0dca\u200d\u0dc0.\u0dc0\u0dda\u0db8 \u0dc0\u0d9a\u0dcf\u0db4 \u0dc0\u0db0\u0db1\u0dca\u0dad\u0dbb\u0dca\u0dbd\u0da2\u0dcf\u0dc0 \u0dd9 \u0dc0\u0dca\u0db8 \u0dc0\u0da2\u0dcf\u0dc0\u0db8 \u0dc0\u0db0\u0dba\u0dc0\u0d9a\u0dd2\u0dd9\u0db1\u0dca\u0dda\u0db1\u0dca\u0dc0\u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dc0 \u0dcf\u0d9a\u0dcf\u0dc0\u0dda \u0dc0\u0dc0\u0dd2\u0daf\u0dd4\u0dd2\u0dc0\u0dca\u0dcf\u0dda\u0dda\u0dc1\u0dc0\u0dd2\u0dba\u0dd9\u0dc0\u0db8 \u0db1\u0dc0\u0dda\u0d9a\u0dcf\u0dc0\u0db8\u0dd2\u0dc2\u0dca\u0da8\u0db1\u0dca\u0dc0\u0dca\u0db7\u0dc0\u0dca\u200d\u0dc0\u0db8 \u0d9f\u0dd2\u0db1\u0dca\u0dc0\u0d87\u0dad\u0dd2\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dc0\u0dca\u200d\u0dbb\u0dd2\u0dd9\u0dc0\u0db4\u0dc0\u0db8 \u0dd9\u0d9a\u0dca\u0dc2\u0dc0\u0dda\u0db1\u0dc0\u0dda\u0dca\u200d\u0dba\u0dd2.\u0dc0\n\n\u0dd9\u0db8\u0dca\u0dc0\u0dda\u0d9a\u0dd9\u0d9a\u0dd2\u0db1\u0dca\u0dc0\u0d91\u0dd4\u0db8 \u0db1\u0dca \u0dc0\u0dc0\u0dda\u0db8\u0dca\u0dc0\u0dda\u0dda\u0dca\u200d\u0dbd\u0dca\u0dbd\u0dc0\u0dad\u0d9a\u0db1\u0db8\u0dca\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1\u0dc0\u0d9a\u0dcf\u0dad\u0dba\u0dd4\u0dd4\u0dc0\u0d9a\u0dcf\u0dda\u0dc5\u0dc0\u0dad\u0dca \u0dc0\u0d91\u0dda\u0d9a\u0db8 \u0dc0\u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca\u0dc0\u0dd9\u0db8\u0dca\u0dc0\u0d9a\u0dd2\u0dc3\u0dd2\u0dc0\u0dca\u200d\u0dc0\u0dc0 \u0dd9\u0d9a\u0dcf\u0dad\u0dc0 \u0d9a\u0dca\u0dc2\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1\u0dc0\u0d9a\u0dcf\u0dad\u0dba\u0dd4\u0dd4\u0dc0\u0d9a\u0dcf\u0dda\u0dc5\u0dc0\u0dad\u0dca \u0dc0\u0db0\u0dda\u0dda\u0dc0\u0dc0\u0dad\u0dc0\u0dda\u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0dda\u0dca\u200d\u0db1\u0dc0\u0dad\u0dad\u0dca\u0dad\u0dca\u0dca\u200d\u0dd9\u0d9a\u0dcf\u0dad\u0dc0\u0db4\u0dad\u0dca\u0dc0\u0dda\u0dca\u200d\u0db1\u0dca\u200d\u0dc0.\u0dc0\u0dca\u0db8 \u0dc0\u0da2\u0dcf\u0dc0\u0db8 \u0dc0\u0db0\u0dba\u0dc0\u0dda\u0d9a\u0ddd\u0dc0\u0db8 \u0dc0\u0db0\u0dba\u0dc0\u0db8 \u0dbb\u0dca\u0dbd\u0db4\u0db1\u0dd9\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1\u0dc0\u0d9a\u0dcf\u0dad\u0dba\u0dd4\u0dd4\u0dc0\u0d9a\u0dcf\u0dc0\u0db4\u0dd4\u0dc0\u0dc0\u0dad\u0dca\u200d\u0dbd\u0dca\u0dbd\u0dc0\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dc0\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dca\u200d\u0dc0\u0daf\u0dd3\u0dc0\u0dc0\u0dad\u0dca\u200d\u0dbd\u0dca\u0dbd\u0dc0\u0dda\u0db1\u0dc0\u0dda\u0dca\u200d\u0dba\u0dd2.\u0dc0\u0d92\u0dca\u200d\u0dc0\u0dc0\u0dd4\u0dc0\u0d9f\u0dc0\u0d9a\u0dca\u0dc2\u0dc0\u0dda\u0dca\u200d \u0dc0\u0dca\u200d\u0dad\u0dc0\u0d92\u0d9a\u0dcf\u0dc0\u0d9a\u0dbb\u0db4\u0dad\u0dd2\u0dc0\u0db1\u0dc0\u0dd9\u0d9a\u0dcf\u0dd9\u0db1\u0dca\u0dc0\u0dd2\u0db1\u0dca\u0db1\u0dc0\u0dc0\u0dad\u0dca\u200d\u0dbd\u0dca\u0dbd.\u0dc0\u0d8b\u0db4\u0dc0\u0d9a\u0dc0 \u0dd9\u0d9a\u0dcf\u0dad\u0dc0\u0d8b\u0dd4\u0dbb\u0dd4\u0dc0\u0dda\u0d9a\u0dcf\u0dc0\u0db4\u0dad\u0dd9\u0dc0\u0dca\u200d \u0dc0\u0dd4\u0dbb\u0dd4\u0db8 \u0dd9 \u0dc0\u0da0\u0dd3\u0db1\u0dd9\u0dc0\u0dca\u200d\u0dc0\u0dda\u0dda\u0dc0\u0dc0\u0dad\u0dca\u200d\u0dbd\u0dca\u0dbd\u0dc0\u0dda\u0db4\u0db1\u0dca\u0dca\u200d\u0dc0\u0dc0\u0dda\u0db4\u0db1\u0dca\u0db1\u0dc0\u0db4\u0dd4\u0dc5\u0dd4\u0dca\u200d\u0db1\u0dca.\u0dc0\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dc0\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dca\u200d\u0dc0\u0db4\u0dd9\u0dc0\u0d9c\u0dbb\u0dd4\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0dda\u0db1\u0dca\u0dc0\u0db1\u0dd0\u0dad\u0dd2\u0dc0\u0d92\u0d9a\u0dcf\u0dc0\u0d9a\u0dbb\u0db4\u0dad\u0dd2\u0dc0\u0dc0\u0dad\u0dca\u200d\u0dbd\u0dca\u0dbd\u0dc0\u0dad\u0db8 \u0dba\u0dd2\u0dc0\u0dd4\u0dc0\u0d9f\u0dc0\u0d9a\u0dca\u0dc2\u0dc0\u0db0\u0dca\u200d\u0dca\u0dae\u0dcf\u0dc0\u0dca\u200d \u0daf\u0dd3\u0dc0\u0dda\u0db8\u0dca\u0dc0\u0dca\u200d\u0dc0\u0dda\u0dda\u0dc0\u0dd3\u0dba\u0dad\u0dd2-\u0dbb\u0dd3\u0dad\u0dd2\u0dc0\u0d91\u0dda\u0d9a\u0db8 \u0dc0\u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca\u0dc0\u0db0 \u0db4\u0db1\u0dad\u0dca\u0dc0\u0dda\u0d9c\u0db1\u0dc0\u0d91\u0db1\u0dca\u0dda\u0db1\u0dca\u0dc0\u0d9a\u0dd2\u0dd9\u0db1\u0dc0\u0d91\u0d9a\u0dcf\u0dad\u0dca\u0dc0\u0db8 \u0db8 \u0dc0\u0dda\u0db8\u0dca\u0dc0\u0db0\u0dca\u200d\u0dca\u0dae\u0dcf\u0dc0\u0dda \u0daf\u0dd3\u0dc0\u0d94\u0db6\u0dd4\u0db8 \u0dc0\u0dad\u0dc0\u0db8 \u0dad\u0d9a\u0dca\u0dc2\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1\u0dc0\u0d95\u0db1\u0dd1.\u0dc0"
