    "chunk_text": "\u0db8\u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db8\u0dcf \u0d9a \u0dcf \u0d9a\u0dd9 \u0dc1\u0d9a\u0dcf\u0da7 \u0db8\u0da7 \u0dad\u0dad\u0dca\u0dad\u0da7\u0db8 \u0dc1\u0dda\u0dc0 \u0dcf2\u0d9a\u0dca\u0dad \u0dad\u0dd2 \u0dc0\u0dd4\u0dab\u0dcf. \u0dbb\u0dd2\u0d82\u0dcf \u0d86\u0dab\u0dca\u0da9\u0dd42, \u0dbb\u0dd2\u0d82\u0dcf \u0d86\u0dab\u0dca\u0da9\u0dd42 \u0d9a\u0dd2\u0dba \u0d9a\u0dd2\u0dba\u0dcf \u0dc1\u0dda \u0da2\u0dda\u0db0\u0dd2\u0dba\u0da7 \u0dcf\u0da7\u0db8 \u0dc0\u0dcf\u0db8 \u0d85\u0db4\u0dd2 \u0dc1\u0db6\u0dc0\u0dcf \u0dc12\u0db1\u0dca\u0dad \u0d9a\u0dd9 \u0dd4\u0db1\u0dca\u0dad \u0d9a \u0dcf \u0d9a\u0dd9\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dad\u0dba\u0dd2? \u0dd4 \u0da0 \u0d85\u0db0\u0dd2\u0d9a\u0dd9\u0dab \u0dad\u0db8\u0dd2 \u0dd4\u0db8\u0dcf \u0d9a\u0dd2\u0dba\u0dbb \u0d91\u0d9a \u0dcf \u0db8\u0dba\u0da7 \u0dcf \u0db8. \u0dc1\u0dda\u0d9a \u0d85\u0db4\u0dd2 \u0dca2\u0dd9 \u0d9a\u0dd9\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0da7\u0dda\u0dc0? \u0dcf\u0da7\u0db8 \u0dc0\u0dcf\u0db8 \u0dc1\u0dda \u0da2\u0dda\u0db0\u0dd2\u0dba\u0da7 \u0da2\u0dcf\u0dd2 2 \u0dc1\u0dba\u0db1\u0dca\u0dad \u0dc1\u0db6\u0daf\u0dd2 \u0dcf \u0dca\u0db1\u0dca\u0dad \u0dc0 \u0dcf\u0dc0\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad? \u0dd4 \u0da0 \u0d85\u0db0\u0dd2\u0d9a\u0dd9\u0dab \u0dad\u0db8\u0dd2 \u0dd4\u0db8\u0dcf \u0dc1\u0db4\u0db1\u0dca\u0dad2\u0dcf \u0daf\u0dd3\u0dbb \u0d91\u0d9a \u0dcf \u0db8\u0dba\u0da7 \u0dcf \u0db8. \u0dd4 \u0da0 \u0daf\u0dca\u200d\u0dbb\u0da2\u0dda\u0da9 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db8\u0db1\u0dd2, \u0d91\u0dbd\u0dcf\u0dd3\u0daf\u0dd3\u0daf\u0da7 \u0d91\u0dc1\u0d9a\u0dca\u0dad \u200d\u0dbb\u0dcf\u0dcf\u0d9a\u0dd9\u0db1\u0dca\u0dad \u0dc1\u0db8\u0dcf \u0db8\u0da7 \u0db8\u0dbd\u0dcf \u0d9a\u0dca\u0dad\u0dc0 \u0db8\u0da7 \u0da0\u0dc1\u0dda \u0d9a\u0dd2\u0dba \u0dcf \u0d94\u0db6\u0dd4\u0db8\u0dcf \u0dc0\u0da7\u0d9a\u0dca\u0dad\u0d9a\u0dcf \u0dc1\u0db1\u0dca\u0dad\u0dc0? \u0dad\u0dba\u0dd2, \u0d922\u0dcf \u0d85\u0db8\u0dad\u0d9a \u0d9a\u0dd9 \u0dcf \u0d91\u0dc1\u0dcf\u0db8 \u0dc1\u0dda2\u0dbd\u0dcf \u0dc1 \u0dcf\u0dc0\u0dd4\u0dab\u0dcf 2\u0dcf\u0dc1\u0d89 \u0d9a \u0dcf \u0d9a\u0dd9\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad? \u0d92\u0d9a \u0dc1\u0d9a\u0dcf\u0dca.\u0dd2\u0dd9 \u0d85\u0dc0\u0dd3\u0dcf\u0db0\u0dcf\u0dd9\u0dab\u0dc0? \u0dc1\u0dda\u0dc0 \u0dcf \u0dc0\u0dd3\u0dcf\u0dd4\u0dad\u0dc0? \u0dc1\u0d9a\u0dcf\u0dc1 \u0dcf\u0db1\u0dca\u0dad \u0dcf\u0dc1\u0dda \u0dc1\u0dad\u0dbd\u0dcf \u0da7\u0da7\u0d82\u0d9a\u0dd22 \u0da7 \u0dd4\u0da7\u0dd4\u0dab\u0dc1\u0dda \u0d86\u0dc0\u0dc1\u0dbb\u0dca\u0dbd\u0da7\u0dc0? 2\u0dd9\u0dcf\u0dba\u0da7 \u0dd4\u0da7\u0dd4\u0dab\u0dc1\u0dda, \u0d85\u0dd9\u0db1\u0dca\u0dad\u0dad \u0dcf\u0dc1\u0dda\u0daf\u0dd3 \u0dc1\u0db4\u0dcf\u0da9\u0dd2 \u0dc0\u0dd3\u0dcf\u0db8\u0dc1\u0dab\u0dca\u0da9\u0dd9 \u0dcf\u0dcf\u0db8\u0dd4\u0dd4\u0dc0 \u0da02 \u0da0 \u0d85\u0db8\u0dd4 \u0d85\u0db8\u0dd4\u0dc1\u0dda \u0db8\u0da7 \u0da0\u0dc1\u0dda \u0dad\u0dba\u0dd2? \u0d92 2\u0dcf\u0dc1\u0d89 \u0dc1\u0dda2\u0dbd\u0dcf \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dd9 2\u0dcf 2\u0dcf\u0dc1\u0d89 \u0d94\u0db6\u0dd4\u0db8\u0db1\u0dca\u0dad \u0dcf \u0d9a \u0dcf \u0d9a\u0dd9\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dad\u0dba\u0dd2?\n\n\u0dc1\u0dda \u0dbb\u0dd2\u0dba\u0dbd\u0dcf \u0db4\u0da7\u0dad\u0dca\u0dad\u0d9a\u0da7 \u0dc0\u0dcf \u0dcf \u0d91\u0d9a \u0da2\u0dcf\u0dd2 \u0dba\u0d9a\u0dca\u0dad \u0dcf\u0da7\u0da7\u0dd2\u0dba\u0da7, \u0d91\u0d9a\u0db8 \u0db8\u0db1\u0dd4\u0dc2\u0dba \u0dc1\u0d9a\u0dcf\u0da7\u0dca\u0dc0\u0dcf\u0dc0\u0dd3\u0dba\u0d9a\u0dca\u0dad \u0dcf\u0da7\u0da7\u0dd2\u0dba\u0da7 \u0dc1\u0dcf\u0dcf\u0db3\u0dd2\u0db1\u0dca\u0dad \u0dd3\u0dc02\u0dad\u0dca2\u0db1\u0dca\u0dad \u0d85\u0db4\u0da7 \u0dc0\u0da7\u0db1\u0dca\u0dad2\u0dad\u0dca \u0db6\u0da7 \u0db8\u0dc0? \u0dcf\u0da7\u0db8\u0dc0\u0dcf\u0db8 \u0dad\u0dba\u0dd2 \u0dc1\u0dda \u200d\u0dbb \u0db8 \u0dad\u0dc0 \u0dad\u0dc0 \u0d85\u0db4 \u0dc1\u0db6\u0dc0\u0dcf \u0dc12\u0db1\u0dca\u0dad \u0d9a\u0dd9\u0db1\u0dca\u0dad \u0dcf\u0dc0\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad? \u0d9a \u0da0\u0dab\u0dcf\u0d9a\u0dd9 \u0dcf \u0d92\u0d9a \u0d9a\u0dd9\u0db1\u0dca\u0dad \u0d91\u0db4\u0dcf.\n\n\u0dc1\u0dda \u0dd4 \u0da0 \u0dc0\u0dd3\u0dcf\u0dcf\u0dc1\u0dda \u0dca\u0db1\u0dca\u0dad 2\u0dcf, \u0da2 \u0dcf\u0db0\u0dd2\u0db4\u0dd2 \u0db1\u0dd3\u0dd2 \u0da52 \u0da0 \u0dd4\u0db1\u0dca\u0dad\u0dc1\u0dc0\u0dc1 \u0d9a\u0dca\u0dad. \u0db8\u0db8 \u0dc0\u0db1\u0dca\u0dad \u0dcf \u0da2\u0dda\u0db0\u0dd2\u0dba\u0da7 \u0d92, \u0d94\u0db6\u0dd4\u0db8\u0dcf\u0dad\u0dca, \u0d85\u0dd2 \u0dc0\u0dd3\u0dda \u0db8 \u0db8\u0da7\u0dd2 \u0dd4\u0db8\u0dcf\u0dad\u0dca, \u0db8\u0db8\u0dad\u0dca. \u0da7\u0da7 \u0d85\u0db8\u0dad\u0dd92 \u0dc0\u0dd3\u0dcf\u0db8\u0dcf \u0dba \u0db1\u0dd3\u0dd2 \u0da52 \u0da0 \u0dd4\u0dab \u0dcf2\u0d9a\u0dca\u0dad \u0dca\u0db1\u0dca\u0dad 2\u0dcf. 2\u0da7\u0dd2 \u0dcf \u0dc1\u0dda\u0db4\u0dc52 \u0da7 \u0dc1\u0dcf\u0dcf\u0dd9 \u0d94\u0dc2\u0dbb \u0dcf\u0dc0 \u0dcf \u0d922\u0dcf \u0da2\u0dda\u0d9a\u0dd4\u0dab\u0dcf \u0dd4\u0db1\u0dca\u0dad \u0dcf\u0dc0 \u0d91\u0d9a \u0d85\u0db4\u0dd2 \u0dcf\u0da7\u0dc1\u0db8\u0ddd\u0da7\u0db8 \u0dd2\u0da2\u0dcf2\u0d9a\u0dca\u0dad. \u0d92 2\u0d82\u0dd2\u0dcf2 2\u0dad\u0dca2\u0db1\u0dca\u0dad \u0d94\u0db6\u0dd4\u0db8\u0dcf \u0dc1\u0dd4 \u0da7\u0dbd\u0dcf \u0dcf \u0dd2 \u0dc1\u0db6 \u200d\u0dbb\u0dd2 \u0db4\u0dcf\u0dc0 \u0dd4\u0da7 \u0d9a \u0dcf \u0d9a\u0dd9\u0db1\u0dca\u0dad \u0dca\u0dc0\u0dd3\u0db8\u0dc1\u0dc0\u0dd3\u0dbd\u0dcf \u0dcf \u0db8\u0db8 \u0d94\u0db6\u0dd4\u0db8\u0dcf\u0dc1\u0dd4\u0db1\u0dca\u0dad \u0d91\u0d9a \u0dca\u0dbd\u0dcf\u0dd3\u0db8\u0d9a\u0dca\u0dad \u0d9a\u0dd9 2\u0dcf. \u0dd4 \u0da0 \u0dad\u0db8\u0dd2 \u0dd4\u0db8\u0db1\u0dd2, \u0d92 \u0dc1\u0dcf\u0dcf\u0dd9 \u0d94\u0dc2\u0dbb \u0dcf\u0dc0 \u0d85\u0dba\u0da7 \u0dc0\u0dac\u0dd42\u0dda \u0d9a\u0dd2\u0dd3\u0dad\u0db8\u0da7 \u0db8\u0dd3\u0da7 2\u0da9\u0dcf \u0dc1\u0db6\u0dcf\u0dc1\u0dcf\u0dcf\u0db8 \u0dad\u0dc0 \u0db1\u0dd3\u0dd2 \u0dc1\u0dd4\u0dc1 \u0db1\u0dca\u0dad . \u0d92 \u0d85\u0dba\u0da7 \u0dad\u0db4 \u0da7\u0dd2 \u0d9a\u0dd9\u0db1\u0dca\u0dad . \u0dc1\u0db82\u0da7\u0db1\u0dd2 2\u0d82\u0dd2\u0dcf \u0d9a\u0dc1\u0dc5\u0dcf\u0dad\u0dca \u0dc4\u0dd2\u0dd9 \u0dc1\u0d89 \u0dad\u0dd4\u0dc1\u0dc5\u0db8 \u0dd9\u0d9a2\u0dcf\u0dc1\u0dd4 \u0dd4 \u0d85\u0dcf \u0dcf \u0dca2\u0dd9 \u0d9a\u0dd9\u0db1\u0dca\u0dad . \u0d92 \u0db1\u0dd3\u0dd2 \u0dcf\u0dc0 \u0dc1\u0d9a\u0dcf\u0da7 \u0d852\u0db8\u0dba \u0d85\u0dc0\u0dd4 \u0da0\u0dd4\u0dc0 10\u0d9a2\u0dad\u0dca \u0dc0\u0dac\u0dd42\u0dda \u0d9a\u0dcf \u0dba\u0d9a\u0dca\u0dad \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dd9\u0db1\u0dca\u0dad . \u0db4 \u0db8\u0db8\u0dba \u0d85\u0dc0\u0dd4 \u0da0\u0dd4\u0dc0 70 \u0dc0\u0d9a\u0dca\u0dad2\u0dcf\u0dad\u0dca \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dd9\u0db1\u0dca\u0dad . \u0d91\u0dc1\u0dcf\u0db8 \u0dc1 \u0dcf\u0d9a\u0dc5\u0dc1\u0dcf\u0dcf\u0dad\u0dca \u0dc1\u0dda \u0d9a\u0da7\u0dad \u0dbb\u0dd2 \u0db8\u0dad 2\u0dad\u0dca2\u0db1\u0dca\u0dad \u0db6\u0da7\u0dcf\u0da7. \u0dc1 \u0dcf\u0dad\u0dcf \u0db8\u0dc0\u0dd3\u0db82 \u0da0\u0db1\u0dca\u0dad\u0da7 \u0d91\u0d9a \u0d91\u0d9a \u0dc1\u0dcf\u0db8\u0dd4 \u0d9a\u0dd2\u0dba \u0dcf \u0dc1\u0dcf\u0dcf\u0dd9 \u0d94\u0dc2\u0dbb \u0dcf\u0dc0 2\u0dcf. \u0d9a\u0dcf\u0dc1\u0d89 \u0dcf \u0db8 2\u0da7\u0dd2 \u0dcf \u0dca\u0da9\u0db8\u0d9a\u0dca\u0dad \u0dd2 \u0db6\u0dd4\u0dc1\u0dab\u0dcf\u0dad\u0dca \u0d92\u0d9a\u0da7 \u0dc1\u0dcf\u0dcf\u0dd9 \u0d94\u0dc2\u0dbb2\u0d9a\u0dca\u0dad \u0dcf\u0dc0 2\u0dcf, \u0da7\u0da7 \u0db4\u0dc3\u0dd42 \u0d92\u0d9a transfer \u0d9a\u0dd9 2\u0dcf. \u0dd4 \u0da0 \u0dad\u0db8\u0dd2 \u0dd4\u0db8\u0db1\u0dd2, \u0dc1\u0dda\u0d9a \u0db8\u0dd4\u0dc5\u0dd4 \u0db1\u0dd3\u0dd2 \u0da5 \u200d\u0dbb\u0da2\u0dcf2\u0da7\u0db8, \u0dc0\u0dd3\u0db8\u0dcf\u0da2\u0dba\u0da7\u0db8 \u0dd2\u0da2\u0dcf2\u0d9a\u0dca\u0dad."
