    "chunk_text": "\"\u0dca \u0d9a\u0dcf\u0dc0\u0dc0\u0db6\u0dd0\u0dd3\u0dda\u0db8 \u0db1\u0dca\u0dc0\u0db0\u0db1\u0dd4\u0dbb\u0dd4\u0dca\u200d \u0dc0\u0db8 \u0dc0\u0db0\u0dba \u0dc0\u0dad\u0dc0\u0dbb\u0dd4 \u0dba \u0dc0\u0d8b\u0dbb\u0dd4\u0db8 \u0dd9\u0dc0\u0d9a\u0dc0\u0dc0\u0dd6\u0dad\u0dad\u0db1\u0dc0\u0db4\u0dd4\u0dc0\u0dca\u200d\u0dd0\u0dc3\u0dd2\u0dd9\u0dc0\u0dc0\u0da7\u0db4\u0dc5\u0dd2\u0db6\u0dc4\u0dc0\u0d86\u0dcf\u0dc1\u0dd2\u0d9a\u0dcf\u0dc0\u0db0\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8 \u0dc0\u0d9a\u0dcf\u0dc0\u0dc0\u0d9a\u0dcf\u0dc0\u0dca\u0db7\u0dc0\u0dca\u200d \u0dc0\u0db4\u0dc0\u0dbb\u0dca\u0dbd\u0dd2\u0dda\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dca\u200d\u0dc0\u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dc0\u0d9a\u0dcf\u0dc0\u0dc0\u0d9a\u0dcf\u0dc0\u0dca\u0db7\u0dc0\u0dca\u200d\u0dc0\u0dda\u0dca\u200d\u0dad\u0dc0\u0dda\u0dd9\u0dc0\u0db8\u0dd4\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dc0 \u0db4\u0dc0'\u0db8 \u0dc0\u0dbb\u0dca\u0dbd\u0d9c\u0d9c\u0dad\u0dc0\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dca\u200d \u0dc0\u0dc3\u0dd4\u0dc0\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dc0\u0db7\u0dc0\u0dca\u200d\u0dd9\u0dc0\u0da7\u0db4\u0dc5\u0dd2\u0db6\u0dc4\u0dc0\u0db4\u0db1\u0dad\u0dca\u0dc0\u0dda\u0d9a\u0dcf\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad'\u0dc0\u0dca\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dca\u200d\u0dc0\u0dda\u0dbb\u0dae\u0dc2\u0dca\u0da8\u0dae\u0db0\u0dc0\u0d9a\u0dbb\u0d9a\u0dcf\u0dc0 \u0dda\u0dd9\u0db1\u0dca\u0dc0\u0dad\u0dd3\u0dc0 \u0dd9\u0dc0\u0dc0\u0dd6\u0dc0\u0dca\u0dcf\u0dda\u0dc1\u0ddd\u0db0\u0db1\u0dca\u200d \u0dad\u0dc0\u0dd9\u0dad\u0dad\u0dca\u0dca\u200d\u0dc0\u0d91\u0d9a\u0dcf\u0d9f\u0dc0\u0dc0\u0dd6\u0dc0\u0db0\u0dad\u0dc0...\n\n\u0dda\u0dbb\u0dae\u0dc2\u0dca\u0da8\u0dae\u0db0\u0dc0\u0d9a\u0dbb\u0d9a\u0dcf\u0dc0 \u0dda\u0dda\u0dc0\u0dca\u0dcf\u0dda\u0dc1\u0ddd\u0db0\u0db1\u0dca\u200d \u0dad\u0dc0\u0dd9\u0dad\u0dad\u0dca\u0dca\u200d\u0dc0\u0d91\u0d9a\u0dcf\u0d9f\u0dc0\u0dc0\u0dd4 \u0dc0\u0dd9\u0dc0\u0d9a\u0dd2\u0dd9\u0db1\u0dc0\u0d9a\u0dcf\u0dc0\u0dc0 \u0dc0\u0dca\u200d\u0dc0\u0d9a\u0dd2\u0dd9 \u0dc0\n\n\"\u0d92\u0dc0\u0da7\u0db4\u0dc5\u0dd2\u0db6\u0dc4\u0dca\u200d\u0dc0\u0d9a\u0dcf\u0dc0\u0dc0\u0d9a\u0dcf\u0dc0\u0dca\u0db7\u0dc0\u0dda \u0dc0\u0dca\u200d\u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dca\u200d ... \u0dc0\n\n\u0d92\u0dc0\u0d9a\u0dd2\u0dd9\u0db1\u0dca\u0dda\u0db1\u0dca\u0dc0\u0d9a\u0dcf\u0dc0\u0dc0\u0d9a\u0dcf\u0dc0\u0dca\u0db7\u0dc0\u0dc0\u0dca\u200d\u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dca\u200d\u0d9a\u0dca\u0dc2\u0dc0\u0db1\u0dd0\u0d9a\u0dd0 \u0dc0\u0dad\u0dca\u200d\u0db8 .\u0dc0\n\n\u0db8 \u0db8 \u0dc0\u0db0\u0d9a\u0db1\u0dca\u0dda\u0db1\u0dca\u0dc0\u0d9c\u0dbb\u0dd4\u0dc0\u0d9a\u0dcf\u0dcf\u0dc0\u0db1\u0dc0\u0dd9\u0d9a\u0dcf\u0dd4\u0db8 \u0dd2\u0dba \u0dc0\u0dda\u0d9a\u0dcf\u0ddd\u0dc0\u0d92\u0dc0\u0dca\u200d\u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dca\u200d?\u0dc0\u0dda\u0db8 \u0dc0\u0d9a\u0dcf\u0db4 \u0dc0\u0dda\u0db8\u0dca\u0d9a\u0dcf\u0dc0\u0d92\u0dc0\u0dca\u200d\u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dca\u200d\u0dc0\u0d9a\u0dd2\u0dd9 \u0dc0\u0dc0\u0d92\u0dc0\u0d9a\u0dcf\u0dc0\u0dc0\u0d9a\u0dcf\u0dc0\u0dca\u0db7\u0dc0\u0dda \u0dc0\u0dca\u0db7\u0dc0\u0db4\u0dad\u0dd2\u0dd4\u0db8 \u0dc0\u0dc0\u0dca\u0d9a\u0dc0\u0dda\u0dbd\u0dca\u0dbd\u0d9a\u0dcf\u0db8\u0dca\u0dd4\u0db8 \u0dc0\u0dc0\u0d9a\u0dd2\u0dd9\u0db1\u0dca\u200d\u0dc0\u0dc0\u0db1\u0db8\u0dca \u0dc0\u0d92\u0d9a\u0dcf\u0dc0\u0d9a\u0db4\u0dad\u0dd9\u0dad\u0dc0\u0dda\u0db8\u0dca\u0dc0\u0db4\u0dc0\u0dbb\u0dca\u0dbd\u0dd2\u0dda\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dda \u0dc0115\u0dda\u0db4\u0db1\u0dc0\u0db8 \u0dc0\u0db0\u0db8 \u0dda\u0db1\u0ddd\u0dcf\u0dd9\u0db1\u0dca\u0dc0\u0d9a\u0dd0\u0da7\u0dd2\u0dd9\u0dad\u0dc0\u0dca \u0d9a\u0dcf \u0dc0\u0dc0\u0dad\u0db8 \u0dba\u0dd2\u0dc0\u0dc0\u0d9a\u0dcf\u0dad\u0dba\u0dd4\u0dd4\u0dc0\u0d9a\u0dcf\u0dc0\u0dc0\u0dad\u0dd2\u0dda\u0db6\u0db1\u0dca\u0dda\u0db1\u0dca.\u0dc0\u0dda\u0db8\u0dca\u0dc0115\u0dda\u0db4\u0db1\u0dc0\u0db8 \u0dc0\u0dda\u0db8 \u0ddd\u0da9\u0dda\u0dd9\u0ddd\u0dc0\u0dda\u0db1\u0dc0\u0dda\u0dca\u200d\u0dba\u0dd2\u0dda\u0db1\u0dca.\u0dc0\u0dda\u0db8\u0dca\u0dc0115\u0dda\u0db4\u0db1\u0dc0\u0db8 \u0dc0\u0db0\u0db8 \u0dda\u0db1\u0ddd\u0dcf\u0dda\u0dd9\u0ddd\u0dc0\u0dda\u0db1\u0dc0\u0dda\u0dca\u200d\u0dba\u0dd2\u0dda\u0db1\u0dca.\n\n\u0d9c\u0dbb\u0dd4\u0dc0\u0d9a\u0dcf\u0dcf\u0dc0\u0db1\u0dc0\u0dd9\u0d9a\u0dcf\u0dd4\u0db8 \u0dd2\u0dba \u0dc0\u0db8 \u0db8 \u0dc0\u0db0\u0d9a\u0db1\u0dc0\u0db4\u0dc5\u0db8\u0dd4\u0dca\u200d\u0dd0\u0dd2\u0dba\u0dc0\u0d9a\u0dcf\u0dc0\u0dc0 \u0dc0\u0dca\u200d\u0dc0\u0dda\u0db8 \u0dd9\u0dba\u0dd2.\u0dc0\u0dda\u0db8\u0dca\u0dc0\u0d9c\u0dbb\u0dd4\u0dc0\u0dca\u0db7\u0dc0\u0dda \u0dc0\u0dca\u200d\u0dd0\u0da9\u0dc0\u0d9a\u0dcf\u0dad\u0dba\u0dd4\u0dd4\u0dc0\u0dc0\u0dda\u0d9c\u0db1\u0dc0\u0dd9\u0db1\u0dc0\u0d86\u0d9a\u0dcf\u0dc0\u0dc0\u0dd9\u0dc0\u0da7\u0db4\u0dc5\u0dd2\u0db6\u0dc4\u0dca\u200d\u0dc0\u0dca\u0dae\u0dcf\u0dc0\u0dca\u200d\u0dc0\u0dc0\u0dd2\u0dba\u0dda\u0dd9\u0ddd\u0d9c\u0dca\u200d \u0dc0\u0dda\u0db6\u0dc0\u0dda\u0d9a\u0dc0\u0db8 \u0dc0\u0db4\u0dd0\u0d9a\u0dd0\u0dbb\u0dd2\u0dd2\u0dca\u200d\u0dc0\u0dad\u0dd2\u0dda\u0db6\u0db1\u0dca\u200d\u0dc0.\u0dc0\u0d92\u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc0\u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0da7\u0db4\u0dd9\u0dca\u200d\u0dc0\u0d9a\u0dca\u0dc2\u0dc0\u0d9c\u0db1\u0dca\u0db1\u0dc0\u0db6\u0dd0\u0d9a\u0dd0 \u0dc0\u0dda\u0db8\u0dca\u0dc0\u0dca\u200d\u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dca\u200d\u0dc0\u0db1\u0dd0\u0dad\u0dd2\u0dca\u200d.\u0dc0\u0dda\u0db8\u0dca\u0dc0\u0dda\u0dbd\u0dca\u0dbd\u0d9b\u0dca\u200d\u0db1\u0dda\u0dda\u0dc0\u0dca\u0dc4\u0d9a\u0db1\u0dca\u0dc0\u0d9a\u0dcf\u0dc0\u0dc0\u0dad\u0dd2\u0dda\u0db6\u0db1\u0dca\u200d\u0dc0 \u0dc0 \u0dca\u200d\u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dca\u200d\u0dc0\u0da7\u0db4\u0dc5\u0dd2\u0d9c\u0dd0\u0db1\u0dca\u0dc0\u0dd2\u0dd9\u0dc0\u0dba\u0dd4\u0dd4\u0dc0\u0dd9\u0dba\u0dd2\u0db4\u0dc0\u0dad\u0dd3\u0dc0 \u0dd9\u0dc0\u0d9a\u0dcf\u0dda\u0dc5\u0dae\u0dd9 \u0dc0\u0d9a\u0dd2\u0dd9 \u0dc0.\u0dc0\u0d92\u0dda\u0d9a\u0dcf\u0db1\u0dca\u0dc0\u0d9a\u0dd2\u0dd9\u0dd0\u0dda\u0dca\u200d\u0db1\u0dca\u200d\u0dc0 \u0dc0\u0dda\u0db8\u0dca\u0d9a\u0dcf\u0dc0\u0dca\u200d\u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0dc0\u0dca\u200d\u0dc0\u0dda\u0db1\u0dc0\u0dda\u0dca\u200d\u0dba\u0dd2\u0dc0\u0d9a\u0dd2\u0dd9 \u0dc0.\u0dc0\u0d92\u0dc0\u0d9a\u0dcf\u0dc0\u0dc0 \u0dd9\u0dad\u0dca\u0dc0\u0db8\u0dd4\u0dbd\u0dca\u0dbd\u0dc0\u0d9a\u0dcf\u0dc0\u0dda\u0d9c\u0db1 \u0dc0\u0db0\u0db4\u0dc0\u0dda\u0db8\u0dca\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1\u0dc0\u0dd9\u0db1\u0dc0\u0dc0\u0dd2\u0dca\u200d\u0dc0\u0db4\u0dda\u0dda\u0dc0\u0dca\u200d\u0dd0\u0da9\u0dc0\u0d9a\u0dcf\u0dad\u0dba\u0dd4\u0dd4\u0dc0\u0dca\u0dae\u0dcf\u0dc0\u0dca\u200d\u0dc0\u0dc0\u0dd2\u0dba\u0dda\u0dd9\u0ddd\u0d9c\u0dca\u200d \u0dad\u0dc0\u0db4\u0dad\u0d9a\u0dd0\u0dd2\u0dba\u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dad\u0dca \u0dc0\u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dca\u200d\u0dba\u0dca\u200d\u0dca\u0dae\u0dcf\u0dc0\u0dca\u200d\u0dad\u0dc0\u0db4\u0dad\u0d9a\u0dd0\u0dd2\u0dba\u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dad\u0dca\u0dc0\u0dda\u0db8\u0dca\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1\u0dc0\u0dc0\u0dd6\u0dc0\u0dca\u200d\u0dbb\u0dd2\u0dd9\u0dc0\u0db4\u0dc0\u0db8 \u0dd9\u0dc0\u0dca\u200d\u0d9a\u0dc0\u0db8 \u0dc0\u0db1\u0dad\u0dc0\u0dda\u0d9a\u0dcf\u0dc0\u0dad\u0dc0\u0db8\u0dd3\u0dad\u0dc0\u0dca\u200d\u0da9\u0dc0\u0dc0\u0dca\u200d\u0dbb\u0dc1\u0dca\u0dae\u0dad \u0dc0\u0dca\u200d\u0dba\u0dca\u200d\u0dca\u0dae\u0dcf\u0dc0\u0db1\u0dd4\u0dd6\u0dbd \u0dc0\u0dca\u200d\u0dbb\u0dd2\u0dd9\u0dc0\u0db8 \u0dc0\u0dbb\u0dca\u0dbd\u0d9c\u0dd9\u0d9a\u0dcf\u0dad\u0dc0\u0d94\u0db6\u0dd4\u0db8 \u0dc0\u0dc0\u0dca\u200d\u0dbb\u0dda \u0dc1\u0dc0\u0dca\u200d\u0db1\u0dca\u0db1.\u0dc0\n\n\u0dc0\u0dd2\u0dc0\u0dda\u0dc1\u0dae\u0dc2\u0dca\u0da8\u0dda\u0dd9\u0db1\u0dca\u0db8 \u0dc0\u0db8 \u0db8 \u0dc0\u0d9a\u0dd2\u0dd9\u0db1\u0dca\u0db1\u0dc0\u0d9a\u0dcf\u0dd0\u0db8 \u0dd0\u0dad\u0dd2\u0dba\u0dd2\u0dc0\u0d9c\u0dbb\u0dd4\u0dc0\u0da7\u0dd2\u0dc0\u0dc0\u0db1\u0dca\u0dc0\u0db0 \u0dca\u0dae\u0dc0\u0d87\u0db8 \u0dad\u0dd2\u0dd4\u0db8 \u0dc0\u0dc0\u0db4\u0dad\u0dca\u0dc0\u0d9a\u0dcf\u0dc0 \u0dc0\u0dc0\u0dad\u0dd2\u0dda\u0db6\u0db1\u0dca\u200d\u0dc0 \u0dc0\u0dc0\u0dd2\u0dda\u0dc1\u0dae\u0dc2\u0dca\u0da8\u0dcf\u0dc0\u0d9a\u0dcf\u0db8\u0dd2\u0da7\u0dd4\u0dca\u200d\u0d9a\u0dca\u0dc2.\u0dc0\u0d92\u0dc0\u0dc0\u0dd2\u0dda\u0dc1\u0dae\u0dc2\u0dca\u0da8\u0dcf\u0dc0\u0d9a\u0dcf\u0db8\u0dd2\u0da7\u0dd4\u0dda \u0dc0\u0dd2\u0dba\u0dbb\u0dca\u0dbd\u0dda\u0dda\u0dc1\u0dca\u200d \u0dad\u0dc0\u0db4\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8 \u0dc0\u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8\u0dc0\u0dda\u0dda\u0db4\u0dda\u0dd9\u0db1\u0dca\u0dc0\u0dda\u0dad\u0dc0\u0dc0\u0dca\u200d\u0dc0\u0da7\u0dda\u0dda\u0dc0\u0dbb\u0dd2\u0db1\u0dda\u0dda\u0dc0\u0d86\u0dcf\u0dc1\u0dd2\u0d9a\u0dcf\u0dc0\u0db0\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8 \u0dc0\u0d9a\u0dcf\u0dc0\u0dc0\u0d9a\u0dcf\u0dc0\u0dca\u0db7\u0dc0\u0dda \u0dc0\u0dc3\u0dd2\u0dd9\u0dbd\u0dd4\u0dda\u0db4\u0db1\u0dc0\u0dc0\u0dc0\u0d91\u0d9a\u0dcf\u0d9f\u0dc0\u0dc0\u0dd4 \u0dc0.\u0dc0\u0d9c\u0dbb\u0dd4\u0dc0\u0da7\u0dd2\u0dc0\u0dc0\u0db1\u0dca\u0dc0\u0db0 \u0dca\u0dae\u0dc0\u0d87\u0db8 \u0dad\u0dd2\u0dd4\u0db8 \u0dc0\u0dc0\u0db4\u0dad\u0dca\u0dc0\u0d9a\u0dcf\u0dc0\u0db4\u0dd4\u0dc0\u0d92\u0dc0\u0dc0\u0dd2\u0dda\u0dc1\u0dae\u0dc2\u0dca\u0da8\u0dcf\u0dc0\u0d9a\u0dcf\u0db8\u0dd2\u0da7\u0dd4\u0dda \u0dc0\u0dd2\u0dba\u0dbb\u0dca\u0dbd\u0dda\u0dda\u0dc1\u0dc0\u0d87\u0dd4\u0dc5\u0dad\u0dca\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1\u0dad\u0dc0\u0d9a\u0dd0\u0dda\u0db8 \u0ddd\u0db8 \u0dc0\u0db4\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8\u0dc0\u0dda\u0dda\u0db4\u0dda\u0dd9\u0db1\u0dca\u0dc0\u0dda\u0dad\u0dc0\u0dc0\u0dca\u200d\u0dc0\u0d9a\u0dcf\u0dad\u0dba\u0dd4\u0dd4\u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dda\u0d9a\u0dcf\u0dc0\u0dad\u0dc0\u0dd3\u0dba\u0dad\u0dd2\u0db4\u0dad\u0dd2\u0dca\u200d\u0dc0\u0dd9\u0dc0\u0dc0\u0d9a\u0dd2\u0dd9\u0db1\u0dca\u200d\u0dc0 \u0dc0\u0dda\u0db8\u0dca\u0d9a\u0dcf\u0dc0\u0dda\u0db8\u0dca\u0dc0\u0db0\u0dca\u200d\u0dca\u0dae\u0dcf\u0dc0\u0dda \u0dc0\u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1\u0dad\u0dc0\u0db6\u0dd0\u0d9a\u0dd0 \u0dc0\u0dda\u0db8 \u0db8 \u0dc0\u0db4\u0db1\u0dad\u0dca\u0dc0\u0dda\u0d9a\u0dcf\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dc0\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0db4\u0dad\u0dca\u0dc0\n\n17 18\n\n\u0db4\u0dc0\u0dbb\u0dca\u0dbd\u0dd2\u0dda\u0db8\u0dca\u0db1\u0dca\u0dd4\u0dca\u200d"
