b9f\u0ba4\u0bcd\u0ba4\u0bb0\u0ba3\u0bbf \u0b9f\u0bc6\u0bbf\u0bb3\u0bcd\u0baf\u0bc1.\u0b9f\u0bbf.\u0ba4\u0b9c. \u0ba4\u0b9a\u0ba9\u0bb5\u0bbf\u0bb0\u0ba4\u0bcd\u0ba9\n\n\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b8e\u0bb8\u0bcd.\u0b8e\u0bae\u0bcd.\u0b8e\u0bae\u0bcd. \u0bae\u0bc1\u0bb8\u0bcd\u0bb8\u0bc6\u0bbe\u0bb0\u0baa\u0bcd\n\n\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b9a\u0b9e\u0bcd\u0b9c\u0bc0\u0bb5 \u0b8e\u0ba4\u0bbf\u0bc6\u0bbe\u0bbf\u0bc8\u0bc6\u0bbe\u0ba9\u0bcd\u0ba9\n\n\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba8\u0bc6\u0bbe\u0bb2\u0b95 \u0bc6\u0ba3\u0bcd\u0b9f\u0bc6\u0bbe\u0bb0 \u0ba4\u0b95\u0bc6\u0bbe\u0b9f\u0bcd\u0ba4\u0b9f\u0ba4\u0b95\u0bc6\u0bbe\u0b9f The Hon. Lasantha Alagiyawanna The Hon. Anuradha Jayaratne The Hon. Sisira Jayakody, Attorney-at-Law The Hon. Shashindra Rajapaksa The Hon. W.D.J. Seneviratne, Attorney-at-Law The Hon. S.M.M. Muszhaaraff The Hon. Sanjeeva Edirimanna The Hon. Nalaka Bandara Kottegoda\n\n239 240"
