    "chunk_text": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d82\u0d9a\u0dcf \u0dbb\u0dd92\u0da7\u0dbb\u0dd2\u0dc1\u0dba\u0d9a\u0dd4 \u0d9a\u0da7\u0dbb\u0dd2\u0dc1 \u0ddd \u0dcf \u0dcf2\u0d9a\u0da7 \u0dad\u0dd4\u0dc5\u0dd4 2\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0dda \u0dad\u0dc1\u0db8 \u0db8\u0d9a\u0dcf\u0db1\u0dd4 \u0dc1\u0da9\u0dcf \u0dbb\u0dca\u0dbd 50\u0d9a\u0dca\u0dad \u0d85\u0dba \u0d9a\u0dd9 2\u0dcf. \u0dad\u0dd4\u0dc5\u0dd4 \u0dc1\u0dda\u0daf\u0dd3 \u0d86\u0dc0\u0dd3\u0db1\u0dca\u0dad 2 \u0dc1\u0dba\u0db1\u0dca\u0dad \u0da0\u0db4\u0dd2\u0dba\u0dbd\u0dcf 16,350\u0d9a \u0dd9\u0da2\u0dc1\u0d86 \u0dd4\u0dcf\u0dc0\u0dd3\u0db8\u0dd42\u0d9a\u0dca\u0dad \u0d94\u0dd4\u0dab \u0dc1\u0dd42\u0db1\u0dca\u0dad \u0db1 \u0dd1. \u0d91\u0dba \u0d85\u0dba \u0d9a\u0dd9\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0db8\u0db1\u0dca\u0dad\u0dc1\u0dc0\u0ddd\u0dad\u0dca\u0dc0\u0dd3\u0dcf\u0dc4\u0dd3 \u0d9a\u0dd9\u0db1\u0dca\u0dad . \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dcf\u0d82\u0d9a\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0dad \u0d9a\u0da7\u0dbb\u0dd2\u0dc1 \u0ddd \u0dcf \u0dcf2 \u0da7 \u0dba \u0d91\u0d9a 2\u0dad\u0dca2\u0db1\u0dca\u0dad \u0dad\u0db8\u0dba\u0dd2 \u0d92 \u0db1\u0dd3\u0dd2 \u0dba \u0dc1\u0dd4 \u0da7\u0da2\u0dda\u0dad\u0dca \u0dd2 \u0dc1\u0db6\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad. \u0d91\u0dba \u0dca\u0daf\u0dd2 \u0db8\u0dc1\u0d86\u0daf\u0dd3 \u0d9a\u0dca\u200d\u0dbb\u0db1\u0dca\u0d9a2 \u0dad\u0dc1\u0db8 \u0db8\u0d9a\u0dcf\u0db1\u0dd4 \u0dc1\u0da9\u0dcf \u0dbb\u0dca\u0dbd 700 \u0dc0\u0d9a\u0dca\u0dad2\u0dcf \u0dca\u0dcf\u0dc5 \u0dc0\u0da7\u0db8\u0dd3\u0db8\u0da7 \u0dc0\u0dd3\u0da7 \u0dc3\u0dd4\u0dda \u0d9a\u0dd9 \u0dd2 \u0dc1\u0db6 2\u0dcf. \u0d85\u0dc0\u0dd4 \u0da0\u0dd4\u0dc0 \u0dd4 \u0d9a\u0daf\u0dd3 \u0d85\u0db4\u0dd2 \u0d92 \u0dd4\u0dcf\u0dc0\u0dd3\u0db8\u0dd42 \u0dad2\u0dad\u0dca 2\u0da7\u0da9\u0dd2 \u0d9a\u0dd9 2\u0dcf. \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dcf\u0d82\u0d9a\u0dd2\u0d9a\u0dc1\u0dba\u0d9a\u0dca\u0dad\n\n\u0d9a\u0da7\u0dbb\u0dd2\u0dc1 \u0ddd \u0dcf \u0dcf2\u0d9a\u0da7 \u0dba 2\u0dcf \u0dda, \u0dad\u0dc1\u0db8 \u0db8\u0d9a\u0dcf\u0db1\u0dd4 \u0dc1\u0da9\u0dcf \u0dbb\u0dca\u0dbd 700\u0d9a\u0dca\u0dad \u0d94\u0dd4\u0dab \u0dc1\u0dd4\u0da2\u0dda\u0dba \u0dba\u0dd4\u0dd4 \u0da2\u0dda\u0db0\u0dd2\u0dba\u0da7 \u0db1\u0dd3\u0dd2 \u0dc0\u0dd3\u0dda\u0db4\u0dcf\u0dc0 \u0dba \u0d9a\u0dd9 2\u0dcf, \u0dd4 \u0da0 \u0d9a \u0dcf \u0dcf\u0dba\u0d9a\u0dd4\u0db8\u0db1\u0dd2. \u0d91\u0dc4\u0dd2 \u0d85\u0dd9\u0db8\u0dd4\u0dab, \u0d9a\u0da7\u0dbb\u0dd2\u0dc1 \u0ddd \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf2 \u0dcf\u0da7\u0d9a\u0dd2 \u0dad\u0dd9\u0dda \u0da2\u0dda\u0dc1\u0dda\u0dc1\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0dad\u0da7 \u0db4\u0db8\u0dab\u0d9a\u0dca\u0dad \u0dc3\u0dd3\u0db8\u0dcf \u0d9a\u0dd2\u0dd3\u0dad\u0db8\u0dba\u0dd2.\n\n\u0d92 \u0d85\u0db1\u0dd42 \u0dca\u0dbd\u0dcf\u0dd4 \u0dda \u0db4\u0dad\u0dca\u200d\u0dbb 10\u0d9a\u0dca\u0dad \u0dca\u0daf\u0dd2 \u0db8\u0db4\u0dad\u0dca2 \u0dad\u0dd2 \u0d85\u0dad\u0dd9, \u0d922\u0dcf \u0dc0\u0da7 \u0da7 \u0d85\u0dc0\u0dcf\u0dc5 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf2\u0dd2\u0dc1\u0d86 \u0da2\u0dda\u0da2\u0dda\u0db0 \u0d85\u0daf\u0dd2\u0dba\u0dd92 \u0db42\u0dd2 2\u0dcf. \u0d91 \u0db8\u0dd4\u0dd4\u0dc0 \u0dc0\u0da7 \u0da7 \u0d91\u0d9a\u0dd4\u0dc0 \u0db6 \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a\u0dca\u0dad \u0dc1\u0dcf\u0ddd \u0d85\u0dd4 \u0dd2 \u0db1\u0dca\u0dad \u0db6\u0dcf \u0daf\u0dd3 \u0dcf \u0da7\u0dcf\u0da7.\n\n\u0dc1\u0db8\u0dba\u0dd2\u0db1\u0dca\u0dad \u0d85\u0dc0\u0dcf\u0dc0\u0dd3\u0db8 \u0dc12\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad \u0da7\u0dcf\u0da7, \u0dc1\u0dda \u0db6 \u0db4\u0dad\u0dca\u200d\u0dbb 10\u0db8 \u0db6\u0dcf \u0dc1\u0dc0 2\u0dcf \u0d9a\u0dd2\u0dba \u0dcf. \u0dc1\u0dda \u0db4\u0dd2\u0db6\u0db3\u0db6\u0d9a \u0dc3\u0dd4\u0da2\u0dda \u0dcf \u0dc1\u0dc0\u0dd3\u0dcf\u0dba\u0dcf \u0db6\u0da7\u0dd3\u0dda \u0dd9\u0dcf\u0dc1\u0dd2\u0dba\u0d9a\u0dca\u0dad \u0d9a\u0dd9 \u0dcf, \u0d9a \u0da0\u0dab\u0dd4 \u0dd9\u0dcf\u0dc1\u0dd2\u0dba\u0d9a\u0dca\u0dad \u0dca\u0daf\u0dd2 \u0db8\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dd3\u0dad\u0dc1\u0db8\u0db1\u0dca\u0dad \u0db4\u0dc0\u0dd3\u0db8\u0dc1\u0dc0\u0dd3\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0db6 \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a\u0dca\u0dad \u0db6\u0dcf \u0dc1\u0dc0\u0db1\u0dca\u0dad\u0dc1\u0db1\u0dca\u0dad. \u0dcf\u0da7\u0db6\u0da7\u0dba\u0dd2, \u0dc0\u0da7 \u0da7 \u0d85\u0dc0\u0dd4 \u0da0\u0dd4\u0dc0 \u0dd4\u0dab \u0d9a\u0dca\u0dad \u0dd2 \u0dc0\u0dd3\u0db8\u0dc1\u0dc0\u0dd3\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc12\u0dca.\u0dd2 \u0db6 \u0db4\u0dad\u0dca\u200d\u0dbb \u0dcf\u0dad\u0dd9 \u0dcf\u0da7 \u0da0\u0dab\u0dd4\u0dc1\u0d9a\u0dcf\u0da7 \u0d9a\u0dd2\u0dbb\u0dd2\u0dd4\u0dc0 \u0db6 \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a\u0dca\u0dad \u0d85\u0db4\u0dd2 \u0dc0\u0da7 \u0da7 \u0d85\u0dd4 \u0dd2 \u0db1\u0dca\u0dad \u0db6\u0dcf \u0daf\u0dd3 \u0dcf \u0da7\u0dcf\u0da7, \u0dd4 \u0da0 \u0d9a \u0dcf \u0dcf\u0dba\u0d9a\u0dd4\u0db8\u0db1\u0dd2. \u0da2\u0dda\u0da2\u0dda\u0db0 \u0d85\u0daf\u0dd2\u0dba\u0dd92 \u0d92 \u0d9a\u0da7\u0dba\u0dd4\u0dd4 \u0dd2 \u0dc1\u0db6 2\u0dcf.\n\n\u0d9a\u0da7\u0dbb\u0dd2\u0dc1 \u0ddd 2\u0dba\u0dcf\u0db4\u0dcf\u0dd9\u0dba \u0dd4\u0db6\u0db3\u0db1\u0dca\u0dad 2 \u0d86\u0dc1\u0dba\u0ddd\u0da2 \u0dc1\u0db8\u0db1\u0dca\u0dad\u0db8 \u0dc0\u0dd3\u0d82\u0dd2\u0dcf\u0dd9\u0d9a \u0d86\u0d9a\u0dbb\u0dca\u0dbd\u0dc2\u0dab\u0dba \u0dc0 \u0db6 \u0dcf\u0dc1\u0db4\u0dcf\u0dc1\u0dd9\u0dcf\u0dad\u0dca\u0dd4 \u0dc12 2\u0dcf. \u0d9a\u0da7\u0dbb\u0dd2\u0dc1 \u0ddd \u0dc0\u0dd3\u0d9a\u0dcf\u0dcf\u0db8 \u0d85\u0db4 \u0dd9\u0da7\u0da7 \u0d91 \u0dc0\u0dd3\u0da7 \u0d9a\u0dd2\u0dba \u0dba\u0dd4\u0dd4 \u0dc0\u0dd3\u0d82\u0dd2\u0dcf\u0dd9\u0d9a\u0dba\u0db1\u0dca\u0dad \u0db4\u0dd2 \u0db8\u0dc0\u0dd3\u0d9a\u0dca\u0dad \u0dc0 \u0dbb\u0dd2\u0da7\u0dd2 2\u0dcf. \u0d922\u0dcf\u0da7 \u0dad\u0dd4\u0dc5\u0dad\u0dca \u0dc1\u0dda \u0db6\u0dd4\u0dc0 \u0dad2\u0dd4\u0dc0\u0dd9\u0da7\u0dad\u0dca \u0dca\u0dcf\u0dc5 \u0dc0\u0da7\u0db8\u0dd3\u0db8 \u0dd4\u0db6\u0db3\u0db1\u0dca\u0dad \u0dc1\u0dda\u0dc1\u0dd3\u0dba \u0dc0\u0dd3\u0dcf\u0dcf\u0dcf\u0d9c\u0dd2\u0dad\u0dca2\u0dba 2\u0da9\u0dcf\u0dad\u0dca \u0dc0\u0da7\u0da9\u0dd2 \u0dc1 \u0dc0\u0dd3 \u0dc3\u0dd3\u0db8\u0dcf \u0d9a\u0dd2\u0dd3\u0dad\u0db8\u0da7 \u0db6 \u0dcf\u0dc1\u0db4\u0dcf\u0dc1\u0dd9\u0dcf\u0dad\u0dca\u0dd4 \u0dc12 2\u0dcf. \u0dc1\u0db6\u0dcf\u0dc1\u0dcf\u0dcf\u0db8 \u0dc0\u0dd3\u0db8\u0dd4\u0dd2 \u0dba\u0dd2."
