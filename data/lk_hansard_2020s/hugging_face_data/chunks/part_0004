    "chunk_text": "2022 \u0dc0\u0dc3\u0db8\u0dbb\u0dca \u0d9c\u0dd2\u0db1\u0dca\u0daf\u0dbb\u0d9a\u0da7 \u0dc0\u0dd0\u0da7\u0dd3 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dbb\u0da7 \u0d89\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dda \u0db8\u0db8\u0db8\u0dc4\u0dba\u0dd4\u0dda \u0d85\u0db4 \u0db8\u0dbb\u0dda\u0d9a \u0d9a\u0dc5\u0dcf. 2021\u0da7 \u0dc0\u0da9\u0dcf 2022 \u0dc0\u0dc3\u0dbb \u0dba\u0dda \u0dba\u0dda \u0d9a\u0dcf\u0dbb\u0dab\u0dcf\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dba\u0dc4\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0dad\u0dca\u0dad\u0dcf. 2022\u0da7 \u0dc0\u0da9\u0dcf 2023 \u0dc0\u0dc3\u0dbb \u0dc4\u0dd0\u0db8 \u0d85\u0dad\u0dd2\u0db1\u0dca\u0db8 \u0dba\u0dc4\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0dad\u0dca\u0dad\u0dcf. 2024 \u0d8a\u0da7\u0dad\u0dca \u0dc0\u0da9\u0dcf \u0dba\u0dc4\u0db4\u0dad\u0dca \u0dc0\u0db1 \u0db6\u0dc0\u0da7 \u0db4\u0dd4\u0db8\u0dbb\u0ddd\u0d9a\u0dae\u0db1\u0dba \u0d9a\u0dbb \u0dad\u0dd2\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0dda \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0db8\u0dda\u0db8 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0d9c\u0dd2\u0db8\u0dba\u0ddc\u0dad\u0dca 2025 \u0d8a\u0da7\u0dad\u0dca \u0dc0\u0da9\u0dcf \u0dba\u0dc4\u0db4\u0dad\u0dca \u0db8\u0dc0\u0db1\u0dc0\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d91\u0db4\u0db8\u0dd2\u0db1\u0dca \u0d85\u0db4\u0da7 \u0dc3\u0dd1\u0dc4\u0dd3\u0db8\u0d9a\u0da7 \u0db4\u0dad\u0dca \u0db8\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0daf? \u0d85\u0db4 \u0dad\u0dc0\u0db8\u0dad\u0dca \u0daf\u0dca\u0dc0\u0dd2\u0db4\u0dcf\u0dbb\u0dca\u0dc1\u0dca\u0dc0\u0dd2\u0d9a \u0dc4\u0dcf \u0db6\u0dcf\u0dc4\u0dd2\u0dbb \u0dc0\u0dcf\u0dd2\u0da2 \u0db4\u0daf\u0db1\u0db8\u0db8\u0db1\u0dca \u0db6\u0dcf \u0d9c\u0dad\u0dca \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0dab\u0dba\u0d9a\u0dca \u0db8\u0d9c\u0dc0\u0db1\u0dca\u0db8\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db1\u0db8\u0dd4\u0dad\u0dca, \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc0\u0dba\u0dd4\u0dc4\u0d9c\u0dad\u0d9a\u0dbb\u0dab\u0db8\u0dba\u0db1\u0dca \u0db4\u0dc3\u0dd4 \u0d85\u0db4 \u0dab\u0dba \u0db8\u0d9c\u0dc0\u0dd3\u0dda \u0db8\u0dbb\u0dda\u0d9a \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0dab\u0dba \u0db8\u0d9c\u0dc0\u0db1\u0dca\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dc0\u0dcf\u0db8\u0dda\u0db8 \u0db8\u0da9\u0ddc \u0dbb\u0dca \u0d85\u0db4 \u0dc3\u0dad\u0dd4\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2.\n\n\u0d92 \u0dc0\u0dcf\u0db8\u0dda\u0db8 \u0d85\u0db8\u0dda \u0db8\u0daf\u0dcf\u0dba\u0db8 \u0dc4\u0dcf \u0dc0\u0dd2\u0dba\u0daf\u0db8 \u0d85\u0dad\u0dbb \u0dc3\u0db8\u0db6\u0dbb\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d85\u0db4 \u0d9a\u0da9\u0dd2\u0db1\u0dda \u0db4\u0dd2\u0dba\u0dc0\u0dbb \u0d9c\u0dad \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0d85\u0db8\u0dda \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0dc4\u0dd2 \u0dba \u0db6\u0dbb\u0db4\u0dad\u0dc5\u0dba\u0dd2. \u0db8\u0dda \u0dc0\u0dc3\u0db8\u0dbb\u0dca \u0dbb\u0da2\u0db8\u0dda \u0db8\u0daf\u0dcf\u0dba\u0db8 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dd2\u0dbd\u0dbd\u0dd2\u0dba\u0db1 4,127\u0dba\u0dd2. \u0dc0\u0dd2\u0dba\u0daf\u0db8 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dd2\u0dbd\u0dbd\u0dd2\u0dba\u0db1 6,978\u0d9a\u0dca. \u0db8\u0db8\u0dba\u0dd2\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dd2\u0dbd\u0dbd\u0dd2\u0dba\u0db1\n\n7 8\n\n[\u0d9c\u0dbb\u0dd4 \u0dbb\u0db1\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dd2\u0dd0\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dcf]\n\n2024 \u0db8\u0db4\u0db6\u0dbb\u0dc0\u0dcf\u0dbb\u0dd2 07\n\n2,651\u0d9a\u0dca \u0dc0\u0dd2\u0dba\u0daf\u0dda \u0db8\u0dc0\u0db1\u0dca\u0db8\u0db1\u0dca \u0db8\u0db4\u0ddc\u0dbd\u0dd3 \u0db8\u0d9c\u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dba\u0dd2. \u0d85\u0db8\u0dda \u0dab\u0dba \u0d9a\u0db1\u0dca\u0daf\u0dbb \u0dcf\u0dcf\u0db8\u0dda \u0db6\u0dbb \u0d91\u0dba\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0dd2\u0dbd\u0db9\u0dd4 \u0db8\u0dc0\u0db1\u0dc0\u0dcf.\n\n\u0d91\u0d9a\u0dca\u0daf\u0dc4\u0dc3\u0dca \u0db1\u0dc0\u0dc3\u0dd2\u0dba \u0db4\u0db1\u0dc3\u0dca \u0d9c\u0dab\u0db1\u0dca\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db4\u0dc3\u0dca\u0db8\u0dc3\u0dda \u0d85\u0db4\u0dd2 \u0d9a\u0db8\u0dc5\u0dda \u0dab\u0dba \u0db8\u0dc0\u0db1 \u0d91\u0d9a. \u0dc4\u0dd0\u0db8 \u0db8\u0daf\u0dca\u0da7\u0db8 \u0dab\u0dba \u0d9c\u0db1\u0dca\u0db1 \u0d91\u0d9a. \u0db4\u0dcf \u0d9a\u0dba\u0db1\u0dd4\u0dad\u0dca \u0dab\u0dba \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0dc0\u0dd4\u0dab\u0dcf. \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0dad\u0dca \u0db8\u0dda \u0dab\u0dba \u0db8\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba\u0da7\u0db8 \u0dc4\u0dd0\u0da9 \u0d9c\u0dd0\u0dc4\u0dd4\u0dab\u0dcf. \"\u0dc4\u0dcf\u0dbd\u0dca \u0db1\u0dd2\u0d9a\u0dda \u0db8\u0daf\u0db1\u0dc0\u0dcf, \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0dd2\u0dbd \u0da7 \u0dc3\u0dc4\u0db1 \u0db8\u0daf\u0db1\u0dc0\u0dcf, \u0db4\u0da9\u0dd2 \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0dbb\u0da2\u0db8\u0dda \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0d9a\u0dca\u0dc2 \u0d9c\u0dab\u0db1\u0dca \u0db8\u0daf\u0db1\u0dc0\u0dcf\"; \u0d94\u0db1\u0dca\u0db1 \u0d94\u0dba \u0dc0\u0dcf\u0db8\u0dda \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0db8\u0db4\u0ddc\u0db8\u0dbb\u0ddc\u0db1\u0dca\u0daf\u0dd4 \u0daf\u0dd3 \u0dcf \u0db6 \u0dba\u0da7 \u0db4\u0dad\u0dca \u0dc0\u0dd4\u0dab\u0dcf\u0db8 \u0d92\u0dc0\u0dcf \u0d89\u0dc2\u0dca\u0da7 \u0d9a\u0db8\u0dc5\u0dda \u0dab\u0dba \u0db8\u0dc0 \u0dcf. \u0db8\u0db8\u0db1\u0dca\u0db1 \u0db8\u0dda \u0dab\u0dba \u0db8\u0dcf\u0db1\u0dc3\u0dd2\u0d9a\u0dad\u0dca\u0dc0\u0db8\u0dba\u0db1\u0dca \u0d85\u0db4 \u0d85\u0dad\u0dca \u0db8\u0dd2\u0db8\u0daf\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0dab\u0dba \u0db8\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0db8\u0dba\u0db1\u0dca \u0d9c\u0dd0 \u0dc0\u0dd4\u0db8\u0dda \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda \u0db8\u0dda \u0dbb\u0da7\u0da7 \u0d85\u0db1\u0dcf\u0d9c\u0dad\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0dc4\u0da7 \u0daf\u0dc0\u0dc3\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d91\u0db8\u0dc4\u0db8 \u0db1\u0dda, \u0d85\u0db4 \u0dab\u0dba \u0db8\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0db8\u0dba\u0db1\u0dca \u0db8\u0dd2\u0daf\u0dd3, \u0d85\u0db4\u0da7\u0db8 \u0d9a\u0dd2\u0dba\u0dcf \u0dc1\u0d9a\u0dca\u0dad\u0dd2\u0db8\u0dad\u0dca \u0db8\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba\u0d9a\u0dca \u0db8\u0d9c\u0ddc\u0da9 \u0db1\u0dd0\u0d82\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db8\u0dc0\u0db8\u0dc4\u0dc3\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2.\n\n\u0d85\u0db4\u0db1\u0dba\u0db1 \u0db8\u0daf\u0dcf\u0dba\u0dda \u0dc3\u0dc4 \u0dc0\u0dd2\u0db8\u0daf\u0dca\u0dc1 \u0db8\u0db8\u0dba\u0ddd\u0da2\u0db1 \u0d9a\u0da9\u0dd2\u0db1\u0db8\u0dd2\u0db1\u0dca \u0d89\u0dc4\u0dc5 \u0db1\u0dd0\u0d82\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0d85\u0dad\u0dba\u0dc0\u0dc1\u0dba \u0db8\u0dc0\u0db1\u0dca\u0db8\u0db1\u0dca \u0db8\u0db8\u0db1\u0dca\u0db1 \u0db8\u0dda \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dc3\u0dcf\u0d9a\u0dca\u0dc2\u0dcf\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7\u0dba\u0dd2. \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0dba \u0db4\u0daf\u0db1\u0db8 \u0dc3\u0d9a\u0dc3\u0db8\u0dd2\u0db1\u0dca, \u0db8\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0dd0\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0d9c\u0dab\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0daf\u0dd0\u0db1\u0dca \u0d85\u0db4 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dcf. \u0d91\u0dc4\u0dd2 \u0d85\u0dc0\u0dc3\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd \u0dba \u0dad\u0dbb\u0d9c\u0d9a\u0dcf\u0dbb\u0dd2 \u0db8\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba\u0d9a\u0dca \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0dba \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dba\u0dd2. \u0da9\u0dd2\u0da2\u0dd2\u0da7\u0dbd\u0dca \u0db8\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba\u0d9a\u0dca \u0db8\u0d9c\u0ddc\u0da9 \u0db1\u0dd0\u0dd0\u0d82\u0dc0\u0dd3\u0db8\u0dba\u0dd2. \u0dc4\u0dbb\u0dd2\u0dad \u0db8\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba\u0d9a\u0dca \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dba\u0dd2. \u0db8\u0dda \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dbd\u0dd2\u0db8\u0dda \u0db8\u0dd6\u0dbd\u0dd2\u0d9a \u0d9c\u0dd4\u0dab\u0dcf\u0dd0\u0d82\u0d9c \u0db8\u0dc0\u0db1\u0dca\u0db8\u0db1\u0dca \u0daf\u0dd6\u0dc2\u0dab\u0dba \u0dad\u0dd4\u0dbb\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0dc3\u0db8\u0dcf\u0da2 \u0db1\u0dc0\u0dd3\u0d9a\u0dbb\u0dab\u0dba\u0dba\u0dd2."
