01c \u0dca\u0da7 \u0dca \u0dcf\u0db8\u0dba\u0dcf\u0db8\u0dba \u0d85\u0dba\u0daf\u0dbd\u0dca\u0dca\u200d (\u0dc4\u0d82\u0dc4\u0dda\u0dae\u0db8\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dca\u200d\u0d82\u0dcf\u0db8 \u0dca\u0dd4 \u0dc3\u0d9a\u0dc4\u0dda\u0dc3 \u0dc4\u0d82\u0d9c\u0db1 (\u0dc4\u0d82\u0dc4\u0dda\u0dae\u0db8\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca (\u0dc4\u0d82\u0dc1 \u0ddd \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dca\u0db8\u0dca\u200d\u0db8\u0dba\u0ddd\u0dc0\u0dd2\u0db0\u0dd2 \u0dc0\u0dbb\u0dca\u0dbd \u0dc4\u0db8\u0dd2\u0dad\u0dd2 (\u0dc4\u0d82\u0dc4\u0dda\u0dae\u0db8\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0dc4\u0db1\u0db8\u0db0\u0dd2 \u0dca\u200d\u0dbb\u0d86\u0db8 \u0dc4\u0d82\u0dc0\u0dbb\u0dca\u0dbd \u0db4\u0dca \u0db1 (\u0dc4\u0d82\u0dc4\u0dda\u0dae\u0db8\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0dc4 \u0dca\u0dc4\u0dda\u0dc4 \u0db8 \u0dc1\u0dca\u0dde\u0daf\u0dca \u0dc4\u0d82\u0dd2\u0dbb \u0db8 (\u0dc4\u0d82\u0dc4\u0dda\u0dae\u0db8\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u201d \u0db4 \u0dad\u0dca \u0dc1\u0dcf\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca\u0dc4\u0dd2 \u0dc4 \u0dad\u0dd2\u0dcf \u0dc4\u0da7 \u0db0 \u0dcf\u0dba \u0dca\u200d\u0dca \u0dca\u0dc0 \u0dca\u0db0\u0dc0\u0dd4\u0d9a \u0dcf\u0dd4\u0db1\u0dd4\u0dad\u0dca\u0dc1\u0dad\u0db8\u0dd2."
