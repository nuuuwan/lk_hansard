    "chunk_text": "\u0d85\u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dca \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0dc3\u0dd0\u0dbd\u0dd4\u0d9a\u0dca \u0dc4\u0dcf \u0d85\u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dca \u0dc3\u0dbb\u0dc0\u0d9a\u0db0\u0dca\u200d\u0db1 \u0dc0\u0dba\u0dcf\u0db4\u0dd2\u0dad\u0dd2 \u0dc1\u0dc4\u0dae\u0dad\u0dd4\u0db8\u0dc1\u0dc0\u0db1\u0dca \u0d85\u0daf \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0d9a\u0dd4\u0d9a\u0d9a\u0dbb\u0dc1 \u0db1\u0dcf\u0dba\u0dba\u0dd1\u0dca \u0dad\u0dca \u0dca \u0dc0\u0dba \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dc1 \u0d9a\u0dc0\u0dbb\u0daf\u0dcf\u0da7\u0dca \u0dc0\u0dcf\u0dcf \u0d8b\u0d9c\u0dca\u200d\u0dbb \u0dc0\u0db1 \u0dc3\u0dae\u0dc0\u0dcf\u0dcf\u0dc0\u0dba\u0d9a\u0dca\u0dc2 \u0dc1\u0db4\u0db1\u0dca\u0db1\u0dd4\u0dca \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0dc1\u0db6\u0daf\u0db1\u0dc0\u0dcf1 \u0dc0\u0dd2\u0dc1 \u0dae\u0dc2\u0dca\u200d\u0dc1\u0dba\u0db1\u0dca \u0d85\u0daf \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0db6\u0daf\u0dd4 \u0dca\u0dbd \u0dd2\u0db1\u0dc3\u0dae\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dc2\u0d9a\u0dc1 \u0db1\u0dcf\u0dba\u0dba\u0dd1\u0dca \u0dc1\u0dc4\u0dae\u0dad\u0dd4\u0db8\u0dc1\u0dc0\u0db1\u0dca \u0daf\u0dc4\u0dc3\u0dae \u0d9c\u0dab\u0db1\u0d9a\u0dca\u0dc2 \u0dba\u0db4\u0daf\u0dcf\u0dc0\u0da7 \u0db4\u0dca \u0dc0 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dcf1 \u0dc3\u0db8\u0dc4\u0dbb \u0db4\u0dc0\u0dd4\u0dca \u0dad\u0db8 \u0da5\u0dcf\u0dad\u0dd2 \u0dc4\u0dd2 \u0dad\u0dc0\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dc1 \u0dc1\u0d9c\u0dc0\u0dca\u0dc0\u0dbd \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0dbd\u0dd2\u0d9a\u0dc0 \u0dbb\u0dd0\u0db3\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0d85\u0dad\u0dbb, \u0dad\u0dc0\u0dca \u0db4\u0dc0\u0dd4\u0dca \u0dc3\u0dd2\u0dba \u0d9c\u0dab\u0db1\u0dcf\u0dc0\u0d9a\u0dca\u0dc2 \u0d85\u0dc0\u0dad\u0dd0\u0db1\u0dca \u0d9a\u0dc0\u0dc0\u0dd4\u0dbb\u0dd4\u0dc0\u0dbd \u0dbb\u0dd0\u0db3\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dcf1 \u0dc1\u0dca \u0db1\u0dcf\u0dba\u0dba\u0dd1\u0dca \u0db4\u0dca\u200d\u0dbb \u0dae\u0db1\u0dba \