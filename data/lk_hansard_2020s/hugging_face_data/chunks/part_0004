    "chunk_text": "\u0db8\u0dd6\u0dbd\u0dca\u200d\u0db8\u0dc4 \u0db8\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db1\u0db0\u0dd3\u0dad\u0dd4\u0db1\u0dd2\u0dba \u0d8a\u0dc5\u0d9f\u0da7 \u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0db1\u0db8 \u0db1 \u0dca\u0dd4\u0d82\u0d9a\u0dd4 \u0d85\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dba \u0db8 \u0dc4 \u0db1 \u0db8 \u0dcf\u0db8\u0dab\u0dca\u0da9\u0da9\u0db8\u0d9c\u0db8\u0dba \u0dc1 \u0dc3\u0dcf\u0db8\u0dca\u0dc0\u0dba \u0db8 \u0db4\u0dad\u0dca \u0dc0\u0dd4\u0dba\u0db8. \u0d94\u0dc0\u0dd4\u0db0 \u0d9a\u0db4\u0dd4 \u0d9c\u0db1\u0db0 \u0dc1\u0db1\u0db8\u0dcf\u0dca \u0dcf\u0dc1\u0dc5\u0dda? \u0d94\u0dc0\u0dd4\u0db0 \u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dca\u200d\u0dca\u0db8 \u0dca\u0dc0\u0dc4\u0dda 3\u0d9a\u0dca\u0dc2 \u0db0 \u0dcf\u0dd2\u0db0 \u0dc1\u0db8\u0dca \u0dba\u0da7 \u0dca\u0d82\u0dc1\u0dcf\u0db8\u0dc1\u0dca\u200d\u0db8\u0dad\u0dca \u0d9a\u0dd2 \u0dca\u200d\u0db8 \u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dcf\u0dc5\u0db8. \u0d85\u0dd4 \u0d9c\u0dba\u0dc1\u0db0 \u0d92 \u0d9c\u0dd4 \u0db4\u0db8\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db0\u0dad\u0dd4\u0dc0\u0da7\u0dc0\u0dad\u0dca \u0dca\u0dd4\u0dd4\u0d9a\u0db8\u0dca \u0dd4\u0db0\u0dc1\u0db0 \u0dd4 \u0dd4. \u0d92\u0dcf \u0dd2\u0dba \u0dc1\u0dca \u0d9a\u0dca\u0dc2 \u0dca \u0dc0\u0dd4\u0dbb\u0dd0 \u0dc0 \u0dc1\u0dca \u0d9a\u0dca\u0dc2 \u0dca \u0d9a\u0dd2 \u0d91\u0dcf \u0db4\u0dd2\u0dd2\u0db6\u0dca\u0dc0\u0dc0 \u0dc1\u0db8\u0dca \u0dba\u0dc1\u0dc3 \u0dd2\u0dbb\u0dc0\u0db8\u0dca \u0d9a\u0dca\u0dc2 \u0dad\u0dd2\u0db6\u0dd4\u0dba\u0db8. \u0db1 \u0db8 \u0dcf\u0db8\u0dab\u0dca\u0da9\u0da9\u0db8\u0d9c\u0db8\u0dba\u0dc1\u0dad \u0dc1 \u0dc3\u0dcf\u0db8\u0dca\u0dc0\u0dba \u0db8 \u0dc1\u0db8\u0dca \u0db4\u0db8\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0db8\u0dca\u0db0\u0dad\u0dd4\u0dc1 \u0dcf\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0dcf\u0da7 \u0d87\u0dd2\u0dbb \u0dc3\u0dca\u200d\u0db8 \u0d9a\u0dd2 \u0dc0\u0db8 \u0dba\u0da7 \u0dca\u0d82\u0dc1\u0dcf\u0db8\u0dc1\u0dca\u200d\u0db8\u0dad\u0dca \u0d9a\u0dd2 \u0dca\u200d\u0db8 \u0d85\u0db4\u0dd2 \u0d9a\u0dd2 \u0dc1 \u0dd4 \u0dd4 \u0d9a\u0dd2 \u0dca\u200d\u0db8. \u0d92 \u0d9a\u0dd2 \u0db0\u0dc1\u0db0 \u0d94\u0dc4\u0dd4\u0dc1\u0dda \u0dca\u0dc0\u0dad \u0dca\u0db0 \u0dc0\u0db8 \u0dca\u0d82\u0dc1\u0dcf\u0db8\u0dc1\u0dca\u200d\u0db8\u0dad\u0dca \u0dca\u0dc0 \u0dca\u200d\u0dbb\u0dcf\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db1 \u0dd2\u0dba\u0dc4\u0db8 \u0d85\u0dc1 \u0dc3 \u0dba\u0da7\u0da7 \u0db8\u0dd2\u0dba \u0d9a\u0dca\u0dc2 \u0dc3\u0dd2\u0dd4 \u0dc1\u0dc0\u0dca\u200d\u0db8 \u0dad\u0dd2\u0dc1\u0dca \u0dc0\u0db8 \u0d9a\u0dd2 \u0dca\u200d\u0db8. \u0d92 \u0dc0\u0db8\u0dc1\u0dda\u0db1 \u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0db1\u0db8 \u0db1 \u0dca\u0dd4\u0d82\u0d9a\u0dd4 \u0d85\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dba \u0db8 \u0dd2\u0dbb\u0dc3\u0dd2\u0db0 \u0db4\u0dc3\u0dd4\u0dd2\u0dab \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dd4 \u0dc1\u0dca\u0dcf \u0dad\u0dd2\u0dc4\u0dda\u0dc1\u0dc4\u0dda \u0dc1\u0d9c \u0dd2\u0dab \u0dc0\u0dd4\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dc0\u0dc5 \u0dc0 \u0db8 \u0dca\u0dd4\u0dbd\u0dd4\u0dc1\u0dc0\u0db8\u0dad\u0dca \u0d91 \u0dc1\u0db8\u0dca \u0dba\u0dc1\u0dc3 \u0db1 \u0db8 \u0dd2\u0dbb \u0db8 \u0d9a\u0dca\u0dc2 \u0d87\u0dad\u0dd2 \u0dcf\u0dba\u0db4\u0dd4 \u0dc0\u0dd4\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dc0\u0dc5\u0d9a\u0dca\u0dc2 \u0d9a\u0dd2 \u0d91\u0dcf \u0db1\u0db1 \u0db4\u0dd4 \u0dd4 \u0dc0\u0dd2\u0dc0\u0db1 \u0d9a\u0dd2 \u0dc0\u0db8.\n\n\u0dca\u0dc0. \u0dc4\u0db1 \u0dba \u0d92\u0dc0\u0db8 \u0dc4\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dbd\u0dba\u0dc1 \u0db0\u0db1 \u0dc0 \u0dca\u200d\u0db8 \u0dca\u0db8\u0dca\u200d\u0db8. \u0dc4\u0db1 \u0dba \u0dc0\u0dba\u0db8\u0db4\u0db8\u0dba \u0dcf\u0dba\u0dc1\u0d9c \u0db0 \u0dca\u0dd4\u0dd2\u0dba\u0dc0 \u0d85 \u0dc3\u0dca\u200d\u0db8\u0dc1\u0d9c \u0d89\u0db0 \u0dc0\u0db8 \u0dc1\u0db1\u0db8\u0dcf\u0d9a\u0dca\u0dc2\u0dca \u0d9a\u0dbb\u0dca\u0dbd\u0dd2\u0dcf \u0da7 \u0dc1\u0dc0\u0db0\u0dc1\u0db0 \u0d9a\u0dd2 \u0dca\u200d\u0db8 \u0dca\u0dca\u200d\u0db8\u0dc1\u0d9c . \u0d91\u0dad\u0dc1\u0dcf\u0db8\u0da7 \u0dc1\u0db8\u0dca \u0dc0\u0dba\u0db8\u0db4\u0db8\u0dba \u0d9a\u0dc1 \u0dad\u0dca \u0dc1\u0d9c\u0db8\u0da9 \u0d9c\u0db0 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db0\u0dca?\n\n\u0db8\u0dd6\u0dbd\u0dca\u200d\u0db8\u0dc4 \u0db8\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db1\u0db0\u0dd3\u0dad\u0dd4\u0db1\u0dd2\u0dba \u0dc0\u0dba\u0db8\u0db4\u0db8\u0dd2\u0dba\u0dcf\u0dc1 \u0d9a\u0dca\u0dc2 \u0d9a\u0dd2 \u0db0\u0dc1\u0db0 \u0d89\u0dad\u0db8\u0db1 \u0dc0\u0d9a \u0db8 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dca\u200d\u0dc1 \u0d9a\u0dca\u0dc2. \u0dc1\u0db8\u0dca \u0daf\u0dbd\u0dc5\u0dd4 \u0dba\u0da7\u0da7\u0db1 \u0dc0\u0dba\u0dc0\u0dc4\u0db8 \u0dcf \u0db0 \u0dc1\u0dca\u0dca\u200d\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8 \u0db4\u0dba\u0dc4\u0dda\u0dca\u0db8 \u0dcf\u0da7 \u0d85\u0dd4 \u0dc4\u0d82\u0d9b\u0dba\u0db8\u0dc0\u0d9a\u0dca\u0dc2 \u0dad\u0db1\u0dd2 \u0d89\u0db0\u0dc1\u0db0. \u0dc0\u0dba\u0dc0\u0dc4\u0db8 \u0dcf\u0dc1 \u0d9a\u0dca\u0dc2 \u0dd2\u0dba\u0dcf\u0db8\u0dca \u0dca\u0db0 \u0dca\u0dd4 \u0dd4. \u0dc1\u0dca\u0db8\u0dc1 \u0db8\u0db1 \u0d85\u0db1\u0db8\u0dbb\u0dd4\u0dc1\u0dc0\u0db0 \u0dc1\u0dca\u0db8\u0dc1 \u0db8\u0db1 \u0d8b\u0dad\u0dca\u0dc4\u0db8 \u0dc1 \u0db0 \u0dad\u0db1\u0dd2 \u0d92 \u0db8\u0dd2\u0dd2\u0dba\u0dc4\u0dda\u0dc3\u0dd4 \u0d8b\u0da9\u0da7 \u0d91\u0db0\u0dc1\u0db0. \u0d92 \u0db8\u0dd2\u0dd2\u0dba\u0dc4\u0dda\u0dc3\u0dd4\u0db0\u0da7 \u0dc1\u0db8\u0dca \u0dd2\u0dbb\u0db0\u0dd2 \u0da7 \u0d9c \u0dca\u200d\u0db8 \u0dc0\u0dc3\u0da7\u0dca\u200d\u0db8 \u0d8a\u0da7 \u0db4\u0dc4\u0dda\u0dc1\u0dc4\u0dda \u0dca\u0dd4\u0d82\u0d9a\u0dd4 \u0db4\u0daf\u0dca \u0dad\u0dd2 \u0dba \u0db8 \u0d92 \u0db8\u0dd2\u0dd2\u0dba\u0dc4\u0dda\u0dc3\u0dd4\u0db0\u0dc1\u0dda \u0dc1\u0daf\u0dca\u0db4\u0dc5 \u0dd2\u0dbb\u0d9a\u0dd4\u0dba\u0db8 \u0dca\u0db8 \u0dc0\u0db8 \u0db8\u0dca \u0dc1\u0dc0\u0db0\u0dc1\u0daf\u0dca\u0dc3\u0dd2 \u0dcf\u0dba\u0dca\u200d\u0db8 \u0dca\u0db8 \u0dc0\u0db8 \u0db8\u0dca \u0db4\u0dba\u0db8\u0dc1\u0dc3 \u0db1\u0dd3\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0db8\u0dad\u0dca\u0db1\u0dcf \u0dcf\u0dba \u0dc0\u0db8 \u0db8\u0dca \u0d92\u0dcf \u0dc1\u0db1\u0db8 \u0dad\u0dba\u0db8\u0dca \u0dc1\u0dca\u200d\u0db8\u0d9a\u0dd4 \u0d85\u0db4\u0dba\u0db8 \u0d9a\u0dca\u0dc2\u0dca? \u0d91\u0dad\u0dc1\u0dcf\u0db8\u0da7 \u0dc1\u0db8\u0dca \u0db1 \u0dca\u0dd4\u0d82\u0d9a\u0dd4 \u0d85\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dba \u0db8 \u0d85\u0dca \u0db4\u0dba\u0db8\u0dc1\u0dc3 \u0d9a\u0dca\u200d\u0dbb\u0db1 \u0da7 \u0dc1\u0daf\u0dca\u0db4\u0dc5 \u0dd2\u0dbb\u0d9a\u0dd2 \u0dc1\u0dba \u0dc0\u0dba\u0db8\u0db4\u0db8\u0dd2\u0dba\u0dcf \u0db0 \u0d9c\u0dd4 \u0d9a\u0dd2\u0dc3\u0dd2\u0db1 \u0d85\u0dd4\u0d9a\u0dcf\u0db8\u0dca\u0db4\u0db8\u0dc0\u0d9a\u0dca\u0dc2 \u0dca\u0d9a\u0dca\u0dc2\u0dc0\u0db0\u0dc1\u0db0 \u0dd4 \u0dd4. \u0d8a\u0dc1\u0dad-\u0dc1\u0db4\u0dc1\u0dbb\u0dca\u0dbd\u0dca\u0db8 webinar \u0d91\u0dcf\u0dcf\u0da7 \u0d87\u0dd2\u0dbb \u0dc3\u0dca\u200d\u0db8\u0dad\u0dca \u0d94\u0dc4\u0dd4 \u0dd2\u0dbb \u0db8\u0da9\u0dd2 10\u0d9a\u0dca\u0dc2 \u0d89\u0dc0\u0dca\u200d\u0db8 \u0dcf\u0dae\u0db8 \u0dcf\u0dba\u0dca\u200d\u0db8 \u0dd4\u0db1\u0dca\u0da7\u0dca\u200d\u0db8 \u0dc0\u0db8. \u0d91\u0dc1 \u0db1 \u0dcf\u0dba\u0db0 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db0\u0dca \u0db1 \u0dca\u0dd4\u0d82\u0d9a\u0dd4 \u0d85\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0 \u0dba\u0dc1 \u0d9a\u0dd4\u0da7? \u0dc1\u0db8\u0dca \u0dca\u200d\u0dbb \u0dda \u0dc0\u0dad\u0dca \u0d94\u0dc4\u0dd4 \u0dc1\u0dad\u0dca\u0dbb\u0dd4\u0db8\u0dca \u0d9c\u0db0 \u0dd1 . \u0dc1\u0db8\u0dca \u0db8\u0dd2\u0dd2\u0dba\u0dc4\u0dda\u0dc3\u0dd4\u0db0\u0dc1\u0dda \u0dc1\u0daf\u0dca\u0db4\u0dc5 \u0dd2\u0dbb\u0d9a\u0dd4\u0dba\u0dca\u200d\u0db8 \u0dc1\u0db8\u0dca \u0db8\u0dd2\u0dd2\u0dba\u0dc4\u0dda\u0dc3\u0dd4 \u0dd2\u0dbb \u0db8 \u0dcf\u0dba\u0dca\u200d\u0db8 \u0dca\u0dd4\u0db8\u0dca\u0db1\u0db8\u0db1 \u0d89 \u0dc0\u0dd2\u0dba \u0da7 \u0dc1\u0db8\u0dca \u0dba\u0dc1\u0dc3 \u0d9a\u0dbb\u0dca\u0dbd\u0dd2\u0dcf \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db8\u0dc1\u0d9c \u0db0\u0dc1\u0db0 \u0dc1\u0dcf\u0db8\u0dc1 \u0db8\u0db1\u0dca? \u0dc1\u0db8\u0dca \u0dba\u0dc1\u0dc3 \u0d9a\u0dbb\u0dca\u0dbd\u0dd2\u0dcf \u0d9a\u0dca\u0dc2\u0dad\u0dd2\u0db1\u0dad\u0dca \u0dcf\u0dba\u0db0\u0dc1\u0db0 \u0dc1\u0dcf\u0db8\u0dc1 \u0db8\u0db1\u0dca? \u0dc1\u0db8\u0dca \u0dba\u0dc1\u0dc3 \u0d9a\u0dbb\u0dca\u0dbd\u0dd2\u0dcf \u0dc4\u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dcf\u0dba\u0db0\u0dc1\u0db0 \u0dc1\u0dcf\u0db8\u0dc1 \u0db8\u0db1\u0dca \u0d9a\u0dd2 \u0d91\u0dcf \u0db4\u0dd2\u0dd2\u0db6\u0dca\u0dc0\u0dc0 \u0dc1\u0dad\u0dca\u0dbb\u0dd4\u0db8\u0dca \u0d9c\u0db0 \u0dca\u0dd4\u0dd2\u0dba \u0dd2\u0dba\u0dca\u200d \u0db8\u0dd2\u0dba\u0db0 \u0dad\u0db1\u0dd2 \u0d85\u0dca \u0d85\u0db4\u0da7 \u0d89\u0db0\u0dc1\u0db0."
