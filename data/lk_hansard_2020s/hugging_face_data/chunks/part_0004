u0db1\u0dd4 \u0dca\u200d\u0dd0\u0db6\u0dd2 \u0dc4\u0dd0\u0d9a\u0dd2 .\n\n2024 \u0da2\u0db1 \u0dc1\u0dd2 54\n\n26 \u0daf\u0dbb\u0db1 \u0dd2\u0dbb \u0dcf \u0dd2\u0dbb\u0daf\u0dba\u0dc1\u0dca\u200d \u0db4\u0db1\u0dad \u0da7\u0dc1\u0dad\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4 \u0db1 \u0dca\u200d\u0daf \u0db8\u0dca \u0dd2\u0dbb \u0dcf \u0dd2\u0dbb\u0daf\u0dba\u0dc1\u0dca\u200d \u0d9a\u0dca \u0d85\u0daf\u0dc4\u0dc4\u0dcf \u0dc1 . (3) (\u0dd2\u0dbb\u0dc1 \u0dda\u0dc2\u0da5\u0db4\u0dad\u0dc1 \u0d87\u0dad\u0dd2 \u0dd2\u0dba \u0dcf\u0da0\u0dd2\u0dad \u0d9a\u0dca\u0dc1\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb \u0dca \u0dc4\u0dd0\u0dca\u200d\u0d9a\u0dd2 \u0dc0\u0dca\u200d\u0da7 \u0dc1\u0dab\u0db1 (2 \u0db1 \u0dda\u0db4 \u0dab\u0dca \u0dad\u0dd2 \u0da7\u0dc1\u0dad\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dca\u200d\u0daf \u0dd2\u0dba\u0dca\u200d\u0db0\u0dbb \u0d9a\u0dd4 \u0dd2\u0dbb\u0dc3\u0dd2\u0dca \u0dc4\u0db4\u0dd4\u0dbb\u0dc1\u0dca\u200d\u0db1\u0dd4 \u0dca\u200d\u0dd0\u0db6\u0dd3\u0db8\u0da7 \u0dd2\u0dba \u0db8 \u0d9a\u0dbb\u0db1 \u0dca\u200d\u0daf \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc4\u0dc4 \u0db4\u0dc5\u0db4\u0dd4\u0dd4\u0dc0\u0dda\u0daf \u0dc4\u0dc4 \u0d94\u0dc0\u0dd4\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0d86\u0d9a\u0dc1\u0dbb \u0dc4\u0dc4 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc1 \u0daf \u0dc4\u0dc4 \u0d92 \u0dd2\u0dba\u0dca\u200d\u0db0\u0dbb \u0dc1 \u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0dc1\u0d9a\u0ddc\u0dca \u0dc1\u0dda\u0dc3\u0dd2 \u0dd2\u0dba\u0dc1 \u0ddd\u0dab \u0db8\u0db1\u0dca\u0dca \u0dd2\u0dba \u0db8 \u0d9a\u0dbb\u0db1\u0dd4 \u0dca\u200d\u0db3\u0db1 \u0db4\u0dd2\u0daf\u0dd2 \u0dd2\u0dbb \u0dba\u0dd4\u0dad\u0dd4 .\n\n(4) \u0dc1\u0db8\u0dca \u0db4\u0db1\u0dad \u0da7\u0dc1\u0dad\u0dca \u0db1 \u0dd2\u0dbb\u0db8\u0dbb\u0dca \u0db1 \u0d9a \u0d9a\u0dc1\u0dbb\u0dca \u0dc4 \u0dc4\u0dc1 \u0dc1\u0d9a\u0ddc\u0db8\u0dd2\u0d9a\u0dc2\u0dca \u0dc4\u0db7\u0dc1 \u0da7 \u0dc4\u0dc4\u0dc1 \u0dd3\u0db8\u0db8\u0da7 \u0d9a\u0dd0 \u0db1\u0dd4 \u0dca\u200d\u0db3\u0db1 \u0dd2\u0dbb\u0dc1 \u0dda\u0dc2\u0da5\u0db4 \u0d9a\u0dd4\u0da7-\n\n(\u0d85 \u0dda\u0db4\u0dc1\u0db4\u0ddc\u0dd2\u0db1\u0dc4\u0dcf \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0d9a \u0dbb \u0d9a\u0dd4\u0dc1\u0dda \u0dd2\u0dba\u0dca\u200d \u0da7 \u0dc1\u0db1\u0ddc\u0d85\u0da9\u0dd4 \u0dd2\u0dba\u0dca\u200d \u0d9a \u0dc1\u0db4\u0ddc\u0dd2\u0db1\u0dc4\u0dcf \u0dd2\u0dba\u0dca\u200d\u0db0\u0dbb \u0d9a\u0dd4 \u0dc4\u0db8\u0d9f \u0db8\u0dca \u0db4\u0dd2\u0dbb \u0d9a\u0da7 \u0d87\u0dad\u0dd4\u0dc5\u0dd4\u0dd3\u0db8\u0db8\u0da7 (\u0d86 \u0db8\u0dca \u0d9a\u0dbb\u0dca\u0dad \u0dba \u0d9a\u0dca \u0dd2\u0da7\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc1\u0dc4\u0ddd\n\n\u0d91 \u0dd0\u0dd2\u0dba \u0dc1 \u0db1\u0dad\u0dca \u0db8\u0dca \u0dc1\u0daf \u0d9a\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0db8\u0dca \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dd4\u0dc0 \u0db4\u0dda\u0db0\u0dad\u0dd2 \u0d9a\u0da7 \u0db4\u0dd2\u0dab\u0dba\u0d9a \u0d9a\u0da7 \u0dc1\u0dc4\u0ddd \u0db4\u0dd2\u0dab\u0dba\u0d9a \u0db4\u0dda\u0db0\u0dad\u0dd2 \u0d9a\u0da7 \u0dc1\u0dc4\u0ddd \u0db4\u0dd2\u0dab\u0dba\u0d9a \u0d9a \u0d87\u0dad\u0dd2 \u0db8\u0dca \u0dd0\u0da9\u0dc4\u0da7\u0dc4\u0db1\u0d9a\u0da7 \u0daf\u0dad\u0dca\u0dad \u0dca\u200d\u0da7 \u0dc1\u0dc4\u0ddd \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dd4\u0dc0 \u0dca\u200d\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dc1 \u0dd3\u0db8\u0db8\u0da7 (\u0d87 \u0db8\u0dca \u0dc4\u0dd4 \u0db8\u0dc1\u0dd4\u0dc0 \u0db1 \u0daf\u0dad\u0dca\u0dad \u0dc1\u0dc4\u0dd2\u0db6\u0daf\u0dbb\n\n\u0d9a\u0dbb\u0db1 \u0dc1\u0dca\u200d\u0dc4 \u0db8\u0dca \u0dad\u0dd0\u0db1\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4\u0da7 \u0dd2\u0dba \u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 (\u0d88 \u0db8\u0dca \u0dad\u0dd0\u0db1\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4 \u0dc1\u0da0\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb \u0dcf\u0db1\n\n\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc4\u0dc4 (\u0dd2 \u0dc1\u0db8\u0dca \u0db4\u0db1\u0dc1\u0dad\u0dca \u0d9a\u0dc1\u0dbb\u0dca \u0dc4 \u0dc4\u0dc1 \u0dc4\u0dc1\u0db0\u0dc1\u0dbb\u0dba \u0dc1\u0dca\u200d\u0dc4 \u0d85 \u0dba \u0dd2\u0dbb \u0dc4\u0dd0\u0d9a\u0dd2 \u0dc1 \u0db1\u0dad\u0dca \u0db8\u0dca \u0dc1\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0db3\u0dca\u200d \u0dad\u0dd2\u0db6\u0dd2 \u0dba\u0dd4\u0dad\u0dd4 .\n\n(5) \u0db8\u0dd4\u0daf \u0dc0 \u0dd2\u0dbb\u0dc2 \u0db4 \u0dbb\u0dc1 \u0d87\u0dad\u0dd2 \u0d85\u0db8\u0dc1\u0dad\u0dba \u0dbb \u0dc1 \u0dd2\u0dbb\u0db8\u0dc4\u0dc1 \u0d85\u0db8\u0dc1\u0dad\u0dba \u0dbb \u0dc1 \u0dd2\u0dbb\u0dc3\u0dd2\u0dca \u0dd2\u0dba \u0dcf\u0da0 \u0d9a\u0dbb\u0db1\u0dd4 \u0dca\u200d\u0dd0\u0db6\u0dd2 \u0dc4\u0dd0\u0d9a\u0dd2 \u0db4\u0dc1\u0dd2\u0dbb\u0db8\u0dd2\u0d9a\u0d9a \u0dca \u0dd2\u0dbb\u0dc1 \u0dda\u0dc2\u0da5\u0db4 \u0d9a\u0dd4 \u0dc1 \u0dad \u0dc1\u0dab \u0db1\u0dd4 \u0dca\u200d\u0dd0\u0db6\u0dd2 \u0dba\u0dd4\u0dad\u0dd4 .\n\n(6) \u0dc1\u0db8\u0dca \u0db4\u0db1\u0dad \u0da7\u0dc1\u0dad\u0dca \u0db1 \u0dbb\u0daf\u0d9a\u0dca \u0dd2\u0dbb\u0db8\u0dbb\u0dca \u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0dd3\u0db8 \u0dc1\u0d9a\u0ddc\u0db8\u0dd2\u0d9a\u0dc2\u0dca \u0dc4\u0db7\u0dc1 \u0da7 \u0dc1\u0dc4\u0ddd \u0db8\u0dca \u0dc1\u0db4\u0ddc\u0dd2\u0db1\u0dc4\u0dcf \u0dd2\u0dba\u0dca\u200d\u0db0\u0dbb \u0d9a\u0dd4\u0da7 \u0dc4\u0dc4\u0dc1 \u0dd3\u0db8\u0db8 \u0dc4 \u0dc4\u0dc1 \u0dd2\u0dbb\u0dc1 \u0dda\u0dc2\u0da5\u0db4 \u0d9a\u0dd4 \u0d9a\u0dd0 \u0db1\u0dd4 \u0dca\u200d\u0dd0\u0db6\u0dd2 \u0dc4\u0dd0\u0d9a\u0dd2 \u0d85\u0dad\u0dbb \u0d91\u0d9a\u0dd3 \u0dd2\u0dbb\u0db8\u0dbb\u0dca \u0db1\u0dc1\u0d86 \u0d9a\u0dc1\u0dbb\u0dca \u0dc4 \u0dc4\u0dc1 \u0d85 \u0dba \u0dd2\u0dbb \u0dc4\u0dd0\u0d9a\u0dd2 \u0db8\u0dca \u0dc3\u0dd2 \u0dbd\u0dd4 \u0dc4\u0dc4\u0dc1 \u0dca\u200d\u0db3\u0dc1 \u0dd3\u0db8\u0db8 \u0dd2\u0dbb\u0dc1 \u0dda\u0dc2\u0da5\u0db4 \u0dc1\u0dc1\u0dda \u0d9a\u0dc1\u0dbb\u0dca \u0dd2\u0dbb \u0dba\u0dd4\u0dad\u0dd4 . \u0db8\u0dca \u0dd2\u0dbb\u0db8\u0dbb\u0dca \u0db1 \u0d9a\u0dd2\u0dca \u0dc1\u0dc4\u0ddc \u0dc1 \u0daf\u0dd0\u0db1\u0dab\u0dad\u0dca \u0d9a\u0dd4\u0dc0\u0dab\u0dd4 \u0dca\u200d \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dca\u200d \u0d9a\u0dca \u0dc1\u0dca\u200d\u0dc4 \u0db8\u0dca \u0db1\u0da9\u0dd4 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca\u0dad\u0d9a\u0dca \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0dd3\u0db8 \u0d87\u0dad\u0dd2 \u0d85 \u0dc4\u0dcf\u0dae\u0dc1 \u0d9a \u0dd3\u0db8 \u0d91\u0d9a\u0dd3 \u0dd2\u0dbb\u0db8\u0dbb\u0dca \u0db1 \u0d85\u0dad\u0dbb\u0dad\u0dd4\u0dbb \u0dd3\u0db8 \u0d94\u0dc4\u0dd4 \u0dd2\u0dbb\u0dc3\u0dd2\u0dca \u0dca\u200d\u0db3\u0dc1 \u0dab\u0db1\u0dd4 \u0dca\u200d\u0dd0\u0db6\u0dd2 \u0dc4\u0dd0\u0d9a\u0dd2 \u0db8\u0dca \u0dc1\u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dd4\u0dc0 \u0daf\u0dad\u0dca\u0dad \u0daf\u0dca\u200d\u0dbb \u0dba \u0dc1\u0dc4\u0ddd \u0dc1 \u0db1\u0dad\u0dca \u0dc1\u0dda \u0d91\u0d9a\u0dd3 \u0db1\u0da9\u0dd4 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca\u0dc1\u0dad\u0dca \u0d9a\u0dc1\u0dbb\u0dca \u0dc4 \u0dc4\u0dc1 \u0dca\u200d\u0db3\u0dc1 \u0dab\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dc4\u0dd0\u0dca\u200d\u0dd0\u0dc4\u0dcf\u0dd3\u0db8\u0db8 \u0d91\u0d9a\u0dd3 \u0dd2\u0dbb\u0dc1 \u0dda\u0dc2\u0da5\u0db4 \u0dc1\u0dc1\u0dda \u0d9a\u0dc1\u0dbb\u0dca \u0dd2\u0dbb \u0dba\u0dd4\u0dad\u0dd4 .\" (2) \"4] \u0db1 \u0db4\u0dd2\u0da7\u0dd4\u0dc1 2 \u0db1 \u0dc1\u0dda\u0dd2\u0db6\u0dc1\u0d86 \u0dc3\u0dd2\u0da7 30 \u0db1 \u0dc1\u0dda\u0dd2\u0db6 \u0daf\u0d9a\u0dca \u0dc1 \u0dc0\u0dd6 \u0dc1\u0dda\u0dd2\u0db6"
