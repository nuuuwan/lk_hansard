u0dca \u0db3\u0dca\u200d\u0dc1 \u0dab\u0dca \u0db1 \u0db4\u0dd4\u0dc5\u0dd4 \u0dca .\n\n\u0d91\u0dc1\u0dc4\u0dda \u0dc0\u0dd4 \u0daf \u0dc1\u0db8\u0db8 \u0db3\u0daf\u0dd4 \u0dc1\u0dc3\u0dd2 \u0db4\u0dc1\u0dd2\u0dc1\u0db7\u0ddd\u0d9c\u0dd2\u0d9a \u0dc1\u0da7 \u0dca\u200d\u0db3\u0dc1 \u0dc1\u0db1\u0ddc\u0dc1\u0daf\u0db8\u0dd2\u0d9a\u0dca \u0db8\u0dca \u0db4\u0dc1\u0dbb\u0dca \u0dcf \u0d9a\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0d87\u0dad\u0dca\u0db1\u0db8\u0dca \u0d92 \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0dbb\u0da2\u0dc1\u0d86 \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0dca \u0db4\u0dd2\u0dd2\u0db6\u0db3 \u0d9a\u0dc1\u0dbb\u0d9a \u0dc4\u0db7\u0dc1\u0dc1 \u0dd2\u0dba \u0db8 \u0db4\u0dd2\u0daf\u0dd2 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dba \u0d9a\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 5055.07.25 \u0db1 \u0daf\u0dc1\u0dad\u0db8\u0dd2\u0d9a\u0dca \u0d85\u0db4\u0dbb\u0dc1\u0db0 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dba \u0dc1\u0daf\u0db4\u0dc1\u0dbb\u0dca\u0dad\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd4 \u0da7 \u0db7\u0dc1\u0dbb \u0dd3\u0db8 \u0d87\u0dad. \u0d8a\u0da7 \u0d85\u0daf\u0dc1\u0dc5 \u0db8\u0dd4\u0daf \u0dc0 \u0d85\u0db8\u0dc1\u0dad\u0dba\u0dc1\u0d82 \u0dc1\u0d86 \u0dc1 \u0dc0\u0d9a\u0db8\u0dca \u0dbb \u0dc1 \u0dd2\u0dbb\u0dc3\u0dd2\u0dca \u0db1 \u0dca\u200d\u0daf \u0dd2\u0db1\u0db4\u0dd2 \u0dc4\u0dc4 \u0d9a\u0dbb\u0db1 \u0dca\u200d\u0daf \u0dc3\u0dd2\u0dc4\u0dd2 \u0d9a\u0dd0 \u0dd3\u0db8\u0db8 \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 03 \u0dc4\u0dc4 04 \u0dc1 \u0dca \u0daf\u0d9a\u0dca \u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1.\n\n\u0d8a\u0da7 \u0db4\u0dd2\u0dd2\u0db6\u0dad\u0dd4\u0dd4\u0dc0 \u0dc1 \u0dca \u0d85\u0db4\u0dbb\u0dc1\u0db0 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dba \u0dc1\u0daf\u0db4\u0dc1\u0dbb\u0dca\u0dad\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd4 \u0dd2\u0dbb\u0dc3\u0dd2\u0dca 5055.07.50 \u0daf\u0dd2\u0db1 \u0db4\u0dd2\u0dd2\u0db6\u0dad\u0dd4\u0dd4\u0dc0 \u0dc1 \u0ddc\u0db8\u0dd4 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb \u0dc1\u0db8\u0dca \u0dc4\u0db8\u0dca\u0db3\u0dca \u0db0\u0dc1 \u0dca \u0dad \u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dba \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0db3 \u0da7 \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba \u0dc4\u0dc1 \u0dc1\" \u0da2 \u0d85\u0db4\u0dbb\u0dc1\u0db0 \u0dd2\u0dbb\u0db8\u0dbb\u0dca \u0db1 \u0dc1\u0d9a\u0ddc\u0da7\u0dca\u0db0\u0dc1\u0dc4\u0dc1\u0d86 \u0dc4\u0dc4\u0d9a\u0dc1\u0dbb \u0dc1\u0db4\u0ddc\u0dd2\u0db1\u0dc4\u0dcf \u0d85\u0db0\u0dd2\u0d9a\u0dc1\u0dd2 \u0dd2\u0dbb\u0dc3\u0dd2\u0dca 5055.07.50 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0dd2\u0db1\u0db4\u0dd2\u0dc1 \u0dca \u0dc1 \u0dc0\u0d9a\u0db8\u0dca \u0db8\u0dd4\u0daf \u0dc0 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc4\u0dcf\u0dae\u0dc1\u0dba\u0dd2\u0d9a\u0dbb\u0dba \u0dc4\u0dc1 \u0da2\u0dc1\u0dad\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0d85\u0db8\u0dc1\u0dad\u0dba\u0dc1\u0d82 \u0dc1 \u0dad \u0daf\u0dca \u0dc1 \u0d87\u0dad. \u0d85\u0db4\u0dbb\u0dc1\u0db0 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dba \u0dc1\u0daf\u0db4\u0dc1\u0dbb\u0dca\u0dad\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd4 \u0d85\u0db4 \u0dc1 \u0dad \u0d91 \u0db1 \u0dca\u200d\u0daf \u0dd2\u0db1\u0db4\u0dd2 \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 0] \u0dc4\u0dc4 06 \u0dc1 \u0dca \u0daf\u0d9a\u0dca \u0dc1 \u0d87\u0dad.\n\n\u0dad \u0daf \u0dc1\u0db8\u0dca \u0dc4\u0db8\u0dca\u0db3\u0dca \u0db0\u0dc1 \u0dca \u0db1\u0dd3\u0dad\u0dd2\u0db4\u0dad\u0dd2 \u0dda\u0db4\u0dc1\u0daf\u0dc4\u0dcf 5055.07.22 \u0daf\u0dd2\u0db1 \u0dd2\u0dbb\u0db8\u0dc4\u0dc1 \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb \u0d92 \u0dc4 \u0dc4\u0dc1 \u0dca\u200d\u0dd0\u0db6\u0dd3 \u0d87\u0dad\u0dd2 \u0db4\u0dd2\u0dd2\u0db6\u0dad\u0dd4\u0dd4\u0dc0 \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 07 08 \u0dc4\u0dc4 09 \u0dc1 \u0dca \u0daf\u0d9a\u0dca \u0dc1 \u0d87\u0dad.\n\n\u0d91\u0db8 \u0d9a\u0dd4\u0dc0\u0dab\u0dd4 \u0daf \u0dc4\u0dd0\u0dca\u200d\u0d9a\u0dd2 \u0dc0\u0dca\u200d\u0da7 \u0dc1\u0dab\u0db1 \u0db3\u0daf\u0dd4 \u0d85\u0da9\u0dd4 \