    "chunk_text": "1\u0dd2\u0dc3\u0dd4\u0dc1\u0dca1 \u0dad\u0dd2\u0dad\u0dd2 \u0d9a\u0dca\u0dc2\u0da7\u0dd2\u0db0 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0d86\u0dca \u0d91\u0dca \u0db0\u0dcf\u0da2\u0dd2\u0dca \u0db1\u0dca\u0dd4\u0db1 \u0db6\u0dab\u0dca\u0ddb\u0dd2\u0db0 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0daf\u0dd2\u0dbd\u0dd2\u0db8\u0db4\u0dca\u0dad \u0dc11\u0dba\u0d86\u0db0\u0da0\u0dca\u0da0\u0dd2 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0da7\u0db4\u0dd2\u0dca\u200d \u0d85 \u0db4\u0dc1\u0da7\u0ddd\u0db0\u0dca\u200d \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0dc1\u0d9c\u0ddd\u0dd2\u0dbb\u0dca\u0dba\u0dca \u0da7\u0dc0 \u0da7\u0dd2\u0da7\u0db0\u0dca \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0db8\u0dd2\u0dca\u200d\u0dd2\u0dca \u0da2\u0dcf \u0dad\u0dd2\u0dca\u200d\u0da7 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0d9a\u0dd2\u0dcf\u0dc3\u0dca\u0dad \u0dc1\u0dad\u0dbd\u0dca\u0dc3\u0dca\u0dca \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0dc3\u0dd4\u0dba\u0dca \u0db1\u0dcf\u0da2\u0dd4\u0dca\u200d \u0db1 \u0dad\u0dd2\n\n\u0db4\u0dbb\u0dd2\u0dc3\u0dbb\u0dba \u0dc3\u0d9a\u0dc0\u0dcf\u0db7\u0dcf\u0dc0\u0dd2\u0d9a \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0dc4\u0dcf \u0d85\u0dbb\u0dc3\u0dbb \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dcf\u0db1\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d86\u0d82\u0dc1\u0dd2\u0d9a \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc0 \u0d9c\u0dc0 \u0d85\u0da2\u0dd2\u0dca \u0db1\u0dd2\u0dca\u0dad\u0db4\u0dca\u0dad \u0dc1\u0db4\u0dc0 \u0db1 \u0db1 \u0dad\u0dd2 (\u0dc3\u0dca\u0dcf\u0dd2\u0db4\u0dad\u0dd2), \u0d9c\u0dc0 \u0dc3\u0dd2 \u0db6\u0dd3 \u0db0\u0dca \u0dad\u0dd2 \u0da7 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0da2\u0dcf \u0dca\u0dad \u0dc3\u0dca\u0db1\u0db0\u0dc0\u0dd3\u0db0 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0da2\u0dcf \u0dca\u0dad \u0da7\u0dd0\u0da7\u0dc1\u0d9c\u0dd2\u0ddb\n\n\u0d85\u0db0\u0dcf\u0dba\u0dcf\u0db4\u0db1\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d86\u0d82\u0dc1\u0dd2\u0d9a \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc0 \u0d9c\u0dc0 (\u0d86\u0da0\u0dd2\u0dca ) \u0dc0\u0dd3 \u0db0\u0dd2\u0db0\u0db1\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc2\u0dca\u0da8\u0dad\u0da7\u0dca \u0db1 \u0dad\u0dd2 (\u0dc3\u0dca\u0dcf\u0dd2\u0db4\u0dad\u0dd2), \u0d9c\u0dc0 \u0d91\u0dc3\u0dca\u0dad \u0db6\u0dd3 \u0daf\u0dd2\u0dc3\u0dca\u0dd2\u0dad\u0dd2 \u0da7 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0dd2\u0dbb\u0db1\u0dca\u200d\u0dc0\u0dd3\u0db0 \u0daf\u0dd2\u0dc3\u0dca\u0dd2\u0dad\u0dd2 \u0da7 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0dc3\u0dd21\u0db1\u0dd2\u0dad\u0dca\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dad\u0db0\u0dca \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0dc1\u0db0\u0ddd\u0dc4\u0dd2\u0dab\u0dd3 \u0d9a\u0dd4\u0db1\u0dd2\u0dd2 \u0dd2\u0dbb\u0dc1\u0da2\u0dca\u0db0\u0dca \u0dad \u0db1 \u0dca \u0db8\u0dd2 , \u0d9c\u0dc0 \u0dc3\u0dca\u0dcf\u0da2\u0dd31 \u0d91\u0daf\u0dd2\u0dd2\u0db1\u0dd2\u0dca\u0dad \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0d9a\u0dd4\u0dca\u200d\u0dc3\u0dd2\u0dcf \u0dca \u0dad\u0dd2\u0dbd\u0dd3\u0db4\u0dca \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0d85\u0dc3\u0dca\u0dcf\u0da7 \u0dad1\u0db0\u0dca \u0dad \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0db8\u0dd4\u0daf\u0dd2\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dd2\u0dca\u0dad\u0dd2 \u0db1 \u0dca \u0db8\u0dd2 , \u0d9c\u0dc0 \u0dd2\u0dca\u0dad\u0da7 \u0d85\u0db1\u0dbd\u0dca \u0db1\u0dd2 \u0dd2\u0dd4\u0dca\u0dad \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0db1\u0dcf\u0da2\u0dd4\u0dca\u200d\u0dd2 \u0daf\u0dd2\u0dc3\u0dca\u0dd2\u0dad\u0dd2 \u0da7 \u0db1 \u0dca \u0db8\u0dd2 , \u0d9c\u0dc0 (\u0db1 \u0dd2\u0da0\u0dd2\u0dca ) \u0da0\u0dd2\u0dad \u0dc1 \u0dad\u0db0\u0dca \u0db1 \u0dad\u0dd2\n\n\u0dc0\u0dd2\u0dc0\u0daf\u0dc3\u0d9a \u0dbb\u0dd0\u0dd2\u0dbb\u0dba\u0dcf \u0dc3\u0dc4 \u0dc1\u0dca\u200d\u0dbb\u0db8\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d86\u0d82\u0dc1\u0dd2\u0d9a \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc0 \u0d9c\u0dc0 \u0dc1 \u0d9a\u0dca\u0dc2\u0da7\u0dca \u0d85\u0db4\u0dca\u0dad \u0db4\u0dd4 \u0dd2\u0db8\u0dd2 \u0db1 \u0dad\u0dd2 (\u0dc3\u0dca\u0dcf\u0dd2\u0db4\u0dad\u0dd2), \u0d9c\u0dc0 \u0da9\u0dd2\u0dca\u200d\u0dd2\u0dca \u0dc1\u0db4\u0dc1\u0dca\u0db0\u0dd2 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0dc6\u0dba\u0dd2\u0dc3\u0dca\u0dd2\u0dbd\u0dca \u0da7\u0dd2\u0dc3\u0dd2\u0dca \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0da7\u0db4\u0dd2\u0dca\u200d \u0d85 \u0db4\u0dc1\u0da7\u0ddd\u0db0\u0dca\u200d \u0db1 \u0dad\u0dd2,\n\n\u0d9c\u0dc0 \u0d91\u0dc3\u0dca\u0dad \u0d91\u0dca \u0db1\u0dd2\u0d9a\u0dca\u0dc2\u0da7\u0dd2\u0dca \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0d89\u0dc2\u0dca\u0da8\u0dd2\u0d9a\u0dca\u0dc2 \u0db0\u0dc4\u0dd4\u0db1\u0dd2\u0dca \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0dba\u0dd6 \u0dc1\u0d9a\u0dca\u0dc2 \u0dc3\u0dd4\u0db8\u0dd2\u0dca \u0d8b\u0da9\u0dd4\u0d9a\u0dd4\u0db9\u0dd4\u0db0 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 (\u0d86\u0da0\u0dd2\u0dca ) (\u0dc1\u0dca\u0da2\u0dcf\u0dca) \u200d\u0dbb\u0daf\u0dd3\u0db4\u0dca\u0dad \u0d8b\u0d9a\u0dbb\u0dc1\u0d9c\u0dd2\u0ddb \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0dc1\u0da7\u0ddd\u0d9a\u0dd2\u0dca\u200d\u0dd2 \u0d9c\u0dd4\u0da71\u0dca\u0db0\u0db1\u0dad \u0db1 \u0dca \u0db8\u0dd2 , \u0d9c\u0dc0 \u0dd2\u0dca\u0dad\u0da7 \u0d85\u0db1\u0dbd\u0dca \u0db1\u0dd2 \u0dd2\u0dd4\u0dca\u0dad \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0d9c\u0dd4\u0da7\u0dad\u0dd2\u0dca\u200d\u0da7 \u0db0\u0dd2\u0da2\u0dcf\u0db4\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0dc3\u0dca\u0db1\u0dca\u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dc1 \u0dad\u0db0\u0dca \u0db1 \u0dad\u0dd2\n\n\u0dd4\u0dad\u0d9a\u0dca \u0d85\u0d9c\u0dbb\u0dd4\u0d9a \u0dc3\u0dc4 \u0dad\u0dd2 \u0d85\u0d9c\u0dbb\u0dd4\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dba\u0d9a\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d86\u0d82\u0dc1\u0dd2\u0d9a \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc0 \u0d9c\u0dc0 \u0ddb\u0db6\u0dca\u0dbd\u0dd2\u0db8\u0d9a \u0da9\u0dd3 \u0dc1\u0da2\u0dca \u0dc1\u0dc3\u0dca\u0dc1\u0dad\u0dd2\u0dbb\u0db0\u0dca \u0dad \u0db1 \u0dad\u0dd2 (\u0dc3\u0dca\u0dcf\u0dd2\u0db4\u0dad\u0dd2), \u0d9c\u0dc0 \u0db0\u0dc0\u0dd4\u0dc6\u0dad \u0d9a\u0dd3\u0dca \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 1\u0da2\u0dd2\u0db0 \u0d85\u0dc1\u0db6\u0dca1\u0dca\u0db0\u0db1\u0dad \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0da2\u0dcf\u0dad\u0da7 \u0db6\u0dab\u0dca\u0ddb\u0dd2\u0db0\n\n\u0dc1\u0dad\u0dca\u0dad\u0dc1\u0da7\u0ddd\u0dca \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0d85\u0db1\u0dd4\u0db0 \u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dba\u0dca \u0dad \u0dd2\u0db4\u0dd2 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0dad\u0dca\u200d\u0dad\u0dd2 \u0d85 \u0db4\u0dc1\u0da7\u0ddd\u0db0\u0dca\u200d \u0db1 \u0dca \u0db8\u0dd2 , \u0d9c\u0dc0 \u0d91\u0dca \u0d91\u0dc3\u0dca\u0dad \u0dad\u0dc0\u0dd4\u0dc6\u0dd2\u0d9a\u0dca\u0dc2 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0dad\u0dd2\u0dc3\u0dca\u0d9a\u0dd4\u0da7\u0dcf\u0da7\u0dd2 \u0d86\u0db0\u0da0\u0dca\u0da0\u0dd2 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0dc1\u0d9a\u0dca\u0dc2 \u0db4\u0dd3 \u0d91\u0dc3\u0dca\u0dad \u0d9a\u0dd4\u0db1\u0dd2\u0db0\u0dc3\u0dd2\u0dd2 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0d89\u0dc3\u0dd4\u0dc0 \u0dc1\u0dba\u0dd2\u0ddb\u0dcf\u0dc1\u0d9c\u0dd2\u0ddb \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0db1\u0db0\u0dd4\u0db0 \u0dd2\u0dbb\u0dad\u0dd2\u0dad\u0dc1\u0dda \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 \u0da2\u0dcf \u0dca\u0dad \u0dc0\u0dd3\u0db0\u0dc3\u0dd2\u0dcf \u0db1 \u0dad\u0dd2 \u0dc0\u0dc3\u0dde\u0dca\u200d\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d86\u0d82\u0dc1\u0dd2\u0d9a \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc0 \u0d9c\u0dc0 (\u0da91\u0dba\u0dba) \u0db0\u0dd2\u0da2\u0dd2\u0dad \u0dc1\u0dc3\u0dca\u0dad\u0dad\u0dd2\u0db0\u0dca \u0dad \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 (\u0db1 \u0dd2\u0da0\u0dd2\u0dca ) \u0dad\u0dd2\u0dc3\u0dca\u0dad\u0dc3\u0dca \u0dd2\u0dbb\u0dad\u0dd2\u0db0\u0da7 \u0db1 \u0dad\u0dd2, \u0d9c\u0dc0 (\u0da91\u0dba\u0dba) \u0d9c \u0dd2\u0dc2\u0dca\u0da8\u0dd2\u0dca \u0dad1\u0dad\u0dca\u0dba \u0db1 \u0dad\u0dd2,"
