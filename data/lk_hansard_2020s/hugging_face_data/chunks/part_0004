    "chunk_text": "-\u0dc0\u0db8 \u0dc4 \u0dc4\u0dda\u0dd2\u0dba \u0dc1 \u0db8\u0dc0 \u0dc1\u0daf\u0dca\u0db4\u0dc5- \u0d87\u0db4 \u0da7 \u0dad\u0dca\u0db8 \u0dba \u0dca\u200d\u0dca\u0db8 \u0d9c\u0dd4\u0db1\u0dd3\u0db1 \u0db4 \u0dc3\u0dd4 \u0dcf\u0dba\u0db0 \u0dd2 . \u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1 \u0ddd\u0d86\u0dba \u0dcf\u0dae\u0db8 \u0db8 \u0dcf\u0dad\u0dd4\u0db1\u0dd2\u0dba \u0dc1\u0db8\u0dca \u0dad\u0dd4\u0dd2\u0db6\u0db0 \u0d85\u0db4\u0dd2 \u0dca\u0dca\u200d\u0db8\u0dc1\u0db4\u0db8\u0dc1\u0dba\u0db8\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0db0\u0dc1\u0db0 \u0dba\u0dc1\u0dc3 \u0d9a \u0dad \u0dc0\u0dca\u200d \u0daf\u0dca\u200d\u0dbb\u0dc0\u0dc1\u0dd3\u0dca\u200d\u0dad\u0db8\u0dc0 \u0db4 \u0dc3\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db1 \u0db1\u0db1\u0dca\u0db0 \u0dba\u0dc1\u0dc3 \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba \u0d85\u0dc0 \u0dba\u0dad\u0db8 \u0d89\u0da7\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db1\u0da7 \u0d85\u0dc0\u0dc4\u0dda\u0dae\u0db8\u0dc0 \u0dc4\u0dd4\u0dca\u200d\u0dd3\u0db1\u0db1\u0dd2 . \u0dd2\u0dbb\u0dc1 \u0dda\u0dc2\u0dca\u0da8\u0dc1 \u0db0 \u0d85\u0db4\u0dd2 \u0dd2\u0dba\u0dad\u0dba \u0dcf\u0dae\u0db8 \u0dcf\u0dba \u0d9a\u0dd4\u0da9\u0db8 \u0db8 \u0db1 \u0dba \u0db4\u0dd2\u0dba\u0db1\u0db8\u0dba \u0dc0\u0dba\u0db8\u0db4\u0db8\u0dd2\u0dba\u0dcf \u0db8\u0dc1\u0dda \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba \u0d85\u0dc0 \u0dba\u0dad\u0db8\u0dc0\u0dca\u200d\u0da7 \u0dad\u0dc0\u0dad\u0dca \u0db1\u0dd3\u0dad\u0dba\u0dd4\u0d9a\u0dd6\u0dbd\u0dca\u200d \u0dad \u0dc3\u0dbd\u0dd4\u0dc0\u0d9a\u0dca\u0dc2 \u0dd4\u0d9a\u0dd2 \u0db8\u0dc0\u0d9a\u0dca\u0dc2 \u0d9a\u0dca\u0dc2\u0dad\u0dd2 \u0d9a\u0dca\u0dc2 \u0dca\u200d\u0dca\u0db8 \u0dd3 \u0db1\u0dd2 .\n\n\u0dc3\u0dd4\u0dba\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dca\u200d\u0dad\u0dca \u0d9c\u0dd4\u0d9a\u0dc1\u0dca\u0dd4\u0d9a \u0db4 \u0dad\u0dca \u0dc1\u0dcf\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad \u0dc0\u0dbb\u0dca\u0dbd\u0dad\u0db1\u0db8 \u0d9a\u0dbb\u0dca\u0dbd\u0dd2\u0dcf\u0db1 \u0dcf\u0dbb\u0dd4\u0dd4\u0db8\u0dc0\u0dca\u200d\u0dd3 \u0d89\u0dad\u0db8 \u0dc0\u0dd4\u0dca\u0d9c\u0dad\u0dca \u0dc0 \u0db4 \u0dad\u0dca \u0dc1\u0dcf\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad\u0d9a\u0dca\u0dc2 \u0dd4\u0d9a \u0da7 \u0dc1\u0db4\u0db0\u0dc0\u0db8 \u0dd4\u0db0 \u0db8 \u0dba\u0d86\u0dc1\u0dad \u0daf\u0dbd\u0dca \u0dc3 \u0db4\u0dd2\u0dd2\u0db6\u0dca\u0dc0 \u0dcf\u0db8\u0dba\u0dcf \u0dc4\u0dcf\u0db8\u0dc1 \u0dc4\u0dcf\u0db8\u0db4\u0dad\u0dd2\u0dc0\u0dba \u0db8 \u0dc0 \u0d85\u0dc1 \u0dc3 \u0d9c\u0dbb\u0dd4 \u0dbb\u0dca\u0dbd\u0dc2\u0dca\u0da8 \u0dca \u0dc3\u0dd2 \u0dc3\u0dc0\u0db8 \u0db1\u0dd4\u0dad\u0dd2\u0dad\u0dd4\u0db1\u0db8. \u0d92 \u0db4\u0dd2\u0dd2\u0db6\u0dca\u0dc0\u0dc0 \u0d85\u0db4\u0dd2 \u0d91\u0dad\u0dd4\u0db1\u0db8\u0da7 \u0dc4\u0dda\u0dad\u0dd4\u0dad\u0dd2\u0dc0\u0db0\u0dad \u0dc1\u0dc0 \u0dc0\u0db8. \u0d92 \u0dd2\u0dbb\u0db0\u0dd2 \u0da7 \u0dd2\u0dba\u0dc0\u0dd4\u0dbb\u0dd0 \u0dc0 \u0dc1\u0daf\u0dca \u0d87\u0d9c \u0db1\u0dcf\u0da7 \u0dca\u200d\u0d9a\u0dca\u0dc2 \u0dcf\u0dba\u0dca\u200d\u0db8 \u0dc1\u0dca\u0db4\u0db8\u0dbb\u0dca\u0dbd \u0dda\u0dc0 \u0db1 \u0dcf\u0dae\u0db8 \u0dcf\u0dba\u0dca\u200d\u0db8 \u0dc1\u0db8\u0dca \u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dcf\u0dba\u0db0 \u0d85\u0db4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db0 \u0db8\u0dca \u0d91 \u0dc1\u0db1\u0dc0\u0dd4\u0dd2\u0dba \u0dcf\u0db8\u0dca\u200d \u0dcf \u0dc1\u0db8\u0dca \u0dba\u0da7\u0da7 \u0dc1\u0db8\u0dca \u0dc4\u0db1\u0db8\u0d86 \u0da7 \u0d89\u0dad\u0db8 \u0dc0\u0dd4\u0dca\u0d9c\u0dad\u0dca \u0db4\u0dab\u0dd2\u0dc0\u0dd4\u0da9 \u0d9a\u0dca\u0dc2 \u0dc1\u0d9c \u0db1\u0d9a\u0dca\u0dc2 \u0dd4\u0d9a \u0da7 \u0db1\u0db1 \u0dca\u0d9a\u0dd2 \u0dc0\u0db8.\n\n\u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1 \u0ddd\u0d86\u0dba \u0dcf\u0dae\u0db8 \u0db8 \u0dcf\u0dad\u0dd4\u0db1\u0dd2\u0dba 1969 \u0d85\u0d82\u0dcf 1 \u0dca\u0dba \u0d9a \u0db8 \u0d85\u0db4 \u0db4\u0db8\u0dca\u200d \u0db4 \u0dad \u0da7\u0dc1\u0dad\u0dca \u0dc1\u0dba\u0d9c\u0dd4\u0dca\u200d\u0db8\u0dc3\u0dd2 \u0dca \u0d85\u0dd4\u0d9a\u0db1\u0dd4\u0dad\u0dd2 \u0dc4\u0dc0 \u0db8 \u0d85\u0dca \u0d89 \u0dc0\u0dd2\u0dba\u0db4\u0dad\u0dca \u0dcf\u0dba \u0dad\u0dd2\u0dc1\u0dca \u0dc0\u0db8. \u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1 \u0ddd\u0d86\u0dba \u0dcf\u0dae\u0db8 \u0db8 \u0dcf\u0dad\u0dd4\u0db1\u0dd2\u0dba \u0d94\u0dca\u0dad\u0dd4\u0db1\u0db8 \u0dca\u0db0 \u0dc0\u0db8 \u0d85\u0dc1 \u0dc3 \u0dba\u0da7 \u0dd2\u0dbb \u0db8\u0dca\u200d \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba \u0d85\u0dbb\u0dca\u0dbd\u0db6\u0dd4\u0dca \u0dcf\u0da7 \u0daf\u0dbd\u0dc4\u0dd4\u0dba \u0dd4\u0db0 \u0dba\u0da7\u0d9a\u0dca\u0dc2 \u0dca\u0dc0. \u0d91 \u0dd2\u0dbb\u0dc4\u0dc0\u0db8 \u0d9c\u0dd4\u0db1\u0dd3\u0db1 \u0dc4\u0dc0 \u0db8 \u0d85\u0db4\u0da7 \u0dc4\u0dba\u0dca\u200d\u0db1 \u0d89\u0dad\u0db8 \u0db4 \u0dc3\u0dd4\u0db1 \u0d89\u0dad\u0db8 \u0db4 \u0dc3\u0dd4\u0dc1\u0dc0\u0db0 \u0d89\u0da7\u0dd4 \u0dcf\u0dc5 \u0dd4\u0d9a\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0db8\u0dc0\u0d9a\u0dca\u0dc2 \u0dc0\u0dd4\u0dba\u0db8 \u0d85\u0dc1 \u0dc3 \u0d85\u0dad\u0dba\u0dc0 \u0dba \u0dc1 \u0db8\u0dc0 \u0d9a \u0dd3\u0db1\u0db1\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db1 \u0dc1 \u0ddd \u0dd4\u0dc0\u0dd4\u0dad\u0dca\u0dc0\u0dd3\u0db1. \u0dc1\u0dbb\u0dca\u0dbd\u0d9c\u0dd4 \u0dc4\u0d82\u0dc1\u0d9a\u0dca\u0dc2\u0dad\u0db8\u0d82\u0dcf 2 000\u0dcf\u0da7 \u0d9a\u0dc4\u0db0 \u0dca\u200d\u0dbb\u0db1\u0db8\u0dba \u0d9a\u0dca\u0dc2 \u0dc0\u0dad\u0dca\u0dc0\u0dca\u200d\u0db8 \u0dad\u0db1\u0dd2 \u0d85\u0db4\u0dd2 \u0d85\u0dc1 \u0dc3 \u0dbb\u0dd4\u0db4\u0dd2 \u0dc1 \u0dc3 \u0d85\u0d9c \u0dc0\u0dd4\u0da9\u0dd2 \u0dcf\u0dba \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dca. \u0d91\u0dc0\u0dd4\u0dd2\u0dba \u0d8b\u0db4\u0d9a\u0dca\u200d\u0dbb\u0db1 \u0d9a\u0dca\u0dc2 \u0db4\u0db8\u0dd2\u0dbb\u0dca\u0dad\u0dca \u0dcf\u0dba\u0dca\u200d\u0db8\u0dd2 \u0d85\u0dc1 \u0dc3 \u0dab\u0dba \u0dc1\u0dc0\u0dca\u0da0 \u0dc4\u0d82\u0dad\u0dca\u0dad \u0dca\u200d\u0dbb\u0db1\u0db8\u0dba \u0dcf\u0dba \u0d9c\u0dad\u0dca\u0dc1\u0dad\u0dca.\n\n\u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1 \u0ddd\u0d86\u0dba \u0dcf\u0dae\u0db8 \u0db8 \u0dcf\u0dad\u0dd4\u0db1\u0dd2\u0dba \u0d85\u0db4\u0dd2 \u0d9a \u0dc1\u0dc0\u0dc5\u0dc0 \u0dc1\u0db4\u0db8\u0dc5 \u0dd4\u0dc0\u0dad \u0dd2\u0dbb\u0dc0\u0dd2\u0dad \u0dcf\u0dba \u0dad\u0dd2\u0dc1\u0dca \u0dc0\u0db8. \u0d9a \u0dc0\u0dad\u0dca\u0dc0\u0db8 \u0dad\u0dd2\u0db6\u0dd4\u0dd4\u0db8 \u0dcf\u0db8\u0dab\u0dca\u0da9\u0da9 \u0dc3\u0dd2 \u0dc3\u0dca\u200d \u0dd4\u0dc0\u0dad \u0d9a\u0dca\u200d\u0dbb\u0db1\u0d9a\u0dca\u200d\u0dbb\u0db1\u0dc1 \u0db0 \u0d9a \u0dcf\u0dba\u0db8\u0dd2\u0db0 \u0dad\u0dd2\u0dc1\u0dca \u0dc0\u0db8. \u0daf\u0dbd\u0dad\u0dca \u0dca\u0dd4 \u0da7\u0dad\u0dca \u0dc0\u0db8 \u0db4\u0db1\u0dba\u0d9a\u0dca\u0dc2 \u0dc1\u0d9c\u0db0\u0dc0\u0db0 \u0dc1\u0dca\u0db0\u0dc1\u0db0 \u0dd4 \u0dd4. \u0dc0\u0db8 \u0dc1\u0d9c\u0db0\u0dc0 \u0d91\u0dcf \u0dca\u0dd4 \u0da7\u0dad\u0dca \u0dc0\u0dad\u0dca\u0dc0\u0db8 \u0dad\u0dd2\u0dc1\u0dca \u0dc0\u0db8. \u0d92 \u0db4\u0dd2\u0dd2\u0db6\u0dca\u0dc0\u0dc0 \u0dd2\u0dbb\u0dc1 \u0dda\u0dc2\u0dca\u0da8 \u0dcf\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0d9a\u0dd2\u0db0 \u0dc1\u0dc4\u0db8 \u0db8 \u0dca\u0dd4\u0dbd\u0dd3\u0db8\u0db1\u0d9a\u0dca\u0dc2 \u0dcf\u0dba\u0dc1\u0d9c \u0dc0\u0db8. \u0d89 \u0dc0\u0dd2\u0dba\u0dc1\u0dad\u0dd3 \u0dc0\u0db8 \u0dc0\u0dca\u200d \u0d85\u0dc0 \u0dba\u0dad\u0db8\u0dc0 \u0d92 \u0dc4\u0dc0 \u0db8 \u0d89\u0db0 \u0dd2\u0dbb \u0dca\u0db1 \u0d92 \u0dc0\u0db8\u0dc1\u0dda\u0db1 \u0d85\u0dc1 \u0dc3 \u0dad\u0dd2\u0dc1\u0dca \u0dc1\u0da9\u0db8\u0dca\u200d\u0dbb\u0dca\u0dbd \u0dc4\u0d82\u0dad\u0dca\u0dad \u0db8 \u0dc0 \u0dcf\u0dbb\u0dd4\u0dd4\u0db8 \u0d94\u0d9a\u0dca\u0dc2\u0dc1\u0dcf\u0ddd\u0db1 \u0dc4\u0dca\u200d\u0dcf\u0db8 \u0dca\u0dca\u200d\u0db8\u0dd2\u0db0 \u0dad\u0dd2\u0dc1\u0dca \u0dc0\u0db8. \u0d85 \u0db8\u0d9c\u0dad\u0dc1\u0dad\u0dd3 \u0d85\u0db4\u0dd2 \u0dc0\u0db8 \u0d9a \u0dcf\u0dba\u0db0\u0dc1\u0db0 \u0dc1\u0dcf\u0db8\u0dc1 \u0db8\u0db1\u0dca \u0dba\u0da7\u0da7 \u0d85\u0dc0 \u0dba \u0dc0\u0db8 \u0dc1\u0db1\u0db8 \u0dc0\u0db8\u0dca \u0db8 \u0dc0 \u0db4\u0dd2\u0dd2\u0db6\u0dca\u0dc0\u0dc0 \u0dca \u0dc4\u0dca\u200d\u0dcf\u0db8 \u0dca\u0dca\u200d\u0db8\u0dd2\u0db0 \u0dad\u0dd2\u0dc1\u0dca \u0dc0\u0db8. \u0d92\u0dcf \u0dc1\u0dc0 \u0db1 \u0db4\u0dd4\u0dad\u0dca\u0dad\u0d9a\u0dca\u0dc2. \u0dd2\u0dba\u0dad\u0dba \u0d85 \u0dca\u200d\u0dbb \u0dda \u0d9a\u0dca\u0dc2 \u0dd2\u0dba\u0dc4\u0db8\u0dd2 \u0db1\u0db1 \u0d92 \u0d9c\u0dd4 \u0d9a\u0dd2 \u0dc1 . \u0daf\u0dbd\u0dad\u0dca \u0d85\u0db4\u0da7 \u0dca\u0dd4 \u0da7 \u0d92 \u0db4\u0dd2\u0dd2\u0db6\u0dca\u0dc0 \u0d85\u0dca \u0dc4\u0d9a\u0dca\u0dc2 \u0dd4 \u0dd4. \u0daf\u0dbd\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0db4\u0dc3\u0dd4 \u0dd2\u0dab \u0dca\u0db8 \u0d85\u0dad\u0dba\u0dc0 \u0dba \u0dc0\u0db8 \u0d9a\u0dd2\u0dc4\u0dd2\u0db4 \u0d9a\u0dca\u0dc2"
  },
