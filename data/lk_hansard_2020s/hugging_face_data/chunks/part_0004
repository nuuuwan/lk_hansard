    "chunk_text": "\u0dab\u0dd4\u0dc0 \u0dbb\u0dc1\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba \u0d94\u0db3\u0dad\u0dd4\u0db8\u0dc1\u0dc1\u0dda \u0db4\u0dd2\u0dd2\u0db6\u0dad\u0dd4\u0dc1\u0dbb\u0dca \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dd2\u0db1 \u0dc0\u0dd4\u0dab\u0dd4 \u0d86\u0d9a\u0dc1\u0dbb \u0da7 \u0dbb\u0dca\u0dc2 \u0d9a\u0da7 \u0d91\u0dc5 \u0dbd\u0dd4 \u0dc1\u0db8\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dc1\u0da7\u0ddc\u0dca \u0dca\u200d\u0d9a\u0dca\u0dc2 25 23\u0d9a\u0dca \u0dd2\u0dba\u0dc2\u0dcf\u0db4\u0dc1\u0daf\u0db1 \u0dc1 \u0dda\u0dd3\u0db8 \u0daf\u0dc5 \u0dc1 \u0dca \u0d85\u0dc1\u0dda \u0d91\u0dc5 \u0dbd\u0dd4 \u0db4\u0dd2\u0dc1\u0db7\u0ddd\u0da2\u0db1 \u0dc1\u0db8\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dc1\u0da7\u0ddc\u0dca \u0dca\u200d\u0d9a\u0dca\u0dc2 ]\u0dad\u0dca 7\u0dad\u0dca \u0d85\u0dad\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dba \u0d9a\u0dca. \u0d91\u0dad\u0dc1\u0d9a\u0ddc\u0da7 \u0d91\u0dc5 \u0dbd\u0dd4 \u0d8c\u0db1\u0dad\u0dc1 \u0d9a\u0dca \u0dc1\u0db1\u0ddc\u0dc1 \u0dba\u0dd2 \u0d85\u0dad\u0dd2\u0dd2\u0d9a\u0dca\u0dad \u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1 \u0dab\u0dd4\u0dc0 \u0d9a\u0dae\u0dc1\u0db1\u0dc1 \u0d9a\u0dad\u0dd4\u0db8\u0dd2\u0dba. \u0d91\u0dc1\u0dc4\u0db8 \u0d85\u0dad\u0dd2\u0dd2\u0d9a\u0dca\u0dad \u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dba\u0dc1 \u0dc0\u0dd4\u0dba\u0dad\u0dca \u0d85\u0dc1\u0db1\u0d9a\u0dca \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca \u0d91\u0dc5 \u0dbd\u0dd4 \u0dc1\u0db8\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dc1\u0da7\u0ddc\u0dca \u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dba \u0d9a\u0dca \u0dc4\u0dd0\u0db8 \u0dbb\u0dca\u0dc2 \u0d9a\u0db8 \u0dc1\u0dab\u0db1\u0dd0 \u0dc0\u0dca\u200d\u0dc1 \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1. \u0d86\u0dc4\u0dc1\u0dbb \u0daf\u0dca\u200d\u0dbb \u0dba \u0dc1\u0dab\u0dca \u0db1 \u0dc1\u0d9a\u0ddc\u0da7 \u0dc1\u0da0\u0ddd\u0daf\u0db1\u0dc1 \u0d9a\u0dca \u0d91\u0db1 \u0dc1 \"\u0dc1\u0db8\u0dca \u0dbb\u0da7\u0da7 \u0dd2\u0dbb\u0dc1\u0dda \u0dd2\u0dbb\u0dd2\u0dba\u0db8 \u0db1\u0dd0\u0dc4\u0dd0. \u0d91 \u0dd0\u0dd2\u0dba \u0dad\u0dad\u0dca\u0dad\u0dca \u0d9a\u0dca \u0dad\u0dd4\u0dc5 \u0dbb\u0dc1\u0da7\u0dca \u0db1 \u0dc1\u0dda \u0dbd\u0dd4\u0dad\u0dca \u0db4\u0dd2\u0da7\u0dbb\u0da7\u0dd2\u0dca \u0dc1\u0dab\u0dc1\u0db1\u0db1 \u0dc1\" \u0d9a\u0dd2 \u0dca\u200d\u0dc1. \u0d92 \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca \u0d91\u0d9a \u0dab\u0dd0\u0da7\u0dbd\u0dd4 \u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1. \u0dab\u0dd4\u0dc0 \u0dbb\u0dc1\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dba \u0dc1\u0db8\u0da0\u0dca\u0da0\u0dbb \u0d91\u0dc5 \u0dbd\u0dd4 \u0d85\u0dad\u0dd2\u0dd2\u0d9a\u0dca\u0dad \u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd2 \u0dd3\u0db8\u0dad\u0dca \u0d8a\u0dc1\u0d86 \u0dc1\u0db4\u0dc1\u0dbb\u0dca\u0daf\u0dc1 \u0db1 \u0dc1\u0d9a\u0ddc\u0da7 \u0db8\u0dd4\u0dc5\u0dd4 \u0dbb\u0dc1\u0da7\u0dca\u0db8 \u0d85\u0dad\u0dba \u0dba \u0d91\u0dc5 \u0dbd\u0dd4 \u0daf\u0dca\u200d\u0dbb \u0dba \u0dca\u200d \u0db8\u0dd2\u0d9a\u0dca\u200d \u0dd2\u0dc4\u0dc5 \u0d9c\u0dd2 \u0dc1. \u0d92 \u0db8\u0dd2\u0d9a\u0dca\u200d \u0dd2\u0dc4\u0dc5 \u0d9c\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dba \u0d9c\u0d9a\u0ddc\u0da0\u0dd2\u0da0\u0dbb\u0daf \u0d9a\u0dd2 \u0dc1 \u0ddc\u0dad\u0dca \u0dc4\u0db8\u0dc4\u0dbb \u0d85 \u0dc4\u0dcf\u0dae\u0dc1 \u0dca\u200d \u0d9a\u0dd0\u0dbb\u0da7\u0dca \u0db8\u0dd2\u0d9a\u0dca\u200d \u0dbb\u0dad\u0dca\u0dad\u0dbb\u0dca \u0db8\u0dd2\u0d9a\u0dca\u200d\u0da7\u0dad\u0dca \u0da9\u0dc1 \u0dd2\u0dc4\u0dc5 \u0d9c\u0dd2 \u0dc1. \u0d9a\u0dd0\u0dbb\u0da7\u0dca \u0db8\u0dd2\u0d9a\u0dca\u200d \u0dd3\u0db8 \u0dab\u0dca \u0db1 \u0db4\u0dd2\u0da7\u0dc1\u0d9a\u0ddc\u0da7\u0dd4\u0dc1 \u0dc1\u0dc4\u0da7\u0dca\u0da7\u0dd2\u0dd3\u0db8\u0daf\u0dd2\u0dc1\u0d86 \u0dbb\u0dad\u0dca\u0dad\u0dbb\u0dca \u0db8\u0dd2\u0d9a\u0dca\u200d\u0da7 \u0dab\u0dca \u0db1\u0dc1 \u0dad\u0dd0\u0db1\u0da7 \u0dca \u0db1 \u0d9a\u0dd2 \u0db8\u0dd2\u0d9a\u0dca \u0dc1\u0da0\u0ddd\u0daf\u0db1\u0dc1 \u0d9a\u0dc5\u0dc1. \u0d9a\u0dd0\u0dbb\u0da7\u0dca \u0d9a\u0dd2\u0dc1\u0dca\u200d\u0ddd \u0d9a \u0db8\u0dd2\u0d9a\u0dca\u200d \u0dd4\u0dc0\u0db4\u0dd2 \u0dc0 5 ]00 \u0daf\u0d9a\u0dca \u0dc1 \u0dd0\u0da9\u0dd2 \u0dc0\u0dd4\u0dba\u0dc1.\n\n\u0dc0\u0dbb\u0dca\u0dc2\u0dba \u0d86\u0db1\u0dba\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d91\u0dc5\u0dc0\u0dbd\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba (\u0d9c\u0db8\u0dca\u200d\u0dbb\u0dd2\u0dca\u0dc2 \u0d9c \u0ddc\u0db1\u0dca)\n\n2015 53\n\n2016 128\n\n2017 138\n\n2018 259\n\n2019 160\n\n2020 58\n\n2021 52\n\n145 146\n\n\u0dc0\u0dbb\u0dca\u0dc2\u0dba \u0dc0\u0dcf\u0dbb\u0dca\u0dd2\u0dad\u0d9a \u0d91\u0dc5\u0dc0\u0dbd\u0dd4 \u0db1\u0dd2\u0dc2\u0db1\u0db4\u0dcf\u0daf\u0db1\u0dba (\u0d9c\u0db8\u0dca\u200d\u0dbb\u0dd2\u0dca\u0dc2 \u0d9c \u0ddc\u0db1\u0dca)\n\n2018 1,379,856\n\n2019 1,238,095\n\n2020 1,359,558\n\n2021 1,343,893\n\n2022 1,250,771\n\n\u0db4\u0dc1\u0dbb\u0dca\u0dd2\u0db1\u0dc1\u0db8\u0dca\u0dca \u0dad\u0dd4\n\n\u0d9a\u0dbb\u0dca\u200d\u0dc1 \u0dd2\u0dbb \u0dc1\u0dca\u200d \u0d86\u0daf\u0dc1 \u0db8\u0dca \u0dca\u200d\u0db3\u0db8\u0dd2\u0d9a\u0dca \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dc1 \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a\u0dba\u0dd2. \u0dc1\u0db8\u0dca \u0db1 \u0dc1\u0db8\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca \u0db4\u0dc1\u0dca\u200d\u0db1 \u0d9a\u0dbb\u0dca \u0db1 \u0dc1 \u0dc1\u0dc5 \u0d85\u0db8\u0dc1\u0dad\u0dba\u0dc1\u0d82 \u0dc1\u0dc4\u0ddd \u0d9a\u0dca\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8 \u0d85\u0db8\u0dc1\u0dad\u0dba\u0dc1\u0d82 \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0dc1 \u0dca\u200d\u0dc1 \u0dc1\u0db8\u0ddc\u0db1 \u0dc1 \u0dc1\u0dc4\u0ddd \u0dd0\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1 \u0dc5\u0d9a\u0dca \u0dc1 \u0ddc\u0daf\u0dca \u0dc1\u0dca \u0db1\u0dd0\u0dda\u0daf? \u0db1\u0dd0\u0dad\u0dca\u0db1\u0db8\u0dca \u0db8\u0dd2\u0d9a\u0dd2\u0dba\u0dc4\u0dcf\u0dc3\u0dd4 \u0dc1\u0db8\u0dca \u0dc1\u0dc4\u0dba \u0dab\u0dc4\u0dca \u0db1 \u0d9a\u0dd2 \u0db1 \u0d91\u0d9a \u0db1\u0dad\u0dbb \u0dc1 \u0dca \u0dc1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc1\u0db8\u0dca\u0dc1\u0d9a\u0daf\u0dd2 \u0db8\u0dd2\u0d9a\u0dd2\u0dba\u0dc4\u0dcf\u0dc3\u0dd4\u0dca \u0dc1\u0dda \u0db4\u0dd0\u0dad\u0dca\u0dc1\u0dad\u0dca \u0dc1\u0dca\u200d\u0ddc\u0d9a\u0dd4 \u0dc4\u0dc1\u0db0\u0dc1\u0dbb\u0dba \u0dc1\u0dc4\u0dda\u0dad\u0dd4 \u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dba\u0dc1. \u0dc4\u0dd0\u0db8 \u0dc4\u0dad\u0dca \u0dc1 \u0d9a\u0dca\u0db8 \u0da2\u0dd3 \u0dad\u0dca \u0dc1 \u0dca \u0db1 \u0db1\u0db8\u0dca \u0daf\u0dd2\u0db1\u0db4\u0dad\u0dc1 \u0d86\u0dc4\u0dc1\u0dbb \u0dab\u0dca \u0db1 \u0d95\u0db1\u0dd1. \u0d91\u0dc5 \u0dbd\u0dd4 \u0db8\u0dd2\u0d9a\u0dca\u200d \u0dd0\u0da9\u0dd2 \u0dc0\u0dd4\u0dba\u0dc1\u0db8 \u0d86\u0dc4\u0dc1\u0dbb \u0dc1\u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2\u0d9a\u0db8\u0dd2\u0d9a\u0dca \u0da2\u0dd3 \u0dad\u0dca \u0dc1 \u0dca \u0db1 \u0dd2\u0dbb\u0db0\u0dd2 \u0d9a\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0dc1 \u0db1 \u0dc1. \u0d91\u0db8 \u0dd2\u0dba\u0dc4\u0dc1 \u0d91\u0dc5 \u0dbd\u0dd4 \u0db8\u0dd2\u0d9a\u0dca\u200d \u0db4\u0dc1\u0dca\u200d\u0db1 \u0d9a\u0dbb\u0dca\u200d\u0dc1 \u0d85\u0dad\u0dba \u0dba \u0d85\u0dad\u0dd2\u0dd2\u0d9a\u0dca\u0dad \u0d86\u0dc4\u0dc1\u0dbb \u0daf\u0dca\u200d\u0dbb \u0dba \u0db8\u0dca \u0dc4\u0dc1\u0db0\u0dc1\u0dbb\u0dba \u0db8\u0dd2\u0d9a\u0dca\u200d\u0d9a\u0da7 \u0da2\u0db1\u0dad\u0dc1 \u0da7 \u0dca\u200d\u0db3\u0dc1 \u0dc1\u0daf\u0dca \u0db1 \u0dd0\u0da9 \u0db4\u0dd2\u0dd2\u0db6\u0dc1 \u0dc5\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0db3\u0db1 \u0dc1 \u0daf \u0d9a\u0dd2 \u0dca\u200d\u0dc1 \u0dab\u0dd4\u0dc0 \u0dbb\u0dc1\u0da2\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dc1\u0dc1\u0dab\u0dca \u0db8\u0db8 \u0daf\u0dd0\u0db1 \u0dab\u0dca \u0db1 \u0d9a\u0dd0\u0db8\u0dad\u0dd2\u0dba\u0dd2."
