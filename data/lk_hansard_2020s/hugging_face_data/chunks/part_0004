    "chunk_text": "\u0dca\u0dd4\u0db0 \u0db4\u0dba\u0db8\u0dc1\u0dc3 \u0dca\u0dca\u200d\u0dad\u0dca\u200d \u0d9c\u0dd4 \u0db4\u0dd4 \u0db4\u0dd4 \u0db8 \u0dcf\u0dae\u0db8 \u0dcf\u0dba \u0dc0\u0db8 \u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1 \u0ddd\u0d86\u0dba \u0dcf\u0dae\u0db8 \u0db8 \u0dcf\u0dad\u0dd4\u0db1\u0dd2\u0dba. \u0db1\u0db1 \u0d9a\u0dd2 \u0db0\u0dc1\u0db0 \u0dd4 \u0dd4 \u0dc3\u0dd4\u0dc5\u0dd4 \u0db8 \u0db1 \u0dba \u0db4\u0dd2\u0dba\u0db1\u0db8\u0dba\u0dc1\u0dad \u0dc0\u0dba\u0db8\u0db4\u0db8\u0dd2\u0dba\u0dcf \u0db8\u0da7 \u0d85\u0db1\u0db8\u0dbb\u0dd4 \u0dd4 \u0dd4 \u0d9a\u0dd2 \u0dca\u200d\u0db8. \u0d94\u0dc4\u0dd4\u0da7 \u0d85\u0db1\u0db8\u0dbb\u0dd4\u0dd2 . \u0dba\u0da7\u0dcf \u0dcf\u0db8\u0dab\u0dca\u0da9\u0da9 \u0d89 \u0dc3\u0dbd\u0dd4\u0db1 \u0d85\u0dd4 \u0dc1\u0dc0\u0dca\u200d\u0db8 \u0dc0 \u0d9c\u0dba\u0db0 \u0dba\u0da7 \u0dc0\u0dd4\u0dc4\u0dd2\u0dca\u200d\u0db8 \u0db8\u0dd2\u0dd2\u0dba\u0dc4\u0dda\u0dc3\u0dd4 \u0d85\u0dc1\u0dad\u0dca \u0dc4 \u0dc3\u0dd2 \u0dd4\u0dad\u0dd2 \u0dc0\u0dd4\u0dba\u0db8\u0db1 \u0dc0\u0dd4\u0da9\u0dd2\u0db1 \u0db4 \u0dba \u0dc0 \u0dc0\u0db0\u0dc1\u0db0 \u0dc3\u0dd4\u0dc5\u0dd4 \u0db8 \u0db1 \u0dba \u0db4\u0dd2\u0dba\u0db1\u0db8\u0dba\u0dc1\u0dad \u0dc0\u0dba\u0db8\u0db4\u0db8\u0dd2\u0dba\u0dcf \u0db8\u0da7. \u0dd4\u0dca\u0dd4\u0dd2 \u0db4\u0dba\u0db8\u0dc1\u0dc3 \u0dca\u0dca\u200d\u0dad\u0dca\u200d \u0db4\u0db8\u0dd2\u0dbb\u0dca\u0dad\u0dca \u0dcf\u0dba\u0db0 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db0\u0dcf\u0db1 \u0dad\u0dd2\u0dc1\u0dca\u0db0\u0dc1\u0db0 \u0d9a\u0dd4\u0db1 \u0dba \u0dd3\u0db1\u0db1\u0db8\u0dc1\u0dc0\u0db0 \u0d89 \u0dc5\u0da7\u0dca? \u0dbb\u0dd4\u0db4\u0dd2 \u0dc3 \u0dca\u200d\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8 50\u0dcf\u0da7 \u0dc0\u0dd4\u0da9\u0dd2 \u0dba \u0d9c\u0dad\u0dca\u0dad \u0dc1\u0dcf\u0dc1 \u0d9a\u0dd4 \u0dc4\u0db8\u0dca\u0dca\u0db0 \u0dc1 \u0db0 \u0dad\u0db1\u0dd2 \u0db4\u0dba\u0db8\u0dc1\u0dc3 \u0dca\u0dca\u200d\u0dad\u0dca\u200d \u0db4\u0db8\u0dd2\u0dbb\u0dca\u0dad\u0dca \u0dcf\u0dba\u0dca\u200d\u0db8 \u0dca\u0dd4\u0d82\u0d9a\u0dd4\u0dc0\u0dcf\u0da7 \u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dcf\u0dba\u0db0 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db0\u0dcf\u0db1 \u0dad\u0dd2\u0dc1\u0dca\u0db0\u0dc1\u0db0. \u0d85\u0dc1 \u0dc3 \u0dba\u0dc1\u0dc3 \u0db1\u0dd4\u0d9a\u0dc4\u0dda\u0dc4\u0dc1 \u0d9a\u0dca\u0dc2 \u0dbb\u0dd4\u0db4\u0dd2 \u0dc3 \u0dca\u200d\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8 50\u0dcf \u0dba \u0d9a\u0dca\u0dc2 \u0d9c\u0db0 \u0dc0\u0db8 \u0dc0\u0dd4\u0dba\u0dad\u0dca \u0d92 \u0db1\u0dd4\u0d9a\u0dc4\u0dda\u0dc4 \u0db8\u0da7 \u0d85\u0db1\u0db8\u0dbb\u0dd4 \u0dd4 \u0dd4 \u0d9a\u0dd2 \u0dca\u200d\u0db8 \u0db1\u0db1 \u0d9a\u0dd2 \u0db0\u0dc1\u0db0 \u0dd4 \u0dd4. \u0dd4\u0dca\u0dd4\u0dd2 \u0d85\u0db4\u0dd2 \u0d9a\u0dd2 \u0db0\u0dc1\u0db0 \u0dc4\u0db8\u0dc1 \u0dc3\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8\u0dc0. \u0dca\u200d\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8 50\u0dcf\u0da7 \u0dc0\u0dd4\u0da9\u0dd2 \u0dba \u0d9c\u0dad\u0dca\u0dad \u0dcf\u0dab\u0dca\u0da9\u0da9\u0db8 \u0db1 \u0d85\u0db4\u0dd2 \u0d9a\u0dba\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8\u0db8 \u0dcf\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dd2 . \u0dd4\u0dca\u0dd4\u0dd2 \u0d85\u0db4\u0da7 \u0dc3\u0dd2\u0daf\u0dca \u0dc1\u0dc0\u0dca\u200d\u0db8\n\n479 480\n\n[\u0d9c\u0dbb\u0dd4 \u0dba\u0d82\u0da2\u0dd2\u0dad\u0dca \u0dc3\u0dd2 \u0dca\u200d\u0db8\u0db4\u0dd2\u0d9a \u0db1 \u0dad\u0db8]\n\n2024 \u0dc1\u0db4\u0dca\u0dba\u0dc0\u0db8\u0dd2\u0dba 20\n\n\u0dca\u0dd4\u0db0 \u0d9c\u0dbb\u0dd4 \u0d85 \u0dba\u0db8\u0db4 \u0d87\u0db1\u0dad\u0dd2\u0dad\u0dd4\u0db1\u0db8 \u0d9a\u0dd2 \u0dc0\u0db8 \u0dba \u0dc1 \u0db8\u0dc1\u0d9c\u0dc0\u0dd3\u0db1 \u0dd2\u0dba\u0dc4\u0db8 \u0dca\u200d\u0dbb \u0dda \u0d9a\u0dca\u0dc2 \u0d87\u0dad\u0dd2 \u0dc1\u0dc0\u0dca\u0da0 \u0dd2\u0dbb \u0dda\u0dc0\u0dd2\u0dbb\u0dca\u0dba\u0db8\u0dca\u200d \u0dc3\u0dd2\u0dc3\u0dd4\u0db0 \u0d9c\u0dd4 . \u0d94\u0dc0\u0dd4\u0db0\u0dc1\u0dda \u0daf\u0dbd\u0dca \u0dc3 \u0d85\u0db4\u0dd2 \u0dc1\u0d9c\u0dc0\u0db0 \u0db8\u0dca \u0d9a\u0dd2 \u0dca\u200d\u0db8 \u0dcf\u0db8\u0dab\u0dca\u0da9\u0da9\u0db8\u0d9c\u0db8\u0dba \u0dcf\u0db8\u0dba \u0d9c\u0dad\u0dca\u0dad\u0db8. \u0dd4\u0dca\u0dd4\u0dd2 \u0dcf\u0db8\u0dab\u0dca\u0da9\u0da9\u0db8\u0d9c\u0db8\u0dba \u0da7 \u0d8a\u0da7 \u0d91 \u0db8 \u0db0 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db0\u0dcf\u0db1\u0d9a\u0dca\u0dc2 \u0dd4 \u0dd4. \u0dcf\u0db8\u0dab\u0dca\u0da9\u0da9\u0db8\u0d9c\u0db8\u0dba \u0dad\u0dca \u0d89\u0dad\u0db8\u0db1 \u0d85\u0dd3\u0db1\u0dbb\u0dd4 \u0d9c\u0db1 \u0dcf \u0db0\u0dc1\u0db0. \u0d85\u0db4\u0da7 \u0db8\u0dca \u0db8\u0dca \u0dd2\u0dbb\u0db0\u0dd2\u0dc1\u0dad \u0d86 \u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0db4\u0db0\u0dc0\u0db8 \u0dd3 \u0db8\u0dca \u0dcf\u0dba\u0db0 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db0. \u0d91\u0dcf \u0dcf\u0dab\u0dca\u0da9\u0da9\u0db8 \u0db1\u0d9a\u0dca\u0dc2 \u0db4\u0dd4\u0dad\u0dca\u0dc1\u0dad\u0dca \u0dc4\u0dd2\u0da7\u0dc1\u0d9c \u0d92 \u0dcf\u0dab\u0dca\u0da9\u0da9\u0db8 \u0db1\u0da7 \u0d85\u0db1\u0db8\u0dbb\u0dd4\u0dd2 \u0d9a\u0dd2 \u0dc0\u0db8. \u0d85\u0dc1 \u0d9a\u0dca\u0dc2 \u0dcf\u0dab\u0dca\u0da9\u0da9\u0db8 \u0db1 \u0dc5\u0d9f\u0da7 \u0dd2\u0dab\u0dc4\u0dd2 \u0dc3\u0dca\u200d\u0db8 \u0d91\u0dad\u0dd4 \u0dc4\u0dd2\u0da7\u0dc1\u0d9c \u0d92 \u0dcf\u0dab\u0dca\u0da9\u0da9\u0db8 \u0db1\u0da7\u0dad\u0dca \u0d85\u0db1\u0db8\u0dbb\u0dd4\u0dd2 \u0d9a\u0dd2 \u0dc0\u0db8. \u0daf\u0dbd\u0dad\u0dca \u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0dc1 \u0ddd\u0d86\u0dba \u0dcf\u0dae\u0db8 \u0db8 \u0dcf\u0dad\u0dd4\u0db1\u0dd2\u0dba \u0d85\u0db4\u0dd2 \u0dcf\u0dae\u0db8 \u0dcf\u0dba\u0db0 \u0d85\u0dc0 \u0dba \u0dc1\u0dc0\u0db0\u0dc1\u0db0 \u0dc1\u0db8\u0dca \u0dba\u0dc1\u0dc3 \u0dc1\u0dca\u0dc1\u0dcf\u0ddd\u0d9a \u0dd2\u0dbb\u0dc3\u0dd2\u0dca\u200d\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8 \u0db1 \u0db4\u0dd4\u0dad\u0dca\u0dc1\u0dad\u0dca \u0dc4\u0dd2\u0da7\u0dc1\u0d9c . \u0d91\u0dc1 \u0db1 \u0dad\u0db1\u0dd2 \u0dd2\u0dbb\u0db4\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8 \u0da7\u0dad\u0dca \u0dc0\u0d9c\u0dd3\u0db8\u0db1 \u0dad\u0dd2\u0dc1\u0dca\u0db0\u0dc1\u0db0 \u0d85\u0db4\u0da7\u0dad\u0dca \u0dc0\u0d9c\u0dd3\u0db8\u0db1 \u0dad\u0dd2\u0dc1\u0dca\u0db0\u0dc1\u0db0. \u0d91\u0dad\u0dd4 \u0d89\u0dc0\u0dca\u200d\u0db8 \u0d85\u0db4\u0dd2 \u0dc1 \u0db8\u0dc0 \u0d85\u0dd4\u0d9a\u0db4\u0dd2\u0dd2\u0db6\u0dc1\u0dc0\u0dc5\u0d9a\u0dca\u0dc2 \u0d9a\u0dd2 \u0db0 \u0dd1 . \u0d85\u0db4\u0dd2 \u0d89\u0dc4\u0dda\u0dc1\u0dc4 \u0dc3\u0dca\u200d\u0db8\u0db1 \u0da2\u0dd3\u0dc0\u0dad\u0dca \u0dc1\u0dc0\u0db0 \u0db1 \u0dca\u0dd4\u0dd2\u0dba \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dca\u200d \u0db8 \u0d9a\u0dba\u0d9a\u0dca\u0dc2\u0dc2\u0dca\u0da8\u0db8 \u0dcf\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dca? \u0d85\u0d82\u0dcf \u0d91\u0dcf \u0dd2\u0dbb \u0dba\u0dd4\u0dad\u0dca\u0dc1\u0dad\u0dca \u0d94\u0dc4\u0dd4\u0da7 \u0d85\u0dc4\u0dda\u0dc0\u0dd4\u0dc3\u0dd4\u0db1 \u0dc1\u0dca \u0d91\u0dcf\u0dca?"
  },
