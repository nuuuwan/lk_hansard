d\u0bae\u0b95\u0baa\u0bcd \u0bc6\u0bbf\u0bb0\u0b95\u0b9f\u0ba9 \u0b89\u0bae\u0bb0 \u0b9a\u0bae\u0bcd\u0bc6\u0ba8\u0bcd\u0ba4\u0bc8\u0bc6\u0bbe\u0ba9 \u0b87\u0ba9\u0bcd\u0bae\u0bb1\u0baf \u0b92\u0ba4\u0bcd\u0ba4\u0bbf\u0bae\u0bb5\u0baa\u0bcd\u0baa\u0bc1\u0baa\u0bcd \u0bc6\u0bbf\u0b95\u0bb0\u0bb0\u0bae\u0ba3\u0bc8\u0bc0\u0ba4\u0bc6\u0bbe\u0ba9 \u0bb5\u0bbf\u0bb5\u0bc6\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0b9f\u0baf \u0ba4\u0ba4\u0bc6\u0bbe\u0baa\u0bcd\u0baa\u0bc1\u0bb3\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0b9f\u0bbf \u0b89\u0bb1\u0bb5\u0bc1\u0b95\u0bb3\u0bc6\u0bbe\u0ba9 \u0bc8\u0bae\u0bb2\u0baf\u0b95 \u0bc8\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bc6\u0bbe\u0bb0\u0bcd\u0bc6\u0bc6\u0bbe\u0b95 \u0b9a\u0bbf\u0bb2 \u0bb5\u0bbf\u0b9f\u0baf\u0b99\u0bcd\u0b95\u0bae\u0bb3 \u0b87\u0ba8\u0bcd\u0ba4 \u0b89\u0baf\u0bc6\u0bbe\u0bbf\u0baf \u0b9a\u0bae\u0bc6\u0baf\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u0bae\u0bb5\u0b95\u0bcd\u0b95 \u0bb5\u0bbf\u0bb0\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0b95\u0bb1\u0ba9\u0bcd."
