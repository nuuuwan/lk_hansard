    "chunk_text": "\u0dad\u0dad\u0dca\u0dad\u0da7\u0db8 \u0d85\u0daf \u0d85\u0db4\u0dd2 \u0d85\u0dc0\u0db0\u0dca\u200d\u0dcf\u0db1\u0dba \u0dc1\u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dbb\u0dca\u0daf\u0db1 \u0d95\u0db1\u0dd1 \u0d85\u0dc1\u0dda \u0dbb\u0dc1\u0da7\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dae\u0db8\u0dd2\u0d9a \u0dc1\u0dc4\u0dde\u0d9b\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9c\u0dd0\u0db1. \u0dc1\u0dbb\u0ddd\u0d9c \u0dd0\u0dc1\u0daf\u0dca\u0daf\u0db1 \u0d89\u0dc4\u0dca\u0dc1\u0dc4\u0dbd\u0dca\u0dbd\u0dcf \u0dc1\u0dbb\u0ddd\u0d9c \u0db1\u0dd2\u0dc0\u0dcf\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc4\u0dca\u0db6\u0dbb\u0dca\u0daf\u0db0\u0dca\u200d\u0dc1\u0dba\u0dca\u0daf \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0dca\u0daf\u0db1 \u0d95\u0db1\u0dd1. \u0d9c \u0dc0\u0dcf\u0dc1\u0dda\u0db8 \u0daf\u0dbb\u0dd4\u0dc0\u0dca\u0daf\u0da7 \u0db8\u0dca\u0daf\u0daf\u0dc1\u0db4\u0ddd\u0dab\u0dab\u0dba \u0dad\u0dad\u0dd2 \u0dc1\u0dc0\u0dca\u0daf\u0db1 \u0d89\u0dc4\u0dca\u0dc1\u0dc4\u0dbd\u0dca\u0dbd\u0dcf \u0d9c \u0db8\u0dca\u0daf\u0daf\u0dc1\u0db4\u0ddd\u0dab\u0dab\u0dba \u0db1\u0dd0\u0dad\u0dd2 \u0d9a\u0dbb \u0d9c\u0dd0\u0dd3\u0dad\u0db8\u0da7 \u0d85\u0dc0 \u0dba \u0dc0\u0dd0 \u0db4\u0dd2\u0dc5\u0dc1\u0dc0\u0dc5 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0dca\u0daf\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0daf \u0dc1 \u0ddc\u0db3 \u0dba\u0dca\u0daf\u0dad\u0dca\u200d\u0dbb\u0dab\u0dba\u0dca\u0dc0 \u0dad\u0dd2\u0dc1\u0dbb\u0db1\u0dc0\u0dcf. \u0d85\u0daf \u0db1\u0dd2\u0dbd\u0db0\u0dca\u200d\u0dcf\u0dbb\u0dd2\u0dca\u0daf \u0dc0\u0dd2 \u0dcf\u0dbd \u0db4\u0dd2\u0dbb\u0dd2\u0dc4\u0dca\u0dc0 \u0d89\u0dca\u0daf\u0db1\u0dc0\u0dcf. \u0dc1\u0dbd\u0ddd\u0d9a\u0dc1\u0dda \u0d9a\u0dd2\u0dd2\u0db1\u0db8 \u0dbb\u0da7\u0d9a \u0db1\u0dd0\u0dad\u0dd2 \u0dbb\u0dcf\u0dca\u200d\u0dba \u0dc1\u0dc4\u0dda\u0dc0\u0dba\u0dca\u0dc0 \u0d85\u0dc1\u0dda \u0dbb\u0da7 \u0dad\u0dd4\u0dc5 \u0dc4\u0dca\u0dae\u0dcf\u0db4\u0dd2\u0dad \u0d9a\u0dbb\u0dbd\u0dcf \u0dc0\u0dd0\u0da7\u0dd4\u0dda \u0dc1\u0d9c\u0dc0\u0dcf\u0dc1\u0d9c\u0db1, \u0d9c \u0dbb\u0dbb \u0daf\u0dbb\u0dcf\u0dc1\u0d9c\u0db1 \u0d89\u0dca\u0daf\u0db1\u0dc0\u0dcf. \u0dc4\u0dd1\u0db8 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dca\u200d\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc4\u0db8\u0d9a\u0db8 \u0db1\u0dd2 \u0dca\u0da0\u0dd2\u0dad \u0dc0 \u0dc1\u0dba\u0dca\u0daf \u0dbb\u0dcf\u0dca\u200d\u0dba \u0db1\u0dd2\u0dbd\u0db0\u0dca\u200d\u0dcf\u0dbb\u0dd2\u0dca\u0daf \u0dad\u0dbb\u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dd4 \u0d89\u0dca\u0daf\u0db1\u0dc0\u0dcf, \u0db4\u0dab\u0dcf\u0dbd\u0dca \u0dc1\u0dc4\u0dde\u0d9b\u0dba \u0dc1\u0dc4\u0dda\u0dc0\u0dd2\u0d9a\u0dcf\u0dc0 \u0d89\u0dca\u0daf\u0db1\u0dc0\u0dcf. \u0d9c \u0d85\u0dba\u0dc1\u0dda \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0db7\u0dcf\u0dbb\u0dba \u0dad\u0dc0\u0dd4\u0dc0\u0dbb\u0da7\u0dad\u0dca \u0dca\u0dc0\u0dad\u0dd2\u0db8\u0dad\u0dca \u0d9a\u0dbb\u0dbd\u0dcf, \u0d9c\u0dca\u0db6 \u0dad\u0dd4\u0dc5 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2.\n\n\u0d86 \u0dcf\u0dbb \u0dc4\u0dca\u0db6\u0dbb\u0dca\u0daf\u0db0\u0dca\u200d\u0dc1\u0dba\u0dca\u0daf \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dc1\u0d9a\u0ddc\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0db8\u0dd2\u0dbb\u0dd2\u0dc4\u0dca \u0d9a\u0dbb\u0dbd\u0dca\u0dc0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 15\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc1\u0dca\u0db6\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dca\u0daf\u0db1 \u0db4\u0dd4\u0dd4\u0dc0\u0dca\u0daf \u0dc1\u0d9a\u0ddc\u0dc5\u0db9\n\n551 552\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dc1\u0dca\u0db6\u0dca\u0daf\u0dad\u0dd4\u0dc0"
  },
