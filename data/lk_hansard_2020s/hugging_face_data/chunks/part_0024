    "chunk_size_bytes": 3720,
    "chunk_text": "\u0db8\u0dc4\u0dcf \u0dc1\u0dbd\u0dcf\u0d9a\u0dd4 \u0d87\u0dc0\u0dd2\u0daf\u0dd2\u0db1 \u0db4\u0dd4\u0dc3\u0dda\u0dd9\u0d9a\u0dcf\u0dbd \u0dc1\u0d9c\u0db1\u0dcf\u0dc0\u0dcf. \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc1\u0dbd\u0dca\u0d9a\u0dda \u0d86\u0db1\u0dba\u0dcf\u0dc0\u0db1\u0dba\u0dcf\u0dc0 \u0d9a\u0dc0\u0dcf \u0d95\u0dc3\u0dda\u0dc1\u0dda\u0dba\u0dba\u0dcf\u0dc0\u0dcf\u0dc1\u0dda \u0d89\u0db3\u0dbd\u0dcf. \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc1\u0dbd\u0dca\u0d9a\u0dda \u0d86\u0db1\u0dba\u0dcf\u0dc0\u0db1\u0dba\u0dcf\u0dc0 \u0d9a\u0dc0\u0dcf. \u0dc4\u0dd0\u0dbd\u0dd0\u0dba\u0dd2, \u0dc1\u0dda \u0dc1\u0da9\u0dcf\u0dbd\u0dbb\u0dca \u0db8\u0dd2\u0dba\u0dba\u0dcf\u0dc0\u0db1 2.5 \u0dba\u0dcf\u0dc0\u0db1\u0d9a\u0dbd\u0dca \u0d92 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc1\u0dbd\u0dca\u0d9a\u0dda \u0daf\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0dc4\u0dd0\u0d9a\u0dbb\u0dca\u0dbd\u0dd4! \u0db8\u0dcf\u0dbb \u0db1\u0dcf \u0dba\u0dba\u0dcf\u0dc0\u0d9a\u0dca! \u0dc4\u0dd0\u0d9a\u0dbb\u0dca \u0db1\u0dda, \u0dc4\u0dd0\u0d9a\u0dbb\u0dca system \u0d91\u0d9a \u0d87\u0dad\u0dd4\u0dc0 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf, system \u0d91\u0d9a \u0d87\u0dad\u0dd4\u0dc1\u0dc0\u0db1\u0dca \u0d9a\u0dcf\u0dc1 \u0dc0\u0dad\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dad\u0dd2\u0dba\u0dcf\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0dc1\u0dd9\u0dcf\u0dbb\u0dc0 \u0dc3\u0dbd\u0dca\u0dba \u0d9c\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1\u0dda \u0dc4\u0dd0\u0d9a\u0dbb\u0dca \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf 14\u0dc1\u0daf\u0dc1\u0db1\u0d9a\u0dd4 \u0dc1\u0d9c\u0db1\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dd9 \u0d9a\u0dbb\u0dbd\u0dcf \u0dd9\u0db8\u0dba\u0dd2 \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0dad\u0dd2\u0dc1\u0dbd\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0dc1\u0dda \u0dc4\u0dd0\u0d9a\u0dbb\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dd9 \u0d9a\u0dbb\u0dbd\u0dcf \u0dd9\u0db8\u0dba\u0dd2 \u0d85\u0dbb\u0dc1\u0d9c\u0db1 \u0dad\u0dd2\u0dc1\u0dbd\u0db1\u0dca\u0dc1\u0db1\u0dca! \u0d91\u0dd9\u0dc1\u0d9a\u0dcf\n\n1337 1338\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dba\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0db8\u0dd6\u0dbb\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0db4\u0dc0\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0dcf\u0dc0\u0db1\u0dd2, \u0dd2\u0dba\u0dcf\u0dc0 \u0d86\u0dab\u0dca\u0dc0\u0dd3\u0dc0\u0dbd \u0dbd\u0dd0\u0dc3\u0dbd\u0dcf \u0dbd\u0dd0\u0dc3\u0dbd\u0dcf, \u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0dc1\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf. \u0dc1\u0db8\u0db1\u0dca\u0db1, \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0db1\u0dca\u0db1\u0dda \u0dd9\u0dc0\u0dad\u0dca \u0d91\u0d9a\u0d9a\u0dca. \u0dc1\u0db8\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0dc1\u0dbd\u0db1\u0dc0\u0dcf, \u0d85\u0dc4\u0d9c\u0db1\u0dca\u0db1. \u0dd2\u0dba\u0dcf\u0dc0 \u0d86\u0dab\u0dca\u0dc0\u0dd3\u0dc0 \u0d9a\u0dcf\u0dbd\u0dc1 United Solar \u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0db1 \u0dc1\u0d9a\u0dcf\u0dda\u0db4\u0dd0\u0db1\u0dd2\u0dba\u0dcf\u0dc0 , \u0d8a\u0db4\u0dd3\u0d91\u0dc6\u0dda, \u0d8a\u0da7\u0dd3\u0d91\u0dc6\u0dda \u0dc1\u0d9c\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0dbd\u0dd0\u0dbb\u0dd4\u0dc0 \u0d8b\u0dc3\u0dcf\u0dc0\u0dd2\u0dc1 \u0db1\u0dc0\u0dd3 \u0dad\u0dd2\u0dc1\u0dbd\u0db1 \u0dc1\u0d9a\u0dcf\u0dda\u0db4\u0dd0\u0db1\u0dd2\u0dba\u0dcf\u0dc0\u0d9a \u0dc1\u0dc3\u0ddd\u0dbd\u0dcf \u0dbd\u0dd0 \u0dbb\u0dd2 \u0daf\u0db8\u0db1\u0dca\u0db1 \u0dd6\u0db1\u0d9a\u0dbb\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dc1 \u0dc1 \u0d85\u0d9a\u0dca\u0d9a\u0dbb 1,200\u0d9a\u0dca \u0dc1\u0dba\u0dcf\u0dc0\u0ddd\u0da2\u0db1\u0dcf \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dc3\u0dcf. \u0dc1\u0dda \u0dc4\u0dd2 \u0db4\u0dd4 \u0d87\u0db8\u0dad\u0dd2 \u0da2\u0dba\u0dcf\u0dc0\u0dc1\u0d9a\u0dcf\u0da9\u0dd2, \u0d92\u0d9a \u0d91\u0dda \u0dc0\u0dd2\u0db0\u0dd2\u0dba\u0dcf\u0dc0 \u0db8 \u0dd9\u0dc0\u0dad\u0dca \u0dbb\u0dc0\u0dd2\u0da9 \u0db4\u0d9a\u0dca\u0dc2 \u0db1\u0dcf\u0dba\u0dcf\u0dc0\u0d9a\u0dc1\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0d91\u0d9a\u0dca\u0d9a \u0d91\u0d9a\u0dad\u0dd4 \u0dc1\u0dc0\u0dbd\u0dcf, \u0d91\u0dc1\u0dc4\u0db8\u0db8 \u0daf\u0dd3\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0dbd\u0db1\u0dc0\u0dcf. \u0dc1\u0db8\u0db1\u0dca\u0db1 \u0d92 documents. \u0d95\u0db1\u0dd1 \u0db1\u0dda \u0dc1\u0daf\u0db1\u0dca\u0db1\u0dda \u0dbd\u0dbd\u0db1\u0dca\u0db1, \u0d9a\u0dd4\u0dbb\u0dbb\u0dd4 \u0dc4\u0dbb\u0dd2 \u0d89\u0dbd\u0dca\u0dbd\u0db1\u0dc0\u0dcf \u0db1\u0dda. \u0d92\u0d9a \u0d87\u0dad\u0dd4\u0dc1\u0dc0\u0dda\u0dad\u0dca \u0dc1\u0dbd\u0dcf\u0d9a\u0dd4 \u0dc0\u0d82\u0da0\u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0dbd\u0db1\u0dc0\u0dcf. \u0d92\u0d9a \u0dd9\u0dc0\u0dad\u0dca \u0dc0\u0dd2\u0dc3\u0dda\u0dd9\u0dbb\u0dcf\u0dad\u0dca\u0db8\u0d9a\u0dc0 \u0d85\u0dba\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dc1 \u0daf\u0dd3 \u0dc1\u0dc4\u0dc5\u0dd2\u0daf\u0dbb\u0dda \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0dba\u0dcf\u0dc0 \u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0dbd\u0dcf \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0db1\u0dc0\u0dcf.\n\n\u0daf\u0dd0\u0db1\u0dca \u0dc1\u0dda \u0d9a\u0dcf\u0dbd\u0dc1 \u0dd9\u0db8\u0dba\u0dd2 \u0dc4\u0dd0\u0d9a\u0dbb\u0dca\u0dbd\u0dcf NDB \u0d91\u0d9a \u0d9c\u0dc4\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0db8\u0dc4 \u0dbd\u0dd0\u0d82\u0d9a\u0dd4\u0dc0 \u0d9c\u0dc4\u0db1\u0dca\u0dc1\u0db1\u0dca, \u0d85\u0dc3\u0dda\u0dc0\u0dd0\u0dc3\u0dd4\u0db8 \u0d9c\u0dc4\u0db1\u0dca\u0dc1\u0db1\u0dca. \u0d91\u0dc1\u0dc4\u0db8 \u0dad\u0dd2\u0dc1\u0dba\u0dcf\u0dc0\u0dc1\u0daf\u0dd3 \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0dbb \u0dc0\u0dbd \u0d89\u0db1\u0dca\u0db1 \u0d85\u0dba\u0dcf\u0dc0\u0dad\u0dca \u0dc1\u0db8\u0dc1\u0dc4\u0dda \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0dc1 \u0dba\u0dc1\u0d9a\u0dcf\u0dda \u0dc0\u0d82\u0da0\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0dc1\u0dda \u0dc1 \u0dba\u0dc1\u0d9a\u0dcf\u0dda \u0dc0\u0d82\u0da0\u0dcf \u0dbd\u0d82\u0d9a\u0dcf\u0dc1\u0dda \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0dba\u0dcf\u0dc0 \u0dc0\u0dd2 \u0dcf\u0dbd \u0db4\u0dcf\u0dc0\u0dd3\u0dc0\u0d9a\u0dca; \u0dc0\u0dd2 \u0dcf\u0dbd \u0d85\u0db7\u0dd2\u0dc1\u0dba\u0dcf\u0dc0\u0ddd\u0d9c\u0dba\u0dcf\u0dc0\u0d9a\u0dca. \u0d8d\u0da2\u0dd4 \u0dc0\u0dd2\u0dc1\u0dc1 \u0d86\u0dc1\u0dba\u0dcf\u0dc0\u0ddd\u0da2\u0db1 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0 \u0dc1\u0d9c\u0dc1\u0db1\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0dc1\u0dbd\u0db1 \u0dc1\u0dbd\u0dcf\u0d9a\u0dd4\u0db8 \u0dbd\u0dcf\u0db0\u0dcf\u0dc0\u0d9a\u0dca \u0d92\u0d9a. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0dc1 \u0dc1\u0db1\u0dcf\u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0dcf\u0dc0 \u0dc0\u0dc4\u0d9c\u0db1\u0dca\u0db1, \u0dc1\u0dc4\u0dcf\u0dbb\u0d9a\u0db8 \u0dc0\u0dc4\u0d9c\u0db1\u0dca\u0db1, \u0dc0\u0d82\u0da0\u0dcf\u0dc0 \u0dc0\u0dc4\u0d9c\u0db1\u0dca\u0db1 \u0dc4\u0daf\u0dd2\u0dc3\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0dd2 \u0dc1\u0db1\u0dcf\u0dc1\u0dc0\u0dba\u0dd2, \u0dc1\u0db8\u0dcf\u0db1 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0dcf\u0dc0 \u0dc1\u0d9c\u0db1\u0dcf\u0dc0\u0dad\u0dca \u0d92\u0d9a \u0dc0\u0dd2\u0dbb\u0dd4\u0dc1\u0db0\u0dc0 \u0db8\u0dc4\u0da2\u0db1\u0dba\u0dcf\u0dc0\u0dcf \u0db1\u0dd0\u0dd2\u0da7\u0dd2\u0db1 \u0d91\u0d9a \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dca\u0db1 \u0dbd\u0dd0\u0dc4\u0dd0."
  },
