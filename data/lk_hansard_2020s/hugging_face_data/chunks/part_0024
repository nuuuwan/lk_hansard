    "chunk_text": "\u2022 201. \u0dc0\u0dca\u0dc2\u0dc0\u0dda \u0dc3\u0dd2 \u0dc0\u0db1 \u0daf\u0dca\u0dc0\u0dcf \u0dc0\u0dd2\u0dc0\u0daf\u0dca\u0d9b \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0db1\u0dd2\u0dc0\u0dba\u0ddd\u0da2\u0dd2\u0dad \u0d86\u0dba\u0dad\u0db1 \u0db8\u0d9f\u0dd2\u0dca \u0dc0\u0dd2\u0dc0\u0daf\u0dca\u0d9b\u0db8\u0dad\u0dc0 \u0db4\u0dd3\u0da9\u0dcf\u0dc0 \u0db4\u0dad\u0dca \u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d9c\u0d9a\u0dd2\u0d9a \u0dc1\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a\u0dba\u0dca \u0dca\u0daf\u0dd2\u0dd2\u0dba\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d87\u0dd2\u0db1 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dbd\u0dd2\u0db8 \u0dca\u0d9c\u0dc0\u0dba\u0dcf\u0dc0\u0dc0\u0dca \u0dc0\u0dd2\u0dca\u0db3\u0dcf \u0d87\u0dd2\u0db1 \u0dca\u0d9c\u0dc0\u0dba\u0dcf\u0dc0 \u0dc4\u0dc3\u0dcf \u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d9c\u0d9a\u0dcf \u0dc0\u0dd2\u0dc0\u0daf\u0dca\u0d9b \u0dc0\u0dca\u0db4\u0dc0\u0dcf \u0db1\u0dd2\u0dba\u0dd4\u0dca\u0dd2\u0db1 \u0d9a\u0dcf\u0dca\u0dba\u0dcf\u0d9c\u0d9b \u0db4\u0db1\u0dc0\u0dad\u0dc4\u0dd2 44 \u0dc0\u0db8\u0dca\u0dd2\u0db1\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbb\u0dc0 \u0dca\u0db8\u0dae \u0d85\u0d9c\u0d9b\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0dca \u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0db1\u0dba\u0dca - awards - \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0dc0\u0dd2\u0dc0\u0daf\u0dca\u0d9b \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0db1\u0dd2\u0dc0\u0dba\u0ddd\u0da2\u0dd2\u0dad \u0d86\u0dba\u0dad\u0db1 \u0db8\u0d9f\u0dd2\u0dca \u0d85\u0dba \u0d9a\u0dbb \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dbd\u0dd2\u0db8\u0dc0\u0dbd \u0d85\u0daf\u0dcf\u0dc5\u0dc0 \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0d87\u0dd2\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0db8\u0dd4\u0dd4\u0db8 04**\u0dc4\u0dd2 \u0daf\u0dca\u0dc0\u0dcf \u0d87\u0dad0 \u2022 \u0dad\u0dcf\u0db1\u0dcf\u0db4\u0dd2\u0db1 \u0d9a\u0dcf\u0dca\u0dba\u0dcf\u0dbd \u0db8\u0d9f\u0dd2\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dc0\u0db8\u0db1 \u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc3\u0dd4\u0dbb\u0dca\u0dc2\u0dcf \u0db1\u0dd2\u0dc0\u0dcf\u0dca \u0dc0\u0dc0\u0dad \u0db4\u0dd3\u0da9\u0dcf\u0dc0 \u0db4\u0dad\u0dca \u0d9a\u0dcf\u0dca\u0dad\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a\u0dba\u0dca \u0dc0\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc4\u0dc3\u0dcf \u0d94\u0dc0\u0dd4\u0dca \u0dc0\u0dc0\u0dad \u0d86\u0dc4\u0dc3\u0dcf\u0dbb\u0db4\u0dcf\u0db1 \u0dc0\u0dca\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a \u0db4\u0dc4\u0dc3\u0dc3\u0dd4\u0d9a\u0db1 \u0dc4\u0dc3\u0dcf \u0d85\u0dc0\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0d85\u0dc0\u0d9b\u0dba\u0dad\u0dcf \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db80\n\n\u2022 \u0dc0\u0dd2\u0dc0\u0daf\u0dca\u0d9b \u0dad \u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd \u0db8\u0d9f\u0dd2\u0dca \u0d9c\u0dd4\u0dc0\u0dca \u0da7\u0dd2\u0d9a\u0dca\u0db4\u0dad\u0dca \u0dc0\u0dbb\u0ddd\u0dc4\u0dc3\u0dbd\u0dca \u0db8\u0dcf\u0dca\u0db4\u0dad\u0dd4 \u0dc4\u0dc3\u0dcf \u0dc0\u0dd2\u0db8\u0db8\u0db1\u0dd2\u0d9a \u0dc1\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dba\u0dca\u0dc0\u0dc3 \u0dc0\u0dc0\u0db1\u0dad\u0dca \u0d85\u0dc0\u0d9b\u0dba\u0dad\u0dcf \u0dca\u0db3\u0dc4\u0dc3\u0dcf \u0db8\u0dd6\u0dbd\u0dba\u0db8\u0dba \u0dca\u0dbd\u0dca\u0dd3\u0dba\u0db1 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0dc0\u0dca\u0db4\u0dae\u0dcf\u0dc0\u0dbd\u0daf\u0dd3 \u0d92\u0dc0\u0dcf \u0dca\u0db1\u0db6\u0dca\u0db0\u0dc0\u0dba\u0dca \u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d9c\u0d9a\u0dcf \u0dc0\u0dd2\u0dc0\u0daf\u0dca\u0d9b \u0dc0\u0dca\u0db4\u0dc0\u0dcf \u0db1\u0dd2\u0dba\u0dd4\u0dca\u0dd2\u0db1 \u0d9a\u0dcf\u0dca\u0dba\u0dcf\u0d9c\u0d9b\u0dc0\u0dda \u0dca\u0dc4\u0dc3\u0dc5 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dcf\u0dd2\u0dba\u0dad\u0dca\u0dc0\u0dc0\u0dba\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dad\u0dd3\u0dca \u0dbd\u0db6\u0dcf\u0dc0\u0db8\u0db1 \u0dc0\u0dd2\u0dc0\u0daf\u0dca\u0dba\u0dba \u0dc0\u0dca\u0db4\u0dc0\u0d9a \u0dc3\u0dd4\u0db7\u0dca\u0dcf\u0db0\u0db1 \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd \u0db8\u0d9f\u0dd2\u0dca \u0d91\u0db8 \u0dca\u0dbd\u0dca\u0dd3\u0dba\u0db1 \u0dca\u0da7\u0dd4 \u0d9a\u0dd2\u0dbb