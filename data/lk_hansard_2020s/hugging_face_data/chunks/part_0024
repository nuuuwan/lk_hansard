\u0dc0\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d9c\u0db8\u0db1\u0dca\u0dad\u0db1 \u0d9c\u0dc0 \u0d9a\u0dd2\u0dba\u0db1 \u0dc3\u0dc4\u0db1 \u0dbb\u0dcf\u0dc1\u0dd2\u0dba \u0d9c\u0dc0 \u0dc0\u0db1\u0d9c\u0d9a\u0dcf\u0da7 \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0db1\u0dc5\u0db8\u0dd4\u0d9c\u0dc0\u0db1\u0dca\u0dad\u0db8 \u0db0\u0dd3\u0dc0\u0dbb \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dc0\u0da7 \u0d89\u0db1\u0dca\u0dad\u0db0\u0dca\u200d\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dc4\u0db1\u0dcf\u0db0\u0dca\u200d\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0d9c\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d8a\u0da7 \u0dca\u0db8\u0db4\u0dbb\u0dc0 \u0da9\u0dd3\u0dc3\u0db1 \u0dc3\u0dc4 \u0d9c\u0db1\u0da7\u0dca\u200d\u0dbb\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0dca\u0daf\u0dcf\u0dc5 \u0dc3\u0dc4\u0db1 \u0d9c\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d8a\u0da7 \u0dca\u0db8\u0db4\u0dbb\u0dc0 \u0dba\u0dd6\u0dbb\u0dd2\u0dba\u0dcf \u0d9c\u0db1\u0dcf\u0d9c\u0dc4\u0dcf\u0dbb \u0db8\u0dd2\u0dbd \u0dc3\u0dd0\u0dae\u0dcf\u0dc0\u0dbb\u0dc0 \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0d9c\u0d9c\u0db1 \u0dba\u0db1\u0dca\u0dad\u0db1 \u0dc0\u0dd4\u0da9\u0dd2\u0db4\u0dd4\u0dbb \u0dc0\u0dd4\u0dba \u0dc0\u0db1 \u0db8\u0dd4\u0daf\u0dbd \u0dbb\u0da2\u0dcf\u0dba \u0dd2\u0dd2\u0db1\u0db1\u0dca\u0dad \u0daf\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d91\u0d9a\u0d9f \u0d9c\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d8a\u0da7\u0dad\u0dca \u0dca\u0db8\u0db4\u0dbb\u0dc0 \u0d9c\u0db1\u0dcf\u0d9c\u0dc4\u0dcf\u0dbb \u0dc3\u0db3\u0dc4\u0dcf \u0dca\u0daf\u0dcf\u0dc5 \u0dc3\u0dc4\u0db1\u0dcf\u0db0\u0dca\u200d\u0dcf\u0dbb\u0dba \u0dc0\u0dd4\u0da9\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 - \u0dd3 \u0dc0\u0d9c\u0dcf\u0dc0 \u0d9c\u0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0dc3\u0dc4 \u0dca\u0db8\u0db4\u0dbb \u0d9c\u0db7 \u0ddd\u0d9c \u0d9c\u0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0db1\u0dca\u0dad - \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d8a\u0da7\u0dad\u0dca \u0dca\u0db8\u0db4\u0dbb\u0dc0 Units 90\u0da7 \u0dca\u0dca\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0dd2\u0daf\u0dd4\u0dd2\u0dba \u0db1\u0dbb\u0dd2\u0d9c\u0db7 \u0ddd\u0da2\u0dcf\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0db1\u0dcf\u0dbb\u0dd2\u0d9c\u0db7 \u0ddd\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0dad\u0d9c\u0dda \u0dc0\u0dd4\u0dba \u0db6\u0dbb \u0dbb\u0da2\u0dcf\u0dba \u0dd2\u0dd2\u0db1\u0db1\u0dca\u0dad \u0daf\u0dbb\u0db8\u0dd2\u0db1\u0dca\u0dad \u0d92 \u0dca\u0db8\u0db4\u0dbb \u0db8\u0dd4\u0daf\u0dbd \u0dc3\u0dc4\u0db1\u0dcf\u0db0\u0dca\u200d\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dbd\u0db6\u0dcf \u0d9c\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0dd2\u0d9c\u0dc1\u0dca\u0dd0\u0dc2\u0d9c\u0dba\u0db1\u0dca\u0dad \u0d9c\u0dc0 \u0d9c\u0d9c\u0ddd\u0dbd\u0dd3\u0dba \u0dca\u0dbb\u0dca\u0db6\u0dd4\u0daf\u0dba \u0d9c\u0dc4\u0dd0\u0dad\u0dd4\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0dd4\u0db1\u0dca\u0dad\u0db1 \u0dd4\u0dba \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dca\u200d\u0dcf\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9c\u0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0db1 \u0db6\u0dd2\u0dd2\u0dba\u0db1 100\u0d9a \u0dca\u0db8\u0db4\u0dbb \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0dc0\u0dd4\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0dbb\u0da2\u0dcf\u0dba \u0dd2\u0dd2\u0db1\u0db1\u0dca\u0dad \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf."
