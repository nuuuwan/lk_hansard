    "chunk_text": "\u0dd9\u0dbb\u0dd4 \u0d87\u0dd9\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd9\u0db1\u0dd2, \u0dd9\u0dab \u0dc3\u0dd9\u0dd9 \u0d9a\u0dab\u0dbb\u0dba\u0dba \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dd9\u0dab\u0dc3 \u0d85\u0dc0\u0db0\u0db1\u0dab\u0db1\u0dba\u0da7 \u0dc3\u0dba\u0dab\u0db8\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dab. \u0d92 \u0dd9\u0dd9\u0dc4\u0dbb \u0d85\u0dba\u0dc3 \u0d85\u0db1\u0dca\u0dad\u0dd2\u0dd9 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf \u0dc0\u0dab\u0dc3 \u0d9a\u0dab\u0dbd\u0dba \u0dad\u0dd4\u0db8 \u0dd9\u0da7 \u0d85\u0dc4\u0db1\u0dca\u0db1 \u0dbd\u0dd0\u0dc3\u0db6\u0db1\u0dc0\u0dab, \u0dc3\u0dc1\u0dca\u200d\u0dbb\u0dca\u0dc2\u0dca\u0dc3\u0dab\u0dd2\u0d9a\u0d9a\u0dbb\u0dba\u0dc3\u0dda \u0dc0\u0dca\u0dad\u0dca\u0dad\u0dd2\u0dc3\u0dda \u0dc3\u0dba\u0dc3\u0daf\u0db1 \u0db1\u0dd3\u0dad\u0dd2\u0da5\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0db1\u0dd4 \u0db4\u0dc0\u0dab \u0db1\u0dd0\u0dad\u0dd2 \u0dc0\u0db1 \u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca, \u0dc3\u0dc1\u0dca\u200d\u0dbb\u0dca\u0dc2\u0dca\u0dc3\u0dab\u0dd2\u0d9a\u0d9a\u0dbb\u0dba\u0dba\u0da7 \u0dba\u0dd1\u0dd9\u0da7 \u0db6\u0dd0\u0dd2 \u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0db4\u0dc0\u0dab \u0dc3\u0daf\u0dab \u0dc3\u0dc0\u0dbd\u0dab \u0dad\u0dd2\u0dc3\u0db6\u0db1\u0dc0\u0dab \u0d9a\u0dd2\u0dba\u0dbd\u0dab. \u0dc0\u0dd2\u0dc3\u0dba\u0dca\u0dc2\u0dc3\u0dba\u0db1\u0dca\u0dd9 \u0db8\u0dd6\u0dd2\u0d9a \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dab\u0db1\u0dca\u0d9a \u0dd9\u0dc4 \u0dd9\u0dab\u0db1\u0dc0 \u0dc4\u0dd2\u0dd2\u0dbd\u0d9a \u0db1\u0dd4 \u0d9a\u0dae\u0dab \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dad\u0dca \u0d9a\u0dd2\u0db1\u0dca \u0dc3\u0db4\u0dab\u0da9\u0dd2 \u0da9\u0d9a\u0dca \u0d85\u0dc4\u0dbd\u0dab - \u0dc0\u0dd2\u0db1\u0dab\u0da9\u0dd2 20\u0d9a\u0dca, \u0dc0\u0dd2\u0db1\u0dab\u0da9\u0dd2 30\u0d9a\u0dca, \u0dd9\u0dd9\u0dc4\u0dbb \u0dc0\u0dd2\u0da7 \u0db4\u0dd0\u0dba\u0d9a\u0dca \u0d85\u0dc4\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca - \u0dd3\u0db8\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0daf\u0d9a\u0dd2\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0db6\u0dd4\u0dba\u0dab. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dd9\u0dab\u0dad\u0dca \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dab, \u0dd9\u0dab\u0db1\u0dc0 \u0dc4\u0dd2\u0dd2\u0dbd\u0d9a , \u0d91\u0dc3\u0dc4\u0dd9 \u0db1\u0dd0\u0dad\u0dca\u0db1 \u0db8\u0dd6\u0dd2\u0d9a \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dab\u0db1\u0dca\u0d9a \u0db1\u0dd4\u0dc0\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0db1\u0dca \u0d85\u0dc3\u0dca \u0db4\u0dbb\u0dd9 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0db6\u0dc0. \u0dc3 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0db1\u0dd0\u0dad\u0dca\u0db1 \u0dbb\u0dc3\u0da7\u0dca \u0da2\u0dca\u200d\u0db1\u0dca\u200d\u0dab\u0dc0\u0da7 \u0dc0\u0dd2\u0dba\u0dab\u0dbd \u0dc4\u0dd2\u0dd2 \u0dc4\u0dd0\u0dbb\u0dc0\u0dbd\u0da7 \u0db8\u0dd4\u0dc4\u0dd4\u0dba \u0db4\u0dab\u0db1\u0dca\u0db1 \u0db1\u0dca\u0dc0, \u0dc0\u0db1\u0dc0\u0dab. \u0dc3 \u0d9a \u0db4\u0dc3\u0dd4\u0d9a\u0dab\u0dd3\u0db1\u0dc0 develop \u0dc0\u0dd4\u0dab\u0dd4 law \u0d91\u0d9a\u0d9a\u0dca. \u0dc3 \u0d9a \u0daf\u0dd2\u0dd9\u0da7\u0dd9 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0d91\u0d9a\u0d9a\u0dca \u0dc3\u0db1\u0dab\u0dc3\u0dc0\u0dba\u0dd2. \u0dc3\u0d9a\u0dc3\u0dd9\u0dca \u0dc3\u0dc0\u0dca\u200d\u0dad\u0dca, \u0dc3 \u0dc3\u0dbd\u0ddd\u0d9a\u0dba \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0dc0\u0db1\u0dc0\u0dab\u0dad\u0dca \u0d91\u0d9a\u0dca\u0d9a\u0dd9 \u0da2\u0dca\u200d\u0db1\u0dca\u200d\u0dab\u0dc0\u0dc3 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dab\u0db1\u0dca\u0d9a \u0dc0\u0dbd\u0da7 \u0dc0\u0dd0\u0daf\u0dd9\u0dad\u0dca\u0d9a\u0dd9\u0d9a\u0dca \u0dbd\u0dd0\u0dc3\u0db6\u0db1\u0dc3\u0d9a\u0dab\u0da7 \u0db1\u0dd3\u0dad\u0dd2 \u0dc0\u0dca\u0dad\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0dbd\u0ddd\u0d9a\u0dc3\u0dda \u0dc4\u0dd0\u0dd9 \u0dbb\u0da7\u0d9a\u0da7\u0dd9 \u0dc0\u0dab\u0dc3 \u0dc0\u0dba\u0dab\u0dca\u0dca\u200d \u0dc0\u0db1\u0dca\u0db1 \u0db4\u0da7\u0db1\u0dca\u0dd9\u0dad\u0dca\u0dca\u200d\u0dab. \u0dc3 \u0d9a \u0d89\u0dca\u200d\u0dab \u0dc0\u0dd0\u0daf\u0dd9\u0dad\u0dca \u0dc3\u0daf\u0dba\u0d9a\u0dca, \u0d85\u0dc3\u0dca \u0dbb\u0da7 \u0dc0\u0dab\u0dc3 \u0dbb\u0da7\u0d9a\u0da7.\n\n\u0dd9\u0dbb\u0dd4 \u0d87\u0dd9\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd9\u0db1\u0dd2, \u0dc3 \u0dc0\u0d9a\u0dc0\u0dab\u0dd4\u0dc0\u0dc0 \u0dad\u0dd4\u0db8 \u0dd9 \u0d85\u0dd2\u0d9a\u0d9a\u0dbb\u0dba\u0dc0\u0dbd \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb\u0db1 \u0dc0\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca 40\u0d9a \u0dc0\u0dab\u0dc3 \u0db4\u0dd2\u0dd2 \u0dd9\u0d9a\u0dc3 \u0dc0\u0dd0\u0da9 \u0dca\u200d\u0dc4\u0db1 \u0d9a\u0dbb\u0dbd\u0dab \u0dad\u0dd2\u0dc3\u0db6\u0db1\u0dc0\u0dab. \u0d85\u0db4\u0da7 \u0dbd\u0dd0\u0dc3\u0db6\u0db1 \u0dc3\u0dca\u200d\u0dab\u0dbb\u0dad\u0dd4\u0db8\u0dbb\u0dd4 \u0d85\u0dd4\u0dc0\u0dc0 \u0db8\u0dd6\u0dd2\u0d9a \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dba\u0dba\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dbd\u0dab\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0, \u0dc0\u0dd2\u0dd2\u0d9a\u0dd9\u0dad\u0dca \u0dc0\u0dd2\u0db1\u0dba \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dba\u0dba\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dbd\u0dab\u0dad\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0db4\u0dd2 \u0db6\u0dbd\u0dab\u0dc3\u0db4\u0dab\u0dc3\u0dbb\u0dab\u0dad\u0dca\u0dad\u0dd4\u0db8 \u0dc0\u0db1\u0dc0\u0dab, \u0dc4\u0dd2 \u0dba\u0dab\u0d9a\u0dab\u0dbb\u0dc0 \u0d92 \u0dc0\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0d85\u0dc0\u0dd9\u0dca\u0dae\u0dab\u0dc0\u0d9a\u0dca \u0dbd\u0db6\u0dab \u0dc3\u0daf\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dab, \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dc3 \u0db1\u0dd2\u0dbb\u0dc0\u0daf\u0dba\u0dca\u200d\u0dab\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc3\u0db6\u0db1\u0dc0\u0dab \u0db1 \u0d94\u0dca\u0db4\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1.\n\n2311 2312\n\n\u0db4\u0dab\u0dbb\u0dca\u0dae\u0dd2\u0dc3 \u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\n\n\u0dd9\u0dbb\u0dd4 \u0d87\u0dd9\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd9\u0db1\u0dd2, \u0d92 \u0dc0\u0dab\u0dc3 \u0dd9 \u0dd9\u0dd9 \u0daf\u0d9a\u0dd2\u0db1\u0dc0\u0dab, \u0dc3\u0daf\u0dca\u0dba\u0db4\u0dab\u0dbd\u0db1\u0dd3\u0d9a\u0dbb\u0dba\u0dba \u0dd9\u0dc4 \u0d86\u0dd9\u0dd9\u0dad\u0dca \u0dd9\u0dd9\u0dc4\u0dbb \u0dc0\u0dd2\u0da7 \u0dc3 \u0d9a\u0da7 \u0d88\u0db3\u0dab \u0dd9\u0db1\u0dca\u0db1\u0dab \u0d86\u0d9a\u0dab\u0dbb\u0dba. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dab, \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dd9\u0dca\u0dc0\u0dab\u0dd3 \u0db1 \u0dc3\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0db6\u0dc0. \u0dc3 \u0dc0\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0db8\u0dd3 \u0db4\u0dd0\u0dab\u0dd2 \u0dc0\u0dab\u0dc3 \u0db4\u0dd2\u0dd2 \u0db1\u0dca\u0dc0, \u0dc3\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d92 \u0dc0\u0dab\u0dc3 \u0dd9 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dc3 \u0dd9\u0dca\u0dc0\u0dab\u0dd3 \u0db1 \u0db6\u0dc0 \u0dc4\u0dd0\u0dd9 \u0d85\u0d82\u0dba\u0dba\u0d9a\u0daf\u0dd3\u0dd9 \u0dad\u0dd2\u0dc3\u0db6\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dc3\u0daf\u0dca\u0dba\u0db4\u0dab\u0dbd\u0db1 \u0dc0\u0dba\u0dc3\u0dba\u0db1\u0dca \u0dd9\u0dd0\u0dad\u0dca\u0dca\u200d\u0db1\u0dca \u0dc3\u0db1\u0dab\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dd2, \u0d86\u0dd9\u0dd2\u0dbd\u0d9a \u0dc0\u0dba\u0dc3\u0dba\u0db1\u0dca \u0dd9\u0dd0\u0dad\u0dca\u0dca\u200d\u0db1\u0dca \u0dc3\u0db1\u0dab\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dd2, \u0d85\u0dc3\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0d85\u0d82\u0dba\u0dc0\u0dd2\u0dd4\u0dc0\u0dad\u0dca \u0dd9\u0dd0\u0dad\u0dca\u0dca\u200d\u0db1\u0dca \u0dc3\u0db1\u0dab\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0dba\u0dd2."
