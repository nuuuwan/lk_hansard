a8\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Deputy Speaker) Hon. Leader of the House, all such unparliamentary words will be removed.\n\n\u0d9c\u0dd4 \u0db6\u0dd2\u0db8\u0dbd\u0dca 0 \u0dc3\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dc3\u0dad\u0dca\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0baa\u0bbf\u0bae\u0bb2\u0bcd \u0bb0\u0ba4\u0bcd\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95) (The Hon. Bimal Rathnayake) \u0db1\u0dd0 \u0dd0, \u0db1\u0dd0 \u0dd0. \u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0dad\u0dc3 \u0da2\u0dba \u0dab\u0dae\u0dcf\u0db1\u0dcf\u0dc3\u0dab\u0dad\u0dd4\u0db8\u0dc3\u0dd2\u0dba, \u0d9f\u0dd2\u0dba\u0dc0\u0dcf\u0dbb\u0dca\u0dc3\u0dad\u0dc3\u0db0\u0dd3\u0d9a\u0db8\u0dc3 \u0db4\u0dbb\u0dd3\u0d9a\u0dca \u0dc4\u0dc2 \u0dc3\u0d9a\u0dca \u0dc4 \u0dab \u0dbd\u0dcf \u0d92\u0dc0\u0dcf\u0da7 \u0daf\u0dac\u0dd4\u0dc0\u0db6\u0db1 \u0dad\u0daf\u0db0\u0dd3\u0d9a\u0db1 \u0d95\u0db1\u0dd1. \u0d92 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3 \u0dcf \u0d94\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0db0\u0dd3\u0d9a\u0dbd\u0dcf\u0da7 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae\u0dcf\u0dc0 \u0dd2\u0dba\u0dad\u0dc3 \u0d9c\u0dc0\u0dbd \u0d87\u0dd2\u0dba \u0dbb \u0db6\u0db1 \u0dca\u0dbd\u0dbb\u0dbd \u0dd2\u0dba\u0dad\u0dca\u0db1\u0dc0\u0dcf. \u0d94\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0db0\u0dd3\u0d9a\u0dbd\u0dcf \u0d92\u0dc0\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc3\u0dcf\u0dda\u0db8\u0dc3\u0dab \u0dab \u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a \u0db1\u0dd0 \u0dd0.\n\n\u0d9c\u0dd4 \u0db1\u0dd2\u0db4\u0dca\u200d\u0dbb\u0dba\u0ddd\u0da2\u200d \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0dbb\u0db8\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0b9a\u0bcd \u0b9a\u0baa\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Deputy Speaker) Hon. Leader of the House, I shall bring it to the notice of the Hon. Speaker.\n\n\u0d9c\u0dd4 \u0db6\u0dd2\u0db8\u0dbd\u0dca 0 \u0dc3\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dc3\u0dad\u0dca\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0baa\u0bbf\u0bae\u0bb2\u0bcd \u0bb0\u0ba4\u0bcd\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95) (The Hon. Bimal Rathnayake) \u0db1\u0dd0 \u0dd0, \u0db1\u0dd0 \u0dd0, this is serious. \u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0dad\u0dc3 \u0da2\u0dba \u0dab\u0dae\u0dcf\u0db1\u0dcf\u0dc3\u0dab\u0dad\u0dd4\u0db8\u0dc3\u0dd2\u0dba, \u0d94\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0dcf \u0daf\u0db0\u0dd3\u0d9a\u0db1\u0dc0\u0dcf \u0d9f\u0db4\u0dd2 \u0d86\u0dca\u0da9\u0dd4 \u0db4\u0d9a\u0dca \u0dc4\u0dc2\u0dc3 \u0dd2\u0db1\u0dc3\u0d9c\u0dbb\u0dd4\u0dab\u0dc0 \u0db4\u0dc0\u0dda\u0dc0\u0dcf\u0dad\u0d9c\u0db1 \u0dc3\u0db1 \u0dca\u0dc0. \u0dad\u0db8\u0dc3\u0dbb\u0dd0\u0db1 \u0d9f\u0db0\u0dd3\u0d9a\u0dd2\u0dba\u0db8\u0dc3 \u0dc0\u0dcf\u0da0\u0dcf\u0dbd \u0dd2\u0db0\u0dd2\u0dc3\u0da7, \u0dc0\u0db1\u0da0\n\n[\u0db8\u0dd6\u0dbd\u0dcf\u0dca\u0db1\u0db4\u0dca\u200d\u0dbb\u0dda \u0d85 \u0db4\u0dd2\u0db8\u0daf\u0dd2 \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dc3\u0db1 \u0dbd\u0daf\u0dd3. [\u0b85\u0b95\u0bcd\u0b95\u0bbf\u0bb0\u0bbe\u0b9a\u0ba9\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0b95\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bbf \u0b85\u0b95\u0bb1\u0bcd\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.] [Expunged on the order of the Chair.]\n\n\u0dd2\u0db0\u0dd2\u0dc3\u0da7 \u0dab\u0dae\u0dcf \u0dab \u0db1 \u0dd2\u0db4\u0d9a\u0dca \u0dc4\u0dc2\u0dad\u0dda \u0db8\u0dc3\u0db0\u0dd3\u0d9a\u0dd3\u0dc0\u0dbb\u0dd4 \u0dad\u0daf\u0dad\u0dd4\u0db0\u0dd3\u0d9a\u0dad\u0daf\u0dad\u0db1\u0d9a\u0dca \u0dc4 \u0dd2\u0db0\u0dd3\u0d9a\u0db1\u0dc0\u0dcf. \u0d92\u0dab \u0dbb\u0db8\u0dc3\u0dba\u0dd2 \u0d87\u0dda\u0dbb. \u0dbb\u0dca\u0dc2 \u0daf \u0dd2\u0db1\u0dca \u0dc0\u0dcf \u0db8\u0dc3\u0db0\u0dd3\u0d9a\u0dd3\u0dad\u0dd4\u0db8\u0dc3\u0dcf \u0d92\u0dab \u0daf\u0db0\u0dd3\u0d9a\u0db1\u0dc0\u0dcf. \u0d94\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0db0\u0dd3\u0d9a\u0dbd\u0dcf \u0d92 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db6\u0db1\u0dca\u0db0\u0dd3\u0d9a\u0db0\u0dad\u0dc3\u0db0\u0dd3\u0d9a \u0d9a\u0dd2\u0dd2\u0db1 \u0dad\u0daf\u0dc3\u0d9a\u0dca \u0dc4 \u0dab \u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a \u0db1\u0dd0 \u0dd0. \u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0dad\u0dc3 \u0da2\u0dba \u0dab\u0dae\u0dcf\u0db1\u0dcf\u0dc3\u0dab\u0dad\u0dd4\u0db8\u0dc3\u0dd2\u0dba, \u0dad\u0db6\u0db1 \u0dab\u0dcf \u0dc3 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db6\u0db1\u0dca\u0db0\u0dd3\u0d9a\u0db0\u0dad\u0dc3\u0db0\u0dd3\u0d9a \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae\u0dcf\u0dc0 \u0dd2\u0dba\u0dad\u0dc3 \u0d9c \u0d9f\u0dd6 \u0d9c \u0db0\u0dd3\u0d9a\u0dc0\u0dbd \u0dd2\u0db3\u0dbd\u0dcf \u0dad\u0dab\u0dcf\u0da0\u0dca\u0da0 \u0db1\u0db6\u0db1 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3 \u0db0\u0dd3\u0d9a\u0dc0 \u0dd2\u0dba\u0dad\u0dca\u0db1\u0dc0\u0dcf\u0daf? \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae\u0dcf\u0dc0 \u0dd2\u0dba\u0dad\u0dc3 \u0d9c 82 (2) (\u0d9f) \u0dc3\u0da7\u0dad\u0dda \u0dad\u0db8\u0dc3\u0dad\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3 \u0db0\u0dd3\u0d9a\u0dc0 \u0dd2\u0dba\u0dad\u0dca\u0db1\u0dc0\u0dcf:\n\n457 458\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dad\u0db6\u0db1\u0db0\u0dd3\u0d9a\u0dad\u0dd4\u0dc0"
