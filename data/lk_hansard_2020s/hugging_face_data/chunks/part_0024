    "chunk_text": "\u0dc3\u0daf\u0dc0\u0dd4\u0dc0\u0dc0 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0d89\u0daf\u0dd2\u0dd2 \u0db4\u0dad\u0dca \u0d9a \u0dca\u200d\u0dbb\u0dca\u0dae\u0d9a\u0db1\u0dba \u0dc3 \u0d9a\u0dba\u0dd2. 2026\u0daf\u0dd3 \u0db1\u0dd4 \u0dc3\u0dd9\u0dab\u0dd4\u0dc0 \u0dc3\u0dc0\u0dbd\u0dab \u0dad\u0dd2\u0dc3\u0db6\u0db1\u0dca\u0dc3\u0db1\u0dca 25\u0dba\u0dd2, \u0d92 \u0db1\u0dd2\u0dd9\u0dab \u0db1\u0dd4 file \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dc3\u0daf\u0db1\u0dca\u0dc3\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0, \u0d91\u0d9a\u0dca\u0dc3\u0d9a\u0ddd lawyers\u0dbd\u0dab\u0da7 \u0dc3 \u0d9a \u0d91\u0db4\u0dab \u0dc3\u0dc0\u0dbd\u0dab, \u0dd3\u0db8\u0db1\u0dca \u0dc0\u0db1 \u0db1\u0dd2\u0dd9\u0dab \u0db1\u0dd4 file \u0d9a\u0dbb\u0db1\u0dca\u0dc3\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0dc0\u0dab\u0dc3 \u0dd9\u0dca\u200d\u0dba\u0d9a\u0dca \u0dca\u200d\u0dd9\u0dba\u0dd2 \u0dd9\u0dd9 \u0dc4\u0dd2\u0dca\u200d\u0db1 \u0dc0\u0dd2\u0dd2\u0d9a\u0dba\u0da7 \u0dd9\u0dbb\u0dd4 \u0dd9\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0d89\u0daf\u0dd2\u0dd2 \u0db4\u0dad\u0dca \u0d9a\u0dc3 \u0dca. \u0d92\u0d9a \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dd9\u0dab\u0dc3 \u0d85\u0daf\u0dc4\u0dd9. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dd9\u0dd9 \u0dc3\u0dd9\u0dc3\u0dc4\u0dd9 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 .\n\n\u0d85\u0db4\u0dd2 \u0db4\u0dab\u0dbd\u0db1\u0dba \u0d9a 2025 \u0dc0\u0dbb\u0dca\u0dae\u0dc2\u0dba \u0dc3\u0daf\u0dab\u0dc4\u0dbb\u0dba\u0dba\u0d9a\u0da7 \u0dd9\u0db1\u0dca\u0db1. 2025 \u0dc0\u0dbb\u0dca\u0dae\u0dc2\u0dc3\u0dda\u0daf\u0dd3 \u0d85\u0dc4\u0db1\u0dca\u0dc3\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0dd3\u0db8\u0db1\u0dca \u0d9a\u0dbb\u0dbd\u0dab \u0dad\u0dd2\u0dc3\u0db6\u0db1\u0dca\u0dc3\u0db1\u0dca \u0db1\u0dd4 59\u0dba\u0dd2. \u0d91\u0dc3\u0dc4\u0dd9 \u0db1 2021 \u0dc0\u0dbb\u0dca\u0dae\u0dc2\u0dc3\u0dda \u0d89\u0db3\u0dbd\u0dab \u0d85\u0dd4\u0dc3\u0dc0\u0db1\u0dca\u0dd9 \u0db1\u0dd4 \u0d85\u0dc4\u0db1\u0dca\u0dc3\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0dd3\u0db8\u0db1\u0dca \u0d9a\u0dbb\u0dbd\u0dab \u0dad\u0dd2\u0dc3\u0db6\u0db1\u0dca\u0dc3\u0db1\u0dca 2025 \u0dc0\u0dbb\u0dca\u0dae\u0dc2\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0db4\u0dd2 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dc0\u0dbb\u0dca\u0dae\u0dc2\u0dc3\u0dda; \u0dc0\u0dbb\u0dca\u0dae\u0dca\u200d\u0dd9\u0dab\u0db1 \u0d85\u0d9c\u0dca\u200d\u0dbb \u0dc0\u0dd2\u0db1\u0dd2\u0dba\u0dca\u0da0\u0dba\u0d9a\u0dab\u0dbb\u0dba\u0dab \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0dc3\u0daf\u0dca. \u0db1\u0dd3\u0dad\u0dd2\u0da5\u0dc0\u0dbb\u0dc3\u0dba\u0d9a\u0dca \u0dc0\u0dba\u0dc3\u0dba\u0db1\u0dca \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dab, \u0db1\u0dd3\u0dca\u200d\u0dba\u0dd4\u0dc0\u0d9a\u0dd6\u0dbd\u0dc0 \u0d89\u0daf\u0dd2\u0dd2 \u0dba\u0da7 \u0dba\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dd2 \u0db1\u0dd4 dismiss \u0dc3\u0dc0\u0db1\u0dc0\u0dab \u0d9a\u0dd2\u0dba\u0dbd\u0dab. \u0d92 \u0dca\u200d\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0dca\u200d\u0dd9\u0dba\u0dd2 \u0dc3\u0dd9\u0dca\u200d\u0dd0\u0db1 \u0db1\u0dd2\u0dbb\u0dca\u0dae\u0dd9\u0dab\u0dba\u0dba \u0dc3\u0dc0\u0dbd\u0dab \u0dad\u0dd2\u0dc3\u0db6\u0db1\u0dca\u0dc3\u0db1\u0dca.\n\n\u0d92 \u0dc0\u0dab\u0dc3 \u0dd9 \u0d94\u0db6\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0d9a\u0dd2\u0d85\u0dc0\u0dab, \u0db1\u0dd4 \u0d85\u0dd4 \u0dc3\u0dc0\u0db1\u0dca\u0db1 \u0dc3\u0dc4\u0dca\u0dad\u0dd4\u0db8\u0dc0 \u0db1\u0dd3\u0dad\u0dd2\u0da5\u0dc0\u0dbb\u0dd4 \u0db1\u0dd4 file \u0dc3\u0db1\u0dab\u0d9a\u0dd2\u0dbb\u0dd3\u0dd9 \u0d9a\u0dd2\u0dba\u0dbd\u0dab. \u0dd9\u0dd9 \u0dc3\u0db4\u0dab\u0da9\u0dd2 \u0da9\u0d9a\u0dca \u0d92 \u0dd9\u0dca\u200d\u0dba\u0da7 \u0d91\u0d9a\u0d9f \u0dc3\u0dc0\u0db1\u0dca\u0dc3\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d92\u0d9a\u0da7 \u0dc3\u0dc4\u0dca\u0dad\u0dd4\u0db8\u0dc0 \u0dc3 \u0d9a\u0dba\u0dd2. \u0d85\u0db4\u0dd2 \u0db8\u0dd6\u0dd2\u0d9a \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dab\u0db1\u0dca\u0d9a \u0db1\u0dd4\u0dc0\u0d9a\u0dca \u0db4\u0dc0\u0dbb\u0db1\u0dca\u0dc3\u0db1\u0dca \u0d85\u0dc3\u0dca \u0db8\u0dd6\u0dd2\u0d9a \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dab\u0db1\u0dca\u0d9a\u0dd9\u0d9a\u0dca \u0dc3\u0dbd\u0dca\u0dbd\u0d82\u0d9d\u0db1\u0dba \u0dc3\u0dc0\u0db1\u0dc3\u0d9a\u0dab\u0da7 \u0dc3\u0db1\u0dca.\n\n\u0daf\u0dd0\u0db1\u0dca \u0dc3 \u0daf\u0dad\u0dca\u0dca\u200d\u0dc3\u0dba\u0db1\u0dca\u0dd9 \u0d85\u0db4\u0da7 \u0dca\u200d\u0dbb\u0dca\u0dae\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dd2 \u0daf, \u0dd9\u0da7 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0db6\u0dd0\u0dd2 \u0daf, \u0d85\u0dc3\u0dca \u0dbb\u0da2\u0dca\u200d\u0dba \u0dc0\u0dd2\u0db1\u0dca\u0db1\u0dca \u0da2\u0dca\u200d\u0db1\u0dca\u200d\u0dab\u0dc0\u0dc3 \u0db8\u0dd6\u0dd2\u0d9a \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dab\u0db1\u0dca\u0d9a \u0dc3\u0dbd\u0dca\u0dbd\u0d82\u0d9d\u0db1\u0dba \u0dc3\u0db1\u0dab\u0d9a\u0dbb\u0db1 \u0db1\u0dd2\u0dd9\u0dab \u0dd2\u0dbd\u0db1\u0dd2\u0dd9\u0dca\u0dc3\u0dd4 \u0db1\u0dd4 \u0db4\u0dc0\u0dbb\u0db1\u0dca\u0db1 \u0d91\u0db1\u0dca\u0dc3\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0dbd\u0dab? \u0d92\u0d9a \u0dc3\u0dc4\u0dab\u0db3 \u0dc3\u0daf\u0dba\u0d9a\u0dca. \u0d91\u0dc3\u0dc4\u0dd9 \u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0d8d\u0dba\u0dab\u0dad\u0dca\u0dd9\u0d9a \u0dc3\u0daf\u0dba\u0d9a\u0dca \u0dc3\u0db1\u0dab\u0dc3\u0dc0\u0dba\u0dd2. \u0d92 \u0dca\u200d\u0dbb\u0dca\u0dae\u0d9a\u0db1\u0dba \u0dd9\u0da7 \u0dc3 \u0daf\u0dad\u0dca\u0dca\u200d \u0dc4\u0dbb\u0dc4\u0dab \u0d89\u0daf\u0dd2\u0dd2 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. [\u0db6\u0dab\u0db0\u0db1\u0dab \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0d9a\u0dca] \u0d94\u0d85, \u0dbb\u0da2\u0dca\u200d\u0dba \u0dd9\u0dc4 \u0dbb\u0da2\u0dca\u200d\u0dc3\u0dda \u0d86\u0dba\u0dca\u200d\u0db1. \u0dc0\u0dd2\u0db0\u0db1\u0dab\u0dba\u0d9a\u0dba\u0da7 \u0d91\u0dc3\u0dbb\u0dc4\u0dd2\u0dc0 \u0dc3\u0db1\u0dca \u0dc3\u0dd9\u0dab\u0da9\u0d9a\u0dca \u0dc3\u0dc0\u0dbd\u0dab\u0dc0\u0da7 FR \u0db1\u0dd4 \u0dc0\u0dd0\u0dc3\u0da7\u0db1\u0dca\u0dc3\u0db1\u0dca, \u0dd9\u0dbb\u0dd4 \u0dd9\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dd9\u0db1\u0dd2. \u0dc3\u0db4\u0dab\u0dd3\u0db1\u0dca\u0dba \u0dc3\u0d85\u0dc0\u0dab, \u0dc3\u0dd9\u0dab\u0d9a\u0d9a\u0dca \u0dc3\u0dc4\u0ddd \u0d86\u0dba\u0dca\u200d\u0db1\u0dba\u0d9a\u0dca \u0dc3\u0d85\u0dc0\u0dab, \u0dc0\u0dd2\u0db0\u0db1\u0dab\u0dba\u0d9a\u0dc3\u0dda \u0dba arm \u0d91\u0d9a\u0d9a\u0da7 \u0dc3\u0db1\u0dca, \u0d92 \u0db1\u0dd4 \u0db4\u0dc0\u0dbb\u0db1\u0dca\u0dc3\u0db1\u0dca. \u0db1\u0dd4 \u0db4\u0dd0\u0dc0\u0dbb\u0dd3\u0dd9 \u0d85\u0dd4 \u0dd3\u0db8\u0dd9 \u0dc4\u0dbb\u0dc4\u0dab \u0dc3\u0db4\u0db1\u0dca\u0dc0\u0db1 \u0dc3\u0daf\u0dca \u0d8d\u0dba\u0dab\u0dad\u0dca\u0dd9\u0d9a \u0dc3\u0db1\u0dab\u0dc3\u0dc0\u0dba\u0dd2, \u0db0\u0db1\u0db1\u0dab\u0dad\u0dca\u0dd9\u0d9a\u0dba\u0dd2. \u0dc3\u0dd9\u0dab\u0d9a\u0daf, \u0dc3 \u0dbb\u0da2\u0dca\u200d\u0dba \u0dd2\u0dbd\u0db1\u0dd2\u0dd9\u0dca\u0dc3\u0dd4\u0db1\u0dca\u0dc3 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dab\u0db1\u0dca\u0d9a \u0dc3\u0dbd\u0dca\u0dbd\u0d82\u0d9d\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dc3\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0db1 \u0dca\u200d\u0dbb\u0dca\u0dae\u0d9a\u0db1\u0dba\u0dad\u0dca \u0dc3 \u0daf\u0dad\u0dca\u0dca\u200d\u0dc0\u0dd2\u0db1\u0dca \u0dd9\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2, \u0dc0\u0da9\u0dab\u0dad\u0dca \u0dc0\u0dd2\u0db1\u0dca\u0dc3\u0db1\u0dca \u0d92\u0d9a \u0dc3\u0db1\u0dab\u0dc3\u0dc0\u0dba\u0dd2. \u0dd9\u0dd9 \u0dd9\u0dd0\u0dba\u0dd2 \u0dd9\u0dab\u0dd9\u0dc3\u0dda \u0dc3 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0db8\u0dbb \u0d9a\u0dd2\u0dc3\u0dba\u0d85\u0dc0\u0dab\u0da7, JSC \u0d91\u0dc3\u0d9a\u0db1\u0dca \u0dc3 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0db8\u0dbb \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dd9\u0dab\u0dd9\u0dc3\u0dda \u0dc4\u0daf\u0db1\u0dca\u0db1 \u0d87\u0dad\u0dca\u0dc3\u0dad\u0dca, \u0d92 \u0dad\u0dd2\u0dc3\u0db6\u0db1 \u0daf\u0dad\u0dca\u0dca\u200d \u0d91\u0d9a\u0dca\u0d9a. \u0dca\u200d\u0dc0 \u0dd9\u0dab\u0dd9 8\u0d9a\u0dca \u0d89\u0dad\u0dd4\u0db8\u0dbb\u0dd4 \u0dc3\u0dc0\u0dbd\u0dab \u0dad\u0dd2\u0dc3\u0db6\u0db1\u0dc0\u0dab. \u0d85\u0db4\u0dd2 \u0dd9\u0db1\u0dca\u0dc3\u0dca\u200d\u0ddd\u0dc2 \u0dc3\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1, FR \u0db1\u0dd4 \u0d85\u0dd4 \u0dc3\u0dc0\u0db1\u0dc0\u0dab \u0db1 . \u0d92 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0db1\u0dca \u0dc3\u0dd9\u0dab\u0d9a\u0d9a\u0dca\u0daf? \u0dbb\u0da2\u0dca\u200d\u0dba, \u0dc0\u0dd2\u0db0\u0db1\u0dab\u0dba\u0d9a\u0dba \u0dd2\u0dbd\u0db1\u0dd2\u0dd9\u0dca\u0dc3\u0dd4\u0db1\u0dca\u0dc3 \u0dd9\u0dab\u0db1\u0dc0 \u0dc4\u0dd2\u0dd2\u0dbd\u0d9a \u0dc3\u0dbd\u0dca\u0dbd\u0d82\u0d9d\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dc3\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0 \u0d9a\u0dd2\u0dba\u0db1 \u0dd9\u0dca\u200d\u0dba. \u0dc0\u0dd2\u0dc0\u0dab\u0daf\u0