dbb \u0daf\u0dd2\u0dca\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dca\u200d\u0dbb\u0db8\u0dca\u0db1\u0db4\u0dcf\u0daf\u0db1 \u0dca\u0dc4\u0dc3 \u0d86\u0dca\u0dd2\u0d9a \u0dca\u0d9c\u0dc0\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0dba\n\n2026004006 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0dc0\u0d9a\u0dcf\u0dc5\u0db9 010\n\n(\u0d85\u0db8\u0dcf\u0dad\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dc0\u0dda \u0d85\u0db1\u0dd4\u0db8\u0dd2\u0db1\u0dba \u0daf\u0dca\u0dc0\u0dcf \u0dd2\u0db1\u0dc0\u0dda0 \"\n\n\u0db4\u0dca\u200d\u0dbb\u0d9b\u0db4\u0db1\u0dba \u0dc0\u0dd2\u0db8\u0dca\u0db1 \u0dbd\u0daf\u0dd2\u0dca \u0dca\u0db7\u0dcf \u0dca\u0db1\u0db8\u0dad \u0dc0\u0dd2\u0dba0 \u0bb5\u0bbf\u0bc8\u0bbe \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0baa\u0b95\u0bbe\u0bb3\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. Question put, and agreed to.\n\nII \u0db8\u0db1\u0dca \u0dbb\u0dcf\u0db8\u0dbd\u0dd2\u0db8\u0d9c\u0db8\u0db1 \u0dca\u0dbb\u0dc0\u0dca\u0db4\u0d9a\u0dca \u0db8\u0dc4\u0dc3\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bb0\u0bbe\u0bae\u0bb2\u0bbf\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0b9a\u0b9a\u0b95\u0bb0\u0bcd) (The Hon. Ramalingam Chandrasekar) \u0db8\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0d9a\u0dcf\u0dbb\u0d9a \u0dca\u0db7\u0dcf \u0dca\u0db7\u0dcf\u0db4\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0dd2\u0dba\u0db1\u0dd2 \u0d85\u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dcf\u0dad\u0dba \u0dca\u0dc4\u0dc3 \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1 \u0dda\u0dca\u0dca\u0db4 \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1 \u0dca\u0dc4\u0dc3 \u0dc0\u0dca\u0dad\u0dca\u0dad\u0dd3\u0dba \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dad\u0dd4 \u0db8\u0dd2\u0dba \u0dc0\u0dc0\u0db1\u0dd4\u0dc0\u0dc0\u0dca \u0db8\u0dcf \u0db4\u0dc4\u0dc3\u0dad \u0dca\u0db3\u0dc4\u0dc3\u0dca \u0dc0\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf\u0dc0 \u0dca\u0daf\u0dd2\u0dd2\u0dba\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf:\n\n\"2025 \u0d85\u0d9c\u0d9a 3 \u0daf\u0dbb\u0db1 \u0dc0\u0dd2\u0dca\u0dca\u0da2\u0dca\u200d\u0db1 \u0db4\u0db1\u0dc0\u0dad\u0dca 8 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0db8\u0dca\u0dd2\u0db1\u0dba \u0dba \u0dc0\u0dad\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dca\u200d\u0dbb\u0db8\u0dca\u0db1\u0db4\u0dcf\u0daf\u0db1 \u0dca\u0dc4\u0dc3 \u0d86\u0dca\u0dd2\u0d9a \u0dca\u0d9c\u0dc0\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0dbb\u0dba\u0dcf \u0db4\u0dd0\u0dc0\u0db1\u0dca\u0db1 \u0db6\u0dbd\u0dad\u0dbd \u0d85\u0db1\u0dd4\u0dc0 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dda \u0d85\u0db1\u0dd4\u0db8\u0dd2\u0db1\u0dba \u0d87\u0dd2\u0db1\u0dc0 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dca\u200d\u0dbb\u0db8\u0dca\u0db1\u0db4\u0dcf\u0daf\u0db1 \u0dca\u0dc4\u0dc3 \u0d86\u0dca\u0dd2\u0d9a \u0dca\u0d9c\u0dc0\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0dbb\u0dba\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0dca \u0dca\u0dcf\u0daf\u0db1 \u0dbd\u0daf \u0db4\u0dc4\u0dc3\u0dad \u0daf\u0dd0\u0dca\u0dc0\u0dc0\u0db1 \u0d85\u0d9c\u0d9a 38 \u0daf\u0dbb\u0db1 \u0db1\u0dd2\u0dba\u0db8\u0dba \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0dba\u0dd0\u0dba\u0dd2 \u0dc0\u0db8\u0db8 \u0db4\u0dcf\u0dca\u0dbd\u0dd2\u0db8\u0dc0\u0db1\u0dca\u0dad\u0dd4 \u0dc0 \u0dc0\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dcf \u0dca\u0db1\u0db8\u0dad \u0d9a\u0dbb\u0dba\u0dd2:-\n\n2025 \u0d85\u0d9c\u0d9a 3 \u0daf\u0dbb\u0db1 \u0dc0\u0dd2\u0dca\u0dca\u0da2\u0dca\u200d\u0db1 \u0db4\u0db1\u0dc0\u0dad\u0dca 8 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0db8\u0dca\u0dd2\u0db1\u0dba\n\n\u0dba \u0dc0\u0dad\u0dca \u0d85\u0d9c\u0d9a 38 \u0daf\u0dbb\u0db1 \u0db1\u0dd2\u0dba\u0db8\u0dba\n\n\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dca\u200d\u0dbb\u0db8\u0dca\u0db1\u0db4\u0dcf\u0daf\u0db1 \u0dca\u0dc4\u0dc3 \u0d86\u0dca\u0dd2\u0d9a \u0dca\u0d9c\u0dc0\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0dba \u0d8