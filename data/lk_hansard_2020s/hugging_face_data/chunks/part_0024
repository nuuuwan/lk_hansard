    "chunk_text": "2019 43,154 25,979 9,651 27,058 105,843 2020 50,120 31,692 8,537 29,779 120,128 2021 63,785 40,152 13,758 45,083 162,777\n\n2022 75,542 70,373 22,345 54,076 222,336\n\n2023 95,700 73,205 36,484 88,038 292,049 2024 118,469 74,231 23,901 90,760 305,975\n\n(\u0d85) (i) 1949 \u0dd4\u0daf\u0dbd\u0dca \u0db8\u0dd3\u0db8\u0dd2\u0db8\u0dba\u0db1\u0dd2\u0dca\u0db8\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0db4\u0dd2\u0dc0 \u0db8\u0dba\u0dc3\u0dd4\u0dcf\u0db8\u0dba\u0db1\u0dca\u0db8\u0dc3\u0dca\u0dc4\u0db8\n\n\u0dc0\u0dd2\u0dbb\u0daf \u0d9c\u0dca\u0dcf\u0db1\u0db8\u0dca\u200d\u0dbd\u0db8\u0dc0\u0dd2\u0dbb\u0daf\u0db8\u0dd2\u0dd9\u0dba\u0dca\u0dda \u0db8\u0d85\u0dd2\u0db6\u0dd2\u0dcf\u0daf\u0dc3\u0dd2\u0dd9 \u0db8\u0d86\u0dba\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0daf\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0db8\u0dc4\u0daf\u0db8\u0dd9\u0daf\u0dbd\u0dd3\u0db1\u0db8\u0dc0\u0dd2\u0dbb\u0daf \u0db8\u0dcf\u0db4\u0da7\u0dd4\u0db4\u0dca\u0db8\u0dc3\u0dca\u0d82\u0dda \u0ddd\u0db0\u0db1\u0db8\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dca\u0dd2\u0dba\u0da7 \u0db8\u0d85\u0dbd\u0daf\u0dc5\u0db8\u0dcf\u0d9c\u0d9a\u0dd3 \u0db8\u0dd2\u0da7\u0dd4\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0db8\u0dc3\u0dca \u0dbb\u0dca\u0db0\u0dda\u0dba\u0dca\u0db8\u0dda\u0d9c\u0db1\u0db8\u0d87\u0dd2\u0db8\u0dad\u0dd3\u0dba\u0dda\u0db8\u0dc3\u0dca\u0dc4\u0db8\u0d86\u0dba\u0dc0\u0dd2\u0dba\u0dd9\u0db8\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dca\u0dd2 \u0db8\u0dba\u0daf\u0dca\u200d\u0dd9\u0db8 \u0dab\u0dca\u0da9\u0db4\u0dca\u200d\u0dba\u0db8\u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0db8\u0d85\u0d9b\u0dca\u200d\u0dab\u0dca\u0da9\u0db4\u0dcf\u0db8\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dca \u0dd9\u0db8\u0dd9\u0dba\u0dca\u0dda\u0dca\u0dbd; (ii) \u0dda\u0db1\u0daf\u0d91\u0dda\u0dc3\u0dca\u0dad\u0db8\u0db1 \u0db8\u0dc0\u0dd2\u0dbb\u0daf\u0db8\u0dd2\u0dd9\u0dba\u0dca\u0db8\u0d86\u0dcf\u0dba\u0dda\u0dba\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0da7 \u0db8\u0d9c\u0db1\u0dd4\u0db8\u0dca\u200d\u0dbb\u0db1\u0db8\u0db4\u0dd2\u0dba\u0dcf\u0dba\u0db8\u0dd9\u0dcf\u0dda\u0dbb\u0dca\u0dbd; \u0dba\u0dca\u0db1\u0db8\u0d91\u0dad\u0dd4\u0db8 \u0daf\u0db8\u0dda \u0db8\u0dc3\u0dca\u0db7\u0daf\u0dcf\u0da7 \u0db8\u0dbd\u0dca\u0dcf\u0dca\u0dda\u0dca\u0dbd; (\u0d87) \u0dda\u0db1\u0daf\u0d91\u0dda\u0dc3\u0dca\u0dad\u0db8\u0db1 \u0db8\u0d92\u0db8 \u0dca\u0dbd? \u0ba8\u0bbf\u0ba4\u0bbf, \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bbf\u0b9f\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0baa\u0bbe\u0bb0\u0bc1\u0bb3\u0bbe\u0ba4\u0bbe\u0bb0 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0b95\u0bb0\u0b95\u0bcd \u0baa\u0b95\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0ba9\u0bbe:\n\n(\u0b85) (i) 1949\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0ba8\u0bbe\u0ba3\u0baf \u0bb5\u0bbf\u0ba4\u0bbf\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0bbf\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd, \u0b9a\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bcd\u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0bb5\u0bbf\u0baa\u0b9a\u0b9f \u0baa\u0ba3\u0bbf\u0b95\u0bb3\u0bcd \u0b95\u0baa\u0bbe\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0b9a\u0bcd \u0b95\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0ba8\u0bcd\u0ba4 \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0b95 \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bb5\u0b99\u0bcd\u0b95\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9 \u0bbe\u0bc0\u0ba4\u0bbf\u0baf\u0bbe\u0ba9 \u0b87\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bc1, 2023\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bb5\u0b99\u0bcd\u0b95\u0bbf\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bc1\u0bae\u0bcd \u0b95\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0baf\u0bbe\u0b95\u0b9a\u0bcd \u0b95\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0b95\u0ba4\u0baf\u0bc1\u0bae\u0bcd; (ii) \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bb5\u0b99\u0bcd\u0b95\u0bbf\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd XIX\u0b86\u0bae\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0b95\u0bae\u0baf 2023.09.15\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba4\u0bbe\u0b95 \u0ba8\u0bbe\u0ba3\u0baf \u0bb5\u0bbf\u0ba4\u0bbf\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0baa\u0bb5\u0bb1\u0bc1 \u0b8f\u0baa\u0ba4\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0ba8\u0bbe\u0ba3\u0baf\u0b9a\u0bcd \u0b9a\u0b95\u0baa\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b89\u0bbe\u0bbf\u0b95\u0bae\u0b95\u0b95\u0bb3\u0baf\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0b95\u0ba3\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd/\u0b95\u0baa\u0bbe\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0b95\u0bb3\u0baf\u0bc1\u0bae\u0bcd \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bb5\u0b99\u0bcd\u0b95\u0bbf \u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bbf\u0b95\u0bcd\u0b95 \u0baa\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0b95\u0ba4\u0baf\u0bc1\u0bae\u0bcd; (iii) \u0ba8\u0bbe\u0ba3\u0baf \u0bb5\u0bbf\u0ba4\u0bbf\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0baa\u0bb5\u0bb1\u0bc1 \u0b8f\u0baa\u0ba4\u0ba9\u0bc1\u0bae\u0bcd\n\n\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0ba8\u0bbe\u0ba3\u0baf\u0b9a\u0bcd \u0b9a\u0b95\u0baa\u0baf\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0baa\u0bae\u0bb1\u0bcd\u0b95\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f / \u0b95\u0bb5\u0bb3\u0bbf\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0b95\u0b95\u0bb3\u0bcd, \u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0bb5\u0bc1\u0b95\u0bb3\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bb5\u0b99\u0bcd\u0b95\u0bbf\u0baf\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0baa\u0bae\u0bb1\u0bcd\u0b95\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0b95\u0bb5\u0baf\u0bbe\u0b95 /\u0b95\u0bb5\u0bb3\u0bbf\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0b95\u0bb5\u0baf\u0bbe\u0b95\u0b95\u0bcd \u0b95\u0bb0\u0bc1\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bb2\u0bcd \u0baa\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bae\u0ba9\u0bcd\u0baa\u0b95\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n\u0b85\u0bb5\u0bb0\u0bcd \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bbe\u0bb3\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bbe\u0bb0\u0bbe? (\u0b86) (i) \u0ba8\u0bbe\u0ba3\u0baf\u0b9a\u0bcd \u0b9a\u0b95\u0baa\u0baf\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd 2023.09.15\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba4\u0bbe\u0b95 \u0b93\u0baf\u0bcd\u0bb5\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b93\u0baf\u0bcd\u0bb5\u0bc2\u0ba4\u0bbf\u0baf\u0ba4\u0bbe\u0bb0\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b89\u0bbe\u0bbf\u0b95\u0bae\u0b95\u0b95\u0bb3\u0baa\u0bcd \u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bae\u0b95\u0bbe\u0bb2 \u0b93\u0baf\u0bcd\u0bb5\u0bc2\u0ba4\u0bbf\u0baf\u0ba4\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0b95\u0bcd \u0b95\u0b95\u0bbe\u0bb3\u0bcd\u0b95\u0b95\u0b95\u0bcd\u0b95\u0bc1\u0bbe\u0bbf\u0baf \u0b95\u0baa\u0bbe\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0b95\u0bb3 \u0ba8\u0bbf\u0b95\u0bb1\u0baa\u0bb5\u0bb1\u0bcd\u0bb1\u0bc1\u0ba4\u0bb2\u0bcd \u0b95\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0b95 \u0baa\u0bae\u0bb1\u0bcd\u0b95\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0ba9\u0b99\u0bcd\u0b95\u0b95\u0bb3\u0baf\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0b95\u0bcd \u0b95\u0b95\u0bbe\u0bb3\u0bcd\u0b95\u0b95\u0b95\u0b95\u0bb3\u0baf\u0bc1\u0bae\u0bcd \u0b86\u0bb3\u0bc1\u0bae\u0bcd \u0b9a\u0b95\u0baa \u0b95\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0baf\u0bbe\u0b95 \u0ba8\u0b95\u0b9f\u0bae\u0bc1\u0b95\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bbe \u0b8e\u0ba9\u0bcd\u0baa\u0b95\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n1767 1768\n\n[\u0d9c\u0dbb\u0dd4\u0db8\u0dda\u0d9a\u0dca\u0dc0.\u0da9\u0dd3.\u0db8\u0dca\u200d\u0daf\u0dca \u0db8\u0dd9\u0daf\u0dca\u0dc0\u0db8 \u0dc4\u0dc0\u0daf]\n\n2026 \u0db4\u0dd2\u0db6\u0db8\u0db819\u0db8\n\n(ii) \u0b87\u0ba9\u0bcd\u0baa\u0bb1\u0bb2\u0bcd, \u0b93\u0baf\u0bcd\u0bb5\u0bc2\u0ba4\u0bbf\u0baf\u0ba4\u0bbe\u0bb0\u0bb0\u0bcd\u0b95\u0b95\u0bb3 \u0b89\u0bb3\u0bcd\u0bb5\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0baa\u0bae\u0bb1\u0bcd\u0b95\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0b95\u0b95\u0bb3\u0bcd \u0baf\u0bbe\u0b95\u0bb5 \u0b8e\u0ba9\u0bcd\u0baa\u0b95\u0ba4\u0baf\u0bc1\u0bae\u0bcd;"
