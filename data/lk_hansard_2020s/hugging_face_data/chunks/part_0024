0da9\u0dca \u0dd4\u0dbb\n\n\u0dc0\u0dd2\u0dba\u0daf\u0dda \u0bb5\u0bc0\u0ba4\u0bbf\u0b95\u0bb3\u0bcd \u0bc7\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0bbf\u0bae\u0bb5\u0b95 \u0ba4\u0ba8\u0b9f\u0bc1\u0b9e\u0bcd\u0b9a\u0bc6\u0bbe\u0bae\u0bb2\u0b95\u0bb3\u0bcd:\n\n\u0ba8\u0bbf\u0bb0\u0bcd\u0bc7\u0bc6\u0bbe\u0ba3\u0bae\u0bcd \u0bc7\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0baa\u0ba3\u0bc1\u0bae\u0b95\u0b9a\u0bcd \u0ba4\u0b9a\u0bb2\u0bb5\u0bc1\u0b95\u0bb3\u0bcd ROADS AND EXPRESSWAYS: CONSTRUCTION AND\n\nMAINTENANCE COSTS\n\n468/2025 3. \u0d9c\u0dd4 \u0dad\u0dd3 \u0d9a\u0dd4\u0dab\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dad\u0dad\u0dcf\n\n(\u0bc7\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc7\u0bbf\u0b95\u0bc1 \u0bb0\u0bb5\u0bbf \u0b95\u0bb0\u0bc1\u0ba3\u0bc6\u0bbe\u0ba8\u0bc6\u0bbe\u0baf\u0b95\u0bcd\u0b95) (The Hon. Ravi Karunanayake) \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dd2\u0dc4\u0db1 \u0db8\u0dc4\u0dd2\u0db8\u0dd2\u0dbb\u0dca\u0db8 \u0dc3\u0dc4 \u0db1\u0dd2\u0db8\u0db4\u0dad\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dd2\u0dad\u0dba\u0dad\u0dd4\u0db8\u0dd2\u0db8\u0db8\u0db1\u0dca \u0dad\u0dd6 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1\u0dba- (1):\n\n(\u0d85) (i) \u0db8\u0dd2\u0dbb\u0dca\u0db8 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0dd2\u0d9a\u0dd2\u0db4\u0dad\u0db8\u0dd3 \u0db8\u0dda \u0dc0\u0db1\u0dc0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dca\u0dba \u0db8\u0dab\u0dca\u0da9\u0da9\u0d9a \u0dc3\u0dd2\u0db8\u0dd2\u0da2\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0d9b\u0dba\u0dd2\u0dc0 \u0db8\u0d9a\u0dd2\u0db4\u0db8\u0dab\u0daf;\n\n(ii) \u0db8\u0db0\u0dba\u0db8 \u0dbb\u0dba\u0dba \u0dc3\u0dc4 \u0db4\u0dc5\u0dd2\u0dad\u0dca \u0dc3\u0db7\u0dd2 \u0dba \u0db8\u0dad\u0dca \u0dad\u0dad\u0dd2 \u0db8\u0dd2\u0dbb\u0dca\u0db8\u0dc0\u0d9a \u0db8\u0dd4\u0dc5\u0dd4 \u0dd4\u0dbb \u0db8\u0dc0\u0db1\u0dca \u0db8\u0dc0\u0db1\u0dca \u0dc0 \u0db8\u0dba\u0db1\u0dca \u0dd2\u0dbb\u0db8\u0d9a\u0ddd\u0db8\u0dd3 \u0dbb\u0dc0\u0dd2\u0db1\u0dca \u0db8\u0d9a\u0dd2\u0db4\u0db8\u0dab\u0daf;\n\n(iii) \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dc0\u0dc3\u0dbb 05 \u0dad\u0dd4\u0dc5 \u0d91\u0db8 \u0db8\u0dd2\u0dbb\u0dca\u0db8\u0dc0\u0d9a \u0db1\u0da9\u0dad\u0dca\u0dad\u0dd4\n\n\u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0db3\u0dc4\u0dd2 \u0dc0\u0dd2\u0dbb\u0dca \u0d9a\u0dc0 \u0daf\u0dbb\u0db1 \u0d9a\u0daf \u0db4\u0dd2\u0db4\u0dad\u0dc0\u0dd0\u0dba \u0db8\u0dc0\u0db1\u0dca \u0db8\u0dc0\u0db1\u0dca \u0dc0 \u0db8\u0dba\u0db1\u0dca \u0db8\u0d9a\u0dd2\u0db4\u0db8\u0dab\u0daf;\n\n(iv) \u0db1\u0dc0 \u0db8\u0dd2\u0dbb\u0dca\u0db8 \u0dd2\u0daf\u0dd2\u0dd2\u0dbb\u0dd3\u0db8\u0db8 \u0dc3\u0db3\u0dc4\u0dd2 \u0dd2\u0dbb\u0db8\u0d9a\u0ddd\u0db8\u0dd3 \u0dbb\u0dba\u0d9a \u0daf\u0dbb\u0db1 \u0db4\u0dd2\u0db4\u0dad\u0dc0\u0dd0\u0dba \u0db8\u0d9a\u0dd2\u0db4\u0db8\u0dab\u0daf;\n\n(v) \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0dd2\u0daf\u0dd2\u0dd2\u0dbb\u0dd3\u0db8\u0dda \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0db8\u0db4\u0dc0\u0daf\u0dca\u0db0\u0db8\u0dd2\u0d9a \u0dc3\u0db8\u0dd2\u0db8\u0dda\u0dc0\u0d9a \u0d9a\u0d82\u0dd2\u0dd4\u0db1\u0dca \u0dc0\u0dd2 \u0dd2\u0dbb\u0db8\u0d9a\u0ddd\u0db8\u0dd3 \u0dbb\u0dba\u0d9a \u0daf\u0dbb\u0db1 \u0db4\u0dd2\u0db4\u0dad\u0dc0\u0dd0\u0dba \u0db8\u0d9a\u0dd2\u0db4\u0db8\u0dab\u0daf;\n\n\u0dba\u0db1\u0dca\u0db1 \u0d91\u0dad\u0dd4\u0db8\u0dd2 \u0db8\u0db8\u0db8 \u0dc3\u0db7\u0dd2\u0dc0 \u0daf\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db8\u0db1\u0dca\u0daf?\n\n(\u0dca) (i) \u0db8\u0dda \u0dc0\u0db1\u0dc0\u0dd2 \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0db1 \u0d85\u0dd2\u0db8\u0dc0 \u0db8 \u0db8\u0dd2\u0dbb\u0dca\u0db8 \u0dc3\u0d82\u0d9b\u0dba\u0dd2\u0dc0 \u0dc3\u0dc4 \u0d92\u0dc0\u0dd2\u0db8\u0dd3 \u0db1\u0dda \u0d9a\u0dc0\u0db8\u0dbb\u0dca\u0daf;\n\n(ii) \u0dd2\u0dc4\u0dad (i)\u0dc4\u0dd2 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d85\u0dd2\u0db8\u0dc0 \u0db8 \u0db8\u0dd2\u0dbb\u0dca\u0db8\u0dc0\u0d9a \u0db8\u0dd4\u0dc5\u0dd4 \u0dd4\u0dbb \u0dc3\u0dc4 \u0dc0\u0dd2\u0dbb\u0dca \u0d9a \u0db1\u0da9\u0dad\u0dca\u0dad\u0dd4 \u0db4\u0dd2\u0db4\u0