    "chunk_text": "\u0dd6\u0dbd\u0dca\u200d\u0daf\u0dc3\u0dca\u0db1\u0daf\u0dbb\u0dd6\u0daa\u0db8\u0d9c\u0dbb\u0dd4\u0db8 \u0dca\u0dd3\u0dad\u0dd4\u0db8 \u0dd2\u0dba \u0db8 \u0db8\u0d8b\u0dbd\u0daf\u0dc4\u0dba\u0dda\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0d9a\u0dd2\u0dba\u0dca\u0db1 \u0db8\u0dda \u0db8\u0da2\u0daf\u0dd2\u0dcf\u0daf\u0dd3\u0db1\u0db8\u0dda\u0daf\u0dca\u0db0 \u0dba\u0daf\u0dca\u200d\u0db1\u0dba\u0db8\u0dc3\u0dca \u0dbb\u0dca\u0db0\u0dcf.\u0db8 \u0db8\u0dda \u0db8\u0d9a\u0dd2\u0dba\u0dca\u0dda\u0dca\u0db8\u0d91\u0dd9 \u0db8\u0dc4\u0dd2\u0db8\u0dd2\u0dd9\u0dbb\u0dd4\u0dcf\u0daf\u0dda \u0db8\u0dba\u0dca\u0dc0\u0dba\u0dba\u0db8\u0d9c\u0db4\u0db1.\u0db8\u0dca\u200d\u0d82\u0dd9\u0daf\u0dda\u0dc1\u0db8\u0da2\u0daf\u0dd2\u0dcf\u0daf\u0dd3\u0db1\u0db8\u0dda\u0daf\u0dca\u0db0 \u0dba\u0daf\u0dca\u200d\u0db1\u0dda \u0db8 \u0dc4\u0db8\u0dda \u0daf\u0dc5\u0dd9\u0dbb\u0dd4\u0dda\u0dcf\u0ddd\u0db8\u0dda \u0db8\u0dba\u0daf\u0dbb\u0dca\u0dd2\u0db1\u0dda \u0dca\u0dad\u0dd4\u0db8\u0dda\u0dc1\u0dca\u0db8\u0dd2\u0dca\u0db1\u0dcf\u0daf.\u0db8\u0dda \u0db8\u0d91\u0dd9 \u0db8\u0db4\u0dd4\u0dcf\u0dca\u0db8\u0dba\u0dc0\u0dd9\u0db8\u0d85\u0dd2\u0db6\u0dd2\u0dd9\u0dbb\u0dd4\u0dcf\u0daf.\u0db8\u0dda \u0db8\u0dba\u0daf\u0dbb\u0dca\u0dd2\u0db1\u0dda \u0dca\u0dad\u0dd4\u0db8\u0dda\u0dc1\u0db8\u0dd2\u0dca\u0db1\u0db8\u0dbb\u0dd2\u0dd2\u0db1\u0dca\u0db8\u0da2\u0dba\u0dc0\u0dd3\u0db8\u0dba\u0db8 \u0dc4\u0dca \u0dba\u0daf\u0da7 \u0db8\u0d85\u0dd2\u0db6\u0dd2 \u0db8\u0db8\u0dda\u0dbd\u0dba\u0dda\u0db8\u0db8\u0db1\u0daf\u0dc5\u0dd2\u0dd9\u0daf\u0dda\u0dc1\u0db8\u0dc4\u0dd2\u0db8\u0dd2\u0dd9\u0dbb\u0dd4\u0da7 \u0db8\u0d85\u0dd2\u0db6\u0dd2 \u0db8\u0dda\u0dbd \u0dc5\u0db8 \u0daf\u0db0\u0dba\u0db8\u0db4\u0dd4\u0dcf\u0dca\u0db8\u0dba\u0dc0\u0db8\u0db8\u0dc0\u0db8\u0dd2\u0dca\u200d\u0dca\u0db8 -\u0dc3\u0dd2\u0d82\u0dc4\u0dca\u200d\u0db8\u0db4\u0dd4\u0dcf\u0dca\u0db8\u0dba\u0dda\u0dca\u0db8\u0db1 \u0db8\u0db8\u0d85\u0dbb\u0dd4\u0dda\u0db8\u0db8-\u0db8\u0dbb\u0dd6\u0dba\u0dcf\u0daf\u0dc4\u0dd2\u0dd3\u0db8\u0db8\u0db1\u0daf\u0dc5\u0dd2\u0dd9\u0daf\u0dda\u0dc1\u0db8\u0db1 \u0db8\u0db8\u0dda\u0dbd\u0dba\u0dda\u0db8\u0db8\u0dbb\u0dcf\u0db8\u0d85\u0db4\u0dd2\u0db8\u0dbd\u0dca\u0db1\u0dcf\u0daf.\u0db8\u0d91\u0dd9 \u0db8\u0d85\u0dd2\u0db6\u0dd2\u0dd9\u0dbb\u0dd4\u0dcf\u0daf \u0db8\u0d91\u0dd9 \u0db8\u0dda\u0daf\u0dca\u0db0 \u0dba\u0daf\u0dca\u200d\u0db1\u0db8\u0dcf\u0dba\u0daf\u0dba\u0daf\u0dba\u0dba \u0db8\u0d91\u0dd9 \u0db8\u0da2\u0daf\u0dd2\u0dcf\u0daf\u0dd3\u0db1\u0db8\u0dda\u0daf\u0dca\u0db0 \u0dba\u0daf\u0dca\u200d\u0db1\u0dba\u0db8\u0dc3\u0dca \u0daf\u0da2\u0db8\u0dd9\u0dab\u0dca\u0da9\u0db4\u0daf\u0dba \u0db8\u0dda\u0dbd\u0dd9\u0d9a\u0dca\u0dc0\u0db8\u0d85\u0dc0\u0dba \u0db8\u0da2\u0db1\u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0db8\u0dda\u0dbd\u0dd9\u0d9a\u0dca\u0dc0\u0db8\u0d85\u0dc0\u0dba\u0db8\u0dcf\u0db4\u0db4\u0db8\u0dd9\u0dba\u0db1\u0db8\u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0db8\u0dda \u0db8\u0dd2\u0dda\u0dbb\u0dca\u0dda\u0dca.\u0db8\u0d8a\u0dda \u0db8\u0db8\u0dda\u0dbd\u0dba\u0dda\u0db8\u0db8\u0db1\u0daf\u0dc5\u0dd2\u0dd9\u0daf\u0dcf\u0db8\u0d85\u0dd2\u0db6\u0dd2\u0dd9\u0dbb\u0dd4\u0dcf\u0daf\u0dda \u0db8\u0dbb\u0dd2\u0dd2\u0db1\u0dca\u0db8\u0da2\u0dba\u0dc0\u0dd3\u0db8\u0dba\u0db8 \u0dc4\u0dca \u0dba\u0daf\u0dda \u0db8\u0dda\u0dbd \u0dc5\u0db8 \u0daf\u0db0\u0dba\u0db8\u0db8\u0dc0\u0db8\u0dd2\u0dca\u200d\u0dca\u0db8\u0db8\u0db4\u0dd4\u0dcf\u0dca\u0db8\u0dba\u0dda\u0dca\u0db8\u0db8headline \u0d91\u0dda\u0d9a\u0dca\u0dc0\u0db8\u0dda \u0dda\u0dc3\u0dca\u0dad\u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0dca\u0db8\u0dcf\u0db1\u0dcf\u0daf:\u0db8\n\n\u2018\u0b95\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd \u0baa\u0baa\u0bbe\u0bb0\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bae \u0ba4\u0bae\u0bbf\u0bb4\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b95\u0ba4\u0bbe\u0bbf\u0bb5\u0bc1\u2019 \u2018\u0ba4\u0bae\u0bbf\u0bb4\u0bbf\u0ba9\u0baa\u0bcd \u0baa\u0b9f\u0bc1\u0b95\u0b95\u0bbe\u0b95\u0bb2 \u0ba8\u0bbf\u0b95\u0ba9\u0baa\u0bb5\u0ba8\u0bcd\u0ba4\u0bb2\u0bcd \u0b87\u0ba9\u0bcd\u0bb1\u0bc1\u2019\n\n\u0b87\u0ba8\u0bcd\u0ba4\u0ba4\u0bcd \u0baa\u0ba4\u0b9a\u0bbf\u0baf \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0b95\u0bcd\u0ba4\u0bbf \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd, \u0b85\u0ba8\u0bcd\u0ba4 \u0b87\u0ba9\u0bb5\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b8e\u0ba4\u0bbf\u0bb0\u0bbe\u0b95 \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bbe\u0b95\u0b9a\u0bcd \u0baa\u0b9a\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1, \u0b92\u0ba9\u0bcd\u0bb1\u0bbf\u0b95\u0ba3\u0ba8\u0bcd\u0ba4\u0bc1 \u0b89\u0bb0\u0bc1\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bbf\u0baf \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd. \u0b95\u0bbe\u0b99\u0bcd\u0baa\u0b95\u0b9a\u0ba9\u0bcd \u0ba4\u0bc1\u0b95\u0bb1\u0baf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0ba4\u0bbf\u0bb8\u0bcd\u0bb8\u0bae\u0bb9\u0bb0\u0bbe\u0bae \u0bb5\u0b95\u0bb0\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd, \u0b95\u0bae\u0bcd\u0baa\u0bb9\u0bb5\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0ba4\u0bbf\u0bb0\u0bc1\u0baa\u0b95\u0bbe\u0ba3\u0bae\u0b95\u0bb2 \u0bb5\u0b95\u0bb0\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0b9f\u0bcd\u0baa\u0b9f\u0bbe\u0b9f \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0baa\u0bcd\u0baa \u0b92\u0ba9\u0bcd\u0bb1\u0bbe\u0b95 \u0ba8\u0bbf\u0bb1\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9\u0bb0\u0bcd. \u0b87\u0baa\u0bcd\u0baa \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0b95 \u0b85\u0ba8\u0bcd\u0ba4 \u0b8e\u0bb2\u0bcd\u0baa\u0bb2\u0bbe\u0bb0\u0bc1\u0b95\u0b9f\u0baf \u0ba8\u0bbe\u0b9f\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b85\u0ba4\u0bc1\u0ba4\u0bbe\u0ba9\u0bcd \u0ba8\u0bae\u0b95\u0bcd\u0b95\u0bc1 \u0baa\u0bb5\u0ba3\u0bc1\u0bae\u0bcd. \u0db8\u0dd3\u0da7 \u0db8\u0db8\u0db8\u0dcf\u0db4\u0daf\u0db8\u0db8\u0db8\u0dda \u0daf\u0dd9\u0d9a\u0dca\u0dc0\u0dbd\u0db8\u0db8\u0db8\u0d85\u0dba\u0da7 \u0db8\u0db8\u0db8\u0d95\u0db1\u0dd1?\u0db8\u0db8\u0db8\u0db8\u0db8\u0db8\u0db8\u0dc3\u0dca\u0d82\u0dc4\u0dd2\u0dd2 \u0dba\u0daf\u0dcf\u0da7 \u0db8 \u0dbb\u0daf\u0db0\u0daf\u0db8\u0dd9\u0dba\u0db1 \u0db8\u0da2\u0daf\u0dd2\u0dd9\u0db8\u0dc3\u0dca \u0dd2\u0dba\u0da7 \u0db8\u0dbb\u0daf\u0db0\u0daf\u0db8\u0dd9\u0dba\u0db1 \u0db8\u0d92\u0db8\u0da2\u0daf\u0dd2\u0dcf\u0daf\u0dd3\u0db1\u0db8\n\n\u0dda\u0daf\u0dca\u0db0 \u0dba\u0daf\u0dca\u200d\u0db1\u0dba\u0da7 \u0db8\u0d85\u0db4\u0dd2\u0db8\u0dd2\u0db4\u0db8\u0dda\u0dbd\u0dca\u0dda\u0dca\u0db8\u0db1\u0db4\u0dc4\u0db4.\u0db8\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dda\u0daf \u0dca\u200d\u0dba\u0db8\u0dbb\u0dd2\u0dc3\u0dca\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dc0\u0dd9\u0dda\u0dba\u0dca\u0db8\u0dba\u0db4\u0db8\u0dd2\u0dab\u0dd2\u0db8 \u0dca\u0dd3\u0dcf\u0dba\u0dda\u0dba\u0d9a\u0dd4\u0db8\u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0da7 \u0db8 \u0db8\u0dda \u0db8\u0dba\u0daf\u0dbb\u0dca\u0dd2\u0db1\u0dda \u0dca\u0dad\u0dd4\u0db8\u0dda\u0dc1\u0dd3\u0db1\u0db8\u0db7\u0dba\u0db8\u0db1\u0db4\u0dd2\u0dcf\u0db8\u0d9a\u0dd2\u0dba\u0dca\u0db1\u0db8\u0dd9\u0db4 \u0db4\u0dd2\u0dd2\u0db6 \u0db8\u0d85\u0db4\u0dd2\u0db8\u0d92\u0dd9\u0da7 \u0db8\u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0\u0db0\u0dcf\u0db8\u0dc3\u0dca\u0da7 \u0dca\u0db8\u0dd9\u0dba\u0db1\u0dcf\u0daf\u0dba\u0db8\u0d9a\u0dd2\u0dba\u0db1\u0db8\u0d91\u0dd9.\u0db8\n\n\u0dc4\u0db4 \u0db8\u0dbd\u0daf \u0db8\u0d8b\u0dda\u0daf\u0dca\u0db0\u0da7 \u0db8\u0dda \u0dc0\u0db4\u0db1\u0db8\u0db1\u0db4\u0da7\u0dd4 \u0db8\u0db1\u0da7 \u0db1\u0db8 \u0dca\u0dd3\u0db8\u0dda\u0dd9\u0dda\u0db1\u0d9a\u0dca\u0dc0\u0db8\u0d87\u0dc0\u0dd2\u0dca \u0dca\u200d\u0daf \u0db8\u0dba\u0dd2\u0dba\u0dca \u0db8\u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb \u0dc3\u0dd2\u0d82\u0dc4\u0db8\u0dc4\u0dd2\u0da7 \u0db4\u0dd4\u0db8\u0dd9\u0daf\u0dca\u200d\u0dda \u0dd2\u0db6 \u0db8\u0dbd\u0db4\u0dca\u0db8\u0dd9\u0daf\u0dca\u200d\u0dba\u0dd2\u0db6\u0db8\u0d85\u0dc0\u0dba\u0db8\u0d85\u0dda\u0db4\u0dca\u0db8\u0d86\u0dbb\u0dca\u0dd2\u0dd9\u0dda \u0db8\u0dda\u0dcf\u0db1\u0dc3\u0dca\u0db8\u0db8\u0dda\u0dba\u0dca\u0db1\u0dca\u200d\u0daf\u0db8\u0dda\u0dbb\u0db4\u0dad\u0dc4\u0dca\u0db8\u0dd3\u0db1\u0dca\u200d\u0daf\u0db8\u0dd2\u0dba\u0daf.\u0db8\n\n\u0dd6\u0dbd\u0dca\u200d\u0daf\u0dc3\u0dca\u0db1\u0daf\u0dbb\u0dd6\u0daa\u0db8\u0d9c\u0dbb\u0dd4\u0db8 \u0dca\u0dd3\u0dad\u0dd4\u0db8 \u0dd2\u0dba \u0db8\u0d85\u0db4\u0dd2\u0db8\u0d9c\u0dc0\u0db8\u0dd9\u0dba\u0db1\u0db8\u0dda \u0db8\u0dc3\u0dca \u0dd9\u0daf\u0dbd\u0dd3\u0db1\u0db8\u0dda\u0dca\u200d\u0ddd\u0dd9\u0dba\u0db8\u0d9a\u0dd2\u0dba\u0dca\u0dda\u0dca \u0db8\u0dda\u0dbb\u0daf\u0dda\u0dc4\u0daf \u0db8\u0d85\u0dc0\u0dd2\u0dd2\u0dba \u0dad\u0da0\u0dd2\u0dc0\u0db8\u0dda\u0dca\u200d\u0ddd\u0dd9\u0dba\u0d9a\u0dca\u0dc0.\u0db8\u0dda \u0db8\u0dd2\u0db6\u0dd4\u0dab\u0dd4\u0db8\u0dbb\u0dca\u200d\u0db8\u0d86\u0d9a\u0dbb\u0dba\u0dc0\u0dba\u0dba\u0db8\u0db6\u0dd2\u0dc4\u0db8\u0dcf\u0db4\u0dda\u0da7 \u0db8\u0dd2\u0dca\u0db8\u0dba\u0db1 \u0db8\u0db1\u0dcf\u0db8\u0dbb\u0dca\u200d\u0db8\u0d86\u0d9a\u0dbb\u0dba\u0dc0\u0dba\u0dba\u0db8\u0dda\u0d9c\u0daf\u0db4\u0db8\u0db1\u0db4\u0db8\u0dda\u0d9f\u0db8\u0dd2\u0dca\u0db8\u0dba\u0db1\u0db8\u0dd9\u0daf\u0dca\u200d\u0dba\u0d9a\u0dca\u0dc0.\u0db8\u0dda\u0dbb\u0daf\u0dda\u0dc4\u0daf \u0db8\u0d85\u0dc0\u0dd2\u0dd2\u0dba \u0dad\u0da0\u0dd2\u0dc0\u0db8\u0dd9\u0daf\u0dca\u200d\u0db8\u0dba\u0db4\u0dad\u0da0\u0dca\u0dda\u0dda\u0dbd\u0dba\u0dd9\u0db8\u0d85\u0db4\u0dd2\u0db8\u0dd2\u0dca\u0dda\u0dca.\u0db8\u0db4\u0dd4\u0dda\u0dba\u0ddd\u0dd9\u0dcf\u0db1\u0dba\u0db8\u0dd9\u0dc5\u0db8\u0dc4\u0db4\u0d9a\u0dd2\u0db8\u0d91\u0dd9 \u0db8\u0dda\u0daf\u0dca\u0db0\u0db8\u0d85\u0dc0\u0dd2\u0dd2\u0dba \u0dad\u0da0\u0dd2\u0dc0\u0db7\u0daf\u0dcf\u0dba.\u0db8\u0dda \u0dd9\u0da7 \u0db8\u0d85\u0db4\u0dd2\u0db8\u0d86\u0dbb\u0dca\u0dd2\u0dd9\u0db8\u0dc0\u0dd2\u0dbd\u0dba\u0daf\u0dda\u0dc1\u0db8\u0d9a\u0dd2\u0dba\u0db1\u0dcf\u0daf \u0db8\u0dbb\u0daf\u0dc4\u0dd2\u0dba\u0db8\u0dd9 \u0dba\u0db1\u0dba\u0d9a\u0dca\u0dc0\u0db8-\u0db8supply shock -\u0db8\u0d9a\u0dd2\u0dba\u0dca\u200d\u0daf.\u0db8"
