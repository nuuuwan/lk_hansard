    "chunk_text": "\u0dd2\u0dc5\u0dd2\u0dad\u0db6\u0dc4 \u0dc0\u0dd2\u0dc2\u0dba\u0dba \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0d9a\u0dca \u0dc3\u0dc4\u0dd2 \u200d \u0dc3\u0dca\u0dc0\u0ddc\u0daf\u0dca\u0dc1 \u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d85\u0db8\u0dcf\u200d\u0dba\u0dcf\u0dc3\u0dc1\u0ddc \u0ddc\u0da2\u0dba\u0dc2\u0dba\u0dca\u0da8 \u0dba\u0dcf\u0dbd\u0db0\u0dca\u200d\u0dcf\u0dbb\u0dd2\u0ddc\u0dba\u0d9a\u0dd4\n\n\u2022 \u0d9a\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8\u0dba, \u0d85\u0ddc \u0dc0\u0dd2\u0d9a\u0dbb\u0dab\u0dba, \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0db1\u0dba, \u0db1\u0dd3\u0dad\u0dd2\u0dc3\u0dba \u0dc3\u0dc3 \u0db8\u0dd6\u0dbd\u0dba \u0dd2\u0dc5\u0dd2\u0dad\u0db6\u0dc4 \u0dc0\u0dd2\u0dc2\u0dba\u0dba \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0d9a\u0dca \u0dc3\u0dc4\u0dd2 \u200d \u0d9c\u0dbb\u0dd4 \u0ddc\u0dc0\u0ddc \u0dc4 \u0dc0\u0dd2\u0dc2\u0dba\u0dba \u0db7\u0dcf\u0dbb \u0d87\u0db8\u0dad\u0dd2\u0dc3\u0dad\u0dd4\u0db8\u0db8\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0db8\u0dca \u0d9a\u0dbb\u0db1 \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0db1\u0dca \u0db4\u0dc3\u0dca \u0ddc\u0daf\u0ddc\u0db1\u0d9a\u0dd4\n\n\u0ddc\u0db8\u0db8 \u0d85\u0db0\u0dca\u200d\u0dba\u0d9a\u0dca\u0dc2\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0ddc \u0dba\u0dcf\u0dbd \u0d9a\u0dcf\u0dbd\u0dba \u0d94\u0dd4\u0dbb\u0db1\u0dca \u0db4\u0dad\u0dca\u0dc0 \u0dc0\u0dd6 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2 \u0dc0\u0dc3\u0dbb 05\u0d9a \u0d8b\u0db4\u0dbb\u0dd2\u0db8 \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0ddc\u0dca.\n\n\u0dc3\u0db8\u0dcf\u0d9c\u0ddc\u0db8\u0dca \u0dc3\u0dcf\u0dc3\u0d9c\u0dd2\u0dba\u0d9a \u0dc0\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbd\u0dd2\u0ddc 12 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dc3\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0dc3\u0dd1\u0db8 \u0dc0\u0dd2\u0ddc\u0dc1\u0dca\u0dd2\u200d \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0db8\u0db0\u0dca\u200d\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0dc3\u0dc4\u0dc3\u0dcf\u0db8 \u0db4\u0dcf\u0dbd\u0db