    "chunk_text": "\u0dc0\u0d9a\u0dcf\u0dc0\u0dc4\u0dc3\u0dcf\u0db8\u0daf \u0d92 news \u0d91\u0d9a \u0d9c\u0dd2\u0dc0\u0dda? \u0d92\u0d9a \u0dc0\u0d9c \u0dcf\u0dc0\u0dca \u0dc0\u0db1\u0dcf\u0dc0\u0dc0\u0dba\u0dd2\u0daf? \u0d92\u0d9a \u0dc0\u0db4\u0dca\u200d\u0dbb\u0ddd\u0da9\u0dcf\u0dc0\u0dca \u0dc0\u0db1\u0dcf\u0dc0\u0dc0\u0dba\u0dd2\u0daf? \u0d92\u0dc0\u0db8\u0dcf\u0dbd\u0dca\u0dbd\u0dca \u0dc0\u0d9a\u0dcf\u0dc0\u0dc4\u0dc3\u0dcf\u0db8\u0daf \u0daf\u0dd0\u0db1 \u0db8\u0dad\u0dca\u0dc0\u0dad\u0dca \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0dcf \u0dc0\u0dca\u0db1\u0dc3\u0dd4\u0dbb\u0dcf\u0daf\u0dcf \u0db8\u0dd0\u0dca\u0dca \u0d91\u0d9a \u0db8\u0dc4\u0dc3\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf0 \u0dc0\u0db1\u0dc0\u0dcf\u0dad\u0dca \u0dca\u0d9c\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d85\u0db4\u0dbb\u0dcf\u0db00 \u0dc0\u0db1\u0dc0\u0dcf \u0dad\u0dca \u0d9a\u0dd2\u0dba\u0dca\u0dc0\u0dca organized crimes \u0d9a\u0dd2\u0dba\u0dbd\u0dcf0 \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0dcf \u0db8\u0dd0\u0dca\u0dca \u0d91\u0d9a \u0db8\u0dc4\u0dc3\u0dca\u0db1 \u0d9a\u0dbd\u0dd2\u0db8\u0dca \u0d91\u0dba\u0dcf\u0dc0\u0dc3 \u0dc0\u0dc0\u0dca \u0dca\u0dca\u0db1 \u0d9a\u0dcf\u0dca \u0dc0\u0dca\u0db4\u0dbd\u0dca\u0d9a\u0dcf\u0dbb\u0dc0\u0dba\u0ddd \u0da7\u0dd2\u0d9a \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf LCs open \u0d9a\u0dbb\u0db1\u0dc0\u0dcf0 \u0dc0\u0db1 \u0d87\u0db8\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dda \u0dc0\u0db6\u0dcf\u0db1\u0dca0 4 000\u0dca \u0db1\u0dd0\u0dc4\u0dc3\u0dd0 \u0d9a\u0dd2\u0dda\u0dc0\u0dcf0 \u0db8\u0dd0\u0dba\u0dd2 \u0db8\u0dcf\u0dca\u0dc0\u0dda \u0d85\u0dca\u0dd2\u0db1\u0db8 \u0dca\u0dd2\u0db1\u0dba \u0d85\u0dbb\u0dc0\u0db8\u0db1 \u0db6\u0dbd\u0dca\u0db1 \u0dc0\u0dcf\u0dc4\u0dc3\u0db1 4 000\u0d9a LCs open \u0d9a\u0dbb\u0dbd\u0dcf \u0dd2\u0db1\u0dc0\u0db6\u0db1\u0dc0\u0dcf0 \u0dca\u0dd2\u0db1\u0dca \u0dc0\u0db8\u0dc