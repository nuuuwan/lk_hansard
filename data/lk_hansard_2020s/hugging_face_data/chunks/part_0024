    "chunk_text": "\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0dba\u0dba\u0dcf, \u0d85\u0ddc\u0db4\u0dca \u0dbb\u0ddc\u0da7\u0dca \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0dc3\u0db6\u0dd4\u0dab\u0dd4 \u0db4\u0dbb\u0dcf\u0ddc\u0da7\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0dc3\u0dba \u0dc0\u0dd0\u0da9\u0dd2\u0ddc\u0dba\u0db1\u0dca\u0db8 \u0db6\u0dbd\u0db4\u0dd1\u0ddc\u0dca \u0d85\u0ddc\u0db4\u0dca \u0dbb\u0ddc\u0da7\u0dca \u0d89\u0db1\u0dca\u0db1 \u0d9a\u0dd4\u0da9\u0dcf \u0dc3\u0dc3 \u0db8\u0db0\u0dca\u200d\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0dab \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba\u0d9a\u0dba\u0db1\u0dca . \u0d85\u0ddc\u0db4\u0dca \u0dbb\u0ddc\u0da7\u0dca \u0dc3\u0dd2\u0dd2\u0dad\u0db1 \u0d9a\u0dd4\u0da9\u0dcf \u0dc3\u0dc3 \u0db8\u0db0\u0dca\u200d\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0dab \u0dc0\u0dba\u0dc0\u0dc3\u0dcf\u0dba\u0d9a\u0dba\u0db1\u0dca \u200d\u0db8\u0dba\u0dd2 \u0d85\u0ddc\u0db4\u0dca \u0dbb\u0ddc\u0da7\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba 75\u0d9a\u0dca\u0db8 \u0d86\u0dc0\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0ddc\u0db1\u0dca. \u0d92 \u0dc0\u0dcf\u0ddc \u0db8 \u0d85\u0ddc\u0db4\u0dca \u0dbb\u0ddc\u0da7\u0dca \u0dbb\u0dd0\u0dbb\u0dd3\u0dba\u0dcf \u0d85\u0dc0\u0dc1\u0dba\u200d\u0dcf\u0ddc\u0dc0\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba 45\u0d9a\u0dca\u0db8 \u0dc3\u0db4\u0dba\u0db1\u0dca\u0ddc\u0db1\u0dca \u0d9a\u0dd4\u0da9\u0dcf \u0dc3\u0dc3 \u0db8\u0db0\u0dca\u200d\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0dab \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0d86\u0dba\u200d\u0db1\u0dc0\u0dbd\u0dd2\u0db1\u0dca. \u0ddc\u0db8\u0dca \u0d9a\u0dd4\u0da9\u0dcf \u0dc3\u0dc3 \u0db8\u0db0\u0dca\u200d\u0dba \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0dab \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0d86\u0dba\u200d\u0db1 \u200d\u0db8\u0dba\u0dd2 \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd \u0dc0\u0dc1\u0ddc\u0dba\u0db1\u0dca\u0db8 \u0da8 \u0da9\u0db1\u0dba\u0d9a \u0dbd\u0d9a\u0dca \u0dd4\u0dbb\u0ddc\u0dab\u0dca, \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2\u0dc3 \u0db4\u0dbb\u0dcf\u0ddc\u0da7\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0dc3\u0dba \u0dba\u0dcf\u0dc3\u0dcf. \u0dc0\u0dd2\u0ddc\u0dc1\u0dca\u0dc2\u0dba\u0ddc\u0dba\u0db1\u0dca\u0db8 \u0d85\u0daf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dc0 \u0d9a\u0dbb \u0dad\u0dd2\u0dc3\u0ddc\u0db6\u0db1 \u0db4\u0db1\u0dad\u0dca\u0dc0 \u0ddc\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u200d \u0dc3\u0db8\u0dca\u0db8\u200d \u0dd3\u0db8 \u0ddc\u0db8\u0dca \u0d86\u0dba\u200d\u0db1\u0dc0\u0dbd , \u0ddc\u0db8\u0dca \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dc0\u0dbd \u0ddc\u0dbd\u0dcf\u0d9a\u0dd4 \u0dbb\u0dd4\u0d9a\u0dd4\u0dbd\u0d9a\u0dca \u0ddc\u0dc0\u0db1\u0dc0\u0dcf \u0dbb\u0dd3\u0dba\u0dcf \u200d\u0db8\u0dba\u0dd2 \u0db8\u0dcf \u0dc0\u0dd2\u0dc1\u0dca\u0dc0\u0dcf\u0dc3 \u0d9a\u0dbb\u0db1\u0dca\u0ddc\u0db1\u0dca.\n\n\u0d85\u0daf \u0daf\u0dd2\u0db1 \u0ddc\u0db8\u0dca \u0db4\u0db1\u0dad\u0dca\u0dc0 \u0ddc\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u200d \u0ddc\u0daf\u0dc0\u0db1 \u0dc0\u0dbb \u0dbb\u0dd3\u0dba\u0dd0\u0dd3\u0db8 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dc0 \u0dbb\u0dd3\u0db8 \u0db8 \u0dd2\u0dc5\u0dd2\u0dad\u0db6\u0dc4\u0dc0 \u0d85\u0dd2\u0dc5 \u0dc3\u0db1\u0dca\u0ddc\u200d\u0ddd\u0dc2\u0dba \u0ddc\u0dc0\u0db1\u0dc0\u0dcf. \u0ddc\u0db8\u0db8 \u0db4\u0db1\u0dad\u0dca\u0dc0 \u0ddc\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u200d \u0d89\u200d\u0dcf \u0daf\u0dd3\u0dbb\u0dca \u0d91\u0d9a\u0d9a\u0dca \u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dba\u0dba\u0dba\u0dcf. \u0db8\u0db8 \u0dc4\u0dd2 \u200d\u0db1 \u0dc0\u0dd2\u0dd2 \u0dba \u0dd2\u0dc5\u0da7\u0dd4 630\u0d9a\u0dca \u0dc0\u0dd2\u200d\u0dbb \u0dad\u0dd2\u0dc3\u0ddc\u0db6\u0db1 \u0db4\u0db1\u0dad\u0dca\u0dc0 \u0ddc\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u200d\u0d9a\u0dca. \u0ddc\u0db8\u0db8 \u0db4\u0db1\u0dad\u0dca\u0dc0 \u0ddc\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u200d \u0ddc\u0d9a\u0dcf\u0da1\u0da0\u0dbb \u0ddc\u0dc3\u0dcf\u0dd2\u0dbd\u0db1\u0dca \u0dd2\u0dc5\u0dd2\u0dad\u0ddc\u0dba\u0dbd \u0d9a\u0dbb \u0dad\u0dd2\u0dc3\u0db6\u0dd4\u0dab\u0dad\u0dca\u0dc0 \u0dc0\u0dd0\u0da9\u0d9a\u0dca \u0db1\u0dd0\u0dc3\u0dd0, \u0d91\u0dba \u0dc3\u0db8\u0dca\u0db8\u200d \u0dd3\u0ddc\u0db8\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0 \u0d92\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0dc0\u0db8\u0d9a \u0dbb\u0dd3\u0db8 \u0ddc\u0db8\u0dca\u0daf\u0dd3 \u0d9c\u0dd0 \u0dbd\u0dd4 \u0d87\u0dad\u0dd2\u0dc3 \u0ddc\u0dc0\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca \u0ddc\u0dc3\u0ddd \u0ddc\u0db8\u0db8 \u0db4\u0db1\u0dad\u0dca\u0dc0 \u0ddc\u0d9a\u0da7\u0dd4\u0db8\u0dca\u0db4\u200d \u0dc3\u0db8\u0dca\u0db8\u200d \u0dd3\u0db8 \u0dad\u0dd4\u0db8 \u0db6\u0dbd\u0dcf\u0ddc\u0db4\u0dcf\u0ddc\u0dbb\u0dcf\u0dad\u0dca\u0dc0\u0dad\u0dd4\u0db8 \u0dc0\u0db1 \u0d85\u0dbb\u0dd4 \u0dab\u0dd4 \u0d89\u0da7\u0dd4 \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0d85\u0ddc\u0db4\u0dcf\u0ddc\u0dc3\u0dcf\u0dc3\u0dad\u0dca\u0dc0 \u0ddc\u0dc0\u0db1\u0dc0\u0dcf \u0db1\u0db8\u0dca. \u0dc0\u0dd2\u0ddc\u0dc1\u0dca\u0dc2\u0dba\u0ddc\u0dba\u0db1\u0dca\u0db8 \u0ddc\u0db8\u0dca \u0db4\u0db1\u200d \u0dba \u0ddc\u0dad\u0dca\u0dc0 \u0dc0\u0dc3\u0dca\u0dad\u0dd4\u0db8\u0db7\u0dc3\u0d9c\u0dad\u0dca\u0dc0\u0dc0 \u0dba\u0dcf\u0dba\u0dcf\u0db8\u0db1 \u0d85\u0dd2 \u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dd2\u0dc5\u0dc4\u0dd2 \u0da7\u0dd4\u0dc0\u0db1\u0dc0\u0dcf. \u0ddc\u0db8\u0dca \u0d85\u0dd2 \u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dca\u200d\u0dbb\u0db8\u0dcf\u0daf\u0dba\u0dbb\u0dd3\u0db1\u0dca \u0ddc\u200d\u0dcf\u0dbb\u0dc0 \u0dd2\u0dc5\u0dc4\u0dd2 \u0ddc \u0dca\u0ddc\u0dc0\u0dcf\u0dad\u0dca\u0dc0 \u0dc0\u0dd2\u200d\u0dbb\u0dba\u0dd2, \u0d85\u0db4 \u0ddc\u0db8\u0dca \u0db4\u0db1\u0ddc\u0dad\u0dca\u0dc0 \u0d85\u0dbb\u0dd4 \u0dab \u0d89\u0da7\u0dd4 \u0d9a\u0dbb\u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0db1\u0dca\u0ddc\u0db1\u0dca. \u0db4\u0dc3\u0dd4\u0dd2\u0dba\u0dba \u0d9a\u0dcf\u0dbd\u0ddc \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0ddc\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0ddc\u0dca \u0db4\u0db1\u200d\u0d9a\u0dca \u0dc3\u0db8\u0dca\u0db8\u200d \u0dd4\u0dbb\u0dab\u0dcf, \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dc3\u0dca\u0dae\u0dcf\u0dd2\u0dc5\u200d \u0dbb\u0dd3\u0db8 \u0db8 \u0dc3\u0dc4\u0dc3\u0dcf. \u0db1\u0dd4 \u0dad\u0dca\u0dc0 \u0d85\u0daf \u0ddc\u0dc0\u0db1\u0dad\u0dd4\u0db8\u0dbb\u0dd4\u0dad\u0dca\u0dc0 \u0d91\u0dba \u0dc3\u0dca\u0dae\u0dcf\u0dd2\u0dc5\u200d \u0d9a\u0dbb \u0db1\u0dd0\u0dc3\u0dd0.\n\n1143 1144\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0ddc\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0"
  },
