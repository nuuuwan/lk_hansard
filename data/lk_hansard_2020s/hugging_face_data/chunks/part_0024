    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dd4\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0dca\u0dc4\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db8\u0dd1\u0db4 \u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0d9c\u0d9c\u0ddd\u0dbd\u0dd3\u0dba \u0dca\u0dbb\u0dca\u0db6\u0dd4\u0daf\u0d9c\u0dba\u0db1\u0dca\u0dad \u0d9c\u0d9c\u0dcf\u0da9 \u0d92\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0daf\u0dd3\u0db4\u0dd4 \u0dc3\u0dc4\u0db1 \u0d9c\u0db8\u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d9c\u0db8\u0db1\u0dca\u0dad\u0db1 \u0d9c\u0dc0 \u0d9a\u0dd2\u0dba\u0db1 \u0dc3\u0dc4\u0db1 \u0dbb\u0dcf\u0dc1\u0dd2\u0dba \u0d9c\u0dc0 \u0dc0\u0db1\u0d9c\u0d9a\u0dcf\u0da7 \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0db1\u0dc5\u0db8\u0dd4\u0d9c\u0dc0\u0db1\u0dca\u0dad\u0db8 \u0db0\u0dd3\u0dc0\u0dbb \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dc0\u0da7 \u0d89\u0db1\u0dca\u0dad\u0db0\u0dca\u200d\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dc4\u0db1\u0dcf\u0db0\u0dca\u200d\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0d9c\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d8a\u0da7 \u0dca\u0db8\u0db4\u0dbb\u0dc0 \u0da9\u0dd3\u0dc3\u0db1 \u0dc3\u0dc4 \u0d9c\u0db1\u0da7\u0dca\u200d\u0dbb\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0dca\u0daf\u0dcf\u0dc5 \u0dc3\u0dc4\u0db1 \u0d9c\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d8a\u0da7 \u0dca\u0db8\u0db4\u0dbb\u0dc0 \u0dba\u0dd6\u0dbb\u0dd2\u0dba\u0dcf \u0d9c\u0db1\u0dcf\u0d9c\u0dc4\u0dcf\u0dbb \u0db8\u0dd2\u0dbd \u0dc3\u0dd0\u0dae\u0dcf\u0dc0\u0dbb\u0dc0 \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0d9c\u0d9c\u0db1 \u0dba\u0db1\u0dca\u0dad\u0db1 \u0dc0\u0dd4\u0da9\u0dd2\u0db4\u0dd4\u0dbb \u0dc0\u0dd4\u0dba \u0dc0\u0db1 \u0db8\u0dd4\u0daf\u0dbd \u0dbb\u0da2\u0dcf\u0dba \u0dd2\u0dd2\u0db1\u0db1\u0dca\u0dad \u0daf\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d91\u0d9a\u0d9f \u0d9c\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d8a\u0da7\u0dad\u0dca \u0dca\u0db8\u0db4\u0dbb\u0dc0 \u0d9c\u0db1\u0dcf\u0d9c\u0dc4\u0dcf\u0dbb \u0dc3\u0db3\u0dc4\u0dcf \u0dca\u0daf\u0dcf\u0dc5 \u0dc3\u0dc4\u0db1\u0dcf\u0db0\u0dca\u200d\u0dcf\u0dbb\u0dba \u0dc0\u0dd4\u0da9\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 - \u0dd3 \u0dc0\u0d9c\u0dcf\u0dc0 \u0d9c\u0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0dc3\u0dc4 \u0dca\u0db8\u0db4\u0dbb \u0d9c\u0db7 \u0ddd\u0d9c \u0d9c\u0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0db1\u0dca\u0dad - \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d8a\u0da7\u0dad\u0dca \u0dca\u0db8\u0db4\u0dbb\u0dc0 Units 90\u0da7 \u0dca\u0dca\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0dd2\u0daf\u0dd4\u0dd2\u0dba \u0db1\u0dbb\u0dd2\u0d9c\u0db7 \u0ddd\u0da2\u0dcf\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0db1\u0dcf\u0dbb\u0dd2\u0d9c\u0db7 \u0ddd\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0dad\u0d9c\u0dda \u0dc0\u0dd4\u0dba \u0db6\u0dbb \u0dbb\u0da2\u0dcf\u0dba \u0dd2\u0dd2\u0db1\u0db1\u0dca\u0dad \u0daf\u0dbb\u0db8\u0dd2\u0db1\u0dca\u0dad \u0d92 \u0dca\u0db8\u0db4\u0dbb \u0db8\u0dd4\u0daf\u0dbd \u0dc3\u0dc4\u0db1\u0dcf\u0db0\u0dca\u200d\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0dbd\u0db6\u0dcf \u0d9c\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0dd2\u0d9c\u0dc1\u0dca\u0dd0\u0dc2\u0d9c\u0dba\u0db1\u0dca\u0dad \u0d9c\u0dc0 \u0d9c\u0d9c\u0ddd\u0dbd\u0dd3\u0dba \u0dca\u0dbb\u0dca\u0db6\u0dd4\u0daf\u0dba \u0d9c\u0dc4\u0dd0\u0dad\u0dd4\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0dd4\u0db1\u0dca\u0dad\u0db1 \u0dd4\u0dba \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dca\u200d\u0dcf\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9c\u0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0db1 \u0db6\u0dd2\u0dd2\u0dba\u0db1 100\u0d9a \u0dca\u0db8\u0db4\u0dbb \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0dc0\u0dd4\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0dbb\u0da2\u0dcf\u0dba \u0dd2\u0dd2\u0db1\u0db1\u0dca\u0dad \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf.\n\n\u0dca\u0d9c\u0db1\u0d9a\u0dca \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0d9c\u0dc0 \u0d9a\u0dba\u0dd2. \u0dc3\u0dc3\u0db8\u0dd8\u0daf\u0dca\u0db0\u0dd2\u0dba\u0dc3 \u0dc3\u0dc4 \u0dc3\u0dca\u0dc3\u0dd0\u0dc0\u0dd4\u0db8\"\u0db8\u0dc3 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0d9c\u0daf\u0d9a\u0d9a\u0dca \u0d9c\u0db1\u0dca\u0dad. \u0db8\u0db8 \u0dd4\u0db6\u0dad\u0dd4\u0db8\u0dcf\u0d9c\u0d9c\u0db1\u0dca\u0dad \u0db8\u0da9\u0d9a\u0dbd\u0db4\u0dd4\u0dc0 \u0daf\u0dd2\u0dc3\u0dd0\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0d9c\u0d86 \u0daf\u0dad\u0dca\u0db4 \u0d89\u0db1\u0dbd\u0dd4\u0d9c\u0dc0\u0dca 50 300 \u0d9c\u0daf\u0d9c\u0db1\u0d9a\u0dd4\u0da7 \u0db4\u0db8\u0dba\u0dd2 \u0dca\u0dc3\u0dd0\u0dc0\u0dd4\u0db8\"\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7 \u0dc4\u0dc0 \u0db6 \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad. \u0dc4\u0dd4\u0db6\u0dd4\u0dba\u0dd2 \u0db8\u0da9\u0d9a\u0dbd\u0db4\u0dd4\u0d9c\u0dc0\u0dca \u0dbd\u0d9a\u0dca\u0dc2 6\u0d9a\u0da7 \u0dc0\u0dd4\u0da9\u0dd2 \u0da2\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dc0\u0d9a\u0dca \u0d89\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dcf. \u0db8\u0da9\u0d9a\u0dbd\u0db4\u0dd4\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0dd2\u0db1\u0dba\u0dba\u0da7 40\u0d9a\u0da7 \u0dc0\u0da9\u0dcf \u0daf\u0dbb\u0dd2\u0dbb\u0db4\u0dcf\u0d9c\u0dc0\u0db1\u0dca\u0dad \u0d9c\u0db1\u0d9c\u0dc5\u0db1 \u0db6\u0dc0 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u0d9c\u0dc4\u0db8 \u0db6\u0dd4\u0dbd\u0dd4\u0dc0\u0dcf\u0db8 \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dcf\u0dba \u0dca\u0db8\u0dcf\u0db4\u0dba\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dca\u0dca\u0db8 \u0db4\u0dbb\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dbd\u0d9a\u0dca\u0dc2 2\u0d9a\u0da7 \u0dd2\u0db4\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7 \u0d9c\u0daf\u0db1\u0dca\u0dad\u0db1 \u0d9c\u0dc0\u0db1\u0dc0\u0dcf. \u0dc4\u0dd4\u0db6\u0dd4\u0dba\u0dd2 53 000 \u0d9c\u0dab\u0d9a\u0da7 \u0db1\u0db8\u0dab\u0dba\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7 \u0dbd\u0db6\u0dcf \u0d9c\u0daf\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad. \u0dca\u0d9a\u0dca\u0dba\u0dcf\u0da0\u0db1\u0dcf \u0dd2\u0dc1\u0dca\u0dcf\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0daf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u0db4\u0d9c\u0d9a\u0dcf\u0da7 \u0dc3\u0db8\u0dd8\u0daf\u0dca\u0db0\u0dd2 \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0d9a\u0da7\u0dca\u0da7\u0dd2\u0dba\u0da7\u0dad\u0dca \u0d9c\u0dc0 \u0db6\u0dd2\u0dd2\u0dba\u0db1 100 \u0dc4\u0dbb\u0dc4\u0dcf \u0db8\u0dd4\u0daf\u0db1 \u0dbd\u0dd4\u0d9c\u0db6\u0db1\u0dc0\u0dcf\u0daf \u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0dd4\u0dad\u0dca\u0db1\u0dc0 \u0dca\u0dc3\u0dd0\u0dc0\u0dd4\u0db8\"\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7 \u0dbd\u0dd4\u0d9c\u0db6\u0db1 \u0dca\u0dba\u0da7 \u0dd2\u0db4\u0dbb\u0daf \u0dbd\u0dd4\u0d9c\u0db6\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad? \u0dc3\u0db8\u0dd8\u0daf\u0dca\u0db0\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7 \u0dba\u0dba\u0dd2 \u0dca\u0dc3\u0dd0\u0dc0\u0dd4\u0db8\"\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7 \u0dba\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1 \u0d9c\u0daf\u0d9a\u0db8 \u0db1\u0dd4\u0dad\u0dd2 \u0dca\u0dba\u0da7 \u0dc3\u0dc4\u0db1 \u0dbd\u0db6\u0dcf \u0d9c\u0daf\u0db1\u0dca\u0dad\u0db1 \u0dc0\u0dd4\u0da9 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dc0\u0dc5\u0d9a\u0dca \u0db1\u0dd4\u0daf\u0dca\u0daf? \u0d9c\u0dc0 survey \u0d91\u0d9a \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0\u0dad\u0dca \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1. \u0d9c\u0db8\u0dcf\u0d9a\u0daf \u0dca\u0dbd\u0dd4\u0dad\u0dca survey \u0d91\u0d9a\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0db1\u0dd4\u0dad\u0dd4\u0dc0 2019\u0daf\u0dd3 \u0d9c\u0dad\u0dca\u0dad\u0dd4 survey \u0d91\u0d9a\u0d9a\u0dca \u0dc4\u0dbb\u0dc4\u0dcf \u0d9c\u0dc0 \u0d9a \u0dc4\u0dbb\u0dd2\u0dba\u0da7 capture \u0d9c\u0dc0\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0db4\u0db8\u0dba\u0dd2 \u0dd2\u0d9c\u0dc1\u0dca\u0dd0\u0dc2\u0d9c\u0dba\u0db1\u0dca\u0dad\u0db8 \u0daf\u0dd4\u0db1 \u0d9c\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1."
