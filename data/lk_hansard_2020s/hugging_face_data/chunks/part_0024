    "chunk_text": "\u0d85\u0daf \u0d94\u0db6 \u0daf\u0dca\u0db1\u0dc0\u0dc1, \u0dbb\u0dd4\u0db4\u0dd2 \u0daf\u0dbd\u0dca \u0d85\u0d9c \u0daf\u0dda\u0d9c\u0daf \u0dca \u0db4\u0dc4\u0dad \u0dc0\u0db4\u0daf\u0da7 \u0db1 \u0db6\u0dc0. \u0d8a\u0da7 \u0dc3\u0dc1\u0daf\u0dda\u0d9a\u0dca\u0dc2\u0dc0 \u0d85\u0db4\u0da7 \u0db6\u0daf\u0dd4 \u0dc0\u0db4\u0da9\u0dd2 \u0d9a\u0dbb\u0dca\u0db1\u0da7 \u0dc3\u0dd2\u0dda\u0db0 \u0daf\u0dc0 \u0dc1 \u0dd2\u0daf\u0db6\u0db1\u0dc0\u0dc1. \u0d92 \u0dd4\u0dc5\u0dd2\u0dca \u0d85\u0daf\u0dda \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0dc3\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dda\u0daf \u0dca\u0db8 \u0dc3\u0d82\u0daf\u0d9a\u0ddd\u0da0\u0db1 \u0daf\u0dc0\u0db1\u0dc0\u0dc1. \u0d92 \u0dd4\u0dc5\u0dd2\u0dca \u0d85\u0daf\u0dda \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0d85\u0dc0\u0dc3\u0dda\u0dae\u0dc1 \u0dc3\u0db8\u0dca\u0dd6\u0dbb\u0dca\u0dda\u0daf \u0dca\u0db8 \u0d85\u0dc4\u0dd2\u0db8\u0dd2 \u0daf\u0dc0 \u0dc1 \u0dd2\u0daf\u0db6\u0db1\u0dc0\u0dc1. \u0d85\u0daf \u0dc3\u0dd2 \u0dbd\u0dd4 \u0d9a\u0dbb\u0dca\u0db8\u0dc1\u0dca\u0dad\u0db1\u0dc1 \u0dc1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0dca,\u200d\u0d9a\u0dd4\u0db4\u0dc1, \u0db8\u0db0\u0dba\u0db8 \u0dc3\u0dc4 \u0dc0\u0dd2\u0db1\u0dc1 \u0db4\u0dbb\u0dd2\u0db8\u0dc1\u0dda\u0daf \u0dc0\u0dba\u0dc0\u0dc3\u0dc1 \u0d9a \u0dca \u0daf\u0dca\u0daf\u0dca \u0db1\u0db4\u0dc4\u0db4, \u0dc0\u0dd2\u0daf\u0dd4\u0dd2 \u0db6\u0dd2 \u0dc0\u0db4\u0da9\u0dd2 \u0dc0\u0dd3\u0db8\u0db8\u0da7 \u0db8\u0dd4\u0dc4\u0dd4\u0dda \u0daf\u0daf\u0dca\u0daf\u0dca \u0daf\u0d9a\u0dc1\u0daf\u0dc4\u0dc1\u0db8\u0daf \u0d9a\u0dd2 \u0dc1. \u0d92 \u0d85\u0dc3\u0dda\u0daf\u0dc3\u0dda \u0db6\u0daf\u0dd4\u0dad\u0dca \u0d9c\u0db4\u0dc4\u0dd4\u0dc0\u0dc1\u0db8 \u0d92\u0d9a\u0da7 \u0db8\u0dd4\u0dc4\u0dd4\u0dda \u0daf\u0daf\u0dca\u0daf\u0dca \u0daf\u0d9a\u0dc1 \u0daf\u0dc4\u0dc1\u0db8\u0daf \u0d9a\u0dd2 \u0dc1. \u0db1\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dc3\u0dd2 \u0daf\u0daf \u0d9a\u0dca \u0dc3\u0dd2\u0dda\u0db0 \u0daf\u0db1\u0dc1\u0dc0\u0dd4\u0dda\u0dc1 \u0dc0\u0dc1\u0daf \u0d9a\u0dae\u0dc1 \u0d9a\u0dc5\u0dc1\u0da7 \u0dc0\u0db4\u0db4\u0d9a\u0dca \u0db1\u0db4\u0dc4\u0db4.\n\n909 910\n\n[\u0d9c\u0dbb\u0dd4 \u0d91\u0db8\u0dca.\u0daf\u0d9a\u0dca.\u0d91\u0db8\u0dca. \u0d85\u0dc3\u0dda \u0db8\u0dca \u0db8\u0dc4\u0dad\u0dc1]"
