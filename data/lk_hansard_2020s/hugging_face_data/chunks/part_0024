    "chunk_text": "\u0dad\u0dab\u0dad\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0dad\u0dc0\u0dbb\u0dda, \u0dad\u0db6\u0db1 \u0dc0\u0db1 \u0dd2\u0da7 \u0daf\u0dd2\u0db1\u0db4\u0dbb\u0dcf \u0dd2\u0dd4\u0dd3\u0d9c\u0dbd \u0dd2\u0dd2\u0dba\u0dc3\u0dd4\u200d\u0dd4\u0dbb\u0dd4 \u0db8\u0dc3\u0dac\u0dd4\u0dca \u0dbd\u0d9a\u0dca \u0dc4 \u0dd2\u0daf\u0dd2\u0daf\u0dcf\u0dad\u0dda \u0db1\u0da9\u0dd4 \u0dd2\u0db7\u0dcf\u0d9c\u0dc3\u0d9a\u0dca \u0dc4 \u0db4\u0dd0\u0dc0\u0dd0\u0dda\u0dad\u0dc0\u0db1\u0dc0\u0dcf, 2019.04.21 \u0dc0\u0dd4\u0dab\u0dd4 \u0db4\u0dd2\u0db4\u0dd2\u0dbb\u0dd3\u0db6\u0db1 \u0daf\u0dcf\u0db8\u0dc3\u0dc3 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db6\u0db1\u0dca\u0db0\u0dd3\u0d9a\u0db0\u0dad\u0dc3\u0db0\u0dd3\u0d9a. \u0d91\u0dbb\u0dd0\u0db1 \u0da0\u0dd6\u0daf\u0dd2\u0dbb\u0dba\u0dd2\u0db0\u0dd3\u0d9a 25\u0dab\u0da7\n\n\u0dd2\u0dbb\u0dd4\u0dd3\u0db0\u0dc0 \u0db1\u0da9\u0dd4 \u0d9f \u0db1\u0dc0\u0dcf. \u0d92 \u0d91\u0dab \u0dd4\u0dd3\u0d9c\u0dbd\u0dad\u0dc3\u0d9a\u0dca \u0dc4 \u0db8\u0dd2\u0dc3 \u0dd2\u0dc4\u0dd2\u0dca \u0dbd\u0dcf \u0dd2\u0dba\u0dad\u0dca\u0db1\u0dc0\u0dcf. \u0d92 \u0db1\u0da9\u0dd4 \u0daf\u0dd2\u0db1\u0db4\u0dbb\u0dcf \u0d9f \u0db1\u0dc0\u0dcf. \u0d92 \u0dd2\u0dba\u0dc3\u0dca\u0dad\u0dca\u200d\u0dcf \u0d9f\u0db4\u0da7 \u0dad\u0db6\u0db1 \u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0dad\u0dbb\u0dca\u0daf\u0dd3 \u0d91\u0dc4\u0dd2 \u0dad\u0dd3\u0db0\u0dd3\u0d9a\u0dd4\u0dc0\u0dc0\u0dda \u0dbd\u0dd0\u0dad\u0db6\u0dca\u0daf\u0dd2.\n\n2018\u0daf\u0dd3 \u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dda\u0dc0\u0dbd \u0dd2\u0db1\u0dd4\u0dc0 \u0dc0\u0dd6 \u0dad\u0db4\u0dcf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0dd2\u0dba\u0dbd\u0db0\u0dcf\u0daf\u0dcf\u0db0\u0dd3\u0d9a \u0dad\u0daf\u0dad\u0daf\u0db1\u0dcf\u0dad \u0d9d\u0dcf\u0dbb\u0db1\u0dc3, \u0d91\u0dca \u0da7\u0dd3\u0da7\u0dd3\u0d8a \u0d91\u0dad\u0d9a\u0dca \u0dc4 \u0dd2\u0db3\u0dbd\u0dcf \u0dd4\u0db1\u0dbb\u0dd4\u0dda\u0dae\u0dcf\u0db4\u0db1\u0dc3 \u0dad\u0dc0\u0da0\u0dca\u0da0 \u0dd4\u0dd3\u0d9c\u0dbd\u0dba\u0dd2\u0db0\u0dd3\u0d9a \u0dab\u0dc5\u0dcf \u0d9a\u0dd2\u0dc3\u0dbd\u0dcf \u0d92 \u0db4\u0dbb\u0dd3\u0d9a\u0dca \u0dc4\u0dc2 \u0dc3 \u0dad\u0dc0\u0db1\u0dbb\u0dab\u0da7 \u0dad\u0dc3\u0dcf\u0db8\u0dd4 \u0dab\u0dc5\u0dcf, \u0da2\u0dd0\u0dab\u0da7\u0dca \u0dad\u0dca \u0d9a\u0dca \u0dc4\u0d89 \u0dc3\u0da7 \u0daf\u0db8\u0dc3\u0dbd\u0dcf. \u0d9f\u0db4\u0dd2 \u0dca\u0dbd\u0dc3\u0da7 \u0d86\u0dc0\u0dcf\u0da7 \u0db4\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb, \u0d9f\u0dad\u0dda \u0d86\u0dca\u0da9\u0dd4\u0dc0 \u0dc3\u0da7\u0dad\u0dda \u0daf\u0dd0\u0db0\u0dd3\u0d9a \u0dad\u0dc3\u0dca\u0dad\u0dca\u200d\u0dcf\u0dc3\u0dcf\u0dad\u0d9c\u0db1 \u0dd2\u0dba\u0dad\u0dca\u0db1\u0dc0\u0dcf, \u0d91\u0db8\u0dc3 \u0dd2\u0db1\u0dd4\u0dc0\u0dc0\u0dd3\u0db8\u0dc3 \u0d87\u0dda\u0dbb\u0dc0\u0dba\u0dad\u0dc3\u0db0\u0dd3\u0d9a\u0db8\u0dc3 \u0dc3\u0dca\u0dad\u0dca\u200d \u0dcf\u0db0\u0dd3\u0d9a\u0dbd\u0dcf \u0dab \u0dd4 \u0dad\u0daf\u0dc3\u0d9a\u0dca \u0dc4 \u0d9a\u0dd2\u0dc3\u0dbd\u0dcf.\n\n\u0d91\u0dad \u0db1\u0db6\u0db1 \u0dad\u0db8\u0dc3\u0dcf\u0dab\u0d9a\u0dca \u0dc4\u0daf \u0dad\u0dc0\u0dbd\u0dcf \u0dd2\u0dba\u0dad\u0dca\u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a? \u0db8\u0dc3 \u0dad\u0db8\u0dc3\u0dcf\u0dc5\u0dab\u0dbb\u0dd4 \u0d86 \u0d9a\u0dca \u0dc4\u0dc2\u0dcf \u0dab \u0db0\u0dd3\u0d9a\u0db1 \u0dd4\u0dd3\u0d9c\u0dbd\u0dc3\u0db0\u0dd3\u0d9a \u0dab\u0da7\u0dca\u0da7\u0dd2\u0dc3\u0d9a\u0dca \u0dc4 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc3\u0dcf\u0dda\u0db8\u0dc3\u0dab \u0dc0\u0dd4 \u0dcf. \u0d92 \u0d9f\u0db1\u0dd4\u0dc0 \u0dad\u0db6\u0db1 \u0db4\u0dbb\u0dd3\u0d9a\u0dca \u0dc4\u0dc2 \u0dc3 \u0dad\u0dc0\u0db1\u0dbb\u0dab\u0da7 \u0dad\u0dc3\u0dcf\u0db8\u0dd4 \u0dab\u0dc5\u0dcf. \u0d9f\u0db0\u0dd3\u0d9a\u0db1 \u0d92 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db6\u0db1\u0dca\u0db0\u0dd3\u0d9a\u0db0\u0dad\u0dc3\u0db0\u0dd3\u0d9a \u0dc0\u0dd6 \u0dd2\u0db8\u0dc3\u0dbb\u0dca\u0dba\u0db1 \u0dbb\u0db8\u0dc3\u0dba\u0dd2 \u0daf\u0dd0\u0db0\u0dd3\u0d9a \u0d86 \u0db6\u0db1\u0db7 \u0dad\u0dc0\u0dbd\u0dcf \u0dd2\u0dba\u0dad\u0dca\u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a. \u0d92 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db6\u0db1\u0dca\u0db0\u0dd3\u0d9a\u0db0\u0dad\u0dc3\u0db0\u0dd3\u0d9a \u0daf\u0dd0\u0db0\u0dd3\u0d9a \u0dd4\u0dd3\u0d9c\u0dbd\u0dc3\u0db0\u0dd3\u0d9a \u0d9f\u0dda\u0d9f\u0da9\u0dbd\u0d82\u0d9c\u0dd4\u0dc0\u0da7 \u0dad\u0d9c\u0db1 \u0dd2\u0dba\u0dad\u0dca\u0db1\u0dc0\u0dcf. 2018\u0daf\u0dd3 \u0dd2\u0db1\u0dd4\u0dc0 \u0dc0\u0dd4\u0dab\u0dd4 \u200d \u0dcf \u0dc3 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db6\u0db1\u0dca\u0db0\u0dd3\u0d9a\u0db0\u0dad\u0dc3\u0db0\u0dd3\u0d9a \u0dd2\u0db8\u0dc3\u0dbb\u0dca\u0dba\u0db1\u0dc3 \u0dd0\u0d82\u0d9c\u0dd4\u0dad\u0dda \u0db1\u0dd0\u0dda\u0db1\u0db6\u0db1 2019\u0daf\u0dd3 \u0db4\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0d89 \u200d \u0dcf \u0dc3\u0d9a\u0dca \u0dc4 \u0dd2\u0db1\u0dd4\u0dc0 \u0dad\u0dc0\u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a \u0db1\u0dd0 \u0dd0. \u0dad\u0db8\u0dc3\u0dcf\u0dab\u0daf, \u0daf\u0dd0\u0db0\u0dd3\u0d9a \u0d9f\u0db1\u0dcf\u0dc0 \u0dc3 \u0dad\u0dc0\u0db1\u0dc0\u0dcf, \u0dc3\u0dca\u0dad\u0dca\u200d \u0dcf\u0db0\u0dd3\u0d9a\u0dbd\u0dcf\u0dad \u0dab \u0dca\u0da9\u0dbd\u0dcf\u0dc3\u0db8\u0dc3 \u0dbb\u0db8\u0dc3\u0dba\u0dd2 2018\u0daf\u0dd3 \u0dd2\u0db1\u0dd4\u0dc0 \u0dc0\u0dd4\u0dab\u0dd4 \u200d \u0dcf \u0dc3\u0dda \u0dab\u0dad\u0dc5\u0dbb \u0d9a\u0dd2\u0dc3\u0dbd\u0dcf. \u0d91\u0daf\u0dcf \u0d92 \u0dd2\u0db8\u0dc3\u0dbb\u0dca\u0dba\u0db1 \u0dad\u0dc0\u0db1 \u0db4\u0dd0\u0dda\u0dbb\u0dab\u0da7 \u0dd0\u0dad \u0dda\u0dad\u0dda \u0db1\u0dd0\u0dda\u0db1\u0db6\u0db1 \u0db4\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0d89 \u200d \u0dcf \u0dc3\u0d9a\u0dca \u0dc4 2019\u0daf\u0dd3 \u0dd2\u0db1\u0dd4\u0dc0 \u0dad\u0dc0\u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a \u0db1\u0dd0 \u0dd0. \u0d9f\u0db0\u0dd3\u0d9a\u0db1 \u0d92 \u0dab\u0dbb\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0dca\u0db3\u0dc0 \u0d9f\u0db4\u0dd2 \u0dad \u0dcf\u0dc3\u0dcf \u0dad\u0d9c\u0db1 \u0dc3\u0db1\u0dc0\u0dcf."
