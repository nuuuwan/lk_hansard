    "chunk_text": "2026 \u0dc0\u0dca\u0dc2\u0dba \u0d86\u0dbb\u0db1\u0db7\u0dba\u0dad\u0dca \u0dca\u0db8\u0d9f -\"\u0daf\u0dd2\u0dca\u0dc0\u0dcf\" \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4 \u0dcf\u0da7\u0dd4\u0dc0\u0dc0\u0dca \u0d85\u0db1\u0dad\u0dd4 \u0db1\u0dca\u0dc0 - \u0db8\u0dd0\u0daf \u0dc0\u0db4\u0dbb\u0daf\u0dd2\u0db8 \u0dba\u0dd4\u0daf\u0db8\u0dba \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0dc0\u0dca\u0db0\u0db1\u0dba \u0dd3\u0db8\u0dad\u0dca \u0dca\u0db8\u0d9f \u0d85\u0dc0\u0dca \u0d86\u0dca\u0dd2\u0d9a\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0db8\u0dca \u0d86\u0dc0\u0dcf0 \u0d85\u0db4\u0dd2 \u0d91\u0dba \u0db1\u0dd2\u0dc4\u0dc3\u0dad\u0db8\u0dcf\u0db1\u0dd3\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0db8\u0dca\u0db1\u0dc0\u0dcf0 \u0d85\u0db4 \u0dc0\u0dd2\u0dad\u0dbb\u0dca \u0dc0\u0db1\u0dcf\u0dc0\u0dc0\u0dba\u0dd2 \u0dc0\u0dbd\u0ddd\u0d9a\u0dc0\u0dda \u0d85\u0dc0\u0db1\u0dca \u0dbb \u0dc0\u0dbd \u0dad\u0dca \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0d9b\u0db4\u0db1\u0dba \u0d87\u0dd2\u0db1 \u0dc0\u0dd4 \u0dcf0 \u0daf\u0dd0\u0dca \u0dc0\u0db1 \u0dca\u0db7\u0dcf\u0dc0\u0dda \u0d9a\u0dae\u0dcf \u0d9a\u0dc5 \u0dc0\u0dd2\u0db4\u0dca\u0dc2\u0dc0\u0dda \u0db8\u0dca\u0dd3\u0dc0\u0dbb\u0dc0\u0dba\u0dca - tuition master \u0dc0\u0d9a\u0dc0\u0db1\u0dca - \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf\u0dba \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \"\u0d91\u0dc0\u0dc4\u0dc3\u0db8 \u0dc0\u0daf\u0dba\u0dca \u0db1\u0dd0\u0dc4\u0dc3\u0dd0 \u0d85\u0db4 \u0db8\u0dd4\u0dd4\u0dab \u0dc0\u0daf\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca\" \u0dba\u0db1\u0dd4\u0dc0\u0dc0\u0dca0 \u0d9a\u0db1\u0dca \u0dcf\u0d9a\u0dbb\u0dbd\u0dcf \u0d85\u0daf \u0db4\u0dad\u0dca\u0dad\u0dbb \u0da7\u0dd2\u0d9a \u0db6\u0dbd\u0dca\u0db1 \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0dcf \u0d9a\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0d9b\u0dba \u0dd2\u0db1\u0dc0\u0db6\u0db1\u0dc0\u0dcf0 \u0d92 \u0dc0\u0dc0\u0db1\u0dd4\u0dc0 \u0d9a\u0dd2\u0dc3\u0dd2\u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0d9b\u0dba\u0dca \u0d9a\u0dc5\u0dcf \u0dc0\u0dca0 \u0d94\u0db6\u0dad\u0dca \u0db8\u0db8\u0dad\u0dca \u0dc0\u0db7\u0dde\u0dd2\u0db1\u0d9a \u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dc0 \u0dda\u0db8\u0dca\u0dc0\u0db4\u0dd4 \u0d9c\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dca0 \u0d94\u0db6\u0dad\u0dd4 \u0db8\u0dcf \u0dba\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dc0 \u0db4\u0dcf\u0da9\u0dc0\u0db1 \u0db1\u0dd2\u0dda \u0dca\u0dc0\u0dc3 \u0dad\u0dd4 \u0dca\u0dc0\u0db1 \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db6\u0dbd\u0dca\u0db1 \u0d92 \u0dda\u0daf\u0dcf\u0dc4\u0dc3\u0dbb \u0dba \u0d94\u0dc0\u0dda \u0db1\u0dcf\u0dba\u0d9a\u0dba\u0dcf \u0dc0\u0dba\u0dcf\u0daf\u0dcf \u0db8\u0dca\u0db10 \"\u0dca\u0dd1\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0d9a \u0db8 \u0dca\u0db8\u0dcf\u0db1 \u0dc4\u0dc3\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dd2\u0db1\u0dc0\u0dd2\u0db1\u0dca\u0daf\u0dca\u0db0 \u0dc0\u0dd6 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dca \u0d87\u0dad0\" \u0dba\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc0\u0dd2\u0daf\u0dba\u0dcf\u0dc0\u0dda \u0db1\u0dd2\u0dda \u0dca\u0dc0\u0dc3 \u0dad\u0dd4 \u0dca\u0dc0\u0dc0\u0db1\u0dd2 \u0db1\u0dd2\u0dba\u0db8\u0dba \u0dad\u0db8\u0dba\u0dd2 \u0d92 \u0d9a\u0dd2\u0dba\u0dca\u0dc0\u0dca0\n\n\u0d85\u0db4\u0dd2 \u0dbb\u0da2\u0dca\u200d\u0dba\u0dca \u0dc0\u0d9b\u0dc0\u0dba\u0dca \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0d9b\u0db4\u0db1\u0dba \u0db8\u0dd4\u0dd4\u0dab \u0dc0\u0daf\u0dca\u0dc0\u0dca \u0dc0\u0d9a\u0dcf\u0dc0\u0dc4\u0dc3\u0dcf\u0db8\u0daf? \u0d91\u0d9a\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0dc0\u0db1\u0dd2 \u0dc0\u0db8\u0dcf\u0dc0\u0dc4\u0dc3\u0dcf\u0dc0\u0dad\u0dca\u0db8 \u0dbb\u0da2\u0dca\u200d\u0dba\u0dca \u0dc0\u0d9b\u0dc0\u0dba\u0dca \u0d92 \u0db4\u0dcf\u0da9\u0dd4\u0dc0 \u0d85\u0db4\u0dd2 \u0dc0\u0dd2\u0db3 \u0daf\u0dbb\u0dcf \u0db8\u0dca\u0db1\u0dc0\u0dcf0 \u0dad\u0db8\u0dd4\u0dca\u0db1\u0dcf\u0dca\u0dc0\u0dca\u0db4\u0dbd\u0dcf \u0daf\u0dca\u0db1\u0dc0\u0dcf\u0daf \u0dc0\u0dd2\u0db4\u0dca\u0dc2\u0dc0\u0dda \u0d94\u0db6\u0dad\u0dd4 \u0db8\u0dca\u0dbd\u0dcf \u0daf\u0dca\u0db1\u0dc0\u0dcf\u0daf \u0db8\u0dd0\u0daf \u0dc0\u0db4\u0dbb\u0daf\u0dd2\u0db8 \u0d85\u0dca\u0db6\u0dd4\u0daf\u0dba\u0dad\u0dca \u0dca\u0db8\u0d9f \u0dc0\u0dad\u0dbd\u0dca \u0db8\u0dd2\u0dc5 \u0dca\u0dc4\u0dc3\u0dc5 \u0d9c\u0dd2\u0dba \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0dc0\u0db1\u0dd2 \u0dc0\u0db8\u0dcf\u0dc0\u0dc4\u0dc3\u0dcf\u0dc0\u0dad\u0dca\u0db8 \u0d92\u0d9a \u0db8\u0dd4\u0dd4\u0dab \u0daf\u0dd4\u0dca\u0dc0\u0dca \u0d9a\u0dc0\u0dd4\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf? \u0d85\u0db4\u0dd20 \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0dcf\u0dba\u0dd2 \u0d85\u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dcf\u0dad\u0dba\u0dad\u0dd4 \u0db8\u0dd2\u0dba \u0d87\u0dad\u0dd4 \u0dc5\u0dd4 \u0d87\u0db8\u0dd2\u0db1 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dba\u0dd2 \u0db1\u0dd2\u0dc0\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0d87\u0db8\u0dd2\u0db1\u0dc0\u0db1\u0dca\u0dba\u0dd2 \u0d85\u0dc0\u0dca \u0dc0\u0dad\u0dbd\u0dca \u0dc0\u0d9a\u0ddd \u0dcf \u0d91\u0d9a \u0d85\u0da9\u0dd4 \u0d9a\u0dbb \u0db8\u0dad\u0dca\u0dad\u0dcf0\n\n\u0dad\u0db8\u0dd4\u0dca\u0db1\u0dcf\u0dca\u0dc0\u0dca\u0db4\u0dbd\u0dcf \u0daf\u0dca\u0db1\u0dc0\u0dcf \u0d85\u0dc0\u0dca \u0dbb\u0da2\u0dca\u200d\u0dba \u0db6\u0dbd\u0dba \u0db4\u0dad\u0dca \u0dc0\u0dd4 \u0dcf \u0db4\u0dc3\u0dd4\u0dc0 \u0dc4\u0dd2 \u0db4\u0dd4 \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0db1\u0dc0\u0db1\u0dca\u0dca\u0dc0\u0dc3 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0d85\u0dc0\u0dc4\u0dc3\u0ddd\u0dc3\u0dd2 \u0d9a\u0dc5 \u0db6\u0dc00 \u0db4\u0dcf\u0dca\u0dbd\u0dd2\u0db8\u0dc0\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0dca\u0dd3\u0dc0\u0db1\u0dca\u0dca\u0dc0\u0dc3 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0d85\u0dc0\u0dc4\u0dc3\u0ddd\u0dc3\u0dd2 \u0d9a\u0dc5\u0dcf0 \u0dc4\u0dd2\u0dad\u0dcf\u0dc0\u0db8\u0db1 \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf \u0dc0\u0dca\u0daf \u0dc0\u0db1\u0dc0\u0db8\u0dcf\u0dbd\u0dca\u0dc0\u0dbd\u0ddd\u0dad\u0dca \u0db6\u0dbd\u0dba \u0d86\u0dc0\u0dcf \u0db4\u0dc3\u0dd4\u0dc0 \u0d92\u0d9a \u0d9a\u0dbb\u0db1 \u0d91\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dc3\u0dd0\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf? \u0dc0\u0db8\u0dcf\u0d9a\u0daf \u0d92\u0dc0\u0db8\u0dcf\u0dbd\u0dca\u0dc0\u0dbd\u0ddd \u0d9a\u0dc0\u0dc5\u0db4 \u0d91\u0dc0\u0dc4\u0dc3\u0db8 \u0dc0\u0dca0 \u0dc4\u0dd2\u0dad\u0dca\u0db1 \u0d87\u0dd2\u0db1 \u0d85\u0db4\u0dd2\u0dad\u0dca \u0d91\u0dc0\u0dc4\u0dc3\u0db8\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf0 \u0db1\u0dd0\u0dc4\u0dc3\u0dd0 \u0d85\u0db4\u0dd2 \u0dc0\u0dc0\u0db1\u0dca\u0db40 \u0d85\u0db4\u0dd2 \u0d85\u0dd4 \u0dad\u0dca \u0dc0\u0daf\u0dca\u0d9b\u0db4\u0dcf\u0dbd\u0db1 \u0dca\u0d9c\u0dca\u0db4\u0d9a\u0dca\u0dd2\u0db1\u0dba\u0dca \u0dc4\u0dc3\u0dd0\u0daf\u0dd4\u0dc0\u0dda0 \u0d92 \u0db1\u0dd2\u0dca\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0dc0\u0db1 \u0d9a \u0dba\u0dd4\u0dad\u0dca\u0dad \u0d9a\u0dbb\u0dca\u0dc0\u0dca0 \u0db8\u0dd0\u0daf \u0dc0\u0db4\u0dbb\u0daf\u0dd2\u0db8 \u0d85\u0dca\u0db6\u0dd4\u0daf\u0dba \u0d91\u0db1\u0dc0\u0d9a\u0dcf \u0db6\u0dbd\u0dc0\u0dda \u0dc4\u0dd2\u0da7\u0dd2\u0dc0\u0dda \u0dad\u0db8\u0dd4\u0dca\u0db1\u0dcf\u0dca\u0dc0\u0dca\u0db4\u0dbd\u0dcf \u0db1\u0db1 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0d9a\u0dd2\u0dba\u0dba\u0dd2 \u0db4\u0da7\u0dd2 \u0dad\u0daf \u0d9a\u0dbb \u0db8\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf0 \u0db1\u0db8\u0dd4\u0dad\u0dca \u0db6\u0dbd\u0dc0\u0dda \u0dc4\u0dd2\u0da7\u0dd2\u0dc0\u0dda \u0da2\u0dca\u200d\u0dcf\u0dd2\u0db1\u0d9a \u0da2\u0dca\u200d\u0db1 \u0db6\u0dbd\u0dc0\u0dda\u0db8\u0dba0 \u0db8\u0dad\u0d9a \u0dad\u0db6\u0dcf \u0db8\u0dca\u0db1 \u0d85\u0db1\u0dd4\u0dbb \u0daf\u0dd2\u0dca\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0dcf\u0dc0\u0dc3 \u0dbb\u0da2\u0dca\u200d\u0dba \u0db1\u0dd2\u0dca\u0dcf \u0db4\u0da7\u0dd2 \u0dad\u0daf \u0d9a\u0dbb \u0db8\u0dad\u0dca\u0dc0\u0dad\u0dca \u0d85\u0db4\u0dd20 \u0dad\u0db8\u0dd4\u0dca\u0db1\u0dcf\u0dca\u0dc0\u0dca\u0db4\u0dbd\u0dcf \u0db6\u0dbd\u0dc0\u0dda \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf \u0db1\u0db1 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0db4\u0da7\u0dd2 \u0dad\u0daf \u0d9a\u0dbb \u0db8\u0dca\u0db1\u0dba \u0d9a\u0dd2\u0dba\u0dba\u0dd2 \u0dc0\u0db6\u0dcf\u0da7\u0dd4\u0dc0 \u0db8\u0dd2\u0dd2\u0dba\u0dc0\u0d9a\u0db1 \u0d9a\u0dbd\u0dca0 \u0d85\u0db4\u0dd2 \u0d85\u0daf \u0dc0\u0db8\u0dcf\u0d9a\u0daf \u0d9a\u0dc0\u0dc5\u0db4? \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0dc0\u0db1\u0dcf\u0dc0\u0dc0\u0dba\u0dd2 \u0dc0\u0db1 \u0dbb\u0dc0\u0dca \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0d85\u0db4\u0dd2 \u0dad\u0db8\u0dba\u0dd2 \u0d92 \u0d9a \u0dba\u0dd4\u0dad\u0dca\u0dad \u0d9a\u0dc0\u0dc5\u0db40 \u0d92 \u0db1\u0dd2\u0dca\u0dcf \u0dc0\u0db1 \u0dd2\u0db1\u0dc0\u0db6\u0dca\u0dc0\u0dca \u0d86\u0daf\u0dca\u0d9b\u0dc0\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1\u0dba\u0dca0 \u0d85\u0db4\u0dd2 \u0dbb \u0dc0\u0db8\u0db1 \u0dba\u0dca\u0dc0\u0dca \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0dad\u0dd0\u0db1\u0d9a 0"
