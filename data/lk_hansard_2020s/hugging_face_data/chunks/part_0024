    "chunk_text": "\u0dd9\u0dd9 \u0dc4\u0dd2\u0dca\u200d\u0db1\u0dc0\u0dab, \u0dc3\u0db4\u0dde\u0daf\u0dca\u0dd9\u0dd2\u0d9a\u0dc0\u0dd9 \u0dd9\u0dd9 \u0d89\u0dca\u200d\u0dab\u0dd9 \u0d9f\u0dd2\u0db1\u0dca \u0d87\u0dc3\u0dd4\u0dbb\u0dd4 \u0d9a \u0d85\u0db7\u0dab\u0dc0\u0db4\u0dca\u200d\u0dbb\u0dab\u0dca\u0dca\u200d \u0dd9\u0dbb\u0dd4 (\u0dd9\u0dc4\u0dab\u0da0\u0dab\u0dbb\u0dca\u0dae\u0dba) \u0dc3\u0db4\u0dab\u0dd2 \u0dad\u0dd2\u0dd9\u0dca\u0dd9 \u0dc0\u0dd2\u0dca\u200d\u0dab\u0dbb\u0dba \u0dd9\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dba\u0dd9\u0d9a\u0dca \u0dc3 \u0db4\u0dab\u0dbb\u0dca\u0dae\u0dd2\u0dc3 \u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0d85 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dab\u0dba \u0d9a\u0dbb \u0db1\u0dca\u0da7\u0dd3\u0dd9 \u0dd9\u0dc3 \u0dc0\u0dd9\u0d9a\u0dd3\u0dd9\u0d9a\u0dca \u0dd9\u0dc4 \u0dba\u0dd4\u0dad\u0dd4\u0db8\u0d9a\u0dd9\u0d9a\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dab. \u0dd9\u0dbb\u0dd4 \u0dc3\u0db4\u0dab\u0dd2 \u0dad\u0dd2\u0dd9\u0dca\u0dd9 \u0dc0\u0dd2\u0dca\u200d\u0dab\u0dbb\u0dba \u0dd9\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0d9a\u0dca\u0dca\u200d\u0dc4\u0dd9\u0dca\u0dca\u200d, \u0d9a\u0dd3\u0dbb\u0dca\u0dae\u0dad\u0dd2\u0dd9\u0dad\u0dca \u0dc0\u0dc0\u0daf\u0dba\u0dc0\u0dbb\u0dc3\u0dba\u0d9a\u0dca. \u0db6\u0dd0\u0d9a\u0dca\u0da7\u0dd3\u0dd2 \u0dba\u0dab, \u0dc0\u0dba\u0dd2\u0dbb\u0dd9\u0dca \u0dc3\u0dbb\u0ddd\u0dd9 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0daf\u0dba\u0d9a \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba \u0dad\u0dd4\u0db8 \u0d85 \u0dc3\u0dca \u0dbb\u0dd2\u0db1\u0dca \u0dd9\u0dad\u0dd4\u0db8 \u0dc0\u0dd4\u0dab\u0dd4 \u0dc0\u0dd2\u0dc3\u0dba\u0dca\u0dc2\u0da5 \u0dc0\u0dc0\u0daf\u0dba\u0dc0\u0dbb\u0dc3\u0dba\u0d9a\u0dca. \u0d92 \u0dc0\u0dab\u0dc3 \u0dd9 \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0dc0\u0dab\u0dd9\u0dab\u0d82\u0dc1\u0dd2\u0d9a \u0dc3\u0daf\u0dca\u0dba\u0db4\u0dab\u0dbd\u0db1\u0da5\u0dc3\u0dba\u0d9a\u0dca. \u0d86\u0da0\u0dab\u0dbb\u0dca\u0dae\u0dba \u0d91\u0db1\u0dca.\u0d91 . \u0dc3\u0db4\u0dc3\u0dbb\u0dca\u0dae\u0dbb\u0dab \u0dd9\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd9\u0dab\u0dc3\u0dd9\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0 \u0dbd\u0d82\u0d9a\u0dab \u0dd9\u0dd9\u0dd9\u0dd9\u0dab\u0da2\u0dca\u200d \u0db4\u0d9a\u0dca\u0dc2\u0dc3\u0dda \u0db1\u0dab\u0dba\u0d9a\u0dba\u0dab \u0dc4\u0dd0\u0dd2\u0dba\u0da7 \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a \u0dab. \u0dc0\u0dd9\u0dbb 15\u0d9a\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dab\u0dbd\u0dba\u0d9a\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0dc3 \u0db4\u0dab\u0dbb\u0dca\u0dae\u0dd2\u0dc3 \u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0 \u0db1\u0dd2\u0dc3\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dba \u0d9a \u0dab. \u0dc0\u0dd2\u0daf\u0dba\u0dab \u0dc4\u0dab \u0dca\u200d\u0dab\u0d9a\u0dca\u0dc2\u0dba \u0d85\u0dd9\u0dab\u0dca\u200d\u0dba\u0dc0\u0dbb\u0dba\u0dab \u0dc3\u0dbd\u0dd9 \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0dc0\u0dab\u0dbb \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca - 2004-2010, 2010-2015 \u0daf\u0d9a\u0dca\u0dc0\u0dab \u0d9a\u0dab\u0dbd \u0dc3\u0dd3\u0dd9\u0dab\u0dc0\u0db1\u0dca\u0dc4\u0dd2 - \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a \u0dab. \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0d85\u0dc3\u0dca \u0dbb\u0dc3\u0da7\u0dca \u0dc0\u0dd2\u0daf\u0dba\u0dab \u0dc4\u0dab \u0dca\u200d\u0dab\u0d9a\u0dca\u0dc2\u0dba \u0d9a\u0dca\u0dc3\u0dc2\u0dca\u0dad\u0dca\u200d\u0dbb\u0dba \u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9 \u0dd9\u0db3\u0dc4\u0dab\u0dad\u0dca, \u0d8a\u0da7 \u0d85\u0dc0\u0dba\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd9\u0dc3\u0d85\u0daf \u0dd9\u0d9a\u0dd9\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9 \u0dd9\u0db3\u0dc4\u0dab\u0dad\u0dca \u0dc3\u0dc0\u0dc3\u0dc4\u0dd9 \u0dc0\u0dd4\u0dab\u0dd4 \u0d85\u0dd9\u0dab\u0dca\u200d\u0dba\u0dc0\u0dbb\u0dc3\u0dba\u0d9a\u0dd4 \u0dc4\u0dd0\u0dd2\u0dba\u0da7 \u0db1 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d92 \u0dc0\u0dab\u0dc3 \u0dd9 \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab 2019-2020 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc3\u0d9a\u0dd2 \u0d9a\u0dab\u0dbd \u0dc3\u0dd3\u0dd9\u0dab\u0dc0\u0d9a\u0dca \u0dad\u0dd4\u0db8 \u0dc3\u0dad\u0dd4\u0db8\u0dbb\u0dd4 \u0dd9\u0dd0\u0daf \u0db4 \u0dab\u0dc3\u0dad\u0dca \u0d86\u0dab\u0dca\u0dd4\u0d9a\u0dab\u0dbb\u0dc0\u0dbb\u0dba\u0dab \u0dc3\u0dbd\u0dd9\u0dad\u0dca \u0dc3\u0dd9\u0dca\u0dc0\u0dba \u0d9a \u0dab.\n\n2249 2250\n\n[\u0dd9\u0dbb\u0dd4 \u0db1\u0dd3\u0dad\u0dd2\u0da5 \u0dbb\u0dc0\u0dd4\u0db8\u0dca \u0dc4\u0d9a\u0dd3 \u0dd9\u0dc4\u0dca\u200d\u0dab]\n\n2026 \u0dd9\u0dd0\u0dba\u0dd2 22\n\n\u0dc3\u0daf\u0db4\u0dab\u0dbb\u0dca\u0dae\u0dca\u200d\u0dc3 \u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0d85 \u0d89\u0d82\u0da2\u0dd2\u0dc3\u0db1\u0dca\u0dbb\u0dd4\u0dc0\u0dbb\u0dc3\u0dba\u0d9a\u0dca. \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab\u0dc3 \u0dd9\u0dc0 \u0dd9\u0dd0\u0d9c\u0dd3\u0dad \u0dc3\u0db4\u0dc3\u0dbb\u0dca\u0dae\u0dbb\u0dab, \u0d86\u0da0\u0dab\u0dbb\u0dca\u0dae\u0dba \u0d91\u0db1\u0dca.\u0d91 . \u0dc3\u0db4\u0dc3\u0dbb\u0dca\u0dae\u0dbb\u0dab \u0dd9\u0dc4\u0dca\u200d\u0dab\u0dc3 \u0dd9\u0dc3\u0dc4\u0ddd\u0daf\u0dd2 \u0dba\u0dba\u0dd2. \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0dc0\u0dd2\u0dc0\u0dab\u0dc4 \u0dc0\u0dd4\u0dc3\u0dab\u0dca \u0d9a\u0dab\u0dd2\u0dbd\u0dab\u0dd3 \u0dd2\u0dbd\u0daf\u0dca\u0dc3\u0daf\u0dab\u0dd2\u0dba \u0dc0\u0dd2\u0dca\u200d\u0dab\u0dbb\u0dba \u0dd9\u0dc4\u0dad\u0dca\u0dd2\u0dbd\u0dba \u0dd9\u0dd9\u0d9f\u0dba\u0dd2. \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0db4\u0dd4\u0dca\u200d\u0dab\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0daf\u0dc3\u0daf\u0dc3\u0db1\u0d9a\u0dd4\u0dc3 \u0dd9\u0dc4 \u0d91\u0d9a\u0dca \u0daf\u0dd2\u0dba\u0dab\u0dd2\u0dba\u0d9a\u0dc3 \u0daf\u0dba\u0dab\u0db6\u0dbb \u0db4\u0dd2\u0dba\u0dad\u0dd4\u0db8\u0dc3\u0dd9\u0d9a\u0dca. \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0db4\u0dab\u0dd9\u0dbd\u0dca \u0d85\u0db0\u0db1\u0dba\u0dab\u0db4\u0db1\u0dba \u0dbd\u0dd0\u0db6\u0dd4\u0dc3\u0d85 \u0dd9\u0dc4\u0dd4\u0dc0\u0dc0\u0dbb \u0dad\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dca\u0dc0 \u0dc0\u0dd2\u0daf\u0dba\u0dab\u0dbd\u0dc3\u0dba\u0db1\u0dca \u0dd9\u0dc4 \u0dc3\u0d9a\u0dab \u0db9 \u0d86\u0db1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0daf\u0dba\u0dab\u0dbd\u0dc3\u0dba\u0db1\u0dca. \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0db4\u0dab\u0dd9\u0dbd\u0dca \u0dc0\u0db1\u0dc0\u0dd2\u0dca\u200d\u0dc3\u0dda\u0daf\u0dd3 \u0d89\u0dca\u200d\u0dab\u0dd9 \u0daf\u0d9a\u0dca\u0dc2 \u0dca\u200d\u0dbb\u0dd2\u0d9a\u0da7\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0d9a\u0dc3\u0dba\u0d9a\u0dca. \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0db4\u0dab\u0dd9\u0dbd\u0dca \u0dca\u200d\u0dbb\u0dd2\u0d9a\u0da7\u0dca \u0d9a\u0dab\u0dca\u0da9\u0dab\u0dba\u0dd9 \u0db1\u0dd2\u0dc3\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dba \u0d9a \u0dab. 1959\u0daf\u0dd3 \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0dc3\u0d9a\u0dab \u0db9 \u0dc0\u0dc0\u0daf\u0dba \u0dc0\u0dd2\u0daf\u0dba\u0dab\u0dbd\u0dc3\u0dba\u0db1\u0dca MBBS \u0dc3\u0db4\u0dab\u0dd2\u0d9a\u0dba \u0dbd\u0dd0\u0db6\u0dd4\u0dc0\u0dab. \u0d92 \u0dc0\u0dab\u0dc3 \u0dd9 \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dab\u0dbd\u0dc3\u0dda \u0dca\u200d\u0dbb\u0dd2\u0d9a\u0da7\u0dca \u0d9a\u0dab\u0dca\u0da9\u0dab\u0dba\u0dd9\u0dad\u0dca \u0db1\u0dd2\u0dc3\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dba \u0d9a \u0dab . \u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dc0\u0dd2\u0daf\u0dba\u0dab\u0dbd\u0dc3\u0dda \u0db1\u0dca\u0dd2\u0dba\u0daf\u0dd3 \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab 1957, 1958 \u0dc0\u0dd9\u0dbb\u0dc0\u0dbd\u0daf\u0dd3 \u0db4 \u0db8\u0dd4 \u0dc3\u0db4 \u0dd9\u0dbb\u0dab \u0dca\u200d\u0dbb\u0dd2\u0d9a\u0da7\u0dca \u0dca\u200d\u0dbb\u0dd9\u0dab\u0dc0\u0dd2\u0dba\u0da7\u0dad\u0dca \u0dd9\u0dc4\u0db7\u0dab\u0d9c\u0dd2 \u0dc0\u0dd4\u0dba\u0dab."
