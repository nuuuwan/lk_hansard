    "chunk_text": "\u0daf\u0d9a\u0dca\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc3\u0dda\u0dae\u0dc1 \u0db1 \u0daf\u0dc3\u0dc1 \u0db1\u0dc0\u0dc1. \u0d92\u0dc0\u0dc1\u0da7 \u0dca\u0db1 \u0d94\u0db6\u0dd4\u0db8\u0dca \u0dc1 \u0dd6\u0daf\u0dc1\u0db1\u0db8\u0dca\u0daf? \u0d92\u0dc0\u0dc1\u0da7 \u0dca\u0db1 \u0d85\u0dc0\u0db1\u0dba \u0dc0\u0dd2\u0db1\u0dd2\u0dc0\u0dd2\u0daf\u0db7\u0dc1\u0dc0\u0daf \u0dca \u0dba\u0dd4\u0dd4, \u0db4\u0dc4\u0dc3\u0dd4\u0daf\u0dc0\u0dca \u0dc0\u0dba\u0dc1\u0db4\u0dc1\u0dbb \u0d9a\u0dbb\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0dc0\u0db4\u0db4 \u0db4\u0dd2\u0dc5\u0dd2\u0daf\u0dc0\u0dc5\u0d9a\u0dca \u0daf\u0d9a\u0dc1\u0dc5\u0db9 \u0dc0\u0dbb\u0dc1 \u0db1\u0d9c\u0dbb \u0daf\u0d9a\u0dca\u0dca\u0daf\u0dca\u200d\u0dbb \u0d9a\u0dbb\u0daf\u0d9c\u0db1 \u0d94\u0db6\u0dd4\u0db8\u0dca \u0dc1 \u0dc4\u0daf \u0dc1 \u0dd2\u0daf\u0db6\u0db1\u0dc0\u0dc1\u0daf? \u0d85\u0dd4\u0db8 \u0d9c\u0dda\u0daf\u0dca \u0d92 \u0d85\u0dc0\u0db1\u0dba\u0dad\u0dc1\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc0\u0da7 \u0dc4\u0dc1 \u0daf\u0d9c\u0db1 \u0d89\u0dca\u0db1\u0dc0\u0dc1\u0daf \u0d9a\u0dd2 \u0db1 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0db1 \u0d85\u0db4\u0da7 \u0dd2\u0daf\u0db6\u0db1\u0dc0\u0dc1. \u0d92 \u0dc4\u0dd2\u0dca\u0daf\u0dc1 \u0d85\u0db4\u0dd2 \u0d94\u0db6\u0dd4\u0db8\u0dca \u0dc1\u0daf\u0d9c\u0dca \u0d89\u0dbd\u0dca \u0dca\u0daf\u0dca \u0daf\u0db8 \u0dba\u0dd2. \u0d85\u0daf \u0db8\u0db4\u0daf\u0daf\u0db4\u0dbb\u0daf\u0dd2\u0d9c \u0d87\u0dd2 \u0daf\u0dc0 \u0dc1 \u0dd2\u0daf\u0db6\u0db1 \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf \u0dc4\u0db8\u0dd4\u0daf\u0dda \u0d92 \u0d86\u0daf \u0ddd\u0da2\u0d9a \u0dca \u0d9c\u0db1\u0dd4\u0daf\u0daf\u0db1\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dc1 \u0dc0\u0dd2\u0d9a\u0dbd\u0dca\u0db4 \u0db8\u0db0\u0dba\u0dc3\u0dda\u0dae\u0dc1\u0db1, \u0dc0\u0dd2\u0d9a\u0dbd\u0dca\u0db4 \u0dbb\u0da7 \u0dc0\u0dbd\u0dca \u0daf\u0dc4\u0dc1 \u0db1\u0dc0\u0dc1. \u0dc4\u0db4\u0db6\u0db4\u0dba\u0dd2, \u0d94\u0dc0\u0dd4\u0dca\u0da7 \u0d85\u0dc0\u0db1\u0dba \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dd2\u0d9a, \u0db4\u0dca\u200d\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dd2\u0db8 \u0d9a\u0dc1\u0dbb\u0dda\u0dc1 \u0dd2\u0d9a, \u0d94\u0dc0\u0dd4\u0dca\u0da7 \u0d85\u0dc0\u0db1\u0dba \u0d9c\u0db1\u0dd4\u0daf\u0daf\u0db1\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0daf\u0db8\u0dca \u0db1\u0dd2\u0daf\u0dc4\u0dc3, \u0dc0\u0dd2\u0db1\u0dd2\u0dc0\u0dd2\u0daf\u0db7\u0dc1\u0dc0 , \u0daf\u0db8\u0daf\u0dc4\u0dda\u0da7 \u0d87\u0dc0\u0dd2\u0dbd\u0dca \u0dc1 \u0dad\u0db8\u0dca\u0daf \u0dc0\u0dba\u0dc1\u0db4\u0dc1\u0dbb \u0dc3\u0dda\u0dae\u0dc1\u0db4\u0db1 \u0d9a\u0dbb \u0dc1 \u0d92\u0dc0\u0dc1 \u0d89\u0dad\u0dc1\u0db8 \u0db1\u0dd2\u0daf\u0dc4\u0daf\u0dc3\u0dda \u0d9a\u0dbb\u0daf\u0d9c\u0db1 \u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0db4\u0dbb\u0dd2\u0dc3\u0dbb \u0dc4\u0daf \u0dc1 \u0daf\u0daf\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d91\u0dc0\u0db4\u0db1\u0dd2 \u0d85\u0dc0\u0d82\u0d9a \u0d8b\u0dad\u0dca\u0dc3\u0dc1\u0dc4 \u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0d94\u0daf\u0db6\u0dca \u0daf\u0d9a\u0dd2\u0dca\u0daf\u0dca \u0db1\u0db4\u0dc4\u0db4.\n\n\u0da2\u0db1\u0dc1\u0d9a\u0dbb\u0db4\u0dd2\u0dc0\u0dbb \u0dc1 \u0dad\u0db8\u0dba\u0dd2 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0db8\u0dd2. \u0daf\u0db8\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc4\u0db4\u0db8 \u0d91\u0d9a\u0da7 \u0db8 CID \u0daf\u0dd4\u0dc0\u0db1\u0dc0\u0dc1 \u0daf\u0dca. \u0da2\u0db1\u0dc1\u0d9a\u0dbb\u0db4\u0dd2\u0dd4\u0db8\u0dc1\u0daf \u0dc4\u0dd2\u0dad \u0dbb\u0dd2\u0daf\u0daf\u0db1 post \u0d91\u0d9a\u0d9a\u0dca \u0daf\u0db4\u0db8\u0dca\u0db8\u0dad\u0dca CID \u0db1\u0dc0\u0dc1, \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0daf \u0ddd\u0da2\u0dba \u0d9a\u0dae\u0dc1\u0db1\u0dc1 \u0d9a\u0dd4\u0db8\u0db1\u0dd2.\n\n\u0da2\u0db1\u0dc1\u0d9a\u0dbb\u0db4\u0dd2\u0dc0\u0dbb \u0dc1\u0daf \u0dc4\u0dd2\u0dad \u0dbb\u0dd2\u0daf\u0dd4\u0dda\u0dc1\u0db8\u0dad\u0dca CID \u0db1 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0, \u0daf\u0d9a\u0ddd\u0dd2 80\u0d9a\u0dca \u0dc0\u0db4\u0dbb\u0daf\u0dd2 \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0d9a\u0da7 \u0dc3\u0dbd\u0dca\u0dd2 \u0daf\u0d9c\u0dda\u0dc0\u0dc1\u0db8 \u0d87\u0dba\u0dd2 CID \u0d9c\u0dd2\u0daf \u0db1\u0db4\u0dad\u0dca\u0daf\u0dad\u0dca? \u0daf\u0db8\u0dc1\u0d9a\u0d9a\u0dca\u0daf \u0d92\u0d9a\u0da7 \u0d9c\u0dad\u0dca\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0db8\u0dc1\u0dbb\u0dca\u0d9c ? \u0daf\u0db8\u0dc1\u0d9a\u0d9a\u0dca\u0daf \u0d9c\u0dad\u0dca\u0dad \u0db4\u0dd2 \u0dc0\u0dbb \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0daf \u0ddd\u0da2\u0dba \u0d9a\u0dae\u0dc1\u0db1\u0dc1 \u0d9a\u0dd4\u0db8\u0db1\u0dd2? \u0db4\u0dd2 \u0dc0\u0dbb\u0d9a\u0dca \u0d9c\u0dad\u0dca\u0daf\u0dad\u0dca \u0db1\u0db4\u0dc4\u0db4. \u0d92\u0d9a \u0dc0\u0dc4\u0d9c\u0dca\u0db1 \u0d8b\u0dad\u0dca\u0dc3\u0dc1\u0dc4 \u0d9a\u0dc5\u0dc1. \u0da2\u0db1\u0dc0\u0dc1\u0dbb\u0dd2 \u0db8\u0dc1\u0dc3\u0daf \u0da2\u0db1\u0dc1\u0d9a\u0dbb\u0db4\u0dd2\u0dc0\u0dbb \u0dc1 \u0daf\u0dca\u0db1\u0dc0\u0dc1 \u0daf\u0db8\u0dca \u0d9c\u0db4\u0db1. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dad\u0dd3\u0dca\u0daf\u0dd4\u0dc0\u0d9a\u0dca \u0d9c\u0dad\u0dca\u0daf\u0dad\u0dca \u0db1\u0db4\u0dc4\u0db4, \u0d9a\u0dca\u200d\u0dbb\u0dd2 \u0dc1\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0dd4\u0daf\u0dab\u0dca\u0da9 \u0db1\u0db4\u0dc4\u0db4. \u0d9c\u0dbd\u0dca \u0d85\u0d9f\u0dd4\u0dbb\u0dd4 \u0dc0\u0d82\u0da0\u0dc1\u0dc0 \u0d91\u0d9a \u0db4\u0db4\u0dad\u0dca\u0dad\u0d9a\u0dd2\u0dca. \u0db6\u0dc1 \u0d9c\u0dbd\u0dca \u0d85\u0d9f\u0dd4\u0dbb\u0dd4 \u0daf\u0d9c\u0dca\u0dc0\u0dd3\u0db8\u0db8 \u0dc0\u0d82\u0da0\u0dc1\u0dc0\u0d9a\u0dca \u0daf\u0db1\u0dc1\u0daf\u0dc0\u0dba\u0dd2\u0dbd\u0dd4. \u0db6\u0dc1 \u0d9c\u0dbd\u0dca \u0d85\u0d9f\u0dd4\u0dbb\u0dd4 \u0daf\u0d9c\u0db1\u0dc1\u0dc0\u0dc1\u0db8 \u0d92\u0d9a \u0dc0\u0d82\u0da0\u0dc1\u0dc0\u0d9a\u0dca \u0daf\u0db1\u0dc1\u0daf\u0dc0\u0dba\u0dd2. \u0d9a\u0dc1 \u0dc1 \u0db6 \u0dc1 \u0daf\u0db1\u0dc1\u0daf\u0dc0\u0dba\u0dd2 \u0daf\u0dca \u0daf\u0d9c\u0db1\u0dc1\u0daf\u0dda. \u0daf\u0d9c\u0db1\u0dc1\u0dc0\u0dc1\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0d9a\u0dd1\u0daf\u0dda. \u0d9c\u0dbd\u0dca \u0d85\u0d9f\u0dd4\u0dbb\u0dd4 \u0dc0\u0d82\u0da0\u0dc1\u0dc0\u0d9a\u0dca \u0daf\u0db1\u0dc1\u0daf\u0dc0\u0dba\u0dd2\u0dbd\u0dd4. \u0dda\u0da2\u0dc1 \u0db1\u0db4\u0dd2\u0dc0 \u0d92\u0d9a \u0d9a\u0dd2 \u0db1 \u0dc0\u0dd2\u0d9a\u0dbb . COPE \u0d91\u0daf\u0d9a\u0dca \u0dc3\u0db7\u0dc1\u0db4\u0dd2\u0dc0\u0dbb \u0dc1 \u0dad\u0db8\u0dba\u0dd2 \u0d9a\u0dd2 \u0dca\u0daf\u0dca. \u0dda\u0da2\u0dba\u0dd2. \u0dda\u0da2\u0dba\u0dd2 \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0daf \u0ddd\u0da2\u0dba \u0d9a\u0dae\u0dc1\u0db1\u0dc1 \u0d9a\u0dd4\u0db8\u0db1\u0dd2.\n\n\u0daf \u0ddd\u0d9a\u0daf \u0dc0\u0db4\u0da9\u0dd2\u0db8 \u0db8\u0dd4\u0daf \u0d9a\u0dca \u0daf\u0d9c\u0dc0 \u0dc1 \u0daf\u0dad\u0dbd\u0dca \u0d9c\u0dad\u0dca\u0dad \u0dbb\u0da7 \u0db6\u0dc0\u0da7 \u0d85\u0db4\u0dd2 \u0db4\u0dad\u0dca \u0daf\u0dc0 \u0dc1 \u0dd2\u0daf\u0db6\u0db1\u0dc0\u0dc1. \u0daf\u0db4\u0dc1 \u0dbb\u0dca 286 - 302 \u0d85\u0dad\u0dbb \u0db8\u0dd2 \u0d9a\u0da7 \u0daf\u0dad\u0dbd\u0dca \u0d85\u0dbb\u0daf\u0d9c\u0db1 \u0dd2\u0daf\u0db6\u0dca\u0daf\u0dca. \u0daf \u0ddd\u0d9a\u0daf \u0dc0\u0db4\u0da9\u0dd2\u0daf \u0dca\u0db8 \u0daf\u0d9c\u0dc0 \u0dc1 \u0daf\u0dad\u0dbd\u0dca \u0d9c\u0dca\u0db1 \u0dbb\u0da7 \u0db6\u0dc0\u0da7 \u0d85\u0daf\u0dda \u0dbb\u0da7 \u0db4\u0dad\u0dca \u0daf\u0dc0 \u0dc1 \u0dd2\u0daf\u0db6\u0db1\u0dc0\u0dc1. \u0daf\u0db8\u0dca \u0dc4\u0db4\u0db8 \u0dbb\u0dd4\u0db4\u0dd2 \u0d9a\u0dca\u0db8, \u0dc4\u0db4\u0db8 \u0daf\u0db4\u0dc1 \u0dbb\u0dca \u0d91\u0d9a\u0d9a\u0dca\u0db8 \u0d85\u0dc0\u0dc3\u0dc1\u0db1\u0daf \u0d9a\u0dc1\u0da7 \u0daf \u0dca\u0daf\u0dca? \u0dca\u0daf\u0dca \u0dbb\u0daf\u0da7\u0dca\u0da7 \u0da2\u0db1\u0dad\u0dc1\u0dc0\u0da7 ."
