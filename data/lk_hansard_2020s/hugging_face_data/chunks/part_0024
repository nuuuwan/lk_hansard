    "chunk_text": "\u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0dd4\u0dad\u0dd4\u0dc0 \u0d9c\u0dc0 \u0d9c\u0d9c\u0dcf\u0db1\u0dbd\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0d9c\u0dc0 \u0d9a \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0dbd\u0dcf \u0dca\u0db1\u0db8\" \u0db4\u0db8\u0db1\u0dca\u0dad\u0d9c\u0dda \u0dc4\u0dd2\u0db4\u0dc0\u0dad\u0dca \u0d9c\u0d9a\u0d9c\u0db1\u0d9a\u0dd4\u0da7 \u0daf\u0dd3\u0dbd\u0dcf \u0db1\u0dd2\u0d9a\u0dc0 \u0d9c\u0d9c\u0db1\u0dca\u0dad\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf\u0daf? \u0db1\u0dd2\u0dd2\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0daf\u0dcf\u0db8\u0dba\u0d9a\u0dca \u0db1\u0dd2\u0dd2\u0db1 \u0db1\u0da7\u0dd2\u0db1\u0dcf\u0da7\u0dd2\u0dba\u0d9a\u0dca \u0d91\u0d9c\u0dc4\u0db8 \u0db1\u0dd4\u0dad\u0dca\u0db1\u0dc0 system \u0d91\u0d9a\u0d9a\u0dca \u0dc4\u0daf\u0db1 \u0d91\u0d9a \u0db4\u0db8\u0dba\u0dd2 \u0dca\u0db1\u0da7 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dca\u0d9a\u0dca\u0d9c\u0dba\u0ddd\u0d9c\u0dba. \u0d92\u0d9a\u0da7 \u0db4\u0db8\u0dba\u0dd2 \u0dca\u0db1\u0da7 \u0da2\u0dcf\u0db1 \u0dc0\u0dbb\u0db8 \u0daf\u0dd4\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad. \u0dca\u0dca \u0dc0\u0dd4\u0da9\u0dd2 \u0dc0\u0dc1\u0dca\u0d9c\u0dba\u0db1\u0dca\u0dad \u0dca\u0dba\u0dcf\u0d9c\u0db1 \u0dd2\u0dba\u0db4\u0dd4 \u0dc4\u0dd4\u0db8 \u0d9a\u0dca\u0d9c\u0dc2\u0dd0\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a\u0db8 \u0d91\u0d9a \u0d91\u0d9a \u0d9c\u0daf\u0dca\u0dc0\u0db1 \u0d9a\u0dbb\u0db4\u0dd4 \u0d91\u0d9a \u0d91\u0d9a \u0dad\u0db8\u0dad\u0dd2\u0da7 \u0d95\u0db1\u0dd1 \u0dd2\u0db0\u0dd2\u0dba\u0da7 \u0d91\u0d9a \u0d91\u0d9a \u0d9c\u0daf\u0dca\u0dc0\u0db1 \u0d9a\u0dbb\u0db4\u0dd4 \u0db4\u0db8\u0db1\u0dca\u0dad\u0d9c\u0dda \u0dc3\u0db8\u0dcf\u0d9c\u0dc0 \u0dc4\u0daf\u0dcf\u0d9c\u0d9c\u0db1 \u0d9c\u0db6\u0d9c\u0dc4\u0dad\u0dca \u0d9c\u0d9c\u0db1\u0dca\u0dad\u0dc0\u0db4\u0dd4 \u0db4\u0db8\u0db1\u0dca\u0dad\u0d9c\u0dda \u0dc3\u0db8\u0dcf\u0d9c\u0dc0 \u0dc4\u0daf\u0dcf\u0d9c\u0d9c\u0db1 \u0d9c\u0db1 \u0dca\u0d9f\u0dd4\u0dbb\u0dd4 \u0d9c\u0d9c\u0db1\u0dca\u0dad\u0dc0\u0db4\u0dd4 \u0dbb\u0da7\u0d9a\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dc0\u0dc5\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0db4\u0db8\u0dba\u0dd2 \u0dca\u0db1\u0da7 \u0db7 \u0dcf\u0dbb \u0daf\u0dd4\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d9c\u0dc0 \u0dbb\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dc0\u0dc5\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0dca\u0db4\u0dd2 \u0db1\u0da7\u0db1\u0dca\u0dad \u0d9c\u0d9c\u0db1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf.\n\n\u0dad\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dc3\u0dc0 \u0db6\u0db1\u0dca\u0dad\u0db0\u0dca\u200d\u0d9c\u0dba\u0db1\u0dca\u0dad \u0d9c\u0dad\u0dca\u0d9c\u0db4\u0dcf\u0dad\u0dca \u0d9c\u0dc0 \u0dad\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dba\u0da7\u0d9c\u0dad\u0dca \u0db4\u0db8\u0dba\u0dd2 \u0dca\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 3\u0d9a\u0da7 \u0db1\u0dc3\u0dd0\u0d9c\u0dc3\u0dd0 \u0d9c\u0da7\u0db1\u0dca\u0dad\u0da9\u0dbb\u0dca \u0db1\u0dd4\u0dad\u0dd4\u0dc0 \u0d9a\u0dbb\u0db4\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dd2\u0dba\u0d9a\u0dca \u0db1\u0dd2\u0dd2\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dd2\u0dba\u0d9a\u0da7 \u0d9c\u0d9c\u0d9c\u0db1\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad. \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d92\u0d9a \u0dca\u0db4\u0dd2 \u0db1\u0dd4\u0dc4\u0dd4\u0daf\u0dd2\u0dd2 \u0d9a\u0dbb \u0d9c\u0db4 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. 2010 \u0dca\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0d9c\u0daf\u0dca \u0d89\u0db3\u0db1\u0dca\u0dad \u0d9c\u0dc0 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dbd\u0da7 \u0dad\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0db8\u0dd4\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0dc0\u0dd4\u0dab\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d9c\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad. 2010 \u0dca\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0d9c\u0daf\u0dca \u0d89\u0db3\u0db1\u0dca\u0dad \u0dad\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0db8\u0dd4\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0d9c\u0dc0\u0dbd\u0dcf \u0db4\u0db8\u0dba\u0dd2 \u0d9c\u0dc0 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca\u0db4 \u0d9a\u0d9c\u0dc5\u0dd0 \u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0daf\u0dd4\u0db1\u0dca\u0dad \u0db4\u0db8\u0dba\u0dd2 \u0dad\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0db8\u0dd4\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0d9c\u0dc0\u0dbd\u0dcf \u0db1\u0dd4\u0dad\u0dd4\u0dc0 \u0d9c\u0da7\u0db1\u0dca\u0dad\u0da9\u0dbb\u0dba\u0d9a\u0dca \u0d9c\u0daf\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad. \u0d92 \u0d9c\u0db4 \u0d9c\u0dc0\u0da0\u0dca\u0da0 \u0d9a\u0dcf\u0dbd\u0d9c\u0dba\u0db1\u0dca\u0dad \u0db7 \u0dcf\u0d9c\u0dba\u0d9a\u0da7 \u0dc0\u0da9\u0dcf \u0d9a\u0dd4\u0db6\u0dd2\u0db1\u0da7\u0dca \u0db8\u0da9\u0dd4\u0d9a\u0da9\u0dbd\u0d9c\u0dba\u0db1\u0dca\u0dad \u0db4\u0db8\u0dba\u0dd2 \u0daf\u0dd4\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad. \u0dad\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0db8\u0dd4\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0d9c\u0dc0\u0dbd\u0dcf \u0d9a\u0dbb\u0db4\u0dd4 \u0d9c\u0da7\u0db1\u0dca\u0dad\u0da9\u0dbb\u0dca \u0dad\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0db8\u0dd4\u0daf\u0dd2\u0dc4\u0dad\u0dca \u0d9c\u0dc0\u0dbd\u0dcf \u0d9a\u0dbb\u0db4\u0dd4 \u0d9c\u0db1\u0dd4\u0d9c\u0daf\u0db1\u0dd4 \u0daf\u0dd4\u0db1\u0dca\u0dad \u0d91\u0d9c\u0dc4\u0db8 \u0d9c\u0db1\u0dcf\u0d9a\u0dbb\u0db4\u0dd4 \u0d91\u0d9a \u0db4\u0db8\u0dba\u0dd2 \u0d9c\u0dc0 \u0dad\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad.\n\n\u0d9c\u0dd4 \u0db8\u0dd6\u0dbd\u0dcf \u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0db8\u0db1\u0dca\u0dd3\u0dd4\u0dbb\u0db8\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0ba4\u0b95\u0bb2\u0b95\u0bae\u0ba4\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0dd4\u0db6\u0dad\u0dd4\u0db8\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0dad \u0d9a\u0dae\u0dcf\u0dc0 \u0dca\u0dc0\u0dc3\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0dad\u0db1 \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2. \u0d9c\u0dd4 (\u0dc0\u0dc0 \u200d) \u0db1\u0da2\u0dd2\u0dca \u0d89\u0db1\u0dca\u0daf\u0dd2\u0d9a \u0db8\u0dad\u0dad\u0dca\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 (\u0b95\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bb0\u0bcd) \u0ba8\u0b9c\u0bbf\u0ba4\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0b95\u0bcd\u0b95) (The Hon. (Dr.) Najith Indika) \u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0d9c\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db8\u0da7 \u0dd2\u0db1\u0dcf\u0da9\u0dd2\u0dba\u0d9a\u0dca \u0d9c\u0daf\u0db1\u0dca\u0dad\u0db1.\n\n\u0dca\u0dc0\u0dc3\u0dcf\u0db1 \u0dc0\u0dc1\u0dca\u0d9c\u0dba\u0db1\u0dca\u0dad \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0d9c\u0db1\u0dca\u0dad \u0d9c\u0dc0 \u0d9a\u0dba\u0dd2. \u0dca\u0db4\u0dd2 system \u0d91\u0d9a\u0d9a\u0dca \u0dc4\u0daf\u0db1\u0d9c\u0d9a\u0dcf\u0da7 system \u0d91\u0d9a\u0d9a\u0dca \u0db1\u0dd4\u0dad\u0dd2\u0d9a\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dcf\u0dd2\u0db1 \u0d9c\u0dad\u0dca\u0db4 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd0\u0db8\" - \u0d92 \u0dca\u0dba\n\n\u0db8\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dbb\u0dd4 \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dad\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dd4 \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dc3\u0db8\u0dcf\u0d9c\u0dc0 \u0dc0\u0dbd \u0dca\u0dba \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u0dca\u0dba\u0db4\u0db1\u0dc0\u0dbd \u0dca\u0dba \u0d9c\u0dc0\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad - \u0d9a\u0dbd\u0db6\u0dbd \u0d9c\u0dc0\u0db1\u0dc0\u0dcf; \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0dd0\u0db1 \u0dc4\u0daf\u0db1\u0dc0\u0dcf; system \u0d91\u0d9a \u0dc4\u0dd4\u0d9c\u0daf\u0db1 \u0d91\u0d9a \u0db1\u0dc0\u0dad\u0dca\u0dc0\u0dbd\u0dcf \u0db1\u0dbb\u0dab \u0dd2\u0db0\u0dd2\u0dba\u0da7\u0db8 \u0dba\u0db1\u0dca\u0dad\u0db1 \u0db1\u0dbb\u0dab \u0dd2\u0db0\u0dd2\u0dba\u0da7\u0db8 \u0d9a\u0dcf\u0dbd\u0dcf \u0db6\u0dd3\u0dbd\u0dcf \u0d89\u0db1\u0dca\u0dad\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0dad \u200d\u0dbb\u0db8\u0dc0\u0dbd\u0da7 \u0dba\u0db1\u0dca\u0dad\u0db1 \u0dd4\u0dc0\u0dd4\u0db1\u0dca\u0dad \u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0dca\u0db4\u0dd2 \u0d92\u0d9a \u0daf\u0d9a\u0dd2\u0db1\u0dc0\u0dcf. \u0d9c\u0dc0 \u0dca\u0da9\u0dd4\u0d9a\u0dca\u0dc0 \u0db1\u0dad\u0dca \u0d9c\u0dc0\u0dbd\u0dcf \u0d9c\u0dc0 \u0dc0\u0db1\u0dd2\u0da7 \u0dca\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0d91\u0d9a\u0dc4\u0db8\u0dcf\u0dbb\u0dba\u0dd2. \u0dca\u0db4\u0dd2 \u0d92 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0d9c\u0da7\u0db1\u0dca\u0dad\u0da9\u0dbb\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dd2 \u0db6\u0dd2\u0db3\u0dd2\u0db8\u0dd2\u0db1\u0dca\u0dad \u0db1\u0dd2\u0dd2\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dd2\u0dba\u0da7 \u0dca\u0db1\u0dd4\u0dc0 \u0d9c\u0da7\u0db1\u0dca\u0dad\u0da9\u0dbb\u0dca \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca\u0dad \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d9c\u0db8\u0dcf\u0db1 \u0db6\u0dcf\u0db0\u0dca\u200d\u0d9a \u0dca\u0dc0\u0dad\u0dca \u0dca\u0db4\u0dd2 \u0d92 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca\u0db4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0db8\u0db8 \u0dca\u0dc0\u0dc3\u0dcf\u0db1 \u0dc0\u0dc1\u0dca\u0d9c\u0dba\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db1 \u0d95\u0db1\u0dd1."
