d9c\u0d9a\u0dcf \u0db8\u0dc4\u0dc3 \u0db6\u0dd0\u0d9c\u0d9a\u0dd4\u0dc0 \u0dc0\u0db1 \u0dca\u0db3\u0dc4\u0dc3\u0dcf \u0dc0\u0dd2\u0dc0\u0d9b\u0db4\u0dc2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dca\u0db8 \u0dbb\u0dcf\u0dc1\u0dd2\u0dba\u0dca \u0db8\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca0 \u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d9c\u0d9a\u0dcf \u0db8\u0dc4\u0dc3 \u0db6\u0dd0\u0d9c\u0d9a\u0dd4\u0dc0 \u0dc0\u0db1 \u0dc0\u0dc0\u0db1\u0dc0\u0d9a\u0dcf \u0d92\u0d9a \u0d85\u0daf\u0dcf\u0dc5 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dca\u0db8 \u0db8\u0db1\u0dd2\u0db8\u0dd2\u0dca \u0db4\u0dc0\u0dd2\u0db1\u0db1\u0dc0\u0dcf0 \u0d8a \u0db4\u0dca\u0db4\u0dc0\u0dca\u0db4 \u0dbb\u0da2\u0dca\u200d\u0dba\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0d85\u0db4\u0dd2 \u0dc0\u0db1 \u0dca\u0db1\u0db6\u0dca\u0db0\u0dc0\u0dba\u0dca \u0d85\u0daf\u0dcf\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0db1\u0db4\u0dad\u0dca\u0dd2\u0db1\u0db8\u0dba \u0dad\u0dd3\u0dbb \u0db8\u0dca\u0db1 \u0d95\u0db1\u0dd10 \u0d92 \u0dc0\u0dc0\u0db1\u0dd4\u0dc0\u0dc0\u0dca \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0db1\u0db4\u0dad\u0dca\u0dd2\u0db1\u0db8\u0dba \u0dad\u0dd3\u0dbb \u0dc0\u0db1 \u0dc0\u0dc0\u0db1\u0dc0\u0d9a\u0dcf \u0db8\u0db1\u0dd2\u0db8\u0dd2\u0dca \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dcf0 \u0d8a \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0dc0\u0db1 \u0dc0\u0d9a\u0dc0\u0dbb\u0dc4\u0dd2 \u0dca\u0db4\u0dc0\u0dba\u0d9c \u0db4\u0dcf\u0dbd\u0db1\u0dba\u0dca \u0d87\u0dd2\u0db1 \u0d9a\u0dbb \u0db8\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca0 \u0dc0\u0db8\u0dcf\u0d9a\u0daf \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0dbb \u0db8\u0dd0\u0db1 \u0dc4\u0dd2\u0dad\u0dbd\u0dcf \u0dbb\u0dc0\u0dca \u0dca\u0daf\u0dd2\u0dd2\u0dba \u0d85\u0db1\u0dcf\u0db8\u0dad\u0dba \u0db8\u0dd0\u0db1 \u0dc4\u0dd2\u0dad\u0dbd\u0dcf \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0dbd\u0dd2\u0db8\u0d9a\u0dc0 \u0dc0\u0db1 \u0d85\u0dc0\u0dca\u0db4\u0dae\u0dcf\u0dc0\u0dda\u0daf\u0dd3 \u0dad