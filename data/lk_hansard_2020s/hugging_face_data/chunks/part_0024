u0dca\u0db1\u0db6\u0dcf \u0dd3 \u0dc0\u0dca\u0db8\u0dc0\u0dbd \u0dc0\u0da9\u0dcf \u0dc0\u0dd0\u0da9\u0dd2\u0dba\u0dd20 \u0d85\u0db4\u0dd2 \u0d92 \u0db1\u0dd2\u0dca\u0dcf\u0db8 \u0d9a\u0dd3\u0dd2\u0dba \u0dca\u0db1\u0db6\u0dcf\u0dc0\u0dbd \u0dc0\u0dd0\u0da9\u0dd2 \u0db8\u0dd2\u0dbd\u0dca \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb\u0dbd\u0dcf \u0dd2\u0db1\u0dc0\u0db6\u0db1\u0dc0\u0dcf0 \u0d85\u0dc0\u0db1\u0dca \u0dca\u0db1\u0db6\u0dcf \u0dd3 \u0d9a\u0dd2\u0dc0\u0dbd\u0ddd\u0dc0\u0d9a \u0d85\u0db4\u0dd2 \u0db1\u0dca\u0db4\u0dd2\u0dba\u0dbd\u0dca 130\u0dca \u0dc0\u0daf\u0daf\u0dca\u0daf\u0dd3 \u0d9a\u0dd3\u0dd2\u0dba \u0dca\u0db1\u0db6\u0dcf \u0dd3 \u0d9a\u0dd2\u0dc0\u0dbd\u0ddd \u0d91\u0d9a\u0d9a \u0db1\u0dca\u0db4\u0dd2\u0dba\u0dbd\u0dca 140\u0d9a \u0db8\u0dd2\u0dbd\u0dca \u0dc0\u0daf\u0db1\u0dc0\u0dcf0 \u0db1\u0db8\u0dd4\u0dad\u0dca \u0d92 \u0db8\u0dd2\u0dbd\u0dad\u0dca \u0dca\u0dd1\u0dc0\u0dc4\u0dc3\u0dca\u0dc0\u0dca \u0db1\u0dd0\u0dc4\u0dc3\u0dd00 \u0d9a\u0dd3\u0dd2\u0dba \u0dca\u0db1\u0db6\u0dcf\u0dc0\u0dbd \u0db1\u0dd2\u0dc2\u0db4\u0db4\u0dcf\u0daf\u0db1 \u0db4\u0dd2\u0dd2\u0dba\u0dc0\u0dd0\u0dba \u0dc0\u0dd0\u0da9\u0dd2\u0d9a\u0db8\u0dad\u0dca \u0dc0\u0db8\u0dcf \u0d9a\u0dbb\u0dca\u0db1 \u0dd2\u0db1\u0dc0\u0db6\u0db1 \u0d85\u0db4\u0dc4\u0dc3\u0dc3\u0dd4\u0dad\u0dcf\u0dc0\u0dad\u0dca \u0dca\u0dbd\u0d9a\u0dbd\u0dcf \u0d8a \u0dc0\u0da9\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0db8\u0dd2\u0dbd\u0dca \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dc0\u0daf\u0dca\u0db1 \u0d85\u0dc0\u0d9b\u0dba\u0dba\u0dd20 \u0d85\u0db4\u0dd2 \u0d85\u0dc0\u0dca\u0dca\u0dc2\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0dca\u0daf\u0dd2\u0dd2\u0dba \u0d9a\u0dcf\u0dbd\u0dc0\u0dda\u0daf\u0dd3 \u0d9a\u0dd3\u0dd2\u0dba \u0dca\u0db1\u0db6\u0dcf \u0dc0\u0db8\u0dcf \u0d9a\u0dbb\u0db1 \u0dc0\u0db8\u0dcf\u0dd3\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0db8\u0dd2\u0dbd\u0dca \u0dbd\u0db6\u0dcf \u0dc0\u0daf\u0dca\u0db10 \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dc0\u0db1 \u0dc0\u0dc0\u0dbd\u0dcf\u0dc0\u0dda \u0d8a \u