    "chunk_text": "\u0dc0\u0dd2\u0dda \u0dad\u0dc2\u0dca\u0da8\u0dda\u0dba\u0dca\u0db8\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dca\u0dad\u0dc0\u0dcf\u0daf\u0dbb\u0dd2\u0dca\u0db8\u0d9a\u0dd2\u0dba\u0dca\u0dda\u0dca\u0db8\u0dd9\u0dc0\u0dd4\u0dbd\u0db8\u0d9a\u0dd2\u0dba\u0dca\u200d\u0daf\u0db8\u0d85\u0db4\u0dd2\u0db8\u0dda\u0dba\u0daf\u0da9\u0dca\u0db4\u0d9a\u0dca\u0dc0\u0db8\u0dc0\u0dd2\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0db8\u0dd9\u0dba\u0dca\u200d\u0daf\u0db8\u0dbb\u0db4\u0dbd\u0dd4\u0dda\u0dcf\u0daf\u0dca \u0db8\u0dba \u0db8\u0dda\u0daf\u0dca\u0db0 \u0dba\u0daf\u0dca\u200d\u0db1\u0db8 \u0dc0\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dda\u0dc4\u0ddd\u0db8\u0dba \u0d9a\u0dca\u0dc0\u0db8\u0d9c\u0db4\u0db1\u0db8\u0dc0 \u0dca\u0dda \u0db8 \u0dc0\u0dba\u0da7 \u0db8\u0dd2\u0dba\u0dba\u0daf\u0dd4\u0dad\u0db0\u0db8\u0db4\u0dd4\u0daf\u0dca\u0db0\u0d9c\u0dca\u200d\u0dba\u0dca\u0db8 \u0dba\u0dda\u0dba\u0da7 \u0db8\u0dba\u0dca\u0db8\u0dd9\u0dba\u0db1\u0db8\u0db4\u0dd2\u0db4\u0dad\u0dc3\u0dca\u0db8\u0dc0 \u0dd2\u0db6\u0db8\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dca\u0dad\u0dc0\u0dcf\u0daf\u0dbb\u0dd2\u0dca\u0db8\u0d9a\u0dd2\u0dba\u0dca\u200d\u0daf\u0db8\u0d9a\u0dd2\u0dba\u0dca\u0dda\u0dca.\u0db8\u0dda\u0da2\u0dca\u0dc0\u0dd3\u0db8\u0db4\u0dd3\u0db8\u0dda\u0dcf\u0dca\u0db1\u0db8\u0db4\u0dd4\u0dc5\u0dd4\u0dcf\u0dca \u0db8\u0d91\u0dca \u0da7\u0dd3\u0da7\u0dd3\u0d8a\u0db8\u0dda\u0dcf\u0dca\u0db1\u0db8\u0db4\u0dd4\u0dc5\u0dd4\u0dcf\u0dca \u0db8\u0d95\u0db1\u0dd1 \u0db8\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dca\u0dad\u0dc0\u0dcf\u0daf\u0dbb\u0dd2\u0db8\u0dd9\u0dab\u0dca\u0da9\u0db4\u0daf\u0dba \u0d9a\u0dca\u0dc0\u0db8\u0dc0 \u0dca\u0dda \u0db8 \u0dc0\u0dba\u0db8\u0db4\u0dca\u200d\u0dbb\u0dd9\u0daf \u0db8\u0dd9\u0dba\u0dca\u0db1\u0db8\u0da2\u0dd3\u0dc0\u0dd2\u0dc0\u0db8\u0db1\u0db4\u0dd2\u0db8\u0dd9\u0dba\u0db1\u0dcf\u0daf\u0db8\u0db1 \u0db8\u0db8\u0dd2\u0dd2\u0dba\u0dc3\u0dca\u0dad\u0dc3\u0dd4\u0db8 \u0dba\u0db1\u0dcf\u0daf\u0db8\u0db1 \u0db8\u0d92\u0dd9\u0db8\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dca\u0dad\u0dc0\u0dcf\u0daf\u0dbd\u0dba.\u0db8\u0db8\u0d92\u0db8 \u0dda\u0dca \u0da0\u0dca\u0da1\u0db8\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dca\u0dad\u0dc0\u0dcf\u0daf\u0dbd\u0dba\u0db8\u0d85\u0dcf\u0dc3\u0dca\u0dca\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0db8 \u0db8\u0dc4\u0dd2\u0dc0\u0dca\u0dda\u0dca\u0db8\u0d85\u0dba\u0da7 \u0db8\u0d85 \u0dc0\u0dd9\u0db8\u0dda\u0dcf\u0dca\u200d\u0daf\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf.\u0db8\u0dc0\u0dd2\u0dda \u0dad\u0dc2\u0dca\u0da8\u0dda\u0dba\u0dca\u0db8\u0dda \u0db8\u0dd2\u0dba\u0dbd\u0dc4\u0dc3\u0dca\u0db8\u0dd2\u0dda\u0dbb\u0daf\u0dca\u0db0\u0dd3\u0db1\u0db8\u0d92\u0db8\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dca\u0dad\u0dc0\u0dcf\u0daf\u0dd3\u0db1\u0db8\u0dcf\u0dba\u0dc3\u0dca\u0db1\u0dba\u0db8\u0d85\u0dba\u0da7 \u0db8\u0d85 \u0dc0\u0dd9\u0db8\u0dc0\u0dd4\u0dda\u0dca\u0db8\u0d92\u0db8\u0dba\u0dda\u0dc0\u0dd2\u0dbb\u0dd4\u0dcf\u0dca\u0db8\u0dc0 \u0dca\u0dda \u0db8\u0da2\u0dd3\u0dc0\u0dd2\u0dc0\u0db8\u0dba\u0dba\u0daf\u0dd4\u0dcf\u0da7 \u0db8\u0dc0\u0dbb\u0dca\u200d\u0daf\u0db8\u0d92\u0db8\u0dd9\u0dba\u0db4\u0dd4\u0db8\u0dc0\u0dd3\u0db8\u0dba\u0daf\u0dca\u0dc0\u0dd2\u0dc0\u0dba\u0db8\u0d85\u0db4\u0dd2\u0db8\u0d85\u0d9c\u0dba\u0db8\u0dd9\u0dba\u0db1\u0dcf\u0daf.\u0db8\u0d92\u0db8\u0dcf\u0daf\u0dda \u0db8\u0d92\u0db8\u0db8\u0dd2\u0dba\u0db8\u0dd2\u0dba\u0db8\u0dba\u0dc0\u0dd4\u0dca \u0dcf\u0dca\u200d\u0da7 \u0db8\u0d92\u0db8\u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0dda\u0dbd\u0db1\u0daf\u0da7 \u0db8\u0d85\u0dda\u0db4\u0dca\u0db8\u0dda \u0ddd\u0dd9\u0dba\u0db8\u0d92\u0db8\u0dcf\u0daf\u0dda \u0db8\u0d85\u0dda\u0db4\u0dca\u0db8\u0dda\u0d9c \u0dba\u0dcf\u0dba\u0db8\u0dda \u0db8\u0d85\u0dcf\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0db1\u0db8\u0dba\u0dc5\u0db8\u0dd9\u0dba\u0db1\u0dcf\u0daf.\n\n\u0dca\u0dd3\u0dad\u0dd4\u0db8 \u0dd2\u0dba \u0db8\u0d94\u0dbb\u0dad\u0dd4\u0db8 \u0daf\u0dda \u0db8\u0dcf\u0dba\u0dc3\u0dca\u0dd9\u0db8 \u0dcf \u0db8\u0d85\u0dda\u0db4\u0dca\u0db8\u0d85 \u0dca\u200d\u0daf-\u0dc0\u0daf\u0dca\u0dc0\u0dca\u200d\u0daf\u0db8\u0dda\u0dd9\u0daf \u0db4\u0dd2\u0dd4\u0dad\u0da7 \u0dbb\u0dca\u0db8\u0d91\u0dd9\u0db8\u0dc4\u0dba\u0dc4\u0daf\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dda\u0d9c\u0dcf\u0dca\u0db1\u0db8\u0dbd\u0dca\u0dda\u0dca\u0db8\u0db1\u0db4\u0dc4\u0db4.\u0db8\u0db8\u0dba\u0daf\u0dbb\u0dca\u0dd2\u0db1\u0dda \u0dca\u0dad\u0dd4\u0db8\u0dda\u0dc1\u0db8\u0dda\u0dc3\u0dca\u0dad\u0dcf\u0dd9\u0dba\u0dca\u0dda \u0db8\u0db1 \u0db8\u0dba\u0da9\u0dd2\u0dda\u0dba\u0dca \u0db8\u0d92\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0d85\u0dd4\u0db8\u0dd9\u0dba\u0d9c\u0dca\u0db1\u0dcf\u0daf.\u0db8\u0d94\u0dc0\u0dd4\u0dca\u0db8\u0dda\u0dcf\u0db1\u0db8\u0dcf\u0dba\u0daf\u0dba\u0daf\u0dba\u0db8\u0dd9\u0dba\u0dca\u0dda\u0dca\u0db8\u0db1\u0db4\u0dc4\u0db4.\u0db8\u0dbb\u0db4\u0db4\u0dad\u0db8\u0dda\u0dcf\u0dca\u200d\u0daf\u0dcf\u0dca\u0db8\u0d9c\u0dda \u0db8\u0dda\u0dba\u0daf\u0da9\u0dd2\u0db8\u0db6\u0dd2\u0dc3\u0dca\u0dad\u0db1\u0dc3\u0dca\u0dad\u0db8\u0d91\u0dd9\u0d9a\u0dca\u0dc0\u0db8\u0dd9\u0dba\u0db1\u0db8 \u0db1\u0dd4\u0dc3\u0dca\u0dad\u0dc3\u0dca\u0dda\u0dba\u0d9a\u0dd4\u0da7 \u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dc6\u0dd2\u0db6\u0dca \u0db8\u0d91\u0dd9\u0db8\u0dbd\u0daf\u0d9c\u0dca\u0db1\u0db8\u0dbb\u0db4\u0db4\u0dad\u0db8\u0dc0\u0dd4\u0dda\u0dda\u0daf\u0dca \u0db8\u0d92\u0db8\u0dd9\u0da7 \u0dd4\u0dad\u0dca\u0dc0\u0db8online \u0d9a\u0dca\u200d\u0dbb \u0dba\u0da7 \u0db8\u0dd9\u0dba\u0dca\u0db1\u0db8\u0dbd\u0dca\u0dda\u0dca\u0db8\u0db1\u0db4\u0dca\u0db1 \u0db8\u0d92\u0db8\u0db4\u0dd4\u0daf\u0dca\u0db0\u0d9c\u0dca\u200d\u0dba\u0daf\u0db8\u0dc4\u0dd2\u0dda\u0dbb\u0dca\u0da7 \u0db8\u0dba\u0db1\u0db8\u0dc0\u0dca\u0dca\u0dcf\u0dba\u0da7 \u0db8\u0dba\u0dca\u0db8\u0dd9\u0dba\u0dca\u0db1\u0db8\u0db4\u0dd4\u0dc5\u0dd4\u0dcf\u0dca.\u0db8\u0d94\u0dc4\u0dd4\u0dda \u0db8\u0da2\u0dd3\u0dc0\u0dd2\u0dc0\u0dba\u0db8\u0d85\u0dcf\u0dc3\u0dca\u0dca.\u0db8\u0dc4\u0dd2\u0dda\u0dbb\u0dca\u0db8\u0dd2\u0dba\u0db8\u0db4\u0dd4\u0daf\u0dca\u0db0\u0d9c\u0dca\u200d\u0dda\u0dba\u0d9a\u0dd4\u0da7 \u0db8\u0d86\u0dba\u0dc3\u0dd4\u0db8\u0dcf\u0dba\u0daf\u0dba\u0daf\u0dba\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dd9\u0dba\u0dca\u0db1\u0db8\u0dc4 \u0dbb\u0db8\u0dda\u0dcf\u0dca\u0dda\u0dca\u0db8\u0db1\u0db4\u0dc4\u0db4.\u0db8\u0d85\u0db4\u0dd2\u0db8\u0dda\u0dba\u0ddd\u0da2\u0db1\u0daf\u0db8\u0dcf\u0d9c\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dba\u0dca\u0db8\u0dd9\u0dba\u0dca\u200d\u0daf\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf \u0db8\u0dda \u0dba\u0db8\u0dc3\u0dca\u0d82\u0dda \u0ddd\u0db0\u0db1\u0dba\u0db8\u0dd9\u0dba\u0dca\u0db1.\u0db8\u0dc4\u0dd2\u0dc0\u0d9a\u0dca\u0dc0\u0db8\u0dba\u0db4\u0dd4\u0dcf\u0d9a\u0dca\u0dc0\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf\u0db8\u0db1 \u0db8\u0dc3\u0dca\u0daf \u0daf\u0db1\u0dba\u0db8 \u0db1\u0dd4\u0dc3\u0dca\u0dad\u0dc3\u0dca\u0dda\u0dba\u0d9a\u0dd4\u0da7 \u0db8\u0dda\u0dcf\u0db1\u0db8\u0dcf\u0dba\u0dc3\u0dca\u0db1\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dc3\u0dca \u0dbb\u0dca\u0db0\u0dda\u0dba\u0dca\u0db8\u0dba \u0db8\u0dc4\u0db4\u0d9f\u0dd3 \u0d9a\u0dca\u0dc0\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf\u0db8\u0db1 \u0db8\u0dda \u0dba\u0db8\u0dc3\u0dca\u0d82\u0dda \u0ddd\u0db0\u0db1\u0dba\u0db8\u0dd9\u0dba\u0dca\u0db1.\u0db8\u0dd2\u0dba\u0dd9 \u0db8\u0dc4\u0dd2\u0dda\u0dbb\u0dca\u0db8\u0dbd\u0daf\u0dca\u0dda\u0dca\u0db8\u0db1\u0db4\u0dad\u0dd4\u0db8\u0dcf\u0db8\u0dda \u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dc3\u0dca \u0dbb\u0dca\u0db0\u0dda\u0dba\u0dca\u0db8\u0d85\u0db1\u0dd4\u0d9c \u0db1\u0dba\u0db8\u0dd9\u0dba\u0dca\u0db1\u0db8\u0db4\u0dd4\u0dc5\u0dd4\u0dcf\u0dca\u0db8\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dcf\u0dd2\u0db1\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0d85\u0dda\u0db4\u0dca\u0db8\u0dc3\u0dca\u0d82\u0dda \u0ddd\u0db0\u0db1\u0db8\u0d87\u0dad\u0dd4\u0db8\u0dda\u0dc5\u0dad\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf.\u0db8\u0d85\u0db4\u0dd2\u0db8\u0d92\u0dcf\u0daf\u0db8\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dba\u0dca\u0db8\u0dd9\u0dba\u0dca\u200d\u0daf\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf."
