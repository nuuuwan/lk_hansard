dca \u0d91\u0dd2\u0dbb\u0db8\u0db1\u0d9a \u0dc3\u0db8\u0db8\u0ddd\u0db0\u0dd2\u0db1\u0dd2\u0dad \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0dc0\u0dd2\u0dba\u0d9a\u0dca\u0dc0 \u0dc0 \u0db8\u0dba\u0db1\u0dca \u0d85\u0db0\u0dba\u0dd2\u0db4\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dda\u0d9a\u0dbb\u0dab \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0dad\u0dca\u0db8\u0d9a \u0db8\u0dc0. 2026 \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0db8\u0dd3\u0daf\u0dd3 \u0db4\u0dd2\u0dc3\u0dbd\u0dca\u0dc0\u0d9a 1\u0dc0\u0db1 \u0db8\u0dbb\u0dda\u0dab\u0dd2\u0dba \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0d9a\u0dd2\u0dbb\u0d9a\u0dda \u0db4\u0dd2\u0daf\u0d9a -Activity Based- \u0dc0\u0dd2\u0dc2\u0dca\u0da8\u0dba\u0db8\u0dd2\u0d9a\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dda\u0d9a\u0dbb\u0dab \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0dad\u0dca\u0db8\u0d9a \u0db8\u0dc0. 2027 \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0db8\u0dd3\u0daf\u0dd3 2 \u0db8\u0dbb\u0dda\u0dab\u0dd2\u0dba \u0dc3\u0db3\u0dc4\u0dd2 \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0d9a\u0dd2\u0dbb\u0d9a\u0dda \u0db4\u0dd2\u0daf\u0d9a\u0dc0\u0daf -Activity Based-, 6 \u0db8\u0dbb\u0dda\u0dab\u0dd2\u0dba \u0dc3\u0db3\u0dc4\u0dd2 \u0db8\u0db8\u0dd2\u0da9\u0dd2\u0dba\u0dd4\u0d9a \u0db4\u0dd2\u0daf\u0d9a\u0dc0\u0daf -Module Based- \u0dc0\u0dd2\u0dc2\u0dca\u0da8\u0dba\u0db8\u0dd2\u0d9a\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dda\u0d9a\u0dbb\u0dab \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0dad\u0dca\u0db8\u0d9a \u0db8\u0dc0. \u0dd2\u0db1\u0dca\u0db4\u0dc3\u0dd4 \u0dd2\u0daf\u0dd2\u0db4\u0dad \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0dc0\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dd2\u0db1\u0dd4\u0dd6\u0dbd\u0d9a\u0dc0 \u0db8\u0dc3\u0dc3\u0dd4 \u0db8\u0dbb\u0dda\u0dab\u0dd2\u0dc0\u0d9a \u0dc0\u0dd2\u0dc2\u0dca\u0da8\u0dba\u0db8\u0dd2\u0d9a\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dda\u0d9a\u0dbb\u0dab \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0dad\u0dca\u0db8\u0d9a \u0db8\u0d9a\u0db8\u0dbb\u0db1\u0dd4 \u0dad\u0dad. \u0d8a \u0dc3\u0db8\u0db8\u0dd2\u0db8\u0dd3\u0dc0 \u0dc3\u0dc4\u0dd2\u0dba\u0d9a \u0d9a\u0dd2\u0dbb\u0dca\u0dba\u0dba\u0db1\u0dca \u0dd2\u0dc4\u0dad \u0daf\u0d9a\u0dca\u0dc0\u0dc0\u0dd2 \u0dad\u0dad\u0dd2 \u0db8\u0dc3\u0dc3\u0dd4 \u0dc0\u0dda\u0dbd\u0dd4\u0db1\u0dd4 \u0d94\u0dc3\u0dda\u0db8\u0dc3\u0dda \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0db1\u0dd4 \u0dad\u0dad. (iii) \u0dc0\u0dd2\u0dd4\u0dc4\u0dbd\u0dca\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc4\u0dd2 \u0d85\u0db0\u0dba\u0dd2\u0db4\u0db1 \u0db1\u0dd2\u0d9a\u0db0\u0dd2\u0db4\u0dad\u0db1\u0dca \u0db1\u0dd2\u0db1\u0dca \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc0\u0d9a\u0dca\u0dc0 \u0d9a\u0d82\u0dd2 \u0daf\u0dd3\u0db8 \u0db4\u0dc5\u0db8\u0dd4\u0dc0 \u0db1\u0dca\u0dd4 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dca\u0dba\u0dba\u0d9a\u0dca\u0dc0 \u0db8\u0d9a\u0dc3 \u0db4\u0dd2\u0dc5\u0dd2\u0db8\u0db1\u0dca\u0db1\u0dd2 \u0d85\u0dad\u0dbb \u0d92 \u0dc3\u0db3\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd4\u0d9b\u0dad\u0dd2\u0dc0 \u0d9a\u0d82\u0dd2 \u0db8\u0daf\u0db8\u0dd2\u0db1\u0dca \u0db8\u0dda \u0dc0\u0db1 \u0dc0\u0dd2 \u0daf \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0dad\u0dad. (iv) 2025 \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0db8\u0dd3 \u0daf\u0dd3 1\u0dc0\u0db1 \u0db8\u0dbb\u0dda\u0dab\u0dd2\u0db8\u0dd3 \u0dc3\u0dc4 6\u0dc0\u0db1 \u0db8\u0dbb\u0dda\u0dab\u0dd2\u0db8\u0dd3 \u0db4\u0dc5\u0db8\u0dd4 \u0dc0\u0dd2\u0dbb\u0dba \u0dc3\u0db3\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dd2\u0db1 \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0db8\u0d9a\u0dc3 \u0db8\u0dad\u0ddd\u0dbb\u0dd2 \u0db8\u0db1\u0dca\u0db1\u0dd2 \u0d9a\u0daf\n\n1807 1808\n\n\u0db4\u0dd2\u0dbb\u0dca\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n(\u0dca) (i) \u0db1\u0dc0 \u0d85\u0db0\u0dba\u0dd2\u0db4\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dda\u0d9a\u0dbb\u0dab \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0dc0\u0dd2\u0dba \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db8\u0db1\u0dca \u0d91\u0d9a\u0dca\u0dc0 \u0daf\u0dd2\u0dc3\u0dda\u0dd2\u0d9a\u0dca\u0dc0\u0d9a\u0dba\u0d9a\u0dca\u0dc0 \u0db8\u0dc4\u0ddd \u0daf\u0dd2\u0dc3\u0dda\u0dd2\u0d9a\u0dca\u0dc0\u0d9a \u0d9a\u0dd3\u0db4\u0dba\u0d9a\u0dca\u0dc0 \u0dca\u0dc0\u0dbb\u0dab\u0dba \u0dc0\u0db1 \u0db4\u0db4\u0dad\u0daf\u0dd2 \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0db1\u0dca\u0db1\u0d9a\u0dca\u0dc0 \u0db8\u0db1\u0dd2\u0db8\u0dc0. 2026 \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0dba \u0dca\u0dbb\u0dda\u0db7\u0db8\u0dd3\u0daf\u0dd3 \u0db4\u0dd2\u0dc3\u0dbd\u0dca\u0dc0\u0d9a 1\u0dc0\u0db1 \u0db8\u0dbb\u0dda\u0dab\u0dd2\u0dba \u0d85\u0daf\u0dd2\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dda\u0d9a\u0dbb\u0dab \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0dc0\u0dd2\u0dba \u0daf \u0db8\u0dda \u0dc0\u0db1 \u0dc0\u0dd2 \u0dca\u0dbb\u0dda\u0db7 \u0d9a\u0dbb \u0dad\u0dad\u0dca\u0db8\u0dad\u0dca \u0dc3\u0db8\u0dc3\u0dda\u0dad \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1 \u0dca\u0dc0\u0dbb\u0dab\u0dba \u0dc0\u0db1 \u0db4\u0db4\u0dad\u0daf\u0dd2 \u0dba. (ii) \u0db1\u0dc0 \u0d85\u0db0\u0dba\u0dd2\u0db4\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dda\u0d9a\u0dbb\u0dab \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0dc0\u0dd2\u0dba \u0dc3\u0db3\u0dc4\u0dd2 \u0dd2\u0dc4\u0dad (\u0dca) (i) \u0dc4\u0dd2 \u0daf \u0daf\u0d9a\u0dca\u0dc0\u0dc0\u0dd2 \u0dad\u0dad\u0dd2 \u0db4\u0db4\u0dad\u0daf\u0dd2 \u0d91\u0d9a\u0dca\u0dc0 \u0d91\u0d9a\u0dca\u0dc0 \u0daf\u0dd2\u0dc3\u0dda\u0dd2\u0d9a\u0dca\u0dc0\u0d9a\u0db8\u0dba\u0db1\u0dca \u0dba\u0dda \u0db4\u0dd2\u0dc3\u0dbd\u0dca \u0dc3\u0d82\u0d9b\u0dba\u0dd2\u0dc0\u0d9a\u0dca\u0dc0 \u0db8\u0dad\u0ddd\u0dbb\u0dd2 \u0db8\u0db8\u0db1 \u0db1\u0dd0\u0dad. \u0d85\u0daf\u0dd2\u0dc5 \u0db8\u0dbb\u0dda\u0dab\u0dd2 \u0dc3\u0dc4\u0dd2\u0dad \u0dbb\u0dba\u0db8\u0dd3 \u0db1\u0dca\u0dba\u0dbd\u0dd4 \u0db4\u0dd2\u0dc3\u0dbd\u0dca\u0dc0\u0d9a \u0d85\u0daf\u0dd2\u0dc5 \u0dc0\u0db1 \u0db4\u0db4\u0dad\u0daf\u0dd2 \u0d85\u0db0\u0dba\u0dd2\u0db4\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dda\u0d9a\u0dbb\u0dab \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0dad\u0dca\u0db8\u0d9a \u0db8\u0dc0. (iii) \u0dd2\u0dc4\u0dad (\u0dca) (i) \u0dc4\u0dd2 (ii) \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0daf\u0dd2\u0dc5 \u0db8\u0db1\u0dd2\u0db8\u0dc0.\n\n(\u0dad) \u0d85\u0daf\u0dd2\u0dc5 \u0db8\u0db1\u0dd2\u0db8\u0dc0.\n\n\u0d9c\u0dd4 \u0dc3\u0dd4\u0dc3\u0db1\u0dca\u0dad \u0d9a\u0dd4\u0db8\u0dcf\u0dad \u0db1\u0dc0\u0dad\u0dca \u0db1 \u0db8\u0dad\u0dad\u0dcf (\u0bc7\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc7\u0bbf\u0b95\u0bc1 \u0b9a\u0bc1\u0b9a\u0ba8\u0bcd\u0ba4 \u0b95\u0bc1\u0bc7\u0bc6\u0bbe\u0bb0 \u0ba8\u0bb5\u0bb0\u0ba4\u0bcd\u0ba9) (The Hon. Susantha Kumara Nawarathna) \u0db8\u0dbb\u0dd4 \u0d9a\u0dcf\u0dd2\u0db1\u0dd2\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db8\u0db8\u0dda \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0db1 \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1\u0dba \u0db8\u0db8\u0dba\u0dba\u0dd2."
