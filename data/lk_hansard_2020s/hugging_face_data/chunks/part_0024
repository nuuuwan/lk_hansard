    "chunk_text": "\u0db4\u0dcf\u0daf\u0dcf\u0dad\u0db7 \u0dd2\u0dab\u0dc3\u0db0\u0dd3\u0d9a \u0da7 \u0dc3\u0dca\u0dad\u0dca\u200d \u0db1\u0dc3\u0d9a\u0dca \u0dc4 \u0dbd\u0dca\u0dcf \u0daf\u0dd3\u0db8\u0dc3\u0da7 \u0dd0\u0d9a\u0dd2 \u0dc0\u0db1 \u0db4\u0daf\u0dcf\u0daf\u0dd2 \u0d9f\u0daf\u0dcf\u0dc5 \u0d9f\u0db8\u0dc3\u0dbb \u0db4\u0dd2\u0daf\u0dcf\u0dc0\u0dd0\u0dc3 \u0db8\u0dc3\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d \u0dad\u0dd4\u0db1\u0dab \u0dab\u0dcf\u0dbd\u0dc3\u0d9a\u0dca \u0dc4 \u0da2\u0dc3 \u0dd2\u0dd2\u0db1\u0db0\u0dd3\u0d9a \u0daf \u0db1\u0dc0\u0dcf. \u0d92 \u0d9a\u0dd2\u0dc3\u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a \u0dad\u0db8\u0dc3\u0dcf\u0dab\u0d9a\u0dca \u0dc4\u0daf? \u0d9f\u0db4\u0dd2 \u0dad\u0db6\u0db1 \u0d91\u0db1 \u0dd0\u0db8\u0dc3 \u0dca \u0d9a\u0dca \u0dc4\u0db8\u0dc3 \u0db8\u0dd2\u0dd2\u0dba\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dd4 \u0db8\u0dc3\u0dbb \u0db4\u0da7\u0dc0\u0db1\u0dc0\u0dcf \u0dad\u0db1\u0dcf\u0dad\u0dc0\u0dba\u0dd2. \u0d92\u0dad\u0dab\u0db0\u0dd3\u0d9a \u0dad\u0dab\u0dcf\u0da7\u0dc3\u0dca\u0dad\u0dca\u200d\u0d9a\u0dca \u0dc4 \u0da2\u0dc3 \u0db7\u0dcf \u0d9c\u0db0\u0dd3\u0d9a\u0db1\u0dc0\u0dcf. \u0d92\u0dab\u0da7 \u0dbb\u0db8\u0dc3\u0dba\u0dd2 \u0d92 \u0dbb\u0dd4\u0db4\u0dd2\u0dc3\u0dca \u0db6\u0dd2\u0dd2\u0dc3\u0db1 100 \u0dad\u0dc0\u0db0\u0dd3\u0d9a \u0dab \u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd4\u0dad\u0dda.\n\n\u0d9f\u0db4\u0dd2 \u0dad\u0db4\u0dcf\u0dad \u0dcf \u0dc3\u0dca\u0dad\u0dca\u200d \u0db1\u0dcf\u0db0\u0dcf \u0dc3 \u0dd2 \u0dc5 \u0db1\u0d82\u0dc0\u0dcf \u0dd2\u0dba\u0dad\u0dca\u0db1\u0dc0\u0dcf. \u0daf\u0dd0\u0db1\u0da7 \u0dad \u0d9a\u0dca \u0dc4\u0dad\u0da7\u0dc3\u0dcf \u0dc3\u0dab\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dc3\u0dca 25,000\u0d9a\u0dca \u0dc4 \u0dc0\u0dba\u0dad\u0dc3\u0db0\u0dd3\u0d9a \u0dbd\u0dca\u0dcf \u0dad\u0daf\u0db1 \u0dad\u0db4\u0dcf\u0dad \u0dcf \u0dc3\u0dca\u0dad\u0dca\u200d \u0db1\u0dcf\u0db0\u0dcf \u0dc3 \u0dc3\u0dbd \u0dab\u0db0\u0dd3\u0d9a\u0db1\u0dc3 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3 \u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dc3\u0dca 30,000 \u0daf\u0d9a\u0dca \u0dc4\u0dc0\u0dcf \u0dd2 \u0dc5 \u0db1\u0dd0\u0d82\u0dc0\u0dd3\u0db8\u0dc3 \u0dc3\u0dca\u0dad\u0dca\u200d \u0d89\u0db9\u0dd4\u0dbb\u0dd4\u0dc0\u0dbd \u0dc0\u0d9c\u0dcf \u0dab \u0db1\u0dd4 \u0dbd\u0dca\u0db1 \u0d9f\u0dd2\u0dba\u0dad\u0dbb\u0dca\u0dab \u0dad\u0db7 \u0d9c \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3 \u0dcf \u0daf\u0dd0\u0db1\u0da7 \u0dbd\u0dca\u0dcf \u0dad\u0daf\u0db1 \u0dad \u0d9a\u0dca \u0dc4\u0dad\u0da7\u0dc3\u0dcf \u0dc3\u0dab\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dc3\u0dca 15,000\u0d9a\u0dca \u0dc4 \u0dc0\u0db1 \u0dad\u0db4\u0dcf\u0dad \u0dcf \u0dc3\u0dca\u0dad\u0dca\u200d \u0db1\u0dcf\u0db0\u0dcf \u0dc3 \u0dc3\u0dbd \u0dab\u0db0\u0dd3\u0d9a\u0db1\u0dc3 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3 \u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dc3\u0dca 18,000 \u0daf\u0d9a\u0dca \u0dc4\u0dc0\u0dcf \u0dd2 \u0dc5 \u0db1\u0d82\u0dc0\u0dcf \u0dd2\u0dba\u0dad\u0dca\u0db1\u0dc0\u0dcf.\n\n\u0d92 \u0dc0\u0dcf\u0dad \u0db8\u0dc3 \u0d9f\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dd0\u0dc3\u0dd4\u0db8\u0dc3 \u200d\u0dd2\u0dba\u0dbd\u0dcf\u0db7\u0dd3 \u0dab\u0dca\u0da9\u0dbd\u0dcf\u0dc3\u0db6\u0db1 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3 \u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dc3\u0dca 7,500\u0dab \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0dc4 \u0d9f\u0db0\u0dd3\u0d9a\u0dbb \u0daf\u0dd2\u0dc5\u0dd2\u0db3\u0dd4 \u0dab\u0dcf\u0dca\u0da9\u0dbd\u0dad\u0dda \u0db4\u0dc0\u0dd4\u0dbd\u0d9a\u0dca \u0dc4 \u0dad\u0dc0\u0dbb \u0dbd\u0dca\u0dcf \u0dad\u0daf\u0db1\u0dc0\u0dcf. [\u0dca\u0dcf\u0db0\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dc3\u0d9a\u0dca \u0dc4] 2026 \u0d9f\u0dad\u0dda\u0dca \u0db8\u0dc3\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dc3 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3 \u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dc3\u0dca 5,000\u0dab \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0dc4 \u0dd4\u0dc0\u0dda\u0db4\u0dda \u0dab\u0dcf\u0dca\u0da9\u0dbd\u0dad\u0dda \u0db4\u0dc0\u0dd4\u0dbd\u0d9a\u0dca \u0dc4 \u0dad\u0dc0\u0dbb \u0dbd\u0dca\u0dcf \u0dad\u0daf\u0db1\u0dc0\u0dcf. \u0dbb\u0dd4\u0db4\u0dd2\u0dc3\u0dca 2,500\u0dab \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0dc4 \u0dc3\u0dca\u0dad\u0dca\u200d\u0d82\u0d9a\u0dca\u200d\u0dbb\u0dcf\u0db0\u0dd3\u0d9a\u0dd2\u0dba \u0db4\u0dc0\u0dd4\u0dbd\u0d9a\u0dca \u0dc4 \u0dad\u0dc0\u0dbb \u0dbd\u0dca\u0dcf \u0dad\u0daf\u0db1\u0dc0\u0dcf. \u0db8\u0dc3\u0db8\u0dc3 \u0dad\u0db6\u0db1 \u0d9a\u0dd2\u0dda\u0dad\u0dda \u0d9f\u0dad\u0dda\u0dca \u0db8\u0dc3\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dc3\u0da7 \u0dd2\u0dbb \u0d9a\u0dca \u0dc4 \u0dbd\u0dca\u0dcf \u0dad\u0daf\u0db1 \u0dc3\u0dca\u0dad\u0dca\u200d \u0db1. \u0dad\u0db8\u0dc3\u0dcf\u0dab\u0daf, \u0d9f\u0db4\u0dd2 \u0dd2\u0dbd\u0d9a\u0dca \u0dc4\u0dab\u0d9c\u0dbb\u0dc0 \u0dad\u0db6\u0db1 \u0d86\u0db0\u0dcf \u0dbd\u0dca\u0dcf \u0dad\u0daf\u0db1\u0dc0\u0dcf. \u0db8\u0dc3\u0db1\u0dd4\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dca\u0dad\u0dca\u200d\u0dad\u0dc3\u0d89\u0da7 \u0d8b\u0daf\u0dc0\u0dd4 \u0dab \u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dc3\u0db1\u0dad\u0dab\u0dcf\u0da7\u0dda \u0dab\u0dd1 \u0d9c \u0db1, \u0d87\u0db9\u0dad \u0db1 \u0dd2\u0db4\u0d9a\u0dca \u0dc4\u0dc2\u0dc3\u0d9a\u0dca \u0dc4 \u0db1\u0db6\u0db1 \u0dd2\u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a, \u0d91\u0dad \u0db8\u0dc3 \u0da7\u0dab\u0da7 \u0d86\u0dad\u0dda \u0dab\u0dc0 \u0dab\u0dae\u0dcf\u0daf?\n\n\u0dad\u0dab\u0dad\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0dad \u0dad\u0dda\u0dc0\u0dcf, \u0db8\u0dc3\u0dcf \u0dad\u0db6\u0db1 \u0dad\u0db4\u0db0\u0dd3\u0d9a\u0db1\u0dd4\u0db6\u0db1 \u0dab\u0dad\u0dc5\u0dbb \u0dad\u0d9c \u0dbd\u0dd3\u0dc3\u0dc0 \u0dd2\u0dba\u0dad\u0dca\u0db1 \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0dab\u0da7 \u0d9f\u0db4\u0dd2 \u0db8\u0dd4\u0dc4\u0dd4 \u0daf\u0dd3\u0dad\u0db6\u0db1\u0daf\u0dd3 \u0d87\u0dd2\u0dba \u0dc0\u0db1 \u0dbb\u0dda\u0dda\u0dc0\u0dc3 \u0db4\u0dd2\u0dc5\u0dd2\u0dca\u0db3\u0dc0\u0dba\u0dd2. \u0dad\u0db8\u0dc3\u0dcf\u0dab\u0daf, \u0daf\u0dd0\u0db0\u0dd3\u0d9a \u0dad\u0db6\u0db1 \u0dad\u0da7\u0dca \u0dad\u0dbb\u0dca \u0d9f\u0dbb\u0dca\u0db6\u0dd4\u0daf\u0dc3\u0d9a\u0dca \u0dc4 \u0db8\u0dc3\u0dad\u0dd4 \u0dad\u0dc0\u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a \u0d9f\u0db4\u0dd2 \u0db7\u0dcf\u0dca\u0da9\u0dbd\u0dcf\u0d9c\u0dcf \u0dc3 \u0dc3\u0dd4\u0dd3\u0daf \u0dab \u0dd4 \u0dd2\u0dba\u0dc3\u0dca\u0dad\u0dca\u200d\u0dcf \u0dad\u0db1\u0dcf\u0dad\u0dc0\u0dba\u0dd2, \u0db8\u0dc3\u0dd0\u0daf \u0dad\u0db4 \u0daf\u0dd2\u0d9c \u0db4\u0dc0\u0dd2\u0dba\u0db1 \u0dba\u0dd4\u0dd3\u0db0\u0dc3 \u0dd2\u0dba\u0dc3\u0dca\u0dad\u0dca\u200d\u0dcf\u0dba\u0dd2. 2022\u0daf\u0dd3 \u0dad\u0d9c \u0dbd\u0dcf\u0db7\u0dc3\u0dad \u0dab\u0dcf\u0dbd\u0dad\u0dda \u0dad\u0db4 \u0dd2\u0db6\u0db1 \u0d86\u0dc0\u0dcf. \u0dad\u0db8\u0dc3\u0dcf\u0dab\u0daf, \u0db7\u0dcf\u0dca\u0da9\u0dbd\u0dcf\u0d9c\u0dcf \u0dc3 \u0dc3\u0dd4\u0dd3\u0daf\u0dba\u0dd2, \u0db1\u0dd0\u0dda \u0d86\u0dc0\u0dcf\u0da7 \u0dad\u0d9c\u0dc0\u0db0\u0dd3\u0d9a\u0db1 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dca \u0dd2 \u0dd2\u0dba\u0db6\u0dd4\u0dad\u0dca \u0db1\u0dd0 \u0dd0. \u0daf\u0dd0\u0db0\u0dd3\u0d9a \u0dad\u0d9c\u0dc0\u0db0\u0dd3\u0d9a\u0db1 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dca \u0dd2 \u0dd2\u0dba\u0dad\u0dca\u0db1\u0dc0\u0dcf. \u0db1\u0db8\u0dd4\u0dda, \u0db1\u0dd0\u0dda \u0d91\u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a \u0db1\u0dd0 \u0dd0; \u0db1\u0dd0\u0dda \u0d86\u0dc0\u0dda \u0db8\u0dd2\u0dbd \u0dc0\u0dd0\u0da9\u0dd2\u0dba\u0dd2. \u0d92 \u0dd2\u0dba\u0dc3\u0dca\u0dad\u0dca\u200d\u0dcf \u0d9f\u0db4\u0dd2\u0dda \u0dab\u0db6\u0db1\u0db4\u0db1\u0dc3\u0dab\u0da7 \u0db4\u0dda \u0dad\u0dc0\u0db1\u0dc0\u0dcf. \u0dad\u0db8\u0dc3\u0dcf\u0dab\u0daf, \u0d9c\u0dd1\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb \u0db8\u0dd2\u0dbd \u0da7\u0dd2\u0dab\u0d9a\u0dca \u0dc4 \u0dc0\u0dd0\u0da9\u0dd2 \u0dca\u0dc0 \u0d9f\u0db4\u0dd2 \u0daf\u0db0\u0dd3\u0d9a\u0db1\u0dc0\u0dcf. \u0dad\u0db4\u0da7\u0dca\u200d\u0dbb\u0dca \u0db8\u0dd2\u0dbd \u0dc0\u0dd0\u0da9\u0dd2\u0dba\u0dd2. \u0db1\u0db8\u0dd4\u0dda, \u0d92\u0dad\u0dab\u0db0\u0dd3\u0d9a \u0dad\u0dab\u0dcf\u0da7\u0dc3\u0dca\u0dad\u0dca\u200d\u0d9a\u0dca \u0dc4 \u0da2\u0dc3 \u0daf \u0dcf \u0dad\u0d9c\u0db1 \u0dbb\u0db8\u0dc3\u0dba\u0dd2 \u0dad\u0db6\u0db1 \u0dc0\u0dd0\u0dad\u0da9 \u0dab \u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a. \u0dad\u0db8\u0dc3\u0dcf\u0dab\u0daf, \u0d9f\u0db4\u0dd2 \u0da2\u0db1\u0dbb\u0dcf\u0dc0 \u0dad\u0dc0\u0db1\u0dd4\u0dad\u0dc0\u0db0\u0dd3\u0d9a \u0dad\u0db4\u0db1\u0dd3 \u0dd2\u0db1\u0da7\u0dd2\u0db1 \u0d9f\u0dc3."
