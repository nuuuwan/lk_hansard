    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7 \u0db8\u0da2\u0db1\u0daf\u0d9a\u0dbb\u0dba\u0dd2\u0dad\u0dd4\u0db8 \u0daf\u0db8\u0db1\u0dd4\u0dcf\u0dba\u0d91\u0dc5\u0dd2\u0dda \u0dd3\u0db1\u0db8\u0dda\u0dc4\u0ddd\u0db8\u0dda\u0dcf\u0db1\u0db8\u0dda\u0dd9\u0daf\u0dda\u0dc4\u0dad\u0db8\u0dc4\u0db4\u0dad\u0db8\u0dda\u0dc4\u0ddd\u0db8\u0dba\u0db4\u0dcf\u0db4\u0dd2\u0db8\u0dd0\u0daf\u0dc3\u0dca\u0dad\u0dc0\u0dd3\u0db8 \u0dd9\u0dd3\u0db1\u0db8\u0d9a\u0dd2\u0dc1\u0dcf\u0daf \u0db8\u0db8\u0d85\u0dba\u0da7 \u0db8\u0dcf\u0daf\u0dc4\u0db1\u0db8\u0dda\u0d9c\u0dca\u0dcf\u0db1\u0db8\u0d91\u0dd9\u0db8\u0db1\u0dc0\u0dba\u0db8\u0dd9\u0dba\u0dca\u0db1\u0db8\u0dda\u0dcf\u0db1\u0dcf\u0daf\u0db8\u0db8\u0d9a\u0dd2\u0dba\u0dca\u200d\u0daf.\u0db8\u0d9c\u0dbb\u0dd4\u0db8\u0dd2\u0dba\u0dda\u0dba\u0ddd\u0da2\u0dba\u0db8\u0dd9\u0daf\u0dba\u0dd9\u0db8\u0dc3\u0dca\u0db7\u0daf\u0db8\u0dc3\u0dca\u0db7\u0daf\u0dba\u0dd2\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba\u0dd2\u0dba \u0db8\u0dc3\u0dca\u0daf \u0daf\u0db1\u0dba\u0dda\u0dba\u0dca\u0db8\u0dd9\u0db4\u0db6\u0dd2\u0db1\u0da7\u0dca\u0db8\u0d91\u0dda\u0d9a\u0dca\u0dc0\u0db8\u0dda\u0dcf\u0db1\u0db8\u0db4\u0dca\u200d\u0dbb\u0dd9\u0daf \u0dba\u0d9a\u0dca\u0dc0\u0db8\u0d91\u0dda\u0dc4 \u0db8\u0d9a\u0dd2\u0dba\u0dca\u0db1\u0db8\u0dda\u0dc4\u0daf\u0dc4\u0db8\u0db1\u0db4\u0dc4\u0db4.\u0db8\u0dbb\u0dca\u200d\u0dca\u0db1 \u0db8\u0d8a\u0da7 \u0db8\u0dba\u0dc3\u0dd4\u0dcf\u0db8\u0dda\u0dcf\u0dca\u200d\u0daf\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0db8\u0dda\u0daf\u0dca\u0db0.\u0db8\u0dda \u0db8\u0dcf\u0daf\u0dc4\u0db1\u0dcf\u0dca\u200d\u0da7 \u0db8tax \u0d91\u0dd9\u0d9a\u0dca\u0dc0\u0db8\u0d9c\u0db4\u0dc4\u0dd4\u0dcf\u0daf.\u0db8\u0dc4\u0db4\u0dbb\u0db4\u0dd2\u0db6 \u0db8\u0d92\u0db8\u0dcf\u0daf\u0dc4\u0db1\u0dcf\u0dca\u200d\u0da7 \u0db8\u0d9c\u0dc4\u0db4\u0dd4\u0db8tax \u0d91\u0dda\u0d9a\u0dca\u0dc0\u0db8\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbd\u0dca\u200d\u0dba\u0db8\u0d85\u0dba\u0da7 \u0db8\u0d9c\u0dca\u0db1\u0db8\u0db4\u0dd4\u0dc5\u0dd4\u0dcf\u0dca\u0dbd?\u0db8\u0dbb\u0db4\u0dc4\u0db4.\u0db8\u0dda \u0daf\u0dd9\u0dbd\u0db8\u0dda\u0dc4\u0dad\u0dad\u0dd4\u0db8\u0dcf?\u0db8\u0da2\u0db1\u0daf\u0d9a\u0dbb\u0dba\u0dd2\u0dad\u0dd4\u0db8 \u0daf\u0db81]\u0dcf\u0db4\u0dd2\u0dba\u0db8\u0dbd\u0daf\u0db8\u0d92\u0dd9\u0db8\u0d9a\u0dd2\u0dc1\u0dcf\u0daf.\u0db815\u0dcf\u0db4\u0dd2\u0dba\u0db8\u0dbd\u0daf\u0db8\u0dc0 \u0dd2\u0db6\u0db8\n\n\u0d8a\u0dc5\u0d9f\u0db8\u0d91\u0dd9.\u0db8\u0d85\u0dda\u0db4\u0dca\u0db8\u0da2\u0db1\u0daf\u0d9a\u0dbb\u0dba\u0dd2\u0dad\u0dd4\u0db8 \u0daf\u0db8\u0dba\u0dda\u0da7\u0dca\u0db8\u0da2\u0db1\u0daf\u0d9a\u0dbb\u0dba\u0dd2.\u0db8\u0d91\u0dad\u0dd4\u0db8 \u0daf\u0db8\u0dd4\u0daf\u0dbd\u0dca\u200d\u0daf\u0dd2\u0db1\u0db8\u0dda\u0dd9\u0dda\u0db1\u0d9a\u0dca\u0dc0\u0db8\u0dda\u0db1\u0daf\u0dda\u0dcf\u0dd2\u0db6 \u0db8\u0dda\u0dd9\u0daf \u0dba\u0db4\u0dd2\u0dba\u0dba\u0dd9\u0db8\u0dda\u0dd9\u0dda\u0db1\u0d9a\u0dca\u0dc0\u0db8\u0dda\u0db1\u0daf\u0dda\u0dcf\u0dd2\u0db6.\u0db8\u0d91\u0dad\u0dd4\u0db8 \u0daf\u0db8\u0d91\u0dd9\u0db8\u0dc0\u0db4\u0db1\u0dd9\u0da7 \u0db8\u0dd2\u0dc4\u0dd2\u0dca \u0dca\u200d\u0daf\u0db8\u0d9a\u0dd2\u0dba\u0db1\u0dcf\u0daf \u0db8\u0db8\u0d85\u0dba\u0da7 \u0db8\u0dda\u0dc0\u0dca \u0db8\u0db8\u0dd2\u0dca\u200d\u0db8\u0dcf\u0db4\u0da9\u0dd2\u0db8\u0dd9\u0dba\u0dca\u0db1\u0db8\u0dda\u0dcf\u0db1\u0dcf\u0daf\u0db8\u0db8\u0d9a\u0dd2\u0dba\u0dca\u200d\u0daf.\u0db8\u0dda\u0dc0\u0dca \u0db8\u0db8\u0dd2\u0dca\u200d\u0db8\u0dcf\u0db4\u0da9\u0dd2\u0db8\u0dd9\u0dba\u0dca\u0db1\u0db8\u0db1 \u0db8\u0d85\u0dba\u0da7 \u0db8\u0da2\u0db1\u0daf\u0d9a\u0dbb\u0dba\u0dd2\u0db8\u0dda\u0dd9\u0dda\u0db1\u0d9a\u0dca\u0dc0\u0db8\u0d95\u0db1\u0dd1\u0db8\u0db1\u0db4\u0dc4\u0db4.\u0db8\u0dda\u0dc0\u0dca \u0db8\u0db8\u0dd2\u0dca\u200d\u0db8\u0d85\u0dd4\u0db8\u0dd9\u0dba\u0dca\u0db1\u0dca\u0db8\u0d85\u0dba\u0da7 \u0db8\u0da2\u0db1\u0daf\u0d9a\u0dbb\u0dba\u0dd2\u0db8\u0dda\u0dd9\u0dda\u0db1\u0d9a\u0dca\u0dc0\u0db8\u0d95\u0db1\u0dd1\u0db8\u0db1\u0db4\u0dc4\u0db4.\u0db8\u0d92\u0db8\u0dbd\u0dcf\u0dc3\u0dca\u0dad\u0dcf\u0dca\u200d\u0db8\u0d9a\u0dd2\u0dc1\u0dda\u0dc1\u0dca\u0db8\u0d91\u0dda\u0dc4 \u0dd2\u0db6.\u0db8\u0dda \u0db8\u0d9b\u0dca\u200d\u0dd2\u0dba\u0da2\u0db8\u0dda\u0dc0\u0dca \u0db8\u0dd3\u0db8\u0dd2\u0d9c\u0dc0\u0db8\u0dc3\u0dca\u0d82\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0dda\u0dc1\u0db8\u0dc3\u0dca\u0db7\u0daf\u0dba\u0dd2\u0db8\u0dda\u0db1\u0daf\u0dda\u0dcf\u0dd2\u0db6.\u0db8\u0d85\u0db1\u0dd4\u0dba\u0db8\u0d9a\u0dd4 \u0daf\u0dba\u0db8\u0da2\u0db1\u0daf\u0d9a\u0dbb\u0dba\u0dd2\u0dad\u0dd4\u0db8 \u0daf\u0db8\u0dc1\u0dca\u200d\u0dbb\u0dd3\u0db8\u0dca\u200d\u0d82\u0dd9\u0daf\u0db8\u0da2\u0db1\u0dba\u0da2\u0dda \u0db8\u0da2\u0db1\u0daf\u0d9a\u0dbb\u0dba\u0dd2.\u0db8\u0da2\u0db1\u0dba\u0da2\u0dda \u0db8\u0da2\u0db1\u0daf\u0d9a\u0dbb\u0dba\u0dd2\u0db8\u0dda\u0dc0\u0dca \u0db8\u0db8\u0dd2\u0dca\u200d\u0db8\u0dcf\u0db4\u0da9\u0dd2\u0db8\u0dd9\u0dba\u0db1\u0db8\u0d91\u0dd9\u0db8\u0d9c\u0db4\u0db1\u0db8\u0d91\u0dd9\u0db8\u0d91\u0dd9\u0db8\u0dda\u0dc1\u0dbb\u0dd2\u0dd9\u0daf\u0dcf\u0dca\u200d\u0db8\u0d9a\u0dd2\u0dba\u0db1\u0dcf\u0daf.\u0db8\u0dda \u0dcf\u0daf\u0db8\u0dba\u0dda\u0da7\u0dca\u0db8\u0da2\u0db1\u0daf\u0d9a\u0dbb\u0dba\u0dd2\u0db8\u0dda\u0dd9\u0dda\u0db1\u0d9a\u0dca\u0dc0\u0db8\u0dc4\u0db4\u0da7\u0dd2\u0dba\u0da7 \u0db8\u0d9a\u0dd2\u0dcf\u0db8\u0dd4\u0dad\u0dad\u0dd4\u0db8\u0db8\u0dda\u0daf\u0dca\u0db0\u0dcf\u0dca \u0db8\u0dda\u0db1\u0daf\u0dda\u0dcf\u0dd2\u0db6.\u0db8\u0dda \u0dcf\u0daf\u0db8\u0d9a\u0dd2\u0dba\u0dca\u0db1\u0db8\u0dda\u0dc4\u0daf\u0dc4\u0db8\u0db1\u0db4\u0dc4\u0db4.\u0db8\u0d85\u0db4\u0dd2\u0db8\u0d92\u0db8\u0dda\u0daf\u0dca\u0db0\u0dcf\u0dca \u0db8\u0dda\u0dc4\u0daf\u0dd2 \u0dca\u0db8 \u0dc0\u0dd9\u0db8\u0dc0\u0dbb\u0daf\u0db8\u0d9c\u0dca\u0db1\u0db8\u0d95\u0db1\u0dd1."
