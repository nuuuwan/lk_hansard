    "chunk_text": "\u0d94\u0dbb\u0dad\u0dd4\u0db8 \u0daf\u0dda \u0db8\u0d8b\u0dca\u0dc0\u0dba\u0dda \u0db8\u0dd2\u0db6\u0dd4\u0dda\u0daf \u0db8\u0dc3\u0dd2\u0dc0\u0dd2\u0dca \u0db8\u0d86\u0dba\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0dd9\u0db8\u0dda\u0dbd\u0dba\u0daf\u0dbb\u0dca\u0dc0\u0dda \u0dca\u0dad\u0dd4\u0db8\u0dda\u0dc1\u0db8\u0dd9\u0da7 \u0dd4\u0dad\u0dad\u0dd4\u0db8\u0db8\u0dd9\u0dc5\u0db8\u0dd2\u0dba\u0dca\u200d\u0db0\u0daf\u0db4\u0dad\u0dca\u0db85 000\u0d9a\u0dca\u0dc0\u0db8\u0dda \u0db8\u0dcf\u0db1\u0db8\u0dc0\u0dd2\u0da7 \u0db8\u0d94\u0dbb\u0dad\u0dd4\u0db8 \u0dca\u0dca\u200d\u0daf\u0dda \u0db8\u0dda\u0dbd\u0dba\u0daf\u0dbb\u0dca\u0dc0\u0dda \u0dca\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0db8\u0d85\u0db1\u0dd4\u0dd4\u0dad\u0d9a\u0dca\u0dc0\u0dc0\u0db8\u0dd9\u0dba\u0dda\u0d9c\u0db1\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf\u0db8\u0d9a\u0dd2\u0dba\u0dca\u200d\u0daf.\u0db8\u0dd9\u0dd2\u0db1\u0dca\u0db8\u0dba\u0daf\u0da2\u0dd9\u0daf\u0db4\u0dad\u0db8\u0dd9\u0dc5\u0db8\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0db1\u0dcf\u0dd2\u0db1\u0dca\u0db8\u0dbb\u0db4\u0dc4\u0db4\u0dba\u0dcf\u0db8\u0dc0\u0dd2 \u0daf\u0dca\u200d\u0db8\u0daf\u0dd4\u0dba\u0dd9\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0db8\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0db1\u0dcf\u0dca\u200d\u0db8\u0dc0 \u0dd2\u0db6\u0db8\u0d92\u0db8\u0d85\u0dba\u0da7 \u0db8\u0dbd\u0db4\u0dca\u0db8\u0dba\u0daf\u0da2\u0dd9\u0daf\u0db4\u0dad\u0db8\u0dd9\u0dba\u0dca\u0db1\u0db8\u0dda\u0dcf\u0dca\u200d\u0daf\u0db8\u0dd2\u0dda\u0dbb\u0dca\u0dda\u0dca.\u0db8\u0d94\u0dc0\u0dd4\u0dca\u0da7 \u0db8\u0dcf\u0db4\u0da7\u0dd4\u0dba\u0da7 \u0db8\u0d85 \u0dc0\u0dba\u0dcf\u0db8\u0dbd\u0db4\u0dca\u0db8\u0dcf\u0db1\u0da2\u0dd3\u0dc0\u0dd3\u0db8\u0db8\u0dc3\u0dca\u0d82\u0dba\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0dda\u0db8\u0dda\u0dbd\u0dba\u0daf\u0dbb\u0dca\u0dc0\u0dda \u0dca\u0dad\u0dd4\u0db8\u0dda\u0dcf\u0dca\u0db8\u0daf\u0dbd\u0dd2\u0dba\u0dd9\u0dcf\u0db8\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8250\u0dd9\u0db8\u0dc0\u0dd2\u0dc0\u0dba\u0db8\u0dd3\u0db1 \u0db1\u0daf\u0dcf\u0d9a\u0dca\u0dc0\u0db8\u0dca\u200d\u0dbb\u0daf\u0db8\u0dda\u0dbd\u0db1\u0db8\u0dbb\u0dcf\u0db8\u0d9a\u0dd2\u0dba\u0db1\u0dcf\u0daf.\u0db8\u0d85\u0dbd\u0db8\u0d92\u0db8\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8250\u0dca\u0db8\u0dda\u0dba\u0da7\u0dca\u200d\u0dbb\u0dca \u0db8\u0dbd\u0dd3\u0da7 \u0dba\u0dba\u0d9a\u0dca\u0dc0\u0dcf\u0dca\u0db8\u0d9c\u0dc4\u0d9c\u0dca\u0db1\u0db8\u0dbb\u0db4\u0db4\u0dad\u0db8\u0dda\u0dcf\u0dca\u200d\u0daf\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf.\u0db8\u0dc0 \u0dca\u0db8\u0dba\u0dbb\u0dd2\u0d82\u0da0\u0dd2\u0db8\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0db1\u0dda \u0db8\u0dd2\u0dc4\u0dca\u200d\u0daf\u0db8\u0d85\u0dd2\u0db1\u0db8\u0dcf\u0db4\u0da7 \u0db8\u0d86\u0dba\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0daf\u0db8\u0dd9\u0dba\u0dca\u0db1\u0db8\u0dba\u0db1\u0dcf\u0daf\u0db8\u0db1 \u0db8\u0d92\u0db8\u0dba\u0daf\u0da2\u0dd9\u0daf\u0db4\u0dad\u0db8\u0dd9\u0dba\u0db1\u0db8\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0db1\u0dba\u0da7 \u0db8\u0dc0\u0dcf\u0db8\u0dc0\u0dd2 \u0daf\u0dca\u200d\u0db8\u0daf\u0dd4\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dba\u0dca\u0db1\u0db8\u0d94\u0dc0\u0dd4\u0dca\u0da7 \u0db8\u0dc3\u0dd2\u0daf\u0dd4\u0db8\u0dcf\u0db1\u0dcf\u0daf.\u0db8\u0d91\u0dc4\u0dd2\u0dd3\u0db1\u0db8\u0da2\u0dd3\u0dc0\u0dd2\u0dc0\u0db8\u0d86\u0dba\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0daf\u0dcf\u0db8\u0db4\u0dd2\u0dc5\u0dd2\u0dbb\u0dc4\u0db8\u0d9c\u0db4\u0da7 \u0dbd\u0dd4\u0dcf\u0d9a\u0dd4\u0dca\u0db8\u0d92\u0db8\u0d85\u0dba\u0da7 \u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf.\u0db8\u0dda \u0daf\u0dd9\u0dbd \u0db8\u0d92\u0db8\u0d85\u0dba\u0db8\u0d9c \u0dca\u0db8\u0dd9\u0dba\u0dca\u0dda\u0dca\u0db8\u0d85\u0dd2\u0db1\u0db8\u0d9c\u0db4\u0dcf\u0dda\u0dc3\u0dca\u0db1\u0db8\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0db1\u0db8\u0dc4\u0dba\u0dc4\u0daf.\u0db8\u0d91 \u0db8\u0dd2\u0dba\u0dc3\u0dca\u0daf\u0db8\u0d94\u0dc0\u0dd4\u0dca\u0da7 \u0db8\u0dca\u200d\u0dbb\u0daf\u0db8\u0dda\u0dbd\u0db1\u0db8\u0dda \u0db8\u0dd3\u0db1 \u0db1\u0daf\u0dcf\u0db8\u0db4\u0dca\u200d\u0dbb \u0daf\u0dda\u0dcf\u0dca\u0db8\u0db1\u0db4\u0dc4\u0db4\u0db8\u0d9a\u0dd2\u0dba\u0db1\u0db8\u0dd9\u0daf\u0dba\u0dda\u0dba\u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0dca\u0db8\u0dd9\u0dba\u0db1\u0dcf\u0daf\u0db8\u0dcf\u0daf\u0dda \u0db8\u0d94\u0dc0\u0dd4\u0dca\u0da7 \u0db8\u0d85\u0dcf \u0dba\u0db8\u0d85\u0dda\u0db1\u0d9a\u0dd4\u0dca\u0db8\u0dba\u0dc4\u0dc3\u0dd4\u0dd9 \u0db8\u0dca\u200d\u0dbb\u0daf\u0db8\u0dda\u0dbd\u0db1\u0db8\u0dcf\u0db4\u0db4\u0db8\u0db4\u0dd2\u0dc5\u0dd2\u0dda\u0dcf\u0dc5\u0d9a\u0dd4\u0dca\u0db8\u0dc3\u0dca\u0dd9\u0dc3\u0dca\u0dad\u0db8\u0dd9\u0dba\u0dca\u0db1\u0db8\u0d94\u0dbb\u0dad\u0dd4\u0db8 \u0daf\u0db8\u0dd6 \u0dbd\u0daf\u0db1 \u0dbd\u0db8\u0d9a\u0dd2\u0dba\u0db1\u0db8\u0d91\u0dd9\u0dca\u0db8 \u0db8\u0dbd\u0db4\u0db1\u0d9c\u0dca\u0db1\u0db8\u0dd9\u0db4 \u0db4\u0dd2\u0dd2\u0db6.\n\n\u0d85\u0db4\u0dd2\u0db8\u0dda\u0dc3\u0dca\u0dad\u0dcf\u0dd9\u0db8\u0db4\u0dca\u200d\u0dbb \u0dad\u0db1\u0db8\u0dc3\u0dca \u0dbb\u0dca\u0db0\u0dcf\u0db8\u0daf\u0dbd\u0dd2\u0dba\u0dd9\u0dcf\u0db8 \u0db4\u0dbb\u0dd2\u0dc4\u0dca\u0db8\u0dda\u0dcf\u0db8\u0dd2\u0dca\u0db8\u0dd2\u0dca\u0db1\u0dcf\u0daf.\u0db8\u0d94\u0dba\u0db8\u0d9a\u0dd2\u0dba\u0db1\u0db8\u0d85\u0dd4\u0dba\u0daf\u0dd4\u0db8\u0da7\u0dd2\u0dd9\u0db8\u0d9c\u0db4\u0db1\u0db8\u0d85\u0db4\u0dd2\u0db8\u0dda \u0db8\u0dcf\u0db1\u0dc0\u0dd2\u0da7 \u0dca\u0db8\u0d92\u0db8\u0d9a\u0dca\u0dc0\u0dda\u0dc2\u0dca\u0da8\u0dad\u0dad\u0dca\u200d\u0dbb\u0dda \u0db8\u0dda\u0dc3\u0dca\u0dad\u0dcf\u0dd9\u0dba\u0dca\u0db8\u0dc3\u0dca \u0d9f\u0db8\u0dc3\u0dca\u0daf\u0dd9\u0da0\u0dca\u0da1\u0daf\u0db8\u0dd9\u0dba\u0db8\u0dd2\u0dca\u0db8\u0dd2\u0dca\u0db1\u0dcf\u0daf.\u0db8\u0d85\u0db4\u0dd2\u0db8\u0d92\u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0dd2\u0d9a\u0dca\u0dc0 \u0dca\u0db8\u0dc0\u0dd2\u0dc3\u0dca\u0db3\u0dd4 \u0d9a\u0dca\u0dc0\u0db8\u0dca\u200d\u0dbb\u0daf\u0db8\u0dd3\u0db1 \u0da7 \u0db8\u0dbb\u0dca\u200d\u0daf\u0dda\u0dba\u0daf\u0dda\u0dba\u0daf\u0dca\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0db1\u0dcf\u0daf.\n\n\u0d9c\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd4\u0dbb\u0db8\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0b9a\u0baa\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Speaker) \u0db4\u0dca\u200d\u0dbb \u0dad\u0db1\u0db8\u0d85\u0d82\u0dd9\u0db84\u0db8-1886/2026-\u0db8(1) \u0db8\u0d9c\u0dbb\u0dd4\u0db8\u0d85\u0dd6 \u0dbb\u0dd9\u0dbb\u0dca\u0db8\u0d85\u0dc0 \u0dbb\u0daf\u0dcf\u0daf\u0db8 \u0dc4\u0dc0\u0daf\u0db8-\u0db8[\u0dc3\u0dca\u0db7\u0daf\u0db8\u0d9c\u0dbb\u0dca\u0db7\u0dba\u0db8\u0dad\u0dd4\u0db8\u0dc5\u0db8\u0db1\u0db4\u0dc0.]\n\n\u0dc0\u0dd2\u0dc0\u0dc1\u0dca\u0db1\u0dc2\u0dca\u0da8 \u0d85\u0db0\u0dcf\u0dba\u0dcf\u0db4\u0db1 \u0d85\u0dc0\u0dc1\u0dca\u0dba\u0dad\u0dcf \u0dc3\u0dc4\u0dd2\u0dad \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca:\n\n\u0db6\u0dc3\u0db1\u0db1\u0dcf\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dad \u0bb5\u0bbf\u0baa\u0b9a\u0b9f \u0b95\u0bb2\u0bcd\u0bb5\u0bbf\u0ba4\u0bcd \u0baa\u0ba4\u0b95\u0bb5\u0b95\u0b95\u0bb3\u0b95\u0bcd \u0b95\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0baa\u0bbe\u0b9f\u0b9a\u0bbe\u0b95\u0bb2\n\n\u0bae\u0bbe\u0ba3\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd: \u0baa\u0bae\u0bb2\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0bae\u0bcd SCHOOL CHILDREN WITH SPECIAL EDUCATIONAL NEEDS:\n\nWESTERN PROVINCE\n\n1925/2026 5. \u0d9c\u0dbb\u0dd4 \u0dc0\u0daf\u0dca\u0dc0\u0dcf\u0db1\u0db1\u0dca\u0daf \u0dc3\u0dd4\u0dbb\u0dc0\u0dd3\u0dbb \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0baa\u0ba4\u0bb5\u0bbe\u0ba9\u0ba8\u0bcd\u0ba4 \u0b9a\u0bc1\u0bb0\u0bb5\u0bc0\u0bb0) (The Hon. Dewananda Suraweera)\n\n\u0d85\u0d9c\u0dca\u200d\u0dbb\u0daf \u0db8\u0daf\u0dc0\u0dba\u0db8\u0dc3\u0dca\u0dc4\u0db8\u0d85\u0db0\u0dba\u0daf\u0dba\u0db1 \u0db8\u0d8b\u0dc3\u0dca\u0dc3\u0dca\u0dad\u0db8\u0d85\u0db0\u0dba\u0daf\u0dba\u0db1\u0db8\u0dc3\u0dca\u0dc4\u0db8\u0dcf\u0dca\u0dca\u0dad\u0dd3\u0dba\u0db8\u0d85\u0db0\u0dba\u0daf\u0dba\u0db1\u0db8\u0d85 \u0daf\u0dc0\u0dba\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba\u0dda\u0d9c\u0dca\u0db8\u0d87\u0dd6 \u0db8\u0db4\u0dca\u200d\u0dbb \u0dad\u0db1\u0dba\u0db8-\u0db8(1)\u0db8:\n\n(\u0d85) (i) \u0dbb\u0dc3\u0dca\u0dad\u0db1\u0daf\u0dc4\u0dd2\u0dba\u0db8\u0dba\u0dc5\u0daf\u0dc0\u0db8\u0dad\u0dd4\u0db8\u0dc5\u0db8\u0d87\u0dd2\u0db8\u0dba\u0da2\u0dda \u0db8\u0dba\u0daf\u0dc3\u0dca\u0dca \u0dcf\u0dca\u200d\u0db8\u0dcf\u0dba\u0dc3\u0dca\u0db8\u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4\u0db85-16\u0db8\u0d85\u0dc0\u0dba\u0db8\u0dbd\u0dbb\u0dd4\u0dcf\u0dca\u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0d85\u0dd2\u0dba\u0dcf\u0daf\u0dbb\u0dca\u0dba\u0db8\u0d85\u0db0\u0dba\u0daf\u0dba\u0db1\u0db8\u0dd2\u0dba\u0dda\u0dba\u0ddd\u0d9c\u0db8\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dca \u0dd9\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0da7 \u0db8\u0dba\u0daf\u0dc3\u0dca\u0dca \u0db8\u0dd9\u0db8\u0dd2\u0da7\u0dd4\u0db8\u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dcf\u0daf\u0db8\u0dd2\u0dda\u0dda\u0dbd;\n\n(ii) \u0dd9\u0da9\u0dd2\u0dca\u0dd9\u0db4 \u0db8\u0dd3\u0db1\u0dbb\u0dca\u0d9d\u0db8\u0dd9\u0daf\u0dbd\u0dd3\u0db1\u0dcf\u0db8\u0dc3\u0dca\u0dc4\u0db8\u0dc3\u0dca \u0dd6\u0dbb\u0dca\u0dda\u0dda\u0dba\u0dca\u0db8\u0dba\u0daf\u0dc3\u0dca\u0dca \u0db8\u0dda\u0db1\u0daf\u0dba\u0db1\u0db8\u0dbd\u0dbb\u0dd4\u0dcf\u0dca\u0db8\u0dc4\u0db3\u0dd4\u0db1\u0daf\u0dda\u0d9c\u0db1\u0db8\u0dd2\u0dda\u0dda\u0dbd;\n\n(iii) \u0d91\u0dda\u0dc3\u0dca\u0dad\u0db8\u0db1 \u0db8\u0d91 \u0db8\u0dbd\u0dbb\u0dd4\u0dcf\u0dca\u0db8\u0dc3\u0dca\u0d82\u0d9b\u0dca\u200d\u0dba\u0daf\u0dcf\u0db8\u0dda\u0dcf\u0dca\u0db8\u0dda\u0dcf\u0dca\u0db8\u0dcf \u0dda\u0dba\u0dca\u0db8\u0dda\u0dd9\u0daf\u0dba \u0dda\u0dbd;\n\n\u0dba\u0dca\u0db1\u0db8\u0d91\u0dad\u0dd4\u0db8\u0db8\u0dd2\u0dba\u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0dca\u0db8\u0dd9\u0dba\u0dca\u0dda\u0dca\u0dbd?\n\n(\u0d86) (i) \u0dbb\u0dc3\u0dca\u0dad\u0db1\u0daf\u0dc4\u0dd2\u0dba\u0db8\u0dba\u0dc5\u0daf\u0dc0\u0db8\u0dad\u0dd4\u0db8\u0dc5\u0db8\u0d87\u0dd2\u0db8\u0dba\u0da2\u0dda \u0db8\u0dba\u0daf\u0dc3\u0dca\u0dca \u0dcf\u0dca\u200d\u0db8"
  },
