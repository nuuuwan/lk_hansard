0d\u0dbb\u0dd3 \u0dbd\u0d9c\u0d9a\u0dcf \u0dc0\u0dd2\u0dc0\u0daf\u0dca\u0d9b \u0dc0\u0dca\u0db4\u0dc0\u0dcf \u0db1\u0dd2\u0dba\u0dd4\u0dca\u0dd2\u0db1 \u0d9a\u0dcf\u0dca\u0dba\u0dcf\u0d9c\u0d9b\u0dba \u0dc4\u0dc3\u0dcf \u0dad\u0dcf\u0db1\u0dcf\u0db4\u0dd2\u0db1 \u0d9a\u0dcf\u0dca\u0dba\u0dcf\u0dbd\u0dba\u0dca \u0db8\u0dd0\u0daf\u0dd2\u0dc4\u0dc3\u0dad\u0dca\u0dd3\u0db80 \u0dad\u0dc0\u0daf \u0d91\u0d9a\u0dd3 \u0dc0\u0dd2\u0db8\u0db8\u0db1\u0dd2\u0d9a \u0dc1\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a\u0dba\u0dca \u0db4\u0dad\u0dca\u0dc0 \u0d87\u0dd2\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0dc4\u0dc3\u0dcf \u0d94\u0dc0\u0dd4\u0dca\u0dc0\u0dc3 \u0d85\u0dc0\u0d9b\u0dba\u0dad\u0dcf \u0dca\u0dd0\u0dbd\u0d9a\u0dd2\u0dbd\u0dca\u0dbd \u0dc0\u0db8\u0db1 \u0dc0\u0dbb\u0ddd\u0dc4\u0dc3\u0dbd\u0dca \u0db8\u0dcf\u0dca\u0db4\u0dad\u0dd4 \u0d9c\u0dd4\u0dc0\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0d9b\u0db4\u0dad\u0dca \u0db8\u0dcf\u0dca\u0db4\u0dad\u0dd4 \u0dc4\u0dc3\u0dcf \u0d85\u0dc0\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0dc0\u0dd2\u0dba\u0daf\u0db1 \u0dca\u0db3\u0dc4\u0dc3\u0dcf \u0d9a\u0dcf\u0dca\u0dba\u0dcf\u0d9c\u0d9b\u0dba \u0db8\u0d9f\u0dd2\u0dca \u0db4\u0dd2\u0dd2\u0dba\u0dc0\u0dd0\u0dba \u0daf\u0dd0\u0dbb\u0dd3\u0db80\n\n\u2022 \u0dc3\u0dd2\u0dbb \u0dc0\u0db8\u0dc0\u0dbd\u0dca\u0dc0\u0dbd \u0dc4\u0dc3\u0dcf \u0dc0\u0dbb\u0ddd\u0dc4\u0dc3\u0dbd\u0dca\u0db8\u0dad\u0dc0 \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dc0\u0dd2\u0db8\u0db8\u0db1\u0dd2\u0d9a \u0dc1\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a\u0dba\u0dca \u0dc0\u0db8\u0dbb \u0db4\u0dd0\u0db8\u0dd2\u0dc0 \u0db1 \u0d85\u0dc0\u0dca\u0db4\u0dae\u0dcf\u0dc0\u0dbd\u0daf\u0dd3 \u0d8a \u0d85\u0daf\u0dcf\u0dc5 \u0d9c\u0dd4\u0dc0\u0dca \u0db8\u0db8\u0dca \u0dc0\u0dd2\u0dca\u0db4\u0dad\u0dbb \u0dad \u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd \u0dc4\u0dc3\u0dbb\u0dc4\u0dc3\u0dcf \u0dbd\u0db6\u0dcf\u0dc0\u0db8\u0db1 \u0d94\u0dc0\u0dd4\u0dca\u0dc0\u0dc3 \u0db7\u0dcf\u0dbb\u0d9a\u0db1\u0dca\u0dc0\u0dca \u0dc4\u0dc3\u0dcf \u0dca\u200d\u0dbb\u0dd3 \u0dbd