    "chunk_text": "\u0dd9\u0dbb\u0dd4 \u0d9a\u0dae\u0dab\u0db1\u0dab\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0dd9\u0db1\u0dd2, \u0dd9\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dc3\u0dba\u0d9a\u0dd4 \u0dc3\u0dbd\u0dd9 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc0, 10\u0d9a \u0db4\u0dd9\u0dba \u0d9a\u0dab\u0dbd\u0dba\u0d9a\u0dca \u0db4\u0dab\u0dbb\u0dca\u0dae\u0dd2\u0dc3 \u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0 \u0db1\u0dd2\u0dc3\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dba \u0d9a \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab, \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc0, 72\u0d9a\u0dca \u0d86\u0dba\u0dd4 \u0dc0 \u0db3\u0dab 2025 \u0dc3\u0daf\u0dd9\u0dd0 \u0db6\u0dbb\u0dca\u0dae \u0dd9\u0dd9 17 \u0daf\u0dd2\u0db1 \u0d85\u0db4 \u0d85\u0dca\u200d\u0dd2 \u0db1\u0dca \u0dd9\u0daf\u0dc4\u0da7\u0dd9 \u0dd9\u0db8\u0dd4 \u0dd9\u0dad\u0dca\u0dca\u200d\u0dab. \u0d85\u0db7\u0dab\u0dc0\u0db4\u0dca\u200d\u0dbb\u0dab\u0dca\u0dca\u200d \u0dd9\u0dbb\u0dd4 \u0d91\u0dd9\u0dca.\u0dc3\u0dd3. \u0db8\u0dd4\u0dad\u0dd4\u0db8\u0d9a\u0dd4\u0dd9\u0dab\u0dbb\u0dba \u0dd9\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd9\u0dab\u0da7 \u0db1\u0dd2\u0dc0\u0db1\u0dca\u0dc3\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dab\u0dbb\u0dca\u0dae\u0dae\u0db1\u0dab \u0d9a\u0dbb\u0db1 \u0d85\u0dca\u200d\u0dbb, \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab\u0dc3 \u0daf\u0dba\u0dab\u0db6\u0dbb \u0daf\u0dd6 \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dd4 \u0da5\u0dab\u0dad\u0dd3\u0db1\u0dca \u0dc3\u0dc0\u0dca\u200d \u0dc3\u0dd9\u0dd9 \u0dc3\u0dad\u0dca\u0dca\u200d\u0dbb\u0dd3\u0dca\u200d\u0dbb \u0dd9\u0db7\u0dab\u0dc3\u0d85 \u0dc3\u0dba\u0ddd\u0d9a\u0dba \u0daf\u0db1\u0dca\u0dc0\u0dab \u0dba\u0dc0\u0db1 \u0dc3\u0dbd\u0dd9 \u0daf \u0d89\u0dbd\u0dca\u0dbd\u0dab \u0db1\u0dca\u0dd2\u0db1\u0dc0\u0dab.\n\n2239 2240\n\n\u0db4\u0dab\u0dbb\u0dca\u0dae\u0dd2\u0dc3 \u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\n\n\u0da9\u0dd0\u0db1\u0dd3\u0db4\u0dab\u0dbd \u0dd9\u0dbd\u0dca\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0dd9\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd9\u0dab\u0da7 \u0dd9\u0dc4 \u0d91\u0dd9\u0dca.\u0d91\u0da0\u0dca\u0da0. \u0dbd\u0dd4\u0db1\u0dca\u0dc3\u0db1\u0ddd\u0db1\u0dab \u0dd9\u0dd0\u0dad\u0dd2\u0db1\u0dd2\u0dba\u0da7 \u0daf\u0dab\u0dc0 \u0da0\u0db1\u0dca\u0dbb\u0daf\u0dab\u0dd9 \u0dd9\u0dbd\u0dca\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0dd9\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd9\u0dab 1948 \u0dc0\u0dd9\u0dc3\u0dbb\u0dca\u0dae \u0dc3\u0daf\u0dc0\u0dd4\u0db1\u0dca\u0daf\u0dbb\u0daf\u0dd3 \u0da2\u0dca\u200d\u0db1\u0dca\u0dd9 \u0dbd\u0dab\u0db7\u0dba \u0dbd\u0dd0\u0db6\u0dd4\u0dc0\u0dab. \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0d85 \u0db4\u0dab\u0dbb \u0da9\u0dd3.\u0d91\u0dd9\u0dca. \u0dc3\u0dd9\u0dca\u0db1\u0dab\u0db1\u0dab\u0dba\u0d9a \u0dd9\u0dc4\u0dab \u0dc0\u0dd2\u0daf\u0dba\u0dab\u0dbd\u0dc3\u0dba\u0db1\u0dca \u0db1\u0dca\u0dba \u0d85\u0db0\u0db1\u0dba\u0dab\u0db4\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0dc4\u0dd0\u0daf\u0dd1\u0dbb\u0dd4\u0dc0\u0dab.\n\n\u0da0\u0db1\u0dca\u0dbb\u0daf\u0dab\u0dd9 \u0dd9\u0dbd\u0dca\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0dd9\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd9\u0dab 1979 \u0dc0\u0dbb\u0dca\u0dae\u0dc2\u0dc3\u0dda\u0daf\u0dd3 \u0dc3\u0daf\u0dca\u0dba\u0db4\u0dab\u0dbd\u0db1\u0dba\u0da7 \u0db4\u0dd2\u0dc0\u0dd2\u0db1\u0dca \u0d85\u0dca\u200d\u0dbb, \u0d91\u0dd9 \u0dc0\u0dd9\u0dc3\u0dbb\u0dca\u0dae \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2 \u0d85 \u0db4\u0dab\u0dbb \u0db4 \u0db8\u0dd4 \u0db1\u0dd9\u0dbb \u0dd9\u0db7\u0dab \u0dd9\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dba \u0da2\u0dca\u200d\u0dba\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dba\u0dba \u0d9a\u0dbb\u0dd2\u0dbd\u0db1\u0dca \u0d91\u0dc4\u0dd2 \u0db4 \u0db8\u0dd4 \u0db1\u0dd9\u0dbb\u0dab\u0dd2\u0d9a\u0db4\u0dad\u0dd2 \u0dc3\u0dbd\u0dd9 \u0dc3\u0dad\u0dca\u0dbb\u0dd3 \u0db4\u0dad\u0dca\u0dc0, 1989 \u0dc3\u0dca\u200d\u0d9a\u0dca \u0dc3\u0daf\u0dc0\u0dbb\u0d9a\u0dca\u0dd9 \u0db1\u0dd9\u0dbb\u0dab\u0dd2\u0d9a\u0db4\u0dad\u0dd2 \u0dd4\u0dbb\u0dbb\u0dba \u0dc3\u0dc4\u0db6\u0dd6\u0dc0\u0dab. 1989 \u0dc0\u0dd9\u0dc3\u0dbb\u0dca\u0dae\u0daf\u0dd3\u0dd9 \u0daf\u0dd2\u0dd9\u0dab\u0dd9\u0dd4\u0dbd\u0dca\u0dbd \u0daf\u0dd2\u0dd9\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dc3\u0dba\u0db1\u0dca \u0db4\u0dab\u0dbb\u0dca\u0dae\u0dd2\u0dc3 \u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\u0da7 \u0dc3\u0dad\u0dca\u0dbb\u0dd3 \u0db4\u0dad\u0dca \u0dd6 \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab 1989 \u0dc0\u0dbb\u0dca\u0dae\u0dc2\u0dc3\u0dda \u0db1\u0dca\u0da7 2001 \u0dc0\u0dbb\u0dca\u0dae\u0dc2\u0dba \u0daf\u0d9a\u0dca\u0dc0\u0dab \u0db4\u0dab\u0dbb\u0dca\u0dae\u0dd2\u0dc3 \u0db1\u0dca\u0dad\u0dd4\u0db8 \u0dd9\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dc3\u0dba\u0d9a\u0dd4 \u0dc3\u0dbd\u0dd9 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a \u0dab. \u0d89\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0 2008\u0daf\u0dd3 \u0db4 \u0dab\u0dad\u0dca \u0dd9\u0db7\u0dab \u0dd9\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dc3\u0dba\u0db1\u0dca \u0da2\u0dca\u200d\u0dba \u0dbd\u0db6\u0dab \u0db1\u0dd0 \u0dc3\u0d9f\u0db1\u0dc4\u0dd2\u0dbb \u0db4 \u0dab\u0dad\u0dca \u0dd9\u0db7\u0dab\u0dc3\u0d85 \u0dd9\u0db7\u0dab\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dab \u0dc3\u0dbd\u0dd9 \u0dd2\u0dbd\u0dba \u0dba\u0db1 \u0dc3\u0dca\u200d\u0d9a\u0dca\u0dd9 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0db8 \u0d9a \u0dab.\n\n1978\u0daf\u0dd3 \u0dc3\u0daf\u0ddd\u0db1 \u0dd9\u0dab\u0dbd\u0db1\u0dd3 \u0d85\u0dbd\u0dca\u0dc0\u0dd2\u0dd9\u0dca \u0da2\u0dca\u200d\u0dba\u0db1\u0dca\u0d82\u0dc4 \u0dd9\u0dc4\u0dad\u0dca\u0dd2\u0dbd\u0dba \u0dd9\u0dd9\u0d9f \u0dc0\u0dd2\u0dc0\u0dab\u0dc4 \u0dd6 \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0db4\u0dd4\u0dca\u200d\u0dab\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0dd2\u0dc3\u0daf\u0dc3\u0db1\u0d9a\u0dd4\u0dc3 \u0daf\u0dba\u0dab\u0db6\u0dbb \u0db4\u0dd2\u0dc3\u0dba\u0d9a\u0dca. \u0dd9\u0dbb\u0dd4 \u0d9a\u0dae\u0dab\u0db1\u0dab\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0dd9\u0db1\u0dd2, \u0db4\u0dab\u0dbb\u0dca\u0dae\u0dd2\u0dc3 \u0db1\u0dca\u0dad\u0dd4\u0db8 \u0dd9\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dba\u0d9a\u0dd4 \u0dc3\u0dbd\u0dd9 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc0, 13\u0d9a \u0db4\u0dd9\u0dba \u0d9a\u0dab\u0dbd\u0dba\u0d9a\u0dca \u0db4\u0dab\u0dbb\u0dca\u0dae\u0dd2\u0dc3 \u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0 \u0db1\u0dd2\u0dc3\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dba \u0d9a \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dc0, 78\u0d9a\u0dca \u0d86\u0dba\u0dd4 \u0dc0 \u0db3\u0dab 2026 \u0dc3\u0db4\u0db6\u0dbb\u0dc0\u0dab\u0dd2 \u0dd9\u0dd9 13\u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0d85\u0db4 \u0d85\u0dca\u200d\u0dd2 \u0db1\u0dca \u0dd9\u0daf\u0dc4\u0da7\u0dd9 \u0dd9\u0db8\u0dd4 \u0dd9\u0dad\u0dca\u0dca\u200d\u0dab.\n\n\u0d85\u0db7\u0dab\u0dc0\u0db4\u0dca\u200d\u0dbb\u0dab\u0dca\u0dca\u200d \u0dd9\u0dbb\u0dd4 \u0da0\u0db1\u0dca\u0dbb\u0daf\u0dab\u0dd9 \u0dd9\u0dbd\u0dca\u0db4\u0dad\u0dca\u0dad\u0dd2 \u0dd9\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd9\u0dab\u0da7 \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab \u0dc0\u0dd2\u0dba\u0dca\u0dc0\u0dab\u0dd9 \u0d9a \u0db4\u0dd2 \u0daf\u0dd2 \u0db1\u0dd2\u0dc0\u0db1\u0dca \u0dc3\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dab\u0dbb\u0dca\u0dae\u0dae\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0d85\u0dca\u200d\u0dbb, \u0d91\u0dad\u0dd4\u0db8\u0dd9\u0dab\u0dc3 \u0daf\u0dba\u0dab\u0db6\u0dbb \u0db6\u0dd2\u0dd2 \u0db3 \u0dc4\u0dab \u0daf\u0dd6 \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dd4 \u0da5\u0dab\u0dad\u0dd3\u0db1\u0dca \u0dc3\u0dc0\u0dca\u200d \u0dc3\u0dd9\u0dd9 \u0dc3\u0dad\u0dca\u0dca\u200d\u0dbb\u0dd3\u0dca\u200d\u0dbb \u0dd9\u0db7\u0dab\u0dc3\u0d85 \u0dc3\u0dba\u0ddd\u0d9a\u0dba \u0daf\u0db1\u0dca\u0dc0\u0dab \u0dba\u0dc0\u0db1 \u0dc3\u0dbd\u0dd9 \u0daf \u0dd9\u0dab \u0d89\u0dbd\u0dca\u0dbd\u0dab \u0db1\u0dca\u0dd2\u0db1\u0dc0\u0dab.\n\n\u0dd9\u0dbb\u0dd4 \u0d9a\u0dae\u0dab\u0db1\u0dab\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0dd9\u0db1\u0dd2, \u0da2\u0dca\u200d\u0db1\u0dca\u200d\u0dab \u0dc0\u0dd2\u0db8\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc3\u0db4\u0dbb\u0db8\u0dd4\u0dba \u0db1\u0dd2\u0dc3\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dba \u0d9a\u0dbb\u0dd2\u0dbd\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dae\u0dd9 \u0dc0\u0dca\u200d\u0dab\u0dc0\u0da7 2000 \u0dc0\u0dbb\u0dca\u0dae\u0dc2\u0dc3\u0dda\u0daf\u0dd3 \u0d9a\u0dc5\u0dd4\u0dca\u200d\u0dbb \u0daf\u0dd2\u0dd9\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dc3\u0dba\u0db1\u0dca \u0db4\u0dab\u0dbb\u0dca\u0dae\u0dd2\u0dc3 \u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\u0da7 \u0dc3\u0dad\u0dca\u0dbb\u0dd3 \u0db4\u0dad\u0dca\u0dc0 \u0db4\u0dab\u0dbb\u0dca\u0dae\u0dd2\u0dc3 \u0db1\u0dca\u0dad\u0dd4\u0db8 \u0dd9\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dc3\u0dba\u0d9a\u0dd4 \u0dc0\u0dba\u0dc3\u0dba\u0db1\u0dca \u0dca\u200d\u0dd9 \u0daf\u0dd2\u0dd9\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0da7 \u0dc3\u0dd9\u0db1\u0dca\u0dd9 \u0dbb\u0da7\u0da7 \u0daf \u0dc3\u0dd9\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0d89\u0da7\u0dd4 \u0d9a \u0dd9\u0dbb\u0dd4 \u0db1\u0db1\u0dca\u0daf\u0db1 \u0d9c\u0dd4\u0dba\u0dad\u0dd2\u0dbd\u0d9a \u0dd9\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd9\u0dab\u0dc3 \u0d85\u0db7\u0dab\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dc3\u0dba\u0ddd\u0d9a\u0dba \u0db4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc3 \u0dc3\u0dba\u0ddd\u0da2\u0dca\u200d\u0db1\u0dab\u0dc0 \u0dd9\u0dab \u0dc3\u0dd9\u0dd9 \u0d85\u0dc0\u0dd9\u0dca\u0dae\u0dab\u0dc3\u0d85\u0daf\u0dd3 \u0dc3 \u0dd9\u0dbb\u0dd4 \u0dd9\u0db7\u0dab\u0dc0\u0da7 \u0d89\u0daf\u0dd2\u0dd2 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dab."
