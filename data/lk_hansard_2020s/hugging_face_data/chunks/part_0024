    "chunk_text": "\u0db8\u0dd6\u0d9a\u0dd2\u0dc3\u0db1\u0dd2\u0dbb\u0dd6\u0daa \u0db8\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0db8\u0db8 \u0db8\u0dda \u0dd2\u0dbb\u0dba\u0db1\u0dca\u0db8\u0db1\u0dca \u0db1\u0dca\u0dc0\u0dd2\u0dbd\u0dca \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dd2\u0db1 \u0dc3\u0dc4 \u0dba\u0db1\u0db8\u0dd2\u0db0\u0dba \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dd2\u0db1\u0dca\u0d9a\u0dda \u0db8\u0dc0\u0db1\u0dd4\u0db8\u0dc0\u0db1\u0dca \u0db8\u0db4\u0db1\u0dd3 \u0db1\u0dca\u0db4\u0dcf\u0db1 \u0db1\u0dca\u0dba\u0dbd\u0dd4 \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dd2\u0db1 \u0db8\u0dd0\u0db1 \u0db8\u0db1\u0dd2\u0db8\u0dc0\u0dba\u0dd2. \u0db8\u0dda \u0d9a\u0dcf\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db8\u0db1\u0dca \u0dc3\u0db8\u0dc4\u0dbb \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dd2\u0db1 \u0db8\u0dd0\u0db1\u0dba\u0dd2. \u0dc3\u0db8\u0dc4\u0dbb \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dd2\u0db1\u0dc0\u0d9a \u0db4\u0dca\u200d\u0dbb \u0dab\u0dca\u0da9\u0da9 \u0db8\u0dbb\u0dca\u0daf\u0db1\u0d9a\u0dd2\u0dd3\u0db8 \u0dbb\u0dd2\u0dba\u0dba\u0dba\u0dd2\u0dbb\u0db1\u0dca \u0db8\u0dad\u0dd2\u0dbb\u0dc0 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0db8\u0d9a\u0dca\u0dc0 \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0db8 \u0d91\u0db8\u0dc4\u0db8 \u0dd2\u0dbb\u0dba\u0db1\u0dca\u0db8\u0db1\u0dca \u0dad\u0dba\u0dd2? \u0db8\u0dd6\u0d9a\u0dd2\u0dc3\u0db1\u0dd2\u0dbb\u0dd6\u0daa \u0db8\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0db1\u0dd2 \u0dc3\u0dad\u0dd2\u0db8\u0dba\u0db1\u0dca \u0dc3\u0dad\u0dd2\u0dba \u0db8\u0dd2\u0db0\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dd2 \u0db1\u0dd2\u0dc0\u0dda\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db8\u0dc0\u0da0\u0dca \u0dc3\u0db8\u0dc4\u0dbb \u0d9a\u0dd2\u0d9a \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd2. \u0dc3\u0db8\u0dc4\u0dbb \u0db8\u0dd2\u0db0\u0dba\u0db8\u0dc0\u0daf\u0dd3\u0db1\u0dca \u0db8\u0dc4 \u0db8\u0d9f \u0daf\u0dc0\u0dd2\u0db8\u0dbd\u0dca \u0db8\u0dd0\u0dc4\u0dd4\u0dc0\u0dd2; \u0dc3\u0db8\u0dc4\u0dbb \u0db8\u0dd2\u0db0\u0dba\u0db8\u0dc0\u0daf\u0dd3\u0db1\u0dca \u0dc3\u0dd4\u0dd4 \u0dc0\u0dd1\u0db1\u0dca \u0dad\u0dc0\u0dd2\u0dbd\u0dca\u0d9a\u0dd2 \u0db4\u0dd0\u0dc4\u0dd0\u0dbb\u0db8\u0db8\u0db1 \u0d9c\u0dd2\u0dba\u0dd2; \u0db8\u0dd2\u0db0\u0dba \u0dca\u0dba\u0dad\u0db1\u0dc0\u0d9a \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dd0\u0db6\u0dd4\u0dc0\u0dd2; \u0dc3\u0db8\u0dc4\u0dbb \u0db8\u0dd2\u0db0\u0dba\u0db8\u0dc0\u0daf\u0dd3\u0db1\u0dca \u0dbb \u0d85\u0dad\u0dc4\u0dd0\u0dbb \u0d9c\u0dd2\u0dba\u0dd2. \u0d9d\u0dd2\u0dad\u0db1 \u0db4\u0dd0\u0dc4\u0dd0\u0dbb \u0db8\u0dd0\u0db1\u0dd3\u0dda \u0db4\u0dca\u200d\u0dbb \u0dab\u0dca\u0da9\u0da9 \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2 \u0d82\u0dd2\u0db0\u0dd2 \u0dd2\u0dbb\u0dd3\u0db8\u0dda CID \u0d91\u0d9a \u0d9a\u0dd0\u0db3\u0dd3\u0dda \u0dc0\u0dd0\u0db1\u0dd2 \u0db1\u0dca\u0dba\u0dbd\u0dd4\n\n\u0d85\u0daf \u0daf\u0dc0\u0db8\u0dc3\u0dda \u0db8\u0dd2\u0dad\u0dd8\u0d9a\u0dd2\u0dc0 \u0db8\u0db8 \u0dca\u0db8\u0dc0\u0dd2\u0dad\u0dca 2025 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0d82\u0d9a\u0dd2 \u0db8\u0dc4 \u0d82\u0dd0\u0d82\u0dc0\u0dda \u0dc0\u0dd2\u0dbb\u0dca\u0dad\u0dd2\u0dc0 \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0daf \u0daf\u0dc0\u0db8\u0dc3\u0dda \u0dc3\u0dd2\u0d9a\u0da0\u0dca\u0da1\u0dd2\u0dc0 \u0db8\u0db1\u0dd4 \u0d9a\u0d82\u0db1\u0dca\u0db8\u0db1\u0dca. \u0d85\u0daf \u0d8b\u0db8\u0daf\u0dca\u0db0 \u0dd2\u0db3\u0d9a\u0dd2\u0db8 \u0d85\u0db8\u0dda \u0dc3\u0dd2\u0dbb\u0dca\u0dc0 \u0dca\u0dbb\u0dca \u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0db8\u0dd0\u0db1 \u0d9a\u0dcf\u0dd2 \u0d9a\u0dc5\u0dd2. \u0dc0\u0dd2\u0db8 \u0dda\u0dc2\u0dca\u0da8\u0db8\u0dba\u0db1\u0dca\u0db8 \u0db1\u0dca\u0dba\u0dba 5\u0d9a \u0d91\u0dc4\u0dd2 \u0d9c\u0dd2\u0dba \u0dca\u0dbb\u0dca \u0d9a \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db8\u0dc0\u0db8\u0dba\u0d9a\u0dca\u0dc0 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dd2\u0db8\u0db8\u0db1 \u0dba\u0dd1\u0db8 \u0d85\u0db8\u0dda \u0dc0\u0dd2\u0db8\u0daf\u0dca\u0db0 \u0db8\u0dc0\u0db8\u0dc5\u0db3 \u0db8\u0db4\u0dd2\u0dc5 \u0d9a\u0dca\u0dc0\u0dad\u0dd2\u0db8\u0dad\u0dca\u0dc0 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dd2\u0db8\u0db8\u0db1 \u0dba\u0dd1\u0db8 \u0d85\u0db4\u0db1\u0dba\u0db1 \u0dca\u0daf\u0dd2\u0dba\u0db8 \u0dc0\u0dd2\u0db8\u0daf\u0dca\u0db0 \u0db8\u0dda\u0dc2\u0dca\u0da8\u0dab \u0dc3\u0d82 \u0dd2\u0dbb\u0d9a \u0dc0\u0dba\u0dd2\u0db4\u0dd2\u0dbb\u0dba \u0db8\u0dd0\u0db1 \u0d85\u0db4\u0dd2 \u0d8b\u0db8\u0daf\u0dca\u0db0 \u0dd2\u0db3\u0d9a\u0dd2 \u0db8\u0db8\u0dd2\u0da9\u0d9a\u0dca\u0dc0 \u0d9a\u0dcf\u0dd2 \u0d9a\u0dc5\u0dd2. \u0d92 \u0dc0\u0dd2\u0db8\u0dda\u0db8 \u0db8\u0dda \u0d85\u0dd2\u0da0\u0db8\u0dba\u0ddd\u0db8 \u0db8\u0db0\u0dba\u0db8\u0dd3 \u0dc0\u0dd4\u0dab\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0db8\u0dd2\u0dbb\u0dca\u0d9a\u0da7\u0dca\u0da7 \u0d91\u0d9a \u0dc4\u0dc0\u0dda\u0dc5\u0db1\u0dca\u0db8\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0db8\u0dc0\u0db8\u0dc5\u0db3 \u0db8\u0db4\u0dd2\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dd2\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dca\u0dbb\u0dca \u0d9a\u0dba \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dd2\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dca\u0dbb\u0dca \u0d9a\u0dba \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dd2\u0db8\u0db8\u0db1 \u0dba\u0dd1\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0d82\u0db3\u0dc0 \u0dc3\u0dd2\u0d9a\u0da0\u0dca\u0da1\u0dd2 \u0d9a\u0dbb\u0db1\u0dc0\u0dd2. \u0dc0\u0dd2\u0db8 \u0dda\u0dc2\u0dca\u0da8\u0db8\u0dba\u0db1\u0dca\u0db8 \u0db8\u0d9a\u0ddd\u0d9a\u0db8\u0dd3 \u0db8\u0db8\u0ddd\u0dbd\u0dd3\u0dba \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf\u0dba\u0d9a\u0dca\u0dc0 \u0dad\u0dd2\u0db8\u0d82\u0db1\u0dc0\u0dd2. \u0d92 \u0dd2\u0dbb\u0dba\u0db1\u0dca\u0db8\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dd2 \u0db8\u0dda \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf\u0dba \u0db1\u0dd2\u0dc3\u0dd2 \u0db8\u0d9a\u0ddd\u0d9a\u0db8\u0dd3 \u0dc3\u0dd0\u0db4\u0dba\u0dd4\u0dda \u0daf\u0dd2\u0db8 \u0d9a\u0da9\u0dd2\u0db8\u0db8\u0db1 \u0dc0\u0dd0\u0db4\u0dcf\u0d9a\u0dd2 \u0dad\u0dd2\u0db8\u0d82\u0db1\u0dc0\u0dd2. \u0d85\u0dad\u0dd2\u0dc0\u0dd2 \u0dd2\u0d9a \u0dbb \u0dc0\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dab\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d85\u0dc0\u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dab\u0dba \u0db8\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dc0\u0dd2. \u0dc0\u0dd2\u0db8 \u0dda\u0dc2\u0dca\u0da8\u0db8\u0dba\u0db1\u0dca \u0dd2\u0db1\u0dca\u0db0\u0db1 \u0dc3\u0dc4 \u0db8\u0dad\u0dbd\u0dca \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf\u0dba \u0db1\u0dd2\u0dc3\u0dd2\u0db8 \u0d8b\u0daf\u0dca\u0db0\u0db0\u0db8\u0db1\u0dba \u0dd2\u0dc4\u0dc5 \u0dba\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dc0\u0dd2. \u0db8\u0dda \u0dc4\u0dd0\u0db8 \u0dca\u0dbb\u0dca \u0d9a \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf \u0d85\u0dc0\u0dc3\u0dda\u0dcf\u0dd2\u0dc0\u0d9a\u0db8 \u0d91\u0dc4\u0dd2 \u0dc3\u0dda\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0d82\u0dbb \u0dba\u0db1\u0dad\u0dd2\u0dc0 \u0db8\u0db1\u0dd2\u0daf\u0dd0\u0db8\u0db1\u0db1\u0dca\u0db1 \u0dca\u0dbb\u0dca \u0d9a\u0dba \u0db1\u0dd2\u0db1\u0dca \u0db8\u0d9a\u0dc3 \u0d9a\u0dc5\u0db8\u0db1\u0dd2\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dbb \u0db8\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0db1\u0dca\u0db4\u0dcf\u0db1 \u0d82\u0dc0 \u0d8b\u0db8\u0daf\u0dca\u0db0 \u0dd2\u0db3\u0d9a\u0dd2 \u0db1\u0dca\u0dd4 \u0d9a\u0dc5 \u0d9a\u0dcf\u0dd2\u0dc0\u0d9a \u0dd2\u0dbb\u0dba\u0db4\u0dd4 \u0db1\u0dd2\u0dc3\u0dd2 \u0db8\u0db8 \u0db1\u0dd0\u0dc0\u0dad\u0dad\u0dca \u0d91\u0dba \u0d85\u0dc0\u0db0\u0dd2\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dba\u0db1\u0dca\u0db8\u0db1\u0dca \u0db1\u0dd0\u0dc4\u0dd0."
