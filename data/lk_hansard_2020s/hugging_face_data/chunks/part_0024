dab\u0dd2\u0dc0\u0d9a \u0dc0\u0dd2\u0dc2\u0dca\u0da8\u0dba\u0db8\u0dd2\u0d9a\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dda\u0d9a\u0dbb\u0dab \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0dad\u0dca\u0db8\u0d9a \u0db8\u0d9a\u0db8\u0dbb\u0db1\u0dd4 \u0dad\u0dad. \u0d8a \u0dc3\u0db8\u0db8\u0dd2\u0db8\u0dd3\u0dc0 \u0dc3\u0dc4\u0dd2\u0dba\u0d9a \u0d9a\u0dd2\u0dbb\u0dca\u0dba\u0dba\u0db1\u0dca \u0dd2\u0dc4\u0dad \u0daf\u0d9a\u0dca\u0dc0\u0dc0\u0dd2 \u0dad\u0dad\u0dd2 \u0db8\u0dc3\u0dc3\u0dd4 \u0dc0\u0dda\u0dbd\u0dd4\u0db1\u0dd4 \u0d94\u0dc3\u0dda\u0db8\u0dc3\u0dda \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0db1\u0dd4 \u0dad\u0dad. (iii) \u0dc0\u0dd2\u0dd4\u0dc4\u0dbd\u0dca\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc4\u0dd2 \u0d85\u0db0\u0dba\u0dd2\u0db4\u0db1 \u0db1\u0dd2\u0d9a\u0db0\u0dd2\u0db4\u0dad\u0db1\u0dca \u0db1\u0dd2\u0db1\u0dca \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0dc0\u0d9a\u0dca\u0dc0 \u0d9a\u0d82\u0dd2 \u0daf\u0dd3\u0db8 \u0db4\u0dc5\u0db8\u0dd4\u0dc0 \u0db1\u0dca\u0dd4 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dca\u0dba\u0dba\u0d9a\u0dca\u0dc0 \u0db8\u0d9a\u0dc3 \u0db4\u0dd2\u0dc5\u0dd2\u0db8\u0db1\u0dca\u0db1\u0dd2 \u0d85\u0dad\u0dbb \u0d92 \u0dc3\u0db3\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd4\u0d9b\u0dad\u0dd2\u0dc0 \u0d9a\u0d82\u0dd2 \u0db8\u0daf\u0db8\u0dd2\u0db1\u0dca \u0db8\u0dda \u0dc0\u0db1 \u0dc0\u0dd2 \u0daf \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0dad\u0dad. (iv) 2025 \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0db8\u0dd3 \u0daf\u0dd3 1\u0dc0\u0db1 \u0db8\u0dbb\u0dda\u0dab\u0dd2\u0db8\u0dd3 \u0dc3\u0dc4 6\u0dc0\u0db1 \u0db8\u0dbb\u0dda\u0dab\u0dd2\u0db8\u0dd3 \u0db4\u0dc5\u0db8\u0dd4 \u0dc0\u0dd2\u0dbb\u0dba \u0dc3\u0db3\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dd2\u0db1 \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0db8\u0d9a\u0dc3 \u0db8\u0dad\u0ddd\u0dbb\u0dd2 \u0db8\u0db1\u0dca\u0db