    "chunk_text": "\u0d86\u0dc3\u0dd2\u0dba\u0dcf\u0dc0\u0dda \u0d85\u0dc0\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0dbb \u0dc0\u0dbd\u0dca \u0d91\u0dca\u0d9a \u0dca\u0d9c\u0dca\u0dca\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dd2\u0dca \u0d85\u0dc0\u0dca \u0dc0\u0dd2\u0dc0\u0daf\u0dca\u0d9b \u0dc0\u0dd2\u0db1\u0dd2\u0db8\u0dba \u0d85\u0dc0\u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf \u0dba \u0dd3\u0db8 - \u0d85\u0da9\u0dd4 \u0dc0\u0dd0\u0da9\u0dd2 \u0dd3\u0db8 - \u0db8\u0dd0\u0db1\u0dad\u0dca \u0dc0\u0dd2\u0db4\u0dca\u0dc2\u0dba \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf0 \u0db8\u0dcf \u0dc0\u0db4\u0dca\u0db1\u0dd4\u0db1 \u0d9a\u0dbb\u0dca\u0db1 \u0dc4\u0dc3\u0daf\u0dca\u0dc0\u0dca \u0dc0\u0db8\u0dba \u0d85\u0db4 \u0db6\u0dcf\u0dc4\u0dd2\u0dd2\u0dba\u0dca \u0dd2\u0db1\u0db6\u0dd2\u0da0\u0dca\u0da0\u0dd4 \u0dca\u0dcf\u0db0\u0d9a\u0dba\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dca\u0dc4\u0dc3 \u0d85\u0dc0\u0dca \u0d86\u0dca\u0dd2\u0d9a\u0dba \u0dca\u0db4\u0dae\u0dcf\u0dc0\u0dbb\u0dc0 \u0dd2\u0db1\u0dc0\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dba\u0dd20 \u0d92 \u0dc0\u0dcf\u0dc0\u0dc3\u0db8 \u0dc0\u0dd2\u0dc0\u0daf\u0dca\u0d9b \u0dc0\u0dd2\u0db1\u0dd2\u0db8\u0dba \u0d85\u0db1\u0dd4\u0db4\u0dcf\u0dad\u0dba \u0d85\u0db7\u0dba\u0dca\u0dad\u0dbb \u0dc0\u0dc4\u0dc3\u0db4\u0dad\u0dd4 \u0dc0\u0dca \u0db1\u0dd2\u0dca\u0dcf \u0dc0\u0db1\u0dcf\u0dc0 \u0db6\u0dcf\u0dc4\u0dd2\u0dbb \u0dc0\u0dc4\u0dc3\u0db4\u0dad\u0dd4 \u0dc0\u0dca \u0db1\u0dd2\u0dca\u0dcf \u0d85\u0dc0\u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf \u0dba \u0dd3\u0db8 \u0d86\u0dca\u0dd2\u0d9a \u0dc0\u0dca\u0db0\u0db1\u0dba \u0dc0\u0dc4\u0dc3\u0ddd \u0d86\u0dca\u0dd2\u0d9a\u0dba \u0d9a\u0da9\u0dcf \u0dc0\u0dd0\u0dd3.\u0db8 \u0db6\u0dbd\u0db4\u0dcf\u0dca\u0dc0\u0dca \u0db1\u0dd0\u0dc4\u0dc3\u0dd00 \u0d92\u0d9a \u0dc0\u0dc4\u0dc3\u0dcf\u0db3\u0db8 \u0dda\u0daf\u0dcf\u0dc4\u0dc3\u0dbb \u0dc0\u0daf\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0dca\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0 \u0dca\u0dc4\u0dc3 \u0dca\u0dca\u0daf\u0dd4\u0db1\u0dd3\u0dc3\u0dd2\u0dba\u0dcf\u0dc00 \u0dca\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0dda \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d92\u0d9a\u0d9a\u0dba \u0dca\u0dd2\u0db1\u0dc4\u0dc3\u0dcf\u0dca\u0dc0\u0dda \u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0d85\u0db8\u0dba\u0d9a\u0dd2\u0dca \u0d85\u0dc0\u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf \u0dba \u0dc0\u0dc0\u0dbd\u0dcf\u0dba\u0dd2 \u0dd2\u0db1\u0dc0\u0db6\u0dca\u0dc0\u0dca0 \u0d91\u0dba \u0dca\u0dd2\u0db1\u0dc4\u0dc3\u0dcf\u0dca\u0db8\u0dad \u0dc0\u0dbd\u0dca \u0dc0\u0dcf\u0dca\u0dad\u0dcf\u0db8\u0dad \u0dc0\u0dbd\u0dca \u0d85\u0da9\u0dd4\u0db8 \u0db8\u0dca \u0db8\u0d9a \u0dc0\u0dd0\u0da7\u0dd2\u0dbd\u0dcf \u0dd2\u0db1\u0dc0\u0db6\u0db1\u0dc0\u0dcf0 \u0d92 \u0d9a\u0dd2\u0dba\u0dca\u0dc0\u0dca \u0dca\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0dda \u0db1\u0dca\u0db4\u0dd2\u0dba\u0dbd \u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0d85\u0dc0\u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf \u0dba \u0dd3\u0db8 \u0daf\u0dd0\u0dca \u0dc0\u0dcf\u0dca\u0dad\u0dcf \u0dc0\u0dc0\u0dbd\u0dcf \u0dd2\u0db1\u0dc0\u0db6\u0db1\u0dc0\u0dcf0 \u0dc4\u0dc3\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d94\u0dc0\u0dd4\u0dca\u0dc0\u0dc3 \u0d86\u0dca\u0dd2\u0d9a \u0dc0\u0dca\u0db0\u0db1 \u0dc0\u0dda\u0db8\u0dba \u0dc3\u0dd2\u0dba\u0dba 60.\u0dca \u0dc0\u0dbd\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dc0\u0db8\u0db1 \u0dba\u0db8\u0dd2\u0dca \u0dd2\u0db1\u0dc0\u0db6\u0db1\u0dc0\u0dcf0 \u0dca\u0dca\u0daf\u0dd4\u0db1\u0dd3\u0dc3\u0dd2\u0dba\u0dcf\u0dc0\u0dda\u0dad\u0dca \u0dc0\u0daf\u0dca\u0dba\u0dba \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d92\u0d9a\u0d9a\u0dba \u0dca\u0dd2\u0db1\u0dc4\u0dc3\u0dcf\u0dca\u0dc0\u0dda \u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0d85\u0db8\u0dba\u0d9a\u0dd2\u0dca \u0d85\u0dc0\u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf \u0dba \u0dc0\u0dc0\u0dbd\u0dcf \u0dd2\u0db1\u0dc0\u0db6\u0db1\u0dc0\u0dcf0 \u0dc4\u0dc3\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d94\u0dc0\u0dd4\u0db1\u0dd4\u0dad\u0dca \u0dc3\u0dd2\u0dba\u0dba 7\u0d9a \u0d86\u0dca\u0dd2\u0d9a \u0dc0\u0dca\u0db0\u0db1\u0dba\u0dca \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0dc0\u0db8\u0db1 \u0dd2\u0db1\u0dc0\u0db6\u0db1\u0dc0\u0dcf0 \u0d92 \u0d9a\u0db1\u0dca\u0dd4\u0dc0\u0dbd\u0dd2\u0db8\u0dca \u0dc0\u0db4\u0dca\u0db1\u0dd4\u0db1 \u0d9a\u0dbb\u0dca\u0dc0\u0dca \u0d86\u0dca\u0dd2\u0d9a\u0dba \u0db4\u0dd2\u0da7\u0dd2\u0dca \u0dd2\u0db1\u0dc0\u0db6\u0db1 \u0dca\u0dcf\u0db0\u0d9a\u0dba\u0dca \u0db1\u0dd2\u0dca\u0dcf \u0dc0\u0dd2\u0dc0\u0daf\u0dca\u0d9b \u0dc0\u0dd2\u0db1\u0dd2\u0db8\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0dd4 \u0dcf \u0db8\u0dd0 \u0dd4 \u0dc0\u0dca \u0dc0\u0dc0\u0dca\u0dc0\u0dca \u0db1\u0dd0\u0dc4\u0dc3\u0dd0 \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf\u0dbb \u0dba\u0dba\u0dd20 \u0d91\u0db8 \u0db1\u0dd2\u0dca\u0dcf \u0d85\u0dc0\u0dca \u0dbb \u0dc0\u0db1 \u0dc0\u0dc4\u0dc3\u0db4\u0dad\u0dd4 \u0dc0\u0dc0\u0dca \u0d86\u0dca\u0dd2\u0d9a \u0d85\u0dca\u0db6\u0dd4\u0daf\u0dba\u0d9a \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0d86\u0d9a\u0dcf\u0dbb\u0dba\u0d9a\u0dd2\u0dca \u0db8\u0db8\u0dca \u0d9a\u0dbb\u0dca\u0dc0\u0dca \u0db1\u0dd0\u0dc4\u0dc3\u0dd00\n\n\u0db8\u0db1\u0dca \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4 \u0db8\u0db1\u0dd2 \u0db8\u0db8 \u0dad\u0dc0\u0dad\u0dca \u0dc0\u0db4\u0dcf\u0da9\u0dd2 \u0dc0\u0dc0\u0dbd\u0dcf\u0dc0\u0dca \u0d85\u0dbb \u0db8\u0dca\u0db1\u0dc0\u0dcf \u0dc0\u0dcf\u0dc4\u0dc3\u0db1 \u0d86\u0db1\u0dba\u0db1\u0dba \u0db8\u0dd0\u0db1 \u0d9a\u0dd2\u0dba\u0dca\u0db10 \u0dc0\u0db1 \u0dc0\u0db8\u0dcf\u0dc0\u0dc4\u0dc3\u0dcf\u0dad \u0dc0\u0db1 \u0dc0\u0dd2 \u0d85\u0db4\u0dd2 \u0dba\u0db1 \u0dad\u0dd3\u0dca\u0daf\u0dd4\u0dc0\u0dca \u0dc0\u0db8\u0db1 \u0dd2\u0db1\u0dc0\u0db6\u0db1\u0dc0\u0dcf \u0dc0\u0db4\u0dde\u0daf\u0dca\u0db8\u0dbd\u0dd2\u0db8\u0d9a \u0dc0\u0dcf\u0dc4\u0dc3\u0db1 \u0d86\u0db1\u0dba\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0db4\u0dcf\u0da9\u0dca\u0da9\u0dca \u0d9a\u0dbd\u0dca \u0daf\u0db8\u0dcf \u0db8\u0dd0\u0db1\u0dd3\u0db8 0 \u0d92 \u0d91\u0d9a \u0dc0\u0d9a\u0da7\u0dd2 \u0dda\u0dad\u0dca\u0dad\u0dbb\u0dba\u0dca0 \u0dad\u0dc0 \u0dda\u0dad\u0dca\u0dad\u0dbb \u0db8 \u0db1\u0dcf\u0dc0\u0dca \u0dc0\u0db1 \u0dad\u0dd4 \u0dc5 \u0dd2\u0db1\u0dc0\u0db6\u0db1\u0dc0\u0dcf0 \u0d85\u0db4\u0dd2 \u0dc0\u0dad\u0dcf\u0dbb\u0dad\u0dd4 \u0db1\u0dca \u0d85\u0db0\u0dba\u0dba\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dd2\u0dca \u0db4\u0dd2\u0dba\u0dc0\u0dc0\u0dbb\u0dca \u0db4\u0dd2\u0dba\u0dc0\u0dbb \u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a\u0dc0\u0dba\u0dd2 \u0d91\u0dad\u0dd0\u0db1 \u0d91\u0dca\u0dc0\u0dca0 \u0d92 \u0dca\u0db1\u0db6\u0dca\u0db0\u0dc0\u0dba\u0dca \u0dc0\u0dd2\u0db4\u0dca\u0dc2\u0dba \u0dca\u0daf\u0dd2\u0dd2\u0dba\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db4\u0dd4 \u0dad\u0dca\u0d9a\u0dba\u0dca \u0dd2\u0db1\u0dc0\u0db6\u0db1\u0dc0\u0dcf0 \u0d92 \u0dad\u0db8\u0dba\u0dd2 \u0dc4\u0dc3\u0dd2\u0dba\u0dba \u0db8 \u0dc0\u0db1 \u0dad\u0dd3\u0dca\u0daf\u0dd4\u0dc0 \u0db8\u0dad\u0dca\u0dad\u0dd4 \u0db8\u0dd0\u0dba\u0dd2 \u0db8\u0dcf\u0dca\u0dc0\u0dda 1.\u0dc0\u0db1 \u0daf\u0dcf \u0dc0\u0dcf\u0dc4\u0dc3\u0db1 4 000\u0dca \u0dc0\u0db8\u0dca\u0db1\u0dd4\u0dc0\u0dcf; \u0d92\u0dc0\u0dcf\u0dc0\u0dba\u0dca 3 .00\u0dca \u0d91\u0d9a \u0dca\u0db8\u0dcf\u0db8\u0db8\u0dca \u0dca\u0dc4\u0dc3 \u0d85\u0dc0\u0db1\u0dca .00 \u0dad\u0dc0\u0dad\u0dca \u0dca\u0db8\u0dcf\u0db8\u0db8\u0dca \u0dc0\u0db8\u0dca\u0dc0\u0dcf \u0dd2\u0db1\u0dc0\u0db6\u0db1\u0dc0\u0dcf; \u0dc0\u0dad\u0dcf\u0dbb\u0dad\u0dd4 \u0db1\u0dca \u0d91\u0dc5\u0dd2\u0dba \u0d9c\u0dd2\u0dc4\u0dd2\u0dca \u0dd2\u0db1\u0dc0\u0db6\u0db1\u0dc0\u0dcf; \u0dc0\u0dc4\u0dc3\u0dcf\u0dbb\u0d9a\u0db8\u0dca \u0dc0\u0d9c \u0dcf\u0dc0\u0dca \u0d9a\u0dbb \u0dd2\u0db1\u0dc0\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a0 \u0d91\u0dc0\u0dca\u0db4 \u0dca\u0db1\u0db4\u0dd6\u0dca \u0dc0\u0dba\u0dca\u0db8 \u0db8\u0dd2\u0dae\u0dba\u0dcf\u0dc0\u0dca \u0dc0\u0dd0\u0dbb\u0dd0\u0daf\u0dd2 \u0dc0\u0dad\u0dcf\u0dbb\u0dad\u0dd4 \u0dbb\u0dca \u0dca\u0db8\u0dcf\u0da2\u0dca\u200d\u0db8\u0dad \u0d9a\u0dc5\u0dcf0 \u0d91\u0d9a \u0d91\u0d9a \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db1 \u0d91\u0d9a \u0d91\