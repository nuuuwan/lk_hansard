    "chunk_text": "\u0d92\u0db8\u0dcf\u0daf\u0dda \u0db8\u0dba\u0dc3\u0dd4\u0dd2\u0dba\u0db8\u0dcf\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0dcf\u0dca\u200d\u0db8\u0dba\u0dda\u0da7\u0dca\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0d86\u0dbd\u0daf\u0dba \u0db8collect \u0dd9\u0dba\u0db8\u0d9c\u0db4\u0dd3\u0db8 \u0db8\u0d91\u0dda\u0dc4 \u0db8\u0db1\u0db4\u0dca\u0db1 \u0db8\u0d91\u0dd9\u0dad\u0dd4\u0db8\u0db8\u0dd9\u0dba\u0db8\u0d9c\u0db4\u0dd3\u0db8 \u0db8\u0dda\u0dd9\u0daf\u0dd2\u0db6\u0db8\u0d86\u0dd9\u0daf\u0dba\u0dda\u0dba\u0dca\u0dbd\u0db8\u0dc3\u0dd2\u0daf\u0dca\u0db0\u0db0\u0db8\u0dc0\u0dd4\u0dda\u0dab\u0dca\u0da9\u0db8\u0d9a\u0dd2\u0dba\u0db1\u0db8\u0d91\u0dd9\u0db8\u0db4\u0dd2\u0dc5\u0dd2\u0dbb\u0dc4\u0dcf\u0dca\u0db8 \u0db8 \u0dc0\u0d9a\u0dca\u0dc0\u0db8\u0dd9\u0dba\u0dca\u0db1\u0db8\u0d95\u0db1\u0dd1.\u0db8202]\u0db8\u0dcf\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0dda \u0dd3\u0db1\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dda\u0d9c\u0dcf\u0dca\u0db1\u0dca\u0db8\u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0db8\u0dba\u0db4\u0dc4\u0db4\u0dba\u0db8\u0dc4\u0db4\u0dad\u0db1\u0db8\u0dca\u200d\u0dbd\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0db4\u0dca\u200d\u0dbb \u0daf\u0dda\u0dba\u0db8\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8\u0db8\u0dd2\u0dd2\u0db1\u0dba\u0db1\u0db811 000\u0d9a\u0dca\u0dc0.\u0db8\u0dd2\u0dd2\u0dca \u0db8\u0dda \u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dbd\u0db4\u0dca\u200d\u0db8 \u0d9a\u0dca\u0dc0\u0dd2 \u0dca\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0db8\u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0dca\u0db8\u0d91\u0dcf\u0db4\u0dd2\u0dba\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dba\u0db4\u0dc4\u0db4\u0dba\u0db8\u0dc4\u0db4\u0dbb\u0dd3 \u0db8\u0dcf\u0dc5\u0d9a\u0dca\u0dc0\u0dcf\u0daf\u0db8\u0d9c\u0dca\u0db1\u0db8\u0dc0 \u0dd2\u0db6\u0db8\u0d85\u0db4\u0dd2\u0db8\u0d8b\u0dca\u0dc3\u0dca\u0daf\u0dc4\u0db8\u0dd9\u0dba\u0dca\u0dda\u0dca.\u0db8\u0d92\u0db8\u0dcf\u0daf\u0dda \u0db8\u0db8\u0dda \u0db8\u0dc4\u0dba\u0dc4\u0daf\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dba\u0db4\u0dad\u0dba\u0daf\u0dca\u200d\u0db1\u0dba\u0dca\u0db8\u0dd9\u0daf\u0dbb\u0dca\u0dba\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8 \u0dcf\u0db8\u0dc3\u0dd2\u0daf\u0dd4\u0db8\u0dcf\u0db1\u0dcf\u0daf\u0db8\u0dcf\u0daf\u0dda \u0db8\u0dba\u0dda\u0da7\u0dca\u0db8\u0d86\u0dbd\u0daf\u0dba \u0da7 \u0db8\u0dc3\u0dca\u0db4\u0dca\u200d\u0d9a\u0dd2\u0dba\u0db8\u0dd4\u0dad\u0dad\u0dd4\u0db8\u0db8\u0dda\u0dd9\u0daf\u0da7 \u0dc3\u0dca\u0d9a\u0dca\u0dc0\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dc4\u0dba\u0dc4\u0daf\u0db8\u0d85\u0dba\u0da7 \u0db8\u0dca\u200d\u0dbb\u0daf\u0db8\u0d9c\u0dca\u0db1\u0dca\u0db8\u0db4\u0dd4\u0dc5\u0dd4\u0dcf\u0dca\u0db8\u0dcf\u0db1\u0dcf\u0daf.\u0db8\u0db8\u0d8d\u0da2\u0dd4\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dc3\u0dca\u0dc4\u0db8\u0dcf\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dcf \u0dda\u0dba\u0dca\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0db8\u0dda\u0dbd\u0dd9\u0d9a\u0dca\u0dc0\u0db8\u0dba\u0da7 \u0db8\u0d87\u0dad\u0dd4\u0db8\u0dda\u0dc5\u0dad\u0db8\u0d85\u0dba\u0db8\u0dd9\u0dba\u0db8\u0d9c\u0dca\u0db1\u0dcf\u0daf.\u0db8\u0db8\u0dcf\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dc3\u0dca\u0dad\u0dcf\u0dba\u0d82\u0d9a\u0dca\u200d\u0dbb\u0dd3\u0dba\u0dcf\u0db8-\u0db8auto -\u0db8\u0dba\u0dda\u0da7\u0dca\u0db8\u0da2\u0db1\u0dc0\u0daf\u0dcf\u0db8\u0db7\u0daf\u0dab\u0dca\u0da9\u0db4\u0db8\u0dba\u0db4\u0dad\u0dda\u0db7\u0ddd\u0da2\u0db1\u0dba\u0db8\u0dd9\u0dba\u0db1\u0db8\u0d85\u0dc0\u0dba\u0dad\u0dd4\u0db8\u0dba\u0db8\u0dba\u0dda\u0da7\u0dca\u0db8\u0d86\u0dbd\u0daf\u0dba \u0da7 \u0db8\u0d91\u0dd9\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0db1\u0db8\u0d85\u0dc0\u0dba \u0db8\u0db8\u0d8d\u0da2\u0dd4\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0db8\u0dd2\u0dd2\u0dba\u0dc3\u0dca\u0dad\u0dc3\u0dd4\u0db8\u0dc3\u0dca\u0dad\u0dcf\u0dd9\u0db4 \u0db4\u0dca\u0dda\u0dc0\u0dca\u0db8\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dba\u0dca\u0db8\u0dda\u0dcf\u0dca\u200d\u0daf\u0db8\u0dda\u0d9c\u0dcf\u0dca\u0db1\u0da7 \u0db8\u0d95\u0db1\u0dd1.\u0db8\u0dcf\u0db4\u0da7\u0dd4\u0db4\u0dca\u0db8\u0dda\u0d9c\u0dc0\u0dd3\u0db8\u0dda \u0dd3\u0db1\u0db8\u0db1 \u0db8\u0d92\u0dcf\u0daf\u0db8\u0d85\u0dba\u0db8\u0dd9\u0dba\u0db8\u0d9c\u0db4\u0dd3\u0db8\u0dda \u0db8\u0d9a\u0dca\u200d\u0dbb \u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf.\u0db8\u0db1\u0dd4\u0daf\u0dca \u0db8\u0d85\u0dda\u0db1\u0d9a\u0dca\u0dc0\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dc3\u0dca\u0dad\u0dcf\u0dd9\u0db4 \u0db4\u0dca\u0dda\u0dc0\u0dca\u0db8\u0dda\u0d9c\u0dcf\u0db1\u0db8\u0dc0\u0db4\u0db1\u0da7 \u0db8\u0db8\u0dd2\u0dd2\u0dba\u0dc3\u0dca\u0dad\u0dc3\u0dd4\u0db8\u0db1\u0db4\u0db9\u0dd4\u0dbb\u0dd4\u0db8\u0dd9\u0dba\u0db8\u0d9c\u0dca\u0db1\u0db8\u0d95\u0db1\u0dd1.\u0db8\u0d91\u0dda\u0dc4 \u0db8\u0dc3\u0dca\u0dad\u0dcf\u0dd9\u0db4 \u0db4\u0dca\u0dda\u0dc0\u0dca\u0db8\u0dba\u0dda \u0d9a\u0dd4\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dda\u0d9c\u0dcf\u0dca\u0dda\u0dca\u0db8\u0db1\u0db4\u0dca\u0db1 \u0db8\u0dba \u0db8\u0d9a\u0dd2\u0dc3\u0dd2\u0db8\u0dd3\u0db8\u0dc0\u0dba\u0db1\u0dd4\u0dd6\u0dbd\u0dca\u200d\u0db8\u0dc0\u0dd2\u0d9a\u0dbb\u0dc0\u0dd2\u0db0\u0daf\u0db1\u0db8\u0dba\u0da7 \u0dda\u0dca\u0db8\u0d94\u0dc0\u0dd4\u0dca\u0db8\u0d92\u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0d91\u0dd9\u0d9f\u0db8\u0dd9\u0dba\u0db8\u0d9c\u0db4\u0dd3\u0db8 \u0db8\u0d85\u0dcf \u0dba\u0dd2\u0db6.\u0db8\u0d91\u0dcf\u0db4\u0dd2\u0dba\u0db8\u0dd9\u0daf\u0dbb\u0dca\u0dba\u0dba\u0dca\u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0d85\u0dcf \u0dba\u0db8\u0dd2\u0dba\u0dba\u0daf \u0db1\u0dba\u0db8\u0dc0 \u0dd2\u0db6\u0db8\u0dda \u0db8\u0dc4\u0dba\u0dc4\u0daf\u0db8\u0dc3\u0dd2\u0daf\u0dca\u0db0\u0db0\u0db8\u0dd9\u0dba\u0dca\u0dda\u0dca.\u0db8\n\n1705 1706\n\n\u0dba\u0daf\u0dbb\u0dca\u0dd2\u0db1\u0dda \u0dca\u0dad\u0dd4\u0db8\u0dcf\n\n\u0dcf\u0daf\u0dda \u0db8\u0db4\u0dd4\u0daf\u0dca\u0db0\u0d9c\u0dca\u200d\u0dda\u0dba\u0d9a\u0dd4\u0dda \u0db8\u0dc0\u0d9a\u0dca\u0dc0\u0dda\u0dc3\u0dca\u0dad\u0dbb\u0dd4\u0db8\u0dd9\u0dc5\u0db8\u0dc4\u0db4\u0d9a\u0dd2\u0db8\u0d86\u0dbd\u0daf\u0dba \u0db8\u0d9c\u0dda\u0db1\u0dba\u0db8\u0d9a\u0dd2\u0dbb\u0dd3\u0dda \u0dd3\u0db1\u0db8\u0dbb\u0db4\u0dc4\u0db4\u0dba\u0db8\u0dd9\u0dc5\u0db8\u0dd4\u0dad\u0dad\u0dd4\u0db8\u0db8\u0da2\u0dd3\u0dc0\u0dd2\u0dc0\u0db8\u0dba\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0dda\u0db8\u0d94\u0db4\u0dca\u0db4\u0dd4\u0db8\u0dc4\u0dba\u0dc4\u0daf\u0db8\u0dca\u200d\u0db4\u0dda\u0dbb\u0db1\u0db8\u0dca\u200d\u0db4\u0db6\u0dd3 \u0db8\u0d85\u0db4\u0dd2\u0db8\u0dd2\u0dba \u0dad\u0da0\u0dd2\u0dc0\u0dcf\u0db8\u0dbd\u0d9a\u0dca\u0dc0\u0dcf\u0daf\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf.\u0db8\u0dc0\u0dd2\u0dda \u0dad\u0dc2\u0dca\u0da8\u0dda\u0dba\u0dca \u0db8\u0dba\u0d9a\u0dca\u0dc0\u0dd2\u0dc0\u0db8\u0dc0\u0db4\u0db1\u0db4\u0dca\u0dc0\u0d9a\u0dd4\u0dda \u0db8 \u0dba\u0dda\u0dba\u0db8\u0dc3\u0dd2\u0daf\u0dca\u0db0\u0db0\u0db8\u0dc0\u0dd3\u0db8\u0dda \u0dd3\u0db1 \u0db8\u0d92\u0db8\u0dcf\u0daf\u0dda \u0db8\u0da2\u0dd3\u0dc0\u0dd2\u0dc0\u0db8\u0dba\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0dda\u0db8\u0d94\u0db4\u0dca\u0db4\u0dd4\u0dcf\u0db8\u0dd9\u0dca \u0db8\u0db4\u0dd2\u0dbb\u0dd3\u0dda \u0dd3\u0db1\u0db8\u0dda\u0dc4\u0ddd\u0db8\u0da2\u0dd3\u0dc0\u0dd2\u0dc0\u0db8\u0dba\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0dda\u0db8\u0d94\u0db4\u0dca\u0db4\u0dd4\u0dda\u0dc1\u0db8\u0dba\u0dcf\u0daf\u0dba\u0dda\u0db8\u0d85\u0d9c\u0dba\u0db8\u0d85\u0dca\u0db8\u0dba\u0dca\u0db8\u0dd9\u0dba\u0db8\u0d9c\u0db4\u0dd3\u0db8\u0dda \u0dd3\u0db1\u0db8\u0dca\u200d\u0db4\u0dda\u0dbb\u0db1\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db8\u0dbb\u0daf\u0dd4\u0db8\u0d85\u0dba\u0db8\u0dd9\u0dc5\u0db8\u0dc4\u0db4\u0d9a\u0dd2\u0db8\u0d86\u0dbd\u0daf\u0dba\u0db8\u0dd2\u0dca\u0db8\u0dbb\u0db4\u0dc4\u0db4\u0dba\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0dca\u0db8\u0dda \u0db8\u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0dca\u0db8\u0dd9\u0dba\u0db1\u0dd4\u0db8\u0dca\u200d\u0dbb\u0db1\u0dcf\u0daf.\u0db8\u0d92\u0db8\u0dcf\u0daf\u0dda \u0db8\u0d87\u0dc0\u0db4 \u0db8\u0dda\u0dd9\u0daf\u0dca\u0dda\u0daf\u0dca\u0db0\u0dc3\u0dd2\u0dcf\u0dca\u200d\u0da7 \u0db8\u0dba\u0da7 \u0dca\u0dcf\u0db8\u0db4\u0dd4\u0dda\u0dba\u0db8\u0d86\u0dba\u0dc0\u0db1\u0dcf\u0dca\u200d\u0da7 \u0db8tax credit \u0d91\u0dd9\u0d9a\u0dca\u0dc0\u0db8\u0db4\u0dca\u200d\u0dbb\u0dbd\u0daf\u0db1\u0dba\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0da7 \u0db8\u0dda\u0dd9\u0daf \u0dc3\u0dca\u0daf\u0db4\u0dad\u0dc3\u0dca\u0dad\u0db8\u0da2\u0db1\u0dba\u0daf\u0dca \u0dcf\u0dba\u0dba\u0daf\u0da7 \u0db8\u0dc4\u0db4\u0d9a\u0dd2\u0dba\u0daf\u0dcf\u0db8\u0dca\u200d\u0dbb\u0daf\u0db8\u0dd3\u0db1 \u0dca\u0db8\u0dda \u0db8\u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0dca\u0db8\u0dc3\u0dd2\u0daf\u0dd4\u0db8\u0dcf\u0db1\u0dcf\u0daf.\u0db8\u0dda \u0dca\u0db1\u0db8\u0dda \u0db8\u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0da7 \u0db8\u0d9c\u0dca\u0dc0\u0daf \u0db8\u0d86\u0dbd\u0daf\u0dba \u0db8\u0dbb\u0daf\u0dd4\u0dcf\u0dca\u200d\u0da7 \u0db8\u0d85\u0dbd\u0daf\u0dc5\u0dcf\u0db8\u0dba \u0db8\u0dba \u0db8\u0dd2\u0dba\u0dbd\u0dc4\u0dc3\u0dca\u0dad\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0db8\u0dcf\u0daf\u0dda \u0db8\u0dba \u0db8\u0d9a\u0dd2\u0dc3\u0dd2\u0db8\u0dd2\u0dba\u0dba\u0daf \u0db1\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0d87\u0dd2\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0dca\u0db8\u0dda \u0db8\u0dba\u0db1\u0dc0\u0db8\u0dad\u0dd4\u0db8\u0dc5\u0dd2\u0dca\u0db8\u0d85\u0db4\u0dd2\u0db8\u0dbb\u0dca\u200d\u0daf\u0dda\u0dba\u0daf\u0dda\u0dba\u0daf\u0dca\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0db1\u0dcf\u0daf.\u0db8"
