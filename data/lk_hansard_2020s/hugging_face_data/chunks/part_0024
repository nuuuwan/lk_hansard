    "chunk_text": "\u0d9a\u0dd2 \u0dbd\u0dad\u0dca\u0dad \u0d9a\u0dd2\u0daf\u0dc0\u0dcf \u0dc0\u0dcf\u0da2\u0d85, \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d9a\u0db1\u0dcf \u0dcf\u0d9a\u0d9a\u0dad\u0dd4\u0dca\u0dcf\u0da2\u0d9c\u0da7 \u0dcf\u0da7\u0da7 \u0d9c\u0dad\u0dca\u0dad\u0dad\u0dcf\u0dca, \u0d91\u0dad\u0dd4\u0dca\u0dcf\u0da2\u0d85 \u0d86\u0da0\u0dcf\u0dbb\u0dca\u0d9a \u0db4\u0dcf\u0dcf\u0dd2\u0d9a \u0da2 \u0dcf\u0dd4 \u0db4\u0dcf\u0dcf\u0dd2\u0d9a \u0db1. \u0d8a \u0d9f\u0da7, \u0daf\u0dba\u0ddd \u0db1 \u0d9a\u0da7\u0dca\u0da7\u0dd2\u0d9a \u0dc3\u0dca \u0dd4 \u0dad \u0dad\u0dd4\u0dbb\u0dd4 \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a \u0dcf. \u0dca\u0dca \u0dcf\u0dd0 \u0db1\u0d9a\u0dcf, \u0daf\u0da2\u0db4\u0dca \u0dd4\u0dcf\u0da2\u0dba \u0dcf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1 \u0d87\u0dca\u0dad\u0dd2\u0dad\u0dd4\u0dca\u0dcf \"\u0dca \u0dcf\u0da0\u0dcf\u0dbb\u0dca\u0d9a\" \u0d9a\u0dd2\u0d9a \u0dad \u0dad\u0dd4\u0dd4 \u0dcf\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0d9a \u0dcf. \u0d91\u0dad\u0dd4\u0dca\u0dcf \u0dba\u0ddd\u0da2\u0d9a\u0db1\u0da2 \u0d9a \u0d9a\u0dd4 \u0dd4\u0dcf\u0da2\u0dba \u0dcf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1 , \u0dcf \u0dcf\u0dad\u0dca\u0dad \u0dc3\u0db7\u0dcf \u0dc3 \u0dcf \u0dcf\u0dad\u0dca\u0dad \u0dcf\u0dcf\u0db1 \u0daf\u0dca\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dc1\u0da2\u0dda \u0da2 \u0dc3\u0d9a\u0dda\u0da7 \u0dc3\u0dd4\u0daf\u0dca\u0db0\u0db1 \u0dc0\u0dd4\u0dab\u0dcf \u0dd2\u0dc5\u0dd2\u0d9a \u0db1 \u0d9c \u0da7 , \"\u0daf\u0dcf \u0daf\u0dd2 \u0dc3\u0dd4\u0da7 \u0dd4\u0dcf\u0da2\u0dba \u0dcf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1 \u0daf\u0dca\u0dcf\u0dad\u0dba\u0dad\u0dd4\u0dca\u0dcf\u0da7 \u0db8\u0dca \u0dcf\u0da0\u0dcf\u0dbb\u0dca\u0d9a\u0db8 \u0db8\u0dd2\u0da7 \u0dcf\u0da7\u0dca\u0da7\u0dca \u0db1 \u0dd0\u0dad\u0dd2 \u0dc0 \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0d9a\u0dd4 \u0dc3\u0db1\u0d9a\u0da7 , \u0d92 \u0dba\u0ddd\u0dc3\u0dcf \u0d86\u0da2\u0d9a\u0dad\u0dca\u0dad \u0db8\u0dca \u0dcf\u0da0\u0dcf\u0dbb\u0dca\u0d9a\u0db8 \u0d9a\u0dd2\u0d9a\u0da7 \u0d91\u0dcf\u0dcf\" \u0d9a\u0dd2\u0d9a\u0db1\u0dcf. \u0d92\u0d9a \u0dca\u0dcf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca \u0d9a \u0db1 \u0da2\u0da7 . \u0db1\u0d82\u0d9a\u0dcf \u0db1\u0dad\u0dd2 \u0dcf\u0dc3\u0da2\u0dda \u0d9a\u0dc0\u0dcf\u0dcf\u0dc0\u0dad\u0dca\u0dad \u0daf\u0dca\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dc1\u0d9a\u0d9a \u0da2 \u0dc3\u0d9a\u0dda\u0dc0\u0dd4\u0da2\u0d9a \u0db1 \u0db1\u0d82\u0d9a\u0dcf\u0da2\u0daf \u0db4\u0dd4\u0dc0\u0dad\u0dca\u0dad \u0dcf\u0dad\u0dca\u0dad\u0dc0\u0db1\u0da7 \u0dba\u0ddd\u0da2\u0daf\u0dcf \u0d9a \u0db1 \u0dba\u0ddd\u0d9a\u0dd4\u0dad\u0dca\u0dad \u0d9a\u0dd4\u0db1\u0dcf \u0dd0 \u0dd0 \u0da2\u0da7 , \u0da2\u0dca\u0dad\u0dd4\u0dca\u0dcf\u0da7 \u0daf\u0dcf \u0db1\u0db3\u0db1\u0dcf \"\u0dca \u0dcf\u0da0\u0dcf\u0dbb\u0dca\u0d9a\" \u0d9a\u0dd2\u0d9a\u0da7 \u0d91\u0dcf\u0dcf \u0d9a\u0dd2\u0d9a\u0db1\u0dcf. \u0d87\u0dd2\u0db1, \u0dd0\u0dad\u0dd2 \u0dad \u0dad\u0dd4\u0dd4 \u0db1 \u0d91\u0da2 \u0dca \u0dcf\u0dcf\u0dc0\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0da2 \u0dca? \u0d92 \u0dba\u0ddd\u0dc3\u0dcf \u0dca\u0dca \u0d9a\u0dd2\u0d9a\u0da7 \u0d9a\u0dd0\u0dca\u0dad\u0dd2\u0dd2\u0db1, \u0daf\u0dc5\u0dd2 \u0da2\u0dda\u0d9a \u0daf\u0dc0\u0dc3\u0da7 \u0d9a\u0dd4\u0da7 \u0db1 \u0db8 \u0dc0. \u0daf\u0dba\u0ddd\u0dc0\u0dcf\u0dbb\u0dca\u0d9a\u0da2\u0d9a\u0da7 \u0dca\u0dca \u0d92 \u0d9a\u0dcf\u0dd4\u0dab\u0d9a \u0dca\u0dad \u0db1 \u0d9a\u0dd4 \u0dc0\u0dcf.\n\n\u0d8a \u0d9f\u0da7, \u0dca\u0dca \u0dc4\u0dd2\u0dad \u0dc0\u0dd2\u0dd2\u0d9a\u0da7 \u0daf\u0db8\u0dad\u0d9a\u0dcf\u0da0 \u0dcf\u0dd2\u0d9a\u0dd4\u0dab\u0da2\u0dda \u0d9c\u0da2\u0da7 \u0da2\u0dcf\u0dcf\u0db1 \u0dc0\u0dd2\u0dba\u0ddd\u0db1\u0dca\u0dbb\u0dd4\u0dad\u0dd4\u0dca\u0dcf \u0d8a\u0da2\u0dda \u0da2 \u0db1 \u0daf\u0dcf \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0dca \u0d9c\u0dad\u0dca\u0dad\u0dad\u0dcf. \u0d91\u0dad\u0dd4\u0dca\u0dcf\u0da2\u0d85 \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0dca \u0d9a\u0db8\u0dca\u0dad\u0dca\u0dad \u0d91 \u0db1\u0d9a \u0daf\u0db8\u0dad\u0d9a\u0dcf\u0da0 \u0dcf\u0dd2\u0d9a\u0dd4\u0dab\u0da2\u0dda \u0dc0\u0dd2\u0dba\u0ddd\u0dc1\u0dca\u0da0\u0d9a\u0d9a\u0dcf\u0dd4\u0dc0\u0dbb\u0dd4 3\u0da2\u0dcf\u0da2 \u0d9a\u0dd4\u0da2\u0d85 \u0db4\u0dd4\u0dd4\u0db4\u0dca\u0dcf\u0dcf\u0da9\u0dd4 \u0dad\u0dd2\u0da2 \u0dc0\u0dcf. \u0da2\u0dda \u0dc0\u0dd2\u0dba\u0ddd\u0dc1\u0dca\u0da0\u0d9a\u0d9a\u0dcf\u0dd4 \u0dad \u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dd4\u0dd4\u0dc0\u0da7 \u0da2\u0da7 \u0dd0\u0daf\u0dca\u0db0\u0dcf? \u0daf\u0da2\u0db4\u0dca \u0dc0\u0dba\u0dc0\u0dc3\u0dca\u0db1\u0dcf\u0dcf\u0dcf\u0d9a\u0d9a \u0dc3\u0db7\u0dcf\u0dc0 \u0db1\u0dcf\u0da2\u0d9c \u0db1\u0da7 \u0dc0\u0dcf, \u0d92 \u0dda \u0da7\u0dd2\u0d9a \u0d91 \u0d9a\u0dda. \u0da2 \u0dcf\u0dd2\u0dcf\u0dad\u0dd2\u0dad\u0dd4\u0dca\u0dcf\u0da2\u0d9c\u0da7 \u0daf\u0dc5\u0dd2 \u0daf \u0da7 \u0da2\u0da7 \u0da2\u0dda\u0d9a\u0dd2\u0db1. \u0dc0\u0dd2\u0d9a\u0da7\u0dca \u0dcf\u0dca\u0da2\u0dda \u0da2 \u0dcf\u0dd2\u0dcf\u0dad\u0dd2\u0dad\u0dd4\u0dca\u0dcf \u0d87\u0dc0\u0dd2 \u0dc3\u0db1\u0dcf \u0dcf\u0dcf\u0dbb\u0dca\u0dd2\u0da2\u0dda\u0da7 \u0dad\u0dd4\u0da2\u0daf \u0d9a\u0db1\u0dcf \u0d9a \u0dcf\u0da7 \u0dd2\u0dc3\u0d9a\u0da7 \u0da2\u0da7 \u0dd0 \u0dd0. \u0da2\u0dda \u0dd4\u0da2\u0da7\u0dca \u0da2\u0dc1\u0dca\u200d\u0dbb\u0dca\u0dad\u0dca\u0da8\u0dcf\u0dd2\u0d9a\u0dd4\u0dab\u0da2\u0dda \u0dc0\u0dd2\u0dba\u0ddd\u0dc1\u0dca\u0da0\u0d9a\u0d9a\u0dcf\u0dd4\u0dad\u0dd4\u0dca\u0da7 \u0db1\u0dcf 5\u0da2\u0dcf\u0da2 \u0d9a\u0dd4\u0da2\u0d85 \u0db4\u0dd4\u0dd4\u0db4\u0dca\u0dcf\u0dcf\u0da9\u0dd4 \u0da2\u0dda \u0da2\u0dc0 \u0da2\u0d9a\u0dcf\u0da7 \u0dad\u0dd2\u0da2 \u0dc0\u0dcf. \u0dcf \u0dd4\u0dc4\u0dc0\u0dd0\u0dba\u0ddd \u0db4\u0dd4\u0dd4\u0db4\u0dca\u0dcf\u0dcf\u0da9\u0dd4\u0dc0 \u0d87\u0dad\u0dd2 \u0da2\u0dc0\u0db1\u0dcf \u0dca\u0dcf\u0dc3 6\u0d9a\u0da7 \u0dc0\u0dd0\u0da9\u0dd2\u0d9a\u0dcf\u0dd2\u0db1. \u0d8a \u0d9f\u0da7, \u0daf\u0db8\u0dad\u0d9a\u0dcf\u0da0 \u0dcf\u0dd2\u0d9a\u0dd4\u0dab\u0da2\u0dda \u0dc0\u0dd2\u0dba\u0ddd\u0dc1\u0dca\u0da0\u0d9a\u0d9a\u0dcf\u0dd4\u0dc0\u0dbb\u0dd4 3\u0da2\u0dcf\u0da2 \u0d9a\u0dd4\u0da2\u0d85 \u0db4\u0dd4\u0dd4\u0db4\u0dca\u0dcf\u0dcf\u0da9\u0dd4 \u0dad\u0dd2\u0da2 \u0dc0\u0dcf. \u0dca \u0dcf\u0dd2\u0d9a\u0dd4\u0dab \u0dc0\u0dd2\u0dba\u0ddd\u0dc1\u0dca\u0da0\u0d9a\u0d9a\u0dcf\u0dd4\u0dad\u0dd4\u0dca\u0da7 \u0db1\u0dcf \u0db1\u0dcf\u0da2\u0d9c \u0db1\u0da7 \u0dc0\u0dcf, \u0d8a \u0d9f\u0da7 \u0db1\u0daf\u0dd2\u0dd2\u0dc3\u0d9a\u0da7 \u0d9a\u0da7 . \u0d8a \u0d9f\u0da7,\n\n\u0daf\u0db8\u0dad\u0d9a\u0dcf\u0da0 \u0dcf\u0dd2\u0d9a\u0dd4\u0dab\u0da2\u0dda - Court of Appeal\u0dc4\u0dd2 - \u0dc0\u0dd2\u0dba\u0ddd\u0dc1\u0dca\u0da0\u0d9a\u0d9a\u0dcf\u0dd4\u0dad\u0dd4\u0dca\u0da7 \u0db1\u0dcf \u0db1\u0dcf\u0da2\u0d9c \u0db1\u0da7 \u0dc0\u0dcf, Supreme Court \u0d91\u0d9a\u0da7 \u0d9a\u0da7 . \u0d92 \u0daf\u0d9a\u0da7 \u0dc0\u0d9a\u0dc3 \u0d9c\u0dd2\u0d9a\u0dc4\u0dd2 \u0dc3\u0db1\u0dcf \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0dca \u0d9c\u0da7 \u0dad\u0dd4\u0dbb\u0dd4 \u0dcf \u0da2\u0dda \u0db1\u0dcf\u0da2\u0d9c \u0db1\u0da7 \u0da2\u0da7 ?"
  },
