0dc0\u0db1 \u0d9a \u0dba\u0dd4\u0dad\u0dca\u0dad \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf0\n\n\u0d8a\u0dc5\u0d9f \u0dd2\u0db1\u0dc0\u0db6\u0dca\u0dc0\u0dca 2482/12 \u0daf\u0dbb\u0db1 \u0d85\u0dd2\u0db1 \u0dc0\u0dd2\u0dc0\u0d9b\u0db4\u0dc2 \u0db8\u0dd0\u0dca\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dda \u0db4\u0dc5 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd6 2026 \u0d85\u0d9c\u0d9a 03 \u0daf\u0dbb\u0db1 \u0d86\u0db1\u0dba\u0db1 \u0dc4\u0dc3\u0dcf \u0d85\u0db4\u0db1\u0dba\u0db1 \u0dc1\u0db4\u0dcf\u0dbd\u0db1 \u0dc0\u0dbb\u0d9c\u0dd4\u0dbd\u0dcf\u0dc3\u0dd20 \u0dca\u0dc4\u0dc3\u0dbd\u0dca \u0d86\u0db1\u0dba\u0db1\u0dba \u0dca\u0db3\u0dc4\u0dc3\u0dcf \u0dc0\u0db1 \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0dca\u0db1\u0db6\u0dca\u0db0\u0dc0\u0dba\u0dca \u0dc0\u0db1 \u0dc0\u0dbb\u0d9c\u0dd4\u0dbd\u0dcf\u0dc3\u0dd20 \u0dca\u0dc4\u0dc3\u0dbd\u0dca \u0d86\u0db1\u0dba\u0db1\u0dba \u0dad\u0dc4\u0dc3\u0db1\u0db1 \u0d9a\u0dbb\u0dbd\u0dcf \u0dd2\u0db1\u0db6\u0dd4 \u0dcf0 \u0db1\u0db8\u0dd4\u0dad\u0dca \u0db1\u0dd2\u0d9b\u0db4\u0dd2\u0d9a\u0dad \u0d85\u0dc0\u0d9b\u0dba\u0dad\u0dcf\u0dc0\u0d9a\u0daf\u0dd3 \u0db1\u0dd2\u0d9b\u0db4\u0dd2\u0d9a\u0dad \u0dca\u0dc4\u0dc3\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf \u0dba\u0dca \u0d86\u0db1\u0dba\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dd0\u0db1\u0dd3\u0db8 \u0dca\u0db3\u0dc4\u0dc3\u0dcf \u0d86\u0db1\u0dba\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0dc0\u0db1 \u0d9a\u0dcf\u0dbd \u0db4\u0dd2\u0dba\u0da0\u0dca\u0da0\u0dd4\u0dc0\u0dda\u0daf\u0dba\u0dad\u0dca \u0d92\u0dc0\u0dcf \u0dbd\u0d9c\u0d9a\u0dcf\u0dc0 \u0dc5\u0d9f\u0dcf \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dcf\u0dbd \u0db4\u0dd2\u0dba\u0da0\u0dca\u0da0\u0dd4\u0dc0\u0dda\u0daf\u0dba\u0dad\u0dca \u0d87\u0dad\u0dd4 \u0dc5\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dc0\u0dbb\u0d9c\u0dd4\u0dbd\u0dcf\u0dc3\u0dd2 \u0da7\u0dd2\u0d9a\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d91\u0dc4\u0dd2 \u0dd2\u0db1\u0dc0\u0db6\u0dca\u0dc0\u0dca0 \u0d92 \u0d9a\u0dcf\u0dbb \u0dcf \u0dad\u