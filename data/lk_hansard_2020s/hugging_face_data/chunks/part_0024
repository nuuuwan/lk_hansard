    "chunk_text": "\u0b87\u0bb1\u0b95\u0bcd\u0b95\u0bbe\u0bae\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0b9a\u0ba4\u0b9a \u0baa\u0b9a\u0baf\u0bb2\u0bbe\u0bc8\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0b86\u0bb1\u0bcd\u0bb1\u0bc1 \u0bae\u0ba3\u0bcd \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0baf\u0bbe\u0baa\u0bbe\u0bb0\u0ba4\u0bcd\u0b95\u0ba4 \u0b9a\u0bae\u0bb1\u0bcd\u0baa\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1 \u0bb5\u0ba8\u0bcd\u0ba4 9 \u0b9a\u0baa\u0bbe\u0bbf\u0bc8\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bbf\u0bb2 \u0bb5\u0bb0\u0bc1\u0b9f \u0b95\u0bbe\u0bb2\u0bae\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0b95\u0bae \u0b95\u0bbe\u0bb0\u0bc8\u0bae\u0bbe\u0b95 \u0b87\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1\u0b9a\u0bcd \u0baa\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1, \u0ba4\u0bb1\u0bcd\u0b9a\u0baa\u0bbe\u0ba4\u0bc1 \u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0ba8\u0baa\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0bb5\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bc8\u0ba4\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0baf \u0bae\u0bc1\u0b9f\u0bbf\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b85\u0ba4\u0bbe\u0bb5\u0ba4\u0bc1, \u0b85\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0ba9\u0bcd\u0bb1\u0bbf \u0b9a\u0bb5\u0bb1\u0bc1 \u0baa\u0bb2 \u0baa\u0bbf\u0bb0\u0b9a\u0ba4\u0b9a \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0bb5\u0bcd\u0bb5\u0ba9\u0bc1\u0bae\u0ba4\u0bbf \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b8e\u0bc8\u0b9a\u0bb5, \u0baa\u0b95\u0bcc\u0bb0\u0bb5 \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0ba4\u0bc1 \u0bb5\u0bbf\u0b9f\u0baf\u0bae\u0bbe\u0b95 \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95 \u0b85\u0ba4\u0bbf\u0baa\u0bb0\u0bcd, \u0baa\u0bbf\u0bb0\u0b9a\u0ba4\u0b9a \u0baa\u0b9a\u0baf\u0bb2\u0bbe\u0bc8\u0bb0\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0bbe\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u0bb0\u0bcd\u0b95\u0bc8\u0bbf\u0ba9\u0bcd \u0b9a\u0b95\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0b95\u0b95\u0baf \u0bae\u0bc0\u0bb3\u0bcd\u0baa\u0ba4\u0bbf\u0bb5\u0bc1 \u0baa\u0b9a\u0baf\u0bcd\u0baf \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0b95 \u0b8e\u0b9f\u0bc1\u0b95\u0bcd\u0b95 \u0b9a\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0baa\u0bae\u0bc8\u0b95\u0bcd \u0b9a\u0b95\u0b9f\u0bcd\u0b9f\u0bc1, \u0bb5\u0bbf\u0b95\u0b9f \u0baa\u0baa\u0bb1\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0b9a\u0bb1\u0ba9\u0bcd. \u0ba8\u0ba9\u0bcd\u0bb1\u0bbf!\n\n\u0db8\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0d9a\u0dcf\u0dbb\u0d9a \u0dca\u0db7\u0dcf \u0dca\u0db7\u0dcf\u0db4\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0dd2\u0dba\u0db1\u0dd2 \u0d87\u0dad\u0dca\u0dad \u0db8 \u0db8\u0dad\u0dca\u0dc0\u0dad\u0dcf\u0dad\u0dca \u0d85\u0dc0\u0dca \u0dbb\u0dc0\u0dca \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0d85\u0dc0\u0dd4\u0db1\u0dca\u0daf\u0dd4 4.0\u0dca \u0dd2\u0db1\u0dca\u0db4\u0dc0\u0dca\u0db4 \u0db4\u0dca\u0dad\u0dd4 \u0dd3\u0dad\u0dc3\u0dd2\u0dca \u0dbd\u0dca\u0dc0\u0daf\u0dca\u0dc3\u0dd2\u0dca \u0dca\u0d9c\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0dc3\u0dd2\u0dca \u0dba \u0dc0\u0dad\u0dca \u0dc0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0d9a\u0dcf\u0dbb \u0db4\u0dcf\u0dbd\u0db1\u0dba\u0dca \u0dba \u0dc0\u0dc0\u0da0\u0dca\u0da0\u0dd4 \u0dca\u0dd0\u0d9a\u0dba \u0db6\u0dd2\u0dba \u0dbd\u0dca \u0dc0\u0dc0\u0da0\u0dca\u0da0\u0dd4 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0dca0 \u0d92 \u0dc0\u0dd2\u0dad\u0dbb\u0dca \u0dc0\u0db1\u0dcf\u0dc0\u0dc0\u0dba\u0dd20 \u0d85\u0dc0\u0dd4\u0db1\u0dca\u0daf\u0dd4 76\u0d9a \u0db4\u0dcf\u0dbd\u0db1\u0dba\u0dca \u0dba \u0dc0\u0dad\u0dca \u0dc0\u0daf\u0dca\u0dc0\u0dcf\u0dbd\u0dc0\u0dbd \u0dc0\u0dcf\u0dc0\u0dc3 \u0dc0\u0db8\u0dde\u0dbb\u0dc0\u0dc0\u0dba\u0dca \u0dc0\u0dd0\u0db3 \u0db4\u0dd4\u0daf\u0dcf\u0dc0\u0db8\u0db1 \u0dc4\u0dd2 \u0db4\u0dd4 \u0db1\u0dcf\u0dba\u0d9a\u0dc0\u0dba\u0ddd \u0dad\u0db8\u0dca\u0dc0\u0dc3\u0db8 \u0d94\u0dc5\u0dd4\u0dc0 \u0d85\u0dad \u0dc0\u0dc4\u0dc3\u0ddd\u0daf\u0db4\u0dd4 \u0dc4\u0dc3\u0dd0\u0da7\u0dd2 \u0daf\u0dd0\u0d9a\u0dbd\u0dcf \u0dca\u0dd0\u0d9a\u0dba \u0db6\u0dd2\u0dba \u0db4\u0dad\u0dca \u0dc0\u0dc0\u0da0\u0dca\u0da0\u0dd4 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0dca \u0dca\u0dca\u0dc0\u0dca0 \u0dca\u0db1\u0db4\u0dd6\u0dca \u0dc0\u0dba\u0dca \u0db8\u0dad\u0dca\u0dad\u0dcf\u0db8 \u0d85\u0dc0\u0dd4\u0db1\u0dca\u0daf\u0dd4 \u0db4\u0dca\u0dc3\u0dd2\u0dba \u0db8 \u0db1\u0dca \u0dd2\u0db1\u0dca\u0db4\u0dc0\u0dca\u0db4 \u0dca\u0dd0\u0d9a\u0dba \u0db6\u0dd2\u0dba \u0db4\u0dad\u0dca \u0dc0\u0dc0\u0da0\u0dca\u0da0\u0dd4 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0dc0\u0dca \u0dbb\u0dc0\u0dca \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc00 \u0d85\u0dc0\u0dca\u0dcf\u0db1\u0dc0\u0dda \u0d91\u0dc0\u0dc4\u0dc3\u0db8 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0d91\u0d9a\u0dad\u0dd4 \u0dc0\u0dc0\u0dbd\u0dcf \u0dbb\u0dd0\u0dc0\u0dd3.\u0db8 \u0dbd\u0dca \u0dc0\u0dc0\u0dca\u0dc0\u0dca \u0db1\u0dd0\u0dad\u0dd4 \u0dc0 \u0d85\u0dd4 \u0dad\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a \u0dc0\u0db1 \u0dbb \u0db4\u0dad\u0dca \u0d9a\u0dbb \u0db8\u0dad\u0dca\u0dad\u0dcf0\n\n\u0d92 \u0d9a\u0dae\u0dcf\u0dc0 \u0d91\u0dc0\u0dc4\u0dc3\u0db8 \u0dd2\u0db1\u0db6\u0dd2\u0dba\u0daf\u0dd3 \u0db6\u0dd2\u0dba \u0dca\u0dd0\u0d9a\u0dba \u0dc0\u0dcf\u0dc0\u0dc3 \u0dc0\u0daf\u0dca\u0dc0\u0dbd\u0dca \u0dad\u0db8\u0dca\u0dc0\u0dc3 \u0d87\u0d9f \u0dda\u0dbb\u0dcf \u0db8\u0dad\u0dca \u0db4\u0dd3\u0da9\u0dcf\u0dc0 \u0db4\u0dad\u0dca \u0dc0\u0dc0\u0da0\u0dca\u0da0\u0dd4 \