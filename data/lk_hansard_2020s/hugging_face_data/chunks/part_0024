    "chunk_text": "\u0da2\u0dda \u0d9a\u0dbb\u0dd4\u0dc3\u0dd4 \u0db1\u0daf\u0dd2\u0dd2\u0dc3\u0dcf\u0dad\u0dca\u0dad \u0d9a\u0dd4 \u0daf\u0dc0\u0dc3\u0dca\u0db1\u0dcf\u0da2\u0daf\u0daf\u0dd3 \u0da2\u0dda \u0d9a\u0dcf\u0dd4\u0dab\u0d9a\u0dad\u0dca\u0dad \u0dca\u0dca \u0d9a\u0dd2\u0d9a\u0da7 \u0db1 \u0db8. 2016 \u0dc0\u0dc3\u0da2\u0dbb\u0dca \u0dca\u0dca \u0dd4\u0dc4\u0dcf \u0dc3 \u0d87\u0dca\u0dad\u0dd2\u0dc0\u0dd4\u0d9a\u0dcf \u0dc0\u0dc1\u0da2\u0d9a\u0da7 \u0dc3\u0dd4\u0da7\u0dd2\u0d9a\u0daf\u0dd3, \u0dc0\u0dd2\u0da2\u0dcf\u0dc3\u0dca\u0d9c\u0dad \u0dc0 \u0daf\u0d9a\u0da7 \u0db1\u0dd0\u0db6\u0dd2\u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0daf\u0dc0\u0dca \u0dc0\u0dd0\u0da7\u0dd4\u0dcf \u0da2\u0da9\u0dcf \u0dcf\u0db1\u0dbb\u0dca 350 \u0db1 \u0da2\u0db1\u0dc3 \u0dad\u0dd3\u0dd4\u0dab\u0d9a \u0d9a\u0dd4 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf. \u0d92 \u0dc3\u0dda \u0da7 \u0db1\u0da2\u0d9a\u0da7 \u0db8\u0dd3\u0da7 \u0dca\u0dcf\u0dc3 \u0d9a \u0dad\u0d9a\u0da7 \u0da2\u0dcf\u0dd4 \u0dc0\u0dd2\u0dad\u0dba\u0dad \u0da2 \u0dca\u0dd4\u0dad\u0dca\u0dad \u0d87\u0dca\u0dad\u0dd2\u0dad\u0dd4\u0dca\u0dcf\u0da2\u0d9c\u0da7 \u0dc3 \u0daf\u0dca\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dc1\u0da2\u0d9a\u0da7 \u0dca\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca \u0d9a \u0db1 \u0d87\u0dd4\u0dab\u0dc0\u0dcf\u0dca \u0da2\u0dcf \u0dbd\u0dab\u0dcf, \u0d9a\u0dda \u0d9a\u0dda \u0da2\u0daf\u0dca\u0db0\u0dc0 \u0dc3 \u0d9a\u0dd4\u0da2\u0d9c \u0d9a \u0dc0. \u0dd4\u0dc4\u0dad\u0dca\u0dad, \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0da7 \u0dad\u0dd4\u0dda \u0db1 \u0db1\u0dca \u0da7 \u0d92 \u0daf\u0dc0\u0dca \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0db4\u0dca\u200d\u0dbb\u0dca\u0dcf\u0dab\u0d9a \u0db1 \u0dcf \u0daf\u0dd3\u0dca \u0dc3\u0dda \u0da7 \u0db1\u0da2\u0d9a\u0da7 \u0dad\u0dd3\u0dd4\u0dab\u0d9a \u0db1 \u0d9c\u0da7 . \u0da2\u0dca\u0dcf\u0d9a\u0dcf, \u0da2\u0dda\u0d9a \u0da2\u0da7 \u0dcf\u0dcf\u0db1\u0da2\u0dda, \u0dc5\u0dd2\u0dd2\u0db4\u0dd3 \u0da2\u0dda, \u0db1\u0da7 \u0daf\u0dd2\u0d9a\u0dcf\u0da2\u0daf \u0dc3\u0dcf\u0dbb\u0dca\u0db1\u0d9a\u0dc0 \u0d9a\u0dd4 \u0dc0\u0dcf. \u0db1\u0d82\u0d9a\u0dcf\u0da2\u0daf \u0daf\u0dc5\u0dd2 \u0dc5\u0dd2\u0da7 \u0dd4\u0da7 \u0da7 \u0d9a\u0da7\u0dca\u0da7\u0dd2\u0d9a \u0d9a\u0dc0\u0da7 \u0db1 \u0db8 \u0dba\u0ddd\u0dc3\u0dcf \u0d94\u0da2 \u0dca \u0db1 \u0db8 \u0dd4\u0da7\u0d9a\u0da7 \u0d9a\u0dc0 \u0d91\u0d9a \u0daf\u0dc3\u0dcf\u0db1\u0dcf\u0dd4\u0dab\u0dd2\u0db1. \u0da2\u0dca\u0dc4\u0dd2\u0daf\u0dd3 \u0dbb\u0dd4\u0dc5\u0dd2\u0d9a\u0db1 \u0daf\u0dc0\u0db4\u0dca\u200d\u0dbb\u0dca\u0dcf\u0dab \u0dc0\u0dd3\u0dca \u0d9a\u0dda \u0dc0\u0dcf\u0dc3\u0dd4\u0d9a \u0db1 \u0dc0\u0dd4\u0dab\u0dcf\u0da7, \u0da2 \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0da2\u0dda \u0d9a\u0dca\u200d\u0dbb\u0d9a \u0dc1 \u0db1\u0dad\u0dd2\u0d9a \u0daf\u0da9\u0dd4 \u0da2\u0dc0\u0db1\u0dcf \u0dad\u0dd2\u0da2 \u0dc0\u0dcf. \u0db1\u0dad\u0dd2\u0da7 , \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0da7 \u0dad\u0dd4\u0dda \u0daf\u0dcf\u0da7 \u0da2\u0da9\u0dcf \u0dcf\u0db1\u0dbb\u0dca \u0da2\u0d9c\u0da7 \u0d9c\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0da7 \u0dda \u0d92\u0d9a \u0da2 \u0dcf\u0db3\u0dd2\u0db1. \u0da2\u0dda \u0dc3\u0dda \u0da7 \u0db1\u0da2\u0d9a\u0da7 \u0daf\u0da2\u0db4\u0dca \u0dcf\u0daf\u0dca\u0db0\u0db1\u0dad\u0dd2\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dcf\u0dad\u0dca\u0dad\u0dca\u0d9a \u0dc0\u0dd2\u0d9a \u0dba\u0dd4\u0dad\u0dca\u0dad\u0da2\u0dad\u0dca\u0dad \u0daf \u0dad\u0dd4\u0dbb\u0dd4 \u0dc3\u0dd4\u0daf\u0dd4\u0dc0\u0dd3\u0da2\u0dca\u0da7 \u0dcf\u0db1\u0dca\u0dc0 \u0daf \u0dad\u0dd4\u0dbb\u0dd4 \u0dc0\u0dd0 \u0dd0 \u0db1\u0dc0\u0dd3\u0dca\u0da7 \u0da2 \u0dcf\u0da2\u0dc0\u0dd2\u0db1. \u0daf\u0dc5\u0dd2 \u0daf \u0dad\u0dd4\u0dd4 \u0db1 \u0da2\u0dc0\u0da7 \u0db1\u0dc3\u0dca\u0da2\u0dc3 \u0dc3\u0db1\u0dcf \u0dc0\u0dad\u0dca\u0dad\u0dc0\u0dcf \u0d9c\u0da7 \u0db1 \u0db8. \u0d92 \u0dba\u0ddd\u0dc3\u0dcf \u0dad\u0dca\u0dd2\u0db1 \u0dca\u0dca \u0da2\u0dda \u0daf\u0dcf \u0dc3 \u0db1\u0daf\u0dd2\u0dd2\u0dc3\u0dcf\u0dad\u0dca\u0dad \u0d9a\u0dd4\u0da7 \u0da2\u0da7 .\n\n\u0da2\u0da9\u0dcf \u0dcf\u0db1\u0dbb\u0dca \u0db6\u0dd2\u0dd2\u0d9a 8.4\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dca\u0dcf\u0dab\u0d9a \u0db1 \u0dc3\u0d82\u0d9a\u0dca\u200d\u0dbb\u0dca\u0dd2\u0d9a\u0d9a \u0da2\u0dc3\u0dca\u0dc0\u0d9a\u0d9a\u0da7 \u0da2\u0d9c\u0da7 \u0daf\u0dcf\u0da7 \u0db1\u0dd0\u0da2 \u0dc0\u0dcf. \u0dca\u0dca \u0dc4\u0dd2\u0dad \u0dc0\u0dd2\u0dd2\u0d9a\u0da7 \u0dc0\u0dd0\u0da9\u0dd2\u0d9a\u0dcf\u0d9a \u0dc3 \u0d9a\u0da7 \u0db1\u0dc3\u0dca\u0da2\u0dc3 \u0dc3\u0db1\u0dcf \u0da2\u0da9\u0dcf \u0dcf\u0db1\u0dbb\u0dca \u0db6\u0dd2\u0dd2\u0d9a 10 \u0db1 \u0dc0\u0dd2\u0dad\u0dd4 \u0db1 \u0dcf \u0d9c\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0da7 \u0da2\u0dc0\u0dd2\u0db1. \u0d91\u0dc0\u0da7 \u0daf\u0dc0\u0dc3\u0dca\u0db1\u0dcf\u0dc0\u0d9a \u0daf\u0dc5\u0dd2 \u0da2\u0dda \u0da2\u0daf\u0dca\u0db0\u0dc0 \u0dc3 \u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0dd2\u0db1. \u0da2\u0d9a\u0db1\u0dad\u0dba\u0dad \u0d92\u0d9a\u0d9a \u0dc0\u0da7 \u0da2\u0da7 \u0daf\u0dd2\u0dc3\u0dd4 \u0d86\u0dd4 \u0db1\u0dad\u0dab \u0daf\u0d82\u0dc1\u0d9a \u0db1, \u0da2\u0dcf\u0dad\u0dba\u0da7 \u0dad\u0dd4 \u0db1\u0dd3\u0dad\u0dd2 \u0dc3 \u0dcf\u0d9a \u0db1 \u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0da2\u0dda \u0daf\u0d82\u0dc1\u0d9a \u0db1, \u0daf\u0dad\u0dd4\u0dbb\u0dd4\u0dcf \u0da7 \u0dc0\u0dd3\u0dda \u0dc3 \u0dca\u0dd4\u0dab \u0dcf\u0dbb\u0dd3 \u0db1\u0dad\u0dab \u0daf\u0d82\u0dc1\u0d9a \u0db1, \u0dc0\u0d82\u0da0\u0dcf \u0dcf \u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0da2\u0dda \u0dba\u0ddd\u0dbb\u0dd3 \u0db1\u0dad\u0dab \u0daf\u0d82\u0dc1\u0d9a \u0db1, \u0d9a\u0dcf\u0da7 \u0dad\u0dcf \u0dcf \u0dca\u0dcf \u0d86\u0dd4 \u0db1\u0dad\u0dab\u0d9a \u0dc3\u0db3 \u0dcf \u0daf\u0d82\u0dc1\u0d9a \u0db1, \u0dc1\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a\u0d9a\u0da7 \u0d86\u0dd4 \u0db1\u0dad\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0dc3\u0db3 \u0dcf \u0daf\u0d82\u0dc1\u0d9a \u0db1, \u0d86\u0dbb\u0dca\u0dd2\u0d9a\u0d9a \u0d86\u0dd4 \u0db1\u0dad\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0dc3\u0db3 \u0dcf \u0daf\u0d82\u0dc1\u0d9a \u0db1 \u0d9a \u0d92\u0dc0\u0dcf\u0dd2\u0db1. \u0dc0\u0dd2\u0da2\u0daf\u0dca\u0db0\u0dc1\u0d9c\u0dad \u0dc1\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a\u0d9a\u0da7 \u0d86\u0dd4 \u0db1\u0dad\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0dca \u0db4\u0dd4\u0dab\u0dba \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca\u0dad\u0dad \u0db1 \u0da2 \u0dcf\u0dc0 \u0d86\u0dbb\u0dca\u0dd2\u0d9a \u0db4\u0dcf\u0dcf\u0d9a \u0dca\u0dcf\u0dbb\u0dca\u0d9c\u0d9a \u0db1 \u0da2\u0db1\u0dc3 \u0dc3\u0db1\u0d9a\u0da7 \u0dad\u0dca\u0dd2\u0db1 \u0daf\u0dc0\u0dc1\u0dba \u0dc0\u0da7 \u0da2\u0da7 . \u0d92 \u0dc0\u0dcf\u0da2\u0d85\u0dca \u0dad\u0dca\u0dd2\u0db1 \u0da2\u0dc0 \u0dad\u0dca\u0dad \u0dd4\u0da7\u0dc0 \u0dc3, \u0dca\u0dca \u0d9a\u0dd2\u0daf\u0dc0\u0dcf \u0dc0\u0dcf\u0da2\u0d85 \u0dc5\u0dd2\u0dd2\u0db4\u0dd3 \u0d9a, \u0db1\u0da7 \u0daf\u0dd2\u0d9a\u0dcf\u0dc0, \u0da2\u0da7 \u0dcf\u0dcf\u0db1\u0d9a, \u0d82\u0d85\u0db1\u0dcf\u0da2\u0daf\u0dca\u0db0\u0dc1\u0d9a \u0dc3 \u0db1\u0da7 \u0daf\u0dd4\u0db1\u0dd3\u0dc3\u0dd4\u0d9a\u0dcf\u0dc0 \u0daf\u0dc5\u0dd2 \u0dc0\u0dcf\u0da2\u0d85\u0dca \u0daf\u0dd4\u0db4\u0dca\u0dcf\u0dad\u0dca\u0dad \u0dd4\u0da7\u0dc0 \u0dc3. \u0dd4\u0dc4\u0dad\u0dca\u0dad \u0d92\u0da2\u0d9c\u0dcf \u0dc3\u0db1\u0da7 \u0da2\u0dda \u0dc3\u0dda \u0da7 \u0db1\u0da2\u0d9a\u0da7 \u0db1\u0daf\u0dd2\u0dd2\u0dc3\u0da2\u0d9a\u0da7 \u0db1\u0da7 \u0dc0\u0dcf. \u0d92\u0dc0\u0dcf \u0db4\u0dcf\u0da2\u0d9a\u0db1\u0d9c\u0dd2\u0d9a \u0d9a\u0dd4\u0da2\u0d9c"
  },
