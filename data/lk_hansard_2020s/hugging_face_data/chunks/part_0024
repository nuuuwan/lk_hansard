    "chunk_text": "2021 \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0db8\u0dd3 \u0db8\u0dd0\u0daf \u0db7\u0dd2\u0db8\u0db8\u0dd3 \u0dca\u0dbb\u0dca \u0d9a \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf\u0dba\u0d9a\u0dca\u0dc0 \u0db4 \u0db1\u0dca \u0db8\u0db1\u0dca\u0db1 \u0db8\u0d9a\u0dd2 \u0db8\u0db8 \u0db8\u0dda \u0db4\u0dd2\u0dbb\u0dca\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\u0daf\u0dd3 \u0dd2\u0dbb\u0dc0\u0dc0\u0dd2 \u0db8\u0dda \u0dbb \u0db4\u0dd2\u0d9a\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db8\u0db1\u0dca \u0d9a\u0dc5\u0dd4 \u0db4\u0dd2 \u0dc0\u0dda\u0dbb\u0dd4\u0dbd\u0dca\u0db8\u0d9a\u0d9a\u0dca\u0dc0 \u0dd2\u0dbb\u0dba\u0d9a\u0dd2. \u0d92 \u0d9a\u0dc5\u0dd4 \u0db4\u0dd2 \u0dc0\u0dda\u0dbb\u0dd4\u0dbd\u0dca\u0d9a\u0dd2 \u0dbb \u0d82\u0d82\u0db8\u0d9a\u0dd2\u0db8\u0d9a\u0dd2\u0dad\u0dca \u0d9a\u0dbb\u0d9a\u0dd2 \u0db8\u0db8 \u0db4\u0dd2\u0dba\u0db9\u0dd2 \u0d9c\u0dd2\u0dba\u0dd2. 2026 \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0dba \u0dc0\u0db1\u0db8\u0d9a\u0dd2 \u0db8\u0dda \u0dbb \u0db4\u0dd2\u0d9a\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db8\u0db1\u0dca \u0dc4\u0dd0\u0d9a\u0dbb\u0dca\u0d9a\u0dd2 \u0db8\u0dc3\u0da7\u0dca\u0da7 \u0d91\u0d9a\u0dc0\u0dda\u0dba\u0dd2 \u0db8\u0dd4\u0daf\u0d9a\u0dd2\u0dd2\u0d9a\u0dd2 \u0dd2\u0dbb\u0dc4\u0dd2\u0db4\u0db8\u0daf\u0db8\u0db1\u0dc0\u0dda\u0dba\u0dd2. \u0d92 \u0dc4\u0dd0\u0d9a\u0dbb\u0dca\u0d9a\u0dd2 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d85\u0dc0\u0db7\u0dd2\u0dc0\u0dd2\u0dad \u0d9a\u0dbb\u0db4\u0dd4 \u0dca\u0d9a\u0dd2\u0dbb\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0d82\u0db3\u0dc0 \u0dca\u0dba\u0dad\u0db1 \u0dc3\u0dc4 \u0dd2\u0d9a\u0d9a\u0dca\u0dc0\u0d9a\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0d82\u0db3\u0dc0 \u0d85\u0daf \u0db8\u0dbb\u0dd4 \u0d9a\u0dc0\u0dd2\u0db1\u0dca\u0daf \u0db8\u0dc4\u0dda\u0dc2\u0dca\u0da8\u0dd2\u0db1\u0dca \u0db8\u0db1\u0dca\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dad\u0dca \u0dd2\u0dbb\u0dc0\u0dc0\u0dd2. \u0d91\u0daf\u0dd2 \u0d9a\u0dc5\u0dd4 \u0d9a\u0db4\u0dd4 \u0dd2 \u0d85\u0daf \u0dc4\u0dd0\u0d9a\u0dbb\u0dca\u0d9a\u0dd2 \u0d91\u0db8\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda \u0d9a\u0dc5\u0dd4 \u0db8\u0dd4\u0daf\u0d9a\u0dd2\u0dd2\u0d9a\u0dd2 \u0db4\u0dcf\u0d9a\u0d9a\u0dca\u0dc0 \u0dd2\u0db1\u0dca\u0db1\u0dc0\u0dd2.\n\n\u0d85\u0db1\u0dd4\u0dbb \u0dc0\u0dda\u0db8\u0dd2\u0dbb \u0daf\u0dd2\u0dc3\u0dd2\u0db1\u0dd2\u0dba\u0d9a \u0dba\u0db1\u0dd2\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0db8\u0dda \u0db4\u0dd2\u0d9a\u0db1\u0db8\u0dd3 \u0db8\u0dd2\u0dc3 16 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0da7\u0dca\u200d\u0dbb\u0dd2\u0dd2\u0dba\u0db1 5\u0d9a \u0dab\u0dba \u0d85\u0dbd\u0dd4\u0dad\u0dd2\u0db1\u0dca \u0d85\u0dbb\u0db8\u0db8\u0db1 \u0dad\u0dd2\u0db8\u0d82\u0db1\u0dc0\u0dd2. \u0db8\u0dda \u0dca\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dad\u0dc0\u0dd2\u0dbd\u0dca\u0d9a\u0dd2 \u0db8\u0dd2\u0dc3\u0dba\u0d9a\u0dca\u0dc0 \u0dba\u0db1\u0db8\u0d9a\u0dd2 \u0daf\u0dd2\u0db8 \u0dc4\u0dbb\u0dc4 \u0dab\u0dba \u0db8\u0db1\u0dca\u0db1\u0db8\u0d9a\u0dd2 \u0db8\u0db8 \u0db8\u0dda \u0db4\u0dd2\u0dbb\u0dca\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\u0daf\u0dd3\u0db8 \u0dd2\u0dbb\u0dc0\u0dc0\u0dd2 \u0db8\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0db8\u0daf\u0dca\u0db0\u0dc0\u0dbd\u0dca \u0db8\u0db8\u0dd2\u0db1\u0dc0\u0dd2\u0daf \u0dd2\u0dbb\u0dba\u0d9a\u0dd2. \u0d85\u0daf \u0dc0\u0db1\u0db8\u0d9a\u0dd2 \u0d91\u0daf\u0dd2 \u0db8\u0db8 \u0dd2\u0dbb\u0dc0\u0dc0 \u0db8\u0daf\u0dca\u0db0\u0dc0\u0dbd\u0dca \u0db8\u0dc0\u0d9a\u0dd2 \u0dad\u0dd2\u0db8\u0d82\u0db1\u0dc0\u0dd2. \u0db8\u0dda \u0dc0\u0db1 \u0dc0\u0dd2 \u0d8b\u0daf\u0dca\u0db0\u0db0\u0db8\u0db1\u0dba \u0db1\u0dca\u0dba\u0dba 5.7\u0dad\u0dca \u0dd2\u0d9a\u0dca\u0dc0\u0db8\u0dc0\u0d9a\u0dd2 \u0dad\u0dd2\u0db8\u0d82\u0db1\u0dc0\u0dd2. \u0db8\u0dda \u0dba\u0db1 \u0dc0\u0dd2\u0dd2\u0dba \u0d9c\u0dd2\u0db8\u0dba\u0dd2\u0dad\u0dca \u0db1\u0dd0\u0dc0\u0dad \u0dc0\u0dad\u0dd2\u0dc0\u0d9a\u0dca\u0dc0 \u0d82\u0dd0\u0db1\u0dca\u0dbd\u0dca \u0dbb\u0dd2\u0dba\u0db4\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8 \u0dba\u0dd4\u0db8\u0db8\u0dd3\u0daf\u0dd3 \u0dc0\u0dd2\u0db8\u0dda \u0d8b\u0daf\u0dca\u0db0\u0db0\u0db8\u0db1\u0dba \u0db1\u0dca\u0dba\u0dba 20 \u0dd2\u0d9a\u0dca\u0dc0\u0db8\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca. \u0d91\u0dc4\u0dd2 \u0db8\u0dd6\u0dd2\u0d9a \u0d9a\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0dab \u0db8\u0dda \u0dc0\u0db1\u0db8\u0d9a\u0dd2 \u0d85\u0db4 \u0db8\u0db4\u0db8\u0db1\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0db8\u0d82\u0db1\u0dc0\u0dd2.\n\n\u0db8\u0dda \u0dca\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0db8\u0dd2\u0dc3\u0dba\u0d9a\u0dca\u0dc0 \u0dad\u0dd2\u0dc3\u0dda\u0db8\u0dc3\u0dda \u0dd2\u0dbb\u0dba\u0db1\u0dca\u0db8\u0db1\u0dca \u0db8\u0db8\u0dd2\u0d9a\u0d9a\u0dca\u0dc0\u0daf? \u0dc0\u0dbb\u0dca\u0dad\u0db8\u0dd2\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0db8\u0dd0\u0db1 \u0d9a\u0dcf\u0dd2 \u0d9a\u0dbb\u0db1\u0db8\u0d9a\u0dd2 \u0dd2\u0dbb\u0dba\u0db1\u0dc0\u0dd2 \u0dca\u0dbb\u0dca \u0d9a\u0dba \u0db6\u0dd2\u0db3 \u0dc0\u0dd0\u0da7\u0dd3\u0db8 \u0d85\u0dad\u0dd0\u0db1\u0dad\u0dca \u0db8\u0dc0\u0db1\u0dc0\u0dd2 \u0db8\u0db8\u0dad\u0dd0\u0db1\u0dad\u0dca \u0db8\u0dc0\u0db1\u0dc0\u0dd2 \u0d85\u0db8\u0dda\u0dad\u0dca \u0db8\u0dc0\u0db1\u0dc0\u0dd2 \u0dd2\u0dbb\u0dba\u0d9a\u0dd2. \u0d91\u0db8\u0dc4\u0db8 \u0db1\u0dd0\u0dad\u0dca\u0db1\u0dda \u0dd2\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dd2\u0db8\u0dc0\u0dad\u0dca \u0db8\u0db8\u0db8\u0dc4\u0db8\u0dba\u0dd2 \u0d85\u0db8\u0dda\u0dad\u0dca \u0db8\u0db8\u0db8\u0dc4\u0db8\u0dba\u0dd2 \u0dd2\u0dbb\u0dba\u0db1\u0dc0\u0dd2. \u0d91\u0db8\u0dc4\u0db8 \u0dd2\u0dbb\u0dba\u0db1\u0dca\u0db8\u0db1\u0dca \u0d9a\u0dc0\u0dd4\u0daf? \u0dca\u0dab\u0dca\u0da9\u0dd4\u0dc0. \u0dca\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca\u0dc0 \u0db8\u0db1\u0dd2\u0db8\u0dc0\u0dba\u0dd2 \u0db8\u0dc4 \u0d82\u0dd0\u0d82\u0dc0\u0dda \u0d85\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dad\u0dca \u0dd2\u0dbb\u0dba\u0db1\u0dc0\u0dd2 \u0d85\u0dad\u0dd0\u0db1\u0dad\u0dca \u0db8\u0dc0\u0db1\u0dc0\u0dd2 \u0db8\u0db8\u0dad\u0dd0\u0db1\u0dad\u0dca \u0db8\u0dc0\u0db1\u0dc0\u0dd2 \u0db8\u0d9a\u0dd2\u0db8\u0dc4\u0dad\u0dca \u0d91\u0db8\u0dc4\u0db8\u0dba\u0dd2 \u0d92 \u0dc4\u0dd2\u0db1\u0dca\u0daf\u0dd2 \u0d85\u0db8\u0dda\u0dad\u0dca \u0d91\u0db8\u0dc4\u0db8\u0dba\u0dd2 \u0dd2\u0dbb\u0dba\u0d9a\u0dd2. \u0d92 \u0db1\u0dd2\u0dc3\u0dd2 \u0daf\u0dd0\u0db1\u0dca \u0db8\u0db8\u0dad\u0dd0\u0db1 \u0db4\u0dca\u200d\u0dbb \u0dda\u0db1\u0dba \u0dc0\u0dd2\u0dd2\u0dba \u0dad\u0dd2\u0db8\u0d82\u0db1\u0dca\u0db8\u0db1\u0dca \u0db1\u0dd2\u0db1\u0dca \u0dca\u0dbb\u0dca \u0d9a \u0d9a\u0dc5\u0db8\u0db1\u0dd2\u0d9a\u0dbb\u0dab\u0dba\u0d9a\u0dca\u0dc0 \u0db8\u0db1\u0dd2\u0db8\u0dd0\u0dad\u0dd2 \u0dd3\u0db8\u0dba\u0dd2. \u0db8\u0dd4\u0dd2\u0db1\u0dca\u0db8 \u0db8\u0dda \u0dca\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0db8\u0dad\u0dca\u0dbb\u0dd4\u0dda \u0db8\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0dbb\u0db8\u0da7\u0dca\u0da7 \u0dca\u0dbb\u0dca \u0d9a \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf\u0dba\u0d9a\u0dca\u0dc0 \u0dad\u0dd2\u0db8\u0d82\u0db1\u0dc0\u0dd2 \u0dd2\u0dbb\u0dba\u0d9a\u0dd2. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0db8\u0dda \u0dca\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0db8\u0dad\u0dca\u0db8\u0dbb\u0db1\u0dca\u0db8\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dca\u0db8\u0dad\u0dca\u0dad\u0dca \u0d92\u0d9a\u0db8\u0dba\u0dd2. \u0dbb\u0db8\u0da7\u0dca\u0da7 \u0dca\u0dbb\u0dca \u0d9a \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf\u0dba\u0d9a\u0dca\u0dc0 \u0dad\u0dad\u0dd2 \u0d82\u0dc0 \u0dc0 \u0dc4\u0dd2 \u0db8\u0dd0\u0db1\u0dd3\u0db8 \u0db8\u0dda \u0dca\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0db8\u0db1\u0dd2\u0dc4\u0dd0\u0dd2\u0dbb \u0db8\u0dc0\u0d9a\u0dd2 \u0dad\u0dd2\u0db8\u0d82\u0db1 \u0d82\u0dc0 \u0daf\u0dd0\u0db1\u0dca \u0d85\u0db4 \u0db8\u0db4\u0db8\u0db1\u0db1\u0dc0\u0dd2.\n\n\u0d92 \u0dc0\u0dd2\u0db8\u0dda\u0db8 \u0d85\u0db8\u0dd2\u0dad\u0dba \u0db8\u0dab\u0dca\u0da9\u0da9\u0d9a\u0db8\u0dd3 \u0db8\u0dd4\u0dbd\u0dca \u0db4\u0dd4\u0da7\u0dd4\u0dc0\u0d9a \u0db1\u0dca\u0db4\u0dcf\u0db1 \u0d85\u0dba \u0dca\u0dbb\u0dca \u0d9a\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0d82\u0db3\u0dc0 \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0d9a\u0dca\u0dc0 \u0dad\u0dd2\u0db8\u0d82\u0db1 \u0db1\u0dd2\u0d9a\u0db0\u0dd2\u0db4\u0dad\u0db1\u0dca \u0d9a\u0d82\u0dd2 \u0db8\u0daf\u0db1 \u0d8b\u0db4\u0db8\u0daf\u0dc3\u0dda \u0dd2\u0dbb\u0dbb\u0d9a\u0dd2 \u0db8\u0dd0\u0db1\u0d9a\u0dd2 \u0db8\u0dad\u0dca\u0dbb\u0dd4\u0dda \u0d85\u0dbb\u0db8\u0db8\u0db1 \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dc4\u0dd0\u0dd2\u0dbb\u0dba\u0dd2\u0dc0\u0d9a\u0dca\u0dc0 \u0db1\u0dd0\u0dad\u0dd2\u0d9a\u0db8\u0dad\u0dca \u0d85\u0daf \u0dc0\u0db1\u0db8\u0d9a\u0dd2 \u0daf\u0dd2\u0dbb\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0db8\u0d82\u0db1 \u0d82\u0dc0 \u0db8\u0db8 \u0db8\u0d82\u0dd2\u0db8\u0dc4\u0dd2\u0db8 \u0d9a\u0db1\u0db8\u0dd2\u0da7\u0dd4\u0db8\u0dc0\u0db1\u0dca \u0dc0\u0dd4\u0dab\u0dad\u0dca \u0dd2\u0dbb\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0db8\u0dad\u0d9a \u0dad\u0d82\u0dd2\u0db8\u0db1\u0dca\u0db1 \u0d91\u0daf\u0dd2 \u0dca\u0dbb\u0dca \u0d9a\u0dba \u0db8\u0db8\u0dd2\u0da9 \u0daf\u0db8\u0db1\u0db8\u0d9a\u0dd2 \u0dc4\u0dd2 \u0db4\u0dd4 \u0dbb\u0dba\u0db8\u0dd3 \u0db8\u0dc3\u0dda\u0dc0\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0dbb\u0dba\u0db8\u0dd3 \u0db1\u0dd2\u0d9a\u0db0\u0dd2\u0db4\u0dad\u0db1\u0dca \u0db4\u0dcf\u0d9a\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0daf\u0dad\u0dca \u0dd2\u0db1\u0dca\u0db8\u0db1\u0dca \u0dd2\u0dbb\u0dba\u0db1 \u0d91\u0d9a. \u0d91\u0db8\u0dc4\u0db8\u0db1\u0dda \u0d94\u0d82\u0dad\u0dd4\u0db8\u0db1\u0dca\u0d9a\u0dd2 \u0db8\u0dad\u0dca\u0dbb\u0dd4\u0dda \u0db8\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0db8\u0dd0 \u0dbd\u0dd4\u0dc0 \u0dad\u0dd2\u0db8\u0d82\u0db1\u0dca\u0db8\u0db1\u0dca \u0db8\u0d9a\u0dd2\u0dad\u0dd0\u0db1\u0daf \u0dd2\u0dbb\u0dba\u0d9a\u0dd2."
