    "chunk_text": "\u0dc0\u0dd2\u0db4\u0dca\u0dc2\u0dba\u0dad\u0dca \u0dc0\u0dd2\u0db1\u0dca\u0daf\u0dca\u0db0 \u0dc0\u0dd4\u0dd4 \u0dda\u0dca\u0dcf\u0dc0\u0dd2 \u0db8 \u0dc0\u0dca\u0dad\u0dca \u0dba\u0dca\u0db1 \u0dc4\u0dc3\u0daf\u0db4\u0dd4 \u0dc0\u0dad\u0dd4 \u0d9a\u0db1\u0d9a\u0db1\u0dca\u0dc0\u0dca\u0dc0\u0dc3 \u0d86\u0dca\u0dd2\u0d9a \u0dba\u0dd4\u0dca\u0dd2\u0db1\u0dba \u0dca\u0dc4\u0dc3 \u0dc0\u0dd0\u0da7\u0dd4\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d85\u0db4\u0dd2 \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc5\u0dcf0 \u0d94\u0dc0\u0dd4\u0dca\u0dc0\u0dc3 \u0dc0\u0dd0\u0da7\u0dd4\u0dca \u0d85\u0dba\u0dd2\u0dd2\u0db1\u0dba \u0dbd\u0db6\u0dcf \u0dc0\u0daf\u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc5\u0dcf0 \u0dc0\u0db8\u0dcf\u0db1 \u0dad\u0dbb\u0db1 \u0d86\u0dca\u0dd2\u0d9a \u0daf\u0dd4\u0dc2\u0db4\u0d9a\u0dbb\u0dad\u0dcf \u0dca\u0dc4\u0dd2\u0dad \u0dbb \u0dca \u0d94\u0db6 \u0d85\u0db4 \u0db7\u0dcf\u0dbb \u0daf\u0dd4\u0dca\u0db1\u0dcf \u0dc0\u0dd4 \u0dad\u0dca \u0d85\u0db4\u0dd2 \u0d91\u0db8 \u0d9a \u0dba\u0dd4\u0dad\u0dca\u0dad \u0dca\u0da7\u0dd4 \u0d9a\u0dc5\u0dcf0 \u0dca\u0db8\u0dc4\u0dc3\u0dbb \u0d85\u0dc0\u0dca\u0db4\u0dae\u0dcf\u0dc0\u0dbd \u0dca\u0db8\u0dc4\u0dc3\u0dbb \u0d85\u0dba \u0d91\u0db8 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0db1\u0dd3\u0db1 \u0dc0\u0dc4\u0dc3\u0dd4 \u0dca \u0dc4\u0dc3\u0dd0\u0da7\u0dd2\u0dba \u0dca\u0dbd\u0d9a\u0db8\u0dd2\u0dca \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc5\u0dcf; \u0dca\u0db8\u0dc4\u0dc3\u0dbb \u0dca\u0db8\u0dcf\u0db8\u0db1 \u0d91\u0dc0\u0dbd\u0dca \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc5\u0dcf0 \u0dad\u0dc0\u0daf\u0dd4\u0dbb \u0dad\u0dca \u0d91\u0dc0\u0dca\u0db4 \u0dc0\u0db1\u0dcf\u0dc0\u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0d9a \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db8\u0dd2\u0dca \u0dca\u0dca\u0db1\u0dc0\u0dcf0\n\n2165 2166\n\n2026 \u0db8\u0dd0\u0dba\u0dd2 21\n\n\u0db8\u0dd6\u0dbd\u0dcf\u0dca\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0db8\u0db1\u0dca \u0db8\u0dca\u0dd3\u0