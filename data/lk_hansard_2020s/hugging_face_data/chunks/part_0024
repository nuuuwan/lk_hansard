    "chunk_text": "\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 * \u0db4\u0dd4\u0dca\u0db4\u0dad\u0d9a\u0dcf\u0dbd\u0dc0\u0dda \u0dad\u0db6\u0dcf \u0d87\u0dad0 * \u0ba8\u0bc2\u0bc8\u0bbf\u0b95\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bc8\u0ba4\u0bc1. * Placed in the Library.\n\n\u0db4\u0dcf\u0dca\u0dbd\u0dd2\u0db8\u0dc0\u0db1\u0dca\u0dad\u0dd4 \u0dc0\n\n\u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4 \u0db8\u0db1\u0dd20 \u0db8\u0dc5\u0dc0\u0d9a\u0dc5\u0dd2\u0dba\u0dba\u0dd2 \u0dc0\u0dca! \u0db8\u0dcf\u0dbb \u0dc0\u0d9a\u0dc5\u0dd2\u0dba\u0dca \u0dc0\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0db8\u0dba\u0db1 6.6\u0dca \u0db8\u0dc4\u0dc3\u0da2\u0dca\u200d\u0db1 \u0db6\u0dd0\u0d9c\u0d9a\u0dd4\u0dc0\u0dc0\u0dca \u0dc0\u0dd0\u0da9\u0dd2\u0db4\u0dd4\u0dbb \u0dba\u0db1\u0dc0\u0dcf0 \u0daf\u0dd0\u0dca \u0d92\u0d9a \u0d85\u0dba \u0d9a\u0dbb \u0db8\u0dca\u0db1 \u0dc4\u0dc3\u0daf\u0db1\u0dc0\u0dcf0\n\n\u0db8\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4 \u0db8\u0db1\u0dd2 \u0d85\u0dc0\u0dca \u0db8\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db1\u0dd2\u0dc0\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0d87\u0db8\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0dcf \u0d85\u0daf \u0dda\u0dc0\u0daf\u0dca \u0dc0\u0dc4\u0dc3\u0dcf\u0db3 \u0d9a\u0dae\u0dcf\u0dc0\u0dca \u0d9a\u0dc5\u0dcf0 \u0d85\u0db4\u0dd2 \u0d92\u0d9a \u0d85\u0dc4\u0dc3\u0dc0\u0db8\u0db1 \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf0 \u0d91\u0dad\u0dd4 \u0db8\u0dcf \u0dc0\u0db6\u0dcf\u0dc0\u0dc4\u0dc3\u0dcf\u0db8 facts \u0dca\u0dc4\u0dd2\u0dad\u0dc0 \u0d92 \u0dc0\u0daf\u0dca\u0dc0\u0dbd\u0dca \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf0 \u0d92\u0d9a \u0dc4\u0dc3\u0dd2\u0dba0 \u0dc4\u0dc3\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d91\u0dad\u0dd4 \u0db8\u0dcf \u0db8\u0dd3 \u0dca\u0dca\u0db4\u0dca\u0dbb \u0daf\u0dc0\u0dca\u0d9a - \u0d8a\u0dc0\u0dda\u0daf \u0dc0\u0d9a\u0dcf\u0dc0\u0dc4\u0dc3\u0db4\u0dc0\u0daf\u0ddd - \u0d9a\u0dd2\u0dda\u0dc0\u0dcf \u0d91\u0dca\u0dc0\u0d9a\u0dc0\u0db1\u0d9a\u0dd4 \u0db8\u0dcf\u0dca\u0dba\u0dca .\u0da9\u0dc0\u0dad\u0dca \u0dd3\u0db8 \u0dca\u0db3\u0dc4\u0dc3\u0dcf \u0db1\u0dca\u0db4\u0dd2\u0dba\u0dbd\u0dca 16 690\u0dca \u0d87\u0dd2\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf0 \u0d91\u0dca\u0dc0\u0d9a\u0dc0\u0db1\u0d9a\u0dd4 .\u0da9\u0dc0\u0dad\u0dca \u0dd3\u0db8 \u0dca\u0db3\u0dc4\u0dc3\u0dcf \u0db1\u0dca\u0db4\u0dd2\u0dba\u0dbd\u0dca 16 690\u0dca \u0db8\u0dcf\u0dca\u0dba\u0d9a \u0d87\u0dd2\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0dc0\u0dca \u0db8\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db1\u0dd2\u0dc0\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0d87\u0db8\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf0 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db1\u0dd2\u0dc0\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0d87\u0db8\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0dcf \u0dc0\u0dcf\u0dca\u0dad\u0dcf\u0dc0\u0dca \u0dd2\u0db1\u0dda\u0db6\u0dcf0 \u0dc0\u0db8\u0dcf\u0d9a\u0dca\u0daf \u0dad\u0db6\u0db4\u0dd4 \u0dc0\u0dcf\u0dca\u0dad\u0dcf\u0dc0? \u0d91\u0dad\u0dd4 \u0db8\u0dcf \u0d85\u0dc0\u0dca \u0db6\u0dca\u0daf\u0dd4\u0dbd \u0d9c\u0dd4 \u0dc0\u0dca\u0db0\u0db1 \u0dc4\u0dd2 \u0db4\u0dd4 \u0d87\u0db8\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0dcf\u0dc0\u0dc3 \u0dc0\u0dcf\u0dca\u0dad\u0dcf\u0dc0 \u0d9a\u0dd0\u0da9\u0dd4\u0dc0\u0dcf0 \u0db6\u0dca\u0daf\u0dd4\u0dbd \u0d9c\u0dd4 \u0dc0\u0dca\u0db0\u0db1 \u0dc4\u0dd2 \u0db4\u0dd4 \u0d87\u0db8\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0db1\u0dca\u0db4\u0dd2\u0dba\u0dbd\u0dca 2 .00\u0d9a\u0dd2\u0dca .\u0da9\u0dc0\u0dad\u0dca \u0dc0\u0dc0\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dda0 \u0d91\u0dad\u0dd4 \u0db8\u0dcf \u0d85\u0dc0\u0dca \u0db4\u0dd0\u0dad\u0dca\u0dc0\u0dad\u0dca \u0dc4\u0dd2 \u0db4\u0dd4 \u0dc0\u0d9a\u0dc0\u0db1\u0d9a\u0dd4 \u0dc0\u0dd4 \u0dad\u0dca \u0dc0\u0d9a\u0dcf\u0dca\u0daf \u0dc0\u0d9a\u0dc5\u0dd2\u0dca \u0dd2\u0db1\u0dba\u0dcf\u0dc0\u0db8\u0db1 \u0d92 \u0db6\u0dc0 \u0d9a\u0dd2\u0dba\u0dca\u0db1 \u0d91\u0db4\u0dcf\u0dba\u0dd00 \u0db1\u0dca\u0db4\u0dd2\u0dba\u0dbd\u0dca 2 .00\u0dca .\u0da9\u0dc0\u0dad\u0dca \u0dc0\u0dc0\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dc3\u0dd0 \u0dc0\u0dca0 \u0d92 \u0db1\u0dd2\u0dca\u0dcf \u0dc0\u0dca \u0d85\u0db4\u0dd2 \u0d94\u0dca\u0dc0\u0d9a\u0dcf \u0db8 \u0dc0\u0db8\u0daf\u0dbb \u0dba\u0dca\u0db1\u0dad\u0dca \u0dc3\u0dd2\u0daf\u0dca\u0db0 \u0dc0\u0dd4\u0dc0\u0dab\u0dca0 \u0dc0\u0dad\u0dca\u0db8\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db1\u0dd2\u0dc0\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0d87\u0db8\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0db1\u0dca\u0db4\u0dd2\u0dba\u0dbd\u0dca 16 690\u0d9a\u0dd2\u0dca .\u0da9\u0dc0\u0dad\u0dca \u0dc0\u0dc0\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0d9a\u0dd2\u0dba\u0dbd\u0dcf0 \u0dc4\u0dc3\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db1\u0dd2\u0dc0\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0d87\u0db8\u0dd2\u0db1\u0dad\u0dd4 \u0db8\u0db1\u0dd2 \u0dad\u0db8\u0dd4\u0dca\u0db1\u0dcf\u0dca\u0dc0\u0dca\u0db4 \u0db4\u0dcf\u0dca\u0dbd\u0dd2\u0db8\u0dc0\u0db1\u0dca\u0dad\u0dd4 \u0dc0 \u0d86\u0db0\u0dd4\u0db1\u0dd2\u0d9a\u0dba\u0dd20 \u0db8\u0db8 \u0d94\u0db6\u0dad\u0dd4 \u0db8\u0dcf \u0d85\u0dc0\u0dc0\u0dcf\u0daf\u0dba\u0dca \u0dc0\u0daf\u0db1\u0dc0\u0dcf0 \u0dc0\u0db8\u0dcf\u0d9a\u0dca\u0daf \u0d85\u0dc0\u0dc0\u0dcf\u0daf\u0dba? \u0d94\u0db6\u0dad\u0dd4 \u0db8\u0dcf \u0d85\u0dc0\u0dca \u0dc0\u0dc4\u0dc3\u0dcf\u0db3 \u0db8\u0dd2\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dba\u0dca; \u0dc0\u0dc4\u0dc3\u0dcf\u0db3 \u0dc0\u0d9a\u0dc0\u0db1\u0dca0 \u0d85\u0dc0\u0dc0\u0dcf\u0daf\u0dba \u0dad\u0db8\u0dba\u0dd2 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dd2\u0dba\u0dca \u0dc0\u0daf\u0db1 \u0dc0\u0daf\u0db1 \u0d9c\u0dd4\u0dc5\u0dd2 \u0d9c\u0dd2\u0dbd\u0dd2\u0db8\u0dca\u0db1 \u0d91\u0db4\u0dcf \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dd2\u0dba\u0dca \u0dc0\u0daf\u0db1 \u0dc0\u0daf\u0db1 \u0dbd\u0dd4 \u0d9a\u0dca\u0db1 \u0d91\u0db4\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a0 \u0dc0\u0db8\u0dcf\u0d9a\u0daf \u0d92 \u0dbd\u0dd4 \u0d9a\u0dd1\u0dc0\u0dcf\u0db8 \u0daf\u0dd2\u0dbb\u0dc0\u0dcf \u0db8\u0dca\u0db1 \u0d85\u0db8\u0dcf\u0db1\u0dca\u0dba\u0dd20 \u0db8\u0dbd\u0dca \u0d85\u0d9f\u0dd4\u0db1\u0dca \u0dc0\u0dcf\u0dc0\u0dc3 \u0dc0\u0db1\u0dcf\u0dc0\u0dc0\u0dba\u0dd2; \u0daf\u0dd2\u0dbb\u0dc0\u0dcf \u0db8\u0dca\u0db1 \u0d85\u0db8\u0dcf\u0db1\u0dca\u0dba\u0dd20 \u0d92 \u0dc0\u0dcf\u0dc0\u0dc3 \u0dbd\u0dd4 \u0d9a\u0dca\u0db1 \u0d91\u0db4\u0dcf0 \u0d92 \u0dc0\u0dcf\u0dc0\u0dc3 \u0dbd\u0dd4 \u0d9a\u0dcf\u0dbd\u0dcf \u0d85\u0dc0\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0db1\u0dca \u0db8\u0dca\u0dd3\u0dc0\u0db1\u0dca \u0da2\u0dca\u200d\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dd2\u0db1\u0dc0\u0db1\u0dca \u0dc0\u0db8\u0daf\u0dbb \u0d9c\u0dd2\u0dba\u0dcf0 \u0d92 \u0dbd\u0dd4 \u0d9a\u0dca\u0db1 \u0d91\u0db4\u0dcf0 \u0dc0\u0daf\u0dc0\u0dbb\u0dca \u0dc0\u0dc4\u0dc3\u0dcf\u0dba\u0dbd\u0dcf \u0db6\u0dbd\u0dca\u0db1 \u0d92\u0d9a \u0dc4\u0dc3\u0dd2\u0dba\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf0 \u0db1\u0dca\u0db4\u0dd2\u0dba\u0dbd\u0dca 16 690\u0d9a\u0dd2\u0dca \u0d9a\u0dca\u0db1 \u0dc0\u0db1\u0dcf\u0dc0\u0dc0\u0dba\u0dd2 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0dc0\u0dbd\u0dc0 \u0d9a\u0dca\u0db10 \u0dc0\u0dbd\u0dc0 \u0d9a\u0dca\u0db1\u0dba\u0dd2 \u0dda\u0dbd\u0dcf \u0d9a\u0dca\u0db1\u0dba\u0dd2 \u0dad\u0db8\u0dba\u0dd2 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca \u0dc0\u0dc0\u0dca\u0dc0\u0dca \u0db8\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4 \u0db8\u0db1\u0dd20\n\n\u0daf\u0dd0\u0dca \u0d85\u0dc0\u0dca \u0db8\u0db1\u0dc0\u0dbd \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dca \u0db8\u0dcf\u0dc5\u0dd4 \u0d9a\u0dca\u0db1 \u0db6\u0dd0\u0dc4\u0dc3\u0dd00 \u0db8\u0dcf\u0dc5\u0dd4 \u0d9a\u0dca\u0dc0\u0dca \u0dc0\u0d9a\u0dcf\u0dc0\u0dc4\u0dc3\u0dcf\u0db8\u0daf? \u0db8\u0dcf\u0dc5\u0dd4\u0dca\u0dc0\u0dc3 \u0db8 \u0db1 \u0d87