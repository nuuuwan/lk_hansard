466 7,000 150\n\n\u0dc0\u0dbb\u0dca\u0dc2 \u0d85\u0db4\u0db1 \u0db1 \u0d9a\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda (\u0daf\u0db8\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0daf\u0da7 \u0dc1\u0dca)\n\n2021 2,736\n\n2022 7,488\n\n2023 2,189\n\n2024 173\n\n2025 4,249\n\n(\u0b85) (i) 2027 \u0bae\u0bc1\u0ba4\u0bb2\u0bcd 2029 \u0bb5\u0bae\u0bb0 \u0ba4\u0ba8\u0bb2\u0bcd \u0bc7\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b89\u0baa \u0b89\u0ba3\u0bb5\u0bc1\u0baa\u0bcd \u0baa\u0baf\u0bbf\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0bae\u0bc2\u0ba9\u0bcd\u0bb1\u0bc6\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0ba4\u0baf\u0bc6\u0bbe\u0bc6\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.\n\n2040\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0bb5\u0bae\u0bb0 \u0b8e\u0ba8\u0bcd\u0ba4\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bc1\u0bae\u0bcd \u0ba4\u0baf\u0bc6\u0bbe\u0bc6\u0bbe\u0bbf\u0b95\u0bcd \u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bb5\u0bbf\u0bb2\u0bcd\u0bae\u0bb2.\n\n\u0baa\u0bc6\u0bbe\u0bb1\u0bcd\u0ba4\u0baa\u0bc6\u0bbe\u0bb0\u0bc1\u0b9f\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0ba4\u0ba9\u0bcd\u0ba9\u0bbf\u0bae\u0bb1\u0bb5\u0bc1 \u0b85\u0bae\u0b9f\u0baf\u0bc1\u0bae\u0bcd \u0ba4\u0baa\u0bc6\u0bbe\u0bb0\u0bc1\u0b9f\u0bcd\u0b9f\u0bc1, \u0b95\u0bc7\u0ba4\u0bcd\u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd, \u0b95\u0bc6\u0bbe\u0bb2\u0bcd\u0ba8\u0bae\u0b9f \u0bb5\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0b95\u0bc6\u0bbe\u0ba3\u0bbf \u0bc7\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bc6\u0bbe\u0bc6\u0ba9 \u0b85\u0bae\u0bc7\u0b9a\u0bcd\u0b9a\u0bc1, \u0b95\u0bc6\u0bbe\u0bb2\u0bcd\u0ba8\u0bae\u0b9f \u0b89\u0bb1\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf \u0bc7\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bc1\u0b95\u0bc6\u0bbe\u0ba4\u0bc6\u0bbe\u0bb0\u0ba4\u0bcd \u0ba4\u0bbf\u0bae\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd, \u0bc7\u0bc6\u0bbe\u0b95\u0bc6\u0bbe\u0ba3 \u0b95\u0bc6\u0bbe\u0bb2\u0bcd\u0ba8\u0bae\u0b9f \u0b89\u0bb1\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf \u0bc7\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bc1\u0b95\u0bc6\u0bbe\u0ba4\u0bc6\u0bbe\u0bb0\u0ba4\u0bcd \u0ba4\u0bbf\u0bae\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0bae\u0ba4\u0bc6\u0bbf\u0baf \u0b95\u0bc6\u0bbe\u0bb2\u0bcd\u0ba8\u0bae\u0b9f \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0bcd \u0bc6\u0bae\u0baa \u0b86\u0b95\u0bbf\u0baf\u0bae\u0bb5 2026\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0bb5\u0bb0\u0bb5\u0bc1 \u0ba4\u0bc6\u0bb2\u0bb5\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f \u0bc7\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bc1 \u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 2,000 \u0bc7\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd \u0ba8\u0bbf\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0bc6\u0bbf\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bae\u0bb3\u0b9a\u0bcd \u0ba4\u0bc6\u0baf\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0bb5\u0bb0\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9.\n\n1. \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0bcd \u0baa\u0bc6\u0bbe\u0bb2\u0bcd \u0b89\u0bb1\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bae\u0baf \u0b85\u0ba4\u0bbf\u0b95\u0bc6\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd\n\n\u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0bc6\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd (Dairy Hub) - 1,000 \u0bc7\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd \u0baa\u0bc6\u0bbe\u0bb1\u0bcd\u0baa\u0ba3\u0bcd\u0bae\u0ba3 \u0baf\u0bc6\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bae\u0bb3 \u0bae\u0bc7\u0bae\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0bae\u0ba8\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bcd, \u0b87\u0bb2\u0b99\u0bcd\u0bae\u0b95 2030\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0baa\u0bc6\u0bbe\u0bb2\u0bbf\u0bb2\u0bcd 75% \u0ba4\u0ba9\u0bcd\u0ba9\u0bbf\u0bae\u0bb1\u0bb5\u0bc1 \u0b85\u0bae\u0b9f\u0bb5\u0bae\u0ba4 \u0bae\u0ba8\u0bc6\u0bbe\u0b95\u0bcd\u0b95\u0bbf\u0b9a\u0bcd \u0ba4\u0bc6\u0baf\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0bb0\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1.\n\n2. \u0bae\u0ba4\u0bc6\u0bbf\u0baf \u0b95\u0bc6\u0bbe\u0bb2\u0bcd\u0ba8\u0bae\u0b9f \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0bcd \u0bc6\u0bae\u0baa\u0b95\u0bcd\u0b95\u0bc1\u0b9a\u0bcd\n\n\u0ba4\u0bc6\u0bc6\u0bbe\u0ba8\u0bcd\u0ba4\u0bc7\u0bc6\u0bbe\u0ba9 \u0baa\u0bb2 \u0baa\u0ba3\u0bcd\u0bae\u0ba3\u0b95\u0bb3\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0b87\u0ba9\u0baa\u0bcd\u0ba4\u0baa\u0bb0\u0bc1\u0b95\u0bcd\u0b95 \u0b85\u0bb2\u0b95\u0bc1\u0b95\u0bae\u0bb3 \u0bae\u0bc7\u0bae\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc6\u0bbe\u0ba9 \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0bc6\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd - 1,000 \u0bc7\u0bbf\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0bb0\u0bc2\u0baa\u0bc6\u0bbe\u0baf\u0bcd\n\n(ii) \u0b89\u0ba3\u0bb5\u0bc1 \u0b87\u0bb1\u0b95\u0bcd\u0b95\u0bc1\u0bc7\u0ba4\u0bbf\u0bae\u0baf\u0b95\u0bcd \u0b95\u0bc1\u0bae\u0bb1\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc6\u0bbe\u0b95 \u0b93\u0bb0\u0bc6\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0b95\u0ba3\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0ba4\u0baf\u0bc6\u0bbe\u0bc6\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. 2025 \u0bae\u0bc1\u0ba4\u0bb2\u0bcd 2029 \u0bb5\u0bae\u0bb0 \u0ba4\u0baf\u0bc6\u0bbe\u0bc6\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9 \u0bb5\u0bbf\u0bae\u0bb3\u0bb5\u0bc1 \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bae\u0b9f \u0baf\u0bbf\u0bb2\u0bc6\u0bbe\u0ba9 \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bc7\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bcd\u0baa\u0b9f\u0bbf (Organizational Result based Framework), \u0b85\u0ba4\u0ba9\u0bcd \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0bae\u0b9f \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 2024 \u0b86\u0b95\u0bc1\u0bae\u0bcd.\n\n(iii) \u0b87\u0ba4\u0ba9\u0bcd\u0ba4\u0baa\u0bc6\u0bbe\u0bb0\u0bc1\u0b9f\u0bcd\u0b9f\u0bc1, 2027 \u0bae\u0bc1\u0ba4\u0bb2\u0bcd 2030 \u0bb5\u0bae\u0bb0 \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0baa\u0ba3\u0bbf\u0b95\u0bae\u0bb3 \u0bae\u0bc7\u0bb1\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0bb3\u0bcd\u0bb3\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bc7\u0bbf\u0b9f\u0baa\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1:"
