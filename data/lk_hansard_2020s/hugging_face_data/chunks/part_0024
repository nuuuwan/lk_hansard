    "chunk_text": "\u0ba4\u0b95\u0bcc\u0bb0\u0bb5 \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0b9a\u0bcd \u0bc6\u0baa\u0bc6\u0bbe\u0ba8\u0bc6\u0bbe\u0baf\u0b95\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bae\u0bb3, \u0bc7\u0bae\u0bb2\u0baf\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bae\u0bb2 \u0bb5\u0bc6\u0bbe\u0bb4\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bc7\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0ba4\u0b95\u0ba9\u0b9a\u0bcd \u0ba4\u0bc6\u0bc6\u0bbe\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbf\u0bb2\u0ba4\u0bc7\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1 \u0b87\u0bb2\u0bcd\u0bae\u0bb2; \u0b85\u0b99\u0bcd\u0b95\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba8\u0bbf\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bae\u0bb2 \u0b92\u0bb0\u0bc1 \u0bc6\u0bbf\u0bb1\u0bbf\u0baf \u0ba4\u0b95\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bae\u0bb2 \u0b85\u0bae\u0bc7\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b95\u0bc2\u0b9f \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bae\u0bb2 \u0b89\u0bc6\u0bbe\u0bbf\u0bae\u0bc7\u0baf\u0bbf\u0bb2\u0bcd\u0bae\u0bb2 \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 \u0ba8\u0bc0\u0bb2\u0b95\u0bc6\u0bbe\u0bc7\u0bae\u0bcd \u0bae\u0ba4\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bae\u0bb2 \u0ba8\u0bae\u0b9f\u0ba4\u0baa\u0bb1\u0bcd\u0bb1 \u0bc6\u0bae\u0bcd\u0baa\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd\u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0bc6\u0bb0\u0bcd\u0bb5\u0bae\u0ba4\u0bc6 \u0bc6\u0bae\u0bc2\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0baa\u0bc6\u0bbe\u0bb0\u0bcd\u0bae\u0bb5\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b85\u0ba4\u0bc1\u0bb5\u0bc1\u0bae\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bc6\u0bbe\u0b95, \u0bc6\u0bae\u0bc2\u0b95 \u0bb5\u0bae\u0bb2\u0ba4\u0bcd\u0ba4\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bb2\u0bb5\u0bc1\u0bae\u0bcd \u0b89\u0bb2\u0bb5\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b87\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0b95\u0bc6\u0bbe\u0bb2\u0b95\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bae\u0bb2\u0ba4\u0bc6\u0bbe\u0ba9\u0bcd \u0b87\u0bb5\u0bcd\u0bb5\u0bc6\u0bbe\u0bb1\u0bc6\u0bbe\u0ba9 \u0ba4\u0bc6\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bcd \u0ba4\u0bb5\u0bb3\u0bbf\u0bb5\u0bb0\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bbf\u0baf\u0ba4\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b85\u0bae\u0bb5\u0baf\u0bc1\u0bae\u0bcd \u0b87\u0bb2\u0bcd\u0bae\u0bb2\u0ba4\u0baf\u0ba9\u0bcd\u0bb1\u0bc6\u0bbe\u0bb2\u0bcd \u0ba8\u0bc6\u0bbe\u0ba9\u0bcd \u0ba8\u0bbf\u0bae\u0ba9\u0b95\u0bcd\u0b95\u0bbf\u0bae\u0bb1\u0ba9\u0bcd, \u0b87\u0bae\u0ba4\u0bae\u0baa\u0bc6\u0bbe\u0bb2 \u0b86\u0baf\u0bbf\u0bb0\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0b9a\u0bcd\u0bc6\u0bbf\u0bae\u0ba9\u0b95\u0bb3\u0bcd \u0b85\u0b99\u0bcd\u0b95\u0bc1\u0bb3\u0bcd\u0bb3 \u0b95\u0bbf\u0b9f\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bb3\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0bc7\u0bae\u0bb2\u0b95\u0bb3\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0bc7\u0bae\u0bb1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bb2\u0bc6\u0bbe\u0bae\u0bcd.\n\n\u0b85\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1, \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0b9f\u0baf \u0b95\u0bbf\u0bb3\u0bbf\u0ba4\u0ba8\u0bc6\u0bbe\u0b9a\u0bcd\u0bc6\u0bbf \u0bc7\u0ba3\u0bcd\u0ba3\u0bbf\u0bae\u0bb2 \u0baa\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0bb3\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0bae\u0bc2\u0ba4\u0bcd\u0ba4 \u0b8e\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb3\u0bb0\u0bcd \u0ba4\u0bae\u0bcd\u0baa\u0bbf \u0ba4\u0bc0\u0baa\u0b9a\u0bcd\u0ba4\u0bc6\u0bb2\u0bcd\u0bb5\u0ba9\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0b9f\u0baf \u0bc6\u0bbf\u0bb2 \u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb2\u0b99\u0bcd\u0bae\u0b95 \u0b9a\u0bc1\u0b99\u0bcd\u0b95\u0ba4\u0bcd \u0ba4\u0bbf\u0bae\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0ba4\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0bae\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bc6\u0bbe\u0b95, \u201c\u0baa\u0baf\u0b99\u0bcd\u0b95\u0bb0\u0bb5\u0bc6\u0bbe\u0ba4\u0bbf\u201d, \u201c\u0bc6\u0baf\u0bae\u0ba9\u0b9f\u0bcd\u201d \u0bae\u0baa\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1 \u0b85\u0bb5\u0bb0\u0ba4\u0bc1 \u0ba8\u0bc2\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bbf\u0b9f\u0bc1\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b85\u0bae\u0ba4\u0bae\u0ba8\u0bb0\u0bae\u0bcd, \u201c\u0b8e\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb2\u0bcd \u0ba8\u0bc6\u0bbe\u0ba9\u0bcd \u0baf\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0ba4\u0bc6\u0baf\u0bcd\u0b95\u0bbf\u0bae\u0bb1\u0ba9\u0bcd\u201d, \u201c\u0b87\u0baa\u0bcd\u0bae\u0baa\u0bc6\u0bbe\u0ba4\u0bc1\u0bae\u0bcd \u0b87\u0b99\u0bcd\u0bae\u0b95 \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bc1 \u0bae\u0ba4\u0bc6\u0b99\u0bcd\u0b95\u0bb3\u0bcd\u0ba4\u0bc6\u0bbe\u0ba9\u0bcd\u201d \u0b8e\u0ba9\u0bcd\u0bb1 \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bc1 \u0ba8\u0bc2\u0bb2\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc6\u0bbe\u0b95 \u0b85\u0bb5\u0bb0\u0bc1\u0bae\u0b9f\u0baf \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0bc6\u0bbf\u0bb2 \u0ba8\u0bc6\u0bbe\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd Sri Lanka Customs\u0b87\u0bb2\u0bcd \u0ba4\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0bae\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b87\u0ba4\u0bcd\u0ba4\u0bae\u0b95\u0baf \u0b92\u0bb0\u0bc1 \u0bae\u0ba4\u0bae\u0bb5 \u0b8f\u0ba9\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0b85\u0bb0\u0bc6\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1? \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bae\u0bb2 \u0b8e\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bc6\u0bbe\u0bbf\u0bae\u0bc7 \u0b8f\u0ba9\u0bcd \u0ba4\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1? \u0ba4\u0bc7\u0bbf\u0bb4\u0bcd \u0bc7\u0b95\u0bcd\u0b95\u0bb3\u0bcd\u0bc7\u0bc0\u0ba4\u0bc1 \u0bb5\u0bb2\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1 \u0b92\u0bb0\u0bc1 \u0baf\u0bc1\u0ba4\u0bcd\u0ba4\u0ba4\u0bcd\u0bae\u0ba4 \u0ba8\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf, \u0b85\u0ba8\u0bcd\u0ba4 \u0baf\u0bc1\u0ba4\u0bcd\u0ba4\u0ba4\u0bcd\u0bae\u0ba4 \u0ba8\u0bbf\u0baf\u0bc6\u0bbe\u0baf\u0baa\u0bcd \u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc6\u0bbe\u0b95 \u0bae\u0b95\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bc6\u0bbe\u0baa\u0baf \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bae\u0bb3\u0baa\u0bcd \u0baa\u0bc1\u0b95\u0bb4\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1 \u0b8e\u0bb4\u0bc1\u0ba4\u0bbf\u0baf\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0b9f\u0baf \u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0bb2\u0bcd\u0bb2\u0bc6\u0bbe\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0ba4\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0bb3\u0bc7\u0bc6\u0bbe\u0b95 \u0b89\u0bb2\u0bc6\u0bbe \u0bb5\u0bb0\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9. \u0b85\u0bb5\u0bae\u0bb0\u0baa\u0bcd \u0baa\u0bc1\u0b95\u0bb4\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1 \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b85\u0bb0\u0bc6\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0bae\u0ba4\u0baa\u0bcd \u0baa\u0bc1\u0b95\u0bb4\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0ba4\u0b95\u0bc6\u0bbe\u0bae\u0bb2\u0b95\u0bae\u0bb3 \u0ba8\u0bbf\u0baf\u0bc6\u0bbe\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0b8e\u0bb4\u0bc1\u0ba4\u0bbf\u0ba9\u0bc6\u0bbe\u0bb2\u0bcd - \u0b85\u0ba4\u0bc1 \u0ba4\u0bc7\u0bbf\u0bb4\u0bcd \u0b8e\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0b9f\u0baf \u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0b95\u0bc7\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bb2\u0bc6\u0bbe\u0bae\u0bcd, \u0bc6\u0bbf\u0b99\u0bcd\u0b95\u0bb3 \u0b8e\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0b9f\u0baf \u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0b95\u0bc7\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bb2\u0bc6\u0bbe\u0bae\u0bcd - \u0b85\u0ba8\u0bcd\u0ba4\u0baa\u0bcd \u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b89\u0bb2\u0bc6\u0bbe\u0bb5 \u0b85\u0ba9\u0bc1\u0bc7\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\n\n889 890\n\n[\u0d9c\u0dbb\u0dd4 \u0dc3\u0dd4\u0dca\u0daf\u0dbb\u0dd2\u0d82\u0d9c\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd3\u0db1\u0dda \u0db8\u0dc4\u0dad\u0dc1]\n\n2026 \u0db8\u0db4\u0dba\u0dd2 05\n\n\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9. \u0b86\u0ba9\u0bc6\u0bbe\u0bb2\u0bcd, \u0ba4\u0bc7\u0bbf\u0bb4\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0b9f\u0baf \u0b89\u0ba3\u0bcd\u0bae\u0bc7 \u0ba8\u0bbf\u0bae\u0bb2\u0bae\u0bc7\u0b95\u0bae\u0bb3 \u0ba4\u0bb5\u0bb3\u0bbf\u0b95\u0bcd\u0ba4\u0b95\u0bc6\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1 \u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0ba4\u0bc0\u0baa\u0b9a\u0bcd\u0ba4\u0bc6\u0bb2\u0bcd\u0bb5\u0ba9\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1 \u0b8e\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb3\u0bc6\u0bbe\u0bbf\u0ba9\u0bcd \u0b90\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0bae\u0b95\u0baf\u0bc6\u0bbe\u0ba9 360 \u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0b95\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0b95\u0bb3\u0bcd \u0b87\u0ba9\u0bcd\u0ba9\u0bae\u0bc1\u0bae\u0bcd \u0b9a\u0bc1\u0b99\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0bbf\u0bc6\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0ba4\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0bae\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba9 \u0b8e\u0ba9\u0bcd\u0bb1\u0bc6\u0bbe\u0bb2\u0bcd, \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0b9f\u0baf \u0b85\u0bb0\u0bc6\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0bc6\u0bbe\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0b8e\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b9a\u0bcd \u0b9a\u0bc1\u0ba4\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd, \u0bae\u0baa\u0b9a\u0bcd\u0b9a\u0bc1\u0b9a\u0bcd \u0b9a\u0bc1\u0ba4\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc6\u0bbe? \u0b8e\u0ba9\u0bcd\u0bb1 \u0bae\u0b95\u0bb3\u0bcd\u0bb5\u0bbf \u0b8e\u0bb4\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1."
  },
