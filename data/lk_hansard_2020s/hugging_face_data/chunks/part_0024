ca\u0db0\u0db1 \u0db8\u0dd2\u0dbd\u0daf\u0dd3 \u0d9c\u0dd0\u0db1\u0dd3\u0dda \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dc3\u0dd4\u0dc0 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dc0\u0dd2\u0d9c\u0dc3\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc1\u0dda\u0daf\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0dd2\u0dc1\u0dbd\u0db1\u0dc0\u0dcf. \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dd2\u0d9c\u0dc3\u0db1 \u0dc0\u0dcf\u0dbb\u0dca\u0dd9\u0dcf \u0dc3\u0db7\u0dcf\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc0 \u0dc4\u0dd0\u0d9a\u0dd2\u0daf \u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0dcf \u0d85\u0dc4\u0db1\u0dc0\u0dcf. \u0d87\u0dad\u0dca\u0dd9 \u0db8 \u0dc3\u0db8\u0dc4\u0dbb \u0d85\u0dc0\u0dc3\u0dda\u0dae\u0dcf\u0dc0\u0dbd\u0daf\u0dd3 \u0dc0\u0dd2\u0d9c\u0dc3\u0d9a\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dc0\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d85\u0daf\u0dcf\u0dc0 \u0dc0\u0dd2\u0d9c\u0dc3\u0db1 \u0dc0\u0dcf\u0dbb\u0dca\u0dd9\u0dcf \u0db4\u0dcf\u0dbb\u0dca\u0dba\u0dc1\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc1\u0dda \u0dc1\u0db4\u0dcf\u0daf\u0dd4 \u0dc0\u0dba\u0dcf\u0db4\u0dcf\u0dbb \u0dba\u0dc0\u0dc5\u0dd2\u0dbd\u0db3 \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d91\u0dda \u0dc4\u0dbb\u0dc4\u0dcf \u0d92 \u0dc0\u0dcf\u0dbb\u0dca\u0dd9\u0dcf \u0dbd\u0dbd\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc0\u0dc0\u0db1\u0dca.\n\n\u0d94\u0dbd\u0dad\u0dd4\u0db8\u0dcf \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dc1 \u0daf\u0dd3 \u0d85\u0dc3\u0dcf \u0dad\u0dd2\u0dc1\u0dbd\u0db1\u0dc0\u0dcf, term tender \u0d91\u0d9a\u0d9a\u0dca cancel \u0d9a\u0dbb\u0db4\u0dd4 \u0dc3\u0dd0\u0db4\u0dba\u0dd4\u0dda\u0d9a\u0dbb\u0dd4\u0dc1\u0dc0\u0d9a\u0dca spot tender \u0d91\u0d9a \u0daf\u0dcf\u0dbd\u0dcf spot tender \u0d91\u0d9a \u0dc4\u0dbb\u0dc4\u0dcf \u0dc1\u0dd9\u0dbd\u0dca \u0dc3\u0db4\u0dba\u0dcf\u0dc0\u0dcf \u0dad\u0dd2\u0dc1\u0dbd\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0dbd\u0dcf. \u0d91\u0dda \u0dc3\u0dd0\u0db4\u0dba\u0dd4\u0dda\u0d9a\u0dbb\u0dd4 \u0d9a\u0dd4\u0dbb\u0daf \u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0dbd\u0dcf \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0dcf \u0db1\u0dd2 \u0dda\u0da0\u0dd2\u0dd9 \u0dc0 \u0dc1\u0dba\u0dcf\u0dc0\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0db1\u0dda, \u0db8 \u0d92 \u0dc3\u0dda\u0dbd\u0db1\u0dca\u0db0\u0dc1\u0dba\u0dcf\u0dc0\u0db1\u0dca \u0dba\u0dc0\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0dbd\u0dbd\u0dcf \u0dc1\u0daf\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc0\u0dc0\u0db1\u0dca. \u0dc1\u0db8\u0dcf\u0d9a\u0daf, \u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0dc1\u0dd9\u0dcf\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0d9c\u0dc3\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0dc3\u0db8\u0dcf\u0da2\u0dc1 \u0db4\u0dca\u200d\u0dbb\u0da0\u0dcf\u0dbb\u0dba\u0dcf\u0dc0 \u0dc0\u0db1\u0dc0\u0dcf, term tender \u0d91\u0d9a\u0d9a\u0dca cancel \u0d9a\u0dbb\u0db4\u0dd4 \u0dc3\u0dd0\u0db4\u0dba\u0dd4\u0dda\u0d9a\u0dbb\u0dd4\u0dc1\u0dc0\u0d9a\u0dca spot tender \u0dc3\u0db3\u0dc4\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dc1\u0dc0\u0dbd\u0dcf \u0d92 \u0dc4\u0dbb\u0dc4\u0dcf \u0dc3\u0dd0\u0db4\u0dba\u0dd4\u0dda \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dc1\u0dbd\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0dbd\u0dcf. \u0d94\u0dbd\u0dad\u0dd4\u0db8\u0dcf \u0db1\u0dd2 \u0dda\u0da0\u0dd2\u0dd9 \u0dc0 \u0dc1\u0dba\u0dcf\u0dc0\u0db1\u0dca \u0d92 \u0dc3\u0dd0\u0db4\u0dba\u0dd4\u0dda\u0d9a\u0dbb\u0dd4 \u0d9a\u0dd4\u0dbb\u0daf \u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0db1 \u0d91\u0d9a \u0dc3\u0dc4 \u0d85\u0daf\u0dcf\u0dc0 \u0daf\u0dd2\u0db1 \u0dc0\u0d9a\u0dc0\u0dcf\u0db1\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0db1\u0dda, \u0db8 \u0d92 \u0dc3\u0dda\u0dbd\u0db1\u0dca\u0db0\u0dc1\u0dba\u0dcf\u0dc0\u0db1\u0dca \u0dba\u0dc0\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0dbd\u0dbd\u0dcf \u0dc1\u0daf\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc0\u0dc0\u0db1\u0dca."
