    "chunk_text": "\u0dda\u0dd9\u0da7\u0dd2\u0db8\u0dd9\u0daf\u0dbd\u0dd3\u0db1\u0db8\u0dc3\u0dca\u0d82\u0da0\u0daf\u0dba\u0dd9\u0db8\u0dc3\u0dca\u0d82\u0dcf\u0dbb\u0dca\u0db0\u0db1\u0db8\u0dc3\u0dca\u0db4\u0dca\u200d\u0dc3\u0dd4 \u0db8\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dca \u0dd9\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8 \u0dc4\u0daf\u0db8\u0db7\u0daf\u0dab\u0dca\u0da9\u0db4\u0daf\u0d9c\u0daf\u0dba\u0dba\u0db8\u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0db82026\u0db8\u0dcf\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0dba\u0da7 \u0db8\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8\u0db8\u0dd2\u0dd2\u0db1\u0dba\u0db1\u0db81 000\u0d9a\u0dca\u0dc0\u0db8\u0dda\u0dcf\u0dca\u0db8\u0dd9\u0dba\u0db8\u0d87\u0dc0.\u0db8\u0d87\u0db8\u0dd4\u0dd4\u0db8 02\u0dc4\u0dd2* \u0dbd\u0d9a\u0dca\u0dc0\u0dcf\u0daf\u0db8\u0d87\u0dc0. \u0dda \u0db8\u0dba\u0da7 \u0dda\u0dca\u0db8\u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0db8\u0dba\u0dc5\u0daf\u0dca\u0db8\u0d86\u0dcf\u0dba\u0dda\u0dba\u0db8\u0dcf\u0db1\u0db8\u0dba\u0db4\u0dad\u0dbb\u0dd2\u0db8\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8\u0db8\u0dd2\u0dd2\u0db1\u0dba\u0db1\u0db8800\u0dd9\u0db8\u0dc0\u0dd2\u0dba\u0dbd\u0db8\u0dd2\u0dca\u0db8\u0dcf\u0dba\u0daf\u0dba\u0dca\u0dd2\u0db8]]\u0d9a\u0dca\u0dc0\u0db8\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dca \u0dd9\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0da7 \u0db8\u0dc3\u0dca\u0db4\u0dca\u200d\u0dc3\u0dd4 \u0db8\u0dd9\u0dba\u0db8\u0d87\u0dc0.\u0db8\u0d92\u0db8\u0dba\u0da7 \u0dda\u0dca\u0db8 \u0dca\u0db1\u0daf\u0dba \u0db8\u0dca\u200d\u0dca\u0dda\u0daf\u0dca\u0db0\u0dc3\u0dd2\u0db8\u0dbb\u0dca\u200d\u0dda\u0dd9\u0daf\u0da7\u0dd4\u0dcf\u0db8\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dc3\u0dca\u0d82\u0dc3\u0dca\u0dad\u0dd9\u0dba\u0dda\u0dba\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0db8\u0db4\u0dd4\u0dca\u0dc0\u0dca\u200d \u0db8\u0dd9 \u0dca\u200d\u0db8\u0dcf\u0db4\u0dca \u0dca\u200d\u0db8 \u0daf\u0dbb\u0dca\u0d9c\u0dba\u0db8\u0dc3\u0dca\u0d82\u0dcf\u0dbb\u0dca\u0db0\u0db1\u0dba\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0db8\u0dba\u0daf\u0dc3\u0dd2\u0d9a\u0dd4\u0db4\u0daf\u0db8\u0dd2\u0dba\u0dca \u0db8\u0db0\u0da2\u0db8\u0dcf\u0dba\u0daf\u0dba\u0dca\u0dd2\u0dba \u0db8\u0dba\u0dc0\u0db8\u0dcf\u0dc3\u0dca\u0dad\u0db1\u0dd4\u0dcf\u0dba\u0db8\u0dc4\u0daf\u0db8\u0dba\u0daf\u0dba\u0dc4\u0dd4\u0dcf\u0db8\u0d93\u0dd2\u0dc4\u0daf\u0dc3\u0dd2\u0dd9\u0db8\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0db1\u0db8\u0dc3\u0dca\u0d82\u0dcf\u0dbb\u0dca\u0db0\u0db1\u0dba \u0db8 \u0daf\u0dc0\u0dda\u0dca \u0db8\u0dda\u0dc3\u0dca \u0db6\u0dd4\u0dcf\u0dca\u0dc0\u0db8\u0dcf\u0db4\u0dcf\u0db8\u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dc0\u0db8\u0dc3\u0dca\u0d82\u0dcf\u0dbb\u0dca\u0db0\u0db1\u0dba \u0db8\u0db8\u0dd2\u0db4\u0dad\u0dc3\u0dca\u0dad\u0dc3\u0dca\u0db8\u0db4\u0dca\u200d\u0dbb\u0dda\u0daf\u0dca\u0db0 \u0dda \u0db8\u0dc3\u0dca\u0daf\u0d9c\u0dba\u0db8\u0dc3\u0dca\u0d82\u0da0\u0daf\u0dba\u0dd9\u0db8\u0dd9\u0dbb\u0dca \u0daf\u0dca\u0dc0\u0dba\u0db8\u0dc3\u0dca\u0d82\u0dcf\u0dbb\u0dca\u0db0\u0db1\u0dba\u0db8\u0d86\u0dd3\u0db1\u0db8\u0dcf\u0dba\u0daf\u0dba\u0dca\u0dd2\u0db8]1\u0d9a\u0dca\u0dc0\u0db8\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dca \u0dd9\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0da7 \u0db8\u0dd2\u0dba\u0dba\u0db8\u0dd2\u0dc0\u0dba.\u0db8\n\n\u0db0\u0dba\u0db8\u0dd9\u0daf\u0dbd\u0dd3\u0db1\u0db8\u0dc3\u0dca\u0d82\u0da0\u0daf\u0dba\u0dd9\u0db8\u0dc3\u0dca\u0d82\u0dcf\u0dbb\u0dca\u0db0\u0db1\u0db8\u0dc3\u0dca\u0db4\u0dca\u200d\u0dc3\u0dd4 \u0db8\n\n\u0db0\u0dba\u0db8\u0dd9\u0daf\u0dbd\u0dd3\u0db1\u0db8\u0dc3\u0dca\u0d82\u0da0\u0daf\u0dba\u0dd9\u0db8\u0dc3\u0dca\u0d82\u0dcf\u0dbb\u0dca\u0db0\u0db1\u0db8\u0dc3\u0dca\u0db4\u0dca\u200d\u0dc3\u0dd4 \u0db8\u0dda\u0dca\u200d\u0dc3\u0dca\u0db8202 -2029\u0db8\u0dd9\u0daf\u0dca\u200d\u0dba\u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0dc3\u0dca\u0db4\u0dca\u200d\u0dc3\u0dd4 \u0db8\u0dc3\u0dca\u0dd9\u0dc3\u0dca\u0dad\u0db8\u0dd9\u0dba\u0db8\u0dbd\u0db4\u0db1\u0da7 \u0dca\u0db8\u0da2\u0daf\u0dd2\u0dd9\u0db8\u0d9a\u0dca\u200d\u0dbb \u0db8\u0dc3\u0dca \u0dba\u0daf\u0dbd\u0db1\u0db8\u0dda\u0dbd\u0dba\u0daf\u0dbb\u0dca\u0dc0\u0db8\u0dda \u0dca\u0dad\u0dd4\u0db8\u0dda\u0dc1\u0db8\u0dd2\u0dba\u0dbb\u0dca\u0dda\u0daf\u0dca\u0db0 \u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dba\u0dca\u0db8\u0dd9\u0dba\u0db8\u0d87\u0dc0.\u0db8\u0d91 \u0db8\u0dc3\u0dca\u0db4\u0dca\u200d\u0dc3\u0dd4 \u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0dcf\u0dba\u0daf\u0dba\u0dca\u0dd2\u0db8\u0dda\u0dc0\u0ddd\u0dba\u0daf\u0db8\u0d9c\u0db1\u0dd4\u0db8\u0dca\u200d\u0db4\u0db6\u0dd4\u0dda\u0dc1\u0db8\u0dba\u0dc5\u0daf\u0dca\u0db8\u0dc3\u0dca\u0db7\u0daf \u0db8\u0dbb\u0dd2\u0dc3\u0dca\u0dad\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dc0\u0db8\u0dda\u0dca \u0dd9 \u0db8\u0dd9\u0daf\u0dbb\u0dca\u0dba\u0daf\u0dca\u200d\u0db8\n\n\u0dc3\u0dca\u0dc4\u0db8\u0dbb\u0dd2\u0dc3\u0dca\u0dad\u0db8\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0dc0\u0db8\u0dc3\u0dca \u0dbb\u0dca\u0db0\u0dd3\u0dd9\u0dba\u0dda\u0db8\u0dd9\u0db8\u0dd2\u0da7\u0dd4\u0db8 \u0dd2\u0db1\u0dd2\u0dba.\u0db8\u0dda \u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8\u0db8\u0dd2\u0dd2\u0db1\u0dba\u0db1\u0db82 52\u0dd9\u0db8\u0dcf\u0dba\u0daf\u0dba\u0dca\u0dd2\u0db849\u0d9a\u0dca\u0dc0\u0db8\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dba\u0dca\u0db8 \u0dd9\u0dba\u0db8\u0d87\u0dc0.\u0db8(\u0d87\u0db8\u0dd4\u0dd4\u0db8 03\u0dc4\u0dd2*\u0db8\u0dbd\u0d9a\u0dca\u0dc0\u0dcf\u0daf\u0db8\u0d87\u0dc0.) \u0dda \u0db8\u0dba\u0da7 \u0dda\u0dca \u0db8\u0dd3\u0db8\u0dd2\u0db4\u0dad\u0dba\u0db8\u0dbd\u0db9\u0dd4\u0dca \u0dca\u200d\u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0dc3\u0dca\u0d82\u0da0\u0daf\u0dba\u0dd9\u0db8\u0d9c \u0db1\u0daf\u0dca\u0dc0\u0db8\u0dc3\u0dca\u0d82\u0dcf\u0dbb\u0dca\u0db0\u0db1\u0dba \u0db8\u0dcf\u0dc3\u0dca\u0dad\u0d9c\u0dd4\u0daf\u0dcf\u0db8\u0db1\u0dd9\u0dca \u0dc3\u0dca\u0dad\u0db8\u0dc3\u0dca\u0d82\u0da0\u0daf\u0dba\u0dd9\u0db8\u0db4\u0dca\u200d\u0dbb\u0dda\u0daf\u0dca\u0db0 \u0db8\u0dc3\u0dca\u0d82\u0dcf\u0dbb\u0dca\u0db0\u0db1\u0dba \u0db8\u0dc4\u0dd2\u0dd2\u0dba\u0daf\u0dd4 \u0db8\u0db8\u0dd2\u0dc4\u0dd2\u0daf\u0dd4 \u0db8\u0dd9\u0dca\u200d\u0daf\u0dba\u0dba\u0db8\u0dc3\u0dca\u0d82\u0dcf\u0dbb\u0dca\u0db0\u0db1\u0dba \u0db8 \u0dca\u0db1\u0daf\u0dba \u0db8\u0dda\u0db4\u0daf\u0db4\u0dad\u0d9a\u0dca\u0dc0\u0db8\u0dbb\u0d82\u0d9c\u0dca\u200d\u0daf\u0dcf\u0db8\u0db8\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dc3\u0dca\u0d82\u0dc3\u0dca\u0dad\u0dd9\u0dba\u0dda\u0dba \u0db8 \u0db4\u0dd9\u0dca\u200d\u0db4\u0dd4\u0dcf\u0db8\u0dca\u200d\u0dca\u0dda\u0daf\u0dca\u0db0\u0dc3\u0dd2\u0db8\u0dbb\u0dca\u200d\u0dda\u0dd9\u0daf\u0da7\u0dd4\u0dcf\u0db8\u0dc3\u0dca\u0d82\u0dcf\u0dbb\u0dca\u0db0\u0db1\u0dba\u0db8\u0dc3\u0dca\u0dc4\u0db8\u0dba\u0daf\u0db4\u0dad\u0dc3\u0dca\u0db4\u0dad\u0dd9\u0db8\u0dc3\u0dca\u0d82\u0da0\u0daf\u0dba\u0dd9\u0db8\u0dcf\u0dba\u0daf\u0dba\u0dca\u0dd2\u0db8\u0d86\u0dd3\u0db1\u0db8\u0dc3\u0dca\u0d82\u0dcf\u0dbb\u0dca\u0db0\u0db1\u0db8\u0dcf\u0dba\u0daf\u0dba\u0dca\u0dd2\u0db8\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dca \u0dd9\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0da7 \u0db8\u0dd2\u0dba\u0dba\u0db8\u0dd2\u0dc0\u0dba.\n\n\u0dc0\u0dcf\u0dbd \u0db8\u0dc3\u0dca\u0d82\u0da0\u0daf\u0dba\u0dd9\u0dd2\u0db6\u0dca\u0da7 \u0db8\u0d9c \u0db1\u0daf\u0dca\u0dc0\u0dcf\u0dca\u200d\u0da7 \u0db8\u0d87\u0dad\u0dd4\u0db8\u0dc5\u0dca\u0db8\u0dc0\u0dd3\u0db8 \u0db8\u0dba\u0dc4\u0dc3\u0dd4\u0db8\u0dc0\u0dd3\u0db8 \u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0dda\u0dba\u0ddd\u0da2\u0dd2\u0dc0\u0db8\u0dc3\u0dca\u0db4\u0dca\u200d\u0dc3\u0dd4 \u0d9a\u0dca\u0dc0\u0db8\u0dcf\u0db1\u0db8\"Centralized E-Ticketing Platform\" \u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0da2\u0daf\u0dd2\u0dd9\u0db8\u0d9a\u0dca\u200d\u0dbb \u0db8\u0dc3\u0dca \u0dba\u0daf\u0dbd\u0db1\u0db8\u0dda\u0dbd\u0dba\u0daf\u0dbb\u0dca\u0dc0\u0dda \u0dca\u0dad\u0dd4\u0db8\u0dda\u0dc1\u0db8\u0dd2\u0dba\u0dbb\u0dca\u0dda\u0daf\u0dca\u0db0 \u0db8\u0dca\u200d\u0dbb\u0daf\u0db8\u0db8\u0dda\u0d9c\u0db1\u0db8\u0d87\u0dc0.\u0db8\u0dda \u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8\u0db8\u0dd2\u0dd2\u0db1\u0dba\u0db1\u0db818 .121\u0d9a\u0dca\u0dc0\u0db8\u0dda\u0dcf\u0dca\u0db8\u0dd9\u0dba\u0db8\u0d87\u0dc0.\u0db8\n\n\u0dc0\u0dcf\u0dbd \u0db8\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca \u0db8\u0db8\u0dd2\u0dd2\u0db1\u0dba\u0db1\u0db82 500\u0dd9\u0db8\u0dda\u0dda\u0dda\u0dbb\u0dca\u0db8\u0dcf\u0db4\u0dcf\u0db8\u0dc3\u0dca\u0d82\u0dcf\u0dbb\u0dca\u0db0\u0db1\u0dba\u0db8\u0dd9\u0dba\u0db8\u0dc3\u0dca\u0d82\u0da0\u0daf\u0dba\u0dd9\u0db8\u0d86\u0dd9\u0dbb\u0dca\u0dc2\u0dca\u0da8\u0dda\u0dba\u0db8\u0dca\u200d\u0dbb\u0daf\u0db8\u0d9c\u0db4\u0dd3\u0db8 \u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0dc3\u0dca\u0dd9\u0dc3\u0dca\u0dad\u0db8\u0dd9\u0dba\u0db1\u0db8\u0dca\u200d\u0dbd\u0db8\u0dcf\u0dba\u0daf\u0dba\u0dca\u0dd2\u0db8\u0dcf\u0daf\u0dbb\u0dca\u0dc0\u0daf\u0dcf\u0db8\u0da2\u0daf\u0dd2\u0dd9\u0db8\u0d9a\u0dca\u200d\u0dbb \u0db8\u0dc3\u0dca \u0dba\u0daf\u0dbd\u0db1\u0db8\u0dda\u0dbd\u0dba\u0daf\u0dbb\u0dca\u0dc0\u0dda \u0dca\u0dad\u0dd4\u0db8\u0dda\u0dc1\u0db8\u0dd2\u0dba\u0dbb\u0dca\u0dda\u0daf\u0dca\u0db0 \u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dba\u0dca\u0db8\u0dd9\u0dba\u0db8\u0d87\u0dc0.\u0db8\n\n\u0dd2\u0db1\u0d9c\u0dd4 \u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dcf\u0db1 \u0dc3\u0dd0\u0dbd\u0dc3\u0dd4\u0db8\u0dca\n\n\u0dda\u0dca\u200d\u0ddd\u0dd9\u0db8\u0dbb\u0db4\u0d82\u0d9a\u0dd4\u0db8\u0db4\u0dca\u200d\u0dbb\u0dbd\u0daf\u0db1\u0db8\u0dcf\u0dba\u0daf\u0dba\u0dca\u0dd2\u0dba\u0db8\u0dba\u0da7 \u0dda\u0dca\u0db8\u0dc3\u0dca\u0d82\u0da0\u0daf\u0dba\u0dd9\u0db8\u0d85\u0d82 \u0dba\u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db82026-20]0\u0db8\u0dc3\u0dca\u0d82\u0da0\u0daf\u0dba\u0dd9\u0db8\u0d9a\u0dca\u0dc0\u0dda\u0dc2\u0dca\u0da8\u0dad\u0dad\u0dca\u200d\u0dbb\u0db8\u0d8b\u0dba\u0daf\u0dba \u0daf\u0dbb\u0dca\u0dd2\u0dd9\u0db8\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dd9\u0daf\u0dbb\u0dd3\u0db8\u0dc3\u0dca\u0db4\u0dca\u200d\u0db4\u0dc3\u0dca\u0dad \u0db8\u0dc3\u0dca\u0dd9\u0dc3\u0dca\u0dad