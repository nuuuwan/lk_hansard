    "chunk_text": "\u0dd9\u0daf\u0dca\u0dc0\u0daf\u0db8\u0dc3\u0dca\u0dc4\u0db8\u0dc5 \u0daf\u0db8\u0dd9\u0da7 \u0dd4\u0dad\u0dad\u0dd4\u0db8\u0db8\u0d85 \u0daf\u0dc0\u0dba\u0daf\u0d82 \u0dba\u0da7 \u0dca\u0db8\u0dba\u0dc3\u0dd4\u0dd2\u0dba\u0db8\u0dcf\u0dc3\u0dca\u0dda\u0dbb\u0dca\u0db8\u0dc3\u0dca\u0dc4\u0db8\u0dda \u0db8\u0dcf\u0dc3\u0dca\u0dda\u0dbb\u0dca\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db8\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dbd\u0db1\u0db8\u0dca\u200d\u0db4\u0db6\u0dd2\u0dca\u200d\u0daf\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf\u0db8\u0dda \u0db8\u0dbd\u0dca\u0dc0\u0db8\u0dba\u0daf\u0dca\u0db0\u0db0\u0dd2\u0dba\u0db8\u0dda\u0d9c\u0daf\u0db4\u0db8\u0db1\u0d9f\u0dca\u0db1\u0da7 .\u0db8\u0dda \u0db8\u0dda\u0dcf\u0db1\u0dda\u0dd9\u0daf\u0da7 \u0db8\u0d85\u0db4\u0dd2\u0db8\u0da9\u0dd2\u0da2\u0dd2\u0da7 \u0dca \u0db8\u0d86\u0dbb\u0dca\u0dd2\u0dd9\u0db8\u0d85 \u0daf\u0dc0\u0dba\u0daf\u0d82 \u0dba\u0dca\u0db8\u0d91\u0d9a\u0dca\u0dc0\u0dd9\u0db8\u0dc3\u0dca \u0dbb\u0dca\u0db0\u0db8\u0dda\u0dcf\u0dca\u200d\u0daf\u0db8\u0dbd\u0dca\u0dc0\u0db8\u0dba\u0daf\u0dca\u0db0\u0db0\u0dd2\u0dda \u0db8\u0dcf\u0db4\u0db4\u0db8\u0dd9\u0da7 \u0dd4\u0dad\u0dad\u0dd4\u0db8\u0db8\u0dda\u0dbb\u0daf\u0dda\u0dc4\u0ddd\u0daf\u0dd4\u0dba\u0da7 \u0db8\u0d85\u0dcf\u0dc3\u0dca\u0dca\u0db8\u0dd9\u0dba\u0dca\u200d\u0daf\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf.\u0db8\u0dda \u0db8\u0dcf\u0dc3\u0dca\u0dba\u0db8\u0d85\u0dcf\u0dc3\u0dca\u0dca\u0db8\u0dcf\u0db1\u0dc0\u0dd2\u0da7 \u0db8\u0dda \u0db8\u0dbd\u0dca\u0dc0\u0db8\u0dba\u0daf\u0dca\u0db0\u0db0\u0dd2\u0dba\u0db8\u0dda\u0d9c\u0daf\u0db4\u0db1\u0d9f\u0dca\u0db1\u0da7 \u0db8\u0db4\u0dd4\u0dc5\u0dd4\u0dcf\u0dca\u0db8\u0d9a\u0dd2\u0dba\u0dca\u200d\u0daf\u0db8\u0d85\u0db4\u0dd2\u0db8\u0dc0\u0dd2 \u0dad\u0dcf\u0daf\u0dc3\u0dca\u0db8\u0dd9\u0dba\u0db1\u0dcf\u0daf.\u0db8\u0d92\u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0d85\u0dcf \u0dba\u0db8 \u0db4\u0dbb\u0dd2\u0dc4\u0dca\u0dc0\u0dd3\u0db8 \u0db8\u0dda \u0db8\u0dda\u0dcf\u0db1\u0dda\u0dd9\u0daf\u0da7 \u0dca\u0db8\u0d85 \u0daf\u0dc0\u0dba\u0daf\u0d82 \u0dba\u0db8\u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0da7 \u0db8\u0dc3\u0dd2\u0daf\u0dd4\u0dd9\u0dba\u0db8\u0dd2\u0dca\u0db8\u0dba\u0dcf\u0dd2\u0db1\u0dcf\u0daf.\u0db8\n\n\u0d92\u0db8\u0d91\u0d9a\u0dca\u0dc0\u0dd9 \u0db8\u0d85\u0db4\u0dd2\u0db8\u0dc0\u0dd2 \u0dad\u0dcf\u0daf\u0dc3\u0dca\u0db8\u0dd9\u0dba\u0db1\u0db8\u0dda\u0daf\u0dca\u0db0\u0db8\u0dc0 \u0dd2\u0db6\u0db8\u0dd4\u0daf\u0dca \u0db8\u0dc5 \u0daf\u0dc0\u0dd2\u0dba\u0db8\u0dba\u0daf\u0dc3\u0dca\u0dca \u0db8\u0dba\u0daf\u0dca\u0db0\u0db0\u0dd2\u0dba\u0db8\u0dad\u0dd4\u0db8\u0dc5\u0db8\u0d85\u0dd2\u0dba\u0dcf\u0daf\u0dbb\u0dca\u0dba\u0dda\u0dba\u0dca \u0db8\u0d85\u0dca\u0dc0\u0dbb\u0dca\u0dd9\u0dba\u0dab\u0dd3\u0dba\u0db8\u0d85\u0dcf \u0dba\u0dc0\u0daf\u0db8\u0dd2\u0dc2\u0dca\u0da8\u0dad\u0da7 \u0db8\u0dda\u0dcf\u0db1\u0db8\u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0da7 \u0db8\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dca\u0dd2\u0dba\u0db8\u0dc3\u0dca\u0dc4\u0db8\u0dcf\u0db4\u0db4\u0db8\u0db4\u0dd2\u0dc5\u0dd2\u0dda\u0dcf\u0dc5\u0db8\u0dc3\u0dca\u0dd9\u0dc3\u0dca\u0dad\u0db8\u0dc0\u0dd2\u0dba\u0db8\u0dd4\u0dad\u0dad\u0dd4\u0db8\u0dd2\u0db6\u0db8\u0d9a\u0dd2\u0dba\u0db1\u0db8\u0d91\u0dd9.\u0db8\u0dda \u0db8\u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dd2\u0dba\u0db8\u0dc3\u0dca\u0dc4\u0db8\u0dda \u0db8\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dca\u0dd2\u0dba\u0db8\u0dad\u0dd4\u0db8\u0dc5\u0db8\u0dd4\u0daf\u0dca \u0db8\u0dc5 \u0daf\u0dc0\u0dd2\u0db8\u0dda \u0db8\u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0db8\u0d86\u0dbb\u0daf\u0db0\u0db8\u0dc3\u0dca\u0dc4\u0dd2\u0dc0\u0db8\u0dbd\u0dbb\u0dd4\u0dcf\u0dca\u0da7 \u0db8\u0dda\u0dd9\u0daf\u0dd2\u0db6\u0db8\u0dcf\u0daf\u0db8\u0dda \u0db8\u0d85\u0dcf\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0dcf\u0d9a\u0dca\u0dc0 \u0db8\u0dda\u0dd9\u0daf\u0dd2\u0db6\u0db8\u0dcf\u0daf\u0dda \u0db8\u0dd2\u0db4\u0db8\u0db4\u0dca\u200d\u0dbb \u0daf\u0dda\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dc3\u0dca\u0dc4\u0db8\u0dc3\u0dca\u0daf\u0db0\u0daf\u0dba\u0dda\u0db8\u0d85\u0dcf\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0dcf\u0d9a\u0dca\u0dc0\u0db8\u0dc4\u0dd2\u0db8\u0dd2\u0db8\u0dda\u0dcf\u0db1\u0dcf\u0daf\u0dbd?\u0db8\u0db8\n\n\u0d9c\u0dbb\u0dd4 (\u0dc0\u0dc0\u0daf\u0dba) \u0db1\u0dcf\u0db8\u0dbd\u0dca \u0dc3\u0dd4\u0daf\u0dbb\u0dca\u0dc1\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 (\u0b95\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bcd) \u0ba8\u0bbe\u0bae\u0bb2\u0bcd \u0b9a\u0bc1\u0ba4\u0bb0\u0bcd\u0b9a\u0ba9) (The Hon. (Dr.) Namal Sudarshana) \u0d92\u0db8\u0db4\u0dca\u200d\u0dbb \u0dad\u0db1\u0dba\u0db8\u0d87\u0dd3\u0db8 \u0db8\u0d9c\u0db4\u0db1\u0db8\u0dda\u0dbb\u0daf\u0dda\u0dc4\u0daf \u0db8\u0dc3\u0dca\u0dad\u0dad\u0dd4\u0db8\u0dd2\u0dd2\u0db6 \u0db8\u0d9c\u0dbb\u0dd4\u0db8 \u0dca\u0dd3\u0dad\u0dd4\u0db8 \u0dd2\u0dba.\u0db8\n\n\u0d87\u0dca\u0dc0\u0da7 \u0db8\u0d85\u0dda\u0db4\u0dca\u0db8\u0dba\u0dda\u0da7\u0dca\u0db8\u0dda\u0dba\u0dba\u0db8\u0dba\u0daf\u0dc3\u0dca\u0dca \u0db8\u0d85\u0db0\u0dba\u0daf\u0dba\u0db1\u0dba\u0db8\u0dc3\u0dca \u0dbb\u0dca\u0db0\u0db8\u0db8\u0da2\u0daf\u0dd2\u0dd9\u0db8\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dca\u0dd2\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dda\u0d9c\u0daf\u0db4\u0db8\u0db1\u0db4\u0dd2\u0db1\u0dca\u200d\u0daf\u0db8\u0dd2\u0db6\u0dd4\u0dda\u0dab\u0dca\u0da9\u0db8\u0db1\u0db4\u0dc4\u0db4.\u0db8\u0dd4\u0daf\u0dca \u0db8\u0dc5 \u0daf\u0dc0\u0dd2\u0dba\u0db8\u0dc3\u0dca\u0d82\u0dcf\u0dbb\u0dca\u0db0\u0db1\u0dba\u0db8\u0dc3\u0dca \u0dbb\u0dca\u0db0\u0dda\u0dba\u0dca\u0db82008\u0dd3\u0db1\u0db8\u0da2\u0daf\u0dd2\u0dd9\u0db8\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dca\u0dd2\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dd2\u0db6\u0dd4\u0dda\u0daf\u0da7 \u0db8\u0dda\u0dba\u0dba\u0db8\u0dba\u0daf\u0dc3\u0dca\u0dca \u0db8\u0d85\u0db0\u0dba\u0daf\u0dba\u0db1\u0dba\u0db8\u0d9a\u0dd2\u0dba\u0db1\u0db8\u0dc0\u0dd2\u0dc2\u0dca\u0da8\u0dba\u0dba\u0da7 \u0db8\u0da2\u0daf\u0dd2\u0dd9\u0db8\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dca\u0dd2\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dda\u0d9c\u0daf\u0db4\u0db8\u0db1\u0db4\u0dd2\u0db1\u0dca\u200d\u0daf\u0db8\u0dd2\u0db6\u0dd4\u0dda\u0dab\u0dca\u0da9\u0db8\u0db1\u0db4\u0dc4\u0db4.\u0db8\u0dda \u0db8\u0dda\u0dcf\u0db1\u0dda\u0dd9\u0daf\u0da7 \u0db8\u0d85\u0db0\u0dba\u0daf\u0dba\u0db1\u0db8\u0d85 \u0daf\u0dc0\u0dba\u0daf\u0d82 \u0dba \u0db8\u0dd9\u0daf\u0dca\u0dc0\u0daf\u0db8\u0dc3\u0dca\u0dc4\u0db8\u0dc5 \u0daf\u0db8\u0dd9\u0da7 \u0dd4\u0dad\u0dad\u0dd4\u0db8\u0db8\u0d85 \u0daf\u0dc0\u0dba\u0daf\u0d82 \u0dba \u0db8\u0da2\u0daf\u0dd2\u0dd9\u0db8\u0d85\u0db0\u0dba\u0daf\u0dba\u0db1\u0db8\u0d86\u0dba\u0dc0\u0db1\u0dba\u0db8\u0db8\u0d91\u0dd9\u0dad\u0dd4\u0db8\u0db8\u0dda\u0dcf\u0dca\u200d\u0daf\u0db8\u0da2\u0daf\u0dd2\u0dd9\u0db8\u0dda\u0dba\u0dba\u0db8\u0dba\u0daf\u0dc3\u0dca\u0dca \u0db8\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dca\u0dd2\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dda\u0d9c\u0daf\u0db4\u0db8\u0db1\u0d9f\u0dca\u0db1\u0da7 \u0db8\u0d85\u0dcf \u0dba\u0db8\u0dd9\u0da7 \u0dd4\u0dad\u0dad\u0dd4\u0db8\u0db8\u0dc3\u0dd2\u0daf\u0dd4\u0db8\u0dd9\u0dba\u0dca\u200d\u0daf\u0db8\u0dbd\u0db4\u0dca\u0db8\u0d91\u0dba\u0db8"
