c0\u0db1\u0dca \u0db8\u0dc0\u0db1\u0dca \u0dc0 \u0db8\u0dba\u0db1\u0dca \u0d9a\u0dc0\u0db8\u0dbb\u0dca\u0daf;\n\n(iii) \u0db8\u0dd0\u0db1\u0dd2\u0dba \u0dc4\u0dd0\u0dd2\u0dbb \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba\u0d9a\u0dca\u0dc0 \u0db8\u0db4\u0db1\u0dca\u0db1\u0dd4\u0dda \u0d9a\u0dbb \u0dad\u0dad\u0dd2 \u0db1\u0dc0\n\n\u0daf\u0dd2\u0d9c\u0dd4 \u0dd4\u0dbb \u0db8\u0db8\u0db1\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0dc4 \u0d92\u0dc0\u0dd2\u0db8\u0dba\u0db1\u0dca \u0dc0\u0dd2\u0dbb\u0dca\u0dad\u0dd2 \u0dc0\u0dd6 \u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2 \u0dad \u0db8\u0dc0\u0db1\u0dca \u0db8\u0dc0\u0db1\u0dca \u0dc0 \u0db8\u0dba\u0db1\u0dca \u0d9a\u0dc0\u0db8\u0dbb\u0dca\u0daf;\n\n(iv) \u0db1\u0dc0 \u0db8\u0dc0\u0db8\u0dc5\u0db3 \u0db8\u0db4\u0dd2\u0dc5\u0dc0\u0d9a \u0dad\u0dad\u0dd4\u0dc5\u0dd4 \u0dd3\u0db8 \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dda\n\n\u0dc3\u0dd0\u0d9a\u0dd3/\u0db8 \u0dc3\u0db3\u0dc4\u0dd2 \u0dc3\u0d82\u0db8 \u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0d9a\u0daf \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0dca \u0d9a\u0dbb\u0db1 \u0d9a\u0daf \u0db8\u0dc4\u0ddd \u0d85\u0dbd\u0dd4\u0dad\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0d9a\u0da0\u0dca\u0da1\u0dd2 \u0d9a\u0dbb\u0db1 \u0d9a\u0daf \u0daf\u0dca\u0db0\u0dc0\u0dd2\u0db4\u0dd2\u0dbb\u0dca \u0dda\u0dc0\u0dd2\u0d9a \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0db8\u0dc3\u0dda\u0dc0\u0dd2 \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0dda \u0db8\u0dc0\u0db1\u0dca \u0db8\u0dc0\u0db1\u0dca \u0dc0 \u0db8\u0dba\u0db1\u0dca \u0d9a\u0dc0\u0db8\u0dbb\u0dca\u0daf;\n\n(v) MICE, \u0dc3\u0dd4\u0db8\u0d9b\u0ddd\u0db4\u0db8\u0db7\u0ddd \u0db8 \u0dc3\u0dd4\u0dc0\u0dad\u0dd2 \u0dc3\u0dc4 \u0db8\u0db1\u0dc0\u0d9a\u0dd2\n\n\u0dc3\u0d82 \u0dd2\u0dbb\u0d9a \u0dc0\u0dba\u0dd2\u0db4\u0dd2\u0dbb \u0dad\u0dad\u0dd4\u0dc5\u0dd4 \u0dd2\u0dc4\u0dc5 \u0dca\u0daf\u0dd2\u0dba\u0dda \u0dba\u0db1\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dc3\u0d82 \u0dd2\u0dbb\u0d9a \u0d9a\u0dca\u0dc0\u0db8\u0dc2\u0dca\u0da8\u0dda\u200d\u0dbb \u0dc4\u0db3\u0dd4\u0db1\u0dd2 \u0db8\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dd2 \u0dc0\u0dd4\u0dc4\u0db8\u0dad \u0db8\u0dc0\u0db8\u0dc5\u0db3 \u0db8\u0db4\u0dd2\u0dc5 \u0db4\u0dbb\u0dca\u0db8\u0dd3\u0dc2\u0dca\u0da8\u0dab \u0db1\u0dca\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0db8\u0dda\u0daf;\n\n(vi) \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0db8\u0dc0\u0db8\u0dc5\u0db3 \u0db8\u0db4\u0dd2\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc0 \u0dc0\u0db1 \u0db8\u0dc4\u0ddd\n\n\u0db8\u0dc3\u0dda\u0dc0\u0dd2\u0dc0\u0db1\u0dca \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0dca \u0d9a\u0dbb\u0db1 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0db8\u0dd2\u0db8\u0dda \u0dc3\u0dc4 \u0dc3\u0d82 \u0dd2\u0dbb\u0d9a \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0daf\u0dd0\u0db1 \u0d9a\u0d82\u0dd2 \u0db8\u0daf\u0db1 \u0db8\u0dd6\u0d9a\u0dba \u0db1\u0dd2\u0dba\u0dd2\u0db8\u0db1 \u0db8\u0dc4\u0ddd \u0d85\u0db8\u0dc5\u0dc0\u0dd2\u0d9a\u0dbb\u0dab \u0daf\u0dd2\u0db4\u0dad\u0db8\u0dd0\u0db1\u0dca\u0dd3\u0dda \u0db8\u0dc0\u0db1\u0dca \u0db8\u0dc0\u0db1\u0dca \u0dc0 \u0db8\u0dba\u0db1\u0dca \u0d9a\u0dc0\u0db8\u0dbb\u0dca\u0daf;\n\n\u0dba\u0db1\u0dca\u0db1 \u0d91\u0dad\u0dd4\u0db8\u0dd2 \u0db8\u0db8\u0db8 \u0dc3\u0db7\u0dd2\u0dc0 \u0daf\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db8\u0db1\u0dca\u0daf?\n\n(\u0dca) \u0db8\u0db1\u0dd2 \u0d91\u0db8\u0dc3\u0dda \u0db1\u0dda \u0d92 \u0db8\u0db1\u0dca\u0daf?\n\n\u0ba4\u0bb5\u0bb3\u0bbf\u0ba8\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bb2\u0bc1\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd, \u0ba4\u0bb5\u0bb3\u0bbf\u0ba8\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0bae\u0bb5\u0bae\u0bb2\u0bb5\u0bc6\u0bbe\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bc1 \u0bc7\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bc6\u0bbe \u0b85\u0bae\u0bc7\u0b9a\u0bcd\u0b9a\u0bae\u0bb0\u0b95\u0bcd \u0bae\u0b95\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe:"
