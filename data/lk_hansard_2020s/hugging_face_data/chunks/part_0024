    "chunk_text": "\u0d92\u0db8\u0dcf\u0daf\u0dda \u0db8\u0dc0 \u0dd2\u0db6 \u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dba\u0db4\u0dc4\u0db4\u0dba\u0db8\u0dc4\u0db4\u0dbb\u0dd3 .\u0db8\u0db8\u0dda \u0dda\u0d9a\u0dca\u0dc0\u0db8\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dbd\u0dca\u200d\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0da7 \u0db8\u0dda \u0daf\u0dd9\u0d9a\u0dca\u0dc0\u0dbd\u0db8\u0dda\u0dcf\u0dca\u0dda\u0dca?\u0db8\u0dba\u0daf\u0da2\u0dba\u0db8\u0d86\u0dbd\u0daf\u0dba \u0db8\u0dbd\u0dc5\u0db8\u0dda\u0daf\u0dca\u0db0\u0dc1\u0dd3\u0dba\u0db8\u0dd2\u0dba\u0dc2\u0dca\u0da8\u0dad\u0dba\u0daf\u0dbb\u0dd2\u0dc0\u0dda \u0db8\u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dc0\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0da7 \u0db8\u0d9c\u0dca\u0dda\u0dc0\u0daf\u0dca \u0db8\u0d92\u0db8\u0d85\u0dd2\u0dca\u0db8\u0dda\u0dca\u200d\u0ddd\u0dd9\u0dda \u0db8\u0dba\u0dc4\u0dc5 \u0db8\u0dba\u0da7 \u0db8\u0dbb\u0dcf\u0da7 \u0db8\u0d85\u0dda\u0db4\u0dca\u0db8\u0dba\u0da7 \u0db8\u0dba\u0dca\u0db8\u0dda\u0dcf\u0db1\u0dcf\u0daf.\u0db8\u0d9c\u0dbb\u0dd4\u0db8\u0dd2\u0dba\u0dda\u0dba\u0ddd\u0da2\u0dba\u0db8\u0dd9\u0dcf\u0daf\u0db1\u0daf\u0dba\u0dd9\u0dad\u0dd4\u0db8 \u0dd2\u0dba \u0db8\u0d85\u0db4\u0dd2\u0db8\u0dba\u0da7 \u0d9a\u0dca\u0dc0\u0db8\u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0da7 \u0db8\u0dc3\u0dca\u0d82\u0dcf\u0dbb\u0dca\u0db0\u0db1\u0dba\u0db8\u0dd9\u0dba\u0daf\u0db8\u0dba\u0db1\u0db8\u0d9c \u0dda\u0dca\u0dd3\u0db1\u0db8\u0dda \u0dca\u0db1\u0db8\u0dda \u0db8\u0dba\u0daf\u0da2\u0dba\u0db8\u0d86\u0dbd\u0daf\u0dba \u0db8\u0dcf\u0db4\u0da9\u0dd2\u0db8\u0dd9\u0dba\u0db8\u0d9c\u0dca\u0db1\u0db8\u0d95\u0db1\u0dd1.\u0db8\u0d92\u0db8\u0dba\u0daf\u0da2\u0dba\u0db8\u0d86\u0dbd\u0daf\u0dba \u0db8\u0dbd\u0dc5\u0db8\u0dda\u0daf\u0dca\u0db0\u0dc1\u0dd3\u0dba\u0db8\u0dd2\u0dba\u0dc2\u0dca\u0da8\u0dad\u0dba\u0daf\u0dbb\u0dd2\u0dc0\u0dda \u0db8\u0db4\u0dca\u200d\u0dbb\u0dd2 \u0dc0\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0da7 \u0db8\u0d85\u0dcf \u0db8\u0dcf \u0dda\u0dba\u0dca\u0db815\u0d9a\u0dca\u0dc0 \u0db8\u0d91\u0dda\u0dc4 \u0db8\u0db1\u0db4\u0dca\u0db1 \u0db8\u0d91\u0dc0\u0db4\u0dd2\u0dba\u0dca\u0db8\u0d91\u0dc4\u0daf\u0da7 \u0db8\u0d85\u0db4\u0dd2\u0db8\u0db1\u0d82\u0dcf\u0daf\u0db8\u0d9c\u0dc0\u0db8\u0dd4\u0dad\u0dad\u0dd4\u0db8 \u0dd2\u0db6.\u0db8\n\n\u0d9c\u0dbb\u0dd4\u0db8\u0dd2\u0dba\u0dda\u0dba\u0ddd\u0da2\u0dba\u0db8\u0dd9\u0dcf\u0daf\u0db1\u0daf\u0dba\u0dd9\u0dad\u0dd4\u0db8 \u0dd2\u0dba \u0db8\u0d92\u0db8\u0dcf\u0daf\u0dda \u0db8\u0dc1\u0dca\u200d\u0dbb\u0dd3\u0db8\u0dca\u200d\u0d82\u0dd9\u0daf\u0db8\u0dba\u0da2\u0dda \u0db8\u0dc0\u0dd2 \u0dad\u0dcf\u0dc0\u0dd2\u0dbd\u0dba\u0daf\u0dca\u200d\u0db8\u0dba\u0db1\u0dc0\u0db8\u0dba\u0da7 \u0dda\u0dca\u0db8\u0dc3\u0dca\u0d82\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0db4\u0dd2\u0dc0 \u0db8\u0d92\u0db8\u0d9a\u0dd2\u0dba\u0dca\u0dda\u0dca\u0db8\u0dc3\u0dca\u0d82\u0dc3\u0dca\u0dad\u0dcf\u0daf\u0db4\u0dd2\u0dc0\u0db8\u0d85\u0dda\u0db1\u0d9a\u0dd4\u0dca\u0db8\u0dc0\u0dd2 \u0dad\u0dcf\u0dc0\u0dd2\u0dbd\u0dba\u0daf\u0dca\u200d\u0dcf\u0dca\u200d\u0da7 \u0db8\u0dc0\u0dba\u0daf\u0d9c\u0db8\u0dda\u0dca\u200d\u0dc3\u0dca\u0db8-\u0db8\u0dba\u0db4\u0dad\u0dc0\u0dba\u0daf\u0d9c\u0db8\u0dda\u0dca\u200d\u0dc3\u0dca\u0db8-\u0db8\n\n\u0db4\u0dd2\u0db4\u0dad\u0db1 \u0db1\u0dd4\u0db8\u0dca\u200d\u0dbb\u0db1\u0db8\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db8\u0d92\u0db8\u0dcf\u0dca\u0dd9 \u0db8 \u0daf\u0dbb\u0dd4\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0dd9\u0da7 \u0db8\u0d85\u0db4\u0dd2\u0db8\u0db7\u0daf\u0da2\u0db1\u0db8\u0dd9\u0dba\u0db1\u0dcf\u0daf.\u0db8\u0db8\u0d92\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0d85\u0dba\u0db8\u0d9a\u0dd2\u0dbb\u0dd3\u0dda \u0dd3\u0db1\u0db8\u0d85\u0db4\u0dd2\u0db8\u0dc1\u0dd4\u0daf\u0dca\u0db0\u0db0\u0db8\u0db4\u0dd2\u0db4\u0dad\u0dcf\u0db4\u0dba\u0db8\u0dc3\u0dca\u0dca\u200d\u0dd9\u0db1\u0dd4\u0db8\u0dca\u200d\u0dbb\u0db1\u0dcf\u0daf.\u0db8\u0d92\u0db8\u0dcf\u0daf\u0dda \u0db8\u0d92\u0db8\u0db4\u0dd4\u0daf\u0dca\u0db0\u0d9c\u0dca\u200d\u0dba\u0dca\u0da7 \u0db8\u0d91\u0dda\u0dc4 \u0db8\u0db1\u0db4\u0dca\u0db1 \u0db8\u0dc4\u0dc0\u0dd4\u0dca \u0dd9\u0daf\u0dbb\u0dd3\u0dca\u0dcf\u0dba\u0dca\u0da7 \u0db8\u0d85\u0dbd\u0daf\u0dc5\u0db8\u0dcf\u0db1\u0db8\u0db4\u0dca\u200d\u0dbb\u0daf \u0db0\u0db1\u0db8\u0dca\u200d\u0daf\u0db7\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0d85\u0db1\u0dd4\u0dba\u0daf\u0dd2\u0dd9\u0dba\u0db8\u0dc3\u0dd2\u0dba\u0dba\u0da7 \u0db810\u0db8\u0dd2\u0dc4\u0dca\u200d\u0daf\u0db8\u0dc3\u0dd2\u0dba\u0dba\u0da7 \u0db815\u0db8\u0dbd\u0d9a\u0dca\u0dc0\u0dcf\u0daf\u0db8\u0dcf\u0db4\u0da9\u0dd2\u0db8\u0dd9\u0dba\u0db1\u0dcf\u0daf.\u0db8\u0db1\u0dd4\u0daf\u0dca\u0db8\u0d85\u0dda\u0db1\u0d9a\u0dca\u0dc0\u0db8\u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0db8\u0d86\u0dba\u0dc0\u0db1\u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0d85\u0dbd\u0daf\u0dc5\u0db8\u0dcf\u0db1\u0db8\u0db4\u0dca\u200d\u0dbb\u0daf \u0db0\u0db1\u0db8\u0dca\u200d\u0daf\u0db7\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0d85\u0db1\u0dd4\u0dba\u0daf\u0dd2\u0dd9\u0dba\u0db8\u0dc3\u0dd2\u0dba\u0dba\u0da7 \u0db8]0\u0db8 \u0da7\u0dca\u0da7 \u0dda \u0db8\u0dba\u0dcf\u0dca\u0dcf\u0daf\u0db8\u0dda\u0d9c\u0db1\u0db8\u0dba\u0db1\u0dd4\u0db8\u0dca\u200d\u0dbb\u0db1\u0dcf\u0daf.\u0db8\u0dda \u0dca\u0db1\u0db8\u0dda \u0db8\u0d86\u0dd9\u0daf\u0dba\u0dba\u0da7 \u0db8\u0d85\u0db4\u0dd2\u0db8\u0dc3\u0dca\u0d82\u0dda \u0ddd\u0db0\u0db1\u0db8\u0dc0\u0dd2 \u0daf\u0dca\u200d\u0db8\u0db4\u0dca\u200d\u0dbb \u0daf\u0dda\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dc4\u0dba\u0dc4\u0daf\u0db8\u0d85\u0dda\u0db4\u0dca\u0db8\u0dba\u0dda\u0da7\u0dca\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0db8\u0dc3\u0dca\u0d82\u0d9a\u0dd3\u0dbb\u0dca\u0dda\u0db8\u0dc0\u0dd6\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dba\u0daf\u0dca\u0db0\u0db0\u0dd2\u0dba\u0db8\u0dc3\u0dca\u0dba\u0dca\u200d\u0db8\u0dd9\u0dba\u0dca\u200d\u0daf \u0db8\u0dbb\u0daf\u0dd4\u0db8\u0d85\u0db1\u0dd4\u0dd6\u0dbd\u0dca\u200d\u0dc0\u0daf\u0dcf\u0db8\u0d87\u0dd2\u0db8\u0dd9\u0dba\u0dca\u200d\u0daf \u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dba\u0dbd\u0db1 \u0db8\u0db4\u0dd4\u0dc5\u0dd4\u0dca \u0db8\u0dd9\u0dba\u0dca\u200d\u0daf\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dba\u0daf\u0dca\u0db0\u0db0\u0dd2\u0dba\u0db8\u0dd9\u0daf\u0dbb\u0dca\u0dba\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8 \u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0da7 \u0dd2\u0db6\u0db8\u0dda \u0db8\u0dd9\u0da7 \u0dd4\u0dad\u0dad\u0dd4\u0db8\u0db8\u0dd9\u0dba\u0dca\u0dda\u0dca.\u0db8\u0d91\u0dda\u0dc4 \u0db8\u0db1\u0db4\u0dd2\u0dcf\u0db8\u0d85\u0dba\u0dba\u0daf\u0db0\u0db8\u0dd3\u0db8\u0dd2\u0dba\u0db8\u0db1\u0db4\u0dcf\u0dc0\u0db8\u0dcf\u0dc0\u0daf\u0dcf\u0d9a\u0dca\u0dc0\u0db8\u0dda \u0db8\u0dba\u0dda\u0da7\u0dca\u0db8\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dca \u0dd9\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0da7 \u0db8\u0dda\u0db1\u0daf\u0dda\u0dcf\u0dd2\u0db6.\u0db8\u0dba \u0db8\u0d9a\u0dd2\u0dc3\u0dd2\u0db8\u0db4\u0dd4\u0daf\u0dca\u0db0\u0d9c\u0dca\u200d\u0dda\u0dba\u0d9a\u0dd4\u0db8\u0db8\u0dbb\u0daf\u0dd4\u0db8\u0dda\u0d9c\u0dcf\u0dca\u0dda\u0dca\u0db8\u0db1\u0db4\u0dca\u0db1 \u0db8\u0d92\u0db8\u0dba\u0db4\u0dc4\u0db4\u0dba\u0db8\u0dc4\u0db4\u0dbb\u0dd3 \u0db8\u0dc3\u0dca \u0dbb\u0dca\u0db0\u0dda\u0dba\u0dca\u0db8\u0d9a\u0dca\u200d\u0dbb \u0daf\u0db1\u0dd4\u0dd6\u0dbd\u0dca\u200d\u0dcf\u0db8\u0db4\u0dd2\u0dba\u0dcf\u0dba\u0db8\u0d9c\u0db4\u0dd3\u0db8\u0dda \u0db8\u0db4\u0dd2\u0dc5\u0dd2\u0dda\u0dcf\u0dc5\u0d9a\u0dca\u0dc0\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf;\u0db8\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dbd\u0daf \u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf.\u0db8\u0db8\u0d9a\u0dca\u200d\u0dbb \u0daf\u0db1\u0dd4\u0dd6\u0dbd\u0dca\u200d\u0dcf\u0db8\u0dc0 \u0dd2\u0db6\u0db8\u0d92\u0db8\u0dd9\u0da7 \u0dd4\u0dad\u0dad\u0dd4\u0db8\u0db8\u0dc3\u0dd2\u0daf\u0dd4\u0db8\u0dda\u0dcf\u0dca\u0dda\u0dca.\n\n\u0d85\u0db4\u0dd2\u0db8\u0dda \u0db8\u0dda \u0daf\u0dda\u0dc4\u0daf\u0dda\u0dca\u0db8\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca\u200d\u0db8\u0d85\u0dcf\u0db4\u0dca\u200d\u0dbb \u0daf\u0dda\u0dba\u0db8\u0dc0\u0dd3\u0db8 \u0db8\u0db4\u0dd2\u0dc5\u0dd2\u0dbb\u0dc4\u0db8\u0dc3\u0dca\u0daf\u0dd9\u0da0\u0dca\u0da1\u0daf\u0dcf\u0dd9\u0db8\u0dd2\u0dca\u0dda\u0dca.\u0db8\u0dc0\u0dd2\u0dc0\u0dd2\u0db0\u0db8\u0dba\u0daf\u0dbb\u0dca \u0dad\u0dcf\u0db8\u0dc0\u0dd2\u0dc0\u0dd2\u0db0\u0db8\u0d85\u0dbb\u0dca\u0dcf\u0dd9\u0dcf\u0db1\u0db8\u0dda\u0dbd\u0db1\u0dcf\u0daf\u0db8\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dca\u200d\u0db8\u0d85\u0dcf\u0db4\u0dca\u200d\u0dbb \u0daf\u0dda\u0dba\u0db8\u0dc0\u0dd3\u0db8 \u0db8\u0db4\u0dd2\u0dc5\u0dd2\u0dbb\u0dc4\u0dcf.\u0db8\u0dc0\u0dd2\u0dda \u0dad\u0dc2\u0dca\u0da8\u0dda\u0dba\u0dca\u0db8\u0d85\u0dba\u0da7 \u0db8\u0d91\u0dda\u0dba\u0dc4\u0dd2\u0db8\u0dcf\u0dca\u0db1\u0dca\u0db8\u0d9a\u0dd2\u0dba\u0db1\u0dcf\u0daf \u0db8\u0dda \u0dd9\u0db8\u0d85\u0dda\u0db4\u0dca\u0db8\u0da2\u0daf\u0dd2\u0dd9\u0db8\u0da2\u0db1\u0db8\u0dbb\u0dca\u200d\u0dda\u0dc1\u0d9c\u0dda \u0db8\u0d85\u0dd9\u0daf\u0dbb\u0dca\u0dba\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8 \u0dc0\u0daf\u0dcf\u0db8\u0d9a\u0dd2\u0dba\u0dca\u200d\u0daf.\u0db8\u0db1\u0db4\u0dc4\u0db4 \u0db8\u0d85\u0db4\u0dd2\u0db8\u0dbd\u0dca\u0db1\u0dcf\u0daf\u0db8\u0dda \u0db8\u0dda \u0daf\u0dda\u0dc4\u0daf\u0dc0\u0db8\u0dcf\u0db1\u0db8\u0dc0\u0dd2\u0da7 \u0db8\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dda\u0dca \u0db8\u0d85\u0d9c\u0dba\u0db8\u0dba\u0dc4\u0dc0\u0db8\u0dcf\u0db4\u0da7\u0dd3 \u0da7 \u0db8\u0dbb\u0dca\u200d\u0dba\u0daf\u0db1\u0db8\u0dd9\u0daf\u0dba\u0dda\u0daf\u0db8\u0dc0\u0dd2 \u0daf\u0dca\u200d\u0db8\u0db4\u0dca\u200d\u0dbb \u0daf\u0dda\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0db8\u0dbb\u0dcf.\u0db8\u0d91\u0dd9\u0d9a\u0dca\u0dc0\u0db8\u0dc0 \u0dd2\u0db6 \u0db8 \u0db4\u0dbd\u0db8\u0dda\u0dba\u0dba\u0dbb\u0dd2\u0d9c\u0db8\u0dd9\u0dca\u200d\u0daf\u0dba\u0dda \u0db8\u0dba\u0dcf\u0dd2\u0db1\u0db8\u0dd4\u0dad\u0dbd \u0dba\u0db8\u0dc0\u0dca\u0dca\u0dcf\u0dba.\u0db8\u0dda \u0db8\u0dd2\u0dba\u0dc3\u0dca\u0daf\u0db8\u0db1\u0db4\u0dc1\u0db8\u0d9c\u0daf\u0dc3\u0dca\u0dad\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0db4\u0da9\u0dd2\u0db8\u0dda\u0dcf\u0dca\u200d\u0daf \u0db8\u0dba\u0d9a\u0dca\u0dc0\u0dc2\u0dca\u0da8\u0dda\u0db8\u0d9c\u0daf\u0dc3\u0dca\u0dad\u0dad\u0dd4\u0db8\u0db8\u0dcf\u0db4\u0da9\u0dd2\u0db8\u0dda\u0dcf\u0dca\u200d\u0daf \u0db8\u0d85\u0d9a\u0dbb\u0db7\u0daf\u0dba\u0dba\u0dca\u0db8\u0dcf\u0db4\u0da9\u0dd2\u0db8\u0dda\u0dcf\u0dca\u200d\u0daf.\u0db8\u0dda \u0db8\u0dda \u0daf\u0dda\u0dc4\u0daf\u0dc0\u0db8\u0dcf\u0db1\u0db8\u0dc0\u0dd2\u0da7 \u0db8\u0dda\u0dbb\u0daf\u0dba\u0dda\u0dc0\u0dca \u0db8\u0dbb\u0db4\u0dba\u0dca\u200d\u0dba\u0dd9\u0db8\u0db8\u0dd2\u0dca\u200d\u0db8\u0dc0\u0dd2 \u0daf\u0dca\u200d\u0db8\u0dcf \u0dda\u0dba\u0dca\u0db8\u0dcf\u0db4\u0da9\u0dd2\u0db8\u0dda\u0dcf\u0dca\u200d\u0daf.\u0db8\u0d92\u0db8\u0dcf\u0daf\u0dda \u0db8\u0d86\u0db1\u0dba\u0db1\u0dba\u0db8\u0d9a\u0dd2\u0dbb\u0dd3 \u0db8\u0dc3\u0dca\u0dc4\u0dc4\u0daf\u0db8\u0d85\u0db4\u0dd2\u0da7 \u0db8\u0db8\u0dda\u0db4\u0daf\u0dca\u200d\u0dbb\u0dca\u0db8\u0db4\u0dca\u200d\u0dbb \u0daf\u0dda\u0dba\u0d9a\u0dca\u0dc0\u0db8\u0dcf\u0db4\u0dba\u0db8\u0dd9\u0dba\u0dca\u0db1\u0db8\u0dc3\u0dd2\u0daf\u0dca\u0db0\u0db0\u0db8\u0dda\u0dcf\u0dca\u200d\u0daf\u0db8\u0dd2\u0dda\u0dbb\u0db1\u0dcf\u0daf.\u0db8"
