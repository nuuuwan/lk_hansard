    "chunk_text": "\u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0dad\u0dc3 \u0da2\u0dba \u0dab\u0dae\u0dcf\u0db1\u0dcf\u0dc3\u0dab\u0dad\u0dd4\u0db8\u0dc3\u0dd2\u0dba, \u0d9f\u0db4\u0dd2 \u0d94\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0db0\u0dd3\u0d9a\u0dbd\u0dcf\u0da7 \u0d9c\u0dbb\u0dd4 \u0dab \u0db1\u0dc0\u0dcf, \u0d94\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0db0\u0dd3\u0d9a\u0dbd\u0dcf \u0d86\u0dca\u0da9\u0dd4 \u0db4\u0d9a\u0dca \u0dc4\u0dc2\u0dad\u0dc3\u0db0\u0dd3\u0d9a \u0db4\u0dda \u0dc0\u0dd4\u0dab\u0dd4 \u0dad\u0db6\u0db1 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dad\u0db6\u0db1\u0db0\u0dd3\u0d9a\u0dad\u0dd4\u0dad\u0dda \u200d\u0db0\u0dcf\u0db1 \u0dd4\u0dd3\u0d9c\u0dbd\u0dc3\u0db0\u0dd3\u0d9a \u0dad\u0dbd\u0dc3\u0dca\u0dad\u0dca\u200d. \u0db1\u0db8\u0dd4\u0dda, \u0dad\u0db6\u0db1 \u0dab\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dbd \u0dc3\u0dd3\u0db8\u0dc3\u0dcf\u0dc0\u0d9a\u0dca \u0dc4 \u0dd2\u0dba\u0dad\u0dca\u0db1\u0dc0\u0dcf. \u0dc3\u0dd4\u0dd2\u0dba\u0dca \u0dc0\u0da7\u0d9c\u0dbd \u0dd2\u0dba\u0dad\u0dc3 \u0da2\u0dba \u0d87\u0db8\u0dc3\u0dd2\u0dba\u0dad\u0dd4\u0db8\u0dc3\u0dcf \u0d9a\u0dd2\u0dc3\u0dd4 \u0d91\u0dab \u0dad\u0db1\u0dcf\u0dad\u0dc0\u0dba\u0dd2 \u0db8\u0dc3\u0db8\u0dc3 \u0d9a\u0dd2\u0dc3\u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a. \u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0dad\u0dc3 \u0da2\u0dba \u0dab\u0dae\u0dcf\u0db1\u0dcf\u0dc3\u0dab\u0dad\u0dd4\u0db8\u0dc3\u0dd2\u0dba, \u0d94\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0dcf \u0dca\u0dbd\u0db0\u0dd3\u0d9a\u0db1, 77\u0dc0\u0dd0\u0dd2\u0dba \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae\u0dcf\u0dc0 \u0dd2\u0dba\u0dad\u0dc3 \u0d9c\u0dad\u0dda \u0dd2\u0db3\u0dbd\u0dcf \u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc3\u0dca\u0dad\u0dca\u200d \u0da7 \u0dad\u0db8\u0dc3\u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0dd2\u0dba\u0dad\u0dca\u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a \u0d9a\u0dd2\u0dc3\u0dbd\u0dcf. \u0d94\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0db0\u0dd3\u0d9a\u0dbd\u0dcf \u0dad\u0db6\u0db1\u0dc0\u0dcf \u0dc3\u0dca\u0dad\u0dca\u200d\u0db6\u0db1\u0dca\u0db0\u0dd3\u0d9a\u0db0\u0dad\u0dc3\u0db0\u0dd3\u0d9a \u0dad\u0db8\u0dc3\u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0dab \u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a? \u0daf\u0dd0\u0db0\u0dd3\u0d9a \u0d9c\u0dbb\u0dd4 \u0dbb\u0dca\u0dc2 \u0daf \u0dd2\u0db1\u0dca \u0dc0\u0dcf \u0db8\u0dc3\u0db0\u0dd3\u0d9a\u0dd3\u0dad\u0dd4\u0db8\u0dc3\u0dcf \u0d9a\u0dd2\u0dc3\u0dd4 \u0dd2\u0dba\u0dc3\u0dca\u0dad\u0dca\u200d\u0dcf \u0d94\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0dcf \u0d9a\u0dd2\u0dc3\u0db1\u0dc0\u0dcf, \u0d92 unparliamentary words \u0d9f\u0dba\u0dd2\u0db0\u0dd3\u0d9a \u0dab \u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dc3\u0dbd\u0dcf. \u0d94\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0dcf \u0dca\u0dbd\u0db0\u0dd3\u0d9a\u0db1\u0dad\u0dab , \u0dc3\u0dca\u0dad\u0dca\u200d\u0db8\u0dc3 \u0db8\u0dc3\u0db0\u0dd3\u0d9a\u0dd3\u0dc0\u0dbb\u0dd4 \u0dad\u0db6\u0db1 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db7\u0dcf\u0dc0 \u0dad\u0dab\u0dcf\u0da0\u0dca\u0da0 \u0db1\u0db6\u0db1 \u0dab\u0dd0\u0dbb \u0dab \u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dd2\u0dc3\u0dbd\u0dcf. \u0db8\u0dc3\u0db8\u0dc3 \u0d94\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0dcf\u0da7 \u0dd2\u0dba\u0dd2\u0db1 \u0dad\u0d9c\u0dde \u0dc0\u0dc3 \u0d87\u0dd2\u0dba\u0dc0\u0dba\u0dd2 \u0dad\u0db6\u0db1 \u0d9a\u0dd2\u0dc3\u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a. 77 \u0dc0\u0dd0\u0dd2\u0dba \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae\u0dcf\u0dc0 \u0dd2\u0dba\u0dad\u0dc3 \u0d9c\u0dad\u0dc3\u0db0\u0dd3\u0d9a \u0db4\u0da7\u0db0\u0dd3\u0d9a \u0d9c\u0dda\u0dbb\u0dcf\u0db8\u0dc3, 78, 79 \u0dc3\u0db1 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae\u0dcf\u0dc0 \u0dd2\u0dba\u0dad\u0dc3 \u0d9c\u0dda \u0dca\u0dbd\u0db0\u0dd3\u0d9a\u0db1. 79 (1) \u0dc4\u0dd2 \u0dad\u0db8\u0dc3\u0dad \u0db8\u0dc3 \u0dd2\u0dba\u0dad\u0dca\u0db1\u0dc0\u0dcf:\n\n\"\u0dca \u0db4\u0dbb\u0dc5 \u0dad\u0dbd\u0dc3\u0dca\u0dad\u0dca\u200d \u0dd2\u0db1\u0dc3 \u0dd2\u0dad \u0dbb\u0dc0 \u0dd0\u0dd2\u0db1\u0dad \u0db1 \u0db8\u0dc3\u0db0\u0dd3\u0d9a\u0dd3\u0dc0 \u0dc3\u0d89\u0da7 \u0d91\u0daf\u0dd2\u0db1 \u0d9a\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dd3\u0dad\u0db6\u0db1 \u0dd2\u0dd2\u0dba\u0daf\u0dcf \u0dad\u0dab\u0dcf\u0da7\u0dc3\u0dca\u0dad\u0dca\u200d \u0d9f\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0db0\u0dd3\u0d9a \u0dc0\u0db1 \u0dad\u0dbb\u0d9a\u0dca \u0dc4 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dad\u0db6\u0db1\u0db0\u0dd3\u0d9a\u0dad\u0dd4\u0dad\u0dc0\u0db0\u0dd3\u0d9a \u0dc0 \u0dcf \u0db8\u0dc3 \u0dd2\u0dc0\u0dda \u0dc0\u0db1 \u0dad\u0dbd\u0dc3\u0dca\u0dad\u0dca\u200d \u0dab\u0dae\u0dcf\u0db1\u0dcf\u0dc3\u0dab\u0dc0 \u0dc3\u0dcf \u0dd2\u0dd2\u0db1\u0db0\u0dd3\u0d9a \u0dd2\u0dba\u0dad\u0dc3 \u0d9c \u0dab \u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd2\u0dc3 \u0dba\u0dd4\u0dad\u0dd4 \u0d9f\u0dbb , ...\u0daf\n\n\u0d91\u0dad\u0dd4\u0db8\u0dc3\u0dcf\u0dad \u0dc0\u0db6\u0db1 \u0db4\u0dd0\u0dda\u0dad\u0dda\u0dda \u0dd2\u0db0\u0dd3\u0d9a\u0db1\u0dc0\u0dcf, \u0db4\u0dd2\u0da7\u0dd4\u0db4\u0dc3\u0dca\u0dad\u0dca\u200d\u0dda \u0dd2\u0db0\u0dd3\u0d9a\u0db1\u0dc0\u0dcf. \u0d92 \u0d94\u0d9a\u0dca \u0dc4\u0dad\u0dab \u0db8\u0dc3 \u0dd2\u0db4\u0d9a\u0dca \u0dc4\u0dc2\u0dad\u0dda \u0db8\u0dc3\u0db0\u0dd3\u0d9a\u0dd3\u0dc0\u0dbb\u0dd4. \u0d95\u0db1\u0dd1 \u0db1\u0db6\u0db1 \u0d9f\u0db4\u0da7 \u0db1\u0db6\u0db1 \u0dc0\u0dba\u0dad\u0dc3\u0db0\u0dd3\u0d9a \u0d9a\u0dd2\u0dc3\u0db0\u0dd3\u0d9a\u0db1\u0dda \u0dd4\u0dc5\u0dd4\u0dc0\u0db0\u0dd3\u0d9a. \u0db8\u0dc3\u0db8\u0dc3 truely \u0dad\u0db6\u0db1\u0dab \u0d9a\u0dd2\u0dc3\u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a. \u0d87\u0dda\u0dbb\u0da7\u0db8\u0dc3 \u0d94\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0dcf \u0dc3\u0dca\u0dad\u0dca\u200d\u0dcf\u0db0\u0dcf \u0dad\u0dbd\u0dc3\u0dca\u0dad\u0dca\u200d \u0dab\u0dca \u0db4\u0db1\u0dcf \u0dab \u0dbd\u0dcf \u0dca\u0dbd\u0db0\u0dd3\u0d9a\u0db1. \u0dad\u0db8\u0dc3\u0dbb\u0dd0\u0db1 \u0dd2\u0db0\u0dd3\u0d9a\u0db1 \u0d9f\u0dc3\u0dad\u0d9c\u0db0\u0dd3\u0d9a \u0d92 \u0dd2\u0db0\u0dd2\u0dc3\u0da7 \u0dab\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dab \u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a \u0dab\u0dc0\u0dd4\u0daf? \u0dca\u0dd0\u0daf\u0dcf\u0db8\u0dc3 \u0dbb\u0dd0\u0db1 \u0dbb\u0db8\u0dc3\u0dba\u0dd2 \u0db8\u0dc3\u0db8\u0dc3 \u0dad\u0db6\u0db1 \u0dab\u0dae\u0dcf \u0dab \u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a. \u0db8\u0dc3\u0da7 \u0dad\u0db6\u0db1 tone \u0d91\u0dab \u0d91\u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a\u0dda \u0d92 \u0dd2\u0dba\u0dc3\u0dca\u0dad\u0dca\u200d\u0dcf\u0dba\u0dd2, \u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0dad\u0dc3 \u0da2\u0dba \u0dab\u0dae\u0dcf\u0db1\u0dcf\u0dc3\u0dab\u0dad\u0dd4\u0db8\u0dc3\u0dd2\u0dba. \u0dad\u0dab\u0dcf\u0dad \u0dcf\u0db8\u0dc3 \u0dc0\u0dd4 \u0dda \u0db8\u0dc3\u0db8\u0dc3 \u0d94\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0dcf\u0da7 \u0dd2\u0dba\u0dd2\u0db1 \u0dad\u0d9c\u0dde \u0dc0\u0dc3 \u0d87\u0dad\u0dd4\u0dc0\u0dba\u0dd2 \u0dad\u0db6\u0db1 \u0dab\u0dae\u0dcf \u0dab \u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a. \u0dad\u0db6\u0db1 \u0db4\u0dcf\u0dbb\u0dca\u0dd2\u0dad\u0db6\u0db1\u0db0\u0dd3\u0d9a\u0dad\u0dd4\u0dc0 \u0dad\u0dd4\u0dc5 77\u0dc0\u0dd0\u0dd2\u0dba \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae\u0dcf\u0dc0 \u0dd2\u0dba\u0dad\u0dc3 \u0d9c\u0dc3 \u0dab\u0da9\u0dbd\u0dbd\u0dcf \u0db1\u0dd0\u0dd3\u0daf? \u0dab\u0da9\u0dbd\u0dbd\u0dcf \u0dd2\u0dba\u0dad\u0dca\u0db1\u0dc0\u0dcf. \u0d9c\u0dbb\u0dd4 \u0dd2\u0dba\u0dad\u0dc3 \u0da2\u0dba \u0dab\u0dae\u0dcf\u0db1\u0dcf\u0dc3\u0dab\u0dad\u0dd4\u0db8\u0dc3\u0dd2\u0dba, \u0db1\u0db8\u0dd4\u0dda, \u0d94\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0db0\u0dd3\u0d9a\u0dbd\u0dcf \u0dad\u0db8\u0dc3\u0dcf\u0d89\u0dda\u0db8\u0dc3 \u0dab \u0dbd\u0dcf \u0db1\u0dd0 \u0dd0. \u0db8\u0dc3\u0db0\u0dd3\u0d9a\u0dd3\u0dad\u0dd4\u0db8\u0dd2\u0dc3\u0dbd\u0dcf\u0da7 \u0d89\u0dab\u0dd4 \u0dbb\u0dd4\u0db4\u0dad\u0dc3\u0db0\u0dd3\u0d9a \u0dca\u0dab\u0dd2\u0db1\u0dc0\u0dcf \u0dd0\u0db8\u0dc3\u0daf\u0dcf\u0db8\u0dc3. \u0dad\u0db8\u0dc3\u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0d94\u0dca\u0dad\u0dd4\u0db8\u0dc3\u0db0\u0dd3\u0d9a\u0dbd\u0dcf \u0dab \u0dbd\u0dcf \u0dd2\u0dba\u0dad\u0dca\u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a? \u0dad\u0db8\u0dc3\u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0dad\u0dca \u0dab\u0db6\u0db1 \u0db8\u0dc3\u0dca\u0da9\u0dbd\u0dbd\u0dc3 \u0dab \u0dbd\u0dcf \u0dd2\u0dba\u0dad\u0dca\u0db0\u0dd3\u0d9a\u0dad\u0db0\u0dd3\u0d9a?"
