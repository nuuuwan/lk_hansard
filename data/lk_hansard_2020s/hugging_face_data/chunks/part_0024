    "chunk_text": "\u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0dca\u0db1 \u0dba\u0dca\u0dc0\u0dca \u0db1\u0dd0\u0dc4\u0dc3\u0dd00 \u0d92\u0dc0\u0dcf \u0dca\u0dd2\u0db1\u0dc4\u0dc3\u0dcf\u0dca\u0dba \u0dad\u0dd4 \u0dc5 \u0db8\u0d9a\u0dcf \u0daf\u0dd0\u0db8\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dcf\u0dbd \u0dc0\u0d9a\u0dc0\u0dcf\u0db1\u0dd40 \u0dc0\u0dcf\u0dca\u0db1\u0dcf\u0dc0\u0d9a \u0db4\u0dcf\u0dca\u0dbd\u0dd2\u0db8\u0dc0\u0db1\u0dca\u0dad\u0dd4 \u0dc0 \u0d86\u0db4\u0dd4 \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db1 \u0dc0\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dba \u0d85\u0dca\u0dcf\u0dca\u0dae\u0d9a\u0dad\u0dca\u0dc0\u0dba \u0dc0\u0dc4\u0dc3\u0db8\u0dca\u0db1 \u0d9a\u0da7\u0dd2\u0dca \u0dc0\u0dd2\u0dad\u0dbb\u0dca \u0db6\u0dad\u0dbd \u0dc4\u0dd2 \u0dc0\u0dca\u0db1 \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0d85\u0dc0\u0dca\u0dcf\u0db1\u0dc0\u0dda \u0dad\u0db8\u0dca\u0dc0\u0dc3 \u0daf\u0db1\u0dca \u0db4\u0dc0\u0dd4\u0dbd\u0dca\u0dc0\u0dbd .\u0da9\u0dc0\u0dad\u0dca \u0dc0\u0dc0\u0dca\u0db1 \u0dd2\u0db1\u0dc0\u0db6\u0db1 \u0db1\u0dd2\u0dc0\u0dca \u0d85\u0dc4\u0dd2\u0db8\u0dd2 \u0d9a\u0dbb\u0db8\u0dca\u0db1 \u0d91\u0db4\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf0 \u0d92 \u0db1\u0dd2\u0dca\u0dcf \u0dc0\u0db1 \u0d9a\u0dcf\u0dbd \u0dc0\u0d9a\u0dc0\u0dcf\u0db1\u0dd4\u0dc0 \u0dad\u0dd4 \u0dc5 \u0dc0\u0db6\u0dcf\u0dc0\u0dc4\u0dc3\u0dcf\u0db8 \u0d9a\u0dbd\u0dca\u0db4\u0db1\u0dcf\u0dc0\u0dc0\u0dca \u0dad\u0db8\u0dca \u0dbd\u0dd0\u0db6\u0dd2\u0da0\u0dca\u0da0\u0dd4 \u0da2\u0dca\u200d\u0db1 \u0dc0\u0dbb\u0db8 \u0d85\u0db1\u0dd4\u0dc0 \u0da2\u0dca\u200d\u0db1\u0dad\u0dcf\u0dc0 \u0dc0\u0dc0\u0db1\u0dd4\u0dc0\u0dc0\u0dca \u0dc0\u0db4\u0db1\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0dca\u0db10 \u0dc0\u0db1 \u0dbb \u0d9a\u0dcf\u0dbd\u0d9a\u0dab\u0dca\u0dab\u0dd2 \u0d9a\u0dbb\u0db1 \u0dc0\u0db1 \u0dbb \u0dc4\u0dc3\u0dd2\u0dba\u0dba \u0db4\u0dd2\u0dba\u0db4\u0dcf\u0dbd\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dca\u0db1 \u0db6\u0dd0\u0dd2\u0dba \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db1\u0dc0\u0dbd \u0d86\u0dc0\u0da9\u0dca\u0db1 \u0d92 \u0d85\u0dba \u0db4\u0dd2\u0da7\u0dd4\u0db4\u0dca \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0dad\u0db8\u0dca\u0dc0\u0dc3 \u0daf\u0db1\u0dca \u0db4\u0dc0\u0dd4\u0dbd\u0dca \u0d85\u0db1\u0dcf\u0dae \u0d9a\u0dbb\u0dca\u0db1 \u0d91\u0db4\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0daf \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1 \u0db8\u0dcf\u0dbd\u0dd2\u0db8\u0db8\u0dcf\u0dc0\u0dda \u0db8\u0dca\u0dd3\u0dc0\u0db1\u0dca\u0dca \u0d85\u0db4\u0dd2 \u0d9a\u0dd2\u0dba\u0dca\u0dc0\u0dca0\n\n\u0d92 \u0dc0\u0dcf\u0dc0\u0dc3\u0db8 \u0dd3 \u0db8\u0dd2\u0dbd \u0db8\u0dd0\u0db1\u0dad\u0dca \u0dc0\u0db8\u0dad\u0dd0\u0db1\u0daf\u0dd3 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf0 \u0db1\u0dcf\u0da9\u0dd4 \u0dd3 \u0d9a\u0dd2\u0dc0\u0dbd\u0ddd\u0dc0\u0dca \u0dca\u0db3\u0dc4\u0dc3\u0dcf \u0db1\u0dca\u0db4\u0dd2\u0dba\u0dbd\u0dca 120\u0d9a \u0db8\u0dd2\u0dbd\u0dca \u0daf\u0dd4\u0dca\u0db1\u0dcf \u0d9a\u0dd2\u0dda\u0dc0\u0dcf0 \u0d85\u0daf \u0db1\u0dca\u0db4\u0dd2\u0dba\u0dbd\u0dca 120 \u0db1\u0dcf\u0da9\u0dd4 \u0dd3 \u0d9a\u0dd2\u0dc0\u0dbd\u0ddd\u0dc0\u0dca \u0dc0\u0dd2\u0d9a\u0dd4 \u0db4\u0dd4 \u0dc0\u0db8\u0dcf\u0dc0\u0dd2\u0dc0\u0dba\u0dca \u0dca\u0dca\u0db1\u0dc0\u0dcf\u0daf? \u0daf\u0dd0\u0dca \u0dc0\u0db4\u0dcf\u0dc0\u0dc4\u0dc3\u0dcf\u0dbb \u0db8\u0dd2\u0dbd\u0daf\u0dd3 \u0db8\u0dca\u0db1 \u0dc0\u0db8\u0dcf\u0dd3\u0dca \u0dd3 \u0da7\u0dd2\u0d9a \u0dc0\u0dd2\u0d9a\u0dd4 \u0dca\u0db1 \u0dc3\u0dd2\u0daf\u0dca\u0db0 \u0dc0\u0db1 \u0d9a\u0dcf\u0dbd\u0dba \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0dd2\u0db1\u0dc0\u0db6\u0dca\u0dc0\u0dca0 \u0d85\u0daf \u0db1\u0dca\u0db4\u0dd2\u0dba\u0dbd\u0dca 9. \u0dca\u0db3\u0dbd\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0dd3 \u0d9a\u0dd2\u0dc0\u0dbd\u0ddd\u0dc0\u0d9a \u0dc0\u0dd2\u0d9a\u0dd4\u0dd4\u0db1 \u0db8\u0dd2\u0dbd \u0db1\u0dd2\u0dba\u0db8 \u0dc0\u0dc0\u0dca\u0dc0\u0dca0 \u0db8\u0dcf\u0dca \u0db8 \u0db1\u0dca \u0dd2\u0db1\u0dca\u0db4\u0dc0\u