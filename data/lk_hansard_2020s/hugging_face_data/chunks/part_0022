    "chunk_text": "\"\u0daf\u0da7\u0dca\u0da7\u0dcf\" \u0dd4\u0dc5\u0dc5\u0dd2 \u0d9a\u0dd4\u0dda\u0dcf\u0db4\u0dca\u0da7 \u0db1\u0dd2\u0d9a\u0dcf \u0db8 \u0dc0\u0dba\u0dda 646\u0d9a\u0dca \u0db8\u0da7\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0dad\u0da7\u0db8 \u0dc0 \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u0da8[\u0dba\u0dd2 \u0db8\u0da7\u0da7\u0dcf \u0dd2\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad. \u0dad\u0dc4\u0dd4\u0db1\u0dca\u0dad\u0dca\u0dcf\u0db1\u0dca\u0dad\u0db8\u0d9a\u0dda\u0dbd\u0dcf\u0db8 \u0da2\u0dca\u0dcf\u0d9a\u0dbb\u0db4\u0dd2\u0dd4\u0db8 \u0dc0\u0dcf \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0da7\u0db4 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0dbb\u0dd3\u0dda\u0da7\u0dcf, \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca 2 , ]]] \u0dc3\u0dd2\u0db4 \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u0da8 2]] \u0db8\u0da7\u0dca\u0dd9\u0dda \u0db8\u0da7\u0da7\u0dca\u0da7\u0dcf \u0dbb\u0dd3[\u0dbd\u0dcf. \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u0da8 2] \u0dad\u0da7\u0db8 \u0dc0 \u0db8\u0da7\u0da7\u0dcf \u0dca\u0dd4\u0dcf\u0dd4. \u0db8\u0dda\u0da7\u0dcf \u0da7\u0dd4\u0dca \u0da7\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0da7\u0d9a\u0dca \u0dad\u0daf\u0dd2\u0db8\u0db4 \u0d9a \u0dd9\u0dba\u0db1\u0dca\u0dad\u0dca. \u0d92 \u0dc0\u0dd2\u0dad\u0dba\u0d9a\u0dca \u0db8\u0dca\u0dcf\u0db8\u0da7\u0dba\u0dd2. \u0d91\u0db8 \u0dc0 \u0d86\u0db4 \u0dcf\u0da7 \u0db1\u0dd2\u0d9a\u0dcf 275\u0db8 \u0db8\u0dca\u0d9a\u0dca \u0d85\u0dd4\u0dc0 \u0dcf\u0db1\u0dca\u0dad \u0dc0\u0dd4\u0dda\u0dcf. \u0d85\u0dd4\u0dc0 \u0dcf\u0db1\u0dca\u0dad \u0dc0\u0dd4\u0dab\u0dd4 \u0d85[\u0db4 \u0da7\u0db1\u0dca\u0dad\u0daf \u0db8\u0da7\u0da7\u0db1\u0dca\u0dad\u0dca \u0db6\u0dd4\u0dcf\u0dd4, \u0db8 \u0dc0\u0dba\u0dda \u0d9a\u0dcf\u0dd2\u0dd9[ \u0dbd\u0dd4\u0db8\u0db6\u0dca\u0dd9\u0dda. \u0d85\u0db4\u0dd2 \u0d85\u0dcf\u0dca\u0da7\u0dcf, \u0d92\u0dd9\u0db4 \u0dad\u0dc4\u0dd4\u0db1\u0dca\u0dad\u0dca\u0dcf\u0db1\u0dca\u0dad\u0db8\u0d9a\u0dda\u0dbd\u0dcf \u0da7\u0db1\u0dca\u0dad\u0dca\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2[\u0dcf\u0db8 \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0da7[ \u0db8\u0db8 \u0dc0\u0dcf\u0dd9\u0d9a\u0dca \u0dbb\u0dd3[\u0dbd\u0dcf. \u0db1\u0dd2\u0da7\u0d9a \u0d9a\u0dda\u0dd6\u0dbb\u0dca\u0dbd\u0dda\u0db8[\u0db1\u0dca\u0dad \u0dcf\u0dcf\u0db1\u0dd2 \u0dc0\u0dd4\u0dab\u0dd4, \u0db1\u0dd2\u0da7\u0d9a \u0d9a\u0dda\u0dd6\u0dbb\u0dca\u0dbd\u0dda\u0db8[\u0db1\u0dca\u0dad \u0dca\u0dd4\u0dd2 \u0dc0\u0dd4\u0dab\u0dd4 , ]88\u0db8 \u0db8\u0dca\u0d9a\u0dca \u0dad\u0db1\u0dca\u0dad\u0dca\u0da7\u0dcf. \u0d85\u0db4\u0dd2 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0db8\u0da7\u0db1\u0dca\u0dad \u0d85\u0dcf\u0dca\u0da7\u0dcf, \u0db8\u0dda\u0db8\u0da7\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0dad \u0db8\u0da7\u0db1\u0dd4\u0db8\u0da7\u0db1\u0dca\u0dad \u0db8\u0db8 \u0dc0\u0dcf\u0dca\u0da7\u0dcf \u0dd9\u0dba\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0dbb\u0dd3[\u0dbd\u0dcf. \u0dad\u0dc4\u0dd4\u0db1\u0dca\u0dad\u0dca\u0dcf\u0db1\u0dca\u0dad\u0db8\u0d9a\u0dda\u0dbd\u0dcf \u0db8\u0db8 \u0dc0\u0dad\u0dd4\u0dca\u0db4 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0d91\u0dd9 \u0d91\u0dd9 \u0db8\u0dda\u0da7\u0dbd\u0dca \u0dbb\u0dd3[\u0dcf\u0dc0\u0dd2. \u0db8\u0dda \u0d85[ \u0d9a\u0dda\u0dcf\u0dcf\u0dca\u0da7\u0dad \u0dd9\u0dba\u0db1\u0dca\u0dad\u0dca, \u0db8\u0da7\u0dca \u0dad\u0dd4\u0dca\u0dd9 \u0dca\u0da7 \u0d9a\u0da7\u0db1\u0dca\u0dad\u0dca \u0d85\u0da7\u0dc1\u0dba \u0dd9\u0db4\u0dba\u0dd4\u0dd4 \u0dd9\u0dba \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf ? \u0dad\u0da7\u0db8 \u0dc0 \u0d91\u0db8\u0dcf\u0db8 \u0dc0 \u0dd9\u0db4\u0dba\u0dd4\u0dd4 \u0dd9\u0dba\u0dbd\u0dcf \u0dca\u0dd4\u0dcf\u0dd4. \u0d85 \u0d92 \u0db4\u0dc0\u0dd4\u0dbd\u0dca \u0da7\u0dd2\u0dd9 \u0dad\u0dd4\u0db1\u0dca\u0dad \u0dad\u0dd4\u0db1\u0dca\u0dad\u0da7\u0dbd, \u0dca\u0dd1 \u0dd1 \u0db8\u0da7\u0da7\u0dbd\u0dca\u0da7\u0dbd \u0dad\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad.\n\n\u0dd4\u0dc5\u0dc5\u0dd2 \u0d9a\u0dd4\u0dda\u0dcf\u0db4\u0dca\u0da7 \u0db1\u0dd2\u0d9a\u0dcf \u0dcf\u0dcf\u0db1\u0dd2 \u0dc3\u0dd2\u0dd4\u0dc0 \u0dc0\u0dd4\u0dab\u0dd4 \u0d85\u0db8\u0dca\u0d9a\u0dca \u0d9a\u0dca\u0db8\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb[ \u0dad\u0db8 \u0dc0\u0dba\u0dd2 \u0dd9\u0dca\u0dd2\u0dd9\u0dbb\u0dca\u0dbd\u0db8 \u0dc0 \u0d9a\u0dca\u0db8\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb[. \u0db8\u0dbd\u0ddd\u0dd9 \u0db6\u0dd4\u0dd2\u0d82\u0d9a\u0dd4 \u0da7\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0da7\u0db4 \u0d85\u0db1\u0dd4\u0da7 \u0d87\u0db8\u0db8 \u0dc0\u0dd2\u0db8\u0dd9\u0dcf\u0db1\u0dd4 \u0db8\u0da9\u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0db8\u0dd2\u0dd2[\u0dca 824\u0dd9 \u0dcf\u0dcf\u0db1\u0dd2[\u0d9a\u0dca \u0db8\u0dda \u0dba\u0db8\u0da7\u0dca \u0dd9\u0dca\u0dd2\u0dd9\u0dbb\u0dca\u0dbd\u0db8 \u0dc0 \u0d9a\u0dca\u0db8\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb[\u0db4 \u0dc3\u0dd2\u0dd4\u0dc0 \u0db8\u0da7\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0d92 \u0d85[\u0db4 \u0da7\u0db1\u0dca\u0dad\u0daf \u0da7\u0dc1\u0db8[\u0db1\u0dca\u0dad \u0dad\u0dc4\u0dd4\u0db1\u0dca\u0dad\u0dca\u0dcf\u0db1\u0dca\u0dad\u0db8\u0d9a\u0dda\u0dbd\u0dcf \u0d9a\u0dd3[\u0d9a\u0dca \u0db8\u0da7\u0da7\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf ? \u0db8\u0da7\u0dcf\u0dc0\u0dd2\u0db8[\u0ddd \u0dcf\u0dd4\u0db8 \u0dc0 \u0dad\u0dd4\u0dca\u0db8 \u0dc0 \u0dd9\u0db1\u0dca\u0dad\u0dca\u0dbd\u0dda \u0dd9\u0dba\u0dca\u0da7\u0dcf \u0d9a\u0dd3[\u0d9a\u0dca\u0da7 \u0d9a \u0dcf\u0dda\u0db6 \u0dc0\u0dd4\u0db8\u0dab\u0dca\u0da9 \u0dca\u0dd4\u0dcf\u0dd4 \u0dbb\u0dd3[\u0dbd\u0dcf. \u0d92\u0db8\u0da7\u0dcf\u0dbd\u0dca\u0db8\u0dbd\u0ddd \u0d85\u0dc0\u0dd4\u0dc0 \u0dda \u0db4\u0dd4\u0dba\u0dcf \u0da2\u0dd3\u0da7 \u0d9a \u0db8\u0da7\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0da7\u0da7\u0dcf\u0db8\u0da7\u0db1\u0dca\u0dad \u0dbd\u0dd4\u0db8\u0db6\u0dca \u0d86 \u0dcf[\u0db8\u0dd2\u0db1\u0dca\u0dad. \u0d85\u0db8\u0dca\u0d9a\u0dca \u0d91\u0dd9, \u0d93\u0dd2\u0dcf\u0dcf\u0dc3\u0dd2\u0dd9 \u0dd4\u0dc5\u0dca\u0dcf\u0db8\u0dd2 \u0da7\u0dba\u0d9a\u0dca[ \u0db8\u0da7\u0dbd\u0dcf\u0db8\u0dda\u0daf\u0dd3\u0da7 \u0d9a, \u0da7\u0dd2\u0d82\u0da7\u0dd4\u0dba \u0db8\u0da7\u0dbd\u0dcf\u0db8\u0dda\u0daf\u0dd3\u0da7 \u0d9a \u0d85\u0db8 ( \u0dbb\u0dd3\u0dc3\u0dd2\u0db8 \u0dc0 \u0db8\u0dda\u0dc1\u0db4\u0dcf\u0dbd\u0dca\u0da5\u0db8[\u0d9a\u0dca \u0d92\u0da7\u0dcf\u0db4 \u0d87\u0d9f\u0dd2\u0dd2 \u0da7\u0dd4\u0dab \u0db8\u0dda \u0dca\u0dd4\u0dcf\u0dd4."
