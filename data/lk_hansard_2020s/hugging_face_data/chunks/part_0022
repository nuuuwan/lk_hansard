    "chunk_text": "\u0dca\u0da2\u0dd2 \u0d9a \u0dad\u0db1\u0dca\u0dad\u0daf\u0dd9 \u0db8 \u0dc0\u0db1\u0dca\u0dad\u0dd3\u0dd4\u0db8 \u0dc0\u0dcf, \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0db8\u0dad \u0dca\u200d\u0dbb\u0dca\u200d\u0dcf\u0dca \u0d9a\u0dd2\u0d82\u0dc0\u0dd2\u0dca\u200d\u0dcf[\u0dd9\u0dd4\u0db8 \u0dc0\u0dcf \u0da7\u0dd4\u0dca \u0d85 \u0dad\u0dad\u0dcf\u0db8 \u0dc0 \u0db4\u0dd4\u0dcf\u0dd4\u0daf\u0dd3\u0db8\u0db8 \u0dc0\u0db1\u0dca\u0dad, \u0dad\u0dad\u0dcf\u0db8 \u0dc0 \u0db8\u0dcf\u0dcf\u0dd2\u0db1\u0db1\u0dca\u0dad \u0dd9\u0dcf\u0dcf \u0dd9\u0dc5\u0dcf, \u0d91\u0dd4\u0db8 \u0dc0\u0dcf\u0db8 \u0d9c\u0dd4\u0dda\u0da7\u0dc0 \u0dd9\u0dd9\u0db8 \u0dc0 \u0da7\u0dd4\u0dca \u0dbb\u0dd3[\u0db8\u0dd2\u0db1\u0dca\u0dad. \u0d85\u0db4\u0db4 \u0d91\u0db8\u0dcf\u0db8 \u0dc0 \u0db8\u0db4\u0dde\u0dc0 \u0dc2\u0dca\u0da8[\u0d9a\u0dca \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0db8\u0db8 \u0dc0\u0dcf\u0dd9 , \u0db8\u0dcf\u0dcf\u0db3 \u0db8\u0dd9\u0db8\u0dca\u0d9a\u0dd4 \u0d85\u0da7[ \u0dd9\u0dba\u0db1\u0dca\u0dad\u0dca \u0db4\u0dd4\u0dd4 \u0da7\u0db1\u0dca\u0dad \u0db8\u0dcf\u0dcf\u0db3 \u0db8\u0dd9\u0db8\u0dca\u0d9a\u0dd4\u0db4 \u0dc0\u0dd2\u0dad\u0dba\u0dba\u0dd2. \u0db8\u0dcf\u0dcf\u0db3 \u0db8\u0dd9\u0db8\u0dca\u0d9a\u0dd4 \u0d85\u0da7[ \u0dd9\u0dba\u0db1\u0dca\u0dad\u0dca \u0db4\u0dd4\u0dd4 \u0da7\u0db1\u0dca\u0dad \u0db8\u0dcf\u0dcf\u0db3 \u0db8\u0dd9\u0db8\u0dca\u0d9a\u0dd4\u0db4 \u0dc0\u0dd2\u0dad\u0dba\u0dba\u0dd2! \u0db8 \u0dc0\u0db4 \u0d92 \u0da7\u0da0\u0dca[ \u0dad\u0dd2\u0d82\u200d\u0dbb\u0dd3\u0dc3\u0dd2\u0db8[\u0db1\u0dca\u0dad \u0dbb\u0dd3\u0dda\u0db8\u0da7\u0dcf \u0d9a \u0dad\u0db8 \u0dc0\u0dba\u0dd2, phrase \u0d91\u0dd9 \u0db8\u0dcf\u0dcf\u0db3\u0db4 \u0d91\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad. \"\u0db8\u0db8 \u0dc0\u0dcf\u0dc5[ \u0dd9\u0dca\u0da7\u0dcf\" \u0dbb\u0dd3[\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad. \u0d85 \u0db8\u0da7\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0d92\u0dd9. \u0d85\u0db4\u0dba\u0dcf\u0db8\u0dda \u0d85\u0db8 ( \u0dd9\u0dcf\u0dbd[ \u0dca\u0dcf\u0d9a\u0dda\u0dd2 \u0dd9\u0dba\u0dca\u0da7\u0dcf. \u0db8\u0dda\u0dd9 \u0db8\u0db8 \u0dc0\u0ddd\u0da9 \u0db8 \u0dc0\u0dd4\u0da7\u0dd2 \u0d9c\u0dd4\u0dcf\u0dcf\u0da7\u0d9a\u0dca \u0db6\u0da7\u0db4 \u0db4 \u0d9a \u0dd9\u0dba\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf \u0db8 \u0dc0\u0da9 \u0db8\u0da7\u0dcf\u0da9\u0d9a\u0dca \u0db6\u0da7\u0db4 \u0db4 \u0d9a \u0dd9\u0dba\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0dbb\u0dd3\u0dc3\u0dd2 \u0db8 [\u0d9a\u0dca \u0db4\u0dcf\u0da9\u0dda \u0dd9\u0dba\u0dbd\u0dcf \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0dd9\u0dcf\u0dcf \u0dd9\u0dba\u0dca \u0d91\u0dd9 \u0db8 \u0d9a\u0dc0 \u0db8 \u0dc0\u0d9a\u0dca \u0dca\u0dd4\u0dd2 \u0dd9\u0dba\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0db8\u0db8 \u0dc0\u0dcf\u0dca \u0dad\u0dba\u0dda \u0db8\u0dda\u0dc1\u0db4\u0dcf\u0dbd\u0dca \u0db8 \u0dc0\u0dd4\u0da7\u0dd2\u0db7\u0dcf\u0da7[\u0d9a\u0dca \u0d94\u0db6\u0dd4\u0db8 \u0dc0\u0db1\u0dca\u0dad\u0dbd\u0dcf \u0db8\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dda \u0d87\u0dd2 \u0dd9\u0dba\u0dca\u0da7\u0dcf ? \u0d85\u0db4\u0dd2 \u0d94\u0db6\u0dd4\u0db8 \u0dc0\u0db1\u0dca\u0dad\u0dbd\u0dcf\u0db4 \u0dbb\u0dd3[\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db8\u0dda\u0dd9\u0dba\u0dd2. \u0d94\u0db6\u0dd4\u0db8 \u0dc0\u0db1\u0dca\u0dad\u0dbd\u0dcf \u0d91\u0db8\u0dcf\u0db8 \u0dc0 \u0dc0\u0dd4\u0dda\u0dcf\u0db4 \u0d85\u0db4\u0dd2 \u0d91\u0db8\u0dcf\u0db8 \u0dc0 \u0db8\u0da7\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0dca\u0dd4\u0dcf\u0dd4, \u0db8 \u0dc0\u0db1\u0dca\u0dad\u0dd3\u0dd9\u0dda \u0dd2\u0db6\u0dd4\u0dda \u0d9a \u0dca\u0dd4\u0dad \u0d9a.\n\n\u0db8\u0db4\u0db1\u0dca\u0dad\u0db1\u0dd4\u0db8\u0dda. \u0dcf\u0daf\u0dc3\u0dd2 \u0db1\u0dd3\u0dd2 \u0dc0\u0dd2\u0da7\u0dcf [ \u0db1\u0dd2\u0d9a\u0dcf \u0d92 \u0db8\u0da7\u0dcf\u0da9\u0d9a\u0dca \u0db8\u0dda\u0da7\u0dbd\u0dca \u0dbb\u0dd3[\u0db1\u0dca\u0dad\u0dca \u0d95\u0dca\u0dd1 \u0dca\u0dd4\u0dcf\u0dd4. \u0db8\u0dda \u0dbb\u0dd3[\u0db4\u0dd4 democracy \u0db4\u0dd4 \u0d9a\u0db8\u0dad\u0db1\u0dca\u0dad, rule of law \u0db4\u0dd4 \u0d9a\u0db8\u0dad\u0db1\u0dca\u0dad, judicial independence \u0db4\u0dd4 \u0d9a\u0db8\u0dad\u0db1\u0dca\u0dad \u0da7\u0dbb\u0dca\u0dbd\u0dca\u200d\u0dca[\u0d9a\u0dca \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0db8\u0dda\u0da7\u0dcf \u0dad\u0db8 \u0dc0\u0dba\u0dd2 \u0dbd\u0dd2\u0d82\u0dd9\u0dcf\u0db8\u0dda \u0d85\u0db7\u0dd2\u0db8 \u0dc0\u0dcf\u0dca[ \u0da7\u0dbb\u0dca\u0dbd\u0dca\u200d\u0dca[ \u0dd9\u0dba\u0dca \u0dc0\u0dd2\u0d9a\u0dbb. \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0dd9 \u0da7\u0dc1\u0db8[\u0db1\u0dca\u0dad \u0da7\u0dca \u0da7\u0dbb\u0dca\u0dbd\u0dca\u200d\u0dca[, \u0db8\u0da7\u0dca\u0db8 \u0dc0\u0dba\u0dd2.\n\n\u0db8 \u0dc0\u0dcf \u0dd9\u0dd2\u0db1\u0dca\u0dad \u0dbb\u0dd3[\u0db4\u0dd4 \u0d85[ \u0db8\u0dda\u0dc1\u0db4\u0dcf\u0dbd\u0dca \u0d85\u0db4\u0dba\u0dcf\u0dca\u200d\u0dd9\u0dc0 \u0db8\u0da7\u0ddd. \u0db8\u0db6\u0dcf\u0db8\u0dcf\u0ddd \u0dd4\u0dc0\u0dba\u0db4 \u0db4\u0dcf\u0d9a\u0dda\u0d9a\u0dd4 \u0dad\u0dc0 \u0daf\u0dca \u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dba\u0db8\u0dad \u0d9d\u0dcf\u0dad\u0dd9[\u0db1\u0dca\u0dad\u0db8 \u0db8 \u0dc0\u0dcf \u0db8\u0db8 \u0dc0\u0dcf\u0dc5\u0dd9\u0dc0 \u0db8\u0da7\u0ddd. \u0d92\u0dd9\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0d94\u0db6\u0dd4\u0db8 \u0dc0\u0db1\u0dca\u0dad\u0dbd\u0dcf\u0db4 \u0dbb\u0dd3[\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad. \u0db8\u0db8 \u0dc0\u0db1\u0dca\u0dad\u0dca \u0db8\u0dda \u0db8\u0dda\u0dc1\u0db4\u0dcf\u0dbd\u0dca \u0d85\u0db4\u0dba\u0dcf\u0dca\u200d\u0dd9\u0dc0 \u0db8\u0da7\u0ddd \u0d85 channels\u0da7\u0dbd \u0dcf\u0dba\u0dd2[ \u0d85\u0dba\u0db8\u0da7\u0dca \u0db8\u0db8 \u0dc0\u0dad\u0dd4\u0dca \u0db8\u0db6\u0dcf\u0dc0 \u0dcf \u0dca\u0da7\u0dcf. \u0db8\u0db4\u0dcf\u0dbd\u0dca \u0da7\u0dd4\u0da7\u0dbd \u0da0\u0dd6\u0da7\u0dd2 \u0da7\u0d9a\u0dda \u0db4\u0dcf\u0d9a\u0dca \u0dc0\u0dd2\u0dad\u0dba \u0dd2\u0db8\u0db6\u0dca \u0dad\u0dd4\u0dca\u0dd9\u0db4 \u0d9c\u0dd2\u0dd2\u0