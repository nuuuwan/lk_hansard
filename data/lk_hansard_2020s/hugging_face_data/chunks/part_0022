da7\u0db1\u0dca\u0dad \u0db8\u0da7\u0db1\u0dca\u0dad \u0da7\u0dc1\u0db8[\u0db1\u0dca\u0dad \u0db8\u0dd9\u0dcf\u0db4\u0db8 \u0dc0\u0dda\n\n(ii) \u0d85 \u0dcf\u0dc5 \u0d85\u0db8 \u0dc0\u0dcf\u0dad\u0dba\u0da7\u0dba[\u0dcf \u0dca\u0da7\u0dba \u0d9a\u0dd4\u0dbd\u0dd4\u0dc5\u0dda \u0dcf\u0dcf \u0da2\u0dbd\u0d9a\u0dda\u0db4\u0dcf \u0dca \u0d85\u0db8 \u0dc0\u0dcf\u0dad\u0dba \u0dd4\u0dbb\u0dba[ \u0dba\u0dca \u0dbd \u0dd9\u0dcf\u0dbd\u0dc3\u0dd3\u0db8 \u0dc0\u0dcf\u0db8\u0dda\u0daf\u0dd3, \u0d91\u0db8 \u0dc0 \u0db1\u0dd2\u0dbd \u0dba\u0dcf \u0db8\u0da7\u0db1\u0dd4\u0db8\u0da7\u0db1\u0dca\u0dad \u0db8 \u0dc0\u0dcf\u0dc3\u0dd2\u0dd9\u0da7 \u0da7\u0dd4[ \u0dd9\u0dba\u0dca \u0dbd \u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dca \u0dd3\u0db4\u0dbb\u0dca\u0dbd \u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dcf\u0dda[ \u0d9a\u0dcf \u0d92 \u0d9a\u0db3\u0dcf\u0dcf \u0dba\u0dca \u0dbd \u0dc0\u0dd2[ \u0db8 \u0dc0, \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0db1\u0dd2\u0dbd \u0dba\u0dcf[ \u0d85\u0db1\u0dd4\u0da7 \u0db8\u0da7\u0db1\u0dca\u0dad \u0db8\u0da7\u0db1\u0dca\u0dad \u0da7\u0dc1\u0db8[\u0db1\u0dca\u0dad \u0db8\u0dd9\u0dcf\u0db4\u0db8 \u0dc0\u0dda\n\n[\u0db1\u0dca\u0dad\u0dca \u0d9a \u0d91\u0dd4\u0db8\u0dd2[ \u0db8\u0db8 \u0dc0\u0db8 \u0dc0 \u0d9a\u0db7\u0dcf\u0da7\u0db4 \u0db1\u0dca\u0dad\u0da7\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad ?\n\n(\u0d87\u0db4 \u0db8\u0dca\u0dcf\u0d91\u0db8\u0d9a\u0dda \u0dca\u0dda, \u0d92 \u0db8 \u0dc0\u0db1\u0dca\u0dad ?\n\n\u0bc6\u0bbf\u0bb0\u0ba4\u0bc8 \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bc1\u0bae\u0bcd \u0b95\u0bb2\u0bcd\u0bb5\u0bbf, \u0b89\u0baf\u0bb0\u0bcd \u0b95\u0bb2\u0bcd\u0bb5\u0bbf \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb1\u0bcd\u0b95\u0bb2\u0bcd\u0bb5\u0bbf \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bc1\u0bc8\u0bc6\u0bbe\u0ba9\u0bb5\u0bae\u0bb0\u0b95\u0bcd \u0bb2\u0b95\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0ba9\u0bc6\u0bbe:\n\n(\u0b85) (i) \u0b8e\u0b9f\u0bcd\u0b9f\u0bc6\u0bbe\u0bb5\u0ba4\u0bc1 \u0bc6\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0bb3\u0bc1\u0bc8\u0ba9\u0bcd\u0bb1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd 2018 \u0ba8\u0bb5\u0bae\u0bcd\u0bc6\u0bb0\u0bcd 09\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0ba8\u0bbf\u0baf\u0bc8\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0bc6\u0b9f\u0bcd\u0b9f \u0ba8\u0b95\u0bb0\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bc8\u0bbf\u0b9f\u0bb2\u0bcd \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1, \u0b85\u0baa\u0bcd\u0bb2\u0bc6\u0bc6\u0bbe\u0bae\u0ba4\u0baf \u0b85\u0bb0\u0b9a\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb2\u0bcd \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0bc6\u0b9f\u0bcd\u0b9f \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0baf\u0bc6\u0bbe\u0b95\u0baa\u0bc2\u0bb0\u0bcd\u0bb5 \u0bb5\u0bc6\u0bbe\u0b95\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0ba3\u0bcd\u0bc8\u0bbf\u0b95\u0bcd\u0bae\u0b95 \u0b8e\u0ba4\u0bcd\u0ba4\u0bae\u0ba9 \u0b8e\u0ba9\u0bcd\u0bc6\u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n(ii) \u0b85\u0ba8\u0bcd\u0ba4 \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0baf\u0bc6\u0bbe\u0b95\u0baa\u0bc2\u0bb0\u0bcd\u0bb5 \u0bb5\u0bc6\u0bbe\u0b95\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bc6\u0ba4\u0bbf\u0bb5\u0bc1\n\n\u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd, \u0bb5\u0bae\u0b95 \u0bc8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bc8\u0bc6\u0bbe\u0ba4\u0bbf\u0bc6\u0bbe\u0bbf \u0ba4\u0bb5\u0bb5\u0bcd\u0bb2\u0bb5\u0bb1\u0bc6\u0bbe\u0b95 \u0baf\u0bc6\u0bbe\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0bc6\u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n(iii) \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4 \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0baf\u0bc6\u0bbe\u0b95\u0baa\u0bc2\u0bb0\u0bcd\u0bb5 \u0bb5\u0bc6\u0bbe\u0b95\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0bc6\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4 \u0b95\u0bc6\u0bbe\u0bb2\u0baa\u0bcd\u0bc6\u0b95\u0bc1\u0ba4\u0bbf \u0baf\u0bc6\u0bbe\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0bc6\u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n\u0b85\u0bb5\u0bb0\u0bcd \u0b87\u0b9a\u0bcd\u0b9a\u0bae\u0bc6\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0bc6\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe?\n\n(\u0b86) (i) \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0baf\u0bc6\u0bbe\u0b95\u0baa\u0bc2\u0bb0\u0bcd\u0bb5 \u0bb5\u0bc6\u0bbe\u0b95\u0ba9\u0bae\u0bcd \u0b92\u0bb5\u0bcd\u0ba4\u0bb5\u0bc6\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0bc6\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4 \u0bc8\u0bc6\u0bbe\u0ba4\u0bc6\u0bbe\u0ba8\u0bcd\u0ba4 \u0b8e\u0bc6\u0bbe\u0bbf\u0ba4\u0bc6\u0bc6\u0bbe\u0bb0\u0bc1\u0bb3\u0bbf\u0ba9\u0bcd \u0b85\u0bb3\u0bb5\u0bc1 \u0ba4\u0bb5\u0bb5\u0bcd\u0bb2\u0bb5\u0bb1\u0bc6\u0bbe\u0b95 \u0b8e\u0bb5\u0bcd\u0bb5\u0bb3\u0bb5\u0bc1 \u0b8e\u0ba9\u0bcd\u0bc6\u0bae\u0ba4\u0baf\u0bc1\u0bae\u0bcd;"
