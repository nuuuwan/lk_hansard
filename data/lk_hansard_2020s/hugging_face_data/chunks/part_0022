    "chunk_text": "\u0dd6\u0dbd\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0dd9\u0dbb\u0dd4 \u0db8\u0db1\u0dca\u0d9a\u0dd3\u0dad\u0dd4\u0dd2\u0dba\u0dba\u0db1\u0dd2\u0d8b \u0d9c\u0dda \u0db4\u0db1\u0dad\u0dca \u0d9c\u0d9a\u0da7\u0dd4\u0dda\u0db4\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dba\u0db4\u0dd4 \u0db6\u0dd2\u0db8\u0dbd\u0dca \u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0daf\u0dc0\u0dc3\u0d9a \u0db8\u0dd2\u0db1\u0dd2\u0d82 \u0db8\u0dcf\u0dbb\u0dca\u0d9a\u0da7\u0dca \u0d91\u0d9a\u0db4 \u0d91\u0db1\u0dc0\u0dcf \u0db8\u0db8 \u0daf\u0dd2 [\u0d9a\u0dcf. \u0d9c\u0db8\u0dcf\u0d9a\u0daf\u0d8b \u0daf\u0dd2\u0db1\u0dca\u0d9a \u0d9c\u0dda \u0d9c\u0dd9\u0d9c\u0db1\u0db1 \u0dc0\u0dcf\u0dab\u0dca\u0da9 \u0da7\u0dd2\u0d9a \u0db8\u0dd2\u0db1\u0dd2\u0d82 \u0db8\u0dcf\u0dbb\u0dca\u0d9a\u0da7\u0dca \u0d91\u0d9a\u0db4 \u0daf\u0dcf\u0dbd\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0d8a\u0db4 \u0db4\u0dc3\u0dd4\u0dc0 \u0d92\u0dc0\u0dcf \u0dbd\u0d82\u0d9a\u0dcf\u0dc0 \u0db4\u0dd4\u0dba\u0dcf \u0d9c\u0db6\u0daf\u0dcf \u0dc4\u0dbb\u0dd2\u0db1\u0dca\u0d9a\u0d9c\u0db1\u0dca\u0d9a. \u0dc4\u0dd2\u0db6\u0dd2\u0dba\u0dd2\u0d8b \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0d91\u0dad\u0dd2\u0db1\u0db4 \u0d91\u0db1\u0d9c\u0d9a\u0dcf\u0db4 \u0d85\u0dba \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba \u0d87\u0db8\u0dad\u0dd2 \u0d9c\u0d9a\u0d9c\u0db1 [ \u0d91\u0db1 \u0d9c\u0d9a\u0dcf\u0db4 \u0dc0\u0dcf\u0d9c\u0dda\u0d8b \u0d91\u0dad\u0dd2\u0db1\u0dd2\u0db1\u0dca\u0d9a \u0d87\u0dad\u0dd4\u0dd9\u0db4 \u0dba\u0db1 \u0db8\u0dcf\u0dbb\u0dca\u0dd9 \u0da7\u0dd2\u0d9a \u0dc0\u0dd2\u0dc4\u0dd4\u0dc0\u0dcf. \u0d89\u0dad\u0dd2\u0db1\u0dca\u0d9a \u0d92 \u0d9c\u0dd3\u0dc0\u0dbd\u0dca \u0da7\u0dd2\u0d9a \u0db6\u0dbd\u0dbd\u0dcf \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0d91\u0dad\u0dd2\u0db1\u0dd2\u0db1\u0dca\u0d9a \u0d9c\u0dd2\u0dba\u0dcf \u0dd2\u0dba\u0dc3 [\u0d8b \u0d91\u0dad\u0dd2\u0db1 \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0d9c\u0dba\u0ddd\u0d9c\u0dd2