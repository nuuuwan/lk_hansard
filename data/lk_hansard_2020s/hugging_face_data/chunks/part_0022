    "chunk_text": "\u0dbd\u0dca\u0dbd\u0daf\u0dc3\u0dcf \u0daf\u0dbb\u0dd6\u0daa\u0d9c\u0dbb\u0dd4 \u0d9c\u0dc4\u0dca\u0dd3\u0dad\u0dd4\u0dc4\u0db1\u0dd2,\u0d9c \u0dd4 \u0dad\u0dca\u0d9c:\u0dad\u0dca\u0dcf\u0d9c\u0dda\u0dc4\u0dda \u0dc4\u0d9c\u0dad\u0dd2\u0db6\u0dd2\u0dba\u0daf\u0dd3\u0d9c\u0dd2\u0dc3\u0db4\u0dca\u0dc2\u0dba\u0d9c\u0dda\u0dca\u0d9c\u0dda\u0dc0\u0dbd\u0daf\u0dda\u0dda\u0d9c\u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0daf \u0d9c\u0d9a\u0dbb\u0db8\u0dd2\u0dca\u0d9c\u0dd2\u0d82\u0da7\u0dd2 \u0dc0\u0daf,\u0d9c\u0d9c\u0dbb\u0dda\u0da7\u0dca\u0d9c\u0dbb\u0dca\u0dd2\u0d9a\u0d9c\u0dbb\u0dc3\u0dcf \u0daf\u0dc0\u0dbb\u0dad\u0dca\u0dc0\u0dba\u0dca\u0d9c\u0dad\u0dd2\u0dda\u0db6\u0db1 \u0dc0\u0daf\u0d9c\u0d9a\u0dd2\u0dba\u0dca .\u0d9c\u0da2 \u0dcf\u0daf\u0dc0\u0d9c\u0dad\u0dd4\u0dc5\u0d9c\u0dc3\u0dcf \u0d9a\u0dba\u0d9c\u0dc3\u0dcf\u0dc4\u0d9a\u0daf\u0dc0\u0d9c\u0dc4\u0dad\u0dd4\u0d9c\u0dda\u0dc0 \u0d9c\u0dbb\u0d9a\u0daf\u0dbb\u0dba \u0d9c\u0db4\u0dca\u200d\u0dbb\u0d9a\u0daf\u0dba\u0d9c\u0d9a\u0dbb\u0dca \u0d9c\u0d94\u0dc0\u0dd4\u0dca\u0d9c\u0dda\u0db4\u0dc5\u0db9\u0dd2\u0dbd\u0daf\u0d9c\u0dd2\u0d82\u0da7\u0dd2 \u0dc0\u0daf.\u0d9c\n\n1511 1512\n\n\u0db4\u0daf\u0dca\u0dd2\u0dda\u0dca\u0dca\u0dad\u0dd4\u0dc0\n\n\u0dbb:\u0d9c\u0dc0 \u0d9c\u0dd2\u0dc3 \u0d9c\u0dbb\u0dda\u0da7\u0dca\u0d9c\u0da2 \u0dcf\u0daf\u0dc0 ,\u0d9c\u0dbb\u0dda\u0dda\u0d9c\u0dbb\u0dda\u0da7\u0dca\u0d9c\u0dc0\u0dba\u0daf\u0db4\u0daf\u0dbb\u0dd2\u0d9a\u0dba\u0dca ,\u0d9c\u0dda \u0dba \u0dba\u0d9c\u0dc3\u0dcf \u0d9c\u0dd2\u0dc3\u0dda \u0dba \u0dba\u0d9c\u0dc3\u0dcf\u0dc4\u0daf\u0dbb\u0dca\u0dc0\u0dbd \u0d9c\u0dda\u0dca\u0d9c\u0dbb\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0d9c\u0dda\u0d9a\u0dda\u0dbb\u0dc4\u0dd2\u0d9c\u0dad\u0dd2\u0dda\u0db6\u0db1 \u0d9c\u0dd2\u0dc3\u0dba \u0dc0\u0daf\u0dc3\u0dcf\u0dba\u0d9c\u0dcf\u0dc4\u0db1\u0dca\u0d9c\u0dbb\u0dda\u0dda\u0d9c\u0dbb\u0dda\u0da7\u0dca\u0d9c:\u0dad\u0dca\u0dcf\u0dc0\u0dd2\u0dca\u0d9c\u0dc3\u0dcf \u0d9c\u0d92\u0d9c \u0dc4\u0d9c\u0dda:\u0dba\u0d9a\u0dd2\u0dca\u0dc4\u0d9c\u0dda\u0db4\u0dca\u0dc0\u0dca\u0dda\u0dca.\u0d9c\u0dbb\u0dda\u0da7\u0dca\u0d9c\u0da2 \u0dcf\u0daf\u0dc0\u0dda\u0dda,\u0d9c\u0dbb\u0dda\u0dda\u0d9c\u0dc0\u0dba\u0daf\u0db4\u0daf\u0dbb\u0dd2\u0d9a\u0dba\u0dca\u0dda\u0dda,\u0d9c\u0dda\u0dbd\u0ddd\u0d9a\u0d9c\u0db4\u0dca\u200d\u0dbb\u0da2\u0daf\u0dc0\u0dda\u0dda\u0d9c\u0dd2\u0dc3\u0dba \u0dc0\u0daf\u0dc3\u0dcf\u0dba\u0d9c\u0daf\u0dd2 \u0daf\u0dda\u0dbb \u0d9c\u0dda\u0dca\u0d9c\u0dbb\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0d9c\u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0d9c\u0d9a\u0dbb \u0dda\u0d9a\u0daf \u0d9c\u0dd2\u0dc3\u0db4\u0dca\u0dc2\u0dda\u0dda\u0d9c\u0dbb\u0dba\u0d9c\u0d9a\u0dbd\u0db6\u0db1\u0dbd\u0d9c\u0dda\u0dc0\u0dbd\u0daf\u0d9c:\u0dd9\u0dbd \u0dc0\u0daf.\u0d9c\u0d92\u0d9a\u0d9c\u0db1\u0dd2\u0dc3\u0dcf\u0daf\u0d9c\u0dcf\u0dc4\u0db1\u0dca\u0d9c\u0dc4\u0dc4\u0d9c\u0dbb\u0dd4 \u0d9c\u0d87\u0dc4\u0dad\u0dd2\u0dad\u0dd4\u0dc4\u0daf\u0dda\u0dbb\u0dca\u0d9c\u0dda\u0dca\u0d9c\u0db4\u0dca\u200d\u0dbb\u0dba \u0d9c\u0da7\u0dd2\u0d9a\u0d9c\u0dbb \u0dca\u0dda\u0dca.\u0d9c\u0dbb\u0dda\u0dda\u0d9c\u0dbb\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0d9c2026\u0d9c\u0dbb\u0dc0\u0dd4\u0dd4 :\u0d9c\u0d87\u0dad\u0dd4\u0dc5\u0dcf\u0d9c\u0dda\u0dca\u0d9a\u0d9c\u0dcf\u0dc0\u0dad\u0dca\u0d9c\u0dc3\u0dcf\u0dc4\u0dc0\u0dca\u0db0 \u0dba\u0d9c\u0d9a\u0dbb\u0d9c\u0dbb \u0db1\u0dd3\u0dc4\u0d9c\u0dda\u0dc0\u0db1\u0dd4\u0dda\u0dc0\u0dca\u0d9c\u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0d9c\u0d9a\u0dbb \u0d9c\u0dbb\u0dc4\u0dca\u0d9c\u0dba\u0dca\u0d9c\u0dbb\u0dd4\u0d9c\u0db4\u0daf\u0dd4\u0dc0\u0dca\u0d9c\u0dad\u0dd2\u0db6\u0dd4\u0dab\u0daf\u0d9c \u0dca\u0d9c\u0d92\u0dc0\u0daf \u0db1\u0dd2\u0dc0 \u0dbb\u0daf\u0dd2\u0d9c\u0d9a\u0dbb\u0d9c\u0dbb \u0db1\u0dd3\u0dc4 \u0dad\u0dca\u0d9c\u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0d9c\u0d9a\u0dbb \u0dc0\u0daf. \u0d9c\u0d9c\u0db4\u0dd4\u0da2\u0d9c\u0dd2\u0dba\u0d9c\u0da2 \u0dc0\u0daf\u0dbb\u0dd2\u0d9c07\u0dda\u0dc0\u0db1\u0dd2\u0d9c:\u0daf\u0d9c\u0dda\u0d9a\u0daf \u0dc3\u0dcf \u0d9c\u0dda\u0dc0\u0dda\u0dc5 \u0d9c\u0dda\u0db4\u0daf\u0dda\u0dc5 \u0d9c\u0db6\u0dd2 \u0d9c\u0dc0 \u0da7\u0dd3\u0dc4\u0dca\u0d9c\u0dbb \u0d9c\u0dda\u0dbd\u0daf\u0d9a\u0dd4\u0d9c\u0db4\u0dca\u200d\u0dbb\u0da0\u0daf\u0dbb\u0dba\u0dca\u0d9c\u0dbd\u0db6\u0db1\u0daf\u0d9c\u0dda: \u0dc0\u0daf\u0d9c\u0dbb\u0dd2\u0dc5\u0d9c\u0dc4\u0daf\u0db0\u0dba\u0dc0\u0dd2\u0dca\u0d9c: \u0dca\u0d9a\u0daf.\u0d9c \u0db6\u0db1 \u0db1\u0dca\u0d9c\u0d92\u0d9a\u0d9c\u0dd4\u0da2\u0dc5\u0dd4\u0d9c\u0dbb\u0dcf\u0db4\u0dd4\u0da2\u0dd3\u0dc4\u0dca\u0d9c\u0d9a\u0dd2\u0dba \u0d9c\u0d91\u0d9a\u0d9c\u0db4\u0dd4\u0da2\u0dc0\u0d9c\u0dc0\u0daf\u0dca\u0dcf\u0daf\u0d9c\u0dc0\u0dd4\u0dab\u0daf.\u0d9c\u0dc4\u0daf\u0db0\u0dba\u0dad\u0dca,\u0d9c\u0dd2\u0dc3\u0db4\u0dca\u0dc2\u0dba\u0dad\u0dca\u0d9c\u0d92\u0d9c\u0dc0\u0daf\u0dda\u0dda\u0d9c\u0dda\u0db6\u0db1\u0daf\u0dd4 \u0d9c\u0db6\u0dd2\u0dca \u0dda\u0dbd\u0ddd\u0d9c\u0dc4\u0dc0 \u0d9c\u0dbb\u0dc0\u0dc3\u0dcf \u0daf\u0dc0\u0d9a,\u0d9c\u0d9c\u0dda\u0dca\u0d9c\u0dc0\u0dc3\u0dcf\u0dbb\u0d9c\u0dad\u0dd4\u0dc5\u0d9c\u0dbb\u0dda\u0dda\u0d9c\u0dbb\u0dab\u0dca\u0da9\u0dd4\u0dda\u0dda\u0d9c\u0dc3\u0dcf \u0daf\u0dc0\u0dbb\u0dad\u0dca\u0dc0\u0dba\u0d9c\u0db4\u0dc0\u0dad\u0dca\u0dc0\u0daf\u0d9c\u0dbb \u0db1\u0dd3\u0dc4\u0d9c\u0dc3\u0dcf \u0daf\u0d9c\u0d94\u0db6\u0db1\u0dad\u0dd4\u0dc4\u0dca\u0dbd\u0daf\u0d9c\u0dda\u0dbb \u0d9c\u0d87\u0dad\u0dd2\u0d9c\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dc4\u0daf\u0dca\u0dbb\u0d9c\u0dda\u0dc4\u0daf \u0dc0\u0daf:\u0d9c\u0d9a\u0dd2\u0dba\u0dbd\u0daf\u0d9c\u0dc4\u0dc4\u0d9c\u0dbb\u0dd4 \u0d9c\u0d87\u0dc4\u0dad\u0dd2\u0dad\u0dd4\u0dc4\u0daf\u0dda\u0dbb\u0dca\u0d9c\u0dbb \u0dca \u0d9c\u0d9a \u0dc4 \u0dad\u0dd2\u0db1\u0dca.\u0d9c\n\n\u0d9c\u0dd4 \u0db8\u0dd6\u0dbd\u0dcf \u0db1\u0dcf\u0dbb\u0dd6\u0daa \u0db8\u0db1\u0dca\u0dd3\u0dd4\u0dbb\u0db8\u0dcf (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0ba4\u0bae\u0bb2\u0bae\u0bc8\u0ba4\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd) (The Hon. Presiding Member) \u0dd2\u0dc5\u0dd2\u0db6\u0dad\u0dd4\u0dd4 \u0d9c\u0dc3\u0dcf \u0db4 \u0d8b\u0dc4,\u0d9c\u0dd4 :\u0dca ,\u0d9c\u0d9a\u0dca\u200d\u0dbb\u0dc4\u0d9c\u0dc3\u0dcf\u0dca\u0db4\u0daf: \u0d9c\u0dc3\u0dcf \u0d9c\u0dbb\u0dca\u0dd2\u0d9a\u0d9c\u0dc3\u0dcf\u0dc4\u0dc0\u0dca\u0db0 \u0d9c\u0db1\u0dd2\u0dda\u0dba\u0ddd\u0da2\u0dba\u0d9c\u0dbb\u0dc4\u0daf\u0dcf\u0dba\u0dad\u0dd4\u0dc4\u0daf.\n\n\u0d9c\u0dd4 \u0d82\u0d86\u0dd9\u0dcf\u0dcf\u0dba\u0db4 \u0d85\u0db1\u0dd2\u0dbd\u0dca \u0da2\u0dba\u0db1\u0dca\u0dad\u0dca \u0db8\u0dc4\u0dad\u0dca\u0dcf \u0d82\u0d9a\u0db8\u0dca\u0d9a\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d \u0dc4 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc4 \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0db1\u0dd2\u0dc0\u0dba\u0db1\u0da2\u200d \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dd4\u0dbb\u0db8\u0dcf\u0db4 (\u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 (\u0b95\u0bb2\u0bc6\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf) \u0b85\u0ba9\u0bbf\u0bb2\u0bcd \u0b9c\u0baf\u0ba8\u0bcd\u0ba4 - \u0ba4\u0ba4\u0bc6\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0ba4\u0bbf, \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bc8\u0bbf\u0b9f\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bbf \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bc1\u0bae\u0bcd) (The Hon. (Dr.) Anil Jayantha - Minister of Labour and Deputy Minister of Finance and Planning) \u0dd2\u0dc3\u0dda\u0dba \u0dc2\u0dda\u0dba\u0dca\u0dc4\u0d9c\u0dbb\u0dca\u0dd2\u0d9a\u0dba\u0d9c\u0d87\u0dad\u0dd4\u0dda\u0dc5 \u0d9c\u0dda\u0d9a\u0daf \u0dc3\u0dcf \u0d9c\u0dda\u0dc0\u0dda\u0dc5 \u0d9c\u0dda\u0db4\u0daf\u0dda\u0dc5 \u0d9c\u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0db0\u0db1\u0dd3\u0d9a\u0dbb\u0dab\u0dba,\u0d9c\u0dda\u0d9a\u0daf \u0dc3\u0dcf \u0d9c\u0dda\u0dc0\u0dda\u0dc5 \u0d9c\u0dda\u0db4\u0daf\u0dda\u0dc5\u0dca\u0d9c\u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0db0 \u0dba\u0d9c\u0d91\u0d9a\u0dad\u0dd4\u0d9c\u0d9a\u0dd2\u0dbb\u0dd3\u0dc4\u0d9c\u0d9a\u0dd2\u0dba \u0d9c\u0d9a\u0daf\u0dbb\u0dab\u0daf\u0d9c\u0dc3\u0dcf\u0dca\u0db6\u0db1\u0dca\u0db0\u0dda\u0dba\u0dca\u0d9c\u0dbb\u0dad\u0dca\u0dda\u0dcf\u0daf\u0dad\u0dca,\u0d9c\u0dbb\u0dd2\u0dc5\u0d9c\u0dbb\u0dab\u0dca\u0da9\u0dd4\u0d9c\u0db6\u0db1\u0dbd\u0dba\u0d9c\u0dbd\u0db6\u0db1\u0daf\u0d9c\u0dbb\u0dca \u0dda\u0d9a\u0daf \u0d9c\u0dad\u0dd2\u0db6\u0dd4\u0dda\u0dab\u0dca\u0da9\u0d9c\u0dc3\u0dcf\u0daf\u0dda\u0dda\u0dca\u0dc2\u0dc0\u0d9c\u0dbb\u0dd4\u0d9c\u0dbb\u0dbb\u0dba\u0dca.\u0d9c\u0dda\u0dca\u0d9c\u0dc0 \u0dda\u0d9a\u0daf \u0d9c\u0d91\u0dba\u0d9c\u0dda:\u0dd4\u0dbd\u0dab\u0dba\u0d9a\u0dd2\u0dca\u0d9c\u0dc0\u0dca\u0db0 \u0dba\u0d9c\u0dc0\u0dd4\u0dab\u0daf\u0d9c\u0dc0\u0dd4\u0dc0\u0dad\u0dca,\u0d9c\u0d9c\u0dcf\u0dc0\u0dbd\u0dd2\u0dbb \u0dad\u0dca\u0d9c\u0dda\u0d9a\u0daf \u0dc3\u0dcf \u0d9c\u0dda\u0dc0\u0dda\u0dc5 \u0d9c\u0dda\u0db4\u0daf\u0dc5\u0d9c\u0dad\u0dd4\u0dc5\u0d9c\u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0db0 \u0dba\u0d9c\u0d91\u0d9a\u0dad\u0dd4\u0d9c\u0d9a\u0dd2\u0dbb\u0dd3\u0dc4\u0d9c\u0d9a\u0dd2\u0dba \u0d9c\u0d9a\u0daf\u0dbb\u0dab\u0dba\u0d9c\u0dcf\u0dc0\u0dad\u0dca\u0d9c\u0dc0\u0dca\u0db0 \u0dba\u0d9c\u0d9a\u0dbb\u0d9c\u0dbb\u0dcf\u0d9c\u0dba\u0dd4\u0dad\u0dd4\u0d9c\u0dc0 \u0dc0\u0daf.\u0d9c\n\n01. \u0da2 \u0daf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0daf\u0d9c\u0db4\u0dad\u0dca\u0d9c\u0dc0\u0dd4\u0dab\u0daf \u0d9c\u0db4\u0dc3\u0dcf \u0dda\u0dc3\u0dcf ,\u0d9c2024\u0d9c\u0dc3\u0dcf \u0dda\u0dcf \u0dca\u0db6\u0db1\u0dca\u0d9c\n\n21\u0dc0 \u0db1\u0dd2\u0d9c:\u0daf\u0d9c\u0dd2\u0d82 \u0d9c\u0dd2\u0d82\u0dba\u0daf\u0dd9\u0d9c\u0dda\u0d9a\u0daf \u0dc3\u0dcf \u0d9c\u0db8\u0dd2\u0dbd\u0d9c:\u0dca\u0dba\u0d9a\u0dba\u0d9c\u0d92\u0d9a\u0d9a\u0d9c11,096\u0dca\u0d9c\u0dda\u0dc0\u0dbd\u0daf\u0d9c\u0dad\u0dd2\u0dda\u0db6\u0db1 \u0dc0\u0daf.\u0d9c\u0d92\u0d9a\u0d9c2026\u0d9c\u0dc0\u0dca\u0dc2\u0dda\u0dda\u0d9c\u0dbb:\u0d9c\u0dc0 \u0d9c\u0dd2\u0dc3 \u0d9c\u0dad\u0dd2\u0dda\u0db6\u0db1 \u0d9c\u0db4\u0dca\u200d\u0dbb\u0dc4\u0daf\u0dab\u0dba\u0d9c\u0dbb\u0dad\u0dca\u0dcf\u0daf\u0dc4,\u0d9c\u0d92\u0d9a\u0d9a\u0d9c23,956\u0dca\u0d9c\u0dda\u0dbd\u0dc3\u0dcf\u0d9c\u0dd2\u0dc3\u0dba\u0daf\u0dbd\u0d9c"
