n\n\u0dd9\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0dd9 \u0db4 \u0db1\u0dda \u0d9a\u0dcf\u0dc0\u0daf\u0d9c\u0db1 \u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0dd9\u0db3\u0dd9 \u0dd2\u0daf\u0db4\u0dad\u0dd9\u0da7 \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1 \u0d85\u0db4\u0dc0\u0dcf\u0db0 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2 \u0daf \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9 \u0dc0\u0dd2\u0dba\u0dbd\u0db1\u0dca \u0dd9\u0dd9\u0dad\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dcf\u0dc0\u0dbd\u0dcf \u0dba \u0d85\u0db8\u0dca\u0dd9 \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dd9\u0dbd\u0dcf \u0da2\u0dcf\u0dad\u0dd2\u0d9a\u0dcf \u0dc0\u0dd2\u0d9c \u0db1 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd9\u0dcf\u0dbd\u0dd9 \u0dc0\u0dd2\u0dba\u0dbd\u0db1\u0dca \u0db1\u0dd0\u0dd9\u0dad \u0d85\u0db4\u0dc0\u0dcf\u0db0 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2 \u0daf \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0daf\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0da7 \u0dd0\u0db8\u0dca\u0dda \u0daf\u0dd3 \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf. 1\u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 05) \u0d8a\u0da7 \u0d85\u0db8\u0dad\u0dc0\u0dd9 \u0daf\u0dda \u0dc3\u0dda\u0dd9\u0db1\u0dca\u0db0\u0daf\u0dd9\u0db1\u0dca \u0dc0\u0dd2\u0d9c \u0db1 \u0dd9\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0daf\u0dd9\u0db1\u0dca \u0daf\u0db4\u0db1\u0dca\u0dd9\u0dcf \u0daf\u0dd3 \u0dad\u0dd2\u0daf\u0dd9\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0dd9\u0da7 \u0dc3\u0dd3\u0db1\u0dd2 \u0dd9\u0daf\u0dd4 \u0d85\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0daf\u0db8\u0db1\u0dca \u0db4\u0dc3\u0dd4 \u0dc3\u0dd3\u0db1\u0dd2 \u0d86\u0db1\u0dd9\u0db1\u0d9a\u0dcf\u0dbb\u0dd4\u0dd9\u0db1\u0dca \u0dbd\u0dd9\u0dcf \u0d9c\u0dad\u0dca\u0dad \u0dbd\u0dcf\u0db7\u0dd9 \u0db8\u0dad \u0d85 \u0dcf\u0dc5 \u0dad\u0d9a\u0dca\u0daf\u0dc3\u0dae\u0dbb\u0dd4 \u0dd9\u0dbb\u0dca\u0dbd\u0dc2 \u0db8\u0dad \u0db4 \u0db1\u0dda\u0dd9 \u0dba \u0d86 \u0dcf\u0dd9\u0db8 \u0dad\u0d9a\u