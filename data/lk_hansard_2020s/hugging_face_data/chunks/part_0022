\u0da2\u0dcf\u0dd2\u0dd9 \u0da7\u0dba\u0d9a\u0dca \u0db4\u0dcf\u0dad\u0dca\u200d\u0dbb \u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1 \u0dcf\u0dd4\u0da7\u0dd2[\u0db4 \u0d85\u0db4\u0dd2 \u0dca\u0dda \u0dd9\u0dc5\u0dcf. \u0d91\u0db8 \u0dc0 \u0d86\u0db4 \u0dcf\u0db8\u0da7\u0db1\u0dca\u0dad \u0db4\u0dd3\u0da9\u0dcf\u0da7\u0db4 \u0db4 \u0d9a \u0da2\u0dca\u0dad\u0dcf\u0da7\u0db4 \u0d85\u0dad\u0dba\u0da7\u0dc1\u0dba \u0db4\u0dcf\u0dd4\u0dc5\u0dd9\u0dda \u0d9a\u0dd4\u0db4 \u0d8b\u0db8 \u0dc0 \u0d9a\u0dcf \u0db8\u0d9a\u0dda\u0da7\u0dcf \u0db4\u0da7 \u0d9a\u0da7\u0dcf\u0db8\u0da7\u0dca [\u0dcf\u0db8 \u0dc0\u0db4 \u0db8\u0dda \u0dcf\u0daf\u0dc3\u0dd2 \u0d86\u0db4 \u0dcf \u0dad \u0d9a \u0d9a\u0da7[\u0d9a\u0dca \u0dca\u200d\u0dbb\u0dd9\u0dcf\u0dc1[\u0db4 \u0db4 \u0d9a \u0dbb\u0dd3\u0db8\u0dda\u0db8\u0dda \u0db8\u0dba\u0d9c\u0dd4\u0dbd\u0dcf\u0dc3\u0dd2[ \u0dad\u0dad\u0dcf\u0db8 \u0dc0 \u0da7\u0dd4 \u0da7 \u0d9a \u0db8\u0da7\u0dca\u0da7\u0dcf. \u0d92 \u0db1\u0dd2\u0d9a\u0dcf \u0dad\u0db8 \u0dc0\u0dba\u0dd2 2]2 \u0db8\u0dca\u0dcf\u0da7\u0dd4\u0dda\u0db6\u0dbb\u0dca\u0dbd \u0db8 \u0dc0\u0dcf\u0d9a\u0db8\u0dad 28\u0da7\u0dd4\u0db1\u0dd2 \u0dcf \u0da7\u0dc0 \u0da2\u0dca\u0dcf\u0d9a\u0dbb\u0db4\u0dd2\u0dd4\u0db8 \u0dc0\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0d91[ \u0dca\u200d\u0dbb\u0dd9\u0dcf\u0dc1[\u0db4 \u0db4 \u0d9a \u0dd9\u0db8\u0dc5\u0dda."
