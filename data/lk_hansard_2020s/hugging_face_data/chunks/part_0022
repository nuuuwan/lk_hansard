u25cf \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd9\u0dcf\u0dd2\u0d82\u0dc1\u0daf \u0dd2\u0dd9\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2\u0dd9 \u0dbb\u0dd0\u0d9a\u0dd2\u0dd9\u0dcf\u0dd9\u0d9a\u0dcf\u0da7 \u0daf\u0d9c\u0dcf\u0dc3\u0dae \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0dda \u0d9a\u0dca \u0daf\u0dc4\u0ddd \u0d8a\u0da7 \u0dd9\u0dd0\u0da9\u0dd2\u0db1\u0dca \u0d9a\u0dcf\u0dcf\u0dbd\u0dd9\u0d9a\u0dca \u0dc0\u0dd2\u0daf\u0dda\u0dc1 \u0dbb\u0dd0\u0d9a\u0dd2\u0dd9\u0dcf\u0daf\u0dd9\u0dc4\u0dd2 \u0db1\u0dd2\u0dc0\u0dad\u0dd9 \u0d86\u0db4\u0dc3\u0dd4 \u0dad\u0db8 \u0db8 \u0db6\u0db8\u0da7 \u0db4\u0dd0\u0db8\u0dd2 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 5\u0d9a\u0dca \u0daf\u0db1\u0dcf\u0dd2\u0d9a\u0dca\u0db8\u0dc0\u0dd6 \u0dc0\u0dd2\u0d9c\u0db8\u0db1\u0dd2\u0d9a\u0dcf \u0dbb\u0db8\u0dd2\u0d9a\u0dcf\u0db1\u0dca\u0db1\u0dca \u0daf\u0dd9\u0dad \u0d85\u0daf\u0dd9\u0dc0 \u0daf \u0d9a\u0dcf\u0d9a\u0dca \u0dd9\u0da7\u0daf\u0dad\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dd9\u0dbd\u0dca 250 000\u0d9a\u0dcf \u0db8\u0dd6\u0dbd\u0dba \u0daf\u0db1\u0dcf\u0dd9\u0db1 \u0d86\u0db0\u0dcf\u0dc0 \u0dbd\u0dd9\u0dcf \u0daf\u0dd3\u0db8. 1\u0dc3\u0dae\u0dd9\u0dd9\u0dd2\u0d82 \u0dbb\u0dd0\u0d9a\u0dd2\u0dd9\u0dcf\u0dd9\u0da7 \u0d85\u0dd9\u0dc1\u0dba \u0db7\u0dcf\u0dab\u0dca\u0da9\u0da9 \u0dc4\u0dcf \u0d8b\u0db4\u0d9a\u0dcf\u0dc0 \u0db8\u0dd2\u0dbd\u0daf\u0dd3 \u0d9c\u0dd0\u0dad\u0dd2\u0db8 \u0d86\u0daf\u0dd9 \u0dc3\u0db3\u0dc4\u0dcf 1015 \u0dd9\u0dbb\u0dca\u0dbd\u0dc2\u0dd9 \u0dc3\u0db3\u0dc4\u0dcf 1015.21.32 \u0daf\u0db1 \u0dd9\u0db1 \u0dc0\u0dd2\u0da7 \u0d86\u0db4\u0dc3\u0dd4 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0dc0\u0dd2\u0d9c\u0db8\u0db1\u0dd2\u0d9a\u0dcf\u0db1\u0dca\u0db1\u0dca 307 \u0daf \u0daf\u0db1\u0d9a\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dd9\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dd9\u0db1 25.809\u0d9a\u0dcf \u0db8\u0dd4 \u0dbd\u0d9a\u0dca \u0dbd\u0dd9\u0dcf \u0daf\u0dd3 \u0d87\u0dad.\n\n\u25cf \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd9\u0dcf\u0dd2\u0d82\u0dc1\u0daf \u0dd2\u0dd9\u0d