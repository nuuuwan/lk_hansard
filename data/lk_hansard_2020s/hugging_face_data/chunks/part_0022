    "chunk_text": "iii. \u0db6\u0dd2\u0dcf \u0dc0\u0dad\u0da7\u0dd4\u0dab\u0dd4 \u0dc3\u0dd2\u0daf\u0dd4\u0dba\u0dcf\u0db6\u0dbd \u0dc3\u0dad\u0db4\u0dba\u0dd4\u0db8 \u0dba\u0d9c\u0dcf \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db8\u0dda \u0dc0\u0db1 \u0dc3\u0dd2 \u0dbd\u0dd2\u0d82\u0d9a\u0dcf \u0dc3\u0dd2\u0daf\u0dd4\u0dba\u0dcf\u0db6\u0dbd \u0db8\u0dca\u0da9\u0dbd\u0dbd\u0dba \u0dc3\u0dd2\u0db1\u0dca\u0db1\u0dca \u0d9a \u0dba\u0dd4\u0dc0\u0dd9 \u0d9a\u0dbb \u0d87\u0dad. \u0d87\u0dad\u0dad\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dc3\u0dd2\u0d82\u0dc3\u0dda\u0d9a\u0dbb\u0dda \u0d9a \u0dba\u0dd4\u0dc0\u0dd9 \u0db1\u0dca\u0daf\u0dd4 \u0d9a\u0dbb \u0d87\u0dad\u0dca\u0db8\u0dad\u0dca \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0dba\u0dcf\u0d9a\u0dc0\u0dba. \u0dc3\u0dd2\u0daf\u0dd4\u0dba\u0dcf\u0db6\u0dbd \u0db4\u0dd3\u0db0\u0dc0\u0dbb\u0dba \u0dc3\u0dda\u0d9c\u0dcf\u0dc0\u0dbb \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dcf\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0dba \u0d85\u0dbd\u0dd4\u0dad\u0dca\u0dc0\u0dad\u0da9\u0dd2\u0dba\u0dcf\u0dc0\u0db1\u0dca/\u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dc3\u0dd2\u0d82\u0dc3\u0dda\u0d9a\u0dbb\u0dda \u0d9a \u0dba\u0dd4\u0dc0\u0dd9 \u0d89\u0daf\u0dbb\u0dd2 \u0db8\u0db8\u0db8\u0dc4\u0dba\u0dd4\u0dda \u0dc3\u0dc4 \u0db1\u0da9\u0dbd\u0dad\u0dca\u0dc0\u0dd9 \u0d9a \u0dba\u0dd4\u0dc0\u0dd9 \u0dc4\u0dbb\u0dc4\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0db8\u0d9a\u0dca\u200d\u0dbb\u0db8\u0db8\u0dba\u0db1\u0dca \u0db1\u0dca\u0daf\u0dd4 \u0d9a\u0dbb\u0db8\u0dd0 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0d91\u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dc0\u0dc3\u0dbb \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a \u0d9a\u0dcf\u0dbd \u0dc3\u0dd3\u0db8\u0dcf\u0dc0\u0d9a\u0dca \u0db8\u0dd4\u0dc5\u0dd4\u0dbd\u0dca\u0db8\u0dbd\u0dca \u0db8\u0db8\u0db8 \u0db4\u0dd2\u0dbb\u0dd2\u0dc0\u0dad\u0dba \u0db8\u0db6\u0daf\u0dd3 \u0dba\u0db1 \u0db4\u0dbb\u0dd2\u0daf \u0d9a \u0dba\u0dd4\u0dd4 \u0db1\u0dca\u0daf\u0dd4 \u0db8\u0d9a\u0db8\u0dbb\u0db8\u0dd0 \u0d87\u0dad. \u0d91\u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dba\u0dcf \u0db4\u0dcf\u0dbb\u0dd2\u0db8\u0dc0\u0db1\u0dd2\u0dab\u0d9a\u0dba\u0db1\u0dca \u0d85\u0dc0\u0db8 \u0db6\u0dbd\u0db4\u0dd1\u0db8\u0d9a\u0dca \u0d87\u0dc0\u0dbb\u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf \u0d9a \u0dba\u0dd4\u0dc0\u0dd9 \u0d9a\u0dbb\u0db8\u0dd0 \u0d87\u0dad.\n\nd) i. \u0db1\u0dad\u0dad.\n\nii. 2026 \u0dc0\u0dc3\u0db8\u0dbb\u0dca \u0db4\u0dc5\u0db8\u0dd4 \u0dd9\u0dcf\u0dc3\u0dda\u0dc0\u0dd9 \u0d85\u0dba\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc3\u0dd2\u0d82\u0db8\u0dc1\u0db1\u0db0\u0db1\u0dba \u0dc3\u0dcf\u0dc4\u0dcf \u0dc3\u0dda\u0db8\u0d8b\u0da0\u0dca\u0da1\u0dcf\u0db8\u0dc0\u0db1\u0dca \u0dc3\u0dd2\u0dbb\u0dcf\u0db8 \u0dd9\u0dad\u0db1\u0dca\u0dc0\u0dd3\u0db8\u0dda \u0db8\u0dba\u0db1\u0da2\u0db1\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0db8\u0db8\u0dba\u0dc4\u0dd2 \u0db4\u0dd2\u0dbb\u0dd2\u0dc0\u0dad\u0dba \u0d87\u0dc0\u0dd9\u0dc5\u0dad\u0dca \u0d9a\u0dbb\u0db8\u0dd0 \u0dbd\u0dad\u0db6\u0dd3\u0db8 \u0d85\u0db8\u0dcf\u0dad\u0dba \u0db8\u0dca\u0da9\u0dbd\u0dbd \u0d85\u0db8\u0dd0\u0db8\u0dad\u0dc0\u0dbb\u0dba \u0dbd\u0dad\u0db6\u0dd3 \u0d87\u0dad. \u0d8a \u0db1\u0dd2\u0dba\u0dcf\u0db8\u0db1 \u0d86\u0dba\u0dad\u0db1\u0db8 \u0d85\u0db8\u0dd0\u0db8\u0dad\u0dc0\u0dbb\u0dba \u0dc4\u0dd2\u0db8\u0dd2 \u0dc0\u0dd3 \u0db8\u0db1\u0dcf\u0db8\u0dad\u0dad.\n\ne) \u0dc4\u0dbb\u0dc3\u0dda \u0dc3\u0dc4\u0db1\u0dcf\u0db0\u0dcf\u0dbb - cross-subsidy - \u0dc3\u0dad\u0dbd\u0dc3\u0dd3\u0db8\u0dda \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dda\u0dba \u0d89\u0dc0\u0dad\u0dca \u0db8\u0db1\u0dcf\u0db8\u0d9a\u0db8\u0dbb\u0dca.\n\ni. \u0d91\u0dc0\u0dad\u0db1\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0db4\u0dad\u0db1 \u0db8\u0db1\u0dcf\u0db1\u0d9f\u0dd3.\n\nii. \u0d91\u0dc0\u0dad\u0db1\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0db4\u0dad\u0db1 \u0db8\u0db1\u0dcf\u0db1\u0d9f\u0dd3.\n\n655 656\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0db8\u0dda\u0db1\u0dca\u0dc0\u0dd9\u0dc0\n\nf) \u0d86\u0db1\u0dca\u0dba\u0dcf\u0db8\u0dd0 \u0dc3\u0dd2\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db6\u0dad\u0dd2\u0d82\u0d9a\u0dd4\u0dc0 - ADB, \u0d86\u0db1\u0dca\u0dba\u0dcf\u0db8\u0dd0 \u0dba\u0da7\u0dd2\u0dad\u0dbd \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dda \u0d86\u0db8\u0dba\u0db1\u0da2\u0db1 \u0db6\u0dad\u0dd2\u0d82\u0d9a\u0dd4\u0dc0 - AIIB - \u0dc3\u0dc4 \u0db8\u0dbd\u0db1\u0d9a \u0db6\u0dad\u0dd2\u0d82\u0d9a\u0dd4\u0dc0 \u0dba\u0db1 \u0db6\u0dc4\u0dd4\u0db4\u0dcf\u0dbb\u0dca\u0dc1\u0dda\u0dc0\u0dd3\u0dba \u0db8\u0dd6\u0dbd\u0dbd\u0dba \u0d86\u0dba\u0dad\u0db1 \u0dc4\u0dbb\u0dc4\u0dcf \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dc3\u0db4\u0dba\u0dcf \u0dd9\u0dad\u0db8\u0db1\u0dca. \u0d8a \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0dbb\u0dcf\u0da2\u0dba \u0db8\u0db4\u0dde\u0dd3\u0dd9\u0dba\u0dcf\u0d9a \u0dc4\u0dc0\u0dd4\u0dbd\u0dca\u0d9a\u0dcf\u0dbb\u0dd2\u0dad\u0dca\u0dc0 \u0db4\u0daf\u0db1\u0db8 \u0db8\u0dad \u0dc3\u0dda\u0db8\u0dda\u0dc2\u0dda \u0dba\u0da7\u0dd2\u0dad\u0dbd \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dda \u0dc3\u0dcf\u0dc4\u0dcf \u0db8\u0db4\u0dde\u0dd3\u0dd9\u0dba\u0dcf\u0d9a \u0d85\u0dd2\u0d82\u0dc1\u0db8 \u0d86\u0db8\u0dba\u0db1\u0da2\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0db8 \u0daf\u0dcf\u0dba\u0d9a\u0dad\u0dca\u0dc0\u0dba \u0dbd\u0db6\u0dcf \u0dd9\u0dad\u0db8\u0dda\u0db8 \u0dc3\u0dcf\u0dc4\u0dcf \u0d9a \u0dba\u0dd4\u0dc0\u0dd9 \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd3. \u0d91\u0db8\u0dc3\u0dda\u0db8 \u0db1\u0dd2\u0dba\u0dcf\u0db8\u0db1 \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dda\u0dba \u0dba \u0db8\u0dad\u0dca \u0db8\u0db4\u0dde\u0dd3\u0dd9\u0dba\u0dcf\u0d9a \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dad\u0dca\u0dc0\u0dba \u0dc3\u0dc4\u0dd2\u0dad \u0dc3\u0dda\u0db8\u0dda\u0dc2\u0dda \u0dbb\u0dd0\u0dc4\u0dad\u0db1\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0dd9 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dcf\u0dc4\u0dcf \u0daf \u0dc3\u0dd2\u0daf\u0dd4\u0dba\u0dcf\u0db6\u0dbd \u0db4\u0db1\u0db8\u0dad\u0dc4\u0dd2 \u0dc3\u0dd2\u0d9a\u0dbb\u0dc3\u0dd2\u0db0\u0dcf\u0db1 \u0dc3\u0dbd\u0dc3\u0dcf \u0d87\u0dad.\n\n\u0dc3\u0dda\u0db8\u0dda\u0dc2\u0dda \u0dc3\u0dd2\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a \u0dba\u0dd4\u0dc0\u0dd9 \u0dc3\u0dcf\u0dc4\u0dcf \u0d86\u0db1\u0dca\u0dba\u0dcf\u0db8\u0dd0 \u0dc3\u0dd2\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db6\u0dad\u0dd2\u0d82\u0d9a\u0dd4\u0dc0 \u0dc3\u0dd2\u0db1\u0dca\u0db1\u0dca \u0db8\u0dda \u0dc0\u0db1 \u0dc3\u0dd2 \u0dad\u0dca \u0d87\u0db8\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0db8\u0dd0 \u0db8\u0da9\u0dbd\u0dcf\u0dbd\u0dbb\u0dca \u0db8\u0dd2\u0dba\u0dcf\u0dba\u0db1 200\u0d9a \u0dda\u0dba\u0d9a\u0dca \u0daf, \u0db8\u0dbd\u0db1\u0d9a \u0db6\u0dad\u0dd2\u0d82\u0d9a\u0dd4\u0dc0 \u0dc3\u0dd2\u0db1\u0dca\u0db1\u0dca \u0d87\u0db8\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0db8\u0dd0 \u0db8\u0da9\u0dbd\u0dcf\u0dbd\u0dbb\u0dca \u0db8\u0dd2\u0dba\u0dcf\u0dba\u0db1 30\u0d9a \u0dda\u0dba\u0d9a\u0dca \u0daf, \u0d86\u0db1\u0dca\u0dba\u0dcf\u0db8\u0dd0 \u0dba\u0da7\u0dd2\u0dad\u0dbd \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dda \u0d86\u0db8\u0dba\u0db1\u0da2\u0db1 \u0db6\u0dad\u0dd2\u0d82\u0d9a\u0dd4\u0dc0 \u0dc3\u0dd2\u0db1\u0dca\u0db1\u0dca \u0d87\u0db8\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0db8\u0dd0 \u0db8\u0da9\u0dbd\u0dcf\u0dbd\u0dbb\u0dca \u0db8\u0dd2\u0dba\u0dcf\u0dba\u0db1 52\u0d9a \u0dda\u0dba\u0d9a\u0dca \u0daf \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0d87\u0dad. \u0d91\u0db8\u0dc3\u0dda\u0db8, \u0d89\u0daf\u0dbb\u0dd2\u0db8 \u0daf\u0dd3 \u0dc3\u0dda\u0db8\u0dda\u0dc2\u0dda \u0dba\u0da7\u0dd2\u0dad\u0dbd \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0\u0db8\u0dba\u0db1\u0dca \u0db8\u0dd6\u0dbd\u0dbd\u0dba \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dda \u0dc3\u0dad\u0db4\u0dba\u0dd3\u0db8 \u0d86\u0db1\u0dca\u0dba\u0dcf\u0db8\u0dd0 \u0dba\u0da7\u0dd2\u0dad\u0dbd \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dda \u0d86\u0db8\u0dba\u0db1\u0da2\u0db1 \u0db6\u0dad\u0dd2\u0d82\u0d9a\u0dd4\u0dc0, \u0d86\u0db1\u0dca\u0dba\u0dcf\u0db8\u0dd0 \u0dc3\u0dd2\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db6\u0dad\u0dd2\u0d82\u0d9a\u0dd4\u0dc0 \u0dc3\u0dc4 \u0db8\u0dbd\u0db1\u0d9a \u0db6\u0dad\u0dd2\u0d82\u0d9a\u0dd4\u0dc0 \u0db1\u0dca\u0dba \u0d9a\u0dad\u0db8\u0dad\u0dad\u0dca\u0dad \u0db4\u0dc5 \u0d9a\u0dbb \u0d87\u0dad.\n\n\u0d8a \u0d85\u0db8\u0dad\u0dbb\u0dc0, \u0dc3\u0dda\u0db8\u0dda\u0dc2\u0dda \u0dba\u0da7\u0dd2\u0dad\u0dbd \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dda \u0d9a \u0dba\u0dd4\u0dc0\u0dd9 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dc0 \u0db1\u0dad\u0dd2\u0d82\u0dc0\u0dd3\u0db8 \u0dc3\u0dcf\u0dc4\u0dcf \u0db1\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0db8\u0dd0 \u0dbd\u0db6\u0db1 \u0d86\u0db8\u0dba\u0db1\u0da2\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0db8\u0dd9\u0db1\u0dca \u0dc3\u0dd2\u0d9a\u0dbb\u0db8\u0dad\u0dca\u0dc0, \u0d86\u0db8\u0dba\u0db1\u0da2\u0db1 \u0db8\u0dba\u0db1\u0da2\u0db1\u0dcf \u0db8\u0dbd\u0dc3 \u0d91\u0db8 \u0db8\u0dba\u0db1\u0da2\u0db1\u0dcf \u0d9a\u0dad\u0dcf\u0dc0\u0dd3\u0db8 \u0d9a\u0da9\u0dd2\u0db1\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dba\u0dc0\u0dbb \u0dd9\u0dad\u0db8\u0dda\u0db8 \u0daf \u0d85\u0db8\u0dcf\u0dad\u0dba \u0db8\u0dca\u0da9\u0dbd\u0dbd\u0dba \u0dad\u0dd3\u0dbb\u0dda\u0dba \u0d9a\u0dbb \u0d87\u0dad. \u0db6\u0dbd\u0dc1\u0d9a\u0dca\u0dc0\u0dbb \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0dd2\u0d82\u0dc1\u0dba \u0dc3\u0dd2\u0db1\u0dca\u0db1\u0dca \u0db8\u0dda \u0dc0\u0db1 \u0dc3\u0dd2 \u0dad\u0dca \u0db8\u0dbd\u0db1\u0d9a \u0db6\u0dad\u0dd2\u0d82\u0d9a\u0dd4\u0db8\u0d8b \u0dc3\u0dc4\u0dcf\u0dba \u0daf \u0d87\u0dc0\u0dbb\u0dc0 \u0db8\u0db4\u0dde\u0dd3\u0dd9\u0dba\u0dcf\u0d9a \u0d85\u0dd2\u0d82\u0dc1\u0db8 \u0dc3\u0dc4\u0dc0\u0dcf\u0dd2\u0dab\u0dad\u0dca\u0dc0\u0dba \u0dbd\u0db6\u0dcf \u0dd9\u0dad\u0db8\u0dda\u0db8 \u0dc3\u0dcf\u0dc4\u0dcf \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4 \u0d86\u0d9a\u0dd2\u0dc0\u0dbb\u0dba\u0d9a\u0dca \u0dc3\u0d9a\u0dc3\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9a \u0dba\u0dd4\u0dc0\u0dd9 \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0db1\u0dca\u0da7\u0dd3."
