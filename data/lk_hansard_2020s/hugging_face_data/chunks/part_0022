    "chunk_text": "\u0d92 \u0dc0\u0dcf\u0d9c\u0dda\u0db8\u0d8b \u0d9c\u0dda \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf\u0dc0 \u0db1\u0dca\u0dd3\u0dca\u200d \u0dc0\u0db1 \u0d85\u0dad\u0dba\u0dad\u0dd4\u0dba \u0d9c\u0dda \u0d9a\u0dcf\u0dba\u0da7\u0dba\u0dad\u0dca \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9a\u0db1 \u0d9a\u0dd2\u0db8\u0dd2\u0dad\u0dd2\u0dba\u0dd2. \u0d8a\u0d9c\u0dda \u0d9c\u0dc4\u0ddd \u0d9c\u0db4\u0d9c\u0dbb\u0dca\u0daf\u0dcf \u0daf\u0dc0\u0d9c\u0dc3\u0dda \u0db8\u0d9c\u0dda \u0d89\u0db1\u0dca\u0d9a\u0daf\u0dd2\u0dba\u0dcf\u0db1\u0dd4 \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0dba \u0da7\u0db4\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db8\u0db1\u0dca\u0d9a\u0dd3\u0dad\u0dd4\u0d9c\u0db8 [ \u0d85\u0daf\u0dc4\u0dc3 [ \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dba \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf \u0db8\u0db8 \u0daf\u0dd2 [\u0d9a\u0dcf. \u0d92\u0d8b \u0db1\u0dcf\u0db8\u0dbd\u0dca \u0dba\u0dcf\u0da2\u0db4 [\u0dc2\u0dca\u0da8 \u0db8\u0db1\u0dca\u0d9a\u0dd3\u0dad\u0dd4\u0db8\u0dcf\u0d9c\u0dda \u0db6\u0dd1\u0dda \u0d91\u0d9a \u0d85\u0dba\u0d9c\u0dd9\u0db1 \u0dba\u0db1\u0dca\u0d9a\u0db1 \u0db8\u0db8 \u0d9c\u0dd2\u0dba\u0db4\u0dd4 \u0db6\u0dc0 \u0d9a\u0dd2\u0dba\u0dd2\u0dba\u0db1\u0dca\u0d9a. \u0d92 \u0da7\u0db4\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db8\u0db4 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9a\u0db1 \u0dad\u0dd2\u0d9c\u0db6\u0db1 \u0d9a\u0dae\u0dcf\u0dc0 \u0d9c\u0dda\u0d9a\u0dba\u0dd2. \u0d94\u0d8b\u0d8b \u0d85\u0da7\u0db4 \u0d89\u0db1\u0dca\u0d9a\u0daf\u0dd2\u0dba\u0dcf\u0db1\u0dd4 \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0dba [ \u0d9c\u0dd2\u0dba\u0dcf. \u0d92 \u0d89\u0db1\u0dca\u0d9a\u0daf\u0dd2\u0dba\u0dcf\u0db1\u0dd4 \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0dba\u0db4 \u0d85\u0da7\u0db4 \u0d9c\u0dd2\u0d9c\u0dda \u0db8\u0dd3\u0db4 \u0db8\u0dcf\u0dc3 6\u0d9a\u0db4 \u0d9a\u0dbd\u0dd2\u0db1\u0dca\u0d9a. \u0db8\u0db8\u0dad\u0dca\u0d8b \u0da0\u0dd2\u0dad\u0dca\u200d\u0dbb\u0dcf\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db1\u0dca\u0d9a\u0daf\u0dd4 \u0db8\u0db1\u0dca\u0d9a\u0dd3\u0dad\u0dd4\u0db8\u0dcf\u0dad\u0dca\u0d8b \u0d9c\u0dc0\u0db1\u0dad\u0dca \u0db4 [\u0dc2\u0dca\u0da8 \u0dd9\u0da7\u0db1\u0dcf\u0dc0\u0d9a \u0db8\u0db1\u0dca\u0d9a\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0d9a \u0d91 [\u0d9a \u0d89\u0db1\u0dca\u0d9a\u0daf\u0dd2\u0dba\u0dcf\u0db1\u0dd4 \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0dba\u0d9a\u0db4 \u0d9c\u0dd2\u0dba\u0dcf. \u0d92 \u0d9c\u0dc0\u0dbd\u0dcf\u0d9c\u0d8b\u0daf\u0dd3 \u0d89\u0db1\u0dca\u0d9a\u0daf\u0dd2\u0dba\u0dcf\u0d9c\u0d8b \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db8\u0dc4 \u0d9c\u0d9a\u0dcf\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dda\u0dad\u0dd4\u0dd2\u0dba\u0dba\u0dad\u0dca \u0db8\u0dd4\u0da7 \u0dd9\u0dd2\u0dc4\u0dd4\u0da7\u0dcf. \u0d92 \u0dc3\u0dda\u0dae\u0dcf\u0db1\u0d9c\u0dda\u0daf\u0dd3 \u0dc4\u0db8\u0dd4 \u0dc0\u0dd4\u0dab\u0dd4 \u0d86\u0da0\u0dcf\u0dbb\u0dca\u0dba \u0dc3\u0db8\u0db1\u0dca\u0d9a\u0dad\u0dcf \u0db8\u0dc4\u0dad\u0dca\u0dd2\u0dba\u0dba \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0db4 \u0d92 \u0d86\u0dba\u0dcf\u0dca\u200d\u0db1\u0dcf\u0dc0 \u0d9a\u0d9c\u0dd9\u0dda. \u0d85\u0da7\u0db4\u0dad\u0dca \u0d91\u0dad\u0dd4\u0dd2\u0dba\u0dba\u0db4 \u0d86\u0dba\u0dcf\u0dca\u200d\u0db1\u0dcf \u0d9a\u0dd9\u0dcf\u0d8b \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0db4 \u0d91\u0db1\u0dca\u0d9a\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d91\u0dad\u0dd4\u0dd2\u0dba\u0dba \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9c\u0dda\u0db1\u0dca\u0d9a\u0dad\u0dd4\u0d9c\u0d8b\u0daf\u0dd3 \u0dc0\u0dd2\u0db4 [\u0dc2\u0dca\u0da8 \u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0dcf\u0dc0 \u0dc4\u0db8\u0dd4 \u0dc0\u0dd4\u0da7\u0dcf. \u0d91\u0dad\u0dd4\u0dd2\u0dba\u0dba \u0d9a\u0dba\u0db4\u0dd4 \u0d86\u0dba\u0dcf\u0dca\u200d\u0db1\u0dcf\u0dc0\u0d9a\u0db4 \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0d9c\u0dda \u0db4 [\u0dc2\u0dca\u0da8\u0d9c\u0dba\u0db1\u0dca\u0d9a \u0db8\u0db1\u0dca\u0d9a\u0dd3\u0dc0\u0dbb\u0dd4 \u0dc4\u0dad\u0dba\u0d9c\u0daf\u0d9c\u0db1 [ \u0d89\u0db1\u0dca\u0d9a\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0db4 \u0dba\u0db1\u0dca\u0d9a\u0db1 \u0dad\u0dd3\u0dba\u0da7\u0dba \u0d9a\u0dd9\u0dcf. \u0d92 \u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0db4\u0db8 \u0d9c\u0db4\u0dcf\u0daf\u0dd4\u0da2\u0db1 \u0d9c\u0db4\u0dba\u0db8\u0dd4\u0da7\u0dad\u0dca \u0db8\u0dd4\u0da7 \u0dd9\u0dd2\u0dd3\u0db8 \u0d9a\u0dba\u0db1 \u0dbd\u0daf \u0d86\u0dba\u0dcf\u0dca\u200d\u0db1\u0dcf\u0dc0\u0d9a\u0dd2\u0db1\u0dca\u0d9a \u0d92 \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8\u0dad\u0dca \u0d89\u0db1\u0dca\u0d9a\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0db4 \u0d9c\u0dd2\u0dba\u0dcf. \u0d92 \u0d9c\u0dc0\u0dbd\u0dcf\u0d9c\u0d8b\u0daf\u0dd3 \u0da2\u0db1\u0dad\u0dcf \u0dc0\u0dd2\u0db8\u0dd4 [\u0dad\u0dd2 \u0d9c\u0db4\u0dba\u0db8\u0dd4\u0da7 \u0dc3\u0dc4 \u0d85\u0d9c\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0db4 [\u0dc2\u0dca\u0da8 \u0dd9\u0da7\u0db1\u0dcf\u0dc0\u0d9a \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dd2\u0dad\u0dba\u0dd2\u0db1\u0dca\u0d9a \u0d89\u0db1\u0dca\u0d9a\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0db4 \u0d9c\u0dd2\u0dba\u0dad\u0dca\u0d8b \u0d92 \u0d85\u0dba \u0d9c\u0dda \u0dc3\u0db6\u0db3\u0dad\u0dcf \u0dc4\u0daf\u0dcf \u0d9c\u0db1\u0dcf\u0dd9\u0dd2\u0db1\u0dd3\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0d92 \u0d85\u0dba\u0db4 \u0d86\u0dba\u0dcf\u0dca\u200d\u0db1\u0dcf \u0d9a\u0dba\u0db1\u0dca\u0d9a\u0d9c\u0db1\u0dca\u0d9a \u0db1\u0dd2\u0dad\u0dd4\u0dc0 \u0d87\u0dad\u0dd2. \u0dc4\u0dd2\u0db6\u0dd2\u0dba\u0dd2\u0d8b \u0d9c\u0dda \u0db4 [\u0dc2\u0dca\u0da8 \u0d9c\u0daf\u0d9a\u0db4 \u0d86\u0dba\u0dcf\u0dca\u200d\u0db1\u0dcf \u0d9a\u0dd9\u0dcf\u0db8 \u0d91\u0dad\u0dd2\u0db1 \u0db1\u0dca\u0da7\u0dd2\u0db1 \u0d9c\u0da2\u0dba\u0dc2\u0dca\u0da8\u0dda\u0db0\u0dad\u0db8 \u0d9c\u0dd3\u0dba\u0db4\u0dcf\u0dbd\u0d9a\u0dba\u0dcf\u0db4 \u0dad\u0db8\u0dba\u0dd2 \u0d92 \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0dba \u0dba\u0dd3\u0daf\u0dd3 \u0d92 \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0d9c\u0dda \u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dca\u0dc0\u0dba \u0dd2\u0dba \u0d9c\u0dc0\u0db1\u0dca\u0d9a\u0d9c\u0db1\u0dca\u0d9a. \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0da2\u0db1\u0dcf\u0d9a\u0dbb\u0db4\u0dad\u0dd2 \u0d85\u0d9c\u0dda [\u0dc2\u0dca\u0da8\u0d9a\u0d9c\u0dba [ \u0dc0\u0dd4\u0dab\u0dd4\u0d8b \u0d9a\u0dd2\u0db6\u0dd2\u0db1\u0da7\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dba \u0dd4\u0dbb\u0dba\u0dba [ \u0daf\u0dba\u0db4\u0dd4 \u0db1\u0dcf\u0db8\u0dbd\u0dca \u0dba\u0dcf\u0da2\u0db4 [\u0dc2\u0dca\u0da8 \u0db8\u0dd2\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0d92 \u0d9c\u0dc0\u0dbd\u0dcf\u0d9c\u0d8b\u0daf\u0dd3 \u0d92 \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0d9c\u0dda \u0db1\u0dcf\u0dba\u0d9a\u0dba\u0dcf \u0dc0\u0dd4\u0d9c\u0dab\u0dca. \u0db8\u0db8 \u0dad\u0db1\u0dc0\u0dcf\u0d8b \u0d9c\u0db8\u0dad\u0dd2\u0db1 \u0d89\u0db1\u0dca\u0d9a\u0db1 \u0db8\u0db1\u0dca\u0d9a\u0dd3\u0dc0\u0dbb\u0dd4 \u0d92 \u0dd9\u0dd2\u0db1 \u0daf\u0db1\u0dca\u0d9a\u0db1\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d9c\u0db8\u0dcf\u0d9a\u0daf\u0d8b \u0d91\u0dad\u0dd4\u0db8\u0db1\u0dca\u0d9a\u0dbd\u0dcf \u0d92 \u0dd9\u0dd2\u0db1 \u0d9c\u0db1\u0dcf\u0daf\u0dd2\u0db1 \u0d89\u0db1\u0dca\u0d9a\u0db1 \u0d9c\u0dc4\u0dda\u0dad\u0dd4\u0dc0 [ \u0db1\u0dd2\u0dc4\u0dd2.\n\n329 330\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0d9c\u0dda\u0db1\u0dca\u0d9a\u0dad\u0dd4\u0dc0\n\n\u0d89\u0dc3\u0dda\u0dc3\u0dba\u0dc4 \u0d9c\u0d9a\u0dcf\u0db1\u0dca\u0d9a\u0daf \u0d9c\u0d9a\u0dc5\u0dd2\u0db1\u0dca\u0d9a \u0dad\u0dd2\u0dba\u0dcf\u0d9c\u0dd9\u0db1\u0dc0\u0dad\u0dca \u0d89\u0db1\u0dca\u0d9a\u0db1 \u0db6\u0dd2\u0dbb\u0dd2\u0d8b \u0d9c\u0dc3\u0d9c\u0dba\u0dda\u0db4\u0dd4 \u0d9c\u0daf\u0d9a \u0d85\u0d9c\u0dad\u0dca \u0d85\u0dba\u0d9c\u0dd9\u0db1 \u0d9c\u0dd9\u0daf\u0dba\u0db4 \u0d9c\u0dd2\u0dba\u0db4\u0dd4 \u0dd2\u0dba\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4 \u0d85\u0db4\u0db4 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d9c\u0daf\u0db1\u0dca\u0d9a\u0db1 \u0d91\u0db1\u0dc0\u0dcf\u0d8b \u0db6\u0dd1\u0dda \u0d85\u0dba\u0d9c\u0dd9\u0db1 \u0dba\u0dd1\u0db8 \u0da7\u0db4\u0dc5\u0dd2\u0db6\u0db3\u0dc0.\n\n\u0d8a\u0dd9\u0dd9 \u0d9a\u0dcf\u0dba\u0da7\u0dba \u0d9c\u0dda\u0d9a\u0dba\u0dd2. \u0dba\u0dcf\u0da2\u0db4 [\u0dc2\u0dca\u0da8\u0