    "chunk_text": "\u0ba4\u0b95\u0bcc\u0bb0\u0bb5 \u0ba4\u0bae\u0bb2\u0bae\u0bc8\u0ba4\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0bc6\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0ba4\u0bb3, \u0b87\u0ba9\u0bcd\u0bae\u0bb1\u0baf \u0ba4\u0bbf\u0ba9\u0bae\u0bcd \u0ba8\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0b9a\u0bcd \u0bc6\u0bae\u0bc6\u0baf\u0bbf\u0bb2\u0bcd \u0bc6\u0bc6\u0bbe\u0bb0\u0bc6\u0bbe\u0bb3\u0bc1\u0bc8\u0ba9\u0bcd\u0bb1 \u0b93\u0baf\u0bcd\u0bb5\u0bc2\u0ba4\u0bbf\u0baf\u0bae\u0bcd (\u0ba8\u0bc0\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bb2\u0bcd) \u0bc6\u0b9f\u0bcd\u0b9f\u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0ba4\u0ba4\u0bc6\u0bbe\u0b9f\u0bb0\u0bcd\u0bc6\u0bbf\u0bb2\u0bcd \u0bb5\u0bbf\u0bb5\u0bc6\u0bbe\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd \u0ba4\u0b95\u0bc6\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0ba4\u0bb1\u0bc6\u0bbe\u0bae\u0bcd. \u0b87\u0bb2\u0bb5\u0bc6\u0b95\u0bcd \u0b95\u0bb2\u0bcd\u0bb5\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0ba4\u0ba8\u0bcd\u0bae\u0ba4\u0baf\u0bc6\u0bbe\u0ba9 \u0bc6\u0bbf. \u0b9f\u0bc6\u0bbf\u0bb3\u0bcd\u0baf\u0bc2. \u0b9f\u0bc6\u0bbf\u0bb3\u0bcd\u0baf\u0bc2. \u0b95\u0ba9\u0bcd\u0ba9\u0b99\u0bcd\u0b95\u0bb0\u0bc6\u0bbe \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bc6\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0bc8\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0ba4\u0bc6\u0bb0\u0bc1\u0bae\u0bcd \u0ba4\u0bc6\u0bae\u0bb5\u0baf\u0bc6\u0bbe\u0bb1\u0bcd\u0bb1\u0bbf\u0baf\u0bb5\u0bb0\u0bcd. \u0b85\u0bb5\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0ba4\u0bc6\u0bc6\u0bbe\u0bb0\u0bc1\u0bb3\u0bc6\u0bbe\u0ba4\u0bc6\u0bbe\u0bb0 \u0bc6\u0bbf\u0b95\u0bcd\u0b95\u0bb2\u0bcd \u0bb5\u0ba8\u0bcd\u0ba4\u0ba4\u0bc6\u0bc6\u0bbe\u0ba4\u0bc1, \u0b85\u0baa\u0bcd\u0ba4\u0bc6\u0bc6\u0bbe\u0ba4\u0bc1 \u0bc6\u0bbf\u0bb0\u0ba4\u0bc8 \u0bc8\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0bbe\u0bbf\u0baf\u0bc6\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4 \u0bc6\u0bbf\u0bb1\u0bbf\u0bc8\u0bc6\u0bbe\u0ba4\u0bb5\u0bc6\u0bbe \u0bc6\u0ba3\u0bcd\u0b9f\u0bc6\u0bbe\u0bb0\u0ba8\u0bc6\u0bbe\u0baf\u0b95\u0bcd\u0b95\u0bc6\u0bbe\n\n\u0dc4\u0dd2 \u0db4\u0dd4 \u0da2\u0db1\u0dcf\u0d9a\u0dbb\u0db4\u0dc0\u0dbb\u0dc0\u0dd9\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0db8 \u0db1\u0dd2\u0dbd \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0d94\u0d9a\u0dca\u0db8\u0d9a\u0dcf\u0db8 \u0d85\u0db4\u0dd2 \u0dbb\u0da2\u0dba \u0db4\u0dc0\u0dbb\u0dcf \u0dd9\u0db1\u0dca\u0db1\u0dc0\u0dcf, \u0da7\u0db8\u0dd9\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0db8 pensions \u0db1\u0dad\u0dbb \u0d9a\u0dbb\u0db1\u0dc0\u0dcf, \u0db4\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0db8\u0dda\u0db1\u0dca\u0dc0\u0dd9 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dd9\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0db8 pensions \u0db1\u0dad\u0dbb \u0d9a\u0dbb\u0db1\u0dc0\u0dcf, \u0da7 \u0d85\u0dba \u0dc0\u0dcf\u0dc4\u0db1 \u0dbd\u0db6\u0dcf \u0db8\u0daf\u0db1 \u0d91\u0d9a \u0db1\u0dad\u0dbb \u0d9a\u0dbb\u0db1\u0dc0\u0dcf, permits \u0db8\u0daf\u0db1\u0dca\u0db8\u0db1\u0dca \u0db1\u0dad\u0dc4\u0dad \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0da2\u0db1\u0dcf\u0d9a\u0dbb\u0db4\u0dc0\u0dbb\u0dc0\u0dd9\u0db8\u0dcf \u0db8\u0db4\u0dcf\u0db8\u0dbb\u0dcf\u0db1\u0dca\u0daf\u0dd4 \u0dc0\u0dd4\u0dda\u0dcf. \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d85\u0db4 \u0da1\u0db1\u0dca\u0daf\u0dba \u0daf\u0dd4\u0db1\u0dca \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0dda \u0d9a\u0dcf\u0dbb\u0dda\u0dcf \u0db4\u0dc4\u0db8 \u0d85\u0db4\u0dd2 \u0d89\u0da7\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf\u0dba \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d91\u0dc0\u0dd9\u0db8\u0dcf \u0d9a\u0dd2\u0d8b\u0dc0\u0dcf. \u0d85\u0db4 \u0da7 \u0dd9\u0dad\u0db1 \u0db8\u0db6\u0dcf\u0db8\u0dc4\u0dcf\u0db8 \u0dc3\u0db1\u0dca\u0db8\u0dad\u0db1\u0dc2\u0dba\u0dd2. \u0da7, \u0db8\u0db8\u0dcf\u0d9a\u0daf \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf\u0daf? \u0d9a\u0dba\u0dcf\u0db1\u0dca \u0db8\u0dda \u0db8\u0dba\u0db1\u0da2\u0db1\u0dcf\u0dc0 \u0db4\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0db8\u0dda\u0db1\u0dca\u0dc0\u0dd9\u0dc0 \u0d89\u0daf\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0dc0\u0dd4\u0dda\u0dcf\u0db8 \u0d85\u0db4\u0dd2 \u0da7\u0d9a \u0d91\u0d9a \u0dc0\u0dd4\u0dda\u0dcf. \u0d85\u0db4\u0dd2 \u0da7\u0d9a \u0dc3\u0dd2\u0dbb\u0dd4\u0dd3\u0db0 \u0dc0\u0dd4\u0db8\u0dca \u0db1\u0dad\u0dc4\u0dad. \u0dc4\u0dad\u0db6\u0dad\u0dba\u0dd2, \u0daf\u0dad\u0db1\u0dca system \u0d91\u0d9a \u0db8\u0dc0\u0db1\u0dc3\u0dda \u0d9a\u0dbb\u0dbd\u0dcf \u0dc0\u0dbb\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0d94\u0dba\u0db8\u0dd9\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca \u0db8\u0db4\u0dcf\u0da9\u0dca\u0da9\u0dbd\u0d9a\u0dca \u0db8\u0dda \u0dd9\u0dad\u0db1 \u0d9a\u0dbd\u0dca\u0db4\u0db1\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0db8\u0dda \u0dbb\u0db8\u0da7\u0dca \u0dc0\u0dbb\u0db8\u0db6\u0db1 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0d85\u0db8\u0dd0\u0dc0 \u0dc3\u0dbd\u0dca\u0dba\u0dcf \u0dc0\u0dbb\u0db8\u0db6\u0db1 \u0d9a\u0da7\u0dca\u0da7\u0dd2\u0dba \u0d86\u0db4\u0dc3\u0dd4 Parliament \u0d91\u0d9a \u0d91\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0d9a\u0db8\u0d9a\u0dca \u0db8\u0dda \u0db8\u0dba\u0db1\u0da2\u0db1\u0dcf\u0dc0 \u0dc4\u0dbb\u0dc4\u0dcf \u0d91\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dcf\u0dbb\u0dda\u0dba \u0dd9\u0dad\u0db1 \u0db8\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dda. \u0da7 \u0d9a\u0dcf\u0dbb\u0dda\u0dba \u0db8\u0db8\u0dcf\u0d9a\u0d9a\u0dca\u0daf? \u0dc3\u0dbd\u0dca\u0dba\u0dcf \u0dc0\u0dbb\u0db8\u0db6\u0db1 \u0db8\u0dbd\u0dcf\u0d9a\u0dd4 \u0db4\u0d9a\u0dca\u0dc2, \u0dc3\u0db8\u0dc4\u0dbb \u0dc3\u0dd2 \u0db8\u0dd3\u0dc1\u0db4\u0dcf\u0dbd\u0db1\u0dba \u0db4\u0dad\u0dad\u0dca\u0db8\u0dad\u0db1\u0dca\n\n[\u0db8\u0dd6\u0dbd\u0dcf\u0dc3\u0db1\u0db4\u0dda \u0d85\u0dab \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dad\u0dc0 \u0d9a \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3. [\u0b85\u0b95\u0bcd\u0b95\u0bbf\u0bb0\u0bc6\u0bbe\u0bc6\u0ba9\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bb3\u0baa\u0bcd\u0bc6\u0b9f\u0bbf \u0b85\u0b95\u0bb1\u0bcd\u0bb1\u0baa\u0bcd\u0bc6\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.] [Expunged on the order of the Chair.]\n\n\u0dad\u0dc0 \u0db8\u0d9a\u0db1\u0da9\u0dd3\u0dc3\u0dda\u0dc0\u0dbb\u0db1\u0dca\u0dbd\u0dcf \u0d91\u0d9a\u0dca\u0d9a \u0d91\u0d9a\u0dc0\u0dd9 \u0db8\u0dc0\u0dbd\u0dcf Parliament \u0d91\u0d9a \u0d91\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0d9a\u0db8\u0d9a\u0dca \u0dc0\u0dbb\u0db8\u0db6\u0db1\u0dc0\u0dcf\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0db8\u0db8 \u0d94\u0dba\u0db8\u0dd9\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf. \u0db8\u0db8\u0dcf\u0d9a\u0daf, \u0da7\u0d9a \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dda \u0db1\u0dad\u0dc4\u0dad. NPP \u0d91\u0d9a \u0dd9\u0dad\u0db1 \u0db6\u0dbd\u0db1\u0db8\u0d9a\u0dcf \u0dd9\u0dbb\u0dd4 \u0db6\u0dd2\u0db8\u0dbd\u0dca \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dad\u0dc0\u0dbb\u0dc0\u0dd9\u0db8\u0dcf \u0dc3\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dad\u0dad\u0dca\u0db8\u0dad\u0dca \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf. \u0dd9\u0dbb\u0dd4 \u0d85\u0db8\u0dd0\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0daf\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0da2\u0db1\u0dcf\u0d9a\u0dbb\u0db4\u0dc0\u0dbb\u0dc0\u0dd9\u0db8\u0dcf\u0dad\u0dca \u0dc3\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0db8 \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf. \u0da7 \u0d85\u0dba \u0dc3\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0db8 \u0dc0\u0dcf\u0da9\u0dd2 \u0db8\u0dc0\u0dbd\u0dcf \u0db8\u0dda \u0dbb\u0db8\u0da7\u0dca \u0db8\u0dd3\u0dc1\u0db4\u0dcf\u0dbd\u0db1\u0dba \u0d9a\u0dc5\u0dcf. \u0d94\u0dba\u0db8\u0dd9\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0d85\u0db4\u0dd2 \u0d91\u0d9a \u0db8\u0dc0\u0db1\u0dc0\u0dcf. \u0dc0\u0dad\u0dbb\u0daf \u0db1\u0dca\u0daf\u0dd4 \u0dc0\u0dd4\u0dda\u0dcf. \u0da7 \u0dc0\u0dad\u0dbb\u0daf \u0db1\u0dca\u0daf\u0dd4 \u0dc0\u0dd4\u0dab\u0dd4 \u0db8\u0dc0\u0dbd\u0dcf\u0db8\u0d8b\u0daf\u0dd3 \u0d94\u0dba\u0db8\u0dd9\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca \u0dc3\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dad\u0dad\u0dca\u0db8\u0dad\u0dca \u0d89\u0dcf\u0dbd\u0dcf \u0db8\u0dc4\u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0db8\u0dc0\u0db8\u0dd0\u0db8\u0dc0\u0db1\u0dca \u0d9a\u0d9c\u0dcf \u0d9a\u0dbb\u0db4\u0dd4 \u0db1\u0dd2\u0dc3\u0dcf \u0dad\u0db8\u0dba\u0dd2 159\u0d9a\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0db8\u0dda\u0db1\u0dca\u0dc0\u0dd9\u0dc0 \u0d87\u0dc3\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0d86\u0dca\u0da9\u0dd4 \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db4\u0dad\u0dad\u0dca\u0dad \u0dd2\u0dab\u0db8 ."
