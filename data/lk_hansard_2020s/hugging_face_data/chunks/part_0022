    "chunk_text": "\u0d85\u0db8\u0dcf\u0dad\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0d9c\u0dda \u0dad\u0dd3\u0dba\u0da7\u0dc0\u0dbd\u0db4 \u0d85\u0db1\u0dd4\u0dbd \u0dbd\u0dc0 \u0d9c\u0db8\u0db8 \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0db1\u0dca\u0daf\u0dd4 \u0d9a\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0dba\u0dd2. \u0d8a\u0db4 \u0d85\u0db8\u0dad\u0dba\u0dc0\u0d8b \u0dc3\u0db8\u0dcf\u0d9c\u0dba\u0ddd\u0da2\u0dd2\u0dad \u0dc4\u0dcf \u0db8\u0dd2\u0db1\u0dc0\u0dd2\u0db1\u0dca\u0d9a \u0daf\u0dd2\u0db1\u0dd4\u0dc0\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc3\u0dda\u0dae\u0dcf\u0dc0\u0dba\u0dba [ \u0dc3\u0dc4\u0dad\u0dd2\u0d9a \u0d9a\u0dba\u0db1\u0dd4 \u0dc0\u0dc3\u0dda \u0d91 [ \u0d91 [ \u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf \u0dc0\u0db4\u0dba\u0db4 \u0d9c\u0db4\u0dba \u0dc0\u0dd2\u0d9c\u0dd3\u0dba \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4\u0d8b \u0dc0\u0dd2\u0d9c\u0dd3\u0dba \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dc4 \u0dc3\u0d82\u0da0\u0dcf\u0dba\u0d9a \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dba\u0dba\u0d8b \u0d9a\u0dd8\u0dd2\u0d9a\u0dbb\u0dca\u0db8\u0d8b \u0db4\u0dc1\u0dd4 \u0dc3\u0dda\u0db4\u0dad\u0dca\u0d8b \u0d89\u0da9\u0dda \u0dc4\u0dcf \u0dc0\u0dcf\u0dbb\u0dd2\u0db8\u0dcf\u0dbb\u0dca\u0dd9 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dba\u0dba\u0d8b \u0d9c\u0dc3\u0dca\u0d9b\u0dba \u0dc4\u0dcf \u0da2\u0db1\u0db8\u0dcf\u0dca\u200d\u0dba \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dba\u0dba\u0d8b \u0d9a\u0dda\u0d9a\u0dbb\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dba\u0dba \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d85\u0daf\u0dcf\u0dd9 \u0d9c\u0dbb\u0dca \u0dba \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dba\u0d8b \u0d9c\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0d9c\u0dda\u0db1\u0dca\u0d9a\u0dad\u0dd4 \u0d9c\u0db8\u0db1\u0dca\u0d9a\u0db8 \u0db1\u0dd2\u0dba\u0dcf\u0db8\u0db1 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0da2\u0dd2\u0dad\u0dcf\u0dba\u0dad\u0db1 \u0dc3\u0db8\u0dd9 \u0dc3\u0db4\u0d9c\u0dd3\u0dba\u0db1 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0db6\u