\u0dd9\u0dba\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0d85\u0db4\u0dd2 \u0db4\u0dd4\u0dc5\u0d9c\u0dd2[ \u0da7\u0d9a\u0db8\u0dbb\u0dca\u0dbd \u0db8\u0db6\u0dcf\u0db8\u0dcf\u0ddd \u0dad\u0dd4\u0db1\u0dca\u0dad\u0da7\u0dbd \u0d85\u0db8 ( \u0d9a\u0dd2\u0d82\u0da7\u0dbb\u0dca\u0dbd\u0dca\u200d\u0dca \u0da7\u0dd4\u0da9\u0da7\u0dbd \u0db8\u0db7\u0dde\u0dd2\u0dd9 \u0dca\u200d\u0dbb\u0da7\u0dd2[ \u0dc3\u0dd2[[\u0db4 2]]\u0d9a\u0dca \u0d85 \u0d9a\u0db4 \u0d9a \u0dd9\u0dba\u0db8\u0da7\u0dca \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0db8\u0db6\u0dcf\u0db8\u0dcf\u0ddd \u0daf\u0d9a\u0dda\u0dd2\u0d9a\u0dca\u0dd9\u0da7\u0dbd \u0dc3\u0dd2[[\u0db4 ]]\u0dd9\u0db4 \u0d91\u0dcf\u0dcf \u0db8\u0dd6\u0dbb\u0dbd\u0dba \u0dca\u200d\u0dbb\u0da7\u0dd2[\u0d9a\u0dca \u0d85 \u0d9a\u0db4 \u0d9a \u0dd9\u0dba\u0db8\u0da7\u0dca \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0d92 \u0dc0\u0dd2\u0d9a\u0dbb[\u0db4 \u0dba\u0db8\u0da7\u0dca \u0d9a\u0dd2\u0d82\u0da7\u0dbb\u0dca\u0dbd\u0dca\u200d\u0dca[ \u0da7\u0db8 \u0dc0\u0db4 [\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf.\n\n\u0d85 \u0db8\u0dda \u0dba\u0db8\u0da7\u0dca \u0da2\u0dcf\u0dd2\u0da7\u0dcf [ \u0d85\u0dc0\u0dd4\u0d9a\u0dda\u0d9a\u0db1\u0dca\u0dad\u0dca \u0dc3\u0dd4\u0db8\u0dbb\u0dca\u0dbd \u0d9a\u0dcf \u0dca\u0dd4\u0db8\u0d9f\u0dca\u0dd2\u0dba \u0dad\u0dad\u0dcf \u0dd4\u0dc5\u0dd4 \u0db4\u0dd2\u0dd2\u0db8\u0d9a\u0d9a\u0dd4 \u0d9a, \u0d9a\u0dd4\u0db8\u0dab\u0dca\u0da9 \u0dad\u0da7 \u0d9a\u0db8 \u0dc0\u0dcf\u0db8\u0dba\u0d9a\u0dd4 \u0d9a \u0dc3 \u0d9a\u0d9a\u0dcf\u0dcf \u0dd9\u0dba\u0dca\u0da7\u0dcf. \u0dcf\u0dd4\u0db6\u0dd4\u0dba\u0dd2 \u0d85 \u0dba\u0db8\u0da7\u0dca \u0da2\u0dcf\u0dd2\u0da7\u0dcf [\u0db4 \u0dd2\u0d9a \u0d94\u0d9a\u0da7\u0db1\u0dca\u0dad\u0dca \u0db8\u0dda \u0d86\u0dab\u0dca\u0da9\u0dd4\u0da7 \u0dad\u0da9\u0d9a\u0dca \u0daf\u0dd3\u0dbd\u0dcf \u0dca\u0dd4\u0dcf\u0dd4. \u0d85\u0db4\u0dd2 \u0d85\u0db8 ( \u0dba\u0db8\u0da7\u0dca \u0da2\u0dca\u0dad\u0dcf\u0da7\u0db4 \u0d9a\u0dcf\u0dd2\u0dd9 \u