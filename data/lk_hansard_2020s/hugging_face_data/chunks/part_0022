    "chunk_text": "\uf0b7 2025\u0d9c\u0dc0\u0dca\u0dc2\u0dda\u0dda\u0daf\u0dd3\u0d9c\u0d9a\u0dca\u0dc4\u0daf\u0dca\u0dcf\u0dba\u0dbd\u0daf\u0dda\u0dc0\u0dc4\u0dd2\u0d9c\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dad\u0dca\u0dc4\u0d9a\u0d9c\u0dc0\u0dd6\u0d9c\u0d9a \u0dca\u0d9c\u0dda\u0dc4\u0ddd \u0dca\u0d9c\u0d91\u0d9a\u0dca\u0d9c\u0dbb\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0d9c\u0dd3\u0dc4\u0d9c\u0dc3\u0dcf \u0d9c\u0dbb\u0dd2\u0dca\u0dcf\u0d9c\u0d8b\u0dbd\u0dd2\u0dca\u0d9c02\u0dca\u0d9c\u0dbb\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0d9c\u0dd3\u0dc4\u0d9c\u0db1\u0dd2\u0dc3\u0dcf\u0daf\u0d9c\u0dbb\u0dda\u0dda\u0dca\u0dd2\u0dcf\u0d9c\u0d8b\u0dca\u0d9c\u0d87\u0db9\u0dbb\u0dd3\u0dc4\u0d9c\u0dbb\u0dd4\u0d9c\u0dd3\u0dc4\u0d9c\u0dda \u0dad\u0dd4\u0dda\u0dc0\u0dca\u0d9c\u0dc3\u0dcf \u0d9c\u0dda\u0dbb\u0daf\u0dd2\u0dc3\u0d9c\u0d8b \u0dda\u0d9d\u0ddd\u0dc2\u0dab\u0d9c\u0dda \u0dad\u0dd4\u0dda\u0dc0\u0dca\u0d9c\u0dc4\u0dc3\u0dcf\u0d9a \u0d9c\u0dbb\u0dc3\u0dcf\u0dca \u0d9c\u0d9a\u0daf\u0dbd\u0dba\u0dca\u0d9c\u0dc3\u0dd3\u0db1\u0dd2\u0d9c\u0db1\u0dd2\u0dc2 \u0db4\u0daf: \u0d9c\u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0d9c\u0dd2\u0d82\u0dbd\u0dd2\u0d9c\u0d9a\u0dd2\u0dbb\u0dd3\u0dc4 \u0d9c\u0dda \u0daf \u0d9a\u0dd2\u0d9c\u0dd2\u0dc3\u0dba.\n\n\uf0b7 \u0d91\u0dcf\u0dda \u0ddd\u0dca \u0d9c\u0dbb\u0dda\u0dc5\u0dd2\u0dc3\u0dba\u0d9c\u0dbb\u0dd4\u0d9c\u0dd3\u0dc4\u0d9c\u0dda \u0dad\u0dd4\u0dda\u0dc0\u0dca\u0d9c2023,\u0d9c2024\u0d9c\u0dc3\u0dcf \u0d9c2025\u0d9c\u0dc0\u0dca\u0dc2\u0dc0\u0dbd\u0d9c\u0d91\u0dcf\u0dda \u0ddd\u0dca \u0d9c\u0db1\u0dd2\u0dc2 \u0db4\u0daf: \u0dda\u0dda\u0d9c\u0dba\u0dca\u0d9c\u0dbb\u0dd4\u0dc0\u0dca\u0d9c:\u0dca \u0d9c\u0dbd \u0dda\u0dda.\n\n\u0db4\u0dd0\u0dbd\u0dca\u0dc0 \u0d9a\u0dad\u0dca\n\n\uf0b7 2025\u0d9c\u0dc0\u0dca\u0dc2\u0dda\u0dda\u0daf\u0dd3\u0d9c\u0db4 \u0dca \u0dc0\u0dad\u0dca\u0dcf\u0d9c\u0d92\u0d9a\u0d9a\u0dda\u0dda\u0d9c\u0db1\u0dd2\u0dc2 \u0db4\u0daf: \u0d9c\u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0d9c\u0dc3\u0dcf \u0dbd\u0dd4\u0da2\u0dca\u0d9c\u0d9a\u0dbb\u0d9c\u0d87\u0dad\u0dd2\u0d9c\u0db4\u0dbb\u0dd2\u0daf\u0dd2\u0d9c\u0dd2\u0d82\u0dbd\u0dd2\u0d9c\u0d9a\u0dbb\u0db1\u0dd4\u0d9c\u0dbd \u0db6\u0dd3\u0dba.\n\n(v) \u0dc0 \u0dc0\u0db1\u0d9c\u0dbd\n\n\uf0b7 \u0dda\u0db4\u0dbb\u0d9c\u0dc0\u0dca\u0dc2\u0dba\u0dca \u0d9c\u0dc3\u0dcf\u0daf\u0dda\u0dda\u0dca\u0dc2\u0dc0\u0d9c2025\u0d9c\u0dc0\u0dca\u0dc2\u0dda\u0dda\u0d9c\u0dda\u0dc3\u0dcf\u0dc0 \u0dbb\u0dbd\u0d9c\u0d9a\u0dca\u0dc4\u0daf\u0dca\u0dcf\u0dba\u0daf\u0dbd\u0daf\u0dda\u0dda\u0d9c\u0dd2\u0d82\u0dbd\u0dd2\u0d9c\u0dc0\u0dd6\u0d9c \u0daf\u0dd2\u0dd2\u0d82\u0d9c\u0db6\u0dd2 \u0dc0 \u0da7\u0dd3\u0dca\u0d9c\u0dda \u0dad\u0dd4\u0dda\u0dc0\u0dca\u0d9c\u0dc0:\u0db1\u0dd2\u0d9a\u0dc0\u0d9c\u0dbd\u0db6\u0db1\u0daf\u0d9c\u0daf\u0dd3\u0dc4 \u0d9c\u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dcf\u0d9c\u0d8b\u0dca\u0d9c\u0dc3\u0dcf\u0dbd\u0daf\u0d9a\u0dba\u0d9c\u0db1\u0dd2\u0dd2\u0d82\u0d9c\u0dda\u0dda\u0dbd\u0daf\u0dc0 \u0d9c\u0d9a\u0dca \u0dbd\u0d9c\u0dda\u0dc0\u0dcf\u0d9c\u0dbd\u0db6\u0db1\u0daf\u0d9c\u0dbb \u0db1\u0dd3\u0dc4 \u0d9c\u0dda \u0daf \u0d9a\u0dd2\u0d9c\u0dd2\u0dc3\u0dba.\u0d9c\u0d91\u0dda\u0dc4\u0dca\u0dc4,\u0d9c\u0d8b\u0dca\u0d9c\u0dc0\u0dbb\u0daf\u0dc0\u0dca\u0d9c\u0d9a\u0da9\u0daf\u0d9a\u0dda\u0db4\u0dca \u0d9a\u0daf\u0dbb\u0dd3\u0d9c\u0dda\u0dbd\u0dc3\u0dcf\u0d9c\u0d9c\u0dd2\u0db1\u0dd2\u0d9c\u0dcf \u0db6\u0dd3\u0dc4\u0d9c\u0dda \u0dad\u0dd4\u0dda\u0dc0\u0dca\u0d9c\u0daf\u0dd2\u0d9c\u0dd2\u0dca\u0d9c\u0daf\u0dd2\u0dbb \u0dc4\u0d9c\u0dd2\u0d82\u0dbd\u0dd2\u0d9c\u0dc0\u0dd6\u0d9c\u0dda\u0dbb\u0daf\u0dd2\u0dc3\u0d9c\u0d8b \u0dda\u0d9d\u0ddd\u0dc2\u0dab\u0d9c\u0dda \u0dad\u0dd4\u0dda\u0dc0\u0dca\u0d9c:\u0d9c\u0dc4\u0dc3\u0dcf\u0d9a \u0d9c\u0dbb\u0dc3\u0dcf\u0dca \u0d9c\u0d9a\u0daf\u0dbd\u0dba\u0dca\u0d9c\u0d9a\u0dca\u0dc4\u0daf\u0dca\u0dcf\u0dba\u0daf\u0dbd\u0daf\u0dda\u0dda\u0d9c\u0db1\u0dd2\u0dc2 \u0db4\u0daf: \u0d9c\u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0d9c\u0dd2\u0d82\u0dbd\u0dd2\u0d9c\u0d9a\u0dd2\u0dbb\u0dd3\u0dc4 \u0d9c\u0dda \u0daf \u0d9a\u0dd2\u0d9c\u0dd2\u0dc3\u0dba.\n\n\uf0b7 \u0d91\u0dda\u0dc4\u0dca\u0dc4,\u0d9c2024\u0daf\u0dd3\u0d9cVAT \u0d91\u0d9a\u0d9c\u0db4 \u0dd3\u0dda\u0dc4\u0dca\u0d9c\u0db4\u0dd4\u0da2\u0d9c\n\n\u0dc3\u0dd3\u0db1\u0dd2\u0d9c \u0daf\u0d9c\u0d91\u0dcf\u0dda \u0ddd\u0dca \u0d9c\u0db1\u0dd2\u0dd2\u0d82\u0d9c\u0db4\u0dbb\u0dd2\u0daf\u0dd2\u0d9c\u0db4\u0dca\u200d\u0dbb\u0dc4\u0daf\u0dab\u0daf\u0dad\u0dca\u0dc4\u0d9a\u0dc0\u0d9c\u0dbb\u0dda\u0dc5\u0dd2\u0dc3\u0d9c\u0d9a\u0dbb\u0d9c\u0dbb \u0db1\u0dd3\u0dc4 \u0d9c\u0dda \u0daf \u0d9a\u0dd2\u0dd3\u0dc4\u0d9c\u0dc4\u0dcf\u0d9c\u0dbb\u0dba\u0dcf \u0dda\u0dda\u0d9c\u0db4 \u0dc0\u0dad\u0dd2\u0d9c\u0dbb\u0dba \u0db4\u0dad\u0dca\u0d9c\u0dbd\u0dca\u0dbd\u0dba\u0dc4\u0dba\u0d9c\u0dcf\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9c\u0dda \u0dad\u0dd4\u0dda\u0dc0\u0dca\u0d9c\u0d9a\u0dca\u0dc4\u0daf\u0dca\u0dcf\u0dba\u0daf\u0dbd\u0daf\u0dda\u0dda\u0d9c \u0daf\u0dd2\u0dd2\u0d82\u0d9c\u0db6\u0dd2 \u0dc0 \u0da7\u0dd3\u0dca\u0d9c \u0daf\u0d9c \u0da9\u0dad\u0dca\u0dad\u0dd4\u0d9c\u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0d9c\u0dc3\u0dcf \u0daf\u0d9c\u0dbb\u0dc0\u0dba\u0dba\u0d9c\u0dba\u0dca\u0dda\u0dad\u0dca\u200d\u0dbb\u0ddd\u0db4\u0d9a\u0dbb\u0dab\u0d9c \u0daf\u0d9c\u0dbb\u0dc4\u0dcf\u0dbb\u0d9c\u0dda\u0d9a\u0daf \u0dc3\u0dcf \u0d9c\u0dda\u0dcf\u0daf\u0dbb\u0d9c\u0dbb\u0db6\u0db1\u0da9\u0daf\u0dc0\u0dca\u0dc4\u0dd2\u0d9c\u0db4\u0dc0\u0dad\u0dca\u0dc0\u0daf\u0d9c\u0dda\u0dbb \u0d9c\u0dba\u0daf\u0dc4 \u0d9c\u0dda \u0daf \u0d9a\u0dd2\u0d9c\u0dd3\u0dc4\u0d9c \u0daf\u0d9c\u0dba\u0dca\u0dda\u0dad\u0dca\u200d\u0dbb\u0ddd\u0db4\u0d9a\u0dbb\u0dab\u0d9c \u0daf\u0d9c\u0dbb\u0dc4\u0dcf\u0dbb\u0d9c\u0dda\u0d9a\u0daf \u0dc3\u0dcf \u0d9c\u0db1\u0dd2\u0dd2\u0d82\u0d9c\u0d9a\u0daf\u0dbd\u0db4\u0dbb\u0dd2\u0da0\u0dca\u0dda\u0dda:\u0dda\u0dda\u0daf\u0dd3\u0d9c\u0db8\u0dd2\u0dbd\u0daf\u0dd3\u0d9c\u0dbb \u0db1\u0dd3\u0dc4 \u0d9c\u0dbb:\u0daf\u0dc5\u0d9c\u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0dca\u0db4\u0daf: \u0d9c\u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0d9c\u0dd2\u0d82\u0dbd\u0dd2\u0d9c\u0d9a\u0dd2\u0dbb\u0dd3\u0dc4 \u0d9c\u0dda \u0daf \u0d9a\u0dd2\u0d9c\u0dd3\u0dc4\u0d9c\u0dc4\u0dcf\u0d9c\u0d87\u0db9\u0dd4 \u0dca\u0d9c\u0db0\u0daf\u0dbb\u0dd2\u0dcf\u0daf\u0dc0\u0d9c\u0dbb\u0dda\u0dda\u0dca\u0dd2\u0dcf\u0d9c\u0dc4\u0da7\u0dca \u0dc4 \u0d9c\u0dc0\u0da9\u0daf\u0d9c\u0dbb\u0dd4\u0d9c\u0dd2\u0dc3\u0dba.\u0d9c\u0d92\u0d9c\u0dda \u0dad\u0dd4\u0dc0\u0d9c\u0dc4\u0dcf\u0d9c2025\u0d9c\u0dc3\u0dcf \u0daf\u0d9c\u0dbb\u0dda\u0dda\u0dca\u0dd2\u0dcf\u0d9c\u0d8b\u0dca\u0d9c\u0db4\u0dca\u200d\u0dbb\u0dc4\u0daf\u0dab\u0dba\u0d9c\u0dbb\u0db9\u0dbb\u0daf\u0d9c\u0dbb \u0db1\u0dd3\u0dc4 \u0d9c\u0dda \u0daf \u0d9a\u0dd2\u0d9c\u0dd2\u0dc3\u0dba.\n\n\u0dc0\u0dcf\u0dc2\u0dba \u0db4\u0dd0\u0dbd\u0dca\u0dc0 \u0d9a\u0dad\u0dca \u0dc0 \u0dc0\u0db1\u0d9c\u0dbd\n\n\u0dc3\u0dd3\u0db1\u0dd2 \u0db1\u0dd2\u0dc2\u0db1\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d82\u0dc0\u0db8\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\n\n\u0dc0 \u0dcf\u0db1\u0dca\u0db4\n\n\u0dc3\u0dd3\u0db1\u0dd2 \u0d85\u0dc0 \u0dc0\u0dd2\u0dba \u0d82\u0dc0\u0db8\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\n\n\u0dc0 \u0dcf\u0db1\u0dca\u0db4\n\n\u0dc3\u0dd3\u0db1\u0dd2 \u0db1\u0dd2\u0dc2\u0db1\u0db4\u0dcf\u0daf\u0db1\u0dba\n\n\u0d82\u0dc0\u0db8\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\n\n\u0dc0 \u0dcf\u0db1\u0dca\u0db4\n\n\u0dc3\u0dd3\u0db1\u0dd2 \u0d85\u0dc0 \u0dc0\u0dd2\u0dba \u0d82\u0dc0\u0db8\u0da7\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\n\n\u0dc0 \u0dcf\u0db1\u0dca\u0db4 2020 23,582.15 17,614 16,115 13,851\n\n2021 30,381.20 33,304 17,796 15,647\n\n2022 24,110.25 23,217 12,628 14,632\n\n2023 28,076.65 20,303 13,784 12,089\n\n2024 27,790.85 15,415 11,930 9,901 2025 27,361.05 23,003 8,091 8,742\n\n\uf0b7 \u0dcf\u0dc0:,\u0d9c\u0d87\u0db9\u0dd4 \u0dca\u0d9c\u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0d9c\u0dc3\u0dcf \u0daf\u0d9c\u0dda\u0dba\u0daf:\u0daf\u0d9c\u0dbb\u0dca \u0daf\u0d9c\n\n\u0d9a \u0dca\u0d9c\u0dda\u0dc4\u0ddd \u0dca\u0d9c\u0dda:\u0dda\u0d9a\u0dca\u0d9c\u0d91\u0dca\u0d9c\u0dda\u0dc4\u0ddd \u0dbb\u0dba\u0dca\u0d9c\u0dbb\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0d9c\u0dd3\u0dc4\u0d9c\u0db1\u0dd2\u0dc3\u0dcf\u0daf\u0d9c\u0d91\u0dba\u0d9c\u0dbb\u0daf\u0dd9\u0dad\u0dca\u0dc0 \u0da9\u0dd2\u0dba\u0daf\u0d9c\u0d9a\u0dd2\u0dbb\u0dd3\u0dc4 \u0d9c\u0da2\u0daf\u0dcf\u0dba\u0dca\u0dcf\u0dbb\u0d9c\u0db8\u0dd2\u0dbd\u0d9c\u0dbb\u0dab\u0dca\u0d9c\u0d9a \u0dd3\u0dc4 \u0d9c\u0dd2\u0d82\u0dbd\u0dd2\u0d9c\u0dc0\u0dd6\u0d9c\u0db6\u0db1 \u0dd2\u0dc3\u0dca\u0d9c\u0d91\u0dc4\u0dd2\u0d9c\u0dbb\u0daf\u0dd9\u0dad\u0dca\u0dc0 \u0da9\u0dd2\u0dba\u0daf\u0d9c\u0d9a \u0dba\u0dd4\u0dad\u0dd4\u0d9c\u0db4\u0dca\u200d\u0dbb\u0dc4\u0daf:\u0dd3\u0dc4\u0d9c\u0dda \u0dad\u0dd4\u0dda\u0dc0\u0dca\u0d9c\u0d91\u0dca\u0d9c\u0dda\u0dc4\u0ddd \u0dbb\u0dba\u0dca\u0d9c\u0db4\u0dc4\u0dab\u0dca\u0d9c\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dad\u0dca\u0dc4\u0d9a\u0d9c\u0d9a\u0dd2\u0dbb\u0dd3\u0dc4\u0d9c\u0dda \u0dad\u0dd4\u0dda\u0dc0\u0dca\u0d9c\u0d87\u0dad\u0dd2\u0d9c\u0dc0\u0dd6\u0d9c\u0dbb\u0dc0:\u0daf \u0dca\u0d9c\u0dcf\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9c\u0db1\u0dd2\u0dc3\u0dcf\u0daf\u0d9c\u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dcf\u0d9c\u0d87\u0db9\u0dd4 \u0dca\u0d9c\u0db0\u0daf\u0dbb\u0dd2\u0dcf\u0daf\u0dc0\u0d9c\u0db4\u0dc0\u0dad\u0dca\u0dc0\u0daf\u0dda\u0dbb \u0d9c\u0dba\u0daf\u0dc4 \u0d9c \u0d9a\u0dd2\u0dba\u0daf\u0dc0\u0dca\u0d9c\u0dda \u0daf\u0dad\u0dd2\u0db6\u0dd3\u0dc4. \uf0b7 \u0dc3\u0dd3\u0db1\u0dd2\u0d9c\u0db1\u0dd2\u0dc2 \u0db4\u0daf: \u0dba\u0d9c\u0d9a\u0dd2\u0dbb\u0dd3\u0dda\u0dca\u0daf\u0dd3\u0d9c\u0dc0:\u0db1\u0dd2\u0d9a\u0dc0\u0d9cvacuum"
