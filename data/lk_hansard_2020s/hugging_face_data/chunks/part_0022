0dc0\u0db1\u0dd4\u0d9c\u0dc0\u0db1\u0dca\u0d9a \u0dc0\u0dd2\u0dba \u0d9a\u0dba \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf.\n\n\u0dd9\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2\u0d8b \u0d9c\u0dad\u0dcf\u0db4\u0dbd\u0dd9 \u0d9c\u0dda \u0dc3\u0dda\u0dae\u0dcf\u0db1\u0d9c\u0dda\u0db8\u0d8b AIIB \u0db6\u0dd2\u0d82\u0d9a\u0dd4\u0d9c\u0d8b \u0da7\u0dba\u0d9a\u0dd2\u0db1\u0dca\u0d9a \u0dad\u0dc0\u0dad\u0dca \u0d85\u0dd4\u0dc0\u0dad\u0dca \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba [ \u0dc4\u0daf\u0db1\u0dc0\u0dcf. \"\u0daf\u0dd2\u0da7\u0dca\u0dc0\u0dcf\" \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0da7\u0dcf\u0da7\u0dd4\u0dc0 \u0d91\u0db1\u0dca\u0d9a\u0db1 \u0d9a\u0dbd\u0dd2\u0db1\u0dca\u0d9a\u0d8b \u0db8\u0db8 \u0d9c\u0dda \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dcf\u0d82\u0dba\u0d9c\u0dda \u0dc0\u0dd9\u0d9a\u0dd3\u0dda \u0dc0\u0dcf\u0dba \u0dd9\u0dad\u0dca\u0dad\u0dcf\u0db4 \u0db4\u0dc3\u0dd4\u0dc0 \u0d92 \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0dc3\u0d82\u0d9a\u0dd3\u0dbb\u0dca\u0da7\u0dba \u0db6\u0dbd\u0db1\u0dca\u0d9a\u0db1 \u0d9c\u0dd2\u0dba\u0dcf. \u0d91\u0dad\u0dd2\u0db1\u0daf\u0dd3 \u0d87\u0dad\u0dca\u0dad\u0db4\u0db8 AIIB \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0dc3\u0d82\u0d9a\u0dd3\u0dbb\u0dca\u0da7\u0dba \u0d89\u0daf\u0dd2\u0d9a\u0dba\u0db1 \u0db1\u0dd2\u0dc3\u0dcf \u0dd2\u0dba\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4 \u0d9a\u0dd2\u0d8b\u0dc0\u0dcf\u0d8b \u0dad\u0db8\u0db1\u0dca\u0d9a\u0d9c\u0dda \u0db1\u0dd2\u0dc0\u0dcf\u0dc3\u0dc0\u0dbd \u0db6\u0dd2\u0dad\u0dca\u0dad\u0dd2 \u0db4\u0dd4\u0db4\u0dd4\u0dba\u0db1\u0dca\u0d9a\u0db1 \u0db4\u0db4\u0db1\u0dca\u0d9a \u0d85\u0dba\u0d9c\u0dd9\u0db1 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db1\u0db8\u0dd4\u0dad\u0dca\u0d8b \u0d92\u0d9a \u0d91\u0d9a\u0db8 \u0d9c\u0dc4\u0dda\u0dad\u0dd4\u0dc0 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8\u0db8 \u0dad\u0db1\u0dca\u0d9a\u0d9c\u0db1\u0dca\u0d9a \u0db1\u0dd2\u0dc4\u0dd2. \u0d92\u0d9a \u0d85\u0daf \u0d8a\u0d9c\u0dda \u0db4\u0db4\u0db1\u0dca\u0d9a \u0dd9\u0dad\u0dca \u0d91\u0d9a [ \u0d9c\u0db1\u0dcf\u0d9c\u0dc0\u0dba\u0dd2\u0d8b \u0d9a\u0dcf\u0dbd\u0dba [ \u0dad\u0dd2\u0dc3\u0dda\u0d9c\u0dc3\u0dda \u0d9a\u0dba\u0db1 \u0d9c\u0daf\u0dba [. \u0d91\u0db8 \u0db1\u0dd2\u0dc3\u0dcf NBRI report \u0d91\u0d9a [ \u0d85\u0dba\u0d9c\u0dd9\u0db1 \u0dad\u0dd3\u0dba\u0da7\u0dba [ \u0dd9\u0db1\u0dca\u0d9a\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8\u0db8 \u0d92 \u0d9c\u0dc0\u0dbd\u0dcf\u0d9c\u0d8b\u0db8 \u0db1\u0dd2\u0d9c\u0dba\u0ddd\u0dd9 \u0d9a\u0dd9\u0dcf. \u0db8\u0db8 \u0d9c\u0dd9\u0daf\u0dba\u0d9a \u0d87\u0dad\u0dd4\u0dd9\u0db4 \u0d9c\u0dd2\u0dba\u0dcf\u0db8 \u0d92 \u0d9c\u0dd9\u0daf\u0dba \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0dcf \u0db6\u0dd2\u0dad\u0dca\u0dad\u0dd2 \u0d89\u0dbb\u0dd2 \u0dad\u0dd2\u0dc5\u0dd2\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf \u0db8\u0db4 \u0d9c\u0db4\u0db1\u0dca\u0d9a\u0db1\u0dd4\u0dc0\u0dcf. \u0d92\u0d8b \u0d9c\u0dda \u0d9c\u0dd9\u0daf\u0dba\u0db8\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8\u0db8 \u0daf\u0db1\u0dca\u0d9a\u0d9c\u0db1\u0dca\u0d9a \u0db1\u0dd2\u0dc4\u0dd2. \u0d87\u0dad\u0dca\u0dad\u0db4\u0db8 \u0dd9\u0dad\u0dca\u0d9c\u0dad\u0dcf\u0dad\u0dca \u0d9c\u0db4\u0d9c\u0db1\u0db1\u0dca\u0d9a\u0d9c\u0db1\u0dca\u0d9a\u0d8b \u0d85\u0dca \u0d86\u0daf\u0dcf\u0dba\u0dda\u0dbd\u0dcf\u0dd3\u0db1 \u0dd2\u0dba\u0db1\u0dd2\u0dc3\u0dda\u0dc3\u0dd4\u0db1\u0dca\u0d9a\u0dc0 \u0d9c\u0dd9\u0dba [ \u0dc4\u0daf\u0dbd\u0dcf \u0daf\u0dd3\u0dbd\u0dcf \u0d94\u0d9c\u0dc4\u0dda \u0d85\u0dad \u0dc4\u0dd2\u0dba\u0dbd\u0dcf \u0daf\u0dcf\u0dbd\u0dcf \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a\u0dba\u0dd2.\n\n\u0dd9\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2\u0d8b \u0db1\u0dcf\u0dd9\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0dca\u200d\u0db1 \u0d85\u0d9a\u0dbb\u0d9a\u0dcf\u0dbb\u0dd2\u0d9c\u0dda \u0dc3\u0dda\u0db4\u0dad\u0dca \u0dc3\u0dc4 \u0db8\u0dcf\