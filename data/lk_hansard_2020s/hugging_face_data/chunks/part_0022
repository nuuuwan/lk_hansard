dd4 \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8 [ \u0db1\u0dca\u0daf\u0dd4 \u0d9a\u0dba \u0d9c\u0db1\u0dcf\u0db8\u0dd2\u0dad.\n\n(\u0d86) (i) \u0dba\u0dcf\u0da2\u0dba \u0d9c\u0dc3\u0dda\u0dc0\u0dcf \u0d9c\u0d9a\u0dcf\u0dd2\u0dba\u0dc2\u0dca\u0da8\u0db1\u0dca\u0d9a \u0dc3\u0dc0\u0dcf\u0d9c\u0d8b \u0d85\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1 \u0d9c\u0dc3\u0dda\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0da7\u0dd4\u0dc0 \u0dc0\u0dd2\u0db1\u0dca\u0db1\u0dca\u0d9a \u0db4\u0dd4\u0dba\u0dda\u0db4\u0dcf\u0dca \u0dc3\u0d82\u0d9b\u0dba\u0dcf\u0dc0 \u0d85\u0db1\u0dd4\u0dc0 \u0dc3\u0dc4 \u0d85\u0daf\u0dcf\u0dd9 \u0dc0\u0dd2\u0dc0\u0dcf\u0dd9 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dbd \u0db8\u0dad \u0dc3\u0dc4 \u0dc3\u0dda\u0db8\u0dd4\u0d9b \u0db4\u0dbb\u0dd3 [\u0dc2\u0dca\u0da8\u0da7\u0d9c\u0dda \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0dda \u0db4\u0dbb\u0dd3 [\u0dc2\u0dca\u0da8\u0dcf\u0dc0 \u0db8\u0dad \u0d9c\u0dad\u0ddd\u0dba\u0dcf \u0dd9\u0db1\u0dca\u0d9a\u0db1\u0dcf \u0dbd\u0daf \u0db1\u0dd2\u0dbd\u0dca\u200d\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0d9a \u0d9c\u0dc0\u0dad \u0db4\u0dad\u0dca\u0dd3\u0dda \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0d87\u0dad.\n\n(ii) \u0d9c\u0dc3\u0dda\u0dc0\u0dcf \u0db4\u0dd9\u0db4\u0dd4\u0dbb\u0dd4\u0dd3\u0daf \u0dc3\u0dc4 \u0d9a\u0dd4\u0dc3\u0dbd\u0dad\u0dcf \u0db4\u0daf\u0db1\u0db8 \u0db8\u0dad \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d85\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db1 \u0d9c\u0dc3\u0dda\u0dc0\u0d9c\u0dda III \u0d9c\u0dbb\u0dda\u0dab\u0dd2\u0d9c\u0dda \u0dad\u0db1\u0dad\u0dd4\u0dba \u0dc3\u0db3\u0dc4\u0dcf 2022.03.26 \u0daf\u0dd2\u0db1 \u0db1\u0dca\u0db4 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 2024.07.03 \u0daf\u0dd2\u0db1 61 \u0d9c\u0daf\u0d9c\u0db1\u0d9a\u0dd4 \u0d9c\u0dc0\u0dad \u0daf\u0d8b 2025.03.03 \u0daf\u0dd2\u0db1 4 \u0d9c\u0daf\u0d9c\u0db1\u0d9a\u0dd4 \u0d9c\u0dc0\u0dad \u0daf \u0db4\u0dad\u0dca\u0dd3\u0dda \u0dbd\u0db6\u0d