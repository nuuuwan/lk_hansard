u0dca\u0dd9\u0dbd\u0dcf\u0dd3\u0db1\u0db1\u0dca 58 67 \u0daf \u0daf\u0db1\u0d9a\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dd9\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dd9\u0db1 2 161.27\u0d9a\u0dcf \u0db8\u0dd4 \u0dbd\u0d9a\u0dca \u0dca\u200d\u0dbb \u0dcf\u0db1\u0dd9 \u0d9a\u0dcf\u0dc0 \u0d87\u0dad.\n\n2024 \u0dd9\u0dc3\u0daf\u0dbb\u0dca\u0dbd \u0dbb\u0dd4\u0db4\u0dd2\u0dd9\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dd9\u0db1 02 \u0dd9\u0dd0\u0d9c\u0dd2\u0db1\u0dca \u0dd9\u0da7\u0dd2\u0db1\u0dcf\u0d9a\u0dcf\u0dda \u0dc3\u0dc4\u0dd2\u0dad \u0db1\u0dd2\u0dd9\u0dcf\u0dc3 \u0dd9\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 0 \u0d9a\u0dca \u0d85 \u0dcf\u0dc5 \u0dbb\u0db8\u0dd2\u0d9a\u0dcf\u0db1\u0dca\u0db1\u0dca \u0daf\u0dd9\u0dad \u0dbd\u0dd9\u0dcf\u0daf\u0dd3 \u0d87\u0dad.\n\n\u0dd9\u0dbb\u0dca\u0dbd\u0dad\u0db8\u0dcf\u0db1\u0daf \u0daf\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2\u0dd9\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dd9\u0db1 02\u0d9a\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dd9\u0dc3\u0d9a\u0dca \u0dc3\u0dcf \u0dcf \u0daf\u0dd3\u0db8 \u0d85\u0db4\u0dc4\u0dc3\u0dd4 \u0dd9\u0dd0\u0dc0\u0dd2\u0db1\u0dca 1015 \u0dd9\u0dbb\u0dca\u0dbd\u0dc2\u0daf \u0dba\u0dbd\u0da7 \u0d91\u0db8 \u0db8\u0dd4 \u0dbd \u0dbb\u0dd4\u0db4\u0dd2\u0dd9\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dd9\u0db1 01\u0d9a\u0dca \u0d9a\u0dca\u0dd9\u0dcf \u0dd2\u0dc4\u0dc5 \u0db1\u0dd2\u0d82\u0dd9\u0dcf \u0d87\u0dad. \u0dad\u0dd9\u0dad\u0dca \u0db4\u0dd6\u0dbb\u0dca\u0dbd \u0d86\u0dd9\u0dcf\u0db0\u0dd2\u0dad \u0dbb\u0db8\u0dd2\u0d9a\u0dcf\u0db1\u0dca\u0db1\u0dca 07 \u0daf \u0daf\u0db1\u0d9a\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0daf\u0dda \u0dd9\u0db1 \u0dc0\u0dd2\u0da7 \u0db1\u0dd2\u0dd9\u0dcf\u0dc3 \u0dd2\u0dbd\u0dca \u0daf\u0dda \u0d9a\u0dcf\u0dc0 \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dc0 \u0d91\u0db8 \u0db1\u0dd2\u0dd9\u0dcf\u0dc3 \u0dc3\u0dcf \u0dcf\u0daf\u0dd3\u0db8\u0da7 \u0d85 \u0dcf\u0dc5 \u0dca\u200d\u0dbb\u0dc3\u0dda\u0db4\u0dcf \u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dd9\u0dcf\u0dd9\u0dd2\u0dd9 \u0dd0\u0db1\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dd9\u0dcf\u0dad\u0dca\u0db8\u0d9a\u0dcf \u0daf\u0dd9\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dd9\u0dad\u0dd3.\n\n\u25cf \u0dc0\u0dd2\u0daf\u0dda\u0dc1\u0d9c\u0dad \u0db4\u0dc0\u0dd4\u0dbd\u0dca \u0dd9\u0dbd \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a\u0dcf\u0db1\u0dca\u0db1\u0dca\u0da7 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db8\u0dca)\u0da7\u0db8\u0dd2\u0db1\u0dca \u0ddb\u0dd9 \u0dba \u0d9a\u0dcf\u0db3\u0dc0\u0dd4\u0dbb\u0dd4 \u0db4\u0dd0\u0dd9\u0dd0\u0dad\u0dca\u0dd3\u0db8.\n\n2025 \u0dd9\u0dc3\u0dc0\u0da7 \u0d91\u0d9a\u0dca \u0db4\u0dc5\u0dcf\u0dad\u0d9a\u0dcf\u0da7 \u0d91\u0d9a\u0dca \u0ddb\u0dd9 \u0dba \u0d9a\u0dcf\u0db3\u0dc0\u0dd4\u0dc0 \u0dd9\u0dd0\u0d9f\u0dd2\u0db1\u0dca \u0ddb\u0dd9 \u0dba \u0d9a\u0dcf\u0db3\u0dc0\u0dd4\u0dbb\u0dd4 8\u0d9a\u0dca \u0db4\u0dd9\u0dad\u0dca\u0dd9\u0dcf \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dc0 \u0dc0\u0dd2\u0daf\u0dda\u0dc1\u0d9c\u0dad\u0dd9 \u0dba\u0dbd\u0da7\u0dd2\u0db1\n\n\u0dc4\u0dcf \u0db1\u0dd0\u0dd9\u0dad \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0dc0\u0dd2\u0d9c\u0db8\u0db1\u0dd2\u0d9a\u0dcf \u0dbb\u0db8\u0dd2\u0d9a\u0dcf\u0dd9\u0db1\u0dca\u0da7 \u0dc4\u0dcf \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0daf\u0dda \u0db4\u0dc0\u0dd4\u0dbd\u0dca \u0dd9\u0dbd \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a\u0dcf\u0dd9\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dd9\u0dc1\u0dba \u0ddb\u0dd9 \u0dba \u0d86\u0db0\u0dcf\u0dc0 \u0dbd\u0dd9\u0dcf\u0daf\u0dd3\u0db8\u0da7 \u0d91\u0db8\u0d9f\u0dd2\u0db1\u0dca \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dcf\u0dc0 \u0d87\u0dad.\n\n\u25cf \u0dc0\u0dd2\u0daf\u0dda\u0dc1\u0d9c\u0dad \u0dbb\u0db8\u0dd2\u0d9a\u0dcf\u0db1\u0dca\u0db1\u0dca\u0daf\u0dda \u0daf\u0dc4\u0ddd \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0daf \u0dda \u0db4\u0dc0\u0dd4\u0dbd\u0dca \u0dd9\u0dbd \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a\u0dcf\u0dd9\u0db1\u0dca\u0da7 \u0d96\u0dc2\u0db0 \u0dc4\u0dcf \u0daf\u0db4\u0ddd\u0dc2\u0dba \u0dcf\u0dba\u0dd3 \u0d86\u0dc4\u0dcf\u0dc0 \u0dbd\u0dd9\u0dcf \u0daf\u0dd3\u0db8.\n\n\u0daf\u0db8\u0dc4\u0dd2\u0daf\u0dd3 \u0dd2\u0daf\u0db4\u0dad\u0db4\u0dad\u0dca \u0dd9\u0db1 \u0dd2\u0dbd\u0dca \u0dd3\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0dd9\u0db3\u0dd9 \u0dc3\u0dbd\u0d9a\u0dcf\u0dcf \u0dd9\u0dbd\u0dcf \u0d9a\u0dca\u0daf\u0dc2\u0dae\u0dad\u0dca\u200d\u0dbb \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2 \u0dd9\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf \u0dc3\u0dc4 \u0daf\u0dbd\u0dca \u0d9b\u0dca\u200d\u0db1 \u0dc0\u0dd2\u0dc1\u0dae\u0daf\u0dbd\u0dca \u0dc2 \u0dd9 \u0d9a\u0dcf\u0dc0 \u0db8\u0dd6\u0dbd\u0dba \u0dc3\u0dc4\u0db1 \u0dbd\u0dd9\u0dcf\u0daf\u0dd3\u0db8 \u0dba\u0dbd\u0daf\u0dd4 \u0d9a\u0dcf\u0dc0\u0db8\u0dca \u0dbd\u0dd0\u0daf\u0db6\u0dca\u0dbd.\n\n2025 \u0dd9\u0dc3\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0daf\u0dda \u0dd9\u0db1 \u0dc0\u0dd2\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dd9\u0dbd\u0dca \u0db8\u0dd2\u0dd2\u0dd9\u0db1 .152\u0d9a\u0dca \u0db4\u0dd4\u0dda\u0d9c\u0dbd\u0db1\u0dca\u0db1\u0dca 82\u0d9a\u0dca \u0daf\u0dd9\u0dad \u0db8\u0dd6\u0dbd\u0dba \u0dc3\u0dc4\u0db1 \u0daf\u0dbd\u0dc3 \u0dca\u200d\u0dbb \u0dcf\u0db1\u0dd9 \u0d9a\u0dcf\u0dc0 \u0dad\u0dd2\u0daf\u0db6\u0dca\u0dbd.\n\n\u25cf \u0dc0\u0dd2\u0daf\u0dda\u0dc1 \u0dbb\u0dd0\u0d9a\u0dd2\u0dd9\u0dcf\u0dd9\u0dbd \u0db1\u0dd2\u0dba\u0dd4\u0dad\u0dd4 \u0dbb\u0db8\u0dd2\u0d9a\u0dcf\u0db1\u0dca\u0db1\u0dca\u0daf\u0dda \u0db4\u0dc0\u0dd4\u0dbd\u0dca \u0dd9\u0dbd \u0dba\u0dbd\u0daf\u0dd4\u0dd9\u0db1 \u0dc4\u0daf\u0dba\u0dbd \u0d86\u0db4 \u0dcf \u0dad\u0dad\u0dca\u0dad\u0dca\u0dd9\u0dd9\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0dd6\u0dbd\u0dba\u0db8\u0dd9 \u0d86\u0db0\u0dcf\u0dc0 \u0dbd\u0dd9\u0dcf \u0daf\u0dd3\u0db8.\n\n- \u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d85\u0daf\u0dd9\u0dc0 03\u0d9a\u0dca \u0dd9\u0da7\u0daf\u0dad\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dd9\u0dcf\u0dad\u0dca\u0db8\u0d9a\u0dcf \u0d9a\u0dcf\u0dc0\u0db1\u0dca.\n\n1. \u0dc4\u0daf\u0dba\u0dbd \u0db8\u0dd6\u0dbd\u0dba \u0dc3\u0dc4\u0db1 - \u0dc4\u0daf\u0dba\u0dbd \u0d86\u0db4 \u0dcf\u0dd9\u0d9a\u0dca \u0daf\u0dc4\u0dae\u0dad\u0dd4\u0daf\u0dd9\u0db1\u0dca \u0dd9\u0dda\n\n\u0dd9\u0dbd\u0db4\u0dd1\u0db8\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dd3 \u0d87\u0dad\u0dd2 \u0dbb\u0db8\u0dd2\u0d9a\u0dcf \u0db4\u0dc0\u0dd4\u0dbd\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd2\u0dd9\u0dc5\u0dd2 \u0d86\u0dc4\u0dcf\u0dc0 \u0dbd\u0dd9\u0dcf \u0d9c\u0dd0\u0dad\u0dd2\u0db8\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dd9\u0dbd\u0dca 25 000\u0d9a\u0dcf \u0db8\u0dd6\u0dbd\u0dba \u0dc3\u0dc4\u0db1\u0dd9\u0d9a\u0dca \u0dbd\u0dd9\u0dcf \u0daf\u0dd3\u0db8.\n\n2. \u0dc3\u0dae\u0dd9\u0dcf\u0db7\u0dcf\u0dc0\u0dd2\u0d9a\u0dcf \u0dc4\u0daf\u0dba\u0dbd \u0d86\u0db4 \u0dcf\u0dd9\u0d9a\u0dca \u0daf\u0dc4\u0dae\u0dad\u0dd4\u0daf\u0dd9\u0db1\u0dca \u0db1\u0dd2\u0dd9\u0dc3\u0da7 \u0dba\u0dbd\u0daf\u0dd4\u0dd9\u0db1\n\n\u0dd9\u0dda \u0daf\u0db7\u0dde\u0dad\u0dd2\u0d9a\u0dcf \u0dc4\u0dcf\u0db1\u0dd2\u0dd9\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dd9\u0dbd\u0dca 50 000\u0d9a\u0dcf\u0da7 \u0dd9\u0da7\u0dad\u0dca\u0dd9 \u0db8\u0dd6\u0dbd\u0dba\u0dcf\u0db0\u0dcf\u0dc0\u0dd9\u0d9a\u0dca \u0dbd\u0dd9\u0dcf \u0daf\u0dd3\u0db8. 1\u0dc4\u0dcf\u0db1\u0dd2\u0db4\u0dd6\u0dbb\u0dca\u0dbd \u0dd9 \u0dc3\u0db3\u0dc4\u0dcf\n\n3. \u0dad\u0dd9\u0daf\u0dd4\u0dc0\u0da7\u0dad\u0dca \u0dc4\u0dcf\u0db1\u0dd2\u0db4\u0dd6\u0dbb\u0dca\u0dbd \u0dd9 \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0dd6\u0dbd\u0dba \u0dc3\u0dc4\u0db1 \u0dbd\u0dd9\u0dcf \u0daf\u0dd3\u0db8. 1\u0daf\u0dda"
