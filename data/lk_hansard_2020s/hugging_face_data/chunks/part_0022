 \u0dd2\u0d9f \u0dc4\u0dd4 \u0dbd\u0dca \u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dcf\u0dda[ \u0db8\u0dd9\u0dcf\u0db4\u0db8 \u0dc0\u0dda ? \u0d92 \u0dbb\u0dd3[\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0d9a\u0dca\u0dd4\u0daf\u0dca\u200d\u0dbb, \u0d9a\u0dd4\u0da9\u0dcf \u0dcf\u0dcf \u0db8 \u0dc0\u0dca\u200d\u0dba \u0db4\u0dd2\u0db8\u0db8 \u0dc0\u0dcf\u0dda\u0db8\u0dad \u0dd9\u0dbb\u0dca\u0dbd\u0db8 \u0dc0\u0dcf\u0db1\u0dca\u0dad\u0dad\u0dd9\u0dc0 \u0da7\u0db1\u0dca\u0dad \u0dd9\u0dba\u0db4\u0dd4 \u0d9a\u0dd4\u0db4\u0dba\u0dd4\u0dda\u0da7\u0dbd\u0db4 \u0dba\u0dcf\u0da2\u0dba \u0d86[\u0dad\u0dca \u0d9a\u0dcf \u0db8 \u0dc0\u0dab\u0dca\u0da9\u0da9\u0dbd\u0da7\u0dd2\u0db1\u0dca\u0dad \u0db8\u0da7\u0dd3\u0db8 \u0dc0\u0db4 \u0dd2\u0db8\u0db6\u0dca \u0dc4\u0dd4 \u0dbd\u0dca \u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dcf\u0dda[ \u0db8\u0dd9\u0dcf\u0db4\u0db8 \u0dc0\u0dda ? \u0d91\u0db8 \u0dc0 \u0db8\u0da7\u0dd3\u0dda \u0d9a\u0db3\u0dcf\u0dcf \u0db1\u0dd2[\u0db8\u0dd2\u0dad \u0dd9\u0dcf\u0dbd \u0dc3\u0dd3\u0db8 \u0dc0\u0dcf\u0da7\u0d9a\u0dca \u0dcf\u0db3\u0dd4\u0db1\u0dca\u0dad\u0da7\u0dcf \u0daf\u0dd3\u0db8 \u0dc0\u0db4 \u0dba\u0da2[ \u0dd6 \u0dcf\u0dca\u0dda ? 6. \u0dc0\u0dd2\u0dd4\u0dc0\u0dd2 \u0db6\u0dd2\u0dbd, \u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dca, \u0dca\u200d\u0dbb\u0da7\u0dcf\u0dcf\u0dca \u0db4\u0dd2\u0dd2\u0db8\u0da7\u0dd4[ \u0dad\u0dcf\u0dc5 [\u0dd1\u0db8\u0db8 \u0dc0\u0db1\u0dca\u0dad \u0d9a\u0dca\u0dd4\u0daf\u0dca\u200d\u0dbb, \u0d9a\u0dd4\u0da9\u0dcf \u0dcf\u0dcf \u0db8 \u0dc0\u0dca\u200d\u0dba \u0db4\u0dd2\u0db8\u0db8 \u0dc0\u0dcf\u0dda\u0db8\u0dad \u0da7\u0dba\u0da7\u0d9a\u0dcf[\u0dd9 \u0d9a\u0dca\u0db8\u0dc2\u0dca\u0da8\u0dda\u0dad\u0dca\u200d\u0dbb[\u0db4 \u0dc3\u0dd2\u0dd4\u0dc0\u0da7 \u0d87\u0dd2 \u0db6\u0dbd\u0db4\u0dd1\u0db8 \u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0da7 \u0d85\u0dca\u200d\u0dba[\u0dca[\u0d9a\u0dca \u0dc3\u0dd2\u0dd4\u0dc0 \u0dd9\u0dba \u0dd2\u0db8\u0db6\u0dca\u0dbd ? \u0d85\u0dc4\u0dd4\u0daf\u0dca\u200d\u0dbb\u0da7\u0dba \u0d86\u0dca[\u0dca\u0db