    "chunk_text": "\u0b85\u0ba4\u0ba9\u0bcd\u0baa\u0bbf\u0bb1\u0b95\u0bc1, \u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b9a\u0bc1\u0b9c\u0bc0\u0bb5 \u0ba4\u0bbf\u0b9a\u0bc6\u0bbe\u0ba8\u0bc6\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0b95\u0bcd\u0b95\u0bbf\u0bb0\u0bc6\u0bbe\u0b9a\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbf\u0ba9\u0bcd\u0bb1\u0bc1 \u0b85\u0b95\u0bb2\u0b9a\u0bb5, \u0bc8\u0bc6\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bc8\u0bbf\u0b95\u0bc1 \u0b9a\u0b95. \u0b9a\u0bc1\u0b9c\u0bbf\u0ba4\u0bcd \u0b9a\u0b9e\u0bcd\u0b9c\u0baf \u0ba4\u0baa\u0b9a\u0bb0\u0bb0\u0bc6\u0bbe \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bae\u0bb2\u0bae\u0bc8 \u0bb5\u0b95\u0bbf\u0ba4\u0bcd\u0ba4\u0bc6\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd.\n\n1477 1478\n\n[\u0dbb\u0dd4 \u0d9c\u0dc2\u0daf\u0dab\u0dca\u0d9a\u0dd2\u0dba\u0dca\u0d9c\u0dbb\u0daf\u0da2\u0db4\u0dd4\u0dad\u0dca\u0dad\u0dd2\u0dbb\u0dca\u0d9c\u0dbb\u0daf\u0dc3\u0dcf\u0dc4\u0daf\u0dab\u0dd2\u0dca\u0d9a\u0dca\u0d9c\u0dc4 \u0dcf\u0daf]\n\n2026 \u0da2 \u0dc0\u0daf\u0dbb\u0dd2\u0d9c23\u0d9c\n\n\u0dbd\u0dca\u0dbd\u0daf\u0dc3\u0dcf \u0daf\u0dbb\u0dd6\u0daa\u0d9c\u0dbb\u0dd4 \u0d9c\u0dc4\u0dca\u0dd3\u0dad\u0dd4\u0dc4\u0db1\u0dd2,\u0d9c\u0dda\u0dbd\u0ddd\u0d9a\u0d9c\u0db4\u0dca\u200d\u0dbb\u0d9a \u0d9c\u0dbb\u0db0\u0dba\u0daf\u0db4 \u0d85\u0dda\u0dba\u0d9a\u0dd4\u0d9c\u0dc0 \u0d9c\u0dda \u0dca \u0dc3\u0dcf\u0dca\u0d9c\u0dc4 \u0dca\u0dda\u0da9\u0dbd\u0daf\u0d9c\u0db4\u0dc0\u0dc3\u0dcf \u0dc0\u0daf\u0d9c\u0dda\u0dbd\u0ddd\u0d9a\u0dba\u0d9c\u0dda\u0dc0 \u0dc3\u0dcf \u0d9c\u0d9a\u0dd2\u0dbb\u0dd3\u0dc4\u0d9c\u0dc3\u0dcf \u0daf\u0d9c\u0d94\u0db6\u0db1 \u0d9c\u0db7\u0daf\u0dd2\u0dc3\u0dcf\u0d9c\u0d9a\u0dc5\u0d9c \u0d9a\u0dd2\u0d9c\u0db6\u0db1\u0dbd\u0dc0\u0dad\u0dca\u0dc4\u0d9c\u0dbb\u0dd2\u0dc3\u0dba\u0d9c\u0dbb\u0db0\u0dba\u0daf\u0db4 \u0dba\u0db1\u0dca\u0d9c\u0d9a\u0dd2\u0dba\u0dbd\u0daf.\u0d9c\u0dbb:\u0d9c\u0dbb\u0db4\u0d9c\u0dda\u0dca\u0d9c\u0dc3\u0dcf\u0daf\u0d9a\u0da0\u0dca\u0da1\u0daf\u0d9c\u0d9a\u0dbb \u0d9c\u0dda\u0dca\u0d9c\u0d8b\u0dad\u0dca\u0dcf\u0dbb\u0dd3\u0dcf\u0dbb\u0d9c\u0dc3\u0dcf\u0db7\u0daf\u0d9c\u0dbb\u0dca\u0db7\u0dba\u0d9c\u0dad\u0dd4\u0dc5\u0d9c\u0dd2\u0dc3\u0dc0\u0daf:\u0dba \u0d9c\u0dbb\u0dca\u0dda\u0dca\u0d9c\u0d9c\u0dbd\u0dda:\u0dca\u0d9c\u0d91\u0d9a\u0d9c\u0db4 \u0dcf\u0d9a\u0d9c\u0dc0\u0dbb\u0dca\u0dad\u0dd2\u0d9c\u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0dca\u0d9c\u0dc3\u0dcf\u0dc4\u0dda\u0dba\u0ddd\u0db0 \u0dba\u0d9c\u0d9a\u0dd2\u0dbb\u0dd3\u0dc4\u0d9c\u0db4\u0dc4\u0dab\u0dca\u0d9c\u0dda \u0daf\u0dda\u0dc0\u0db1\u0dca,\u0d9c\u0dda\u0dca\u0d9c\u0dbb\u0dda\u0da7\u0dca\u0d9c\u0dc4\u0dad\u0dd4\u0d9c\u0db4\u0dbb\u0db4\u0dd4\u0dda\u0dca\u0d9c\u0da0\u0dd2\u0dca\u0dcf \u0dba\u0d9c\u0dda\u0dc4\u0dda \u0dba\u0dc0 ,\u0d9c\u0dda\u0dca\u0d9c\u0dbb\u0dda\u0da7\u0dca\u0d9c\u0dc4\u0dad\u0dd4\u0d9c\u0db4\u0dbb\u0db4\u0dd4\u0dda\u0dca\u0d9c\u0dbb \u0daf\u0dbb\u0dcf\u0dba\u0d9c\u0dad\u0dd3\u0dbb\u0dab\u0dba\u0d9c\u0dc0 \u0d9c\u0dd2\u0dc3\u0dba \u0dc0\u0dd2\u0dc3:\u0dba\u0daf\u0dbd\u0d9c\u0db4 \u0db0\u0dad\u0dd2\u0dda\u0dda\u0d9c\u0dda \u0d9c:\u0dc0\u0dc3\u0dcf\u0d9c\u0dd2\u0dc5\u0dd2\u0db6\u0db6\u0db1 \u0dc0\u0db1\u0dca;\u0d9c1978\u0d9c\u0dd2\u0d82 \u0d9c\u0dbb:\u0d9c:\u0dca\u0dc0\u0daf\u0d9c\u0dc0\u0dc3\u0dcf\u0dbb\u0d9c47\u0dca\u0d9c\u0db4\u0dd4\u0dbb\u0daf\u0d9c\u0dda\u0dca\u0d9c\u0dba\u0dca \u0d9c\u0db4 \u0d9c\u0d9c\u0dd2\u0dba\u0d9c\u0db4 \u0dcf,\u0d9c-\u0dbb\u0dc0\u0dc3\u0dcf \u0daf\u0d9c\u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0daf\u0dd3\u0d9c\u0dc3\u0dcf\u0dc4\u0dda\u0dba\u0ddd\u0db0 \u0dba\u0d9c\u0dc0\u0dd4\u0dab\u0dad\u0dca-\u0d9c\u0dbb \u0daf\u0dbb\u0dcf\u0dba \u0d9c\u0dbb \u0dc5\u0dda\u0db4 \u0d9c\u0dda\u0dbd\u0dc3\u0dcf\u0d9c\u0dc3\u0dcf\u0dc4\u0dda\u0dba\u0ddd\u0db0 \u0dba\u0d9c\u0d9a\u0dd2\u0dbb\u0dd3\u0dc4\u0d9c\u0dd2\u0dc5\u0dd2\u0db6\u0db6\u0db1 \u0dc0\u0db1\u0dca.\u0d9c\n\n\u0dbd\u0dca\u0dbd\u0daf\u0dc3\u0dcf \u0daf\u0dbb\u0dd6\u0daa\u0d9c\u0dbb\u0dd4 \u0d9c\u0dc4\u0dca\u0dd3\u0dad\u0dd4\u0dc4\u0db1\u0dd2,\u0d9c\u0da2\u0daf\u0dad\u0dd2\u0d9a\u0d9c\u0da2 \u0d9c\u0db6\u0db1\u0dbd\u0dda\u0dda\u0dbb\u0dba\u0d9c\u0dda\u0dbd\u0dc3\u0dcf\u0d9c\u0dbb\u0dda\u0dda\u0d9c\u0dbb\u0db0\u0dba\u0daf\u0db4 \u0d9c\u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2\u0dba\u0d9c\u0db4 \u0daf\u0dd2\u0dd2\u0db1\u0dca.\u0d9c\"\u0dda\u0db4\u0daf\u0dda \u0daf\u0dc3\u0dcf\u0dad\u0dca\u0d9c\u0dbb \u0dca\u0d9c-\u0d9c\u0dbd\u0dc3\u0dcf \u0dc3\u0dcf \u0d9c\u0dd3\u0dc0\u0dd2\u0dc3\u0dcf\u0dba\u0dca\"\u0d9c\u0d9a\u0dd2\u0dba \u0d9c\u0dbb\u0dda\u0dda\u0d9c\u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd2\u0d9c\u0db4\u0dca\u200d\u0dbb\u0d9a\u0daf\u0dba \u0dba\u0d9c\u0d87\u0dad\u0dd4\u0dda\u0dc5 \u0dad\u0dca,\u0d9c\u0dc4 \u0dad\u0dd2\u0dc0\u0dbb\u0dab\u0dba \u0d9c\u0daf\u0dd2\u0dd4\u0dbd\u0d9c\u0d9a\u0daf\u0dbd\u0dba\u0d9a \u0d9c\u0dda\u0db4\u0dbb\u0d9c\u0dd2\u0d82 \u0dad\u0dca\u0d9c\u0d91\u0dba\u0d9c\u0dc4 \u0d9c\u0da2 \u0dcf\u0daf\u0dc0\u0d9c\u0dc3\u0dcf\u0dc4\u0dd9\u0d9c\u0dc3\u0dcf\u0db6\u0dd4 \u0db0\u0dd2\u0d9a\u0d9c\u0dc3\u0dcf\u0dc4\u0dc0\u0daf:\u0dba\u0d9a \u0d9c\u0dbd\u0dca\u0d9c\u0dc0\u0dd6\u0d9c\u0d9a\u0daf\u0dbb\u0dab\u0daf\u0dc0\u0dca.\u0d9c\u0dbb\u0db0\u0dba\u0daf\u0db4 \u0dba \u0d9c\u0d9a\u0dbb \u0d9c\u0dd2\u0dc3\u0dba:\u0dc4\u0d9c\u0dbb \u0dca\u0d9c\u0dbb \u0daf\u0dbb\u0dcf\u0dba\u0d9c\u0dc3\u0dcf \u0daf\u0d9c\u0d9a\u0dbb \u0d9c\u0dbb\u0dda\u0dba\u0ddd\u0da2 \u0dba\u0db1\u0dca.\u0d9c\u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4\u0d9c\u0dbb \u0dc0\u0dca \u0d9c\u0dcf\u0dc4\u0dca\u0dda\u0dda\u0d9c:\u0dc5\u0d9c\u0da2\u0daf\u0dad\u0dd2\u0d9a\u0d9c\u0db1\u0dd2\u0dc2 \u0db4\u0daf: \u0dda\u0dba\u0dca\u0d9c\u0dd2\u0dc3\u0dba\u0daf\u0dbd\u0d9c\u0db4\u0dca\u200d\u0dbb\u0dc4\u0daf\u0dab\u0dba\u0dca\u0d9c\u0dbb\u0db0\u0dba\u0daf\u0db4 \u0dba \u0d9c\u0dc0 \u0dba\u0d9c\u0d9a\u0dbb\u0dca\u0dda\u0dca\u0d9c\u0d92\u0d9c\u0db1\u0dd2\u0dc3\u0dcf\u0daf\u0db1\u0dca.\u0d9c\u0dbb \u0dca\u0d9c\u0dda\u0dbd\u0dc3\u0dcf,\u0d9c\u0dbb\u0da2\u0dba\u0dca\u0d9c\u0dda\u0dbd\u0dc3\u0dcf\u0d9c\u0dbb\u0db4 \u0d9c\u0dbb\u0dc0\u0dba\u0dba\u0d9c\u0dda\u0dc0\u0dca\u0dda\u0dca\u0d9c\u0d8b\u0db4\u0daf\u0db0\u0dd2\u0dba\u0dca\u0d9c\u0dbd\u0db6\u0db1\u0daf\u0dda\u0dbb \u0d9c\u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0daf\u0d9c\u0dc0\u0dca\u0d9c\u0db6\u0db1\u0dbd\u0daf\u0dda\u0db4\u0daf\u0dda\u0dbb\u0daf\u0dad\u0dca\u0dad\u0dd4\u0dda\u0dc0\u0dca\u0d9c\u0dda\u0db4\u0ddd\u0dd2\u0db6\u0dda\u0dca\u0d9c\u0dd2\u0d82\u0da7\u0dd2 \u0d9c\u0d8b\u0db4\u0daf\u0db0\u0dd2\u0db0\u0daf\u0dbb\u0dd2\u0dca\u0d9c\u0dda\u0dc0\u0db1\u0dd4\u0dc0 \u0d9c \u0dc0\u0d9c\n\n\u0dda\u0dbd\u0ddd\u0d9a\u0dba ,\u0d9c \u0dc0\u0d9c\u0dcf\u0daf\u0dca\u0dc2\u0dab\u0dba ,\u0d9c \u0dc0\u0d9c: \u0db1\u0dd4\u0dc4 \u0d9c\u0dbb \u0dc5\u0dda\u0db4 ,\u0d9c\u0dbb \u0daf\u0dbb\u0dcf\u0dba\u0d9c\u0dc3\u0dcf\u0dc4\u0dd9\u0d9c\u0dbb\u0db1\u0dd4\u0dda:\u0db1\u0dd4\u0d9c\u0d9a\u0dc5\u0d9c \u0d9a\u0dd2\u0d9c\u0db6\u0dd4 \u0db0\u0dd2\u0dc4\u0dad\u0dd4\u0dca\u0d9c\u0db6\u0dd2\u0dc4\u0dd2\u0d9c\u0d9a\u0dbb \u0d9c\u0dd2\u0dc3\u0dba \u0dc0\u0dd2\u0dc3:\u0dba\u0daf\u0dbd\u0d9c\u0dbb\u0db0\u0dba\u0daf\u0db4 \u0d9c\u0d9a\u0dca\u200d\u0dbb\u0dc4\u0dba\u0dca.\u0d9c\u0dda\u0dca\u0d9c\u0dbb: \u0dc3\u0dcf\u0dc4\u0d9c\u0dcf\u0dc4\u0db1\u0dca\u0d9c\u0dbb\u0dc3\u0dcf\u0dca \u0d9c:\u0dc0\u0dc3\u0dcf\u0d9a\u0d9c\u0dc3\u0dcf\u0db7\u0daf \u0daf\u0dba\u0d9a\u0d9c\u0dbb\u0dd4 \u0d9c\u0db6\u0dd2\u0dc4\u0dca \u0d9c\u0dbb\u0dad\u0dca \u0daf\u0dba\u0d9a\u0d9c\u0d87\u0dc4\u0dad\u0dd2\u0dad\u0dd4\u0dc4\u0daf\u0dad\u0dca\u0d9c\u0dda\u0dca\u0d9c\u0dc3\u0dcf\u0db7\u0daf\u0dda\u0dda\u0daf\u0dd3\u0d9c\u0d9a\u0dd2\u0dda\u0dda\u0dda;\u0d9c\u0dbb \u0dca\u0d9c\u0dda\u0dbd\u0dc3\u0dcf\u0d9c\u0dbd\u0dc4\u0d9a\u0daf\u0dc0\u0d9c\u0dc3\u0dcf\u0dad\u0dd4\u0d9c \u0dba\u0dc2 \u0da7\u0dd2\u0d9a\u0d9c\u0dbb\u0dba\u0dd4\u0db0\u0dba\u0d9c\u0dcf\u0dc4\u0db1\u0dca\u0d9c\u0db1\u0dd2: \u0dc3\u0dcf \u0d9c\u0dbb\u0db0\u0dba\u0daf\u0db4 \u0dba\u0d9c\u0d9a\u0dd2\u0dba\u0dbd\u0daf.\u0d9c\u0dbb\u0dda\u0dda\u0d9c\u0dbb \u0d9c\u0dc3\u0dcf\u0dad\u0dd4\u0d9c\u0dc0\u0da7\u0dd2 \u0daf\u0dc4\u0d9c\u0dc3\u0dcf\u0dca\u0db4\u0dcf,\u0d9c\u0dbb\u0dda\u0dda\u0d9c\u0dbb \u0d9c\u0dc3\u0dcf\u0dad\u0dd4\u0d9c\u0db6\u0db1\u0dbd\u0dc0\u0dad\u0dca\u0dc4\u0d9c\u0dbb\u0dba\u0dd4\u0db0\u0dba\u0d9c\u0db1\u0dd2: \u0dc3\u0dcf \u0d9c\u0dbb\u0db0\u0dba\u0daf\u0db4 \u0dba\u0d9c\u0db6\u0db1\u0dc0\u0d9c\u0d91\u0dad\u0dd4\u0dc4\u0daf\u0d9c\u0d9a\u0dd2\u0dda\u0dc0\u0daf.\u0d9c"
