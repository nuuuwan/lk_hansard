    "chunk_text": "\u0d85\u0db4\u0dd2 \u0dc3\u0dd2\u0dbb\u0dcf\u0db8 \u0dc0\u0dad\u0da7\u0dd4\u0db4\u0d9a\u0dca \u0dc0\u0dbb\u0db8\u0db6\u0db1 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0d9a \u0db8\u0db1\u0dcf\u0dba\u0dcf \u0db8\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0db8\u0dda\u0db1\u0dca\u0dc0\u0dd9\u0dc0 \u0d91\u0db1\u0dca\u0db8\u0db1\u0dca \u0d87\u0dba\u0dd2? \u0d91\u0dad\u0db8\u0d9a\u0dcf \u0da7 \u0dd9\u0dad \u0dbd\u0dd4\u0dc0 \u0dc0\u0dbb\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0dc3\u0dd2\u0dbb\u0dcf\u0db8 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8 \u0dbd\u0db6\u0db1 \u0d9a\u0dcf\u0dbd \u0dc3\u0dd3\u0db8\u0dcf\u0dc0 \u0dc0\u0db1 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 5 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 10\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1. \u0da7\u0db8\u0d9a\u0dca \u0d9a\u0dd2\u0db1\u0dca \u0dd9\u0dad \u0dbd\u0dd4\u0dc0\u0d9a\u0dca \u0db1\u0dad\u0dc4\u0dad. \u0d91\u0db8\u0dc4\u0db8 \u0db1\u0dad\u0dad\u0dca\u0db1\u0dda \u0d91\u0dba \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 15\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1. \u0dad\u0dc0\u0dad\u0dca \u0dc0\u0dd2\u0dad\u0dca\u0dc0\u0dbb\u0dba\u0d9a \u0db8\u0db1\u0dcf\u0dba\u0dcf \u0d91\u0db8\u0dc4\u0db8 \u0d9a\u0dad\u0db4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0db1\u0dda, \u0dbb \u0db8\u0dc0\u0db8\u0dd0\u0db8\u0dc0\u0db1\u0dca \u0db8\u0dc3\u0dda\u0dc0\u0dcf\u0dc0\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0db1\u0dda \u0dc3\u0dd2\u0dbb\u0dcf\u0db8 \u0dc0\u0dad\u0da7\u0dd4\u0db4\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0daf\u0dba \u0dba\u0dd4\u0dc0\u0dd9\u0dba\u0dd2. \u0da7 \u0dc0\u0dcf\u0db8 \u0db8 \u0dad\u0db8\u0dba\u0dd2, \u0dc3\u0dd2\u0dbb\u0dcf\u0db8 \u0dc0\u0dad\u0da7\u0dd4\u0db4\u0d9a \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0dda \u0db8\u0db1\u0dcf\u0dbd\u0dad\u0db6 \u0db8\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0db8\u0dda\u0db1\u0dca\u0dc0\u0dd9\u0dc0 \u0d86\u0dc0\u0dcf \u0db4\u0dc3\u0dda\u0db8\u0dc3\u0dda \u0db8\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0db8\u0dda\u0db1\u0dca\u0dc0\u0dd9 \u0db8\u0db1\u0dca\u0dd3 \u0dbb\u0dba\u0dbb\u0dba \u0db1\u0dad\u0dc0\u0dbb \u0daf\u0dc0\u0dc3\u0d9a \u0d85\u0db4\u0dd2 \u0dc0\u0dd3\u0dc0\u0dad\u0dca \u0db8\u0dc0\u0db1\u0dca\u0db8\u0db1\u0dca \u0db8\u0d9a\u0dcf\u0db8\u0dc4\u0dcf\u0db8\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4 \u0dc4\u0dd2\u0dad\u0db1\u0dca\u0db1 \u0db4 \u0db1\u0dca \u0dd9\u0db1\u0dca\u0db1\u0dc0\u0dcf. \u0d91\u0dad\u0db8\u0d9a\u0dcf \u0da7 \u0db8\u0dc0\u0db8\u0dd0\u0db8\u0dc0\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db8\u0dc4\u0dcf\u0dba\u0dcf \u0dd9\u0dad\u0db8\u0dda\u0db8\u0dda \u0dba\u0dda \u0db8\u0da0\u0dca\u0dad\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0d87\u0dc0\u0dbb \u0db8\u0dc0\u0db1\u0dc0\u0dcf; \u0db8\u0db8\u0dcf\u0d9a\u0d9a\u0dca \u0dc4\u0dbb\u0dd2 \u0d85\u0d9a \u0dba\u0dd4\u0dad\u0dca\u0dad\u0d9a\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0dc3\u0dd2\u0dbb\u0dcf\u0db8 \u0daf\u0dc3\u0dd2\u0dba \u0db8\u0dd9\u0dc0\u0db1\u0dca\u0db1 \u0dba\u0dda \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0db8\u0dc4\u0dcf\u0dba\u0dcf \u0dd9\u0db1\u0dca\u0db1 \u0d85\u0dc0\u0dc1\u0dba\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db8\u0da0\u0dca\u0dad\u0db1\u0dcf\u0dc0\u0d9a\u0dca \u0d87\u0dc0\u0dbb \u0db8\u0dc0\u0db1\u0dc0\u0dcf. \u0d85\u0db8\u0dda \u0d85\u0d9a\u0dbb\u0d9a\u0dbb\u0dda \u0d85\u0db8\u0dcf\u0dad\u0dba\u0dc0\u0dd9\u0db8\u0dcf \u0d85\u0dc4\u0db1\u0dc0\u0dcf, \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dba \u0dbb\u0da2\u0db8 \u0db8\u0dc3\u0dda\u0dc0\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0dc0\u0dcf\u0db8 \u0db8\u0db1\u0dcf\u0db8\u0dc0\u0dba\u0dd2, \u0db8\u0dda\u0db8\u0d9a\u0dca \u0d89\u0db1\u0dca\u0db8\u0db1\u0dca \u0d9a\u0dda\u0db6 \u0db8\u0dc4\u0dcf\u0dbb\u0dd4, \u0db8\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0db8\u0dda\u0db1\u0dca\u0dc0\u0dd9 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc3\u0dd2\u0dbb\u0dcf\u0db8 \u0dc0\u0dad\u0da7\u0dd4\u0db4\u0d9a\u0dca \u0d95\u0db1\u0dd1\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db8\u0dda \u0db4\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0db8\u0dda\u0db1\u0dca\u0dc0\u0dd9\u0db8\u0d8b \u0d89\u0db1\u0dca\u0db8\u0db1\u0dca \u0db8\u0dc4\u0dcf\u0dbb\u0dd4 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf. \u0d91\u0dc0\u0dd9\u0db8\u0dcf\u0db8\u0dd9\u0db1\u0dca \u0db8\u0db8 \u0d85\u0dc4\u0db1\u0dc0\u0dcf, \u0d91\u0dad\u0db8\u0d9a\u0dcf \u0dc0\u0dcf\u0dc3\u0dd4\u0db8\u0dd3\u0dc0 \u0db1\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dca\u0d9a\u0dcf\u0dbb \u0db8\u0dad\u0dc0\u0dbb\u0dc0\u0dd9\u0db8\u0dcf \u0db8\u0dc4\u0dcf\u0db8\u0dbb\u0d9a\u0dca\u0daf, \u0db8\u0dc4\u0dda\u0db8\u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0db1\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dca\u0d9a\u0dcf\u0dbb \u0db8\u0dad\u0dc0\u0dbb\u0dc0\u0dd9\u0db8\u0dcf \u0db8\u0dc4\u0dcf\u0db8\u0dbb\u0d9a\u0dca\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d91\u0db8\u0dc4\u0db8"
  },
