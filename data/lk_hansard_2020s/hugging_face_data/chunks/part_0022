    "chunk_text": "\u0db4\u0dad\u0dc4\u0dad\u0daf\u0dba\u0dcf\u0dc0 \u0d9a\u0dd2\u0d8b\u0dc0\u0dcf, \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0db8\u0dd3\u0dc1\u0db4\u0dcf\u0dbd\u0db1\u0da5\u0dba\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0d9a\u0dd4\u0dbd\u0dca \u0d9a\u0dbb\u0db1 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0dda \u0dad\u0dd3\u0dbb\u0dda \u0d85\u0dbb\u0db8\u0dd9\u0db1 \u0dc0\u0dbb\u0db8\u0db6\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d91\u0db8\u0dc4\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0d9a\u0dd4\u0dbd\u0dca \u0dc3\u0dc4\u0dd9\u0dad \u0dc3\u0dd2\u0d9a\u0dbb\u0dba \u0dc4\u0dad\u0db1\u0dca\u0dbb\u0dd2\u0da0\u0dca\u0da0 \u0db8\u0dd3\u0dc1\u0db4\u0dcf\u0dbd\u0db1\u0da5\u0dba\u0dd2\u0db1\u0dca \u0d89\u0dcf\u0dbd\u0dcf \u0dc0\u0dbb\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u0db8\u0dc4\u0db8 \u0db1\u0dad\u0dc0\u0dbb\u0dc0 \u0db8\u0db1\u0dcf\u0db8\u0dc0\u0dba\u0dd2. \u0d91\u0dc0\u0dad\u0db1\u0dd2 \u0d85\u0dba \u0d85\u0db4\u0dd2\u0dad\u0dca \u0daf\u0dad\u0d9a\u0dbd\u0dcf \u0dc0\u0dbb\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0db8 \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0dad\u0db1\u0dd2 \u0d9a\u0d9c\u0dcf\u0db8\u0d8b\u0daf\u0dd3\u0dad\u0dca, \u0db8\u0db8\u0dad\u0dad\u0db1\u0daf\u0dd3 \u0db8\u0db8 \u0d9a\u0dbb\u0db4\u0dd4 \u0dc4\u0dad\u0db8 \u0d9a\u0d9c\u0dcf\u0dc0\u0d9a\u0daf\u0dd3\u0db8\u0dad\u0dca \u0dc0\u0dcf\u0db8 \u0db8\u0db8 \u0d9a\u0dd2\u0d8b\u0dc0\u0dcf, \u0db8\u0dda \u0dc4\u0dad\u0db8 \u0db8\u0d9a\u0db1\u0dcf\u0db8 \u0d91\u0d9a \u0dd9\u0dda\u0db1 \u0daf\u0dcf\u0dbd\u0dcf \u0d9a\u0d9c\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db8\u0db1\u0dca \u0d9a\u0dc0\u0daf\u0dcf \u0dc4\u0dbb\u0dd2 \u0d94\u0db6\u0dc0\u0dd9\u0db8\u0db1\u0dca\u0dbd\u0dcf \u0dad\u0dca \u0da7 \u0daf\u0dd4\u0d9a \u0dc3\u0dd2\u0db3\u0dd2\u0db1\u0dca\u0db1 \u0db1\u0dca\u0daf\u0dd4 \u0db8\u0dc0\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db8\u0dda generalization \u0d91\u0d9a \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0dc4\u0dad\u0db8 \u0daf\u0dcf\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf. \u0db8\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0d9a\u0dd4\u0dbd\u0dca \u0dc3\u0dc4\u0dd9\u0dad \u0db6\u0dc0 \u0d87\u0dc0\u0dbb \u0d9a\u0db8\u0dc5\u0dda\u0dad\u0dca \u0d94\u0db6\u0dc0\u0dd9\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0db8\u0dba\u0dd2. \u0d94\u0db6\u0dc0\u0dd9\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0db8 \u0d86\u0dca\u0da9\u0dd4\u0dc0 \u0d86\u0db8\u0d8b \u0da7 project \u0d91\u0d9a \u0db1\u0dd2\u0dc3\u0dcf. \u0d85\u0db4 \u0daf\u0dad\u0db1\u0dca \u0da7\u0d9a \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc0\u0dad\u0da9\u0dbd\u0d9a\u0dca \u0db1\u0dad\u0dc4\u0dad. \u0db1\u0dca\u0dba\u0dbd\u0dd4\u0db8\u0daf\u0db1\u0dcf\u0dc0\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0d9a\u0dd4\u0dbd\u0dca \u0d9a\u0dbb\u0db1 \u0dd9\u0dda\u0db1 \u0d94\u0db6\u0dc0\u0dd9\u0db8\u0db1\u0dca\u0dbd\u0dcf \u0da7\u0d9a \u0db4\u0dad\u0dca \u0d9a\u0dc5\u0dcf. \u0d89\u0daf\u0dbb\u0dd2\u0db8 \u0daf\u0dd3 \u0db6\u0dbd\u0dcf\u0dd9\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca, \u0d94\u0db6\u0dc0\u0dd9\u0db8\u0db1\u0dca\u0dbd\u0dcf \u0da7\u0d9a \u0db4\u0dbd \u0db8\u0daf\u0db1\u0dca\u0db8\u0db1\u0dca \u0db8\u0d9a\u0dcf\u0db8\u0dc4\u0dcf\u0db8\u0daf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a.\n\n\u0db4\u0d9a\u0dca\u0dc2\u0dba\u0d9a\u0dca \u0dc3\u0dd2\u0d9a\u0dbb\u0dba \u0d85\u0db4\u0dd2 \u0db8\u0dda \u0dc3\u0dd2\u0dbb\u0dcf\u0db8 \u0dc0\u0dad\u0da7\u0dd4\u0db4 \u0dbd\u0dad\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dc0\u0dd9\u0dba\u0dd2 \u0d9a\u0dd2\u0dba\u0db1 \u0db8\u0dad\u0db8 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0db8\u0db8 \u0db8\u0dd4\u0dba\u0dcf\u0db1\u0dca\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d85\u0dc0\u0dc1\u0dba\u0dba\u0dd2. \u0dc3\u0dd2\u0db4\u0d9a\u0dca\u0dc2 \u0db1\u0dcf\u0dba\u0d9a\u0dc0\u0dd9\u0db8\u0dcf\u0dad\u0dca \u0da7\u0d9a \u0d89\u0dad\u0dcf\u0db8 \u0db4\u0dad\u0dc4\u0dad\u0daf\u0dba\u0dcf\u0dc0 \u0d9a\u0dd2\u0d8b\u0dc0\u0dcf. \u0d85\u0da9\u0dd4 \u0dd9\u0dda\u0db8\u0db1\u0dca \u0db8\u0dda\u0d9a grandfather clause \u0d91\u0d9a\u0d9a\u0dca \u0dc4\u0dbb\u0dd2 \u0db8\u0dd9\u0db8\u0db1\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d91\u0db8\u0dc4\u0db8 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dc0\u0dbb\u0db6\u0dd4\u0dda\u0dcf. \u0d85\u0daf \u0db8\u0dda \u0db4\u0db1\u0dad\u0dca \u0db8\u0d9a\u0da7\u0dd4\u0dda\u0db4\u0dad \u0da0\u0dcf\u0db8\u0dbb \u0dc3\u0dda\u0db4\u0dad\u0dca \u0db8\u0dad\u0dc0\u0dbb\u0dc0\u0dd9\u0db8\u0dcf\u0dad\u0dca \u0dc3\u0dd2\u0d82\u0db8\u0dc1\u0db1\u0db0\u0db1 \u0db8\u0dd9\u0db8\u0db1\u0db1 \u0db6\u0dc0 \u0d9a\u0dd2\u0dba\u0dcf \u0dc0\u0dbb\u0db8\u0db6\u0db1\u0dc0\u0dcf. \u0dc4\u0dad\u0db6\u0dad\u0dba\u0dd2, \u0db8\u0dda \u0db4\u0db1\u0dad\u0dca \u0db8\u0d9a\u0da7\u0dd4\u0dda\u0db4\u0dad \u0db8\u0dd9\u0db8\u0db1\u0db1\u0dca\u0db1 \u0d86\u0dca\u0da9\u0dd4\u0dc0 \u0dc4\u0daf\u0dc3\u0dda\u0db1\u0dca\u0dba\u0d9a\u0dca \u0d91\u0db8\u0dc4\u0db8 \u0db1\u0dad\u0dad\u0dca\u0db1\u0dda \u0d9a\u0dbd\u0db6\u0dbd\u0dba\u0d9a\u0dca \u0dc0\u0dbb\u0db8\u0db6\u0db1 \u0db6\u0dc0\u0d9a\u0dca \u0d85\u0db4 \u0db8\u0dda \u0db8\u0dc0\u0dbd\u0dcf\u0db8\u0d8b \u0db8\u0db4\u0db8\u0db1\u0db1\u0dc0\u0dcf.\n\n\u0da2\u0db1\u0dad\u0dcf\u0dc0\u0db8 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d85\u0dc0\u0dc0\u0dcf\u0dc3\u0dd2\u0dad \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d91\u0d9a \u0d85\u0d9a\u0dbb\u0d9a\u0dbb\u0dda \u0d87\u0db8\u0dc0\u0dbb\u0dc0\u0dd9\u0db8\u0dcf\u0dad\u0dca \u0db4\u0dad\u0dc4\u0dad\u0daf\u0dba\u0dcf\u0dc0 \u0d9a\u0dd2\u0d8b\u0dc0\u0dcf. \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc3\u0dd2\u0dbb\u0dcf\u0db8 \u0dc0\u0dad\u0da7\u0dd4\u0db4 \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8\u0db8\u0db1\u0dca \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0db8 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d85\u0dc0\u0dc0\u0dcf\u0dc3\u0dd2\u0dad \u0db8\u0dc0\u0db1\u0dc0\u0dcf, \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0db8 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d89\u0dc0\u0dd9\u0dbb\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d85\u0db4\u0dd2 \u0dc3\u0dd2\u0dbb\u0dcf\u0db8 \u0dc0\u0dad\u0da7\u0dd4\u0db4 \u0d85\u0dba\u0dd2\u0db1\u0dca \u0d9a\u0dbb\u0db8\u0dd4 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d91\u0dc0\u0dd9\u0db8\u0dcf \u0d9a\u0dd2\u0d8b\u0dc0\u0dcf. \u0dc4\u0dd2 \u0db4\u0dd4 \u0db8\u0db1\u0dca\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0db1\u0da9\u0dbd\u0dad\u0dca\u0dc0\u0dd9 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0da2\u0db1\u0dc0\u0dcf\u0dbb\u0dd2 \u0db8\u0dcf\u0dc3\u0db8 \u0daf\u0dd3 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dba\u0dcf\u0dba\u0db1 34\u0d9a\u0dca \u0dc3\u0dd2\u0dba\u0daf\u0dda \u0db8\u0dc0\u0dbd\u0dcf \u0dc0\u0dbb\u0db8\u0db6\u0db1 \u0db6\u0dc0 \u0d91\u0dc0\u0dd9\u0db8\u0dcf \u0d9a\u0dd2\u0d8b\u0dc0\u0dcf."
  },
