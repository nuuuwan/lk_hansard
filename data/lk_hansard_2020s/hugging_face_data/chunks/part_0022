    "chunk_text": "\u0da7\u0dc0 \u0dd9\u0dcf\u0dcf\u0dca\u0dcf[\u0dd9\u0dd4\u0db8 \u0dc0\u0db1\u0dd2, \u0dc4\u0dd4\u0dd4 \u0db8\u0dbd\u0ddd\u0dd9\u0db8\u0dad\u0db8 \u0dc0, globally, democracy rankings\u0da7\u0dd2\u0db1\u0dca\u0dad, rule of law rankings\u0da7\u0dd2\u0db1\u0dca\u0dad, judicial independence rankings\u0da7\u0dd2\u0db1\u0dca\u0dad \u0dbb\u0dd3[\u0dca \u0d92 \u0dcf\u0dd4\u0db8 \u0dc0 \u0db8 [\u0dbb\u0dd3\u0db1\u0dca\u0dad\u0db8 \u0dc0 \u0d85\u0db4\u0dd2 \u0db8\u0dbd\u0ddd\u0dd9 \u0db4\u0dd2\u0db8\u0db8 \u0dc0\u0dcf\u0dda[\u0db1\u0dca\u0dad\u0db8\u0da7\u0db1\u0dca\u0dad \u0dad\u0dcf\u0dc5\u0db4 \u0d87\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0dca \u0db8\u0da7\u0dbd\u0dcf\u0da7\u0dd9 \u0db8\u0db8 \u0dc0\u0dcf\u0dd9\u0d9a\u0dca \u0db8\u0dda \u0dbb\u0dd3[\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad? \u0d85\u0db4\u0dd2\u0db4 \u0dbb\u0dd3[\u0dca\u0da7\u0dcf, \u0dd9\u0dd4\u0dbd\u0dd1 \u0dc3\u0d9a\u0dcf\u0dc0\u0dd2 \u0dbb\u0dd3[\u0dbd\u0dcf. \u0d92\u0dd9 \u0dad\u0db8 \u0dc0\u0dba\u0dd2 \u0db8 \u0dc0\u0db8 \u0dc0 \u0dbb\u0dd3\u0dda\u0db8\u0dda, \u0db8\u0dda\u0da7\u0dcf \u0d9d\u0dcf\u0dad\u0dd9[\u0dcf\u0db8 \u0da7\u0da0\u0dca \u0dbb\u0dd3[\u0dbd\u0dcf. \u0d91\u0db8 \u0dc0 \u0db1\u0dd2\u0d9a\u0dcf \u0d85\u0db4\u0dd2\u0db4 \u0d92 \u0da7\u0dd4\u0dca \u0db8\u0dd3\u0db4 \u0da7\u0da9\u0dcf \u0dbb\u0dd3[\u0db1\u0dca\u0dad\u0dca \u0db8 [\u0d9a\u0dca \u0dca\u0dd4\u0dcf\u0dd4. \u0d92 \u0da7\u0dcf\u0db8 \u0db8 \u0dc0 \u0da7\u0dc0 \u0dd9\u0dcf\u0dcf\u0dca\u0dcf[\u0dd9\u0dd4\u0db8 \u0dc0\u0db1\u0dd2, \u0db8\u0dda \u0dcf\u0daf\u0dc3\u0dd2 \u0db1\u0dd3\u0dd2[ \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0da7\u0dcf \u0db8\u0dad\u0daf\u0dd3 \u0db8\u0dda\u0dd9 \u0d9a \u0db8\u0dda\u0dc1\u0db4\u0dcf\u0dbd\u0dca \u0da7\u0dc1\u0db8[\u0db1\u0dca\u0dad \u0dbb\u0dd3[\u0db1\u0dca\u0dad\u0dca \u0db8 \u0dc0\u0db8 \u0dc0 \u0dd2\u0dd4\u0da7\u0dcf. \u0db8\u0db8 \u0dc0\u0dcf\u0dd9 , \u0d9a\u0dcf\u0db8 \u0dc0\u0dcf\u0dca\u0dba\u0db8[\u0db1\u0dca\u0dad \u0dcf\u0daf\u0dc3\u0dd2 \u