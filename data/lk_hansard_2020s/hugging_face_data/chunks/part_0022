dca\u200d\u0dbb\u0dba\u0dda\u0db1\u0dba - (1):\n\n(\u0d85) (i) \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0d9c\u0d8b \u0d87\u0dad\u0dd2 A, B, C \u0dc3\u0dc4 D \u0d9c\u0dbb\u0dda\u0dab\u0dd2\u0dc0\u0dbd\u0db4 \u0d85\u0dba\u0dad\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0dd9\u0dc0\u0dbd \u0daf\u0dd4\u0dba \u0d91 [ \u0d91 [ \u0d9c\u0dbb\u0dda\u0dab\u0dd2\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0d9a\u0dd2\u0d9c\u0dbd\u0ddd\u0db8\u0dd3\u0db4\u0dba\u0dc0\u0dbd\u0dd2\u0db1\u0dca\u0d9a \u0d9c\u0dc0\u0db1\u0dca\u0d9a \u0d9c\u0dc0\u0db1\u0dca\u0d9a \u0dc0\u0dba\u0d9c\u0dba\u0db1\u0dca\u0d9a \u0d9c\u0d9a\u0dcf\u0db4\u0db8\u0da7\u0daf;\n\n(ii) \u0d91\u0db8 \u0d91 [ \u0d91 [ \u0d9c\u0dbb\u0dda\u0dab\u0dd2\u0dba\u0db4 \u0d85\u0dba\u0dad\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0dd9 \u0db1\u0da9\u0dad\u0dca\u0dad\u0dd4 \u0d9a\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0d9c\u0dc0\u0db1\u0dca\u0d9a \u0d9c\u0dc0\u0db1\u0dca\u0d9a \u0dc0\u0dba\u0d9c\u0dba\u0db1\u0dca\u0d9a \u0d9a\u0dc0\u0d9c\u0dbb\u0dca\u0daf;\n\n\u0dba\u0db1\u0dca\u0d9a\u0db1 \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0d9c\u0db8\u0db8 \u0dc3\u0dc0\u0dcf\u0dc0\u0db4 \u0daf\u0db1\u0dca\u0d9a\u0dc0\u0db1\u0dca\u0d9a\u0d9c\u0db1\u0dca\u0d9a\u0daf? (\u0d86) (i) \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8 2015 \u0db1\u0dca\u0db4 2024 \u0daf [\u0dc0\u0dcf \u0db8\u0dcf\u0dbb\u0dca\u0dd9 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0dca\u200d\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d86\u0dba\u0dda\u0dc0 \u0d9a\u0dba\u0db1 \u0dbd\u0daf \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 \u0d9a\u0dc0\u0d9c\u0dbb\u0dca\u0daf;\n\n(ii) \u0d91\u0db8 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dc0\u0dbd\u0dd2\u0db1\u0dca\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0dca\u200d\u0db1\u0dba \u0d9a\u0dba\u0db1 \u0dbd\u0daf \u0db8\u0dcf\u0dbb\u0dca\u0dd9\u0dc0\u0dbd \u0daf\u0dd4\u0dba \u0d9a\u0dd2\u0d9c\u0dbd\u0ddd \u0db8\u0dd3\u0db4\u0dbb\u0dca\u0dc0\u0dbd\u0dd2\u0db1\u0dca\u0d9a \u0d9c\u0d9a\u0dcf\u0db4\u0db8\u0da7\u0daf;\n\n(iii) \u0d91\u0db8 \u0dc0\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 \u0db8\u0d9f\u0dd2\u0db1\u0dca\u0d9a \u0d9a\u0dd4\u0dbb\u0dd4\u0da7\u0dd1\u0dd9\u0dbd \u0daf\u0dd2\u0dc3\u0dda\u0dad\u0dca\u200d\u0dbb\u0dd2 [\u0d9a\u0d9c\u0dda \u0db8\u0dcf\u0dbb\u0dca\u0dd9 \u0d89\u0daf\u0dd2\u0d9a\u0dba \u0dad\u0dd2\u0d9c\u0db6\u0dca\u0daf;\n\n(iv) \u0d91\u0d9c\u0dc3\u0dda \u0db1\u0dda\u0d8b \u0d91\u0db8 \u0db8\u0dcf\u0dbb\u0dca\u0dd9\u0dc0\u0dbd \u0daf\u0dd4\u0dba \u0d9a\u0dd2\u0d9c\u0dbd\u0ddd\u0db8\u0dd3\u0db4\u0dba\u0dc0\u0dbd\u0dd2\u0db1\u0dca\u0d9a \u0d9c\u0d9a\u0dcf\u0db4\u0db8\u0da7\u0daf;\n\n(v) \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd2\u0dba\u0daf\u0dda \u0d9a\u0dba\u0db1 \u0dbd\u0daf \u0db8\u0dd4\u0dc5\u0dd4 \u0db8\u0dd4\u0daf\u0dbd \u0d9c\u0d9a\u0dcf\u0db4\u0db8\u0da7\u0daf;\n\n\u0dba\u0db1\u0dca\u0d9a\u0db1\u0dad\u0dca \u0d91\u0dad\u0dd4\u0db8\u0dcf \u0d9c\u0db8\u0db8 \u0dc3\u0dc0\u0dcf\u0dc0\u0db4 \u0daf\u0db1\u0dca\u0d9a\u0dc0\u0db1\u0dca\u0d9a\u0d9c\u0db1\u0dca\u0d9a\u0daf?\n\n(\u0d87) \u0d9c\u0db1\u0dcf\u0d91\u0d9c\u0dc3\u0dda \u0db1\u0dda\u0d8b \u0d92 \u0db8\u0db1\u0dca\u0d9a\u0daf? \u0bae\u0baa\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1, \u0ba4\u0ba8\u0b9f\u0bc1\u0b9e\u0bcd\u0b9a\u0bbe\u0b95\u0bb2\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0b95\u0bb0 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0b95\u0bb0\u0b95\u0bcd \u0bae\u0b95\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0ba9\u0bbe:\n\n(\u0b85) (i) \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0b95\u0baf\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 A, B, C \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd D \u0ba4\u0bb0\u0b99\u0bcd\u0b95\u0b95\u0bb3\u0b9a\u0bcd \u0b9a\u0bbe\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0bb5\u0bc0\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba4\u0bc2\u0bb0\u0bae\u0bcd, \u0b92\u0bb5\u0bcd\u0ba4\u0bb5\u0bbe\u0bb0\u0bc1 \u0ba4\u0bb0\u0bae\u0bcd \u0bb5\u0bbe\u0bbe\u0bbf\u0baf\u0bbe\u0b95 \u0ba4\u0bb5\u0bb5\u0bcd\u0bae\u0bb5\u0bb1\u0bbe\u0b95 \u0b95\u0bbf\u0bae\u0bb2\u0bbe\u0bae\u0bc0\u0bb1\u0bcd\u0bb1\u0bbe\u0bbf\u0bb2\u0bcd \u0baf\u0bbe\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0b95\u0ba4\u0baf\u0bc1\u0bae\u0bcd;\n\n(ii) \u0bae\u0bae\u0bb1\u0bcd\u0baa\u0b9f\u0bbf \u0b92\u0bb5\u0bcd\u0ba4\u0bb5\u0bbe\u0bb0\u0bc1 \u0ba4\u0bb0\u0ba4\u0bcd\u0b95\u0ba4\u0b9a\u0bcd \u0b9a\u0bbe\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0bb5\u0bc0\u0ba4\u0bbf\u0b95\u0b95\u0bb3\n\n\u0baf\u0bc1\u0bae\u0bcd \u0baa\u0bb0\u0bbe\u0bae\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bb5\u0bb5\u0bcd\u0bae\u0bb5\u0bb1\u0bbe\u0b95 \u0baf\u0bbe\u0b95\u0bb5 \u0b8e\u0ba9\u0bcd\u0baa\u0b95\u0ba4\u0baf\u0bc1\u0bae\u0bcd;"
