    "chunk_text": "\u0daf\u0dda \u0dba\u0dbd\u0dd9 \u0daf \u0db4\u0dda\u0db0\u0dad\u0dd2 \u0daf\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1\u0dd9 \u0d9a\u0dd2\u0dd9\u0db1 \u0d85 \u0dc4\u0dba\u0dbd\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0db4\u0da7 \u0dc0\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dd9 \u0daf\u0dda \u0dc3\u0dd2\u0d82\u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0db1\u0dd9 \u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1 \u0dd9\u0dd0\u0dc4\u0dd0. \u0d85\u0db0\u0dba\u0dcf\u0db4\u0db1 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0dd2\u0d82\u0dc3\u0dae\u0d9a\u0dcf\u0dc0 \u0dd9 \u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dda \u0d85\u0db1\u0dd2\u0dd9\u0dcf\u0dbb\u0dca\u0dbd\u0dd9\u0daf\u0dd9\u0db1\u0dca\u0db8 \u0dba\u0d9a\u0dcf\u0da7 \u0da9\u0dd2\u0db1\u0dca\u0da2\u0dd2\u0da7\u0dbd\u0dca \u0dad\u0dcf\u0d9a\u0dca\u0dc2 \u0dd9 \u0d95\u0db1\u0dd1. \u0d91\u0dad\u0daf\u0d9a\u0dcf\u0dcf\u0da7 \u0d9a\u0dd4 \u0daf\u0db8\u0dca \u0d95\u0db1\u0dd1. \u0dc3\u0db1\u0dca\u0db1\u0dd2\u0daf \u0db1 \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dcf\u0dda \u0d95\u0db1\u0dd1. \u0d85\u0db4\u0dd2 \u0d86\u0dbb\u0dca\u0dbd\u0dae\u0dd2\u0d9a\u0d9a\u0dcf\u0dd9 \u0db1\u0d9f\u0dcf\u0dba\u0dbd\u0da7\u0dd4\u0dd9\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dd1. \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dd9 \u0daf\u0db1\u0dd9\u0dbd \u0d85\u0daf\u0db4\u0dca\u0db4 \u0dc0\u0da7 \u0d86\u0db4 \u0dcf\u0dd9\u0da7 \u0dbd\u0d9a\u0dca \u0daf\u0dd9\u0da0\u0dca\u0da0\u0da0 \u0daf\u0dd9\u0dbd\u0dcf\u0daf \u0d85\u0db4\u0da7 \u0dc3\u0db1\u0dca\u0db1\u0dd2\u0daf \u0db1 \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0dcf\u0dda \u0d85\u0d9b\u0dca\u200d\u0dab\u0dca\u0da9\u0da9\u0dd9 \u0d95\u0db1\u0dd1 \u0dc0\u0dd4 \u0dcf. \u0dd9\u0d9c\u0d9a\u0dd2\u0dd9 \u0dba\u0dd4\u0dad\u0dd4 \u0dc0\u0da2\u0dd9\u0d9a\u0dca \u0dc4\u0dd0\u0da7\u0dd2\u0dd9\u0da7 2992\u0daf\u0dd3 \u0dc4 \u0db4\u0dd4 \u0db4\u0db1\u0dad 2996\u0daf\u0dd3 \u0dc3\u0dd2\u0d82\u0daf\u0dc1\u0ddd\u0db0\u0db1\u0dd9 \u0daf\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf. 2996\u0db1\u0dca \u0db4\u0dc3\u0dae\u0daf\u0dc3\u0dae 101 \u0daf\u0dd3 \u0db1\u0dd0\u0dd9\u0dad \u0dc3\u0dd2\u0d82\u0daf\u0dc1\u0ddd\u0db0\u0db1\u0dd9\u0d9a\u0dca \u0daf\u0d9c\u0db1\u0dd0\u0dad\u0dca \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf \u0dba\u0dad\u0dca \u0db7\u0dcf\u0daf\u0d9c\u0da7 \u0dad\u0dd2\u0dd9\u0dcf\u0daf\u0d9c\u0db1. \u0dba \u0dc3\u0dd2\u0d82\u0daf\u0dc1\u0ddd\u0db0\u0db1\u0dd9 \u0d9a\u0dcf\u0dc0\u0db4\u0dd4 \u0db4\u0db1\u0dad\u0da7 \u0daf\u0dc0 \u0d85\u0dbd\u0dcf\u0dba\u0dbd \u0daf\u0d9c\u0db1\u0dd0\u0dbd\u0dca \u0dbd\u0dcf \u0d85 \u0d85\u0db4\u0dd2 \u0dba\u0dd9\u0dcf \u0dd9\u0dbd\u0dcf\u0dad\u0dca\u0db8\u0d9a\u0dcf \u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1 \u0dc3\u0dcf\u0d9a\u0dcf\u0da0\u0dca\u0da0\u0da1\u0dcf \u0d9a\u0dcf\u0dc0\u0db1\u0dd9\u0dcf. \u0daf\u0dda \u0dc3\u0dcf\u0d9a\u0dcf\u0da0\u0dca\u0da0\u0da1\u0dcf\u0dd9 \u0d85\u0dad\u0dba\u0dd9\u0dc1\u0dba \u0dc3\u0dcf\u0d9a\u0dcf\u0da0\u0dca\u0da0\u0da1\u0dcf\u0dd9\u0d9a\u0dca \u0d9a\u0dd2\u0dd9\u0dbd\u0dcf \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dd9 \u0dc0\u0dd2\u0dc1\u0dae\u0dd9\u0dcf\u0dc3 \u0d9a\u0dcf\u0dc0\u0db1\u0dd9\u0dcf.\n\n\u0b87\u0ba9\u0bcd\u0bb1\u0bc1 \u0bb5\u0bbf\u0bb5\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8e\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0baa\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b87\u0ba8\u0bcd\u0ba4 \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0bae\u0bbe\u0ba9 \u0bc6\u0bbf\u0bc8 \u0bb5\u0bbf\u0b9f\u0baf\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba9. \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0b95, \u0b87\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0bae\u0bc2\u0bc8\u0ba4\u0ba9\u0bae\u0bcd \u0b8e\u0bb5\u0bcd\u0bb5\u0bbe\u0bb1\u0bc1 \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd \u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1? \u0b8e\u0ba9\u0bcd\u0bb1 \u0bb5\u0bbf\u0b9f\u0baf\u0bae\u0bcd \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0bae\u0bbe\u0ba9\u0ba4\u0bc1. \u0b8e\u0bae\u0ba4\u0bc1 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0b9a\u0ba4\u0bae\u0bb5\u0b95\u0bae\u0bb3 \u0ba8\u0bbf\u0bae\u0bb1\u0b9a\u0bb5\u0bb1\u0bcd\u0bb1\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0b85\u0bb3\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8e\u0bae\u0ba4\u0bc1 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 towers\u0b87\u0ba9\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd\u0bae\u0b95 \u0b9a\u0baa\u0bbe\u0ba4\u0bbe\u0ba4\u0bc1. \u0b8e\u0bae\u0ba4\u0bc1 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 8,000 towers \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bbe\u0bb2\u0bc1\u0bae\u0bcd, \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd 800 towers \u0b9a\u0ba4\u0bae\u0bb5\u0baf\u0bbe\u0b95\u0bb5\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. \u0b87\u0ba8\u0bcd\u0ba4 \u0bb5\u0bb0\u0bc1\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd 150 towers\u0b90 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0b9a\u0ba4\u0bae\u0bb5\u0baf\u0bbe\u0ba9 \u0bae\u0bc2\u0bc8\u0ba4\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd 75 \u0bc6\u0ba4\u0bb5\u0bc0\u0ba4\u0ba4\u0bcd\u0bae\u0ba4 \u0b85\u0bb0\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95 \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. \u0b87\u0ba8\u0bcd\u0ba4 800 towers\u0b90\u0baf\u0bc1\u0bae\u0bcd \u0b92\u0b9a\u0bb0 \u0ba4\u0b9f\u0bae\u0bb5\u0baf\u0bbf\u0bb2\u0bcd \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bae\u0bbe \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 \u0baa\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbf\u0bb2\u0bcd \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc8\u0ba8\u0bcd\u0ba4\u0bbe\u0b9a\u0bc8\u0bbe\u0bc6\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0bb5\u0bb0\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0b9a\u0bb1\u0bbe\u0bae\u0bcd.\n\nTelecommunication service \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1, \u0b8e\u0bae\u0ba4\u0bc1 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0b85\u0bae\u0ba9\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0b9a\u0ba4\u0bc6\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bbe\u0baf\u0ba4\u0bcd \u0b9a\u0ba4\u0bae\u0bb5\u0baf\u0bbe\u0b95\u0bb5\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. \u0bc6\u0bbf\u0bc8 \u0b8a\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0baa\u0ba4\u0bbe\u0bae\u0bc8\u0b9a\u0baa\u0bc6\u0bbf \u0b85\u0bae\u0bb4\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bae\u0bb3 \u0b8e\u0b9f\u0bc1\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bbe\u0ba4 \u0ba8\u0bbf\u0bae\u0bc8\u0bae\u0bae \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1. \u0b8f\u0ba9\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 regulations\u0b90 \u0ba8\u0bae\u0b9f\u0bae\u0bc1\u0bae\u0bb1\u0baa\u0bcd \u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4 \u0b9a\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0bae\u0ba4 \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0b95\u0bc2\u0bb1\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0b9a\u0bb1\u0ba9\u0bcd. \u0baa\u0b95\u0bcc\u0bb0\u0bb5 \u0b95\u0bc1\u0bb4\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0ba4\u0bcd \u0ba4\u0bb5\u0bbf\u0bc6\u0bbe\u0bb3\u0bb0\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0b9a\u0bb3, \u0b92\u0bb5\u0bcd\u0baa\u0bb5\u0bbe\u0bb0\u0bc1 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0bae\u0bc1\u0bae\u0bcd \u0b92\u0bb5\u0bcd\u0baa\u0bb5\u0bbe\u0bb0\u0bc1 tower \u0bb5\u0bc0\u0ba4\u0bae\u0bcd \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0bc1\u0bae\u0bbe\u0ba9\u0bbe\u0bb2\u0bcd, \u0b8e\u0bae\u0ba4\u0bc1 \u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0bae\u0bc2\u0bc8\u0ba4\u0ba9\u0bae\u0bcd \u0b8e\u0bb5\u0bcd\u0bb5\u0bb3\u0b9a\u0bb5\u0bbe \u0bb5\u0bc0\u0ba3\u0bcd\u0bb5\u0bbf\u0bb0\u0baf\u0bae\u0bbe\u0b95\u0bc1\u0bae\u0bcd. \u0b85\u0ba4\u0bc1 \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u0bb0\u0bc1\u0bae\u0b9f\u0baf \u0bae\u0bc2\u0bc8\u0ba4\u0ba9\u0bae\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc8\u0bbe\u0bae\u0bcd \u0b85\u0bb2\u0bcd\u0bc8\u0ba4\u0bc1 \u0b85\u0bb0\u0bc6\u0bbe\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bae\u0bc2\u0bc8\u0ba4\u0ba9\u0bae\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc8\u0bbe\u0bae\u0bcd! \u0b89\u0ba4\u0bbe\u0bb0\u0ba3\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc2\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd, \u0b87\u0ba8\u0bcd\u0ba4 \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u0bae\u0bb3 \u0ba8\u0bae\u0b9f\u0bae\u0bc1\u0bae\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd\u0b9a\u0baa\u0bbe\u0ba4\u0bc1, \u0b92\u0b9a\u0bb0 tower\u0b90 \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4 \u0bae\u0bc2\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bae\u0bcd. \u0b87\u0ba4\u0ba9\u0bbe\u0bb2\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bb3\u0bb5\u0bc1 \u0bae\u0bc2\u0bc8\u0ba4\u0ba9\u0bae\u0bcd \u0baa\u0bc6\u0bc8\u0bb5\u0bbe\u0b95\u0bc1\u0bb5\u0bae\u0ba4\u0ba4\u0bcd \u0ba4\u0bb5\u0bbf\u0bb0\u0bcd\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0b9a\u0ba4\u0bbe\u0b9f\u0bc1, \u0ba8\u0bae\u0b9f\u0bae\u0bc1\u0bae\u0bb1\u0b9a\u0bcd \u0baa\u0bc6\u0bc8\u0bae\u0bb5\u0baf\u0bc1\u0bae\u0bcd \u0b95\u0bc1\u0bae\u0bb1\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bae\u0bcd. \u0b9a\u0bae\u0bb2\u0bc1\u0bae\u0bcd,"
  },
