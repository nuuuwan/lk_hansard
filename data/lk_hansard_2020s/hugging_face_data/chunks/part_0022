    "chunk_text": "\u0d85\u0db4\u0dd2 \u0d85 \u0dc0\u0dd2\u0da7\u0dcf \u0dd9\u0dba\u0db8\u0dd2\u0db1\u0dca\u0dad \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db8 \u0dc0\u0dcf\u0da2\u0dca \u0d86\u0dba\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0dd9 \u0db4\u0dca\u0dad [\u0db4\u0db8 \u0d9a \u0db8\u0da7\u0db8\u0dca\u0dca \u0db8\u0dba\u0d9c\u0dd4\u0dbd\u0dcf\u0dc3\u0dd2[\u0d9a\u0dca \u0da7\u0dca \u0dcf\u0daf\u0dd3\u0dc3\u0dd2 \u0db1\u0dd3\u0dd2[ \u0dad\u0da7\u0dd4\u0dc0\u0dba\u0db4 \u0d9a \u0daf\u0dd3\u0dbb\u0dca\u0dbd\u0d9d \u0dbb\u0dd3\u0db8\u0dda\u0db8 \u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0da7\u0dba\u0dd2. \"\u0daf\u0da7\u0dca\u0da7\u0dcf\" \u0dd4\u0dc5\u0dc5\u0dd2 \u0d9a\u0dd4\u0dda\u0dcf\u0db4\u0dca\u0da7 \u0d9a \u0d91\u0d9a\u0dca\u0dd9 \u0d87\u0dd2 \u0db8\u0da7\u0da0\u0dca\u0da0 \u0dad \u0d9a \u0d9a\u0da7[ \u0db8\u0db8 \u0dc0\u0dcf\u0dca\u0dad\u0dba\u0dda \u0db6\u0dba\u0db4\u0dad\u0dc5 \u0dbb\u0dd3[\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0dd9\u0dc0\u0dd4\u0dc0 \u0d9a \u0db1\u0dca\u0dad\u0dca\u0da7\u0dcf. \u0d91[ \u0da2\u0dcf\u0dd2\u0dd9 \u0da7\u0dc1\u0db8[\u0db1\u0dca\u0dad \u0db8\u0db8 \u0dc0\u0dcf\u0dca\u0dad\u0dba\u0dda \u0dc0\u0dd2\u0dca\u0dcf\u0dc1[\u0d9a\u0dca \u0dbb\u0dd3[\u0dca \u0d91\u0dd9 \u0db8\u0dd3\u0db4 \u0dd9\u0dd2\u0db1\u0dca\u0dad \u0dad\u0daf\u0dd2\u0db8\u0db4 \u0d9a \u0dd9\u0dba\u0db4\u0dd4 \u0dd9\u0dc0 \u0dab\u0dd4\u0da7\u0dbd\u0daf\u0dd3 \u0dad\u0dcf\u0dc0\u0dd4\u0dc0 \u0dc0\u0dd4\u0dda\u0dcf.\n\n\u0db1\u0dd4\u0da7\u0dba\u0d91\u0dc5\u0dd2[ \u0daf\u0d9a\u0dda\u0dd2\u0d9a\u0dca\u0dd9\u0db8\u0dad \u0dc0\u0dd2\u0dad\u0dba\u0d9a\u0dca \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca 2 , ]]]\u0dd9 \u0daf\u0dd3\u0db8 \u0dc0\u0dca\u0dcf\u0da7 \u0db8 \u0db1\u0dca\u0dad\u0dca \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db8\u0dd9\u0ddd\u0da7\u0dd2 \u0dd2\u0d9a\u0dda\u0d91\u0d9a\u0dca\u0dbd\u0d9a\u0dca\u0dc2\u0dca\u0da8 \u0dcf\u0dd4 \u0d9a\u0dad\u0dd1\u0db4\u0db1\u0dca\u0dad \u0dcf\u0d9a\u0dd9 \u0dc4\u0dd4 \u0dbd\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0db8\u0db8 \u0dc0\u0dcf\u0dd9 , \u0dad\u0da7\u0db8 \u0dc0 \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca 2 , ]]] \u0dca\u0dd4\u0dcf\u0dd4, \u0dad\u0da7\u0db8 \u0dc0 \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca ], ]]] \u0dca\u0dd4\u0dcf\u0dd4 \u0dbb\u0dd3[\u0dbd\u0dcf \u0d9a\u0db8 \u0dc0\u0dcf\u0dba \u0d85[ \u0dbb\u0dd3\u0dda\u0da7\u0dcf \u0db8\u0db1\u0dca\u0dad. \u0d92 \u0db1\u0dd2\u0d9a\u0dcf\u0dba\u0dd2 \u0db8 \u0dc0\u0db8 \u0dc0 \u0db8\u0dda \u0dd9\u0dcf\u0dba\u0dda[ \u0dbb\u0dd3[\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad. \u0db1\u0dd4\u0da7\u0dba\u0d91\u0dc5\u0dd2[ \u0daf\u0d9a\u0dda\u0dd2\u0d9a\u0dca\u0dd9\u0db8\u0dad \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca 2 , ]]] \u0daf\u0dd3\u0db8 \u0dc0\u0dca\u0dcf\u0da7 \u0dc0\u0dd2\u0d9a\u0dbb[\u0db4 \u0dc0\u0dd2\u0dad\u0dba\u0d9a\u0dca \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db8\u0dd9\u0ddd\u0da7\u0dd2 \u0dd2\u0d9a\u0dda\u0d91\u0d9a\u0dca\u0dbd\u0d9a\u0dca\u0dc2\u0dca\u0da8 \u0dcf\u0dd4 \u0d9a\u0dad\u0dd1\u0db4\u0db1\u0dca\u0dad \u0dcf\u0d9a\u0dd9 \u0dc4\u0dd4 \u0dbd\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca ], ]]] \u0daf\u0dd3\u0db8 \u0dc0\u0dca\u0dcf\u0da7 \u0dc0\u0dd2\u0d9a\u0dbb[\u0db4 \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca \u0db4\u0db1\u0dca\u0dad\u0db8\u0dd9\u0ddd\u0da7\u0dd2 \u0d85\u0db1\u0dd6\u0db4\u0db1\u0dca\u0dad\u0dbd\u0d9a\u0dca\u0dc2\u0dca\u0da8[\u0dd9 \u0dc4\u0dd4 \u0dbd\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0db8\u0dda, \u0db4\u0dd4\u0dc5\u0d9c\u0dd2[ \u0db8 \u0d9a\u0dd4\u0dda\u0db6\u0dbb\u0dca\u0dbd 52 \u0db8\u0da7\u0dca\u0db8\u0dd9\u0dcf\u0db4 \u0dd2\u0db8\u0db6\u0dca \u0da7\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0da7. \u0d92 \u0dc0\u0dd2\u0dad\u0dba\u0d9a\u0dca \u0db8\u0dca\u0dcf\u0db8\u0da7\u0dba\u0dd2. \u0db4\u0dcf\u0d9a\u0dbd\u0dca \u0dc5\u0dc4\u0dd4\u0db1\u0dca\u0dad \u0d9a\u0db3\u0dcf\u0dcf \u0db8\u0da7\u0da7\u0dca \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca 2 , ]]] \u0daf\u0dd3\u0db8 \u0dc0\u0dca\u0dcf\u0da7 \u0db8\u0da7\u0db1\u0dd4\u0db8\u0da7\u0db1\u0dca\u0dad \u0d91\u0d9a\u0dca\u0db8\u0dd9\u0ddd\u0da7\u0dd2 \u0d85\u0db1\u0dd6\u0db4\u0db1\u0dca\u0dad\u0dbd\u0d9a\u0dca\u0dc2\u0dca\u0da8 \u0d85\u0db1\u0dd6 \u0dcf\u0d9a\u0d9a\u0dca \u0db8\u0da7\u0da7\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0db8\u0dda \u0db1\u0dd4\u0da7\u0dba\u0d91\u0dc5\u0dd2[ \u0daf\u0d9a\u0dda\u0dd2\u0d9a\u0dca\u0dd9\u0db8\u0dad \u0db8\u0dad\u0dcf\u0dba\u0dd4\u0dc0 \u0dc0\u0dd2\u0dad\u0dba\u0dba\u0dd2.\n\n\u0d8a\u0dc5\u0d9f\u0db4, \u0da7\u0da7\u0dcf \u0dcf\u0dcf\u0db1\u0dd2\u0da7\u0dbd\u0db4 \u0dc4\u0dd4 \u0dbd\u0dca \u0db8\u0da7\u0dda\u0db8\u0dda \u0dca\u0dd4\u0dcf\u0dd4 \u0dbb\u0dd3[\u0dbd\u0dcf \u0dad\u0da7 \u0dd9\u0dcf\u0dba\u0dda[\u0d9a\u0dca \u0dad\u0d9a\u0dda\u0db8 \u0dc0\u0dd4 \u0dd9\u0dc5\u0dcf. \u0d92 \u0db1\u0dd2\u0d9a\u0dcf \u0db8 \u0dc0\u0db8 \u0dc0 \u0db8\u0dda \u0db8\u0db8 \u0dc0\u0dcf\u0db8\u0dcf\u0dcf\u0db8 \u0d9a\u0db8 \u0dc0 \u0dd9\u0dca\u0dd2\u0dd9\u0dbb\u0dca\u0dbd\u0db8 \u0dc0 \u0d85\u0db8 \u0dc0\u0dcf\u0dad\u0dba\u0dcf\u0dd2\u0d82\u0dc1[\u0db4 \u0dd9\u0dcf\u0dcf \u0dd9\u0dba\u0dbd\u0dcf \u0da7\u0dcf\u0dbb\u0dca\u0dbd\u0dad\u0dcf\u0da7\u0d9a\u0dca \u0da7 \u0d9a\u0dad\u0dcf. \u0dd9\u0dca\u0dd2\u0dd9\u0dbb\u0dca\u0dbd\u0db8 \u0dc0 \u0d85\u0db8 \u0dc0\u0dcf\u0dad\u0dba\u0dcf\u0dd2\u0d82\u0dc1\u0db8\u0dad \u0dd2\u0db8\u0db6\u0dca \u0db8\u0dad\u0dcf\u0dba\u0dd4\u0dc0 \u0da7\u0dbd\u0db4 \u0d85\u0db1\u0dd4\u0da7 \u0d8a\u0db8\u0dad \u0daf\u0dca[ \u0da7\u0dca \u0dc0\u0dd2\u0db4 \u0da7\u0da7\u0dcf \u0dcf\u0dcf\u0db1\u0dd2 \u0d9a\u0db3\u0dcf\u0dcf \u0dc4\u0dd4\u0dd4 \u0dbd\u0dd2\u0d82\u0dd9\u0dcf\u0da7 \u0db4\u0dd4\u0dba\u0dcf \u0db8\u0da7\u0dcf\u0dd3\u0db1\u0dca\u0dad ], 22\u0dd9\u0db4 \u0db8\u0da7\u0da7\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0dca \u0dc4\u0dd4 \u0dbd \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca \u0db8\u0dd9\u0ddd\u0da7\u0dd2 222\u0d9a\u0dca. \u0dcf\u0dd2\u0db8[\u0db4\u0db8 \u0dc0 \u0dbb\u0dd3[\u0dca\u0da7\u0dcf \u0dca\u0dda \u0d8a\u0db8\u0dad \u0db8\u0da7\u0dca\u0db8\u0dd9\u0dcf\u0db4 \u0db8\u0da7\u0da7\u0db4\u0dd4 \u0d92 \u0dc4\u0dd4 \u0dbd \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca \u0db8 \u0dc3\u0dd2[\u0db8 \u0dcf\u0db8\u0dc5\u0dcf\u0d9a\u0dda\u0db8\u0dd9\u0ddd\u0da7\u0dd2 \u0dcf\u0dd4 \u0d9a\u0dad\u0dd1\u0dca\u0da7\u0dbd\u0d9a\u0dca\u0dc2\u0dca\u0da8 \u0dc0\u0dd2\u0dc3\u0dd2\u0dcf[ \u0dcf\u0d9a\u0dda \u0dcf \u0d9a\u0dc3\u0dd2[\u0d85\u0dd6 \u0d91\u0dd9\u0dba\u0dd2 \u0dc1\u0dad \u0dc0\u0dd2\u0dc3\u0dd2\u0db8 \u0dd9\u0dba\u0dd2. \u0db8\u0dda \u0d9a\u0dcf \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd \u0dc4\u0dd4 \u0dbd\u0d9a\u0dca \u0db8\u0da7\u0dcf\u0dd3\u0db1\u0dca\u0dad \u0d9a\u0db3\u0dcf\u0dcf \u0da7\u0db1\u0dca\u0dad\u0daf \u0dc0\u0dd2\u0d9a\u0dbb[\u0db4 \u0db8\u0da7\u0da7\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0d92 \u0d85\u0db1\u0dd4\u0da7 \u0da2\u0dca \u0da2\u0dd3\u0dc0\u0dd2\u0dad [\u0dcf\u0dcf\u0da7 \u0d9a \u0dbb\u0dd3\u0db8\u0dda\u0db8 \u0dc0 \u0db8\u0da7\u0db1\u0dd4\u0db8\u0da7\u0db1\u0dca\u0dad \u0daf\u0dca 7]\u0d9a\u0dca \u0da7\u0dcf\u0db8 \u0dd9\u0dcf\u0dbd[\u0d9a\u0dca \u0d87\u0dd4\u0dc5\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd2[\u0dcf\u0db8 \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0da7 \u0da7\u0db1\u0dca\u0dad\u0dca \u0dba\u0da2[\u0d9a\u0dca \u0dc0\u0dd2\u0d9a\u0dbb[\u0db4 \u0d85\u0db4\u0db4 \u0dcf\u0dd4\u0dbb\u0dd3[\u0dcf\u0da7 \u0dbd\u0dd4\u0db6\u0dd2\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0dcf\u0dd4\u0db6\u0dd4\u0dba\u0dd2 \u0db8\u0dda \u0dad \u0d9a \u0d9a\u0da7[ \u0d85\u0da7\u0d9a\u0db1\u0dca\u0dad ? \u0db8\u0dda \u0dcf\u0daf\u0dc3\u0dd2 \u0d85\u0da7\u0d9a\u0dda\u0dcf\u0dcf \u0dad \u0d9a \u0d9a\u0da7[ \u0dad\u0da7\u0dd4\u0dc0\u0dba\u0db4 \u0d9a \u0daf\u0dd3\u0dbb\u0dca\u0dbd\u0d9d \u0dd9\u0dc5 \u0dba\u0dd4\u0dd4 , \u0dca\u0dd4\u0dda \u0dbb\u0dd3[\u0dca \u0dd9\u0dcf\u0dba\u0dda[ \u0d9a\u0dda\u0db6\u0db1\u0dca\u0dad\u0dca\u200d\u0db8[\u0db1\u0dca\u0dad \u0db4\u0dd4\u0da7\u0dd4 \u0d9a\u0db8\u0da7\u0dca \u0dc0\u0dd2\u0da7\u0dcf \u0db8\u0dad\u0daf\u0d