    "chunk_text": "\u0dd4 \u0dad\u0dca,\u0d9c\u0dbb\u0dd2\u0dc5\u0d9c\u0db4 \u0dcf \u0d9c\u0dc3\u0dcf\u0dc4\u0dda\u0dba\u0ddd\u0db0 \u0dba\u0dca\u0d9c\u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0d9c\u0d9a\u0dbb\u0dbd\u0daf\u0d9c\u0dad\u0dd2\u0dda\u0db6\u0db1 \u0dc0\u0daf,\u0d9c\u0d8b\u0db4\u0d9a\u0dd4\u0dbd\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0daf\u0dda\u0dda\u0d9c\u0db1\u0dd2\u0dca\u0dda \u0dba\u0dba\u0d9c\u0dc4\u0dcf\u0d9c\u0db4\u0daf\u0dbd\u0d9a\u0d9c\u0dc3\u0dcf\u0db7\u0daf\u0dc0\u0d9c\u0dd2\u0dc3\u0dd2\u0d82\u0dca\u0d9c\u0dbb\u0db0\u0dba\u0dba \u0d9c\u0dbb\u0dc4\u0dba\u0d9c\u0db4\u0dca\u200d\u0dbb\u0db0\u0daf \u0dc0\u0dd4 \u0dca\u0d9c\u0db4\u0dad\u0dca\u0d9c\u0d9a\u0dc5\u0d9c\u0dba\u0dd4\u0dad\u0dd4\u0db1\u0dca\u0d9c\u0d9a\u0dd2\u0dba\u0dbd\u0daf.\u0d9c\u0dbb\u0db0\u0dba\u0dba \u0d9c\u0dbb\u0dc4\u0dba\u0d9c\u0db4\u0dca\u200d\u0dbb\u0db0\u0daf \u0dc0\u0dd4 \u0dca\u0d9c\u0db4\u0dad\u0dca\u0d9c\u0d9a\u0dd2\u0dbb\u0dd3\u0dc4\u0d9c\u0dda\u0d9a\u0dda\u0dbb\u0dc4\u0dd2\u0dad\u0dca\u0d9c\u0dbb\u0dd2\u0dc5\u0d9c\u0dcf\u0dc0\u0dbd\u0dd2\u0dbb \u0dad\u0dca\u0d9c\u0db4\u0dd4\u0dc5\u0dd4\u0dca \u0d9c\u0dd2\u0dc3\u0db0\u0dd2\u0dba \u0d9c\u0db4\u0dca\u200d\u0dbb\u0da2\u0daf\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0daf\u0daf\u0dd3\u0d9c\u0dda\u0dc0\u0dbd\u0daf\u0d9c\u0dad\u0dd2\u0dda\u0db6\u0db1 \u0dc0\u0daf.\u0d9c\u0dcf\u0db1\u0dd2\u0d9c\u0db4\u0dd4 \u0dbb\u0dbd\u0dda\u0dba\u0d9a\u0dd4\u0d9c\u0dd2\u0dc3\u0dd2\u0d82\u0dca\u0d9c\u0dbb\u0db1\u0dd4\u0d9c\u0dbd\u0db6\u0db1 \u0d9c\u0dad\u0dd3\u0dbb\u0dab\u0d9c\u0dda\u0dc0\u0db1\u0dd4\u0dc0 \u0d9c\u0dbb\u0dd2\u0dc5\u0d9c\u0dc3\u0dcf\u0daf\u0dbd\u0dca\u0dc4\u0dd2\u0d9a\u0d9c\u0dad\u0dd3\u0dbb\u0dab\u0d9c\u0dda\u0d9a\u0dda\u0dbb\u0dc4\u0dd2\u0d9c\u0dbb\u0dc0\u0db0\u0daf \u0dba\u0d9c\u0dda\u0dba\u0daf\u0dd4 \u0d9c\u0d9a\u0dbb\u0dbd\u0daf\u0d9c\u0dad\u0dd2\u0dda\u0db6\u0db1 \u0dc0\u0daf.\u0d9c: \u0dca\u0d9c\u0dad\u0dd2\u0dda\u0db6\u0db1 \u0d9c\u0d9a\u0dca\u200d\u0dbb\u0dc4\u0dba\u0d9c\u0d9a\u0dd4\u0dc4\u0dca:?\u0d9c\u0dbb\u0db0\u0dba\u0dba \u0d9c\u0dbb\u0dc4\u0dba\u0d9c\u0db4\u0dca\u200d\u0dbb\u0db0\u0daf \u0dc0\u0dd4 \u0dca\u0d9c\u0db4\u0dad\u0dca\u0d9c\u0d9a\u0dbb \u0dc0\u0daf,\u0d9c\u0d8b\u0db4\u0d9a\u0dd4\u0dbd\u0db4\u0dad\u0dd2\u0d9c\u0dd2\u0dc3\u0dd2\u0d82\u0dca.\u0d9c\u0d92\u0d9c\u0dbb\u0db0\u0dba\u0dba \u0d9c\u0dbb\u0dc4\u0dba\u0d9c\u0db4\u0dca\u200d\u0dbb\u0db0\u0daf \u0dc0\u0dd4 \u0dca\u0d9c\u0dbb\u0dad\u0dd4\u0dbb\u0dd2\u0dca\u0d9c\u0d91\u0dca\u0dda\u0d9a\u0dda \u0dca\u0d9c\u0db4\u0dd3\u0dc3\u0daf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0d9c\u0dc0\u0dba\u0dda\u0dba\u0dca\u0d9c\u0db4\u0dad\u0dca\u0d9c\u0d9a\u0dbb \u0dc0\u0daf.\u0d9c\u0db4\u0dd3\u0dc3\u0daf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dd4 \u0dca\u0dda\u0dbb\u0dca,\u0d9c\u0dbb\u0dc4\u0dba\u0daf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dd4 \u0dca\u0dda\u0dbb\u0dca\u0d9c\u0dcf\u0dc4\u0db1\u0dca\u0d9c\u0db4\u0dca\u200d\u0dbb\u0db0\u0daf \u0d9c\u0dc0\u0dba\u0dda\u0dba\u0dca\u0d9c\u0dc3\u0dcf \u0daf\u0dcf \u0d9c\u0dc3\u0dcf\u0db7\u0daf\u0dc0\u0d9c\u0dc3\u0dcf\u0dc4\u0dca\u0dd2\u0dc3\u0dcf\u0d9c\u0dc0\u0dca\u0dda\u0dca.\u0d9c\u0dc3\u0dcf \u0daf\u0dcf \u0d9c\u0dc3\u0dcf\u0db7\u0daf\u0dc0\u0d9c\u0dc3\u0dcf\u0dc4\u0dca\u0dd2\u0dc3\u0dcf\u0d9c\u0dc0\u0dca\u0dda\u0dca\u0d9c\u0db4\u0dd3\u0dc3\u0daf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dd4 \u0d9c\u0dc3\u0dcf \u0d9c\u0dbb\u0dc4\u0dba\u0daf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dd4 \u0dca\u0dda\u0dbb\u0dca.\u0d9c\u0dc4 \u0daf\u0da0\u0daf\u0dca\u0dba\u0dc0\u0dd4 \u0dca\u0dda\u0dbb\u0dca\u0d9c\u0dd2\u0dc3\u0dcf\u0dbb\u0db1\u0dca\u0d9c\u0dd2\u0dc3\u0dba \u0dc0\u0dd2\u0dc3:\u0dba\u0daf\u0dbd\u0dba\u0d9a\u0d9c\u0dc3\u0dcf \u0daf\u0dcf \u0d9c\u0dc3\u0dcf\u0db7\u0daf\u0dc0\u0dca\u0d9c\u0dc3\u0dcf\u0dc4\u0dca\u0dd2\u0dc3\u0dcf\u0d9c\u0dc0\u0dca\u0dda\u0dca.\u0d9c\u0d91\u0dcf\u0dda\u0d9a\u0daf \u0d9c\u0dda\u0dc4\u0daf\u0d9a:\u0d9c\u0dda\u0dc0\u0dca\u0dda\u0dca?\u0d9c\u0d91\u0dca\u0d9c\u0db4\u0dd4 \u0dbb\u0dbd\u0dda\u0dba\u0d9a\u0dd4 \u0d9c\u0dc3\u0dcf\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab\u0d9c\u0db6\u0db1\u0dbd\u0dba\u0d9c\u0dc4\u0dd2\u0db8\u0dd2\u0d9c\u0dc0 \u0dc0\u0daf,\u0d9c\u0dbb\u0dc4\u0dba\u0daf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dd4 \u0d9c\u0db4\u0dad\u0dca\u0d9c\u0d9a\u0dbb\u0dca .\u0d9c\u0d92\u0d9c\u0dbb\u0dba\u0d9c\u0dbb\u0dad\u0dd4\u0dbb\u0dd2\u0dca\u0dc4\u0d9c\u0db4\u0dd3\u0dc3\u0daf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dd4 \u0d9c\u0db4\u0dad\u0dca\u0d9c\u0d9a\u0dbb \u0dc0\u0daf.\u0d9c\u0d92\u0d9c\u0dbb\u0dba\u0d9c\u0dbb\u0dad\u0dd4\u0dbb\u0dd2\u0dca\u0dc4\u0d9c\u0dd2\u0dc3\u0dba\u0daf\u0dbd\u0d9c\u0db4\u0dca\u200d\u0dbb\u0dc4\u0daf\u0dab\u0dba\u0dca\u0d9c\u0dc3\u0dcf \u0daf\u0dcf \u0d9c\u0dc3\u0dcf\u0db7\u0daf\u0dc0\u0d9c\u0db1\u0dd2\u0dda\u0dba\u0ddd\u0da2 \u0dba\u0d9c\u0d9a\u0dbb \u0dc0\u0daf.\u0d9c\u0d92\u0d9c\u0dd2\u0dc3\u0db0\u0dd2\u0dba \u0d9c\u0dbb\u0dd2\u0dc5\u0d9c\u0dda\u0dc4\u0dcf \u0d9c\u0db4\u0dca\u200d\u0dbb\u0da2\u0daf\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0daf\u0daf\u0dd3\u0d9c\u0d9a\u0dbb\u0dbd\u0daf\u0d9c\u0dad\u0dd2\u0dda\u0db6\u0db1 \u0dc0\u0daf.\u0d9c\u0dbb\u0dc4\u0dba\u0daf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0d9c\u0dcf \u0dad\u0dd4\u0dbb \u0dad\u0dca\u0d9c\u0dd2\u0dc3\u0dba\u0daf\u0dbd\u0d9c\u0db4\u0dca\u200d\u0dbb\u0dc4\u0daf\u0dab\u0dba\u0d9a \u0d9c\u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0d9c\u0dda\u0dc0\u0dca \u0d9c\u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0dca.\u0d9c\u0d92\u0d9c\u0dc0\u0daf\u0dda\u0dda\u0dc4\u0d9c\u0db4\u0dd3\u0dc3\u0daf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0d9c\u0dcf \u0dad\u0dd4\u0dbb \u0dad\u0dca\u0d9c\u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0d9c\u0dda\u0dc0\u0dca \u0d9c\u0d92\u0d9c\u0db4\u0dd3\u0dc3\u0dda\u0dda\u0d9c\u0d89\u0dca \u0d9c\u0dbb\u0da0\u0daf\u0dca\u0dba\u0dc0\u0dd4 \u0dca \u0dad\u0dca\u0d9c\u0dbb\u0dd2\u0dc5\u0d9c\u0dbb\u0dc0\u0dc3\u0dcf \u0daf\u0dc0\u0dca\u0d9c\u0dbd\u0db6\u0db1\u0daf\u0d9c\u0daf\u0dd3\u0dbd\u0daf\u0d9c\u0dad\u0dd2\u0dda\u0db6\u0db1 \u0dc0\u0daf.\u0d9c\u0dd2\u0dc3\u0dba \u0dc0\u0dd2\u0dc3:\u0dba\u0daf\u0dbd\u0dba\u0d9a\u0d9c\u0dc3\u0dcf \u0daf\u0dcf \u0d9c\u0dc3\u0dcf\u0db7\u0daf\u0dc0\u0d9c\u0dcf\u0dc4\u0db1\u0dca,\u0d9c\u0dbb\u0db0\u0dba\u0dba \u0d9c\u0d9a\u0daf\u0dca\u0dba\u0dba\u0dca\u0d9c\u0dd2\u0dc5\u0dd2\u0db6\u0db6\u0db1 \u0dc0\u0d9c\u0dad\u0dd3\u0dbb\u0dab\u0d9c\u0dbb\u0dca \u0daf\u0d9c\u0db4\u0dca\u200d\u0dbb\u0db0\u0daf \u0dcf\u0dc4\u0d9c\u0dc4\u0dab\u0dca\u0da9\u0da9\u0dbd\u0dba.\u0d9c\u0d92\u0d9c\u0dc4\u0dab\u0dca\u0da9\u0da9\u0dbd\u0dba,\u0d9c\u0dd2\u0dc3\u0dba \u0dc0\u0dd2\u0dc3:\u0dba\u0daf\u0dbd\u0dda\u0dda\u0d9c\u0dd2\u0d82\u0dba\u0daf\u0dd9\u0d9c\u0db4\u0dd3\u0dc3\u0daf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dd4 ,\u0d9c\u0dd2\u0d82\u0dba\u0daf\u0dd9\u0d9c\u0dbb\u0dc4\u0dba\u0daf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dd4 ,\u0d9c\u0dd2\u0d82\u0dba\u0daf\u0dd9\u0d9c\u0dda\u0da2\u0dba\u0dc2 \u0dc3\u0d9c\u0dc4 \u0daf\u0da0\u0daf\u0dca\u0dba\u0dc0\u0dd4 \u0d9c \u0daf\u0d9c\u0dc4 \u0daf\u0da0\u0daf\u0dca\u0dba\u0dc0\u0dd4 ,\u0d9c\u0db4\u0dd3\u0dc3\u0d9c\u0dc4\u0dab\u0dca\u0da9\u0da9\u0dbd\u0dba\u0d9c\u0dd2\u0dc3\u0dd2\u0d82\u0dca\u0d9c \u0dca\u0d9c\u0d9a\u0dbb \u0d9c\u0db4\u0dd3\u0dc3\u0dda\u0dda\u0d9c\u0dbb\u0dda \u0dca\u0d9c\u0dbb\u0da0\u0daf\u0dca\u0dba\u0dc0\u0dd4 \u0d9c\u0db1\u0dd2\u0dda\u0dba\u0ddd\u0da2 \u0dba\u0d9c\u0d9a\u0dbb \u0d9c\u0db1\u0dd2\u0dda\u0dba\u0ddd\u0dd2\u0dad\u0dcf\u0dba\u0dca\u0dda\u0dbb\u0dca\u0d9c\u0dc3\u0dcf\u0dc4\u0dca\u0dd2\u0dc3\u0dcf\u0d9c\u0dc0 \u0dc0\u0daf.\u0d9c\u0dda\u0dc4\u0dca \u0d9c\u0dda\u0dca\u0d9c\u0dc3\u0dcf\u0dc4\u0dda\u0dba\u0ddd\u0db0 \u0dba\u0d9c\u0dc4\u0d9f\u0dd2\u0dca\u0d9c\u0dbb\u0dd2\u0dc5\u0d9c\u0db4\u0dca\u200d\u0dbb\u0da2\u0daf\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0daf\u0daf\u0dd3\u0d9c\u0daf\u0dd2\u0dba\u0daf\u0dc0 \u0d9c\u0d91\u0dba\u0d9c\u0dda\u0dbb \u0dca \u0dbd\u0daf\u0d9c\u0dad\u0dd2\u0dda\u0db6\u0db1 \u0dc0\u0daf.\u0d9c"
  },
