u0dbd\u0dc3 \u0dc3\u0d9a\u0dc4\u0dcf \u0dd9\u0dd2\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db6\u0dbd\u0dba [\u0dad\u0dd2 \u0dd9\u0db6\u0da9\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0d9c\u0dda \u0db4\u0dd3\u0dca\u200d\u0dad\u0dd2\u0dba\u0d8b \u0d91\u0db1\u0dda Battery Energy Storage \u0dc3\u0dc4 Pumped Hydro Storage \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0d9a\u0dc0\u0dcf \u0daf\u0dd3\u0db8.\n\n\uf0b7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0d9c\u0dda\u0daf\u0dd3 \u0d9a\u0dbd\u0dca \u0d89\u0d9a\u0dd4\u0dad\u0dca \u0dd3\u0db8\u0db4 \u0db1\u0dd2\u0dba\u0dd2\u0dba\u0dad \u0db6\u0dbd\u0dcf\u0dd9\u0dcf\u0dba \u0dc3\u0dc4 \u0d85\u0db1\u0dcf\u0dd9\u0dad \u0db6\u0dbd\u0dba [\u0dad\u0dd2 \u0d89\u0dbd\u0dca\u0dd4\u0dc0\u0db8 \u0dc3\u0db4\u0dd4\u0dba\u0dcf\u0dbd\u0dd3\u0db8\u0db4 \u0d85\u0daf\u0dcf\u0dd9\u0dc0 \u0dad\u0dcf\u0db4 \u0db6\u0dbd\u0dcf\u0dd9\u0dcf\u0dba \u0d85\u0dc0\u0dba\u0dba \u0db1\u0dda \u0d92 \u0dc4\u0dba\u0dc4\u0dcf \u0dc3\u0dda\u0dc0\u0dcf\u0dc0\u0dcf\u0dc0\u0dd2\u0d9a \u0dc0\u0dcf\u0dba\u0dd4 \u0db6\u0dbd\u0dcf\u0dd9\u0dcf\u0dba \u0d89\u0daf\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db4 \u0d85\u0dc0\u0dba\u0dba \u0d9a\u0db4\u0dba\u0dd4\u0dad\u0dd4 \u0d9c\u0dba\u0daf\u0dd3\u0db8.\n\n\uf0b7 \u0daf\u0dd2\u0db1\u0db4 \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0da2\u0dbd \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0db6\u0dbd\u0dcf\u0dd9\u0dcf\u0dba\u0dc0\u0dbd \u0dc3\u0dda\u0dae\u0dcf\u0da7\u0db4\u0dad \u0dca\u200d\u0dcf\u0dbb\u0dd2\u0dad\u0dcf\u0dc0 \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dca\u200d\u0dba\u0dba\u0db1\u0dba\u0db1\u0dca\u0d9a \u0db1\u0dca\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8.\n\n(v) \u0d89\u0daf\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db4 \u0db1\u0dd2\u0dba\u0dd2\u0dba\u0dad \u0db6\u0dbd\u0dcf\u0dd9\u0dcf\u0dba \u0d9c\u0db6\u0dcf\u0d9c\u0dc4\u0dcf\u0db8\u0dba [ \u0db4\u0dd4\u0db1\u0dbb\u0dca\u0da2\u0db1\u0db1\u0dd3\u0dba \u0dd9\u0da7\u0dba\u0db4 \u0dc0\u0dd2\u0d9c\u0da7\u0dca. \u0dd6 \u0dbb\u0dca\u0dba \u0db6\u0dbd\u0dcf\u0dd9\u0dcf\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd4\u0d9b\u0dc0 \u0d91 [ \u0d9a\u0dba\u0db1 \u0d85\u0dad\u0dba \u0dc3\u0dd4\u0dd9\u0d82 \u0db6\u0dbd\u0dcf\u0dd9\u0dcf\u0dba \u0daf \u0dc3\u0dd2\u0dbd\u0d9a\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0da7\u0dba [ \u0db4\u0dd3\u0dca\u200d\u0dad\u0dd2\u0dba\u0db4 \u0d91 [ \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db4\u0d8b \u0d9a\u0dd4\u0da9\u0dcf \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0da7 \u0da2\u0dbd \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0db6\u0dbd\u0dcf\u0dd9\u0dcf\u0dba \u0dc4\u0dcf \u0da2\u0dd3\u0dc0 \u0dbb\u0dc0\u0dba \u0db6\u0dbd\u0dcf\u0dd9\u0dcf\u0dba \u0daf \u0d91 [ \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db4 \u0db6\u0dbd\u0dcf\u0d9c\u0db4\u0dcf\u0d9c\u0dba\u0dcf\u0dad\u0dca\u0dad\u0dd4 \u0d9c\u0d8b. \u0d85\u0dad\u0dd2\u0dbb\u0dd2 [\u0dad \u0db4\u0dd4\u0db1\u0dbb\u0dca\u0da2\u0db1\u0db1\u0dd3\u0dba \u0db6\u0dbd\u0dba [\u0dad\u0dd2\u0dba \u0dd9\u0db6\u0da9\u0dcf \u0d9a\u0dba \u0dc0\u0dcf\u0dc0\u0dd2\u0dad\u0dba\u0db4 \u0dd9\u0dd2\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db6\u0dbd\u0dba [\u0dad\u0dd2 \u0dd9\u0db6\u0da9\u0dcf \u0db4\u0dd3\u0dca\u200d\u0dad\u0dd2 \u0daf \u0d91 [ \u0d9c\u0d9a\u0d9c\u0dbb\u0dca. \u0db4\u0dd3\u0dca\u200d\u0dad\u0dd2\u0d9c\u0dda \u0dc3\u0dda\u0dae\u0dcf\u0dba\u0dd3\u0dad\u0dcf\u0dc0\u0d8b \u0db6\u0dbd\u0dba [\u0dad\u0dd2 \u0dc3\u0dd4\u0dba [\u0dd2\u0dad\u0dad\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0dcf\u0db4 \u0db6\u0dbd\u0dcf\u0dd9\u0dcf\u0dba \u0d89\u0daf\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db4 \u0db1\u0dd2\u0dba\u0dd2\u0dba\u0dad \u0dba.\n\n\u0dc3\u0db4\u0dc4\u0db1: \u0d9c\u0dda \u0da7\u0db4\u0dc5\u0dd2\u0db6\u0db3 \u0daf\u0dad\u0dca\u0dad \u0d87\u0dad\u0dd4\u0dd9\u0dad\u0dca 2025-2044 \u0daf\u0dd2\u0dd4\n\n\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0da2\u0db1\u0db1 \u0dc3\u0dd2\u0dbd\u0dd2\u0dc3\u0dda\u0d9c\u0db8 \u0dc3\u0db4\u0dd4\u0db4\u0dcf \u0dd9\u0dd2\u0db1\u0dd3\u0db8 \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 04 \u0db8\u0d9f\u0dd2\u0db1\u0dca\u0d9a \u0daf [\u0dc0\u0dcf \u0d87\u0dad. \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0dda 01\u0d8b 02\u0d8b 03 \u0dc3\u0dc4 04 \u0dca\u0db7\u0dcf\u0d9c\u0dad* \u0d9a\u0dba\u0dd2\u0dba.\n\n\u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0dc0\u0dbb\u0dca\u0dc2\u0dca\u0da8 \u0d9a\u0dd3\u0db4\u0dba \u0dad\u0dd4\u0dd9 \u0d89\u0daf\u0dd2 \u0d9c\u0d9a\u0d9c\u0dba\u0db1 \u0db6\u0dbd\u0dcf\u0dd9\u0dcf\u0dba \u0da7\u0db4\u0dc5\u0dd2\u0db6\u0db3 \u0dc3\u0dcf\u0dba\u0dcf\u0d82\u0dba\u0dba \u0db4\u0dc4\u0dad \u0daf [\u0dc0\u0dcf \u0d87\u0dad.\n\n(\u0d86) \u0d85\u0daf\u0dcf\u0dd9 \u0d9c\u0db1\u0dcf\u0d9c\u0d8b.\n\n\u0d9c\u0dd4 \u0dbb\u0dc0\u0dd3 \u0d9a\u0dd4\u0dab\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0dd9\u0dc4\u0dc3\u0dad\u0dcf (\u0bae\u0bbe\u0ba3\u0bcd\u0baa\u0bc1\u0bae\u0bbf\u0b95\u0bc1 \u0bb0\u0bb5\u0bbf \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95) (The Hon. Ravi Karunanayake) \u0dd9\u0dbb\u0dd4 \u0d9a\u0dae\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dd4\u0db8\u0db1\u0dd2\u0d8b \u0db8\u0d9c\u0dda \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0db1\u0dba \u0d85\u0dc4\u0db1\u0dca\u0d9a\u0db1 \u0d89\u0dc3\u0dda\u0d9c\u0dc3\u0dbd\u0dca\u0dbd\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9a\u0db1 \u0d95\u0db1\u0dd1\u0d8b \u0d9c\u0dda \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0db1\u0dba\u0db4 \u0dbd\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0da7\u0db4\u0dc5\u0dd2\u0dad\u0dd4\u0dba \u0dd9\u0dd2\u0db1. \u0d91 \u0d85\u0dc4\u0db4\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0db1 \u0d9c\u0d9a\u0dcf\u0db4\u0dc3\u0dda 5\u0d9a\u0dd2\u0db1\u0dca\u0d9a 4\u0d9a\u0db4\u0db8 \u0d85\u0daf\u0dcf\u0dd9\u0dc0 \u0da7\u0db4\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0d9a\u0d9c\u0db1\u0dca\u0d9a \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0dda\u0dc0\u0dbd. \u0d89\u0dad\u0dd2\u0db1\u0dca\u0d9a\u0d8b \u0d9c\u0db8\u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0db8\u0db4 \u0d85\u0dc4\u0db1\u0dca\u0d9a\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca\u0d9a \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0db1? \u0d9c\u0db8\u0dcf\u0d9a\u0daf\u0d8b \u0d85\u0da7\u0db4 \u0daf\u0db1\u0dca\u0d9a\u0d9c\u0db1\u0dca\u0d9a \u0db1\u0dd2\u0dc4\u0dd2\u0d8b \u0d92 \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0dda\u0dc0\u0dbd \u0dad\u0dd2\u0d9c\u0db6\u0db1\u0dca\u0d9a\u0d9c\u0db1\u0dca\u0d9a \u0d9c\u0db8\u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d9c\u0dda \u0dc0\u0dd2\u0d9a\u0dbb\u0dba\u0db4 \u0dc3\u0dad\u0dca\u0dad\u0dba \u0d9c\u0daf\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0d9a\u0d9c\u0db1\u0dca\u0d9a\u0d8b \u0dc3\u0dad\u0dca\u0dad\u0dba\u0dba \u0dc3\u0dc0\u0dcf\u0dd9\u0dad \u0d9a\u0dd9\u0dcf \u0dc0\u0d9c\u0dda\u0db8\u0dba\u0dd2."
