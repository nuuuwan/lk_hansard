\u0d9a \u0dc0 \u0db4\u0dd2[\u0dbd\u0dca \u0db6\u0dd2\u0dd2[\u0dca 2, 2]]\u0dd9- \u0dcf\u0dcf\u0db1\u0dd2[\u0d9a\u0dca \u0dc3\u0dd2\u0dda\u0dca\u200d \u0dc0\u0dd4\u0dda\u0dcf. \u0db1\u0dd2\u0da7\u0dcf\u0d9a\u0da7\u0dbd\u0db4 \u0db8\u0da9\u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0db6\u0dd2\u0dd2[\u0dca ]8 \u0dd9 \u0dcf\u0dcf\u0db1\u0dd2[\u0d9a\u0dca \u0dc0\u0dd4\u0dda\u0dcf. \u0db8\u0da7\u0dcf\u0da9\u0dca\u0dd4\u0d9f\u0dd2\u0dd2\u0da7\u0dbd\u0db4 \u0db8\u0da9\u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0db8\u0dd2\u0dd2[\u0dca 62\u0dd9 \u0dcf\u0dcf\u0db1\u0dd2[\u0d9a\u0dca \u0dc0\u0dd4\u0dda\u0dcf. [\u0da7\u0dd2\u0dad\u0dbd \u0db4\u0dcf\u0dd4\u0dc5\u0dd9\u0dda\u0da7\u0dbd \u0db8\u0da9\u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0db8\u0dd2\u0dd2[\u0dca 2, 75 \u0dd9 \u0dcf\u0dcf\u0db1\u0dd2[\u0d9a\u0dca \u0dc3\u0dd2\u0dda\u0dca\u200d \u0dc0\u0dd4\u0dda\u0dcf. \u0dd9\u0dca\u0dd2\u0dd9\u0dcf\u0dbb\u0dca\u0dbd\u0db8\u0dd2\u0dd9 \u0db6\u0dd2\u0dda\u0da7\u0dbd\u0db4 \u0db8\u0da9\u0dcf\u0dbd\u0dbb\u0dca\u0dbd \u0db8\u0dd2\u0dd2[\u0dca 824\u0dd9 \u0dcf\u0dcf\u0db1\u0dd2[\u0d9a\u0dca \u0dc3\u0dd2\u0dda\u0dca\u200d \u0db8\u0da7\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0dca\u0da7\u0dcf. \u0db8\u0db8 \u0dc0[ \u0d9a\u0dba\u0dbd \u0dcf\u0dcf\u0db1\u0dd2[\u0d9a\u0dca \u0db8\u0dca\u0dcf\u0db8\u0da7\u0dba\u0dd2. \u0db8\u0db8 \u0dc0[ \u0d85\u0db8 ( \u0dba\u0db4\u0db4 \u0dba\u0db1\u0dca\u0dad\u0dca \u0db4\u0dd4\u0dd4 \u0da7\u0db1\u0dca\u0dad \u0d86\u0dbb\u0dca\u0dbd\u0dd2\u0dd9 \u0dcf\u0dcf\u0db1\u0dd2[\u0d9a\u0dca \u0db8\u0dca\u0dcf\u0db8\u0da7\u0dba\u0dd2. \u0d92 \u0db1\u0dd2\u0d9a\u0dcf \u0d85\u0db4\u0dd2 \u0dcf\u0dd4\u0db8\u0db8 \u0dc0\u0ddd\u0db8 \u0dc0 \u0d91\u0dd9\u0dd4 \u0db8\u0da7\u0dbd\u0dcf \u0dba\u0db4 \u0db8\u0da7\u0dcf\u0da9\u0dca\u0d9f\u0db1\u0dca\u0dad\u0dca\u0db4 \u0d85\u0da7\u0dc1\u0dba \u0d85\u0da7\u0d9a\u0dda\u0dcf\u0dcf\u0da7\u0dd9 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dca\u0da8\u0db8\u0dad \u0db7\u0dd6\u0db8\u0dd2\u0dd9\u0dcf\u0da7 \u0db8\u0da7\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0