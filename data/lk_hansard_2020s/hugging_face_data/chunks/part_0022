u0d85\u0db8 ( \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0d85\u0db7\u0dd2\u0dbd\u0dcf\u0dc2\u0dca\u0da8[. \u0db8\u0dcf\u0dcf\u0dba\u0dd9\u0dda \u0dd9\u0dba\u0db1\u0dca\u0dad\u0dca \u0db8 \u0d9a\u0db8\u0dba\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0dca\u0dd4\u0dd2 \u0db1\u0dd2\u0d9a\u0dcf \u0db8\u0dcf\u0dcf\u0dba\u0dd9\u0dda \u0db8\u0dca\u0dcf\u0dd9\u0dba \u0dad\u0db1\u0dca\u0dad\u0dca\u0da7\u0dcf \u0db8\u0dca\u0dcf\u0db8\u0da7\u0dba\u0dd2. \u0dd9\u0dba\u0dca\u0da7\u0dcf \u0dca\u0dda, \u0db8\u0db8 \u0dc0\u0dad\u0dd4\u0dca \u0dad\u0db1\u0dca\u0dad\u0dca \u0da7\u0dda\u0dca\u0d9a\u0dca, \u0dad\u0dbd\u0d9a\u0dca\u0dd9\u0db8 \u0dc0\u0d9a\u0dca \u0dcf \u0db1\u0dca\u0dad\u0dca \u0db6\u0dd4\u0dd2\u0db8 \u0dd9\u0da7\u0dca\u0da7\u0dd2[\u0db4 \u0da7\u0da9\u0dcf \u0d92\u0dd9 \u0d85\u0db4\u0db4 \u0db4\u0dd4\u0dd4 \u0da7\u0db1\u0dca\u0dad.\n\n\u0dd4\u0db1\u0dca\u0dad \u0db8\u0da7\u0dbd\u0dcf \u0dd2\u0db8\u0db6\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad \u0db8\u0db8 \u0dc0\u0dcf\u0dd9\u0d9a\u0dca ? \u0db8\u0dda \u0d85[\u0db8 strategy \u0d91\u0dd9 \u0db8\u0db8 \u0dc0\u0dcf\u0dd9\u0d9a\u0dca ? \u0db8 \u0dc0\u0db8 \u0dc0 \u0db8\u0dda \u0dba\u0db8\u0da7\u0dca \u0da2\u0dca\u0dad\u0dcf\u0da7\u0db4 \u0d9a \u0d91\u0d9a\u0dca\u0dd9\u0dba\u0dd2 \u0db8\u0dda \u0dbb\u0dd3[\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad. \u0db8\u0dda\u0db8\u0da7\u0dcf\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0dad\u0db8 \u0dc3\u0db4\u0dcf[ \u0db8 \u0dc0\u0dcf\u0dbb\u0dca\u0dbd\u0da7[ \u0dad\u0db8 \u0dc0\u0dba\u0dd2 \u0dad\u0db8 \u0dc0\u0db1\u0dca\u0dad \u0db8\u0dcf\u0dcf\u0dc0 \u0db1\u0dd2\u0d9a\u0dcf \u0dad\u0db8 \u0dc0\u0db1\u0dca\u0dad\u0db8 \u0da7\u0dda\u0dca\u0db4 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0da7 \u0d9a \u0db8 \u0dc0\u0dcf\u0da7\u0db1\u0dca\u0dad\u0dca \u0d91\u0dd9. \u0d92\u0dd9 \u0db8\u0db1\u0dca\u0dad \u0da7\u0dc0 \u0dd9\u0dcf\u0dcf\u0dca\u0dcf[\u0dd9\u0dd4\u0db8 \u0dc0\u0db1\u0dd2 \u0db8\u0dbd\u0dca\u0dc3\u0dd2. \u0d92 \u0dbb\u0dd3[\u0db1\u0dca\u0dad\u0db8\u0db1\u0dca\u0dad, \u0d87 \u0d9a\u0dad values \u0da7\u0dd2\u0db1\u0