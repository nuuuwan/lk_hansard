3. \u0d91\u0db8 \u0d9c\u0dbb\u0dda\u0dc2\u0dca\u0da8\u0dda\u0db0\u0dcf\u0d9a\u0dbb\u0d9a\u0dba\u0da7 \u0db1\u0dca \u0d85\u0d82\u0d9a 77/2023 \u0dc4\u0dcf 88/2023 \u0daf\u0dba\u0db1 \u0db1\u0dca 2025.08.06 \u0daf\u0dd2\u0db1\u0dd2\u0dad\u0dd2\u0dc0 \u0db1\u0dd2\u0dc2\u0dca\u0da8\u0dda\u0db4\u0dca\u200d\u0dbb\u0dc0 \u0d9a\u0dba\u0db1 \u0dbd\u0daf \u0d85\u0dad\u0dba\u0d8b \u0d85\u0d82\u0d9a 78/2023 \u0dc4\u0dcf 95/2023 \u0daf\u0dba\u0db1 \u0db1\u0dca \u0d85\u0db1\u0dd4\u0dc0\u0d8b \u0d85\u0d82\u0d9a 2317 \u0dc4\u0dcf 2023.01.27 \u0daf\u0dd2\u0db1\u0dd2\u0dad\u0dd2 \u0dd9\u0dd2\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0d9c\u0d8b\u0daf\u0db1\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc0\u0dcf\u0dd9\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0daf\u0dd4\u0dda\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0db3\u0dd3\u0d9c\u0dda \u0db1\u0dd2\u0d9c\u0d8b\u0daf\u0db1\u0d9c\u0dda \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0d9a \u0d85\u0dba\u0daf\u0dd4\u0dda\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0d9a\u0d9c\u0dda \u0dc3\u0db4\u0dbb\u0dd2\u0db8 \u0dc0\u0dba\u0dc3 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 40 \u0dba\u0db1\u0dca\u0d9a\u0db1\u0d8b \u0dc0\u0dba\u0dc3 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 45 \u0daf [\u0dc0\u0dcf \u0d9c\u0db8\u0db8 \u0d85\u0dc0\u0dc3\u0dda\u0dae\u0dcf\u0dc0\u0db4 \u0db4\u0db8\u0da7 [ \u0dd3\u0db8\u0db8\u0dcf \u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0daf\u0dd3\u0dbb\u0dca\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0db4 \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dba \u0d87\u0dad.\n\n\u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0d91\u0db8 \u0d9c\u0dbb\u0dda\u0dc2\u0dca\u0da8\u0dda\u0db0\u0dcf\u0d9a\u0dbb\u0d9a\u0dba\u0da7 \u0db1\u0dca \u0d85\u0dc0\u0dc3\u0db1\u0dca\u0d9a \u0dc0\u0dd4\u0dc0\u0daf\u0d8b \u0d85\u0db7\u0dd2\u0dba\u0dcf\u0da0\u0db1\u0dcf\u0d9a\u0dbb\u0d9a\u0dba \u0da7\u0d9c\u0dda \u0db4\u0dc0\u0dad\u0dd2\u0db1 CA 92/2023 - writ - \u0db1\u0dca\u0d9c\u0d8b \u0d85\u0dc0\u0dc3\u0db1\u0dca\u0d9a \u0dad\u0dd3\u0dba\u0da7\u0dba [ \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0d9c\u0db1\u0dcf\u0db8\u0dd2\u0dad\u0