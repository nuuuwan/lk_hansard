    "chunk_text": "\u0d85\u0db4\u0da7 \u0d9a\u0dd2\u0dd9\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0daf\u0dda\u0d9a\u0dcf\u0db1\u0dca. \u0d85\u0db4\u0dd2 \u0daf\u0dda\u0dc1\u0db4\u0dcf\u0dbd\u0db1 \u0dd9\u0dba\u0dcf\u0db4\u0dcf\u0dc0\u0dd9\u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dd9\u0da7 \u0daf\u0dda \u0dc0\u0daf\u0dca) \u0dd9\u0dda brand \u0d91\u0d9a\u0dcf\u0d9a\u0dca \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dcf\u0dc0\u0daf\u0d9c\u0db1 \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf. \u0db1\u0dd2\u0dc4\u0dad\u0db8\u0dcf\u0dad\u0dd2 \u0dba \u0dd9\u0dcf\u0daf\u0dda\u0db8 \u0dd9\u0dda \u0dc3\u0dcf\u0d9a\u0dcf\u0da0\u0dca\u0da0\u0da1\u0dcf\u0dd9\u0d9a\u0dcf\u0da7 \u0dd2\u0da9 \u0daf \u0db1 \u0dd9\u0dda \u0dad\u0dd2\u0dad\u0dd2\u0d9c\u0dbb\u0dd4\u0d9a\u0dcf \u0d86\u0d9a\u0dcf\u0dd8\u0dad\u0dd2\u0dd9\u0d9a\u0dcf \u0dd9\u0dd0\u0da9 \u0d9a\u0dcf\u0dc0\u0db1 \u0dc4\u0dd0\u0db8 \u0d9a\u0dcf\u0dcf\u0dc0 \u0dd9\u0d9a\u0dca \u0daf\u0d9a\u0dcf\u0daf\u0dc0\u0dc4\u0dd2\u0db8 \u0d85\u0dd9\u0db0\u0dcf\u0db1\u0dd9 \u0daf\u0dd9\u0dcf\u0db8\u0dd4 \u0d9a\u0dcf\u0dc0\u0dbd\u0dcf \u0dba\u0d9a\u0dcf \u0dad\u0dd2\u0dad\u0dd2\u0d9c\u0dbb\u0dd4\u0d9a\u0dcf \u0dc0\u0dcf\u0db8\u0dd4\u0dd9\u0d9a\u0dca \u0dad\u0dd4\u0dc5\u0da7 \u0d9c\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0db1\u0dd2\u0dc0\u0dd2 \u0db7\u0dcf\u0dd9\u0dd9\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0daf\u0dad\u0dad\u0db8\u0db1\u0dd9\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc4 \u0dd9\u0dad\u0d9a\u0dca \u0dad\u0dd2\u0daf\u0dd9\u0db1 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca\u0daf\u0d9c\u0db1\u0dca \u0dc3\u0db8\u0db1\u0dca\u0dc0\u0dd2\u0dad \u0daf\u0dda\u0dc1\u0db4\u0dcf\u0dbd\u0db1 \u0dd9\u0dba\u0dcf\u0db4\u0dcf\u0dc0\u0dd9\u0d9a\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dd9\u0da7 \u0dad\u0db8\u0db1\u0dca \u0d85\u0db4 brand \u0daf\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca. \u0dba\u0d9a\u0dcf \u0dad\u0db8\u0db1\u0dca \"AKD\" \u0d9a\u0dd2\u0dd9\u0db1 \u0d85\u0d9a\u0dd4\u0dbb\u0dd4 \u0dad\u0dd4\u0daf\u0db1\u0db1\u0dca \u0d9a\u0dd2 \u0daf . \"AKD\" \u0d9a\u0dd2\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0db1\u0db8\u0d9a\u0dca \u0dc0\u0dd2\u0dad\u0dc0\u0d9a\u0dca \u0daf\u0db1\u0dcf\u0daf\u0dd9\u0db1\u0dca; \u0dba\u0d9a\u0dcf brand \u0d91\u0d9a\u0dcf\u0d9a\u0dca. \u0dba brand \u0d91\u0d9a\u0dcf \u0dad\u0db8\u0db1\u0dca \u0d85\u0db4\u0dd2 \u0dc4 \u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca. \u0dba\u0d9a\u0dcf \u0daf\u0dad\u0dad\u0db8\u0db1\u0dd9 \u0dc3\u0dc4\u0dd2\u0dad \u0da2\u0db1 \u0dc3\u0db8\u0dcf\u0da2\u0dd9\u0d9a\u0dca \u0db1\u0dd2\u0daf\u0dd9\u0ddd\u0da2\u0db1\u0dd9 \u0d9a\u0dcf\u0dc0\u0db1 brand \u0d91\u0d9a\u0dcf\u0d9a\u0dca \u0dba\u0d9a\u0dcf. \u0dc0\u0dd2\u0db1\u0dd2\u0dc0\u0dd2 \u0db7\u0dcf\u0dd9\u0dd9\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dd9\u0dcf\u0dd9\u0dd3\u0db1\u0dca \u0db1\u0dd2\u0daf\u0dd9\u0ddd\u0da2\u0db1\u0dd9 \u0d9a\u0dcf\u0dc0\u0db1 \u0da2\u0db1 \u0dc3\u0db8\u0dcf\u0da2\u0dd9 \u0db1\u0dd2\u0daf\u0dd9\u0ddd\u0da2\u0db1\u0dd9 \u0d9a\u0dcf\u0dc0\u0db1 brand \u0d91\u0d9a\u0dcf \u0dba\u0d9a\u0dcf. \u0dd9\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca \u0db1\u0dd2\u0daf\u0dd9\u0ddd\u0da2\u0db1\u0dd9 \u0d9a\u0dcf\u0dc0\u0db1 brand \u0d91\u0d9a\u0dcf \u0dba\u0d9a\u0dcf. \u0dba\u0d9a\u0dcf \u0dad\u0db8\u0db1\u0dca brand \u0d91\u0d9a\u0dcf.\n\n\u0dd0\u0db1\u0dca \u0d85 \u0dd9\u0dc3 \u0d9c\u0dad\u0dca\u0dad\u0dad\u0dca \u0d85 \u0dd9\u0daf\u0dc3\u0dae \u0dc0\u0dd2\u0daf\u0dc1\u0dae\u0dc2 \u0dc3\u0dcf\u0d9a\u0dcf\u0da0\u0dca\u0da0\u0da1\u0dcf\u0dd9\u0d9a\u0dca \u0daf\u0dd3\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0dcf \u0d85\u0dbb\u0dd4 \u0dc3\u0dd2\u0d82\u0dd9\u0dbb\u0dca\u0dbd\u0db0\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0db4\u0dad\u0db1\u0dca\u0daf\u0dda \u0d8b\u0db4\u0dd9\u0dcf\u0dc3\u0dd9 \u0dc3\u0dda\u0dd9\u0db1\u0dca\u0db0 \u0d9a\u0dcf\u0dcf\u0dc0 \u0dd9\u0da7 \u0d85 \u0dcf\u0dc5\u0dd9. \u0d91\u0dad\u0dd0\u0db1\u0daf\u0dd3\u0dad\u0dca \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0daf \u0d9a\u0dcf\u0dab\u0dca\u0da9\u0da9\u0dcf\u0dd9\u0dda \u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0d9a\u0dcf\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0dd2\u0db1\u0dca\u0db1\u0dd9\u0dcf \u0d85\u0dad\u0dd2\u0dad\u0dd2\u0d9a\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dd9\u0dcf\u0dd9\u0dd2\u0dd9\u0d9a\u0dcf\u0da7 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dd9 \u0d9c\u0dd0\u0da7 \u0d9c\u0dc4\u0db1\u0dca\u0db1. \u0d91\u0daf\u0dc4\u0db8 \u0d9a\u0dd2\u0dba\u0dbd\u0db8 \u0dc0\u0dd4\u0dd9\u0db8\u0db1\u0dcf\u0dd9\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0db4\u0dd2 \u0dad\u0dd2\u0dad\u0dba\u0db8\u0dca\u0dd6\u0dbd\u0dbd\u0dd9 \u0dad\u0dd2\u0dad\u0dd2\u0d9c\u0dbb\u0dd4\u0d9a\u0dcf \u0daf\u0dbd\u0dc3 \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dcf\u0dc0\u0db8\u0dd4. \u0daf\u0db8\u0dcf\u0d9a\u0dcf\u0d9a\u0dca \u0dad\u0dd2\u0daf\u0dd9\u0db1 \u0dca\u200d\u0dbb\u0dc1\u0dae\u0db1\u0dd9 \u0dad\u0dd2\u0dad\u0dd2\u0d9c\u0dbb\u0dd4\u0d9a\u0dcf \u0daf\u0dbd\u0dc3 \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dcf\u0dc5\u0dcf\u0db8? \u0d87\u0db1\u0dca \u0d91\u0daf\u0dc4\u0db8 \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1 \u0dd9\u0dd0\u0db4\u0dad? \u0d85\u0db4\u0dd2 \u0dc3\u0dd6 \u0dcf\u0db1\u0dda \u0dc0\u0dd2\u0db1\u0dd9\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dd9 \u0dad\u0dd2\u0dad\u0dd2\u0dd9\u0d9a\u0dcf\u0da7 \u0dd9\u0da7\u0dad\u0dca\u0dd9 \u0dd9\u0dd0\u0da9 \u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1.\n\n\u0dc4\u0dd0\u0dd9\u0dd0\u0db1\u0dca \u0daf\u0dda \"AKD\" \u0d9a\u0dd2\u0dd9\u0db1 brand \u0d91\u0d9a\u0dcf\u0da7 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dd9 \u0dc0\u0dd2\u0db0\u0dd2\u0dd9\u0da7 \u0d85\u0db4 \u0d8b\u0db4\u0dd9\u0dcf\u0daf\u0d9c\u0db1 \u0dad\u0dd2\u0daf\u0dd9\u0db1 \u0daf\u0dda \"AKD\" \u0d9a\u0dd2\u0dd9\u0db1 brand \u0d91\u0d9a\u0dcf\u0da7 \u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc0\u0dd2\u0dbb\u0dd4\u0dda\u0db0 \u0daf\u0dbd\u0dc3 \u0d85 \u0dcf\u0dad\u0dca\u0db8\u0d9a\u0dcf brand \u0d91\u0d9a\u0dcf\u0d9a\u0dca \u0db1\u0dd2\u0dbb\u0dca\u0dbd\u0db8\u0dcf \u0dd9 \u0d9a\u0dcf\u0dc0 \u0d9c\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0daf \u0d9a\u0dcf\u0dcf\u0da7\u0dd9\u0dad\u0dca \u0dd9\u0dd0\u0dc4\u0dd0. \u0d91\u0d9a\u0dcf \u0db1\u0db8\u0d9a\u0dcf\u0da7\u0dd9\u0dad\u0dca \u0d91\u0daf\u0dc4\u0db8 \u0daf \u0dd9\u0d9a\u0dca \u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1 \u0dd9\u0dd0\u0dc4\u0dd0. \u0daf\u0db8\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf\u0da7 \u0d9a\u0dcf\u0dc0\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dd9\u0db1\u0dca \u0daf\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dca\u0daf\u0db1\u0dca \u0daf\u0db4\u0dcf\u0daf\u0dd4 \u0d9a\u0dd4\u0dab\u0dd4"
  },
