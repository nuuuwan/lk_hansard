    "description": "Hansard of October 23, 2019",
    "url_metadata": "https://www.parliament.lk/en/business-of-parliament/hansards",
    "lang": "si-ta-en",
    "url_pdf": "https://www.parliament.lk/uploads/documents/hansard/1572429538021181.pdf",
