n\n861 862\n\n\u0db4\u0dcf0}\u0dd9E,\u001a\u0dc0\n\n\u0b86 \u0b95\u0bbf\u0bb0\u0bae\u0bbf\u001b) \u0bb5\u0017\u0b95\u0bbf\u0016\u0bb1\u0ba9. \u0ba8\u0bc0/\u0b958 \u0bc7\u0ba8\u0bb03\u0baf\u0bbe\u0b95 \u0bae\u001b\u0ba4\u0bbf\u0baf \u0b85\u0bb0\u0b9a\u0bbe/\u0b95\u001b\u0ba4\u0bbf6\u0bc8\u0b9f\u0baf \u0ba4\u0bbf\u0bc8\u0ba3 \u0b95\u0bb3/\u0b958 \u0b8a\u0b9f\u0bbe\u0b95 \u0b85#\u0ba4 \u0ba8\u0bbf\u0bb2/\u0b95\u0bc8\u0bb3\u001b \u0ba4/\u0b958 \u0bb5\u0b9a \u0baa5\u001b\u0ba4\u0bbf, \u0b8e/\u0b95;\u0bc8\u0b9f\u0baf \u0b87\u0ba9 \u0bb5\u0bbf\u0b95\u0bbf\u0ba4\u0bbe\u0b9a\u0bbe\u0bb0\u001b\u0bc8\u0ba4 \u0bae\u0bbe'\u0bb1\u0bbf\u0baf\u0bc8\u0bae \u0baa\u0ba4'0 \u0baa\u0bb2 *\u0baf'\u0b9a\u0bbf\u0b958 \u0b8e5\u001b) \u0bc6\u0b95\u0bbe>3\u0017 \u0b95\u0bbf\u0016\u0bb1\u0bc0\u0011\u0b958. \u0b86\u0b95\u0bc7\u0bb5, \u0b87#\u0ba4 \u0bb5\u0bbf\u0b9f\u0baf\u0018 \u0bc6\u0ba4\u0bbe\u0b9f\u0011\u0baa\u0bbe\u0b95 \u0b95\u0bb5\u0ba9\u0018 \u0b8e5 \u0b95 \u0bc7\u0bb5>5\u0018. \u0b92\u0bc7\u0bb0\u0bc6\u0baf\u0bbe\u0017 \u0bb5\u0bbf\u0b9f\u0baf\u0018 \u0bae25\u0018 \u0bc6\u0ba4\u0bb3\u0bbf\u0bb5\u0bbe\u0b95 \u0bb2 \u0baa5\u0b95\u0bbf\u0016\u0bb1). \u0b85\u0ba4\u0bbe\u0bb5), \u0b87#\u0ba4G \u0b9a\u0bbf/\u0b95\u0bb3\u001b \u0ba4\u0bc8\u0bb2\u0bb5\u0011\u0b958 \u0b862\u0b9a\u0bbf \u0bc6\u0b9aC\u0b95\u0bbf\u0016\u0bb1 \u0b87\u0bb2/\u0bc8\u0b95\u0baf\u0bbf+ \u0b8e/\u0b95;\u0bc8\u0b9f\u0baf \u0bae \u0b958 \u0bb5\u0bbe\u0bb4 *3\u0baf\u0bbe) \u0b8e\u0016\u0baa\u0ba4'0 \u0b87) \u0b92\u0017 \u0ba8+\u0bb2 \u0b89\u0ba4\u0bbe\u0bb0\u0ba3\u0bae\u0bbe\u0b95 \u0b87\u0017 \u0b95\u0bbf\u0016\u0bb1). \u0b8e/\u0b95;\u0bc8\u0b9f\u0baf \u0bae \u0b958 \u0b87#\u0ba4G \u0b9a\u0bbf/\u0b95\u0bb3\u001b \u0ba4\u0bc8\u0bb2\u0bb5\u0011\u0b95\u0bb3\u0bbf\u0016\u0b95\u0bc0$ \u0bb5\u0bbe\u0bb4 *3\u0baf\u0bbe) \u0b8e\u0016\u0baa) \u0b87#\u0ba4 \u0b92\u0017 \u0bc6\u0b9a\u0baf'\u0baa\u0bbe23\u0016O\u0bb2\u0018 \u0b89\u0bb2\u0b95\u0bb1\u0bbf#\u0ba4 \u0b89>\u0bc8\u0bae\u0baf\u0bbe\u0b95\u0bbf \u0b87\u0017 \u0b95\u0bbf\u0016\u0bb1). \u0ba8\u0bc0\u0ba4\u0bbf\u0bae\u0016\u0bb1 \u0b952\u0b9f\u0bc8\u0bb3\u0bc8\u0baf<\u0018 \u0bae\u0bc0\u0bb1\u0bbfG \u0bc6\u0b9a\u0baf'\u0baa2\u0b9f\u0bb5\u0011\u0b95; 0 \u0b8e\u0ba4\u0bbf\u0bb0\u0bbe\u0b95 \u0b87#\u0ba4 \u0b85\u0bb0\u0b9a\u0bbe/\u0b95\u0018 \u0b8e\u0016\u0ba9 \u0ba8\u0b9f\u0bb53 \u0bc8\u0b95\u0bc8\u0baf \u0b8e5 \u0b95 \u0bc7\u0baa\u0bbe\u0b95\u0bbf\u0016\u0bb1)? \u0b87#\u0ba4 \u0bc7\u0bb52\u0baa\u0bbe\u0bb3\u0011\u0b958 \u0b8e\u0016\u0ba9 \u0bc6\u0b9aC\u0baf \u0bc7\u0baa\u0bbe\u0b95\u0bbf\u0016\u0bb1\u0bbe\u0011\u0b958? \u0b86\u0b95\u0bc7\u0bb5, \u0b87#\u0ba4 \u0bb5\u0bbf\u0b9f\u0baf/\u0b958 \u0bc6\u0ba4\u0bbe\u0b9f\u0011\u0baa\u0bbe\u0b95 \u0ba8\u0b9f\u0bb53 \u0bc8\u0b95 \u0b8e5 \u0b95 \u0bc7\u0bb5>5\u0018. \u0bae\u0bc0>5\u0018 \u0b87\u0bc7\u0ba4\u0bc7\u0baa\u0bbe\u0016\u0bb1 \u0b9a\u0018\u0baa\u0bb5/\u0b958 \u0ba8\u0b9f 0\u0bc7\u0bae\u0baf\u0bbe\u0ba9\u0bbe+ \u0b8e\u0ba4\u0bbf\u0011\u0b95\u0bbe\u0bb2\u001b\u0ba4\u0bbf+ \u0baa\u0bbe\u0bbe\u0bbf\u0baf \u0bb5\u0bbf\u0bc8\u0bb3%\u0b95\u0bc8\u0bb3G \u0b9a#\u0ba4\u0bbf \u0b95 \u0bc7\u0bb5>3\u0bb5\u0017\u0018 \u0b8e\u00169 \u0b87#\u0ba4 \u0bc7\u0ba8\u0bb0\u001b\u0ba4\u0bbf+ \u0ba8\u0bbe\u0016 L\u0bb1\u0bbf \u0bc6\u0b95\u0bbe8\u0b95\u0bbf\u0016\u0bc7\u0bb1\u0016. \u0ba8\u0016\u0bb1\u0bbf."
