    "chunk_text": "\u026a\u0dd9\u0dc1\u0dda\u0dc2\u0dd9\u0dba\u01e6\u0db8 \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf \u0dc3\u0db8\u0d9f \u0d9c\u0dd0\u0da7 \u0d9c\u0dd0\u028f\u0dbd\u0dcf\u0250 \u026a\u0db0\u0dcf\u0dba\u0d9a \u0da2\u0db1\u0dcf\u01dd\u0db4\u01af \u0100\u0db8\u0dba \u01af\u0dd9\u0db6\u01e6\u0dd9\u01e6. \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf \u0100\u0db8\u0dba \u0dc3\u0dc4 \u0d91\u028f \u0db6\u0dbd\u0dad\u0dbd, \u0d86\u019c\u018d\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf\u0dd9\u0118 \u0db6\u0dbd\u0dad\u0dbd, \u0dd9\u0dc0\u0db1\u0db8 \u0dbb\u0da7\u00fa \u021d\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u01ae \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0db8\u0dc4 \u0d87\u0db8\u01af\u0dc0\u0dbb\u0dba\u0dcf \u0dc3\u01b1 \u0db6\u0dbd\u0dad\u0dbd \u0287\u0db8\u0dcf \u0d9a\u0dbb\u01e6\u0dd9\u01e6 \u0da2\u0db1\u0dcf\u01dd\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf\u0dd9\u0118 \u01e7\u0dd9\u0dba\u02a4\u014f\u0dad \u0d86\u019c\u018d\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf\u0250. \u0d91\u0db8 \u01e7\u0dc3\u0dcf \u026a\u0db0\u0dcf\u0dba\u0d9a \u0da2\u0db1\u0dcf\u01dd\u0db4\u01af \u01df\u0dbb\u0dba \u0d85\u0dd9\u0dc4\u02a4\u0286 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0db1\u023c \u0d92 \u0dc3\u0db8\u0d9f\u0db8 \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf \u0d85\u0dd9\u0dc4\u02a4\u0286 \u00fb\u025d\u0dd9\u023c \u0dd9\u0dba\u02a4\u0da2\u0db1\u0dcf\u0dc0\u01ae \u0dd9\u0d9c\u0dd9\u0db1\u01e6\u0db1\u0da7 \u0d95\u0db1\u0dd1. \u0d91\u0dd9\u0dc4\u0db8 \u0db1\u0dd0\u01ae\u0db1\u023c \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1\u0dc0 \u01b1\u0dc5 \u0dd9\u023c \u0218\u0298\u0db6\u0db3\u0dc0 \u021a\u029a\u0262 \u0dc3\u0dcf\u0d9a\u013c\u0da1\u0dcf\u0dc0\u00fa \u0d9a\u0dbb\u01e6\u0db1\u0da7 \u0d95\u0db1\u0dd1. \u0d92 \u0dc4\u0dd0\u0dbb \u0dd9\u01ca\u0dc1\u0db4\u0dcf\u0dbd\u0db1 \u0ddb\u0dc0\u0dbb\u0dba, \u0dd9\u0100\u02a4\u0db0\u0dba \u0db8\u0dad \u0db4\u0db8\u0dab\u00fa \u0dbb\u0da7\u0d9a \u021d\u01af\u0db4\u01ae\u01af, \u0dbb\u0da7\u0d9a \u0dc0\u0dd0\u0da9 \u0218\u0298\u0dd9\u0dc0\u0dc5 \u0dd9\u0dc4\u02a4 \u0d89\u01ce\u025c \u0d9c\u0db8\u0db1 \u01b0\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0db1\u023c, \u0d91\u0dc0\u0dd0\u01e7 \u0dbb\u0da7\u00fa \u0d89\u01e6\u0db1 \u028f\u0179\u01e6\u0db1 \u021a\u029a\u0dc0\u01e6 \u0dbb\u0da7\u00fa\u0daf? \u0dd9\u023c \u0d85\u0db4\u0dbb\u0dcf\u0db0\u0dba \u0dbb\u0da7\u0da7 \u0d9a\u0dbb\u01e6\u0db1\u0da7 \u0d91\u0db4\u0dcf \u00fb\u0dba\u0dbd\u0dcf \u0d85\u0218 \u0ddb\u0db8\u01b6\u0db4\u0dcf\u0dbd \u0286\u025c\u0dd9\u0dc3\u0dda\u0db1\u0da7 \u00fb\u0dba\u0db1\u0dc0\u0dcf, \u0dbb\u01e7\u0262 \u026a\u0100\u0db8\u0286\u0d82\u0dc4\u0da7 \u00fb\u0dba\u0db1\u0dc0\u0dcf, \u0d85\u01e9\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u01ce\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0da7 \u00fb\u0dba\u0db1\u0dc0\u0dcf. \u0dbb\u0da7 \u026a\u0db1\u0dcf\u0dc1 \u0d9a\u0dbb\u0dbd\u0dcf, \u0dbb\u0da7 \u0db1\u0dd0\u01af \u0d9a\u0dbb\u0dbd\u0dcf \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dd9\u024f\u01cf \u0dd9\u023c \u0d85\u0db4\u0dbb\u0dcf\u0db0\u0dba\u01ae \u0d9a\u0dbb\u01e6\u0db1\u0da7 \u0d91\u0db4\u0dcf. \u0db4\u0dbb\u01ce\u0db1 \u0db6\u0dc0 \u0daf\u0dd0\u0db1 \u0daf\u0dd0\u0db1 \u0dd9\u023c \u0d85\u0db4\u0dbb\u0dcf\u0db0\u0dba \u0d9a\u0dbb\u0dbd\u0dcf \u0dd9\u0d9c\u0daf\u0dbb \u0dba\u01e6\u0db1 \u0dc4\u0daf\u0db1\u0dc0\u0dcf. \u0dd9\u0d9c\u0daf\u0dbb \u0119\u028f\u0262\u0dbd\u0dcf \u0dd9\u0d9c\u02a5\u0dbb\u0dc0\u0dcf\u01e6\u026a\u0dad\u0dc0 \u0150\u0dc0\u01ae \u0dd9\u0dc0\u01e6\u0db1 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0db4\u025c\u0dc3\u0dbb\u0dba \u0dc4\u0daf\u0dcf \u0d9c\u01e6\u0db1\u0dc0\u0dcf \u023d\u0dc3, \u0d85\u0dc0\u0dc3\u0dcf\u0db1 \u0dd9\u0db8\u02a3\u0dd9\u0dc4\u02a3\u0dd9\u01ae\u01cf \u0db8\u0dc4 \u0da2\u0db1\u0dba\u0dcf\u0dd9\u0118 \u0dc1\u0dcf\u0db4\u0dba\u0da7 \u0dbd\u00fa \u0dd9\u0dc0\u01e6\u0db1\u0da7 \u0d91\u0db4\u0dcf \u00fb\u0dba\u0db1 \u0d89\u0262\u0264\u0db8 \u0d85\u0218 \u0dd9\u023c \u0db1\u0dcf\u0dba\u0d9a\u0dba\u01e6\u0dd9\u0d9c\u01e6 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\n\n\u0dd9\u0db6\u02a3\u0dd9\u0dc4\u02a3\u0db8 \u0dc3\u0dca\u01b1\u01af\u0250.\n\n\u0d9c\u025e \u01e7\u0dd9\u0dba\u02a4\u0da2\u0dca\u200d\u0dba \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0db4\u01af\u01b1\u0db8\u01e7, \u0db8\u01e6\u01b6\u0dc0\u025e\u01e6\u0dd9\u0118 \u0dc0\u0dd0\u017b\u0217 \u01cf\u0db8\u0db1\u0dcf \u0dc0\u0dd0\u018b \u00fb\u025d\u0db8 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6, \u0d86\u019c\u018d\u0dc0 \u01e7\u0dd9\u0dba\u02a4\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0d85\u01de\u00fa\u0dc2\u0dab \u0db8\u01e6\u01b6\u0dc0\u025e\u01e6\u0da7 \u0dbd\u00fa\u0dc2 \u0dd9\u0daf\u0d9a\u0d9a \u01cf\u0db8\u0db1\u0dcf\u0dc0\u00fa \u0dd9\u0daf\u01e6\u0db1 \u0d9a\u0dd0\u022a\u0db1\u0178 \u0db4\u01b5\u0d9a\u0dcf \u0d91\u0d9a\u00fa \u0dd9\u0db1\u02a3\u0dd9\u0dc0\u0250, \u0d9a\u0dd0\u022a\u0db1\u0178 \u0db4\u01b5\u0d9a\u0dcf \u01b1\u0db1\u00fa \u0dd9\u0118\u01e6\u0db1 \u0dd9\u023c \u0d86\u019c\u018d\u0dc0 \u0d9a\u0da7\u0252\u01b1 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d92 \u0d9c\u0dd0\u0db1 \u0d85\u0218 \u0d9a\u0db1\u0d9c\u0dcf\u017b \u0dd9\u0dc0\u0db1\u0dc0\u0dcf. \u0db1\u023f\u01ae, \u0d85\u0daf \u0dd9\u0dc0\u0db1\u0d9a\u023c \u0dd9\u023c \u0d8b\u01ca\u0dd9\u0d9d\u02a4\u0dc2\u0dab \u0d9a\u0dbb\u0db1 \u01e7\u0dbd\u0db0\u0dcf\u025c\u01e6\u0dd9\u0118 \u0d9c\u0dd0\u0da7\u0265 \u0dd9\u0dc0\u01e9\u0dd9\u0dc0\u01e6 \u0d91\u0d9a\u0db8 \u0d91\u0d9a \u0d9a\u0dd0\u022a\u0db1\u0178 \u0db4\u01b5\u0d9a\u0dcf\u0dc0\u00fa\u0dc0\u01ae \u0dd9\u0118\u01e6\u0db1 \u0dd9\u023c \u0d86\u019c\u018d\u0dc0\u0da7 \u021a\u029a\u0dc0\u01e6\u0d9a\u0db8\u00fa \u0dbd\u0dd0\u0dd9\u0db6\u01e6\u0dd9\u0db1\u01ae \u0db1\u0dd0\u0dc4\u0dd0; \u0d92 \u0dd9\u0dc0\u01e9\u0dd9\u0dc0\u01e6 \u0d8b\u01ae\u0dad\u0dbb \u0dd9\u0daf\u01e6\u0db1 \u0d9a\u026c\u025e\u0dc0\u01ae \u0db6\u0dd0\u01fd\u0dbd\u0dcf\u01ae \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0218 \u0d92 \u0218\u0298\u0db6\u0db3\u0dc0 \u0d9a\u0db1\u0d9c\u0dcf\u017b\u0dc0 \u0db4\u0dc5 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\n\n\u0d9c\u025e \u01e7\u0dd9\u0dba\u02a4\u0da2\u0dca\u200d\u0dba \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0db4\u01af\u01b1\u0db8\u01e7, \u0d92 \u0dc0\u0dcf\u0dd9\u0118\u0db8 \u0d85\u0daf \u0dc3\u0dc0\u0dc3 3.00\u0da7 \u026a\u0dd9\u0dc1\u0dda\u0dc2 \u0d9a\u0dd0\u022a\u0db1\u0178 \u025a\u0dc3\u0dca\u026b\u0db8\u00fa \u0d9a\u0dd0\u0db3\u0dc0\u0dbd\u0dcf \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf \u00fb\u0dba\u0dbd\u0dcf \u0dd9\u023c \u0dd9\u0dc0\u0dbd\u0dcf\u0dd9\u0269 \u0d85\u0db4\u0da7 \u0d86\u0dbb\u0d82\u013d \u0dd9\u0dc0\u0db1\u0dc0\u0dcf. \u0d91\u0dd9\u0dc3\u0dda \u025a\u0dc3\u0dca\u0dd9\u0dc0\u01e6\u0dd9\u01e6 \u026a\u0dd9\u0dc1\u0dda\u0dc2\u0dd9\u0dba\u01e6\u0db8\n\n739 740\n\n\u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1\u0dc0"
  },
