    "chunk_text": "\u0218\u0298\u0d9c\u01e6\u0db1\u0dc0\u0dcf \u0db1\u023c, \u0d92 \u023f\u0daf\u0dbd \u0d91\u0d9a \u0dc3\u0dd0\u0dd9\u0259 \u0dd9\u0d9c \u0dc0\u0db1\u0dc0\u0dcf\u0daf, \u0db1\u0dd0\u01ae\u0db1\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0dd9\u0daf\u0d9a\u0d9a\u0da7 \u0dd9\u0d9c\u0dc0\u0db1\u0dc0\u0dcf\u0daf \u00fb\u0dba\u0db1 \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0dc0\u0dd8\u01ae\u01b0\u0dba \u0dc3\u023d\u01af\u0dc0\u0dbd \u0dba\u023c\u00fb\u0286 \u0db1\u0db8\u0dca\u200d\u0dba\u0275\u0263\u0db7\u0dcf\u0dc0\u0dba\u00fa \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf \u00fb\u0dba\u0dbd\u0dcf \u0d94\u026c\u01e6 \u00fb\u0269\u0dc0\u0dcf. \u0dd9\u023c \u01b0\u01e6\u01d0\u0dc0 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0d9a\u0dbb\u01e6\u0db1 \u0dd9\u0d9a\u02a3\u0dad\u0dbb\u023c \u023f\u0daf\u0dbd\u00fa \u0dba\u0db1\u0dc0\u0dcf\u0daf \u00fb\u0dba\u0dbd\u0dcf \u0db8\u0db8 \u0d87\u0291\u0dc0\u0dcf. \u0d94\u026c\u01e6 \u00fb\u0269\u0dc0\u0dcf, \"\u023f\u0daf\u0dbd\u00fa \u0dba\u0db1\u0dc0\u0dcf, \u0d92 \u023f\u0daf\u0dbd \u0dd9\u0d9a\u02a3\u0db4\u0db8\u0dab\u0daf \u00fb\u0dba\u0dbd\u0dcf \u00fb\u0dba\u01e6\u0db1 \u0dd9\u01ae\u0dd9\u0dbb\u01e6\u0dd9\u01e6 \u0db1\u0dd0\u0dc4\u0dd0, \u0db1\u023f\u01ae, \u0d92\u0d9a \u0d91\u0d9a\u0db4\u0dcf\u0dbb\u0da7 \u0d86\u019c\u018d\u0dc0\u0da7 \u026a\u0dc1\u0dcf\u0dbd \u0dc0\u0dd0\u0dba \u0db6\u0dbb\u00fa \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0d91\u0db1\u0dc0\u0dcf \u0db1\u023c, \u023f\u0daf\u0262 \u0dbd\u0dd0\u0dd9\u0db6\u0db1 \u026a\u01dd\u0dba \u0d85\u01e9\u0dc0 \u0db6\u0dbd\u0dbd\u0dcf \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0dd9\u0daf\u0d9a\u0d9a\u0da7 \u026c\u0dab\u01ae \u0db7\u0dcf\u0dbb \u0d9c\u01e6\u0db1 \u0dbd\u0dd1\u0dc3\u0dca\u01af\u0250\" \u00fb\u0dba\u0dbd\u0dcf. \u0d87\u01ae\u0dad\u0da7\u0db8 \u0d9c\u01ae\u0dd9\u0dad\u02a3\u01ae, \u0dd9\u023c \u0dc0\u0dd8\u01ae\u01b0\u0dba \u0dc3\u023d\u01af \u0d9a\u0da9\u0dcf\u0d9a\u0217\u0db4\u0262\u0d9a\u0dcf\u025d \u026a\u01dd\u0dba\u0da7, \u0dad\u0259\u0da2\u0db1\u0dcf\u01ae\u0db8\u0d9a\u0dc0 \u0dc4\u0dd0\u0286\u0dd9\u0dbb\u0db1 \u0d92\u0dc0\u0dcf \u0dd9\u0db1\u02a3\u0dd9\u0dc0\u0250. \u0dd9\u023c\u0dc0\u0dcf\u0dd9\u024f \u0d89\u0dd9\u0d9c\u0db1 \u0d9c\u01ae\u0dad \u023d\u01e7\u0dc3\u0dca\u0288 \u0dd9\u01e6, \u0d89\u01e6\u0dd9\u01e6. \u0d92 \u01e7\u0dc3\u0dcf \u0dd9\u023c \u0dc0\u0dd0\u017b\u0217 \u026a\u0dc2\u0db8\u0dad\u0dcf\u0dc0 \u026a\u0dc3\u01fe\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dc4\u0dcf\u0db8 \u0db8\u0dd0\u01ce\u0dc4\u01ae \u0dd9\u0dc0\u01e6\u0db1, \u0d9a\u0dd0\u022a\u0db1\u0178 \u0db4\u01b5\u0d9a\u0dcf\u0dc0\u00fa \u0daf\u0db8\u0dbd\u0dcf, \u0dd9\u023c \u021d\u0dc1\u0dca\u0db1\u0dba \u026a\u0dc3\u0db3\u0db1\u0dc0\u0dcf \u00fb\u0dba\u0db1 \u0dc3\u0dc4\u01af\u0d9a\u0dba \u0d94\u026c\u01e6\u0da7 \u0dbd\u0db6\u0dcf \u0dd9\u0daf\u01e6\u0db1. \u0d92 \u0dc0\u0dcf\u0dd9\u0118\u0db8, \u0d94\u026c\u01e6\u0da7 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u028f\u023d\u0d9a\u0db8 \u0dbd\u0db6\u0dcf \u01cf\u0dbd\u0dcf, \u0d94\u026c\u01e6\u0dd9\u0118 \u0dc0\u0dd0\u017b\u0217 \u026a\u0dc2\u0db8\u0dad\u0dcf \u026a\u0dc3\u0db3\u01e6\u0db1 \u00fb\u0dba\u0db1 \u0db6\u0dbd \u00fb\u025d\u0db8 \u0dad\u0db8\u0250 \u0240\u0263\u0d9a \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0d85\u0218 \u0d86\u019c\u018d\u0dc0\u0da7 \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u01e6\u0dd9\u01e6.\n\n\u0d8b\u01ca\u0dd9\u0d9d\u02a4\u0dc2\u0dab\u0dba\u00fa \u0dc3\u0d82\u026a\u0db0\u0dcf\u0db1\u0dba \u0d9a\u0dbb \u01af\u022c\u019f \u0db6\u0dc0 \u0d85\u0218 \u0daf\u0dd0\u00fa\u0d9a\u0dcf. \u0dc3\u0dbb\u0dc3\u026a \u0d85\u0db1\u0db0\u0dca\u200d\u0dba\u0dba\u0db1 \u0dd9\u0dc3\u0dda\u0dc0\u0d9a\u0dba\u01e6 \u00fb\u0dba\u01e6\u0dd9\u01e6, \u0dbb\u0dd9\u0178 \u0dc3\u0dbb\u0dc3\u026a \u0db4\u01ca\u0db0\u01af\u0dba \u0dba\u0dae\u0dcf\u0dc0\u01ae \u0d9a\u0dbb \u0d9c\u01e6\u0db1 \u0dc0\u0dcf\u0dd9\u0118\u0db8, \u0d91\u0dba \u0dc4\u025c\u0dba\u0dcf\u0d9a\u0dcf\u0dbb\u0dc0, \u0100\u0db8\u0dc0\u01ae\u0dc0 \u0db4\u0dc0\u01ae\u0dc0\u0dcf\u0dd9\u0d9c\u0db1 \u0dba\u01e6\u0db1 \u0daf\u0dd0\u0dc0\u0dd0\u01e6\u0dad \u0dd9\u0dc0\u0dd9\u0dc4\u0dc3 \u0db8\u0dc4\u01e6\u0286\u0dba\u00fa \u0daf\u0dbb\u0db1 \u0218\u025c\u0dc3\u00fa. \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0269 \u01af\u0dd9\u0db6\u0db1 \u0dc3\u0dbb\u0dc3\u026a \u0d9c\u01ae\u0dad\u0dcf\u0db8, \u0d92\u0dc0\u0dcf\u0dd9\u024f \u0d85\u0db1\u0db0\u0dca\u200d\u0dba\u0dba\u0db1 \u0dd9\u0dc3\u0dda\u0dc0\u0d9a\u0dba\u01e6 \u026a\u0dc1\u0dcf\u0dbd \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0\u00fa \u0286\u0179\u0db1\u0dc0\u0dcf. \u0dd9\u023c \u0d85\u0dba\u0dd9\u0118 \u0288\u029a \u0dd9\u0dc3\u0dda\u0dc0\u0d9a\u0dba\u0dcf\u0dd9\u0118 \u0286\u0da7 \u0db4\u025c\u0db4\u0dcf\u0dbd\u0db1 \u0d85\u0d82\u0dc1\u0dd9\u024f \u01e7\u0dbd\u0db0\u0dcf\u025c\u0dba\u0dcf \u0daf\u00fa\u0dc0\u0dcf \u0db8 \u026a\u0dc1\u0dcf\u0dbd \u0d9a\u0dcf\u0259\u0dba\u0db7\u0dcf\u0dbb\u0dba\u00fa \u0d9a\u0dbb\u0db1\u0dc0\u0dcf.\n\n\u0d9c\u025e \u01e7\u0dd9\u0dba\u02a4\u0da2\u0dca\u200d\u0dba \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0db4\u01af\u01b1\u0db8\u01e7, \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0dd9\u0dc3\u0dda\u0dc0\u0dd9\u024f MN - 20 \u00fb\u0dba\u0db1 \u0dc0\u0dd0\u017b\u0217 \u0dad\u0dbd\u0dd9\u024f\u0250 \u0dd9\u023c \u0d85\u0dba \u0218\u028f\u017b\u0dc0\u0dcf \u01af\u022c\u0dd9\u019c. \u0db8\u0db8 \u0daf\u01e6\u0db1\u0dcf \u026a\u01dd\u0dba\u0da7, \u0d92 \u0d85\u0dba\u0da7 \u025e\u0218\u0dba\u0262 16,000\u0d9a \u0db4\u0db8\u0dab \u0d85\u0dc0\u0db8 \u0240\u0263\u0d9a \u0dc0\u0dd0\u017b\u0db4\u00fa \u0dbd\u0dd0\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0dbb\u0da2\u0dd9\u024f \u0dd9\u0dc3\u0dda\u0dc0\u0d9a\u0dba\u01e6\u0da7 \u0dbd\u0dd0\u0dd9\u0db6\u0db1 \u0d85\u0dd9\u0db1\u0d9a\u0dd4\u01ae \u01cf\u0db8\u0db1\u0dcf \u0dd9\u023c \u0d85\u0dba\u0da7 \u0dbd\u0dd0\u0dd9\u0db6\u01e6\u0dd9\u01e6 \u0db1\u0dd0\u0dc4\u0dd0. \u0dd9\u023c \u0dbb\u0da2\u0dba 2016\u01cf \u0dd9\u0d9c\u0db1 \u0d86 \u0dc0\u0dd0\u017b\u0217 \u0da0\u0100\u0dd9\u0262\u0d9b \u0d85\u01e9\u0dc0, \u0d92 \u0d85\u0dba\u0dd9\u0118 \u0dd9\u0279\u0dda\u019d 8\u00fa \u0d85\u018d \u0d9a\u0dbb \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u00fb\u0dba\u01e6\u0dd9\u01e6, \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dca\u200d\u0dba \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0dd9\u0dc3\u0dda\u0dc0\u0dd9\u024f 20 \u00fb\u0dba\u0db1 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dd9\u024f \u0286\u0179 \u0dd9\u023c \u0d85\u0dba \u0daf\u0dd0\u01e6 \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dca\u200d\u0dba \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0dd9\u0dc3\u0dda\u0dc0\u0dd9\u024f 12 \u00fb\u0dba\u0db1 \u0dad\u0dd0\u0db1\u0da7 \u0dd9\u0d9c\u0db1\u0dd0\u01ae \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0dd9\u0dc3\u0dda\u0dc0\u0d9a\u0dba\u01e6\u0dd9\u0118 \u0dc0\u0dd0\u018b \u026d \u0dc0\u0dd0\u017b\u0db4\u0da7 \u0dc3\u025c\u0dbd\u0db1 \u0db4\u025c\u01ce \u0dd9\u023c \u0d85\u0dba\u0dd9\u0118 \u0dc0\u0dd0\u017b\u0217 \u0dc0\u0dd0\u018b \u0dd9\u0dc0\u0dbd\u0dcf\u01ae \u0db1\u0dd0\u0dc4\u0dd0. \u0dc3\u0dbb\u0dc3\u026a\u0dc0\u0dbd \u0286\u0179\u0db1 \u0dd9\u023c \u0dd9\u0dc3\u0dda\u0dc0\u0d9a \u0218\u025c\u0dc3\u0da7 \u0d85\u0daf \u026a\u0dc1\u0dcf\u0dbd \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0150\u0dc0\u0db1 \u0db6\u0dbb \u0daf\u0dd0\u01e7\u0dbd\u0dcf \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0daf \u0dd9\u023c \u0dbb\u0dd9\u0178 \u0d86\u0259\u01c2\u0d9a\u0dba \u0d87\u01b1\u029a\u0dc0 \u0dc4\u0dd0\u0db8 \u00fa\u0dd9\u0dc2\u0dda\u01b4\u0dba\u0d9a\u0db8 \u01af\u0dd9\u0db6\u0db1 \u0d9a\u0da9\u0dcf \u0dc0\u0dd0\u017a\u0db8\u01ae \u0d91\u00fa\u0d9a, \u0150\u0dc0\u0db1 \u0db6\u0dbb \u0dc0\u0dd0\u018b \u0dd9\u0dc0\u0dbd\u0dcf \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d89\u0dad\u0dcf\u0db8 \u01d0\u00fb\u01e6 \u0dad\u0db8\u0250 \u0d9a\u0dcf\u0dbd\u0dba \u0d9c\u0dad \u0d9a\u0dbb\u01e6\u0dd9\u01e6. \u0dc3\u0dbb\u0dc3\u026a \u0dd9\u0dc3\u0dda\u0dc0\u0d9a\u0dba\u01e9\u01ae \u0d91\u0dc0\u01e6 \u0dad\u01ae\u01ae\u0dc0\u0dba\u0d9a \u0dad\u0db8\u0250 \u0d89\u01e6\u0dd9\u01e6."
  },
