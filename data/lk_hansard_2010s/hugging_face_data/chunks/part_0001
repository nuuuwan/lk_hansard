af \u0dd9\u0dc0'\u0dd9'? \"\u0dd9*' \u0dd9\u0dbb\u0005\u0dc0*\" >\u0dba'\u0dd9' \u0db8\u0dcf \u0081\u0dad\u0db1 %\u0006\u0dba\u0da7 \u0d85\u0daf \u000e \u0dbaf h+\u0dba\u0db1 50\u0d9a \u0db4\u0db8\u0dab \u0dc0:\u0db1\u0dcf\u0d9a\u0db8; Z\u0dd9\u0db6\u0db1 \u0dc0\u0dcf\u0dc4\u0db1\u0dba;.\n\n\u00a5\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u00d8\u0daa \u0d9c\u000e \u0db8'-,\u0db8H, \u0db8\u0dd9\" \u0dba\u0dcf H\u0dd9\u0dba\u0005\u0da2\u0db1\u0dba \u0d9a\u0dd9\u0dc5\u0016 01\u0db8\u0dcf\u0dd9\u0dc0\u0005 \u0db6)\u0da9\u0dcf\u0dbb\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd0ZH\u0dba Z\u0db4\u0018Z\u0d9c\u000e\u0d9a\u0dc0, \u0dd9\u0d9ck\u0dbb\u0dc0\u0dcf'%\u0dad \u0dd9l\u0dc1\u0db4\u0dcf\u0dbd\u0db1 \u0db1\u0dcf\u007f\u0d9a\u0dcf\u0dc0; %\u0006\u0dba\u0da7 H\u0dd9\u0dba\u0005\u0da2\u0db1\u0dba \u0d9a\u0dc5\n\n485 486\n\n2019 \u0dc3\u0dd08\u0dad\u0dd0\u0012\u0db6* 17\n\n\u00a5\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u00d8\u0daa \u0d9c\u000e \u0db8'-,\u0db8H, \u0db8\u0dcf \u0dd9\u0012 \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1 \u0dd9\u0db8x\u0dd9\u0dc4x\u0dd9\u0018\u0018 \u0db8\u0dd9\" \u0d87 \u0dd9\u0011 \u0dd9\u0db6\u0005\u0012\u0db6 \u0d9a\u0dd1+ Z\u0dd9\u0db6\u0db1\u0dc0\u0dcf. 2009 \u0db8\u0dcf*, \u0db8\u0dcf\u0dc3\u0dd9M 10\u0dc0\u0db1 \u0daf\u0dcf \u0dd9\u0d9cx\u0da9 :\u0dba \u00b9\u0012\u0db8\u0dcf y\u0dc3\u0dca+\u0012 \u0dd9l\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0da7 \u0d91f\u0dbd \u0089 \u0d91f\u00bf\u00bf\u0d8a \u0dc3\u0d82%\u0db0\u0dcf\u0db1\u0dd9M \u0d85\u0dc0\u0dc3\u0dcf\u0db1 \u0db8\u0dbb\u0dcf\u0dd9\u0d9c\u0db1 \u0db8\u0dd0\u0dd9\u0dbb\u0db1 \u0dd9\u0db6\u0005\u0012\u0db6 \u0dc4\u0dcf\u0dbb\u0dba\u0da7 \u0dc4\u0080 \u0dd9\u0dc0\u0dbd\u0dcf \u0db8\u0db8 \\\u0db1 21; \u0da2\u0dcfZ\u0d9a \u0dd9\u0dbb\u0005\u0dc4\u0dd9f 0:\u0dba\u0dcf. \u0d92 \u0dc0\u0dcf\u0dd9\"\u0db8, \u0db8\u0db8 %\u0dd9l\u0dc1\u0d9c\u0dad \u0dd9\u0dc0\u0dbd\u0dcf -\u0d95\u0dc3\u0dca\u0dd9\u000f+\u0dba\u0dcf\u0dc0\u0da7 \u0093\u0081f\u0dbd\u0dcf- Z\u0d9a\u0dcf\u0dbb \u0dbd\u0dd0E\u0dc0\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u007f, \u0d86)d\u0dd9g \u0dc3f+ \u0d92 \u0dc3\u0db3\u0dc4\u0dcf a'\u0dd9' \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0db8 \u0db8\u0dd9\" \u0dc3f+\u0dc0+'\u0db8 \u0d95\u0dc3\u0dca\u0dd9\u000f+\u0dba\u0dcf\u0dc0\u0da7\u0018 \u0093\u0081f\u0dbd\u0dcf Z\u0d9a\u0dcf\u0dbb \u0dbd\u0db6\u0dcf\u0dd9\u0d9c\u0db1 Z\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0dd9\u0db6\u0005\u0012\u0db6 \u000eF \u0d91\u0dc0\u0dd0H \u0086\u0d9c\u0dba; \u0dd9\u0012 \u0dbb\u0da7 ,\u0dc5 ZE\u0dab\u0dcf. \u0dbb\u0da7 \u0d9a\u0da9\u0dcf \u0dc0\u0dd0:\u0dbd\u0dcf, \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0db6\u0dd9\u0dba' \u00c2\u0dbb\u0dcf'\u0dad \u0dd9\u0dc0\u0dbd\u0dcf 0: \u0d92 \u0086\u0d9c\u0dd9\u0dba' \u0dbb\u0da7 \u0dd9\u00a7\u0dbb\u0dcf \u0d9c\u0018 \u0db1\u0dcf\u0dba\u0d9a\u0dba\u0dcf \u0dc0\u0db1 \u0081\u0da7\u008a \u0da2\u0db1\u0dcf\u0006\u0db4Z \u0db8\u0081'\u0daf \u0dbb\u0dcf\u0da2\u0db4;\u0dc2 \u0db8\u0dd0Z,\u0db8\u0dcf\u0018 \u0dd9\u0012 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9g3 \u0d85 \u0d9a\u0dd8\u0dad\u0dd9g3\u0dc0 0\u0081\u0db4\u0018 \u0d9a\u0dbb'\u0db1 \u0d95\u0db1\u0dd1.\n\n\u00a5\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u00d8\u0daa \u0d9c\u000e \u0db8'-,\u0db8H, \u0db8\u0dcf %\u0dc1\u0dca\u0dc0\u0dcf\u0dc3 \u0d9a\u0dbb\u0db1 \u0dd9\u0daf\u0dba; Z\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0d85\u0db4 \u0d89Z\u0dc4\u0dcf\u0dc3\u0dba \u0dc4\u0dcf\u0dbbh', \\\u0093' \\\u0d9c\u0da7\u0db8 \u0d89Z\u0dc4\u0dcf\u0dc3\u0dba\u0da7 \u0d87\u00d1f\u0dbd \\\u0087 \u0d9a\u0dbbh' 0:\u0dd9\u0dbax\u0018, \u0dd9\u0012 \u0dbb\u0dd9\u00a4 a; %\u00db\u0db1 \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0dad\u0dc0\u0018 \u0d9a\u0dcf\u0dbd\u0dba; -\u0d89\\1\u0dba\u0da7\u0018- a; %\u00db\u0db1 \u0d91\u0d9a \u0dc0\u0dc5;\u0dc0'\u0db1 \u0d85\u0db4\u0da7 \u0db6\u0dd0\u0dc4\u0dd0. \u0d92 H\u0dc3\u0dcf \u0d85\u0db4 \u0daf\u0dd0' \u0d9a\u0dc5 \u0086, \u0dd9\u0daf\u0dba; Z\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0daf#F \u0d85\u00bc\u0d9a\u0dcf\u0dc0 \u0dc0*\u0dab \u0dd9\u00c5\u0daf\u0dc0\u0dcf\u0daf\u0dd9\u0dba' \u0d91_\u0dba\u0da7 \u0d91\u0db1\u0dd9\u0d9ax\u0da7 \u0dd9\u0db1f\u0dc3' \u0db8\u0dd0'\u0dd9\u0da9\u0dbd\u0dcf\u0018, \u0d91\u0dc6\u0dca.\u0da9\u00a7+g \u0daf ;\u0dbd\u0dcf*; >\u0dba\u0db1 \u0080a \u0da2\u0dcfZ\u0d9a \u0da2\u0db1\u0dcf\u0006\u0db4Z,\u0db8\u0dcf\u0018 \u0d91\u0d9a, \u0dd9\u0dc0\u0dbd\u0dcf Truth and Reconciliation Commission \u0d91\u0d9a; \u0db4\u0018 \u0d9a\u0dbb\u0dbd\u0dcf, \u0dad\u0db8 \u0dad\u0db8' \u0d9a\u0dc5 \u0dd9\u0daf\u0dc0f \u0d92 Truth and Reconciliation Commission \u0d91\u0d9a\u0da7 \u0d87%f\u0dbd\u0dcf >\u0dba'\u0db1 \u0d9a\u0dcf\u0da7\u0018 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dbd\u0db6\u0dcf a'\u0db1\u0dcf. \u0db8\u0dcf \u0081\u0dad\u0db1 %\u0006\u0dba\u0da7, %\u0dd9\u0dc1\u0016\u0dc2\u0dd9\u0dba'\u0db8 \u0da2\u0dcfZ\u0d9a \u0dc3\u0d82\u0081\u00db\u0dba\u0dcf\u0dc0 \u0dc0\u0dcf\u0dd9\"\u0db8 \u0dd9l\u0dc1\u0db4\u0dcf\u0dbd\u0db1 \u0dc3\u0d82\u0081\u00db\u0dba\u0dcf\u0dc0 \u0dd9\u0dc0G\u0dd9\u0dc0G\u0018 \u0d85\u0dd98 \u0dbb\u0da7\u0da7\u0018 \u0d91\u0dc0\u0dd0H \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0; \u0dbd\u0db6\u0dcf a'\u0dd9\u0db1x\u0018 \u0d89\u0dad\u0dcf\u0db8 \u0dc0:\u0db1\u0dc0\u0dcf. \u0d89Z\u0dc4\u0dcf\u0dc3\u0dd9M \u0d9a\u0dc5 0\u0dbaN \u0dc0\u0dd0\u0dbb\\ \u0db4\u0dd0\u0018\u0dad\u0d9a\u0da7 \u0daf\u0db8\u0dbd\u0dcf, \u0dd9\u0dc4\u0da7 \u0daf\u0dc0\u0dd9\u0dc3\u0016 \u0d89\u0db3\u0dbd\u0dcf \u0dd9\u0012 \u0dbb\u0da7 \u0d85N\u0018 \u0d9c\u0db8\u0db1; \u0d9a\u0dbb\u0dcf \u0dd9\u0d9c\u0db1\u0dba'\u0db1 \u0d85\u0dc0\u0dc1J \u0d9a\u0dbb\u0db1 \u00d4Z \u0dc3\u0012\u0db4\u0dcf\u0daf\u0db1\u0dba >?\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0db4 \u0dd9\u0db4\u0dc5 \u0d9c\u0dd0\u0dd9\u0dc3'\u0db1 \u0d95\u0db1\u0dd1\u0dba >\u0dba\u0db1 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf\u0dc0 \u0db4;\u0dc2 \u0dd9\u00c5\u0daf\u0dba>' \u0dd9\u0dadx\u0dbb\u0dc0, \u0d89\u0dad\u0dcf\u0db8 \u0dd9\u0d9ck\u0dbb\u0dc0\u0dd9\u0dba' \u0086,\u0dc0 \u0db8\u0dcf \u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf."
