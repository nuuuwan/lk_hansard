    "chunk_size_bytes": 3328,
    "chunk_text": "\u0d86\u0259\u01c2\u0d9a \u0dc0\u0dc1\u0dd9\u0dba\u01e9\u01ae, \u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dd8\u01af\u0d9a \u0dc0\u0dc1\u0dd9\u0dba\u01e9\u01ae, \u0252\u0daf\u0db8\u0dba \u0dc0\u0dc1\u0dd9\u0dba\u01e9\u01ae, \u0dc0\u0dcf\u019d\u0da2 \u0dc0\u0dc1\u0dd9\u0dba\u01e9\u01ae \u0d85\u0263\u0dba\u0dcf \u0dc0\u0dd0\u0daf\u0d9c\u01ae\u0d9a\u0db8\u00fa \u0daf\u0dbb\u0dbd\u0dcf \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0dbb\u0da2 \u0d9a\u0dcf\u0dbd\u0dd9\u024f \u026a\u0dad\u0dbb\u00fa \u0dd9\u0db1\u02a3\u0dd9\u0dc0\u0250, \u0d85\u0dd9\u0217 \u0dbb\u0dd9\u0178 \u0dbb\u0da2\u0dd9\u024f \u0dc0\u0dd0\u0da9 \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dc0 \u01af\u022c\u019f \u0d9a\u0dcf\u0dbd\u0dd9\u024f\u01ae \u0db6\u0dbb \u0dc0\u0dd0\u0da9 \u00fb\u025d\u0db8\u0da7, \u0db4\u0dcf\u0dbb\u0dc0\u0262 \u0dc4\u0daf\u01e6\u0db1, \u0d9a\u01ff\u0dc0\u0dbd \u0dc0\u0dd0\u0da9 \u0d9a\u0dbb\u01e6\u0db1 \u0dbb\u0da2\u0dd9\u024f \u0d85\u0263 \u0dd9\u0dba\u02a3\u0daf\u0dcf\u0dd9\u0d9c\u0db1 \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u00fa\u0dad\u0dbb\u0dcf \u0d9a\u0dcf\u0dbd\u0dba\u00fa \u0dc0\u0dd0\u0da9 \u0d9a\u0dc5\u0dcf\u0da7 \u0db4\u0dc3\u0dca\u0dd9\u0dc3\u0dda \u0d92 \u0d85\u0263\u01e6\u0dd9\u0118 \u0dc0\u0dba\u0dc3 \u0d85\u01e9\u0dc0 \u026a\u0279\u0dcf\u0db8\u0d9c\u01e6\u0dc0\u01e6\u0db1 \u0d95\u0db1\u0dd1 \u026c\u0dab\u0dcf\u0db8 \u0d92 \u0d85\u0263 \u0dd9\u0dc0\u01e6\u0dd9\u01ca\u0286 \u0d9a\u0dbb\u0dbd\u0dcf \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0d85\u0263 \u0dd9\u023c \u0dbb\u0dd9\u0178 \u0286\u0179 \u021d\u0237 \u0db4\u01e6\u01af\u0dba \u0dbd\u0db6\u0dcf\u0dd9\u0d9c\u0db1 \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0dd9\u023c, \u0d85\u0263\u01e7 \u0218\u0298\u0db6\u0db3 \u0d89\u01af\u0dc4\u0dcf\u0dc3\u0dd9\u024f \u0286\u01d0\u026b\u023c \u0db8\u0dcf\u0dbd\u0dcf\u0dc0\u0250.\n\n\u0dc3\u01b1\u01e6 \u0dc0\u01ae\u0dd9\u01ae \u028f\u0da7\u021a \u0d85\u0263\u01ae \u0dd9\u0dc0\u01e6\u0dd9\u01ca\u0286 \u0d9a\u0dbb\u0dbd\u0dcf \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0d92\u0d9a 1999-2000 \u0dd9\u0dc4\u02a4 2004 \u0d9a\u0dcf\u0dbd\u0dd9\u024f \u0286\u01d0\u0dd9\u0dc0\u0dbd\u0dcf \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0db8\u0db8 \u0daf\u01e6\u0db1 \u026a\u01dd\u0dba\u0da7 \u018b\u00fa\u0dc3\u01e6 \u0daf\u0dd1\u0dbd \u00fb\u0dba\u0db1 \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dcf\u025c\u0d9a\u0dba\u0dcf \u0dad\u0db8\u0250 \u0d92 \u0d85\u0dc0\u0dc3\u0dcf\u0db1 \u0d85\u0263\u0dba\u0dcf \u0d85\u0dbb\u0dd9\u0d9c\u0db1 \u01af\u0dd9\u0db6\u01e6\u0dd9\u01e6. \u0d92 \u0d85\u0263\u0dba\u0dcf \u0d85\u0daf\u01ae \u0150\u0dc0\u01b1\u01e6 \u0d85\u0dad\u0dbb \u0d89\u01e6\u0db1\u0dc0\u0dcf.\n\n\u0dbb\u01ae\u0db1\u021a\u0dbb \u0dc3\u0db8\u01e6 \u0dd9\u01ca\u0dc0\u0dcf\u0dbd\u0dba, \u027c \u0daf\u0dc5\u0daf\u0dcf \u0db8\u0dcf\u0298\u0d9c\u0dcf\u0dc0, \u0dd9\u0daf\u026a\u01e9\u0dc0\u0dbb \u0dd9\u01ca\u0dc0\u0dcf\u0dbd\u0dba, \u01af\u0dc3\u0dca\u0dc3\u0db8\u0dc4\u0dcf\u0dbb\u0dcf\u0db8 \u0db4\u01e6\u0dc3\u0dbd, \u0d85\u0265\u01ae\u01e9\u0dc0\u0dbb \u0d87\u01b1\u029a \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0269 \u021b\u0da2\u01e8\u0dba \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dc0\u0dbd\u0da7\u01ae \u0d85\u0263 \u0d87\u01b1\u01e6 146\u00fa \u0db4\u0db8\u0dab \u0dbd\u0db6\u0dcf \u01cf\u0dbd\u0dcf \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf.\n\n\u0d9c\u025e \u0d87\u0db8\u01af\u01b1\u0db8\u01e7, \u0d85\u0263\u0dd9\u0dba\u0d9a\u0dd4\u0da7 \u01ce\u0db1\u0d9a\u0da7 \u0dc0\u01b1\u0dbb \u0264\u0da7\u0259 200\u00fa, 250\u00fa \u0db4\u0db8\u0dab \u0d95\u0db1\u0dd1. \u0d85\u0263\u0dd9\u0dba\u0d9a\u0dd4 \u0daf\u0dc0\u0dc3\u0d9a\u0da7 \u00fb \u0dd9\u0dbd\u02a4 100\u01ae, 300\u01ae \u0d85\u0dad\u0dbb \u0d86\u0dc4\u0dcf\u0dbb \u021d\u0db8\u0dcf\u0dab\u0dba\u00fa \u0d9c\u01e6\u0db1\u0dc0\u0dcf \u00fb\u0dba\u0dbd\u0dcf \u0dad\u0db8\u0250 \u0d85\u0db4\u0da7 \u0daf\u0dd0\u0db1\u0d9c\u01e6\u0db1 \u0dbd\u0dd0\u022a\u0dbd\u0dcf \u01af\u0dd9\u0db6\u01e6\u0dd9\u01e6. \u0d85\u0263\u01e6\u0dd9\u0118 \u0d9c\u0db8\u01e6 \u0dbb\u0da7\u0dcf\u0dc0\u01ae \u0d92\u0d9a\u0dcf\u0d9a\u0dcf\u025c\u0250. \u0d85\u0263\u01e6\u0da7 \u0218\u025c\u0286\u01d0 \u0da2\u0dbd\u0dba \u0dc0\u0dcf\u0dd9\u0118\u0db8 \u0218\u025c\u0286\u01d0 \u0d86\u0dc4\u0dcf\u0dbb\u01ae \u0d95\u0db1\u0dd1. \u0dbd\u01ff \u0d9a\u0dd0\u0dbd\u0dd1\u0dc0\u0dbd \u0286\u0179\u0db1 \u0dc4\u0dbb\u0d9a\u0dd4\u01e6 \u021d\u0db8\u0dcf\u0dab\u0dba \u0dc0\u0dd0\u018b \u026b\u0db8 \u01e7\u0dc3\u0dcf \u0d85\u0263\u01e6\u0dd9\u0118 \u0d86\u0dc4\u0dcf\u0dbb \u0179\u0d9a, \u0dc0\u01b1\u0dbb \u0179\u0d9a \u0d85\u0db4\u026a\u01b4\u026b\u0dd9\u0db8\u01e6 \u0d85\u0263\u01e6\u0da7 \u0dc4\u0dbb\u0d9a\u0dd4\u01e6 \u021d\u0dc1\u0dca\u0db1\u0dba\u00fa \u0dd9\u0dc0\u0dbd\u0dcf \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u026a\u0262\u0db4\u01ae\u01b1 \u0dc0\u0db1\u0dd9\u024f \u0d85\u0263 \u0db1\u0dd0\u0dc4\u0dd0. \u0dd9\u0db8\u02a3\u0d9a\u0daf, \u0d85\u0263\u01e6\u0da7 \u0dd9\u0db6\u02a3\u01e6\u0db1 \u0dc0\u01b1\u0dbb\n\n817 818\n\n[\u0d9c\u025e \u0288\u0dc3\u01e6\u0dad \u021a\u0d82\u013d\u01e7\u0dbd\u0dd9\u023c \u0db8\u0dc4\u0dad\u0dcf]\n\n2019 \u0dc3\u0dd0\u0217\u0dad\u0dd0\u023c\u0db6\u0259 20\n\n\u0db1\u0dd0\u01af \u01e7\u0dc3\u0dcf \u0d92 \u0d85\u0263 \u0d94\u00fa\u0dd9\u0d9a\u02a4\u0db8 \u021a\u01ae\u0dad\u0dbd\u0db8\u0da7, \u0d86\u0db1\u0db8\u018d\u0dc0\u0da7 \u0dc3\u0d82\u0100\u0db8\u0dab\u0dba \u0dd9\u0dc0\u0dbd\u0dcf \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u026a\u0dd9\u0dc1\u0dda\u0dc2\u0dd9\u0dba\u01e6\u0db8 \u0d9a\u025e\u0dc0\u0dbd\u0d9c\u0dc3\u0dca\u0dc0\u0dd0\u0dc0 \u0dc0\u0dd0\u01e7 \u021d\u0dd9\u01ca\u0dc1\u0dc0\u0dbd \u0dd9\u023c \u0d85\u0263 \u023d\u01e7\u0dc3\u0dca \u0d9c\u0dd0\u017b\u0db8 \u0d87\u01af\u0dd9\u0dc0\u0dbd\u0dcf \u01af\u0dd9\u0db6\u01e6\u0dd9\u01e6 \u0d92 \u01e7\u0dc3\u0dcf\u0250. \u0d85\u0dd9\u0217 \u0dc3\u01e6\u01ce\u01ae \u0dc3\u0db8\u0dbb\u0286\u0d82\u0dc4 \u0db8\u01e6\u01b6\u01b1\u0db8\u0dcf \u00fb\u0269\u0dc0\u0dcf \u0dc0\u0dcf\u0dd9\u0118 \u0d92\u0d9a\u0da7 \u026a\u0dc3\u01ff\u0db8\u00fa \u0dc4\u0dd0\u0179\u0dba\u0da7 \u0d85\u0263\u01e6\u0da7 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0d86\u0dc4\u0dcf\u0dbb \u0d85\u0218 \u0dc3\u0db4\u0dba\u01e6\u0db1 \u0d95\u0db1\u0dd1. \u0dc0\u0dd0\u0269\u0dc0\u0dbd \u0dc0\u0dd0\u0dd9\u0dc0\u0db1 \u0dad\u0dd8\u0dab \u0dc0\u0259\u0d9c\u0dba\u00fa \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf, \"\u0dd9\u0db6\u025e\" \u00fb\u0dba\u0dbd\u0dcf. \u0d85\u01e6\u0db1 \u0d92 \u0dc0\u0dcf\u0dd9\u0118 \u0dd9\u01ca\u0dc0\u0262 \u0dc3\u01b1\u01e6 \u0d9c\u0dd0\u0dc0\u0dd9\u0dc3\u0db1 \u0dc0\u0dd0\u0269 \u0d86\u027b\u0dad\u0dc0 \u0dc0\u0dc0\u01e6\u0db1 \u021a\u029a\u0dc0\u01e6 \u0db1\u023c \u0d85\u0263-\u023d\u01e7\u0dc3\u0dca \u0d9c\u0dd0\u017b\u0db8 \u0dba\u023c \u0dad\u0dcf\u00fa \u01d0\u0dbb\u0d9a\u0da7 \u0d85\u0dc0\u0db8 \u0d9a\u0dbb\u0d9c\u01e6\u0db1 \u0dc4\u0dd0\u00fb\u0dba\u0dcf\u0dc0 \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf \u00fb\u0dba\u0dbd\u0dcf \u0db4\u0259\u0dd9\u024f\u0dc2\u0dab \u0d85\u01e9\u0dc0 \u0d85\u0db4\u0da7 \u0dd9\u0dad\u02a3\u0dbb\u01b1\u025e \u0dbd\u0dd0\u022a\u0dbd\u0dcf \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf."
  },
