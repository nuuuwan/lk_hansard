    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7 \u0d8b\u01ca\u0db0\u0db8\u0db1\u0dba \u01ce\u0dc4\u0dcf \u0db6\u0dd0\u0265\u0dd9\u0dc0\u02a3\u01ae, \u0d8b\u01ca\u0db0\u0db8\u0db1\u0dba \u0286\u0dba\u0dba\u0da7 4\u01ae, 6\u01ae \u0d85\u0dad\u0dbb \u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbb\u0db7\u0dcf\u0dc0\u0dba\u0d9a\u0da7 \u0d91\u0db1 \u0db6\u0dc0 \u0dd9\u0db4\u0dd9\u0db1\u0db1\u0dc0\u0dcf. \u0d85\u0db4\u0db1\u0dba\u0db1\u0dba -\u0d86\u0db1\u0dba\u0db1\u0dba \u0db6\u0dd0\u0265\u0dd9\u0dc0\u02a3\u01ae, \u0d85\u0db4\u0db1\u0dba\u0db1\u0dba-\u0d86\u0db1\u0dba\u0db1\u0dba \u0d85\u0dad\u0dbb \u0db4\u0dbb\u0dad\u0dbb\u0dd9\u024f \u0dd9\u0dc0\u0db1\u0dc3\u00fa \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf\u0dba \u00fb\u0dba\u0db1 \u0d91\u0d9a\u01ae \u0dd9\u023c \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269\u01cf \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb\u01e6\u0db1 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0250. \u0db4\u0dcf\u0dc3\u0dca\u0d9a\u0dd4 \u021d\u0dc4\u0dcf\u0dbb\u0dba \u0dc0\u0dd0\u01e7 \u0dd9\u0daf\u0dba\u00fa \u026c\u0dab\u0dcf\u0db8 \u0d89\u00fa\u0db8\u01e7\u01e6\u0db8 \u0dd9\u0db8\u02a3\u0db1\u0dc0\u0dcf\u0daf \u0dd9\u0dc0\u01e6\u0dd9\u01e6? \u026a\u0dd9\u01ca\u0274\u0d9a\u0dba\u01e6 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0da7 \u0db4\u0dd0\u023d\u019e\u0db8 \u0d91\u0d9a\u0dc0\u0dbb \u0d85\u018d \u0dd9\u0dc0\u0db1\u0dc0\u0dcf. \u0d92\u0d9a \u0dd9\u0dbd\u02a4\u0d9a\u0dd9\u024f \u0d95\u0db1\u0dd1\u0db8 \u0dad\u0dd0\u0db1\u0d9a \u0286\u01d0 \u0dd9\u0dc0\u0db1 \u0dd9\u0daf\u0dba\u00fa. \u0db1\u023f\u01ae, \u0db8\u0db8 \u0dd9\u023c \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0daf\u01e6\u0dc0\u01e6\u0db1\u0da7 \u0d9a\u0dd0\u0db8\u0dd0\u01af\u0250, \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u01e6 \u0db4\u0dd0\u023d\u019e\u0dd9\u023c \u01ce\u0252\u019f\u0dc0\u00fa \u01af\u0dd9\u0db6\u0db1 \u0db6\u0dc0. \u027c\u0dbd\u01e6\u0d9a\u01e6 \u011b\u0dc0\u01e6 \u0dd9\u0dc3\u0dda\u0dc0\u0dd9\u0dba\u01e6 \u0d91\u0db1 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u01e6\u0dd9\u0118 \u021d\u0db8\u0dcf\u0dab\u0dba \u0dd9\u023c \u0db8\u0dcf\u0dc3 \u0d9c\u0dab\u0db1\u0dcf\u0dc0 \u01b1\u0dc5\u01cf \u0dc0\u0dd0\u018b \u0dd9\u0dc0\u023d\u01e6 \u0db4\u0dc0\u01af\u0db1\u0dc0\u0dcf.\n\n\u023f\u0daf\u0262 \u0dc0\u0259\u0dc2\u0dba \u0d85\u0dc0\u0dc3\u01e6 \u0dd9\u0dc0\u0db1\u0dd9\u0d9a\u02a3\u0da7, \u0dd9\u023c \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u026a\u0dc0\u0dcf\u0daf \u0d9a\u0dbb\u0dbd\u0dcf \u0dd9\u0db1\u02a3\u0dc0\u0dd0\u023c\u0db6\u0259 \u0db8\u0dcf\u0dc3\u0dd9\u024f \u0dd9\u0dc4\u02a4 \u0dd9\u0daf\u0dc3\u0dd0\u023c\u0db6\u0259 \u0db8\u0dcf\u0dc3\u0dd9\u024f \u023f\u0dbd \u0d85\u0dba \u0dc0\u0dd0\u0dba \u0dc3\u023c\u0db8\u0dad \u0d9a\u0dbb\u0d9c\u01e6\u0db1\u0dcf \u0db6\u0dc0 \u0d94\u0db6\u01b1\u0db8\u01e6\u0dbd\u0dcf \u0daf\u01e6\u0db1\u0dc0\u0dcf. \u0d92\u0d9a \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dca\u200d\u0dba\u0dd9\u0dba\u01e6 \u0d9a\u0dbb\u0db1 \u0dd9\u0daf\u0dba\u00fa. \u0db1\u023f\u01ae, \u0dd9\u0db8\u0dc0\u0dbb \u0da2\u0db1\u0dcf\u01dd\u0db4\u01af\u0dc0\u0dbb\u0dab\u0dba \u0db4\u0dd0\u0dc0\u0dd0\u01ae\u026b\u0db8 \u0dd9\u0dc4\u0dda\u01b1\u0dd9\u0d9a\u02a3\u0da7 \u0dd9\u0d9c\u0db1\u0250 \u0d85\u0db4\u0da7 \u0dd9\u023c \u0d85\u01b1\u025e \u0dc3\u023c\u0db8\u0dad \u0119\u019f\u0db8 \u0dc4\u0dd0\u0179\u0dba\u0da7 \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u01e6\u0db1 \u0286\u01d0 \u0dd9\u0dc0\u0dbd\u0dcf \u01af\u0dd9\u0db6\u01e6\u0dd9\u01e6. \u0dd9\u023c \u026a\u0dc0\u0dcf\u0daf\u0dd9\u024f\u01cf \u0dc3\u0db8\u0dc4\u0dbb \u0db8\u01e6\u01b6\u0dc0\u025e \u0d9a\u0dae\u0dcf \u0d9a\u0dbb\u0db1\u0dd9\u0d9a\u02a3\u0da7, \u0dc4\u025c\u0dba\u0da7 \u0dd9\u023c\u0d9a \u0dbb\u0da2\u0dd9\u024f \u01d0\u0259\u0dc0\u0dbd\u0dad\u0dcf\u0dc0\u0dba\u00fa \u026a\u01dd\u0dba\u0da7 \u0dad\u0db8\u0250 \u0dd9\u0db4\u01e6\u0dc0\u01e6\u0db1 \u0dc4\u0dd0\u01d0\u0dd9\u0269. \u0d92\u0d9a \u0dbb\u0da2\u0dd9\u024f \u01d0\u0259\u0dc0\u0dbd\u0dad\u0dcf\u0dc0\u0dba\u00fa \u0dd9\u0db1\u02a3\u0dd9\u0dc0\u0250. \u0dc3\u0db8\u0dc4\u0dbb \u0d85\u0dba \u00fb\u0269\u0dc0\u0dcf, \"\u0dd9\u0daf\u0dc0\u0dd0\u01e7 \u0d85\u01b1\u025e \u0dc3\u023c\u0db8\u0dad \u0119\u019f\u0db8\u0d9a\u0dd4\u01ae \u0d85\u0db4\u0da7 \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u01e6\u0db1 \u0dd9\u0dc0\u0250\" \u00fb\u0dba\u0dbd\u0dcf. \u0d91\u0dd9\u0dc4\u0db8 \u0d91\u0d9a\u00fa \u0dd9\u0dc0\u01e6\u0dd9\u01e6 \u0db1\u0dd0\u0dc4\u0dd0. \u0da2\u0db1\u0dcf\u01dd\u0db4\u01af\u0dc0\u0dbb\u0dab\u0dba \u01ce\u01e9\u0dc0\u0dcf\u0da7 \u0db4\u0288 \u0d85\u026c\u025e\u01ca\u0daf \u023f\u0dbd\u01cf \u0d85\u0dba \u0dc0\u0dd0\u0dba\u0d9a\u0dd4\u01ae \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u01e6\u0db1 \u0d85\u0db4\u0da7 \u021a\u029a\u0dc0\u01e6. \u0d85\u0218 \u0daf\u01e6\u0db1\u0dc0\u0dcf 1994\u01cf\u01ae, 1999\u01cf\u01ae \u0dd9\u023c \u0dc0\u0dcf\u0dd9\u0118 \u0d85\u01b1\u025e \u0dc3\u023c\u0db8\u0dad \u0119\u019f\u023c \u0dd9\u023c \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1\u0dc0\u0da7 \u0d89\u01ce\u025c\u0db4\u01ae \u026c\u019f \u0db6\u0dc0. \u0dd9\u0db8\u0dba \u0dbb\u0da2\u0dd9\u024f \u01d0\u0259\u0dc0\u0dbd\u0d9a\u0db8\u00fa \u0dd9\u0db1\u02a3\u0dd9\u0dc0\u0250. \u0dd9\u0db8\u0dba \u0db8\u0dd0\u01af\u0dc0\u0dbb\u0dab\u0dba\u00fa \u01af\u0dd9\u0db6\u0db1 \u01e7\u0dc3\u0dcf \u0286\u01d0\u0dc0\u0db1 \u0dd9\u0daf\u0dba\u00fa \u0db6\u0dc0 \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb\u01e6\u0db1\u0da7 \u0d95\u0db1\u0dd1. \u0d92 \u0dad\u01ae\u01ae\u0dc0\u0dba \u0dd9\u0dc0\u0db1\u0dc3\u0dca \u0d9a\u0dbb\u01e6\u0db1 \u0d95\u0db1\u0dd1 \u0db1\u023c, \u0d92\u0d9a \u0db1\u0dd0\u01af \u0d9a\u0dbb\u01e6\u0db1 \u0d95\u0db1\u0dd1 \u0db1\u023c \u0d91\u0d9a \u0100\u0db8\u0dba\u0250 \u01af\u0dd9\u0db6\u01e6\u0dd9\u01e6. \u0d92 \u0100\u0db8\u0dba \u0d85\u01e9\u0dc0, \u01e7\u0dc1\u0dca\u013d\u0dad \u0daf\u0dc0\u0dc3\u0d9a \u0d85\u0db4\u0da7 \u0db8\u0dd0\u01af\u0dc0\u0dbb\u0dab\u0dba \u0db4\u0dd0\u0dc0\u0dd0\u01ae\u026b\u0db8\u0da7 \u021a\u029a\u0dc0\u01e6. \u0dc3\u0db8\u0dc4\u0dbb \u0dbb\u0da7\u0dc0\u0dbd \u01e7\u0dc1\u0dca\u013d\u0dad \u0daf\u0dc0\u0dc3\u0da7 \u0da2\u0db1\u0dcf\u01dd\u0db4\u01af\u0dc0\u0dbb\u0dab \u01af\u0dba\u0db1\u0dc0\u0dcf. \u0d85\u026c\u025e\u01d0 \u0db4\u0dc4\u0d9a\u0da7 \u0dd9\u0dc4\u02a4 \u0dc4\u0dad\u0dbb\u0d9a\u0da7 \u0dc3\u0dd0\u0dbb\u0dba\u00fa \u0d85\u0dc4\u0dc0\u0262 \u0db8\u0dcf\u0dc3\u0dd9\u024f, \u0d85\u0dc4\u0dc0\u0262 \u0dc3\u01af\u0dd9\u024f \u0dd9\u023c \u0db8\u0dd0\u01af\u0dc0\u0dbb\u0dab\u0dba \u0db4\u0dc0\u01ae\u0dc0\u01e6\u0db1 \u0d95\u0db1\u0dd1\u0dba \u00fb\u0dba\u0db1\u0dc0\u0dcf. \u0dd9\u023c \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1\u0dc0\u0da7 \u0d92\u0d9a \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0db1\u023c, \u0d91\u0dd9\u0dc4\u0db8 \u0dd9\u0dc0\u0db1\u0dc3\u00fa \u0d9a\u0dbb\u01e6\u0db1\u0da7 \u021a\u029a\u0dc0\u01e6. \u0d91\u0dd9\u0dc4\u0db8 \u0db1\u0dd0\u01b1\u0dc0 \u0dd9\u023c \u0d9a\u025e\u019f \u0dbb\u0da2\u0dba \u01b0\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0d91\u0d9a\u00fa \u0dd9\u0db1\u02a3\u0dd9\u0dc0\u0250. \u0dd9\u023c \u0db8\u0dd0\u01af\u0dc0\u0dbb\u0dab\u0dba \u0db4\u0dc0\u01ae\u0dc0\u0db1 \u0daf\u0dc0\u0dc3 \u0dc0\u0dca\u200d\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u01e9\u0d9a\u0dd6\u0dbd\u0dc0 \u0dad\u0db8\u0250 \u01af\u0dd9\u0db6\u01e6\u0dd9\u01e6. \u0dc0\u0dca\u200d\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u01e9\u0d9a\u0dd6\u0dbd\u0dc0 \u0dad\u0db8\u0250 \u0d85\u0218 \u0dd9\u023c \u0d85\u01b1\u025e \u0dc3\u023c\u0db8\u0dad \u0119\u019f\u0db8 \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u01e6\u0dd9\u01e6. \u0dd9\u023c \u0d85\u01b1\u025e \u0dc3\u023c\u0db8\u0dad \u0119\u019f\u0db8 \u0d89\u01ce\u025c\u0db4\u01ae \u00fb\u025d\u0dd9\u0db8\u01e6 \u0dbb\u0dd9\u0178 \u0d86\u0daf\u0dcf\u0dba\u0db8 \u0d9a\u0dbd\u0da7 \u0dd9\u0dc0\u0dbd\u0dcf\u0dc0\u0da7 \u0dbd\u0db6\u0dcf \u0d9c\u01e6\u0db1 \u021a\u029a\u0dc0\u01e6. \u0d92 \u026a\u0dad\u0dbb\u00fa \u0dd9\u0db1\u02a3\u0dd9\u0dc0\u0250, \u0d9a\u0dbd\u0da7 \u0dd9\u0dc0\u0dbd\u0dcf\u0dc0\u0da7 \u026a\u0dba\u0daf\u023c \u0d9a\u0dbb\u01e6\u0db1\u01ae \u021a\u029a\u0dc0\u01e6. \u0dd9\u023c \u0dbb\u0dd9\u0178 \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0dd9\u0dc3\u0dda\u0dc0\u0d9a\u0dba\u01e6 \u0d89\u01e6\u0db1\u0dc0\u0dcf. \u0d92 \u0d85\u0dba\u0da7 \u0da2\u0db1\u0dc0\u0dcf\u025c \u0db8\u0dcf\u0dc3\u0dd9\u024f \u0d89\u0db3\u0dbd\u0dcf \u0d9a\u0dbd\u0da7 \u0dd9\u0dc0\u0dbd\u0dcf\u0dc0\u0da7 \u0dc0\u0dd0\u017b\u0217 \u0dbd\u0db6\u0dcf \u0dd9\u0daf\u01e6\u0db1 \u0d95\u0db1\u0dd1. \u0dd9\u023c \u0d85\u01b1\u025e \u0dc3\u023c\u0db8\u0dad \u0119\u019f\u0db8 \u0d85\u01e9\u0db8\u0dad \u026b\u0dd9\u0db8\u01e6 \u0db4\u0288\u0dc0 \u0d85\u0db4\u0da7 \u0d92 \u0286\u0dba\u0262\u0dbd\u00fa\u0db8 \u0d9a\u0dbb\u01e6\u0db1\u0da7 \u021a\u029a\u0dc0\u01e6."
