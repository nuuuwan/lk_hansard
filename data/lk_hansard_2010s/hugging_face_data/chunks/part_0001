    "chunk_text": "\u0dc3\u0d82\u0dc0\u0259\u01dd\u0dad \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0d85\u0d82\u0dc1\u0dd9\u024f \u0dd9\u0dc4\u02a4\u0da7\u0262 \u028f\u023d\u0dba\u01e6\u0da7 \u0d94\u026c\u01e6 \u0dbd\u0db6\u0dcf\u0dd9\u0d9c\u0db1 \u0d87\u01af \u0286\u0dba\u0265 \u0dab\u0dba \u0d86\u0db4\u0288 \u0dd9\u0d9c\u026b\u0dd9\u023c \u0d9a\u0dcf\u0dbd\u0dba 2020 \u0db8\u0dcf\u0259\u01b1 21\u0dd9\u0dc0\u01e7 \u0daf\u0dcf \u0daf\u00fa\u0dc0\u0dcf \u0d9a\u0262 \u01cf\u0dbd\u0dcf \u01af\u0dd9\u0dba\u0db1\u0dc0\u0dcf. \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u00fa\u0dd9\u0dc2\u0dda\u01b4\u0dd9\u0dba\u01e6 \u0d85\u0dba \u0d9a\u0dc5 \u0d91\u0d9a\u01b1 \u0d9a\u0dc5 \u0d86\u0daf\u0dcf\u0dba\u0db8 \u0db8\u0dad \u0db6\u01ca\u0daf \u0286\u0dba\u0dba\u0da7 15 \u0286\u0da7 \u0286\u0dba\u0dba\u0da7 5 \u0daf\u00fa\u0dc0\u0dcf \u0d85\u018d \u0d9a\u0dbb\u0dbd\u0dcf \u01af\u0dd9\u0dba\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dd9\u0118\u0db8 \u0db6\u01d0 \u00fb\u0286\u0dc0\u00fa \u0dd9\u0db1\u02a3\u0dd9\u0d9c\u0dc0\u0dcf \u0d86\u0dbb\u00fa\u027f\u0dad \u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0d86\u0db1\u0dba\u0db1\u0dba \u00fb\u025d\u0db8\u0da7\u01ae \u0d85\u0218 \u0d94\u026c\u01e6\u0da7 \u0dc3\u0dc4\u0db1 \u0dbd\u0db6\u0dcf\u01cf\u0dbd\u0dcf \u01af\u0dd9\u0dba\u0db1\u0dc0\u0dcf.\n\n\u0dd9\u0db8\u0dad\u0dbb\u023c \u026a\u0dd9\u01ca\u0dc1 \u0dab\u0dba \u0dbd\u0db6\u0dcf \u0d9c\u01e7\u023d\u01e6, \u0dbb\u0da7 \u01b1\u0dc5 \u0286\u01d0 \u0d9a\u0dd9\u0dc5\u0dda \u0d9a\u0dd4\u0db8\u00fa\u0daf\u0dd0\u0250 \u0db8\u0dcf \u0db1\u0dd0\u0dc0\u0dad \u0d85\u0dc4\u01e6\u0db1 \u0d9a\u0dd0\u0db8\u0dd0\u01af\u0250. \u0db8\u0db8 \u0dd9\u023c \u0d9a\u0dae\u0dcf \u0d9a\u0dd9\u0dc5\u0dda, 2010\u01cf \u0119\u01e7 \u0dd9\u0db4\u02a3\u0263\u0dba\u0da7 \u0dd9\u0da9\u02a3\u0dbd\u0259 \u022a\u0263\u0dba\u0db1 \u0d9c\u0dab\u01e6\u0dc0\u0263\u01e6 \u0dbd\u0db6\u0dcf \u0d9c\u01ae \u0dab\u0dba \u0d9c\u0dd0\u0db1\u0250. 2012\u01cf, 2013\u01cf, 2014\u01cf \u0dab\u0dba \u0dbd\u0db6\u0dcf \u0d9c\u01ae\u0dad\u0dcf. \u0d92 \u0dab\u0dba\u0dc0\u0263\u01e6"
  },
