    "chunk_text": "\u0240\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u025f\u0daa \u0d9c\u025e \u0db8\u01e6\u01b6\u01b1\u023d\u0dba\u01e7, \u0d85\u0263\u01e6 \u0218\u0298\u0db6\u0db3\u0dc0 \u0dd9\u0dbd\u02a3\u0d9a\u0dd4 \u0dd9\u0d9c\u02a5\u0dbb\u0dc0\u0dba\u00fa \u0dd9\u023c \u0dbb\u0dd9\u0178 \u0d89\u01af\u0dc4\u0dcf\u0dc3\u0dba \u021a\u0dbb\u0dcf \u01af\u022c\u0dab\u0dcf. \u026a\u0dd9\u0dc1\u0dda\u0dc2\u0dd9\u0dba\u01e6\u0db8 \u0db1\u0dcf\u0dbd\u0dcf\u0119\u025c \u0d87\u0dad\u0dcf \u0218\u0298\u0db6\u0db3\u0dc0 \u022c\u01d0\u0dbb\u0da2\u0dcf\u0dab\u01e6 \u0dc0\u0dc4\u01e6\u0dd9\u0dc3\u0dda\u0dd9\u0118 \u0d9a\u0dcf\u0dbd\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6 \u0dc0\u0db1\u0dc0\u0dcf. \u0db1\u0dcf\u0dbd\u0dcf\u0119\u025c \u0d87\u0dad\u0dcf\u0da7 \u0dbb\u0dcf \u0dd9\u0db4\u02a3\u0dc0\u0dbd\u0dcf \u022c\u01d0\u0dbb\u0da2\u0dcf\u0dab\u01e6 \u0dc0\u0dc4\u01e6\u0dd9\u0dc3\u0dda \u0dc5\u0d9f\u0da7 \u0dba\u0dd0\u0269\u0dc0\u01ae, \u0d87\u0dad\u0dcf \u028f\u00fa\u023f\u019f \u0dc4\u0dd0\u0179 \u0d85\u0218 \u021a\u0d82\u013d \u0dc5\u0db8\u0250\u01e6\u0da7 \u0db0\u0259\u0db8 \u0dd9\u01ca\u0dc1\u0db1\u0dcf\u0dc0\u0dbd\u01cf \u0db4\u0dd0\u0dc4\u0dd0\u01ce\u0263 \u0d9a\u0dbb\u0dbd\u0dcf \u01d0\u01e6\u0db1\u0dcf. \u0d87\u01ae\u0dd9\u0dad\u01e6\u0db8 \u0d91\u0dc5\u0dcf\u0dbb - \u01d0\u017b\u0d9c\u0dd0\u023f\u019f \u0252\u01ca\u0db0\u0dd9\u024f\u01cf \u0d9a\u019c\u018d\u0dbd \u0d87\u0dad\u0dcf\u01ae, \u0d91\u0dc5\u0dcf\u0dbb \u0dbb\u0151\u0dd9\u0118 \u0db4\u0259\u0dc0\u0dad \u0db1\u0db8\u0dd0\u01af \u0d87\u0dad\u0dcf\u01ae \u0d85\u0dd9\u0db1\u00fa \u0dd9\u0dc3\u0db6\u029a\u01e6 \u0db4\u0dd0\u01ae\u0dad\u0d9a \u01af\u0dba\u0dbd\u0dcf \u0dc3\u0da7\u01e6 \u0d9a\u0dc5 \u0db6\u0dc0 \u0d89\u01af\u0dc4\u0dcf\u0dc3\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6 \u0dc0\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dd9\u0118\u0db8 \u0dc3\u0d82\u0d9d\u01af\u0dc3\u0dca\u0dc3, \u0224\u0dc3\u0dca\u0dc3\u0dd9\u01ca\u0dc0, \u0db8\u0dc4\u0dcf \u026a\u0da2\u0dba\u0db6\u0dcf\u0291, \u0db8\u0dc4\u0dcf \u0db4\u0dbb\u0dcf\u0100\u0db8\u0db6\u0dcf\u0291 \u0dc0\u0dcf\u0dd9\u0118 \u0dd9\u023c \u0dbb\u0da7 \u0d91\u00fa\u0dd9\u0dc3\u0dda\u0dc3\u01ae \u0d9a\u0dbb\u01e6\u0db1 \u0d9a\u0da7\u0252\u01b1 \u0d9a\u0dbb\u021a \u0db1\u0dcf\u0dba\u0d9a\u0dba\u01e6 700\u00fb\u01e6, 800\u00fb\u01e6 \u0252\u01ae \u0d87\u01ae \u0dd9\u0dc3\u0dda\u0db1\u0dcf \u0dad\u0db8\u01e6\u0dd9\u0118 \u0dc4\u023f\u0daf\u0dcf\u0dc0 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0dc3\u0da7\u0db1\u0da7 \u0db4\u0dcf\u026a\u013c\u013d \u0d9a\u0dbb\u021a \u0d86\u0d9a\u0dcf\u0dbb\u0dba \u0d89\u01af\u0dc4\u0dcf\u0dc3\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6\u0dc0 \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0db4\u0dd8\u01b1\u011a\u0286, \u0dbd\u01e6\u0dd9\u01ca\u0286, \u0d89\u0d82\u0121\u0286\u01e6\u0dd9\u0118 \u0252\u0d9c\u0dd9\u024f \u0d87\u01ae \u0daf\u0dc5 \u0dd9\u0dc0\u0dd9\u0dc5\u0db3\u0dcf\u0db8 \u0dc0\u0dcf\u0dd9\u0118\u0db8 \u0d87\u01b1\u01e6 \u0dd9\u0dc0\u0dd9\u0dc5\u0db3\u0dcf\u0db8 \u0d85\u0dd9\u0217 \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0269 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0d9a\u0dc5 \u0db6\u0dc0 \u0d85\u0218 \u026a\u0dd9\u0dc1\u0dda\u0dc2\u0dd9\u0dba\u01e6 \u00fb\u0dba\u01e6\u0db1 \u0d95\u0db1\u0dd1.\n\n\u0dc0\u0db1\u0150\u026b \u0dc3\u0d82\u0dbb\u00fa\u0dc2\u0dab \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dc0\u0da7 \u01e7\u0dba\u0db8 \u0dd9\u0dc0\u0dbd\u0dcf \u01af\u0dd9\u0db6\u0db1 \u0dc3\u023c\u021d\u0daf\u0dcf\u0dba\u0dcf\u01e9\u0d9a\u0dd6\u0dbd \u0d9a\u0dcf\u0259\u0dba\u0dd9\u0dba\u01e6 \u0db6\u0dd0\u0dc4\u0dd0\u0dbb\u0dc0 \u00fb\u0286\u01d0 \u0dd9\u0daf\u0dba\u00fa \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0d9a\u0dbb\u01e6\u0dd9\u01e6 \u0db1\u0dd0\u0dc4\u0dd0. \u0d94\u026c\u01e6 \u0d85\u0263 \u0db8\u0d82\u0d9a\u0da9\u0dc0\u0262 \u0d9c\u0dd0\u0db1 \u028f\u0dad\u01e6\u0dd9\u01e6 \u0db1\u0dd0\u01af\u0dc0, \u00fb\u0286\u01d0 \u0db4\u025d\u00fa\u0dc2\u0dab\u0dba\u00fb\u01e6 \u0dd9\u0dad\u02a3\u0dbb\u0dc0, \u0dc0\u0db1 \u0dc3\u0d82\u0dbb\u00fa\u0dc2\u0dab \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dc0\u0da7 -\u0d9a\u0dd0\u0dbd\u0dd1 \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dc0\u0da7- \u0d85\u0250\u01af \u0db4\u0dcf\u0dbb\u023c\u0db4\u025c\u0d9a \u0d89\u0da9\u023c \u0db8\u0dd0\u01ce\u01e6 \u0d85\u0263 \u0dc0\u0dd0\u0da7\u0dc0\u0262 \u0d89\u01ce\u00fb\u025d\u0dd9\u023c \u0d9a\u0dcf\u0259\u0dba\u0dba \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d94\u026c\u01e6 \u0d9a\u0dbb\u0db1 \u0d85\u01e7\u00fa \u0d9a\u0da7\u0252\u01ae\u0dad \u0dad\u0db8\u0250, \u0d9c\u0db8\u0da7 \u0119\u028f\u01e6 \u0d85\u0263 \u0dd9\u0dc0\u018b \u0dd9\u0daf\u0db1 \u0d91\u0d9a. \u0d94\u026c\u01e6 \u0d9c\u023c\u0db8\u0dcf\u0db1\u0dd9\u024f \u0dc0\u023c \u0db4\u0dd0\u01ae\u0dd9\u01ae \u01af\u0dd9\u0db6\u0db1 \u0dd9\u0d9c\u0dc0\u0262\u0dc0\u0dbd\u0da7\u01ae \u0d85\u0263 \u0dd9\u0dc0\u018b \u0dd9\u0daf\u0db1\u0dc0\u0dcf, \u0daf\u0d9a\u0dd4\u019f \u0db4\u0dd0\u01ae\u0dd9\u01ae \u01af\u0dd9\u0db6\u0db1 \u0dd9\u0d9c\u0dc0\u0262\u0dc0\u0dbd\u0da7\u01ae \u0d85\u0263 \u0dd9\u0dc0\u018b \u0dd9\u0daf\u0db1\u0dc0\u0dcf. \u0d85\u0263\u0dba\u0dcf \u0d86\u0dc0\u0dcf\u0db8, \u0dc0\u023c \u0db4\u0dd0\u01ae\u0dd9\u0dad\u01e9\u01ae \u0d85\u0263 \u0dd9\u0dc0\u018b \u0d9c\u0dc4\u0db1\u0dc0\u0dcf; \u0daf\u0d9a\u0dd4\u019f \u0db4\u0dd0\u01ae\u0dd9\u0dad\u01e9\u01ae \u0d85\u0263 \u0dd9\u0dc0\u018b \u0d9c\u0dc4\u0db1\u0dc0\u0dcf. \u0d91\u0dad\u0dd9\u0d9a\u02a3\u0da7 \u0d85\u0263\u0dba\u0dcf\u0da7 \u0dba\u01e6\u0db1 \u0dad\u0dd0\u0db1\u00fa \u0db1\u0dd0\u0dc4\u0dd0. \u0d8a\u0da7 \u0db4\u0dc3\u0dca\u0dd9\u0dc3\u0dda, \u0d85\u0263\u0dba\u0dcf \u0db4\u0dcf\u0dd9\u0259 \u0dba\u0db1 \u023d\u01e7\u0dd9\u0dc4\u0d9a\u0dd4\u0dd9\u0118 \u0d94\u029a\u0dc0 \u0dd9\u0db4\u02a3\u018b \u0d9a\u0dbb\u0dbd\u0dcf \u0db8\u0dbb\u0dcf \u0daf\u0db8\u0db1\u0dc0\u0dcf. \u0db1\u0dd0\u01ae\u0db1\u023c \u0dd9\u01ca\u0db4\u0dc5 \u026a\u0db1\u0dcf\u0dc1 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf; \u0dd9\u0d9c\u0dc0\u0262 \u0d9a\u0da9\u0dcf \u0daf\u0db8\u0db1\u0dc0\u0dcf. \u0d91\u0dd9\u0dc4\u0db8\u01ae \u0db1\u0dd0\u01ae\u0db1\u023c, \u0d9a\u01e6\u0db1\u0dba\u00fa \u021a\u0dbb\u0dcf \u0d9a\u0dc5 \u0dc0\u0d9c\u0dcf\u0dc0 \u026a\u0db1\u0dcf\u0dc1 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d92\u0d9a \u0dad\u0db8\u0250, \u0d85\u0263-\u023d\u01e7\u0dc3\u0dca \u0d9c\u0dd0\u017b\u0db8 \u00fb\u0dba\u01e6\u0dd9\u01e6. \u0dd9\u023c \u0dd9\u01ca\u0dc0\u0262 \u0dc0\u0dd0\u0dc5\u0dd0\u00fa\u026b\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u00fb\u0286\u0db8 \u0dc0\u0dd0\u0da9 \u0218\u0298\u0dd9\u0dc0\u0dc5\u00fa \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0dd9\u0d9a\u0dd9\u0dbb\u01e6\u0dd9\u01e6 \u0db1\u0dd0\u0dc4\u0dd0. \u0dc0\u0db1 \u0dc3\u0d82\u0dbb\u00fa\u0dc2\u0dab \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dd9\u0269 \u022c\u01ca\u01dd\u0db8\u01ae \u01e7\u0dbd\u0db0\u0dcf\u025c\u01e6 \u00fc\u0db4\u0dd9\u0daf\u0dd9\u0db1\u00fa \u0d89\u01e6\u0db1 \u0db6\u0dc0 \u0d85\u0218 \u0daf\u01e6\u0db1\u0dc0\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u0250, \u0d92 \u0d85\u0dba\u0da7 \u0d95\u0db1\u0dd1 \u026a\u01dd\u0dba\u0da7 \u0dd9\u023c \u0d9a\u0dcf\u0259\u0dba\u0dba \u0d9a\u0dbb\u01e6\u0db1 \u0db4\u0dc4\u0288\u0d9a\u023c \u0dc3\u0db4\u0dba\u01e6\u0dd9\u01e6 \u0db1\u0dd0\u0dc4\u0dd0.\n\n\u0d9c\u025e \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u01b1\u0db8\u01e7, \u0dd9\u023c \u0218\u0298\u0db6\u0db3\u0dc0 \u0263\u0dba\u0dd0\u026c\u019f \u0dd9\u0db4\u02a3\u0dad\u00fa \u0db4\u0288\u0119\u0dba \u0d85\u0dba \u0dc0\u0dd0\u0dba \u026a\u0dc0\u0dcf\u0daf\u0dba \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269\u01cf \u0db8\u0db8 \u0d94\u0db6\u01b1\u0db8\u0dcf\u0da7 \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dc5\u0dcf. \u0db8\u0db8 \u0db4\u0288\u0dc0 \u0d92 \u0d9c\u0dd0\u0db1 \u026a\u0db8\u0288\u0dc0\u0dcf\u0db8, \u0d92\u0d9a \u0db1\u0dd0\u01af \u026c\u0dab\u0dcf \u00fb\u0dba\u0dbd\u0dcf \u0d94\u0db6\u01b1\u0db8\u0dcf \u00fb\u0269\u0dc0\u0dcf. \u0d92 \u01e7\u0dc3\u0dcf, \u0dd9\u023c \u0d9a\u0dcf\u0259\u0dba\u0dd9\u024f\u01cf \u0d85\u0218 \u00fb\u0dba\u01e6\u0db1 \u0d9a\u0dd0\u0db8\u01af\u0250,- [\u0db6\u0dcf\u0db0\u0dcf \u00fb\u025d\u0db8\u00fa] \u0d94\u0dba \u0dd9\u0db4\u02a3\u0dad \u0dd9\u0db1\u02a3\u0dd9\u0dc0\u0250, \u0d9c\u025e \u0d87\u0db8\u01af\u01b1\u0db8\u01e7."
  },
