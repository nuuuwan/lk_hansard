    "chunk_text": "\u0d8a\u0dc5\u0d9f\u0da7, \u0dd9\u023c \u0d85\u0263 \u0dc0\u0dd0\u0da7 \u0dc4\u0daf\u0db1 \u0dd9\u0d9a\u02a3\u0da7 \u0dc0\u0db1\u0150\u026b \u0dc3\u0d82\u0dbb\u00fa\u0dc2\u0dab \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dc0\u0da7 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u026a\u01dd\u0dba\u0da7 \u0286\u0dba\u0262\u0dbd \u0dc4\u0daf\u01e6\u0dd9\u01e6 \u0db1\u0dd0\u0dc4\u0dd0. \u0dd9\u023c \u0d9c\u0dd0\u0db1 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0d9a\u023d\u017b \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0d9a\u023d\u017b\u0dc0\u0dbd \u0dc3\u0dcf\u0d9a\u013c\u0da1\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d91\u0dad\u0dd0\u0db1 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c\u01b1\u0db8\u0dcf \u0d89\u01e6\u0db1\u0dc0\u0dcf. \u0dc0\u0db1\u0150\u026b \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dd9\u0269, \u0db8\u0dc4\u0dc0\u0dd0\u0263 \u0d85\u01dd\u0d9a\u0dcf\u025c\u0dd9\u024f \u01e7\u0dbd\u0db0\u0dcf\u025c\u01e6 \u0d89\u01e6\u0db1\u0dc0\u0dcf. \u0d92 \u0286\u0dba\u0265\u0dd9\u0daf\u0db1\u0dcf \u0dc3\u0dcf\u0d9a\u013c\u0da1\u0dcf \u0d9a\u0dbb\u0dbd\u0dcf\u0250 \u0d92 \u0d85\u0263 \u0dc0\u0dd0\u0da7\u0dc0\u0262 \u0dc3\u0d9a\u0dc3\u0db1 \u021d\u023d\u01af \u01b0\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u01e6\u0dd9\u01e6.\n\n813 814\n\n2019 \u0dc3\u0dd0\u0217\u0dad\u0dd0\u023c\u0db6\u0259 20\n\n\u0240\u0dbd\u0dcf\u0dc3\u0db1\u0dcf\u025f\u0daa \u0d9c\u025e \u0db8\u01e6\u01b6\u01b1\u0db8\u01e7, \u0d85\u0263 \u0dc0\u0dd0\u0da7\u00fa \u0dc4\u0daf\u0dbd\u0dcf \u0d92\u0d9a \u0dc4\u025c\u0dba\u0da7 \u0db1\u0da9\u01ae\u01b1 \u0d9a\u0dd9\u0dc5\u0dda \u0db1\u0dd0\u01ae\u0db1\u023c \u0d91\u0dad\u0dd0\u0db1 \u021d\u0dcf\u0dd9\u0dba\u02a4\u0119\u0d9a\u0dc0 \u021d\u0dc1\u0dca\u0db1\u0dba\u00fa \u0d87\u01af \u0dd9\u0dc0\u0db1\u0dc0\u0dcf. \u0db4\u0288\u0119\u0dba \u0d9a\u0dcf\u0dbd\u0287\u0db8\u0dcf\u0dc0 \u01b1\u0dc5\u01cf \u0d85\u0263 \u0dc0\u0dd0\u0da7\u0dc0\u0262 \u0d89\u01ce \u0d9a\u0dc5\u0dcf. \u0d92 \u0d89\u01ce \u0d9a\u0dc5 \u0d85\u0263 \u0dc0\u0dd0\u0da7\u0dc0\u0262 \u0179\u0d9a \u0d92 \u0d9a\u023d\u017b\u0dc0\u0dbd\u0da7 \u0db7\u0dcf\u0dbb \u01d0\u01e6\u0db1\u0dcf\u0db8, \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u021d\u023d\u01af\u0dba\u0da7, \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u026a\u01dd\u0dba\u0da7 \u0db1\u0da9\u01ae\u01b1 \u026c\u0dd9\u019c \u0db1\u0dd0\u01af \u026c\u0dab\u0dcf\u0db8 \u0d92 \u0dc0\u0dd0\u0da7\u0dc0\u0262 \u0d9a\u0da9\u0dcf \u0dd9\u0d9c\u0db1 \u0d92 \u0dc4\u0dbb\u0dc4\u0dcf \u0dc0\u0db1 \u0d85\u0263 \u0d9c\u023c\u0dc0\u0dbd\u0da7 \u0d87\u026a\u0262\u0dbd\u0dcf \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u021d\u0dc1\u0dca\u0db1 \u0d87\u01af \u0dd9\u0dc0\u0dbd\u0dcf \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0dcf\u0dd9\u0118\u0db8 \u0d85\u0263 \u0dc0\u0dd0\u0dd9\u0da7\u01e6 \u021d\u0dd9\u0dba\u02a4\u0da2\u0db1\u0dba \u0d9c\u01e6\u0db1 \u0d95\u0db1\u0dd1 \u0db1\u023c \u0d85\u0263 \u0dc0\u0dd0 \u0da7\u0da7 \u0dd9\u0dba\u02a3\u0daf\u0dcf \u01af\u0dd9\u0db6\u0db1 \u026a\u01d0\u0263\u0dba \u0db1\u0dd0\u01af \u0d9a\u0dbb\u01e6\u0db1 \u0db6\u0dd0\u0dc4\u0dd0. \u0dc3\u0db8\u0dc4\u0dbb \u0dd9\u0dc0\u0dbd\u0dcf\u0dc0\u0da7 \u0d92 \u026a\u01d0\u0263 \u0dc0\u0dd0\u0da7\u0da7 \u0daf\u0dc0\u0262\u0da7 \u026a\u01d0\u0263\u0dba \u0dd9\u0daf\u01e6\u0dd9\u01e6 \u0db1\u0dd0\u0dc4\u0dd0. \u0d85\u0263 \u0dc0\u0dd0\u0da7\u0da7 \u0daf\u0dc0\u0262\u0da7 \u026a\u01d0\u0263\u0dba \u0dbd\u0db6\u0dcf \u0dd9\u0daf\u01e6\u0dd9\u01e6 \u0db1\u0dd0\u01af\u0dc0, \u025b\u0da7 \u026a\u01d0\u0263\u0dba \u0dbd\u0db6\u0dcf \u0dd9\u0daf\u0db1\u0dc0\u0dcf. \u0d91\u0dad\u0dd9\u0d9a\u02a3\u0da7 \u026a\u01d0\u0263 \u0db0\u0dcf\u025c\u0dad\u0dcf\u0dc0 \u0d85\u018d \u0dd9\u0dc0\u0db1\u0dc0\u0dcf. \u0db1\u023f\u01ae \u0d85\u0263 \u0dc0\u0dd0\u0da7\u0da7 \u0dd9\u0daf\u0db1 \u026a\u01d0\u0263\u0dba \u01ce\u0d9c\u0da7\u0db8 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u026a\u0dba \u0252\u01b1\u0250. \u0d85\u0218 \u0d92\u0dc0\u0dcf \u0daf\u0dd0\u0db1\u0dd9\u0d9c\u0db1, \u0dc4\u01ff\u0db1\u0dcf \u0dd9\u0d9c\u0db1 \u0d9a\u0da7\u0252\u01b1 \u0d9a\u0dbb\u01e6\u0db1 \u0d95\u0db1\u0dd1. \u0d85\u0263 \u0dc0\u0dd0\u0da7\u0dc0\u0262 \u0d89\u01ce \u00fb\u025d\u0dd9\u023c\u01cf \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dc0\u0dbd \u021d\u0dc1\u0dca\u0db1 \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dd9\u0dc0\u01e6 \u00fb\u0dba\u0db1\u0dc0\u0dcf, \"\u0dd9\u023c\u0d9a \u0db8\u0dc4\u0dc0\u0dd0\u0263\u0dd9\u024f \u0d89\u0da9\u0db8\u00fa, \u0d91\u0dad\u0dd0\u01e7\u01e6 \u0dd9\u0daf\u01e6\u0db1 \u0db6\u0dd0\u0dc4\u0dd0\" \u00fb\u0dba\u0dbd\u0dcf. \u0d85\u01e6\u0db1 \u0d92 \u0dc0\u0dcf\u0dd9\u0118 \u01af\u0dd9\u0db6\u0db1 \u021d\u0dc1\u0dca\u0db1 \u01e7\u0dc3\u0dcf \u0dad\u0db8\u0250 \u0d85\u028f\u0d82\u0dc3\u0d9a \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0dd9\u023c \u021d\u0dc1\u0dca\u0db1\u0dc0\u0dbd\u0da7 \u023f\u0291\u0dab\u0db4\u0dcf\u0dbd\u0dcf \u01af\u0dd9\u0db6\u01e6\u0dd9\u01e6. \u0d85\u0daf \u0dc0\u0db1 \u026a\u0da7 \u0d85\u0263\u0d9c\u0dc4\u0db1\u0dba \u0dc0\u0dd0\u018b \u0dd9\u0dc0\u0dbd\u0dcf \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf; \u0da2\u0db1\u0d9c\u0dc4\u0db1\u0dba \u0dc0\u0dd0\u018b \u0dd9\u0dc0\u0dbd\u0dcf \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0dd9\u023c \u021d\u0dd9\u01ca\u0dc1\u0dc0\u0dbd \u0d9a\u0dd8\u027f\u0d9a\u0259\u0db8\u0dcf\u01e6\u0dad \u0d9a\u0da7\u0252\u01b1 \u0dc0\u0dd0\u018b\u021a\u0dbb \u0dd9\u0d9a\u0dd9\u0dbb\u0db1\u0dc0\u0dcf. \u0dd9\u023c\u0dc0\u0dcf\u0da7 \u0d85\u0218 \u01af\u0dbb\u0dc3\u0dbb \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0dc3\u0dd0\u0dbd\u0288\u0db8\u00fa \u0dd9\u0dc4\u02a3\u0dba\u01e6\u0db1 \u0d95\u0db1\u0dd1."
  },
