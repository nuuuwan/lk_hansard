    "chunk_text": "1986\u01cf \u0d9c\u025e \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1\u0dc0 \u01e7\u0dd9\u0dba\u02a4\u0da2\u0db1\u0dba \u0d9a\u0dc5 \u021d\u0db6\u0dbd -\u026a\u0274\u0dc2\u0dca\u0da7\u0db8- \u0dd9\u01ca\u0dc1\u0db4\u0dcf\u0dbd\u0db1 \u0d9a\u01c2\u0d9a\u0dba\u0d9a\u0dd4 \u026d \u0dc3\u0dbb\u01ae \u023f\u01ae\u0dd9\u0dad\u0178\u017b\u0dc0\u0d9c\u0db8 \u0db8\u0dd0\u01af\u01b1\u0db8\u0dcf \u025c\u0dba \u0d85\u0db1\u01b1\u0dbb\u00fb\u01e6 \u023d\u0dba \u0119\u0dba\u0dcf. \u0d92 \u0db8\u0dcf\u0dbb\u0dcf\u01e6\u01af\u0d9a \u025c\u0dba \u0d85\u0db1\u01b1\u0dbb \u0286\u01d0 \u0dc0\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 \u0dc3\u0dbb\u01ae \u023f\u01ae\u0dd9\u0dad\u0178\u017b\u0dc0\u0d9c\u0db8 \u0db8\u0dd0\u01af\u01b1\u0db8\u0dcf \u0dc3\u0db8\u0d9f \u0dd9\u0db8\u02a4\u0da7\u0259 \u0dbb\u0dae\u0dd9\u024f \u021a\u01ca\u0d9c\u0dbd\u0dba\u01e6 \u0db4\u0dc3\u0dca \u0dd9\u0daf\u0dd9\u0db1\u0d9a\u0dd4 \u0d9c\u0db8\u01e6 \u0d9a\u0dc5\u0dcf. \u0d85 \u0dd9\u0217 \u0da0\u01e6\u01d6\u0286\u025c \u0d9c\u0da2\u01cf\u0dbb \u0db8\u0dd0\u01af\u01b1\u0db8\u0dcf \u0d89\u01e6 \u0d91\u00fa \u0d85\u0dd9\u0dba\u00fa. \u0d92 \u025c\u0dba \u0d85\u0db1\u01b1\u0dd9\u0259 \u021d\u01af\u0db5\u0dbd\u0dba\u00fa \u0dc4\u0dd0\u0179\u0dba\u0da7 \u0db8\u0db8 \u028f\u0dad\u01e6\u0dd9\u01e6 \u0d91\u01b1\u0db8\u0dcf \u0db8\u0dcf\u0dc3 \u0dc4\u0dba\u00fa \u0db4\u0db8\u0dab \u0d91\u00fa\u0dad\u0dd0\u01e6 \u0dd9\u0dc0\u0dbd\u0dcf \u028f\u0179\u0dba\u0dcf. \u0d92 \u025c\u0dba \u0d85\u0db1\u01b1\u0dbb \u0db8\u0dcf\u0dbb\u0dcf\u01e6\u01af\u0d9a \u025c\u0dba \u0d85\u0db1\u01b1\u0dbb\u00fa. \u0db8\u0dcf\u0dc3 \u0dc4\u0dba\u00fa \u0dc0\u0dcf\u0dd9\u0118 \u0d9a\u0dcf\u0dbd\u0dba\u00fa \u0d91\u01b1\u0db8\u0dcf\u0da7 \u0d89\u01e6 \u0219\u0da9\u0dcf \u026a\u01fd\u01e6\u0db1 \u0286\u01d0 \u026c\u0dab\u0dcf. 1986\u01cf \u0dad\u0db8\u0250 \u0d92 \u0286\u01ca\u01dd\u0dba \u026c\u0dd9\u019c. 1988\u01cf \u0db4\u0dd0\u0dc0\u0dd0\u01af \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0269 \u0db4\u0dc5\u023f\u0dc0\u0dd0\u01e7 \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf \u0db8\u0dd0\u01af\u0dc0\u0dbb\u0dab \u0dc3\u0db8\u0dba \u0db8\u0db8 \u028f\u0dad\u01e6\u0dd9\u01e6 \u0d91\u01b1\u0db8\u0dcf\u0dd9\u0118 \u0150\u026a\u0dad\u0dba\u0da7 \u0dad\u0dc0\u01ae \u0288\u026a\u0dd9\u0dc1\u0dda\u0280 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u00fa \u026c\u0dab\u0dcf. 1988-1989 \u0d9a\u0dcf\u0dbd\u0dba \u0d85\u0218 \u0dc4\u01ff\u01e6\u0dc0\u01e6\u0dd9\u01e6 \u0235\u0dc2\u0dab \u0dc3\u0db8\u0dba \u0dc4\u0dd0\u0179\u0dba\u0da7\u0250. \u0d91\u01b1\u0db8\u0dcf \u0d92 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269\u01cf \u027c \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0269 \u0db4\u0dc5\u023f\u0dc0\u0dd0\u01e7 \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf \u0db8\u0dd0\u01af\u0dc0\u0dbb\u0dab\u0dba\u0da7 \u0d89\u01ce\u025c\u0db4\u01ae \u0dc0\u0db1\u0dc0\u0dcf. \u0d85\u0dd9\u0217 \u0d9c\u025e \u0db8\u01e6\u01b6\u01b1\u0db8\u01e6\u0dbd\u0dcf \u0d92 \u0218\u0298\u0db6\u0db3\u0dc0 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf. \u0db8\u0dcf\u0dad\u0dbb \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f \u0d85\u0dd9\u0217 \u0d9a\u0d82\u0da0\u0db1 \u026a \u0dd9\u014e\u0dd9\u0dc3\u0dda\u0d9a\u0dbb \u0db8\u01e6\u01b6\u01b1\u0db8\u0dcf\u01ae \u0d92 \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0d9c\u0dd0\u0db1 \u0d9a\u0dae\u0dcf \u0d9a\u0dc5\u0dcf.\n\n1994 \u0dc0\u0259\u0dc2\u0dd9\u024f\u01cf \u0d91\u01b1\u0db8\u0dcf \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1 \u0db8\u01e6\u01b6\u0dc0\u0dbb\u0dba\u0d9a\u0dd4 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0db4\u01ae \u026b \u0d86\u0dc0\u0dcf. \u0db4\u0288\u0119\u0dba \u0d85\u026c\u025e\u01d0 \u026a\u0286 \u0dd9\u0daf\u0d9a\u0d9a \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1 \u0d9a\u0dcf\u0dbd\u0dba \u01b1\u0dc5 \u01e7\u0dd9\u0dba\u02a4\u0da2\u0dca\u200d\u0dba \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u01df\u0dbb \u0d9c\u0dab\u0db1\u0dcf\u0dc0\u00fa \u0dc3\u0dc4 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u01df\u0dbb \u0d9c\u0dab\u0db1\u0dcf\u0dc0\u00fa \u0d91\u01b1\u0db8\u0dcf \u0daf\u0dbb\u0dcf \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0dd9\u01ca\u0dc1\u0db4\u0dcf\u0dbd\u0db1\u0da5\u0dba\u0d9a\u0dd4 \u0dc4\u0dd0\u0179\u0dba\u0da7, \u0db8\u01e6\u01b6\u0dc0\u0dbb\u0dba\u0d9a\u0dd4, \u0d87\u0db8\u01af\u0dc0\u0dbb\u0dba\u0d9a\u0dd4 \u0dc4\u0dd0\u0179\u0dba\u0da7 \u0d91\u01b1\u0db8\u0dcf\u0dd9\u0118 \u0286\u0dba\u0265 \u0d9a\u0dd4\u0dc3\u0dbd\u0dad\u0dcf, \u0dc4\u0dd0\u00fb\u0dba\u0dcf \u0d8b\u0db4\u025c\u0db8 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0d91\u0298 \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0, 2011 \u0dc0\u0259\u0dc2\u0dd9\u024f \u0d91\u01b1\u0db8\u0dcf \u021a\u0db1\u025e\u01ae\u0dae\u0dcf\u0db4\u0db1 \u0dc4\u0dcf \u0db6\u01e6\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0d87\u0db8\u01af\u0dc0\u0dbb\u0dba\u0dcf \u0db6\u0dc0\u0da7 \u0db4\u01ae \u026d \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0250. \u0d92 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 \u0dad\u0db8\u0250 \u0d91\u01b1\u0db8\u0dcf\u0dd9\u0118 \u0d92 \u0286\u0dba\u0265 \u0daf\u00fa\u0dc2\u0dad\u0dcf, \u0dc4\u0dd0\u00fb\u0dba\u0dcf \u0d85\u0dd9\u0217 \u0dbb\u0da7\u0da7 \u0d8b\u0d9a\u0dc4\u0dcf \u0d9c\u01e6\u0db1 \u0dbd\u0dd0\u0dd9\u0db6\u01e6\u0dd9\u01e6. \u026a\u0dd9\u0dc1\u0dda\u0dc2\u0dd9\u0dba\u01e6 \u0dd9\u0daf\u02a3\u0dd9\u0dc5\u02a3\u0dc3\u0dca\u0daf\u0dcf\u0dc4\u00fa \u0db4\u0db8\u0dab \u026d \u0d91\u0262\u017a\u017a\u0d8a \u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a\u0dba\u01e6 \u021a\u025e\u01ae\u0dae\u0dcf\u0db4\u0db1\u0dba \u00fb\u025d\u0dd9\u023c \u0288\u026a\u0dd9\u0dc1\u0dda\u0280 \u0da2\u0dcf\u01af\u0d9a \u0d9a\u0259\u0dad\u0dc0\u0dca\u200d\u0dba\u0dba\u0da7 \u0240\u0263\u0d9a\u0dc0 \u0d9a\u0da7\u0252\u01b1 \u0d9a\u0dbb\u01e6\u0db1\u0da7 \u0d91\u01b1\u0db8\u0dcf\u0da7 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dbd\u0dd0\u022c\u0dab\u0dcf. \u0d92 \u0288\u026a\u0dd9\u0dc1\u0dda\u0280 \u0d9a\u0da7\u0252\u01ae\u0dad \u01e7\u0dc3\u0dcf\u0db8, 2012, 2013 \u0db4\u0db8\u0dab \u0dd9\u0dc0\u0db1\u0dd9\u0d9a\u02a3\u0da7 \u0db8\u0dcf\u0dad\u0dbb \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d85\u0dad\u0dbb \u01af\u0dd9\u0db6\u0db1 \u0d92 \u0da2\u0db1\u021f\u0dba\u0dad\u0dcf\u0dc0 \u0dad\u0dbb\u0db8\u0da7\u0db8 \u0d8b\u01b1\u025e \u0db1\u0dd0 \u0dd9\u0d9f\u0db1\u028f\u0dbb \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d85\u0dad\u0dbb\u01ae \u0d91\u01b1\u0db8\u0dcf \u0da2\u0db1\u021f\u0dba \u026c\u0dab\u0dcf. \u0d91\u0dd9\u0dc4\u0db8 \u021a\u0db1\u025e\u01ae\u0dae\u0dcf\u0db4\u0db1\u0dba \u0dbd\u0dd0\u022d \u0d85\u0dba\u0dd9\u0d9c\u01e6 \u026a\u0dc1\u0dcf\u0dbd \u0218\u025c\u0dc3\u00fa \u0d85\u0daf \u0dd9\u0dc4\u02a3\u0db3 \u0150\u0dc0\u0db1 \u0dad\u01ae\u01ae\u0dc0\u0dba\u00fa \u0dd9\u0d9c\u02a3\u0da9 \u0db1\u0d9f\u0dcf \u0dd9\u0d9c\u0db1 \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0d91\u01b1\u0db8\u0dcf\u0dd9\u0118 \u021a\u0db1\u025e\u01ae\u0dae\u0dcf\u0db4\u0db1 \u0101\u0dba\u0dcf\u0dc0\u0263\u0dd9\u024f \u0dc3\u0dcf\u0259\u0dae\u0d9a\u01ae\u0dc0\u0dba \u01b1\u0dc5 \u0daf\u0dc4\u0daf\u0dcf\u0dc4\u0d9a\u0da7 \u0dc0\u0dd0\u018b \u0218\u025c\u0dc3\u00fa \u0dc3\u0dca\u0dc0\u0dba\u0d82 \u025a\u00fb\u0dba\u0dcf \u0d86\u01ce\u0dd9\u024f \u01e7\u0dbb\u0dad \u0dd9\u0dc0\u0dbd\u0dcf \u0d85\u0daf \u0dc3\u0dca\u0dc0\u0dcf\u01de\u0db1\u0dc0 \u0150\u0dc0\u01ae \u0dd9\u0dc0\u0db1 \u021a\u0dbb\u0dc0\u0dd0\u0286\u0dba\u01e6 \u0db6\u0dc0\u0da7 \u0db4\u01ae \u0dd9\u0dc0\u0dbd\u0dcf \u01af\u0dd9\u0db6\u0db1\u0dc0\u0dcf. \u0d92 \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u01ae \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dc5 \u0252\u01b1\u0db8\u0250. \u0dd9\u01ca\u0dc1\u0db4\u0dcf\u0dbd\u0db1 \u0150\u026a\u0dad\u0dba \u01b1\u0dc5 \u021a\u0db1\u025e\u01ae\u0dae\u0dcf\u0db4\u0db1 \u0d9a\u0da7\u0252\u01ae\u0dad\u0da7 \u0d91\u01b1\u0db8\u0dcf \u0daf\u0dd0\u00fa\u026d \u0daf\u0dcf\u0dba\u0d9a\u01ae\u0dc0\u0dba \u026a \u0dd9\u0dc1\u0dda\u0dc2\u0dd9\u0dba\u01e6 \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dc5 \u0252\u01b1 \u0dd9\u0dc0\u0db1\u0dc0\u0dcf.\n\n\u0db8\u0da7 \u0dbd\u0dd0\u022b \u01af\u0dd9\u0db6\u0db1 \u0d9a\u0dcf\u0dbd \u0dd9\u0269\u0dbd\u0dcf\u0dc0 \u0d85\u01e9\u0dc0 \u0dad\u0dc0\u01ae \u0d91\u00fa \u0288\u026a\u0dd9\u0dc1\u0dda\u0280 \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u00fa \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb\u01e6\u0db1\u0da7 \u0d95\u0db1\u0dd1. \u0db8\u0dcf \u0db4\u0dd0\u0dc0\u0289 \u0d86\u0d9a\u0dcf\u0dbb\u0dba\u0da7, \u0db8\u0dcf \u0d9a\u0dd4\u0da9\u0dcf \u0d9a\u0dcf\u0dbd\u0dd9\u024f \u0286\u0da7 \u0d85\u0dd9\u0217 \u0dd9\u0d9c\u0daf\u0dbb\u0da7 \u0d86 \u0119\u0dba \u0d91\u01b1\u0db8\u0dcf \u027c \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0269"
  },
